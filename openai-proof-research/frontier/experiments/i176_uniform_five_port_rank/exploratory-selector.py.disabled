import json,pathlib
r=pathlib.Path('/home/mj-kang/Documents/Dev/math/openai-proof-research/frontier/experiments/i176_uniform_five_port_rank')
n={};exec(compile((r/'math176.py').read_bytes(),str(r/'math176.py'),'exec'),n)
cs=json.loads((r/'finite-attempt-01.json').read_bytes())['certificates']
for c in cs[1:]:
 k=c['k'];ee=[tuple(e) for e in c['xe']];states=c['states'];s,t,p,q=c['square'];sub=n['sub']
 base=states[6]['X'][-1]
 ds=[sub(x,base) for x in states[6]['X'][:-1]]
 z=next(x for x in states[7]['X'] if x[ee.index((p,q))])
 r1=next(x for x in states[7]['X'] if not x[ee.index((13,14))])
 extra=[sub(states[1]['X'][0],states[1]['X'][1]),sub(states[4]['X'][0],states[4]['X'][1]),sub(z,r1)]
 cols=[ee.index((12+i,13+i)) for i in range(1,k-3)]+[ee.index((12+k-2,12+k-1)),ee.index((p,q)),ee.index((12+k,13+k))]
 rows=[[d[i] for i in cols] for d in ds+extra]
 for row in rows[len(ds):]:
  for j in range(len(ds)):
   coef=row[j]/rows[j][j]
   row[:]=[a-coef*b for a,b in zip(row,rows[j])]
 print(k,'Schur',[row[-3:] for row in rows[len(ds):]],'rank',n['rank'](ds+extra))
