                          </XMApp>
                        </XMath>
                      </Math></foreignObject></g></g><g transform="translate(0.69,0.27)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="20.99" height="11.16" overflow="visible"><Math mode="inline" tex="s_{r}" text="s _ r" xml:id="S5.F8.pic1.m4">
                        <XMath xml:id="S5.F8.pic1.m4.1">
                          <XMApp xml:id="S5.F8.pic1.m4.1.1">
                            <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                            <XMTok font="italic" role="UNKNOWN">s</XMTok>
                            <XMTok font="italic" fontsize="70%" role="UNKNOWN">r</XMTok>
