                      </XMath>
                    </Math></foreignObject></g></g><g transform="translate(0.6,0.18)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="37.99" height="11.16" overflow="visible"><Math mode="inline" tex="B^{2}(c)" text="B ^ 2 * c" xml:id="S7.F1.pic1.m4">
                      <XMath xml:id="S7.F1.pic1.m4.2">
                        <XMApp xml:id="S7.F1.pic1.m4.2.1">
                          <XMTok meaning="times" role="MULOP">⁢</XMTok>
                          <XMApp xml:id="S7.F1.pic1.m4.2.1.2">
                            <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
