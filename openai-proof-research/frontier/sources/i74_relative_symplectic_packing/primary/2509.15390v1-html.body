                            <XMTok fontsize="70%" meaning="2" role="NUMBER">2</XMTok>
                          </XMApp>
                          <XMDual xml:id="S7.F1.pic1.m4.2.1.3">
                            <XMRef idref="S7.F1.pic1.m4.1" xml:id="S7.F1.pic1.m4.2.1.3.1"/>
                            <XMWrap xml:id="S7.F1.pic1.m4.2.1.3.2">
                              <XMTok role="OPEN" stretchy="false">(</XMTok>
                              <XMTok font="italic" role="UNKNOWN" xml:id="S7.F1.pic1.m4.1">c</XMTok>
                              <XMTok role="CLOSE" stretchy="false">)</XMTok>
                            </XMWrap>
                          </XMDual>
                        </XMApp>
                      </XMath>
                    </Math></foreignObject></g></g><g transform="translate(0.73,0.18)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="37.86" height="11.16" overflow="visible"><Math mode="inline" tex="B^{2}(b)" text="B ^ 2 * b" xml:id="S7.F1.pic1.m5">
                      <XMath xml:id="S7.F1.pic1.m5.2">
                        <XMApp xml:id="S7.F1.pic1.m5.2.1">
                          <XMTok meaning="times" role="MULOP">⁢</XMTok>
                          <XMApp xml:id="S7.F1.pic1.m5.2.1.2">
                            <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
                            <XMTok font="italic" role="UNKNOWN">B</XMTok>
                            <XMTok fontsize="70%" meaning="2" role="NUMBER">2</XMTok>
                          </XMApp>
                          <XMDual xml:id="S7.F1.pic1.m5.2.1.3">
                            <XMRef idref="S7.F1.pic1.m5.1" xml:id="S7.F1.pic1.m5.2.1.3.1"/>
                            <XMWrap xml:id="S7.F1.pic1.m5.2.1.3.2">
                              <XMTok role="OPEN" stretchy="false">(</XMTok>
                              <XMTok font="italic" role="UNKNOWN" xml:id="S7.F1.pic1.m5.1">b</XMTok>
                              <XMTok role="CLOSE" stretchy="false">)</XMTok>
                            </XMWrap>
                          </XMDual>
                        </XMApp>
                      </XMath>
                    </Math></foreignObject></g></g><g transform="translate(1.04,0.06)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="31.75" height="11.16" overflow="visible"><Math mode="inline" tex="[0,1]" text="closed-interval@(0, 1)" xml:id="S7.F1.pic1.m6">
                      <XMath xml:id="S7.F1.pic1.m6.3">
                        <XMDual xml:id="S7.F1.pic1.m6.3.1">
                          <XMApp xml:id="S7.F1.pic1.m6.3.1.1">
                            <XMTok meaning="closed-interval"/>
                            <XMRef idref="S7.F1.pic1.m6.1" xml:id="S7.F1.pic1.m6.3.1.1.2"/>
                            <XMRef idref="S7.F1.pic1.m6.2" xml:id="S7.F1.pic1.m6.3.1.1.3"/>
                          </XMApp>
                          <XMWrap xml:id="S7.F1.pic1.m6.3.1.2">
                            <XMTok role="OPEN" stretchy="false">[</XMTok>
                            <XMTok meaning="0" role="NUMBER" xml:id="S7.F1.pic1.m6.1">0</XMTok>
                            <XMTok role="PUNCT">,</XMTok>
                            <XMTok meaning="1" role="NUMBER" xml:id="S7.F1.pic1.m6.2">1</XMTok>
                            <XMTok role="CLOSE" stretchy="false">]</XMTok>
                          </XMWrap>
                        </XMDual>
                      </XMath>
                    </Math></foreignObject></g></g><g transform="translate(0.95,0.35)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="31.48" height="11.16" overflow="visible"><Math mode="inline" tex="\partial_{+}F" text="(partial-differential _ +)@(F)" xml:id="S7.F1.pic1.m7">
                      <XMath xml:id="S7.F1.pic1.m7.1">
                        <XMApp xml:id="S7.F1.pic1.m7.1.1">
                          <XMApp role="DIFFOP" xml:id="S7.F1.pic1.m7.1.1.1">
                            <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                            <XMTok meaning="partial-differential" name="partial" role="DIFFOP">∂</XMTok>
                            <XMTok fontsize="70%" meaning="plus" role="ADDOP">+</XMTok>
                          </XMApp>
                          <XMTok font="italic" role="UNKNOWN">F</XMTok>
                        </XMApp>
                      </XMath>
                    </Math></foreignObject></g></g><g transform="translate(0.68,0.37)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="32.28" height="11.16" overflow="visible"><Math mode="inline" tex="\partial_{0}F" text="(partial-differential _ 0)@(F)" xml:id="S7.F1.pic1.m8">
                      <XMath xml:id="S7.F1.pic1.m8.1">
                        <XMApp xml:id="S7.F1.pic1.m8.1.1">
                          <XMApp role="DIFFOP" xml:id="S7.F1.pic1.m8.1.1.1">
                            <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                            <XMTok meaning="partial-differential" name="partial" role="DIFFOP">∂</XMTok>
                            <XMTok fontsize="70%" meaning="0" role="NUMBER">0</XMTok>
                          </XMApp>
                          <XMTok font="italic" role="UNKNOWN">F</XMTok>
                        </XMApp>
                      </XMath>
                    </Math></foreignObject></g></g><g transform="translate(0.93,0.02)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="30.55" height="11.16" overflow="visible"><Math mode="inline" tex="\partial_{-}F" text="(partial-differential _ -)@(F)" xml:id="S7.F1.pic1.m9">
                      <XMath xml:id="S7.F1.pic1.m9.1">
                        <XMApp xml:id="S7.F1.pic1.m9.1.1">
                          <XMApp role="DIFFOP" xml:id="S7.F1.pic1.m9.1.1.1">
                            <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                            <XMTok meaning="partial-differential" name="partial" role="DIFFOP">∂</XMTok>
                            <XMTok fontsize="70%" meaning="minus" role="ADDOP">-</XMTok>
                          </XMApp>
                          <XMTok font="italic" role="UNKNOWN">F</XMTok>
                        </XMApp>
                      </XMath>
                    </Math></foreignObject></g></g><g transform="translate(1.24,0.29)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="32.28" height="11.16" overflow="visible"><Math mode="inline" tex="\partial_{1}F" text="(partial-differential _ 1)@(F)" xml:id="S7.F1.pic1.m10">
                      <XMath xml:id="S7.F1.pic1.m10.1">
                        <XMApp xml:id="S7.F1.pic1.m10.1.1">
                          <XMApp role="DIFFOP" xml:id="S7.F1.pic1.m10.1.1.1">
                            <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                            <XMTok meaning="partial-differential" name="partial" role="DIFFOP">∂</XMTok>
                            <XMTok fontsize="70%" meaning="1" role="NUMBER">1</XMTok>
                          </XMApp>
                          <XMTok font="italic" role="UNKNOWN">F</XMTok>
                        </XMApp>
                      </XMath>
                    </Math></foreignObject></g></g><g transform="translate(0.98,0.19)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="32.41" height="11.16" overflow="visible"><Math mode="inline" tex="\partial_{\bullet}F" text="(partial-differential _ bullet)@(F)" xml:id="S7.F1.pic1.m11">
                      <XMath xml:id="S7.F1.pic1.m11.1">
                        <XMApp xml:id="S7.F1.pic1.m11.1.1">
                          <XMApp role="DIFFOP" xml:id="S7.F1.pic1.m11.1.1.1">
                            <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                            <XMTok meaning="partial-differential" name="partial" role="DIFFOP">∂</XMTok>
                            <XMTok fontsize="70%" name="bullet" role="MULOP">∙</XMTok>
                          </XMApp>
                          <XMTok font="italic" role="UNKNOWN">F</XMTok>
                        </XMApp>
                      </XMath>
                    </Math></foreignObject></g></g><g transform="translate(0,0)"><g transform="translate(0,141.87) scale(1,-1)"><foreignObject width="458.28" height="141.87" overflow="visible"><object type="image/svg+xml" data="2509.15390v1/x27.svg" id="S7.F1.pic1.g2" class="ltx_graphics ltx_img_landscape" width="476" height="148" aria-label="Refer to caption"></object></foreignObject></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 7.1. </span>On the left the intersection <math id="S7.F1.m3" class="ltx_Math" alttext="F\cap(\mathbb{R}\times\left\{0\right\}\times B^{2}(c))" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>∩</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ℝ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo>{</mo><mn>0</mn><mo rspace="0.055em">}</mo></mrow><mo rspace="0.222em">×</mo><mrow><msup><mi>B</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F\cap(\mathbb{R}\times\left\{0\right\}\times B^{2}(c))</annotation></semantics></math>. On the right a schematic of the boundary strata of <math id="S7.F1.m4" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>.</figcaption>
</figure>
<div id="S7.p4" class="ltx_para">
<p id="S7.p4.1" class="ltx_p">A domain <math id="S7.p4.m1" class="ltx_Math" alttext="X\subset\mathbb{R}^{4}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>⊂</mo><msup><mi>ℝ</mi><mn>4</mn></msup></mrow><annotation encoding="application/x-tex">X\subset\mathbb{R}^{4}</annotation></semantics></math> is called a <span id="S7.p4.1.1" class="ltx_text ltx_font_italic">perturbed symplectic frustum</span> if there exist a symplectic frustum <math id="S7.p4.m2" class="ltx_Math" alttext="F\subset\mathbb{R}^{4}" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⊂</mo><msup><mi>ℝ</mi><mn>4</mn></msup></mrow><annotation encoding="application/x-tex">F\subset\mathbb{R}^{4}</annotation></semantics></math> and a diffeomorphism <math id="S7.p4.m3" class="ltx_Math" alttext="\varphi" display="inline" intent=":literal"><semantics><mi>φ</mi><annotation encoding="application/x-tex">\varphi</annotation></semantics></math> of <math id="S7.p4.m4" class="ltx_Math" alttext="\mathbb{R}^{4}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mn>4</mn></msup><annotation encoding="application/x-tex">\mathbb{R}^{4}</annotation></semantics></math> such that the following properties are satisfied:</p>
<ul id="S7.I1" class="ltx_itemize">
<li id="S7.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S7.I1.i1.p1" class="ltx_para">
<p id="S7.I1.i1.p1.1" class="ltx_p"><math id="S7.I1.i1.p1.m1" class="ltx_Math" alttext="\varphi(F)=X" display="inline" intent=":literal"><semantics><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">\varphi(F)=X</annotation></semantics></math></p>
</div></li>
<li id="S7.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S7.I1.i2.p1" class="ltx_para">
<p id="S7.I1.i2.p1.1" class="ltx_p">All <math id="S7.I1.i2.p1.m1" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-dimensional boundary strata of <math id="S7.I1.i2.p1.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> are either symplectic or Lagrangian.</p>
</div></li>
<li id="S7.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S7.I1.i3.p1" class="ltx_para">
<p id="S7.I1.i3.p1.1" class="ltx_p"><math id="S7.I1.i3.p1.m1" class="ltx_Math" alttext="\varphi" display="inline" intent=":literal"><semantics><mi>φ</mi><annotation encoding="application/x-tex">\varphi</annotation></semantics></math> maps symplectic <math id="S7.I1.i3.p1.m2" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-dimensional boundary strata of <math id="S7.I1.i3.p1.m3" class="ltx_Math" alttext="\partial F" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mi>F</mi></mrow><annotation encoding="application/x-tex">\partial F</annotation></semantics></math> to symplectic <math id="S7.I1.i3.p1.m4" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-dimensional boundary strata of <math id="S7.I1.i3.p1.m5" class="ltx_Math" alttext="\partial X" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">\partial X</annotation></semantics></math>. It preserves the orientations of these strata induced by the symplectic form, but not necessarily the symplectic form itself.</p>
</div></li>
<li id="S7.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S7.I1.i4.p1" class="ltx_para">
<p id="S7.I1.i4.p1.1" class="ltx_p"><math id="S7.I1.i4.p1.m1" class="ltx_Math" alttext="\varphi" display="inline" intent=":literal"><semantics><mi>φ</mi><annotation encoding="application/x-tex">\varphi</annotation></semantics></math> maps Lagrangian <math id="S7.I1.i4.p1.m2" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-dimensional boundary strata of <math id="S7.I1.i4.p1.m3" class="ltx_Math" alttext="\partial F" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mi>F</mi></mrow><annotation encoding="application/x-tex">\partial F</annotation></semantics></math> to Lagrangian <math id="S7.I1.i4.p1.m4" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-dimensional boundary strata of <math id="S7.I1.i4.p1.m5" class="ltx_Math" alttext="\partial X" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">\partial X</annotation></semantics></math>.</p>
</div></li>
</ul>
</div>
<div id="S7.p5" class="ltx_para">
<p id="S7.p5.1" class="ltx_p">If <math id="S7.p5.m1" class="ltx_Math" alttext="X=\varphi(F)" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>=</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X=\varphi(F)</annotation></semantics></math> is a perturbed symplectic frustum, we abbreviate its top-dimensional boundary strata by <math id="S7.p5.m2" class="ltx_Math" alttext="\partial_{*}X\coloneqq\varphi(\partial_{*}F)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∂</mo><mo>∗</mo></msub><mi>X</mi></mrow><mo>≔</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mo lspace="0em">∂</mo><mo>∗</mo></msub><mi>F</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\partial_{*}X\coloneqq\varphi(\partial_{*}F)</annotation></semantics></math> for <math id="S7.p5.m3" class="ltx_math_unparsed" alttext="*\in\left\{0,1,+,-,\bullet\right\}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∗</mo><mo lspace="0em">∈</mo><mrow><mo>{</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">+</mo><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">−</mo><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">∙</mo><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">*\in\left\{0,1,+,-,\bullet\right\}</annotation></semantics></math>. We endow the space of perturbed symplectic frusta with the <math id="S7.p5.m4" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math> topology. A sequence of perturbed symplectic frusta <math id="S7.p5.m5" class="ltx_Math" alttext="(X_{k})_{k}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mi>k</mi></msub><annotation encoding="application/x-tex">(X_{k})_{k}</annotation></semantics></math> converges to a perturbed symplectic frustum <math id="S7.p5.m6" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> with respect to this topology if and only if there exists a sequence of diffeomorphisms <math id="S7.p5.m7" class="ltx_Math" alttext="(\varphi_{k})_{k}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>φ</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mi>k</mi></msub><annotation encoding="application/x-tex">(\varphi_{k})_{k}</annotation></semantics></math> of <math id="S7.p5.m8" class="ltx_Math" alttext="\mathbb{R}^{4}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mn>4</mn></msup><annotation encoding="application/x-tex">\mathbb{R}^{4}</annotation></semantics></math> converging to the identity in the <math id="S7.p5.m9" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math> topology such that <math id="S7.p5.m10" class="ltx_Math" alttext="X_{k}=\varphi_{k}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>k</mi></msub><mo>=</mo><mrow><msub><mi>φ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X_{k}=\varphi_{k}(X)</annotation></semantics></math> for all sufficiently large <math id="S7.p5.m11" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>.</p>
</div>
<div id="S7.Thmtheorem1" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmtheorem1.2" class="ltx_text ltx_font_bold">Theorem 7.1</span></span><span id="S7.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmtheorem1.p1" class="ltx_para">
<p id="S7.Thmtheorem1.p1.1" class="ltx_p"><span id="S7.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S7.Thmtheorem1.p1.m1" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> be a symplectic frustum. Then each perturbed symplectic frustum <math id="S7.Thmtheorem1.p1.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> which is sufficiently <math id="S7.Thmtheorem1.p1.m3" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math> close to <math id="S7.Thmtheorem1.p1.m4" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> admits a <math id="S7.Thmtheorem1.p1.m5" class="ltx_Math" alttext="\partial" display="inline" intent=":literal"><semantics><mo>∂</mo><annotation encoding="application/x-tex">\partial</annotation></semantics></math>-tame packing by balls and polydisks.</span></p>
</div>
</div>
<div id="S7.Thmtheorem2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmtheorem2.2" class="ltx_text ltx_font_bold">Lemma 7.2</span></span><span id="S7.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmtheorem2.p1" class="ltx_para">
<p id="S7.Thmtheorem2.p1.1" class="ltx_p"><span id="S7.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S7.Thmtheorem2.p1.m1" class="ltx_Math" alttext="F=F(a,b,c)" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>=</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F=F(a,b,c)</annotation></semantics></math> be a symplectic frustum and let <math id="S7.Thmtheorem2.p1.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> be a perturbed symplectic frustum which is <math id="S7.Thmtheorem2.p1.m3" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math> close to <math id="S7.Thmtheorem2.p1.m4" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>. Then there exist positive real numbers <math id="S7.Thmtheorem2.p1.m5" class="ltx_Math" alttext="a^{\prime},b^{\prime},c^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>a</mi><mo>′</mo></msup><mo>,</mo><msup><mi>b</mi><mo>′</mo></msup><mo>,</mo><msup><mi>c</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">a^{\prime},b^{\prime},c^{\prime}</annotation></semantics></math> close to <math id="S7.Thmtheorem2.p1.m6" class="ltx_Math" alttext="a,b,c" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">a,b,c</annotation></semantics></math>, respectively, and Hamiltonians <math id="S7.Thmtheorem2.p1.m7" class="ltx_Math" alttext="G,H:[0,1]\times B^{2}(c^{\prime})\rightarrow\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>,</mo><mrow><mi>H</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><msup><mi>B</mi><mn>2</mn></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>c</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">G,H:[0,1]\times B^{2}(c^{\prime})\rightarrow\mathbb{R}</annotation></semantics></math> such that</span></p>
<ul id="S7.I2" class="ltx_itemize">
<li id="S7.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S7.I2.i1.p1" class="ltx_para">
<p id="S7.I2.i1.p1.1" class="ltx_p"><span id="S7.I2.i1.p1.1.1" class="ltx_text ltx_font_italic">both </span><math id="S7.I2.i1.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math><span id="S7.I2.i1.p1.1.2" class="ltx_text ltx_font_italic"> and </span><math id="S7.I2.i1.p1.m2" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math><span id="S7.I2.i1.p1.1.3" class="ltx_text ltx_font_italic"> vanish on </span><math id="S7.I2.i1.p1.m3" class="ltx_Math" alttext="[0,1]\times\partial B^{2}(c^{\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.055em">×</mo><mrow><mo>∂</mo><mrow><msup><mi>B</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>c</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">[0,1]\times\partial B^{2}(c^{\prime})</annotation></semantics></math><span id="S7.I2.i1.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S7.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S7.I2.i2.p1" class="ltx_para">
<p id="S7.I2.i2.p1.1" class="ltx_p"><math id="S7.I2.i2.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math><span id="S7.I2.i2.p1.1.1" class="ltx_text ltx_font_italic"> is </span><math id="S7.I2.i2.p1.m2" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math><span id="S7.I2.i2.p1.1.2" class="ltx_text ltx_font_italic"> close to </span><math id="S7.I2.i2.p1.m3" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math><span id="S7.I2.i2.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S7.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S7.I2.i3.p1" class="ltx_para">
<p id="S7.I2.i3.p1.1" class="ltx_p"><math id="S7.I2.i3.p1.m1" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math><span id="S7.I2.i3.p1.1.1" class="ltx_text ltx_font_italic"> agrees with the Hamiltonian </span><math id="S7.I2.i3.p1.m2" class="ltx_Math" alttext="H_{a^{\prime},b^{\prime},c^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mrow><msup><mi>a</mi><mo>′</mo></msup><mo>,</mo><msup><mi>b</mi><mo>′</mo></msup><mo>,</mo><msup><mi>c</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">H_{a^{\prime},b^{\prime},c^{\prime}}</annotation></semantics></math><span id="S7.I2.i3.p1.1.2" class="ltx_text ltx_font_italic"> on the set </span><math id="S7.I2.i3.p1.m3" class="ltx_Math" alttext="[0,1]\times B^{2}(b^{\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><msup><mi>B</mi><mn>2</mn></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>b</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">[0,1]\times B^{2}(b^{\prime})</annotation></semantics></math><span id="S7.I2.i3.p1.1.3" class="ltx_text ltx_font_italic"> and is </span><math id="S7.I2.i3.p1.m4" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math><span id="S7.I2.i3.p1.1.4" class="ltx_text ltx_font_italic"> close to </span><math id="S7.I2.i3.p1.m5" class="ltx_Math" alttext="H_{a^{\prime},b^{\prime},c^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mrow><msup><mi>a</mi><mo>′</mo></msup><mo>,</mo><msup><mi>b</mi><mo>′</mo></msup><mo>,</mo><msup><mi>c</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">H_{a^{\prime},b^{\prime},c^{\prime}}</annotation></semantics></math><span id="S7.I2.i3.p1.1.5" class="ltx_text ltx_font_italic"> on the complement of this set.</span></p>
</div></li>
<li id="S7.I2.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S7.I2.i4.p1" class="ltx_para">
<p id="S7.I2.i4.p1.1" class="ltx_p"><math id="S7.I2.i4.p1.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math><span id="S7.I2.i4.p1.1.1" class="ltx_text ltx_font_italic"> is symplectomorphic to </span><math id="S7.I2.i4.p1.m2" class="ltx_Math" alttext="D(G,H)" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(G,H)</annotation></semantics></math><span id="S7.I2.i4.p1.1.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ul>
</div>
</div>
<div id="S7.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S7.p6" class="ltx_para">
<p id="S7.p6.1" class="ltx_p"><span id="S7.p6.1.1" class="ltx_text">We prove the lemma in two steps.</span></p>
</div>
<div id="S7.p7" class="ltx_para">
<p id="S7.p7.1" class="ltx_p"><em id="S7.p7.1.1" class="ltx_emph ltx_font_italic">Step 1:</em><span id="S7.p7.1.2" class="ltx_text"> We show that it suffices to prove Lemma <a href="#S7.Thmtheorem2" title="Lemma 7.2. ‣ 7. Symplectic frusta ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.2</span></a> under the additional assumption</span></p>
<table id="S7.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(7.1)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E1.m1" class="ltx_Math" alttext="\partial_{0}X\subset\mathbb{R}\times\left\{0\right\}\times\mathbb{R}^{2}\quad\text{and}\quad\partial_{1}X\subset\mathbb{R}\times\left\{1\right\}\times\mathbb{R}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mo>∂</mo><mn>0</mn></msub><mi>X</mi></mrow><mo>⊂</mo><mrow><mi>ℝ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo>{</mo><mn>0</mn><mo rspace="0.055em">}</mo></mrow><mo rspace="0.222em">×</mo><msup><mi>ℝ</mi><mn>2</mn></msup></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>and</mtext><mspace style="width:1.000em;" width="1.000em"></mspace><mrow><mrow><msub><mo>∂</mo><mn>1</mn></msub><mi>X</mi></mrow><mo>⊂</mo><mrow><mi>ℝ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo>{</mo><mn>1</mn><mo rspace="0.055em">}</mo></mrow><mo rspace="0.222em">×</mo><msup><mi>ℝ</mi><mn>2</mn></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\partial_{0}X\subset\mathbb{R}\times\left\{0\right\}\times\mathbb{R}^{2}\quad\text{and}\quad\partial_{1}X\subset\mathbb{R}\times\left\{1\right\}\times\mathbb{R}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p7.2" class="ltx_p"><span id="S7.p7.2.1" class="ltx_text">Define the submanifold <math id="S7.p7.m1" class="ltx_Math" alttext="V_{1}\coloneqq\mathbb{R}\times\left\{0\right\}\times\mathbb{R}^{2}\subset\mathbb{R}^{4}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mn>1</mn></msub><mo>≔</mo><mrow><mi>ℝ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo>{</mo><mn>0</mn><mo rspace="0.055em">}</mo></mrow><mo rspace="0.222em">×</mo><msup><mi>ℝ</mi><mn>2</mn></msup></mrow><mo>⊂</mo><msup><mi>ℝ</mi><mn>4</mn></msup></mrow><annotation encoding="application/x-tex">V_{1}\coloneqq\mathbb{R}\times\left\{0\right\}\times\mathbb{R}^{2}\subset\mathbb{R}^{4}</annotation></semantics></math>. Let <math id="S7.p7.m2" class="ltx_Math" alttext="V_{0}\subset\mathbb{R}^{4}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mn>0</mn></msub><mo>⊂</mo><msup><mi>ℝ</mi><mn>4</mn></msup></mrow><annotation encoding="application/x-tex">V_{0}\subset\mathbb{R}^{4}</annotation></semantics></math> be a <math id="S7.p7.m3" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math> small perturbation of <math id="S7.p7.m4" class="ltx_Math" alttext="V_{1}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mn>1</mn></msub><annotation encoding="application/x-tex">V_{1}</annotation></semantics></math> which is supported in the region <math id="S7.p7.m5" class="ltx_Math" alttext="(-1,a+1)\times\left\{0\right\}\times B^{2}(c+1)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mrow><mi>a</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo>{</mo><mn>0</mn><mo rspace="0.055em">}</mo></mrow><mo rspace="0.222em">×</mo><mrow><msup><mi>B</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(-1,a+1)\times\left\{0\right\}\times B^{2}(c+1)</annotation></semantics></math> and contains <math id="S7.p7.m6" class="ltx_Math" alttext="\partial_{0}X" display="inline" intent=":literal"><semantics><mrow><msub><mo>∂</mo><mn>0</mn></msub><mi>X</mi></mrow><annotation encoding="application/x-tex">\partial_{0}X</annotation></semantics></math>. Let <math id="S7.p7.m7" class="ltx_Math" alttext="(V_{t})_{t\in[0,1]}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">(V_{t})_{t\in[0,1]}</annotation></semantics></math> be a smooth family of <math id="S7.p7.m8" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math> small perturbations of <math id="S7.p7.m9" class="ltx_Math" alttext="V_{1}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mn>1</mn></msub><annotation encoding="application/x-tex">V_{1}</annotation></semantics></math> supported in this region and connecting <math id="S7.p7.m10" class="ltx_Math" alttext="V_{0}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mn>0</mn></msub><annotation encoding="application/x-tex">V_{0}</annotation></semantics></math> to <math id="S7.p7.m11" class="ltx_Math" alttext="V_{1}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mn>1</mn></msub><annotation encoding="application/x-tex">V_{1}</annotation></semantics></math>. We define a family of diffeomorphisms <math id="S7.p7.m12" class="ltx_Math" alttext="\alpha_{t}:V_{0}\rightarrow V_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>V</mi><mn>0</mn></msub><mo stretchy="false">→</mo><msub><mi>V</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\alpha_{t}:V_{0}\rightarrow V_{t}</annotation></semantics></math> as follows. On the set <math id="S7.p7.m13" class="ltx_Math" alttext="(-\infty,-1)\times\left\{0\right\}\times\mathbb{R}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><mo>,</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo>{</mo><mn>0</mn><mo rspace="0.055em">}</mo></mrow><mo rspace="0.222em">×</mo><msup><mi>ℝ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">(-\infty,-1)\times\left\{0\right\}\times\mathbb{R}^{2}</annotation></semantics></math>, we define <math id="S7.p7.m14" class="ltx_Math" alttext="\alpha_{t}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\alpha_{t}</annotation></semantics></math> to be the identity. Outside of this set, <math id="S7.p7.m15" class="ltx_Math" alttext="\alpha_{t}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\alpha_{t}</annotation></semantics></math> is uniquely determined by the requirements that it maps leaves of the characteristic foliation on <math id="S7.p7.m16" class="ltx_Math" alttext="V_{0}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mn>0</mn></msub><annotation encoding="application/x-tex">V_{0}</annotation></semantics></math> to leaves of the characteristic foliation on <math id="S7.p7.m17" class="ltx_Math" alttext="V_{t}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>t</mi></msub><annotation encoding="application/x-tex">V_{t}</annotation></semantics></math> and that it preserves the coordinate of the first <math id="S7.p7.m18" class="ltx_Math" alttext="\mathbb{R}" display="inline" intent=":literal"><semantics><mi>ℝ</mi><annotation encoding="application/x-tex">\mathbb{R}</annotation></semantics></math> factor of <math id="S7.p7.m19" class="ltx_Math" alttext="\mathbb{R}^{4}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mn>4</mn></msup><annotation encoding="application/x-tex">\mathbb{R}^{4}</annotation></semantics></math>, i.e. that it is of the form <math id="S7.p7.m20" class="ltx_Math" alttext="\alpha_{t}(s,t,p)=(s,*,*)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">∗</mo><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">∗</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha_{t}(s,t,p)=(s,*,*)</annotation></semantics></math>. Note that we have <math id="S7.p7.m21" class="ltx_Math" alttext="\alpha_{t}^{*}\omega=\alpha_{0}^{*}\omega" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>α</mi><mi>t</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow><mo>=</mo><mrow><msubsup><mi>α</mi><mn>0</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow></mrow><annotation encoding="application/x-tex">\alpha_{t}^{*}\omega=\alpha_{0}^{*}\omega</annotation></semantics></math> for all <math id="S7.p7.m22" class="ltx_Math" alttext="t\in[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[0,1]</annotation></semantics></math>. This identity holds trivially in the region <math id="S7.p7.m23" class="ltx_Math" alttext="(-\infty,-1)\times\left\{0\right\}\times\mathbb{R}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><mo>,</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo>{</mo><mn>0</mn><mo rspace="0.055em">}</mo></mrow><mo rspace="0.222em">×</mo><msup><mi>ℝ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">(-\infty,-1)\times\left\{0\right\}\times\mathbb{R}^{2}</annotation></semantics></math>. On the complement of this region, it follows easily from the fact that <math id="S7.p7.m24" class="ltx_Math" alttext="\alpha_{t}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\alpha_{t}</annotation></semantics></math> respects the characteristic foliations on <math id="S7.p7.m25" class="ltx_Math" alttext="V_{0}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mn>0</mn></msub><annotation encoding="application/x-tex">V_{0}</annotation></semantics></math> and <math id="S7.p7.m26" class="ltx_Math" alttext="V_{t}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>t</mi></msub><annotation encoding="application/x-tex">V_{t}</annotation></semantics></math>. We define the vector field <math id="S7.p7.m27" class="ltx_Math" alttext="X_{t}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>t</mi></msub><annotation encoding="application/x-tex">X_{t}</annotation></semantics></math> along <math id="S7.p7.m28" class="ltx_Math" alttext="V_{t}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>t</mi></msub><annotation encoding="application/x-tex">V_{t}</annotation></semantics></math> by <math id="S7.p7.m29" class="ltx_Math" alttext="X_{t}\coloneqq\partial_{t}\alpha_{t}\circ\alpha_{t}^{-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>t</mi></msub><mo rspace="0.111em">≔</mo><mrow><mrow><msub><mo>∂</mo><mi>t</mi></msub><msub><mi>α</mi><mi>t</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi>α</mi><mi>t</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">X_{t}\coloneqq\partial_{t}\alpha_{t}\circ\alpha_{t}^{-1}</annotation></semantics></math>. Clearly, the family <math id="S7.p7.m30" class="ltx_Math" alttext="(V_{t})_{t\in[0,1]}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">(V_{t})_{t\in[0,1]}</annotation></semantics></math> of <math id="S7.p7.m31" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math> small perturbations of <math id="S7.p7.m32" class="ltx_Math" alttext="V_{1}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mn>1</mn></msub><annotation encoding="application/x-tex">V_{1}</annotation></semantics></math> can be chosen such that the family of vector fields <math id="S7.p7.m33" class="ltx_Math" alttext="(X_{t})_{t\in[0,1]}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">(X_{t})_{t\in[0,1]}</annotation></semantics></math> is <math id="S7.p7.m34" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math> small. We will assume in the following that this is the case. It follows from the identity <math id="S7.p7.m35" class="ltx_Math" alttext="\alpha_{t}^{*}\omega=\alpha_{0}^{*}\omega" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>α</mi><mi>t</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow><mo>=</mo><mrow><msubsup><mi>α</mi><mn>0</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow></mrow><annotation encoding="application/x-tex">\alpha_{t}^{*}\omega=\alpha_{0}^{*}\omega</annotation></semantics></math> and Cartan’s magic formula that <math id="S7.p7.m36" class="ltx_Math" alttext="\iota_{X_{t}}\omega" display="inline" intent=":literal"><semantics><mrow><msub><mi>ι</mi><msub><mi>X</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow><annotation encoding="application/x-tex">\iota_{X_{t}}\omega</annotation></semantics></math> defines a closed <math id="S7.p7.m37" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>-form on <math id="S7.p7.m38" class="ltx_Math" alttext="V_{t}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>t</mi></msub><annotation encoding="application/x-tex">V_{t}</annotation></semantics></math>. It is therefore possible to find a <math id="S7.p7.m39" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math> small Hamiltonian <math id="S7.p7.m40" class="ltx_Math" alttext="E:[0,1]\times\mathbb{R}^{4}\rightarrow\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><msup><mi>ℝ</mi><mn>4</mn></msup></mrow><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">E:[0,1]\times\mathbb{R}^{4}\rightarrow\mathbb{R}</annotation></semantics></math> with compact support contained in <math id="S7.p7.m41" class="ltx_math_unparsed" alttext="[0,1]\times\mathbb{R}\times(-1/2,1/2)\times\mathbb{R}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><mi>ℝ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mn>1</mn><mo>/</mo><mn>2</mn><mo>,</mo><mn>1</mn><mo>/</mo><mn>2</mn><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><msup><mi>ℝ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">[0,1]\times\mathbb{R}\times(-1/2,1/2)\times\mathbb{R}^{2}</annotation></semantics></math> such that the restriction of the Hamiltonian vector field <math id="S7.p7.m42" class="ltx_Math" alttext="X_{E_{t}}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><msub><mi>E</mi><mi>t</mi></msub></msub><annotation encoding="application/x-tex">X_{E_{t}}</annotation></semantics></math> to <math id="S7.p7.m43" class="ltx_Math" alttext="V_{t}\cap(-1,a+1)\times\mathbb{R}\times\mathbb{R}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi>t</mi></msub><mo>∩</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mrow><mi>a</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi>ℝ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℝ</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">V_{t}\cap(-1,a+1)\times\mathbb{R}\times\mathbb{R}^{2}</annotation></semantics></math> agrees with the restriction of <math id="S7.p7.m44" class="ltx_Math" alttext="X_{t}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>t</mi></msub><annotation encoding="application/x-tex">X_{t}</annotation></semantics></math> to this set. Note that this implies that <math id="S7.p7.m45" class="ltx_Math" alttext="\varphi_{E}^{t}|_{\partial_{0}X}=\alpha_{t}|_{\partial_{0}X}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><msubsup><mi>φ</mi><mi>E</mi><mi>t</mi></msubsup><mo stretchy="false">|</mo></mrow><mrow><msub><mo>∂</mo><mn>0</mn></msub><mi>X</mi></mrow></msub><mo>=</mo><msub><mrow><msub><mi>α</mi><mi>t</mi></msub><mo stretchy="false">|</mo></mrow><mrow><msub><mo>∂</mo><mn>0</mn></msub><mi>X</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\varphi_{E}^{t}|_{\partial_{0}X}=\alpha_{t}|_{\partial_{0}X}</annotation></semantics></math>. After replacing <math id="S7.p7.m46" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> by the symplectomorphic domain <math id="S7.p7.m47" class="ltx_Math" alttext="\varphi_{E}^{1}(X)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>φ</mi><mi>E</mi><mn>1</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\varphi_{E}^{1}(X)</annotation></semantics></math>, we can therefore assume that <math id="S7.p7.m48" class="ltx_Math" alttext="\partial_{0}X\subset\mathbb{R}\times\left\{0\right\}\times\mathbb{R}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∂</mo><mn>0</mn></msub><mi>X</mi></mrow><mo>⊂</mo><mrow><mi>ℝ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo>{</mo><mn>0</mn><mo rspace="0.055em">}</mo></mrow><mo rspace="0.222em">×</mo><msup><mi>ℝ</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\partial_{0}X\subset\mathbb{R}\times\left\{0\right\}\times\mathbb{R}^{2}</annotation></semantics></math>. Note that this replacement does not affect the boundary stratum <math id="S7.p7.m49" class="ltx_Math" alttext="\partial_{1}X" display="inline" intent=":literal"><semantics><mrow><msub><mo>∂</mo><mn>1</mn></msub><mi>X</mi></mrow><annotation encoding="application/x-tex">\partial_{1}X</annotation></semantics></math>. An analogous construction therefore allows us to further reduce to the case <math id="S7.p7.m50" class="ltx_Math" alttext="\partial_{1}X\subset\mathbb{R}\times\left\{1\right\}\times\mathbb{R}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∂</mo><mn>1</mn></msub><mi>X</mi></mrow><mo>⊂</mo><mrow><mi>ℝ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo>{</mo><mn>1</mn><mo rspace="0.055em">}</mo></mrow><mo rspace="0.222em">×</mo><msup><mi>ℝ</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\partial_{1}X\subset\mathbb{R}\times\left\{1\right\}\times\mathbb{R}^{2}</annotation></semantics></math>.</span></p>
</div>
<div id="S7.p8" class="ltx_para">
<p id="S7.p8.1" class="ltx_p"><em id="S7.p8.1.1" class="ltx_emph ltx_font_italic">Step 2:</em><span id="S7.p8.1.2" class="ltx_text"> Let us now assume that <math id="S7.p8.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> satisfies (<a href="#S7.E1" title="In Proof. ‣ 7. Symplectic frusta ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.1</span></a>). If <math id="S7.p8.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is sufficiently <math id="S7.p8.m3" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math> close to <math id="S7.p8.m4" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>, we may choose compactly supported and <math id="S7.p8.m5" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math> small Hamiltonians <math id="S7.p8.m6" class="ltx_Math" alttext="E,E_{\pm}:[0,1]\times\mathbb{R}^{2}\rightarrow\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>,</mo><mrow><msub><mi>E</mi><mo>±</mo></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><msup><mi>ℝ</mi><mn>2</mn></msup></mrow><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">E,E_{\pm}:[0,1]\times\mathbb{R}^{2}\rightarrow\mathbb{R}</annotation></semantics></math> satisfying the following properties:</span></p>
<ul id="S7.I3" class="ltx_itemize">
<li id="S7.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S7.I3.i1.p1" class="ltx_para">
<p id="S7.I3.i1.p1.1" class="ltx_p"><math id="S7.I3.i1.p1.m1" class="ltx_Math" alttext="\partial_{-}X" display="inline" intent=":literal"><semantics><mrow><msub><mo>∂</mo><mo>−</mo></msub><mi>X</mi></mrow><annotation encoding="application/x-tex">\partial_{-}X</annotation></semantics></math> is contained in the graph of <math id="S7.I3.i1.p1.m2" class="ltx_Math" alttext="E_{-}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mo>−</mo></msub><annotation encoding="application/x-tex">E_{-}</annotation></semantics></math>.</p>
</div></li>
<li id="S7.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S7.I3.i2.p1" class="ltx_para">
<p id="S7.I3.i2.p1.1" class="ltx_p"><math id="S7.I3.i2.p1.m1" class="ltx_Math" alttext="\partial_{+}X" display="inline" intent=":literal"><semantics><mrow><msub><mo>∂</mo><mo>+</mo></msub><mi>X</mi></mrow><annotation encoding="application/x-tex">\partial_{+}X</annotation></semantics></math> is contained in the graph of <math id="S7.I3.i2.p1.m2" class="ltx_Math" alttext="a+E_{+}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>+</mo><msub><mi>E</mi><mo>+</mo></msub></mrow><annotation encoding="application/x-tex">a+E_{+}</annotation></semantics></math>.</p>
</div></li>
<li id="S7.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S7.I3.i3.p1" class="ltx_para">
<p id="S7.I3.i3.p1.1" class="ltx_p"><math id="S7.I3.i3.p1.m1" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> agrees with <math id="S7.I3.i3.p1.m2" class="ltx_Math" alttext="E_{-}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mo>−</mo></msub><annotation encoding="application/x-tex">E_{-}</annotation></semantics></math> on the set <math id="S7.I3.i3.p1.m3" class="ltx_Math" alttext="[0,1]\times(\mathbb{R}^{2}\setminus B^{2}(b+3(c-b)/5))" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ℝ</mi><mn>2</mn></msup><mo>∖</mo><mrow><msup><mi>B</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo>+</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>−</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mn>5</mn></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">[0,1]\times(\mathbb{R}^{2}\setminus B^{2}(b+3(c-b)/5))</annotation></semantics></math>.</p>
</div></li>
<li id="S7.I3.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S7.I3.i4.p1" class="ltx_para">
<p id="S7.I3.i4.p1.1" class="ltx_p"><math id="S7.I3.i4.p1.m1" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> agrees with <math id="S7.I3.i4.p1.m2" class="ltx_Math" alttext="E_{+}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mo>+</mo></msub><annotation encoding="application/x-tex">E_{+}</annotation></semantics></math> on the set <math id="S7.I3.i4.p1.m3" class="ltx_Math" alttext="[0,1]\times B^{2}(b+2(c-b)/5)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><msup><mi>B</mi><mn>2</mn></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo>+</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>−</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mn>5</mn></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">[0,1]\times B^{2}(b+2(c-b)/5)</annotation></semantics></math>.</p>
</div></li>
</ul>
<p id="S7.p8.2" class="ltx_p"><span id="S7.p8.2.1" class="ltx_text">By Lemma <a href="#S4.Thmtheorem3" title="Lemma 4.3. ‣ 4. Stratification of subgraphs ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a>, the domain <math id="S7.p8.m7" class="ltx_Math" alttext="D(E_{-},a+E_{+})" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mo>−</mo></msub><mo>,</mo><mrow><mi>a</mi><mo>+</mo><msub><mi>E</mi><mo>+</mo></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(E_{-},a+E_{+})</annotation></semantics></math> is symplectomorphic to <math id="S7.p8.m8" class="ltx_Math" alttext="D(\overline{E}\#E_{-},\overline{E}\#(a+E_{+}))" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>E</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mo>−</mo></msub></mrow><mo>,</mo><mrow><mover accent="true"><mi>E</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>+</mo><msub><mi>E</mi><mo>+</mo></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(\overline{E}\#E_{-},\overline{E}\#(a+E_{+}))</annotation></semantics></math>. Since <math id="S7.p8.m9" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> is <math id="S7.p8.m10" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math> small, the proof of Lemma <a href="#S4.Thmtheorem3" title="Lemma 4.3. ‣ 4. Stratification of subgraphs ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a> in fact yields a symplectomorphism <math id="S7.p8.m11" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math> of <math id="S7.p8.m12" class="ltx_Math" alttext="\mathbb{R}^{4}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mn>4</mn></msup><annotation encoding="application/x-tex">\mathbb{R}^{4}</annotation></semantics></math> which is <math id="S7.p8.m13" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math> close to the identity and maps <math id="S7.p8.m14" class="ltx_Math" alttext="D(E_{-},a+E_{+})" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mo>−</mo></msub><mo>,</mo><mrow><mi>a</mi><mo>+</mo><msub><mi>E</mi><mo>+</mo></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(E_{-},a+E_{+})</annotation></semantics></math> to <math id="S7.p8.m15" class="ltx_Math" alttext="D(\overline{E}\#E_{-},\overline{E}\#(a+E_{+}))" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>E</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mo>−</mo></msub></mrow><mo>,</mo><mrow><mover accent="true"><mi>E</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>+</mo><msub><mi>E</mi><mo>+</mo></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(\overline{E}\#E_{-},\overline{E}\#(a+E_{+}))</annotation></semantics></math>. If <math id="S7.p8.m16" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is sufficiently <math id="S7.p8.m17" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math> close to <math id="S7.p8.m18" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>, then <math id="S7.p8.m19" class="ltx_Math" alttext="\overline{E}\#E_{-}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>E</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mo>−</mo></msub></mrow><annotation encoding="application/x-tex">\overline{E}\#E_{-}</annotation></semantics></math> vanishes on the set <math id="S7.p8.m20" class="ltx_Math" alttext="[0,1]\times(\mathbb{R}^{2}\setminus B^{2}(b+4(c-b)/5))" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ℝ</mi><mn>2</mn></msup><mo>∖</mo><mrow><msup><mi>B</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo>+</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>−</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mn>5</mn></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">[0,1]\times(\mathbb{R}^{2}\setminus B^{2}(b+4(c-b)/5))</annotation></semantics></math> and <math id="S7.p8.m21" class="ltx_Math" alttext="\overline{E}\#(a+E_{+})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>E</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>+</mo><msub><mi>E</mi><mo>+</mo></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\overline{E}\#(a+E_{+})</annotation></semantics></math> is equal to <math id="S7.p8.m22" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> on the set <math id="S7.p8.m23" class="ltx_Math" alttext="[0,1]\times B^{2}(b+(c-b)/5)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><msup><mi>B</mi><mn>2</mn></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>−</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>5</mn></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">[0,1]\times B^{2}(b+(c-b)/5)</annotation></semantics></math>. This implies that the Lagrangian annulus <math id="S7.p8.m24" class="ltx_Math" alttext="\psi(\partial_{-}X\cap\partial_{\bullet}X)" display="inline" intent=":literal"><semantics><mrow><mi>ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mo lspace="0em">∂</mo><mo>−</mo></msub><mi>X</mi></mrow><mo rspace="0.055em">∩</mo><mrow><msub><mo>∂</mo><mo>∙</mo></msub><mi>X</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\psi(\partial_{-}X\cap\partial_{\bullet}X)</annotation></semantics></math> is of the form <math id="S7.p8.m25" class="ltx_Math" alttext="\left\{0\right\}\times[0,1]\times C" display="inline" intent=":literal"><semantics><mrow><mrow><mo>{</mo><mn>0</mn><mo rspace="0.055em">}</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><mi>C</mi></mrow><annotation encoding="application/x-tex">\left\{0\right\}\times[0,1]\times C</annotation></semantics></math> where <math id="S7.p8.m26" class="ltx_Math" alttext="C\subset\mathbb{R}^{2}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⊂</mo><msup><mi>ℝ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">C\subset\mathbb{R}^{2}</annotation></semantics></math> is a circle <math id="S7.p8.m27" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math> close to <math id="S7.p8.m28" class="ltx_Math" alttext="\partial B^{2}(c)" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mrow><msup><mi>B</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\partial B^{2}(c)</annotation></semantics></math>. Moreover, it implies that the solid cylinder <math id="S7.p8.m29" class="ltx_Math" alttext="\psi(\partial_{+}X)" display="inline" intent=":literal"><semantics><mrow><mi>ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mo lspace="0em">∂</mo><mo>+</mo></msub><mi>X</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\psi(\partial_{+}X)</annotation></semantics></math> is of the form <math id="S7.p8.m30" class="ltx_Math" alttext="\left\{a\right\}\times[0,1]\times B" display="inline" intent=":literal"><semantics><mrow><mrow><mo>{</mo><mi>a</mi><mo rspace="0.055em">}</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">\left\{a\right\}\times[0,1]\times B</annotation></semantics></math> where <math id="S7.p8.m31" class="ltx_Math" alttext="B\subset\mathbb{R}^{2}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>⊂</mo><msup><mi>ℝ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">B\subset\mathbb{R}^{2}</annotation></semantics></math> is a disk <math id="S7.p8.m32" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math> close to <math id="S7.p8.m33" class="ltx_Math" alttext="B^{2}(b)" display="inline" intent=":literal"><semantics><mrow><msup><mi>B</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B^{2}(b)</annotation></semantics></math>. We may pick an area preserving diffeomorphism <math id="S7.p8.m34" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> of <math id="S7.p8.m35" class="ltx_Math" alttext="\mathbb{R}^{2}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\mathbb{R}^{2}</annotation></semantics></math> which is <math id="S7.p8.m36" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math> close to the identity and satisfies <math id="S7.p8.m37" class="ltx_Math" alttext="\alpha(C)=\partial B^{2}(c^{\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo>∂</mo><mrow><msup><mi>B</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>c</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\alpha(C)=\partial B^{2}(c^{\prime})</annotation></semantics></math> and <math id="S7.p8.m38" class="ltx_Math" alttext="\alpha(B)=\partial B^{2}(b^{\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo>∂</mo><mrow><msup><mi>B</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>b</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\alpha(B)=\partial B^{2}(b^{\prime})</annotation></semantics></math> with <math id="S7.p8.m39" class="ltx_Math" alttext="b^{\prime},c^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>b</mi><mo>′</mo></msup><mo>,</mo><msup><mi>c</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">b^{\prime},c^{\prime}</annotation></semantics></math> close to <math id="S7.p8.m40" class="ltx_Math" alttext="b,c" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>,</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">b,c</annotation></semantics></math>, respectively. The resulting domain <math id="S7.p8.m41" class="ltx_Math" alttext="(\operatorname{id}_{\mathbb{R}^{2}}\times\alpha)\circ\psi(X)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>id</mi><msup><mi>ℝ</mi><mn>2</mn></msup></msub><mo lspace="0em" rspace="0.222em">×</mo><mi>α</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">∘</mo><mrow><mi>ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(\operatorname{id}_{\mathbb{R}^{2}}\times\alpha)\circ\psi(X)</annotation></semantics></math> is then of the form <math id="S7.p8.m42" class="ltx_Math" alttext="D(G,H)" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(G,H)</annotation></semantics></math> where <math id="S7.p8.m43" class="ltx_Math" alttext="G,H:[0,1]\times B^{2}(c^{\prime})\rightarrow\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>,</mo><mrow><mi>H</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><msup><mi>B</mi><mn>2</mn></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>c</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">G,H:[0,1]\times B^{2}(c^{\prime})\rightarrow\mathbb{R}</annotation></semantics></math> satisfy all the properties listed in Lemma <a href="#S7.Thmtheorem2" title="Lemma 7.2. ‣ 7. Symplectic frusta ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.2</span></a>.
∎</span></p>
</div>
</div>
<div id="S7.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Theorem <a href="#S7.Thmtheorem1" title="Theorem 7.1. ‣ 7. Symplectic frusta ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.1</span></a>.</h6>
<div id="S7.p9" class="ltx_para">
<p id="S7.p9.1" class="ltx_p"><span id="S7.p9.1.1" class="ltx_text">Fix a symplectic frustum <math id="S7.p9.m1" class="ltx_Math" alttext="F=F(a,b,c)" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>=</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F=F(a,b,c)</annotation></semantics></math> and let <math id="S7.p9.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> be a perturbed symplectic frustum <math id="S7.p9.m3" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math> close to <math id="S7.p9.m4" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>. Let the positive numbers <math id="S7.p9.m5" class="ltx_Math" alttext="a^{\prime},b^{\prime},c^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>a</mi><mo>′</mo></msup><mo>,</mo><msup><mi>b</mi><mo>′</mo></msup><mo>,</mo><msup><mi>c</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">a^{\prime},b^{\prime},c^{\prime}</annotation></semantics></math> and the Hamiltonians <math id="S7.p9.m6" class="ltx_Math" alttext="G,H" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>,</mo><mi>H</mi></mrow><annotation encoding="application/x-tex">G,H</annotation></semantics></math> satisfy all assertions in Lemma <a href="#S7.Thmtheorem2" title="Lemma 7.2. ‣ 7. Symplectic frusta ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.2</span></a>. Since <math id="S7.p9.m7" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is symplectomorphic to <math id="S7.p9.m8" class="ltx_Math" alttext="D(G,H)" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(G,H)</annotation></semantics></math>, it suffices to construct a <math id="S7.p9.m9" class="ltx_Math" alttext="\partial" display="inline" intent=":literal"><semantics><mo>∂</mo><annotation encoding="application/x-tex">\partial</annotation></semantics></math>-tame packing of the latter domain.</span></p>
</div>
<div id="S7.p10" class="ltx_para">
<p id="S7.p10.1" class="ltx_p"><span id="S7.p10.1.1" class="ltx_text">Pick a number <math id="S7.p10.m1" class="ltx_Math" alttext="d&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d&gt;0</annotation></semantics></math> close to <math id="S7.p10.m2" class="ltx_Math" alttext="a^{\prime}/2" display="inline" intent=":literal"><semantics><mrow><msup><mi>a</mi><mo>′</mo></msup><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">a^{\prime}/2</annotation></semantics></math> such that <math id="S7.p10.m3" class="ltx_Math" alttext="d/c^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>/</mo><msup><mi>c</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">d/c^{\prime}</annotation></semantics></math> is not an integer. Define the Hamitonian</span></p>
<table id="S7.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex8.m1" class="ltx_Math" alttext="E:[0,1]\times B^{2}(c^{\prime})\rightarrow\mathbb{R}\qquad E(t,p)\coloneqq d(1-\pi|p|^{2}/c^{\prime})" display="block" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><msup><mi>B</mi><mn>2</mn></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>c</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><mi>p</mi><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow><mo>/</mo><msup><mi>c</mi><mo>′</mo></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">E:[0,1]\times B^{2}(c^{\prime})\rightarrow\mathbb{R}\qquad E(t,p)\coloneqq d(1-\pi|p|^{2}/c^{\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p10.2" class="ltx_p"><span id="S7.p10.2.1" class="ltx_text">We divide <math id="S7.p10.m4" class="ltx_Math" alttext="D(G,H)" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(G,H)</annotation></semantics></math> into <math id="S7.p10.m5" class="ltx_Math" alttext="D(G,E)" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(G,E)</annotation></semantics></math> and <math id="S7.p10.m6" class="ltx_Math" alttext="D(E,H)" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>E</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(E,H)</annotation></semantics></math>. By Lemma <a href="#S6.Thmtheorem2" title="Lemma 6.2. ‣ 6. Tame packings by balls and polydisks ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.2</span></a>, it suffices to show that both pieces admit <math id="S7.p10.m7" class="ltx_Math" alttext="\partial" display="inline" intent=":literal"><semantics><mo>∂</mo><annotation encoding="application/x-tex">\partial</annotation></semantics></math>-tame packings.</span></p>
</div>
<div id="S7.p11" class="ltx_para">
<p id="S7.p11.1" class="ltx_p"><span id="S7.p11.1.1" class="ltx_text">The piece <math id="S7.p11.m1" class="ltx_Math" alttext="D(G,E)" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(G,E)</annotation></semantics></math> is symplectomorphic to <math id="S7.p11.m2" class="ltx_Math" alttext="D(\overline{G}\#E)" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>G</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(\overline{G}\#E)</annotation></semantics></math>. Note that <math id="S7.p11.m3" class="ltx_Math" alttext="\overline{G}\#E" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>G</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow><annotation encoding="application/x-tex">\overline{G}\#E</annotation></semantics></math> is a <math id="S7.p11.m4" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math> small perturbation of <math id="S7.p11.m5" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>. The time <math id="S7.p11.m6" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>-map <math id="S7.p11.m7" class="ltx_Math" alttext="\varphi_{E}^{1}" display="inline" intent=":literal"><semantics><msubsup><mi>φ</mi><mi>E</mi><mn>1</mn></msubsup><annotation encoding="application/x-tex">\varphi_{E}^{1}</annotation></semantics></math> is a rotation by <math id="S7.p11.m8" class="ltx_Math" alttext="2\pi d/c^{\prime}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>/</mo><msup><mi>c</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">2\pi d/c^{\prime}</annotation></semantics></math>. Since <math id="S7.p11.m9" class="ltx_Math" alttext="d/c^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>/</mo><msup><mi>c</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">d/c^{\prime}</annotation></semantics></math> is not an integer, the center of the disk <math id="S7.p11.m10" class="ltx_Math" alttext="B^{2}(c^{\prime})" display="inline" intent=":literal"><semantics><mrow><msup><mi>B</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>c</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B^{2}(c^{\prime})</annotation></semantics></math> is a non-degenerate fixed point. Therefore, the time-<math id="S7.p11.m11" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>-map <math id="S7.p11.m12" class="ltx_Math" alttext="\varphi_{\overline{G}\#E}^{1}" display="inline" intent=":literal"><semantics><msubsup><mi>φ</mi><mrow><mover accent="true"><mi>G</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow><mn>1</mn></msubsup><annotation encoding="application/x-tex">\varphi_{\overline{G}\#E}^{1}</annotation></semantics></math> has a non-degenerate fixed point <math id="S7.p11.m13" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> near the center. After conjugation by a area preserving diffeomorphism of <math id="S7.p11.m14" class="ltx_Math" alttext="B^{2}(c^{\prime})" display="inline" intent=":literal"><semantics><mrow><msup><mi>B</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>c</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B^{2}(c^{\prime})</annotation></semantics></math> which is <math id="S7.p11.m15" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math>-close to the identity, we can assume that <math id="S7.p11.m16" class="ltx_Math" alttext="p=0" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">p=0</annotation></semantics></math>. Moreover, it is not hard to construct a Hamiltonian <math id="S7.p11.m17" class="ltx_Math" alttext="\tilde{E}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>E</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{E}</annotation></semantics></math> which vanishes on <math id="S7.p11.m18" class="ltx_Math" alttext="[0,1]\times\partial B^{2}(c^{\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.055em">×</mo><mrow><mo>∂</mo><mrow><msup><mi>B</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>c</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">[0,1]\times\partial B^{2}(c^{\prime})</annotation></semantics></math>, is <math id="S7.p11.m19" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math> close to <math id="S7.p11.m20" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>, has the property that the center is the unique maximizer of <math id="S7.p11.m21" class="ltx_Math" alttext="\tilde{E}_{t}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>E</mi><mo>~</mo></mover><mi>t</mi></msub><annotation encoding="application/x-tex">\tilde{E}_{t}</annotation></semantics></math> for all <math id="S7.p11.m22" class="ltx_Math" alttext="t\in[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[0,1]</annotation></semantics></math>, and such that <math id="S7.p11.m23" class="ltx_Math" alttext="D(\tilde{E})" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>E</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(\tilde{E})</annotation></semantics></math> is symplectomorphic to <math id="S7.p11.m24" class="ltx_Math" alttext="D(\overline{G}\#E)" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>G</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(\overline{G}\#E)</annotation></semantics></math>. Consider the area preserving map</span></p>
<table id="S7.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex9.m1" class="ltx_Math" alttext="\psi:\mathbb{A}(c^{\prime})\rightarrow B^{2}(c^{\prime})\qquad(x,y)\mapsto\sqrt{\frac{x}{\pi}}e^{2\pi i\theta}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ψ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>𝔸</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>c</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>B</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>c</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">↦</mo><mrow><msqrt><mfrac><mi>x</mi><mi>π</mi></mfrac></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\psi:\mathbb{A}(c^{\prime})\rightarrow B^{2}(c^{\prime})\qquad(x,y)\mapsto\sqrt{\frac{x}{\pi}}e^{2\pi i\theta}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p11.2" class="ltx_p"><span id="S7.p11.2.1" class="ltx_text">Note that the pullback <math id="S7.p11.m25" class="ltx_Math" alttext="\psi^{*}\tilde{E}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ψ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>E</mi><mo>~</mo></mover></mrow><annotation encoding="application/x-tex">\psi^{*}\tilde{E}</annotation></semantics></math> is a Hamiltonian as in Theorem <a href="#S6.Thmtheorem7" title="Theorem 6.7. ‣ 6. Tame packings by balls and polydisks ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.7</span></a> and therefore admits a <math id="S7.p11.m26" class="ltx_Math" alttext="\partial" display="inline" intent=":literal"><semantics><mo>∂</mo><annotation encoding="application/x-tex">\partial</annotation></semantics></math>-tame packing. Since every embedding of a symplectic ribbon complex into <math id="S7.p11.m27" class="ltx_Math" alttext="D(\psi^{*}\tilde{E})" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ψ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>E</mi><mo>~</mo></mover></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(\psi^{*}\tilde{E})</annotation></semantics></math> induces an embedding into <math id="S7.p11.m28" class="ltx_Math" alttext="D(\tilde{E})" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>E</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(\tilde{E})</annotation></semantics></math> via <math id="S7.p11.m29" class="ltx_Math" alttext="\operatorname{id}_{\mathbb{R}^{2}}\times\psi" display="inline" intent=":literal"><semantics><mrow><msub><mi>id</mi><msup><mi>ℝ</mi><mn>2</mn></msup></msub><mo lspace="0em" rspace="0.222em">×</mo><mi>ψ</mi></mrow><annotation encoding="application/x-tex">\operatorname{id}_{\mathbb{R}^{2}}\times\psi</annotation></semantics></math>, we deduce that <math id="S7.p11.m30" class="ltx_Math" alttext="D(\tilde{E})" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>E</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(\tilde{E})</annotation></semantics></math> admits a <math id="S7.p11.m31" class="ltx_Math" alttext="\partial" display="inline" intent=":literal"><semantics><mo>∂</mo><annotation encoding="application/x-tex">\partial</annotation></semantics></math>-tame packing as well.</span></p>
</div>
<div id="S7.p12" class="ltx_para">
<p id="S7.p12.1" class="ltx_p"><span id="S7.p12.1.1" class="ltx_text">Next, consider the piece <math id="S7.p12.m1" class="ltx_Math" alttext="D(E,H)" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>E</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(E,H)</annotation></semantics></math>, which is symplectomorphic to <math id="S7.p12.m2" class="ltx_Math" alttext="D(\overline{E}\#H)" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>E</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>H</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(\overline{E}\#H)</annotation></semantics></math>. Again, let us consider the pullback <math id="S7.p12.m3" class="ltx_Math" alttext="\psi^{*}(\overline{E}\#H)" display="inline" intent=":literal"><semantics><mrow><msup><mi>ψ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>E</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>H</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\psi^{*}(\overline{E}\#H)</annotation></semantics></math> to a Hamiltonian on <math id="S7.p12.m4" class="ltx_Math" alttext="\mathbb{A}(a^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>𝔸</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{A}(a^{\prime})</annotation></semantics></math>. It suffices to construct a <math id="S7.p12.m5" class="ltx_Math" alttext="\partial" display="inline" intent=":literal"><semantics><mo>∂</mo><annotation encoding="application/x-tex">\partial</annotation></semantics></math>-tame packing of <math id="S7.p12.m6" class="ltx_Math" alttext="D(\psi^{*}(\overline{E}\#H))" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ψ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>E</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>H</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(\psi^{*}(\overline{E}\#H))</annotation></semantics></math>. Let us divide <math id="S7.p12.m7" class="ltx_Math" alttext="\mathbb{A}(c^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>𝔸</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>c</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{A}(c^{\prime})</annotation></semantics></math> into two smaller annuli</span></p>
<table id="S7.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex10.m1" class="ltx_Math" alttext="\mathbb{A}_{1}\coloneqq[0,b^{\prime}]\times\mathbb{T}\quad\text{and}\quad\mathbb{A}_{2}\coloneqq[b^{\prime},c^{\prime}]\times\mathbb{T}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔸</mi><mn>1</mn></msub><mo>≔</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><msup><mi>b</mi><mo>′</mo></msup></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><mi>𝕋</mi></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mi>𝔸</mi><mn>2</mn></msub><mo>≔</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><msup><mi>b</mi><mo>′</mo></msup><mo>,</mo><msup><mi>c</mi><mo>′</mo></msup></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><mi>𝕋</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{A}_{1}\coloneqq[0,b^{\prime}]\times\mathbb{T}\quad\text{and}\quad\mathbb{A}_{2}\coloneqq[b^{\prime},c^{\prime}]\times\mathbb{T}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p12.2" class="ltx_p"><span id="S7.p12.2.1" class="ltx_text">We stratify <math id="S7.p12.m8" class="ltx_Math" alttext="D(\psi^{*}(\overline{E}\#H))" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ψ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>E</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>H</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(\psi^{*}(\overline{E}\#H))</annotation></semantics></math> into two pieces <math id="S7.p12.m9" class="ltx_Math" alttext="D(\psi^{*}(\overline{E}\#H)|_{[0,1]\times\mathbb{A}_{1}})" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mrow><msup><mi>ψ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>E</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>H</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><msub><mi>𝔸</mi><mn>1</mn></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(\psi^{*}(\overline{E}\#H)|_{[0,1]\times\mathbb{A}_{1}})</annotation></semantics></math> and <math id="S7.p12.m10" class="ltx_Math" alttext="D(\psi^{*}(\overline{E}\#H)_{[0,1]\times\mathbb{A}_{2}})" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ψ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>E</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>H</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><msub><mi>𝔸</mi><mn>2</mn></msub></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(\psi^{*}(\overline{E}\#H)_{[0,1]\times\mathbb{A}_{2}})</annotation></semantics></math>. On the annulus <math id="S7.p12.m11" class="ltx_Math" alttext="\mathbb{A}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝔸</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathbb{A}_{1}</annotation></semantics></math>, the Hamiltonian <math id="S7.p12.m12" class="ltx_Math" alttext="\psi^{*}(\overline{E}\#H)" display="inline" intent=":literal"><semantics><mrow><msup><mi>ψ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>E</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>H</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\psi^{*}(\overline{E}\#H)</annotation></semantics></math> is strictly positive and affine. Therefore, the first stratum admits a <math id="S7.p12.m13" class="ltx_Math" alttext="\partial" display="inline" intent=":literal"><semantics><mo>∂</mo><annotation encoding="application/x-tex">\partial</annotation></semantics></math>-tame packing as a special case of Corollary <a href="#S6.Thmtheorem6" title="Corollary 6.6. ‣ 6. Tame packings by balls and polydisks ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.6</span></a>. On the annulus <math id="S7.p12.m14" class="ltx_Math" alttext="\mathbb{A}_{2}" display="inline" intent=":literal"><semantics><msub><mi>𝔸</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\mathbb{A}_{2}</annotation></semantics></math>, the Hamiltonian <math id="S7.p12.m15" class="ltx_Math" alttext="\psi^{*}(\overline{E}\#H)" display="inline" intent=":literal"><semantics><mrow><msup><mi>ψ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>E</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>H</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\psi^{*}(\overline{E}\#H)</annotation></semantics></math> is of the form considered in Theorem <a href="#S6.Thmtheorem7" title="Theorem 6.7. ‣ 6. Tame packings by balls and polydisks ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.7</span></a>. Thus, the second stratum also admits a <math id="S7.p12.m16" class="ltx_Math" alttext="\partial" display="inline" intent=":literal"><semantics><mo>∂</mo><annotation encoding="application/x-tex">\partial</annotation></semantics></math>-tame packing. We conclude that the same is true for <math id="S7.p12.m17" class="ltx_Math" alttext="D(E,H)" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>E</mi><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(E,H)</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S7.p13" class="ltx_para">
<p id="S7.p13.1" class="ltx_p">Let <math id="S7.p13.m1" class="ltx_Math" alttext="X\subset\mathbb{R}^{4}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>⊂</mo><msup><mi>ℝ</mi><mn>4</mn></msup></mrow><annotation encoding="application/x-tex">X\subset\mathbb{R}^{4}</annotation></semantics></math> be a perturbed symplectic frustum. In the following, we introduce a cut operation which produces a new domain <math id="S7.p13.m2" class="ltx_Math" alttext="\tilde{X}\subset\mathbb{R}^{4}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo>⊂</mo><msup><mi>ℝ</mi><mn>4</mn></msup></mrow><annotation encoding="application/x-tex">\tilde{X}\subset\mathbb{R}^{4}</annotation></semantics></math>. Let <math id="S7.p13.m3" class="ltx_Math" alttext="\varepsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\varepsilon&gt;0</annotation></semantics></math> and <math id="S7.p13.m4" class="ltx_Math" alttext="a&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a&gt;0</annotation></semantics></math> be positive real numbers. Suppose that <math id="S7.p13.m5" class="ltx_Math" alttext="\varphi" display="inline" intent=":literal"><semantics><mi>φ</mi><annotation encoding="application/x-tex">\varphi</annotation></semantics></math> is a symplectomorphism of <math id="S7.p13.m6" class="ltx_Math" alttext="\mathbb{R}^{4}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mn>4</mn></msup><annotation encoding="application/x-tex">\mathbb{R}^{4}</annotation></semantics></math> such that</p>
<table id="S7.E2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(7.2)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E2.m1" class="ltx_math_unparsed" alttext="\varphi(X)\kern 5.0pt\cap\kern 5.0pt\mathbb{R}^{2}\times(-\varepsilon,+\infty)\times(-\varepsilon,\varepsilon)=\left\{0\leq s\leq\min\left\{a,a-ax\right\},0\leq t\leq 1,-\varepsilon&lt;x\leq 1,-\varepsilon&lt;y&lt;\varepsilon\right\}." display="block" intent=":literal"><semantics><mrow><mi>φ</mi><mrow><mo stretchy="false">(</mo><mi>X</mi><mo rspace="0.500em" stretchy="false">)</mo></mrow><mo rspace="0.722em">∩</mo><msup><mi>ℝ</mi><mn>2</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>ε</mi><mo rspace="0em">,</mo><mo lspace="0em">+</mo><mi mathvariant="normal">∞</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>ε</mi><mo>,</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo>{</mo><mn>0</mn><mo>≤</mo><mi>s</mi><mo>≤</mo><mi>min</mi><mrow><mo>{</mo><mi>a</mi><mo>,</mo><mi>a</mi><mo>−</mo><mi>a</mi><mi>x</mi><mo>}</mo></mrow><mo>,</mo><mn>0</mn><mo>≤</mo><mi>t</mi><mo>≤</mo><mn>1</mn><mo rspace="0em">,</mo><mo lspace="0em">−</mo><mi>ε</mi><mo>&lt;</mo><mi>x</mi><mo>≤</mo><mn>1</mn><mo rspace="0em">,</mo><mo lspace="0em">−</mo><mi>ε</mi><mo>&lt;</mo><mi>y</mi><mo>&lt;</mo><mi>ε</mi><mo>}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\varphi(X)\kern 5.0pt\cap\kern 5.0pt\mathbb{R}^{2}\times(-\varepsilon,+\infty)\times(-\varepsilon,\varepsilon)=\left\{0\leq s\leq\min\left\{a,a-ax\right\},0\leq t\leq 1,-\varepsilon&lt;x\leq 1,-\varepsilon&lt;y&lt;\varepsilon\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p13.2" class="ltx_p">Let <math id="S7.p13.m7" class="ltx_math_unparsed" alttext="\psi:\mathbb{R}^{2}\setminus([0,+\infty)\times\left\{0\right\})\rightarrow\mathbb{R}^{2}" display="inline" intent=":literal"><semantics><mrow><mi>ψ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><msup><mi>ℝ</mi><mn>2</mn></msup><mo>∖</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo rspace="0em">,</mo><mo lspace="0em">+</mo><mi mathvariant="normal">∞</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo>{</mo><mn>0</mn><mo>}</mo></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\psi:\mathbb{R}^{2}\setminus([0,+\infty)\times\left\{0\right\})\rightarrow\mathbb{R}^{2}</annotation></semantics></math> be an area preserving embedding. Let us assume that the restriction of <math id="S7.p13.m8" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math> to each of the open quadrants <math id="S7.p13.m9" class="ltx_math_unparsed" alttext="\left\{x&gt;0,\pm y&gt;0\right\}" display="inline" intent=":literal"><semantics><mrow><mo>{</mo><mi>x</mi><mo>&gt;</mo><mn>0</mn><mo rspace="0em">,</mo><mo lspace="0em">±</mo><mi>y</mi><mo>&gt;</mo><mn>0</mn><mo>}</mo></mrow><annotation encoding="application/x-tex">\left\{x&gt;0,\pm y&gt;0\right\}</annotation></semantics></math> extends to a smooth area preserving embedding of the closed quadrant <math id="S7.p13.m10" class="ltx_math_unparsed" alttext="\psi_{\pm}:\left\{x\geq 0,\pm y\geq 0\right\}\rightarrow\mathbb{R}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mo>±</mo></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo>{</mo><mi>x</mi><mo>≥</mo><mn>0</mn><mo rspace="0em">,</mo><mo lspace="0em">±</mo><mi>y</mi><mo>≥</mo><mn>0</mn><mo>}</mo></mrow><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\psi_{\pm}:\left\{x\geq 0,\pm y\geq 0\right\}\rightarrow\mathbb{R}^{2}</annotation></semantics></math>. Moreover, assume that the boundary of the image of <math id="S7.p13.m11" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math> is piecewise smooth; see Figure <a href="#S7.F2" title="Figure 7.2 ‣ 7. Symplectic frusta ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.2</span></a>.</p>
</div>
<figure id="S7.F2" class="ltx_figure"><span id="S7.F2.pic1" class="ltx_picture ltx_centering" style="width:1.0pt;height:0.81818182pt;"><svg xmlns="http://www.w3.org/2000/svg" version="1.1" width="1.33" height="1.09" overflow="visible"><g transform="translate(0,1.09) scale(1,-1)"><g transform="translate(0,0)"><g transform="translate(0,225.02) scale(1,-1)"><foreignObject width="274.97" height="225.02" overflow="visible"><object type="image/svg+xml" data="2509.15390v1/x28.svg" id="S7.F2.pic1.g1" class="ltx_graphics ltx_img_square" width="286" height="234" aria-label="Refer to caption"></object></foreignObject></g></g><g transform="translate(0.32,0.66)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="17.53" height="11.16" overflow="visible"><Math mode="inline" tex="\psi" text="psi" xml:id="S7.F2.pic1.m1">
                      <XMath xml:id="S7.F2.pic1.m1.1">
                        <XMTok font="italic" name="psi" role="UNKNOWN">ψ</XMTok>
                      </XMath>
                    </Math></foreignObject></g></g><g transform="translate(0.63,0.61)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="17.53" height="11.16" overflow="visible"><Math mode="inline" tex="\psi" text="psi" xml:id="S7.F2.pic1.m2">
                      <XMath xml:id="S7.F2.pic1.m2.1">
                        <XMTok font="italic" name="psi" role="UNKNOWN">ψ</XMTok>
                      </XMath>
                    </Math></foreignObject></g></g><g transform="translate(1.03,0.66)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="17.53" height="11.16" overflow="visible"><Math mode="inline" tex="\psi" text="psi" xml:id="S7.F2.pic1.m3">
                      <XMath xml:id="S7.F2.pic1.m3.1">
                        <XMTok font="italic" name="psi" role="UNKNOWN">ψ</XMTok>
                      </XMath>
                    </Math></foreignObject></g></g><g transform="translate(0,0)"><g transform="translate(0,225.02) scale(1,-1)"><foreignObject width="274.97" height="225.02" overflow="visible"><object type="image/svg+xml" data="2509.15390v1/x29.svg" id="S7.F2.pic1.g2" class="ltx_graphics ltx_img_square" width="286" height="234" aria-label="Refer to caption"></object></foreignObject></g></g><g transform="translate(0.5,0.52)"></g><g transform="translate(0.96,0.52)"></g><g transform="translate(0,0)"><g transform="translate(0,225.02) scale(1,-1)"><foreignObject width="274.97" height="225.02" overflow="visible"><object type="image/svg+xml" data="2509.15390v1/x30.svg" id="S7.F2.pic1.g3" class="ltx_graphics ltx_img_square" width="286" height="234" aria-label="Refer to caption"></object></foreignObject></g></g><g transform="translate(0.04,0.52)"></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 7.2. </span>An illustration of different possibilities for the map <math id="S7.F2.m2" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math>.</figcaption>
</figure>
<div id="S7.p14" class="ltx_para">
<p id="S7.p14.1" class="ltx_p">The new domain <math id="S7.p14.m1" class="ltx_Math" alttext="\tilde{X}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>X</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{X}</annotation></semantics></math> obtained from <math id="S7.p14.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> by cutting is defined by</p>
<table id="S7.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex11.m1" class="ltx_math_unparsed" alttext="\tilde{X}\coloneqq\operatorname{clos}((\operatorname{id}_{\mathbb{R}^{2}}\times\psi)(\varphi(X)\setminus\mathbb{R}^{2}\times[0,+\infty)\times\left\{0\right\}))," display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo>≔</mo><mi>clos</mi><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><msub><mi>id</mi><msup><mi>ℝ</mi><mn>2</mn></msup></msub><mo lspace="0em" rspace="0.222em">×</mo><mi>ψ</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>φ</mi><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo>∖</mo><msup><mi>ℝ</mi><mn>2</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo rspace="0em">,</mo><mo lspace="0em">+</mo><mi mathvariant="normal">∞</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo>{</mo><mn>0</mn><mo>}</mo></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\tilde{X}\coloneqq\operatorname{clos}((\operatorname{id}_{\mathbb{R}^{2}}\times\psi)(\varphi(X)\setminus\mathbb{R}^{2}\times[0,+\infty)\times\left\{0\right\})),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p14.2" class="ltx_p">see Figure <a href="#S7.F3" title="Figure 7.3 ‣ 7. Symplectic frusta ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.3</span></a>.</p>
</div>
<figure id="S7.F3" class="ltx_figure"><span id="S7.F3.pic1" class="ltx_picture ltx_centering" style="width:1.0pt;height:0.75072464pt;"><svg xmlns="http://www.w3.org/2000/svg" version="1.1" width="1.33" height="1.00" overflow="visible"><g transform="translate(0,1.00) scale(1,-1)"><g transform="translate(0,0)"><g transform="translate(0,275.23) scale(1,-1)"><foreignObject width="366.63" height="275.23" overflow="visible"><object type="image/svg+xml" data="2509.15390v1/x31.svg" id="S7.F3.pic1.g1" class="ltx_graphics ltx_img_landscape" width="381" height="286" aria-label="Refer to caption"></object></foreignObject></g></g><g transform="translate(0.04,0.47)"></g><g transform="translate(0.52,0.47)"></g><g transform="translate(0,0)"><g transform="translate(0,275.23) scale(1,-1)"><foreignObject width="366.63" height="275.23" overflow="visible"><object type="image/svg+xml" data="2509.15390v1/x32.svg" id="S7.F3.pic1.g2" class="ltx_graphics ltx_img_landscape" width="381" height="286" aria-label="Refer to caption"></object></foreignObject></g></g><g transform="translate(0.96,0.47)"></g><g transform="translate(0,0)"><g transform="translate(0,275.23) scale(1,-1)"><foreignObject width="366.63" height="275.23" overflow="visible"><object type="image/svg+xml" data="2509.15390v1/x33.svg" id="S7.F3.pic1.g3" class="ltx_graphics ltx_img_landscape" width="381" height="286" aria-label="Refer to caption"></object></foreignObject></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 7.3. </span>For the different choices of <math id="S7.F3.m5" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math> illustrated in Figure <a href="#S7.F2" title="Figure 7.2 ‣ 7. Symplectic frusta ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.2</span></a>, this figure shows the intersection of <math id="S7.F3.m6" class="ltx_Math" alttext="\tilde{X}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>X</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{X}</annotation></semantics></math> with <math id="S7.F3.m7" class="ltx_Math" alttext="\mathbb{R}\times\left\{t\right\}\times\mathbb{R}^{2}" display="inline" intent=":literal"><semantics><mrow><mi>ℝ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo>{</mo><mi>t</mi><mo rspace="0.055em">}</mo></mrow><mo rspace="0.222em">×</mo><msup><mi>ℝ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\mathbb{R}\times\left\{t\right\}\times\mathbb{R}^{2}</annotation></semantics></math> near the cut region for <math id="S7.F3.m8" class="ltx_Math" alttext="0\leq t\leq 1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mi>t</mi><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0\leq t\leq 1</annotation></semantics></math>.</figcaption>
</figure>
<div id="S7.p15" class="ltx_para">
<p id="S7.p15.1" class="ltx_p">We call a domain <math id="S7.p15.m1" class="ltx_Math" alttext="X\subset\mathbb{R}^{4}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>⊂</mo><msup><mi>ℝ</mi><mn>4</mn></msup></mrow><annotation encoding="application/x-tex">X\subset\mathbb{R}^{4}</annotation></semantics></math> a <span id="S7.p15.1.1" class="ltx_text ltx_font_italic">perturbed symplectic frustum with cuts</span> if, up to ambient symplectomorphism, it can be obtained from a perturbed symplectic frustum by finitely many disjoint cut operations.</p>
</div>
<div id="S7.Thmtheorem3" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmtheorem3.2" class="ltx_text ltx_font_bold">Theorem 7.3</span></span><span id="S7.Thmtheorem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmtheorem3.p1" class="ltx_para">
<p id="S7.Thmtheorem3.p1.1" class="ltx_p"><span id="S7.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S7.Thmtheorem3.p1.m1" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> be a symplectic frustum. Then each perturbed symplectic frustum with cuts <math id="S7.Thmtheorem3.p1.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> obtained by cutting a perturbed symplectic frustum sufficiently <math id="S7.Thmtheorem3.p1.m3" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math> close to <math id="S7.Thmtheorem3.p1.m4" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> admits a <math id="S7.Thmtheorem3.p1.m5" class="ltx_Math" alttext="\partial" display="inline" intent=":literal"><semantics><mo>∂</mo><annotation encoding="application/x-tex">\partial</annotation></semantics></math>-tame packing by balls and polydisks.</span></p>
</div>
</div>
<div id="S7.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S7.p16" class="ltx_para">
<p id="S7.p16.1" class="ltx_p"><span id="S7.p16.1.1" class="ltx_text">Let <math id="S7.p16.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> be a perturbed symplectic frustum <math id="S7.p16.m2" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math> close to <math id="S7.p16.m3" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> and let <math id="S7.p16.m4" class="ltx_Math" alttext="\tilde{X}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>X</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{X}</annotation></semantics></math> be a domain obtained from <math id="S7.p16.m5" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> by finitely many cuts. By Theorem <a href="#S7.Thmtheorem1" title="Theorem 7.1. ‣ 7. Symplectic frusta ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.1</span></a>, the domain <math id="S7.p16.m6" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> admits a <math id="S7.p16.m7" class="ltx_Math" alttext="\partial" display="inline" intent=":literal"><semantics><mo>∂</mo><annotation encoding="application/x-tex">\partial</annotation></semantics></math>-tame packing. In order to deduce that the same is true for <math id="S7.p16.m8" class="ltx_Math" alttext="\tilde{X}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>X</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{X}</annotation></semantics></math>, we follow the same strategy that we have already used repeatedly in Section <a href="#S6" title="6. Tame packings by balls and polydisks ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>. Let <math id="S7.p16.m9" class="ltx_Math" alttext="Z\subset\operatorname{int}(X)" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>⊂</mo><mrow><mi>int</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Z\subset\operatorname{int}(X)</annotation></semantics></math> be a domain conformally symplectomorphic to <math id="S7.p16.m10" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> obtained by slightly pushing the boundary of <math id="S7.p16.m11" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> inwards. Our goal is to produce an explicit controlled symplectic embedding of <math id="S7.p16.m12" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math> into <math id="S7.p16.m13" class="ltx_Math" alttext="\operatorname{int}(\tilde{X})" display="inline" intent=":literal"><semantics><mrow><mi>int</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{int}(\tilde{X})</annotation></semantics></math> which has the property that symplectic disks in the smooth locus of the boundary of <math id="S7.p16.m14" class="ltx_Math" alttext="\tilde{X}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>X</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{X}</annotation></semantics></math> can be connected to the boundary of the image of the symplectic embedding of <math id="S7.p16.m15" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math> via symplectic ribbons. Once we have this, the fact that <math id="S7.p16.m16" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> and hence <math id="S7.p16.m17" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math> admits a <math id="S7.p16.m18" class="ltx_Math" alttext="\partial" display="inline" intent=":literal"><semantics><mo>∂</mo><annotation encoding="application/x-tex">\partial</annotation></semantics></math>-tame packing implies that <math id="S7.p16.m19" class="ltx_Math" alttext="\tilde{X}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>X</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{X}</annotation></semantics></math> also admits a <math id="S7.p16.m20" class="ltx_Math" alttext="\partial" display="inline" intent=":literal"><semantics><mo>∂</mo><annotation encoding="application/x-tex">\partial</annotation></semantics></math>-tame packing.</span></p>
</div>
<div id="S7.p17" class="ltx_para">
<p id="S7.p17.1" class="ltx_p"><span id="S7.p17.1.1" class="ltx_text">For simplicity, let us consider the case that <math id="S7.p17.m1" class="ltx_Math" alttext="\tilde{X}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>X</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{X}</annotation></semantics></math> is obtained from <math id="S7.p17.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> by a single cut. The general case can be treated by iterating the construction explained below. Let <math id="S7.p17.m3" class="ltx_Math" alttext="\varepsilon,a,\varphi,\psi" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>,</mo><mi>a</mi><mo>,</mo><mi>φ</mi><mo>,</mo><mi>ψ</mi></mrow><annotation encoding="application/x-tex">\varepsilon,a,\varphi,\psi</annotation></semantics></math> be the parameters involved in the cut which transforms <math id="S7.p17.m4" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> into <math id="S7.p17.m5" class="ltx_Math" alttext="\tilde{X}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>X</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{X}</annotation></semantics></math>. In order to simplify notation, let us replace <math id="S7.p17.m6" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> by the symplectomorphic domain <math id="S7.p17.m7" class="ltx_Math" alttext="\varphi(X)" display="inline" intent=":literal"><semantics><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\varphi(X)</annotation></semantics></math>.</span></p>
</div>
<div id="S7.p18" class="ltx_para">
<p id="S7.p18.1" class="ltx_p"><span id="S7.p18.1.1" class="ltx_text">We carry out a variant of Schlenk’s embedding construction <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx80" title="" class="ltx_ref">Sch03</a>, §2]</cite>, <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx81" title="" class="ltx_ref">Sch05a</a>, §4.1]</cite> which we have used several times in Sections <a href="#S5" title="5. Symplectic ribbon complexes ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> and <a href="#S6" title="6. Tame packings by balls and polydisks ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>. Consider the strip <math id="S7.p18.m1" class="ltx_Math" alttext="(-\varepsilon,+\infty)\times(-\varepsilon,\varepsilon)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>ε</mi></mrow><mo>,</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>ε</mi></mrow><mo>,</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(-\varepsilon,+\infty)\times(-\varepsilon,\varepsilon)</annotation></semantics></math>. Then there exists a symplectomorphism</span></p>
<table id="S7.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex12.m1" class="ltx_math_unparsed" alttext="\alpha:(-\varepsilon,+\infty)\times(-\varepsilon,\varepsilon)\rightarrow(-\varepsilon,+\infty)\times(-\varepsilon,\varepsilon)\setminus[0,+\infty)\times\left\{0\right\}" display="block" intent=":literal"><semantics><mrow><mi>α</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>ε</mi><mo rspace="0em">,</mo><mo lspace="0em">+</mo><mi mathvariant="normal">∞</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>ε</mi><mo>,</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>ε</mi><mo rspace="0em">,</mo><mo lspace="0em">+</mo><mi mathvariant="normal">∞</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>ε</mi><mo>,</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow><mo>∖</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo rspace="0em">,</mo><mo lspace="0em">+</mo><mi mathvariant="normal">∞</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo>{</mo><mn>0</mn><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha:(-\varepsilon,+\infty)\times(-\varepsilon,\varepsilon)\rightarrow(-\varepsilon,+\infty)\times(-\varepsilon,\varepsilon)\setminus[0,+\infty)\times\left\{0\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p18.2" class="ltx_p"><span id="S7.p18.2.1" class="ltx_text">which maps maps vertical line segments of the form <math id="S7.p18.m2" class="ltx_Math" alttext="\left\{x\right\}\times(-\varepsilon,\varepsilon)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>{</mo><mi>x</mi><mo rspace="0.055em">}</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>ε</mi></mrow><mo>,</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\left\{x\right\}\times(-\varepsilon,\varepsilon)</annotation></semantics></math> to members of a family of line segments <math id="S7.p18.m3" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math> as depicted in Figure <a href="#S7.F4" title="Figure 7.4 ‣ Proof. ‣ 7. Symplectic frusta ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.4</span></a>.</span></p>
</div>
<figure id="S7.F4" class="ltx_figure"><span id="S7.F4.pic1" class="ltx_picture ltx_centering" style="width:1.0pt;height:0.47142857pt;"><svg xmlns="http://www.w3.org/2000/svg" version="1.1" width="1.33" height="0.63" overflow="visible"><g transform="translate(0,0.63) scale(1,-1)"><g transform="translate(0,0)"><g transform="translate(0,172.82) scale(1,-1)"><foreignObject width="366.63" height="172.82" overflow="visible"><object type="image/svg+xml" data="2509.15390v1/x34.svg" id="S7.F4.pic1.g1" class="ltx_graphics ltx_img_landscape" width="381" height="180" aria-label="Refer to caption"></object></foreignObject></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 7.4. </span>A family <math id="S7.F4.m3" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math> of line segments in <math id="S7.F4.m4" class="ltx_math_unparsed" alttext="(-\varepsilon,+\infty)\times(-\varepsilon,\varepsilon)\setminus[0,+\infty)\times\left\{0\right\}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>ε</mi><mo rspace="0em">,</mo><mo lspace="0em">+</mo><mi mathvariant="normal">∞</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>ε</mi><mo>,</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow><mo>∖</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo rspace="0em">,</mo><mo lspace="0em">+</mo><mi mathvariant="normal">∞</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo>{</mo><mn>0</mn><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">(-\varepsilon,+\infty)\times(-\varepsilon,\varepsilon)\setminus[0,+\infty)\times\left\{0\right\}</annotation></semantics></math>.</figcaption>
</figure>
<div id="S7.p19" class="ltx_para">
<p id="S7.p19.1" class="ltx_p"><span id="S7.p19.1.1" class="ltx_text">Near the boundary of the strip, the map <math id="S7.p19.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> is close to the identity. After a small perturbation near the boundary, we can assume that <math id="S7.p19.m2" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> is exactly equal to the identity in this region. Extend <math id="S7.p19.m3" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> to a symplectomorphism between <math id="S7.p19.m4" class="ltx_Math" alttext="\mathbb{R}^{2}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\mathbb{R}^{2}</annotation></semantics></math> and <math id="S7.p19.m5" class="ltx_math_unparsed" alttext="\mathbb{R}^{2}\setminus[0,+\infty)\times\left\{0\right\}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℝ</mi><mn>2</mn></msup><mo>∖</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo rspace="0em">,</mo><mo lspace="0em">+</mo><mi mathvariant="normal">∞</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo>{</mo><mn>0</mn><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{R}^{2}\setminus[0,+\infty)\times\left\{0\right\}</annotation></semantics></math> by setting it equal to the identity outside the strip. Consider the symplectic embedding</span></p>
<table id="S7.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex13.m1" class="ltx_Math" alttext="\rho:\mathbb{R}^{4}\rightarrow\mathbb{R}^{4}\qquad\rho\coloneqq\operatorname{id}_{\mathbb{R}^{2}}\times(\psi\circ\alpha)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ρ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mn>4</mn></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mn>4</mn></msup></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mi>ρ</mi><mo>≔</mo><mrow><msub><mi>id</mi><msup><mi>ℝ</mi><mn>2</mn></msup></msub><mo lspace="0em" rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ψ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\rho:\mathbb{R}^{4}\rightarrow\mathbb{R}^{4}\qquad\rho\coloneqq\operatorname{id}_{\mathbb{R}^{2}}\times(\psi\circ\alpha).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p19.2" class="ltx_p"><span id="S7.p19.2.1" class="ltx_text">Note that the family of line segments <math id="S7.p19.m6" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math> can be arranged such that the image <math id="S7.p19.m7" class="ltx_Math" alttext="\rho(X)" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho(X)</annotation></semantics></math> approximates <math id="S7.p19.m8" class="ltx_Math" alttext="\tilde{X}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>X</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{X}</annotation></semantics></math> arbitrarily well. The desired embedding of <math id="S7.p19.m9" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math> into <math id="S7.p19.m10" class="ltx_Math" alttext="\operatorname{int}(\tilde{X})" display="inline" intent=":literal"><semantics><mrow><mi>int</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{int}(\tilde{X})</annotation></semantics></math> is simply given by the restriction <math id="S7.p19.m11" class="ltx_Math" alttext="\rho|_{Z}" display="inline" intent=":literal"><semantics><msub><mrow><mi>ρ</mi><mo stretchy="false">|</mo></mrow><mi>Z</mi></msub><annotation encoding="application/x-tex">\rho|_{Z}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="S8" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">8. </span>Proof of ellipsoid embedding stability</h2>

<div id="S8.p1" class="ltx_para">
<p id="S8.p1.1" class="ltx_p">The goal of this section is to prove Theorem <a href="#Thmintrothm2" title="Theorem B (Ellipsoid embedding stability). ‣ 1.2. Ellipsoid embedding stability ‣ 1. Introduction ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B</span></a>, i.e. that ellipsoid embedding stability holds for every compact connected symplectic <math id="S8.p1.m1" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math>-manifold with smooth boundary.
<br class="ltx_break"></p>
</div>
<div id="S8.p2" class="ltx_para">
<p id="S8.p2.1" class="ltx_p">We will make use of the following technical stratification lemma, whose proof we postpone to Section <a href="#S9" title="9. Proof of the stratification lemma ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>. Given positive numbers <math id="S8.p2.m1" class="ltx_Math" alttext="a,b&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a,b&gt;0</annotation></semantics></math>, we define the symplectic cuboid <math id="S8.p2.m2" class="ltx_Math" alttext="Q(a,b)\coloneqq\square(a,b)\times_{L}Q" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><mrow><mi mathvariant="normal">□</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><msub><mo rspace="0.222em">×</mo><mi>L</mi></msub><mi>Q</mi></mrow></mrow><annotation encoding="application/x-tex">Q(a,b)\coloneqq\square(a,b)\times_{L}Q</annotation></semantics></math>; see Example <a href="#S6.Thmtheorem4" title="Example 6.4. ‣ 6. Tame packings by balls and polydisks ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.4</span></a>.</p>
</div>
<div id="S8.Thmtheorem1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S8.Thmtheorem1.2" class="ltx_text ltx_font_bold">Lemma 8.1</span></span><span id="S8.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S8.Thmtheorem1.p1" class="ltx_para">
<p id="S8.Thmtheorem1.p1.1" class="ltx_p"><span id="S8.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">There exist a compact set <math id="S8.Thmtheorem1.p1.m1" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> of symplectic frusta and a compact set <math id="S8.Thmtheorem1.p1.m2" class="ltx_Math" alttext="\mathcal{Q}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒬</mi><annotation encoding="application/x-tex">\mathcal{Q}</annotation></semantics></math> of symplectic cuboids such that the following is true for every <math id="S8.Thmtheorem1.p1.m3" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math> open neighbourhood <math id="S8.Thmtheorem1.p1.m4" class="ltx_Math" alttext="\mathcal{U}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒰</mi><annotation encoding="application/x-tex">\mathcal{U}</annotation></semantics></math> of <math id="S8.Thmtheorem1.p1.m5" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> inside the space of all perturbed symplectic frusta: Let <math id="S8.Thmtheorem1.p1.m6" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> be a symplectic <math id="S8.Thmtheorem1.p1.m7" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math>-manifold which is diffeomorphic to <math id="S8.Thmtheorem1.p1.m8" class="ltx_Math" alttext="[0,1]\times Y" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><mi>Y</mi></mrow><annotation encoding="application/x-tex">[0,1]\times Y</annotation></semantics></math> for some closed <math id="S8.Thmtheorem1.p1.m9" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>-manifold <math id="S8.Thmtheorem1.p1.m10" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>. Then there exists <math id="S8.Thmtheorem1.p1.m11" class="ltx_Math" alttext="r&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">r&gt;0</annotation></semantics></math> such that, for all <math id="S8.Thmtheorem1.p1.m12" class="ltx_Math" alttext="0\leq\sigma_{0}&lt;\sigma_{1}\leq 1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><msub><mi>σ</mi><mn>0</mn></msub><mo>&lt;</mo><msub><mi>σ</mi><mn>1</mn></msub><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0\leq\sigma_{0}&lt;\sigma_{1}\leq 1</annotation></semantics></math> satisfying <math id="S8.Thmtheorem1.p1.m13" class="ltx_Math" alttext="\sigma_{1}-\sigma_{0}&lt;r" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo>−</mo><msub><mi>σ</mi><mn>0</mn></msub></mrow><mo>&lt;</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">\sigma_{1}-\sigma_{0}&lt;r</annotation></semantics></math>, there exists a stratification of <math id="S8.Thmtheorem1.p1.m14" class="ltx_Math" alttext="[\sigma_{0},\sigma_{1}]\times Y" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mrow><msub><mi>σ</mi><mn>0</mn></msub><mo>,</mo><msub><mi>σ</mi><mn>1</mn></msub></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><mi>Y</mi></mrow><annotation encoding="application/x-tex">[\sigma_{0},\sigma_{1}]\times Y</annotation></semantics></math> such that the closure of any top-dimensional stratum is conformally symplectomorphic to a symplectic cuboid contained in <math id="S8.Thmtheorem1.p1.m15" class="ltx_Math" alttext="\mathcal{Q}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒬</mi><annotation encoding="application/x-tex">\mathcal{Q}</annotation></semantics></math> or to a domain obtained from an element of <math id="S8.Thmtheorem1.p1.m16" class="ltx_Math" alttext="\mathcal{U}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒰</mi><annotation encoding="application/x-tex">\mathcal{U}</annotation></semantics></math> by cutting.</span></p>
</div>
</div>
<div id="S8.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Theorem <a href="#Thmintrothm2" title="Theorem B (Ellipsoid embedding stability). ‣ 1.2. Ellipsoid embedding stability ‣ 1. Introduction ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B</span></a>.</h6>
<div id="S8.p3" class="ltx_para">
<p id="S8.p3.1" class="ltx_p"><span id="S8.p3.1.1" class="ltx_text">Our first step is to show that every symplectic <math id="S8.p3.m1" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math>-manifold diffeomorphic to <math id="S8.p3.m2" class="ltx_Math" alttext="[0,1]\times Y" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><mi>Y</mi></mrow><annotation encoding="application/x-tex">[0,1]\times Y</annotation></semantics></math> for some closed connected <math id="S8.p3.m3" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>-manifold <math id="S8.p3.m4" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> admits a <math id="S8.p3.m5" class="ltx_Math" alttext="\partial" display="inline" intent=":literal"><semantics><mo>∂</mo><annotation encoding="application/x-tex">\partial</annotation></semantics></math>-tame packing. Let <math id="S8.p3.m6" class="ltx_Math" alttext="M=[0,1]\times Y" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>=</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><mi>Y</mi></mrow></mrow><annotation encoding="application/x-tex">M=[0,1]\times Y</annotation></semantics></math> be such a symplectic <math id="S8.p3.m7" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math>-manifold. Let <math id="S8.p3.m8" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> be a compact set of symplectic frusta and <math id="S8.p3.m9" class="ltx_Math" alttext="\mathcal{Q}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒬</mi><annotation encoding="application/x-tex">\mathcal{Q}</annotation></semantics></math> be a compact set of symplectic cuboids as in Lemma <a href="#S8.Thmtheorem1" title="Lemma 8.1. ‣ 8. Proof of ellipsoid embedding stability ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8.1</span></a>. It follows from Theorem <a href="#S7.Thmtheorem3" title="Theorem 7.3. ‣ 7. Symplectic frusta ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.3</span></a> that there exists an open neighbourhood <math id="S8.p3.m10" class="ltx_Math" alttext="\mathcal{U}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒰</mi><annotation encoding="application/x-tex">\mathcal{U}</annotation></semantics></math> of <math id="S8.p3.m11" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> inside the space of perturbed symplectic frusta such that every domain obtained from an element of <math id="S8.p3.m12" class="ltx_Math" alttext="\mathcal{U}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒰</mi><annotation encoding="application/x-tex">\mathcal{U}</annotation></semantics></math> by cutting admits a <math id="S8.p3.m13" class="ltx_Math" alttext="\partial" display="inline" intent=":literal"><semantics><mo>∂</mo><annotation encoding="application/x-tex">\partial</annotation></semantics></math>-tame packing. This clearly implies that every domain conformally symplectomorphic to a domain obtained from an element of <math id="S8.p3.m14" class="ltx_Math" alttext="\mathcal{U}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒰</mi><annotation encoding="application/x-tex">\mathcal{U}</annotation></semantics></math> by cutting also admits a <math id="S8.p3.m15" class="ltx_Math" alttext="\partial" display="inline" intent=":literal"><semantics><mo>∂</mo><annotation encoding="application/x-tex">\partial</annotation></semantics></math>-tame packing. Moreover, recall from Example <a href="#S6.Thmtheorem4" title="Example 6.4. ‣ 6. Tame packings by balls and polydisks ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.4</span></a> that every symplectic cuboid admits a <math id="S8.p3.m16" class="ltx_Math" alttext="\partial" display="inline" intent=":literal"><semantics><mo>∂</mo><annotation encoding="application/x-tex">\partial</annotation></semantics></math>-tame packing.</span></p>
</div>
<div id="S8.p4" class="ltx_para">
<p id="S8.p4.1" class="ltx_p"><span id="S8.p4.1.1" class="ltx_text">Pick <math id="S8.p4.m1" class="ltx_Math" alttext="r&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">r&gt;0</annotation></semantics></math> satisfying the assertion of Lemma <a href="#S8.Thmtheorem1" title="Lemma 8.1. ‣ 8. Proof of ellipsoid embedding stability ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8.1</span></a>. Let <math id="S8.p4.m2" class="ltx_Math" alttext="k&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">k&gt;0</annotation></semantics></math> be a positive integer such that <math id="S8.p4.m3" class="ltx_Math" alttext="k^{-1}&lt;r" display="inline" intent=":literal"><semantics><mrow><msup><mi>k</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>&lt;</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">k^{-1}&lt;r</annotation></semantics></math>. Divide <math id="S8.p4.m4" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> into <math id="S8.p4.m5" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> slices <math id="S8.p4.m6" class="ltx_Math" alttext="M_{i}\coloneqq[(i-1)/k,i/k]\times Y" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>i</mi></msub><mo>≔</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mi>k</mi></mrow><mo>,</mo><mrow><mi>i</mi><mo>/</mo><mi>k</mi></mrow></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><mi>Y</mi></mrow></mrow><annotation encoding="application/x-tex">M_{i}\coloneqq[(i-1)/k,i/k]\times Y</annotation></semantics></math> for <math id="S8.p4.m7" class="ltx_Math" alttext="1\leq i\leq k" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">1\leq i\leq k</annotation></semantics></math>. Let us stratify each slice <math id="S8.p4.m8" class="ltx_Math" alttext="M_{i}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>i</mi></msub><annotation encoding="application/x-tex">M_{i}</annotation></semantics></math> into symplectic cuboids and perturbed symplectic frusta with cuts as in Lemma <a href="#S8.Thmtheorem1" title="Lemma 8.1. ‣ 8. Proof of ellipsoid embedding stability ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8.1</span></a>. It follows from Lemma <a href="#S6.Thmtheorem2" title="Lemma 6.2. ‣ 6. Tame packings by balls and polydisks ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.2</span></a> that each <math id="S8.p4.m9" class="ltx_Math" alttext="M_{i}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>i</mi></msub><annotation encoding="application/x-tex">M_{i}</annotation></semantics></math> admits a <math id="S8.p4.m10" class="ltx_Math" alttext="\partial" display="inline" intent=":literal"><semantics><mo>∂</mo><annotation encoding="application/x-tex">\partial</annotation></semantics></math>-tame packing. Applying Lemma <a href="#S6.Thmtheorem2" title="Lemma 6.2. ‣ 6. Tame packings by balls and polydisks ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.2</span></a> again, we see that the same is true for <math id="S8.p4.m11" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>.</span></p>
</div>
<div id="S8.p5" class="ltx_para">
<p id="S8.p5.1" class="ltx_p"><span id="S8.p5.1.1" class="ltx_text">Let us now assume that <math id="S8.p5.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> is a general compact connected symplectic <math id="S8.p5.m2" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math>-manifold with smooth boundary. Our goal is to show that <math id="S8.p5.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> admits a tame packing. Once we know this, it follows from Corollary <a href="#S6.Thmtheorem1" title="Corollary 6.1. ‣ 6. Tame packings by balls and polydisks ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.1</span></a> that ellipsoid embedding stability holds for <math id="S8.p5.m4" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>. Choose a Morse function <math id="S8.p5.m5" class="ltx_Math" alttext="f:M\rightarrow\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f:M\rightarrow\mathbb{R}</annotation></semantics></math> which is constant on each boundary component of <math id="S8.p5.m6" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>. We may arrange <math id="S8.p5.m7" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> such that each critical level contains exactly one critical point. We divide <math id="S8.p5.m8" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> into finitely many strata along regular level sets of <math id="S8.p5.m9" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> such that each of the resulting strata contains at most one critical point. By Lemma <a href="#S6.Thmtheorem2" title="Lemma 6.2. ‣ 6. Tame packings by balls and polydisks ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.2</span></a>, it suffices to construct a <math id="S8.p5.m10" class="ltx_Math" alttext="\partial" display="inline" intent=":literal"><semantics><mo>∂</mo><annotation encoding="application/x-tex">\partial</annotation></semantics></math>-tame packing for each of the strata. Since strata without critical points are of product form and admit a <math id="S8.p5.m11" class="ltx_Math" alttext="\partial" display="inline" intent=":literal"><semantics><mo>∂</mo><annotation encoding="application/x-tex">\partial</annotation></semantics></math>-tame packing as proved above, we may reduce ourselves to the case that <math id="S8.p5.m12" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> has exactly one critical point <math id="S8.p5.m13" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>. After replacing <math id="S8.p5.m14" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> by <math id="S8.p5.m15" class="ltx_Math" alttext="-f" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi>f</mi></mrow><annotation encoding="application/x-tex">-f</annotation></semantics></math> if necessary, we can further assume that <math id="S8.p5.m16" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> has Morse index <math id="S8.p5.m17" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>, <math id="S8.p5.m18" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> or <math id="S8.p5.m19" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>. In addition, we may assume that <math id="S8.p5.m20" class="ltx_Math" alttext="f(p)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">f(p)=0</annotation></semantics></math>.</span></p>
</div>
<div id="S8.p6" class="ltx_para">
<p id="S8.p6.1" class="ltx_p"><span id="S8.p6.1.1" class="ltx_text">Consider the case of Morse index <math id="S8.p6.m1" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>. We modify <math id="S8.p6.m2" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> such that it is given by <math id="S8.p6.m3" class="ltx_Math" alttext="f(z)=|z|^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mrow><mo stretchy="false">|</mo><mi>z</mi><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">f(z)=|z|^{2}</annotation></semantics></math> in local Darboux coordinates <math id="S8.p6.m4" class="ltx_Math" alttext="(z_{1},z_{2})=(x_{1},y_{1},x_{2},y_{2})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mn>1</mn></msub><mo>,</mo><msub><mi>z</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>y</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo>,</mo><msub><mi>y</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(z_{1},z_{2})=(x_{1},y_{1},x_{2},y_{2})</annotation></semantics></math> near <math id="S8.p6.m5" class="ltx_Math" alttext="p=0" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">p=0</annotation></semantics></math>. For <math id="S8.p6.m6" class="ltx_Math" alttext="\delta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta&gt;0</annotation></semantics></math> sufficiently small, we divide <math id="S8.p6.m7" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> into two strata along the level set <math id="S8.p6.m8" class="ltx_Math" alttext="f^{-1}(\delta)" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f^{-1}(\delta)</annotation></semantics></math>. One of the strata is a ball and the other one is of product form. Both strata admit a <math id="S8.p6.m9" class="ltx_Math" alttext="\partial" display="inline" intent=":literal"><semantics><mo>∂</mo><annotation encoding="application/x-tex">\partial</annotation></semantics></math>-tame packing. For the balls this is obvious and for the stratum of product form this was proved above. Hence Lemma <a href="#S6.Thmtheorem2" title="Lemma 6.2. ‣ 6. Tame packings by balls and polydisks ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.2</span></a> implies that <math id="S8.p6.m10" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> admits a <math id="S8.p6.m11" class="ltx_Math" alttext="\partial" display="inline" intent=":literal"><semantics><mo>∂</mo><annotation encoding="application/x-tex">\partial</annotation></semantics></math>-tame packing as well.</span></p>
</div>
<div id="S8.p7" class="ltx_para">
<p id="S8.p7.1" class="ltx_p"><span id="S8.p7.1.1" class="ltx_text">Next, consider the case of Morse index <math id="S8.p7.m1" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>. We modify <math id="S8.p7.m2" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> such that it is given by <math id="S8.p7.m3" class="ltx_Math" alttext="f(z)=|z_{1}|^{2}-|z_{2}|^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">|</mo><msub><mi>z</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo>−</mo><msup><mrow><mo stretchy="false">|</mo><msub><mi>z</mi><mn>2</mn></msub><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">f(z)=|z_{1}|^{2}-|z_{2}|^{2}</annotation></semantics></math> in local Darboux coordinates near <math id="S8.p7.m4" class="ltx_Math" alttext="p=0" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">p=0</annotation></semantics></math>. By Lemma <a href="#S6.Thmtheorem2" title="Lemma 6.2. ‣ 6. Tame packings by balls and polydisks ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.2</span></a>, it suffices to show that both <math id="S8.p7.m5" class="ltx_math_unparsed" alttext="f^{-1}((-\infty,0])" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi mathvariant="normal">∞</mi><mo>,</mo><mn>0</mn><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f^{-1}((-\infty,0])</annotation></semantics></math> and <math id="S8.p7.m6" class="ltx_Math" alttext="f^{-1}([0,\infty))" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f^{-1}([0,\infty))</annotation></semantics></math> admit <math id="S8.p7.m7" class="ltx_Math" alttext="\partial" display="inline" intent=":literal"><semantics><mo>∂</mo><annotation encoding="application/x-tex">\partial</annotation></semantics></math>-tame packings. Up to replacing <math id="S8.p7.m8" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> by <math id="S8.p7.m9" class="ltx_Math" alttext="-f" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi>f</mi></mrow><annotation encoding="application/x-tex">-f</annotation></semantics></math>, it suffices to consider the sublevel set <math id="S8.p7.m10" class="ltx_math_unparsed" alttext="X\coloneqq f^{-1}((-\infty,0])" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>≔</mo><msup><mi>f</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi mathvariant="normal">∞</mi><mo>,</mo><mn>0</mn><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">X\coloneqq f^{-1}((-\infty,0])</annotation></semantics></math>. Consider the standard moment map</span></p>
<table id="S8.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S8.Ex1.m1" class="ltx_Math" alttext="\mu:\mathbb{C}^{2}\rightarrow(\mathbb{R}_{\geq 0})^{2}\qquad(z_{1},z_{2})\mapsto(\pi|z_{1}|^{2},\pi|z_{2}|^{2})" display="block" intent=":literal"><semantics><mrow><mrow><mi>μ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℂ</mi><mn>2</mn></msup><mo stretchy="false">→</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mn>1</mn></msub><mo>,</mo><msub><mi>z</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">↦</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><msub><mi>z</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow><mo>,</mo><mrow><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><msub><mi>z</mi><mn>2</mn></msub><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu:\mathbb{C}^{2}\rightarrow(\mathbb{R}_{\geq 0})^{2}\qquad(z_{1},z_{2})\mapsto(\pi|z_{1}|^{2},\pi|z_{2}|^{2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S8.p7.2" class="ltx_p"><span id="S8.p7.2.1" class="ltx_text">and the moment regions <math id="S8.p7.m11" class="ltx_Math" alttext="\Omega,\Omega^{\prime}\subset\mathbb{R}_{\geq 0}^{2}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>,</mo><mrow><msup><mi mathvariant="normal">Ω</mi><mo>′</mo></msup><mo>⊂</mo><msubsup><mi>ℝ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\Omega,\Omega^{\prime}\subset\mathbb{R}_{\geq 0}^{2}</annotation></semantics></math> defined by</span></p>
<table id="S8.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S8.Ex2.m1" class="ltx_math_unparsed" alttext="\Omega\coloneqq\left\{\mu_{2}\geq\mu_{1}\right\}\quad\text{and}\quad\Omega^{\prime}\coloneqq\left\{\mu_{2}\geq\mu_{1}+1\right\}." display="block" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>≔</mo><mrow><mo>{</mo><msub><mi>μ</mi><mn>2</mn></msub><mo>≥</mo><msub><mi>μ</mi><mn>1</mn></msub><mo>}</mo></mrow><mtext>and</mtext><msup><mi mathvariant="normal">Ω</mi><mo>′</mo></msup><mo>≔</mo><mrow><mo>{</mo><msub><mi>μ</mi><mn>2</mn></msub><mo>≥</mo><msub><mi>μ</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn><mo>}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Omega\coloneqq\left\{\mu_{2}\geq\mu_{1}\right\}\quad\text{and}\quad\Omega^{\prime}\coloneqq\left\{\mu_{2}\geq\mu_{1}+1\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S8.p7.3" class="ltx_p"><span id="S8.p7.3.1" class="ltx_text">Note that the toric domain <math id="S8.p7.m12" class="ltx_Math" alttext="\mu^{-1}(\Omega)" display="inline" intent=":literal"><semantics><mrow><msup><mi>μ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ω</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu^{-1}(\Omega)</annotation></semantics></math> is smooth away from the singular point <math id="S8.p7.m13" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> and that a neighbourhood of <math id="S8.p7.m14" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> in <math id="S8.p7.m15" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is symplectomorphic to a neighbourhood of <math id="S8.p7.m16" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> in <math id="S8.p7.m17" class="ltx_Math" alttext="\mu^{-1}(\Omega)" display="inline" intent=":literal"><semantics><mrow><msup><mi>μ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ω</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu^{-1}(\Omega)</annotation></semantics></math>. The toric domain <math id="S8.p7.m18" class="ltx_Math" alttext="\mu^{-1}(\Omega^{\prime})" display="inline" intent=":literal"><semantics><mrow><msup><mi>μ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ω</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu^{-1}(\Omega^{\prime})</annotation></semantics></math> is smooth everywhere. The moment region <math id="S8.p7.m19" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math> is obtained from <math id="S8.p7.m20" class="ltx_Math" alttext="\Omega^{\prime}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Ω</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\Omega^{\prime}</annotation></semantics></math> by translation along the vector <math id="S8.p7.m21" class="ltx_Math" alttext="(0,-1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,-1)</annotation></semantics></math>. This translation lifts to a map</span></p>
<table id="S8.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S8.Ex3.m1" class="ltx_Math" alttext="T:\mu^{-1}(\Omega^{\prime})\rightarrow\mu^{-1}(\Omega)\qquad(\sqrt{\frac{\mu_{1}}{\pi}}e^{2\pi i\theta_{1}},\sqrt{\frac{\mu_{2}}{\pi}}e^{2\pi i\theta_{2}})\mapsto(\sqrt{\frac{\mu_{1}}{\pi}}e^{2\pi i\theta_{1}},\sqrt{\frac{\mu_{2}-1}{\pi}}e^{2\pi i\theta_{2}})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>T</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>μ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Ω</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>μ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ω</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mrow><mo stretchy="false">(</mo><mrow><msqrt><mfrac><msub><mi>μ</mi><mn>1</mn></msub><mi>π</mi></mfrac></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>1</mn></msub></mrow></msup></mrow><mo>,</mo><mrow><msqrt><mfrac><msub><mi>μ</mi><mn>2</mn></msub><mi>π</mi></mfrac></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>2</mn></msub></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">↦</mo><mrow><mo stretchy="false">(</mo><mrow><msqrt><mfrac><msub><mi>μ</mi><mn>1</mn></msub><mi>π</mi></mfrac></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>1</mn></msub></mrow></msup></mrow><mo>,</mo><mrow><msqrt><mfrac><mrow><msub><mi>μ</mi><mn>2</mn></msub><mo>−</mo><mn>1</mn></mrow><mi>π</mi></mfrac></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mn>2</mn></msub></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">T:\mu^{-1}(\Omega^{\prime})\rightarrow\mu^{-1}(\Omega)\qquad(\sqrt{\frac{\mu_{1}}{\pi}}e^{2\pi i\theta_{1}},\sqrt{\frac{\mu_{2}}{\pi}}e^{2\pi i\theta_{2}})\mapsto(\sqrt{\frac{\mu_{1}}{\pi}}e^{2\pi i\theta_{1}},\sqrt{\frac{\mu_{2}-1}{\pi}}e^{2\pi i\theta_{2}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S8.p7.4" class="ltx_p"><span id="S8.p7.4.1" class="ltx_text">which restricts to a symplectomorphism <math id="S8.p7.m22" class="ltx_Math" alttext="T:\mu^{-1}(\Omega^{\prime}\setminus\left\{(0,1)\right\})\rightarrow\mu^{-1}(\Omega\setminus\left\{(0,0)\right\})" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>μ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi mathvariant="normal">Ω</mi><mo>′</mo></msup><mo>∖</mo><mrow><mo>{</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>μ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Ω</mi><mo>∖</mo><mrow><mo>{</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">T:\mu^{-1}(\Omega^{\prime}\setminus\left\{(0,1)\right\})\rightarrow\mu^{-1}(\Omega\setminus\left\{(0,0)\right\})</annotation></semantics></math>. We construct a smooth symplectic manifold <math id="S8.p7.m23" class="ltx_Math" alttext="X^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>X</mi><mo>′</mo></msup><annotation encoding="application/x-tex">X^{\prime}</annotation></semantics></math> out of <math id="S8.p7.m24" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> by replacing a neighbourhood of <math id="S8.p7.m25" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>, which we symplectically identify with a neighbourhood <math id="S8.p7.m26" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> of <math id="S8.p7.m27" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> in <math id="S8.p7.m28" class="ltx_Math" alttext="\mu^{-1}(\Omega)" display="inline" intent=":literal"><semantics><mrow><msup><mi>μ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ω</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu^{-1}(\Omega)</annotation></semantics></math>, with <math id="S8.p7.m29" class="ltx_Math" alttext="T^{-1}(U)" display="inline" intent=":literal"><semantics><mrow><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T^{-1}(U)</annotation></semantics></math>. Note that <math id="S8.p7.m30" class="ltx_Math" alttext="X^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>X</mi><mo>′</mo></msup><annotation encoding="application/x-tex">X^{\prime}</annotation></semantics></math> is of product form and therefore admits a <math id="S8.p7.m31" class="ltx_Math" alttext="\partial" display="inline" intent=":literal"><semantics><mo>∂</mo><annotation encoding="application/x-tex">\partial</annotation></semantics></math>-tame packing. This implies that the same is true for <math id="S8.p7.m32" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. Indeed, any collection of symplectic disks <math id="S8.p7.m33" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math> in the smooth locus of the boundary of <math id="S8.p7.m34" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> lifts to a collection of smooth disks <math id="S8.p7.m35" class="ltx_Math" alttext="\mathcal{D}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathcal{D}^{\prime}</annotation></semantics></math> in the boundary of <math id="S8.p7.m36" class="ltx_Math" alttext="X^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>X</mi><mo>′</mo></msup><annotation encoding="application/x-tex">X^{\prime}</annotation></semantics></math>. Moreover, the map <math id="S8.p7.m37" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> sends any symplectic ribbon complex in <math id="S8.p7.m38" class="ltx_Math" alttext="X^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>X</mi><mo>′</mo></msup><annotation encoding="application/x-tex">X^{\prime}</annotation></semantics></math> with free ends at the disks <math id="S8.p7.m39" class="ltx_Math" alttext="\mathcal{D}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathcal{D}^{\prime}</annotation></semantics></math> to a symplectic ribbon complex in <math id="S8.p7.m40" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> with free ends at <math id="S8.p7.m41" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math>.</span></p>
</div>
<div id="S8.p8" class="ltx_para">
<p id="S8.p8.1" class="ltx_p"><span id="S8.p8.1.1" class="ltx_text">Finally, let us consider the case that <math id="S8.p8.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> has index <math id="S8.p8.m2" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>. In this case, we modify <math id="S8.p8.m3" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> such that there exist <math id="S8.p8.m4" class="ltx_Math" alttext="\delta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta&gt;0</annotation></semantics></math>, <math id="S8.p8.m5" class="ltx_Math" alttext="a&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a&gt;0</annotation></semantics></math>, and <math id="S8.p8.m6" class="ltx_Math" alttext="0&lt;b&lt;\sqrt{a/\pi}" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mi>b</mi><mo>&lt;</mo><msqrt><mrow><mi>a</mi><mo>/</mo><mi>π</mi></mrow></msqrt></mrow><annotation encoding="application/x-tex">0&lt;b&lt;\sqrt{a/\pi}</annotation></semantics></math> such that the ball <math id="S8.p8.m7" class="ltx_Math" alttext="B^{4}(a)" display="inline" intent=":literal"><semantics><mrow><msup><mi>B</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B^{4}(a)</annotation></semantics></math> is contained in a Darboux neighbourhood of <math id="S8.p8.m8" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>, the function <math id="S8.p8.m9" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> takes the value <math id="S8.p8.m10" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> on the set <math id="S8.p8.m11" class="ltx_math_unparsed" alttext="\partial B^{4}(a)\cap\left\{|x_{1}|\leq b\right\}" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><msup><mi>B</mi><mn>4</mn></msup><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo>∩</mo><mrow><mo>{</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>x</mi><mn>1</mn></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">≤</mo><mi>b</mi><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\partial B^{4}(a)\cap\left\{|x_{1}|\leq b\right\}</annotation></semantics></math>, and <math id="S8.p8.m12" class="ltx_math_unparsed" alttext="B^{4}(a)\cap\left\{|x_{1}|\leq b\right\}" display="inline" intent=":literal"><semantics><mrow><msup><mi>B</mi><mn>4</mn></msup><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo>∩</mo><mrow><mo>{</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>x</mi><mn>1</mn></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">≤</mo><mi>b</mi><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">B^{4}(a)\cap\left\{|x_{1}|\leq b\right\}</annotation></semantics></math> is contained in the sublevel set <math id="S8.p8.m13" class="ltx_math_unparsed" alttext="f^{-1}((-\infty,\delta])" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi mathvariant="normal">∞</mi><mo>,</mo><mi>δ</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f^{-1}((-\infty,\delta])</annotation></semantics></math>. Let us divide <math id="S8.p8.m14" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> into two strata <math id="S8.p8.m15" class="ltx_math_unparsed" alttext="f^{-1}((-\infty,\delta])" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi mathvariant="normal">∞</mi><mo>,</mo><mi>δ</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f^{-1}((-\infty,\delta])</annotation></semantics></math> and <math id="S8.p8.m16" class="ltx_Math" alttext="f^{-1}([\delta,\infty))" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mi>δ</mi><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f^{-1}([\delta,\infty))</annotation></semantics></math>. Since the latter stratum is of product form, we may replace <math id="S8.p8.m17" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> by <math id="S8.p8.m18" class="ltx_Math" alttext="f^{-1}((\infty,\delta])" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">∞</mi><mo>,</mo><mi>δ</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f^{-1}((\infty,\delta])</annotation></semantics></math>. We cut <math id="S8.p8.m19" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> along the <math id="S8.p8.m20" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>-dimensional ball <math id="S8.p8.m21" class="ltx_math_unparsed" alttext="B^{4}(a)\cap\left\{x_{1}=0\right\}" display="inline" intent=":literal"><semantics><mrow><msup><mi>B</mi><mn>4</mn></msup><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo>∩</mo><mrow><mo>{</mo><msub><mi>x</mi><mn>1</mn></msub><mo>=</mo><mn>0</mn><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">B^{4}(a)\cap\left\{x_{1}=0\right\}</annotation></semantics></math>. The result is a symplectic manifold <math id="S8.p8.m22" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> with boundary and corners with either one or two connected components. Near the non-smooth regions of the boundary, <math id="S8.p8.m23" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> looks like a half ball <math id="S8.p8.m24" class="ltx_math_unparsed" alttext="B^{4}_{+}(a)\coloneqq B^{4}(a)\cap\left\{x_{1}\geq 0\right\}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>B</mi><mo>+</mo><mn>4</mn></msubsup><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo>≔</mo><msup><mi>B</mi><mn>4</mn></msup><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo>∩</mo><mrow><mo>{</mo><msub><mi>x</mi><mn>1</mn></msub><mo>≥</mo><mn>0</mn><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">B^{4}_{+}(a)\coloneqq B^{4}(a)\cap\left\{x_{1}\geq 0\right\}</annotation></semantics></math>. Note that after smoothing the corners, <math id="S8.p8.m25" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is diffeomorphic to a manifold of product form.</span></p>
</div>
<div id="S8.p9" class="ltx_para">
<p id="S8.p9.1" class="ltx_p"><span id="S8.p9.1.1" class="ltx_text">Our goal is to show that each component of <math id="S8.p9.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> admits a <math id="S8.p9.m2" class="ltx_Math" alttext="\partial" display="inline" intent=":literal"><semantics><mo>∂</mo><annotation encoding="application/x-tex">\partial</annotation></semantics></math>-tame packing. For simplicity, let us assume that <math id="S8.p9.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is connected in the following. As in the case of an index <math id="S8.p9.m4" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> critical point, our strategy is to construct a symplectic <math id="S8.p9.m5" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math>-manifold <math id="S8.p9.m6" class="ltx_Math" alttext="X^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>X</mi><mo>′</mo></msup><annotation encoding="application/x-tex">X^{\prime}</annotation></semantics></math> with smooth boundary such that the existence of a <math id="S8.p9.m7" class="ltx_Math" alttext="\partial" display="inline" intent=":literal"><semantics><mo>∂</mo><annotation encoding="application/x-tex">\partial</annotation></semantics></math>-tame packing for <math id="S8.p9.m8" class="ltx_Math" alttext="X^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>X</mi><mo>′</mo></msup><annotation encoding="application/x-tex">X^{\prime}</annotation></semantics></math> implies the existence of such a packing for <math id="S8.p9.m9" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. The symplectic manifold <math id="S8.p9.m10" class="ltx_Math" alttext="X^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>X</mi><mo>′</mo></msup><annotation encoding="application/x-tex">X^{\prime}</annotation></semantics></math> is obtained by carefully smoothing the corners of <math id="S8.p9.m11" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>.</span></p>
</div>
<div id="S8.p10" class="ltx_para">
<p id="S8.p10.1" class="ltx_p"><span id="S8.p10.1.1" class="ltx_text">Let us first explain the corner smoothing in the case of the half ball <math id="S8.p10.m1" class="ltx_Math" alttext="X=B^{4}_{+}(a)" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>=</mo><mrow><msubsup><mi>B</mi><mo>+</mo><mn>4</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X=B^{4}_{+}(a)</annotation></semantics></math>. In this case, <math id="S8.p10.m2" class="ltx_Math" alttext="X^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>X</mi><mo>′</mo></msup><annotation encoding="application/x-tex">X^{\prime}</annotation></semantics></math> is given by the ellipsoid <math id="S8.p10.m3" class="ltx_Math" alttext="E(a/2,a)" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>/</mo><mn>2</mn></mrow><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">E(a/2,a)</annotation></semantics></math>, which has the same volume. We need to explain how to obtain a <math id="S8.p10.m4" class="ltx_Math" alttext="\partial" display="inline" intent=":literal"><semantics><mo>∂</mo><annotation encoding="application/x-tex">\partial</annotation></semantics></math>-tame packing of <math id="S8.p10.m5" class="ltx_Math" alttext="B^{4}_{+}(a)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>B</mi><mo>+</mo><mn>4</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B^{4}_{+}(a)</annotation></semantics></math> from a <math id="S8.p10.m6" class="ltx_Math" alttext="\partial" display="inline" intent=":literal"><semantics><mo>∂</mo><annotation encoding="application/x-tex">\partial</annotation></semantics></math>-tame packing of <math id="S8.p10.m7" class="ltx_Math" alttext="E(a/2,a)" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>/</mo><mn>2</mn></mrow><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">E(a/2,a)</annotation></semantics></math>. For every <math id="S8.p10.m8" class="ltx_Math" alttext="r\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r\in(0,1)</annotation></semantics></math>, we construct a controlled symplectic embedding of the ellipsoid <math id="S8.p10.m9" class="ltx_Math" alttext="E(ra/2,ra)" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>/</mo><mn>2</mn></mrow><mo>,</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">E(ra/2,ra)</annotation></semantics></math> into the half ball <math id="S8.p10.m10" class="ltx_Math" alttext="B^{4}_{+}(a)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>B</mi><mo>+</mo><mn>4</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B^{4}_{+}(a)</annotation></semantics></math>. Let us regard the ellipsoid <math id="S8.p10.m11" class="ltx_Math" alttext="E(a/2,a)" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>/</mo><mn>2</mn></mrow><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">E(a/2,a)</annotation></semantics></math> as a family of disks of varying sizes over <math id="S8.p10.m12" class="ltx_Math" alttext="B^{2}(a/2)" display="inline" intent=":literal"><semantics><mrow><msup><mi>B</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B^{2}(a/2)</annotation></semantics></math>. The area of the disk over <math id="S8.p10.m13" class="ltx_Math" alttext="z\in B^{2}(a/2)" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>∈</mo><mrow><msup><mi>B</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z\in B^{2}(a/2)</annotation></semantics></math> is given by <math id="S8.p10.m14" class="ltx_Math" alttext="f_{1}(z)\coloneqq 2(a/2-\pi|z|^{2})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>a</mi><mo>/</mo><mn>2</mn></mrow><mo>−</mo><mrow><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><mi>z</mi><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{1}(z)\coloneqq 2(a/2-\pi|z|^{2})</annotation></semantics></math>. Similarly, we regard the half ball <math id="S8.p10.m15" class="ltx_Math" alttext="B^{4}_{+}(a)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>B</mi><mo>+</mo><mn>4</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B^{4}_{+}(a)</annotation></semantics></math> as a family of disks over the half disk <math id="S8.p10.m16" class="ltx_math_unparsed" alttext="B^{2}_{+}(a)\coloneqq B^{2}(a)\cap\left\{x_{1}\geq 0\right\}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>B</mi><mo>+</mo><mn>2</mn></msubsup><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo>≔</mo><msup><mi>B</mi><mn>2</mn></msup><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo>∩</mo><mrow><mo>{</mo><msub><mi>x</mi><mn>1</mn></msub><mo>≥</mo><mn>0</mn><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">B^{2}_{+}(a)\coloneqq B^{2}(a)\cap\left\{x_{1}\geq 0\right\}</annotation></semantics></math>. The area of the disk over <math id="S8.p10.m17" class="ltx_Math" alttext="z\in B^{2}_{+}(a)" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>∈</mo><mrow><msubsup><mi>B</mi><mo>+</mo><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z\in B^{2}_{+}(a)</annotation></semantics></math> is <math id="S8.p10.m18" class="ltx_Math" alttext="f_{2}(z)\coloneqq a-\pi|z|^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><mi>a</mi><mo>−</mo><mrow><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><mi>z</mi><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{2}(z)\coloneqq a-\pi|z|^{2}</annotation></semantics></math>. Observe that, for every <math id="S8.p10.m19" class="ltx_Math" alttext="r\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">r\geq 0</annotation></semantics></math>, we have</span></p>
<table id="S8.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(8.1)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S8.E1.m1" class="ltx_Math" alttext="\operatorname{area}\left(\left\{z\in B^{2}(a/2)\mid f_{1}(z)\geq r\right\}\right)=\operatorname{area}\left(\left\{z\in B^{2}_{+}(a)\mid f_{2}(z)\geq r\right\}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>area</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>{</mo><mrow><mi>z</mi><mo>∈</mo><mrow><msup><mi>B</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mi>r</mi></mrow><mo>}</mo></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>area</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>{</mo><mrow><mi>z</mi><mo>∈</mo><mrow><msubsup><mi>B</mi><mo>+</mo><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>f</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mi>r</mi></mrow><mo>}</mo></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\operatorname{area}\left(\left\{z\in B^{2}(a/2)\mid f_{1}(z)\geq r\right\}\right)=\operatorname{area}\left(\left\{z\in B^{2}_{+}(a)\mid f_{2}(z)\geq r\right\}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S8.p10.2" class="ltx_p"><span id="S8.p10.2.1" class="ltx_text">We apply the embedding construction of Schlenk <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx80" title="" class="ltx_ref">Sch03</a>, §2]</cite>, <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx81" title="" class="ltx_ref">Sch05a</a>, §4.1]</cite> that we have already used several times. To this end, consider the family of admissible loops <math id="S8.p10.m20" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math> in the half disk <math id="S8.p10.m21" class="ltx_Math" alttext="\operatorname{int}(B^{2}_{+}(a))" display="inline" intent=":literal"><semantics><mrow><mi>int</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>B</mi><mo>+</mo><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{int}(B^{2}_{+}(a))</annotation></semantics></math> depicted in Figure <a href="#S8.F1" title="Figure 8.1 ‣ Proof of Theorem . ‣ 8. Proof of ellipsoid embedding stability ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8.1</span></a>.</span></p>
</div>
<figure id="S8.F1" class="ltx_figure"><span id="S8.F1.pic1" class="ltx_picture ltx_centering" style="width:1.0pt;height:1.83333333pt;"><svg xmlns="http://www.w3.org/2000/svg" version="1.1" width="1.33" height="2.44" overflow="visible"><g transform="translate(0,2.44) scale(1,-1)"><g transform="translate(0,0)"><g transform="translate(0,168.04) scale(1,-1)"><foreignObject width="91.66" height="168.04" overflow="visible"><object type="image/svg+xml" data="2509.15390v1/x35.svg" id="S8.F1.pic1.g1" class="ltx_graphics ltx_img_portrait" width="96" height="175" aria-label="Refer to caption"></object></foreignObject></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 8.1. </span>A special admissible family of loops <math id="S8.F1.m3" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math> in the half disk <math id="S8.F1.m4" class="ltx_Math" alttext="B^{2}_{+}(a)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>B</mi><mo>+</mo><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B^{2}_{+}(a)</annotation></semantics></math>.</figcaption>
</figure>
<div id="S8.p11" class="ltx_para">
<p id="S8.p11.1" class="ltx_p"><span id="S8.p11.1.1" class="ltx_text">Then by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx80" title="" class="ltx_ref">Sch03</a>, Lemma 2.5]</cite>, there exists a symplectomorphism <math id="S8.p11.m1" class="ltx_Math" alttext="\varphi:\operatorname{int}(B^{2}(a/2))\rightarrow\operatorname{int}(B^{2}_{+}(a))" display="inline" intent=":literal"><semantics><mrow><mi>φ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>int</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>B</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>int</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>B</mi><mo>+</mo><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\varphi:\operatorname{int}(B^{2}(a/2))\rightarrow\operatorname{int}(B^{2}_{+}(a))</annotation></semantics></math> which maps circles in <math id="S8.p11.m2" class="ltx_Math" alttext="\operatorname{int}(B^{2}(a/2))" display="inline" intent=":literal"><semantics><mrow><mi>int</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>B</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{int}(B^{2}(a/2))</annotation></semantics></math> centered at the origin to members of the family of loops <math id="S8.p11.m3" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math>. We can arrange the family of loops <math id="S8.p11.m4" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math> such that the image of <math id="S8.p11.m5" class="ltx_Math" alttext="E(ra/2,ra)" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>/</mo><mn>2</mn></mrow><mo>,</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">E(ra/2,ra)</annotation></semantics></math> unter <math id="S8.p11.m6" class="ltx_Math" alttext="\varphi\times\operatorname{id}_{\mathbb{C}}" display="inline" intent=":literal"><semantics><mrow><mi>φ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>id</mi><mi>ℂ</mi></msub></mrow><annotation encoding="application/x-tex">\varphi\times\operatorname{id}_{\mathbb{C}}</annotation></semantics></math> is contained in <math id="S8.p11.m7" class="ltx_Math" alttext="\operatorname{int}(B^{4}_{+}(a))" display="inline" intent=":literal"><semantics><mrow><mi>int</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>B</mi><mo>+</mo><mn>4</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{int}(B^{4}_{+}(a))</annotation></semantics></math>. This makes important use of identity (<a href="#S8.E1" title="In Proof of Theorem . ‣ 8. Proof of ellipsoid embedding stability ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8.1</span></a>). Moreover, if the family of loops <math id="S8.p11.m8" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math> is chosen carefully, we can make sure that the top-dimensional boundary strata of <math id="S8.p11.m9" class="ltx_Math" alttext="B^{4}_{+}(a)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>B</mi><mo>+</mo><mn>4</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B^{4}_{+}(a)</annotation></semantics></math> are approximated in <math id="S8.p11.m10" class="ltx_Math" alttext="C^{\infty}_{\operatorname{loc}}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi>loc</mi><mi mathvariant="normal">∞</mi></msubsup><annotation encoding="application/x-tex">C^{\infty}_{\operatorname{loc}}</annotation></semantics></math> by parts of the boundary of the image of <math id="S8.p11.m11" class="ltx_Math" alttext="E(ra/2,ra)" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>/</mo><mn>2</mn></mrow><mo>,</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">E(ra/2,ra)</annotation></semantics></math> as <math id="S8.p11.m12" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> tends to <math id="S8.p11.m13" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>. Symplectic disks in the boundary of <math id="S8.p11.m14" class="ltx_Math" alttext="B^{4}_{+}(a)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>B</mi><mo>+</mo><mn>4</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B^{4}_{+}(a)</annotation></semantics></math> can therefore be connected to symplectic disks in the boundary of the image of <math id="S8.p11.m15" class="ltx_Math" alttext="E(ra/2,ra)" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>/</mo><mn>2</mn></mrow><mo>,</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">E(ra/2,ra)</annotation></semantics></math> via symplectic ribbons, showing that the existence of a <math id="S8.p11.m16" class="ltx_Math" alttext="\partial" display="inline" intent=":literal"><semantics><mo>∂</mo><annotation encoding="application/x-tex">\partial</annotation></semantics></math>-tame packing of <math id="S8.p11.m17" class="ltx_Math" alttext="E(a/2,a)" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>/</mo><mn>2</mn></mrow><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">E(a/2,a)</annotation></semantics></math> implies the existence of a <math id="S8.p11.m18" class="ltx_Math" alttext="\partial" display="inline" intent=":literal"><semantics><mo>∂</mo><annotation encoding="application/x-tex">\partial</annotation></semantics></math>-tame packing of <math id="S8.p11.m19" class="ltx_Math" alttext="B^{4}_{+}(a)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>B</mi><mo>+</mo><mn>4</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B^{4}_{+}(a)</annotation></semantics></math>.</span></p>
</div>
<div id="S8.p12" class="ltx_para">
<p id="S8.p12.1" class="ltx_p"><span id="S8.p12.1.1" class="ltx_text">The adaptation of the corner smoothing from the special case <math id="S8.p12.m1" class="ltx_Math" alttext="B^{4}_{+}(a)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>B</mi><mo>+</mo><mn>4</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B^{4}_{+}(a)</annotation></semantics></math> to the case of general <math id="S8.p12.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is straightforward. The smoothing <math id="S8.p12.m3" class="ltx_Math" alttext="X^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>X</mi><mo>′</mo></msup><annotation encoding="application/x-tex">X^{\prime}</annotation></semantics></math> is obtained by replacing an open neighbourhood <math id="S8.p12.m4" class="ltx_math_unparsed" alttext="B^{4}_{+}(a)\cap\left\{x_{1}&lt;b\right\}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>B</mi><mo>+</mo><mn>4</mn></msubsup><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo>∩</mo><mrow><mo>{</mo><msub><mi>x</mi><mn>1</mn></msub><mo>&lt;</mo><mi>b</mi><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">B^{4}_{+}(a)\cap\left\{x_{1}&lt;b\right\}</annotation></semantics></math> of the non-smooth locus of the boundary of <math id="S8.p12.m5" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> by an appropriate open subset of the ellipsoid <math id="S8.p12.m6" class="ltx_Math" alttext="E(a/2,a)" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>/</mo><mn>2</mn></mrow><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">E(a/2,a)</annotation></semantics></math>. The resulting symplectic manifold <math id="S8.p12.m7" class="ltx_Math" alttext="X^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>X</mi><mo>′</mo></msup><annotation encoding="application/x-tex">X^{\prime}</annotation></semantics></math> has smooth boundary and is of product form. It therefore admits a <math id="S8.p12.m8" class="ltx_Math" alttext="\partial" display="inline" intent=":literal"><semantics><mo>∂</mo><annotation encoding="application/x-tex">\partial</annotation></semantics></math>-tame packing and we can deduce that the same is true for <math id="S8.p12.m9" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="S9" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">9. </span>Proof of the stratification lemma</h2>

<div id="S9.p1" class="ltx_para">
<p id="S9.p1.1" class="ltx_p">The goal of this section is to prove the technical stratification result Lemma <a href="#S8.Thmtheorem1" title="Lemma 8.1. ‣ 8. Proof of ellipsoid embedding stability ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8.1</span></a>.</p>
</div>
<section id="S9.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">9.1. </span>Stratifications compatible with a flow</h3>

<div id="S9.SS1.p1" class="ltx_para">
<p id="S9.SS1.p1.1" class="ltx_p">Let <math id="S9.SS1.p1.m1" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> be a closed <math id="S9.SS1.p1.m2" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>-manifold equipped with a nowhere vanishing vector field <math id="S9.SS1.p1.m3" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>. The main example of interest is that <math id="S9.SS1.p1.m4" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> is the boundary of a symplectic manifold and that <math id="S9.SS1.p1.m5" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> is tangent to the characteristic foliation. Let <math id="S9.SS1.p1.m6" class="ltx_Math" alttext="\varphi^{t}" display="inline" intent=":literal"><semantics><msup><mi>φ</mi><mi>t</mi></msup><annotation encoding="application/x-tex">\varphi^{t}</annotation></semantics></math> denote the flow generated by <math id="S9.SS1.p1.m7" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>. Let <math id="S9.SS1.p1.m8" class="ltx_Math" alttext="\Sigma\subset Y" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Σ</mi><mo>⊂</mo><mi>Y</mi></mrow><annotation encoding="application/x-tex">\Sigma\subset Y</annotation></semantics></math> be a compact embedded surface, possibly with boundary. We say that <math id="S9.SS1.p1.m9" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> is a <span id="S9.SS1.p1.1.1" class="ltx_text ltx_font_italic">transverse surface</span> if it is everywhere transverse to the vector field <math id="S9.SS1.p1.m10" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>. We emphasize that we also assume <math id="S9.SS1.p1.m11" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> to be transverse to <math id="S9.SS1.p1.m12" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> at the boundary <math id="S9.SS1.p1.m13" class="ltx_Math" alttext="\partial\Sigma" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mi mathvariant="normal">Σ</mi></mrow><annotation encoding="application/x-tex">\partial\Sigma</annotation></semantics></math>. In particular, the boundary <math id="S9.SS1.p1.m14" class="ltx_Math" alttext="\partial\Sigma" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mi mathvariant="normal">Σ</mi></mrow><annotation encoding="application/x-tex">\partial\Sigma</annotation></semantics></math> does not consist of periodic orbits, which is a familiar assumption in the context of global surfaces of section. We say that <math id="S9.SS1.p1.m15" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> is <span id="S9.SS1.p1.1.2" class="ltx_text ltx_font_italic">exhaustive</span> if there exists a compact subset <math id="S9.SS1.p1.m16" class="ltx_Math" alttext="K\subset\operatorname{int}\Sigma" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⊂</mo><mrow><mi>int</mi><mo lspace="0.167em">⁡</mo><mi mathvariant="normal">Σ</mi></mrow></mrow><annotation encoding="application/x-tex">K\subset\operatorname{int}\Sigma</annotation></semantics></math> such that every flow line of <math id="S9.SS1.p1.m17" class="ltx_Math" alttext="\varphi^{t}" display="inline" intent=":literal"><semantics><msup><mi>φ</mi><mi>t</mi></msup><annotation encoding="application/x-tex">\varphi^{t}</annotation></semantics></math> meets <math id="S9.SS1.p1.m18" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> infinitely often forward and backward in time. It is not hard to see that an exhaustive transverse surface always exists. For example, one can construct such a surface by taking the disjoint union of sufficiently many small disks transverse to the flow.</p>
</div>
<div id="S9.SS1.p2" class="ltx_para">
<p id="S9.SS1.p2.1" class="ltx_p">Given an exhaustive transverse surface <math id="S9.SS1.p2.m1" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math>, we define</p>
<table id="S9.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S9.Ex1.m1" class="ltx_Math" alttext="T=T_{\Sigma}:Y\rightarrow\mathbb{R}_{&gt;0}\qquad T(p)\coloneqq\inf\{t&gt;0\mid\varphi^{t}(p)\in\Sigma\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>T</mi><mo>=</mo><msub><mi>T</mi><mi mathvariant="normal">Σ</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>Y</mi><mo stretchy="false">→</mo><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>&gt;</mo><mn>0</mn></mrow></msub></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">≔</mo><mrow><mo lspace="0.1389em" movablelimits="false" rspace="0em">inf</mo><mrow><mo stretchy="false">{</mo><mrow><mi>t</mi><mo>&gt;</mo><mn>0</mn></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msup><mi>φ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mi mathvariant="normal">Σ</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">T=T_{\Sigma}:Y\rightarrow\mathbb{R}_{&gt;0}\qquad T(p)\coloneqq\inf\{t&gt;0\mid\varphi^{t}(p)\in\Sigma\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S9.SS1.p2.2" class="ltx_p">Note that <math id="S9.SS1.p2.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> indeed takes values in <math id="S9.SS1.p2.m3" class="ltx_Math" alttext="\mathbb{R}_{&gt;0}" display="inline" intent=":literal"><semantics><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>&gt;</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">\mathbb{R}_{&gt;0}</annotation></semantics></math>. Since the flow line <math id="S9.SS1.p2.m4" class="ltx_Math" alttext="\varphi^{t}(p)" display="inline" intent=":literal"><semantics><mrow><msup><mi>φ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\varphi^{t}(p)</annotation></semantics></math> intersects <math id="S9.SS1.p2.m5" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> forward in time and is transverse to <math id="S9.SS1.p2.m6" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math>, the infimum <math id="S9.SS1.p2.m7" class="ltx_Math" alttext="T(p)" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T(p)</annotation></semantics></math> is finite and non-zero. Let us define</p>
<table id="S9.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S9.Ex2.m1" class="ltx_Math" alttext="\Phi:Y\rightarrow\Sigma\qquad\Phi(p)\coloneqq\varphi^{T(p)}(p)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi mathvariant="normal">Φ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>Y</mi><mo stretchy="false">→</mo><mi mathvariant="normal">Σ</mi></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><msup><mi>φ</mi><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Phi:Y\rightarrow\Sigma\qquad\Phi(p)\coloneqq\varphi^{T(p)}(p).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S9.SS1.p2.3" class="ltx_p">We abbreviate <math id="S9.SS1.p2.m8" class="ltx_Math" alttext="\tau\coloneqq T|_{\Sigma}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>≔</mo><msub><mrow><mi>T</mi><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">Σ</mi></msub></mrow><annotation encoding="application/x-tex">\tau\coloneqq T|_{\Sigma}</annotation></semantics></math> and <math id="S9.SS1.p2.m9" class="ltx_Math" alttext="\varphi\coloneqq\Phi|_{\Sigma}" display="inline" intent=":literal"><semantics><mrow><mi>φ</mi><mo>≔</mo><msub><mrow><mi mathvariant="normal">Φ</mi><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">Σ</mi></msub></mrow><annotation encoding="application/x-tex">\varphi\coloneqq\Phi|_{\Sigma}</annotation></semantics></math>. We observe that <math id="S9.SS1.p2.m10" class="ltx_Math" alttext="\varphi" display="inline" intent=":literal"><semantics><mi>φ</mi><annotation encoding="application/x-tex">\varphi</annotation></semantics></math> is a bijection of <math id="S9.SS1.p2.m11" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math>. In general, it is not continuous.</p>
</div>
<div id="S9.SS1.p3" class="ltx_para">
<p id="S9.SS1.p3.1" class="ltx_p">We say that an exhaustive transverse surface <math id="S9.SS1.p3.m1" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> is <span id="S9.SS1.p3.1.1" class="ltx_text ltx_font_italic">in good position</span> if the following is true for every point <math id="S9.SS1.p3.m2" class="ltx_Math" alttext="p\in\partial\Sigma" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo rspace="0.111em">∈</mo><mrow><mo>∂</mo><mi mathvariant="normal">Σ</mi></mrow></mrow><annotation encoding="application/x-tex">p\in\partial\Sigma</annotation></semantics></math>. For <math id="S9.SS1.p3.m3" class="ltx_Math" alttext="k\in\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">k\in\mathbb{Z}</annotation></semantics></math>, set <math id="S9.SS1.p3.m4" class="ltx_Math" alttext="p_{k}\coloneqq\varphi^{k}(p)" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>k</mi></msub><mo>≔</mo><mrow><msup><mi>φ</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p_{k}\coloneqq\varphi^{k}(p)</annotation></semantics></math>.</p>
<ul id="S9.I1" class="ltx_itemize">
<li id="S9.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S9.I1.i1.p1" class="ltx_para">
<p id="S9.I1.i1.p1.1" class="ltx_p">Suppose that <math id="S9.I1.i1.p1.m1" class="ltx_Math" alttext="p_{1}\in\partial\Sigma" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>1</mn></msub><mo rspace="0.111em">∈</mo><mrow><mo>∂</mo><mi mathvariant="normal">Σ</mi></mrow></mrow><annotation encoding="application/x-tex">p_{1}\in\partial\Sigma</annotation></semantics></math>. Then the immersion <math id="S9.I1.i1.p1.m2" class="ltx_Math" alttext="\mathbb{R}\times\partial\Sigma\rightarrow Y" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℝ</mi><mo lspace="0.222em" rspace="0.055em">×</mo><mrow><mo>∂</mo><mi mathvariant="normal">Σ</mi></mrow></mrow><mo stretchy="false">→</mo><mi>Y</mi></mrow><annotation encoding="application/x-tex">\mathbb{R}\times\partial\Sigma\rightarrow Y</annotation></semantics></math> induced by the flow <math id="S9.I1.i1.p1.m3" class="ltx_Math" alttext="\varphi^{t}" display="inline" intent=":literal"><semantics><msup><mi>φ</mi><mi>t</mi></msup><annotation encoding="application/x-tex">\varphi^{t}</annotation></semantics></math> intersects <math id="S9.I1.i1.p1.m4" class="ltx_Math" alttext="\partial\Sigma" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mi mathvariant="normal">Σ</mi></mrow><annotation encoding="application/x-tex">\partial\Sigma</annotation></semantics></math> transversely at <math id="S9.I1.i1.p1.m5" class="ltx_Math" alttext="(\tau(p),p)\in\mathbb{R}\times\partial\Sigma" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>p</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi>ℝ</mi><mo lspace="0.222em" rspace="0.055em">×</mo><mrow><mo>∂</mo><mi mathvariant="normal">Σ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">(\tau(p),p)\in\mathbb{R}\times\partial\Sigma</annotation></semantics></math>. Moreover, the points <math id="S9.I1.i1.p1.m6" class="ltx_Math" alttext="p_{-2}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mrow><mo>−</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">p_{-2}</annotation></semantics></math>, <math id="S9.I1.i1.p1.m7" class="ltx_Math" alttext="p_{-1}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mrow><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">p_{-1}</annotation></semantics></math>, <math id="S9.I1.i1.p1.m8" class="ltx_Math" alttext="p_{2}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mn>2</mn></msub><annotation encoding="application/x-tex">p_{2}</annotation></semantics></math> and <math id="S9.I1.i1.p1.m9" class="ltx_Math" alttext="p_{3}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mn>3</mn></msub><annotation encoding="application/x-tex">p_{3}</annotation></semantics></math> are contained in the interior of <math id="S9.I1.i1.p1.m10" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math>.</p>
</div></li>
<li id="S9.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S9.I1.i2.p1" class="ltx_para">
<p id="S9.I1.i2.p1.1" class="ltx_p">Suppose that <math id="S9.I1.i2.p1.m1" class="ltx_Math" alttext="p_{1}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mn>1</mn></msub><annotation encoding="application/x-tex">p_{1}</annotation></semantics></math> is not contained in <math id="S9.I1.i2.p1.m2" class="ltx_Math" alttext="\partial\Sigma" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mi mathvariant="normal">Σ</mi></mrow><annotation encoding="application/x-tex">\partial\Sigma</annotation></semantics></math>. If <math id="S9.I1.i2.p1.m3" class="ltx_Math" alttext="p_{2}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mn>2</mn></msub><annotation encoding="application/x-tex">p_{2}</annotation></semantics></math> is contained in <math id="S9.I1.i2.p1.m4" class="ltx_Math" alttext="\partial\Sigma" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mi mathvariant="normal">Σ</mi></mrow><annotation encoding="application/x-tex">\partial\Sigma</annotation></semantics></math>, then the immersion <math id="S9.I1.i2.p1.m5" class="ltx_Math" alttext="\mathbb{R}\times\partial\Sigma\rightarrow Y" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℝ</mi><mo lspace="0.222em" rspace="0.055em">×</mo><mrow><mo>∂</mo><mi mathvariant="normal">Σ</mi></mrow></mrow><mo stretchy="false">→</mo><mi>Y</mi></mrow><annotation encoding="application/x-tex">\mathbb{R}\times\partial\Sigma\rightarrow Y</annotation></semantics></math> induced by the flow <math id="S9.I1.i2.p1.m6" class="ltx_Math" alttext="\varphi^{t}" display="inline" intent=":literal"><semantics><msup><mi>φ</mi><mi>t</mi></msup><annotation encoding="application/x-tex">\varphi^{t}</annotation></semantics></math> intersects <math id="S9.I1.i2.p1.m7" class="ltx_Math" alttext="\partial\Sigma" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mi mathvariant="normal">Σ</mi></mrow><annotation encoding="application/x-tex">\partial\Sigma</annotation></semantics></math> transversely at <math id="S9.I1.i2.p1.m8" class="ltx_Math" alttext="(\tau(p)+\tau(p_{1}),p)\in\mathbb{R}\times\partial\Sigma" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mi>p</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi>ℝ</mi><mo lspace="0.222em" rspace="0.055em">×</mo><mrow><mo>∂</mo><mi mathvariant="normal">Σ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">(\tau(p)+\tau(p_{1}),p)\in\mathbb{R}\times\partial\Sigma</annotation></semantics></math>.</p>
</div></li>
</ul>
<p id="S9.SS1.p3.2" class="ltx_p">Note that an exhaustive transverse surface can be brought into good position by a generic perburbation.</p>
</div>
<div id="S9.SS1.p4" class="ltx_para">
<p id="S9.SS1.p4.1" class="ltx_p">Given an exhaustive transverse surface <math id="S9.SS1.p4.m1" class="ltx_Math" alttext="\Sigma\subset Y" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Σ</mi><mo>⊂</mo><mi>Y</mi></mrow><annotation encoding="application/x-tex">\Sigma\subset Y</annotation></semantics></math> in good position, we construct a stratification <math id="S9.SS1.p4.m2" class="ltx_Math" alttext="\mathcal{Y}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒴</mi><annotation encoding="application/x-tex">\mathcal{Y}</annotation></semantics></math> of <math id="S9.SS1.p4.m3" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>. Constructing <math id="S9.SS1.p4.m4" class="ltx_Math" alttext="\mathcal{Y}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒴</mi><annotation encoding="application/x-tex">\mathcal{Y}</annotation></semantics></math> amounts to constructing a filtration</p>
<table id="S9.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S9.Ex3.m1" class="ltx_Math" alttext="Y=Y_{3}\supset Y_{2}\supset Y_{1}\supset Y_{0}" display="block" intent=":literal"><semantics><mrow><mi>Y</mi><mo>=</mo><msub><mi>Y</mi><mn>3</mn></msub><mo>⊃</mo><msub><mi>Y</mi><mn>2</mn></msub><mo>⊃</mo><msub><mi>Y</mi><mn>1</mn></msub><mo>⊃</mo><msub><mi>Y</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">Y=Y_{3}\supset Y_{2}\supset Y_{1}\supset Y_{0}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S9.SS1.p4.2" class="ltx_p">by closed subsets <math id="S9.SS1.p4.m5" class="ltx_Math" alttext="Y_{i}\subset Y" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mi>i</mi></msub><mo>⊂</mo><mi>Y</mi></mrow><annotation encoding="application/x-tex">Y_{i}\subset Y</annotation></semantics></math> such that each complement <math id="S9.SS1.p4.m6" class="ltx_Math" alttext="Y_{i}\setminus Y_{i-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mi>i</mi></msub><mo>∖</mo><msub><mi>Y</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">Y_{i}\setminus Y_{i-1}</annotation></semantics></math> is a submanifold of dimension <math id="S9.SS1.p4.m7" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>. We define <math id="S9.SS1.p4.m8" class="ltx_Math" alttext="Y_{2}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mn>2</mn></msub><annotation encoding="application/x-tex">Y_{2}</annotation></semantics></math> to be the union of a subset <math id="S9.SS1.p4.m9" class="ltx_Math" alttext="Y_{2}^{\perp}" display="inline" intent=":literal"><semantics><msubsup><mi>Y</mi><mn>2</mn><mo>⟂</mo></msubsup><annotation encoding="application/x-tex">Y_{2}^{\perp}</annotation></semantics></math> transverse to the vector field <math id="S9.SS1.p4.m10" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> and a subset <math id="S9.SS1.p4.m11" class="ltx_Math" alttext="Y_{2}^{\top}" display="inline" intent=":literal"><semantics><msubsup><mi>Y</mi><mn>2</mn><mo>⊤</mo></msubsup><annotation encoding="application/x-tex">Y_{2}^{\top}</annotation></semantics></math> tangent to <math id="S9.SS1.p4.m12" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>. The transverse subset <math id="S9.SS1.p4.m13" class="ltx_Math" alttext="Y_{2}^{\perp}" display="inline" intent=":literal"><semantics><msubsup><mi>Y</mi><mn>2</mn><mo>⟂</mo></msubsup><annotation encoding="application/x-tex">Y_{2}^{\perp}</annotation></semantics></math> is simply defined to be <math id="S9.SS1.p4.m14" class="ltx_Math" alttext="Y_{2}^{\perp}\coloneqq\Sigma" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Y</mi><mn>2</mn><mo>⟂</mo></msubsup><mo>≔</mo><mi mathvariant="normal">Σ</mi></mrow><annotation encoding="application/x-tex">Y_{2}^{\perp}\coloneqq\Sigma</annotation></semantics></math>. Let <math id="S9.SS1.p4.m15" class="ltx_Math" alttext="\Sigma^{+}\subset Y" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Σ</mi><mo>+</mo></msup><mo>⊂</mo><mi>Y</mi></mrow><annotation encoding="application/x-tex">\Sigma^{+}\subset Y</annotation></semantics></math> be a surface obtained by slightly enlarging <math id="S9.SS1.p4.m16" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math>, i.e. by slightly pushing <math id="S9.SS1.p4.m17" class="ltx_Math" alttext="\partial\Sigma" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mi mathvariant="normal">Σ</mi></mrow><annotation encoding="application/x-tex">\partial\Sigma</annotation></semantics></math> in the direction of the outward normal vector field. The tangent subset <math id="S9.SS1.p4.m18" class="ltx_Math" alttext="Y_{2}^{\top}" display="inline" intent=":literal"><semantics><msubsup><mi>Y</mi><mn>2</mn><mo>⊤</mo></msubsup><annotation encoding="application/x-tex">Y_{2}^{\top}</annotation></semantics></math> is constructed by flowing every point <math id="S9.SS1.p4.m19" class="ltx_Math" alttext="p\in\partial\Sigma\cup\partial\Sigma^{+}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo rspace="0.111em">∈</mo><mrow><mrow><mo>∂</mo><mi mathvariant="normal">Σ</mi></mrow><mo rspace="0.055em">∪</mo><mrow><mo>∂</mo><msup><mi mathvariant="normal">Σ</mi><mo>+</mo></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">p\in\partial\Sigma\cup\partial\Sigma^{+}</annotation></semantics></math> forward and backward until <math id="S9.SS1.p4.m20" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> is hit for the first time. In formulas this means</p>
<table id="S9.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S9.Ex4.m1" class="ltx_Math" alttext="Y_{2}^{\perp}\coloneqq\Sigma\qquad Y_{2}^{\top}\coloneqq\overline{\Phi^{-1}(\partial\Sigma)\cup\Phi^{-1}(\varphi(\partial\Sigma))\cup\Phi^{-1}(\Phi(\partial\Sigma^{+}))}\qquad Y_{2}\coloneqq Y_{2}^{\perp}\cup Y_{2}^{\top}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>Y</mi><mn>2</mn><mo>⟂</mo></msubsup><mo>≔</mo><mi mathvariant="normal">Σ</mi></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><msubsup><mi>Y</mi><mn>2</mn><mo>⊤</mo></msubsup><mo>≔</mo><mover accent="true"><mrow><mrow><msup><mi mathvariant="normal">Φ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">∂</mo><mi mathvariant="normal">Σ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∪</mo><mrow><msup><mi mathvariant="normal">Φ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">∂</mo><mi mathvariant="normal">Σ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∪</mo><mrow><msup><mi mathvariant="normal">Φ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">∂</mo><msup><mi mathvariant="normal">Σ</mi><mo>+</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="true">¯</mo></mover></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><msub><mi>Y</mi><mn>2</mn></msub><mo>≔</mo><mrow><msubsup><mi>Y</mi><mn>2</mn><mo>⟂</mo></msubsup><mo>∪</mo><msubsup><mi>Y</mi><mn>2</mn><mo>⊤</mo></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Y_{2}^{\perp}\coloneqq\Sigma\qquad Y_{2}^{\top}\coloneqq\overline{\Phi^{-1}(\partial\Sigma)\cup\Phi^{-1}(\varphi(\partial\Sigma))\cup\Phi^{-1}(\Phi(\partial\Sigma^{+}))}\qquad Y_{2}\coloneqq Y_{2}^{\perp}\cup Y_{2}^{\top}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S9.SS1.p4.3" class="ltx_p">We define <math id="S9.SS1.p4.m21" class="ltx_Math" alttext="Y_{1}\subset Y_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mn>1</mn></msub><mo>⊂</mo><msub><mi>Y</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">Y_{1}\subset Y_{2}</annotation></semantics></math> to be the set of non-smooth points of <math id="S9.SS1.p4.m22" class="ltx_Math" alttext="Y_{2}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mn>2</mn></msub><annotation encoding="application/x-tex">Y_{2}</annotation></semantics></math> and <math id="S9.SS1.p4.m23" class="ltx_Math" alttext="Y_{0}\subset Y_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mn>0</mn></msub><mo>⊂</mo><msub><mi>Y</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">Y_{0}\subset Y_{1}</annotation></semantics></math> to be the set of non-smooth points of <math id="S9.SS1.p4.m24" class="ltx_Math" alttext="Y_{1}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mn>1</mn></msub><annotation encoding="application/x-tex">Y_{1}</annotation></semantics></math>. It follows from the assumption that <math id="S9.SS1.p4.m25" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> is in good position that this actually defines a stratification of <math id="S9.SS1.p4.m26" class="ltx_Math" alttext="\mathcal{Y}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒴</mi><annotation encoding="application/x-tex">\mathcal{Y}</annotation></semantics></math>.</p>
</div>
<div id="S9.SS1.p5" class="ltx_para">
<p id="S9.SS1.p5.1" class="ltx_p">Let us now describe the structure of <math id="S9.SS1.p5.m1" class="ltx_Math" alttext="\mathcal{Y}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒴</mi><annotation encoding="application/x-tex">\mathcal{Y}</annotation></semantics></math> in more detail. Let <math id="S9.SS1.p5.m2" class="ltx_Math" alttext="S\subset\Sigma" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⊂</mo><mi mathvariant="normal">Σ</mi></mrow><annotation encoding="application/x-tex">S\subset\Sigma</annotation></semantics></math> be the set of all points <math id="S9.SS1.p5.m3" class="ltx_Math" alttext="p\in\Sigma" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mi mathvariant="normal">Σ</mi></mrow><annotation encoding="application/x-tex">p\in\Sigma</annotation></semantics></math> such that the first intersection of the forward flow line starting at <math id="S9.SS1.p5.m4" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> with <math id="S9.SS1.p5.m5" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> is contained in the boundary <math id="S9.SS1.p5.m6" class="ltx_Math" alttext="\partial\Sigma" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mi mathvariant="normal">Σ</mi></mrow><annotation encoding="application/x-tex">\partial\Sigma</annotation></semantics></math>. In other words, we set <math id="S9.SS1.p5.m7" class="ltx_Math" alttext="S\coloneqq\varphi^{-1}(\partial\Sigma)" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>≔</mo><mrow><msup><mi>φ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">∂</mo><mi mathvariant="normal">Σ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">S\coloneqq\varphi^{-1}(\partial\Sigma)</annotation></semantics></math>. The map <math id="S9.SS1.p5.m8" class="ltx_Math" alttext="\varphi" display="inline" intent=":literal"><semantics><mi>φ</mi><annotation encoding="application/x-tex">\varphi</annotation></semantics></math> is continuous on <math id="S9.SS1.p5.m9" class="ltx_Math" alttext="\Sigma\setminus S" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Σ</mi><mo>∖</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">\Sigma\setminus S</annotation></semantics></math>. Since <math id="S9.SS1.p5.m10" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> is in good position, the set <math id="S9.SS1.p5.m11" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is a smooth <math id="S9.SS1.p5.m12" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>-dimensional manifold except for finitely many T-shaped singularities, i.e. singularities modeled on <math id="S9.SS1.p5.m13" class="ltx_Math" alttext="\mathbb{R}_{&gt;0}\cup i\mathbb{R}\subset\mathbb{C}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>&gt;</mo><mn>0</mn></mrow></msub><mo>∪</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℝ</mi></mrow></mrow><mo>⊂</mo><mi>ℂ</mi></mrow><annotation encoding="application/x-tex">\mathbb{R}_{&gt;0}\cup i\mathbb{R}\subset\mathbb{C}</annotation></semantics></math>. Each smooth point <math id="S9.SS1.p5.m14" class="ltx_Math" alttext="p\in S" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">p\in S</annotation></semantics></math> has a preferred normal orientation constructed as follows. The function <math id="S9.SS1.p5.m15" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> has a jump discontinuity along <math id="S9.SS1.p5.m16" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>. We equip <math id="S9.SS1.p5.m17" class="ltx_Math" alttext="p\in S" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">p\in S</annotation></semantics></math> with the normal orientation along which <math id="S9.SS1.p5.m18" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> jumps up. Consider a T-shaped singularity of <math id="S9.SS1.p5.m19" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> identified with <math id="S9.SS1.p5.m20" class="ltx_Math" alttext="\mathbb{R}_{&gt;0}\cup i\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>&gt;</mo><mn>0</mn></mrow></msub><mo>∪</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">\mathbb{R}_{&gt;0}\cup i\mathbb{R}</annotation></semantics></math>. It is not hard to check that the normal orientation at points in <math id="S9.SS1.p5.m21" class="ltx_Math" alttext="i\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">i\mathbb{R}</annotation></semantics></math> must point in the direction of positive real part.</p>
</div>
<div id="S9.SS1.p6" class="ltx_para">
<p id="S9.SS1.p6.1" class="ltx_p">Let <math id="S9.SS1.p6.m1" class="ltx_Math" alttext="S^{+}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mo>+</mo></msup><annotation encoding="application/x-tex">S^{+}</annotation></semantics></math> denote the set of all points <math id="S9.SS1.p6.m2" class="ltx_Math" alttext="p\in\Sigma" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mi mathvariant="normal">Σ</mi></mrow><annotation encoding="application/x-tex">p\in\Sigma</annotation></semantics></math> such that the forward flow line starting at <math id="S9.SS1.p6.m3" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> meets <math id="S9.SS1.p6.m4" class="ltx_Math" alttext="\partial\Sigma^{+}" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><msup><mi mathvariant="normal">Σ</mi><mo>+</mo></msup></mrow><annotation encoding="application/x-tex">\partial\Sigma^{+}</annotation></semantics></math> before it meets <math id="S9.SS1.p6.m5" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> for the first time, i.e. <math id="S9.SS1.p6.m6" class="ltx_Math" alttext="S^{+}\coloneqq\varphi^{-1}(\Phi(\partial\Sigma^{+}))" display="inline" intent=":literal"><semantics><mrow><msup><mi>S</mi><mo>+</mo></msup><mo>≔</mo><mrow><msup><mi>φ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">∂</mo><msup><mi mathvariant="normal">Σ</mi><mo>+</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">S^{+}\coloneqq\varphi^{-1}(\Phi(\partial\Sigma^{+}))</annotation></semantics></math>. If <math id="S9.SS1.p6.m7" class="ltx_Math" alttext="\partial\Sigma^{+}" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><msup><mi mathvariant="normal">Σ</mi><mo>+</mo></msup></mrow><annotation encoding="application/x-tex">\partial\Sigma^{+}</annotation></semantics></math> is sufficiently close to <math id="S9.SS1.p6.m8" class="ltx_Math" alttext="\partial\Sigma" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mi mathvariant="normal">Σ</mi></mrow><annotation encoding="application/x-tex">\partial\Sigma</annotation></semantics></math>, then <math id="S9.SS1.p6.m9" class="ltx_Math" alttext="S^{+}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mo>+</mo></msup><annotation encoding="application/x-tex">S^{+}</annotation></semantics></math> is a small push-off of <math id="S9.SS1.p6.m10" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> in the direction of the normal orientation. The model at a T-shaped singularity of <math id="S9.SS1.p6.m11" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is given by</p>
<table id="S9.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S9.Ex5.m1" class="ltx_Math" alttext="S=\mathbb{R}_{&gt;0}\cup i\mathbb{R}\subset\mathbb{C}\qquad\text{and}\qquad S^{+}=(i\varepsilon+\mathbb{R}_{&gt;0})\cup(\varepsilon+i\mathbb{R})" display="block" intent=":literal"><semantics><mrow><mrow><mi>S</mi><mo>=</mo><mrow><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>&gt;</mo><mn>0</mn></mrow></msub><mo>∪</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℝ</mi></mrow></mrow><mo>⊂</mo><mi>ℂ</mi></mrow><mspace style="width:2em;" width="2em"></mspace><mtext>and</mtext><mspace style="width:2em;" width="2em"></mspace><mrow><msup><mi>S</mi><mo>+</mo></msup><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow><mo>+</mo><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>&gt;</mo><mn>0</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo>∪</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ε</mi><mo>+</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℝ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">S=\mathbb{R}_{&gt;0}\cup i\mathbb{R}\subset\mathbb{C}\qquad\text{and}\qquad S^{+}=(i\varepsilon+\mathbb{R}_{&gt;0})\cup(\varepsilon+i\mathbb{R})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S9.SS1.p6.2" class="ltx_p">for <math id="S9.SS1.p6.m12" class="ltx_Math" alttext="\varepsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\varepsilon&gt;0</annotation></semantics></math>. See Figure <a href="#S9.F1" title="Figure 9.1 ‣ 9.1. Stratifications compatible with a flow ‣ 9. Proof of the stratification lemma ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9.1</span></a> for an illustration of the sets <math id="S9.SS1.p6.m13" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> and <math id="S9.SS1.p6.m14" class="ltx_Math" alttext="S^{+}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mo>+</mo></msup><annotation encoding="application/x-tex">S^{+}</annotation></semantics></math>.</p>
</div>
<figure id="S9.F1" class="ltx_figure"><span id="S9.F1.pic1" class="ltx_picture ltx_centering" style="width:1.0pt;height:0.53205128pt;"><svg xmlns="http://www.w3.org/2000/svg" version="1.1" width="1.33" height="0.71" overflow="visible"><g transform="translate(0,0.71) scale(1,-1)"><g transform="translate(0,0)"><g transform="translate(0,243.89) scale(1,-1)"><foreignObject width="458.28" height="243.89" overflow="visible"><object type="image/svg+xml" data="2509.15390v1/x36.svg" id="S9.F1.pic1.g1" class="ltx_graphics ltx_img_landscape" width="476" height="254" aria-label="Refer to caption"></object></foreignObject></g></g><g transform="translate(1.13,0.41)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="18.46" height="11.16" overflow="visible"><Math mode="inline" tex="\Sigma" text="Sigma" xml:id="S9.F1.pic1.m1">
                        <XMath xml:id="S9.F1.pic1.m1.1">
                          <XMTok name="Sigma" role="UNKNOWN">Σ</XMTok>
                        </XMath>
                      </Math></foreignObject></g></g><g transform="translate(0,0)"><g transform="translate(0,243.89) scale(1,-1)"><foreignObject width="458.28" height="243.89" overflow="visible"><object type="image/svg+xml" data="2509.15390v1/x37.svg" id="S9.F1.pic1.g2" class="ltx_graphics ltx_img_landscape" width="476" height="253" aria-label="Refer to caption"></object></foreignObject></g></g><g transform="translate(0.67,0.68)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="15.41" height="11.16" overflow="visible"><Math mode="inline" tex="R" text="R" xml:id="S9.F1.pic1.m2">
