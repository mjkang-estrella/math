                          </XMApp>
                        </XMath>
                      </Math></foreignObject></g></g><g transform="translate(0.17,0.27)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="19.13" height="11.16" overflow="visible"><Math mode="inline" tex="s_{l}" text="s _ l" xml:id="S5.F8.pic1.m3">
                        <XMath xml:id="S5.F8.pic1.m3.1">
                          <XMApp xml:id="S5.F8.pic1.m3.1.1">
                            <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
