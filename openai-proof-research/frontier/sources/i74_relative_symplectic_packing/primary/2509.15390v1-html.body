                              <XMTok fontsize="70%" meaning="plus" role="ADDOP">+</XMTok>
                            </XMApp>
                          </XMApp>
                        </XMath>
                      </Math></foreignObject></g></g><g transform="translate(0.2,0.11)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="22.85" height="11.16" overflow="visible"><Math mode="inline" tex="S^{+}" text="S ^ +" xml:id="S9.F1.pic1.m4">
                        <XMath xml:id="S9.F1.pic1.m4.1">
                          <XMApp xml:id="S9.F1.pic1.m4.1.1">
                            <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
                            <XMTok font="italic" role="UNKNOWN">S</XMTok>
                            <XMTok fontsize="70%" meaning="plus" role="ADDOP">+</XMTok>
                          </XMApp>
                        </XMath>
                      </Math></foreignObject></g></g><g transform="translate(0.31,0.37)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="14.08" height="11.16" overflow="visible"><Math mode="inline" tex="S" text="S" xml:id="S9.F1.pic1.m5">
                        <XMath xml:id="S9.F1.pic1.m5.1">
