                    </Math></foreignObject></g></g><g transform="translate(1,0.5)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="16.21" height="11.16" overflow="visible"><Math mode="inline" tex="q_{t}" text="q _ t" xml:id="S5.F1.pic1.m7">
