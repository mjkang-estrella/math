                      </Math></foreignObject></g></g><g transform="translate(0.44,0.44)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="19.79" height="11.16" overflow="visible"><Math mode="inline" tex="s_{t}" text="s _ t" xml:id="S5.F8.pic1.m2">
