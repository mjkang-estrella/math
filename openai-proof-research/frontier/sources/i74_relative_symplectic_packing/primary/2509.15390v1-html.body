                        </XMath>
                      </Math></foreignObject></g></g><g transform="translate(0.25,0.49)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="14.74" height="11.16" overflow="visible"><Math mode="inline" tex="\Sigma" text="Sigma" xml:id="S9.F1.pic1.m6">
                        <XMath xml:id="S9.F1.pic1.m6.1">
                          <XMTok name="Sigma" role="UNKNOWN">Σ</XMTok>
                        </XMath>
                      </Math></foreignObject></g></g><g transform="translate(0.74,0.4)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="24.04" height="11.16" overflow="visible"><Math mode="inline" tex="\partial\Sigma" text="partial-differential@(Sigma)" xml:id="S9.F1.pic1.m7">
                        <XMath xml:id="S9.F1.pic1.m7.1">
