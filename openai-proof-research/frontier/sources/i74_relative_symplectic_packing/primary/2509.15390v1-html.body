                      </Math></foreignObject></g></g><g transform="translate(0.68,0.2)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="32.81" height="11.16" overflow="visible"><Math mode="inline" tex="\partial\Sigma^{+}" text="partial-differential@(Sigma ^ +)" xml:id="S9.F1.pic1.m3">
                        <XMath xml:id="S9.F1.pic1.m3.1">
                          <XMApp xml:id="S9.F1.pic1.m3.1.1">
                            <XMTok meaning="partial-differential" name="partial" role="DIFFOP">∂</XMTok>
                            <XMApp xml:id="S9.F1.pic1.m3.1.1.2">
