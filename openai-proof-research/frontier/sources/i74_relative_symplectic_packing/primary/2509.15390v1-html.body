                      </Math></foreignObject></g></g><g transform="translate(0.68,0.08)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="25.37" height="11.16" overflow="visible"><Math mode="inline" tex="D_{2}^{+}" text="(D _ 2) ^ +" xml:id="S9.F3.pic1.m5">
