                      </Math></foreignObject></g></g><g transform="translate(0.3,0.82)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="19.93" height="11.16" overflow="visible"><Math mode="inline" tex="\frac{a}{4}" text="a / 4" xml:id="S5.F6.pic1.m3">
