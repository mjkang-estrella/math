                      </Math></foreignObject></g></g><g transform="translate(0.83,0.09)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="23.64" height="11.16" overflow="visible"><Math mode="inline" tex="\Sigma^{+}" text="Sigma ^ +" xml:id="S9.F1.pic1.m8">
                        <XMath xml:id="S9.F1.pic1.m8.1">
