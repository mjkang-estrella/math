                        </XMApp>
                      </XMath>
                    </Math></foreignObject></g></g><g transform="translate(1.31,0.03)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="43.57" height="11.16" overflow="visible"><Math mode="inline" tex="t_{d}\times q_{l}" text="t _ d * q _ l" xml:id="S5.F2.pic1.m21">
                      <XMath xml:id="S5.F2.pic1.m21.1">
                        <XMApp color="#1A1A1A" xml:id="S5.F2.pic1.m21.1.1">
                          <XMTok meaning="times" role="MULOP">×</XMTok>
                          <XMApp xml:id="S5.F2.pic1.m21.1.1.2">
                            <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                            <XMTok font="italic" role="UNKNOWN">t</XMTok>
                            <XMTok font="italic" fontsize="70%" role="UNKNOWN">d</XMTok>
                          </XMApp>
                          <XMApp xml:id="S5.F2.pic1.m21.1.1.3">
                            <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                            <XMTok font="italic" role="UNKNOWN">q</XMTok>
                            <XMTok font="italic" fontsize="70%" role="UNKNOWN">l</XMTok>
                          </XMApp>
                        </XMApp>
                      </XMath>
                    </Math></foreignObject></g></g><g transform="translate(1.31,0.35)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="41.44" height="11.16" overflow="visible"><Math mode="inline" tex="t_{l}\times q_{l}" text="t _ l * q _ l" xml:id="S5.F2.pic1.m22">
                      <XMath xml:id="S5.F2.pic1.m22.1">
                        <XMApp color="#1A1A1A" xml:id="S5.F2.pic1.m22.1.1">
                          <XMTok meaning="times" role="MULOP">×</XMTok>
                          <XMApp xml:id="S5.F2.pic1.m22.1.1.2">
                            <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                            <XMTok font="italic" role="UNKNOWN">t</XMTok>
                            <XMTok font="italic" fontsize="70%" role="UNKNOWN">l</XMTok>
                          </XMApp>
                          <XMApp xml:id="S5.F2.pic1.m22.1.1.3">
                            <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                            <XMTok font="italic" role="UNKNOWN">q</XMTok>
                            <XMTok font="italic" fontsize="70%" role="UNKNOWN">l</XMTok>
                          </XMApp>
                        </XMApp>
                      </XMath>
                    </Math></foreignObject></g></g><g transform="translate(1.31,0.67)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="43.30" height="11.16" overflow="visible"><Math mode="inline" tex="t_{l}\times q_{r}" text="t _ l * q _ r" xml:id="S5.F2.pic1.m23">
                      <XMath xml:id="S5.F2.pic1.m23.1">
                        <XMApp color="#1A1A1A" xml:id="S5.F2.pic1.m23.1.1">
                          <XMTok meaning="times" role="MULOP">×</XMTok>
                          <XMApp xml:id="S5.F2.pic1.m23.1.1.2">
                            <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                            <XMTok font="italic" role="UNKNOWN">t</XMTok>
                            <XMTok font="italic" fontsize="70%" role="UNKNOWN">l</XMTok>
                          </XMApp>
                          <XMApp xml:id="S5.F2.pic1.m23.1.1.3">
                            <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                            <XMTok font="italic" role="UNKNOWN">q</XMTok>
                            <XMTok font="italic" fontsize="70%" role="UNKNOWN">r</XMTok>
                          </XMApp>
                        </XMApp>
                      </XMath>
                    </Math></foreignObject></g></g><g transform="translate(0.69,0.67)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="45.43" height="11.16" overflow="visible"><Math mode="inline" tex="t_{d}\times q_{r}" text="t _ d * q _ r" xml:id="S5.F2.pic1.m24">
                      <XMath xml:id="S5.F2.pic1.m24.1">
                        <XMApp color="#1A1A1A" xml:id="S5.F2.pic1.m24.1.1">
                          <XMTok meaning="times" role="MULOP">×</XMTok>
                          <XMApp xml:id="S5.F2.pic1.m24.1.1.2">
                            <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                            <XMTok font="italic" role="UNKNOWN">t</XMTok>
                            <XMTok font="italic" fontsize="70%" role="UNKNOWN">d</XMTok>
                          </XMApp>
                          <XMApp xml:id="S5.F2.pic1.m24.1.1.3">
                            <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                            <XMTok font="italic" role="UNKNOWN">q</XMTok>
                            <XMTok font="italic" fontsize="70%" role="UNKNOWN">r</XMTok>
                          </XMApp>
                        </XMApp>
                      </XMath>
                    </Math></foreignObject></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 5.2. </span>Reeb dynamics on the boundary of <math id="S5.F2.m2" class="ltx_Math" alttext="T\times_{L}Q" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mi>Q</mi></mrow><annotation encoding="application/x-tex">T\times_{L}Q</annotation></semantics></math>.</figcaption>
</figure>
<div id="S5.p26" class="ltx_para">
<p id="S5.p26.1" class="ltx_p">Let us for example start at the symplectic <math id="S5.p26.m1" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-face <math id="S5.p26.m2" class="ltx_Math" alttext="t_{l}\times q_{l}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>l</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>q</mi><mi>l</mi></msub></mrow><annotation encoding="application/x-tex">t_{l}\times q_{l}</annotation></semantics></math>. At this <math id="S5.p26.m3" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-face, the Reeb flow enters the <math id="S5.p26.m4" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>-face <math id="S5.p26.m5" class="ltx_Math" alttext="t_{l}\times Q" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>l</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>Q</mi></mrow><annotation encoding="application/x-tex">t_{l}\times Q</annotation></semantics></math>. It traverses <math id="S5.p26.m6" class="ltx_Math" alttext="t_{l}\times Q" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>l</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>Q</mi></mrow><annotation encoding="application/x-tex">t_{l}\times Q</annotation></semantics></math> horizontally from left to right, until it meets the <math id="S5.p26.m7" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-face <math id="S5.p26.m8" class="ltx_Math" alttext="t_{l}\times q_{r}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>l</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>q</mi><mi>r</mi></msub></mrow><annotation encoding="application/x-tex">t_{l}\times q_{r}</annotation></semantics></math>, where it leaves <math id="S5.p26.m9" class="ltx_Math" alttext="t_{l}\times Q" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>l</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>Q</mi></mrow><annotation encoding="application/x-tex">t_{l}\times Q</annotation></semantics></math> and enters <math id="S5.p26.m10" class="ltx_Math" alttext="T\times q_{r}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>q</mi><mi>r</mi></msub></mrow><annotation encoding="application/x-tex">T\times q_{r}</annotation></semantics></math>. Clearly, the transition map from <math id="S5.p26.m11" class="ltx_Math" alttext="t_{l}\times q_{l}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>l</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>q</mi><mi>l</mi></msub></mrow><annotation encoding="application/x-tex">t_{l}\times q_{l}</annotation></semantics></math> to <math id="S5.p26.m12" class="ltx_Math" alttext="t_{l}\times q_{r}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>l</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>q</mi><mi>r</mi></msub></mrow><annotation encoding="application/x-tex">t_{l}\times q_{r}</annotation></semantics></math> is affine linear. As indicated in Figure <a href="#S5.F2" title="Figure 5.2 ‣ 5. Symplectic ribbon complexes ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.2</span></a>, the Reeb flow passes through all the symplectic <math id="S5.p26.m13" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-faces and then ends up back at <math id="S5.p26.m14" class="ltx_Math" alttext="t_{l}\times q_{l}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>l</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>q</mi><mi>l</mi></msub></mrow><annotation encoding="application/x-tex">t_{l}\times q_{l}</annotation></semantics></math>. The return map is simply given by the identity.</p>
</div>
<div id="S5.p27" class="ltx_para">
<p id="S5.p27.1" class="ltx_p">Let <math id="S5.p27.m1" class="ltx_Math" alttext="0&lt;c&lt;1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mi>c</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0&lt;c&lt;1</annotation></semantics></math>. Let <math id="S5.p27.m2" class="ltx_Math" alttext="D\subset t_{l}\times q_{l}" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⊂</mo><mrow><msub><mi>t</mi><mi>l</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>q</mi><mi>l</mi></msub></mrow></mrow><annotation encoding="application/x-tex">D\subset t_{l}\times q_{l}</annotation></semantics></math> be a smooth disk of area <math id="S5.p27.m3" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> obtained by first taking a square inside <math id="S5.p27.m4" class="ltx_Math" alttext="t_{l}\times q_{l}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>l</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>q</mi><mi>l</mi></msub></mrow><annotation encoding="application/x-tex">t_{l}\times q_{l}</annotation></semantics></math> of area <math id="S5.p27.m5" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> and with the same center as <math id="S5.p27.m6" class="ltx_Math" alttext="t_{l}\times q_{l}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>l</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>q</mi><mi>l</mi></msub></mrow><annotation encoding="application/x-tex">t_{l}\times q_{l}</annotation></semantics></math> and then slightly smoothing its corners. Using the Reeb flow, we produce copies of <math id="S5.p27.m7" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> contained in the interiors of <math id="S5.p27.m8" class="ltx_Math" alttext="t_{*}\times Q" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mo>∗</mo></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>Q</mi></mrow><annotation encoding="application/x-tex">t_{*}\times Q</annotation></semantics></math> as follows. Let <math id="S5.p27.m9" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> and <math id="S5.p27.m10" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> denote the vertical and horizontal line segments dividing the square <math id="S5.p27.m11" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> into two rectangles of equal areas. Moreover, let <math id="S5.p27.m12" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> denote the diagonal of <math id="S5.p27.m13" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> connecting the vertices <math id="S5.p27.m14" class="ltx_Math" alttext="(0,1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,1)</annotation></semantics></math> and <math id="S5.p27.m15" class="ltx_Math" alttext="(1,0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1,0)</annotation></semantics></math>. If we start at <math id="S5.p27.m16" class="ltx_Math" alttext="t_{l}\times q_{l}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>l</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>q</mi><mi>l</mi></msub></mrow><annotation encoding="application/x-tex">t_{l}\times q_{l}</annotation></semantics></math>, the Reeb flow meets each of the cross sections <math id="S5.p27.m17" class="ltx_Math" alttext="t_{l}\times v" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>l</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>v</mi></mrow><annotation encoding="application/x-tex">t_{l}\times v</annotation></semantics></math> and <math id="S5.p27.m18" class="ltx_Math" alttext="t_{b}\times h" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>b</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>h</mi></mrow><annotation encoding="application/x-tex">t_{b}\times h</annotation></semantics></math> exactly once before it returns to <math id="S5.p27.m19" class="ltx_Math" alttext="t_{l}\times q_{l}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>l</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>q</mi><mi>l</mi></msub></mrow><annotation encoding="application/x-tex">t_{l}\times q_{l}</annotation></semantics></math>. Similarly, it meets the cross section <math id="S5.p27.m20" class="ltx_Math" alttext="t_{d}\times d" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>d</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">t_{d}\times d</annotation></semantics></math> exactly twice, each time at a different half of <math id="S5.p27.m21" class="ltx_Math" alttext="t_{d}\times d" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>d</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">t_{d}\times d</annotation></semantics></math>. We define <math id="S5.p27.m22" class="ltx_Math" alttext="\tilde{D}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>D</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{D}</annotation></semantics></math> to be the intersection of all Reeb trajectories starting at <math id="S5.p27.m23" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> with the union of the cross sections <math id="S5.p27.m24" class="ltx_Math" alttext="t_{l}\times v" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>l</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>v</mi></mrow><annotation encoding="application/x-tex">t_{l}\times v</annotation></semantics></math>, <math id="S5.p27.m25" class="ltx_Math" alttext="t_{b}\times h" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>b</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>h</mi></mrow><annotation encoding="application/x-tex">t_{b}\times h</annotation></semantics></math> and <math id="S5.p27.m26" class="ltx_Math" alttext="t_{d}\times d" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>d</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">t_{d}\times d</annotation></semantics></math>. The set <math id="S5.p27.m27" class="ltx_Math" alttext="\tilde{D}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>D</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{D}</annotation></semantics></math> consists of four copies of <math id="S5.p27.m28" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>.</p>
</div>
<div id="S5.Thmtheorem12" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem12.2" class="ltx_text ltx_font_bold">Lemma 5.12</span></span><span id="S5.Thmtheorem12.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem12.p1" class="ltx_para">
<p id="S5.Thmtheorem12.p1.1" class="ltx_p"><span id="S5.Thmtheorem12.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S5.Thmtheorem12.p1.m1" class="ltx_Math" alttext="c&lt;a&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&lt;</mo><mi>a</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c&lt;a&lt;1</annotation></semantics></math>. Then there exists a symplectic embedding <math id="S5.Thmtheorem12.p1.m2" class="ltx_Math" alttext="B^{4}(a;c,4)\overset{s}{\hookrightarrow}T\times_{L}Q" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>B</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>c</mi><mo>,</mo><mn>4</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo stretchy="false">↪</mo><mo mathsize="0.700em">𝑠</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mi>Q</mi></mrow><annotation encoding="application/x-tex">B^{4}(a;c,4)\overset{s}{\hookrightarrow}T\times_{L}Q</annotation></semantics></math> which maps the four free ribbon ends of <math id="S5.Thmtheorem12.p1.m3" class="ltx_Math" alttext="B^{4}(a;c,4)" display="inline" intent=":literal"><semantics><mrow><msup><mi>B</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>c</mi><mo>,</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B^{4}(a;c,4)</annotation></semantics></math> exactly to the four components of <math id="S5.Thmtheorem12.p1.m4" class="ltx_Math" alttext="\tilde{D}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>D</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{D}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S5.9" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.p28" class="ltx_para">
<p id="S5.p28.1" class="ltx_p"><span id="S5.p28.1.1" class="ltx_text">It is well known that <math id="S5.p28.m1" class="ltx_Math" alttext="B^{4}(a)" display="inline" intent=":literal"><semantics><mrow><msup><mi>B</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B^{4}(a)</annotation></semantics></math> admits a symplectic embedding into the interior of <math id="S5.p28.m2" class="ltx_Math" alttext="T\times_{L}Q" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mi>Q</mi></mrow><annotation encoding="application/x-tex">T\times_{L}Q</annotation></semantics></math>, see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx84" title="" class="ltx_ref">Tra95</a>]</cite>. What we need to show is that there exists an embedding whose restriction to the boundary of <math id="S5.p28.m3" class="ltx_Math" alttext="B^{4}(a)" display="inline" intent=":literal"><semantics><mrow><msup><mi>B</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B^{4}(a)</annotation></semantics></math> is sufficiently tame such that we can insert four ribbons of width <math id="S5.p28.m4" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> starting at the boundary of <math id="S5.p28.m5" class="ltx_Math" alttext="B^{4}(a)" display="inline" intent=":literal"><semantics><mrow><msup><mi>B</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B^{4}(a)</annotation></semantics></math> and ending at the four components of <math id="S5.p28.m6" class="ltx_Math" alttext="\tilde{D}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>D</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{D}</annotation></semantics></math>. In order to see that this is possible, let us recall the following symplectic embedding construction from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx80" title="" class="ltx_ref">Sch03</a>, §2]</cite> and <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx81" title="" class="ltx_ref">Sch05a</a>, §4.1]</cite>. Let <math id="S5.p28.m7" class="ltx_Math" alttext="U\subset\mathbb{R}^{2}" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⊂</mo><msup><mi>ℝ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">U\subset\mathbb{R}^{2}</annotation></semantics></math> be the open ball of area <math id="S5.p28.m8" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> centered at <math id="S5.p28.m9" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> and let <math id="S5.p28.m10" class="ltx_Math" alttext="V\subset\mathbb{R}^{2}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>⊂</mo><msup><mi>ℝ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">V\subset\mathbb{R}^{2}</annotation></semantics></math> be an open axis parallel square or area <math id="S5.p28.m11" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>. A family <math id="S5.p28.m12" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math> of loops in <math id="S5.p28.m13" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> is called </span><span id="S5.p28.1.2" class="ltx_text ltx_font_italic">admissible</span><span id="S5.p28.1.3" class="ltx_text"> if there exists a diffeomorphism <math id="S5.p28.m14" class="ltx_Math" alttext="\beta:U\setminus\left\{0\right\}\rightarrow V\setminus\left\{p\right\}" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>U</mi><mo>∖</mo><mrow><mo>{</mo><mn>0</mn><mo>}</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>V</mi><mo>∖</mo><mrow><mo>{</mo><mi>p</mi><mo>}</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\beta:U\setminus\left\{0\right\}\rightarrow V\setminus\left\{p\right\}</annotation></semantics></math> for some point <math id="S5.p28.m15" class="ltx_Math" alttext="p\in V" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">p\in V</annotation></semantics></math> such that circles in <math id="S5.p28.m16" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> centered at <math id="S5.p28.m17" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> are mapped to members of <math id="S5.p28.m18" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math> and the restriction of <math id="S5.p28.m19" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> to a neighbourhood of <math id="S5.p28.m20" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> is a translation. Schlenk proves that given an admissible family <math id="S5.p28.m21" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math>, there exists a symplectomorphism <math id="S5.p28.m22" class="ltx_Math" alttext="\varphi:U\rightarrow V" display="inline" intent=":literal"><semantics><mrow><mi>φ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>U</mi><mo stretchy="false">→</mo><mi>V</mi></mrow></mrow><annotation encoding="application/x-tex">\varphi:U\rightarrow V</annotation></semantics></math> mapping circles centered at <math id="S5.p28.m23" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> to members of <math id="S5.p28.m24" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math>, see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx80" title="" class="ltx_ref">Sch03</a>, Lemma 2.5]</cite> or <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx81" title="" class="ltx_ref">Sch05a</a>, Lemma 4.2]</cite>. One can arrange the family <math id="S5.p28.m25" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math> such that the image of the restriction of the symplectomorphism <math id="S5.p28.m26" class="ltx_Math" alttext="\varphi\times\varphi:U\times U\rightarrow V\times V" display="inline" intent=":literal"><semantics><mrow><mrow><mi>φ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>φ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>U</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>U</mi></mrow><mo stretchy="false">→</mo><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>V</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\varphi\times\varphi:U\times U\rightarrow V\times V</annotation></semantics></math> to <math id="S5.p28.m27" class="ltx_Math" alttext="B^{4}(a)" display="inline" intent=":literal"><semantics><mrow><msup><mi>B</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B^{4}(a)</annotation></semantics></math> is an arbitrarily close approximation of <math id="S5.p28.m28" class="ltx_Math" alttext="aT\times_{L}Q" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mi>Q</mi></mrow><annotation encoding="application/x-tex">aT\times_{L}Q</annotation></semantics></math>, see Figure <a href="#S5.F3" title="Figure 5.3 ‣ Proof. ‣ 5. Symplectic ribbon complexes ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.3</span></a>. Here <math id="S5.p28.m29" class="ltx_Math" alttext="aT" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">aT</annotation></semantics></math> is the scaling of <math id="S5.p28.m30" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> by a factor <math id="S5.p28.m31" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math>.</span></p>
</div>
<figure id="S5.F3" class="ltx_figure"><span id="S5.F3.pic1" class="ltx_picture ltx_centering" style="width:1.0pt;height:1.0pt;"><svg xmlns="http://www.w3.org/2000/svg" version="1.1" width="1.33" height="1.33" overflow="visible"><g transform="translate(0,1.33) scale(1,-1)"><g transform="translate(0,0)"><g transform="translate(0,137.48) scale(1,-1)"><foreignObject width="137.48" height="137.48" overflow="visible"><object type="image/svg+xml" data="2509.15390v1/x11.svg" id="S5.F3.pic1.g1" class="ltx_graphics ltx_img_square" width="143" height="143" aria-label="Refer to caption"></object></foreignObject></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 5.3. </span>A special admissible family of loops <math id="S5.F3.m2" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math>.</figcaption>
</figure>
<div id="S5.p29" class="ltx_para">
<p id="S5.p29.1" class="ltx_p"><span id="S5.p29.1.1" class="ltx_text">For a careful choice of the family of loops <math id="S5.p29.m1" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math>, the generalized Reeb orbits on the boundary of <math id="S5.p29.m2" class="ltx_Math" alttext="aT\times_{L}Q" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mi>Q</mi></mrow><annotation encoding="application/x-tex">aT\times_{L}Q</annotation></semantics></math> away from the Lagrangian <math id="S5.p29.m3" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-faces are approximated arbitrarily well by images of Hopf circles on the boundary of <math id="S5.p29.m4" class="ltx_Math" alttext="B^{4}(a)" display="inline" intent=":literal"><semantics><mrow><msup><mi>B</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B^{4}(a)</annotation></semantics></math>. Note that <math id="S5.p29.m5" class="ltx_Math" alttext="aT\times_{L}Q" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mi>Q</mi></mrow><annotation encoding="application/x-tex">aT\times_{L}Q</annotation></semantics></math> is symplectomorphic to <math id="S5.p29.m6" class="ltx_Math" alttext="\sqrt{a}T\times_{L}\sqrt{a}Q" display="inline" intent=":literal"><semantics><mrow><mrow><msqrt><mi>a</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mrow><msqrt><mi>a</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow></mrow><annotation encoding="application/x-tex">\sqrt{a}T\times_{L}\sqrt{a}Q</annotation></semantics></math>. Let us translate <math id="S5.p29.m7" class="ltx_Math" alttext="\sqrt{a}T\times_{L}\sqrt{a}Q" display="inline" intent=":literal"><semantics><mrow><mrow><msqrt><mi>a</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mrow><msqrt><mi>a</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow></mrow><annotation encoding="application/x-tex">\sqrt{a}T\times_{L}\sqrt{a}Q</annotation></semantics></math> such that it is contained in the interior of <math id="S5.p29.m8" class="ltx_Math" alttext="T\times_{L}Q" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mi>Q</mi></mrow><annotation encoding="application/x-tex">T\times_{L}Q</annotation></semantics></math>. Then the above embedding construction yields an embedding of <math id="S5.p29.m9" class="ltx_Math" alttext="B^{4}(a)" display="inline" intent=":literal"><semantics><mrow><msup><mi>B</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B^{4}(a)</annotation></semantics></math> into the interior of <math id="S5.p29.m10" class="ltx_Math" alttext="T\times_{L}Q" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mi>Q</mi></mrow><annotation encoding="application/x-tex">T\times_{L}Q</annotation></semantics></math> which approximates <math id="S5.p29.m11" class="ltx_Math" alttext="\sqrt{a}T\times_{L}\sqrt{a}Q" display="inline" intent=":literal"><semantics><mrow><mrow><msqrt><mi>a</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mrow><msqrt><mi>a</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow></mrow><annotation encoding="application/x-tex">\sqrt{a}T\times_{L}\sqrt{a}Q</annotation></semantics></math> arbitrarily well and has the property that generalized Reeb orbits on <math id="S5.p29.m12" class="ltx_Math" alttext="\sqrt{a}T\times_{L}\sqrt{a}Q" display="inline" intent=":literal"><semantics><mrow><mrow><msqrt><mi>a</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mrow><msqrt><mi>a</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow></mrow><annotation encoding="application/x-tex">\sqrt{a}T\times_{L}\sqrt{a}Q</annotation></semantics></math> away from the Lagrangian <math id="S5.p29.m13" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-strata are approximated by images of Hopf circles.</span></p>
</div>
<div id="S5.p30" class="ltx_para">
<p id="S5.p30.1" class="ltx_p"><span id="S5.p30.1.1" class="ltx_text">Inside the boundary of <math id="S5.p30.m1" class="ltx_Math" alttext="\sqrt{a}T\times_{L}\sqrt{a}Q" display="inline" intent=":literal"><semantics><mrow><mrow><msqrt><mi>a</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mrow><msqrt><mi>a</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow></mrow><annotation encoding="application/x-tex">\sqrt{a}T\times_{L}\sqrt{a}Q</annotation></semantics></math> we have a collection <math id="S5.p30.m2" class="ltx_Math" alttext="\tilde{E}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>E</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{E}</annotation></semantics></math> of four disks of area <math id="S5.p30.m3" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> each which is constructed in the same way as <math id="S5.p30.m4" class="ltx_Math" alttext="\tilde{D}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>D</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{D}</annotation></semantics></math>. The disks <math id="S5.p30.m5" class="ltx_Math" alttext="\tilde{E}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>E</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{E}</annotation></semantics></math> can be constructed in such a way that it is possible to insert four copies of the ribbon <math id="S5.p30.m6" class="ltx_Math" alttext="R(c)" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R(c)</annotation></semantics></math> in the complement of <math id="S5.p30.m7" class="ltx_Math" alttext="\sqrt{a}T\times_{L}\sqrt{a}Q" display="inline" intent=":literal"><semantics><mrow><mrow><msqrt><mi>a</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mrow><msqrt><mi>a</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow></mrow><annotation encoding="application/x-tex">\sqrt{a}T\times_{L}\sqrt{a}Q</annotation></semantics></math> connecting the components of <math id="S5.p30.m8" class="ltx_Math" alttext="\tilde{E}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>E</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{E}</annotation></semantics></math> to the corresponding components of <math id="S5.p30.m9" class="ltx_Math" alttext="\tilde{D}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>D</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{D}</annotation></semantics></math>. Since the image of <math id="S5.p30.m10" class="ltx_Math" alttext="B^{4}(a)" display="inline" intent=":literal"><semantics><mrow><msup><mi>B</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B^{4}(a)</annotation></semantics></math> under our symplectic embedding approximates <math id="S5.p30.m11" class="ltx_Math" alttext="\sqrt{a}T\times_{L}\sqrt{a}Q" display="inline" intent=":literal"><semantics><mrow><mrow><msqrt><mi>a</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mrow><msqrt><mi>a</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow></mrow><annotation encoding="application/x-tex">\sqrt{a}T\times_{L}\sqrt{a}Q</annotation></semantics></math> arbitrarily well and generalized Reeb orbits on the boundary of <math id="S5.p30.m12" class="ltx_Math" alttext="\sqrt{a}T\times_{L}\sqrt{a}Q" display="inline" intent=":literal"><semantics><mrow><mrow><msqrt><mi>a</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mrow><msqrt><mi>a</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow></mrow><annotation encoding="application/x-tex">\sqrt{a}T\times_{L}\sqrt{a}Q</annotation></semantics></math> which intersect <math id="S5.p30.m13" class="ltx_Math" alttext="\tilde{E}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>E</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{E}</annotation></semantics></math> are approximated by images of Hopf circles, we can modify the four ribbons in such a way that they connect the components of <math id="S5.p30.m14" class="ltx_Math" alttext="\tilde{D}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>D</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{D}</annotation></semantics></math> to the boundary of the image of <math id="S5.p30.m15" class="ltx_Math" alttext="B^{4}(a)" display="inline" intent=":literal"><semantics><mrow><msup><mi>B</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B^{4}(a)</annotation></semantics></math> and give rise to the desired embedding of <math id="S5.p30.m16" class="ltx_Math" alttext="B(a;c,4)" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>c</mi><mo>,</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B(a;c,4)</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S5.10" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Proposition <a href="#S5.Thmtheorem8" title="Proposition 5.8. ‣ 5. Symplectic ribbon complexes ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.8</span></a> in the case <math id="S5.m2" class="ltx_Math" alttext="n\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">n\geq 2</annotation></semantics></math>.</h6>
<div id="S5.p31" class="ltx_para">
<p id="S5.p31.1" class="ltx_p"><span id="S5.p31.1.1" class="ltx_text">We assume that <math id="S5.p31.m1" class="ltx_Math" alttext="B=B^{4}(1)" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><mrow><msup><mi>B</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">B=B^{4}(1)</annotation></semantics></math>. For simplicity, let us first treat the case <math id="S5.p31.m2" class="ltx_Math" alttext="n=2" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">n=2</annotation></semantics></math>. The ball <math id="S5.p31.m3" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> admits a full packing by four copies of <math id="S5.p31.m4" class="ltx_Math" alttext="B^{4}(1/2)" display="inline" intent=":literal"><semantics><mrow><msup><mi>B</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B^{4}(1/2)</annotation></semantics></math>. Such a packing can be seen explicitly as follows. As mentioned above, the interior of <math id="S5.p31.m5" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> is symplectomorphic to the interior of the Lagrangian product <math id="S5.p31.m6" class="ltx_Math" alttext="T\times_{L}Q" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mi>Q</mi></mrow><annotation encoding="application/x-tex">T\times_{L}Q</annotation></semantics></math>. We divide <math id="S5.p31.m7" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> into four triangles <math id="S5.p31.m8" class="ltx_Math" alttext="T_{0},T_{1},T_{2},T_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>0</mn></msub><mo>,</mo><msub><mi>T</mi><mn>1</mn></msub><mo>,</mo><msub><mi>T</mi><mn>2</mn></msub><mo>,</mo><msub><mi>T</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">T_{0},T_{1},T_{2},T_{3}</annotation></semantics></math> as indicated in Figure <a href="#S5.F4" title="Figure 5.4 ‣ Proof of Proposition in the case n≥2. ‣ 5. Symplectic ribbon complexes ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.4</span></a>. This induces a decomposition of <math id="S5.p31.m9" class="ltx_Math" alttext="T\times_{L}Q" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mi>Q</mi></mrow><annotation encoding="application/x-tex">T\times_{L}Q</annotation></semantics></math> into four pieces <math id="S5.p31.m10" class="ltx_Math" alttext="T_{j}\times_{L}Q" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>j</mi></msub><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mi>Q</mi></mrow><annotation encoding="application/x-tex">T_{j}\times_{L}Q</annotation></semantics></math>, the interior of each of which is symplectomorphic to the interior of <math id="S5.p31.m11" class="ltx_Math" alttext="B^{4}(1/2)" display="inline" intent=":literal"><semantics><mrow><msup><mi>B</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B^{4}(1/2)</annotation></semantics></math>.</span></p>
</div>
<figure id="S5.F4" class="ltx_figure"><span id="S5.F4.pic1" class="ltx_picture ltx_centering" style="width:1.0pt;height:1.0pt;"><svg xmlns="http://www.w3.org/2000/svg" version="1.1" width="1.33" height="1.33" overflow="visible"><g transform="translate(0,1.33) scale(1,-1)"><g transform="translate(0,0)"><g transform="translate(0,137.48) scale(1,-1)"><foreignObject width="137.48" height="137.48" overflow="visible"><object type="image/svg+xml" data="2509.15390v1/x12.svg" id="S5.F4.pic1.g1" class="ltx_graphics ltx_img_square" width="143" height="143" aria-label="Refer to caption"></object></foreignObject></g></g><g transform="translate(0.52,0.49)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="20.72" height="11.16" overflow="visible"><Math mode="inline" tex="T_{0}" text="T _ 0" xml:id="S5.F4.pic1.m1">
                        <XMath xml:id="S5.F4.pic1.m1.1">
                          <XMApp xml:id="S5.F4.pic1.m1.1.1">
                            <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                            <XMTok font="italic" role="UNKNOWN">T</XMTok>
                            <XMTok fontsize="70%" meaning="0" role="NUMBER">0</XMTok>
                          </XMApp>
                        </XMath>
                      </Math></foreignObject></g></g><g transform="translate(0.87,0.26)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="24.44" height="11.16" overflow="visible"><Math mode="inline" tex="T_{1}" text="T _ 1" xml:id="S5.F4.pic1.m2">
                        <XMath xml:id="S5.F4.pic1.m2.1">
                          <XMApp xml:id="S5.F4.pic1.m2.1.1">
                            <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                            <XMTok font="italic" role="UNKNOWN">T</XMTok>
                            <XMTok fontsize="70%" meaning="1" role="NUMBER">1</XMTok>
                          </XMApp>
                        </XMath>
                      </Math></foreignObject></g></g><g transform="translate(0.29,0.26)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="24.44" height="11.16" overflow="visible"><Math mode="inline" tex="T_{3}" text="T _ 3" xml:id="S5.F4.pic1.m3">
                        <XMath xml:id="S5.F4.pic1.m3.1">
                          <XMApp xml:id="S5.F4.pic1.m3.1.1">
                            <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                            <XMTok font="italic" role="UNKNOWN">T</XMTok>
                            <XMTok fontsize="70%" meaning="3" role="NUMBER">3</XMTok>
                          </XMApp>
                        </XMath>
                      </Math></foreignObject></g></g><g transform="translate(0.29,0.84)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="24.44" height="11.16" overflow="visible"><Math mode="inline" tex="T_{2}" text="T _ 2" xml:id="S5.F4.pic1.m4">
                        <XMath xml:id="S5.F4.pic1.m4.1">
                          <XMApp xml:id="S5.F4.pic1.m4.1.1">
                            <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                            <XMTok font="italic" role="UNKNOWN">T</XMTok>
                            <XMTok fontsize="70%" meaning="2" role="NUMBER">2</XMTok>
                          </XMApp>
                        </XMath>
                      </Math></foreignObject></g></g><g transform="translate(0,0)"><g transform="translate(0,137.48) scale(1,-1)"><foreignObject width="137.48" height="137.48" overflow="visible"><object type="image/svg+xml" data="2509.15390v1/x13.svg" id="S5.F4.pic1.g2" class="ltx_graphics ltx_img_square" width="143" height="143" aria-label="Refer to caption"></object></foreignObject></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 5.4. </span>Division of <math id="S5.F4.m3" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> into four triangles <math id="S5.F4.m4" class="ltx_Math" alttext="T_{j}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>j</mi></msub><annotation encoding="application/x-tex">T_{j}</annotation></semantics></math>.</figcaption>
</figure>
<div id="S5.p32" class="ltx_para">
<p id="S5.p32.1" class="ltx_p"><span id="S5.p32.1.1" class="ltx_text">Recall that we introduced, for every <math id="S5.p32.m1" class="ltx_Math" alttext="0&lt;\gamma&lt;1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mi>γ</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0&lt;\gamma&lt;1</annotation></semantics></math>, a subset <math id="S5.p32.m2" class="ltx_Math" alttext="\tilde{D}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>D</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{D}</annotation></semantics></math> of the boundary of <math id="S5.p32.m3" class="ltx_Math" alttext="T\times_{L}Q" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mi>Q</mi></mrow><annotation encoding="application/x-tex">T\times_{L}Q</annotation></semantics></math> consisting of four disks of symplectic area <math id="S5.p32.m4" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> each. The same construction yields, for every <math id="S5.p32.m5" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> and every <math id="S5.p32.m6" class="ltx_Math" alttext="0&lt;\gamma&lt;1/2" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mi>γ</mi><mo>&lt;</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">0&lt;\gamma&lt;1/2</annotation></semantics></math>, a subset <math id="S5.p32.m7" class="ltx_Math" alttext="\tilde{D}_{j}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>D</mi><mo>~</mo></mover><mi>j</mi></msub><annotation encoding="application/x-tex">\tilde{D}_{j}</annotation></semantics></math> of the boundary of <math id="S5.p32.m8" class="ltx_Math" alttext="T_{j}\times_{L}Q" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>j</mi></msub><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mi>Q</mi></mrow><annotation encoding="application/x-tex">T_{j}\times_{L}Q</annotation></semantics></math> consisting of four disks of area <math id="S5.p32.m9" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> each. These disks can be arranged such that, for <math id="S5.p32.m10" class="ltx_Math" alttext="1\leq j\leq 3" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>j</mi><mo>≤</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">1\leq j\leq 3</annotation></semantics></math>, we have</span></p>
<table id="S5.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex12.m1" class="ltx_Math" alttext="\tilde{D}_{0}\cap((T_{0}\cap T_{j})\times_{L}Q)=\tilde{D}_{j}\cap((T_{0}\cap T_{j})\times_{L}Q)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>D</mi><mo>~</mo></mover><mn>0</mn></msub><mo>∩</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mn>0</mn></msub><mo>∩</mo><msub><mi>T</mi><mi>j</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><msub><mo rspace="0.222em">×</mo><mi>L</mi></msub><mi>Q</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mover accent="true"><mi>D</mi><mo>~</mo></mover><mi>j</mi></msub><mo>∩</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mn>0</mn></msub><mo>∩</mo><msub><mi>T</mi><mi>j</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><msub><mo rspace="0.222em">×</mo><mi>L</mi></msub><mi>Q</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\tilde{D}_{0}\cap((T_{0}\cap T_{j})\times_{L}Q)=\tilde{D}_{j}\cap((T_{0}\cap T_{j})\times_{L}Q),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p32.2" class="ltx_p"><span id="S5.p32.2.1" class="ltx_text">i.e. the components of <math id="S5.p32.m11" class="ltx_Math" alttext="\tilde{D}_{0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>D</mi><mo>~</mo></mover><mn>0</mn></msub><annotation encoding="application/x-tex">\tilde{D}_{0}</annotation></semantics></math> and <math id="S5.p32.m12" class="ltx_Math" alttext="\tilde{D}_{j}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>D</mi><mo>~</mo></mover><mi>j</mi></msub><annotation encoding="application/x-tex">\tilde{D}_{j}</annotation></semantics></math> match at the interface between <math id="S5.p32.m13" class="ltx_Math" alttext="T_{0}\times_{L}Q" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>0</mn></msub><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mi>Q</mi></mrow><annotation encoding="application/x-tex">T_{0}\times_{L}Q</annotation></semantics></math> and <math id="S5.p32.m14" class="ltx_Math" alttext="T_{j}\times_{L}Q" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>j</mi></msub><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mi>Q</mi></mrow><annotation encoding="application/x-tex">T_{j}\times_{L}Q</annotation></semantics></math>.</span></p>
</div>
<div id="S5.p33" class="ltx_para">
<p id="S5.p33.1" class="ltx_p"><span id="S5.p33.1.1" class="ltx_text">Let <math id="S5.p33.m1" class="ltx_Math" alttext="b&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">b&gt;0</annotation></semantics></math> be a small positive number. If necessary, we will further shrink <math id="S5.p33.m2" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math> over the course of the proof. Let <math id="S5.p33.m3" class="ltx_Math" alttext="0&lt;c&lt;b" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mi>c</mi><mo>&lt;</mo><mi>b</mi></mrow><annotation encoding="application/x-tex">0&lt;c&lt;b</annotation></semantics></math> be arbitrary and let <math id="S5.p33.m4" class="ltx_Math" alttext="a&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a&gt;0</annotation></semantics></math> be such that <math id="S5.p33.m5" class="ltx_Math" alttext="\operatorname{vol}(E(a,b))&lt;\operatorname{vol}(B)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>vol</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mi>vol</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\operatorname{vol}(E(a,b))&lt;\operatorname{vol}(B)</annotation></semantics></math>. Our goal is to construct a symplectic embedding <math id="S5.p33.m6" class="ltx_Math" alttext="E(a,b;c,2)\overset{s}{\hookrightarrow}B" display="inline" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mi>c</mi><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo stretchy="false">↪</mo><mo mathsize="0.700em">𝑠</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">E(a,b;c,2)\overset{s}{\hookrightarrow}B</annotation></semantics></math> mapping the two free ends into the boundary <math id="S5.p33.m7" class="ltx_Math" alttext="\partial B" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">\partial B</annotation></semantics></math> such that the resulting collection of two disk embeddings is free.</span></p>
</div>
<div id="S5.p34" class="ltx_para">
<p id="S5.p34.1" class="ltx_p"><span id="S5.p34.1.1" class="ltx_text">If <math id="S5.p34.m1" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math> is sufficiently small, we may pick positive numbers <math id="S5.p34.m2" class="ltx_Math" alttext="0&lt;\gamma&lt;\alpha" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mi>γ</mi><mo>&lt;</mo><mi>α</mi></mrow><annotation encoding="application/x-tex">0&lt;\gamma&lt;\alpha</annotation></semantics></math> such that <math id="S5.p34.m3" class="ltx_Math" alttext="\operatorname{vol}(E(a,b))&lt;4\operatorname{vol}(B^{4}(\alpha))&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>vol</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mn>4</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>vol</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>B</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\operatorname{vol}(E(a,b))&lt;4\operatorname{vol}(B^{4}(\alpha))&lt;1</annotation></semantics></math> and <math id="S5.p34.m4" class="ltx_Math" alttext="\gamma&gt;b" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>&gt;</mo><mi>b</mi></mrow><annotation encoding="application/x-tex">\gamma&gt;b</annotation></semantics></math>. For <math id="S5.p34.m5" class="ltx_Math" alttext="0\leq j\leq 3" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mi>j</mi><mo>≤</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">0\leq j\leq 3</annotation></semantics></math>, let <math id="S5.p34.m6" class="ltx_Math" alttext="\tilde{D}_{j}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>D</mi><mo>~</mo></mover><mi>j</mi></msub><annotation encoding="application/x-tex">\tilde{D}_{j}</annotation></semantics></math> be the subset of the boundary of <math id="S5.p34.m7" class="ltx_Math" alttext="T_{j}\times_{L}Q" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>j</mi></msub><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mi>Q</mi></mrow><annotation encoding="application/x-tex">T_{j}\times_{L}Q</annotation></semantics></math> mentioned above consisting of four disks of area <math id="S5.p34.m8" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> each. By Lemma <a href="#S5.Thmtheorem12" title="Lemma 5.12. ‣ 5. Symplectic ribbon complexes ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.12</span></a>, we may embed, for each <math id="S5.p34.m9" class="ltx_Math" alttext="0\leq j\leq 3" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mi>j</mi><mo>≤</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">0\leq j\leq 3</annotation></semantics></math>, a copy <math id="S5.p34.m10" class="ltx_Math" alttext="L_{j}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>j</mi></msub><annotation encoding="application/x-tex">L_{j}</annotation></semantics></math> of <math id="S5.p34.m11" class="ltx_Math" alttext="B^{4}(\alpha;\gamma,4)" display="inline" intent=":literal"><semantics><mrow><msup><mi>B</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo>,</mo><mi>γ</mi><mo>,</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B^{4}(\alpha;\gamma,4)</annotation></semantics></math> into <math id="S5.p34.m12" class="ltx_Math" alttext="T_{j}\times_{L}Q" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>j</mi></msub><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mi>Q</mi></mrow><annotation encoding="application/x-tex">T_{j}\times_{L}Q</annotation></semantics></math> such that the four free ends of <math id="S5.p34.m13" class="ltx_Math" alttext="L_{j}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>j</mi></msub><annotation encoding="application/x-tex">L_{j}</annotation></semantics></math> are mapped to the four disk components of <math id="S5.p34.m14" class="ltx_Math" alttext="\tilde{D}_{j}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>D</mi><mo>~</mo></mover><mi>j</mi></msub><annotation encoding="application/x-tex">\tilde{D}_{j}</annotation></semantics></math>. Note that <math id="S5.p34.m15" class="ltx_Math" alttext="L_{0}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mn>0</mn></msub><annotation encoding="application/x-tex">L_{0}</annotation></semantics></math> and <math id="S5.p34.m16" class="ltx_Math" alttext="L_{j}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>j</mi></msub><annotation encoding="application/x-tex">L_{j}</annotation></semantics></math> have one matching pair of free ends if <math id="S5.p34.m17" class="ltx_Math" alttext="j\in\left\{1,2\right\}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo>{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">j\in\left\{1,2\right\}</annotation></semantics></math> and two matching pairs of free ends if <math id="S5.p34.m18" class="ltx_Math" alttext="j=3" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">j=3</annotation></semantics></math>. We build a ribbon complex <math id="S5.p34.m19" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> embedded in <math id="S5.p34.m20" class="ltx_Math" alttext="T\times_{L}Q" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mi>Q</mi></mrow><annotation encoding="application/x-tex">T\times_{L}Q</annotation></semantics></math> by taking the union <math id="S5.p34.m21" class="ltx_Math" alttext="\bigcup_{j}L_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mo>⋃</mo><mi>j</mi></msub><msub><mi>L</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">\bigcup_{j}L_{j}</annotation></semantics></math> and gluing all matching pairs of free ends.</span></p>
</div>
<div id="S5.p35" class="ltx_para">
<p id="S5.p35.1" class="ltx_p"><span id="S5.p35.1.1" class="ltx_text">By Lemma <a href="#S5.Thmtheorem11" title="Lemma 5.11. ‣ 5. Symplectic ribbon complexes ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.11</span></a>, after possibly shrinking <math id="S5.p35.m1" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math>, we can find <math id="S5.p35.m2" class="ltx_Math" alttext="f&gt;b" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>&gt;</mo><mi>b</mi></mrow><annotation encoding="application/x-tex">f&gt;b</annotation></semantics></math> and a symplectic embedding <math id="S5.p35.m3" class="ltx_Math" alttext="E(a/4,f;b,4)\overset{s}{\hookrightarrow}B^{4}(\alpha)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>/</mo><mn>4</mn></mrow><mo>,</mo><mi>f</mi><mo>,</mo><mi>b</mi><mo>,</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo stretchy="false">↪</mo><mo mathsize="0.700em">𝑠</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">E(a/4,f;b,4)\overset{s}{\hookrightarrow}B^{4}(\alpha)</annotation></semantics></math> which maps the <math id="S5.p35.m4" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>-th free end of <math id="S5.p35.m5" class="ltx_Math" alttext="E(a/4,f;b,4)" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>/</mo><mn>4</mn></mrow><mo>,</mo><mi>f</mi><mo>,</mo><mi>b</mi><mo>,</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">E(a/4,f;b,4)</annotation></semantics></math> into the image of the map <math id="S5.p35.m6" class="ltx_Math" alttext="\iota(2\pi j/4):B^{2}(\gamma)\rightarrow\partial B^{4}(\alpha)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ι</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>/</mo><mn>4</mn></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mrow><msup><mi>B</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em" stretchy="false">→</mo><mrow><mo>∂</mo><mrow><msup><mi>B</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\iota(2\pi j/4):B^{2}(\gamma)\rightarrow\partial B^{4}(\alpha)</annotation></semantics></math> for <math id="S5.p35.m7" class="ltx_Math" alttext="0\leq j\leq 3" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mi>j</mi><mo>≤</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">0\leq j\leq 3</annotation></semantics></math>. This implies that we can also embed <math id="S5.p35.m8" class="ltx_Math" alttext="E(a/4,f;b,4)" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>/</mo><mn>4</mn></mrow><mo>,</mo><mi>f</mi><mo>,</mo><mi>b</mi><mo>,</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">E(a/4,f;b,4)</annotation></semantics></math> into <math id="S5.p35.m9" class="ltx_Math" alttext="B^{4}(\alpha;\gamma,4)" display="inline" intent=":literal"><semantics><mrow><msup><mi>B</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo>,</mo><mi>γ</mi><mo>,</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B^{4}(\alpha;\gamma,4)</annotation></semantics></math> in such a way that the four free ends of <math id="S5.p35.m10" class="ltx_Math" alttext="E(a/4,f;b,4)" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>/</mo><mn>4</mn></mrow><mo>,</mo><mi>f</mi><mo>,</mo><mi>b</mi><mo>,</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">E(a/4,f;b,4)</annotation></semantics></math> are contained in the four free ends of <math id="S5.p35.m11" class="ltx_Math" alttext="B^{4}(\alpha;\gamma,4)" display="inline" intent=":literal"><semantics><mrow><msup><mi>B</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo>,</mo><mi>γ</mi><mo>,</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B^{4}(\alpha;\gamma,4)</annotation></semantics></math>: simply elongate each ribbon of <math id="S5.p35.m12" class="ltx_Math" alttext="E(a/4,f;b,4)" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>/</mo><mn>4</mn></mrow><mo>,</mo><mi>f</mi><mo>,</mo><mi>b</mi><mo>,</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">E(a/4,f;b,4)</annotation></semantics></math> by attaching an appropriate ribbon which is contained in the corresponding ribbon of <math id="S5.p35.m13" class="ltx_Math" alttext="B^{4}(\alpha;\gamma,4)" display="inline" intent=":literal"><semantics><mrow><msup><mi>B</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo>,</mo><mi>γ</mi><mo>,</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B^{4}(\alpha;\gamma,4)</annotation></semantics></math>. Take a copy <math id="S5.p35.m14" class="ltx_Math" alttext="K_{0}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mn>0</mn></msub><annotation encoding="application/x-tex">K_{0}</annotation></semantics></math> of <math id="S5.p35.m15" class="ltx_Math" alttext="E(a/4,f;b,4)" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>/</mo><mn>4</mn></mrow><mo>,</mo><mi>f</mi><mo>,</mo><mi>b</mi><mo>,</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">E(a/4,f;b,4)</annotation></semantics></math>. By the above discussion, we can embed it into the complex <math id="S5.p35.m16" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> in such a way that the ellipsoid part of <math id="S5.p35.m17" class="ltx_Math" alttext="K_{0}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mn>0</mn></msub><annotation encoding="application/x-tex">K_{0}</annotation></semantics></math> is mapped into the ball component of <math id="S5.p35.m18" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> contained in <math id="S5.p35.m19" class="ltx_Math" alttext="T_{0}\times_{L}Q" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>0</mn></msub><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mi>Q</mi></mrow><annotation encoding="application/x-tex">T_{0}\times_{L}Q</annotation></semantics></math> and the four free ribbon ends are mapped to the boundaries of the three remaining ball components of <math id="S5.p35.m20" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>. Two free ends of <math id="S5.p35.m21" class="ltx_Math" alttext="K_{0}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mn>0</mn></msub><annotation encoding="application/x-tex">K_{0}</annotation></semantics></math> are mapped to the boundry of the ball component of <math id="S5.p35.m22" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> inside <math id="S5.p35.m23" class="ltx_Math" alttext="T_{3}\times_{L}Q" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>3</mn></msub><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mi>Q</mi></mrow><annotation encoding="application/x-tex">T_{3}\times_{L}Q</annotation></semantics></math> and one free end is mapped to the boundary of the ball component inside <math id="S5.p35.m24" class="ltx_Math" alttext="T_{j}\times_{L}Q" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>j</mi></msub><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mi>Q</mi></mrow><annotation encoding="application/x-tex">T_{j}\times_{L}Q</annotation></semantics></math> for <math id="S5.p35.m25" class="ltx_Math" alttext="j\in\left\{1,2\right\}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo>{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">j\in\left\{1,2\right\}</annotation></semantics></math>. We pick one of the two ribbons of <math id="S5.p35.m26" class="ltx_Math" alttext="K_{0}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mn>0</mn></msub><annotation encoding="application/x-tex">K_{0}</annotation></semantics></math> whose end is contained in the ball component of <math id="S5.p35.m27" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> inside <math id="S5.p35.m28" class="ltx_Math" alttext="T_{3}\times_{L}Q" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>3</mn></msub><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mi>Q</mi></mrow><annotation encoding="application/x-tex">T_{3}\times_{L}Q</annotation></semantics></math> and delete it. The resulting ribbon complex is still denoted by the same symbol <math id="S5.p35.m29" class="ltx_Math" alttext="K_{0}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mn>0</mn></msub><annotation encoding="application/x-tex">K_{0}</annotation></semantics></math>.</span></p>
</div>
<div id="S5.p36" class="ltx_para">
<p id="S5.p36.1" class="ltx_p"><span id="S5.p36.1.1" class="ltx_text">By the case <math id="S5.p36.m1" class="ltx_Math" alttext="n=1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n=1</annotation></semantics></math> of Proposition <a href="#S5.Thmtheorem8" title="Proposition 5.8. ‣ 5. Symplectic ribbon complexes ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.8</span></a>, we may take a copy <math id="S5.p36.m2" class="ltx_Math" alttext="K_{3}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mn>3</mn></msub><annotation encoding="application/x-tex">K_{3}</annotation></semantics></math> of <math id="S5.p36.m3" class="ltx_Math" alttext="E(a/4,f;b,1)" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>/</mo><mn>4</mn></mrow><mo>,</mo><mi>f</mi><mo>,</mo><mi>b</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">E(a/4,f;b,1)</annotation></semantics></math> and embed it into the ball component of <math id="S5.p36.m4" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> contained in <math id="S5.p36.m5" class="ltx_Math" alttext="T_{3}\times_{L}Q" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>3</mn></msub><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mi>Q</mi></mrow><annotation encoding="application/x-tex">T_{3}\times_{L}Q</annotation></semantics></math> in such a way that the free end of <math id="S5.p36.m6" class="ltx_Math" alttext="K_{3}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mn>3</mn></msub><annotation encoding="application/x-tex">K_{3}</annotation></semantics></math> is mapped to the boundary of this ball component via exactly the same map as one the the three free ends of <math id="S5.p36.m7" class="ltx_Math" alttext="K_{0}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mn>0</mn></msub><annotation encoding="application/x-tex">K_{0}</annotation></semantics></math>. Similarly, by Lemma <a href="#S5.Thmtheorem11" title="Lemma 5.11. ‣ 5. Symplectic ribbon complexes ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.11</span></a>, we may take a copy <math id="S5.p36.m8" class="ltx_Math" alttext="K_{j}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>j</mi></msub><annotation encoding="application/x-tex">K_{j}</annotation></semantics></math> of <math id="S5.p36.m9" class="ltx_Math" alttext="E(a/4,f;b,2)" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>/</mo><mn>4</mn></mrow><mo>,</mo><mi>f</mi><mo>,</mo><mi>b</mi><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">E(a/4,f;b,2)</annotation></semantics></math> for <math id="S5.p36.m10" class="ltx_Math" alttext="j\in\left\{1,2\right\}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo>{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">j\in\left\{1,2\right\}</annotation></semantics></math> and embed it into the ball component of <math id="S5.p36.m11" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> contained in <math id="S5.p36.m12" class="ltx_Math" alttext="T_{j}\times_{L}Q" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>j</mi></msub><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mi>Q</mi></mrow><annotation encoding="application/x-tex">T_{j}\times_{L}Q</annotation></semantics></math> in such a way that one of the two free ends of <math id="S5.p36.m13" class="ltx_Math" alttext="K_{j}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>j</mi></msub><annotation encoding="application/x-tex">K_{j}</annotation></semantics></math> is mapped to the boundary of the ball component via exactly the same map as one of the free ends of <math id="S5.p36.m14" class="ltx_Math" alttext="K_{0}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mn>0</mn></msub><annotation encoding="application/x-tex">K_{0}</annotation></semantics></math> and the image of the other free end of <math id="S5.p36.m15" class="ltx_Math" alttext="K_{j}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>j</mi></msub><annotation encoding="application/x-tex">K_{j}</annotation></semantics></math> is contained in the attaching region of one of the the ribbons of <math id="S5.p36.m16" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> connecting to the diagonal part of the boundary of <math id="S5.p36.m17" class="ltx_Math" alttext="T_{j}\times_{L}Q" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>j</mi></msub><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mi>Q</mi></mrow><annotation encoding="application/x-tex">T_{j}\times_{L}Q</annotation></semantics></math>. We elongate the latter ribbon of <math id="S5.p36.m18" class="ltx_Math" alttext="K_{j}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>j</mi></msub><annotation encoding="application/x-tex">K_{j}</annotation></semantics></math> inside the ribbon of <math id="S5.p36.m19" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> such that its free end is mapped to the boundary of <math id="S5.p36.m20" class="ltx_Math" alttext="T_{j}\times_{L}Q" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>j</mi></msub><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mi>Q</mi></mrow><annotation encoding="application/x-tex">T_{j}\times_{L}Q</annotation></semantics></math>.</span></p>
</div>
<div id="S5.p37" class="ltx_para">
<p id="S5.p37.1" class="ltx_p"><span id="S5.p37.1.1" class="ltx_text">We form a ribbon complex <math id="S5.p37.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> by taking the union <math id="S5.p37.m2" class="ltx_Math" alttext="\bigcup_{j}K_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mo>⋃</mo><mi>j</mi></msub><msub><mi>K</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">\bigcup_{j}K_{j}</annotation></semantics></math> and gluing all matching pairs of free ends. See Figure <a href="#S5.F5" title="Figure 5.5 ‣ Proof of Proposition in the case n≥2. ‣ 5. Symplectic ribbon complexes ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.5</span></a> for a schematic of <math id="S5.p37.m3" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> and <math id="S5.p37.m4" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>. The resulting complex <math id="S5.p37.m5" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> is symplectomorphic to the complex <math id="S5.p37.m6" class="ltx_Math" alttext="K(G,A,f,b)" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>A</mi><mo>,</mo><mi>f</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K(G,A,f,b)</annotation></semantics></math> constructed in Example <a href="#S5.Thmtheorem2" title="Example 5.2. ‣ 5. Symplectic ribbon complexes ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.2</span></a> where <math id="S5.p37.m7" class="ltx_Math" alttext="(G,A)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(G,A)</annotation></semantics></math> is the labelled ribbon graph displayed in Figure <a href="#S5.F6" title="Figure 5.6 ‣ Proof of Proposition in the case n≥2. ‣ 5. Symplectic ribbon complexes ‣ Packing stability and the subleading asymptotics of symplectic Weyl laws" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.6</span></a>.</span></p>
</div>
<figure id="S5.F5" class="ltx_figure"><span id="S5.F5.pic1" class="ltx_picture ltx_centering" style="width:1.0pt;height:0.97272727pt;"><svg xmlns="http://www.w3.org/2000/svg" version="1.1" width="1.33" height="1.29" overflow="visible"><g transform="translate(0,1.29) scale(1,-1)"><g transform="translate(0,0)"><g transform="translate(0,178.26) scale(1,-1)"><foreignObject width="183.31" height="178.26" overflow="visible"><object type="image/svg+xml" data="2509.15390v1/x14.svg" id="S5.F5.pic1.g1" class="ltx_graphics ltx_img_square" width="191" height="185" aria-label="Refer to caption"></object></foreignObject></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 5.5. </span>A schematic of the ribbon complexes <math id="S5.F5.m4" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> (blue) and <math id="S5.F5.m5" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> (green) embedded in <math id="S5.F5.m6" class="ltx_Math" alttext="T\times_{L}Q" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></msub><mi>Q</mi></mrow><annotation encoding="application/x-tex">T\times_{L}Q</annotation></semantics></math>.</figcaption>
</figure>
<figure id="S5.F6" class="ltx_figure"><span id="S5.F6.pic1" class="ltx_picture ltx_centering" style="width:1.0pt;height:0.86666667pt;"><svg xmlns="http://www.w3.org/2000/svg" version="1.1" width="1.33" height="1.15" overflow="visible"><g transform="translate(0,1.15) scale(1,-1)"><g transform="translate(0,0)"><g transform="translate(0,79.44) scale(1,-1)"><foreignObject width="91.66" height="79.44" overflow="visible"><object type="image/svg+xml" data="2509.15390v1/x15.svg" id="S5.F6.pic1.g1" class="ltx_graphics ltx_img_square" width="96" height="83" aria-label="Refer to caption"></object></foreignObject></g></g><g transform="translate(0.95,0.22)"><g transform="translate(0,15.94) scale(1,-1)"><foreignObject width="16.21" height="11.16" overflow="visible"><Math mode="inline" tex="\frac{a}{4}" text="a / 4" xml:id="S5.F6.pic1.m1">
