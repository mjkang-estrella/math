                    </XMApp>
                  </XMath>
                </Math></foreignObject></g></g><g transform="translate(232.9,-331.7)"><g transform="translate(0,11.16) scale(1,-1)"><foreignObject width="28.43" height="9.17" overflow="visible"><Math mode="inline" tex="D_{3}" text="D _ 3" xml:id="S5.F3.pic2.m9">
                  <XMath xml:id="S5.F3.pic2.m9.1">
                    <XMApp xml:id="S5.F3.pic2.m9.1.1">
                      <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                      <XMTok font="italic" role="UNKNOWN">D</XMTok>
                      <XMTok fontsize="70%" meaning="3" role="NUMBER">3</XMTok>
                    </XMApp>
                  </XMath>
                </Math></foreignObject></g></g><g transform="translate(59.8,-385.25)"><g transform="translate(0,13.02) scale(1,-1)"><foreignObject width="36.66" height="9.17" overflow="visible"><Math mode="inline" tex="D_{1,2}" text="D _ (list@(1, 2))" xml:id="S5.F3.pic2.m10">
                  <XMath xml:id="S5.F3.pic2.m10.3">
                    <XMApp xml:id="S5.F3.pic2.m10.3.1">
                      <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                      <XMTok font="italic" role="UNKNOWN">D</XMTok>
                      <XMDual xml:id="S5.F3.pic2.m10.3.1.3">
                        <XMApp xml:id="S5.F3.pic2.m10.3.1.3.1">
                          <XMTok meaning="list"/>
                          <XMRef idref="S5.F3.pic2.m10.1" xml:id="S5.F3.pic2.m10.3.1.3.1.2"/>
                          <XMRef idref="S5.F3.pic2.m10.2" xml:id="S5.F3.pic2.m10.3.1.3.1.3"/>
                        </XMApp>
                        <XMWrap xml:id="S5.F3.pic2.m10.3.1.3.2">
                          <XMTok fontsize="70%" meaning="1" role="NUMBER" xml:id="S5.F3.pic2.m10.1">1</XMTok>
                          <XMTok fontsize="70%" role="PUNCT">,</XMTok>
                          <XMTok fontsize="70%" meaning="2" role="NUMBER" xml:id="S5.F3.pic2.m10.2">2</XMTok>
                        </XMWrap>
                      </XMDual>
                    </XMApp>
                  </XMath>
                </Math></foreignObject></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 3: </span>Decomposition of a closed <math id="S5.F3.m2" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math>-manifold into ellipsoids and pseudo-balls</figcaption>
</figure>
<div id="S5.SS2.p3" class="ltx_para">
<p id="S5.SS2.p3.1" class="ltx_p">By Proposition <a href="#S5.Thmdefinition2" title="Proposition 5.2. ‣ 5.1 Decomposition of symplectic 4-manifolds with irrational symplectic class ‣ 5 Packing stability of irrational closed symplectic 4-manifolds ‣ Packing stability for symplectic 4-manifolds." class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.2</span></a> the
<math id="S5.SS2.p3.m1" class="ltx_Math" alttext="\mathcal{E}(\mathcal{A}_{i},\alpha_{i})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>i</mi></msub><mo>,</mo><msub><mi>α</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{E}(\mathcal{A}_{i},\alpha_{i})</annotation></semantics></math> and the
<math id="S5.SS2.p3.m2" class="ltx_Math" alttext="T(\mathcal{A}_{i,i+1},\mathcal{A}_{i+1,i},\alpha_{i+1},\alpha_{i})" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>i</mi></mrow></msub><mo>,</mo><msub><mi>α</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>α</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T(\mathcal{A}_{i,i+1},\mathcal{A}_{i+1,i},\alpha_{i+1},\alpha_{i})</annotation></semantics></math> give a full packing of <math id="S5.SS2.p3.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>.
Call <math id="S5.SS2.p3.m4" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> its number of pieces.</p>
</div>
<div id="S5.SS2.p4" class="ltx_para">
<p id="S5.SS2.p4.1" class="ltx_p">Now, by Theorem <a href="#Thmthm2" title="Theorem 2. ‣ 1 Introduction ‣ Packing stability for symplectic 4-manifolds." class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> and Proposition <a href="#S4.Thmdefinition3" title="Proposition 4.3. ‣ 4 Packing stability of pseudo-balls 𝑇(𝑎,𝑏,𝛼,𝛽) ‣ Packing stability for symplectic 4-manifolds." class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a>, there exists a <math id="S5.SS2.p4.m1" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> and <math id="S5.SS2.p4.m2" class="ltx_Math" alttext="\varepsilon_{0}" display="inline" intent=":literal"><semantics><msub><mi>ε</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\varepsilon_{0}</annotation></semantics></math> such that all ellipsoids <math id="S5.SS2.p4.m3" class="ltx_Math" alttext="E(\mathcal{A}_{i}+\varepsilon_{i},\alpha_{i})" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>i</mi></msub><mo>+</mo><msub><mi>ε</mi><mi>i</mi></msub></mrow><mo>,</mo><msub><mi>α</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">E(\mathcal{A}_{i}+\varepsilon_{i},\alpha_{i})</annotation></semantics></math>, and all pseudo-balls <math id="S5.SS2.p4.m4" class="ltx_Math" alttext="T(\mathcal{A}_{i,i+1}+\varepsilon_{i,i+1},\mathcal{A}_{i+1,i}+\varepsilon_{i+1,i},\alpha_{i},\alpha_{i+1})" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo>+</mo><msub><mi>ε</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub></mrow><mo>,</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>i</mi></mrow></msub><mo>+</mo><msub><mi>ε</mi><mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>i</mi></mrow></msub></mrow><mo>,</mo><msub><mi>α</mi><mi>i</mi></msub><mo>,</mo><msub><mi>α</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T(\mathcal{A}_{i,i+1}+\varepsilon_{i,i+1},\mathcal{A}_{i+1,i}+\varepsilon_{i+1,i},\alpha_{i},\alpha_{i+1})</annotation></semantics></math> have the strong packing stability, with constant <math id="S5.SS2.p4.m5" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>, for all <math id="S5.SS2.p4.m6" class="ltx_Math" alttext="\varepsilon_{i},\varepsilon_{i,j}&lt;\varepsilon_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ε</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>ε</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>&lt;</mo><msub><mi>ε</mi><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\varepsilon_{i},\varepsilon_{i,j}&lt;\varepsilon_{0}</annotation></semantics></math>. Moreover, there exists a constant <math id="S5.SS2.p4.m7" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> and a sequence <math id="S5.SS2.p4.m8" class="ltx_Math" alttext="\varepsilon^{\prime}_{1}&lt;\varepsilon^{\prime}_{2}&lt;\dots&lt;\varepsilon^{\prime}_{m}=\varepsilon_{0}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ε</mi><mn>1</mn><mo>′</mo></msubsup><mo>&lt;</mo><msubsup><mi>ε</mi><mn>2</mn><mo>′</mo></msubsup><mo>&lt;</mo><mi mathvariant="normal">⋯</mi><mo>&lt;</mo><msubsup><mi>ε</mi><mi>m</mi><mo>′</mo></msubsup><mo>=</mo><msub><mi>ε</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\varepsilon^{\prime}_{1}&lt;\varepsilon^{\prime}_{2}&lt;\dots&lt;\varepsilon^{\prime}_{m}=\varepsilon_{0}</annotation></semantics></math> such that we can achieve any volume within <math id="S5.SS2.p4.m9" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> of the original volume of one of our ellipsoids by changing the <math id="S5.SS2.p4.m10" class="ltx_Math" alttext="\varepsilon_{i}" display="inline" intent=":literal"><semantics><msub><mi>ε</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\varepsilon_{i}</annotation></semantics></math> parameter by less than <math id="S5.SS2.p4.m11" class="ltx_Math" alttext="\varepsilon^{\prime}_{1}" display="inline" intent=":literal"><semantics><msubsup><mi>ε</mi><mn>1</mn><mo>′</mo></msubsup><annotation encoding="application/x-tex">\varepsilon^{\prime}_{1}</annotation></semantics></math>; and if one parameter of any of our pseudo-balls is changed by less than <math id="S5.SS2.p4.m12" class="ltx_Math" alttext="2\varepsilon^{\prime}_{l}" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ε</mi><mi>l</mi><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">2\varepsilon^{\prime}_{l}</annotation></semantics></math> then we can change the second parameter by less than <math id="S5.SS2.p4.m13" class="ltx_Math" alttext="\varepsilon^{\prime}_{l+1}" display="inline" intent=":literal"><semantics><msubsup><mi>ε</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">\varepsilon^{\prime}_{l+1}</annotation></semantics></math> to achieve any volume within <math id="S5.SS2.p4.m14" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> of the original.</p>
</div>
<div id="S5.SS2.p5" class="ltx_para">
<p id="S5.SS2.p5.1" class="ltx_p">We claim that <math id="S5.SS2.p5.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> satisfies the packing stability with constant <math id="S5.SS2.p5.m2" class="ltx_Math" alttext="\Lambda^{\prime}=\min(\Lambda,\sqrt{2\delta})" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Λ</mi><mo>′</mo></msup><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Λ</mi><mo>,</mo><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow></msqrt><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Lambda^{\prime}=\min(\Lambda,\sqrt{2\delta})</annotation></semantics></math>. (Note that a ball of capacity <math id="S5.SS2.p5.m3" class="ltx_Math" alttext="\sqrt{2\delta}" display="inline" intent=":literal"><semantics><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow></msqrt><annotation encoding="application/x-tex">\sqrt{2\delta}</annotation></semantics></math> has volume <math id="S5.SS2.p5.m4" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>.) Indeed, suppose we have a sequence of balls, each of capacity less that <math id="S5.SS2.p5.m5" class="ltx_Math" alttext="\Lambda^{\prime}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Λ</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\Lambda^{\prime}</annotation></semantics></math>. If the total volume of the balls is less than <math id="S5.SS2.p5.m6" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> we may include some additional ones. Then we can partition the balls into <math id="S5.SS2.p5.m7" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> subsets such that the sum of the volumes of the balls in the <math id="S5.SS2.p5.m8" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>th block lies within <math id="S5.SS2.p5.m9" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> of the volume of the <math id="S5.SS2.p5.m10" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>th piece of our decomposition of <math id="S5.SS2.p5.m11" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>.</p>
</div>
<div id="S5.SS2.p6" class="ltx_para">
<p id="S5.SS2.p6.1" class="ltx_p">Now we claim that we can perturb the discs <math id="S5.SS2.p6.m1" class="ltx_Math" alttext="D_{i},D_{i,j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>i</mi></msub><mo>,</mo><msub><mi>D</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">D_{i},D_{i,j}</annotation></semantics></math> to discs <math id="S5.SS2.p6.m2" class="ltx_Math" alttext="D_{i}^{\prime},D_{i,j}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>D</mi><mi>i</mi><mo>′</mo></msubsup><mo>,</mo><msubsup><mi>D</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">D_{i}^{\prime},D_{i,j}^{\prime}</annotation></semantics></math> which verify the four conditions listed above but are such that the volume of the associated piece of our decomposition is equal to the total volume of the corresponding subset of balls. We do this in order. First we perturb <math id="S5.SS2.p6.m3" class="ltx_Math" alttext="\mathcal{A}_{1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathcal{A}_{1}</annotation></semantics></math> by less than <math id="S5.SS2.p6.m4" class="ltx_Math" alttext="\varepsilon_{1}" display="inline" intent=":literal"><semantics><msub><mi>ε</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\varepsilon_{1}</annotation></semantics></math> to get an <math id="S5.SS2.p6.m5" class="ltx_Math" alttext="\mathcal{A}^{\prime}_{1}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mn>1</mn><mo>′</mo></msubsup><annotation encoding="application/x-tex">\mathcal{A}^{\prime}_{1}</annotation></semantics></math> such that <math id="S5.SS2.p6.m6" class="ltx_Math" alttext="E(\mathcal{A}^{\prime}_{1},\alpha_{1})" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mn>1</mn><mo>′</mo></msubsup><mo>,</mo><msub><mi>α</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">E(\mathcal{A}^{\prime}_{1},\alpha_{1})</annotation></semantics></math> has the volume of the first subset of balls. The area <math id="S5.SS2.p6.m7" class="ltx_Math" alttext="\mathcal{A}^{\prime}_{1,2}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">\mathcal{A}^{\prime}_{1,2}</annotation></semantics></math> is then determined, but will be changed by less than <math id="S5.SS2.p6.m8" class="ltx_Math" alttext="\varepsilon_{1}" display="inline" intent=":literal"><semantics><msub><mi>ε</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\varepsilon_{1}</annotation></semantics></math>. We can then perturb <math id="S5.SS2.p6.m9" class="ltx_Math" alttext="\mathcal{A}_{2,1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mn>2</mn><mo>,</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\mathcal{A}_{2,1}</annotation></semantics></math> by less than <math id="S5.SS2.p6.m10" class="ltx_Math" alttext="\varepsilon_{2}" display="inline" intent=":literal"><semantics><msub><mi>ε</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\varepsilon_{2}</annotation></semantics></math> to get a new pseudo-ball <math id="S5.SS2.p6.m11" class="ltx_Math" alttext="T(\mathcal{A}^{\prime}_{1,2},\mathcal{A}^{\prime}_{2,1},\alpha_{1},\alpha_{2})" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow><mo>′</mo></msubsup><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mn>2</mn><mo>,</mo><mn>1</mn></mrow><mo>′</mo></msubsup><mo>,</mo><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T(\mathcal{A}^{\prime}_{1,2},\mathcal{A}^{\prime}_{2,1},\alpha_{1},\alpha_{2})</annotation></semantics></math> whose volume is equal to the volume of the second subset of balls. Carrying on in this way we get the volumes as claimed.</p>
</div>
<div id="S5.SS2.p7" class="ltx_para">
<p id="S5.SS2.p7.1" class="ltx_p">Finally, as the perturbed pieces still have stability constant less than <math id="S5.SS2.p7.m1" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> they can be fully filled by the corresponding subset of balls, and as a consequence the balls fully pack <math id="S5.SS2.p7.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> as required.  <math id="S5.SS2.p7.m3" class="ltx_Math" alttext="\square" display="inline" intent=":literal"><semantics><mi mathvariant="normal">□</mi><annotation encoding="application/x-tex">\square</annotation></semantics></math></p>
</div>
</section>
</section>
