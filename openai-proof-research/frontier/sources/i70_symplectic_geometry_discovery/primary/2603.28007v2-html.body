6 -13.78 Z M 0 -13.78"></path></g><g></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M 0 -71.65 M 90.94 -71.65 C 90.94 -64.04 50.23 -57.87 0 -57.87 C -50.23 -57.87 -90.94 -64.04 -90.94 -71.65 C -90.94 -79.26 -50.23 -85.43 0 -85.43 C 50.23 -85.43 90.94 -79.26 90.94 -71.65 Z M 0 -71.65"></path></g><g></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 0 5.51 C 46.85 5.51 79.92 22.05 90.94 71.65"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M 0 5.51 C -46.85 5.51 -79.92 22.05 -90.94 71.65"></path></g><clipPath id="pgfcp10"><path d="M -90.94 -71.65 M -90.94 -71.65 L -90.94 -85.43 L 90.94 -85.43 L 90.94 -71.65 Z M 90.94 -85.43"></path></clipPath><g clip-path="url(#pgfcp10)"><g stroke-width="0.8pt"><path style="fill:none" d="M 0 -71.65 M 90.94 -71.65 C 90.94 -64.04 50.23 -57.87 0 -57.87 C -50.23 -57.87 -90.94 -64.04 -90.94 -71.65 C -90.94 -79.26 -50.23 -85.43 0 -85.43 C 50.23 -85.43 90.94 -79.26 90.94 -71.65 Z M 0 -71.65"></path></g><g></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 0 71.65 M 90.94 71.65 C 90.94 79.26 50.23 85.43 0 85.43 C -50.23 85.43 -90.94 79.26 -90.94 71.65 C -90.94 64.04 -50.23 57.87 0 57.87 C 50.23 57.87 90.94 64.04 90.94 71.65 Z M 0 71.65"></path></g><clipPath id="pgfcp11"><path d="M -57.87 -15.16 M -57.87 -15.16 L -57.87 15.98 L 55.12 15.98 L 55.12 -15.16 Z M 55.12 15.98"></path></clipPath><g clip-path="url(#pgfcp11)"><g stroke-width="0.8pt"><path style="fill:none" d="M 0 0 M 55.12 0 C 55.12 30.44 30.44 55.12 0 55.12 C -30.44 55.12 -55.12 30.44 -55.12 0 C -55.12 -30.44 -30.44 -55.12 0 -55.12 C 30.44 -55.12 55.12 -30.44 55.12 0 Z M 0 0"></path></g><g></g></g><g style="--ltx-stroke-color:#FFFFFF;--ltx-fill-color:#FFFFFF;--ltx-fg-color:#FFFFFF;" color="#FFFFFF" fill="#FFFFFF" stroke="#FFFFFF"><path d="M -27.56 57.87 L -27.56 27.56 L 88.19 66.14 L -27.56 66.14 Z"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -27.56 57.87 L -27.56 27.56 L 88.19 67.8"></p