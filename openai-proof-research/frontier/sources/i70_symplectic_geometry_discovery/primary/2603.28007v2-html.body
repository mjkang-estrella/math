<figure id="S3.F8" class="ltx_figure"><span class="ltx_inline-block"><svg id="S3.F8.pic1" class="ltx_picture ltx_centering" height="362.13" overflow="visible" version="1.1" viewBox="0 0 295.25 362.13" width="295.25"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,362.13) matrix(1 0 0 -1 0 0) translate(165.91,0) translate(0,77.72)"><g stroke-width="0.8pt"><path style="fill:none" d="M -96.46 206.69 L 110.24 206.69"></path></g><g stroke-width="0.4pt"><path style="fill:none" d="M 110.24 206.69"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 115.12 201.96)"><foreignObject style="--ltx-fo-width:0.69em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="9.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F8.pic1.m1" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math></span></span></foreignObject></g><g stroke-width="0.8pt"><path style="fill:none" d="M -96.46 206.69 C -110.24 206.69 -121.26 192.91 -126.77 192.91"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -126.77 192.91 C -115.75 192.91 -104.72 179.13 -90.94 179.13"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -90.94 179.13 C -107.48 179.13 -118.5 165.35 -124.02 165.35"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -124.02 165.35 C -112.99 165.35 -104.72 151.57 -93.7 151.57"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -93.7 151.57 C -107.48 151.57 -112.99 137.79 -124.02 137.79"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -124.02 137.79 C -117.13 137.79 -110.24 129.53 -104.72 129.53 C -99.21 129.53 -93.7 135.04 -88.19 135.04"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -88.19 135.04 C -96.46 135.04 -115.75 151.57 -126.77 151.57"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -126.77 151.57 C -118.5 151.57 -101.97 165.35 -93.7 165.35"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -93.7 165.35 C -101.97 165.35 -115.75 179.13 -126.77 179.13"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -126.77 179.13 C -115.75 179.13 -101.97 192.91 -96.46 192.91"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -96.46 192.91 C -101.97 192.91 -146.06 220.47 -151.57 220.47"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -151.57 220.47 C -146.06 220.47 -132.28 234.25 -121.26 234.25"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -121.26 234.25 C -132.28 234.25 -143.31 248.03 -151.57 248.03"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -151.57 248.03 C -143.31 248.03 -132.28 261.81 -124.02 261.81 C -129.53 261.81 -135.04 267.32 -137.79 267.32 C -143.31 267.32 -148.82 261.81 -154.33 261.81"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -154.33 261.81 C -148.82 261.81 -132.28 248.03 -124.02 248.03"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -124.02 248.03 C -132.28 248.03 -146.06 234.25 -151.57 234.25"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -151.57 234.25 C -146.06 234.25 -132.28 220.47 -121.26 220.47"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -121.26 220.47 C -129.53 220.47 -151.57 206.69 -165.35 206.69"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -63.39 261.81 C -46.85 261.81 -35.83 283.86 -22.05 283.86 C -8.27 281.1 5.51 264.57 19.29 264.57"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -63.39 261.81 C -49.61 261.81 -38.58 246.65 -19.29 245.27 C -2.76 245.27 8.27 264.57 19.29 264.57"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -35.83 256.3 C -19.29 256.3 -8.27 278.35 5.51 278.35 C 19.29 275.59 33.07 259.05 46.85 259.05"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -35.83 256.3 C -22.05 256.3 -11.02 241.14 8.27 239.76 C 24.8 239.76 35.83 259.05 46.85 259.05"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -5.51 234.25 C 5.51 234.25 19.29 256.3 35.83 256.3 C 49.61 253.54 63.39 237.01 77.17 237.01"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -5.51 234.25 C 11.02 234.25 24.8 219.09 44.09 217.72 C 55.12 217.72 66.14 237.01 77.17 237.01"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -55.12 239.76 C -38.58 239.76 -27.56 256.3 -5.51 259.05 C 8.27 259.05 27.56 234.25 41.34 234.25"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -55.12 239.76 C -41.34 239.76 -30.32 224.61 -11.02 223.23 C 5.51 223.23 27.56 234.25 41.34 234.25"></path></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M -88.19 135.04 C -77.17 135.04 -66.14 239.76 -55.12 239.76"></path></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M -121.26 220.47 C -82.68 220.47 -27.56 234.25 -5.51 234.25"></path></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M -124.02 261.81 L -63.39 261.81"></path></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M -121.26 234.25 C -110.24 234.25 -52.36 256.3 -35.83 256.3"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -96.46 0 L 110.24 0"></path></g><path style="fill:none" d="M 110.24 0"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 115.12 -4.73)"><foreignObject style="--ltx-fo-width:0.69em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="9.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F8.pic1.m2" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M -96.46 0 C -110.24 0 -121.26 -13.78 -126.77 -13.78"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -126.77 -13.78 C -115.75 -13.78 -104.72 -27.56 -90.94 -27.56"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -90.94 -27.56 C -107.48 -27.56 -118.5 -41.34 -124.02 -41.34"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -124.02 -41.34 C -112.99 -41.34 -104.72 -55.12 -93.7 -55.12"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -93.7 -55.12 C -107.48 -55.12 -112.99 -68.9 -124.02 -68.9"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -124.02 -68.9 C -117.13 -68.9 -110.24 -77.17 -104.72 -77.17 C -99.21 -77.17 -93.7 -73.03 -88.19 -73.03"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -88.19 -68.9 C -96.46 -68.9 -115.75 -55.12 -126.77 -55.12"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -126.77 -55.12 C -118.5 -55.12 -101.97 -41.34 -93.7 -41.34"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -93.7 -41.34 C -101.97 -41.34 -115.75 -27.56 -126.77 -27.56"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -126.77 -27.56 C -115.75 -27.56 -101.97 -13.78 -96.46 -13.78"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -96.46 -13.78 C -101.97 -13.78 -146.06 13.78 -151.57 13.78"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -151.57 13.78 C -146.06 13.78 -132.28 24.8 -121.26 24.8"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -121.26 28.94 C -132.28 28.94 -143.31 41.34 -151.57 41.34"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -151.57 41.34 C -143.31 41.34 -132.28 52.36 -124.02 52.36"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -124.02 56.5 C -129.53 56.5 -135.04 60.63 -137.79 60.63 C -143.31 60.63 -148.82 55.12 -154.33 55.12"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -154.33 55.12 C -148.82 55.12 -132.28 41.34 -124.02 41.34"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -124.02 41.34 C -132.28 41.34 -146.06 27.56 -151.57 27.56"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -151.57 27.56 C -146.06 27.56 -132.28 15.16 -121.26 15.16"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -121.26 11.02 C -129.53 11.02 -151.57 0 -165.35 0"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -63.39 56.5 C -46.85 56.5 -35.83 77.17 -22.05 77.17 C -8.27 74.41 5.51 57.87 19.29 57.87"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -63.39 52.36 C -49.61 52.36 -38.58 39.96 -19.29 38.58 C -2.76 38.58 8.27 57.87 19.29 57.87"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -35.83 50.98 C -19.29 50.98 -8.27 71.65 5.51 71.65 C 19.29 68.9 33.07 52.36 46.85 52.36"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -35.83 46.85 C -22.05 46.85 -11.02 34.45 8.27 33.07 C 24.8 33.07 35.83 52.36 46.85 52.36"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -5.51 28.94 C 5.51 28.94 19.29 49.61 35.83 49.61 C 49.61 46.85 63.39 30.31 77.17 30.31"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -5.51 24.8 C 11.02 24.8 24.8 12.4 44.09 11.02 C 55.12 11.02 66.14 30.31 77.17 30.31"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -55.12 33.07 C -38.58 33.07 -27.56 49.61 -5.51 52.36 C 8.27 52.36 27.56 27.56 41.34 27.56"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -52.36 28.94 C -41.34 28.94 -30.32 17.91 -11.02 16.54 C 5.51 16.54 27.56 27.56 41.34 27.56"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -88.19 -68.9 C -77.17 -68.9 -66.14 33.07 -55.12 33.07"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -88.19 -73.03 C -71.65 -73.03 -63.39 28.94 -52.36 28.94"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -121.26 15.16 C -82.68 15.16 -27.56 28.94 -5.51 28.94"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -121.26 11.02 C -82.68 11.02 -27.56 24.8 -5.51 24.8"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -124.02 56.5 L -63.39 56.5"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -124.02 52.36 L -63.39 52.36"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -121.26 28.94 C -110.24 28.94 -52.36 50.98 -35.83 50.98"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -121.26 24.8 C -110.24 24.8 -52.36 46.85 -35.83 46.85"></path></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 8. </span>Proof of Theorem <a href="#S1.Thmtheorem15" title="Theorem 1.15. ‣ 1.1. Main results ‣ 1. Introduction ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.15</span></a>, Step 3: Surgering the wrinkles into the base.</figcaption>
</figure>
<div id="S3.Thmtheorem35" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem35.1" class="ltx_text ltx_font_italic">Remark 3.35</span></span><span id="S3.Thmtheorem35.2" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S3.Thmtheorem35.p1" class="ltx_para">
<p id="S3.Thmtheorem35.p1.1" class="ltx_p">Given <math id="S3.Thmtheorem35.p1.m1" class="ltx_Math" alttext="g:\mathbf{R}^{N}\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>𝐑</mi><mi>N</mi></msup><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">g:\mathbf{R}^{N}\to\mathbf{R}</annotation></semantics></math> a function of quadratic tube type, <math id="S3.Thmtheorem35.p1.m2" class="ltx_Math" alttext="\nabla g:\mathbf{R}^{N}\to\mathbf{R}^{N}" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">∇</mo><mi>g</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>𝐑</mi><mi>N</mi></msup><mo stretchy="false">→</mo><msup><mi>𝐑</mi><mi>N</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\nabla g:\mathbf{R}^{N}\to\mathbf{R}^{N}</annotation></semantics></math> is homogeneous of degree 1 and has degree <math id="S3.Thmtheorem35.p1.m3" class="ltx_Math" alttext="\pm 1" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\pm 1</annotation></semantics></math>, hence may be viewed as a map <math id="S3.Thmtheorem35.p1.m4" class="ltx_Math" alttext="S^{N}\to S^{N}" display="inline" intent=":literal"><semantics><mrow><msup><mi>S</mi><mi>N</mi></msup><mo stretchy="false">→</mo><msup><mi>S</mi><mi>N</mi></msup></mrow><annotation encoding="application/x-tex">S^{N}\to S^{N}</annotation></semantics></math>. This gives a map <math id="S3.Thmtheorem35.p1.m5" class="ltx_Math" alttext="\mathcal{T}_{k,N}\to G_{N}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>k</mi><mo>,</mo><mi>N</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi>G</mi><mi>N</mi></msub></mrow><annotation encoding="application/x-tex">\mathcal{T}_{k,N}\to G_{N}</annotation></semantics></math> for <math id="S3.Thmtheorem35.p1.m6" class="ltx_Math" alttext="G_{N}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>N</mi></msub><annotation encoding="application/x-tex">G_{N}</annotation></semantics></math> the space of self-homotopy equivalences of <math id="S3.Thmtheorem35.p1.m7" class="ltx_Math" alttext="S^{N}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mi>N</mi></msup><annotation encoding="application/x-tex">S^{N}</annotation></semantics></math> which stabilizes to a map <math id="S3.Thmtheorem35.p1.m8" class="ltx_Math" alttext="D:\mathcal{T}_{\infty}\to G" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi mathvariant="normal">∞</mi></msub><mo stretchy="false">→</mo><mi>G</mi></mrow></mrow><annotation encoding="application/x-tex">D:\mathcal{T}_{\infty}\to G</annotation></semantics></math> called the <span id="S3.Thmtheorem35.p1.1.1" class="ltx_text ltx_font_italic">Waldhausen derivative</span>. Waldhausen proved in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx65" title="" class="ltx_ref">Wal82</a>]</cite> that <math id="S3.Thmtheorem35.p1.m9" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> factors as a composition <math id="S3.Thmtheorem35.p1.m10" class="ltx_Math" alttext="\mathcal{T}_{\infty}\to BG\to G" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi mathvariant="normal">∞</mi></msub><mo stretchy="false">→</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mo stretchy="false">→</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">\mathcal{T}_{\infty}\to BG\to G</annotation></semantics></math> and this factorization played a major role in the article <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx2" title="" class="ltx_ref">AACK</a>]</cite>. It is not hard to modify the proof of Theorem <a href="#S1.Thmtheorem15" title="Theorem 1.15. ‣ 1.1. Main results ‣ 1. Introduction ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.15</span></a> using the full power of Theorem 2.3 of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx22" title="" class="ltx_ref">EM00</a>]</cite> (rather than its special case Theorem <a href="#A1.Thmtheorem2" title="Theorem A.2 ([], Theorem 2.3). ‣ A.4. Wrinkling ‣ Appendix A Moderate singularities ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.2</span></a>) to prove that the conclusion of Theorem <a href="#S1.Thmtheorem15" title="Theorem 1.15. ‣ 1.1. Main results ‣ 1. Introduction ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.15</span></a> holds for any tube bundle <math id="S3.Thmtheorem35.p1.m11" class="ltx_Math" alttext="W\to M" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">W\to M</annotation></semantics></math> with trivial Waldhausen derivative, i.e. for any such <math id="S3.Thmtheorem35.p1.m12" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> there exists a function of tube type <math id="S3.Thmtheorem35.p1.m13" class="ltx_Math" alttext="f:M\times\mathbf{R}^{N}\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐑</mi><mi>N</mi></msup></mrow><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:M\times\mathbf{R}^{N}\to\mathbf{R}</annotation></semantics></math> with <math id="S3.Thmtheorem35.p1.m14" class="ltx_Math" alttext="W=T(f)" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>=</mo><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">W=T(f)</annotation></semantics></math> and which generates a Legendrian <math id="S3.Thmtheorem35.p1.m15" class="ltx_Math" alttext="\Lambda\subset J^{1}M" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo>⊂</mo><mrow><msup><mi>J</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">\Lambda\subset J^{1}M</annotation></semantics></math> whose projection <math id="S3.Thmtheorem35.p1.m16" class="ltx_Math" alttext="\Lambda\to M" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\Lambda\to M</annotation></semantics></math> is homotopic to a diffeomorphism. This result implies Theorem <a href="#S1.Thmtheorem15" title="Theorem 1.15. ‣ 1.1. Main results ‣ 1. Introduction ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.15</span></a> because if the classifying map <math id="S3.Thmtheorem35.p1.m17" class="ltx_Math" alttext="M\to\mathcal{T}_{\infty}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">M\to\mathcal{T}_{\infty}</annotation></semantics></math> of <math id="S3.Thmtheorem35.p1.m18" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> lifts to a map <math id="S3.Thmtheorem35.p1.m19" class="ltx_Math" alttext="M\to\mathcal{H}_{\infty}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">M\to\mathcal{H}_{\infty}</annotation></semantics></math> then the Waldhausen derivative <math id="S3.Thmtheorem35.p1.m20" class="ltx_Math" alttext="M\to G" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo stretchy="false">→</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">M\to G</annotation></semantics></math> factors as a composition <math id="S3.Thmtheorem35.p1.m21" class="ltx_Math" alttext="M\to\mathcal{H}_{\infty}\to\mathcal{T}_{\infty}\to BG\to G" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi mathvariant="normal">∞</mi></msub><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi mathvariant="normal">∞</mi></msub><mo stretchy="false">→</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mo stretchy="false">→</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">M\to\mathcal{H}_{\infty}\to\mathcal{T}_{\infty}\to BG\to G</annotation></semantics></math> and hence in particular factors through the composition of the two consecutive maps of the fibration sequence and thus is canonically nullhomotopic.</p>
</div>
</div>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4. </span>Nearby Lagrangian torsion</h2>

<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.1. </span>Tube torsion of nearby Lagrangians</h3>

<div id="S4.SS1.p1" class="ltx_para">
<p id="S4.SS1.p1.1" class="ltx_p">Recall from Section <a href="#S2.SS4" title="2.4. Stable Gauss map ‣ 2. Legendrian higher torsion ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.4</span></a> that for a nearby Lagrangian <math id="S4.SS1.p1.m1" class="ltx_Math" alttext="L\subset T^{*}M" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">L\subset T^{*}M</annotation></semantics></math> to have any chance of admitting any kind of generating function, the stable Gauss map <math id="S4.SS1.p1.m2" class="ltx_Math" alttext="L\to U/O" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo stretchy="false">→</mo><mrow><mi>U</mi><mo>/</mo><mi>O</mi></mrow></mrow><annotation encoding="application/x-tex">L\to U/O</annotation></semantics></math> of <math id="S4.SS1.p1.m3" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> must be trivial, i.e. nullhomotopic. As was also discussed in Section <a href="#S3.SS1" title="3.1. Generating functions for nearby Lagrangians ‣ 3. Legendrian tube torsion ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>, this condition is also sufficient to ensure existence of generating functions of tube type:</p>
</div>
<div id="S4.Thmtheorem1" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem1.1" class="ltx_text ltx_font_bold">Theorem 4.1</span></span><span id="S4.Thmtheorem1.2" class="ltx_text ltx_font_bold"> </span>(<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">ACGK</a>]</cite>)<span id="S4.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem1.p1" class="ltx_para">
<p id="S4.Thmtheorem1.p1.1" class="ltx_p"><span id="S4.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmtheorem1.p1.m1" class="ltx_Math" alttext="L\subset T^{*}M" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">L\subset T^{*}M</annotation></semantics></math> be a nearby Lagrangian with trivial stable Gauss map <math id="S4.Thmtheorem1.p1.m2" class="ltx_Math" alttext="L\to U/O" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo stretchy="false">→</mo><mrow><mi>U</mi><mo>/</mo><mi>O</mi></mrow></mrow><annotation encoding="application/x-tex">L\to U/O</annotation></semantics></math>. Then <math id="S4.Thmtheorem1.p1.m3" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> admits a generating function of tube type <math id="S4.Thmtheorem1.p1.m4" class="ltx_Math" alttext="f:M\times\mathbf{R}^{N}\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐑</mi><mi>N</mi></msup></mrow><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:M\times\mathbf{R}^{N}\to\mathbf{R}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS1.p2" class="ltx_para">
<p id="S4.SS1.p2.1" class="ltx_p">To be precise, in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">ACGK</a>]</cite> this result was proved for a slightly different notion of function of tube type, the space of which is close to the space we denoted by <math id="S4.SS1.p2.m1" class="ltx_Math" alttext="\mathcal{T}_{N,k}^{p}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>N</mi><mo>,</mo><mi>k</mi></mrow><mi>p</mi></msubsup><annotation encoding="application/x-tex">\mathcal{T}_{N,k}^{p}</annotation></semantics></math> in Section <a href="#S3.SS6" title="3.6. The space of tubes ‣ 3. Legendrian tube torsion ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.6</span></a>. In <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx2" title="" class="ltx_ref">AACK</a>]</cite> it was shown that the statement of Theorem <a href="#S4.Thmtheorem1" title="Theorem 4.1 ([]). ‣ 4.1. Tube torsion of nearby Lagrangians ‣ 4. Nearby Lagrangian torsion ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a> implies the same result for the notion of a function of tube type considered in the present article, i.e. in the space we denoted by <math id="S4.SS1.p2.m2" class="ltx_Math" alttext="\mathcal{T}_{N,k}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>N</mi><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{T}_{N,k}</annotation></semantics></math>. Strictly speaking, this is only proved for a <math id="S4.SS1.p2.m3" class="ltx_Math" alttext="C^{1}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mn>1</mn></msup><annotation encoding="application/x-tex">C^{1}</annotation></semantics></math>-close Hamiltonian isotopic nearby Lagrangian <math id="S4.SS1.p2.m4" class="ltx_Math" alttext="L^{\prime}\subset T^{*}M" display="inline" intent=":literal"><semantics><mrow><msup><mi>L</mi><mo>′</mo></msup><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">L^{\prime}\subset T^{*}M</annotation></semantics></math> rather than for <math id="S4.SS1.p2.m5" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> itself, but one may nevertheless conclude the desired conclusion as stated above by applying the homotopy lifting property for generating functions under Legendrian isotopies after stabilization.</p>
</div>
<div id="S4.SS1.p3" class="ltx_para">
<p id="S4.SS1.p3.1" class="ltx_p">For a nearby Lagrangian <math id="S4.SS1.p3.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> with stably trivial Gauss map the tube torsion <math id="S4.SS1.p3.m2" class="ltx_Math" alttext="\tau(L)" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tau(L)</annotation></semantics></math> consists of all (negatives of) higher torsion classes <math id="S4.SS1.p3.m3" class="ltx_Math" alttext="\tau_{2k}(W)\in H^{4k}(M;\mathbf{R})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>τ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><msup><mi>H</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>𝐑</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau_{2k}(W)\in H^{4k}(M;\mathbf{R})</annotation></semantics></math> of orientable tube bundles <math id="S4.SS1.p3.m4" class="ltx_Math" alttext="W\to M" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">W\to M</annotation></semantics></math> on which <math id="S4.SS1.p3.m5" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> admits a generating function.</p>
</div>
<div id="S4.Thmtheorem2" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem2.1" class="ltx_text ltx_font_bold">Theorem 4.2</span></span><span id="S4.Thmtheorem2.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem2.p1" class="ltx_para">
<p id="S4.Thmtheorem2.p1.1" class="ltx_p"><span id="S4.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmtheorem2.p1.m1" class="ltx_Math" alttext="L\subset T^{*}M" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">L\subset T^{*}M</annotation></semantics></math> be a nearby Lagrangian whose stable Gauss map <math id="S4.Thmtheorem2.p1.m2" class="ltx_Math" alttext="L\to U/O" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo stretchy="false">→</mo><mrow><mi>U</mi><mo>/</mo><mi>O</mi></mrow></mrow><annotation encoding="application/x-tex">L\to U/O</annotation></semantics></math> is trivial. Then the tube torsion <math id="S4.Thmtheorem2.p1.m3" class="ltx_Math" alttext="\tau(L)\subset H^{*}(M;\mathbf{R})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>𝐑</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau(L)\subset H^{*}(M;\mathbf{R})</annotation></semantics></math> of <math id="S4.Thmtheorem2.p1.m4" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> is well-defined. It consists of a nonempty union of cosets of <math id="S4.Thmtheorem2.p1.m5" class="ltx_Math" alttext="\text{im}(p)" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_italic">im</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{im}(p)</annotation></semantics></math> and is a Legendrian isotopy invariant of the Legendrian lift of <math id="S4.Thmtheorem2.p1.m6" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>. In particular, if <math id="S4.Thmtheorem2.p1.m7" class="ltx_Math" alttext="\tau(L)\neq\text{im}(p)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mrow><mtext class="ltx_mathvariant_italic">im</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau(L)\neq\text{im}(p)</annotation></semantics></math> then <math id="S4.Thmtheorem2.p1.m8" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> is not Hamiltonian isotopic to the zero-section.</span></p>
</div>
</div>
<div id="S4.SS1.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS1.p4" class="ltx_para">
<p id="S4.SS1.p4.1" class="ltx_p"><span id="S4.SS1.p4.1.1" class="ltx_text">This follows from Theorem <a href="#S1.Thmtheorem4" title="Theorem 1.4. ‣ 1.1. Main results ‣ 1. Introduction ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.4</span></a> and Theorem <a href="#S4.Thmtheorem1" title="Theorem 4.1 ([]). ‣ 4.1. Tube torsion of nearby Lagrangians ‣ 4. Nearby Lagrangian torsion ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>. ∎</span></p>
</div>
</div>
<div id="S4.SS1.p5" class="ltx_para">
<p id="S4.SS1.p5.1" class="ltx_p">The condition that the stable Gauss map is trivial is automatically satisfied for all nearby Lagrangians if <math id="S4.SS1.p5.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> has the homotopy type of a sphere, since as was also discussed in Section Section <a href="#S2.SS4" title="2.4. Stable Gauss map ‣ 2. Legendrian higher torsion ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.4</span></a> it was also proved in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">ACGK</a>]</cite> that the stable Gauss map <math id="S4.SS1.p5.m2" class="ltx_Math" alttext="L\to U/O" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo stretchy="false">→</mo><mrow><mi>U</mi><mo>/</mo><mi>O</mi></mrow></mrow><annotation encoding="application/x-tex">L\to U/O</annotation></semantics></math> of a nearby Lagrangian is always zero on homotopy groups, hence automatically trivial when <math id="S4.SS1.p5.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> (and hence also <math id="S4.SS1.p5.m4" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>) has the homotopy type of a sphere.</p>
</div>
<div id="S4.Thmtheorem3" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem3.1" class="ltx_text ltx_font_bold">Theorem 4.3</span></span><span id="S4.Thmtheorem3.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem3.p1" class="ltx_para">
<p id="S4.Thmtheorem3.p1.1" class="ltx_p"><span id="S4.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmtheorem3.p1.m1" class="ltx_Math" alttext="L\subset T^{*}\Sigma" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Σ</mi></mrow></mrow><annotation encoding="application/x-tex">L\subset T^{*}\Sigma</annotation></semantics></math> be a nearby Lagrangian, where <math id="S4.Thmtheorem3.p1.m2" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> (and therefore also <math id="S4.Thmtheorem3.p1.m3" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>) is an <math id="S4.Thmtheorem3.p1.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-dimensional homotopy sphere. Then the tube torsion <math id="S4.Thmtheorem3.p1.m5" class="ltx_Math" alttext="\tau(L)\subset H^{*}(M;\mathbf{R})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>𝐑</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau(L)\subset H^{*}(M;\mathbf{R})</annotation></semantics></math> of <math id="S4.Thmtheorem3.p1.m6" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> is well-defined. It consists of a nonempty union of cosets of <math id="S4.Thmtheorem3.p1.m7" class="ltx_Math" alttext="\text{im}(p)" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_italic">im</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{im}(p)</annotation></semantics></math> and is a Legendrian isotopy invariant of the Legendrian lift of <math id="S4.Thmtheorem3.p1.m8" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>. In particular, if <math id="S4.Thmtheorem3.p1.m9" class="ltx_Math" alttext="\tau(L)\neq\text{im}(p)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mrow><mtext class="ltx_mathvariant_italic">im</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau(L)\neq\text{im}(p)</annotation></semantics></math> then <math id="S4.Thmtheorem3.p1.m10" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> is not Hamiltonian isotopic to the zero-section.</span></p>
</div>
</div>
<div id="S4.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS1.p6" class="ltx_para">
<p id="S4.SS1.p6.1" class="ltx_p"><span id="S4.SS1.p6.1.1" class="ltx_text">This follows just as Theorem <a href="#S4.Thmtheorem3" title="Theorem 4.3. ‣ 4.1. Tube torsion of nearby Lagrangians ‣ 4. Nearby Lagrangian torsion ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a> above but using the fact that nearby Lagrangian homotopy spheres all have trivial stable Gauss map <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">ACGK</a>]</cite> to remove the extra hypothesis. ∎</span></p>
</div>
</div>
<div id="S4.SS1.p7" class="ltx_para">
<p id="S4.SS1.p7.1" class="ltx_p">The existence theorem for generating functions of tube type from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">ACGK</a>]</cite> is proved by a construction which is canonical once a nullhomotopy of the stable Gauss map <math id="S4.SS1.p7.m1" class="ltx_Math" alttext="L\to U/O" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo stretchy="false">→</mo><mrow><mi>U</mi><mo>/</mo><mi>O</mi></mrow></mrow><annotation encoding="application/x-tex">L\to U/O</annotation></semantics></math> is fixed. We will now show that this construction picks out a distinguished coset <math id="S4.SS1.p7.m2" class="ltx_Math" alttext="\nu(L)\subset\tau(L)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\nu(L)\subset\tau(L)</annotation></semantics></math> of <math id="S4.SS1.p7.m3" class="ltx_Math" alttext="\text{im}(p)" display="inline" intent=":literal"><semantics><mrow><mtext>im</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{im}(p)</annotation></semantics></math> which will turn out to be invariant under Hamiltonian isotopies of <math id="S4.SS1.p7.m4" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>, though not obviously so under Legendrian isotopies of the Legendrian lift of <math id="S4.SS1.p7.m5" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>.</p>
</div>
</section>
<section id="S4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.2. </span>The Guillermou trick</h3>

<div id="S4.SS2.p1" class="ltx_para">
<p id="S4.SS2.p1.1" class="ltx_p">The following result is implicit in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">ACGK</a>]</cite>.</p>
</div>
<div id="S4.Thmtheorem4" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem4.1" class="ltx_text ltx_font_bold">Proposition 4.4</span></span><span id="S4.Thmtheorem4.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem4.p1" class="ltx_para">
<p id="S4.Thmtheorem4.p1.1" class="ltx_p"><span id="S4.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmtheorem4.p1.m1" class="ltx_Math" alttext="L\subset T^{*}M" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">L\subset T^{*}M</annotation></semantics></math> be a nearby Lagrangian with trivial stable Gauss map <math id="S4.Thmtheorem4.p1.m2" class="ltx_Math" alttext="L\to U/O" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo stretchy="false">→</mo><mrow><mi>U</mi><mo>/</mo><mi>O</mi></mrow></mrow><annotation encoding="application/x-tex">L\to U/O</annotation></semantics></math>. The doubling construction determines a distinguished coset of the rigid tube map <math id="S4.Thmtheorem4.p1.m3" class="ltx_Math" alttext="[M,BO]\to[M,\mathcal{T}_{\infty}]" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mrow><mi>M</mi><mo>,</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mrow><mi>M</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi mathvariant="normal">∞</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">[M,BO]\to[M,\mathcal{T}_{\infty}]</annotation></semantics></math> which is invariant under Hamiltonian isotopy of <math id="S4.Thmtheorem4.p1.m4" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS2.p2" class="ltx_para">
<p id="S4.SS2.p2.1" class="ltx_p">Indeed, <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">ACGK</a>]</cite> identifies the colimit of the left action of stabilization by <math id="S4.SS2.p2.m1" class="ltx_Math" alttext="x^{2}-y^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>−</mo><msup><mi>y</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">x^{2}-y^{2}</annotation></semantics></math> on <math id="S4.SS2.p2.m2" class="ltx_Math" alttext="\mathcal{T}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒯</mi><annotation encoding="application/x-tex">\mathcal{T}</annotation></semantics></math> as the space <math id="S4.SS2.p2.m3" class="ltx_Math" alttext="\mathbf{Z}\times\mathbf{Z}\times\mathcal{T}_{\infty}" display="inline" intent=":literal"><semantics><mrow><mi>𝐙</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝐙</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\mathbf{Z}\times\mathbf{Z}\times\mathcal{T}_{\infty}</annotation></semantics></math>. This colimit still has a right action of <math id="S4.SS2.p2.m4" class="ltx_Math" alttext="\mathcal{Q}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒬</mi><annotation encoding="application/x-tex">\mathcal{Q}</annotation></semantics></math>, so we may form the (geometric realization) of the bar construction <math id="S4.SS2.p2.m5" class="ltx_Math" alttext="B(\mathbf{Z}\times\mathbf{Z}\times\mathcal{T}_{\infty},\mathcal{Q})" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐙</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝐙</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi mathvariant="normal">∞</mi></msub></mrow><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B(\mathbf{Z}\times\mathbf{Z}\times\mathcal{T}_{\infty},\mathcal{Q})</annotation></semantics></math>. To any nearby Lagrangian <math id="S4.SS2.p2.m6" class="ltx_Math" alttext="L\subset T^{*}M" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">L\subset T^{*}M</annotation></semantics></math> the (twisted) doubling construction associates a homotopy class of map <math id="S4.SS2.p2.m7" class="ltx_Math" alttext="M\to B(\mathbf{Z}\times\mathbf{Z}\times\mathcal{T}_{\infty},\mathcal{Q})" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo stretchy="false">→</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐙</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝐙</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi mathvariant="normal">∞</mi></msub></mrow><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M\to B(\mathbf{Z}\times\mathbf{Z}\times\mathcal{T}_{\infty},\mathcal{Q})</annotation></semantics></math>, invariant under Hamiltonian isotopy of <math id="S4.SS2.p2.m8" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> (this map classifies a <span id="S4.SS2.p2.1.1" class="ltx_text ltx_font_italic">twisted generating function</span>). We have a fibration sequence by Diagram 4.2 of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">ACGK</a>]</cite> which reads</p>
<table id="S4.Ex30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex30.m1" class="ltx_Math" alttext="\mathbf{Z}\times BO\to\mathbf{Z}\times\mathcal{T}_{\infty}\to B(\mathbf{Z}\times\mathbf{Z}\times\mathcal{T}_{\infty},\mathcal{Q})\to U/O" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝐙</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>B</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow><mo stretchy="false">→</mo><mrow><mi>𝐙</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi mathvariant="normal">∞</mi></msub></mrow><mo stretchy="false">→</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐙</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝐙</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi mathvariant="normal">∞</mi></msub></mrow><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>U</mi><mo>/</mo><mi>O</mi></mrow></mrow><annotation encoding="application/x-tex">\mathbf{Z}\times BO\to\mathbf{Z}\times\mathcal{T}_{\infty}\to B(\mathbf{Z}\times\mathbf{Z}\times\mathcal{T}_{\infty},\mathcal{Q})\to U/O</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p2.2" class="ltx_p">and such that the composition <math id="S4.SS2.p2.m9" class="ltx_Math" alttext="M\to B(\mathbf{Z}\times\mathbf{Z}\times\mathcal{T}_{\infty},\mathcal{Q})\to U/O" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo stretchy="false">→</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐙</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝐙</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi mathvariant="normal">∞</mi></msub></mrow><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>U</mi><mo>/</mo><mi>O</mi></mrow></mrow><annotation encoding="application/x-tex">M\to B(\mathbf{Z}\times\mathbf{Z}\times\mathcal{T}_{\infty},\mathcal{Q})\to U/O</annotation></semantics></math> is the stable Gauss map of <math id="S4.SS2.p2.m10" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> under a homotopy inverse for the projection <math id="S4.SS2.p2.m11" class="ltx_Math" alttext="L\to M" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">L\to M</annotation></semantics></math>. So the desired statement follows formally from the fact that a nullhomotopy of <math id="S4.SS2.p2.m12" class="ltx_Math" alttext="M\to U/O" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo stretchy="false">→</mo><mrow><mi>U</mi><mo>/</mo><mi>O</mi></mrow></mrow><annotation encoding="application/x-tex">M\to U/O</annotation></semantics></math> is equivalent to a lift <math id="S4.SS2.p2.m13" class="ltx_Math" alttext="M\to\mathbf{Z}\times\mathcal{T}_{\infty}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo stretchy="false">→</mo><mrow><mi>𝐙</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi mathvariant="normal">∞</mi></msub></mrow></mrow><annotation encoding="application/x-tex">M\to\mathbf{Z}\times\mathcal{T}_{\infty}</annotation></semantics></math> of the map <math id="S4.SS2.p2.m14" class="ltx_Math" alttext="M\to B(\mathbf{Z}\times\mathbf{Z}\times\mathcal{T}_{\infty},\mathcal{Q})" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo stretchy="false">→</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐙</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝐙</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi mathvariant="normal">∞</mi></msub></mrow><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M\to B(\mathbf{Z}\times\mathbf{Z}\times\mathcal{T}_{\infty},\mathcal{Q})</annotation></semantics></math>, which is homotopically unique up to a lift <math id="S4.SS2.p2.m15" class="ltx_Math" alttext="M\to\mathbf{Z}\times BO" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo stretchy="false">→</mo><mrow><mrow><mi>𝐙</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>B</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow></mrow><annotation encoding="application/x-tex">M\to\mathbf{Z}\times BO</annotation></semantics></math>. In fact, if we know a priori that <math id="S4.SS2.p2.m16" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> has trivial stable Gauss map we may avoid the bar construction and we briefly explain how this works.</p>
</div>
<div id="S4.SS2.p3" class="ltx_para">
<p id="S4.SS2.p3.1" class="ltx_p">Given a Legendrian submanifold <math id="S4.SS2.p3.m1" class="ltx_Math" alttext="\Lambda\subset J^{1}M" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo>⊂</mo><mrow><msup><mi>J</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">\Lambda\subset J^{1}M</annotation></semantics></math>, a local generating function for <math id="S4.SS2.p3.m2" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> consists of a generating function <math id="S4.SS2.p3.m3" class="ltx_Math" alttext="f:U\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>U</mi><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:U\to\mathbf{R}</annotation></semantics></math> where <math id="S4.SS2.p3.m4" class="ltx_Math" alttext="U\subset M\times\mathbf{R}^{N}" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⊂</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐑</mi><mi>N</mi></msup></mrow></mrow><annotation encoding="application/x-tex">U\subset M\times\mathbf{R}^{N}</annotation></semantics></math> is some open subset. Since <math id="S4.SS2.p3.m5" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> could be an arbitrarily small neighborhood of the fiberwise singular set of <math id="S4.SS2.p3.m6" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> this notion amounts to a purely linear algebraic question. Indeed, as discussed in Section <a href="#S2.SS4" title="2.4. Stable Gauss map ‣ 2. Legendrian higher torsion ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.4</span></a> it goes back to Giroux <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx27" title="" class="ltx_ref">G90</a>]</cite> that the existence of a so-called local generating function is equivalent to the triviality of the stable Gauss map <math id="S4.SS2.p3.m7" class="ltx_Math" alttext="\Lambda\to U/O" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo stretchy="false">→</mo><mrow><mi>U</mi><mo>/</mo><mi>O</mi></mrow></mrow><annotation encoding="application/x-tex">\Lambda\to U/O</annotation></semantics></math>. Moreover, as is explained in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx27" title="" class="ltx_ref">G90</a>]</cite> and further discussed in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">ACGK</a>]</cite>, one may take as input a nullhomotopy of the stable Gauss map <math id="S4.SS2.p3.m8" class="ltx_Math" alttext="\Lambda\to U/O" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo stretchy="false">→</mo><mrow><mi>U</mi><mo>/</mo><mi>O</mi></mrow></mrow><annotation encoding="application/x-tex">\Lambda\to U/O</annotation></semantics></math> to construct such a local generating function. If one were to change the chosen null-homotopy of the stable Gauss map by concatenating with a map <math id="S4.SS2.p3.m9" class="ltx_Math" alttext="\Lambda\to\Omega(U/O)," display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Λ</mi><mo stretchy="false">→</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>U</mi><mo>/</mo><mi>O</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\Lambda\to\Omega(U/O),</annotation></semantics></math> then this would correspond to performing a twisted stabilization of the local generating function by a family of quadratic forms on <math id="S4.SS2.p3.m10" class="ltx_Math" alttext="\Lambda." display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Lambda.</annotation></semantics></math> The negative eigenspaces of the fiberwise Hessian form a real vector bundle <math id="S4.SS2.p3.m11" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> over <math id="S4.SS2.p3.m12" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> classified by the map <math id="S4.SS2.p3.m13" class="ltx_Math" alttext="\Lambda\to\mathbf{Z}\times BO" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo stretchy="false">→</mo><mrow><mrow><mi>𝐙</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>B</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow></mrow><annotation encoding="application/x-tex">\Lambda\to\mathbf{Z}\times BO</annotation></semantics></math> corresponding to the given map <math id="S4.SS2.p3.m14" class="ltx_Math" alttext="\Lambda\to\Omega(U/O)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo stretchy="false">→</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>U</mi><mo>/</mo><mi>O</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Lambda\to\Omega(U/O)</annotation></semantics></math> under the model for Bott periodicity <math id="S4.SS2.p3.m15" class="ltx_Math" alttext="\Omega(U/O)\simeq\mathbf{Z}\times BO" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>U</mi><mo>/</mo><mi>O</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≃</mo><mrow><mrow><mi>𝐙</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>B</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow></mrow><annotation encoding="application/x-tex">\Omega(U/O)\simeq\mathbf{Z}\times BO</annotation></semantics></math> considered in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx27" title="" class="ltx_ref">G90</a>]</cite>.</p>
</div>
<div id="S4.SS2.p4" class="ltx_para">
<p id="S4.SS2.p4.1" class="ltx_p">The construction for generating functions of tube type for nearby Lagrangians <math id="S4.SS2.p4.m1" class="ltx_Math" alttext="L\subset T^{*}M" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">L\subset T^{*}M</annotation></semantics></math> with trivial stable Gauss map <math id="S4.SS2.p4.m2" class="ltx_Math" alttext="L\to U/O" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo stretchy="false">→</mo><mrow><mi>U</mi><mo>/</mo><mi>O</mi></mrow></mrow><annotation encoding="application/x-tex">L\to U/O</annotation></semantics></math> takes a nullhomotopy of the Gauss map and the corresponding local generating function <math id="S4.SS2.p4.m3" class="ltx_Math" alttext="f:U\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>U</mi><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:U\to\mathbf{R}</annotation></semantics></math> where <math id="S4.SS2.p4.m4" class="ltx_Math" alttext="U\subset M\times\mathbf{R}^{N+1}" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⊂</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐑</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">U\subset M\times\mathbf{R}^{N+1}</annotation></semantics></math> as its starting point, and then argues as follows. Denote <math id="S4.SS2.p4.m5" class="ltx_Math" alttext="\mathbf{R}^{N+1}=\mathbf{R}\times\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐑</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>=</mo><mrow><mi>𝐑</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">\mathbf{R}^{N+1}=\mathbf{R}\times\mathbf{R}</annotation></semantics></math> with <math id="S4.SS2.p4.m6" class="ltx_Math" alttext="x\in\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi>𝐑</mi></mrow><annotation encoding="application/x-tex">x\in\mathbf{R}</annotation></semantics></math> the coordinate of the second factor. By a direct sum with the function <math id="S4.SS2.p4.m7" class="ltx_Math" alttext="x^{3}+3x" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mn>3</mn></msup><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><annotation encoding="application/x-tex">x^{3}+3x</annotation></semantics></math> one may construct a local generating function for a <span id="S4.SS2.p4.1.1" class="ltx_text ltx_font_italic">double</span> of <math id="S4.SS2.p4.m8" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>, which consists of two parallel copies of <math id="S4.SS2.p4.m9" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> in <math id="S4.SS2.p4.m10" class="ltx_Math" alttext="J^{1}M" display="inline" intent=":literal"><semantics><mrow><msup><mi>J</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">J^{1}M</annotation></semantics></math>, namely <math id="S4.SS2.p4.m11" class="ltx_Math" alttext="\Lambda_{0}\coprod\Lambda_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Λ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∐</mo><msub><mi mathvariant="normal">Λ</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\Lambda_{0}\coprod\Lambda_{1}</annotation></semantics></math> for <math id="S4.SS2.p4.m12" class="ltx_Math" alttext="\Lambda_{0}=\Lambda" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Λ</mi><mn>0</mn></msub><mo>=</mo><mi mathvariant="normal">Λ</mi></mrow><annotation encoding="application/x-tex">\Lambda_{0}=\Lambda</annotation></semantics></math> and <math id="S4.SS2.p4.m13" class="ltx_Math" alttext="\Lambda_{\epsilon}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Λ</mi><mi>ϵ</mi></msub><annotation encoding="application/x-tex">\Lambda_{\epsilon}</annotation></semantics></math> a shift of <math id="S4.SS2.p4.m14" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> by a small but constant amount <math id="S4.SS2.p4.m15" class="ltx_Math" alttext="\epsilon\in\mathbf{R}_{+}" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>∈</mo><msub><mi>𝐑</mi><mo>+</mo></msub></mrow><annotation encoding="application/x-tex">\epsilon\in\mathbf{R}_{+}</annotation></semantics></math> in the <math id="S4.SS2.p4.m16" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math>-coordinate <math id="S4.SS2.p4.m17" class="ltx_Math" alttext="J^{1}M=T^{*}M\times\mathbf{R}_{z}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>J</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>=</mo><mrow><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝐑</mi><mi>z</mi></msub></mrow></mrow><annotation encoding="application/x-tex">J^{1}M=T^{*}M\times\mathbf{R}_{z}</annotation></semantics></math>. Further, by a judicious choice of cutoffs, one may arrange for the double of <math id="S4.SS2.p4.m18" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> to be generated by a global, i.e. not local, generating function <math id="S4.SS2.p4.m19" class="ltx_Math" alttext="h_{s}:M\times\mathbf{R}^{N+1}\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mi>s</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐑</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">h_{s}:M\times\mathbf{R}^{N+1}\to\mathbf{R}</annotation></semantics></math> such that away from the critical set there holds <math id="S4.SS2.p4.m20" class="ltx_Math" alttext="\partial h/\partial x\neq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mo>∂</mo><mrow><mi>h</mi><mo rspace="0.055em">/</mo><mrow><mo>∂</mo><mi>x</mi></mrow></mrow></mrow><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\partial h/\partial x\neq 0</annotation></semantics></math> for the distinguished coordinate <math id="S4.SS2.p4.m21" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> of <math id="S4.SS2.p4.m22" class="ltx_Math" alttext="\mathbf{R}^{N+1}=\mathbf{R}^{N}\times\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐑</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>=</mo><mrow><msup><mi>𝐑</mi><mi>N</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">\mathbf{R}^{N+1}=\mathbf{R}^{N}\times\mathbf{R}</annotation></semantics></math>.</p>
</div>
<div id="S4.SS2.p5" class="ltx_para">
<p id="S4.SS2.p5.1" class="ltx_p">When <math id="S4.SS2.p5.m1" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> happens to be the Legendrian lift of a nearby Lagrangian <math id="S4.SS2.p5.m2" class="ltx_Math" alttext="L\subset T^{*}M" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">L\subset T^{*}M</annotation></semantics></math>, one may use the following remarkable trick due to Guillermou <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx29" title="" class="ltx_ref">Gui12</a>]</cite>. Consider the family <math id="S4.SS2.p5.m3" class="ltx_Math" alttext="\Lambda_{0}\coprod\Lambda_{s}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Λ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∐</mo><msub><mi mathvariant="normal">Λ</mi><mi>s</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\Lambda_{0}\coprod\Lambda_{s}</annotation></semantics></math> as <math id="S4.SS2.p5.m4" class="ltx_Math" alttext="s&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">s&gt;0</annotation></semantics></math> gets larger. Since <math id="S4.SS2.p5.m5" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> is an embedded Lagrangian, <math id="S4.SS2.p5.m6" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> has no Reeb chords and hence <math id="S4.SS2.p5.m7" class="ltx_Math" alttext="\Lambda_{0}\coprod\Lambda_{s}\subset J^{1}M" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Λ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∐</mo><msub><mi mathvariant="normal">Λ</mi><mi>s</mi></msub></mrow></mrow><mo>⊂</mo><mrow><msup><mi>J</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">\Lambda_{0}\coprod\Lambda_{s}\subset J^{1}M</annotation></semantics></math> is a Legendrian isotopy. Possibly after increasing <math id="S4.SS2.p5.m8" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>, by the homotopy lifting property for generating functions there continues to exists a family of functions <math id="S4.SS2.p5.m9" class="ltx_Math" alttext="h_{s}:M\times\mathbf{R}^{N}\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mi>s</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐑</mi><mi>N</mi></msup></mrow><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">h_{s}:M\times\mathbf{R}^{N}\to\mathbf{R}</annotation></semantics></math> generating <math id="S4.SS2.p5.m10" class="ltx_Math" alttext="\Lambda_{0}\coprod\Lambda_{s}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Λ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∐</mo><msub><mi mathvariant="normal">Λ</mi><mi>s</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\Lambda_{0}\coprod\Lambda_{s}</annotation></semantics></math> such that <math id="S4.SS2.p5.m11" class="ltx_Math" alttext="\partial h_{s}/\partial x\neq 0" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mphantom></mphantom><mrow><mrow><msub><mi>h</mi><mi>s</mi></msub><mo rspace="0.055em">/</mo><mrow><mo>∂</mo><mi>x</mi></mrow></mrow><mo>≠</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">\partial h_{s}/\partial x\neq 0</annotation></semantics></math> outside of a compact subset. When <math id="S4.SS2.p5.m12" class="ltx_Math" alttext="s=T" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>=</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">s=T</annotation></semantics></math> is big enough so that there exists a value <math id="S4.SS2.p5.m13" class="ltx_Math" alttext="c\in\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mi>𝐑</mi></mrow><annotation encoding="application/x-tex">c\in\mathbf{R}</annotation></semantics></math> such that the <math id="S4.SS2.p5.m14" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math>-coordinate of <math id="S4.SS2.p5.m15" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> is always below <math id="S4.SS2.p5.m16" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> and the <math id="S4.SS2.p5.m17" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math>-coordinate for <math id="S4.SS2.p5.m18" class="ltx_Math" alttext="\Lambda_{T}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Λ</mi><mi>T</mi></msub><annotation encoding="application/x-tex">\Lambda_{T}</annotation></semantics></math> is always above <math id="S4.SS2.p5.m19" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math>, we may consider the codimension zero sub-bundle <math id="S4.SS2.p5.m20" class="ltx_math_unparsed" alttext="\{h_{T}\leq c\}\subset M\times\mathbf{R}^{N}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><msub><mi>h</mi><mi>T</mi></msub><mo>≤</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo>⊂</mo><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐑</mi><mi>N</mi></msup></mrow><annotation encoding="application/x-tex">\{h_{T}\leq c\}\subset M\times\mathbf{R}^{N}</annotation></semantics></math>. It is shown in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">ACGK</a>]</cite> that the resulting fiber bundle is a bundle of tubes in a sense which is close to Waldhausen’s parition model <math id="S4.SS2.p5.m21" class="ltx_Math" alttext="\mathcal{T}_{N,k}^{p}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>N</mi><mo>,</mo><mi>k</mi></mrow><mi>p</mi></msubsup><annotation encoding="application/x-tex">\mathcal{T}_{N,k}^{p}</annotation></semantics></math>, which stably has the same homotopy type as the space of functions of tube types <math id="S4.SS2.p5.m22" class="ltx_Math" alttext="\mathcal{T}_{N,k}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>N</mi><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{T}_{N,k}</annotation></semantics></math> in the sense of the present article as discussed in Section <a href="#S3.SS6" title="3.6. The space of tubes ‣ 3. Legendrian tube torsion ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.6</span></a>. The homotopy class of the resulting map <math id="S4.SS2.p5.m23" class="ltx_Math" alttext="M\to\mathcal{T}_{\infty}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">M\to\mathcal{T}_{\infty}</annotation></semantics></math> only depends on the choice of nullhomotopy of the stable Gauss map <math id="S4.SS2.p5.m24" class="ltx_Math" alttext="L\to U/O" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo stretchy="false">→</mo><mrow><mi>U</mi><mo>/</mo><mi>O</mi></mrow></mrow><annotation encoding="application/x-tex">L\to U/O</annotation></semantics></math>.</p>
</div>
<div id="S4.SS2.p6" class="ltx_para">
<p id="S4.SS2.p6.1" class="ltx_p">The monoid <math id="S4.SS2.p6.m1" class="ltx_Math" alttext="[M,\Omega(U/O)]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mi>M</mi><mo>,</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>U</mi><mo>/</mo><mi>O</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[M,\Omega(U/O)]</annotation></semantics></math> (with respect to concatenation of loops in <math id="S4.SS2.p6.m2" class="ltx_Math" alttext="\Omega(U/O)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>U</mi><mo>/</mo><mi>O</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Omega(U/O)</annotation></semantics></math>) acts transitively on the set of homotopy classes of nullhomotopies of the stable Gauss map <math id="S4.SS2.p6.m3" class="ltx_Math" alttext="L\to U/O" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo stretchy="false">→</mo><mrow><mi>U</mi><mo>/</mo><mi>O</mi></mrow></mrow><annotation encoding="application/x-tex">L\to U/O</annotation></semantics></math> of any nearby Lagrangian <math id="S4.SS2.p6.m4" class="ltx_Math" alttext="L\subset T^{*}M" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">L\subset T^{*}M</annotation></semantics></math>, since we may concatenate any such nullhomotopy with the resulting map <math id="S4.SS2.p6.m5" class="ltx_Math" alttext="L\to M\to\Omega(U/O)" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo stretchy="false">→</mo><mi>M</mi><mo stretchy="false">→</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>U</mi><mo>/</mo><mi>O</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">L\to M\to\Omega(U/O)</annotation></semantics></math>. As discussed above, the effect on the resulting class in <math id="S4.SS2.p6.m6" class="ltx_Math" alttext="[M,\mathcal{T}_{\infty}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mi>M</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi mathvariant="normal">∞</mi></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[M,\mathcal{T}_{\infty}]</annotation></semantics></math> is given by the action of <math id="S4.SS2.p6.m7" class="ltx_Math" alttext="[M,BO]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mi>M</mi><mo>,</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[M,BO]</annotation></semantics></math> with respect to the twisted stabilization, i.e. with respect to the rigid tube map <math id="S4.SS2.p6.m8" class="ltx_Math" alttext="BO\to\mathcal{T}_{\infty}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">BO\to\mathcal{T}_{\infty}</annotation></semantics></math>, under the model for Bott periodicity <math id="S4.SS2.p6.m9" class="ltx_Math" alttext="\Omega(U/O)\simeq\mathbf{Z}\times BO" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>U</mi><mo>/</mo><mi>O</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≃</mo><mrow><mrow><mi>𝐙</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>B</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow></mrow><annotation encoding="application/x-tex">\Omega(U/O)\simeq\mathbf{Z}\times BO</annotation></semantics></math> of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx27" title="" class="ltx_ref">G90</a>]</cite>.</p>
</div>
<div id="S4.SS2.p7" class="ltx_para">
<p id="S4.SS2.p7.1" class="ltx_p">Finally, the doubling construction works parametrically, as long as the path of Lagrangians is covered by a homotopy of null-homotopies of the stable Gauss map, so the resulting coset of the map <math id="S4.SS2.p7.m1" class="ltx_Math" alttext="[M,BO]\to[M,\mathcal{T}_{\infty}]" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mrow><mi>M</mi><mo>,</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mrow><mi>M</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi mathvariant="normal">∞</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">[M,BO]\to[M,\mathcal{T}_{\infty}]</annotation></semantics></math> is a Hamiltonian isotopy invariant.</p>
</div>
<div id="S4.Thmtheorem5" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem5.1" class="ltx_text ltx_font_bold">Definition 4.5</span></span><span id="S4.Thmtheorem5.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem5.p1" class="ltx_para">
<p id="S4.Thmtheorem5.p1.1" class="ltx_p">The coset of the map <math id="S4.Thmtheorem5.p1.m1" class="ltx_Math" alttext="[M,BO]\to[M,\mathcal{T}_{\infty}]" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mrow><mi>M</mi><mo>,</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mrow><mi>M</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi mathvariant="normal">∞</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">[M,BO]\to[M,\mathcal{T}_{\infty}]</annotation></semantics></math> distinguished by Proposition <a href="#S4.Thmtheorem4" title="Proposition 4.4. ‣ 4.2. The Guillermou trick ‣ 4. Nearby Lagrangian torsion ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.4</span></a> is be called the <span id="S4.Thmtheorem5.p1.1.1" class="ltx_text ltx_font_italic">natural coset</span>.</p>
</div>
</div>
<div id="S4.Thmtheorem6" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem6.1" class="ltx_text ltx_font_bold">Definition 4.6</span></span><span id="S4.Thmtheorem6.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem6.p1" class="ltx_para">
<p id="S4.Thmtheorem6.p1.1" class="ltx_p">Let <math id="S4.Thmtheorem6.p1.m1" class="ltx_Math" alttext="L\subset T^{*}M" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">L\subset T^{*}M</annotation></semantics></math> be a nearby Lagrangian with trivial stable Gauss map <math id="S4.Thmtheorem6.p1.m2" class="ltx_Math" alttext="L\to U/O" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo stretchy="false">→</mo><mrow><mi>U</mi><mo>/</mo><mi>O</mi></mrow></mrow><annotation encoding="application/x-tex">L\to U/O</annotation></semantics></math>. The <span id="S4.Thmtheorem6.p1.1.1" class="ltx_text ltx_font_italic">nearby Lagrangian torsion</span> <math id="S4.Thmtheorem6.p1.m3" class="ltx_Math" alttext="\nu(L)\subset\tau(L)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\nu(L)\subset\tau(L)</annotation></semantics></math> is the subset of <math id="S4.Thmtheorem6.p1.m4" class="ltx_Math" alttext="H^{*}(M;\mathbf{R})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>𝐑</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{*}(M;\mathbf{R})</annotation></semantics></math> consisting of the (negatives of the) higher torsion classes of tube bundles in the natural coset of <math id="S4.Thmtheorem6.p1.m5" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>.</p>
</div>
</div>
<div id="S4.SS2.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Theorem <a href="#S1.Thmtheorem6" title="Theorem 1.6. ‣ 1.1. Main results ‣ 1. Introduction ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.6</span></a> .</h6>
<div id="S4.SS2.p8" class="ltx_para">
<p id="S4.SS2.p8.1" class="ltx_p"><span id="S4.SS2.p8.1.1" class="ltx_text ltx_font_italic"> </span><span id="S4.SS2.p8.1.2" class="ltx_text"></span></p>
<ol id="S4.I1" class="ltx_enumerate">
<li id="S4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I1.i1.p1" class="ltx_para">
<p id="S4.I1.i1.p1.1" class="ltx_p">that <math id="S4.I1.i1.p1.m1" class="ltx_Math" alttext="\nu(L)" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nu(L)</annotation></semantics></math> is invariant under Hamiltonian isotopies of <math id="S4.I1.i1.p1.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> follows from Proposition <a href="#S4.Thmtheorem4" title="Proposition 4.4. ‣ 4.2. The Guillermou trick ‣ 4. Nearby Lagrangian torsion ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.4</span></a>.</p>
</div></li>
<li id="S4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I1.i2.p1" class="ltx_para">
<p id="S4.I1.i2.p1.1" class="ltx_p">that <math id="S4.I1.i2.p1.m1" class="ltx_Math" alttext="\nu(L)" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nu(L)</annotation></semantics></math> is a single coset of <math id="S4.I1.i2.p1.m2" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> follows from Proposition <a href="#S3.Thmtheorem21" title="Proposition 3.21. ‣ 3.3. Torsion of fibered functions of tube type ‣ 3. Legendrian tube torsion ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.21</span></a>.</p>
</div></li>
<li id="S4.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S4.I1.i3.p1" class="ltx_para">
<p id="S4.I1.i3.p1.1" class="ltx_p">for the zero section we have <math id="S4.I1.i3.p1.m1" class="ltx_Math" alttext="\tau(M)=\text{im}(p)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mtext>im</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau(M)=\text{im}(p)</annotation></semantics></math> by Theorem <a href="#S1.Thmtheorem4" title="Theorem 1.4. ‣ 1.1. Main results ‣ 1. Introduction ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.4</span></a>, so a fortiori <math id="S4.I1.i3.p1.m2" class="ltx_Math" alttext="\nu(M)=\text{im}(p)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ν</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mtext>im</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\nu(M)=\text{im}(p)</annotation></semantics></math>.</p>
</div></li>
</ol>
<p id="S4.SS2.p8.2" class="ltx_p"><span id="S4.SS2.p8.2.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="S4.Thmtheorem7" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem7.1" class="ltx_text ltx_font_bold">Definition 4.7</span></span><span id="S4.Thmtheorem7.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem7.p1" class="ltx_para">
<p id="S4.Thmtheorem7.p1.1" class="ltx_p">Let <math id="S4.Thmtheorem7.p1.m1" class="ltx_Math" alttext="L\subset T^{*}M" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">L\subset T^{*}M</annotation></semantics></math> be a nearby Lagrangian generated by a generating function of tube type <math id="S4.Thmtheorem7.p1.m2" class="ltx_Math" alttext="f:M\times\mathbf{R}^{N}\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐑</mi><mi>N</mi></msup></mrow><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:M\times\mathbf{R}^{N}\to\mathbf{R}</annotation></semantics></math>. We say that <math id="S4.Thmtheorem7.p1.m3" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is <span id="S4.Thmtheorem7.p1.1.1" class="ltx_text ltx_font_italic">natural</span> if it arises from the doubling construction.</p>
</div>
</div>
<div id="S4.Thmtheorem8" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem8.1" class="ltx_text ltx_font_italic">Remark 4.8</span></span><span id="S4.Thmtheorem8.2" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S4.Thmtheorem8.p1" class="ltx_para">
<p id="S4.Thmtheorem8.p1.1" class="ltx_p">To be precise, this means that the doubling construction of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">ACGK</a>]</cite> produces a generating function <math id="S4.Thmtheorem8.p1.m1" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> for <math id="S4.Thmtheorem8.p1.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> which is of tube type in the sense of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">ACGK</a>]</cite> and such that via the modification of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx2" title="" class="ltx_ref">AACK</a>]</cite> the function <math id="S4.Thmtheorem8.p1.m3" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> corresponds to <math id="S4.Thmtheorem8.p1.m4" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>. So <math id="S4.Thmtheorem8.p1.m5" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is a fibered function of tube type in the sense of the present article. Note that <math id="S4.Thmtheorem8.p1.m6" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> being natural implies, but is not a priori equivalent to, that the tube bundle <math id="S4.Thmtheorem8.p1.m7" class="ltx_Math" alttext="W=T(f)" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>=</mo><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">W=T(f)</annotation></semantics></math> is in the natural coset of the rigid tube map.</p>
</div>
</div>
<div id="S4.Thmtheorem9" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem9.1" class="ltx_text ltx_font_italic">Remark 4.9</span></span><span id="S4.Thmtheorem9.2" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S4.Thmtheorem9.p1" class="ltx_para">
<p id="S4.Thmtheorem9.p1.1" class="ltx_p">For <math id="S4.Thmtheorem9.p1.m1" class="ltx_Math" alttext="i=0,1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i=0,1</annotation></semantics></math> let <math id="S4.Thmtheorem9.p1.m2" class="ltx_Math" alttext="L_{i}\subset T^{*}M" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">L_{i}\subset T^{*}M</annotation></semantics></math> be a nearby Lagrangian and let <math id="S4.Thmtheorem9.p1.m3" class="ltx_Math" alttext="\Lambda_{i}\subset J^{1}M" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo>⊂</mo><mrow><msup><mi>J</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">\Lambda_{i}\subset J^{1}M</annotation></semantics></math> be corresponding Legendrian lifts. It could in principle be possible that <math id="S4.Thmtheorem9.p1.m4" class="ltx_Math" alttext="L_{0}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mn>0</mn></msub><annotation encoding="application/x-tex">L_{0}</annotation></semantics></math> and <math id="S4.Thmtheorem9.p1.m5" class="ltx_Math" alttext="L_{1}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mn>1</mn></msub><annotation encoding="application/x-tex">L_{1}</annotation></semantics></math> are not Hamiltonian isotopic but <math id="S4.Thmtheorem9.p1.m6" class="ltx_Math" alttext="\Lambda_{0}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Λ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\Lambda_{0}</annotation></semantics></math> and <math id="S4.Thmtheorem9.p1.m7" class="ltx_Math" alttext="\Lambda_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Λ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\Lambda_{1}</annotation></semantics></math> are Legendrian isotopic. If so, then <math id="S4.Thmtheorem9.p1.m8" class="ltx_Math" alttext="\tau(\Lambda_{0})=\tau(\Lambda_{1})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Λ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Λ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau(\Lambda_{0})=\tau(\Lambda_{1})</annotation></semantics></math>, i.e. their tube torsions agree. However the authors do not know whether tube torsion need be a single <math id="S4.Thmtheorem9.p1.m9" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>-coset, in principle it could be larger. In particular it could be the case that <math id="S4.Thmtheorem9.p1.m10" class="ltx_Math" alttext="\nu(L_{0})\neq\nu(L_{1})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>L</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>L</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\nu(L_{0})\neq\nu(L_{1})</annotation></semantics></math>, i.e. that the nearby Lagrangian torsion <math id="S4.Thmtheorem9.p1.m11" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>-cosets are different, even though the (larger) collections of <math id="S4.Thmtheorem9.p1.m12" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>-cosets <math id="S4.Thmtheorem9.p1.m13" class="ltx_Math" alttext="\tau(\Lambda_{0})=\tau(\Lambda_{1})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Λ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Λ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau(\Lambda_{0})=\tau(\Lambda_{1})</annotation></semantics></math> coincide.</p>
</div>
</div>
</section>
<section id="S4.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.3. </span>Nearby Lagrangians with moderate tangencies</h3>

<div id="S4.SS3.p1" class="ltx_para">
<p id="S4.SS3.p1.1" class="ltx_p">Suppose that <math id="S4.SS3.p1.m1" class="ltx_Math" alttext="L\subset T^{*}M" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">L\subset T^{*}M</annotation></semantics></math> is a nearby Lagrangian whose projection <math id="S4.SS3.p1.m2" class="ltx_Math" alttext="L\to M" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">L\to M</annotation></semantics></math> only has fold type singularities, or equivalently such that the Legendrian front (of Legendrian lift) of <math id="S4.SS3.p1.m3" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> in <math id="S4.SS3.p1.m4" class="ltx_Math" alttext="J^{0}M=M\times\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>J</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>=</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">J^{0}M=M\times\mathbf{R}</annotation></semantics></math> only has cusp singularities. Yet another equivalent condition is that <math id="S4.SS3.p1.m5" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> has quadratic tangencies with respect to the foliation of <math id="S4.SS3.p1.m6" class="ltx_Math" alttext="T^{*}M" display="inline" intent=":literal"><semantics><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">T^{*}M</annotation></semantics></math> by the cotangent leaves <math id="S4.SS3.p1.m7" class="ltx_Math" alttext="T_{m}^{*}M" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>T</mi><mi>m</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">T_{m}^{*}M</annotation></semantics></math>, <math id="S4.SS3.p1.m8" class="ltx_Math" alttext="m\in M" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">m\in M</annotation></semantics></math>, see Figure <a href="#S1.F1" title="Figure 1 ‣ 1.1. Main results ‣ 1. Introduction ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.</p>
</div>
<div id="S4.Thmtheorem10" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem10.1" class="ltx_text ltx_font_bold">Definition 4.10</span></span><span id="S4.Thmtheorem10.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem10.p1" class="ltx_para">
<p id="S4.Thmtheorem10.p1.1" class="ltx_p">We will say that <math id="S4.Thmtheorem10.p1.m1" class="ltx_Math" alttext="L\subset T^{*}M" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">L\subset T^{*}M</annotation></semantics></math> has <span id="S4.Thmtheorem10.p1.1.1" class="ltx_text ltx_font_italic">moderate tangencies</span> when any (and therefore all) of the three equivalent conditions stated above hold.</p>
</div>
</div>
<div id="S4.SS3.p2" class="ltx_para">
<p id="S4.SS3.p2.1" class="ltx_p">Any nearby Lagrangian has trivial Maslov class <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx1" title="" class="ltx_ref">A12</a>]</cite> and so as was explained in Section <a href="#S2.SS4" title="2.4. Stable Gauss map ‣ 2. Legendrian higher torsion ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.4</span></a> whenever <math id="S4.SS3.p2.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> has moderate tangencies the stable Gauss map <math id="S4.SS3.p2.m2" class="ltx_Math" alttext="L\to U/O" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo stretchy="false">→</mo><mrow><mi>U</mi><mo>/</mo><mi>O</mi></mrow></mrow><annotation encoding="application/x-tex">L\to U/O</annotation></semantics></math> is nullhomotopic. In fact we have a canonical nullhomotopy associated to each bounding chain for the cusp locus (co-oriented with the Maslov co-orientation). In particular the tube torsion <math id="S4.SS3.p2.m3" class="ltx_Math" alttext="\tau(L)" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tau(L)</annotation></semantics></math> of <math id="S4.SS3.p2.m4" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> is well-defined, and so is the nearby Lagrangian torsion <math id="S4.SS3.p2.m5" class="ltx_Math" alttext="\nu(L)\subset\tau(L)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\nu(L)\subset\tau(L)</annotation></semantics></math>.</p>
</div>
<div id="S4.SS3.p3" class="ltx_para">
<p id="S4.SS3.p3.1" class="ltx_p">Let <math id="S4.SS3.p3.m1" class="ltx_Math" alttext="L\subset T^{*}M" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">L\subset T^{*}M</annotation></semantics></math> is a nearby Lagrangian with moderate tangencies, then any generating function of tube type <math id="S4.SS3.p3.m2" class="ltx_Math" alttext="f:M\times\mathbf{R}^{N}\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐑</mi><mi>N</mi></msup></mrow><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:M\times\mathbf{R}^{N}\to\mathbf{R}</annotation></semantics></math> for <math id="S4.SS3.p3.m3" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> has moderate singularities. As explained in Appendix <a href="#A2" title="Appendix B Higher torsion of fiber bundles ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B</span></a>, for each generating function of tube type <math id="S4.SS3.p3.m4" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> for <math id="S4.SS3.p3.m5" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> we therefore have an associated cohomology class
<math id="S4.SS3.p3.m6" class="ltx_Math" alttext="\tau_{2k}(f)\in H^{4k}(M;\mathbf{R})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>τ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><msup><mi>H</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>𝐑</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau_{2k}(f)\in H^{4k}(M;\mathbf{R})</annotation></semantics></math> which is the pull-back of the universal class <math id="S4.SS3.p3.m7" class="ltx_Math" alttext="\tau_{4k}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">\tau_{4k}</annotation></semantics></math> in <math id="S4.SS3.p3.m8" class="ltx_Math" alttext="H^{4k}(\text{Wh}_{\bullet}^{h}(\mathbf{C},U(1));\mathbf{R})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo>,</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>𝐑</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{4k}(\text{Wh}_{\bullet}^{h}(\mathbf{C},U(1));\mathbf{R})</annotation></semantics></math> by the map</p>
<table id="S4.Ex31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex31.m1" class="ltx_Math" alttext="\xi_{\bullet}:simp\,M\to\text{Wh}_{\bullet}^{h}(\mathbf{Z}[\pi_{1}W],\pi_{1}W)" display="block" intent=":literal"><semantics><mrow><msub><mi>ξ</mi><mo>∙</mo></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">→</mo><mrow><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐙</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\xi_{\bullet}:simp\,M\to\text{Wh}_{\bullet}^{h}(\mathbf{Z}[\pi_{1}W],\pi_{1}W)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.p3.2" class="ltx_p">obtained from the family of fiberwise Morse chain complexes <math id="S4.SS3.p3.m9" class="ltx_Math" alttext="C_{*}(f_{m})" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{*}(f_{m})</annotation></semantics></math>, <math id="S4.SS3.p3.m10" class="ltx_Math" alttext="m\in M" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">m\in M</annotation></semantics></math>.</p>
</div>
<div id="S4.Thmtheorem11" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem11.1" class="ltx_text ltx_font_bold">Theorem 4.11</span></span><span id="S4.Thmtheorem11.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem11.p1" class="ltx_para">
<p id="S4.Thmtheorem11.p1.1" class="ltx_p"><span id="S4.Thmtheorem11.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmtheorem11.p1.m1" class="ltx_Math" alttext="L\subset T^{*}M" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">L\subset T^{*}M</annotation></semantics></math> is a nearby Lagrangian with moderate tangencies and <math id="S4.Thmtheorem11.p1.m2" class="ltx_Math" alttext="f:M\times\mathbf{R}^{N}\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐑</mi><mi>N</mi></msup></mrow><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:M\times\mathbf{R}^{N}\to\mathbf{R}</annotation></semantics></math> a generating function of tube type for <math id="S4.Thmtheorem11.p1.m3" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>.</span></p>
<ol id="S4.I2" class="ltx_enumerate">
<li id="S4.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I2.i1.p1" class="ltx_para">
<p id="S4.I2.i1.p1.1" class="ltx_p"><span id="S4.I2.i1.p1.1.1" class="ltx_text ltx_font_italic">For </span><math id="S4.I2.i1.p1.m1" class="ltx_Math" alttext="W=T(f)" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>=</mo><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">W=T(f)</annotation></semantics></math><span id="S4.I2.i1.p1.1.2" class="ltx_text ltx_font_italic"> the class </span><math id="S4.I2.i1.p1.m2" class="ltx_Math" alttext="-\tau_{2k}(W)" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><msub><mi>τ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">-\tau_{2k}(W)</annotation></semantics></math><span id="S4.I2.i1.p1.1.3" class="ltx_text ltx_font_italic"> is in the same coset of </span><math id="S4.I2.i1.p1.m3" class="ltx_Math" alttext="\text{im}(p_{k})" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_italic">im</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{im}(p_{k})</annotation></semantics></math><span id="S4.I2.i1.p1.1.4" class="ltx_text ltx_font_italic"> as the class </span><math id="S4.I2.i1.p1.m4" class="ltx_Math" alttext="\tau_{2k}(f)" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tau_{2k}(f)</annotation></semantics></math><span id="S4.I2.i1.p1.1.5" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I2.i2.p1" class="ltx_para">
<p id="S4.I2.i2.p1.1" class="ltx_p"><span id="S4.I2.i2.p1.1.1" class="ltx_text ltx_font_italic">There exists a framed generating function of tube type </span><math id="S4.I2.i2.p1.m1" class="ltx_Math" alttext="h:M\times\mathbf{R}^{K}\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐑</mi><mi>K</mi></msup></mrow><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">h:M\times\mathbf{R}^{K}\to\mathbf{R}</annotation></semantics></math><span id="S4.I2.i2.p1.1.2" class="ltx_text ltx_font_italic"> for </span><math id="S4.I2.i2.p1.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math><span id="S4.I2.i2.p1.1.3" class="ltx_text ltx_font_italic"> such that </span><math id="S4.I2.i2.p1.m3" class="ltx_Math" alttext="\tau_{2k}(f)" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tau_{2k}(f)</annotation></semantics></math><span id="S4.I2.i2.p1.1.4" class="ltx_text ltx_font_italic"> and </span><math id="S4.I2.i2.p1.m4" class="ltx_Math" alttext="\tau_{2k}(h)" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tau_{2k}(h)</annotation></semantics></math><span id="S4.I2.i2.p1.1.5" class="ltx_text ltx_font_italic"> are in the same coset of </span><math id="S4.I2.i2.p1.m5" class="ltx_Math" alttext="\text{im}(p_{k})" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_italic">im</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{im}(p_{k})</annotation></semantics></math><span id="S4.I2.i2.p1.1.6" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S4.I2.i3.p1" class="ltx_para">
<p id="S4.I2.i3.p1.1" class="ltx_p"><span id="S4.I2.i3.p1.1.1" class="ltx_text ltx_font_italic">If </span><math id="S4.I2.i3.p1.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math><span id="S4.I2.i3.p1.1.2" class="ltx_text ltx_font_italic"> is Hamiltonian isotopic to the zero section, then </span><math id="S4.I2.i3.p1.m2" class="ltx_Math" alttext="\tau_{2k}(f)\in\text{im}(p_{k})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>τ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mtext class="ltx_mathvariant_italic">im</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau_{2k}(f)\in\text{im}(p_{k})</annotation></semantics></math><span id="S4.I2.i3.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S4.SS3.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS3.p4" class="ltx_para">
<p id="S4.SS3.p4.1" class="ltx_p"><span id="S4.SS3.p4.1.1" class="ltx_text">Here we use the fact that the projection <math id="S4.SS3.p4.m1" class="ltx_Math" alttext="L\to M" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">L\to M</annotation></semantics></math> of a nearby Lagrangian to the base is a homotopy equivalence <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx1" title="" class="ltx_ref">A12</a>]</cite>.</span></p>
<ol id="S4.I3" class="ltx_enumerate">
<li id="S4.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I3.i1.p1" class="ltx_para">
<p id="S4.I3.i1.p1.1" class="ltx_p">This follows from Proposition <a href="#S3.Thmtheorem29" title="Proposition 3.29. ‣ 3.5. The Legendrian invariant ‣ 3. Legendrian tube torsion ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.29</span></a>.</p>
</div></li>
<li id="S4.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I3.i2.p1" class="ltx_para">
<p id="S4.I3.i2.p1.1" class="ltx_p">This follows from Proposition <a href="#S3.Thmtheorem28" title="Proposition 3.28. ‣ 3.5. The Legendrian invariant ‣ 3. Legendrian tube torsion ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.28</span></a>.</p>
</div></li>
<li id="S4.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S4.I3.i3.p1" class="ltx_para">
<p id="S4.I3.i3.p1.1" class="ltx_p">This follows from item (1) above combined with Theorem <a href="#S1.Thmtheorem4" title="Theorem 1.4. ‣ 1.1. Main results ‣ 1. Introduction ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.4</span></a>.</p>
</div></li>
</ol>
<p id="S4.SS3.p4.2" class="ltx_p"><span id="S4.SS3.p4.2.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="S4.SS3.p5" class="ltx_para">
<p id="S4.SS3.p5.1" class="ltx_p">In particular, the tube torsion <math id="S4.SS3.p5.m1" class="ltx_Math" alttext="\tau(L)" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tau(L)</annotation></semantics></math> of a nearby Lagrangian with moderate singularities tangencies <math id="S4.SS3.p5.m2" class="ltx_Math" alttext="L\subset T^{*}M" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">L\subset T^{*}M</annotation></semantics></math> be computed directly from the parametrized Morse theory of generating functions of tube type for <math id="S4.SS3.p5.m3" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>. Moreover, the nearby Lagrangian torsion <math id="S4.SS3.p5.m4" class="ltx_Math" alttext="\nu(L)" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nu(L)</annotation></semantics></math> of a nearby Lagrangian with moderate tangencies <math id="S4.SS3.p5.m5" class="ltx_Math" alttext="L\subset T^{*}M" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">L\subset T^{*}M</annotation></semantics></math> be computed directly from the parametrized Morse theory of any single natural generating function of tube type for <math id="S4.SS3.p5.m6" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>.</p>
</div>
<div id="S4.SS3.p6" class="ltx_para">
<p id="S4.SS3.p6.1" class="ltx_p">Let <math id="S4.SS3.p6.m1" class="ltx_Math" alttext="\Lambda\subset J^{1}M" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo>⊂</mo><mrow><msup><mi>J</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">\Lambda\subset J^{1}M</annotation></semantics></math> be a Legendrian lift of the exact Lagrangian submanifold <math id="S4.SS3.p6.m2" class="ltx_Math" alttext="L\subset T^{*}M" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">L\subset T^{*}M</annotation></semantics></math> (well-defined up to translation in the <math id="S4.SS3.p6.m3" class="ltx_Math" alttext="z\in\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>∈</mo><mi>𝐑</mi></mrow><annotation encoding="application/x-tex">z\in\mathbf{R}</annotation></semantics></math> direction) and let <math id="S4.SS3.p6.m4" class="ltx_Math" alttext="\pi_{F}:J^{1}M\to J^{0}M=M\times\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>F</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>J</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">→</mo><mrow><msup><mi>J</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>=</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝐑</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi_{F}:J^{1}M\to J^{0}M=M\times\mathbf{R}</annotation></semantics></math> be the front projection. A basic constraint on the parametrized Morse theory of <math id="S4.SS3.p6.m5" class="ltx_Math" alttext="f:M\times\mathbf{R}^{N}\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐑</mi><mi>N</mi></msup></mrow><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:M\times\mathbf{R}^{N}\to\mathbf{R}</annotation></semantics></math> is that the Cerf diagram of such a generating function, i.e. the subset <math id="S4.SS3.p6.m6" class="ltx_math_unparsed" alttext="\{(m,z)\in M\times\mathbf{R}:\,\text{$z$ is not a regular value of $f_{m}:\mathbf{R}^{N}\to\mathbf{R}$}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝐑</mi><mo lspace="0.278em" rspace="0.448em">:</mo><mrow><mi>z</mi><mtext> is not a regular value of </mtext><mrow><msub><mi>f</mi><mi>m</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>𝐑</mi><mi>N</mi></msup><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{(m,z)\in M\times\mathbf{R}:\,\text{$z$ is not a regular value of $f_{m}:\mathbf{R}^{N}\to\mathbf{R}$}\}</annotation></semantics></math> of <math id="S4.SS3.p6.m7" class="ltx_Math" alttext="M\times\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝐑</mi></mrow><annotation encoding="application/x-tex">M\times\mathbf{R}</annotation></semantics></math>, is precisely the front projection <math id="S4.SS3.p6.m8" class="ltx_Math" alttext="\pi_{F}(\Lambda)\subset M\times\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">\pi_{F}(\Lambda)\subset M\times\mathbf{R}</annotation></semantics></math> of <math id="S4.SS3.p6.m9" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>.</p>
</div>
<div id="S4.SS3.p7" class="ltx_para">
<p id="S4.SS3.p7.1" class="ltx_p">The front projection of a nearby Lagrangian <math id="S4.SS3.p7.m1" class="ltx_Math" alttext="L\subset T^{*}M" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">L\subset T^{*}M</annotation></semantics></math> is dramatically restricted by the <span id="S4.SS3.p7.1.1" class="ltx_text ltx_font_italic">absence of Reeb chords</span> in the Legendrian lift <math id="S4.SS3.p7.m2" class="ltx_Math" alttext="\Lambda\subset J^{1}M" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo>⊂</mo><mrow><msup><mi>J</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">\Lambda\subset J^{1}M</annotation></semantics></math> of <math id="S4.SS3.p7.m3" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>, i.e. pairs of distinct points in <math id="S4.SS3.p7.m4" class="ltx_Math" alttext="J^{1}M" display="inline" intent=":literal"><semantics><mrow><msup><mi>J</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">J^{1}M</annotation></semantics></math> which project to the same point in <math id="S4.SS3.p7.m5" class="ltx_Math" alttext="T^{*}M" display="inline" intent=":literal"><semantics><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">T^{*}M</annotation></semantics></math>. Geometrically this means the front <math id="S4.SS3.p7.m6" class="ltx_Math" alttext="\pi_{F}(\Lambda)\subset M\times\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">\pi_{F}(\Lambda)\subset M\times\mathbf{R}</annotation></semantics></math> can have no pairs of point vertically above each other in the <math id="S4.SS3.p7.m7" class="ltx_Math" alttext="z\in\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>∈</mo><mi>𝐑</mi></mrow><annotation encoding="application/x-tex">z\in\mathbf{R}</annotation></semantics></math> direction for which the tangent hyperplanes to <math id="S4.SS3.p7.m8" class="ltx_Math" alttext="\pi_{F}(\Lambda)" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{F}(\Lambda)</annotation></semantics></math> at those two points coincide. For example, this forbids any weaving of 1-dimensional fronts in <math id="S4.SS3.p7.m9" class="ltx_Math" alttext="J^{0}S^{1}=S^{1}\times\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>J</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>S</mi><mn>1</mn></msup></mrow><mo>=</mo><mrow><msup><mi>S</mi><mn>1</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">J^{0}S^{1}=S^{1}\times\mathbf{R}</annotation></semantics></math>.</p>
</div>
<div id="S4.SS3.p8" class="ltx_para">
<p id="S4.SS3.p8.1" class="ltx_p">It is plausible that this strong constraint on the front <math id="S4.SS3.p8.m1" class="ltx_Math" alttext="\pi_{F}(\Lambda)\subset M\times\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">\pi_{F}(\Lambda)\subset M\times\mathbf{R}</annotation></semantics></math>, and hence on the filtration of the fiberwise Morse chain complexes <math id="S4.SS3.p8.m2" class="ltx_Math" alttext="C_{*}(f_{m})" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{*}(f_{m})</annotation></semantics></math>, <math id="S4.SS3.p8.m3" class="ltx_Math" alttext="m\in M" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">m\in M</annotation></semantics></math>, could force the higher torsion <math id="S4.SS3.p8.m4" class="ltx_Math" alttext="\tau_{2k}(f)" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tau_{2k}(f)</annotation></semantics></math> to be zero. Indeed, the filtration on the chain complexes precisely follows the front <math id="S4.SS3.p8.m5" class="ltx_Math" alttext="\pi_{F}(\Lambda)" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{F}(\Lambda)</annotation></semantics></math>. However, the authors of the present article do not know the answer to the following question.</p>
</div>
<div id="S4.Thmtheorem12" class="ltx_theorem ltx_theorem_question">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem12.1" class="ltx_text ltx_font_italic">Question 4.12</span></span><span id="S4.Thmtheorem12.2" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S4.Thmtheorem12.p1" class="ltx_para">
<p id="S4.Thmtheorem12.p1.1" class="ltx_p">Let <math id="S4.Thmtheorem12.p1.m1" class="ltx_Math" alttext="L\subset T^{*}M" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">L\subset T^{*}M</annotation></semantics></math> be a nearby Lagrangian with moderate tangencies and <math id="S4.Thmtheorem12.p1.m2" class="ltx_Math" alttext="f:M\times\mathbf{R}^{N}\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐑</mi><mi>N</mi></msup></mrow><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:M\times\mathbf{R}^{N}\to\mathbf{R}</annotation></semantics></math> a generating function of tube type for <math id="S4.Thmtheorem12.p1.m3" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>. Must it be the case that <math id="S4.Thmtheorem12.p1.m4" class="ltx_Math" alttext="\tau_{2k}(f)\in\text{im}(p_{k})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>τ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mtext>im</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau_{2k}(f)\in\text{im}(p_{k})</annotation></semantics></math>?</p>
</div>
</div>
<div id="S4.SS3.p9" class="ltx_para">
<p id="S4.SS3.p9.1" class="ltx_p">An affirmative answer would follow from the nearby Lagrangian conjecture. Therefore a negative answer would disprove the nearby Lagrangian conjecture.</p>
</div>
<div id="S4.SS3.p10" class="ltx_para">
<p id="S4.SS3.p10.1" class="ltx_p">In the future work <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx9" title="" class="ltx_ref">AIS</a>]</cite> we show that the answer is affirmative if we assume that the front of <math id="S4.SS3.p10.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> carries a <span id="S4.SS3.p10.1.1" class="ltx_text ltx_font_italic">restricted ruling</span>, which is a higher dimensional version of the familiar notion of a ruling of a 1-dimensional Legendrian front. However, our notion of a <span id="S4.SS3.p10.1.2" class="ltx_text ltx_font_italic">restricted ruling</span> is rather restrictive, and does not permit higher codimension bifurcations, which would be inevitable in any sufficiently general notion of higher-dimensional ruling, even under the assumption that <math id="S4.SS3.p10.m2" class="ltx_Math" alttext="L\subset T^{*}M" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">L\subset T^{*}M</annotation></semantics></math> has moderate tangencies. Here <span id="S4.SS3.p10.1.3" class="ltx_text ltx_font_italic">sufficiently general</span> is taken to mean such that the fiberwise Morse theory of a generic generating function of tube type <math id="S4.SS3.p10.m3" class="ltx_Math" alttext="f:M\times\mathbf{R}^{N}\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐑</mi><mi>N</mi></msup></mrow><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:M\times\mathbf{R}^{N}\to\mathbf{R}</annotation></semantics></math> with moderate singularities would produce a family of barcodes <math id="S4.SS3.p10.m4" class="ltx_Math" alttext="B_{m}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>m</mi></msub><annotation encoding="application/x-tex">B_{m}</annotation></semantics></math>, <math id="S4.SS3.p10.m5" class="ltx_Math" alttext="m\in M" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">m\in M</annotation></semantics></math>, whose upper endpoints satisfies the conjectural definition of a ruling.</p>
</div>
</section>
<section id="S4.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.4. </span>Nearby Lagrangian homotopy spheres</h3>

<div id="S4.SS4.p1" class="ltx_para">
<p id="S4.SS4.p1.1" class="ltx_p">We now discuss the special case of nearby Lagrangian homotopy spheres. First, note that for <math id="S4.SS4.p1.m1" class="ltx_Math" alttext="L\subset T^{*}M" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">L\subset T^{*}M</annotation></semantics></math> a nearby Lagrangian, the projection <math id="S4.SS4.p1.m2" class="ltx_Math" alttext="L\to M" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">L\to M</annotation></semantics></math> is a homotopy equivalence and hence if <math id="S4.SS4.p1.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> is a homotopy sphere then <math id="S4.SS4.p1.m4" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> is also a homotopy sphere. The stable Gauss map of any nearby Lagrangian was shown to be zero on homotopy groups in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">ACGK</a>]</cite> and hence when <math id="S4.SS4.p1.m5" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> has the homotopy type of a sphere the map <math id="S4.SS4.p1.m6" class="ltx_Math" alttext="L\to U/O" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo stretchy="false">→</mo><mrow><mi>U</mi><mo>/</mo><mi>O</mi></mrow></mrow><annotation encoding="application/x-tex">L\to U/O</annotation></semantics></math> is nullhomotopic. Combining this input with the the h-principle for the simplification of singularities of Lagrangian fronts <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx5" title="" class="ltx_ref">AG18a</a>, <a href="#bib.bibx6" title="" class="ltx_ref">AG18b</a>]</cite> the first author and Darrow proved the following result.</p>
</div>
<div id="S4.Thmtheorem13" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem13.1" class="ltx_text ltx_font_bold">Theorem 4.13</span></span><span id="S4.Thmtheorem13.2" class="ltx_text ltx_font_bold"> </span>(<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx7" title="" class="ltx_ref">AD22</a>]</cite>)<span id="S4.Thmtheorem13.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem13.p1" class="ltx_para">
<p id="S4.Thmtheorem13.p1.1" class="ltx_p"><span id="S4.Thmtheorem13.p1.1.1" class="ltx_text ltx_font_italic">If <math id="S4.Thmtheorem13.p1.m1" class="ltx_Math" alttext="L\subset T^{*}M" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">L\subset T^{*}M</annotation></semantics></math> is a nearby Lagrangian homotopy sphere, then <math id="S4.Thmtheorem13.p1.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> is Hamiltonian isotopic to a nearby Lagrangian homotopy sphere <math id="S4.Thmtheorem13.p1.m3" class="ltx_Math" alttext="L^{\prime}\subset T^{*}M" display="inline" intent=":literal"><semantics><mrow><msup><mi>L</mi><mo>′</mo></msup><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">L^{\prime}\subset T^{*}M</annotation></semantics></math> with moderate tangencies.</span></p>
</div>
</div>
<div id="S4.SS4.p2" class="ltx_para">
<p id="S4.SS4.p2.1" class="ltx_p">Hence for nearby Lagrangian homotopy spheres <math id="S4.SS4.p2.m1" class="ltx_Math" alttext="L\subset T^{*}M" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">L\subset T^{*}M</annotation></semantics></math> we may always assume from the onset that <math id="S4.SS4.p2.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> has moderate tangencies, so in particular as discussed in Section <a href="#S4.SS3" title="4.3. Nearby Lagrangians with moderate tangencies ‣ 4. Nearby Lagrangian torsion ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a> for any generating function <math id="S4.SS4.p2.m3" class="ltx_Math" alttext="f:M\times\mathbf{R}^{N}\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐑</mi><mi>N</mi></msup></mrow><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:M\times\mathbf{R}^{N}\to\mathbf{R}</annotation></semantics></math> of tube type we may compute the corresponding higher torsion directly from the parametrized Morse theory of <math id="S4.SS4.p2.m4" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>.</p>
</div>
<div id="S4.SS4.p3" class="ltx_para">
<p id="S4.SS4.p3.1" class="ltx_p">Let us put <math id="S4.SS4.p3.m1" class="ltx_Math" alttext="M=S^{n}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>=</mo><msup><mi>S</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">M=S^{n}</annotation></semantics></math> for concreteness, and note that unless <math id="S4.SS4.p3.m2" class="ltx_Math" alttext="n=4k" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mrow><annotation encoding="application/x-tex">n=4k</annotation></semantics></math> all higher torsion classes of tube bundles are trivial. Note that any tube bundle over <math id="S4.SS4.p3.m3" class="ltx_Math" alttext="S^{4k}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><annotation encoding="application/x-tex">S^{4k}</annotation></semantics></math> is orientable. For a tube bundle <math id="S4.SS4.p3.m4" class="ltx_Math" alttext="W\to S^{4k}" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo stretchy="false">→</mo><msup><mi>S</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup></mrow><annotation encoding="application/x-tex">W\to S^{4k}</annotation></semantics></math> there is exactly one higher torsion class which might be nontrivial, namely <math id="S4.SS4.p3.m5" class="ltx_Math" alttext="\tau_{2k}(W)\in H^{4k}(S^{4k};\mathbf{R})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>τ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><msup><mi>H</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>S</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo>,</mo><mi>𝐑</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau_{2k}(W)\in H^{4k}(S^{4k};\mathbf{R})</annotation></semantics></math>. So for a nearby Lagrangian <math id="S4.SS4.p3.m6" class="ltx_Math" alttext="L\subset T^{*}S^{4k}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>S</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">L\subset T^{*}S^{4k}</annotation></semantics></math> the tube torsion <math id="S4.SS4.p3.m7" class="ltx_Math" alttext="\tau(L)" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tau(L)</annotation></semantics></math> and nearby Lagrangian torsion <math id="S4.SS4.p3.m8" class="ltx_Math" alttext="\nu(L)" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nu(L)</annotation></semantics></math> are subsets of <math id="S4.SS4.p3.m9" class="ltx_Math" alttext="H^{4k}(S^{4k};\mathbf{R})\simeq\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>S</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo>,</mo><mi>𝐑</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≃</mo><mi>𝐑</mi></mrow><annotation encoding="application/x-tex">H^{4k}(S^{4k};\mathbf{R})\simeq\mathbf{R}</annotation></semantics></math>, where the isomorphism is by pairing with the fundamental class.</p>
</div>
<div id="S4.SS4.p4" class="ltx_para">
<p id="S4.SS4.p4.1" class="ltx_p">Since <math id="S4.SS4.p4.m1" class="ltx_Math" alttext="KO^{0}(S^{4})\simeq\mathbf{Z}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>O</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>S</mi><mn>4</mn></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≃</mo><mi>𝐙</mi></mrow><annotation encoding="application/x-tex">KO^{0}(S^{4})\simeq\mathbf{Z}</annotation></semantics></math>, the image of <math id="S4.SS4.p4.m2" class="ltx_Math" alttext="p:KO^{0}(S^{4})\to H^{4k}(S^{4k};\mathbf{R})" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>O</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>S</mi><mn>4</mn></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>S</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo>,</mo><mi>𝐑</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">p:KO^{0}(S^{4})\to H^{4k}(S^{4k};\mathbf{R})</annotation></semantics></math> is of the form <math id="S4.SS4.p4.m3" class="ltx_Math" alttext="\lambda_{k}\mathbf{Z}\subset\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐙</mi></mrow><mo>⊂</mo><mi>𝐑</mi></mrow><annotation encoding="application/x-tex">\lambda_{k}\mathbf{Z}\subset\mathbf{R}</annotation></semantics></math>, namely <math id="S4.SS4.p4.m4" class="ltx_Math" alttext="\lambda_{k}=p_{k}(E)" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo>=</mo><mrow><msub><mi>p</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{k}=p_{k}(E)</annotation></semantics></math> for <math id="S4.SS4.p4.m5" class="ltx_Math" alttext="E\to S^{4k}" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo stretchy="false">→</mo><msup><mi>S</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup></mrow><annotation encoding="application/x-tex">E\to S^{4k}</annotation></semantics></math> a generator. So <math id="S4.SS4.p4.m6" class="ltx_Math" alttext="\nu(L)\in\mathbf{R}/\lambda_{k}\mathbf{Z}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mrow><mi>𝐑</mi><mo>/</mo><msub><mi>λ</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐙</mi></mrow></mrow><annotation encoding="application/x-tex">\nu(L)\in\mathbf{R}/\lambda_{k}\mathbf{Z}</annotation></semantics></math> is just a real number modulo <math id="S4.SS4.p4.m7" class="ltx_Math" alttext="\lambda_{k}\mathbf{Z}" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐙</mi></mrow><annotation encoding="application/x-tex">\lambda_{k}\mathbf{Z}</annotation></semantics></math> and <math id="S4.SS4.p4.m8" class="ltx_Math" alttext="\tau(L)\subset\mathbf{R}/\lambda_{k}\mathbf{Z}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><mrow><mi>𝐑</mi><mo>/</mo><msub><mi>λ</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐙</mi></mrow></mrow><annotation encoding="application/x-tex">\tau(L)\subset\mathbf{R}/\lambda_{k}\mathbf{Z}</annotation></semantics></math> is just a collection of real numbers modulo <math id="S4.SS4.p4.m9" class="ltx_Math" alttext="\lambda_{k}\mathbf{Z}" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐙</mi></mrow><annotation encoding="application/x-tex">\lambda_{k}\mathbf{Z}</annotation></semantics></math>. Let <math id="S4.SS4.p4.m10" class="ltx_Math" alttext="J_{k}" display="inline" intent=":literal"><semantics><msub><mi>J</mi><mi>k</mi></msub><annotation encoding="application/x-tex">J_{k}</annotation></semantics></math> denote the index of the monomorphism <math id="S4.SS4.p4.m11" class="ltx_Math" alttext="\mathbf{Z}\to\mathbf{Z}" display="inline" intent=":literal"><semantics><mrow><mi>𝐙</mi><mo stretchy="false">→</mo><mi>𝐙</mi></mrow><annotation encoding="application/x-tex">\mathbf{Z}\to\mathbf{Z}</annotation></semantics></math> given by</p>
<table id="S4.Ex32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex32.m1" class="ltx_Math" alttext="\pi_{4k}BO\to(\pi_{4k}\mathcal{T}_{\infty})/\text{Tors}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow><mo stretchy="false">→</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>π</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi mathvariant="normal">∞</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mtext>Tors</mtext></mrow></mrow><annotation encoding="application/x-tex">\pi_{4k}BO\to(\pi_{4k}\mathcal{T}_{\infty})/\text{Tors}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p4.2" class="ltx_p">As noted in Section <a href="#S3.SS6" title="3.6. The space of tubes ‣ 3. Legendrian tube torsion ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.6</span></a>, higher torsion determines a monomorphism <math id="S4.SS4.p4.m12" class="ltx_Math" alttext="\mathbf{Z}/J_{k}\mathbf{Z}\to\mathbf{R}/\lambda_{k}\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝐙</mi><mo>/</mo><msub><mi>J</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐙</mi></mrow><mo stretchy="false">→</mo><mrow><mrow><mi>𝐑</mi><mo>/</mo><msub><mi>λ</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">\mathbf{Z}/J_{k}\mathbf{Z}\to\mathbf{R}/\lambda_{k}\mathbf{R}</annotation></semantics></math> given by</p>
<table id="S4.Ex33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex33.m1" class="ltx_Math" alttext="\left((\pi_{4k}\mathcal{T}_{\infty})/\text{Tors}\right)/\pi_{4k}BO\to\mathbf{R}/\lambda_{k}\mathbf{Z}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mo>(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>π</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi mathvariant="normal">∞</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mtext>Tors</mtext></mrow><mo>)</mo></mrow><mo>/</mo><msub><mi>π</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow><mo stretchy="false">→</mo><mrow><mrow><mi>𝐑</mi><mo>/</mo><msub><mi>λ</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐙</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\left((\pi_{4k}\mathcal{T}_{\infty})/\text{Tors}\right)/\pi_{4k}BO\to\mathbf{R}/\lambda_{k}\mathbf{Z},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p4.3" class="ltx_p">and hence any tube bundle <math id="S4.SS4.p4.m13" class="ltx_Math" alttext="W\to S^{4k}" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo stretchy="false">→</mo><msup><mi>S</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup></mrow><annotation encoding="application/x-tex">W\to S^{4k}</annotation></semantics></math> whose class in the quotient</p>
<table id="S4.Ex34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex34.m1" class="ltx_Math" alttext="\left((\pi_{4k}\mathcal{T}_{\infty})/\text{Tors}\right)/\pi_{4k}BO" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>π</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi mathvariant="normal">∞</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mtext>Tors</mtext></mrow><mo>)</mo></mrow><mo>/</mo><msub><mi>π</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow><annotation encoding="application/x-tex">\left((\pi_{4k}\mathcal{T}_{\infty})/\text{Tors}\right)/\pi_{4k}BO</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p4.4" class="ltx_p">is non-trivial has a nontrivial higher torsion, i.e. <math id="S4.SS4.p4.m14" class="ltx_Math" alttext="\tau_{2k}(W)\not\in\text{im}(p)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>τ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∉</mo><mrow><mtext>im</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau_{2k}(W)\not\in\text{im}(p)</annotation></semantics></math>. With respect to the above identifications the possible values of higher torsion for any tube bundle <math id="S4.SS4.p4.m15" class="ltx_Math" alttext="W\to S^{4k}" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo stretchy="false">→</mo><msup><mi>S</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup></mrow><annotation encoding="application/x-tex">W\to S^{4k}</annotation></semantics></math> are</p>
<table id="S4.Ex35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex35.m1" class="ltx_math_unparsed" alttext="\tau_{2k}(W)\in\left\{0,\frac{1}{J_{k}}\lambda_{k},\frac{2}{J_{k}}\lambda_{k},\cdots\frac{J_{k}-1}{J_{k}}\lambda_{k}\right\}\simeq\mathbf{Z}/J_{k}\mathbf{Z},\qquad\frac{j}{J_{k}}\lambda_{k}\leftrightarrow j+J_{k}\mathbf{Z}" display="block" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mo>{</mo><mn>0</mn><mo>,</mo><mfrac><mn>1</mn><msub><mi>J</mi><mi>k</mi></msub></mfrac><msub><mi>λ</mi><mi>k</mi></msub><mo>,</mo><mfrac><mn>2</mn><msub><mi>J</mi><mi>k</mi></msub></mfrac><msub><mi>λ</mi><mi>k</mi></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mfrac><mrow><msub><mi>J</mi><mi>k</mi></msub><mo>−</mo><mn>1</mn></mrow><msub><mi>J</mi><mi>k</mi></msub></mfrac><msub><mi>λ</mi><mi>k</mi></msub><mo>}</mo></mrow><mo>≃</mo><mi>𝐙</mi><mo>/</mo><msub><mi>J</mi><mi>k</mi></msub><mi>𝐙</mi><mo rspace="2.167em">,</mo><mfrac><mi>j</mi><msub><mi>J</mi><mi>k</mi></msub></mfrac><msub><mi>λ</mi><mi>k</mi></msub><mo stretchy="false">↔</mo><mi>j</mi><mo>+</mo><msub><mi>J</mi><mi>k</mi></msub><mi>𝐙</mi></mrow><annotation encoding="application/x-tex">\tau_{2k}(W)\in\left\{0,\frac{1}{J_{k}}\lambda_{k},\frac{2}{J_{k}}\lambda_{k},\cdots\frac{J_{k}-1}{J_{k}}\lambda_{k}\right\}\simeq\mathbf{Z}/J_{k}\mathbf{Z},\qquad\frac{j}{J_{k}}\lambda_{k}\leftrightarrow j+J_{k}\mathbf{Z}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.SS4.p5" class="ltx_para">
<p id="S4.SS4.p5.1" class="ltx_p">We summarize the state of affairs in the following theorem, all of which has already been proved.</p>
</div>
<div id="S4.Thmtheorem14" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem14.1" class="ltx_text ltx_font_bold">Theorem 4.14</span></span><span id="S4.Thmtheorem14.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem14.p1" class="ltx_para">
<p id="S4.Thmtheorem14.p1.1" class="ltx_p"><span id="S4.Thmtheorem14.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmtheorem14.p1.m1" class="ltx_Math" alttext="L\subset T^{*}S^{4k}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>S</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">L\subset T^{*}S^{4k}</annotation></semantics></math> be any nearby Lagrangian homotopy sphere.</span></p>
<ol id="S4.I4" class="ltx_enumerate">
<li id="S4.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I4.i1.p1" class="ltx_para">
<p id="S4.I4.i1.p1.1" class="ltx_p"><span id="S4.I4.i1.p1.1.1" class="ltx_text ltx_font_italic">to </span><math id="S4.I4.i1.p1.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math><span id="S4.I4.i1.p1.1.2" class="ltx_text ltx_font_italic"> is assigned its nearby Lagrangian torsion </span><math id="S4.I4.i1.p1.m2" class="ltx_Math" alttext="\nu(L)\in\mathbf{Z}/J_{k}\mathbf{Z}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mrow><mi>𝐙</mi><mo>/</mo><msub><mi>J</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐙</mi></mrow></mrow><annotation encoding="application/x-tex">\nu(L)\in\mathbf{Z}/J_{k}\mathbf{Z}</annotation></semantics></math></p>
</div></li>
<li id="S4.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I4.i2.p1" class="ltx_para">
<p id="S4.I4.i2.p1.1" class="ltx_p"><math id="S4.I4.i2.p1.m1" class="ltx_Math" alttext="\nu(L)" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nu(L)</annotation></semantics></math><span id="S4.I4.i2.p1.1.1" class="ltx_text ltx_font_italic"> is a Hamiltonian isotopy invariant of </span><math id="S4.I4.i2.p1.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math><span id="S4.I4.i2.p1.1.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I4.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S4.I4.i3.p1" class="ltx_para">
<p id="S4.I4.i3.p1.1" class="ltx_p"><span id="S4.I4.i3.p1.1.1" class="ltx_text ltx_font_italic">after an initial Hamiltonian isotopy we may assume that </span><math id="S4.I4.i3.p1.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math><span id="S4.I4.i3.p1.1.2" class="ltx_text ltx_font_italic"> has moderate tangencies.</span></p>
</div></li>
<li id="S4.I4.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S4.I4.i4.p1" class="ltx_para">
<p id="S4.I4.i4.p1.1" class="ltx_p"><span id="S4.I4.i4.p1.1.1" class="ltx_text ltx_font_italic">then </span><math id="S4.I4.i4.p1.m1" class="ltx_Math" alttext="\nu(L)" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nu(L)</annotation></semantics></math><span id="S4.I4.i4.p1.1.2" class="ltx_text ltx_font_italic"> is computed by </span><math id="S4.I4.i4.p1.m2" class="ltx_Math" alttext="\tau_{2k}(f)" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tau_{2k}(f)</annotation></semantics></math><span id="S4.I4.i4.p1.1.3" class="ltx_text ltx_font_italic"> for </span><math id="S4.I4.i4.p1.m3" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math><span id="S4.I4.i4.p1.1.4" class="ltx_text ltx_font_italic"> any natural generating function of tube type for </span><math id="S4.I4.i4.p1.m4" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math><span id="S4.I4.i4.p1.1.5" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I4.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(5)</span> 
<div id="S4.I4.i5.p1" class="ltx_para">
<p id="S4.I4.i5.p1.1" class="ltx_p"><span id="S4.I4.i5.p1.1.1" class="ltx_text ltx_font_italic">it suffices to consider framed natural generating functions of tube type.</span></p>
</div></li>
<li id="S4.I4.i6" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(6)</span> 
<div id="S4.I4.i6.p1" class="ltx_para">
<p id="S4.I4.i6.p1.1" class="ltx_p"><math id="S4.I4.i6.p1.m1" class="ltx_Math" alttext="\nu(L)=0+J_{k}\mathbf{Z}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>0</mn><mo>+</mo><mrow><msub><mi>J</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐙</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\nu(L)=0+J_{k}\mathbf{Z}</annotation></semantics></math><span id="S4.I4.i6.p1.1.1" class="ltx_text ltx_font_italic"> for </span><math id="S4.I4.i6.p1.m2" class="ltx_Math" alttext="L=S^{4k}\subset T^{*}S^{4k}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>=</mo><msup><mi>S</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>S</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">L=S^{4k}\subset T^{*}S^{4k}</annotation></semantics></math><span id="S4.I4.i6.p1.1.2" class="ltx_text ltx_font_italic"> the zero section.</span></p>
</div></li>
<li id="S4.I4.i7" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(7)</span> 
<div id="S4.I4.i7.p1" class="ltx_para">
<p id="S4.I4.i7.p1.1" class="ltx_p"><math id="S4.I4.i7.p1.m1" class="ltx_Math" alttext="\nu(L)\subset\tau(L)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\nu(L)\subset\tau(L)</annotation></semantics></math><span id="S4.I4.i7.p1.1.1" class="ltx_text ltx_font_italic"> for a finite subset </span><math id="S4.I4.i7.p1.m2" class="ltx_Math" alttext="\tau(L)\subset\mathbf{Z}/J_{k}\mathbf{Z}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><mrow><mi>𝐙</mi><mo>/</mo><msub><mi>J</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐙</mi></mrow></mrow><annotation encoding="application/x-tex">\tau(L)\subset\mathbf{Z}/J_{k}\mathbf{Z}</annotation></semantics></math><span id="S4.I4.i7.p1.1.2" class="ltx_text ltx_font_italic">, the tube torsion of </span><math id="S4.I4.i7.p1.m3" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math><span id="S4.I4.i7.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I4.i8" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(8)</span> 
<div id="S4.I4.i8.p1" class="ltx_para">
<p id="S4.I4.i8.p1.1" class="ltx_p"><math id="S4.I4.i8.p1.m1" class="ltx_Math" alttext="\tau(L)" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tau(L)</annotation></semantics></math><span id="S4.I4.i8.p1.1.1" class="ltx_text ltx_font_italic"> is computed by the collection of all </span><math id="S4.I4.i8.p1.m2" class="ltx_Math" alttext="\tau_{2k}(f)" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tau_{2k}(f)</annotation></semantics></math><span id="S4.I4.i8.p1.1.2" class="ltx_text ltx_font_italic"> for </span><math id="S4.I4.i8.p1.m3" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math><span id="S4.I4.i8.p1.1.3" class="ltx_text ltx_font_italic"> a generating function of tube type for </span><math id="S4.I4.i8.p1.m4" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math><span id="S4.I4.i8.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I4.i9" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(9)</span> 
<div id="S4.I4.i9.p1" class="ltx_para">
<p id="S4.I4.i9.p1.1" class="ltx_p"><span id="S4.I4.i9.p1.1.1" class="ltx_text ltx_font_italic">it suffices to consider framed generating functions of tube type.</span></p>
</div></li>
<li id="S4.I4.i10" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(10)</span> 
<div id="S4.I4.i10.p1" class="ltx_para">
<p id="S4.I4.i10.p1.1" class="ltx_p"><math id="S4.I4.i10.p1.m1" class="ltx_Math" alttext="\tau(L)" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tau(L)</annotation></semantics></math><span id="S4.I4.i10.p1.1.1" class="ltx_text ltx_font_italic"> is a Legendrian isotopy invariant of the Legendrian lift of </span><math id="S4.I4.i10.p1.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math><span id="S4.I4.i10.p1.1.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I4.i11" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(11)</span> 
<div id="S4.I4.i11.p1" class="ltx_para">
<p id="S4.I4.i11.p1.1" class="ltx_p"><math id="S4.I4.i11.p1.m1" class="ltx_Math" alttext="\tau(L)=\{0+J_{k}\mathbf{Z}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>+</mo><mrow><msub><mi>J</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐙</mi></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\tau(L)=\{0+J_{k}\mathbf{Z}\}</annotation></semantics></math><span id="S4.I4.i11.p1.1.1" class="ltx_text ltx_font_italic"> for </span><math id="S4.I4.i11.p1.m2" class="ltx_Math" alttext="L=S^{4k}\subset T^{*}S^{4k}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>=</mo><msup><mi>S</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>S</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">L=S^{4k}\subset T^{*}S^{4k}</annotation></semantics></math><span id="S4.I4.i11.p1.1.2" class="ltx_text ltx_font_italic"> the zero section.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S4.SS4.p6" class="ltx_para">
<p id="S4.SS4.p6.1" class="ltx_p">The simplest closed manifold on whose cotangent bundle one might search for a counterexample to the nearby Lagrangian conjecture using the theory of higher torsion is <math id="S4.SS4.p6.m1" class="ltx_Math" alttext="S^{4}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mn>4</mn></msup><annotation encoding="application/x-tex">S^{4}</annotation></semantics></math>. The first step would be to understand an explicit Legendrian <math id="S4.SS4.p6.m2" class="ltx_Math" alttext="\Lambda\subset J^{1}S^{4}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo>⊂</mo><mrow><msup><mi>J</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>S</mi><mn>4</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\Lambda\subset J^{1}S^{4}</annotation></semantics></math> with nontrivial tube torsion, i.e. not in <math id="S4.SS4.p6.m3" class="ltx_Math" alttext="\text{im}(p_{1})" display="inline" intent=":literal"><semantics><mrow><mtext>im</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{im}(p_{1})</annotation></semantics></math>. Presumably one has an explicit function of tube <math id="S4.SS4.p6.m4" class="ltx_Math" alttext="f:S^{4}\times\mathbf{R}^{N}\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>S</mi><mn>4</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐑</mi><mi>N</mi></msup></mrow><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:S^{4}\times\mathbf{R}^{N}\to\mathbf{R}</annotation></semantics></math> and understands the 4-parameter family of fiberwise Morse chain complexes enough to compute <math id="S4.SS4.p6.m5" class="ltx_Math" alttext="\tau_{2}(f)\in H^{4}(S^{4};\mathbf{R})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>τ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><msup><mi>H</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>S</mi><mn>4</mn></msup><mo>,</mo><mi>𝐑</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau_{2}(f)\in H^{4}(S^{4};\mathbf{R})</annotation></semantics></math> and identify it as not in <math id="S4.SS4.p6.m6" class="ltx_Math" alttext="\text{im}(p_{1})" display="inline" intent=":literal"><semantics><mrow><mtext>im</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{im}(p_{1})</annotation></semantics></math>. Then one might try to modify the generating function <math id="S4.SS4.p6.m7" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> to remove whatever Reeb chords are present in <math id="S4.SS4.p6.m8" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> and, if lucky, arrive at a suitable generating function of tube type <math id="S4.SS4.p6.m9" class="ltx_Math" alttext="g:S^{4}\times\mathbf{R}^{N}\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>S</mi><mn>4</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐑</mi><mi>N</mi></msup></mrow><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">g:S^{4}\times\mathbf{R}^{N}\to\mathbf{R}</annotation></semantics></math> which agrees with <math id="S4.SS4.p6.m10" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> at infinity and which generates a Legendrian with no Reeb chords, i.e. a nearby Lagrangian <math id="S4.SS4.p6.m11" class="ltx_Math" alttext="L\subset T^{*}S^{4}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>S</mi><mn>4</mn></msup></mrow></mrow><annotation encoding="application/x-tex">L\subset T^{*}S^{4}</annotation></semantics></math>. Since the underlying tube bundle of <math id="S4.SS4.p6.m12" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> and <math id="S4.SS4.p6.m13" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> are the same, the class <math id="S4.SS4.p6.m14" class="ltx_Math" alttext="\tau_{2}(f)" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tau_{2}(f)</annotation></semantics></math> is in <math id="S4.SS4.p6.m15" class="ltx_Math" alttext="\tau(L)" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tau(L)</annotation></semantics></math>, and hence <math id="S4.SS4.p6.m16" class="ltx_Math" alttext="\tau(L)\neq\text{im}(p_{1})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mrow><mtext>im</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau(L)\neq\text{im}(p_{1})</annotation></semantics></math> so <math id="S4.SS4.p6.m17" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> is the desired counterexample to the nearby Lagrangian conjecture. Of course, <span id="S4.SS4.p6.1.1" class="ltx_text ltx_font_italic">one doesn’t simply remove Reeb chords</span>, so the above strategy is highly dubious. However, it would still be interesting to understand an explicit Legendrian <math id="S4.SS4.p6.m18" class="ltx_Math" alttext="\Lambda\subset J^{1}S^{4}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo>⊂</mo><mrow><msup><mi>J</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>S</mi><mn>4</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\Lambda\subset J^{1}S^{4}</annotation></semantics></math> with nontrivial tube torsion.</p>
</div>
</section>
<section id="S4.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.5. </span>Floer theoretic perspective</h3>

<div id="S4.SS5.p1" class="ltx_para">
<p id="S4.SS5.p1.1" class="ltx_p">The nearby Lagrangian torsion of a nearby Lagrangian <math id="S4.SS5.p1.m1" class="ltx_Math" alttext="L\subset T^{*}M" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">L\subset T^{*}M</annotation></semantics></math> can probably be defined via Floer theory, loosely speaking by considering the family of Floer cochain complexes <math id="S4.SS5.p1.m2" class="ltx_Math" alttext="CF^{*}(T^{*}_{m}M,L)" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>F</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>T</mi><mi>m</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>,</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF^{*}(T^{*}_{m}M,L)</annotation></semantics></math>, <math id="S4.SS5.p1.m3" class="ltx_Math" alttext="m\in M" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">m\in M</annotation></semantics></math>, and upgrading the family Floer perspective to the K-theoretic level. Somewhat more concretely, if the tangencies of <math id="S4.SS5.p1.m4" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> with respect to the foliation by cotangent fibres <math id="S4.SS5.p1.m5" class="ltx_Math" alttext="T^{*}_{m}M" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>T</mi><mi>m</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">T^{*}_{m}M</annotation></semantics></math>, <math id="S4.SS5.p1.m6" class="ltx_Math" alttext="m\in M" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">m\in M</annotation></semantics></math>, then after a suitable bifurcation analysis in exact Lagrangian Floer theory, analogous to the corresponding analysis in parametrized Morse theory and generalizing the 1 and 2 parametric case treated in the work of the third author <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx59" title="" class="ltx_ref">S02</a>]</cite>, one may expect to use the family of Floer cochain complexes <math id="S4.SS5.p1.m7" class="ltx_Math" alttext="CF^{*}(T^{*}_{m}M,\varphi_{1}(L))" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>F</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>T</mi><mi>m</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>,</mo><mrow><msub><mi>φ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF^{*}(T^{*}_{m}M,\varphi_{1}(L))</annotation></semantics></math>, <math id="S4.SS5.p1.m8" class="ltx_Math" alttext="m\in S^{4k}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><msup><mi>S</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup></mrow><annotation encoding="application/x-tex">m\in S^{4k}</annotation></semantics></math>, to define a map <math id="S4.SS5.p1.m9" class="ltx_Math" alttext="M\to|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo stretchy="false">→</mo><mrow><mo stretchy="false">|</mo><mrow><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">M\to|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|</annotation></semantics></math>.</p>
</div>
<div id="S4.Thmtheorem15" class="ltx_theorem ltx_theorem_conjecture">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem15.1" class="ltx_text ltx_font_bold">Conjecture 4.15</span></span><span id="S4.Thmtheorem15.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem15.p1" class="ltx_para">
<p id="S4.Thmtheorem15.p1.1" class="ltx_p"><span id="S4.Thmtheorem15.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmtheorem15.p1.m1" class="ltx_Math" alttext="L\subset T^{*}M" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">L\subset T^{*}M</annotation></semantics></math> be a nearby Lagrangian with moderate tangencies with respect to the foliation by cotangent fibres. The family of Floer cochain complexes <math id="S4.Thmtheorem15.p1.m2" class="ltx_Math" alttext="CF^{*}(T^{*}_{x}S^{4k},\varphi_{1}(L))" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>F</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>T</mi><mi>x</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>S</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup></mrow><mo>,</mo><mrow><msub><mi>φ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF^{*}(T^{*}_{x}S^{4k},\varphi_{1}(L))</annotation></semantics></math>, <math id="S4.Thmtheorem15.p1.m3" class="ltx_Math" alttext="x\in S^{4k}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msup><mi>S</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup></mrow><annotation encoding="application/x-tex">x\in S^{4k}</annotation></semantics></math> determines a map <math id="S4.Thmtheorem15.p1.m4" class="ltx_Math" alttext="S^{4k}\to|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|" display="inline" intent=":literal"><semantics><mrow><msup><mi>S</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo stretchy="false">→</mo><mrow><mo stretchy="false">|</mo><mrow><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">S^{4k}\to|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|</annotation></semantics></math> whose homotopy class is independent of auxiliary choices (such as a suitable almost complex structure).</span></p>
</div>
</div>
<div id="S4.SS5.p2" class="ltx_para">
<p id="S4.SS5.p2.1" class="ltx_p">It is not known whether any nearby Lagrangian is Hamiltonian isotopic to one with moderate tangencies. A necessary condition for this to be possible is that the stable Gauss map is trivial. Let us concentrate on the case where <math id="S4.SS5.p2.m1" class="ltx_Math" alttext="M=S^{4k}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>=</mo><msup><mi>S</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup></mrow><annotation encoding="application/x-tex">M=S^{4k}</annotation></semantics></math>, since the condition on the stable triviality of the Gauss map is automatically satisfied by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">ACGK</a>]</cite> and moreover this condition is also sufficient for the simplification of tangencies to be possible <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx7" title="" class="ltx_ref">AD22</a>]</cite>.</p>
</div>
<div id="S4.SS5.p3" class="ltx_para">
<p id="S4.SS5.p3.1" class="ltx_p">Given a Lagrangian homotopy sphere <math id="S4.SS5.p3.m1" class="ltx_Math" alttext="L\subset T^{*}S^{4k}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>S</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">L\subset T^{*}S^{4k}</annotation></semantics></math>, fix a choice <math id="S4.SS5.p3.m2" class="ltx_Math" alttext="\gamma_{t}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\gamma_{t}</annotation></semantics></math> of nullhomotopy of the stable Gauss map <math id="S4.SS5.p3.m3" class="ltx_Math" alttext="L\to U/O" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo stretchy="false">→</mo><mrow><mi>U</mi><mo>/</mo><mi>O</mi></mrow></mrow><annotation encoding="application/x-tex">L\to U/O</annotation></semantics></math>. Then Theorem <a href="#S4.Thmtheorem13" title="Theorem 4.13 ([]). ‣ 4.4. Nearby Lagrangian homotopy spheres ‣ 4. Nearby Lagrangian torsion ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.13</span></a> as formulated in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx7" title="" class="ltx_ref">AD22</a>]</cite> yields a Hamiltonian isotopy <math id="S4.SS5.p3.m4" class="ltx_Math" alttext="\varphi_{t}" display="inline" intent=":literal"><semantics><msub><mi>φ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\varphi_{t}</annotation></semantics></math> such that the singularities of tangency the Lagrangian <math id="S4.SS5.p3.m5" class="ltx_Math" alttext="K=\varphi_{1}(L)" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mrow><msub><mi>φ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">K=\varphi_{1}(L)</annotation></semantics></math> with respect to the foliation by cotangent fibers are all of fold type. Although the nearby Lagrangian <math id="S4.SS5.p3.m6" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> produced by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx7" title="" class="ltx_ref">AD22</a>]</cite> does not depend uniquely on the nullhomotopy <math id="S4.SS5.p3.m7" class="ltx_Math" alttext="\gamma_{t}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\gamma_{t}</annotation></semantics></math> (there are many choices involved), the parametric h-principle for the simplification of caustics <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx5" title="" class="ltx_ref">AG18a</a>, <a href="#bib.bibx6" title="" class="ltx_ref">AG18b</a>]</cite> implies that <math id="S4.SS5.p3.m8" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> is unique up to a Hamiltonian isotopy in which the tangencies remain moderate (birth/death is allowed along double folds). In particular it is natural to expect the following.</p>
</div>
<div id="S4.Thmtheorem16" class="ltx_theorem ltx_theorem_conjecture">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem16.1" class="ltx_text ltx_font_bold">Conjecture 4.16</span></span><span id="S4.Thmtheorem16.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem16.p1" class="ltx_para">
<p id="S4.Thmtheorem16.p1.1" class="ltx_p"><span id="S4.Thmtheorem16.p1.1.1" class="ltx_text ltx_font_italic">The homotopy class of map <math id="S4.Thmtheorem16.p1.m1" class="ltx_Math" alttext="S^{4k}\to|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|" display="inline" intent=":literal"><semantics><mrow><msup><mi>S</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo stretchy="false">→</mo><mrow><mo stretchy="false">|</mo><mrow><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">S^{4k}\to|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|</annotation></semantics></math> corresponding to the nearby Lagrangian with moderate tangencies <math id="S4.Thmtheorem16.p1.m2" class="ltx_Math" alttext="K=\varphi_{1}(L)" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mrow><msub><mi>φ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">K=\varphi_{1}(L)</annotation></semantics></math> only depends on the nullhomotopy <math id="S4.Thmtheorem16.p1.m3" class="ltx_Math" alttext="\gamma_{t}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\gamma_{t}</annotation></semantics></math> of the stable Gauss map <math id="S4.Thmtheorem16.p1.m4" class="ltx_Math" alttext="L\to U/O" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo stretchy="false">→</mo><mrow><mi>U</mi><mo>/</mo><mi>O</mi></mrow></mrow><annotation encoding="application/x-tex">L\to U/O</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS5.p4" class="ltx_para">
<p id="S4.SS5.p4.1" class="ltx_p">By pullback of the universal class one therefore obtains a cohomology class <math id="S4.SS5.p4.m1" class="ltx_Math" alttext="\tau_{2k}(L,\gamma_{t})\in H^{4k}(S^{4k},\mathbf{R})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>τ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo>,</mo><msub><mi>γ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><msup><mi>H</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>S</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo>,</mo><mi>𝐑</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau_{2k}(L,\gamma_{t})\in H^{4k}(S^{4k},\mathbf{R})</annotation></semantics></math> associated to any nullhomotopy <math id="S4.SS5.p4.m2" class="ltx_Math" alttext="\gamma_{t}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\gamma_{t}</annotation></semantics></math> of the stable Gauss map <math id="S4.SS5.p4.m3" class="ltx_Math" alttext="L\to U/O" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo stretchy="false">→</mo><mrow><mi>U</mi><mo>/</mo><mi>O</mi></mrow></mrow><annotation encoding="application/x-tex">L\to U/O</annotation></semantics></math>. Two different choices of nullhomotopy <math id="S4.SS5.p4.m4" class="ltx_Math" alttext="\gamma_{t}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\gamma_{t}</annotation></semantics></math> will differ by a map <math id="S4.SS5.p4.m5" class="ltx_Math" alttext="L\to\Omega(U/O)=\mathbf{Z}\times BO" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo stretchy="false">→</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>U</mi><mo>/</mo><mi>O</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>𝐙</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>B</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow></mrow><annotation encoding="application/x-tex">L\to\Omega(U/O)=\mathbf{Z}\times BO</annotation></semantics></math>. From analogy with the theory developed in the present article, it is natural to expect the following additional property to hold:</p>
</div>
<div id="S4.Thmtheorem17" class="ltx_theorem ltx_theorem_conjecture">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem17.1" class="ltx_text ltx_font_bold">Conjecture 4.17</span></span><span id="S4.Thmtheorem17.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem17.p1" class="ltx_para">
<p id="S4.Thmtheorem17.p1.1" class="ltx_p"><span id="S4.Thmtheorem17.p1.1.1" class="ltx_text ltx_font_italic">The cohomology classes <math id="S4.Thmtheorem17.p1.m1" class="ltx_Math" alttext="\tau_{2k}(L,\gamma_{t}^{i})\in H^{4k}(S^{4k};\mathbf{Z})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>τ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo>,</mo><msubsup><mi>γ</mi><mi>t</mi><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><msup><mi>H</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>S</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo>,</mo><mi>𝐙</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau_{2k}(L,\gamma_{t}^{i})\in H^{4k}(S^{4k};\mathbf{Z})</annotation></semantics></math>, <math id="S4.Thmtheorem17.p1.m2" class="ltx_Math" alttext="i=1,2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">i=1,2</annotation></semantics></math>, corresponding to two different nullhomotopies <math id="S4.Thmtheorem17.p1.m3" class="ltx_Math" alttext="\gamma_{t}^{0}" display="inline" intent=":literal"><semantics><msubsup><mi>γ</mi><mi>t</mi><mn>0</mn></msubsup><annotation encoding="application/x-tex">\gamma_{t}^{0}</annotation></semantics></math> and <math id="S4.Thmtheorem17.p1.m4" class="ltx_Math" alttext="\gamma_{t}^{1}" display="inline" intent=":literal"><semantics><msubsup><mi>γ</mi><mi>t</mi><mn>1</mn></msubsup><annotation encoding="application/x-tex">\gamma_{t}^{1}</annotation></semantics></math>of <math id="S4.Thmtheorem17.p1.m5" class="ltx_Math" alttext="L\to U/O" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo stretchy="false">→</mo><mrow><mi>U</mi><mo>/</mo><mi>O</mi></mrow></mrow><annotation encoding="application/x-tex">L\to U/O</annotation></semantics></math> differ by <math id="S4.Thmtheorem17.p1.m6" class="ltx_Math" alttext="p_{k}(E)" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{k}(E)</annotation></semantics></math> for <math id="S4.Thmtheorem17.p1.m7" class="ltx_Math" alttext="E\to S^{4k}" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo stretchy="false">→</mo><msup><mi>S</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup></mrow><annotation encoding="application/x-tex">E\to S^{4k}</annotation></semantics></math> the stable real vector bundle over <math id="S4.Thmtheorem17.p1.m8" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> classified by the map <math id="S4.Thmtheorem17.p1.m9" class="ltx_Math" alttext="S^{4k}\to BO" display="inline" intent=":literal"><semantics><mrow><msup><mi>S</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo stretchy="false">→</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow></mrow><annotation encoding="application/x-tex">S^{4k}\to BO</annotation></semantics></math> which is the composition of</span></p>
<ol id="S4.I5" class="ltx_enumerate">
<li id="S4.I5.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I5.i1.p1" class="ltx_para">
<p id="S4.I5.i1.p1.1" class="ltx_p"><span id="S4.I5.i1.p1.1.1" class="ltx_text ltx_font_italic">a homotopy inverse </span><math id="S4.I5.i1.p1.m1" class="ltx_Math" alttext="S^{4k}\to L" display="inline" intent=":literal"><semantics><mrow><msup><mi>S</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo stretchy="false">→</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">S^{4k}\to L</annotation></semantics></math><span id="S4.I5.i1.p1.1.2" class="ltx_text ltx_font_italic"> for the projection </span><math id="S4.I5.i1.p1.m2" class="ltx_Math" alttext="L\to S^{4k}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo stretchy="false">→</mo><msup><mi>S</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup></mrow><annotation encoding="application/x-tex">L\to S^{4k}</annotation></semantics></math><span id="S4.I5.i1.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I5.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I5.i2.p1" class="ltx_para">
<p id="S4.I5.i2.p1.1" class="ltx_p"><span id="S4.I5.i2.p1.1.1" class="ltx_text ltx_font_italic">the map </span><math id="S4.I5.i2.p1.m1" class="ltx_Math" alttext="L\to\Omega(U/O)" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo stretchy="false">→</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>U</mi><mo>/</mo><mi>O</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">L\to\Omega(U/O)</annotation></semantics></math><span id="S4.I5.i2.p1.1.2" class="ltx_text ltx_font_italic"> obtained by concatenating </span><math id="S4.I5.i2.p1.m2" class="ltx_Math" alttext="\gamma_{1-t}^{0}" display="inline" intent=":literal"><semantics><msubsup><mi>γ</mi><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mn>0</mn></msubsup><annotation encoding="application/x-tex">\gamma_{1-t}^{0}</annotation></semantics></math><span id="S4.I5.i2.p1.1.3" class="ltx_text ltx_font_italic"> with </span><math id="S4.I5.i2.p1.m3" class="ltx_Math" alttext="\gamma_{t}^{1}" display="inline" intent=":literal"><semantics><msubsup><mi>γ</mi><mi>t</mi><mn>1</mn></msubsup><annotation encoding="application/x-tex">\gamma_{t}^{1}</annotation></semantics></math><span id="S4.I5.i2.p1.1.4" class="ltx_text ltx_font_italic"> at each point of </span><math id="S4.I5.i2.p1.m4" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math><span id="S4.I5.i2.p1.1.5" class="ltx_text ltx_font_italic"> to obtain a loop in </span><math id="S4.I5.i2.p1.m5" class="ltx_Math" alttext="U/O" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>/</mo><mi>O</mi></mrow><annotation encoding="application/x-tex">U/O</annotation></semantics></math><span id="S4.I5.i2.p1.1.6" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I5.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S4.I5.i3.p1" class="ltx_para">
<p id="S4.I5.i3.p1.1" class="ltx_p"><span id="S4.I5.i3.p1.1.1" class="ltx_text ltx_font_italic">the Bott periodicity map </span><math id="S4.I5.i3.p1.m1" class="ltx_Math" alttext="\Omega(U/O)\simeq\mathbf{Z}\times BO" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>U</mi><mo>/</mo><mi>O</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≃</mo><mrow><mrow><mi>𝐙</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>B</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow></mrow><annotation encoding="application/x-tex">\Omega(U/O)\simeq\mathbf{Z}\times BO</annotation></semantics></math><span id="S4.I5.i3.p1.1.2" class="ltx_text ltx_font_italic"> as in </span><cite class="ltx_cite ltx_citemacro_cite"><span id="S4.I5.i3.p1.1.3" class="ltx_text ltx_font_italic">[</span><a href="#bib.bibx27" title="" class="ltx_ref">G90</a><span id="S4.I5.i3.p1.1.4" class="ltx_text ltx_font_italic">]</span></cite><span id="S4.I5.i3.p1.1.5" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I5.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S4.I5.i4.p1" class="ltx_para">
<p id="S4.I5.i4.p1.1" class="ltx_p"><span id="S4.I5.i4.p1.1.1" class="ltx_text ltx_font_italic">the forgetful map </span><math id="S4.I5.i4.p1.m1" class="ltx_Math" alttext="\mathbf{Z}\times BO\to BO" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝐙</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>B</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow><mo stretchy="false">→</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow></mrow><annotation encoding="application/x-tex">\mathbf{Z}\times BO\to BO</annotation></semantics></math><span id="S4.I5.i4.p1.1.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S4.SS5.p5" class="ltx_para">
<p id="S4.SS5.p5.1" class="ltx_p">Thus one would obtain a well-defined coset of <math id="S4.SS5.p5.m1" class="ltx_Math" alttext="\text{im}(p_{k})\subset H^{4k}(S^{4k},\mathbf{R})" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>im</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><msup><mi>H</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>S</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo>,</mo><mi>𝐑</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{im}(p_{k})\subset H^{4k}(S^{4k},\mathbf{R})</annotation></semantics></math>, i.e. a Floer-theoretic nearby Lagrangian torsion <math id="S4.SS5.p5.m2" class="ltx_Math" alttext="\nu^{\text{FL}}(L)\in\mathbf{R}/\lambda_{k}\mathbf{Z}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>ν</mi><mtext>FL</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mrow><mi>𝐑</mi><mo>/</mo><msub><mi>λ</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐙</mi></mrow></mrow><annotation encoding="application/x-tex">\nu^{\text{FL}}(L)\in\mathbf{R}/\lambda_{k}\mathbf{Z}</annotation></semantics></math> which is invariant under Hamiltonian isotopy of <math id="S4.SS5.p5.m3" class="ltx_Math" alttext="L\subset T^{*}S^{4k}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>S</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">L\subset T^{*}S^{4k}</annotation></semantics></math>.</p>
</div>
<div id="S4.Thmtheorem18" class="ltx_theorem ltx_theorem_conjecture">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem18.1" class="ltx_text ltx_font_bold">Conjecture 4.18</span></span><span id="S4.Thmtheorem18.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem18.p1" class="ltx_para">
<p id="S4.Thmtheorem18.p1.1" class="ltx_p"><span id="S4.Thmtheorem18.p1.1.1" class="ltx_text ltx_font_italic">This coset is the same as the nearby Lagrangian torsion, i.e. <math id="S4.Thmtheorem18.p1.m1" class="ltx_Math" alttext="\nu^{\text{FL}}(L)=\nu(L)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>ν</mi><mtext class="ltx_mathvariant_italic">FL</mtext></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>ν</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\nu^{\text{FL}}(L)=\nu(L)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS5.p6" class="ltx_para">
<p id="S4.SS5.p6.1" class="ltx_p">It would be interesting to know if there is a Floer theoretic proof of the triviality of nearby Lagrangian torsion, as predicted by the nearby Lagrangian conjecture. Indeed, one might expect the Floer theoretic setup to be more sensitive to the property of being an exact Lagrangian submanifold than the Morse theoretic approach via generating functions.
In the Floer set-up, the embeddedness implies there are no pseudo-holomorphic disks with a single boundary puncture that arise in as limiting-bubbles in Gromov compactness. Algebraically, this enables one to avoid relying on so-called augmentations from Legendrian/symplectic field theory.
In contrast, it is far from clear how the lack of Reeb chords is related to the paramerized Morse theory of a generating function, which after all is a fiberwise phenomenon.
Indeed, the Morse-theoretic theory of higher torsion via generating functions makes sense for Legendrians in <math id="S4.SS5.p6.m1" class="ltx_Math" alttext="J^{1}M" display="inline" intent=":literal"><semantics><mrow><msup><mi>J</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">J^{1}M</annotation></semantics></math>, whether or not they have Reeb chords.</p>
</div>
</section>
</section>
<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Moderate singularities</h2>

<section id="A1.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.1. </span>Functions with moderate singularities</h3>

<div id="A1.SS1.p1" class="ltx_para">
<p id="A1.SS1.p1.1" class="ltx_p">For <math id="A1.SS1.p1.m1" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> a smooth manifold, a function <math id="A1.SS1.p1.m2" class="ltx_Math" alttext="f:F\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>F</mi><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:F\to\mathbf{R}</annotation></semantics></math> has <span id="A1.SS1.p1.1.1" class="ltx_text ltx_font_italic">moderate singularities</span> if its singularities are modeled on either the Morse normal form</p>
<table id="A1.Ex36" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex36.m1" class="ltx_Math" alttext="\sum_{i\leq k}x_{i}^{2}-\sum_{i&gt;k}x_{i}^{2}" display="block" intent=":literal"><semantics><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>≤</mo><mi>k</mi></mrow></munder><msubsup><mi>x</mi><mi>i</mi><mn>2</mn></msubsup></mrow><mo rspace="0.055em">−</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>&gt;</mo><mi>k</mi></mrow></munder><msubsup><mi>x</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\sum_{i\leq k}x_{i}^{2}-\sum_{i&gt;k}x_{i}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p1.2" class="ltx_p">or on the cubic (birth/death) form</p>
<table id="A1.Ex37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex37.m1" class="ltx_Math" alttext="x_{1}^{3}+\sum_{1&lt;i\leq k}x_{i}^{2}-\sum_{i&gt;k}x_{i}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>x</mi><mn>1</mn><mn>3</mn></msubsup><mo rspace="0.055em">+</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mn>1</mn><mo>&lt;</mo><mi>i</mi><mo>≤</mo><mi>k</mi></mrow></munder><msubsup><mi>x</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo rspace="0.055em">−</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>&gt;</mo><mi>k</mi></mrow></munder><msubsup><mi>x</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">x_{1}^{3}+\sum_{1&lt;i\leq k}x_{i}^{2}-\sum_{i&gt;k}x_{i}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p1.3" class="ltx_p">Note that at a birth/death point of <math id="A1.SS1.p1.m3" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>, the kernel of the hessian <math id="A1.SS1.p1.m4" class="ltx_Math" alttext="d^{2}f" display="inline" intent=":literal"><semantics><mrow><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><annotation encoding="application/x-tex">d^{2}f</annotation></semantics></math> is one dimensional and is trivialized by the direction in which <math id="A1.SS1.p1.m5" class="ltx_Math" alttext="d^{3}f" display="inline" intent=":literal"><semantics><mrow><msup><mi>d</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><annotation encoding="application/x-tex">d^{3}f</annotation></semantics></math> is positive. We call this the <span id="A1.SS1.p1.3.1" class="ltx_text ltx_font_italic">canonical co-orientation</span>. See Figure <a href="#A1.F9" title="Figure 9 ‣ A.1. Functions with moderate singularities ‣ Appendix A Moderate singularities ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>.</p>
</div>
<figure id="A1.F9" class="ltx_figure"><span class="ltx_inline-block"><svg id="A1.F9.pic1" class="ltx_picture ltx_centering" height="249.14" overflow="visible" version="1.1" viewBox="0 0 464.86 249.14" width="464.86"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,249.14) matrix(1 0 0 -1 0 0) translate(-2.2,0) translate(0,28.11)"><g stroke-width="0.8pt"><path style="fill:none" d="M 27.56 8.27 C 44.09 63.39 99.21 2.76 107.48 57.87"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M 27.56 8.27 C 27.56 -13.78 82.68 -13.78 137.79 -27.56"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M 137.79 -27.56 L 137.79 35.83 C 121.26 41.34 107.48 44.09 107.48 57.87 C 107.48 68.9 137.79 68.9 165.35 63.39 L 165.35 0"></path></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt"><path style="fill:none" d="M 27.56 8.27 C 27.56 13.78 55.12 19.29 137.79 4.41"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M 137.79 4.41 L 165.35 0"></path></g><g stroke-width="0.4pt"><path style="fill:none" d="M 79.92 27.56"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 76.46 24.48)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.44em;--ltx-fo-depth:0em;font-size:10pt;" height="6.15" overflow="visible" transform="matrix(1 0 0 -1 0 6.15)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A1.F9.pic1.m1" class="ltx_Math" alttext="\bullet" display="inline" intent=":literal"><semantics><mo>∙</mo><annotation encoding="application/x-tex">\bullet</annotation></semantics></math></span></span></foreignObject></g><g stroke-width="0.8pt"><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M 79.92 27.56 L 144.96 19.43"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.99228 -0.12404 0.12404 0.99228 145.51 19.36)"><path style="fill:none" d="M -3.54 4.32 C -2.9 1.73 -1.45 0.5 0 0 C -1.45 -0.5 -2.9 -1.73 -3.54 -4.32"></path></g></g><path style="fill:none" d="M 206.69 33.07"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 211.58 28.27)"><foreignObject style="--ltx-fo-width:18.16em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="251.26"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A1.F9.pic1.1" class="ltx_text">Birth-death with canonical co-orientation</span></span></span></foreignObject></g><clipPath id="pgfcp19"><path d="M 137.79 0 M 137.79 0 L 137.79 27.56 L 154.33 27.56 L 154.33 0 Z M 154.33 27.56"></path></clipPath><g clip-path="url(#pgfcp19)"><g stroke-width="0.8pt"><path style="fill:none" d="M 79.92 27.56 L 144.96 19.43"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.99228 -0.12404 0.12404 0.99228 145.51 19.36)"><path style="fill:none" d="M -3.54 4.32 C -2.9 1.73 -1.45 0.5 0 0 C -1.45 -0.5 -2.9 -1.73 -3.54 -4.32"></path></g></g><g></g></g><path style="fill:none" d="M 84.61 170.04"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 81.15 166.96)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.44em;--ltx-fo-depth:0em;font-size:10pt;" height="6.15" overflow="visible" transform="matrix(1 0 0 -1 0 6.15)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A1.F9.pic1.m2" class="ltx_Math" alttext="\bullet" display="inline" intent=":literal"><semantics><mo>∙</mo><annotation encoding="application/x-tex">\bullet</annotation></semantics></math></span></span></foreignObject></g><g stroke-width="0.8pt"><path style="fill:none" d="M 2.76 137.79 C 13.78 157.09 13.78 173.62 13.78 192.91 C 41.34 195.67 55.12 195.67 55.12 206.69 C 55.12 212.2 41.34 220.47 33.07 220.47 L 33.07 195.67"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M 55.12 203.94 C 55.12 165.35 121.26 165.35 121.26 195.67"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M 2.76 137.79 C 41.34 137.79 96.46 124.02 151.57 110.24"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M 151.57 110.24 L 151.57 173.62 C 135.04 179.13 121.26 181.89 121.26 195.67 C 121.26 206.69 151.57 206.69 179.13 201.18 L 179.13 137.79"></path></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" stroke-width="0.8pt"><path style="fill:none" d="M 33.07 195.67 L 33.07 159.84 L 151.57 141.38"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M 151.57 141.38 L 179.13 137.79"></path></g><path style="fill:none" d="M 220.47 179.13"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 225.36 175.75)"><foreignObject style="--ltx-fo-width:5.26em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.15" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="72.76"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A1.F9.pic1.2" class="ltx_text">Morse point</span></span></span></foreignObject></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 9. </span>Morse and birth-death points.</figcaption>
</figure>
<div id="A1.SS1.p2" class="ltx_para">
<p id="A1.SS1.p2.1" class="ltx_p">For <math id="A1.SS1.p2.m1" class="ltx_Math" alttext="F\to W\to M" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo stretchy="false">→</mo><mi>W</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">F\to W\to M</annotation></semantics></math> a fiber bundle, a function <math id="A1.SS1.p2.m2" class="ltx_Math" alttext="f:W\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>W</mi><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:W\to\mathbf{R}</annotation></semantics></math> has <span id="A1.SS1.p2.1.1" class="ltx_text ltx_font_italic">moderate singularities</span> if each restriction <math id="A1.SS1.p2.m3" class="ltx_Math" alttext="f|_{m}:F_{m}\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mi>f</mi><mo stretchy="false">|</mo></mrow><mi>m</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>F</mi><mi>m</mi></msub><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f|_{m}:F_{m}\to\mathbf{R}</annotation></semantics></math> to the fiber over <math id="A1.SS1.p2.m4" class="ltx_Math" alttext="m\in M" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">m\in M</annotation></semantics></math> has moderate singularities and if moreover the fibered singularities of <math id="A1.SS1.p2.m5" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> over <math id="A1.SS1.p2.m6" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math></p>
<table id="A1.Ex38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="A1.Ex38.m1.pic1" class="ltx_picture ltx_markedasmath" height="69.01" overflow="visible" style="vertical-align:-32.63px" version="1.1" viewBox="0 0 214.3 69.01" width="214.3"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,69.01) matrix(1 0 0 -1 0 0) translate(107.15,0) translate(0,32.63)"><g stroke-width="0.4pt" transform="matrix(1.0 0.0 0.0 1.0 -107.15 -27.57)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 65.26)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 14.56)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 0 0) translate(20.37,0) matrix(1.0 0.0 0.0 1.0 -14.41 0)"><foreignObject style="--ltx-fo-width:1.08em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="14.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A1.Ex38.m1.pic1.m1" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces W}" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces W}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 114.64 0) translate(66.44,0) matrix(1.0 0.0 0.0 1.0 -27.27 0)"><foreignObject style="--ltx-fo-width:2.94em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.08em;font-size:10pt;" height="10.65" overflow="visible" transform="matrix(1 0 0 -1 0 9.49)" width="40.7"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A1.Ex38.m1.pic1.m2" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces M\times\mathbf{R}}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝐑</mi></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces M\times\mathbf{R}}</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 60.2)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 40.74 0) translate(53.55,0) matrix(1.0 0.0 0.0 1.0 -14.38 0)"><foreignObject style="--ltx-fo-width:1.08em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="14.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A1.Ex38.m1.pic1.m3" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces M}" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces M}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -72.53 12.73 L -31.68 -12.48"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.85092 -0.5253 0.5253 0.85092 -31.45 -12.63)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -66.13 21.53 L 39.86 21.53"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 40.14 21.53)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -16.1 26.67)"><foreignObject style="--ltx-fo-width:0.47em;--ltx-fo-height:0.49em;--ltx-fo-depth:0.14em;font-size:10pt;" height="8.61" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="6.48"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A1.Ex38.m1.pic1.m4" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces f}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">f</mi><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces f}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 55.01 11.58 L 8.25 -13.02"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(-0.885 -0.4656 0.4656 -0.885 8.01 -13.15)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p2.2" class="ltx_p">are modeled on either a constant family of Morse critical points</p>
<table id="A1.Ex39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex39.m1" class="ltx_Math" alttext="(t_{1},\ldots,t_{m},x_{1},\ldots,x_{N})\mapsto(t_{1},\ldots,t_{m},\sum_{i\leq k}x_{i}^{2}-\sum_{i&gt;k}x_{i}^{2})" display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>t</mi><mi>m</mi></msub><mo>,</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">↦</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>t</mi><mi>m</mi></msub><mo rspace="0em">,</mo><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>≤</mo><mi>k</mi></mrow></munder><msubsup><mi>x</mi><mi>i</mi><mn>2</mn></msubsup></mrow><mo rspace="0.055em">−</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>&gt;</mo><mi>k</mi></mrow></munder><msubsup><mi>x</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(t_{1},\ldots,t_{m},x_{1},\ldots,x_{N})\mapsto(t_{1},\ldots,t_{m},\sum_{i\leq k}x_{i}^{2}-\sum_{i&gt;k}x_{i}^{2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p2.3" class="ltx_p">or a fibered birth/death of Morse critical points</p>
<table id="A1.Ex40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex40.m1" class="ltx_Math" alttext="(t_{1},\ldots,t_{m},x_{1},\ldots,x_{N})\mapsto(t_{1},\ldots,t_{m},x_{1}^{3}+3t_{1}x_{1}+\sum_{1&lt;i\leq k}x_{i}^{2}-\sum_{i&gt;k}x_{i}^{2})" display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>t</mi><mi>m</mi></msub><mo>,</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">↦</mo><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>t</mi><mi>m</mi></msub><mo>,</mo><mrow><mrow><msubsup><mi>x</mi><mn>1</mn><mn>3</mn></msubsup><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub></mrow><mo rspace="0.055em">+</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mn>1</mn><mo>&lt;</mo><mi>i</mi><mo>≤</mo><mi>k</mi></mrow></munder><msubsup><mi>x</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo rspace="0.055em">−</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>&gt;</mo><mi>k</mi></mrow></munder><msubsup><mi>x</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(t_{1},\ldots,t_{m},x_{1},\ldots,x_{N})\mapsto(t_{1},\ldots,t_{m},x_{1}^{3}+3t_{1}x_{1}+\sum_{1&lt;i\leq k}x_{i}^{2}-\sum_{i&gt;k}x_{i}^{2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p2.4" class="ltx_p">with both families fibered over <math id="A1.SS1.p2.m7" class="ltx_Math" alttext="(t_{1},\ldots,t_{m})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>t</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(t_{1},\ldots,t_{m})</annotation></semantics></math> with respect to the obvious projection. If <math id="A1.SS1.p2.m8" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> has boundary we will allow one-half of the above fibered models, i.e. restricting the fibration to a half space of the base.</p>
</div>
</section>
<section id="A1.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.2. </span>The stable bundle</h3>

<div id="A1.SS2.p1" class="ltx_para">
<p id="A1.SS2.p1.1" class="ltx_p">Let <math id="A1.SS2.p1.m1" class="ltx_Math" alttext="F\to W\to M" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo stretchy="false">→</mo><mi>W</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">F\to W\to M</annotation></semantics></math> be a fiber bundle and let <math id="A1.SS2.p1.m2" class="ltx_Math" alttext="f:W\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>W</mi><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:W\to\mathbf{R}</annotation></semantics></math> be a function with moderate singularities. The fiberwise singular set <math id="A1.SS2.p1.m3" class="ltx_Math" alttext="\Sigma_{f}\subset W" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mi>f</mi></msub><mo>⊂</mo><mi>W</mi></mrow><annotation encoding="application/x-tex">\Sigma_{f}\subset W</annotation></semantics></math> is a smooth submanifold of <math id="A1.SS2.p1.m4" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> of the same dimension as <math id="A1.SS2.p1.m5" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>. It has a stratification <math id="A1.SS2.p1.m6" class="ltx_Math" alttext="\Sigma_{f}=\bigcup_{k}\Sigma_{f,k}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mi>f</mi></msub><mo rspace="0.111em">=</mo><mrow><msub><mo>⋃</mo><mi>k</mi></msub><msub><mi mathvariant="normal">Σ</mi><mrow><mi>f</mi><mo>,</mo><mi>k</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\Sigma_{f}=\bigcup_{k}\Sigma_{f,k}</annotation></semantics></math> where <math id="A1.SS2.p1.m7" class="ltx_Math" alttext="\Sigma_{f,k}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mrow><mi>f</mi><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{f,k}</annotation></semantics></math> is the closure of the set of fiberwise Morse critical points of index <math id="A1.SS2.p1.m8" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>. Let <math id="A1.SS2.p1.m9" class="ltx_Math" alttext="C_{f,k}\subset\Lambda_{f}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><mi>f</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>⊂</mo><msub><mi mathvariant="normal">Λ</mi><mi>f</mi></msub></mrow><annotation encoding="application/x-tex">C_{f,k}\subset\Lambda_{f}</annotation></semantics></math> consist of the set of fiberwise cubic (birth/death) critical points of <math id="A1.SS2.p1.m10" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> of index <math id="A1.SS2.p1.m11" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> and <math id="A1.SS2.p1.m12" class="ltx_Math" alttext="k+1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k+1</annotation></semantics></math>. So the boundary of <math id="A1.SS2.p1.m13" class="ltx_Math" alttext="\Lambda_{f,k}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Λ</mi><mrow><mi>f</mi><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">\Lambda_{f,k}</annotation></semantics></math> consists of the disjoint union of <math id="A1.SS2.p1.m14" class="ltx_Math" alttext="C_{f,k-1}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mrow><mi>f</mi><mo>,</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><annotation encoding="application/x-tex">C_{f,k-1}</annotation></semantics></math> and <math id="A1.SS2.p1.m15" class="ltx_Math" alttext="C_{f,k}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mrow><mi>f</mi><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">C_{f,k}</annotation></semantics></math>.</p>
</div>
<div id="A1.SS2.p2" class="ltx_para">
<p id="A1.SS2.p2.1" class="ltx_p">On the interior of <math id="A1.SS2.p2.m1" class="ltx_Math" alttext="\Sigma_{f,k}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mrow><mi>f</mi><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{f,k}</annotation></semantics></math> we have a rank <math id="A1.SS2.p2.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> real vector bundle <math id="A1.SS2.p2.m3" class="ltx_Math" alttext="\gamma_{f,k}\to\Sigma_{f,k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mrow><mi>f</mi><mo>,</mo><mi>k</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi mathvariant="normal">Σ</mi><mrow><mi>f</mi><mo>,</mo><mi>k</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\gamma_{f,k}\to\Sigma_{f,k}</annotation></semantics></math> consisting of the negative eigenspace of the fiberwise Hessian along the fiberwise critical locus. Each <math id="A1.SS2.p2.m4" class="ltx_Math" alttext="\gamma_{f,k}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mrow><mi>f</mi><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">\gamma_{f,k}</annotation></semantics></math> extends to the boundary <math id="A1.SS2.p2.m5" class="ltx_Math" alttext="C_{f,k}\coprod C_{f,k-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><mi>f</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>∐</mo><msub><mi>C</mi><mrow><mi>f</mi><mo>,</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">C_{f,k}\coprod C_{f,k-1}</annotation></semantics></math> of <math id="A1.SS2.p2.m6" class="ltx_Math" alttext="\Sigma_{f,k}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mrow><mi>f</mi><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{f,k}</annotation></semantics></math> as sub-bundles of the fiberwise tangent bundle of <math id="A1.SS2.p2.m7" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math>, but along <math id="A1.SS2.p2.m8" class="ltx_Math" alttext="C_{f,k}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mrow><mi>f</mi><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">C_{f,k}</annotation></semantics></math> the dimensions of <math id="A1.SS2.p2.m9" class="ltx_Math" alttext="\gamma_{f,k}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mrow><mi>f</mi><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">\gamma_{f,k}</annotation></semantics></math> and <math id="A1.SS2.p2.m10" class="ltx_Math" alttext="\gamma_{f,k+1}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mrow><mi>f</mi><mo>,</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><annotation encoding="application/x-tex">\gamma_{f,k+1}</annotation></semantics></math> jump by one. More precisely, we have the relation <math id="A1.SS2.p2.m11" class="ltx_Math" alttext="\gamma_{f,k}\oplus\nu_{k}=\gamma_{f,k+1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>γ</mi><mrow><mi>f</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>⊕</mo><msub><mi>ν</mi><mi>k</mi></msub></mrow><mo>=</mo><msub><mi>γ</mi><mrow><mi>f</mi><mo>,</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\gamma_{f,k}\oplus\nu_{k}=\gamma_{f,k+1}</annotation></semantics></math> where <math id="A1.SS2.p2.m12" class="ltx_Math" alttext="\nu_{k}" display="inline" intent=":literal"><semantics><msub><mi>ν</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\nu_{k}</annotation></semantics></math> is the kernel of the Hessian, a rank 1 bundle along <math id="A1.SS2.p2.m13" class="ltx_Math" alttext="C_{f,k}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mrow><mi>f</mi><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">C_{f,k}</annotation></semantics></math>. So we may form a vector bundle over <math id="A1.SS2.p2.m14" class="ltx_Math" alttext="\Sigma_{f}=\bigcup_{k}\Sigma_{f,k}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mi>f</mi></msub><mo rspace="0.111em">=</mo><mrow><msub><mo>⋃</mo><mi>k</mi></msub><msub><mi mathvariant="normal">Σ</mi><mrow><mi>f</mi><mo>,</mo><mi>k</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\Sigma_{f}=\bigcup_{k}\Sigma_{f,k}</annotation></semantics></math> by using the canonical co-orientation to glue the vector bundles <math id="A1.SS2.p2.m15" class="ltx_Math" alttext="\gamma_{f,k}\oplus\varepsilon^{N-k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mrow><mi>f</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>⊕</mo><msup><mi>ε</mi><mrow><mi>N</mi><mo>−</mo><mi>k</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\gamma_{f,k}\oplus\varepsilon^{N-k}</annotation></semantics></math> on <math id="A1.SS2.p2.m16" class="ltx_Math" alttext="\Sigma_{f,k}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mrow><mi>f</mi><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{f,k}</annotation></semantics></math>, where <math id="A1.SS2.p2.m17" class="ltx_Math" alttext="\varepsilon" display="inline" intent=":literal"><semantics><mi>ε</mi><annotation encoding="application/x-tex">\varepsilon</annotation></semantics></math> denotes the trivial rank 1 bundle, to a rank <math id="A1.SS2.p2.m18" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> vector bundle on <math id="A1.SS2.p2.m19" class="ltx_Math" alttext="\Sigma_{f}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>f</mi></msub><annotation encoding="application/x-tex">\Sigma_{f}</annotation></semantics></math>. More precisely, the canonical co-orientation gives a trivialization <math id="A1.SS2.p2.m20" class="ltx_Math" alttext="\nu_{k}\simeq\varepsilon" display="inline" intent=":literal"><semantics><mrow><msub><mi>ν</mi><mi>k</mi></msub><mo>≃</mo><mi>ε</mi></mrow><annotation encoding="application/x-tex">\nu_{k}\simeq\varepsilon</annotation></semantics></math> and so we may glue via the vector bundle isomorphism over <math id="A1.SS2.p2.m21" class="ltx_Math" alttext="C_{f,k}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mrow><mi>f</mi><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">C_{f,k}</annotation></semantics></math> given by</p>
<table id="A1.Ex41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex41.m1" class="ltx_Math" alttext="\gamma_{f,k}\oplus\varepsilon^{N-k}\simeq\gamma_{f,k}\oplus\nu_{k}\oplus\varepsilon^{N-k-1}\simeq\gamma_{f,k+1}\oplus\varepsilon^{N-k-1}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>γ</mi><mrow><mi>f</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>⊕</mo><msup><mi>ε</mi><mrow><mi>N</mi><mo>−</mo><mi>k</mi></mrow></msup></mrow><mo>≃</mo><mrow><msub><mi>γ</mi><mrow><mi>f</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>⊕</mo><msub><mi>ν</mi><mi>k</mi></msub><mo>⊕</mo><msup><mi>ε</mi><mrow><mi>N</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>≃</mo><mrow><msub><mi>γ</mi><mrow><mi>f</mi><mo>,</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo>⊕</mo><msup><mi>ε</mi><mrow><mi>N</mi><mo>−</mo><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\gamma_{f,k}\oplus\varepsilon^{N-k}\simeq\gamma_{f,k}\oplus\nu_{k}\oplus\varepsilon^{N-k-1}\simeq\gamma_{f,k+1}\oplus\varepsilon^{N-k-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p2.2" class="ltx_p">We denote the stable class of this real vector bundle over <math id="A1.SS2.p2.m22" class="ltx_Math" alttext="\Sigma_{f}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>f</mi></msub><annotation encoding="application/x-tex">\Sigma_{f}</annotation></semantics></math> by <math id="A1.SS2.p2.m23" class="ltx_Math" alttext="\gamma_{f}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mi>f</mi></msub><annotation encoding="application/x-tex">\gamma_{f}</annotation></semantics></math> and will refer to it as the <span id="A1.SS2.p2.2.1" class="ltx_text ltx_font_italic">stable bundle</span> of <math id="A1.SS2.p2.m24" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>.</p>
</div>
</section>
<section id="A1.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.3. </span>Framed functions</h3>

<div id="A1.SS3.p1" class="ltx_para">
<p id="A1.SS3.p1.1" class="ltx_p">For <math id="A1.SS3.p1.m1" class="ltx_Math" alttext="F\to W\to M" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo stretchy="false">→</mo><mi>W</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">F\to W\to M</annotation></semantics></math> a fiber bundle, a framed function <math id="A1.SS3.p1.m2" class="ltx_Math" alttext="f:W\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>W</mi><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:W\to\mathbf{R}</annotation></semantics></math> is roughly speaking a function with moderate singularities whose stable bundle <math id="A1.SS3.p1.m3" class="ltx_Math" alttext="\gamma_{f}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mi>f</mi></msub><annotation encoding="application/x-tex">\gamma_{f}</annotation></semantics></math> is trivial and moreover equipped with a trivialization. More precisely, one requires the existence of isomorphisms</p>
<table id="A1.Ex42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex42.m1" class="ltx_Math" alttext="\varphi_{k}:\gamma_{f,k}\xrightarrow{\simeq}\varepsilon^{k}" display="block" intent=":literal"><semantics><mrow><msub><mi>φ</mi><mi>k</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>γ</mi><mrow><mi>f</mi><mo>,</mo><mi>k</mi></mrow></msub><mover accent="true"><mo>→</mo><mo mathsize="0.700em">≃</mo></mover><msup><mi>ε</mi><mi>k</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\varphi_{k}:\gamma_{f,k}\xrightarrow{\simeq}\varepsilon^{k}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.p1.2" class="ltx_p">which are compatible with the above gluing maps. We will refer to the following result as the <span id="A1.SS3.p1.2.1" class="ltx_text ltx_font_italic">framed function theorem</span>.</p>
</div>
<div id="A1.Thmtheorem1" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmtheorem1.1" class="ltx_text ltx_font_bold">Theorem A.1</span></span><span id="A1.Thmtheorem1.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmtheorem1.p1" class="ltx_para">
<p id="A1.Thmtheorem1.p1.1" class="ltx_p"><span id="A1.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">For <math id="A1.Thmtheorem1.p1.m1" class="ltx_Math" alttext="F\to W\to M" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo stretchy="false">→</mo><mi>W</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">F\to W\to M</annotation></semantics></math> a fiber bundle, given a closed subset <math id="A1.Thmtheorem1.p1.m2" class="ltx_Math" alttext="A\subset W" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>⊂</mo><mi>W</mi></mrow><annotation encoding="application/x-tex">A\subset W</annotation></semantics></math> and a framed function <math id="A1.Thmtheorem1.p1.m3" class="ltx_Math" alttext="g:Op(A)\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">g:Op(A)\to\mathbf{R}</annotation></semantics></math> there exists a framed function <math id="A1.Thmtheorem1.p1.m4" class="ltx_Math" alttext="f:W\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>W</mi><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:W\to\mathbf{R}</annotation></semantics></math> which agrees with <math id="A1.Thmtheorem1.p1.m5" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> on <math id="A1.Thmtheorem1.p1.m6" class="ltx_Math" alttext="Op(A)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Op(A)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A1.SS3.p2" class="ltx_para">
<p id="A1.SS3.p2.1" class="ltx_p">In particular, for any fiber bundle <math id="A1.SS3.p2.m1" class="ltx_Math" alttext="F\to W\to M" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo stretchy="false">→</mo><mi>W</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">F\to W\to M</annotation></semantics></math> framed functions <math id="A1.SS3.p2.m2" class="ltx_Math" alttext="f:W\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>W</mi><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:W\to\mathbf{R}</annotation></semantics></math> exist, and if <math id="A1.SS3.p2.m3" class="ltx_Math" alttext="f_{0}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>0</mn></msub><annotation encoding="application/x-tex">f_{0}</annotation></semantics></math> and <math id="A1.SS3.p2.m4" class="ltx_Math" alttext="f_{1}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>1</mn></msub><annotation encoding="application/x-tex">f_{1}</annotation></semantics></math> are two such then there exists a framed function <math id="A1.SS3.p2.m5" class="ltx_Math" alttext="F:W\times[0,1]\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>W</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">F:W\times[0,1]\to\mathbf{R}</annotation></semantics></math> on the product fiber bundle <math id="A1.SS3.p2.m6" class="ltx_Math" alttext="F\times[0,1]\to W\times[0,1]\to M\times[0,1]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>W</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F\times[0,1]\to W\times[0,1]\to M\times[0,1]</annotation></semantics></math> such that <math id="A1.SS3.p2.m7" class="ltx_Math" alttext="F|_{W\times 0}=f_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mi>F</mi><mo stretchy="false">|</mo></mrow><mrow><mi>W</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mn>0</mn></mrow></msub><mo>=</mo><msub><mi>f</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">F|_{W\times 0}=f_{0}</annotation></semantics></math> and <math id="A1.SS3.p2.m8" class="ltx_Math" alttext="F_{W\times 1}=f_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>F</mi><mrow><mi>W</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn></mrow></msub><mo>=</mo><msub><mi>f</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">F_{W\times 1}=f_{1}</annotation></semantics></math>.</p>
</div>
<div id="A1.SS3.p3" class="ltx_para">
<p id="A1.SS3.p3.1" class="ltx_p">Theorem <a href="#A1.Thmtheorem1" title="Theorem A.1. ‣ A.3. Framed functions ‣ Appendix A Moderate singularities ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.1</span></a> in particular implies, and is essentially equivalent to, the fact that a suitable model for the <span id="A1.SS3.p3.1.1" class="ltx_text ltx_font_italic">space of framed functions</span> on the fiber <math id="A1.SS3.p3.m1" class="ltx_Math" alttext="h:F\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>F</mi><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">h:F\to\mathbf{R}</annotation></semantics></math> is contractible, even in a strong relative form. The high connectivity of the space of framed functions was first established by work of the second author <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx34" title="" class="ltx_ref">Igu87</a>]</cite>. The strongest form is given by the Extension Theorem 1.1.1 of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx23" title="" class="ltx_ref">EM12</a>]</cite>, slightly reformulated as Theorem <a href="#A1.Thmtheorem1" title="Theorem A.1. ‣ A.3. Framed functions ‣ Appendix A Moderate singularities ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.1</span></a> above. The fact that framed functions may be chosen and are independent of choices is central to the definition of higher torsion invariants.</p>
</div>
<div id="A1.SS3.p4" class="ltx_para">
<p id="A1.SS3.p4.1" class="ltx_p">We note the inevitability of relying on some result in the theory of simplification of singularities to even establish the existence of functions <math id="A1.SS3.p4.m1" class="ltx_Math" alttext="f:W\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>W</mi><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:W\to\mathbf{R}</annotation></semantics></math> with moderate singularities. This existence is not a priori guaranteed because the condition of having only moderate singularities, though <math id="A1.SS3.p4.m2" class="ltx_Math" alttext="C^{3}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mn>3</mn></msup><annotation encoding="application/x-tex">C^{3}</annotation></semantics></math>-stable, is far from <math id="A1.SS3.p4.m3" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math>-generic in general. Indeed, <math id="A1.SS3.p4.m4" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math>-generic functions <math id="A1.SS3.p4.m5" class="ltx_Math" alttext="f:W\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>W</mi><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:W\to\mathbf{R}</annotation></semantics></math> will have terrible and completely unclassifiable fiberwise singularities.</p>
</div>
</section>
<section id="A1.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.4. </span>Wrinkling</h3>

<div id="A1.SS4.p1" class="ltx_para">
<p id="A1.SS4.p1.1" class="ltx_p">The proof of the framed function theorem <a href="#A1.Thmtheorem1" title="Theorem A.1. ‣ A.3. Framed functions ‣ Appendix A Moderate singularities ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.1</span></a> given in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx23" title="" class="ltx_ref">EM12</a>]</cite> uses the <span id="A1.SS4.p1.1.1" class="ltx_text ltx_font_italic">wrinkling philosophy</span> developed by Eliashberg and Mishachev. We will in fact have use for this theory in the proof of Theorem <a href="#S1.Thmtheorem15" title="Theorem 1.15. ‣ 1.1. Main results ‣ 1. Introduction ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.15</span></a> and so we record the relevant statement below.</p>
</div>
<div id="A1.SS4.p2" class="ltx_para">
<p id="A1.SS4.p2.1" class="ltx_p">For <math id="A1.SS4.p2.m1" class="ltx_Math" alttext="F\to W\to M" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo stretchy="false">→</mo><mi>W</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">F\to W\to M</annotation></semantics></math> a fiber bundle, a <span id="A1.SS4.p2.1.1" class="ltx_text ltx_font_italic">fibered wrinkled function</span> <math id="A1.SS4.p2.m2" class="ltx_Math" alttext="f:W\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>W</mi><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:W\to\mathbf{R}</annotation></semantics></math> is a fibered function with moderate singularities such that the fiberwise singular locus <math id="A1.SS4.p2.m3" class="ltx_Math" alttext="\Sigma_{f}\subset W" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mi>f</mi></msub><mo>⊂</mo><mi>W</mi></mrow><annotation encoding="application/x-tex">\Sigma_{f}\subset W</annotation></semantics></math> consists of a disjoint union of contractible spheres <math id="A1.SS4.p2.m4" class="ltx_Math" alttext="S\subset W" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⊂</mo><mi>W</mi></mrow><annotation encoding="application/x-tex">S\subset W</annotation></semantics></math>, such that the restriction of <math id="A1.SS4.p2.m5" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> to a sufficiently small open neighborhood of each of the spheres <math id="A1.SS4.p2.m6" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is fibered equivalent to the local model</p>
<table id="A1.Ex43" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex43.m1" class="ltx_Math" alttext="(y,z,x)\mapsto\left(y,z^{3}+3(\|y\|^{2}-1)z-\sum_{i=1}^{s}x_{i}^{2}+\sum_{i=s+1}^{n-q}x_{j}^{2}\right)" display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">↦</mo><mrow><mo>(</mo><mi>y</mi><mo>,</mo><mrow><mrow><mrow><msup><mi>z</mi><mn>3</mn></msup><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>y</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow></mrow><mo rspace="0.055em">−</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>s</mi></munderover><msubsup><mi>x</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo rspace="0.055em">+</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mrow><mi>s</mi><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>n</mi><mo>−</mo><mi>q</mi></mrow></munderover><msubsup><mi>x</mi><mi>j</mi><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">(y,z,x)\mapsto\left(y,z^{3}+3(\|y\|^{2}-1)z-\sum_{i=1}^{s}x_{i}^{2}+\sum_{i=s+1}^{n-q}x_{j}^{2}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS4.p2.2" class="ltx_p"><math id="A1.SS4.p2.m7" class="ltx_Math" alttext="y\in\mathbf{R}^{q-1}" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>∈</mo><msup><mi>𝐑</mi><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">y\in\mathbf{R}^{q-1}</annotation></semantics></math>, <math id="A1.SS4.p2.m8" class="ltx_Math" alttext="z\in\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>∈</mo><mi>𝐑</mi></mrow><annotation encoding="application/x-tex">z\in\mathbf{R}</annotation></semantics></math>, <math id="A1.SS4.p2.m9" class="ltx_Math" alttext="x\in\mathbf{R}^{n-q}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msup><mi>𝐑</mi><mrow><mi>n</mi><mo>−</mo><mi>q</mi></mrow></msup></mrow><annotation encoding="application/x-tex">x\in\mathbf{R}^{n-q}</annotation></semantics></math>, which has singularity <math id="A1.SS4.p2.m10" class="ltx_Math" alttext="S^{q-1}=S^{q-1}\times\{0\}\subset\mathbf{R}^{q}\times\mathbf{R}^{n-q}" display="inline" intent=":literal"><semantics><mrow><msup><mi>S</mi><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>=</mo><mrow><msup><mi>S</mi><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow><mo>⊂</mo><mrow><msup><mi>𝐑</mi><mi>q</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐑</mi><mrow><mi>n</mi><mo>−</mo><mi>q</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">S^{q-1}=S^{q-1}\times\{0\}\subset\mathbf{R}^{q}\times\mathbf{R}^{n-q}</annotation></semantics></math>, with equator of cusps <math id="A1.SS4.p2.m11" class="ltx_Math" alttext="\{\|y\|=1,z=0,x=0\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mrow><mrow><mo stretchy="false">‖</mo><mi>y</mi><mo stretchy="false">‖</mo></mrow><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mrow><mi>z</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mrow><mi>x</mi><mo>=</mo><mn>0</mn></mrow></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\|y\|=1,z=0,x=0\}</annotation></semantics></math>. We emphasize that we only require an equivalence between the restriction of <math id="A1.SS4.p2.m12" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> to <math id="A1.SS4.p2.m13" class="ltx_Math" alttext="Op(S)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Op(S)</annotation></semantics></math> and the restriction of the normal form to <math id="A1.SS4.p2.m14" class="ltx_Math" alttext="Op(S^{q-1})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>S</mi><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Op(S^{q-1})</annotation></semantics></math>. Here and below we use the Gromov notation to denote <math id="A1.SS4.p2.m15" class="ltx_Math" alttext="Op(A)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Op(A)</annotation></semantics></math> an arbitrarily small but unspecified open neighborhood of <math id="A1.SS4.p2.m16" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>, i.e. the <span id="A1.SS4.p2.2.1" class="ltx_text ltx_font_italic">germ</span> of an open neighborhood of <math id="A1.SS4.p2.m17" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>.</p>
</div>
<div id="A1.SS4.p3" class="ltx_para">
<p id="A1.SS4.p3.1" class="ltx_p">Note that each such sphere <math id="A1.SS4.p3.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> we have an equator <math id="A1.SS4.p3.m2" class="ltx_Math" alttext="C\subset S" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⊂</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">C\subset S</annotation></semantics></math> (i.e. the pair is diffeomorphic to <math id="A1.SS4.p3.m3" class="ltx_Math" alttext="S^{n-2}\subset S^{n-1}" display="inline" intent=":literal"><semantics><mrow><msup><mi>S</mi><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></msup><mo>⊂</mo><msup><mi>S</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">S^{n-2}\subset S^{n-1}</annotation></semantics></math>, where <math id="A1.SS4.p3.m4" class="ltx_Math" alttext="n=\dim M" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo rspace="0.1389em">=</mo><mrow><mo lspace="0.1389em" rspace="0.167em">dim</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">n=\dim M</annotation></semantics></math>), and that <math id="A1.SS4.p3.m5" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> has Morse critical points on <math id="A1.SS4.p3.m6" class="ltx_Math" alttext="S\setminus C" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>∖</mo><mi>C</mi></mrow><annotation encoding="application/x-tex">S\setminus C</annotation></semantics></math> (of Morse indices <math id="A1.SS4.p3.m7" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> and <math id="A1.SS4.p3.m8" class="ltx_Math" alttext="k+1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k+1</annotation></semantics></math> for some <math id="A1.SS4.p3.m9" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>) with cubic birth/death points along <math id="A1.SS4.p3.m10" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>.</p>
</div>
<div id="A1.SS4.p4" class="ltx_para">
<p id="A1.SS4.p4.1" class="ltx_p">If <math id="A1.SS4.p4.m1" class="ltx_Math" alttext="F\to W\to M" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo stretchy="false">→</mo><mi>W</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">F\to W\to M</annotation></semantics></math> is a fiber bundle of manifolds, we denote <math id="A1.SS4.p4.m2" class="ltx_Math" alttext="\text{Vert}\to W" display="inline" intent=":literal"><semantics><mrow><mtext>Vert</mtext><mo stretchy="false">→</mo><mi>W</mi></mrow><annotation encoding="application/x-tex">\text{Vert}\to W</annotation></semantics></math> the vector sub-bundle of <math id="A1.SS4.p4.m3" class="ltx_Math" alttext="TW" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><annotation encoding="application/x-tex">TW</annotation></semantics></math> consisting of vectors tangent to the fibers.</p>
</div>
<div id="A1.Thmtheorem2" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmtheorem2.1" class="ltx_text ltx_font_bold">Theorem A.2</span></span><span id="A1.Thmtheorem2.2" class="ltx_text ltx_font_bold"> </span>(<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx22" title="" class="ltx_ref">EM00</a>]</cite>, Theorem 2.3)<span id="A1.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmtheorem2.p1" class="ltx_para">
<p id="A1.Thmtheorem2.p1.1" class="ltx_p"><span id="A1.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A1.Thmtheorem2.p1.m1" class="ltx_Math" alttext="F\to W\to M" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo stretchy="false">→</mo><mi>W</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">F\to W\to M</annotation></semantics></math> be a fiber bundle of closed manifolds. Let <math id="A1.Thmtheorem2.p1.m2" class="ltx_Math" alttext="A\subset W" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>⊂</mo><mi>W</mi></mrow><annotation encoding="application/x-tex">A\subset W</annotation></semantics></math> be a closed set. Suppose that a function is given <math id="A1.Thmtheorem2.p1.m3" class="ltx_Math" alttext="g:Op(A)\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">g:Op(A)\to\mathbf{R}</annotation></semantics></math> without critical points such that the vertical differential <math id="A1.Thmtheorem2.p1.m4" class="ltx_Math" alttext="d_{v}g" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><annotation encoding="application/x-tex">d_{v}g</annotation></semantics></math> extends to a nowhere vanishing section of <math id="A1.Thmtheorem2.p1.m5" class="ltx_Math" alttext="\text{Vert}^{*}" display="inline" intent=":literal"><semantics><msup><mtext class="ltx_mathvariant_italic">Vert</mtext><mo>∗</mo></msup><annotation encoding="application/x-tex">\text{Vert}^{*}</annotation></semantics></math> on all of <math id="A1.Thmtheorem2.p1.m6" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math>. Then there exists a fibered wrinkled function <math id="A1.Thmtheorem2.p1.m7" class="ltx_Math" alttext="f:W\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>W</mi><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:W\to\mathbf{R}</annotation></semantics></math> which agrees with <math id="A1.Thmtheorem2.p1.m8" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> on <math id="A1.Thmtheorem2.p1.m9" class="ltx_Math" alttext="Op(A)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Op(A)</annotation></semantics></math>.</span></p>
</div>
</div>
</section>
</section>
<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>Higher torsion of fiber bundles</h2>

<section id="A2.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.1. </span>Higher torsion classes</h3>

<div id="A2.SS1.p1" class="ltx_para">
<p id="A2.SS1.p1.1" class="ltx_p"><span id="A2.SS1.p1.1.1" class="ltx_text ltx_font_italic">Higher torsion invariants</span> are characteristic classes of smooth fiber bundles <math id="A2.SS1.p1.m1" class="ltx_Math" alttext="F\to W\to M" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo stretchy="false">→</mo><mi>W</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">F\to W\to M</annotation></semantics></math> of smooth manifolds, defined under suitable conditions. The theory has analytic treatments <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx13" title="" class="ltx_ref">BL95</a>, <a href="#bib.bibx14" title="" class="ltx_ref">BG01</a>]</cite>, homotopy-theoretic treatments <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx19" title="" class="ltx_ref">DWW</a>]</cite> and axiomatic treatments <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx39" title="" class="ltx_ref">Igu08</a>]</cite>, in addition to the Morse-theoretic perspective we adopt in the present article, following the book <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx36" title="" class="ltx_ref">Igu02</a>]</cite>.</p>
</div>
<div id="A2.SS1.p2" class="ltx_para">
<p id="A2.SS1.p2.1" class="ltx_p">From the Morse-theoretic viewpoint, a fiber bundle may be studied by considering smooth functions <math id="A2.SS1.p2.m1" class="ltx_Math" alttext="f:W\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>W</mi><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:W\to\mathbf{R}</annotation></semantics></math> and analyzing the parametrized Morse theory of the restrictions</p>
<table id="A2.Ex44" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex44.m1" class="ltx_Math" alttext="f_{m}:=f|_{F_{m}}:F_{m}\to\mathbf{R}" display="block" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>m</mi></msub><mo>:=</mo><msub><mrow><mi>f</mi><mo rspace="0.278em" stretchy="false">|</mo></mrow><msub><mi>F</mi><mi>m</mi></msub></msub><mo rspace="0.278em">:</mo><mrow><msub><mi>F</mi><mi>m</mi></msub><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f_{m}:=f|_{F_{m}}:F_{m}\to\mathbf{R}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p2.2" class="ltx_p">of <math id="A2.SS1.p2.m2" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> to the fiber, parametrized by <math id="A2.SS1.p2.m3" class="ltx_Math" alttext="m\in M" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">m\in M</annotation></semantics></math>. When <math id="A2.SS1.p2.m4" class="ltx_Math" alttext="f:W\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>W</mi><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:W\to\mathbf{R}</annotation></semantics></math> has moderate singularities in the sense of Appendix <a href="#A1" title="Appendix A Moderate singularities ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A</span></a>, after fixing a generic fiberwise metric one may construct the family of Morse chain complexes <math id="A2.SS1.p2.m5" class="ltx_Math" alttext="C^{*}(f_{m}:\mathbf{Z}[\pi_{1}W])" display="inline" intent=":literal"><semantics><mrow><msup><mi>C</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mi>m</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>𝐙</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C^{*}(f_{m}:\mathbf{Z}[\pi_{1}W])</annotation></semantics></math> where we may take the coefficients in <math id="A2.SS1.p2.m6" class="ltx_Math" alttext="\mathbf{Z}[\pi_{1}W]" display="inline" intent=":literal"><semantics><mrow><mi>𝐙</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{Z}[\pi_{1}W]</annotation></semantics></math>. In this appendix we briefly recall how this data may be used to yield the higher torsion classes.</p>
</div>
</section>
<section id="A2.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.2. </span>The Whitehead category</h3>

<div id="A2.SS2.p1" class="ltx_para">
<p id="A2.SS2.p1.1" class="ltx_p">The natural home for the parametrized family of Morse chain complexes is the <span id="A2.SS2.p1.1.1" class="ltx_text ltx_font_italic">Whitehead category</span>. For <math id="A2.SS2.p1.m1" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> an associative ring and <math id="A2.SS2.p1.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> a subgroup of the units of <math id="A2.SS2.p1.m3" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>, there is a simplicial category <math id="A2.SS2.p1.m4" class="ltx_Math" alttext="\text{Wh}_{\bullet}(R,G)" display="inline" intent=":literal"><semantics><mrow><msub><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo>,</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{Wh}_{\bullet}(R,G)</annotation></semantics></math>, called the <span id="A2.SS2.p1.1.2" class="ltx_text ltx_font_italic">Whitehead category</span>, whose objects in degree <math id="A2.SS2.p1.m5" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> are <math id="A2.SS2.p1.m6" class="ltx_Math" alttext="\Delta^{k}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Δ</mi><mi>k</mi></msup><annotation encoding="application/x-tex">\Delta^{k}</annotation></semantics></math>-families of filtered finite free chain complexes over <math id="A2.SS2.p1.m7" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> with the basis only well-defined up to permutation and elements of <math id="A2.SS2.p1.m8" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>, i.e., up to monomial change of basis <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx38" title="" class="ltx_ref">Igu05</a>, Def 2.7, Def 2.16]</cite>. We add a category direction giving elementary expansions of the chain complex. This comes from the birth-death points in the family of generalized Morse functions.</p>
</div>
<div id="A2.SS2.p2" class="ltx_para">
<p id="A2.SS2.p2.1" class="ltx_p">Given a bundle of smooth manifolds <math id="A2.SS2.p2.m1" class="ltx_Math" alttext="F\to W\to M" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo stretchy="false">→</mo><mi>W</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">F\to W\to M</annotation></semantics></math>, a fiberwise generalized Morse function <math id="A2.SS2.p2.m2" class="ltx_Math" alttext="f:W\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>W</mi><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:W\to\mathbf{R}</annotation></semantics></math>, and a generic choice of vertical metric, the data <math id="A2.SS2.p2.m3" class="ltx_Math" alttext="C^{*}(f_{m}:\mathbf{Z}[\pi_{1}W])" display="inline" intent=":literal"><semantics><mrow><msup><mi>C</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mi>m</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>𝐙</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C^{*}(f_{m}:\mathbf{Z}[\pi_{1}W])</annotation></semantics></math>, <math id="A2.SS2.p2.m4" class="ltx_Math" alttext="m\in M" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">m\in M</annotation></semantics></math>, amounts to a map</p>
<table id="A2.Ex45" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex45.m1" class="ltx_Math" alttext="M\to|\text{Wh}_{\bullet}(\mathbf{Z}[\pi_{1}W],\pi_{1}W)|." display="block" intent=":literal"><semantics><mrow><mrow><mi>M</mi><mo stretchy="false">→</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐙</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">M\to|\text{Wh}_{\bullet}(\mathbf{Z}[\pi_{1}W],\pi_{1}W)|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p2.2" class="ltx_p">If the action of <math id="A2.SS2.p2.m5" class="ltx_Math" alttext="\pi_{1}M" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\pi_{1}M</annotation></semantics></math> on <math id="A2.SS2.p2.m6" class="ltx_Math" alttext="H_{*}(F_{m};R)" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mi>m</mi></msub><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{*}(F_{m};R)</annotation></semantics></math> is trivial, then a fiberwise mapping cone construction will make each fiber complex <math id="A2.SS2.p2.m7" class="ltx_Math" alttext="C^{*}(f_{m}:\mathbf{Z}[\pi_{1}W])" display="inline" intent=":literal"><semantics><mrow><msup><mi>C</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mi>m</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>𝐙</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C^{*}(f_{m}:\mathbf{Z}[\pi_{1}W])</annotation></semantics></math> contractible and thus gives a mapping</p>
<table id="A2.Ex46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex46.m1" class="ltx_Math" alttext="\xi:M\to|\text{Wh}_{\bullet}^{h}(\mathbf{Z}[\pi_{1}W],\pi_{1}W)|" display="block" intent=":literal"><semantics><mrow><mi>ξ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mrow><mo stretchy="false">|</mo><mrow><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐙</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\xi:M\to|\text{Wh}_{\bullet}^{h}(\mathbf{Z}[\pi_{1}W],\pi_{1}W)|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p2.3" class="ltx_p">well-defined up to homotopy, where <math id="A2.SS2.p2.m8" class="ltx_Math" alttext="\text{Wh}_{\bullet}^{h}(\mathbf{Z}[\pi_{1}W],\pi_{1}W)" display="inline" intent=":literal"><semantics><mrow><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐙</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{Wh}_{\bullet}^{h}(\mathbf{Z}[\pi_{1}W],\pi_{1}W)</annotation></semantics></math> is the simplicial full subcategory of <math id="A2.SS2.p2.m9" class="ltx_Math" alttext="\text{Wh}_{\bullet}(\mathbf{Z}[\pi_{1}W],\pi_{1}W)" display="inline" intent=":literal"><semantics><mrow><msub><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐙</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{Wh}_{\bullet}(\mathbf{Z}[\pi_{1}W],\pi_{1}W)</annotation></semantics></math> whose objects in degree <math id="A2.SS2.p2.m10" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> are <math id="A2.SS2.p2.m11" class="ltx_Math" alttext="\Delta^{k}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Δ</mi><mi>k</mi></msup><annotation encoding="application/x-tex">\Delta^{k}</annotation></semantics></math>-families of the acyclic chain complexes. The map <math id="A2.SS2.p2.m12" class="ltx_Math" alttext="\xi" display="inline" intent=":literal"><semantics><mi>ξ</mi><annotation encoding="application/x-tex">\xi</annotation></semantics></math> comes from a simplicial map</p>
<table id="A2.Ex47" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex47.m1" class="ltx_Math" alttext="\xi_{\bullet}:simp\,M\to\text{Wh}_{\bullet}^{h}(\mathbf{Z}[\pi_{1}W],\pi_{1}W)" display="block" intent=":literal"><semantics><mrow><msub><mi>ξ</mi><mo>∙</mo></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">→</mo><mrow><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐙</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\xi_{\bullet}:simp\,M\to\text{Wh}_{\bullet}^{h}(\mathbf{Z}[\pi_{1}W],\pi_{1}W)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p2.4" class="ltx_p">taking (small) smooth <math id="A2.SS2.p2.m13" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-simplices in <math id="A2.SS2.p2.m14" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> to objects of <math id="A2.SS2.p2.m15" class="ltx_Math" alttext="\text{Wh}_{k}^{h}(\mathbf{Z}[\pi_{1}W],\pi_{1}W)" display="inline" intent=":literal"><semantics><mrow><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mi>k</mi><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐙</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{Wh}_{k}^{h}(\mathbf{Z}[\pi_{1}W],\pi_{1}W)</annotation></semantics></math>. When <math id="A2.SS2.p2.m16" class="ltx_Math" alttext="R=\mathbf{Q}" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>=</mo><mi>𝐐</mi></mrow><annotation encoding="application/x-tex">R=\mathbf{Q}</annotation></semantics></math> or <math id="A2.SS2.p2.m17" class="ltx_Math" alttext="\mathbf{C}" display="inline" intent=":literal"><semantics><mi>𝐂</mi><annotation encoding="application/x-tex">\mathbf{C}</annotation></semantics></math>, the construction of higher torsion extends to the case then <math id="A2.SS2.p2.m18" class="ltx_Math" alttext="\pi_{1}M" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\pi_{1}M</annotation></semantics></math>
acts unipotently on the fiber homology <math id="A2.SS2.p2.m19" class="ltx_Math" alttext="H_{*}(F_{m};R)" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mi>m</mi></msub><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{*}(F_{m};R)</annotation></semantics></math>, by which we mean that the <math id="A2.SS2.p2.m20" class="ltx_Math" alttext="\pi_{1}M" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\pi_{1}M</annotation></semantics></math>-module <math id="A2.SS2.p2.m21" class="ltx_Math" alttext="H_{*}(F_{m};R)" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mi>m</mi></msub><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{*}(F_{m};R)</annotation></semantics></math> admits a filtration by <math id="A2.SS2.p2.m22" class="ltx_Math" alttext="\pi_{1}M" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\pi_{1}M</annotation></semantics></math> submodules so that the action of <math id="A2.SS2.p2.m23" class="ltx_Math" alttext="\pi_{1}M" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\pi_{1}M</annotation></semantics></math> on the successive subquotients is trivial.</p>
</div>
<div id="A2.SS2.p3" class="ltx_para">
<p id="A2.SS2.p3.1" class="ltx_p">At this point we are very close to defining higher torsion. Indeed we have</p>
<table id="A2.Ex48" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex48.m1" class="ltx_Math" alttext="\text{Wh}_{1}(G)=\pi_{0}\text{Wh}_{\bullet}^{h}(\mathbf{Z}[G],G)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mtext>Wh</mtext><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>π</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐙</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>G</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{Wh}_{1}(G)=\pi_{0}\text{Wh}_{\bullet}^{h}(\mathbf{Z}[G],G)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p3.2" class="ltx_p">for the classical Whitehead group <math id="A2.SS2.p3.m1" class="ltx_Math" alttext="\text{Wh}_{1}(G)" display="inline" intent=":literal"><semantics><mrow><msub><mtext>Wh</mtext><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{Wh}_{1}(G)</annotation></semantics></math>, so <math id="A2.SS2.p3.m2" class="ltx_Math" alttext="|\text{Wh}_{\bullet}^{h}(\mathbf{Z}[G],G)|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐙</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>G</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\text{Wh}_{\bullet}^{h}(\mathbf{Z}[G],G)|</annotation></semantics></math> may be thought of as a space-level generalization of Whitehead torsion. More precisely, it was shown by the second author and J. Klein that there is a homotopy fiber sequence</p>
<table id="A2.Ex49" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex49.m1" class="ltx_Math" alttext="|\text{Wh}_{\bullet}^{h}(R,G)|\to\Omega^{\infty}\Sigma^{\infty}(BG_{+})\to\ \mathbf{Z}\times BGL(R)^{+}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo>,</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo stretchy="false">→</mo><mrow><msup><mi mathvariant="normal">Ω</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Σ</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>G</mi><mo>+</mo></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.778em" stretchy="false">→</mo><mrow><mrow><mi>𝐙</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>B</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow><mo>+</mo></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|\text{Wh}_{\bullet}^{h}(R,G)|\to\Omega^{\infty}\Sigma^{\infty}(BG_{+})\to\ \mathbf{Z}\times BGL(R)^{+}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p3.3" class="ltx_p">For example, if <math id="A2.SS2.p3.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> is finite then <math id="A2.SS2.p3.m4" class="ltx_Math" alttext="\Omega^{\infty}\Sigma^{\infty}(BG_{+})" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Ω</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">Σ</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>G</mi><mo>+</mo></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Omega^{\infty}\Sigma^{\infty}(BG_{+})</annotation></semantics></math> is rationally trivial above degree zero and hence <math id="A2.SS2.p3.m5" class="ltx_Math" alttext="|\text{Wh}_{\bullet}^{h}(R,G)|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo>,</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\text{Wh}_{\bullet}^{h}(R,G)|</annotation></semantics></math> has the same rational homotopy type as <math id="A2.SS2.p3.m6" class="ltx_Math" alttext="\Omega BGL(R)^{+}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow><mo>+</mo></msup></mrow><annotation encoding="application/x-tex">\Omega BGL(R)^{+}</annotation></semantics></math>. If <math id="A2.SS2.p3.m7" class="ltx_Math" alttext="R=\mathbf{C}" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>=</mo><mi>𝐂</mi></mrow><annotation encoding="application/x-tex">R=\mathbf{C}</annotation></semantics></math> and <math id="A2.SS2.p3.m8" class="ltx_Math" alttext="K(\mathbf{C})=\mathbf{Z}\times BGL(\mathbf{C})^{+}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>𝐙</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>B</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo stretchy="false">)</mo></mrow><mo>+</mo></msup></mrow></mrow><annotation encoding="application/x-tex">K(\mathbf{C})=\mathbf{Z}\times BGL(\mathbf{C})^{+}</annotation></semantics></math>, we get a rational equivalence</p>
<table id="A2.Ex50" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex50.m1" class="ltx_math_unparsed" alttext="|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|\simeq_{\mathbf{Q}}\Omega K(\mathbf{C})." display="block" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo><mi>h</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo fence="false" stretchy="false">|</mo><msub><mo lspace="0.167em">≃</mo><mi>𝐐</mi></msub><mi mathvariant="normal">Ω</mi><mi>K</mi><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|\simeq_{\mathbf{Q}}\Omega K(\mathbf{C}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p3.4" class="ltx_p">We use the Borel regulator maps</p>
<table id="A2.Ex51" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex51.m1" class="ltx_Math" alttext="b_{k}:K_{2k+1}\mathbf{C}\to\mathbf{R}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>b</mi><mi>k</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>K</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐂</mi></mrow><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">b_{k}:K_{2k+1}\mathbf{C}\to\mathbf{R}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p3.5" class="ltx_p">These are given by cap product with continuous cohomology classes <math id="A2.SS2.p3.m9" class="ltx_Math" alttext="\mu_{k}\in H_{c}^{2k+1}(GL(\mathbf{C}),\mathbf{R})" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mi>k</mi></msub><mo>∈</mo><mrow><msubsup><mi>H</mi><mi>c</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>+</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>𝐑</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu_{k}\in H_{c}^{2k+1}(GL(\mathbf{C}),\mathbf{R})</annotation></semantics></math>:</p>
<table id="A2.Ex52" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex52.m1" class="ltx_Math" alttext="K_{2k+1}(\mathbf{C})\cong\pi_{2k+1}BGL(\mathbf{C})^{+}\xrightarrow{h}H_{2k+1}BGL(\mathbf{C})\xrightarrow{\cap\mu_{k}}\mathbf{R}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>K</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msub><mi>π</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo stretchy="false">)</mo></mrow><mo>+</mo></msup></mrow><mover accent="true"><mo>→</mo><mo mathsize="0.700em">ℎ</mo></mover><mrow><msub><mi>H</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo stretchy="false">)</mo></mrow></mrow><mover accent="true"><mo>→</mo><mrow><mo mathsize="0.700em" rspace="0em">∩</mo><msub><mi mathsize="0.700em">μ</mi><mi mathsize="0.710em">k</mi></msub></mrow></mover><mi>𝐑</mi></mrow><annotation encoding="application/x-tex">K_{2k+1}(\mathbf{C})\cong\pi_{2k+1}BGL(\mathbf{C})^{+}\xrightarrow{h}H_{2k+1}BGL(\mathbf{C})\xrightarrow{\cap\mu_{k}}\mathbf{R}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p3.6" class="ltx_p">where <math id="A2.SS2.p3.m10" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> is the Hurewicz map on <math id="A2.SS2.p3.m11" class="ltx_Math" alttext="BGL(\mathbf{C})^{+}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo stretchy="false">)</mo></mrow><mo>+</mo></msup></mrow><annotation encoding="application/x-tex">BGL(\mathbf{C})^{+}</annotation></semantics></math>, a space with the same homology as <math id="A2.SS2.p3.m12" class="ltx_Math" alttext="BGL(\mathbf{C})" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">BGL(\mathbf{C})</annotation></semantics></math>.
See <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx53" title="" class="ltx_ref">Ra</a>]</cite>. Since <math id="A2.SS2.p3.m13" class="ltx_Math" alttext="|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|</annotation></semantics></math> is rationally equivalent to <math id="A2.SS2.p3.m14" class="ltx_Math" alttext="\Omega K(\mathbf{C})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Omega K(\mathbf{C})</annotation></semantics></math>, we are able to obtain universal higher torsion invariants</p>
<table id="A2.Ex53" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex53.m1" class="ltx_Math" alttext="\tau_{k}\in H^{2k}(|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|;\mathbf{R})." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>τ</mi><mi>k</mi></msub><mo>∈</mo><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">|</mo><mrow><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>,</mo><mi>𝐑</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tau_{k}\in H^{2k}(|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|;\mathbf{R}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p3.7" class="ltx_p">These universal classes will be used to define higher torsion. The explicit cohomology class used in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx36" title="" class="ltx_ref">Igu02</a>]</cite> comes from the Dupont formulation of the Kamber-Tondeur form <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx18" title="" class="ltx_ref">D76</a>]</cite>.</p>
</div>
</section>
<section id="A2.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.3. </span>Definition of higher torsion</h3>

<div id="A2.SS3.p1" class="ltx_para">
<p id="A2.SS3.p1.1" class="ltx_p">Consider again a fiber bundle <math id="A2.SS3.p1.m1" class="ltx_Math" alttext="F\to W\to M" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo stretchy="false">→</mo><mi>W</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">F\to W\to M</annotation></semantics></math>, where we now assume that <math id="A2.SS3.p1.m2" class="ltx_Math" alttext="\pi_{1}M" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\pi_{1}M</annotation></semantics></math> acts unipotently on the rational fiber homology <math id="A2.SS3.p1.m3" class="ltx_Math" alttext="H_{*}(F_{b};\mathbf{Q})" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mi>b</mi></msub><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{*}(F_{b};\mathbf{Q})</annotation></semantics></math>. We would like to define cohomology classes in <math id="A2.SS3.p1.m4" class="ltx_Math" alttext="H^{2k}(M;\mathbf{R})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>𝐑</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{2k}(M;\mathbf{R})</annotation></semantics></math> by pulling back the class <math id="A2.SS3.p1.m5" class="ltx_Math" alttext="\tau_{k}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\tau_{k}</annotation></semantics></math> via the map</p>
<table id="A2.Ex54" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex54.m1" class="ltx_Math" alttext="\xi:M\to|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|" display="block" intent=":literal"><semantics><mrow><mi>ξ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mrow><mo stretchy="false">|</mo><mrow><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\xi:M\to|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.p1.2" class="ltx_p">given by a choice of fiberwise (generalized) Morse function <math id="A2.SS3.p1.m6" class="ltx_Math" alttext="f:W\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>W</mi><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:W\to\mathbf{R}</annotation></semantics></math> and choice of metric.
As explained above, <math id="A2.SS3.p1.m7" class="ltx_Math" alttext="\tau_{k}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\tau_{k}</annotation></semantics></math> is the restriction to <math id="A2.SS3.p1.m8" class="ltx_Math" alttext="|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|</annotation></semantics></math> of the universal higher torsion class <math id="A2.SS3.p1.m9" class="ltx_Math" alttext="\tau_{k}\in H^{2k}(\text{Wh}_{\bullet}^{h}(\mathbf{C},U(1));\mathbf{R})" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mi>k</mi></msub><mo>∈</mo><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo>,</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>𝐑</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau_{k}\in H^{2k}(\text{Wh}_{\bullet}^{h}(\mathbf{C},U(1));\mathbf{R})</annotation></semantics></math> given in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx38" title="" class="ltx_ref">Igu05</a>, subsection 2.7]</cite> and <math id="A2.SS3.p1.m10" class="ltx_Math" alttext="\xi" display="inline" intent=":literal"><semantics><mi>ξ</mi><annotation encoding="application/x-tex">\xi</annotation></semantics></math> is the “expansion functor”, see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx38" title="" class="ltx_ref">Igu05</a>, Def 2.18]</cite>.</p>
</div>
<div id="A2.SS3.p2" class="ltx_para">
<p id="A2.SS3.p2.1" class="ltx_p">At this point questions of existence and uniqueness of such <math id="A2.SS3.p2.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> arise. Although it is a (nontrivial) fact that fiberwise generalized Morse functions exist on any fiber bundle, it is not true that any two such functions will be joined by a family of such functions. Indeed, the map <math id="A2.SS3.p2.m2" class="ltx_Math" alttext="\xi:M\to|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|" display="inline" intent=":literal"><semantics><mrow><mi>ξ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mrow><mo stretchy="false">|</mo><mrow><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\xi:M\to|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|</annotation></semantics></math> obtained by the above construction may not be unique up to homotopy.</p>
</div>
<div id="A2.SS3.p3" class="ltx_para">
<p id="A2.SS3.p3.1" class="ltx_p">There is a canonical way to select the <span id="A2.SS3.p3.1.1" class="ltx_text ltx_font_italic">correct</span> map <math id="A2.SS3.p3.m1" class="ltx_Math" alttext="M\to|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo stretchy="false">→</mo><mrow><mo stretchy="false">|</mo><mrow><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">M\to|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|</annotation></semantics></math> by means of a <span id="A2.SS3.p3.1.2" class="ltx_text ltx_font_italic">framed function</span>. For any fiber bundle <math id="A2.SS3.p3.m2" class="ltx_Math" alttext="F\to W\to M" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo stretchy="false">→</mo><mi>W</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">F\to W\to M</annotation></semantics></math>, and any two framed functions <math id="A2.SS3.p3.m3" class="ltx_Math" alttext="f_{0},f_{1}:W\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>0</mn></msub><mo>,</mo><mrow><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>W</mi><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{0},f_{1}:W\to\mathbf{R}</annotation></semantics></math>, by Theorem <a href="#A1.Thmtheorem1" title="Theorem A.1. ‣ A.3. Framed functions ‣ Appendix A Moderate singularities ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.1</span></a> there exists a framed function on the product bundle <math id="A2.SS3.p3.m4" class="ltx_Math" alttext="W\times[0,1]\to M\times[0,1]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>W</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">W\times[0,1]\to M\times[0,1]</annotation></semantics></math> which restricts to <math id="A2.SS3.p3.m5" class="ltx_Math" alttext="f_{0}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>0</mn></msub><annotation encoding="application/x-tex">f_{0}</annotation></semantics></math> and <math id="A2.SS3.p3.m6" class="ltx_Math" alttext="f_{1}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>1</mn></msub><annotation encoding="application/x-tex">f_{1}</annotation></semantics></math> over <math id="A2.SS3.p3.m7" class="ltx_Math" alttext="M\times\{0\}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">M\times\{0\}</annotation></semantics></math> and <math id="A2.SS3.p3.m8" class="ltx_Math" alttext="M\times\{1\}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">M\times\{1\}</annotation></semantics></math> respectively. This gives a map</p>
<table id="A2.Ex55" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex55.m1" class="ltx_Math" alttext="M\times[0,1]\to|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|" display="block" intent=":literal"><semantics><mrow><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">|</mo><mrow><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">M\times[0,1]\to|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.p3.2" class="ltx_p">which may be viewed as a homotopy between the maps <math id="A2.SS3.p3.m9" class="ltx_Math" alttext="M\to|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo stretchy="false">→</mo><mrow><mo stretchy="false">|</mo><mrow><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">M\to|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|</annotation></semantics></math> given by <math id="A2.SS3.p3.m10" class="ltx_Math" alttext="f_{0}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>0</mn></msub><annotation encoding="application/x-tex">f_{0}</annotation></semantics></math> and <math id="A2.SS3.p3.m11" class="ltx_Math" alttext="f_{1}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>1</mn></msub><annotation encoding="application/x-tex">f_{1}</annotation></semantics></math>. Hence by choosing a framed function on <math id="A2.SS3.p3.m12" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> we get a well-defined and distinguished homotopy class of map</p>
<table id="A2.Ex56" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex56.m1" class="ltx_Math" alttext="\xi_{0}:M\to|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ξ</mi><mn>0</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mrow><mo stretchy="false">|</mo><mrow><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\xi_{0}:M\to|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.Thmtheorem1" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem1.1" class="ltx_text ltx_font_bold">Definition B.1</span></span><span id="A2.Thmtheorem1.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem1.p1" class="ltx_para">
<p id="A2.Thmtheorem1.p1.1" class="ltx_p">Assume that <math id="A2.Thmtheorem1.p1.m1" class="ltx_Math" alttext="\pi_{1}M" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\pi_{1}M</annotation></semantics></math> acts unipotently on <math id="A2.Thmtheorem1.p1.m2" class="ltx_Math" alttext="H_{*}(F_{b};\mathbf{Q})" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mi>b</mi></msub><mo>,</mo><mi>𝐐</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{*}(F_{b};\mathbf{Q})</annotation></semantics></math>. The <span id="A2.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">higher torsion classes</span> <math id="A2.Thmtheorem1.p1.m3" class="ltx_Math" alttext="\tau_{k}(W)\in H^{2k}(M;\mathbf{R})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>τ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>𝐑</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau_{k}(W)\in H^{2k}(M;\mathbf{R})</annotation></semantics></math> are defined as the pullback of the universal classes <math id="A2.Thmtheorem1.p1.m4" class="ltx_Math" alttext="\tau_{k}\in H^{2k}(|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|;\mathbf{R})" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mi>k</mi></msub><mo>∈</mo><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">|</mo><mrow><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>,</mo><mi>𝐑</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau_{k}\in H^{2k}(|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|;\mathbf{R})</annotation></semantics></math> under the homotopically unique map <math id="A2.Thmtheorem1.p1.m5" class="ltx_Math" alttext="\xi_{0}:M\to|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|" display="inline" intent=":literal"><semantics><mrow><msub><mi>ξ</mi><mn>0</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mrow><mo stretchy="false">|</mo><mrow><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\xi_{0}:M\to|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|</annotation></semantics></math> determined by a framed function on <math id="A2.Thmtheorem1.p1.m6" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math>.</p>
</div>
</div>
<div id="A2.Thmtheorem2" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem2.1" class="ltx_text ltx_font_italic">Example B.2</span></span><span id="A2.Thmtheorem2.2" class="ltx_text ltx_font_italic">.</span></h6>
<div id="A2.Thmtheorem2.p1" class="ltx_para">
<p id="A2.Thmtheorem2.p1.1" class="ltx_p">The degree zero class <math id="A2.Thmtheorem2.p1.m1" class="ltx_Math" alttext="\tau_{0}(W,\rho)\in H^{0}(M;\mathbf{R})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>τ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo>,</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>𝐑</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau_{0}(W,\rho)\in H^{0}(M;\mathbf{R})</annotation></semantics></math> is just the usual Franz-Reidemeister torsion of the fiber twisted by the local system <math id="A2.Thmtheorem2.p1.m2" class="ltx_Math" alttext="\rho|_{\pi_{1}F}" display="inline" intent=":literal"><semantics><msub><mrow><mi>ρ</mi><mo stretchy="false">|</mo></mrow><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><annotation encoding="application/x-tex">\rho|_{\pi_{1}F}</annotation></semantics></math>, maybe after taking absolute value and natural logarithm depending on conventions <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx24" title="" class="ltx_ref">Fra35</a>, <a href="#bib.bibx54" title="" class="ltx_ref">Rei35</a>]</cite>.</p>
</div>
</div>
</section>
<section id="A2.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.4. </span>Higher Reidemeister torsion with twisted coefficients</h3>

<div id="A2.SS4.p1" class="ltx_para">
<p id="A2.SS4.p1.1" class="ltx_p">We can generalize the above discussion to fiber bundles <math id="A2.SS4.p1.m1" class="ltx_Math" alttext="F\to W\to M" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo stretchy="false">→</mo><mi>W</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">F\to W\to M</annotation></semantics></math> equipped with a rank 1 unitary local system <math id="A2.SS4.p1.m2" class="ltx_Math" alttext="\rho:\pi_{1}M\to U(1)" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">→</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho:\pi_{1}M\to U(1)</annotation></semantics></math> with finite image <math id="A2.SS4.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> such that the action of <math id="A2.SS4.p1.m4" class="ltx_Math" alttext="\pi_{1}M" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\pi_{1}M</annotation></semantics></math> on the twisted fiber homology <math id="A2.SS4.p1.m5" class="ltx_Math" alttext="H_{*}(F_{m};\mathbf{C}^{\rho})" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mi>m</mi></msub><mo>,</mo><msup><mi>𝐂</mi><mi>ρ</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{*}(F_{m};\mathbf{C}^{\rho})</annotation></semantics></math> is unipotent. The framed function theorem still gives us a well-defined map (up to homotopy)</p>
<table id="A2.Ex57" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex57.m1" class="ltx_Math" alttext="\xi_{\rho}:M\to|\text{Wh}_{\bullet}^{h}(\mathbf{C},G)|" display="block" intent=":literal"><semantics><mrow><msub><mi>ξ</mi><mi>ρ</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mrow><mo stretchy="false">|</mo><mrow><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo>,</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\xi_{\rho}:M\to|\text{Wh}_{\bullet}^{h}(\mathbf{C},G)|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p1.2" class="ltx_p">and we get classes <math id="A2.SS4.p1.m6" class="ltx_Math" alttext="\tau_{k}(W,\rho)\in H^{2k}(M;\mathbf{R})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>τ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo>,</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>𝐑</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau_{k}(W,\rho)\in H^{2k}(M;\mathbf{R})</annotation></semantics></math> by pulling back the universal classes. In fact, if real coefficients are used instead of complex coefficients, then the odd classes automatically vanish, i.e. the pullback of <math id="A2.SS4.p1.m7" class="ltx_Math" alttext="\tau_{2k+1}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\tau_{2k+1}</annotation></semantics></math> to <math id="A2.SS4.p1.m8" class="ltx_Math" alttext="|\text{Wh}_{\bullet}^{h}(\mathbf{R},G)|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐑</mi><mo>,</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\text{Wh}_{\bullet}^{h}(\mathbf{R},G)|</annotation></semantics></math> is zero, <math id="A2.SS4.p1.m9" class="ltx_Math" alttext="G=\{\pm 1\}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mo>±</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">G=\{\pm 1\}</annotation></semantics></math>. So to get nontrivial odd torsion classes <math id="A2.SS4.p1.m10" class="ltx_Math" alttext="\tau_{2k+1}(W,\rho)\in H^{4k+2}(M;\mathbf{R})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>τ</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo>,</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><msup><mi>H</mi><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>+</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>𝐑</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau_{2k+1}(W,\rho)\in H^{4k+2}(M;\mathbf{R})</annotation></semantics></math> one needs to use a nontrivial unitary local system.</p>
</div>
<div id="A2.SS4.p2" class="ltx_para">
<p id="A2.SS4.p2.1" class="ltx_p">The use of unitary local systems can be convenient depending on the application, for example in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx8" title="" class="ltx_ref">AI</a>]</cite> the higher Reidemeister torsion of circle bundles over the sphere is shown to compute a stable version of the Euler number. However, for the specific version of higher torsion we will focus on in the present article there is no local system. Indeed we will use <math id="A2.SS4.p2.m1" class="ltx_Math" alttext="\mathbf{Z}" display="inline" intent=":literal"><semantics><mi>𝐙</mi><annotation encoding="application/x-tex">\mathbf{Z}</annotation></semantics></math> coefficients, and so we will only get the even classes <math id="A2.SS4.p2.m2" class="ltx_Math" alttext="\tau_{2k}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">\tau_{2k}</annotation></semantics></math> in <math id="A2.SS4.p2.m3" class="ltx_Math" alttext="H^{4k}(M;\mathbf{R})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>𝐑</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{4k}(M;\mathbf{R})</annotation></semantics></math>.</p>
</div>
</section>
<section id="A2.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.5. </span>The framing principle</h3>

<div id="A2.SS5.p1" class="ltx_para">
<p id="A2.SS5.p1.1" class="ltx_p">A useful result for computations of higher torsion is the <span id="A2.SS5.p1.1.1" class="ltx_text ltx_font_italic">framing principle</span>, which gives the precise correction term needed to compute the higher Reidemeister torsion for a function <math id="A2.SS5.p1.m1" class="ltx_Math" alttext="f:W\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>W</mi><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:W\to\mathbf{R}</annotation></semantics></math> with moderate singularities, even if the stable bundle <math id="A2.SS5.p1.m2" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> is not trivial (and hence <math id="A2.SS5.p1.m3" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is not frameable). The formula <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx36" title="" class="ltx_ref">Igu02</a>, Theorem 4.11]</cite> is the following.</p>
</div>
<div id="A2.Thmtheorem3" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem3.1" class="ltx_text ltx_font_bold">Theorem B.3</span></span><span id="A2.Thmtheorem3.2" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem3.p1" class="ltx_para">
<p id="A2.Thmtheorem3.p1.1" class="ltx_p"><span id="A2.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">If <math id="A2.Thmtheorem3.p1.m1" class="ltx_Math" alttext="f:W\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>W</mi><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:W\to\mathbf{R}</annotation></semantics></math> is a function with moderate singularities, then</span></p>
<table id="A2.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(1)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E1.m1" class="ltx_Math" alttext="\tau(W,\rho)=\sum_{j}\tau_{j}(f,\rho)+\frac{1}{2}\sum_{k}(-1)^{k}\zeta(2k+1)\pi_{\ast}^{\Sigma f}\left(ch_{2k}(\gamma_{f}\otimes\mathbf{C})\right)" display="block" intent=":literal"><semantics><mrow><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo>,</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><munder><mo movablelimits="false">∑</mo><mi>j</mi></munder><mrow><msub><mi>τ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mi>k</mi></munder><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>π</mi><mo>∗</mo><mrow><mi mathvariant="normal">Σ</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>γ</mi><mi>f</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝐂</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau(W,\rho)=\sum_{j}\tau_{j}(f,\rho)+\frac{1}{2}\sum_{k}(-1)^{k}\zeta(2k+1)\pi_{\ast}^{\Sigma f}\left(ch_{2k}(\gamma_{f}\otimes\mathbf{C})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmtheorem3.p1.2" class="ltx_p"><span id="A2.Thmtheorem3.p1.2.1" class="ltx_text ltx_font_italic">where the terms are defined below.</span></p>
</div>
</div>
<div id="A2.SS5.p2" class="ltx_para">
<ul id="A2.I1" class="ltx_itemize">
<li id="A2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I1.i1.p1" class="ltx_para">
<p id="A2.I1.i1.p1.1" class="ltx_p"><math id="A2.I1.i1.p1.m1" class="ltx_Math" alttext="\tau_{j}(f,\rho)\in H^{2j}(M;\mathbf{R})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>τ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>𝐑</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau_{j}(f,\rho)\in H^{2j}(M;\mathbf{R})</annotation></semantics></math> is the pull-back of the universal class <math id="A2.I1.i1.p1.m2" class="ltx_Math" alttext="\tau_{j}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\tau_{j}</annotation></semantics></math> under <math id="A2.I1.i1.p1.m3" class="ltx_Math" alttext="M\to|\text{Wh}_{\bullet}^{h}(\mathbf{C},G)|" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo stretchy="false">→</mo><mrow><mo stretchy="false">|</mo><mrow><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo>,</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">M\to|\text{Wh}_{\bullet}^{h}(\mathbf{C},G)|</annotation></semantics></math>, the mapping given by the family of Morse chain complexes associated to the family of functions <math id="A2.I1.i1.p1.m4" class="ltx_Math" alttext="F_{m}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>m</mi></msub><annotation encoding="application/x-tex">F_{m}</annotation></semantics></math>, <math id="A2.I1.i1.p1.m5" class="ltx_math_unparsed" alttext=",m\in M" display="inline" intent=":literal"><semantics><mrow><mo>,</mo><mi>m</mi><mo>∈</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">,m\in M</annotation></semantics></math>. We are assuming that <math id="A2.I1.i1.p1.m6" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> has a finite image <math id="A2.I1.i1.p1.m7" class="ltx_Math" alttext="G\subset U(1)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⊂</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">G\subset U(1)</annotation></semantics></math>.</p>
</div></li>
<li id="A2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I1.i2.p1" class="ltx_para">
<p id="A2.I1.i2.p1.1" class="ltx_p"><math id="A2.I1.i2.p1.m1" class="ltx_Math" alttext="\Sigma_{f}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>f</mi></msub><annotation encoding="application/x-tex">\Sigma_{f}</annotation></semantics></math> is the fiberwise singular set of <math id="A2.I1.i2.p1.m2" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>. It has the same dimension as the base <math id="A2.I1.i2.p1.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> and is a union <math id="A2.I1.i2.p1.m4" class="ltx_Math" alttext="\Sigma_{f}=\bigcup\Sigma_{f,k}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mi>f</mi></msub><mo rspace="0.111em">=</mo><mrow><mo>⋃</mo><msub><mi mathvariant="normal">Σ</mi><mrow><mi>f</mi><mo>,</mo><mi>k</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\Sigma_{f}=\bigcup\Sigma_{f,k}</annotation></semantics></math> as discussed in Appendix <a href="#A1" title="Appendix A Moderate singularities ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A</span></a>.</p>
</div></li>
<li id="A2.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I1.i3.p1" class="ltx_para">
<p id="A2.I1.i3.p1.1" class="ltx_p"><math id="A2.I1.i3.p1.m1" class="ltx_Math" alttext="\gamma_{f}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mi>f</mi></msub><annotation encoding="application/x-tex">\gamma_{f}</annotation></semantics></math> is the stable bundle of <math id="A2.I1.i3.p1.m2" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> as also discussed in Appendix <a href="#A1" title="Appendix A Moderate singularities ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A</span></a>.</p>
</div></li>
<li id="A2.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I1.i4.p1" class="ltx_para">
<p id="A2.I1.i4.p1.1" class="ltx_p">The map <math id="A2.I1.i4.p1.m1" class="ltx_Math" alttext="\pi_{\ast}^{\Sigma f}:H^{4k}(\Sigma)\to H^{4k}(M)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>π</mi><mo>∗</mo><mrow><mi mathvariant="normal">Σ</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>H</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi_{\ast}^{\Sigma f}:H^{4k}(\Sigma)\to H^{4k}(M)</annotation></semantics></math> is, at the cochain level, the alternating sum of push-down operators:</p>
<table id="A2.Ex58" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex58.m1" class="ltx_Math" alttext="\pi_{\ast}^{\Sigma f}=\sum_{i}(-1)^{i}\pi_{\ast}:C^{4k}(\Sigma_{f,i})\to C^{4k}(M)." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>π</mi><mo>∗</mo><mrow><mi mathvariant="normal">Σ</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msubsup><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mi>i</mi></munder><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mo>∗</mo></msub></mrow></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>C</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mrow><mi>f</mi><mo>,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>C</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\pi_{\ast}^{\Sigma f}=\sum_{i}(-1)^{i}\pi_{\ast}:C^{4k}(\Sigma_{f,i})\to C^{4k}(M).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ul>
</div>
<div id="A2.SS5.p3" class="ltx_para">
<p id="A2.SS5.p3.1" class="ltx_p">Explicitly, given a <math id="A2.SS5.p3.m1" class="ltx_Math" alttext="4k" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">4k</annotation></semantics></math> cocycle <math id="A2.SS5.p3.m2" class="ltx_Math" alttext="\varphi" display="inline" intent=":literal"><semantics><mi>φ</mi><annotation encoding="application/x-tex">\varphi</annotation></semantics></math> on <math id="A2.SS5.p3.m3" class="ltx_Math" alttext="\Sigma_{f}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>f</mi></msub><annotation encoding="application/x-tex">\Sigma_{f}</annotation></semantics></math> we take the restriction <math id="A2.SS5.p3.m4" class="ltx_Math" alttext="\varphi_{i}" display="inline" intent=":literal"><semantics><msub><mi>φ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\varphi_{i}</annotation></semantics></math> of <math id="A2.SS5.p3.m5" class="ltx_Math" alttext="\varphi" display="inline" intent=":literal"><semantics><mi>φ</mi><annotation encoding="application/x-tex">\varphi</annotation></semantics></math> on each <math id="A2.SS5.p3.m6" class="ltx_Math" alttext="\Sigma_{f,i}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mrow><mi>f</mi><mo>,</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{f,i}</annotation></semantics></math>. This is well-defined away from the boundary of <math id="A2.SS5.p3.m7" class="ltx_Math" alttext="\Sigma_{f,i}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mrow><mi>f</mi><mo>,</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{f,i}</annotation></semantics></math>. The image of this in <math id="A2.SS5.p3.m8" class="ltx_Math" alttext="C^{4k}(M)" display="inline" intent=":literal"><semantics><mrow><msup><mi>C</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C^{4k}(M)</annotation></semantics></math> is the <math id="A2.SS5.p3.m9" class="ltx_Math" alttext="4k" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">4k</annotation></semantics></math>-cocycle which takes a small <math id="A2.SS5.p3.m10" class="ltx_Math" alttext="4k" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">4k</annotation></semantics></math> simplex <math id="A2.SS5.p3.m11" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> in <math id="A2.SS5.p3.m12" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, takes all sections <math id="A2.SS5.p3.m13" class="ltx_Math" alttext="\tilde{\sigma}_{i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mi>i</mi></msub><annotation encoding="application/x-tex">\tilde{\sigma}_{i}</annotation></semantics></math> of <math id="A2.SS5.p3.m14" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> to <math id="A2.SS5.p3.m15" class="ltx_Math" alttext="\Sigma_{f,i}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mrow><mi>f</mi><mo>,</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{f,i}</annotation></semantics></math> and evaluates</p>
<table id="A2.Ex59" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex59.m1" class="ltx_Math" alttext="\pi_{\ast}^{\Sigma f}(\varphi)(\sigma)=\sum(-1)^{i}\varphi_{i}(\tilde{\sigma}_{i})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>π</mi><mo>∗</mo><mrow><mi mathvariant="normal">Σ</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>φ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo movablelimits="false" rspace="0em">∑</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>φ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\pi_{\ast}^{\Sigma f}(\varphi)(\sigma)=\sum(-1)^{i}\varphi_{i}(\tilde{\sigma}_{i}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS5.p3.2" class="ltx_p">The undefined terms cancel since, when <math id="A2.SS5.p3.m16" class="ltx_Math" alttext="\tilde{\sigma}_{i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mi>i</mi></msub><annotation encoding="application/x-tex">\tilde{\sigma}_{i}</annotation></semantics></math> reaches the boundary of <math id="A2.SS5.p3.m17" class="ltx_Math" alttext="\Sigma_{f,i}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mrow><mi>f</mi><mo>,</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{f,i}</annotation></semantics></math>, it is at a cusp which is the same location as a section <math id="A2.SS5.p3.m18" class="ltx_Math" alttext="\tilde{\sigma}_{i+1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\tilde{\sigma}_{i+1}</annotation></semantics></math> (or <math id="A2.SS5.p3.m19" class="ltx_Math" alttext="\tilde{\sigma}_{i-1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\tilde{\sigma}_{i-1}</annotation></semantics></math>). The alternating signs makes these undefined terms equal with opposite sign. So, <math id="A2.SS5.p3.m20" class="ltx_Math" alttext="\pi_{\ast}^{\Sigma f}" display="inline" intent=":literal"><semantics><msubsup><mi>π</mi><mo>∗</mo><mrow><mi mathvariant="normal">Σ</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msubsup><annotation encoding="application/x-tex">\pi_{\ast}^{\Sigma f}</annotation></semantics></math> is well-defined. See <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx36" title="" class="ltx_ref">Igu02</a>, Proposition 4.8]</cite> for more details of this argument. It is shown there that <math id="A2.SS5.p3.m21" class="ltx_Math" alttext="\pi_{\ast}^{\Sigma f}" display="inline" intent=":literal"><semantics><msubsup><mi>π</mi><mo>∗</mo><mrow><mi mathvariant="normal">Σ</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msubsup><annotation encoding="application/x-tex">\pi_{\ast}^{\Sigma f}</annotation></semantics></math> is a related to the Becker-Gottlieb transfer <math id="A2.SS5.p3.m22" class="ltx_Math" alttext="\text{tr}_{M}^{W}:H^{\ast}(W)\to H^{\ast}(M)" display="inline" intent=":literal"><semantics><mrow><msubsup><mtext>tr</mtext><mi>M</mi><mi>W</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{tr}_{M}^{W}:H^{\ast}(W)\to H^{\ast}(M)</annotation></semantics></math> by <math id="A2.SS5.p3.m23" class="ltx_Math" alttext="\text{tr}_{M}^{W}=\pi_{\ast}^{\Sigma f}\circ i^{\ast}" display="inline" intent=":literal"><semantics><mrow><msubsup><mtext>tr</mtext><mi>M</mi><mi>W</mi></msubsup><mo>=</mo><mrow><msubsup><mi>π</mi><mo>∗</mo><mrow><mi mathvariant="normal">Σ</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>i</mi><mo>∗</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\text{tr}_{M}^{W}=\pi_{\ast}^{\Sigma f}\circ i^{\ast}</annotation></semantics></math> where <math id="A2.SS5.p3.m24" class="ltx_Math" alttext="i^{\ast}:H^{\ast}(W)\to H^{\ast}(\Sigma_{f})" display="inline" intent=":literal"><semantics><mrow><msup><mi>i</mi><mo>∗</mo></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>f</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">i^{\ast}:H^{\ast}(W)\to H^{\ast}(\Sigma_{f})</annotation></semantics></math> is the restriction map induced by the inclusion <math id="A2.SS5.p3.m25" class="ltx_Math" alttext="i:\Sigma_{f}\to W" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>f</mi></msub><mo stretchy="false">→</mo><mi>W</mi></mrow></mrow><annotation encoding="application/x-tex">i:\Sigma_{f}\to W</annotation></semantics></math>.</p>
</div>
<div id="A2.SS5.p4" class="ltx_para">
<p id="A2.SS5.p4.1" class="ltx_p">Note that the correction term in (<a href="#A2.E1" title="In Theorem B.3. ‣ B.5. The framing principle ‣ Appendix B Higher torsion of fiber bundles ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>) is nonzero only in degrees <math id="A2.SS5.p4.m1" class="ltx_Math" alttext="4k" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">4k</annotation></semantics></math>. In degrees <math id="A2.SS5.p4.m2" class="ltx_Math" alttext="2j=4k+2" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>=</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>+</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">2j=4k+2</annotation></semantics></math>, when <math id="A2.SS5.p4.m3" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> is odd, there is no correction term (i.e. the correction term is zero.)</p>
</div>
<div id="A2.SS5.p5" class="ltx_para">
<p id="A2.SS5.p5.1" class="ltx_p">Also note that the term <math id="A2.SS5.p5.m1" class="ltx_Math" alttext="\sum_{j}\tau_{j}(f)" display="inline" intent=":literal"><semantics><mrow><msub><mo>∑</mo><mi>j</mi></msub><mrow><msub><mi>τ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{j}\tau_{j}(f)</annotation></semantics></math> changes by a sign if the indices of the fiberwise Morse chain complexes are all shifted by one in either direction. More precisely, the index shift operator on <math id="A2.SS5.p5.m2" class="ltx_Math" alttext="\text{Wh}_{\bullet}^{h}(\mathbf{C},G)" display="inline" intent=":literal"><semantics><mrow><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo>,</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{Wh}_{\bullet}^{h}(\mathbf{C},G)</annotation></semantics></math> induces map <math id="A2.SS5.p5.m3" class="ltx_Math" alttext="|\text{Wh}_{\bullet}^{h}(\mathbf{C},G)|\to|\text{Wh}_{\bullet}^{h}(\mathbf{C},G)|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo>,</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">|</mo><mrow><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo>,</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">|\text{Wh}_{\bullet}^{h}(\mathbf{C},G)|\to|\text{Wh}_{\bullet}^{h}(\mathbf{C},G)|</annotation></semantics></math> which sends <math id="A2.SS5.p5.m4" class="ltx_Math" alttext="\tau_{j}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\tau_{j}</annotation></semantics></math> to <math id="A2.SS5.p5.m5" class="ltx_Math" alttext="-\tau_{j}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><msub><mi>τ</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">-\tau_{j}</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx38" title="" class="ltx_ref">Igu05</a>, Theorem 3.10]</cite>. However, in this paper we are always suspending an even number of times. So there is no change of sign.</p>
</div>
<div id="A2.SS5.p6" class="ltx_para">
<p id="A2.SS5.p6.1" class="ltx_p">To summarize:</p>
</div>
<div id="A2.SS5.p7" class="ltx_para">
<p id="A2.SS5.p7.1" class="ltx_p"><span id="A2.SS5.p7.1.1" class="ltx_text ltx_font_italic">We can use the family of Morse chain complexes <math id="A2.SS5.p7.m1" class="ltx_Math" alttext="C(f_{m})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C(f_{m})</annotation></semantics></math>, <math id="A2.SS5.p7.m2" class="ltx_Math" alttext="m\in M" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">m\in M</annotation></semantics></math> of a function with moderate singularities <math id="A2.SS5.p7.m3" class="ltx_Math" alttext="f:W\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>W</mi><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:W\to\mathbf{R}</annotation></semantics></math> to compute the higher torsion of <math id="A2.SS5.p7.m4" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> over <math id="A2.SS5.p7.m5" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> if we add correction terms in degree <math id="A2.SS5.p7.m6" class="ltx_Math" alttext="4k" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">4k</annotation></semantics></math> given by a suitable multiple of the push-down to <math id="A2.SS5.p7.m7" class="ltx_Math" alttext="H^{\ast}(M)" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{\ast}(M)</annotation></semantics></math> of the Pontryagin character of the stable bundle <math id="A2.SS5.p7.m8" class="ltx_Math" alttext="\gamma_{f}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mi>f</mi></msub><annotation encoding="application/x-tex">\gamma_{f}</annotation></semantics></math> over <math id="A2.SS5.p7.m9" class="ltx_Math" alttext="\Sigma_{f}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>f</mi></msub><annotation encoding="application/x-tex">\Sigma_{f}</annotation></semantics></math>.</span></p>
</div>
</section>
<section id="A2.SS6" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.6. </span>Fibers with boundary</h3>

<div id="A2.SS6.p1" class="ltx_para">
<p id="A2.SS6.p1.1" class="ltx_p">Higher torsion invariants may also be defined for fiber bundles <math id="A2.SS6.p1.m1" class="ltx_Math" alttext="F\to W\to M" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo stretchy="false">→</mo><mi>W</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">F\to W\to M</annotation></semantics></math> where the fiber <math id="A2.SS6.p1.m2" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> is a compact manifold with boundary. In the <span id="A2.SS6.p1.1.1" class="ltx_text ltx_font_italic">absolute</span> case we just use functions <math id="A2.SS6.p1.m3" class="ltx_Math" alttext="f:(W,\partial W)\to([0,1],1)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">(</mo><mi>W</mi><mo rspace="0em">,</mo><mrow><mo>∂</mo><mi>W</mi></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f:(W,\partial W)\to([0,1],1)</annotation></semantics></math> with moderate singularities such that for each fiber <math id="A2.SS6.p1.m4" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> we have that <math id="A2.SS6.p1.m5" class="ltx_Math" alttext="\partial F" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mi>F</mi></mrow><annotation encoding="application/x-tex">\partial F</annotation></semantics></math> is a regular level set. More generally, it suffices to impose the condition that <math id="A2.SS6.p1.m6" class="ltx_Math" alttext="df(v)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">df(v)&gt;0</annotation></semantics></math> for outwards pointing tangent vectors <math id="A2.SS6.p1.m7" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> along <math id="A2.SS6.p1.m8" class="ltx_Math" alttext="\partial F" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mi>F</mi></mrow><annotation encoding="application/x-tex">\partial F</annotation></semantics></math>. However it is also convenient to consider <span id="A2.SS6.p1.1.2" class="ltx_text ltx_font_italic">relative</span> versions in which the fiberwise homology of the function computes a relative homology group. As this relative case is directly relevant to the present article, we discuss some examples below.</p>
</div>
<div id="A2.SS6.p2" class="ltx_para">
<p id="A2.SS6.p2.1" class="ltx_p">For example, the construction may be applied in the case in which the fiber <math id="A2.SS6.p2.m1" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> is a cobordism on a manifold <math id="A2.SS6.p2.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>, so that <math id="A2.SS6.p2.m3" class="ltx_Math" alttext="\partial F=\partial_{0}F\coprod\partial_{1}F" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mphantom></mphantom><mrow><mi>F</mi><mo rspace="0.111em">=</mo><mrow><msub><mo>∂</mo><mn>0</mn></msub><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">∐</mo><mrow><msub><mo>∂</mo><mn>1</mn></msub><mi>F</mi></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\partial F=\partial_{0}F\coprod\partial_{1}F</annotation></semantics></math> and we have an identification <math id="A2.SS6.p2.m4" class="ltx_Math" alttext="\partial_{0}F\simeq X" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∂</mo><mn>0</mn></msub><mi>F</mi></mrow><mo>≃</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">\partial_{0}F\simeq X</annotation></semantics></math>. More precisely, this means that <math id="A2.SS6.p2.m5" class="ltx_Math" alttext="\partial W=\partial_{0}W\coprod\partial_{1}W" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mphantom></mphantom><mrow><mi>W</mi><mo rspace="0.111em">=</mo><mrow><msub><mo>∂</mo><mn>0</mn></msub><mrow><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">∐</mo><mrow><msub><mo>∂</mo><mn>1</mn></msub><mi>W</mi></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\partial W=\partial_{0}W\coprod\partial_{1}W</annotation></semantics></math> and we have a trivialization of the fiber bundle <math id="A2.SS6.p2.m6" class="ltx_Math" alttext="\partial_{0}W\to M" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∂</mo><mn>0</mn></msub><mi>W</mi></mrow><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\partial_{0}W\to M</annotation></semantics></math>, i.e. a fibered diffeomorphism <math id="A2.SS6.p2.m7" class="ltx_Math" alttext="\partial_{0}W\simeq M\times X" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∂</mo><mn>0</mn></msub><mi>W</mi></mrow><mo>≃</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">\partial_{0}W\simeq M\times X</annotation></semantics></math>. In this case higher torsion is defined using functions <math id="A2.SS6.p2.m8" class="ltx_Math" alttext="(W,\partial_{0}W,\partial_{1}W)\to([0,1],0,1)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>W</mi><mo rspace="0em">,</mo><mrow><msub><mo>∂</mo><mn>0</mn></msub><mi>W</mi></mrow><mo rspace="0em">,</mo><mrow><msub><mo>∂</mo><mn>1</mn></msub><mi>W</mi></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mo>,</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(W,\partial_{0}W,\partial_{1}W)\to([0,1],0,1)</annotation></semantics></math> with moderate singularities and yields an invariant of such fiber bundles <math id="A2.SS6.p2.m9" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> equipped with a trivialization <math id="A2.SS6.p2.m10" class="ltx_Math" alttext="\partial_{0}W\simeq M\times X" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∂</mo><mn>0</mn></msub><mi>W</mi></mrow><mo>≃</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">\partial_{0}W\simeq M\times X</annotation></semantics></math>, or more generally such that <math id="A2.SS6.p2.m11" class="ltx_Math" alttext="df(v)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">df(v)&gt;0</annotation></semantics></math> for outwards pointing tangent vectors <math id="A2.SS6.p2.m12" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> along <math id="A2.SS6.p2.m13" class="ltx_Math" alttext="\partial_{1}F" display="inline" intent=":literal"><semantics><mrow><msub><mo>∂</mo><mn>1</mn></msub><mi>F</mi></mrow><annotation encoding="application/x-tex">\partial_{1}F</annotation></semantics></math> and <math id="A2.SS6.p2.m14" class="ltx_Math" alttext="df(v)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">df(v)&gt;0</annotation></semantics></math> for inwards pointing tangent vectors <math id="A2.SS6.p2.m15" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> along <math id="A2.SS6.p2.m16" class="ltx_Math" alttext="\partial_{0}F" display="inline" intent=":literal"><semantics><mrow><msub><mo>∂</mo><mn>0</mn></msub><mi>F</mi></mrow><annotation encoding="application/x-tex">\partial_{0}F</annotation></semantics></math>.</p>
</div>
<div id="A2.SS6.p3" class="ltx_para">
<p id="A2.SS6.p3.1" class="ltx_p">The fiber <math id="A2.SS6.p3.m1" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> could be also be a compact manifold with corners, thought of as a cobordism on a compact manifold with boundary (or even corners) <math id="A2.SS6.p3.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. In this case the boundary <math id="A2.SS6.p3.m3" class="ltx_Math" alttext="\partial F" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mi>F</mi></mrow><annotation encoding="application/x-tex">\partial F</annotation></semantics></math> is divided into a <span id="A2.SS6.p3.1.1" class="ltx_text ltx_font_italic">horizontal </span>boundary <math id="A2.SS6.p3.m4" class="ltx_Math" alttext="\partial_{h}F" display="inline" intent=":literal"><semantics><mrow><msub><mo>∂</mo><mi>h</mi></msub><mi>F</mi></mrow><annotation encoding="application/x-tex">\partial_{h}F</annotation></semantics></math> and a <span id="A2.SS6.p3.1.2" class="ltx_text ltx_font_italic">vertical boundary</span> <math id="A2.SS6.p3.m5" class="ltx_Math" alttext="\partial_{v}F" display="inline" intent=":literal"><semantics><mrow><msub><mo>∂</mo><mi>v</mi></msub><mi>F</mi></mrow><annotation encoding="application/x-tex">\partial_{v}F</annotation></semantics></math>, with <math id="A2.SS6.p3.m6" class="ltx_Math" alttext="\partial_{v}F\simeq\partial_{0}F\coprod\partial_{1}F" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∂</mo><mi>v</mi></msub><mi>F</mi></mrow><mo rspace="0.111em">≃</mo><mrow><msub><mo>∂</mo><mn>0</mn></msub><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">∐</mo><mrow><msub><mo>∂</mo><mn>1</mn></msub><mi>F</mi></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\partial_{v}F\simeq\partial_{0}F\coprod\partial_{1}F</annotation></semantics></math> and an identification <math id="A2.SS6.p3.m7" class="ltx_Math" alttext="\partial_{0}F\simeq X" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∂</mo><mn>0</mn></msub><mi>F</mi></mrow><mo>≃</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">\partial_{0}F\simeq X</annotation></semantics></math> as before. The boundary <math id="A2.SS6.p3.m8" class="ltx_Math" alttext="\partial W" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mi>W</mi></mrow><annotation encoding="application/x-tex">\partial W</annotation></semantics></math> of such a fiber bundle <math id="A2.SS6.p3.m9" class="ltx_Math" alttext="F\to W\to M" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo stretchy="false">→</mo><mi>W</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">F\to W\to M</annotation></semantics></math> is similarly decomposed, and such fiber bundles should be equipped with a fibered diffeomorphism <math id="A2.SS6.p3.m10" class="ltx_Math" alttext="\partial_{0}W\simeq M\times X" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∂</mo><mn>0</mn></msub><mi>W</mi></mrow><mo>≃</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">\partial_{0}W\simeq M\times X</annotation></semantics></math>. The torsion is again defined using functions <math id="A2.SS6.p3.m11" class="ltx_Math" alttext="(W,\partial_{0}W,\partial_{1}W)\to([0,1],0,1)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>W</mi><mo rspace="0em">,</mo><mrow><msub><mo>∂</mo><mn>0</mn></msub><mi>W</mi></mrow><mo rspace="0em">,</mo><mrow><msub><mo>∂</mo><mn>1</mn></msub><mi>W</mi></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mo>,</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(W,\partial_{0}W,\partial_{1}W)\to([0,1],0,1)</annotation></semantics></math> with moderate singularities, or more generally such that <math id="A2.SS6.p3.m12" class="ltx_Math" alttext="df(v)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">df(v)&gt;0</annotation></semantics></math> for outwards pointing tangent vectors <math id="A2.SS6.p3.m13" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> along <math id="A2.SS6.p3.m14" class="ltx_Math" alttext="\partial_{1}F" display="inline" intent=":literal"><semantics><mrow><msub><mo>∂</mo><mn>1</mn></msub><mi>F</mi></mrow><annotation encoding="application/x-tex">\partial_{1}F</annotation></semantics></math> and <math id="A2.SS6.p3.m15" class="ltx_Math" alttext="df(v)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">df(v)&gt;0</annotation></semantics></math> for inwards pointing tangent vectors <math id="A2.SS6.p3.m16" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> along <math id="A2.SS6.p3.m17" class="ltx_Math" alttext="\partial_{0}F" display="inline" intent=":literal"><semantics><mrow><msub><mo>∂</mo><mn>0</mn></msub><mi>F</mi></mrow><annotation encoding="application/x-tex">\partial_{0}F</annotation></semantics></math>.</p>
</div>
<div id="A2.SS6.p4" class="ltx_para">
<p id="A2.SS6.p4.1" class="ltx_p">Finally, yet another variant is the case in which <math id="A2.SS6.p4.m1" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> is a compact manifold with boundary and <math id="A2.SS6.p4.m2" class="ltx_Math" alttext="\partial_{0}F\subset\partial F" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∂</mo><mn>0</mn></msub><mi>F</mi></mrow><mo rspace="0.111em">⊂</mo><mrow><mo>∂</mo><mi>F</mi></mrow></mrow><annotation encoding="application/x-tex">\partial_{0}F\subset\partial F</annotation></semantics></math> is a codimension zero submanifold, identified with some fixed compact manifold with boundary <math id="A2.SS6.p4.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. Such bundles <math id="A2.SS6.p4.m4" class="ltx_Math" alttext="F\to W\to M" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo stretchy="false">→</mo><mi>W</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">F\to W\to M</annotation></semantics></math> come equipped with a trivialization of the sub-bundle <math id="A2.SS6.p4.m5" class="ltx_Math" alttext="\partial_{0}W\subset\partial W" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∂</mo><mn>0</mn></msub><mi>W</mi></mrow><mo rspace="0.111em">⊂</mo><mrow><mo>∂</mo><mi>W</mi></mrow></mrow><annotation encoding="application/x-tex">\partial_{0}W\subset\partial W</annotation></semantics></math>, i.e. a fibered diffeomorphism <math id="A2.SS6.p4.m6" class="ltx_Math" alttext="\partial_{0}W\simeq M\times X" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∂</mo><mn>0</mn></msub><mi>W</mi></mrow><mo>≃</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">\partial_{0}W\simeq M\times X</annotation></semantics></math>. The torsion is computed using functions with moderate singularities <math id="A2.SS6.p4.m7" class="ltx_Math" alttext="f:W\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>W</mi><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:W\to\mathbf{R}</annotation></semantics></math> which have <math id="A2.SS6.p4.m8" class="ltx_Math" alttext="\partial_{0}W" display="inline" intent=":literal"><semantics><mrow><msub><mo>∂</mo><mn>0</mn></msub><mi>W</mi></mrow><annotation encoding="application/x-tex">\partial_{0}W</annotation></semantics></math> as a regular level set of <math id="A2.SS6.p4.m9" class="ltx_Math" alttext="f|_{\partial W}" display="inline" intent=":literal"><semantics><msub><mrow><mi>f</mi><mo stretchy="false">|</mo></mrow><mrow><mo>∂</mo><mi>W</mi></mrow></msub><annotation encoding="application/x-tex">f|_{\partial W}</annotation></semantics></math>, such that inwards pointing vectors <math id="A2.SS6.p4.m10" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> along the interior of <math id="A2.SS6.p4.m11" class="ltx_Math" alttext="\partial_{0}F" display="inline" intent=":literal"><semantics><mrow><msub><mo>∂</mo><mn>0</mn></msub><mi>F</mi></mrow><annotation encoding="application/x-tex">\partial_{0}F</annotation></semantics></math> satisfy <math id="A2.SS6.p4.m12" class="ltx_Math" alttext="df(v)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">df(v)&gt;0</annotation></semantics></math> and such that outwards pointing vectors <math id="A2.SS6.p4.m13" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> along <math id="A2.SS6.p4.m14" class="ltx_Math" alttext="\partial F\setminus\partial_{0}F" display="inline" intent=":literal"><semantics><mrow><mrow><mo>∂</mo><mi>F</mi></mrow><mo rspace="0.055em">∖</mo><mrow><msub><mo>∂</mo><mn>0</mn></msub><mi>F</mi></mrow></mrow><annotation encoding="application/x-tex">\partial F\setminus\partial_{0}F</annotation></semantics></math> satisfy <math id="A2.SS6.p4.m15" class="ltx_Math" alttext="df(v)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">df(v)&gt;0</annotation></semantics></math> (so the fiberwise Morse homology computes <math id="A2.SS6.p4.m16" class="ltx_Math" alttext="H_{*}(F;\partial_{0}F)" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo rspace="0em">,</mo><mrow><msub><mo>∂</mo><mn>0</mn></msub><mi>F</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{*}(F;\partial_{0}F)</annotation></semantics></math> as before).</p>
</div>
<div id="A2.SS6.p5" class="ltx_para">
<p id="A2.SS6.p5.1" class="ltx_p">In any of these cases, we speak of the torsion of the <span id="A2.SS6.p5.1.1" class="ltx_text ltx_font_italic">bundle pair</span> <math id="A2.SS6.p5.m1" class="ltx_Math" alttext="(W,\partial_{0}W)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>W</mi><mo rspace="0em">,</mo><mrow><msub><mo>∂</mo><mn>0</mn></msub><mi>W</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(W,\partial_{0}W)</annotation></semantics></math> and there is a simple formula relating the higher torsion of <math id="A2.SS6.p5.m2" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math>, of <math id="A2.SS6.p5.m3" class="ltx_Math" alttext="\partial_{0}W" display="inline" intent=":literal"><semantics><mrow><msub><mo>∂</mo><mn>0</mn></msub><mi>W</mi></mrow><annotation encoding="application/x-tex">\partial_{0}W</annotation></semantics></math> and of the pair <math id="A2.SS6.p5.m4" class="ltx_Math" alttext="(W,\partial_{0}W)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>W</mi><mo rspace="0em">,</mo><mrow><msub><mo>∂</mo><mn>0</mn></msub><mi>W</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(W,\partial_{0}W)</annotation></semantics></math>. Indeed, from Corollary 3.18 on page 39 in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx35" title="" class="ltx_ref">Igu05</a>]</cite> we have the following result:</p>
</div>
<div id="A2.Thmtheorem4" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem4.1" class="ltx_text ltx_font_bold">Theorem B.4</span></span><span id="A2.Thmtheorem4.2" class="ltx_text ltx_font_bold"> </span>(<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx35" title="" class="ltx_ref">Igu05</a>]</cite>)<span id="A2.Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem4.p1" class="ltx_para">
<p id="A2.Thmtheorem4.p1.1" class="ltx_p"><span id="A2.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">For a bundle pair <math id="A2.Thmtheorem4.p1.m1" class="ltx_Math" alttext="(W,\partial_{0}W)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>W</mi><mo rspace="0em">,</mo><mrow><msub><mo>∂</mo><mn>0</mn></msub><mi>W</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(W,\partial_{0}W)</annotation></semantics></math> we have</span></p>
<table id="A2.Ex60" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex60.m1" class="ltx_Math" alttext="\tau_{k}(W)=\tau_{k}(W,\partial_{0}W)+\tau_{k}(\partial_{0}W)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>τ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>τ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo rspace="0em">,</mo><mrow><msub><mo>∂</mo><mn>0</mn></msub><mi>W</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>τ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mo lspace="0em">∂</mo><mn>0</mn></msub><mi>W</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau_{k}(W)=\tau_{k}(W,\partial_{0}W)+\tau_{k}(\partial_{0}W)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
</section>
<section id="A2.SS7" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.7. </span>Noncompact fibers</h3>

<div id="A2.SS7.p1" class="ltx_para">
<p id="A2.SS7.p1.1" class="ltx_p">The same construction works if the fiber <math id="A2.SS7.p1.m1" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> is noncompact and the bundle <math id="A2.SS7.p1.m2" class="ltx_Math" alttext="W\to M" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">W\to M</annotation></semantics></math> is equipped with a reference fibration at infinity <math id="A2.SS7.p1.m3" class="ltx_Math" alttext="f:W\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>W</mi><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:W\to\mathbf{R}</annotation></semantics></math>. In this case <math id="A2.SS7.p1.m4" class="ltx_Math" alttext="\tau_{k}(W,\rho)" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo>,</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tau_{k}(W,\rho)</annotation></semantics></math> depends on the choice of fibration at infinity, though this may be omitted from the notation if there is no danger of confusion. For example, one could define and compute higher torsion using functions with moderate singularities which are homotopic through fibrations at infinity to our reference fibration at infinity. The fiberwise Morse homology is computing <math id="A2.SS7.p1.m5" class="ltx_Math" alttext="H_{*}(F,\partial_{0}F)" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo rspace="0em">,</mo><mrow><msub><mo>∂</mo><mn>0</mn></msub><mi>F</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{*}(F,\partial_{0}F)</annotation></semantics></math> where <math id="A2.SS7.p1.m6" class="ltx_Math" alttext="\partial_{0}F" display="inline" intent=":literal"><semantics><mrow><msub><mo>∂</mo><mn>0</mn></msub><mi>F</mi></mrow><annotation encoding="application/x-tex">\partial_{0}F</annotation></semantics></math> is a sublevel set <math id="A2.SS7.p1.m7" class="ltx_Math" alttext="f|_{F}&lt;-c" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mi>f</mi><mo stretchy="false">|</mo></mrow><mi>F</mi></msub><mo>&lt;</mo><mrow><mo>−</mo><mi>c</mi></mrow></mrow><annotation encoding="application/x-tex">f|_{F}&lt;-c</annotation></semantics></math> for <math id="A2.SS7.p1.m8" class="ltx_Math" alttext="c&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c&gt;0</annotation></semantics></math> very large, so this version should also be thought of as a relative form of higher torsion.</p>
</div>
<div id="A2.SS7.p2" class="ltx_para">
<p id="A2.SS7.p2.1" class="ltx_p">In certain applications the bundle <math id="A2.SS7.p2.m1" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> is assumed to be trivialized outside of a compact set and it makes sense to demand that the admissible functions <math id="A2.SS7.p2.m2" class="ltx_Math" alttext="f:W\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>W</mi><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:W\to\mathbf{R}</annotation></semantics></math> agree with some fixed fibration at infinity outside of this compact set. With such a restriction imposed, the class <math id="A2.SS7.p2.m3" class="ltx_Math" alttext="\tau_{k}(W,\rho)" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo>,</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tau_{k}(W,\rho)</annotation></semantics></math> does not depend on the choice of admissible function since deformations of admissible functions have compact support.</p>
</div>
<div id="A2.SS7.p3" class="ltx_para">
<p id="A2.SS7.p3.1" class="ltx_p">A very precise formulation of the restriction to compact sets is given in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx36" title="" class="ltx_ref">Igu02</a>, Lemma 3.20]</cite> where singularities of a family of functions are confined to a family of “convex sets” which are basically cobordisms embedded in the fiber. The family of convex sets gives a family of chain complexes which embeds in the chain complex of the entire fiber in the case when the fiber is compact. In general, we can define the family of total chain complexes to be that given by any family of convex sets which contains all the critical points of the function. By <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx36" title="" class="ltx_ref">Igu02</a>, Lemma 3.20]</cite>, these all give the same chain complex. So, the family of chain complexes and thus the higher torsion is well-defined. The fiber also has a well-defined Euler characteristic <math id="A2.SS7.p3.m1" class="ltx_Math" alttext="\chi(F)" display="inline" intent=":literal"><semantics><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\chi(F)</annotation></semantics></math> given by this finite chain complex. In the case of functions of tube type we have <math id="A2.SS7.p3.m2" class="ltx_Math" alttext="\chi(F)=\pm 1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>±</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\chi(F)=\pm 1</annotation></semantics></math>.</p>
</div>
<div id="A2.SS7.p4" class="ltx_para">
<p id="A2.SS7.p4.1" class="ltx_p">In any event, higher Reidemeister torsion is a <span id="A2.SS7.p4.1.1" class="ltx_text ltx_font_italic">stable invariant</span>, which means that if <math id="A2.SS7.p4.m1" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> is replaced by the fiberwise stabilization <math id="A2.SS7.p4.m2" class="ltx_Math" alttext="W\times\mathbf{R}^{4}" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐑</mi><mn>4</mn></msup></mrow><annotation encoding="application/x-tex">W\times\mathbf{R}^{4}</annotation></semantics></math> and the function with mild singularities <math id="A2.SS7.p4.m3" class="ltx_Math" alttext="f:W\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>W</mi><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:W\to\mathbf{R}</annotation></semantics></math> is replaced with <math id="A2.SS7.p4.m4" class="ltx_Math" alttext="f(w)+||x||^{2}-||y||^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msup><mrow><mo stretchy="false">‖</mo><mi>x</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>−</mo><msup><mrow><mo stretchy="false">‖</mo><mi>y</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">f(w)+||x||^{2}-||y||^{2}</annotation></semantics></math> for <math id="A2.SS7.p4.m5" class="ltx_Math" alttext="(w,x,y)\in W\times\mathbf{R}^{2}\times\mathbf{R}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi>W</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐑</mi><mn>2</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐑</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">(w,x,y)\in W\times\mathbf{R}^{2}\times\mathbf{R}^{2}</annotation></semantics></math>, then the homotopy class of the map <math id="A2.SS7.p4.m6" class="ltx_Math" alttext="M\to|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo stretchy="false">→</mo><mrow><mo stretchy="false">|</mo><mrow><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">M\to|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|</annotation></semantics></math> and sign of the fiber Euler characteristic <math id="A2.SS7.p4.m7" class="ltx_Math" alttext="\chi(F)" display="inline" intent=":literal"><semantics><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\chi(F)</annotation></semantics></math> will remain unchanged.</p>
</div>
<div id="A2.SS7.p5" class="ltx_para">
<p id="A2.SS7.p5.1" class="ltx_p">Furthermore, by the framing principle, if <math id="A2.SS7.p5.m1" class="ltx_Math" alttext="f:W\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>W</mi><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:W\to\mathbf{R}</annotation></semantics></math> is replaced by <math id="A2.SS7.p5.m2" class="ltx_Math" alttext="f\oplus q:W\times\mathbf{R}^{N}\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⊕</mo><mi>q</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>W</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐑</mi><mi>N</mi></msup></mrow><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f\oplus q:W\times\mathbf{R}^{N}\to\mathbf{R}</annotation></semantics></math>, where <math id="A2.SS7.p5.m3" class="ltx_Math" alttext="f\oplus q(w,v)=f(w)+q_{\pi(w)}(v)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>⊕</mo><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>q</mi><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">f\oplus q(w,v)=f(w)+q_{\pi(w)}(v)</annotation></semantics></math> for <math id="A2.SS7.p5.m4" class="ltx_Math" alttext="q_{m}:\mathbf{R}^{N}\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>m</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>𝐑</mi><mi>N</mi></msup><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">q_{m}:\mathbf{R}^{N}\to\mathbf{R}</annotation></semantics></math> a family of non-degenerate quadratic forms on <math id="A2.SS7.p5.m5" class="ltx_Math" alttext="\mathbf{R}^{N}" display="inline" intent=":literal"><semantics><msup><mi>𝐑</mi><mi>N</mi></msup><annotation encoding="application/x-tex">\mathbf{R}^{N}</annotation></semantics></math> of even index parametrized by <math id="A2.SS7.p5.m6" class="ltx_Math" alttext="m\in M" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">m\in M</annotation></semantics></math>, then the homotopy class of the map <math id="A2.SS7.p5.m7" class="ltx_Math" alttext="M\to|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo stretchy="false">→</mo><mrow><mo stretchy="false">|</mo><mrow><msubsup><mtext class="ltx_mathvariant_italic">Wh</mtext><mo>∙</mo><mi>h</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">M\to|\text{Wh}_{\bullet}^{h}(\mathbf{C},1)|</annotation></semantics></math> changes but in a controlled way: the pullback of the universal class <math id="A2.SS7.p5.m8" class="ltx_Math" alttext="\tau_{k}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\tau_{k}</annotation></semantics></math> changes precisely by adding <math id="A2.SS7.p5.m9" class="ltx_Math" alttext="\chi(F)" display="inline" intent=":literal"><semantics><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\chi(F)</annotation></semantics></math> times a (certain multiple) of the Pontraygin character of the stable bundle of the family <math id="A2.SS7.p5.m10" class="ltx_Math" alttext="q_{m}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mi>m</mi></msub><annotation encoding="application/x-tex">q_{m}</annotation></semantics></math>, <math id="A2.SS7.p5.m11" class="ltx_Math" alttext="m\in M" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">m\in M</annotation></semantics></math>, i.e. the stable vector bundle formed by the negative eigenspaces of <math id="A2.SS7.p5.m12" class="ltx_Math" alttext="q_{m}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mi>m</mi></msub><annotation encoding="application/x-tex">q_{m}</annotation></semantics></math>. The <math id="A2.SS7.p5.m13" class="ltx_Math" alttext="\chi(F)" display="inline" intent=":literal"><semantics><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\chi(F)</annotation></semantics></math> factor comes from the fact that the composition of <math id="A2.SS7.p5.m14" class="ltx_Math" alttext="p^{\ast}:H^{\ast}(M)\to H^{\ast}(W)" display="inline" intent=":literal"><semantics><mrow><msup><mi>p</mi><mo>∗</mo></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">p^{\ast}:H^{\ast}(M)\to H^{\ast}(W)</annotation></semantics></math> with the Becker-Gottlieb transfer <math id="A2.SS7.p5.m15" class="ltx_Math" alttext="tr_{M}^{W}:H^{\ast}(W)\to H^{\ast}(M)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>M</mi><mi>W</mi></msubsup></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">tr_{M}^{W}:H^{\ast}(W)\to H^{\ast}(M)</annotation></semantics></math> is multiplication by <math id="A2.SS7.p5.m16" class="ltx_Math" alttext="\chi(F)" display="inline" intent=":literal"><semantics><mrow><mi>χ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\chi(F)</annotation></semantics></math>.</p>
</div>
</section>
</section>
