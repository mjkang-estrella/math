class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\mathcal{H}_{\infty}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\mathcal{H}_{\infty}}</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 63.39)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 6.38 0) translate(23.94,0) matrix(1.0 0.0 0.0 1.0 -17.98 0)"><foreignObject style="--ltx-fo-width:1.6em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="22.13"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex28.m1.pic1.m3" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces BO}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces BO}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 60.83 0) translate(56.94,0) matrix(1.0 0.0 0.0 1.0 -17.78 0)"><foreignObject style="--ltx-fo-width:1.57em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="21.72"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex28.m1.pic1.m4" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\mathcal{T}_{\infty}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\mathcal{T}_{\infty}}</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 109.96)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 6.41 0) translate(23.91,0) matrix(1.0 0.0 0.0 1.0 -17.95 0)"><foreignObject style="--ltx-fo-width:1.59em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="22.07"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex28.m1.pic1.m5" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces BG}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces BG}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 60.66 0) translate(57.12,0) matrix(1.0 0.0 0.0 1.0 -17.95 0)"><foreignObject style="--ltx-fo-width:1.59em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="22.07"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex28.m1.pic1.m6" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces BG}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces BG}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -9.93 45.53 L 22.17 45.53"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 22.44 45.53)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -40.53 33.27 L -40.53 9.47"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 -40.53 9.19)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 46.92 34.65 L 46.92 9.47"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 46.92 9.19)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -16.31 -2.42 L 22.36 -2.42"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 22.64 -2.42)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -40.53 -11.22 L -40.53 -37.1"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 -40.53 -37.37)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 46.92 -13.3 L 46.92 -37.1"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 46.92 -37.37)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -16.34 -48.99 L 22.18 -48.99"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 22.46 -48.99)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -1.05 -45.73)"><foreignObject style="--ltx-fo-width:0.61em;--ltx-fo-height:0.27em;--ltx-fo-depth:0em;font-size:10pt;" height="3.72" overflow="visible" transform="matrix(1 0 0 -1 0 3.72)" width="8.49"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex28.m1.pic1.m7" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces=}" display="inline" intent=":literal"><semantics><mo mathsize="0.700em">=</mo><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces=}</annotation></semantics></math></span></span></foreignObject></g></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmtheorem34.p1.2" class="ltx_p">The vertical column is the <math id="S3.Thmtheorem34.p1.m3" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math>-map fibration <math id="S3.Thmtheorem34.p1.m4" class="ltx_Math" alttext="G/O\to BO\to BG" display="inline" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo>/</mo><mi>O</mi></mrow><mo stretchy="false">→</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow><mo stretchy="false">→</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow></mrow><annotation encoding="application/x-tex">G/O\to BO\to BG</annotation></semantics></math> and the top row is the <span id="S3.Thmtheorem34.p1.2.1" class="ltx_text ltx_font_italic">Hatcher-Waldhausen map</span> <math id="S3.Thmtheorem34.p1.m5" class="ltx_Math" alttext="G/O\to\mathcal{H}_{\infty}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo>/</mo><mi>O</mi></mrow><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">G/O\to\mathcal{H}_{\infty}</annotation></semantics></math>, which is a rational equivalence by that same theorem of Bökstedt <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx15" title="" class="ltx_ref">B82</a>]</cite>. For <math id="S3.Thmtheorem34.p1.m6" class="ltx_Math" alttext="n=4k" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mrow><annotation encoding="application/x-tex">n=4k</annotation></semantics></math>, modulo the torsion subgroups, we have a monomorphism of free abelian groups</p>
<table id="S3.Ex29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex29.m1" class="ltx_Math" alttext="(\pi_{4k}G/O)/\text{Tors}\xrightarrow{\sim}(\pi_{4k}\mathcal{H}_{\infty})/\text{Tors}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>π</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mo>/</mo><mi>O</mi></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mtext>Tors</mtext></mrow><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>π</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi mathvariant="normal">∞</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mtext>Tors</mtext></mrow></mrow><annotation encoding="application/x-tex">(\pi_{4k}G/O)/\text{Tors}\xrightarrow{\sim}(\pi_{4k}\mathcal{H}_{\infty})/\text{Tors}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmtheorem34.p1.3" class="ltx_p">i.e. up to <math id="S3.Thmtheorem34.p1.m7" class="ltx_Math" alttext="\pm 1" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\pm 1</annotation></semantics></math> a monomorphism <math id="S3.Thmtheorem34.p1.m8" class="ltx_Math" alttext="\mathbf{Z}\to\mathbf{Z}" display="inline" intent=":literal"><semantics><mrow><mi>𝐙</mi><mo stretchy="false">→</mo><mi>𝐙</mi></mrow><annotation encoding="application/x-tex">\mathbf{Z}\to\mathbf{Z}</annotation></semantics></math>. Let <math id="S3.Thmtheorem34.p1.m9" class="ltx_Math" alttext="I_{k}\in\mathbf{Z}_{&gt;0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><mi>k</mi></msub><mo>∈</mo><msub><mi>𝐙</mi><mrow><mphantom></mphantom><mo>&gt;</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">I_{k}\in\mathbf{Z}_{&gt;0}</annotation></semantics></math> be the index of the image. The integers <math id="S3.Thmtheorem34.p1.m10" class="ltx_Math" alttext="I_{k}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>k</mi></msub><annotation encoding="application/x-tex">I_{k}</annotation></semantics></math> and <math id="S3.Thmtheorem34.p1.m11" class="ltx_Math" alttext="J_{k}" display="inline" intent=":literal"><semantics><msub><mi>J</mi><mi>k</mi></msub><annotation encoding="application/x-tex">J_{k}</annotation></semantics></math> are thus closely related by the J-homomorphism. From private communication from S. Kupers we understand that in principle a careful comparison of the literature, including a careful comparison of conventions for regulators and for higher torsion classes, could lead to concrete information on the integers <math id="S3.Thmtheorem34.p1.m12" class="ltx_Math" alttext="I_{k}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>k</mi></msub><annotation encoding="application/x-tex">I_{k}</annotation></semantics></math> and <math id="S3.Thmtheorem34.p1.m13" class="ltx_Math" alttext="J_{k}" display="inline" intent=":literal"><semantics><msub><mi>J</mi><mi>k</mi></msub><annotation encoding="application/x-tex">J_{k}</annotation></semantics></math>.</p>
</div>
<div id="S3.Thmtheorem34.p2" class="ltx_para">
<p id="S3.Thmtheorem34.p2.1" class="ltx_p">The integer <math id="S3.Thmtheorem34.p2.m1" class="ltx_Math" alttext="I_{k}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>k</mi></msub><annotation encoding="application/x-tex">I_{k}</annotation></semantics></math> is also closely related to the mysterious finite homotopy group <math id="S3.Thmtheorem34.p2.m2" class="ltx_Math" alttext="\pi_{4k}\mathcal{M}_{\infty}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\pi_{4k}\mathcal{M}_{\infty}</annotation></semantics></math> of the space <math id="S3.Thmtheorem34.p2.m3" class="ltx_Math" alttext="\mathcal{M}_{\infty}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\mathcal{M}_{\infty}</annotation></semantics></math> considered by Kragh in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx46" title="" class="ltx_ref">Kra18</a>]</cite>, who proved that the Hatcher map extends to a fibration sequence <math id="S3.Thmtheorem34.p2.m4" class="ltx_Math" alttext="\mathcal{M}_{\infty}\to G/O\to\mathcal{H}_{\infty}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi mathvariant="normal">∞</mi></msub><mo stretchy="false">→</mo><mrow><mi>G</mi><mo>/</mo><mi>O</mi></mrow><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\mathcal{M}_{\infty}\to G/O\to\mathcal{H}_{\infty}</annotation></semantics></math> where <math id="S3.Thmtheorem34.p2.m5" class="ltx_Math" alttext="\mathcal{M}_{\infty}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\mathcal{M}_{\infty}</annotation></semantics></math> is roughly speaking the stable space of functions <math id="S3.Thmtheorem34.p2.m6" class="ltx_Math" alttext="\mathbf{R}^{2N}\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐑</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></msup><mo stretchy="false">→</mo><mi>𝐑</mi></mrow><annotation encoding="application/x-tex">\mathbf{R}^{2N}\to\mathbf{R}</annotation></semantics></math> equal to the standard quadratic form <math id="S3.Thmtheorem34.p2.m7" class="ltx_Math" alttext="\|x\|^{2}-\|y\|^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>x</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>−</mo><msup><mrow><mo stretchy="false">‖</mo><mi>y</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\|x\|^{2}-\|y\|^{2}</annotation></semantics></math> at infinity and which have a unique and non-degenerate critical point. The space <math id="S3.Thmtheorem34.p2.m8" class="ltx_Math" alttext="\mathcal{M}_{\infty}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\mathcal{M}_{\infty}</annotation></semantics></math> is related to generating functions for <span id="S3.Thmtheorem34.p2.1.1" class="ltx_text ltx_font_italic">Long nearby Lagrangian knots</span> in <math id="S3.Thmtheorem34.p2.m9" class="ltx_Math" alttext="T^{*}\mathbf{R}^{k}" display="inline" intent=":literal"><semantics><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐑</mi><mi>k</mi></msup></mrow><annotation encoding="application/x-tex">T^{*}\mathbf{R}^{k}</annotation></semantics></math>. Indeed, in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx46" title="" class="ltx_ref">Kra18</a>]</cite> it is shown that if <math id="S3.Thmtheorem34.p2.m10" class="ltx_Math" alttext="L\subset T^{*}\mathbf{R}^{k}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐑</mi><mi>k</mi></msup></mrow></mrow><annotation encoding="application/x-tex">L\subset T^{*}\mathbf{R}^{k}</annotation></semantics></math> is an exact Lagrangian submanifold agreeing with the zero section <math id="S3.Thmtheorem34.p2.m11" class="ltx_Math" alttext="\mathbf{R}^{k}\subset T^{*}\mathbf{R}^{k}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐑</mi><mi>k</mi></msup><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐑</mi><mi>k</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{R}^{k}\subset T^{*}\mathbf{R}^{k}</annotation></semantics></math> outside of a compact set, then <math id="S3.Thmtheorem34.p2.m12" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> admits a generating function <math id="S3.Thmtheorem34.p2.m13" class="ltx_Math" alttext="f:\mathbf{R}^{k}\times\mathbf{R}^{2N}\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>𝐑</mi><mi>k</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐑</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></msup></mrow><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:\mathbf{R}^{k}\times\mathbf{R}^{2N}\to\mathbf{R}</annotation></semantics></math> which is <span id="S3.Thmtheorem34.p2.1.2" class="ltx_text ltx_font_italic">standard-quadratic</span> at infinity and hence by restricting to a large sphere in <math id="S3.Thmtheorem34.p2.m14" class="ltx_Math" alttext="\mathbf{R}^{k}" display="inline" intent=":literal"><semantics><msup><mi>𝐑</mi><mi>k</mi></msup><annotation encoding="application/x-tex">\mathbf{R}^{k}</annotation></semantics></math> one obtains an element of <math id="S3.Thmtheorem34.p2.m15" class="ltx_Math" alttext="\pi_{k-1}\mathcal{M}_{\infty}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\pi_{k-1}\mathcal{M}_{\infty}</annotation></semantics></math> which is closely related to the torsion invariants considered in the present article. The Hatcher-Waldhausen map <math id="S3.Thmtheorem34.p2.m16" class="ltx_Math" alttext="G/O\to\mathcal{H}_{\infty}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo>/</mo><mi>O</mi></mrow><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">G/O\to\mathcal{H}_{\infty}</annotation></semantics></math> was shown to be an infinite loop map by Rognes in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx56" title="" class="ltx_ref">R92</a>]</cite>.</p>
</div>
</div>
</section>
<section id="S3.SS7" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.7. </span>Legendrians with nontrivial tube torsion</h3>

<div id="S3.SS7.p1" class="ltx_para">
<p id="S3.SS7.p1.1" class="ltx_p">We are now ready to establish for general <math id="S3.SS7.p1.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> the existence of Legendrians <math id="S3.SS7.p1.m2" class="ltx_Math" alttext="\Lambda\subset J^{1}M" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo>⊂</mo><mrow><msup><mi>J</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">\Lambda\subset J^{1}M</annotation></semantics></math> such that the projection <math id="S3.SS7.p1.m3" class="ltx_Math" alttext="\Lambda\to M" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\Lambda\to M</annotation></semantics></math> is homotopic to a diffeomorphism and which have nontrivial tube torsion. In particular this shows that the vanishing of the tube torsion of nearby Lagrangians <math id="S3.SS7.p1.m4" class="ltx_Math" alttext="L\subset T^{*}M" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">L\subset T^{*}M</annotation></semantics></math> predicted by the nearby Lagrangian conjecture cannot rely solely on the fact that the projection <math id="S3.SS7.p1.m5" class="ltx_Math" alttext="L\to M" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">L\to M</annotation></semantics></math> is a homotopy equivalence (or even from a conjectural expectation that the projection <math id="S3.SS7.p1.m6" class="ltx_Math" alttext="L\to M" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">L\to M</annotation></semantics></math> is homotopic to a diffeomorphism, which is not known).</p>
</div>
<div id="S3.SS7.p2" class="ltx_para">
<p id="S3.SS7.p2.1" class="ltx_p">Recall that given a bundle of h-cobordisms of a disk <math id="S3.SS7.p2.m1" class="ltx_Math" alttext="V\to M" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">V\to M</annotation></semantics></math>, the stable equivalence class of the bundle is classified by the homotopy class of a map <math id="S3.SS7.p2.m2" class="ltx_Math" alttext="M\to\mathcal{H}_{\infty}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">M\to\mathcal{H}_{\infty}</annotation></semantics></math>, see Section <a href="#S3.SS6" title="3.6. The space of tubes ‣ 3. Legendrian tube torsion ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.6</span></a>. By the fibration sequence <math id="S3.SS7.p2.m3" class="ltx_Math" alttext="\mathcal{H}_{\infty}\to\mathcal{T}_{\infty}\to BG" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi mathvariant="normal">∞</mi></msub><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi mathvariant="normal">∞</mi></msub><mo stretchy="false">→</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow></mrow><annotation encoding="application/x-tex">\mathcal{H}_{\infty}\to\mathcal{T}_{\infty}\to BG</annotation></semantics></math> of Waldhausen <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx65" title="" class="ltx_ref">Wal82</a>]</cite> there is an associated tube bundle <math id="S3.SS7.p2.m4" class="ltx_Math" alttext="W\to M" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">W\to M</annotation></semantics></math> which geometrically is obtained by attaching <math id="S3.SS7.p2.m5" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> onto a trivial bundle of tubes <math id="S3.SS7.p2.m6" class="ltx_Math" alttext="M\times T\to M" display="inline" intent=":literal"><semantics><mrow><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>T</mi></mrow><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">M\times T\to M</annotation></semantics></math>.</p>
</div>
<div id="S3.SS7.p3" class="ltx_para">
<p id="S3.SS7.p3.1" class="ltx_p">We recall that Theorem <a href="#S1.Thmtheorem15" title="Theorem 1.15. ‣ 1.1. Main results ‣ 1. Introduction ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.15</span></a> states that given a bundle of h-cobordisms of a disk <math id="S3.SS7.p3.m1" class="ltx_Math" alttext="V\to M" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">V\to M</annotation></semantics></math>, there exists a Legendrian <math id="S3.SS7.p3.m2" class="ltx_Math" alttext="\Lambda\subset J^{1}M" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo>⊂</mo><mrow><msup><mi>J</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">\Lambda\subset J^{1}M</annotation></semantics></math> whose projection <math id="S3.SS7.p3.m3" class="ltx_Math" alttext="\Lambda\to M" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\Lambda\to M</annotation></semantics></math> is homotopic to a diffeomorphism and which admits a generating function on the tube bundle <math id="S3.SS7.p3.m4" class="ltx_Math" alttext="W\to M" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">W\to M</annotation></semantics></math> obtained from <math id="S3.SS7.p3.m5" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> via the map <math id="S3.SS7.p3.m6" class="ltx_Math" alttext="\mathcal{H}_{\infty}\to\mathcal{T}_{\infty}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi mathvariant="normal">∞</mi></msub><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\mathcal{H}_{\infty}\to\mathcal{T}_{\infty}</annotation></semantics></math>.</p>
</div>
<div id="S3.SS7.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Theorem <a href="#S1.Thmtheorem15" title="Theorem 1.15. ‣ 1.1. Main results ‣ 1. Introduction ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.15</span></a>.</h6>
<div id="S3.SS7.p4" class="ltx_para">
<p id="S3.SS7.p4.1" class="ltx_p"><span id="S3.SS7.p4.1.1" class="ltx_text">We may apply Theorem <a href="#A1.Thmtheorem2" title="Theorem A.2 ([], Theorem 2.3). ‣ A.4. Wrinkling ‣ Appendix A Moderate singularities ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.2</span></a> to the bundle of <math id="S3.SS7.p4.m1" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math>-cobordisms <math id="S3.SS7.p4.m2" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math>, where we take <math id="S3.SS7.p4.m3" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> to consist of <math id="S3.SS7.p4.m4" class="ltx_Math" alttext="\partial V" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">\partial V</annotation></semantics></math> and <math id="S3.SS7.p4.m5" class="ltx_Math" alttext="g:Op(A)\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">g:Op(A)\to\mathbf{R}</annotation></semantics></math> to be a function on <math id="S3.SS7.p4.m6" class="ltx_Math" alttext="Op(A)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Op(A)</annotation></semantics></math> without critical points for which the two components of <math id="S3.SS7.p4.m7" class="ltx_Math" alttext="\partial V" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">\partial V</annotation></semantics></math> (corresponding to the boundary components <math id="S3.SS7.p4.m8" class="ltx_Math" alttext="D^{k}\times\{0\}" display="inline" intent=":literal"><semantics><mrow><msup><mi>D</mi><mi>k</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">D^{k}\times\{0\}</annotation></semantics></math> and <math id="S3.SS7.p4.m9" class="ltx_Math" alttext="D^{k}\times\{1\}" display="inline" intent=":literal"><semantics><mrow><msup><mi>D</mi><mi>k</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">D^{k}\times\{1\}</annotation></semantics></math> of the fiber <math id="S3.SS7.p4.m10" class="ltx_Math" alttext="D^{k}\times[0,1]" display="inline" intent=":literal"><semantics><mrow><msup><mi>D</mi><mi>k</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">D^{k}\times[0,1]</annotation></semantics></math>) are regular level sets of <math id="S3.SS7.p4.m11" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math>. To verify the hypothesis of Theorem <a href="#A1.Thmtheorem2" title="Theorem A.2 ([], Theorem 2.3). ‣ A.4. Wrinkling ‣ Appendix A Moderate singularities ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.2</span></a> that <math id="S3.SS7.p4.m12" class="ltx_Math" alttext="d_{v}g" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><annotation encoding="application/x-tex">d_{v}g</annotation></semantics></math> extends to a non-vanishing section of <math id="S3.SS7.p4.m13" class="ltx_Math" alttext="\text{Vert}^{*}" display="inline" intent=":literal"><semantics><msup><mtext>Vert</mtext><mo>∗</mo></msup><annotation encoding="application/x-tex">\text{Vert}^{*}</annotation></semantics></math> we may argue as in Proposition 2.5 in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx22" title="" class="ltx_ref">EM00</a>]</cite>, though note the attribution there to earlier work of Douady and Laudenbach, as well as to the second author’s PhD thesis.</span></p>
</div>
<div id="S3.SS7.p5" class="ltx_para">
<p id="S3.SS7.p5.1" class="ltx_p"><span id="S3.SS7.p5.1.1" class="ltx_text">After applying Theorem <a href="#A1.Thmtheorem2" title="Theorem A.2 ([], Theorem 2.3). ‣ A.4. Wrinkling ‣ Appendix A Moderate singularities ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.2</span></a> we conclude that there exists a fibered wrinkled function <math id="S3.SS7.p5.m1" class="ltx_Math" alttext="h:V\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>V</mi><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">h:V\to\mathbf{R}</annotation></semantics></math> such that the lower boundary <math id="S3.SS7.p5.m2" class="ltx_Math" alttext="\partial_{0}V" display="inline" intent=":literal"><semantics><mrow><msub><mo>∂</mo><mn>0</mn></msub><mi>V</mi></mrow><annotation encoding="application/x-tex">\partial_{0}V</annotation></semantics></math> is a regular level set for <math id="S3.SS7.p5.m3" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math>. Hence <math id="S3.SS7.p5.m4" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> can be stitched up with a standard function on the trivial tube bundle <math id="S3.SS7.p5.m5" class="ltx_Math" alttext="q:M\times T\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>T</mi></mrow><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">q:M\times T\to\mathbf{R}</annotation></semantics></math> to obtain a function with moderate singularities <math id="S3.SS7.p5.m6" class="ltx_Math" alttext="h\#q:W\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>W</mi><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">h\#q:W\to\mathbf{R}</annotation></semantics></math> whose fiberwise critical set <math id="S3.SS7.p5.m7" class="ltx_Math" alttext="\Sigma_{f}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>f</mi></msub><annotation encoding="application/x-tex">\Sigma_{f}</annotation></semantics></math> is the disjoint union of <math id="S3.SS7.p5.m8" class="ltx_Math" alttext="\Sigma_{h}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>h</mi></msub><annotation encoding="application/x-tex">\Sigma_{h}</annotation></semantics></math> and <math id="S3.SS7.p5.m9" class="ltx_Math" alttext="\Sigma_{q}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>q</mi></msub><annotation encoding="application/x-tex">\Sigma_{q}</annotation></semantics></math>, where <math id="S3.SS7.p5.m10" class="ltx_Math" alttext="\Sigma_{q}\to M" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mi>q</mi></msub><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\Sigma_{q}\to M</annotation></semantics></math> is a diffeomorphism. Hence <math id="S3.SS7.p5.m11" class="ltx_Math" alttext="h\#q" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">h\#q</annotation></semantics></math> generates a Legendrian <math id="S3.SS7.p5.m12" class="ltx_Math" alttext="\Lambda\subset J^{1}M" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo>⊂</mo><mrow><msup><mi>J</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">\Lambda\subset J^{1}M</annotation></semantics></math> which is the disjoint union of finitely many Legendrian spheres <math id="S3.SS7.p5.m13" class="ltx_Math" alttext="S_{i}\subset J^{1}M" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>⊂</mo><mrow><msup><mi>J</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">S_{i}\subset J^{1}M</annotation></semantics></math>, each diffeomorphic to the standard sphere and whose projection <math id="S3.SS7.p5.m14" class="ltx_Math" alttext="S_{i}\to M" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>i</mi></msub><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">S_{i}\to M</annotation></semantics></math> is nullhomotopic, and the zero section <math id="S3.SS7.p5.m15" class="ltx_Math" alttext="M\subset J^{1}M" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>⊂</mo><mrow><msup><mi>J</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">M\subset J^{1}M</annotation></semantics></math>, see Figure <a href="#S3.F6" title="Figure 6 ‣ 3.7. Legendrians with nontrivial tube torsion ‣ 3. Legendrian tube torsion ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>. Note that each <math id="S3.SS7.p5.m16" class="ltx_Math" alttext="S_{i}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>i</mi></msub><annotation encoding="application/x-tex">S_{i}</annotation></semantics></math> may sit as a complicated Legendrian knot in <math id="S3.SS7.p5.m17" class="ltx_Math" alttext="J^{1}M" display="inline" intent=":literal"><semantics><mrow><msup><mi>J</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">J^{1}M</annotation></semantics></math>, and the union of the <math id="S3.SS7.p5.m18" class="ltx_Math" alttext="S_{i}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>i</mi></msub><annotation encoding="application/x-tex">S_{i}</annotation></semantics></math> as a complicated Legendrian link, but each front <math id="S3.SS7.p5.m19" class="ltx_Math" alttext="S_{i}\to J^{1}M" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>i</mi></msub><mo stretchy="false">→</mo><mrow><msup><mi>J</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">S_{i}\to J^{1}M</annotation></semantics></math> has only cusp singularities (along an equator <math id="S3.SS7.p5.m20" class="ltx_Math" alttext="C_{i}\subset S_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>i</mi></msub><mo>⊂</mo><msub><mi>S</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">C_{i}\subset S_{i}</annotation></semantics></math>).</span></p>
</div>
<div id="S3.SS7.p6" class="ltx_para">
<p id="S3.SS7.p6.1" class="ltx_p"><span id="S3.SS7.p6.1.1" class="ltx_text">Next, we note using Proposition 3.21 of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">ACGK</a>]</cite> one may construct a fibered function of tube type <math id="S3.SS7.p6.m1" class="ltx_Math" alttext="f:M\times\mathbf{R}^{N}\to\mathbf{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝐑</mi><mi>N</mi></msup></mrow><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">f:M\times\mathbf{R}^{N}\to\mathbf{R}</annotation></semantics></math> such that <math id="S3.SS7.p6.m2" class="ltx_Math" alttext="W=T(f)" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>=</mo><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">W=T(f)</annotation></semantics></math> and which generates the same Legendrian <math id="S3.SS7.p6.m3" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> (the statement of Proposition 3.21 only states it up to Legendrian isotopy but one may appeal to the homotopy lifting property after further stabilization if necessary). After a further Legendrian isotopy of <math id="S3.SS7.p6.m4" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>, (which againis covered by a homotopy of functions <math id="S3.SS7.p6.m5" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> having the same properties after stabilization if necessary), we may arrange it so the Legendrian <math id="S3.SS7.p6.m6" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> has cusps of any Maslov index (spin a Reidemeister I move and use this to make pagodas of increasing and decreasing Maslov index at any given point of the graphical component of <math id="S3.SS7.p6.m7" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>, see Figure <a href="#S3.F7" title="Figure 7 ‣ 3.7. Legendrians with nontrivial tube torsion ‣ 3. Legendrian tube torsion ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>). We can then use a surgery of corank 1 singularities to surger the spheres <math id="S3.SS7.p6.m8" class="ltx_Math" alttext="S_{i}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>i</mi></msub><annotation encoding="application/x-tex">S_{i}</annotation></semantics></math> into the Legendrian <math id="S3.SS7.p6.m9" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> via connect sum, again covering the deformation by a homotopy of functions <math id="S3.SS7.p6.m10" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> having the same properties, except now the components <math id="S3.SS7.p6.m11" class="ltx_Math" alttext="S_{i}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>i</mi></msub><annotation encoding="application/x-tex">S_{i}</annotation></semantics></math> have been absorbed into the graphical component of the Legendrian, see Figure <a href="#S3.F8" title="Figure 8 ‣ 3.7. Legendrians with nontrivial tube torsion ‣ 3. Legendrian tube torsion ‣ Legendrian and Lagrangian higher torsion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>. Thus the diffeomorphism type of <math id="S3.SS7.p6.m12" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> is equal to the connect sum of <math id="S3.SS7.p6.m13" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> with finitely many standard spheres, so the final Legendrian <math id="S3.SS7.p6.m14" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> is diffeomorphic to <math id="S3.SS7.p6.m15" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> and moreover the projection <math id="S3.SS7.p6.m16" class="ltx_Math" alttext="M\to\Lambda" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo stretchy="false">→</mo><mi mathvariant="normal">Λ</mi></mrow><annotation encoding="application/x-tex">M\to\Lambda</annotation></semantics></math> is homotopic to a diffeomorphism. ∎</span></p>
</div>
</div>
<figure id="S3.F6" class="ltx_figure"><span class="ltx_inline-block"><svg id="S3.F6.pic1" class="ltx_picture ltx_centering" height="87.06" overflow="visible" version="1.1" viewBox="0 0 300.58 87.06" width="300.58"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,87.06) matrix(1 0 0 -1 0 0) translate(138.35,0) translate(0,-128.46)"><g stroke-width="0.8pt"><path style="fill:none" d="M -137.79 137.79 L 137.79 137.79"></path></g><g stroke-width="0.4pt"><path style="fill:none" d="M 137.79 137.79"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 142.68 133.07)"><foreignObject style="--ltx-fo-width:1.08em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="14.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F6.pic1.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M -63.39 192.91 C -46.85 192.91 -35.83 214.96 -22.05 214.96 C -8.27 212.2 5.51 195.67 19.29 195.67"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -63.39 192.91 C -49.61 192.91 -38.58 177.76 -19.29 176.38 C -2.76 176.38 8.27 195.67 19.29 195.67"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -35.83 187.4 C -19.29 187.4 -8.27 209.45 5.51 209.45 C 19.29 206.69 33.07 190.16 46.85 190.16"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -35.83 187.4 C -22.05 187.4 -11.02 172.24 8.27 170.87 C 24.8 170.87 35.83 190.16 46.85 190.16"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M -5.51 165.35 C 5.51 165.35 19.29 187.4 35.83 187.4 C 49.61 184.64 63.39 168.11 77.17 168.11"><