er"><span class="ltx_foreignobject_content"><math id="S3.Ex27.m1.pic1.m2" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces BG}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces BG}</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 62.01)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 0 0) translate(34.24,0) matrix(1.0 0.0 0.0 1.0 -28.28 0)"><foreignObject style="--ltx-fo-width:3.09em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="42.72"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex27.m1.pic1.m3" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\Omega^{\infty}S^{\infty}}" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Ω</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>S</mi><mi mathvariant="normal">∞</mi></msup></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\Omega^{\infty}S^{\infty}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 68.47 0) translate(60.11,0) matrix(1.0 0.0 0.0 1.0 -20.95 0)"><foreignObject style="--ltx-fo-width:2.03em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="28.06"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex27.m1.pic1.m4" class="ltx_Math" alttext="