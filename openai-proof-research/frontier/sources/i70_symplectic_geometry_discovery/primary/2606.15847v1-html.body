<p id="S6.I6.i4.p1.1" class="ltx_p"><span id="S6.I6.i4.p1.1.1" class="ltx_text ltx_font_bold">(Associativity H3)</span> For <math id="S6.I6.i4.p1.m1" class="ltx_Math" alttext="p_{i}\leq r_{i}\leq q_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>i</mi></msub><mo>≤</mo><msub><mi>r</mi><mi>i</mi></msub><mo>≤</mo><msub><mi>q</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">p_{i}\leq r_{i}\leq q_{i}</annotation></semantics></math> in <math id="S6.I6.i4.p1.m2" class="ltx_Math" alttext="{\mathbb{F}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝔽</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\mathbb{F}}_{i}</annotation></semantics></math> and <math id="S6.I6.i4.p1.m3" class="ltx_Math" alttext="q^{\prime}\leq r^{\prime}\leq p^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mo>′</mo></msup><mo>≤</mo><msup><mi>r</mi><mo>′</mo></msup><mo>≤</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">q^{\prime}\leq r^{\prime}\leq p^{\prime}</annotation></semantics></math> in <math id="S6.I6.i4.p1.m4" class="ltx_Math" alttext="{\mathbb{F}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝔽</mi><mo>′</mo></msup><annotation encoding="application/x-tex">{\mathbb{F}}^{\prime}</annotation></semantics></math>, the following diagram commutes.</p>
