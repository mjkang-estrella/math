span></span></foreignObject> </g> <path style="--ltx-stroke-color:#000000;" d="M 132.62379098535655 -5.269275589802131 L 132.6193993593361 -5.269275589802131" fill="none" stroke="#000000"></path> <g transform="translate(92.73,0) translate(0,-32.89)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 7.26 1.66" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 4.11 6.21" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M 132.62379098535655 -5.269275589802131 L 92.7272831996117 -32.88897172171198" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 92.73142146259254 -32.88897172171198 L 92.7272831996117 -32.88897172171198" fill="none" stroke="#000000"></path> <g transform="translate(52.22,0) translate(0,-44.6) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:2.81em;--ltx-fo-height:0.8em;--ltx-fo-depth:0.25em;font-size:10pt;" height="14.48" overflow="visible" transform="matrix(1 0 0 -1 0 11.02)" width="38.9"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mrow><munder accentunder="true"><mi>𝐓𝐨𝐩</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow></span></span></foreignObject> </g> </g> </svg> </mtext><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\vbox{\lx@xy@svg{\hbox{\raise 0.0pt\hbox{\kern 13.7361pt\hbox{\ignorespaces\ignorespaces\ignorespaces\hbox{\vtop{\halign{\entry@#!@&amp;&amp;\entry@@#!@\cr&amp;&amp;\cr&amp;&amp;\crcr}}}\ignorespaces{\hbox{\kern-13.7361pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\underline{\smash{\bf Top}}(X)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces{}\ignorespaces\ignorespaces{\hbox{\lx@xy@drawline@}}\ignorespaces{\hbox{\kern 40.41243pt\raise-23.76886pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}\ignorespaces\ignorespaces{\hbox{\lx@xy@drawline@}}\ignorespaces{\hbox{\lx@xy@drawline@}}{\hbox{\kern 51.79166pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{}$}}}}}}}{\hbox{\kern 95.84721pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\underline{\smash{\bf Top}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces{}\ignorespaces\ignorespaces{\hbox{\lx@xy@drawline@}}\ignorespaces{\hbox{\kern 67.014pt\raise-23.76886pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}\ignorespaces\ignorespaces{\hbox{\lx@xy@drawline@}}\ignorespaces{\hbox{\lx@xy@drawline@}}{\hbox{\kern-3.0pt\raise-32.23112pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{}$}}}}}}}{\hbox{\kern 37.7361pt\raise-32.23112pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\underline{\smash{\bf Top}}(X^{+})}$}}}}}}}{\hbox{\kern 98.34721pt\raise-32.23112pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{}$}}}}}}}\ignorespaces}}}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.SS4.SSS1.p1.2" class="ltx_p">Similar functors exist for Kuranishi spaces or derived orbifolds.</p>
</div>
<div id="S21.SS4.SSS1.p2" class="ltx_para ltx_noindent">
<p id="S21.SS4.SSS1.p2.1" class="ltx_p">Now consider the flow category <math id="S21.SS4.SSS1.p2.m1" class="ltx_Math" alttext="\mathbb{Cyl}(X)" display="inline" intent=":literal"><semantics><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{Cyl}(X)</annotation></semantics></math> (obtained from the monotone flow category <math id="S21.SS4.SSS1.p2.m2" class="ltx_Math" alttext="\mathbb{cyl}(X)" display="inline" intent=":literal"><semantics><mrow><mi>𝕔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{cyl}(X)</annotation></semantics></math>), which can be viewed as enriched in <math id="S21.SS4.SSS1.p2.m3" class="ltx_Math" alttext="\underline{\smash{\bf Top}}(X^{+})" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>𝐓𝐨𝐩</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\underline{\smash{\bf Top}}(X^{+})</annotation></semantics></math>. Similarly, the Floer flow category <math id="S21.SS4.SSS1.p2.m4" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> associated to a Hamiltonian <math id="S21.SS4.SSS1.p2.m5" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> and an almost complex structure <math id="S21.SS4.SSS1.p2.m6" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math> is also enriched in <math id="S21.SS4.SSS1.p2.m7" class="ltx_Math" alttext="\underline{\smash{\bf Top}}(X^{+})" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>𝐓𝐨𝐩</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\underline{\smash{\bf Top}}(X^{+})</annotation></semantics></math>. Then the Floer data used for defining the bimodules <math id="S21.SS4.SSS1.p2.m8" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{PF}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{PF}}</annotation></semantics></math> resp. <math id="S21.SS4.SSS1.p2.m9" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{FP}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{FP}}</annotation></semantics></math> also induces a bimodule</p>
<table id="S21.Ex37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex37.m1" class="ltx_math_unparsed" alttext="\mathbb{Cyl}^{\mathbb{PF}}(X)\ {\rm resp.}\ \mathbb{Cyl}{}^{\mathbb{FP}}(X)" display="block" intent=":literal"><semantics><mrow><mi>ℂ</mi><mi>𝕪</mi><msup><mi>𝕝</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo rspace="0.500em" stretchy="false">)</mo></mrow><mi>resp</mi><mo lspace="0em" rspace="0.667em">.</mo><mi>ℂ</mi><mi>𝕪</mi><mi>𝕝</mi><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mprescripts></mprescripts><mrow></mrow><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">\mathbb{Cyl}^{\mathbb{PF}}(X)\ {\rm resp.}\ \mathbb{Cyl}{}^{\mathbb{FP}}(X)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.SS4.SSS1.p2.2" class="ltx_p">over <math id="S21.SS4.SSS1.p2.m10" class="ltx_Math" alttext="(\mathbb{Cyl}(X);\mathbb{F})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>;</mo><mi>𝔽</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbb{Cyl}(X);\mathbb{F})</annotation></semantics></math> resp. over <math id="S21.SS4.SSS1.p2.m11" class="ltx_Math" alttext="(\mathbb{F};\mathbb{Cyl}(X))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝔽</mi><mo>;</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbb{F};\mathbb{Cyl}(X))</annotation></semantics></math>.</p>
</div>
<div id="S21.Thmthm10" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S21.Thmthm10.2" class="ltx_text ltx_font_bold">Proposition 21.10</span></span><span id="S21.Thmthm10.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S21.Thmthm10.p1" class="ltx_para">
<p id="S21.Thmthm10.p1.1" class="ltx_p"><span id="S21.Thmthm10.p1.1.1" class="ltx_text ltx_font_italic">Given an AMS lift <math id="S21.Thmthm10.p1.m1" class="ltx_Math" alttext="\widetilde{\mathbb{Cyl}}(X)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi></mrow><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\mathbb{Cyl}}(X)</annotation></semantics></math> of <math id="S21.Thmthm10.p1.m2" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Cyl}(X)" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><mi>ℂ</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mi>𝕪</mi><mi>𝕝</mi><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Cyl}(X)</annotation></semantics></math> to <math id="S21.Thmthm10.p1.m3" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}(X)" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><mi>rig</mi><mi>NC</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}(X)</annotation></semantics></math> and an AMS lift <math id="S21.Thmthm10.p1.m4" class="ltx_Math" alttext="\tilde{\mathbb{F}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{F}}</annotation></semantics></math> of <math id="S21.Thmthm10.p1.m5" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{F}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔽</mi></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{F}</annotation></semantics></math> to <math id="S21.Thmthm10.p1.m6" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>NC</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}</annotation></semantics></math>, there exists a lift (called an AMS lift) of the outercollaring <math id="S21.Thmthm10.p1.m7" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Cyl}{}^{\mathbb{PF}}(X)" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><mi>ℂ</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mi>𝕪</mi><mi>𝕝</mi><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mprescripts></mprescripts><mrow></mrow><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Cyl}{}^{\mathbb{PF}}(X)</annotation></semantics></math> resp. <math id="S21.Thmthm10.p1.m8" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Cyl}{}^{\mathbb{FP}}(X)" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><mi>ℂ</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mi>𝕪</mi><mi>𝕝</mi><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mprescripts></mprescripts><mrow></mrow><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Cyl}{}^{\mathbb{FP}}(X)</annotation></semantics></math> to <math id="S21.Thmthm10.p1.m9" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf dOrb}}{}_{\rm rig}^{\rm NC}(X^{+})" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mmultiscripts><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow><mrow></mrow><mi>NC</mi><mprescripts></mprescripts><mi>rig</mi><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf dOrb}}{}_{\rm rig}^{\rm NC}(X^{+})</annotation></semantics></math>, denoted by <math id="S21.Thmthm10.p1.m10" class="ltx_math_unparsed" alttext="\widetilde{\mathbb{Cyl}}{}^{\mathbb{PF}}(X)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi></mrow><mo>~</mo></mover><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mprescripts></mprescripts><mrow></mrow><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">\widetilde{\mathbb{Cyl}}{}^{\mathbb{PF}}(X)</annotation></semantics></math> resp. <math id="S21.Thmthm10.p1.m11" class="ltx_math_unparsed" alttext="\widetilde{\mathbb{Cyl}}{}^{\mathbb{FP}}(X)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi></mrow><mo>~</mo></mover><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mprescripts></mprescripts><mrow></mrow><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">\widetilde{\mathbb{Cyl}}{}^{\mathbb{FP}}(X)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S21.SS4.SSS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Sketch of Proof.</h6>
<div id="S21.SS4.SSS1.p3" class="ltx_para">
<p id="S21.SS4.SSS1.p3.1" class="ltx_p"><span id="S21.SS4.SSS1.p3.1.1" class="ltx_text">There is no essential difference from the previous cases.
∎</span></p>
</div>
</div>
<div id="S21.Thmthm11" class="ltx_theorem ltx_theorem_cor">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S21.Thmthm11.2" class="ltx_text ltx_font_bold">Corollary 21.11</span></span><span id="S21.Thmthm11.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S21.Thmthm11.p1" class="ltx_para">
<p id="S21.Thmthm11.p1.1" class="ltx_p"><span id="S21.Thmthm11.p1.1.1" class="ltx_text ltx_font_italic">Given an AMS lift <math id="S21.Thmthm11.p1.m1" class="ltx_Math" alttext="\tilde{\mathbb{P}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ℙ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{P}}</annotation></semantics></math> of the outercollaring of the pearly flow category <math id="S21.Thmthm11.p1.m2" class="ltx_Math" alttext="\mathbb{P}" display="inline" intent=":literal"><semantics><mi>ℙ</mi><annotation encoding="application/x-tex">\mathbb{P}</annotation></semantics></math> and an AMS lift <math id="S21.Thmthm11.p1.m3" class="ltx_Math" alttext="\tilde{\mathbb{F}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{F}}</annotation></semantics></math> of the Floer flow category, there exists a lift of <math id="S21.Thmthm11.p1.m4" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{B}^{\mathbb{PF}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔹</mi><msup><mrow></mrow><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{B}^{\mathbb{PF}}</annotation></semantics></math> resp. <math id="S21.Thmthm11.p1.m5" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{B}^{\mathbb{FP}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔹</mi><msup><mrow></mrow><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{B}^{\mathbb{FP}}</annotation></semantics></math> to <math id="S21.Thmthm11.p1.m6" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>NC</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S21.SS4.SSS1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S21.SS4.SSS1.p4" class="ltx_para">
<p id="S21.SS4.SSS1.p4.1" class="ltx_p"><span id="S21.SS4.SSS1.p4.1.1" class="ltx_text">It follows from the same arguments as we have seen many times, building on Proposition <a href="#S21.Thmthm10" title="Proposition 21.10. ‣ 21.4.1. A new category of fibered spaces ‣ 21.4. Pearly-to-Floer and Floer-to-Pearly bimodules ‣ 21. AMS Construction for Other Flow categories, Multimodules, and Homotopies ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21.10</span></a>. The only difference is that we should insert Morse flow lines on the pearly side to complete the construction.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="S21.SS5" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">21.5. </span>Morse-to-Floer and Floer-to-Morse bimodules</h4>

<div id="S21.SS5.p1" class="ltx_para ltx_noindent">
<p id="S21.SS5.p1.1" class="ltx_p">Now we consider the AMS lift of the bimodules <math id="S21.SS5.p1.m1" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{MF}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{MF}}</annotation></semantics></math> and <math id="S21.SS5.p1.m2" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{FM}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{FM}}</annotation></semantics></math>, which are responsible for the PSS and SSP maps claimed in Theorem <a href="#Thmthma5" title="Theorem E (PSS and SSP maps). ‣ 1.1.4. PSS map and isomorphism ‣ 1.1. Main results on Floer complexes ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E</span></a>. The claim of such AMS lifts is stated as Theorem <a href="#Thmthma19" title="Theorem S. ‣ 12.3. Bimodules and homotopies associated to PSS type maps ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">S</span></a>. As the PSS map on the homology level is supposed to be canonical, we also need to compare different choices.</p>
</div>
<div id="S21.SS5.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Theorem <a href="#Thmthma19" title="Theorem S. ‣ 12.3. Bimodules and homotopies associated to PSS type maps ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">S</span></a>.</h6>
<div id="S21.SS5.p2" class="ltx_para ltx_noindent">
<p id="S21.SS5.p2.1" class="ltx_p"><span id="S21.SS5.p2.1.1" class="ltx_text">We sketch the construction for <math id="S21.SS5.p2.m1" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{MF}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{MF}}</annotation></semantics></math>. The other case has no difference other than a simple reversal. See <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib57" title="" class="ltx_ref">14</a>, Section 7]</cite> for a more explicit discussion in a slightly different framework.</span></p>
</div>
<div id="S21.SS5.p3" class="ltx_para ltx_noindent">
<p id="S21.SS5.p3.1" class="ltx_p"><span id="S21.SS5.p3.1.1" class="ltx_text">By removing the Morse flow ray, the Morse-to-Floer bimodule <math id="S21.SS5.p3.m1" class="ltx_Math" alttext="{\mathbb{B}}^{\mathbb{MF}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">{\mathbb{B}}^{\mathbb{MF}}</annotation></semantics></math> becomes the cigar bimodule <math id="S21.SS5.p3.m2" class="ltx_Math" alttext="\mathbb{B}^{\rm cigar}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mi>cigar</mi></msup><annotation encoding="application/x-tex">\mathbb{B}^{\rm cigar}</annotation></semantics></math>, which is enriched in <math id="S21.SS5.p3.m3" class="ltx_Math" alttext="{\rm Top}(X^{+})" display="inline" intent=":literal"><semantics><mrow><mi>Top</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\rm Top}(X^{+})</annotation></semantics></math>. Recall that it is a bimodule over <math id="S21.SS5.p3.m4" class="ltx_Math" alttext="({\mathbb{O}};{\mathbb{F}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝕆</mi><mo>;</mo><mi>𝔽</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{O}};{\mathbb{F}})</annotation></semantics></math> where <math id="S21.SS5.p3.m5" class="ltx_Math" alttext="{\mathbb{O}}" display="inline" intent=":literal"><semantics><mi>𝕆</mi><annotation encoding="application/x-tex">{\mathbb{O}}</annotation></semantics></math> is the <math id="S21.SS5.p3.m6" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>-covering of the trivial flow category. Then the AMS construction is similar to that for the cigar bimodule <math id="S21.SS5.p3.m7" class="ltx_Math" alttext="\mathbb{B}^{\rm cigar}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mi>cigar</mi></msup><annotation encoding="application/x-tex">\mathbb{B}^{\rm cigar}</annotation></semantics></math>. When construct an AMS lift <math id="S21.SS5.p3.m8" class="ltx_Math" alttext="\tilde{\mathbb{B}}^{\rm cigar}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝔹</mi><mo>~</mo></mover><mi>cigar</mi></msup><annotation encoding="application/x-tex">\tilde{\mathbb{B}}^{\rm cigar}</annotation></semantics></math> to <math id="S21.SS5.p3.m9" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>NC</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}</annotation></semantics></math> (which is covered by Theorem <a href="#Thmthma16" title="Theorem P. ‣ 12.2. Multimodules and homotopies ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">P</span></a>), especially for smoothing, one can make the evaluation maps at the incoming marked point smooth submersions onto <math id="S21.SS5.p3.m10" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. Hence one obtains a lift, still denoted by <math id="S21.SS5.p3.m11" class="ltx_Math" alttext="\tilde{\mathbb{B}}^{\rm cigar}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝔹</mi><mo>~</mo></mover><mi>cigar</mi></msup><annotation encoding="application/x-tex">\tilde{\mathbb{B}}^{\rm cigar}</annotation></semantics></math>, enriched in <math id="S21.SS5.p3.m12" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}(X^{+})" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><mi>rig</mi><mi>NC</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}(X^{+})</annotation></semantics></math>. Then by adding gradient rays, one obtains a lift <math id="S21.SS5.p3.m13" class="ltx_Math" alttext="\tilde{\mathbb{B}}^{\mathbb{MF}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝔹</mi><mo>~</mo></mover><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\tilde{\mathbb{B}}^{\mathbb{MF}}</annotation></semantics></math> to <math id="S21.SS5.p3.m14" class="ltx_Math" alttext="\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}" display="inline" intent=":literal"><semantics><msubsup><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><mi>rig</mi><mi>NC</mi></msubsup><annotation encoding="application/x-tex">\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}</annotation></semantics></math> as a bimodule over <math id="S21.SS5.p3.m15" class="ltx_math_unparsed" alttext="({}_{\lfloor}\mathbb{M};\tilde{\mathbb{F}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝕄</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mo>;</mo><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({}_{\lfloor}\mathbb{M};\tilde{\mathbb{F}})</annotation></semantics></math>.</span></p>
</div>
<div id="S21.SS5.p4" class="ltx_para">
<p id="S21.SS5.p4.1" class="ltx_p"><span id="S21.SS5.p4.1.1" class="ltx_text">For the second item of Theorem <a href="#Thmthma19" title="Theorem S. ‣ 12.3. Bimodules and homotopies associated to PSS type maps ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">S</span></a>, one also needs to compare different choices of integral actions. This can be done using the double-framed construction introduced in Section <a href="#S20" title="20. Comparing Non-homotopic Choices ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">20</span></a> in a similar way as proving Proposition <a href="#S12.Thmthm3" title="Proposition 12.3. ‣ 12.2. Multimodules and homotopies ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12.3</span></a>. We omit the details.
∎</span></p>
</div>
</div>
<div id="S21.SS5.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Theorem <a href="#S12.Thmthm6" title="Theorem 12.6. ‣ 12.3. Bimodules and homotopies associated to PSS type maps ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12.6</span></a>.</h6>
<div id="S21.SS5.p5" class="ltx_para">
<p id="S21.SS5.p5.1" class="ltx_p"><span id="S21.SS5.p5.1.1" class="ltx_text">For the concatenation <math id="S21.SS5.p5.m1" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{FF}^{\prime}}\circ\mathbb{B}^{\mathbb{F^{\prime}}\mathbb{M}^{\prime}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝔹</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔽</mi><mo>′</mo></msup></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>𝔹</mi><mrow><msup><mi>𝔽</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝕄</mi><mo>′</mo></msup></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{FF}^{\prime}}\circ\mathbb{B}^{\mathbb{F^{\prime}}\mathbb{M}^{\prime}}</annotation></semantics></math> at the Floer flow category and its homotopy to <math id="S21.SS5.p5.m2" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{F}\mathbb{M}^{\prime}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝕄</mi><mo>′</mo></msup></mrow></msup><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{F}\mathbb{M}^{\prime}}</annotation></semantics></math>, the corresponding AMS construction is similar to what is required for establishing the naturality of the continuation map. For the concatenation <math id="S21.SS5.p5.m3" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{FM}}\circ\mathbb{B}^{\mathbb{MM}^{\prime}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝔹</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>𝔹</mi><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝕄</mi><mo>′</mo></msup></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{FM}}\circ\mathbb{B}^{\mathbb{MM}^{\prime}}</annotation></semantics></math> at the Morse flow category <math id="S21.SS5.p5.m4" class="ltx_Math" alttext="\mathbb{M}" display="inline" intent=":literal"><semantics><mi>𝕄</mi><annotation encoding="application/x-tex">\mathbb{M}</annotation></semantics></math>, the construction is even simpler. We omit the details.
∎</span></p>
</div>
</div>
</section>
<section id="S21.SS6" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">21.6. </span>Proof of Theorem <a href="#Thmthma20" title="Theorem T. ‣ 12.3.2. The triangle of Morse, Floer and pearly flow categories ‣ 12.3. Bimodules and homotopies associated to PSS type maps ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">T</span></a></h4>

<div id="S21.SS6.p1" class="ltx_para ltx_noindent">
<p id="S21.SS6.p1.1" class="ltx_p">We have constructed the lifts of flow categories and bimodules listed in the statement of Theorem <a href="#Thmthma20" title="Theorem T. ‣ 12.3.2. The triangle of Morse, Floer and pearly flow categories ‣ 12.3. Bimodules and homotopies associated to PSS type maps ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">T</span></a>. We choose a common outercollaring width and a compatible set of integral actions. To finish the proof of Theorem <a href="#Thmthma20" title="Theorem T. ‣ 12.3.2. The triangle of Morse, Floer and pearly flow categories ‣ 12.3. Bimodules and homotopies associated to PSS type maps ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">T</span></a>, one needs to establish corresponding lifts of homotopies involving certain concatenations and gluings. Notice that we only glue at the Floer flow category or the pearly flow category, but not the Morse flow category. We need to construct such homotopies for many triangles of the diagram (<a href="#S12.E1" title="In Theorem T. ‣ 12.3.2. The triangle of Morse, Floer and pearly flow categories ‣ 12.3. Bimodules and homotopies associated to PSS type maps ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12.1</span></a>). However, the constructions for each triangle have no substantial differences. Hence we only give proofs for two typical cases.</p>
</div>
<section id="S21.SS6.SSS1" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">21.6.1. </span>Concatenation at the Floer flow category</h5>

<div id="S21.SS6.SSS1.p1" class="ltx_para ltx_noindent">
<p id="S21.SS6.SSS1.p1.1" class="ltx_p">We prove the following statement.</p>
</div>
<div id="S21.Thmthm12" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S21.Thmthm12.2" class="ltx_text ltx_font_bold">Lemma 21.12</span></span><span id="S21.Thmthm12.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S21.Thmthm12.p1" class="ltx_para">
<p id="S21.Thmthm12.p1.1" class="ltx_p"><span id="S21.Thmthm12.p1.1.1" class="ltx_text ltx_font_italic">Fix an outercollaring width and an integral action <math id="S21.Thmthm12.p1.m1" class="ltx_Math" alttext="{\mathcal{A}}_{\mathbb{F}}^{\Omega}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>𝔽</mi><mi mathvariant="normal">Ω</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{A}}_{\mathbb{F}}^{\Omega}</annotation></semantics></math> which is compatible with all involved Floer data. Let <math id="S21.Thmthm12.p1.m2" class="ltx_Math" alttext="\hat{\mathbb{F}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝔽</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\mathbb{F}}</annotation></semantics></math> be an AMS lift of <math id="S21.Thmthm12.p1.m3" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> subject to the outercollaring width and <math id="S21.Thmthm12.p1.m4" class="ltx_Math" alttext="{\mathcal{A}}_{\mathbb{F}}^{\Omega}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>𝔽</mi><mi mathvariant="normal">Ω</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{A}}_{\mathbb{F}}^{\Omega}</annotation></semantics></math>. Let <math id="S21.Thmthm12.p1.m5" class="ltx_Math" alttext="\hat{\mathbb{P}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ℙ</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\mathbb{P}}</annotation></semantics></math> be an AMS lift of the pearly flow category subject to the same outercollaring width and the integral symplectic form <math id="S21.Thmthm12.p1.m6" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math>. Let <math id="S21.Thmthm12.p1.m7" class="ltx_Math" alttext="\hat{\mathbb{B}}^{\mathbb{PF}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝔹</mi><mo>^</mo></mover><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\hat{\mathbb{B}}^{\mathbb{PF}}</annotation></semantics></math> be an AMS lift of <math id="S21.Thmthm12.p1.m8" class="ltx_Math" alttext="{\mathbb{B}}^{\mathbb{PF}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">{\mathbb{B}}^{\mathbb{PF}}</annotation></semantics></math> and <math id="S21.Thmthm12.p1.m9" class="ltx_Math" alttext="\hat{\mathbb{B}}^{\mathbb{FP}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝔹</mi><mo>^</mo></mover><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><annotation encoding="application/x-tex">\hat{\mathbb{B}}^{\mathbb{FP}}</annotation></semantics></math> be an AMS lift of <math id="S21.Thmthm12.p1.m10" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{FP}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{FP}}</annotation></semantics></math>. Let <math id="S21.Thmthm12.p1.m11" class="ltx_Math" alttext="\hat{\mathbb{\Delta}}^{\mathbb{PP}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mo>^</mo></mover><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><annotation encoding="application/x-tex">\hat{\mathbb{\Delta}}^{\mathbb{PP}}</annotation></semantics></math> be an AMS lift of the diagonal bimodule. Then there exists a concatenation <math id="S21.Thmthm12.p1.m12" class="ltx_Math" alttext="\hat{\mathbb{B}}^{\mathbb{PF}}\circ\hat{\mathbb{B}}^{\mathbb{FP}}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>𝔹</mi><mo>^</mo></mover><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mover accent="true"><mi>𝔹</mi><mo>^</mo></mover><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\hat{\mathbb{B}}^{\mathbb{PF}}\circ\hat{\mathbb{B}}^{\mathbb{FP}}</annotation></semantics></math> and a homotopy from this concatenation to <math id="S21.Thmthm12.p1.m13" class="ltx_Math" alttext="\hat{\mathbb{\Delta}}^{\mathbb{PP}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mo>^</mo></mover><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><annotation encoding="application/x-tex">\hat{\mathbb{\Delta}}^{\mathbb{PP}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S21.SS6.SSS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S21.SS6.SSS1.p2" class="ltx_para">
<p id="S21.SS6.SSS1.p2.1" class="ltx_p"><span id="S21.SS6.SSS1.p2.1.1" class="ltx_text">The construction of a concatenation <math id="S21.SS6.SSS1.p2.m1" class="ltx_Math" alttext="\hat{\mathbb{B}}^{\mathbb{PF}}\circ\hat{\mathbb{B}}^{\mathbb{FP}}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>𝔹</mi><mo>^</mo></mover><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mover accent="true"><mi>𝔹</mi><mo>^</mo></mover><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\hat{\mathbb{B}}^{\mathbb{PF}}\circ\hat{\mathbb{B}}^{\mathbb{FP}}</annotation></semantics></math> is no different from other situations involving concatenating at a Floer flow category. The construction of the lift of the homotopy to <math id="S21.SS6.SSS1.p2.m2" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf SKur}}_{\rm rig}^{\rm NC}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐒𝐊𝐮𝐫</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>NC</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf SKur}}_{\rm rig}^{\rm NC}</annotation></semantics></math> also only differs in notation.
∎</span></p>
</div>
</div>
</section>
<section id="S21.SS6.SSS2" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">21.6.2. </span>Concatenation at the pearly flow category</h5>

<div id="S21.SS6.SSS2.p1" class="ltx_para ltx_noindent">
<p id="S21.SS6.SSS2.p1.1" class="ltx_p">The concatenation at the pearly flow category is slightly more complicated. We consider the reversed concatenation <math id="S21.SS6.SSS2.p1.m1" class="ltx_Math" alttext="{\mathbb{B}}^{\mathbb{FP}}\circ\mathbb{B}^{\mathbb{PF}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝔹</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>𝔹</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{\mathbb{B}}^{\mathbb{FP}}\circ\mathbb{B}^{\mathbb{PF}}</annotation></semantics></math>.</p>
</div>
<div id="S21.SS6.SSS2.p2" class="ltx_para ltx_noindent">
<p id="S21.SS6.SSS2.p2.1" class="ltx_p">Notice that the homotopy between the concatenation <math id="S21.SS6.SSS2.p2.m1" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{FP}}\circ\mathbb{B}^{\mathbb{PF}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝔹</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>𝔹</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{FP}}\circ\mathbb{B}^{\mathbb{PF}}</annotation></semantics></math> and <math id="S21.SS6.SSS2.p2.m2" class="ltx_Math" alttext="\mathbb{\Delta}^{\mathbb{FF}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{\Delta}^{\mathbb{FF}}</annotation></semantics></math> is the union of two parts: the first part is when there are gradient flow segments of a positive total length (where the length is a parameter for the homotopy); the second part is when there are no gradient segments. See Figure <a href="#S11.F6" title="Figure 6 ‣ 11.3.1. Floer-to-Pearly, Pearly-to-Floer bimodules, and their concatenations ‣ 11.3. Homotopies associated to PSS type moduli spaces ‣ 11. Homotopies of Multimodules ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> for an illustration. The boundary between the two parts can be viewed as another concatenation</p>
<table id="S21.Ex38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex38.m1" class="ltx_Math" alttext="\mathbb{Cyl}^{\mathbb{FP}}(X)\circ\mathbb{Cyl}^{\mathbb{PF}}(X)" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝕝</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">∘</mo><mi>ℂ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝕝</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{Cyl}^{\mathbb{FP}}(X)\circ\mathbb{Cyl}^{\mathbb{PF}}(X)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.SS6.SSS2.p2.2" class="ltx_p">at the flow category <math id="S21.SS6.SSS2.p2.m3" class="ltx_Math" alttext="\mathbb{Cyl}(X)" display="inline" intent=":literal"><semantics><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{Cyl}(X)</annotation></semantics></math>. Notice that one has constructed AMS lifts <math id="S21.SS6.SSS2.p2.m4" class="ltx_Math" alttext="\widehat{\mathbb{Cyl}}^{\mathbb{FP}}(X)" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi></mrow><mo>^</mo></mover><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mathbb{Cyl}}^{\mathbb{FP}}(X)</annotation></semantics></math> and <math id="S21.SS6.SSS2.p2.m5" class="ltx_Math" alttext="\widehat{\mathbb{Cyl}}^{\mathbb{PF}}(X)" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi></mrow><mo>^</mo></mover><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mathbb{Cyl}}^{\mathbb{PF}}(X)</annotation></semantics></math> to <math id="S21.SS6.SSS2.p2.m6" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf SKur}}_{\rm rig}^{\rm NC}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐒𝐊𝐮𝐫</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>NC</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf SKur}}_{\rm rig}^{\rm NC}</annotation></semantics></math>. The concatenation can be constructed in a straightforward way. Then we extend the concatenation in the two directions. One direction is the gluing, which has no essential new features for this case. The other direction is to insert gradient flow segments. This is similar to the cases of <math id="S21.SS6.SSS2.p2.m7" class="ltx_Math" alttext="\mathbb{P}" display="inline" intent=":literal"><semantics><mi>ℙ</mi><annotation encoding="application/x-tex">\mathbb{P}</annotation></semantics></math> and <math id="S21.SS6.SSS2.p2.m8" class="ltx_Math" alttext="\mathbb{\Delta}^{\mathbb{PP}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{\Delta}^{\mathbb{PP}}</annotation></semantics></math>. We omit the details.</p>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
</section>
</section>
</section>
<section id="Pt4" class="ltx_part">
<h2 class="ltx_title ltx_title_part"><span class="ltx_tag ltx_tag_part">Part IV </span>EQUIVARIANT FLOER THEORY AND STEENROD OPERATIONS</h2>

<section id="Sx4" class="ltx_section">
<h3 class="ltx_title ltx_title_section">Outline of Part 4</h3>

<div id="Sx4.p1" class="ltx_para ltx_noindent">
<p id="Sx4.p1.1" class="ltx_p">Note that we would like to switch to the cohomological convention. The Floer equation will remain the same. However, it will be the equation for the ascending gradient flow equation of the action functional (which differs from the one used previously by a negative sign). Hence the differential increases the action functional. The grading is also changed to the cohomological one so that the pair-of-pants product is degree-preserving. Moreover, we make use of the coherent orientations without explicitly mentioning them.</p>
</div>
</section>
<section id="S22" class="ltx_section">
<h3 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">22. </span>Morse Theory on Classifying Spaces</h3>

<div id="S22.p1" class="ltx_para ltx_noindent">
<p id="S22.p1.1" class="ltx_p">The Borel <math id="S22.p1.m1" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-equivariant cohomology of a point with <math id="S22.p1.m2" class="ltx_Math" alttext="{\bf F}_{\sf p}" display="inline" intent=":literal"><semantics><msub><mi>𝐅</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{\bf F}_{\sf p}</annotation></semantics></math>-coefficient is the ring</p>
<table id="S22.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex1.m1" class="ltx_Math" alttext="H_{{{\mathbb{Z}}_{\sf p}}}^{\rm Borel}({\rm pt};{\bf F}_{\sf p})\cong H^{*}(B{{\mathbb{Z}}_{\sf p}};{\bf F}_{\sf p})=\left\{\begin{array}[]{ll}{\bf F}_{\sf p}[\mathtt{U},\uptheta]/\langle\uptheta^{2}=0\rangle,&amp;\ {\sf p}&gt;2;\\
{\bf F}_{2}[\uptheta],&amp;\ {\sf p}=2.\end{array}\right." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mi>Borel</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>pt</mi><mo>,</mo><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>ℤ</mi><mi>𝗉</mi></msub></mrow><mo>,</mo><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>𝚄</mi><mo>,</mo><mi mathvariant="normal">θ</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>/</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi mathvariant="normal">θ</mi><mn>2</mn></msup><mo>=</mo><mn>0</mn></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>𝗉</mi><mo>&gt;</mo><mn>2</mn></mrow><mo>;</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi>𝐅</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi mathvariant="normal">θ</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>𝗉</mi><mo>=</mo><mn>2</mn></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">H_{{{\mathbb{Z}}_{\sf p}}}^{\rm Borel}({\rm pt};{\bf F}_{\sf p})\cong H^{*}(B{{\mathbb{Z}}_{\sf p}};{\bf F}_{\sf p})=\left\{\begin{array}[]{ll}{\bf F}_{\sf p}[\mathtt{U},\uptheta]/\langle\uptheta^{2}=0\rangle,&amp;\ {\sf p}&gt;2;\\
{\bf F}_{2}[\uptheta],&amp;\ {\sf p}=2.\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.p1.2" class="ltx_p">where <math id="S22.p1.m3" class="ltx_Math" alttext="\mathtt{U}" display="inline" intent=":literal"><semantics><mi>𝚄</mi><annotation encoding="application/x-tex">\mathtt{U}</annotation></semantics></math> has degree <math id="S22.p1.m4" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> while <math id="S22.p1.m5" class="ltx_Math" alttext="\uptheta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">θ</mi><annotation encoding="application/x-tex">\uptheta</annotation></semantics></math> has degree <math id="S22.p1.m6" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>. One usually considers the completion by allowing formal power series rather than polynomials in <math id="S22.p1.m7" class="ltx_Math" alttext="\mathtt{U}" display="inline" intent=":literal"><semantics><mi>𝚄</mi><annotation encoding="application/x-tex">\mathtt{U}</annotation></semantics></math> and <math id="S22.p1.m8" class="ltx_Math" alttext="\uptheta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">θ</mi><annotation encoding="application/x-tex">\uptheta</annotation></semantics></math>. We denote the completion by</p>
<table id="S22.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex2.m1" class="ltx_Math" alttext="\widetilde{\bf K}_{{\sf p},0}:=\left\{\begin{array}[]{ll}{\bf F}_{\sf p}{[\![\mathtt{U}]\!]}\langle\uptheta\rangle,&amp;\ {\sf p}&gt;2,\\
{\bf F}_{2}{[\![\uptheta]\!]},&amp;\ {\sf p}=2.\end{array}\right." display="block" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>𝐊</mi><mo>~</mo></mover><mrow><mi>𝗉</mi><mo>,</mo><mn>0</mn></mrow></msub><mo>:=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">[</mo><mi>𝚄</mi><mpadded style="width:0.108em;" width="0.108em"><mo stretchy="false">]</mo></mpadded></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mi mathvariant="normal">θ</mi><mo stretchy="false">⟩</mo></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>𝗉</mi><mo>&gt;</mo><mn>2</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi>𝐅</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">[</mo><mi mathvariant="normal">θ</mi><mpadded style="width:0.108em;" width="0.108em"><mo stretchy="false">]</mo></mpadded></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>𝗉</mi><mo>=</mo><mn>2</mn></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\bf K}_{{\sf p},0}:=\left\{\begin{array}[]{ll}{\bf F}_{\sf p}{[\![\mathtt{U}]\!]}\langle\uptheta\rangle,&amp;\ {\sf p}&gt;2,\\
{\bf F}_{2}{[\![\uptheta]\!]},&amp;\ {\sf p}=2.\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.p1.3" class="ltx_p">By inverting <math id="S22.p1.m9" class="ltx_Math" alttext="\mathtt{U}" display="inline" intent=":literal"><semantics><mi>𝚄</mi><annotation encoding="application/x-tex">\mathtt{U}</annotation></semantics></math> for <math id="S22.p1.m10" class="ltx_Math" alttext="p\geq 3" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>≥</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">p\geq 3</annotation></semantics></math> and inverting <math id="S22.p1.m11" class="ltx_Math" alttext="\uptheta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">θ</mi><annotation encoding="application/x-tex">\uptheta</annotation></semantics></math> for <math id="S22.p1.m12" class="ltx_Math" alttext="p=2" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">p=2</annotation></semantics></math>, one get the Laurent version</p>
<table id="S22.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex3.m1" class="ltx_Math" alttext="\widetilde{\bf K}_{\sf p}:=\left\{\begin{array}[]{ll}{\bf F}_{\sf p}{(\!(\mathtt{U})\!)}\langle\uptheta\rangle,&amp;\ {\sf p}&gt;2,\\
{\bf F}_{2}{(\!(\uptheta)\!)},&amp;\ {\sf p}=2.\end{array}\right." display="block" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>𝐊</mi><mo>~</mo></mover><mi>𝗉</mi></msub><mo>:=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><mi>𝚄</mi><mpadded style="width:0.219em;" width="0.219em"><mo stretchy="false">)</mo></mpadded></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mi mathvariant="normal">θ</mi><mo stretchy="false">⟩</mo></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>𝗉</mi><mo>&gt;</mo><mn>2</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi>𝐅</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">θ</mi><mpadded style="width:0.219em;" width="0.219em"><mo stretchy="false">)</mo></mpadded></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>𝗉</mi><mo>=</mo><mn>2</mn></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\bf K}_{\sf p}:=\left\{\begin{array}[]{ll}{\bf F}_{\sf p}{(\!(\mathtt{U})\!)}\langle\uptheta\rangle,&amp;\ {\sf p}&gt;2,\\
{\bf F}_{2}{(\!(\uptheta)\!)},&amp;\ {\sf p}=2.\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.p1.4" class="ltx_p">This ring is not the cohomology of any natural topological space. However, it can be realized as the cohomology of a certain flow category which will be convenient for establishing the Tate equivariant theories. We will also use the notation</p>
<table id="S22.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex4.m1" class="ltx_Math" alttext="{\bf K}_{\sf p}:={\bf F}_{\sf p}{(\!(\mathtt{U})\!)}" display="block" intent=":literal"><semantics><mrow><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mo>:=</mo><mrow><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><mi>𝚄</mi><mpadded style="width:0.219em;" width="0.219em"><mo stretchy="false">)</mo></mpadded></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bf K}_{\sf p}:={\bf F}_{\sf p}{(\!(\mathtt{U})\!)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.p1.5" class="ltx_p">for <math id="S22.p1.m13" class="ltx_Math" alttext="{\sf p}&gt;2" display="inline" intent=":literal"><semantics><mrow><mi>𝗉</mi><mo>&gt;</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">{\sf p}&gt;2</annotation></semantics></math>, dropping <math id="S22.p1.m14" class="ltx_Math" alttext="\uptheta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">θ</mi><annotation encoding="application/x-tex">\uptheta</annotation></semantics></math>, in later discussions.</p>
</div>
<section id="S22.SS1" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">22.1. </span>An equivariant Morse flow category</h4>

<div id="S22.SS1.p1" class="ltx_para ltx_noindent">
<p id="S22.SS1.p1.1" class="ltx_p">We provide a concrete Morse model for equivariant cohomology of a point. We will use this Morse model throughout all the equivariant constructions.</p>
</div>
<section id="S22.SS1.SSS1" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">22.1.1. </span><math id="S22.SS1.SSS1.m1" class="ltx_Math" alttext="{\sf p}=2" display="inline" intent=":literal"><semantics><mrow><mi>𝗉</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">{\sf p}=2</annotation></semantics></math> case</h5>

<div id="S22.SS1.SSS1.p1" class="ltx_para ltx_noindent">
<p id="S22.SS1.SSS1.p1.1" class="ltx_p">Consider the “real <math id="S22.SS1.SSS1.p1.m1" class="ltx_Math" alttext="S^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">S^{\infty}</annotation></semantics></math>”</p>
<table id="S22.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex5.m1" class="ltx_math_unparsed" alttext="S^{\infty}_{\mathbb{R}}:=\Big\{\eta=(\eta_{0},\eta_{1},\ldots)\ |\ \eta_{l}\in{\mathbb{R}},\ \eta_{l}=0\text{ for }\forall l\gg 0,\ \sum_{l=0}^{\infty}\eta_{l}^{2}=1\Big\}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>S</mi><mi>ℝ</mi><mi mathvariant="normal">∞</mi></msubsup><mo>:=</mo><mrow><mo stretchy="false">{</mo><mi>η</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>η</mi><mn>0</mn></msub><mo>,</mo><msub><mi>η</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo rspace="0.500em" stretchy="false">)</mo></mrow><mo fence="false" rspace="0.667em" stretchy="false">|</mo><msub><mi>η</mi><mi>l</mi></msub><mo>∈</mo><mi>ℝ</mi><mo rspace="0.667em">,</mo><msub><mi>η</mi><mi>l</mi></msub><mo>=</mo><mn>0</mn><mtext> for </mtext><mo lspace="0.167em" rspace="0.167em">∀</mo><mi>l</mi><mo>≫</mo><mn>0</mn><mo rspace="0.500em">,</mo><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><msubsup><mi>η</mi><mi>l</mi><mn>2</mn></msubsup><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">S^{\infty}_{\mathbb{R}}:=\Big\{\eta=(\eta_{0},\eta_{1},\ldots)\ |\ \eta_{l}\in{\mathbb{R}},\ \eta_{l}=0\text{ for }\forall l\gg 0,\ \sum_{l=0}^{\infty}\eta_{l}^{2}=1\Big\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.SS1.SSS1.p1.2" class="ltx_p">which is a contractible infinite CW complex. The group <math id="S22.SS1.SSS1.p1.m2" class="ltx_Math" alttext="{\mathbb{Z}}_{2}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">{\mathbb{Z}}_{2}</annotation></semantics></math> acts freely by changing <math id="S22.SS1.SSS1.p1.m3" class="ltx_Math" alttext="\eta_{l}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mi>l</mi></msub><annotation encoding="application/x-tex">\eta_{l}</annotation></semantics></math> to <math id="S22.SS1.SSS1.p1.m4" class="ltx_Math" alttext="-\eta_{l}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><msub><mi>η</mi><mi>l</mi></msub></mrow><annotation encoding="application/x-tex">-\eta_{l}</annotation></semantics></math> with quotient being <math id="S22.SS1.SSS1.p1.m5" class="ltx_Math" alttext="\mathbb{RP}^{\infty}" display="inline" intent=":literal"><semantics><mrow><mi>ℝ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi mathvariant="normal">∞</mi></msup></mrow><annotation encoding="application/x-tex">\mathbb{RP}^{\infty}</annotation></semantics></math>, which is a model for the classifying space of <math id="S22.SS1.SSS1.p1.m6" class="ltx_Math" alttext="{\mathbb{Z}}_{2}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">{\mathbb{Z}}_{2}</annotation></semantics></math>. As <math id="S22.SS1.SSS1.p1.m7" class="ltx_Math" alttext="S_{\mathbb{R}}^{\infty}" display="inline" intent=":literal"><semantics><msubsup><mi>S</mi><mi>ℝ</mi><mi mathvariant="normal">∞</mi></msubsup><annotation encoding="application/x-tex">S_{\mathbb{R}}^{\infty}</annotation></semantics></math> is the colimit of finite-dimensional spheres, we can define notion of smoothness in the naive way. For example, a function on <math id="S22.SS1.SSS1.p1.m8" class="ltx_Math" alttext="S_{\mathbb{R}}^{\infty}" display="inline" intent=":literal"><semantics><msubsup><mi>S</mi><mi>ℝ</mi><mi mathvariant="normal">∞</mi></msubsup><annotation encoding="application/x-tex">S_{\mathbb{R}}^{\infty}</annotation></semantics></math> is smooth if its restriction to each truncation <math id="S22.SS1.SSS1.p1.m9" class="ltx_Math" alttext="S^{k}\subseteq S_{\mathbb{R}}^{\infty}" display="inline" intent=":literal"><semantics><mrow><msup><mi>S</mi><mi>k</mi></msup><mo>⊆</mo><msubsup><mi>S</mi><mi>ℝ</mi><mi mathvariant="normal">∞</mi></msubsup></mrow><annotation encoding="application/x-tex">S^{k}\subseteq S_{\mathbb{R}}^{\infty}</annotation></semantics></math> is smooth.</p>
</div>
<div id="S22.SS1.SSS1.p2" class="ltx_para ltx_noindent">
<p id="S22.SS1.SSS1.p2.1" class="ltx_p">Consider the function</p>
<table id="S22.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex6.m1" class="ltx_Math" alttext="f^{\mathbb{E}}:S_{\mathbb{R}}^{\infty}\to{\mathbb{R}},\ f^{\mathbb{E}}(\eta)=\sum_{l=0}^{\infty}l\eta_{l}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>f</mi><mi>𝔼</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>S</mi><mi>ℝ</mi><mi mathvariant="normal">∞</mi></msubsup><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mrow><msup><mi>f</mi><mi>𝔼</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>η</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>η</mi><mi>l</mi><mn>2</mn></msubsup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f^{\mathbb{E}}:S_{\mathbb{R}}^{\infty}\to{\mathbb{R}},\ f^{\mathbb{E}}(\eta)=\sum_{l=0}^{\infty}l\eta_{l}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.SS1.SSS1.p2.2" class="ltx_p">Its trunctions to each <math id="S22.SS1.SSS1.p2.m1" class="ltx_Math" alttext="S^{k}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mi>k</mi></msup><annotation encoding="application/x-tex">S^{k}</annotation></semantics></math> is a Morse function. The critical point set is</p>
<table id="S22.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex7.m1" class="ltx_math_unparsed" alttext="{\rm crit}f^{\mathbb{E}}=\{\eta=\pm w_{l}\ |\ \eta_{j}=\pm\delta_{jl},\ l=0,1,\ldots\}." display="block" intent=":literal"><semantics><mrow><mi>crit</mi><msup><mi>f</mi><mi>𝔼</mi></msup><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>η</mi><mo rspace="0em">=</mo><mo lspace="0em">±</mo><msub><mi>w</mi><mi>l</mi></msub><mo fence="false" rspace="0.667em" stretchy="false">|</mo><msub><mi>η</mi><mi>j</mi></msub><mo rspace="0em">=</mo><mo lspace="0em">±</mo><msub><mi>δ</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><mo rspace="0.667em">,</mo><mi>l</mi><mo>=</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\rm crit}f^{\mathbb{E}}=\{\eta=\pm w_{l}\ |\ \eta_{j}=\pm\delta_{jl},\ l=0,1,\ldots\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.SS1.SSS1.p2.3" class="ltx_p">It is easy to see that the standard metric <math id="S22.SS1.SSS1.p2.m2" class="ltx_Math" alttext="g^{\mathbb{E}}" display="inline" intent=":literal"><semantics><msup><mi>g</mi><mi>𝔼</mi></msup><annotation encoding="application/x-tex">g^{\mathbb{E}}</annotation></semantics></math> on <math id="S22.SS1.SSS1.p2.m3" class="ltx_Math" alttext="S^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">S^{\infty}</annotation></semantics></math> makes it Morse–Smale. Define the grading by</p>
<table id="S22.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex8.m1" class="ltx_Math" alttext="|\pm w_{l}|=l." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mo>±</mo><msub><mi>w</mi><mi>l</mi></msub></mrow><mo stretchy="false">|</mo></mrow><mo>=</mo><mi>l</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|\pm w_{l}|=l.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S22.SS1.SSS1.p3" class="ltx_para ltx_noindent">
<p id="S22.SS1.SSS1.p3.1" class="ltx_p">The Tate equivariant theory suggests to consider a formal “negative extension” of <math id="S22.SS1.SSS1.p3.m1" class="ltx_Math" alttext="S_{\mathbb{R}}^{\infty}" display="inline" intent=":literal"><semantics><msubsup><mi>S</mi><mi>ℝ</mi><mi mathvariant="normal">∞</mi></msubsup><annotation encoding="application/x-tex">S_{\mathbb{R}}^{\infty}</annotation></semantics></math>. Define</p>
<table id="S22.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex9.m1" class="ltx_math_unparsed" alttext="\widehat{S}_{\mathbb{R}}^{\infty}=\Big\{\eta=(\eta_{l})_{l\in{\mathbb{Z}}}\ |\ \eta_{l}\in{\mathbb{R}},\ \eta_{l}=0\text{ for }\forall|l|\gg 0,\ \sum_{l\in{\mathbb{Z}}}\eta_{l}^{2}=1\Big\}." display="block" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi>ℝ</mi><mi mathvariant="normal">∞</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>η</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>η</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>l</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><mo fence="false" rspace="0.667em" stretchy="false">|</mo><msub><mi>η</mi><mi>l</mi></msub><mo>∈</mo><mi>ℝ</mi><mo rspace="0.667em">,</mo><msub><mi>η</mi><mi>l</mi></msub><mo>=</mo><mn>0</mn><mtext> for </mtext><mo lspace="0.167em">∀</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>l</mi><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">≫</mo><mn>0</mn><mo rspace="0.500em">,</mo><munder><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder><msubsup><mi>η</mi><mi>l</mi><mn>2</mn></msubsup><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widehat{S}_{\mathbb{R}}^{\infty}=\Big\{\eta=(\eta_{l})_{l\in{\mathbb{Z}}}\ |\ \eta_{l}\in{\mathbb{R}},\ \eta_{l}=0\text{ for }\forall|l|\gg 0,\ \sum_{l\in{\mathbb{Z}}}\eta_{l}^{2}=1\Big\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.SS1.SSS1.p3.2" class="ltx_p">This is no longer a CW complex; however, all structures should be understood in the sense of limits/colimits. For each pair of nonnegative integers <math id="S22.SS1.SSS1.p3.m2" class="ltx_Math" alttext="m,n" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>,</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">m,n</annotation></semantics></math>, there is a finite truncation</p>
<table id="S22.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex10.m1" class="ltx_Math" alttext="S^{m,n}_{\mathbb{R}}:=\Big\{\eta\in\widehat{S}_{\mathbb{R}}^{\infty}\ |\ l&lt;-m\ {\rm or}\ l&gt;n\Longrightarrow\eta_{l}=0\Big\}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>S</mi><mi>ℝ</mi><mrow><mi>m</mi><mo>,</mo><mi>n</mi></mrow></msubsup><mo>:=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>η</mi><mo>∈</mo><msubsup><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi>ℝ</mi><mi mathvariant="normal">∞</mi></msubsup></mrow><mo lspace="0em" rspace="0.500em">|</mo><mrow><mi>l</mi><mo>&lt;</mo><mrow><mo>−</mo><mrow><mi>m</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>or</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>l</mi></mrow></mrow><mo>&gt;</mo><mi>n</mi><mo stretchy="false">⟹</mo><msub><mi>η</mi><mi>l</mi></msub><mo>=</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">S^{m,n}_{\mathbb{R}}:=\Big\{\eta\in\widehat{S}_{\mathbb{R}}^{\infty}\ |\ l&lt;-m\ {\rm or}\ l&gt;n\Longrightarrow\eta_{l}=0\Big\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.SS1.SSS1.p3.3" class="ltx_p">By abuse of notation, we can extend the Morse function to</p>
<table id="S22.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex11.m1" class="ltx_Math" alttext="f^{\mathbb{E}}:\widehat{S}_{\mathbb{R}}^{\infty}\to{\mathbb{R}},\ f^{\mathbb{E}}(\eta)=\sum_{l=-\infty}^{\infty}l\eta_{l}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>f</mi><mi>𝔼</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi>ℝ</mi><mi mathvariant="normal">∞</mi></msubsup><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mrow><msup><mi>f</mi><mi>𝔼</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>η</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>η</mi><mi>l</mi><mn>2</mn></msubsup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f^{\mathbb{E}}:\widehat{S}_{\mathbb{R}}^{\infty}\to{\mathbb{R}},\ f^{\mathbb{E}}(\eta)=\sum_{l=-\infty}^{\infty}l\eta_{l}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.SS1.SSS1.p3.4" class="ltx_p">Then with respect to the standard Riemannian metric, the pair is Morse–Smale on any such finite truncation.</p>
</div>
<div id="S22.SS1.SSS1.p4" class="ltx_para ltx_noindent">
<p id="S22.SS1.SSS1.p4.1" class="ltx_p">One can formally write down an equivariant Morse flow category <math id="S22.SS1.SSS1.p4.m1" class="ltx_Math" alttext="{\mathbb{E}}" display="inline" intent=":literal"><semantics><mi>𝔼</mi><annotation encoding="application/x-tex">{\mathbb{E}}</annotation></semantics></math> as follows. The set of objects <math id="S22.SS1.SSS1.p4.m2" class="ltx_Math" alttext="{\rm Ob}{\mathbb{E}}" display="inline" intent=":literal"><semantics><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi></mrow><annotation encoding="application/x-tex">{\rm Ob}{\mathbb{E}}</annotation></semantics></math> is the set of critical points of <math id="S22.SS1.SSS1.p4.m3" class="ltx_Math" alttext="f^{\mathbb{E}}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mi>𝔼</mi></msup><annotation encoding="application/x-tex">f^{\mathbb{E}}</annotation></semantics></math> on <math id="S22.SS1.SSS1.p4.m4" class="ltx_Math" alttext="\widehat{S}^{\infty}_{\mathbb{R}}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi>ℝ</mi><mi mathvariant="normal">∞</mi></msubsup><annotation encoding="application/x-tex">\widehat{S}^{\infty}_{\mathbb{R}}</annotation></semantics></math>. Between <math id="S22.SS1.SSS1.p4.m5" class="ltx_Math" alttext="x,y\in{\rm Ob}{\mathbb{E}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi></mrow></mrow><annotation encoding="application/x-tex">x,y\in{\rm Ob}{\mathbb{E}}</annotation></semantics></math>, one has the morphism space being the compactified moduli space <math id="S22.SS1.SSS1.p4.m6" class="ltx_Math" alttext="M_{xy}^{\mathbb{E}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>𝔼</mi></msubsup><annotation encoding="application/x-tex">M_{xy}^{\mathbb{E}}</annotation></semantics></math> of gradient flow lines from <math id="S22.SS1.SSS1.p4.m7" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> to <math id="S22.SS1.SSS1.p4.m8" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math>. Then this is a flow category enriched in <math id="S22.SS1.SSS1.p4.m9" class="ltx_Math" alttext="\underline{\smash{\bf SMan}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐒𝐌𝐚𝐧</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf SMan}}</annotation></semantics></math>. This flow category satisfies the unobstructedness condition (Definition <a href="#S7.Thmthm1" title="Definition 7.1. ‣ 7.1.1. Unobstructedness ‣ 7.1. Unobstructedness, local finiteness, grading, and orientations ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.1</span></a>) and local finiteness condition (Definition <a href="#S7.Thmthm2" title="Definition 7.2. ‣ 7.1.2. Convergence ‣ 7.1. Unobstructedness, local finiteness, grading, and orientations ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.2</span></a>) with respect to the function <math id="S22.SS1.SSS1.p4.m10" class="ltx_Math" alttext="f^{\mathbb{E}}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mi>𝔼</mi></msup><annotation encoding="application/x-tex">f^{\mathbb{E}}</annotation></semantics></math>.</p>
</div>
<div id="S22.SS1.SSS1.p5" class="ltx_para ltx_noindent">
<p id="S22.SS1.SSS1.p5.1" class="ltx_p">Moreover, the flow category is obviously equivariant with respect to a natural Novikov group <math id="S22.SS1.SSS1.p5.m1" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math> action. Here on <math id="S22.SS1.SSS1.p5.m2" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math> we define both the energy and the index function by</p>
<table id="S22.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex12.m1" class="ltx_Math" alttext="\lambda(n)=\mu(n)=n." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>n</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lambda(n)=\mu(n)=n.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.SS1.SSS1.p5.2" class="ltx_p">The associated Novikov field is</p>
<table id="S22.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex13.m1" class="ltx_Math" alttext="\Lambda_{{\mathbb{F}}_{2}}^{\mathbb{Z}}:={\mathbb{F}}_{2}{(\!(\uptheta)\!)}=\tilde{\bf K}_{2}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝔽</mi><mn>2</mn></msub><mi>ℤ</mi></msubsup><mo>:=</mo><mrow><msub><mi>𝔽</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">θ</mi><mpadded style="width:0.219em;" width="0.219em"><mo stretchy="false">)</mo></mpadded></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mover accent="true"><mi>𝐊</mi><mo>~</mo></mover><mn>2</mn></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Lambda_{{\mathbb{F}}_{2}}^{\mathbb{Z}}:={\mathbb{F}}_{2}{(\!(\uptheta)\!)}=\tilde{\bf K}_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.SS1.SSS1.p5.3" class="ltx_p">The <math id="S22.SS1.SSS1.p5.m3" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>-action on <math id="S22.SS1.SSS1.p5.m4" class="ltx_Math" alttext="{\mathbb{E}}" display="inline" intent=":literal"><semantics><mi>𝔼</mi><annotation encoding="application/x-tex">{\mathbb{E}}</annotation></semantics></math> is induced by the <math id="S22.SS1.SSS1.p5.m5" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>-action on <math id="S22.SS1.SSS1.p5.m6" class="ltx_Math" alttext="\widehat{S}^{\infty}_{\mathbb{R}}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi>ℝ</mi><mi mathvariant="normal">∞</mi></msubsup><annotation encoding="application/x-tex">\widehat{S}^{\infty}_{\mathbb{R}}</annotation></semantics></math></p>
<table id="S22.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex14.m1" class="ltx_Math" alttext="n\cdot(\eta_{l})_{l\in{\mathbb{Z}}}:=(\eta_{l-n})_{l\in{\mathbb{Z}}}" display="block" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>η</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>l</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub></mrow><mo>:=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>η</mi><mrow><mi>l</mi><mo>−</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>l</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub></mrow><annotation encoding="application/x-tex">n\cdot(\eta_{l})_{l\in{\mathbb{Z}}}:=(\eta_{l-n})_{l\in{\mathbb{Z}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.SS1.SSS1.p5.4" class="ltx_p">which satisfies</p>
<table id="S22.EGx71" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S22.Ex15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S22.Ex15.m1" class="ltx_Math" alttext="\displaystyle f^{\mathbb{E}}(n\cdot\eta)=f^{\mathbb{E}}(\eta)+\lambda(n),\ " display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>f</mi><mi>𝔼</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>η</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>f</mi><mi>𝔼</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>η</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle f^{\mathbb{E}}(n\cdot\eta)=f^{\mathbb{E}}(\eta)+\lambda(n),\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S22.Ex15.m2" class="ltx_Math" alttext="\displaystyle\ |n\cdot\eta|=|\eta|+\mu(n)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>η</mi></mrow><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">|</mo><mi>η</mi><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ |n\cdot\eta|=|\eta|+\mu(n).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.SS1.SSS1.p5.5" class="ltx_p">In characteristic <math id="S22.SS1.SSS1.p5.m7" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>, one does not need orientation. Then by the abstract construction of Floer complexes (see Subsection <a href="#S7.SS2" title="7.2. Algebraic structures without symmetry ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.2</span></a> and Proposition <a href="#S7.Thmthm30" title="Proposition 7.30. ‣ 7.4.1. Flow categories and bimodules ‣ 7.4. Algebraic structures with symmetry ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.30</span></a>), one obtains a differential on</p>
<table id="S22.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex16.m1" class="ltx_math_unparsed" alttext="C({\mathbb{E}}):=CM(f^{{\mathbb{E}}})=\Big\{\sum_{i=1}^{\infty}a_{i}w_{i}\ |\ a_{i}\in{\mathbb{F}}_{2},\ w_{i}\in{\rm crit}f^{\mathbb{E}},\ \lim_{i\to\infty}f^{{{\mathbb{E}}}}(w_{i})=+\infty\Big\}" display="block" intent=":literal"><semantics><mrow><mi>C</mi><mrow><mo stretchy="false">(</mo><mi>𝔼</mi><mo stretchy="false">)</mo></mrow><mo>:=</mo><mi>C</mi><mi>M</mi><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mi>𝔼</mi></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover><msub><mi>a</mi><mi>i</mi></msub><msub><mi>w</mi><mi>i</mi></msub><mo fence="false" rspace="0.667em" stretchy="false">|</mo><msub><mi>a</mi><mi>i</mi></msub><mo>∈</mo><msub><mi>𝔽</mi><mn>2</mn></msub><mo rspace="0.667em">,</mo><msub><mi>w</mi><mi>i</mi></msub><mo>∈</mo><mi>crit</mi><msup><mi>f</mi><mi>𝔼</mi></msup><mo rspace="0.389em">,</mo><munder><mo movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>i</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><msup><mi>f</mi><mi>𝔼</mi></msup><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em">+</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">C({\mathbb{E}}):=CM(f^{{\mathbb{E}}})=\Big\{\sum_{i=1}^{\infty}a_{i}w_{i}\ |\ a_{i}\in{\mathbb{F}}_{2},\ w_{i}\in{\rm crit}f^{\mathbb{E}},\ \lim_{i\to\infty}f^{{{\mathbb{E}}}}(w_{i})=+\infty\Big\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.SS1.SSS1.p5.6" class="ltx_p">which is a <math id="S22.SS1.SSS1.p5.m8" class="ltx_Math" alttext="\widetilde{\bf K}_{2}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝐊</mi><mo>~</mo></mover><mn>2</mn></msub><annotation encoding="application/x-tex">\widetilde{\bf K}_{2}</annotation></semantics></math>-module.</p>
</div>
<div id="S22.SS1.SSS1.p6" class="ltx_para ltx_noindent">
<p id="S22.SS1.SSS1.p6.1" class="ltx_p">One can compute the cohomology easily. For between any two critical points of <math id="S22.SS1.SSS1.p6.m1" class="ltx_Math" alttext="f^{\mathbb{E}}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mi>𝔼</mi></msup><annotation encoding="application/x-tex">f^{\mathbb{E}}</annotation></semantics></math> of adjacent indices, there is exactly one gradient trajectory between them. Hence in each degree <math id="S22.SS1.SSS1.p6.m2" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>, <math id="S22.SS1.SSS1.p6.m3" class="ltx_Math" alttext="C^{l}({\mathbb{E}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>C</mi><mi>l</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝔼</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C^{l}({\mathbb{E}})</annotation></semantics></math> is 2-dimensional while the cohomology is trivial.</p>
</div>
<div id="S22.SS1.SSS1.p7" class="ltx_para ltx_noindent">
<p id="S22.SS1.SSS1.p7.1" class="ltx_p">However, this trivial cohomology is not what we need. Notice that the function <math id="S22.SS1.SSS1.p7.m1" class="ltx_Math" alttext="f^{\mathbb{E}}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mi>𝔼</mi></msup><annotation encoding="application/x-tex">f^{\mathbb{E}}</annotation></semantics></math> (as well as the metric) is invariant under the natural <math id="S22.SS1.SSS1.p7.m2" class="ltx_Math" alttext="{\mathbb{Z}}_{2}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">{\mathbb{Z}}_{2}</annotation></semantics></math>-action on <math id="S22.SS1.SSS1.p7.m3" class="ltx_Math" alttext="\widehat{S}_{\mathbb{R}}^{\infty}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi>ℝ</mi><mi mathvariant="normal">∞</mi></msubsup><annotation encoding="application/x-tex">\widehat{S}_{\mathbb{R}}^{\infty}</annotation></semantics></math>. One can consider the <math id="S22.SS1.SSS1.p7.m4" class="ltx_Math" alttext="{\mathbb{Z}}_{2}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">{\mathbb{Z}}_{2}</annotation></semantics></math>-invariant part</p>
<table id="S22.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex17.m1" class="ltx_Math" alttext="C({\mathbb{E}})_{{\mathbb{Z}}_{2}}\subseteq C({\mathbb{E}})" display="block" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>𝔼</mi><mo stretchy="false">)</mo></mrow><msub><mi>ℤ</mi><mn>2</mn></msub></msub></mrow><mo>⊆</mo><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝔼</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C({\mathbb{E}})_{{\mathbb{Z}}_{2}}\subseteq C({\mathbb{E}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.SS1.SSS1.p7.2" class="ltx_p">which is 1-dimensional in each degree. The differential is trivial in characteristic <math id="S22.SS1.SSS1.p7.m5" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>, hence the cohomology is also 1-dimensional. Therefore, one has</p>
<table id="S22.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex18.m1" class="ltx_Math" alttext="H(C({\mathbb{E}})_{{\mathbb{Z}}_{2}})\cong\Lambda_{{\mathbb{F}}_{2}}^{{\mathbb{Z}}}\cong\widetilde{\bf K}_{2}" display="block" intent=":literal"><semantics><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>𝔼</mi><mo stretchy="false">)</mo></mrow><msub><mi>ℤ</mi><mn>2</mn></msub></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝔽</mi><mn>2</mn></msub><mi>ℤ</mi></msubsup><mo>≅</mo><msub><mover accent="true"><mi>𝐊</mi><mo>~</mo></mover><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">H(C({\mathbb{E}})_{{\mathbb{Z}}_{2}})\cong\Lambda_{{\mathbb{F}}_{2}}^{{\mathbb{Z}}}\cong\widetilde{\bf K}_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.SS1.SSS1.p7.3" class="ltx_p">as <math id="S22.SS1.SSS1.p7.m6" class="ltx_Math" alttext="\widetilde{\bf K}_{2}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝐊</mi><mo>~</mo></mover><mn>2</mn></msub><annotation encoding="application/x-tex">\widetilde{\bf K}_{2}</annotation></semantics></math>-modules. Later we will show that the ring structure is also identical to <math id="S22.SS1.SSS1.p7.m7" class="ltx_Math" alttext="\widetilde{\bf K}_{2}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝐊</mi><mo>~</mo></mover><mn>2</mn></msub><annotation encoding="application/x-tex">\widetilde{\bf K}_{2}</annotation></semantics></math>.</p>
</div>
</section>
<section id="S22.SS1.SSS2" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">22.1.2. </span><math id="S22.SS1.SSS2.m1" class="ltx_Math" alttext="{\sf p}&gt;2" display="inline" intent=":literal"><semantics><mrow><mi>𝗉</mi><mo>&gt;</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">{\sf p}&gt;2</annotation></semantics></math> case</h5>

<div id="S22.SS1.SSS2.p1" class="ltx_para ltx_noindent">
<p id="S22.SS1.SSS2.p1.1" class="ltx_p">Consider the complex version of the infinite-dimensional sphere. Denote</p>
<table id="S22.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex19.m1" class="ltx_math_unparsed" alttext="S_{\mathbb{C}}^{\infty}=\Big\{\eta=(\eta_{0},\eta_{1},\ldots)\ |\ \eta_{l}\in{\mathbb{C}},\ \eta_{l}=0\text{ for }\forall l\gg 0,\ \sum_{l=0}^{\infty}|\eta_{l}|^{2}=1\Big\}." display="block" intent=":literal"><semantics><mrow><msubsup><mi>S</mi><mi>ℂ</mi><mi mathvariant="normal">∞</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>η</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>η</mi><mn>0</mn></msub><mo>,</mo><msub><mi>η</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo rspace="0.500em" stretchy="false">)</mo></mrow><mo fence="false" rspace="0.667em" stretchy="false">|</mo><msub><mi>η</mi><mi>l</mi></msub><mo>∈</mo><mi>ℂ</mi><mo rspace="0.667em">,</mo><msub><mi>η</mi><mi>l</mi></msub><mo>=</mo><mn>0</mn><mtext> for </mtext><mo lspace="0.167em" rspace="0.167em">∀</mo><mi>l</mi><mo>≫</mo><mn>0</mn><mo rspace="0.500em">,</mo><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>η</mi><mi>l</mi></msub><msup><mo fence="false" stretchy="false">|</mo><mn>2</mn></msup><mo lspace="0.167em">=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">S_{\mathbb{C}}^{\infty}=\Big\{\eta=(\eta_{0},\eta_{1},\ldots)\ |\ \eta_{l}\in{\mathbb{C}},\ \eta_{l}=0\text{ for }\forall l\gg 0,\ \sum_{l=0}^{\infty}|\eta_{l}|^{2}=1\Big\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.SS1.SSS2.p1.2" class="ltx_p">This is a well-defined CW complex and is the universal <math id="S22.SS1.SSS2.p1.m1" class="ltx_Math" alttext="S^{1}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mn>1</mn></msup><annotation encoding="application/x-tex">S^{1}</annotation></semantics></math>-bundle over <math id="S22.SS1.SSS2.p1.m2" class="ltx_Math" alttext="\mathbb{CP}^{\infty}" display="inline" intent=":literal"><semantics><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi mathvariant="normal">∞</mi></msup></mrow><annotation encoding="application/x-tex">\mathbb{CP}^{\infty}</annotation></semantics></math>, a model for the classifying space of <math id="S22.SS1.SSS2.p1.m3" class="ltx_Math" alttext="U(1)" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">U(1)</annotation></semantics></math>. By regarding <math id="S22.SS1.SSS2.p1.m4" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math> as a subgroup of <math id="S22.SS1.SSS2.p1.m5" class="ltx_Math" alttext="S^{1}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mn>1</mn></msup><annotation encoding="application/x-tex">S^{1}</annotation></semantics></math>, <math id="S22.SS1.SSS2.p1.m6" class="ltx_Math" alttext="S_{\mathbb{C}}^{\infty}" display="inline" intent=":literal"><semantics><msubsup><mi>S</mi><mi>ℂ</mi><mi mathvariant="normal">∞</mi></msubsup><annotation encoding="application/x-tex">S_{\mathbb{C}}^{\infty}</annotation></semantics></math> is also the universal <math id="S22.SS1.SSS2.p1.m7" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-bundle over <math id="S22.SS1.SSS2.p1.m8" class="ltx_Math" alttext="B{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>ℤ</mi><mi>𝗉</mi></msub></mrow><annotation encoding="application/x-tex">B{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>.</p>
</div>
<div id="S22.SS1.SSS2.p2" class="ltx_para ltx_noindent">
<p id="S22.SS1.SSS2.p2.1" class="ltx_p">Now we define the formal negative extension</p>
<table id="S22.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex20.m1" class="ltx_math_unparsed" alttext="\widehat{S}_{\mathbb{C}}^{\infty}:=\Big\{\eta=(\eta_{l})_{l\in{\mathbb{Z}}}\ |\ \eta_{l}\in{\mathbb{C}},\ \eta_{l}=0\text{ for }\forall|l|\gg 0,\ \sum_{l\in{\mathbb{Z}}}|\eta_{l}|^{2}=1\Big\}." display="block" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi>ℂ</mi><mi mathvariant="normal">∞</mi></msubsup><mo>:=</mo><mrow><mo stretchy="false">{</mo><mi>η</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>η</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>l</mi><mo>∈</mo><mi>ℤ</mi></mrow></msub><mo fence="false" rspace="0.667em" stretchy="false">|</mo><msub><mi>η</mi><mi>l</mi></msub><mo>∈</mo><mi>ℂ</mi><mo rspace="0.667em">,</mo><msub><mi>η</mi><mi>l</mi></msub><mo>=</mo><mn>0</mn><mtext> for </mtext><mo lspace="0.167em">∀</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>l</mi><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">≫</mo><mn>0</mn><mo rspace="0.500em">,</mo><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>l</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>η</mi><mi>l</mi></msub><msup><mo fence="false" stretchy="false">|</mo><mn>2</mn></msup><mo lspace="0.167em">=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widehat{S}_{\mathbb{C}}^{\infty}:=\Big\{\eta=(\eta_{l})_{l\in{\mathbb{Z}}}\ |\ \eta_{l}\in{\mathbb{C}},\ \eta_{l}=0\text{ for }\forall|l|\gg 0,\ \sum_{l\in{\mathbb{Z}}}|\eta_{l}|^{2}=1\Big\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.SS1.SSS2.p2.2" class="ltx_p">The <math id="S22.SS1.SSS2.p2.m1" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-action on <math id="S22.SS1.SSS2.p2.m2" class="ltx_Math" alttext="S_{\mathbb{C}}^{\infty}" display="inline" intent=":literal"><semantics><msubsup><mi>S</mi><mi>ℂ</mi><mi mathvariant="normal">∞</mi></msubsup><annotation encoding="application/x-tex">S_{\mathbb{C}}^{\infty}</annotation></semantics></math> extends to <math id="S22.SS1.SSS2.p2.m3" class="ltx_Math" alttext="\widehat{S}_{\mathbb{C}}^{\infty}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi>ℂ</mi><mi mathvariant="normal">∞</mi></msubsup><annotation encoding="application/x-tex">\widehat{S}_{\mathbb{C}}^{\infty}</annotation></semantics></math>. Moreover, there is a free <math id="S22.SS1.SSS2.p2.m4" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>-action on <math id="S22.SS1.SSS2.p2.m5" class="ltx_Math" alttext="\widehat{S}_{\mathbb{C}}^{\infty}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi>ℂ</mi><mi mathvariant="normal">∞</mi></msubsup><annotation encoding="application/x-tex">\widehat{S}_{\mathbb{C}}^{\infty}</annotation></semantics></math> by</p>
<table id="S22.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.E1.m1" class="ltx_Math" alttext="n\cdot(\eta_{l})\mapsto(\eta_{l-n})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><msub><mi>η</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">↦</mo><mrow><mo stretchy="false">(</mo><msub><mi>η</mi><mrow><mi>l</mi><mo>−</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">n\cdot(\eta_{l})\mapsto(\eta_{l-n}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22.1)</span></td></tr></tbody>
</table>
</div>
<div id="S22.SS1.SSS2.p3" class="ltx_para ltx_noindent">
<p id="S22.SS1.SSS2.p3.1" class="ltx_p">Define an <math id="S22.SS1.SSS2.p3.m1" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-invariant function <math id="S22.SS1.SSS2.p3.m2" class="ltx_Math" alttext="f^{{\mathbb{E}}}:\widehat{S}_{\mathbb{C}}^{\infty}\to{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mi>𝔼</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi>ℂ</mi><mi mathvariant="normal">∞</mi></msubsup><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f^{{\mathbb{E}}}:\widehat{S}_{\mathbb{C}}^{\infty}\to{\mathbb{R}}</annotation></semantics></math> by</p>
<table id="S22.E2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.E2.m1" class="ltx_Math" alttext="f^{{\mathbb{E}}}(\eta)=\left(\sum_{l\in{\mathbb{Z}}}l|\eta_{l}|^{2}\right)+\epsilon\sum_{l\in{\mathbb{Z}}}{\rm Re}(\eta_{l}^{{\sf p}})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>f</mi><mi>𝔼</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>η</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>l</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><msub><mi>η</mi><mi>l</mi></msub><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow><mo>+</mo><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>∈</mo><mi>ℤ</mi></mrow></munder><mrow><mi>Re</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>η</mi><mi>l</mi><mi>𝗉</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">f^{{\mathbb{E}}}(\eta)=\left(\sum_{l\in{\mathbb{Z}}}l|\eta_{l}|^{2}\right)+\epsilon\sum_{l\in{\mathbb{Z}}}{\rm Re}(\eta_{l}^{{\sf p}}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22.2)</span></td></tr></tbody>
</table>
<p id="S22.SS1.SSS2.p3.2" class="ltx_p">where <math id="S22.SS1.SSS2.p3.m3" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math> is a sufficiently small positive number. It is a smooth function in the sense that its restriction to each finite truncation is a smooth function. It also respects the <math id="S22.SS1.SSS2.p3.m4" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>-action (<a href="#S22.E1" title="In 22.1.2. 𝗉&gt;2 case ‣ 22.1. An equivariant Morse flow category ‣ 22. Morse Theory on Classifying Spaces ‣ Part IV EQUIVARIANT FLOER THEORY AND STEENROD OPERATIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22.1</span></a>) in the following way:</p>
<table id="S22.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex21.m1" class="ltx_Math" alttext="f^{{\mathbb{E}}}(n\cdot\eta)=f^{{\mathbb{E}}}(\eta)+n." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>f</mi><mi>𝔼</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>η</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>f</mi><mi>𝔼</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>η</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>n</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f^{{\mathbb{E}}}(n\cdot\eta)=f^{{\mathbb{E}}}(\eta)+n.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S22.SS1.SSS2.p4" class="ltx_para ltx_noindent">
<p id="S22.SS1.SSS2.p4.1" class="ltx_p">If we set <math id="S22.SS1.SSS2.p4.m1" class="ltx_Math" alttext="\epsilon=0" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon=0</annotation></semantics></math>, <math id="S22.SS1.SSS2.p4.m2" class="ltx_Math" alttext="f^{{\mathbb{E}}}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mi>𝔼</mi></msup><annotation encoding="application/x-tex">f^{{\mathbb{E}}}</annotation></semantics></math> is a Morse–Bott function with critical submanifolds being the circles</p>
<table id="S22.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex22.m1" class="ltx_Math" alttext="S_{l}^{1}=\{\eta\in S^{\infty}\ |\ |\eta_{l}|=1\}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>S</mi><mi>l</mi><mn>1</mn></msubsup><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>η</mi><mo>∈</mo><msup><mi>S</mi><mi mathvariant="normal">∞</mi></msup></mrow><mo lspace="0em" rspace="0.500em">|</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>η</mi><mi>l</mi></msub><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">S_{l}^{1}=\{\eta\in S^{\infty}\ |\ |\eta_{l}|=1\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.SS1.SSS2.p4.2" class="ltx_p">After turning on <math id="S22.SS1.SSS2.p4.m3" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>, the circle <math id="S22.SS1.SSS2.p4.m4" class="ltx_Math" alttext="S_{l}^{1}" display="inline" intent=":literal"><semantics><msubsup><mi>S</mi><mi>l</mi><mn>1</mn></msubsup><annotation encoding="application/x-tex">S_{l}^{1}</annotation></semantics></math> splits into nondegenerate critical points</p>
<table id="S22.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex23.m1" class="ltx_Math" alttext="w_{2l}^{0},\ldots,w_{2l}^{{\sf p}-1},\ w_{2l+1}^{0},\ldots,w_{2l+1}^{{\sf p}-1}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>w</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mn>0</mn></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>w</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mrow><mi>𝗉</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo rspace="0.667em">,</mo><msubsup><mi>w</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>+</mo><mn>1</mn></mrow><mn>0</mn></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>w</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>+</mo><mn>1</mn></mrow><mrow><mi>𝗉</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><annotation encoding="application/x-tex">w_{2l}^{0},\ldots,w_{2l}^{{\sf p}-1},\ w_{2l+1}^{0},\ldots,w_{2l+1}^{{\sf p}-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.SS1.SSS2.p4.3" class="ltx_p">where the subindices indicate the number of positive eigenvalues of the Hessian. One can explicitly write down the coordinates of critical points. For the ones with even degrees, we have</p>
<table id="S22.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex24.m1" class="ltx_math_unparsed" alttext="w_{2l}^{0}=(0,\ldots,0,1,0,\ldots),\ w_{2l}^{s}=\tau^{s}w_{2l}^{0},\ s=1,\ldots,{\sf p}-1," display="block" intent=":literal"><semantics><mrow><msubsup><mi>w</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mn>0</mn></msubsup><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.667em">,</mo><msubsup><mi>w</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mi>s</mi></msubsup><mo>=</mo><msup><mi>τ</mi><mi>s</mi></msup><msubsup><mi>w</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mn>0</mn></msubsup><mo rspace="0.667em">,</mo><mi>s</mi><mo>=</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>𝗉</mi><mo>−</mo><mn>1</mn><mo>,</mo></mrow><annotation encoding="application/x-tex">w_{2l}^{0}=(0,\ldots,0,1,0,\ldots),\ w_{2l}^{s}=\tau^{s}w_{2l}^{0},\ s=1,\ldots,{\sf p}-1,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.SS1.SSS2.p4.4" class="ltx_p">where the only nonzero coordinate of <math id="S22.SS1.SSS2.p4.m5" class="ltx_Math" alttext="w_{2l}^{0}" display="inline" intent=":literal"><semantics><msubsup><mi>w</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mn>0</mn></msubsup><annotation encoding="application/x-tex">w_{2l}^{0}</annotation></semantics></math> is the <math id="S22.SS1.SSS2.p4.m6" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>-th one and <math id="S22.SS1.SSS2.p4.m7" class="ltx_Math" alttext="\tau=e^{\frac{2\pi{\bf i}}{{\sf p}}}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>=</mo><msup><mi>e</mi><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐢</mi></mrow><mi>𝗉</mi></mfrac></msup></mrow><annotation encoding="application/x-tex">\tau=e^{\frac{2\pi{\bf i}}{{\sf p}}}</annotation></semantics></math> is the generator of <math id="S22.SS1.SSS2.p4.m8" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>. For the ones with odd degrees, we have</p>
<table id="S22.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex25.m1" class="ltx_math_unparsed" alttext="w_{2l+1}^{0}=(0,\ldots,0,e^{\frac{\pi{\bf i}}{{\sf p}}},0,\ldots,0),\ w_{2l+1}^{s}=\tau^{s}w_{2l+1}^{0},\ s=1,\ldots,{\sf p}-1." display="block" intent=":literal"><semantics><mrow><msubsup><mi>w</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>+</mo><mn>1</mn></mrow><mn>0</mn></msubsup><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn><mo>,</mo><msup><mi>e</mi><mfrac><mrow><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐢</mi></mrow><mi>𝗉</mi></mfrac></msup><mo>,</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo rspace="0.667em">,</mo><msubsup><mi>w</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>+</mo><mn>1</mn></mrow><mi>s</mi></msubsup><mo>=</mo><msup><mi>τ</mi><mi>s</mi></msup><msubsup><mi>w</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>+</mo><mn>1</mn></mrow><mn>0</mn></msubsup><mo rspace="0.667em">,</mo><mi>s</mi><mo>=</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>𝗉</mi><mo>−</mo><mn>1</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">w_{2l+1}^{0}=(0,\ldots,0,e^{\frac{\pi{\bf i}}{{\sf p}}},0,\ldots,0),\ w_{2l+1}^{s}=\tau^{s}w_{2l+1}^{0},\ s=1,\ldots,{\sf p}-1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.SS1.SSS2.p4.5" class="ltx_p">If we define the degree of <math id="S22.SS1.SSS2.p4.m9" class="ltx_Math" alttext="w_{k}^{m}" display="inline" intent=":literal"><semantics><msubsup><mi>w</mi><mi>k</mi><mi>m</mi></msubsup><annotation encoding="application/x-tex">w_{k}^{m}</annotation></semantics></math> be <math id="S22.SS1.SSS2.p4.m10" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, then the action by <math id="S22.SS1.SSS2.p4.m11" class="ltx_Math" alttext="n\in{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">n\in{\mathbb{Z}}</annotation></semantics></math> in (<a href="#S22.E1" title="In 22.1.2. 𝗉&gt;2 case ‣ 22.1. An equivariant Morse flow category ‣ 22. Morse Theory on Classifying Spaces ‣ Part IV EQUIVARIANT FLOER THEORY AND STEENROD OPERATIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22.1</span></a>) shifts the grading by <math id="S22.SS1.SSS2.p4.m12" class="ltx_Math" alttext="2n" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">2n</annotation></semantics></math>.</p>
</div>
<div id="S22.Thmthm1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S22.Thmthm1.2" class="ltx_text ltx_font_bold">Lemma 22.1</span></span><span id="S22.Thmthm1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S22.Thmthm1.p1" class="ltx_para ltx_noindent">
<p id="S22.Thmthm1.p1.1" class="ltx_p"><span id="S22.Thmthm1.p1.1.1" class="ltx_text ltx_font_italic">There exists a Riemannian metric <math id="S22.Thmthm1.p1.m1" class="ltx_Math" alttext="g^{{\mathbb{E}}}" display="inline" intent=":literal"><semantics><msup><mi>g</mi><mi>𝔼</mi></msup><annotation encoding="application/x-tex">g^{{\mathbb{E}}}</annotation></semantics></math> on <math id="S22.Thmthm1.p1.m2" class="ltx_Math" alttext="\widehat{S}_{\mathbb{C}}^{\infty}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi>ℂ</mi><mi mathvariant="normal">∞</mi></msubsup><annotation encoding="application/x-tex">\widehat{S}_{\mathbb{C}}^{\infty}</annotation></semantics></math> satisfying the following conditions.</span></p>
<ol id="S22.I1" class="ltx_enumerate">
<li id="S22.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S22.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="S22.I1.i1.p1.1" class="ltx_p"><math id="S22.I1.i1.p1.m1" class="ltx_Math" alttext="g^{{\mathbb{E}}}" display="inline" intent=":literal"><semantics><msup><mi>g</mi><mi>𝔼</mi></msup><annotation encoding="application/x-tex">g^{{\mathbb{E}}}</annotation></semantics></math><span id="S22.I1.i1.p1.1.1" class="ltx_text ltx_font_italic"> is </span><math id="S22.I1.i1.p1.m2" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math><span id="S22.I1.i1.p1.1.2" class="ltx_text ltx_font_italic">-invariant and invariant under the shift map (</span><a href="#S22.E1" title="In 22.1.2. 𝗉&gt;2 case ‣ 22.1. An equivariant Morse flow category ‣ 22. Morse Theory on Classifying Spaces ‣ Part IV EQUIVARIANT FLOER THEORY AND STEENROD OPERATIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">22.1</span></a><span id="S22.I1.i1.p1.1.3" class="ltx_text ltx_font_italic">).</span></p>
</div></li>
<li id="S22.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S22.I1.i2.p1" class="ltx_para ltx_noindent">
<p id="S22.I1.i2.p1.1" class="ltx_p"><math id="S22.I1.i2.p1.m1" class="ltx_Math" alttext="(f^{{\mathbb{E}}},g^{{\mathbb{E}}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mi>𝔼</mi></msup><mo>,</mo><msup><mi>g</mi><mi>𝔼</mi></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(f^{{\mathbb{E}}},g^{{\mathbb{E}}})</annotation></semantics></math><span id="S22.I1.i2.p1.1.1" class="ltx_text ltx_font_italic"> is Morse–Smale (when restricted to any finite truncation of </span><math id="S22.I1.i2.p1.m2" class="ltx_Math" alttext="\widehat{S}_{\mathbb{C}}^{\infty}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi>ℂ</mi><mi mathvariant="normal">∞</mi></msubsup><annotation encoding="application/x-tex">\widehat{S}_{\mathbb{C}}^{\infty}</annotation></semantics></math><span id="S22.I1.i2.p1.1.2" class="ltx_text ltx_font_italic">).</span></p>
</div></li>
<li id="S22.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S22.I1.i3.p1" class="ltx_para">
<p id="S22.I1.i3.p1.1" class="ltx_p"><span id="S22.I1.i3.p1.1.1" class="ltx_text ltx_font_italic">If we consider the Morse complex associated to </span><math id="S22.I1.i3.p1.m1" class="ltx_Math" alttext="(f^{{\mathbb{E}}},g^{{\mathbb{E}}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mi>𝔼</mi></msup><mo>,</mo><msup><mi>g</mi><mi>𝔼</mi></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(f^{{\mathbb{E}}},g^{{\mathbb{E}}})</annotation></semantics></math><span id="S22.I1.i3.p1.1.2" class="ltx_text ltx_font_italic"> (restricted to any sufficiently large finite truncation of </span><math id="S22.I1.i3.p1.m2" class="ltx_Math" alttext="\widehat{S}_{\mathbb{C}}^{\infty}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi>ℂ</mi><mi mathvariant="normal">∞</mi></msubsup><annotation encoding="application/x-tex">\widehat{S}_{\mathbb{C}}^{\infty}</annotation></semantics></math><span id="S22.I1.i3.p1.1.3" class="ltx_text ltx_font_italic">), then the Morse differential, in terms of generators, is</span></p>
<table id="S22.EGx72" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S22.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S22.Ex26.m1" class="ltx_Math" alttext="\displaystyle\ d(w_{2l}^{i})=w_{2l+1}^{i}-w_{2l+1}^{i+1},\ " display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>w</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>w</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>+</mo><mn>1</mn></mrow><mi>i</mi></msubsup><mo>−</mo><msubsup><mi>w</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>+</mo><mn>1</mn></mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msubsup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ d(w_{2l}^{i})=w_{2l+1}^{i}-w_{2l+1}^{i+1},\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S22.Ex26.m2" class="ltx_Math" alttext="\displaystyle\ d(w_{2l-1}^{i})=w_{2l}^{0}+\cdots+w_{2l}^{{\sf p}-1}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>w</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>−</mo><mn>1</mn></mrow><mi>i</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>w</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mn>0</mn></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mi>w</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mrow><mi>𝗉</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ d(w_{2l-1}^{i})=w_{2l}^{0}+\cdots+w_{2l}^{{\sf p}-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
</div>
</div>
<div id="S22.SS1.SSS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S22.SS1.SSS2.p5" class="ltx_para">
<p id="S22.SS1.SSS2.p5.1" class="ltx_p"><span id="S22.SS1.SSS2.p5.1.1" class="ltx_text">See <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib47" title="" class="ltx_ref">62</a>, Section 4]</cite> which treated the case on <math id="S22.SS1.SSS2.p5.m1" class="ltx_Math" alttext="S_{\mathbb{C}}^{\infty}" display="inline" intent=":literal"><semantics><msubsup><mi>S</mi><mi>ℂ</mi><mi mathvariant="normal">∞</mi></msubsup><annotation encoding="application/x-tex">S_{\mathbb{C}}^{\infty}</annotation></semantics></math>. One can then use the <math id="S22.SS1.SSS2.p5.m2" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>-action to extend the metric to the negative part of <math id="S22.SS1.SSS2.p5.m3" class="ltx_Math" alttext="\widehat{S}_{\mathbb{C}}^{\infty}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi>ℂ</mi><mi mathvariant="normal">∞</mi></msubsup><annotation encoding="application/x-tex">\widehat{S}_{\mathbb{C}}^{\infty}</annotation></semantics></math>. The expression of the differential can also be found in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib4" title="" class="ltx_ref">59</a>, Section 2]</cite>, and we refer the reader to <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib2" title="" class="ltx_ref">12</a>, Appendix A]</cite> for a comparison between the Morse model and the cellular model used in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib4" title="" class="ltx_ref">59</a>]</cite>.
∎</span></p>
</div>
</div>
<div id="S22.SS1.SSS2.p6" class="ltx_para ltx_noindent">
<p id="S22.SS1.SSS2.p6.1" class="ltx_p">Therefore, one can define a flow category <math id="S22.SS1.SSS2.p6.m1" class="ltx_Math" alttext="{{\mathbb{E}}}" display="inline" intent=":literal"><semantics><mi>𝔼</mi><annotation encoding="application/x-tex">{{\mathbb{E}}}</annotation></semantics></math> whose objects are critical points of <math id="S22.SS1.SSS2.p6.m2" class="ltx_Math" alttext="f^{{\mathbb{E}}}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mi>𝔼</mi></msup><annotation encoding="application/x-tex">f^{{\mathbb{E}}}</annotation></semantics></math> and whose morphism spaces are the moduli space of (broken) trajectories between critical points. One can make <math id="S22.SS1.SSS2.p6.m3" class="ltx_Math" alttext="{{\mathbb{E}}}" display="inline" intent=":literal"><semantics><mi>𝔼</mi><annotation encoding="application/x-tex">{{\mathbb{E}}}</annotation></semantics></math> a <math id="S22.SS1.SSS2.p6.m4" class="ltx_Math" alttext="{\mathbb{Z}}\rtimes{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><mrow><mi>ℤ</mi><mo lspace="0.222em" rspace="0.222em">⋊</mo><msub><mi>ℤ</mi><mi>𝗉</mi></msub></mrow><annotation encoding="application/x-tex">{\mathbb{Z}}\rtimes{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-equivariant Novikov flow category. Indeed, define</p>
<table id="S22.EGx73" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S22.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S22.Ex27.m1" class="ltx_Math" alttext="\displaystyle\ \lambda:{\mathbb{Z}}\to{\mathbb{R}},\ \lambda(a)=a,\ " display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>λ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ℤ</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>a</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ \lambda:{\mathbb{Z}}\to{\mathbb{R}},\ \lambda(a)=a,\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S22.Ex27.m2" class="ltx_Math" alttext="\displaystyle\ \mu:{\mathbb{Z}}\to{\mathbb{Z}},\ \mu(a)=2a." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>μ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ℤ</mi><mo stretchy="false">→</mo><mi>ℤ</mi></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ \mu:{\mathbb{Z}}\to{\mathbb{Z}},\ \mu(a)=2a.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.SS1.SSS2.p6.2" class="ltx_p">They are <math id="S22.SS1.SSS2.p6.m5" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-invariant. Hence the triple <math id="S22.SS1.SSS2.p6.m6" class="ltx_Math" alttext="({{\mathbb{Z}}_{\sf p}}\times{\mathbb{Z}},\lambda,\mu)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>ℤ</mi></mrow><mo>,</mo><mi>λ</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({{\mathbb{Z}}_{\sf p}}\times{\mathbb{Z}},\lambda,\mu)</annotation></semantics></math> is a Novikov group (Definition <a href="#S7.Thmthm21" title="Definition 7.21 (Novikov groups). ‣ 7.3.1. Twisted Novikov groups ‣ 7.3. Symmetries on flow categories, multimodules, and homotopies ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.21</span></a>). Next, one can make the Morse flow category <math id="S22.SS1.SSS2.p6.m7" class="ltx_Math" alttext="{{\mathbb{E}}}" display="inline" intent=":literal"><semantics><mi>𝔼</mi><annotation encoding="application/x-tex">{{\mathbb{E}}}</annotation></semantics></math> associated to <math id="S22.SS1.SSS2.p6.m8" class="ltx_Math" alttext="(f^{{\mathbb{E}}},g^{{\mathbb{E}}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mi>𝔼</mi></msup><mo>,</mo><msup><mi>g</mi><mi>𝔼</mi></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(f^{{\mathbb{E}}},g^{{\mathbb{E}}})</annotation></semantics></math> a <math id="S22.SS1.SSS2.p6.m9" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}\times{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}\times{\mathbb{Z}}</annotation></semantics></math>-equivariant Novikov flow category. Define the action and grading by</p>
<table id="S22.EGx74" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S22.Ex28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S22.Ex28.m1" class="ltx_Math" alttext="\displaystyle\ {\mathcal{A}}(p)=f^{{\mathbb{E}}}(p),\ " display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>f</mi><mi>𝔼</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ {\mathcal{A}}(p)=f^{{\mathbb{E}}}(p),\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S22.Ex28.m2" class="ltx_Math" alttext="\displaystyle\ |w_{k}^{s}|=k." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><msubsup><mi>w</mi><mi>k</mi><mi>s</mi></msubsup><mo stretchy="false">|</mo></mrow><mo>=</mo><mi>k</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ |w_{k}^{s}|=k.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.SS1.SSS2.p6.3" class="ltx_p">Then one can see</p>
<table id="S22.EGx75" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S22.Ex29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S22.Ex29.m1" class="ltx_Math" alttext="\displaystyle\ {\mathcal{A}}(ap)=f^{{{\mathbb{E}}}}(p)+\lambda(a),\ " display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>f</mi><mi>𝔼</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ {\mathcal{A}}(ap)=f^{{{\mathbb{E}}}}(p)+\lambda(a),\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S22.Ex29.m2" class="ltx_Math" alttext="\displaystyle\ |ap|=|p|+\mu(a)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">|</mo><mi>p</mi><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ |ap|=|p|+\mu(a).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.SS1.SSS2.p6.4" class="ltx_p">Then, by the general construction of complexes in Section <a href="#S7" title="7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>, there is an associated <math id="S22.SS1.SSS2.p6.m10" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>-graded complex</p>
<table id="S22.Ex30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex30.m1" class="ltx_math_unparsed" alttext="C({\mathbb{E}}):=CM(f^{{\mathbb{E}}})=\Big\{\sum_{i=1}^{\infty}a_{i}w_{i}\ |\ a_{i}\in{\bf F}_{\sf p},\ w_{i}\in{\rm crit}f^{{\mathbb{E}}},\ \lim_{i\to\infty}{\mathcal{A}}(w_{i})=+\infty\Big\}," display="block" intent=":literal"><semantics><mrow><mi>C</mi><mrow><mo stretchy="false">(</mo><mi>𝔼</mi><mo stretchy="false">)</mo></mrow><mo>:=</mo><mi>C</mi><mi>M</mi><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mi>𝔼</mi></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover><msub><mi>a</mi><mi>i</mi></msub><msub><mi>w</mi><mi>i</mi></msub><mo fence="false" rspace="0.667em" stretchy="false">|</mo><msub><mi>a</mi><mi>i</mi></msub><mo>∈</mo><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mo rspace="0.667em">,</mo><msub><mi>w</mi><mi>i</mi></msub><mo>∈</mo><mi>crit</mi><msup><mi>f</mi><mi>𝔼</mi></msup><mo rspace="0.389em">,</mo><munder><mo movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>i</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em">+</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">}</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">C({\mathbb{E}}):=CM(f^{{\mathbb{E}}})=\Big\{\sum_{i=1}^{\infty}a_{i}w_{i}\ |\ a_{i}\in{\bf F}_{\sf p},\ w_{i}\in{\rm crit}f^{{\mathbb{E}}},\ \lim_{i\to\infty}{\mathcal{A}}(w_{i})=+\infty\Big\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.SS1.SSS2.p6.5" class="ltx_p">which is a graded module over <math id="S22.SS1.SSS2.p6.m11" class="ltx_Math" alttext="\Lambda_{{\bf F}_{\sf p}}^{\mathbb{Z}}\cong{\bf K}_{\sf p}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mi>ℤ</mi></msubsup><mo>≅</mo><msub><mi>𝐊</mi><mi>𝗉</mi></msub></mrow><annotation encoding="application/x-tex">\Lambda_{{\bf F}_{\sf p}}^{\mathbb{Z}}\cong{\bf K}_{\sf p}</annotation></semantics></math>.</p>
</div>
<div id="S22.SS1.SSS2.p7" class="ltx_para ltx_noindent">
<p id="S22.SS1.SSS2.p7.1" class="ltx_p">One can compute the chain complex easily from Lemma <a href="#S22.Thmthm1" title="Lemma 22.1. ‣ 22.1.2. 𝗉&gt;2 case ‣ 22.1. An equivariant Morse flow category ‣ 22. Morse Theory on Classifying Spaces ‣ Part IV EQUIVARIANT FLOER THEORY AND STEENROD OPERATIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22.1</span></a>. One can see that the total cohomology of <math id="S22.SS1.SSS2.p7.m1" class="ltx_Math" alttext="C({\mathbb{E}})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝔼</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C({\mathbb{E}})</annotation></semantics></math> is trivial. If we consider the <math id="S22.SS1.SSS2.p7.m2" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-invariant part, then in degree <math id="S22.SS1.SSS2.p7.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, one has</p>
<table id="S22.Ex31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex31.m1" class="ltx_Math" alttext="C^{k}({{\mathbb{E}}})_{{{\mathbb{Z}}_{\sf p}}}={\bf F}_{\sf p}\langle w_{k}^{0}+\cdots+w_{k}^{{\sf p}-1}\rangle" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>C</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>𝔼</mi><mo stretchy="false">)</mo></mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub></mrow><mo>=</mo><mrow><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msubsup><mi>w</mi><mi>k</mi><mn>0</mn></msubsup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msubsup><mi>w</mi><mi>k</mi><mrow><mi>𝗉</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C^{k}({{\mathbb{E}}})_{{{\mathbb{Z}}_{\sf p}}}={\bf F}_{\sf p}\langle w_{k}^{0}+\cdots+w_{k}^{{\sf p}-1}\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.SS1.SSS2.p7.2" class="ltx_p">and the differential is trivial in characteristic <math id="S22.SS1.SSS2.p7.m4" class="ltx_Math" alttext="{\sf p}" display="inline" intent=":literal"><semantics><mi>𝗉</mi><annotation encoding="application/x-tex">{\sf p}</annotation></semantics></math>. Hence the cohomology of the <math id="S22.SS1.SSS2.p7.m5" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-fixed part is identified with</p>
<table id="S22.Ex32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex32.m1" class="ltx_Math" alttext="H(C({\mathbb{E}})_{{{\mathbb{Z}}_{\sf p}}})\cong\widetilde{\bf K}_{\sf p}" display="block" intent=":literal"><semantics><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>𝔼</mi><mo stretchy="false">)</mo></mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><msub><mover accent="true"><mi>𝐊</mi><mo>~</mo></mover><mi>𝗉</mi></msub></mrow><annotation encoding="application/x-tex">H(C({\mathbb{E}})_{{{\mathbb{Z}}_{\sf p}}})\cong\widetilde{\bf K}_{\sf p}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.SS1.SSS2.p7.3" class="ltx_p">as <math id="S22.SS1.SSS2.p7.m6" class="ltx_Math" alttext="{\bf K}_{\sf p}" display="inline" intent=":literal"><semantics><msub><mi>𝐊</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{\bf K}_{\sf p}</annotation></semantics></math>-modules. We will identify below its multiplicative structure using Morse flow trees.</p>
</div>
</section>
<section id="S22.SS1.SSS3" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">22.1.3. </span>Equivariant cohomology of free orbits</h5>

<div id="S22.SS1.SSS3.p1" class="ltx_para ltx_noindent">
<p id="S22.SS1.SSS3.p1.1" class="ltx_p">We consider a simple case of equivariant localization. Let <math id="S22.SS1.SSS3.p1.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> be a finite set equipped with a <math id="S22.SS1.SSS3.p1.m2" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-action. Then one has a trivial product <math id="S22.SS1.SSS3.p1.m3" class="ltx_Math" alttext="A\times{\mathbb{E}}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝔼</mi></mrow><annotation encoding="application/x-tex">A\times{\mathbb{E}}</annotation></semantics></math> as a flow category whose object set is <math id="S22.SS1.SSS3.p1.m4" class="ltx_Math" alttext="A\times{\rm Ob}{\mathbb{E}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>A</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>Ob</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi></mrow><annotation encoding="application/x-tex">A\times{\rm Ob}{\mathbb{E}}</annotation></semantics></math>. Then one can form the complex</p>
<table id="S22.Ex33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex33.m1" class="ltx_Math" alttext="C(A\times{\mathbb{E}}):=\bigoplus_{\alpha\in A}C({\mathbb{E}})" display="block" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝔼</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">:=</mo><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mi>α</mi><mo>∈</mo><mi>A</mi></mrow></munder><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝔼</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">C(A\times{\mathbb{E}}):=\bigoplus_{\alpha\in A}C({\mathbb{E}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.SS1.SSS3.p1.2" class="ltx_p">which has a <math id="S22.SS1.SSS3.p1.m5" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-action.</p>
</div>
<div id="S22.Thmthm2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S22.Thmthm2.2" class="ltx_text ltx_font_bold">Lemma 22.2</span></span><span id="S22.Thmthm2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S22.Thmthm2.p1" class="ltx_para ltx_noindent">
<p id="S22.Thmthm2.p1.1" class="ltx_p"><span id="S22.Thmthm2.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S22.Thmthm2.p1.m1" class="ltx_Math" alttext="A_{{{\mathbb{Z}}_{\sf p}}}\subseteq A" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo>⊆</mo><mi>A</mi></mrow><annotation encoding="application/x-tex">A_{{{\mathbb{Z}}_{\sf p}}}\subseteq A</annotation></semantics></math> be the subset of <math id="S22.Thmthm2.p1.m2" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-fixed points. Then</span></p>
<table id="S22.Ex34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex34.m1" class="ltx_Math" alttext="H(C(A\times{\mathbb{E}})_{{{\mathbb{Z}}_{\sf p}}})\cong\widetilde{\bf K}_{\sf p}^{A_{{{\mathbb{Z}}_{\sf p}}}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝔼</mi></mrow><mo stretchy="false">)</mo></mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><msubsup><mover accent="true"><mi>𝐊</mi><mo>~</mo></mover><mi>𝗉</mi><msub><mi>A</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub></msubsup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H(C(A\times{\mathbb{E}})_{{{\mathbb{Z}}_{\sf p}}})\cong\widetilde{\bf K}_{\sf p}^{A_{{{\mathbb{Z}}_{\sf p}}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S22.SS1.SSS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S22.SS1.SSS3.p2" class="ltx_para">
<p id="S22.SS1.SSS3.p2.1" class="ltx_p"><span id="S22.SS1.SSS3.p2.1.1" class="ltx_text">One only needs to consider the cases when <math id="S22.SS1.SSS3.p2.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> contains a single element and when <math id="S22.SS1.SSS3.p2.m2" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> is a <math id="S22.SS1.SSS3.p2.m3" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-torsor. In the former case, the cohomology is <math id="S22.SS1.SSS3.p2.m4" class="ltx_Math" alttext="\widetilde{\bf K}_{\sf p}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝐊</mi><mo>~</mo></mover><mi>𝗉</mi></msub><annotation encoding="application/x-tex">\widetilde{\bf K}_{\sf p}</annotation></semantics></math>. In the latter case, one can explicitly calculate the differential and show that the cohomology is trivial.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="S22.SS2" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">22.2. </span>Ring structure using Morse model</h4>

<div id="S22.SS2.p1" class="ltx_para ltx_noindent">
<p id="S22.SS2.p1.1" class="ltx_p">We define the Morse-theoretic multiplicative structure on <math id="S22.SS2.p1.m1" class="ltx_Math" alttext="H_{{{\mathbb{Z}}_{\sf p}}}({\rm pt})\cong\widetilde{\bf K}_{\sf p}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>pt</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><msub><mover accent="true"><mi>𝐊</mi><mo>~</mo></mover><mi>𝗉</mi></msub></mrow><annotation encoding="application/x-tex">H_{{{\mathbb{Z}}_{\sf p}}}({\rm pt})\cong\widetilde{\bf K}_{\sf p}</annotation></semantics></math>. In both <math id="S22.SS2.p1.m2" class="ltx_Math" alttext="{\sf p}=2" display="inline" intent=":literal"><semantics><mrow><mi>𝗉</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">{\sf p}=2</annotation></semantics></math> and <math id="S22.SS2.p1.m3" class="ltx_Math" alttext="{\sf p}&gt;2" display="inline" intent=":literal"><semantics><mrow><mi>𝗉</mi><mo>&gt;</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">{\sf p}&gt;2</annotation></semantics></math> cases, we denote by <math id="S22.SS2.p1.m4" class="ltx_Math" alttext="S^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">S^{\infty}</annotation></semantics></math> the real or complex infinite-dimensional sphere and <math id="S22.SS2.p1.m5" class="ltx_Math" alttext="\widehat{S}^{\infty}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">\widehat{S}^{\infty}</annotation></semantics></math> its negative extension.</p>
</div>
<div id="S22.SS2.p2" class="ltx_para ltx_noindent">
<p id="S22.SS2.p2.1" class="ltx_p">Let <math id="S22.SS2.p2.m1" class="ltx_Math" alttext="H_{{{\mathbb{Z}}_{\sf p}}}^{\rm Borel}({\rm pt})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mi>Borel</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>pt</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{{{\mathbb{Z}}_{\sf p}}}^{\rm Borel}({\rm pt})</annotation></semantics></math> be the Borel equivariant cohomology in <math id="S22.SS2.p2.m2" class="ltx_Math" alttext="{\bf F}_{\sf p}" display="inline" intent=":literal"><semantics><msub><mi>𝐅</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{\bf F}_{\sf p}</annotation></semantics></math>-coefficients, which can be obtained from the above Morse model by truncating at the nonnegative levels, i.e., via a Morse flow category on <math id="S22.SS2.p2.m3" class="ltx_Math" alttext="S^{\infty}\subseteq\widehat{S}^{\infty}" display="inline" intent=":literal"><semantics><mrow><msup><mi>S</mi><mi mathvariant="normal">∞</mi></msup><mo>⊆</mo><msup><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi mathvariant="normal">∞</mi></msup></mrow><annotation encoding="application/x-tex">S^{\infty}\subseteq\widehat{S}^{\infty}</annotation></semantics></math>. We will use Morse flow trees in <math id="S22.SS2.p2.m4" class="ltx_Math" alttext="S^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">S^{\infty}</annotation></semantics></math> to define a ring structure on <math id="S22.SS2.p2.m5" class="ltx_Math" alttext="H_{{{\mathbb{Z}}_{\sf p}}}^{\rm Borel}({\rm pt})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mi>Borel</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>pt</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{{{\mathbb{Z}}_{\sf p}}}^{\rm Borel}({\rm pt})</annotation></semantics></math> and then extend to the Tate version.</p>
</div>
<div id="S22.SS2.p3" class="ltx_para ltx_noindent">
<p id="S22.SS2.p3.1" class="ltx_p">Let <math id="S22.SS2.p3.m1" class="ltx_Math" alttext="T_{2,1}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mrow><mn>2</mn><mo>,</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">T_{2,1}</annotation></semantics></math> denote the tree which is the disjoint union of two incoming edges <math id="S22.SS2.p3.m2" class="ltx_math_unparsed" alttext="T_{1}\cong T_{2}\cong(-\infty,0]" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>≅</mo><msub><mi>T</mi><mn>2</mn></msub><mo>≅</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi mathvariant="normal">∞</mi><mo>,</mo><mn>0</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">T_{1}\cong T_{2}\cong(-\infty,0]</annotation></semantics></math> and an outgoing edge <math id="S22.SS2.p3.m3" class="ltx_math_unparsed" alttext="T_{\infty}\cong[0,+\infty)" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi mathvariant="normal">∞</mi></msub><mo>≅</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo rspace="0em">,</mo><mo lspace="0em">+</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T_{\infty}\cong[0,+\infty)</annotation></semantics></math>. Let <math id="S22.SS2.p3.m4" class="ltx_Math" alttext="s\in T_{2,1}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><msub><mi>T</mi><mrow><mn>2</mn><mo>,</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">s\in T_{2,1}</annotation></semantics></math> denote the coordinate on each edge; when there is no ambiguity, <math id="S22.SS2.p3.m5" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> corresponds to a real number. To achieve transversality, we choose a <math id="S22.SS2.p3.m6" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-invariant family of vector fields <math id="S22.SS2.p3.m7" class="ltx_Math" alttext="Y_{s}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mi>s</mi></msub><annotation encoding="application/x-tex">Y_{s}</annotation></semantics></math> on <math id="S22.SS2.p3.m8" class="ltx_Math" alttext="S^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">S^{\infty}</annotation></semantics></math> parametrized by <math id="S22.SS2.p3.m9" class="ltx_Math" alttext="s\in T_{2,1}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><msub><mi>T</mi><mrow><mn>2</mn><mo>,</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">s\in T_{2,1}</annotation></semantics></math></p>
<ol id="S22.I2" class="ltx_enumerate">
<li id="S22.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S22.I2.i1.p1" class="ltx_para ltx_noindent">
<p id="S22.I2.i1.p1.1" class="ltx_p"><math id="S22.I2.i1.p1.m1" class="ltx_Math" alttext="Y(s)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Y</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">Y(s)=0</annotation></semantics></math> when <math id="S22.I2.i1.p1.m2" class="ltx_Math" alttext="|s|\gg 0" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>s</mi><mo stretchy="false">|</mo></mrow><mo>≫</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">|s|\gg 0</annotation></semantics></math>.</p>
</div></li>
<li id="S22.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S22.I2.i2.p1" class="ltx_para">
<p id="S22.I2.i2.p1.1" class="ltx_p">For each finite truncation <math id="S22.I2.i2.p1.m1" class="ltx_Math" alttext="S^{n}\subseteq S^{\infty}" display="inline" intent=":literal"><semantics><mrow><msup><mi>S</mi><mi>n</mi></msup><mo>⊆</mo><msup><mi>S</mi><mi mathvariant="normal">∞</mi></msup></mrow><annotation encoding="application/x-tex">S^{n}\subseteq S^{\infty}</annotation></semantics></math>, <math id="S22.I2.i2.p1.m2" class="ltx_Math" alttext="Y|_{S^{n}}" display="inline" intent=":literal"><semantics><msub><mrow><mi>Y</mi><mo stretchy="false">|</mo></mrow><msup><mi>S</mi><mi>n</mi></msup></msub><annotation encoding="application/x-tex">Y|_{S^{n}}</annotation></semantics></math> is tangent to <math id="S22.I2.i2.p1.m3" class="ltx_Math" alttext="S^{n}\subseteq S^{\infty}" display="inline" intent=":literal"><semantics><mrow><msup><mi>S</mi><mi>n</mi></msup><mo>⊆</mo><msup><mi>S</mi><mi mathvariant="normal">∞</mi></msup></mrow><annotation encoding="application/x-tex">S^{n}\subseteq S^{\infty}</annotation></semantics></math> and <math id="S22.I2.i2.p1.m4" class="ltx_Math" alttext="\nabla Y" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∇</mo><mi>Y</mi></mrow><annotation encoding="application/x-tex">\nabla Y</annotation></semantics></math> is sufficiently small in the normal direction of <math id="S22.I2.i2.p1.m5" class="ltx_Math" alttext="S^{n}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mi>n</mi></msup><annotation encoding="application/x-tex">S^{n}</annotation></semantics></math>.</p>
</div></li>
</ol>
<p id="S22.SS2.p3.2" class="ltx_p">Let <math id="S22.SS2.p3.m10" class="ltx_Math" alttext="Y_{i}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mi>i</mi></msub><annotation encoding="application/x-tex">Y_{i}</annotation></semantics></math> denote the restriction of <math id="S22.SS2.p3.m11" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> to <math id="S22.SS2.p3.m12" class="ltx_Math" alttext="T_{i}\subseteq T_{2,1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>⊆</mo><msub><mi>T</mi><mrow><mn>2</mn><mo>,</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">T_{i}\subseteq T_{2,1}</annotation></semantics></math>. A <math id="S22.SS2.p3.m13" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math><span id="S22.SS2.p3.2.1" class="ltx_text ltx_font_bold">-perturbed flow tree</span> is a triple <math id="S22.SS2.p3.m14" class="ltx_Math" alttext="\eta=(\eta_{1},\eta_{2},\eta_{\infty}):T_{2,1}\to S^{\infty}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>η</mi><mn>1</mn></msub><mo>,</mo><msub><mi>η</mi><mn>2</mn></msub><mo>,</mo><msub><mi>η</mi><mi mathvariant="normal">∞</mi></msub><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mrow><msub><mi>T</mi><mrow><mn>2</mn><mo>,</mo><mn>1</mn></mrow></msub><mo stretchy="false">→</mo><msup><mi>S</mi><mi mathvariant="normal">∞</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\eta=(\eta_{1},\eta_{2},\eta_{\infty}):T_{2,1}\to S^{\infty}</annotation></semantics></math> which solves the equation</p>
<table id="S22.Ex35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex35.m1" class="ltx_Math" alttext="\eta^{\prime}(s)=\nabla f^{{\mathbb{E}}}(\eta(s))+Y_{s}(\eta(s))" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>η</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><msup><mi>f</mi><mi>𝔼</mi></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>Y</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta^{\prime}(s)=\nabla f^{{\mathbb{E}}}(\eta(s))+Y_{s}(\eta(s))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.SS2.p3.3" class="ltx_p">subject to the incidence relation</p>
<table id="S22.Ex36" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex36.m1" class="ltx_Math" alttext="\eta_{1}(0)=\eta_{2}(0)=\eta_{\infty}(0)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>η</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>η</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>η</mi><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\eta_{1}(0)=\eta_{2}(0)=\eta_{\infty}(0).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.SS2.p3.4" class="ltx_p">Each flow tree converges to a triple of critical points of <math id="S22.SS2.p3.m15" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> at <math id="S22.SS2.p3.m16" class="ltx_Math" alttext="\infty" display="inline" intent=":literal"><semantics><mi mathvariant="normal">∞</mi><annotation encoding="application/x-tex">\infty</annotation></semantics></math> of the edges.</p>
</div>
<div id="S22.SS2.p4" class="ltx_para ltx_noindent">
<p id="S22.SS2.p4.1" class="ltx_p">Given a triple of critical points <math id="S22.SS2.p4.m1" class="ltx_Math" alttext="w_{1},w_{2},w_{\infty}\in{\rm crit}(f^{{\mathbb{E}}})\cap S^{\infty}" display="inline" intent=":literal"><semantics><mrow><msub><mi>w</mi><mn>1</mn></msub><mo>,</mo><msub><mi>w</mi><mn>2</mn></msub><mo>,</mo><mrow><msub><mi>w</mi><mi mathvariant="normal">∞</mi></msub><mo>∈</mo><mrow><mrow><mi>crit</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mi>𝔼</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>∩</mo><msup><mi>S</mi><mi mathvariant="normal">∞</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">w_{1},w_{2},w_{\infty}\in{\rm crit}(f^{{\mathbb{E}}})\cap S^{\infty}</annotation></semantics></math>, let <math id="S22.SS2.p4.m2" class="ltx_Math" alttext="S^{n}\subseteq S^{\infty}" display="inline" intent=":literal"><semantics><mrow><msup><mi>S</mi><mi>n</mi></msup><mo>⊆</mo><msup><mi>S</mi><mi mathvariant="normal">∞</mi></msup></mrow><annotation encoding="application/x-tex">S^{n}\subseteq S^{\infty}</annotation></semantics></math> be the smallest truncation which contains all of them. One can see that a flow tree connecting <math id="S22.SS2.p4.m3" class="ltx_Math" alttext="w_{1},w_{2},w_{\infty}" display="inline" intent=":literal"><semantics><mrow><msub><mi>w</mi><mn>1</mn></msub><mo>,</mo><msub><mi>w</mi><mn>2</mn></msub><mo>,</mo><msub><mi>w</mi><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">w_{1},w_{2},w_{\infty}</annotation></semantics></math> is contained in <math id="S22.SS2.p4.m4" class="ltx_Math" alttext="S^{n}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mi>n</mi></msup><annotation encoding="application/x-tex">S^{n}</annotation></semantics></math>. We say that a <math id="S22.SS2.p4.m5" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>-perturbed flow tree is regular for <math id="S22.SS2.p4.m6" class="ltx_Math" alttext="(w_{1},w_{2},w_{\infty})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mn>1</mn></msub><mo>,</mo><msub><mi>w</mi><mn>2</mn></msub><mo>,</mo><msub><mi>w</mi><mi mathvariant="normal">∞</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(w_{1},w_{2},w_{\infty})</annotation></semantics></math> if it is regular as a flow tree contained in <math id="S22.SS2.p4.m7" class="ltx_Math" alttext="S^{n}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mi>n</mi></msup><annotation encoding="application/x-tex">S^{n}</annotation></semantics></math>.<span id="footnote26" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">26</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">26</sup>
                <span class="ltx_tag ltx_tag_note">26</span>
                
                
                
              In fact if it is regular in <math id="footnote26.m1" class="ltx_Math" alttext="S^{n}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mi>n</mi></msup><annotation encoding="application/x-tex">S^{n}</annotation></semantics></math>, then it is regular in any larger truncation.</span></span></span></p>
</div>
<div id="S22.SS2.p5" class="ltx_para ltx_noindent">
<p id="S22.SS2.p5.1" class="ltx_p">For a generic perturbation <math id="S22.SS2.p5.m1" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> and each triple of critical points <math id="S22.SS2.p5.m2" class="ltx_Math" alttext="w_{1},w_{2},w_{\infty}" display="inline" intent=":literal"><semantics><mrow><msub><mi>w</mi><mn>1</mn></msub><mo>,</mo><msub><mi>w</mi><mn>2</mn></msub><mo>,</mo><msub><mi>w</mi><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">w_{1},w_{2},w_{\infty}</annotation></semantics></math>, one obtains a regular moduli space of solutions, whose mod <math id="S22.SS2.p5.m3" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> count induces a <math id="S22.SS2.p5.m4" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-equivariant map</p>
<table id="S22.Ex37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex37.m1" class="ltx_Math" alttext="CM(f^{{\mathbb{E}}}|_{S^{\infty}})\otimes CM(f^{{\mathbb{E}}}|_{S^{\infty}})\to CM(f^{{\mathbb{E}}}|_{S^{\infty}})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><msup><mi>f</mi><mi>𝔼</mi></msup><mo stretchy="false">|</mo></mrow><msup><mi>S</mi><mi mathvariant="normal">∞</mi></msup></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><msup><mi>f</mi><mi>𝔼</mi></msup><mo stretchy="false">|</mo></mrow><msup><mi>S</mi><mi mathvariant="normal">∞</mi></msup></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><msup><mi>f</mi><mi>𝔼</mi></msup><mo stretchy="false">|</mo></mrow><msup><mi>S</mi><mi mathvariant="normal">∞</mi></msup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">CM(f^{{\mathbb{E}}}|_{S^{\infty}})\otimes CM(f^{{\mathbb{E}}}|_{S^{\infty}})\to CM(f^{{\mathbb{E}}}|_{S^{\infty}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.SS2.p5.2" class="ltx_p">Hence after restriction to the <math id="S22.SS2.p5.m5" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-invariant part, one obtains</p>
<table id="S22.Ex38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex38.m1" class="ltx_Math" alttext="H_{{{\mathbb{Z}}_{\sf p}}}^{\rm Borel}({\rm pt})\otimes_{{\bf F}_{\sf p}}H_{{{\mathbb{Z}}_{\sf p}}}^{\rm Borel}({\rm pt})\cong CM(f^{{\mathbb{E}}}|_{S^{\infty}})^{{{\mathbb{Z}}_{\sf p}}}\otimes_{{\bf F}_{\sf p}}CM(f^{{\mathbb{E}}}|_{S^{\infty}})^{{{\mathbb{Z}}_{\sf p}}}\to CM_{{{\mathbb{Z}}_{\sf p}}}(f^{{\mathbb{E}}}|_{S^{\infty}})^{{{\mathbb{Z}}_{\sf p}}}\cong H_{{{\mathbb{Z}}_{\sf p}}}^{\rm Borel}({\rm pt})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mi>Borel</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>pt</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><msub><mo rspace="0.222em">⊗</mo><msub><mi>𝐅</mi><mi>𝗉</mi></msub></msub><mrow><msubsup><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mi>Borel</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>pt</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≅</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mrow><msup><mi>f</mi><mi>𝔼</mi></msup><mo stretchy="false">|</mo></mrow><msup><mi>S</mi><mi mathvariant="normal">∞</mi></msup></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msup></mrow><msub><mo rspace="0.222em">⊗</mo><msub><mi>𝐅</mi><mi>𝗉</mi></msub></msub><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mrow><msup><mi>f</mi><mi>𝔼</mi></msup><mo stretchy="false">|</mo></mrow><msup><mi>S</mi><mi mathvariant="normal">∞</mi></msup></msub><mo stretchy="false">)</mo></mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msup></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mrow><msup><mi>f</mi><mi>𝔼</mi></msup><mo stretchy="false">|</mo></mrow><msup><mi>S</mi><mi mathvariant="normal">∞</mi></msup></msub><mo stretchy="false">)</mo></mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msup></mrow><mo>≅</mo><mrow><msubsup><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mi>Borel</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>pt</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H_{{{\mathbb{Z}}_{\sf p}}}^{\rm Borel}({\rm pt})\otimes_{{\bf F}_{\sf p}}H_{{{\mathbb{Z}}_{\sf p}}}^{\rm Borel}({\rm pt})\cong CM(f^{{\mathbb{E}}}|_{S^{\infty}})^{{{\mathbb{Z}}_{\sf p}}}\otimes_{{\bf F}_{\sf p}}CM(f^{{\mathbb{E}}}|_{S^{\infty}})^{{{\mathbb{Z}}_{\sf p}}}\to CM_{{{\mathbb{Z}}_{\sf p}}}(f^{{\mathbb{E}}}|_{S^{\infty}})^{{{\mathbb{Z}}_{\sf p}}}\cong H_{{{\mathbb{Z}}_{\sf p}}}^{\rm Borel}({\rm pt}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.SS2.p5.3" class="ltx_p">The usual Morse theoretic technique can be used to show that the bilinear map is independent of the choices of <math id="S22.SS2.p5.m6" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>, and satisfies associativity. Hence <math id="S22.SS2.p5.m7" class="ltx_Math" alttext="H_{{{\mathbb{Z}}_{\sf p}}}^{\rm Borel}({\rm pt})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mi>Borel</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>pt</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{{{\mathbb{Z}}_{\sf p}}}^{\rm Borel}({\rm pt})</annotation></semantics></math> is equipped with a structure of a <math id="S22.SS2.p5.m8" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>-graded, associative and supercommutative algebra over <math id="S22.SS2.p5.m9" class="ltx_Math" alttext="{\bf F}_{\sf p}" display="inline" intent=":literal"><semantics><msub><mi>𝐅</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{\bf F}_{\sf p}</annotation></semantics></math>.</p>
</div>
<div id="S22.SS2.p6" class="ltx_para ltx_noindent">
<p id="S22.SS2.p6.1" class="ltx_p">We know for compact manifolds, the ring structure defined by counting Morse flow trees coincides with the ordinary cohomology ring. Applying this fact to any finite truncation <math id="S22.SS2.p6.m1" class="ltx_Math" alttext="S^{n}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mi>n</mi></msup><annotation encoding="application/x-tex">S^{n}</annotation></semantics></math>, one can see the above Morse-theoretic definition of the ring structure coincides with the ordinary one on</p>
<table id="S22.Ex39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S22.Ex39.m1" class="ltx_Math" alttext="H^{\rm Borel}_{{{\mathbb{Z}}_{\sf p}}}({\rm pt})=\left\{\begin{array}[]{ll}{\bf F}_{\sf p}{[\![\uptheta]\!]},&amp;\ {\sf p}=2,\\
{\bf F}_{\sf p}{[\![\mathtt{U}]\!]}\langle\uptheta\rangle,&amp;\ {\sf p}&gt;2\end{array}\right." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mi>Borel</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>pt</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">[</mo><mi mathvariant="normal">θ</mi><mpadded style="width:0.108em;" width="0.108em"><mo stretchy="false">]</mo></mpadded></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>𝗉</mi><mo>=</mo><mn>2</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">[</mo><mi>𝚄</mi><mpadded style="width:0.108em;" width="0.108em"><mo stretchy="false">]</mo></mpadded></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mi mathvariant="normal">θ</mi><mo stretchy="false">⟩</mo></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>𝗉</mi><mo>&gt;</mo><mn>2</mn></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">H^{\rm Borel}_{{{\mathbb{Z}}_{\sf p}}}({\rm pt})=\left\{\begin{array}[]{ll}{\bf F}_{\sf p}{[\![\uptheta]\!]},&amp;\ {\sf p}=2,\\
{\bf F}_{\sf p}{[\![\mathtt{U}]\!]}\langle\uptheta\rangle,&amp;\ {\sf p}&gt;2\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S22.SS2.p6.2" class="ltx_p">By inverting <math id="S22.SS2.p6.m2" class="ltx_Math" alttext="\uptheta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">θ</mi><annotation encoding="application/x-tex">\uptheta</annotation></semantics></math> or <math id="S22.SS2.p6.m3" class="ltx_Math" alttext="\mathtt{U}" display="inline" intent=":literal"><semantics><mi>𝚄</mi><annotation encoding="application/x-tex">\mathtt{U}</annotation></semantics></math>, one obtains a ring structure on the Tate equivariant cohomology of a point, which coincides with the standard one on <math id="S22.SS2.p6.m4" class="ltx_Math" alttext="\widetilde{\bf K}_{\sf p}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝐊</mi><mo>~</mo></mover><mi>𝗉</mi></msub><annotation encoding="application/x-tex">\widetilde{\bf K}_{\sf p}</annotation></semantics></math>.</p>
</div>
<div id="S22.SS2.p7" class="ltx_para ltx_noindent">
<p id="S22.SS2.p7.1" class="ltx_p">Later we will construct cohomology groups which become modules over <math id="S22.SS2.p7.m1" class="ltx_Math" alttext="\widetilde{\bf K}_{\sf p}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝐊</mi><mo>~</mo></mover><mi>𝗉</mi></msub><annotation encoding="application/x-tex">\widetilde{\bf K}_{\sf p}</annotation></semantics></math>. The module structure is always defined via a certain Morse-theoretic construction first as a module over the positive truncation, then extended by inverting the corresponding variable <math id="S22.SS2.p7.m2" class="ltx_Math" alttext="\uptheta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">θ</mi><annotation encoding="application/x-tex">\uptheta</annotation></semantics></math> or <math id="S22.SS2.p7.m3" class="ltx_Math" alttext="\mathtt{U}" display="inline" intent=":literal"><semantics><mi>𝚄</mi><annotation encoding="application/x-tex">\mathtt{U}</annotation></semantics></math>.</p>
</div>
</section>
</section>
<section id="S23" class="ltx_section">
<h3 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">23. </span>Equivariant Morse and Floer Cohomology</h3>

<div id="S23.p1" class="ltx_para ltx_noindent">
<p id="S23.p1.1" class="ltx_p">The purpose of this section is to discuss both an algebraic and Morse-theoretic approach to equivariant cohomology. The former is used for constructing the quasi-Frobenius map (cf. Equation (<a href="#S23.E3" title="In 23.1.1. The algebraic construction ‣ 23.1. Tate Equivariant Cohomology ‣ 23. Equivariant Morse and Floer Cohomology ‣ Part IV EQUIVARIANT FLOER THEORY AND STEENROD OPERATIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23.3</span></a>)) and the latter uses the Morse flow category discussed in the previous section to define the <math id="S23.p1.m1" class="ltx_Math" alttext="\uptheta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">θ</mi><annotation encoding="application/x-tex">\uptheta</annotation></semantics></math>-action on equivariant cohomology.</p>
</div>
<section id="S23.SS1" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">23.1. </span>Tate Equivariant Cohomology</h4>

<section id="S23.SS1.SSS1" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">23.1.1. </span>The algebraic construction</h5>

<div id="S23.SS1.SSS1.p1" class="ltx_para ltx_noindent">
<p id="S23.SS1.SSS1.p1.1" class="ltx_p">Fix a prime <math id="S23.SS1.SSS1.p1.m1" class="ltx_Math" alttext="{\sf p}" display="inline" intent=":literal"><semantics><mi>𝗉</mi><annotation encoding="application/x-tex">{\sf p}</annotation></semantics></math>. The coefficient ring will be <math id="S23.SS1.SSS1.p1.m2" class="ltx_Math" alttext="{\bf F}_{\sf p}" display="inline" intent=":literal"><semantics><msub><mi>𝐅</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{\bf F}_{\sf p}</annotation></semantics></math> unless otherwise declared. Let <math id="S23.SS1.SSS1.p1.m3" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> be a <math id="S23.SS1.SSS1.p1.m4" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-equivariant cochain complex with differential <math id="S23.SS1.SSS1.p1.m5" class="ltx_Math" alttext="d_{D}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi>D</mi></msub><annotation encoding="application/x-tex">d_{D}</annotation></semantics></math>. Let <math id="S23.SS1.SSS1.p1.m6" class="ltx_Math" alttext="\tau:D\to D" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>D</mi><mo stretchy="false">→</mo><mi>D</mi></mrow></mrow><annotation encoding="application/x-tex">\tau:D\to D</annotation></semantics></math> be the action of the generator <math id="S23.SS1.SSS1.p1.m7" class="ltx_Math" alttext="\tau\in{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><msub><mi>ℤ</mi><mi>𝗉</mi></msub></mrow><annotation encoding="application/x-tex">\tau\in{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>. Define cochain complexes of <math id="S23.SS1.SSS1.p1.m8" class="ltx_Math" alttext="{\bf K}_{\sf p}" display="inline" intent=":literal"><semantics><msub><mi>𝐊</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{\bf K}_{\sf p}</annotation></semantics></math>-modules</p>
<table id="S23.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex1.m1" class="ltx_Math" alttext="C_{{{\mathbb{Z}}_{\sf p}}}(D):=D\otimes\widetilde{\bf K}_{\sf p}\cong\left\{\begin{array}[]{ll}D\otimes{\bf F}_{2}{(\!(\uptheta)\!)},&amp;\ {\sf p}=2,\\
D\otimes{\bf F}_{\sf p}{(\!(\mathtt{U})\!)}\langle\uptheta\rangle,&amp;\ {\sf p}&gt;2.\end{array}\right." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mi>D</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mover accent="true"><mi>𝐊</mi><mo>~</mo></mover><mi>𝗉</mi></msub></mrow><mo>≅</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mi>D</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>𝐅</mi><mn>2</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">θ</mi><mpadded style="width:0.219em;" width="0.219em"><mo stretchy="false">)</mo></mpadded></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>𝗉</mi><mo>=</mo><mn>2</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mi>D</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>𝐅</mi><mi>𝗉</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><mi>𝚄</mi><mpadded style="width:0.219em;" width="0.219em"><mo stretchy="false">)</mo></mpadded></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mi mathvariant="normal">θ</mi><mo stretchy="false">⟩</mo></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>𝗉</mi><mo>&gt;</mo><mn>2</mn></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">C_{{{\mathbb{Z}}_{\sf p}}}(D):=D\otimes\widetilde{\bf K}_{\sf p}\cong\left\{\begin{array}[]{ll}D\otimes{\bf F}_{2}{(\!(\uptheta)\!)},&amp;\ {\sf p}=2,\\
D\otimes{\bf F}_{\sf p}{(\!(\mathtt{U})\!)}\langle\uptheta\rangle,&amp;\ {\sf p}&gt;2.\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS1.SSS1.p1.2" class="ltx_p">where the differential <math id="S23.SS1.SSS1.p1.m9" class="ltx_Math" alttext="d_{{{\mathbb{Z}}_{\sf p}}}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><annotation encoding="application/x-tex">d_{{{\mathbb{Z}}_{\sf p}}}</annotation></semantics></math> is defined as follows.</p>
</div>
<div id="S23.SS1.SSS1.p2" class="ltx_para ltx_noindent">
<ol id="S23.I1" class="ltx_enumerate">
<li id="S23.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S23.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="S23.I1.i1.p1.1" class="ltx_p">When <math id="S23.I1.i1.p1.m1" class="ltx_Math" alttext="{\sf p}=2" display="inline" intent=":literal"><semantics><mrow><mi>𝗉</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">{\sf p}=2</annotation></semantics></math>, <math id="S23.I1.i1.p1.m2" class="ltx_Math" alttext="d_{{{\mathbb{Z}}_{\sf p}}}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><annotation encoding="application/x-tex">d_{{{\mathbb{Z}}_{\sf p}}}</annotation></semantics></math> is <math id="S23.I1.i1.p1.m3" class="ltx_Math" alttext="\uptheta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">θ</mi><annotation encoding="application/x-tex">\uptheta</annotation></semantics></math>-linear and is determined by</p>
<table id="S23.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.E1.m1" class="ltx_Math" alttext="d_{{{\mathbb{Z}}_{\sf p}}}(x\otimes\uptheta^{k})=d_{D}(x)\otimes\uptheta^{k}+(1-\tau)(x)\otimes\uptheta^{k+1}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>d</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mi mathvariant="normal">θ</mi><mi>k</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><msub><mi>d</mi><mi>D</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msup><mi mathvariant="normal">θ</mi><mi>k</mi></msup></mrow><mo>+</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msup><mi mathvariant="normal">θ</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">d_{{{\mathbb{Z}}_{\sf p}}}(x\otimes\uptheta^{k})=d_{D}(x)\otimes\uptheta^{k}+(1-\tau)(x)\otimes\uptheta^{k+1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23.1)</span></td></tr></tbody>
</table>
</div></li>
<li id="S23.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S23.I1.i2.p1" class="ltx_para ltx_noindent">
<p id="S23.I1.i2.p1.1" class="ltx_p">When <math id="S23.I1.i2.p1.m1" class="ltx_Math" alttext="{\sf p}&gt;2" display="inline" intent=":literal"><semantics><mrow><mi>𝗉</mi><mo>&gt;</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">{\sf p}&gt;2</annotation></semantics></math>, <math id="S23.I1.i2.p1.m2" class="ltx_Math" alttext="d_{{{\mathbb{Z}}_{\sf p}}}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><annotation encoding="application/x-tex">d_{{{\mathbb{Z}}_{\sf p}}}</annotation></semantics></math> is <math id="S23.I1.i2.p1.m3" class="ltx_Math" alttext="\mathtt{U}" display="inline" intent=":literal"><semantics><mi>𝚄</mi><annotation encoding="application/x-tex">\mathtt{U}</annotation></semantics></math>-linear and is determined by</p>
<table id="S23.E2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.E2.m1" class="ltx_Math" alttext="\begin{split}d_{{\mathbb{Z}}_{\sf p}}(x\otimes 1)&amp;\ =d_{D}(x)\otimes 1+(-1)^{|x|}(1-\tau)(x)\otimes\uptheta,\\
d_{{\mathbb{Z}}_{\sf p}}(x\otimes\uptheta)&amp;\ =d_{D}(x)\otimes\uptheta+(-1)^{|x|}(1+\tau+\cdots+\tau^{p-1})(x)\otimes\mathtt{U}.\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><msub><mi>d</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo lspace="0.778em">=</mo><mrow><mrow><mrow><msub><mi>d</mi><mi>D</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mn>1</mn></mrow><mo>+</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">|</mo><mi>x</mi><mo stretchy="false">|</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi mathvariant="normal">θ</mi></mrow></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><msub><mi>d</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi mathvariant="normal">θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo lspace="0.778em">=</mo><mrow><mrow><mrow><msub><mi>d</mi><mi>D</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi mathvariant="normal">θ</mi></mrow><mo>+</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">|</mo><mi>x</mi><mo stretchy="false">|</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>τ</mi><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msup><mi>τ</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>𝚄</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}d_{{\mathbb{Z}}_{\sf p}}(x\otimes 1)&amp;\ =d_{D}(x)\otimes 1+(-1)^{|x|}(1-\tau)(x)\otimes\uptheta,\\
d_{{\mathbb{Z}}_{\sf p}}(x\otimes\uptheta)&amp;\ =d_{D}(x)\otimes\uptheta+(-1)^{|x|}(1+\tau+\cdots+\tau^{p-1})(x)\otimes\mathtt{U}.\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23.2)</span></td></tr></tbody>
</table>
<p id="S23.I1.i2.p1.2" class="ltx_p">Here <math id="S23.I1.i2.p1.m4" class="ltx_Math" alttext="|x|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi>x</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|x|</annotation></semantics></math> is the cohomological grading of <math id="S23.I1.i2.p1.m5" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>.</p>
</div></li>
</ol>
<p id="S23.SS1.SSS1.p2.1" class="ltx_p">The resulting cohomology, called the <span id="S23.SS1.SSS1.p2.1.1" class="ltx_text ltx_font_bold">(Tate) equivariant cohomology</span> of <math id="S23.SS1.SSS1.p2.m1" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>, is denoted by</p>
<table id="S23.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex2.m1" class="ltx_Math" alttext="H_{{{\mathbb{Z}}_{\sf p}}}(D)" display="block" intent=":literal"><semantics><mrow><msub><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{{{\mathbb{Z}}_{\sf p}}}(D)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS1.SSS1.p2.2" class="ltx_p">which is naturally a <math id="S23.SS1.SSS1.p2.m2" class="ltx_Math" alttext="{\bf K}_{\sf p}" display="inline" intent=":literal"><semantics><msub><mi>𝐊</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{\bf K}_{\sf p}</annotation></semantics></math>-module.
In fact the equivariant cohomology <math id="S23.SS1.SSS1.p2.m3" class="ltx_Math" alttext="H_{{{\mathbb{Z}}_{\sf p}}}(D)" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{{{\mathbb{Z}}_{\sf p}}}(D)</annotation></semantics></math> can be made a module over <math id="S23.SS1.SSS1.p2.m4" class="ltx_Math" alttext="\widetilde{\bf K}_{\sf p}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝐊</mi><mo>~</mo></mover><mi>𝗉</mi></msub><annotation encoding="application/x-tex">\widetilde{\bf K}_{\sf p}</annotation></semantics></math> in a non-obvious way (unless <math id="S23.SS1.SSS1.p2.m5" class="ltx_Math" alttext="{\sf p}=2" display="inline" intent=":literal"><semantics><mrow><mi>𝗉</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">{\sf p}=2</annotation></semantics></math>). We choose to construct the module structure in the Morse-theoretic approach. We will not use the above algebraic definition formally, but only provide it for algebraic intuition.</p>
</div>
<div id="S23.Thmthm1" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S23.Thmthm1.2" class="ltx_text ltx_font_italic">Remark 23.1</span></span><span id="S23.Thmthm1.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S23.Thmthm1.p1" class="ltx_para">
<p id="S23.Thmthm1.p1.1" class="ltx_p">If we work with <math id="S23.Thmthm1.p1.m1" class="ltx_Math" alttext="D\otimes{\bf K}_{\sf p}" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>𝐊</mi><mi>𝗉</mi></msub></mrow><annotation encoding="application/x-tex">D\otimes{\bf K}_{\sf p}</annotation></semantics></math> equipped with the same differentials (<a href="#S23.E1" title="In item 1 ‣ 23.1.1. The algebraic construction ‣ 23.1. Tate Equivariant Cohomology ‣ 23. Equivariant Morse and Floer Cohomology ‣ Part IV EQUIVARIANT FLOER THEORY AND STEENROD OPERATIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23.1</span></a>) and (<a href="#S23.E2" title="In item 2 ‣ 23.1.1. The algebraic construction ‣ 23.1. Tate Equivariant Cohomology ‣ 23. Equivariant Morse and Floer Cohomology ‣ Part IV EQUIVARIANT FLOER THEORY AND STEENROD OPERATIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23.2</span></a>), then we obtain the Borel-equivariant cohomology. We mostly stick with the Tate setting because of intended applications.</p>
</div>
</div>
<div id="S23.SS1.SSS1.p3" class="ltx_para ltx_noindent">
<p id="S23.SS1.SSS1.p3.1" class="ltx_p">The equivariant complex is functorial. Namely, if <math id="S23.SS1.SSS1.p3.m1" class="ltx_Math" alttext="f:D\to D^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>D</mi><mo stretchy="false">→</mo><msup><mi>D</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">f:D\to D^{\prime}</annotation></semantics></math> is a <math id="S23.SS1.SSS1.p3.m2" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-equivariant chain map, then it induces a chain map</p>
<table id="S23.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex3.m1" class="ltx_Math" alttext="f_{{{\mathbb{Z}}_{\sf p}}}:C_{{{\mathbb{Z}}_{\sf p}}}(D)\to C_{{{\mathbb{Z}}_{\sf p}}}(D^{\prime})." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>D</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f_{{{\mathbb{Z}}_{\sf p}}}:C_{{{\mathbb{Z}}_{\sf p}}}(D)\to C_{{{\mathbb{Z}}_{\sf p}}}(D^{\prime}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS1.SSS1.p3.2" class="ltx_p">If <math id="S23.SS1.SSS1.p3.m3" class="ltx_Math" alttext="f_{0}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>0</mn></msub><annotation encoding="application/x-tex">f_{0}</annotation></semantics></math> and <math id="S23.SS1.SSS1.p3.m4" class="ltx_Math" alttext="f_{1}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>1</mn></msub><annotation encoding="application/x-tex">f_{1}</annotation></semantics></math> are <math id="S23.SS1.SSS1.p3.m5" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-equivariantly chain homotopic, then there is a corresponding <math id="S23.SS1.SSS1.p3.m6" class="ltx_Math" alttext="{\bf K}_{\sf p}" display="inline" intent=":literal"><semantics><msub><mi>𝐊</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{\bf K}_{\sf p}</annotation></semantics></math>-linear chain homotopy from <math id="S23.SS1.SSS1.p3.m7" class="ltx_Math" alttext="f_{0,{{\mathbb{Z}}_{\sf p}}}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mn>0</mn><mo>,</mo><msub><mi>ℤ</mi><mi>𝗉</mi></msub></mrow></msub><annotation encoding="application/x-tex">f_{0,{{\mathbb{Z}}_{\sf p}}}</annotation></semantics></math> to <math id="S23.SS1.SSS1.p3.m8" class="ltx_Math" alttext="f_{1,{{\mathbb{Z}}_{\sf p}}}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mn>1</mn><mo>,</mo><msub><mi>ℤ</mi><mi>𝗉</mi></msub></mrow></msub><annotation encoding="application/x-tex">f_{1,{{\mathbb{Z}}_{\sf p}}}</annotation></semantics></math>.</p>
</div>
<div id="S23.SS1.SSS1.p4" class="ltx_para ltx_noindent">
<p id="S23.SS1.SSS1.p4.1" class="ltx_p">There are two special cases of the above construction which will appear in this paper soon. The first special case is when the <math id="S23.SS1.SSS1.p4.m1" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-action on the complex <math id="S23.SS1.SSS1.p4.m2" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> is trivial. In this case</p>
<table id="S23.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex4.m1" class="ltx_Math" alttext="H_{{{\mathbb{Z}}_{\sf p}}}(D)\cong H(D)\otimes\widetilde{\bf K}_{\sf p}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msub><mover accent="true"><mi>𝐊</mi><mo>~</mo></mover><mi>𝗉</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H_{{{\mathbb{Z}}_{\sf p}}}(D)\cong H(D)\otimes\widetilde{\bf K}_{\sf p}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS1.SSS1.p4.2" class="ltx_p">Notice that this is a priori only an isomorphism of <math id="S23.SS1.SSS1.p4.m3" class="ltx_Math" alttext="{\bf K}_{\sf p}" display="inline" intent=":literal"><semantics><msub><mi>𝐊</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{\bf K}_{\sf p}</annotation></semantics></math>-modules but not <math id="S23.SS1.SSS1.p4.m4" class="ltx_Math" alttext="\widetilde{\bf K}_{\sf p}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝐊</mi><mo>~</mo></mover><mi>𝗉</mi></msub><annotation encoding="application/x-tex">\widetilde{\bf K}_{\sf p}</annotation></semantics></math>-modules.</p>
</div>
<div id="S23.SS1.SSS1.p5" class="ltx_para ltx_noindent">
<p id="S23.SS1.SSS1.p5.1" class="ltx_p">The second special case is the <math id="S23.SS1.SSS1.p5.m1" class="ltx_Math" alttext="{\sf p}" display="inline" intent=":literal"><semantics><mi>𝗉</mi><annotation encoding="application/x-tex">{\sf p}</annotation></semantics></math>-fold tensor power. Let <math id="S23.SS1.SSS1.p5.m2" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> be a non-equivariant cochain complex of <math id="S23.SS1.SSS1.p5.m3" class="ltx_Math" alttext="{\bf F}_{\sf p}" display="inline" intent=":literal"><semantics><msub><mi>𝐅</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{\bf F}_{\sf p}</annotation></semantics></math>-vector spaces. The tensor power</p>
<table id="S23.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex5.m1" class="ltx_Math" alttext="(D^{\otimes{\sf p}},d_{D}^{\otimes{\sf p}})" display="block" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>D</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup><mo>,</mo><msubsup><mi>d</mi><mi>D</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(D^{\otimes{\sf p}},d_{D}^{\otimes{\sf p}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS1.SSS1.p5.2" class="ltx_p">has the <math id="S23.SS1.SSS1.p5.m4" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-action by permuting the factors as follows: let <math id="S23.SS1.SSS1.p5.m5" class="ltx_Math" alttext="\tau\in{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><msub><mi>ℤ</mi><mi>𝗉</mi></msub></mrow><annotation encoding="application/x-tex">\tau\in{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math> be the generator, then <math id="S23.SS1.SSS1.p5.m6" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> acts on the <math id="S23.SS1.SSS1.p5.m7" class="ltx_Math" alttext="{\sf p}" display="inline" intent=":literal"><semantics><mi>𝗉</mi><annotation encoding="application/x-tex">{\sf p}</annotation></semantics></math>-fold tensor product by</p>
<table id="S23.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex6.m1" class="ltx_math_unparsed" alttext="\tau(x_{1}\otimes\cdots\otimes x_{\sf p})=(-1)^{|x_{1}|(|x_{2}|+\cdots+|x_{\sf p}|)}x_{2}\otimes\cdots\otimes x_{\sf p}\otimes x_{1}." display="block" intent=":literal"><semantics><mrow><mi>τ</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0.222em">⊗</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">⊗</mo><msub><mi>x</mi><mi>𝗉</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mrow><mrow><mo stretchy="false">|</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">|</mo></mrow><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><mrow><mo stretchy="false">|</mo><msub><mi>x</mi><mi>𝗉</mi></msub><mo stretchy="false">|</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><msub><mi>x</mi><mn>2</mn></msub><mo lspace="0.222em">⊗</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">⊗</mo><msub><mi>x</mi><mi>𝗉</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tau(x_{1}\otimes\cdots\otimes x_{\sf p})=(-1)^{|x_{1}|(|x_{2}|+\cdots+|x_{\sf p}|)}x_{2}\otimes\cdots\otimes x_{\sf p}\otimes x_{1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS1.SSS1.p5.3" class="ltx_p">Then one has the chain complex</p>
<table id="S23.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex7.m1" class="ltx_Math" alttext="C_{{{\mathbb{Z}}_{\sf p}}}(D^{\otimes{\sf p}})." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>D</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">C_{{{\mathbb{Z}}_{\sf p}}}(D^{\otimes{\sf p}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S23.SS1.SSS1.p6" class="ltx_para ltx_noindent">
<p id="S23.SS1.SSS1.p6.1" class="ltx_p">One can calculate the Tate equivariant cohomology by the so-called quasi-Frobenius map. This map is not induced from any chain-level construction. We first define the <span id="S23.SS1.SSS1.p6.1.1" class="ltx_text ltx_font_bold">quasi-Frobenius map</span></p>
<table id="S23.E3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.E3.m1" class="ltx_Math" alttext="qF:H(D)\to H_{{{\mathbb{Z}}_{\sf p}}}(D^{\otimes{\sf p}})" display="block" intent=":literal"><semantics><mrow><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>D</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">qF:H(D)\to H_{{{\mathbb{Z}}_{\sf p}}}(D^{\otimes{\sf p}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23.3)</span></td></tr></tbody>
</table>
<p id="S23.SS1.SSS1.p6.2" class="ltx_p">in the case when the differential of <math id="S23.SS1.SSS1.p6.m1" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> is trivial. In this case, <math id="S23.SS1.SSS1.p6.m2" class="ltx_Math" alttext="H_{{{\mathbb{Z}}_{\sf p}}}(D)\cong H(D)\otimes\widetilde{\bf K}_{\sf p}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msub><mover accent="true"><mi>𝐊</mi><mo>~</mo></mover><mi>𝗉</mi></msub></mrow></mrow><annotation encoding="application/x-tex">H_{{{\mathbb{Z}}_{\sf p}}}(D)\cong H(D)\otimes\widetilde{\bf K}_{\sf p}</annotation></semantics></math>. Define</p>
<table id="S23.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex8.m1" class="ltx_Math" alttext="qF(x)=\underbrace{x\otimes\cdots\otimes x}_{{\sf p}}\in C_{{{\mathbb{Z}}_{\sf p}}}(D^{\otimes{\sf p}})\ \forall x\in H(D)\subseteq H_{{{\mathbb{Z}}_{\sf p}}}(D)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><munder><munder accentunder="true"><mrow><mi>x</mi><mo lspace="0.222em">⊗</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">⊗</mo><mi>x</mi></mrow><mo stretchy="true">⏟</mo></munder><mi>𝗉</mi></munder><mo>∈</mo><mrow><msub><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>D</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0.667em" rspace="0em">​</mo><mrow><mo rspace="0.167em">∀</mo><mi>x</mi></mrow></mrow><mo>∈</mo><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊆</mo><mrow><msub><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">qF(x)=\underbrace{x\otimes\cdots\otimes x}_{{\sf p}}\in C_{{{\mathbb{Z}}_{\sf p}}}(D^{\otimes{\sf p}})\ \forall x\in H(D)\subseteq H_{{{\mathbb{Z}}_{\sf p}}}(D).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS1.SSS1.p6.3" class="ltx_p">The image is contained in the kernel of <math id="S23.SS1.SSS1.p6.m3" class="ltx_Math" alttext="d_{{{\mathbb{Z}}_{\sf p}}}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><annotation encoding="application/x-tex">d_{{{\mathbb{Z}}_{\sf p}}}</annotation></semantics></math> hence induces a map to <math id="S23.SS1.SSS1.p6.m4" class="ltx_Math" alttext="H_{{{\mathbb{Z}}_{\sf p}}}(D^{\otimes{\sf p}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>D</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{{{\mathbb{Z}}_{\sf p}}}(D^{\otimes{\sf p}})</annotation></semantics></math>. Moreover, we can see that the cohomological map is linear over <math id="S23.SS1.SSS1.p6.m5" class="ltx_Math" alttext="{\bf F}_{\sf p}" display="inline" intent=":literal"><semantics><msub><mi>𝐅</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{\bf F}_{\sf p}</annotation></semantics></math>.</p>
</div>
<div id="S23.SS1.SSS1.p7" class="ltx_para ltx_noindent">
<p id="S23.SS1.SSS1.p7.1" class="ltx_p">In general, when the differential of <math id="S23.SS1.SSS1.p7.m1" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> is nontrivial, there exists a <math id="S23.SS1.SSS1.p7.m2" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-equivariant chain homotopy equivalence</p>
<table id="S23.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex9.m1" class="ltx_Math" alttext="(H(D),0)\sim(D,d_{D})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>∼</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo>,</mo><msub><mi>d</mi><mi>D</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(H(D),0)\sim(D,d_{D}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS1.SSS1.p7.2" class="ltx_p">Then we define <math id="S23.SS1.SSS1.p7.m3" class="ltx_Math" alttext="qF" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><annotation encoding="application/x-tex">qF</annotation></semantics></math> as the composition</p>
<table id="S23.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S23.Ex10.m1.pic1" class="ltx_picture ltx_markedasmath" height="24.12" overflow="visible" style="vertical-align:-12.414852283267175px" version="1.1" viewBox="21.77 12.41 272.42 24.12" width="272.42"><g transform="matrix(1 0 0 -1 21.765405283572022 24.124088501128583) translate(0,3.46) translate(21.77,0)"><g transform="translate(-21.77,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:2.55em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="35.23"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S23.Ex10.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{H(D)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{H(D)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 21.765405283572022 -0.27673578005007266 L 21.765405283572022 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(54.97,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 21.765405283572022 -0.27673578005007266 L 54.974205615660026 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 54.974205615660026 -0.27673578005007266 L 54.974205615660026 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(54.97,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:6.12em;--ltx-fo-height:0.8em;--ltx-fo-depth:0.35em;font-size:10pt;" height="15.82" overflow="visible" transform="matrix(1 0 0 -1 0 11.02)" width="84.63"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S23.Ex10.m1.pic1.m2" class="ltx_Math" alttext="\textstyle{H_{{{\mathbb{Z}}_{\sf p}}}(H(D)^{\otimes{\sf p}})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{H_{{{\mathbb{Z}}_{\sf p}}}(H(D)^{\otimes{\sf p}})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 147.90314468124092 -0.27673578005007266 L 147.90314468124092 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(181.11,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 147.90314468124092 -0.27673578005007266 L 181.1119238997423 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 181.1119238997423 -0.27673578005007266 L 181.1119238997423 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(181.11,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:4.43em;--ltx-fo-height:0.8em;--ltx-fo-depth:0.35em;font-size:10pt;" height="15.82" overflow="visible" transform="matrix(1 0 0 -1 0 11.02)" width="61.24"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S23.Ex10.m1.pic1.m3" class="ltx_Math" alttext="\textstyle{H_{{{\mathbb{Z}}_{\sf p}}}(D^{\otimes{\sf p}})}" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>D</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{H_{{{\mathbb{Z}}_{\sf p}}}(D^{\otimes{\sf p}})}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS1.SSS1.p7.3" class="ltx_p">Moreover, any two <math id="S23.SS1.SSS1.p7.m4" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-equivariant chain homotopy equivalences between <math id="S23.SS1.SSS1.p7.m5" class="ltx_Math" alttext="H(D)" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H(D)</annotation></semantics></math> and <math id="S23.SS1.SSS1.p7.m6" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> are equivariantly homotopic. Hence the resulting map</p>
<table id="S23.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex11.m1" class="ltx_Math" alttext="qF:H(D)\to H_{{{\mathbb{Z}}_{\sf p}}}(D^{\otimes{\sf p}})" display="block" intent=":literal"><semantics><mrow><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>D</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">qF:H(D)\to H_{{{\mathbb{Z}}_{\sf p}}}(D^{\otimes{\sf p}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS1.SSS1.p7.4" class="ltx_p">is well-defined. Furthermore, the following functoriality property of <math id="S23.SS1.SSS1.p7.m7" class="ltx_Math" alttext="qF" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><annotation encoding="application/x-tex">qF</annotation></semantics></math> holds.</p>
</div>
<div id="S23.Thmthm2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S23.Thmthm2.2" class="ltx_text ltx_font_bold">Lemma 23.2</span></span><span id="S23.Thmthm2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S23.Thmthm2.p1" class="ltx_para ltx_noindent">
<p id="S23.Thmthm2.p1.1" class="ltx_p"><span id="S23.Thmthm2.p1.1.1" class="ltx_text ltx_font_italic">The quasi-Frobenius map is functorial. Namely, if <math id="S23.Thmthm2.p1.m1" class="ltx_Math" alttext="f:D_{1}\to D_{2}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>D</mi><mn>1</mn></msub><mo stretchy="false">→</mo><msub><mi>D</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">f:D_{1}\to D_{2}</annotation></semantics></math> is a cochain map, then there is a commutative diagram</span></p>
<table id="S23.E4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center">
<span id="S23.E4.2" class="ltx_inline-block ltx_markedasmath ltx_align_bottom"><span class="ltx_inline-block"><svg id="S23.E4.m1.pic1" class="ltx_picture" height="78.45" overflow="visible" style="vertical-align:-61.64542335815345px" version="1.1" viewBox="24.87 61.65 194.00 78.45" width="194.00"><g transform="matrix(1 0 0 -1 24.869123632785474 78.44968473530251) translate(24.87,0)"><g transform="translate(-24.87,0) translate(4.15,0) translate(0,-3.54)"><foreignObject style="--ltx-fo-width:2.99em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="41.44"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S23.E4.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{H(D_{1})\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>D</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{H(D_{1})\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 24.86914474637211 -0.27673578005007266 L 24.86914474637211 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(51.12,0) translate(0,8.4) translate(4.15,0) translate(0,-2.37)"><foreignObject style="--ltx-fo-width:1.01em;--ltx-fo-height:0.48em;--ltx-fo-depth:0.14em;font-size:10pt;" height="8.5" overflow="visible" transform="matrix(1 0 0 -1 0 6.62)" width="13.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S23.E4.m1.pic1.m2" class="ltx_Math" alttext="\scriptstyle{qF}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.700em">q</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">F</mi></mrow><annotation encoding="application/x-tex">\scriptstyle{qF}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(99.59,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 24.86914474637211 -0.27673578005007266 L 99.58892437998348 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 99.58892437998348 -0.27673578005007266 L 99.58892437998348 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -11.14645356605438 L 0.27673578005007266 -11.14645356605438" fill="none" stroke="#000000"></path><g transform="translate(-14.78,0) translate(0,-22.42) translate(4.15,0) translate(0,-2.42)"><foreignObject style="--ltx-fo-width:0.47em;--ltx-fo-height:0.49em;--ltx-fo-depth:0.14em;font-size:10pt;" height="8.61" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="6.48"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S23.E4.m1.pic1.m3" class="ltx_Math" alttext="\scriptstyle{f}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">f</mi><annotation encoding="application/x-tex">\scriptstyle{f}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(0,-33.85)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.84841532566677 L 0.27673578005007266 -11.14645356605438" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.84841532566677 L 0.27673578005007266 -33.84841532566677" fill="none" stroke="#000000"></path><g transform="translate(99.59,0) translate(4.15,0) translate(0,-3.54)"><foreignObject style="--ltx-fo-width:4.43em;--ltx-fo-height:0.8em;--ltx-fo-depth:0.35em;font-size:10pt;" height="15.82" overflow="visible" transform="matrix(1 0 0 -1 0 11.02)" width="61.24"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S23.E4.m1.pic1.m5" class="ltx_Math" alttext="\textstyle{H_{{{\mathbb{Z}}_{\sf p}}}(D_{1}^{\otimes{\sf p}})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>D</mi><mn>1</mn><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{H_{{{\mathbb{Z}}_{\sf p}}}(D_{1}^{\otimes{\sf p}})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 134.08246534534126 -12.491705738625553 L 134.6359369054414 -12.491705738625553" fill="none" stroke="#000000"></path><g transform="translate(134.36,0) translate(0,-22.42) translate(4.15,0) translate(0,-1.48)"><foreignObject style="--ltx-fo-width:1.24em;--ltx-fo-height:0.49em;--ltx-fo-depth:0.27em;font-size:10pt;" height="10.49" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="17.11"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S23.E4.m1.pic1.m6" class="ltx_Math" alttext="\scriptstyle{f_{{\mathbb{Z}}_{\sf p}}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">f</mi><msub><mi mathsize="0.710em">ℤ</mi><mi>𝗉</mi></msub></msub><annotation encoding="application/x-tex">\scriptstyle{f_{{\mathbb{Z}}_{\sf p}}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(134.36,0) translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 134.08246534534126 -33.20877921850137 L 134.6359369054414 -12.491705738625553" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 134.08246534534126 -33.20877921850137 L 134.6359369054414 -33.20877921850137" fill="none" stroke="#000000"></path><g transform="translate(-24.87,0) translate(0,-44.84) translate(4.15,0) translate(0,-3.54)"><foreignObject style="--ltx-fo-width:2.99em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="41.44"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S23.E4.m1.pic1.m7" class="ltx_Math" alttext="\textstyle{H(D_{2})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>D</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{H(D_{2})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 24.86914474637211 -45.117897761054465 L 24.86914474637211 -44.56442620095432" fill="none" stroke="#000000"></path><g transform="translate(51.12,0) translate(0,-53.24) translate(4.15,0) translate(0,-2.37)"><foreignObject style="--ltx-fo-width:1.01em;--ltx-fo-height:0.48em;--ltx-fo-depth:0.14em;font-size:10pt;" height="8.5" overflow="visible" transform="matrix(1 0 0 -1 0 6.62)" width="13.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S23.E4.m1.pic1.m8" class="ltx_Math" alttext="\scriptstyle{qF}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.700em">q</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">F</mi></mrow><annotation encoding="application/x-tex">\scriptstyle{qF}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(99.59,0) translate(0,-44.84)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 24.86914474637211 -45.117897761054465 L 99.58892437998348 -44.56442620095432" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 99.58892437998348 -45.117897761054465 L 99.58892437998348 -44.56442620095432" fill="none" stroke="#000000"></path><g transform="translate(99.59,0) translate(0,-44.84) translate(4.15,0) translate(0,-3.54)"><foreignObject style="--ltx-fo-width:4.43em;--ltx-fo-height:0.8em;--ltx-fo-depth:0.35em;font-size:10pt;" height="15.82" overflow="visible" transform="matrix(1 0 0 -1 0 11.02)" width="61.24"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S23.E4.m1.pic1.m10" class="ltx_Math" alttext="\textstyle{H_{{{\mathbb{Z}}_{\sf p}}}(D_{2}^{\otimes{\sf p}})}" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>D</mi><mn>2</mn><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{H_{{{\mathbb{Z}}_{\sf p}}}(D_{2}^{\otimes{\sf p}})}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span>
</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="0" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23.4)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="S23.SS1.SSS1.p8" class="ltx_para ltx_noindent">
<p id="S23.SS1.SSS1.p8.1" class="ltx_p">This functoriality implies that the quasi-Frobenius map is an isomorphism with field coefficients.</p>
</div>
<div id="S23.Thmthm3" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S23.Thmthm3.2" class="ltx_text ltx_font_bold">Proposition 23.3</span></span><span id="S23.Thmthm3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S23.Thmthm3.p1" class="ltx_para ltx_noindent">
<p id="S23.Thmthm3.p1.1" class="ltx_p"><span id="S23.Thmthm3.p1.1.1" class="ltx_text ltx_font_italic">There is a <math id="S23.Thmthm3.p1.m1" class="ltx_Math" alttext="{\bf K}_{\sf p}" display="inline" intent=":literal"><semantics><msub><mi>𝐊</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{\bf K}_{\sf p}</annotation></semantics></math>-linear extension of <math id="S23.Thmthm3.p1.m2" class="ltx_Math" alttext="qF" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><annotation encoding="application/x-tex">qF</annotation></semantics></math> which is an isomorphism</span></p>
<table id="S23.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex12.m1" class="ltx_Math" alttext="H(D)\otimes\widetilde{\bf K}_{\sf p}\to H_{{{\mathbb{Z}}_{\sf p}}}(D^{\otimes{\sf p}})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msub><mover accent="true"><mi>𝐊</mi><mo>~</mo></mover><mi>𝗉</mi></msub></mrow><mo stretchy="false">→</mo><mrow><msub><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>D</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H(D)\otimes\widetilde{\bf K}_{\sf p}\to H_{{{\mathbb{Z}}_{\sf p}}}(D^{\otimes{\sf p}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S23.SS1.SSS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S23.SS1.SSS1.p9" class="ltx_para">
<p id="S23.SS1.SSS1.p9.1" class="ltx_p"><span id="S23.SS1.SSS1.p9.1.1" class="ltx_text">By the definition of <math id="S23.SS1.SSS1.p9.m1" class="ltx_Math" alttext="qF" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><annotation encoding="application/x-tex">qF</annotation></semantics></math> and the above lemma, one only needs to verify this for the case when the differential of <math id="S23.SS1.SSS1.p9.m2" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> is trivial. The fact that <math id="S23.SS1.SSS1.p9.m3" class="ltx_Math" alttext="qF" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><annotation encoding="application/x-tex">qF</annotation></semantics></math> induces an isomorphism follows from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib47" title="" class="ltx_ref">62</a>, Lemma 3.1]</cite>.
∎</span></p>
</div>
</div>
</section>
<section id="S23.SS1.SSS2" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">23.1.2. </span>Novikov coefficients</h5>

<div id="S23.SS1.SSS2.p1" class="ltx_para ltx_noindent">
<p id="S23.SS1.SSS2.p1.1" class="ltx_p">Now we extend the above algebraic constructions to complex of modules over Novikov fields. First recall that when <math id="S23.SS1.SSS2.p1.m1" class="ltx_Math" alttext="\Pi_{1},\Pi_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Π</mi><mn>1</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Π</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\Pi_{1},\Pi_{2}</annotation></semantics></math> are Novikov groups, then one has a completed tensor product</p>
<table id="S23.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex13.m1" class="ltx_Math" alttext="\Lambda^{\Pi_{1}}\widehat{\otimes}\Lambda^{\Pi_{2}}\cong\Lambda^{\Pi_{1}\oplus\Pi_{2}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi mathvariant="normal">Λ</mi><msub><mi mathvariant="normal">Π</mi><mn>1</mn></msub></msup><mo lspace="0.222em" rspace="0em">​</mo><mover accent="true"><mo>⊗</mo><mo>^</mo></mover><mo lspace="0.222em" rspace="0em">​</mo><msup><mi mathvariant="normal">Λ</mi><msub><mi mathvariant="normal">Π</mi><mn>2</mn></msub></msup></mrow><mo>≅</mo><msup><mi mathvariant="normal">Λ</mi><mrow><msub><mi mathvariant="normal">Π</mi><mn>1</mn></msub><mo>⊕</mo><msub><mi mathvariant="normal">Π</mi><mn>2</mn></msub></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Lambda^{\Pi_{1}}\widehat{\otimes}\Lambda^{\Pi_{2}}\cong\Lambda^{\Pi_{1}\oplus\Pi_{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS1.SSS2.p1.2" class="ltx_p">Then if <math id="S23.SS1.SSS2.p1.m2" class="ltx_Math" alttext="D_{1}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mn>1</mn></msub><annotation encoding="application/x-tex">D_{1}</annotation></semantics></math> resp. <math id="S23.SS1.SSS2.p1.m3" class="ltx_Math" alttext="D_{2}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mn>2</mn></msub><annotation encoding="application/x-tex">D_{2}</annotation></semantics></math> are non-Archimedean normed over <math id="S23.SS1.SSS2.p1.m4" class="ltx_Math" alttext="\Lambda^{\Pi_{1}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Λ</mi><msub><mi mathvariant="normal">Π</mi><mn>1</mn></msub></msup><annotation encoding="application/x-tex">\Lambda^{\Pi_{1}}</annotation></semantics></math> resp. <math id="S23.SS1.SSS2.p1.m5" class="ltx_Math" alttext="\Lambda^{\Pi_{2}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Λ</mi><msub><mi mathvariant="normal">Π</mi><mn>2</mn></msub></msup><annotation encoding="application/x-tex">\Lambda^{\Pi_{2}}</annotation></semantics></math>, then one has a completed tensor product</p>
<table id="S23.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex14.m1" class="ltx_Math" alttext="D_{1}\widehat{\otimes}D_{2}" display="block" intent=":literal"><semantics><mrow><msub><mi>D</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0em">​</mo><mover accent="true"><mo>⊗</mo><mo>^</mo></mover><mo lspace="0.222em" rspace="0em">​</mo><msub><mi>D</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">D_{1}\widehat{\otimes}D_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS1.SSS2.p1.3" class="ltx_p">which is a non-Archimedean normed vector space over <math id="S23.SS1.SSS2.p1.m6" class="ltx_Math" alttext="\Lambda^{\Pi_{1}\oplus\Pi_{2}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Λ</mi><mrow><msub><mi mathvariant="normal">Π</mi><mn>1</mn></msub><mo>⊕</mo><msub><mi mathvariant="normal">Π</mi><mn>2</mn></msub></mrow></msup><annotation encoding="application/x-tex">\Lambda^{\Pi_{1}\oplus\Pi_{2}}</annotation></semantics></math>.</p>
</div>
<div id="S23.SS1.SSS2.p2" class="ltx_para ltx_noindent">
<p id="S23.SS1.SSS2.p2.1" class="ltx_p">The above equivariant construction requires the following specialization. Let <math id="S23.SS1.SSS2.p2.m1" class="ltx_Math" alttext="(\Pi,\lambda,\mu)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Π</mi><mo>,</mo><mi>λ</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Pi,\lambda,\mu)</annotation></semantics></math> be a Novikov group, which is typically the one defined by (<a href="#S1.E1" title="In 1.1.1. Floer complexes and Floer homology ‣ 1.1. Main results on Floer complexes ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.1</span></a>). In the equivariant setting we consider another standard one which is</p>
<table id="S23.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex15.m1" class="ltx_Math" alttext="({\mathbb{Z}},\lambda_{\sf p},\mu_{\sf p})" display="block" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>ℤ</mi><mo>,</mo><msub><mi>λ</mi><mi>𝗉</mi></msub><mo>,</mo><msub><mi>μ</mi><mi>𝗉</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{Z}},\lambda_{\sf p},\mu_{\sf p})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS1.SSS2.p2.2" class="ltx_p">where <math id="S23.SS1.SSS2.p2.m2" class="ltx_Math" alttext="\lambda_{\sf p}:{\mathbb{Z}}\to{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>𝗉</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ℤ</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">\lambda_{\sf p}:{\mathbb{Z}}\to{\mathbb{R}}</annotation></semantics></math> is the canonical inclusion while</p>
<table id="S23.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex16.m1" class="ltx_Math" alttext="\mu_{\sf p}(a)=\left\{\begin{array}[]{cc}a,&amp;\ {\sf p}=2,\\
2a,&amp;\ {\sf p}&gt;2\end{array}\right." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>μ</mi><mi>𝗉</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd><mrow><mi>a</mi><mo>,</mo></mrow></mtd><mtd><mrow><mrow><mi>𝗉</mi><mo>=</mo><mn>2</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>,</mo></mrow></mtd><mtd><mrow><mi>𝗉</mi><mo>&gt;</mo><mn>2</mn></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">\mu_{\sf p}(a)=\left\{\begin{array}[]{cc}a,&amp;\ {\sf p}=2,\\
2a,&amp;\ {\sf p}&gt;2\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S23.SS1.SSS2.p3" class="ltx_para ltx_noindent">
<p id="S23.SS1.SSS2.p3.1" class="ltx_p">Now let <math id="S23.SS1.SSS2.p3.m1" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> be a complex of <math id="S23.SS1.SSS2.p3.m2" class="ltx_Math" alttext="\Lambda_{{\bf F}_{\sf p}}^{\Pi}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup><annotation encoding="application/x-tex">\Lambda_{{\bf F}_{\sf p}}^{\Pi}</annotation></semantics></math>-vector spaces. Then the completed tensor product <math id="S23.SS1.SSS2.p3.m3" class="ltx_Math" alttext="D\widehat{\otimes}\widetilde{\bf K}_{\sf p}" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo lspace="0.222em" rspace="0em">​</mo><mover accent="true"><mo>⊗</mo><mo>^</mo></mover><mo lspace="0.222em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐊</mi><mo>~</mo></mover><mi>𝗉</mi></msub></mrow><annotation encoding="application/x-tex">D\widehat{\otimes}\widetilde{\bf K}_{\sf p}</annotation></semantics></math> is a vector space over the Novikov field</p>
<table id="S23.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex17.m1" class="ltx_math_unparsed" alttext="\Lambda^{\Pi\oplus{\mathbb{Z}}}:=\Lambda^{\Pi\oplus{\mathbb{Z}}}_{{\bf F}_{\sf p}}=\left\{\sum_{i=1}^{\infty}c_{i}T^{a_{i}+b_{i}}\ \left|\ \begin{array}[]{l}c_{i}\in{\bf F}_{\sf p},\ a_{i}\in\Pi,\ b_{i}\in{\mathbb{Z}},\\
\displaystyle\inf_{i}\omega(a_{i})&gt;-\infty,\ \inf_{i}b_{i}&gt;-\infty,\ \lim_{i+\infty}\omega(a_{i})+b_{i}=+\infty\end{array}\right.\right\}" display="block" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Λ</mi><mrow><mi mathvariant="normal">Π</mi><mo>⊕</mo><mi>ℤ</mi></mrow></msup><mo>:=</mo><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mrow><mi mathvariant="normal">Π</mi><mo>⊕</mo><mi>ℤ</mi></mrow></msubsup><mo>=</mo><mrow><mo>{</mo><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover><msub><mi>c</mi><mi>i</mi></msub><msup><mi>T</mi><mrow><msub><mi>a</mi><mi>i</mi></msub><mo>+</mo><msub><mi>b</mi><mi>i</mi></msub></mrow></msup><mo fence="false" rspace="0.667em">|</mo><mtable displaystyle="true" rowspacing="2.0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi>c</mi><msub><mrow></mrow><mi>i</mi></msub><mo>∈</mo><mi>𝐅</mi><msub><mrow></mrow><mi>𝗉</mi></msub><mo rspace="0.667em">,</mo><mi>a</mi><msub><mrow></mrow><mi>i</mi></msub><mo>∈</mo><mi mathvariant="normal">Π</mi><mo rspace="0.667em">,</mo><mi>b</mi><msub><mrow></mrow><mi>i</mi></msub><mo>∈</mo><mi>ℤ</mi><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><munder><mo movablelimits="false">inf</mo><mi>i</mi></munder><mrow><mi>ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&gt;</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mo rspace="0.389em">,</mo><mrow><mrow><munder><mo movablelimits="false" rspace="0.167em">inf</mo><mi>i</mi></munder><msub><mi>b</mi><mi>i</mi></msub></mrow><mo>&gt;</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mo rspace="0.389em">,</mo><mrow><mrow><mrow><munder><mo movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>i</mi><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><mi>ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><msub><mi>b</mi><mi>i</mi></msub></mrow><mo>=</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></mrow></mrow></mtd></mtr></mtable><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\Lambda^{\Pi\oplus{\mathbb{Z}}}:=\Lambda^{\Pi\oplus{\mathbb{Z}}}_{{\bf F}_{\sf p}}=\left\{\sum_{i=1}^{\infty}c_{i}T^{a_{i}+b_{i}}\ \left|\ \begin{array}[]{l}c_{i}\in{\bf F}_{\sf p},\ a_{i}\in\Pi,\ b_{i}\in{\mathbb{Z}},\\
\displaystyle\inf_{i}\omega(a_{i})&gt;-\infty,\ \inf_{i}b_{i}&gt;-\infty,\ \lim_{i+\infty}\omega(a_{i})+b_{i}=+\infty\end{array}\right.\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS1.SSS2.p3.2" class="ltx_p">We typically write <math id="S23.SS1.SSS2.p3.m4" class="ltx_Math" alttext="T^{b_{i}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><msub><mi>b</mi><mi>i</mi></msub></msup><annotation encoding="application/x-tex">T^{b_{i}}</annotation></semantics></math> as <math id="S23.SS1.SSS2.p3.m5" class="ltx_Math" alttext="\uptheta^{b_{i}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">θ</mi><msub><mi>b</mi><mi>i</mi></msub></msup><annotation encoding="application/x-tex">\uptheta^{b_{i}}</annotation></semantics></math> (when <math id="S23.SS1.SSS2.p3.m6" class="ltx_Math" alttext="{\sf p}=2" display="inline" intent=":literal"><semantics><mrow><mi>𝗉</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">{\sf p}=2</annotation></semantics></math>) or <math id="S23.SS1.SSS2.p3.m7" class="ltx_Math" alttext="\mathtt{U}^{b_{i}}" display="inline" intent=":literal"><semantics><msup><mi>𝚄</mi><msub><mi>b</mi><mi>i</mi></msub></msup><annotation encoding="application/x-tex">\mathtt{U}^{b_{i}}</annotation></semantics></math> (when <math id="S23.SS1.SSS2.p3.m8" class="ltx_Math" alttext="{\sf p}&gt;2" display="inline" intent=":literal"><semantics><mrow><mi>𝗉</mi><mo>&gt;</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">{\sf p}&gt;2</annotation></semantics></math>). Then this Novikov field consists of formal infinite <math id="S23.SS1.SSS2.p3.m9" class="ltx_Math" alttext="{\bf F}_{\sf p}" display="inline" intent=":literal"><semantics><msub><mi>𝐅</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{\bf F}_{\sf p}</annotation></semantics></math>-linear combinations of monomials <math id="S23.SS1.SSS2.p3.m10" class="ltx_Math" alttext="T^{a_{i}}P_{i}(\uptheta)" display="inline" intent=":literal"><semantics><mrow><msup><mi>T</mi><msub><mi>a</mi><mi>i</mi></msub></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T^{a_{i}}P_{i}(\uptheta)</annotation></semantics></math> or <math id="S23.SS1.SSS2.p3.m11" class="ltx_Math" alttext="T^{a_{i}}P_{i}(\mathtt{U})" display="inline" intent=":literal"><semantics><mrow><msup><mi>T</mi><msub><mi>a</mi><mi>i</mi></msub></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝚄</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T^{a_{i}}P_{i}(\mathtt{U})</annotation></semantics></math> where <math id="S23.SS1.SSS2.p3.m12" class="ltx_Math" alttext="P_{i}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>i</mi></msub><annotation encoding="application/x-tex">P_{i}</annotation></semantics></math> is a Laurent series with bounded pole orders while <math id="S23.SS1.SSS2.p3.m13" class="ltx_Math" alttext="\omega(a_{i})\to+\infty" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">\omega(a_{i})\to+\infty</annotation></semantics></math>.</p>
</div>
<div id="S23.SS1.SSS2.p4" class="ltx_para ltx_noindent">
<p id="S23.SS1.SSS2.p4.1" class="ltx_p">We can define the equivariant differential on the tensor product <math id="S23.SS1.SSS2.p4.m1" class="ltx_Math" alttext="D\widehat{\otimes}\widetilde{\bf K}_{\sf p}" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo lspace="0.222em" rspace="0em">​</mo><mover accent="true"><mo>⊗</mo><mo>^</mo></mover><mo lspace="0.222em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐊</mi><mo>~</mo></mover><mi>𝗉</mi></msub></mrow><annotation encoding="application/x-tex">D\widehat{\otimes}\widetilde{\bf K}_{\sf p}</annotation></semantics></math> using the same formula as before. However, most of the time, we will enlarge the Novikov field via</p>
<table id="S23.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex18.m1" class="ltx_Math" alttext="\Lambda_{{\bf F}_{\sf p}}^{\Pi\oplus{\mathbb{Z}}}\hookrightarrow\Lambda_{{\bf K}_{\sf p}}^{\Pi}" display="block" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mrow><mi mathvariant="normal">Π</mi><mo>⊕</mo><mi>ℤ</mi></mrow></msubsup><mo stretchy="false">↪</mo><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup></mrow><annotation encoding="application/x-tex">\Lambda_{{\bf F}_{\sf p}}^{\Pi\oplus{\mathbb{Z}}}\hookrightarrow\Lambda_{{\bf K}_{\sf p}}^{\Pi}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS1.SSS2.p4.2" class="ltx_p">where the latter does not require bounded pole orders for the coefficient of <math id="S23.SS1.SSS2.p4.m2" class="ltx_Math" alttext="T^{a_{i}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><msub><mi>a</mi><mi>i</mi></msub></msup><annotation encoding="application/x-tex">T^{a_{i}}</annotation></semantics></math>. Then define</p>
<table id="S23.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex19.m1" class="ltx_Math" alttext="\left(C_{{{\mathbb{Z}}_{\sf p}}}(D):=D\widehat{\otimes}\widetilde{\bf K}_{\sf p},d_{{{\mathbb{Z}}_{\sf p}}}\right)" display="block" intent=":literal"><semantics><mrow><mo>(</mo><mrow><mrow><msub><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mi>D</mi><mo lspace="0.222em" rspace="0em">​</mo><mover accent="true"><mo>⊗</mo><mo>^</mo></mover><mo lspace="0.222em" rspace="0em">​</mo><msub><mover accent="true"><mi>𝐊</mi><mo>~</mo></mover><mi>𝗉</mi></msub></mrow></mrow><mo>,</mo><msub><mi>d</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo>)</mo></mrow><annotation encoding="application/x-tex">\left(C_{{{\mathbb{Z}}_{\sf p}}}(D):=D\widehat{\otimes}\widetilde{\bf K}_{\sf p},d_{{{\mathbb{Z}}_{\sf p}}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS1.SSS2.p4.3" class="ltx_p">where the differential is still defined in the same way.</p>
</div>
<div id="S23.SS1.SSS2.p5" class="ltx_para ltx_noindent">
<p id="S23.SS1.SSS2.p5.1" class="ltx_p">One often needs to take a more convenient field extension. Consider</p>
<table id="S23.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex20.m1" class="ltx_Math" alttext="\Lambda_{{\bf K}_{\sf p}}^{\Pi}" display="block" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup><annotation encoding="application/x-tex">\Lambda_{{\bf K}_{\sf p}}^{\Pi}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS1.SSS2.p5.2" class="ltx_p">where <math id="S23.SS1.SSS2.p5.m1" class="ltx_Math" alttext="{\bf K}_{\sf p}" display="inline" intent=":literal"><semantics><msub><mi>𝐊</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{\bf K}_{\sf p}</annotation></semantics></math> is the field of Laurent series in <math id="S23.SS1.SSS2.p5.m2" class="ltx_Math" alttext="\uptheta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">θ</mi><annotation encoding="application/x-tex">\uptheta</annotation></semantics></math> (for <math id="S23.SS1.SSS2.p5.m3" class="ltx_Math" alttext="{\sf p}=2" display="inline" intent=":literal"><semantics><mrow><mi>𝗉</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">{\sf p}=2</annotation></semantics></math>) or <math id="S23.SS1.SSS2.p5.m4" class="ltx_Math" alttext="\mathtt{U}" display="inline" intent=":literal"><semantics><mi>𝚄</mi><annotation encoding="application/x-tex">\mathtt{U}</annotation></semantics></math> (for <math id="S23.SS1.SSS2.p5.m5" class="ltx_Math" alttext="{\sf p}&gt;2" display="inline" intent=":literal"><semantics><mrow><mi>𝗉</mi><mo>&gt;</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">{\sf p}&gt;2</annotation></semantics></math>). Elements in <math id="S23.SS1.SSS2.p5.m6" class="ltx_Math" alttext="\Lambda_{{\bf K}_{\sf p}}^{\Pi}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup><annotation encoding="application/x-tex">\Lambda_{{\bf K}_{\sf p}}^{\Pi}</annotation></semantics></math> are formal infinite <math id="S23.SS1.SSS2.p5.m7" class="ltx_Math" alttext="{\bf F}_{\sf p}" display="inline" intent=":literal"><semantics><msub><mi>𝐅</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{\bf F}_{\sf p}</annotation></semantics></math>-linear combinations of monomials <math id="S23.SS1.SSS2.p5.m8" class="ltx_Math" alttext="T^{a_{i}}P_{i}" display="inline" intent=":literal"><semantics><mrow><msup><mi>T</mi><msub><mi>a</mi><mi>i</mi></msub></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">T^{a_{i}}P_{i}</annotation></semantics></math> where <math id="S23.SS1.SSS2.p5.m9" class="ltx_Math" alttext="P_{i}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>i</mi></msub><annotation encoding="application/x-tex">P_{i}</annotation></semantics></math> is a Laurent series without bound on pole orders, or equivalently, formal infinite <math id="S23.SS1.SSS2.p5.m10" class="ltx_Math" alttext="{\bf K}_{\sf p}" display="inline" intent=":literal"><semantics><msub><mi>𝐊</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{\bf K}_{\sf p}</annotation></semantics></math>-linear combinations of <math id="S23.SS1.SSS2.p5.m11" class="ltx_Math" alttext="T^{a_{i}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><msub><mi>a</mi><mi>i</mi></msub></msup><annotation encoding="application/x-tex">T^{a_{i}}</annotation></semantics></math> with <math id="S23.SS1.SSS2.p5.m12" class="ltx_Math" alttext="\omega(a_{i})\to+\infty" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">\omega(a_{i})\to+\infty</annotation></semantics></math>. Then one often needs to use</p>
<table id="S23.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex21.m1" class="ltx_Math" alttext="C_{{{\mathbb{Z}}_{\sf p}}}(D)\underset{\Lambda^{\Pi\oplus{\mathbb{Z}}}}{\otimes}\Lambda_{{\bf K}_{\sf p}}^{\Pi}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.222em" rspace="0em">​</mo><munder accentunder="true"><mo>⊗</mo><msup><mi mathsize="0.700em" mathvariant="normal">Λ</mi><mrow><mi mathsize="0.710em" mathvariant="normal">Π</mi><mo mathsize="0.710em">⊕</mo><mi mathsize="0.710em">ℤ</mi></mrow></msup></munder><mo lspace="0.222em" rspace="0em">​</mo><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">C_{{{\mathbb{Z}}_{\sf p}}}(D)\underset{\Lambda^{\Pi\oplus{\mathbb{Z}}}}{\otimes}\Lambda_{{\bf K}_{\sf p}}^{\Pi}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S23.SS1.SSS2.p6" class="ltx_para ltx_noindent">
<p id="S23.SS1.SSS2.p6.1" class="ltx_p">We can also consider <math id="S23.SS1.SSS2.p6.m1" class="ltx_Math" alttext="C_{{{\mathbb{Z}}_{\sf p}}}(D^{\otimes{\sf p}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>D</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{{{\mathbb{Z}}_{\sf p}}}(D^{\otimes{\sf p}})</annotation></semantics></math> when <math id="S23.SS1.SSS2.p6.m2" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> is a non-equivariant cochain complex of <math id="S23.SS1.SSS2.p6.m3" class="ltx_Math" alttext="\Lambda^{\Pi}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Λ</mi><mi mathvariant="normal">Π</mi></msup><annotation encoding="application/x-tex">\Lambda^{\Pi}</annotation></semantics></math>-modules. We consider the completed tensor power (over <math id="S23.SS1.SSS2.p6.m4" class="ltx_Math" alttext="{\bf F}_{\sf p}" display="inline" intent=":literal"><semantics><msub><mi>𝐅</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{\bf F}_{\sf p}</annotation></semantics></math>)</p>
<table id="S23.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex22.m1" class="ltx_Math" alttext="\overbrace{D\widehat{\underset{{\bf F}_{\sf p}}{\otimes}}\cdots\widehat{\underset{{\bf F}_{\sf p}}{\otimes}}D}^{{\sf p}}" display="block" intent=":literal"><semantics><mover><mover accent="true"><mrow><mi>D</mi><munderover accent="true" accentunder="true"><mo lspace="0.222em">⊗</mo><msub><mi mathsize="0.700em">𝐅</mi><mi mathsize="0.710em">𝗉</mi></msub><mo>^</mo></munderover><mo lspace="0.055em" rspace="0.055em">⋯</mo><munderover accent="true" accentunder="true"><mo rspace="0.222em">⊗</mo><msub><mi mathsize="0.700em">𝐅</mi><mi mathsize="0.710em">𝗉</mi></msub><mo>^</mo></munderover><mi>D</mi></mrow><mo stretchy="true">⏞</mo></mover><mi>𝗉</mi></mover><annotation encoding="application/x-tex">\overbrace{D\widehat{\underset{{\bf F}_{\sf p}}{\otimes}}\cdots\widehat{\underset{{\bf F}_{\sf p}}{\otimes}}D}^{{\sf p}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS1.SSS2.p6.2" class="ltx_p">which is a module over</p>
<table id="S23.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex23.m1" class="ltx_math_unparsed" alttext="\Lambda^{\Pi^{\sf p}}:=\Lambda^{\Pi}\widehat{\underset{{\bf F}_{\sf p}}{\otimes}}\cdots\widehat{\underset{{\bf F}_{\sf p}}{\otimes}}\Lambda^{\Pi}." display="block" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><msup><mrow></mrow><msup><mi mathvariant="normal">Π</mi><mi>𝗉</mi></msup></msup><mo>:=</mo><mi mathvariant="normal">Λ</mi><msup><mrow></mrow><mi mathvariant="normal">Π</mi></msup><munderover accent="true" accentunder="true"><mo lspace="0.222em">⊗</mo><msub><mi mathsize="0.700em">𝐅</mi><mi mathsize="0.710em">𝗉</mi></msub><mo>^</mo></munderover><mo lspace="0.055em" rspace="0.055em">⋯</mo><munderover accent="true" accentunder="true"><mo rspace="0.222em">⊗</mo><msub><mi mathsize="0.700em">𝐅</mi><mi mathsize="0.710em">𝗉</mi></msub><mo>^</mo></munderover><mi mathvariant="normal">Λ</mi><msup><mrow></mrow><mi mathvariant="normal">Π</mi></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Lambda^{\Pi^{\sf p}}:=\Lambda^{\Pi}\widehat{\underset{{\bf F}_{\sf p}}{\otimes}}\cdots\widehat{\underset{{\bf F}_{\sf p}}{\otimes}}\Lambda^{\Pi}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS1.SSS2.p6.3" class="ltx_p">Consider the natural morphism of Novikov monoids (see Definition <a href="#S7.Thmthm21" title="Definition 7.21 (Novikov groups). ‣ 7.3.1. Twisted Novikov groups ‣ 7.3. Symmetries on flow categories, multimodules, and homotopies ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.21</span></a>)</p>
<table id="S23.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S23.Ex24.m1.pic1" class="ltx_picture ltx_markedasmath" height="65.70" overflow="visible" style="vertical-align:-53.25864224706396px" version="1.1" viewBox="36.63 53.26 186.81 65.70" width="186.81"><g transform="matrix(1 0 0 -1 36.62951807106813 65.69813408593642) translate(0,3.46) translate(36.63,0)"><g transform="translate(-36.63,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:4.69em;--ltx-fo-height:0.7em;--ltx-fo-depth:0.2em;font-size:10pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.69)" width="64.96"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S23.Ex24.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{\Pi\oplus\cdots\oplus\Pi\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Π</mi><mo>⊕</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>⊕</mo><mi mathvariant="normal">Π</mi></mrow><annotation encoding="application/x-tex">\textstyle{\Pi\oplus\cdots\oplus\Pi\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 36.62951807106813 -0.27673578005007266 L 36.62951807106813 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(69.84,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 36.62951807106813 -0.27673578005007266 L 69.83831840315614 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 69.83831840315614 -0.27673578005007266 L 69.83831840315614 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -10.377750103777501 L 0.27673578005007266 -10.377750103777501" fill="none" stroke="#000000"></path><g transform="translate(0,-35.5)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -35.50118688760464 L 0.27673578005007266 -10.377750103777501" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -35.50118688760464 L 0.27673578005007266 -35.50118688760464" fill="none" stroke="#000000"></path><g transform="translate(69.84,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:5.21em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.2em;font-size:10pt;" height="14.52" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="72.04"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S23.Ex24.m1.pic1.m2" class="ltx_Math" alttext="\textstyle{{\mathbb{R}}^{k}\oplus\cdots\oplus{\mathbb{R}}^{k}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℝ</mi><mi>k</mi></msup><mo>⊕</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>⊕</mo><msup><mi>ℝ</mi><mi>k</mi></msup></mrow><annotation encoding="application/x-tex">\textstyle{{\mathbb{R}}^{k}\oplus\cdots\oplus{\mathbb{R}}^{k}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 109.73212364981147 -10.377750103777501 L 110.28559520991162 -10.377750103777501" fill="none" stroke="#000000"></path><g transform="translate(110.01,0) translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 109.73212364981147 -33.208800332088 L 110.28559520991162 -10.377750103777501" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 109.73212364981147 -33.208800332088 L 110.28559520991162 -33.208800332088" fill="none" stroke="#000000"></path><g transform="translate(-9.34,0) translate(0,-45.65) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.75em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="10.38"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S23.Ex24.m1.pic1.m3" class="ltx_Math" alttext="\textstyle{\Pi\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\textstyle{\Pi\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 9.339996206986388 -45.925027951010534 L 9.339996206986388 -45.371556390910385" fill="none" stroke="#000000"></path><g transform="translate(97.36,0) translate(0,-45.65)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 9.339996206986388 -45.925027951010534 L 97.36095537729608 -45.371556390910385" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 97.36095537729608 -45.925027951010534 L 97.36095537729608 -45.371556390910385" fill="none" stroke="#000000"></path><g transform="translate(97.36,0) translate(0,-45.65) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.23em;--ltx-fo-height:0.85em;--ltx-fo-depth:0em;font-size:10pt;" height="11.75" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="16.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S23.Ex24.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{{\mathbb{R}}^{k}}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mi>k</mi></msup><annotation encoding="application/x-tex">\textstyle{{\mathbb{R}}^{k}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS1.SSS2.p6.4" class="ltx_p">where the vertical arrows are <math id="S23.SS1.SSS2.p6.m5" class="ltx_Math" alttext="(a_{1},\ldots,a_{\sf p})\mapsto a_{1}+\cdots+a_{\sf p}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><mi>𝗉</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">↦</mo><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>a</mi><mi>𝗉</mi></msub></mrow></mrow><annotation encoding="application/x-tex">(a_{1},\ldots,a_{\sf p})\mapsto a_{1}+\cdots+a_{\sf p}</annotation></semantics></math>. Then there is an induced ring morphism</p>
<table id="S23.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex25.m1" class="ltx_Math" alttext="\Lambda_{R}^{\Pi^{{\sf p}}}\to\Lambda_{R}^{\Pi}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi mathvariant="normal">Λ</mi><mi>R</mi><msup><mi mathvariant="normal">Π</mi><mi>𝗉</mi></msup></msubsup><mo stretchy="false">→</mo><msubsup><mi mathvariant="normal">Λ</mi><mi>R</mi><mi mathvariant="normal">Π</mi></msubsup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Lambda_{R}^{\Pi^{{\sf p}}}\to\Lambda_{R}^{\Pi}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS1.SSS2.p6.5" class="ltx_p">Denote</p>
<table id="S23.Ex26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex26.m1" class="ltx_Math" alttext="D^{\widehat{\otimes}{\sf p}}:=\left(\overbrace{D\widehat{\underset{{\bf F}_{\sf p}}{\otimes}}\cdots\widehat{\underset{{\bf F}_{\sf p}}{\otimes}}D}^{{\sf p}}\right)\underset{\Lambda^{\Pi^{{\sf p}}}}{\otimes}\Lambda^{\Pi}" display="block" intent=":literal"><semantics><mrow><msup><mi>D</mi><mrow><mover accent="true"><mo>⊗</mo><mo>^</mo></mover><mo lspace="0.222em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo>:=</mo><mrow><mrow><mo>(</mo><mover><mover accent="true"><mrow><mi>D</mi><munderover accent="true" accentunder="true"><mo lspace="0.222em">⊗</mo><msub><mi mathsize="0.700em">𝐅</mi><mi mathsize="0.710em">𝗉</mi></msub><mo>^</mo></munderover><mo lspace="0.055em" rspace="0.055em">⋯</mo><munderover accent="true" accentunder="true"><mo rspace="0.222em">⊗</mo><msub><mi mathsize="0.700em">𝐅</mi><mi mathsize="0.710em">𝗉</mi></msub><mo>^</mo></munderover><mi>D</mi></mrow><mo stretchy="true">⏞</mo></mover><mi>𝗉</mi></mover><mo>)</mo></mrow><mo lspace="0.222em" rspace="0em">​</mo><munder accentunder="true"><mo>⊗</mo><msup><mi mathsize="0.700em" mathvariant="normal">Λ</mi><msup><mi mathsize="0.710em" mathvariant="normal">Π</mi><mi>𝗉</mi></msup></msup></munder><mo lspace="0.222em" rspace="0em">​</mo><msup><mi mathvariant="normal">Λ</mi><mi mathvariant="normal">Π</mi></msup></mrow></mrow><annotation encoding="application/x-tex">D^{\widehat{\otimes}{\sf p}}:=\left(\overbrace{D\widehat{\underset{{\bf F}_{\sf p}}{\otimes}}\cdots\widehat{\underset{{\bf F}_{\sf p}}{\otimes}}D}^{{\sf p}}\right)\underset{\Lambda^{\Pi^{{\sf p}}}}{\otimes}\Lambda^{\Pi}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS1.SSS2.p6.6" class="ltx_p">which is a module over <math id="S23.SS1.SSS2.p6.m6" class="ltx_Math" alttext="\Lambda_{R}^{\mathbb{\Pi}}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><mi>R</mi><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi></msubsup><annotation encoding="application/x-tex">\Lambda_{R}^{\mathbb{\Pi}}</annotation></semantics></math>. Then we have the chain complex</p>
<table id="S23.Ex27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex27.m1" class="ltx_Math" alttext="C_{{{\mathbb{Z}}_{\sf p}}}(D^{\widehat{\otimes}{\sf p}})," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>D</mi><mrow><mover accent="true"><mo>⊗</mo><mo>^</mo></mover><mo lspace="0.222em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">C_{{{\mathbb{Z}}_{\sf p}}}(D^{\widehat{\otimes}{\sf p}}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS1.SSS2.p6.7" class="ltx_p">whose differential is defined similarly using (<a href="#S23.E1" title="In item 1 ‣ 23.1.1. The algebraic construction ‣ 23.1. Tate Equivariant Cohomology ‣ 23. Equivariant Morse and Floer Cohomology ‣ Part IV EQUIVARIANT FLOER THEORY AND STEENROD OPERATIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23.1</span></a>) and (<a href="#S23.E2" title="In item 2 ‣ 23.1.1. The algebraic construction ‣ 23.1. Tate Equivariant Cohomology ‣ 23. Equivariant Morse and Floer Cohomology ‣ Part IV EQUIVARIANT FLOER THEORY AND STEENROD OPERATIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23.2</span></a>). In this situation, we still have the quasi-Frobenius map well-defined on the cohomology level</p>
<table id="S23.Ex28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex28.m1" class="ltx_Math" alttext="qF:H^{*}(D)\to H_{{{\mathbb{Z}}_{\sf p}}}^{*}(D^{\widehat{\otimes}{\sf p}})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msubsup><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>D</mi><mrow><mover accent="true"><mo>⊗</mo><mo>^</mo></mover><mo lspace="0.222em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">qF:H^{*}(D)\to H_{{{\mathbb{Z}}_{\sf p}}}^{*}(D^{\widehat{\otimes}{\sf p}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS1.SSS2.p6.8" class="ltx_p">However it is only linear over <math id="S23.SS1.SSS2.p6.m7" class="ltx_Math" alttext="{\bf F}_{\sf p}" display="inline" intent=":literal"><semantics><msub><mi>𝐅</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{\bf F}_{\sf p}</annotation></semantics></math> but not the Novikov field <math id="S23.SS1.SSS2.p6.m8" class="ltx_Math" alttext="\Lambda_{{\bf F}_{\sf p}}^{\Pi}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup><annotation encoding="application/x-tex">\Lambda_{{\bf F}_{\sf p}}^{\Pi}</annotation></semantics></math>. Instead, one has Frobenius linearity in the Novikov variable</p>
<table id="S23.Ex29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex29.m1" class="ltx_Math" alttext="qF(T^{a}x)=T^{{\sf p}a}qF(x)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>T</mi><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>T</mi><mrow><mi>𝗉</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">qF(T^{a}x)=T^{{\sf p}a}qF(x).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="S23.SS1.SSS3" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">23.1.3. </span>Quantitative results</h5>

<div id="S23.SS1.SSS3.p1" class="ltx_para ltx_noindent">
<p id="S23.SS1.SSS3.p1.1" class="ltx_p">One considers a key quantitative property of the quasi-Frobenius map. Let <math id="S23.SS1.SSS3.p1.m1" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> be a Floer-type complex over <math id="S23.SS1.SSS3.p1.m2" class="ltx_Math" alttext="\Lambda_{{\bf F}_{\sf p}}^{\Pi}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup><annotation encoding="application/x-tex">\Lambda_{{\bf F}_{\sf p}}^{\Pi}</annotation></semantics></math> (Definition <a href="#S7.Thmthm34" title="Definition 7.34. ‣ 7.5.1. Nonarchimedean linear algebra ‣ 7.5. Quantitative theories ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.34</span></a>). Then the tensor product</p>
<table id="S23.Ex30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex30.m1" class="ltx_Math" alttext="D^{\widehat{\otimes}{\sf p}}" display="block" intent=":literal"><semantics><msup><mi>D</mi><mrow><mover accent="true"><mo>⊗</mo><mo>^</mo></mover><mo lspace="0.222em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><annotation encoding="application/x-tex">D^{\widehat{\otimes}{\sf p}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS1.SSS3.p1.2" class="ltx_p">is also a Floer-type complex over <math id="S23.SS1.SSS3.p1.m3" class="ltx_Math" alttext="\Lambda_{{\bf F}_{\sf p}}^{\Pi}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup><annotation encoding="application/x-tex">\Lambda_{{\bf F}_{\sf p}}^{\Pi}</annotation></semantics></math>. The equivariant complex, after tensoring with <math id="S23.SS1.SSS3.p1.m4" class="ltx_Math" alttext="\Lambda_{{\bf K}_{\sf p}}^{\Pi}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup><annotation encoding="application/x-tex">\Lambda_{{\bf K}_{\sf p}}^{\Pi}</annotation></semantics></math>, becomes a Floer-type complex over this larger Novikov field</p>
<table id="S23.Ex31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex31.m1" class="ltx_Math" alttext="C_{{{\mathbb{Z}}_{\sf p}}}(D^{\widehat{\otimes}{\sf p}})\otimes\Lambda_{{\bf K}_{\sf p}}^{\Pi}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>D</mi><mrow><mover accent="true"><mo>⊗</mo><mo>^</mo></mover><mo lspace="0.222em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">C_{{{\mathbb{Z}}_{\sf p}}}(D^{\widehat{\otimes}{\sf p}})\otimes\Lambda_{{\bf K}_{\sf p}}^{\Pi}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS1.SSS3.p1.3" class="ltx_p">Then for each <math id="S23.SS1.SSS3.p1.m5" class="ltx_Math" alttext="\tau\in{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">\tau\in{\mathbb{R}}</annotation></semantics></math>, define the filtered cohomology</p>
<table id="S23.Ex32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex32.m1" class="ltx_Math" alttext="H_{{{\mathbb{Z}}_{\sf p}}}^{\leq\tau}:=H((C_{{{\mathbb{Z}}_{\sf p}}}(D^{\widehat{\otimes}{\sf p}})\otimes\Lambda_{{\bf K}_{\sf p}}^{\Pi})^{\leq\tau})." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mrow><mphantom></mphantom><mo>≤</mo><mi>τ</mi></mrow></msubsup><mo>:=</mo><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>D</mi><mrow><mover accent="true"><mo>⊗</mo><mo>^</mo></mover><mo lspace="0.222em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo>≤</mo><mi>τ</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H_{{{\mathbb{Z}}_{\sf p}}}^{\leq\tau}:=H((C_{{{\mathbb{Z}}_{\sf p}}}(D^{\widehat{\otimes}{\sf p}})\otimes\Lambda_{{\bf K}_{\sf p}}^{\Pi})^{\leq\tau}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS1.SSS3.p1.4" class="ltx_p">Via localization, one can prove the following result.</p>
</div>
<div id="S23.Thmthm4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S23.Thmthm4.2" class="ltx_text ltx_font_bold">Lemma 23.4</span></span><span id="S23.Thmthm4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S23.Thmthm4.p1" class="ltx_para ltx_noindent">
<p id="S23.Thmthm4.p1.1" class="ltx_p"><span id="S23.Thmthm4.p1.1.1" class="ltx_text ltx_font_italic">For each <math id="S23.Thmthm4.p1.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>, there exists a quasi-Frobenius map</span></p>
<table id="S23.Ex33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex33.m1" class="ltx_Math" alttext="qF:H^{\leq\tau}(D)\to H_{{{\mathbb{Z}}_{\sf p}}}^{\leq{\sf p}\tau}(D^{\otimes{\sf p}})" display="block" intent=":literal"><semantics><mrow><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>H</mi><mrow><mphantom></mphantom><mo>≤</mo><mi>τ</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msubsup><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>𝗉</mi><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>D</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">qF:H^{\leq\tau}(D)\to H_{{{\mathbb{Z}}_{\sf p}}}^{\leq{\sf p}\tau}(D^{\otimes{\sf p}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.Thmthm4.p1.2" class="ltx_p"><span id="S23.Thmthm4.p1.2.1" class="ltx_text ltx_font_italic">satisfying</span></p>
<ol id="S23.I2" class="ltx_enumerate">
<li id="S23.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S23.I2.i1.p1" class="ltx_para ltx_noindent">
<p id="S23.I2.i1.p1.1" class="ltx_p"><span id="S23.I2.i1.p1.1.1" class="ltx_text ltx_font_italic">For </span><math id="S23.I2.i1.p1.m1" class="ltx_Math" alttext="\tau&lt;\sigma" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>&lt;</mo><mi>σ</mi></mrow><annotation encoding="application/x-tex">\tau&lt;\sigma</annotation></semantics></math><span id="S23.I2.i1.p1.1.2" class="ltx_text ltx_font_italic">, the following diagram commutes</span></p>
<table id="S23.Ex34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S23.Ex34.m1.pic1" class="ltx_picture ltx_markedasmath" height="79.09" overflow="visible" style="vertical-align:-62.28875434298032px" version="1.1" viewBox="29.64 62.29 171.12 79.09" width="171.12"><g transform="matrix(1 0 0 -1 29.641385393154575 79.09301572012939) translate(0,3.54) translate(29.64,0)"><g transform="translate(-28.99,0) translate(4.15,0) translate(0,-3.54)"><foreignObject style="--ltx-fo-width:3.59em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.25em;font-size:10pt;" height="15.12" overflow="visible" transform="matrix(1 0 0 -1 0 11.66)" width="49.67"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S23.Ex34.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{H^{\leq\tau}(D)\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mrow><mphantom></mphantom><mo>≤</mo><mi>τ</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{H^{\leq\tau}(D)\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 28.986864207410147 -0.27673578005007266 L 28.986864207410147 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(35.13,0) translate(0,8.4) translate(4.15,0) translate(0,-2.37)"><foreignObject style="--ltx-fo-width:1.01em;--ltx-fo-height:0.48em;--ltx-fo-depth:0.14em;font-size:10pt;" height="8.5" overflow="visible" transform="matrix(1 0 0 -1 0 6.62)" width="13.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S23.Ex34.m1.pic1.m2" class="ltx_Math" alttext="\scriptstyle{qF}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.700em">q</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">F</mi></mrow><annotation encoding="application/x-tex">\scriptstyle{qF}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(63.51,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 28.986864207410147 -0.27673578005007266 L 63.504728024573645 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 63.504728024573645 -0.27673578005007266 L 63.504728024573645 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -11.14645356605438 L 0.27673578005007266 -11.14645356605438" fill="none" stroke="#000000"></path><g transform="translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.20877921850137 L 0.27673578005007266 -11.14645356605438" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.20877921850137 L 0.27673578005007266 -33.20877921850137" fill="none" stroke="#000000"></path><g transform="translate(63.51,0) translate(4.15,0) translate(0,-3.54)"><foreignObject style="--ltx-fo-width:4.99em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.35em;font-size:10pt;" height="16.47" overflow="visible" transform="matrix(1 0 0 -1 0 11.66)" width="69.02"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S23.Ex34.m1.pic1.m3" class="ltx_Math" alttext="\textstyle{H_{{{\mathbb{Z}}_{\sf p}}}^{\leq{\sf p}\tau}(D^{\otimes{\sf p}})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>𝗉</mi><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>D</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{H_{{{\mathbb{Z}}_{\sf p}}}^{\leq{\sf p}\tau}(D^{\otimes{\sf p}})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 101.88922853048896 -12.491705738625553 L 102.44270009058911 -12.491705738625553" fill="none" stroke="#000000"></path><g transform="translate(102.17,0) translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 101.88922853048896 -33.20877921850137 L 102.44270009058911 -12.491705738625553" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 101.88922853048896 -33.20877921850137 L 102.44270009058911 -33.20877921850137" fill="none" stroke="#000000"></path><g transform="translate(-29.64,0) translate(0,-45.49) translate(4.15,0) translate(0,-3.54)"><foreignObject style="--ltx-fo-width:3.68em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.25em;font-size:10pt;" height="15.12" overflow="visible" transform="matrix(1 0 0 -1 0 11.66)" width="50.98"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S23.Ex34.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{H^{\leq\sigma}(D)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mrow><mphantom></mphantom><mo>≤</mo><mi>σ</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{H^{\leq\sigma}(D)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 29.641406506741212 -45.76122874588133 L 29.641406506741212 -45.20775718578118" fill="none" stroke="#000000"></path><g transform="translate(35.13,0) translate(0,-53.89) translate(4.15,0) translate(0,-2.37)"><foreignObject style="--ltx-fo-width:1.01em;--ltx-fo-height:0.48em;--ltx-fo-depth:0.14em;font-size:10pt;" height="8.5" overflow="visible" transform="matrix(1 0 0 -1 0 6.62)" width="13.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S23.Ex34.m1.pic1.m5" class="ltx_Math" alttext="\scriptstyle{qF}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.700em">q</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">F</mi></mrow><annotation encoding="application/x-tex">\scriptstyle{qF}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(62.85,0) translate(0,-45.49)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 29.641406506741212 -45.76122874588133 L 62.85018572524258 -45.20775718578118" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 62.85018572524258 -45.76122874588133 L 62.85018572524258 -45.20775718578118" fill="none" stroke="#000000"></path><g transform="translate(62.85,0) translate(0,-45.49) translate(4.15,0) translate(0,-3.54)"><foreignObject style="--ltx-fo-width:5.08em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.35em;font-size:10pt;" height="16.47" overflow="visible" transform="matrix(1 0 0 -1 0 11.66)" width="70.33"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S23.Ex34.m1.pic1.m6" class="ltx_Math" alttext="\textstyle{H_{{{\mathbb{Z}}_{\sf p}}}^{\leq{\sf p}\sigma}(D^{\otimes{\sf p}})}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>𝗉</mi><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>D</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{H_{{{\mathbb{Z}}_{\sf p}}}^{\leq{\sf p}\sigma}(D^{\otimes{\sf p}})}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S23.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S23.I2.i2.p1" class="ltx_para ltx_noindent">
<p id="S23.I2.i2.p1.1" class="ltx_p"><span id="S23.I2.i2.p1.1.1" class="ltx_text ltx_font_italic">After tensoring with </span><math id="S23.I2.i2.p1.m1" class="ltx_Math" alttext="\widetilde{\bf K}_{\sf p}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝐊</mi><mo>~</mo></mover><mi>𝗉</mi></msub><annotation encoding="application/x-tex">\widetilde{\bf K}_{\sf p}</annotation></semantics></math><span id="S23.I2.i2.p1.1.2" class="ltx_text ltx_font_italic">, for each </span><math id="S23.I2.i2.p1.m2" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math><span id="S23.I2.i2.p1.1.3" class="ltx_text ltx_font_italic">, </span><math id="S23.I2.i2.p1.m3" class="ltx_Math" alttext="qF" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><annotation encoding="application/x-tex">qF</annotation></semantics></math><span id="S23.I2.i2.p1.1.4" class="ltx_text ltx_font_italic"> induces an isomorphism of </span><math id="S23.I2.i2.p1.m4" class="ltx_Math" alttext="\Lambda_{{\bf K}_{\sf p},0}^{\Pi}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><mrow><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mo>,</mo><mn>0</mn></mrow><mi mathvariant="normal">Π</mi></msubsup><annotation encoding="application/x-tex">\Lambda_{{\bf K}_{\sf p},0}^{\Pi}</annotation></semantics></math><span id="S23.I2.i2.p1.1.5" class="ltx_text ltx_font_italic">-modules</span></p>
<table id="S23.Ex35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex35.m1" class="ltx_Math" alttext="qF:H^{\leq\tau}(D)\otimes\widetilde{\bf K}_{\sf p}\to H_{{{\mathbb{Z}}_{\sf p}}}^{\leq{\sf p}\tau}(D^{\otimes{\sf p}})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><msup><mi>H</mi><mrow><mphantom></mphantom><mo>≤</mo><mi>τ</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msub><mover accent="true"><mi>𝐊</mi><mo>~</mo></mover><mi>𝗉</mi></msub></mrow><mo stretchy="false">→</mo><mrow><msubsup><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>𝗉</mi><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>D</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">qF:H^{\leq\tau}(D)\otimes\widetilde{\bf K}_{\sf p}\to H_{{{\mathbb{Z}}_{\sf p}}}^{\leq{\sf p}\tau}(D^{\otimes{\sf p}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
</div>
</div>
<div id="S23.SS1.SSS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S23.SS1.SSS3.p2" class="ltx_para">
<p id="S23.SS1.SSS3.p2.1" class="ltx_p"><span id="S23.SS1.SSS3.p2.1.1" class="ltx_text">See <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib47" title="" class="ltx_ref">62</a>]</cite>.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="S23.SS2" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">23.2. </span><math id="S23.SS2.m1" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-equivariant Morse complexes</h4>

<section id="S23.SS2.SSS1" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">23.2.1. </span>Equivariant Morse cohomology for <math id="S23.SS2.SSS1.m1" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-manifolds</h5>

<div id="S23.SS2.SSS1.p1" class="ltx_para ltx_noindent">
<p id="S23.SS2.SSS1.p1.1" class="ltx_p">Let <math id="S23.SS2.SSS1.p1.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> be a compact oriented manifold equipped with a <math id="S23.SS2.SSS1.p1.m2" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-action. Let <math id="S23.SS2.SSS1.p1.m3" class="ltx_Math" alttext="f:M\to{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f:M\to{\mathbb{R}}</annotation></semantics></math> be a <math id="S23.SS2.SSS1.p1.m4" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-invariant Morse function. One would like to define a <math id="S23.SS2.SSS1.p1.m5" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-equivariant Morse cochain complex <math id="S23.SS2.SSS1.p1.m6" class="ltx_Math" alttext="CM_{{{\mathbb{Z}}_{\sf p}}}(f)" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CM_{{{\mathbb{Z}}_{\sf p}}}(f)</annotation></semantics></math>.</p>
</div>
<div id="S23.SS2.SSS1.p2" class="ltx_para ltx_noindent">
<p id="S23.SS2.SSS1.p2.1" class="ltx_p">First we assume that there exists a <math id="S23.SS2.SSS1.p2.m1" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-invariant Riemannian metric <math id="S23.SS2.SSS1.p2.m2" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> on <math id="S23.SS2.SSS1.p2.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> making <math id="S23.SS2.SSS1.p2.m4" class="ltx_Math" alttext="(f,g)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(f,g)</annotation></semantics></math> Morse–Smale. Namely, one can achieve equivariant transversality. Then one obtains a cochain complex <math id="S23.SS2.SSS1.p2.m5" class="ltx_Math" alttext="CM(f,g)" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CM(f,g)</annotation></semantics></math> which has a <math id="S23.SS2.SSS1.p2.m6" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-action. Hence the previous algebraic construction provides a way to obtain an equivariant Morse complex</p>
<table id="S23.Ex36" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex36.m1" class="ltx_Math" alttext="CM_{{{\mathbb{Z}}_{\sf p}}}(f):=C_{{{\mathbb{Z}}_{\sf p}}}(CM^{*}(f,g))." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><msub><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">CM_{{{\mathbb{Z}}_{\sf p}}}(f):=C_{{{\mathbb{Z}}_{\sf p}}}(CM^{*}(f,g)).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S23.SS2.SSS1.p3" class="ltx_para ltx_noindent">
<p id="S23.SS2.SSS1.p3.1" class="ltx_p">In fact the equivariant complex can also be obtained via Morse model. Consider the product function</p>
<table id="S23.Ex37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex37.m1" class="ltx_Math" alttext="F:M\times\widehat{S}^{\infty}\to{\mathbb{R}},\ F(x,w)=f(x)+f^{\mathbb{E}}(w)" display="block" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi mathvariant="normal">∞</mi></msup></mrow><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>f</mi><mi>𝔼</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">F:M\times\widehat{S}^{\infty}\to{\mathbb{R}},\ F(x,w)=f(x)+f^{\mathbb{E}}(w)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS2.SSS1.p3.2" class="ltx_p">and the product metric, which provides a Morse flow category <math id="S23.SS2.SSS1.p3.m1" class="ltx_Math" alttext="{\mathbb{M}}\#{{\mathbb{E}}}" display="inline" intent=":literal"><semantics><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi></mrow><annotation encoding="application/x-tex">{\mathbb{M}}\#{{\mathbb{E}}}</annotation></semantics></math>. Consider the associated Morse cochain complex</p>
<table id="S23.Ex38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex38.m1" class="ltx_Math" alttext="CM(F)" display="block" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CM(F)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS2.SSS1.p3.3" class="ltx_p">which coincides with the tensor product <math id="S23.SS2.SSS1.p3.m2" class="ltx_Math" alttext="CM(f)\otimes{\mathbb{E}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>𝔼</mi></mrow><annotation encoding="application/x-tex">CM(f)\otimes{\mathbb{E}}</annotation></semantics></math>. This complex has a <math id="S23.SS2.SSS1.p3.m3" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-action given by the <math id="S23.SS2.SSS1.p3.m4" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-action on <math id="S23.SS2.SSS1.p3.m5" class="ltx_Math" alttext="CM(f)" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CM(f)</annotation></semantics></math> and the <math id="S23.SS2.SSS1.p3.m6" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-action on <math id="S23.SS2.SSS1.p3.m7" class="ltx_Math" alttext="{\mathbb{E}}" display="inline" intent=":literal"><semantics><mi>𝔼</mi><annotation encoding="application/x-tex">{\mathbb{E}}</annotation></semantics></math>. Then define</p>
<table id="S23.Ex39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex39.m1" class="ltx_Math" alttext="CM_{{{\mathbb{Z}}_{\sf p}}}(f):=(CM(f)\otimes{\mathbb{E}})_{{{\mathbb{Z}}_{\sf p}}}" display="block" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><msub><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>𝔼</mi></mrow><mo stretchy="false">)</mo></mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub></mrow><annotation encoding="application/x-tex">CM_{{{\mathbb{Z}}_{\sf p}}}(f):=(CM(f)\otimes{\mathbb{E}})_{{{\mathbb{Z}}_{\sf p}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS2.SSS1.p3.4" class="ltx_p">i.e., the <math id="S23.SS2.SSS1.p3.m8" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-fixed part.</p>
</div>
<div id="S23.Thmthm5" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S23.Thmthm5.2" class="ltx_text ltx_font_bold">Lemma 23.5</span></span><span id="S23.Thmthm5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S23.Thmthm5.p1" class="ltx_para">
<p id="S23.Thmthm5.p1.1" class="ltx_p"><span id="S23.Thmthm5.p1.1.1" class="ltx_text ltx_font_italic">The complex <math id="S23.Thmthm5.p1.m1" class="ltx_Math" alttext="CM_{{{\mathbb{Z}}_{\sf p}}}(f)" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CM_{{{\mathbb{Z}}_{\sf p}}}(f)</annotation></semantics></math> coincides with the algebraically defined complex <math id="S23.Thmthm5.p1.m2" class="ltx_Math" alttext="C_{{{\mathbb{Z}}_{\sf p}}}(D)" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{{{\mathbb{Z}}_{\sf p}}}(D)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S23.SS2.SSS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S23.SS2.SSS1.p4" class="ltx_para ltx_noindent">
<p id="S23.SS2.SSS1.p4.1" class="ltx_p"><span id="S23.SS2.SSS1.p4.1.1" class="ltx_text">Define a linear map</span></p>
<table id="S23.Ex40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex40.m1" class="ltx_Math" alttext="CM(f)\otimes\widetilde{\bf K}_{\sf p}\to CM(F)_{{{\mathbb{Z}}_{\sf p}}}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msub><mover accent="true"><mi>𝐊</mi><mo>~</mo></mover><mi>𝗉</mi></msub></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">CM(f)\otimes\widetilde{\bf K}_{\sf p}\to CM(F)_{{{\mathbb{Z}}_{\sf p}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS2.SSS1.p4.2" class="ltx_p"><span id="S23.SS2.SSS1.p4.2.1" class="ltx_text">as follows.</span></p>
<ol id="S23.I3" class="ltx_enumerate">
<li id="S23.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S23.I3.i1.p1" class="ltx_para ltx_noindent">
<p id="S23.I3.i1.p1.1" class="ltx_p">When <math id="S23.I3.i1.p1.m1" class="ltx_Math" alttext="{\sf p}=2" display="inline" intent=":literal"><semantics><mrow><mi>𝗉</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">{\sf p}=2</annotation></semantics></math>, define</p>
<table id="S23.Ex41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex41.m1" class="ltx_Math" alttext="x\otimes\uptheta^{k}\mapsto x\otimes q_{k}^{+}+\tau(x)\otimes q_{k}^{-}" display="block" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mi mathvariant="normal">θ</mi><mi>k</mi></msup></mrow><mo stretchy="false">↦</mo><mrow><mrow><mi>x</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi>q</mi><mi>k</mi><mo>+</mo></msubsup></mrow><mo>+</mo><mrow><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi>q</mi><mi>k</mi><mo>−</mo></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">x\otimes\uptheta^{k}\mapsto x\otimes q_{k}^{+}+\tau(x)\otimes q_{k}^{-}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.I3.i1.p1.2" class="ltx_p">where <math id="S23.I3.i1.p1.m2" class="ltx_Math" alttext="q_{k}^{\pm}" display="inline" intent=":literal"><semantics><msubsup><mi>q</mi><mi>k</mi><mo>±</mo></msubsup><annotation encoding="application/x-tex">q_{k}^{\pm}</annotation></semantics></math> are the two critical points of <math id="S23.I3.i1.p1.m3" class="ltx_Math" alttext="f^{{\mathbb{E}}}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mi>𝔼</mi></msup><annotation encoding="application/x-tex">f^{{\mathbb{E}}}</annotation></semantics></math> and <math id="S23.I3.i1.p1.m4" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> is the action on <math id="S23.I3.i1.p1.m5" class="ltx_Math" alttext="CM(f)" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CM(f)</annotation></semantics></math>.</p>
</div></li>
<li id="S23.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S23.I3.i2.p1" class="ltx_para ltx_noindent">
<p id="S23.I3.i2.p1.1" class="ltx_p">When <math id="S23.I3.i2.p1.m1" class="ltx_Math" alttext="{\sf p}&gt;2" display="inline" intent=":literal"><semantics><mrow><mi>𝗉</mi><mo>&gt;</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">{\sf p}&gt;2</annotation></semantics></math>, define</p>
<table id="S23.Ex42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex42.m1" class="ltx_Math" alttext="\begin{split}x\otimes\mathtt{U}^{k}&amp;\mapsto\sum_{l=1}^{p}(\tau^{l}x)\otimes w_{2k}^{l},\\
x\otimes\mathtt{U}^{k}\uptheta&amp;\mapsto\sum_{l=1}^{p}(\tau^{l}x)\otimes w_{2k+1}^{l}\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mi>x</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mi>𝚄</mi><mi>k</mi></msup></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo rspace="0.111em" stretchy="false">↦</mo><mrow><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>p</mi></munderover><mrow><mo stretchy="false">(</mo><mrow><msup><mi>τ</mi><mi>l</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi>w</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mi>l</mi></msubsup></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mi>x</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mi>𝚄</mi><mi>k</mi></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">θ</mi></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo rspace="0.111em" stretchy="false">↦</mo><mrow><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi>p</mi></munderover><mrow><mo stretchy="false">(</mo><mrow><msup><mi>τ</mi><mi>l</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi>w</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>+</mo><mn>1</mn></mrow><mi>l</mi></msubsup></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}x\otimes\mathtt{U}^{k}&amp;\mapsto\sum_{l=1}^{p}(\tau^{l}x)\otimes w_{2k}^{l},\\
x\otimes\mathtt{U}^{k}\uptheta&amp;\mapsto\sum_{l=1}^{p}(\tau^{l}x)\otimes w_{2k+1}^{l}\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.I3.i2.p1.2" class="ltx_p">where <math id="S23.I3.i2.p1.m2" class="ltx_Math" alttext="w_{i}^{l}" display="inline" intent=":literal"><semantics><msubsup><mi>w</mi><mi>i</mi><mi>l</mi></msubsup><annotation encoding="application/x-tex">w_{i}^{l}</annotation></semantics></math> are the critical points of <math id="S23.I3.i2.p1.m3" class="ltx_Math" alttext="f^{{\mathbb{E}}}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mi>𝔼</mi></msup><annotation encoding="application/x-tex">f^{{\mathbb{E}}}</annotation></semantics></math>.</p>
</div></li>
</ol>
<p id="S23.SS2.SSS1.p4.3" class="ltx_p"><span id="S23.SS2.SSS1.p4.3.1" class="ltx_text">One can check that this linear map is a bijective cochain map.
∎</span></p>
</div>
</div>
<div id="S23.SS2.SSS1.p5" class="ltx_para ltx_noindent">
<p id="S23.SS2.SSS1.p5.1" class="ltx_p">The two special cases mentioned above also arises in the Morse-theoretic context. First, suppose <math id="S23.SS2.SSS1.p5.m1" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math> acts trivially on <math id="S23.SS2.SSS1.p5.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>. Then a Morse–Smale pair <math id="S23.SS2.SSS1.p5.m3" class="ltx_Math" alttext="(f,g)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(f,g)</annotation></semantics></math> is equivariantly transverse, resulting in the identification</p>
<table id="S23.Ex43" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex43.m1" class="ltx_Math" alttext="HM_{{{\mathbb{Z}}_{\sf p}}}(f,g)\cong HM(f,g)\otimes\widetilde{\bf K}_{\sf p}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msub><mover accent="true"><mi>𝐊</mi><mo>~</mo></mover><mi>𝗉</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">HM_{{{\mathbb{Z}}_{\sf p}}}(f,g)\cong HM(f,g)\otimes\widetilde{\bf K}_{\sf p}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS2.SSS1.p5.2" class="ltx_p">On the other hand, if <math id="S23.SS2.SSS1.p5.m4" class="ltx_Math" alttext="(f,g)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(f,g)</annotation></semantics></math> is Morse–Smale on <math id="S23.SS2.SSS1.p5.m5" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, then the <math id="S23.SS2.SSS1.p5.m6" class="ltx_Math" alttext="{\sf p}" display="inline" intent=":literal"><semantics><mi>𝗉</mi><annotation encoding="application/x-tex">{\sf p}</annotation></semantics></math>-fold power</p>
<table id="S23.Ex44" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex44.m1" class="ltx_Math" alttext="(f^{{\sf p}},g^{\oplus{\sf p}})" display="block" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mi>𝗉</mi></msup><mo>,</mo><msup><mi>g</mi><mrow><mo rspace="0em">⊕</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(f^{{\sf p}},g^{\oplus{\sf p}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS2.SSS1.p5.3" class="ltx_p">is Morse–Smale on <math id="S23.SS2.SSS1.p5.m7" class="ltx_Math" alttext="M^{{\sf p}}" display="inline" intent=":literal"><semantics><msup><mi>M</mi><mi>𝗉</mi></msup><annotation encoding="application/x-tex">M^{{\sf p}}</annotation></semantics></math>. One obtains the cochain complex</p>
<table id="S23.Ex45" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex45.m1" class="ltx_Math" alttext="CM(f^{\sf p})\otimes C({\mathbb{E}})" display="block" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mi>𝗉</mi></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝔼</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">CM(f^{\sf p})\otimes C({\mathbb{E}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS2.SSS1.p5.4" class="ltx_p">whose <math id="S23.SS2.SSS1.p5.m8" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-invariant has cohomology <math id="S23.SS2.SSS1.p5.m9" class="ltx_Math" alttext="HM_{{{\mathbb{Z}}_{\sf p}}}(f^{\sf p},g^{\otimes{\sf p}})" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mi>𝗉</mi></msup><mo>,</mo><msup><mi>g</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">HM_{{{\mathbb{Z}}_{\sf p}}}(f^{\sf p},g^{\otimes{\sf p}})</annotation></semantics></math>. When <math id="S23.SS2.SSS1.p5.m10" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> is compact, Morse-theoretic technique proves that the resulting cohomology is independent of the choice of <math id="S23.SS2.SSS1.p5.m11" class="ltx_Math" alttext="(f,g)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(f,g)</annotation></semantics></math> and coincides with <math id="S23.SS2.SSS1.p5.m12" class="ltx_Math" alttext="H_{{{\mathbb{Z}}_{\sf p}}}(M^{\sf p})" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>M</mi><mi>𝗉</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{{{\mathbb{Z}}_{\sf p}}}(M^{\sf p})</annotation></semantics></math>.</p>
</div>
<div id="S23.SS2.SSS1.p6" class="ltx_para ltx_noindent">
<p id="S23.SS2.SSS1.p6.1" class="ltx_p">Now assume that one does not have equivariant transversality. Let <math id="S23.SS2.SSS1.p6.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> be equipped with a <math id="S23.SS2.SSS1.p6.m2" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-action, <math id="S23.SS2.SSS1.p6.m3" class="ltx_Math" alttext="f:M\to{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f:M\to{\mathbb{R}}</annotation></semantics></math> is a <math id="S23.SS2.SSS1.p6.m4" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-invariant Morse function. Still consider the product</p>
<table id="S23.Ex46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex46.m1" class="ltx_Math" alttext="F:M\times\widehat{S}^{\infty}\to{\mathbb{R}}." display="block" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi mathvariant="normal">∞</mi></msup></mrow><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">F:M\times\widehat{S}^{\infty}\to{\mathbb{R}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS2.SSS1.p6.2" class="ltx_p">Now the <math id="S23.SS2.SSS1.p6.m5" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-action on <math id="S23.SS2.SSS1.p6.m6" class="ltx_Math" alttext="M\times\widehat{S}^{\infty}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi mathvariant="normal">∞</mi></msup></mrow><annotation encoding="application/x-tex">M\times\widehat{S}^{\infty}</annotation></semantics></math> is free, allowing us to achieve equivariant transversality. There are many concrete choices of perturbations. For example, one can perturb the function <math id="S23.SS2.SSS1.p6.m7" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> to allow it to depend on <math id="S23.SS2.SSS1.p6.m8" class="ltx_Math" alttext="w\in\widehat{S}^{\infty}" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>∈</mo><msup><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi mathvariant="normal">∞</mi></msup></mrow><annotation encoding="application/x-tex">w\in\widehat{S}^{\infty}</annotation></semantics></math>, i.e., a <math id="S23.SS2.SSS1.p6.m9" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-invariant function <math id="S23.SS2.SSS1.p6.m10" class="ltx_Math" alttext="(w,x)\mapsto f_{v}(x)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">↦</mo><mrow><msub><mi>f</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(w,x)\mapsto f_{v}(x)</annotation></semantics></math> on <math id="S23.SS2.SSS1.p6.m11" class="ltx_Math" alttext="\widehat{S}^{\infty}\times M" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi mathvariant="normal">∞</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\widehat{S}^{\infty}\times M</annotation></semantics></math> such that <math id="S23.SS2.SSS1.p6.m12" class="ltx_Math" alttext="f_{v}(x)=f(x)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{v}(x)=f(x)</annotation></semantics></math> when <math id="S23.SS2.SSS1.p6.m13" class="ltx_Math" alttext="(v,x)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(v,x)</annotation></semantics></math> is close to a critical point of <math id="S23.SS2.SSS1.p6.m14" class="ltx_Math" alttext="g\times f" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>f</mi></mrow><annotation encoding="application/x-tex">g\times f</annotation></semantics></math>. One can further ensure that the set of critical points is unchanged under the perturbation provided that the perturbation is sufficiently small in <math id="S23.SS2.SSS1.p6.m15" class="ltx_Math" alttext="C^{1}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mn>1</mn></msup><annotation encoding="application/x-tex">C^{1}</annotation></semantics></math>-norm. Then one can consider the coupled flow line equation for <math id="S23.SS2.SSS1.p6.m16" class="ltx_Math" alttext="(\xi,\eta):{\mathbb{R}}\to M\times\widehat{S}^{\infty}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>ξ</mi><mo>,</mo><mi>η</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mrow><mi>ℝ</mi><mo stretchy="false">→</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi mathvariant="normal">∞</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">(\xi,\eta):{\mathbb{R}}\to M\times\widehat{S}^{\infty}</annotation></semantics></math>:</p>
<table id="S23.EGx76" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S23.Ex47"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S23.Ex47.m1" class="ltx_Math" alttext="\displaystyle\ \eta^{\prime}(s)=\nabla f_{\zeta(s)}(\eta(s)),\ " display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>η</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mrow><mi>ζ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ \eta^{\prime}(s)=\nabla f_{\zeta(s)}(\eta(s)),\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S23.Ex47.m2" class="ltx_Math" alttext="\displaystyle\ \zeta^{\prime}(s)=\nabla g(\zeta(s))," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>ζ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>g</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ζ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ \zeta^{\prime}(s)=\nabla g(\zeta(s)),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS2.SSS1.p6.3" class="ltx_p">which has again an obvious translation symmetry. Define the Morse cochain complex as the (completed) tensor product</p>
<table id="S23.Ex48" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex48.m1" class="ltx_Math" alttext="CM(f)\otimes CM(g)" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CM(f)\otimes CM(g)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS2.SSS1.p6.4" class="ltx_p">whose differential counts rigid perturbed flow lines. Define</p>
<table id="S23.Ex49" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex49.m1" class="ltx_Math" alttext="CM_{{{\mathbb{Z}}_{\sf p}}}(f):=(CM(f)\otimes CM(g))^{{{\mathbb{Z}}_{\sf p}}}" display="block" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msup></mrow><annotation encoding="application/x-tex">CM_{{{\mathbb{Z}}_{\sf p}}}(f):=(CM(f)\otimes CM(g))^{{{\mathbb{Z}}_{\sf p}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS2.SSS1.p6.5" class="ltx_p">as a subcomplex, whose chain homotopy type is independent of the perturbation.</p>
</div>
<div id="S23.SS2.SSS1.p7" class="ltx_para ltx_noindent">
<p id="S23.SS2.SSS1.p7.1" class="ltx_p">By using perturbed flow trees in <math id="S23.SS2.SSS1.p7.m1" class="ltx_Math" alttext="\widehat{S}^{\infty}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">\widehat{S}^{\infty}</annotation></semantics></math>, one can also define a module structure of <math id="S23.SS2.SSS1.p7.m2" class="ltx_Math" alttext="HM_{{{\mathbb{Z}}_{\sf p}}}(f)" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">HM_{{{\mathbb{Z}}_{\sf p}}}(f)</annotation></semantics></math> over <math id="S23.SS2.SSS1.p7.m3" class="ltx_Math" alttext="\widetilde{\bf K}_{\sf p}\cong H_{{{\mathbb{Z}}_{\sf p}}}({\rm pt})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>𝐊</mi><mo>~</mo></mover><mi>𝗉</mi></msub><mo>≅</mo><mrow><msub><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>pt</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\bf K}_{\sf p}\cong H_{{{\mathbb{Z}}_{\sf p}}}({\rm pt})</annotation></semantics></math> induced by a chain-level bilinear map</p>
<table id="S23.Ex50" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex50.m1" class="ltx_Math" alttext="CM_{{{\mathbb{Z}}_{\sf p}}}(f)\otimes_{{\bf F}_{\sf p}}CM_{{{\mathbb{Z}}_{\sf p}}}(g)\to CM_{{{\mathbb{Z}}_{\sf p}}}(f)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><msub><mo rspace="0.222em">⊗</mo><msub><mi>𝐅</mi><mi>𝗉</mi></msub></msub><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">CM_{{{\mathbb{Z}}_{\sf p}}}(f)\otimes_{{\bf F}_{\sf p}}CM_{{{\mathbb{Z}}_{\sf p}}}(g)\to CM_{{{\mathbb{Z}}_{\sf p}}}(f).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS2.SSS1.p7.2" class="ltx_p">More precisely, choose a perturbation <math id="S23.SS2.SSS1.p7.m4" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> over the tree <math id="S23.SS2.SSS1.p7.m5" class="ltx_Math" alttext="T_{2,1}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mrow><mn>2</mn><mo>,</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">T_{2,1}</annotation></semantics></math> which can be used to define the ring structure on <math id="S23.SS2.SSS1.p7.m6" class="ltx_Math" alttext="\widehat{S}^{\infty}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">\widehat{S}^{\infty}</annotation></semantics></math>. Choose another generic family of functions</p>
<table id="S23.Ex51" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex51.m1" class="ltx_Math" alttext="f_{s,v}:M\to{\mathbb{R}}" display="block" intent=":literal"><semantics><mrow><msub><mi>f</mi><mrow><mi>s</mi><mo>,</mo><mi>v</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f_{s,v}:M\to{\mathbb{R}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS2.SSS1.p7.3" class="ltx_p">parametrized by <math id="S23.SS2.SSS1.p7.m7" class="ltx_Math" alttext="s\in{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">s\in{\mathbb{R}}</annotation></semantics></math> and <math id="S23.SS2.SSS1.p7.m8" class="ltx_Math" alttext="v\in S^{\infty}" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><msup><mi>S</mi><mi mathvariant="normal">∞</mi></msup></mrow><annotation encoding="application/x-tex">v\in S^{\infty}</annotation></semantics></math> such that 1) <math id="S23.SS2.SSS1.p7.m9" class="ltx_Math" alttext="f_{s,v}=f" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mrow><mi>s</mi><mo>,</mo><mi>v</mi></mrow></msub><mo>=</mo><mi>f</mi></mrow><annotation encoding="application/x-tex">f_{s,v}=f</annotation></semantics></math> near <math id="S23.SS2.SSS1.p7.m10" class="ltx_Math" alttext="s=0" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">s=0</annotation></semantics></math> and 2) <math id="S23.SS2.SSS1.p7.m11" class="ltx_Math" alttext="f_{s,v}=f_{v}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mrow><mi>s</mi><mo>,</mo><mi>v</mi></mrow></msub><mo>=</mo><msub><mi>f</mi><mi>v</mi></msub></mrow><annotation encoding="application/x-tex">f_{s,v}=f_{v}</annotation></semantics></math> for <math id="S23.SS2.SSS1.p7.m12" class="ltx_Math" alttext="|s|\gg 0" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>s</mi><mo stretchy="false">|</mo></mrow><mo>≫</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">|s|\gg 0</annotation></semantics></math> and 3) <math id="S23.SS2.SSS1.p7.m13" class="ltx_Math" alttext="f_{s,\gamma v}(\gamma x)=f_{s,v}(x)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mrow><mi>s</mi><mo>,</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>f</mi><mrow><mi>s</mi><mo>,</mo><mi>v</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{s,\gamma v}(\gamma x)=f_{s,v}(x)</annotation></semantics></math> for all <math id="S23.SS2.SSS1.p7.m14" class="ltx_Math" alttext="\gamma\in{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>∈</mo><msub><mi>ℤ</mi><mi>𝗉</mi></msub></mrow><annotation encoding="application/x-tex">\gamma\in{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>. Consider pairs <math id="S23.SS2.SSS1.p7.m15" class="ltx_Math" alttext="(\xi,\eta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>ξ</mi><mo>,</mo><mi>η</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\xi,\eta)</annotation></semantics></math> where <math id="S23.SS2.SSS1.p7.m16" class="ltx_Math" alttext="\eta=(\zeta_{1},\zeta_{2},\zeta_{\infty}):T_{2,1}\to S^{\infty}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>ζ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>ζ</mi><mn>2</mn></msub><mo>,</mo><msub><mi>ζ</mi><mi mathvariant="normal">∞</mi></msub><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mrow><msub><mi>T</mi><mrow><mn>2</mn><mo>,</mo><mn>1</mn></mrow></msub><mo stretchy="false">→</mo><msup><mi>S</mi><mi mathvariant="normal">∞</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\eta=(\zeta_{1},\zeta_{2},\zeta_{\infty}):T_{2,1}\to S^{\infty}</annotation></semantics></math> is a <math id="S23.SS2.SSS1.p7.m17" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>-perturbed flow tree and <math id="S23.SS2.SSS1.p7.m18" class="ltx_Math" alttext="\xi:{\mathbb{R}}\to M" display="inline" intent=":literal"><semantics><mrow><mi>ξ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ℝ</mi><mo stretchy="false">→</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">\xi:{\mathbb{R}}\to M</annotation></semantics></math> solves the equation</p>
<table id="S23.Ex52" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex52.m1" class="ltx_Math" alttext="\xi^{\prime}(s)=\left\{\begin{array}[]{cc}\nabla f_{s,\zeta_{1}(s)}(\xi(s)),&amp;\ s\leq 0,\\
\nabla f_{s,\zeta_{\infty}(s)}(\xi(s)),&amp;\ s\geq 0\end{array}\right." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>ξ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mrow><mi>s</mi><mo>,</mo><mrow><msub><mi>ζ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ξ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow></mtd><mtd><mrow><mrow><mi>s</mi><mo>≤</mo><mn>0</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mrow><mi>s</mi><mo>,</mo><mrow><msub><mi>ζ</mi><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ξ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow></mtd><mtd><mrow><mi>s</mi><mo>≥</mo><mn>0</mn></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">\xi^{\prime}(s)=\left\{\begin{array}[]{cc}\nabla f_{s,\zeta_{1}(s)}(\xi(s)),&amp;\ s\leq 0,\\
\nabla f_{s,\zeta_{\infty}(s)}(\xi(s)),&amp;\ s\geq 0\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS2.SSS1.p7.4" class="ltx_p">The coefficients of the equation on <math id="S23.SS2.SSS1.p7.m19" class="ltx_Math" alttext="\xi" display="inline" intent=":literal"><semantics><mi>ξ</mi><annotation encoding="application/x-tex">\xi</annotation></semantics></math> is smooth. We then impose critical point asymptotics <math id="S23.SS2.SSS1.p7.m20" class="ltx_Math" alttext="\xi(\pm\infty)\in{\rm crit}(f)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ξ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>±</mo><mi mathvariant="normal">∞</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mi>crit</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\xi(\pm\infty)\in{\rm crit}(f)</annotation></semantics></math>. By choosing a generic <math id="S23.SS2.SSS1.p7.m21" class="ltx_Math" alttext="f_{s,v}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi>s</mi><mo>,</mo><mi>v</mi></mrow></msub><annotation encoding="application/x-tex">f_{s,v}</annotation></semantics></math>, one obtains equivariant transversality and hence defines a chain map</p>
<table id="S23.Ex53" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex53.m1" class="ltx_Math" alttext="\big(CM(f)\otimes CM(g)\big)\otimes CM(g)\to CM(f)\otimes CM(g)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\big(CM(f)\otimes CM(g)\big)\otimes CM(g)\to CM(f)\otimes CM(g).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS2.SSS1.p7.5" class="ltx_p">Its restriction to the <math id="S23.SS2.SSS1.p7.m22" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-invariant part gives</p>
<table id="S23.Ex54" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex54.m1" class="ltx_Math" alttext="CM_{{{\mathbb{Z}}_{\sf p}}}(f)\otimes CM_{{{\mathbb{Z}}_{\sf p}}}(g)\hookrightarrow(CM(f)\otimes CM(g)\otimes CM(g))^{{{\mathbb{Z}}_{\sf p}}}\to CM_{{{\mathbb{Z}}_{\sf p}}}(f)" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">↪</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msup><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">CM_{{{\mathbb{Z}}_{\sf p}}}(f)\otimes CM_{{{\mathbb{Z}}_{\sf p}}}(g)\hookrightarrow(CM(f)\otimes CM(g)\otimes CM(g))^{{{\mathbb{Z}}_{\sf p}}}\to CM_{{{\mathbb{Z}}_{\sf p}}}(f)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS2.SSS1.p7.6" class="ltx_p">hence a bilinear map</p>
<table id="S23.Ex55" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex55.m1" class="ltx_Math" alttext="HM_{{{\mathbb{Z}}_{\sf p}}}(f)\otimes_{{\bf F}_{\sf p}}\widetilde{\bf K}_{\sf p}\to HM_{{{\mathbb{Z}}_{\sf p}}}(f)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><msub><mo rspace="0.222em">⊗</mo><msub><mi>𝐅</mi><mi>𝗉</mi></msub></msub><msub><mover accent="true"><mi>𝐊</mi><mo>~</mo></mover><mi>𝗉</mi></msub></mrow><mo stretchy="false">→</mo><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">HM_{{{\mathbb{Z}}_{\sf p}}}(f)\otimes_{{\bf F}_{\sf p}}\widetilde{\bf K}_{\sf p}\to HM_{{{\mathbb{Z}}_{\sf p}}}(f).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS2.SSS1.p7.7" class="ltx_p">One can further show that this map defines a <math id="S23.SS2.SSS1.p7.m23" class="ltx_Math" alttext="\widetilde{\bf K}_{\sf p}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝐊</mi><mo>~</mo></mover><mi>𝗉</mi></msub><annotation encoding="application/x-tex">\widetilde{\bf K}_{\sf p}</annotation></semantics></math>-module structure on <math id="S23.SS2.SSS1.p7.m24" class="ltx_Math" alttext="HM_{{{\mathbb{Z}}_{\sf p}}}(f)" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">HM_{{{\mathbb{Z}}_{\sf p}}}(f)</annotation></semantics></math> using a standard TQFT argument.</p>
</div>
<div id="S23.SS2.SSS1.p8" class="ltx_para ltx_noindent">
<p id="S23.SS2.SSS1.p8.1" class="ltx_p">One can further define a multiplicative structure on <math id="S23.SS2.SSS1.p8.m1" class="ltx_Math" alttext="HM_{{{\mathbb{Z}}_{\sf p}}}(f)" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">HM_{{{\mathbb{Z}}_{\sf p}}}(f)</annotation></semantics></math> via the cochain-level map</p>
<table id="S23.Ex56" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex56.m1" class="ltx_Math" alttext="CM_{{{\mathbb{Z}}_{\sf p}}}(f)\otimes_{{\bf F}_{\sf p}}CM_{{{\mathbb{Z}}_{\sf p}}}(f)\to CM_{{{\mathbb{Z}}_{\sf p}}}(f)" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><msub><mo rspace="0.222em">⊗</mo><msub><mi>𝐅</mi><mi>𝗉</mi></msub></msub><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">CM_{{{\mathbb{Z}}_{\sf p}}}(f)\otimes_{{\bf F}_{\sf p}}CM_{{{\mathbb{Z}}_{\sf p}}}(f)\to CM_{{{\mathbb{Z}}_{\sf p}}}(f)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S23.SS2.SSS1.p8.2" class="ltx_p">via gradient flow trees in <math id="S23.SS2.SSS1.p8.m2" class="ltx_Math" alttext="M\times\widehat{S}^{\infty}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi mathvariant="normal">∞</mi></msup></mrow><annotation encoding="application/x-tex">M\times\widehat{S}^{\infty}</annotation></semantics></math>, whose associativity can be verified in the standard way. Lastly, because the multiplicative structure respects the <math id="S23.SS2.SSS1.p8.m3" class="ltx_Math" alttext="\widetilde{\bf K}_{\sf p}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝐊</mi><mo>~</mo></mover><mi>𝗉</mi></msub><annotation encoding="application/x-tex">\widetilde{\bf K}_{\sf p}</annotation></semantics></math>-module structure, hence it descends to a map</p>
<table id="S23.Ex57" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S23.Ex57.m1" class="ltx_Math" alttext="HM_{{{\mathbb{Z}}_{\sf p}}}(f)\underset{\widetilde{\bf K}_{\sf p}}{\otimes}HM_{{{\mathbb{Z}}_{\sf p}}}(f)\to HM_{{{\mathbb{Z}}_{\sf p}}}(f)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.222em" rspace="0em">​</mo><munder accentunder="true"><mo>⊗</mo><msub><mover accent="true"><mi mathsize="0.700em">𝐊</mi><mo>~</mo></mover><mi mathsize="0.710em">𝗉</mi></msub></munder><mo lspace="0.222em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">HM_{{{\mathbb{Z}}_{\sf p}}}(f)\underset{\widetilde{\bf K}_{\sf p}}{\otimes}HM_{{{\mathbb{Z}}_{\sf p}}}(f)\to HM_{{{\mathbb{Z}}_{\sf p}}}(f).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
</section>
</section>
<section id="S24" class="ltx_section">
<h3 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">24. </span>Quantum Steenrod Operations—Proof of Theorem <a href="#Thmthma8" title="Theorem H (Quantum Steenrod operation on general symplectic manifold). ‣ 1.2.1. The quantum Steenrod operations ‣ 1.2. Main results on equivariant Floer theory and Steenrod operations ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span></a></h3>

<div id="S24.p1" class="ltx_para ltx_noindent">
<p id="S24.p1.1" class="ltx_p">The classical Steenrod operation can be viewed as a <math id="S24.p1.m1" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-equivariant extension of the map <math id="S24.p1.m2" class="ltx_Math" alttext="x\mapsto x^{\sf p}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo stretchy="false">↦</mo><msup><mi>x</mi><mi>𝗉</mi></msup></mrow><annotation encoding="application/x-tex">x\mapsto x^{\sf p}</annotation></semantics></math> in cohomology in characteristic <math id="S24.p1.m3" class="ltx_Math" alttext="{\sf p}" display="inline" intent=":literal"><semantics><mi>𝗉</mi><annotation encoding="application/x-tex">{\sf p}</annotation></semantics></math>. Proposed by Fukaya <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib8" title="" class="ltx_ref">31</a>]</cite>, the quantum Steenrod operation deforms the classical one in analogy to the case that the quantum cup product deforms the classical cup product. Under topological restrictions such as monotonicity, the quantum Steenrod operation has been constructed by Seidel <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib13" title="" class="ltx_ref">61</a>]</cite>, Wilkins <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib58" title="" class="ltx_ref">72</a>]</cite>, and Seidel–Wilkins <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib4" title="" class="ltx_ref">59</a>]</cite> (see also the recent survey by Wilkins <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib3" title="" class="ltx_ref">73</a>]</cite>).</p>
</div>
<div id="S24.p2" class="ltx_para ltx_noindent">
<p id="S24.p2.1" class="ltx_p">The use of the FOP transverse perturbations allows us to define integer, hence <math id="S24.p2.m1" class="ltx_Math" alttext="{\bf F}_{\sf p}" display="inline" intent=":literal"><semantics><msub><mi>𝐅</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{\bf F}_{\sf p}</annotation></semantics></math>-counts of pseudoholomorphic curves, leading to a definition of the quantum Steenrod operation on all compact symplectic manifolds. In this section we go over the construction using the Morse model.</p>
</div>
<section id="S24.SS1" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">24.1. </span>Geometric setup</h4>

<section id="S24.SS1.SSS1" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">24.1.1. </span>The flow categories and bimodules associated to quantum Steenrod operation</h5>

<div id="S24.SS1.SSS1.p1" class="ltx_para ltx_noindent">
<p id="S24.SS1.SSS1.p1.1" class="ltx_p">Fix a prime <math id="S24.SS1.SSS1.p1.m1" class="ltx_Math" alttext="{\sf p}" display="inline" intent=":literal"><semantics><mi>𝗉</mi><annotation encoding="application/x-tex">{\sf p}</annotation></semantics></math>. Let <math id="S24.SS1.SSS1.p1.m2" class="ltx_Math" alttext="(X,\omega)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>ω</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(X,\omega)</annotation></semantics></math> be a compact symplectic manifold and <math id="S24.SS1.SSS1.p1.m3" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math> be a compatible almost complex structure. We abbreviate the data <math id="S24.SS1.SSS1.p1.m4" class="ltx_Math" alttext="(X,\omega,J)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>ω</mi><mo>,</mo><mi>J</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(X,\omega,J)</annotation></semantics></math> by <math id="S24.SS1.SSS1.p1.m5" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. We can reduce the consideration to a fixed <math id="S24.SS1.SSS1.p1.m6" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math> using argument such as continuation maps. Therefore we will not address the dependence on <math id="S24.SS1.SSS1.p1.m7" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math>. Recall</p>
<table id="S24.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S24.Ex1.m1" class="ltx_Math" alttext="\Pi=\frac{\pi_{2}(X)}{{\rm ker}\omega\cap{\rm ker}c_{1}}." display="block" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Π</mi><mo>=</mo><mfrac><mrow><msub><mi>π</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><mi>ker</mi><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow><mo>∩</mo><mrow><mi>ker</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>1</mn></msub></mrow></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Pi=\frac{\pi_{2}(X)}{{\rm ker}\omega\cap{\rm ker}c_{1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S24.SS1.SSS1.p2" class="ltx_para ltx_noindent">
<p id="S24.SS1.SSS1.p2.1" class="ltx_p">Let <math id="S24.SS1.SSS1.p2.m1" class="ltx_Math" alttext="(f,g)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(f,g)</annotation></semantics></math> be a Morse–Smale pair on <math id="S24.SS1.SSS1.p2.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> which defines a Morse flow category <math id="S24.SS1.SSS1.p2.m3" class="ltx_Math" alttext="\underline{\smash{\mathbb{M}}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝕄</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\mathbb{M}}}</annotation></semantics></math>. Let <math id="S24.SS1.SSS1.p2.m4" class="ltx_Math" alttext="{\mathbb{M}}" display="inline" intent=":literal"><semantics><mi>𝕄</mi><annotation encoding="application/x-tex">{\mathbb{M}}</annotation></semantics></math> be the trivial product <math id="S24.SS1.SSS1.p2.m5" class="ltx_Math" alttext="\underline{\smash{\mathbb{M}}}\times\Pi" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>𝕄</mi><mo stretchy="true">¯</mo></munder><mo lspace="0.222em" rspace="0.222em">×</mo><mi mathvariant="normal">Π</mi></mrow><annotation encoding="application/x-tex">\underline{\smash{\mathbb{M}}}\times\Pi</annotation></semantics></math>, which is naturally a <math id="S24.SS1.SSS1.p2.m6" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>-equivariant flow category. Its objects are denoted by</p>
<table id="S24.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S24.Ex2.m1" class="ltx_Math" alttext="x=(\underline{\smash{x}},a_{x})\in{\rm Ob}\underline{\smash{\mathbb{M}}}\times\Pi." display="block" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo>,</mo><msub><mi>a</mi><mi>x</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝕄</mi><mo stretchy="true">¯</mo></munder></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi mathvariant="normal">Π</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">x=(\underline{\smash{x}},a_{x})\in{\rm Ob}\underline{\smash{\mathbb{M}}}\times\Pi.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S24.SS1.SSS1.p3" class="ltx_para ltx_noindent">
<p id="S24.SS1.SSS1.p3.1" class="ltx_p">Let <math id="S24.SS1.SSS1.p3.m1" class="ltx_Math" alttext="\mathbb{E}" display="inline" intent=":literal"><semantics><mi>𝔼</mi><annotation encoding="application/x-tex">\mathbb{E}</annotation></semantics></math> be the <math id="S24.SS1.SSS1.p3.m2" class="ltx_Math" alttext="{\mathbb{Z}}\times{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><mrow><mi>ℤ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>ℤ</mi><mi>𝗉</mi></msub></mrow><annotation encoding="application/x-tex">{\mathbb{Z}}\times{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-equivariant flow category associated to the Morse–Smale pair on <math id="S24.SS1.SSS1.p3.m3" class="ltx_Math" alttext="\widehat{S}^{\infty}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">\widehat{S}^{\infty}</annotation></semantics></math>. Let <math id="S24.SS1.SSS1.p3.m4" class="ltx_Math" alttext="\underline{\smash{\mathbb{M}}}\#{\mathbb{E}}" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>𝕄</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi></mrow><annotation encoding="application/x-tex">\underline{\smash{\mathbb{M}}}\#{\mathbb{E}}</annotation></semantics></math> be the “coupling” of <math id="S24.SS1.SSS1.p3.m5" class="ltx_Math" alttext="\underline{\smash{\mathbb{M}}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝕄</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\mathbb{M}}}</annotation></semantics></math> and <math id="S24.SS1.SSS1.p3.m6" class="ltx_Math" alttext="{\mathbb{E}}" display="inline" intent=":literal"><semantics><mi>𝔼</mi><annotation encoding="application/x-tex">{\mathbb{E}}</annotation></semantics></math>, which is a flow category with object set</p>
<table id="S24.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S24.Ex3.m1" class="ltx_Math" alttext="{\rm Ob}(\underline{\smash{\mathbb{M}}}\#{\mathbb{E}})={\rm Ob}\underline{\smash{\mathbb{M}}}\times{\mathbb{E}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Ob</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><munder accentunder="true"><mi>𝕄</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝕄</mi><mo stretchy="true">¯</mo></munder></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝔼</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\rm Ob}(\underline{\smash{\mathbb{M}}}\#{\mathbb{E}})={\rm Ob}\underline{\smash{\mathbb{M}}}\times{\mathbb{E}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S24.SS1.SSS1.p3.2" class="ltx_p">The morphism space between two objects is the moduli space of flow lines in <math id="S24.SS1.SSS1.p3.m7" class="ltx_Math" alttext="X\times\widehat{S}^{\infty}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi mathvariant="normal">∞</mi></msup></mrow><annotation encoding="application/x-tex">X\times\widehat{S}^{\infty}</annotation></semantics></math>. Denote</p>
<table id="S24.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S24.Ex4.m1" class="ltx_Math" alttext="\mathbb{M}\#{\mathbb{E}}=(\underline{\smash{\mathbb{M}}}\#{\mathbb{E}})\times\Pi." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><munder accentunder="true"><mi>𝕄</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi mathvariant="normal">Π</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{M}\#{\mathbb{E}}=(\underline{\smash{\mathbb{M}}}\#{\mathbb{E}})\times\Pi.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S24.SS1.SSS1.p3.3" class="ltx_p">This flow category is equivariant with respect to the free action by</p>
<table id="S24.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S24.Ex5.m1" class="ltx_Math" alttext="\mathbb{\Pi}_{\sf p}=\Pi\times{\mathbb{Z}}\times{{\mathbb{Z}}_{\sf p}}=:{\mathbb{\Pi}}\times{\mathbb{Z}}_{{\sf p}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mi>𝗉</mi></msub><mo>=</mo><mrow><mi mathvariant="normal">Π</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>ℤ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>ℤ</mi><mi>𝗉</mi></msub></mrow><mo>=</mo><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>ℤ</mi><mi>𝗉</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{\Pi}_{\sf p}=\Pi\times{\mathbb{Z}}\times{{\mathbb{Z}}_{\sf p}}=:{\mathbb{\Pi}}\times{\mathbb{Z}}_{{\sf p}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S24.SS1.SSS1.p4" class="ltx_para ltx_noindent">
<p id="S24.SS1.SSS1.p4.1" class="ltx_p">We describe a multimodule <math id="S24.SS1.SSS1.p4.m1" class="ltx_Math" alttext="{\mathbb{X}}^{\mathbb{QSt}}" display="inline" intent=":literal"><semantics><msup><mi>𝕏</mi><mrow><mi>ℚ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup><annotation encoding="application/x-tex">{\mathbb{X}}^{\mathbb{QSt}}</annotation></semantics></math> over</p>
<table id="S24.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S24.Ex6.m1" class="ltx_Math" alttext="(\underbrace{\mathbb{M},\ldots,\mathbb{M}}_{{\sf p}},{\mathbb{E}};{\mathbb{M}}\#{\mathbb{E}})" display="block" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><munder><munder accentunder="true"><mrow><mi>𝕄</mi><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>𝕄</mi></mrow><mo stretchy="true">⏟</mo></munder><mi>𝗉</mi></munder><mo>,</mo><mi>𝔼</mi><mo>,</mo><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\underbrace{\mathbb{M},\ldots,\mathbb{M}}_{{\sf p}},{\mathbb{E}};{\mathbb{M}}\#{\mathbb{E}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S24.SS1.SSS1.p4.2" class="ltx_p">as follows. Consider the Riemann surface <math id="S24.SS1.SSS1.p4.m2" class="ltx_Math" alttext="\Sigma^{\mathbb{QSt}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Σ</mi><mrow><mi>ℚ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup><annotation encoding="application/x-tex">\Sigma^{\mathbb{QSt}}</annotation></semantics></math> which is identified with <math id="S24.SS1.SSS1.p4.m3" class="ltx_Math" alttext="\mathbb{CP}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">\mathbb{CP}^{1}</annotation></semantics></math> with <math id="S24.SS1.SSS1.p4.m4" class="ltx_Math" alttext="{\sf p}+1" display="inline" intent=":literal"><semantics><mrow><mi>𝗉</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\sf p}+1</annotation></semantics></math> marked points, where the <math id="S24.SS1.SSS1.p4.m5" class="ltx_Math" alttext="{\sf p}" display="inline" intent=":literal"><semantics><mi>𝗉</mi><annotation encoding="application/x-tex">{\sf p}</annotation></semantics></math> negative markings are at all <math id="S24.SS1.SSS1.p4.m6" class="ltx_Math" alttext="{\sf p}" display="inline" intent=":literal"><semantics><mi>𝗉</mi><annotation encoding="application/x-tex">{\sf p}</annotation></semantics></math>-th roots of unity</p>
<table id="S24.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S24.Ex7.m1" class="ltx_Math" alttext="z_{1},\ldots,z_{\sf p}\in{\mathbb{C}}\subseteq{\mathbb{C}}\cup\{\infty\}=\mathbb{CP}^{1}" display="block" intent=":literal"><semantics><mrow><msub><mi>z</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>z</mi><mi>𝗉</mi></msub><mo>∈</mo><mi>ℂ</mi><mo>⊆</mo><mrow><mi>ℂ</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">}</mo></mrow></mrow><mo>=</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">z_{1},\ldots,z_{\sf p}\in{\mathbb{C}}\subseteq{\mathbb{C}}\cup\{\infty\}=\mathbb{CP}^{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S24.SS1.SSS1.p4.3" class="ltx_p">and the positive marking is <math id="S24.SS1.SSS1.p4.m7" class="ltx_Math" alttext="z_{\infty}=\infty" display="inline" intent=":literal"><semantics><mrow><msub><mi>z</mi><mi mathvariant="normal">∞</mi></msub><mo>=</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">z_{\infty}=\infty</annotation></semantics></math>.</p>
</div>
<div id="S24.SS1.SSS1.p5" class="ltx_para ltx_noindent">
<p id="S24.SS1.SSS1.p5.1" class="ltx_p">Consider pairs</p>
<table id="S24.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S24.Ex8.m1" class="ltx_Math" alttext="(u,v)" display="block" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u,v)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S24.SS1.SSS1.p5.2" class="ltx_p">where <math id="S24.SS1.SSS1.p5.m1" class="ltx_Math" alttext="u:\Sigma^{\mathbb{QSt}}\to X" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi mathvariant="normal">Σ</mi><mrow><mi>ℚ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup><mo stretchy="false">→</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">u:\Sigma^{\mathbb{QSt}}\to X</annotation></semantics></math> is a <math id="S24.SS1.SSS1.p5.m2" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math>-holomorphic sphere in <math id="S24.SS1.SSS1.p5.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> with these <math id="S24.SS1.SSS1.p5.m4" class="ltx_Math" alttext="{\sf p}+1" display="inline" intent=":literal"><semantics><mrow><mi>𝗉</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\sf p}+1</annotation></semantics></math> special markings and <math id="S24.SS1.SSS1.p5.m5" class="ltx_Math" alttext="v:{\mathbb{R}}\to S^{\infty}" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ℝ</mi><mo stretchy="false">→</mo><msup><mi>S</mi><mi mathvariant="normal">∞</mi></msup></mrow></mrow><annotation encoding="application/x-tex">v:{\mathbb{R}}\to S^{\infty}</annotation></semantics></math> is a Morse trajectory of <math id="S24.SS1.SSS1.p5.m6" class="ltx_Math" alttext="{{\mathbb{E}}}" display="inline" intent=":literal"><semantics><mi>𝔼</mi><annotation encoding="application/x-tex">{{\mathbb{E}}}</annotation></semantics></math> in <math id="S24.SS1.SSS1.p5.m7" class="ltx_Math" alttext="S^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">S^{\infty}</annotation></semantics></math>. For each tuple of objects</p>
<table id="S24.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S24.Ex9.m1" class="ltx_math_unparsed" alttext="(x_{1},\ldots,x_{\sf p},w)\in{\rm Ob}{\mathbb{M}}\times\cdots\times{\rm Ob}{\mathbb{M}}\times{\rm Ob}{\mathbb{E}},\ p^{\prime}=(x^{\prime},w^{\prime})\in{\rm Ob}{\mathbb{M}}\#{\mathbb{E}}" display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mi>𝗉</mi></msub><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>Ob</mi><mi>𝕄</mi><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi>Ob</mi><mi>𝕄</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>Ob</mi><mi>𝔼</mi><mo rspace="0.667em">,</mo><msup><mi>p</mi><mo>′</mo></msup><mo>=</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mo>′</mo></msup><mo>,</mo><msup><mi>w</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>Ob</mi><mi>𝕄</mi><mi>#</mi><mi>𝔼</mi></mrow><annotation encoding="application/x-tex">(x_{1},\ldots,x_{\sf p},w)\in{\rm Ob}{\mathbb{M}}\times\cdots\times{\rm Ob}{\mathbb{M}}\times{\rm Ob}{\mathbb{E}},\ p^{\prime}=(x^{\prime},w^{\prime})\in{\rm Ob}{\mathbb{M}}\#{\mathbb{E}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S24.SS1.SSS1.p5.3" class="ltx_p">let</p>
<table id="S24.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S24.Ex10.m1" class="ltx_math_unparsed" alttext="\mathring{M}_{x_{1}\cdots x_{\sf p}w;p^{\prime}}^{\mathbb{QSt}}" display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi>M</mi><mo>̊</mo></mover><msub><mrow></mrow><mrow><mi>x</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>x</mi><msub><mrow></mrow><mi>𝗉</mi></msub><mi>w</mi><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mrow><mi>ℚ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathring{M}_{x_{1}\cdots x_{\sf p}w;p^{\prime}}^{\mathbb{QSt}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S24.SS1.SSS1.p5.4" class="ltx_p">be the space of such pairs <math id="S24.SS1.SSS1.p5.m8" class="ltx_Math" alttext="(u,v)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u,v)</annotation></semantics></math> such that</p>
<table id="S24.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S24.Ex11.m1" class="ltx_Math" alttext="\int_{S^{2}}u^{*}\omega=a_{x_{1}}+\cdots+a_{x_{\sf p}}-a_{x^{\prime}}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mo>∫</mo><msup><mi>S</mi><mn>2</mn></msup></msub><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>a</mi><msub><mi>x</mi><mn>1</mn></msub></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>a</mi><msub><mi>x</mi><mi>𝗉</mi></msub></msub></mrow><mo>−</mo><msub><mi>a</mi><msup><mi>x</mi><mo>′</mo></msup></msub></mrow></mrow><annotation encoding="application/x-tex">\int_{S^{2}}u^{*}\omega=a_{x_{1}}+\cdots+a_{x_{\sf p}}-a_{x^{\prime}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S24.SS1.SSS1.p5.5" class="ltx_p">satisfying the constraints</p>
<table id="S24.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S24.Ex12.m1" class="ltx_math_unparsed" alttext="u(z_{i})\in W^{\rm us}_{\underline{\smash{x}}_{i}},\ i=1,\ldots,{\sf p},\ u(z_{\infty})\in W^{\rm st}_{{\underline{\smash{x}}}^{\prime}},\ {\rm and}\ \lim_{s\to-\infty}v(s)=w,\ \lim_{s\to+\infty}v(s)=w^{\prime}." display="block" intent=":literal"><semantics><mrow><mi>u</mi><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msubsup><mi>W</mi><msub><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mi>i</mi></msub><mi>us</mi></msubsup><mo rspace="0.667em">,</mo><mi>i</mi><mo>=</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>𝗉</mi><mo rspace="0.667em">,</mo><mi>u</mi><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi mathvariant="normal">∞</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msubsup><mi>W</mi><msup><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo>′</mo></msup><mi>st</mi></msubsup><mo rspace="0.667em">,</mo><mi>and</mi><munder><mo lspace="0.667em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>s</mi><mo stretchy="false">→</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow></munder><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>w</mi><mo rspace="0.389em">,</mo><munder><mo movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>s</mi><mo stretchy="false">→</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></mrow></munder><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msup><mi>w</mi><mo>′</mo></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">u(z_{i})\in W^{\rm us}_{\underline{\smash{x}}_{i}},\ i=1,\ldots,{\sf p},\ u(z_{\infty})\in W^{\rm st}_{{\underline{\smash{x}}}^{\prime}},\ {\rm and}\ \lim_{s\to-\infty}v(s)=w,\ \lim_{s\to+\infty}v(s)=w^{\prime}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S24.SS1.SSS1.p5.6" class="ltx_p">Let <math id="S24.SS1.SSS1.p5.m9" class="ltx_math_unparsed" alttext="M_{x_{1}\cdots x_{\sf p}w;p^{\prime}}^{\mathbb{QSt}}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><mi>x</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>x</mi><msub><mrow></mrow><mi>𝗉</mi></msub><mi>w</mi><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mrow><mi>ℚ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup></mrow><annotation encoding="application/x-tex">M_{x_{1}\cdots x_{\sf p}w;p^{\prime}}^{\mathbb{QSt}}</annotation></semantics></math> be the compactification of <math id="S24.SS1.SSS1.p5.m10" class="ltx_math_unparsed" alttext="\mathring{M}_{x_{1}\cdots x_{\sf p}w;p^{\prime}}^{\mathbb{QSt}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>M</mi><mo>̊</mo></mover><msub><mrow></mrow><mrow><mi>x</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>x</mi><msub><mrow></mrow><mi>𝗉</mi></msub><mi>w</mi><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mrow><mi>ℚ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathring{M}_{x_{1}\cdots x_{\sf p}w;p^{\prime}}^{\mathbb{QSt}}</annotation></semantics></math> compactified in the following way: at markings, one takes the ordinary Gromov compactification; the Morse breakings at negative ends are allowed independently at different edges while the breakings on the positive ends are required to be “synchronized.”</p>
</div>
<div id="S24.Thmthm1" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S24.Thmthm1.2" class="ltx_text ltx_font_bold">Proposition 24.1</span></span><span id="S24.Thmthm1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S24.Thmthm1.p1" class="ltx_para ltx_noindent">
<p id="S24.Thmthm1.p1.1" class="ltx_p"><span id="S24.Thmthm1.p1.1.1" class="ltx_text ltx_font_italic">The spaces <math id="S24.Thmthm1.p1.m1" class="ltx_math_unparsed" alttext="M_{x_{1}\cdots x_{\sf p}w;p^{\prime}}^{\mathbb{QSt}}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><mi>x</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>x</mi><msub><mrow></mrow><mi>𝗉</mi></msub><mi>w</mi><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mrow><mi>ℚ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup></mrow><annotation encoding="application/x-tex">M_{x_{1}\cdots x_{\sf p}w;p^{\prime}}^{\mathbb{QSt}}</annotation></semantics></math> define a Novikov multimodule, denoted by <math id="S24.Thmthm1.p1.m2" class="ltx_Math" alttext="{\mathbb{X}}^{\mathbb{QSt}}" display="inline" intent=":literal"><semantics><msup><mi>𝕏</mi><mrow><mi>ℚ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup><annotation encoding="application/x-tex">{\mathbb{X}}^{\mathbb{QSt}}</annotation></semantics></math>, over <math id="S24.Thmthm1.p1.m3" class="ltx_Math" alttext="({\mathbb{M}},\ldots,{\mathbb{M}},{{\mathbb{E}}};{\mathbb{M}}^{{\mathbb{Z}}_{\sf p}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝕄</mi><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>𝕄</mi><mo>,</mo><mi>𝔼</mi><mo>,</mo><msup><mi>𝕄</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{M}},\ldots,{\mathbb{M}},{{\mathbb{E}}};{\mathbb{M}}^{{\mathbb{Z}}_{\sf p}})</annotation></semantics></math>, which is equivariant with respect to the morphism of Novikov groups</span></p>
<table id="S24.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S24.E1.m1.pic1" class="ltx_picture ltx_markedasmath" height="74.97" overflow="visible" style="vertical-align:-37.48px" version="1.1" viewBox="0 0 381.58 74.97" width="381.58"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,74.97) matrix(1 0 0 -1 0 0) translate(200.89,0) translate(0,37.48)"><g stroke-width="0.4pt" transform="matrix(1.0 0.0 0.0 1.0 -95.13 -31.27)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 74.97)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 20.94)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 1.54 0) translate(28.01,0) matrix(1.0 0.0 0.0 1.0 -22.05 0)"><foreignObject style="--ltx-fo-width:2.14em;--ltx-fo-height:1.15em;--ltx-fo-depth:0.2em;font-size:10pt;" height="18.64" overflow="visible" transform="matrix(1 0 0 -1 0 15.87)" width="29.6"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S24.E1.m1.pic1.m1" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\overbrace{\Pi\times\cdots\times\Pi}^{{\sf p}}\times{\mathbb{Z}}}" display="inline" intent=":literal"><semantics><mrow><mover><mover accent="true"><mrow><mi mathvariant="normal">Π</mi><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi mathvariant="normal">Π</mi></mrow><mo stretchy="true">⏞</mo></mover><mi>𝗉</mi></mover><mo lspace="0.222em" rspace="0.222em">×</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\overbrace{\Pi\times\cdots\times\Pi}^{{\sf p}}\times{\mathbb{Z}}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 93.05 0) translate(65.58,0) matrix(1.0 0.0 0.0 1.0 -25.67 0)"><foreignObject style="--ltx-fo-width:2.66em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.08em;font-size:10pt;" height="10.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="36.83"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S24.E1.m1.pic1.m2" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces{\mathbb{R}}^{{\sf p}}\times{\mathbb{R}}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℝ</mi><mi>𝗉</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces{\mathbb{R}}^{{\sf p}}\times{\mathbb{R}}}</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 68.75)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 0 0) translate(29.55,0) matrix(1.0 0.0 0.0 1.0 -23.59 0)"><foreignObject style="--ltx-fo-width:2.36em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.08em;font-size:10pt;" height="10.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="32.67"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S24.E1.m1.pic1.m3" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\Pi\times{\mathbb{Z}}}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Π</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\Pi\times{\mathbb{Z}}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 95.89 0) translate(62.73,0) matrix(1.0 0.0 0.0 1.0 -22.82 0)"><foreignObject style="--ltx-fo-width:2.25em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.08em;font-size:10pt;" height="10.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="31.13"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S24.E1.m1.pic1.m4" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces{\mathbb{R}}\times{\mathbb{R}}}" display="inline" intent=":literal"><semantics><mrow><mi>ℝ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces{\mathbb{R}}\times{\mathbb{R}}}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -37.29 20 L 31.04 20"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 31.31 20)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -65.58 8.44 L -65.58 -15.92"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 -65.58 -16.19)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -197.91 -7.48)"><foreignObject style="--ltx-fo-width:9.33em;--ltx-fo-height:0.7em;--ltx-fo-depth:0.2em;font-size:10pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.69)" width="129.08"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S24.E1.m1.pic1.m5" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces(A_{1},\ldots,A_{{\sf p}},a)\mapsto(A_{1}+\cdots+A_{{\sf p}},a)}" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em">A</mi><mn mathsize="0.710em">1</mn></msub><mo>,</mo><mi mathsize="0.700em" mathvariant="normal">…</mi><mo>,</mo><msub><mi mathsize="0.700em">A</mi><mi mathsize="0.710em">𝗉</mi></msub><mo>,</mo><mi mathsize="0.700em">a</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo mathsize="0.700em" stretchy="false">↦</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mrow><msub><mi mathsize="0.700em">A</mi><mn mathsize="0.710em">1</mn></msub><mo mathsize="0.700em">+</mo><mo lspace="0em" mathsize="0.700em" rspace="0em">⋯</mo><mo mathsize="0.700em">+</mo><msub><mi mathsize="0.700em">A</mi><mi mathsize="0.710em">𝗉</mi></msub></mrow><mo>,</mo><mi mathsize="0.700em">a</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces(A_{1},\ldots,A_{{\sf p}},a)\mapsto(A_{1}+\cdots+A_{{\sf p}},a)}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 63.5 10.05 L 63.5 -15.92"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 63.5 -16.19)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 66.75 -6.67)"><foreignObject style="--ltx-fo-width:8.02em;--ltx-fo-height:0.7em;--ltx-fo-depth:0.2em;font-size:10pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.69)" width="110.96"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S24.E1.m1.pic1.m6" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces(t_{1},\ldots,t_{{\sf p}},s)\mapsto(t_{1}+\cdots+t_{{\sf p}},s)}" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em">t</mi><mn mathsize="0.710em">1</mn></msub><mo>,</mo><mi mathsize="0.700em" mathvariant="normal">…</mi><mo>,</mo><msub><mi mathsize="0.700em">t</mi><mi mathsize="0.710em">𝗉</mi></msub><mo>,</mo><mi mathsize="0.700em">s</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo mathsize="0.700em" stretchy="false">↦</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mrow><msub><mi mathsize="0.700em">t</mi><mn mathsize="0.710em">1</mn></msub><mo mathsize="0.700em">+</mo><mo lspace="0em" mathsize="0.700em" rspace="0em">⋯</mo><mo mathsize="0.700em">+</mo><msub><mi mathsize="0.700em">t</mi><mi mathsize="0.710em">𝗉</mi></msub></mrow><mo>,</mo><mi mathsize="0.700em">s</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces(t_{1},\ldots,t_{{\sf p}},s)\mapsto(t_{1}+\cdots+t_{{\sf p}},s)}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -35.75 -27.81 L 33.89 -27.81"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 34.16 -27.81)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="0" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24.1)</span></td></tr></tbody>
</table>
<p id="S24.Thmthm1.p1.2" class="ltx_p"><span id="S24.Thmthm1.p1.2.1" class="ltx_text ltx_font_italic">Moreover, as a weak bimodule over <math id="S24.Thmthm1.p1.m4" class="ltx_math_unparsed" alttext="({\mathbb{M}}\times\cdots\times{\mathbb{M}}\times{{\mathbb{E}}};\mathbb{M}^{{\mathbb{Z}}_{\sf p}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝕄</mi><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi>𝕄</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝔼</mi><mo>;</mo><msup><mi>𝕄</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{M}}\times\cdots\times{\mathbb{M}}\times{{\mathbb{E}}};\mathbb{M}^{{\mathbb{Z}}_{\sf p}})</annotation></semantics></math>, it is <math id="S24.Thmthm1.p1.m5" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-equivariant.</span></p>
</div>
</div>
<div id="S24.SS1.SSS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S24.SS1.SSS1.p6" class="ltx_para">
<p id="S24.SS1.SSS1.p6.1" class="ltx_p"><span id="S24.SS1.SSS1.p6.1.1" class="ltx_text">This follows from the usual description of compactifications of moduli spaces of broken Morse trajectories and our choice of Novikov group actions. Note that the sphere bubbles in the Gromov compactification do not introduce new strata.
∎</span></p>
</div>
</div>
<div id="S24.SS1.SSS1.p7" class="ltx_para ltx_noindent">
<p id="S24.SS1.SSS1.p7.1" class="ltx_p">Now we state the technical theorem leading to the definition of the quantum Steenrod operation. Notice that the involved flow categories are already enriched in the category of stratified smooth manifolds, in particular, the category <math id="S24.SS1.SSS1.p7.m1" class="ltx_Math" alttext="\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}" display="inline" intent=":literal"><semantics><msubsup><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><mi>rig</mi><mi>NC</mi></msubsup><annotation encoding="application/x-tex">\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}</annotation></semantics></math>. Fix an outercollaring width.</p>
</div>
<div id="S24.Thmthm2" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S24.Thmthm2.2" class="ltx_text ltx_font_bold">Theorem 24.2</span></span><span id="S24.Thmthm2.3" class="ltx_text ltx_font_bold"> </span>(The AMS construction for quantum Steenrod operation)<span id="S24.Thmthm2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S24.Thmthm2.p1" class="ltx_para ltx_noindent">
<p id="S24.Thmthm2.p1.1" class="ltx_p"><span id="S24.Thmthm2.p1.1.1" class="ltx_text ltx_font_italic">Fix an outercollaring width.</span></p>
<ol id="S24.I1" class="ltx_enumerate">
<li id="S24.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S24.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="S24.I1.i1.p1.1" class="ltx_p"><span id="S24.I1.i1.p1.1.1" class="ltx_text ltx_font_italic">For any integral symplectic form </span><math id="S24.I1.i1.p1.m1" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math><span id="S24.I1.i1.p1.1.2" class="ltx_text ltx_font_italic"> tamed by </span><math id="S24.I1.i1.p1.m2" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math><span id="S24.I1.i1.p1.1.3" class="ltx_text ltx_font_italic">, there exists a class of lifts (called AMS lifts) of the outercollaring </span><math id="S24.I1.i1.p1.m3" class="ltx_math_unparsed" alttext="{}_{\lfloor}{\mathbb{X}}^{\mathbb{QSt}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝕏</mi><msup><mrow></mrow><mrow><mi>ℚ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}{\mathbb{X}}^{\mathbb{QSt}}</annotation></semantics></math><span id="S24.I1.i1.p1.1.4" class="ltx_text ltx_font_italic"> to </span><math id="S24.I1.i1.p1.m4" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>NC</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}</annotation></semantics></math><span id="S24.I1.i1.p1.1.5" class="ltx_text ltx_font_italic">, as a multimodule over </span><math id="S24.I1.i1.p1.m5" class="ltx_math_unparsed" alttext="({}_{\lfloor}{\mathbb{M}},\cdots,{}_{\lfloor}{\mathbb{M}},{}_{\lfloor}{{\mathbb{E}}};{}_{\lfloor}{\mathbb{M}}^{{\mathbb{E}}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝕄</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mmultiscripts><mi>𝕄</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mo>,</mo><mmultiscripts><mi>𝔼</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mo>;</mo><mmultiscripts><mi>𝕄</mi><mrow></mrow><mi>𝔼</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({}_{\lfloor}{\mathbb{M}},\cdots,{}_{\lfloor}{\mathbb{M}},{}_{\lfloor}{{\mathbb{E}}};{}_{\lfloor}{\mathbb{M}}^{{\mathbb{E}}})</annotation></semantics></math><span id="S24.I1.i1.p1.1.6" class="ltx_text ltx_font_italic">, which is equivariant with respect to the morphism (</span><a href="#S24.E1" title="In Proposition 24.1. ‣ 24.1.1. The flow categories and bimodules associated to quantum Steenrod operation ‣ 24.1. Geometric setup ‣ 24. Quantum Steenrod Operations—Proof of Theorem ‣ Part IV EQUIVARIANT FLOER THEORY AND STEENROD OPERATIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">24.1</span></a><span id="S24.I1.i1.p1.1.7" class="ltx_text ltx_font_italic">) and which is </span><math id="S24.I1.i1.p1.m6" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math><span id="S24.I1.i1.p1.1.8" class="ltx_text ltx_font_italic">-equivariant as a weak bimodule.</span></p>
</div></li>
<li id="S24.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S24.I1.i2.p1" class="ltx_para">
<p id="S24.I1.i2.p1.1" class="ltx_p"><span id="S24.I1.i2.p1.1.1" class="ltx_text ltx_font_italic">Any two AMS lifts of </span><math id="S24.I1.i2.p1.m1" class="ltx_Math" alttext="\mathbb{X}^{\mathbb{QSt}}" display="inline" intent=":literal"><semantics><msup><mi>𝕏</mi><mrow><mi>ℚ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{X}^{\mathbb{QSt}}</annotation></semantics></math><span id="S24.I1.i2.p1.1.2" class="ltx_text ltx_font_italic"> are equivariantly homotopic. Namely, if </span><math id="S24.I1.i2.p1.m2" class="ltx_Math" alttext="\tilde{\mathbb{X}}_{0}^{\mathbb{QSt}}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>𝕏</mi><mo>~</mo></mover><mn>0</mn><mrow><mi>ℚ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msubsup><annotation encoding="application/x-tex">\tilde{\mathbb{X}}_{0}^{\mathbb{QSt}}</annotation></semantics></math><span id="S24.I1.i2.p1.1.3" class="ltx_text ltx_font_italic"> and </span><math id="S24.I1.i2.p1.m3" class="ltx_Math" alttext="\tilde{\mathbb{X}}_{1}^{\mathbb{QSt}}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>𝕏</mi><mo>~</mo></mover><mn>1</mn><mrow><mi>ℚ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msubsup><annotation encoding="application/x-tex">\tilde{\mathbb{X}}_{1}^{\mathbb{QSt}}</annotation></semantics></math><span id="S24.I1.i2.p1.1.4" class="ltx_text ltx_font_italic"> are both AMS lifts of </span><math id="S24.I1.i2.p1.m4" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{X}^{\mathbb{QSt}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝕏</mi><msup><mrow></mrow><mrow><mi>ℚ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{X}^{\mathbb{QSt}}</annotation></semantics></math><span id="S24.I1.i2.p1.1.5" class="ltx_text ltx_font_italic">, then there exists a </span><math id="S24.I1.i2.p1.m5" class="ltx_Math" alttext="\mathbb{\Pi}_{\sf p}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">\mathbb{\Pi}_{\sf p}</annotation></semantics></math><span id="S24.I1.i2.p1.1.6" class="ltx_text ltx_font_italic">-equivariant lift of the trivial homotopy from </span><math id="S24.I1.i2.p1.m6" class="ltx_math_unparsed" alttext="{}_{\lfloor}{\mathbb{X}}^{\mathbb{QSt}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝕏</mi><msup><mrow></mrow><mrow><mi>ℚ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}{\mathbb{X}}^{\mathbb{QSt}}</annotation></semantics></math><span id="S24.I1.i2.p1.1.7" class="ltx_text ltx_font_italic"> to </span><math id="S24.I1.i2.p1.m7" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>NC</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}</annotation></semantics></math><span id="S24.I1.i2.p1.1.8" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S24.SS1.SSS1.p8" class="ltx_para ltx_noindent">
<p id="S24.SS1.SSS1.p8.1" class="ltx_p">The proof of this theorem is postponed to the end of this section. We first derive the consequence, i.e., the definition of the quantum Steenrod operation.</p>
</div>
<div id="S24.Thmthm3" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S24.Thmthm3.2" class="ltx_text ltx_font_italic">Remark 24.3</span></span><span id="S24.Thmthm3.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S24.Thmthm3.p1" class="ltx_para">
<p id="S24.Thmthm3.p1.1" class="ltx_p">One can also prove the corresponding result for the comparison of using different <math id="S24.Thmthm3.p1.m1" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math>’s. We omit the detailed statement.</p>
</div>
</div>
</section>
</section>
<section id="S24.SS2" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">24.2. </span>Steenrod operations</h4>

<div id="S24.SS2.p1" class="ltx_para ltx_noindent">
<p id="S24.SS2.p1.1" class="ltx_p">As the flow categories involved are already transverse, they themselves can be regarded as their FOP transverse perturbations. Then by Theorem <a href="#Thmthma14" title="Theorem N. ‣ 8.2. FOP perturbations on flow categories, multimodules, and homotopies ‣ 8. FOP Perturbations ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">N</span></a>, one can find a <math id="S24.SS2.p1.m1" class="ltx_Math" alttext="(\Pi\times{\mathbb{Z}})\rtimes{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Π</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>ℤ</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋊</mo><msub><mi>ℤ</mi><mi>𝗉</mi></msub></mrow><annotation encoding="application/x-tex">(\Pi\times{\mathbb{Z}})\rtimes{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-equivariant FOP transverse perturbation of <math id="S24.SS2.p1.m2" class="ltx_Math" alttext="\tilde{\mathbb{X}}^{\mathbb{QSt}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝕏</mi><mo>~</mo></mover><mrow><mi>ℚ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup><annotation encoding="application/x-tex">\tilde{\mathbb{X}}^{\mathbb{QSt}}</annotation></semantics></math>, whose isotropy free locus <math id="S24.SS2.p1.m3" class="ltx_Math" alttext="\mathring{\mathbb{X}}^{\mathbb{QSt}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝕏</mi><mo>̊</mo></mover><mrow><mi>ℚ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup><annotation encoding="application/x-tex">\mathring{\mathbb{X}}^{\mathbb{QSt}}</annotation></semantics></math> is a multimodule enriched in <math id="S24.SS2.p1.m4" class="ltx_Math" alttext="\underline{\smash{{\bf\Psi}{\bf Man}}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mrow><mi>𝚿</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐌𝐚𝐧</mi></mrow><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{{\bf\Psi}{\bf Man}}}</annotation></semantics></math>. Notice that equivariant feature of Theorem <a href="#Thmthma14" title="Theorem N. ‣ 8.2. FOP perturbations on flow categories, multimodules, and homotopies ‣ 8. FOP Perturbations ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">N</span></a> guarantees that all existing symmetries can be respected by the FOP transverse perturbation.</p>
</div>
<div id="S24.SS2.p2" class="ltx_para ltx_noindent">
<p id="S24.SS2.p2.1" class="ltx_p">Then by Proposition <a href="#S7.Thmthm18" title="Proposition 7.18. ‣ 7.2.3. Chain maps and homotopies ‣ 7.2. Algebraic structures without symmetry ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.18</span></a> and Proposition <a href="#S7.Thmthm32" title="Proposition 7.32. ‣ 7.4.2. Multimodules and homotopies ‣ 7.4. Algebraic structures with symmetry ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.32</span></a>, one obtains a chain map</p>
<table id="S24.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S24.Ex13.m1" class="ltx_Math" alttext="\widetilde{\Phi}^{\mathbb{QSt}}:=\left(\left(\overbrace{C({\mathbb{M}})\widehat{\underset{{\bf F}_{\sf p}}{\otimes}}\cdots\widehat{\underset{{\bf F}_{\sf p}}{\otimes}}C({\mathbb{M}})}^{{\sf p}}\right)\widehat{\underset{{\bf F}_{\sf p}}{\otimes}}C({{\mathbb{E}}})\right)\underset{\Lambda^{\Pi^{{\sf p}}\times{\mathbb{Z}}}}{\otimes}\Lambda^{\mathbb{\Pi}}\to C({\mathbb{M}}\#{{\mathbb{E}}})." display="block" intent=":literal"><semantics><mrow><mrow><msup><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mrow><mi>ℚ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup><mo>:=</mo><mrow><mrow><mo>(</mo><mrow><mrow><mo>(</mo><mover><mover accent="true"><mrow><mi>C</mi><mo stretchy="false">(</mo><mi>𝕄</mi><mo rspace="0.055em" stretchy="false">)</mo><munderover accent="true" accentunder="true"><mo>⊗</mo><msub><mi mathsize="0.700em">𝐅</mi><mi mathsize="0.710em">𝗉</mi></msub><mo>^</mo></munderover><mo lspace="0.055em" rspace="0.055em">⋯</mo><munderover accent="true" accentunder="true"><mo rspace="0.222em">⊗</mo><msub><mi mathsize="0.700em">𝐅</mi><mi mathsize="0.710em">𝗉</mi></msub><mo>^</mo></munderover><mi>C</mi><mo stretchy="false">(</mo><mi>𝕄</mi><mo stretchy="false">)</mo></mrow><mo stretchy="true">⏞</mo></mover><mi>𝗉</mi></mover><mo>)</mo></mrow><mo lspace="0.222em" rspace="0em">​</mo><munderover accent="true" accentunder="true"><mo>⊗</mo><msub><mi mathsize="0.700em">𝐅</mi><mi mathsize="0.710em">𝗉</mi></msub><mo>^</mo></munderover><mo lspace="0.222em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝔼</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mo lspace="0.222em" rspace="0em">​</mo><munder accentunder="true"><mo>⊗</mo><msup><mi mathsize="0.700em" mathvariant="normal">Λ</mi><mrow><msup><mi mathsize="0.710em" mathvariant="normal">Π</mi><mi>𝗉</mi></msup><mo lspace="0.222em" mathsize="0.710em" rspace="0.222em">×</mo><mi mathsize="0.710em">ℤ</mi></mrow></msup></munder><mo lspace="0.222em" rspace="0em">​</mo><msup><mi mathvariant="normal">Λ</mi><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi></msup></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widetilde{\Phi}^{\mathbb{QSt}}:=\left(\left(\overbrace{C({\mathbb{M}})\widehat{\underset{{\bf F}_{\sf p}}{\otimes}}\cdots\widehat{\underset{{\bf F}_{\sf p}}{\otimes}}C({\mathbb{M}})}^{{\sf p}}\right)\widehat{\underset{{\bf F}_{\sf p}}{\otimes}}C({{\mathbb{E}}})\right)\underset{\Lambda^{\Pi^{{\sf p}}\times{\mathbb{Z}}}}{\otimes}\Lambda^{\mathbb{\Pi}}\to C({\mathbb{M}}\#{{\mathbb{E}}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S24.SS2.p2.2" class="ltx_p">The restriction to the <math id="S24.SS2.p2.m1" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-invariant part is denoted by <math id="S24.SS2.p2.m2" class="ltx_Math" alttext="\Phi^{\mathbb{QSt}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mrow><mi>ℚ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup><annotation encoding="application/x-tex">\Phi^{\mathbb{QSt}}</annotation></semantics></math>.</p>
</div>
<div id="S24.Thmthm4" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S24.Thmthm4.2" class="ltx_text ltx_font_bold">Proposition 24.4</span></span><span id="S24.Thmthm4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S24.Thmthm4.p1" class="ltx_para">
<p id="S24.Thmthm4.p1.1" class="ltx_p"><span id="S24.Thmthm4.p1.1.1" class="ltx_text ltx_font_italic">Up to chain homotopy, the map <math id="S24.Thmthm4.p1.m1" class="ltx_Math" alttext="\widetilde{\Phi}^{\mathbb{QSt}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mrow><mi>ℚ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup><annotation encoding="application/x-tex">\widetilde{\Phi}^{\mathbb{QSt}}</annotation></semantics></math> does not depend on choices.</span></p>
</div>
</div>
<div id="S24.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S24.SS2.p3" class="ltx_para">
<p id="S24.SS2.p3.1" class="ltx_p"><span id="S24.SS2.p3.1.1" class="ltx_text">This follows from Part (2) of Theorem <a href="#S24.Thmthm2" title="Theorem 24.2 (The AMS construction for quantum Steenrod operation). ‣ 24.1.1. The flow categories and bimodules associated to quantum Steenrod operation ‣ 24.1. Geometric setup ‣ 24. Quantum Steenrod Operations—Proof of Theorem ‣ Part IV EQUIVARIANT FLOER THEORY AND STEENROD OPERATIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24.2</span></a> and the homotopy case of Theorem <a href="#Thmthma14" title="Theorem N. ‣ 8.2. FOP perturbations on flow categories, multimodules, and homotopies ‣ 8. FOP Perturbations ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">N</span></a>.
∎</span></p>
</div>
</div>
<div id="S24.SS2.p4" class="ltx_para ltx_noindent">
<p id="S24.SS2.p4.1" class="ltx_p">It reduces to a linear map between homology, which, in <math id="S24.SS2.p4.m1" class="ltx_Math" alttext="{\bf F}_{\sf p}" display="inline" intent=":literal"><semantics><msub><mi>𝐅</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{\bf F}_{\sf p}</annotation></semantics></math>-coefficients, reads</p>
<table id="S24.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S24.Ex14.m1" class="ltx_Math" alttext="\Phi^{\mathbb{QSt}}:H_{{{\mathbb{Z}}_{\sf p}}}(C(\mathbb{M})^{\otimes{\sf p}})\to H(\mathbb{M}^{{{\mathbb{Z}}_{\sf p}}})." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">Φ</mi><mrow><mi>ℚ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>𝕄</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝕄</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Phi^{\mathbb{QSt}}:H_{{{\mathbb{Z}}_{\sf p}}}(C(\mathbb{M})^{\otimes{\sf p}})\to H(\mathbb{M}^{{{\mathbb{Z}}_{\sf p}}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S24.SS2.p4.2" class="ltx_p">One can see that</p>
<table id="S24.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S24.Ex15.m1" class="ltx_Math" alttext="H_{{{\mathbb{Z}}_{\sf p}}}(C^{*}(\mathbb{M})^{\otimes{\sf p}})\cong H_{{{\mathbb{Z}}_{\sf p}}}(CM(f,g)^{\otimes{\sf p}})\otimes\Lambda_{{\bf F}_{\sf p}}^{\Pi}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>C</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>𝕄</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><mrow><msub><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H_{{{\mathbb{Z}}_{\sf p}}}(C^{*}(\mathbb{M})^{\otimes{\sf p}})\cong H_{{{\mathbb{Z}}_{\sf p}}}(CM(f,g)^{\otimes{\sf p}})\otimes\Lambda_{{\bf F}_{\sf p}}^{\Pi}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S24.SS2.p5" class="ltx_para ltx_noindent">
<p id="S24.SS2.p5.1" class="ltx_p">Then by pre-composing with the quasi-Frobenius map (<a href="#S23.E3" title="In 23.1.1. The algebraic construction ‣ 23.1. Tate Equivariant Cohomology ‣ 23. Equivariant Morse and Floer Cohomology ‣ Part IV EQUIVARIANT FLOER THEORY AND STEENROD OPERATIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23.3</span></a>) one obtains a map in homology</p>
<table id="S24.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S24.Ex16.m1" class="ltx_Math" alttext="\lx@xy@svg{\hbox{\raise 2.5pt\hbox{\kern 24.342pt\hbox{\ignorespaces\ignorespaces\ignorespaces\hbox{\vtop{\halign{\entry@#!@&amp;&amp;\entry@@#!@\cr&amp;&amp;&amp;\crcr}}}\ignorespaces{\hbox{\kern-24.342pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{HM(f,g)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 28.30986pt\raise 6.07222pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-1.71112pt\hbox{$\scriptstyle{qF}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 48.342pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 48.342pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{H_{{{\mathbb{Z}}_{\sf p}}}(CM(f,g)^{\otimes{\sf p}})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 155.46355pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 155.46355pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{H_{{{\mathbb{Z}}_{\sf p}}}(C({\mathbb{M}})^{\otimes{\sf p}})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 222.06766pt\raise 6.20831pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-3.20831pt\hbox{$\scriptstyle{\Phi^{\mathbb{QSt}}}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 245.97054pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 245.97054pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{H(C({\mathbb{M}}\#{\mathbb{E}}))}$}}}}}}}\ignorespaces}}}}\ignorespaces." display="block" intent=":literal"><semantics><mrow><mtext> <svg style="vertical-align:-12.414852283267175px" height="29.60" overflow="visible" version="1.1" viewBox="33.68 12.41 461.00 29.60" width="461.00"> <g transform="matrix(1 0 0 -1 33.682019149381226 29.595716705258923) translate(0,3.46) translate(33.68,0)"> <g transform="translate(-33.68,0) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:4.27em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="59.06"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow></span></span></foreignObject> </g> <path style="--ltx-stroke-color:#000000;" d="M 33.68204026296787 -0.27673578005007266 L 33.68204026296787 0.27673578005007266" fill="none" stroke="#000000"></path> <g transform="translate(39.17,0) translate(0,8.4) translate(4.15,0) translate(0,-2.37)"> <foreignObject style="--ltx-fo-width:1.01em;--ltx-fo-height:0.48em;--ltx-fo-depth:0.14em;font-size:10pt;" height="8.5" overflow="visible" transform="matrix(1 0 0 -1 0 6.62)" width="13.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mrow><mi mathsize="0.700em">q</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">F</mi></mrow></span></span></foreignObject> </g> <g transform="translate(66.89,0)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.8