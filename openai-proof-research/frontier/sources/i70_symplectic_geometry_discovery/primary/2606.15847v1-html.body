eight:0.94em;--ltx-fo-depth:0.43em;font-size:10pt;" height="19.02" overflow="visible" transform="matrix(1 0 0 -1 0 13.04)" width="137.14"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S14.Ex9.m1.pic1.m3" class="ltx_Math" alttext="\textstyle{M_{e_{j}}^{{\mathbb{f}}_{j}}\times M_{d_{j}+d+d^{\prime}}^{\mathbb{x}}\times M_{e^{\prime}}^{{\mathbb{f}}^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>M</mi><msub><mi>e</mi><mi>j</mi></msub><msub><mi>𝕗</mi><mi>j</mi></msub></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>M</mi><mrow><msub><mi>d</mi><mi>j</mi></msub><mo>+</mo><mi>d</mi><mo>+</mo><msup><mi>d</mi><mo>′</mo></msup></mrow><mi>𝕩</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>M</mi><msup><mi>e</mi><mo>′</mo></msup><msup><mi>𝕗</mi><mo>′</mo></msup></msubsup></mrow><annotation encoding="application/x-tex">\textstyle{M_{e_{j}}^{{\mathbb{f}}_{j}}\times M_{d_{j}+d+d^{\prime}}^{\mathbb{x}}\times M_{e^{\prime}}^{{\mathbb{f}}^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 72.72108306821426 -47.218066223828615 L 72.72108306821426 -46.664594663728465" fill="none" stroke="#000000"></path><g transform="translate(147.92,0) translate(0,-46.94)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 72.72108306821426 -47.218066223828615 L 147.91682628538163 -46.664594663728465" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 147.91682628538163 -47.218066223828615 L 147.91682628538163 -46.664594663728465" fill="none" stroke="#000000"></path><g transform="translate(147.92,0) translate(0,-46.94) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:6.88em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.43em;font-size:10pt;" height="15.44" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="95.21"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S14.Ex9.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{M_{e_{j}+d_{j}+d+d^{\prime}+e^{\prime}}^{\mathbb{x}}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mrow><msub><mi>e</mi><mi>j</mi></msub><mo>+</mo><msub><mi>d</mi><mi>j</mi></msub><mo>+</mo><mi>d</mi><mo>+</mo><msup><mi>d</mi><mo>′</mo></msup><mo>+</mo><msup><mi>e</mi><mo>′</mo></msup></mrow><mi>𝕩</mi></msubsup><annotation encoding="application/x-tex">\textstyle{M_{e_{j}+d_{j}+d+d^{\prime}+e^{\prime}}^{\mathbb{x}}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
