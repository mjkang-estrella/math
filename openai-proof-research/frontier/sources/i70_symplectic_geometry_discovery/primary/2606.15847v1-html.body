<li id="S14.I7.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S14.I7.i4.p1" class="ltx_para ltx_noindent">
<p id="S14.I7.i4.p1.1" class="ltx_p"><span id="S14.I7.i4.p1.1.1" class="ltx_text ltx_font_italic">For each decomposition </span><math id="S14.I7.i4.p1.m1" class="ltx_Math" alttext="d=d_{1}+d_{2}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><msub><mi>d</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">d=d_{1}+d_{2}</annotation></semantics></math><span id="S14.I7.i4.p1.1.2" class="ltx_text ltx_font_italic">, </span><math id="S14.I7.i4.p1.m2" class="ltx_math_unparsed" alttext="x_{1}\in{}_{\lfloor}B_{d_{1}}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><msub><mrow></mrow><mn>1</mn></msub><mo>∈</mo><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>B</mi><msub><mrow></mrow><msub><mi>d</mi><mn>1</mn></msub></msub></mrow><annotation encoding="application/x-tex">x_{1}\in{}_{\lfloor}B_{d_{1}}</annotation></semantics></math><span id="S14.I7.i4.p1.1.3" class="ltx_text ltx_font_italic">, </span><math id="S14.I7.i4.p1.m3" class="ltx_math_unparsed" alttext="x_{2}\in{}_{\lfloor}B_{d_{2}}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><msub><mrow></mrow><mn>2</mn></msub><mo>∈</mo><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>B</mi><msub><mrow></mrow><msub><mi>d</mi><mn>2</mn></msub></msub></mrow><annotation encoding="application/x-tex">x_{2}\in{}_{\lfloor}B_{d_{2}}</annotation></semantics></math><span id="S14.I7.i4.p1.1.4" class="ltx_text ltx_font_italic">, </span><math id="S14.I7.i4.p1.m4" class="ltx_Math" alttext="q_{1}\in Q_{d_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mn>1</mn></msub><mo>∈</mo><msub><mi>Q</mi><msub><mi>d</mi><mn>1</mn></msub></msub></mrow><annotation encoding="application/x-tex">q_{1}\in Q_{d_{1}}</annotation></semantics></math><span id="S14.I7.i4.p1.1.5" class="ltx_text ltx_font_italic">, </span><math id="S14.I7.i4.p1.m5" class="ltx_Math" alttext="q_{2}\in Q_{d_{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mn>2</mn></msub><mo>∈</mo><msub><mi>Q</mi><msub><mi>d</mi><mn>2</mn></msub></msub></mrow><annotation encoding="application/x-tex">q_{2}\in Q_{d_{2}}</annotation></semantics></math><span id="S14.I7.i4.p1.1.6" class="ltx_text ltx_font_italic">, and </span><math id="S14.I7.i4.p1.m6" class="ltx_Math" alttext="v\in Q_{d_{1},d_{2}}" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><msub><mi>Q</mi><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub></mrow></msub></mrow><annotation encoding="application/x-tex">v\in Q_{d_{1},d_{2}}</annotation></semantics></math><span id="S14.I7.i4.p1.1.7" class="ltx_text ltx_font_italic"> with </span><math id="S14.I7.i4.p1.m7" class="ltx_Math" alttext="|v|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi>v</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|v|</annotation></semantics></math><span id="S14.I7.i4.p1.1.8" class="ltx_text ltx_font_italic"> sufficiently small, one has</span></p>
