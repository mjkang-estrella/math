<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S6.Ex65.m1.pic1" class="ltx_picture ltx_markedasmath" height="73.37" overflow="visible" style="vertical-align:-59.64146950968374px" version="1.1" viewBox="94.81 59.64 416.74 73.37" width="416.74"><g transform="matrix(1 0 0 -1 94.81203874414089 73.37402073496091) translate(0,3.46) translate(94.81,0)"><g transform="translate(-94.81,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:13.1em;--ltx-fo-height:0.94em;--ltx-fo-depth:0.38em;font-size:10pt;" height="18.23" overflow="visible" transform="matrix(1 0 0 -1 0 13.04)" width="181.32"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex65.m1.pic1.m1" class="ltx_math_unparsed" alttext="\textstyle{M_{p_{1}\cdots p_{m};r_{i}}^{\mathbb{X}}\times M_{r_{1}\cdots r_{n};s^{\prime}}^{\mathbb{Y}}\times M_{s^{\prime}r^{\prime}}^{{\mathbb{G}}^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>r</mi><msub><mrow></mrow><mi>i</mi></msub></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi><msub><mrow></mrow><mrow><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>n</mi></msub><mo>;</mo><mi>s</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕐</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi><msub><mrow></mrow><mrow><msup><mi>s</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><msup><mi>𝔾</mi><mo>′</mo></msup></msup></mrow><annotation encoding="application/x-tex">\textstyle{M_{p_{1}\cdots p_{m};r_{i}}^{\mathbb{X}}\times M_{r_{1}\cdots r_{n};s^{\prime}}^{\mathbb{Y}}\times M_{s^{\prime}r^{\prime}}^{{\mathbb{G}}^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 94.81205985772753 -0.27673578005007266 L 94.81205985772753 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(128.02,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 94.81205985772753 -0.27673578005007266 L 128.0208390762289 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 128.0208390762289 -0.27673578005007266 L 128.0208390762289 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -12.80080864699002 L 0.27673578005007266 -12.80080864699002" fill="none" stroke="#000000"></path><g transform="translate(0,-33.91)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.909116887247905 L 0.27673578005007266 -12.80080864699002" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.909116887247905 L 0.27673578005007266 -33.909116887247905" fill="none" stroke="#000000"></path><g transform="translate(128.02,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:13.41em;--ltx-fo-height:0.94em;--ltx-fo-depth:0.42em;font-size:10pt;" height="18.83" overflow="visible" transform="matrix(1 0 0 -1 0 13.04)" width="185.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex65.m1.pic1.m2" class="ltx_math_unparsed" alttext="\textstyle{M_{r_{1}\cdots r_{i-1}p_{1}\cdots p_{m}r_{i+1}\cdots r_{n};s^{\prime}}^{{\mathbb{X}}\circ_{i}{\mathbb{Y}}}\times M_{s^{\prime}r^{\prime}}^{{\mathbb{G}}^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mi>r</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>n</mi></msub><mo>;</mo><mi>s</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mrow><mi>𝕏</mi><msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>i</mi></msub><mi>𝕐</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi><msub><mrow></mrow><mrow><msup><mi>s</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><msup><mi>𝔾</mi><mo>′</mo></msup></msup></mrow><annotation encoding="application/x-tex">\textstyle{M_{r_{1}\cdots r_{i-1}p_{1}\cdots p_{m}r_{i+1}\cdots r_{n};s^{\prime}}^{{\mathbb{X}}\circ_{i}{\mathbb{Y}}}\times M_{s^{\prime}r^{\prime}}^{{\mathbb{G}}^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 224.6983687676746 -13.400455621065102 L 225.25184032777474 -13.400455621065102" fill="none" stroke="#000000"></path><g transform="translate(224.98,0) translate(0,-33.91)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 224.6983687676746 -33.909116887247905 L 225.25184032777474 -13.400455621065102" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 224.6983687676746 -33.909116887247905 L 225.25184032777474 -33.909116887247905" fill="none" stroke="#000000"></path><g transform="translate(-71.12,0) translate(0,-46.24) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:9.68em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.38em;font-size:10pt;" height="16.83" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="133.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex65.m1.pic1.m3" class="ltx_math_unparsed" alttext="\textstyle{M_{p_{1}\cdots p_{m};r_{i}}^{{\mathbb{X}}}\times M_{r_{1}\cdots r_{n};r^{\prime}}^{{\mathbb{Y}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>r</mi><msub><mrow></mrow><mi>i</mi></msub></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi><msub><mrow></mrow><mrow><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>n</mi></msub><mo>;</mo><mi>r</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕐</mi></msup></mrow><annotation encoding="application/x-tex">\textstyle{M_{p_{1}\cdots p_{m};r_{i}}^{{\mathbb{X}}}\times M_{r_{1}\cdots r_{n};r^{\prime}}^{{\mathbb{Y}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 71.11617600718226 -46.517749668668706 L 71.11617600718226 -45.964278108568564" fill="none" stroke="#000000"></path><g transform="translate(151.72,0) translate(0,-46.24)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 71.11617600718226 -46.517749668668706 L 151.71672292677417 -45.964278108568564" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 151.71672292677417 -46.517749668668706 L 151.71672292677417 -45.964278108568564" fill="none" stroke="#000000"></path><g transform="translate(151.72,0) translate(0,-46.24) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:9.99em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.42em;font-size:10pt;" height="17.43" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="138.22"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex65.m1.pic1.m4" class="ltx_math_unparsed" alttext="\textstyle{M_{r_{1}\cdots r_{i-1}p_{1}\cdots p_{m}r_{i+1}\cdots r_{n};r^{\prime}}^{{\mathbb{X}}\circ_{i}{\mathbb{Y}}}}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mi>r</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>n</mi></msub><mo>;</mo><mi>r</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mrow><mi>𝕏</mi><msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>i</mi></msub><mi>𝕐</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\textstyle{M_{r_{1}\cdots r_{i-1}p_{1}\cdots p_{m}r_{i+1}\cdots r_{n};r^{\prime}}^{{\mathbb{X}}\circ_{i}{\mathbb{Y}}}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
</div>
</div>
<div id="S6.SS5.SSS2.p2" class="ltx_para ltx_noindent">
<p id="S6.SS5.SSS2.p2.1" class="ltx_p">We can see that the previously discussed canonical construction of concatenations satisfies the above definition. On the other hand, in many situations, the construction of the concatenation <math id="S6.SS5.SSS2.p2.m1" class="ltx_Math" alttext="{\mathbb{X}}\circ_{i}{\mathbb{Y}}" display="inline" intent=":literal"><semantics><mrow><mi>𝕏</mi><msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>i</mi></msub><mi>𝕐</mi></mrow><annotation encoding="application/x-tex">{\mathbb{X}}\circ_{i}{\mathbb{Y}}</annotation></semantics></math> is not canonical but involves choices one needs to make.</p>
</div>
<div id="S6.Thmthm14" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm14.2" class="ltx_text ltx_font_italic">Remark 6.14</span></span><span id="S6.Thmthm14.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S6.Thmthm14.p1" class="ltx_para">
<p id="S6.Thmthm14.p1.1" class="ltx_p">We would like to reiterate that in Definition <a href="#S6.Thmthm13" title="Definition 6.13. ‣ 6.5.2. General concatenations ‣ 6.5. Multimodule concatenations ‣ 6. Flow Categories, Multimodules, and Homotopies ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.13</span></a>, <math id="S6.Thmthm14.p1.m1" class="ltx_Math" alttext="{\mathbb{X}}\circ_{i}{\mathbb{Y}}" display="inline" intent=":literal"><semantics><mrow><mi>𝕏</mi><msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>i</mi></msub><mi>𝕐</mi></mrow><annotation encoding="application/x-tex">{\mathbb{X}}\circ_{i}{\mathbb{Y}}</annotation></semantics></math> is part of the data: we do not construct <math id="S6.Thmthm14.p1.m2" class="ltx_Math" alttext="{\mathbb{X}}\circ_{i}{\mathbb{Y}}" display="inline" intent=":literal"><semantics><mrow><mi>𝕏</mi><msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>i</mi></msub><mi>𝕐</mi></mrow><annotation encoding="application/x-tex">{\mathbb{X}}\circ_{i}{\mathbb{Y}}</annotation></semantics></math> using <math id="S6.Thmthm14.p1.m3" class="ltx_Math" alttext="{\mathbb{X}}" display="inline" intent=":literal"><semantics><mi>𝕏</mi><annotation encoding="application/x-tex">{\mathbb{X}}</annotation></semantics></math> and <math id="S6.Thmthm14.p1.m4" class="ltx_Math" alttext="{\mathbb{Y}}" display="inline" intent=":literal"><semantics><mi>𝕐</mi><annotation encoding="application/x-tex">{\mathbb{Y}}</annotation></semantics></math>. This is in contrast with the gluing construction in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib1" title="" class="ltx_ref">2</a>, Section 5]</cite>, where the concatenation is carried out for bimodules enriched in <math id="S6.Thmthm14.p1.m5" class="ltx_Math" alttext="\underline{\smash{\bf dOrb}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf dOrb}}</annotation></semantics></math> by thickening up the boundary strata. In our applications, all <math id="S6.Thmthm14.p1.m6" class="ltx_Math" alttext="{\mathbb{X}}\circ_{i}{\mathbb{Y}}" display="inline" intent=":literal"><semantics><mrow><mi>𝕏</mi><msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>i</mi></msub><mi>𝕐</mi></mrow><annotation encoding="application/x-tex">{\mathbb{X}}\circ_{i}{\mathbb{Y}}</annotation></semantics></math> arise from geometric context, and the notations in Definition <a href="#S6.Thmthm13" title="Definition 6.13. ‣ 6.5.2. General concatenations ‣ 6.5. Multimodule concatenations ‣ 6. Flow Categories, Multimodules, and Homotopies ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.13</span></a> already ensure the desired chain-level statements.</p>
</div>
</div>
</section>
</section>
<section id="S6.SS6" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">6.6. </span>Weak flow categories, bimodules, and homotopies</h4>

<div id="S6.SS6.p1" class="ltx_para ltx_noindent">
<p id="S6.SS6.p1.1" class="ltx_p">In certain cases it is convenient to use the notion of direct products of flow categories, which satisfy a weaker version of Definition <a href="#S6.Thmthm1" title="Definition 6.1 (Flow categories). ‣ 6.1. Flow categories ‣ 6. Flow Categories, Multimodules, and Homotopies ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.1</span></a>. We make the following definitions in order to have a simple formulation of certain structures on multimodules involved in the equivariant pair-of-pants product.</p>
</div>
<div id="S6.Thmthm15" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm15.2" class="ltx_text ltx_font_bold">Definition 6.15</span></span><span id="S6.Thmthm15.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmthm15.p1" class="ltx_para">
<p id="S6.Thmthm15.p1.1" class="ltx_p">A <span id="S6.Thmthm15.p1.1.1" class="ltx_text ltx_font_bold">weak flow category</span> enriched in <math id="S6.Thmthm15.p1.m1" class="ltx_Math" alttext="\underline{\smash{\bf C}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐂</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf C}}</annotation></semantics></math>, denoted by <math id="S6.Thmthm15.p1.m2" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math>, consists of a countable partially ordered set of objects <math id="S6.Thmthm15.p1.m3" class="ltx_Math" alttext="{\rm Ob}{\mathbb{F}}" display="inline" intent=":literal"><semantics><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow><annotation encoding="application/x-tex">{\rm Ob}{\mathbb{F}}</annotation></semantics></math> and a morphism space <math id="S6.Thmthm15.p1.m4" class="ltx_Math" alttext="M_{pq}^{\mathbb{F}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><annotation encoding="application/x-tex">M_{pq}^{\mathbb{F}}</annotation></semantics></math> as an object of <math id="S6.Thmthm15.p1.m5" class="ltx_Math" alttext="\underline{\smash{\bf C}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐂</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf C}}</annotation></semantics></math> for each pair <math id="S6.Thmthm15.p1.m6" class="ltx_Math" alttext="p\leq q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>≤</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p\leq q</annotation></semantics></math>, and composition maps <math id="S6.Thmthm15.p1.m7" class="ltx_Math" alttext="\iota_{prq}^{\mathbb{F}}:M_{pr}^{\mathbb{F}}\times M_{rq}^{\mathbb{F}}\to M_{pq}^{\mathbb{F}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ι</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mi>𝔽</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>M</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup></mrow><mo stretchy="false">→</mo><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\iota_{prq}^{\mathbb{F}}:M_{pr}^{\mathbb{F}}\times M_{rq}^{\mathbb{F}}\to M_{pq}^{\mathbb{F}}</annotation></semantics></math> (whose underlying poset map is not necessarily homogeneous of degree <math id="S6.Thmthm15.p1.m8" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>) which satisfy (1)—(5) of Definition <a href="#S6.Thmthm1" title="Definition 6.1 (Flow categories). ‣ 6.1. Flow categories ‣ 6. Flow Categories, Multimodules, and Homotopies ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.1</span></a>.</p>
</div>
</div>
<div id="S6.Thmthm16" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm16.2" class="ltx_text ltx_font_italic">Example 6.16</span></span><span id="S6.Thmthm16.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S6.Thmthm16.p1" class="ltx_para ltx_noindent">
<p id="S6.Thmthm16.p1.1" class="ltx_p">Let <math id="S6.Thmthm16.p1.m1" class="ltx_Math" alttext="{\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔽</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔽</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">{\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m}</annotation></semantics></math> be (weak) flow categories. Define <math id="S6.Thmthm16.p1.m2" class="ltx_math_unparsed" alttext="{\mathbb{F}}_{1}\times\cdots\times{\mathbb{F}}_{m}" display="inline" intent=":literal"><semantics><mrow><mi>𝔽</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi>𝔽</mi><msub><mrow></mrow><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">{\mathbb{F}}_{1}\times\cdots\times{\mathbb{F}}_{m}</annotation></semantics></math> as a weak flow category with</p>
<table id="S6.Ex66" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex66.m1" class="ltx_math_unparsed" alttext="{\rm Ob}{\mathbb{F}}_{1}\times\cdots\times{\mathbb{F}}_{m}=\prod_{j=1}^{m}{\rm Ob}{\mathbb{F}}_{j}," display="block" intent=":literal"><semantics><mrow><mi>Ob</mi><mi>𝔽</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi>𝔽</mi><msub><mrow></mrow><mi>m</mi></msub><mo rspace="0.111em">=</mo><mo movablelimits="false">∏</mo><msub><mrow></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>m</mi></msup><mi>Ob</mi><mi>𝔽</mi><msub><mrow></mrow><mi>j</mi></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">{\rm Ob}{\mathbb{F}}_{1}\times\cdots\times{\mathbb{F}}_{m}=\prod_{j=1}^{m}{\rm Ob}{\mathbb{F}}_{j},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.Thmthm16.p1.2" class="ltx_p">morphism spaces</p>
<table id="S6.Ex67" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex67.m1" class="ltx_math_unparsed" alttext="M_{(p_{1}\cdots p_{m})(q_{1}\cdots q_{m})}^{{\mathbb{F}}_{1}\times\cdots\times{\mathbb{F}}_{m}}=\prod_{j=1}^{m}M_{p_{j}q_{j}}^{{\mathbb{F}}_{j}}," display="block" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">(</mo><mi>q</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>q</mi><msub><mrow></mrow><mi>m</mi></msub><mo stretchy="false">)</mo></mrow></msub><msup><mrow></mrow><mrow><mi>𝔽</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi>𝔽</mi><msub><mrow></mrow><mi>m</mi></msub></mrow></msup><mo rspace="0.111em">=</mo><mo movablelimits="false">∏</mo><msub><mrow></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>m</mi></msup><mi>M</mi><msub><mrow></mrow><mrow><msub><mi>p</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>j</mi></msub></mrow></msub><msup><mrow></mrow><msub><mi>𝔽</mi><mi>j</mi></msub></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">M_{(p_{1}\cdots p_{m})(q_{1}\cdots q_{m})}^{{\mathbb{F}}_{1}\times\cdots\times{\mathbb{F}}_{m}}=\prod_{j=1}^{m}M_{p_{j}q_{j}}^{{\mathbb{F}}_{j}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.Thmthm16.p1.3" class="ltx_p">and product structural maps.</p>
</div>
</div>
<div id="S6.SS6.p2" class="ltx_para ltx_noindent">
<p id="S6.SS6.p2.1" class="ltx_p">We can also define the similar notion of weak multimodules.</p>
</div>
<div id="S6.Thmthm17" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm17.2" class="ltx_text ltx_font_bold">Definition 6.17</span></span><span id="S6.Thmthm17.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmthm17.p1" class="ltx_para">
<p id="S6.Thmthm17.p1.1" class="ltx_p">Let <math id="S6.Thmthm17.p1.m1" class="ltx_Math" alttext="{\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m};{\mathbb{F}}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔽</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo>;</mo><msup><mi>𝔽</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">{\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m};{\mathbb{F}}^{\prime}</annotation></semantics></math> be weak flow categories enriched in <math id="S6.Thmthm17.p1.m2" class="ltx_Math" alttext="\underline{\smash{\bf C}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐂</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf C}}</annotation></semantics></math>. A <span id="S6.Thmthm17.p1.1.1" class="ltx_text ltx_font_bold">weak multimodule</span> <math id="S6.Thmthm17.p1.m3" class="ltx_Math" alttext="{\mathbb{X}}" display="inline" intent=":literal"><semantics><mi>𝕏</mi><annotation encoding="application/x-tex">{\mathbb{X}}</annotation></semantics></math> over <math id="S6.Thmthm17.p1.m4" class="ltx_Math" alttext="({\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m};{\mathbb{F}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo>,</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m};{\mathbb{F}}^{\prime})</annotation></semantics></math> consists of the same type of objects <math id="S6.Thmthm17.p1.m5" class="ltx_math_unparsed" alttext="M_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup></mrow><annotation encoding="application/x-tex">M_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}</annotation></semantics></math> and structural maps (whose underlying poset map is not necessarily homogeneous of degree <math id="S6.Thmthm17.p1.m6" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>) satisfying conditions (1)–(4) of Definition <a href="#S6.Thmthm3" title="Definition 6.3. ‣ 6.2. Flow multimodules and homotopies ‣ 6. Flow Categories, Multimodules, and Homotopies ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.3</span></a>.</p>
</div>
</div>
<div id="S6.SS6.p3" class="ltx_para ltx_noindent">
<p id="S6.SS6.p3.1" class="ltx_p">The following lemma is readily checked.</p>
</div>
<div id="S6.Thmthm18" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm18.2" class="ltx_text ltx_font_bold">Lemma 6.18</span></span><span id="S6.Thmthm18.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmthm18.p1" class="ltx_para">
<p id="S6.Thmthm18.p1.1" class="ltx_p"><span id="S6.Thmthm18.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S6.Thmthm18.p1.m1" class="ltx_Math" alttext="{\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m},{\mathbb{F}}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔽</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo>,</mo><msup><mi>𝔽</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">{\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m},{\mathbb{F}}^{\prime}</annotation></semantics></math> be flow categories enriched in <math id="S6.Thmthm18.p1.m2" class="ltx_Math" alttext="\underline{\smash{\bf C}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐂</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf C}}</annotation></semantics></math>. Let <math id="S6.Thmthm18.p1.m3" class="ltx_Math" alttext="{\mathbb{X}}" display="inline" intent=":literal"><semantics><mi>𝕏</mi><annotation encoding="application/x-tex">{\mathbb{X}}</annotation></semantics></math> be a multimodule over <math id="S6.Thmthm18.p1.m4" class="ltx_Math" alttext="({\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m};{\mathbb{F}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo>,</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m};{\mathbb{F}}^{\prime})</annotation></semantics></math>. Then the objects <math id="S6.Thmthm18.p1.m5" class="ltx_math_unparsed" alttext="M_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup></mrow><annotation encoding="application/x-tex">M_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}</annotation></semantics></math> and structural maps in <math id="S6.Thmthm18.p1.m6" class="ltx_Math" alttext="{\mathbb{X}}" display="inline" intent=":literal"><semantics><mi>𝕏</mi><annotation encoding="application/x-tex">{\mathbb{X}}</annotation></semantics></math> define a weak bimodule over <math id="S6.Thmthm18.p1.m7" class="ltx_math_unparsed" alttext="({\mathbb{F}}_{1}\times\cdots\times{\mathbb{F}}_{m};{\mathbb{F}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo>;</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{1}\times\cdots\times{\mathbb{F}}_{m};{\mathbb{F}}^{\prime})</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S6.SS6.p4" class="ltx_para ltx_noindent">
<p id="S6.SS6.p4.1" class="ltx_p">The following notion is introduced merely to simplify the formulation of multimodule concatenations. It is not the same as the more geometric bimodule obtained via continuation maps.</p>
</div>
<div id="S6.Thmthm19" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm19.2" class="ltx_text ltx_font_bold">Definition 6.19</span></span><span id="S6.Thmthm19.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmthm19.p1" class="ltx_para ltx_noindent">
<p id="S6.Thmthm19.p1.1" class="ltx_p">Let <math id="S6.Thmthm19.p1.m1" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> be a (weak) flow category. The <span id="S6.Thmthm19.p1.1.1" class="ltx_text ltx_font_bold">naive identity bimodule</span> of <math id="S6.Thmthm19.p1.m2" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math>, denoted by <math id="S6.Thmthm19.p1.m3" class="ltx_Math" alttext="{\mathbb{I}}^{\mathbb{FF}}" display="inline" intent=":literal"><semantics><msup><mi>𝕀</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">{\mathbb{I}}^{\mathbb{FF}}</annotation></semantics></math>, is the weak bimodule over <math id="S6.Thmthm19.p1.m4" class="ltx_Math" alttext="({\mathbb{F}};{\mathbb{F}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝔽</mi><mo>;</mo><mi>𝔽</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}};{\mathbb{F}})</annotation></semantics></math> with</p>
<table id="S6.Ex68" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex68.m1" class="ltx_Math" alttext="M_{p;q}^{{\mathbb{I}}^{\mathbb{FF}}}=M_{pq}^{\mathbb{F}}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>M</mi><mrow><mi>p</mi><mo>;</mo><mi>q</mi></mrow><msup><mi>𝕀</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup></msubsup><mo>=</mo><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup></mrow><annotation encoding="application/x-tex">M_{p;q}^{{\mathbb{I}}^{\mathbb{FF}}}=M_{pq}^{\mathbb{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.Thmthm19.p1.2" class="ltx_p">and structural maps induced from composition maps of <math id="S6.Thmthm19.p1.m5" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math>.</p>
</div>
</div>
<div id="S6.SS6.p5" class="ltx_para ltx_noindent">
<p id="S6.SS6.p5.1" class="ltx_p">The case of homotopies is similar. We omit the definition and the corresponding lemma.</p>
</div>
<section id="S6.SS6.SSS1" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">6.6.1. </span>Multimodule concatenations as weak bimodule concatenations</h5>

<div id="S6.SS6.SSS1.p1" class="ltx_para ltx_noindent">
<p id="S6.SS6.SSS1.p1.1" class="ltx_p">Now we consider the situation of multimodule concatenations. Let <math id="S6.SS6.SSS1.p1.m1" class="ltx_Math" alttext="{\mathbb{X}}" display="inline" intent=":literal"><semantics><mi>𝕏</mi><annotation encoding="application/x-tex">{\mathbb{X}}</annotation></semantics></math> be a multimodule over <math id="S6.SS6.SSS1.p1.m2" class="ltx_Math" alttext="({\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m};{\mathbb{G}}_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo>,</mo><msub><mi>𝔾</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m};{\mathbb{G}}_{i})</annotation></semantics></math> and <math id="S6.SS6.SSS1.p1.m3" class="ltx_Math" alttext="{\mathbb{Y}}" display="inline" intent=":literal"><semantics><mi>𝕐</mi><annotation encoding="application/x-tex">{\mathbb{Y}}</annotation></semantics></math> be a multimodule over <math id="S6.SS6.SSS1.p1.m4" class="ltx_Math" alttext="({\mathbb{G}}_{1},\ldots,{\mathbb{G}}_{n};{\mathbb{G}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔾</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔾</mi><mi>n</mi></msub><mo>,</mo><msup><mi>𝔾</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{G}}_{1},\ldots,{\mathbb{G}}_{n};{\mathbb{G}}^{\prime})</annotation></semantics></math>. The concatenation <math id="S6.SS6.SSS1.p1.m5" class="ltx_Math" alttext="{\mathbb{X}}\circ_{i}{\mathbb{Y}}" display="inline" intent=":literal"><semantics><mrow><mi>𝕏</mi><msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>i</mi></msub><mi>𝕐</mi></mrow><annotation encoding="application/x-tex">{\mathbb{X}}\circ_{i}{\mathbb{Y}}</annotation></semantics></math> at <math id="S6.SS6.SSS1.p1.m6" class="ltx_Math" alttext="{\mathbb{G}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝔾</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\mathbb{G}}_{i}</annotation></semantics></math> is defined previously as a multimodule over <math id="S6.SS6.SSS1.p1.m7" class="ltx_Math" alttext="({\mathbb{G}}_{1},\cdots,{\mathbb{G}}_{i-1},{\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m},{\mathbb{G}}_{i+1},\ldots,{\mathbb{G}}_{n};{\mathbb{G}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔾</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>𝔾</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo>,</mo><msub><mi>𝔾</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔾</mi><mi>n</mi></msub><mo>,</mo><msup><mi>𝔾</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{G}}_{1},\cdots,{\mathbb{G}}_{i-1},{\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m},{\mathbb{G}}_{i+1},\ldots,{\mathbb{G}}_{n};{\mathbb{G}}^{\prime})</annotation></semantics></math> (together with other data). As multimodules can be treated as weak bimodules (Lemma <a href="#S6.Thmthm18" title="Lemma 6.18. ‣ 6.6. Weak flow categories, bimodules, and homotopies ‣ 6. Flow Categories, Multimodules, and Homotopies ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.18</span></a>), we can interpret the concatenation as a concatenation of a pair of weak multimodules.</p>
</div>
<div id="S6.SS6.SSS1.p2" class="ltx_para ltx_noindent">
<p id="S6.SS6.SSS1.p2.1" class="ltx_p">First, notice that the notion of concatenations can be extended from multimodules to weak multimodules. Then we consider the product of weak bimodules</p>
<table id="S6.Ex69" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex69.m1" class="ltx_math_unparsed" alttext="{\mathbb{I}}^{{\mathbb{G}}_{1}{\mathbb{G}}_{1}}\times\cdots\times{\mathbb{I}}^{{\mathbb{G}}_{i-1}{\mathbb{G}}_{i-1}}\times{\mathbb{X}}\times{\mathbb{I}}^{\mathbb{G}_{i+1}\mathbb{G}_{i+1}}\times\cdots\times\mathbb{I}^{\mathbb{G}_{n}\mathbb{G}_{n}}" display="block" intent=":literal"><semantics><mrow><mi>𝕀</mi><msup><mrow></mrow><mrow><msub><mi>𝔾</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔾</mi><mn>1</mn></msub></mrow></msup><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi>𝕀</mi><msup><mrow></mrow><mrow><msub><mi>𝔾</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔾</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝕏</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝕀</mi><msup><mrow></mrow><mrow><msub><mi>𝔾</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔾</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></msup><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi>𝕀</mi><msup><mrow></mrow><mrow><msub><mi>𝔾</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔾</mi><mi>n</mi></msub></mrow></msup></mrow><annotation encoding="application/x-tex">{\mathbb{I}}^{{\mathbb{G}}_{1}{\mathbb{G}}_{1}}\times\cdots\times{\mathbb{I}}^{{\mathbb{G}}_{i-1}{\mathbb{G}}_{i-1}}\times{\mathbb{X}}\times{\mathbb{I}}^{\mathbb{G}_{i+1}\mathbb{G}_{i+1}}\times\cdots\times\mathbb{I}^{\mathbb{G}_{n}\mathbb{G}_{n}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS6.SSS1.p2.2" class="ltx_p">as a weak bimodule over <math id="S6.SS6.SSS1.p2.m1" class="ltx_math_unparsed" alttext="({\mathbb{G}}_{1}\times\cdots\times{\mathbb{G}}_{i-1}\times{\mathbb{F}}_{1}\times\cdots\times{\mathbb{F}}_{m}\times{\mathbb{G}}_{i+1}\times\cdots\times{\mathbb{G}}_{n};{\mathbb{G}}_{1}\times\cdots\times{\mathbb{G}}_{n})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔾</mi><mn>1</mn></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><msub><mi>𝔾</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝔾</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><msub><mi>𝔾</mi><mi>n</mi></msub><mo>;</mo><msub><mi>𝔾</mi><mn>1</mn></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><msub><mi>𝔾</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{G}}_{1}\times\cdots\times{\mathbb{G}}_{i-1}\times{\mathbb{F}}_{1}\times\cdots\times{\mathbb{F}}_{m}\times{\mathbb{G}}_{i+1}\times\cdots\times{\mathbb{G}}_{n};{\mathbb{G}}_{1}\times\cdots\times{\mathbb{G}}_{n})</annotation></semantics></math>. Then the multimodule concatenation <math id="S6.SS6.SSS1.p2.m2" class="ltx_Math" alttext="{\mathbb{X}}\circ_{i}{\mathbb{Y}}" display="inline" intent=":literal"><semantics><mrow><mi>𝕏</mi><msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>i</mi></msub><mi>𝕐</mi></mrow><annotation encoding="application/x-tex">{\mathbb{X}}\circ_{i}{\mathbb{Y}}</annotation></semantics></math> is equivalent to the weak bimodule concatenation</p>
<table id="S6.Ex70" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex70.m1" class="ltx_math_unparsed" alttext="({\mathbb{I}}^{{\mathbb{G}}_{1}{\mathbb{G}}_{1}}\times\cdots\times{\mathbb{I}}^{{\mathbb{G}}_{i-1}{\mathbb{G}}_{i-1}}\times{\mathbb{X}}\times{\mathbb{I}}^{\mathbb{G}_{i+1}\mathbb{G}_{i+1}}\times\cdots\times\mathbb{I}^{\mathbb{G}_{n}\mathbb{G}_{n}})\circ{\mathbb{Y}}." display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msup><mi>𝕀</mi><mrow><msub><mi>𝔾</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔾</mi><mn>1</mn></msub></mrow></msup><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><msup><mi>𝕀</mi><mrow><msub><mi>𝔾</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔾</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝕏</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝕀</mi><mrow><msub><mi>𝔾</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔾</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></msup><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><msup><mi>𝕀</mi><mrow><msub><mi>𝔾</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔾</mi><mi>n</mi></msub></mrow></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">∘</mo><mi>𝕐</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">({\mathbb{I}}^{{\mathbb{G}}_{1}{\mathbb{G}}_{1}}\times\cdots\times{\mathbb{I}}^{{\mathbb{G}}_{i-1}{\mathbb{G}}_{i-1}}\times{\mathbb{X}}\times{\mathbb{I}}^{\mathbb{G}_{i+1}\mathbb{G}_{i+1}}\times\cdots\times\mathbb{I}^{\mathbb{G}_{n}\mathbb{G}_{n}})\circ{\mathbb{Y}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS6.SSS1.p2.3" class="ltx_p">The purpose of introducing this formal notion is to simplify the definition of equivariance of multimodules when the symmetry group permutes the source flow categories.</p>
</div>
</section>
</section>
</section>
<section id="S7" class="ltx_section">
<h3 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">7. </span>Algebraic Structures</h3>

<div id="S7.p1" class="ltx_para ltx_noindent">
<p id="S7.p1.1" class="ltx_p">In this section we describe how to obtain algebraic structures such as chain complexes, chain maps, and chain homotopies from, respectively, flow categories, multimodules, and homotopies. When additional structures exist, these chain-level objects also carry corresponding structures such as equivariance and module structures over Novikov rings.</p>
</div>
<section id="S7.SS1" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">7.1. </span>Unobstructedness, local finiteness, grading, and orientations</h4>

<div id="S7.SS1.p1" class="ltx_para ltx_noindent">
<p id="S7.SS1.p1.1" class="ltx_p">We start by considering the most basic properties of flow categories, multimodules, and homotopies that lead to chain-level structures. Notice that these structures will only produce chain complex etc. as abelian groups. To obtain objects as modules over various Novikov rings, one needs certain extra symmetries on the flow categories etc.</p>
</div>
<section id="S7.SS1.SSS1" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">7.1.1. </span>Unobstructedness</h5>

<div id="S7.SS1.SSS1.p1" class="ltx_para ltx_noindent">
<p id="S7.SS1.SSS1.p1.1" class="ltx_p">In geometric applications, the flow categories, multimodules, and homotopies always satisfy an additional property which does not have a general formulation. Here we specify this property.</p>
</div>
<div id="S7.Thmthm1" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm1.2" class="ltx_text ltx_font_bold">Definition 7.1</span></span><span id="S7.Thmthm1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm1.p1" class="ltx_para ltx_noindent">
<p id="S7.Thmthm1.p1.1" class="ltx_p">Let <math id="S7.Thmthm1.p1.m1" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> be a flow category enriched in <math id="S7.Thmthm1.p1.m2" class="ltx_Math" alttext="\underline{\smash{\bf Top}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐓𝐨𝐩</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf Top}}</annotation></semantics></math>. It is said to be <span id="S7.Thmthm1.p1.1.1" class="ltx_text ltx_font_bold">unobstructed<span id="footnote12" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">12</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">12</sup>
                      <span class="ltx_tag ltx_tag_note"><span id="footnote12.1" class="ltx_text ltx_font_medium">12</span></span>
                      
                      
                      
                    <span id="footnote12.6" class="ltx_text ltx_font_medium">This terminology comes from Lagrangian Floer theory. If we formulate the Lagrangian Floer flow category, then in general the true boundary of moduli spaces contain configurations with disk bubbles, potentially causing obstruction to define a chain complex.</span></span></span></span></span> if for any triple <math id="S7.Thmthm1.p1.m3" class="ltx_Math" alttext="p&lt;r&lt;q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mi>r</mi><mo>&lt;</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p&lt;r&lt;q</annotation></semantics></math> of objects, the structural morphism</p>
<table id="S7.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex1.m1" class="ltx_Math" alttext="\iota_{prq}^{\mathbb{F}}:M_{pr}^{\mathbb{F}}\times M_{rq}^{\mathbb{F}}\to M_{pq}^{\mathbb{F}}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>ι</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mi>𝔽</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>M</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup></mrow><mo stretchy="false">→</mo><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\iota_{prq}^{\mathbb{F}}:M_{pr}^{\mathbb{F}}\times M_{rq}^{\mathbb{F}}\to M_{pq}^{\mathbb{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.Thmthm1.p1.2" class="ltx_p">is a homeomorphism onto <math id="S7.Thmthm1.p1.m4" class="ltx_Math" alttext="\partial^{prq}M_{pq}^{\mathbb{F}}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msup><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup></mrow><annotation encoding="application/x-tex">\partial^{prq}M_{pq}^{\mathbb{F}}</annotation></semantics></math>. Hence the union of these strata is the true boundary of <math id="S7.Thmthm1.p1.m5" class="ltx_Math" alttext="M_{pq}^{\mathbb{F}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><annotation encoding="application/x-tex">M_{pq}^{\mathbb{F}}</annotation></semantics></math>.</p>
</div>
<div id="S7.Thmthm1.p2" class="ltx_para">
<p id="S7.Thmthm1.p2.1" class="ltx_p">If <math id="S7.Thmthm1.p2.m1" class="ltx_Math" alttext="\underline{\smash{{\bf C}}}\to\underline{\smash{\bf Top}}" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>𝐂</mi><mo stretchy="true">¯</mo></munder><mo stretchy="false">→</mo><munder accentunder="true"><mi>𝐓𝐨𝐩</mi><mo stretchy="true">¯</mo></munder></mrow><annotation encoding="application/x-tex">\underline{\smash{{\bf C}}}\to\underline{\smash{\bf Top}}</annotation></semantics></math> is a functor of regular stratification categories and <math id="S7.Thmthm1.p2.m2" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> is a flow category enriched in <math id="S7.Thmthm1.p2.m3" class="ltx_Math" alttext="\underline{\smash{\bf C}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐂</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf C}}</annotation></semantics></math>, <math id="S7.Thmthm1.p2.m4" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> is called <span id="S7.Thmthm1.p2.1.1" class="ltx_text ltx_font_bold">unobstructed</span> if the induced flow category enriched in <math id="S7.Thmthm1.p2.m5" class="ltx_Math" alttext="\underline{\smash{\bf Top}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐓𝐨𝐩</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf Top}}</annotation></semantics></math> is unobstructed.</p>
</div>
</div>
<div id="S7.SS1.SSS1.p2" class="ltx_para ltx_noindent">
<p id="S7.SS1.SSS1.p2.1" class="ltx_p">Similarly, we can define the notion of unobstructedness for multimodules and homotopies enriched in <math id="S7.SS1.SSS1.p2.m1" class="ltx_Math" alttext="\underline{\smash{\bf Top}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐓𝐨𝐩</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf Top}}</annotation></semantics></math>. We omit the details. In applications within this paper, all geometric flow categories and their lifts are unobstructed.</p>
</div>
</section>
<section id="S7.SS1.SSS2" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">7.1.2. </span>Convergence</h5>

<div id="S7.SS1.SSS2.p1" class="ltx_para ltx_noindent">
<p id="S7.SS1.SSS2.p1.1" class="ltx_p">We need certain properties guaranteeing the convergence of the chain-level objects in certain nonarchimedean completions. To incorporate the equivariant case, we allow a second functional which is bounded from one side to give a different completion.</p>
</div>
<div id="S7.Thmthm2" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm2.2" class="ltx_text ltx_font_bold">Definition 7.2</span></span><span id="S7.Thmthm2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm2.p1" class="ltx_para ltx_noindent">
<p id="S7.Thmthm2.p1.1" class="ltx_p">A <span id="S7.Thmthm2.p1.1.1" class="ltx_text ltx_font_bold">filtration</span> on a (weak) flow category <math id="S7.Thmthm2.p1.m1" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> is a monotonic function</p>
<table id="S7.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex2.m1" class="ltx_Math" alttext="{\mathcal{A}}:{\rm Ob}{\mathbb{F}}\to{\mathbb{R}}^{k}\ (k\geq 1)" display="block" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow><mo stretchy="false">→</mo><mrow><msup><mi>ℝ</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>≥</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{A}}:{\rm Ob}{\mathbb{F}}\to{\mathbb{R}}^{k}\ (k\geq 1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.Thmthm2.p1.2" class="ltx_p">where <math id="S7.Thmthm2.p1.m2" class="ltx_Math" alttext="{\mathbb{R}}^{k}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mi>k</mi></msup><annotation encoding="application/x-tex">{\mathbb{R}}^{k}</annotation></semantics></math> has the product partial order. The filtration is called <span id="S7.Thmthm2.p1.2.1" class="ltx_text ltx_font_bold">locally finite</span> if for each <math id="S7.Thmthm2.p1.m3" class="ltx_Math" alttext="p\in{\rm Ob}{\mathbb{F}}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></mrow><annotation encoding="application/x-tex">p\in{\rm Ob}{\mathbb{F}}</annotation></semantics></math> and any <math id="S7.Thmthm2.p1.m4" class="ltx_Math" alttext="c&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c&gt;0</annotation></semantics></math>,</p>
<table id="S7.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex3.m1" class="ltx_math_unparsed" alttext="\#\Big\{q\in{\rm Ob}{\mathbb{F}}\ |\ p&lt;q,\ {\mathcal{A}}_{\alpha}(p)-{\mathcal{A}}_{\alpha}(q)&lt;c,\ \alpha=1,\ldots,k\Big\}&lt;\infty." display="block" intent=":literal"><semantics><mrow><mi>#</mi><mrow><mo stretchy="false">{</mo><mi>q</mi><mo>∈</mo><mi>Ob</mi><mi>𝔽</mi><mo fence="false" lspace="0.500em" rspace="0.667em" stretchy="false">|</mo><mi>p</mi><mo>&lt;</mo><mi>q</mi><mo rspace="0.667em">,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>α</mi></msub><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>α</mi></msub><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mo>&lt;</mo><mi>c</mi><mo rspace="0.667em">,</mo><mi>α</mi><mo>=</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>k</mi><mo stretchy="false">}</mo></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\#\Big\{q\in{\rm Ob}{\mathbb{F}}\ |\ p&lt;q,\ {\mathcal{A}}_{\alpha}(p)-{\mathcal{A}}_{\alpha}(q)&lt;c,\ \alpha=1,\ldots,k\Big\}&lt;\infty.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.Thmthm2.p1.3" class="ltx_p">A (weak) flow category equipped with a locally finite filtration is called a <span id="S7.Thmthm2.p1.3.1" class="ltx_text ltx_font_bold">locally finite</span> (weak) flow category.</p>
</div>
</div>
<div id="S7.Thmthm3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm3.2" class="ltx_text ltx_font_bold">Lemma 7.3</span></span><span id="S7.Thmthm3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm3.p1" class="ltx_para">
<p id="S7.Thmthm3.p1.1" class="ltx_p"><span id="S7.Thmthm3.p1.1.1" class="ltx_text ltx_font_italic">If <math id="S7.Thmthm3.p1.m1" class="ltx_Math" alttext="({\mathbb{F}}_{i},{\mathcal{A}}_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>i</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{i},{\mathcal{A}}_{i})</annotation></semantics></math>, <math id="S7.Thmthm3.p1.m2" class="ltx_Math" alttext="i=1,\ldots,m" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">i=1,\ldots,m</annotation></semantics></math> are locally finite filtered flow categories, then the product <math id="S7.Thmthm3.p1.m3" class="ltx_math_unparsed" alttext="({\mathbb{F}}_{1}\times\cdots\times{\mathbb{F}}_{m},{\mathcal{A}}_{1}\oplus\cdots\oplus{\mathcal{A}}_{m})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mn>1</mn></msub><mo>⊕</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>⊕</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{1}\times\cdots\times{\mathbb{F}}_{m},{\mathcal{A}}_{1}\oplus\cdots\oplus{\mathcal{A}}_{m})</annotation></semantics></math> is a locally finite weak flow category.</span></p>
</div>
</div>
<div id="S7.SS1.SSS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S7.SS1.SSS2.p2" class="ltx_para">
<p id="S7.SS1.SSS2.p2.1" class="ltx_p"><span id="S7.SS1.SSS2.p2.1.1" class="ltx_text">Straightforward.
∎</span></p>
</div>
</div>
<div id="S7.Thmthm4" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm4.2" class="ltx_text ltx_font_italic">Remark 7.4</span></span><span id="S7.Thmthm4.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S7.Thmthm4.p1" class="ltx_para">
<p id="S7.Thmthm4.p1.1" class="ltx_p">In a typical Floer theoretic setup, the action <math id="S7.Thmthm4.p1.m1" class="ltx_Math" alttext="{\mathcal{A}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒜</mi><annotation encoding="application/x-tex">{\mathcal{A}}</annotation></semantics></math> is <math id="S7.Thmthm4.p1.m2" class="ltx_Math" alttext="{\mathbb{R}}" display="inline" intent=":literal"><semantics><mi>ℝ</mi><annotation encoding="application/x-tex">{\mathbb{R}}</annotation></semantics></math>-valued. In the equivariant case considered in Part 4 of this paper, the action will have two components.</p>
</div>
</div>
<div id="S7.SS1.SSS2.p3" class="ltx_para ltx_noindent">
<p id="S7.SS1.SSS2.p3.1" class="ltx_p">Now we consider the local finiteness condition for multimodules. The condition we need is not only to guarantee a well-defined convergent chain map, but also that multimodule concatenations preserve such conditions.</p>
</div>
<div id="S7.Thmthm5" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm5.2" class="ltx_text ltx_font_bold">Definition 7.5</span></span><span id="S7.Thmthm5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm5.p1" class="ltx_para ltx_noindent">
<p id="S7.Thmthm5.p1.1" class="ltx_p">Let <math id="S7.Thmthm5.p1.m1" class="ltx_Math" alttext="({\mathbb{F}},{\mathcal{A}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝔽</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}},{\mathcal{A}})</annotation></semantics></math> and <math id="S7.Thmthm5.p1.m2" class="ltx_Math" alttext="({\mathbb{F}}^{\prime},{\mathcal{A}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}^{\prime},{\mathcal{A}}^{\prime})</annotation></semantics></math> be <math id="S7.Thmthm5.p1.m3" class="ltx_Math" alttext="\underline{\smash{\bf C}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐂</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf C}}</annotation></semantics></math>-enriched locally finite (weak) flow categories. Suppose <math id="S7.Thmthm5.p1.m4" class="ltx_Math" alttext="{\mathcal{A}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒜</mi><annotation encoding="application/x-tex">{\mathcal{A}}</annotation></semantics></math> is <math id="S7.Thmthm5.p1.m5" class="ltx_Math" alttext="{\mathbb{R}}^{k}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mi>k</mi></msup><annotation encoding="application/x-tex">{\mathbb{R}}^{k}</annotation></semantics></math>-valued and <math id="S7.Thmthm5.p1.m6" class="ltx_Math" alttext="{\mathcal{A}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>′</mo></msup><annotation encoding="application/x-tex">{\mathcal{A}}^{\prime}</annotation></semantics></math> is <math id="S7.Thmthm5.p1.m7" class="ltx_Math" alttext="{\mathbb{R}}^{k^{\prime}}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><msup><mi>k</mi><mo>′</mo></msup></msup><annotation encoding="application/x-tex">{\mathbb{R}}^{k^{\prime}}</annotation></semantics></math>-valued. A (weak) bimodule <math id="S7.Thmthm5.p1.m8" class="ltx_Math" alttext="{\mathbb{B}}" display="inline" intent=":literal"><semantics><mi>𝔹</mi><annotation encoding="application/x-tex">{\mathbb{B}}</annotation></semantics></math> over <math id="S7.Thmthm5.p1.m9" class="ltx_Math" alttext="({\mathbb{F}};{\mathbb{F}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝔽</mi><mo>;</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}};{\mathbb{F}}^{\prime})</annotation></semantics></math> is called <span id="S7.Thmthm5.p1.1.1" class="ltx_text ltx_font_bold">locally finite</span> if the following conditions are satisfied.</p>
</div>
<div id="S7.Thmthm5.p2" class="ltx_para">
<ol id="S7.I1" class="ltx_enumerate">
<li id="S7.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S7.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="S7.I1.i1.p1.1" class="ltx_p">For any <math id="S7.I1.i1.p1.m1" class="ltx_Math" alttext="p\in{\rm Ob}{\mathbb{F}}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></mrow><annotation encoding="application/x-tex">p\in{\rm Ob}{\mathbb{F}}</annotation></semantics></math>, <math id="S7.I1.i1.p1.m2" class="ltx_Math" alttext="c^{\prime}\in{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>c</mi><mo>′</mo></msup><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">c^{\prime}\in{\mathbb{R}}</annotation></semantics></math>,</p>
<table id="S7.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex4.m1" class="ltx_math_unparsed" alttext="\#\Big\{p^{\prime}\in{\rm Ob}{\mathbb{F}}^{\prime}\ |\ M_{p;p^{\prime}}^{\mathbb{B}}\neq\emptyset,\ \min_{1\leq\alpha\leq k^{\prime}}{\mathcal{A}}_{\alpha}^{\prime}(p^{\prime})\geq c^{\prime}\Big\}&lt;\infty." display="block" intent=":literal"><semantics><mrow><mi>#</mi><mrow><mo stretchy="false">{</mo><msup><mi>p</mi><mo>′</mo></msup><mo>∈</mo><mi>Ob</mi><msup><mi>𝔽</mi><mo>′</mo></msup><mo fence="false" rspace="0.667em" stretchy="false">|</mo><msubsup><mi>M</mi><mrow><mi>p</mi><mo>;</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mi>𝔹</mi></msubsup><mo>≠</mo><mi mathvariant="normal">∅</mi><mo rspace="0.667em">,</mo><munder><mi>min</mi><mrow><mn>1</mn><mo>≤</mo><mi>α</mi><mo>≤</mo><msup><mi>k</mi><mo>′</mo></msup></mrow></munder><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>α</mi><mo>′</mo></msubsup><mrow><mo stretchy="false">(</mo><msup><mi>p</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>≥</mo><msup><mi>c</mi><mo>′</mo></msup><mo stretchy="false">}</mo></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\#\Big\{p^{\prime}\in{\rm Ob}{\mathbb{F}}^{\prime}\ |\ M_{p;p^{\prime}}^{\mathbb{B}}\neq\emptyset,\ \min_{1\leq\alpha\leq k^{\prime}}{\mathcal{A}}_{\alpha}^{\prime}(p^{\prime})\geq c^{\prime}\Big\}&lt;\infty.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S7.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S7.I1.i2.p1" class="ltx_para ltx_noindent">
<p id="S7.I1.i2.p1.1" class="ltx_p">For all <math id="S7.I1.i2.p1.m1" class="ltx_Math" alttext="c\in{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">c\in{\mathbb{R}}</annotation></semantics></math></p>
<table id="S7.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex5.m1" class="ltx_Math" alttext="f^{\mathbb{B}}(c):=\sup\Big\{\max_{1\leq\alpha\leq k^{\prime}}{\mathcal{A}}_{\alpha}^{\prime}(p^{\prime})\ |\ \max_{1\leq\alpha\leq k}{\mathcal{A}}_{\alpha}(p)\leq c\ {\rm and}\ M_{p;p^{\prime}}^{\mathbb{B}}\neq\emptyset\Big\}&lt;+\infty," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>f</mi><mi>𝔹</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">:=</mo><mrow><mo lspace="0.1389em" movablelimits="false" rspace="0em">sup</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><munder><mi>max</mi><mrow><mn>1</mn><mo>≤</mo><mi>α</mi><mo>≤</mo><msup><mi>k</mi><mo>′</mo></msup></mrow></munder><mo lspace="0.167em">⁡</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>α</mi><mo>′</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>p</mi><mo>′</mo></msup><mo rspace="0.222em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.667em">|</mo><mrow><mrow><mrow><munder><mi>max</mi><mrow><mn>1</mn><mo>≤</mo><mi>α</mi><mo>≤</mo><mi>k</mi></mrow></munder><mo lspace="0.167em">⁡</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>α</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>c</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>and</mi><mo lspace="0.500em" rspace="0em">​</mo><msubsup><mi>M</mi><mrow><mi>p</mi><mo>;</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mi>𝔹</mi></msubsup></mrow><mo>≠</mo><mi mathvariant="normal">∅</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>&lt;</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">f^{\mathbb{B}}(c):=\sup\Big\{\max_{1\leq\alpha\leq k^{\prime}}{\mathcal{A}}_{\alpha}^{\prime}(p^{\prime})\ |\ \max_{1\leq\alpha\leq k}{\mathcal{A}}_{\alpha}(p)\leq c\ {\rm and}\ M_{p;p^{\prime}}^{\mathbb{B}}\neq\emptyset\Big\}&lt;+\infty,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.I1.i2.p1.2" class="ltx_p">and</p>
<table id="S7.I1.i2.p1.3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.I1.i2.p1.m2" class="ltx_Math" alttext="\lim_{\rho\to-\infty}h^{\mathbb{B}}(c,\rho)\\
:=\lim_{\rho\to-\infty}\sup\Big\{\min_{1\leq\alpha\leq k^{\prime}}{\mathcal{A}}_{\alpha}^{\prime}(p^{\prime})\ |\ \max_{1\leq\alpha\leq k}{\mathcal{A}}_{\alpha}(p)\leq c,\ \min_{1\leq\alpha\leq k}{\mathcal{A}}_{\alpha}(p)\leq\rho,\ {\rm and}\ M_{p;p^{\prime}}^{\mathbb{B}}\neq\emptyset\Big\}=-\infty." display="block" intent=":literal"><semantics><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>ρ</mi><mo stretchy="false">→</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow></munder><mrow><msup><mi>h</mi><mi>𝔹</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mo rspace="0em">:</mo><mo lspace="0em" rspace="0.1389em">=</mo><mo lspace="0.1389em" movablelimits="false" rspace="0.0835em">lim</mo><msub><mrow></mrow><mrow><mi>ρ</mi><mo stretchy="false">→</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow></msub><mo lspace="0.0835em" movablelimits="false" rspace="0em">sup</mo><mo stretchy="false">{</mo><mi>min</mi><msub><mrow></mrow><mrow><mn>1</mn><mo>≤</mo><mi>α</mi><mo>≤</mo><msup><mi>k</mi><mo>′</mo></msup></mrow></msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mrow></mrow><mi>α</mi></msub><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">(</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup><mo rspace="1.000em" stretchy="false">)</mo><mo fence="false" rspace="1.167em" stretchy="false">|</mo><mi>max</mi><msub><mrow></mrow><mrow><mn>1</mn><mo>≤</mo><mi>α</mi><mo>≤</mo><mi>k</mi></mrow></msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mrow></mrow><mi>α</mi></msub><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo><mo>≤</mo><mi>c</mi><mo rspace="1.167em">,</mo><mi>min</mi><msub><mrow></mrow><mrow><mn>1</mn><mo>≤</mo><mi>α</mi><mo>≤</mo><mi>k</mi></mrow></msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mrow></mrow><mi>α</mi></msub><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo><mo>≤</mo><mi>ρ</mi><mo rspace="1.167em">,</mo><mi>and</mi><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><mo>;</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝔹</mi></msup><mo>≠</mo><mi mathvariant="normal">∅</mi><mo stretchy="false">}</mo><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mi mathvariant="normal">∞</mi><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\lim_{\rho\to-\infty}h^{\mathbb{B}}(c,\rho)\\
:=\lim_{\rho\to-\infty}\sup\Big\{\min_{1\leq\alpha\leq k^{\prime}}{\mathcal{A}}_{\alpha}^{\prime}(p^{\prime})\ |\ \max_{1\leq\alpha\leq k}{\mathcal{A}}_{\alpha}(p)\leq c,\ \min_{1\leq\alpha\leq k}{\mathcal{A}}_{\alpha}(p)\leq\rho,\ {\rm and}\ M_{p;p^{\prime}}^{\mathbb{B}}\neq\emptyset\Big\}=-\infty.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
</div>
</div>
<div id="S7.SS1.SSS2.p4" class="ltx_para ltx_noindent">
<p id="S7.SS1.SSS2.p4.1" class="ltx_p">The case of multimodules can be obtained as a special case of weak bimodules.</p>
</div>
<div id="S7.Thmthm6" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm6.2" class="ltx_text ltx_font_bold">Definition 7.6</span></span><span id="S7.Thmthm6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm6.p1" class="ltx_para">
<p id="S7.Thmthm6.p1.1" class="ltx_p">Let <math id="S7.Thmthm6.p1.m1" class="ltx_Math" alttext="({\mathbb{F}}_{i},{\mathcal{A}}_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>i</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{i},{\mathcal{A}}_{i})</annotation></semantics></math>, <math id="S7.Thmthm6.p1.m2" class="ltx_Math" alttext="i=1,\ldots,m" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">i=1,\ldots,m</annotation></semantics></math> and <math id="S7.Thmthm6.p1.m3" class="ltx_Math" alttext="({\mathbb{F}}^{\prime},{\mathcal{A}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}^{\prime},{\mathcal{A}}^{\prime})</annotation></semantics></math> be locally finite flow categories enriched in <math id="S7.Thmthm6.p1.m4" class="ltx_Math" alttext="\underline{\smash{\bf C}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐂</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf C}}</annotation></semantics></math>. A <span id="S7.Thmthm6.p1.1.1" class="ltx_text ltx_font_bold">locally finite multimodule</span> over <math id="S7.Thmthm6.p1.m5" class="ltx_Math" alttext="({\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m};{\mathbb{F}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo>,</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m};{\mathbb{F}}^{\prime})</annotation></semantics></math> is a multimodule <math id="S7.Thmthm6.p1.m6" class="ltx_Math" alttext="{\mathbb{X}}" display="inline" intent=":literal"><semantics><mi>𝕏</mi><annotation encoding="application/x-tex">{\mathbb{X}}</annotation></semantics></math> which is a locally finite weak bimodule over <math id="S7.Thmthm6.p1.m7" class="ltx_math_unparsed" alttext="({\mathbb{F}}_{1}\times\cdots\times{\mathbb{F}}_{m};{\mathbb{F}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo>;</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{1}\times\cdots\times{\mathbb{F}}_{m};{\mathbb{F}}^{\prime})</annotation></semantics></math>.</p>
</div>
</div>
<div id="S7.SS1.SSS2.p5" class="ltx_para ltx_noindent">
<p id="S7.SS1.SSS2.p5.1" class="ltx_p">We verify that concatenations of locally finite multimodules are locally finite.</p>
</div>
<div id="S7.Thmthm7" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm7.2" class="ltx_text ltx_font_bold">Lemma 7.7</span></span><span id="S7.Thmthm7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm7.p1" class="ltx_para">
<p id="S7.Thmthm7.p1.1" class="ltx_p"><span id="S7.Thmthm7.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S7.Thmthm7.p1.m1" class="ltx_Math" alttext="\underline{\smash{\bf C}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐂</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf C}}</annotation></semantics></math> be either <math id="S7.Thmthm7.p1.m2" class="ltx_Math" alttext="\underline{\smash{\bf Top}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐓𝐨𝐩</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf Top}}</annotation></semantics></math> or <math id="S7.Thmthm7.p1.m3" class="ltx_Math" alttext="\underline{\smash{\bf dOrb}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf dOrb}}</annotation></semantics></math>. Let <math id="S7.Thmthm7.p1.m4" class="ltx_Math" alttext="({\mathbb{F}}_{i},{\mathcal{A}}_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>i</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{i},{\mathcal{A}}_{i})</annotation></semantics></math>, <math id="S7.Thmthm7.p1.m5" class="ltx_Math" alttext="i=1,\ldots,m" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">i=1,\ldots,m</annotation></semantics></math>, <math id="S7.Thmthm7.p1.m6" class="ltx_Math" alttext="({\mathbb{G}}_{j},{\mathcal{B}}_{j})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔾</mi><mi>j</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{G}}_{j},{\mathcal{B}}_{j})</annotation></semantics></math>, <math id="S7.Thmthm7.p1.m7" class="ltx_Math" alttext="j=1,\ldots,n" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">j=1,\ldots,n</annotation></semantics></math>, <math id="S7.Thmthm7.p1.m8" class="ltx_Math" alttext="({\mathbb{G}}^{\prime},{\mathcal{B}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>𝔾</mi><mo>′</mo></msup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{G}}^{\prime},{\mathcal{B}}^{\prime})</annotation></semantics></math>, be locally finite flow categories. Let <math id="S7.Thmthm7.p1.m9" class="ltx_Math" alttext="{\mathbb{X}}" display="inline" intent=":literal"><semantics><mi>𝕏</mi><annotation encoding="application/x-tex">{\mathbb{X}}</annotation></semantics></math> be a locally finite multimodule over <math id="S7.Thmthm7.p1.m10" class="ltx_Math" alttext="({\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m};{\mathbb{G}}_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo>,</mo><msub><mi>𝔾</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m};{\mathbb{G}}_{i})</annotation></semantics></math> and <math id="S7.Thmthm7.p1.m11" class="ltx_Math" alttext="{\mathbb{Y}}" display="inline" intent=":literal"><semantics><mi>𝕐</mi><annotation encoding="application/x-tex">{\mathbb{Y}}</annotation></semantics></math> be a locally finite multimodule over <math id="S7.Thmthm7.p1.m12" class="ltx_Math" alttext="({\mathbb{G}}_{1},\ldots,{\mathbb{G}}_{n};{\mathbb{G}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔾</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔾</mi><mi>n</mi></msub><mo>,</mo><msup><mi>𝔾</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{G}}_{1},\ldots,{\mathbb{G}}_{n};{\mathbb{G}}^{\prime})</annotation></semantics></math>. Then the concatenation <math id="S7.Thmthm7.p1.m13" class="ltx_Math" alttext="{\mathbb{X}}\circ_{i}{\mathbb{Y}}" display="inline" intent=":literal"><semantics><mrow><mi>𝕏</mi><msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>i</mi></msub><mi>𝕐</mi></mrow><annotation encoding="application/x-tex">{\mathbb{X}}\circ_{i}{\mathbb{Y}}</annotation></semantics></math> is a locally finite multimodule.</span></p>
</div>
</div>
<div id="S7.SS1.SSS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S7.SS1.SSS2.p6" class="ltx_para ltx_noindent">
<p id="S7.SS1.SSS2.p6.1" class="ltx_p"><span id="S7.SS1.SSS2.p6.1.1" class="ltx_text">We verify conditions of Definition <a href="#S7.Thmthm5" title="Definition 7.5. ‣ 7.1.2. Convergence ‣ 7.1. Unobstructedness, local finiteness, grading, and orientations ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.5</span></a> one by one. Suppose (1) of Definition <a href="#S7.Thmthm5" title="Definition 7.5. ‣ 7.1.2. Convergence ‣ 7.1. Unobstructedness, local finiteness, grading, and orientations ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.5</span></a> does not hold for the concatenation <math id="S7.SS1.SSS2.p6.m1" class="ltx_Math" alttext="{\mathbb{X}}\circ_{i}{\mathbb{Y}}" display="inline" intent=":literal"><semantics><mrow><mi>𝕏</mi><msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>i</mi></msub><mi>𝕐</mi></mrow><annotation encoding="application/x-tex">{\mathbb{X}}\circ_{i}{\mathbb{Y}}</annotation></semantics></math>. Then there exist</span></p>
<table id="S7.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex6.m1" class="ltx_Math" alttext="p_{1}\in{\rm Ob}{\mathbb{F}}_{1},\ldots,p_{m}\in{\rm Ob}{\mathbb{F}}_{m},r_{1}\in{\rm Ob}{\mathbb{G}}_{1},\ldots,r_{i-1}\in{\rm Ob}{\mathbb{G}}_{i-1},\ r_{i+1}\in{\rm Ob}{\mathbb{G}}_{i+1},\ldots,r_{n}\in{\rm Ob}{\mathbb{G}}_{n}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>p</mi><mn>1</mn></msub><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔽</mi><mn>1</mn></msub></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>p</mi><mi>m</mi></msub><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔽</mi><mi>m</mi></msub></mrow></mrow><mo>,</mo><mrow><msub><mi>r</mi><mn>1</mn></msub><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔾</mi><mn>1</mn></msub></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>r</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔾</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo rspace="0.667em">,</mo><mrow><msub><mi>r</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔾</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>r</mi><mi>n</mi></msub><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔾</mi><mi>n</mi></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">p_{1}\in{\rm Ob}{\mathbb{F}}_{1},\ldots,p_{m}\in{\rm Ob}{\mathbb{F}}_{m},r_{1}\in{\rm Ob}{\mathbb{G}}_{1},\ldots,r_{i-1}\in{\rm Ob}{\mathbb{G}}_{i-1},\ r_{i+1}\in{\rm Ob}{\mathbb{G}}_{i+1},\ldots,r_{n}\in{\rm Ob}{\mathbb{G}}_{n},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS2.p6.2" class="ltx_p"><math id="S7.SS1.SSS2.p6.m2" class="ltx_Math" alttext="c^{\prime}\in{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>c</mi><mo>′</mo></msup><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">c^{\prime}\in{\mathbb{R}}</annotation></semantics></math><span id="S7.SS1.SSS2.p6.2.1" class="ltx_text"> and infinitely many distinct <math id="S7.SS1.SSS2.p6.m3" class="ltx_Math" alttext="r_{\nu}^{\prime}\in{\rm Ob}{\mathbb{G}}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>r</mi><mi>ν</mi><mo>′</mo></msubsup><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔾</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">r_{\nu}^{\prime}\in{\rm Ob}{\mathbb{G}}^{\prime}</annotation></semantics></math> such that</span></p>
<table id="S7.EGx18" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S7.E1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.E1.m2" class="ltx_math_unparsed" alttext="\displaystyle\ M_{r_{1}\cdots r_{i-1}p_{1}\cdots p_{m}r_{i+1}\cdots r_{n};r^{\prime}}^{{\mathbb{X}}\circ{\mathbb{Y}}}\neq\emptyset,\ " display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mi>r</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>n</mi></msub><mo>;</mo><mi>r</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mrow><mi>𝕏</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>𝕐</mi></mrow></msup><mo>≠</mo><mi mathvariant="normal">∅</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ M_{r_{1}\cdots r_{i-1}p_{1}\cdots p_{m}r_{i+1}\cdots r_{n};r^{\prime}}^{{\mathbb{X}}\circ{\mathbb{Y}}}\neq\emptyset,\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.E1.m3" class="ltx_Math" alttext="\displaystyle\ \min_{1\leq\beta\leq l^{\prime}}{\mathcal{B}}_{\beta}^{\prime}(r_{\nu}^{\prime})\geq c^{\prime}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><munder><mi>min</mi><mrow><mn>1</mn><mo>≤</mo><mi>β</mi><mo>≤</mo><msup><mi>l</mi><mo>′</mo></msup></mrow></munder><mo lspace="0.167em">⁡</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>β</mi><mo>′</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>r</mi><mi>ν</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><msup><mi>c</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle\ \min_{1\leq\beta\leq l^{\prime}}{\mathcal{B}}_{\beta}^{\prime}(r_{\nu}^{\prime})\geq c^{\prime}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7.1)</span></td></tr></tbody>
</table>
<p id="S7.SS1.SSS2.p6.3" class="ltx_p"><span id="S7.SS1.SSS2.p6.3.1" class="ltx_text">It follows that there exists a sequence <math id="S7.SS1.SSS2.p6.m4" class="ltx_Math" alttext="r_{i,\nu}\in{\rm Ob}{\mathbb{G}}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mrow><mi>i</mi><mo>,</mo><mi>ν</mi></mrow></msub><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔾</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">r_{i,\nu}\in{\rm Ob}{\mathbb{G}}_{i}</annotation></semantics></math> such that</span></p>
<table id="S7.EGx19" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S7.Ex7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex7.m1" class="ltx_math_unparsed" alttext="\displaystyle\ M_{p_{1}\cdots p_{m};r_{i,\nu}}^{\mathbb{X}}\neq\emptyset,\ " display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>r</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>ν</mi></mrow></msub></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo>≠</mo><mi mathvariant="normal">∅</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ M_{p_{1}\cdots p_{m};r_{i,\nu}}^{\mathbb{X}}\neq\emptyset,\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.Ex7.m2" class="ltx_math_unparsed" alttext="\displaystyle\ M_{r_{1}\cdots r_{i-1}r_{i,\nu}r_{i+1}\cdots r_{n};r_{\nu}^{\prime}}^{\mathbb{Y}}\neq\emptyset." display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mi>r</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mi>ν</mi></mrow></msub><mi>r</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>n</mi></msub><mo>;</mo><mi>r</mi><msub><mrow></mrow><mi>ν</mi></msub><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕐</mi></msup><mo>≠</mo><mi mathvariant="normal">∅</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ M_{r_{1}\cdots r_{i-1}r_{i,\nu}r_{i+1}\cdots r_{n};r_{\nu}^{\prime}}^{\mathbb{Y}}\neq\emptyset.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS2.p6.4" class="ltx_p"><span id="S7.SS1.SSS2.p6.4.1" class="ltx_text">By choosing a subsequence, we may assume the terms of the sequence <math id="S7.SS1.SSS2.p6.m5" class="ltx_Math" alttext="r_{i,\nu}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mrow><mi>i</mi><mo>,</mo><mi>ν</mi></mrow></msub><annotation encoding="application/x-tex">r_{i,\nu}</annotation></semantics></math> are either all identical, or all distinct. If all <math id="S7.SS1.SSS2.p6.m6" class="ltx_Math" alttext="r_{i,\nu}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mrow><mi>i</mi><mo>,</mo><mi>ν</mi></mrow></msub><annotation encoding="application/x-tex">r_{i,\nu}</annotation></semantics></math> are identical, then it contradicts the local finiteness of <math id="S7.SS1.SSS2.p6.m7" class="ltx_Math" alttext="{\mathbb{Y}}" display="inline" intent=":literal"><semantics><mi>𝕐</mi><annotation encoding="application/x-tex">{\mathbb{Y}}</annotation></semantics></math>. Hence all <math id="S7.SS1.SSS2.p6.m8" class="ltx_Math" alttext="r_{i,\nu}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mrow><mi>i</mi><mo>,</mo><mi>ν</mi></mrow></msub><annotation encoding="application/x-tex">r_{i,\nu}</annotation></semantics></math> are distinct. Then by the local finiteness of <math id="S7.SS1.SSS2.p6.m9" class="ltx_Math" alttext="{\mathbb{X}}" display="inline" intent=":literal"><semantics><mi>𝕏</mi><annotation encoding="application/x-tex">{\mathbb{X}}</annotation></semantics></math>, for all <math id="S7.SS1.SSS2.p6.m10" class="ltx_Math" alttext="\alpha\in\{1,\ldots,l_{i}\}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>l</mi><mi>i</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha\in\{1,\ldots,l_{i}\}</annotation></semantics></math>, the sequence <math id="S7.SS1.SSS2.p6.m11" class="ltx_Math" alttext="{\mathcal{B}}_{i,\alpha}(r_{i,\nu})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mrow><mi>i</mi><mo>,</mo><mi>α</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mrow><mi>i</mi><mo>,</mo><mi>ν</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{B}}_{i,\alpha}(r_{i,\nu})</annotation></semantics></math> is bounded from above; moreover, by choosing a subsequence, for some <math id="S7.SS1.SSS2.p6.m12" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> the sequence <math id="S7.SS1.SSS2.p6.m13" class="ltx_Math" alttext="{\mathcal{B}}_{i,\alpha}(r_{i,\nu})\to-\infty" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mrow><mi>i</mi><mo>,</mo><mi>α</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mrow><mi>i</mi><mo>,</mo><mi>ν</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{B}}_{i,\alpha}(r_{i,\nu})\to-\infty</annotation></semantics></math>. Then by the local finiteness of <math id="S7.SS1.SSS2.p6.m14" class="ltx_Math" alttext="{\mathbb{Y}}" display="inline" intent=":literal"><semantics><mi>𝕐</mi><annotation encoding="application/x-tex">{\mathbb{Y}}</annotation></semantics></math>, one has</span></p>
<table id="S7.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex8.m1" class="ltx_Math" alttext="\lim_{\nu\to\infty}\min_{1\leq\beta\leq l^{\prime}}{\mathcal{B}}_{\beta}^{\prime}(r_{\nu}^{\prime})=-\infty." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>ν</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><mrow><munder><mi>min</mi><mrow><mn>1</mn><mo>≤</mo><mi>β</mi><mo>≤</mo><msup><mi>l</mi><mo>′</mo></msup></mrow></munder><mo lspace="0.167em">⁡</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>β</mi><mo>′</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>r</mi><mi>ν</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lim_{\nu\to\infty}\min_{1\leq\beta\leq l^{\prime}}{\mathcal{B}}_{\beta}^{\prime}(r_{\nu}^{\prime})=-\infty.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS2.p6.5" class="ltx_p"><span id="S7.SS1.SSS2.p6.5.1" class="ltx_text">This contradicts (<a href="#S7.E1" title="In Proof. ‣ 7.1.2. Convergence ‣ 7.1. Unobstructedness, local finiteness, grading, and orientations ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.1</span></a>). Therefore, (1) holds for the concatenation <math id="S7.SS1.SSS2.p6.m15" class="ltx_Math" alttext="{\mathbb{X}}\circ_{i}{\mathbb{Y}}" display="inline" intent=":literal"><semantics><mrow><mi>𝕏</mi><msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>i</mi></msub><mi>𝕐</mi></mrow><annotation encoding="application/x-tex">{\mathbb{X}}\circ_{i}{\mathbb{Y}}</annotation></semantics></math>.</span></p>
</div>
<div id="S7.SS1.SSS2.p7" class="ltx_para ltx_noindent">
<p id="S7.SS1.SSS2.p7.1" class="ltx_p"><span id="S7.SS1.SSS2.p7.1.1" class="ltx_text">Now we verify (2) for the concatenation.
Choose <math id="S7.SS1.SSS2.p7.m1" class="ltx_Math" alttext="c\in{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">c\in{\mathbb{R}}</annotation></semantics></math>. We need to show that</span></p>
<table id="S7.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex9.m1" class="ltx_Math" alttext="f^{{\mathbb{X}}\circ_{i}{\mathbb{Y}}}(c)&lt;+\infty" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>f</mi><mrow><mi>𝕏</mi><msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>i</mi></msub><mi>𝕐</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">f^{{\mathbb{X}}\circ_{i}{\mathbb{Y}}}(c)&lt;+\infty</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS2.p7.2" class="ltx_p"><span id="S7.SS1.SSS2.p7.2.1" class="ltx_text">where <math id="S7.SS1.SSS2.p7.m2" class="ltx_Math" alttext="f^{{\mathbb{X}}\circ_{i}{\mathbb{Y}}}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mrow><mi>𝕏</mi><msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>i</mi></msub><mi>𝕐</mi></mrow></msup><annotation encoding="application/x-tex">f^{{\mathbb{X}}\circ_{i}{\mathbb{Y}}}</annotation></semantics></math> is defined in Definition <a href="#S7.Thmthm5" title="Definition 7.5. ‣ 7.1.2. Convergence ‣ 7.1. Unobstructedness, local finiteness, grading, and orientations ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.5</span></a>. Consider any collection of objects <math id="S7.SS1.SSS2.p7.m3" class="ltx_Math" alttext="p_{1},\ldots,p_{m},r_{1},\ldots,r_{i-1},r_{i+1},\ldots,r_{n},r^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>p</mi><mi>m</mi></msub><mo>,</mo><msub><mi>r</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>r</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>r</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>r</mi><mi>n</mi></msub><mo>,</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">p_{1},\ldots,p_{m},r_{1},\ldots,r_{i-1},r_{i+1},\ldots,r_{n},r^{\prime}</annotation></semantics></math> such that</span></p>
<table id="S7.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex10.m1" class="ltx_Math" alttext="\max_{1\leq\alpha\leq k_{i}}{\mathcal{A}}_{i,\alpha}(p_{i})\leq c,\ \max_{1\leq\beta\leq l_{j}}{\mathcal{B}}_{j,\beta}(r_{j})\leq c" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munder><mi>max</mi><mrow><mn>1</mn><mo>≤</mo><mi>α</mi><mo>≤</mo><msub><mi>k</mi><mi>i</mi></msub></mrow></munder><mo lspace="0.167em">⁡</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mi>i</mi><mo>,</mo><mi>α</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>c</mi></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mrow><munder><mi>max</mi><mrow><mn>1</mn><mo>≤</mo><mi>β</mi><mo>≤</mo><msub><mi>l</mi><mi>j</mi></msub></mrow></munder><mo lspace="0.167em">⁡</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mrow><mi>j</mi><mo>,</mo><mi>β</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>c</mi></mrow></mrow><annotation encoding="application/x-tex">\max_{1\leq\alpha\leq k_{i}}{\mathcal{A}}_{i,\alpha}(p_{i})\leq c,\ \max_{1\leq\beta\leq l_{j}}{\mathcal{B}}_{j,\beta}(r_{j})\leq c</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS2.p7.3" class="ltx_p"><span id="S7.SS1.SSS2.p7.3.1" class="ltx_text">and</span></p>
<table id="S7.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex11.m1" class="ltx_math_unparsed" alttext="M_{r_{1}\cdots r_{i-1}p_{1}\cdots p_{m}r_{i+1}\cdots r_{n};r^{\prime}}^{{\mathbb{X}}\circ_{i}{\mathbb{Y}}}\neq\emptyset." display="block" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mi>r</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>n</mi></msub><mo>;</mo><mi>r</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mrow><mi>𝕏</mi><msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>i</mi></msub><mi>𝕐</mi></mrow></msup><mo>≠</mo><mi mathvariant="normal">∅</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">M_{r_{1}\cdots r_{i-1}p_{1}\cdots p_{m}r_{i+1}\cdots r_{n};r^{\prime}}^{{\mathbb{X}}\circ_{i}{\mathbb{Y}}}\neq\emptyset.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS2.p7.4" class="ltx_p"><span id="S7.SS1.SSS2.p7.4.1" class="ltx_text">Then by the definition of concatenation, there exists <math id="S7.SS1.SSS2.p7.m4" class="ltx_Math" alttext="p^{\prime}\in{\rm Ob}{\mathbb{F}}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>p</mi><mo>′</mo></msup><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔽</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">p^{\prime}\in{\rm Ob}{\mathbb{F}}^{\prime}</annotation></semantics></math> such that</span></p>
<table id="S7.EGx20" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S7.Ex12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex12.m1" class="ltx_math_unparsed" alttext="\displaystyle\ M_{p_{1}\cdots p_{m};r_{i}}^{{\mathbb{X}}}\neq\emptyset,\ " display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>r</mi><msub><mrow></mrow><mi>i</mi></msub></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo>≠</mo><mi mathvariant="normal">∅</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ M_{p_{1}\cdots p_{m};r_{i}}^{{\mathbb{X}}}\neq\emptyset,\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.Ex12.m2" class="ltx_math_unparsed" alttext="\displaystyle\ M_{r_{1}\cdots r_{n};r^{\prime}}^{{\mathbb{Y}}}\neq\emptyset." display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>n</mi></msub><mo>;</mo><mi>r</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕐</mi></msup><mo>≠</mo><mi mathvariant="normal">∅</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ M_{r_{1}\cdots r_{n};r^{\prime}}^{{\mathbb{Y}}}\neq\emptyset.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS2.p7.5" class="ltx_p"><span id="S7.SS1.SSS2.p7.5.1" class="ltx_text">Then</span></p>
<table id="S7.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex13.m1" class="ltx_Math" alttext="\max_{1\leq\beta\leq l_{i}}{\mathcal{B}}_{i,\beta}(r_{i})\leq f^{\mathbb{X}}(c)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munder><mi>max</mi><mrow><mn>1</mn><mo>≤</mo><mi>β</mi><mo>≤</mo><msub><mi>l</mi><mi>i</mi></msub></mrow></munder><mo lspace="0.167em">⁡</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mrow><mi>i</mi><mo>,</mo><mi>β</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msup><mi>f</mi><mi>𝕏</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\max_{1\leq\beta\leq l_{i}}{\mathcal{B}}_{i,\beta}(r_{i})\leq f^{\mathbb{X}}(c).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS2.p7.6" class="ltx_p"><span id="S7.SS1.SSS2.p7.6.1" class="ltx_text">Denote <math id="S7.SS1.SSS2.p7.m5" class="ltx_Math" alttext="c^{\prime}=\max\{c,f^{\mathbb{X}}(c)\}" display="inline" intent=":literal"><semantics><mrow><msup><mi>c</mi><mo>′</mo></msup><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mi>c</mi><mo>,</mo><mrow><msup><mi>f</mi><mi>𝕏</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c^{\prime}=\max\{c,f^{\mathbb{X}}(c)\}</annotation></semantics></math>. Then by the assumption, one has</span></p>
<table id="S7.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex14.m1" class="ltx_Math" alttext="\max_{1\leq\beta\leq l^{\prime}}{\mathcal{B}}_{\beta}^{\prime}(r^{\prime})\leq f^{\mathbb{Y}}(c^{\prime})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munder><mi>max</mi><mrow><mn>1</mn><mo>≤</mo><mi>β</mi><mo>≤</mo><msup><mi>l</mi><mo>′</mo></msup></mrow></munder><mo lspace="0.167em">⁡</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>β</mi><mo>′</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msup><mi>f</mi><mi>𝕐</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>c</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\max_{1\leq\beta\leq l^{\prime}}{\mathcal{B}}_{\beta}^{\prime}(r^{\prime})\leq f^{\mathbb{Y}}(c^{\prime}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS2.p7.7" class="ltx_p"><span id="S7.SS1.SSS2.p7.7.1" class="ltx_text">This proves that</span></p>
<table id="S7.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex15.m1" class="ltx_Math" alttext="f^{{\mathbb{X}}\circ_{i}{\mathbb{Y}}}(c)\leq f^{{\mathbb{Y}}}(c^{\prime})&lt;+\infty." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>f</mi><mrow><mi>𝕏</mi><msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>i</mi></msub><mi>𝕐</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msup><mi>f</mi><mi>𝕐</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>c</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f^{{\mathbb{X}}\circ_{i}{\mathbb{Y}}}(c)\leq f^{{\mathbb{Y}}}(c^{\prime})&lt;+\infty.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS2.p7.8" class="ltx_p"><span id="S7.SS1.SSS2.p7.8.1" class="ltx_text">Moreover, suppose</span></p>
<table id="S7.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex16.m1" class="ltx_Math" alttext="\rho=\min\Big\{\min_{1\leq\alpha\leq k_{j}}{\mathcal{A}}_{j,\alpha}(p_{j})\ |\ 1\leq j\leq m\Big\}." display="block" intent=":literal"><semantics><mrow><mrow><mi>ρ</mi><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><munder><mi>min</mi><mrow><mn>1</mn><mo>≤</mo><mi>α</mi><mo>≤</mo><msub><mi>k</mi><mi>j</mi></msub></mrow></munder><mo lspace="0.167em">⁡</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mi>j</mi><mo>,</mo><mi>α</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>j</mi></msub><mo rspace="0.222em" stretchy="false">)</mo></mrow></mrow><mo rspace="0em">|</mo><mrow><mn> 1</mn><mo>≤</mo><mi>j</mi><mo>≤</mo><mi>m</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\rho=\min\Big\{\min_{1\leq\alpha\leq k_{j}}{\mathcal{A}}_{j,\alpha}(p_{j})\ |\ 1\leq j\leq m\Big\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS2.p7.9" class="ltx_p"><span id="S7.SS1.SSS2.p7.9.1" class="ltx_text">Then</span></p>
<table id="S7.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex17.m1" class="ltx_Math" alttext="\min_{1\leq\beta\leq l_{i}}{\mathcal{B}}_{i,\beta}(r_{i})\leq h^{{\mathbb{X}}}(c,\rho)" display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mi>min</mi><mrow><mn>1</mn><mo>≤</mo><mi>β</mi><mo>≤</mo><msub><mi>l</mi><mi>i</mi></msub></mrow></munder><mo lspace="0.167em">⁡</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mrow><mi>i</mi><mo>,</mo><mi>β</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msup><mi>h</mi><mi>𝕏</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\min_{1\leq\beta\leq l_{i}}{\mathcal{B}}_{i,\beta}(r_{i})\leq h^{{\mathbb{X}}}(c,\rho)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS2.p7.10" class="ltx_p"><span id="S7.SS1.SSS2.p7.10.1" class="ltx_text">Denote</span></p>
<table id="S7.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex18.m1" class="ltx_math_unparsed" alttext="\rho^{\prime}:=\min\Big\{h^{{\mathbb{X}}}(c,\rho),\min_{1\leq\beta\leq l_{j}}{\mathcal{B}}_{j,\beta}(r_{j})\ |\ j\neq i\Big\}." display="block" intent=":literal"><semantics><mrow><msup><mi>ρ</mi><mo>′</mo></msup><mo>:=</mo><mi>min</mi><mrow><mo stretchy="false">{</mo><msup><mi>h</mi><mi>𝕏</mi></msup><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><munder><mi>min</mi><mrow><mn>1</mn><mo>≤</mo><mi>β</mi><mo>≤</mo><msub><mi>l</mi><mi>j</mi></msub></mrow></munder><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mrow><mi>j</mi><mo>,</mo><mi>β</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mi>j</mi></msub><mo rspace="0.500em" stretchy="false">)</mo></mrow><mo fence="false" rspace="0.667em" stretchy="false">|</mo><mi>j</mi><mo>≠</mo><mi>i</mi><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\rho^{\prime}:=\min\Big\{h^{{\mathbb{X}}}(c,\rho),\min_{1\leq\beta\leq l_{j}}{\mathcal{B}}_{j,\beta}(r_{j})\ |\ j\neq i\Big\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS2.p7.11" class="ltx_p"><span id="S7.SS1.SSS2.p7.11.1" class="ltx_text">Then</span></p>
<table id="S7.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex19.m1" class="ltx_Math" alttext="\min_{1\leq\beta\leq l^{\prime}}{\mathcal{B}}_{\beta}^{\prime}(r^{\prime})\leq h^{\mathbb{Y}}(c^{\prime},\rho^{\prime})" display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mi>min</mi><mrow><mn>1</mn><mo>≤</mo><mi>β</mi><mo>≤</mo><msup><mi>l</mi><mo>′</mo></msup></mrow></munder><mo lspace="0.167em">⁡</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>β</mi><mo>′</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msup><mi>h</mi><mi>𝕐</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>c</mi><mo>′</mo></msup><mo>,</mo><msup><mi>ρ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\min_{1\leq\beta\leq l^{\prime}}{\mathcal{B}}_{\beta}^{\prime}(r^{\prime})\leq h^{\mathbb{Y}}(c^{\prime},\rho^{\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS2.p7.12" class="ltx_p"><span id="S7.SS1.SSS2.p7.12.1" class="ltx_text">which goes to <math id="S7.SS1.SSS2.p7.m6" class="ltx_Math" alttext="-\infty" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">-\infty</annotation></semantics></math> as <math id="S7.SS1.SSS2.p7.m7" class="ltx_Math" alttext="\rho^{\prime}\to-\infty" display="inline" intent=":literal"><semantics><mrow><msup><mi>ρ</mi><mo>′</mo></msup><mo stretchy="false">→</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">\rho^{\prime}\to-\infty</annotation></semantics></math>. Therefore (2) of Definition <a href="#S7.Thmthm5" title="Definition 7.5. ‣ 7.1.2. Convergence ‣ 7.1. Unobstructedness, local finiteness, grading, and orientations ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.5</span></a> holds for the concatenation <math id="S7.SS1.SSS2.p7.m8" class="ltx_Math" alttext="{\mathbb{X}}\circ_{i}{\mathbb{Y}}" display="inline" intent=":literal"><semantics><mrow><mi>𝕏</mi><msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>i</mi></msub><mi>𝕐</mi></mrow><annotation encoding="application/x-tex">{\mathbb{X}}\circ_{i}{\mathbb{Y}}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S7.SS1.SSS2.p8" class="ltx_para ltx_noindent">
<p id="S7.SS1.SSS2.p8.1" class="ltx_p">Lastly we state the local finiteness of multimodule homotopies.</p>
</div>
<div id="S7.Thmthm8" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm8.2" class="ltx_text ltx_font_bold">Definition 7.8</span></span><span id="S7.Thmthm8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm8.p1" class="ltx_para ltx_noindent">
<p id="S7.Thmthm8.p1.1" class="ltx_p">Let <math id="S7.Thmthm8.p1.m1" class="ltx_Math" alttext="({\mathbb{F}},{\mathcal{A}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝔽</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}},{\mathcal{A}})</annotation></semantics></math> and <math id="S7.Thmthm8.p1.m2" class="ltx_Math" alttext="({\mathbb{F}}^{\prime},{\mathcal{A}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}^{\prime},{\mathcal{A}}^{\prime})</annotation></semantics></math> be two locally finite weak flow categories. Suppose <math id="S7.Thmthm8.p1.m3" class="ltx_Math" alttext="{\mathcal{A}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒜</mi><annotation encoding="application/x-tex">{\mathcal{A}}</annotation></semantics></math> is <math id="S7.Thmthm8.p1.m4" class="ltx_Math" alttext="{\mathbb{R}}^{k}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mi>k</mi></msup><annotation encoding="application/x-tex">{\mathbb{R}}^{k}</annotation></semantics></math>-valued and <math id="S7.Thmthm8.p1.m5" class="ltx_Math" alttext="{\mathcal{A}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>′</mo></msup><annotation encoding="application/x-tex">{\mathcal{A}}^{\prime}</annotation></semantics></math> is <math id="S7.Thmthm8.p1.m6" class="ltx_Math" alttext="{\mathbb{R}}^{k^{\prime}}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><msup><mi>k</mi><mo>′</mo></msup></msup><annotation encoding="application/x-tex">{\mathbb{R}}^{k^{\prime}}</annotation></semantics></math>-valued. Suppose <math id="S7.Thmthm8.p1.m7" class="ltx_Math" alttext="{\mathbb{B}}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝔹</mi><mn>0</mn></msub><annotation encoding="application/x-tex">{\mathbb{B}}_{0}</annotation></semantics></math> and <math id="S7.Thmthm8.p1.m8" class="ltx_Math" alttext="{\mathbb{B}}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝔹</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\mathbb{B}}_{1}</annotation></semantics></math> are two locally finite weak bimodules over <math id="S7.Thmthm8.p1.m9" class="ltx_Math" alttext="({\mathbb{F}};{\mathbb{F}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝔽</mi><mo>;</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}};{\mathbb{F}}^{\prime})</annotation></semantics></math> (Definition <a href="#S7.Thmthm5" title="Definition 7.5. ‣ 7.1.2. Convergence ‣ 7.1. Unobstructedness, local finiteness, grading, and orientations ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.5</span></a>). Then a homotopy <math id="S7.Thmthm8.p1.m10" class="ltx_Math" alttext="{\mathbb{H}}" display="inline" intent=":literal"><semantics><mi>ℍ</mi><annotation encoding="application/x-tex">{\mathbb{H}}</annotation></semantics></math> from <math id="S7.Thmthm8.p1.m11" class="ltx_Math" alttext="{\mathbb{B}}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝔹</mi><mn>0</mn></msub><annotation encoding="application/x-tex">{\mathbb{B}}_{0}</annotation></semantics></math> to <math id="S7.Thmthm8.p1.m12" class="ltx_Math" alttext="{\mathbb{B}}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝔹</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\mathbb{B}}_{1}</annotation></semantics></math> is called a <span id="S7.Thmthm8.p1.1.1" class="ltx_text ltx_font_bold">locally finite homotopy</span> if the following are satisfied.</p>
<ol id="S7.I2" class="ltx_enumerate">
<li id="S7.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S7.I2.i1.p1" class="ltx_para ltx_noindent">
<p id="S7.I2.i1.p1.1" class="ltx_p">For any <math id="S7.I2.i1.p1.m1" class="ltx_Math" alttext="p\in{\rm Ob}{\mathbb{F}}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></mrow><annotation encoding="application/x-tex">p\in{\rm Ob}{\mathbb{F}}</annotation></semantics></math> and <math id="S7.I2.i1.p1.m2" class="ltx_Math" alttext="c^{\prime}\in{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>c</mi><mo>′</mo></msup><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">c^{\prime}\in{\mathbb{R}}</annotation></semantics></math>,</p>
<table id="S7.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex20.m1" class="ltx_math_unparsed" alttext="\#\Big\{p^{\prime}\in{\rm Ob}{\mathbb{F}}^{\prime}\ |\ M_{p;p^{\prime}}^{\mathbb{H}}\neq\emptyset,\ \min_{1\leq\alpha\leq k^{\prime}}{\mathcal{A}}_{\alpha}^{\prime}(p^{\prime})\geq c^{\prime}\Big\}&lt;\infty." display="block" intent=":literal"><semantics><mrow><mi>#</mi><mrow><mo stretchy="false">{</mo><msup><mi>p</mi><mo>′</mo></msup><mo>∈</mo><mi>Ob</mi><msup><mi>𝔽</mi><mo>′</mo></msup><mo fence="false" rspace="0.667em" stretchy="false">|</mo><msubsup><mi>M</mi><mrow><mi>p</mi><mo>;</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mi>ℍ</mi></msubsup><mo>≠</mo><mi mathvariant="normal">∅</mi><mo rspace="0.667em">,</mo><munder><mi>min</mi><mrow><mn>1</mn><mo>≤</mo><mi>α</mi><mo>≤</mo><msup><mi>k</mi><mo>′</mo></msup></mrow></munder><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>α</mi><mo>′</mo></msubsup><mrow><mo stretchy="false">(</mo><msup><mi>p</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>≥</mo><msup><mi>c</mi><mo>′</mo></msup><mo stretchy="false">}</mo></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\#\Big\{p^{\prime}\in{\rm Ob}{\mathbb{F}}^{\prime}\ |\ M_{p;p^{\prime}}^{\mathbb{H}}\neq\emptyset,\ \min_{1\leq\alpha\leq k^{\prime}}{\mathcal{A}}_{\alpha}^{\prime}(p^{\prime})\geq c^{\prime}\Big\}&lt;\infty.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S7.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S7.I2.i2.p1" class="ltx_para ltx_noindent">
<p id="S7.I2.i2.p1.1" class="ltx_p">For all <math id="S7.I2.i2.p1.m1" class="ltx_Math" alttext="c\in{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">c\in{\mathbb{R}}</annotation></semantics></math></p>
<table id="S7.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex21.m1" class="ltx_Math" alttext="\sup\Big\{\max_{1\leq\alpha\leq k^{\prime}}{\mathcal{A}}_{\alpha}^{\prime}(p^{\prime})\ |\ \max_{1\leq\alpha\leq k}{\mathcal{A}}_{\alpha}(p)\leq c\ {\rm and}\ M_{p;p^{\prime}}^{\mathbb{H}}\neq\emptyset\Big\}&lt;+\infty," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo movablelimits="false" rspace="0em">sup</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><munder><mi>max</mi><mrow><mn>1</mn><mo>≤</mo><mi>α</mi><mo>≤</mo><msup><mi>k</mi><mo>′</mo></msup></mrow></munder><mo lspace="0.167em">⁡</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>α</mi><mo>′</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>p</mi><mo>′</mo></msup><mo rspace="0.222em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.667em">|</mo><mrow><mrow><mrow><munder><mi>max</mi><mrow><mn>1</mn><mo>≤</mo><mi>α</mi><mo>≤</mo><mi>k</mi></mrow></munder><mo lspace="0.167em">⁡</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>α</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>c</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>and</mi><mo lspace="0.500em" rspace="0em">​</mo><msubsup><mi>M</mi><mrow><mi>p</mi><mo>;</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mi>ℍ</mi></msubsup></mrow><mo>≠</mo><mi mathvariant="normal">∅</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>&lt;</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\sup\Big\{\max_{1\leq\alpha\leq k^{\prime}}{\mathcal{A}}_{\alpha}^{\prime}(p^{\prime})\ |\ \max_{1\leq\alpha\leq k}{\mathcal{A}}_{\alpha}(p)\leq c\ {\rm and}\ M_{p;p^{\prime}}^{\mathbb{H}}\neq\emptyset\Big\}&lt;+\infty,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.I2.i2.p1.2" class="ltx_p">and</p>
<table id="S7.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex22.m1" class="ltx_math_unparsed" alttext="\lim_{\rho\to-\infty}\sup\Big\{\min_{1\leq\alpha\leq k^{\prime}}{\mathcal{A}}_{\alpha}^{\prime}(p^{\prime})\ |\ \max_{1\leq\alpha\leq k}{\mathcal{A}}_{\alpha}(p)\leq c,\ \min_{1\leq\alpha\leq k}{\mathcal{A}}_{\alpha}(p)\leq\rho,\ {\rm and}\ M_{p;p^{\prime}}^{\mathbb{H}}\neq\emptyset\Big\}=-\infty." display="block" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>ρ</mi><mo stretchy="false">→</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow></munder><mo lspace="0.167em" movablelimits="false" rspace="0em">sup</mo><mrow><mo stretchy="false">{</mo><munder><mi>min</mi><mrow><mn>1</mn><mo>≤</mo><mi>α</mi><mo>≤</mo><msup><mi>k</mi><mo>′</mo></msup></mrow></munder><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>α</mi><mo>′</mo></msubsup><mrow><mo stretchy="false">(</mo><msup><mi>p</mi><mo>′</mo></msup><mo rspace="0.500em" stretchy="false">)</mo></mrow><mo fence="false" rspace="0.667em" stretchy="false">|</mo><munder><mi>max</mi><mrow><mn>1</mn><mo>≤</mo><mi>α</mi><mo>≤</mo><mi>k</mi></mrow></munder><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>α</mi></msub><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow><mo>≤</mo><mi>c</mi><mo rspace="0.667em">,</mo><munder><mi>min</mi><mrow><mn>1</mn><mo>≤</mo><mi>α</mi><mo>≤</mo><mi>k</mi></mrow></munder><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>α</mi></msub><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow><mo>≤</mo><mi>ρ</mi><mo rspace="0.667em">,</mo><mi>and</mi><msubsup><mi>M</mi><mrow><mi>p</mi><mo>;</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mi>ℍ</mi></msubsup><mo>≠</mo><mi mathvariant="normal">∅</mi><mo stretchy="false">}</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mi mathvariant="normal">∞</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lim_{\rho\to-\infty}\sup\Big\{\min_{1\leq\alpha\leq k^{\prime}}{\mathcal{A}}_{\alpha}^{\prime}(p^{\prime})\ |\ \max_{1\leq\alpha\leq k}{\mathcal{A}}_{\alpha}(p)\leq c,\ \min_{1\leq\alpha\leq k}{\mathcal{A}}_{\alpha}(p)\leq\rho,\ {\rm and}\ M_{p;p^{\prime}}^{\mathbb{H}}\neq\emptyset\Big\}=-\infty.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
</div>
</div>
<div id="S7.Thmthm9" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm9.2" class="ltx_text ltx_font_bold">Definition 7.9</span></span><span id="S7.Thmthm9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm9.p1" class="ltx_para">
<p id="S7.Thmthm9.p1.1" class="ltx_p">Let <math id="S7.Thmthm9.p1.m1" class="ltx_Math" alttext="({\mathbb{F}}_{i},{\mathcal{A}}_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>i</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{i},{\mathcal{A}}_{i})</annotation></semantics></math>, <math id="S7.Thmthm9.p1.m2" class="ltx_Math" alttext="i=1,\ldots,m" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">i=1,\ldots,m</annotation></semantics></math> and <math id="S7.Thmthm9.p1.m3" class="ltx_Math" alttext="({\mathbb{F}}^{\prime},{\mathcal{A}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}^{\prime},{\mathcal{A}}^{\prime})</annotation></semantics></math> be locally finite flow categories enriched in <math id="S7.Thmthm9.p1.m4" class="ltx_Math" alttext="\underline{\smash{\bf C}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐂</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf C}}</annotation></semantics></math>. Let <math id="S7.Thmthm9.p1.m5" class="ltx_Math" alttext="{\mathbb{X}}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝕏</mi><mn>0</mn></msub><annotation encoding="application/x-tex">{\mathbb{X}}_{0}</annotation></semantics></math> and <math id="S7.Thmthm9.p1.m6" class="ltx_Math" alttext="{\mathbb{X}}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝕏</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\mathbb{X}}_{1}</annotation></semantics></math> be locally finite multimodules over <math id="S7.Thmthm9.p1.m7" class="ltx_Math" alttext="({\mathbb{F}}_{1},\cdots,{\mathbb{F}}_{m};{\mathbb{F}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo>,</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{1},\cdots,{\mathbb{F}}_{m};{\mathbb{F}}^{\prime})</annotation></semantics></math>. A <span id="S7.Thmthm9.p1.1.1" class="ltx_text ltx_font_bold">locally finite homotopy</span> from <math id="S7.Thmthm9.p1.m8" class="ltx_Math" alttext="{\mathbb{X}}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝕏</mi><mn>0</mn></msub><annotation encoding="application/x-tex">{\mathbb{X}}_{0}</annotation></semantics></math> to <math id="S7.Thmthm9.p1.m9" class="ltx_Math" alttext="{\mathbb{X}}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝕏</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\mathbb{X}}_{1}</annotation></semantics></math> is a locally finite weak homotopy between the corresponding weak bimodules.</p>
</div>
</div>
</section>
<section id="S7.SS1.SSS3" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">7.1.3. </span>Grading</h5>

<div id="S7.SS1.SSS3.p1" class="ltx_para ltx_noindent">
<p id="S7.SS1.SSS3.p1.1" class="ltx_p">Now we consider gradings on the flow categories, multimodules, and homotopies. Let <math id="S7.SS1.SSS3.p1.m1" class="ltx_Math" alttext="\underline{\smash{\bf C}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐂</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf C}}</annotation></semantics></math> be a regular stratification category which is either <math id="S7.SS1.SSS3.p1.m2" class="ltx_Math" alttext="\underline{\smash{\bf Kur}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐊𝐮𝐫</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf Kur}}</annotation></semantics></math>, <math id="S7.SS1.SSS3.p1.m3" class="ltx_Math" alttext="\underline{\smash{\bf dOrb}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf dOrb}}</annotation></semantics></math>, or <math id="S7.SS1.SSS3.p1.m4" class="ltx_Math" alttext="\underline{\smash{{\bf\Psi}{\bf Man}}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mrow><mi>𝚿</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐌𝐚𝐧</mi></mrow><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{{\bf\Psi}{\bf Man}}}</annotation></semantics></math>. Define the notion of <span id="S7.SS1.SSS3.p1.1.1" class="ltx_text ltx_font_bold">virtual dimension</span> by</p>
<table id="S7.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex23.m1" class="ltx_Math" alttext="{\rm dim}^{\rm vir}C:=\left\{\begin{array}[]{ll}{\rm dim}U-{\rm dim}G-{\rm rank}E,&amp;\ C=(G,U,E,S)\in{\rm Ob}\underline{\smash{\bf Kur}},\\
{\rm dim}{\mathcal{U}}-{\rm rank}{\mathcal{E}},&amp;\ C=({\mathcal{U}},{\mathcal{E}},{\mathcal{S}})\in{\rm Ob}\underline{\smash{\bf dOrb}},\\
{\rm dim}C,&amp;\ C\in{\rm Ob}\underline{\smash{{\bf\Psi}{\bf Man}}}\end{array}\right." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>dim</mi><mi>vir</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow><mo>:=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mi>dim</mi><mo lspace="0em" rspace="0em">​</mo><mi>U</mi></mrow><mo>−</mo><mrow><mi>dim</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mo>−</mo><mrow><mi>rank</mi><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>C</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>U</mi><mo>,</mo><mi>E</mi><mo>,</mo><mi>S</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝐊𝐮𝐫</mi><mo stretchy="true">¯</mo></munder></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mi>dim</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow><mo>−</mo><mrow><mi>rank</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>C</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>dim</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>C</mi><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mrow><mi>𝚿</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐌𝐚𝐧</mi></mrow><mo stretchy="true">¯</mo></munder></mrow></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">{\rm dim}^{\rm vir}C:=\left\{\begin{array}[]{ll}{\rm dim}U-{\rm dim}G-{\rm rank}E,&amp;\ C=(G,U,E,S)\in{\rm Ob}\underline{\smash{\bf Kur}},\\
{\rm dim}{\mathcal{U}}-{\rm rank}{\mathcal{E}},&amp;\ C=({\mathcal{U}},{\mathcal{E}},{\mathcal{S}})\in{\rm Ob}\underline{\smash{\bf dOrb}},\\
{\rm dim}C,&amp;\ C\in{\rm Ob}\underline{\smash{{\bf\Psi}{\bf Man}}}\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS3.p1.2" class="ltx_p">We allow different components of <math id="S7.SS1.SSS3.p1.m5" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> to have different virtual dimensions.</p>
</div>
<div id="S7.SS1.SSS3.p2" class="ltx_para ltx_noindent">
<p id="S7.SS1.SSS3.p2.1" class="ltx_p">Below we define gradings. In most of this paper, we will consider absolute, namely, <math id="S7.SS1.SSS3.p2.m1" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>-gradings; in certain situations we will reduce to cyclic gradings.</p>
</div>
<div id="S7.Thmthm10" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm10.2" class="ltx_text ltx_font_bold">Definition 7.10</span></span><span id="S7.Thmthm10.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm10.p1" class="ltx_para ltx_noindent">
<p id="S7.Thmthm10.p1.1" class="ltx_p">Let <math id="S7.Thmthm10.p1.m1" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> be a nonnegative integer. All flow categories and multimodules are assumed to be enriched in either <math id="S7.Thmthm10.p1.m2" class="ltx_Math" alttext="\underline{\smash{\bf Kur}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐊𝐮𝐫</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf Kur}}</annotation></semantics></math>, <math id="S7.Thmthm10.p1.m3" class="ltx_Math" alttext="\underline{\smash{\bf dOrb}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf dOrb}}</annotation></semantics></math>, or <math id="S7.Thmthm10.p1.m4" class="ltx_Math" alttext="\underline{\smash{{\bf\Psi}{\bf Man}}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mrow><mi>𝚿</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐌𝐚𝐧</mi></mrow><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{{\bf\Psi}{\bf Man}}}</annotation></semantics></math>.</p>
<ol id="S7.I3" class="ltx_enumerate">
<li id="S7.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S7.I3.i1.p1" class="ltx_para ltx_noindent">
<p id="S7.I3.i1.p1.1" class="ltx_p">A (cohomological) <math id="S7.I3.i1.p1.m1" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math><span id="S7.I3.i1.p1.1.1" class="ltx_text ltx_font_bold">-grading</span> on a flow category <math id="S7.I3.i1.p1.m2" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> is a function <math id="S7.I3.i1.p1.m3" class="ltx_Math" alttext="p\mapsto|p|\in{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo stretchy="false">↦</mo><mrow><mo stretchy="false">|</mo><mi>p</mi><mo stretchy="false">|</mo></mrow><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">p\mapsto|p|\in{\mathbb{Z}}</annotation></semantics></math> satisfying</p>
<table id="S7.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex24.m1" class="ltx_Math" alttext="{\rm dim}^{\rm vir}M_{pq}^{\mathbb{F}}=|q|-|p|-1,\ \forall p,q\in{\rm Ob}{\mathbb{F}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msup><mi>dim</mi><mi>vir</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">|</mo><mi>q</mi><mo stretchy="false">|</mo></mrow><mo rspace="0em">−</mo></mrow></mrow><mo fence="false" lspace="0em">|</mo><mrow><mi>p</mi><mo fence="false">|</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo rspace="0.667em">,</mo><mrow><mo rspace="0.167em">∀</mo><mi>p</mi></mrow><mo>,</mo><mrow><mi>q</mi><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\rm dim}^{\rm vir}M_{pq}^{\mathbb{F}}=|q|-|p|-1,\ \forall p,q\in{\rm Ob}{\mathbb{F}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S7.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S7.I3.i2.p1" class="ltx_para ltx_noindent">
<p id="S7.I3.i2.p1.1" class="ltx_p">Let <math id="S7.I3.i2.p1.m1" class="ltx_Math" alttext="{\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m},{\mathbb{F}}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔽</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo>,</mo><msup><mi>𝔽</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">{\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m},{\mathbb{F}}^{\prime}</annotation></semantics></math> be flow categories equipped with <math id="S7.I3.i2.p1.m2" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>-gradings. A multimodule <math id="S7.I3.i2.p1.m3" class="ltx_Math" alttext="{\mathbb{X}}" display="inline" intent=":literal"><semantics><mi>𝕏</mi><annotation encoding="application/x-tex">{\mathbb{X}}</annotation></semantics></math> over <math id="S7.I3.i2.p1.m4" class="ltx_Math" alttext="({\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m};{\mathbb{F}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo>,</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m};{\mathbb{F}}^{\prime})</annotation></semantics></math> is said to have cohomological degree <math id="S7.I3.i2.p1.m5" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> if for all <math id="S7.I3.i2.p1.m6" class="ltx_Math" alttext="p_{i}\in{\rm Ob}{\mathbb{F}}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>i</mi></msub><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔽</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">p_{i}\in{\rm Ob}{\mathbb{F}}_{i}</annotation></semantics></math> and <math id="S7.I3.i2.p1.m7" class="ltx_Math" alttext="p^{\prime}\in{\rm Ob}{\mathbb{F}}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>p</mi><mo>′</mo></msup><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔽</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">p^{\prime}\in{\rm Ob}{\mathbb{F}}^{\prime}</annotation></semantics></math></p>
<table id="S7.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex25.m1" class="ltx_math_unparsed" alttext="{\rm dim}^{\rm vir}M_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}=|p^{\prime}|-|p_{1}|-\cdots-|p_{m}|-r." display="block" intent=":literal"><semantics><mrow><mi>dim</mi><msup><mrow></mrow><mi>vir</mi></msup><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo rspace="0em">=</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup><mo fence="false" stretchy="false">|</mo><mo lspace="0em" rspace="0em">−</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0em">−</mo><mo lspace="0em" rspace="0em">⋯</mo><mo rspace="0em">−</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0em">−</mo><mi>r</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\rm dim}^{\rm vir}M_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}=|p^{\prime}|-|p_{1}|-\cdots-|p_{m}|-r.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
</div>
</div>
</section>
<section id="S7.SS1.SSS4" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">7.1.4. </span>Orientations</h5>

<div id="S7.SS1.SSS4.p1" class="ltx_para ltx_noindent">
<p id="S7.SS1.SSS4.p1.1" class="ltx_p">Defining chain complexes in characteristics other than <math id="S7.SS1.SSS4.p1.m1" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> requires orientations. We do not include orientations as part of the structure on objects in the categories <math id="S7.SS1.SSS4.p1.m2" class="ltx_Math" alttext="\underline{\smash{\bf Kur}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐊𝐮𝐫</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf Kur}}</annotation></semantics></math>, <math id="S7.SS1.SSS4.p1.m3" class="ltx_Math" alttext="\underline{\smash{\bf dOrb}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf dOrb}}</annotation></semantics></math>, or <math id="S7.SS1.SSS4.p1.m4" class="ltx_Math" alttext="\underline{\smash{{\bf\Psi}{\bf Man}}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mrow><mi>𝚿</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐌𝐚𝐧</mi></mrow><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{{\bf\Psi}{\bf Man}}}</annotation></semantics></math> as it is cumbersome to discuss orientations on the corners. Instead, we regard it as an extra structure on the flow category, multimodule, or homotopy.</p>
</div>
<div id="S7.SS1.SSS4.p2" class="ltx_para ltx_noindent">
<p id="S7.SS1.SSS4.p2.1" class="ltx_p"><span id="S7.SS1.SSS4.p2.1.1" class="ltx_text ltx_font_bold">Convention.</span> Let <math id="S7.SS1.SSS4.p2.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> be an oriented manifold with boundary. The induced boundary orientation is the one such that the</p>
<table id="S7.Ex26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex26.m1" class="ltx_Math" alttext="{\rm n}_{\rm out}\wedge{\rm or}_{\partial M}\in\det TM" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>n</mi><mi>out</mi></msub><mo>∧</mo><msub><mi>or</mi><mrow><mo>∂</mo><mi>M</mi></mrow></msub></mrow><mo rspace="0.1389em">∈</mo><mrow><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">det</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">{\rm n}_{\rm out}\wedge{\rm or}_{\partial M}\in\det TM</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS4.p2.2" class="ltx_p">coincides (up to positive scalar) with the orientation <math id="S7.SS1.SSS4.p2.m2" class="ltx_Math" alttext="{\rm or}_{M}" display="inline" intent=":literal"><semantics><msub><mi>or</mi><mi>M</mi></msub><annotation encoding="application/x-tex">{\rm or}_{M}</annotation></semantics></math> of <math id="S7.SS1.SSS4.p2.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>.</p>
</div>
<div id="S7.Thmthm11" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm11.2" class="ltx_text ltx_font_bold">Definition 7.11</span></span><span id="S7.Thmthm11.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm11.p1" class="ltx_para ltx_noindent">
<p id="S7.Thmthm11.p1.1" class="ltx_p">Let <math id="S7.Thmthm11.p1.m1" class="ltx_Math" alttext="C=({\mathcal{U}},{\mathcal{E}},{\mathcal{S}})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C=({\mathcal{U}},{\mathcal{E}},{\mathcal{S}})</annotation></semantics></math> be an <math id="S7.Thmthm11.p1.m2" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-stratified derived orbifold with <math id="S7.Thmthm11.p1.m3" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> being a normal poset (Definition <a href="#S2.Thmthm5" title="Definition 2.5. ‣ 2.1.1. Partially ordered sets ‣ 2.1. Regular posets ‣ 2. Regular Stratification Categories ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.5</span></a>).</p>
<ol id="S7.I4" class="ltx_enumerate">
<li id="S7.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S7.I4.i1.p1" class="ltx_para ltx_noindent">
<p id="S7.I4.i1.p1.1" class="ltx_p">For each element <math id="S7.I4.i1.p1.m1" class="ltx_Math" alttext="\alpha\in A" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mi>A</mi></mrow><annotation encoding="application/x-tex">\alpha\in A</annotation></semantics></math>, an orientation on <math id="S7.I4.i1.p1.m2" class="ltx_Math" alttext="\partial^{\alpha}C" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mi>α</mi></msup><mi>C</mi></mrow><annotation encoding="application/x-tex">\partial^{\alpha}C</annotation></semantics></math> is an orientation of the virtual vector bundle <math id="S7.I4.i1.p1.m3" class="ltx_Math" alttext="T\partial^{\alpha}{\mathcal{U}}-{\mathcal{E}}|_{\partial^{\alpha}V}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msup><mo>∂</mo><mi>α</mi></msup><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow></mrow><mo>−</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">|</mo></mrow><mrow><msup><mo>∂</mo><mi>α</mi></msup><mi>V</mi></mrow></msub></mrow><annotation encoding="application/x-tex">T\partial^{\alpha}{\mathcal{U}}-{\mathcal{E}}|_{\partial^{\alpha}V}</annotation></semantics></math>, or equivalently an orientation on the determinant line</p>
<table id="S7.Ex27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex27.m1" class="ltx_Math" alttext="\det(\partial^{\alpha}C):=\det(T\partial^{\alpha}{\mathcal{U}})\otimes\det({\mathcal{E}}^{*}|_{T\partial^{\alpha}{\mathcal{U}}})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo movablelimits="false" rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">∂</mo><mi>α</mi></msup><mi>C</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">:=</mo><mrow><mrow><mo lspace="0.1389em" movablelimits="false" rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msup><mo>∂</mo><mi>α</mi></msup><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo>⊗</mo><mrow><mo lspace="0.055em" movablelimits="false" rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><msub><mrow><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>∗</mo></msup><mo stretchy="false">|</mo></mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msup><mo>∂</mo><mi>α</mi></msup><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\det(\partial^{\alpha}C):=\det(T\partial^{\alpha}{\mathcal{U}})\otimes\det({\mathcal{E}}^{*}|_{T\partial^{\alpha}{\mathcal{U}}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.I4.i1.p1.2" class="ltx_p">Notice that for any face <math id="S7.I4.i1.p1.m4" class="ltx_Math" alttext="\beta\in\mathbb{Face}_{\alpha}" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>∈</mo><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕒</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕔</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝕖</mi><mi>α</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\beta\in\mathbb{Face}_{\alpha}</annotation></semantics></math>, an orientation on <math id="S7.I4.i1.p1.m5" class="ltx_Math" alttext="\partial^{\alpha}C" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mi>α</mi></msup><mi>C</mi></mrow><annotation encoding="application/x-tex">\partial^{\alpha}C</annotation></semantics></math> induces an orientation on <math id="S7.I4.i1.p1.m6" class="ltx_Math" alttext="\partial^{\beta}C" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mi>β</mi></msup><mi>C</mi></mrow><annotation encoding="application/x-tex">\partial^{\beta}C</annotation></semantics></math> by regarding the collar coordinate to point “inward.”</p>
</div></li>
<li id="S7.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S7.I4.i2.p1" class="ltx_para ltx_noindent">
<p id="S7.I4.i2.p1.1" class="ltx_p">An orientation on <math id="S7.I4.i2.p1.m1" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> consists of orientations on all top strata <math id="S7.I4.i2.p1.m2" class="ltx_Math" alttext="\partial^{\gamma}C" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mi>γ</mi></msup><mi>C</mi></mrow><annotation encoding="application/x-tex">\partial^{\gamma}C</annotation></semantics></math> such that for each fake boundary stratum <math id="S7.I4.i2.p1.m3" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math>, the orientation on <math id="S7.I4.i2.p1.m4" class="ltx_Math" alttext="\partial^{\beta}C" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mi>β</mi></msup><mi>C</mi></mrow><annotation encoding="application/x-tex">\partial^{\beta}C</annotation></semantics></math> induced from the (exactly) two adjacent top strata are opposite.</p>
</div></li>
<li id="S7.I4.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S7.I4.i3.p1" class="ltx_para ltx_noindent">
<p id="S7.I4.i3.p1.1" class="ltx_p">Let <math id="S7.I4.i3.p1.m1" class="ltx_Math" alttext="C^{\prime}=({\mathcal{U}}^{\prime},{\mathcal{E}}^{\prime},{\mathcal{S}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><msup><mi>C</mi><mo>′</mo></msup><mo>=</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>′</mo></msup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>′</mo></msup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C^{\prime}=({\mathcal{U}}^{\prime},{\mathcal{E}}^{\prime},{\mathcal{S}}^{\prime})</annotation></semantics></math> be another <math id="S7.I4.i3.p1.m2" class="ltx_Math" alttext="A^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>A</mi><mo>′</mo></msup><annotation encoding="application/x-tex">A^{\prime}</annotation></semantics></math>-stratified derived orbifold. An embedding <math id="S7.I4.i3.p1.m3" class="ltx_Math" alttext="\iota:C\to C^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>ι</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>C</mi><mo stretchy="false">→</mo><msup><mi>C</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\iota:C\to C^{\prime}</annotation></semantics></math> is said to be <span id="S7.I4.i3.p1.1.1" class="ltx_text ltx_font_bold">orientation-preserving</span> if the underlying poset map has degree zero (i.e. maps top strata to top strata) and if for each top stratum <math id="S7.I4.i3.p1.m4" class="ltx_Math" alttext="\gamma\in A" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>∈</mo><mi>A</mi></mrow><annotation encoding="application/x-tex">\gamma\in A</annotation></semantics></math> (which is mapped to <math id="S7.I4.i3.p1.m5" class="ltx_Math" alttext="\gamma^{\prime}\in A^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>γ</mi><mo>′</mo></msup><mo>∈</mo><msup><mi>A</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">\gamma^{\prime}\in A^{\prime}</annotation></semantics></math>), the induced map of determinant lines</p>
<table id="S7.Ex28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex28.m1" class="ltx_Math" alttext="\det(\partial^{\gamma}C)\to\det(\partial^{\gamma^{\prime}}C^{\prime})" display="block" intent=":literal"><semantics><mrow><mrow><mo movablelimits="false" rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">∂</mo><mi>γ</mi></msup><mi>C</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em" stretchy="false">→</mo><mrow><mo lspace="0.1389em" movablelimits="false" rspace="0em">det</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">∂</mo><msup><mi>γ</mi><mo>′</mo></msup></msup><msup><mi>C</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\det(\partial^{\gamma}C)\to\det(\partial^{\gamma^{\prime}}C^{\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.I4.i3.p1.2" class="ltx_p">is orientation-preserving.</p>
</div></li>
</ol>
</div>
</div>
<div id="S7.SS1.SSS4.p3" class="ltx_para ltx_noindent">
<p id="S7.SS1.SSS4.p3.1" class="ltx_p">On the other hand, an orientation on a stratified pseudomanifold <math id="S7.SS1.SSS4.p3.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is defined to consist of orientations on all top strata <math id="S7.SS1.SSS4.p3.m2" class="ltx_Math" alttext="\gamma\in A^{\rm max}" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>∈</mo><msup><mi>A</mi><mi>max</mi></msup></mrow><annotation encoding="application/x-tex">\gamma\in A^{\rm max}</annotation></semantics></math> satisfying the similar compatibility condition on fake boundaries.</p>
</div>
<div id="S7.Thmthm12" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm12.2" class="ltx_text ltx_font_bold">Definition 7.12</span></span><span id="S7.Thmthm12.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm12.p1" class="ltx_para ltx_noindent">
<p id="S7.Thmthm12.p1.1" class="ltx_p">Let <math id="S7.Thmthm12.p1.m1" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> be a flow category enriched in <math id="S7.Thmthm12.p1.m2" class="ltx_Math" alttext="\underline{\smash{\bf dOrb}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf dOrb}}</annotation></semantics></math> (resp. <math id="S7.Thmthm12.p1.m3" class="ltx_Math" alttext="\underline{\smash{{\bf\Psi}{\bf Man}}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mrow><mi>𝚿</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐌𝐚𝐧</mi></mrow><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{{\bf\Psi}{\bf Man}}}</annotation></semantics></math>). A <span id="S7.Thmthm12.p1.1.1" class="ltx_text ltx_font_bold">coherent orientation</span> on <math id="S7.Thmthm12.p1.m4" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> is a collection of orientations on the object <math id="S7.Thmthm12.p1.m5" class="ltx_Math" alttext="M_{pq}^{\mathbb{F}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><annotation encoding="application/x-tex">M_{pq}^{\mathbb{F}}</annotation></semantics></math> such that the singletons <math id="S7.Thmthm12.p1.m6" class="ltx_Math" alttext="M_{pp}^{\mathbb{F}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mi>𝔽</mi></msubsup><annotation encoding="application/x-tex">M_{pp}^{\mathbb{F}}</annotation></semantics></math> are positively oriented and such that whenever <math id="S7.Thmthm12.p1.m7" class="ltx_Math" alttext="p&lt;r&lt;q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mi>r</mi><mo>&lt;</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p&lt;r&lt;q</annotation></semantics></math>, the morphism</p>
<table id="S7.Ex29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex29.m1" class="ltx_Math" alttext="\iota_{prq}^{\mathbb{F}}:M_{pr}^{\mathbb{F}}\times M_{rq}^{\mathbb{F}}\to\partial^{prq}M_{pq}^{\mathbb{F}}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>ι</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mi>𝔽</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>M</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup></mrow><mo rspace="0.111em" stretchy="false">→</mo><mrow><msup><mo>∂</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msup><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\iota_{prq}^{\mathbb{F}}:M_{pr}^{\mathbb{F}}\times M_{rq}^{\mathbb{F}}\to\partial^{prq}M_{pq}^{\mathbb{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.Thmthm12.p1.2" class="ltx_p">is orientation-preserving up to factor</p>
<table id="S7.Ex30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex30.m1" class="ltx_Math" alttext="(-1)^{|p|-|r|}." display="block" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mo stretchy="false">|</mo><mi>p</mi><mo stretchy="false">|</mo></mrow><mo>−</mo><mrow><mo stretchy="false">|</mo><mi>r</mi><mo stretchy="false">|</mo></mrow></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(-1)^{|p|-|r|}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.Thmthm12.p1.3" class="ltx_p">Here by the definition of flow categories (Definition <a href="#S6.Thmthm1" title="Definition 6.1 (Flow categories). ‣ 6.1. Flow categories ‣ 6. Flow Categories, Multimodules, and Homotopies ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.1</span></a>), the top strata of <math id="S7.Thmthm12.p1.m8" class="ltx_Math" alttext="\partial^{prq}M_{pq}^{\mathbb{F}}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msup><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup></mrow><annotation encoding="application/x-tex">\partial^{prq}M_{pq}^{\mathbb{F}}</annotation></semantics></math> are true boundaries of <math id="S7.Thmthm12.p1.m9" class="ltx_Math" alttext="M_{pq}^{\mathbb{F}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><annotation encoding="application/x-tex">M_{pq}^{\mathbb{F}}</annotation></semantics></math>, hence have canonically induced orientations.</p>
</div>
<div id="S7.Thmthm12.p2" class="ltx_para">
<p id="S7.Thmthm12.p2.1" class="ltx_p">A flow category enriched in <math id="S7.Thmthm12.p2.m1" class="ltx_Math" alttext="\underline{\smash{\bf dOrb}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf dOrb}}</annotation></semantics></math> or <math id="S7.Thmthm12.p2.m2" class="ltx_Math" alttext="\underline{\smash{{\bf\Psi}{\bf Man}}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mrow><mi>𝚿</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐌𝐚𝐧</mi></mrow><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{{\bf\Psi}{\bf Man}}}</annotation></semantics></math> equipped with a coherent orientation is called <span id="S7.Thmthm12.p2.1.1" class="ltx_text ltx_font_bold">oriented</span>.</p>
</div>
</div>
<div id="S7.SS1.SSS4.p4" class="ltx_para ltx_noindent">
<p id="S7.SS1.SSS4.p4.1" class="ltx_p">Similarly we have the notion of orientation for multimodules. Notice the signs appearing in the definition, which are put in order to obtain the correct chain maps.</p>
</div>
<div id="S7.Thmthm13" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm13.2" class="ltx_text ltx_font_bold">Definition 7.13</span></span><span id="S7.Thmthm13.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm13.p1" class="ltx_para ltx_noindent">
<p id="S7.Thmthm13.p1.1" class="ltx_p">Let <math id="S7.Thmthm13.p1.m1" class="ltx_Math" alttext="{\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m},{\mathbb{F}}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔽</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo>,</mo><msup><mi>𝔽</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">{\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m},{\mathbb{F}}^{\prime}</annotation></semantics></math> be <math id="S7.Thmthm13.p1.m2" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>-graded oriented flow categories enriched in <math id="S7.Thmthm13.p1.m3" class="ltx_Math" alttext="\underline{\smash{\bf dOrb}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf dOrb}}</annotation></semantics></math> (resp. <math id="S7.Thmthm13.p1.m4" class="ltx_Math" alttext="\underline{\smash{{\bf\Psi}{\bf Man}}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mrow><mi>𝚿</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐌𝐚𝐧</mi></mrow><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{{\bf\Psi}{\bf Man}}}</annotation></semantics></math>). Let <math id="S7.Thmthm13.p1.m5" class="ltx_Math" alttext="{\mathbb{X}}" display="inline" intent=":literal"><semantics><mi>𝕏</mi><annotation encoding="application/x-tex">{\mathbb{X}}</annotation></semantics></math> be a degree zero multimodule over <math id="S7.Thmthm13.p1.m6" class="ltx_Math" alttext="({\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m};{\mathbb{F}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo>,</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m};{\mathbb{F}}^{\prime})</annotation></semantics></math>. Suppose all flow categories are equipped with coherent orientations. An <span id="S7.Thmthm13.p1.1.1" class="ltx_text ltx_font_bold">coherent orientation</span> on <math id="S7.Thmthm13.p1.m7" class="ltx_Math" alttext="{\mathbb{X}}" display="inline" intent=":literal"><semantics><mi>𝕏</mi><annotation encoding="application/x-tex">{\mathbb{X}}</annotation></semantics></math> consists of orientations on the charts <math id="S7.Thmthm13.p1.m8" class="ltx_Math" alttext="M_{pq}^{{\mathbb{X}}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝕏</mi></msubsup><annotation encoding="application/x-tex">M_{pq}^{{\mathbb{X}}}</annotation></semantics></math> such that</p>
<ol id="S7.I5" class="ltx_enumerate">
<li id="S7.I5.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S7.I5.i1.p1" class="ltx_para ltx_noindent">
<p id="S7.I5.i1.p1.1" class="ltx_p">For each <math id="S7.I5.i1.p1.m1" class="ltx_Math" alttext="i=1,\ldots,m" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">i=1,\ldots,m</annotation></semantics></math>, the morphism</p>
<table id="S7.Ex31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex31.m1" class="ltx_math_unparsed" alttext="M_{p_{i}q_{i}}^{{\mathbb{F}}_{i}}\times M_{p_{1}\cdots p_{i-1}q_{i}p_{i+1}\cdots p_{m};p^{\prime}}^{{\mathbb{X}}}\to\partial M_{p_{1}\cdots p_{m};p^{\prime}}^{{\mathbb{X}}}" display="block" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><msub><mi>p</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>i</mi></msub></mrow></msub><msup><mrow></mrow><msub><mi>𝔽</mi><mi>i</mi></msub></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mi>q</mi><msub><mrow></mrow><mi>i</mi></msub><mi>p</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo rspace="0.111em" stretchy="false">→</mo><mo>∂</mo><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup></mrow><annotation encoding="application/x-tex">M_{p_{i}q_{i}}^{{\mathbb{F}}_{i}}\times M_{p_{1}\cdots p_{i-1}q_{i}p_{i+1}\cdots p_{m};p^{\prime}}^{{\mathbb{X}}}\to\partial M_{p_{1}\cdots p_{m};p^{\prime}}^{{\mathbb{X}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.I5.i1.p1.2" class="ltx_p">is orientation-preserving up to the sign</p>
<table id="S7.Ex32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex32.m1" class="ltx_Math" alttext="(-1)^{(\sum_{j&lt;i}|p_{j}|)(|p_{i}|-|q_{i}|)}." display="block" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="false"><msub><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>j</mi><mo>&lt;</mo><mi>i</mi></mrow></msub></mstyle><mrow><mo stretchy="false">|</mo><msub><mi>p</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo>−</mo><mrow><mo stretchy="false">|</mo><msub><mi>q</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(-1)^{(\sum_{j&lt;i}|p_{j}|)(|p_{i}|-|q_{i}|)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.I5.i1.p1.3" class="ltx_p">In particular, for <math id="S7.I5.i1.p1.m2" class="ltx_Math" alttext="i=1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i=1</annotation></semantics></math>, the boundary orientation coincides with the product orientation.</p>
</div></li>
<li id="S7.I5.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S7.I5.i2.p1" class="ltx_para ltx_noindent">
<p id="S7.I5.i2.p1.1" class="ltx_p">The morphism</p>
<table id="S7.Ex33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex33.m1" class="ltx_math_unparsed" alttext="M_{p_{1}\cdots p_{m};q^{\prime}}^{\mathbb{X}}\times M_{q^{\prime}p^{\prime}}^{{\mathbb{F}}^{\prime}}\to\partial M_{p_{1}\cdots p_{m};p^{\prime}}^{{\mathbb{X}}}" display="block" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi><msub><mrow></mrow><mrow><msup><mi>q</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><msup><mi>𝔽</mi><mo>′</mo></msup></msup><mo rspace="0.111em" stretchy="false">→</mo><mo>∂</mo><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup></mrow><annotation encoding="application/x-tex">M_{p_{1}\cdots p_{m};q^{\prime}}^{\mathbb{X}}\times M_{q^{\prime}p^{\prime}}^{{\mathbb{F}}^{\prime}}\to\partial M_{p_{1}\cdots p_{m};p^{\prime}}^{{\mathbb{X}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.I5.i2.p1.2" class="ltx_p">is orientation-preserving up to the sign</p>
<table id="S7.Ex34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex34.m1" class="ltx_math_unparsed" alttext="(-1)^{{\rm dim}M_{p_{1}\cdots p_{m};q^{\prime}}^{\mathbb{X}}+1}." display="block" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mrow><mi>dim</mi><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(-1)^{{\rm dim}M_{p_{1}\cdots p_{m};q^{\prime}}^{\mathbb{X}}+1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
</div>
<div id="S7.Thmthm13.p2" class="ltx_para">
<p id="S7.Thmthm13.p2.1" class="ltx_p">A multimodule over oriented flow categories equipped with coherent orientations is called an <span id="S7.Thmthm13.p2.1.1" class="ltx_text ltx_font_bold">oriented multimodule</span>.</p>
</div>
</div>
<div id="S7.SS1.SSS4.p5" class="ltx_para ltx_noindent">
<p id="S7.SS1.SSS4.p5.1" class="ltx_p">We consider the orientation for concatenations. Let <math id="S7.SS1.SSS4.p5.m1" class="ltx_Math" alttext="{\mathbb{X}}" display="inline" intent=":literal"><semantics><mi>𝕏</mi><annotation encoding="application/x-tex">{\mathbb{X}}</annotation></semantics></math> be a multimodule over <math id="S7.SS1.SSS4.p5.m2" class="ltx_Math" alttext="({\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m};{\mathbb{G}}_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo>,</mo><msub><mi>𝔾</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m};{\mathbb{G}}_{i})</annotation></semantics></math> and <math id="S7.SS1.SSS4.p5.m3" class="ltx_Math" alttext="{\mathbb{Y}}" display="inline" intent=":literal"><semantics><mi>𝕐</mi><annotation encoding="application/x-tex">{\mathbb{Y}}</annotation></semantics></math> be a multimodule over <math id="S7.SS1.SSS4.p5.m4" class="ltx_Math" alttext="({\mathbb{G}}_{1},\ldots,{\mathbb{G}}_{n};{\mathbb{G}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔾</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔾</mi><mi>n</mi></msub><mo>,</mo><msup><mi>𝔾</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{G}}_{1},\ldots,{\mathbb{G}}_{n};{\mathbb{G}}^{\prime})</annotation></semantics></math>. Recall that for each tuple <math id="S7.SS1.SSS4.p5.m5" class="ltx_Math" alttext="p_{i}\in{\rm Ob}{\mathbb{F}}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>i</mi></msub><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔽</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">p_{i}\in{\rm Ob}{\mathbb{F}}_{i}</annotation></semantics></math>, <math id="S7.SS1.SSS4.p5.m6" class="ltx_Math" alttext="r_{j}\in{\rm Ob}{\mathbb{G}}_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi>j</mi></msub><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔾</mi><mi>j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">r_{j}\in{\rm Ob}{\mathbb{G}}_{j}</annotation></semantics></math> and <math id="S7.SS1.SSS4.p5.m7" class="ltx_Math" alttext="r^{\prime}\in{\rm Ob}{\mathbb{G}}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>r</mi><mo>′</mo></msup><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔾</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">r^{\prime}\in{\rm Ob}{\mathbb{G}}^{\prime}</annotation></semantics></math>, the top strata of <math id="S7.SS1.SSS4.p5.m8" class="ltx_math_unparsed" alttext="M_{r_{1}\cdots r_{i-1}p_{1}\cdots p_{m}r_{i}\cdots r_{n};r^{\prime}}^{{\mathbb{X}}\circ_{i}{\mathbb{Y}}}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mi>r</mi><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>n</mi></msub><mo>;</mo><mi>r</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mrow><mi>𝕏</mi><msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>i</mi></msub><mi>𝕐</mi></mrow></msup></mrow><annotation encoding="application/x-tex">M_{r_{1}\cdots r_{i-1}p_{1}\cdots p_{m}r_{i}\cdots r_{n};r^{\prime}}^{{\mathbb{X}}\circ_{i}{\mathbb{Y}}}</annotation></semantics></math> is the disjoint union of the top strata of</p>
<table id="S7.Ex35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex35.m1" class="ltx_math_unparsed" alttext="\bigsqcup_{r_{i}}M_{p_{1}\cdots p_{m};r_{i}}^{\mathbb{X}}\times M_{r_{1}\cdots r_{n};r^{\prime}}^{\mathbb{Y}}." display="block" intent=":literal"><semantics><mrow><mo movablelimits="false">⨆</mo><msub><mrow></mrow><msub><mi>r</mi><mi>i</mi></msub></msub><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>r</mi><msub><mrow></mrow><mi>i</mi></msub></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi><msub><mrow></mrow><mrow><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>n</mi></msub><mo>;</mo><mi>r</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕐</mi></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bigsqcup_{r_{i}}M_{p_{1}\cdots p_{m};r_{i}}^{\mathbb{X}}\times M_{r_{1}\cdots r_{n};r^{\prime}}^{\mathbb{Y}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS4.p5.2" class="ltx_p">We define each of these products to be oriented by the product orientation times the sign</p>
<table id="S7.Ex36" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex36.m1" class="ltx_math_unparsed" alttext="(-1)^{\left(\sum_{j&lt;i}|r_{j}|\right){\rm dim}M_{p_{1}\cdots p_{m};r_{i}}^{\mathbb{X}}}" display="block" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mrow><mo>(</mo><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>&lt;</mo><mi>i</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>r</mi><msub><mrow></mrow><mi>j</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo>)</mo><mi>dim</mi><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>r</mi><msub><mrow></mrow><mi>i</mi></msub></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup></mrow></msup><annotation encoding="application/x-tex">(-1)^{\left(\sum_{j&lt;i}|r_{j}|\right){\rm dim}M_{p_{1}\cdots p_{m};r_{i}}^{\mathbb{X}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS4.p5.3" class="ltx_p">(if the concatenation happens at the <math id="S7.SS1.SSS4.p5.m9" class="ltx_Math" alttext="i+1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i+1</annotation></semantics></math>-th input). The moduli spaces of the concatenation necessarily have fake boundaries and one can check easily that the above defined orientation on the interior induces an orientation on the orientations in the sense of Definition <a href="#S7.Thmthm11" title="Definition 7.11. ‣ 7.1.4. Orientations ‣ 7.1. Unobstructedness, local finiteness, grading, and orientations ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.11</span></a>. We then need to check that these orientations on individual moduli spaces define a coherent orientation of the multimodule.</p>
</div>
<div id="S7.Thmthm14" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm14.2" class="ltx_text ltx_font_bold">Lemma 7.14</span></span><span id="S7.Thmthm14.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm14.p1" class="ltx_para">
<p id="S7.Thmthm14.p1.1" class="ltx_p"><span id="S7.Thmthm14.p1.1.1" class="ltx_text ltx_font_italic">The orientation induced on <math id="S7.Thmthm14.p1.m1" class="ltx_Math" alttext="{\mathbb{X}}\circ_{i}{\mathbb{Y}}" display="inline" intent=":literal"><semantics><mrow><mi>𝕏</mi><msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>i</mi></msub><mi>𝕐</mi></mrow><annotation encoding="application/x-tex">{\mathbb{X}}\circ_{i}{\mathbb{Y}}</annotation></semantics></math> is coherent.</span></p>
</div>
</div>
<div id="S7.SS1.SSS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S7.SS1.SSS4.p6" class="ltx_para ltx_noindent">
<p id="S7.SS1.SSS4.p6.1" class="ltx_p"><span id="S7.SS1.SSS4.p6.1.1" class="ltx_text">Fix a moduli space</span></p>
<table id="S7.Ex37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex37.m1" class="ltx_math_unparsed" alttext="M_{r_{1}\cdots r_{i-1}p_{1}\cdots p_{m}r_{i+1}\cdots r_{n};r^{\prime}}^{{\mathbb{X}}\circ_{i}{\mathbb{Y}}}." display="block" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mi>r</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>n</mi></msub><mo>;</mo><mi>r</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mrow><mi>𝕏</mi><msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>i</mi></msub><mi>𝕐</mi></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">M_{r_{1}\cdots r_{i-1}p_{1}\cdots p_{m}r_{i+1}\cdots r_{n};r^{\prime}}^{{\mathbb{X}}\circ_{i}{\mathbb{Y}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS4.p6.2" class="ltx_p"><span id="S7.SS1.SSS4.p6.2.1" class="ltx_text">We first need to verify that the orientations on two open strata of this moduli space induce opposite orientations on the shared fake boundary stratum. Choose objects <math id="S7.SS1.SSS4.p6.m1" class="ltx_Math" alttext="r_{i}&lt;s_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi>i</mi></msub><mo>&lt;</mo><msub><mi>s</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">r_{i}&lt;s_{i}</annotation></semantics></math> of <math id="S7.SS1.SSS4.p6.m2" class="ltx_Math" alttext="{\mathbb{F}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝔽</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\mathbb{F}}_{i}</annotation></semantics></math>. The two open strata are</span></p>
<table id="S7.EGx21" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S7.E2"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.E2.m1" class="ltx_math_unparsed" alttext="\displaystyle\ M_{p_{1}\cdots p_{m};r_{i}}^{\mathbb{X}}\times M_{r_{1}\cdots r_{n};r^{\prime}}^{\mathbb{Y}},\ " display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>r</mi><msub><mrow></mrow><mi>i</mi></msub></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi><msub><mrow></mrow><mrow><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>n</mi></msub><mo>;</mo><mi>r</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕐</mi></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ M_{p_{1}\cdots p_{m};r_{i}}^{\mathbb{X}}\times M_{r_{1}\cdots r_{n};r^{\prime}}^{\mathbb{Y}},\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.E2.m2" class="ltx_math_unparsed" alttext="\displaystyle\ M_{p_{1}\cdots p_{m};s_{i}}^{\mathbb{X}}\times M_{r_{1}\cdots r_{i-1}s_{i}r_{i+1}\cdots r_{n};r^{\prime}}^{\mathbb{Y}}." display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>s</mi><msub><mrow></mrow><mi>i</mi></msub></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi><msub><mrow></mrow><mrow><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mi>s</mi><msub><mrow></mrow><mi>i</mi></msub><mi>r</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>n</mi></msub><mo>;</mo><mi>r</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕐</mi></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ M_{p_{1}\cdots p_{m};s_{i}}^{\mathbb{X}}\times M_{r_{1}\cdots r_{i-1}s_{i}r_{i+1}\cdots r_{n};r^{\prime}}^{\mathbb{Y}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7.2)</span></td></tr></tbody>
</table>
<p id="S7.SS1.SSS4.p6.3" class="ltx_p"><span id="S7.SS1.SSS4.p6.3.1" class="ltx_text">The shared fake boundary stratum is</span></p>
<table id="S7.Ex38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex38.m1" class="ltx_math_unparsed" alttext="M_{p_{1}\cdots p_{m};r_{i}}^{\mathbb{X}}\times M_{r_{i}s_{i}}^{{\mathbb{F}}_{i}}\times M_{r_{1}\cdots r_{i-1}s_{i}r_{i+1}\cdots r_{m};r^{\prime}}^{\mathbb{Y}}." display="block" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>r</mi><msub><mrow></mrow><mi>i</mi></msub></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi><msub><mrow></mrow><mrow><msub><mi>r</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mi>i</mi></msub></mrow></msub><msup><mrow></mrow><msub><mi>𝔽</mi><mi>i</mi></msub></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi><msub><mrow></mrow><mrow><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mi>s</mi><msub><mrow></mrow><mi>i</mi></msub><mi>r</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>r</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕐</mi></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">M_{p_{1}\cdots p_{m};r_{i}}^{\mathbb{X}}\times M_{r_{i}s_{i}}^{{\mathbb{F}}_{i}}\times M_{r_{1}\cdots r_{i-1}s_{i}r_{i+1}\cdots r_{m};r^{\prime}}^{\mathbb{Y}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS4.p6.4" class="ltx_p"><span id="S7.SS1.SSS4.p6.4.1" class="ltx_text">Use the product orientation as a reference. The orientation on this fake boundary induced from the first differs from the product orientation by</span></p>
<table id="S7.Ex39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex39.m1" class="ltx_math_unparsed" alttext="\left(\sum_{j&lt;i}|r_{j}|\right){\rm dim}M_{p_{1}\cdots p_{m};r_{i}}^{\mathbb{X}}+{\rm dim}M_{p_{1}\cdots p_{m};r_{i}}^{\mathbb{X}}+\left(\sum_{j&lt;i}|r_{j}|\right)(|r_{i}|-|s_{i}|)." display="block" intent=":literal"><semantics><mrow><mrow><mo>(</mo><munder><mo lspace="0em" movablelimits="false" rspace="0em">∑</mo><mrow><mi>j</mi><mo>&lt;</mo><mi>i</mi></mrow></munder><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>r</mi><mi>j</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo>)</mo></mrow><mi>dim</mi><msubsup><mi>M</mi><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>r</mi><msub><mrow></mrow><mi>i</mi></msub></mrow><mi>𝕏</mi></msubsup><mo>+</mo><mi>dim</mi><msubsup><mi>M</mi><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>r</mi><msub><mrow></mrow><mi>i</mi></msub></mrow><mi>𝕏</mi></msubsup><mo>+</mo><mrow><mo>(</mo><munder><mo lspace="0em" movablelimits="false" rspace="0em">∑</mo><mrow><mi>j</mi><mo>&lt;</mo><mi>i</mi></mrow></munder><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>r</mi><mi>j</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo>)</mo></mrow><mrow><mo stretchy="false">(</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>r</mi><mi>i</mi></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0em" rspace="0em">−</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>s</mi><mi>i</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left(\sum_{j&lt;i}|r_{j}|\right){\rm dim}M_{p_{1}\cdots p_{m};r_{i}}^{\mathbb{X}}+{\rm dim}M_{p_{1}\cdots p_{m};r_{i}}^{\mathbb{X}}+\left(\sum_{j&lt;i}|r_{j}|\right)(|r_{i}|-|s_{i}|).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS4.p6.5" class="ltx_p"><span id="S7.SS1.SSS4.p6.5.1" class="ltx_text">The second orientation on the fake boundary differs by a sign</span></p>
<table id="S7.Ex40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex40.m1" class="ltx_math_unparsed" alttext="\left(\sum_{j&lt;i}|r_{j}|\right){\rm dim}M_{p_{1}\cdots p_{m};s_{i}}^{\mathbb{X}}+{\rm dim}M_{p_{1}\cdots p_{m};r_{i}}^{\mathbb{X}}+1." display="block" intent=":literal"><semantics><mrow><mrow><mo>(</mo><munder><mo lspace="0em" movablelimits="false" rspace="0em">∑</mo><mrow><mi>j</mi><mo>&lt;</mo><mi>i</mi></mrow></munder><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>r</mi><mi>j</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo>)</mo></mrow><mi>dim</mi><msubsup><mi>M</mi><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>s</mi><msub><mrow></mrow><mi>i</mi></msub></mrow><mi>𝕏</mi></msubsup><mo>+</mo><mi>dim</mi><msubsup><mi>M</mi><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>r</mi><msub><mrow></mrow><mi>i</mi></msub></mrow><mi>𝕏</mi></msubsup><mo>+</mo><mn>1</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left(\sum_{j&lt;i}|r_{j}|\right){\rm dim}M_{p_{1}\cdots p_{m};s_{i}}^{\mathbb{X}}+{\rm dim}M_{p_{1}\cdots p_{m};r_{i}}^{\mathbb{X}}+1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS4.p6.6" class="ltx_p"><span id="S7.SS1.SSS4.p6.6.1" class="ltx_text">One can see that they are indeed opposite.</span></p>
</div>
<div id="S7.SS1.SSS4.p7" class="ltx_para ltx_noindent">
<p id="S7.SS1.SSS4.p7.1" class="ltx_p"><span id="S7.SS1.SSS4.p7.1.1" class="ltx_text">Then one has to verify conditions listed in Definition <a href="#S7.Thmthm13" title="Definition 7.13. ‣ 7.1.4. Orientations ‣ 7.1. Unobstructedness, local finiteness, grading, and orientations ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.13</span></a> for the concatenation. For breakings at some <math id="S7.SS1.SSS4.p7.m1" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>-th input <math id="S7.SS1.SSS4.p7.m2" class="ltx_Math" alttext="s_{j}\in{\rm Ob}{\mathbb{G}}_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mi>j</mi></msub><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔾</mi><mi>j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">s_{j}\in{\rm Ob}{\mathbb{G}}_{j}</annotation></semantics></math> for <math id="S7.SS1.SSS4.p7.m3" class="ltx_Math" alttext="j&lt;i" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>&lt;</mo><mi>i</mi></mrow><annotation encoding="application/x-tex">j&lt;i</annotation></semantics></math> and breakings at some <math id="S7.SS1.SSS4.p7.m4" class="ltx_Math" alttext="i+l-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>+</mo><mi>l</mi></mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i+l-1</annotation></semantics></math>-th input <math id="S7.SS1.SSS4.p7.m5" class="ltx_Math" alttext="q_{l}\in{\rm Ob}{\mathbb{F}}_{l}" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>l</mi></msub><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔽</mi><mi>l</mi></msub></mrow></mrow><annotation encoding="application/x-tex">q_{l}\in{\rm Ob}{\mathbb{F}}_{l}</annotation></semantics></math>, the verification is straightforward.</span></p>
</div>
<div id="S7.SS1.SSS4.p8" class="ltx_para">
<p id="S7.SS1.SSS4.p8.1" class="ltx_p"><span id="S7.SS1.SSS4.p8.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="S7.Thmthm15" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm15.2" class="ltx_text ltx_font_bold">Definition 7.15</span></span><span id="S7.Thmthm15.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm15.p1" class="ltx_para ltx_noindent">
<p id="S7.Thmthm15.p1.1" class="ltx_p">Let <math id="S7.Thmthm15.p1.m1" class="ltx_Math" alttext="{\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m},{\mathbb{F}}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔽</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo>,</mo><msup><mi>𝔽</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">{\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m},{\mathbb{F}}^{\prime}</annotation></semantics></math> be <math id="S7.Thmthm15.p1.m2" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>-graded oriented flow categories enriched in <math id="S7.Thmthm15.p1.m3" class="ltx_Math" alttext="\underline{\smash{\bf dOrb}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf dOrb}}</annotation></semantics></math> (resp. <math id="S7.Thmthm15.p1.m4" class="ltx_Math" alttext="\underline{\smash{{\bf\Psi}{\bf Man}}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mrow><mi>𝚿</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐌𝐚𝐧</mi></mrow><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{{\bf\Psi}{\bf Man}}}</annotation></semantics></math>), <math id="S7.Thmthm15.p1.m5" class="ltx_Math" alttext="{\mathbb{X}}_{0},{\mathbb{X}}_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝕏</mi><mn>0</mn></msub><mo>,</mo><msub><mi>𝕏</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">{\mathbb{X}}_{0},{\mathbb{X}}_{1}</annotation></semantics></math> be oriented flow multimodules over <math id="S7.Thmthm15.p1.m6" class="ltx_Math" alttext="({\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m};{\mathbb{F}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo>,</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m};{\mathbb{F}}^{\prime})</annotation></semantics></math> of degree zero (see Definition <a href="#S7.Thmthm10" title="Definition 7.10. ‣ 7.1.3. Grading ‣ 7.1. Unobstructedness, local finiteness, grading, and orientations ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.10</span></a>). Let <math id="S7.Thmthm15.p1.m7" class="ltx_Math" alttext="{\mathbb{H}}" display="inline" intent=":literal"><semantics><mi>ℍ</mi><annotation encoding="application/x-tex">{\mathbb{H}}</annotation></semantics></math> be a <math id="S7.Thmthm15.p1.m8" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>-graded homotopy from <math id="S7.Thmthm15.p1.m9" class="ltx_Math" alttext="{\mathbb{X}}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝕏</mi><mn>0</mn></msub><annotation encoding="application/x-tex">{\mathbb{X}}_{0}</annotation></semantics></math> to <math id="S7.Thmthm15.p1.m10" class="ltx_Math" alttext="{\mathbb{X}}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝕏</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\mathbb{X}}_{1}</annotation></semantics></math>. A <span id="S7.Thmthm15.p1.1.1" class="ltx_text ltx_font_bold">coherent orientation</span> on <math id="S7.Thmthm15.p1.m11" class="ltx_Math" alttext="{\mathbb{H}}" display="inline" intent=":literal"><semantics><mi>ℍ</mi><annotation encoding="application/x-tex">{\mathbb{H}}</annotation></semantics></math> consists of orientations on the charts <math id="S7.Thmthm15.p1.m12" class="ltx_Math" alttext="M_{pp^{\prime}}^{{\mathbb{H}}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mi>ℍ</mi></msubsup><annotation encoding="application/x-tex">M_{pp^{\prime}}^{{\mathbb{H}}}</annotation></semantics></math> such that</p>
<ol id="S7.I6" class="ltx_enumerate">
<li id="S7.I6.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S7.I6.i1.p1" class="ltx_para ltx_noindent">
<p id="S7.I6.i1.p1.1" class="ltx_p">The embedding</p>
<table id="S7.Ex41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex41.m1" class="ltx_Math" alttext="(-M_{pp^{\prime}}^{{\mathbb{B}}_{0}})\sqcup M_{pp^{\prime}}^{{\mathbb{B}}_{1}}\to\partial M_{pp^{\prime}}^{{\mathbb{H}}}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><msub><mi>𝔹</mi><mn>0</mn></msub></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo>⊔</mo><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><msub><mi>𝔹</mi><mn>1</mn></msub></msubsup></mrow><mo rspace="0.111em" stretchy="false">→</mo><mrow><mo>∂</mo><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mi>ℍ</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">(-M_{pp^{\prime}}^{{\mathbb{B}}_{0}})\sqcup M_{pp^{\prime}}^{{\mathbb{B}}_{1}}\to\partial M_{pp^{\prime}}^{{\mathbb{H}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.I6.i1.p1.2" class="ltx_p">is orientation-preserving.</p>
</div></li>
<li id="S7.I6.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S7.I6.i2.p1" class="ltx_para ltx_noindent">
<p id="S7.I6.i2.p1.1" class="ltx_p">The embedding</p>
<table id="S7.Ex42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex42.m1" class="ltx_math_unparsed" alttext="M_{p_{i}q_{i}}^{{\mathbb{F}}_{i}}\times M_{p_{1}\cdots p_{i-1}q_{i}p_{i+1}\cdots p_{m};p^{\prime}}^{{\mathbb{H}}}\to\partial M_{p_{1}\cdots p_{m};p^{\prime}}^{{\mathbb{H}}}" display="block" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><msub><mi>p</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>i</mi></msub></mrow></msub><msup><mrow></mrow><msub><mi>𝔽</mi><mi>i</mi></msub></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mi>q</mi><msub><mrow></mrow><mi>i</mi></msub><mi>p</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>ℍ</mi></msup><mo rspace="0.111em" stretchy="false">→</mo><mo>∂</mo><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>ℍ</mi></msup></mrow><annotation encoding="application/x-tex">M_{p_{i}q_{i}}^{{\mathbb{F}}_{i}}\times M_{p_{1}\cdots p_{i-1}q_{i}p_{i+1}\cdots p_{m};p^{\prime}}^{{\mathbb{H}}}\to\partial M_{p_{1}\cdots p_{m};p^{\prime}}^{{\mathbb{H}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.I6.i2.p1.2" class="ltx_p">is orientation-preserving up to the sign</p>
<table id="S7.Ex43" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex43.m1" class="ltx_Math" alttext="(-1)^{\left(\sum_{j&lt;i}|p_{j}|\right)(|p_{i}|-|q_{i}|)}." display="block" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="false"><msub><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>j</mi><mo>&lt;</mo><mi>i</mi></mrow></msub></mstyle><mrow><mo stretchy="false">|</mo><msub><mi>p</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo>−</mo><mrow><mo stretchy="false">|</mo><msub><mi>q</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(-1)^{\left(\sum_{j&lt;i}|p_{j}|\right)(|p_{i}|-|q_{i}|)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S7.I6.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S7.I6.i3.p1" class="ltx_para ltx_noindent">
<p id="S7.I6.i3.p1.1" class="ltx_p">The embedding</p>
<table id="S7.Ex44" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex44.m1" class="ltx_math_unparsed" alttext="M_{p_{1}\cdots p_{m};q^{\prime}}^{{\mathbb{H}}}\times M_{q^{\prime}p^{\prime}}^{{\mathbb{F}}^{\prime}}\to\partial M_{p_{1}\cdots p_{m};p^{\prime}}^{{\mathbb{H}}}" display="block" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>ℍ</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi><msub><mrow></mrow><mrow><msup><mi>q</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><msup><mi>𝔽</mi><mo>′</mo></msup></msup><mo rspace="0.111em" stretchy="false">→</mo><mo>∂</mo><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>ℍ</mi></msup></mrow><annotation encoding="application/x-tex">M_{p_{1}\cdots p_{m};q^{\prime}}^{{\mathbb{H}}}\times M_{q^{\prime}p^{\prime}}^{{\mathbb{F}}^{\prime}}\to\partial M_{p_{1}\cdots p_{m};p^{\prime}}^{{\mathbb{H}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.I6.i3.p1.2" class="ltx_p">is orientation-preserving up to the sign</p>
<table id="S7.Ex45" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex45.m1" class="ltx_math_unparsed" alttext="(-1)^{{\rm dim}M_{p_{1}\cdots p_{m};q^{\prime}}^{\mathbb{H}}+1}." display="block" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mrow><mi>dim</mi><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>ℍ</mi></msup><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(-1)^{{\rm dim}M_{p_{1}\cdots p_{m};q^{\prime}}^{\mathbb{H}}+1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
</div>
</div>
</section>
</section>
<section id="S7.SS2" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">7.2. </span>Algebraic structures without symmetry</h4>

<div id="S7.SS2.p1" class="ltx_para ltx_noindent">
<p id="S7.SS2.p1.1" class="ltx_p">We define chain complexes, chain maps, and chain homotopies associated to flow categories, bimodules, and homotopies enriched in <math id="S7.SS2.p1.m1" class="ltx_Math" alttext="\underline{\smash{{\bf\Psi}{\bf Man}}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mrow><mi>𝚿</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐌𝐚𝐧</mi></mrow><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{{\bf\Psi}{\bf Man}}}</annotation></semantics></math>. We only impose the Novikov convergence condition but not the symmetries. Hence the resulting objects are only modules over <math id="S7.SS2.p1.m2" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math> but not the Novikov rings.</p>
</div>
<section id="S7.SS2.SSS1" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">7.2.1. </span>The chain group</h5>

<div id="S7.SS2.SSS1.p1" class="ltx_para ltx_noindent">
<p id="S7.SS2.SSS1.p1.1" class="ltx_p">We only state the construction for the <math id="S7.SS2.SSS1.p1.m1" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>-graded case. The cyclically graded case can be produced in a similar fashion.</p>
</div>
<div id="S7.SS2.SSS1.p2" class="ltx_para ltx_noindent">
<p id="S7.SS2.SSS1.p2.1" class="ltx_p">To a <math id="S7.SS2.SSS1.p2.m1" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>-graded locally finite weak flow category <math id="S7.SS2.SSS1.p2.m2" class="ltx_Math" alttext="({\mathbb{F}},{\mathcal{A}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝔽</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}},{\mathcal{A}})</annotation></semantics></math> enriched in <math id="S7.SS2.SSS1.p2.m3" class="ltx_Math" alttext="\underline{\smash{\bf C}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐂</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf C}}</annotation></semantics></math> (see Definition <a href="#S7.Thmthm2" title="Definition 7.2. ‣ 7.1.2. Convergence ‣ 7.1. Unobstructedness, local finiteness, grading, and orientations ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.2</span></a>), one can associate a chain group</p>
<table id="S7.Ex46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex46.m1" class="ltx_math_unparsed" alttext="C_{*}({\mathbb{F}}):=\left\{\sum_{i=1}^{\infty}a_{i}p_{i}\ \left|\ \begin{array}[]{l}a_{i}\in{\mathbb{Z}},\ p_{i}\in{\rm Ob}{\mathbb{F}},\ \displaystyle\sup_{i}{\mathcal{A}}_{\alpha}(p_{i})&lt;+\infty\ \forall\alpha=1,\ldots,m,\\
\forall c&gt;0,\ \#\big\{i\ |\ {\mathcal{A}}_{\alpha}(p_{i})&gt;-c\ \forall\alpha=1,\ldots,k\big\}&lt;\infty\end{array}\right.\right\}." display="block" intent=":literal"><semantics><mrow><msub><mi>C</mi><mo>∗</mo></msub><mrow><mo stretchy="false">(</mo><mi>𝔽</mi><mo stretchy="false">)</mo></mrow><mo>:=</mo><mrow><mo>{</mo><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover><msub><mi>a</mi><mi>i</mi></msub><msub><mi>p</mi><mi>i</mi></msub><mo fence="false" rspace="0.667em">|</mo><mtable displaystyle="true" rowspacing="2.0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi>a</mi><msub><mrow></mrow><mi>i</mi></msub><mo>∈</mo><mi>ℤ</mi><mo rspace="0.667em">,</mo><mi>p</mi><msub><mrow></mrow><mi>i</mi></msub><mo>∈</mo><mi>Ob</mi><mi>𝔽</mi><mo rspace="0.389em">,</mo><mo movablelimits="false" rspace="0.167em">sup</mo><msub><mrow></mrow><mi>i</mi></msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mrow></mrow><mi>α</mi></msub><mo stretchy="false">(</mo><mi>p</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo rspace="0em">&lt;</mo><mo lspace="0em">+</mo><mi mathvariant="normal">∞</mi><mo lspace="0.667em" rspace="0.167em">∀</mo><mi>α</mi><mo>=</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>m</mi><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mo rspace="0.167em">∀</mo><mi>c</mi><mo>&gt;</mo><mn>0</mn><mo rspace="0.667em">,</mo><mi>#</mi><mo stretchy="false">{</mo><mi>i</mi><mo fence="false" lspace="0.500em" rspace="0.667em" stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mrow></mrow><mi>α</mi></msub><mo stretchy="false">(</mo><mi>p</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo rspace="0em">&gt;</mo><mo lspace="0em">−</mo><mi>c</mi><mo lspace="0.667em" rspace="0.167em">∀</mo><mi>α</mi><mo>=</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>k</mi><mo stretchy="false">}</mo><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow></mtd></mtr></mtable><mo>}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">C_{*}({\mathbb{F}}):=\left\{\sum_{i=1}^{\infty}a_{i}p_{i}\ \left|\ \begin{array}[]{l}a_{i}\in{\mathbb{Z}},\ p_{i}\in{\rm Ob}{\mathbb{F}},\ \displaystyle\sup_{i}{\mathcal{A}}_{\alpha}(p_{i})&lt;+\infty\ \forall\alpha=1,\ldots,m,\\
\forall c&gt;0,\ \#\big\{i\ |\ {\mathcal{A}}_{\alpha}(p_{i})&gt;-c\ \forall\alpha=1,\ldots,k\big\}&lt;\infty\end{array}\right.\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.SSS1.p2.2" class="ltx_p">It is not necessarily finitely generated over <math id="S7.SS2.SSS1.p2.m4" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>. We call it the <span id="S7.SS2.SSS1.p2.2.1" class="ltx_text ltx_font_bold">Floer chain group</span> associated to <math id="S7.SS2.SSS1.p2.m5" class="ltx_Math" alttext="({\mathbb{F}},{\mathcal{A}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝔽</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}},{\mathcal{A}})</annotation></semantics></math>. It carries a natural valuation</p>
<table id="S7.Ex47" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex47.m1" class="ltx_Math" alttext="{\mathfrak{v}}=({\mathfrak{v}}_{1},\ldots,{\mathfrak{v}}_{k}):C_{*}({\mathbb{F}})\setminus\{0\}\to{\mathbb{R}}^{k},\ {\rm where}\ {\mathfrak{v}}_{\alpha}\left(\sum_{i=1}^{\infty}a_{i}p_{i}\right)=\sup_{i}{\mathcal{A}}_{\alpha}(p_{i})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔳</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔳</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔳</mi><mi>k</mi></msub><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mrow><mrow><mrow><msub><mi>C</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝔽</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∖</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mi>k</mi></msup></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mi>where</mi><mo lspace="0.500em" rspace="0em">​</mo><msub><mi>𝔳</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><msub><mi>a</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>i</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">sup</mo><mi>i</mi></munder><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathfrak{v}}=({\mathfrak{v}}_{1},\ldots,{\mathfrak{v}}_{k}):C_{*}({\mathbb{F}})\setminus\{0\}\to{\mathbb{R}}^{k},\ {\rm where}\ {\mathfrak{v}}_{\alpha}\left(\sum_{i=1}^{\infty}a_{i}p_{i}\right)=\sup_{i}{\mathcal{A}}_{\alpha}(p_{i}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.SSS1.p2.3" class="ltx_p">For each <math id="S7.SS2.SSS1.p2.m6" class="ltx_Math" alttext="k\in{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">k\in{\mathbb{Z}}</annotation></semantics></math>, denote</p>
<table id="S7.Ex48" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex48.m1" class="ltx_Math" alttext="C_{k}({\mathbb{F}}):=\left\{\sum_{i=1}^{\infty}a_{i}p_{i}\in C_{*}({\mathbb{F}})\ |\ {\rm deg}(p_{i})=k\right\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>C</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝔽</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mo>{</mo><mrow><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><msub><mi>a</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>i</mi></msub></mrow></mrow><mo>∈</mo><mrow><msub><mi>C</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝔽</mi><mo rspace="0.222em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.500em">|</mo><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>k</mi></mrow><mo>}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">C_{k}({\mathbb{F}}):=\left\{\sum_{i=1}^{\infty}a_{i}p_{i}\in C_{*}({\mathbb{F}})\ |\ {\rm deg}(p_{i})=k\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S7.SS2.SSS1.p3" class="ltx_para ltx_noindent">
<p id="S7.SS2.SSS1.p3.1" class="ltx_p">Suppose <math id="S7.SS2.SSS1.p3.m1" class="ltx_Math" alttext="({\mathbb{F}}^{\prime},{\mathcal{A}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}^{\prime},{\mathcal{A}}^{\prime})</annotation></semantics></math> and <math id="S7.SS2.SSS1.p3.m2" class="ltx_Math" alttext="({\mathbb{F}}^{\prime\prime},{\mathcal{A}}^{\prime\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>𝔽</mi><mo>′′</mo></msup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>′′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}^{\prime\prime},{\mathcal{A}}^{\prime\prime})</annotation></semantics></math> are two weak Novikov flow categories. The Floer chain group <math id="S7.SS2.SSS1.p3.m3" class="ltx_Math" alttext="C_{*}({\mathbb{F}}^{\prime}\times{\mathbb{F}}^{\prime\prime})" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝔽</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝔽</mi><mo>′′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{*}({\mathbb{F}}^{\prime}\times{\mathbb{F}}^{\prime\prime})</annotation></semantics></math> is a kind of completion of the tensor product chain groups of the factors. Indeed, on the algebraic (finite) tensor product</p>
<table id="S7.Ex49" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex49.m1" class="ltx_Math" alttext="C_{*}({\mathbb{F}}^{\prime})\underset{\mathbb{Z}}{\otimes}C_{*}({\mathbb{F}}^{\prime\prime})" display="block" intent=":literal"><semantics><mrow><msub><mi>C</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0.222em" rspace="0em">​</mo><munder accentunder="true"><mo>⊗</mo><mo mathsize="0.700em">ℤ</mo></munder><mo lspace="0.222em" rspace="0em">​</mo><msub><mi>C</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝔽</mi><mo>′′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{*}({\mathbb{F}}^{\prime})\underset{\mathbb{Z}}{\otimes}C_{*}({\mathbb{F}}^{\prime\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.SSS1.p3.2" class="ltx_p">there is the valuation <math id="S7.SS2.SSS1.p3.m4" class="ltx_Math" alttext="{\mathfrak{v}}" display="inline" intent=":literal"><semantics><mi>𝔳</mi><annotation encoding="application/x-tex">{\mathfrak{v}}</annotation></semantics></math> induced by <math id="S7.SS2.SSS1.p3.m5" class="ltx_Math" alttext="{\mathfrak{v}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝔳</mi><mo>′</mo></msup><annotation encoding="application/x-tex">{\mathfrak{v}}^{\prime}</annotation></semantics></math> and <math id="S7.SS2.SSS1.p3.m6" class="ltx_Math" alttext="{\mathfrak{v}}^{\prime\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝔳</mi><mo>′′</mo></msup><annotation encoding="application/x-tex">{\mathfrak{v}}^{\prime\prime}</annotation></semantics></math>. Then one can form the completion</p>
<table id="S7.Ex50" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex50.m1" class="ltx_Math" alttext="C_{*}({\mathbb{F}}^{\prime})\widehat{\underset{\mathbb{Z}}{\otimes}}C_{*}({\mathbb{F}}^{\prime\prime})." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0.222em" rspace="0em">​</mo><munderover accent="true" accentunder="true"><mo>⊗</mo><mo mathsize="0.700em">ℤ</mo><mo>^</mo></munderover><mo lspace="0.222em" rspace="0em">​</mo><msub><mi>C</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝔽</mi><mo>′′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">C_{*}({\mathbb{F}}^{\prime})\widehat{\underset{\mathbb{Z}}{\otimes}}C_{*}({\mathbb{F}}^{\prime\prime}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="S7.SS2.SSS2" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">7.2.2. </span>The differential</h5>

<div id="S7.SS2.SSS2.p1" class="ltx_para ltx_noindent">
<p id="S7.SS2.SSS2.p1.1" class="ltx_p">Now, we assume that the flow category <math id="S7.SS2.SSS2.p1.m1" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> is enriched in <math id="S7.SS2.SSS2.p1.m2" class="ltx_Math" alttext="\underline{\smash{{\bf\Psi}{\bf Man}}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mrow><mi>𝚿</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐌𝐚𝐧</mi></mrow><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{{\bf\Psi}{\bf Man}}}</annotation></semantics></math> and it is oriented. We define a linear map</p>
<table id="S7.Ex51" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex51.m1" class="ltx_Math" alttext="d:C_{k}({\mathbb{F}})\to C_{k-1}({\mathbb{F}}),\ k\in{\mathbb{Z}}" display="block" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>C</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝔽</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi>C</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝔽</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mi>k</mi><mo>∈</mo><mi>ℤ</mi></mrow></mrow><annotation encoding="application/x-tex">d:C_{k}({\mathbb{F}})\to C_{k-1}({\mathbb{F}}),\ k\in{\mathbb{Z}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.SSS2.p1.2" class="ltx_p">in the following way. Note that the morphism space <math id="S7.SS2.SSS2.p1.m3" class="ltx_Math" alttext="M_{pq}^{\mathbb{F}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><annotation encoding="application/x-tex">M_{pq}^{\mathbb{F}}</annotation></semantics></math> is an oriented and compact pseudomanifold of dimension</p>
<table id="S7.Ex52" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex52.m1" class="ltx_Math" alttext="{\rm dim}M_{pq}^{\mathbb{F}}\equiv{\rm deg}(p)-{\rm deg}(q)-1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>dim</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup></mrow><mo>≡</mo><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mn>1</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\rm dim}M_{pq}^{\mathbb{F}}\equiv{\rm deg}(p)-{\rm deg}(q)-1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.SSS2.p1.3" class="ltx_p">When the dimension is zero, <math id="S7.SS2.SSS2.p1.m4" class="ltx_Math" alttext="M_{pq}^{{\mathbb{F}}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><annotation encoding="application/x-tex">M_{pq}^{{\mathbb{F}}}</annotation></semantics></math> consists of finitely many oriented points, which defines a count <math id="S7.SS2.SSS2.p1.m5" class="ltx_Math" alttext="n_{pq}^{\mathbb{F}}\in{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>n</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">n_{pq}^{\mathbb{F}}\in{\mathbb{Z}}</annotation></semantics></math>; in other cases, define <math id="S7.SS2.SSS2.p1.m6" class="ltx_Math" alttext="n_{pq}^{\mathbb{F}}=0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>n</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n_{pq}^{\mathbb{F}}=0</annotation></semantics></math>. Define</p>
<table id="S7.Ex53" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex53.m1" class="ltx_Math" alttext="d\left(\sum_{i=1}^{\infty}a_{i}p_{i}\right)=\sum_{i=1}^{\infty}\sum_{q\in{\rm Ob}{\mathbb{F}}}a_{i}n_{p_{i}q}^{\mathbb{F}}q." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><msub><mi>a</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>i</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>q</mi><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></mrow></munder><mrow><msub><mi>a</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>n</mi><mrow><msub><mi>p</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">d\left(\sum_{i=1}^{\infty}a_{i}p_{i}\right)=\sum_{i=1}^{\infty}\sum_{q\in{\rm Ob}{\mathbb{F}}}a_{i}n_{p_{i}q}^{\mathbb{F}}q.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.SSS2.p1.4" class="ltx_p">The local finiteness property stated in Definition <a href="#S7.Thmthm2" title="Definition 7.2. ‣ 7.1.2. Convergence ‣ 7.1. Unobstructedness, local finiteness, grading, and orientations ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.2</span></a> implies that <math id="S7.SS2.SSS2.p1.m7" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> is well-defined.</p>
</div>
<div id="S7.Thmthm16" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm16.2" class="ltx_text ltx_font_bold">Proposition 7.16</span></span><span id="S7.Thmthm16.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm16.p1" class="ltx_para">
<p id="S7.Thmthm16.p1.1" class="ltx_p"><span id="S7.Thmthm16.p1.1.1" class="ltx_text ltx_font_italic">If <math id="S7.Thmthm16.p1.m1" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> is unobstructed, then <math id="S7.Thmthm16.p1.m2" class="ltx_Math" alttext="d^{2}=0" display="inline" intent=":literal"><semantics><mrow><msup><mi>d</mi><mn>2</mn></msup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d^{2}=0</annotation></semantics></math>. Therefore, <math id="S7.Thmthm16.p1.m3" class="ltx_Math" alttext="(C_{*}({\mathbb{F}}),d)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝔽</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(C_{*}({\mathbb{F}}),d)</annotation></semantics></math> gives rise to a <math id="S7.Thmthm16.p1.m4" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>-graded chain complex of free abelian groups, called the </span><span id="S7.Thmthm16.p1.1.2" class="ltx_text ltx_font_bold">complex</span><span id="S7.Thmthm16.p1.1.3" class="ltx_text ltx_font_italic"> associated to <math id="S7.Thmthm16.p1.m5" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S7.SS2.SSS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S7.SS2.SSS2.p2" class="ltx_para ltx_noindent">
<p id="S7.SS2.SSS2.p2.1" class="ltx_p"><span id="S7.SS2.SSS2.p2.1.1" class="ltx_text">To show <math id="S7.SS2.SSS2.p2.m1" class="ltx_Math" alttext="d^{2}=0" display="inline" intent=":literal"><semantics><mrow><msup><mi>d</mi><mn>2</mn></msup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d^{2}=0</annotation></semantics></math>, consider pairs <math id="S7.SS2.SSS2.p2.m2" class="ltx_Math" alttext="p,q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p,q</annotation></semantics></math> with <math id="S7.SS2.SSS2.p2.m3" class="ltx_Math" alttext="{\rm deg}(p)-{\rm deg}(q)=2" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">{\rm deg}(p)-{\rm deg}(q)=2</annotation></semantics></math>. By Definition <a href="#S7.Thmthm12" title="Definition 7.12. ‣ 7.1.4. Orientations ‣ 7.1. Unobstructedness, local finiteness, grading, and orientations ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.12</span></a>, the coefficients of <math id="S7.SS2.SSS2.p2.m4" class="ltx_Math" alttext="d^{2}(p)" display="inline" intent=":literal"><semantics><mrow><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">d^{2}(p)</annotation></semantics></math> in <math id="S7.SS2.SSS2.p2.m5" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> is the oriented count of the union of products</span></p>
<table id="S7.Ex54" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex54.m1" class="ltx_Math" alttext="\bigcup_{p&lt;r&lt;q}M_{pr}^{\mathbb{F}}\times M_{rq}^{\mathbb{F}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">⋃</mo><mrow><mi>p</mi><mo>&lt;</mo><mi>r</mi><mo>&lt;</mo><mi>q</mi></mrow></munder><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mi>𝔽</mi></msubsup></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>M</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bigcup_{p&lt;r&lt;q}M_{pr}^{\mathbb{F}}\times M_{rq}^{\mathbb{F}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.SSS2.p2.2" class="ltx_p"><span id="S7.SS2.SSS2.p2.2.1" class="ltx_text">Consider the 1-dimensional component of the pseudomanifold <math id="S7.SS2.SSS2.p2.m6" class="ltx_Math" alttext="M_{pq}^{\mathbb{F}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><annotation encoding="application/x-tex">M_{pq}^{\mathbb{F}}</annotation></semantics></math>. The boundary points only appear on the true boundary strata of <math id="S7.SS2.SSS2.p2.m7" class="ltx_Math" alttext="M_{pq}^{\mathbb{F}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><annotation encoding="application/x-tex">M_{pq}^{\mathbb{F}}</annotation></semantics></math>. By the definition of unobstructedness (Definition <a href="#S7.Thmthm1" title="Definition 7.1. ‣ 7.1.1. Unobstructedness ‣ 7.1. Unobstructedness, local finiteness, grading, and orientations ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.1</span></a>), the true boundary strata are all the top strata of the products <math id="S7.SS2.SSS2.p2.m8" class="ltx_Math" alttext="M_{pr}\times M_{rq}" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>M</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">M_{pr}\times M_{rq}</annotation></semantics></math>. By the coherence of the orientation (see Definition <a href="#S7.Thmthm12" title="Definition 7.12. ‣ 7.1.4. Orientations ‣ 7.1. Unobstructedness, local finiteness, grading, and orientations ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.12</span></a>), these counts cancel. Hence <math id="S7.SS2.SSS2.p2.m9" class="ltx_Math" alttext="d^{2}=0" display="inline" intent=":literal"><semantics><mrow><msup><mi>d</mi><mn>2</mn></msup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d^{2}=0</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S7.SS2.SSS2.p3" class="ltx_para ltx_noindent">
<p id="S7.SS2.SSS2.p3.1" class="ltx_p">If <math id="S7.SS2.SSS2.p3.m1" class="ltx_Math" alttext="C({\mathbb{F}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C({\mathbb{F}}^{\prime})</annotation></semantics></math> and <math id="S7.SS2.SSS2.p3.m2" class="ltx_Math" alttext="C({\mathbb{F}}^{\prime\prime})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝔽</mi><mo>′′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C({\mathbb{F}}^{\prime\prime})</annotation></semantics></math> are complexes associated to flow categories <math id="S7.SS2.SSS2.p3.m3" class="ltx_Math" alttext="{\mathbb{F}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝔽</mi><mo>′</mo></msup><annotation encoding="application/x-tex">{\mathbb{F}}^{\prime}</annotation></semantics></math> and <math id="S7.SS2.SSS2.p3.m4" class="ltx_Math" alttext="{\mathbb{F}}^{\prime\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝔽</mi><mo>′′</mo></msup><annotation encoding="application/x-tex">{\mathbb{F}}^{\prime\prime}</annotation></semantics></math>, then the tensor product complex <math id="S7.SS2.SSS2.p3.m5" class="ltx_Math" alttext="C({\mathbb{F}}^{\prime})\underset{\mathbb{Z}}{\otimes}C({\mathbb{F}}^{\prime\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.222em" rspace="0em">​</mo><munder accentunder="true"><mo>⊗</mo><mo mathsize="0.700em">ℤ</mo></munder><mo lspace="0.222em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝔽</mi><mo>′′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C({\mathbb{F}}^{\prime})\underset{\mathbb{Z}}{\otimes}C({\mathbb{F}}^{\prime\prime})</annotation></semantics></math> is defined. The following can be checked readily.</p>
</div>
<div id="S7.Thmthm17" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm17.2" class="ltx_text ltx_font_bold">Lemma 7.17</span></span><span id="S7.Thmthm17.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm17.p1" class="ltx_para">
<p id="S7.Thmthm17.p1.1" class="ltx_p"><span id="S7.Thmthm17.p1.1.1" class="ltx_text ltx_font_italic">The tensor product differential extends to the completion <math id="S7.Thmthm17.p1.m1" class="ltx_Math" alttext="\displaystyle C({\mathbb{F}}^{\prime})\widehat{\underset{\mathbb{Z}}{\otimes}}C({\mathbb{F}}^{\prime\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.222em" rspace="0em">​</mo><munderover accent="true" accentunder="true"><mo>⊗</mo><mo mathsize="0.700em">ℤ</mo><mo>^</mo></munderover><mo lspace="0.222em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝔽</mi><mo>′′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle C({\mathbb{F}}^{\prime})\widehat{\underset{\mathbb{Z}}{\otimes}}C({\mathbb{F}}^{\prime\prime})</annotation></semantics></math>.</span></p>
</div>
</div>
</section>
<section id="S7.SS2.SSS3" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">7.2.3. </span>Chain maps and homotopies</h5>

<div id="S7.SS2.SSS3.p1" class="ltx_para ltx_noindent">
<p id="S7.SS2.SSS3.p1.1" class="ltx_p">Now consider an oriented, unobstructed, <math id="S7.SS2.SSS3.p1.m1" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>-graded Novikov multimodule <math id="S7.SS2.SSS3.p1.m2" class="ltx_Math" alttext="{\mathbb{X}}" display="inline" intent=":literal"><semantics><mi>𝕏</mi><annotation encoding="application/x-tex">{\mathbb{X}}</annotation></semantics></math> enriched in <math id="S7.SS2.SSS3.p1.m3" class="ltx_Math" alttext="\underline{\smash{{\bf\Psi}{\bf Man}}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mrow><mi>𝚿</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐌𝐚𝐧</mi></mrow><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{{\bf\Psi}{\bf Man}}}</annotation></semantics></math> over <math id="S7.SS2.SSS3.p1.m4" class="ltx_Math" alttext="({\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m};{\mathbb{F}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo>,</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m};{\mathbb{F}}^{\prime})</annotation></semantics></math>. Let</p>
<table id="S7.Ex55" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex55.m1" class="ltx_math_unparsed" alttext="m_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}\in{\mathbb{Z}}" display="block" intent=":literal"><semantics><mrow><mi>m</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">m_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}\in{\mathbb{Z}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.SSS3.p1.2" class="ltx_p">be the count of <math id="S7.SS2.SSS3.p1.m5" class="ltx_math_unparsed" alttext="M_{p_{1}\cdots p_{m};p^{\prime}}^{{\mathbb{X}}}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup></mrow><annotation encoding="application/x-tex">M_{p_{1}\cdots p_{m};p^{\prime}}^{{\mathbb{X}}}</annotation></semantics></math> when the dimension is zero and <math id="S7.SS2.SSS3.p1.m6" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> otherwise. Define (formally) a linear map</p>
<table id="S7.Ex56" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex56.m1" class="ltx_math_unparsed" alttext="\tilde{\Phi}^{\mathbb{X}}:C({\mathbb{F}}_{1}){\underset{{\mathbb{Z}}}{\otimes}}\cdots{\underset{{\mathbb{Z}}}{\otimes}}C({\mathbb{F}}_{m})\to C({\mathbb{F}}^{\prime})" display="block" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mi>𝕏</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mi>C</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><munder accentunder="true"><mo>⊗</mo><mo mathsize="0.700em">ℤ</mo></munder><mo lspace="0.055em" rspace="0.055em">⋯</mo><munder accentunder="true"><mo rspace="0.222em">⊗</mo><mo mathsize="0.700em">ℤ</mo></munder><mi>C</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><mi>C</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{\Phi}^{\mathbb{X}}:C({\mathbb{F}}_{1}){\underset{{\mathbb{Z}}}{\otimes}}\cdots{\underset{{\mathbb{Z}}}{\otimes}}C({\mathbb{F}}_{m})\to C({\mathbb{F}}^{\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.SSS3.p1.3" class="ltx_p">by linearly extending (over <math id="S7.SS2.SSS3.p1.m7" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>)</p>
<table id="S7.E3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E3.m1" class="ltx_math_unparsed" alttext="\tilde{\Phi}^{\mathbb{X}}(p_{1}\otimes\cdots\otimes p_{m}):=\sum_{p^{\prime}\in{\rm Ob}{\mathbb{F}}^{\prime}}m_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}p^{\prime}." display="block" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mi>𝕏</mi></msup><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mn>1</mn></msub><mo lspace="0.222em">⊗</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">⊗</mo><msub><mi>p</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">:=</mo><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>p</mi><mo>′</mo></msup><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔽</mi><mo>′</mo></msup></mrow></mrow></munder><msubsup><mi>m</mi><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow><mi>𝕏</mi></msubsup><msup><mi>p</mi><mo>′</mo></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tilde{\Phi}^{\mathbb{X}}(p_{1}\otimes\cdots\otimes p_{m}):=\sum_{p^{\prime}\in{\rm Ob}{\mathbb{F}}^{\prime}}m_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}p^{\prime}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7.3)</span></td></tr></tbody>
</table>
<p id="S7.SS2.SSS3.p1.4" class="ltx_p">The Novikov property (Definition <a href="#S7.Thmthm5" title="Definition 7.5. ‣ 7.1.2. Convergence ‣ 7.1. Unobstructedness, local finiteness, grading, and orientations ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.5</span></a>) implies that <math id="S7.SS2.SSS3.p1.m8" class="ltx_Math" alttext="\tilde{\Phi}^{\mathbb{X}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mi>𝕏</mi></msup><annotation encoding="application/x-tex">\tilde{\Phi}^{\mathbb{X}}</annotation></semantics></math> is well-defined and extends to the completion.</p>
</div>
<div id="S7.Thmthm18" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm18.2" class="ltx_text ltx_font_bold">Proposition 7.18</span></span><span id="S7.Thmthm18.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm18.p1" class="ltx_para">
<p id="S7.Thmthm18.p1.1" class="ltx_p"><math id="S7.Thmthm18.p1.m1" class="ltx_Math" alttext="\tilde{\Phi}^{\mathbb{X}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mi>𝕏</mi></msup><annotation encoding="application/x-tex">\tilde{\Phi}^{\mathbb{X}}</annotation></semantics></math><span id="S7.Thmthm18.p1.1.1" class="ltx_text ltx_font_italic"> extends to the completion <math id="S7.Thmthm18.p1.m2" class="ltx_math_unparsed" alttext="\displaystyle C({\mathbb{F}}_{1})\widehat{\underset{{\mathbb{Z}}}{\otimes}}\cdots\widehat{\underset{{\mathbb{Z}}}{\otimes}}C({\mathbb{F}}_{m})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><munderover accent="true" accentunder="true"><mo>⊗</mo><mo mathsize="0.700em">ℤ</mo><mo>^</mo></munderover><mo lspace="0.055em" rspace="0.055em">⋯</mo><munderover accent="true" accentunder="true"><mo rspace="0.222em">⊗</mo><mo mathsize="0.700em">ℤ</mo><mo>^</mo></munderover><mi>C</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle C({\mathbb{F}}_{1})\widehat{\underset{{\mathbb{Z}}}{\otimes}}\cdots\widehat{\underset{{\mathbb{Z}}}{\otimes}}C({\mathbb{F}}_{m})</annotation></semantics></math> and is a <math id="S7.Thmthm18.p1.m3" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>-linear chain map of degree <math id="S7.Thmthm18.p1.m4" class="ltx_Math" alttext="{\rm index}({\mathbb{X}})" display="inline" intent=":literal"><semantics><mrow><mi>index</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝕏</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\rm index}({\mathbb{X}})</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S7.SS2.SSS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S7.SS2.SSS3.p2" class="ltx_para ltx_noindent">
<p id="S7.SS2.SSS3.p2.1" class="ltx_p"><span id="S7.SS2.SSS3.p2.1.1" class="ltx_text">The grading follows from the definition (see (2) of Definition <a href="#S7.Thmthm10" title="Definition 7.10. ‣ 7.1.3. Grading ‣ 7.1. Unobstructedness, local finiteness, grading, and orientations ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.10</span></a>). To prove that <math id="S7.SS2.SSS3.p2.m1" class="ltx_Math" alttext="\tilde{\Phi}^{\mathbb{X}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mi>𝕏</mi></msup><annotation encoding="application/x-tex">\tilde{\Phi}^{\mathbb{X}}</annotation></semantics></math> is a chain map, one needs to look at the orientation. By definition, the differential of the tensor product is determined by</span></p>
<table id="S7.Ex57" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex57.m1" class="ltx_math_unparsed" alttext="d(p_{1}\otimes\cdots\otimes p_{m})=\sum_{i=1}^{m}(-1)^{\sum_{j&lt;i}|p_{j}|}p_{1}\otimes\cdots\otimes p_{i-1}\otimes d^{{\mathbb{F}}_{i}}(p_{i})\otimes p_{i+1}\otimes\cdots\otimes p_{m}." display="block" intent=":literal"><semantics><mrow><mi>d</mi><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mn>1</mn></msub><mo lspace="0.222em">⊗</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">⊗</mo><msub><mi>p</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">=</mo><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><msup><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mrow><mstyle displaystyle="false"><msub><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>j</mi><mo>&lt;</mo><mi>i</mi></mrow></msub></mstyle><mrow><mo stretchy="false">|</mo><msub><mi>p</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow></mrow></msup><msub><mi>p</mi><mn>1</mn></msub><mo lspace="0.222em">⊗</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">⊗</mo><msub><mi>p</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mi>d</mi><msub><mi>𝔽</mi><mi>i</mi></msub></msup><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>i</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊗</mo><msub><mi>p</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0.222em">⊗</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">⊗</mo><msub><mi>p</mi><mi>m</mi></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">d(p_{1}\otimes\cdots\otimes p_{m})=\sum_{i=1}^{m}(-1)^{\sum_{j&lt;i}|p_{j}|}p_{1}\otimes\cdots\otimes p_{i-1}\otimes d^{{\mathbb{F}}_{i}}(p_{i})\otimes p_{i+1}\otimes\cdots\otimes p_{m}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.SSS3.p2.2" class="ltx_p"><span id="S7.SS2.SSS3.p2.2.1" class="ltx_text">Look at one-dimensional components of the moduli space <math id="S7.SS2.SSS3.p2.m2" class="ltx_math_unparsed" alttext="M_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup></mrow><annotation encoding="application/x-tex">M_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}</annotation></semantics></math> (see Definition <a href="#S7.Thmthm13" title="Definition 7.13. ‣ 7.1.4. Orientations ‣ 7.1. Unobstructedness, local finiteness, grading, and orientations ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.13</span></a>), whose oriented boundary is</span></p>
<table id="S7.Ex58" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex58.m1" class="ltx_math_unparsed" alttext="\bigsqcup_{i=1}^{m}\Big((-1)^{(\sum_{j&lt;i}|p_{j}|)(|p_{i}|-|q_{i})|}M_{p_{i}q_{i}}^{{\mathbb{F}}_{i}}\times M_{p_{1}\cdots p_{i-1}q_{i}p_{i+1}\cdots p_{m};p^{\prime}}^{{\mathbb{X}}}\Big)\sqcup\Big((-1)^{{\rm dim}M_{p_{1}\cdots p_{m};q^{\prime}}^{\mathbb{X}}+1}M_{p_{1}\cdots p_{m};q^{\prime}}^{{\mathbb{X}}}\times M_{q^{\prime}p^{\prime}}^{{\mathbb{F}}^{\prime}}\Big)." display="block" intent=":literal"><semantics><mrow><munderover><mo movablelimits="false">⨆</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><mrow><mo lspace="0em" maxsize="1.600em" minsize="1.600em">(</mo><msup><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>&lt;</mo><mi>i</mi></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>p</mi><msub><mrow></mrow><mi>j</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo stretchy="false">)</mo><mo stretchy="false">(</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>p</mi><msub><mrow></mrow><mi>i</mi></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0em" rspace="0em">−</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>q</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo fence="false" stretchy="false">|</mo></mrow></msup><msubsup><mi>M</mi><mrow><msub><mi>p</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>i</mi></msub></mrow><msub><mi>𝔽</mi><mi>i</mi></msub></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>M</mi><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mi>q</mi><msub><mrow></mrow><mi>i</mi></msub><mi>p</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow><mi>𝕏</mi></msubsup><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo>⊔</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msup><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mrow><mi>dim</mi><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo>+</mo><mn>1</mn></mrow></msup><msubsup><mi>M</mi><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup></mrow><mi>𝕏</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>M</mi><mrow><msup><mi>q</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><msup><mi>𝔽</mi><mo>′</mo></msup></msubsup><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bigsqcup_{i=1}^{m}\Big((-1)^{(\sum_{j&lt;i}|p_{j}|)(|p_{i}|-|q_{i})|}M_{p_{i}q_{i}}^{{\mathbb{F}}_{i}}\times M_{p_{1}\cdots p_{i-1}q_{i}p_{i+1}\cdots p_{m};p^{\prime}}^{{\mathbb{X}}}\Big)\sqcup\Big((-1)^{{\rm dim}M_{p_{1}\cdots p_{m};q^{\prime}}^{\mathbb{X}}+1}M_{p_{1}\cdots p_{m};q^{\prime}}^{{\mathbb{X}}}\times M_{q^{\prime}p^{\prime}}^{{\mathbb{F}}^{\prime}}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.SSS3.p2.3" class="ltx_p"><span id="S7.SS2.SSS3.p2.3.1" class="ltx_text">Moreover, each component above is nonempty only if both factors are zero-dimensional. It follows that (also using (<a href="#S7.E3" title="In 7.2.3. Chain maps and homotopies ‣ 7.2. Algebraic structures without symmetry ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.3</span></a>))</span></p>
<table id="S7.SS2.SSS3.p2.4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.SS2.SSS3.p2.m3" class="ltx_Math" alttext="\sum_{q^{\prime}}\langle\tilde{\Phi}^{\mathbb{X}}(p_{1}\otimes\cdots\otimes p_{m}),q^{\prime}\rangle\langle d^{{\mathbb{F}}^{\prime}}(q^{\prime}),p^{\prime}\rangle\\
=\sum_{i=1}^{m}(-1)^{\sum_{j&lt;i}|p_{j}|}\sum_{q_{i}\in{\rm Ob}{\mathbb{F}}_{i}}\langle d^{{\mathbb{F}}_{i}}(p_{i}),q_{i}\rangle\langle\tilde{\Phi}^{{\mathbb{X}}}(p_{1}\otimes\cdots\otimes p_{i-1}\otimes q_{i}\otimes p_{i+1}\otimes\cdots\otimes p_{m}),p^{\prime}\rangle" display="block" intent=":literal"><semantics><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mo movablelimits="false" rspace="0em">∑</mo><msub><mrow></mrow><msup><mi>q</mi><mo>′</mo></msup></msub><mo stretchy="false">⟨</mo><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><msup><mrow></mrow><mi>𝕏</mi></msup><mo stretchy="false">(</mo><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0.222em">⊗</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">⊗</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo stretchy="false">)</mo><mo>,</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">⟩</mo><mo stretchy="false">⟨</mo><mi>d</mi><msup><mrow></mrow><msup><mi>𝔽</mi><mo>′</mo></msup></msup><mo stretchy="false">(</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo><mo>,</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">⟩</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mo rspace="0.111em">=</mo><mo movablelimits="false" rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>m</mi></msup><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mn>1</mn><mo stretchy="false">)</mo><msup><mrow></mrow><mrow><mstyle displaystyle="false"><msub><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>j</mi><mo>&lt;</mo><mi>i</mi></mrow></msub></mstyle><mrow><mo stretchy="false">|</mo><msub><mi>p</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow></mrow></msup><mo movablelimits="false" rspace="0em">∑</mo><msub><mrow></mrow><mrow><msub><mi>q</mi><mi>i</mi></msub><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔽</mi><mi>i</mi></msub></mrow></mrow></msub><mo stretchy="false">⟨</mo><mi>d</mi><msup><mrow></mrow><msub><mi>𝔽</mi><mi>i</mi></msub></msup><mo stretchy="false">(</mo><mi>p</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo>,</mo><mi>q</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">⟩</mo><mo stretchy="false">⟨</mo><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><msup><mrow></mrow><mi>𝕏</mi></msup><mo stretchy="false">(</mo><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0.222em">⊗</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">⊗</mo><mi>p</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>q</mi><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>p</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0.222em">⊗</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">⊗</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo stretchy="false">)</mo><mo>,</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">⟩</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\sum_{q^{\prime}}\langle\tilde{\Phi}^{\mathbb{X}}(p_{1}\otimes\cdots\otimes p_{m}),q^{\prime}\rangle\langle d^{{\mathbb{F}}^{\prime}}(q^{\prime}),p^{\prime}\rangle\\
=\sum_{i=1}^{m}(-1)^{\sum_{j&lt;i}|p_{j}|}\sum_{q_{i}\in{\rm Ob}{\mathbb{F}}_{i}}\langle d^{{\mathbb{F}}_{i}}(p_{i}),q_{i}\rangle\langle\tilde{\Phi}^{{\mathbb{X}}}(p_{1}\otimes\cdots\otimes p_{i-1}\otimes q_{i}\otimes p_{i+1}\otimes\cdots\otimes p_{m}),p^{\prime}\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.SSS3.p2.5" class="ltx_p"><span id="S7.SS2.SSS3.p2.5.1" class="ltx_text">which means exactly that <math id="S7.SS2.SSS3.p2.m4" class="ltx_Math" alttext="\tilde{\Phi}^{{\mathbb{X}}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mi>𝕏</mi></msup><annotation encoding="application/x-tex">\tilde{\Phi}^{{\mathbb{X}}}</annotation></semantics></math> is a chain map.
∎</span></p>
</div>
</div>
<div id="S7.SS2.SSS3.p3" class="ltx_para ltx_noindent">
<p id="S7.SS2.SSS3.p3.1" class="ltx_p">Now we consider the situation of multimodule concatenations (see Subsection <a href="#S6.SS5" title="6.5. Multimodule concatenations ‣ 6. Flow Categories, Multimodules, and Homotopies ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.5</span></a>). Let</p>
<table id="S7.Ex59" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex59.m1" class="ltx_Math" alttext="{\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m},{\mathbb{G}}_{1},\ldots,{\mathbb{G}}_{n},{\mathbb{G}}^{\prime}" display="block" intent=":literal"><semantics><mrow><msub><mi>𝔽</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo>,</mo><msub><mi>𝔾</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔾</mi><mi>n</mi></msub><mo>,</mo><msup><mi>𝔾</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">{\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m},{\mathbb{G}}_{1},\ldots,{\mathbb{G}}_{n},{\mathbb{G}}^{\prime}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.SSS3.p3.2" class="ltx_p">be flow categories enriched in <math id="S7.SS2.SSS3.p3.m1" class="ltx_Math" alttext="\underline{\smash{{\bf\Psi}{\bf Man}}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mrow><mi>𝚿</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐌𝐚𝐧</mi></mrow><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{{\bf\Psi}{\bf Man}}}</annotation></semantics></math> which are oriented, graded, and Novikov. Let <math id="S7.SS2.SSS3.p3.m2" class="ltx_Math" alttext="{\mathbb{X}}" display="inline" intent=":literal"><semantics><mi>𝕏</mi><annotation encoding="application/x-tex">{\mathbb{X}}</annotation></semantics></math> be a multimodule over <math id="S7.SS2.SSS3.p3.m3" class="ltx_Math" alttext="({\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m};{\mathbb{G}}_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo>,</mo><msub><mi>𝔾</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m};{\mathbb{G}}_{i})</annotation></semantics></math> which is oriented, graded, and Novikov. Let <math id="S7.SS2.SSS3.p3.m4" class="ltx_Math" alttext="{\mathbb{Y}}" display="inline" intent=":literal"><semantics><mi>𝕐</mi><annotation encoding="application/x-tex">{\mathbb{Y}}</annotation></semantics></math> be a multimodule over <math id="S7.SS2.SSS3.p3.m5" class="ltx_Math" alttext="({\mathbb{G}}_{1},\ldots,{\mathbb{G}}_{n};{\mathbb{G}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔾</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔾</mi><mi>n</mi></msub><mo>,</mo><msup><mi>𝔾</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{G}}_{1},\ldots,{\mathbb{G}}_{n};{\mathbb{G}}^{\prime})</annotation></semantics></math> which is oriented, graded, and Novikov. Then one can consider the concatenation <math id="S7.SS2.SSS3.p3.m6" class="ltx_Math" alttext="{\mathbb{X}}\circ_{i}{\mathbb{Y}}" display="inline" intent=":literal"><semantics><mrow><mi>𝕏</mi><msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>i</mi></msub><mi>𝕐</mi></mrow><annotation encoding="application/x-tex">{\mathbb{X}}\circ_{i}{\mathbb{Y}}</annotation></semantics></math> which is a multimodule over <math id="S7.SS2.SSS3.p3.m7" class="ltx_Math" alttext="({\mathbb{G}}_{1},\ldots,{\mathbb{G}}_{i-1},{\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m},{\mathbb{G}}_{i+1},\ldots,{\mathbb{G}}_{n};{\mathbb{G}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔾</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔾</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo>,</mo><msub><mi>𝔾</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔾</mi><mi>n</mi></msub><mo>,</mo><msup><mi>𝔾</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{G}}_{1},\ldots,{\mathbb{G}}_{i-1},{\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m},{\mathbb{G}}_{i+1},\ldots,{\mathbb{G}}_{n};{\mathbb{G}}^{\prime})</annotation></semantics></math>. Lemma <a href="#S7.Thmthm7" title="Lemma 7.7. ‣ 7.1.2. Convergence ‣ 7.1. Unobstructedness, local finiteness, grading, and orientations ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.7</span></a> implies that the concatenation is Novikov. Lemma <a href="#S7.Thmthm14" title="Lemma 7.14. ‣ 7.1.4. Orientations ‣ 7.1. Unobstructedness, local finiteness, grading, and orientations ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.14</span></a> says that the concatenation <math id="S7.SS2.SSS3.p3.m8" class="ltx_Math" alttext="{\mathbb{X}}\circ_{i}{\mathbb{Y}}" display="inline" intent=":literal"><semantics><mrow><mi>𝕏</mi><msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>i</mi></msub><mi>𝕐</mi></mrow><annotation encoding="application/x-tex">{\mathbb{X}}\circ_{i}{\mathbb{Y}}</annotation></semantics></math> is coherently oriented. Hence one obtains a chain map</p>
<table id="S7.Ex60" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex60.m1" class="ltx_math_unparsed" alttext="\tilde{\Phi}^{{\mathbb{X}}\circ_{i}{\mathbb{Y}}}:C({\mathbb{G}}_{1})\widehat{\underset{\mathbb{Z}}{\otimes}}\cdots\widehat{\underset{\mathbb{Z}}{\otimes}}C({\mathbb{G}}_{i-1})\widehat{\underset{\mathbb{Z}}{\otimes}}C({\mathbb{F}}_{1})\widehat{\underset{\mathbb{Z}}{\otimes}}\cdots\widehat{\underset{\mathbb{Z}}{\otimes}}C({\mathbb{F}}_{m})\widehat{\underset{\mathbb{Z}}{\otimes}}C({\mathbb{G}}_{i+1})\widehat{\underset{\mathbb{Z}}{\otimes}}\cdots\widehat{\underset{\mathbb{Z}}{\otimes}}C({\mathbb{G}}_{n})\to C({\mathbb{G}}^{\prime})." display="block" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mrow><mi>𝕏</mi><msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>i</mi></msub><mi>𝕐</mi></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mi>C</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝔾</mi><mn>1</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><munderover accent="true" accentunder="true"><mo>⊗</mo><mo mathsize="0.700em">ℤ</mo><mo>^</mo></munderover><mo lspace="0.055em" rspace="0.055em">⋯</mo><munderover accent="true" accentunder="true"><mo rspace="0.222em">⊗</mo><mo mathsize="0.700em">ℤ</mo><mo>^</mo></munderover><mi>C</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝔾</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><munderover accent="true" accentunder="true"><mo rspace="0.222em">⊗</mo><mo mathsize="0.700em">ℤ</mo><mo>^</mo></munderover><mi>C</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><munderover accent="true" accentunder="true"><mo>⊗</mo><mo mathsize="0.700em">ℤ</mo><mo>^</mo></munderover><mo lspace="0.055em" rspace="0.055em">⋯</mo><munderover accent="true" accentunder="true"><mo rspace="0.222em">⊗</mo><mo mathsize="0.700em">ℤ</mo><mo>^</mo></munderover><mi>C</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><munderover accent="true" accentunder="true"><mo rspace="0.222em">⊗</mo><mo mathsize="0.700em">ℤ</mo><mo>^</mo></munderover><mi>C</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝔾</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><munderover accent="true" accentunder="true"><mo>⊗</mo><mo mathsize="0.700em">ℤ</mo><mo>^</mo></munderover><mo lspace="0.055em" rspace="0.055em">⋯</mo><munderover accent="true" accentunder="true"><mo rspace="0.222em">⊗</mo><mo mathsize="0.700em">ℤ</mo><mo>^</mo></munderover><mi>C</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝔾</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><mi>C</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝔾</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tilde{\Phi}^{{\mathbb{X}}\circ_{i}{\mathbb{Y}}}:C({\mathbb{G}}_{1})\widehat{\underset{\mathbb{Z}}{\otimes}}\cdots\widehat{\underset{\mathbb{Z}}{\otimes}}C({\mathbb{G}}_{i-1})\widehat{\underset{\mathbb{Z}}{\otimes}}C({\mathbb{F}}_{1})\widehat{\underset{\mathbb{Z}}{\otimes}}\cdots\widehat{\underset{\mathbb{Z}}{\otimes}}C({\mathbb{F}}_{m})\widehat{\underset{\mathbb{Z}}{\otimes}}C({\mathbb{G}}_{i+1})\widehat{\underset{\mathbb{Z}}{\otimes}}\cdots\widehat{\underset{\mathbb{Z}}{\otimes}}C({\mathbb{G}}_{n})\to C({\mathbb{G}}^{\prime}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S7.Thmthm19" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm19.2" class="ltx_text ltx_font_bold">Lemma 7.19</span></span><span id="S7.Thmthm19.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm19.p1" class="ltx_para ltx_noindent">
<p id="S7.Thmthm19.p1.1" class="ltx_p"><span id="S7.Thmthm19.p1.1.1" class="ltx_text ltx_font_italic">There holds</span></p>
<table id="S7.Ex61" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex61.m1" class="ltx_math_unparsed" alttext="\tilde{\Phi}^{{\mathbb{X}}\circ_{i}{\mathbb{Y}}}(y_{1},\cdots,y_{i-1},x_{1},\cdots x_{m},y_{i+1},\cdots,y_{n})=\tilde{\Phi}^{\mathbb{Y}}(y_{1},\cdots,y_{i-1},\tilde{\Phi}^{\mathbb{X}}(x_{1},\cdots,x_{m}),y_{i+1},\cdots,y_{n})." display="block" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mrow><mi>𝕏</mi><msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>i</mi></msub><mi>𝕐</mi></mrow></msup><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>y</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>x</mi><mi>m</mi></msub><mo>,</mo><msub><mi>y</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>y</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><msup><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mi>𝕐</mi></msup><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>y</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msup><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><mi>𝕏</mi></msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>x</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>y</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>y</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tilde{\Phi}^{{\mathbb{X}}\circ_{i}{\mathbb{Y}}}(y_{1},\cdots,y_{i-1},x_{1},\cdots x_{m},y_{i+1},\cdots,y_{n})=\tilde{\Phi}^{\mathbb{Y}}(y_{1},\cdots,y_{i-1},\tilde{\Phi}^{\mathbb{X}}(x_{1},\cdots,x_{m}),y_{i+1},\cdots,y_{n}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S7.SS2.SSS3.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S7.SS2.SSS3.p4" class="ltx_para ltx_noindent">
<p id="S7.SS2.SSS3.p4.1" class="ltx_p"><span id="S7.SS2.SSS3.p4.1.1" class="ltx_text">One only needs to verify this identity for <math id="S7.SS2.SSS3.p4.m1" class="ltx_Math" alttext="x_{\alpha}=p_{\alpha}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>α</mi></msub><mo>=</mo><msub><mi>p</mi><mi>α</mi></msub></mrow><annotation encoding="application/x-tex">x_{\alpha}=p_{\alpha}</annotation></semantics></math> and <math id="S7.SS2.SSS3.p4.m2" class="ltx_Math" alttext="y_{\beta}=r_{\beta}" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mi>β</mi></msub><mo>=</mo><msub><mi>r</mi><mi>β</mi></msub></mrow><annotation encoding="application/x-tex">y_{\beta}=r_{\beta}</annotation></semantics></math> for generators of the involved chain complexes. Fix <math id="S7.SS2.SSS3.p4.m3" class="ltx_Math" alttext="r^{\prime}\in{\rm Ob}{\mathbb{G}}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>r</mi><mo>′</mo></msup><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔾</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">r^{\prime}\in{\rm Ob}{\mathbb{G}}^{\prime}</annotation></semantics></math>. The <math id="S7.SS2.SSS3.p4.m4" class="ltx_Math" alttext="r^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>r</mi><mo>′</mo></msup><annotation encoding="application/x-tex">r^{\prime}</annotation></semantics></math>-coefficient of the left is the signed count of the disjoint union</span></p>
<table id="S7.Ex62" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex62.m1" class="ltx_math_unparsed" alttext="M_{p_{1}\cdots p_{m};r_{i}}^{\mathbb{X}}\times M_{r_{1}\cdots r_{n};r^{\prime}}^{\mathbb{Y}}." display="block" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>r</mi><msub><mrow></mrow><mi>i</mi></msub></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi><msub><mrow></mrow><mrow><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>n</mi></msub><mo>;</mo><mi>r</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕐</mi></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">M_{p_{1}\cdots p_{m};r_{i}}^{\mathbb{X}}\times M_{r_{1}\cdots r_{n};r^{\prime}}^{\mathbb{Y}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.SSS3.p4.2" class="ltx_p"><span id="S7.SS2.SSS3.p4.2.1" class="ltx_text">By our orientation conventions (note that the moduli spaces are zero-dimensional), it is equal to</span></p>
<table id="S7.Ex63" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex63.m1" class="ltx_math_unparsed" alttext="n_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}n_{p^{\prime}r_{1}\cdots r_{n};r^{\prime}}^{\mathbb{Y}}." display="block" intent=":literal"><semantics><mrow><mi>n</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mi>n</mi><msub><mrow></mrow><mrow><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>n</mi></msub><mo>;</mo><mi>r</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕐</mi></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">n_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}n_{p^{\prime}r_{1}\cdots r_{n};r^{\prime}}^{\mathbb{Y}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.SSS3.p4.3" class="ltx_p"><span id="S7.SS2.SSS3.p4.3.1" class="ltx_text">As only zero dimensional moduli spaces contribute, the sign above is positive; therefore, the induced count produces the right hand side.
∎</span></p>
</div>
</div>
<div id="S7.SS2.SSS3.p5" class="ltx_para ltx_noindent">
<p id="S7.SS2.SSS3.p5.1" class="ltx_p">Lastly, suppose <math id="S7.SS2.SSS3.p5.m1" class="ltx_Math" alttext="{\mathbb{X}}_{0},{\mathbb{X}}_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝕏</mi><mn>0</mn></msub><mo>,</mo><msub><mi>𝕏</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">{\mathbb{X}}_{0},{\mathbb{X}}_{1}</annotation></semantics></math> be two, unobstructed, oriented, <math id="S7.SS2.SSS3.p5.m2" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>-graded Novikov multimodules over <math id="S7.SS2.SSS3.p5.m3" class="ltx_Math" alttext="({\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m};{\mathbb{F}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo>,</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m};{\mathbb{F}}^{\prime})</annotation></semantics></math> enriched in <math id="S7.SS2.SSS3.p5.m4" class="ltx_Math" alttext="\underline{\smash{{\bf\Psi}{\bf Man}}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mrow><mi>𝚿</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐌𝐚𝐧</mi></mrow><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{{\bf\Psi}{\bf Man}}}</annotation></semantics></math> of the same degree <math id="S7.SS2.SSS3.p5.m5" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>, and <math id="S7.SS2.SSS3.p5.m6" class="ltx_Math" alttext="{\mathbb{H}}" display="inline" intent=":literal"><semantics><mi>ℍ</mi><annotation encoding="application/x-tex">{\mathbb{H}}</annotation></semantics></math> is an oriented, unobstructed, Novikov homotopy from <math id="S7.SS2.SSS3.p5.m7" class="ltx_Math" alttext="{\mathbb{X}}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝕏</mi><mn>0</mn></msub><annotation encoding="application/x-tex">{\mathbb{X}}_{0}</annotation></semantics></math> to <math id="S7.SS2.SSS3.p5.m8" class="ltx_Math" alttext="{\mathbb{X}}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝕏</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\mathbb{X}}_{1}</annotation></semantics></math>. For each tuple <math id="S7.SS2.SSS3.p5.m9" class="ltx_math_unparsed" alttext="(p_{1}\cdots p_{m};p^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>p</mi><mi>m</mi></msub><mo>;</mo><msup><mi>p</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(p_{1}\cdots p_{m};p^{\prime})</annotation></semantics></math>, the orientation on <math id="S7.SS2.SSS3.p5.m10" class="ltx_math_unparsed" alttext="M_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{H}}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>ℍ</mi></msup></mrow><annotation encoding="application/x-tex">M_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{H}}</annotation></semantics></math> induces an integral count</p>
<table id="S7.Ex64" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex64.m1" class="ltx_math_unparsed" alttext="n_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{H}}\in{\mathbb{Z}}." display="block" intent=":literal"><semantics><mrow><mi>n</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>ℍ</mi></msup><mo>∈</mo><mi>ℤ</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">n_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{H}}\in{\mathbb{Z}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.SSS3.p5.2" class="ltx_p">Define a linear map</p>
<table id="S7.Ex65" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex65.m1" class="ltx_math_unparsed" alttext="\tilde{\Psi}^{\mathbb{H}}:C_{*}({\mathbb{F}}_{1})\underset{{\mathbb{Z}}}{\otimes}\cdots\underset{{\mathbb{Z}}}{\otimes}C_{*}({\mathbb{F}}_{m})\to C_{*}({\mathbb{F}}^{\prime})" display="block" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mi>ℍ</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi>C</mi><mo>∗</mo></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><munder accentunder="true"><mo>⊗</mo><mo mathsize="0.700em">ℤ</mo></munder><mo lspace="0.055em" rspace="0.055em">⋯</mo><munder accentunder="true"><mo rspace="0.222em">⊗</mo><mo mathsize="0.700em">ℤ</mo></munder><msub><mi>C</mi><mo>∗</mo></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><msub><mi>C</mi><mo>∗</mo></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{\Psi}^{\mathbb{H}}:C_{*}({\mathbb{F}}_{1})\underset{{\mathbb{Z}}}{\otimes}\cdots\underset{{\mathbb{Z}}}{\otimes}C_{*}({\mathbb{F}}_{m})\to C_{*}({\mathbb{F}}^{\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.SSS3.p5.3" class="ltx_p">by <math id="S7.SS2.SSS3.p5.m11" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>-linearly extending</p>
<table id="S7.Ex66" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex66.m1" class="ltx_math_unparsed" alttext="p_{1}\otimes\cdots\otimes p_{m}\mapsto\sum_{p^{\prime}}n_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{H}}p^{\prime}." display="block" intent=":literal"><semantics><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0.222em">⊗</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">⊗</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo rspace="0.111em" stretchy="false">↦</mo><mo movablelimits="false">∑</mo><msub><mrow></mrow><msup><mi>p</mi><mo>′</mo></msup></msub><mi>n</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>ℍ</mi></msup><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">p_{1}\otimes\cdots\otimes p_{m}\mapsto\sum_{p^{\prime}}n_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{H}}p^{\prime}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.SSS3.p5.4" class="ltx_p">Using the conditions stated in Definition <a href="#S7.Thmthm15" title="Definition 7.15. ‣ 7.1.4. Orientations ‣ 7.1. Unobstructedness, local finiteness, grading, and orientations ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.15</span></a>, the following statement is immediate.</p>
</div>
<div id="S7.Thmthm20" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm20.2" class="ltx_text ltx_font_bold">Lemma 7.20</span></span><span id="S7.Thmthm20.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm20.p1" class="ltx_para">
<p id="S7.Thmthm20.p1.1" class="ltx_p"><math id="S7.Thmthm20.p1.m1" class="ltx_Math" alttext="\tilde{\Psi}^{\mathbb{H}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover><mi>ℍ</mi></msup><annotation encoding="application/x-tex">\tilde{\Psi}^{\mathbb{H}}</annotation></semantics></math><span id="S7.Thmthm20.p1.1.1" class="ltx_text ltx_font_italic"> extends to <math id="S7.Thmthm20.p1.m2" class="ltx_math_unparsed" alttext="C({\mathbb{F}}_{1})\widehat{\underset{{\mathbb{Z}}}{\otimes}}\cdots\widehat{\underset{{\mathbb{Z}}}{\otimes}}C({\mathbb{F}}_{m})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><munderover accent="true" accentunder="true"><mo>⊗</mo><mo mathsize="0.700em">ℤ</mo><mo>^</mo></munderover><mo lspace="0.055em" rspace="0.055em">⋯</mo><munderover accent="true" accentunder="true"><mo rspace="0.222em">⊗</mo><mo mathsize="0.700em">ℤ</mo><mo>^</mo></munderover><mi>C</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C({\mathbb{F}}_{1})\widehat{\underset{{\mathbb{Z}}}{\otimes}}\cdots\widehat{\underset{{\mathbb{Z}}}{\otimes}}C({\mathbb{F}}_{m})</annotation></semantics></math> and is a chain homotopy from <math id="S7.Thmthm20.p1.m3" class="ltx_Math" alttext="\tilde{\Phi}^{{\mathbb{X}}_{0}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><msub><mi>𝕏</mi><mn>0</mn></msub></msup><annotation encoding="application/x-tex">\tilde{\Phi}^{{\mathbb{X}}_{0}}</annotation></semantics></math> to <math id="S7.Thmthm20.p1.m4" class="ltx_Math" alttext="\tilde{\Phi}^{{\mathbb{X}}_{1}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi mathvariant="normal">Φ</mi><mo>~</mo></mover><msub><mi>𝕏</mi><mn>1</mn></msub></msup><annotation encoding="application/x-tex">\tilde{\Phi}^{{\mathbb{X}}_{1}}</annotation></semantics></math>.</span></p>
</div>
</div>
</section>
</section>
<section id="S7.SS3" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">7.3. </span>Symmetries on flow categories, multimodules, and homotopies</h4>

<div id="S7.SS3.p1" class="ltx_para ltx_noindent">
<p id="S7.SS3.p1.1" class="ltx_p">In the geometric situations considered in this paper, there are three types of symmetries on flow categories, multimodules, and homotopies. The first is the typical kind of Novikov symmetry, which is basically the symmetry related to changing cappings of contractible periodic orbits. The second and the third only appear in the equivariant case. The second type is the symmetry on the Borel model <math id="S7.SS3.p1.m1" class="ltx_Math" alttext="S^{\infty}\cong E{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>S</mi><mi mathvariant="normal">∞</mi></msup><mo>≅</mo><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>ℤ</mi><mi>𝗉</mi></msub></mrow></mrow><annotation encoding="application/x-tex">S^{\infty}\cong E{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>, given by the monoid <math id="S7.SS3.p1.m2" class="ltx_Math" alttext="{\mathbb{Z}}_{\geq 0}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">{\mathbb{Z}}_{\geq 0}</annotation></semantics></math>, which shifts the coordinates, rather than the group <math id="S7.SS3.p1.m3" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>. The third is symmetry by a finite group <math id="S7.SS3.p1.m4" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>.</p>
</div>
<section id="S7.SS3.SSS1" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">7.3.1. </span>Twisted Novikov groups</h5>

<div id="S7.Thmthm21" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm21.2" class="ltx_text ltx_font_bold">Definition 7.21</span></span><span id="S7.Thmthm21.3" class="ltx_text ltx_font_bold"> </span>(Novikov groups)<span id="S7.Thmthm21.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm21.p1" class="ltx_para">
<ol id="S7.I7" class="ltx_enumerate">
<li id="S7.I7.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S7.I7.i1.p1" class="ltx_para ltx_noindent">
<p id="S7.I7.i1.p1.1" class="ltx_p">A <span id="S7.I7.i1.p1.1.1" class="ltx_text ltx_font_bold">Novikov group</span> consists of a free abelian group <math id="S7.I7.i1.p1.m1" class="ltx_Math" alttext="\mathbb{\Pi}" display="inline" intent=":literal"><semantics><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><annotation encoding="application/x-tex">\mathbb{\Pi}</annotation></semantics></math> together with morphisms</p>
<table id="S7.EGx22" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S7.Ex67"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex67.m1" class="ltx_Math" alttext="\displaystyle\ \lambda=(\lambda_{1},\ldots,\lambda_{k}):\mathbb{\Pi}\to{\mathbb{R}}^{k},\ " display="inline" intent=":literal"><semantics><mrow><mrow><mi>λ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mi>k</mi></msub><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mrow><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mi>k</mi></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ \lambda=(\lambda_{1},\ldots,\lambda_{k}):\mathbb{\Pi}\to{\mathbb{R}}^{k},\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.Ex67.m2" class="ltx_Math" alttext="\displaystyle\ \mu:\mathbb{\Pi}\to 2{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mo stretchy="false">→</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ℤ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ \mu:\mathbb{\Pi}\to 2{\mathbb{Z}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.I7.i1.p1.2" class="ltx_p">A <span id="S7.I7.i1.p1.2.1" class="ltx_text ltx_font_bold">morphism</span> of Novikov groups from <math id="S7.I7.i1.p1.m2" class="ltx_Math" alttext="(\mathbb{\Pi},\lambda,\mu)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mo>,</mo><mi>λ</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbb{\Pi},\lambda,\mu)</annotation></semantics></math> to <math id="S7.I7.i1.p1.m3" class="ltx_Math" alttext="(\mathbb{\Pi}^{\prime},\lambda^{\prime},\mu^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mo>′</mo></msup><mo>,</mo><msup><mi>λ</mi><mo>′</mo></msup><mo>,</mo><msup><mi>μ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbb{\Pi}^{\prime},\lambda^{\prime},\mu^{\prime})</annotation></semantics></math> consists of a group homomorphism <math id="S7.I7.i1.p1.m4" class="ltx_Math" alttext="\rho:\mathbb{\Pi}\to\mathbb{\Pi}^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mo stretchy="false">→</mo><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\rho:\mathbb{\Pi}\to\mathbb{\Pi}^{\prime}</annotation></semantics></math> and a linear map <math id="S7.I7.i1.p1.m5" class="ltx_Math" alttext="\sigma:{\mathbb{R}}^{k}\to{\mathbb{R}}^{k^{\prime}}" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mi>k</mi></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><msup><mi>k</mi><mo>′</mo></msup></msup></mrow></mrow><annotation encoding="application/x-tex">\sigma:{\mathbb{R}}^{k}\to{\mathbb{R}}^{k^{\prime}}</annotation></semantics></math> such that the following diagrams commute.</p>
<table id="S7.EGx23" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

