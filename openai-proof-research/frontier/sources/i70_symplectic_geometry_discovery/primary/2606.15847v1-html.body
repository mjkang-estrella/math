al^{-}\widetilde{V}_{rq}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mrow><msub><mover accent="true"><mi>I</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mrow><mrow><msup><mo>∂</mo><mo>+</mo></msup><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></mrow><mo lspace="0.222em" rspace="0.055em">×</mo><mrow><msup><mo>∂</mo><mo>−</mo></msup><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mrow></msub><annotation encoding="application/x-tex">\textstyle{\widetilde{I}_{prq}|_{\partial^{+}\widetilde{V}_{pr}\times\partial^{-}\widetilde{V}_{rq}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 190.9700475227986 -0.27673578005007266 L 190.9700475227986 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(224.18,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 190.9700475227986 -0.27673578005007266 L 224.17882674129999 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 224.17882674129999 -0.27673578005007266 L 224.17882674129999 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(224.18,0) translate(4.15,0) translate(0,-3.54)"><foreignObject style="--ltx-fo-width:7.37em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.63em;font-size:10pt;" height="19.03" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="102"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S16.Ex65.m1.pic1.m3" class="ltx_Math" alttext="\textstyle{\widetilde{I}_{prq}|_{\partial^{+}\widetilde{V}_{pr}\times\partial^{+}\widetilde{V}_{rq}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mrow><msub><mover accent="true"><mi>I</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mrow><mrow><msup><mo>∂</mo><mo>+</mo></msup><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></mrow><mo lspace="0.222em" rspace="0.055em">×</mo><mrow><msup><mo>∂</mo><mo>+</mo></msup><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mrow></msub><annotation encoding="application/x-tex">\textstyle{\widetilde{I}_{prq}|_{\partial^{+}\widetilde{V}_{pr}\times\partial^{+}\widetilde{V}_{rq}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 279.0516238003429 -16.33532861794313 L 279.60509536044304 -16.33532861794313" fill="none" stroke="#000000"></path><g transform="translate(279.33,0) translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 279.0516238003429 -33.208800332088 L 279.60509536044304 -16.33532861794313" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 279.0516238003429 -33.208800332088 L 279.60509536044304 -33.208800332088" fill="none" stroke="#000000"></path><g transform="translate(-32.7,0) translate(0,-44.2) translate(4.15,0) translate(0,-3.54)"><foreignObject style="--ltx-fo-width:4.13em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.63em;font-size:10pt;" height="19.03" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="57.09"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S16.Ex65.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{\widetilde{I}_{pq}|_{\partial^{-}\widetilde{V}_{prq}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mrow><msub><mover accent="true"><mi>I</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mrow><msup><mo>∂</mo><mo>−</mo></msup><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></msub><annotation encoding="application/x-tex">\textstyle{\widetilde{I}_{pq}|_{\partial^{-}\widetilde{V}_{prq}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 32.69814712568753 -44.4782827674757 L 32.69814712568753 -43.924811207375555" fill="none" stroke="#000000"></path><g transform="translate(244.71,0) translate(0,-44.2)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 32.69814712568753 -44.4782827674757 L 244.70839045825335 -43.924811207375555" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 244.70839045825335 -44.4782827674757 L 244.70839045825335 -43.924811207375555" fill="none" stroke="#000000"></path><g transform="translate(244.71,0) translate(0,-44.2) translate(4.15,0) translate(0,-3.54)"><foreignObject style="--ltx-fo-width:4.4em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.63em;font-size:10pt;" height="19.03" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="60.94"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S16.Ex65.m1.pic1.m6" class="ltx_Math" alttext="\textstyle{\widetilde{I}_{pq}|_{\partial^{+}\widetilde{V}_{prq}}}" display="inline" intent=":literal"><semantics><msub><mrow><msub><mover accent="true"><mi>I</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mrow><msup><mo>∂</mo><mo>+</mo></msup><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></msub><annotation encoding="application/x-tex">\textstyle{\widetilde{I}_{pq}|_{\partial^{+}\widetilde{V}_{prq}}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S16.I5.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S16.I5.i2.p1" class="ltx_para ltx_noindent">
<p id="S16.I5.i2.p1.1" class="ltx_p"><span id="S16.I5.i2.p1.1.1" class="ltx_text ltx_font_italic">The isomorphisms are collared and respect the rigidification.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S16.SS3.SSS2.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S16.SS3.SSS2.p8" class="ltx_para">
<p id="S16.SS3.SSS2.p8.1" class="ltx_p"><span id="S16.SS3.SSS2.p8.1.1" class="ltx_text">Induction and homotopy triviality of the interpolating interval <math id="S16.SS3.SSS2.p8.m1" class="ltx_Math" alttext="[0,1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,1]</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S16.SS3.SSS2.p9" class="ltx_para ltx_noindent">
<p id="S16.SS3.SSS2.p9.1" class="ltx_p">Now as <math id="S16.SS3.SSS2.p9.m1" class="ltx_Math" alttext="I_{pq}^{\mathbb{C}}" display="inline" intent=":literal"><semantics><msubsup><mi>I</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>ℂ</mi></msubsup><annotation encoding="application/x-tex">I_{pq}^{\mathbb{C}}</annotation></semantics></math> is complex and <math id="S16.SS3.SSS2.p9.m2" class="ltx_Math" alttext="R_{p}^{\pm}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mi>p</mi><mo>±</mo></msubsup><annotation encoding="application/x-tex">R_{p}^{\pm}</annotation></semantics></math>, <math id="S16.SS3.SSS2.p9.m3" class="ltx_Math" alttext="R_{q}^{\pm}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mi>q</mi><mo>±</mo></msubsup><annotation encoding="application/x-tex">R_{q}^{\pm}</annotation></semantics></math> are trivial representations of <math id="S16.SS3.SSS2.p9.m4" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math>, the isomorphism induces an NC structure on <math id="S16.SS3.SSS2.p9.m5" class="ltx_Math" alttext="T^{\rm vt}V_{pq}" display="inline" intent=":literal"><semantics><mrow><msup><mi>T</mi><mi>vt</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">T^{\rm vt}V_{pq}</annotation></semantics></math>. The compatibility condition given in Lemma <a href="#S16.Thmthm10" title="Lemma 16.10. ‣ 16.3.2. The construction of the normal complex structure ‣ 16.3. Proof of Theorem ‣ 16. Vertical Normal Complex Structures and orientations ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16.10</span></a> implies that the structural maps of the flow category respect the vertical NC structures. Therefore, one obtains a lift of <math id="S16.SS3.SSS2.p9.m6" class="ltx_Math" alttext="\hat{\mathbb{F}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝔽</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\mathbb{F}}</annotation></semantics></math> to <math id="S16.SS3.SSS2.p9.m7" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf S^{\rm rel}Kur}}_{\rm rig}^{\rm NC}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mrow><msup><mi>𝐒</mi><mi>rel</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐊𝐮𝐫</mi></mrow><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>NC</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf S^{\rm rel}Kur}}_{\rm rig}^{\rm NC}</annotation></semantics></math>. This finishes the proof of Theorem <a href="#S16.Thmthm1" title="Theorem 16.1. ‣ 16.1. Main statements about normal complex structures ‣ 16. Vertical Normal Complex Structures and orientations ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16.1</span></a>.</p>
</div>
</section>
</section>
<section id="S16.SS4" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">16.4. </span>Proof of Theorem <a href="#S16.Thmthm3" title="Theorem 16.3. ‣ 16.1. Main statements about normal complex structures ‣ 16. Vertical Normal Complex Structures and orientations ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16.3</span></a></h4>

<div id="S16.SS4.p1" class="ltx_para ltx_noindent">
<p id="S16.SS4.p1.1" class="ltx_p">Let <math id="S16.SS4.p1.m1" class="ltx_Math" alttext="\Sigma^{\mathbb{X}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Σ</mi><mi>𝕏</mi></msup><annotation encoding="application/x-tex">\Sigma^{\mathbb{X}}</annotation></semantics></math> be the smooth Floer domain in Situation <a href="#Thmsituationm3" title="Situation Module(iii). ‣ 15.4.2. The category of relative smooth Kuranishi spaces ‣ 15.4. Relatively smooth AMS lifts ‣ 15. Relatively Smooth AMS lifts ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Module(iii)</span></a>. One still needs to relate the linearization of the Floer equation with a complex-linear operator on <math id="S16.SS4.p1.m2" class="ltx_Math" alttext="\Sigma^{\mathbb{X}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Σ</mi><mi>𝕏</mi></msup><annotation encoding="application/x-tex">\Sigma^{\mathbb{X}}</annotation></semantics></math> via a certain interpolation. However, in order to be compatible with chosen interpolations for the involved flow categories, the interpolation here needs to depend on generally <math id="S16.SS4.p1.m3" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> parameters instead of just one, where <math id="S16.SS4.p1.m4" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> is the number of negative cylindrical ends, or more generally, the number of lateral lines in <math id="S16.SS4.p1.m5" class="ltx_Math" alttext="\Sigma^{\mathbb{X}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Σ</mi><mi>𝕏</mi></msup><annotation encoding="application/x-tex">\Sigma^{\mathbb{X}}</annotation></semantics></math>.</p>
</div>
<div id="S16.SS4.p2" class="ltx_para ltx_noindent">
<p id="S16.SS4.p2.1" class="ltx_p">Let <math id="S16.SS4.p2.m1" class="ltx_Math" alttext="\ell_{1},\ldots,\ell_{m}\subseteq\Sigma^{\mathbb{X}}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi mathvariant="normal">ℓ</mi><mi>m</mi></msub><mo>⊆</mo><msup><mi mathvariant="normal">Σ</mi><mi>𝕏</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\ell_{1},\ldots,\ell_{m}\subseteq\Sigma^{\mathbb{X}}</annotation></semantics></math> be the lateral lines. Choose diffeomorphisms</p>
<table id="S16.Ex66" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S16.Ex66.m1" class="ltx_Math" alttext="\rho_{j}:\ell_{j}\cong{\mathbb{R}}" display="block" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mi>j</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi mathvariant="normal">ℓ</mi><mi>j</mi></msub><mo>≅</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">\rho_{j}:\ell_{j}\cong{\mathbb{R}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S16.SS4.p2.2" class="ltx_p">such that on cylindrical ends, <math id="S16.SS4.p2.m2" class="ltx_Math" alttext="\rho_{j}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\rho_{j}</annotation></semantics></math> coincides with the radial coordinates up to a shift. Let</p>
<table id="S16.Ex67" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S16.Ex67.m1" class="ltx_math_unparsed" alttext="\widetilde{B}_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}" display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi>B</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup></mrow><annotation encoding="application/x-tex">\widetilde{B}_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S16.SS4.p2.3" class="ltx_p">be the version of the moduil <math id="S16.SS4.p2.m3" class="ltx_math_unparsed" alttext="B_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup></mrow><annotation encoding="application/x-tex">B_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}</annotation></semantics></math> whose elements are <math id="S16.SS4.p2.m4" class="ltx_Math" alttext="(\phi,z_{1},\ldots,z_{m})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo>,</mo><msub><mi>z</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>z</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\phi,z_{1},\ldots,z_{m})</annotation></semantics></math> where <math id="S16.SS4.p2.m5" class="ltx_Math" alttext="z_{j}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mi>j</mi></msub><annotation encoding="application/x-tex">z_{j}</annotation></semantics></math> is contained in the <math id="S16.SS4.p2.m6" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>-th lateral line <math id="S16.SS4.p2.m7" class="ltx_Math" alttext="\ell_{j}\subseteq C_{\phi}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">ℓ</mi><mi>j</mi></msub><mo>⊆</mo><msub><mi>C</mi><mi>ϕ</mi></msub></mrow><annotation encoding="application/x-tex">\ell_{j}\subseteq C_{\phi}</annotation></semantics></math> and</p>
<table id="S16.Ex68" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S16.Ex68.m1" class="ltx_Math" alttext="{\rm either}\ \rho_{j}(z_{j})\leq 0\ \forall j\ \ {\rm or}\ \rho_{1}(z_{1})=\cdots=\rho_{m}(z_{m})\geq 0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>either</mi><mo lspace="0.500em" rspace="0em">​</mo><msub><mi>ρ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mn>0</mn><mo lspace="0.667em" rspace="0em">​</mo><mrow><mo rspace="0.167em">∀</mo><mi>j</mi></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mi>or</mi><mo lspace="0.500em" rspace="0em">​</mo><msub><mi>ρ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">=</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">=</mo><mrow><msub><mi>ρ</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\rm either}\ \rho_{j}(z_{j})\leq 0\ \forall j\ \ {\rm or}\ \rho_{1}(z_{1})=\cdots=\rho_{m}(z_{m})\geq 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S16.SS4.p2.4" class="ltx_p">Compactify the spaces to allow the marked points to escape from cylindrical ends: notice that they can either escape from negative ends independently, or escape from the positive end simultaneously. Then the foregetful map</p>
<table id="S16.Ex69" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S16.Ex69.m1" class="ltx_math_unparsed" alttext="\widetilde{B}_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}\to B_{p_{1}\cdots p_{m};p^{\prime}}" display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi>B</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo stretchy="false">→</mo><mi>B</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub></mrow><annotation encoding="application/x-tex">\widetilde{B}_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}\to B_{p_{1}\cdots p_{m};p^{\prime}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S16.SS4.p2.5" class="ltx_p">has generic fibers being homeomorphic to a <math id="S16.SS4.p2.m8" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math>-dimensional complex. Notice that the functions <math id="S16.SS4.p2.m9" class="ltx_Math" alttext="\rho_{j}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\rho_{j}</annotation></semantics></math> extend to a continuous and <math id="S16.SS4.p2.m10" class="ltx_math_unparsed" alttext="G_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup></mrow><annotation encoding="application/x-tex">G_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}</annotation></semantics></math>-invariant map</p>
<table id="S16.Ex70" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S16.Ex70.m1" class="ltx_math_unparsed" alttext="\rho:\widetilde{B}_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}\to[-\infty,+\infty]^{m}" display="block" intent=":literal"><semantics><mrow><mi>ρ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><msubsup><mover accent="true"><mi>B</mi><mo>~</mo></mover><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow><mi>𝕏</mi></msubsup><mo stretchy="false">→</mo><msup><mrow><mo stretchy="false">[</mo><mo lspace="0em">−</mo><mi mathvariant="normal">∞</mi><mo rspace="0em">,</mo><mo lspace="0em">+</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">]</mo></mrow><mi>m</mi></msup></mrow><annotation encoding="application/x-tex">\rho:\widetilde{B}_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}\to[-\infty,+\infty]^{m}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S16.SS4.p2.6" class="ltx_p">such that either all <math id="S16.SS4.p2.m11" class="ltx_Math" alttext="\rho_{j}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\rho_{j}</annotation></semantics></math> are negative or all <math id="S16.SS4.p2.m12" class="ltx_Math" alttext="\rho_{j}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\rho_{j}</annotation></semantics></math> are nonnegative and identical.</p>
</div>
<div id="S16.SS4.p3" class="ltx_para ltx_noindent">
<p id="S16.SS4.p3.1" class="ltx_p">Moreover, one can pullback the universal curve to</p>
<table id="S16.Ex71" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S16.Ex71.m1" class="ltx_math_unparsed" alttext="\widetilde{C}_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}\to\widetilde{B}_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}." display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi>C</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo stretchy="false">→</mo><mover accent="true"><mi>B</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widetilde{C}_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}\to\widetilde{B}_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S16.SS4.p4" class="ltx_para ltx_noindent">
<p id="S16.SS4.p4.1" class="ltx_p">Similar to before, one has “structural maps”</p>
<table id="S16.EGx61" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S16.Ex72"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S16.Ex72.m1" class="ltx_math_unparsed" alttext="\displaystyle\ \widetilde{B}_{p_{i}q_{i}}^{{\mathbb{F}}_{i}}\boxtimes\widetilde{B}_{p_{1}\cdots p_{i-1}q_{i}p_{i+1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}\to\widetilde{B}_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}},\ " display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>B</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><msub><mi>p</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>i</mi></msub></mrow></msub><msup><mrow></mrow><msub><mi>𝔽</mi><mi>i</mi></msub></msup><mo lspace="0.222em" rspace="0.222em">⊠</mo><mover accent="true"><mi>B</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mi>q</mi><msub><mrow></mrow><mi>i</mi></msub><mi>p</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo stretchy="false">→</mo><mover accent="true"><mi>B</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ \widetilde{B}_{p_{i}q_{i}}^{{\mathbb{F}}_{i}}\boxtimes\widetilde{B}_{p_{1}\cdots p_{i-1}q_{i}p_{i+1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}\to\widetilde{B}_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}},\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S16.Ex72.m2" class="ltx_math_unparsed" alttext="\displaystyle\ \widetilde{B}_{p_{1}\cdots p_{m};q^{\prime}}^{\mathbb{X}}\boxtimes\widetilde{B}_{q^{\prime}p^{\prime}}^{{\mathbb{F}}^{\prime}}\to\widetilde{B}_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>B</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo lspace="0.222em" rspace="0.222em">⊠</mo><mover accent="true"><mi>B</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><msup><mi>q</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><msup><mi>𝔽</mi><mo>′</mo></msup></msup><mo stretchy="false">→</mo><mover accent="true"><mi>B</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup></mrow><annotation encoding="application/x-tex">\displaystyle\ \widetilde{B}_{p_{1}\cdots p_{m};q^{\prime}}^{\mathbb{X}}\boxtimes\widetilde{B}_{q^{\prime}p^{\prime}}^{{\mathbb{F}}^{\prime}}\to\widetilde{B}_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S16.SS4.p4.2" class="ltx_p">which satisfy the usual compatibility condition.</p>
</div>
<div id="S16.SS4.p5" class="ltx_para ltx_noindent">
<p id="S16.SS4.p5.1" class="ltx_p">We choose compatible cut-off functions, whose existence follow again from an induction argument.</p>
</div>
<div id="S16.Thmthm11" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S16.Thmthm11.2" class="ltx_text ltx_font_bold">Lemma 16.11</span></span><span id="S16.Thmthm11.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S16.Thmthm11.p1" class="ltx_para ltx_noindent">
<p id="S16.Thmthm11.p1.1" class="ltx_p"><span id="S16.Thmthm11.p1.1.1" class="ltx_text ltx_font_italic">Suppose <math id="S16.Thmthm11.p1.m1" class="ltx_Math" alttext="\chi_{p_{j}q_{j}}^{\mathbb{F}_{j}}" display="inline" intent=":literal"><semantics><msubsup><mi>χ</mi><mrow><msub><mi>p</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>j</mi></msub></mrow><msub><mi>𝔽</mi><mi>j</mi></msub></msubsup><annotation encoding="application/x-tex">\chi_{p_{j}q_{j}}^{\mathbb{F}_{j}}</annotation></semantics></math> and <math id="S16.Thmthm11.p1.m2" class="ltx_Math" alttext="\chi_{p^{\prime}q^{\prime}}^{{\mathbb{F}}^{\prime}}" display="inline" intent=":literal"><semantics><msubsup><mi>χ</mi><mrow><msup><mi>p</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>′</mo></msup></mrow><msup><mi>𝔽</mi><mo>′</mo></msup></msubsup><annotation encoding="application/x-tex">\chi_{p^{\prime}q^{\prime}}^{{\mathbb{F}}^{\prime}}</annotation></semantics></math> have been chosen independently as given by Lemma <a href="#S16.Thmthm7" title="Lemma 16.7. ‣ 16.3.2. The construction of the normal complex structure ‣ 16.3. Proof of Theorem ‣ 16. Vertical Normal Complex Structures and orientations ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16.7</span></a>. Then there exists a family of <math id="S16.Thmthm11.p1.m3" class="ltx_math_unparsed" alttext="G_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup></mrow><annotation encoding="application/x-tex">G_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}</annotation></semantics></math>-invariant continuous functions</span></p>
<table id="S16.Ex73" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S16.Ex73.m1" class="ltx_math_unparsed" alttext="\chi_{p_{1}\cdots p_{m};p^{\prime}}^{{\mathbb{X}}}:\widetilde{C}_{p_{1}\cdots p_{m};p^{\prime}}^{{\mathbb{X}}}\to[0,1]" display="block" intent=":literal"><semantics><mrow><msubsup><mi>χ</mi><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow><mi>𝕏</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><msubsup><mover accent="true"><mi>C</mi><mo>~</mo></mover><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow><mi>𝕏</mi></msubsup><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\chi_{p_{1}\cdots p_{m};p^{\prime}}^{{\mathbb{X}}}:\widetilde{C}_{p_{1}\cdots p_{m};p^{\prime}}^{{\mathbb{X}}}\to[0,1]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S16.Thmthm11.p1.2" class="ltx_p"><span id="S16.Thmthm11.p1.2.1" class="ltx_text ltx_font_italic">satisfying the following conditions. We characterize the property by considering its restriction to the fiber at each point <math id="S16.Thmthm11.p1.m4" class="ltx_math_unparsed" alttext="\widetilde{\phi}\in\widetilde{B}_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover><mo>∈</mo><mover accent="true"><mi>B</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup></mrow><annotation encoding="application/x-tex">\widetilde{\phi}\in\widetilde{B}_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}</annotation></semantics></math>. Denote the restriction by <math id="S16.Thmthm11.p1.m5" class="ltx_Math" alttext="\chi_{\widetilde{\phi}}:C_{\widetilde{\phi}}\to[0,1]" display="inline" intent=":literal"><semantics><mrow><msub><mi>χ</mi><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>C</mi><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover></msub><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\chi_{\widetilde{\phi}}:C_{\widetilde{\phi}}\to[0,1]</annotation></semantics></math>.</span></p>
</div>
<div id="S16.Thmthm11.p2" class="ltx_para">
<ol id="S16.I6" class="ltx_enumerate">
<li id="S16.I6.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S16.I6.i1.p1" class="ltx_para ltx_noindent">
<p id="S16.I6.i1.p1.1" class="ltx_p"><span id="S16.I6.i1.p1.1.1" class="ltx_text ltx_font_italic">When </span><math id="S16.I6.i1.p1.m1" class="ltx_Math" alttext="\rho_{1},\ldots,\rho_{m}\leq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>ρ</mi><mi>m</mi></msub><mo>≤</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">\rho_{1},\ldots,\rho_{m}\leq 0</annotation></semantics></math><span id="S16.I6.i1.p1.1.2" class="ltx_text ltx_font_italic">, the support of </span><math id="S16.I6.i1.p1.m2" class="ltx_Math" alttext="\chi_{\widetilde{\phi}}" display="inline" intent=":literal"><semantics><msub><mi>χ</mi><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover></msub><annotation encoding="application/x-tex">\chi_{\widetilde{\phi}}</annotation></semantics></math><span id="S16.I6.i1.p1.1.3" class="ltx_text ltx_font_italic"> is the disjoint union of </span><math id="S16.I6.i1.p1.m3" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math><span id="S16.I6.i1.p1.1.4" class="ltx_text ltx_font_italic"> connected cylindrical regions contained in the </span><math id="S16.I6.i1.p1.m4" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math><span id="S16.I6.i1.p1.1.5" class="ltx_text ltx_font_italic"> negative ends of </span><math id="S16.I6.i1.p1.m5" class="ltx_Math" alttext="C_{\widetilde{\phi}}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover></msub><annotation encoding="application/x-tex">C_{\widetilde{\phi}}</annotation></semantics></math><span id="S16.I6.i1.p1.1.6" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S16.I6.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S16.I6.i2.p1" class="ltx_para ltx_noindent">
<p id="S16.I6.i2.p1.1" class="ltx_p"><span id="S16.I6.i2.p1.1.1" class="ltx_text ltx_font_italic">When </span><math id="S16.I6.i2.p1.m1" class="ltx_Math" alttext="\rho_{1}=\ldots=\rho_{m}\gg 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mn>1</mn></msub><mo>=</mo><mi mathvariant="normal">…</mi><mo>=</mo><msub><mi>ρ</mi><mi>m</mi></msub><mo>≫</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\rho_{1}=\ldots=\rho_{m}\gg 0</annotation></semantics></math><span id="S16.I6.i2.p1.1.2" class="ltx_text ltx_font_italic">, the support of </span><math id="S16.I6.i2.p1.m2" class="ltx_Math" alttext="\chi_{\widetilde{\phi}}" display="inline" intent=":literal"><semantics><msub><mi>χ</mi><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover></msub><annotation encoding="application/x-tex">\chi_{\widetilde{\phi}}</annotation></semantics></math><span id="S16.I6.i2.p1.1.3" class="ltx_text ltx_font_italic"> is contained in the positive cylindrical end.</span></p>
</div></li>
<li id="S16.I6.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S16.I6.i3.p1" class="ltx_para ltx_noindent">
<p id="S16.I6.i3.p1.1" class="ltx_p"><math id="S16.I6.i3.p1.m1" class="ltx_math_unparsed" alttext="\chi_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}" display="inline" intent=":literal"><semantics><mrow><mi>χ</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup></mrow><annotation encoding="application/x-tex">\chi_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}</annotation></semantics></math><span id="S16.I6.i3.p1.1.1" class="ltx_text ltx_font_italic"> respects the structural maps of the multimodule about the concatenation from the negative side. More precisely, when </span><math id="S16.I6.i3.p1.m2" class="ltx_Math" alttext="p_{j}&lt;q_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>j</mi></msub><mo>&lt;</mo><msub><mi>q</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">p_{j}&lt;q_{j}</annotation></semantics></math><span id="S16.I6.i3.p1.1.2" class="ltx_text ltx_font_italic"> and </span><math id="S16.I6.i3.p1.m3" class="ltx_math_unparsed" alttext="\widetilde{\phi}\in\widetilde{B}_{p_{1}\cdots p_{j-1}(p_{j}q_{j})p_{j+1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover><mo>∈</mo><mover accent="true"><mi>B</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi>p</mi><msub><mrow></mrow><mi>j</mi></msub><mi>q</mi><msub><mrow></mrow><mi>j</mi></msub><mo stretchy="false">)</mo><mi>p</mi><msub><mrow></mrow><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup></mrow><annotation encoding="application/x-tex">\widetilde{\phi}\in\widetilde{B}_{p_{1}\cdots p_{j-1}(p_{j}q_{j})p_{j+1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}</annotation></semantics></math><span id="S16.I6.i3.p1.1.3" class="ltx_text ltx_font_italic">, </span><math id="S16.I6.i3.p1.m4" class="ltx_Math" alttext="\chi_{\widetilde{\phi}}" display="inline" intent=":literal"><semantics><msub><mi>χ</mi><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover></msub><annotation encoding="application/x-tex">\chi_{\widetilde{\phi}}</annotation></semantics></math><span id="S16.I6.i3.p1.1.4" class="ltx_text ltx_font_italic"> is determined by </span><math id="S16.I6.i3.p1.m5" class="ltx_Math" alttext="\chi_{p_{j}q_{j}}^{{\mathbb{F}}_{j}}" display="inline" intent=":literal"><semantics><msubsup><mi>χ</mi><mrow><msub><mi>p</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>j</mi></msub></mrow><msub><mi>𝔽</mi><mi>j</mi></msub></msubsup><annotation encoding="application/x-tex">\chi_{p_{j}q_{j}}^{{\mathbb{F}}_{j}}</annotation></semantics></math><span id="S16.I6.i3.p1.1.5" class="ltx_text ltx_font_italic"> and </span><math id="S16.I6.i3.p1.m6" class="ltx_math_unparsed" alttext="\chi_{p_{1}\cdots p_{j-1}q_{j}p_{j+1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}" display="inline" intent=":literal"><semantics><mrow><mi>χ</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mi>q</mi><msub><mrow></mrow><mi>j</mi></msub><mi>p</mi><msub><mrow></mrow><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup></mrow><annotation encoding="application/x-tex">\chi_{p_{1}\cdots p_{j-1}q_{j}p_{j+1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}</annotation></semantics></math><span id="S16.I6.i3.p1.1.6" class="ltx_text ltx_font_italic"> in the canonical way.</span></p>
</div></li>
<li id="S16.I6.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S16.I6.i4.p1" class="ltx_para ltx_noindent">
<p id="S16.I6.i4.p1.1" class="ltx_p"><math id="S16.I6.i4.p1.m1" class="ltx_math_unparsed" alttext="\chi_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}" display="inline" intent=":literal"><semantics><mrow><mi>χ</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup></mrow><annotation encoding="application/x-tex">\chi_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}</annotation></semantics></math><span id="S16.I6.i4.p1.1.1" class="ltx_text ltx_font_italic"> respects the structural map of the multimodule about concatenation from the positive side. More precisely, if </span><math id="S16.I6.i4.p1.m2" class="ltx_math_unparsed" alttext="\widetilde{\phi}\in\widetilde{B}_{p_{1}\cdots p_{m};q^{\prime}p^{\prime}}^{\mathbb{X}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover><mo>∈</mo><mover accent="true"><mi>B</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup></mrow><annotation encoding="application/x-tex">\widetilde{\phi}\in\widetilde{B}_{p_{1}\cdots p_{m};q^{\prime}p^{\prime}}^{\mathbb{X}}</annotation></semantics></math><span id="S16.I6.i4.p1.1.2" class="ltx_text ltx_font_italic">, then </span><math id="S16.I6.i4.p1.m3" class="ltx_Math" alttext="\chi_{\widetilde{\phi}}" display="inline" intent=":literal"><semantics><msub><mi>χ</mi><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover></msub><annotation encoding="application/x-tex">\chi_{\widetilde{\phi}}</annotation></semantics></math><span id="S16.I6.i4.p1.1.3" class="ltx_text ltx_font_italic"> is canonically determined by </span><math id="S16.I6.i4.p1.m4" class="ltx_math_unparsed" alttext="\chi_{p_{1}\cdots p_{m};q^{\prime}}^{\mathbb{X}}" display="inline" intent=":literal"><semantics><mrow><mi>χ</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup></mrow><annotation encoding="application/x-tex">\chi_{p_{1}\cdots p_{m};q^{\prime}}^{\mathbb{X}}</annotation></semantics></math><span id="S16.I6.i4.p1.1.4" class="ltx_text ltx_font_italic"> and </span><math id="S16.I6.i4.p1.m5" class="ltx_Math" alttext="\chi_{q^{\prime}p^{\prime}}^{{\mathbb{F}}^{\prime}}" display="inline" intent=":literal"><semantics><msubsup><mi>χ</mi><mrow><msup><mi>q</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><msup><mi>𝔽</mi><mo>′</mo></msup></msubsup><annotation encoding="application/x-tex">\chi_{q^{\prime}p^{\prime}}^{{\mathbb{F}}^{\prime}}</annotation></semantics></math><span id="S16.I6.i4.p1.1.5" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S16.I6.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(5)</span> 
<div id="S16.I6.i5.p1" class="ltx_para ltx_noindent">
<p id="S16.I6.i5.p1.1" class="ltx_p"><math id="S16.I6.i5.p1.m1" class="ltx_math_unparsed" alttext="\chi_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}" display="inline" intent=":literal"><semantics><mrow><mi>χ</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup></mrow><annotation encoding="application/x-tex">\chi_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}</annotation></semantics></math><span id="S16.I6.i5.p1.1.1" class="ltx_text ltx_font_italic"> is collared. Namely, near each stratum, it is constant in collar coordinates.</span></p>
</div></li>
<li id="S16.I6.i6" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(6)</span> 
<div id="S16.I6.i6.p1" class="ltx_para ltx_noindent">
<p id="S16.I6.i6.p1.1" class="ltx_p"><math id="S16.I6.i6.p1.m1" class="ltx_math_unparsed" alttext="\chi_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}" display="inline" intent=":literal"><semantics><mrow><mi>χ</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup></mrow><annotation encoding="application/x-tex">\chi_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}</annotation></semantics></math><span id="S16.I6.i6.p1.1.1" class="ltx_text ltx_font_italic"> respects the rigidification.</span></p>
</div></li>
<li id="S16.I6.i7" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(7)</span> 
<div id="S16.I6.i7.p1" class="ltx_para ltx_noindent">
<p id="S16.I6.i7.p1.1" class="ltx_p"><span id="S16.I6.i7.p1.1.1" class="ltx_text ltx_font_italic">The collection of functions are equivariant with respect to the action by </span><math id="S16.I6.i7.p1.m1" class="ltx_Math" alttext="\Pi^{m}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Π</mi><mi>m</mi></msup><annotation encoding="application/x-tex">\Pi^{m}</annotation></semantics></math><span id="S16.I6.i7.p1.1.2" class="ltx_text ltx_font_italic">. Namely, if </span><math id="S16.I6.i7.p1.m2" class="ltx_Math" alttext="a_{1},\ldots,a_{m}\in\Pi" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>a</mi><mi>m</mi></msub><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow></mrow><annotation encoding="application/x-tex">a_{1},\ldots,a_{m}\in\Pi</annotation></semantics></math><span id="S16.I6.i7.p1.1.3" class="ltx_text ltx_font_italic"> and </span><math id="S16.I6.i7.p1.m3" class="ltx_Math" alttext="q_{1}=a_{1}p_{1},\ldots,q_{m}=a_{m}p_{m}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>q</mi><mn>1</mn></msub><mo>=</mo><mrow><msub><mi>a</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mn>1</mn></msub></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>q</mi><mi>m</mi></msub><mo>=</mo><mrow><msub><mi>a</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>m</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">q_{1}=a_{1}p_{1},\ldots,q_{m}=a_{m}p_{m}</annotation></semantics></math><span id="S16.I6.i7.p1.1.4" class="ltx_text ltx_font_italic">, </span><math id="S16.I6.i7.p1.m4" class="ltx_Math" alttext="q^{\prime}=(a_{1}+\cdots+a_{m})p^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mo>′</mo></msup><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>a</mi><mi>m</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">q^{\prime}=(a_{1}+\cdots+a_{m})p^{\prime}</annotation></semantics></math><span id="S16.I6.i7.p1.1.5" class="ltx_text ltx_font_italic">, with respect to the identification </span><math id="S16.I6.i7.p1.m5" class="ltx_math_unparsed" alttext="\widetilde{C}_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}\cong\widetilde{C}_{q_{1}\cdots q_{m};q^{\prime}}^{\mathbb{X}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>C</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo>≅</mo><mover accent="true"><mi>C</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>q</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>q</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup></mrow><annotation encoding="application/x-tex">\widetilde{C}_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}\cong\widetilde{C}_{q_{1}\cdots q_{m};q^{\prime}}^{\mathbb{X}}</annotation></semantics></math><span id="S16.I6.i7.p1.1.6" class="ltx_text ltx_font_italic">, one has</span></p>
<table id="S16.Ex74" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S16.Ex74.m1" class="ltx_math_unparsed" alttext="\chi_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}=\chi_{q_{1}\cdots q_{m};q^{\prime}}^{\mathbb{X}}." display="block" intent=":literal"><semantics><mrow><mi>χ</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo>=</mo><mi>χ</mi><msub><mrow></mrow><mrow><mi>q</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>q</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\chi_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}=\chi_{q_{1}\cdots q_{m};q^{\prime}}^{\mathbb{X}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
</div>
</div>
<div id="S16.SS4.p6" class="ltx_para ltx_noindent">
<p id="S16.SS4.p6.1" class="ltx_p">Now similar to the flow category case, for each <math id="S16.SS4.p6.m1" class="ltx_math_unparsed" alttext="\widetilde{x}=(\widetilde{\phi},\widetilde{u},e,F)\in\widetilde{V}_{p_{1}\cdots p_{m};p^{\prime}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo>=</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover><mo>,</mo><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo>,</mo><mi>e</mi><mo>,</mo><mi>F</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub></mrow><annotation encoding="application/x-tex">\widetilde{x}=(\widetilde{\phi},\widetilde{u},e,F)\in\widetilde{V}_{p_{1}\cdots p_{m};p^{\prime}}</annotation></semantics></math>, there are a pair of Banach spaces</p>
<table id="S16.EGx62" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S16.Ex75"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S16.Ex75.m1" class="ltx_Math" alttext="\displaystyle\ {\mathcal{E}}_{\widetilde{x}}^{1},\ " display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mover accent="true"><mi>x</mi><mo>~</mo></mover><mn>1</mn></msubsup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ {\mathcal{E}}_{\widetilde{x}}^{1},\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S16.Ex75.m2" class="ltx_Math" alttext="\displaystyle\ {\mathcal{E}}_{\widetilde{x}}^{0}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mover accent="true"><mi>x</mi><mo>~</mo></mover><mn>0</mn></msubsup><annotation encoding="application/x-tex">\displaystyle\ {\mathcal{E}}_{\widetilde{x}}^{0}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S16.SS4.p6.2" class="ltx_p">which form equivariant “vector bundles”</p>
<table id="S16.EGx63" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S16.Ex76"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S16.Ex76.m1" class="ltx_math_unparsed" alttext="\displaystyle\ {\mathcal{E}}_{p_{1}\cdots p_{m};p^{\prime}}^{1},\ " display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mn>1</mn></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ {\mathcal{E}}_{p_{1}\cdots p_{m};p^{\prime}}^{1},\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S16.Ex76.m2" class="ltx_math_unparsed" alttext="\displaystyle\ {\mathcal{E}}_{p_{1}\cdots p_{m};p^{\prime}}^{0}." display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mn>0</mn></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ {\mathcal{E}}_{p_{1}\cdots p_{m};p^{\prime}}^{0}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S16.SS4.p6.3" class="ltx_p">The cut-off functions also induce a family of Cauchy–Riemann operators</p>
<table id="S16.Ex77" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S16.Ex77.m1" class="ltx_Math" alttext="D_{\widetilde{x}}:{\mathcal{E}}_{\widetilde{x}}^{1}\to{\mathcal{E}}_{\widetilde{x}}^{0}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>D</mi><mover accent="true"><mi>x</mi><mo>~</mo></mover></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mover accent="true"><mi>x</mi><mo>~</mo></mover><mn>1</mn></msubsup><mo stretchy="false">→</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mover accent="true"><mi>x</mi><mo>~</mo></mover><mn>0</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">D_{\widetilde{x}}:{\mathcal{E}}_{\widetilde{x}}^{1}\to{\mathcal{E}}_{\widetilde{x}}^{0}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S16.SS4.p7" class="ltx_para ltx_noindent">
<p id="S16.SS4.p7.1" class="ltx_p">Before we state the definition of index bundle interpolators for the multimodule case, we specify certain boundary strata of <math id="S16.SS4.p7.m1" class="ltx_math_unparsed" alttext="\widetilde{V}_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>V</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup></mrow><annotation encoding="application/x-tex">\widetilde{V}_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}</annotation></semantics></math>. For <math id="S16.SS4.p7.m2" class="ltx_Math" alttext="j=1,\ldots,m" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">j=1,\ldots,m</annotation></semantics></math>, there is a corresponding codimension 1 stratum</p>
<table id="S16.Ex78" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S16.Ex78.m1" class="ltx_math_unparsed" alttext="\partial^{j}\widetilde{V}_{p_{1}\cdots p_{m};p^{\prime}}" display="block" intent=":literal"><semantics><mrow><mo>∂</mo><msup><mrow></mrow><mi>j</mi></msup><mover accent="true"><mi>V</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub></mrow><annotation encoding="application/x-tex">\partial^{j}\widetilde{V}_{p_{1}\cdots p_{m};p^{\prime}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S16.SS4.p7.2" class="ltx_p">corresponding to configurations where the <math id="S16.SS4.p7.m3" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>-th marked point goes to the very left of the underlying curve. There is also a positive end</p>
<table id="S16.Ex79" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S16.Ex79.m1" class="ltx_math_unparsed" alttext="\partial^{+}\widetilde{V}_{p_{1}\cdots p_{m};p^{\prime}}\cong V_{p_{1}\cdots p_{m};p^{\prime}}" display="block" intent=":literal"><semantics><mrow><mo>∂</mo><msup><mrow></mrow><mo>+</mo></msup><mover accent="true"><mi>V</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo>≅</mo><mi>V</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub></mrow><annotation encoding="application/x-tex">\partial^{+}\widetilde{V}_{p_{1}\cdots p_{m};p^{\prime}}\cong V_{p_{1}\cdots p_{m};p^{\prime}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S16.SS4.p7.3" class="ltx_p">corresponding to configurations where all the <math id="S16.SS4.p7.m4" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> marked points go to the very right of the underlying curve. Notice that we also have a canonical identification</p>
<table id="S16.Ex80" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S16.Ex80.m1" class="ltx_math_unparsed" alttext="\partial^{-}\widetilde{V}_{p_{1}\cdots p_{m};p^{\prime}}:=\bigcap_{j=1}^{m}\partial^{j}\widetilde{V}_{p_{1}\cdots p_{m};p^{\prime}}\cong V_{p_{1}\cdots p_{m};p^{\prime}}." display="block" intent=":literal"><semantics><mrow><mo>∂</mo><msup><mrow></mrow><mo>−</mo></msup><mover accent="true"><mi>V</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo rspace="0.111em">:=</mo><mo movablelimits="false" rspace="0em">⋂</mo><msub><mrow></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>m</mi></msup><mo>∂</mo><msup><mrow></mrow><mi>j</mi></msup><mover accent="true"><mi>V</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo>≅</mo><mi>V</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\partial^{-}\widetilde{V}_{p_{1}\cdots p_{m};p^{\prime}}:=\bigcap_{j=1}^{m}\partial^{j}\widetilde{V}_{p_{1}\cdots p_{m};p^{\prime}}\cong V_{p_{1}\cdots p_{m};p^{\prime}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S16.SS4.p8" class="ltx_para ltx_noindent">
<p id="S16.SS4.p8.1" class="ltx_p">We consider the compactly supported version of <math id="S16.SS4.p8.m1" class="ltx_math_unparsed" alttext="{\mathcal{E}}_{p_{1}\cdots p_{m};p^{\prime}}^{0}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mn>0</mn></msup></mrow><annotation encoding="application/x-tex">{\mathcal{E}}_{p_{1}\cdots p_{m};p^{\prime}}^{0}</annotation></semantics></math>, which is denoted by</p>
<table id="S16.Ex81" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S16.Ex81.m1" class="ltx_math_unparsed" alttext="\mathring{\mathcal{E}}_{p_{1}\cdots p_{m};p^{\prime}}^{0}." display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>̊</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mn>0</mn></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathring{\mathcal{E}}_{p_{1}\cdots p_{m};p^{\prime}}^{0}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S16.SS4.p9" class="ltx_para ltx_noindent">
<p id="S16.SS4.p9.1" class="ltx_p">We give the analogue of Definition <a href="#S16.Thmthm8" title="Definition 16.8. ‣ 16.3.2. The construction of the normal complex structure ‣ 16.3. Proof of Theorem ‣ 16. Vertical Normal Complex Structures and orientations ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16.8</span></a>.</p>
</div>
<div id="S16.Thmthm12" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S16.Thmthm12.2" class="ltx_text ltx_font_bold">Definition 16.12</span></span><span id="S16.Thmthm12.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S16.Thmthm12.p1" class="ltx_para ltx_noindent">
<p id="S16.Thmthm12.p1.1" class="ltx_p">Suppose we have chosen index bundle interpolators over <math id="S16.Thmthm12.p1.m1" class="ltx_Math" alttext="\hat{\mathbb{F}}_{1},\ldots,\hat{\mathbb{F}}_{m};\hat{\mathbb{F}}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>𝔽</mi><mo>^</mo></mover><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mover accent="true"><mi>𝔽</mi><mo>^</mo></mover><mi>m</mi></msub><mo>;</mo><msup><mover accent="true"><mi>𝔽</mi><mo>^</mo></mover><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">\hat{\mathbb{F}}_{1},\ldots,\hat{\mathbb{F}}_{m};\hat{\mathbb{F}}^{\prime}</annotation></semantics></math> independently. An <span id="S16.Thmthm12.p1.1.1" class="ltx_text ltx_font_bold">index bundle interpolator</span> over <math id="S16.Thmthm12.p1.m2" class="ltx_Math" alttext="\hat{\mathbb{X}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝕏</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\mathbb{X}}</annotation></semantics></math> (compatible with the existing index bundle interpolators) consists of the following items.</p>
<ol id="S16.I7" class="ltx_enumerate">
<li id="S16.I7.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S16.I7.i1.p1" class="ltx_para ltx_noindent">
<p id="S16.I7.i1.p1.1" class="ltx_p">A collection of finite-dimensional unitary representations <math id="S16.I7.i1.p1.m1" class="ltx_math_unparsed" alttext="W_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup></mrow><annotation encoding="application/x-tex">W_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}</annotation></semantics></math> of <math id="S16.I7.i1.p1.m2" class="ltx_math_unparsed" alttext="G_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup></mrow><annotation encoding="application/x-tex">G_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}</annotation></semantics></math>.</p>
</div></li>
<li id="S16.I7.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S16.I7.i2.p1" class="ltx_para ltx_noindent">
<p id="S16.I7.i2.p1.1" class="ltx_p">A collection of equivariant complex-linear bundle maps</p>
<table id="S16.Ex82" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S16.Ex82.m1" class="ltx_math_unparsed" alttext="\widetilde{\nu}_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}:\bigoplus_{j=1}^{m}\underline{\smash{R}}_{p_{j}}^{+}\oplus\underline{\smash{W}}_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}\oplus\underline{\smash{R}}_{p^{\prime}}^{+}\to\mathring{\mathcal{E}}_{p_{1}\cdots p_{m};p^{\prime}}^{0}" display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi>ν</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo lspace="0.278em" rspace="0.111em">:</mo><mo movablelimits="false">⨁</mo><msub><mrow></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>m</mi></msup><munder accentunder="true"><mi>R</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><msub><mi>p</mi><mi>j</mi></msub></msub><msup><mrow></mrow><mo>+</mo></msup><mo>⊕</mo><munder accentunder="true"><mi>W</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo>⊕</mo><munder accentunder="true"><mi>R</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><msup><mi>p</mi><mo>′</mo></msup></msub><msup><mrow></mrow><mo>+</mo></msup><mo stretchy="false">→</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>̊</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mn>0</mn></msup></mrow><annotation encoding="application/x-tex">\widetilde{\nu}_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}:\bigoplus_{j=1}^{m}\underline{\smash{R}}_{p_{j}}^{+}\oplus\underline{\smash{W}}_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}\oplus\underline{\smash{R}}_{p^{\prime}}^{+}\to\mathring{\mathcal{E}}_{p_{1}\cdots p_{m};p^{\prime}}^{0}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S16.I7.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S16.I7.i3.p1" class="ltx_para ltx_noindent">
<p id="S16.I7.i3.p1.1" class="ltx_p">A collection of equivariant complex linear maps</p>
<table id="S16.Ex83" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S16.Ex83.m1" class="ltx_math_unparsed" alttext="\widetilde{\iota}_{p_{1}\cdots p_{i-1}(p_{i}q_{i})p_{i+1}\cdots p_{m};p^{\prime}}:W_{p_{i}q_{i}}^{\mathbb{F}_{i}}\oplus R_{q_{i}}^{+}\oplus W_{p_{1}\cdots p_{i-1}q_{i}p_{i+1}\cdots p_{m};p^{\prime}}\to W_{p_{1}\cdots p_{m};p^{\prime}}." display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi>ι</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi>p</mi><msub><mrow></mrow><mi>i</mi></msub><mi>q</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mi>p</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mi>W</mi><msub><mrow></mrow><mrow><msub><mi>p</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>i</mi></msub></mrow></msub><msup><mrow></mrow><msub><mi>𝔽</mi><mi>i</mi></msub></msup><mo>⊕</mo><mi>R</mi><msub><mrow></mrow><msub><mi>q</mi><mi>i</mi></msub></msub><msup><mrow></mrow><mo>+</mo></msup><mo>⊕</mo><mi>W</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mi>q</mi><msub><mrow></mrow><mi>i</mi></msub><mi>p</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo stretchy="false">→</mo><mi>W</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widetilde{\iota}_{p_{1}\cdots p_{i-1}(p_{i}q_{i})p_{i+1}\cdots p_{m};p^{\prime}}:W_{p_{i}q_{i}}^{\mathbb{F}_{i}}\oplus R_{q_{i}}^{+}\oplus W_{p_{1}\cdots p_{i-1}q_{i}p_{i+1}\cdots p_{m};p^{\prime}}\to W_{p_{1}\cdots p_{m};p^{\prime}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S16.I7.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S16.I7.i4.p1" class="ltx_para ltx_noindent">
<p id="S16.I7.i4.p1.1" class="ltx_p">A collection of equivariant complex linear maps</p>
<table id="S16.Ex84" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S16.Ex84.m1" class="ltx_math_unparsed" alttext="\widetilde{\iota}_{p_{1}\cdots p_{m};q^{\prime}p^{\prime}}:W_{p_{1}\cdots p_{m};q^{\prime}}^{\mathbb{X}}\oplus R_{q^{\prime}}^{+}\oplus W_{q^{\prime}p^{\prime}}^{{\mathbb{F}}^{\prime}}\to W_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}." display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi>ι</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mi>W</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo>⊕</mo><mi>R</mi><msub><mrow></mrow><msup><mi>q</mi><mo>′</mo></msup></msub><msup><mrow></mrow><mo>+</mo></msup><mo>⊕</mo><mi>W</mi><msub><mrow></mrow><mrow><msup><mi>q</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><msup><mi>𝔽</mi><mo>′</mo></msup></msup><mo stretchy="false">→</mo><mi>W</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widetilde{\iota}_{p_{1}\cdots p_{m};q^{\prime}p^{\prime}}:W_{p_{1}\cdots p_{m};q^{\prime}}^{\mathbb{X}}\oplus R_{q^{\prime}}^{+}\oplus W_{q^{\prime}p^{\prime}}^{{\mathbb{F}}^{\prime}}\to W_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
<p id="S16.Thmthm12.p1.2" class="ltx_p">They are required to satisfy the following conditions.</p>
<ol id="S16.I8" class="ltx_enumerate">
<li id="S16.I8.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S16.I8.i1.p1" class="ltx_para ltx_noindent">
<p id="S16.I8.i1.p1.1" class="ltx_p">For each <math id="S16.I8.i1.p1.m1" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> and <math id="S16.I8.i1.p1.m2" class="ltx_math_unparsed" alttext="\widetilde{x}=(\widetilde{\phi},\widetilde{u},e,F)\in\partial^{j}\widetilde{V}_{p_{1}\cdots p_{m};p^{\prime}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo>=</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover><mo>,</mo><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo>,</mo><mi>e</mi><mo>,</mo><mi>F</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">∈</mo><msup><mo>∂</mo><mi>j</mi></msup><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub></mrow><annotation encoding="application/x-tex">\widetilde{x}=(\widetilde{\phi},\widetilde{u},e,F)\in\partial^{j}\widetilde{V}_{p_{1}\cdots p_{m};p^{\prime}}</annotation></semantics></math>, <math id="S16.I8.i1.p1.m3" class="ltx_Math" alttext="\widetilde{\nu}_{\widetilde{x}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ν</mi><mo>~</mo></mover><mover accent="true"><mi>x</mi><mo>~</mo></mover></msub><annotation encoding="application/x-tex">\widetilde{\nu}_{\widetilde{x}}</annotation></semantics></math> sends <math id="S16.I8.i1.p1.m4" class="ltx_Math" alttext="R_{p_{j}}^{+}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><msub><mi>p</mi><mi>j</mi></msub><mo>+</mo></msubsup><annotation encoding="application/x-tex">R_{p_{j}}^{+}</annotation></semantics></math> via <math id="S16.I8.i1.p1.m5" class="ltx_Math" alttext="\nu_{p_{j}}" display="inline" intent=":literal"><semantics><msub><mi>ν</mi><msub><mi>p</mi><mi>j</mi></msub></msub><annotation encoding="application/x-tex">\nu_{p_{j}}</annotation></semantics></math> into the component over the domain of <math id="S16.I8.i1.p1.m6" class="ltx_Math" alttext="u_{p_{j}}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><msub><mi>p</mi><mi>j</mi></msub></msub><annotation encoding="application/x-tex">u_{p_{j}}</annotation></semantics></math> while sends the complement of <math id="S16.I8.i1.p1.m7" class="ltx_Math" alttext="R_{p_{j}}^{+}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><msub><mi>p</mi><mi>j</mi></msub><mo>+</mo></msubsup><annotation encoding="application/x-tex">R_{p_{j}}^{+}</annotation></semantics></math> into other components.</p>
</div></li>
<li id="S16.I8.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S16.I8.i2.p1" class="ltx_para ltx_noindent">
<p id="S16.I8.i2.p1.1" class="ltx_p"><span id="S16.I8.i2.p1.1.1" class="ltx_text ltx_font_bold">(The original index bundle)</span> For each <math id="S16.I8.i2.p1.m1" class="ltx_math_unparsed" alttext="\widetilde{x}=(\widetilde{\phi},\widetilde{u},e,F)\in\partial^{-}\widetilde{V}_{p_{1}\cdots p_{m};p^{\prime}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo>=</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover><mo>,</mo><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo>,</mo><mi>e</mi><mo>,</mo><mi>F</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">∈</mo><msup><mo>∂</mo><mo>−</mo></msup><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub></mrow><annotation encoding="application/x-tex">\widetilde{x}=(\widetilde{\phi},\widetilde{u},e,F)\in\partial^{-}\widetilde{V}_{p_{1}\cdots p_{m};p^{\prime}}</annotation></semantics></math>, with respect to the decomposition</p>
<table id="S16.Ex85" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S16.Ex85.m1" class="ltx_Math" alttext="\mathring{\mathcal{E}}_{\widetilde{x}}^{0}\cong\bigoplus_{j=1}^{m}\Omega_{c}^{0,1}({\mathbb{R}}\times S^{1},u_{p_{j}}^{*}TX)\oplus\Omega_{c}^{0,1}(C_{\phi},u^{*}TX)" display="block" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>̊</mo></mover><mover accent="true"><mi>x</mi><mo>~</mo></mover><mn>0</mn></msubsup><mo rspace="0.111em">≅</mo><mrow><mrow><munderover><mo movablelimits="false">⨁</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><mrow><msubsup><mi mathvariant="normal">Ω</mi><mi>c</mi><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ℝ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>S</mi><mn>1</mn></msup></mrow><mo>,</mo><mrow><msubsup><mi>u</mi><msub><mi>p</mi><mi>j</mi></msub><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>X</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⊕</mo><mrow><msubsup><mi mathvariant="normal">Ω</mi><mi>c</mi><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mi>ϕ</mi></msub><mo>,</mo><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>X</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathring{\mathcal{E}}_{\widetilde{x}}^{0}\cong\bigoplus_{j=1}^{m}\Omega_{c}^{0,1}({\mathbb{R}}\times S^{1},u_{p_{j}}^{*}TX)\oplus\Omega_{c}^{0,1}(C_{\phi},u^{*}TX)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S16.I8.i2.p1.2" class="ltx_p">we have</p>
<table id="S16.Ex86" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S16.Ex86.m1" class="ltx_math_unparsed" alttext="\widetilde{\nu}_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}=\left[\begin{array}[]{ccc}\bigoplus_{j=1}^{m}\nu_{p_{j}}&amp;0&amp;0\\
0&amp;0&amp;0\end{array}\right]." display="block" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>ν</mi><mo>~</mo></mover><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow><mi>𝕏</mi></msubsup><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd><mrow><mstyle displaystyle="false"><msubsup><mo>⨁</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup></mstyle><msub><mi>ν</mi><msub><mi>p</mi><mi>j</mi></msub></msub></mrow></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widetilde{\nu}_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}=\left[\begin{array}[]{ccc}\bigoplus_{j=1}^{m}\nu_{p_{j}}&amp;0&amp;0\\
0&amp;0&amp;0\end{array}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S16.I8.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S16.I8.i3.p1" class="ltx_para ltx_noindent">
<p id="S16.I8.i3.p1.1" class="ltx_p"><span id="S16.I8.i3.p1.1.1" class="ltx_text ltx_font_bold">(The complex index bundle)</span> For each <math id="S16.I8.i3.p1.m1" class="ltx_math_unparsed" alttext="\widetilde{x}=(\widetilde{\phi},\widetilde{u},e,F)\in\partial^{+}\widetilde{B}_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo>=</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover><mo>,</mo><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo>,</mo><mi>e</mi><mo>,</mo><mi>F</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">∈</mo><msup><mo>∂</mo><mo>+</mo></msup><msubsup><mover accent="true"><mi>B</mi><mo>~</mo></mover><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow><mi>𝕏</mi></msubsup></mrow><annotation encoding="application/x-tex">\widetilde{x}=(\widetilde{\phi},\widetilde{u},e,F)\in\partial^{+}\widetilde{B}_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}</annotation></semantics></math>, with respect to the decomposition</p>
<table id="S16.Ex87" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S16.Ex87.m1" class="ltx_math_unparsed" alttext="\widetilde{\nu}_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}=\left[\begin{array}[]{ccc}0&amp;\nu_{\widetilde{x}}&amp;0\\
0&amp;0&amp;\nu_{p^{\prime}}\end{array}\right]" display="block" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>ν</mi><mo>~</mo></mover><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow><mi>𝕏</mi></msubsup><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd><mn>0</mn></mtd><mtd><msub><mi>ν</mi><mover accent="true"><mi>x</mi><mo>~</mo></mover></msub></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><msub><mi>ν</mi><msup><mi>p</mi><mo>′</mo></msup></msub></mtd></mtr></mtable><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\nu}_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}=\left[\begin{array}[]{ccc}0&amp;\nu_{\widetilde{x}}&amp;0\\
0&amp;0&amp;\nu_{p^{\prime}}\end{array}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S16.I8.i3.p1.2" class="ltx_p">where</p>
<table id="S16.Ex88" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S16.Ex88.m1" class="ltx_math_unparsed" alttext="\nu_{\widetilde{x}}:W_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}\to\Omega_{c}^{0,1}(C_{\phi},u^{*}TX)" display="block" intent=":literal"><semantics><mrow><msub><mi>ν</mi><mover accent="true"><mi>x</mi><mo>~</mo></mover></msub><mo lspace="0.278em" rspace="0.278em">:</mo><msubsup><mi>W</mi><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow><mi>𝕏</mi></msubsup><mo stretchy="false">→</mo><msubsup><mi mathvariant="normal">Ω</mi><mi>c</mi><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mi>ϕ</mi></msub><mo>,</mo><msup><mi>u</mi><mo>∗</mo></msup><mi>T</mi><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nu_{\widetilde{x}}:W_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}\to\Omega_{c}^{0,1}(C_{\phi},u^{*}TX)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S16.I8.i3.p1.3" class="ltx_p">is a complex-linear map.</p>
</div></li>
<li id="S16.I8.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S16.I8.i4.p1" class="ltx_para ltx_noindent">
<p id="S16.I8.i4.p1.1" class="ltx_p"><span id="S16.I8.i4.p1.1.1" class="ltx_text ltx_font_bold">(Flow multimodule structure I)</span> For each <math id="S16.I8.i4.p1.m1" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> and <math id="S16.I8.i4.p1.m2" class="ltx_Math" alttext="p_{j}&lt;q_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>j</mi></msub><mo>&lt;</mo><msub><mi>q</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">p_{j}&lt;q_{j}</annotation></semantics></math>, the above conditions induces the following bundle maps</p>
<table id="S16.Ex89" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S16.Ex89.m1" class="ltx_math_unparsed" alttext="\underline{\smash{R}}_{p_{j}}^{+}\oplus\underline{\smash{W}}_{p_{j}q_{j}}\oplus\underline{\smash{R}}_{q_{j}}^{+}\oplus\underline{\smash{W}}_{p_{1}\cdots p_{j-1}q_{j}p_{j+1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}\oplus\underline{\smash{R}}_{p^{\prime}}^{+}\to\widetilde{V}_{p_{1}\cdots p_{j-1}(p_{j}q_{j})p_{j+1}\cdots p_{m};p^{\prime}}." display="block" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>R</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><msub><mi>p</mi><mi>j</mi></msub></msub><msup><mrow></mrow><mo>+</mo></msup><mo>⊕</mo><munder accentunder="true"><mi>W</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mrow><msub><mi>p</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>j</mi></msub></mrow></msub><mo>⊕</mo><munder accentunder="true"><mi>R</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><msub><mi>q</mi><mi>j</mi></msub></msub><msup><mrow></mrow><mo>+</mo></msup><mo>⊕</mo><munder accentunder="true"><mi>W</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mi>q</mi><msub><mrow></mrow><mi>j</mi></msub><mi>p</mi><msub><mrow></mrow><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo>⊕</mo><munder accentunder="true"><mi>R</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><msup><mi>p</mi><mo>′</mo></msup></msub><msup><mrow></mrow><mo>+</mo></msup><mo stretchy="false">→</mo><mover accent="true"><mi>V</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi>p</mi><msub><mrow></mrow><mi>j</mi></msub><mi>q</mi><msub><mrow></mrow><mi>j</mi></msub><mo stretchy="false">)</mo><mi>p</mi><msub><mrow></mrow><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\underline{\smash{R}}_{p_{j}}^{+}\oplus\underline{\smash{W}}_{p_{j}q_{j}}\oplus\underline{\smash{R}}_{q_{j}}^{+}\oplus\underline{\smash{W}}_{p_{1}\cdots p_{j-1}q_{j}p_{j+1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}\oplus\underline{\smash{R}}_{p^{\prime}}^{+}\to\widetilde{V}_{p_{1}\cdots p_{j-1}(p_{j}q_{j})p_{j+1}\cdots p_{m};p^{\prime}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
