 -33.208800332088 L 0.27673578005007266 -33.208800332088" fill="none" stroke="#000000"></path><g transform="translate(42.87,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.23em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="17.03"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex22.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{F_{1}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\textstyle{F_{1}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 55.25383395707936 -9.685900096859001 L 55.8073055171795 -9.685900096859001" fill="none" stroke="#000000"></path><g transform="translate(55.53,0) translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 55.25383395707936 -33.208800332088 L 55.8073055171795 -9.685900096859001" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 55.25383395707936 -33.208800332088 L 55.8073055171795 -33.208800332088" fill="none" stroke="#000000"></path><g transform="translate(-9.66,0) translate(0,-43.36) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.8em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="11.01"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex22.m1.pic1.m5" class="ltx_Math" alttext="\textstyle{E\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">\textstyle{E\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 9.657058937512971 -43.63264139549389 L 9.657058937512971 -43.07916983539375" fill="none" stroke="#000000"></path><g transform="translate(18.36,0) translate(0,-50.28) translate(4.15,0) translate(0,-1.39)"><foreignObject style="--ltx-fo-width:0.76em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.1em;font-size:10pt;" height="5.55" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="10.5"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex22.m1.pic1.m6" class="ltx_Math" alttext="\scriptstyle{\tau_{2}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">τ</mi><mn mathsize="0.710em">2</mn></msub><annotation encoding="application/x-tex">\scriptstyle{\tau_{2}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(42.87,0) translate(0,-43.36)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 9.657058937512971 -43.63264139549389 L 42.865859269600975 -43.07916983539375" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 42.865859269600975 -43.63264139549389 L 42.865859269600975 -43.07916983539375" fill="none" stroke="#000000"></path><g transform="translate(42.87,0) translate(0,-43.36) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.23em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="17.03"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex22.m1.pic1.m7" class="ltx_Math" alttext="\textstyle{F_{2}}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\textstyle{F_{2}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
