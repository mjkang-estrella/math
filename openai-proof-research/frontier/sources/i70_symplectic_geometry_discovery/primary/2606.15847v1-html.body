<semantics><msub><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mi>i</mi></msub><annotation encoding="application/x-tex">\tilde{\mathbb{F}}_{i}</annotation></semantics></math><span id="S8.I2.i2.p1.2.18" class="ltx_text ltx_font_italic"> resp. </span><math id="S8.I2.i2.p1.m22" class="ltx_Math" alttext="\tilde{\mathbb{F}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mo>′</mo></msup><annotation encoding="application/x-tex">\tilde{\mathbb{F}}^{\prime}</annotation></semantics></math><span id="S8.I2.i2.p1.2.19" class="ltx_text ltx_font_italic"> such that </span><math id="S8.I2.i2.p1.m23" class="ltx_math_unparsed" alttext="\mathring{\mathbb{F}}_{1}\times\cdots\times\mathring{\mathbb{F}}_{m}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><msub><mrow></mrow><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">\mathring{\mathbb{F}}_{1}\times\cdots\times\mathring{\mathbb{F}}_{m}</annotation></semantics></math><span id="S8.I2.i2.p1.2.20" class="ltx_text ltx_font_italic"> resp. </span><math id="S8.I2.i2.p1.m24" class="ltx_Math" alttext="\mathring{\mathbb{F}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><mo>′</mo></msup><annotation encoding="application/x-tex">\mathring{\mathbb{F}}^{\prime}</annotation></semantics></math><span id="S8.I2.i2.p1.2.21" class="ltx_text ltx_font_italic"> is also </span><math id="S8.I2.i2.p1.m25" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math><span id="S8.I2.i2.p1.2.22" class="ltx_text ltx_font_italic">-equivariant. Then there exists a </span><math id="S8.I2.i2.p1.