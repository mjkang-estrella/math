class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">⋊</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">\mathbb{\Pi}^{\prime}\rtimes G</annotation></semantics></math><span id="S8.I2.i2.p1.2.9" class="ltx_text ltx_font_italic">-equivariant flow category enriched in </span><math id="S8.I2.i2.p1.m13" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>NC</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}</annotation></semantics></math><span id="S8.I2.i2.p1.2.10" class="ltx_text ltx_font_italic">. Let </span><math id="S8.I2.i2.p1.m14" class="ltx_Math" alttext="\tilde{\mathbb{X}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝕏</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{X}}</annotation></semantics></math><span id="S8.I2.i2.p1.2.11" class="ltx_text ltx_font_italic"> be a </span><math id="S8.I2.i2.p1.m15" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math><span id="S8.I2.i2.p1.2.12" class="ltx_text ltx_font_italic">-equivariant multimodule over </span><math id="S8.I2.i2.p1.m16" class="ltx_Math" alttext="(\tilde{\mathbb{F}}_{1},\ldots,\tilde{\mathbb{F}}_{m};\tilde{\mathbb{F}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mi>m</mi></msub><mo>,</mo><msup>