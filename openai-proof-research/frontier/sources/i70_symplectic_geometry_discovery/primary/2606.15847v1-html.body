tation></semantics></math></span></span></foreignObject></g><g transform="translate(45.97,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 12.760798400313062 -0.27673578005007266 L 45.96957761881443 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 45.96957761881443 -0.27673578005007266 L 45.96957761881443 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -9.685900096859001 L 0.27673578005007266 -9.685900096859001" fill="none" stroke="#000000"></path><g transform="translate(-14.78,0) translate(0,-21.68) translate(4.15,0) translate(0,-2.42)"><foreignObject style="--ltx-fo-width:0.47em;--ltx-fo-height:0.49em;--ltx-fo-depth:0.14em;font-size:10pt;" height="8.61" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="6.48"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex15.m1.pic1.m3" class="ltx_Math" alttext="\scriptstyle{f}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">f</mi><annotation encoding="application/x-tex">\scriptstyle{f}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.208800332088 L 0.27673578005007266 -9.685900096859001" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.208800332088 L 0.27673578005007266 -33.208800332088" fill="none" stroke="#000000"></path><g transform="translate(45.97,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.23em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="17.03"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex15.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{F_{1}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\textstyle{F_{1}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 58.35755230629281 -9.685900096859001 L 58.91102386639295 -9.685900096859001" fill="none" stroke="#000000"></path><g transform="translate(58.63,0) translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 58.35755230629281 -33.208800332088 L 58.91102386639295 -9.685900096859001" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 58.35755230629281 -33.208800332088 L 58.91102386639295 -33.208800332088" fill="none" stroke="#000000"></path><g transform="translate(-12.76,0) translate(0,-43.36) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.24em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="17.22"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex15.m1.pic1.m5" class="ltx_Math" alttext="\textstyle{E_{2}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\textstyle{E_{2}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 12.760798400313062 -43.63264139549389 L 12.760798400313062 -43.07916983539375" fill="none" stroke="#000000"></path><g transform="translate(19.91,0) translate(0,-50.28) translate(4.15,0) translate(0,-1.39)"><foreignObject style="--ltx-fo-width:0.76em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.1em;font-size:10pt;" height="5.55" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="10.5"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex15.m1.pic1.m6" class="ltx_Math" alttext="\scriptstyle{\tau_{2}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">τ</mi><mn mathsize="0.710em">2</mn></msub><annotation encoding="application/x-tex">\scriptstyle{\tau_{2}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(45.97,0) translate(0,-43.36)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 12.760798400313062 -43.63264139549389 L 45.96957761881443 -43.07916983539375" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 45.96957761881443 -43.63264139549389 L 45.96957761881443 -43.07916983539375" fill="none" stroke="#000000"></path><g transform="translate(45.97,0) translate(0,-43.36) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.23em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="17.03"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex15.m1.pic1.m7" class="ltx_Math" alttext="\textstyle{F_{2}}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\textstyle{F_{2}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I5.i2.p1.2" class="ltx_p">where the right vertical arrow is a <math id="S3.I5.i2.p1.m10" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant complex stable (iso)morphism.</p>
</div></li>
<li id="S3.I5.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S3.I5.i3.p1" class="ltx_para">
<p id="S3.I5.i3.p1.1" class="ltx_p">Let <math id="S3.I5.i3.p1.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> be a smooth <math id="S3.I5.i3.p1.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-manifold (with boundary and corners). A <math id="S3.I5.i3.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant stable complex structure on <math id="S3.I5.i3.p1.m4" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> is a <math id="S3.I5.i3.p1.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant stable complex structure on <math id="S3.I5.i3.p1.m6" class="ltx_Math" alttext="TV" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">TV</annotation></semantics></math>. Notice that for each stratum <math id="S3.I5.i3.p1.m7" class="ltx_Math" alttext="\partial^{\alpha}V\subseteq V" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mo>∂</mo><mi>α</mi></msup><mi>V</mi></mrow><mo>⊆</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">\partial^{\alpha}V\subseteq V</annotation></semantics></math>, the stable complex structure on <math id="S3.I5.i3.p1.m8" class="ltx_Math" alttext="TV" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">TV</annotation></semantics></math> induces a stable complex structure on <math id="S3.I5.i3.p1.m9" class="ltx_Math" alttext="T(\partial^{\alpha}V)" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">∂</mo><mi>α</mi></msup><mi>V</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T(\partial^{\alpha}V)</annotation></semantics></math> because the normal direction is trivial.</p>
</div></li>
</ol>
</div>
</div>
<div id="S3.SS3.SSS2.p1" class="ltx_para ltx_noindent">
<p id="S3.SS3.SSS2.p1.1" class="ltx_p">Now we consider smooth Kuranishi space <math id="S3.SS3.SSS2.p1.m1" class="ltx_Math" alttext="K=(G,V,E,S)" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo>,</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K=(G,V,E,S)</annotation></semantics></math> such that the <math id="S3.SS3.SSS2.p1.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-action on <math id="S3.SS3.SSS2.p1.m3" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> has only finite stabilizers. In this setting, <math id="S3.SS3.SSS2.p1.m4" class="ltx_Math" alttext="TV" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">TV</annotation></semantics></math> contains a trivial subbundle isomorphic to <math id="S3.SS3.SSS2.p1.m5" class="ltx_Math" alttext="\underline{\smash{\mathfrak{g}}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝔤</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\mathfrak{g}}}</annotation></semantics></math>. On the other hand, in our construction, the obstruction bundle <math id="S3.SS3.SSS2.p1.m6" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> can always be made complex. This simplifies the definition of stable complex structures.</p>
</div>
<div id="S3.Thmthm18" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm18.2" class="ltx_text ltx_font_bold">Definition 3.18</span></span><span id="S3.Thmthm18.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm18.p1" class="ltx_para ltx_noindent">
<p id="S3.Thmthm18.p1.1" class="ltx_p">A <span id="S3.Thmthm18.p1.1.1" class="ltx_text ltx_font_bold">stably complex Kuranishi space</span> is a smooth Kuranishi space <math id="S3.Thmthm18.p1.m1" class="ltx_Math" alttext="K=(G,V,E,S)" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo>,</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K=(G,V,E,S)</annotation></semantics></math> equipped with a <math id="S3.Thmthm18.p1.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant complex structure on <math id="S3.Thmthm18.p1.m3" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> and a <math id="S3.Thmthm18.p1.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant stable complex structure on <math id="S3.Thmthm18.p1.m5" class="ltx_Math" alttext="TV/\underline{\smash{\mathfrak{g}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>/</mo><munder accentunder="true"><mi>𝔤</mi><mo stretchy="true">¯</mo></munder></mrow><annotation encoding="application/x-tex">TV/\underline{\smash{\mathfrak{g}}}</annotation></semantics></math>.</p>
</div>
<div id="S3.Thmthm18.p2" class="ltx_para ltx_noindent">
<p id="S3.Thmthm18.p2.1" class="ltx_p">An <span id="S3.Thmthm18.p2.1.1" class="ltx_text ltx_font_bold">open embedding</span> of stably complex Kuranishi spaces from <math id="S3.Thmthm18.p2.m1" class="ltx_Math" alttext="K_{1}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mn>1</mn></msub><annotation encoding="application/x-tex">K_{1}</annotation></semantics></math> to <math id="S3.Thmthm18.p2.m2" class="ltx_Math" alttext="K_{2}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mn>2</mn></msub><annotation encoding="application/x-tex">K_{2}</annotation></semantics></math> is a smooth open embedding <math id="S3.Thmthm18.p2.m3" class="ltx_Math" alttext="\iota_{21}:K_{1}\to K_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ι</mi><mn>21</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>K</mi><mn>1</mn></msub><mo stretchy="false">→</mo><msub><mi>K</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\iota_{21}:K_{1}\to K_{2}</annotation></semantics></math> such that 1) the vector bundle isomorphism</p>
<table id="S3.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex16.m1" class="ltx_Math" alttext="d\iota_{21}^{V}:TV_{1}/\underline{\smash{\mathfrak{g}}}_{1}\to TV_{2}/\underline{\smash{\mathfrak{g}}}_{2}" display="block" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ι</mi><mn>21</mn><mi>V</mi></msubsup></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mn>1</mn></msub></mrow><mo>/</mo><msub><munder accentunder="true"><mi>𝔤</mi><mo stretchy="true">¯</mo></munder><mn>1</mn></msub></mrow><mo stretchy="false">→</mo><mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mn>2</mn></msub></mrow><mo>/</mo><msub><munder accentunder="true"><mi>𝔤</mi><mo stretchy="true">¯</mo></munder><mn>2</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">d\iota_{21}^{V}:TV_{1}/\underline{\smash{\mathfrak{g}}}_{1}\to TV_{2}/\underline{\smash{\mathfrak{g}}}_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm18.p2.2" class="ltx_p">is stably complex and 2) the vector bundle isomorphism <math id="S3.Thmthm18.p2.m4" class="ltx_Math" alttext="\iota_{21}^{E}:E_{1}\to E_{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ι</mi><mn>21</mn><mi>E</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>E</mi><mn>1</mn></msub><mo stretchy="false">→</mo><msub><mi>E</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\iota_{21}^{E}:E_{1}\to E_{2}</annotation></semantics></math> is complex linear.</p>
</div>
</div>
<div id="S3.SS3.SSS2.p2" class="ltx_para ltx_noindent">
<p id="S3.SS3.SSS2.p2.1" class="ltx_p">We consider stabilizations of a stably complex Kuranishi space <math id="S3.SS3.SSS2.p2.m1" class="ltx_Math" alttext="K=(G,V,E,S)" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo>,</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K=(G,V,E,S)</annotation></semantics></math> by a disk bundle <math id="S3.SS3.SSS2.p2.m2" class="ltx_Math" alttext="\pi_{D}:D\to V" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>D</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>D</mi><mo stretchy="false">→</mo><mi>V</mi></mrow></mrow><annotation encoding="application/x-tex">\pi_{D}:D\to V</annotation></semantics></math> contained in a <math id="S3.SS3.SSS2.p2.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant complex vector bundle <math id="S3.SS3.SSS2.p2.m4" class="ltx_Math" alttext="N\to V" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo stretchy="false">→</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">N\to V</annotation></semantics></math>, which is</p>
<table id="S3.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex17.m1" class="ltx_Math" alttext="{\rm Stab}_{D}(K)=(G,D,\pi_{D}^{*}E\oplus\pi_{D}^{*}N,\pi_{D}^{*}S\oplus\tau_{N})" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>Stab</mi><mi>D</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>D</mi><mo>,</mo><mrow><mrow><msubsup><mi>π</mi><mi>D</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow><mo>⊕</mo><mrow><msubsup><mi>π</mi><mi>D</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow><mo>,</mo><mrow><mrow><msubsup><mi>π</mi><mi>D</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>⊕</mo><msub><mi>τ</mi><mi>N</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\rm Stab}_{D}(K)=(G,D,\pi_{D}^{*}E\oplus\pi_{D}^{*}N,\pi_{D}^{*}S\oplus\tau_{N})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.SSS2.p2.2" class="ltx_p">Then <math id="S3.SS3.SSS2.p2.m5" class="ltx_Math" alttext="\pi_{D}^{*}E\oplus\pi_{D}^{*}N" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>π</mi><mi>D</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow><mo>⊕</mo><mrow><msubsup><mi>π</mi><mi>D</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow><annotation encoding="application/x-tex">\pi_{D}^{*}E\oplus\pi_{D}^{*}N</annotation></semantics></math> carries a canonical complex structure. On the other hand, the bundle <math id="S3.SS3.SSS2.p2.m6" class="ltx_Math" alttext="TD/\underline{\smash{\mathfrak{g}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><mo>/</mo><munder accentunder="true"><mi>𝔤</mi><mo stretchy="true">¯</mo></munder></mrow><annotation encoding="application/x-tex">TD/\underline{\smash{\mathfrak{g}}}</annotation></semantics></math> is non-canonically isomorphic to <math id="S3.SS3.SSS2.p2.m7" class="ltx_Math" alttext="\pi_{D}^{*}TV/\underline{\smash{\mathfrak{g}}}\oplus\pi_{D}^{*}N" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>π</mi><mi>D</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi></mrow><mo>/</mo><munder accentunder="true"><mi>𝔤</mi><mo stretchy="true">¯</mo></munder></mrow><mo>⊕</mo><mrow><msubsup><mi>π</mi><mi>D</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow><annotation encoding="application/x-tex">\pi_{D}^{*}TV/\underline{\smash{\mathfrak{g}}}\oplus\pi_{D}^{*}N</annotation></semantics></math>. An isomorphism can be induced from a <math id="S3.SS3.SSS2.p2.m8" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant connection on the fiber bundle <math id="S3.SS3.SSS2.p2.m9" class="ltx_Math" alttext="D\to V" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo stretchy="false">→</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">D\to V</annotation></semantics></math>.</p>
</div>
<div id="S3.Thmthm19" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm19.2" class="ltx_text ltx_font_bold">Definition 3.19</span></span><span id="S3.Thmthm19.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm19.p1" class="ltx_para">
<p id="S3.Thmthm19.p1.1" class="ltx_p">The <span id="S3.Thmthm19.p1.1.1" class="ltx_text ltx_font_bold">stabilization</span> of a stably complex Kuranishi space <math id="S3.Thmthm19.p1.m1" class="ltx_Math" alttext="K=(G,V,E,S)" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo>,</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K=(G,V,E,S)</annotation></semantics></math> by a disk bundle <math id="S3.Thmthm19.p1.m2" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> contained in a <math id="S3.Thmthm19.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant complex vector bundle <math id="S3.Thmthm19.p1.m4" class="ltx_Math" alttext="N\to V" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo stretchy="false">→</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">N\to V</annotation></semantics></math> (equipped with a <math id="S3.Thmthm19.p1.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant complex linear connection) is the smooth stabilization <math id="S3.Thmthm19.p1.m6" class="ltx_Math" alttext="{\rm Stab}_{D}(K)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Stab</mi><mi>D</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\rm Stab}_{D}(K)</annotation></semantics></math> with the induced stably complex structure on <math id="S3.Thmthm19.p1.m7" class="ltx_Math" alttext="TD/\underline{\smash{\mathfrak{g}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><mo>/</mo><munder accentunder="true"><mi>𝔤</mi><mo stretchy="true">¯</mo></munder></mrow><annotation encoding="application/x-tex">TD/\underline{\smash{\mathfrak{g}}}</annotation></semantics></math> and the complex structure on <math id="S3.Thmthm19.p1.m8" class="ltx_Math" alttext="\pi_{D}^{*}E\oplus\pi_{D}^{*}N" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>π</mi><mi>D</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow><mo>⊕</mo><mrow><msubsup><mi>π</mi><mi>D</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow><annotation encoding="application/x-tex">\pi_{D}^{*}E\oplus\pi_{D}^{*}N</annotation></semantics></math>.</p>
</div>
</div>
<div id="S3.Thmthm20" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm20.2" class="ltx_text ltx_font_bold">Definition 3.20</span></span><span id="S3.Thmthm20.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm20.p1" class="ltx_para ltx_noindent">
<p id="S3.Thmthm20.p1.1" class="ltx_p">A <span id="S3.Thmthm20.p1.1.1" class="ltx_text ltx_font_bold">strict embedding</span> of stably complex Kuranishi spaces from <math id="S3.Thmthm20.p1.m1" class="ltx_Math" alttext="K_{1}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mn>1</mn></msub><annotation encoding="application/x-tex">K_{1}</annotation></semantics></math> to <math id="S3.Thmthm20.p1.m2" class="ltx_Math" alttext="K_{2}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mn>2</mn></msub><annotation encoding="application/x-tex">K_{2}</annotation></semantics></math> consists of a smooth strict embedding <math id="S3.Thmthm20.p1.m3" class="ltx_Math" alttext="\iota_{21}:K_{1}\to K_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ι</mi><mn>21</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>K</mi><mn>1</mn></msub><mo stretchy="false">→</mo><msub><mi>K</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\iota_{21}:K_{1}\to K_{2}</annotation></semantics></math> such that in the diagram (<a href="#S3.E1" title="In Definition 3.7 (Morphisms of Kuranishi spaces). ‣ 3.1.1. Morphisms of Kuranishi spaces ‣ 3.1. Kuranishi spaces ‣ 3. Kuranishi Spaces ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>), the stabilization <math id="S3.Thmthm20.p1.m4" class="ltx_Math" alttext="\iota_{a}:K_{1}\to K_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ι</mi><mi>a</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>K</mi><mn>1</mn></msub><mo stretchy="false">→</mo><msub><mi>K</mi><mn>3</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\iota_{a}:K_{1}\to K_{3}</annotation></semantics></math> is provided by a disk bundle in a complex vector bundle and the open embedding <math id="S3.Thmthm20.p1.m5" class="ltx_Math" alttext="\iota_{c}:K_{4}\to K_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ι</mi><mi>c</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>K</mi><mn>4</mn></msub><mo stretchy="false">→</mo><msub><mi>K</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\iota_{c}:K_{4}\to K_{2}</annotation></semantics></math> is an open embedding of stably complex Kuranishi spaces.</p>
</div>
<div id="S3.Thmthm20.p2" class="ltx_para">
<p id="S3.Thmthm20.p2.1" class="ltx_p">An <span id="S3.Thmthm20.p2.1.1" class="ltx_text ltx_font_bold">embedding</span> of stably complex Kuranishi spaces is a conjugacy class of strict embeddings.</p>
</div>
</div>
<div id="S3.Thmthm21" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm21.2" class="ltx_text ltx_font_bold">Lemma 3.21</span></span><span id="S3.Thmthm21.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm21.p1" class="ltx_para">
<p id="S3.Thmthm21.p1.1" class="ltx_p"><span id="S3.Thmthm21.p1.1.1" class="ltx_text ltx_font_italic">(Strict) embeddings of stably complex Kuranishi spaces can be composed.</span></p>
</div>
</div>
<div id="S3.SS3.SSS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS3.SSS2.p3" class="ltx_para">
<p id="S3.SS3.SSS2.p3.1" class="ltx_p"><span id="S3.SS3.SSS2.p3.1.1" class="ltx_text">Essentially one needs to consider disk bundles over disk bundles to ensure the compatibility of stable complex structures. Given Ehresmann connections on <math id="S3.SS3.SSS2.p3.m1" class="ltx_Math" alttext="D_{21}\to V_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mn>21</mn></msub><mo stretchy="false">→</mo><msub><mi>V</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">D_{21}\to V_{1}</annotation></semantics></math> and <math id="S3.SS3.SSS2.p3.m2" class="ltx_Math" alttext="D_{32}\to V_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mn>32</mn></msub><mo stretchy="false">→</mo><msub><mi>V</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">D_{32}\to V_{2}</annotation></semantics></math>, the horizontal distribution of <math id="S3.SS3.SSS2.p3.m3" class="ltx_Math" alttext="D_{21}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mn>21</mn></msub><annotation encoding="application/x-tex">D_{21}</annotation></semantics></math> can then be lifted to <math id="S3.SS3.SSS2.p3.m4" class="ltx_Math" alttext="D_{32}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mn>32</mn></msub><annotation encoding="application/x-tex">D_{32}</annotation></semantics></math>, giving a Ehresmann connection on the iterated bundle.
∎</span></p>
</div>
</div>
<div id="S3.Thmthm22" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm22.2" class="ltx_text ltx_font_italic">Remark 3.22</span></span><span id="S3.Thmthm22.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S3.Thmthm22.p1" class="ltx_para ltx_noindent">
<p id="S3.Thmthm22.p1.1" class="ltx_p">We could define the category</p>
<table id="S3.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex18.m1" class="ltx_Math" alttext="\underline{\smash{\bf SKur}}^{\mathbb{C}}" display="block" intent=":literal"><semantics><msup><munder accentunder="true"><mi>𝐒𝐊𝐮𝐫</mi><mo stretchy="true">¯</mo></munder><mi>ℂ</mi></msup><annotation encoding="application/x-tex">\underline{\smash{\bf SKur}}^{\mathbb{C}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm22.p1.2" class="ltx_p">whose objects are regularly stratified stably complex (in particular, smooth) Kuranishi spaces and whose morphisms are embeddings. It is easy to see that this is a regular stratification category, and there is a natural forgetful functor</p>
<table id="S3.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex19.m1" class="ltx_Math" alttext="\underline{\smash{\bf SKur}}^{\mathbb{C}}\to\underline{\smash{\bf SKur}}." display="block" intent=":literal"><semantics><mrow><mrow><msup><munder accentunder="true"><mi>𝐒𝐊𝐮𝐫</mi><mo stretchy="true">¯</mo></munder><mi>ℂ</mi></msup><mo stretchy="false">→</mo><munder accentunder="true"><mi>𝐒𝐊𝐮𝐫</mi><mo stretchy="true">¯</mo></munder></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\underline{\smash{\bf SKur}}^{\mathbb{C}}\to\underline{\smash{\bf SKur}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm22.p1.3" class="ltx_p">One can also consider the rigidified version. However, it is rather complicated to obtain stably complex Kuranishi spaces in our construction (although we could). Below we consider a more flexible one using normal complex structures, which suffices for our purpose.</p>
</div>
</div>
</section>
<section id="S3.SS3.SSS3" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">3.3.3. </span>Normally complex Kuranishi spaces</h5>

<div id="S3.SS3.SSS3.p1" class="ltx_para ltx_noindent">
<p id="S3.SS3.SSS3.p1.1" class="ltx_p">Moduli spaces of pseudoholomorphic curves admit stable complex structure because of the nature of the Cauchy–Riemann operator. In Section <a href="#S16" title="16. Vertical Normal Complex Structures and orientations ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a> we will follow the strategy of Abouzaid–Blumberg <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib60" title="" class="ltx_ref">1</a>, <a href="#bib.bib1" title="" class="ltx_ref">2</a>]</cite> to do the explicit construction. However, it is a bit cumbersome to construct stable complex structures compatibly. Instead, we will only construct the normal complex structure which is sufficient for our applications and where the compatibility is easier to achieve.</p>
</div>
<div id="S3.SS3.SSS3.p2" class="ltx_para ltx_noindent">
<p id="S3.SS3.SSS3.p2.1" class="ltx_p">Let <math id="S3.SS3.SSS3.p2.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> be a <math id="S3.SS3.SSS3.p2.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-space. Notice that a stable morphism of <math id="S3.SS3.SSS3.p2.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant vector bundles <math id="S3.SS3.SSS3.p2.m4" class="ltx_Math" alttext="E,F\to V" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>,</mo><mrow><mi>F</mi><mo stretchy="false">→</mo><mi>V</mi></mrow></mrow><annotation encoding="application/x-tex">E,F\to V</annotation></semantics></math> (Definition <a href="#S3.Thmthm16" title="Definition 3.16. ‣ 3.3.1. Stable morphisms of vector bundles ‣ 3.3. Stable complex structures and normal complex structures ‣ 3. Kuranishi Spaces ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.16</span></a>) induces the following well-defined linear maps. For each <math id="S3.SS3.SSS3.p2.m5" class="ltx_Math" alttext="x\in V" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">x\in V</annotation></semantics></math>, let <math id="S3.SS3.SSS3.p2.m6" class="ltx_Math" alttext="G_{x}\subseteq G" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mi>x</mi></msub><mo>⊆</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">G_{x}\subseteq G</annotation></semantics></math> be the stabilizer. Then the fibers <math id="S3.SS3.SSS3.p2.m7" class="ltx_Math" alttext="E_{x}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>x</mi></msub><annotation encoding="application/x-tex">E_{x}</annotation></semantics></math> and <math id="S3.SS3.SSS3.p2.m8" class="ltx_Math" alttext="F_{x}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>x</mi></msub><annotation encoding="application/x-tex">F_{x}</annotation></semantics></math> split as</p>
<table id="S3.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex20.m1" class="ltx_Math" alttext="\displaystyle\ E_{x}=\mathring{E}_{x}\oplus\check{E}_{x},\ " display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>E</mi><mi>x</mi></msub><mo>=</mo><mrow><msub><mover accent="true"><mi>E</mi><mo>̊</mo></mover><mi>x</mi></msub><mo>⊕</mo><msub><mover accent="true"><mi>E</mi><mo>ˇ</mo></mover><mi>x</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ E_{x}=\mathring{E}_{x}\oplus\check{E}_{x},\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex20.m2" class="ltx_Math" alttext="\displaystyle\ F_{x}=\mathring{F}_{x}\oplus\check{F}_{x}" display="inline" intent=":literal"><semantics><mrow><msub><mi>F</mi><mi>x</mi></msub><mo>=</mo><mrow><msub><mover accent="true"><mi>F</mi><mo>̊</mo></mover><mi>x</mi></msub><mo>⊕</mo><msub><mover accent="true"><mi>F</mi><mo>ˇ</mo></mover><mi>x</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ F_{x}=\mathring{F}_{x}\oplus\check{F}_{x}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.SSS3.p2.2" class="ltx_p">where <math id="S3.SS3.SSS3.p2.m9" class="ltx_Math" alttext="\mathring{E}_{x}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>E</mi><mo>̊</mo></mover><mi>x</mi></msub><annotation encoding="application/x-tex">\mathring{E}_{x}</annotation></semantics></math>, <math id="S3.SS3.SSS3.p2.m10" class="ltx_Math" alttext="\mathring{F}_{x}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>F</mi><mo>̊</mo></mover><mi>x</mi></msub><annotation encoding="application/x-tex">\mathring{F}_{x}</annotation></semantics></math> are <math id="S3.SS3.SSS3.p2.m11" class="ltx_Math" alttext="G_{x}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>x</mi></msub><annotation encoding="application/x-tex">G_{x}</annotation></semantics></math>-trivial summands and <math id="S3.SS3.SSS3.p2.m12" class="ltx_Math" alttext="\check{E}_{x}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>E</mi><mo>ˇ</mo></mover><mi>x</mi></msub><annotation encoding="application/x-tex">\check{E}_{x}</annotation></semantics></math>, <math id="S3.SS3.SSS3.p2.m13" class="ltx_Math" alttext="\check{F}_{x}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>F</mi><mo>ˇ</mo></mover><mi>x</mi></msub><annotation encoding="application/x-tex">\check{F}_{x}</annotation></semantics></math> are <math id="S3.SS3.SSS3.p2.m14" class="ltx_Math" alttext="G_{x}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>x</mi></msub><annotation encoding="application/x-tex">G_{x}</annotation></semantics></math>-nontrivial pieces. Then an equivalence class of stable isomorphisms induces well-defined <math id="S3.SS3.SSS3.p2.m15" class="ltx_Math" alttext="G_{x}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>x</mi></msub><annotation encoding="application/x-tex">G_{x}</annotation></semantics></math>-equivariant maps</p>
<table id="S3.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex21.m1" class="ltx_Math" alttext="\check{\tau}_{x}:\check{E}_{x}\to\check{F}_{x}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>τ</mi><mo>ˇ</mo></mover><mi>x</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mover accent="true"><mi>E</mi><mo>ˇ</mo></mover><mi>x</mi></msub><mo stretchy="false">→</mo><msub><mover accent="true"><mi>F</mi><mo>ˇ</mo></mover><mi>x</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\check{\tau}_{x}:\check{E}_{x}\to\check{F}_{x}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.SSS3.p2.3" class="ltx_p">(In particular, if <math id="S3.SS3.SSS3.p2.m16" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> is trivial, the maps <math id="S3.SS3.SSS3.p2.m17" class="ltx_Math" alttext="\check{\tau}_{x}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>τ</mi><mo>ˇ</mo></mover><mi>x</mi></msub><annotation encoding="application/x-tex">\check{\tau}_{x}</annotation></semantics></math> are all trivial.)</p>
</div>
<div id="S3.Thmthm23" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm23.2" class="ltx_text ltx_font_bold">Definition 3.23</span></span><span id="S3.Thmthm23.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm23.p1" class="ltx_para ltx_noindent">
<p id="S3.Thmthm23.p1.1" class="ltx_p">Let <math id="S3.Thmthm23.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> be a Lie group, <math id="S3.Thmthm23.p1.m2" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> be a <math id="S3.Thmthm23.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-space, and <math id="S3.Thmthm23.p1.m4" class="ltx_Math" alttext="E\to V" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo stretchy="false">→</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">E\to V</annotation></semantics></math> be a <math id="S3.Thmthm23.p1.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant vector bundle.</p>
<ol id="S3.I6" class="ltx_enumerate">
<li id="S3.I6.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S3.I6.i1.p1" class="ltx_para ltx_noindent">
<p id="S3.I6.i1.p1.1" class="ltx_p">Two stable complex structures on <math id="S3.I6.i1.p1.m1" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>, represented by <math id="S3.I6.i1.p1.m2" class="ltx_Math" alttext="(\tau_{1},F_{1})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>F</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\tau_{1},F_{1})</annotation></semantics></math> and <math id="S3.I6.i1.p1.m3" class="ltx_Math" alttext="(\tau_{2},F_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mn>2</mn></msub><mo>,</mo><msub><mi>F</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\tau_{2},F_{2})</annotation></semantics></math>, are <span id="S3.I6.i1.p1.1.1" class="ltx_text ltx_font_bold">normally equivalent</span>, if there exists a diagram of stable isomorphisms</p>
<table id="S3.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
