gnorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 52.39087pt\raise 6.15pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-1.75pt\hbox{$\scriptstyle{\cong}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 85.01587pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 55.01587pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.55554pt\hbox{$\textstyle{}$}}}}}}}{\hbox{\kern 85.01587pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.55554pt\hbox{$\textstyle{{\rm Stab}_{D_{32}}({\rm Stab}_{D_{21}}(K_{1}))\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 193.091pt\raise 6.68332pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-1.17778pt\hbox{$\scriptstyle{{\rm Stab}_{D_{32}}\theta_{21}}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 243.38492pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 213.38492pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.55554pt\hbox{$\textstyle{}$}}}}}}}{\hbox{\kern 243.38492pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.55554pt\hbox{$\textstyle{{\rm Stab}_{D_{32}}(K_{2})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 323.85933pt\raise 5.93056pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-1.93056pt\hbox{$\scriptstyle{\theta_{32}}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 359.41666pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 329.41666pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.55554pt\hbox{$\textstyle{}$}}}}}}}{\hbox{\kern 359.41666pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.55554pt\hbox{$\textstyle{K_{3}}$}}}}}}}\ignorespaces}}}}\ignorespaces.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm13.p1.3" class="ltx_p"><span id="S3.Thmthm13.p1.3.1" class="ltx_text ltx_font_italic">Then <math id="S3.Thmthm13.p1.m9" class="ltx_Math" alttext="(D_{31}\subseteq W_{31},\theta_{31})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msub><mi>D</mi><mn>31</mn></msub><mo>⊆</mo><msub><mi>W</mi><mn>31</mn></msub></mrow><mo>,</mo><msub><mi>θ</mi><mn>31</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(D_{31}\subseteq W_{31},\theta_{31})</annotation></semantics></math> is a rigidification of <math id="S3.Thmthm13.p1.m10" class="ltx_Math" alttext="\iota_{32}\circ\iota_{21}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ι</mi><mn>32</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>ι</mi><mn>21</mn></msub></mrow><annotation encoding="application/x-tex">\iota_{32}\circ\iota_{21}</annotation></semantics></math>, whose equivalence class only depends on the equivalence classes of the rigidifications of <math id="S3.Thmthm13.p1.m11" class="ltx_Math" alttext="\iota_{32}" display="inline" intent=":literal"><semantics><msub><mi>ι</mi><mn>32</mn></msub><annotation encoding="application/x-tex">\iota_{32}</annotation></semantics></math> and <math id="S3.Thmthm13.p1.m12" class="ltx_Math" alttext="\iota_{21}" display="inline" intent=":literal"><semantics><msub><mi>ι</mi><mn>21</mn></msub><annotation encoding="application/x-tex">\iota_{21}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS2.p3" class="ltx_para">
<p id="S3.SS2.p3.1" class="ltx_p"><span id="S3.SS2.p3.1.1" class="ltx_text">This lemma holds essentially because a trivial bundle over the total space of a trivial bundle is canonically trivial.
∎</span></p>
</div>
</div>
<div id="S3.Thmthm14" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm14.2" class="ltx_text ltx_font_italic">Remark 3.14</span></span><span id="S3.Thmthm14.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S3.Thmthm14.p1" class="ltx_para">
<p id="S3.Thmthm14.p1.1" class="ltx_p">If in Definition <a href="#S3.Thmthm12" title="Definition 3.12. ‣ 3.2. Rigidified embeddings ‣ 3. Kuranishi Spaces ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.12</span></a> we do not require the bundle <math id="S3.Thmthm14.p1.m1" class="ltx_Math" alttext="W_{21}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mn>21</mn></msub><annotation encoding="application/x-tex">W_{21}</annotation></semantics></math> to be trivial, then there is no well-defined composition for rigidified embeddings.</p>
</div>
</div>
<div id="S3.Thmthm15" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm15.2" class="ltx_text ltx_font_italic">Remark 3.15</span></span><span id="S3.Thmthm15.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S3.Thmthm15.p1" class="ltx_para">
<p id="S3.Thmthm15.p1.1" class="ltx_p">One could criticize that rigidified embeddings are not anything natural. On the other hand, our geometric construction (the AMS construction) of Kuranishi flow categories allows us to obtain a topological Kuranishi flow category with rigidified embeddings as morphisms. This is very helpful in the smoothing procedure: once a stratum is smoothed, the total space of a trivial disk bundle is then canonically smoothed, giving a smooth tubular neighborhood in a higher stratum.</p>
</div>
</div>
</section>
<section id="S3.SS3" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.3. </span>Stable complex structures and normal complex structures</h4>

<div id="S3.SS3.p1" class="ltx_para ltx_noindent">
<p id="S3.SS3.p1.1" class="ltx_p">Next, we discuss stable and normal complex structures on Kuranishi spaces. Geometrically, such structures arise from index-theoretic considerations of (virtual) tangent bundles of moduli spaces of pseudoholomorphic curves. Such structures are also instrumental for incorporating the FOP perturbation scheme to define integral invariants.</p>
</div>
<section id="S3.SS3.SSS1" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">3.3.1. </span>Stable morphisms of vector bundles</h5>

<div id="S3.SS3.SSS1.p1" class="ltx_para ltx_noindent">
<p id="S3.SS3.SSS1.p1.1" class="ltx_p">We start with a few basic definitions.</p>
</div>
<div id="S3.Thmthm16" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm16.2" class="ltx_text ltx_font_bold">Definition 3.16</span></span><span id="S3.Thmthm16.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm16.p1" class="ltx_para ltx_noindent">
<p id="S3.Thmthm16.p1.1" class="ltx_p">Let <math id="S3.Thmthm16.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> be a Lie group, <math id="S3.Thmthm16.p1.m2" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> be a <math id="S3.Thmthm16.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-space, and <math id="S3.Thmthm16.p1.m4" class="ltx_Math" alttext="E\to V" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo stretchy="false">→</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">E\to V</annotation></semantics></math> be an equivariant vector bundle.</p>
</div>
<div id="S3.Thmthm16.p2" class="ltx_para">
<ol id="S3.I4" class="ltx_enumerate">
<li id="S3.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S3.I4.i1.p1" class="ltx_para ltx_noindent">
<p id="S3.I4.i1.p1.1" class="ltx_p">Let <math id="S3.I4.i1.p1.m1" class="ltx_Math" alttext="F\to V" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo stretchy="false">→</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">F\to V</annotation></semantics></math> be another <math id="S3.I4.i1.p1.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant vector bundle. A <math id="S3.I4.i1.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant <span id="S3.I4.i1.p1.1.1" class="ltx_text ltx_font_bold">stable (iso)morphism</span> from <math id="S3.I4.i1.p1.m4" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> to <math id="S3.I4.i1.p1.m5" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> is an equivalence class of triples <math id="S3.I4.i1.p1.m6" class="ltx_Math" alttext="(R^{-},R^{+},\tau)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>R</mi><mo>−</mo></msup><mo>,</mo><msup><mi>R</mi><mo>+</mo></msup><mo>,</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(R^{-},R^{+},\tau)</annotation></semantics></math> where <math id="S3.I4.i1.p1.m7" class="ltx_Math" alttext="R^{\pm}" display="inline" intent=":literal"><semantics><msup><mi>R</mi><mo>±</mo></msup><annotation encoding="application/x-tex">R^{\pm}</annotation></semantics></math> are a pair of real vector spaces (viewed as trivial representations of <math id="S3.I4.i1.p1.m8" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>) and</p>
<table id="S3.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex12.m1" class="ltx_Math" alttext="\tau:\underline{\smash{R}}^{-}\oplus E\to\underline{\smash{R}}^{+}\oplus F" display="block" intent=":literal"><semantics><mrow><mi>τ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><munder accentunder="true"><mi>R</mi><mo stretchy="true">¯</mo></munder><mo>−</mo></msup><mo>⊕</mo><mi>E</mi></mrow><mo stretchy="false">→</mo><mrow><msup><munder accentunder="true"><mi>R</mi><mo stretchy="true">¯</mo></munder><mo>+</mo></msup><mo>⊕</mo><mi>F</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau:\underline{\smash{R}}^{-}\oplus E\to\underline{\smash{R}}^{+}\oplus F</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I4.i1.p1.2" class="ltx_p">is a <math id="S3.I4.i1.p1.m9" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant (iso)morphism of vector bundles. The equivalence relation is induced by <math id="S3.I4.i1.p1.m10" class="ltx_Math" alttext="(R^{-},R^{+},\tau)\sim(R^{-}\oplus W,R^{+}\oplus W,\tau\oplus{\rm Id}_{\underline{\smash{W}}})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msup><mi>R</mi><mo>−</mo></msup><mo>,</mo><msup><mi>R</mi><mo>+</mo></msup><mo>,</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow><mo>∼</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>R</mi><mo>−</mo></msup><mo>⊕</mo><mi>W</mi></mrow><mo>,</mo><mrow><msup><mi>R</mi><mo>+</mo></msup><mo>⊕</mo><mi>W</mi></mrow><mo>,</mo><mrow><mi>τ</mi><mo>⊕</mo><msub><mi>Id</mi><munder accentunder="true"><mi>W</mi><mo stretchy="true">¯</mo></munder></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(R^{-},R^{+},\tau)\sim(R^{-}\oplus W,R^{+}\oplus W,\tau\oplus{\rm Id}_{\underline{\smash{W}}})</annotation></semantics></math> where <math id="S3.I4.i1.p1.m11" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> is another real vector space. Denote a stable (iso)morphism by</p>
<table id="S3.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex13.m1" class="ltx_Math" alttext="\tau:E\overset{s}{\to}F." display="block" intent=":literal"><semantics><mrow><mrow><mi>τ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo stretchy="false">→</mo><mo mathsize="0.700em">𝑠</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tau:E\overset{s}{\to}F.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S3.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S3.I4.i2.p1" class="ltx_para ltx_noindent">
<p id="S3.I4.i2.p1.1" class="ltx_p">If <math id="S3.I4.i2.p1.m1" class="ltx_Math" alttext="E,F" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>,</mo><mi>F</mi></mrow><annotation encoding="application/x-tex">E,F</annotation></semantics></math> are complex vector bundles, then a stable (iso)morphism <math id="S3.I4.i2.p1.m2" class="ltx_Math" alttext="\tau:E\overset{s}{\to}F" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo stretchy="false">→</mo><mo mathsize="0.700em">𝑠</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></mrow><annotation encoding="application/x-tex">\tau:E\overset{s}{\to}F</annotation></semantics></math> is called <span id="S3.I4.i2.p1.1.1" class="ltx_text ltx_font_bold">complex</span> if it is represented by a triple <math id="S3.I4.i2.p1.m3" class="ltx_Math" alttext="(R^{-},R^{+},\tau)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>R</mi><mo>−</mo></msup><mo>,</mo><msup><mi>R</mi><mo>+</mo></msup><mo>,</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(R^{-},R^{+},\tau)</annotation></semantics></math> where <math id="S3.I4.i2.p1.m4" class="ltx_Math" alttext="R^{\pm}" display="inline" intent=":literal"><semantics><msup><mi>R</mi><mo>±</mo></msup><annotation encoding="application/x-tex">R^{\pm}</annotation></semantics></math> are complex vector spaces and <math id="S3.I4.i2.p1.m5" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> is a complex vector bundle map.</p>
</div></li>
</ol>
</div>
</div>
<div id="S3.SS3.SSS1.p2" class="ltx_para ltx_noindent">
<p id="S3.SS3.SSS1.p2.1" class="ltx_p">One can verify that stable morphisms can be composed and stable isomorphisms admit inverses as stable isomorphisms.</p>
</div>
</section>
<section id="S3.SS3.SSS2" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">3.3.2. </span>Stable complex structures</h5>

<div id="S3.Thmthm17" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm17.2" class="ltx_text ltx_font_bold">Definition 3.17</span></span><span id="S3.Thmthm17.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm17.p1" class="ltx_para ltx_noindent">
<p id="S3.Thmthm17.p1.1" class="ltx_p">Let <math id="S3.Thmthm17.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> be a Lie group, <math id="S3.Thmthm17.p1.m2" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> be a <math id="S3.Thmthm17.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-space, and <math id="S3.Thmthm17.p1.m4" class="ltx_Math" alttext="E\to V" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo stretchy="false">→</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">E\to V</annotation></semantics></math> be a <math id="S3.Thmthm17.p1.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant vector bundle.</p>
<ol id="S3.I5" class="ltx_enumerate">
<li id="S3.I5.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S3.I5.i1.p1" class="ltx_para ltx_noindent">
<p id="S3.I5.i1.p1.1" class="ltx_p">A <math id="S3.I5.i1.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math><span id="S3.I5.i1.p1.1.1" class="ltx_text ltx_font_bold">-invariant stable complex structure</span> on <math id="S3.I5.i1.p1.m2" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> consists of an equivalence class of pairs <math id="S3.I5.i1.p1.m3" class="ltx_Math" alttext="(\tau,F)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo>,</mo><mi>F</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\tau,F)</annotation></semantics></math> where <math id="S3.I5.i1.p1.m4" class="ltx_Math" alttext="F\to V" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo stretchy="false">→</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">F\to V</annotation></semantics></math> is a <math id="S3.I5.i1.p1.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant complex vector bundle and <math id="S3.I5.i1.p1.m6" class="ltx_Math" alttext="\tau:E\overset{s}{\to}F" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo stretchy="false">→</mo><mo mathsize="0.700em">𝑠</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></mrow><annotation encoding="application/x-tex">\tau:E\overset{s}{\to}F</annotation></semantics></math> is a <math id="S3.I5.i1.p1.m7" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant stable isomorphism. The equivalence relation is generated by the following relation: <math id="S3.I5.i1.p1.m8" class="ltx_Math" alttext="(\tau_{1},F_{1})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>F</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\tau_{1},F_{1})</annotation></semantics></math> and <math id="S3.I5.i1.p1.m9" class="ltx_Math" alttext="(\tau_{2},F_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mn>2</mn></msub><mo>,</mo><msub><mi>F</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\tau_{2},F_{2})</annotation></semantics></math> are equivalent if there is a commutative diagram</p>
<table id="S3.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S3.Ex14.m1.pic1" class="ltx_picture ltx_markedasmath" height="71.07" overflow="visible" style="vertical-align:-57.212119117653415px" version="1.1" viewBox="26.42 57.21 94.62 71.07" width="94.62"><g transform="matrix(1 0 0 -1 26.424983832059898 71.06833261986301) translate(0,3.46) translate(26.43,0)"><g transform="translate(-9.66,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.8em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="11.01"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex14.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{E\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">\textstyle{E\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 9.657058937512971 -0.27673578005007266 L 9.657058937512971 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(18.36,0) translate(0,6.93) translate(4.15,0) translate(0,-1.39)"><foreignObject style="--ltx-fo-width:0.76em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.1em;font-size:10pt;" height="5.55" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="10.5"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex14.m1.pic1.m2" class="ltx_Math" alttext="\scriptstyle{\tau_{1}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">τ</mi><mn mathsize="0.710em">1</mn></msub><annotation encoding="application/x-tex">\scriptstyle{\tau_{1}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(42.87,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 9.657058937512971 -0.27673578005007266 L 42.865859269600975 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 42.865859269600975 -0.27673578005007266 L 42.865859269600975 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -7.610350076103501 L 0.27673578005007266 -7.610350076103501" fill="none" stroke="#000000"></path><g transform="translate(-26.43,0) translate(0,-21.68) translate(4.15,0) translate(0,-2.67)"><foreignObject style="--ltx-fo-width:1.31em;--ltx-fo-height:0.49em;--ltx-fo-depth:0.1em;font-size:10pt;" height="8.12" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="18.12"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex14.m1.pic1.m3" class="ltx_Math" alttext="\scriptstyle{{\rm Id}_{E}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">Id</mi><mi mathsize="0.710em">E</mi></msub><annotation encoding="application/x-tex">\scriptstyle{{\rm Id}_{E}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.208800332088 L 0.27673578005007266 -7.610350076103501" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.208800332088 L 0.27673578005007266 -33.208800332088" fill="none" stroke="#000000"></path><g transform="translate(42.87,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.23em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="17.03"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex14.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{F_{1}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\textstyle{F_{1}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 55.25383395707936 -9.685900096859001 L 55.8073055171795 -9.685900096859001" fill="none" stroke="#000000"></path><g transform="translate(55.53,0) translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 55.25383395707936 -33.208800332088 L 55.8073055171795 -9.685900096859001" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 55.25383395707936 -33.208800332088 L 55.8073055171795 -33.208800332088" fill="none" stroke="#000000"></path><g transform="translate(-9.66,0) translate(0,-43.36) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.8em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="11.01"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex14.m1.pic1.m5" class="ltx_Math" alttext="\textstyle{E\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">\textstyle{E\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 9.657058937512971 -43.63264139549389 L 9.657058937512971 -43.07916983539375" fill="none" stroke="#000000"></path><g transform="translate(18.36,0) translate(0,-50.28) translate(4.15,0) translate(0,-1.39)"><foreignObject style="--ltx-fo-width:0.76em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.1em;font-size:10pt;" height="5.55" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="10.5"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex14.m1.pic1.m6" class="ltx_Math" alttext="\scriptstyle{\tau_{2}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">τ</mi><mn mathsize="0.710em">2</mn></msub><annotation encoding="application/x-tex">\scriptstyle{\tau_{2}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(42.87,0) translate(0,-43.36)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 9.657058937512971 -43.63264139549389 L 42.865859269600975 -43.07916983539375" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 42.865859269600975 -43.63264139549389 L 42.865859269600975 -43.07916983539375" fill="none" stroke="#000000"></path><g transform="translate(42.87,0) translate(0,-43.36) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.23em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="17.03"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex14.m1.pic1.m7" class="ltx_Math" alttext="\textstyle{F_{2}}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\textstyle{F_{2}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I5.i1.p1.2" class="ltx_p">of stable isomorphisms where the right vertical arrow is a complex stable isomorphism.</p>
</div></li>
<li id="S3.I5.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S3.I5.i2.p1" class="ltx_para ltx_noindent">
<p id="S3.I5.i2.p1.1" class="ltx_p">Suppose <math id="S3.I5.i2.p1.m1" class="ltx_Math" alttext="E_{1}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mn>1</mn></msub><annotation encoding="application/x-tex">E_{1}</annotation></semantics></math> and <math id="S3.I5.i2.p1.m2" class="ltx_Math" alttext="E_{2}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mn>2</mn></msub><annotation encoding="application/x-tex">E_{2}</annotation></semantics></math> are <math id="S3.I5.i2.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant stably complex vector bundles over a <math id="S3.I5.i2.p1.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-space <math id="S3.I5.i2.p1.m5" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math>. A <math id="S3.I5.i2.p1.m6" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant stable (iso)morphism <math id="S3.I5.i2.p1.m7" class="ltx_Math" alttext="f:E_{1}\overset{s}{\to}E_{2}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>E</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo stretchy="false">→</mo><mo mathsize="0.700em">𝑠</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">f:E_{1}\overset{s}{\to}E_{2}</annotation></semantics></math> is said to be <span id="S3.I5.i2.p1.1.1" class="ltx_text ltx_font_bold">stably complex</span> if there exist representatives <math id="S3.I5.i2.p1.m8" class="ltx_Math" alttext="(\tau_{1},F_{1})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>F</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\tau_{1},F_{1})</annotation></semantics></math> and <math id="S3.I5.i2.p1.m9" class="ltx_Math" alttext="(\tau_{2},F_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mn>2</mn></msub><mo>,</mo><msub><mi>F</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\tau_{2},F_{2})</annotation></semantics></math> of their stable complex structures and a commutative diagram of stable (iso)morphisms</p>
<table id="S3.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
