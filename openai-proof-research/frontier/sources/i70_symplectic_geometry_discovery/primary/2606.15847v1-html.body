 A 13.84 13.84 45 0 0 6.92 -2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 6.92 2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 193.41415631188815 -0.27673578005007266 L 317.75287033298525 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 193.41415631188815 -0.27673578005007266 L 193.41415631188815 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 362.47349484787946 -12.746990114652519 L 363.0269664079796 -12.746990114652519" fill="none" stroke="#000000"></path><g transform="translate(362.75,0) translate(0,-23.47) translate(4.15,0) translate(0,-3.22)"><foreignObject style="--ltx-fo-width:3.67em;--ltx-fo-height:0.72em;--ltx-fo-depth:0.26em;font-size:10pt;" height="13.6" overflow="visible" transform="matrix(1 0 0 -1 0 10.02)" width="50.74"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S7.Ex102.m1.pic1.m8" class="ltx_Math" alttext="\scriptstyle{T_{a}^{\mathbb{H}}\times T_{\rho(a)}^{{\mathbb{F}}^{\prime}}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathsize="0.700em">T</mi><mi mathsize="0.710em">a</mi><mi mathsize="0.710em">ℍ</mi></msubsup><mo lspace="0.222em" mathsize="0.700em" rspace="0.222em">×</mo><msubsup><mi mathsize="0.700em">T</mi><mrow><mi mathsize="0.710em">ρ</mi><mo>⁡</mo><mrow><mo maxsize="0.710em" minsize="0.710em">(</mo><mi mathsize="0.710em">a</mi><mo maxsize="0.710em" minsize="0.710em">)</mo></mrow></mrow><msup><mi mathsize="0.710em">𝔽</mi><mo>′</mo></msup></msubsup></mrow><annotation encoding="application/x-tex">\scriptstyle{T_{a}^{\mathbb{H}}\times T_{\rho(a)}^{{\mathbb{F}}^{\prime}}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(362.75,0) translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45