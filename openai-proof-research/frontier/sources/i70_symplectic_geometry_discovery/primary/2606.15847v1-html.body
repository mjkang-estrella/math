><msubsup><mi mathsize="0.700em">T</mi><mi mathsize="0.710em">a</mi><mi mathsize="0.710em">𝔽</mi></msubsup></mrow><annotation encoding="application/x-tex">\scriptstyle{T_{a}^{\mathbb{F}}\times T_{a}^{\mathbb{F}}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.208800332088 L 0.27673578005007266 -11.569253138458645" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.208800332088 L 0.27673578005007266 -33.208800332088" fill="none" stroke="#000000"></path><g transform="translate(123.64,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.93em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.29em;font-size:10pt;" height="15.6" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="26.75"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S7.Ex86.m1.pic1.m5" class="ltx_Math" alttext="\textstyle{M_{pq}^{\mathbb{F}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><annotation encoding="application/x-tex">\textstyle{M_{pq}^{\mathbb{F}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 140.88699427386018 -11.569253138458645 L 141.44046583396033 -11.569253138458645" fill="none" stroke="#000000"></path><g transform="translate(141.17,0) translate(0,-22.77) translate(4.15,0) translate(0,-3.75)"><foreignObject style="--ltx-fo-width:1.06em;--ltx-fo-height:0.64em;--ltx-fo-depth:0.1em;font-size:10pt;" height="10.26" overflow="visible" transform="matrix(1 0 0 -1 0 8.88)" width="14.7"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S7.Ex86.m1.pic1.m6" class="ltx_Math" alttext="\scriptstyle{T_{a}^{\mathbb{F}}}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.700em">T</mi><mi mathsize="0.710em">a</mi><mi mathsize="0.710em">𝔽</mi></msubsup><annotation encoding="application/x-tex">\scriptstyle{T_{a}^{\mathbb{F}}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(141.17,0) translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 140.88699427386018 -33.208800332088 L 141.44046583396033 -11.569253138458645" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 140.88699427386018 -33.208800332088 L 141.44046583396033 -33.208800332088" fill="none" stroke="#000000"></path><g transform="translate(-45.18,0) translate(0,-45.54) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:5.93em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.37em;font-size:10pt;" height="16.78" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="82.05"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S7.Ex86.m1.pic1.m7" class="ltx_Math" alttext="\textstyle{M_{p^{\prime}r^{\prime}}^{\mathbb{F}}\times M_{r^{\prime}q^{\prime}}^{\mathbb{F}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>M</mi><mrow><msup><mi>p</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mo>′</mo></msup></mrow><mi>𝔽</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>M</mi><mrow><msup><mi>r</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>′</mo></msup></mrow><mi>𝔽</mi></msubsup></mrow><annotation encoding="application/x-tex">\textstyle{M_{p^{\prime}r^{\prime}}^{\mathbb{F}}\times M_{r^{\prime}q^{\prime}}^{\mathbb{F}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 45.176424623212 -45.817433113508805 L 45.176424623212 -45.263961553408656" fill="none" stroke="#000000"></path><g transform="translate(62.97,0) translate(0,-53.7) translate(4.15,0) translate(0,-0.16)"><foreignObject style="--ltx-fo-width:2.23em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.28em;font-size:10pt;" height="8.02" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="30.82"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S7.Ex86.m1.pic1.m8" class="ltx_Math" alttext="\scriptstyle{\iota_{p^{\prime}r^{\prime}q^{\prime}}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">ι</mi><mrow><msup><mi mathsize="0.710em">p</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.710em">r</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.710em">q</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">\scriptstyle{\iota_{p^{\prime}r^{\prime}q^{\prime}}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(119.9,0) translate(0,-45.54)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 45.176424623212 -45.817433113508805 L 119.89620425682337 -45.263961553408656" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 119.89620425682337 -45.817433113508805 L 119.89620425682337 -45.263961553408656" fill="none" stroke="#000000"></path><g transform="translate(119.9,0) translate(0,-45.54) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:2.47em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.37em;font-size:10pt;" height="16.78" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="34.23"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S7.Ex86.m1.pic1.m10" class="ltx_Math" alttext="\textstyle{M_{p^{\prime}q^{\prime}}^{\mathbb{F}}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mrow><msup><mi>p</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>′</mo></msup></mrow><mi>𝔽</mi></msubsup><annotation encoding="application/x-tex">\textstyle{M_{p^{\prime}q^{\prime}}^{\mathbb{F}}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S7.I9.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S7.I9.i3.p1" class="ltx_para ltx_noindent">
<p id="S7.I9.i3.p1.1" class="ltx_p">For <math id="S7.I9.i3.p1.m1" class="ltx_Math" alttext="a\in\mathbb{\Pi}\subseteq\mathbb{\Pi}\rtimes G" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mo>⊆</mo><mrow><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mo lspace="0.222em" rspace="0.222em">⋊</mo><mi>G</mi></mrow></mrow><annotation encoding="application/x-tex">a\in\mathbb{\Pi}\subseteq\mathbb{\Pi}\rtimes G</annotation></semantics></math> and <math id="S7.I9.i3.p1.m2" class="ltx_Math" alttext="p\in{\rm Ob}{\mathbb{F}}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></mrow><annotation encoding="application/x-tex">p\in{\rm Ob}{\mathbb{F}}</annotation></semantics></math></p>
<table id="S7.EGx24" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S7.Ex87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex87.m1" class="ltx_Math" alttext="\displaystyle\ {\mathcal{A}}(ap)={\mathcal{A}}(p)-\lambda(a)\in{\mathbb{R}}^{k},\ " display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mi>k</mi></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ {\mathcal{A}}(ap)={\mathcal{A}}(p)-\lambda(a)\in{\mathbb{R}}^{k},\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.Ex87.m2" class="ltx_Math" alttext="\displaystyle\ {\rm deg}(ap)={\rm deg}(p)-\mu(a)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ {\rm deg}(ap)={\rm deg}(p)-\mu(a).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.I9.i3.p1.2" class="ltx_p">For <math id="S7.I9.i3.p1.m3" class="ltx_Math" alttext="\theta\in G\subseteq\mathbb{\Pi}\rtimes G" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><mi>G</mi><mo>⊆</mo><mrow><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mo lspace="0.222em" rspace="0.222em">⋊</mo><mi>G</mi></mrow></mrow><annotation encoding="application/x-tex">\theta\in G\subseteq\mathbb{\Pi}\rtimes G</annotation></semantics></math>,</p>
<table id="S7.EGx25" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S7.Ex88"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex88.m1" class="ltx_Math" alttext="\displaystyle\ {\mathcal{A}}(\theta p)=\theta({\mathcal{A}}(p)),\ " display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ {\mathcal{A}}(\theta p)=\theta({\mathcal{A}}(p)),\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.Ex88.m2" class="ltx_Math" alttext="\displaystyle\ {\rm deg}(\theta p)={\rm deg}(\theta p)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ {\rm deg}(\theta p)={\rm deg}(\theta p).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S7.I9.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S7.I9.i4.p1" class="ltx_para ltx_noindent">
<p id="S7.I9.i4.p1.1" class="ltx_p">Given <math id="S7.I9.i4.p1.m1" class="ltx_Math" alttext="c&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c&gt;0</annotation></semantics></math>, the set of pairs</p>
<table id="S7.Ex89" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex89.m1" class="ltx_math_unparsed" alttext="\Big\{(p,q)\in{\rm Ob}{\mathbb{F}}\times{\rm Ob}{\mathbb{F}}\ |\ p&lt;q,{\mathcal{A}}_{\alpha}(p)-{\mathcal{A}}_{\alpha}(q)&lt;c\ \forall\alpha=1,\ldots,k\Big\}" display="block" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>Ob</mi><mi>𝔽</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>Ob</mi><mi>𝔽</mi><mo fence="false" lspace="0.500em" rspace="0.667em" stretchy="false">|</mo><mi>p</mi><mo>&lt;</mo><mi>q</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>α</mi></msub><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>α</mi></msub><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mo>&lt;</mo><mi>c</mi><mo lspace="0.667em" rspace="0.167em">∀</mo><mi>α</mi><mo>=</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>k</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\Big\{(p,q)\in{\rm Ob}{\mathbb{F}}\times{\rm Ob}{\mathbb{F}}\ |\ p&lt;q,{\mathcal{A}}_{\alpha}(p)-{\mathcal{A}}_{\alpha}(q)&lt;c\ \forall\alpha=1,\ldots,k\Big\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.I9.i4.p1.2" class="ltx_p">consists of finitely many <math id="S7.I9.i4.p1.m2" class="ltx_Math" alttext="\mathbb{\Pi}\rtimes G" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mo lspace="0.222em" rspace="0.222em">⋊</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">\mathbb{\Pi}\rtimes G</annotation></semantics></math>-orbits.</p>
</div></li>
</ol>
</div>
</div>
<div id="S7.Thmthm25" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm25.2" class="ltx_text ltx_font_italic">Remark 7.25</span></span><span id="S7.Thmthm25.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S7.Thmthm25.p1" class="ltx_para">
<ol id="S7.I10" class="ltx_enumerate">
<li id="S7.I10.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S7.I10.i1.p1" class="ltx_para ltx_noindent">
<p id="S7.I10.i1.p1.1" class="ltx_p">Notice that the last condition of Definition <a href="#S7.Thmthm24" title="Definition 7.24. ‣ 7.3.3. Symmetries on flow categories ‣ 7.3. Symmetries on flow categories, multimodules, and homotopies ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.24</span></a> implies that <math id="S7.I10.i1.p1.m1" class="ltx_Math" alttext="({\mathbb{F}},{\mathcal{A}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝔽</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}},{\mathcal{A}})</annotation></semantics></math> is a locally finite flow category.</p>
</div></li>
<li id="S7.I10.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S7.I10.i2.p1" class="ltx_para ltx_noindent">
<p id="S7.I10.i2.p1.1" class="ltx_p">If <math id="S7.I10.i2.p1.m1" class="ltx_Math" alttext="\mathbb{\Pi}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathbb{\Pi}_{i}</annotation></semantics></math> are Novikov groups and <math id="S7.I10.i2.p1.m2" class="ltx_Math" alttext="({\mathbb{F}}_{i},{\mathcal{A}}_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>i</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{i},{\mathcal{A}}_{i})</annotation></semantics></math> are <math id="S7.I10.i2.p1.m3" class="ltx_Math" alttext="\mathbb{\Pi}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathbb{\Pi}_{i}</annotation></semantics></math>-equivariant Novikov flow categories, then the direct product</p>
<table id="S7.Ex90" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex90.m1" class="ltx_math_unparsed" alttext="({\mathbb{F}}_{1}\times\cdots\times{\mathbb{F}}_{m},{\mathcal{A}}_{1}\times\cdots\times{\mathcal{A}}_{m})" display="block" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mn>1</mn></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{1}\times\cdots\times{\mathbb{F}}_{m},{\mathcal{A}}_{1}\times\cdots\times{\mathcal{A}}_{m})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.I10.i2.p1.2" class="ltx_p">is a <math id="S7.I10.i2.p1.m4" class="ltx_math_unparsed" alttext="\mathbb{\Pi}_{1}\times\cdots\times\mathbb{\Pi}_{m}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><msub><mrow></mrow><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">\mathbb{\Pi}_{1}\times\cdots\times\mathbb{\Pi}_{m}</annotation></semantics></math>-equivariant weak Novikov flow category. When all factors are equal to a <math id="S7.I10.i2.p1.m5" class="ltx_Math" alttext="\mathbb{\Pi}" display="inline" intent=":literal"><semantics><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><annotation encoding="application/x-tex">\mathbb{\Pi}</annotation></semantics></math>-equivariant Novikov flow category <math id="S7.I10.i2.p1.m6" class="ltx_Math" alttext="({\mathbb{F}},{\mathcal{A}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝔽</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}},{\mathcal{A}})</annotation></semantics></math>, the power <math id="S7.I10.i2.p1.m7" class="ltx_math_unparsed" alttext="({\mathbb{F}}\times\cdots\times{\mathbb{F}},{\mathcal{A}}\times\cdots\times{\mathcal{A}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝔽</mi><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi>𝔽</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}\times\cdots\times{\mathbb{F}},{\mathcal{A}}\times\cdots\times{\mathcal{A}})</annotation></semantics></math> is <math id="S7.I10.i2.p1.m8" class="ltx_Math" alttext="\mathbb{\Pi}^{m}\rtimes{\mathbb{Z}}_{m}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mi>m</mi></msup><mo lspace="0.222em" rspace="0.222em">⋊</mo><msub><mi>ℤ</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">\mathbb{\Pi}^{m}\rtimes{\mathbb{Z}}_{m}</annotation></semantics></math>-equivariant where <math id="S7.I10.i2.p1.m9" class="ltx_Math" alttext="{\mathbb{Z}}_{m}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>m</mi></msub><annotation encoding="application/x-tex">{\mathbb{Z}}_{m}</annotation></semantics></math> acts on <math id="S7.I10.i2.p1.m10" class="ltx_Math" alttext="\mathbb{\Pi}^{m}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mi>m</mi></msup><annotation encoding="application/x-tex">\mathbb{\Pi}^{m}</annotation></semantics></math> by permuting the factors.</p>
</div></li>
</ol>
</div>
</div>
</section>
<section id="S7.SS3.SSS4" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">7.3.4. </span>Symmetries on multimodules and homotopies</h5>

<div id="S7.Thmthm26" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm26.2" class="ltx_text ltx_font_bold">Definition 7.26</span></span><span id="S7.Thmthm26.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm26.p1" class="ltx_para ltx_noindent">
<p id="S7.Thmthm26.p1.1" class="ltx_p">Let <math id="S7.Thmthm26.p1.m1" class="ltx_Math" alttext="\mathbb{\Pi}\rtimes G" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mo lspace="0.222em" rspace="0.222em">⋊</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">\mathbb{\Pi}\rtimes G</annotation></semantics></math> and <math id="S7.Thmthm26.p1.m2" class="ltx_Math" alttext="\mathbb{\Pi}^{\prime}\rtimes G" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">⋊</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">\mathbb{\Pi}^{\prime}\rtimes G</annotation></semantics></math> be twisted Novikov groups. Let <math id="S7.Thmthm26.p1.m3" class="ltx_Math" alttext="({\mathbb{F}},{\mathcal{A}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝔽</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}},{\mathcal{A}})</annotation></semantics></math> resp. <math id="S7.Thmthm26.p1.m4" class="ltx_Math" alttext="({\mathbb{F}}^{\prime},{\mathcal{A}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}^{\prime},{\mathcal{A}}^{\prime})</annotation></semantics></math> be a <math id="S7.Thmthm26.p1.m5" class="ltx_Math" alttext="\mathbb{\Pi}\rtimes G" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mo lspace="0.222em" rspace="0.222em">⋊</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">\mathbb{\Pi}\rtimes G</annotation></semantics></math>-equivariant resp. <math id="S7.Thmthm26.p1.m6" class="ltx_Math" alttext="\mathbb{\Pi}^{\prime}\rtimes G" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">⋊</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">\mathbb{\Pi}^{\prime}\rtimes G</annotation></semantics></math>-equivariant (weak) Novikov flow categories enriched in <math id="S7.Thmthm26.p1.m7" class="ltx_Math" alttext="\underline{\smash{\bf C}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐂</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf C}}</annotation></semantics></math>. Let</p>
<table id="S7.Ex91" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex91.m1" class="ltx_Math" alttext="\rho:\mathbb{\Pi}\to\mathbb{\Pi}^{\prime}" display="block" intent=":literal"><semantics><mrow><mi>ρ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mo stretchy="false">→</mo><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\rho:\mathbb{\Pi}\to\mathbb{\Pi}^{\prime}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.Thmthm26.p1.2" class="ltx_p">be a <math id="S7.Thmthm26.p1.m8" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant morphism of Novikov groups, which induces a group morphism</p>
<table id="S7.Ex92" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex92.m1" class="ltx_Math" alttext="\rho:\mathbb{\Pi}\rtimes G\to\mathbb{\Pi}^{\prime}\rtimes G." display="block" intent=":literal"><semantics><mrow><mrow><mi>ρ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mo lspace="0.222em" rspace="0.222em">⋊</mo><mi>G</mi></mrow><mo stretchy="false">→</mo><mrow><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">⋊</mo><mi>G</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\rho:\mathbb{\Pi}\rtimes G\to\mathbb{\Pi}^{\prime}\rtimes G.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.Thmthm26.p1.3" class="ltx_p">A <math id="S7.Thmthm26.p1.m9" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math><span id="S7.Thmthm26.p1.3.1" class="ltx_text ltx_font_bold">-equivariant (weak) Novikov bimodule</span> over <math id="S7.Thmthm26.p1.m10" class="ltx_Math" alttext="({\mathbb{F}};{\mathbb{F}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝔽</mi><mo>;</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}};{\mathbb{F}}^{\prime})</annotation></semantics></math> is a (weak) bimodule <math id="S7.Thmthm26.p1.m11" class="ltx_Math" alttext="{\mathbb{B}}" display="inline" intent=":literal"><semantics><mi>𝔹</mi><annotation encoding="application/x-tex">{\mathbb{B}}</annotation></semantics></math> together with <math id="S7.Thmthm26.p1.m12" class="ltx_Math" alttext="\underline{\smash{\bf C}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐂</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf C}}</annotation></semantics></math>-isomorphisms</p>
<table id="S7.Ex93" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex93.m1" class="ltx_Math" alttext="T_{a}^{\mathbb{B}}:M_{p;p^{\prime}}^{\mathbb{B}}\to M_{ap;\rho(a)p^{\prime}}^{\mathbb{B}}\ \forall a\in\mathbb{\Pi}\rtimes G" display="block" intent=":literal"><semantics><mrow><msubsup><mi>T</mi><mi>a</mi><mi>𝔹</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>M</mi><mrow><mi>p</mi><mo>;</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mi>𝔹</mi></msubsup><mo stretchy="false">→</mo><mrow><msubsup><mi>M</mi><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>;</mo><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></mrow><mi>𝔹</mi></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mo rspace="0.167em">∀</mo><mi>a</mi></mrow></mrow><mo>∈</mo><mrow><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mo lspace="0.222em" rspace="0.222em">⋊</mo><mi>G</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">T_{a}^{\mathbb{B}}:M_{p;p^{\prime}}^{\mathbb{B}}\to M_{ap;\rho(a)p^{\prime}}^{\mathbb{B}}\ \forall a\in\mathbb{\Pi}\rtimes G</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.Thmthm26.p1.4" class="ltx_p">satisfying</p>
</div>
<div id="S7.Thmthm26.p2" class="ltx_para">
<ol id="S7.I11" class="ltx_enumerate">
<li id="S7.I11.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S7.I11.i1.p1" class="ltx_para ltx_noindent">
<p id="S7.I11.i1.p1.1" class="ltx_p"><math id="S7.I11.i1.p1.m1" class="ltx_Math" alttext="T_{0}^{\mathbb{B}}" display="inline" intent=":literal"><semantics><msubsup><mi>T</mi><mn>0</mn><mi>𝔹</mi></msubsup><annotation encoding="application/x-tex">T_{0}^{\mathbb{B}}</annotation></semantics></math> is the identity and for <math id="S7.I11.i1.p1.m2" class="ltx_Math" alttext="a,b\in\mathbb{\Pi}\rtimes G" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow><mo>∈</mo><mrow><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mo lspace="0.222em" rspace="0.222em">⋊</mo><mi>G</mi></mrow></mrow><annotation encoding="application/x-tex">a,b\in\mathbb{\Pi}\rtimes G</annotation></semantics></math>,</p>
<table id="S7.Ex94" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex94.m1" class="ltx_Math" alttext="T_{(a+b)}^{\mathbb{B}}=T_{a}^{\mathbb{B}}\circ T_{b}^{\mathbb{B}}," display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>T</mi><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow><mi>𝔹</mi></msubsup><mo>=</mo><mrow><msubsup><mi>T</mi><mi>a</mi><mi>𝔹</mi></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi>T</mi><mi>b</mi><mi>𝔹</mi></msubsup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">T_{(a+b)}^{\mathbb{B}}=T_{a}^{\mathbb{B}}\circ T_{b}^{\mathbb{B}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S7.I11.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S7.I11.i2.p1" class="ltx_para ltx_noindent">
