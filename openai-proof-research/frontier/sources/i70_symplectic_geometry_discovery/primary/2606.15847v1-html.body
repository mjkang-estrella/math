2519" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.208800332088 L 0.27673578005007266 -33.208800332088" fill="none" stroke="#000000"></path><g transform="translate(155.86,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:2.29em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.37em;font-size:10pt;" height="16.78" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="31.66"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S7.Ex101.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{{\mathbb{M}}_{p;p^{\prime}}^{\mathbb{H}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msubsup><mi>𝕄</mi><mrow><mi>p</mi><mo>;</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mi>ℍ</mi></msubsup><annotation encoding="application/x-tex">\textstyle{{\mathbb{M}}_{p;p^{\prime}}^{\mathbb{H}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 175.56044411095112 -12.746990114652519 L 176.11391567105127 -12.746990114652519" fill="none" stroke="#000000"></path><g transform="translate(175.84,0) translate(0,-22.77) translate(4.15,0) translate(0,-3.75)"><foreignObject style="--ltx-fo-width:1.12em;--ltx-fo-height:0.64em;--ltx-fo-depth:0.1em;font-size:10pt;" height="10.26" overflow="visible" transform="matrix(1 0 0 -1 0 8.88)" width="15.5"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S7.Ex101.m1.pic1.m5" class="ltx_Math" alttext="\scriptstyle{T_{a}^{\mathbb{H}}}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.700em">T</mi><mi mathsize="0.710em">a</mi><mi mathsize="0.710em">ℍ</mi></msubsup><annotation encoding="application/x-tex">\scriptstyle{T_{a}^{\mathbb{H}}}</annotation></semantics></math></span></span></foreignObject></g><g transform="trans