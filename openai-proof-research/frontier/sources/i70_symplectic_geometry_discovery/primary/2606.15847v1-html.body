></mrow><mo>+</mo></msup><mover accent="true"><mi>V</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub></mrow></msub><mo lspace="0em">⊕</mo><mover accent="true"><mi>I</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><msup><mi>q</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub><mo fence="false" stretchy="false">|</mo><msub><mrow></mrow><mrow><msup><mo>∂</mo><mo>+</mo></msup><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><msup><mi>q</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub></mrow></msub><mo lspace="0.167em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\widetilde{I}_{p_{1}\cdots p_{m};q^{\prime}p^{\prime}}|_{\partial^{-}\widetilde{V}_{p_{1}\cdots p_{m};q^{\prime}p^{\prime}}}\cong&amp;\ \widetilde{I}_{p_{1}\cdots p_{m};q^{\prime}}|_{\partial^{-}\widetilde{V}_{p_{1}\cdots p_{m};q^{\prime}}}\oplus\widetilde{I}_{q^{\prime}p^{\prime}}|_{\partial^{-}\widetilde{V}_{q^{\prime}p^{\prime}}},\\
\widetilde{I}_{p_{1}\cdots p_{m};q^{\prime}p^{\prime}}|_{\partial^{0}\widetilde{V}_{p_{1}\cdots p_{m};q^{\prime}p^{\prime}}}\cong&amp;\ \widetilde{I}_{p_{1}\cdots p_{m};q^{\prime}}|_{\partial^{+}\widetilde{V}_{p_{1}\cdots p_{m};q^{\prime}}}\oplus\widetilde{I}_{q^{\prime}p^{\prime}}|_{\partial^{-}\widetilde{V}_{q^{\prime}p^{\prime}}},\\
\widetilde{I}_{p_{1}\cdots p_{m};q^{\prime}p^{\prime}}|_{\partial^{+}\widetilde{V}_{p_{1}\cdots p_{m};q^{\prime}p^{\prime}}}\cong&amp;\ \widetilde{I}_{p_{1}\cdots p_{m};q^{\prime}}|_{\partial^{+}\widetilde{V}_{p_{1}\cdots p_{m};q^{\prime}}}\oplus\widetilde{I}_{q^{\prime}p^{\prime}}|_{\partial^{+}\widetilde{V}_{q^{\prime}p^{\prime}}}.\end{split}</annotation></semantics></math></td>
