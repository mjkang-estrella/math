<li id="S14.I2.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(5)</span> 
<div id="S14.I2.i5.p1" class="ltx_para ltx_noindent">
<p id="S14.I2.i5.p1.1" class="ltx_p">For <math id="S14.I2.i5.p1.m1" class="ltx_Math" alttext="i\neq j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≠</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i\neq j</annotation></semantics></math>, <math id="S14.I2.i5.p1.m2" class="ltx_Math" alttext="d_{i},d_{j}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>d</mi><mi>j</mi></msub><mo>≥</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">d_{i},d_{j}\geq 0</annotation></semantics></math> and <math id="S14.I2.i5.p1.m3" class="ltx_Math" alttext="d\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d\geq 0</annotation></semantics></math>, the following diagram commutes.</p>
<table id="S14.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S14.Ex10.m1.pic1" class="ltx_picture ltx_markedasmath" height="70.50" overflow="visible" style="vertical-align:-58.06314445422763px" version="1.1" viewBox="54.87 58.06 273.17 70.50" width="273.17"><g transform="matrix(1 0 0 -1 54.86768757107678 70.5026362931001) translate(0,3.46) translate(54.87,0)"><g transform="translate(-54.87,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:7.33em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.35em;font-size:10pt;" height="16.55" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="101.43"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S14.Ex10.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{M_{d_{j}}^{{\mathbb{f}}_{j}}\times M_{d_{i}}^{{\mathbb{f}}_{i}}\times M_{d}^{\mathbb{x}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>M</mi><msub><mi>d</mi><mi>j</mi></msub><msub><mi>𝕗</mi><mi>j</mi></msub></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>M</mi><msub><mi>d</mi><mi>i</mi></msub><msub><mi>𝕗</mi><mi>i</mi></msub></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>M</mi><mi>d</mi><mi>𝕩</mi></msubsup></mrow><annotation encoding="application/x-tex">\textstyle{M_{d_{j}}^{{\mathbb{f}}_{j}}\times M_{d_{i}}^{{\mathbb{f}}_{i}}\times M_{d}^{\mathbb{x}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 54.86770868466341 -0.27673578005007266 L 54.86770868466341 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(129.59,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 54.86770868466341 -0.27673578005007266 L 129.58748831827478 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 129.58748831827478 -0.27673578005007266 L 129.58748831827478 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -12.414852283267175 L 0.27673578005007266 -12.414852283267175" fill="none" stroke="#000000"></path><g transform="translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.208800332088 L 0.27673578005007266 -12.414852283267175" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.208800332088 L 0.27673578005007266 -33.208800332088" fill="none" stroke="#000000"></path><g transform="translate(129.59,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:5.81em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.35em;font-size:10pt;" height="16.55" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="80.41"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S14.Ex10.m1.pic1.m3" class="ltx_Math" alttext="\textstyle{M_{d_{j}}^{{\mathbb{f}}_{j}}\times M_{d_{i}+d}^{{\mathbb{x}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>M</mi><msub><mi>d</mi><mi>j</mi></msub><msub><mi>𝕗</mi><mi>j</mi></msub></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>M</mi><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>+</mo><mi>d</mi></mrow><mi>𝕩</mi></msubsup></mrow><annotation encoding="application/x-tex">\textstyle{M_{d_{j}}^{{\mathbb{f}}_{j}}\times M_{d_{i}+d}^{{\mathbb{x}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 173.66837115807044 -12.414852283267175 L 174.22184271817056 -12.414852283267175" fill="none" stroke="#000000"></path><g transform="translate(173.95,0) translate(0,-35.5)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 173.66837115807044 -35.50118688760464 L 174.22184271817056 -12.414852283267175" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 173.66837115807044 -35.50118688760464 L 174.22184271817056 -35.50118688760464" fill="none" stroke="#000000"></path><g transform="translate(-44.36,0) translate(0,-45.65) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:5.81em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.35em;font-size:10pt;" height="16.55" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="80.41"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S14.Ex10.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{M_{d_{i}}^{{\mathbb{f}}_{i}}\times M_{d_{j}+d}^{{\mathbb{x}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>M</mi><msub><mi>d</mi><mi>i</mi></msub><msub><mi>𝕗</mi><mi>i</mi></msub></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>M</mi><mrow><msub><mi>d</mi><mi>j</mi></msub><mo>+</mo><mi>d</mi></mrow><mi>𝕩</mi></msubsup></mrow><annotation encoding="application/x-tex">\textstyle{M_{d_{i}}^{{\mathbb{f}}_{i}}\times M_{d_{j}+d}^{{\mathbb{x}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 44.35763973343236 -45.925027951010534 L 44.35763973343236 -45.371556390910385" fill="none" stroke="#000000"></path><g transform="translate(140.07,0) translate(0,-45.65)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 44.35763973343236 -45.925027951010534 L 140.07089080958343 -45.371556390910385" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 140.07089080958343 -45.925027951010534 L 140.07089080958343 -45.371556390910385" fill="none" stroke="#000000"></path><g transform="translate(140.07,0) translate(0,-45.65) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:4.3em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.35em;font-size:10pt;" height="14.26" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="59.45"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S14.Ex10.m1.pic1.m6" class="ltx_Math" alttext="\textstyle{M_{d_{i}+d_{j}+d}^{\mathbb{x}}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>+</mo><msub><mi>d</mi><mi>j</mi></msub><mo>+</mo><mi>d</mi></mrow><mi>𝕩</mi></msubsup><annotation encoding="application/x-tex">\textstyle{M_{d_{i}+d_{j}+d}^{\mathbb{x}}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
</div>
</div>
<div id="S14.SS1.SSS2.p2" class="ltx_para ltx_noindent">
<p id="S14.SS1.SSS2.p2.1" class="ltx_p">Notice that the monotone multimodule <math id="S14.SS1.SSS2.p2.m1" class="ltx_Math" alttext="{\mathbb{x}}" display="inline" intent=":literal"><semantics><mi>𝕩</mi><annotation encoding="application/x-tex">{\mathbb{x}}</annotation></semantics></math> induces an ordinary multimodule <math id="S14.SS1.SSS2.p2.m2" class="ltx_Math" alttext="{\mathbb{X}}" display="inline" intent=":literal"><semantics><mi>𝕏</mi><annotation encoding="application/x-tex">{\mathbb{X}}</annotation></semantics></math> over <math id="S14.SS1.SSS2.p2.m3" class="ltx_Math" alttext="({\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m};{\mathbb{F}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo>,</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m};{\mathbb{F}}^{\prime})</annotation></semantics></math> with</p>
<table id="S14.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex11.m1" class="ltx_math_unparsed" alttext="M_{a_{1}\cdots a_{m};a^{\prime}}^{\mathbb{X}}:=\left\{\begin{array}[]{cc}M_{a_{1}+\cdots+a_{m}-a^{\prime}}^{\mathbb{x}},&amp;\ a_{1}+\cdots+a_{m}\geq a^{\prime},\\
\emptyset,&amp;\ {\rm otherwise}\end{array}\right." display="block" intent=":literal"><semantics><mrow><msubsup><mi>M</mi><mrow><mi>a</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>a</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>a</mi><msup><mrow></mrow><mo>′</mo></msup></mrow><mi>𝕏</mi></msubsup><mo>:=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd><mrow><msubsup><mi>M</mi><mrow><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>a</mi><mi>m</mi></msub></mrow><mo>−</mo><msup><mi>a</mi><mo>′</mo></msup></mrow><mi>𝕩</mi></msubsup><mo>,</mo></mrow></mtd><mtd><mrow><mrow><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>a</mi><mi>m</mi></msub></mrow><mo>≥</mo><msup><mi>a</mi><mo>′</mo></msup></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd><mrow><mi mathvariant="normal">∅</mi><mo>,</mo></mrow></mtd><mtd><mi>otherwise</mi></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">M_{a_{1}\cdots a_{m};a^{\prime}}^{\mathbb{X}}:=\left\{\begin{array}[]{cc}M_{a_{1}+\cdots+a_{m}-a^{\prime}}^{\mathbb{x}},&amp;\ a_{1}+\cdots+a_{m}\geq a^{\prime},\\
\emptyset,&amp;\ {\rm otherwise}\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS1.SSS2.p2.2" class="ltx_p">and structural maps induced from structural maps of <math id="S14.SS1.SSS2.p2.m4" class="ltx_Math" alttext="{\mathbb{x}}" display="inline" intent=":literal"><semantics><mi>𝕩</mi><annotation encoding="application/x-tex">{\mathbb{x}}</annotation></semantics></math>. Moreover, it is equivariant with respect to the natural group morphism</p>
<table id="S14.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex12.m1" class="ltx_Math" alttext="\underbrace{{\mathbb{Z}}\times\cdots\times{\mathbb{Z}}}_{m}\to{\mathbb{Z}}." display="block" intent=":literal"><semantics><mrow><mrow><munder><munder accentunder="true"><mrow><mi>ℤ</mi><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi>ℤ</mi></mrow><mo stretchy="true">⏟</mo></munder><mi>m</mi></munder><mo stretchy="false">→</mo><mi>ℤ</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\underbrace{{\mathbb{Z}}\times\cdots\times{\mathbb{Z}}}_{m}\to{\mathbb{Z}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S14.SS1.SSS2.p3" class="ltx_para ltx_noindent">
<p id="S14.SS1.SSS2.p3.1" class="ltx_p">The case of homotopies is similar and stated as follows.</p>
</div>
<div id="S14.Thmthm5" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S14.Thmthm5.2" class="ltx_text ltx_font_bold">Definition 14.5</span></span><span id="S14.Thmthm5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S14.Thmthm5.p1" class="ltx_para ltx_noindent">
<p id="S14.Thmthm5.p1.1" class="ltx_p">Let <math id="S14.Thmthm5.p1.m1" class="ltx_Math" alttext="{\mathbb{f}}_{1},\ldots,{\mathbb{f}}_{m},{\mathbb{f}}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝕗</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝕗</mi><mi>m</mi></msub><mo>,</mo><msup><mi>𝕗</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">{\mathbb{f}}_{1},\ldots,{\mathbb{f}}_{m},{\mathbb{f}}^{\prime}</annotation></semantics></math> be as in Definition <a href="#S14.Thmthm4" title="Definition 14.4. ‣ 14.1.2. Monotone flow multimodules and homotopies ‣ 14.1. Monotone flow categories, multimodules, and homotopies ‣ 14. The Flow Categories, Multimodules, and Homotopies of Domains ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14.4</span></a>. Let <math id="S14.Thmthm5.p1.m2" class="ltx_Math" alttext="{\mathbb{x}}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝕩</mi><mn>0</mn></msub><annotation encoding="application/x-tex">{\mathbb{x}}_{0}</annotation></semantics></math>, <math id="S14.Thmthm5.p1.m3" class="ltx_Math" alttext="{\mathbb{x}}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝕩</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\mathbb{x}}_{1}</annotation></semantics></math> be two monotone multimodules over <math id="S14.Thmthm5.p1.m4" class="ltx_Math" alttext="({\mathbb{f}}_{1},\ldots,{\mathbb{f}}_{m};{\mathbb{f}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝕗</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝕗</mi><mi>m</mi></msub><mo>,</mo><msup><mi>𝕗</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{f}}_{1},\ldots,{\mathbb{f}}_{m};{\mathbb{f}}^{\prime})</annotation></semantics></math> A <span id="S14.Thmthm5.p1.1.1" class="ltx_text ltx_font_bold">monotone homotopy</span> from <math id="S14.Thmthm5.p1.m5" class="ltx_Math" alttext="{\mathbb{x}}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝕩</mi><mn>0</mn></msub><annotation encoding="application/x-tex">{\mathbb{x}}_{0}</annotation></semantics></math> to <math id="S14.Thmthm5.p1.m6" class="ltx_Math" alttext="{\mathbb{x}}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝕩</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\mathbb{x}}_{1}</annotation></semantics></math>, denoted by <math id="S14.Thmthm5.p1.m7" class="ltx_Math" alttext="{\mathbb{h}}" display="inline" intent=":literal"><semantics><mi>𝕙</mi><annotation encoding="application/x-tex">{\mathbb{h}}</annotation></semantics></math>, consists of, for each <math id="S14.Thmthm5.p1.m8" class="ltx_Math" alttext="d\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d\geq 0</annotation></semantics></math>, an object <math id="S14.Thmthm5.p1.m9" class="ltx_Math" alttext="M_{d}^{\mathbb{h}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mi>d</mi><mi>𝕙</mi></msubsup><annotation encoding="application/x-tex">M_{d}^{\mathbb{h}}</annotation></semantics></math> of <math id="S14.Thmthm5.p1.m10" class="ltx_Math" alttext="\underline{\smash{\bf C}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐂</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf C}}</annotation></semantics></math>, a morphism</p>
<table id="S14.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex13.m1" class="ltx_Math" alttext="\iota_{d}^{{\mathbb{x}}_{0}\to{\mathbb{h}}}\sqcup\iota_{d}^{{\mathbb{x}}_{1}\to{\mathbb{h}}}:M_{d}^{{\mathbb{x}}_{0}}\sqcup M_{d}^{{\mathbb{x}}_{1}}\to M_{d}^{\mathbb{h}}" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>ι</mi><mi>d</mi><mrow><msub><mi>𝕩</mi><mn>0</mn></msub><mo stretchy="false">→</mo><mi>𝕙</mi></mrow></msubsup><mo>⊔</mo><msubsup><mi>ι</mi><mi>d</mi><mrow><msub><mi>𝕩</mi><mn>1</mn></msub><mo stretchy="false">→</mo><mi>𝕙</mi></mrow></msubsup></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mi>M</mi><mi>d</mi><msub><mi>𝕩</mi><mn>0</mn></msub></msubsup><mo>⊔</mo><msubsup><mi>M</mi><mi>d</mi><msub><mi>𝕩</mi><mn>1</mn></msub></msubsup></mrow><mo stretchy="false">→</mo><msubsup><mi>M</mi><mi>d</mi><mi>𝕙</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\iota_{d}^{{\mathbb{x}}_{0}\to{\mathbb{h}}}\sqcup\iota_{d}^{{\mathbb{x}}_{1}\to{\mathbb{h}}}:M_{d}^{{\mathbb{x}}_{0}}\sqcup M_{d}^{{\mathbb{x}}_{1}}\to M_{d}^{\mathbb{h}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.Thmthm5.p1.2" class="ltx_p">of codimension 1, and for each <math id="S14.Thmthm5.p1.m11" class="ltx_Math" alttext="d_{j}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>j</mi></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d_{j}\geq 0</annotation></semantics></math> resp. <math id="S14.Thmthm5.p1.m12" class="ltx_Math" alttext="d^{\prime}\geq 0" display="inline" intent=":literal"><semantics><mrow><msup><mi>d</mi><mo>′</mo></msup><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d^{\prime}\geq 0</annotation></semantics></math>, a morphism</p>
<table id="S14.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex14.m1" class="ltx_Math" alttext="\iota_{d_{j};d}^{\mathbb{h}}:M_{d_{j}}^{{\mathbb{f}}_{j}}\times M_{d}^{\mathbb{h}}\to X_{d_{j}+d}^{\mathbb{h}}\ \ \ \ {\rm resp.}\ \ \ \ \iota_{d;d^{\prime}}^{\mathbb{h}}:M_{d}^{\mathbb{h}}\times M_{d^{\prime}}^{\mathbb{f}^{\prime}}\to M_{d+d^{\prime}}^{\mathbb{h}}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>ι</mi><mrow><msub><mi>d</mi><mi>j</mi></msub><mo>;</mo><mi>d</mi></mrow><mi>𝕙</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mi>M</mi><msub><mi>d</mi><mi>j</mi></msub><msub><mi>𝕗</mi><mi>j</mi></msub></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>M</mi><mi>d</mi><mi>𝕙</mi></msubsup></mrow><mo stretchy="false">→</mo><msubsup><mi>X</mi><mrow><msub><mi>d</mi><mi>j</mi></msub><mo>+</mo><mi>d</mi></mrow><mi>𝕙</mi></msubsup></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mi>resp</mi></mrow><mo lspace="0em">.</mo><mspace style="width:2.167em;" width="2.167em"></mspace><mrow><msubsup><mi>ι</mi><mrow><mi>d</mi><mo>;</mo><msup><mi>d</mi><mo>′</mo></msup></mrow><mi>𝕙</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mi>M</mi><mi>d</mi><mi>𝕙</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>M</mi><msup><mi>d</mi><mo>′</mo></msup><msup><mi>𝕗</mi><mo>′</mo></msup></msubsup></mrow><mo stretchy="false">→</mo><msubsup><mi>M</mi><mrow><mi>d</mi><mo>+</mo><msup><mi>d</mi><mo>′</mo></msup></mrow><mi>𝕙</mi></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\iota_{d_{j};d}^{\mathbb{h}}:M_{d_{j}}^{{\mathbb{f}}_{j}}\times M_{d}^{\mathbb{h}}\to X_{d_{j}+d}^{\mathbb{h}}\ \ \ \ {\rm resp.}\ \ \ \ \iota_{d;d^{\prime}}^{\mathbb{h}}:M_{d}^{\mathbb{h}}\times M_{d^{\prime}}^{\mathbb{f}^{\prime}}\to M_{d+d^{\prime}}^{\mathbb{h}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.Thmthm5.p1.3" class="ltx_p">which satisfy the following conditions.</p>
<ol id="S14.I3" class="ltx_enumerate">
<li id="S14.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S14.I3.i1.p1" class="ltx_para ltx_noindent">
<p id="S14.I3.i1.p1.1" class="ltx_p">When <math id="S14.I3.i1.p1.m1" class="ltx_Math" alttext="d_{j}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>j</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d_{j}=0</annotation></semantics></math> resp. <math id="S14.I3.i1.p1.m2" class="ltx_Math" alttext="d^{\prime}=0" display="inline" intent=":literal"><semantics><mrow><msup><mi>d</mi><mo>′</mo></msup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d^{\prime}=0</annotation></semantics></math>, the morphisms <math id="S14.I3.i1.p1.m3" class="ltx_Math" alttext="\iota_{d_{j};d}^{{\mathbb{h}}}" display="inline" intent=":literal"><semantics><msubsup><mi>ι</mi><mrow><msub><mi>d</mi><mi>j</mi></msub><mo>;</mo><mi>d</mi></mrow><mi>𝕙</mi></msubsup><annotation encoding="application/x-tex">\iota_{d_{j};d}^{{\mathbb{h}}}</annotation></semantics></math> resp. <math id="S14.I3.i1.p1.m4" class="ltx_Math" alttext="\iota_{d;d^{\prime}}^{\mathbb{h}}" display="inline" intent=":literal"><semantics><msubsup><mi>ι</mi><mrow><mi>d</mi><mo>;</mo><msup><mi>d</mi><mo>′</mo></msup></mrow><mi>𝕙</mi></msubsup><annotation encoding="application/x-tex">\iota_{d;d^{\prime}}^{\mathbb{h}}</annotation></semantics></math> are the canonical isomorphisms.</p>
</div></li>
<li id="S14.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S14.I3.i2.p1" class="ltx_para ltx_noindent">
<p id="S14.I3.i2.p1.1" class="ltx_p">When <math id="S14.I3.i2.p1.m1" class="ltx_Math" alttext="d_{j}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>j</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d_{j}&gt;0</annotation></semantics></math> resp. <math id="S14.I3.i2.p1.m2" class="ltx_Math" alttext="d^{\prime}&gt;0" display="inline" intent=":literal"><semantics><mrow><msup><mi>d</mi><mo>′</mo></msup><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d^{\prime}&gt;0</annotation></semantics></math>, the morphisms <math id="S14.I3.i2.p1.m3" class="ltx_Math" alttext="\iota_{d_{j};d}^{{\mathbb{h}}}" display="inline" intent=":literal"><semantics><msubsup><mi>ι</mi><mrow><msub><mi>d</mi><mi>j</mi></msub><mo>;</mo><mi>d</mi></mrow><mi>𝕙</mi></msubsup><annotation encoding="application/x-tex">\iota_{d_{j};d}^{{\mathbb{h}}}</annotation></semantics></math> resp. <math id="S14.I3.i2.p1.m4" class="ltx_Math" alttext="\iota_{d;d^{\prime}}^{\mathbb{h}}" display="inline" intent=":literal"><semantics><msubsup><mi>ι</mi><mrow><mi>d</mi><mo>;</mo><msup><mi>d</mi><mo>′</mo></msup></mrow><mi>𝕙</mi></msubsup><annotation encoding="application/x-tex">\iota_{d;d^{\prime}}^{\mathbb{h}}</annotation></semantics></math> have codimension 1.</p>
</div></li>
<li id="S14.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S14.I3.i3.p1" class="ltx_para ltx_noindent">
<p id="S14.I3.i3.p1.1" class="ltx_p">For <math id="S14.I3.i3.p1.m1" class="ltx_Math" alttext="d_{j},d,d^{\prime}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>j</mi></msub><mo>,</mo><mi>d</mi><mo>,</mo><mrow><msup><mi>d</mi><mo>′</mo></msup><mo>≥</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">d_{j},d,d^{\prime}\geq 0</annotation></semantics></math>, the following diagram commutes.</p>
<table id="S14.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S14.Ex15.m1.pic1" class="ltx_picture ltx_markedasmath" height="73.62" overflow="visible" style="vertical-align:-59.88740056683055px" version="1.1" viewBox="54.70 59.89 230.68 73.62" width="230.68"><g transform="matrix(1 0 0 -1 54.69632970193156 73.61995179210773) translate(0,3.46) translate(54.7,0)"><g transform="translate(-54.7,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:7.31em;--ltx-fo-height:0.94em;--ltx-fo-depth:0.35em;font-size:10pt;" height="17.85" overflow="visible" transform="matrix(1 0 0 -1 0 13.04)" width="101.09"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S14.Ex15.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{M_{d_{j}}^{{\mathbb{f}}_{j}}\times M_{d}^{\mathbb{h}}\times M_{d^{\prime}}^{{\mathbb{f}}^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>M</mi><msub><mi>d</mi><mi>j</mi></msub><msub><mi>𝕗</mi><mi>j</mi></msub></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>M</mi><mi>d</mi><mi>𝕙</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>M</mi><msup><mi>d</mi><mo>′</mo></msup><msup><mi>𝕗</mi><mo>′</mo></msup></msubsup></mrow><annotation encoding="application/x-tex">\textstyle{M_{d_{j}}^{{\mathbb{f}}_{j}}\times M_{d}^{\mathbb{h}}\times M_{d^{\prime}}^{{\mathbb{f}}^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 54.69632970193156 -0.27673578005007266 L 54.69632970193156 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(87.91,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 54.69632970193156 -0.27673578005007266 L 87.90513003401956 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 87.90513003401956 -0.27673578005007266 L 87.90513003401956 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -12.414852283267175 L 0.27673578005007266 -12.414852283267175" fill="none" stroke="#000000"></path><g transform="translate(0,-33.86)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.85531946849704 L 0.27673578005007266 -12.414852283267175" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.85531946849704 L 0.27673578005007266 -33.85531946849704" fill="none" stroke="#000000"></path><g transform="translate(87.91,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:5.77em;--ltx-fo-height:0.94em;--ltx-fo-depth:0.35em;font-size:10pt;" height="17.85" overflow="visible" transform="matrix(1 0 0 -1 0 13.04)" width="79.77"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S14.Ex15.m1.pic1.m2" class="ltx_Math" alttext="\textstyle{M_{d_{j}+d}^{\mathbb{h}}\times M_{d^{\prime}}^{{\mathbb{f}}^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>M</mi><mrow><msub><mi>d</mi><mi>j</mi></msub><mo>+</mo><mi>d</mi></mrow><mi>𝕙</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>M</mi><msup><mi>d</mi><mo>′</mo></msup><msup><mi>𝕗</mi><mo>′</mo></msup></msubsup></mrow><annotation encoding="application/x-tex">\textstyle{M_{d_{j}+d}^{\mathbb{h}}\times M_{d^{\prime}}^{{\mathbb{f}}^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 131.66571976453318 -12.414852283267175 L 132.21919132463333 -12.414852283267175" fill="none" stroke="#000000"></path><g transform="translate(131.94,0) translate(0,-33.86)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 131.66571976453318 -33.85531946849704 L 132.21919132463333 -12.414852283267175" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 131.66571976453318 -33.85531946849704 L 132.21919132463333 -33.85531946849704" fill="none" stroke="#000000"></path><g transform="translate(-44.04,0) translate(0,-46.3) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:5.77em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.35em;font-size:10pt;" height="16.55" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="79.77"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S14.Ex15.m1.pic1.m3" class="ltx_Math" alttext="\textstyle{M_{d_{j}}^{{\mathbb{f}}_{j}}\times M_{d+d^{\prime}}^{{\mathbb{h}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>M</mi><msub><mi>d</mi><mi>j</mi></msub><msub><mi>𝕗</mi><mi>j</mi></msub></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>M</mi><mrow><mi>d</mi><mo>+</mo><msup><mi>d</mi><mo>′</mo></msup></mrow><mi>𝕙</mi></msubsup></mrow><annotation encoding="appl