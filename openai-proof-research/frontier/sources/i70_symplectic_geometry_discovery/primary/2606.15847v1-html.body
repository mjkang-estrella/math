0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-1.71112pt\hbox{$\scriptstyle{qF}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 80.30344pt\raise-32.68726pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 50.30344pt\raise-32.68726pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{}$}}}}}}}{\hbox{\kern 80.30344pt\raise-32.68726pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{H_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 170.05812pt\raise-38.07892pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-2.39168pt\hbox{$\scriptstyle{P}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 210.72702pt\raise-32.68726pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 178.58817pt\raise-32.68726pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{}$}}}}}}}{\hbox{\kern 210.72702pt\raise-32.68726pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{HF_{{{\mathbb{Z}}_{\sf p}}}(X)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 234.83813pt\raise-16.34363pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-1.8472pt\hbox{$\scriptstyle{\Phi_{{{\mathbb{Z}}_{\sf p}}}^{\mathbb{FM}}}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 234.83813pt\raise-11.75pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}\ignorespaces}}}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(26.1)</span></td></tr></tbody>
</table>
<p id="S26.SS2.SSS3.p2.3" class="ltx_p">The outer layer of this diagram is just (<a href="#S1.E7" title="In item 4 ‣ Theorem J (Floer-theoretic Steenrod operation). ‣ 1.2.3. Floer-theoretic Steenrod operation ‣ 1.2. Main results on equivariant Floer theory and Steenrod operations ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.7</span></a>). This would finish the proof of Theorem <a href="#Thmthma10" title="Theorem J (Floer-theoretic Steenrod operation). ‣ 1.2.3. Floer-theoretic Steenrod operation ‣ 1.2. Main results on equivariant Floer theory and Steenrod operations ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">J</span></a>.</p>
</div>
<div id="S26.SS2.SSS3.p3" class="ltx_para ltx_noindent">
<p id="S26.SS2.SSS3.p3.1" class="ltx_p">Now we prove Lemma <a href="#S26.Thmthm5" title="Lemma 26.5. ‣ 26.2.3. The multimodule homotopy ‣ 26.2. Proof of Theorem ‣ 26. The Equivariant Pair-of-Pants—Proof of Theorem ‣ Part IV EQUIVARIANT FLOER THEORY AND STEENROD OPERATIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26.5</span></a>. The proof is based on a multimodule homotopy between the following two multimodules. The first one is the Steenrod multimodule <math id="S26.SS2.SSS3.p3.m1" class="ltx_Math" alttext="\mathbb{X}^{\mathbb{QSt}}" display="inline" intent=":literal"><semantics><msup><mi>𝕏</mi><mrow><mi>ℚ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{X}^{\mathbb{QSt}}</annotation></semantics></math> over <math id="S26.SS2.SSS3.p3.m2" class="ltx_Math" alttext="(\mathbb{M},\ldots,\mathbb{M},{{\mathbb{E}}};\mathbb{M}\#{{\mathbb{E}}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝕄</mi><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>𝕄</mi><mo>,</mo><mi>𝔼</mi><mo>,</mo><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbb{M},\ldots,\mathbb{M},{{\mathbb{E}}};\mathbb{M}\#{{\mathbb{E}}})</annotation></semantics></math>, which will lead to the quantum Steenrod operation <math id="S26.SS2.SSS3.p3.m3" class="ltx_Math" alttext="{\it QSt}_{{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>𝑄𝑆𝑡</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{\it QSt}_{{\sf p}}</annotation></semantics></math>. The second one is the concatenation of three multimodules: first, there is the non-equivariant Morse-to-Floer bimodule <math id="S26.SS2.SSS3.p3.m4" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{MF}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{MF}}</annotation></semantics></math>. Consider the product of <math id="S26.SS2.SSS3.p3.m5" class="ltx_Math" alttext="{\sf p}" display="inline" intent=":literal"><semantics><mi>𝗉</mi><annotation encoding="application/x-tex">{\sf p}</annotation></semantics></math> copies of this bimodule with a copy of the diagonal bimodule <math id="S26.SS2.SSS3.p3.m6" class="ltx_Math" alttext="\mathbb{\Delta}^{{{\mathbb{E}}}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mi>𝔼</mi></msup><annotation encoding="application/x-tex">\mathbb{\Delta}^{{{\mathbb{E}}}}</annotation></semantics></math></p>
<table id="S26.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S26.Ex17.m1" class="ltx_Math" alttext="(\mathbb{B}^{\mathbb{MF}})^{\sf p}\times\mathbb{\Delta}^{{{\mathbb{E}}}}:=\underbrace{\mathbb{B}^{\mathbb{MF}}\times\cdots\times\mathbb{B}^{\mathbb{MF}}}_{{\sf p}}\times\mathbb{\Delta}^{{{\mathbb{E}}}{{\mathbb{E}}}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝔹</mi><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><mo stretchy="false">)</mo></mrow><mi>𝗉</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mi>𝔼</mi></msup></mrow><mo>:=</mo><mrow><munder><munder accentunder="true"><mrow><mi>𝔹</mi><msup><mrow></mrow><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi>𝔹</mi><msup><mrow></mrow><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup></mrow><mo stretchy="true">⏟</mo></munder><mi>𝗉</mi></munder><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi></mrow></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">(\mathbb{B}^{\mathbb{MF}})^{\sf p}\times\mathbb{\Delta}^{{{\mathbb{E}}}}:=\underbrace{\mathbb{B}^{\mathbb{MF}}\times\cdots\times\mathbb{B}^{\mathbb{MF}}}_{{\sf p}}\times\mathbb{\Delta}^{{{\mathbb{E}}}{{\mathbb{E}}}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S26.SS2.SSS3.p3.2" class="ltx_p">which is a multimodule over <math id="S26.SS2.SSS3.p3.m7" class="ltx_Math" alttext="(\mathbb{M},\ldots,{\mathbb{M}},{{\mathbb{E}}};\mathbb{F},\ldots,\mathbb{F},{{\mathbb{E}}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝕄</mi><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>𝕄</mi><mo>,</mo><mi>𝔼</mi><mo>,</mo><mi>𝔽</mi><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>𝔽</mi><mo>,</mo><mi>𝔼</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbb{M},\ldots,{\mathbb{M}},{{\mathbb{E}}};\mathbb{F},\ldots,\mathbb{F},{{\mathbb{E}}})</annotation></semantics></math>. It can be composed with the multimodule <math id="S26.SS2.SSS3.p3.m8" class="ltx_Math" alttext="{\mathbb{X}}^{\mathbb{FSt}}" display="inline" intent=":literal"><semantics><msup><mi>𝕏</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup><annotation encoding="application/x-tex">{\mathbb{X}}^{\mathbb{FSt}}</annotation></semantics></math>, followed by the equivariant SSP bimodule <math id="S26.SS2.SSS3.p3.m9" class="ltx_Math" alttext="{\mathbb{B}}_{{{\mathbb{Z}}_{\sf p}}}^{\mathbb{FM}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔹</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msubsup><annotation encoding="application/x-tex">{\mathbb{B}}_{{{\mathbb{Z}}_{\sf p}}}^{\mathbb{FM}}</annotation></semantics></math>.</p>
</div>
<div id="S26.SS2.SSS3.p4" class="ltx_para ltx_noindent">
<p id="S26.SS2.SSS3.p4.1" class="ltx_p">Before we move on, we specify the symmetries of the flow categories and multimodules. The flow categories <math id="S26.SS2.SSS3.p4.m1" class="ltx_Math" alttext="{\mathbb{M}}" display="inline" intent=":literal"><semantics><mi>𝕄</mi><annotation encoding="application/x-tex">{\mathbb{M}}</annotation></semantics></math> and <math id="S26.SS2.SSS3.p4.m2" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> carry the action by the group <math id="S26.SS2.SSS3.p4.m3" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math> and <math id="S26.SS2.SSS3.p4.m4" class="ltx_Math" alttext="{{\mathbb{E}}}" display="inline" intent=":literal"><semantics><mi>𝔼</mi><annotation encoding="application/x-tex">{{\mathbb{E}}}</annotation></semantics></math> carries the action by <math id="S26.SS2.SSS3.p4.m5" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>. The flow category <math id="S26.SS2.SSS3.p4.m6" class="ltx_Math" alttext="\mathbb{M}\#{{\mathbb{E}}}" display="inline" intent=":literal"><semantics><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi></mrow><annotation encoding="application/x-tex">\mathbb{M}\#{{\mathbb{E}}}</annotation></semantics></math> carries the action by (the trivially twisted) <math id="S26.SS2.SSS3.p4.m7" class="ltx_Math" alttext="\Pi\times\mathbb{Z}\times{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Π</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>ℤ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>ℤ</mi><mi>𝗉</mi></msub></mrow><annotation encoding="application/x-tex">\Pi\times\mathbb{Z}\times{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>. The multimodule <math id="S26.SS2.SSS3.p4.m8" class="ltx_Math" alttext="\mathbb{X}^{\mathbb{QSt}}" display="inline" intent=":literal"><semantics><msup><mi>𝕏</mi><mrow><mi>ℚ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{X}^{\mathbb{QSt}}</annotation></semantics></math> is equivariant with respect to the <math id="S26.SS2.SSS3.p4.m9" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-equivariant morphism of Novikov monoids</p>
<table id="S26.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S26.Ex18.m1" class="ltx_math_unparsed" alttext="\rho^{\mathbb{St}}:\Pi\times\cdots\times\Pi\times{\mathbb{Z}}\to\Pi\times{\mathbb{Z}}." display="block" intent=":literal"><semantics><mrow><mi>ρ</mi><msup><mrow></mrow><mrow><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mi mathvariant="normal">Π</mi><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi mathvariant="normal">Π</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>ℤ</mi><mo stretchy="false">→</mo><mi mathvariant="normal">Π</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>ℤ</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\rho^{\mathbb{St}}:\Pi\times\cdots\times\Pi\times{\mathbb{Z}}\to\Pi\times{\mathbb{Z}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S26.SS2.SSS3.p4.2" class="ltx_p">Moreover, as a weak bimodule (see Definition <a href="#S6.Thmthm17" title="Definition 6.17. ‣ 6.6. Weak flow categories, bimodules, and homotopies ‣ 6. Flow Categories, Multimodules, and Homotopies ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.17</span></a>), <math id="S26.SS2.SSS3.p4.m10" class="ltx_Math" alttext="\mathbb{X}^{\mathbb{QSt}}" display="inline" intent=":literal"><semantics><msup><mi>𝕏</mi><mrow><mi>ℚ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{X}^{\mathbb{QSt}}</annotation></semantics></math> is <math id="S26.SS2.SSS3.p4.m11" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-equivariant. It is easy to see that the same is true for the triple concatenation.</p>
</div>
<div id="S26.SS2.SSS3.p5" class="ltx_para ltx_noindent">
<p id="S26.SS2.SSS3.p5.1" class="ltx_p">Now fix a common outercollaring width. Also choose an integral action <math id="S26.SS2.SSS3.p5.m1" class="ltx_Math" alttext="{\mathcal{A}}_{\mathbb{F}}^{\Omega}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>𝔽</mi><mi mathvariant="normal">Ω</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{A}}_{\mathbb{F}}^{\Omega}</annotation></semantics></math> on <math id="S26.SS2.SSS3.p5.m2" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> and an integral action <math id="S26.SS2.SSS3.p5.m3" class="ltx_Math" alttext="{\mathcal{A}}_{{\mathbb{F}}^{\natural{\sf p}}}^{\Omega}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msup><mi>𝔽</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mi mathvariant="normal">Ω</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{A}}_{{\mathbb{F}}^{\natural{\sf p}}}^{\Omega}</annotation></semantics></math> which are compatible with respect to involved Floer data.</p>
</div>
<div id="S26.SS2.SSS3.p6" class="ltx_para ltx_noindent">
<p id="S26.SS2.SSS3.p6.1" class="ltx_p">Suppose <math id="S26.SS2.SSS3.p6.m1" class="ltx_Math" alttext="\tilde{\mathbb{F}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{F}}</annotation></semantics></math> is an AMS lift of <math id="S26.SS2.SSS3.p6.m2" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> subject to the outercollaring width and the action <math id="S26.SS2.SSS3.p6.m3" class="ltx_Math" alttext="{\mathcal{A}}_{\mathbb{F}}^{\Omega}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>𝔽</mi><mi mathvariant="normal">Ω</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{A}}_{\mathbb{F}}^{\Omega}</annotation></semantics></math>. Let <math id="S26.SS2.SSS3.p6.m4" class="ltx_Math" alttext="\tilde{\mathbb{F}}_{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><annotation encoding="application/x-tex">\tilde{\mathbb{F}}_{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math> be an equivariant AMS lift of the outercollaring of <math id="S26.SS2.SSS3.p6.m5" class="ltx_Math" alttext="{\mathbb{F}}_{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>𝔽</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><annotation encoding="application/x-tex">{\mathbb{F}}_{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math> subject to the outercollaring width and the action <math id="S26.SS2.SSS3.p6.m6" class="ltx_Math" alttext="{\mathcal{A}}_{{\mathbb{F}}^{\natural{\sf p}}}^{\Omega}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msup><mi>𝔽</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mi mathvariant="normal">Ω</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{A}}_{{\mathbb{F}}^{\natural{\sf p}}}^{\Omega}</annotation></semantics></math>. Let <math id="S26.SS2.SSS3.p6.m7" class="ltx_Math" alttext="\tilde{\mathbb{B}}^{\mathbb{MF}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝔹</mi><mo>~</mo></mover><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\tilde{\mathbb{B}}^{\mathbb{MF}}</annotation></semantics></math> is an AMS lift of the outercollaring of <math id="S26.SS2.SSS3.p6.m8" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{MF}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{MF}}</annotation></semantics></math> as a bimodule over <math id="S26.SS2.SSS3.p6.m9" class="ltx_math_unparsed" alttext="({}_{\lfloor}{\mathbb{M}},\tilde{\mathbb{F}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝕄</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mo>,</mo><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({}_{\lfloor}{\mathbb{M}},\tilde{\mathbb{F}})</annotation></semantics></math>. Let <math id="S26.SS2.SSS3.p6.m10" class="ltx_Math" alttext="\tilde{\mathbb{X}}^{\mathbb{FSt}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝕏</mi><mo>~</mo></mover><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup><annotation encoding="application/x-tex">\tilde{\mathbb{X}}^{\mathbb{FSt}}</annotation></semantics></math> be an equivariant AMS lift of the outercollaring of <math id="S26.SS2.SSS3.p6.m11" class="ltx_Math" alttext="{\mathbb{X}}^{\mathbb{FSt}}" display="inline" intent=":literal"><semantics><msup><mi>𝕏</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup><annotation encoding="application/x-tex">{\mathbb{X}}^{\mathbb{FSt}}</annotation></semantics></math> extending <math id="S26.SS2.SSS3.p6.m12" class="ltx_Math" alttext="\tilde{\mathbb{F}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{F}}</annotation></semantics></math> and <math id="S26.SS2.SSS3.p6.m13" class="ltx_Math" alttext="\tilde{\mathbb{F}}_{{{\mathbb{Z}}_{\sf p}}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><annotation encoding="application/x-tex">\tilde{\mathbb{F}}_{{{\mathbb{Z}}_{\sf p}}}</annotation></semantics></math>. Let <math id="S26.SS2.SSS3.p6.m14" class="ltx_Math" alttext="\tilde{\mathbb{B}}_{{{\mathbb{Z}}_{\sf p}}}^{\mathbb{FM}}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>𝔹</mi><mo>~</mo></mover><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msubsup><annotation encoding="application/x-tex">\tilde{\mathbb{B}}_{{{\mathbb{Z}}_{\sf p}}}^{\mathbb{FM}}</annotation></semantics></math> be an equivariant AMS lift of the outercollaring of <math id="S26.SS2.SSS3.p6.m15" class="ltx_Math" alttext="{\mathbb{B}}_{{{\mathbb{Z}}_{\sf p}}}^{\mathbb{FM}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔹</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msubsup><annotation encoding="application/x-tex">{\mathbb{B}}_{{{\mathbb{Z}}_{\sf p}}}^{\mathbb{FM}}</annotation></semantics></math>.</p>
</div>
<div id="S26.Thmthm6" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S26.Thmthm6.2" class="ltx_text ltx_font_bold">Lemma 26.6</span></span><span id="S26.Thmthm6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S26.Thmthm6.p1" class="ltx_para ltx_noindent">
<p id="S26.Thmthm6.p1.1" class="ltx_p"><span id="S26.Thmthm6.p1.1.1" class="ltx_text ltx_font_italic">There exists a <math id="S26.Thmthm6.p1.m1" class="ltx_Math" alttext="\rho^{\mathbb{St}}" display="inline" intent=":literal"><semantics><msup><mi>ρ</mi><mrow><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup><annotation encoding="application/x-tex">\rho^{\mathbb{St}}</annotation></semantics></math>-equivariant homotopy <math id="S26.Thmthm6.p1.m2" class="ltx_Math" alttext="\tilde{\mathbb{H}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ℍ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{H}}</annotation></semantics></math> from <math id="S26.Thmthm6.p1.m3" class="ltx_Math" alttext="\tilde{\mathbb{X}}^{\mathbb{QSt}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝕏</mi><mo>~</mo></mover><mrow><mi>ℚ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup><annotation encoding="application/x-tex">\tilde{\mathbb{X}}^{\mathbb{QSt}}</annotation></semantics></math> to</span></p>
<table id="S26.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S26.Ex19.m1" class="ltx_math_unparsed" alttext="\Big((\tilde{\mathbb{B}}^{\mathbb{MF}})^{\sf p}\times{}_{\lfloor}\mathbb{\Delta}^{{{\mathbb{E}}}{{\mathbb{E}}}}\Big)\circ\tilde{\mathbb{X}}^{\mathbb{FSt}}\circ\tilde{\mathbb{B}}_{{{\mathbb{Z}}_{\sf p}}}^{\mathbb{FM}}" display="block" intent=":literal"><semantics><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msup><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝔹</mi><mo>~</mo></mover><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow><mi>𝗉</mi></msup><mo rspace="0.222em">×</mo><mmultiscripts><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mrow></mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi></mrow><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mo maxsize="1.600em" minsize="1.600em" rspace="0.055em">)</mo></mrow><mo rspace="0.222em">∘</mo><msup><mover accent="true"><mi>𝕏</mi><mo>~</mo></mover><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mover accent="true"><mi>𝔹</mi><mo>~</mo></mover><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msubsup></mrow><annotation encoding="application/x-tex">\Big((\tilde{\mathbb{B}}^{\mathbb{MF}})^{\sf p}\times{}_{\lfloor}\mathbb{\Delta}^{{{\mathbb{E}}}{{\mathbb{E}}}}\Big)\circ\tilde{\mathbb{X}}^{\mathbb{FSt}}\circ\tilde{\mathbb{B}}_{{{\mathbb{Z}}_{\sf p}}}^{\mathbb{FM}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S26.Thmthm6.p1.2" class="ltx_p"><span id="S26.Thmthm6.p1.2.1" class="ltx_text ltx_font_italic">enriched in the category <math id="S26.Thmthm6.p1.m4" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>NC</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S26.SS2.SSS3.p7" class="ltx_para ltx_noindent">
<p id="S26.SS2.SSS3.p7.1" class="ltx_p">Assuming this lemma, we can conclude the assertion of Lemma <a href="#S26.Thmthm5" title="Lemma 26.5. ‣ 26.2.3. The multimodule homotopy ‣ 26.2. Proof of Theorem ‣ 26. The Equivariant Pair-of-Pants—Proof of Theorem ‣ Part IV EQUIVARIANT FLOER THEORY AND STEENROD OPERATIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26.5</span></a>. Since all actions are free, one can choose equivariant FOP transverse perturbations, firstly on the flow categories <math id="S26.SS2.SSS3.p7.m1" class="ltx_Math" alttext="\tilde{\mathbb{F}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{F}}</annotation></semantics></math> and <math id="S26.SS2.SSS3.p7.m2" class="ltx_Math" alttext="\tilde{\mathbb{F}}^{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msup><annotation encoding="application/x-tex">\tilde{\mathbb{F}}^{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>, then on the multimodules, and then on the homotopy <math id="S26.SS2.SSS3.p7.m3" class="ltx_Math" alttext="\tilde{\mathbb{H}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ℍ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{H}}</annotation></semantics></math>, thanks to Theorem <a href="#Thmthma14" title="Theorem N. ‣ 8.2. FOP perturbations on flow categories, multimodules, and homotopies ‣ 8. FOP Perturbations ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">N</span></a>. Then the corresponding homotopy <math id="S26.SS2.SSS3.p7.m4" class="ltx_Math" alttext="\mathring{\mathbb{H}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ℍ</mi><mo>̊</mo></mover><annotation encoding="application/x-tex">\mathring{\mathbb{H}}</annotation></semantics></math> enriched in <math id="S26.SS2.SSS3.p7.m5" class="ltx_Math" alttext="\underline{\smash{{\bf\Psi}{\bf Man}}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mrow><mi>𝚿</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐌𝐚𝐧</mi></mrow><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{{\bf\Psi}{\bf Man}}}</annotation></semantics></math> induces a chain homotopy <math id="S26.SS2.SSS3.p7.m6" class="ltx_Math" alttext="\Psi^{\mathring{\mathbb{H}}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Ψ</mi><mover accent="true"><mi>ℍ</mi><mo>̊</mo></mover></msup><annotation encoding="application/x-tex">\Psi^{\mathring{\mathbb{H}}}</annotation></semantics></math> between the two chain maps, the chain map corresponding to the quantum Steenrod operation and the composition of the three chain maps. This means the diagram (<a href="#S26.E1" title="In 26.2.3. The multimodule homotopy ‣ 26.2. Proof of Theorem ‣ 26. The Equivariant Pair-of-Pants—Proof of Theorem ‣ Part IV EQUIVARIANT FLOER THEORY AND STEENROD OPERATIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26.1</span></a>) commutes up to homotopy.</p>
</div>
</section>
<section id="S26.SS2.SSS4" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">26.2.4. </span>Proof of Lemma <a href="#S26.Thmthm6" title="Lemma 26.6. ‣ 26.2.3. The multimodule homotopy ‣ 26.2. Proof of Theorem ‣ 26. The Equivariant Pair-of-Pants—Proof of Theorem ‣ Part IV EQUIVARIANT FLOER THEORY AND STEENROD OPERATIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26.6</span></a></h5>

<div id="S26.SS2.SSS4.p1" class="ltx_para ltx_noindent">
<p id="S26.SS2.SSS4.p1.1" class="ltx_p">We first describe the homotopy in the category <math id="S26.SS2.SSS4.p1.m1" class="ltx_Math" alttext="\underline{\smash{\bf Top}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐓𝐨𝐩</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf Top}}</annotation></semantics></math> before the outercollaring, from <math id="S26.SS2.SSS4.p1.m2" class="ltx_Math" alttext="\mathbb{X}^{\mathbb{QSt}}" display="inline" intent=":literal"><semantics><msup><mi>𝕏</mi><mrow><mi>ℚ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{X}^{\mathbb{QSt}}</annotation></semantics></math> to the concatenation</p>
<table id="S26.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S26.Ex20.m1" class="ltx_Math" alttext="\mathbb{Y}:=\left((\mathbb{B}^{\mathbb{MF}})^{\sf p}\times\mathbb{\Delta}^{{{\mathbb{E}}}{{\mathbb{E}}}}\right)\circ\mathbb{X}^{\mathbb{FSt}}\circ\mathbb{B}_{{{\mathbb{Z}}_{\sf p}}}^{\mathbb{FM}}." display="block" intent=":literal"><semantics><mrow><mrow><mi>𝕐</mi><mo>:=</mo><mrow><mrow><mo>(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝔹</mi><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow><mi>𝗉</mi></msup><mo rspace="0.222em">×</mo><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi></mrow></msup></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">∘</mo><msup><mi>𝕏</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi>𝔹</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{Y}:=\left((\mathbb{B}^{\mathbb{MF}})^{\sf p}\times\mathbb{\Delta}^{{{\mathbb{E}}}{{\mathbb{E}}}}\right)\circ\mathbb{X}^{\mathbb{FSt}}\circ\mathbb{B}_{{{\mathbb{Z}}_{\sf p}}}^{\mathbb{FM}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S26.SS2.SSS4.p1.2" class="ltx_p">Consider the sphere <math id="S26.SS2.SSS4.p1.m3" class="ltx_Math" alttext="\Sigma_{\sf p}^{\mathbb{St}}\cong\mathbb{CP}^{1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Σ</mi><mi>𝗉</mi><mrow><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msubsup><mo>≅</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\Sigma_{\sf p}^{\mathbb{St}}\cong\mathbb{CP}^{1}</annotation></semantics></math> equipped with a 1-parameter family of Floer data <math id="S26.SS2.SSS4.p1.m4" class="ltx_Math" alttext="\sigma_{t}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\sigma_{t}</annotation></semantics></math> parametrized by <math id="S26.SS2.SSS4.p1.m5" class="ltx_Math" alttext="t\in[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[0,1]</annotation></semantics></math> where, when <math id="S26.SS2.SSS4.p1.m6" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math>, <math id="S26.SS2.SSS4.p1.m7" class="ltx_Math" alttext="\sigma_{t}\equiv 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mi>t</mi></msub><mo>≡</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\sigma_{t}\equiv 0</annotation></semantics></math> while as <math id="S26.SS2.SSS4.p1.m8" class="ltx_Math" alttext="t\to 1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo stretchy="false">→</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t\to 1</annotation></semantics></math>, the long necks around each negative markings have the Hamiltonian connection <math id="S26.SS2.SSS4.p1.m9" class="ltx_Math" alttext="Hdt" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">Hdt</annotation></semantics></math> which is <math id="S26.SS2.SSS4.p1.m10" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-equivariant while the long neck around the positive marking has the Hamiltonian <math id="S26.SS2.SSS4.p1.m11" class="ltx_Math" alttext="H^{\natural{\sf p}}dt" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">H^{\natural{\sf p}}dt</annotation></semantics></math>. Then for any <math id="S26.SS2.SSS4.p1.m12" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, <math id="S26.SS2.SSS4.p1.m13" class="ltx_Math" alttext="\sigma_{t}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\sigma_{t}</annotation></semantics></math> is invariant under the <math id="S26.SS2.SSS4.p1.m14" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-action on the domain.</p>
</div>
<figure id="S26.F10" class="ltx_figure"><object type="image/svg+xml" data="2606.15847v1/Steenrod_homotopy.svg" id="S26.F10.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:579/229;" width="579" height="229"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 10. </span>The concatenation of three multimodules. Notice that the gluing on the left have <math id="S26.F10.m2" class="ltx_Math" alttext="{\sf p}+1" display="inline" intent=":literal"><semantics><mrow><mi>𝗉</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\sf p}+1</annotation></semantics></math> gluing parameters and the gluing on the right has only one gluing parameter.</figcaption>
</figure>
<div id="S26.SS2.SSS4.p2" class="ltx_para ltx_noindent">
<p id="S26.SS2.SSS4.p2.1" class="ltx_p">Now we can describe the moduli spaces responsible for the homotopy. Choose</p>
<table id="S26.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S26.Ex21.m1" class="ltx_Math" alttext="x_{1}^{\mathbb{M}},\ldots,x_{\sf p}^{\mathbb{M}}\in{\rm Ob}{\mathbb{M}},\ x^{{\mathbb{E}}}\in{\rm Ob}{{\mathbb{E}}},\ y=(y^{\mathbb{M}},y^{{\mathbb{E}}})\in{\rm Ob}{\mathbb{M}}^{{\mathbb{E}}}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>x</mi><mn>1</mn><mi>𝕄</mi></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msubsup><mi>x</mi><mi>𝗉</mi><mi>𝕄</mi></msubsup><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></mrow><mo rspace="0.667em">,</mo><mrow><msup><mi>x</mi><mi>𝔼</mi></msup><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mi>y</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mi>𝕄</mi></msup><mo>,</mo><msup><mi>y</mi><mi>𝔼</mi></msup><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝕄</mi><mi>𝔼</mi></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">x_{1}^{\mathbb{M}},\ldots,x_{\sf p}^{\mathbb{M}}\in{\rm Ob}{\mathbb{M}},\ x^{{\mathbb{E}}}\in{\rm Ob}{{\mathbb{E}}},\ y=(y^{\mathbb{M}},y^{{\mathbb{E}}})\in{\rm Ob}{\mathbb{M}}^{{\mathbb{E}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S26.SS2.SSS4.p2.2" class="ltx_p">Consider the moduli space of triples <math id="S26.SS2.SSS4.p2.m1" class="ltx_Math" alttext="(t,u,v)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(t,u,v)</annotation></semantics></math> where <math id="S26.SS2.SSS4.p2.m2" class="ltx_Math" alttext="t\in[0,1)" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[0,1)</annotation></semantics></math>, <math id="S26.SS2.SSS4.p2.m3" class="ltx_Math" alttext="u:\Sigma_{\sf p}^{\mathbb{St}}\to X" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi mathvariant="normal">Σ</mi><mi>𝗉</mi><mrow><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msubsup><mo stretchy="false">→</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">u:\Sigma_{\sf p}^{\mathbb{St}}\to X</annotation></semantics></math> and <math id="S26.SS2.SSS4.p2.m4" class="ltx_Math" alttext="v:{\mathbb{R}}\to\widehat{S}^{\infty}" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ℝ</mi><mo stretchy="false">→</mo><msup><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi mathvariant="normal">∞</mi></msup></mrow></mrow><annotation encoding="application/x-tex">v:{\mathbb{R}}\to\widehat{S}^{\infty}</annotation></semantics></math> are smooth maps solving</p>
<table id="S26.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S26.Ex22.m1" class="ltx_Math" alttext="(\nabla^{\sigma_{t}})^{0,1}u=0,\ v^{\prime}(s)+\nabla f^{{\mathbb{E}}}(v(s))=0" display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><msup><mo>∇</mo><msub><mi>σ</mi><mi>t</mi></msub></msup><mo stretchy="false">)</mo></mrow><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo>=</mo><mn>0</mn></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mrow><msup><mi>v</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msup><mi>f</mi><mi>𝔼</mi></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>v</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">(\nabla^{\sigma_{t}})^{0,1}u=0,\ v^{\prime}(s)+\nabla f^{{\mathbb{E}}}(v(s))=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S26.SS2.SSS4.p2.3" class="ltx_p">and</p>
<table id="S26.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S26.Ex23.m1" class="ltx_math_unparsed" alttext="u(z_{i})\in W^{\rm us}_{x_{i}^{\mathbb{M}}},\ i=1,\ldots,{\sf p},\ u(z_{\infty})\in W^{\rm st}_{y^{\mathbb{M}}},\lim_{s\to-\infty}v(s)=x^{{{\mathbb{E}}}},\ \lim_{s\to+\infty}v(s)=y^{{\mathbb{E}}}." display="block" intent=":literal"><semantics><mrow><mi>u</mi><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msubsup><mi>W</mi><msubsup><mi>x</mi><mi>i</mi><mi>𝕄</mi></msubsup><mi>us</mi></msubsup><mo rspace="0.667em">,</mo><mi>i</mi><mo>=</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>𝗉</mi><mo rspace="0.667em">,</mo><mi>u</mi><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi mathvariant="normal">∞</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msubsup><mi>W</mi><msup><mi>y</mi><mi>𝕄</mi></msup><mi>st</mi></msubsup><mo>,</mo><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>s</mi><mo stretchy="false">→</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow></munder><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msup><mi>x</mi><mi>𝔼</mi></msup><mo rspace="0.389em">,</mo><munder><mo movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>s</mi><mo stretchy="false">→</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></mrow></munder><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msup><mi>y</mi><mi>𝔼</mi></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">u(z_{i})\in W^{\rm us}_{x_{i}^{\mathbb{M}}},\ i=1,\ldots,{\sf p},\ u(z_{\infty})\in W^{\rm st}_{y^{\mathbb{M}}},\lim_{s\to-\infty}v(s)=x^{{{\mathbb{E}}}},\ \lim_{s\to+\infty}v(s)=y^{{\mathbb{E}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S26.SS2.SSS4.p2.4" class="ltx_p">Let the space of solutions be <math id="S26.SS2.SSS4.p2.m5" class="ltx_math_unparsed" alttext="\mathring{M}_{x_{1}^{\mathbb{M}}\cdots x_{\sf p}^{\mathbb{M}}x^{{\mathbb{E}}};y}^{{\mathbb{H}}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>M</mi><mo>̊</mo></mover><msub><mrow></mrow><mrow><mi>x</mi><msub><mrow></mrow><mn>1</mn></msub><msup><mrow></mrow><mi>𝕄</mi></msup><mo lspace="0em" rspace="0em">⋯</mo><mi>x</mi><msub><mrow></mrow><mi>𝗉</mi></msub><msup><mrow></mrow><mi>𝕄</mi></msup><mi>x</mi><msup><mrow></mrow><mi>𝔼</mi></msup><mo>;</mo><mi>y</mi></mrow></msub><msup><mrow></mrow><mi>ℍ</mi></msup></mrow><annotation encoding="application/x-tex">\mathring{M}_{x_{1}^{\mathbb{M}}\cdots x_{\sf p}^{\mathbb{M}}x^{{\mathbb{E}}};y}^{{\mathbb{H}}}</annotation></semantics></math>. We may regard the constraints of <math id="S26.SS2.SSS4.p2.m6" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> at <math id="S26.SS2.SSS4.p2.m7" class="ltx_Math" alttext="z_{i}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mi>i</mi></msub><annotation encoding="application/x-tex">z_{i}</annotation></semantics></math> as adding gradient rays of <math id="S26.SS2.SSS4.p2.m8" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> in <math id="S26.SS2.SSS4.p2.m9" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. Then let</p>
<table id="S26.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S26.Ex24.m1" class="ltx_math_unparsed" alttext="M_{x_{1}^{\mathbb{M}}\cdots x_{\sf p}^{\mathbb{M}}x^{{\mathbb{E}}};y}^{{\mathbb{H}}}" display="block" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><mi>x</mi><msub><mrow></mrow><mn>1</mn></msub><msup><mrow></mrow><mi>𝕄</mi></msup><mo lspace="0em" rspace="0em">⋯</mo><mi>x</mi><msub><mrow></mrow><mi>𝗉</mi></msub><msup><mrow></mrow><mi>𝕄</mi></msup><mi>x</mi><msup><mrow></mrow><mi>𝔼</mi></msup><mo>;</mo><mi>y</mi></mrow></msub><msup><mrow></mrow><mi>ℍ</mi></msup></mrow><annotation encoding="application/x-tex">M_{x_{1}^{\mathbb{M}}\cdots x_{\sf p}^{\mathbb{M}}x^{{\mathbb{E}}};y}^{{\mathbb{H}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S26.SS2.SSS4.p2.5" class="ltx_p">be its natural compactification which allows sphere bubbling, Morse trajectory breaking, and breakings along Floer trajectories as <math id="S26.SS2.SSS4.p2.m10" class="ltx_Math" alttext="t\to 1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo stretchy="false">→</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t\to 1</annotation></semantics></math>. Moreover, when Morse trajectories break in the positive end, the trajectories broken off are regarded as flow lines in the product <math id="S26.SS2.SSS4.p2.m11" class="ltx_Math" alttext="X\times\widehat{S}^{\infty}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi mathvariant="normal">∞</mi></msup></mrow><annotation encoding="application/x-tex">X\times\widehat{S}^{\infty}</annotation></semantics></math>. The following lemma can be verified easily.</p>
</div>
<div id="S26.Thmthm7" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S26.Thmthm7.2" class="ltx_text ltx_font_bold">Lemma 26.7</span></span><span id="S26.Thmthm7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S26.Thmthm7.p1" class="ltx_para">
<p id="S26.Thmthm7.p1.1" class="ltx_p"><span id="S26.Thmthm7.p1.1.1" class="ltx_text ltx_font_italic">The collection of spaces <math id="S26.Thmthm7.p1.m1" class="ltx_math_unparsed" alttext="M_{x_{1}^{\mathbb{M}}\cdots x_{\sf p}^{\mathbb{M}}x^{{\mathbb{E}}};y}^{{\mathbb{H}}}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><mi>x</mi><msub><mrow></mrow><mn>1</mn></msub><msup><mrow></mrow><mi>𝕄</mi></msup><mo lspace="0em" rspace="0em">⋯</mo><mi>x</mi><msub><mrow></mrow><mi>𝗉</mi></msub><msup><mrow></mrow><mi>𝕄</mi></msup><mi>x</mi><msup><mrow></mrow><mi>𝔼</mi></msup><mo>;</mo><mi>y</mi></mrow></msub><msup><mrow></mrow><mi>ℍ</mi></msup></mrow><annotation encoding="application/x-tex">M_{x_{1}^{\mathbb{M}}\cdots x_{\sf p}^{\mathbb{M}}x^{{\mathbb{E}}};y}^{{\mathbb{H}}}</annotation></semantics></math> forms a homotopy from <math id="S26.Thmthm7.p1.m2" class="ltx_Math" alttext="{\mathbb{X}}^{\mathbb{QSt}}" display="inline" intent=":literal"><semantics><msup><mi>𝕏</mi><mrow><mi>ℚ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup><annotation encoding="application/x-tex">{\mathbb{X}}^{\mathbb{QSt}}</annotation></semantics></math> to the concatenation <math id="S26.Thmthm7.p1.m3" class="ltx_Math" alttext="{\mathbb{Y}}" display="inline" intent=":literal"><semantics><mi>𝕐</mi><annotation encoding="application/x-tex">{\mathbb{Y}}</annotation></semantics></math>. Moreover, this is a <math id="S26.Thmthm7.p1.m4" class="ltx_Math" alttext="\rho^{\mathbb{St}}" display="inline" intent=":literal"><semantics><msup><mi>ρ</mi><mrow><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup><annotation encoding="application/x-tex">\rho^{\mathbb{St}}</annotation></semantics></math>-equivariant Novikov homotopy and <math id="S26.Thmthm7.p1.m5" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-equivariant as a weak homotopy.</span></p>
</div>
</div>
</section>
<section id="S26.SS2.SSS5" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">26.2.5. </span>The AMS construction</h5>

<div id="S26.SS2.SSS5.p1" class="ltx_para ltx_noindent">
<p id="S26.SS2.SSS5.p1.1" class="ltx_p">Now we describe the AMS lift of the outercollaring of the homotopy <math id="S26.SS2.SSS5.p1.m1" class="ltx_Math" alttext="{\mathbb{H}}" display="inline" intent=":literal"><semantics><mi>ℍ</mi><annotation encoding="application/x-tex">{\mathbb{H}}</annotation></semantics></math>, given AMS lifts of involved Floer flow categories and multimodules.</p>
</div>
<div id="S26.SS2.SSS5.p2" class="ltx_para ltx_noindent">
<p id="S26.SS2.SSS5.p2.1" class="ltx_p">Recall the AMS lift <math id="S26.SS2.SSS5.p2.m1" class="ltx_Math" alttext="\tilde{\mathbb{F}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{F}}</annotation></semantics></math> of the Floer flow category <math id="S26.SS2.SSS5.p2.m2" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> contains a domain monotone flow category <math id="S26.SS2.SSS5.p2.m3" class="ltx_math_unparsed" alttext="{}_{\lfloor}{\mathbb{D}om}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>o</mi><mi>m</mi></mrow><annotation encoding="application/x-tex">{}_{\lfloor}{\mathbb{D}om}</annotation></semantics></math> enriched in <math id="S26.SS2.SSS5.p2.m4" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>ℂ</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}</annotation></semantics></math>. The AMS lift <math id="S26.SS2.SSS5.p2.m5" class="ltx_Math" alttext="\tilde{\mathbb{F}}_{{{\mathbb{Z}}_{\sf p}}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><annotation encoding="application/x-tex">\tilde{\mathbb{F}}_{{{\mathbb{Z}}_{\sf p}}}</annotation></semantics></math> also contains a domain monotone flow category <math id="S26.SS2.SSS5.p2.m6" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}_{{{\mathbb{Z}}_{\sf p}}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msub><mrow></mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}_{{{\mathbb{Z}}_{\sf p}}}</annotation></semantics></math> enriched in <math id="S26.SS2.SSS5.p2.m7" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>ℂ</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}</annotation></semantics></math> which also has a <math id="S26.SS2.SSS5.p2.m8" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-action corresponding to the domain rotation.</p>
</div>
<div id="S26.SS2.SSS5.p3" class="ltx_para ltx_noindent">
<p id="S26.SS2.SSS5.p3.1" class="ltx_p">The lift <math id="S26.SS2.SSS5.p3.m1" class="ltx_Math" alttext="\tilde{\mathbb{X}}^{\mathbb{QSt}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝕏</mi><mo>~</mo></mover><mrow><mi>ℚ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup><annotation encoding="application/x-tex">\tilde{\mathbb{X}}^{\mathbb{QSt}}</annotation></semantics></math> contains the domain monotone multimodule <math id="S26.SS2.SSS5.p3.m2" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}^{\mathbb{QSt}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mrow><mi>ℚ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}^{\mathbb{QSt}}</annotation></semantics></math>. The lift <math id="S26.SS2.SSS5.p3.m3" class="ltx_Math" alttext="\tilde{\mathbb{X}}^{\mathbb{FSt}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝕏</mi><mo>~</mo></mover><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup><annotation encoding="application/x-tex">\tilde{\mathbb{X}}^{\mathbb{FSt}}</annotation></semantics></math> has a similar monotone multimodule <math id="S26.SS2.SSS5.p3.m4" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}^{\mathbb{FSt}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}^{\mathbb{FSt}}</annotation></semantics></math>. There are also the monotone bimodules <math id="S26.SS2.SSS5.p3.m5" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}^{\mathbb{MF}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}^{\mathbb{MF}}</annotation></semantics></math> and <math id="S26.SS2.SSS5.p3.m6" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}_{{{\mathbb{Z}}_{\sf p}}}^{\mathbb{FM}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msub><mrow></mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><msup><mrow></mrow><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}_{{{\mathbb{Z}}_{\sf p}}}^{\mathbb{FM}}</annotation></semantics></math>. Then similar to previous cases of obtaining monotone homotopies involving concatenations and gluing, one can define a monotone homotopy from <math id="S26.SS2.SSS5.p3.m7" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}^{\mathbb{QSt}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mrow><mi>ℚ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}^{\mathbb{QSt}}</annotation></semantics></math> to the concatenation</p>
<table id="S26.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S26.Ex25.m1" class="ltx_math_unparsed" alttext="({}_{\lfloor}\mathbb{Dom}^{\mathbb{MF}})^{{\sf p}}\circ{}_{\lfloor}\mathbb{Dom}^{\mathbb{FSt}}\circ{}_{\lfloor}\mathbb{Dom}_{{\mathbb{Z}}_{\sf p}}^{\mathbb{FM}}." display="block" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝔻</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mi>𝕠</mi><msup><mi>𝕞</mi><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><mo stretchy="false">)</mo></mrow><mi>𝗉</mi></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><mmultiscripts><mi>𝔻</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mi>𝕠</mi><msup><mi>𝕞</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><mmultiscripts><mi>𝔻</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mi>𝕠</mi><msubsup><mi>𝕞</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msubsup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">({}_{\lfloor}\mathbb{Dom}^{\mathbb{MF}})^{{\sf p}}\circ{}_{\lfloor}\mathbb{Dom}^{\mathbb{FSt}}\circ{}_{\lfloor}\mathbb{Dom}_{{\mathbb{Z}}_{\sf p}}^{\mathbb{FM}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S26.SS2.SSS5.p3.2" class="ltx_p">This monotone homotopy, denoted by <math id="S26.SS2.SSS5.p3.m8" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}^{\mathbb{H}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mi>ℍ</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}^{\mathbb{H}}</annotation></semantics></math>, is enriched in <math id="S26.SS2.SSS5.p3.m9" class="ltx_Math" alttext="\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}" display="inline" intent=":literal"><semantics><msubsup><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><mi>rig</mi><mi>ℂ</mi></msubsup><annotation encoding="application/x-tex">\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}</annotation></semantics></math> and is <math id="S26.SS2.SSS5.p3.m10" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-equivariant.</p>
</div>
<div id="S26.SS2.SSS5.p4" class="ltx_para ltx_noindent">
<p id="S26.SS2.SSS5.p4.1" class="ltx_p">The remaining construction will be a tedious repetition of existing constructions. We only give a sketch. For a tuple of objects <math id="S26.SS2.SSS5.p4.m1" class="ltx_Math" alttext="x_{1}^{\mathbb{M}},\ldots,x_{\sf p}^{\mathbb{M}},x^{\mathbb{E}};y" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>x</mi><mn>1</mn><mi>𝕄</mi></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>x</mi><mi>𝗉</mi><mi>𝕄</mi></msubsup><mo>,</mo><msup><mi>x</mi><mi>𝔼</mi></msup><mo>;</mo><mi>y</mi></mrow><annotation encoding="application/x-tex">x_{1}^{\mathbb{M}},\ldots,x_{\sf p}^{\mathbb{M}},x^{\mathbb{E}};y</annotation></semantics></math>, by using the chosen integral actions, one can pull back the monotone homotopy to obtain objects</p>
<table id="S26.Ex26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S26.Ex26.m1" class="ltx_math_unparsed" alttext="{\mathcal{C}}_{x_{1}^{\mathbb{M}}\cdots x_{\sf p}^{\mathbb{M}}x^{{\mathbb{E}}};y}^{\mathbb{H}}\in{\rm Ob}{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}" display="block" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><msub><mrow></mrow><mrow><mi>x</mi><msub><mrow></mrow><mn>1</mn></msub><msup><mrow></mrow><mi>𝕄</mi></msup><mo lspace="0em" rspace="0em">⋯</mo><mi>x</mi><msub><mrow></mrow><mi>𝗉</mi></msub><msup><mrow></mrow><mi>𝕄</mi></msup><mi>x</mi><msup><mrow></mrow><mi>𝔼</mi></msup><mo>;</mo><mi>y</mi></mrow></msub><msup><mrow></mrow><mi>ℍ</mi></msup><mo>∈</mo><mi>Ob</mi><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>ℂ</mi></msup></mrow><annotation encoding="application/x-tex">{\mathcal{C}}_{x_{1}^{\mathbb{M}}\cdots x_{\sf p}^{\mathbb{M}}x^{{\mathbb{E}}};y}^{\mathbb{H}}\in{\rm Ob}{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S26.SS2.SSS5.p4.2" class="ltx_p">which describe configurations containing not only surfaces but also flow lines/rays. The choices we need for the AMS construction can all be extended from existing ones, including the group reduction and thickening data. All the extensions can be made in a <math id="S26.SS2.SSS5.p4.m2" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-equivariant way.</p>
</div>
<div id="S26.SS2.SSS5.p5" class="ltx_para ltx_noindent">
<p id="S26.SS2.SSS5.p5.1" class="ltx_p">After these choices, one obtains a <math id="S26.SS2.SSS5.p5.m1" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-equivariant lift of the outercollaring of <math id="S26.SS2.SSS5.p5.m2" class="ltx_Math" alttext="{\mathbb{H}}" display="inline" intent=":literal"><semantics><mi>ℍ</mi><annotation encoding="application/x-tex">{\mathbb{H}}</annotation></semantics></math> to <math id="S26.SS2.SSS5.p5.m3" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf S^{\rm rel}Kur}}_{\rm rig}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mrow><msup><mi>𝐒</mi><mi>rel</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐊𝐮𝐫</mi></mrow><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf S^{\rm rel}Kur}}_{\rm rig}</annotation></semantics></math>. There is no essential difference from previous cases of constructing vertical NC structures in a <math id="S26.SS2.SSS5.p5.m4" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-equivariant way. The stable smoothings can also be made equivariantly, first without requiring the matching condition between flow rays and maps defined on surfaces. The submersive condition implies that the incidence condition cuts down smooth Kuranishi spaces. By incorporating the domain stable complex structures, one obtains the lift of <math id="S26.SS2.SSS5.p5.m5" class="ltx_Math" alttext="{\mathbb{H}}" display="inline" intent=":literal"><semantics><mi>ℍ</mi><annotation encoding="application/x-tex">{\mathbb{H}}</annotation></semantics></math> to <math id="S26.SS2.SSS5.p5.m6" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf SKur}}_{\rm rig}^{\rm NC}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐒𝐊𝐮𝐫</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>NC</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf SKur}}_{\rm rig}^{\rm NC}</annotation></semantics></math>. By passing to the orbifold quotient, we obtain the final construction.</p>
</div>
</section>
</section>
</section>
<section id="S27" class="ltx_section">
<h3 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">27. </span>Quantitative Results about Equivariant Floer Theory</h3>

<div id="S27.p1" class="ltx_para ltx_noindent">
<p id="S27.p1.1" class="ltx_p">In this section we discuss the quantitative features of the equivariant Floer theory and prove Theorem <a href="#Thmthma13" title="Theorem M (Barcode stretching under prime iteration). ‣ 1.3.3. Quantitative features of equivariant Floer theory ‣ 1.3. Main results on quantitative Floer theory ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">M</span></a>.</p>
</div>
<section id="S27.SS1" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">27.1. </span>Filtration on the <math id="S27.SS1.m1" class="ltx_Math" alttext="{\sf p}" display="inline" intent=":literal"><semantics><mi>𝗉</mi><annotation encoding="application/x-tex">{\sf p}</annotation></semantics></math>-fold tensor product</h4>

<div id="S27.SS1.p1" class="ltx_para ltx_noindent">
<p id="S27.SS1.p1.1" class="ltx_p">Let <math id="S27.SS1.p1.m1" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> be a nondegenerate Hamiltonian on <math id="S27.SS1.p1.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. Let <math id="S27.SS1.p1.m3" class="ltx_Math" alttext="CF(H)" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF(H)</annotation></semantics></math> be a Floer complex associated to <math id="S27.SS1.p1.m4" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>, obtained by a particular AMS construction and FOP perturbation. The source of the equivariant pair-of-pants product is the complex</p>
<table id="S27.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex1.m1" class="ltx_Math" alttext="C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}})" display="block" intent=":literal"><semantics><mrow><msub><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.SS1.p1.2" class="ltx_p">which is the <math id="S27.SS1.p1.m5" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-invariant part of</p>
<table id="S27.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex2.m1" class="ltx_Math" alttext="CF(H)^{\otimes{\sf p}}\otimes CM(f^{{\mathbb{E}}})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mi>𝔼</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">CF(H)^{\otimes{\sf p}}\otimes CM(f^{{\mathbb{E}}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.SS1.p1.3" class="ltx_p">By our convention, this tensor product is a module over the Novikov field</p>
<table id="S27.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex3.m1" class="ltx_Math" alttext="\Lambda_{{\bf F}_{\sf p}}^{\Pi\oplus\cdots\oplus\Pi\oplus{\mathbb{Z}}}" display="block" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mrow><mi mathvariant="normal">Π</mi><mo>⊕</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>⊕</mo><mi mathvariant="normal">Π</mi><mo>⊕</mo><mi>ℤ</mi></mrow></msubsup><annotation encoding="application/x-tex">\Lambda_{{\bf F}_{\sf p}}^{\Pi\oplus\cdots\oplus\Pi\oplus{\mathbb{Z}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.SS1.p1.4" class="ltx_p">(where one has <math id="S27.SS1.p1.m6" class="ltx_Math" alttext="{\sf p}" display="inline" intent=":literal"><semantics><mi>𝗉</mi><annotation encoding="application/x-tex">{\sf p}</annotation></semantics></math> copies of <math id="S27.SS1.p1.m7" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math> in the exponent). Here within this section, without introducing further notations, we always change coefficients to the Novikov field <math id="S27.SS1.p1.m8" class="ltx_Math" alttext="\Lambda_{{\bf K}_{\sf p}}^{\Pi}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup><annotation encoding="application/x-tex">\Lambda_{{\bf K}_{\sf p}}^{\Pi}</annotation></semantics></math> using the summation homomorphism <math id="S27.SS1.p1.m9" class="ltx_Math" alttext="\Pi\oplus\cdots\oplus\Pi\to\Pi" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Π</mi><mo>⊕</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>⊕</mo><mi mathvariant="normal">Π</mi></mrow><mo stretchy="false">→</mo><mi mathvariant="normal">Π</mi></mrow><annotation encoding="application/x-tex">\Pi\oplus\cdots\oplus\Pi\to\Pi</annotation></semantics></math>. Then there is a filtration on</p>
<table id="S27.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex4.m1" class="ltx_Math" alttext="CF(H)^{\otimes{\sf p}}\otimes CM(f^{{\mathbb{E}}})" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mi>𝔼</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF(H)^{\otimes{\sf p}}\otimes CM(f^{{\mathbb{E}}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.SS1.p1.5" class="ltx_p">corresponding to the sum of the symplectic actions of the <math id="S27.SS1.p1.m10" class="ltx_Math" alttext="{\sf p}" display="inline" intent=":literal"><semantics><mi>𝗉</mi><annotation encoding="application/x-tex">{\sf p}</annotation></semantics></math> tensor factors such that the differential preserves this filtration. The filtration restricts to the <math id="S27.SS1.p1.m11" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-invariant part. Moreover, after changing coefficients to <math id="S27.SS1.p1.m12" class="ltx_Math" alttext="\Lambda_{{\bf K}_{\sf p}}^{\Pi}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup><annotation encoding="application/x-tex">\Lambda_{{\bf K}_{\sf p}}^{\Pi}</annotation></semantics></math>, one obtains a Floer-type complex over this Novikov field</p>
<table id="S27.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex5.m1" class="ltx_Math" alttext="\left(CF(H)^{\otimes{\sf p}}\otimes CM(f^{{\mathbb{E}}})\right)\otimes\Lambda_{{\bf K}_{\sf p}}^{\Pi}" display="block" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mrow><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mi>𝔼</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup></mrow><annotation encoding="application/x-tex">\left(CF(H)^{\otimes{\sf p}}\otimes CM(f^{{\mathbb{E}}})\right)\otimes\Lambda_{{\bf K}_{\sf p}}^{\Pi}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.SS1.p1.6" class="ltx_p">as well as its <math id="S27.SS1.p1.m13" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-invariant part.</p>
</div>
<div id="S27.SS1.p2" class="ltx_para ltx_noindent">
<p id="S27.SS1.p2.1" class="ltx_p">In principle one should hope to establish a chain-level inverse of the equivariant pair-of-pants product via the coproduct construction (cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib47" title="" class="ltx_ref">62</a>]</cite>). However, the corresponding AMS construction is quite involved. Since our main purpose of the quantitative aspects is to compare barcodes, instead of this potential direct approach, we use more algebraic treatment to bypass the coproduct construction (although we will make use of the local coproduct construction in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib47" title="" class="ltx_ref">62</a>]</cite>, see the proof of Lemma <a href="#S27.Thmthm11" title="Lemma 27.11. ‣ 27.4. Equivariant pair-of-pants product ‣ 27. Quantitative Results about Equivariant Floer Theory ‣ Part IV EQUIVARIANT FLOER THEORY AND STEENROD OPERATIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27.11</span></a>).</p>
</div>
<section id="S27.SS1.SSS1" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">27.1.1. </span>Homological perturbation</h5>

<div id="S27.SS1.SSS1.p1" class="ltx_para ltx_noindent">
<p id="S27.SS1.SSS1.p1.1" class="ltx_p">In view of localization, the cohomology of <math id="S27.SS1.SSS1.p1.m1" class="ltx_Math" alttext="C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}})</annotation></semantics></math> should only come from generators of the form <math id="S27.SS1.SSS1.p1.m2" class="ltx_math_unparsed" alttext="x\otimes\cdots\otimes x" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo lspace="0.222em">⊗</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">⊗</mo><mi>x</mi></mrow><annotation encoding="application/x-tex">x\otimes\cdots\otimes x</annotation></semantics></math> for <math id="S27.SS1.SSS1.p1.m3" class="ltx_Math" alttext="x\in{\rm Ob}{\mathbb{F}}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></mrow><annotation encoding="application/x-tex">x\in{\rm Ob}{\mathbb{F}}</annotation></semantics></math>, i.e., <math id="S27.SS1.SSS1.p1.m4" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-fixed points of <math id="S27.SS1.SSS1.p1.m5" class="ltx_Math" alttext="{\sf p}" display="inline" intent=":literal"><semantics><mi>𝗉</mi><annotation encoding="application/x-tex">{\sf p}</annotation></semantics></math>-tuples of <math id="S27.SS1.SSS1.p1.m6" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>-orbits. We use the homological perturbation argument to remove the effects of the other free <math id="S27.SS1.SSS1.p1.m7" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-orbits. We would like to construct a complex</p>
<table id="S27.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex6.m1" class="ltx_Math" alttext="C_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(CF(H)^{\otimes{\sf p}})" display="block" intent=":literal"><semantics><mrow><msubsup><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mi>red</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(CF(H)^{\otimes{\sf p}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.SS1.SSS1.p1.2" class="ltx_p">which is filtered chain homotopy equivalent to <math id="S27.SS1.SSS1.p1.m8" class="ltx_Math" alttext="C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}})</annotation></semantics></math> and which is only generated by the <math id="S27.SS1.SSS1.p1.m9" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-fixed points.</p>
</div>
<div id="S27.SS1.SSS1.p2" class="ltx_para ltx_noindent">
<p id="S27.SS1.SSS1.p2.1" class="ltx_p">Let <math id="S27.SS1.SSS1.p2.m1" class="ltx_Math" alttext="{\bf x}=(x_{1},\ldots,x_{\sf p})" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mi>𝗉</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bf x}=(x_{1},\ldots,x_{\sf p})</annotation></semantics></math> denote a <math id="S27.SS1.SSS1.p2.m2" class="ltx_Math" alttext="{\sf p}" display="inline" intent=":literal"><semantics><mi>𝗉</mi><annotation encoding="application/x-tex">{\sf p}</annotation></semantics></math>-tuple of capped <math id="S27.SS1.SSS1.p2.m3" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>-orbits. We write</p>
<table id="S27.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex7.m1" class="ltx_Math" alttext="CF(H)^{\otimes{\sf p}}\otimes CM(f^{{\mathbb{E}}})=\bigoplus_{{\bf x}\in\tilde{\mathcal{O}}(H)^{{\sf p}}}{\bf F}_{\sf p}\langle{\bf x}\rangle\otimes CM(f^{{\mathbb{E}}})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mi>𝔼</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mi>𝐱</mi><mo>∈</mo><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mi>𝗉</mi></msup></mrow></mrow></munder><mrow><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mi>𝐱</mi><mo rspace="0.055em" stretchy="false">⟩</mo></mrow></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mi>𝔼</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">CF(H)^{\otimes{\sf p}}\otimes CM(f^{{\mathbb{E}}})=\bigoplus_{{\bf x}\in\tilde{\mathcal{O}}(H)^{{\sf p}}}{\bf F}_{\sf p}\langle{\bf x}\rangle\otimes CM(f^{{\mathbb{E}}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.SS1.SSS1.p2.2" class="ltx_p">Here the infinite direct sum indicates we take a completion. This is a decomposition of <math id="S27.SS1.SSS1.p2.m4" class="ltx_Math" alttext="{\bf K}_{\sf p}" display="inline" intent=":literal"><semantics><msub><mi>𝐊</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{\bf K}_{\sf p}</annotation></semantics></math>-modules. Let <math id="S27.SS1.SSS1.p2.m5" class="ltx_Math" alttext="[{\bf x}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mi>𝐱</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[{\bf x}]</annotation></semantics></math> denote the <math id="S27.SS1.SSS1.p2.m6" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-orbit of <math id="S27.SS1.SSS1.p2.m7" class="ltx_Math" alttext="{\bf x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">{\bf x}</annotation></semantics></math>. Then there is a <math id="S27.SS1.SSS1.p2.m8" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-invariant summand</p>
<table id="S27.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex8.m1" class="ltx_Math" alttext="\bigoplus_{{\bf x}\in[{\bf x}]}{\bf F}_{\sf p}\langle{\bf x}\rangle\otimes CM(f^{{\mathbb{E}}})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mi>𝐱</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>𝐱</mi><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mi>𝐱</mi><mo rspace="0.055em" stretchy="false">⟩</mo></mrow></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mi>𝔼</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bigoplus_{{\bf x}\in[{\bf x}]}{\bf F}_{\sf p}\langle{\bf x}\rangle\otimes CM(f^{{\mathbb{E}}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.SS1.SSS1.p2.3" class="ltx_p">Its <math id="S27.SS1.SSS1.p2.m9" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-fixed part is denoted by</p>
<table id="S27.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex9.m1" class="ltx_Math" alttext="C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}},[{\bf x}])\subseteq C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo>,</mo><mrow><mo stretchy="false">[</mo><mi>𝐱</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊆</mo><mrow><msub><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}},[{\bf x}])\subseteq C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S27.Thmthm1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S27.Thmthm1.2" class="ltx_text ltx_font_bold">Lemma 27.1</span></span><span id="S27.Thmthm1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S27.Thmthm1.p1" class="ltx_para ltx_noindent">
<p id="S27.Thmthm1.p1.1" class="ltx_p"><span id="S27.Thmthm1.p1.1.1" class="ltx_text ltx_font_italic">The differential <math id="S27.Thmthm1.p1.m1" class="ltx_Math" alttext="d_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}" display="inline" intent=":literal"><semantics><msubsup><mi>d</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msubsup><annotation encoding="application/x-tex">d_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}</annotation></semantics></math> on <math id="S27.Thmthm1.p1.m2" class="ltx_Math" alttext="C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}})</annotation></semantics></math> admits a decomposition</span></p>
<table id="S27.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex10.m1" class="ltx_Math" alttext="d_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}=\delta_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}+D_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>d</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msubsup><mo>=</mo><mrow><msubsup><mi>δ</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msubsup><mo>+</mo><msubsup><mi>D</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">d_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}=\delta_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}+D_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.Thmthm1.p1.2" class="ltx_p"><span id="S27.Thmthm1.p1.2.1" class="ltx_text ltx_font_italic">which satisfies the following conditions.</span></p>
<ol id="S27.I1" class="ltx_enumerate">
<li id="S27.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S27.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="S27.I1.i1.p1.1" class="ltx_p"><math id="S27.I1.i1.p1.m1" class="ltx_Math" alttext="\delta_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}" display="inline" intent=":literal"><semantics><msubsup><mi>δ</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msubsup><annotation encoding="application/x-tex">\delta_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}</annotation></semantics></math><span id="S27.I1.i1.p1.1.1" class="ltx_text ltx_font_italic"> preserves the filtration and for each tuple </span><math id="S27.I1.i1.p1.m2" class="ltx_Math" alttext="{\bf x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">{\bf x}</annotation></semantics></math><span id="S27.I1.i1.p1.1.2" class="ltx_text ltx_font_italic">,</span></p>
<table id="S27.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex11.m1" class="ltx_Math" alttext="\delta_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}\Big(C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}},[{\bf x}])\Big)\subseteq C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}},[{\bf x}])." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>δ</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msub><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo>,</mo><mrow><mo stretchy="false">[</mo><mi>𝐱</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>⊆</mo><mrow><msub><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo>,</mo><mrow><mo stretchy="false">[</mo><mi>𝐱</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\delta_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}\Big(C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}},[{\bf x}])\Big)\subseteq C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}},[{\bf x}]).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S27.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S27.I1.i2.p1" class="ltx_para ltx_noindent">
<p id="S27.I1.i2.p1.1" class="ltx_p"><span id="S27.I1.i2.p1.1.1" class="ltx_text ltx_font_italic">The restriction of </span><math id="S27.I1.i2.p1.m1" class="ltx_Math" alttext="\delta_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}" display="inline" intent=":literal"><semantics><msubsup><mi>δ</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msubsup><annotation encoding="application/x-tex">\delta_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}</annotation></semantics></math><span id="S27.I1.i2.p1.1.2" class="ltx_text ltx_font_italic"> to each </span><math id="S27.I1.i2.p1.m2" class="ltx_Math" alttext="C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}},[{\bf x}])" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo>,</mo><mrow><mo stretchy="false">[</mo><mi>𝐱</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}},[{\bf x}])</annotation></semantics></math><span id="S27.I1.i2.p1.1.3" class="ltx_text ltx_font_italic">, denoted by </span><math id="S27.I1.i2.p1.m3" class="ltx_Math" alttext="\delta_{[{\bf x}]}" display="inline" intent=":literal"><semantics><msub><mi>δ</mi><mrow><mo stretchy="false">[</mo><mi>𝐱</mi><mo stretchy="false">]</mo></mrow></msub><annotation encoding="application/x-tex">\delta_{[{\bf x}]}</annotation></semantics></math><span id="S27.I1.i2.p1.1.4" class="ltx_text ltx_font_italic">, is a differential.</span></p>
</div></li>
<li id="S27.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S27.I1.i3.p1" class="ltx_para ltx_noindent">
<p id="S27.I1.i3.p1.1" class="ltx_p"><span id="S27.I1.i3.p1.1.1" class="ltx_text ltx_font_italic">If </span><math id="S27.I1.i3.p1.m1" class="ltx_Math" alttext="{\bf x}=(x,\ldots,x)" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bf x}=(x,\ldots,x)</annotation></semantics></math><span id="S27.I1.i3.p1.1.2" class="ltx_text ltx_font_italic"> is a </span><math id="S27.I1.i3.p1.m2" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math><span id="S27.I1.i3.p1.1.3" class="ltx_text ltx_font_italic">-fixed point, then </span><math id="S27.I1.i3.p1.m3" class="ltx_Math" alttext="\delta_{[{\bf x}]}" display="inline" intent=":literal"><semantics><msub><mi>δ</mi><mrow><mo stretchy="false">[</mo><mi>𝐱</mi><mo stretchy="false">]</mo></mrow></msub><annotation encoding="application/x-tex">\delta_{[{\bf x}]}</annotation></semantics></math><span id="S27.I1.i3.p1.1.4" class="ltx_text ltx_font_italic"> is trivial. If </span><math id="S27.I1.i3.p1.m4" class="ltx_Math" alttext="{\bf x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">{\bf x}</annotation></semantics></math><span id="S27.I1.i3.p1.1.5" class="ltx_text ltx_font_italic"> is not a fixed point, then the cohomology of </span><math id="S27.I1.i3.p1.m5" class="ltx_Math" alttext="\delta_{[{\bf x}]}" display="inline" intent=":literal"><semantics><msub><mi>δ</mi><mrow><mo stretchy="false">[</mo><mi>𝐱</mi><mo stretchy="false">]</mo></mrow></msub><annotation encoding="application/x-tex">\delta_{[{\bf x}]}</annotation></semantics></math><span id="S27.I1.i3.p1.1.6" class="ltx_text ltx_font_italic"> is trivial.</span></p>
</div></li>
<li id="S27.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S27.I1.i4.p1" class="ltx_para">
<p id="S27.I1.i4.p1.1" class="ltx_p"><span id="S27.I1.i4.p1.1.1" class="ltx_text ltx_font_italic">There exists a constant </span><math id="S27.I1.i4.p1.m1" class="ltx_Math" alttext="\epsilon_{H}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϵ</mi><mi>H</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon_{H}&gt;0</annotation></semantics></math><span id="S27.I1.i4.p1.1.2" class="ltx_text ltx_font_italic"> such that </span><math id="S27.I1.i4.p1.m2" class="ltx_Math" alttext="D_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}" display="inline" intent=":literal"><semantics><msubsup><mi>D</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msubsup><annotation encoding="application/x-tex">D_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}</annotation></semantics></math><span id="S27.I1.i4.p1.1.3" class="ltx_text ltx_font_italic"> increases the filtration by at least </span><math id="S27.I1.i4.p1.m3" class="ltx_Math" alttext="\epsilon_{H}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mi>H</mi></msub><annotation encoding="application/x-tex">\epsilon_{H}</annotation></semantics></math><span id="S27.I1.i4.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S27.SS1.SSS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S27.SS1.SSS1.p3" class="ltx_para ltx_noindent">
<p id="S27.SS1.SSS1.p3.1" class="ltx_p"><span id="S27.SS1.SSS1.p3.1.1" class="ltx_text">The differential on the tensor product <math id="S27.SS1.SSS1.p3.m1" class="ltx_Math" alttext="CF(H)^{\otimes{\sf p}}\otimes CM(f^{{\mathbb{E}}})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mi>𝔼</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF(H)^{\otimes{\sf p}}\otimes CM(f^{{\mathbb{E}}})</annotation></semantics></math>, denoted by <math id="S27.SS1.SSS1.p3.m2" class="ltx_Math" alttext="\tilde{d}_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>d</mi><mo>~</mo></mover><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msubsup><annotation encoding="application/x-tex">\tilde{d}_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}</annotation></semantics></math>, is the tensor product differential. Let <math id="S27.SS1.SSS1.p3.m3" class="ltx_Math" alttext="d_{H}:CF(H)\to CF(H)" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>H</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">d_{H}:CF(H)\to CF(H)</annotation></semantics></math> be the Floer differential and <math id="S27.SS1.SSS1.p3.m4" class="ltx_Math" alttext="d_{{{\mathbb{E}}}}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi>𝔼</mi></msub><annotation encoding="application/x-tex">d_{{{\mathbb{E}}}}</annotation></semantics></math> be the Morse differential on <math id="S27.SS1.SSS1.p3.m5" class="ltx_Math" alttext="CM(f^{{\mathbb{E}}})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mi>𝔼</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CM(f^{{\mathbb{E}}})</annotation></semantics></math>. Then the obvious <math id="S27.SS1.SSS1.p3.m6" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-equivariant decomposition</span></p>
<table id="S27.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex12.m1" class="ltx_Math" alttext="\begin{split}\tilde{d}_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}=&amp;\ \tilde{\delta}_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}+\tilde{D}_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}\\
:=&amp;\ \ast{\rm Id}_{CF(H)}\otimes\cdots\otimes{\rm Id}_{CF(H)}\otimes d_{{{\mathbb{E}}}}+d_{H}^{\otimes{\sf p}}\otimes{\rm Id}_{CM(f^{{\mathbb{E}}})}.\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><msubsup><mover accent="true"><mi>d</mi><mo>~</mo></mover><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msubsup><mo>=</mo><mphantom></mphantom></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><msubsup><mover accent="true"><mi>δ</mi><mo>~</mo></mover><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msubsup><mo>+</mo><msubsup><mover accent="true"><mi>D</mi><mo>~</mo></mover><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msubsup></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mo>:</mo><mo lspace="0em">⁣</mo><mo>=</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo rspace="0.222em">∗</mo><mi>Id</mi><msub><mrow></mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0.222em">⊗</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">⊗</mo><mi>Id</mi><msub><mrow></mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>d</mi><msub><mrow></mrow><mi>𝔼</mi></msub><mo>+</mo><mi>d</mi><msub><mrow></mrow><mi>H</mi></msub><msup><mrow></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>Id</mi><msub><mrow></mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mi>𝔼</mi></msup><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\tilde{d}_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}=&amp;\ \tilde{\delta}_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}+\tilde{D}_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}\\
:=&amp;\ \ast{\rm Id}_{CF(H)}\otimes\cdots\otimes{\rm Id}_{CF(H)}\otimes d_{{{\mathbb{E}}}}+d_{H}^{\otimes{\sf p}}\otimes{\rm Id}_{CM(f^{{\mathbb{E}}})}.\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.SS1.SSS1.p3.2" class="ltx_p"><span id="S27.SS1.SSS1.p3.2.1" class="ltx_text">Here <math id="S27.SS1.SSS1.p3.m7" class="ltx_Math" alttext="\ast=\pm 1" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∗</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>±</mo><mn>1</mn></mrow></mrow></mrow><annotation encoding="application/x-tex">\ast=\pm 1</annotation></semantics></math> depends on the degrees of the variables. The restriction to the <math id="S27.SS1.SSS1.p3.m8" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-invariant part provides the desired decomposition.
∎</span></p>
</div>
</div>
<div id="S27.SS1.SSS1.p4" class="ltx_para ltx_noindent">
<p id="S27.SS1.SSS1.p4.1" class="ltx_p">Now we would like to apply the homological perturbation argument to construct a differential on the chain group</p>
<table id="S27.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.E1.m1" class="ltx_math_unparsed" alttext="C_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(CF(H)^{\otimes{\sf p}}):=\bigoplus_{x\in\tilde{\mathcal{O}}(H)}C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}},x\otimes\cdots\otimes x)," display="block" intent=":literal"><semantics><mrow><msubsup><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mi>red</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>C</mi><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">:=</mo><munder><mo movablelimits="false">⨁</mo><mrow><mi>x</mi><mo>∈</mo><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><msub><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mrow><mo stretchy="false">(</mo><mi>C</mi><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup><mo>,</mo><mi>x</mi><mo lspace="0.222em">⊗</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">⊗</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">C_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(CF(H)^{\otimes{\sf p}}):=\bigoplus_{x\in\tilde{\mathcal{O}}(H)}C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}},x\otimes\cdots\otimes x),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(27.1)</span></td></tr></tbody>
</table>
<p id="S27.SS1.SSS1.p4.2" class="ltx_p">which is the cohomology of <math id="S27.SS1.SSS1.p4.m1" class="ltx_Math" alttext="C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}})</annotation></semantics></math> under the differential <math id="S27.SS1.SSS1.p4.m2" class="ltx_Math" alttext="\delta_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}" display="inline" intent=":literal"><semantics><msubsup><mi>δ</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msubsup><annotation encoding="application/x-tex">\delta_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}</annotation></semantics></math> defined above. Notice that there is a natural linear inclusion</p>
<table id="S27.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex13.m1" class="ltx_Math" alttext="\sigma:C_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(CF(H)^{\otimes{\sf p}})\to C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}})" display="block" intent=":literal"><semantics><mrow><mi>σ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mi>red</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\sigma:C_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(CF(H)^{\otimes{\sf p}})\to C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.SS1.SSS1.p4.3" class="ltx_p">and a projection</p>
<table id="S27.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex14.m1" class="ltx_Math" alttext="\pi:C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}})\to C_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(CF(H)^{\otimes{\sf p}})." display="block" intent=":literal"><semantics><mrow><mrow><mi>π</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msubsup><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mi>red</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\pi:C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}})\to C_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(CF(H)^{\otimes{\sf p}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S27.Thmthm2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S27.Thmthm2.2" class="ltx_text ltx_font_bold">Lemma 27.2</span></span><span id="S27.Thmthm2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S27.Thmthm2.p1" class="ltx_para ltx_noindent">
<p id="S27.Thmthm2.p1.1" class="ltx_p"><span id="S27.Thmthm2.p1.1.1" class="ltx_text ltx_font_italic">There exists a differential <math id="S27.Thmthm2.p1.m1" class="ltx_Math" alttext="D_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}" display="inline" intent=":literal"><semantics><msubsup><mi>D</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mi>red</mi></msubsup><annotation encoding="application/x-tex">D_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}</annotation></semantics></math> on <math id="S27.Thmthm2.p1.m2" class="ltx_Math" alttext="C_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(CF(H)^{\otimes{\sf p}})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mi>red</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(CF(H)^{\otimes{\sf p}})</annotation></semantics></math>, together with maps</span></p>
<table id="S27.EGx85" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S27.Ex15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S27.Ex15.m1" class="ltx_Math" alttext="\displaystyle\ \sigma^{\prime}:C_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(CF(H)^{\otimes{\sf p}})\to C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}}),\ " display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>σ</mi><mo>′</mo></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mi>red</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ \sigma^{\prime}:C_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(CF(H)^{\otimes{\sf p}})\to C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}}),\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S27.Ex15.m2" class="ltx_Math" alttext="\displaystyle\ \pi^{\prime}:C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}})\to C_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(CF(H)^{\otimes{\sf p}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>π</mi><mo>′</mo></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msubsup><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mi>red</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ \pi^{\prime}:C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}})\to C_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(CF(H)^{\otimes{\sf p}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.Thmthm2.p1.2" class="ltx_p"><span id="S27.Thmthm2.p1.2.1" class="ltx_text ltx_font_italic">satisfying the following conditions.</span></p>
<ol id="S27.I2" class="ltx_enumerate">
<li id="S27.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S27.I2.i1.p1" class="ltx_para ltx_noindent">
<p id="S27.I2.i1.p1.1" class="ltx_p"><math id="S27.I2.i1.p1.m1" class="ltx_Math" alttext="D_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}" display="inline" intent=":literal"><semantics><msubsup><mi>D</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mi>red</mi></msubsup><annotation encoding="application/x-tex">D_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}</annotation></semantics></math><span id="S27.I2.i1.p1.1.1" class="ltx_text ltx_font_italic"> strictly increases the energy filtration.</span></p>
</div></li>
<li id="S27.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S27.I2.i2.p1" class="ltx_para ltx_noindent">
<p id="S27.I2.i2.p1.1" class="ltx_p"><math id="S27.I2.i2.p1.m1" class="ltx_Math" alttext="\sigma^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>σ</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\sigma^{\prime}</annotation></semantics></math><span id="S27.I2.i2.p1.1.1" class="ltx_text ltx_font_italic"> and </span><math id="S27.I2.i2.p1.m2" class="ltx_Math" alttext="\pi^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\pi^{\prime}</annotation></semantics></math><span id="S27.I2.i2.p1.1.2" class="ltx_text ltx_font_italic"> strictly increase the energy filtration.</span></p>
</div></li>
<li id="S27.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S27.I2.i3.p1" class="ltx_para">
<p id="S27.I2.i3.p1.1" class="ltx_p"><math id="S27.I2.i3.p1.m1" class="ltx_Math" alttext="\tilde{\sigma}=\sigma+\sigma^{\prime}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mo>=</mo><mrow><mi>σ</mi><mo>+</mo><msup><mi>σ</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\tilde{\sigma}=\sigma+\sigma^{\prime}</annotation></semantics></math><span id="S27.I2.i3.p1.1.1" class="ltx_text ltx_font_italic"> and </span><math id="S27.I2.i3.p1.m2" class="ltx_Math" alttext="\tilde{\pi}=\pi+\pi^{\prime}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>π</mi><mo>~</mo></mover><mo>=</mo><mrow><mi>π</mi><mo>+</mo><msup><mi>π</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\tilde{\pi}=\pi+\pi^{\prime}</annotation></semantics></math><span id="S27.I2.i3.p1.1.2" class="ltx_text ltx_font_italic"> are filtered chain homotopy inverses to each other.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S27.SS1.SSS1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S27.SS1.SSS1.p5" class="ltx_para ltx_noindent">
<p id="S27.SS1.SSS1.p5.1" class="ltx_p"><span id="S27.SS1.SSS1.p5.1.1" class="ltx_text">For each <math id="S27.SS1.SSS1.p5.m1" class="ltx_Math" alttext="[{\bf x}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mi>𝐱</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[{\bf x}]</annotation></semantics></math> which is not a fixed point, since the cohomology of <math id="S27.SS1.SSS1.p5.m2" class="ltx_Math" alttext="\delta_{[{\bf x}]}" display="inline" intent=":literal"><semantics><msub><mi>δ</mi><mrow><mo stretchy="false">[</mo><mi>𝐱</mi><mo stretchy="false">]</mo></mrow></msub><annotation encoding="application/x-tex">\delta_{[{\bf x}]}</annotation></semantics></math> is trivial, one can find a chain homotopy between identity and zero, denoted by <math id="S27.SS1.SSS1.p5.m3" class="ltx_Math" alttext="\Theta_{[{\bf x}]}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">[</mo><mi>𝐱</mi><mo stretchy="false">]</mo></mrow></msub><annotation encoding="application/x-tex">\Theta_{[{\bf x}]}</annotation></semantics></math> satisfying</span></p>
<table id="S27.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex16.m1" class="ltx_Math" alttext="{\rm Id}=\delta_{[{\bf x}]}\Theta_{[{\bf x}]}+\Theta_{[{\bf x}]}\delta_{[{\bf x}]}." display="block" intent=":literal"><semantics><mrow><mrow><mi>Id</mi><mo>=</mo><mrow><mrow><msub><mi>δ</mi><mrow><mo stretchy="false">[</mo><mi>𝐱</mi><mo stretchy="false">]</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">[</mo><mi>𝐱</mi><mo stretchy="false">]</mo></mrow></msub></mrow><mo>+</mo><mrow><msub><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">[</mo><mi>𝐱</mi><mo stretchy="false">]</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mrow><mo stretchy="false">[</mo><mi>𝐱</mi><mo stretchy="false">]</mo></mrow></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\rm Id}=\delta_{[{\bf x}]}\Theta_{[{\bf x}]}+\Theta_{[{\bf x}]}\delta_{[{\bf x}]}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.SS1.SSS1.p5.2" class="ltx_p"><span id="S27.SS1.SSS1.p5.2.1" class="ltx_text">When <math id="S27.SS1.SSS1.p5.m4" class="ltx_Math" alttext="[{\bf x}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mi>𝐱</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[{\bf x}]</annotation></semantics></math> is a <math id="S27.SS1.SSS1.p5.m5" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-fxed point, define <math id="S27.SS1.SSS1.p5.m6" class="ltx_Math" alttext="\Theta_{[{\bf x}]}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">[</mo><mi>𝐱</mi><mo stretchy="false">]</mo></mrow></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Theta_{[{\bf x}]}=0</annotation></semantics></math>. One can choose <math id="S27.SS1.SSS1.p5.m7" class="ltx_Math" alttext="\Theta_{[{\bf x}]}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">[</mo><mi>𝐱</mi><mo stretchy="false">]</mo></mrow></msub><annotation encoding="application/x-tex">\Theta_{[{\bf x}]}</annotation></semantics></math> in a <math id="S27.SS1.SSS1.p5.m8" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>-equivariant way. Then define</span></p>
<table id="S27.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex17.m1" class="ltx_Math" alttext="\Theta:=\bigoplus_{[{\bf x}]\in\tilde{\mathcal{O}}(H)^{{\sf p}}/{{\mathbb{Z}}_{\sf p}}}\Theta_{[{\bf x}]}." display="block" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Θ</mi><mo rspace="0.111em">:=</mo><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mrow><mo stretchy="false">[</mo><mi>𝐱</mi><mo stretchy="false">]</mo></mrow><mo>∈</mo><mrow><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mi>𝗉</mi></msup></mrow><mo>/</mo><msub><mi>ℤ</mi><mi>𝗉</mi></msub></mrow></mrow></munder><msub><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">[</mo><mi>𝐱</mi><mo stretchy="false">]</mo></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Theta:=\bigoplus_{[{\bf x}]\in\tilde{\mathcal{O}}(H)^{{\sf p}}/{{\mathbb{Z}}_{\sf p}}}\Theta_{[{\bf x}]}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.SS1.SSS1.p5.3" class="ltx_p"><span id="S27.SS1.SSS1.p5.3.1" class="ltx_text">Then <math id="S27.SS1.SSS1.p5.m9" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math> preserves the filtration. Then following the explicit formula of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib36" title="" class="ltx_ref">37</a>]</cite> and <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib35" title="" class="ltx_ref">45</a>]</cite>), define</span></p>
<table id="S27.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex18.m1" class="ltx_Math" alttext="\tilde{D}_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}:=\pi\left(\sum_{l=0}^{\infty}(D_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}\circ\Theta)^{l}\right)D_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}\sigma=\pi D_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}\left(\sum_{l=0}^{\infty}(\Theta D_{{{\mathbb{Z}}_{\sf p}}})^{l}\right)\sigma." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>D</mi><mo>~</mo></mover><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msubsup><mo>:=</mo><mrow><mrow><mi>π</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false" rspace="0em">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>D</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><mi mathvariant="normal">Θ</mi></mrow><mo stretchy="false">)</mo></mrow><mi>l</mi></msup></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>D</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow><mo>=</mo><mrow><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>D</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false" rspace="0em">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></munderover><msup><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Θ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub></mrow><mo stretchy="false">)</mo></mrow><mi>l</mi></msup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tilde{D}_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}:=\pi\left(\sum_{l=0}^{\infty}(D_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}\circ\Theta)^{l}\right)D_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}\sigma=\pi D_{{{\mathbb{Z}}_{\sf p}}}^{\otimes{\sf p}}\left(\sum_{l=0}^{\infty}(\Theta D_{{{\mathbb{Z}}_{\sf p}}})^{l}\right)\sigma.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.SS1.SSS1.p5.4" class="ltx_p"><span id="S27.SS1.SSS1.p5.4.1" class="ltx_text">Its restriction to the <math id="S27.SS1.SSS1.p5.m10" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-invariant part is defined to be <math id="S27.SS1.SSS1.p5.m11" class="ltx_Math" alttext="D_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}" display="inline" intent=":literal"><semantics><msubsup><mi>D</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mi>red</mi></msubsup><annotation encoding="application/x-tex">D_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}</annotation></semantics></math>. The terms <math id="S27.SS1.SSS1.p5.m12" class="ltx_Math" alttext="\sigma^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>σ</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\sigma^{\prime}</annotation></semantics></math> and <math id="S27.SS1.SSS1.p5.m13" class="ltx_Math" alttext="\pi^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\pi^{\prime}</annotation></semantics></math> are also defined by explicit formulas (see, e.g. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib2" title="" class="ltx_ref">12</a>, Appendix B]</cite>), and we omit the details.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="S27.SS2" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">27.2. </span>Filtration on equivariant Floer cochain complex</h4>

<div id="S27.SS2.p1" class="ltx_para ltx_noindent">
<p id="S27.SS2.p1.1" class="ltx_p">Let <math id="S27.SS2.p1.m1" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> be a Hamiltonian on <math id="S27.SS2.p1.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> so that an equivariant Floer cochain complex <math id="S27.SS2.p1.m3" class="ltx_Math" alttext="CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}})</annotation></semantics></math> can be defined (see Theorem <a href="#Thmthma9" title="Theorem I (Equivariant Floer cohomology). ‣ 1.2.2. Equivariant Floer cohomology ‣ 1.2. Main results on equivariant Floer theory and Steenrod operations ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">I</span></a>). Recall that to define this chain group, we first consider the chain group</p>
<table id="S27.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex19.m1" class="ltx_math_unparsed" alttext="C({\mathbb{F}}^{\natural{\sf p}}\#{\mathbb{E}}):=\left\{\sum_{i=1}^{\infty}c_{i}p_{i}\otimes w_{i}\ \left|\ \begin{array}[]{l}c_{i}\in{\bf F}_{\sf p},\ p_{i}\in\tilde{\mathcal{O}}(H^{\natural{\sf p}}),\ w_{i}\in{\rm crit}f^{{\mathbb{E}}},\\
\displaystyle\inf_{i}{\mathcal{A}}(p_{i})&gt;-\infty,\ \inf_{i}f^{{\mathbb{E}}}(w_{i})&gt;-\infty,\\
\displaystyle\lim_{i\to\infty}{\mathcal{A}}(p_{i})+f^{{\mathbb{E}}}(w_{i})=+\infty\end{array}\right.\right\}" display="block" intent=":literal"><semantics><mrow><mi>C</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝔽</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mi>#</mi><mi>𝔼</mi><mo stretchy="false">)</mo></mrow><mo>:=</mo><mrow><mo>{</mo><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover><msub><mi>c</mi><mi>i</mi></msub><msub><mi>p</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>w</mi><mi>i</mi></msub><mo fence="false" rspace="0.667em">|</mo><mtable displaystyle="true" rowspacing="2.0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi>c</mi><msub><mrow></mrow><mi>i</mi></msub><mo>∈</mo><mi>𝐅</mi><msub><mrow></mrow><mi>𝗉</mi></msub><mo rspace="0.667em">,</mo><mi>p</mi><msub><mrow></mrow><mi>i</mi></msub><mo>∈</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>~</mo></mover><mo stretchy="false">(</mo><mi>H</mi><msup><mrow></mrow><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo><mo rspace="0.667em">,</mo><mi>w</mi><msub><mrow></mrow><mi>i</mi></msub><mo>∈</mo><mi>crit</mi><mi>f</mi><msup><mrow></mrow><mi>𝔼</mi></msup><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mo movablelimits="false" rspace="0.167em">inf</mo><msub><mrow></mrow><mi>i</mi></msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">(</mo><mi>p</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo rspace="0em">&gt;</mo><mo lspace="0em">−</mo><mi mathvariant="normal">∞</mi><mo rspace="0.389em">,</mo><mo movablelimits="false" rspace="0.167em">inf</mo><msub><mrow></mrow><mi>i</mi></msub><mi>f</mi><msup><mrow></mrow><mi>𝔼</mi></msup><mo stretchy="false">(</mo><mi>w</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo rspace="0em">&gt;</mo><mo lspace="0em">−</mo><mi mathvariant="normal">∞</mi><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>i</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>f</mi><mi>𝔼</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></mrow></mtd></mtr></mtable><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">C({\mathbb{F}}^{\natural{\sf p}}\#{\mathbb{E}}):=\left\{\sum_{i=1}^{\infty}c_{i}p_{i}\otimes w_{i}\ \left|\ \begin{array}[]{l}c_{i}\in{\bf F}_{\sf p},\ p_{i}\in\tilde{\mathcal{O}}(H^{\natural{\sf p}}),\ w_{i}\in{\rm crit}f^{{\mathbb{E}}},\\
\displaystyle\inf_{i}{\mathcal{A}}(p_{i})&gt;-\infty,\ \inf_{i}f^{{\mathbb{E}}}(w_{i})&gt;-\infty,\\
\displaystyle\lim_{i\to\infty}{\mathcal{A}}(p_{i})+f^{{\mathbb{E}}}(w_{i})=+\infty\end{array}\right.\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.SS2.p1.2" class="ltx_p">It is a module with a <math id="S27.SS2.p1.m4" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-action, and it is defined over the Novikov field <math id="S27.SS2.p1.m5" class="ltx_Math" alttext="\Lambda_{{\bf F}_{\sf p}}^{\mathbb{\Pi}}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi></msubsup><annotation encoding="application/x-tex">\Lambda_{{\bf F}_{\sf p}}^{\mathbb{\Pi}}</annotation></semantics></math>. The equivariant complex <math id="S27.SS2.p1.m6" class="ltx_Math" alttext="CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}})</annotation></semantics></math> is (roughly) its <math id="S27.SS2.p1.m7" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-fixed part.</p>
</div>
<div id="S27.Thmthm3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S27.Thmthm3.2" class="ltx_text ltx_font_bold">Lemma 27.3</span></span><span id="S27.Thmthm3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S27.Thmthm3.p1" class="ltx_para">
<p id="S27.Thmthm3.p1.1" class="ltx_p"><span id="S27.Thmthm3.p1.1.1" class="ltx_text ltx_font_italic">The <math id="S27.Thmthm3.p1.m1" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-invariant part <math id="S27.Thmthm3.p1.m2" class="ltx_Math" alttext="C(F^{\natural{\sf p}}\#{\mathbb{E}})_{{{\mathbb{Z}}_{\sf p}}}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>F</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">#</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi></mrow><mo stretchy="false">)</mo></mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub></mrow><annotation encoding="application/x-tex">C(F^{\natural{\sf p}}\#{\mathbb{E}})_{{{\mathbb{Z}}_{\sf p}}}</annotation></semantics></math> is a free module over <math id="S27.Thmthm3.p1.m3" class="ltx_Math" alttext="\Lambda_{{\bf F}_{\sf p}}^{\mathbb{\Pi}}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi></msubsup><annotation encoding="application/x-tex">\Lambda_{{\bf F}_{\sf p}}^{\mathbb{\Pi}}</annotation></semantics></math>. Its rank is <math id="S27.Thmthm3.p1.m4" class="ltx_Math" alttext="\#{\mathcal{O}}(H^{\natural{\sf p}})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">#</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\#{\mathcal{O}}(H^{\natural{\sf p}})</annotation></semantics></math> when <math id="S27.Thmthm3.p1.m5" class="ltx_Math" alttext="{\sf p}=2" display="inline" intent=":literal"><semantics><mrow><mi>𝗉</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">{\sf p}=2</annotation></semantics></math> and <math id="S27.Thmthm3.p1.m6" class="ltx_Math" alttext="2\#{\mathcal{O}}(H^{\natural{\sf p}})" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">#</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">2\#{\mathcal{O}}(H^{\natural{\sf p}})</annotation></semantics></math> when <math id="S27.Thmthm3.p1.m7" class="ltx_Math" alttext="{\sf p}&gt;2" display="inline" intent=":literal"><semantics><mrow><mi>𝗉</mi><mo>&gt;</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">{\sf p}&gt;2</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S27.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S27.SS2.p2" class="ltx_para ltx_noindent">
<p id="S27.SS2.p2.1" class="ltx_p"><span id="S27.SS2.p2.1.1" class="ltx_text">Choose for each contractible 1-periodic orbit a capping. Let <math id="S27.SS2.p2.m1" class="ltx_Math" alttext="p_{1},\ldots,p_{m}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>p</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">p_{1},\ldots,p_{m}</annotation></semantics></math> be these capped 1-periodic orbit. Let <math id="S27.SS2.p2.m2" class="ltx_Math" alttext="\tau\in{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><msub><mi>ℤ</mi><mi>𝗉</mi></msub></mrow><annotation encoding="application/x-tex">\tau\in{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math> be the generator. When <math id="S27.SS2.p2.m3" class="ltx_Math" alttext="{\sf p}=2" display="inline" intent=":literal"><semantics><mrow><mi>𝗉</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">{\sf p}=2</annotation></semantics></math>, define a map</span></p>
<table id="S27.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex20.m1" class="ltx_Math" alttext="F:\Lambda_{{\bf F}_{2}}^{\mathbb{\Pi}}\langle p_{1},\ldots,p_{m}\rangle\to C({\mathbb{F}}^{\natural{\sf p}}\#{\mathbb{E}})_{{\mathbb{Z}}_{2}}" display="block" intent=":literal"><semantics><mrow><mi>F</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐅</mi><mn>2</mn></msub><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>p</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>p</mi><mi>m</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝔽</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi></mrow><mo stretchy="false">)</mo></mrow><msub><mi>ℤ</mi><mn>2</mn></msub></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">F:\Lambda_{{\bf F}_{2}}^{\mathbb{\Pi}}\langle p_{1},\ldots,p_{m}\rangle\to C({\mathbb{F}}^{\natural{\sf p}}\#{\mathbb{E}})_{{\mathbb{Z}}_{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.SS2.p2.2" class="ltx_p"><span id="S27.SS2.p2.2.1" class="ltx_text">by</span></p>
<table id="S27.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex21.m1" class="ltx_Math" alttext="F(p_{\alpha})=p_{\alpha}\otimes w_{0}^{+}+\tau(p_{\alpha})\otimes w_{0}^{-}" display="block" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>p</mi><mi>α</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi>w</mi><mn>0</mn><mo>+</mo></msubsup></mrow><mo>+</mo><mrow><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>α</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi>w</mi><mn>0</mn><mo>−</mo></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">F(p_{\alpha})=p_{\alpha}\otimes w_{0}^{+}+\tau(p_{\alpha})\otimes w_{0}^{-}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.SS2.p2.3" class="ltx_p"><span id="S27.SS2.p2.3.1" class="ltx_text">where <math id="S27.SS2.p2.m4" class="ltx_Math" alttext="w_{0}^{\pm}" display="inline" intent=":literal"><semantics><msubsup><mi>w</mi><mn>0</mn><mo>±</mo></msubsup><annotation encoding="application/x-tex">w_{0}^{\pm}</annotation></semantics></math> are the two critical points of <math id="S27.SS2.p2.m5" class="ltx_Math" alttext="f^{{\mathbb{E}}}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mi>𝔼</mi></msup><annotation encoding="application/x-tex">f^{{\mathbb{E}}}</annotation></semantics></math> of index <math id="S27.SS2.p2.m6" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>. One can see that this is an isomorphism of free <math id="S27.SS2.p2.m7" class="ltx_Math" alttext="\Lambda_{{\bf F}_{\sf p}}^{\mathbb{\Pi}}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi></msubsup><annotation encoding="application/x-tex">\Lambda_{{\bf F}_{\sf p}}^{\mathbb{\Pi}}</annotation></semantics></math>-modules. On the other hand, when <math id="S27.SS2.p2.m8" class="ltx_Math" alttext="{\sf p}&gt;2" display="inline" intent=":literal"><semantics><mrow><mi>𝗉</mi><mo>&gt;</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">{\sf p}&gt;2</annotation></semantics></math>, define</span></p>
<table id="S27.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex22.m1" class="ltx_Math" alttext="F:\Lambda_{{\bf F}_{\sf p}}^{\mathbb{\Pi}}\langle p_{1},\ldots,p_{m},p_{1}\otimes\uptheta,\ldots,p_{m}\otimes\uptheta\rangle\to C({\mathbb{F}}^{\natural{\sf p}}\#{\mathbb{E}})_{{{\mathbb{Z}}_{\sf p}}}" display="block" intent=":literal"><semantics><mrow><mi>F</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>p</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>p</mi><mi>m</mi></msub><mo>,</mo><mrow><msub><mi>p</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi mathvariant="normal">θ</mi></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>p</mi><mi>m</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi mathvariant="normal">θ</mi></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝔽</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi></mrow><mo stretchy="false">)</mo></mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">F:\Lambda_{{\bf F}_{\sf p}}^{\mathbb{\Pi}}\langle p_{1},\ldots,p_{m},p_{1}\otimes\uptheta,\ldots,p_{m}\otimes\uptheta\rangle\to C({\mathbb{F}}^{\natural{\sf p}}\#{\mathbb{E}})_{{{\mathbb{Z}}_{\sf p}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.SS2.p2.4" class="ltx_p"><span id="S27.SS2.p2.4.1" class="ltx_text">by sending</span></p>
<table id="S27.EGx86" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S27.Ex23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S27.Ex23.m1" class="ltx_Math" alttext="\displaystyle\ F(p_{\alpha})=\sum_{j=1}^{\sf p}\tau^{j}(p_{\alpha})\otimes w_{0}^{j},\ " display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>𝗉</mi></munderover></mstyle><mrow><msup><mi>τ</mi><mi>j</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>α</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi>w</mi><mn>0</mn><mi>j</mi></msubsup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ F(p_{\alpha})=\sum_{j=1}^{\sf p}\tau^{j}(p_{\alpha})\otimes w_{0}^{j},\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S27.Ex23.m2" class="ltx_Math" alttext="\displaystyle\ F(p_{\alpha}\otimes\uptheta)=\sum_{j=1}^{\sf p}\tau^{j}(p_{\alpha})\otimes w_{1}^{j}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>p</mi><mi>α</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi mathvariant="normal">θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>𝗉</mi></munderover></mstyle><mrow><msup><mi>τ</mi><mi>j</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>α</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi>w</mi><mn>1</mn><mi>j</mi></msubsup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ F(p_{\alpha}\otimes\uptheta)=\sum_{j=1}^{\sf p}\tau^{j}(p_{\alpha})\otimes w_{1}^{j},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.SS2.p2.5" class="ltx_p"><span id="S27.SS2.p2.5.1" class="ltx_text">where <math id="S27.SS2.p2.m9" class="ltx_Math" alttext="w_{0}^{j}" display="inline" intent=":literal"><semantics><msubsup><mi>w</mi><mn>0</mn><mi>j</mi></msubsup><annotation encoding="application/x-tex">w_{0}^{j}</annotation></semantics></math>, <math id="S27.SS2.p2.m10" class="ltx_Math" alttext="w_{1}^{j}" display="inline" intent=":literal"><semantics><msubsup><mi>w</mi><mn>1</mn><mi>j</mi></msubsup><annotation encoding="application/x-tex">w_{1}^{j}</annotation></semantics></math> are the critical points of <math id="S27.SS2.p2.m11" class="ltx_Math" alttext="f^{{\mathbb{E}}}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mi>𝔼</mi></msup><annotation encoding="application/x-tex">f^{{\mathbb{E}}}</annotation></semantics></math> of index <math id="S27.SS2.p2.m12" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> and <math id="S27.SS2.p2.m13" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>. One can also verify that <math id="S27.SS2.p2.m14" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> is a linear isomorphism.
∎</span></p>
</div>
</div>
<div id="S27.SS2.p3" class="ltx_para ltx_noindent">
<p id="S27.SS2.p3.1" class="ltx_p">Note the difference between the Novikov fields <math id="S27.SS2.p3.m1" class="ltx_Math" alttext="\Lambda_{{\bf F}_{\sf p}}^{\mathbb{\Pi}}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi></msubsup><annotation encoding="application/x-tex">\Lambda_{{\bf F}_{\sf p}}^{\mathbb{\Pi}}</annotation></semantics></math> and <math id="S27.SS2.p3.m2" class="ltx_Math" alttext="\Lambda_{{\bf K}_{\sf p}}^{\Pi}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup><annotation encoding="application/x-tex">\Lambda_{{\bf K}_{\sf p}}^{\Pi}</annotation></semantics></math>, where the latter does not require the pole order of the variable <math id="S27.SS2.p3.m3" class="ltx_Math" alttext="\mathtt{U}" display="inline" intent=":literal"><semantics><mi>𝚄</mi><annotation encoding="application/x-tex">\mathtt{U}</annotation></semantics></math> or <math id="S27.SS2.p3.m4" class="ltx_Math" alttext="\uptheta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">θ</mi><annotation encoding="application/x-tex">\uptheta</annotation></semantics></math> is bounded. Then we can write the chain group after tensoring with this larger Novikov field by</p>
<table id="S27.SS2.p3.2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.SS2.p3.m5" class="ltx_Math" alttext="CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}};\Lambda_{{\bf K}_{\sf p}}^{\Pi})=C({\mathbb{F}}^{\natural{\sf p}}\#{{\mathbb{E}}})_{{{\mathbb{Z}}_{\sf p}}}\otimes\Lambda_{{\bf K}_{\sf p}}^{\Pi}\\
\cong\Big\{\sum_{i=1}^{\infty}\tilde{c}_{i}p_{i}\ |\ \tilde{c}_{i}\in\widetilde{\bf K}_{\sf p},\ p_{i}\in\tilde{\mathcal{O}}(H^{\natural{\sf p}}),\ \lim_{i\to\infty}{\mathcal{A}}_{H^{\natural{\sf p}}}(p_{i})=+\infty\Big\}." display="block" intent=":literal"><semantics><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo mathsize="0.700em">,</mo><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝔽</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mo>≅</mo><mo stretchy="false">{</mo><mo lspace="0em" movablelimits="false">∑</mo><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi mathvariant="normal">∞</mi></msup><mover accent="true"><mi>c</mi><mo>~</mo></mover><msub><mrow></mrow><mi>i</mi></msub><mi>p</mi><msub><mrow></mrow><mi>i</mi></msub><mo fence="false" lspace="0.500em" rspace="0.667em" stretchy="false">|</mo><mover accent="true"><mi>c</mi><mo>~</mo></mover><msub><mrow></mrow><mi>i</mi></msub><mo>∈</mo><mover accent="true"><mi>𝐊</mi><mo>~</mo></mover><msub><mrow></mrow><mi>𝗉</mi></msub><mo rspace="1.167em">,</mo><mi>p</mi><msub><mrow></mrow><mi>i</mi></msub><mo>∈</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>~</mo></mover><mo stretchy="false">(</mo><mi>H</mi><msup><mrow></mrow><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo><mo rspace="0.889em">,</mo><mo movablelimits="false" rspace="0.167em">lim</mo><msub><mrow></mrow><mrow><mi>i</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mrow></mrow><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup></msub><mo stretchy="false">(</mo><mi>p</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo rspace="0em">=</mo><mo lspace="0em">+</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">}</mo><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}};\Lambda_{{\bf K}_{\sf p}}^{\Pi})=C({\mathbb{F}}^{\natural{\sf p}}\#{{\mathbb{E}}})_{{{\mathbb{Z}}_{\sf p}}}\otimes\Lambda_{{\bf K}_{\sf p}}^{\Pi}\\
\cong\Big\{\sum_{i=1}^{\infty}\tilde{c}_{i}p_{i}\ |\ \tilde{c}_{i}\in\widetilde{\bf K}_{\sf p},\ p_{i}\in\tilde{\mathcal{O}}(H^{\natural{\sf p}}),\ \lim_{i\to\infty}{\mathcal{A}}_{H^{\natural{\sf p}}}(p_{i})=+\infty\Big\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S27.SS2.p4" class="ltx_para ltx_noindent">
<p id="S27.SS2.p4.1" class="ltx_p">To directly use results from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib14" title="" class="ltx_ref">69</a>]</cite>, change coefficients to <math id="S27.SS2.p4.m1" class="ltx_Math" alttext="\Lambda_{{\bf K}_{\sf p}}^{|\Pi|}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mrow><mo stretchy="false">|</mo><mi mathvariant="normal">Π</mi><mo stretchy="false">|</mo></mrow></msubsup><annotation encoding="application/x-tex">\Lambda_{{\bf K}_{\sf p}}^{|\Pi|}</annotation></semantics></math>, which becomes only <math id="S27.SS2.p4.m2" class="ltx_Math" alttext="{\mathbb{Z}}_{2}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">{\mathbb{Z}}_{2}</annotation></semantics></math>-graded. Recall from (<a href="#S7.E6" title="In 7.5.1. Nonarchimedean linear algebra ‣ 7.5. Quantitative theories ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.6</span></a>) the meaning of the notation <math id="S27.SS2.p4.m3" class="ltx_Math" alttext="|\Pi|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi mathvariant="normal">Π</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\Pi|</annotation></semantics></math>.</p>
</div>
<div id="S27.Thmthm4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S27.Thmthm4.2" class="ltx_text ltx_font_bold">Lemma 27.4</span></span><span id="S27.Thmthm4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S27.Thmthm4.p1" class="ltx_para ltx_noindent">
<p id="S27.Thmthm4.p1.1" class="ltx_p"><span id="S27.Thmthm4.p1.1.1" class="ltx_text ltx_font_italic">The complex</span></p>
<table id="S27.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex24.m1" class="ltx_Math" alttext="CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}};\Lambda_{{\bf K}_{\sf p}}^{|\Pi|}):=CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}};\Lambda_{{\bf K}_{\sf p}}^{\Pi})\otimes\Lambda_{{\bf K}_{\sf p}}^{|\Pi|}" display="block" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo>,</mo><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mrow><mo stretchy="false">|</mo><mi mathvariant="normal">Π</mi><mo stretchy="false">|</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo>,</mo><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mrow><mo stretchy="false">|</mo><mi mathvariant="normal">Π</mi><mo stretchy="false">|</mo></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}};\Lambda_{{\bf K}_{\sf p}}^{|\Pi|}):=CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}};\Lambda_{{\bf K}_{\sf p}}^{\Pi})\otimes\Lambda_{{\bf K}_{\sf p}}^{|\Pi|}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.Thmthm4.p1.2" class="ltx_p"><span id="S27.Thmthm4.p1.2.1" class="ltx_text ltx_font_italic">is a Floer-type complex (Definition <a href="#S7.Thmthm34" title="Definition 7.34. ‣ 7.5.1. Nonarchimedean linear algebra ‣ 7.5. Quantitative theories ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.34</span></a>) over the Novikov field <math id="S27.Thmthm4.p1.m1" class="ltx_Math" alttext="\Lambda_{{\bf K}_{\sf p}}^{|\Pi|}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mrow><mo stretchy="false">|</mo><mi mathvariant="normal">Π</mi><mo stretchy="false">|</mo></mrow></msubsup><annotation encoding="application/x-tex">\Lambda_{{\bf K}_{\sf p}}^{|\Pi|}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S27.SS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S27.SS2.p5" class="ltx_para">
<p id="S27.SS2.p5.1" class="ltx_p"><span id="S27.SS2.p5.1.1" class="ltx_text">To see this, we first need to prove that <math id="S27.SS2.p5.m1" class="ltx_Math" alttext="CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}};\Lambda_{{\bf K}_{\sf p}}^{|\Pi|})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo>,</mo><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mrow><mo stretchy="false">|</mo><mi mathvariant="normal">Π</mi><mo stretchy="false">|</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}};\Lambda_{{\bf K}_{\sf p}}^{|\Pi|})</annotation></semantics></math> is orthogonalizable. Indeed, it is the <math id="S27.SS2.p5.m2" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-invariant subspace of the cochain complex <math id="S27.SS2.p5.m3" class="ltx_Math" alttext="C({\mathbb{F}}^{\natural{\sf p}}\#{\mathbb{E}})\otimes\Lambda_{{\bf K}_{\sf p}}^{|\Pi|}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝔽</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mrow><mo stretchy="false">|</mo><mi mathvariant="normal">Π</mi><mo stretchy="false">|</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">C({\mathbb{F}}^{\natural{\sf p}}\#{\mathbb{E}})\otimes\Lambda_{{\bf K}_{\sf p}}^{|\Pi|}</annotation></semantics></math>, which is orthogonalizable. Then by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib14" title="" class="ltx_ref">69</a>, Corollary 2.17]</cite>, the subspace <math id="S27.SS2.p5.m4" class="ltx_Math" alttext="CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}};\Lambda_{{\bf K}_{\sf p}}^{|\Pi|})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo>,</mo><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mrow><mo stretchy="false">|</mo><mi mathvariant="normal">Π</mi><mo stretchy="false">|</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}};\Lambda_{{\bf K}_{\sf p}}^{|\Pi|})</annotation></semantics></math> is also orthogonalizable. On the other hand, the differential preserves the energy filtration, hence <math id="S27.SS2.p5.m5" class="ltx_Math" alttext="CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}};\Lambda_{{\bf K}_{\sf p}}^{|\Pi|})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo>,</mo><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mrow><mo stretchy="false">|</mo><mi mathvariant="normal">Π</mi><mo stretchy="false">|</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}};\Lambda_{{\bf K}_{\sf p}}^{|\Pi|})</annotation></semantics></math> is a Floer-type complex.
∎</span></p>
</div>
</div>
<div id="S27.SS2.p6" class="ltx_para ltx_noindent">
<p id="S27.SS2.p6.1" class="ltx_p">As a corollary, by the basic construction of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib14" title="" class="ltx_ref">69</a>]</cite>, the complex <math id="S27.SS2.p6.m1" class="ltx_Math" alttext="CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}};\Lambda_{{\bf K}_{\sf p}}^{|\Pi|})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo>,</mo><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mrow><mo stretchy="false">|</mo><mi mathvariant="normal">Π</mi><mo stretchy="false">|</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}};\Lambda_{{\bf K}_{\sf p}}^{|\Pi|})</annotation></semantics></math> has well-defined verbose and concise barcodes.</p>
</div>
<div id="S27.Thmthm5" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S27.Thmthm5.2" class="ltx_text ltx_font_bold">Proposition 27.5</span></span><span id="S27.Thmthm5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S27.Thmthm5.p1" class="ltx_para">
<p id="S27.Thmthm5.p1.1" class="ltx_p"><span id="S27.Thmthm5.p1.1.1" class="ltx_text ltx_font_italic">The verbose barcode only depends on <math id="S27.Thmthm5.p1.m1" class="ltx_Math" alttext="H^{\natural{\sf p}}" display="inline" intent=":literal"><semantics><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><annotation encoding="application/x-tex">H^{\natural{\sf p}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S27.SS2.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S27.SS2.p7" class="ltx_para ltx_noindent">
<p id="S27.SS2.p7.1" class="ltx_p"><span id="S27.SS2.p7.1.1" class="ltx_text">By Theorem <a href="#S7.Thmthm40" title="Theorem 7.40. ‣ 7.5.3. Barcodes ‣ 7.5. Quantitative theories ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.40</span></a>, one only needs to show that the filtered isomorphism type only depends on <math id="S27.SS2.p7.m1" class="ltx_Math" alttext="H^{\natural{\sf p}}" display="inline" intent=":literal"><semantics><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><annotation encoding="application/x-tex">H^{\natural{\sf p}}</annotation></semantics></math>. Indeed, given two constructions of <math id="S27.SS2.p7.m2" class="ltx_Math" alttext="C({\mathbb{F}}^{\natural{\sf p}}\#{\mathbb{E}})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝔽</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C({\mathbb{F}}^{\natural{\sf p}}\#{\mathbb{E}})</annotation></semantics></math> as a chain complex of <math id="S27.SS2.p7.m3" class="ltx_Math" alttext="\Lambda_{{\bf F}_{\sf p}}^{\mathbb{\Pi}}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi></msubsup><annotation encoding="application/x-tex">\Lambda_{{\bf F}_{\sf p}}^{\mathbb{\Pi}}</annotation></semantics></math>-modules with <math id="S27.SS2.p7.m4" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-action corresponding to two AMS lifts</span></p>
<table id="S27.EGx87" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S27.Ex25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S27.Ex25.m1" class="ltx_Math" alttext="\displaystyle\ \tilde{\mathbb{F}}_{0}^{{{\mathbb{Z}}_{\sf p}}}," display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mn>0</mn><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msubsup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ \tilde{\mathbb{F}}_{0}^{{{\mathbb{Z}}_{\sf p}}},</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S27.Ex25.m2" class="ltx_Math" alttext="\displaystyle\ \tilde{\mathbb{F}}_{1}^{{{\mathbb{Z}}_{\sf p}}}," display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mn>1</mn><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msubsup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ \tilde{\mathbb{F}}_{1}^{{{\mathbb{Z}}_{\sf p}}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.SS2.p7.2" class="ltx_p"><span id="S27.SS2.p7.2.1" class="ltx_text">by Theorem <a href="#S25.Thmthm3" title="Theorem 25.3 (Equivariant AMS lifts). ‣ 25.1.1. Coupling of Floer and Morse flow categories ‣ 25.1. Equivariant Floer flow category as a coupling ‣ 25. The Equivariant Floer theory for iterations—Proof of Theorem ‣ Part IV EQUIVARIANT FLOER THEORY AND STEENROD OPERATIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">25.3</span></a>, one can construct a lift of the outercollaring of the diagonal bimodule to <math id="S27.SS2.p7.m5" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>NC</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}</annotation></semantics></math> as a bimodule over <math id="S27.SS2.p7.m6" class="ltx_Math" alttext="(\tilde{\mathbb{F}}_{0}^{{{\mathbb{Z}}_{\sf p}}};\tilde{\mathbb{F}}_{1}^{{{\mathbb{Z}}_{\sf p}}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mn>0</mn><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msubsup><mo>;</mo><msubsup><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mn>1</mn><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\tilde{\mathbb{F}}_{0}^{{{\mathbb{Z}}_{\sf p}}};\tilde{\mathbb{F}}_{1}^{{{\mathbb{Z}}_{\sf p}}})</annotation></semantics></math>. Then by choosing FOP perturbations, one obtains a <math id="S27.SS2.p7.m7" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-equivariant chain map</span></p>
<table id="S27.Ex26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex26.m1" class="ltx_Math" alttext="\Phi:C(\tilde{\mathbb{F}}_{0}^{{\mathbb{Z}}_{\sf p}})\to C(\tilde{\mathbb{F}}_{1}^{{\mathbb{Z}}_{\sf p}})." display="block" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Φ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mn>0</mn><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mn>1</mn><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Phi:C(\tilde{\mathbb{F}}_{0}^{{\mathbb{Z}}_{\sf p}})\to C(\tilde{\mathbb{F}}_{1}^{{\mathbb{Z}}_{\sf p}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.SS2.p7.3" class="ltx_p"><span id="S27.SS2.p7.3.1" class="ltx_text">Similar to many other cases, this chain map has a leading order term being the identity map on the same chain group. Hence <math id="S27.SS2.p7.m8" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> is invertible. Moreover, <math id="S27.SS2.p7.m9" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> preserves the energy filtration because all the lifts cover the constant homotopy of <math id="S27.SS2.p7.m10" class="ltx_Math" alttext="H^{\natural{\sf p}}" display="inline" intent=":literal"><semantics><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><annotation encoding="application/x-tex">H^{\natural{\sf p}}</annotation></semantics></math>. Therefore, after changing coefficients to <math id="S27.SS2.p7.m11" class="ltx_Math" alttext="\Lambda_{{\bf K}_{\sf p}}^{|\Pi|}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mrow><mo stretchy="false">|</mo><mi mathvariant="normal">Π</mi><mo stretchy="false">|</mo></mrow></msubsup><annotation encoding="application/x-tex">\Lambda_{{\bf K}_{\sf p}}^{|\Pi|}</annotation></semantics></math>, the chain map <math id="S27.SS2.p7.m12" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> is a filtered isomorphism.
∎</span></p>
</div>
</div>
</section>
<section id="S27.SS3" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">27.3. </span>Local equivariant cohomology and homological perturbation</h4>

<div id="S27.SS3.p1" class="ltx_para ltx_noindent">
<p id="S27.SS3.p1.1" class="ltx_p">We would like to compare the barcodes between the ordinary Floer complex of a Hamiltonian and the equivariant Floer complexes of its <math id="S27.SS3.p1.m1" class="ltx_Math" alttext="{\sf p}" display="inline" intent=":literal"><semantics><mi>𝗉</mi><annotation encoding="application/x-tex">{\sf p}</annotation></semantics></math>-th iteration using the chain-level equivariant pair-of-pants product. In the presence of simple <math id="S27.SS3.p1.m2" class="ltx_Math" alttext="{\sf p}" display="inline" intent=":literal"><semantics><mi>𝗉</mi><annotation encoding="application/x-tex">{\sf p}</annotation></semantics></math>-periodic orbits, we do not expect to obtain a filtered isomorphism. On the other hand, simple <math id="S27.SS3.p1.m3" class="ltx_Math" alttext="{\sf p}" display="inline" intent=":literal"><semantics><mi>𝗉</mi><annotation encoding="application/x-tex">{\sf p}</annotation></semantics></math>-periodic orbits, which form free <math id="S27.SS3.p1.m4" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-orbits, are not expected to contribute in the Tate equivariant cohomology. We use local equivariant cohomology and the homological perturbation method to remove simple <math id="S27.SS3.p1.m5" class="ltx_Math" alttext="{\sf p}" display="inline" intent=":literal"><semantics><mi>𝗉</mi><annotation encoding="application/x-tex">{\sf p}</annotation></semantics></math>-periodic orbits from a reduced version of the equivariant Floer complex.</p>
</div>
<section id="S27.SS3.SSS1" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">27.3.1. </span>Local equivariant Floer theory</h5>

<div id="S27.SS3.SSS1.p1" class="ltx_para ltx_noindent">
<p id="S27.SS3.SSS1.p1.1" class="ltx_p">Now consider the <math id="S27.SS3.SSS1.p1.m1" class="ltx_Math" alttext="{\sf p}" display="inline" intent=":literal"><semantics><mi>𝗉</mi><annotation encoding="application/x-tex">{\sf p}</annotation></semantics></math>-th iteration <math id="S27.SS3.SSS1.p1.m2" class="ltx_Math" alttext="H^{\natural{\sf p}}" display="inline" intent=":literal"><semantics><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><annotation encoding="application/x-tex">H^{\natural{\sf p}}</annotation></semantics></math>. Recall that the chain group <math id="S27.SS3.SSS1.p1.m3" class="ltx_Math" alttext="CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}})</annotation></semantics></math> is the <math id="S27.SS3.SSS1.p1.m4" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-invariant part of the module</p>
<table id="S27.Ex27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex27.m1" class="ltx_Math" alttext="\bigoplus_{\overline{y}\in{\mathcal{O}}(H^{\natural{\sf p}})}\Lambda_{{\bf F}_{\sf p}}^{\Pi}\langle\overline{y}\rangle\otimes CM(f^{{\mathbb{E}}})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mover accent="true"><mi>y</mi><mo stretchy="true">¯</mo></mover><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mover accent="true"><mi>y</mi><mo stretchy="true">¯</mo></mover><mo rspace="0.055em" stretchy="false">⟩</mo></mrow></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mi>𝔼</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bigoplus_{\overline{y}\in{\mathcal{O}}(H^{\natural{\sf p}})}\Lambda_{{\bf F}_{\sf p}}^{\Pi}\langle\overline{y}\rangle\otimes CM(f^{{\mathbb{E}}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.SS3.SSS1.p1.2" class="ltx_p">Notice that <math id="S27.SS3.SSS1.p1.m5" class="ltx_Math" alttext="\overline{y}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>y</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{y}</annotation></semantics></math> is either an iterated orbit (fixed point) or a simple <math id="S27.SS3.SSS1.p1.m6" class="ltx_Math" alttext="{\sf p}" display="inline" intent=":literal"><semantics><mi>𝗉</mi><annotation encoding="application/x-tex">{\sf p}</annotation></semantics></math>-periodic orbit (free <math id="S27.SS3.SSS1.p1.m7" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-orbit). Then we can write the above chain group as</p>
<table id="S27.Ex28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex28.m1" class="ltx_Math" alttext="\left(\bigoplus_{\underline{\smash{x}}\in{\mathcal{O}}(H)}\Lambda_{{\bf F}_{\sf p}}^{\Pi}\langle\underline{\smash{x}}^{({\sf p})}\rangle\otimes CM(f^{{\mathbb{E}}})\right)\widehat{\oplus}\left(\bigoplus_{\underline{\smash{y}}\in{\mathcal{O}}^{\rm simple}(H^{\natural{\sf p}})}\Lambda_{{\bf F}_{\sf p}}^{\Pi}\langle\underline{\smash{y}}\rangle\otimes CM(f^{{\mathbb{E}}})\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>(</mo><mrow><mrow><mrow><munder><mo lspace="0em" movablelimits="false">⨁</mo><mrow><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><msup><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mrow><mo stretchy="false">(</mo><mi>𝗉</mi><mo stretchy="false">)</mo></mrow></msup><mo rspace="0.055em" stretchy="false">⟩</mo></mrow></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mi>𝔼</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo>⊕</mo><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><munder><mo lspace="0em" movablelimits="false">⨁</mo><mrow><munder accentunder="true"><mi>y</mi><mo stretchy="true">¯</mo></munder><mo>∈</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>simple</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><munder accentunder="true"><mi>y</mi><mo stretchy="true">¯</mo></munder><mo rspace="0.055em" stretchy="false">⟩</mo></mrow></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mi>𝔼</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left(\bigoplus_{\underline{\smash{x}}\in{\mathcal{O}}(H)}\Lambda_{{\bf F}_{\sf p}}^{\Pi}\langle\underline{\smash{x}}^{({\sf p})}\rangle\otimes CM(f^{{\mathbb{E}}})\right)\widehat{\oplus}\left(\bigoplus_{\underline{\smash{y}}\in{\mathcal{O}}^{\rm simple}(H^{\natural{\sf p}})}\Lambda_{{\bf F}_{\sf p}}^{\Pi}\langle\underline{\smash{y}}\rangle\otimes CM(f^{{\mathbb{E}}})\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.SS3.SSS1.p1.3" class="ltx_p">Notice that <math id="S27.SS3.SSS1.p1.m8" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math> acts trivially on the set of iterated orbits and acts freely on the set of simple orbits. Let <math id="S27.SS3.SSS1.p1.m9" class="ltx_Math" alttext="[\underline{\smash{y}}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><munder accentunder="true"><mi>y</mi><mo stretchy="true">¯</mo></munder><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[\underline{\smash{y}}]</annotation></semantics></math> be the <math id="S27.SS3.SSS1.p1.m10" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-orbit of <math id="S27.SS3.SSS1.p1.m11" class="ltx_Math" alttext="\underline{\smash{y}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>y</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{y}}</annotation></semantics></math>. Then one reorganizes the decomposition as</p>
<table id="S27.Ex29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex29.m1" class="ltx_Math" alttext="\begin{split}CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}})\otimes\Lambda_{{\bf K}_{\sf p}}^{\Pi}\cong&amp;\ \bigoplus_{\underline{\smash{x}}\in{\mathcal{O}}(H)}\Lambda_{\widetilde{\bf K}_{\sf p}}^{\Pi}\langle\underline{\smash{x}}^{({\sf p})}\rangle\widehat{\oplus}\left(\bigoplus_{\underline{\smash{y}}\in{\mathcal{O}}^{\rm simple}(H^{\natural{\sf p}})}\Lambda_{{\bf F}_{\sf p}}^{\Pi}\langle\underline{\smash{y}}\rangle\otimes CM(f^{{\mathbb{E}}})\right)_{{{\mathbb{Z}}_{\sf p}}}\\
\cong&amp;\ \bigoplus_{[\underline{\smash{y}}]\in{\mathcal{O}}(H^{\natural{\sf p}})/{{\mathbb{Z}}_{\sf p}}}CF_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}(H^{\natural{\sf p}},[\underline{\smash{y}}]),\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup></mrow><mo>≅</mo><mphantom></mphantom></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><munder><mo movablelimits="false">⨁</mo><mrow><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><msubsup><mi mathvariant="normal">Λ</mi><msub><mover accent="true"><mi>𝐊</mi><mo>~</mo></mover><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><msup><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mrow><mo stretchy="false">(</mo><mi>𝗉</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo>⊕</mo><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>(</mo><mrow><mrow><mrow><munder><mo lspace="0em" movablelimits="false">⨁</mo><mrow><munder accentunder="true"><mi>y</mi><mo stretchy="true">¯</mo></munder><mo>∈</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒪</mi><mi>simple</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><munder accentunder="true"><mi>y</mi><mo stretchy="true">¯</mo></munder><mo rspace="0.055em" stretchy="false">⟩</mo></mrow></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mi>𝔼</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>≅</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mrow><mo stretchy="false">[</mo><munder accentunder="true"><mi>y</mi><mo stretchy="true">¯</mo></munder><mo stretchy="false">]</mo></mrow><mo>∈</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msub><mi>ℤ</mi><mi>𝗉</mi></msub></mrow></mrow></munder><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mo>,</mo><mi>loc</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo>,</mo><mrow><mo stretchy="false">[</mo><munder accentunder="true"><mi>y</mi><mo stretchy="true">¯</mo></munder><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}})\otimes\Lambda_{{\bf K}_{\sf p}}^{\Pi}\cong&amp;\ \bigoplus_{\underline{\smash{x}}\in{\mathcal{O}}(H)}\Lambda_{\widetilde{\bf K}_{\sf p}}^{\Pi}\langle\underline{\smash{x}}^{({\sf p})}\rangle\widehat{\oplus}\left(\bigoplus_{\underline{\smash{y}}\in{\mathcal{O}}^{\rm simple}(H^{\natural{\sf p}})}\Lambda_{{\bf F}_{\sf p}}^{\Pi}\langle\underline{\smash{y}}\rangle\otimes CM(f^{{\mathbb{E}}})\right)_{{{\mathbb{Z}}_{\sf p}}}\\
\cong&amp;\ \bigoplus_{[\underline{\smash{y}}]\in{\mathcal{O}}(H^{\natural{\sf p}})/{{\mathbb{Z}}_{\sf p}}}CF_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}(H^{\natural{\sf p}},[\underline{\smash{y}}]),\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.SS3.SSS1.p1.4" class="ltx_p">where each <math id="S27.SS3.SSS1.p1.m12" class="ltx_Math" alttext="CF_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}(H^{\natural{\sf p}},[\underline{\smash{y}}])" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mo>,</mo><mi>loc</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo>,</mo><mrow><mo stretchy="false">[</mo><munder accentunder="true"><mi>y</mi><mo stretchy="true">¯</mo></munder><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}(H^{\natural{\sf p}},[\underline{\smash{y}}])</annotation></semantics></math> is a submodule coming from each <math id="S27.SS3.SSS1.p1.m13" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-orbit. Notice that for each <math id="S27.SS3.SSS1.p1.m14" class="ltx_Math" alttext="[y]\in{\mathcal{O}}(H)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mi>y</mi><mo stretchy="false">]</mo></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">[y]\in{\mathcal{O}}(H)</annotation></semantics></math>, there is a <math id="S27.SS3.SSS1.p1.m15" class="ltx_Math" alttext="{\bf K}_{\sf p}" display="inline" intent=":literal"><semantics><msub><mi>𝐊</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{\bf K}_{\sf p}</annotation></semantics></math>-summand</p>
<table id="S27.Ex30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex30.m1" class="ltx_Math" alttext="CF_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}(H^{\natural},[y])\subseteq CF_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}(H^{\natural{\sf p}},[\underline{\smash{y}}])." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mo>,</mo><mi>loc</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mi mathvariant="normal">♮</mi></msup><mo>,</mo><mrow><mo stretchy="false">[</mo><mi>y</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊆</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mo>,</mo><mi>loc</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo>,</mo><mrow><mo stretchy="false">[</mo><munder accentunder="true"><mi>y</mi><mo stretchy="true">¯</mo></munder><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">CF_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}(H^{\natural},[y])\subseteq CF_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}(H^{\natural{\sf p}},[\underline{\smash{y}}]).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S27.SS3.SSS1.p2" class="ltx_para ltx_noindent">
<p id="S27.SS3.SSS1.p2.1" class="ltx_p">The following lemma basically says that one can decompose the equivariant differential into a local part and a positive-energy part, where the local part respects the above decomposition.</p>
</div>
<div id="S27.Thmthm6" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S27.Thmthm6.2" class="ltx_text ltx_font_bold">Lemma 27.6</span></span><span id="S27.Thmthm6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S27.Thmthm6.p1" class="ltx_para ltx_noindent">
<p id="S27.Thmthm6.p1.1" class="ltx_p"><span id="S27.Thmthm6.p1.1.1" class="ltx_text ltx_font_italic">The equivariant differential</span></p>
<table id="S27.Ex31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex31.m1" class="ltx_Math" alttext="d_{{{\mathbb{Z}}_{\sf p}}}:CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}};\Lambda_{{\bf K}_{\sf p}}^{\Pi})\to CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}};\Lambda_{{\bf K}_{\sf p}}^{\Pi})" display="block" intent=":literal"><semantics><mrow><msub><mi>d</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo>,</mo><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo>,</mo><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">d_{{{\mathbb{Z}}_{\sf p}}}:CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}};\Lambda_{{\bf K}_{\sf p}}^{\Pi})\to CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}};\Lambda_{{\bf K}_{\sf p}}^{\Pi})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.Thmthm6.p1.2" class="ltx_p"><span id="S27.Thmthm6.p1.2.1" class="ltx_text ltx_font_italic">can be written as</span></p>
<table id="S27.Ex32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex32.m1" class="ltx_Math" alttext="d_{{{\mathbb{Z}}_{\sf p}}}=d_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}+D_{{{\mathbb{Z}}_{\sf p}}}" display="block" intent=":literal"><semantics><mrow><msub><mi>d</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo>=</mo><mrow><msub><mi>d</mi><mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mo>,</mo><mi>loc</mi></mrow></msub><mo>+</mo><msub><mi>D</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">d_{{{\mathbb{Z}}_{\sf p}}}=d_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}+D_{{{\mathbb{Z}}_{\sf p}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.Thmthm6.p1.3" class="ltx_p"><span id="S27.Thmthm6.p1.3.1" class="ltx_text ltx_font_italic">which satisfy the following conditions.</span></p>
</div>
<div id="S27.Thmthm6.p2" class="ltx_para">
<ol id="S27.I3" class="ltx_enumerate">
<li id="S27.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S27.I3.i1.p1" class="ltx_para ltx_noindent">
<p id="S27.I3.i1.p1.1" class="ltx_p"><span id="S27.I3.i1.p1.1.1" class="ltx_text ltx_font_italic">For each </span><math id="S27.I3.i1.p1.m1" class="ltx_Math" alttext="[y]\in\tilde{\mathcal{O}}(H^{\natural{\sf p}})/{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mi>y</mi><mo stretchy="false">]</mo></mrow><mo>∈</mo><mrow><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msub><mi>ℤ</mi><mi>𝗉</mi></msub></mrow></mrow><annotation encoding="application/x-tex">[y]\in\tilde{\mathcal{O}}(H^{\natural{\sf p}})/{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math><span id="S27.I3.i1.p1.1.2" class="ltx_text ltx_font_italic">,</span></p>
<table id="S27.Ex33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex33.m1" class="ltx_Math" alttext="d_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}\big(CF_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}(H^{\natural{\sf p}},[y])\big)\subseteq CF_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}(H^{\natural{\sf p}},[y])." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>d</mi><mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mo>,</mo><mi>loc</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mo>,</mo><mi>loc</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo>,</mo><mrow><mo stretchy="false">[</mo><mi>y</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>⊆</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mo>,</mo><mi>loc</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo>,</mo><mrow><mo stretchy="false">[</mo><mi>y</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">d_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}\big(CF_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}(H^{\natural{\sf p}},[y])\big)\subseteq CF_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}(H^{\natural{\sf p}},[y]).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.I3.i1.p1.2" class="ltx_p"><span id="S27.I3.i1.p1.2.1" class="ltx_text ltx_font_italic">Therefore </span><math id="S27.I3.i1.p1.m2" class="ltx_Math" alttext="d_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mo>,</mo><mi>loc</mi></mrow></msub><annotation encoding="application/x-tex">d_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}</annotation></semantics></math><span id="S27.I3.i1.p1.2.2" class="ltx_text ltx_font_italic"> preserves the filtration. Denote the restriction of </span><math id="S27.I3.i1.p1.m3" class="ltx_Math" alttext="d_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mo>,</mo><mi>loc</mi></mrow></msub><annotation encoding="application/x-tex">d_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}</annotation></semantics></math><span id="S27.I3.i1.p1.2.3" class="ltx_text ltx_font_italic"> to the summand </span><math id="S27.I3.i1.p1.m4" class="ltx_Math" alttext="CF_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}(H^{\natural{\sf p}},[y])" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mo>,</mo><mi>loc</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo>,</mo><mrow><mo stretchy="false">[</mo><mi>y</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}(H^{\natural{\sf p}},[y])</annotation></semantics></math><span id="S27.I3.i1.p1.2.4" class="ltx_text ltx_font_italic"> by </span><math id="S27.I3.i1.p1.m5" class="ltx_Math" alttext="d_{{{\mathbb{Z}}_{\sf p}},[y]}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mo>,</mo><mrow><mo stretchy="false">[</mo><mi>y</mi><mo stretchy="false">]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">d_{{{\mathbb{Z}}_{\sf p}},[y]}</annotation></semantics></math><span id="S27.I3.i1.p1.2.5" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S27.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S27.I3.i2.p1" class="ltx_para ltx_noindent">
<p id="S27.I3.i2.p1.1" class="ltx_p"><span id="S27.I3.i2.p1.1.1" class="ltx_text ltx_font_italic">For each </span><math id="S27.I3.i2.p1.m1" class="ltx_Math" alttext="[y]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mi>y</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[y]</annotation></semantics></math><span id="S27.I3.i2.p1.1.2" class="ltx_text ltx_font_italic">, </span><math id="S27.I3.i2.p1.m2" class="ltx_Math" alttext="d_{{{\mathbb{Z}}_{\sf p}},[y]}^{2}=0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>d</mi><mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mo>,</mo><mrow><mo stretchy="false">[</mo><mi>y</mi><mo stretchy="false">]</mo></mrow></mrow><mn>2</mn></msubsup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d_{{{\mathbb{Z}}_{\sf p}},[y]}^{2}=0</annotation></semantics></math><span id="S27.I3.i2.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S27.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S27.I3.i3.p1" class="ltx_para ltx_noindent">
<p id="S27.I3.i3.p1.1" class="ltx_p"><span id="S27.I3.i3.p1.1.1" class="ltx_text ltx_font_italic">There exists </span><math id="S27.I3.i3.p1.m1" class="ltx_Math" alttext="\delta_{H^{\natural{\sf p}}}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>δ</mi><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta_{H^{\natural{\sf p}}}&gt;0</annotation></semantics></math><span id="S27.I3.i3.p1.1.2" class="ltx_text ltx_font_italic"> such that </span><math id="S27.I3.i3.p1.m2" class="ltx_Math" alttext="D_{{{\mathbb{Z}}_{\sf p}}}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><annotation encoding="application/x-tex">D_{{{\mathbb{Z}}_{\sf p}}}</annotation></semantics></math><span id="S27.I3.i3.p1.1.3" class="ltx_text ltx_font_italic"> increases the filtration by at least </span><math id="S27.I3.i3.p1.m3" class="ltx_Math" alttext="\delta_{H^{\natural{\sf p}}}" display="inline" intent=":literal"><semantics><msub><mi>δ</mi><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup></msub><annotation encoding="application/x-tex">\delta_{H^{\natural{\sf p}}}</annotation></semantics></math><span id="S27.I3.i3.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S27.I3.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S27.I3.i4.p1" class="ltx_para ltx_noindent">
<p id="S27.I3.i4.p1.1" class="ltx_p"><span id="S27.I3.i4.p1.1.1" class="ltx_text ltx_font_italic">If </span><math id="S27.I3.i4.p1.m1" class="ltx_Math" alttext="y=x^{({\sf p})}" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>=</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>𝗉</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">y=x^{({\sf p})}</annotation></semantics></math><span id="S27.I3.i4.p1.1.2" class="ltx_text ltx_font_italic"> for </span><math id="S27.I3.i4.p1.m2" class="ltx_Math" alttext="x\in\tilde{\mathcal{O}}(H)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x\in\tilde{\mathcal{O}}(H)</annotation></semantics></math><span id="S27.I3.i4.p1.1.3" class="ltx_text ltx_font_italic">, </span><math id="S27.I3.i4.p1.m3" class="ltx_Math" alttext="d_{{{\mathbb{Z}}_{\sf p}},[y]}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mo>,</mo><mrow><mo stretchy="false">[</mo><mi>y</mi><mo stretchy="false">]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">d_{{{\mathbb{Z}}_{\sf p}},[y]}</annotation></semantics></math><span id="S27.I3.i4.p1.1.4" class="ltx_text ltx_font_italic"> vanishes and denote the cohomology by</span></p>
<table id="S27.Ex34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex34.m1" class="ltx_Math" alttext="HF_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}(H^{\natural{\sf p}},x^{({\sf p})})\cong\widetilde{\bf K}_{\sf p}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mo>,</mo><mi>loc</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo>,</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>𝗉</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><msub><mover accent="true"><mi>𝐊</mi><mo>~</mo></mover><mi>𝗉</mi></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">HF_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}(H^{\natural{\sf p}},x^{({\sf p})})\cong\widetilde{\bf K}_{\sf p}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S27.I3.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(5)</span> 
<div id="S27.I3.i5.p1" class="ltx_para">
<p id="S27.I3.i5.p1.1" class="ltx_p"><span id="S27.I3.i5.p1.1.1" class="ltx_text ltx_font_italic">If </span><math id="S27.I3.i5.p1.m1" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math><span id="S27.I3.i5.p1.1.2" class="ltx_text ltx_font_italic"> is a simple </span><math id="S27.I3.i5.p1.m2" class="ltx_Math" alttext="{\sf p}" display="inline" intent=":literal"><semantics><mi>𝗉</mi><annotation encoding="application/x-tex">{\sf p}</annotation></semantics></math><span id="S27.I3.i5.p1.1.3" class="ltx_text ltx_font_italic">-periodic orbit, then the cohomology of </span><math id="S27.I3.i5.p1.m3" class="ltx_Math" alttext="d_{{{\mathbb{Z}}_{\sf p}},[y]}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mo>,</mo><mrow><mo stretchy="false">[</mo><mi>y</mi><mo stretchy="false">]</mo></mrow></mrow></msub><annotation encoding="application/x-tex">d_{{{\mathbb{Z}}_{\sf p}},[y]}</annotation></semantics></math><span id="S27.I3.i5.p1.1.4" class="ltx_text ltx_font_italic"> is trivial.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S27.SS3.SSS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S27.SS3.SSS1.p3" class="ltx_para ltx_noindent">
<p id="S27.SS3.SSS1.p3.1" class="ltx_p"><span id="S27.SS3.SSS1.p3.1.1" class="ltx_text">The decomposition <math id="S27.SS3.SSS1.p3.m1" class="ltx_Math" alttext="d_{{{\mathbb{Z}}_{\sf p}}}=d_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}+D_{{{\mathbb{Z}}_{\sf p}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo>=</mo><mrow><msub><mi>d</mi><mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mo>,</mo><mi>loc</mi></mrow></msub><mo>+</mo><msub><mi>D</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">d_{{{\mathbb{Z}}_{\sf p}}}=d_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}+D_{{{\mathbb{Z}}_{\sf p}}}</annotation></semantics></math> and the first three conditions are due to a basic compactness argument, usually termed under cross-energy lemma, see e.g. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib2" title="" class="ltx_ref">12</a>, Lemma B.1]</cite>. In our nondegenerate setting, we know that <math id="S27.SS3.SSS1.p3.m2" class="ltx_Math" alttext="d_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mo>,</mo><mi>loc</mi></mrow></msub><annotation encoding="application/x-tex">d_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}</annotation></semantics></math> comes from differentials in <math id="S27.SS3.SSS1.p3.m3" class="ltx_Math" alttext="CM(f^{{\mathbb{E}}})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mi>𝔼</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CM(f^{{\mathbb{E}}})</annotation></semantics></math> and <math id="S27.SS3.SSS1.p3.m4" class="ltx_Math" alttext="D_{{{\mathbb{Z}}_{\sf p}}}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><annotation encoding="application/x-tex">D_{{{\mathbb{Z}}_{\sf p}}}</annotation></semantics></math> comes from the contribution from nontrivial Floer cylinders in <math id="S27.SS3.SSS1.p3.m5" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>.</span></p>
</div>
<div id="S27.SS3.SSS1.p4" class="ltx_para ltx_noindent">
<p id="S27.SS3.SSS1.p4.1" class="ltx_p"><span id="S27.SS3.SSS1.p4.1.1" class="ltx_text">If <math id="S27.SS3.SSS1.p4.m1" class="ltx_Math" alttext="y=x^{({\sf p})}" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>=</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>𝗉</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">y=x^{({\sf p})}</annotation></semantics></math>, the summand <math id="S27.SS3.SSS1.p4.m2" class="ltx_Math" alttext="CF_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}(H^{\natural{\sf p}},x^{({\sf p})})\cong CM(f^{{\mathbb{E}}})_{{{\mathbb{Z}}_{\sf p}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mo>,</mo><mi>loc</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo>,</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>𝗉</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mi>𝔼</mi></msup><mo stretchy="false">)</mo></mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">CF_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}(H^{\natural{\sf p}},x^{({\sf p})})\cong CM(f^{{\mathbb{E}}})_{{{\mathbb{Z}}_{\sf p}}}</annotation></semantics></math> and the differential is trivial on <math id="S27.SS3.SSS1.p4.m3" class="ltx_Math" alttext="CM(f^{{\mathbb{E}}})_{{{\mathbb{Z}}_{\sf p}}}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mi>𝔼</mi></msup><mo stretchy="false">)</mo></mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub></mrow><annotation encoding="application/x-tex">CM(f^{{\mathbb{E}}})_{{{\mathbb{Z}}_{\sf p}}}</annotation></semantics></math>. Hence (4) is verified.</span></p>
</div>
<div id="S27.SS3.SSS1.p5" class="ltx_para ltx_noindent">
<p id="S27.SS3.SSS1.p5.1" class="ltx_p"><span id="S27.SS3.SSS1.p5.1.1" class="ltx_text">If <math id="S27.SS3.SSS1.p5.m1" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math> is simple, then we have the following identification. Let <math id="S27.SS3.SSS1.p5.m2" class="ltx_Math" alttext="\tau\in{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><msub><mi>ℤ</mi><mi>𝗉</mi></msub></mrow><annotation encoding="application/x-tex">\tau\in{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math> be the generator and let <math id="S27.SS3.SSS1.p5.m3" class="ltx_Math" alttext="w_{l}^{\pm}" display="inline" intent=":literal"><semantics><msubsup><mi>w</mi><mi>l</mi><mo>±</mo></msubsup><annotation encoding="application/x-tex">w_{l}^{\pm}</annotation></semantics></math> resp. <math id="S27.SS3.SSS1.p5.m4" class="ltx_Math" alttext="w_{l}^{0},\ldots,w_{l}^{{\sf p}-1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>w</mi><mi>l</mi><mn>0</mn></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>w</mi><mi>l</mi><mrow><mi>𝗉</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><annotation encoding="application/x-tex">w_{l}^{0},\ldots,w_{l}^{{\sf p}-1}</annotation></semantics></math> be the <math id="S27.SS3.SSS1.p5.m5" class="ltx_Math" alttext="{\sf p}" display="inline" intent=":literal"><semantics><mi>𝗉</mi><annotation encoding="application/x-tex">{\sf p}</annotation></semantics></math> critical points of <math id="S27.SS3.SSS1.p5.m6" class="ltx_Math" alttext="f^{{\mathbb{E}}}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mi>𝔼</mi></msup><annotation encoding="application/x-tex">f^{{\mathbb{E}}}</annotation></semantics></math> in degree <math id="S27.SS3.SSS1.p5.m7" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> in <math id="S27.SS3.SSS1.p5.m8" class="ltx_Math" alttext="{\sf p}=2" display="inline" intent=":literal"><semantics><mrow><mi>𝗉</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">{\sf p}=2</annotation></semantics></math> resp. <math id="S27.SS3.SSS1.p5.m9" class="ltx_Math" alttext="{\sf p}&gt;2" display="inline" intent=":literal"><semantics><mrow><mi>𝗉</mi><mo>&gt;</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">{\sf p}&gt;2</annotation></semantics></math> case.</span></p>
<table id="S27.SS3.SSS1.p5.2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.SS3.SSS1.p5.m10" class="ltx_Math" alttext="CF_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}(H^{\natural{\sf p}},[y])=\bigoplus_{\tau^{k}\in{{\mathbb{Z}}_{\sf p}}}\left({\bf F}_{\sf p}\langle\tau^{k}y\rangle\oplus CM(f^{{\mathbb{E}}})\right)_{{{\mathbb{Z}}_{\sf p}}}\\
\cong\left\{\begin{array}[]{ll}{\bf K}_{2}\Big\langle y\otimes w_{0}^{-}+\tau(y)\otimes w_{0}^{+},y\otimes w_{0}^{+}+\tau(y)\otimes w_{0}^{-}\Big\rangle,&amp;\ {\sf p}=2,\\[5.69046pt]
{\bf K}_{\sf p}\Big\langle\left.\sum_{k=0}^{{\sf p}-1}\tau^{k}(y)\otimes w_{0}^{k+s},\ \sum_{k=0}^{{\sf p}-1}\tau^{k}(y)\otimes w_{1}^{k+s}\right|\ s=0,1,\ldots,{\sf p}-1\Big\rangle&amp;\ {\sf p}&gt;2.\end{array}\right." display="block" intent=":literal"><semantics><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mo>,</mo><mi>loc</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo mathsize="0.700em">,</mo><mrow><mo stretchy="false">[</mo><mi>y</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">⨁</mo><mrow><msup><mi>τ</mi><mi>k</mi></msup><mo>∈</mo><msub><mi>ℤ</mi><mi>𝗉</mi></msub></mrow></munder><msub><mrow><mo>(</mo><mrow><mrow><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><msup><mi>τ</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo>⊕</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mi>𝔼</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mphantom></mphantom><mo>≅</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi>𝐊</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mrow><mi>y</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi>w</mi><mn>0</mn><mo>−</mo></msubsup></mrow><mo>+</mo><mrow><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi>w</mi><mn>0</mn><mo>+</mo></msubsup></mrow></mrow><mo>,</mo><mrow><mrow><mi>y</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi>w</mi><mn>0</mn><mo>+</mo></msubsup></mrow><mo>+</mo><mrow><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi>w</mi><mn>0</mn><mo>−</mo></msubsup></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>𝗉</mi><mo>=</mo><mn>2</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi>𝐊</mi><msub><mrow></mrow><mi>𝗉</mi></msub><mo stretchy="false">⟨</mo><mstyle displaystyle="false"><mo>∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mrow><mi>𝗉</mi><mo>−</mo><mn>1</mn></mrow></msup><mi>τ</mi><msup><mrow></mrow><mi>k</mi></msup><mo stretchy="false">(</mo><mi>y</mi><mo rspace="0.055em" stretchy="false">)</mo><mo rspace="0.222em">⊗</mo><mi>w</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mrow><mi>k</mi><mo>+</mo><mi>s</mi></mrow></msup><mo rspace="0.667em">,</mo><mstyle displaystyle="false"><mo>∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mrow><mi>𝗉</mi><mo>−</mo><mn>1</mn></mrow></msup><mi>τ</mi><msup><mrow></mrow><mi>k</mi></msup><mo stretchy="false">(</mo><mi>y</mi><mo rspace="0.055em" stretchy="false">)</mo><mo rspace="0.222em">⊗</mo><mi>w</mi><msub><mrow></mrow><mn>1</mn></msub><msup><mrow></mrow><mrow><mi>k</mi><mo>+</mo><mi>s</mi></mrow></msup><mo fence="false" rspace="0.667em">|</mo><mi>s</mi><mo>=</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>𝗉</mi><mo>−</mo><mn>1</mn><mo stretchy="false">⟩</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>𝗉</mi><mo>&gt;</mo><mn>2</mn></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">CF_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}(H^{\natural{\sf p}},[y])=\bigoplus_{\tau^{k}\in{{\mathbb{Z}}_{\sf p}}}\left({\bf F}_{\sf p}\langle\tau^{k}y\rangle\oplus CM(f^{{\mathbb{E}}})\right)_{{{\mathbb{Z}}_{\sf p}}}\\
\cong\left\{\begin{array}[]{ll}{\bf K}_{2}\Big\langle y\otimes w_{0}^{-}+\tau(y)\otimes w_{0}^{+},y\otimes w_{0}^{+}+\tau(y)\otimes w_{0}^{-}\Big\rangle,&amp;\ {\sf p}=2,\\[5.69046pt]
{\bf K}_{\sf p}\Big\langle\left.\sum_{k=0}^{{\sf p}-1}\tau^{k}(y)\otimes w_{0}^{k+s},\ \sum_{k=0}^{{\sf p}-1}\tau^{k}(y)\otimes w_{1}^{k+s}\right|\ s=0,1,\ldots,{\sf p}-1\Big\rangle&amp;\ {\sf p}&gt;2.\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.SS3.SSS1.p5.3" class="ltx_p"><span id="S27.SS3.SSS1.p5.3.1" class="ltx_text">One can see from the differential of <math id="S27.SS3.SSS1.p5.m11" class="ltx_Math" alttext="CM(f^{{\mathbb{E}}})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mi>𝔼</mi></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CM(f^{{\mathbb{E}}})</annotation></semantics></math> that the cohomology is trivial.
∎</span></p>
</div>
</div>
<div id="S27.SS3.SSS1.p6" class="ltx_para ltx_noindent">
<p id="S27.SS3.SSS1.p6.1" class="ltx_p">Then we would like to apply the homological perturbation argument.</p>
</div>
<div id="S27.Thmthm7" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S27.Thmthm7.2" class="ltx_text ltx_font_bold">Lemma 27.7</span></span><span id="S27.Thmthm7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S27.Thmthm7.p1" class="ltx_para ltx_noindent">
<p id="S27.Thmthm7.p1.1" class="ltx_p"><span id="S27.Thmthm7.p1.1.1" class="ltx_text ltx_font_italic">There exist a differential <math id="S27.Thmthm7.p1.m1" class="ltx_Math" alttext="D_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}" display="inline" intent=":literal"><semantics><msubsup><mi>D</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mi>red</mi></msubsup><annotation encoding="application/x-tex">D_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}</annotation></semantics></math> on the “reduced” equivariant complex</span></p>
<table id="S27.Ex35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex35.m1" class="ltx_Math" alttext="CF_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(H^{\natural{\sf p}}):=\bigoplus_{x\in\tilde{\mathcal{O}}(H)}HF_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}(H^{\natural{\sf p}},x^{({\sf p})})" display="block" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>F</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mi>red</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">:=</mo><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mi>x</mi><mo>∈</mo><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mo>,</mo><mi>loc</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo>,</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>𝗉</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">CF_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(H^{\natural{\sf p}}):=\bigoplus_{x\in\tilde{\mathcal{O}}(H)}HF_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}(H^{\natural{\sf p}},x^{({\sf p})})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.Thmthm7.p1.2" class="ltx_p"><span id="S27.Thmthm7.p1.2.1" class="ltx_text ltx_font_italic">making it a Floer-type complex, filtered chain homotopy equivalences</span></p>
<table id="S27.EGx88" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S27.Ex36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S27.Ex36.m1" class="ltx_Math" alttext="\displaystyle\ \tilde{\sigma}:CF_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(H^{\natural{\sf p}})\to CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}}),\ " display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>F</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mi>red</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ \tilde{\sigma}:CF_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(H^{\natural{\sf p}})\to CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}}),\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S27.Ex36.m2" class="ltx_Math" alttext="\displaystyle\ \tilde{\pi}:CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}})\to CF_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(H^{\natural{\sf p}})," display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>π</mi><mo>~</mo></mover><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>F</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mi>red</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ \tilde{\pi}:CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}})\to CF_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(H^{\natural{\sf p}}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.Thmthm7.p1.3" class="ltx_p"><span id="S27.Thmthm7.p1.3.1" class="ltx_text ltx_font_italic">and a filtered chain homotopy</span></p>
<table id="S27.Ex37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex37.m1" class="ltx_Math" alttext="\tilde{\Theta}:CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}})\to CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}})" display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{\Theta}:CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}})\to CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.Thmthm7.p1.4" class="ltx_p"><span id="S27.Thmthm7.p1.4.1" class="ltx_text ltx_font_italic">such that</span></p>
<table id="S27.EGx89" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S27.Ex38"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S27.Ex38.m1" class="ltx_Math" alttext="\displaystyle\ \tilde{\pi}\circ\tilde{\sigma}={\rm Id},\ " display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mi>π</mi><mo>~</mo></mover><mo lspace="0.222em" rspace="0.222em">∘</mo><mover accent="true"><mi>σ</mi><mo>~</mo></mover></mrow><mo>=</mo><mi>Id</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ \tilde{\pi}\circ\tilde{\sigma}={\rm Id},\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S27.Ex38.m2" class="ltx_Math" alttext="\displaystyle\ \tilde{\sigma}\circ\tilde{\pi}={\rm Id}+d_{{{\mathbb{Z}}_{\sf p}}}\circ\tilde{\Theta}+\tilde{\Theta}\circ d_{{{\mathbb{Z}}_{\sf p}}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mo lspace="0.222em" rspace="0.222em">∘</mo><mover accent="true"><mi>π</mi><mo>~</mo></mover></mrow><mo>=</mo><mrow><mi>Id</mi><mo>+</mo><mrow><msub><mi>d</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover></mrow><mo>+</mo><mrow><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>d</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ \tilde{\sigma}\circ\tilde{\pi}={\rm Id}+d_{{{\mathbb{Z}}_{\sf p}}}\circ\tilde{\Theta}+\tilde{\Theta}\circ d_{{{\mathbb{Z}}_{\sf p}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S27.SS3.SSS1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S27.SS3.SSS1.p7" class="ltx_para">
<p id="S27.SS3.SSS1.p7.1" class="ltx_p"><span id="S27.SS3.SSS1.p7.1.1" class="ltx_text">This lemma can be proved in the same way as Lemma <a href="#S27.Thmthm2" title="Lemma 27.2. ‣ 27.1.1. Homological perturbation ‣ 27.1. Filtration on the 𝗉-fold tensor product ‣ 27. Quantitative Results about Equivariant Floer Theory ‣ Part IV EQUIVARIANT FLOER THEORY AND STEENROD OPERATIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27.2</span></a>. We omit the details.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="S27.SS4" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">27.4. </span>Equivariant pair-of-pants product</h4>

<div id="S27.SS4.p1" class="ltx_para ltx_noindent">
<p id="S27.SS4.p1.1" class="ltx_p">We consider the quantitative property of the equivariant pair-of-pants product. Let <math id="S27.SS4.p1.m1" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> be as above. First, the complex <math id="S27.SS4.p1.m2" class="ltx_Math" alttext="CF(H)" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF(H)</annotation></semantics></math> is a Floer-type complex over the Novikov field <math id="S27.SS4.p1.m3" class="ltx_Math" alttext="\Lambda_{{\bf F}_{\sf p}}^{\Pi}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup><annotation encoding="application/x-tex">\Lambda_{{\bf F}_{\sf p}}^{\Pi}</annotation></semantics></math>-modules with a filtration <math id="S27.SS4.p1.m4" class="ltx_Math" alttext="{\mathcal{A}}_{H}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>H</mi></msub><annotation encoding="application/x-tex">{\mathcal{A}}_{H}</annotation></semantics></math>. Then consider the completed tensor product</p>
<table id="S27.Ex39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex39.m1" class="ltx_Math" alttext="\left(CF(H)^{\otimes{\sf p}}\otimes CM(f^{{\mathbb{E}}})\right)\otimes\Lambda_{{\bf K}_{\sf p}}^{\Pi}" display="block" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mrow><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mi>𝔼</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup></mrow><annotation encoding="application/x-tex">\left(CF(H)^{\otimes{\sf p}}\otimes CM(f^{{\mathbb{E}}})\right)\otimes\Lambda_{{\bf K}_{\sf p}}^{\Pi}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.SS4.p1.2" class="ltx_p">which has the energy filtration <math id="S27.SS4.p1.m5" class="ltx_Math" alttext="{\mathcal{A}}_{H}^{\otimes{\sf p}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>H</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msubsup><annotation encoding="application/x-tex">{\mathcal{A}}_{H}^{\otimes{\sf p}}</annotation></semantics></math>. It is a nonarchimedean normed vector space over <math id="S27.SS4.p1.m6" class="ltx_Math" alttext="\Lambda_{{\bf K}_{\sf p}}^{\Pi}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup><annotation encoding="application/x-tex">\Lambda_{{\bf K}_{\sf p}}^{\Pi}</annotation></semantics></math> and is orthogonalizable. Then its <math id="S27.SS4.p1.m7" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-invariant subspace</p>
<table id="S27.Ex40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex40.m1" class="ltx_Math" alttext="C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}}):=\Big(\Big(CF(H)^{\otimes{\sf p}}\otimes CM(f^{{\mathbb{E}}})\Big)\otimes\Lambda_{{\bf K}_{\sf p}}^{\Pi}\Big)_{{{\mathbb{Z}}_{\sf p}}}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mi>𝔼</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub></mrow><annotation encoding="application/x-tex">C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}}):=\Big(\Big(CF(H)^{\otimes{\sf p}}\otimes CM(f^{{\mathbb{E}}})\Big)\otimes\Lambda_{{\bf K}_{\sf p}}^{\Pi}\Big)_{{{\mathbb{Z}}_{\sf p}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.SS4.p1.3" class="ltx_p">is orthogonalizable. Moreover, the differential clearly preserves the filtration. Hence one has a Floer-type complex with associated barcode.</p>
</div>
<div id="S27.SS4.p2" class="ltx_para ltx_noindent">
<p id="S27.SS4.p2.1" class="ltx_p">Now consider the chain-level equivariant pair-of-pants product, which was originally defined as</p>
<table id="S27.Ex41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex41.m1" class="ltx_Math" alttext="P:\Big(CF(H)^{\otimes{\sf p}}\otimes CM(f^{{\mathbb{E}}})\otimes\Lambda_{{\bf K}_{\sf p}}^{\Pi}\Big)_{{{\mathbb{Z}}_{\sf p}}}\to CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}})" display="block" intent=":literal"><semantics><mrow><mi>P</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mi>𝔼</mi></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">P:\Big(CF(H)^{\otimes{\sf p}}\otimes CM(f^{{\mathbb{E}}})\otimes\Lambda_{{\bf K}_{\sf p}}^{\Pi}\Big)_{{{\mathbb{Z}}_{\sf p}}}\to CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.SS4.p2.2" class="ltx_p">as a <math id="S27.SS4.p2.m1" class="ltx_Math" alttext="\Lambda_{{\bf K}_{\sf p}}^{\Pi}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup><annotation encoding="application/x-tex">\Lambda_{{\bf K}_{\sf p}}^{\Pi}</annotation></semantics></math>-linear chain map.</p>
</div>
<div id="S27.Thmthm8" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S27.Thmthm8.2" class="ltx_text ltx_font_bold">Proposition 27.8</span></span><span id="S27.Thmthm8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S27.Thmthm8.p1" class="ltx_para ltx_noindent">
<p id="S27.Thmthm8.p1.1" class="ltx_p"><span id="S27.Thmthm8.p1.1.1" class="ltx_text ltx_font_italic">There exists a chain-level construction of <math id="S27.Thmthm8.p1.m1" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> which preserves the nonarchimedean norm, i.e.,</span></p>
<table id="S27.Ex42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex42.m1" class="ltx_Math" alttext="{\mathcal{A}}(P(x))\geq{\mathcal{A}}_{H}^{\otimes{\sf p}}(x)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>H</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{A}}(P(x))\geq{\mathcal{A}}_{H}^{\otimes{\sf p}}(x).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S27.SS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S27.SS4.p3" class="ltx_para">
<p id="S27.SS4.p3.1" class="ltx_p"><span id="S27.SS4.p3.1.1" class="ltx_text">Consider the branched covering <math id="S27.SS4.p3.m1" class="ltx_Math" alttext="\Sigma^{\mathbb{FSt}}\to{\mathbb{R}}\times S^{1}" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Σ</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup><mo stretchy="false">→</mo><mrow><mi>ℝ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>S</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\Sigma^{\mathbb{FSt}}\to{\mathbb{R}}\times S^{1}</annotation></semantics></math>, which pulls back the trivial Floer data <math id="S27.SS4.p3.m2" class="ltx_Math" alttext="Hdt" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">Hdt</annotation></semantics></math> on the cylinder to a Hamiltonian connection on <math id="S27.SS4.p3.m3" class="ltx_Math" alttext="\sigma_{H}^{\mathbb{FSt}}" display="inline" intent=":literal"><semantics><msubsup><mi>σ</mi><mi>H</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msubsup><annotation encoding="application/x-tex">\sigma_{H}^{\mathbb{FSt}}</annotation></semantics></math> on <math id="S27.SS4.p3.m4" class="ltx_Math" alttext="\Sigma^{\mathbb{FSt}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Σ</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup><annotation encoding="application/x-tex">\Sigma^{\mathbb{FSt}}</annotation></semantics></math>. Consider the multimodule <math id="S27.SS4.p3.m5" class="ltx_Math" alttext="\mathbb{X}^{\mathbb{FSt}}" display="inline" intent=":literal"><semantics><msup><mi>𝕏</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{X}^{\mathbb{FSt}}</annotation></semantics></math>. From the energy identity for Floer equation, one can see that the multimodule has a threshold zero (Definition <a href="#S7.Thmthm41" title="Definition 7.41. ‣ 7.5.4. Continuity ‣ 7.5. Quantitative theories ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.41</span></a>) with respect to the symplectic action. Then by Proposition <a href="#S7.Thmthm42" title="Proposition 7.42. ‣ 7.5.4. Continuity ‣ 7.5. Quantitative theories ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.42</span></a>, the chain map preserves the filtration.
∎</span></p>
</div>
</div>
<div id="S27.Thmthm9" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S27.Thmthm9.2" class="ltx_text ltx_font_bold">Theorem 27.9</span></span><span id="S27.Thmthm9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S27.Thmthm9.p1" class="ltx_para ltx_noindent">
<p id="S27.Thmthm9.p1.1" class="ltx_p"><span id="S27.Thmthm9.p1.1.1" class="ltx_text ltx_font_italic">There exists a filtered chain isomorphism</span></p>
<table id="S27.Ex43" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex43.m1" class="ltx_Math" alttext="P^{\rm red}:C_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(CF(H)^{\otimes{\sf p}})\to CF_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(H^{\natural{\sf p}})" display="block" intent=":literal"><semantics><mrow><msup><mi>P</mi><mi>red</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mi>red</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>F</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mi>red</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">P^{\rm red}:C_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(CF(H)^{\otimes{\sf p}})\to CF_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(H^{\natural{\sf p}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.Thmthm9.p1.2" class="ltx_p"><span id="S27.Thmthm9.p1.2.1" class="ltx_text ltx_font_italic">such that the following diagram commutes up to filtered homotopy, where the vertical arrows are provided by the homological perturbation lemma.</span></p>
<table id="S27.Ex44" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S27.Ex44.m1.pic1" class="ltx_picture ltx_markedasmath" height="77.77" overflow="visible" style="vertical-align:-60.4923470511515px" version="1.1" viewBox="52.71 60.49 218.24 77.77" width="218.24"><g transform="matrix(1 0 0 -1 52.7113358542618 77.77478893845345) translate(0,3.54) translate(52.71,0)"><g transform="translate(-52.71,0) translate(4.15,0) translate(0,-3.54)"><foreignObject style="--ltx-fo-width:7.02em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.35em;font-size:10pt;" height="16.55" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="97.12"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S27.Ex44.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{C_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(CF(H)^{\otimes{\sf p}})\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mi>red</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{C_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(CF(H)^{\otimes{\sf p}})\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 52.7113358542618 -0.27673578005007266 L 52.7113358542618 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(47.52,0) translate(0,8.64) translate(4.15,0) translate(0,-4.49)"><foreignObject style="--ltx-fo-width:1.62em;--ltx-fo-height:0.65em;--ltx-fo-depth:0em;font-size:10pt;" height="8.98" overflow="visible" transform="matrix(1 0 0 -1 0 8.98)" width="22.39"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S27.Ex44.m1.pic1.m2" class="ltx_Math" alttext="\scriptstyle{P^{\rm red}}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.700em">P</mi><mi mathsize="0.710em">red</mi></msup><annotation encoding="application/x-tex">\scriptstyle{P^{\rm red}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(85.92,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 52.7113358542618 -0.27673578005007266 L 85.9201361863498 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 85.9201361863498 -0.27673578005007266 L 85.9201361863498 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -12.491705738625553 L 0.27673578005007266 -12.491705738625553" fill="none" stroke="#000000"></path><g transform="translate(0,-33.94)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.93905595309906 L 0.27673578005007266 -12.491705738625553" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.93905595309906 L 0.27673578005007266 -33.93905595309906" fill="none" stroke="#000000"></path><g transform="translate(85.92,0) translate(4.15,0) translate(0,-3.54)"><foreignObject style="--ltx-fo-width:5.15em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.35em;font-size:10pt;" height="16.55" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="71.31"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S27.Ex44.m1.pic1.m3" class="ltx_Math" alttext="\textstyle{CF_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(H^{\natural{\sf p}})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>F</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mi>red</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{CF_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(H^{\natural{\sf p}})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 125.44882417929293 -12.491705738625553 L 126.00229573939308 -12.491705738625553" fill="none" stroke="#000000"></path><g transform="translate(125.73,0) translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 125.44882417929293 -33.208800332088 L 126.00229573939308 -12.491705738625553" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 125.44882417929293 -33.208800332088 L 126.00229573939308 -33.208800332088" fill="none" stroke="#000000"></path><g transform="translate(-50.52,0) translate(0,-45.57) translate(4.15,0) translate(0,-3.54)"><foreignObject style="--ltx-fo-width:6.7em;--ltx-fo-height:0.8em;--ltx-fo-depth:0.35em;font-size:10pt;" height="15.82" overflow="visible" transform="matrix(1 0 0 -1 0 11.02)" width="92.74"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S27.Ex44.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 50.52046342329545 -45.84817449565215 L 50.52046342329545 -45.29470293555201" fill="none" stroke="#000000"></path><g transform="translate(54.45,0) translate(0,-53.03) translate(4.15,0) translate(0,-3.31)"><foreignObject style="--ltx-fo-width:0.62em;--ltx-fo-height:0.48em;--ltx-fo-depth:0em;font-size:10pt;" height="6.62" overflow="visible" transform="matrix(1 0 0 -1 0 6.62)" width="8.53"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S27.Ex44.m1.pic1.m5" class="ltx_Math" alttext="\scriptstyle{P}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">P</mi><annotation encoding="application/x-tex">\scriptstyle{P}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(88.11,0) translate(0,-45.57)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 50.52046342329545 -45.84817449565215 L 88.11100861731614 -45.29470293555201" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 88.11100861731614 -45.84817449565215 L 88.11100861731614 -45.29470293555201" fill="none" stroke="#000000"></path><g transform="translate(88.11,0) translate(0,-45.57) translate(4.15,0) translate(0,-3.54)"><foreignObject style="--ltx-fo-width:4.84em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.35em;font-size:10pt;" height="16.55" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="66.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S27.Ex44.m1.pic1.m6" class="ltx_Math" alttext="\textstyle{CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}})}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}})}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S27.SS4.p4" class="ltx_para ltx_noindent">
<p id="S27.SS4.p4.1" class="ltx_p">The proof is provided momentarily. As the reduced versions of the involved complexes are filtered homotopy equivalent to the original versions, by Theorem <a href="#S7.Thmthm40" title="Theorem 7.40. ‣ 7.5.3. Barcodes ‣ 7.5. Quantitative theories ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.40</span></a>, one has the following immediate corollary.</p>
</div>
<div id="S27.Thmthm10" class="ltx_theorem ltx_theorem_cor">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S27.Thmthm10.2" class="ltx_text ltx_font_bold">Corollary 27.10</span></span><span id="S27.Thmthm10.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S27.Thmthm10.p1" class="ltx_para">
<p id="S27.Thmthm10.p1.1" class="ltx_p"><math id="S27.Thmthm10.p1.m1" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math><span id="S27.Thmthm10.p1.1.1" class="ltx_text ltx_font_italic"> is a filtered homotopy equivalence. Therefore, the concise barcodes of <math id="S27.Thmthm10.p1.m2" class="ltx_Math" alttext="C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}})</annotation></semantics></math> and <math id="S27.Thmthm10.p1.m3" class="ltx_Math" alttext="CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}})</annotation></semantics></math> coincide.</span></p>
</div>
</div>
<div id="S27.SS4.p5" class="ltx_para ltx_noindent">
<p id="S27.SS4.p5.1" class="ltx_p">To prove Theorem <a href="#S27.Thmthm9" title="Theorem 27.9. ‣ 27.4. Equivariant pair-of-pants product ‣ 27. Quantitative Results about Equivariant Floer Theory ‣ Part IV EQUIVARIANT FLOER THEORY AND STEENROD OPERATIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27.9</span></a>, we proceed by building the local inverses.</p>
</div>
<div id="S27.Thmthm11" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S27.Thmthm11.2" class="ltx_text ltx_font_bold">Lemma 27.11</span></span><span id="S27.Thmthm11.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S27.Thmthm11.p1" class="ltx_para ltx_noindent">
<p id="S27.Thmthm11.p1.1" class="ltx_p"><span id="S27.Thmthm11.p1.1.1" class="ltx_text ltx_font_italic">We can write the equivariant pair-of-pants product <math id="S27.Thmthm11.p1.m1" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> as</span></p>
<table id="S27.Ex45" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex45.m1" class="ltx_Math" alttext="P=P_{\rm loc}+P_{\rm big}" display="block" intent=":literal"><semantics><mrow><mi>P</mi><mo>=</mo><mrow><msub><mi>P</mi><mi>loc</mi></msub><mo>+</mo><msub><mi>P</mi><mi>big</mi></msub></mrow></mrow><annotation encoding="application/x-tex">P=P_{\rm loc}+P_{\rm big}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.Thmthm11.p1.2" class="ltx_p"><span id="S27.Thmthm11.p1.2.1" class="ltx_text ltx_font_italic">which satisfy the following conditions.</span></p>
</div>
<div id="S27.Thmthm11.p2" class="ltx_para">
<ol id="S27.I4" class="ltx_enumerate">
<li id="S27.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S27.I4.i1.p1" class="ltx_para ltx_noindent">
<p id="S27.I4.i1.p1.1" class="ltx_p"><span id="S27.I4.i1.p1.1.1" class="ltx_text ltx_font_italic">For each </span><math id="S27.I4.i1.p1.m1" class="ltx_Math" alttext="x\in\tilde{\mathcal{O}}(H)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x\in\tilde{\mathcal{O}}(H)</annotation></semantics></math><span id="S27.I4.i1.p1.1.2" class="ltx_text ltx_font_italic">, denote </span><math id="S27.I4.i1.p1.m2" class="ltx_math_unparsed" alttext="x^{\otimes p}=x\otimes\cdots\otimes x" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><msup><mrow></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>p</mi></mrow></msup><mo>=</mo><mi>x</mi><mo lspace="0.222em">⊗</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">⊗</mo><mi>x</mi></mrow><annotation encoding="application/x-tex">x^{\otimes p}=x\otimes\cdots\otimes x</annotation></semantics></math><span id="S27.I4.i1.p1.1.3" class="ltx_text ltx_font_italic">. Then one has</span></p>
<table id="S27.Ex46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex46.m1" class="ltx_Math" alttext="P_{\rm loc}(C_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}(CF(H)^{\otimes{\sf p}},x^{\otimes{\sf p}}))\subseteq CF_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}(H^{\natural{\sf p}},x^{({\sf p})})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>P</mi><mi>loc</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mo>,</mo><mi>loc</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo>,</mo><msup><mi>x</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊆</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mo>,</mo><mi>loc</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo>,</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>𝗉</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P_{\rm loc}(C_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}(CF(H)^{\otimes{\sf p}},x^{\otimes{\sf p}}))\subseteq CF_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}(H^{\natural{\sf p}},x^{({\sf p})}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.I4.i1.p1.2" class="ltx_p"><span id="S27.I4.i1.p1.2.1" class="ltx_text ltx_font_italic">Denote the restriction by</span></p>
<table id="S27.Ex47" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex47.m1" class="ltx_Math" alttext="P_{x}:C_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}(CF(H)^{\otimes{\sf p}},x^{\otimes{\sf p}})\to CF_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}(H^{\natural{\sf p}},x^{({\sf p})})." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mi>x</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>C</mi><mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mo>,</mo><mi>loc</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo>,</mo><msup><mi>x</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mrow><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mo>,</mo><mi>loc</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo>,</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>𝗉</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P_{x}:C_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}(CF(H)^{\otimes{\sf p}},x^{\otimes{\sf p}})\to CF_{{{\mathbb{Z}}_{\sf p}},{\rm loc}}(H^{\natural{\sf p}},x^{({\sf p})}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S27.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S27.I4.i2.p1" class="ltx_para ltx_noindent">
<p id="S27.I4.i2.p1.1" class="ltx_p"><span id="S27.I4.i2.p1.1.1" class="ltx_text ltx_font_italic">There exists </span><math id="S27.I4.i2.p1.m1" class="ltx_Math" alttext="\delta_{H}^{\prime\prime}&gt;0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>δ</mi><mi>H</mi><mo>′′</mo></msubsup><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta_{H}^{\prime\prime}&gt;0</annotation></semantics></math><span id="S27.I4.i2.p1.1.2" class="ltx_text ltx_font_italic"> such that </span><math id="S27.I4.i2.p1.m2" class="ltx_Math" alttext="P_{\rm big}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>big</mi></msub><annotation encoding="application/x-tex">P_{\rm big}</annotation></semantics></math><span id="S27.I4.i2.p1.1.3" class="ltx_text ltx_font_italic"> increases the filtration by at least </span><math id="S27.I4.i2.p1.m3" class="ltx_Math" alttext="\delta_{H}^{\prime\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>δ</mi><mi>H</mi><mo>′′</mo></msubsup><annotation encoding="application/x-tex">\delta_{H}^{\prime\prime}</annotation></semantics></math><span id="S27.I4.i2.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S27.I4.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S27.I4.i3.p1" class="ltx_para ltx_noindent">
<p id="S27.I4.i3.p1.1" class="ltx_p"><math id="S27.I4.i3.p1.m1" class="ltx_Math" alttext="P_{x}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>x</mi></msub><annotation encoding="application/x-tex">P_{x}</annotation></semantics></math><span id="S27.I4.i3.p1.1.1" class="ltx_text ltx_font_italic"> is independent of choices and agrees with the local equivariant pair-of-pants product constructed by Seidel </span><cite class="ltx_cite ltx_citemacro_cite"><span id="S27.I4.i3.p1.1.2" class="ltx_text ltx_font_italic">[</span><a href="#bib.bib48" title="" class="ltx_ref">60</a><span id="S27.I4.i3.p1.1.3" class="ltx_text ltx_font_italic">]</span></cite><span id="S27.I4.i3.p1.1.4" class="ltx_text ltx_font_italic"> (for </span><math id="S27.I4.i3.p1.m2" class="ltx_Math" alttext="{\sf p}=2" display="inline" intent=":literal"><semantics><mrow><mi>𝗉</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">{\sf p}=2</annotation></semantics></math><span id="S27.I4.i3.p1.1.5" class="ltx_text ltx_font_italic">) and Shelukhin–Zhao </span><cite class="ltx_cite ltx_citemacro_cite"><span id="S27.I4.i3.p1.1.6" class="ltx_text ltx_font_italic">[</span><a href="#bib.bib47" title="" class="ltx_ref">62</a><span id="S27.I4.i3.p1.1.7" class="ltx_text ltx_font_italic">]</span></cite><span id="S27.I4.i3.p1.1.8" class="ltx_text ltx_font_italic"> (for </span><math id="S27.I4.i3.p1.m3" class="ltx_Math" alttext="{\sf p}&gt;2" display="inline" intent=":literal"><semantics><mrow><mi>𝗉</mi><mo>&gt;</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">{\sf p}&gt;2</annotation></semantics></math><span id="S27.I4.i3.p1.1.9" class="ltx_text ltx_font_italic">).</span></p>
</div></li>
<li id="S27.I4.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S27.I4.i4.p1" class="ltx_para">
<p id="S27.I4.i4.p1.1" class="ltx_p"><math id="S27.I4.i4.p1.m1" class="ltx_Math" alttext="P_{x}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>x</mi></msub><annotation encoding="application/x-tex">P_{x}</annotation></semantics></math><span id="S27.I4.i4.p1.1.1" class="ltx_text ltx_font_italic"> is invertible.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S27.SS4.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S27.SS4.p6" class="ltx_para ltx_noindent">
<p id="S27.SS4.p6.1" class="ltx_p"><span id="S27.SS4.p6.1.1" class="ltx_text">The decomposition and the first two items are based on the crossing energy argument (cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib2" title="" class="ltx_ref">12</a>, Lemma B.1]</cite>). To see that <math id="S27.SS4.p6.m1" class="ltx_Math" alttext="P_{\rm loc}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>loc</mi></msub><annotation encoding="application/x-tex">P_{\rm loc}</annotation></semantics></math> is well-defined, suppose <math id="S27.SS4.p6.m2" class="ltx_Math" alttext="P^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>′</mo></msup><annotation encoding="application/x-tex">P^{\prime}</annotation></semantics></math> is another construction which has a similar decomposition <math id="S27.SS4.p6.m3" class="ltx_Math" alttext="P^{\prime}=P_{\rm loc}^{\prime}+P_{\rm big}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>P</mi><mo>′</mo></msup><mo>=</mo><mrow><msubsup><mi>P</mi><mi>loc</mi><mo>′</mo></msubsup><mo>+</mo><msubsup><mi>P</mi><mi>big</mi><mo>′</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">P^{\prime}=P_{\rm loc}^{\prime}+P_{\rm big}^{\prime}</annotation></semantics></math>. Then <math id="S27.SS4.p6.m4" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> and <math id="S27.SS4.p6.m5" class="ltx_Math" alttext="P^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>′</mo></msup><annotation encoding="application/x-tex">P^{\prime}</annotation></semantics></math> are homotopic via a filtered chain homotopy <math id="S27.SS4.p6.m6" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>. So</span></p>
<table id="S27.Ex48" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex48.m1" class="ltx_Math" alttext="P-P^{\prime}=Kd_{{{\mathbb{Z}}_{\sf p}}}+d_{{{\mathbb{Z}}_{\sf p}}}K." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>P</mi><mo>−</mo><msup><mi>P</mi><mo>′</mo></msup></mrow><mo>=</mo><mrow><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub></mrow><mo>+</mo><mrow><msub><mi>d</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P-P^{\prime}=Kd_{{{\mathbb{Z}}_{\sf p}}}+d_{{{\mathbb{Z}}_{\sf p}}}K.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.SS4.p6.2" class="ltx_p"><span id="S27.SS4.p6.2.1" class="ltx_text">Since <math id="S27.SS4.p6.m7" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> also admits the decomposition into the local component and “big” component in view of the cross-energy lemma, by passing to the local piece, one has <math id="S27.SS4.p6.m8" class="ltx_Math" alttext="P_{\rm loc}=P_{\rm loc}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>loc</mi></msub><mo>=</mo><msubsup><mi>P</mi><mi>loc</mi><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">P_{\rm loc}=P_{\rm loc}^{\prime}</annotation></semantics></math> on cohomology.</span></p>
</div>
<div id="S27.SS4.p7" class="ltx_para ltx_noindent">
<p id="S27.SS4.p7.1" class="ltx_p"><span id="S27.SS4.p7.1.1" class="ltx_text">Furthermore, since the local argument does not involve sphere bubbling, the equivalence between our FOP counts and the counts defined using classical framework as used in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib13" title="" class="ltx_ref">61</a>]</cite> and <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib47" title="" class="ltx_ref">62</a>]</cite> can be made using the same argument as proving Part (2) of Theorem <a href="#Thmthma8" title="Theorem H (Quantum Steenrod operation on general symplectic manifold). ‣ 1.2.1. The quantum Steenrod operations ‣ 1.2. Main results on equivariant Floer theory and Steenrod operations ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H</span></a>.</span></p>
</div>
<div id="S27.SS4.p8" class="ltx_para">
<p id="S27.SS4.p8.1" class="ltx_p"><span id="S27.SS4.p8.1.1" class="ltx_text">Lastly, the invertibility of <math id="S27.SS4.p8.m1" class="ltx_Math" alttext="P_{x}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>x</mi></msub><annotation encoding="application/x-tex">P_{x}</annotation></semantics></math> is proved in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib13" title="" class="ltx_ref">61</a>]</cite> by a local computation for <math id="S27.SS4.p8.m2" class="ltx_Math" alttext="{\sf p}=2" display="inline" intent=":literal"><semantics><mrow><mi>𝗉</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">{\sf p}=2</annotation></semantics></math>, and in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib47" title="" class="ltx_ref">62</a>]</cite> by constructing the local equivariant coproduct and prove that the local coproduct is the inverse of <math id="S27.SS4.p8.m3" class="ltx_Math" alttext="P_{x}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>x</mi></msub><annotation encoding="application/x-tex">P_{x}</annotation></semantics></math> for <math id="S27.SS4.p8.m4" class="ltx_Math" alttext="{\sf p}&gt;2" display="inline" intent=":literal"><semantics><mrow><mi>𝗉</mi><mo>&gt;</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">{\sf p}&gt;2</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S27.SS4.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Theorem <a href="#S27.Thmthm9" title="Theorem 27.9. ‣ 27.4. Equivariant pair-of-pants product ‣ 27. Quantitative Results about Equivariant Floer Theory ‣ Part IV EQUIVARIANT FLOER THEORY AND STEENROD OPERATIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27.9</span></a>.</h6>
<div id="S27.SS4.p9" class="ltx_para ltx_noindent">
<p id="S27.SS4.p9.1" class="ltx_p"><span id="S27.SS4.p9.1.1" class="ltx_text">Now consider the composition</span></p>
<table id="S27.Ex49" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex49.m1" class="ltx_Math" alttext="P^{\rm red}:=\pi\circ P\circ\sigma:C_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(CF(H)^{\otimes{\sf p}})\to CF_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(H^{\natural{\sf p}})" display="block" intent=":literal"><semantics><mrow><msup><mi>P</mi><mi>red</mi></msup><mo>:=</mo><mrow><mi>π</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>P</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>σ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mi>red</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>F</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mi>red</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">P^{\rm red}:=\pi\circ P\circ\sigma:C_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(CF(H)^{\otimes{\sf p}})\to CF_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(H^{\natural{\sf p}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.SS4.p9.2" class="ltx_p"><span id="S27.SS4.p9.2.1" class="ltx_text">which is a filtered chain map. Notice that there is an obvious leading order term, denoted by <math id="S27.SS4.p9.m1" class="ltx_Math" alttext="P_{\rm loc}^{\rm red}" display="inline" intent=":literal"><semantics><msubsup><mi>P</mi><mi>loc</mi><mi>red</mi></msubsup><annotation encoding="application/x-tex">P_{\rm loc}^{\rm red}</annotation></semantics></math>, which is the direct sum of <math id="S27.SS4.p9.m2" class="ltx_Math" alttext="P_{x}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>x</mi></msub><annotation encoding="application/x-tex">P_{x}</annotation></semantics></math>, while the difference</span></p>
<table id="S27.Ex50" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex50.m1" class="ltx_Math" alttext="P_{\rm big}^{\rm red}:=P^{\rm red}-P_{\rm loc}^{\rm red}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>P</mi><mi>big</mi><mi>red</mi></msubsup><mo>:=</mo><mrow><msup><mi>P</mi><mi>red</mi></msup><mo>−</mo><msubsup><mi>P</mi><mi>loc</mi><mi>red</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">P_{\rm big}^{\rm red}:=P^{\rm red}-P_{\rm loc}^{\rm red}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.SS4.p9.3" class="ltx_p"><span id="S27.SS4.p9.3.1" class="ltx_text">strictly increases the energy filtration. Hence <math id="S27.SS4.p9.m3" class="ltx_Math" alttext="P^{\rm red}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mi>red</mi></msup><annotation encoding="application/x-tex">P^{\rm red}</annotation></semantics></math> is invertible. Therefore, after tensoring with the correct Novikov field, <math id="S27.SS4.p9.m4" class="ltx_Math" alttext="P^{\rm red}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mi>red</mi></msup><annotation encoding="application/x-tex">P^{\rm red}</annotation></semantics></math> is a filtered isomorphism of Floer-type complexes.
∎</span></p>
</div>
</div>
</section>
<section id="S27.SS5" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">27.5. </span>Proof of Theorem <a href="#Thmthma13" title="Theorem M (Barcode stretching under prime iteration). ‣ 1.3.3. Quantitative features of equivariant Floer theory ‣ 1.3. Main results on quantitative Floer theory ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">M</span></a></h4>

<div id="S27.SS5.p1" class="ltx_para ltx_noindent">
<p id="S27.SS5.p1.1" class="ltx_p">The first item, which says that the equivariant Floer cochain complex <math id="S27.SS5.p1.m1" class="ltx_Math" alttext="CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}})</annotation></semantics></math> is a Floer-type complex over <math id="S27.SS5.p1.m2" class="ltx_Math" alttext="\Lambda_{{\bf K}_{\sf p}}^{\Pi}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Π</mi></msubsup><annotation encoding="application/x-tex">\Lambda_{{\bf K}_{\sf p}}^{\Pi}</annotation></semantics></math> follows directly from the construction.</p>
</div>
<div id="S27.SS5.p2" class="ltx_para ltx_noindent">
<p id="S27.SS5.p2.1" class="ltx_p">The second item is exactly Corollary <a href="#S27.Thmthm10" title="Corollary 27.10. ‣ 27.4. Equivariant pair-of-pants product ‣ 27. Quantitative Results about Equivariant Floer Theory ‣ Part IV EQUIVARIANT FLOER THEORY AND STEENROD OPERATIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27.10</span></a>.</p>
</div>
<div id="S27.SS5.p3" class="ltx_para ltx_noindent">
<p id="S27.SS5.p3.1" class="ltx_p">For the third item, by Corollary <a href="#S27.Thmthm10" title="Corollary 27.10. ‣ 27.4. Equivariant pair-of-pants product ‣ 27. Quantitative Results about Equivariant Floer Theory ‣ Part IV EQUIVARIANT FLOER THEORY AND STEENROD OPERATIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27.10</span></a>, the barcodes of the two complexes <math id="S27.SS5.p3.m1" class="ltx_Math" alttext="C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}})</annotation></semantics></math> and <math id="S27.SS5.p3.m2" class="ltx_Math" alttext="CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}})</annotation></semantics></math> are identical. On the other hand, there exists an algebraically defined quasi-Frobenius map (see (<a href="#S23.E3" title="In 23.1.1. The algebraic construction ‣ 23.1. Tate Equivariant Cohomology ‣ 23. Equivariant Morse and Floer Cohomology ‣ Part IV EQUIVARIANT FLOER THEORY AND STEENROD OPERATIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23.3</span></a>))</p>
<table id="S27.Ex51" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex51.m1" class="ltx_Math" alttext="qF:HF(H)\to H_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">qF:HF(H)\to H_{{{\mathbb{Z}}_{\sf p}}}(CF(H)^{\otimes{\sf p}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.SS5.p3.2" class="ltx_p">Although <math id="S27.SS5.p3.m3" class="ltx_Math" alttext="qF" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><annotation encoding="application/x-tex">qF</annotation></semantics></math> is not induced from a cochain map, it still respects the filtration in the following way. For each <math id="S27.SS5.p3.m4" class="ltx_Math" alttext="\tau\in{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">\tau\in{\mathbb{R}}</annotation></semantics></math>, one has corresponding <math id="S27.SS5.p3.m5" class="ltx_Math" alttext="{\bf F}_{\sf p}" display="inline" intent=":literal"><semantics><msub><mi>𝐅</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{\bf F}_{\sf p}</annotation></semantics></math>-linear map</p>
<table id="S27.Ex52" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex52.m1" class="ltx_Math" alttext="qF:HF^{\leq\tau}(H)\to H_{{{\mathbb{Z}}_{\sf p}}}^{\leq{\sf p}\tau}(CF(H)^{\otimes{\sf p}})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>F</mi><mrow><mphantom></mphantom><mo>≤</mo><mi>τ</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msubsup><mi>H</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>𝗉</mi><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">qF:HF^{\leq\tau}(H)\to H_{{{\mathbb{Z}}_{\sf p}}}^{\leq{\sf p}\tau}(CF(H)^{\otimes{\sf p}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S27.SS5.p4" class="ltx_para ltx_noindent">
<p id="S27.SS5.p4.1" class="ltx_p">In the current setting, it is hard to obtain the relationship between barcodes, but only the bar-length spectrum. Then, following the argument in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib46" title="" class="ltx_ref">65</a>, Section 6.2]</cite>, one can define a version of Floer complex over the universal Novikov ring</p>
<table id="S27.Ex53" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S27.Ex53.m1" class="ltx_Math" alttext="\Lambda_{0}^{\rm univ}" display="block" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><mn>0</mn><mi>univ</mi></msubsup><annotation encoding="application/x-tex">\Lambda_{0}^{\rm univ}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S27.SS5.p4.2" class="ltx_p">(with base ring <math id="S27.SS5.p4.m1" class="ltx_Math" alttext="{\bf F}_{\sf p}" display="inline" intent=":literal"><semantics><msub><mi>𝐅</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{\bf F}_{\sf p}</annotation></semantics></math>), denoted by <math id="S27.SS5.p4.m2" class="ltx_Math" alttext="CF(H;\Lambda_{0}^{\rm univ})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><msubsup><mi mathvariant="normal">Λ</mi><mn>0</mn><mi>univ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF(H;\Lambda_{0}^{\rm univ})</annotation></semantics></math>. Then by the general structural results of modules over <math id="S27.SS5.p4.m3" class="ltx_Math" alttext="\Lambda_{0}^{\rm univ}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><mn>0</mn><mi>univ</mi></msubsup><annotation encoding="application/x-tex">\Lambda_{0}^{\rm univ}</annotation></semantics></math>, the bar-lengths <math id="S27.SS5.p4.m4" class="ltx_Math" alttext="\beta_{i}(H)" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\beta_{i}(H)</annotation></semantics></math> correspond to torsion parts of <math id="S27.SS5.p4.m5" class="ltx_Math" alttext="HF(H;\Lambda_{0}^{\rm univ})" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><msubsup><mi mathvariant="normal">Λ</mi><mn>0</mn><mi>univ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">HF(H;\Lambda_{0}^{\rm univ})</annotation></semantics></math> of the forms <math id="S27.SS5.p4.m6" class="ltx_Math" alttext="\Lambda_{0}^{\rm univ}/T^{\beta_{i}(H)}\Lambda_{0}^{\rm univ}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi mathvariant="normal">Λ</mi><mn>0</mn><mi>univ</mi></msubsup><mo>/</mo><msup><mi>T</mi><mrow><msub><mi>β</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathvariant="normal">Λ</mi><mn>0</mn><mi>univ</mi></msubsup></mrow><annotation encoding="application/x-tex">\Lambda_{0}^{\rm univ}/T^{\beta_{i}(H)}\Lambda_{0}^{\rm univ}</annotation></semantics></math>. Then one can prove that the quasi-Frobenius map is an isomorphism of <math id="S27.SS5.p4.m7" class="ltx_Math" alttext="\Lambda_{0}^{\rm univ}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><mn>0</mn><mi>univ</mi></msubsup><annotation encoding="application/x-tex">\Lambda_{0}^{\rm univ}</annotation></semantics></math>-modules after the rescaling by <math id="S27.SS5.p4.m8" class="ltx_Math" alttext="{\sf p}" display="inline" intent=":literal"><semantics><mi>𝗉</mi><annotation encoding="application/x-tex">{\sf p}</annotation></semantics></math>. The result in Theorem <a href="#Thmthma13" title="Theorem M (Barcode stretching under prime iteration). ‣ 1.3.3. Quantitative features of equivariant Floer theory ‣ 1.3. Main results on quantitative Floer theory ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">M</span></a> (3) follows from Theorem <a href="#Thmthma13" title="Theorem M (Barcode stretching under prime iteration). ‣ 1.3.3. Quantitative features of equivariant Floer theory ‣ 1.3. Main results on quantitative Floer theory ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">M</span></a> (2).</p>
</div>
</section>
</section>
<section id="S28" class="ltx_section">
<h3 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">28. </span>Quantitative Theory for Noncontractible Hamiltonian Orbits</h3>

<div id="S28.p1" class="ltx_para ltx_noindent">
<p id="S28.p1.1" class="ltx_p">In this section we provide constructions for the Floer complex for noncontractible orbits (in the homological sense) and the corresponding quantitative results involving a version of equivariant pair-of-pants product. As mentioned before, the main motivation for developing this variant is to generalize the result of Sugimoto <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib56" title="" class="ltx_ref">67</a>]</cite> to full generality, which will be done in a separate paper with Shelukhin and Wilkins <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib2" title="" class="ltx_ref">12</a>]</cite>. Here in this section, we will prove Theorem <a href="#S1.Thmthm11" title="Theorem 1.11 (Filtered Floer chain complex for noncontractible periodic orbits). ‣ 1.3.4. Quantitative Hamiltonian Floer theory for noncontractible orbits ‣ 1.3. Main results on quantitative Floer theory ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.11</span></a> and Theorem <a href="#S1.Thmthm12" title="Theorem 1.12. ‣ 1.3.4. Quantitative Hamiltonian Floer theory for noncontractible orbits ‣ 1.3. Main results on quantitative Floer theory ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.12</span></a>. The only notable technical difference is that the capping of a non-contractible orbit is defined relative to a reference homology class; the rest of the construction is exactly the same as the contractible case.</p>
</div>
<section id="S28.SS1" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">28.1. </span>The Floer flow category and bimodules</h4>

<div id="S28.SS1.p1" class="ltx_para ltx_noindent">
<p id="S28.SS1.p1.1" class="ltx_p">Let <math id="S28.SS1.p1.m1" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> be a smooth loop in <math id="S28.SS1.p1.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> which represents a nontrivial class in <math id="S28.SS1.p1.m3" class="ltx_Math" alttext="H_{1}(X;{\mathbb{Z}})_{\rm free}" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>ℤ</mi><mo stretchy="false">)</mo></mrow><mi>free</mi></msub></mrow><annotation encoding="application/x-tex">H_{1}(X;{\mathbb{Z}})_{\rm free}</annotation></semantics></math>. Denote</p>
<table id="S28.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S28.Ex1.m1" class="ltx_Math" alttext="\Gamma=H_{2}(X;{\mathbb{Z}})/{\rm ker}\omega." display="block" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Γ</mi><mo>=</mo><mrow><mrow><mrow><msub><mi>H</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>ℤ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>ker</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Gamma=H_{2}(X;{\mathbb{Z}})/{\rm ker}\omega.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S28.SS1.p1.2" class="ltx_p">For a nondegenerate Hamiltonian <math id="S28.SS1.p1.m4" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>, we describe a <math id="S28.SS1.p1.m5" class="ltx_Math" alttext="{\mathbb{Z}}_{2}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">{\mathbb{Z}}_{2}</annotation></semantics></math>-graded <math id="S28.SS1.p1.m6" class="ltx_Math" alttext="\Gamma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Γ</mi><annotation encoding="application/x-tex">\Gamma</annotation></semantics></math>-equivariant flow category <math id="S28.SS1.p1.m7" class="ltx_Math" alttext="{\mathbb{F}}_{\gamma}" display="inline" intent=":literal"><semantics><msub><mi>𝔽</mi><mi>γ</mi></msub><annotation encoding="application/x-tex">{\mathbb{F}}_{\gamma}</annotation></semantics></math> of orbits of <math id="S28.SS1.p1.m8" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> which are homologous to <math id="S28.SS1.p1.m9" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>. Recall terms defined in Definition <a href="#S1.Thmthm10" title="Definition 1.10. ‣ 1.3.4. Quantitative Hamiltonian Floer theory for noncontractible orbits ‣ 1.3. Main results on quantitative Floer theory ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.10</span></a>. Define</p>
<table id="S28.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S28.Ex2.m1" class="ltx_Math" alttext="{\rm Ob}{\mathbb{F}}_{\gamma}:=\tilde{\mathcal{O}}_{\gamma}(H)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔽</mi><mi>γ</mi></msub></mrow><mo>:=</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>~</mo></mover><mi>γ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\rm Ob}{\mathbb{F}}_{\gamma}:=\tilde{\mathcal{O}}_{\gamma}(H).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S28.SS1.p1.3" class="ltx_p">To define morphisms of <math id="S28.SS1.p1.m10" class="ltx_Math" alttext="{\mathbb{F}}_{\gamma}" display="inline" intent=":literal"><semantics><msub><mi>𝔽</mi><mi>γ</mi></msub><annotation encoding="application/x-tex">{\mathbb{F}}_{\gamma}</annotation></semantics></math>, choose a 1-periodic family of <math id="S28.SS1.p1.m11" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math>-compatible almost complex structures <math id="S28.SS1.p1.m12" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math> and considering moduli spaces of Floer equations and their compactifications. Then the morphism set between two <math id="S28.SS1.p1.m13" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>-capped orbits is the moduli space of stable Floer trajectories connecting them, where the Floer cylinders naturally concatenate the <math id="S28.SS1.p1.m14" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>-cappings. One then obtains the flow category <math id="S28.SS1.p1.m15" class="ltx_Math" alttext="\mathbb{F}_{\gamma}" display="inline" intent=":literal"><semantics><msub><mi>𝔽</mi><mi>γ</mi></msub><annotation encoding="application/x-tex">\mathbb{F}_{\gamma}</annotation></semantics></math> enriched in <math id="S28.SS1.p1.m16" class="ltx_Math" alttext="\underline{\smash{\bf Top}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐓𝐨𝐩</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf Top}}</annotation></semantics></math> where objects are naturally <math id="S28.SS1.p1.m17" class="ltx_Math" alttext="{\mathbb{Z}}_{2}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">{\mathbb{Z}}_{2}</annotation></semantics></math>-graded. The action functional</p>
<table id="S28.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S28.Ex3.m1" class="ltx_Math" alttext="{\mathcal{A}}_{H,\gamma}:{\rm Ob}{\mathbb{F}}_{\gamma}\to{\mathbb{R}}" display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mi>H</mi><mo>,</mo><mi>γ</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔽</mi><mi>γ</mi></msub></mrow><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{A}}_{H,\gamma}:{\rm Ob}{\mathbb{F}}_{\gamma}\to{\mathbb{R}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S28.SS1.p1.4" class="ltx_p">makes <math id="S28.SS1.p1.m18" class="ltx_Math" alttext="{\mathbb{F}}_{\gamma}" display="inline" intent=":literal"><semantics><msub><mi>𝔽</mi><mi>γ</mi></msub><annotation encoding="application/x-tex">{\mathbb{F}}_{\gamma}</annotation></semantics></math> a locally finite flow category (Definition <a href="#S7.Thmthm2" title="Definition 7.2. ‣ 7.1.2. Convergence ‣ 7.1. Unobstructedness, local finiteness, grading, and orientations ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.2</span></a>). The <math id="S28.SS1.p1.m19" class="ltx_Math" alttext="\Gamma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Γ</mi><annotation encoding="application/x-tex">\Gamma</annotation></semantics></math>-action on objects makes <math id="S28.SS1.p1.m20" class="ltx_Math" alttext="{\mathbb{F}}_{\gamma}" display="inline" intent=":literal"><semantics><msub><mi>𝔽</mi><mi>γ</mi></msub><annotation encoding="application/x-tex">{\mathbb{F}}_{\gamma}</annotation></semantics></math> a <math id="S28.SS1.p1.m21" class="ltx_Math" alttext="\Gamma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Γ</mi><annotation encoding="application/x-tex">\Gamma</annotation></semantics></math>-equivariant flow category (Definition <a href="#S7.Thmthm24" title="Definition 7.24. ‣ 7.3.3. Symmetries on flow categories ‣ 7.3. Symmetries on flow categories, multimodules, and homotopies ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.24</span></a>).</p>
</div>
<div id="S28.SS1.p2" class="ltx_para ltx_noindent">
<p id="S28.SS1.p2.1" class="ltx_p">Notice that if we choose a different loop <math id="S28.SS1.p2.m1" class="ltx_Math" alttext="\gamma^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>γ</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\gamma^{\prime}</annotation></semantics></math> homologous to <math id="S28.SS1.p2.m2" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>, then one essentially get the same flow category except that the actions <math id="S28.SS1.p2.m3" class="ltx_Math" alttext="{\mathcal{A}}_{H,\gamma}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mi>H</mi><mo>,</mo><mi>γ</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{A}}_{H,\gamma}</annotation></semantics></math> and <math id="S28.SS1.p2.m4" class="ltx_Math" alttext="{\mathcal{A}}_{H,\gamma^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mi>H</mi><mo>,</mo><msup><mi>γ</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">{\mathcal{A}}_{H,\gamma^{\prime}}</annotation></semantics></math> differ by a constant.</p>
</div>
<div id="S28.SS1.p3" class="ltx_para ltx_noindent">
<p id="S28.SS1.p3.1" class="ltx_p">If we choose a different pair <math id="S28.SS1.p3.m1" class="ltx_Math" alttext="(H^{\prime},J^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mo>′</mo></msup><mo>,</mo><msup><mi>J</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(H^{\prime},J^{\prime})</annotation></semantics></math> and consider the same construction (for a fixed loop <math id="S28.SS1.p3.m2" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>), then one obtains a similar Floer flow category <math id="S28.SS1.p3.m3" class="ltx_Math" alttext="{\mathbb{F}}_{\gamma}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔽</mi><mi>γ</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathbb{F}}_{\gamma}^{\prime}</annotation></semantics></math>. By choosing a Floer datum on the infinite cylinder interpolating between <math id="S28.SS1.p3.m4" class="ltx_Math" alttext="(H,J)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>J</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(H,J)</annotation></semantics></math> and <math id="S28.SS1.p3.m5" class="ltx_Math" alttext="(H^{\prime},J^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mo>′</mo></msup><mo>,</mo><msup><mi>J</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(H^{\prime},J^{\prime})</annotation></semantics></math> and considering moduli spaces of Floer equations associated to the Floer datum, one obtains a bimodule <math id="S28.SS1.p3.m6" class="ltx_Math" alttext="\mathbb{B}_{\gamma}" display="inline" intent=":literal"><semantics><msub><mi>𝔹</mi><mi>γ</mi></msub><annotation encoding="application/x-tex">\mathbb{B}_{\gamma}</annotation></semantics></math> over <math id="S28.SS1.p3.m7" class="ltx_Math" alttext="({\mathbb{F}}_{\gamma};{\mathbb{F}}_{\gamma}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>γ</mi></msub><mo>;</mo><msubsup><mi>𝔽</mi><mi>γ</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{\gamma};{\mathbb{F}}_{\gamma}^{\prime})</annotation></semantics></math>, which is naturally <math id="S28.SS1.p3.m8" class="ltx_Math" alttext="\Gamma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Γ</mi><annotation encoding="application/x-tex">\Gamma</annotation></semantics></math>-equivariant (Definition <a href="#S7.Thmthm26" title="Definition 7.26. ‣ 7.3.4. Symmetries on multimodules and homotopies ‣ 7.3. Symmetries on flow categories, multimodules, and homotopies ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.26</span></a>). This is completely analogous to the usual contractible case.</p>
</div>
</section>
<section id="S28.SS2" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">28.2. </span>The complex and continuation map</h4>

<div id="S28.SS2.p1" class="ltx_para ltx_noindent">
<p id="S28.SS2.p1.1" class="ltx_p">Since the Floer homology of the noncontractible case is (expected to be) trivial, in fact, the Floer complex is null-homotopic, the only interesting theory is the quantitative theory. Consider</p>
<table id="S28.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S28.Ex4.m1" class="ltx_math_unparsed" alttext="CF_{\gamma}(H):=\Big\{\sum_{i=1}^{\infty}a_{i}p_{i}\ |\ a_{i}\in{\mathbb{Z}},\ p_{i}\in{\rm Ob}{\mathbb{F}}_{\gamma},\ \lim_{i\to\infty}{\mathcal{A}}_{H,\gamma}(p_{i})=-\infty\Big\}" display="block" intent=":literal"><semantics><mrow><mi>C</mi><msub><mi>F</mi><mi>γ</mi></msub><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mo>:=</mo><mrow><mo stretchy="false">{</mo><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover><msub><mi>a</mi><mi>i</mi></msub><msub><mi>p</mi><mi>i</mi></msub><mo fence="false" rspace="0.667em" stretchy="false">|</mo><msub><mi>a</mi><mi>i</mi></msub><mo>∈</mo><mi>ℤ</mi><mo rspace="0.667em">,</mo><msub><mi>p</mi><mi>i</mi></msub><mo>∈</mo><mi>Ob</mi><msub><mi>𝔽</mi><mi>γ</mi></msub><mo rspace="0.389em">,</mo><munder><mo movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>i</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mi>H</mi><mo>,</mo><mi>γ</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">CF_{\gamma}(H):=\Big\{\sum_{i=1}^{\infty}a_{i}p_{i}\ |\ a_{i}\in{\mathbb{Z}},\ p_{i}\in{\rm Ob}{\mathbb{F}}_{\gamma},\ \lim_{i\to\infty}{\mathcal{A}}_{H,\gamma}(p_{i})=-\infty\Big\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S28.SS2.p1.2" class="ltx_p">which is a module over <math id="S28.SS2.p1.m1" class="ltx_Math" alttext="\Lambda_{{\mathbb{Z}}}^{\Gamma}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><mi>ℤ</mi><mi mathvariant="normal">Γ</mi></msubsup><annotation encoding="application/x-tex">\Lambda_{{\mathbb{Z}}}^{\Gamma}</annotation></semantics></math>.</p>
</div>
<div id="S28.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Theorem <a href="#S1.Thmthm11" title="Theorem 1.11 (Filtered Floer chain complex for noncontractible periodic orbits). ‣ 1.3.4. Quantitative Hamiltonian Floer theory for noncontractible orbits ‣ 1.3. Main results on quantitative Floer theory ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.11</span></a>.</h6>
<div id="S28.SS2.p2" class="ltx_para ltx_noindent">
<p id="S28.SS2.p2.1" class="ltx_p"><span id="S28.SS2.p2.1.1" class="ltx_text">The AMS construction for the flow category <math id="S28.SS2.p2.m1" class="ltx_Math" alttext="{\mathbb{F}}_{\gamma}" display="inline" intent=":literal"><semantics><msub><mi>𝔽</mi><mi>γ</mi></msub><annotation encoding="application/x-tex">{\mathbb{F}}_{\gamma}</annotation></semantics></math> is almost identical to the contractible case. There are only two minor places which we would like to comment. The first one is the existence of integral actions. The proof of Proposition <a href="#S15.Thmthm4" title="Proposition 15.4. ‣ 15.1. Integral modification of topological energy ‣ 15. Relatively Smooth AMS lifts ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15.4</span></a> works equally well for the noncontractible case. Then one can go through the AMS construction for the flow category. The change of Novikov group from <math id="S28.SS2.p2.m2" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math> to <math id="S28.SS2.p2.m3" class="ltx_Math" alttext="\Gamma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Γ</mi><annotation encoding="application/x-tex">\Gamma</annotation></semantics></math> does not affect our argument to make each step of the construction equivariant. Then upon making choices, one obtains a lift of the outercollaring of <math id="S28.SS2.p2.m4" class="ltx_Math" alttext="{\mathbb{F}}_{\gamma}" display="inline" intent=":literal"><semantics><msub><mi>𝔽</mi><mi>γ</mi></msub><annotation encoding="application/x-tex">{\mathbb{F}}_{\gamma}</annotation></semantics></math> to <math id="S28.SS2.p2.m5" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>NC</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}</annotation></semantics></math>. Choosing FOP perturbations allows us to construct the differential, hence obtaining a <math id="S28.SS2.p2.m6" class="ltx_Math" alttext="{\mathbb{Z}}_{2}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">{\mathbb{Z}}_{2}</annotation></semantics></math>-graded chain complex</span></p>
<table id="S28.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S28.Ex5.m1" class="ltx_Math" alttext="CF_{\gamma}(H,J,\Xi)" display="block" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mi>γ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>J</mi><mo>,</mo><mi mathvariant="normal">Ξ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF_{\gamma}(H,J,\Xi)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S28.SS2.p2.2" class="ltx_p"><span id="S28.SS2.p2.2.1" class="ltx_text">(linear over <math id="S28.SS2.p2.m7" class="ltx_Math" alttext="\Lambda_{\mathbb{Z}}^{\Gamma}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><mi>ℤ</mi><mi mathvariant="normal">Γ</mi></msubsup><annotation encoding="application/x-tex">\Lambda_{\mathbb{Z}}^{\Gamma}</annotation></semantics></math>).</span></p>
</div>
<div id="S28.SS2.p3" class="ltx_para ltx_noindent">
<p id="S28.SS2.p3.1" class="ltx_p"><span id="S28.SS2.p3.1.1" class="ltx_text">After changing coefficients to <math id="S28.SS2.p3.m1" class="ltx_Math" alttext="\Lambda_{\bf K}^{\Gamma}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><mi>𝐊</mi><mi mathvariant="normal">Γ</mi></msubsup><annotation encoding="application/x-tex">\Lambda_{\bf K}^{\Gamma}</annotation></semantics></math>, one obtains a Floer-type complex because the differential increases the filtration.</span></p>
</div>
<div id="S28.SS2.p4" class="ltx_para ltx_noindent">
<p id="S28.SS2.p4.1" class="ltx_p"><span id="S28.SS2.p4.1.1" class="ltx_text">To see that the filtered isomorphism class only depends on <math id="S28.SS2.p4.m1" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>, we compare two different almost complex structures <math id="S28.SS2.p4.m2" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math>, <math id="S28.SS2.p4.m3" class="ltx_Math" alttext="J^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>J</mi><mo>′</mo></msup><annotation encoding="application/x-tex">J^{\prime}</annotation></semantics></math> and two different sets of choices <math id="S28.SS2.p4.m4" class="ltx_Math" alttext="\Xi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ξ</mi><annotation encoding="application/x-tex">\Xi</annotation></semantics></math>, <math id="S28.SS2.p4.m5" class="ltx_Math" alttext="\Xi^{\prime}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Ξ</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\Xi^{\prime}</annotation></semantics></math>, resulting in AMS lifts <math id="S28.SS2.p4.m6" class="ltx_Math" alttext="\tilde{\mathbb{F}}_{\gamma}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mi>γ</mi></msub><annotation encoding="application/x-tex">\tilde{\mathbb{F}}_{\gamma}</annotation></semantics></math> and <math id="S28.SS2.p4.m7" class="ltx_Math" alttext="\tilde{\mathbb{F}}_{\gamma}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mi>γ</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">\tilde{\mathbb{F}}_{\gamma}^{\prime}</annotation></semantics></math>. Choose an interpolation between <math id="S28.SS2.p4.m8" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math> and <math id="S28.SS2.p4.m9" class="ltx_Math" alttext="J^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>J</mi><mo>′</mo></msup><annotation encoding="application/x-tex">J^{\prime}</annotation></semantics></math> and consider the corresponding bimodule <math id="S28.SS2.p4.m10" class="ltx_Math" alttext="{\mathbb{B}}_{\gamma}" display="inline" intent=":literal"><semantics><msub><mi>𝔹</mi><mi>γ</mi></msub><annotation encoding="application/x-tex">{\mathbb{B}}_{\gamma}</annotation></semantics></math> over <math id="S28.SS2.p4.m11" class="ltx_Math" alttext="({\mathbb{F}}_{\gamma};{\mathbb{F}}_{\gamma}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>γ</mi></msub><mo>;</mo><msubsup><mi>𝔽</mi><mi>γ</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{\gamma};{\mathbb{F}}_{\gamma}^{\prime})</annotation></semantics></math> via continuation map moduli spaces. One apply the AMS construction for <math id="S28.SS2.p4.m12" class="ltx_Math" alttext="{\mathbb{B}}_{\gamma}" display="inline" intent=":literal"><semantics><msub><mi>𝔹</mi><mi>γ</mi></msub><annotation encoding="application/x-tex">{\mathbb{B}}_{\gamma}</annotation></semantics></math>, ending with a chain map</span></p>
<table id="S28.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S28.Ex6.m1" class="ltx_Math" alttext="\Phi^{{\mathbb{B}}_{\gamma}}:CF_{\gamma}(H,J,\Xi)\to CF_{\gamma}(H,J^{\prime},\Xi^{\prime})." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">Φ</mi><msub><mi>𝔹</mi><mi>γ</mi></msub></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mi>γ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>J</mi><mo>,</mo><mi mathvariant="normal">Ξ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mi>γ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><msup><mi>J</mi><mo>′</mo></msup><mo>,</mo><msup><mi mathvariant="normal">Ξ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Phi^{{\mathbb{B}}_{\gamma}}:CF_{\gamma}(H,J,\Xi)\to CF_{\gamma}(H,J^{\prime},\Xi^{\prime}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S28.SS2.p4.2" class="ltx_p"><span id="S28.SS2.p4.2.1" class="ltx_text">Notice that the two chain groups are canonically identified since the Hamiltonian <math id="S28.SS2.p4.m13" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> is fixed. The leading order term of <math id="S28.SS2.p4.m14" class="ltx_Math" alttext="\Phi^{{\mathbb{B}}_{\gamma}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><msub><mi>𝔹</mi><mi>γ</mi></msub></msup><annotation encoding="application/x-tex">\Phi^{{\mathbb{B}}_{\gamma}}</annotation></semantics></math> is then the identity map on the chain group <math id="S28.SS2.p4.m15" class="ltx_Math" alttext="CF_{\gamma}(H)" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mi>γ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF_{\gamma}(H)</annotation></semantics></math>. Hence after tensoring with <math id="S28.SS2.p4.m16" class="ltx_Math" alttext="\Lambda_{{\bf K}}^{\Gamma}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><mi>𝐊</mi><mi mathvariant="normal">Γ</mi></msubsup><annotation encoding="application/x-tex">\Lambda_{{\bf K}}^{\Gamma}</annotation></semantics></math>, the chain map is a filtered isomorphism.
∎</span></p>
</div>
</div>
<div id="S28.SS2.p5" class="ltx_para ltx_noindent">
<p id="S28.SS2.p5.1" class="ltx_p">Therefore, if we switch to field coefficients, for each field <math id="S28.SS2.p5.m1" class="ltx_Math" alttext="{\bf K}" display="inline" intent=":literal"><semantics><mi>𝐊</mi><annotation encoding="application/x-tex">{\bf K}</annotation></semantics></math>, we obtain a well-defined verbose barcode <math id="S28.SS2.p5.m2" class="ltx_Math" alttext="{\mathcal{B}}_{\gamma}(H)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>γ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{B}}_{\gamma}(H)</annotation></semantics></math>. It still depends on the concrete choice of the loop <math id="S28.SS2.p5.m3" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>. We shorten the notation for the chain complex by</p>
<table id="S28.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S28.Ex7.m1" class="ltx_Math" alttext="CF_{\gamma}(H;\Lambda_{\bf K}^{\Gamma})." display="block" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mi>γ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><msubsup><mi mathvariant="normal">Λ</mi><mi>𝐊</mi><mi mathvariant="normal">Γ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">CF_{\gamma}(H;\Lambda_{\bf K}^{\Gamma}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S28.Thmthm1" class="ltx_theorem ltx_theorem_cor">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S28.Thmthm1.2" class="ltx_text ltx_font_bold">Corollary 28.1</span></span><span id="S28.Thmthm1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S28.Thmthm1.p1" class="ltx_para">
<p id="S28.Thmthm1.p1.1" class="ltx_p"><span id="S28.Thmthm1.p1.1.1" class="ltx_text ltx_font_italic">For two homologous loops <math id="S28.Thmthm1.p1.m1" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> and <math id="S28.Thmthm1.p1.m2" class="ltx_Math" alttext="\gamma^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>γ</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\gamma^{\prime}</annotation></semantics></math>, the bar-length spectrum of <math id="S28.Thmthm1.p1.m3" class="ltx_Math" alttext="CF_{\gamma}(H;\Lambda_{\bf K}^{\Gamma})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mi>γ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><msubsup><mi mathvariant="normal">Λ</mi><mi>𝐊</mi><mi mathvariant="normal">Γ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF_{\gamma}(H;\Lambda_{\bf K}^{\Gamma})</annotation></semantics></math> coincides with that of <math id="S28.Thmthm1.p1.m4" class="ltx_Math" alttext="CF_{\gamma^{\prime}}(H;\Lambda_{\bf K}^{\Gamma})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msup><mi>γ</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><msubsup><mi mathvariant="normal">Λ</mi><mi>𝐊</mi><mi mathvariant="normal">Γ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF_{\gamma^{\prime}}(H;\Lambda_{\bf K}^{\Gamma})</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S28.SS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S28.SS2.p6" class="ltx_para">
<p id="S28.SS2.p6.1" class="ltx_p"><span id="S28.SS2.p6.1.1" class="ltx_text">Let <math id="S28.SS2.p6.m1" class="ltx_Math" alttext="\gamma^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>γ</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\gamma^{\prime}</annotation></semantics></math> be another loop which is homologous to <math id="S28.SS2.p6.m2" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>. Choosing a concrete cobordism between them. Then one obtains a <math id="S28.SS2.p6.m3" class="ltx_Math" alttext="\Gamma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Γ</mi><annotation encoding="application/x-tex">\Gamma</annotation></semantics></math>-equivariant isomorphism of flow categories <math id="S28.SS2.p6.m4" class="ltx_Math" alttext="{\mathbb{F}}_{\gamma}\cong{\mathbb{F}}_{\gamma^{\prime}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔽</mi><mi>γ</mi></msub><mo>≅</mo><msub><mi>𝔽</mi><msup><mi>γ</mi><mo>′</mo></msup></msub></mrow><annotation encoding="application/x-tex">{\mathbb{F}}_{\gamma}\cong{\mathbb{F}}_{\gamma^{\prime}}</annotation></semantics></math> which shifts the action by a constant. An AMS construction and FOP perturbation for <math id="S28.SS2.p6.m5" class="ltx_Math" alttext="{\mathbb{F}}_{\gamma}" display="inline" intent=":literal"><semantics><msub><mi>𝔽</mi><mi>γ</mi></msub><annotation encoding="application/x-tex">{\mathbb{F}}_{\gamma}</annotation></semantics></math> can be transported to <math id="S28.SS2.p6.m6" class="ltx_Math" alttext="{\mathbb{F}}_{\gamma^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>𝔽</mi><msup><mi>γ</mi><mo>′</mo></msup></msub><annotation encoding="application/x-tex">{\mathbb{F}}_{\gamma^{\prime}}</annotation></semantics></math>. Hence the bar-length spectrum does not depend on the representating loop <math id="S28.SS2.p6.m7" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S28.Thmthm2" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S28.Thmthm2.2" class="ltx_text ltx_font_italic">Remark 28.2</span></span><span id="S28.Thmthm2.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S28.Thmthm2.p1" class="ltx_para">
<p id="S28.Thmthm2.p1.1" class="ltx_p">It is standard to argue that the barcode <math id="S28.Thmthm2.p1.m1" class="ltx_Math" alttext="{\mathcal{B}}_{\gamma}(H)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>γ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{B}}_{\gamma}(H)</annotation></semantics></math> varies Lipschitz continuously with <math id="S28.Thmthm2.p1.m2" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>, where on barcodes we use the bottleneck distance. Hence the barcode <math id="S28.Thmthm2.p1.m3" class="ltx_Math" alttext="{\mathcal{B}}_{\gamma}(H)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>γ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{B}}_{\gamma}(H)</annotation></semantics></math> also extends to degenerate Hamiltonians.</p>
</div>
</div>
</section>
<section id="S28.SS3" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">28.3. </span>Equivariant Floer complex</h4>

<div id="S28.SS3.p1" class="ltx_para ltx_noindent">
<p id="S28.SS3.p1.1" class="ltx_p">Now we can repeat the equivariant Floer construction to the noncontractible case. Let <math id="S28.SS3.p1.m1" class="ltx_Math" alttext="{\sf p}" display="inline" intent=":literal"><semantics><mi>𝗉</mi><annotation encoding="application/x-tex">{\sf p}</annotation></semantics></math> be a prime and suppose <math id="S28.SS3.p1.m2" class="ltx_Math" alttext="H^{\natural{\sf p}}" display="inline" intent=":literal"><semantics><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><annotation encoding="application/x-tex">H^{\natural{\sf p}}</annotation></semantics></math> is nondegenerate, which may have noncontractible orbits homologous to <math id="S28.SS3.p1.m3" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>. By coupling with the Morse flow category <math id="S28.SS3.p1.m4" class="ltx_Math" alttext="{{\mathbb{E}}}" display="inline" intent=":literal"><semantics><mi>𝔼</mi><annotation encoding="application/x-tex">{{\mathbb{E}}}</annotation></semantics></math> on <math id="S28.SS3.p1.m5" class="ltx_Math" alttext="\widehat{S}^{\infty}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>S</mi><mo>^</mo></mover><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">\widehat{S}^{\infty}</annotation></semantics></math>, one obtains a flow category (see Definition <a href="#S25.Thmthm1" title="Definition 25.1. ‣ 25.1.1. Coupling of Floer and Morse flow categories ‣ 25.1. Equivariant Floer flow category as a coupling ‣ 25. The Equivariant Floer theory for iterations—Proof of Theorem ‣ Part IV EQUIVARIANT FLOER THEORY AND STEENROD OPERATIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">25.1</span></a>)</p>
<table id="S28.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S28.Ex8.m1" class="ltx_Math" alttext="{\mathbb{F}}_{\gamma}^{{{\mathbb{Z}}_{\sf p}}}" display="block" intent=":literal"><semantics><msubsup><mi>𝔽</mi><mi>γ</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msubsup><annotation encoding="application/x-tex">{\mathbb{F}}_{\gamma}^{{{\mathbb{Z}}_{\sf p}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S28.SS3.p1.2" class="ltx_p">which has a free action by the twisted Novikov group <math id="S28.SS3.p1.m6" class="ltx_Math" alttext="(\Gamma\times{\mathbb{Z}})\rtimes{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Γ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>ℤ</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋊</mo><msub><mi>ℤ</mi><mi>𝗉</mi></msub></mrow><annotation encoding="application/x-tex">(\Gamma\times{\mathbb{Z}})\rtimes{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>. Notice that although the reference loop <math id="S28.SS3.p1.m7" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> is not invariant under the <math id="S28.SS3.p1.m8" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-action via loop rotation, the symplectic action is still well-defined.</p>
</div>
<div id="S28.SS3.p2" class="ltx_para ltx_noindent">
<p id="S28.SS3.p2.1" class="ltx_p">Using exactly the same construction as the contractible case, one can construct an equivariant lift of the outercollaring of <math id="S28.SS3.p2.m1" class="ltx_Math" alttext="{\mathbb{F}}_{\gamma}^{{{\mathbb{Z}}_{\sf p}}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔽</mi><mi>γ</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msubsup><annotation encoding="application/x-tex">{\mathbb{F}}_{\gamma}^{{{\mathbb{Z}}_{\sf p}}}</annotation></semantics></math> to <math id="S28.SS3.p2.m2" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>NC</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}</annotation></semantics></math>. After choose an equivariant FOP perturbation, denoted by <math id="S28.SS3.p2.m3" class="ltx_Math" alttext="\mathring{\mathbb{F}}_{\gamma}^{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><mi>γ</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msubsup><annotation encoding="application/x-tex">\mathring{\mathbb{F}}_{\gamma}^{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>, one obtains a complex with a <math id="S28.SS3.p2.m4" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-action, denoted by</p>
<table id="S28.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S28.Ex9.m1" class="ltx_Math" alttext="C(\mathring{\mathbb{F}}_{\gamma}^{{\mathbb{Z}}_{\sf p}})." display="block" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><mi>γ</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">C(\mathring{\mathbb{F}}_{\gamma}^{{\mathbb{Z}}_{\sf p}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S28.SS3.p2.2" class="ltx_p">Its <math id="S28.SS3.p2.m5" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-invariant part provides a complex</p>
<table id="S28.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S28.Ex10.m1" class="ltx_Math" alttext="CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}},\gamma)" display="block" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo>,</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}},\gamma)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S28.SS3.p2.3" class="ltx_p">which is a module over <math id="S28.SS3.p2.m6" class="ltx_Math" alttext="\Lambda_{{\bf F}_{\sf p}}^{\Gamma\oplus{\mathbb{Z}}}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐅</mi><mi>𝗉</mi></msub><mrow><mi mathvariant="normal">Γ</mi><mo>⊕</mo><mi>ℤ</mi></mrow></msubsup><annotation encoding="application/x-tex">\Lambda_{{\bf F}_{\sf p}}^{\Gamma\oplus{\mathbb{Z}}}</annotation></semantics></math>. By tensoring with the larger Novikov field <math id="S28.SS3.p2.m7" class="ltx_Math" alttext="\Lambda_{{\bf K}_{\sf p}}^{\Gamma}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Γ</mi></msubsup><annotation encoding="application/x-tex">\Lambda_{{\bf K}_{\sf p}}^{\Gamma}</annotation></semantics></math> one obtains a Floer-type complex</p>
<table id="S28.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S28.Ex11.m1" class="ltx_Math" alttext="CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}},\gamma;\Lambda_{{\bf K}_{\sf p}}^{\Gamma})." display="block" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo>,</mo><mi>γ</mi><mo>,</mo><msubsup><mi mathvariant="normal">Λ</mi><msub><mi>𝐊</mi><mi>𝗉</mi></msub><mi mathvariant="normal">Γ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}},\gamma;\Lambda_{{\bf K}_{\sf p}}^{\Gamma}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S28.SS3.p2.4" class="ltx_p">By using the equivariant continuation map, one proves that the filtered isomorphism class is well-defined. Hence one obtains a barcode</p>
<table id="S28.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S28.Ex12.m1" class="ltx_Math" alttext="{\mathcal{B}}_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}},\gamma)" display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo>,</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{B}}_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}},\gamma)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S28.SS3.p2.5" class="ltx_p">which only depends on <math id="S28.SS3.p2.m8" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>. Again, choosing a homologous loop <math id="S28.SS3.p2.m9" class="ltx_Math" alttext="\gamma^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>γ</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\gamma^{\prime}</annotation></semantics></math> will shift the barcodes but does not change the bar-length spectrum.</p>
</div>
</section>
<section id="S28.SS4" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">28.4. </span>Equivariant pair-of-pants product</h4>

<div id="S28.SS4.p1" class="ltx_para ltx_noindent">
<p id="S28.SS4.p1.1" class="ltx_p">One can construct the noncontractible version of the equivariant pair-of-pants product. Let <math id="S28.SS4.p1.m1" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> be a Hamiltonian such that <math id="S28.SS4.p1.m2" class="ltx_Math" alttext="H^{\natural{\sf p}}" display="inline" intent=":literal"><semantics><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><annotation encoding="application/x-tex">H^{\natural{\sf p}}</annotation></semantics></math> is nondegenerate. Let <math id="S28.SS4.p1.m3" class="ltx_Math" alttext="\gamma^{({\sf p})}" display="inline" intent=":literal"><semantics><msup><mi>γ</mi><mrow><mo stretchy="false">(</mo><mi>𝗉</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\gamma^{({\sf p})}</annotation></semantics></math> be the <math id="S28.SS4.p1.m4" class="ltx_Math" alttext="{\sf p}" display="inline" intent=":literal"><semantics><mi>𝗉</mi><annotation encoding="application/x-tex">{\sf p}</annotation></semantics></math>-th iteration of <math id="S28.SS4.p1.m5" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>. Basically, the same setup as the contractible case provides a multimodule</p>
<table id="S28.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S28.Ex13.m1" class="ltx_Math" alttext="{\mathbb{X}}_{\gamma}^{\mathbb{FSt}}" display="block" intent=":literal"><semantics><msubsup><mi>𝕏</mi><mi>γ</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msubsup><annotation encoding="application/x-tex">{\mathbb{X}}_{\gamma}^{\mathbb{FSt}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S28.SS4.p1.2" class="ltx_p">over <math id="S28.SS4.p1.m6" class="ltx_Math" alttext="({\mathbb{F}}_{\gamma},\ldots,{\mathbb{F}}_{\gamma},{\mathbb{E}};{\mathbb{F}}_{\gamma^{({\sf p})}}^{{{\mathbb{Z}}_{\sf p}}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>γ</mi></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔽</mi><mi>γ</mi></msub><mo>,</mo><mi>𝔼</mi><mo>,</mo><msubsup><mi>𝔽</mi><msup><mi>γ</mi><mrow><mo stretchy="false">(</mo><mi>𝗉</mi><mo stretchy="false">)</mo></mrow></msup><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{\gamma},\ldots,{\mathbb{F}}_{\gamma},{\mathbb{E}};{\mathbb{F}}_{\gamma^{({\sf p})}}^{{{\mathbb{Z}}_{\sf p}}})</annotation></semantics></math>. More precisely, let <math id="S28.SS4.p1.m7" class="ltx_Math" alttext="x_{1},\ldots,x_{\sf p}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mi>𝗉</mi></msub></mrow><annotation encoding="application/x-tex">x_{1},\ldots,x_{\sf p}</annotation></semantics></math> be objects of <math id="S28.SS4.p1.m8" class="ltx_Math" alttext="{\mathbb{F}}_{\gamma}" display="inline" intent=":literal"><semantics><msub><mi>𝔽</mi><mi>γ</mi></msub><annotation encoding="application/x-tex">{\mathbb{F}}_{\gamma}</annotation></semantics></math> whose underlying loops <math id="S28.SS4.p1.m9" class="ltx_Math" alttext="\underline{\smash{x}}_{1},\ldots,\underline{\smash{x}}_{\sf p}" display="inline" intent=":literal"><semantics><mrow><msub><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mi>𝗉</mi></msub></mrow><annotation encoding="application/x-tex">\underline{\smash{x}}_{1},\ldots,\underline{\smash{x}}_{\sf p}</annotation></semantics></math> are homologous to <math id="S28.SS4.p1.m10" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>. Let <math id="S28.SS4.p1.m11" class="ltx_Math" alttext="\underline{\smash{x}}^{\prime}" display="inline" intent=":literal"><semantics><msup><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo>′</mo></msup><annotation encoding="application/x-tex">\underline{\smash{x}}^{\prime}</annotation></semantics></math> be a Hamiltonian loop of <math id="S28.SS4.p1.m12" class="ltx_Math" alttext="H^{\natural{\sf p}}" display="inline" intent=":literal"><semantics><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><annotation encoding="application/x-tex">H^{\natural{\sf p}}</annotation></semantics></math> homologous to <math id="S28.SS4.p1.m13" class="ltx_Math" alttext="\gamma^{({\sf p})}" display="inline" intent=":literal"><semantics><msup><mi>γ</mi><mrow><mo stretchy="false">(</mo><mi>𝗉</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\gamma^{({\sf p})}</annotation></semantics></math>. Consider <math id="S28.SS4.p1.m14" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>-legged pair-of-pants forming a cobordism (up to equality of symplectic area) between <math id="S28.SS4.p1.m15" class="ltx_Math" alttext="\underline{\smash{x}}_{1}\sqcup\cdots\sqcup\underline{\smash{x}}_{\sf p}" display="inline" intent=":literal"><semantics><mrow><msub><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mn>1</mn></msub><mo>⊔</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>⊔</mo><msub><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mi>𝗉</mi></msub></mrow><annotation encoding="application/x-tex">\underline{\smash{x}}_{1}\sqcup\cdots\sqcup\underline{\smash{x}}_{\sf p}</annotation></semantics></math> represented by a map <math id="S28.SS4.p1.m16" class="ltx_Math" alttext="u:\Sigma^{\mathbb{FSt}}\to X" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi mathvariant="normal">Σ</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕊</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕥</mi></mrow></msup><mo stretchy="false">→</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">u:\Sigma^{\mathbb{FSt}}\to X</annotation></semantics></math>. Then the <math id="S28.SS4.p1.m17" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>-cappings <math id="S28.SS4.p1.m18" class="ltx_Math" alttext="x_{1},\ldots,x_{\sf p}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mi>𝗉</mi></msub></mrow><annotation encoding="application/x-tex">x_{1},\ldots,x_{\sf p}</annotation></semantics></math> together with the relative homology class of <math id="S28.SS4.p1.m19" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> induces a <math id="S28.SS4.p1.m20" class="ltx_Math" alttext="\gamma^{({\sf p})}" display="inline" intent=":literal"><semantics><msup><mi>γ</mi><mrow><mo stretchy="false">(</mo><mi>𝗉</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\gamma^{({\sf p})}</annotation></semantics></math>-capping of <math id="S28.SS4.p1.m21" class="ltx_Math" alttext="\underline{\smash{x}}^{\prime}" display="inline" intent=":literal"><semantics><msup><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo>′</mo></msup><annotation encoding="application/x-tex">\underline{\smash{x}}^{\prime}</annotation></semantics></math> as illustrated in Figure <a href="#S28.F11" title="Figure 11 ‣ 28.4. Equivariant pair-of-pants product ‣ 28. Quantitative Theory for Noncontractible Hamiltonian Orbits ‣ Part IV EQUIVARIANT FLOER THEORY AND STEENROD OPERATIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>.</p>
</div>
<figure id="S28.F11" class="ltx_figure"><object type="image/svg+xml" data="2606.15847v1/Noncontractible_Steenrod.svg" id="S28.F11.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:579/283;" width="579" height="283"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 11. </span>Configurations of equivariant pair-of-pants product for noncontractible orbits</figcaption>
</figure>
<div id="S28.SS4.p2" class="ltx_para ltx_noindent">
<p id="S28.SS4.p2.1" class="ltx_p">The AMS construction and FOP perturbation provide a chain map</p>
<table id="S28.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S28.Ex14.m1" class="ltx_Math" alttext="\underbrace{CF_{\gamma}(H)\otimes\cdots\otimes\cdots CF_{\gamma}(H)}_{{\sf p}}\otimes CM(f^{{\mathbb{E}}})\to C(\mathring{\mathbb{F}}_{\gamma^{({\sf p})}}^{{\mathbb{Z}}_{\sf p}})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munder><munder accentunder="true"><mrow><mi>C</mi><mi>F</mi><msub><mrow></mrow><mi>γ</mi></msub><mo stretchy="false">(</mo><mi>H</mi><mo rspace="0.055em" stretchy="false">)</mo><mo>⊗</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo>⊗</mo><mo lspace="0.055em" rspace="0em">⋯</mo><mi>C</mi><mi>F</mi><msub><mrow></mrow><mi>γ</mi></msub><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mo stretchy="true">⏟</mo></munder><mi>𝗉</mi></munder><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mi>𝔼</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><msup><mi>γ</mi><mrow><mo stretchy="false">(</mo><mi>𝗉</mi><mo stretchy="false">)</mo></mrow></msup><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\underbrace{CF_{\gamma}(H)\otimes\cdots\otimes\cdots CF_{\gamma}(H)}_{{\sf p}}\otimes CM(f^{{\mathbb{E}}})\to C(\mathring{\mathbb{F}}_{\gamma^{({\sf p})}}^{{\mathbb{Z}}_{\sf p}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S28.SS4.p2.2" class="ltx_p">Restricting to the <math id="S28.SS4.p2.m1" class="ltx_Math" alttext="{{\mathbb{Z}}_{\sf p}}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mi>𝗉</mi></msub><annotation encoding="application/x-tex">{{\mathbb{Z}}_{\sf p}}</annotation></semantics></math>-invariant part one obtains</p>
<table id="S28.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S28.Ex15.m1" class="ltx_Math" alttext="P_{\gamma}:C_{{{\mathbb{Z}}_{\sf p}}}(CF_{\gamma}(H)^{\otimes{\sf p}})\to CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}},\gamma^{({\sf p})})." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mi>γ</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mi>γ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo>,</mo><msup><mi>γ</mi><mrow><mo stretchy="false">(</mo><mi>𝗉</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P_{\gamma}:C_{{{\mathbb{Z}}_{\sf p}}}(CF_{\gamma}(H)^{\otimes{\sf p}})\to CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}},\gamma^{({\sf p})}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S28.Thmthm3" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S28.Thmthm3.2" class="ltx_text ltx_font_bold">Proposition 28.3</span></span><span id="S28.Thmthm3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S28.Thmthm3.p1" class="ltx_para">
<p id="S28.Thmthm3.p1.1" class="ltx_p"><math id="S28.Thmthm3.p1.m1" class="ltx_Math" alttext="P_{\gamma}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>γ</mi></msub><annotation encoding="application/x-tex">P_{\gamma}</annotation></semantics></math><span id="S28.Thmthm3.p1.1.1" class="ltx_text ltx_font_italic"> is a filtered chain homotopy equivalence of Floer-type complexes.</span></p>
</div>
</div>
<div id="S28.SS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S28.SS4.p3" class="ltx_para ltx_noindent">
<p id="S28.SS4.p3.1" class="ltx_p"><span id="S28.SS4.p3.1.1" class="ltx_text">The argument is similar to the contractible case. One can first define the reduced versions</span></p>
<table id="S28.EGx90" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S28.Ex16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S28.Ex16.m1" class="ltx_Math" alttext="\displaystyle\ C_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(CF_{\gamma}(H)^{\otimes{\sf p}}),\ " display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mi>red</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mi>γ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ C_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(CF_{\gamma}(H)^{\otimes{\sf p}}),\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S28.Ex16.m2" class="ltx_Math" alttext="\displaystyle\ CF_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(H^{\natural{\sf p}},\gamma^{({\sf p})})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>F</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mi>red</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo>,</mo><msup><mi>γ</mi><mrow><mo stretchy="false">(</mo><mi>𝗉</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ CF_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(H^{\natural{\sf p}},\gamma^{({\sf p})})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S28.SS4.p3.2" class="ltx_p"><span id="S28.SS4.p3.2.1" class="ltx_text">(see (<a href="#S27.E1" title="In 27.1.1. Homological perturbation ‣ 27.1. Filtration on the 𝗉-fold tensor product ‣ 27. Quantitative Results about Equivariant Floer Theory ‣ Part IV EQUIVARIANT FLOER THEORY AND STEENROD OPERATIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27.1</span></a>) and Lemma <a href="#S27.Thmthm7" title="Lemma 27.7. ‣ 27.3.1. Local equivariant Floer theory ‣ 27.3. Local equivariant cohomology and homological perturbation ‣ 27. Quantitative Results about Equivariant Floer Theory ‣ Part IV EQUIVARIANT FLOER THEORY AND STEENROD OPERATIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27.7</span></a>) which are filtered chain homotopy equivalent to the unreduced versions via the homological perturbation construction. Moreover, for each orbit <math id="S28.SS4.p3.m1" class="ltx_Math" alttext="x\in\tilde{\mathcal{O}}_{\gamma}(H)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>~</mo></mover><mi>γ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x\in\tilde{\mathcal{O}}_{\gamma}(H)</annotation></semantics></math>, one has a local equivariant pair-of-pants product <math id="S28.SS4.p3.m2" class="ltx_Math" alttext="P_{x}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>x</mi></msub><annotation encoding="application/x-tex">P_{x}</annotation></semantics></math> which can be proved to be invertible. Moreover, the direct sum of <math id="S28.SS4.p3.m3" class="ltx_Math" alttext="P_{x}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>x</mi></msub><annotation encoding="application/x-tex">P_{x}</annotation></semantics></math> is the leading order term of <math id="S28.SS4.p3.m4" class="ltx_Math" alttext="P_{\gamma}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>γ</mi></msub><annotation encoding="application/x-tex">P_{\gamma}</annotation></semantics></math>. Then <math id="S28.SS4.p3.m5" class="ltx_Math" alttext="P_{\gamma}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>γ</mi></msub><annotation encoding="application/x-tex">P_{\gamma}</annotation></semantics></math> is transferred to a filtered isomorphism</span></p>
<table id="S28.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S28.Ex17.m1" class="ltx_Math" alttext="P_{\gamma}^{\rm red}:C_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(CF_{\gamma}(H)^{\otimes{\sf p}})\to CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}},\gamma^{({\sf p})}).\qed" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>P</mi><mi>γ</mi><mi>red</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mi>C</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub><mi>red</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mi>γ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝗉</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><msub><mi>ℤ</mi><mi>𝗉</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mrow><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝗉</mi></mrow></msup><mo>,</mo><msup><mi>γ</mi><mrow><mo stretchy="false">(</mo><mi>𝗉</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em" rspace="0.0835em">.</mo><mo class="ltx_mathvariant_italic" lspace="0.0835em" mathvariant="italic" separator="true">∎</mo></mrow><annotation encoding="application/x-tex">P_{\gamma}^{\rm red}:C_{{{\mathbb{Z}}_{\sf p}}}^{\rm red}(CF_{\gamma}(H)^{\otimes{\sf p}})\to CF_{{{\mathbb{Z}}_{\sf p}}}(H^{\natural{\sf p}},\gamma^{({\sf p})}).\qed</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S28.SS4.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Theorem <a href="#S1.Thmthm12" title="Theorem 1.12. ‣ 1.3.4. Quantitative Hamiltonian Floer theory for noncontractible orbits ‣ 1.3. Main results on quantitative Floer theory ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.12</span></a>.</h6>
<div id="S28.SS4.p4" class="ltx_para">
<p id="S28.SS4.p4.1" class="ltx_p"><span id="S28.SS4.p4.1.1" class="ltx_text">The isomorphism class of the Floer-type complex is disucssed in Section <a href="#S28.SS3" title="28.3. Equivariant Floer complex ‣ 28. Quantitative Theory for Noncontractible Hamiltonian Orbits ‣ Part IV EQUIVARIANT FLOER THEORY AND STEENROD OPERATIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">28.3</span></a>. Proposition <a href="#S28.Thmthm3" title="Proposition 28.3. ‣ 28.4. Equivariant pair-of-pants product ‣ 28. Quantitative Theory for Noncontractible Hamiltonian Orbits ‣ Part IV EQUIVARIANT FLOER THEORY AND STEENROD OPERATIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">28.3</span></a> shows Theorem <a href="#S1.Thmthm12" title="Theorem 1.12. ‣ 1.3.4. Quantitative Hamiltonian Floer theory for noncontractible orbits ‣ 1.3. Main results on quantitative Floer theory ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.12</span></a> (2) holds. Finally, Theorem <a href="#S1.Thmthm12" title="Theorem 1.12. ‣ 1.3.4. Quantitative Hamiltonian Floer theory for noncontractible orbits ‣ 1.3. Main results on quantitative Floer theory ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.12</span></a> (3) follows from the same argument as in Section <a href="#S27.SS5" title="27.5. Proof of Theorem ‣ 27. Quantitative Results about Equivariant Floer Theory ‣ Part IV EQUIVARIANT FLOER THEORY AND STEENROD OPERATIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27.5</span></a> with the above ingredients.
∎</span></p>
</div>
</div>
</section>
