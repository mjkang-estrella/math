 style="--ltx-stroke-color:#000000;" d="M 48.752496132666565 -46.201003641941675 L 203.27945855440103 -45.64753208184153" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 203.27945855440103 -46.201003641941675 L 203.27945855440103 -45.64753208184153" fill="none" stroke="#000000"></path><g transform="translate(203.28,0) translate(0,-45.92) translate(4.15,0) translate(0,-3.54)"><foreignObject style="--ltx-fo-width:6.44em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.66em;font-size:10pt;" height="20.82" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="89.07"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S14.Ex69.m1.pic1.m10" class="ltx_math_unparsed" alttext="\textstyle{\partial^{d_{1},d_{2}}{}_{\lfloor}B_{d}\times P_{d}}" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><msup><mrow></mrow><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub></mrow></msup><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>B</mi><msub><mrow></mrow><mi>d</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>P</mi><msub><mrow></mrow><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\textstyle{\partial^{d_{1},d_{2}}{}_{\lfloor}B_{d}\times P_{d}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
