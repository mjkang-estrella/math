x">\textstyle{{\mathbb{M}}_{ap;\rho(a)p^{\prime}}^{{\mathbb{B}}_{0}}\sqcup{\mathbb{M}}_{ap;\rho(a)p^{\prime}}^{{\mathbb{B}}_{1}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 66.81584513532154 -45.817433113508805 L 66.81584513532154 -45.263961553408656" fill="none" stroke="#000000"></path><g transform="translate(141.54,0) translate(0,-45.54)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 66.81584513532154 -45.817433113508805 L 141.53564588251953 -45.263961553408656" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 141.53564588251953 -45.817433113508805 L 141.53564588251953 -45.263961553408656" fill="none" stroke="#000000"></path><g transform="translate(141.54,0) translate(0,-45.54) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:4.36em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.41em;font-size:10pt;" height="17.32" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="60.3"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S7.Ex101.m1.pic1.m8" class="ltx_Math" alttext="\textstyle{M_{ap;\rho(a)p^{\prime}}^{\mathbb{H}}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>;</mo><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></mrow><mi>ℍ</mi></msubsup><annotation encoding="application/x-tex">\textstyle{M_{ap;\rho(a)p^{\prime}}^{\mathbb{H}}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="S7.Ex102" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
