><path style="--ltx-stroke-color:#000000;" d="M 120.46684116285932 -12.746990114652519 L 120.46684116285932 -12.746990114652519" fill="none" stroke="#000000"></path><g transform="translate(20.71,0) translate(0,-30.2) translate(4.15,0) translate(0,-3.08)"><foreignObject style="--ltx-fo-width:4.02em;--ltx-fo-height:0.72em;--ltx-fo-depth:0.28em;font-size:10pt;" height="13.87" overflow="visible" transform="matrix(1 0 0 -1 0 10.02)" width="55.65"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex39.m1.pic1.m3" class="ltx_Math" alttext="\scriptstyle{{\rm Id}\times\iota_{p^{\prime}q^{\prime};p^{\prime\prime}}^{{\mathbb{B}}^{\prime}}}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.700em">Id</mi><mo lspace="0.222em" mathsize="0.700em" rspace="0.222em">×</mo><msubsup><mi mathsize="0.700em">ι</mi><mrow><mrow><msup><mi mathsize="0.710em">p</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.710em">q</mi><mo>′</mo></msup></mrow><mo mathsize="0.710em">;</mo><msup><mi mathsize="0.710em">p</mi><mo>′′</mo></msup></mrow><msup><mi mathsize="0.710em">𝔹</mi><mo>′</mo></msup></msubsup></mrow><annotation encoding="application/x-tex">\scriptstyle{{\rm Id}\times\iota_{p^{\prime}q^{\prime};p^{\prime\prime}}^{{\mathbb{B}}^{\prime}}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(23.7,0) translate(0,-68.84)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 7.37 1.08" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 4.6 5.87" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 120.46684116285932 -12.746990114652519 L 23.696686166837466 -68.83905457480412" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 23.696686166837466 -68.83905457480412 L 23.696686166837466 -68.83905457480412" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 164.39661406309455 -12.746990114652519 L 164.4932298355451 -12.820676532015359" fill="none" stroke="#000000"></path><g transform="translate(201.55,0) translate(0,-30.77) translate(4.15,0) translate(0,-2.51)"><foreignObject style="--ltx-fo-width:3.53em;--ltx-fo-height:0.64em;--ltx-fo-depth:0.28em;font-size:10pt;" height="12.73" overflow="visible" transform="matrix(1 0 0 -1 0 8.88)" width="48.86"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex39.m1.pic1.m4" class="ltx_Math" alttext="\scriptstyle{\iota_{p;p^{\prime}q^{\prime}}^{\mathbb{B}}\times{\rm Id}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathsize="0.700em">ι</mi><mrow><mi mathsize="0.710em">p</mi><mo mathsize="0.710em">;</mo><mrow><msup><mi mathsize="0.710em">p</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.710em">q</mi><mo>′</mo></msup></mrow></mrow><mi mathsize="0.710em">𝔹</mi></msubsup><mo lspace="0.222em" mathsize="0.700em" rspace="0.222em">×</mo><mi mathsize="0.700em">Id</mi></mrow><annotation encoding="application/x-tex">\scriptstyle{\iota_{p;p^{\prime}q^{\prime}}^{\mathbb{B}}\times{\rm Id}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(261.01,0) translate(0,-68.84)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -4.59 5.87" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -7.37 1.08" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 164.39661406309455 -12.746990114652519 L 261.0110141304959 -68.83905457480412" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 260.914419471632 -68.76718392589206 L 261.0110141304959 -68.83905457480412" fill="none" stroke="#000000"></path><g transform="translate(-43.82,0) translate(0,-82.57) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:5.73em;--ltx-fo-height:0.94em;--ltx-fo-depth:0.37em;font-size:10pt;" height="18.18" overflow="visible" transform="matrix(1 0 0 -1 0 13.04)" width="79.34"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex39.m1.pic1.m8" class="ltx_Math" alttext="\textstyle{A_{p;p^{\prime}}^{{\mathbb{B}}}\times A_{p^{\prime};p^{\prime\prime}}^{{\mathbb{B}}^{\prime}}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>A</mi><mrow><mi>p</mi><mo>;</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mi>𝔹</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>A</mi><mrow><msup><mi>p</mi><mo>′</mo></msup><mo>;</mo><msup><mi>p</mi><mo>′′</mo></msup></mrow><msup><mi>𝔹</mi><mo>′</mo></msup></msubsup></mrow><annotation encoding="application/x-tex">\textstyle{A_{p;p^{\prime}}^{{\mathbb{B}}}\times A_{p^{\prime};p^{\prime\prime}}^{{\mathbb{B}}^{\prime}}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(241.11,0) translate(0,-82.57) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:5.69em;--ltx-fo-height:0.94em;--ltx-fo-depth:0.37em;font-size:10pt;" height="18.18" overflow="visible" transform="matrix(1 0 0 -1 0 13.04)" width="78.77"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex39.m1.pic1.m10" class="ltx_Math" alttext="\textstyle{A_{p;q^{\prime}}^{{\mathbb{B}}}\times A_{q^{\prime};p^{\prime\prime}}^{{\mathbb{B}}^{\prime}}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>A</mi><mrow><mi>p</mi><mo>;</mo><msup><mi>q</mi><mo>′</mo></msup></mrow><mi>𝔹</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>A</mi><mrow><msup><mi>q</mi><mo>′</mo></msup><mo>;</mo><msup><mi>p</mi><mo>′′</mo></msup></mrow><msup><mi>𝔹</mi><mo>′</mo></msup></msubsup></mrow><annotation encoding="application/x-tex">\textstyle{A_{p;q^{\prime}}^{{\mathbb{B}}}\times A_{q^{\prime};p^{\prime\prime}}^{{\mathbb{B}}^{\prime}}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
