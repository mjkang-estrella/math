cs></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 264.2534065167406 -13.400455621065102 L 264.80687807684075 -13.400455621065102" fill="none" stroke="#000000"></path><g transform="translate(264.53,0) translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 264.2534065167406 -33.208800332088 L 264.80687807684075 -13.400455621065102" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 264.2534065167406 -33.208800332088 L 264.80687807684075 -33.208800332088" fill="none" stroke="#000000"></path><g transform="translate(-90.04,0) translate(0,-45.54) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:12.41em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.43em;font-size:10pt;" height="17.62" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="171.78"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex28.m1.pic1.m3" class="ltx_math_unparsed" alttext="\textstyle{M_{p_{j}q_{j}}^{{\mathbb{F}}_{j}}\times M_{p_{1}\cdots p_{j-1}q_{j}p_{j+1}\cdots p_{m};p^{\prime}}^{\mathbb{H}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><msub><mi>p</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>j</mi></msub></mrow></msub><msup><mrow></mrow><msub><mi>𝔽</mi><mi>j</mi></msub></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mi>q</mi><msub><mrow></mrow><mi>j</mi></msub><mi>p</mi><msub><mrow></mrow><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>ℍ</mi></msup></mrow><annotation encoding="application/x-tex">\textstyle{M_{p_{j}q_{j}}^{{\mathbb{F}}_{j}}\times M_{p_{1}\cdots p_{j-1}q_{j}p_{j+1}\cdots p_{m};p^{\prime}}^{\mathbb{H}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 90.04209947830185 -45.817433113508805 L 90.04209947830185 -45.263961553408656" fill="none" stroke="#000000"></path><g transform="translate(229.65,0) translate(0,-45.54)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 90.04209947830185 -45.817433113508805 L 229.64676006776887 -45.263961553408656" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 229.64676006776887 -45.817433113508805 L 229.64676006776887 -45.263961553408656" fill="none" stroke="#000000"></path><g transform="translate(229.65,0) translate(0,-45.54) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:4.44em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.38em;font-size:10pt;" height="16.83" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="61.47"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex28.m1.pic1.m4" class="ltx_math_unparsed" alttext="\textstyle{M_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{H}}}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>ℍ</mi></msup></mrow><annotation encoding="application/x-tex">\textstyle{M_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{H}}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
