ght:0.8em;--ltx-fo-depth:0.29em;font-size:10pt;" height="14.98" overflow="visible" transform="matrix(1 0 0 -1 0 11.02)" width="100.41"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S16.Ex57.m1.pic1.m6" class="ltx_Math" alttext="\textstyle{W_{ps}\oplus R_{s}^{+}\oplus W_{sq}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><mo>⊕</mo><msubsup><mi>R</mi><mi>s</mi><mo>+</mo></msubsup><mo>⊕</mo><msub><mi>W</mi><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\textstyle{W_{ps}\oplus R_{s}^{+}\oplus W_{sq}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 261.67488863512045 -11.569253138458645 L 262.2283601952206 -11.569253138458645" fill="none" stroke="#000000"></path><g transform="translate(261.95,0) translate(0,-22.46) translate(4.15,0) translate(0,-3.29)"><foreignObject style="--ltx-fo-width:1.66em;--ltx-fo-height:0.72em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.41" overflow="visible" transform="matrix(1 0 0 -1 0 9.99)" width="22.94"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S16.Ex57.m1.pic1.m7" class="ltx_Math" alttext="\scriptstyle{\widetilde{\iota}_{psq}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathsize="0.700em">ι</mi><mo>~</mo></mover><mrow><mi mathsize="0.710em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">q</mi></mrow></msub><annotation encoding="application/x-tex">\scriptstyle{\widetilde{\iota}_{psq}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(261.95,0) translate(0,-34.77)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 261.67488863512045 -34.77091015300695 L 262.2283601952206 -11.569253138458645" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 261.67488863512045 -34.77091015300695 L 262.2283601952206 -34.77091015300695" fill="none" stroke="#000000"></path><g transform="translate(-54.57,0) translate(0,-44.92) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:7.29em;--ltx-fo-height:0.8em;--ltx-fo-depth:0.29em;font-size:10pt;" height="14.98" overflow="visible" transform="matrix(1 0 0 -1 0 11.02)" width="100.83"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S16.Ex57.m1.pic1.m8" class="ltx_Math" alttext="\textstyle{W_{pr}\oplus R_{r}^{+}\oplus W_{rq}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo>⊕</mo><msubsup><mi>R</mi><mi>r</mi><mo>+</mo></msubsup><mo>⊕</mo><msub><mi>W</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\textstyle{W_{pr}\oplus R_{r}^{+}\oplus W_{rq}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 54.56681896150071 -45.19475121641285 L 54.56681896150071 -44.6412796563127" fill="none" stroke="#000000"></path><g transform="translate(133.74,0) translate(0,-55.78) translate(4.15,0) translate(0,-3.29)"><foreignObject style="--ltx-fo-width:1.68em;--ltx-fo-height:0.72em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.41" overflow="visible" transform="matrix(1 0 0 -1 0 9.99)" width="23.19"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S16.Ex57.m1.pic1.m9" class="ltx_Math" alttext="\scriptstyle{\widetilde{\iota}_{prq}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathsize="0.700em">ι</mi><mo>~</mo></mover><mrow><mi mathsize="0.710em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">q</mi></mrow></msub><annotation encoding="application/x-tex">\scriptstyle{\widetilde{\iota}_{prq}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(244.4,0) translate(0,-44.92)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 54.56681896150071 -45.19475121641285 L 244.39799962110402 -44.6412796563127" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 244.39799962110402 -45.19475121641285 L 244.39799962110402 -44.6412796563127" fill="none" stroke="#000000"></path><g transform="translate(244.4,0) translate(0,-44.92) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.94em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.29em;font-size:10pt;" height="13.41" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="26.81"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S16.Ex57.m1.pic1.m12" class="ltx_Math" alttext="\textstyle{W_{pq}}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\textstyle{W_{pq}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S16.I4.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(5)</span> 
<div id="S16.I4.i5.p1" class="ltx_para ltx_noindent">
<p id="S16.I4.i5.p1.1" class="ltx_p"><span id="S16.I4.i5.p1.1.1" class="ltx_text ltx_font_bold">(Transversality)</span> For each <math id="S16.I4.i5.p1.m1" class="ltx_Math" alttext="\widetilde{x}\in\widetilde{V}_{pq}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo>∈</mo><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\widetilde{x}\in\widetilde{V}_{pq}</annotation></semantics></math>, the image <math id="S16.I4.i5.p1.m2" class="ltx_Math" alttext="\widetilde{\nu}_{pq}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ν</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\widetilde{\nu}_{pq}</annotation></semantics></math> contained in <math id="S16.I4.i5.p1.m3" class="ltx_Math" alttext="\mathring{\mathcal{E}}_{\widetilde{x}}^{0}\subseteq{\mathcal{E}}_{\widetilde{x}}^{0}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>̊</mo></mover><mover accent="true"><mi>x</mi><mo>~</mo></mover><mn>0</mn></msubsup><mo>⊆</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mover accent="true"><mi>x</mi><mo>~</mo></mover><mn>0</mn></msubsup></mrow><annotation encoding="application/x-tex">\mathring{\mathcal{E}}_{\widetilde{x}}^{0}\subseteq{\mathcal{E}}_{\widetilde{x}}^{0}</annotation></semantics></math> is transverse to the image of <math id="S16.I4.i5.p1.m4" class="ltx_Math" alttext="D_{\widetilde{x}}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mover accent="true"><mi>x</mi><mo>~</mo></mover></msub><annotation encoding="application/x-tex">D_{\widetilde{x}}</annotation></semantics></math> (which is a condition true for all <math id="S16.I4.i5.p1.m5" class="ltx_Math" alttext="\tau&gt;2" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>&gt;</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\tau&gt;2</annotation></semantics></math>).</p>
</div></li>
<li id="S16.I4.i6" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(6)</span> 
<div id="S16.I4.i6.p1" class="ltx_para ltx_noindent">
<p id="S16.I4.i6.p1.1" class="ltx_p"><span id="S16.I4.i6.p1.1.1" class="ltx_text ltx_font_bold">(Collar)</span> The maps <math id="S16.I4.i6.p1.m1" class="ltx_Math" alttext="\widetilde{\nu}_{pq}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ν</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\widetilde{\nu}_{pq}</annotation></semantics></math> satisfy the natural collaring condition. Namely, near each stratum <math id="S16.I4.i6.p1.m2" class="ltx_Math" alttext="\partial^{\alpha}\widetilde{V}_{pq}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\partial^{\alpha}\widetilde{V}_{pq}</annotation></semantics></math>, <math id="S16.I4.i6.p1.m3" class="ltx_Math" alttext="\widetilde{\nu}_{pq}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ν</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\widetilde{\nu}_{pq}</annotation></semantics></math> is independent of the collar coordinates.</p>
</div></li>
<li id="S16.I4.i7" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(7)</span> 
<div id="S16.I4.i7.p1" class="ltx_para ltx_noindent">
<p id="S16.I4.i7.p1.1" class="ltx_p"><span id="S16.I4.i7.p1.1.1" class="ltx_text ltx_font_bold">(Rigidification)</span> <math id="S16.I4.i7.p1.m1" class="ltx_Math" alttext="\widetilde{\nu}_{pq}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ν</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\widetilde{\nu}_{pq}</annotation></semantics></math> does not vary in the normal direction to <math id="S16.I4.i7.p1.m2" class="ltx_Math" alttext="\widetilde{V}_{prq}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\widetilde{V}_{prq}</annotation></semantics></math> specified by the rigidfication.</p>
</div></li>
<li id="S16.I4.i8" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(8)</span> 
<div id="S16.I4.i8.p1" class="ltx_para ltx_noindent">
<p id="S16.I4.i8.p1.1" class="ltx_p"><span id="S16.I4.i8.p1.1.1" class="ltx_text ltx_font_bold">(Novikov equivariance)</span> These objects are equivariant with respect to the natural <math id="S16.I4.i8.p1.m1" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>-action.</p>
</div></li>
</ol>
</div>
</div>
<div id="S16.Thmthm9" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S16.Thmthm9.2" class="ltx_text ltx_font_bold">Lemma 16.9</span></span><span id="S16.Thmthm9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S16.Thmthm9.p1" class="ltx_para">
<p id="S16.Thmthm9.p1.1" class="ltx_p"><span id="S16.Thmthm9.p1.1.1" class="ltx_text ltx_font_italic">There exists an index bundle interpolator on <math id="S16.Thmthm9.p1.m1" class="ltx_Math" alttext="\hat{\mathbb{F}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝔽</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\mathbb{F}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S16.SS3.SSS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S16.SS3.SSS2.p5" class="ltx_para">
<p id="S16.SS3.SSS2.p5.1" class="ltx_p"><span id="S16.SS3.SSS2.p5.1.1" class="ltx_text">This is an inductive construction. The spaces <math id="S16.SS3.SSS2.p5.m1" class="ltx_Math" alttext="R_{p}^{+}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mi>p</mi><mo>+</mo></msubsup><annotation encoding="application/x-tex">R_{p}^{+}</annotation></semantics></math> and the maps <math id="S16.SS3.SSS2.p5.m2" class="ltx_Math" alttext="\nu_{p}" display="inline" intent=":literal"><semantics><msub><mi>ν</mi><mi>p</mi></msub><annotation encoding="application/x-tex">\nu_{p}</annotation></semantics></math> can be chosen independently for all objects. The construction of Abouzaid–Blumberg recalled previously provides the required space <math id="S16.SS3.SSS2.p5.m3" class="ltx_Math" alttext="W_{pq}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">W_{pq}</annotation></semantics></math> and the bundle map <math id="S16.SS3.SSS2.p5.m4" class="ltx_Math" alttext="\widetilde{\nu}_{pq}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ν</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\widetilde{\nu}_{pq}</annotation></semantics></math> for <math id="S16.SS3.SSS2.p5.m5" class="ltx_Math" alttext="p&lt;q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p&lt;q</annotation></semantics></math> which does not have intermediate objects. Suppose for a pair of objects <math id="S16.SS3.SSS2.p5.m6" class="ltx_Math" alttext="p&lt;q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p&lt;q</annotation></semantics></math>, one has constructed such structures for all <math id="S16.SS3.SSS2.p5.m7" class="ltx_Math" alttext="r&lt;s" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>&lt;</mo><mi>s</mi></mrow><annotation encoding="application/x-tex">r&lt;s</annotation></semantics></math> with <math id="S16.SS3.SSS2.p5.m8" class="ltx_Math" alttext="d_{r}-d_{s}&lt;d_{p}-d_{q}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>d</mi><mi>r</mi></msub><mo>−</mo><msub><mi>d</mi><mi>s</mi></msub></mrow><mo>&lt;</mo><mrow><msub><mi>d</mi><mi>p</mi></msub><mo>−</mo><msub><mi>d</mi><mi>q</mi></msub></mrow></mrow><annotation encoding="application/x-tex">d_{r}-d_{s}&lt;d_{p}-d_{q}</annotation></semantics></math>, then for <math id="S16.SS3.SSS2.p5.m9" class="ltx_Math" alttext="W_{pq}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">W_{pq}</annotation></semantics></math>, one can choose initially <math id="S16.SS3.SSS2.p5.m10" class="ltx_Math" alttext="W_{pq}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">W_{pq}</annotation></semantics></math> to be the direct sum of all <math id="S16.SS3.SSS2.p5.m11" class="ltx_Math" alttext="W_{pr}\oplus R_{p}^{+}\oplus W_{rq}" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo>⊕</mo><msubsup><mi>R</mi><mi>p</mi><mo>+</mo></msubsup><mo>⊕</mo><msub><mi>W</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">W_{pr}\oplus R_{p}^{+}\oplus W_{rq}</annotation></semantics></math> for intermediate objects <math id="S16.SS3.SSS2.p5.m12" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>. The value of <math id="S16.SS3.SSS2.p5.m13" class="ltx_Math" alttext="\widetilde{\nu}_{pq}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ν</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\widetilde{\nu}_{pq}</annotation></semantics></math> on the boundary is then determined by first three conditions of Definition <a href="#S16.Thmthm8" title="Definition 16.8. ‣ 16.3.2. The construction of the normal complex structure ‣ 16.3. Proof of Theorem ‣ 16. Vertical Normal Complex Structures and orientations ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16.8</span></a> as well as the rigidification condition. The collar condition allows us to extend slightly into the interior of <math id="S16.SS3.SSS2.p5.m14" class="ltx_Math" alttext="\widetilde{V}_{pq}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\widetilde{V}_{pq}</annotation></semantics></math>. The transversality achieved on the boundary strata is carried over to such an extension. To achieve global transversality, one may need to enlarge <math id="S16.SS3.SSS2.p5.m15" class="ltx_Math" alttext="W_{pq}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">W_{pq}</annotation></semantics></math> by taking direct sum with another complex vector space.
∎</span></p>
</div>
</div>
<div id="S16.SS3.SSS2.p6" class="ltx_para ltx_noindent">
<p id="S16.SS3.SSS2.p6.1" class="ltx_p">Once the index bundle interpolator is chosen, one automatically obtains a system of vector bundles over the spaces <math id="S16.SS3.SSS2.p6.m1" class="ltx_Math" alttext="\widetilde{V}_{pq}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\widetilde{V}_{pq}</annotation></semantics></math>. Indeed, for each <math id="S16.SS3.SSS2.p6.m2" class="ltx_Math" alttext="\widetilde{x}\in\widetilde{V}_{pq}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo>∈</mo><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\widetilde{x}\in\widetilde{V}_{pq}</annotation></semantics></math>, denote</p>
<table id="S16.Ex58" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S16.Ex58.m1" class="ltx_Math" alttext="\widetilde{I}_{pq}|_{\widetilde{x}}:={\rm ker}(\widetilde{\nu}_{pq}|_{\widetilde{x}}\oplus D_{\widetilde{x}})\subseteq{\mathcal{E}}_{pq}^{1}|_{\widetilde{x}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><msub><mover accent="true"><mi>I</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mover accent="true"><mi>x</mi><mo>~</mo></mover></msub><mo>:=</mo><mrow><mi>ker</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mrow><msub><mover accent="true"><mi>ν</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mover accent="true"><mi>x</mi><mo>~</mo></mover></msub><mo>⊕</mo><msub><mi>D</mi><mover accent="true"><mi>x</mi><mo>~</mo></mover></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊆</mo><msub><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mn>1</mn></msubsup><mo stretchy="false">|</mo></mrow><mover accent="true"><mi>x</mi><mo>~</mo></mover></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widetilde{I}_{pq}|_{\widetilde{x}}:={\rm ker}(\widetilde{\nu}_{pq}|_{\widetilde{x}}\oplus D_{\widetilde{x}})\subseteq{\mathcal{E}}_{pq}^{1}|_{\widetilde{x}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S16.SS3.SSS2.p6.2" class="ltx_p">They form a topological vector bundle <math id="S16.SS3.SSS2.p6.m3" class="ltx_Math" alttext="\widetilde{I}_{pq}\to\widetilde{V}_{pq}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>I</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">→</mo><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\widetilde{I}_{pq}\to\widetilde{V}_{pq}</annotation></semantics></math>. We consider its restriction to <math id="S16.SS3.SSS2.p6.m4" class="ltx_Math" alttext="\partial^{\pm}\widetilde{V}_{pq}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mo>±</mo></msup><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\partial^{\pm}\widetilde{V}_{pq}</annotation></semantics></math>. By the first two conditions of Definition <a href="#S16.Thmthm8" title="Definition 16.8. ‣ 16.3.2. The construction of the normal complex structure ‣ 16.3. Proof of Theorem ‣ 16. Vertical Normal Complex Structures and orientations ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16.8</span></a>, one has <math id="S16.SS3.SSS2.p6.m5" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math>-equivariant identifications</p>
<table id="S16.Ex59" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S16.Ex59.m1" class="ltx_Math" alttext="\widetilde{I}_{pq}|_{\partial^{-}\widetilde{V}_{pq}}\cong\underline{\smash{R}}_{p}^{-}\oplus T^{\rm vt}V_{pq}\oplus\underline{\smash{W}}_{pq}\oplus\underline{\smash{R}}_{q}^{+}" display="block" intent=":literal"><semantics><mrow><msub><mrow><msub><mover accent="true"><mi>I</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mrow><msup><mo>∂</mo><mo>−</mo></msup><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></msub><mo>≅</mo><mrow><msubsup><munder accentunder="true"><mi>R</mi><mo stretchy="true">¯</mo></munder><mi>p</mi><mo>−</mo></msubsup><mo>⊕</mo><mrow><msup><mi>T</mi><mi>vt</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo>⊕</mo><msub><munder accentunder="true"><mi>W</mi><mo stretchy="true">¯</mo></munder><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>⊕</mo><msubsup><munder accentunder="true"><mi>R</mi><mo stretchy="true">¯</mo></munder><mi>q</mi><mo>+</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">\widetilde{I}_{pq}|_{\partial^{-}\widetilde{V}_{pq}}\cong\underline{\smash{R}}_{p}^{-}\oplus T^{\rm vt}V_{pq}\oplus\underline{\smash{W}}_{pq}\oplus\underline{\smash{R}}_{q}^{+}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S16.SS3.SSS2.p6.3" class="ltx_p">and</p>
<table id="S16.Ex60" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S16.Ex60.m1" class="ltx_Math" alttext="\widetilde{I}_{pq}|_{\partial^{+}\widetilde{V}_{pq}}\cong\underline{\smash{R}}_{p}^{+}\oplus I_{pq}^{\mathbb{C}}\oplus\underline{\smash{R}}_{q}^{-}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><msub><mover accent="true"><mi>I</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mrow><msup><mo>∂</mo><mo>+</mo></msup><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></msub><mo>≅</mo><mrow><msubsup><munder accentunder="true"><mi>R</mi><mo stretchy="true">¯</mo></munder><mi>p</mi><mo>+</mo></msubsup><mo>⊕</mo><msubsup><mi>I</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>ℂ</mi></msubsup><mo>⊕</mo><msubsup><munder accentunder="true"><mi>R</mi><mo stretchy="true">¯</mo></munder><mi>q</mi><mo>−</mo></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widetilde{I}_{pq}|_{\partial^{+}\widetilde{V}_{pq}}\cong\underline{\smash{R}}_{p}^{+}\oplus I_{pq}^{\mathbb{C}}\oplus\underline{\smash{R}}_{q}^{-}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S16.SS3.SSS2.p6.4" class="ltx_p">Here <math id="S16.SS3.SSS2.p6.m6" class="ltx_Math" alttext="I_{pq}^{\mathbb{C}}" display="inline" intent=":literal"><semantics><msubsup><mi>I</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>ℂ</mi></msubsup><annotation encoding="application/x-tex">I_{pq}^{\mathbb{C}}</annotation></semantics></math> has fiber over <math id="S16.SS3.SSS2.p6.m7" class="ltx_Math" alttext="\widetilde{x}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>x</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{x}</annotation></semantics></math> being</p>
<table id="S16.Ex61" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S16.Ex61.m1" class="ltx_Math" alttext="{\rm ker}(\nu_{\widetilde{x}}\oplus D_{u}^{\mathbb{C}})" display="block" intent=":literal"><semantics><mrow><mi>ker</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ν</mi><mover accent="true"><mi>x</mi><mo>~</mo></mover></msub><mo>⊕</mo><msubsup><mi>D</mi><mi>u</mi><mi>ℂ</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\rm ker}(\nu_{\widetilde{x}}\oplus D_{u}^{\mathbb{C}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S16.SS3.SSS2.p6.5" class="ltx_p">hence a <math id="S16.SS3.SSS2.p6.m8" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math>-equivariant complex vector bundle. Notice that <math id="S16.SS3.SSS2.p6.m9" class="ltx_Math" alttext="\partial^{-}\widetilde{V}_{pq}\cong V_{pq}\cong\partial^{+}\widetilde{V}_{pq}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mo>∂</mo><mo>−</mo></msup><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo>≅</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo rspace="0.111em">≅</mo><mrow><msup><mo>∂</mo><mo>+</mo></msup><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\partial^{-}\widetilde{V}_{pq}\cong V_{pq}\cong\partial^{+}\widetilde{V}_{pq}</annotation></semantics></math> canonically and the inclusions of <math id="S16.SS3.SSS2.p6.m10" class="ltx_Math" alttext="V_{pq}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">V_{pq}</annotation></semantics></math> into <math id="S16.SS3.SSS2.p6.m11" class="ltx_Math" alttext="\widetilde{V}_{pq}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\widetilde{V}_{pq}</annotation></semantics></math> from both sides are <math id="S16.SS3.SSS2.p6.m12" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math>-equivariant homotopy equivalences. Hence the two restriction bundles are equivariantly isomorphic.</p>
</div>
<div id="S16.SS3.SSS2.p7" class="ltx_para ltx_noindent">
<p id="S16.SS3.SSS2.p7.1" class="ltx_p">To construct a normal complex structure on the flow category, one must choose such bundle isomorphisms in a way compatible with the flow category structure. Notice that the product <math id="S16.SS3.SSS2.p7.m1" class="ltx_Math" alttext="\widetilde{V}_{prq}\cong\widetilde{V}_{pr}\boxtimes\widetilde{V}_{rq}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>≅</mo><mrow><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">⊠</mo><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\widetilde{V}_{prq}\cong\widetilde{V}_{pr}\boxtimes\widetilde{V}_{rq}</annotation></semantics></math>, it is the union</p>
<table id="S16.Ex62" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S16.Ex62.m1" class="ltx_Math" alttext="\widetilde{V}_{pr}\times\partial^{-}\widetilde{V}_{rq}\underset{\partial^{+}\widetilde{V}_{pr}\times\partial^{-}\widetilde{V}_{rq}}{\cup}\partial^{+}\widetilde{V}_{pr}\times\widetilde{V}_{rq}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0.222em" rspace="0.055em">×</mo><mrow><msup><mo>∂</mo><mo>−</mo></msup><mrow><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mo>∪</mo><mrow><mrow><msup><mo mathsize="0.700em">∂</mo><mo mathsize="0.710em">+</mo></msup><msub><mover accent="true"><mi mathsize="0.700em">V</mi><mo>~</mo></mover><mrow><mi mathsize="0.710em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">r</mi></mrow></msub></mrow><mo lspace="0.222em" mathsize="0.700em" rspace="0.055em">×</mo><mrow><msup><mo mathsize="0.700em">∂</mo><mo mathsize="0.710em">−</mo></msup><msub><mover accent="true"><mi mathsize="0.700em">V</mi><mo>~</mo></mover><mrow><mi mathsize="0.710em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">q</mi></mrow></msub></mrow></mrow></munder><mo lspace="0.222em" rspace="0em">​</mo><mrow><msup><mo>∂</mo><mo>+</mo></msup><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></mrow></mrow></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widetilde{V}_{pr}\times\partial^{-}\widetilde{V}_{rq}\underset{\partial^{+}\widetilde{V}_{pr}\times\partial^{-}\widetilde{V}_{rq}}{\cup}\partial^{+}\widetilde{V}_{pr}\times\widetilde{V}_{rq}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S16.SS3.SSS2.p7.2" class="ltx_p">Hence <math id="S16.SS3.SSS2.p7.m2" class="ltx_Math" alttext="\widetilde{I}_{pr}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>I</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">\widetilde{I}_{pr}</annotation></semantics></math> and <math id="S16.SS3.SSS2.p7.m3" class="ltx_Math" alttext="\widetilde{I}_{rq}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>I</mi><mo>~</mo></mover><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\widetilde{I}_{rq}</annotation></semantics></math> determine a vector bundle</p>
<table id="S16.Ex63" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S16.Ex63.m1" class="ltx_Math" alttext="\widetilde{I}_{prq}\to\widetilde{V}_{prq}" display="block" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>I</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">→</mo><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\widetilde{I}_{prq}\to\widetilde{V}_{prq}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S16.SS3.SSS2.p7.3" class="ltx_p">which is <math id="S16.SS3.SSS2.p7.m4" class="ltx_Math" alttext="\widetilde{I}_{pr}\oplus\underline{\smash{R}}_{r}^{-}\oplus T^{\rm vt}V_{rq}\oplus\underline{\smash{W}}_{rq}\oplus\underline{\smash{R}}_{q}^{+}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>I</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo>⊕</mo><msubsup><munder accentunder="true"><mi>R</mi><mo stretchy="true">¯</mo></munder><mi>r</mi><mo>−</mo></msubsup><mo>⊕</mo><mrow><msup><mi>T</mi><mi>vt</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo>⊕</mo><msub><munder accentunder="true"><mi>W</mi><mo stretchy="true">¯</mo></munder><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>⊕</mo><msubsup><munder accentunder="true"><mi>R</mi><mo stretchy="true">¯</mo></munder><mi>q</mi><mo>+</mo></msubsup></mrow><annotation encoding="application/x-tex">\widetilde{I}_{pr}\oplus\underline{\smash{R}}_{r}^{-}\oplus T^{\rm vt}V_{rq}\oplus\underline{\smash{W}}_{rq}\oplus\underline{\smash{R}}_{q}^{+}</annotation></semantics></math> on the first piece and which is <math id="S16.SS3.SSS2.p7.m5" class="ltx_Math" alttext="\underline{\smash{R}}_{p}^{+}\oplus I_{pq}^{\mathbb{C}}\oplus\widetilde{I}_{rq}" display="inline" intent=":literal"><semantics><mrow><msubsup><munder accentunder="true"><mi>R</mi><mo stretchy="true">¯</mo></munder><mi>p</mi><mo>+</mo></msubsup><mo>⊕</mo><msubsup><mi>I</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>ℂ</mi></msubsup><mo>⊕</mo><msub><mover accent="true"><mi>I</mi><mo>~</mo></mover><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\underline{\smash{R}}_{p}^{+}\oplus I_{pq}^{\mathbb{C}}\oplus\widetilde{I}_{rq}</annotation></semantics></math> on the second piece.</p>
</div>
<div id="S16.Thmthm10" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S16.Thmthm10.2" class="ltx_text ltx_font_bold">Lemma 16.10</span></span><span id="S16.Thmthm10.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S16.Thmthm10.p1" class="ltx_para ltx_noindent">
<p id="S16.Thmthm10.p1.1" class="ltx_p"><span id="S16.Thmthm10.p1.1.1" class="ltx_text ltx_font_italic">There exists a system of <math id="S16.Thmthm10.p1.m1" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math>-equivariant real vector bundle isomorphisms</span></p>
<table id="S16.Ex64" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S16.Ex64.m1" class="ltx_Math" alttext="\widetilde{I}_{pq}|_{\partial^{-}\widetilde{V}_{pq}}\cong\widetilde{I}_{pq}|_{\partial^{+}\widetilde{V}_{pq}}" display="block" intent=":literal"><semantics><mrow><msub><mrow><msub><mover accent="true"><mi>I</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mrow><msup><mo>∂</mo><mo>−</mo></msup><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></msub><mo>≅</mo><msub><mrow><msub><mover accent="true"><mi>I</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mrow><msup><mo>∂</mo><mo>+</mo></msup><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></msub></mrow><annotation encoding="application/x-tex">\widetilde{I}_{pq}|_{\partial^{-}\widetilde{V}_{pq}}\cong\widetilde{I}_{pq}|_{\partial^{+}\widetilde{V}_{pq}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S16.Thmthm10.p1.2" class="ltx_p"><span id="S16.Thmthm10.p1.2.1" class="ltx_text ltx_font_italic">satisfying the following conditions.</span></p>
</div>
<div id="S16.Thmthm10.p2" class="ltx_para">
<ol id="S16.I5" class="ltx_enumerate">
<li id="S16.I5.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S16.I5.i1.p1" class="ltx_para ltx_noindent">
<p id="S16.I5.i1.p1.1" class="ltx_p"><span id="S16.I5.i1.p1.1.1" class="ltx_text ltx_font_italic">Whenever </span><math id="S16.I5.i1.p1.m1" class="ltx_Math" alttext="p&lt;r&lt;q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mi>r</mi><mo>&lt;</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p&lt;r&lt;q</annotation></semantics></math><span id="S16.I5.i1.p1.1.2" class="ltx_text ltx_font_italic">, the following diagram commutes.</span></p>
<table id="S16.Ex65" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S16.Ex65.m1.pic1" class="ltx_picture ltx_markedasmath" height="71.53" overflow="visible" style="vertical-align:-60.536875605368756px" version="1.1" viewBox="51.31 60.54 385.78 71.53" width="385.78"><g transform="matrix(1 0 0 -1 51.3058466190155 71.52962226070638) translate(0,3.54) translate(51.31,0)"><g transform="translate(-51.31,0) translate(4.15,0) translate(0,-3.54)"><foreignObject style="--ltx-fo-width:6.82em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.63em;font-size:10pt;" height="19.03" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="94.31"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S16.Ex65.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{\widetilde{I}_{prq}|_{\partial^{-}\widetilde{V}_{pr}\times\partial^{-}\widetilde{V}_{rq}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mrow><msub><mover accent="true"><mi>I</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mrow><mrow><msup><mo>∂</mo><mo>−</mo></msup><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></mrow><mo lspace="0.222em" rspace="0.055em">×</mo><mrow><msup><mo>∂</mo><mo>−</mo></msup><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mrow></msub><annotation encoding="application/x-tex">\textstyle{\widetilde{I}_{prq}|_{\partial^{-}\widetilde{V}_{pr}\times\partial^{-}\widetilde{V}_{rq}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path st