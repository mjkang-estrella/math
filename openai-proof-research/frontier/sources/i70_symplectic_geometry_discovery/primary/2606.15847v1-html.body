\cong\widetilde{I}_{p_{j}q_{j}}|_{\partial^{+}\widetilde{V}_{p_{j}q_{j}}}\oplus\widetilde{I}_{p_{1}\cdots p_{j-1}q_{j}p_{j+1}\cdots p_{m};p^{\prime}}|_{\partial^{+}\widetilde{V}_{p_{1}\cdots p_{j-1}q_{j}p_{j+1}\cdots p_{m};p^{\prime}}}." display="block" intent=":literal"><semantics><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mover accent="true"><mi>I</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi>p</mi><msub><mrow></mrow><mi>j</mi></msub><mi>q</mi><msub><mrow></mrow><mi>j</mi></msub><mo stretchy="false">)</mo><mi>p</mi><msub><mrow></mrow><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo fence="false" stretchy="false">|</mo><msub><mrow></mrow><mrow><mo>∂</mo><msup><mrow></mrow><mo>+</mo></msup><mover accent="true"><mi>V</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi>p</mi><msub><mrow></mrow><mi>j</mi></msub><mi>q</mi><msub><mrow></mrow><mi>j</mi></msub><mo stretchy="false">)</mo><mi>p</mi><msub><mrow></mrow><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub></mrow></msub></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mo>≅</mo><mover accent="true"><mi>I</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><msub><mi>p</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>j</mi></msub></mrow></msub><mo fence="false" stretchy="false">|</mo><msub><mrow></mrow><mrow><msup><mo>∂</mo><mo>+</mo></msup><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><msub><mi>p</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>j</mi></msub></mrow></msub></mrow></msub><mo lspace="0em">⊕</mo><mover accent="true"><mi>I</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mi>q</mi><msub><mrow></mrow><mi>j</mi></msub><mi>p</mi><msub><mrow></mrow><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo fence="false" stretchy="false">|</mo><msub><mrow></mrow><mrow><mo>∂</mo><msup><mrow></mrow><mo>+</mo></msup><mover accent="true"><mi>V</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mi>q</mi><msub><mrow></mrow><mi>j</mi></msub><mi>p</mi><msub><mrow></mrow><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub></mrow></msub><mo lspace="0.167em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\widetilde{I}_{p_{1}\cdots p_{j-1}(p_{j}q_{j})p_{j+1}\cdots p_{m};p^{\prime}}|_{\partial^{+}\widetilde{V}_{p_{1}\cdots p_{j-1}(p_{j}q_{j})p_{j+1}\cdots p_{m};p^{\prime}}}\\
\cong\widetilde{I}_{p_{j}q_{j}}|_{\partial^{+}\widetilde{V}_{p_{j}q_{j}}}\oplus\widetilde{I}_{p_{1}\cdots p_{j-1}q_{j}p_{j+1}\cdots p_{m};p^{\prime}}|_{\partial^{+}\widetilde{V}_{p_{1}\cdots p_{j-1}q_{j}p_{j+1}\cdots p_{m};p^{\prime}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S16.I9.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S16.I9.i2.p1" class="ltx_para ltx_noindent">
<p id="S16.I9.i2.p1.1" class="ltx_p">Suppose <math id="S16.I9.i2.p1.m1" class="ltx_Math" alttext="q^{\prime}&lt;p^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mo>′</mo></msup><mo>&lt;</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">q^{\prime}&lt;p^{\prime}</annotation></semantics></math> in <math id="S16.I9.i2.p1.m2" class="ltx_Math" alttext="{\mathbb{F}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝔽</mi><mo>′</mo></msup><annotation encoding="application/x-tex">{\mathbb{F}}^{\prime}</annotation></semantics></math>. Then there is a corresponding relative space <math id="S16.I9.i2.p1.m3" class="ltx_math_unparsed" alttext="\widetilde{V}_{p_{1}\cdots p_{m};q^{\prime}p^{\prime}}\to\widetilde{B}_{p_{1}\cdots p_{m};q^{\prime}}\boxtimes\widetilde{B}_{q^{\prime}p^{\prime}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>V</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo stretchy="false">→</mo><mover accent="true"><mi>B</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo lspace="0.222em" rspace="0.222em">⊠</mo><mover accent="true"><mi>B</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><msup><mi>q</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub></mrow><annotation encoding="application/x-tex">\widetilde{V}_{p_{1}\cdots p_{m};q^{\prime}p^{\prime}}\to\widetilde{B}_{p_{1}\cdots p_{m};q^{\prime}}\boxtimes\widetilde{B}_{q^{\prime}p^{\prime}}</annotation></semantics></math>. The three further lower strata are</p>
<table id="S16.Ex105" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S16.Ex105.m1" class="ltx_Math" alttext="\begin{split}\partial^{-}\widetilde{V}_{p_{1}\cdots p_{m};q^{\prime}p^{\prime}}\cong&amp;\ \partial^{-}\widetilde{V}_{p_{1}\cdots p_{m};q^{\prime}}\times\partial^{-}\widetilde{V}_{q^{\prime}p^{\prime}},\\
\partial^{0}\widetilde{V}_{p_{1}\cdots p_{m};q^{\prime}p^{\prime}}\cong&amp;\ \partial^{+}\widetilde{V}_{p_{1}\cdots p_{m};q^{\prime}}\times\partial^{-}\widetilde{V}_{q^{\prime}p^{\prime}},\\
\partial^{+}\widetilde{V}_{p_{1}\cdots p_{m};q^{\prime}p^{\prime}}\cong&amp;\ \partial^{+}\widetilde{V}_{p_{1}\cdots p_{m};q^{\prime}}\times\partial^{+}\widetilde{V}_{q^{\prime}p^{\prime}}.\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mo>∂</mo><msup><mrow></mrow><mo>−</mo></msup><mover accent="true"><mi>V</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo>≅</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>∂</mo><msup><mrow></mrow><mo>−</mo></msup><mover accent="true"><mi>V</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo lspace="0.222em" rspace="0.055em">×</mo><mo>∂</mo><msup><mrow></mrow><mo>−</mo></msup><mover accent="true"><mi>V</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><msup><mi>q</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mo>∂</mo><msup><mrow></mrow><mn>0</mn></msup><mover accent="true"><mi>V</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo>≅</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>∂</mo><msup><mrow></mrow><mo>+</mo></msup><mover accent="true"><mi>V</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo lspace="0.222em" rspace="0.055em">×</mo><mo>∂</mo><msup><mrow></mrow><mo>−</mo></msup><mover accent="true"><mi>V</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><msup><mi>q</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mo>∂</mo><msup><mrow></mrow><mo>+</mo></msup><mover accent="true"><mi>V</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo>≅</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>∂</mo><msup><mrow></mrow><mo>+</mo></msup><mover accent="true"><mi>V</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo lspace="0.222em" rspace="0.055em">×</mo><mo>∂</mo><msup><mrow></mrow><mo>+</mo></msup><mover accent="true"><mi>V</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><msup><mi>q</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\partial^{-}\widetilde{V}_{p_{1}\cdots p_{m};q^{\prime}p^{\prime}}\cong&amp;\ \partial^{-}\widetilde{V}_{p_{1}\cdots p_{m};q^{\prime}}\times\partial^{-}\widetilde{V}_{q^{\prime}p^{\prime}},\\
\partial^{0}\widetilde{V}_{p_{1}\cdots p_{m};q^{\prime}p^{\prime}}\cong&amp;\ \partial^{+}\widetilde{V}_{p_{1}\cdots p_{m};q^{\prime}}\times\partial^{-}\widetilde{V}_{q^{\prime}p^{\prime}},\\
\partial^{+}\widetilde{V}_{p_{1}\cdots p_{m};q^{\prime}p^{\prime}}\cong&amp;\ \partial^{+}\widetilde{V}_{p_{1}\cdots p_{m};q^{\prime}}\times\partial^{+}\widetilde{V}_{q^{\prime}p^{\prime}}.\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S16.I9.i2.p1.2" class="ltx_p">The extended index bundle <math id="S16.I9.i2.p1.m4" class="ltx_math_unparsed" alttext="\widetilde{I}_{p_{1}\cdots p_{m};p^{\prime}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>I</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub></mrow><annotation encoding="application/x-tex">\widetilde{I}_{p_{1}\cdots p_{m};p^{\prime}}</annotation></semantics></math>, when restricted to then, has the subbundle <math id="S16.I9.i2.p1.m5" class="ltx_math_unparsed" alttext="\widetilde{I}_{p_{1}\cdots p_{m};q^{\prime}p^{\prime}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>I</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub></mrow><annotation encoding="application/x-tex">\widetilde{I}_{p_{1}\cdots p_{m};q^{\prime}p^{\prime}}</annotation></semantics></math> and is identified respectively as</p>
<table id="S16.Ex106" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S16.Ex106.m1" class="ltx_Math" alttext="\begin{split}\widetilde{I}_{p_{1}\cdots p_{m};q^{\prime}p^{\prime}}|_{\partial^{-}\widetilde{V}_{p_{1}\cdots p_{m};q^{\prime}p^{\prime}}}\cong&amp;\ \widetilde{I}_{p_{1}\cdots p_{m};q^{\prime}}|_{\partial^{-}\widetilde{V}_{p_{1}\cdots p_{m};q^{\prime}}}\oplus\widetilde{I}_{q^{\prime}p^{\prime}}|_{\partial^{-}\widetilde{V}_{q^{\prime}p^{\prime}}},\\
\widetilde{I}_{p_{1}\cdots p_{m};q^{\prime}p^{\prime}}|_{\partial^{0}\widetilde{V}_{p_{1}\cdots p_{m};q^{\prime}p^{\prime}}}\cong&amp;\ \widetilde{I}_{p_{1}\cdots p_{m};q^{\prime}}|_{\partial^{+}\widetilde{V}_{p_{1}\cdots p_{m};q^{\prime}}}\oplus\widetilde{I}_{q^{\prime}p^{\prime}}|_{\partial^{-}\widetilde{V}_{q^{\prime}p^{\prime}}},\\
\widetilde{I}_{p_{1}\cdots p_{m};q^{\prime}p^{\prime}}|_{\partial^{+}\widetilde{V}_{p_{1}\cdots p_{m};q^{\prime}p^{\prime}}}\cong&amp;\ \widetilde{I}_{p_{1}\cdots p_{m};q^{\prime}}|_{\partial^{+}\widetilde{V}_{p_{1}\cdots p_{m};q^{\prime}}}\oplus\widetilde{I}_{q^{\prime}p^{\prime}}|_{\partial^{+}\widetilde{V}_{q^{\prime}p^{\prime}}}.\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mover accent="true"><mi>I</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo fence="false" stretchy="false">|</mo><msub><mrow></mrow><mrow><mo>∂</mo><msup><mrow></mrow><mo>−</mo></msup><mover accent="true"><mi>V</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub></mrow></msub><mo lspace="0.167em">≅</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mover accent="true"><mi>I</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo fence="false" stretchy="false">|</mo><msub><mrow></mrow><mrow><mo>∂</mo><msup><mrow></mrow><mo>−</mo></msup><mover accent="true"><mi>V</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub></mrow></msub><mo lspace="0em">⊕</mo><mover accent="true"><mi>I</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><msup><mi>q</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mrow></mrow><mrow><msup><mo>∂</mo><mo>−</mo></msup><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><msup><mi>q</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub></mrow></msub><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mover accent="true"><mi>I</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo fence="false" stretchy="false">|</mo><msub><mrow></mrow><mrow><mo>∂</mo><msup><mrow></mrow><mn>0</mn></msup><mover accent="true"><mi>V</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub></mrow></msub><mo lspace="0.167em">≅</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mover accent="true"><mi>I</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo fence="false" stretchy="false">|</mo><msub><mrow></mrow><mrow><mo>∂</mo><msup><mrow></mrow><mo>+</mo></msup><mover accent="true"><mi>V</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1<