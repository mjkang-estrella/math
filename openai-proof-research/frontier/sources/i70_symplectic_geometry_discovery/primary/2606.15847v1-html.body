<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S16.Ex95.m1.pic1" class="ltx_picture ltx_markedasmath" height="73.57" overflow="visible" style="vertical-align:-59.83360314807968px" version="1.1" viewBox="149.04 59.83 566.28 73.57" width="566.28"><g transform="matrix(1 0 0 -1 149.0380421901485 73.56615437335685) translate(0,3.46) translate(149.04,0)"><g transform="translate(-149.04,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:20.94em;--ltx-fo-height:0.94em;--ltx-fo-depth:0.43em;font-size:10pt;" height="19.02" overflow="visible" transform="matrix(1 0 0 -1 0 13.04)" width="289.78"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S16.Ex95.m1.pic1.m1" class="ltx_math_unparsed" alttext="\textstyle{W_{p_{j}q_{j}}^{{\mathbb{F}}_{j}}\oplus R_{q_{j}}^{+}\oplus W_{p_{1}\cdots p_{j-1}q_{j}p_{j+1}\cdots p_{m};q^{\prime}}^{{\mathbb{X}}}\oplus R_{q^{\prime}}^{+}\oplus W_{q^{\prime}p^{\prime}}^{{\mathbb{F}}^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><msub><mrow></mrow><mrow><msub><mi>p</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>j</mi></msub></mrow></msub><msup><mrow></mrow><msub><mi>𝔽</mi><mi>j</mi></msub></msup><mo>⊕</mo><mi>R</mi><msub><mrow></mrow><msub><mi>q</mi><mi>j</mi></msub></msub><msup><mrow></mrow><mo>+</mo></msup><mo>⊕</mo><mi>W</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mi>q</mi><msub><mrow></mrow><mi>j</mi></msub><mi>p</mi><msub><mrow></mrow><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo>⊕</mo><mi>R</mi><msub><mrow></mrow><msup><mi>q</mi><mo>′</mo></msup></msub><msup><mrow></mrow><mo>+</mo></msup><mo>⊕</mo><mi>W</mi><msub><mrow></mrow><mrow><msup><mi>q</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><msup><mi>𝔽</mi><mo>′</mo></msup></msup></mrow><annotation encoding="application/x-tex">\textstyle{W_{p_{j}q_{j}}^{{\mathbb{F}}_{j}}\oplus R_{q_{j}}^{+}\oplus W_{p_{1}\cdots p_{j-1}q_{j}p_{j+1}\cdots p_{m};q^{\prime}}^{{\mathbb{X}}}\oplus R_{q^{\prime}}^{+}\oplus W_{q^{\prime}p^{\prime}}^{{\mathbb{F}}^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 149.03806330373513 -0.27673578005007266 L 149.03806330373513 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(265.27,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 149.03806330373513 -0.27673578005007266 L 265.2688433524565 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 265.2688433524565 -0.27673578005007266 L 265.2688433524565 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -13.592589259461048 L 0.27673578005007266 -13.592589259461048" fill="none" stroke="#000000"></path><g transform="translate(0,-33.91)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.909116887247905 L 0.27673578005007266 -13.592589259461048" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.909116887247905 L 0.27673578005007266 -33.909116887247905" fill="none" stroke="#000000"></path><g transform="translate(265.27,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:10.38em;--ltx-fo-height:0.94em;--ltx-fo-depth:0.38em;font-size:10pt;" height="18.23" overflow="visible" transform="matrix(1 0 0 -1 0 13.04)" width="143.67"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S16.Ex95.m1.pic1.m4" class="ltx_math_unparsed" alttext="\textstyle{W_{p_{1}\cdots p_{m};q^{\prime}}^{{\mathbb{X}}}\oplus R_{q^{\prime}}^{+}\oplus W_{q^{\prime}p^{\prime}}^{{\mathbb{F}}^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo>⊕</mo><mi>R</mi><msub><mrow></mrow><msup><mi>q</mi><mo>′</mo></msup></msub><msup><mrow></mrow><mo>+</mo></msup><mo>⊕</mo><mi>W</mi><msub><mrow></mrow><mrow><msup><mi>q</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><msup><mi>𝔽</mi><mo>′</mo></msup></msup></mrow><annotation encoding="application/x-tex">\textstyle{W_{p_{1}\cdots p_{m};q^{\prime}}^{{\mathbb{X}}}\oplus R_{q^{\prime}}^{+}\oplus W_{q^{\prime}p^{\prime}}^{{\mathbb{F}}^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 340.9774355890346 -12.80080864699002 L 341.53090714913475 -12.80080864699002" fill="none" stroke="#000000"></path><g transform="translate(341.26,0) translate(0,-33.91)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 340.9774355890346 -33.909116887247905 L 341.53090714913475 -12.80080864699002" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 340.9774355890346 -33.909116887247905 L 341.53090714913475 -33.909116887247905" fill="none" stroke="#000000"></path><g transform="translate(-107.97,0) translate(0,-46.24) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:15.01em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.43em;font-size:10pt;" height="17.62" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="207.63"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S16.Ex95.m1.pic1.m5" class="ltx_math_unparsed" alttext="\textstyle{W_{p_{j}q_{j}}^{{\mathbb{F}}_{j}}\oplus R_{q_{j}}^{+}\oplus W_{p_{1}\cdots p_{j-1}q_{j}p_{j+1}\cdots p_{m};p^{\prime}}^{{\mathbb{X}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><msub><mrow></mrow><mrow><msub><mi>p</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>j</mi></msub></mrow></msub><msup><mrow></mrow><msub><mi>𝔽</mi><mi>j</mi></msub></msup><mo>⊕</mo><mi>R</mi><msub><mrow></mrow><msub><mi>q</mi><mi>j</mi></msub></msub><msup><mrow></mrow><mo>+</mo></msup><mo>⊕</mo><mi>W</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mi>q</mi><msub><mrow></mrow><mi>j</mi></msub><mi>p</mi><msub><mrow></mrow><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup></mrow><annotation encoding="application/x-tex">\textstyle{W_{p_{j}q_{j}}^{{\mathbb{F}}_{j}}\oplus R_{q_{j}}^{+}\oplus W_{p_{1}\cdots p_{j-1}q_{j}p_{j+1}\cdots p_{m};p^{\prime}}^{{\mathbb{X}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 107.96493756188815 -46.517749668668706 L 107.96493756188815 -45.964278108568564" fill="none" stroke="#000000"></path><g transform="translate(306.35,0) translate(0,-46.24)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 107.96493756188815 -46.517749668668706 L 306.34194798071684 -45.964278108568564" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 306.34194798071684 -46.517749668668706 L 306.34194798071684 -45.964278108568564" fill="none" stroke="#000000"></path><g transform="translate(306.35,0) translate(0,-46.24) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:4.45em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.38em;font-size:10pt;" height="16.83" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="61.52"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S16.Ex95.m1.pic1.m8" class="ltx_math_unparsed" alttext="\textstyle{W_{p_{1}\cdots p_{m};p^{\prime}}^{{\mathbb{X}}}}" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup></mrow><annotation encoding="application/x-tex">\textstyle{W_{p_{1}\cdots p_{m};p^{\prime}}^{{\mathbb{X}}}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
