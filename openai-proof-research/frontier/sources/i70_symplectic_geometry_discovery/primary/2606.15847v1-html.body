+</mo><mi mathsize="0.710em">d</mi></mrow><mo mathsize="0.710em">;</mo><msup><mi mathsize="0.710em">d</mi><mo>′</mo></msup></mrow><mi mathsize="0.710em">𝕩</mi></msubsup><annotation encoding="application/x-tex">\scriptstyle{\iota_{d_{j}+d;d^{\prime}}^{\mathbb{x}}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(139.75,0) translate(0,-46.94)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 44.03732551056368 -47.218066223828615 L 139.7505977003014 -46.664594663728465" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 139.7505977003014 -47.218066223828615 L 139.7505977003014 -46.664594663728465" fill="none" stroke="#000000"></path><g transform="translate(139.75,0) translate(0,-46.94) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:4.25em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.43em;font-size:10pt;" height="15.44" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="58.81"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S14.Ex7.m1.pic1.m8" class="ltx_Math" alttext="\textstyle{M_{d_{j}+d+d^{\prime}}^{\mathbb{x}}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mrow><msub><mi>d</mi><mi>j</mi></msub><mo>+</mo><mi>d</mi><mo>+</mo><msup><mi>d</mi><mo>′</mo></msup></mrow><mi>𝕩</mi></msubsup><annotation encoding="application/x-tex">\textstyle{M_{d_{j}+d+d^{\prime}}^{\mathbb{x}}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.I2.i3.p1.2" class="ltx_p">Hence we may combine the morphisms <math id="S14.I2.i3.p1.m2" class="ltx_Math" alttext="\iota_{d_{j};d}^{\mathbb{x}}" display="inline" intent=":literal"><semantics><msubsup><mi>ι</mi><mrow><msub><mi>d</mi><mi>j</mi></msub><mo>;</mo><mi>d</mi></mrow><mi>𝕩</mi></msubsup><annotation encoding="application/x-tex">\iota_{d_{j};d}^{\mathbb{x}}</annotation></semantics></math> and <math id="S14.I2.i3.p1.m3" class="ltx_Math" alttext="\iota_{d;d^{\prime}}^{\mathbb{x}}" display="inline" intent=":literal"><semantics><msubsup><mi>ι</mi><mrow><mi>d</mi><mo>;</mo><msup><mi>d</mi><mo>′</mo></msup></mrow><mi>𝕩</mi></msubsup><annotation encoding="application/x-tex">\iota_{d;d^{\prime}}^{\mathbb{x}}</annotation></semantics></math> as one</p>
<table id="S14.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex8.m1" class="ltx_Math" alttext="M_{d_{j}}^{{\mathbb{f}}_{j}}\times M_{d}^{\mathbb{\xi}}\times M_{d^{\prime}}^{{\mathbb{f}}^{\prime}}\to M_{d_{j}+d+d^{\prime}}^{\mathbb{x}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>M</mi><msub><mi>d</mi><mi>j</mi></msub><msub><mi>𝕗</mi><mi>j</mi></msub></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>M</mi><mi>d</mi><mi>ξ</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>M</mi><msup><mi>d</mi><mo>′</mo></msup><msup><mi>𝕗</mi><mo>′</mo></msup></msubsup></mrow><mo stretchy="false">→</mo><msubsup><mi>M</mi><mrow><msub><mi>d</mi><mi>j</mi></msub><mo>+</mo><mi>d</mi><mo>+</mo><msup><mi>d</mi><mo>′</mo></msup></mrow><mi>𝕩</mi></msubsup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">M_{d_{j}}^{{\mathbb{f}}_{j}}\times M_{d}^{\mathbb{\xi}}\times M_{d^{\prime}}^{{\mathbb{f}}^{\prime}}\to M_{d_{j}+d+d^{\prime}}^{\mathbb{x}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S14.I2.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S14.I2.i4.p1" class="ltx_para ltx_noindent">
<p id="S14.I2.i4.p1.1" class="ltx_p">For <math id="S14.I2.i4.p1.m1" class="ltx_Math" alttext="d_{j},e_{j},d,d^{\prime},e^{\prime}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>j</mi></msub><mo>,</mo><msub><mi>e</mi><mi>j</mi></msub><mo>,</mo><mi>d</mi><mo>,</mo><msup><mi>d</mi><mo>′</mo></msup><mo>,</mo><mrow><msup><mi>e</mi><mo>′</mo></msup><mo>≥</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">d_{j},e_{j},d,d^{\prime},e^{\prime}\geq 0</annotation></semantics></math>, the following diagram commutes.</p>
<table id="S14.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
