<div id="S12.I2.i1.p1" class="ltx_para ltx_noindent">
<p id="S12.I2.i1.p1.1" class="ltx_p"><span id="S12.I2.i1.p1.1.1" class="ltx_text ltx_font_italic">When </span><math id="S12.I2.i1.p1.m1" class="ltx_Math" alttext="n=1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n=1</annotation></semantics></math><span id="S12.I2.i1.p1.1.2" class="ltx_text ltx_font_italic">, let</span></p>
