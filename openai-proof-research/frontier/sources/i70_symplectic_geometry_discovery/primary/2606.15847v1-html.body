<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.E6.m1" class="ltx_Math" alttext="\lambda_{d}(\zeta_{d_{1},d_{2}}^{B}(x_{1},x_{2}),(q_{1},q_{2},v))=(1,\theta_{d_{1},d_{2}}(x_{1},x_{2},v))\cdot\Big(\zeta_{d_{1},d_{2}}^{B}(x_{1},x_{2}),\zeta_{d_{1},d_{2}}^{P}(\lambda_{d_{1}}(x_{1},q_{1}),\lambda_{d_{2}}(x_{2},q_{2}))\Big)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>ζ</mi><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub></mrow><mi>B</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mn>1</mn></msub><mo>,</mo><msub><mi>q</mi><mn>2</mn></msub><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mrow><msub><mi>θ</mi><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msubsup><mi>ζ</mi><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub></mrow><mi>B</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi>ζ</mi><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub></mrow><mi>P</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>λ</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>q</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>λ</mi><msub><mi>d</mi><mn>2</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo>,</mo><msub><mi>q</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{d}(\zeta_{d_{1},d_{2}}^{B}(x_{1},x_{2}),(q_{1},q_{2},v))=(1,\theta_{d_{1},d_{2}}(x_{1},x_{2},v))\cdot\Big(\zeta_{d_{1},d_{2}}^{B}(x_{1},x_{2}),\zeta_{d_{1},d_{2}}^{P}(\lambda_{d_{1}}(x_{1},q_{1}),\lambda_{d_{2}}(x_{2},q_{2}))\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(14.6)</span></td></tr></tbody>
</table>
<p id="S14.I7.i4.p1.2" class="ltx_p"><span id="S14.I7.i4.p1.2.1" class="ltx_text ltx_font_italic">where </span><math id="S14.I7.i4.p1.m8" class="ltx_Math" alttext="\cdot" display="inline" intent=":literal"><semantics><mo>⋅</mo><annotation encoding="application/x-tex">\cdot</annotation></semantics></math><span id="S14.I7.i4.p1.2.2" class="ltx_text ltx_font_italic"> denots the </span><math id="S14.I7.i4.p1.m9" class="ltx_Math" alttext="{\mathcal{G}}_{d}\times{\mathcal{G}}_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>d</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">{\mathcal{G}}_{d}\times{\mathcal{G}}_{d}</annotation></semantics></math><span id="S14.I7.i4.p1.2.3" class="ltx_text ltx_font_italic">-action on </span><math id="S14.I7.i4.p1.m10" class="ltx_Math" alttext="B_{d}\times P_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>d</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>P</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">B_{d}\times P_{d}</annotation></semantics></math><span id="S14.I7.i4.p1.2.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S14.SS3.SSS5.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S14.SS3.SSS5.p7" class="ltx_para">
<p id="S14.SS3.SSS5.p7.1" class="ltx_p"><span id="S14.SS3.SSS5.p7.1.1" class="ltx_text">The proof, which is similar to that of Proposition <a href="#S14.Thmthm17" title="Proposition 14.17. ‣ 14.3.5. Rigidification ‣ 14.3. Construction of the domain flow categories ‣ 14. The Flow Categories, Multimodules, and Homotopies of Domains ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14.17</span></a>, is based on induction and homotopies over the collar region. For <math id="S14.SS3.SSS5.p7.m1" class="ltx_Math" alttext="d=1" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d=1</annotation></semantics></math>, choose an arbitrary <math id="S14.SS3.SSS5.p7.m2" class="ltx_Math" alttext="\lambda_{1}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\lambda_{1}</annotation></semantics></math> which realizes the local diffeomorphism <math id="S14.SS3.SSS5.p7.m3" class="ltx_Math" alttext="Q_{1}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mn>1</mn></msub><annotation encoding="application/x-tex">Q_{1}</annotation></semantics></math> with <math id="S14.SS3.SSS5.p7.m4" class="ltx_Math" alttext="P_{1}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mn>1</mn></msub><annotation encoding="application/x-tex">P_{1}</annotation></semantics></math>. The formula (<a href="#S14.E6" title="In item 4 ‣ Lemma 14.18. ‣ 14.3.5. Rigidification ‣ 14.3. Construction of the domain flow categories ‣ 14. The Flow Categories, Multimodules, and Homotopies of Domains ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14.6</span></a>) allows us to define <math id="S14.SS3.SSS5.p7.m5" class="ltx_Math" alttext="\lambda_{d}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>d</mi></msub><annotation encoding="application/x-tex">\lambda_{d}</annotation></semantics></math> on boundary. The condition that <math id="S14.SS3.SSS5.p7.m6" class="ltx_Math" alttext="\lambda_{d}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>d</mi></msub><annotation encoding="application/x-tex">\lambda_{d}</annotation></semantics></math> is collared implies that the boundary values of <math id="S14.SS3.SSS5.p7.m7" class="ltx_Math" alttext="\lambda_{d}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>d</mi></msub><annotation encoding="application/x-tex">\lambda_{d}</annotation></semantics></math> determine its values near the boundary. One can then extend to the interior of <math id="S14.SS3.SSS5.p7.m8" class="ltx_math_unparsed" alttext="{}_{\lfloor}B_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>B</mi><msub><mrow></mrow><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">{}_{\lfloor}B_{d}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="S14.SS3.SSS6" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">14.3.6. </span>Stable complex structure</h5>

<div id="S14.SS3.SSS6.p1" class="ltx_para ltx_noindent">
<p id="S14.SS3.SSS6.p1.1" class="ltx_p">As the first step towards constructing the stable complex structure for the AMS construction, we have the following “natural” stable complex structure on the monotone flow category of curves.</p>
</div>
<div id="S14.Thmthm19" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S14.Thmthm19.2" class="ltx_text ltx_font_bold">Proposition 14.19</span></span><span id="S14.Thmthm19.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S14.Thmthm19.p1" class="ltx_para">
<p id="S14.Thmthm19.p1.1" class="ltx_p"><span id="S14.Thmthm19.p1.1.1" class="ltx_text ltx_font_italic">The monotone flow category <math id="S14.Thmthm19.p1.m1" class="ltx_math_unparsed" alttext="{}_{\lfloor}{\mathbb{Dom}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi></mrow><annotation encoding="application/x-tex">{}_{\lfloor}{\mathbb{Dom}}</annotation></semantics></math> (enriched in <math id="S14.Thmthm19.p1.m2" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}</annotation></semantics></math>) admits a natural lift to <math id="S14.Thmthm19.p1.m3" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>ℂ</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S14.SS3.SSS6.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S14.SS3.SSS6.p2" class="ltx_para ltx_noindent">
<p id="S14.SS3.SSS6.p2.1" class="ltx_p"><span id="S14.SS3.SSS6.p2.1.1" class="ltx_text">Notice that the smooth part <math id="S14.SS3.SSS6.p2.m1" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{0,2}^{*}(\mathbb{CP}^{d},d)\subseteq\overline{\mathcal{M}}{}_{0,2}(\mathbb{CP}^{d},d)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>ℂ</mi><msup><mi>ℙ</mi><mi>d</mi></msup><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>∗</mo><mprescripts></mprescripts><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mrow></mrow></mmultiscripts><mo>⊆</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>ℂ</mi><msup><mi>ℙ</mi><mi>d</mi></msup><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mprescripts></mprescripts><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{0,2}^{*}(\mathbb{CP}^{d},d)\subseteq\overline{\mathcal{M}}{}_{0,2}(\mathbb{CP}^{d},d)</annotation></semantics></math> has a <math id="S14.SS3.SSS6.p2.m2" class="ltx_Math" alttext="PGL(d+1)" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">PGL(d+1)</annotation></semantics></math>-invariant complex structure. The constraint at the negative or the positive marking does not affect this complex structure. Notice that the interior of <math id="S14.SS3.SSS6.p2.m3" class="ltx_Math" alttext="B_{d}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>d</mi></msub><annotation encoding="application/x-tex">B_{d}</annotation></semantics></math> has a projection map <math id="S14.SS3.SSS6.p2.m4" class="ltx_math_unparsed" alttext="B_{d}\to\overline{\mathcal{M}}{}_{0,2}(\mathbb{CP}^{d},d)" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>d</mi></msub><mo stretchy="false">→</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>ℂ</mi><msup><mi>ℙ</mi><mi>d</mi></msup><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mprescripts></mprescripts><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">B_{d}\to\overline{\mathcal{M}}{}_{0,2}(\mathbb{CP}^{d},d)</annotation></semantics></math> whose fibers are the <math id="S14.SS3.SSS6.p2.m5" class="ltx_Math" alttext="S^{1}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mn>1</mn></msup><annotation encoding="application/x-tex">S^{1}</annotation></semantics></math>-rotations (which has no fixed point); moreover, the <math id="S14.SS3.SSS6.p2.m6" class="ltx_Math" alttext="{\mathcal{G}}_{d}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>d</mi></msub><annotation encoding="application/x-tex">{\mathcal{G}}_{d}</annotation></semantics></math>-action sends <math id="S14.SS3.SSS6.p2.m7" class="ltx_Math" alttext="S^{1}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mn>1</mn></msup><annotation encoding="application/x-tex">S^{1}</annotation></semantics></math>-orbits to <math id="S14.SS3.SSS6.p2.m8" class="ltx_Math" alttext="S^{1}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mn>1</mn></msup><annotation encoding="application/x-tex">S^{1}</annotation></semantics></math>-orbits. Hence we can define <math id="S14.SS3.SSS6.p2.m9" class="ltx_Math" alttext="I_{B_{d}}\to B_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><msub><mi>B</mi><mi>d</mi></msub></msub><mo stretchy="false">→</mo><msub><mi>B</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">I_{B_{d}}\to B_{d}</annotation></semantics></math> as the pullback of the tangent bundle of <math id="S14.SS3.SSS6.p2.m10" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{0,2}^{*}(\mathbb{CP}^{d},d)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>ℂ</mi><msup><mi>ℙ</mi><mi>d</mi></msup><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>∗</mo><mprescripts></mprescripts><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{0,2}^{*}(\mathbb{CP}^{d},d)</annotation></semantics></math> so that there is a <math id="S14.SS3.SSS6.p2.m11" class="ltx_Math" alttext="{\mathcal{G}}_{d}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>d</mi></msub><annotation encoding="application/x-tex">{\mathcal{G}}_{d}</annotation></semantics></math>-equivariant vector bundle isomorphism</span></p>
<table id="S14.Ex70" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex70.m1" class="ltx_Math" alttext="TB_{d}\oplus\underline{\smash{\mathbb{R}}}\cong I_{B_{d}}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>d</mi></msub></mrow><mo>⊕</mo><munder accentunder="true"><mi>ℝ</mi><mo stretchy="true">¯</mo></munder></mrow><mo>≅</mo><msub><mi>I</mi><msub><mi>B</mi><mi>d</mi></msub></msub></mrow><annotation encoding="application/x-tex">TB_{d}\oplus\underline{\smash{\mathbb{R}}}\cong I_{B_{d}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS3.SSS6.p2.2" class="ltx_p"><span id="S14.SS3.SSS6.p2.2.1" class="ltx_text">where the trivial bundle <math id="S14.SS3.SSS6.p2.m12" class="ltx_Math" alttext="\underline{\smash{\mathbb{R}}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>ℝ</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\mathbb{R}}}</annotation></semantics></math> is the subbundle coming from the <math id="S14.SS3.SSS6.p2.m13" class="ltx_Math" alttext="S^{1}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mn>1</mn></msup><annotation encoding="application/x-tex">S^{1}</annotation></semantics></math>-orbits.</span></p>
</div>
<div id="S14.SS3.SSS6.p3" class="ltx_para ltx_noindent">
<p id="S14.SS3.SSS6.p3.1" class="ltx_p"><span id="S14.SS3.SSS6.p3.1.1" class="ltx_text">Now we consider the structural maps. Given <math id="S14.SS3.SSS6.p3.m1" class="ltx_Math" alttext="d_{1},d_{2}\geq 1" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>d</mi><mn>2</mn></msub><mo>≥</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">d_{1},d_{2}\geq 1</annotation></semantics></math>, recall one has the map</span></p>
<table id="S14.Ex71" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex71.m1" class="ltx_Math" alttext="\zeta_{d_{1},d_{2}}^{B}:B_{d_{1}}\times B_{d_{2}}\to\partial^{d_{1},d_{2}}B_{d_{1}+d_{2}}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>ζ</mi><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub></mrow><mi>B</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>B</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>B</mi><msub><mi>d</mi><mn>2</mn></msub></msub></mrow><mo rspace="0.111em" stretchy="false">→</mo><mrow><msup><mo>∂</mo><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub></mrow></msup><msub><mi>B</mi><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><msub><mi>d</mi><mn>2</mn></msub></mrow></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\zeta_{d_{1},d_{2}}^{B}:B_{d_{1}}\times B_{d_{2}}\to\partial^{d_{1},d_{2}}B_{d_{1}+d_{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS3.SSS6.p3.2" class="ltx_p"><span id="S14.SS3.SSS6.p3.2.1" class="ltx_text">The differential reads</span></p>
<table id="S14.Ex72" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex72.m1" class="ltx_Math" alttext="TB_{d_{1}}\oplus TB_{d_{2}}\to T\partial^{d_{1},d_{2}}B_{d_{1}+d_{2}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><msub><mi>d</mi><mn>1</mn></msub></msub></mrow><mo>⊕</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><msub><mi>d</mi><mn>2</mn></msub></msub></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msup><mo>∂</mo><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub></mrow></msup><msub><mi>B</mi><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><msub><mi>d</mi><mn>2</mn></msub></mrow></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">TB_{d_{1}}\oplus TB_{d_{2}}\to T\partial^{d_{1},d_{2}}B_{d_{1}+d_{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS3.SSS6.p3.3" class="ltx_p"><span id="S14.SS3.SSS6.p3.3.1" class="ltx_text">On the other hand, one can see from the construction of <math id="S14.SS3.SSS6.p3.m2" class="ltx_Math" alttext="\zeta_{d_{1},d_{2}}^{B}" display="inline" intent=":literal"><semantics><msubsup><mi>ζ</mi><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub></mrow><mi>B</mi></msubsup><annotation encoding="application/x-tex">\zeta_{d_{1},d_{2}}^{B}</annotation></semantics></math> that it induces a complex analytic embedding</span></p>
<table id="S14.Ex73" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex73.m1" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{0,2}^{*}(\mathbb{CP}^{d_{1}},d_{1})\times\overline{\mathcal{M}}{}_{0,2}^{*}(\mathbb{CP}^{d_{2}},d_{2})\to\overline{\mathcal{M}}{}_{0,2}^{*}(\mathbb{CP}^{d_{1}+d_{2}},d_{1}+d_{2})." display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>ℂ</mi><msup><mi>ℙ</mi><msub><mi>d</mi><mn>1</mn></msub></msup><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mrow></mrow><mo>∗</mo><mprescripts></mprescripts><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mrow></mrow></mmultiscripts><mo rspace="0.222em">×</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>ℂ</mi><msup><mi>ℙ</mi><msub><mi>d</mi><mn>2</mn></msub></msup><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>∗</mo><mprescripts></mprescripts><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mrow></mrow></mmultiscripts><mo stretchy="false">→</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>ℂ</mi><msup><mi>ℙ</mi><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><msub><mi>d</mi><mn>2</mn></msub></mrow></msup><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mrow></mrow><mo>∗</mo><mprescripts></mprescripts><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mrow></mrow></mmultiscripts><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{0,2}^{*}(\mathbb{CP}^{d_{1}},d_{1})\times\overline{\mathcal{M}}{}_{0,2}^{*}(\mathbb{CP}^{d_{2}},d_{2})\to\overline{\mathcal{M}}{}_{0,2}^{*}(\mathbb{CP}^{d_{1}+d_{2}},d_{1}+d_{2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS3.SSS6.p3.4" class="ltx_p"><span id="S14.SS3.SSS6.p3.4.1" class="ltx_text">Therefore, the map <math id="S14.SS3.SSS6.p3.m3" class="ltx_Math" alttext="\zeta_{d_{1},d_{2}}^{B}" display="inline" intent=":literal"><semantics><msubsup><mi>ζ</mi><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub></mrow><mi>B</mi></msubsup><annotation encoding="application/x-tex">\zeta_{d_{1},d_{2}}^{B}</annotation></semantics></math> respects the corresponding stable complex structures.
∎</span></p>
</div>
</div>
</section>
<section id="S14.SS3.SSS7" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">14.3.7. </span>Orientation and concatenation</h5>

<div id="S14.SS3.SSS7.p1" class="ltx_para ltx_noindent">
<p id="S14.SS3.SSS7.p1.1" class="ltx_p">Recall that each <math id="S14.SS3.SSS7.p1.m1" class="ltx_Math" alttext="B_{d}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>d</mi></msub><annotation encoding="application/x-tex">B_{d}</annotation></semantics></math> is oriented in a canonical way. Hence for <math id="S14.SS3.SSS7.p1.m2" class="ltx_Math" alttext="d=d_{1}+d_{2}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><msub><mi>d</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">d=d_{1}+d_{2}</annotation></semantics></math>, there is a product orientation on <math id="S14.SS3.SSS7.p1.m3" class="ltx_Math" alttext="B_{d_{1}}\times B_{d_{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>B</mi><msub><mi>d</mi><mn>2</mn></msub></msub></mrow><annotation encoding="application/x-tex">B_{d_{1}}\times B_{d_{2}}</annotation></semantics></math>. As <math id="S14.SS3.SSS7.p1.m4" class="ltx_Math" alttext="{\mathcal{G}}_{d}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>d</mi></msub><annotation encoding="application/x-tex">{\mathcal{G}}_{d}</annotation></semantics></math> is a complex Lie group, <math id="S14.SS3.SSS7.p1.m5" class="ltx_Math" alttext="{\mathcal{G}}_{d}\times_{{\mathcal{G}}_{d_{1}}\times{\mathcal{G}}_{d_{2}}}(B_{d_{1}}\times B_{d_{2}})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>d</mi></msub><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>d</mi><mn>2</mn></msub></msub></mrow></msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>B</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>B</mi><msub><mi>d</mi><mn>2</mn></msub></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{G}}_{d}\times_{{\mathcal{G}}_{d_{1}}\times{\mathcal{G}}_{d_{2}}}(B_{d_{1}}\times B_{d_{2}})</annotation></semantics></math> has the induced product orientation. On the other hand, it is a codimension one boundary of <math id="S14.SS3.SSS7.p1.m6" class="ltx_Math" alttext="B_{d}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>d</mi></msub><annotation encoding="application/x-tex">B_{d}</annotation></semantics></math>, hence has a corresponding boundary orientation.</p>
</div>
<div id="S14.Thmthm20" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S14.Thmthm20.2" class="ltx_text ltx_font_bold">Lemma 14.20</span></span><span id="S14.Thmthm20.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S14.Thmthm20.p1" class="ltx_para">
<p id="S14.Thmthm20.p1.1" class="ltx_p"><span id="S14.Thmthm20.p1.1.1" class="ltx_text ltx_font_italic">The product orientation and the boundary orientation coincide.</span></p>
</div>
</div>
<div id="S14.SS3.SSS7.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S14.SS3.SSS7.p2" class="ltx_para ltx_noindent">
<p id="S14.SS3.SSS7.p2.1" class="ltx_p"><span id="S14.SS3.SSS7.p2.1.1" class="ltx_text">We only consider the interior of the moduli spaces <math id="S14.SS3.SSS7.p2.m1" class="ltx_Math" alttext="B_{d_{1}}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><msub><mi>d</mi><mn>1</mn></msub></msub><annotation encoding="application/x-tex">B_{d_{1}}</annotation></semantics></math> and <math id="S14.SS3.SSS7.p2.m2" class="ltx_Math" alttext="B_{d_{2}}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><msub><mi>d</mi><mn>2</mn></msub></msub><annotation encoding="application/x-tex">B_{d_{2}}</annotation></semantics></math>. Recall that <math id="S14.SS3.SSS7.p2.m3" class="ltx_Math" alttext="B_{d_{1}}/S^{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo>/</mo><msup><mi>S</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">B_{d_{1}}/S^{1}</annotation></semantics></math> and <math id="S14.SS3.SSS7.p2.m4" class="ltx_Math" alttext="B_{d_{2}}/S^{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><msub><mi>d</mi><mn>2</mn></msub></msub><mo>/</mo><msup><mi>S</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">B_{d_{2}}/S^{1}</annotation></semantics></math> are open subsets of complex manifolds. There are also orientation-preserving gluing maps</span></p>
<table id="S14.Ex74" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex74.m1" class="ltx_Math" alttext="B_{d_{1}}/S^{1}\times\Delta\times B_{d_{2}}/S^{1}\to B_{d}/S^{1}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>B</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo>/</mo><msup><mi>S</mi><mn>1</mn></msup></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi mathvariant="normal">Δ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>B</mi><msub><mi>d</mi><mn>2</mn></msub></msub></mrow><mo>/</mo><msup><mi>S</mi><mn>1</mn></msup></mrow><mo stretchy="false">→</mo><mrow><msub><mi>B</mi><mi>d</mi></msub><mo>/</mo><msup><mi>S</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">B_{d_{1}}/S^{1}\times\Delta\times B_{d_{2}}/S^{1}\to B_{d}/S^{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS3.SSS7.p2.2" class="ltx_p"><span id="S14.SS3.SSS7.p2.2.1" class="ltx_text">where <math id="S14.SS3.SSS7.p2.m5" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math> is a small disk of gluing parameters. By explicitly writing down the gluing map in terms of representative and the effect of reparametrizations, one can see that the induced map</span></p>
<table id="S14.Ex75" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex75.m1" class="ltx_Math" alttext="B_{d_{1}}\times[0,\epsilon)\times B_{d_{2}}\to B_{d}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>B</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi>ϵ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><msub><mi>B</mi><msub><mi>d</mi><mn>2</mn></msub></msub></mrow><mo stretchy="false">→</mo><msub><mi>B</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">B_{d_{1}}\times[0,\epsilon)\times B_{d_{2}}\to B_{d}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS3.SSS7.p2.3" class="ltx_p"><span id="S14.SS3.SSS7.p2.3.1" class="ltx_text">is orientation preserving. Because all <math id="S14.SS3.SSS7.p2.m6" class="ltx_Math" alttext="B_{d}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>d</mi></msub><annotation encoding="application/x-tex">B_{d}</annotation></semantics></math> are odd-dimensional, our convention on induced boundary orientation leads to the conclusion.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="S14.SS4" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">14.4. </span>Multimodules and homotopies for smooth domains</h4>

<div id="S14.SS4.p1" class="ltx_para ltx_noindent">
<p id="S14.SS4.p1.1" class="ltx_p">In this subsection, we describe the multimodules of domain curves which will be used for the AMS construction for moduli spaces for pair-of-pants products.</p>
</div>
<div id="S14.SS4.p2" class="ltx_para ltx_noindent">
<p id="S14.SS4.p2.1" class="ltx_p">We would like to specify a class of constructions as follows. Fix a common outercollaring width. Choose (independently) lifts of the outercollared domain flow category <math id="S14.SS4.p2.m1" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}_{1},\ldots,{}_{\lfloor}\mathbb{Dom}_{m},{}_{\lfloor}\mathbb{Dom}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msub><mrow></mrow><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msub><mrow></mrow><mi>m</mi></msub><mo>,</mo><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}_{1},\ldots,{}_{\lfloor}\mathbb{Dom}_{m},{}_{\lfloor}\mathbb{Dom}^{\prime}</annotation></semantics></math> to <math id="S14.SS4.p2.m2" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>ℂ</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}</annotation></semantics></math>.<span id="footnote20" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">20</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">20</sup>
                <span class="ltx_tag ltx_tag_note">20</span>
                
                
                
              When we treat the cigar bimodule and the Poincaré duality multimodule, one does not need <math id="footnote20.m1" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\mathbb{Dom}}}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mrow><mi>𝔻</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕠</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕞</mi></mrow><mo stretchy="true">¯</mo></munder><msup><mrow></mrow><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\mathbb{Dom}}}^{\prime}</annotation></semantics></math>. However the method can be easily modified to suit those cases.</span></span></span></p>
</div>
<div id="S14.SS4.p3" class="ltx_para ltx_noindent">
<ol id="S14.I8" class="ltx_enumerate">
<li id="S14.I8.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S14.I8.i1.p1" class="ltx_para ltx_noindent">
<p id="S14.I8.i1.p1.1" class="ltx_p">For any smooth genus zero curve <math id="S14.I8.i1.p1.m1" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> with <math id="S14.I8.i1.p1.m2" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> negative cylindrical ends and one positive cylindrical end, we construct a class of monotone multimodule <math id="S14.I8.i1.p1.m3" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}^{\Sigma}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mi mathvariant="normal">Σ</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}^{\Sigma}</annotation></semantics></math> over <math id="S14.I8.i1.p1.m4" class="ltx_math_unparsed" alttext="({}_{\lfloor}\mathbb{Dom}_{1},\ldots,{}_{\lfloor}\mathbb{Dom}_{m};{}_{\lfloor}\mathbb{Dom}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝔻</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mi>𝕠</mi><msub><mi>𝕞</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mmultiscripts><mi>𝔻</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mi>𝕠</mi><msub><mi>𝕞</mi><mi>m</mi></msub><mo>;</mo><mmultiscripts><mi>𝔻</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mi>𝕠</mi><msup><mi>𝕞</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({}_{\lfloor}\mathbb{Dom}_{1},\ldots,{}_{\lfloor}\mathbb{Dom}_{m};{}_{\lfloor}\mathbb{Dom}^{\prime})</annotation></semantics></math> enriched in <math id="S14.I8.i1.p1.m5" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>ℂ</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}</annotation></semantics></math>.</p>
</div></li>
<li id="S14.I8.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S14.I8.i2.p1" class="ltx_para">
<p id="S14.I8.i2.p1.1" class="ltx_p">Let <math id="S14.I8.i2.p1.m1" class="ltx_Math" alttext="\Sigma_{t}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\Sigma_{t}</annotation></semantics></math>, <math id="S14.I8.i2.p1.m2" class="ltx_Math" alttext="t\in[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[0,1]</annotation></semantics></math> be a smooth family of smooth genus zero curves with <math id="S14.I8.i2.p1.m3" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> negative cylindrical ends and one positive cylindrical end. Let <math id="S14.I8.i2.p1.m4" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}^{\Sigma_{0}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><msub><mi mathvariant="normal">Σ</mi><mn>0</mn></msub></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}^{\Sigma_{0}}</annotation></semantics></math>, <math id="S14.I8.i2.p1.m5" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}^{\Sigma_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><msub><mi mathvariant="normal">Σ</mi><mn>1</mn></msub></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}^{\Sigma_{1}}</annotation></semantics></math> be two monotone multimodules as above. We construct a class of homotopies <math id="S14.I8.i2.p1.m6" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}^{\Sigma_{I}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><msub><mi mathvariant="normal">Σ</mi><mi>I</mi></msub></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}^{\Sigma_{I}}</annotation></semantics></math> from <math id="S14.I8.i2.p1.m7" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}^{\Sigma_{0}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><msub><mi mathvariant="normal">Σ</mi><mn>0</mn></msub></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}^{\Sigma_{0}}</annotation></semantics></math> to <math id="S14.I8.i2.p1.m8" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}^{\Sigma_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><msub><mi mathvariant="normal">Σ</mi><mn>1</mn></msub></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}^{\Sigma_{1}}</annotation></semantics></math> enriched in <math id="S14.I8.i2.p1.m9" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>ℂ</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
<div id="S14.SS4.p4" class="ltx_para ltx_noindent">
<p id="S14.SS4.p4.1" class="ltx_p">We first describe the underlying posets of the monotone multimodule. For each <math id="S14.SS4.p4.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>, define</p>
<table id="S14.Ex76" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex76.m1" class="ltx_math_unparsed" alttext="A_{d}^{\Sigma}:=\left\{(r_{1},\ldots,r_{m};d_{0};r^{\prime})\ \left|\begin{array}[]{c}r_{j}\in A_{d_{j}},\ j=1,\ldots,m,\ r^{\prime}\in A_{d^{\prime}},\ d_{j},d^{\prime}&gt;0,\ d_{0}\geq 0,\\
d_{1}+\cdots+d_{m}+d_{0}+d^{\prime}=d\end{array}\right.\right\}." display="block" intent=":literal"><semantics><mrow><msubsup><mi>A</mi><mi>d</mi><mi mathvariant="normal">Σ</mi></msubsup><mo>:=</mo><mrow><mo>{</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>r</mi><mi>m</mi></msub><mo>;</mo><msub><mi>d</mi><mn>0</mn></msub><mo>;</mo><msup><mi>r</mi><mo>′</mo></msup><mo rspace="0.500em" stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em">|</mo><mtable displaystyle="true" rowspacing="2.0pt"><mtr><mtd><mrow><mi>r</mi><msub><mrow></mrow><mi>j</mi></msub><mo>∈</mo><mi>A</mi><msub><mrow></mrow><msub><mi>d</mi><mi>j</mi></msub></msub><mo rspace="0.667em">,</mo><mi>j</mi><mo>=</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>m</mi><mo rspace="0.667em">,</mo><mi>r</mi><msup><mrow></mrow><mo>′</mo></msup><mo>∈</mo><mi>A</mi><msub><mrow></mrow><msup><mi>d</mi><mo>′</mo></msup></msub><mo rspace="0.667em">,</mo><mi>d</mi><msub><mrow></mrow><mi>j</mi></msub><mo>,</mo><mi>d</mi><msup><mrow></mrow><mo>′</mo></msup><mo>&gt;</mo><mn>0</mn><mo rspace="0.667em">,</mo><mi>d</mi><msub><mrow></mrow><mn>0</mn></msub><mo>≥</mo><mn>0</mn><mo>,</mo></mrow></mtd></mtr><mtr><mtd><mrow><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>d</mi><mi>m</mi></msub><mo>+</mo><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><msup><mi>d</mi><mo>′</mo></msup></mrow><mo>=</mo><mi>d</mi></mrow></mtd></mtr></mtable><mo>}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">A_{d}^{\Sigma}:=\left\{(r_{1},\ldots,r_{m};d_{0};r^{\prime})\ \left|\begin{array}[]{c}r_{j}\in A_{d_{j}},\ j=1,\ldots,m,\ r^{\prime}\in A_{d^{\prime}},\ d_{j},d^{\prime}&gt;0,\ d_{0}\geq 0,\\
d_{1}+\cdots+d_{m}+d_{0}+d^{\prime}=d\end{array}\right.\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS4.p4.2" class="ltx_p">Then there are the natural poset maps</p>
<table id="S14.Ex77" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex77.m1" class="ltx_Math" alttext="\prod_{j=1}^{m}A_{d_{j}}\times A_{d}^{\Sigma}\times A_{d^{\prime}}\to A_{d_{1}+\cdots+d_{m}+d+d^{\prime}}^{\Sigma}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><mrow><msub><mi>A</mi><msub><mi>d</mi><mi>j</mi></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>A</mi><mi>d</mi><mi mathvariant="normal">Σ</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>A</mi><msup><mi>d</mi><mo>′</mo></msup></msub></mrow></mrow><mo stretchy="false">→</mo><msubsup><mi>A</mi><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>d</mi><mi>m</mi></msub><mo>+</mo><mi>d</mi><mo>+</mo><msup><mi>d</mi><mo>′</mo></msup></mrow><mi mathvariant="normal">Σ</mi></msubsup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\prod_{j=1}^{m}A_{d_{j}}\times A_{d}^{\Sigma}\times A_{d^{\prime}}\to A_{d_{1}+\cdots+d_{m}+d+d^{\prime}}^{\Sigma}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS4.p4.3" class="ltx_p">These are the poset maps underlying the structural maps of the monotone multimodule we will define.</p>
</div>
<div id="S14.SS4.p5" class="ltx_para ltx_noindent">
<p id="S14.SS4.p5.1" class="ltx_p">Now we describe, for each <math id="S14.SS4.p5.m1" class="ltx_Math" alttext="d\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d\geq 0</annotation></semantics></math>, an object <math id="S14.SS4.p5.m2" class="ltx_Math" alttext="{\mathcal{C}}_{d}^{\Sigma}=({\mathcal{G}}_{d}^{\Sigma},B_{d}^{\Sigma},C_{d}^{\Sigma})\in\underline{\smash{\bf Curve}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>d</mi><mi mathvariant="normal">Σ</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>d</mi><mi mathvariant="normal">Σ</mi></msubsup><mo>,</mo><msubsup><mi>B</mi><mi>d</mi><mi mathvariant="normal">Σ</mi></msubsup><mo>,</mo><msubsup><mi>C</mi><mi>d</mi><mi mathvariant="normal">Σ</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>∈</mo><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder></mrow><annotation encoding="application/x-tex">{\mathcal{C}}_{d}^{\Sigma}=({\mathcal{G}}_{d}^{\Sigma},B_{d}^{\Sigma},C_{d}^{\Sigma})\in\underline{\smash{\bf Curve}}</annotation></semantics></math>. We set <math id="S14.SS4.p5.m3" class="ltx_Math" alttext="{\mathcal{G}}_{d}^{\Sigma}=PGL^{+}(d+1)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>d</mi><mi mathvariant="normal">Σ</mi></msubsup><mo>=</mo><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{G}}_{d}^{\Sigma}=PGL^{+}(d+1)</annotation></semantics></math> and <math id="S14.SS4.p5.m4" class="ltx_Math" alttext="G_{d}^{\Sigma}=U^{+}(d)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>G</mi><mi>d</mi><mi mathvariant="normal">Σ</mi></msubsup><mo>=</mo><mrow><msup><mi>U</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">G_{d}^{\Sigma}=U^{+}(d)</annotation></semantics></math>, the same as before. For the space <math id="S14.SS4.p5.m5" class="ltx_Math" alttext="B_{d}^{\Sigma}" display="inline" intent=":literal"><semantics><msubsup><mi>B</mi><mi>d</mi><mi mathvariant="normal">Σ</mi></msubsup><annotation encoding="application/x-tex">B_{d}^{\Sigma}</annotation></semantics></math>, consider the moduli space of holomorphic maps <math id="S14.SS4.p5.m6" class="ltx_Math" alttext="u:\Sigma\to\mathbb{P}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">u:\Sigma\to\mathbb{P}^{d}</annotation></semantics></math> of degree <math id="S14.SS4.p5.m7" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>. Let</p>
<table id="S14.Ex78" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex78.m1" class="ltx_Math" alttext="{\mathcal{M}}^{\Sigma}({\mathbb{P}}^{d},d)" display="block" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi mathvariant="normal">Σ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>ℙ</mi><mi>d</mi></msup><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{M}}^{\Sigma}({\mathbb{P}}^{d},d)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS4.p5.2" class="ltx_p">be the subspace satisfying the positive constraint</p>
<table id="S14.Ex79" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex79.m1" class="ltx_Math" alttext="u(z_{+})=[0,\ldots,0,1]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">u(z_{+})=[0,\ldots,0,1].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS4.p5.3" class="ltx_p">Let <math id="S14.SS4.p5.m8" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}^{\Sigma}({\mathbb{P}}^{d},d)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mrow><mo stretchy="false">(</mo><msup><mi>ℙ</mi><mi>d</mi></msup><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mprescripts></mprescripts><mrow></mrow><mi mathvariant="normal">Σ</mi></mmultiscripts></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}^{\Sigma}({\mathbb{P}}^{d},d)</annotation></semantics></math> be the natural compactification (where cylindrical bubbles are taken modulo only translation but not rotation). Let</p>
<table id="S14.Ex80" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex80.m1" class="ltx_math_unparsed" alttext="B^{\Sigma}_{d}\subseteq\overline{\mathcal{M}}{}^{\Sigma}(\mathbb{P}^{d},d)" display="block" intent=":literal"><semantics><mrow><msubsup><mi>B</mi><mi>d</mi><mi mathvariant="normal">Σ</mi></msubsup><mo>⊆</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mrow><mo stretchy="false">(</mo><msup><mi>ℙ</mi><mi>d</mi></msup><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mprescripts></mprescripts><mrow></mrow><mi mathvariant="normal">Σ</mi></mmultiscripts></mrow><annotation encoding="application/x-tex">B^{\Sigma}_{d}\subseteq\overline{\mathcal{M}}{}^{\Sigma}(\mathbb{P}^{d},d)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS4.p5.4" class="ltx_p">be the subset of maps whose images are not entirely contained in any hyperplane. Notice that <math id="S14.SS4.p5.m9" class="ltx_Math" alttext="B_{d}^{\Sigma}" display="inline" intent=":literal"><semantics><msubsup><mi>B</mi><mi>d</mi><mi mathvariant="normal">Σ</mi></msubsup><annotation encoding="application/x-tex">B_{d}^{\Sigma}</annotation></semantics></math> is naturally stratified by the poset <math id="S14.SS4.p5.m10" class="ltx_Math" alttext="A_{d}^{\Sigma}" display="inline" intent=":literal"><semantics><msubsup><mi>A</mi><mi>d</mi><mi mathvariant="normal">Σ</mi></msubsup><annotation encoding="application/x-tex">A_{d}^{\Sigma}</annotation></semantics></math>. Moreover, <math id="S14.SS4.p5.m11" class="ltx_Math" alttext="{\mathcal{G}}_{d}^{\Sigma}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>d</mi><mi mathvariant="normal">Σ</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{G}}_{d}^{\Sigma}</annotation></semantics></math> acts on <math id="S14.SS4.p5.m12" class="ltx_Math" alttext="B_{d}^{\Sigma}" display="inline" intent=":literal"><semantics><msubsup><mi>B</mi><mi>d</mi><mi mathvariant="normal">Σ</mi></msubsup><annotation encoding="application/x-tex">B_{d}^{\Sigma}</annotation></semantics></math>. Let <math id="S14.SS4.p5.m13" class="ltx_Math" alttext="C_{d}^{\Sigma}\to B_{d}^{\Sigma}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>C</mi><mi>d</mi><mi mathvariant="normal">Σ</mi></msubsup><mo stretchy="false">→</mo><msubsup><mi>B</mi><mi>d</mi><mi mathvariant="normal">Σ</mi></msubsup></mrow><annotation encoding="application/x-tex">C_{d}^{\Sigma}\to B_{d}^{\Sigma}</annotation></semantics></math> be the universal curve, which is a <math id="S14.SS4.p5.m14" class="ltx_Math" alttext="{\mathcal{G}}_{d}^{\Sigma}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>d</mi><mi mathvariant="normal">Σ</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{G}}_{d}^{\Sigma}</annotation></semantics></math>-equivariant family. Define</p>
<table id="S14.Ex81" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex81.m1" class="ltx_Math" alttext="{\mathcal{C}}_{d}^{\Sigma}=({\mathcal{G}}_{d}^{\Sigma},B_{d}^{\Sigma},C_{d}^{\Sigma})" display="block" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>d</mi><mi mathvariant="normal">Σ</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>d</mi><mi mathvariant="normal">Σ</mi></msubsup><mo>,</mo><msubsup><mi>B</mi><mi>d</mi><mi mathvariant="normal">Σ</mi></msubsup><mo>,</mo><msubsup><mi>C</mi><mi>d</mi><mi mathvariant="normal">Σ</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{C}}_{d}^{\Sigma}=({\mathcal{G}}_{d}^{\Sigma},B_{d}^{\Sigma},C_{d}^{\Sigma})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS4.p5.5" class="ltx_p">which is an object in <math id="S14.SS4.p5.m15" class="ltx_Math" alttext="\underline{\smash{\bf Curve}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf Curve}}</annotation></semantics></math>.</p>
</div>
<section id="S14.SS4.SSS1" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">14.4.1. </span>Structural maps</h5>

<div id="S14.SS4.SSS1.p1" class="ltx_para ltx_noindent">
<p id="S14.SS4.SSS1.p1.1" class="ltx_p">To describe the structural maps, we need to choose the corresponding lateral lines on <math id="S14.SS4.SSS1.p1.m1" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math>.<span id="footnote21" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">21</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">21</sup>
                  <span class="ltx_tag ltx_tag_note">21</span>
                  
                  
                  
                Notice that there are homotopically non-equivalent choices of lateral lines. The comparison between two such choices of lateral lines on <math id="footnote21.m1" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> will be given in Subsection <a href="#S20.SS4" title="20.4. Multimodules ‣ 20. Comparing Non-homotopic Choices ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">20.4</span></a>.</span></span></span> We also need to restrict to the case that there is only one output (in the positive version). The morphisms we need to describe are</p>
<table id="S14.Ex82" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex82.m1" class="ltx_Math" alttext="\prod_{j=1}^{m}{\mathcal{C}}_{d_{j}}\times{\mathcal{C}}_{d}^{\Sigma}\to{\mathcal{C}}_{d_{1}+\cdots+d_{m}+d}^{\Sigma}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><msub><mi>d</mi><mi>j</mi></msub></msub></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>d</mi><mi mathvariant="normal">Σ</mi></msubsup></mrow><mo stretchy="false">→</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>d</mi><mi>m</mi></msub><mo>+</mo><mi>d</mi></mrow><mi mathvariant="normal">Σ</mi></msubsup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\prod_{j=1}^{m}{\mathcal{C}}_{d_{j}}\times{\mathcal{C}}_{d}^{\Sigma}\to{\mathcal{C}}_{d_{1}+\cdots+d_{m}+d}^{\Sigma}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS4.SSS1.p1.2" class="ltx_p">and</p>
<table id="S14.Ex83" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex83.m1" class="ltx_Math" alttext="{\mathcal{C}}_{d}^{\Sigma}\times{\mathcal{C}}_{d^{\prime}}\to{\mathcal{C}}_{d+d^{\prime}}^{\Sigma}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>d</mi><mi mathvariant="normal">Σ</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><msup><mi>d</mi><mo>′</mo></msup></msub></mrow><mo stretchy="false">→</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mi>d</mi><mo>+</mo><msup><mi>d</mi><mo>′</mo></msup></mrow><mi mathvariant="normal">Σ</mi></msubsup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{C}}_{d}^{\Sigma}\times{\mathcal{C}}_{d^{\prime}}\to{\mathcal{C}}_{d+d^{\prime}}^{\Sigma}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS4.SSS1.p1.3" class="ltx_p">There is not much difficulty in defining the second map, which is similar to the previous case. On the other hand, there is a subtlety in defining the first structural map. In fact, the underlying group map is not well-defined; it depends on the ordering of the cylindrical end. However, different choices are related by conjugations.</p>
</div>
<div id="S14.SS4.SSS1.p2" class="ltx_para ltx_noindent">
<p id="S14.SS4.SSS1.p2.1" class="ltx_p">Assume for simplicity <math id="S14.SS4.SSS1.p2.m1" class="ltx_Math" alttext="l=2" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">l=2</annotation></semantics></math>, which is the case of the pair-of-pants product. For any <math id="S14.SS4.SSS1.p2.m2" class="ltx_Math" alttext="d_{1},d_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">d_{1},d_{2}</annotation></semantics></math>, we define</p>
<table id="S14.Ex84" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex84.m1" class="ltx_Math" alttext="{\mathcal{G}}_{d_{1}}\times{\mathcal{G}}_{d_{2}}\times{\mathcal{G}}_{d}^{\Sigma}\to{\mathcal{G}}_{d_{1}+d_{2}+d}^{\Sigma}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>d</mi><mn>2</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>d</mi><mi mathvariant="normal">Σ</mi></msubsup></mrow><mo stretchy="false">→</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><msub><mi>d</mi><mn>2</mn></msub><mo>+</mo><mi>d</mi></mrow><mi mathvariant="normal">Σ</mi></msubsup></mrow><annotation encoding="application/x-tex">{\mathcal{G}}_{d_{1}}\times{\mathcal{G}}_{d_{2}}\times{\mathcal{G}}_{d}^{\Sigma}\to{\mathcal{G}}_{d_{1}+d_{2}+d}^{\Sigma}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS4.SSS1.p2.2" class="ltx_p">to be the same morphism described before. More explicity, when <math id="S14.SS4.SSS1.p2.m3" class="ltx_Math" alttext="d^{1}=d^{2}=d=2" display="inline" intent=":literal"><semantics><mrow><msup><mi>d</mi><mn>1</mn></msup><mo>=</mo><msup><mi>d</mi><mn>2</mn></msup><mo>=</mo><mi>d</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">d^{1}=d^{2}=d=2</annotation></semantics></math>, the map is</p>
<table id="S14.SS4.SSS1.p2.3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.SS4.SSS1.p2.m4" class="ltx_Math" alttext="\left(\left[\begin{array}[]{ccc}a_{11}&amp;a_{12}&amp;0\\
a_{21}&amp;a_{22}&amp;0\\
a_{31}&amp;a_{32}&amp;1\end{array}\right],\left[\begin{array}[]{ccc}b_{11}&amp;b_{12}&amp;0\\
b_{21}&amp;b_{22}&amp;0\\
b_{31}&amp;b_{32}&amp;1\end{array}\right],\left[\begin{array}[]{ccc}c_{11}&amp;c_{12}&amp;0\\
c_{21}&amp;c_{22}&amp;0\\
c_{31}&amp;c_{32}&amp;1\end{array}\right]\right)\\
\mapsto\left[\begin{array}[]{ccccccc}a_{11}&amp;a_{12}&amp;0&amp;0&amp;0&amp;0&amp;0\\
a_{21}&amp;a_{22}&amp;0&amp;0&amp;0&amp;0&amp;0\\
0&amp;0&amp;b_{11}&amp;b_{12}&amp;0&amp;0&amp;0\\
0&amp;0&amp;b_{21}&amp;b_{22}&amp;0&amp;0&amp;0\\
0&amp;0&amp;0&amp;0&amp;c_{11}&amp;c_{12}&amp;0\\
0&amp;0&amp;0&amp;0&amp;c_{21}&amp;c_{22}&amp;0\\
a_{31}&amp;a_{32}&amp;b_{31}&amp;b_{32}&amp;c_{31}&amp;c_{32}&amp;1\end{array}\right]." display="block" intent=":literal"><semantics><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mo>(</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd><msub><mi>a</mi><mn>11</mn></msub></mtd><mtd><msub><mi>a</mi><mn>12</mn></msub></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><msub><mi>a</mi><mn>21</mn></msub></mtd><mtd><msub><mi>a</mi><mn>22</mn></msub></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><msub><mi>a</mi><mn>31</mn></msub></mtd><mtd><msub><mi>a</mi><mn>32</mn></msub></mtd><mtd><mn>1</mn></mtd></mtr></mtable><mo>]</mo></mrow><mo>,</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd><msub><mi>b</mi><mn>11</mn></msub></mtd><mtd><msub><mi>b</mi><mn>12</mn></msub></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><msub><mi>b</mi><mn>21</mn></msub></mtd><mtd><msub><mi>b</mi><mn>22</mn></msub></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><msub><mi>b</mi><mn>31</mn></msub></mtd><mtd><msub><mi>b</mi><mn>32</mn></msub></mtd><mtd><mn>1</mn></mtd></mtr></mtable><mo>]</mo></mrow><mo>,</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd><msub><mi>c</mi><mn>11</mn></msub></mtd><mtd><msub><mi>c</mi><mn>12</mn></msub></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><msub><mi>c</mi><mn>21</mn></msub></mtd><mtd><msub><mi>c</mi><mn>22</mn></msub></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><msub><mi>c</mi><mn>31</mn></msub></mtd><mtd><msub><mi>c</mi><mn>32</mn></msub></mtd><mtd><mn>1</mn></mtd></mtr></mtable><mo>]</mo></mrow><mo>)</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mphantom></mphantom><mo stretchy="false">↦</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd><msub><mi>a</mi><mn>11</mn></msub></mtd><mtd><msub><mi>a</mi><mn>12</mn></msub></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><msub><mi>a</mi><mn>21</mn></msub></mtd><mtd><msub><mi>a</mi><mn>22</mn></msub></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><msub><mi>b</mi><mn>11</mn></msub></mtd><mtd><msub><mi>b</mi><mn>12</mn></msub></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><msub><mi>b</mi><mn>21</mn></msub></mtd><mtd><msub><mi>b</mi><mn>22</mn></msub></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><msub><mi>c</mi><mn>11</mn></msub></mtd><mtd><msub><mi>c</mi><mn>12</mn></msub></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><msub><mi>c</mi><mn>21</mn></msub></mtd><mtd><msub><mi>c</mi><mn>22</mn></msub></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><msub><mi>a</mi><mn>31</mn></msub></mtd><mtd><msub><mi>a</mi><mn>32</mn></msub></mtd><mtd><msub><mi>b</mi><mn>31</mn></msub></mtd><mtd><msub><mi>b</mi><mn>32</mn></msub></mtd><mtd><msub><mi>c</mi><mn>31</mn></msub></mtd><mtd><msub><mi>c</mi><mn>32</mn></msub></mtd><mtd><mn>1</mn></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\left(\left[\begin{array}[]{ccc}a_{11}&amp;a_{12}&amp;0\\
a_{21}&amp;a_{22}&amp;0\\
a_{31}&amp;a_{32}&amp;1\end{array}\right],\left[\begin{array}[]{ccc}b_{11}&amp;b_{12}&amp;0\\
b_{21}&amp;b_{22}&amp;0\\
b_{31}&amp;b_{32}&amp;1\end{array}\right],\left[\begin{array}[]{ccc}c_{11}&amp;c_{12}&amp;0\\
c_{21}&amp;c_{22}&amp;0\\
c_{31}&amp;c_{32}&amp;1\end{array}\right]\right)\\
\mapsto\left[\begin{array}[]{ccccccc}a_{11}&amp;a_{12}&amp;0&amp;0&amp;0&amp;0&amp;0\\
a_{21}&amp;a_{22}&amp;0&amp;0&amp;0&amp;0&amp;0\\
0&amp;0&amp;b_{11}&amp;b_{12}&amp;0&amp;0&amp;0\\
0&amp;0&amp;b_{21}&amp;b_{22}&amp;0&amp;0&amp;0\\
0&amp;0&amp;0&amp;0&amp;c_{11}&amp;c_{12}&amp;0\\
0&amp;0&amp;0&amp;0&amp;c_{21}&amp;c_{22}&amp;0\\
a_{31}&amp;a_{32}&amp;b_{31}&amp;b_{32}&amp;c_{31}&amp;c_{32}&amp;1\end{array}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S14.SS4.SSS1.p3" class="ltx_para ltx_noindent">
<p id="S14.SS4.SSS1.p3.1" class="ltx_p">Similarly, we also define the concatenation map. Consider the concatenation at the two negative ends of <math id="S14.SS4.SSS1.p3.m1" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math>. Let <math id="S14.SS4.SSS1.p3.m2" class="ltx_Math" alttext="\phi^{j}\in B_{d^{j}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ϕ</mi><mi>j</mi></msup><mo>∈</mo><msub><mi>B</mi><msup><mi>d</mi><mi>j</mi></msup></msub></mrow><annotation encoding="application/x-tex">\phi^{j}\in B_{d^{j}}</annotation></semantics></math>, <math id="S14.SS4.SSS1.p3.m3" class="ltx_Math" alttext="j=1,2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">j=1,2</annotation></semantics></math>, be represented by maps <math id="S14.SS4.SSS1.p3.m4" class="ltx_Math" alttext="u^{j}:\Sigma^{j}\to\mathbb{P}^{d^{j}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>u</mi><mi>j</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi mathvariant="normal">Σ</mi><mi>j</mi></msup><mo stretchy="false">→</mo><msup><mi>ℙ</mi><msup><mi>d</mi><mi>j</mi></msup></msup></mrow></mrow><annotation encoding="application/x-tex">u^{j}:\Sigma^{j}\to\mathbb{P}^{d^{j}}</annotation></semantics></math>. Then they pullback line bundles <math id="S14.SS4.SSS1.p3.m5" class="ltx_Math" alttext="L_{u^{1}},L_{u^{2}}\to\Sigma" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><msup><mi>u</mi><mn>1</mn></msup></msub><mo>,</mo><mrow><msub><mi>L</mi><msup><mi>u</mi><mn>2</mn></msup></msub><mo stretchy="false">→</mo><mi mathvariant="normal">Σ</mi></mrow></mrow><annotation encoding="application/x-tex">L_{u^{1}},L_{u^{2}}\to\Sigma</annotation></semantics></math> with frames</p>
<table id="S14.Ex85" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex85.m1" class="ltx_Math" alttext="(h_{0}^{1},\ldots,h_{d^{1}}^{1}),\ (h_{0}^{2},\ldots,h_{d^{2}}^{2})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><msubsup><mi>h</mi><mn>0</mn><mn>1</mn></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>h</mi><msup><mi>d</mi><mn>1</mn></msup><mn>1</mn></msubsup><mo stretchy="false">)</mo></mrow><mo rspace="0.667em">,</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>h</mi><mn>0</mn><mn>2</mn></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>h</mi><msup><mi>d</mi><mn>2</mn></msup><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(h_{0}^{1},\ldots,h_{d^{1}}^{1}),\ (h_{0}^{2},\ldots,h_{d^{2}}^{2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS4.SSS1.p3.2" class="ltx_p">The positive constraint is that</p>
<table id="S14.EGx49" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S14.Ex86"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S14.Ex86.m1" class="ltx_Math" alttext="\displaystyle\ h_{0}^{1}(z_{+})=\cdots=h_{d^{1}-1}^{1}(z_{+})=0,\ " display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>h</mi><mn>0</mn><mn>1</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">=</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">=</mo><mrow><msubsup><mi>h</mi><mrow><msup><mi>d</mi><mn>1</mn></msup><mo>−</mo><mn>1</mn></mrow><mn>1</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ h_{0}^{1}(z_{+})=\cdots=h_{d^{1}-1}^{1}(z_{+})=0,\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S14.Ex86.m2" class="ltx_Math" alttext="\displaystyle\ h_{0}^{2}(z_{+})=\cdots=h_{d^{2}-1}^{2}(z_{+})=0." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>h</mi><mn>0</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">=</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">=</mo><mrow><msubsup><mi>h</mi><mrow><msup><mi>d</mi><mn>2</mn></msup><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ h_{0}^{2}(z_{+})=\cdots=h_{d^{2}-1}^{2}(z_{+})=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS4.SSS1.p3.3" class="ltx_p">On the other hand, suppose the point <math id="S14.SS4.SSS1.p3.m6" class="ltx_Math" alttext="\phi\in B_{d}^{\Sigma}" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>∈</mo><msubsup><mi>B</mi><mi>d</mi><mi mathvariant="normal">Σ</mi></msubsup></mrow><annotation encoding="application/x-tex">\phi\in B_{d}^{\Sigma}</annotation></semantics></math> is represented by a map <math id="S14.SS4.SSS1.p3.m7" class="ltx_Math" alttext="u:\Sigma\to{\mathbb{P}}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">u:\Sigma\to{\mathbb{P}}^{d}</annotation></semantics></math>, which pulls back a bundle <math id="S14.SS4.SSS1.p3.m8" class="ltx_Math" alttext="L_{u}\to\Sigma" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>u</mi></msub><mo stretchy="false">→</mo><mi mathvariant="normal">Σ</mi></mrow><annotation encoding="application/x-tex">L_{u}\to\Sigma</annotation></semantics></math> having a frame</p>
<table id="S14.Ex87" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex87.m1" class="ltx_Math" alttext="h_{0},\ldots,h_{d}" display="block" intent=":literal"><semantics><mrow><msub><mi>h</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>h</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">h_{0},\ldots,h_{d}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS4.SSS1.p3.4" class="ltx_p">satisfying</p>
<table id="S14.Ex88" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex88.m1" class="ltx_Math" alttext="h_{0}(z_{+})=\cdots=h_{d-1}(z_{+})=0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>h</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">=</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">=</mo><mrow><msub><mi>h</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">h_{0}(z_{+})=\cdots=h_{d-1}(z_{+})=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS4.SSS1.p3.5" class="ltx_p">The parallel transport along the two lateral lines induces nonzero vectors <math id="S14.SS4.SSS1.p3.m9" class="ltx_Math" alttext="\tau^{1}\in L_{u}(z_{-}^{1})" display="inline" intent=":literal"><semantics><mrow><msup><mi>τ</mi><mn>1</mn></msup><mo>∈</mo><mrow><msub><mi>L</mi><mi>u</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>z</mi><mo>−</mo><mn>1</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau^{1}\in L_{u}(z_{-}^{1})</annotation></semantics></math>, <math id="S14.SS4.SSS1.p3.m10" class="ltx_Math" alttext="\tau^{2}\in L_{u}(z_{-}^{2})" display="inline" intent=":literal"><semantics><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo>∈</mo><mrow><msub><mi>L</mi><mi>u</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>z</mi><mo>−</mo><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau^{2}\in L_{u}(z_{-}^{2})</annotation></semantics></math>. Then consider the prestable curve</p>
<table id="S14.Ex89" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex89.m1" class="ltx_Math" alttext="\tilde{\Sigma}:=(\Sigma^{1}\sqcup\Sigma^{2})\#\Sigma." display="block" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi mathvariant="normal">Σ</mi><mo>~</mo></mover><mo>:=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi mathvariant="normal">Σ</mi><mn>1</mn></msup><mo>⊔</mo><msup><mi mathvariant="normal">Σ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Σ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tilde{\Sigma}:=(\Sigma^{1}\sqcup\Sigma^{2})\#\Sigma.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS4.SSS1.p3.6" class="ltx_p">We extend the bundles <math id="S14.SS4.SSS1.p3.m11" class="ltx_Math" alttext="L_{u^{1}}\to\Sigma^{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><msup><mi>u</mi><mn>1</mn></msup></msub><mo stretchy="false">→</mo><msup><mi mathvariant="normal">Σ</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">L_{u^{1}}\to\Sigma^{1}</annotation></semantics></math>, <math id="S14.SS4.SSS1.p3.m12" class="ltx_Math" alttext="L_{u^{2}}\to\Sigma^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><msup><mi>u</mi><mn>2</mn></msup></msub><mo stretchy="false">→</mo><msup><mi mathvariant="normal">Σ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">L_{u^{2}}\to\Sigma^{2}</annotation></semantics></math>, and <math id="S14.SS4.SSS1.p3.m13" class="ltx_Math" alttext="L_{u}\to\Sigma" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>u</mi></msub><mo stretchy="false">→</mo><mi mathvariant="normal">Σ</mi></mrow><annotation encoding="application/x-tex">L_{u}\to\Sigma</annotation></semantics></math> to other components by trivial bundle extension. Then all the sections extend by constants. Then define <math id="S14.SS4.SSS1.p3.m14" class="ltx_Math" alttext="L=L_{u^{1}}\otimes L_{u^{2}}\otimes L_{u}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>=</mo><mrow><msub><mi>L</mi><msup><mi>u</mi><mn>1</mn></msup></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>L</mi><msup><mi>u</mi><mn>2</mn></msup></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>L</mi><mi>u</mi></msub></mrow></mrow><annotation encoding="application/x-tex">L=L_{u^{1}}\otimes L_{u^{2}}\otimes L_{u}</annotation></semantics></math> and consider the collection of sections (written in three groups)</p>
<table id="S14.Ex90" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex90.m1" class="ltx_Math" alttext="\Big(h_{0}^{1}\otimes h_{d^{2}}^{2}\otimes\tau^{1},\ldots,h_{d^{1}-1}^{1}\otimes h_{d^{2}}^{2}\otimes\tau^{1};h_{d^{1}}^{1}\otimes h_{0}^{2}\otimes\tau^{2},\ldots,h_{d^{1}}^{1}\otimes h_{d^{2}-1}^{2}\otimes\tau^{2};h_{d^{1}}^{1}\otimes h_{d^{2}}^{2}\otimes h_{0},\ldots,h_{d^{1}}^{1}\otimes h_{d^{2}}^{2}\otimes h_{d}\Big)." display="block" intent=":literal"><semantics><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msubsup><mi>h</mi><mn>0</mn><mn>1</mn></msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi>h</mi><msup><mi>d</mi><mn>2</mn></msup><mn>2</mn></msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mi>τ</mi><mn>1</mn></msup></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msubsup><mi>h</mi><mrow><msup><mi>d</mi><mn>1</mn></msup><mo>−</mo><mn>1</mn></mrow><mn>1</mn></msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi>h</mi><msup><mi>d</mi><mn>2</mn></msup><mn>2</mn></msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mi>τ</mi><mn>1</mn></msup></mrow><mo>,</mo><mrow><msubsup><mi>h</mi><msup><mi>d</mi><mn>1</mn></msup><mn>1</mn></msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi>h</mi><mn>0</mn><mn>2</mn></msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mi>τ</mi><mn>2</mn></msup></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msubsup><mi>h</mi><msup><mi>d</mi><mn>1</mn></msup><mn>1</mn></msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi>h</mi><mrow><msup><mi>d</mi><mn>2</mn></msup><mo>−</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mi>τ</mi><mn>2</mn></msup></mrow><mo>,</mo><mrow><msubsup><mi>h</mi><msup><mi>d</mi><mn>1</mn></msup><mn>1</mn></msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi>h</mi><msup><mi>d</mi><mn>2</mn></msup><mn>2</mn></msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>h</mi><mn>0</mn></msub></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msubsup><mi>h</mi><msup><mi>d</mi><mn>1</mn></msup><mn>1</mn></msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi>h</mi><msup><mi>d</mi><mn>2</mn></msup><mn>2</mn></msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>h</mi><mi>d</mi></msub></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Big(h_{0}^{1}\otimes h_{d^{2}}^{2}\otimes\tau^{1},\ldots,h_{d^{1}-1}^{1}\otimes h_{d^{2}}^{2}\otimes\tau^{1};h_{d^{1}}^{1}\otimes h_{0}^{2}\otimes\tau^{2},\ldots,h_{d^{1}}^{1}\otimes h_{d^{2}-1}^{2}\otimes\tau^{2};h_{d^{1}}^{1}\otimes h_{d^{2}}^{2}\otimes h_{0},\ldots,h_{d^{1}}^{1}\otimes h_{d^{2}}^{2}\otimes h_{d}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS4.SSS1.p3.7" class="ltx_p">Then it is easy to see that this collection forms a basis of <math id="S14.SS4.SSS1.p3.m15" class="ltx_Math" alttext="H^{0}(L)" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{0}(L)</annotation></semantics></math>. In particular, it is base-point-free. Hence it defines a holomorphic map</p>
<table id="S14.Ex91" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex91.m1" class="ltx_Math" alttext="\tilde{u}:\Sigma\to\mathbb{P}^{d^{1}+d^{2}+d}." display="block" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><msup><mi>ℙ</mi><mrow><msup><mi>d</mi><mn>1</mn></msup><mo>+</mo><msup><mi>d</mi><mn>2</mn></msup><mo>+</mo><mi>d</mi></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tilde{u}:\Sigma\to\mathbb{P}^{d^{1}+d^{2}+d}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS4.SSS1.p3.8" class="ltx_p">One can also see that this is independent of the choices of the representatives. Hence one obtains a well-defined map</p>
<table id="S14.Ex92" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex92.m1" class="ltx_Math" alttext="\zeta_{d^{1},d^{2};d}^{B}:B_{d^{1}}\times B_{d^{2}}\times B_{d}^{\Sigma}\to B_{d^{1}+d^{2}+d}^{\Sigma}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>ζ</mi><mrow><msup><mi>d</mi><mn>1</mn></msup><mo>,</mo><msup><mi>d</mi><mn>2</mn></msup><mo>;</mo><mi>d</mi></mrow><mi>B</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>B</mi><msup><mi>d</mi><mn>1</mn></msup></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>B</mi><msup><mi>d</mi><mn>2</mn></msup></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>B</mi><mi>d</mi><mi mathvariant="normal">Σ</mi></msubsup></mrow><mo stretchy="false">→</mo><msubsup><mi>B</mi><mrow><msup><mi>d</mi><mn>1</mn></msup><mo>+</mo><msup><mi>d</mi><mn>2</mn></msup><mo>+</mo><mi>d</mi></mrow><mi mathvariant="normal">Σ</mi></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\zeta_{d^{1},d^{2};d}^{B}:B_{d^{1}}\times B_{d^{2}}\times B_{d}^{\Sigma}\to B_{d^{1}+d^{2}+d}^{\Sigma}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS4.SSS1.p3.9" class="ltx_p">It is easy to see that the map is equivariant with respect to the group embedding.</p>
</div>
<div id="S14.SS4.SSS1.p4" class="ltx_para ltx_noindent">
<p id="S14.SS4.SSS1.p4.1" class="ltx_p">The associativity is more subtle than the previous case. Choose <math id="S14.SS4.SSS1.p4.m1" class="ltx_Math" alttext="d^{1}_{a},d^{1}_{b},d_{a}^{2},d_{b}^{2},d" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>d</mi><mi>a</mi><mn>1</mn></msubsup><mo>,</mo><msubsup><mi>d</mi><mi>b</mi><mn>1</mn></msubsup><mo>,</mo><msubsup><mi>d</mi><mi>a</mi><mn>2</mn></msubsup><mo>,</mo><msubsup><mi>d</mi><mi>b</mi><mn>2</mn></msubsup><mo>,</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">d^{1}_{a},d^{1}_{b},d_{a}^{2},d_{b}^{2},d</annotation></semantics></math>. Denote <math id="S14.SS4.SSS1.p4.m2" class="ltx_Math" alttext="\tilde{d}=d_{b}^{1}+d_{b}^{2}+d" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo>=</mo><mrow><msubsup><mi>d</mi><mi>b</mi><mn>1</mn></msubsup><mo>+</mo><msubsup><mi>d</mi><mi>b</mi><mn>2</mn></msubsup><mo>+</mo><mi>d</mi></mrow></mrow><annotation encoding="application/x-tex">\tilde{d}=d_{b}^{1}+d_{b}^{2}+d</annotation></semantics></math>. Let’s compare the following two elements</p>
<table id="S14.Ex93" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex93.m1" class="ltx_Math" alttext="\zeta_{d^{1}_{a}+d_{b}^{1},d^{2}_{a}+d_{b}^{2};d}^{B}\left(\zeta_{d_{a}^{1},d_{b}^{1}}^{B}(\phi^{1}_{a},\phi^{1}_{b}),\zeta_{d_{a}^{2},d_{b}^{2}}^{B}(\phi^{2}_{a},\phi^{2}_{b});\phi\right)\ {\rm vs.}\ \zeta_{d_{a}^{1},d_{a}^{2};\tilde{d}}^{B}\left(\phi_{a}^{1},\phi_{a}^{2};\zeta_{\phi_{b}^{1},\phi_{b}^{2};d}^{B}(\phi_{b}^{1},\phi_{b}^{2};\phi)\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>ζ</mi><mrow><mrow><msubsup><mi>d</mi><mi>a</mi><mn>1</mn></msubsup><mo>+</mo><msubsup><mi>d</mi><mi>b</mi><mn>1</mn></msubsup></mrow><mo>,</mo><mrow><msubsup><mi>d</mi><mi>a</mi><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>d</mi><mi>b</mi><mn>2</mn></msubsup></mrow><mo>;</mo><mi>d</mi></mrow><mi>B</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>ζ</mi><mrow><msubsup><mi>d</mi><mi>a</mi><mn>1</mn></msubsup><mo>,</mo><msubsup><mi>d</mi><mi>b</mi><mn>1</mn></msubsup></mrow><mi>B</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>ϕ</mi><mi>a</mi><mn>1</mn></msubsup><mo>,</mo><msubsup><mi>ϕ</mi><mi>b</mi><mn>1</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi>ζ</mi><mrow><msubsup><mi>d</mi><mi>a</mi><mn>2</mn></msubsup><mo>,</mo><msubsup><mi>d</mi><mi>b</mi><mn>2</mn></msubsup></mrow><mi>B</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>ϕ</mi><mi>a</mi><mn>2</mn></msubsup><mo>,</mo><msubsup><mi>ϕ</mi><mi>b</mi><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>ϕ</mi><mo>)</mo></mrow><mo lspace="0.500em" rspace="0em">​</mo><mi>vs</mi></mrow><mo lspace="0em" rspace="0.667em">.</mo><mrow><msubsup><mi>ζ</mi><mrow><msubsup><mi>d</mi><mi>a</mi><mn>1</mn></msubsup><mo>,</mo><msubsup><mi>d</mi><mi>a</mi><mn>2</mn></msubsup><mo>;</mo><mover accent="true"><mi>d</mi><mo>~</mo></mover></mrow><mi>B</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>ϕ</mi><mi>a</mi><mn>1</mn></msubsup><mo>,</mo><msubsup><mi>ϕ</mi><mi>a</mi><mn>2</mn></msubsup><mo>,</mo><mrow><msubsup><mi>ζ</mi><mrow><msubsup><mi>ϕ</mi><mi>b</mi><mn>1</mn></msubsup><mo>,</mo><msubsup><mi>ϕ</mi><mi>b</mi><mn>2</mn></msubsup><mo>;</mo><mi>d</mi></mrow><mi>B</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>ϕ</mi><mi>b</mi><mn>1</mn></msubsup><mo>,</mo><msubsup><mi>ϕ</mi><mi>b</mi><mn>2</mn></msubsup><mo>,</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\zeta_{d^{1}_{a}+d_{b}^{1},d^{2}_{a}+d_{b}^{2};d}^{B}\left(\zeta_{d_{a}^{1},d_{b}^{1}}^{B}(\phi^{1}_{a},\phi^{1}_{b}),\zeta_{d_{a}^{2},d_{b}^{2}}^{B}(\phi^{2}_{a},\phi^{2}_{b});\phi\right)\ {\rm vs.}\ \zeta_{d_{a}^{1},d_{a}^{2};\tilde{d}}^{B}\left(\phi_{a}^{1},\phi_{a}^{2};\zeta_{\phi_{b}^{1},\phi_{b}^{2};d}^{B}(\phi_{b}^{1},\phi_{b}^{2};\phi)\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS4.SSS1.p4.2" class="ltx_p">They indeed differ by a conjugation. In fact, the diagram</p>
<table id="S14.Ex94" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S14.Ex94.m1.pic1" class="ltx_picture ltx_markedasmath" height="68.19" overflow="visible" style="vertical-align:-56.23358883137886px" version="1.1" viewBox="123.18 56.23 476.33 68.19" width="476.33"><g transform="matrix(1 0 0 -1 123.1766855533611 68.18879833356036) translate(0,3.46) translate(123.18,0)"><g transform="translate(-123.18,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:17.2em;--ltx-fo-height:0.81em;--ltx-fo-depth:0.25em;font-size:10pt;" height="14.72" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="238.05"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S14.Ex94.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{U(d_{a}^{1})\times U(d_{b}^{1})\times U(d_{a}^{2})\times U(d_{b}^{2})\times U(d)\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>d</mi><mi>a</mi><mn>1</mn></msubsup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">×</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>d</mi><mi>b</mi><mn>1</mn></msubsup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">×</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>d</mi><mi>a</mi><mn>2</mn></msubsup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">×</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>d</mi><mi>b</mi><mn>2</mn></msubsup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">×</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\textstyle{U(d_{a}^{1})\times U(d_{b}^{1})\times U(d_{a}^{2})\times U(d_{b}^{2})\times U(d)\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 123.1766855533611 -0.27673578005007266 L 123.1766855533611 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(156.39,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 123.1766855533611 -0.27673578005007266 L 156.3854858854491 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 156.3854858854491 -0.27673578005007266 L 156.3854858854491 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -11.069600110696001 L 0.27673578005007266 -11.069600110696001" fill="none" stroke="#000000"></path><g transform="translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.20877921850137 L 0.27673578005007266 -11.069600110696001" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.20877921850137 L 0.27673578005007266 -33.20877921850137" fill="none" stroke="#000000"></path><g transform="translate(156.39,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:13.62em;--ltx-fo-height:0.81em;--ltx-fo-depth:0.25em;font-size:10pt;" height="14.72" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="188.47"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S14.Ex94.m1.pic1.m2" class="ltx_Math" alttext="\textstyle{U(d_{a}^{1}+d_{b}^{1})\times U(d_{a}^{2}+d_{b}^{2})\times U(d)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>d</mi><mi>a</mi><mn>1</mn></msubsup><mo>+</mo><msubsup><mi>d</mi><mi>b</mi><mn>1</mn></msubsup></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">×</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>d</mi><mi>a</mi><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>d</mi><mi>b</mi><mn>2</mn></msubsup></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">×</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\textstyle{U(d_{a}^{1}+d_{b}^{1})\times U(d_{a}^{2}+d_{b}^{2})\times U(d)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 254.4922998242809 -11.069600110696001 L 255.04577138438106 -11.069600110696001" fill="none" stroke="#000000"></path><g transform="translate(254.77,0) translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 254.4922998242809 -33.20877921850137 L 255.04577138438106 -11.069600110696001" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 254.4922998242809 -33.20877921850137 L 255.04577138438106 -33.20877921850137" fill="none" stroke="#000000"></path><g transform="translate(-71.38,0) translate(0,-45.16) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:9.72em;--ltx-fo-height:0.81em;--ltx-fo-depth:0.25em;font-size:10pt;" height="14.72" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="134.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S14.Ex94.m1.pic1.m3" class="ltx_Math" alttext="\textstyle{U(d_{a}^{1})\times U(d_{a}^{2})\times U(\tilde{d})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>d</mi><mi>a</mi><mn>1</mn></msubsup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">×</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>d</mi><mi>a</mi><mn>2</mn></msubsup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">×</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>d</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\textstyle{U(d_{a}^{1})\times U(d_{a}^{2})\times U(\tilde{d})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 71.37980024993081 -45.44072450073293 L 71.37980024993081 -44.887252940632784" fill="none" stroke="#000000"></path><g transform="translate(181.18,0) translate(0,-45.16)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 71.37980024993081 -45.44072450073293 L 181.17862171992832 -44.887252940632784" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 181.17862171992832 -45.44072450073293 L 181.17862171992832 -44.887252940632784" fill="none" stroke="#000000"></path><g transform="translate(181.18,0) translate(0,-45.16) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:10.04em;--ltx-fo-height:0.81em;--ltx-fo-depth:0.25em;font-size:10pt;" height="14.72" overflow="visible" transform="matrix(1 0 0 -1 0 11.26)" width="138.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S14.Ex94.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{U(d_{a}^{1}+d_{a}^{2}+d_{b}^{1}+d_{b}^{2}+d)}" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>d</mi><mi>a</mi><mn>1</mn></msubsup><mo>+</mo><msubsup><mi>d</mi><mi>a</mi><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>d</mi><mi>b</mi><mn>1</mn></msubsup><mo>+</mo><msubsup><mi>d</mi><mi>b</mi><mn>2</mn></msubsup><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{U(d_{a}^{1}+d_{a}^{2}+d_{b}^{1}+d_{b}^{2}+d)}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS4.SSS1.p4.3" class="ltx_p">commutes up to an element in <math id="S14.SS4.SSS1.p4.m3" class="ltx_Math" alttext="U(d_{a}^{1}+d_{a}^{2}+d_{b}^{1}+d_{b}^{2}+d)" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>d</mi><mi>a</mi><mn>1</mn></msubsup><mo>+</mo><msubsup><mi>d</mi><mi>a</mi><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>d</mi><mi>b</mi><mn>1</mn></msubsup><mo>+</mo><msubsup><mi>d</mi><mi>b</mi><mn>2</mn></msubsup><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">U(d_{a}^{1}+d_{a}^{2}+d_{b}^{1}+d_{b}^{2}+d)</annotation></semantics></math> which is the matrix permuting corresponding coordinates. Therefore, the above diagram commutes up to a conjugation.</p>
</div>
<div id="S14.SS4.SSS1.p5" class="ltx_para ltx_noindent">
<p id="S14.SS4.SSS1.p5.1" class="ltx_p">One can extend the above construction to the general case when <math id="S14.SS4.SSS1.p5.m1" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> is smooth with multiple inputs.</p>
</div>
<div id="S14.Thmthm21" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S14.Thmthm21.2" class="ltx_text ltx_font_bold">Proposition 14.21</span></span><span id="S14.Thmthm21.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S14.Thmthm21.p1" class="ltx_para ltx_noindent">
<p id="S14.Thmthm21.p1.1" class="ltx_p"><span id="S14.Thmthm21.p1.1.1" class="ltx_text ltx_font_italic">The collections of equivariant family of curves <math id="S14.Thmthm21.p1.m1" class="ltx_Math" alttext="{\mathcal{C}}_{d}^{\Sigma}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>d</mi><mi mathvariant="normal">Σ</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{C}}_{d}^{\Sigma}</annotation></semantics></math> together with the structural maps</span></p>
<table id="S14.Ex95" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex95.m1" class="ltx_math_unparsed" alttext="{\mathcal{C}}_{d_{1}}\times\cdots\times{\mathcal{C}}_{d_{m}}\times{\mathcal{C}}_{d}^{\Sigma}\times{\mathcal{C}}_{d^{\prime}}\to{\mathcal{C}}_{d_{1}+\cdots+d_{m}+d+d^{\prime}}^{\Sigma}" display="block" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><msub><mrow></mrow><msub><mi>d</mi><mn>1</mn></msub></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi><msub><mrow></mrow><msub><mi>d</mi><mi>m</mi></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi><msub><mrow></mrow><mi>d</mi></msub><msup><mrow></mrow><mi mathvariant="normal">Σ</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi><msub><mrow></mrow><msup><mi>d</mi><mo>′</mo></msup></msub><mo stretchy="false">→</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi><msub><mrow></mrow><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>d</mi><mi>m</mi></msub><mo>+</mo><mi>d</mi><mo>+</mo><msup><mi>d</mi><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi mathvariant="normal">Σ</mi></msup></mrow><annotation encoding="application/x-tex">{\mathcal{C}}_{d_{1}}\times\cdots\times{\mathcal{C}}_{d_{m}}\times{\mathcal{C}}_{d}^{\Sigma}\times{\mathcal{C}}_{d^{\prime}}\to{\mathcal{C}}_{d_{1}+\cdots+d_{m}+d+d^{\prime}}^{\Sigma}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.Thmthm21.p1.2" class="ltx_p"><span id="S14.Thmthm21.p1.2.1" class="ltx_text ltx_font_italic">define a monotone multimodule over <math id="S14.Thmthm21.p1.m2" class="ltx_Math" alttext="(\mathbb{Dom},\ldots,\mathbb{Dom};\mathbb{Dom})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>𝔻</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕠</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕞</mi></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>𝔻</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕠</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕞</mi></mrow><mo>,</mo><mrow><mi>𝔻</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕠</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕞</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbb{Dom},\ldots,\mathbb{Dom};\mathbb{Dom})</annotation></semantics></math>.</span></p>
</div>
</div>
</section>
<section id="S14.SS4.SSS2" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">14.4.2. </span>Rigidification and stable complex structure</h5>

<div id="S14.SS4.SSS2.p1" class="ltx_para ltx_noindent">
<p id="S14.SS4.SSS2.p1.1" class="ltx_p">We can construct a rigidification of any outercollaring of the multimodule <math id="S14.SS4.SSS2.p1.m1" class="ltx_Math" alttext="\mathbb{Dom}^{\Sigma}" display="inline" intent=":literal"><semantics><mrow><mi>𝔻</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕠</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝕞</mi><mi mathvariant="normal">Σ</mi></msup></mrow><annotation encoding="application/x-tex">\mathbb{Dom}^{\Sigma}</annotation></semantics></math> in the same way as constructing the rigidification of the domain flow category (see Proposition <a href="#S14.Thmthm17" title="Proposition 14.17. ‣ 14.3.5. Rigidification ‣ 14.3. Construction of the domain flow categories ‣ 14. The Flow Categories, Multimodules, and Homotopies of Domains ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14.17</span></a>).</p>
</div>
<div id="S14.Thmthm22" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S14.Thmthm22.2" class="ltx_text ltx_font_bold">Proposition 14.22</span></span><span id="S14.Thmthm22.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S14.Thmthm22.p1" class="ltx_para ltx_noindent">
<p id="S14.Thmthm22.p1.1" class="ltx_p"><span id="S14.Thmthm22.p1.1.1" class="ltx_text ltx_font_italic">Given lifts of <math id="S14.Thmthm22.p1.m1" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}_{1},\ldots,{}_{\lfloor}\mathbb{Dom}_{m},{}_{\lfloor}\mathbb{Dom}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msub><mrow></mrow><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msub><mrow></mrow><mi>m</mi></msub><mo>,</mo><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}_{1},\ldots,{}_{\lfloor}\mathbb{Dom}_{m},{}_{\lfloor}\mathbb{Dom}^{\prime}</annotation></semantics></math> to <math id="S14.Thmthm22.p1.m2" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>ℂ</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}</annotation></semantics></math>, there exists a lift of <math id="S14.Thmthm22.p1.m3" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}^{\Sigma}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mi mathvariant="normal">Σ</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}^{\Sigma}</annotation></semantics></math> to <math id="S14.Thmthm22.p1.m4" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>ℂ</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}</annotation></semantics></math> as a monotone multimodule over the given lifts of the monotone flow categories. Moreover, for all <math id="S14.Thmthm22.p1.m5" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> there exist <math id="S14.Thmthm22.p1.m6" class="ltx_Math" alttext="{\mathcal{G}}_{d}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>d</mi></msub><annotation encoding="application/x-tex">{\mathcal{G}}_{d}</annotation></semantics></math>-invariant orientations on <math id="S14.Thmthm22.p1.m7" class="ltx_Math" alttext="B_{d}^{\Sigma}" display="inline" intent=":literal"><semantics><msubsup><mi>B</mi><mi>d</mi><mi mathvariant="normal">Σ</mi></msubsup><annotation encoding="application/x-tex">B_{d}^{\Sigma}</annotation></semantics></math> satisfying</span></p>
<ol id="S14.I9" class="ltx_enumerate">
<li id="S14.I9.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S14.I9.i1.p1" class="ltx_para ltx_noindent">
<p id="S14.I9.i1.p1.1" class="ltx_p"><span id="S14.I9.i1.p1.1.1" class="ltx_text ltx_font_italic">For each </span><math id="S14.I9.i1.p1.m1" class="ltx_Math" alttext="i\in\{1,\ldots,m\}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>m</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\{1,\ldots,m\}</annotation></semantics></math><span id="S14.I9.i1.p1.1.2" class="ltx_text ltx_font_italic"> and </span><math id="S14.I9.i1.p1.m2" class="ltx_Math" alttext="d_{i}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d_{i}&gt;0</annotation></semantics></math><span id="S14.I9.i1.p1.1.3" class="ltx_text ltx_font_italic">, the map</span></p>
<table id="S14.Ex96" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex96.m1" class="ltx_Math" alttext="{\mathcal{G}}_{d_{i}+d}\times_{{\mathcal{G}}_{d_{i}}\times{\mathcal{G}}_{d}}(B_{d_{i}}\times B_{d}^{\Sigma})\to\partial^{d_{i},d}B_{d+d_{i}}^{\Sigma}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>+</mo><mi>d</mi></mrow></msub><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msub><mi>d</mi><mi>i</mi></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>d</mi></msub></mrow></msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>B</mi><msub><mi>d</mi><mi>i</mi></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>B</mi><mi>d</mi><mi mathvariant="normal">Σ</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em" stretchy="false">→</mo><mrow><msup><mo>∂</mo><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>,</mo><mi>d</mi></mrow></msup><msubsup><mi>B</mi><mrow><mi>d</mi><mo>+</mo><msub><mi>d</mi><mi>i</mi></msub></mrow><mi mathvariant="normal">Σ</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{G}}_{d_{i}+d}\times_{{\mathcal{G}}_{d_{i}}\times{\mathcal{G}}_{d}}(B_{d_{i}}\times B_{d}^{\Sigma})\to\partial^{d_{i},d}B_{d+d_{i}}^{\Sigma}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.I9.i1.p1.2" class="ltx_p"><span id="S14.I9.i1.p1.2.1" class="ltx_text ltx_font_italic">is orientation preserving.</span></p>
</div></li>
<li id="S14.I9.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S14.I9.i2.p1" class="ltx_para ltx_noindent">
<p id="S14.I9.i2.p1.1" class="ltx_p"><span id="S14.I9.i2.p1.1.1" class="ltx_text ltx_font_italic">For each </span><math id="S14.I9.i2.p1.m1" class="ltx_Math" alttext="d^{\prime}&gt;0" display="inline" intent=":literal"><semantics><mrow><msup><mi>d</mi><mo>′</mo></msup><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d^{\prime}&gt;0</annotation></semantics></math><span id="S14.I9.i2.p1.1.2" class="ltx_text ltx_font_italic">, the map</span></p>
<table id="S14.Ex97" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex97.m1" class="ltx_Math" alttext="{\mathcal{G}}_{d+d^{\prime}}\times_{{\mathcal{G}}_{d}\times{\mathcal{G}}_{d^{\prime}}}(B_{d}^{\Sigma}\times B_{d^{\prime}})\to\partial^{d,d^{\prime}}B_{d+d^{\prime}}^{\Sigma}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>d</mi><mo>+</mo><msup><mi>d</mi><mo>′</mo></msup></mrow></msub><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>d</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><msup><mi>d</mi><mo>′</mo></msup></msub></mrow></msub><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>B</mi><mi>d</mi><mi mathvariant="normal">Σ</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>B</mi><msup><mi>d</mi><mo>′</mo></msup></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em" stretchy="false">→</mo><mrow><msup><mo>∂</mo><mrow><mi>d</mi><mo>,</mo><msup><mi>d</mi><mo>′</mo></msup></mrow></msup><msubsup><mi>B</mi><mrow><mi>d</mi><mo>+</mo><msup><mi>d</mi><mo>′</mo></msup></mrow><mi mathvariant="normal">Σ</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{G}}_{d+d^{\prime}}\times_{{\mathcal{G}}_{d}\times{\mathcal{G}}_{d^{\prime}}}(B_{d}^{\Sigma}\times B_{d^{\prime}})\to\partial^{d,d^{\prime}}B_{d+d^{\prime}}^{\Sigma}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.I9.i2.p1.2" class="ltx_p"><span id="S14.I9.i2.p1.2.1" class="ltx_text ltx_font_italic">is orientation reversing.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S14.SS4.SSS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S14.SS4.SSS2.p2" class="ltx_para">
<p id="S14.SS4.SSS2.p2.1" class="ltx_p"><span id="S14.SS4.SSS2.p2.1.1" class="ltx_text">The construction of the rigidification can be carried out as done in the proof of Proposition <a href="#S14.Thmthm17" title="Proposition 14.17. ‣ 14.3.5. Rigidification ‣ 14.3. Construction of the domain flow categories ‣ 14. The Flow Categories, Multimodules, and Homotopies of Domains ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14.17</span></a>. The construction of stable complex structure can be carried out similarly as in the proof of Proposition <a href="#S14.Thmthm19" title="Proposition 14.19. ‣ 14.3.6. Stable complex structure ‣ 14.3. Construction of the domain flow categories ‣ 14. The Flow Categories, Multimodules, and Homotopies of Domains ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14.19</span></a>. As for the orientation, the argument is similar to Lemma <a href="#S14.Thmthm20" title="Lemma 14.20. ‣ 14.3.7. Orientation and concatenation ‣ 14.3. Construction of the domain flow categories ‣ 14. The Flow Categories, Multimodules, and Homotopies of Domains ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14.20</span></a>. However, notice that <math id="S14.SS4.SSS2.p2.m1" class="ltx_Math" alttext="B_{d}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>d</mi></msub><annotation encoding="application/x-tex">B_{d}</annotation></semantics></math> has an odd dimension and <math id="S14.SS4.SSS2.p2.m2" class="ltx_Math" alttext="B_{d}^{\Sigma}" display="inline" intent=":literal"><semantics><msubsup><mi>B</mi><mi>d</mi><mi mathvariant="normal">Σ</mi></msubsup><annotation encoding="application/x-tex">B_{d}^{\Sigma}</annotation></semantics></math> has an even dimension, which make the difference in the two cases as one has to interchange the <math id="S14.SS4.SSS2.p2.m3" class="ltx_Math" alttext="[0,\epsilon)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">[0,\epsilon)</annotation></semantics></math> factor with either <math id="S14.SS4.SSS2.p2.m4" class="ltx_Math" alttext="B_{d_{i}}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><msub><mi>d</mi><mi>i</mi></msub></msub><annotation encoding="application/x-tex">B_{d_{i}}</annotation></semantics></math> or <math id="S14.SS4.SSS2.p2.m5" class="ltx_Math" alttext="B_{d}^{\Sigma}" display="inline" intent=":literal"><semantics><msubsup><mi>B</mi><mi>d</mi><mi mathvariant="normal">Σ</mi></msubsup><annotation encoding="application/x-tex">B_{d}^{\Sigma}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="S14.SS4.SSS3" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">14.4.3. </span>Homotopies</h5>

<div id="S14.SS4.SSS3.p1" class="ltx_para ltx_noindent">
<p id="S14.SS4.SSS3.p1.1" class="ltx_p">Flow homotopies associated to a 1-parameter family of variations of domain Floer data is indeed quite trivial. Indeed, let <math id="S14.SS4.SSS3.p1.m1" class="ltx_Math" alttext="\Sigma_{t}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\Sigma_{t}</annotation></semantics></math>, <math id="S14.SS4.SSS3.p1.m2" class="ltx_Math" alttext="t\in[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[0,1]</annotation></semantics></math> be a smooth family of Floer domains with <math id="S14.SS4.SSS3.p1.m3" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> negative ends and <math id="S14.SS4.SSS3.p1.m4" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> positive end. Then there are <math id="S14.SS4.SSS3.p1.m5" class="ltx_Math" alttext="m+1" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">m+1</annotation></semantics></math> copies of the monotone flow categories <math id="S14.SS4.SSS3.p1.m6" class="ltx_Math" alttext="\mathbb{Dom}" display="inline" intent=":literal"><semantics><mrow><mi>𝔻</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕠</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕞</mi></mrow><annotation encoding="application/x-tex">\mathbb{Dom}</annotation></semantics></math> corresponding to the <math id="S14.SS4.SSS3.p1.m7" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> inputs and 1 output. Suppose <math id="S14.SS4.SSS3.p1.m8" class="ltx_Math" alttext="\Sigma_{t}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\Sigma_{t}</annotation></semantics></math> is equipped with a smooth family of lateral lines. Then <math id="S14.SS4.SSS3.p1.m9" class="ltx_Math" alttext="\Sigma_{0}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\Sigma_{0}</annotation></semantics></math> and <math id="S14.SS4.SSS3.p1.m10" class="ltx_Math" alttext="\Sigma_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\Sigma_{1}</annotation></semantics></math> correspond to monotone multimodules <math id="S14.SS4.SSS3.p1.m11" class="ltx_Math" alttext="\mathbb{Dom}^{\Sigma_{0}}" display="inline" intent=":literal"><semantics><mrow><mi>𝔻</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕠</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝕞</mi><msub><mi mathvariant="normal">Σ</mi><mn>0</mn></msub></msup></mrow><annotation encoding="application/x-tex">\mathbb{Dom}^{\Sigma_{0}}</annotation></semantics></math> and <math id="S14.SS4.SSS3.p1.m12" class="ltx_Math" alttext="\mathbb{Dom}^{\Sigma_{1}}" display="inline" intent=":literal"><semantics><mrow><mi>𝔻</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕠</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝕞</mi><msub><mi mathvariant="normal">Σ</mi><mn>1</mn></msub></msup></mrow><annotation encoding="application/x-tex">\mathbb{Dom}^{\Sigma_{1}}</annotation></semantics></math> over <math id="S14.SS4.SSS3.p1.m13" class="ltx_Math" alttext="(\mathbb{Dom},\ldots,\mathbb{Dom};\mathbb{Dom})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>𝔻</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕠</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕞</mi></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>𝔻</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕠</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕞</mi></mrow><mo>,</mo><mrow><mi>𝔻</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕠</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕞</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbb{Dom},\ldots,\mathbb{Dom};\mathbb{Dom})</annotation></semantics></math>. Moreover, by allowing <math id="S14.SS4.SSS3.p1.m14" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> to vary, one naturally obtains a monotone homotopy <math id="S14.SS4.SSS3.p1.m15" class="ltx_Math" alttext="\mathbb{Dom}^{\mathbb{H}}" display="inline" intent=":literal"><semantics><mrow><mi>𝔻</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕠</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝕞</mi><mi>ℍ</mi></msup></mrow><annotation encoding="application/x-tex">\mathbb{Dom}^{\mathbb{H}}</annotation></semantics></math> from <math id="S14.SS4.SSS3.p1.m16" class="ltx_Math" alttext="\mathbb{Dom}^{\Sigma_{0}}" display="inline" intent=":literal"><semantics><mrow><mi>𝔻</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕠</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝕞</mi><msub><mi mathvariant="normal">Σ</mi><mn>0</mn></msub></msup></mrow><annotation encoding="application/x-tex">\mathbb{Dom}^{\Sigma_{0}}</annotation></semantics></math> to <math id="S14.SS4.SSS3.p1.m17" class="ltx_Math" alttext="\mathbb{Dom}^{\Sigma_{1}}" display="inline" intent=":literal"><semantics><mrow><mi>𝔻</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕠</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝕞</mi><msub><mi mathvariant="normal">Σ</mi><mn>1</mn></msub></msup></mrow><annotation encoding="application/x-tex">\mathbb{Dom}^{\Sigma_{1}}</annotation></semantics></math>. Upon choosing any outercollaring width, these items become corresponding collared versions. The following proposition demonstrates that the choices of rigidifications and stable complex structures can also be carried inductively.</p>
</div>
<div id="S14.Thmthm23" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S14.Thmthm23.2" class="ltx_text ltx_font_bold">Proposition 14.23</span></span><span id="S14.Thmthm23.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S14.Thmthm23.p1" class="ltx_para">
<p id="S14.Thmthm23.p1.1" class="ltx_p"><span id="S14.Thmthm23.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S14.Thmthm23.p1.m1" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}_{1},\ldots,{}_{\lfloor}\mathbb{Dom}_{m};{}_{\lfloor}\mathbb{Dom}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msub><mrow></mrow><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}_{1},\ldots,{}_{\lfloor}\mathbb{Dom}_{m};{}_{\lfloor}\mathbb{Dom}^{\prime}</annotation></semantics></math> be monotone flow categories enriched in <math id="S14.Thmthm23.p1.m2" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>ℂ</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}</annotation></semantics></math> obtained from the monotone flow category <math id="S14.Thmthm23.p1.m3" class="ltx_Math" alttext="\mathbb{Dom}" display="inline" intent=":literal"><semantics><mrow><mi>𝔻</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕠</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕞</mi></mrow><annotation encoding="application/x-tex">\mathbb{Dom}</annotation></semantics></math> by outercollaring and possibly different rigidifications. Let</span></p>
<table id="S14.EGx50" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S14.Ex98"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S14.Ex98.m1" class="ltx_math_unparsed" alttext="\displaystyle\ {}_{\lfloor}\mathbb{Dom}^{\Sigma_{0}},\ " display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><msub><mi mathvariant="normal">Σ</mi><mn>0</mn></msub></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ {}_{\lfloor}\mathbb{Dom}^{\Sigma_{0}},\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S14.Ex98.m2" class="ltx_math_unparsed" alttext="\displaystyle\ {}_{\lfloor}\mathbb{Dom}^{\Sigma_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><msub><mi mathvariant="normal">Σ</mi><mn>1</mn></msub></msup></mrow><annotation encoding="application/x-tex">\displaystyle\ {}_{\lfloor}\mathbb{Dom}^{\Sigma_{1}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.Thmthm23.p1.2" class="ltx_p"><span id="S14.Thmthm23.p1.2.1" class="ltx_text ltx_font_italic">be monotone multimodules over <math id="S14.Thmthm23.p1.m4" class="ltx_math_unparsed" alttext="({}_{\lfloor}\mathbb{Dom}_{1},\ldots,{}_{\lfloor}\mathbb{Dom}_{m};{}_{\lfloor}\mathbb{Dom}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝔻</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mi>𝕠</mi><msub><mi>𝕞</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mmultiscripts><mi>𝔻</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mi>𝕠</mi><msub><mi>𝕞</mi><mi>m</mi></msub><mo>;</mo><mmultiscripts><mi>𝔻</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mi>𝕠</mi><msup><mi>𝕞</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({}_{\lfloor}\mathbb{Dom}_{1},\ldots,{}_{\lfloor}\mathbb{Dom}_{m};{}_{\lfloor}\mathbb{Dom}^{\prime})</annotation></semantics></math> enriched in <math id="S14.Thmthm23.p1.m5" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>ℂ</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}</annotation></semantics></math> constructed above. Then the outercollaring <math id="S14.Thmthm23.p1.m6" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}^{\mathbb{H}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mi>ℍ</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}^{\mathbb{H}}</annotation></semantics></math> admits a lift to <math id="S14.Thmthm23.p1.m7" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>ℂ</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}</annotation></semantics></math> as a monotone homotopy from <math id="S14.Thmthm23.p1.m8" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}^{\Sigma_{0}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><msub><mi mathvariant="normal">Σ</mi><mn>0</mn></msub></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}^{\Sigma_{0}}</annotation></semantics></math> to <math id="S14.Thmthm23.p1.m9" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}^{\Sigma_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><msub><mi mathvariant="normal">Σ</mi><mn>1</mn></msub></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}^{\Sigma_{1}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S14.SS4.SSS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S14.SS4.SSS3.p2" class="ltx_para">
<p id="S14.SS4.SSS3.p2.1" class="ltx_p"><span id="S14.SS4.SSS3.p2.1.1" class="ltx_text">Routine verification of the inductive constructions.
∎</span></p>
</div>
</div>
<figure id="S14.F8" class="ltx_figure"><object type="image/svg+xml" data="2606.15847v1/Lateral_Pants.svg" id="S14.F8.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:353/227;" width="353" height="227"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 8. </span>Lateral lines in a pair-of-pants.</figcaption>
</figure>
</section>
<section id="S14.SS4.SSS4" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">14.4.4. </span>The case of cigar bimodule</h5>

<div id="S14.SS4.SSS4.p1" class="ltx_para ltx_noindent">
<p id="S14.SS4.SSS4.p1.1" class="ltx_p">Let <math id="S14.SS4.SSS4.p1.m1" class="ltx_Math" alttext="\Sigma^{\rm cigar}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Σ</mi><mi>cigar</mi></msup><annotation encoding="application/x-tex">\Sigma^{\rm cigar}</annotation></semantics></math> be the complex plane <math id="S14.SS4.SSS4.p1.m2" class="ltx_Math" alttext="{\mathbb{C}}" display="inline" intent=":literal"><semantics><mi>ℂ</mi><annotation encoding="application/x-tex">{\mathbb{C}}</annotation></semantics></math> equipped with a cylindrical end. It is used to construct the cigar bimodule and eventually lead to the multiplicative identity of the pair-of-pants product. The construction of the corresponding monotone bimodule, denoted by <math id="S14.SS4.SSS4.p1.m3" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}^{\rm cigar}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mi>cigar</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}^{\rm cigar}</annotation></semantics></math>, is slightly different from the general case.</p>
</div>
<div id="S14.SS4.SSS4.p2" class="ltx_para ltx_noindent">
<p id="S14.SS4.SSS4.p2.1" class="ltx_p">We shall regard <math id="S14.SS4.SSS4.p2.m1" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}^{\rm cigar}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mi>cigar</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}^{\rm cigar}</annotation></semantics></math> not as a bimodule, but only a <span id="S14.SS4.SSS4.p2.1.1" class="ltx_text ltx_font_bold">right module</span> over <math id="S14.SS4.SSS4.p2.m2" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}</annotation></semantics></math>. This means it consists of objects</p>
<table id="S14.Ex99" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex99.m1" class="ltx_math_unparsed" alttext="{\mathcal{C}}_{d}^{\rm cigar}\in{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}" display="block" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><msub><mrow></mrow><mi>d</mi></msub><msup><mrow></mrow><mi>cigar</mi></msup><mo>∈</mo><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>ℂ</mi></msup></mrow><annotation encoding="application/x-tex">{\mathcal{C}}_{d}^{\rm cigar}\in{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS4.SSS4.p2.2" class="ltx_p">together with structural maps</p>
<table id="S14.Ex100" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex100.m1" class="ltx_Math" alttext="{\mathcal{C}}_{d}^{\rm cigar}\times{\mathcal{C}}_{d^{\prime}}\to{\mathcal{C}}_{d+d^{\prime}}^{\rm cigar}" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>d</mi><mi>cigar</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><msup><mi>d</mi><mo>′</mo></msup></msub></mrow><mo stretchy="false">→</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mi>d</mi><mo>+</mo><msup><mi>d</mi><mo>′</mo></msup></mrow><mi>cigar</mi></msubsup></mrow><annotation encoding="application/x-tex">{\mathcal{C}}_{d}^{\rm cigar}\times{\mathcal{C}}_{d^{\prime}}\to{\mathcal{C}}_{d+d^{\prime}}^{\rm cigar}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS4.SSS4.p2.3" class="ltx_p">which satisfy the obvious associativity relation. The construction of the object <math id="S14.SS4.SSS4.p2.m3" class="ltx_Math" alttext="{\mathcal{C}}_{d}^{\rm cigar}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>d</mi><mi>cigar</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{C}}_{d}^{\rm cigar}</annotation></semantics></math> is the same as before. Indeed, consider the moduli space of degree <math id="S14.SS4.SSS4.p2.m4" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> maps</p>
<table id="S14.Ex101" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex101.m1" class="ltx_Math" alttext="\phi:\Sigma^{\rm cigar}\to\mathbb{CP}^{d}" display="block" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi mathvariant="normal">Σ</mi><mi>cigar</mi></msup><mo stretchy="false">→</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi:\Sigma^{\rm cigar}\to\mathbb{CP}^{d}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS4.SSS4.p2.4" class="ltx_p">satisfying the constraint</p>
<table id="S14.Ex102" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex102.m1" class="ltx_Math" alttext="\phi(\infty)=[0,\ldots,0,1]\in\mathbb{P}^{d}" display="block" intent=":literal"><semantics><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mo>∈</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\phi(\infty)=[0,\ldots,0,1]\in\mathbb{P}^{d}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS4.SSS4.p2.5" class="ltx_p">and such that the image of <math id="S14.SS4.SSS4.p2.m5" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> is not contained in any hyperplane. After compactification in the standard way, one obtains a moduli space <math id="S14.SS4.SSS4.p2.m6" class="ltx_Math" alttext="B_{d}^{\rm cigar}" display="inline" intent=":literal"><semantics><msubsup><mi>B</mi><mi>d</mi><mi>cigar</mi></msubsup><annotation encoding="application/x-tex">B_{d}^{\rm cigar}</annotation></semantics></math> equipped with a <math id="S14.SS4.SSS4.p2.m7" class="ltx_Math" alttext="{\mathcal{G}}_{d}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>d</mi></msub><annotation encoding="application/x-tex">{\mathcal{G}}_{d}</annotation></semantics></math>-action and a universal curve <math id="S14.SS4.SSS4.p2.m8" class="ltx_Math" alttext="C_{d}^{\rm cigar}\to B_{d}^{\rm cigar}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>C</mi><mi>d</mi><mi>cigar</mi></msubsup><mo stretchy="false">→</mo><msubsup><mi>B</mi><mi>d</mi><mi>cigar</mi></msubsup></mrow><annotation encoding="application/x-tex">C_{d}^{\rm cigar}\to B_{d}^{\rm cigar}</annotation></semantics></math>, hence provides an object</p>
<table id="S14.Ex103" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex103.m1" class="ltx_Math" alttext="{\mathcal{C}}_{d}^{\rm cigar}=({\mathcal{G}}_{d},B_{d}^{\rm cigar},C_{d}^{\rm cigar})" display="block" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>d</mi><mi>cigar</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>d</mi></msub><mo>,</mo><msubsup><mi>B</mi><mi>d</mi><mi>cigar</mi></msubsup><mo>,</mo><msubsup><mi>C</mi><mi>d</mi><mi>cigar</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{C}}_{d}^{\rm cigar}=({\mathcal{G}}_{d},B_{d}^{\rm cigar},C_{d}^{\rm cigar})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS4.SSS4.p2.6" class="ltx_p">stratified by the poset</p>
<table id="S14.Ex104" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex104.m1" class="ltx_math_unparsed" alttext="A_{d}^{\rm cigar}=\{(d_{0},d_{1},\ldots,d_{l})\ |\ d_{0}+\cdots+d_{l}=d,\ d_{i}\geq 1\}." display="block" intent=":literal"><semantics><mrow><msubsup><mi>A</mi><mi>d</mi><mi>cigar</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>d</mi><mi>l</mi></msub><mo rspace="0.500em" stretchy="false">)</mo></mrow><mo fence="false" rspace="0.667em" stretchy="false">|</mo><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>d</mi><mi>l</mi></msub><mo>=</mo><mi>d</mi><mo rspace="0.667em">,</mo><msub><mi>d</mi><mi>i</mi></msub><mo>≥</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">A_{d}^{\rm cigar}=\{(d_{0},d_{1},\ldots,d_{l})\ |\ d_{0}+\cdots+d_{l}=d,\ d_{i}\geq 1\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S14.SS4.SSS4.p3" class="ltx_para ltx_noindent">
<p id="S14.SS4.SSS4.p3.1" class="ltx_p">The difference from the previous case is the definition of the structural maps. In the current situation, we do not need a lateral line in <math id="S14.SS4.SSS4.p3.m1" class="ltx_Math" alttext="\Sigma^{\rm cigar}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Σ</mi><mi>cigar</mi></msup><annotation encoding="application/x-tex">\Sigma^{\rm cigar}</annotation></semantics></math>. Other constructions are the same. This provides a monotone right module <math id="S14.SS4.SSS4.p3.m2" class="ltx_Math" alttext="\mathbb{Dom}^{\rm cigar}" display="inline" intent=":literal"><semantics><mrow><mi>𝔻</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕠</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝕞</mi><mi>cigar</mi></msup></mrow><annotation encoding="application/x-tex">\mathbb{Dom}^{\rm cigar}</annotation></semantics></math> over <math id="S14.SS4.SSS4.p3.m3" class="ltx_Math" alttext="\mathbb{Dom}" display="inline" intent=":literal"><semantics><mrow><mi>𝔻</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕠</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕞</mi></mrow><annotation encoding="application/x-tex">\mathbb{Dom}</annotation></semantics></math>. Then after outercollaring and choosing a lift of <math id="S14.SS4.SSS4.p3.m4" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}</annotation></semantics></math> to <math id="S14.SS4.SSS4.p3.m5" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>ℂ</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}</annotation></semantics></math>, one can find a rigidification of the outercollaring <math id="S14.SS4.SSS4.p3.m6" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}^{\rm cigar}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mi>cigar</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}^{\rm cigar}</annotation></semantics></math>.</p>
</div>
</section>
<section id="S14.SS4.SSS5" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">14.4.5. </span>The case of Poincaré duality multimodule</h5>

<div id="S14.SS4.SSS5.p1" class="ltx_para ltx_noindent">
<p id="S14.SS4.SSS5.p1.1" class="ltx_p">Now let <math id="S14.SS4.SSS5.p1.m1" class="ltx_Math" alttext="\Sigma^{\rm PD}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Σ</mi><mi>PD</mi></msup><annotation encoding="application/x-tex">\Sigma^{\rm PD}</annotation></semantics></math> be the smooth Floer domain with two negative ends and no positive ends, which is responsible for defining the Poincaré duality for Floer theory. One can similar define a monotone multimodule <math id="S14.SS4.SSS5.p1.m2" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}^{\rm PD}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mi>PD</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}^{\rm PD}</annotation></semantics></math> enriched in <math id="S14.SS4.SSS5.p1.m3" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>ℂ</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}</annotation></semantics></math> as above, whose construction slightly differ from previous cases.</p>
</div>
<div id="S14.SS4.SSS5.p2" class="ltx_para ltx_noindent">
<p id="S14.SS4.SSS5.p2.1" class="ltx_p">In this case, the structure we build is better called a double left module, meaning a collection of objects</p>
<table id="S14.Ex105" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex105.m1" class="ltx_math_unparsed" alttext="{\mathcal{C}}_{d}^{\rm PD}\in{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}" display="block" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><msub><mrow></mrow><mi>d</mi></msub><msup><mrow></mrow><mi>PD</mi></msup><mo>∈</mo><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>ℂ</mi></msup></mrow><annotation encoding="application/x-tex">{\mathcal{C}}_{d}^{\rm PD}\in{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS4.SSS5.p2.2" class="ltx_p">together with two structural maps</p>
<table id="S14.EGx51" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S14.Ex106"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S14.Ex106.m1" class="ltx_Math" alttext="\displaystyle\ {\mathcal{C}}_{d_{1}}\times{\mathcal{C}}_{d}^{\rm PD}\to{\mathcal{C}}_{d_{1}+d}^{\rm PD},\ {\mathcal{C}}_{d_{2}}\times{\mathcal{C}}_{d}^{\rm PD}\to{\mathcal{C}}_{d_{2}+d}^{\rm PD}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>d</mi><mi>PD</mi></msubsup></mrow><mo stretchy="false">→</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><mi>d</mi></mrow><mi>PD</mi></msubsup></mrow><mo rspace="0.667em">,</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><msub><mi>d</mi><mn>2</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>d</mi><mi>PD</mi></msubsup></mrow><mo stretchy="false">→</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><msub><mi>d</mi><mn>2</mn></msub><mo>+</mo><mi>d</mi></mrow><mi>PD</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ {\mathcal{C}}_{d_{1}}\times{\mathcal{C}}_{d}^{\rm PD}\to{\mathcal{C}}_{d_{1}+d}^{\rm PD},\ {\mathcal{C}}_{d_{2}}\times{\mathcal{C}}_{d}^{\rm PD}\to{\mathcal{C}}_{d_{2}+d}^{\rm PD}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS4.SSS5.p2.3" class="ltx_p">corresponding to breakings at the two negative ends, which satisfy similar associativity conditions as a general monotone multimodule.</p>
</div>
<div id="S14.SS4.SSS5.p3" class="ltx_para ltx_noindent">
<p id="S14.SS4.SSS5.p3.1" class="ltx_p">We first consider the moduli space of degree <math id="S14.SS4.SSS5.p3.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> stable maps</p>
<table id="S14.Ex107" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex107.m1" class="ltx_Math" alttext="\phi:\Sigma^{\rm PD}\to\mathbb{CP}^{d}" display="block" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi mathvariant="normal">Σ</mi><mi>PD</mi></msup><mo stretchy="false">→</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi:\Sigma^{\rm PD}\to\mathbb{CP}^{d}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS4.SSS5.p3.2" class="ltx_p">whose images are not contained in any hyperplane. As the cylindrical ends are on the negative side, in the current convention we do not impose any evaluation constraint. After the standard compactification, one obtains such a moduli space</p>
<table id="S14.Ex108" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex108.m1" class="ltx_Math" alttext="B_{d}^{\rm PD}" display="block" intent=":literal"><semantics><msubsup><mi>B</mi><mi>d</mi><mi>PD</mi></msubsup><annotation encoding="application/x-tex">B_{d}^{\rm PD}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS4.SSS5.p3.3" class="ltx_p">which has a <math id="S14.SS4.SSS5.p3.m2" class="ltx_Math" alttext="{\mathcal{G}}_{d}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>d</mi></msub><annotation encoding="application/x-tex">{\mathcal{G}}_{d}</annotation></semantics></math>-action and a universal curve <math id="S14.SS4.SSS5.p3.m3" class="ltx_Math" alttext="C_{d}^{\rm PD}\to B_{d}^{\rm PD}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>C</mi><mi>d</mi><mi>PD</mi></msubsup><mo stretchy="false">→</mo><msubsup><mi>B</mi><mi>d</mi><mi>PD</mi></msubsup></mrow><annotation encoding="application/x-tex">C_{d}^{\rm PD}\to B_{d}^{\rm PD}</annotation></semantics></math>, providing an object</p>
<table id="S14.Ex109" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex109.m1" class="ltx_Math" alttext="{\mathcal{C}}_{d}^{\rm PD}=({\mathcal{G}}_{d},B_{d}^{\rm PD},C_{d}^{\rm PD})." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>d</mi><mi>PD</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>d</mi></msub><mo>,</mo><msubsup><mi>B</mi><mi>d</mi><mi>PD</mi></msubsup><mo>,</mo><msubsup><mi>C</mi><mi>d</mi><mi>PD</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{C}}_{d}^{\rm PD}=({\mathcal{G}}_{d},B_{d}^{\rm PD},C_{d}^{\rm PD}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S14.SS4.SSS5.p4" class="ltx_para ltx_noindent">
<p id="S14.SS4.SSS5.p4.1" class="ltx_p">The structural maps are also defined similarly, but without using lateral lines. We omit the details. Hence one obtains a monotone double left module <math id="S14.SS4.SSS5.p4.m1" class="ltx_Math" alttext="\mathbb{Dom}^{\rm PD}" display="inline" intent=":literal"><semantics><mrow><mi>𝔻</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕠</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝕞</mi><mi>PD</mi></msup></mrow><annotation encoding="application/x-tex">\mathbb{Dom}^{\rm PD}</annotation></semantics></math> over <math id="S14.SS4.SSS5.p4.m2" class="ltx_Math" alttext="(\mathbb{Dom},\mathbb{Dom})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>𝔻</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕠</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕞</mi></mrow><mo>,</mo><mrow><mi>𝔻</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕠</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕞</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbb{Dom},\mathbb{Dom})</annotation></semantics></math>. Then after outercollaring, upon choosing two independent lifts <math id="S14.SS4.SSS5.p4.m3" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}_{1},{}_{\lfloor}\mathbb{Dom}_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msub><mrow></mrow><mn>1</mn></msub><mo>,</mo><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msub><mrow></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}_{1},{}_{\lfloor}\mathbb{Dom}_{2}</annotation></semantics></math> to <math id="S14.SS4.SSS5.p4.m4" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>ℂ</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}</annotation></semantics></math>, one can construct a lift <math id="S14.SS4.SSS5.p4.m5" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}^{\rm PD}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mi>PD</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}^{\rm PD}</annotation></semantics></math> to <math id="S14.SS4.SSS5.p4.m6" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>ℂ</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}</annotation></semantics></math>. We omit the details.</p>
</div>
</section>
</section>
</section>
<section id="S15" class="ltx_section">
<h3 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">15. </span>Relatively Smooth AMS lifts</h3>

<div id="S15.p1" class="ltx_para ltx_noindent">
<p id="S15.p1.1" class="ltx_p">In this section we carry out perhaps the most complex part of the AMS construction. We demonstrate how to lift an outercollaring of a Floer flow category <math id="S15.p1.m1" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> to <math id="S15.p1.m2" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf S^{\rm rel}Kur}}_{\rm rig}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mrow><msup><mi>𝐒</mi><mi>rel</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐊𝐮𝐫</mi></mrow><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf S^{\rm rel}Kur}}_{\rm rig}</annotation></semantics></math>, the category of (collared and rigidified) relatively smooth Kuranishi spaces. In fact, we will construct a lift to <math id="S15.p1.m3" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf Kur}}_{\rm rig}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐊𝐮𝐫</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf Kur}}_{\rm rig}</annotation></semantics></math>, the category of collared and rigidified topological Kuranishi spaces. The lift to relatively smooth version is automatic. The collared-and-rigidified feature is always preserved in the construction as it is a basic prerequisite for inductively construct perturbations.</p>
</div>
<section id="S15.SS1" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">15.1. </span>Integral modification of topological energy</h4>

<div id="S15.SS1.p1" class="ltx_para ltx_noindent">
<p id="S15.SS1.p1.1" class="ltx_p">We generalize the method of Rezchikov <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib6" title="" class="ltx_ref">57</a>]</cite> of modifying the topological energy. First, there is a way to modify the symplectic form.</p>
</div>
<div id="S15.Thmthm1" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S15.Thmthm1.2" class="ltx_text ltx_font_bold">Definition 15.1</span></span><span id="S15.Thmthm1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S15.Thmthm1.p1" class="ltx_para ltx_noindent">
<p id="S15.Thmthm1.p1.1" class="ltx_p">Let <math id="S15.Thmthm1.p1.m1" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> be the Floer flow category associated to a nondegenerate Hamiltonian <math id="S15.Thmthm1.p1.m2" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> on <math id="S15.Thmthm1.p1.m3" class="ltx_Math" alttext="(X,\omega,J)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>ω</mi><mo>,</mo><mi>J</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(X,\omega,J)</annotation></semantics></math>. An <span id="S15.Thmthm1.p1.1.1" class="ltx_text ltx_font_bold">integral action</span> on <math id="S15.Thmthm1.p1.m4" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> is a function</p>
<table id="S15.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex1.m1" class="ltx_Math" alttext="{\mathcal{A}}_{\mathbb{F}}^{\Omega}:{\rm Ob}{\mathbb{F}}\to{\mathbb{Z}}" display="block" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>𝔽</mi><mi mathvariant="normal">Ω</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow><mo stretchy="false">→</mo><mi>ℤ</mi></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{A}}_{\mathbb{F}}^{\Omega}:{\rm Ob}{\mathbb{F}}\to{\mathbb{Z}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.Thmthm1.p1.2" class="ltx_p">satisfying the following conditions.</p>
<ol id="S15.I1" class="ltx_enumerate">
<li id="S15.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S15.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="S15.I1.i1.p1.1" class="ltx_p">There exists an integral symplectic form <math id="S15.I1.i1.p1.m1" class="ltx_Math" alttext="\Omega\in\Omega^{2}(X)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>∈</mo><mrow><msup><mi mathvariant="normal">Ω</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Omega\in\Omega^{2}(X)</annotation></semantics></math> tamed by <math id="S15.I1.i1.p1.m2" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math> such that <math id="S15.I1.i1.p1.m3" class="ltx_Math" alttext="{\rm ker}\Omega={\rm ker}\omega\subseteq\pi_{2}(X)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ker</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Ω</mi></mrow><mo>=</mo><mrow><mi>ker</mi><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow><mo>⊆</mo><mrow><msub><mi>π</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\rm ker}\Omega={\rm ker}\omega\subseteq\pi_{2}(X)</annotation></semantics></math> and for each <math id="S15.I1.i1.p1.m4" class="ltx_Math" alttext="A\in\Pi" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow><annotation encoding="application/x-tex">A\in\Pi</annotation></semantics></math> and <math id="S15.I1.i1.p1.m5" class="ltx_Math" alttext="p\in{\rm Ob}{\mathbb{F}}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></mrow><annotation encoding="application/x-tex">p\in{\rm Ob}{\mathbb{F}}</annotation></semantics></math></p>
<table id="S15.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex2.m1" class="ltx_Math" alttext="{\mathcal{A}}_{\mathbb{F}}^{\Omega}(A\cdot p)={\mathcal{A}}^{\Omega}_{\mathbb{F}}(p)-\Omega(A)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>𝔽</mi><mi mathvariant="normal">Ω</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>𝔽</mi><mi mathvariant="normal">Ω</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{A}}_{\mathbb{F}}^{\Omega}(A\cdot p)={\mathcal{A}}^{\Omega}_{\mathbb{F}}(p)-\Omega(A).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S15.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S15.I1.i2.p1" class="ltx_para ltx_noindent">
<p id="S15.I1.i2.p1.1" class="ltx_p">There exists <math id="S15.I1.i2.p1.m1" class="ltx_Math" alttext="C&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C&gt;0</annotation></semantics></math> such that whenever <math id="S15.I1.i2.p1.m2" class="ltx_Math" alttext="p\neq q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>≠</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p\neq q</annotation></semantics></math> and <math id="S15.I1.i2.p1.m3" class="ltx_Math" alttext="M_{pq}^{\mathbb{F}}\neq\emptyset" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><mo>≠</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">M_{pq}^{\mathbb{F}}\neq\emptyset</annotation></semantics></math>, one has</p>
<table id="S15.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex3.m1" class="ltx_Math" alttext="0&lt;C\left({\mathcal{A}}_{H}(p)-{\mathcal{A}}_{H}(q)\right)\leq{\mathcal{A}}^{\Omega}_{\mathbb{F}}(p)-{\mathcal{A}}^{\Omega}_{\mathbb{F}}(q)." display="block" intent=":literal"><semantics><mrow><mrow><mn>0</mn><mo>&lt;</mo><mrow><mi>C</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>𝔽</mi><mi mathvariant="normal">Ω</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>𝔽</mi><mi mathvariant="normal">Ω</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">0&lt;C\left({\mathcal{A}}_{H}(p)-{\mathcal{A}}_{H}(q)\right)\leq{\mathcal{A}}^{\Omega}_{\mathbb{F}}(p)-{\mathcal{A}}^{\Omega}_{\mathbb{F}}(q).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
</div>
</div>
<div id="S15.SS1.p2" class="ltx_para ltx_noindent">
<p id="S15.SS1.p2.1" class="ltx_p">We need similar notions for multimodules and homotopies.</p>
</div>
<div id="S15.Thmthm2" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S15.Thmthm2.2" class="ltx_text ltx_font_bold">Definition 15.2</span></span><span id="S15.Thmthm2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S15.Thmthm2.p1" class="ltx_para ltx_noindent">
<p id="S15.Thmthm2.p1.1" class="ltx_p">Consider a smooth genus zero Riemann surface with cylindrical ends <math id="S15.Thmthm2.p1.m1" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> together with a family of Floer data <math id="S15.Thmthm2.p1.m2" class="ltx_Math" alttext="\sigma_{w}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>w</mi></msub><annotation encoding="application/x-tex">\sigma_{w}</annotation></semantics></math> parametrized continuously by <math id="S15.Thmthm2.p1.m3" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> in a compact topological space such that for all <math id="S15.Thmthm2.p1.m4" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math>, the Floer data is asymptotic to <math id="S15.Thmthm2.p1.m5" class="ltx_Math" alttext="(H_{i}dt,J_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msub><mi>H</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>,</mo><msub><mi>J</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(H_{i}dt,J_{i})</annotation></semantics></math> on the <math id="S15.Thmthm2.p1.m6" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th negative end (<math id="S15.Thmthm2.p1.m7" class="ltx_Math" alttext="i=1,\ldots,m" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">i=1,\ldots,m</annotation></semantics></math>) and asymptotic to <math id="S15.Thmthm2.p1.m8" class="ltx_Math" alttext="(H_{j}^{\prime}dt,J_{j}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>H</mi><mi>j</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>,</mo><msubsup><mi>J</mi><mi>j</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(H_{j}^{\prime}dt,J_{j}^{\prime})</annotation></semantics></math> on the <math id="S15.Thmthm2.p1.m9" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>-th positive end (<math id="S15.Thmthm2.p1.m10" class="ltx_Math" alttext="j=1,\ldots,n" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">j=1,\ldots,n</annotation></semantics></math>). A compatible collection of integral actions consists of integral actions</p>
<table id="S15.EGx52" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S15.Ex4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S15.Ex4.m1" class="ltx_Math" alttext="\displaystyle\ {\mathcal{A}}_{{\mathbb{F}}_{i}}^{\Omega}:{\rm Ob}{\mathbb{F}}_{i}\to{\mathbb{Z}}\ (i=1,\ldots,m),\ " display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mi>𝔽</mi><mi>i</mi></msub><mi mathvariant="normal">Ω</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔽</mi><mi>i</mi></msub></mrow><mo stretchy="false">→</mo><mrow><mi>ℤ</mi><mo lspace="0.500em">⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ {\mathcal{A}}_{{\mathbb{F}}_{i}}^{\Omega}:{\rm Ob}{\mathbb{F}}_{i}\to{\mathbb{Z}}\ (i=1,\ldots,m),\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S15.Ex4.m2" class="ltx_Math" alttext="\displaystyle\ {\mathcal{A}}_{{\mathbb{F}}_{j}^{\prime}}^{\Omega}:{\rm Ob}{\mathbb{F}}_{j}^{\prime}\to{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msubsup><mi>𝔽</mi><mi>j</mi><mo>′</mo></msubsup><mi mathvariant="normal">Ω</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝔽</mi><mi>j</mi><mo>′</mo></msubsup></mrow><mo stretchy="false">→</mo><mi>ℤ</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ {\mathcal{A}}_{{\mathbb{F}}_{j}^{\prime}}^{\Omega}:{\rm Ob}{\mathbb{F}}_{j}^{\prime}\to{\mathbb{Z}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.Thmthm2.p1.2" class="ltx_p">on the Floer flow categories <math id="S15.Thmthm2.p1.m11" class="ltx_Math" alttext="{\mathbb{F}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝔽</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\mathbb{F}}_{i}</annotation></semantics></math> resp. <math id="S15.Thmthm2.p1.m12" class="ltx_Math" alttext="{\mathbb{F}}_{j}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔽</mi><mi>j</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathbb{F}}_{j}^{\prime}</annotation></semantics></math> associated to <math id="S15.Thmthm2.p1.m13" class="ltx_Math" alttext="(H_{i},J_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mi>i</mi></msub><mo>,</mo><msub><mi>J</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(H_{i},J_{i})</annotation></semantics></math> resp. <math id="S15.Thmthm2.p1.m14" class="ltx_Math" alttext="(H_{j}^{\prime},J_{j}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msubsup><mi>H</mi><mi>j</mi><mo>′</mo></msubsup><mo>,</mo><msubsup><mi>J</mi><mi>j</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(H_{j}^{\prime},J_{j}^{\prime})</annotation></semantics></math> satisfying the following conditions.</p>
<ol id="S15.I2" class="ltx_enumerate">
<li id="S15.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S15.I2.i1.p1" class="ltx_para ltx_noindent">
<p id="S15.I2.i1.p1.1" class="ltx_p">The integral actions induce the same integral symplectic form <math id="S15.I2.i1.p1.m1" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math>.</p>
</div></li>
<li id="S15.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S15.I2.i2.p1" class="ltx_para ltx_noindent">
<p id="S15.I2.i2.p1.1" class="ltx_p">For each parameter <math id="S15.I2.i2.p1.m1" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> and each point <math id="S15.I2.i2.p1.m2" class="ltx_Math" alttext="z\in\Sigma" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>∈</mo><mi mathvariant="normal">Σ</mi></mrow><annotation encoding="application/x-tex">z\in\Sigma</annotation></semantics></math>, <math id="S15.I2.i2.p1.m3" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math> is tamed by the almost complex structure <math id="S15.I2.i2.p1.m4" class="ltx_Math" alttext="J_{w,z}" display="inline" intent=":literal"><semantics><msub><mi>J</mi><mrow><mi>w</mi><mo>,</mo><mi>z</mi></mrow></msub><annotation encoding="application/x-tex">J_{w,z}</annotation></semantics></math>.</p>
</div></li>
<li id="S15.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S15.I2.i3.p1" class="ltx_para ltx_noindent">
<p id="S15.I2.i3.p1.1" class="ltx_p">For objects <math id="S15.I2.i3.p1.m1" class="ltx_Math" alttext="p_{i}\in{\rm Ob}{\mathbb{F}}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>i</mi></msub><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔽</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">p_{i}\in{\rm Ob}{\mathbb{F}}_{i}</annotation></semantics></math> and <math id="S15.I2.i3.p1.m2" class="ltx_Math" alttext="p_{j}^{\prime}\in{\rm Ob}{\mathbb{F}}_{j}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>p</mi><mi>j</mi><mo>′</mo></msubsup><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝔽</mi><mi>j</mi><mo>′</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">p_{j}^{\prime}\in{\rm Ob}{\mathbb{F}}_{j}^{\prime}</annotation></semantics></math>, let <math id="S15.I2.i3.p1.m3" class="ltx_math_unparsed" alttext="M_{p_{1}\cdots p_{m};p_{1}^{\prime}\cdots p_{n}^{\prime}}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><msup><mrow></mrow><mo>′</mo></msup><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>n</mi></msub><msup><mrow></mrow><mo>′</mo></msup></mrow></msub></mrow><annotation encoding="application/x-tex">M_{p_{1}\cdots p_{m};p_{1}^{\prime}\cdots p_{n}^{\prime}}</annotation></semantics></math> denote temporarily the moduli space of stable solutions of Floer equation for all parameter <math id="S15.I2.i3.p1.m4" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> asymptotic to the labeling objects. Then</p>
<table id="S15.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex5.m1" class="ltx_math_unparsed" alttext="M_{p_{1}\cdots p_{m};p_{1}^{\prime}\cdots p_{n}^{\prime}}\neq\emptyset\Longrightarrow\sum_{i=1}^{m}{\mathcal{A}}_{{\mathbb{F}}_{i}}^{\Omega}(p_{i})&gt;\sum_{j=1}^{n}{\mathcal{A}}_{{\mathbb{F}}_{j}^{\prime}}^{\Omega}(p_{j}^{\prime})" display="block" intent=":literal"><semantics><mrow><msub><mi>M</mi><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><msup><mrow></mrow><mo>′</mo></msup><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>n</mi></msub><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo>≠</mo><mi mathvariant="normal">∅</mi><mo rspace="0.111em" stretchy="false">⟹</mo><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mi>𝔽</mi><mi>i</mi></msub><mi mathvariant="normal">Ω</mi></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">&gt;</mo><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msubsup><mi>𝔽</mi><mi>j</mi><mo>′</mo></msubsup><mi mathvariant="normal">Ω</mi></msubsup><mrow><mo stretchy="false">(</mo><msubsup><mi>p</mi><mi>j</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M_{p_{1}\cdots p_{m};p_{1}^{\prime}\cdots p_{n}^{\prime}}\neq\emptyset\Longrightarrow\sum_{i=1}^{m}{\mathcal{A}}_{{\mathbb{F}}_{i}}^{\Omega}(p_{i})&gt;\sum_{j=1}^{n}{\mathcal{A}}_{{\mathbb{F}}_{j}^{\prime}}^{\Omega}(p_{j}^{\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
</div>
</div>
<div id="S15.SS1.p3" class="ltx_para ltx_noindent">
<p id="S15.SS1.p3.1" class="ltx_p">One can then specialize to multimodules and homotopies.</p>
</div>
<div id="S15.Thmthm3" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S15.Thmthm3.2" class="ltx_text ltx_font_bold">Definition 15.3</span></span><span id="S15.Thmthm3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S15.Thmthm3.p1" class="ltx_para">
<ol id="S15.I3" class="ltx_enumerate">
<li id="S15.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S15.I3.i1.p1" class="ltx_para ltx_noindent">
<p id="S15.I3.i1.p1.1" class="ltx_p">In Situation <a href="#Thmsituationm1" title="Situation Module(i). ‣ 10.2. Multimodules from smooth domains ‣ 10. Geometric Multimodules ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Module(i)</span></a>, integral actions <math id="S15.I3.i1.p1.m1" class="ltx_Math" alttext="{\mathcal{A}}_{{\mathbb{F}}_{1}}^{\Omega},\ldots,{\mathcal{A}}_{{\mathbb{F}}_{m}}^{\Omega};{\mathcal{A}}_{{\mathbb{F}}^{\prime}}^{\Omega}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mi>𝔽</mi><mn>1</mn></msub><mi mathvariant="normal">Ω</mi></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mi>𝔽</mi><mi>m</mi></msub><mi mathvariant="normal">Ω</mi></msubsup><mo>;</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msup><mi>𝔽</mi><mo>′</mo></msup><mi mathvariant="normal">Ω</mi></msubsup></mrow><annotation encoding="application/x-tex">{\mathcal{A}}_{{\mathbb{F}}_{1}}^{\Omega},\ldots,{\mathcal{A}}_{{\mathbb{F}}_{m}}^{\Omega};{\mathcal{A}}_{{\mathbb{F}}^{\prime}}^{\Omega}</annotation></semantics></math> on the involved flow categories are called <span id="S15.I3.i1.p1.1.1" class="ltx_text ltx_font_bold">compatible</span> with respect to <math id="S15.I3.i1.p1.m2" class="ltx_Math" alttext="{\mathbb{X}}" display="inline" intent=":literal"><semantics><mi>𝕏</mi><annotation encoding="application/x-tex">{\mathbb{X}}</annotation></semantics></math> if it is compatible with respect to the fixed Floer data <math id="S15.I3.i1.p1.m3" class="ltx_Math" alttext="\sigma^{\mathbb{X}}" display="inline" intent=":literal"><semantics><msup><mi>σ</mi><mi>𝕏</mi></msup><annotation encoding="application/x-tex">\sigma^{\mathbb{X}}</annotation></semantics></math> on <math id="S15.I3.i1.p1.m4" class="ltx_Math" alttext="\Sigma^{\mathbb{X}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Σ</mi><mi>𝕏</mi></msup><annotation encoding="application/x-tex">\Sigma^{\mathbb{X}}</annotation></semantics></math>.</p>
</div></li>
<li id="S15.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S15.I3.i2.p1" class="ltx_para ltx_noindent">
<p id="S15.I3.i2.p1.1" class="ltx_p">In Situation <a href="#Thmsituationh1" title="Situation Homotopy(i). ‣ 11.1. Homotopies from varying Floer data ‣ 11. Homotopies of Multimodules ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Homotopy(i)</span></a>, integral actions <math id="S15.I3.i2.p1.m1" class="ltx_Math" alttext="{\mathcal{A}}_{{\mathbb{F}}_{1}}^{\Omega},\ldots,{\mathcal{A}}_{{\mathbb{F}}_{m}}^{\Omega},{\mathcal{A}}_{{\mathbb{F}}^{\prime}}^{\Omega}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mi>𝔽</mi><mn>1</mn></msub><mi mathvariant="normal">Ω</mi></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mi>𝔽</mi><mi>m</mi></msub><mi mathvariant="normal">Ω</mi></msubsup><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msup><mi>𝔽</mi><mo>′</mo></msup><mi mathvariant="normal">Ω</mi></msubsup></mrow><annotation encoding="application/x-tex">{\mathcal{A}}_{{\mathbb{F}}_{1}}^{\Omega},\ldots,{\mathcal{A}}_{{\mathbb{F}}_{m}}^{\Omega},{\mathcal{A}}_{{\mathbb{F}}^{\prime}}^{\Omega}</annotation></semantics></math> are called <span id="S15.I3.i2.p1.1.1" class="ltx_text ltx_font_bold">compatible</span> with respect to <math id="S15.I3.i2.p1.m2" class="ltx_Math" alttext="{\mathbb{H}}" display="inline" intent=":literal"><semantics><mi>ℍ</mi><annotation encoding="application/x-tex">{\mathbb{H}}</annotation></semantics></math> if it is compatible with respect to the 1-parameter family of Floer data.</p>
</div></li>
</ol>
</div>
</div>
<div id="S15.Thmthm4" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S15.Thmthm4.2" class="ltx_text ltx_font_bold">Proposition 15.4</span></span><span id="S15.Thmthm4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S15.Thmthm4.p1" class="ltx_para">
<p id="S15.Thmthm4.p1.1" class="ltx_p"><span id="S15.Thmthm4.p1.1.1" class="ltx_text ltx_font_italic">In the setting of Definition <a href="#S15.Thmthm2" title="Definition 15.2. ‣ 15.1. Integral modification of topological energy ‣ 15. Relatively Smooth AMS lifts ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15.2</span></a>, there exist compatible integral actions on involved Floer flow categories.</span></p>
</div>
</div>
<div id="S15.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S15.SS1.p4" class="ltx_para ltx_noindent">
<p id="S15.SS1.p4.1" class="ltx_p"><span id="S15.SS1.p4.1.1" class="ltx_text">It was proved in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib6" title="" class="ltx_ref">57</a>, Lemma 16]</cite> that given any collection <math id="S15.SS1.p4.m1" class="ltx_Math" alttext="H_{1},\ldots,H_{m}" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>H</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">H_{1},\ldots,H_{m}</annotation></semantics></math> of nondegenerate 1-periodic Hamiltonians on <math id="S15.SS1.p4.m2" class="ltx_Math" alttext="(X,\omega)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>ω</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(X,\omega)</annotation></semantics></math>, there exists an open subset <math id="S15.SS1.p4.m3" class="ltx_Math" alttext="U\subseteq X" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⊆</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">U\subseteq X</annotation></semantics></math> containing the images of all 1-periodic orbits of all <math id="S15.SS1.p4.m4" class="ltx_Math" alttext="H_{i}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mi>i</mi></msub><annotation encoding="application/x-tex">H_{i}</annotation></semantics></math> and for any <math id="S15.SS1.p4.m5" class="ltx_Math" alttext="\epsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon&gt;0</annotation></semantics></math>, a rational symplectic form <math id="S15.SS1.p4.m6" class="ltx_Math" alttext="\Omega\in\Omega^{2}(M)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>∈</mo><mrow><msup><mi mathvariant="normal">Ω</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Omega\in\Omega^{2}(M)</annotation></semantics></math> satisfying the following conditions.</span></p>
<ol id="S15.I4" class="ltx_enumerate">
<li id="S15.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S15.I4.i1.p1" class="ltx_para ltx_noindent">
<p id="S15.I4.i1.p1.1" class="ltx_p"><math id="S15.I4.i1.p1.m1" class="ltx_Math" alttext="\Omega|_{U}=\omega|_{U}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mi mathvariant="normal">Ω</mi><mo stretchy="false">|</mo></mrow><mi>U</mi></msub><mo>=</mo><msub><mrow><mi>ω</mi><mo stretchy="false">|</mo></mrow><mi>U</mi></msub></mrow><annotation encoding="application/x-tex">\Omega|_{U}=\omega|_{U}</annotation></semantics></math>.</p>
</div></li>
<li id="S15.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S15.I4.i2.p1" class="ltx_para ltx_noindent">
<p id="S15.I4.i2.p1.1" class="ltx_p"><math id="S15.I4.i2.p1.m1" class="ltx_Math" alttext="\|\Omega-\omega\|_{C^{0}(X)}\leq\epsilon" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi mathvariant="normal">Ω</mi><mo>−</mo><mi>ω</mi></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>C</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>≤</mo><mi>ϵ</mi></mrow><annotation encoding="application/x-tex">\|\Omega-\omega\|_{C^{0}(X)}\leq\epsilon</annotation></semantics></math>.</p>
</div></li>
<li id="S15.I4.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S15.I4.i3.p1" class="ltx_para">
<p id="S15.I4.i3.p1.1" class="ltx_p"><math id="S15.I4.i3.p1.m1" class="ltx_Math" alttext="{\rm ker}\Omega={\rm ker}\omega\subseteq\pi_{2}(X)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ker</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Ω</mi></mrow><mo>=</mo><mrow><mi>ker</mi><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow><mo>⊆</mo><mrow><msub><mi>π</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\rm ker}\Omega={\rm ker}\omega\subseteq\pi_{2}(X)</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
<div id="S15.SS1.p5" class="ltx_para ltx_noindent">
<p id="S15.SS1.p5.1" class="ltx_p"><span id="S15.SS1.p5.1.1" class="ltx_text">Now consider a Floer domain <math id="S15.SS1.p5.m1" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> with the Hamiltonian connection <math id="S15.SS1.p5.m2" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math>. Let <math id="S15.SS1.p5.m3" class="ltx_Math" alttext="\Sigma_{0}\subseteq\Sigma" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mn>0</mn></msub><mo>⊆</mo><mi mathvariant="normal">Σ</mi></mrow><annotation encoding="application/x-tex">\Sigma_{0}\subseteq\Sigma</annotation></semantics></math> be a compact region such that <math id="S15.SS1.p5.m4" class="ltx_Math" alttext="\Sigma\setminus\Sigma_{0}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Σ</mi><mo>∖</mo><msub><mi mathvariant="normal">Σ</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\Sigma\setminus\Sigma_{0}</annotation></semantics></math> is a union of half cylinders. Let <math id="S15.SS1.p5.m5" class="ltx_Math" alttext="(s,t)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(s,t)</annotation></semantics></math> be the cylindrical coordinates and let <math id="S15.SS1.p5.m6" class="ltx_Math" alttext="H_{i}dt" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">H_{i}dt</annotation></semantics></math> be the restriction of <math id="S15.SS1.p5.m7" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> to the <math id="S15.SS1.p5.m8" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th cylindrical end <math id="S15.SS1.p5.m9" class="ltx_Math" alttext="U_{i}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mi>i</mi></msub><annotation encoding="application/x-tex">U_{i}</annotation></semantics></math>, where <math id="S15.SS1.p5.m10" class="ltx_Math" alttext="H_{i}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mi>i</mi></msub><annotation encoding="application/x-tex">H_{i}</annotation></semantics></math> is nondegenerate.</span></p>
</div>
<div id="S15.SS1.p6" class="ltx_para ltx_noindent">
<p id="S15.SS1.p6.1" class="ltx_p"><span id="S15.SS1.p6.1.1" class="ltx_text">Let <math id="S15.SS1.p6.m1" class="ltx_Math" alttext="U\subseteq X" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⊆</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">U\subseteq X</annotation></semantics></math> be the open subset provided by Rezchikov’s lemma. Let <math id="S15.SS1.p6.m2" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math> be a symplectic form which agrees with <math id="S15.SS1.p6.m3" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math> within <math id="S15.SS1.p6.m4" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> and which is <math id="S15.SS1.p6.m5" class="ltx_Math" alttext="C^{0}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mn>0</mn></msup><annotation encoding="application/x-tex">C^{0}</annotation></semantics></math>-close to <math id="S15.SS1.p6.m6" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math> so <math id="S15.SS1.p6.m7" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math> tames <math id="S15.SS1.p6.m8" class="ltx_Math" alttext="J_{w,z}" display="inline" intent=":literal"><semantics><msub><mi>J</mi><mrow><mi>w</mi><mo>,</mo><mi>z</mi></mrow></msub><annotation encoding="application/x-tex">J_{w,z}</annotation></semantics></math> for all almost complex structures appearing. Then there exists <math id="S15.SS1.p6.m9" class="ltx_Math" alttext="\epsilon_{0}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϵ</mi><mn>0</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon_{0}&gt;0</annotation></semantics></math> satisfying</span></p>
<table id="S15.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.E1.m1" class="ltx_Math" alttext="\forall i\ \ \forall\rho:S^{1}\to X,\ \int_{S^{1}}|\rho^{\prime}(t)-X_{H_{i,t}}(\rho(t))|^{2}dt\leq\epsilon_{0}\Longrightarrow{\rm Im}(\rho)\subseteq U." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mo rspace="0.167em">∀</mo><mi>i</mi></mrow><mspace style="width:1.167em;" width="1.167em"></mspace><mrow><mo rspace="0.167em">∀</mo><mi>ρ</mi></mrow></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>S</mi><mn>1</mn></msup><mo stretchy="false">→</mo><mi>X</mi></mrow></mrow><mo rspace="0.500em">,</mo><mrow><mrow><msub><mo rspace="0em">∫</mo><msup><mi>S</mi><mn>1</mn></msup></msub><mrow><msup><mrow><mo stretchy="false">|</mo><mrow><mrow><msup><mi>ρ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>X</mi><msub><mi>H</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow><mo>≤</mo><msub><mi>ϵ</mi><mn>0</mn></msub><mo stretchy="false">⟹</mo><mrow><mi>Im</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊆</mo><mi>U</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\forall i\ \ \forall\rho:S^{1}\to X,\ \int_{S^{1}}|\rho^{\prime}(t)-X_{H_{i,t}}(\rho(t))|^{2}dt\leq\epsilon_{0}\Longrightarrow{\rm Im}(\rho)\subseteq U.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15.1)</span></td></tr></tbody>
</table>
<p id="S15.SS1.p6.2" class="ltx_p"><span id="S15.SS1.p6.2.1" class="ltx_text">For each capped 1-periodic orbit <math id="S15.SS1.p6.m10" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> of <math id="S15.SS1.p6.m11" class="ltx_Math" alttext="H_{i}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mi>i</mi></msub><annotation encoding="application/x-tex">H_{i}</annotation></semantics></math> where the capping is a map <math id="S15.SS1.p6.m12" class="ltx_Math" alttext="u:{\mathbb{D}}^{2}\to X" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>𝔻</mi><mn>2</mn></msup><mo stretchy="false">→</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">u:{\mathbb{D}}^{2}\to X</annotation></semantics></math>, define</span></p>
<table id="S15.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex6.m1" class="ltx_math_unparsed" alttext="{\mathcal{A}}_{H_{i}}^{\Omega}(\gamma,u)=-\int_{{\mathbb{D}}^{2}}u^{*}\Omega-\int_{S^{1}}H_{i}(\gamma(t))dt." display="block" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mi>H</mi><mi>i</mi></msub><mi mathvariant="normal">Ω</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em" rspace="0.055em">−</mo><msub><mo>∫</mo><msup><mi>𝔻</mi><mn>2</mn></msup></msub><msup><mi>u</mi><mo>∗</mo></msup><mi mathvariant="normal">Ω</mi><mo rspace="0.055em">−</mo><msub><mo>∫</mo><msup><mi>S</mi><mn>1</mn></msup></msub><msub><mi>H</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>γ</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mi>d</mi><mi>t</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{A}}_{H_{i}}^{\Omega}(\gamma,u)=-\int_{{\mathbb{D}}^{2}}u^{*}\Omega-\int_{S^{1}}H_{i}(\gamma(t))dt.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S15.SS1.p7" class="ltx_para ltx_noindent">
<p id="S15.SS1.p7.1" class="ltx_p"><span id="S15.SS1.p7.1.1" class="ltx_text">Let <math id="S15.SS1.p7.m1" class="ltx_math_unparsed" alttext="|\cdot|_{\Omega}" display="inline" intent=":literal"><semantics><mrow><mo fence="false" stretchy="false">|</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" stretchy="false">|</mo><msub><mrow></mrow><mi mathvariant="normal">Ω</mi></msub></mrow><annotation encoding="application/x-tex">|\cdot|_{\Omega}</annotation></semantics></math> be the norm on the tangent bundle <math id="S15.SS1.p7.m2" class="ltx_Math" alttext="TX" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">TX</annotation></semantics></math> determined by <math id="S15.SS1.p7.m3" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math> and <math id="S15.SS1.p7.m4" class="ltx_Math" alttext="J_{w,z}" display="inline" intent=":literal"><semantics><msub><mi>J</mi><mrow><mi>w</mi><mo>,</mo><mi>z</mi></mrow></msub><annotation encoding="application/x-tex">J_{w,z}</annotation></semantics></math>. For any map <math id="S15.SS1.p7.m5" class="ltx_Math" alttext="u:\Sigma\to X" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">u:\Sigma\to X</annotation></semantics></math>, define</span></p>
<table id="S15.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex7.m1" class="ltx_Math" alttext="\nabla^{\sigma,\Omega}(u)=\nabla u+X_{\sigma}^{\Omega}(u)" display="block" intent=":literal"><semantics><mrow><mrow><msup><mo>∇</mo><mrow><mi>σ</mi><mo>,</mo><mi mathvariant="normal">Ω</mi></mrow></msup><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>u</mi></mrow><mo>+</mo><mrow><msubsup><mi>X</mi><mi>σ</mi><mi mathvariant="normal">Ω</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\nabla^{\sigma,\Omega}(u)=\nabla u+X_{\sigma}^{\Omega}(u)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS1.p7.2" class="ltx_p"><span id="S15.SS1.p7.2.1" class="ltx_text">where <math id="S15.SS1.p7.m6" class="ltx_Math" alttext="X_{\sigma}^{\Omega}" display="inline" intent=":literal"><semantics><msubsup><mi>X</mi><mi>σ</mi><mi mathvariant="normal">Ω</mi></msubsup><annotation encoding="application/x-tex">X_{\sigma}^{\Omega}</annotation></semantics></math> is the 1-form on <math id="S15.SS1.p7.m7" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> taking values in Hamiltonian vector fields associated to <math id="S15.SS1.p7.m8" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math>. In any local coordinate <math id="S15.SS1.p7.m9" class="ltx_Math" alttext="z=s+{\bf i}t" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>=</mo><mrow><mi>s</mi><mo>+</mo><mrow><mi>𝐢</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">z=s+{\bf i}t</annotation></semantics></math> one can write <math id="S15.SS1.p7.m10" class="ltx_Math" alttext="\sigma=\sigma_{s}ds+\sigma_{t}dt" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>=</mo><mrow><mrow><msub><mi>σ</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>+</mo><mrow><msub><mi>σ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\sigma=\sigma_{s}ds+\sigma_{t}dt</annotation></semantics></math> and</span></p>
<table id="S15.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex8.m1" class="ltx_Math" alttext="\nabla^{\sigma,\Omega}u=\nabla_{s}^{\sigma,\Omega}uds+\nabla_{t}^{\sigma,\Omega}udt." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mo>∇</mo><mrow><mi>σ</mi><mo>,</mo><mi mathvariant="normal">Ω</mi></mrow></msup><mi>u</mi></mrow><mo>=</mo><mrow><mrow><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>s</mi><mrow><mi>σ</mi><mo>,</mo><mi mathvariant="normal">Ω</mi></mrow></msubsup><mi>u</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>+</mo><mrow><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>t</mi><mrow><mi>σ</mi><mo>,</mo><mi mathvariant="normal">Ω</mi></mrow></msubsup><mi>u</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\nabla^{\sigma,\Omega}u=\nabla_{s}^{\sigma,\Omega}uds+\nabla_{t}^{\sigma,\Omega}udt.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS1.p7.3" class="ltx_p"><span id="S15.SS1.p7.3.1" class="ltx_text">The difference of the covariant derivatives between <math id="S15.SS1.p7.m11" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math> and <math id="S15.SS1.p7.m12" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math> is</span></p>
<table id="S15.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex9.m1" class="ltx_Math" alttext="\nabla^{\sigma,\Omega}u-\nabla^{\sigma,\omega}u=(X_{\sigma_{s}}^{\Omega}(u)-X_{\sigma_{s}}^{\omega}(u))ds+(X_{\sigma_{t}}^{\Omega}(u)-X_{\sigma_{t}}^{\omega}(u))dt=:X_{\sigma_{s}}^{\Omega-\omega}(u)ds+X_{\sigma_{t}}^{\Omega-\omega}(u)dt" display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mo>∇</mo><mrow><mi>σ</mi><mo>,</mo><mi mathvariant="normal">Ω</mi></mrow></msup><mi>u</mi></mrow><mo>−</mo><mrow><msup><mo rspace="0.167em">∇</mo><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msup><mi>u</mi></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>X</mi><msub><mi>σ</mi><mi>s</mi></msub><mi mathvariant="normal">Ω</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>X</mi><msub><mi>σ</mi><mi>s</mi></msub><mi>ω</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>X</mi><msub><mi>σ</mi><mi>t</mi></msub><mi mathvariant="normal">Ω</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>X</mi><msub><mi>σ</mi><mi>t</mi></msub><mi>ω</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo>=</mo><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mi>X</mi><msub><mi>σ</mi><mi>s</mi></msub><mrow><mi mathvariant="normal">Ω</mi><mo>−</mo><mi>ω</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>+</mo><mrow><msubsup><mi>X</mi><msub><mi>σ</mi><mi>t</mi></msub><mrow><mi mathvariant="normal">Ω</mi><mo>−</mo><mi>ω</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\nabla^{\sigma,\Omega}u-\nabla^{\sigma,\omega}u=(X_{\sigma_{s}}^{\Omega}(u)-X_{\sigma_{s}}^{\omega}(u))ds+(X_{\sigma_{t}}^{\Omega}(u)-X_{\sigma_{t}}^{\omega}(u))dt=:X_{\sigma_{s}}^{\Omega-\omega}(u)ds+X_{\sigma_{t}}^{\Omega-\omega}(u)dt</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS1.p7.4" class="ltx_p"><span id="S15.SS1.p7.4.1" class="ltx_text">which is linear in the difference <math id="S15.SS1.p7.m13" class="ltx_Math" alttext="\Omega-\omega" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>−</mo><mi>ω</mi></mrow><annotation encoding="application/x-tex">\Omega-\omega</annotation></semantics></math>.</span></p>
</div>
<div id="S15.SS1.p8" class="ltx_para ltx_noindent">
<p id="S15.SS1.p8.1" class="ltx_p"><span id="S15.SS1.p8.1.1" class="ltx_text">Define the energy density of the map <math id="S15.SS1.p8.m1" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> as</span></p>
<table id="S15.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex10.m1" class="ltx_Math" alttext="\frac{1}{2}|\nabla^{\sigma,\omega}(u)|_{\Omega}^{2}{\rm dvol}_{\Sigma}." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">|</mo><mrow><msup><mo>∇</mo><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msup><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">Ω</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>dvol</mi><mi mathvariant="normal">Σ</mi></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{1}{2}|\nabla^{\sigma,\omega}(u)|_{\Omega}^{2}{\rm dvol}_{\Sigma}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS1.p8.2" class="ltx_p"><span id="S15.SS1.p8.2.1" class="ltx_text">Then one has the calculation (see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib67" title="" class="ltx_ref">46</a>, Lemma 2.2.1]</cite>)</span></p>
<table id="S15.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex11.m1" class="ltx_Math" alttext="\frac{1}{2}|\nabla^{\sigma,\omega}(u)|_{\Omega}^{2}{\rm dvol}_{\Sigma}=|(\nabla^{\sigma,\omega}(u))^{0,1}|^{2}{\rm dvol}_{\Sigma}+\frac{1}{2}\Big(\Omega(\nabla_{s}^{\sigma,\omega}u,\nabla_{t}^{\sigma,\omega}u)+\Omega(J\nabla_{s}^{\sigma,\omega}u,J\nabla_{t}^{\sigma,\omega}u)\Big)dsdt." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">|</mo><mrow><msup><mo>∇</mo><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msup><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">Ω</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>dvol</mi><mi mathvariant="normal">Σ</mi></msub></mrow><mo>=</mo><mrow><mrow><msup><mrow><mo stretchy="false">|</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mo>∇</mo><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msup><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msup><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>dvol</mi><mi mathvariant="normal">Σ</mi></msub></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>s</mi><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msubsup><mi>u</mi></mrow><mo>,</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>t</mi><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msubsup><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>J</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>s</mi><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msubsup><mi>u</mi></mrow></mrow><mo>,</mo><mrow><mi>J</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>t</mi><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msubsup><mi>u</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{1}{2}|\nabla^{\sigma,\omega}(u)|_{\Omega}^{2}{\rm dvol}_{\Sigma}=|(\nabla^{\sigma,\omega}(u))^{0,1}|^{2}{\rm dvol}_{\Sigma}+\frac{1}{2}\Big(\Omega(\nabla_{s}^{\sigma,\omega}u,\nabla_{t}^{\sigma,\omega}u)+\Omega(J\nabla_{s}^{\sigma,\omega}u,J\nabla_{t}^{\sigma,\omega}u)\Big)dsdt.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS1.p8.3" class="ltx_p"><span id="S15.SS1.p8.3.1" class="ltx_text">We observe that</span></p>
<table id="S15.E2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.E2.m1" class="ltx_Math" alttext="\begin{split}&amp;\ |\Omega(J\nabla_{s}^{\sigma,\omega}u,J\nabla_{t}^{\sigma,\omega}u)-\Omega(\nabla_{s}^{\sigma,\omega}u,\nabla_{t}^{\sigma,\omega}u)|\\
=&amp;\ |\Omega(J\nabla_{s}^{\sigma,\omega}u,J\nabla_{t}^{\sigma,\omega}u)-\omega(J\nabla_{s}^{\sigma,\omega}u,J\nabla_{t}^{\sigma,\omega}u)+\omega(J\nabla_{s}^{\sigma,\omega}u,J\nabla_{t}^{\sigma,\omega}u)-\Omega(\nabla_{s}^{\sigma,\omega}u,\nabla_{t}^{\sigma,\omega}u)|\\
=&amp;\ |\Omega(J\nabla_{s}^{\sigma,\omega}u,J\nabla_{t}^{\sigma,\omega}u)-\omega(J\nabla_{s}^{\sigma,\omega}u,J\nabla_{t}^{\sigma,\omega}u)+\omega(\nabla_{s}^{\sigma,\omega}u,\nabla_{t}^{\sigma,\omega}u)-\Omega(\nabla_{s}^{\sigma,\omega}u,\nabla_{t}^{\sigma,\omega}u)|\\
\leq&amp;\ \|\omega-\Omega\|_{C^{0}(X)}\cdot|\nabla^{\sigma,\omega}(u)|_{\Omega}^{2}\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo stretchy="false">|</mo><mrow><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>J</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>s</mi><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msubsup><mi>u</mi></mrow></mrow><mo>,</mo><mrow><mi>J</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>t</mi><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msubsup><mi>u</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>s</mi><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msubsup><mi>u</mi></mrow><mo>,</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>t</mi><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msubsup><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo stretchy="false">|</mo><mrow><mrow><mrow><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>J</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>s</mi><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msubsup><mi>u</mi></mrow></mrow><mo>,</mo><mrow><mi>J</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>t</mi><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msubsup><mi>u</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>J</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>s</mi><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msubsup><mi>u</mi></mrow></mrow><mo>,</mo><mrow><mi>J</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>t</mi><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msubsup><mi>u</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>J</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>s</mi><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msubsup><mi>u</mi></mrow></mrow><mo>,</mo><mrow><mi>J</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>t</mi><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msubsup><mi>u</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>s</mi><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msubsup><mi>u</mi></mrow><mo>,</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>t</mi><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msubsup><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo stretchy="false">|</mo><mrow><mrow><mrow><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>J</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>s</mi><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msubsup><mi>u</mi></mrow></mrow><mo>,</mo><mrow><mi>J</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>t</mi><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msubsup><mi>u</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>J</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>s</mi><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msubsup><mi>u</mi></mrow></mrow><mo>,</mo><mrow><mi>J</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>t</mi><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msubsup><mi>u</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>s</mi><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msubsup><mi>u</mi></mrow><mo>,</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>t</mi><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msubsup><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>s</mi><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msubsup><mi>u</mi></mrow><mo>,</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>t</mi><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msubsup><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>≤</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>ω</mi><mo>−</mo><mi mathvariant="normal">Ω</mi></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>C</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mrow><mo stretchy="false">|</mo><mrow><msup><mo>∇</mo><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msup><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">Ω</mi><mn>2</mn></msubsup></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}&amp;\ |\Omega(J\nabla_{s}^{\sigma,\omega}u,J\nabla_{t}^{\sigma,\omega}u)-\Omega(\nabla_{s}^{\sigma,\omega}u,\nabla_{t}^{\sigma,\omega}u)|\\
=&amp;\ |\Omega(J\nabla_{s}^{\sigma,\omega}u,J\nabla_{t}^{\sigma,\omega}u)-\omega(J\nabla_{s}^{\sigma,\omega}u,J\nabla_{t}^{\sigma,\omega}u)+\omega(J\nabla_{s}^{\sigma,\omega}u,J\nabla_{t}^{\sigma,\omega}u)-\Omega(\nabla_{s}^{\sigma,\omega}u,\nabla_{t}^{\sigma,\omega}u)|\\
=&amp;\ |\Omega(J\nabla_{s}^{\sigma,\omega}u,J\nabla_{t}^{\sigma,\omega}u)-\omega(J\nabla_{s}^{\sigma,\omega}u,J\nabla_{t}^{\sigma,\omega}u)+\omega(\nabla_{s}^{\sigma,\omega}u,\nabla_{t}^{\sigma,\omega}u)-\Omega(\nabla_{s}^{\sigma,\omega}u,\nabla_{t}^{\sigma,\omega}u)|\\
\leq&amp;\ \|\omega-\Omega\|_{C^{0}(X)}\cdot|\nabla^{\sigma,\omega}(u)|_{\Omega}^{2}\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15.2)</span></td></tr></tbody>
</table>
</div>
<div id="S15.SS1.p9" class="ltx_para ltx_noindent">
<p id="S15.SS1.p9.1" class="ltx_p"><span id="S15.SS1.p9.1.1" class="ltx_text">Now suppose <math id="S15.SS1.p9.m1" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> solves <math id="S15.SS1.p9.m2" class="ltx_Math" alttext="(\nabla^{\sigma,\omega}u)^{0,1}=0" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mo rspace="0.167em">∇</mo><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msup><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">(\nabla^{\sigma,\omega}u)^{0,1}=0</annotation></semantics></math>. Then one has</span></p>
<table id="S15.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex12.m1" class="ltx_Math" alttext="\begin{split}&amp;\ \Omega(\nabla_{s}^{\sigma,\omega}u,\nabla_{t}^{\sigma,\omega}u)\\
=&amp;\ \Omega\Big(\nabla_{s}^{\sigma,\Omega}u+X_{\sigma_{s}}^{\omega-\Omega}(u),\nabla_{t}^{\sigma,\Omega}u+X_{\sigma_{t}}^{\omega-\Omega}(u)\Big)\\
=&amp;\ \Omega(\nabla_{s}^{\sigma,\Omega}u,\nabla_{t}^{\sigma,\Omega}u)+\Omega(\nabla_{s}^{\sigma,\Omega}u,X_{\sigma_{t}}^{\omega-\Omega}(u))+\Omega(X_{\sigma_{s}}^{\omega-\Omega}(u),\nabla_{t}^{\sigma,\Omega}u)+\Omega(X_{\sigma_{s}}^{\omega-\Omega}(u),X_{\sigma_{t}}^{\omega-\Omega}(u))\\
=&amp;\ \Omega(\nabla_{s}^{\sigma,\Omega}u,\nabla_{t}^{\sigma,\Omega}u)+\Omega(\nabla_{s}^{\sigma,\omega}u,X_{\sigma_{t}}^{\omega-\Omega}(u))+\Omega(X_{\sigma_{s}}^{\omega-\Omega}(u),\nabla_{t}^{\sigma,\omega}(u))+\Omega(X_{\sigma_{s}}^{\omega-\Omega}(u),X_{\sigma_{t}}^{\Omega-\omega}(u))\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>s</mi><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msubsup><mi>u</mi></mrow><mo>,</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>t</mi><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msubsup><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>s</mi><mrow><mi>σ</mi><mo>,</mo><mi mathvariant="normal">Ω</mi></mrow></msubsup><mi>u</mi></mrow><mo>+</mo><mrow><msubsup><mi>X</mi><msub><mi>σ</mi><mi>s</mi></msub><mrow><mi>ω</mi><mo>−</mo><mi mathvariant="normal">Ω</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo mathsize="1.600em">,</mo><mrow><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>t</mi><mrow><mi>σ</mi><mo>,</mo><mi mathvariant="normal">Ω</mi></mrow></msubsup><mi>u</mi></mrow><mo>+</mo><mrow><msubsup><mi>X</mi><msub><mi>σ</mi><mi>t</mi></msub><mrow><mi>ω</mi><mo>−</mo><mi mathvariant="normal">Ω</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>s</mi><mrow><mi>σ</mi><mo>,</mo><mi mathvariant="normal">Ω</mi></mrow></msubsup><mi>u</mi></mrow><mo>,</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>t</mi><mrow><mi>σ</mi><mo>,</mo><mi mathvariant="normal">Ω</mi></mrow></msubsup><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>s</mi><mrow><mi>σ</mi><mo>,</mo><mi mathvariant="normal">Ω</mi></mrow></msubsup><mi>u</mi></mrow><mo>,</mo><mrow><msubsup><mi>X</mi><msub><mi>σ</mi><mi>t</mi></msub><mrow><mi>ω</mi><mo>−</mo><mi mathvariant="normal">Ω</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>X</mi><msub><mi>σ</mi><mi>s</mi></msub><mrow><mi>ω</mi><mo>−</mo><mi mathvariant="normal">Ω</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>t</mi><mrow><mi>σ</mi><mo>,</mo><mi mathvariant="normal">Ω</mi></mrow></msubsup><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>X</mi><msub><mi>σ</mi><mi>s</mi></msub><mrow><mi>ω</mi><mo>−</mo><mi mathvariant="normal">Ω</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi>X</mi><msub><mi>σ</mi><mi>t</mi></msub><mrow><mi>ω</mi><mo>−</mo><mi mathvariant="normal">Ω</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>s</mi><mrow><mi>σ</mi><mo>,</mo><mi mathvariant="normal">Ω</mi></mrow></msubsup><mi>u</mi></mrow><mo>,</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>t</mi><mrow><mi>σ</mi><mo>,</mo><mi mathvariant="normal">Ω</mi></mrow></msubsup><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>s</mi><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msubsup><mi>u</mi></mrow><mo>,</mo><mrow><msubsup><mi>X</mi><msub><mi>σ</mi><mi>t</mi></msub><mrow><mi>ω</mi><mo>−</mo><mi mathvariant="normal">Ω</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>X</mi><msub><mi>σ</mi><mi>s</mi></msub><mrow><mi>ω</mi><mo>−</mo><mi mathvariant="normal">Ω</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mo>∇</mo><mi>t</mi><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>X</mi><msub><mi>σ</mi><mi>s</mi></msub><mrow><mi>ω</mi><mo>−</mo><mi mathvariant="normal">Ω</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi>X</mi><msub><mi>σ</mi><mi>t</mi></msub><mrow><mi mathvariant="normal">Ω</mi><mo>−</mo><mi>ω</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}&amp;\ \Omega(\nabla_{s}^{\sigma,\omega}u,\nabla_{t}^{\sigma,\omega}u)\\
=&amp;\ \Omega\Big(\nabla_{s}^{\sigma,\Omega}u+X_{\sigma_{s}}^{\omega-\Omega}(u),\nabla_{t}^{\sigma,\Omega}u+X_{\sigma_{t}}^{\omega-\Omega}(u)\Big)\\
=&amp;\ \Omega(\nabla_{s}^{\sigma,\Omega}u,\nabla_{t}^{\sigma,\Omega}u)+\Omega(\nabla_{s}^{\sigma,\Omega}u,X_{\sigma_{t}}^{\omega-\Omega}(u))+\Omega(X_{\sigma_{s}}^{\omega-\Omega}(u),\nabla_{t}^{\sigma,\Omega}u)+\Omega(X_{\sigma_{s}}^{\omega-\Omega}(u),X_{\sigma_{t}}^{\omega-\Omega}(u))\\
=&amp;\ \Omega(\nabla_{s}^{\sigma,\Omega}u,\nabla_{t}^{\sigma,\Omega}u)+\Omega(\nabla_{s}^{\sigma,\omega}u,X_{\sigma_{t}}^{\omega-\Omega}(u))+\Omega(X_{\sigma_{s}}^{\omega-\Omega}(u),\nabla_{t}^{\sigma,\omega}(u))+\Omega(X_{\sigma_{s}}^{\omega-\Omega}(u),X_{\sigma_{t}}^{\Omega-\omega}(u))\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS1.p9.2" class="ltx_p"><span id="S15.SS1.p9.2.1" class="ltx_text">Notice that if <math id="S15.SS1.p9.m3" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> converges to capped 1-periodic orbits <math id="S15.SS1.p9.m4" class="ltx_Math" alttext="p_{i}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>i</mi></msub><annotation encoding="application/x-tex">p_{i}</annotation></semantics></math> at the <math id="S15.SS1.p9.m5" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th cylindrical end, then</span></p>
<table id="S15.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex13.m1" class="ltx_math_unparsed" alttext="\int_{\Sigma}\Omega(\nabla_{s}^{\sigma,\Omega}u,\nabla_{t}^{\sigma,\Omega}u)dsdt=\sum_{i=1}^{m}\pm{\mathcal{A}}_{H_{i}}^{\Omega}(p_{i})+\int_{\Sigma}F_{\sigma}(u)" display="block" intent=":literal"><semantics><mrow><msub><mo>∫</mo><mi mathvariant="normal">Σ</mi></msub><mi mathvariant="normal">Ω</mi><mrow><mo stretchy="false">(</mo><msubsup><mo rspace="0.167em">∇</mo><mi>s</mi><mrow><mi>σ</mi><mo>,</mo><mi mathvariant="normal">Ω</mi></mrow></msubsup><mi>u</mi><mo>,</mo><msubsup><mo rspace="0.167em">∇</mo><mi>t</mi><mrow><mi>σ</mi><mo>,</mo><mi mathvariant="normal">Ω</mi></mrow></msubsup><mi>u</mi><mo stretchy="false">)</mo></mrow><mi>d</mi><mi>s</mi><mi>d</mi><mi>t</mi><mo rspace="0.111em">=</mo><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><mo lspace="0em">±</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mi>H</mi><mi>i</mi></msub><mi mathvariant="normal">Ω</mi></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo rspace="0.055em">+</mo><msub><mo>∫</mo><mi mathvariant="normal">Σ</mi></msub><msub><mi>F</mi><mi>σ</mi></msub><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\int_{\Sigma}\Omega(\nabla_{s}^{\sigma,\Omega}u,\nabla_{t}^{\sigma,\Omega}u)dsdt=\sum_{i=1}^{m}\pm{\mathcal{A}}_{H_{i}}^{\Omega}(p_{i})+\int_{\Sigma}F_{\sigma}(u)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS1.p9.3" class="ltx_p"><span id="S15.SS1.p9.3.1" class="ltx_text">where the first term only depends on the homotopy class of <math id="S15.SS1.p9.m6" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> and <math id="S15.SS1.p9.m7" class="ltx_Math" alttext="F_{\sigma}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>σ</mi></msub><annotation encoding="application/x-tex">F_{\sigma}</annotation></semantics></math> does not depend on the symplectic form. Then one has</span></p>
<table id="S15.SS1.p9.4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.SS1.p9.m8" class="ltx_Math" alttext="\sum_{i=1}^{m}\pm{\mathcal{A}}_{H_{i}}^{\Omega}(p_{i})=\int_{\Sigma}\Omega(\nabla_{s}^{\sigma,\Omega}u,\nabla_{t}^{\sigma,\Omega}u)dsdt-\int_{\Sigma}F_{\sigma}(u)\\
-\int_{\Sigma}\Big(\Omega(\nabla_{s}^{\sigma,\omega}u,X_{\sigma_{t}}^{\omega-\Omega}(u)+\Omega(X_{\sigma_{s}}^{\omega-\Omega}(u),\nabla_{t}^{\sigma,\omega}u)-\Omega(X_{\sigma_{s}}^{\omega-\Omega}(u),X_{\sigma_{t}}^{\omega-\Omega}(u))\Big)dsdt." display="block" intent=":literal"><semantics><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mo movablelimits="false" rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>m</mi></msup><mo lspace="0em">±</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mrow></mrow><msub><mi>H</mi><mi>i</mi></msub></msub><msup><mrow></mrow><mi mathvariant="normal">Ω</mi></msup><mo stretchy="false">(</mo><mi>p</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo rspace="0.111em">=</mo><mo>∫</mo><msub><mrow></mrow><mi mathvariant="normal">Σ</mi></msub><mi mathvariant="normal">Ω</mi><mo stretchy="false">(</mo><mo rspace="0.167em">∇</mo><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mrow><mi>σ</mi><mo>,</mo><mi mathvariant="normal">Ω</mi></mrow></msup><mi>u</mi><mo>,</mo><mo rspace="0.167em">∇</mo><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mrow><mi>σ</mi><mo>,</mo><mi mathvariant="normal">Ω</mi></mrow></msup><mi>u</mi><mo stretchy="false">)</mo><mi>d</mi><mi>s</mi><mi>d</mi><mi>t</mi><mo rspace="0.055em">−</mo><mo>∫</mo><msub><mrow></mrow><mi mathvariant="normal">Σ</mi></msub><mi>F</mi><msub><mrow></mrow><mi>σ</mi></msub><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mo rspace="0.055em">−</mo><mo rspace="0em">∫</mo><msub><mrow></mrow><mi mathvariant="normal">Σ</mi></msub><mo maxsize="1.600em" minsize="1.600em">(</mo><mi mathvariant="normal">Ω</mi><mo stretchy="false">(</mo><mo rspace="0.167em">∇</mo><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msup><mi>u</mi><mo>,</mo><mi>X</mi><msub><mrow></mrow><msub><mi>σ</mi><mi>t</mi></msub></msub><msup><mrow></mrow><mrow><mi>ω</mi><mo>−</mo><mi mathvariant="normal">Ω</mi></mrow></msup><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo><mo>+</mo><mi mathvariant="normal">Ω</mi><mo stretchy="false">(</mo><mi>X</mi><msub><mrow></mrow><msub><mi>σ</mi><mi>s</mi></msub></msub><msup><mrow></mrow><mrow><mi>ω</mi><mo>−</mo><mi mathvariant="normal">Ω</mi></mrow></msup><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo><mo>,</mo><mo rspace="0.167em">∇</mo><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msup><mi>u</mi><mo stretchy="false">)</mo><mo>−</mo><mi mathvariant="normal">Ω</mi><mo stretchy="false">(</mo><mi>X</mi><msub><mrow></mrow><msub><mi>σ</mi><mi>s</mi></msub></msub><msup><mrow></mrow><mrow><mi>ω</mi><mo>−</mo><mi mathvariant="normal">Ω</mi></mrow></msup><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo><mo>,</mo><mi>X</mi><msub><mrow></mrow><msub><mi>σ</mi><mi>t</mi></msub></msub><msup><mrow></mrow><mrow><mi>ω</mi><mo>−</mo><mi mathvariant="normal">Ω</mi></mrow></msup><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo maxsize="1.600em" minsize="1.600em">)</mo><mi>d</mi><mi>s</mi><mi>d</mi><mi>t</mi><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\sum_{i=1}^{m}\pm{\mathcal{A}}_{H_{i}}^{\Omega}(p_{i})=\int_{\Sigma}\Omega(\nabla_{s}^{\sigma,\Omega}u,\nabla_{t}^{\sigma,\Omega}u)dsdt-\int_{\Sigma}F_{\sigma}(u)\\
-\int_{\Sigma}\Big(\Omega(\nabla_{s}^{\sigma,\omega}u,X_{\sigma_{t}}^{\omega-\Omega}(u)+\Omega(X_{\sigma_{s}}^{\omega-\Omega}(u),\nabla_{t}^{\sigma,\omega}u)-\Omega(X_{\sigma_{s}}^{\omega-\Omega}(u),X_{\sigma_{t}}^{\omega-\Omega}(u))\Big)dsdt.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS1.p9.5" class="ltx_p"><span id="S15.SS1.p9.5.1" class="ltx_text">We would like to estimate the last term. First, on the compact region <math id="S15.SS1.p9.m9" class="ltx_Math" alttext="\Sigma_{0}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\Sigma_{0}</annotation></semantics></math>, one has</span></p>
<table id="S15.SS1.p9.6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.SS1.p9.m10" class="ltx_Math" alttext="\left|\int_{\Sigma_{0}}\Big(\Omega(\nabla_{s}^{\sigma,\omega}u,X_{\sigma_{t}}^{\omega-\Omega}(u)+\Omega(X_{\sigma_{s}}^{\omega-\Omega}(u),\nabla_{t}^{\sigma,\omega}u)-\Omega(X_{\sigma_{s}}^{\omega-\Omega}(u),X_{\sigma_{t}}^{\omega-\Omega}(u))\Big)dsdt\right|\\
\leq C(\epsilon)\|\omega-\Omega\|_{C^{0}(X)}^{2}+\epsilon\int_{\Sigma_{0}}|\nabla^{\sigma,\omega}(u)|_{\Omega}^{2}{\rm dvol}_{\Sigma}" display="block" intent=":literal"><semantics><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mo fence="false">|</mo><mo rspace="0em">∫</mo><msub><mrow></mrow><msub><mi mathvariant="normal">Σ</mi><mn>0</mn></msub></msub><mo maxsize="1.600em" minsize="1.600em">(</mo><mi mathvariant="normal">Ω</mi><mo stretchy="false">(</mo><mo rspace="0.167em">∇</mo><msub><mrow></mrow><mi>s</mi></msub><msup><mrow></mrow><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msup><mi>u</mi><mo>,</mo><mi>X</mi><msub><mrow></mrow><msub><mi>σ</mi><mi>t</mi></msub></msub><msup><mrow></mrow><mrow><mi>ω</mi><mo>−</mo><mi mathvariant="normal">Ω</mi></mrow></msup><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo><mo>+</mo><mi mathvariant="normal">Ω</mi><mo stretchy="false">(</mo><mi>X</mi><msub><mrow></mrow><msub><mi>σ</mi><mi>s</mi></msub></msub><msup><mrow></mrow><mrow><mi>ω</mi><mo>−</mo><mi mathvariant="normal">Ω</mi></mrow></msup><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo><mo>,</mo><mo rspace="0.167em">∇</mo><msub><mrow></mrow><mi>t</mi></msub><msup><mrow></mrow><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msup><mi>u</mi><mo stretchy="false">)</mo><mo>−</mo><mi mathvariant="normal">Ω</mi><mo stretchy="false">(</mo><mi>X</mi><msub><mrow></mrow><msub><mi>σ</mi><mi>s</mi></msub></msub><msup><mrow></mrow><mrow><mi>ω</mi><mo>−</mo><mi mathvariant="normal">Ω</mi></mrow></msup><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo><mo>,</mo><mi>X</mi><msub><mrow></mrow><msub><mi>σ</mi><mi>t</mi></msub></msub><msup><mrow></mrow><mrow><mi>ω</mi><mo>−</mo><mi mathvariant="normal">Ω</mi></mrow></msup><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo maxsize="1.600em" minsize="1.600em">)</mo><mi>d</mi><mi>s</mi><mi>d</mi><mi>t</mi><mo fence="false">|</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>ω</mi><mo>−</mo><mi mathvariant="normal">Ω</mi></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>C</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo rspace="0em">∫</mo><msub><mi mathvariant="normal">Σ</mi><mn>0</mn></msub></msub><mrow><msubsup><mrow><mo stretchy="false">|</mo><mrow><msup><mo>∇</mo><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msup><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">Ω</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>dvol</mi><mi mathvariant="normal">Σ</mi></msub></mrow></mrow></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\left|\int_{\Sigma_{0}}\Big(\Omega(\nabla_{s}^{\sigma,\omega}u,X_{\sigma_{t}}^{\omega-\Omega}(u)+\Omega(X_{\sigma_{s}}^{\omega-\Omega}(u),\nabla_{t}^{\sigma,\omega}u)-\Omega(X_{\sigma_{s}}^{\omega-\Omega}(u),X_{\sigma_{t}}^{\omega-\Omega}(u))\Big)dsdt\right|\\
\leq C(\epsilon)\|\omega-\Omega\|_{C^{0}(X)}^{2}+\epsilon\int_{\Sigma_{0}}|\nabla^{\sigma,\omega}(u)|_{\Omega}^{2}{\rm dvol}_{\Sigma}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS1.p9.7" class="ltx_p"><span id="S15.SS1.p9.7.1" class="ltx_text">for any <math id="S15.SS1.p9.m11" class="ltx_Math" alttext="\epsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon&gt;0</annotation></semantics></math> and a suitable <math id="S15.SS1.p9.m12" class="ltx_Math" alttext="C(\epsilon)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C(\epsilon)&gt;0</annotation></semantics></math>. On the other hand, on each half cylinder <math id="S15.SS1.p9.m13" class="ltx_Math" alttext="U_{i}\cong I_{i}\times S^{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>U</mi><mi>i</mi></msub><mo>≅</mo><mrow><msub><mi>I</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>S</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">U_{i}\cong I_{i}\times S^{1}</annotation></semantics></math> where <math id="S15.SS1.p9.m14" class="ltx_Math" alttext="I_{i}={\mathbb{R}}_{\pm}" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><mi>i</mi></msub><mo>=</mo><msub><mi>ℝ</mi><mo>±</mo></msub></mrow><annotation encoding="application/x-tex">I_{i}={\mathbb{R}}_{\pm}</annotation></semantics></math>, contained in <math id="S15.SS1.p9.m15" class="ltx_Math" alttext="\Sigma\setminus\Sigma_{0}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Σ</mi><mo>∖</mo><msub><mi mathvariant="normal">Σ</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\Sigma\setminus\Sigma_{0}</annotation></semantics></math>, we may take <math id="S15.SS1.p9.m16" class="ltx_Math" alttext="(s,t)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(s,t)</annotation></semantics></math> to be the cylindrical coordinate. Then we know that <math id="S15.SS1.p9.m17" class="ltx_Math" alttext="\sigma_{s}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mi>s</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\sigma_{s}=0</annotation></semantics></math>. Hence we are left with</span></p>
<table id="S15.E3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.E3.m1" class="ltx_Math" alttext="\int_{U_{i}}\Omega(\nabla_{s}^{\sigma,\omega}u,X_{H_{i}}^{\omega-\Omega}(u))dsdt." display="block" intent=":literal"><semantics><mrow><mrow><msub><mo>∫</mo><msub><mi>U</mi><mi>i</mi></msub></msub><mrow><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>s</mi><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msubsup><mi>u</mi></mrow><mo>,</mo><mrow><msubsup><mi>X</mi><msub><mi>H</mi><mi>i</mi></msub><mrow><mi>ω</mi><mo>−</mo><mi mathvariant="normal">Ω</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\int_{U_{i}}\Omega(\nabla_{s}^{\sigma,\omega}u,X_{H_{i}}^{\omega-\Omega}(u))dsdt.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15.3)</span></td></tr></tbody>
</table>
<p id="S15.SS1.p9.8" class="ltx_p"><span id="S15.SS1.p9.8.1" class="ltx_text">Recall the pre-chosen constant <math id="S15.SS1.p9.m18" class="ltx_Math" alttext="\epsilon_{0}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\epsilon_{0}</annotation></semantics></math> (see (<a href="#S15.E1" title="In Proof. ‣ 15.1. Integral modification of topological energy ‣ 15. Relatively Smooth AMS lifts ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15.1</span></a>)). Consider</span></p>
<table id="S15.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex14.m1" class="ltx_Math" alttext="I_{i}(\epsilon_{0}):=\Big\{s\in I_{i}\ |\ \int_{S^{1}}|\nabla_{s}^{\sigma,\omega}(u)(s,t)|_{\omega}^{2}dt\geq\epsilon_{0}\Big\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>I</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ϵ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>s</mi><mo>∈</mo><msub><mi>I</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0.500em">|</mo><mrow><mrow><msub><mo rspace="0em">∫</mo><msup><mi>S</mi><mn>1</mn></msup></msub><mrow><msubsup><mrow><mo stretchy="false">|</mo><mrow><mrow><msubsup><mo>∇</mo><mi>s</mi><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mi>ω</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow><mo>≥</mo><msub><mi>ϵ</mi><mn>0</mn></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">I_{i}(\epsilon_{0}):=\Big\{s\in I_{i}\ |\ \int_{S^{1}}|\nabla_{s}^{\sigma,\omega}(u)(s,t)|_{\omega}^{2}dt\geq\epsilon_{0}\Big\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS1.p9.9" class="ltx_p"><span id="S15.SS1.p9.9.1" class="ltx_text">Then <math id="S15.SS1.p9.m19" class="ltx_Math" alttext="|I_{i}(\epsilon)|\leq E^{\omega}(u)/\epsilon_{0}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi>I</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mrow><msup><mi>E</mi><mi>ω</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msub><mi>ϵ</mi><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">|I_{i}(\epsilon)|\leq E^{\omega}(u)/\epsilon_{0}</annotation></semantics></math>. Since <math id="S15.SS1.p9.m20" class="ltx_Math" alttext="\Omega=\omega" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>=</mo><mi>ω</mi></mrow><annotation encoding="application/x-tex">\Omega=\omega</annotation></semantics></math> near 1-periodic orbits, by our assumption, the integrand of (<a href="#S15.E3" title="In Proof. ‣ 15.1. Integral modification of topological energy ‣ 15. Relatively Smooth AMS lifts ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15.3</span></a>) vanishes outside <math id="S15.SS1.p9.m21" class="ltx_Math" alttext="I_{i}(\epsilon_{0})\times S^{1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>I</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ϵ</mi><mn>0</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">×</mo><msup><mi>S</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">I_{i}(\epsilon_{0})\times S^{1}</annotation></semantics></math>. Then by Cauchy–Schwarz inequality, one has</span></p>
<table id="S15.SS1.p9.10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.SS1.p9.m22" class="ltx_Math" alttext="\left|\int_{U_{i}}\Omega(\nabla_{s}^{\sigma,\omega}u,X_{\sigma_{t}}^{\omega-\Omega}(u))dsdt\right|=\left|\int_{I_{i}(\epsilon_{0})\times S^{1}}\Omega(\nabla_{s}^{\sigma,\omega}u,X_{\sigma_{t}}^{\omega-\Omega}(u))dsdt\right|\\
\leq C\|\omega-\Omega\|_{C^{0}(X)}\sqrt{|I_{i}(\epsilon_{0})|}\sqrt{\int_{I_{i}(\epsilon_{0})\times S^{1}}|\nabla_{s}^{\sigma,\omega}u|_{\omega}^{2}dsdt}\\
\leq C\|\omega-\Omega\|_{C^{0}(X)}\frac{E^{\omega}(u)}{\sqrt{\epsilon_{0}}}." display="block" intent=":literal"><semantics><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mo>|</mo><mrow><msub><mo lspace="0em">∫</mo><msub><mi>U</mi><mi>i</mi></msub></msub><mrow><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>s</mi><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msubsup><mi>u</mi></mrow><mo>,</mo><mrow><msubsup><mi>X</mi><msub><mi>σ</mi><mi>t</mi></msub><mrow><mi>ω</mi><mo>−</mo><mi mathvariant="normal">Ω</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>s</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>t</mi></mrow></mrow></mrow><mo>|</mo></mrow><mo>=</mo><mrow><mo>|</mo><mrow><msub><mo lspace="0em">∫</mo><mrow><mrow><msub><mi>I</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ϵ</mi><mn>0</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">×</mo><msup><mi>S</mi><mn>1</mn></msup></mrow></msub><mrow><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>s</mi><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msubsup><mi>u</mi></mrow><mo>,</mo><mrow><msubsup><mi>X</mi><msub><mi>σ</mi><mi>t</mi></msub><mrow><mi>ω</mi><mo>−</mo><mi mathvariant="normal">Ω</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>s</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>t</mi></mrow></mrow></mrow><mo>|</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>ω</mi><mo>−</mo><mi mathvariant="normal">Ω</mi></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>C</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mo stretchy="false">|</mo><mrow><msub><mi>I</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ϵ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><msub><mo>∫</mo><mrow><mrow><msub><mi>I</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ϵ</mi><mn>0</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">×</mo><msup><mi>S</mi><mn>1</mn></msup></mrow></msub><mrow><msubsup><mrow><mo lspace="0em" stretchy="false">|</mo><mrow><msubsup><mo rspace="0.167em">∇</mo><mi>s</mi><mrow><mi>σ</mi><mo>,</mo><mi>ω</mi></mrow></msubsup><mi>u</mi></mrow><mo stretchy="false">|</mo></mrow><mi>ω</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow></msqrt></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>ω</mi><mo>−</mo><mi mathvariant="normal">Ω</mi></mrow><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>C</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msup><mi>E</mi><mi>ω</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><msqrt><msub><mi>ϵ</mi><mn>0</mn></msub></msqrt></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\left|\int_{U_{i}}\Omega(\nabla_{s}^{\sigma,\omega}u,X_{\sigma_{t}}^{\omega-\Omega}(u))dsdt\right|=\left|\int_{I_{i}(\epsilon_{0})\times S^{1}}\Omega(\nabla_{s}^{\sigma,\omega}u,X_{\sigma_{t}}^{\omega-\Omega}(u))dsdt\right|\\
\leq C\|\omega-\Omega\|_{C^{0}(X)}\sqrt{|I_{i}(\epsilon_{0})|}\sqrt{\int_{I_{i}(\epsilon_{0})\times S^{1}}|\nabla_{s}^{\sigma,\omega}u|_{\omega}^{2}dsdt}\\
\leq C\|\omega-\Omega\|_{C^{0}(X)}\frac{E^{\omega}(u)}{\sqrt{\epsilon_{0}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS1.p9.11" class="ltx_p"><span id="S15.SS1.p9.11.1" class="ltx_text">On the other hand, when <math id="S15.SS1.p9.m23" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math> is close to <math id="S15.SS1.p9.m24" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math>, the norms <math id="S15.SS1.p9.m25" class="ltx_math_unparsed" alttext="|\cdot|_{\omega}" display="inline" intent=":literal"><semantics><mrow><mo fence="false" stretchy="false">|</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" stretchy="false">|</mo><msub><mrow></mrow><mi>ω</mi></msub></mrow><annotation encoding="application/x-tex">|\cdot|_{\omega}</annotation></semantics></math> and <math id="S15.SS1.p9.m26" class="ltx_math_unparsed" alttext="|\cdot|_{\Omega}" display="inline" intent=":literal"><semantics><mrow><mo fence="false" stretchy="false">|</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" stretchy="false">|</mo><msub><mrow></mrow><mi mathvariant="normal">Ω</mi></msub></mrow><annotation encoding="application/x-tex">|\cdot|_{\Omega}</annotation></semantics></math> are compatible. Therefore, when <math id="S15.SS1.p9.m27" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math> is <math id="S15.SS1.p9.m28" class="ltx_Math" alttext="C^{0}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mn>0</mn></msup><annotation encoding="application/x-tex">C^{0}</annotation></semantics></math>-close to <math id="S15.SS1.p9.m29" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math>, one has the estimate</span></p>
<table id="S15.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex15.m1" class="ltx_math_unparsed" alttext="\sum_{i=1}^{m}\pm{\mathcal{A}}_{H_{i}}^{\Omega}(p_{i})\geq\frac{1}{2}E^{\Omega}(u)-C" display="block" intent=":literal"><semantics><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><mo lspace="0em">±</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mi>H</mi><mi>i</mi></msub><mi mathvariant="normal">Ω</mi></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>≥</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><msup><mi>E</mi><mi mathvariant="normal">Ω</mi></msup><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>C</mi></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{m}\pm{\mathcal{A}}_{H_{i}}^{\Omega}(p_{i})\geq\frac{1}{2}E^{\Omega}(u)-C</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS1.p9.12" class="ltx_p"><span id="S15.SS1.p9.12.1" class="ltx_text">for some constant <math id="S15.SS1.p9.m30" class="ltx_Math" alttext="C&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C&gt;0</annotation></semantics></math> by combining the above computations with (<a href="#S15.E2" title="In Proof. ‣ 15.1. Integral modification of topological energy ‣ 15. Relatively Smooth AMS lifts ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15.2</span></a>) to rearrange the inequalities, provided that <math id="S15.SS1.p9.m31" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math> is sufficiently small.</span></p>
</div>
<div id="S15.SS1.p10" class="ltx_para ltx_noindent">
<p id="S15.SS1.p10.1" class="ltx_p"><span id="S15.SS1.p10.1.1" class="ltx_text">Further, to make the symplectic action rational, we define</span></p>
<table id="S15.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex16.m1" class="ltx_Math" alttext="{\mathcal{A}}_{{\mathbb{F}}_{i}}^{\Omega}(p_{i}):={\mathcal{A}}_{H_{i}}^{\Omega}(p_{i})+\delta_{p_{i}}" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mi>𝔽</mi><mi>i</mi></msub><mi mathvariant="normal">Ω</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mi>H</mi><mi>i</mi></msub><mi mathvariant="normal">Ω</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>δ</mi><msub><mi>p</mi><mi>i</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{A}}_{{\mathbb{F}}_{i}}^{\Omega}(p_{i}):={\mathcal{A}}_{H_{i}}^{\Omega}(p_{i})+\delta_{p_{i}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS1.p10.2" class="ltx_p"><span id="S15.SS1.p10.2.1" class="ltx_text">for a small real number <math id="S15.SS1.p10.m1" class="ltx_Math" alttext="\delta_{p_{i}}" display="inline" intent=":literal"><semantics><msub><mi>δ</mi><msub><mi>p</mi><mi>i</mi></msub></msub><annotation encoding="application/x-tex">\delta_{p_{i}}</annotation></semantics></math> making the above rational. Then one still has</span></p>
<table id="S15.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex17.m1" class="ltx_math_unparsed" alttext="\sum_{i=1}^{m}\pm{\mathcal{A}}_{\mathbb{F}_{i}}^{\Omega}(p_{i})\geq\frac{1}{2}E^{\omega}(u)-C" display="block" intent=":literal"><semantics><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><mo lspace="0em">±</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mi>𝔽</mi><mi>i</mi></msub><mi mathvariant="normal">Ω</mi></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>≥</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><msup><mi>E</mi><mi>ω</mi></msup><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>C</mi></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{m}\pm{\mathcal{A}}_{\mathbb{F}_{i}}^{\Omega}(p_{i})\geq\frac{1}{2}E^{\omega}(u)-C</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS1.p10.3" class="ltx_p"><span id="S15.SS1.p10.3.1" class="ltx_text">after changing <math id="S15.SS1.p10.m2" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> a bit. Then we argue in two cases.</span></p>
</div>
<div id="S15.SS1.p11" class="ltx_para">
<ol id="S15.I5" class="ltx_enumerate">
<li id="S15.I5.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S15.I5.i1.p1" class="ltx_para ltx_noindent">
<p id="S15.I5.i1.p1.1" class="ltx_p">When <math id="S15.I5.i1.p1.m1" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> is an infinite cylinder, <math id="S15.I5.i1.p1.m2" class="ltx_Math" alttext="\sigma=Hdt" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>=</mo><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><annotation encoding="application/x-tex">\sigma=Hdt</annotation></semantics></math> and <math id="S15.I5.i1.p1.m3" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math> only depends on <math id="S15.I5.i1.p1.m4" class="ltx_Math" alttext="t\in S^{1}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><msup><mi>S</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">t\in S^{1}</annotation></semantics></math>, one can take <math id="S15.I5.i1.p1.m5" class="ltx_Math" alttext="C=0" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C=0</annotation></semantics></math> and obtain instead</p>
<table id="S15.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex18.m1" class="ltx_Math" alttext="{\mathcal{A}}_{{\mathbb{F}}}^{\Omega}(p)-{\mathcal{A}}_{{\mathbb{F}}}^{\Omega}(q)\geq\frac{1}{2}E^{\omega}(u)=\frac{1}{2}({\mathcal{A}}_{H}^{\omega}(p)-{\mathcal{A}}_{H}^{\omega}(q))." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>𝔽</mi><mi mathvariant="normal">Ω</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>𝔽</mi><mi mathvariant="normal">Ω</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≥</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>E</mi><mi>ω</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>H</mi><mi>ω</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>H</mi><mi>ω</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{A}}_{{\mathbb{F}}}^{\Omega}(p)-{\mathcal{A}}_{{\mathbb{F}}}^{\Omega}(q)\geq\frac{1}{2}E^{\omega}(u)=\frac{1}{2}({\mathcal{A}}_{H}^{\omega}(p)-{\mathcal{A}}_{H}^{\omega}(q)).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.I5.i1.p1.2" class="ltx_p">This provides an integral action on the associated Floer flow category.</p>
</div></li>
<li id="S15.I5.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S15.I5.i2.p1" class="ltx_para">
<p id="S15.I5.i2.p1.1" class="ltx_p">In other cases, one can add rational constants to <math id="S15.I5.i2.p1.m1" class="ltx_Math" alttext="{\mathcal{A}}_{H_{i}}^{\Omega}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mi>H</mi><mi>i</mi></msub><mi mathvariant="normal">Ω</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{A}}_{H_{i}}^{\Omega}</annotation></semantics></math> to make the sum of <math id="S15.I5.i2.p1.m2" class="ltx_Math" alttext="\pm{\mathcal{A}}_{H_{i}}^{\Omega}" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mi>H</mi><mi>i</mi></msub><mi mathvariant="normal">Ω</mi></msubsup></mrow><annotation encoding="application/x-tex">\pm{\mathcal{A}}_{H_{i}}^{\Omega}</annotation></semantics></math> always positive.</p>
</div></li>
</ol>
<p id="S15.SS1.p11.1" class="ltx_p"><span id="S15.SS1.p11.1.1" class="ltx_text">Finally, we choose a common large positive integral multiple of the <math id="S15.SS1.p11.m1" class="ltx_Math" alttext="{\mathcal{A}}^{\Omega}_{\mathbb{F}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>𝔽</mi><mi mathvariant="normal">Ω</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{A}}^{\Omega}_{\mathbb{F}}</annotation></semantics></math> constructed above so that the action becomes integral valued and the symplectic form <math id="S15.SS1.p11.m2" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math> becomes integral.
∎</span></p>
</div>
</div>
<section id="S15.SS1.SSS1" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">15.1.1. </span>Pullback the domain flow category, multimodule, and homotopy</h5>

<div id="S15.SS1.SSS1.p1" class="ltx_para ltx_noindent">
<p id="S15.SS1.SSS1.p1.1" class="ltx_p">Now choose an integral action <math id="S15.SS1.SSS1.p1.m1" class="ltx_Math" alttext="{\mathcal{A}}_{\mathbb{F}}^{\Omega}:{\rm Ob}{\mathbb{F}}\to{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>𝔽</mi><mi mathvariant="normal">Ω</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow><mo stretchy="false">→</mo><mi>ℤ</mi></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{A}}_{\mathbb{F}}^{\Omega}:{\rm Ob}{\mathbb{F}}\to{\mathbb{Z}}</annotation></semantics></math> with associated symplectic form <math id="S15.SS1.SSS1.p1.m2" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math>. For each pair of objects <math id="S15.SS1.SSS1.p1.m3" class="ltx_Math" alttext="p,q\in{\rm Ob}{\mathbb{F}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></mrow><annotation encoding="application/x-tex">p,q\in{\rm Ob}{\mathbb{F}}</annotation></semantics></math>, abbreviate <math id="S15.SS1.SSS1.p1.m4" class="ltx_Math" alttext="d=d_{pq}={\mathcal{A}}_{\mathbb{F}}^{\Omega}(p)-{\mathcal{A}}_{\mathbb{F}}^{\Omega}(q)" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>=</mo><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>𝔽</mi><mi mathvariant="normal">Ω</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>𝔽</mi><mi mathvariant="normal">Ω</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">d=d_{pq}={\mathcal{A}}_{\mathbb{F}}^{\Omega}(p)-{\mathcal{A}}_{\mathbb{F}}^{\Omega}(q)</annotation></semantics></math>. Inside the poset <math id="S15.SS1.SSS1.p1.m5" class="ltx_Math" alttext="A_{d}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>d</mi></msub><annotation encoding="application/x-tex">A_{d}</annotation></semantics></math> (of positive partitions of <math id="S15.SS1.SSS1.p1.m6" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>), there is an Alexandrov open subset</p>
<table id="S15.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex19.m1" class="ltx_Math" alttext="A_{pq}^{\Omega}\subseteq A_{d}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>A</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi mathvariant="normal">Ω</mi></msubsup><mo>⊆</mo><msub><mi>A</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">A_{pq}^{\Omega}\subseteq A_{d}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS1.SSS1.p1.2" class="ltx_p">whose elements are decompositions</p>
<table id="S15.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex20.m1" class="ltx_Math" alttext="d=d_{0}+\cdots+d_{l}" display="block" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>d</mi><mi>l</mi></msub></mrow></mrow><annotation encoding="application/x-tex">d=d_{0}+\cdots+d_{l}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS1.SSS1.p1.3" class="ltx_p">such that there exist objects <math id="S15.SS1.SSS1.p1.m7" class="ltx_Math" alttext="r_{1},\ldots,r_{l}\in{\rm Ob}{\mathbb{F}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>r</mi><mi>l</mi></msub><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">r_{1},\ldots,r_{l}\in{\rm Ob}{\mathbb{F}}</annotation></semantics></math> such that</p>
<table id="S15.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex21.m1" class="ltx_math_unparsed" alttext="d_{0}={\mathcal{A}}_{\mathbb{F}}^{\Omega}(p)-{\mathcal{A}}_{\mathbb{F}}^{\Omega}({r_{1}}),\ d_{1}={\mathcal{A}}_{\mathbb{F}}^{\Omega}(r_{1})-{\mathcal{A}}_{\mathbb{F}}^{\Omega}(r_{2}),\ \ldots,d_{l}={\mathcal{A}}_{\mathbb{F}}^{\Omega}(r_{l})-{\mathcal{A}}_{\mathbb{F}}^{\Omega}(q)." display="block" intent=":literal"><semantics><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>=</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>𝔽</mi><mi mathvariant="normal">Ω</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>𝔽</mi><mi mathvariant="normal">Ω</mi></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo rspace="0.667em">,</mo><msub><mi>d</mi><mn>1</mn></msub><mo>=</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>𝔽</mi><mi mathvariant="normal">Ω</mi></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>𝔽</mi><mi mathvariant="normal">Ω</mi></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo rspace="0.667em">,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>d</mi><mi>l</mi></msub><mo>=</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>𝔽</mi><mi mathvariant="normal">Ω</mi></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>𝔽</mi><mi mathvariant="normal">Ω</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">d_{0}={\mathcal{A}}_{\mathbb{F}}^{\Omega}(p)-{\mathcal{A}}_{\mathbb{F}}^{\Omega}({r_{1}}),\ d_{1}={\mathcal{A}}_{\mathbb{F}}^{\Omega}(r_{1})-{\mathcal{A}}_{\mathbb{F}}^{\Omega}(r_{2}),\ \ldots,d_{l}={\mathcal{A}}_{\mathbb{F}}^{\Omega}(r_{l})-{\mathcal{A}}_{\mathbb{F}}^{\Omega}(q).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S15.SS1.SSS1.p2" class="ltx_para ltx_noindent">
<p id="S15.SS1.SSS1.p2.1" class="ltx_p">Now we use these data to “pull back” the monotone flow categories <math id="S15.SS1.SSS1.p2.m1" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}</annotation></semantics></math> constructed before. Define a flow category enriched in <math id="S15.SS1.SSS1.p2.m2" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>ℂ</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}</annotation></semantics></math> whose objects are the same as <math id="S15.SS1.SSS1.p2.m3" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math>, and whose morphism from <math id="S15.SS1.SSS1.p2.m4" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> to <math id="S15.SS1.SSS1.p2.m5" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> is the restriction of <math id="S15.SS1.SSS1.p2.m6" class="ltx_math_unparsed" alttext="{}_{\lfloor}{\mathcal{C}}_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><msub><mrow></mrow><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">{}_{\lfloor}{\mathcal{C}}_{d}</annotation></semantics></math> to the corresponding open subset</p>
<table id="S15.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex22.m1" class="ltx_math_unparsed" alttext="{}_{\lfloor}B_{pq}^{\Omega}\subseteq{}_{\lfloor}B_{d}." display="block" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>B</mi><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><msup><mrow></mrow><mi mathvariant="normal">Ω</mi></msup><mo>⊆</mo><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>B</mi><msub><mrow></mrow><mi>d</mi></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{}_{\lfloor}B_{pq}^{\Omega}\subseteq{}_{\lfloor}B_{d}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS1.SSS1.p2.2" class="ltx_p">Denote this object by</p>
<table id="S15.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex23.m1" class="ltx_Math" alttext="{\mathcal{C}}_{pq}^{\Omega}=({\mathcal{G}}_{pq}^{\Omega},B_{pq}^{\Omega},C_{pq}^{\Omega})." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi mathvariant="normal">Ω</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi mathvariant="normal">Ω</mi></msubsup><mo>,</mo><msubsup><mi>B</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi mathvariant="normal">Ω</mi></msubsup><mo>,</mo><msubsup><mi>C</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi mathvariant="normal">Ω</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{C}}_{pq}^{\Omega}=({\mathcal{G}}_{pq}^{\Omega},B_{pq}^{\Omega},C_{pq}^{\Omega}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS1.SSS1.p2.3" class="ltx_p">When <math id="S15.SS1.SSS1.p2.m7" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math> is understood from the context, we often drop it from the notation. Then the restriction of the structural maps of the flow category <math id="S15.SS1.SSS1.p2.m8" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}</annotation></semantics></math> gives a flow category</p>
<table id="S15.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex24.m1" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{F}}}" display="block" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mrow><mi mathvariant="normal">Ω</mi><mo>,</mo><mi>𝔽</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{F}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS1.SSS1.p2.4" class="ltx_p">enriched in <math id="S15.SS1.SSS1.p2.m9" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>ℂ</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}</annotation></semantics></math> whose objects are the same as objects of <math id="S15.SS1.SSS1.p2.m10" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> and whose morphisms are the families <math id="S15.SS1.SSS1.p2.m11" class="ltx_math_unparsed" alttext="{}_{\lfloor}{\mathcal{C}}_{pq}^{\Omega}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><msup><mrow></mrow><mi mathvariant="normal">Ω</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}{\mathcal{C}}_{pq}^{\Omega}</annotation></semantics></math>.</p>
</div>
<div id="S15.SS1.SSS1.p3" class="ltx_para ltx_noindent">
<p id="S15.SS1.SSS1.p3.1" class="ltx_p">Now we summarize the construction as an update of Situation <a href="#Thmsituationf1" title="Situation Flow(i). ‣ 9.2. Floer flow category ‣ 9. Geometric Flow Categories ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Flow(i)</span></a>.</p>
</div>
<div id="Thmsituationf2" class="ltx_theorem ltx_theorem_situationf">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmsituationf2.2" class="ltx_text ltx_font_bold">Situation Flow(ii)</span></span><span id="Thmsituationf2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmsituationf2.p1" class="ltx_para">
<p id="Thmsituationf2.p1.1" class="ltx_p"><span id="Thmsituationf2.p1.1.1" class="ltx_text ltx_font_italic">In Siutation <a href="#Thmsituationf1" title="Situation Flow(i). ‣ 9.2. Floer flow category ‣ 9. Geometric Flow Categories ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Flow(i)</span></a>, one fixes an outercollaring width. <math id="Thmsituationf2.p1.m1" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}</annotation></semantics></math> is the monotone flow category enriched in <math id="Thmsituationf2.p1.m2" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>ℂ</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}</annotation></semantics></math>. Furthermore, let <math id="Thmsituationf2.p1.m3" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{F}}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mrow><mi mathvariant="normal">Ω</mi><mo>,</mo><mi>𝔽</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{F}}}</annotation></semantics></math> be the flow category enriched in <math id="Thmsituationf2.p1.m4" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>ℂ</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}</annotation></semantics></math> subject to a chosen integral action on <math id="Thmsituationf2.p1.m5" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S15.SS1.SSS1.p4" class="ltx_para ltx_noindent">
<p id="S15.SS1.SSS1.p4.1" class="ltx_p">Similarly, let <math id="S15.SS1.SSS1.p4.m1" class="ltx_Math" alttext="{\mathbb{X}}" display="inline" intent=":literal"><semantics><mi>𝕏</mi><annotation encoding="application/x-tex">{\mathbb{X}}</annotation></semantics></math> be a multimodule associated to a Floer domain <math id="S15.SS1.SSS1.p4.m2" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math>. Choose an outercollaring width and a compatible set of integral actions on involved flow categories</p>
<table id="S15.EGx53" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S15.Ex25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S15.Ex25.m1" class="ltx_Math" alttext="\displaystyle\ {\mathcal{A}}_{{\mathbb{F}}_{j}}^{\Omega}:{\rm Ob}{\mathbb{F}}_{j}\to{\mathbb{Z}},\ " display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mi>𝔽</mi><mi>j</mi></msub><mi mathvariant="normal">Ω</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔽</mi><mi>j</mi></msub></mrow><mo stretchy="false">→</mo><mi>ℤ</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ {\mathcal{A}}_{{\mathbb{F}}_{j}}^{\Omega}:{\rm Ob}{\mathbb{F}}_{j}\to{\mathbb{Z}},\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S15.Ex25.m2" class="ltx_Math" alttext="\displaystyle\ {\mathcal{A}}_{{\mathbb{F}}^{\prime}}^{\Omega}:{\rm Ob}{\mathbb{F}}^{\prime}\to{\mathbb{Z}}." display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msup><mi>𝔽</mi><mo>′</mo></msup><mi mathvariant="normal">Ω</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔽</mi><mo>′</mo></msup></mrow><mo stretchy="false">→</mo><mi>ℤ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ {\mathcal{A}}_{{\mathbb{F}}^{\prime}}^{\Omega}:{\rm Ob}{\mathbb{F}}^{\prime}\to{\mathbb{Z}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS1.SSS1.p4.2" class="ltx_p">Then one can choose an integer <math id="S15.SS1.SSS1.p4.m3" class="ltx_Math" alttext="n^{\mathbb{X}}" display="inline" intent=":literal"><semantics><msup><mi>n</mi><mi>𝕏</mi></msup><annotation encoding="application/x-tex">n^{\mathbb{X}}</annotation></semantics></math> such that for all tuples of objects <math id="S15.SS1.SSS1.p4.m4" class="ltx_Math" alttext="(p_{1},\ldots,p_{m};p^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>p</mi><mi>m</mi></msub><mo>,</mo><msup><mi>p</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(p_{1},\ldots,p_{m};p^{\prime})</annotation></semantics></math>, one has</p>
<table id="S15.E4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.E4.m1" class="ltx_math_unparsed" alttext="d:=d_{p_{1}\cdots p_{m};p^{\prime}}:=\sum_{i=1}^{m}{\mathcal{A}}^{\Omega}_{{\mathbb{F}}_{i}}(p_{i})-{\mathcal{A}}^{\Omega}_{{\mathbb{F}}^{\prime}}(p^{\prime})+n^{\mathbb{X}}&gt;0." display="block" intent=":literal"><semantics><mrow><mi>d</mi><mo>:=</mo><msub><mi>d</mi><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo rspace="0.111em">:=</mo><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mi>𝔽</mi><mi>i</mi></msub><mi mathvariant="normal">Ω</mi></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msup><mi>𝔽</mi><mo>′</mo></msup><mi mathvariant="normal">Ω</mi></msubsup><mrow><mo stretchy="false">(</mo><msup><mi>p</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>+</mo><msup><mi>n</mi><mi>𝕏</mi></msup><mo>&gt;</mo><mn>0</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">d:=d_{p_{1}\cdots p_{m};p^{\prime}}:=\sum_{i=1}^{m}{\mathcal{A}}^{\Omega}_{{\mathbb{F}}_{i}}(p_{i})-{\mathcal{A}}^{\Omega}_{{\mathbb{F}}^{\prime}}(p^{\prime})+n^{\mathbb{X}}&gt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15.4)</span></td></tr></tbody>
</table>
<p id="S15.SS1.SSS1.p4.3" class="ltx_p">Let</p>
<table id="S15.Ex26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex26.m1" class="ltx_math_unparsed" alttext="A_{p_{1}\cdots p_{m};p^{\prime}}^{\Omega,{\mathbb{X}}}\subseteq A_{d}" display="block" intent=":literal"><semantics><mrow><mi>A</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mrow><mi mathvariant="normal">Ω</mi><mo>,</mo><mi>𝕏</mi></mrow></msup><mo>⊆</mo><mi>A</mi><msub><mrow></mrow><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">A_{p_{1}\cdots p_{m};p^{\prime}}^{\Omega,{\mathbb{X}}}\subseteq A_{d}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS1.SSS1.p4.4" class="ltx_p">be the Alexandrov open subset of partitions of <math id="S15.SS1.SSS1.p4.m5" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> corresponding to possible degenerations of <math id="S15.SS1.SSS1.p4.m6" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> and let</p>
<table id="S15.Ex27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex27.m1" class="ltx_math_unparsed" alttext="{\mathcal{C}}_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}" display="block" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup></mrow><annotation encoding="application/x-tex">{\mathcal{C}}_{p_{1}\cdots p_{m};p^{\prime}}^{\mathbb{X}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS1.SSS1.p4.5" class="ltx_p">be the restriction to the open subset corresponding to <math id="S15.SS1.SSS1.p4.m7" class="ltx_math_unparsed" alttext="A_{p_{1}\cdots p_{m};p^{\prime}}^{\Omega,\mathbb{X}}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mrow><mi mathvariant="normal">Ω</mi><mo>,</mo><mi>𝕏</mi></mrow></msup></mrow><annotation encoding="application/x-tex">A_{p_{1}\cdots p_{m};p^{\prime}}^{\Omega,\mathbb{X}}</annotation></semantics></math>. Then this provides a multimodule over <math id="S15.SS1.SSS1.p4.m8" class="ltx_math_unparsed" alttext="({}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{F}}_{1}},\ldots,{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{F}}_{m}};{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{F}}^{\prime}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝔻</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mi>𝕠</mi><msup><mi>𝕞</mi><mrow><mi mathvariant="normal">Ω</mi><mo>,</mo><msub><mi>𝔽</mi><mn>1</mn></msub></mrow></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mmultiscripts><mi>𝔻</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mi>𝕠</mi><msup><mi>𝕞</mi><mrow><mi mathvariant="normal">Ω</mi><mo>,</mo><msub><mi>𝔽</mi><mi>m</mi></msub></mrow></msup><mo>;</mo><mmultiscripts><mi>𝔻</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mi>𝕠</mi><msup><mi>𝕞</mi><mrow><mi mathvariant="normal">Ω</mi><mo>,</mo><msup><mi>𝔽</mi><mo>′</mo></msup></mrow></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{F}}_{1}},\ldots,{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{F}}_{m}};{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{F}}^{\prime}})</annotation></semantics></math> enriched in <math id="S15.SS1.SSS1.p4.m9" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>ℂ</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}</annotation></semantics></math>, denoted by</p>
<table id="S15.Ex28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex28.m1" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{X}}}." display="block" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mrow><mi mathvariant="normal">Ω</mi><mo>,</mo><mi>𝕏</mi></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{X}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S15.Thmthm5" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S15.Thmthm5.2" class="ltx_text ltx_font_italic">Remark 15.5</span></span><span id="S15.Thmthm5.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S15.Thmthm5.p1" class="ltx_para ltx_noindent">
<p id="S15.Thmthm5.p1.1" class="ltx_p">The constant <math id="S15.Thmthm5.p1.m1" class="ltx_Math" alttext="n^{\mathbb{X}}" display="inline" intent=":literal"><semantics><msup><mi>n</mi><mi>𝕏</mi></msup><annotation encoding="application/x-tex">n^{\mathbb{X}}</annotation></semantics></math> should be thought as shifting the integral action <math id="S15.Thmthm5.p1.m2" class="ltx_Math" alttext="{\mathcal{A}}^{\Omega}_{\mathbb{F}^{\prime}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msup><mi>𝔽</mi><mo>′</mo></msup><mi mathvariant="normal">Ω</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{A}}^{\Omega}_{\mathbb{F}^{\prime}}</annotation></semantics></math> by <math id="S15.Thmthm5.p1.m3" class="ltx_Math" alttext="-n^{\mathbb{X}}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><msup><mi>n</mi><mi>𝕏</mi></msup></mrow><annotation encoding="application/x-tex">-n^{\mathbb{X}}</annotation></semantics></math> such that for all <math id="S15.Thmthm5.p1.m4" class="ltx_Math" alttext="(p_{1},\ldots,p_{m};p^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>p</mi><mi>m</mi></msub><mo>,</mo><msup><mi>p</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(p_{1},\ldots,p_{m};p^{\prime})</annotation></semantics></math>, we have</p>
<table id="S15.Ex29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex29.m1" class="ltx_math_unparsed" alttext="d:=d_{p_{1}\cdots p_{m};p^{\prime}}:=\sum_{i=1}^{m}{\mathcal{A}}^{\Omega}_{{\mathbb{F}}_{i}}(p_{i})-({\mathcal{A}}^{\Omega}_{{\mathbb{F}}^{\prime}}(p^{\prime})-n^{\mathbb{X}})&gt;0." display="block" intent=":literal"><semantics><mrow><mi>d</mi><mo>:=</mo><msub><mi>d</mi><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo rspace="0.111em">:=</mo><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mi>𝔽</mi><mi>i</mi></msub><mi mathvariant="normal">Ω</mi></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msup><mi>𝔽</mi><mo>′</mo></msup><mi mathvariant="normal">Ω</mi></msubsup><mrow><mo stretchy="false">(</mo><msup><mi>p</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>n</mi><mi>𝕏</mi></msup><mo stretchy="false">)</mo></mrow><mo>&gt;</mo><mn>0</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">d:=d_{p_{1}\cdots p_{m};p^{\prime}}:=\sum_{i=1}^{m}{\mathcal{A}}^{\Omega}_{{\mathbb{F}}_{i}}(p_{i})-({\mathcal{A}}^{\Omega}_{{\mathbb{F}}^{\prime}}(p^{\prime})-n^{\mathbb{X}})&gt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.Thmthm5.p1.2" class="ltx_p">The positive integer <math id="S15.Thmthm5.p1.m5" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> will be the degree of an auxiliary line bundle over <math id="S15.Thmthm5.p1.m6" class="ltx_Math" alttext="{\mathbb{P}}^{1}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>1</mn></msup><annotation encoding="application/x-tex">{\mathbb{P}}^{1}</annotation></semantics></math>.</p>
</div>
</div>
<div id="Thmsituationm2" class="ltx_theorem ltx_theorem_situationm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmsituationm2.2" class="ltx_text ltx_font_bold">Situation Module(ii)</span></span><span id="Thmsituationm2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmsituationm2.p1" class="ltx_para">
<p id="Thmsituationm2.p1.1" class="ltx_p"><span id="Thmsituationm2.p1.1.1" class="ltx_text ltx_font_italic">In Situation <a href="#Thmsituationm1" title="Situation Module(i). ‣ 10.2. Multimodules from smooth domains ‣ 10. Geometric Multimodules ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Module(i)</span></a>, one fixes an outercollaring width and a compatible list of integral actions on the involved Floer categories. <math id="Thmsituationm2.p1.m1" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{F}}_{1}},\ldots,{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{F}}_{m}};{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{F}}^{\prime}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mrow><mi mathvariant="normal">Ω</mi><mo>,</mo><msub><mi>𝔽</mi><mn>1</mn></msub></mrow></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mrow><mi mathvariant="normal">Ω</mi><mo>,</mo><msub><mi>𝔽</mi><mi>m</mi></msub></mrow></msup><mo>;</mo><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mrow><mi mathvariant="normal">Ω</mi><mo>,</mo><msup><mi>𝔽</mi><mo>′</mo></msup></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{F}}_{1}},\ldots,{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{F}}_{m}};{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{F}}^{\prime}}</annotation></semantics></math> are flow categories enriched in <math id="Thmsituationm2.p1.m2" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>ℂ</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}</annotation></semantics></math> subject to the chosen integral actions as described in Situation <a href="#Thmsituationf2" title="Situation Flow(ii). ‣ 15.1.1. Pullback the domain flow category, multimodule, and homotopy ‣ 15.1. Integral modification of topological energy ‣ 15. Relatively Smooth AMS lifts ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Flow(ii)</span></a>. <math id="Thmsituationm2.p1.m3" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{X}}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mrow><mi mathvariant="normal">Ω</mi><mo>,</mo><mi>𝕏</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{X}}}</annotation></semantics></math> is the multimodule over <math id="Thmsituationm2.p1.m4" class="ltx_math_unparsed" alttext="({}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{F}}_{1}},\ldots,{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{F}}_{m}};{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{F}}^{\prime}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝔻</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mi>𝕠</mi><msup><mi>𝕞</mi><mrow><mi mathvariant="normal">Ω</mi><mo>,</mo><msub><mi>𝔽</mi><mn>1</mn></msub></mrow></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mmultiscripts><mi>𝔻</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mi>𝕠</mi><msup><mi>𝕞</mi><mrow><mi mathvariant="normal">Ω</mi><mo>,</mo><msub><mi>𝔽</mi><mi>m</mi></msub></mrow></msup><mo>;</mo><mmultiscripts><mi>𝔻</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mi>𝕠</mi><msup><mi>𝕞</mi><mrow><mi mathvariant="normal">Ω</mi><mo>,</mo><msup><mi>𝔽</mi><mo>′</mo></msup></mrow></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{F}}_{1}},\ldots,{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{F}}_{m}};{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{F}}^{\prime}})</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S15.SS1.SSS1.p5" class="ltx_para ltx_noindent">
<p id="S15.SS1.SSS1.p5.1" class="ltx_p">The case of Situation <a href="#Thmsituationh1" title="Situation Homotopy(i). ‣ 11.1. Homotopies from varying Floer data ‣ 11. Homotopies of Multimodules ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Homotopy(i)</span></a> is similar and we only describe the construction below without details.</p>
</div>
<div id="Thmsituationh2" class="ltx_theorem ltx_theorem_situationh">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmsituationh2.2" class="ltx_text ltx_font_bold">Situation Homotopy(ii)</span></span><span id="Thmsituationh2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmsituationh2.p1" class="ltx_para ltx_noindent">
<p id="Thmsituationh2.p1.1" class="ltx_p"><span id="Thmsituationh2.p1.1.1" class="ltx_text ltx_font_italic">In Situation <a href="#Thmsituationh1" title="Situation Homotopy(i). ‣ 11.1. Homotopies from varying Floer data ‣ 11. Homotopies of Multimodules ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Homotopy(i)</span></a>, one fixes an outercollaring width and a compatible list of integral actions on involved Floer flow categories.</span></p>
<table id="S15.Ex30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex30.m1" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{F}}_{1}},\ldots,{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{F}}_{m}};{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{F}}^{\prime}}" display="block" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mrow><mi mathvariant="normal">Ω</mi><mo>,</mo><msub><mi>𝔽</mi><mn>1</mn></msub></mrow></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mrow><mi mathvariant="normal">Ω</mi><mo>,</mo><msub><mi>𝔽</mi><mi>m</mi></msub></mrow></msup><mo>;</mo><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mrow><mi mathvariant="normal">Ω</mi><mo>,</mo><msup><mi>𝔽</mi><mo>′</mo></msup></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{F}}_{1}},\ldots,{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{F}}_{m}};{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{F}}^{\prime}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmsituationh2.p1.2" class="ltx_p"><span id="Thmsituationh2.p1.2.1" class="ltx_text ltx_font_italic">are flow categories enriched in <math id="Thmsituationh2.p1.m1" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>ℂ</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}</annotation></semantics></math> subject to the chosen integral actions as described in Situation <a href="#Thmsituationf2" title="Situation Flow(ii). ‣ 15.1.1. Pullback the domain flow category, multimodule, and homotopy ‣ 15.1. Integral modification of topological energy ‣ 15. Relatively Smooth AMS lifts ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Flow(ii)</span></a>;</span></p>
<table id="S15.Ex31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex31.m1" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{X}}_{0}},{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{X}}_{1}}" display="block" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mrow><mi mathvariant="normal">Ω</mi><mo>,</mo><msub><mi>𝕏</mi><mn>0</mn></msub></mrow></msup><mo>,</mo><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mrow><mi mathvariant="normal">Ω</mi><mo>,</mo><msub><mi>𝕏</mi><mn>1</mn></msub></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{X}}_{0}},{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{X}}_{1}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmsituationh2.p1.3" class="ltx_p"><span id="Thmsituationh2.p1.3.1" class="ltx_text ltx_font_italic">are multimodules over them associated to <math id="Thmsituationh2.p1.m2" class="ltx_Math" alttext="\Sigma_{0}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\Sigma_{0}</annotation></semantics></math> and <math id="Thmsituationh2.p1.m3" class="ltx_Math" alttext="\Sigma_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\Sigma_{1}</annotation></semantics></math> respectively as described in Situation <a href="#Thmsituationm2" title="Situation Module(ii). ‣ 15.1.1. Pullback the domain flow category, multimodule, and homotopy ‣ 15.1. Integral modification of topological energy ‣ 15. Relatively Smooth AMS lifts ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Module(ii)</span></a>. <math id="Thmsituationh2.p1.m4" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{H}}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mrow><mi mathvariant="normal">Ω</mi><mo>,</mo><mi>ℍ</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{H}}}</annotation></semantics></math> is a homotopy from <math id="Thmsituationh2.p1.m5" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{X}}_{0}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mrow><mi mathvariant="normal">Ω</mi><mo>,</mo><msub><mi>𝕏</mi><mn>0</mn></msub></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{X}}_{0}}</annotation></semantics></math> to <math id="Thmsituationh2.p1.m6" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{X}}_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mrow><mi mathvariant="normal">Ω</mi><mo>,</mo><msub><mi>𝕏</mi><mn>1</mn></msub></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{X}}_{1}}</annotation></semantics></math> subject to the fixed outercollaring width and the integral actions.</span></p>
</div>
</div>
</section>
</section>
<section id="S15.SS2" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">15.2. </span>Framed maps</h4>

<div id="S15.SS2.p1" class="ltx_para ltx_noindent">
<p id="S15.SS2.p1.1" class="ltx_p">In this subsection, we describe a suitable package describing flow categories, multimodules, and homotopies of infinite-dimensional spaces of maps into the target symplectic manifold.</p>
</div>
<section id="S15.SS2.SSS1" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">15.2.1. </span>Category of families of framed maps</h5>

<div id="S15.SS2.SSS1.p1" class="ltx_para ltx_noindent">
<p id="S15.SS2.SSS1.p1.1" class="ltx_p">The following definitions are rather artificial. However, they help us organize various constructions and package required properties. We use the following notations a lot: given any group <math id="S15.SS2.SSS1.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>, let <math id="S15.SS2.SSS1.p1.m2" class="ltx_Math" alttext="\hat{G}=G\times G" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>G</mi><mo>^</mo></mover><mo>=</mo><mrow><mi>G</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>G</mi></mrow></mrow><annotation encoding="application/x-tex">\hat{G}=G\times G</annotation></semantics></math>. We often denote the first factor by <math id="S15.SS2.SSS1.p1.m3" class="ltx_Math" alttext="G_{L}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>L</mi></msub><annotation encoding="application/x-tex">G_{L}</annotation></semantics></math> and the second factor by <math id="S15.SS2.SSS1.p1.m4" class="ltx_Math" alttext="G_{R}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>R</mi></msub><annotation encoding="application/x-tex">G_{R}</annotation></semantics></math>.</p>
</div>
<div id="S15.Thmthm6" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S15.Thmthm6.2" class="ltx_text ltx_font_bold">Definition 15.6</span></span><span id="S15.Thmthm6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S15.Thmthm6.p1" class="ltx_para">
<ol id="S15.I6" class="ltx_enumerate">
<li id="S15.I6.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S15.I6.i1.p1" class="ltx_para ltx_noindent">
<p id="S15.I6.i1.p1.1" class="ltx_p">The category <math id="S15.I6.i1.p1.m1" class="ltx_Math" alttext="\underline{\smash{\bf Map}}^{\rm fr}" display="inline" intent=":literal"><semantics><msup><munder accentunder="true"><mi>𝐌𝐚𝐩</mi><mo stretchy="true">¯</mo></munder><mi>fr</mi></msup><annotation encoding="application/x-tex">\underline{\smash{\bf Map}}^{\rm fr}</annotation></semantics></math> has objects</p>
<table id="S15.Ex32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex32.m1" class="ltx_Math" alttext="\hat{\mathcal{C}}:=({\mathcal{G}},B,C,Y)" display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>^</mo></mover><mo>:=</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>,</mo><mi>B</mi><mo>,</mo><mi>C</mi><mo>,</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{\mathcal{C}}:=({\mathcal{G}},B,C,Y)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.I6.i1.p1.2" class="ltx_p">where <math id="S15.I6.i1.p1.m2" class="ltx_Math" alttext="({\mathcal{G}},B,C)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>,</mo><mi>B</mi><mo>,</mo><mi>C</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathcal{G}},B,C)</annotation></semantics></math> is an object of <math id="S15.I6.i1.p1.m3" class="ltx_Math" alttext="\underline{\smash{\bf Curve}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf Curve}}</annotation></semantics></math>, <math id="S15.I6.i1.p1.m4" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> is a <math id="S15.I6.i1.p1.m5" class="ltx_Math" alttext="{\mathcal{G}}\times{\mathcal{G}}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow><annotation encoding="application/x-tex">{\mathcal{G}}\times{\mathcal{G}}</annotation></semantics></math>-space together with a map <math id="S15.I6.i1.p1.m6" class="ltx_Math" alttext="\pi:Y\to B" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>Y</mi><mo stretchy="false">→</mo><mi>B</mi></mrow></mrow><annotation encoding="application/x-tex">\pi:Y\to B</annotation></semantics></math> which is equivariant with respect to the projection <math id="S15.I6.i1.p1.m7" class="ltx_Math" alttext="{\mathcal{G}}_{L}\times{\mathcal{G}}_{R}\to{\mathcal{G}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>L</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>R</mi></msub></mrow><mo stretchy="false">→</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow><annotation encoding="application/x-tex">{\mathcal{G}}_{L}\times{\mathcal{G}}_{R}\to{\mathcal{G}}</annotation></semantics></math> onto the first factor and the action by <math id="S15.I6.i1.p1.m8" class="ltx_Math" alttext="{\mathcal{G}}_{R}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>R</mi></msub><annotation encoding="application/x-tex">{\mathcal{G}}_{R}</annotation></semantics></math> on <math id="S15.I6.i1.p1.m9" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> is free.</p>
</div></li>
<li id="S15.I6.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S15.I6.i2.p1" class="ltx_para ltx_noindent">
<p id="S15.I6.i2.p1.1" class="ltx_p">Let <math id="S15.I6.i2.p1.m1" class="ltx_Math" alttext="\hat{\mathcal{C}}_{i}=({\mathcal{G}}_{i},B_{i},C_{i},Y_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>^</mo></mover><mi>i</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>i</mi></msub><mo>,</mo><msub><mi>B</mi><mi>i</mi></msub><mo>,</mo><msub><mi>C</mi><mi>i</mi></msub><mo>,</mo><msub><mi>Y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{\mathcal{C}}_{i}=({\mathcal{G}}_{i},B_{i},C_{i},Y_{i})</annotation></semantics></math>, <math id="S15.I6.i2.p1.m2" class="ltx_Math" alttext="i=1,2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">i=1,2</annotation></semantics></math> be two objects of <math id="S15.I6.i2.p1.m3" class="ltx_Math" alttext="\underline{\smash{\bf Map}}^{\rm fr}" display="inline" intent=":literal"><semantics><msup><munder accentunder="true"><mi>𝐌𝐚𝐩</mi><mo stretchy="true">¯</mo></munder><mi>fr</mi></msup><annotation encoding="application/x-tex">\underline{\smash{\bf Map}}^{\rm fr}</annotation></semantics></math>. A strict embedding from <math id="S15.I6.i2.p1.m4" class="ltx_Math" alttext="\hat{\mathcal{C}}_{1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>^</mo></mover><mn>1</mn></msub><annotation encoding="application/x-tex">\hat{\mathcal{C}}_{1}</annotation></semantics></math> to <math id="S15.I6.i2.p1.m5" class="ltx_Math" alttext="\hat{\mathcal{C}}_{2}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>^</mo></mover><mn>2</mn></msub><annotation encoding="application/x-tex">\hat{\mathcal{C}}_{2}</annotation></semantics></math>, denoted by <math id="S15.I6.i2.p1.m6" class="ltx_Math" alttext="\hat{\zeta}_{21}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ζ</mi><mo>^</mo></mover><mn>21</mn></msub><annotation encoding="application/x-tex">\hat{\zeta}_{21}</annotation></semantics></math>, consists of a strict embedding</p>
<table id="S15.Ex33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex33.m1" class="ltx_Math" alttext="\zeta_{21}:{\mathcal{C}}_{1}\to{\mathcal{C}}_{2}" display="block" intent=":literal"><semantics><mrow><msub><mi>ζ</mi><mn>21</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mn>1</mn></msub><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\zeta_{21}:{\mathcal{C}}_{1}\to{\mathcal{C}}_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.I6.i2.p1.2" class="ltx_p">in <math id="S15.I6.i2.p1.m7" class="ltx_Math" alttext="\underline{\smash{\bf Curve}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf Curve}}</annotation></semantics></math> and a map <math id="S15.I6.i2.p1.m8" class="ltx_Math" alttext="\zeta_{21}^{Y}:Y_{1}\to Y_{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ζ</mi><mn>21</mn><mi>Y</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>Y</mi><mn>1</mn></msub><mo stretchy="false">→</mo><msub><mi>Y</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\zeta_{21}^{Y}:Y_{1}\to Y_{2}</annotation></semantics></math> equivariant with respect to <math id="S15.I6.i2.p1.m9" class="ltx_Math" alttext="\hat{\mathcal{G}}_{1}\to\hat{\mathcal{G}}_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>^</mo></mover><mn>1</mn></msub><mo stretchy="false">→</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>^</mo></mover><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\hat{\mathcal{G}}_{1}\to\hat{\mathcal{G}}_{2}</annotation></semantics></math> such that</p>
<ol id="S15.I6.i2.I1" class="ltx_enumerate">
<li id="S15.I6.i2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(a)</span> 
<div id="S15.I6.i2.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="S15.I6.i2.I1.i1.p1.1" class="ltx_p">The induced map</p>
<table id="S15.Ex34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex34.m1" class="ltx_Math" alttext="\hat{\mathcal{G}}_{2}\times_{\hat{\mathcal{G}}_{1}}Y_{1}\to Y_{2}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>^</mo></mover><mn>2</mn></msub><msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>^</mo></mover><mn>1</mn></msub></msub><msub><mi>Y</mi><mn>1</mn></msub></mrow><mo stretchy="false">→</mo><msub><mi>Y</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\hat{\mathcal{G}}_{2}\times_{\hat{\mathcal{G}}_{1}}Y_{1}\to Y_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.I6.i2.I1.i1.p1.2" class="ltx_p">is an homeomorphism onto the corresponding union of strata.</p>
</div></li>
<li id="S15.I6.i2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(b)</span> 
<div id="S15.I6.i2.I1.i2.p1" class="ltx_para ltx_noindent">
<p id="S15.I6.i2.I1.i2.p1.1" class="ltx_p">The following diagram commutes.</p>
<table id="S15.Ex35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S15.Ex35.m1.pic1" class="ltx_picture ltx_markedasmath" height="63.19" overflow="visible" style="vertical-align:-53.041805712302825px" version="1.1" viewBox="23.45 53.04 105.76 63.19" width="105.76"><g transform="matrix(1 0 0 -1 23.44619457497708 63.188910995658645) translate(0,3.46) translate(23.45,0)"><g transform="translate(-12.85,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.26em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="17.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S15.Ex35.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{B_{1}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\textstyle{B_{1}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -9.685900096859001 L 0.27673578005007266 -9.685900096859001" fill="none" stroke="#000000"></path><g transform="translate(-23.45,0) translate(0,-21.68) translate(4.15,0) translate(0,-3.51)"><foreignObject style="--ltx-fo-width:1.09em;--ltx-fo-height:0.64em;--ltx-fo-depth:0.14em;font-size:10pt;" height="10.79" overflow="visible" transform="matrix(1 0 0 -1 0 8.9)" width="15.14"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S15.Ex35.m1.pic1.m2" class="ltx_Math" alttext="\scriptstyle{\zeta_{21}^{B}}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.700em">ζ</mi><mn mathsize="0.710em">21</mn><mi mathsize="0.710em">B</mi></msubsup><annotation encoding="application/x-tex">\scriptstyle{\zeta_{21}^{B}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.208800332088 L 0.27673578005007266 -9.685900096859001" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.208800332088 L 0.27673578005007266 -33.208800332088" fill="none" stroke="#000000"></path><g transform="translate(46.06,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.25em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="17.32"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S15.Ex35.m1.pic1.m3" class="ltx_Math" alttext="\textstyle{Y_{1}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\textstyle{Y_{1}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 58.5906040755911 -9.685900096859001 L 59.144075635691244 -9.685900096859001" fill="none" stroke="#000000"></path><g transform="translate(58.87,0) translate(0,-21.68) translate(4.15,0) translate(0,-3.51)"><foreignObject style="--ltx-fo-width:1.09em;--ltx-fo-height:0.64em;--ltx-fo-depth:0.14em;font-size:10pt;" height="10.79" overflow="visible" transform="matrix(1 0 0 -1 0 8.9)" width="15.14"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S15.Ex35.m1.pic1.m4" class="ltx_Math" alttext="\scriptstyle{\zeta_{21}^{Y}}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.700em">ζ</mi><mn mathsize="0.710em">21</mn><mi mathsize="0.710em">Y</mi></msubsup><annotation encoding="application/x-tex">\scriptstyle{\zeta_{21}^{Y}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(58.87,0) translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 58.5906040755911 -33.208800332088 L 59.144075635691244 -9.685900096859001" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 58.5906040755911 -33.208800332088 L 59.144075635691244 -33.208800332088" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 46.058486932142486 -0.27673578005007266 L 46.058486932142486 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(12.85,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 6.92 -2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 6.92 2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 12.849686600054483 -0.27673578005007266 L 46.058486932142486 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 12.849686600054483 -0.27673578005007266 L 12.849686600054483 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(-12.85,0) translate(0,-43.36) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.26em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="17.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S15.Ex35.m1.pic1.m5" class="ltx_Math" alttext="\textstyle{B_{2}}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\textstyle{B_{2}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(46.06,0) translate(0,-43.36) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.25em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="17.32"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S15.Ex35.m1.pic1.m6" class="ltx_Math" alttext="\textstyle{Y_{2}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\textstyle{Y_{2}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 46.058486932142486 -43.63264139549389 L 46.058486932142486 -43.07916983539375" fill="none" stroke="#000000"></path><g transform="translate(12.85,0) translate(0,-43.36)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 6.92 -2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 6.92 2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 12.849686600054483 -43.63264139549389 L 46.058486932142486 -43.07916983539375" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 12.849686600054483 -43.63264139549389 L 12.849686600054483 -43.07916983539375" fill="none" stroke="#000000"></path></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
</div></li>
<li id="S15.I6.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S15.I6.i3.p1" class="ltx_para ltx_noindent">
<p id="S15.I6.i3.p1.1" class="ltx_p">A <span id="S15.I6.i3.p1.1.1" class="ltx_text ltx_font_bold">rigidification</span> of a strict embedding <math id="S15.I6.i3.p1.m1" class="ltx_Math" alttext="\hat{\zeta}_{21}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ζ</mi><mo>^</mo></mover><mn>21</mn></msub><annotation encoding="application/x-tex">\hat{\zeta}_{21}</annotation></semantics></math> is a rigidification of the underlying strict embedding <math id="S15.I6.i3.p1.m2" class="ltx_Math" alttext="\zeta_{21}" display="inline" intent=":literal"><semantics><msub><mi>ζ</mi><mn>21</mn></msub><annotation encoding="application/x-tex">\zeta_{21}</annotation></semantics></math> in <math id="S15.I6.i3.p1.m3" class="ltx_Math" alttext="\underline{\smash{\bf Curve}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf Curve}}</annotation></semantics></math>.</p>
</div></li>
<li id="S15.I6.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S15.I6.i4.p1" class="ltx_para">
<p id="S15.I6.i4.p1.1" class="ltx_p">The notion of unitary conjugations and embeddings are defined similar to many previous cases. We omit the details. Let <math id="S15.I6.i4.p1.m1" class="ltx_Math" alttext="\underline{\smash{\bf Map}}^{\rm fr}" display="inline" intent=":literal"><semantics><msup><munder accentunder="true"><mi>𝐌𝐚𝐩</mi><mo stretchy="true">¯</mo></munder><mi>fr</mi></msup><annotation encoding="application/x-tex">\underline{\smash{\bf Map}}^{\rm fr}</annotation></semantics></math> be the category of framed maps with morphisms being embeddings and <math id="S15.I6.i4.p1.m2" class="ltx_Math" alttext="\underline{\smash{\bf Map}}^{\rm fr}_{\rm rig}" display="inline" intent=":literal"><semantics><msubsup><munder accentunder="true"><mi>𝐌𝐚𝐩</mi><mo stretchy="true">¯</mo></munder><mi>rig</mi><mi>fr</mi></msubsup><annotation encoding="application/x-tex">\underline{\smash{\bf Map}}^{\rm fr}_{\rm rig}</annotation></semantics></math> be the rigidified version.</p>
</div></li>
</ol>
</div>
</div>
</section>
<section id="S15.SS2.SSS2" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">15.2.2. </span>Group reductions</h5>

<div id="S15.SS2.SSS2.p1" class="ltx_para ltx_noindent">
<p id="S15.SS2.SSS2.p1.1" class="ltx_p">By definition, Kuranishi spaces have symmetry group being a compact Lie group <math id="S15.SS2.SSS2.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>, while the corresponding AMS domain has the symmetry group being a complex Lie group <math id="S15.SS2.SSS2.p1.m2" class="ltx_Math" alttext="{\mathcal{G}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">{\mathcal{G}}</annotation></semantics></math>. The redundancy is reduced by choosing certain group reductions.</p>
</div>
<div id="S15.Thmthm7" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S15.Thmthm7.2" class="ltx_text ltx_font_bold">Definition 15.7</span></span><span id="S15.Thmthm7.3" class="ltx_text ltx_font_bold"> </span>(The category of families of reduced framed maps)<span id="S15.Thmthm7.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S15.Thmthm7.p1" class="ltx_para">
<ol id="S15.I7" class="ltx_enumerate">
<li id="S15.I7.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S15.I7.i1.p1" class="ltx_para ltx_noindent">
<p id="S15.I7.i1.p1.1" class="ltx_p">Let <math id="S15.I7.i1.p1.m1" class="ltx_Math" alttext="\hat{\mathcal{C}}=({\mathcal{G}},B,C,Y)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>^</mo></mover><mo>=</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>,</mo><mi>B</mi><mo>,</mo><mi>C</mi><mo>,</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{\mathcal{C}}=({\mathcal{G}},B,C,Y)</annotation></semantics></math> be an object of <math id="S15.I7.i1.p1.m2" class="ltx_Math" alttext="\underline{\smash{\bf Map}}^{\rm fr}" display="inline" intent=":literal"><semantics><msup><munder accentunder="true"><mi>𝐌𝐚𝐩</mi><mo stretchy="true">¯</mo></munder><mi>fr</mi></msup><annotation encoding="application/x-tex">\underline{\smash{\bf Map}}^{\rm fr}</annotation></semantics></math>. A <span id="S15.I7.i1.p1.1.1" class="ltx_text ltx_font_bold">group reduction</span> of <math id="S15.I7.i1.p1.m3" class="ltx_Math" alttext="\hat{\mathcal{C}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\mathcal{C}}</annotation></semantics></math> is a map</p>
<table id="S15.Ex36" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex36.m1" class="ltx_Math" alttext="\Lambda:Y\to{\mathcal{G}}/G" display="block" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>Y</mi><mo stretchy="false">→</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>/</mo><mi>G</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\Lambda:Y\to{\mathcal{G}}/G</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.I7.i1.p1.2" class="ltx_p">which is <math id="S15.I7.i1.p1.m4" class="ltx_Math" alttext="{\mathcal{G}}_{L}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>L</mi></msub><annotation encoding="application/x-tex">{\mathcal{G}}_{L}</annotation></semantics></math>-invariant and <math id="S15.I7.i1.p1.m5" class="ltx_Math" alttext="{\mathcal{G}}_{R}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>R</mi></msub><annotation encoding="application/x-tex">{\mathcal{G}}_{R}</annotation></semantics></math>-equivariant.</p>
</div></li>
<li id="S15.I7.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S15.I7.i2.p1" class="ltx_para ltx_noindent">
<p id="S15.I7.i2.p1.1" class="ltx_p">The category of <span id="S15.I7.i2.p1.1.1" class="ltx_text ltx_font_bold">equivariant families of reduced framed maps</span>, denoted by <math id="S15.I7.i2.p1.m1" class="ltx_Math" alttext="\underline{\smash{\bf map}}^{\rm fr}" display="inline" intent=":literal"><semantics><msup><munder accentunder="true"><mi>𝐦𝐚𝐩</mi><mo stretchy="true">¯</mo></munder><mi>fr</mi></msup><annotation encoding="application/x-tex">\underline{\smash{\bf map}}^{\rm fr}</annotation></semantics></math> consists of objects <math id="S15.I7.i2.p1.m2" class="ltx_Math" alttext="({\mathcal{G}},B,C,Y,\Lambda)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>,</mo><mi>B</mi><mo>,</mo><mi>C</mi><mo>,</mo><mi>Y</mi><mo>,</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathcal{G}},B,C,Y,\Lambda)</annotation></semantics></math> where <math id="S15.I7.i2.p1.m3" class="ltx_Math" alttext="({\mathcal{G}},B,C,Y)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>,</mo><mi>B</mi><mo>,</mo><mi>C</mi><mo>,</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathcal{G}},B,C,Y)</annotation></semantics></math> is an object of <math id="S15.I7.i2.p1.m4" class="ltx_Math" alttext="\underline{\smash{\bf Map}}^{\rm fr}" display="inline" intent=":literal"><semantics><msup><munder accentunder="true"><mi>𝐌𝐚𝐩</mi><mo stretchy="true">¯</mo></munder><mi>fr</mi></msup><annotation encoding="application/x-tex">\underline{\smash{\bf Map}}^{\rm fr}</annotation></semantics></math> and <math id="S15.I7.i2.p1.m5" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> is a group reduction. A <span id="S15.I7.i2.p1.1.2" class="ltx_text ltx_font_bold">strict embedding</span> <math id="S15.I7.i2.p1.m6" class="ltx_Math" alttext="\hat{\zeta}_{21}:\hat{\mathcal{C}}_{1}\to\hat{\mathcal{C}}_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ζ</mi><mo>^</mo></mover><mn>21</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>^</mo></mover><mn>1</mn></msub><mo stretchy="false">→</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>^</mo></mover><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\hat{\zeta}_{21}:\hat{\mathcal{C}}_{1}\to\hat{\mathcal{C}}_{2}</annotation></semantics></math> in <math id="S15.I7.i2.p1.m7" class="ltx_Math" alttext="\underline{\smash{\bf map}}^{\rm fr}" display="inline" intent=":literal"><semantics><msup><munder accentunder="true"><mi>𝐦𝐚𝐩</mi><mo stretchy="true">¯</mo></munder><mi>fr</mi></msup><annotation encoding="application/x-tex">\underline{\smash{\bf map}}^{\rm fr}</annotation></semantics></math> consists of a strict embedding of <math id="S15.I7.i2.p1.m8" class="ltx_Math" alttext="\underline{\smash{\bf Map}}^{\rm fr}" display="inline" intent=":literal"><semantics><msup><munder accentunder="true"><mi>𝐌𝐚𝐩</mi><mo stretchy="true">¯</mo></munder><mi>fr</mi></msup><annotation encoding="application/x-tex">\underline{\smash{\bf Map}}^{\rm fr}</annotation></semantics></math>, which induces a map</p>
<table id="S15.Ex37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex37.m1" class="ltx_Math" alttext="\zeta_{21}^{P}:{\mathcal{G}}_{1}/G_{1}\to{\mathcal{G}}_{2}/G_{2}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>ζ</mi><mn>21</mn><mi>P</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mn>1</mn></msub><mo>/</mo><msub><mi>G</mi><mn>1</mn></msub></mrow><mo stretchy="false">→</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mn>2</mn></msub><mo>/</mo><msub><mi>G</mi><mn>2</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\zeta_{21}^{P}:{\mathcal{G}}_{1}/G_{1}\to{\mathcal{G}}_{2}/G_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.I7.i2.p1.2" class="ltx_p">such that following diagram commutes.</p>
<table id="S15.Ex38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S15.Ex38.m1.pic1" class="ltx_picture ltx_markedasmath" height="76.89" overflow="visible" style="vertical-align:-60.58300879217042px" version="1.1" viewBox="23.45 60.58 132.67 76.89" width="132.67"><g transform="matrix(1 0 0 -1 23.44619457497708 76.88761714155683) translate(0,3.46) translate(23.45,0)"><g transform="translate(-12.81,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.25em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="17.32"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S15.Ex38.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{Y_{1}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\textstyle{Y_{1}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 12.808852923498685 -0.27673578005007266 L 12.808852923498685 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(18.78,0) translate(0,8.15) translate(4.15,0) translate(0,-2.62)"><foreignObject style="--ltx-fo-width:0.94em;--ltx-fo-height:0.48em;--ltx-fo-depth:0.1em;font-size:10pt;" height="8" overflow="visible" transform="matrix(1 0 0 -1 0 6.62)" width="12.97"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S15.Ex38.m1.pic1.m2" class="ltx_Math" alttext="\scriptstyle{\Lambda_{1}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em" mathvariant="normal">Λ</mi><mn mathsize="0.710em">1</mn></msub><annotation encoding="application/x-tex">\scriptstyle{\Lambda_{1}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(46.02,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 12.808852923498685 -0.27673578005007266 L 46.01765325558669 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 46.01765325558669 -0.27673578005007266 L 46.01765325558669 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -9.685900096859001 L 0.27673578005007266 -9.685900096859001" fill="none" stroke="#000000"></path><g transform="translate(-23.45,0) translate(0,-22.14) translate(4.15,0) translate(0,-3.51)"><foreignObject style="--ltx-fo-width:1.09em;--ltx-fo-height:0.64em;--ltx-fo-depth:0.14em;font-size:10pt;" height="10.79" overflow="visible" transform="matrix(1 0 0 -1 0 8.9)" width="15.14"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S15.Ex38.m1.pic1.m3" class="ltx_Math" alttext="\scriptstyle{\zeta_{21}^{Y}}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.700em">ζ</mi><mn mathsize="0.710em">21</mn><mi mathsize="0.710em">Y</mi></msubsup><annotation encoding="application/x-tex">\scriptstyle{\zeta_{21}^{Y}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(0,-34.13)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -34.131295159428184 L 0.27673578005007266 -9.685900096859001" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -34.131295159428184 L 0.27673578005007266 -34.131295159428184" fill="none" stroke="#000000"></path><g transform="translate(46.02,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:3.97em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="54.91"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S15.Ex38.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{({\mathcal{G}}_{1}/G_{1})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mn>1</mn></msub><mo>/</mo><msub><mi>G</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\textstyle{({\mathcal{G}}_{1}/G_{1})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 77.34597199385767 -11.069600110696001 L 77.89944355395781 -11.069600110696001" fill="none" stroke="#000000"></path><g transform="translate(77.62,0) translate(0,-22.14) translate(4.15,0) translate(0,-3.51)"><foreignObject style="--ltx-fo-width:1.09em;--ltx-fo-height:0.64em;--ltx-fo-depth:0.14em;font-size:10pt;" height="10.79" overflow="visible" transform="matrix(1 0 0 -1 0 8.9)" width="15.14"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S15.Ex38.m1.pic1.m5" class="ltx_Math" alttext="\scriptstyle{\zeta_{21}^{P}}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.700em">ζ</mi><mn mathsize="0.710em">21</mn><mi mathsize="0.710em">P</mi></msubsup><annotation encoding="application/x-tex">\scriptstyle{\zeta_{21}^{P}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(77.62,0) translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 77.34597199385767 -33.208800332088 L 77.89944355395781 -11.069600110696001" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 77.34597199385767 -33.208800332088 L 77.89944355395781 -33.208800332088" fill="none" stroke="#000000"></path><g transform="translate(-12.81,0) translate(0,-44.28) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.25em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="17.32"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S15.Ex38.m1.pic1.m6" class="ltx_Math" alttext="\textstyle{Y_{2}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\textstyle{Y_{2}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 12.808852923498685 -44.55513622283408 L 12.808852923498685 -44.00166466273393" fill="none" stroke="#000000"></path><g transform="translate(18.78,0) translate(0,-52.43) translate(4.15,0) translate(0,-2.62)"><foreignObject style="--ltx-fo-width:0.94em;--ltx-fo-height:0.48em;--ltx-fo-depth:0.1em;font-size:10pt;" height="8" overflow="visible" transform="matrix(1 0 0 -1 0 6.62)" width="12.97"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S15.Ex38.m1.pic1.m7" class="ltx_Math" alttext="\scriptstyle{\Lambda_{2}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em" mathvariant="normal">Λ</mi><mn mathsize="0.710em">2</mn></msub><annotation encoding="application/x-tex">\scriptstyle{\Lambda_{2}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(46.02,0) translate(0,-44.28)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 12.808852923498685 -44.55513622283408 L 46.01765325558669 -44.00166466273393" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 46.01765325558669 -44.55513622283408 L 46.01765325558669 -44.00166466273393" fill="none" stroke="#000000"></path><g transform="translate(46.02,0) translate(0,-44.28) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:3.97em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="54.91"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S15.Ex38.m1.pic1.m8" class="ltx_Math" alttext="\textstyle{({\mathcal{G}}_{2}/G_{2})}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mn>2</mn></msub><mo>/</mo><msub><mi>G</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\textstyle{({\mathcal{G}}_{2}/G_{2})}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.I7.i2.p1.3" class="ltx_p">The notions of unitary conjugations and embeddings are defined in a way similar to previously considered situations. Morphisms in <math id="S15.I7.i2.p1.m9" class="ltx_Math" alttext="\underline{\smash{\bf map}}^{\rm fr}" display="inline" intent=":literal"><semantics><msup><munder accentunder="true"><mi>𝐦𝐚𝐩</mi><mo stretchy="true">¯</mo></munder><mi>fr</mi></msup><annotation encoding="application/x-tex">\underline{\smash{\bf map}}^{\rm fr}</annotation></semantics></math> are embeddings, i.e., strict embeddings modulo unitary conjugations.</p>
</div></li>
<li id="S15.I7.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S15.I7.i3.p1" class="ltx_para ltx_noindent">
<p id="S15.I7.i3.p1.1" class="ltx_p">A rigidification of a strict embedding <math id="S15.I7.i3.p1.m1" class="ltx_Math" alttext="\hat{\zeta}_{21}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ζ</mi><mo>^</mo></mover><mn>21</mn></msub><annotation encoding="application/x-tex">\hat{\zeta}_{21}</annotation></semantics></math> as considered above is a rigidification of the underlying strict embedding in <math id="S15.I7.i3.p1.m2" class="ltx_Math" alttext="\underline{\smash{\bf Curve}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf Curve}}</annotation></semantics></math>, and we denote the resulting category by <math id="S15.I7.i3.p1.m3" class="ltx_Math" alttext="\underline{\smash{\bf map}}^{\rm fr}_{\rm rig}" display="inline" intent=":literal"><semantics><msubsup><munder accentunder="true"><mi>𝐦𝐚𝐩</mi><mo stretchy="true">¯</mo></munder><mi>rig</mi><mi>fr</mi></msubsup><annotation encoding="application/x-tex">\underline{\smash{\bf map}}^{\rm fr}_{\rm rig}</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
</div>
<div id="S15.SS2.SSS2.p2" class="ltx_para ltx_noindent">
<p id="S15.SS2.SSS2.p2.1" class="ltx_p">As usual, we indicate the outercollaring using the notation <sub id="S15.SS2.SSS2.p2.1.1" class="ltx_sub"><span id="S15.SS2.SSS2.p2.1.1.1" class="ltx_text ltx_font_italic">⌊</span></sub>.</p>
</div>
</section>
<section id="S15.SS2.SSS3" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">15.2.3. </span>Modification of energy density</h5>

<div id="S15.SS2.SSS3.p1" class="ltx_para ltx_noindent">
<p id="S15.SS2.SSS3.p1.1" class="ltx_p">Given an integral action <math id="S15.SS2.SSS3.p1.m1" class="ltx_Math" alttext="{\mathcal{A}}_{\mathbb{F}}^{\Omega}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>𝔽</mi><mi mathvariant="normal">Ω</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{A}}_{\mathbb{F}}^{\Omega}</annotation></semantics></math> on <math id="S15.SS2.SSS3.p1.m2" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math>, there are also the induced modification of the energy density. Given any smooth map <math id="S15.SS2.SSS3.p1.m3" class="ltx_Math" alttext="u:{\mathbb{R}}\times S^{1}\to X" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>ℝ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>S</mi><mn>1</mn></msup></mrow><mo stretchy="false">→</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">u:{\mathbb{R}}\times S^{1}\to X</annotation></semantics></math> which converges to a pair of objects <math id="S15.SS2.SSS3.p1.m4" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> and <math id="S15.SS2.SSS3.p1.m5" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> with <math id="S15.SS2.SSS3.p1.m6" class="ltx_Math" alttext="{\mathcal{A}}_{H}(p)&gt;{\mathcal{A}}_{H}(q)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{A}}_{H}(p)&gt;{\mathcal{A}}_{H}(q)</annotation></semantics></math>, define</p>
<table id="S15.E5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.E5.m1" class="ltx_Math" alttext="\Omega_{u}:=\Omega(\partial_{s}u,\partial_{t}u-X^{\Omega}_{H_{t}}(u))ds\wedge dt\in\Omega^{2}({\mathbb{R}}\times S^{1})." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Ω</mi><mi>u</mi></msub><mo>:=</mo><mrow><mrow><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mo lspace="0em">∂</mo><mi>s</mi></msub><mi>u</mi></mrow><mo rspace="0em">,</mo><mrow><mrow><msub><mo>∂</mo><mi>t</mi></msub><mi>u</mi></mrow><mo>−</mo><mrow><msubsup><mi>X</mi><msub><mi>H</mi><mi>t</mi></msub><mi mathvariant="normal">Ω</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>∧</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo>∈</mo><mrow><msup><mi mathvariant="normal">Ω</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ℝ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>S</mi><mn>1</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Omega_{u}:=\Omega(\partial_{s}u,\partial_{t}u-X^{\Omega}_{H_{t}}(u))ds\wedge dt\in\Omega^{2}({\mathbb{R}}\times S^{1}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15.5)</span></td></tr></tbody>
</table>
<p id="S15.SS2.SSS3.p1.2" class="ltx_p">Then its integral is the integer <math id="S15.SS2.SSS3.p1.m7" class="ltx_Math" alttext="{\mathcal{A}}_{\mathbb{F}}^{\Omega}(p)-{\mathcal{A}}_{\mathbb{F}}^{\Omega}(q)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>𝔽</mi><mi mathvariant="normal">Ω</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>𝔽</mi><mi mathvariant="normal">Ω</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{A}}_{\mathbb{F}}^{\Omega}(p)-{\mathcal{A}}_{\mathbb{F}}^{\Omega}(q)</annotation></semantics></math>. We may regard <math id="S15.SS2.SSS3.p1.m8" class="ltx_Math" alttext="\Omega_{u}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ω</mi><mi>u</mi></msub><annotation encoding="application/x-tex">\Omega_{u}</annotation></semantics></math> as a modified energy density, which is everywhere nonnegative when <math id="S15.SS2.SSS3.p1.m9" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> is a Floer cylinder. Similarly, given a smooth map <math id="S15.SS2.SSS3.p1.m10" class="ltx_Math" alttext="u:S^{2}\to X" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>S</mi><mn>2</mn></msup><mo stretchy="false">→</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">u:S^{2}\to X</annotation></semantics></math> representing a sphere class <math id="S15.SS2.SSS3.p1.m11" class="ltx_Math" alttext="A\in\pi_{2}(X)" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>∈</mo><mrow><msub><mi>π</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">A\in\pi_{2}(X)</annotation></semantics></math>, define</p>
<table id="S15.Ex39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex39.m1" class="ltx_Math" alttext="\Omega_{u}:=u^{*}\Omega\in\Omega^{2}(S^{2})." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Ω</mi><mi>u</mi></msub><mo>:=</mo><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Ω</mi></mrow><mo>∈</mo><mrow><msup><mi mathvariant="normal">Ω</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>S</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Omega_{u}:=u^{*}\Omega\in\Omega^{2}(S^{2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS2.SSS3.p1.3" class="ltx_p">Its integral is <math id="S15.SS2.SSS3.p1.m12" class="ltx_Math" alttext="\Omega(A)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Omega(A)</annotation></semantics></math>; when <math id="S15.SS2.SSS3.p1.m13" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> is a <math id="S15.SS2.SSS3.p1.m14" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math>-holomorphic sphere, <math id="S15.SS2.SSS3.p1.m15" class="ltx_Math" alttext="\Omega_{u}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ω</mi><mi>u</mi></msub><annotation encoding="application/x-tex">\Omega_{u}</annotation></semantics></math> is everywhere nonnegative.</p>
</div>
<div id="S15.SS2.SSS3.p2" class="ltx_para ltx_noindent">
<p id="S15.SS2.SSS3.p2.1" class="ltx_p">In general, given smooth map <math id="S15.SS2.SSS3.p2.m1" class="ltx_Math" alttext="u:\Sigma\to X" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">u:\Sigma\to X</annotation></semantics></math> over a Floer domain with associated flow multimodudle <math id="S15.SS2.SSS3.p2.m2" class="ltx_Math" alttext="{\mathbb{X}}" display="inline" intent=":literal"><semantics><mi>𝕏</mi><annotation encoding="application/x-tex">{\mathbb{X}}</annotation></semantics></math> over <math id="S15.SS2.SSS3.p2.m3" class="ltx_Math" alttext="({\mathbb{F}}_{1},\dots,{\mathbb{F}}_{m},{\mathbb{F}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo>,</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{1},\dots,{\mathbb{F}}_{m},{\mathbb{F}}^{\prime})</annotation></semantics></math>, recall that we have chosen an integer <math id="S15.SS2.SSS3.p2.m4" class="ltx_Math" alttext="n^{\mathbb{X}}&gt;0" display="inline" intent=":literal"><semantics><mrow><msup><mi>n</mi><mi>𝕏</mi></msup><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n^{\mathbb{X}}&gt;0</annotation></semantics></math>. In this setting, we consider the <math id="S15.SS2.SSS3.p2.m5" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-form</p>
<table id="S15.Ex40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex40.m1" class="ltx_Math" alttext="\Omega_{u}:=u^{*}\Omega+F^{\Omega}_{\alpha}(u)+n^{\mathbb{X}}d{\rm vol}_{\Sigma}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Ω</mi><mi>u</mi></msub><mo>:=</mo><mrow><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Ω</mi></mrow><mo>+</mo><mrow><msubsup><mi>F</mi><mi>α</mi><mi mathvariant="normal">Ω</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>n</mi><mi>𝕏</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>vol</mi><mi mathvariant="normal">Σ</mi></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\Omega_{u}:=u^{*}\Omega+F^{\Omega}_{\alpha}(u)+n^{\mathbb{X}}d{\rm vol}_{\Sigma},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS2.SSS3.p2.2" class="ltx_p">where <math id="S15.SS2.SSS3.p2.m6" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> is the Hamiltonian connection from the Floer datum, and <math id="S15.SS2.SSS3.p2.m7" class="ltx_Math" alttext="F^{\Omega}_{\alpha}(u)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>F</mi><mi>α</mi><mi mathvariant="normal">Ω</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F^{\Omega}_{\alpha}(u)</annotation></semantics></math> denotes its curvature with respect to the symplectic form <math id="S15.SS2.SSS3.p2.m8" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math>. If <math id="S15.SS2.SSS3.p2.m9" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> solves the Floer equation, <math id="S15.SS2.SSS3.p2.m10" class="ltx_Math" alttext="\Omega_{u}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ω</mi><mi>u</mi></msub><annotation encoding="application/x-tex">\Omega_{u}</annotation></semantics></math> is everywhere nonnegative, and <math id="S15.SS2.SSS3.p2.m11" class="ltx_Math" alttext="\int_{\Sigma}\Omega_{u}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∫</mo><mi mathvariant="normal">Σ</mi></msub><msub><mi mathvariant="normal">Ω</mi><mi>u</mi></msub></mrow><annotation encoding="application/x-tex">\int_{\Sigma}\Omega_{u}</annotation></semantics></math> recovers <math id="S15.SS2.SSS3.p2.m12" class="ltx_math_unparsed" alttext="d_{p_{1}\cdots p_{m};p^{\prime}}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub></mrow><annotation encoding="application/x-tex">d_{p_{1}\cdots p_{m};p^{\prime}}</annotation></semantics></math> from (<a href="#S15.E4" title="In 15.1.1. Pullback the domain flow category, multimodule, and homotopy ‣ 15.1. Integral modification of topological energy ‣ 15. Relatively Smooth AMS lifts ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15.4</span></a>). The same construction applies to maps from multimodule homotopies.</p>
</div>
</section>
<section id="S15.SS2.SSS4" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">15.2.4. </span>Floer admissible maps
and framed maps</h5>

<div id="S15.SS2.SSS4.p1" class="ltx_para ltx_noindent">
<p id="S15.SS2.SSS4.p1.1" class="ltx_p">Now we provide the concrete flow categories, multimodules, and homotopies enriched in <math id="S15.SS2.SSS4.p1.m1" class="ltx_Math" alttext="\underline{\smash{\bf Map}}^{\rm fr}" display="inline" intent=":literal"><semantics><msup><munder accentunder="true"><mi>𝐌𝐚𝐩</mi><mo stretchy="true">¯</mo></munder><mi>fr</mi></msup><annotation encoding="application/x-tex">\underline{\smash{\bf Map}}^{\rm fr}</annotation></semantics></math>.</p>
</div>
<div id="S15.SS2.SSS4.p2" class="ltx_para ltx_noindent">
<p id="S15.SS2.SSS4.p2.1" class="ltx_p">We first consider the flow category case. Let <math id="S15.SS2.SSS4.p2.m1" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> be a Floer flow category associated to <math id="S15.SS2.SSS4.p2.m2" class="ltx_Math" alttext="(X,\omega,J)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>ω</mi><mo>,</mo><mi>J</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(X,\omega,J)</annotation></semantics></math> and the Hamiltonian <math id="S15.SS2.SSS4.p2.m3" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>. Let <math id="S15.SS2.SSS4.p2.m4" class="ltx_Math" alttext="{\mathcal{A}}_{\mathbb{F}}^{\Omega}:{\rm Ob}{\mathbb{F}}\to{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>𝔽</mi><mi mathvariant="normal">Ω</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow><mo stretchy="false">→</mo><mi>ℤ</mi></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{A}}_{\mathbb{F}}^{\Omega}:{\rm Ob}{\mathbb{F}}\to{\mathbb{Z}}</annotation></semantics></math> be an integral action with associated integral symplectic form <math id="S15.SS2.SSS4.p2.m5" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math>. Recall that one has obtained a flow category <math id="S15.SS2.SSS4.p2.m6" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{F}}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mrow><mi mathvariant="normal">Ω</mi><mo>,</mo><mi>𝔽</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}^{\Omega,{\mathbb{F}}}</annotation></semantics></math> with the same set of objects as <math id="S15.SS2.SSS4.p2.m7" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> enriched in <math id="S15.SS2.SSS4.p2.m8" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}</annotation></semantics></math>. For each <math id="S15.SS2.SSS4.p2.m9" class="ltx_Math" alttext="p,q\in{\rm Ob}{\mathbb{F}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></mrow><annotation encoding="application/x-tex">p,q\in{\rm Ob}{\mathbb{F}}</annotation></semantics></math>, one has the object</p>
<table id="S15.Ex41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex41.m1" class="ltx_Math" alttext="{\mathcal{C}}_{pq}^{\mathbb{F}}=({\mathcal{G}}_{pq}^{\mathbb{F}},B_{pq}^{\mathbb{F}},C_{pq}^{\mathbb{F}})\in{\rm Ob}\underline{\smash{\bf Curve}}_{\rm rig}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><mo>,</mo><msubsup><mi>B</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><mo>,</mo><msubsup><mi>C</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><msub><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><mi>rig</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{C}}_{pq}^{\mathbb{F}}=({\mathcal{G}}_{pq}^{\mathbb{F}},B_{pq}^{\mathbb{F}},C_{pq}^{\mathbb{F}})\in{\rm Ob}\underline{\smash{\bf Curve}}_{\rm rig}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS2.SSS4.p2.2" class="ltx_p">We define a <math id="S15.SS2.SSS4.p2.m10" class="ltx_Math" alttext="\hat{\mathcal{G}}_{pq}^{\mathbb{F}}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>^</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><annotation encoding="application/x-tex">\hat{\mathcal{G}}_{pq}^{\mathbb{F}}</annotation></semantics></math>-space <math id="S15.SS2.SSS4.p2.m11" class="ltx_Math" alttext="Y_{pq}^{\mathbb{F}}" display="inline" intent=":literal"><semantics><msubsup><mi>Y</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><annotation encoding="application/x-tex">Y_{pq}^{\mathbb{F}}</annotation></semantics></math> as follows. For each <math id="S15.SS2.SSS4.p2.m12" class="ltx_Math" alttext="\phi\in B_{pq}^{\mathbb{F}}" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>∈</mo><msubsup><mi>B</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup></mrow><annotation encoding="application/x-tex">\phi\in B_{pq}^{\mathbb{F}}</annotation></semantics></math>, consider continuous maps <math id="S15.SS2.SSS4.p2.m13" class="ltx_Math" alttext="u:C_{\phi}\to X" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>C</mi><mi>ϕ</mi></msub><mo stretchy="false">→</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">u:C_{\phi}\to X</annotation></semantics></math> which are smooth away from nodes and which converge exponentially fast towards 1-periodic orbits of <math id="S15.SS2.SSS4.p2.m14" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>. We require that <math id="S15.SS2.SSS4.p2.m15" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> converges to the orbits <math id="S15.SS2.SSS4.p2.m16" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> resp. <math id="S15.SS2.SSS4.p2.m17" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> at the negative resp. positive end of <math id="S15.SS2.SSS4.p2.m18" class="ltx_Math" alttext="C_{\phi}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>ϕ</mi></msub><annotation encoding="application/x-tex">C_{\phi}</annotation></semantics></math>, and that the cappings satisfy <math id="S15.SS2.SSS4.p2.m19" class="ltx_Math" alttext="p\#u=q" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo>=</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p\#u=q</annotation></semantics></math>. In particular, the homotopy type of the map <math id="S15.SS2.SSS4.p2.m20" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> is constrained by the underlying curve; for example, if <math id="S15.SS2.SSS4.p2.m21" class="ltx_Math" alttext="C_{\phi}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>ϕ</mi></msub><annotation encoding="application/x-tex">C_{\phi}</annotation></semantics></math> has a sphere component of degree <math id="S15.SS2.SSS4.p2.m22" class="ltx_Math" alttext="d^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>d</mi><mo>′</mo></msup><annotation encoding="application/x-tex">d^{\prime}</annotation></semantics></math>, then the restriction of <math id="S15.SS2.SSS4.p2.m23" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> to that component has the same degree <math id="S15.SS2.SSS4.p2.m24" class="ltx_Math" alttext="d^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>d</mi><mo>′</mo></msup><annotation encoding="application/x-tex">d^{\prime}</annotation></semantics></math> measured by the modified integral symplectic form <math id="S15.SS2.SSS4.p2.m25" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math>. For <math id="S15.SS2.SSS4.p2.m26" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> and <math id="S15.SS2.SSS4.p2.m27" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> as above, there is a Hermitian holomorphic line bundle</p>
<table id="S15.Ex42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex42.m1" class="ltx_Math" alttext="L_{u}\to C_{\phi}" display="block" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>u</mi></msub><mo stretchy="false">→</mo><msub><mi>C</mi><mi>ϕ</mi></msub></mrow><annotation encoding="application/x-tex">L_{u}\to C_{\phi}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS2.SSS4.p2.3" class="ltx_p">determined by the 2-form <math id="S15.SS2.SSS4.p2.m28" class="ltx_Math" alttext="\Omega_{u}\in\Omega^{2}(C_{\phi})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Ω</mi><mi>u</mi></msub><mo>∈</mo><mrow><msup><mi mathvariant="normal">Ω</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mi>ϕ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Omega_{u}\in\Omega^{2}(C_{\phi})</annotation></semantics></math> (see (<a href="#S15.E5" title="In 15.2.3. Modification of energy density ‣ 15.2. Framed maps ‣ 15. Relatively Smooth AMS lifts ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15.5</span></a>)) which decays exponentially along cylindrical end. The degree of <math id="S15.SS2.SSS4.p2.m29" class="ltx_Math" alttext="L_{u}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>u</mi></msub><annotation encoding="application/x-tex">L_{u}</annotation></semantics></math> is <math id="S15.SS2.SSS4.p2.m30" class="ltx_Math" alttext="d_{pq}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">d_{pq}</annotation></semantics></math>. Then consider frames</p>
<table id="S15.Ex43" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex43.m1" class="ltx_Math" alttext="F=(f_{0},\cdots,f_{d_{pq}})" display="block" intent=":literal"><semantics><mrow><mi>F</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mn>0</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>f</mi><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F=(f_{0},\cdots,f_{d_{pq}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS2.SSS4.p2.4" class="ltx_p">of the space <math id="S15.SS2.SSS4.p2.m31" class="ltx_Math" alttext="H^{0}(L_{u})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>L</mi><mi>u</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{0}(L_{u})</annotation></semantics></math> modulo <math id="S15.SS2.SSS4.p2.m32" class="ltx_Math" alttext="{\mathbb{C}}^{*}" display="inline" intent=":literal"><semantics><msup><mi>ℂ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">{\mathbb{C}}^{*}</annotation></semantics></math> such that 1) at the negative end <math id="S15.SS2.SSS4.p2.m33" class="ltx_Math" alttext="z_{-}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mo>−</mo></msub><annotation encoding="application/x-tex">z_{-}</annotation></semantics></math> one has</p>
<table id="S15.Ex44" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex44.m1" class="ltx_Math" alttext="[f_{0}(z_{-}),\ldots,f_{d_{pq}}(z_{-})]=[1,0,\ldots,0]\in\mathbb{CP}^{d_{pq}}" display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>f</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>f</mi><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn></mrow><mo stretchy="false">]</mo></mrow><mo>∈</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msup></mrow></mrow><annotation encoding="application/x-tex">[f_{0}(z_{-}),\ldots,f_{d_{pq}}(z_{-})]=[1,0,\ldots,0]\in\mathbb{CP}^{d_{pq}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS2.SSS4.p2.5" class="ltx_p">and 2) the Hermitian matrix</p>
<table id="S15.Ex45" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex45.m1" class="ltx_Math" alttext="\left(\int_{C_{\phi}}\langle f_{\mu},f_{\nu}\rangle\Omega_{u}\right)_{\mu\nu}" display="block" intent=":literal"><semantics><msub><mrow><mo>(</mo><mrow><msub><mo lspace="0em" rspace="0em">∫</mo><msub><mi>C</mi><mi>ϕ</mi></msub></msub><mrow><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>f</mi><mi>μ</mi></msub><mo>,</mo><msub><mi>f</mi><mi>ν</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Ω</mi><mi>u</mi></msub></mrow></mrow><mo>)</mo></mrow><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ν</mi></mrow></msub><annotation encoding="application/x-tex">\left(\int_{C_{\phi}}\langle f_{\mu},f_{\nu}\rangle\Omega_{u}\right)_{\mu\nu}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS2.SSS4.p2.6" class="ltx_p">is positive definite, where <math id="S15.SS2.SSS4.p2.m34" class="ltx_Math" alttext="\langle\cdot,\cdot\rangle" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⟨</mo><mrow><mo lspace="0em" rspace="0em">⋅</mo><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo></mrow><mo stretchy="false">⟩</mo></mrow><annotation encoding="application/x-tex">\langle\cdot,\cdot\rangle</annotation></semantics></math> is the fiberwise Hermitian metric on the bundle <math id="S15.SS2.SSS4.p2.m35" class="ltx_Math" alttext="L_{u}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>u</mi></msub><annotation encoding="application/x-tex">L_{u}</annotation></semantics></math>. Notice that the set of such frames <math id="S15.SS2.SSS4.p2.m36" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> is a <math id="S15.SS2.SSS4.p2.m37" class="ltx_Math" alttext="{\mathcal{G}}_{pq}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{G}}_{pq}</annotation></semantics></math>-torsor. Then let <math id="S15.SS2.SSS4.p2.m38" class="ltx_Math" alttext="Y_{pq}^{\mathbb{F}}" display="inline" intent=":literal"><semantics><msubsup><mi>Y</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><annotation encoding="application/x-tex">Y_{pq}^{\mathbb{F}}</annotation></semantics></math> be the set of all tuples <math id="S15.SS2.SSS4.p2.m39" class="ltx_Math" alttext="(\phi,u,F)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>F</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\phi,u,F)</annotation></semantics></math> described as above.</p>
</div>
<div id="S15.SS2.SSS4.p3" class="ltx_para ltx_noindent">
<p id="S15.SS2.SSS4.p3.1" class="ltx_p">The set <math id="S15.SS2.SSS4.p3.m1" class="ltx_Math" alttext="Y_{pq}^{\mathbb{F}}" display="inline" intent=":literal"><semantics><msubsup><mi>Y</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><annotation encoding="application/x-tex">Y_{pq}^{\mathbb{F}}</annotation></semantics></math> has a natural topology and admits a natural forgetful map <math id="S15.SS2.SSS4.p3.m2" class="ltx_Math" alttext="\pi_{0}:Y_{pq}^{\mathbb{F}}\to B_{pq}^{\mathbb{F}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mn>0</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>Y</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><mo stretchy="false">→</mo><msubsup><mi>B</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\pi_{0}:Y_{pq}^{\mathbb{F}}\to B_{pq}^{\mathbb{F}}</annotation></semantics></math>. There is another map</p>
<table id="S15.Ex46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex46.m1" class="ltx_Math" alttext="\pi_{1}:Y_{pq}^{\mathbb{F}}\to B_{pq}^{\mathbb{F}},\ (\phi,u,F)\mapsto\phi_{F}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mn>1</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>Y</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><mo stretchy="false">→</mo><msubsup><mi>B</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>F</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">↦</mo><msub><mi>ϕ</mi><mi>F</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\pi_{1}:Y_{pq}^{\mathbb{F}}\to B_{pq}^{\mathbb{F}},\ (\phi,u,F)\mapsto\phi_{F}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS2.SSS4.p3.2" class="ltx_p">where <math id="S15.SS2.SSS4.p3.m3" class="ltx_Math" alttext="\phi_{F}:C_{\phi}\to\mathbb{CP}^{{\bf d}_{pq}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mi>F</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>C</mi><mi>ϕ</mi></msub><mo stretchy="false">→</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><msub><mi>𝐝</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi_{F}:C_{\phi}\to\mathbb{CP}^{{\bf d}_{pq}}</annotation></semantics></math> is the Kodaira embedding induced by the frame. Moreover, <math id="S15.SS2.SSS4.p3.m4" class="ltx_Math" alttext="Y_{pq}^{\mathbb{F}}" display="inline" intent=":literal"><semantics><msubsup><mi>Y</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><annotation encoding="application/x-tex">Y_{pq}^{\mathbb{F}}</annotation></semantics></math> has an action by <math id="S15.SS2.SSS4.p3.m5" class="ltx_Math" alttext="\hat{\mathcal{G}}_{pq}\cong{\mathcal{G}}_{pq}\times{\mathcal{G}}_{pq}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>^</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>≅</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\hat{\mathcal{G}}_{pq}\cong{\mathcal{G}}_{pq}\times{\mathcal{G}}_{pq}</annotation></semantics></math>, where the first factor acts by reparametrizing the domain and the second factor acts by linearly transforming the frame <math id="S15.SS2.SSS4.p3.m6" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>. One can see that the tuple</p>
<table id="S15.Ex47" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex47.m1" class="ltx_Math" alttext="({\mathcal{G}}_{pq}^{\mathbb{F}},B_{pq}^{\mathbb{F}},C_{pq}^{\mathbb{F}},Y_{pq}^{\mathbb{F}})" display="block" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><mo>,</mo><msubsup><mi>B</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><mo>,</mo><msubsup><mi>C</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><mo>,</mo><msubsup><mi>Y</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathcal{G}}_{pq}^{\mathbb{F}},B_{pq}^{\mathbb{F}},C_{pq}^{\mathbb{F}},Y_{pq}^{\mathbb{F}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS2.SSS4.p3.3" class="ltx_p">together with the maps <math id="S15.SS2.SSS4.p3.m7" class="ltx_Math" alttext="\pi_{0},\pi_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mn>0</mn></msub><mo>,</mo><msub><mi>π</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\pi_{0},\pi_{1}</annotation></semantics></math> is an object of <math id="S15.SS2.SSS4.p3.m8" class="ltx_Math" alttext="\underline{\smash{\bf Map}}^{\rm fr}" display="inline" intent=":literal"><semantics><msup><munder accentunder="true"><mi>𝐌𝐚𝐩</mi><mo stretchy="true">¯</mo></munder><mi>fr</mi></msup><annotation encoding="application/x-tex">\underline{\smash{\bf Map}}^{\rm fr}</annotation></semantics></math>.</p>
</div>
<div id="S15.SS2.SSS4.p4" class="ltx_para ltx_noindent">
<p id="S15.SS2.SSS4.p4.1" class="ltx_p">The cases of multimodules and homotopies are similar, using the modified energy from Section <a href="#S15.SS2.SSS3" title="15.2.3. Modification of energy density ‣ 15.2. Framed maps ‣ 15. Relatively Smooth AMS lifts ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15.2.3</span></a>. One obtains on the level of spaces</p>
<table id="S15.EGx54" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S15.Ex48"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S15.Ex48.m1" class="ltx_math_unparsed" alttext="\displaystyle\ Y_{p_{1}\cdots p_{m};p^{\prime}}^{{\mathbb{X}}},\ " display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ Y_{p_{1}\cdots p_{m};p^{\prime}}^{{\mathbb{X}}},\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S15.Ex48.m2" class="ltx_math_unparsed" alttext="\displaystyle\ Y_{p_{1}\cdots p_{m};p^{\prime}}^{{\mathbb{H}}}" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>ℍ</mi></msup></mrow><annotation encoding="application/x-tex">\displaystyle\ Y_{p_{1}\cdots p_{m};p^{\prime}}^{{\mathbb{H}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS2.SSS4.p4.2" class="ltx_p">as well as the corresponding objects in <math id="S15.SS2.SSS4.p4.m1" class="ltx_Math" alttext="\underline{\smash{\bf Map}}^{\rm fr}" display="inline" intent=":literal"><semantics><msup><munder accentunder="true"><mi>𝐌𝐚𝐩</mi><mo stretchy="true">¯</mo></munder><mi>fr</mi></msup><annotation encoding="application/x-tex">\underline{\smash{\bf Map}}^{\rm fr}</annotation></semantics></math>.</p>
</div>
</section>
<section id="S15.SS2.SSS5" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">15.2.5. </span>The structural maps</h5>

<div id="S15.SS2.SSS5.p1" class="ltx_para ltx_noindent">
<p id="S15.SS2.SSS5.p1.1" class="ltx_p">We would like to make the spaces of framed maps into flow categories, multimodules, and homotopies enriched in <math id="S15.SS2.SSS5.p1.m1" class="ltx_Math" alttext="\underline{\smash{\bf Map}}^{\rm fr}" display="inline" intent=":literal"><semantics><msup><munder accentunder="true"><mi>𝐌𝐚𝐩</mi><mo stretchy="true">¯</mo></munder><mi>fr</mi></msup><annotation encoding="application/x-tex">\underline{\smash{\bf Map}}^{\rm fr}</annotation></semantics></math>. We only describe the flow category case. Given <math id="S15.SS2.SSS5.p1.m2" class="ltx_Math" alttext="(\phi,u,F)\in Y_{pq}^{{\mathbb{F}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>F</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msubsup><mi>Y</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup></mrow><annotation encoding="application/x-tex">(\phi,u,F)\in Y_{pq}^{{\mathbb{F}}}</annotation></semantics></math> and <math id="S15.SS2.SSS5.p1.m3" class="ltx_Math" alttext="(\phi^{\prime},u^{\prime},F^{\prime})\in Y_{qr}^{{\mathbb{F}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msup><mi>ϕ</mi><mo>′</mo></msup><mo>,</mo><msup><mi>u</mi><mo>′</mo></msup><mo>,</mo><msup><mi>F</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>∈</mo><msubsup><mi>Y</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mi>𝔽</mi></msubsup></mrow><annotation encoding="application/x-tex">(\phi^{\prime},u^{\prime},F^{\prime})\in Y_{qr}^{{\mathbb{F}}}</annotation></semantics></math>, one has defined the composition</p>
<table id="S15.Ex49" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex49.m1" class="ltx_Math" alttext="\phi\#\phi^{\prime}:=\zeta_{prq}^{B}(\phi,\phi^{\prime})\in B_{d_{pq}+d_{qr}}=B_{pr}" display="block" intent=":literal"><semantics><mrow><mrow><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϕ</mi><mo>′</mo></msup></mrow><mo>:=</mo><mrow><msubsup><mi>ζ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>B</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo>,</mo><msup><mi>ϕ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msub><mi>B</mi><mrow><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>+</mo><msub><mi>d</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></mrow></msub><mo>=</mo><msub><mi>B</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\phi\#\phi^{\prime}:=\zeta_{prq}^{B}(\phi,\phi^{\prime})\in B_{d_{pq}+d_{qr}}=B_{pr}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS2.SSS5.p1.2" class="ltx_p">using the structural maps of the monotone flow category <math id="S15.SS2.SSS5.p1.m4" class="ltx_Math" alttext="\mathbb{Dom}^{k}" display="inline" intent=":literal"><semantics><mrow><mi>𝔻</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕠</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝕞</mi><mi>k</mi></msup></mrow><annotation encoding="application/x-tex">\mathbb{Dom}^{k}</annotation></semantics></math> with the corresponding curve <math id="S15.SS2.SSS5.p1.m5" class="ltx_Math" alttext="C_{\phi\#\phi^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mrow><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϕ</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">C_{\phi\#\phi^{\prime}}</annotation></semantics></math>. The maps <math id="S15.SS2.SSS5.p1.m6" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> and <math id="S15.SS2.SSS5.p1.m7" class="ltx_Math" alttext="u^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>u</mi><mo>′</mo></msup><annotation encoding="application/x-tex">u^{\prime}</annotation></semantics></math> obviously define a Floer admissible map</p>
<table id="S15.Ex50" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex50.m1" class="ltx_Math" alttext="u\#u^{\prime}:C_{\phi\#\phi^{\prime}}\to X." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mo>′</mo></msup></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>C</mi><mrow><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϕ</mi><mo>′</mo></msup></mrow></msub><mo stretchy="false">→</mo><mi>X</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">u\#u^{\prime}:C_{\phi\#\phi^{\prime}}\to X.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS2.SSS5.p1.3" class="ltx_p">Then for the two frames <math id="S15.SS2.SSS5.p1.m8" class="ltx_Math" alttext="F=(f_{0},\ldots,f_{d})" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F=(f_{0},\ldots,f_{d})</annotation></semantics></math> and <math id="S15.SS2.SSS5.p1.m9" class="ltx_Math" alttext="F^{\prime}=(f_{0}^{\prime},\ldots,f_{d^{\prime}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><msup><mi>F</mi><mo>′</mo></msup><mo>=</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>f</mi><mn>0</mn><mo>′</mo></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>f</mi><msup><mi>d</mi><mo>′</mo></msup><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F^{\prime}=(f_{0}^{\prime},\ldots,f_{d^{\prime}}^{\prime})</annotation></semantics></math>, we will define <math id="S15.SS2.SSS5.p1.m10" class="ltx_Math" alttext="F\#F^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>F</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">F\#F^{\prime}</annotation></semantics></math> consisting of holomorphic sections of <math id="S15.SS2.SSS5.p1.m11" class="ltx_Math" alttext="L_{u\#u^{\prime},H}\to C_{\phi\#\phi^{\prime}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mrow><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mo>′</mo></msup></mrow><mo>,</mo><mi>H</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi>C</mi><mrow><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϕ</mi><mo>′</mo></msup></mrow></msub></mrow><annotation encoding="application/x-tex">L_{u\#u^{\prime},H}\to C_{\phi\#\phi^{\prime}}</annotation></semantics></math>. We can extend <math id="S15.SS2.SSS5.p1.m12" class="ltx_Math" alttext="L_{u,H}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mrow><mi>u</mi><mo>,</mo><mi>H</mi></mrow></msub><annotation encoding="application/x-tex">L_{u,H}</annotation></semantics></math> resp. <math id="S15.SS2.SSS5.p1.m13" class="ltx_Math" alttext="L_{u^{\prime},H}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mrow><msup><mi>u</mi><mo>′</mo></msup><mo>,</mo><mi>H</mi></mrow></msub><annotation encoding="application/x-tex">L_{u^{\prime},H}</annotation></semantics></math> to the other component of <math id="S15.SS2.SSS5.p1.m14" class="ltx_Math" alttext="C_{\phi\#\phi^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mrow><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϕ</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">C_{\phi\#\phi^{\prime}}</annotation></semantics></math> by trivial bundle and denote the extension still by the same notation. Then one has the natural isomorphism</p>
<table id="S15.Ex51" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex51.m1" class="ltx_Math" alttext="L_{u\#u^{\prime},H}=L_{u,H}\otimes L_{u^{\prime},H}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>L</mi><mrow><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mo>′</mo></msup></mrow><mo>,</mo><mi>H</mi></mrow></msub><mo>=</mo><mrow><msub><mi>L</mi><mrow><mi>u</mi><mo>,</mo><mi>H</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>L</mi><mrow><msup><mi>u</mi><mo>′</mo></msup><mo>,</mo><mi>H</mi></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">L_{u\#u^{\prime},H}=L_{u,H}\otimes L_{u^{\prime},H}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS2.SSS5.p1.4" class="ltx_p">Let <math id="S15.SS2.SSS5.p1.m15" class="ltx_Math" alttext="\tau_{u}\in L_{u}|_{z_{+}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mi>u</mi></msub><mo>∈</mo><msub><mrow><msub><mi>L</mi><mi>u</mi></msub><mo stretchy="false">|</mo></mrow><msub><mi>z</mi><mo>+</mo></msub></msub></mrow><annotation encoding="application/x-tex">\tau_{u}\in L_{u}|_{z_{+}}</annotation></semantics></math> be the parallel transport of <math id="S15.SS2.SSS5.p1.m16" class="ltx_Math" alttext="f_{0}(z_{-})" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f_{0}(z_{-})</annotation></semantics></math> along the lateral line with respect to the connection on <math id="S15.SS2.SSS5.p1.m17" class="ltx_Math" alttext="L_{u}\to C_{\phi}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>u</mi></msub><mo stretchy="false">→</mo><msub><mi>C</mi><mi>ϕ</mi></msub></mrow><annotation encoding="application/x-tex">L_{u}\to C_{\phi}</annotation></semantics></math>. Then in the same way as we define the concatenating <math id="S15.SS2.SSS5.p1.m18" class="ltx_Math" alttext="\phi\#\phi^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϕ</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">\phi\#\phi^{\prime}</annotation></semantics></math>, consider the frame</p>
<table id="S15.Ex52" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex52.m1" class="ltx_Math" alttext="F\#F^{\prime}=\Big(f_{0}\otimes f_{0}^{\prime},\ldots,f_{d}\otimes f_{0}^{\prime},\tau_{u}\otimes f_{1}^{\prime},\ldots,\tau_{u}\otimes f_{d^{\prime}}^{\prime}\Big)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>F</mi><mo>′</mo></msup></mrow><mo>=</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msub><mi>f</mi><mn>0</mn></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi>f</mi><mn>0</mn><mo>′</mo></msubsup></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>f</mi><mi>d</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi>f</mi><mn>0</mn><mo>′</mo></msubsup></mrow><mo>,</mo><mrow><msub><mi>τ</mi><mi>u</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi>f</mi><mn>1</mn><mo>′</mo></msubsup></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>τ</mi><mi>u</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi>f</mi><msup><mi>d</mi><mo>′</mo></msup><mo>′</mo></msubsup></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">F\#F^{\prime}=\Big(f_{0}\otimes f_{0}^{\prime},\ldots,f_{d}\otimes f_{0}^{\prime},\tau_{u}\otimes f_{1}^{\prime},\ldots,\tau_{u}\otimes f_{d^{\prime}}^{\prime}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS2.SSS5.p1.5" class="ltx_p">Hence we have obtained a map</p>
<table id="S15.Ex53" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex53.m1" class="ltx_Math" alttext="\hat{\zeta}_{prq}:Y_{pr}^{\mathbb{F}}\times Y_{rq}^{\mathbb{F}}\to\partial^{prq}Y_{pq}^{\mathbb{F}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>ζ</mi><mo>^</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mi>Y</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mi>𝔽</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>Y</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup></mrow><mo rspace="0.111em" stretchy="false">→</mo><mrow><msup><mo>∂</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msup><msubsup><mi>Y</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\hat{\zeta}_{prq}:Y_{pr}^{\mathbb{F}}\times Y_{rq}^{\mathbb{F}}\to\partial^{prq}Y_{pq}^{\mathbb{F}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS2.SSS5.p1.6" class="ltx_p">We can also prove the associativity of the composition maps as the case of the monotone flow category <math id="S15.SS2.SSS5.p1.m19" class="ltx_Math" alttext="\mathbb{Dom}" display="inline" intent=":literal"><semantics><mrow><mi>𝔻</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕠</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕞</mi></mrow><annotation encoding="application/x-tex">\mathbb{Dom}</annotation></semantics></math>. Hence we obtained a flow category.</p>
</div>
<div id="S15.Thmthm8" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S15.Thmthm8.2" class="ltx_text ltx_font_bold">Proposition 15.8</span></span><span id="S15.Thmthm8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S15.Thmthm8.p1" class="ltx_para">
<ol id="S15.I8" class="ltx_enumerate">
<li id="S15.I8.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S15.I8.i1.p1" class="ltx_para ltx_noindent">
<p id="S15.I8.i1.p1.1" class="ltx_p"><span id="S15.I8.i1.p1.1.1" class="ltx_text ltx_font_italic">The spaces </span><math id="S15.I8.i1.p1.m1" class="ltx_Math" alttext="Y_{pq}^{\mathbb{F}}" display="inline" intent=":literal"><semantics><msubsup><mi>Y</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><annotation encoding="application/x-tex">Y_{pq}^{\mathbb{F}}</annotation></semantics></math><span id="S15.I8.i1.p1.1.2" class="ltx_text ltx_font_italic"> together with the composition maps form a flow category </span><math id="S15.I8.i1.p1.m2" class="ltx_Math" alttext="\mathbb{Map}_{\mathbb{F}}^{\mathbb{fr}}" display="inline" intent=":literal"><semantics><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕒</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝕡</mi><mi>𝔽</mi><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow></msubsup></mrow><annotation encoding="application/x-tex">\mathbb{Map}_{\mathbb{F}}^{\mathbb{fr}}</annotation></semantics></math><span id="S15.I8.i1.p1.1.3" class="ltx_text ltx_font_italic"> enriched in </span><math id="S15.I8.i1.p1.m3" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf Map}}^{\rm fr}_{\rm rig}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐌𝐚𝐩</mi><mo stretchy="true">¯</mo></munder><msup><mrow></mrow><mi>fr</mi></msup><msub><mrow></mrow><mi>rig</mi></msub></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf Map}}^{\rm fr}_{\rm rig}</annotation></semantics></math><span id="S15.I8.i1.p1.1.4" class="ltx_text ltx_font_italic"> which lifts the flow category </span><math id="S15.I8.i1.p1.m4" class="ltx_Math" alttext="\mathbb{Dom}^{\Omega,{\mathbb{F}}}" display="inline" intent=":literal"><semantics><mrow><mi>𝔻</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕠</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝕞</mi><mrow><mi mathvariant="normal">Ω</mi><mo>,</mo><mi>𝔽</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbb{Dom}^{\Omega,{\mathbb{F}}}</annotation></semantics></math><span id="S15.I8.i1.p1.1.5" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S15.I8.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S15.I8.i2.p1" class="ltx_para ltx_noindent">
<p id="S15.I8.i2.p1.1" class="ltx_p"><span id="S15.I8.i2.p1.1.1" class="ltx_text ltx_font_italic">The spaces </span><math id="S15.I8.i2.p1.m1" class="ltx_math_unparsed" alttext="Y_{p_{1}\cdots p_{m};p^{\prime}}^{{\mathbb{X}},{\rm fr}}" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mrow><mi>𝕏</mi><mo>,</mo><mi>fr</mi></mrow></msup></mrow><annotation encoding="application/x-tex">Y_{p_{1}\cdots p_{m};p^{\prime}}^{{\mathbb{X}},{\rm fr}}</annotation></semantics></math><span id="S15.I8.i2.p1.1.2" class="ltx_text ltx_font_italic"> together with the structural maps form a multimodule </span><math id="S15.I8.i2.p1.m2" class="ltx_Math" alttext="\mathbb{Map}_{\mathbb{X}}^{\mathbb{fr}}" display="inline" intent=":literal"><semantics><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕒</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝕡</mi><mi>𝕏</mi><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow></msubsup></mrow><annotation encoding="application/x-tex">\mathbb{Map}_{\mathbb{X}}^{\mathbb{fr}}</annotation></semantics></math><span id="S15.I8.i2.p1.1.3" class="ltx_text ltx_font_italic"> enriched in </span><math id="S15.I8.i2.p1.m3" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf Map}}^{\rm fr}_{\rm rig}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐌𝐚𝐩</mi><mo stretchy="true">¯</mo></munder><msup><mrow></mrow><mi>fr</mi></msup><msub><mrow></mrow><mi>rig</mi></msub></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf Map}}^{\rm fr}_{\rm rig}</annotation></semantics></math><span id="S15.I8.i2.p1.1.4" class="ltx_text ltx_font_italic"> over </span><math id="S15.I8.i2.p1.m4" class="ltx_Math" alttext="(\mathbb{Map}_{{\mathbb{F}}_{1}}^{\mathbb{fr}},\cdots,\mathbb{Map}_{{\mathbb{F}}_{m}}^{\mathbb{fr}};\mathbb{Map}_{{\mathbb{F}}^{\prime}}^{\mathbb{fr}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕒</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝕡</mi><msub><mi>𝔽</mi><mn>1</mn></msub><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow></msubsup></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕒</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝕡</mi><msub><mi>𝔽</mi><mi>m</mi></msub><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow></msubsup></mrow><mo>,</mo><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕒</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝕡</mi><msup><mi>𝔽</mi><mo>′</mo></msup><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbb{Map}_{{\mathbb{F}}_{1}}^{\mathbb{fr}},\cdots,\mathbb{Map}_{{\mathbb{F}}_{m}}^{\mathbb{fr}};\mathbb{Map}_{{\mathbb{F}}^{\prime}}^{\mathbb{fr}})</annotation></semantics></math><span id="S15.I8.i2.p1.1.5" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S15.I8.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S15.I8.i3.p1" class="ltx_para">
<p id="S15.I8.i3.p1.1" class="ltx_p"><span id="S15.I8.i3.p1.1.1" class="ltx_text ltx_font_italic">The spaces </span><math id="S15.I8.i3.p1.m1" class="ltx_math_unparsed" alttext="Y_{p_{1}\cdots p_{m};p^{\prime}}^{{\mathbb{H}},{\rm fr}}" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mrow><mi>ℍ</mi><mo>,</mo><mi>fr</mi></mrow></msup></mrow><annotation encoding="application/x-tex">Y_{p_{1}\cdots p_{m};p^{\prime}}^{{\mathbb{H}},{\rm fr}}</annotation></semantics></math><span id="S15.I8.i3.p1.1.2" class="ltx_text ltx_font_italic"> together with the structural maps form a homotopy </span><math id="S15.I8.i3.p1.m2" class="ltx_Math" alttext="\mathbb{Map}_{\mathbb{H}}^{\mathbb{fr}}" display="inline" intent=":literal"><semantics><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕒</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝕡</mi><mi>ℍ</mi><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow></msubsup></mrow><annotation encoding="application/x-tex">\mathbb{Map}_{\mathbb{H}}^{\mathbb{fr}}</annotation></semantics></math><span id="S15.I8.i3.p1.1.3" class="ltx_text ltx_font_italic"> enriched in </span><math id="S15.I8.i3.p1.m3" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf Map}}^{\rm fr}_{\rm rig}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐌𝐚𝐩</mi><mo stretchy="true">¯</mo></munder><msup><mrow></mrow><mi>fr</mi></msup><msub><mrow></mrow><mi>rig</mi></msub></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf Map}}^{\rm fr}_{\rm rig}</annotation></semantics></math><span id="S15.I8.i3.p1.1.4" class="ltx_text ltx_font_italic"> from </span><math id="S15.I8.i3.p1.m4" class="ltx_Math" alttext="\mathbb{Map}_{{\mathbb{X}}_{0}}^{\mathbb{fr}}" display="inline" intent=":literal"><semantics><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕒</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝕡</mi><msub><mi>𝕏</mi><mn>0</mn></msub><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow></msubsup></mrow><annotation encoding="application/x-tex">\mathbb{Map}_{{\mathbb{X}}_{0}}^{\mathbb{fr}}</annotation></semantics></math><span id="S15.I8.i3.p1.1.5" class="ltx_text ltx_font_italic"> to </span><math id="S15.I8.i3.p1.m5" class="ltx_Math" alttext="\mathbb{Map}_{\mathbb{X}_{1}}^{\mathbb{fr}}" display="inline" intent=":literal"><semantics><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕒</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝕡</mi><msub><mi>𝕏</mi><mn>1</mn></msub><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow></msubsup></mrow><annotation encoding="application/x-tex">\mathbb{Map}_{\mathbb{X}_{1}}^{\mathbb{fr}}</annotation></semantics></math><span id="S15.I8.i3.p1.1.6" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S15.SS2.SSS5.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S15.SS2.SSS5.p2" class="ltx_para">
<p id="S15.SS2.SSS5.p2.1" class="ltx_p"><span id="S15.SS2.SSS5.p2.1.1" class="ltx_text">We just need to point out that the difference between the image of <math id="S15.SS2.SSS5.p2.m1" class="ltx_Math" alttext="{\rm Map}_{pr}^{\rm fr}\times{\rm Map}_{rq}^{\rm fr}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Map</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mi>fr</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>Map</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>fr</mi></msubsup></mrow><annotation encoding="application/x-tex">{\rm Map}_{pr}^{\rm fr}\times{\rm Map}_{rq}^{\rm fr}</annotation></semantics></math> and the stratum <math id="S15.SS2.SSS5.p2.m2" class="ltx_Math" alttext="\partial^{prq}{\rm Map}_{pq}^{\rm fr}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msup><msubsup><mi>Map</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>fr</mi></msubsup></mrow><annotation encoding="application/x-tex">\partial^{prq}{\rm Map}_{pq}^{\rm fr}</annotation></semantics></math> lies in the difference of the domains. The concatenations of frame maps into <math id="S15.SS2.SSS5.p2.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> do not affect the rigidification.
∎</span></p>
</div>
</div>
</section>
<section id="S15.SS2.SSS6" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">15.2.6. </span>Group reductions</h5>

<div id="S15.SS2.SSS6.p1" class="ltx_para ltx_noindent">
<p id="S15.SS2.SSS6.p1.1" class="ltx_p">We have the following proposition showing the existence of compatible systems of group reductions.</p>
</div>
<div id="S15.Thmthm9" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S15.Thmthm9.2" class="ltx_text ltx_font_bold">Proposition 15.9</span></span><span id="S15.Thmthm9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S15.Thmthm9.p1" class="ltx_para ltx_noindent">
<p id="S15.Thmthm9.p1.1" class="ltx_p"><span id="S15.Thmthm9.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S15.Thmthm9.p1.m1" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math>, <math id="S15.Thmthm9.p1.m2" class="ltx_Math" alttext="{\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m},{\mathbb{F}}^{\prime},{\mathbb{X}},{\mathbb{X}}_{0},{\mathbb{X}}_{1},{\mathbb{H}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔽</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo>,</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo>,</mo><mi>𝕏</mi><mo>,</mo><msub><mi>𝕏</mi><mn>0</mn></msub><mo>,</mo><msub><mi>𝕏</mi><mn>1</mn></msub><mo>,</mo><mi>ℍ</mi></mrow><annotation encoding="application/x-tex">{\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m},{\mathbb{F}}^{\prime},{\mathbb{X}},{\mathbb{X}}_{0},{\mathbb{X}}_{1},{\mathbb{H}}</annotation></semantics></math> be as above. Let <math id="S15.Thmthm9.p1.m3" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Map}_{\mathbb{F}}^{\mathbb{fr}},\cdots,{}_{\lfloor}\mathbb{Map}_{{\mathbb{H}}}^{\mathbb{fr}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝕄</mi><mi>𝕒</mi><mi>𝕡</mi><msub><mrow></mrow><mi>𝔽</mi></msub><msup><mrow></mrow><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow></msup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝕄</mi><mi>𝕒</mi><mi>𝕡</mi><msub><mrow></mrow><mi>ℍ</mi></msub><msup><mrow></mrow><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Map}_{\mathbb{F}}^{\mathbb{fr}},\cdots,{}_{\lfloor}\mathbb{Map}_{{\mathbb{H}}}^{\mathbb{fr}}</annotation></semantics></math> be the corresponding flow categories, multimodules, and homotopy enriched in enriched in <math id="S15.Thmthm9.p1.m4" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf Map}}^{\rm fr}_{\rm rig}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐌𝐚𝐩</mi><mo stretchy="true">¯</mo></munder><msup><mrow></mrow><mi>fr</mi></msup><msub><mrow></mrow><mi>rig</mi></msub></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf Map}}^{\rm fr}_{\rm rig}</annotation></semantics></math>.</span></p>
<ol id="S15.I9" class="ltx_enumerate">
<li id="S15.I9.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S15.I9.i1.p1" class="ltx_para ltx_noindent">
<p id="S15.I9.i1.p1.1" class="ltx_p"><span id="S15.I9.i1.p1.1.1" class="ltx_text ltx_font_italic">There exists a lift of </span><math id="S15.I9.i1.p1.m1" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Map}_{\mathbb{F}}^{\mathbb{fr}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝕄</mi><mi>𝕒</mi><mi>𝕡</mi><msub><mrow></mrow><mi>𝔽</mi></msub><msup><mrow></mrow><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Map}_{\mathbb{F}}^{\mathbb{fr}}</annotation></semantics></math><span id="S15.I9.i1.p1.1.2" class="ltx_text ltx_font_italic"> to </span><math id="S15.I9.i1.p1.m2" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf map}}^{\rm fr}_{\rm rig}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐦𝐚𝐩</mi><mo stretchy="true">¯</mo></munder><msup><mrow></mrow><mi>fr</mi></msup><msub><mrow></mrow><mi>rig</mi></msub></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf map}}^{\rm fr}_{\rm rig}</annotation></semantics></math><span id="S15.I9.i1.p1.1.3" class="ltx_text ltx_font_italic">, denoted by </span><math id="S15.I9.i1.p1.m3" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{map}{}_{\mathbb{F}}^{\mathbb{fr}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝕞</mi><mi>𝕒</mi><mi>𝕡</mi><msub><mrow></mrow><mi>𝔽</mi></msub><msup><mrow></mrow><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{map}{}_{\mathbb{F}}^{\mathbb{fr}}</annotation></semantics></math><span id="S15.I9.i1.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S15.I9.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S15.I9.i2.p1" class="ltx_para ltx_noindent">
<p id="S15.I9.i2.p1.1" class="ltx_p"><span id="S15.I9.i2.p1.1.1" class="ltx_text ltx_font_italic">Given lifts </span><math id="S15.I9.i2.p1.m1" class="ltx_math_unparsed" alttext="{}_{\lfloor}{\mathbb{map}}{}_{{\mathbb{F}}_{1}}^{\mathbb{fr}},\cdots,{}_{\lfloor}{\mathbb{map}}{}_{\mathbb{F}_{m}}^{\mathbb{fr}},{}_{\lfloor}{\mathbb{map}}{}_{{\mathbb{F}}^{\prime}}^{\mathbb{fr}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝕞</mi><mi>𝕒</mi><mi>𝕡</mi><msub><mrow></mrow><msub><mi>𝔽</mi><mn>1</mn></msub></msub><msup><mrow></mrow><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow></msup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝕞</mi><mi>𝕒</mi><mi>𝕡</mi><msub><mrow></mrow><msub><mi>𝔽</mi><mi>m</mi></msub></msub><msup><mrow></mrow><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow></msup><mo>,</mo><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝕞</mi><mi>𝕒</mi><mi>𝕡</mi><msub><mrow></mrow><msup><mi>𝔽</mi><mo>′</mo></msup></msub><msup><mrow></mrow><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}{\mathbb{map}}{}_{{\mathbb{F}}_{1}}^{\mathbb{fr}},\cdots,{}_{\lfloor}{\mathbb{map}}{}_{\mathbb{F}_{m}}^{\mathbb{fr}},{}_{\lfloor}{\mathbb{map}}{}_{{\mathbb{F}}^{\prime}}^{\mathbb{fr}}</annotation></semantics></math><span id="S15.I9.i2.p1.1.2" class="ltx_text ltx_font_italic"> of </span><math id="S15.I9.i2.p1.m2" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Map}_{{\mathbb{F}}_{1}}^{\mathbb{fr}},\cdots,{}_{\lfloor}\mathbb{Map}_{{\mathbb{F}}_{m}}^{\mathbb{fr}},{}_{\lfloor}\mathbb{Map}_{\mathbb{F}^{\prime}}^{\mathbb{fr}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝕄</mi><mi>𝕒</mi><mi>𝕡</mi><msub><mrow></mrow><msub><mi>𝔽</mi><mn>1</mn></msub></msub><msup><mrow></mrow><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow></msup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝕄</mi><mi>𝕒</mi><mi>𝕡</mi><msub><mrow></mrow><msub><mi>𝔽</mi><mi>m</mi></msub></msub><msup><mrow></mrow><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow></msup><mo>,</mo><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝕄</mi><mi>𝕒</mi><mi>𝕡</mi><msub><mrow></mrow><msup><mi>𝔽</mi><mo>′</mo></msup></msub><msup><mrow></mrow><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Map}_{{\mathbb{F}}_{1}}^{\mathbb{fr}},\cdots,{}_{\lfloor}\mathbb{Map}_{{\mathbb{F}}_{m}}^{\mathbb{fr}},{}_{\lfloor}\mathbb{Map}_{\mathbb{F}^{\prime}}^{\mathbb{fr}}</annotation></semantics></math><span id="S15.I9.i2.p1.1.3" class="ltx_text ltx_font_italic"> respectively, there exists a lift of </span><math id="S15.I9.i2.p1.m3" class="ltx_math_unparsed" alttext="{}_{\lfloor}{\mathbb{Map}}_{\mathbb{X}}^{\mathbb{fr}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝕄</mi><mi>𝕒</mi><mi>𝕡</mi><msub><mrow></mrow><mi>𝕏</mi></msub><msup><mrow></mrow><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}{\mathbb{Map}}_{\mathbb{X}}^{\mathbb{fr}}</annotation></semantics></math><span id="S15.I9.i2.p1.1.4" class="ltx_text ltx_font_italic"> to </span><math id="S15.I9.i2.p1.m4" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf map}}^{\rm fr}_{\rm rig}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐦𝐚𝐩</mi><mo stretchy="true">¯</mo></munder><msup><mrow></mrow><mi>fr</mi></msup><msub><mrow></mrow><mi>rig</mi></msub></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf map}}^{\rm fr}_{\rm rig}</annotation></semantics></math><span id="S15.I9.i2.p1.1.5" class="ltx_text ltx_font_italic"> as a multimodule over </span><math id="S15.I9.i2.p1.m5" class="ltx_math_unparsed" alttext="({}_{\lfloor}{\mathbb{map}}{}_{{\mathbb{F}}_{1}}^{\mathbb{fr}},\cdots,{}_{\lfloor}{\mathbb{map}}{}_{\mathbb{F}_{m}}^{\mathbb{fr}};{}_{\lfloor}{\mathbb{map}}{}_{{\mathbb{F}}^{\prime}}^{\mathbb{fr}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝕞</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mi>𝕒</mi><mi>𝕡</mi><mmultiscripts><mo>,</mo><mrow></mrow><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow><mprescripts></mprescripts><msub><mi>𝔽</mi><mn>1</mn></msub><mrow></mrow></mmultiscripts><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mmultiscripts><mi>𝕞</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mi>𝕒</mi><mi>𝕡</mi><mmultiscripts><mo>;</mo><mrow></mrow><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow><mprescripts></mprescripts><msub><mi>𝔽</mi><mi>m</mi></msub><mrow></mrow></mmultiscripts><mmultiscripts><mi>𝕞</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mi>𝕒</mi><mi>𝕡</mi><mmultiscripts><mo stretchy="false">)</mo><mrow></mrow><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow><mprescripts></mprescripts><msup><mi>𝔽</mi><mo>′</mo></msup><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">({}_{\lfloor}{\mathbb{map}}{}_{{\mathbb{F}}_{1}}^{\mathbb{fr}},\cdots,{}_{\lfloor}{\mathbb{map}}{}_{\mathbb{F}_{m}}^{\mathbb{fr}};{}_{\lfloor}{\mathbb{map}}{}_{{\mathbb{F}}^{\prime}}^{\mathbb{fr}})</annotation></semantics></math><span id="S15.I9.i2.p1.1.6" class="ltx_text ltx_font_italic">, which is denoted by </span><math id="S15.I9.i2.p1.m6" class="ltx_math_unparsed" alttext="{}_{\lfloor}{\mathbb{map}}{}_{{\mathbb{X}}}^{\mathbb{fr}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝕞</mi><mi>𝕒</mi><mi>𝕡</mi><msub><mrow></mrow><mi>𝕏</mi></msub><msup><mrow></mrow><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}{\mathbb{map}}{}_{{\mathbb{X}}}^{\mathbb{fr}}</annotation></semantics></math><span id="S15.I9.i2.p1.1.7" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S15.I9.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S15.I9.i3.p1" class="ltx_para">
<p id="S15.I9.i3.p1.1" class="ltx_p"><span id="S15.I9.i3.p1.1.1" class="ltx_text ltx_font_italic">Given lifts </span><math id="S15.I9.i3.p1.m1" class="ltx_math_unparsed" alttext="{}_{\lfloor}{\mathbb{map}}{}_{{\mathbb{F}}_{1}}^{\mathbb{fr}},\cdots,{}_{\lfloor}{\mathbb{map}}{}_{\mathbb{F}_{m}}^{\mathbb{fr}},{}_{\lfloor}{\mathbb{map}}{}_{{\mathbb{F}}^{\prime}}^{\mathbb{fr}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝕞</mi><mi>𝕒</mi><mi>𝕡</mi><msub><mrow></mrow><msub><mi>𝔽</mi><mn>1</mn></msub></msub><msup><mrow></mrow><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow></msup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝕞</mi><mi>𝕒</mi><mi>𝕡</mi><msub><mrow></mrow><msub><mi>𝔽</mi><mi>m</mi></msub></msub><msup><mrow></mrow><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow></msup><mo>,</mo><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝕞</mi><mi>𝕒</mi><mi>𝕡</mi><msub><mrow></mrow><msup><mi>𝔽</mi><mo>′</mo></msup></msub><msup><mrow></mrow><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}{\mathbb{map}}{}_{{\mathbb{F}}_{1}}^{\mathbb{fr}},\cdots,{}_{\lfloor}{\mathbb{map}}{}_{\mathbb{F}_{m}}^{\mathbb{fr}},{}_{\lfloor}{\mathbb{map}}{}_{{\mathbb{F}}^{\prime}}^{\mathbb{fr}}</annotation></semantics></math><span id="S15.I9.i3.p1.1.2" class="ltx_text ltx_font_italic"> of </span><math id="S15.I9.i3.p1.m2" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Map}_{{\mathbb{F}}_{1}}^{\mathbb{fr}},\cdots,{}_{\lfloor}\mathbb{Map}_{{\mathbb{F}}_{m}}^{\mathbb{fr}},{}_{\lfloor}\mathbb{Map}_{\mathbb{F}^{\prime}}^{\mathbb{fr}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝕄</mi><mi>𝕒</mi><mi>𝕡</mi><msub><mrow></mrow><msub><mi>𝔽</mi><mn>1</mn></msub></msub><msup><mrow></mrow><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow></msup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝕄</mi><mi>𝕒</mi><mi>𝕡</mi><msub><mrow></mrow><msub><mi>𝔽</mi><mi>m</mi></msub></msub><msup><mrow></mrow><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow></msup><mo>,</mo><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝕄</mi><mi>𝕒</mi><mi>𝕡</mi><msub><mrow></mrow><msup><mi>𝔽</mi><mo>′</mo></msup></msub><msup><mrow></mrow><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Map}_{{\mathbb{F}}_{1}}^{\mathbb{fr}},\cdots,{}_{\lfloor}\mathbb{Map}_{{\mathbb{F}}_{m}}^{\mathbb{fr}},{}_{\lfloor}\mathbb{Map}_{\mathbb{F}^{\prime}}^{\mathbb{fr}}</annotation></semantics></math><span id="S15.I9.i3.p1.1.3" class="ltx_text ltx_font_italic"> to </span><math id="S15.I9.i3.p1.m3" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf map}}^{\rm fr}_{\rm rig}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐦𝐚𝐩</mi><mo stretchy="true">¯</mo></munder><msup><mrow></mrow><mi>fr</mi></msup><msub><mrow></mrow><mi>rig</mi></msub></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf map}}^{\rm fr}_{\rm rig}</annotation></semantics></math><span id="S15.I9.i3.p1.1.4" class="ltx_text ltx_font_italic"> and lifts </span><math id="S15.I9.i3.p1.m4" class="ltx_math_unparsed" alttext="{}_{\lfloor}{\mathbb{map}}{}_{{\mathbb{X}}_{0}}^{\mathbb{fr}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝕞</mi><mi>𝕒</mi><mi>𝕡</mi><msub><mrow></mrow><msub><mi>𝕏</mi><mn>0</mn></msub></msub><msup><mrow></mrow><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}{\mathbb{map}}{}_{{\mathbb{X}}_{0}}^{\mathbb{fr}}</annotation></semantics></math><span id="S15.I9.i3.p1.1.5" class="ltx_text ltx_font_italic">, </span><math id="S15.I9.i3.p1.m5" class="ltx_math_unparsed" alttext="{}_{\lfloor}{\mathbb{map}}{}_{{\mathbb{X}}_{1}}^{\mathbb{fr}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝕞</mi><mi>𝕒</mi><mi>𝕡</mi><msub><mrow></mrow><msub><mi>𝕏</mi><mn>1</mn></msub></msub><msup><mrow></mrow><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}{\mathbb{map}}{}_{{\mathbb{X}}_{1}}^{\mathbb{fr}}</annotation></semantics></math><span id="S15.I9.i3.p1.1.6" class="ltx_text ltx_font_italic"> of </span><math id="S15.I9.i3.p1.m6" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Map}_{\mathbb{X}_{0}}^{\mathbb{fr}},{}_{\lfloor}\mathbb{Map}{}_{{\mathbb{X}}_{1}}^{\mathbb{fr}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝕄</mi><mi>𝕒</mi><mi>𝕡</mi><msub><mrow></mrow><msub><mi>𝕏</mi><mn>0</mn></msub></msub><msup><mrow></mrow><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow></msup><mo>,</mo><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝕄</mi><mi>𝕒</mi><mi>𝕡</mi><msub><mrow></mrow><msub><mi>𝕏</mi><mn>1</mn></msub></msub><msup><mrow></mrow><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Map}_{\mathbb{X}_{0}}^{\mathbb{fr}},{}_{\lfloor}\mathbb{Map}{}_{{\mathbb{X}}_{1}}^{\mathbb{fr}}</annotation></semantics></math><span id="S15.I9.i3.p1.1.7" class="ltx_text ltx_font_italic"> respectively, as multimodules over the tuple </span><math id="S15.I9.i3.p1.m7" class="ltx_math_unparsed" alttext="({}_{\lfloor}{\mathbb{map}}{}_{{\mathbb{F}}_{1}}^{\mathbb{fr}},\cdots,{}_{\lfloor}{\mathbb{map}}{}_{\mathbb{F}_{m}}^{\mathbb{fr}};{}_{\lfloor}{\mathbb{map}}{}_{{\mathbb{F}}^{\prime}}^{\mathbb{fr}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝕞</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mi>𝕒</mi><mi>𝕡</mi><mmultiscripts><mo>,</mo><mrow></mrow><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow><mprescripts></mprescripts><msub><mi>𝔽</mi><mn>1</mn></msub><mrow></mrow></mmultiscripts><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mmultiscripts><mi>𝕞</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mi>𝕒</mi><mi>𝕡</mi><mmultiscripts><mo>;</mo><mrow></mrow><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow><mprescripts></mprescripts><msub><mi>𝔽</mi><mi>m</mi></msub><mrow></mrow></mmultiscripts><mmultiscripts><mi>𝕞</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mi>𝕒</mi><mi>𝕡</mi><mmultiscripts><mo stretchy="false">)</mo><mrow></mrow><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow><mprescripts></mprescripts><msup><mi>𝔽</mi><mo>′</mo></msup><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">({}_{\lfloor}{\mathbb{map}}{}_{{\mathbb{F}}_{1}}^{\mathbb{fr}},\cdots,{}_{\lfloor}{\mathbb{map}}{}_{\mathbb{F}_{m}}^{\mathbb{fr}};{}_{\lfloor}{\mathbb{map}}{}_{{\mathbb{F}}^{\prime}}^{\mathbb{fr}})</annotation></semantics></math><span id="S15.I9.i3.p1.1.8" class="ltx_text ltx_font_italic">, there exists a lift of </span><math id="S15.I9.i3.p1.m8" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Map}{}_{{\mathbb{H}}}^{\mathbb{fr}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝕄</mi><mi>𝕒</mi><mi>𝕡</mi><msub><mrow></mrow><mi>ℍ</mi></msub><msup><mrow></mrow><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Map}{}_{{\mathbb{H}}}^{\mathbb{fr}}</annotation></semantics></math><span id="S15.I9.i3.p1.1.9" class="ltx_text ltx_font_italic"> to </span><math id="S15.I9.i3.p1.m9" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf map}}^{\rm fr}_{\rm rig}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐦𝐚𝐩</mi><mo stretchy="true">¯</mo></munder><msup><mrow></mrow><mi>fr</mi></msup><msub><mrow></mrow><mi>rig</mi></msub></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf map}}^{\rm fr}_{\rm rig}</annotation></semantics></math><span id="S15.I9.i3.p1.1.10" class="ltx_text ltx_font_italic"> as a homotopy from </span><math id="S15.I9.i3.p1.m10" class="ltx_math_unparsed" alttext="{}_{\lfloor}{\mathbb{map}}{}_{{\mathbb{X}}_{0}}^{\mathbb{fr}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝕞</mi><mi>𝕒</mi><mi>𝕡</mi><msub><mrow></mrow><msub><mi>𝕏</mi><mn>0</mn></msub></msub><msup><mrow></mrow><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}{\mathbb{map}}{}_{{\mathbb{X}}_{0}}^{\mathbb{fr}}</annotation></semantics></math><span id="S15.I9.i3.p1.1.11" class="ltx_text ltx_font_italic"> to </span><math id="S15.I9.i3.p1.m11" class="ltx_math_unparsed" alttext="{}_{\lfloor}{\mathbb{map}}{}_{{\mathbb{X}}_{1}}^{\mathbb{fr}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝕞</mi><mi>𝕒</mi><mi>𝕡</mi><msub><mrow></mrow><msub><mi>𝕏</mi><mn>1</mn></msub></msub><msup><mrow></mrow><mrow><mi>𝕗</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕣</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}{\mathbb{map}}{}_{{\mathbb{X}}_{1}}^{\mathbb{fr}}</annotation></semantics></math><span id="S15.I9.i3.p1.1.12" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S15.SS2.SSS6.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S15.SS2.SSS6.p2" class="ltx_para ltx_noindent">
<p id="S15.SS2.SSS6.p2.1" class="ltx_p"><span id="S15.SS2.SSS6.p2.1.1" class="ltx_text">We prove by induction. The construction of the base situation was provided in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib61" title="" class="ltx_ref">3</a>]</cite>, whose construction is recalled as follows. Given <math id="S15.SS2.SSS6.p2.m1" class="ltx_Math" alttext="p,q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p,q</annotation></semantics></math> and a framed map <math id="S15.SS2.SSS6.p2.m2" class="ltx_Math" alttext="(\phi,u,F)\in{\rm Map}_{pq}^{\mathbb{F},{\rm fr}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>F</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msubsup><mi>Map</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mi>𝔽</mi><mo>,</mo><mi>fr</mi></mrow></msubsup></mrow><annotation encoding="application/x-tex">(\phi,u,F)\in{\rm Map}_{pq}^{\mathbb{F},{\rm fr}}</annotation></semantics></math>, consider the <math id="S15.SS2.SSS6.p2.m3" class="ltx_Math" alttext="(d_{pq}+1)\times(d_{pq}+1)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(d_{pq}+1)\times(d_{pq}+1)</annotation></semantics></math> positive-definite Hermitian matrix</span></p>
<table id="S15.E6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.E6.m1" class="ltx_Math" alttext="(H_{F})_{ab}=\int_{C_{\phi}}\langle f_{a},f_{b}\rangle\Omega_{u}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mi>F</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msub><mo rspace="0.111em">=</mo><mrow><msub><mo rspace="0em">∫</mo><msub><mi>C</mi><mi>ϕ</mi></msub></msub><mrow><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>f</mi><mi>a</mi></msub><mo>,</mo><msub><mi>f</mi><mi>b</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Ω</mi><mi>u</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(H_{F})_{ab}=\int_{C_{\phi}}\langle f_{a},f_{b}\rangle\Omega_{u}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15.6)</span></td></tr></tbody>
</table>
<p id="S15.SS2.SSS6.p2.2" class="ltx_p"><span id="S15.SS2.SSS6.p2.2.1" class="ltx_text">As frames are well-defined up to <math id="S15.SS2.SSS6.p2.m4" class="ltx_Math" alttext="{\mathbb{C}}^{*}" display="inline" intent=":literal"><semantics><msup><mi>ℂ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">{\mathbb{C}}^{*}</annotation></semantics></math>-rescaling, this Hermitian matrix is well-defined up to positive rescaling, hence defines a map</span></p>
<table id="S15.Ex54" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex54.m1" class="ltx_Math" alttext="\Lambda_{pq}^{\mathbb{F}}:Y_{pq}^{{\mathbb{F}}}\to{\mathcal{G}}_{pq}/G_{pq}=P_{pq}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi mathvariant="normal">Λ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>Y</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><mo stretchy="false">→</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>/</mo><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo>=</mo><msub><mi>P</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Lambda_{pq}^{\mathbb{F}}:Y_{pq}^{{\mathbb{F}}}\to{\mathcal{G}}_{pq}/G_{pq}=P_{pq}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS2.SSS6.p2.3" class="ltx_p"><span id="S15.SS2.SSS6.p2.3.1" class="ltx_text">This map is obviously equivariant with respect to the <math id="S15.SS2.SSS6.p2.m5" class="ltx_Math" alttext="{\mathcal{G}}_{R}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>R</mi></msub><annotation encoding="application/x-tex">{\mathcal{G}}_{R}</annotation></semantics></math>-action; moreover, as <math id="S15.SS2.SSS6.p2.m6" class="ltx_Math" alttext="{\mathcal{G}}_{L}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>L</mi></msub><annotation encoding="application/x-tex">{\mathcal{G}}_{L}</annotation></semantics></math> acts by reparametrizing the map and pulling back the framings, <math id="S15.SS2.SSS6.p2.m7" class="ltx_Math" alttext="\Lambda_{pq}^{\mathbb{F}}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><annotation encoding="application/x-tex">\Lambda_{pq}^{\mathbb{F}}</annotation></semantics></math> is <math id="S15.SS2.SSS6.p2.m8" class="ltx_Math" alttext="{\mathcal{G}}_{L}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>L</mi></msub><annotation encoding="application/x-tex">{\mathcal{G}}_{L}</annotation></semantics></math>-invariant. Therefore, one obtains a group reduction on <math id="S15.SS2.SSS6.p2.m9" class="ltx_Math" alttext="Y_{pq}^{\mathbb{F}}" display="inline" intent=":literal"><semantics><msubsup><mi>Y</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><annotation encoding="application/x-tex">Y_{pq}^{\mathbb{F}}</annotation></semantics></math>.</span></p>
</div>
<div id="S15.SS2.SSS6.p3" class="ltx_para ltx_noindent">
<p id="S15.SS2.SSS6.p3.1" class="ltx_p"><span id="S15.SS2.SSS6.p3.1.1" class="ltx_text">If <math id="S15.SS2.SSS6.p3.m1" class="ltx_Math" alttext="Y_{pq}^{\mathbb{F}}" display="inline" intent=":literal"><semantics><msubsup><mi>Y</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><annotation encoding="application/x-tex">Y_{pq}^{\mathbb{F}}</annotation></semantics></math> has no lower stratum, then its outercollaring is itself and hence one obtains the base case of the induction. Suppose inductively, one has constructed compatible collared group reductions</span></p>
<table id="S15.Ex55" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex55.m1" class="ltx_math_unparsed" alttext="\Lambda_{rs}^{\mathbb{F}}:{}_{\lfloor}Y_{rs}^{\mathbb{F}}\to P_{rs}" display="block" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><msub><mrow></mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><msup><mrow></mrow><mi>𝔽</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>Y</mi><msub><mrow></mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><msup><mrow></mrow><mi>𝔽</mi></msup><mo stretchy="false">→</mo><mi>P</mi><msub><mrow></mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\Lambda_{rs}^{\mathbb{F}}:{}_{\lfloor}Y_{rs}^{\mathbb{F}}\to P_{rs}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS2.SSS6.p3.2" class="ltx_p"><span id="S15.SS2.SSS6.p3.2.1" class="ltx_text">for all pairs <math id="S15.SS2.SSS6.p3.m2" class="ltx_Math" alttext="r,s" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>,</mo><mi>s</mi></mrow><annotation encoding="application/x-tex">r,s</annotation></semantics></math> satisfying <math id="S15.SS2.SSS6.p3.m3" class="ltx_Math" alttext="{\mathcal{A}}(r)-{\mathcal{A}}(s)&lt;{\mathcal{A}}(p)-{\mathcal{A}}(q)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&lt;</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{A}}(r)-{\mathcal{A}}(s)&lt;{\mathcal{A}}(p)-{\mathcal{A}}(q)</annotation></semantics></math>. Notice that for each triple <math id="S15.SS2.SSS6.p3.m4" class="ltx_Math" alttext="p&lt;r&lt;q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mi>r</mi><mo>&lt;</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p&lt;r&lt;q</annotation></semantics></math>, one has a strict embedding</span></p>
<table id="S15.Ex56" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S15.Ex56.m1" class="ltx_math_unparsed" alttext="{}_{\lfloor}Y_{pr}^{\mathbb{F}}\times{}_{\lfloor}Y_{rq}^{\mathbb{F}}\to\partial^{prq}{}_{\lfloor}Y_{pq}^{\mathbb{F}}" display="block" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>Y</mi><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><msup><mrow></mrow><mi>𝔽</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>Y</mi><msub><mrow></mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><msup><mrow></mrow><mi>𝔽</mi></msup><mo rspace="0.111em" stretchy="false">→</mo><mo>∂</mo><msup><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msup><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>Y</mi><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><msup><mrow></mrow><mi>𝔽</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}Y_{pr}^{\mathbb{F}}\times{}_{\lfloor}Y_{rq}^{\mathbb{F}}\to\partial^{prq}{}_{\lfloor}Y_{pq}^{\mathbb{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S15.SS2.SSS6.p3.3" class="ltx_p"><span id="S15.SS2.SSS6.p3.3.1" class="ltx_text">which is equivariant with respect to the complex group embedding <math id="S15.SS2.SSS6.p3.m5" class="ltx_Math" alttext="\hat{\mathcal{G}}_{pr}\times\hat{\mathcal{G}}_{rq}\to\hat{\mathcal{G}}_{pq}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>^</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>^</mo></mover><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo stretchy="false">→</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>^</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\hat{\mathcal{G}}_{pr}\times\hat{\mathcal{G}}_{rq}\to\hat{\mathcal{G}}_{pq}</annotation></semantics></math>. Hence one obtains an extension</span></p>
<table id="S15.Ex57" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
