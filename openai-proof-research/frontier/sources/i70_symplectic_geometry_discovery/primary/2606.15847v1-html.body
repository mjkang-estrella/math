\cong\widetilde{I}_{p_{j}q_{j}}|_{\partial^{-}\widetilde{V}_{p_{j}q_{j}}}\oplus\widetilde{I}_{p_{1}\cdots p_{j-1}q_{j}p_{j+1}\cdots p_{m};p^{\prime}}|_{\partial^{-}\widetilde{V}_{p_{1}\cdots p_{j-1}q_{j}p_{j+1}\cdots p_{m};p^{\prime}}},</annotation></semantics></math></td>
