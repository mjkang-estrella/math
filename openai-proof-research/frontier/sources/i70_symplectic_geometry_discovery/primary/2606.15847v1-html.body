<p id="S6.I4.i2.I1.i4.p1.1" class="ltx_p">For <math id="S6.I4.i2.I1.i4.p1.m1" class="ltx_Math" alttext="p_{i}&lt;q_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>i</mi></msub><mo>&lt;</mo><msub><mi>q</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">p_{i}&lt;q_{i}</annotation></semantics></math> in <math id="S6.I4.i2.I1.i4.p1.m2" class="ltx_Math" alttext="{\mathbb{F}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝔽</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\mathbb{F}}_{i}</annotation></semantics></math> and <math id="S6.I4.i2.I1.i4.p1.m3" class="ltx_Math" alttext="q^{\prime}&lt;p^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mo>′</mo></msup><mo>&lt;</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">q^{\prime}&lt;p^{\prime}</annotation></semantics></math> in <math id="S6.I4.i2.I1.i4.p1.m4" class="ltx_Math" alttext="{\mathbb{F}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝔽</mi><mo>′</mo></msup><annotation encoding="application/x-tex">{\mathbb{F}}^{\prime}</annotation></semantics></math>, the following diagram commutes.</p>
<table id="S6.E6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center">
<span id="S6.E6.2" class="ltx_inline-block ltx_markedasmath ltx_align_bottom"><span class="ltx_inline-block"><svg id="S6.E6.m1.pic1" class="ltx_picture" height="73.37" overflow="visible" style="vertical-align:-59.64146950968374px" version="1.1" viewBox="111.97 59.64 416.21 73.37" width="416.21"><g transform="matrix(1 0 0 -1 111.96959376648549 73.37402073496091) translate(111.97,0)"><g transform="translate(-111.97,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:15.58em;--ltx-fo-height:0.94em;--ltx-fo-depth:0.42em;font-size:10pt;" height="18.83" overflow="visible" transform="matrix(1 0 0 -1 0 13.04)" width="215.64"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.E6.m1.pic1.m1" class="ltx_math_unparsed" alttext="\textstyle{M_{p_{i}q_{i}}^{{\mathbb{F}}_{i}}\times M_{p_{1}\cdots p_{i-1}q_{i}p_{i+1}\cdots p_{m};q^{\prime}}^{{\mathbb{X}}}\times M_{q^{\prime}p^{\prime}}^{{\mathbb{F}}^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><msub><mi>p</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>i</mi></msub></mrow></msub><msup><mrow></mrow><msub><mi>𝔽</mi><mi>i</mi></msub></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mi>q</mi><msub><mrow></mrow><mi>i</mi></msub><mi>p</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi><msub><mrow></mrow><mrow><msup><mi>q</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><msup><mi>𝔽</mi><mo>′</mo></msup></msup></mrow><annotation encoding="application/x-tex">\textstyle{M_{p_{i}q_{i}}^{{\mathbb{F}}_{i}}\times M_{p_{1}\cdots p_{i-1}q_{i}p_{i+1}\cdots p_{m};q^{\prime}}^{{\mathbb{X}}}\times M_{q^{\prime}p^{\prime}}^{{\mathbb{F}}^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 111.96959376648549 -0.27673578005007266 L 111.96959376648549 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(186.69,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 111.96959376648549 -0.27673578005007266 L 186.6893945136835 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 186.6893945136835 -0.27673578005007266 L 186.6893945136835 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -13.400455621065102 L 0.27673578005007266 -13.400455621065102" fill="none" stroke="#000000"></path><g transform="translate(0,-33.91)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.909116887247905 L 0.27673578005007266 -13.400455621065102" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.909116887247905 L 0.27673578005007266 -33.909116887247905" fill="none" stroke="#000000"></path><g transform="translate(186.69,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:7.9em;--ltx-fo-height:0.94em;--ltx-fo-depth:0.38em;font-size:10pt;" height="18.23" overflow="visible" transform="matrix(1 0 0 -1 0 13.04)" width="109.25"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.E6.m1.pic1.m3" class="ltx_math_unparsed" alttext="\textstyle{M_{p_{1}\cdots p_{m};q^{\prime}}^{{\mathbb{X}}}\times M_{q^{\prime}p^{\prime}}^{{\mathbb{F}}^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi><msub><mrow></mrow><mrow><msup><mi>q</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><msup><mi>𝔽</mi><mo>′</mo></msup></msup></mrow><annotation encoding="application/x-tex">\textstyle{M_{p_{1}\cdots p_{m};q^{\prime}}^{{\mathbb{X}}}\times M_{q^{\prime}p^{\prime}}^{{\mathbb{F}}^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 245.1884289640303 -12.80080864699002 L 245.74190052413044 -12.80080864699002" fill="none" stroke="#000000"></path><g transform="translate(245.47,0) translate(0,-33.91)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 245.1884289640303 -33.909116887247905 L 245.74190052413044 -12.80080864699002" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 245.1884289640303 -33.909116887247905 L 245.74190052413044 -33.909116887247905" fill="none" stroke="#000000"></path><g transform="translate(-88.08,0) translate(0,-46.24) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:12.13em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.42em;font-size:10pt;" height="17.43" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="167.85"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.E6.m1.pic1.m4" class="ltx_math_unparsed" alttext="\textstyle{M_{p_{i}q_{i}}^{{\mathbb{F}}_{i}}\times M_{p_{1}\cdots p_{i-1}q_{i}p_{i+1}\cdots p_{m};p^{\prime}}^{{\mathbb{X}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><msub><mi>p</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>i</mi></msub></mrow></msub><msup><mrow></mrow><msub><mi>𝔽</mi><mi>i</mi></msub></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mi>q</mi><msub><mrow></mrow><mi>i</mi></msub><mi>p</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup></mrow><annotation encoding="application/x-tex">\textstyle{M_{p_{i}q_{i}}^{{\mathbb{F}}_{i}}\times M_{p_{1}\cdots p_{i-1}q_{i}p_{i+1}\cdots p_{m};p^{\prime}}^{{\mathbb{X}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 88.07720576511043 -46.517749668668706 L 88.07720576511043 -45.964278108568564" fill="none" stroke="#000000"></path><g transform="translate(210.58,0) translate(0,-46.24)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 88.07720576511043 -46.517749668668706 L 210.58178251505853 -45.964278108568564" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 210.58178251505853 -46.517749668668706 L 210.58178251505853 -45.964278108568564" fill="none" stroke="#000000"></path><g transform="translate(210.58,0) translate(0,-46.24) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:4.44em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.38em;font-size:10pt;" height="16.83" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="61.47"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.E6.m1.pic1.m6" class="ltx_math_unparsed" alttext="\textstyle{M_{p_{1}\cdots p_{m};p^{\prime}}^{{\mathbb{X}}}}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup></mrow><annotation encoding="application/x-tex">\textstyle{M_{p_{1}\cdots p_{m};p^{\prime}}^{{\mathbb{X}}}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span>
</span></td>
