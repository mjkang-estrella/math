ranslate(0,-142.56) translate(4.15,0) translate(0,-5)"><foreignObject style="--ltx-fo-width:1.51em;--ltx-fo-height:0.72em;--ltx-fo-depth:0em;font-size:10pt;" height="9.99" overflow="visible" transform="matrix(1 0 0 -1 0 9.99)" width="20.83"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S12.E1.m1.pic1.m35" class="ltx_Math" alttext="\scriptstyle{\tilde{\mathbb{\Delta}}^{\mathbb{PP}}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi class="ltx_mathvariant_double-struck" mathsize="0.700em" mathvariant="double-struck">Δ</mi><mo>~</mo></mover><mrow><mi mathsize="0.710em">ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">ℙ</mi></mrow></msup><annotation encoding="application/x-tex">\scriptstyle{\tilde{\mathbb{\Delta}}^{\mathbb{PP}}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(284.27,0) translate(0,-115.25)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 6.46 -3.72" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 7.24 1.76" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 276.2787975809032 -114.73182096543344 C 276.2787975809032 -164.54502146356546 326.0919980790352 -114.73182096543344 276.2787975809032 -114.73182096543344" fill="none" stroke="#000000"></path><g transform="translate(123.69,0) translate(0,-135.5) translate(4.15,0) translate(0,-5)"><foreignObject style="--ltx-fo-width:1.49em;--ltx-fo-height:0.72em;--ltx-fo-depth:0em;font-size:10pt;" height="9.99" overflow="visible" transform="matrix(1 0 0 -1 0 9.99)" width="20.59"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S12.E1.m1.pic1.m36" class="ltx_Math" alttext="\scriptstyle{\tilde{\mathbb{B}}^{\mathbb{PF}}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi mathsize="0.700em">𝔹</mi><mo>~</mo></mover><mrow><mi mathsize="0.710em">ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\scriptstyle{\tilde{\mathbb{B}}^{\mathbb{PF}}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(7.99,0) translate(0,-116.04)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 6.4 -3.81" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 7.26 1.66" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 276.2787975809032 -114.73182096543344 C 184.18587209179768 -130.22917244334397 92.09292548910553 -130.22917244334397 0 -114.73182096543344" fill="none" stroke="#000000"></path><g transform="translate(171.3,0) translate(0,-75.46) translate(4.15,0) translate(0,-5)"><foreignObject style="--ltx-fo-width:1.65em;--ltx-fo-height:0.72em;--ltx-fo-depth:0em;font-size:10pt;" height="9.99" overflow="visible" transform="matrix(1 0 0 -1 0 9.99)" width="22.83"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S12.E1.m1.pic1.m37" class="ltx_Math" alttext="\scriptstyle{\tilde{\mathbb{B}}^{\mathbb{PM}}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi mathsize="0.700em">𝔹</mi><mo>~</mo></mover><mrow><mi mathsize="0.710em">ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">𝕄</mi></mrow></msup><annotation encoding="application/x-tex">\scriptstyle{\tilde{\mathbb{B}}^{\mathbb{PM}}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(150.95,0) translate(0,-16.76)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.23 -7.11" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 6.52 -3.61" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 276.2787975809032 -114.73182096543344 C 220.33414818265055 -88.41236283938485 174.2876748813045 -50.1684154797115 138.1393987904516 0" fill="none" stroke="#000000"></path></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="0" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(12.1)</span></td></tr></tbody>
</table>
<p id="Thmthma20.p1.3" class="ltx_p"><span id="Thmthma20.p1.3.1" class="ltx_text ltx_font_italic">All triangles are commutative up to homotopy of bimodules enriched in <math id="Thmthma20.p1.m2" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>NC</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}</annotation></semantics></math>, except for triangles whose vertex of concatenation is <math id="Thmthma20.p1.m3" class="ltx_math_unparsed" alttext="{}_{\lfloor}{\mathbb{M}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝕄</mi></mrow><annotation encoding="application/x-tex">{}_{\lfloor}{\mathbb{M}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S12.SS3.SSS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S12.SS3.SSS2.p2" class="ltx_para">
<p id="S12.SS3.SSS2.p2.1" class="ltx_p"><span id="S12.SS3.SSS2.p2.1.1" class="ltx_text">See Section <a href="#S21.SS6" title="21.6. Proof of Theorem ‣ 21. AMS Construction for Other Flow categories, Multimodules, and Homotopies ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21.6</span></a>.
∎</span></p>
</div>
</div>
<div id="S12.Thmthm8" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S12.Thmthm8.2" class="ltx_text ltx_font_italic">Remark 12.8</span></span><span id="S12.Thmthm8.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S12.Thmthm8.p1" class="ltx_para">
<p id="S12.Thmthm8.p1.1" class="ltx_p">As discussed in Section <a href="#S11.SS3.SSS3" title="11.3.3. Remarks on concatenation at the Morse flow category ‣ 11.3. Homotopies associated to PSS type moduli spaces ‣ 11. Homotopies of Multimodules ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11.3.3</span></a>, the regularization of homotopies related to gluing Morse trajectories does not fit well with the current framework.</p>
</div>
</div>
</section>
</section>
</section>
<section id="S13" class="ltx_section">
<h3 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">13. </span>Proof of the Main Theorems</h3>

<div id="S13.p1" class="ltx_para ltx_noindent">
<p id="S13.p1.1" class="ltx_p">In this section we prove (most of) the main theorems using previously stated theorems on Kuranishi lifts of various flow categories, bimodules, homotopies and the theorem on FOP perturbations (Theorem <a href="#Thmthma14" title="Theorem N. ‣ 8.2. FOP perturbations on flow categories, multimodules, and homotopies ‣ 8. FOP Perturbations ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">N</span></a>). The proofs are mostly formal consequences of the existence of the regularizations and coherent FOP perturbations thereon, following the general theme of Floer theory which turns bordifications of moduli spaces into algebraic structures.</p>
</div>
<section id="S13.SS1" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">13.1. </span>Proof of Theorem <a href="#Thmthma1" title="Theorem A (Floer chain complex). ‣ 1.1.1. Floer complexes and Floer homology ‣ 1.1. Main results on Floer complexes ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A</span></a></h4>

<div id="S13.SS1.p1" class="ltx_para ltx_noindent">
<p id="S13.SS1.p1.1" class="ltx_p">Suppose we are in Situation <a href="#Thmsituationf1" title="Situation Flow(i). ‣ 9.2. Floer flow category ‣ 9. Geometric Flow Categories ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Flow(i)</span></a>. Theorem <a href="#Thmthma15" title="Theorem O. ‣ 12.1. Main statements for Floer flow categories ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">O</span></a> provides, depending on a choice, an AMS lift <math id="S13.SS1.p1.m1" class="ltx_Math" alttext="\tilde{\mathbb{F}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{F}}</annotation></semantics></math> enriched in <math id="S13.SS1.p1.m2" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf dOrb}}^{{\rm NC}}_{\rm rig}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><msup><mrow></mrow><mi>NC</mi></msup><msub><mrow></mrow><mi>rig</mi></msub></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf dOrb}}^{{\rm NC}}_{\rm rig}</annotation></semantics></math> together with a coherent orientation. As the Floer flow category is an unobstructed (Definition <a href="#S7.Thmthm1" title="Definition 7.1. ‣ 7.1.1. Unobstructedness ‣ 7.1. Unobstructedness, local finiteness, grading, and orientations ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.1</span></a>) and <math id="S13.SS1.p1.m3" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>-equivariant Novikov flow category (Definition <a href="#S7.Thmthm2" title="Definition 7.2. ‣ 7.1.2. Convergence ‣ 7.1. Unobstructedness, local finiteness, grading, and orientations ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.2</span></a> and Definition <a href="#S7.Thmthm24" title="Definition 7.24. ‣ 7.3.3. Symmetries on flow categories ‣ 7.3. Symmetries on flow categories, multimodules, and homotopies ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.24</span></a>), Theorem <a href="#Thmthma14" title="Theorem N. ‣ 8.2. FOP perturbations on flow categories, multimodules, and homotopies ‣ 8. FOP Perturbations ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">N</span></a> provides a <math id="S13.SS1.p1.m4" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>-equivariant lift, i.e., an FOP perturbation <math id="S13.SS1.p1.m5" class="ltx_Math" alttext="\mathring{\mathbb{F}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><annotation encoding="application/x-tex">\mathring{\mathbb{F}}</annotation></semantics></math> on <math id="S13.SS1.p1.m6" class="ltx_Math" alttext="\tilde{\mathbb{F}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{F}}</annotation></semantics></math>, which is a flow category enriched in <math id="S13.SS1.p1.m7" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf dOrb}}^{\rm FOP}_{\rm rig}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><msup><mrow></mrow><mi>FOP</mi></msup><msub><mrow></mrow><mi>rig</mi></msub></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf dOrb}}^{\rm FOP}_{\rm rig}</annotation></semantics></math>. Then apply the forgetful functor (i.e., taking the closure of the isotropy-free locus of the Kuranishi section)</p>
<table id="S13.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex1.m1" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf dOrb}}^{\rm FOP}_{\rm rig}\to\underline{\smash{{\bf\Psi}{\bf Man}}}," display="block" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><msup><mrow></mrow><mi>FOP</mi></msup><msub><mrow></mrow><mi>rig</mi></msub><mo stretchy="false">→</mo><munder accentunder="true"><mrow><mi>𝚿</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐌𝐚𝐧</mi></mrow><mo stretchy="true">¯</mo></munder><mo>,</mo></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf dOrb}}^{\rm FOP}_{\rm rig}\to\underline{\smash{{\bf\Psi}{\bf Man}}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.SS1.p1.2" class="ltx_p">one obtains a flow category enriched in <math id="S13.SS1.p1.m8" class="ltx_Math" alttext="\underline{\smash{{\bf\Psi}{\bf Man}}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mrow><mi>𝚿</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐌𝐚𝐧</mi></mrow><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{{\bf\Psi}{\bf Man}}}</annotation></semantics></math>. Using the coherent orientation and the <math id="S13.SS1.p1.m9" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>-grading by the Conley–Zehnder index, by Proposition <a href="#S7.Thmthm16" title="Proposition 7.16. ‣ 7.2.2. The differential ‣ 7.2. Algebraic structures without symmetry ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.16</span></a> and Proposition <a href="#S7.Thmthm30" title="Proposition 7.30. ‣ 7.4.1. Flow categories and bimodules ‣ 7.4. Algebraic structures with symmetry ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.30</span></a>, one obtains a canonically associated chain complex</p>
<table id="S13.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex2.m1" class="ltx_Math" alttext="CF_{*}(H,J;\Xi):=C_{*}(\mathring{\mathbb{F}})" display="block" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>J</mi><mo>,</mo><mi mathvariant="normal">Ξ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><msub><mi>C</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">CF_{*}(H,J;\Xi):=C_{*}(\mathring{\mathbb{F}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.SS1.p1.3" class="ltx_p">generated by objects of <math id="S13.SS1.p1.m10" class="ltx_Math" alttext="\mathbb{F}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">\mathbb{F}</annotation></semantics></math>, which has the structure of a graded <math id="S13.SS1.p1.m11" class="ltx_Math" alttext="\Lambda_{\mathbb{Z}}^{\Pi}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><mi>ℤ</mi><mi mathvariant="normal">Π</mi></msubsup><annotation encoding="application/x-tex">\Lambda_{\mathbb{Z}}^{\Pi}</annotation></semantics></math>-module. Here <math id="S13.SS1.p1.m12" class="ltx_Math" alttext="\Xi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ξ</mi><annotation encoding="application/x-tex">\Xi</annotation></semantics></math> denotes all choices made in constructing the AMS lift and the FOP perturbation; in particular, <math id="S13.SS1.p1.m13" class="ltx_Math" alttext="\Xi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ξ</mi><annotation encoding="application/x-tex">\Xi</annotation></semantics></math> includes the information of the outercollaring width and the integral action. We call this process the <span id="S13.SS1.p1.3.1" class="ltx_text ltx_font_bold">basic construction for Floer complex</span>.</p>
</div>
<div id="S13.SS1.p2" class="ltx_para ltx_noindent">
<p id="S13.SS1.p2.1" class="ltx_p">We prove that the Floer chain complex has a well-defined chain homotopy type. Let <math id="S13.SS1.p2.m1" class="ltx_Math" alttext="\Xi_{(0)}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ξ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">\Xi_{(0)}</annotation></semantics></math>, <math id="S13.SS1.p2.m2" class="ltx_Math" alttext="\Xi_{(1)}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ξ</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">\Xi_{(1)}</annotation></semantics></math> be two different sets of choices, including outercollaring widths, integral actions, and choices made for the two AMS lifts <math id="S13.SS1.p2.m3" class="ltx_Math" alttext="\tilde{\mathbb{F}}_{(0)}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">\tilde{\mathbb{F}}_{(0)}</annotation></semantics></math>, <math id="S13.SS1.p2.m4" class="ltx_Math" alttext="\tilde{\mathbb{F}}_{(1)}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">\tilde{\mathbb{F}}_{(1)}</annotation></semantics></math> and the FOP perturbations <math id="S13.SS1.p2.m5" class="ltx_Math" alttext="\mathring{\mathbb{F}}_{(0)}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">\mathring{\mathbb{F}}_{(0)}</annotation></semantics></math>, <math id="S13.SS1.p2.m6" class="ltx_Math" alttext="\mathring{\mathbb{F}}_{(1)}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">\mathring{\mathbb{F}}_{(1)}</annotation></semantics></math>.</p>
</div>
<div id="S13.Thmthm1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S13.Thmthm1.2" class="ltx_text ltx_font_bold">Lemma 13.1</span></span><span id="S13.Thmthm1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S13.Thmthm1.p1" class="ltx_para ltx_noindent">
<p id="S13.Thmthm1.p1.1" class="ltx_p"><span id="S13.Thmthm1.p1.1.1" class="ltx_text ltx_font_italic">There exists a chain homotopy equivalence</span></p>
<table id="S13.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex3.m1" class="ltx_Math" alttext="\Psi_{(01)}:CF_{*}(H,J,\Xi_{(0)})\to CF_{*}(H,J,\Xi_{(1)})" display="block" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mn>01</mn><mo stretchy="false">)</mo></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>J</mi><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>J</mi><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Psi_{(01)}:CF_{*}(H,J,\Xi_{(0)})\to CF_{*}(H,J,\Xi_{(1)})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.Thmthm1.p1.2" class="ltx_p"><span id="S13.Thmthm1.p1.2.1" class="ltx_text ltx_font_italic">whose chain homotopy type is well-defined.</span></p>
</div>
</div>
<div id="S13.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S13.SS1.p3" class="ltx_para ltx_noindent">
<p id="S13.SS1.p3.1" class="ltx_p"><span id="S13.SS1.p3.1.1" class="ltx_text">By the part of Theorem <a href="#Thmthma15" title="Theorem O. ‣ 12.1. Main statements for Floer flow categories ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">O</span></a> about outercollaring width, one can reduce the comparison to the case that the outercollaring widths are equal. Then by Proposition <a href="#S12.Thmthm2" title="Proposition 12.2. ‣ 12.1. Main statements for Floer flow categories ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12.2</span></a>, there exists a lift of the outercollaring of the diagonal bimodule <math id="S13.SS1.p3.m1" class="ltx_Math" alttext="\mathbb{\Delta}^{\mathbb{FF}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{\Delta}^{\mathbb{FF}}</annotation></semantics></math> to <math id="S13.SS1.p3.m2" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>NC</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}</annotation></semantics></math> as a bimodule over <math id="S13.SS1.p3.m3" class="ltx_Math" alttext="(\tilde{\mathbb{F}}_{(0)};\tilde{\mathbb{F}}_{(1)})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msub><mo>;</mo><msub><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\tilde{\mathbb{F}}_{(0)};\tilde{\mathbb{F}}_{(1)})</annotation></semantics></math>. Then by Theorem <a href="#Thmthma14" title="Theorem N. ‣ 8.2. FOP perturbations on flow categories, multimodules, and homotopies ‣ 8. FOP Perturbations ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">N</span></a>, the FOP perturbations <math id="S13.SS1.p3.m4" class="ltx_Math" alttext="\mathring{\mathbb{F}}_{(0)}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">\mathring{\mathbb{F}}_{(0)}</annotation></semantics></math> and <math id="S13.SS1.p3.m5" class="ltx_Math" alttext="\mathring{\mathbb{F}}_{(1)}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">\mathring{\mathbb{F}}_{(1)}</annotation></semantics></math> can be extended to an FOP perturbation <math id="S13.SS1.p3.m6" class="ltx_Math" alttext="\mathring{\mathbb{\Delta}}^{\mathbb{FF}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mo>̊</mo></mover><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\mathring{\mathbb{\Delta}}^{\mathbb{FF}}</annotation></semantics></math> on <math id="S13.SS1.p3.m7" class="ltx_Math" alttext="\tilde{\mathbb{\Delta}}^{\mathbb{FF}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mo>~</mo></mover><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\tilde{\mathbb{\Delta}}^{\mathbb{FF}}</annotation></semantics></math>. Then by Proposition <a href="#S7.Thmthm31" title="Proposition 7.31. ‣ 7.4.1. Flow categories and bimodules ‣ 7.4. Algebraic structures with symmetry ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.31</span></a>, one obtains the chain map</span></p>
<table id="S13.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex4.m1" class="ltx_Math" alttext="\Psi_{(01)}:CF_{*}(H,J,\Xi_{(0)})\to CF_{*}(H,J,\Xi_{(1)})." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mn>01</mn><mo stretchy="false">)</mo></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>J</mi><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>J</mi><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Psi_{(01)}:CF_{*}(H,J,\Xi_{(0)})\to CF_{*}(H,J,\Xi_{(1)}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.SS1.p3.2" class="ltx_p"><span id="S13.SS1.p3.2.1" class="ltx_text">Using the part of Proposition <a href="#S12.Thmthm2" title="Proposition 12.2. ‣ 12.1. Main statements for Floer flow categories ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12.2</span></a> stating that two lifts of <math id="S13.SS1.p3.m8" class="ltx_Math" alttext="{\mathbb{\Delta}}^{\mathbb{FF}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">{\mathbb{\Delta}}^{\mathbb{FF}}</annotation></semantics></math> are homotopic and Theorem <a href="#Thmthma14" title="Theorem N. ‣ 8.2. FOP perturbations on flow categories, multimodules, and homotopies ‣ 8. FOP Perturbations ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">N</span></a>, one can prove that the homotopy type of <math id="S13.SS1.p3.m9" class="ltx_Math" alttext="\Psi_{(01)}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mn>01</mn><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">\Psi_{(01)}</annotation></semantics></math> is well-defined.</span></p>
</div>
<div id="S13.SS1.p4" class="ltx_para">
<p id="S13.SS1.p4.1" class="ltx_p"><span id="S13.SS1.p4.1.1" class="ltx_text">It remains to prove that <math id="S13.SS1.p4.m1" class="ltx_Math" alttext="\Psi_{(01)}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mn>01</mn><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">\Psi_{(01)}</annotation></semantics></math> is a homotopy equivalence. Indeed, for each object <math id="S13.SS1.p4.m2" class="ltx_Math" alttext="p\in{\rm Ob}{\mathbb{F}}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></mrow><annotation encoding="application/x-tex">p\in{\rm Ob}{\mathbb{F}}</annotation></semantics></math>, the bimodule moduli space <math id="S13.SS1.p4.m3" class="ltx_Math" alttext="M_{p;p}^{\mathbb{FF}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mrow><mi>p</mi><mo>;</mo><mi>p</mi></mrow><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msubsup><annotation encoding="application/x-tex">M_{p;p}^{\mathbb{FF}}</annotation></semantics></math> consists of a single point corresponding to the constant trajectory at <math id="S13.SS1.p4.m4" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>. This moduli space has no lower strata, hence coincides with its outercollaring. Moreover, it is transversely cut out, so the FOP perturbation can be chosen to be the same as the original Kuranishi section. We can then choose the FOP perturbation <math id="S13.SS1.p4.m5" class="ltx_Math" alttext="\mathring{\mathbb{\Delta}}^{\mathbb{FF}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mo>̊</mo></mover><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\mathring{\mathbb{\Delta}}^{\mathbb{FF}}</annotation></semantics></math> inductively such that we do not perturb for <math id="S13.SS1.p4.m6" class="ltx_Math" alttext="M_{p;p}^{\mathbb{FF}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mrow><mi>p</mi><mo>;</mo><mi>p</mi></mrow><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msubsup><annotation encoding="application/x-tex">M_{p;p}^{\mathbb{FF}}</annotation></semantics></math>. For such a choice of FOP perturbation, the count <math id="S13.SS1.p4.m7" class="ltx_Math" alttext="n_{p;p}^{\mathbb{FF}}" display="inline" intent=":literal"><semantics><msubsup><mi>n</mi><mrow><mi>p</mi><mo>;</mo><mi>p</mi></mrow><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msubsup><annotation encoding="application/x-tex">n_{p;p}^{\mathbb{FF}}</annotation></semantics></math> needed to define the corresponding coefficient of the chain map is <math id="S13.SS1.p4.m8" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>. With respect to the natural identification of the chain groups <math id="S13.SS1.p4.m9" class="ltx_Math" alttext="CF_{*}(H,J,\Xi_{(0)})\cong CF_{*}(H,J,\Xi_{(1)})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>J</mi><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>J</mi><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">CF_{*}(H,J,\Xi_{(0)})\cong CF_{*}(H,J,\Xi_{(1)})</annotation></semantics></math>, <math id="S13.SS1.p4.m10" class="ltx_Math" alttext="\Psi_{(01)}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mn>01</mn><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">\Psi_{(01)}</annotation></semantics></math> is a higher order perturbation of the identity in terms of <math id="S13.SS1.p4.m11" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>-valuation. Therefore, <math id="S13.SS1.p4.m12" class="ltx_Math" alttext="\Psi_{(01)}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mn>01</mn><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">\Psi_{(01)}</annotation></semantics></math> is an invertible chain map, hence a chain homotopy equivalence.
∎</span></p>
</div>
</div>
<div id="S13.SS1.p5" class="ltx_para ltx_noindent">
<p id="S13.SS1.p5.1" class="ltx_p">This finishes the proof of Theorem <a href="#Thmthma1" title="Theorem A (Floer chain complex). ‣ 1.1.1. Floer complexes and Floer homology ‣ 1.1. Main results on Floer complexes ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A</span></a>.</p>
</div>
</section>
<section id="S13.SS2" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">13.2. </span>General construction of chain maps and homotopics</h4>

<section id="S13.SS2.SSS1" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">13.2.1. </span>Chain maps associated to smooth Floer domains</h5>

<div id="S13.SS2.SSS1.p1" class="ltx_para ltx_noindent">
<p id="S13.SS2.SSS1.p1.1" class="ltx_p">Suppose we are in Situation <a href="#Thmsituationm1" title="Situation Module(i). ‣ 10.2. Multimodules from smooth domains ‣ 10. Geometric Multimodules ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Module(i)</span></a>. Choose an outercollaring width and a compatible set of integral actions</p>
<table id="S13.EGx39" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S13.Ex5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S13.Ex5.m1" class="ltx_Math" alttext="\displaystyle\ {\mathcal{A}}_{{\mathbb{F}}_{j}}^{\Omega}:{\rm Ob}{\mathbb{F}}_{j}\to{\mathbb{Z}},\ " display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mi>𝔽</mi><mi>j</mi></msub><mi mathvariant="normal">Ω</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔽</mi><mi>j</mi></msub></mrow><mo stretchy="false">→</mo><mi>ℤ</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ {\mathcal{A}}_{{\mathbb{F}}_{j}}^{\Omega}:{\rm Ob}{\mathbb{F}}_{j}\to{\mathbb{Z}},\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S13.Ex5.m2" class="ltx_Math" alttext="\displaystyle\ {\mathcal{A}}_{{\mathbb{F}}^{\prime}}^{\Omega}:{\rm Ob}{\mathbb{F}}^{\prime}\to{\mathbb{Z}}." display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msup><mi>𝔽</mi><mo>′</mo></msup><mi mathvariant="normal">Ω</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔽</mi><mo>′</mo></msup></mrow><mo stretchy="false">→</mo><mi>ℤ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ {\mathcal{A}}_{{\mathbb{F}}^{\prime}}^{\Omega}:{\rm Ob}{\mathbb{F}}^{\prime}\to{\mathbb{Z}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.SS2.SSS1.p1.2" class="ltx_p">Let <math id="S13.SS2.SSS1.p1.m1" class="ltx_Math" alttext="CF_{*}(H_{j},J_{j},\Xi_{j})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mi>j</mi></msub><mo>,</mo><msub><mi>J</mi><mi>j</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF_{*}(H_{j},J_{j},\Xi_{j})</annotation></semantics></math> resp. <math id="S13.SS2.SSS1.p1.m2" class="ltx_Math" alttext="CF_{*}(H^{\prime},J^{\prime},\Xi^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mo>′</mo></msup><mo>,</mo><msup><mi>J</mi><mo>′</mo></msup><mo>,</mo><msup><mi mathvariant="normal">Ξ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF_{*}(H^{\prime},J^{\prime},\Xi^{\prime})</annotation></semantics></math> be Floer chain complexes associated to the Floer flow categories <math id="S13.SS2.SSS1.p1.m3" class="ltx_Math" alttext="{\mathbb{F}}_{j}" display="inline" intent=":literal"><semantics><msub><mi>𝔽</mi><mi>j</mi></msub><annotation encoding="application/x-tex">{\mathbb{F}}_{j}</annotation></semantics></math> resp. <math id="S13.SS2.SSS1.p1.m4" class="ltx_Math" alttext="{\mathbb{F}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝔽</mi><mo>′</mo></msup><annotation encoding="application/x-tex">{\mathbb{F}}^{\prime}</annotation></semantics></math>, which depend on the choices <math id="S13.SS2.SSS1.p1.m5" class="ltx_Math" alttext="\Xi_{j}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ξ</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\Xi_{j}</annotation></semantics></math> resp. <math id="S13.SS2.SSS1.p1.m6" class="ltx_Math" alttext="\Xi^{\prime}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Ξ</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\Xi^{\prime}</annotation></semantics></math>, including the information of the chosen outercollaring width, the integral actions, the construction of the AMS lifts <math id="S13.SS2.SSS1.p1.m7" class="ltx_Math" alttext="\tilde{\mathbb{F}}_{j}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mi>j</mi></msub><annotation encoding="application/x-tex">\tilde{\mathbb{F}}_{j}</annotation></semantics></math> reps. <math id="S13.SS2.SSS1.p1.m8" class="ltx_Math" alttext="\tilde{\mathbb{F}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mo>′</mo></msup><annotation encoding="application/x-tex">\tilde{\mathbb{F}}^{\prime}</annotation></semantics></math>, and FOP perturbations <math id="S13.SS2.SSS1.p1.m9" class="ltx_Math" alttext="\mathring{\mathbb{F}}_{j}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><mi>j</mi></msub><annotation encoding="application/x-tex">\mathring{\mathbb{F}}_{j}</annotation></semantics></math> resp. <math id="S13.SS2.SSS1.p1.m10" class="ltx_Math" alttext="\mathring{\mathbb{F}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><mo>′</mo></msup><annotation encoding="application/x-tex">\mathring{\mathbb{F}}^{\prime}</annotation></semantics></math>. Then by Theorem <a href="#Thmthma16" title="Theorem P. ‣ 12.2. Multimodules and homotopies ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">P</span></a>, there exists an AMS lift <math id="S13.SS2.SSS1.p1.m11" class="ltx_Math" alttext="\tilde{\mathbb{X}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝕏</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{X}}</annotation></semantics></math> of <math id="S13.SS2.SSS1.p1.m12" class="ltx_Math" alttext="{\mathbb{X}}" display="inline" intent=":literal"><semantics><mi>𝕏</mi><annotation encoding="application/x-tex">{\mathbb{X}}</annotation></semantics></math> subject to the outercollaring width and the integral actions as a multimodule over <math id="S13.SS2.SSS1.p1.m13" class="ltx_Math" alttext="(\tilde{\mathbb{F}}_{1},\ldots,\tilde{\mathbb{F}}_{m};\tilde{\mathbb{F}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mi>m</mi></msub><mo>,</mo><msup><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\tilde{\mathbb{F}}_{1},\ldots,\tilde{\mathbb{F}}_{m};\tilde{\mathbb{F}}^{\prime})</annotation></semantics></math>. By Theorem <a href="#Thmthma14" title="Theorem N. ‣ 8.2. FOP perturbations on flow categories, multimodules, and homotopies ‣ 8. FOP Perturbations ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">N</span></a>, the FOP perturbations <math id="S13.SS2.SSS1.p1.m14" class="ltx_Math" alttext="\mathring{\mathbb{F}}_{j}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><mi>j</mi></msub><annotation encoding="application/x-tex">\mathring{\mathbb{F}}_{j}</annotation></semantics></math> and <math id="S13.SS2.SSS1.p1.m15" class="ltx_Math" alttext="\mathring{\mathbb{F}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><mo>′</mo></msup><annotation encoding="application/x-tex">\mathring{\mathbb{F}}^{\prime}</annotation></semantics></math> can be extended to an FOP perturbation <math id="S13.SS2.SSS1.p1.m16" class="ltx_Math" alttext="\mathring{\mathbb{X}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝕏</mi><mo>̊</mo></mover><annotation encoding="application/x-tex">\mathring{\mathbb{X}}</annotation></semantics></math> on <math id="S13.SS2.SSS1.p1.m17" class="ltx_Math" alttext="\tilde{\mathbb{X}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝕏</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{X}}</annotation></semantics></math>. Then by Proposition <a href="#S7.Thmthm31" title="Proposition 7.31. ‣ 7.4.1. Flow categories and bimodules ‣ 7.4. Algebraic structures with symmetry ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.31</span></a>, one obtains a chain map</p>
<table id="S13.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex6.m1" class="ltx_Math" alttext="\Phi^{\mathbb{X}}(\Theta):\bigotimes_{1\leq j\leq m}CF_{*}(H_{j},J_{j},\Xi_{j})\to CF_{*}(H^{\prime},J^{\prime},\Xi^{\prime})" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">Φ</mi><mi>𝕏</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">:</mo><mrow><mrow><munder><mo movablelimits="false">⨂</mo><mrow><mn>1</mn><mo>≤</mo><mi>j</mi><mo>≤</mo><mi>m</mi></mrow></munder><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mi>j</mi></msub><mo>,</mo><msub><mi>J</mi><mi>j</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mo>′</mo></msup><mo>,</mo><msup><mi>J</mi><mo>′</mo></msup><mo>,</mo><msup><mi mathvariant="normal">Ξ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Phi^{\mathbb{X}}(\Theta):\bigotimes_{1\leq j\leq m}CF_{*}(H_{j},J_{j},\Xi_{j})\to CF_{*}(H^{\prime},J^{\prime},\Xi^{\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.SS2.SSS1.p1.3" class="ltx_p">where <math id="S13.SS2.SSS1.p1.m18" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math> contains the information of all choices made in order to define such a chain map.</p>
</div>
<div id="S13.SS2.SSS1.p2" class="ltx_para ltx_noindent">
<p id="S13.SS2.SSS1.p2.1" class="ltx_p">In practice, the multimodule <math id="S13.SS2.SSS1.p2.m1" class="ltx_Math" alttext="{\mathbb{X}}" display="inline" intent=":literal"><semantics><mi>𝕏</mi><annotation encoding="application/x-tex">{\mathbb{X}}</annotation></semantics></math> could be either a bimodule needed for establishing the continuation map, the multimodule needed for defining the pair-of-pants product, or the multimodule for defining the Poincaré duality etc. We need to prove that it is well-defined up to homotopy. Again, one can reduce the comparison to the case when the outercollaring widths are the same.</p>
</div>
<div id="S13.Thmthm2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S13.Thmthm2.2" class="ltx_text ltx_font_bold">Lemma 13.2</span></span><span id="S13.Thmthm2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S13.Thmthm2.p1" class="ltx_para ltx_noindent">
<p id="S13.Thmthm2.p1.1" class="ltx_p"><span id="S13.Thmthm2.p1.1.1" class="ltx_text ltx_font_italic">Fix the outercollaring width and the compatible set of integral actions on the involved flow categories. Let <math id="S13.Thmthm2.p1.m1" class="ltx_Math" alttext="CF_{*}(H_{j},J_{j},\Xi_{j})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mi>j</mi></msub><mo>,</mo><msub><mi>J</mi><mi>j</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF_{*}(H_{j},J_{j},\Xi_{j})</annotation></semantics></math> resp. <math id="S13.Thmthm2.p1.m2" class="ltx_Math" alttext="CF_{*}(H^{\prime},J^{\prime},\Xi^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mo>′</mo></msup><mo>,</mo><msup><mi>J</mi><mo>′</mo></msup><mo>,</mo><msup><mi mathvariant="normal">Ξ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF_{*}(H^{\prime},J^{\prime},\Xi^{\prime})</annotation></semantics></math> be Floer chain complexes associated to these flow categories. Let</span></p>
<table id="S13.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex7.m1" class="ltx_Math" alttext="\Phi^{\mathbb{X}}(\Theta_{0}),\ \Phi^{{\mathbb{X}}}(\Theta_{1}):\bigotimes_{1\leq j\leq m}CF_{*}(H_{j},J_{j},\Xi_{j})\to CF_{*}(H^{\prime},J^{\prime},\Xi^{\prime})" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">Φ</mi><mi>𝕏</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mrow><msup><mi mathvariant="normal">Φ</mi><mi>𝕏</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mn>1</mn></msub><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">:</mo><mrow><mrow><munder><mo movablelimits="false">⨂</mo><mrow><mn>1</mn><mo>≤</mo><mi>j</mi><mo>≤</mo><mi>m</mi></mrow></munder><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mi>j</mi></msub><mo>,</mo><msub><mi>J</mi><mi>j</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mo>′</mo></msup><mo>,</mo><msup><mi>J</mi><mo>′</mo></msup><mo>,</mo><msup><mi mathvariant="normal">Ξ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Phi^{\mathbb{X}}(\Theta_{0}),\ \Phi^{{\mathbb{X}}}(\Theta_{1}):\bigotimes_{1\leq j\leq m}CF_{*}(H_{j},J_{j},\Xi_{j})\to CF_{*}(H^{\prime},J^{\prime},\Xi^{\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.Thmthm2.p1.2" class="ltx_p"><span id="S13.Thmthm2.p1.2.1" class="ltx_text ltx_font_italic">be two chain maps defined via two differet sets of choices made for two AMS lifts <math id="S13.Thmthm2.p1.m3" class="ltx_Math" alttext="\tilde{\mathbb{X}}_{0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝕏</mi><mo>~</mo></mover><mn>0</mn></msub><annotation encoding="application/x-tex">\tilde{\mathbb{X}}_{0}</annotation></semantics></math> resp. <math id="S13.Thmthm2.p1.m4" class="ltx_Math" alttext="\tilde{\mathbb{X}}_{1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝕏</mi><mo>~</mo></mover><mn>1</mn></msub><annotation encoding="application/x-tex">\tilde{\mathbb{X}}_{1}</annotation></semantics></math> and two FOP perturbations <math id="S13.Thmthm2.p1.m5" class="ltx_Math" alttext="\mathring{\mathbb{X}}_{0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝕏</mi><mo>̊</mo></mover><mn>0</mn></msub><annotation encoding="application/x-tex">\mathring{\mathbb{X}}_{0}</annotation></semantics></math> resp. <math id="S13.Thmthm2.p1.m6" class="ltx_Math" alttext="\mathring{\mathbb{X}}_{1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝕏</mi><mo>̊</mo></mover><mn>1</mn></msub><annotation encoding="application/x-tex">\mathring{\mathbb{X}}_{1}</annotation></semantics></math>. Then <math id="S13.Thmthm2.p1.m7" class="ltx_Math" alttext="\Phi^{{\mathbb{X}}}(\Theta_{0})" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><mi>𝕏</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Phi^{{\mathbb{X}}}(\Theta_{0})</annotation></semantics></math> and <math id="S13.Thmthm2.p1.m8" class="ltx_Math" alttext="\Phi^{{\mathbb{X}}}(\Theta_{1})" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><mi>𝕏</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Phi^{{\mathbb{X}}}(\Theta_{1})</annotation></semantics></math> are chain homotopic.</span></p>
</div>
</div>
<div id="S13.SS2.SSS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S13.SS2.SSS1.p3" class="ltx_para">
<p id="S13.SS2.SSS1.p3.1" class="ltx_p"><span id="S13.SS2.SSS1.p3.1.1" class="ltx_text">Consider the trivial homotopy <math id="S13.SS2.SSS1.p3.m1" class="ltx_Math" alttext="\mathbb{H}" display="inline" intent=":literal"><semantics><mi>ℍ</mi><annotation encoding="application/x-tex">\mathbb{H}</annotation></semantics></math> from <math id="S13.SS2.SSS1.p3.m2" class="ltx_Math" alttext="{\mathbb{X}}" display="inline" intent=":literal"><semantics><mi>𝕏</mi><annotation encoding="application/x-tex">{\mathbb{X}}</annotation></semantics></math> to itself. The set of integral actions remain compatible with respect to <math id="S13.SS2.SSS1.p3.m3" class="ltx_Math" alttext="{\mathbb{H}}" display="inline" intent=":literal"><semantics><mi>ℍ</mi><annotation encoding="application/x-tex">{\mathbb{H}}</annotation></semantics></math>. Therefore, by part (2) of Theorem <a href="#Thmthma16" title="Theorem P. ‣ 12.2. Multimodules and homotopies ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">P</span></a>, there exists a homotopy <math id="S13.SS2.SSS1.p3.m4" class="ltx_Math" alttext="\tilde{\mathbb{H}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ℍ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{H}}</annotation></semantics></math> from <math id="S13.SS2.SSS1.p3.m5" class="ltx_Math" alttext="\tilde{\mathbb{X}}_{0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝕏</mi><mo>~</mo></mover><mn>0</mn></msub><annotation encoding="application/x-tex">\tilde{\mathbb{X}}_{0}</annotation></semantics></math> to <math id="S13.SS2.SSS1.p3.m6" class="ltx_Math" alttext="\tilde{\mathbb{X}}_{1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝕏</mi><mo>~</mo></mover><mn>1</mn></msub><annotation encoding="application/x-tex">\tilde{\mathbb{X}}_{1}</annotation></semantics></math> as a lift of the outercollaring of <math id="S13.SS2.SSS1.p3.m7" class="ltx_Math" alttext="{\mathbb{H}}" display="inline" intent=":literal"><semantics><mi>ℍ</mi><annotation encoding="application/x-tex">{\mathbb{H}}</annotation></semantics></math>. By Theorem <a href="#Thmthma14" title="Theorem N. ‣ 8.2. FOP perturbations on flow categories, multimodules, and homotopies ‣ 8. FOP Perturbations ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">N</span></a>, the FOP perturbations <math id="S13.SS2.SSS1.p3.m8" class="ltx_Math" alttext="\mathring{\mathbb{F}}_{j}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><mi>j</mi></msub><annotation encoding="application/x-tex">\mathring{\mathbb{F}}_{j}</annotation></semantics></math>, <math id="S13.SS2.SSS1.p3.m9" class="ltx_Math" alttext="\mathring{\mathbb{F}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><mo>′</mo></msup><annotation encoding="application/x-tex">\mathring{\mathbb{F}}^{\prime}</annotation></semantics></math>, <math id="S13.SS2.SSS1.p3.m10" class="ltx_Math" alttext="\mathring{\mathbb{X}}_{0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝕏</mi><mo>̊</mo></mover><mn>0</mn></msub><annotation encoding="application/x-tex">\mathring{\mathbb{X}}_{0}</annotation></semantics></math>, <math id="S13.SS2.SSS1.p3.m11" class="ltx_Math" alttext="\mathring{\mathbb{X}}_{1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝕏</mi><mo>̊</mo></mover><mn>1</mn></msub><annotation encoding="application/x-tex">\mathring{\mathbb{X}}_{1}</annotation></semantics></math> can be extended to an FOP perturbation <math id="S13.SS2.SSS1.p3.m12" class="ltx_Math" alttext="\mathring{\mathbb{H}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ℍ</mi><mo>̊</mo></mover><annotation encoding="application/x-tex">\mathring{\mathbb{H}}</annotation></semantics></math> on <math id="S13.SS2.SSS1.p3.m13" class="ltx_Math" alttext="\tilde{\mathbb{H}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ℍ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{H}}</annotation></semantics></math>. Then by Proposition <a href="#S7.Thmthm32" title="Proposition 7.32. ‣ 7.4.2. Multimodules and homotopies ‣ 7.4. Algebraic structures with symmetry ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.32</span></a> one obtains a chain homotopy between <math id="S13.SS2.SSS1.p3.m14" class="ltx_Math" alttext="\Phi^{{\mathbb{X}}}(\Theta_{0})" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><mi>𝕏</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Phi^{{\mathbb{X}}}(\Theta_{0})</annotation></semantics></math> and <math id="S13.SS2.SSS1.p3.m15" class="ltx_Math" alttext="\Phi^{{\mathbb{X}}}(\Theta_{1})" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><mi>𝕏</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Phi^{{\mathbb{X}}}(\Theta_{1})</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S13.SS2.SSS1.p4" class="ltx_para ltx_noindent">
<p id="S13.SS2.SSS1.p4.1" class="ltx_p">Next we compare different choices of integral actions.</p>
</div>
<div id="S13.Thmthm3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S13.Thmthm3.2" class="ltx_text ltx_font_bold">Lemma 13.3</span></span><span id="S13.Thmthm3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S13.Thmthm3.p1" class="ltx_para ltx_noindent">
<p id="S13.Thmthm3.p1.1" class="ltx_p"><span id="S13.Thmthm3.p1.1.1" class="ltx_text ltx_font_italic">Fix an outercollaring width. Let</span></p>
<table id="S13.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex8.m1" class="ltx_Math" alttext="{\mathcal{A}}_{{\mathbb{F}}_{j}}^{\Omega_{(s)}},\ {\mathcal{A}}_{{\mathbb{F}}^{\prime}}^{\Omega_{(s)}},\ s=0,1" display="block" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mi>𝔽</mi><mi>j</mi></msub><msub><mi mathvariant="normal">Ω</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub></msubsup><mo rspace="0.667em">,</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msup><mi>𝔽</mi><mo>′</mo></msup><msub><mi mathvariant="normal">Ω</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub></msubsup><mo rspace="0.667em">,</mo><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\mathcal{A}}_{{\mathbb{F}}_{j}}^{\Omega_{(s)}},\ {\mathcal{A}}_{{\mathbb{F}}^{\prime}}^{\Omega_{(s)}},\ s=0,1</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.Thmthm3.p1.2" class="ltx_p"><span id="S13.Thmthm3.p1.2.1" class="ltx_text ltx_font_italic">be two compatible sets of integral actions. Let</span></p>
<table id="S13.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex9.m1" class="ltx_Math" alttext="CF_{*}(H_{j},J_{j},\Xi_{j,(s)}),\ CF_{*}(H^{\prime},J^{\prime},\Xi_{(s)}^{\prime})" display="block" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mi>j</mi></msub><mo>,</mo><msub><mi>J</mi><mi>j</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mrow><mi>j</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mo>′</mo></msup><mo>,</mo><msup><mi>J</mi><mo>′</mo></msup><mo>,</mo><msubsup><mi mathvariant="normal">Ξ</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">CF_{*}(H_{j},J_{j},\Xi_{j,(s)}),\ CF_{*}(H^{\prime},J^{\prime},\Xi_{(s)}^{\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.Thmthm3.p1.3" class="ltx_p"><span id="S13.Thmthm3.p1.3.1" class="ltx_text ltx_font_italic">be Floer complexes whose constructions are subject to one of the sets of compatible integral actions, including the construction of the AMS lifts <math id="S13.Thmthm3.p1.m1" class="ltx_Math" alttext="\tilde{\mathbb{F}}_{j,(s)}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mrow><mi>j</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\tilde{\mathbb{F}}_{j,(s)}</annotation></semantics></math> and <math id="S13.Thmthm3.p1.m2" class="ltx_Math" alttext="\tilde{\mathbb{F}}_{(s)}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">\tilde{\mathbb{F}}_{(s)}^{\prime}</annotation></semantics></math> and FOP perturbations <math id="S13.Thmthm3.p1.m3" class="ltx_Math" alttext="\mathring{\mathbb{F}}_{j,(s)}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><mrow><mi>j</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\mathring{\mathbb{F}}_{j,(s)}</annotation></semantics></math>, <math id="S13.Thmthm3.p1.m4" class="ltx_Math" alttext="\mathring{\mathbb{F}}_{(s)}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">\mathring{\mathbb{F}}_{(s)}^{\prime}</annotation></semantics></math>. Let</span></p>
<table id="S13.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex10.m1" class="ltx_Math" alttext="\Phi^{{\mathbb{X}}}(\Theta_{(s)}):\bigotimes_{1\leq j\leq m}CF_{*}(H_{j},J_{j},\Xi_{j,(s)})\to CF_{*}(H^{\prime},J^{\prime},\Xi_{(s)}^{\prime})" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">Φ</mi><mi>𝕏</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">:</mo><mrow><mrow><munder><mo movablelimits="false">⨂</mo><mrow><mn>1</mn><mo>≤</mo><mi>j</mi><mo>≤</mo><mi>m</mi></mrow></munder><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mi>j</mi></msub><mo>,</mo><msub><mi>J</mi><mi>j</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mrow><mi>j</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mo>′</mo></msup><mo>,</mo><msup><mi>J</mi><mo>′</mo></msup><mo>,</mo><msubsup><mi mathvariant="normal">Ξ</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Phi^{{\mathbb{X}}}(\Theta_{(s)}):\bigotimes_{1\leq j\leq m}CF_{*}(H_{j},J_{j},\Xi_{j,(s)})\to CF_{*}(H^{\prime},J^{\prime},\Xi_{(s)}^{\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.Thmthm3.p1.4" class="ltx_p"><span id="S13.Thmthm3.p1.4.1" class="ltx_text ltx_font_italic">be the chain map defined via two different AMS constructions subject to the two sets of integral actions, including the AMS lifts <math id="S13.Thmthm3.p1.m5" class="ltx_Math" alttext="\tilde{\mathbb{X}}_{(s)}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝕏</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">\tilde{\mathbb{X}}_{(s)}</annotation></semantics></math> and the FOP perturbation <math id="S13.Thmthm3.p1.m6" class="ltx_Math" alttext="\mathring{\mathbb{X}}_{(s)}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝕏</mi><mo>̊</mo></mover><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">\mathring{\mathbb{X}}_{(s)}</annotation></semantics></math>.</span></p>
</div>
<div id="S13.Thmthm3.p2" class="ltx_para ltx_noindent">
<p id="S13.Thmthm3.p2.1" class="ltx_p"><span id="S13.Thmthm3.p2.1.1" class="ltx_text ltx_font_italic">Moreover, let</span></p>
<table id="S13.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex11.m1" class="ltx_Math" alttext="\Psi_{j,(01)}:CF_{*}(H_{j},J_{j},\Xi_{j,(0)})\to CF_{*}(H_{j},J_{j},\Xi_{j,(1)})" display="block" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>j</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>01</mn><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mi>j</mi></msub><mo>,</mo><msub><mi>J</mi><mi>j</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mrow><mi>j</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mi>j</mi></msub><mo>,</mo><msub><mi>J</mi><mi>j</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mrow><mi>j</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Psi_{j,(01)}:CF_{*}(H_{j},J_{j},\Xi_{j,(0)})\to CF_{*}(H_{j},J_{j},\Xi_{j,(1)})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.Thmthm3.p2.2" class="ltx_p"><span id="S13.Thmthm3.p2.2.1" class="ltx_text ltx_font_italic">and</span></p>
<table id="S13.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex12.m1" class="ltx_Math" alttext="\Psi_{(10)}^{\prime}:CF_{*}(H^{\prime},J^{\prime},\Xi_{(1)}^{\prime})\to CF_{*}(H^{\prime},J^{\prime},\Xi_{(0)}^{\prime})" display="block" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mn>10</mn><mo stretchy="false">)</mo></mrow><mo>′</mo></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mo>′</mo></msup><mo>,</mo><msup><mi>J</mi><mo>′</mo></msup><mo>,</mo><msubsup><mi mathvariant="normal">Ξ</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mo>′</mo></msup><mo>,</mo><msup><mi>J</mi><mo>′</mo></msup><mo>,</mo><msubsup><mi mathvariant="normal">Ξ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Psi_{(10)}^{\prime}:CF_{*}(H^{\prime},J^{\prime},\Xi_{(1)}^{\prime})\to CF_{*}(H^{\prime},J^{\prime},\Xi_{(0)}^{\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.Thmthm3.p2.3" class="ltx_p"><span id="S13.Thmthm3.p2.3.1" class="ltx_text ltx_font_italic">be the chain maps induced from the continuation maps provided by Proposition <a href="#S12.Thmthm2" title="Proposition 12.2. ‣ 12.1. Main statements for Floer flow categories ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12.2</span></a>. Then there exists a chain homotopy between <math id="S13.Thmthm3.p2.m1" class="ltx_Math" alttext="\Phi^{\mathbb{X}}(\Theta_{(0)})" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><mi>𝕏</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Phi^{\mathbb{X}}(\Theta_{(0)})</annotation></semantics></math> and the composition</span></p>
<table id="S13.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex13.m1" class="ltx_math_unparsed" alttext="\Psi_{(10)}^{\prime}\circ\Phi^{\mathbb{X}}(\Theta_{(1)})\circ\Big(\Psi_{1,(01)}\otimes\cdots\otimes\Psi_{m,(01)}\Big)." display="block" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Ψ</mi><mrow><mo stretchy="false">(</mo><mn>10</mn><mo stretchy="false">)</mo></mrow><mo>′</mo></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi mathvariant="normal">Φ</mi><mi>𝕏</mi></msup><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">∘</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msub><mi mathvariant="normal">Ψ</mi><mrow><mn>1</mn><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>01</mn><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0.222em">⊗</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">⊗</mo><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>m</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>01</mn><mo stretchy="false">)</mo></mrow></mrow></msub><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Psi_{(10)}^{\prime}\circ\Phi^{\mathbb{X}}(\Theta_{(1)})\circ\Big(\Psi_{1,(01)}\otimes\cdots\otimes\Psi_{m,(01)}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S13.SS2.SSS1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S13.SS2.SSS1.p5" class="ltx_para ltx_noindent">
<p id="S13.SS2.SSS1.p5.1" class="ltx_p"><span id="S13.SS2.SSS1.p5.1.1" class="ltx_text">This is essentially a consequence of Proposition <a href="#S12.Thmthm3" title="Proposition 12.3. ‣ 12.2. Multimodules and homotopies ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12.3</span></a>. Indeed, the assumption of this lemma can be plugged into the assumption of Proposition <a href="#S12.Thmthm3" title="Proposition 12.3. ‣ 12.2. Multimodules and homotopies ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12.3</span></a>. Then one obtains a homotopy <math id="S13.SS2.SSS1.p5.m1" class="ltx_Math" alttext="\tilde{\mathbb{H}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ℍ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{H}}</annotation></semantics></math> from <math id="S13.SS2.SSS1.p5.m2" class="ltx_Math" alttext="\tilde{\mathbb{X}}_{(0)}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝕏</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">\tilde{\mathbb{X}}_{(0)}</annotation></semantics></math> to the concatenation</span></p>
<table id="S13.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex14.m1" class="ltx_math_unparsed" alttext="\Big(\tilde{\mathbb{\Delta}}_{(01)}^{\mathbb{F}_{1}\mathbb{F}_{1}}\times\cdots\times\tilde{\mathbb{\Delta}}_{(01)}^{\mathbb{F}_{m}\mathbb{F}_{m}}\Big)\circ\tilde{\mathbb{X}}_{(1)}\circ\tilde{\mathbb{\Delta}}_{(10)}^{\mathbb{F}^{\prime}\mathbb{F}^{\prime}}." display="block" intent=":literal"><semantics><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msubsup><mover accent="true"><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>01</mn><mo stretchy="false">)</mo></mrow><mrow><msub><mi>𝔽</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔽</mi><mn>1</mn></msub></mrow></msubsup><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><msubsup><mover accent="true"><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>01</mn><mo stretchy="false">)</mo></mrow><mrow><msub><mi>𝔽</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔽</mi><mi>m</mi></msub></mrow></msubsup><mo maxsize="1.600em" minsize="1.600em" rspace="0.055em">)</mo></mrow><mo rspace="0.222em">∘</mo><msub><mover accent="true"><mi>𝕏</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mover accent="true"><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>10</mn><mo stretchy="false">)</mo></mrow><mrow><msup><mi>𝔽</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔽</mi><mo>′</mo></msup></mrow></msubsup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Big(\tilde{\mathbb{\Delta}}_{(01)}^{\mathbb{F}_{1}\mathbb{F}_{1}}\times\cdots\times\tilde{\mathbb{\Delta}}_{(01)}^{\mathbb{F}_{m}\mathbb{F}_{m}}\Big)\circ\tilde{\mathbb{X}}_{(1)}\circ\tilde{\mathbb{\Delta}}_{(10)}^{\mathbb{F}^{\prime}\mathbb{F}^{\prime}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.SS2.SSS1.p5.2" class="ltx_p"><span id="S13.SS2.SSS1.p5.2.1" class="ltx_text">Then by Theorem <a href="#Thmthma14" title="Theorem N. ‣ 8.2. FOP perturbations on flow categories, multimodules, and homotopies ‣ 8. FOP Perturbations ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">N</span></a>, the existing FOP perturbations can be extended to an FOP perturbation <math id="S13.SS2.SSS1.p5.m3" class="ltx_Math" alttext="\mathring{\mathbb{H}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ℍ</mi><mo>̊</mo></mover><annotation encoding="application/x-tex">\mathring{\mathbb{H}}</annotation></semantics></math> on <math id="S13.SS2.SSS1.p5.m4" class="ltx_Math" alttext="\tilde{\mathbb{H}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ℍ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{H}}</annotation></semantics></math>. The conclusion then follows.
∎</span></p>
</div>
</div>
</section>
<section id="S13.SS2.SSS2" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">13.2.2. </span>Homotopy</h5>

<div id="S13.SS2.SSS2.p1" class="ltx_para ltx_noindent">
<p id="S13.SS2.SSS2.p1.1" class="ltx_p">We prove the following basic chain-level consequence of homotopies of multimodules from varying Floer data.</p>
</div>
<div id="S13.Thmthm4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S13.Thmthm4.2" class="ltx_text ltx_font_bold">Lemma 13.4</span></span><span id="S13.Thmthm4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S13.Thmthm4.p1" class="ltx_para ltx_noindent">
<p id="S13.Thmthm4.p1.1" class="ltx_p"><span id="S13.Thmthm4.p1.1.1" class="ltx_text ltx_font_italic">In Situation <a href="#Thmsituationh1" title="Situation Homotopy(i). ‣ 11.1. Homotopies from varying Floer data ‣ 11. Homotopies of Multimodules ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Homotopy(i)</span></a>, fix an outercollaring width and a compatible set of integral actions on involved Floer flow categories. Let</span></p>
<table id="S13.EGx40" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S13.Ex15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S13.Ex15.m1" class="ltx_Math" alttext="\displaystyle\ CF_{*}(H_{j},J_{j},\Xi_{j}),\ " display="inline" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mi>j</mi></msub><mo>,</mo><msub><mi>J</mi><mi>j</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ CF_{*}(H_{j},J_{j},\Xi_{j}),\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S13.Ex15.m2" class="ltx_Math" alttext="\displaystyle\ CF_{*}(H^{\prime},J^{\prime},\Xi^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mo>′</mo></msup><mo>,</mo><msup><mi>J</mi><mo>′</mo></msup><mo>,</mo><msup><mi mathvariant="normal">Ξ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ CF_{*}(H^{\prime},J^{\prime},\Xi^{\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.Thmthm4.p1.2" class="ltx_p"><span id="S13.Thmthm4.p1.2.1" class="ltx_text ltx_font_italic">be Floer chain complexes provided by Theorem <a href="#Thmthma1" title="Theorem A (Floer chain complex). ‣ 1.1.1. Floer complexes and Floer homology ‣ 1.1. Main results on Floer complexes ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A</span></a> subject to the outercollaring width and the integral actions. Let</span></p>
<table id="S13.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex16.m1" class="ltx_Math" alttext="\Phi^{{\mathbb{X}}_{0}}(\Theta_{0}),\ \Phi^{{\mathbb{X}}_{1}}(\Theta_{1}):\bigotimes_{1\leq j\leq m}CF_{*}(H_{j},J_{j},\Xi_{j})\to CF_{*}(H^{\prime},J^{\prime},\Xi^{\prime})" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">Φ</mi><msub><mi>𝕏</mi><mn>0</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mrow><msup><mi mathvariant="normal">Φ</mi><msub><mi>𝕏</mi><mn>1</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mn>1</mn></msub><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">:</mo><mrow><mrow><munder><mo movablelimits="false">⨂</mo><mrow><mn>1</mn><mo>≤</mo><mi>j</mi><mo>≤</mo><mi>m</mi></mrow></munder><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mi>j</mi></msub><mo>,</mo><msub><mi>J</mi><mi>j</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mo>′</mo></msup><mo>,</mo><msup><mi>J</mi><mo>′</mo></msup><mo>,</mo><msup><mi mathvariant="normal">Ξ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Phi^{{\mathbb{X}}_{0}}(\Theta_{0}),\ \Phi^{{\mathbb{X}}_{1}}(\Theta_{1}):\bigotimes_{1\leq j\leq m}CF_{*}(H_{j},J_{j},\Xi_{j})\to CF_{*}(H^{\prime},J^{\prime},\Xi^{\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.Thmthm4.p1.3" class="ltx_p"><span id="S13.Thmthm4.p1.3.1" class="ltx_text ltx_font_italic">be chain maps provided by the basic construction of chain maps. Then these two chain maps are homotopic.</span></p>
</div>
</div>
<div id="S13.SS2.SSS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S13.SS2.SSS2.p2" class="ltx_para">
<p id="S13.SS2.SSS2.p2.1" class="ltx_p"><span id="S13.SS2.SSS2.p2.1.1" class="ltx_text">The construction of the Floer chain complexes involves choosing AMS lifts <math id="S13.SS2.SSS2.p2.m1" class="ltx_Math" alttext="\tilde{\mathbb{F}}_{1},\ldots,\tilde{\mathbb{F}}_{m};\tilde{\mathbb{F}}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mi>m</mi></msub><mo>;</mo><msup><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">\tilde{\mathbb{F}}_{1},\ldots,\tilde{\mathbb{F}}_{m};\tilde{\mathbb{F}}^{\prime}</annotation></semantics></math> and FOP perturbations <math id="S13.SS2.SSS2.p2.m2" class="ltx_Math" alttext="\mathring{\mathbb{F}}_{1},\ldots,\mathring{\mathbb{F}}_{m};\mathring{\mathbb{F}}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><mi>m</mi></msub><mo>;</mo><msup><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">\mathring{\mathbb{F}}_{1},\ldots,\mathring{\mathbb{F}}_{m};\mathring{\mathbb{F}}^{\prime}</annotation></semantics></math>. Then the chain maps are constructed by choosing AMS lifts <math id="S13.SS2.SSS2.p2.m3" class="ltx_Math" alttext="\tilde{\mathbb{X}}_{0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝕏</mi><mo>~</mo></mover><mn>0</mn></msub><annotation encoding="application/x-tex">\tilde{\mathbb{X}}_{0}</annotation></semantics></math> and <math id="S13.SS2.SSS2.p2.m4" class="ltx_Math" alttext="\tilde{\mathbb{X}}_{1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝕏</mi><mo>~</mo></mover><mn>1</mn></msub><annotation encoding="application/x-tex">\tilde{\mathbb{X}}_{1}</annotation></semantics></math>
as multimodules over <math id="S13.SS2.SSS2.p2.m5" class="ltx_Math" alttext="(\tilde{\mathbb{F}}_{1},\ldots,\tilde{\mathbb{F}}_{m};\tilde{\mathbb{F}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mi>m</mi></msub><mo>,</mo><msup><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\tilde{\mathbb{F}}_{1},\ldots,\tilde{\mathbb{F}}_{m};\tilde{\mathbb{F}}^{\prime})</annotation></semantics></math>, and FOP perturbations <math id="S13.SS2.SSS2.p2.m6" class="ltx_Math" alttext="\mathring{\mathbb{X}}_{0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝕏</mi><mo>̊</mo></mover><mn>0</mn></msub><annotation encoding="application/x-tex">\mathring{\mathbb{X}}_{0}</annotation></semantics></math>, <math id="S13.SS2.SSS2.p2.m7" class="ltx_Math" alttext="\mathring{\mathbb{X}}_{1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝕏</mi><mo>̊</mo></mover><mn>1</mn></msub><annotation encoding="application/x-tex">\mathring{\mathbb{X}}_{1}</annotation></semantics></math> as multimodules over <math id="S13.SS2.SSS2.p2.m8" class="ltx_Math" alttext="(\mathring{\mathbb{F}}_{1},\ldots,\mathring{\mathbb{F}}_{m};\mathring{\mathbb{F}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><mi>m</mi></msub><mo>,</mo><msup><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathring{\mathbb{F}}_{1},\ldots,\mathring{\mathbb{F}}_{m};\mathring{\mathbb{F}}^{\prime})</annotation></semantics></math>. Then by Theorem <a href="#Thmthma17" title="Theorem Q. ‣ 12.2. Multimodules and homotopies ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Q</span></a>, there exists an AMS lift <math id="S13.SS2.SSS2.p2.m9" class="ltx_Math" alttext="\tilde{\mathbb{H}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ℍ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{H}}</annotation></semantics></math> as a homotopy from <math id="S13.SS2.SSS2.p2.m10" class="ltx_Math" alttext="\tilde{\mathbb{X}}_{0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝕏</mi><mo>~</mo></mover><mn>0</mn></msub><annotation encoding="application/x-tex">\tilde{\mathbb{X}}_{0}</annotation></semantics></math> to <math id="S13.SS2.SSS2.p2.m11" class="ltx_Math" alttext="\tilde{\mathbb{X}}_{1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝕏</mi><mo>~</mo></mover><mn>1</mn></msub><annotation encoding="application/x-tex">\tilde{\mathbb{X}}_{1}</annotation></semantics></math>. Then by Theorem <a href="#Thmthma14" title="Theorem N. ‣ 8.2. FOP perturbations on flow categories, multimodules, and homotopies ‣ 8. FOP Perturbations ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">N</span></a>, the existing FOP perturbations can be extended to an FOP perturbation <math id="S13.SS2.SSS2.p2.m12" class="ltx_Math" alttext="\mathring{\mathbb{H}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ℍ</mi><mo>̊</mo></mover><annotation encoding="application/x-tex">\mathring{\mathbb{H}}</annotation></semantics></math> on <math id="S13.SS2.SSS2.p2.m13" class="ltx_Math" alttext="\tilde{\mathbb{H}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ℍ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{H}}</annotation></semantics></math>. Then Proposition <a href="#S7.Thmthm32" title="Proposition 7.32. ‣ 7.4.2. Multimodules and homotopies ‣ 7.4. Algebraic structures with symmetry ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.32</span></a> implies that the chain maps are homotopic via a concrete homotopy from <math id="S13.SS2.SSS2.p2.m14" class="ltx_Math" alttext="\mathring{\mathbb{H}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ℍ</mi><mo>̊</mo></mover><annotation encoding="application/x-tex">\mathring{\mathbb{H}}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="S13.SS2.SSS3" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">13.2.3. </span>Concatenation and gluing</h5>

<div id="S13.SS2.SSS3.p1" class="ltx_para ltx_noindent">
<p id="S13.SS2.SSS3.p1.1" class="ltx_p">Now we consider the situation of concatenation.</p>
</div>
<div id="S13.Thmthm5" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S13.Thmthm5.2" class="ltx_text ltx_font_bold">Lemma 13.5</span></span><span id="S13.Thmthm5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S13.Thmthm5.p1" class="ltx_para ltx_noindent">
<p id="S13.Thmthm5.p1.1" class="ltx_p"><span id="S13.Thmthm5.p1.1.1" class="ltx_text ltx_font_italic">In Situation <a href="#Thmsituationg1" title="Situation Glue(i). ‣ 11.2. Homotopies from gluing ‣ 11. Homotopies of Multimodules ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Glue(i)</span></a>, fix an outercollaring width and a 1-parameter family of lateral lines in the domains. Suppose</span></p>
<table id="S13.EGx41" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S13.Ex17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S13.Ex17.m1" class="ltx_Math" alttext="\displaystyle\ {\mathcal{A}}_{{\mathbb{F}}_{1}}^{\Omega},\ldots,{\mathcal{A}}_{{\mathbb{F}}_{m}}^{\Omega},\ " display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mi>𝔽</mi><mn>1</mn></msub><mi mathvariant="normal">Ω</mi></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mi>𝔽</mi><mi>m</mi></msub><mi mathvariant="normal">Ω</mi></msubsup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ {\mathcal{A}}_{{\mathbb{F}}_{1}}^{\Omega},\ldots,{\mathcal{A}}_{{\mathbb{F}}_{m}}^{\Omega},\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S13.Ex17.m2" class="ltx_Math" alttext="\displaystyle\ {\mathcal{A}}_{{\mathbb{G}}_{1}}^{\Omega},\ldots,{\mathcal{A}}_{{\mathbb{G}}_{n}}^{\Omega},{\mathcal{A}}_{{\mathbb{G}}^{\prime}}^{\Omega}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mi>𝔾</mi><mn>1</mn></msub><mi mathvariant="normal">Ω</mi></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mi>𝔾</mi><mi>n</mi></msub><mi mathvariant="normal">Ω</mi></msubsup><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msup><mi>𝔾</mi><mo>′</mo></msup><mi mathvariant="normal">Ω</mi></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle\ {\mathcal{A}}_{{\mathbb{G}}_{1}}^{\Omega},\ldots,{\mathcal{A}}_{{\mathbb{G}}_{n}}^{\Omega},{\mathcal{A}}_{{\mathbb{G}}^{\prime}}^{\Omega}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.Thmthm5.p1.2" class="ltx_p"><span id="S13.Thmthm5.p1.2.1" class="ltx_text ltx_font_italic">are integral actions on the involved flow categories which are compatible with respect to <math id="S13.Thmthm5.p1.m1" class="ltx_Math" alttext="{\mathbb{X}}" display="inline" intent=":literal"><semantics><mi>𝕏</mi><annotation encoding="application/x-tex">{\mathbb{X}}</annotation></semantics></math>, <math id="S13.Thmthm5.p1.m2" class="ltx_Math" alttext="{\mathbb{Y}}" display="inline" intent=":literal"><semantics><mi>𝕐</mi><annotation encoding="application/x-tex">{\mathbb{Y}}</annotation></semantics></math>, <math id="S13.Thmthm5.p1.m3" class="ltx_Math" alttext="{\mathbb{M}}" display="inline" intent=":literal"><semantics><mi>𝕄</mi><annotation encoding="application/x-tex">{\mathbb{M}}</annotation></semantics></math>, and the homotopy <math id="S13.Thmthm5.p1.m4" class="ltx_Math" alttext="{\mathbb{H}}" display="inline" intent=":literal"><semantics><mi>ℍ</mi><annotation encoding="application/x-tex">{\mathbb{H}}</annotation></semantics></math>. Subject to these choices, let</span></p>
<table id="S13.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex18.m1" class="ltx_Math" alttext="CF(H_{1},J_{1},\Xi_{1}),\ldots,CF(H_{m},J_{m},\Xi_{m})" display="block" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>1</mn></msub><mo>,</mo><msub><mi>J</mi><mn>1</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mi>m</mi></msub><mo>,</mo><msub><mi>J</mi><mi>m</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">CF(H_{1},J_{1},\Xi_{1}),\ldots,CF(H_{m},J_{m},\Xi_{m})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.Thmthm5.p1.3" class="ltx_p"><span id="S13.Thmthm5.p1.3.1" class="ltx_text ltx_font_italic">and</span></p>
<table id="S13.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex19.m1" class="ltx_Math" alttext="CF(G_{1},I_{1},\Lambda_{1}),\ldots,CF(G_{n},I_{n},\Lambda_{n}),CF(G^{\prime},I^{\prime},\Lambda^{\prime})" display="block" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mn>1</mn></msub><mo>,</mo><msub><mi>I</mi><mn>1</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Λ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>n</mi></msub><mo>,</mo><msub><mi>I</mi><mi>n</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Λ</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>G</mi><mo>′</mo></msup><mo>,</mo><msup><mi>I</mi><mo>′</mo></msup><mo>,</mo><msup><mi mathvariant="normal">Λ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">CF(G_{1},I_{1},\Lambda_{1}),\ldots,CF(G_{n},I_{n},\Lambda_{n}),CF(G^{\prime},I^{\prime},\Lambda^{\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.Thmthm5.p1.4" class="ltx_p"><span id="S13.Thmthm5.p1.4.1" class="ltx_text ltx_font_italic">be Floer chain complexes provided by Theorem <a href="#Thmthma1" title="Theorem A (Floer chain complex). ‣ 1.1.1. Floer complexes and Floer homology ‣ 1.1. Main results on Floer complexes ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A</span></a>. Let</span></p>
<table id="S13.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex20.m1" class="ltx_Math" alttext="\Phi^{{\mathbb{X}}}:\bigotimes_{1\leq j\leq m}CF_{*}(H_{j},J_{j},\Xi_{j})\to CF_{*}(G_{i},I_{i},\Lambda_{i})," display="block" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">Φ</mi><mi>𝕏</mi></msup><mo lspace="0.278em" rspace="0.111em">:</mo><mrow><mrow><munder><mo movablelimits="false">⨂</mo><mrow><mn>1</mn><mo>≤</mo><mi>j</mi><mo>≤</mo><mi>m</mi></mrow></munder><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mi>j</mi></msub><mo>,</mo><msub><mi>J</mi><mi>j</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>i</mi></msub><mo>,</mo><msub><mi>I</mi><mi>i</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Λ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\Phi^{{\mathbb{X}}}:\bigotimes_{1\leq j\leq m}CF_{*}(H_{j},J_{j},\Xi_{j})\to CF_{*}(G_{i},I_{i},\Lambda_{i}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="S13.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex21.m1" class="ltx_Math" alttext="\Phi^{\mathbb{Y}}:\bigotimes_{1\leq l\leq n}CF(G_{l},I_{l},\Lambda_{l})\to CF(G^{\prime},I^{\prime},\Lambda^{\prime})," display="block" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">Φ</mi><mi>𝕐</mi></msup><mo lspace="0.278em" rspace="0.111em">:</mo><mrow><mrow><munder><mo movablelimits="false">⨂</mo><mrow><mn>1</mn><mo>≤</mo><mi>l</mi><mo>≤</mo><mi>n</mi></mrow></munder><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>l</mi></msub><mo>,</mo><msub><mi>I</mi><mi>l</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Λ</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>G</mi><mo>′</mo></msup><mo>,</mo><msup><mi>I</mi><mo>′</mo></msup><mo>,</mo><msup><mi mathvariant="normal">Λ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\Phi^{\mathbb{Y}}:\bigotimes_{1\leq l\leq n}CF(G_{l},I_{l},\Lambda_{l})\to CF(G^{\prime},I^{\prime},\Lambda^{\prime}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.Thmthm5.p1.5" class="ltx_p"><span id="S13.Thmthm5.p1.5.1" class="ltx_text ltx_font_italic">and</span></p>
<table id="S13.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex22.m1" class="ltx_Math" alttext="\Phi^{{\mathbb{M}}}:\bigotimes_{l&lt;i}CF(G_{l},I_{l},\Lambda_{l})\otimes\bigotimes_{1\leq j\leq m}CF(H_{j},J_{j},\Xi_{j})\otimes\bigotimes_{l&gt;i}CF(G_{l},I_{l},\Lambda_{l})\to CF(G^{\prime},I^{\prime},\Lambda^{\prime})" display="block" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><mi>𝕄</mi></msup><mo lspace="0.278em" rspace="0.111em">:</mo><mrow><mrow><munder><mo movablelimits="false">⨂</mo><mrow><mi>l</mi><mo>&lt;</mo><mi>i</mi></mrow></munder><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>l</mi></msub><mo>,</mo><msub><mi>I</mi><mi>l</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Λ</mi><mi>l</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">⊗</mo><mrow><munder><mo movablelimits="false">⨂</mo><mrow><mn>1</mn><mo>≤</mo><mi>j</mi><mo>≤</mo><mi>m</mi></mrow></munder><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mi>j</mi></msub><mo>,</mo><msub><mi>J</mi><mi>j</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mi>j</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">⊗</mo><mrow><munder><mo movablelimits="false">⨂</mo><mrow><mi>l</mi><mo>&gt;</mo><mi>i</mi></mrow></munder><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>l</mi></msub><mo>,</mo><msub><mi>I</mi><mi>l</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Λ</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>G</mi><mo>′</mo></msup><mo>,</mo><msup><mi>I</mi><mo>′</mo></msup><mo>,</mo><msup><mi mathvariant="normal">Λ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Phi^{{\mathbb{M}}}:\bigotimes_{l&lt;i}CF(G_{l},I_{l},\Lambda_{l})\otimes\bigotimes_{1\leq j\leq m}CF(H_{j},J_{j},\Xi_{j})\otimes\bigotimes_{l&gt;i}CF(G_{l},I_{l},\Lambda_{l})\to CF(G^{\prime},I^{\prime},\Lambda^{\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.Thmthm5.p1.6" class="ltx_p"><span id="S13.Thmthm5.p1.6.1" class="ltx_text ltx_font_italic">be chain maps provided by the general construction of Floer chain maps. Then the last chain map is homotopic to the composition</span></p>
<table id="S13.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex23.m1" class="ltx_Math" alttext="(y_{1},\cdots,y_{i-1},x_{1},\ldots,x_{m},y_{i+1},\ldots,y_{n})\mapsto\Phi^{{\mathbb{Y}}}(y_{1},\ldots,y_{i-1},\Phi^{\mathbb{X}}(x_{1},\ldots,x_{m}),y_{i+1},\ldots,y_{n})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>y</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mi>m</mi></msub><mo>,</mo><msub><mi>y</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>y</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">↦</mo><mrow><msup><mi mathvariant="normal">Φ</mi><mi>𝕐</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>y</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><mrow><msup><mi mathvariant="normal">Φ</mi><mi>𝕏</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>y</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>y</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(y_{1},\cdots,y_{i-1},x_{1},\ldots,x_{m},y_{i+1},\ldots,y_{n})\mapsto\Phi^{{\mathbb{Y}}}(y_{1},\ldots,y_{i-1},\Phi^{\mathbb{X}}(x_{1},\ldots,x_{m}),y_{i+1},\ldots,y_{n}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S13.SS2.SSS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S13.SS2.SSS3.p2" class="ltx_para">
<p id="S13.SS2.SSS3.p2.1" class="ltx_p"><span id="S13.SS2.SSS3.p2.1.1" class="ltx_text">Subject to the integral actions and outercollaring widths, the construction of the Floer chain complexes depends on the AMS lifts <math id="S13.SS2.SSS3.p2.m1" class="ltx_Math" alttext="\tilde{\mathbb{F}}_{1},\ldots,\tilde{\mathbb{F}}_{m}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">\tilde{\mathbb{F}}_{1},\ldots,\tilde{\mathbb{F}}_{m}</annotation></semantics></math> and <math id="S13.SS2.SSS3.p2.m2" class="ltx_Math" alttext="\tilde{\mathbb{G}}_{1},\ldots,\tilde{\mathbb{G}}_{n},\tilde{\mathbb{G}}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>𝔾</mi><mo>~</mo></mover><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mover accent="true"><mi>𝔾</mi><mo>~</mo></mover><mi>n</mi></msub><mo>,</mo><msup><mover accent="true"><mi>𝔾</mi><mo>~</mo></mover><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">\tilde{\mathbb{G}}_{1},\ldots,\tilde{\mathbb{G}}_{n},\tilde{\mathbb{G}}^{\prime}</annotation></semantics></math> and FOP perturbations <math id="S13.SS2.SSS3.p2.m3" class="ltx_Math" alttext="\mathring{\mathbb{F}}_{1},\ldots,\mathring{\mathbb{F}}_{m}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">\mathring{\mathbb{F}}_{1},\ldots,\mathring{\mathbb{F}}_{m}</annotation></semantics></math> and <math id="S13.SS2.SSS3.p2.m4" class="ltx_Math" alttext="\mathring{\mathbb{G}}_{1},\ldots,\mathring{\mathbb{G}}_{n},\mathring{\mathbb{G}}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>𝔾</mi><mo>̊</mo></mover><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mover accent="true"><mi>𝔾</mi><mo>̊</mo></mover><mi>n</mi></msub><mo>,</mo><msup><mover accent="true"><mi>𝔾</mi><mo>̊</mo></mover><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">\mathring{\mathbb{G}}_{1},\ldots,\mathring{\mathbb{G}}_{n},\mathring{\mathbb{G}}^{\prime}</annotation></semantics></math>. The chain maps <math id="S13.SS2.SSS3.p2.m5" class="ltx_Math" alttext="\Phi^{\mathbb{X}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mi>𝕏</mi></msup><annotation encoding="application/x-tex">\Phi^{\mathbb{X}}</annotation></semantics></math>, <math id="S13.SS2.SSS3.p2.m6" class="ltx_Math" alttext="\Phi^{\mathbb{Y}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mi>𝕐</mi></msup><annotation encoding="application/x-tex">\Phi^{\mathbb{Y}}</annotation></semantics></math>, and <math id="S13.SS2.SSS3.p2.m7" class="ltx_Math" alttext="\Phi^{\mathbb{M}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mi>𝕄</mi></msup><annotation encoding="application/x-tex">\Phi^{\mathbb{M}}</annotation></semantics></math> also depend on corresponding AMS lifts and FOP perturbations. One can also choose concatenations <math id="S13.SS2.SSS3.p2.m8" class="ltx_Math" alttext="\tilde{\mathbb{X}}\circ_{i}\tilde{\mathbb{Y}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝕏</mi><mo>~</mo></mover><msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>i</mi></msub><mover accent="true"><mi>𝕐</mi><mo>~</mo></mover></mrow><annotation encoding="application/x-tex">\tilde{\mathbb{X}}\circ_{i}\tilde{\mathbb{Y}}</annotation></semantics></math> and <math id="S13.SS2.SSS3.p2.m9" class="ltx_Math" alttext="\mathring{\mathbb{X}}\circ_{i}\mathring{\mathbb{Y}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝕏</mi><mo>̊</mo></mover><msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>i</mi></msub><mover accent="true"><mi>𝕐</mi><mo>̊</mo></mover></mrow><annotation encoding="application/x-tex">\mathring{\mathbb{X}}\circ_{i}\mathring{\mathbb{Y}}</annotation></semantics></math> (provided by Theorem <a href="#S12.Thmthm4" title="Theorem 12.4. ‣ 12.2. Multimodules and homotopies ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12.4</span></a> and Proposition <a href="#S8.Thmthm6" title="Proposition 8.6. ‣ 8.3. FOP perturbation and multimodule concatenations ‣ 8. FOP Perturbations ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8.6</span></a>).
Then by Theorem <a href="#Thmthma18" title="Theorem R. ‣ 12.2. Multimodules and homotopies ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">R</span></a>, there exists a lift <math id="S13.SS2.SSS3.p2.m10" class="ltx_Math" alttext="\tilde{\mathbb{H}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ℍ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{H}}</annotation></semantics></math> of the outercollaring of <math id="S13.SS2.SSS3.p2.m11" class="ltx_Math" alttext="{\mathbb{H}}" display="inline" intent=":literal"><semantics><mi>ℍ</mi><annotation encoding="application/x-tex">{\mathbb{H}}</annotation></semantics></math> as a homotopy from <math id="S13.SS2.SSS3.p2.m12" class="ltx_Math" alttext="\tilde{\mathbb{X}}\circ_{i}\tilde{\mathbb{Y}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝕏</mi><mo>~</mo></mover><msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>i</mi></msub><mover accent="true"><mi>𝕐</mi><mo>~</mo></mover></mrow><annotation encoding="application/x-tex">\tilde{\mathbb{X}}\circ_{i}\tilde{\mathbb{Y}}</annotation></semantics></math> to <math id="S13.SS2.SSS3.p2.m13" class="ltx_Math" alttext="\tilde{\mathbb{M}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝕄</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{M}}</annotation></semantics></math>. By Theorem <a href="#Thmthma14" title="Theorem N. ‣ 8.2. FOP perturbations on flow categories, multimodules, and homotopies ‣ 8. FOP Perturbations ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">N</span></a>, one can find an FOP perturbation <math id="S13.SS2.SSS3.p2.m14" class="ltx_Math" alttext="\mathring{\mathbb{H}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ℍ</mi><mo>̊</mo></mover><annotation encoding="application/x-tex">\mathring{\mathbb{H}}</annotation></semantics></math> on <math id="S13.SS2.SSS3.p2.m15" class="ltx_Math" alttext="\tilde{\mathbb{H}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ℍ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{H}}</annotation></semantics></math> as a homotopy from <math id="S13.SS2.SSS3.p2.m16" class="ltx_Math" alttext="\tilde{\mathbb{X}}\circ\tilde{\mathbb{Y}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>𝕏</mi><mo>~</mo></mover><mo lspace="0.222em" rspace="0.222em">∘</mo><mover accent="true"><mi>𝕐</mi><mo>~</mo></mover></mrow><annotation encoding="application/x-tex">\tilde{\mathbb{X}}\circ\tilde{\mathbb{Y}}</annotation></semantics></math> to <math id="S13.SS2.SSS3.p2.m17" class="ltx_Math" alttext="\tilde{\mathbb{M}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝕄</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{M}}</annotation></semantics></math>. Then one obtains the desired chain homotopy.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="S13.SS3" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">13.3. </span>Proof of Theorem <a href="#Thmthma2" title="Theorem B (Continuation Map). ‣ 1.1.1. Floer complexes and Floer homology ‣ 1.1. Main results on Floer complexes ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B</span></a></h4>

<div id="S13.SS3.p1" class="ltx_para ltx_noindent">
<p id="S13.SS3.p1.1" class="ltx_p">Assume we are in Situation <a href="#Thmsituationf1" title="Situation Flow(i). ‣ 9.2. Floer flow category ‣ 9. Geometric Flow Categories ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Flow(i)</span></a>. Above, we have defined the Floer chain complex</p>
<table id="S13.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex24.m1" class="ltx_Math" alttext="CF_{*}(H,J,\Xi)" display="block" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>J</mi><mo>,</mo><mi mathvariant="normal">Ξ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF_{*}(H,J,\Xi)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.SS3.p1.2" class="ltx_p">which appears to depend on the outercollaring width, the integral action, choices made for constructing the AMS lift <math id="S13.SS3.p1.m1" class="ltx_Math" alttext="\tilde{\mathbb{F}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{F}}</annotation></semantics></math>, and the FOP perturbation <math id="S13.SS3.p1.m2" class="ltx_Math" alttext="\mathring{\mathbb{F}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><annotation encoding="application/x-tex">\mathring{\mathbb{F}}</annotation></semantics></math>. We have already proved (see Lemma <a href="#S13.Thmthm1" title="Lemma 13.1. ‣ 13.1. Proof of Theorem ‣ 13. Proof of the Main Theorems ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13.1</span></a>) that the chain homotopy type only depends on <math id="S13.SS3.p1.m3" class="ltx_Math" alttext="(H,J)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>J</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(H,J)</annotation></semantics></math>, but not on the system of choices <math id="S13.SS3.p1.m4" class="ltx_Math" alttext="\Xi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ξ</mi><annotation encoding="application/x-tex">\Xi</annotation></semantics></math>. It remains to construct the continuation map.</p>
</div>
<section id="S13.SS3.SSS1" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">13.3.1. </span>Definition of the continuation map</h5>

<div id="S13.SS3.SSS1.p1" class="ltx_para ltx_noindent">
<p id="S13.SS3.SSS1.p1.1" class="ltx_p">Let <math id="S13.SS3.SSS1.p1.m1" class="ltx_Math" alttext="{\mathbb{F}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝔽</mi><mo>′</mo></msup><annotation encoding="application/x-tex">{\mathbb{F}}^{\prime}</annotation></semantics></math> be another Floer flow category associated to another pair <math id="S13.SS3.SSS1.p1.m2" class="ltx_Math" alttext="(H^{\prime},J^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mo>′</mo></msup><mo>,</mo><msup><mi>J</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(H^{\prime},J^{\prime})</annotation></semantics></math>. Choose a 1-parameter family of Floer data interpolating between <math id="S13.SS3.SSS1.p1.m3" class="ltx_Math" alttext="(H,J)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>J</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(H,J)</annotation></semantics></math> and <math id="S13.SS3.SSS1.p1.m4" class="ltx_Math" alttext="(H^{\prime},J^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mo>′</mo></msup><mo>,</mo><msup><mi>J</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(H^{\prime},J^{\prime})</annotation></semantics></math>, resulting in a bimodule <math id="S13.SS3.SSS1.p1.m5" class="ltx_Math" alttext="{\mathbb{B}}" display="inline" intent=":literal"><semantics><mi>𝔹</mi><annotation encoding="application/x-tex">{\mathbb{B}}</annotation></semantics></math> from <math id="S13.SS3.SSS1.p1.m6" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> to <math id="S13.SS3.SSS1.p1.m7" class="ltx_Math" alttext="{\mathbb{F}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝔽</mi><mo>′</mo></msup><annotation encoding="application/x-tex">{\mathbb{F}}^{\prime}</annotation></semantics></math>. Then we are in a special case of Situation <a href="#Thmsituationm1" title="Situation Module(i). ‣ 10.2. Multimodules from smooth domains ‣ 10. Geometric Multimodules ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Module(i)</span></a>. Then, using the above construction, upon choosing an outercollaring width and a pair of integral actions on <math id="S13.SS3.SSS1.p1.m8" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> and <math id="S13.SS3.SSS1.p1.m9" class="ltx_Math" alttext="{\mathbb{F}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝔽</mi><mo>′</mo></msup><annotation encoding="application/x-tex">{\mathbb{F}}^{\prime}</annotation></semantics></math> compatible with respect to <math id="S13.SS3.SSS1.p1.m10" class="ltx_Math" alttext="{\mathbb{B}}" display="inline" intent=":literal"><semantics><mi>𝔹</mi><annotation encoding="application/x-tex">{\mathbb{B}}</annotation></semantics></math>, after AMS constructions of <math id="S13.SS3.SSS1.p1.m11" class="ltx_Math" alttext="\tilde{\mathbb{F}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{F}}</annotation></semantics></math>, <math id="S13.SS3.SSS1.p1.m12" class="ltx_Math" alttext="\tilde{\mathbb{F}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mo>′</mo></msup><annotation encoding="application/x-tex">\tilde{\mathbb{F}}^{\prime}</annotation></semantics></math>,<math id="S13.SS3.SSS1.p1.m13" class="ltx_Math" alttext="\tilde{\mathbb{B}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝔹</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{B}}</annotation></semantics></math>, and choosing FOP perturbations <math id="S13.SS3.SSS1.p1.m14" class="ltx_Math" alttext="\mathring{\mathbb{F}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><annotation encoding="application/x-tex">\mathring{\mathbb{F}}</annotation></semantics></math>, <math id="S13.SS3.SSS1.p1.m15" class="ltx_Math" alttext="\mathring{\mathbb{F}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><mo>′</mo></msup><annotation encoding="application/x-tex">\mathring{\mathbb{F}}^{\prime}</annotation></semantics></math>, and <math id="S13.SS3.SSS1.p1.m16" class="ltx_Math" alttext="\mathring{\mathbb{B}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝔹</mi><mo>̊</mo></mover><annotation encoding="application/x-tex">\mathring{\mathbb{B}}</annotation></semantics></math>, one obtains a chain map</p>
<table id="S13.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex25.m1" class="ltx_Math" alttext="\Phi^{\mathbb{B}}(\Theta):CF_{*}(H,J,\Xi)\to CF_{*}(H^{\prime},J^{\prime},\Xi^{\prime})" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">Φ</mi><mi>𝔹</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>J</mi><mo>,</mo><mi mathvariant="normal">Ξ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mo>′</mo></msup><mo>,</mo><msup><mi>J</mi><mo>′</mo></msup><mo>,</mo><msup><mi mathvariant="normal">Ξ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Phi^{\mathbb{B}}(\Theta):CF_{*}(H,J,\Xi)\to CF_{*}(H^{\prime},J^{\prime},\Xi^{\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.SS3.SSS1.p1.2" class="ltx_p">whose homotopy class only depends on the bimodule <math id="S13.SS3.SSS1.p1.m17" class="ltx_Math" alttext="{\mathbb{B}}" display="inline" intent=":literal"><semantics><mi>𝔹</mi><annotation encoding="application/x-tex">{\mathbb{B}}</annotation></semantics></math> and the choices of the integral actions (see Lemma <a href="#S13.Thmthm2" title="Lemma 13.2. ‣ 13.2.1. Chain maps associated to smooth Floer domains ‣ 13.2. General construction of chain maps and homotopics ‣ 13. Proof of the Main Theorems ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13.2</span></a>).</p>
</div>
</section>
<section id="S13.SS3.SSS2" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">13.3.2. </span>Independence of the integral actions</h5>

<div id="S13.SS3.SSS2.p1" class="ltx_para ltx_noindent">
<p id="S13.SS3.SSS2.p1.1" class="ltx_p">We first would like to reduce the dependence to <math id="S13.SS3.SSS2.p1.m1" class="ltx_Math" alttext="{\mathbb{B}}" display="inline" intent=":literal"><semantics><mi>𝔹</mi><annotation encoding="application/x-tex">{\mathbb{B}}</annotation></semantics></math> but not the integral actions. Indeed, if <math id="S13.SS3.SSS2.p1.m2" class="ltx_Math" alttext="{\mathcal{A}}_{{\mathbb{F}}}^{\Omega_{(s)}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>𝔽</mi><msub><mi mathvariant="normal">Ω</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub></msubsup><annotation encoding="application/x-tex">{\mathcal{A}}_{{\mathbb{F}}}^{\Omega_{(s)}}</annotation></semantics></math>, <math id="S13.SS3.SSS2.p1.m3" class="ltx_Math" alttext="{\mathcal{A}}_{{\mathbb{F}}^{\prime}}^{\Omega_{(s)}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msup><mi>𝔽</mi><mo>′</mo></msup><msub><mi mathvariant="normal">Ω</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></msub></msubsup><annotation encoding="application/x-tex">{\mathcal{A}}_{{\mathbb{F}}^{\prime}}^{\Omega_{(s)}}</annotation></semantics></math>, <math id="S13.SS3.SSS2.p1.m4" class="ltx_Math" alttext="s=0,1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">s=0,1</annotation></semantics></math> are two compatible pairs of integral actions, then by Lemma <a href="#S13.Thmthm3" title="Lemma 13.3. ‣ 13.2.1. Chain maps associated to smooth Floer domains ‣ 13.2. General construction of chain maps and homotopics ‣ 13. Proof of the Main Theorems ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13.3</span></a>, the diagram</p>
<table id="S13.Ex26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S13.Ex26.m1.pic1" class="ltx_picture ltx_markedasmath" height="85.83" overflow="visible" style="vertical-align:-65.06616221072022px" version="1.1" viewBox="51.41 65.07 290.45 85.83" width="290.45"><g transform="matrix(1 0 0 -1 51.414053750529696 85.82926330946452) translate(0,3.46) translate(51.41,0)"><g transform="translate(-51.41,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:6.83em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.36em;font-size:10pt;" height="15.3" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="94.53"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S13.Ex26.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{CF_{*}(H,J,\Xi_{(0)})\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>J</mi><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{CF_{*}(H,J,\Xi_{(0)})\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 51.41407486411634 -0.27673578005007266 L 51.41407486411634 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(62.08,0) translate(0,10.38) translate(4.15,0) translate(0,-2.65)"><foreignObject style="--ltx-fo-width:3.26em;--ltx-fo-height:0.64em;--ltx-fo-depth:0.26em;font-size:10pt;" height="12.46" overflow="visible" transform="matrix(1 0 0 -1 0 8.88)" width="45.1"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S13.Ex26.m1.pic1.m2" class="ltx_Math" alttext="\scriptstyle{\Phi^{{\mathbb{B}}}(\Theta_{(0)})}" display="inline" intent=":literal"><semantics><mrow><msup><mi mathsize="0.700em" mathvariant="normal">Φ</mi><mi mathsize="0.710em">𝔹</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em" mathvariant="normal">Θ</mi><mrow><mo maxsize="0.710em" minsize="0.710em">(</mo><mn mathsize="0.710em">0</mn><mo maxsize="0.710em" minsize="0.710em">)</mo></mrow></msub><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\scriptstyle{\Phi^{{\mathbb{B}}}(\Theta_{(0)})}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(126.14,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 51.41407486411634 -0.27673578005007266 L 126.13385449772771 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 126.13385449772771 -0.27673578005007266 L 126.13385449772771 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -12.530174693478017 L 0.27673578005007266 -12.530174693478017" fill="none" stroke="#000000"></path><g transform="translate(-34.4,0) translate(0,-22.15) translate(4.15,0) translate(0,-2.65)"><foreignObject style="--ltx-fo-width:1.89em;--ltx-fo-height:0.64em;--ltx-fo-depth:0.26em;font-size:10pt;" height="12.46" overflow="visible" transform="matrix(1 0 0 -1 0 8.88)" width="26.1"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S13.Ex26.m1.pic1.m3" class="ltx_Math" alttext="\scriptstyle{\Psi_{(01)}^{\mathbb{F}}}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.700em" mathvariant="normal">Ψ</mi><mrow><mo maxsize="0.710em" minsize="0.710em">(</mo><mn mathsize="0.710em">01</mn><mo maxsize="0.710em" minsize="0.710em">)</mo></mrow><mi mathsize="0.710em">𝔽</mi></msubsup><annotation encoding="application/x-tex">\scriptstyle{\Psi_{(01)}^{\mathbb{F}}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(0,-33.23)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.23346100127992 L 0.27673578005007266 -12.530174693478017" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.23346100127992 L 0.27673578005007266 -33.23346100127992" fill="none" stroke="#000000"></path><g transform="translate(126.14,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:7.56em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.36em;font-size:10pt;" height="15.32" overflow="visible" transform="matrix(1 0 0 -1 0 10.4)" width="104.6"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S13.Ex26.m1.pic1.m5" class="ltx_Math" alttext="\textstyle{CF_{*}(H^{\prime},J^{\prime},\Xi_{(0)}^{\prime})}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mo>′</mo></msup><mo>,</mo><msup><mi>J</mi><mo>′</mo></msup><mo>,</mo><msubsup><mi mathvariant="normal">Ξ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{CF_{*}(H^{\prime},J^{\prime},\Xi_{(0)}^{\prime})}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(-51.41,0) translate(0,-44.3) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:6.83em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.36em;font-size:10pt;" height="15.3" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="94.53"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S13.Ex26.m1.pic1.m6" class="ltx_Math" alttext="\textstyle{CF_{*}(H,J,\Xi_{(1)})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>J</mi><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{CF_{*}(H,J,\Xi_{(1)})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 51.41407486411634 -44.579796892025996 L 51.41407486411634 -44.026325331925854" fill="none" stroke="#000000"></path><g transform="translate(62.08,0) translate(0,-54.69) translate(4.15,0) translate(0,-2.65)"><foreignObject style="--ltx-fo-width:3.26em;--ltx-fo-height:0.64em;--ltx-fo-depth:0.26em;font-size:10pt;" height="12.46" overflow="visible" transform="matrix(1 0 0 -1 0 8.88)" width="45.1"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S13.Ex26.m1.pic1.m7" class="ltx_Math" alttext="\scriptstyle{\Phi^{{\mathbb{B}}}(\Theta_{(1)})}" display="inline" intent=":literal"><semantics><mrow><msup><mi mathsize="0.700em" mathvariant="normal">Φ</mi><mi mathsize="0.710em">𝔹</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><msub><mi mathsize="0.700em" mathvariant="normal">Θ</mi><mrow><mo maxsize="0.710em" minsize="0.710em">(</mo><mn mathsize="0.710em">1</mn><mo maxsize="0.710em" minsize="0.710em">)</mo></mrow></msub><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\scriptstyle{\Phi^{{\mathbb{B}}}(\Theta_{(1)})}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(126.14,0) translate(0,-44.3)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 51.41407486411634 -44.579796892025996 L 126.13385449772771 -44.026325331925854" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 126.13385449772771 -44.579796892025996 L 126.13385449772771 -44.026325331925854" fill="none" stroke="#000000"></path><g transform="translate(126.14,0) translate(0,-44.3) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:7.56em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.36em;font-size:10pt;" height="15.32" overflow="visible" transform="matrix(1 0 0 -1 0 10.4)" width="104.6"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S13.Ex26.m1.pic1.m9" class="ltx_Math" alttext="\textstyle{CF_{*}(H^{\prime},J^{\prime},\Xi_{(1)}^{\prime})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mo>′</mo></msup><mo>,</mo><msup><mi>J</mi><mo>′</mo></msup><mo>,</mo><msubsup><mi mathvariant="normal">Ξ</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{CF_{*}(H^{\prime},J^{\prime},\Xi_{(1)}^{\prime})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 182.30631949579268 -33.208800332088 L 182.85979105589283 -33.208800332088" fill="none" stroke="#000000"></path><g transform="translate(182.59,0) translate(0,-22.15) translate(4.15,0) translate(0,-3.22)"><foreignObject style="--ltx-fo-width:1.89em;--ltx-fo-height:0.72em;--ltx-fo-depth:0.26em;font-size:10pt;" height="13.6" overflow="visible" transform="matrix(1 0 0 -1 0 10.02)" width="26.1"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S13.Ex26.m1.pic1.m10" class="ltx_Math" alttext="\scriptstyle{\Psi_{(10)}^{{\mathbb{F}}^{\prime}}}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.700em" mathvariant="normal">Ψ</mi><mrow><mo maxsize="0.710em" minsize="0.710em">(</mo><mn mathsize="0.710em">10</mn><mo maxsize="0.710em" minsize="0.710em">)</mo></mrow><msup><mi mathsize="0.710em">𝔽</mi><mo>′</mo></msup></msubsup><annotation encoding="application/x-tex">\scriptstyle{\Psi_{(10)}^{{\mathbb{F}}^{\prime}}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(182.59,0) translate(0,-12.53)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -2.77 -6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 2.77 -6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 182.30631949579268 -33.208800332088 L 182.85979105589283 -12.530174693478017" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 182.30631949579268 -12.530174693478017 L 182.85979105589283 -12.530174693478017" fill="none" stroke="#000000"></path></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.SS3.SSS2.p1.2" class="ltx_p">commutes up to homotopy. Therefore, the homotopy class only depends on the bimodule <math id="S13.SS3.SSS2.p1.m5" class="ltx_Math" alttext="{\mathbb{B}}" display="inline" intent=":literal"><semantics><mi>𝔹</mi><annotation encoding="application/x-tex">{\mathbb{B}}</annotation></semantics></math>.</p>
</div>
</section>
<section id="S13.SS3.SSS3" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">13.3.3. </span>Independence of the interpolation of Floer data</h5>

<div id="S13.SS3.SSS3.p1" class="ltx_para ltx_noindent">
<p id="S13.SS3.SSS3.p1.1" class="ltx_p">Next we would like to prove the homotopy independence of the bimodule <math id="S13.SS3.SSS3.p1.m1" class="ltx_Math" alttext="{\mathbb{B}}" display="inline" intent=":literal"><semantics><mi>𝔹</mi><annotation encoding="application/x-tex">{\mathbb{B}}</annotation></semantics></math>. Suppose <math id="S13.SS3.SSS3.p1.m2" class="ltx_Math" alttext="{\mathbb{B}}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝔹</mi><mn>0</mn></msub><annotation encoding="application/x-tex">{\mathbb{B}}_{0}</annotation></semantics></math> and <math id="S13.SS3.SSS3.p1.m3" class="ltx_Math" alttext="{\mathbb{B}}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝔹</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\mathbb{B}}_{1}</annotation></semantics></math> are two such bimodules over <math id="S13.SS3.SSS3.p1.m4" class="ltx_Math" alttext="({\mathbb{F}};{\mathbb{F}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝔽</mi><mo>;</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}};{\mathbb{F}}^{\prime})</annotation></semantics></math>. Since <math id="S13.SS3.SSS3.p1.m5" class="ltx_Math" alttext="{\mathbb{B}}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝔹</mi><mn>0</mn></msub><annotation encoding="application/x-tex">{\mathbb{B}}_{0}</annotation></semantics></math> and <math id="S13.SS3.SSS3.p1.m6" class="ltx_Math" alttext="{\mathbb{B}}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝔹</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\mathbb{B}}_{1}</annotation></semantics></math> are both defined via varying Floer data, one can construct a homotopy <math id="S13.SS3.SSS3.p1.m7" class="ltx_Math" alttext="{\mathbb{H}}" display="inline" intent=":literal"><semantics><mi>ℍ</mi><annotation encoding="application/x-tex">{\mathbb{H}}</annotation></semantics></math> from <math id="S13.SS3.SSS3.p1.m8" class="ltx_Math" alttext="{\mathbb{B}}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝔹</mi><mn>0</mn></msub><annotation encoding="application/x-tex">{\mathbb{B}}_{0}</annotation></semantics></math> to <math id="S13.SS3.SSS3.p1.m9" class="ltx_Math" alttext="{\mathbb{B}}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝔹</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\mathbb{B}}_{1}</annotation></semantics></math>. Then by Proposition <a href="#S15.Thmthm4" title="Proposition 15.4. ‣ 15.1. Integral modification of topological energy ‣ 15. Relatively Smooth AMS lifts ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15.4</span></a>, one can find a pair of integral actions <math id="S13.SS3.SSS3.p1.m10" class="ltx_Math" alttext="{\mathcal{A}}_{{\mathbb{F}}}^{\Omega}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>𝔽</mi><mi mathvariant="normal">Ω</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{A}}_{{\mathbb{F}}}^{\Omega}</annotation></semantics></math>, <math id="S13.SS3.SSS3.p1.m11" class="ltx_Math" alttext="{\mathcal{A}}_{{\mathbb{F}}^{\prime}}^{\Omega}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msup><mi>𝔽</mi><mo>′</mo></msup><mi mathvariant="normal">Ω</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{A}}_{{\mathbb{F}}^{\prime}}^{\Omega}</annotation></semantics></math> compatible with respect to <math id="S13.SS3.SSS3.p1.m12" class="ltx_Math" alttext="{\mathbb{H}}" display="inline" intent=":literal"><semantics><mi>ℍ</mi><annotation encoding="application/x-tex">{\mathbb{H}}</annotation></semantics></math>. This leads to the setup of Lemma <a href="#S13.Thmthm4" title="Lemma 13.4. ‣ 13.2.2. Homotopy ‣ 13.2. General construction of chain maps and homotopics ‣ 13. Proof of the Main Theorems ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13.4</span></a>. Let</p>
<table id="S13.EGx42" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S13.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S13.Ex27.m1" class="ltx_Math" alttext="\displaystyle\ CF_{*}(H,J,\Xi),\ " display="inline" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>J</mi><mo>,</mo><mi mathvariant="normal">Ξ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ CF_{*}(H,J,\Xi),\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S13.Ex27.m2" class="ltx_Math" alttext="\displaystyle\ CF_{*}(H^{\prime},J^{\prime},\Xi^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mo>′</mo></msup><mo>,</mo><msup><mi>J</mi><mo>′</mo></msup><mo>,</mo><msup><mi mathvariant="normal">Ξ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ CF_{*}(H^{\prime},J^{\prime},\Xi^{\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.SS3.SSS3.p1.2" class="ltx_p">be Floer chain complexes constructed subject to these integral actions and let</p>
<table id="S13.Ex28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex28.m1" class="ltx_Math" alttext="\Phi^{{\mathbb{B}}_{0}}(\Theta_{0}),\ \Phi^{{\mathbb{B}}_{1}}(\Theta_{1}):CF_{*}(H,J,\Xi)\to CF_{*}(H^{\prime},J^{\prime},\Xi^{\prime})" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">Φ</mi><msub><mi>𝔹</mi><mn>0</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mrow><msup><mi mathvariant="normal">Φ</mi><msub><mi>𝔹</mi><mn>1</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mn>1</mn></msub><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>J</mi><mo>,</mo><mi mathvariant="normal">Ξ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mo>′</mo></msup><mo>,</mo><msup><mi>J</mi><mo>′</mo></msup><mo>,</mo><msup><mi mathvariant="normal">Ξ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Phi^{{\mathbb{B}}_{0}}(\Theta_{0}),\ \Phi^{{\mathbb{B}}_{1}}(\Theta_{1}):CF_{*}(H,J,\Xi)\to CF_{*}(H^{\prime},J^{\prime},\Xi^{\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.SS3.SSS3.p1.3" class="ltx_p">be continuation maps associated to these two bimodules constructed as above. Then by Lemma <a href="#S13.Thmthm4" title="Lemma 13.4. ‣ 13.2.2. Homotopy ‣ 13.2. General construction of chain maps and homotopics ‣ 13. Proof of the Main Theorems ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13.4</span></a>, the two continuation maps are homotopic. This proves that the continuation map does not depend on the bimodule either.</p>
</div>
</section>
<section id="S13.SS3.SSS4" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">13.3.4. </span>Composition of continuation maps</h5>

<div id="S13.SS3.SSS4.p1" class="ltx_para ltx_noindent">
<p id="S13.SS3.SSS4.p1.1" class="ltx_p">We prove that the composition of continuation maps is homotopic to another continuation map.</p>
</div>
<div id="S13.Thmthm6" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S13.Thmthm6.2" class="ltx_text ltx_font_bold">Proposition 13.6</span></span><span id="S13.Thmthm6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S13.Thmthm6.p1" class="ltx_para ltx_noindent">
<p id="S13.Thmthm6.p1.1" class="ltx_p"><span id="S13.Thmthm6.p1.1.1" class="ltx_text ltx_font_italic">Suppose <math id="S13.Thmthm6.p1.m1" class="ltx_Math" alttext="{\mathbb{F}}_{0},{\mathbb{F}}_{1},{\mathbb{F}}_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔽</mi><mn>0</mn></msub><mo>,</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝔽</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">{\mathbb{F}}_{0},{\mathbb{F}}_{1},{\mathbb{F}}_{2}</annotation></semantics></math> are Floer flow categories associated to three pairs <math id="S13.Thmthm6.p1.m2" class="ltx_Math" alttext="(H_{i},J_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mi>i</mi></msub><mo>,</mo><msub><mi>J</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(H_{i},J_{i})</annotation></semantics></math> for <math id="S13.Thmthm6.p1.m3" class="ltx_Math" alttext="i=0,1,2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">i=0,1,2</annotation></semantics></math>. Let <math id="S13.Thmthm6.p1.m4" class="ltx_Math" alttext="{\mathbb{B}}_{01}" display="inline" intent=":literal"><semantics><msub><mi>𝔹</mi><mn>01</mn></msub><annotation encoding="application/x-tex">{\mathbb{B}}_{01}</annotation></semantics></math> resp. <math id="S13.Thmthm6.p1.m5" class="ltx_Math" alttext="{\mathbb{B}}_{12}" display="inline" intent=":literal"><semantics><msub><mi>𝔹</mi><mn>12</mn></msub><annotation encoding="application/x-tex">{\mathbb{B}}_{12}</annotation></semantics></math> be a bimodule over <math id="S13.Thmthm6.p1.m6" class="ltx_Math" alttext="({\mathbb{F}}_{0};{\mathbb{F}}_{1})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mn>0</mn></msub><mo>;</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{0};{\mathbb{F}}_{1})</annotation></semantics></math> resp. over <math id="S13.Thmthm6.p1.m7" class="ltx_Math" alttext="({\mathbb{F}}_{1};{\mathbb{F}}_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo>;</mo><msub><mi>𝔽</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{1};{\mathbb{F}}_{2})</annotation></semantics></math> associated to Floer data <math id="S13.Thmthm6.p1.m8" class="ltx_Math" alttext="\sigma_{01}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mn>01</mn></msub><annotation encoding="application/x-tex">\sigma_{01}</annotation></semantics></math> resp. <math id="S13.Thmthm6.p1.m9" class="ltx_Math" alttext="\sigma_{12}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mn>12</mn></msub><annotation encoding="application/x-tex">\sigma_{12}</annotation></semantics></math> on the infinite cylinder. Let <math id="S13.Thmthm6.p1.m10" class="ltx_Math" alttext="{\mathbb{H}}" display="inline" intent=":literal"><semantics><mi>ℍ</mi><annotation encoding="application/x-tex">{\mathbb{H}}</annotation></semantics></math> be a homotopy associated to gluing <math id="S13.Thmthm6.p1.m11" class="ltx_Math" alttext="\sigma_{01}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mn>01</mn></msub><annotation encoding="application/x-tex">\sigma_{01}</annotation></semantics></math> and <math id="S13.Thmthm6.p1.m12" class="ltx_Math" alttext="\sigma_{12}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mn>12</mn></msub><annotation encoding="application/x-tex">\sigma_{12}</annotation></semantics></math>, as a homotopy from the composition <math id="S13.Thmthm6.p1.m13" class="ltx_Math" alttext="{\mathbb{B}}_{01}\circ{\mathbb{B}}_{12}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔹</mi><mn>01</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝔹</mi><mn>12</mn></msub></mrow><annotation encoding="application/x-tex">{\mathbb{B}}_{01}\circ{\mathbb{B}}_{12}</annotation></semantics></math> to a bimodule <math id="S13.Thmthm6.p1.m14" class="ltx_Math" alttext="{\mathbb{B}}_{02}" display="inline" intent=":literal"><semantics><msub><mi>𝔹</mi><mn>02</mn></msub><annotation encoding="application/x-tex">{\mathbb{B}}_{02}</annotation></semantics></math> over <math id="S13.Thmthm6.p1.m15" class="ltx_Math" alttext="({\mathbb{F}}_{0};{\mathbb{F}}_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mn>0</mn></msub><mo>;</mo><msub><mi>𝔽</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{0};{\mathbb{F}}_{2})</annotation></semantics></math> associated to a Floer datum <math id="S13.Thmthm6.p1.m16" class="ltx_Math" alttext="\sigma_{02}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mn>02</mn></msub><annotation encoding="application/x-tex">\sigma_{02}</annotation></semantics></math>. Then there exist continuation maps</span></p>
<table id="S13.Ex29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex29.m1" class="ltx_Math" alttext="\Phi^{{\mathbb{B}}_{01}}:CF_{*}(H_{0},J_{0},\Xi_{0})\to CF_{*}(H_{1},J_{1},\Xi_{1})" display="block" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><msub><mi>𝔹</mi><mn>01</mn></msub></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>0</mn></msub><mo>,</mo><msub><mi>J</mi><mn>0</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>1</mn></msub><mo>,</mo><msub><mi>J</mi><mn>1</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Phi^{{\mathbb{B}}_{01}}:CF_{*}(H_{0},J_{0},\Xi_{0})\to CF_{*}(H_{1},J_{1},\Xi_{1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="S13.Ex30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex30.m1" class="ltx_Math" alttext="\Phi^{{\mathbb{B}}_{12}}:CF_{*}(H_{1},J_{1},\Xi_{1})\to CF_{*}(H_{2},J_{2},\Xi_{2})" display="block" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><msub><mi>𝔹</mi><mn>12</mn></msub></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>1</mn></msub><mo>,</mo><msub><mi>J</mi><mn>1</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>2</mn></msub><mo>,</mo><msub><mi>J</mi><mn>2</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Phi^{{\mathbb{B}}_{12}}:CF_{*}(H_{1},J_{1},\Xi_{1})\to CF_{*}(H_{2},J_{2},\Xi_{2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.Thmthm6.p1.2" class="ltx_p"><span id="S13.Thmthm6.p1.2.1" class="ltx_text ltx_font_italic">and</span></p>
<table id="S13.Ex31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex31.m1" class="ltx_Math" alttext="\Phi^{\mathbb{B}_{02}}:CF_{*}(H_{0},J_{0},\Xi_{0})\to CF_{*}(H_{2},J_{2},\Xi_{2})" display="block" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><msub><mi>𝔹</mi><mn>02</mn></msub></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>0</mn></msub><mo>,</mo><msub><mi>J</mi><mn>0</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>2</mn></msub><mo>,</mo><msub><mi>J</mi><mn>2</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Phi^{\mathbb{B}_{02}}:CF_{*}(H_{0},J_{0},\Xi_{0})\to CF_{*}(H_{2},J_{2},\Xi_{2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.Thmthm6.p1.3" class="ltx_p"><span id="S13.Thmthm6.p1.3.1" class="ltx_text ltx_font_italic">such that the last one is homotopic to the composition <math id="S13.Thmthm6.p1.m17" class="ltx_Math" alttext="\Phi^{{\mathbb{B}}_{12}}\circ\Phi^{\mathbb{B}_{01}}" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><msub><mi>𝔹</mi><mn>12</mn></msub></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi mathvariant="normal">Φ</mi><msub><mi>𝔹</mi><mn>01</mn></msub></msup></mrow><annotation encoding="application/x-tex">\Phi^{{\mathbb{B}}_{12}}\circ\Phi^{\mathbb{B}_{01}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S13.SS3.SSS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S13.SS3.SSS4.p2" class="ltx_para">
<p id="S13.SS3.SSS4.p2.1" class="ltx_p"><span id="S13.SS3.SSS4.p2.1.1" class="ltx_text">By Proposition <a href="#S15.Thmthm4" title="Proposition 15.4. ‣ 15.1. Integral modification of topological energy ‣ 15. Relatively Smooth AMS lifts ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15.4</span></a>, we can choose integral actions on the three Floer categories which are compatible with respect to <math id="S13.SS3.SSS4.p2.m1" class="ltx_Math" alttext="{\mathbb{B}}_{01}" display="inline" intent=":literal"><semantics><msub><mi>𝔹</mi><mn>01</mn></msub><annotation encoding="application/x-tex">{\mathbb{B}}_{01}</annotation></semantics></math>, <math id="S13.SS3.SSS4.p2.m2" class="ltx_Math" alttext="{\mathbb{B}}_{12}" display="inline" intent=":literal"><semantics><msub><mi>𝔹</mi><mn>12</mn></msub><annotation encoding="application/x-tex">{\mathbb{B}}_{12}</annotation></semantics></math>, <math id="S13.SS3.SSS4.p2.m3" class="ltx_Math" alttext="{\mathbb{B}}_{02}" display="inline" intent=":literal"><semantics><msub><mi>𝔹</mi><mn>02</mn></msub><annotation encoding="application/x-tex">{\mathbb{B}}_{02}</annotation></semantics></math>, and the homotopy <math id="S13.SS3.SSS4.p2.m4" class="ltx_Math" alttext="{\mathbb{H}}" display="inline" intent=":literal"><semantics><mi>ℍ</mi><annotation encoding="application/x-tex">{\mathbb{H}}</annotation></semantics></math>. Then we are in the situation of Lemma <a href="#S13.Thmthm5" title="Lemma 13.5. ‣ 13.2.3. Concatenation and gluing ‣ 13.2. General construction of chain maps and homotopics ‣ 13. Proof of the Main Theorems ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13.5</span></a>, which implies the desired homotopy.
∎</span></p>
</div>
</div>
</section>
<section id="S13.SS3.SSS5" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">13.3.5. </span>Continuation maps are homotopy equivalences</h5>

<div id="S13.Thmthm7" class="ltx_theorem ltx_theorem_cor">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S13.Thmthm7.2" class="ltx_text ltx_font_bold">Corollary 13.7</span></span><span id="S13.Thmthm7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S13.Thmthm7.p1" class="ltx_para">
<p id="S13.Thmthm7.p1.1" class="ltx_p"><span id="S13.Thmthm7.p1.1.1" class="ltx_text ltx_font_italic">Any chain-level continuation map is a homotopy equivalence.</span></p>
</div>
</div>
<div id="S13.SS3.SSS5.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S13.SS3.SSS5.p1" class="ltx_para ltx_noindent">
<p id="S13.SS3.SSS5.p1.1" class="ltx_p"><span id="S13.SS3.SSS5.p1.1.1" class="ltx_text">Using the notations in Proposition <a href="#S13.Thmthm6" title="Proposition 13.6. ‣ 13.3.4. Composition of continuation maps ‣ 13.3. Proof of Theorem ‣ 13. Proof of the Main Theorems ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13.6</span></a>, take <math id="S13.SS3.SSS5.p1.m1" class="ltx_Math" alttext="{\mathbb{F}}_{2}={\mathbb{F}}_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔽</mi><mn>2</mn></msub><mo>=</mo><msub><mi>𝔽</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">{\mathbb{F}}_{2}={\mathbb{F}}_{0}</annotation></semantics></math> and denote <math id="S13.SS3.SSS5.p1.m2" class="ltx_Math" alttext="{\mathbb{B}}_{12}" display="inline" intent=":literal"><semantics><msub><mi>𝔹</mi><mn>12</mn></msub><annotation encoding="application/x-tex">{\mathbb{B}}_{12}</annotation></semantics></math> by <math id="S13.SS3.SSS5.p1.m3" class="ltx_Math" alttext="{\mathbb{B}}_{10}" display="inline" intent=":literal"><semantics><msub><mi>𝔹</mi><mn>10</mn></msub><annotation encoding="application/x-tex">{\mathbb{B}}_{10}</annotation></semantics></math>. Let <math id="S13.SS3.SSS5.p1.m4" class="ltx_Math" alttext="{\mathbb{B}}_{02}" display="inline" intent=":literal"><semantics><msub><mi>𝔹</mi><mn>02</mn></msub><annotation encoding="application/x-tex">{\mathbb{B}}_{02}</annotation></semantics></math> be the diagonal bimodule <math id="S13.SS3.SSS5.p1.m5" class="ltx_Math" alttext="\mathbb{\Delta}^{\mathbb{F}_{0}\mathbb{F}_{0}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mrow><msub><mi>𝔽</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔽</mi><mn>0</mn></msub></mrow></msup><annotation encoding="application/x-tex">\mathbb{\Delta}^{\mathbb{F}_{0}\mathbb{F}_{0}}</annotation></semantics></math> associated to the trivial Floer datum on the cylinder. Choose a homotopy <math id="S13.SS3.SSS5.p1.m6" class="ltx_Math" alttext="{\mathbb{H}}" display="inline" intent=":literal"><semantics><mi>ℍ</mi><annotation encoding="application/x-tex">{\mathbb{H}}</annotation></semantics></math> from <math id="S13.SS3.SSS5.p1.m7" class="ltx_Math" alttext="\mathbb{B}_{01}\circ\mathbb{B}_{10}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔹</mi><mn>01</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝔹</mi><mn>10</mn></msub></mrow><annotation encoding="application/x-tex">\mathbb{B}_{01}\circ\mathbb{B}_{10}</annotation></semantics></math> to <math id="S13.SS3.SSS5.p1.m8" class="ltx_Math" alttext="\mathbb{\Delta}^{\mathbb{F}_{0}\mathbb{F}_{0}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mrow><msub><mi>𝔽</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔽</mi><mn>0</mn></msub></mrow></msup><annotation encoding="application/x-tex">\mathbb{\Delta}^{\mathbb{F}_{0}\mathbb{F}_{0}}</annotation></semantics></math> by gluing Floer data and varying in a one-parameter family, Proposition <a href="#S13.Thmthm6" title="Proposition 13.6. ‣ 13.3.4. Composition of continuation maps ‣ 13.3. Proof of Theorem ‣ 13. Proof of the Main Theorems ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13.6</span></a> provides a chain homotopy between the composition <math id="S13.SS3.SSS5.p1.m9" class="ltx_Math" alttext="\Phi_{01}\circ\Phi_{10}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Φ</mi><mn>01</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi mathvariant="normal">Φ</mi><mn>10</mn></msub></mrow><annotation encoding="application/x-tex">\Phi_{01}\circ\Phi_{10}</annotation></semantics></math> and the chain map associated to an AMS lift of <math id="S13.SS3.SSS5.p1.m10" class="ltx_Math" alttext="\mathbb{\Delta}^{\mathbb{F}_{0}\mathbb{F}_{0}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mrow><msub><mi>𝔽</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔽</mi><mn>0</mn></msub></mrow></msup><annotation encoding="application/x-tex">\mathbb{\Delta}^{\mathbb{F}_{0}\mathbb{F}_{0}}</annotation></semantics></math>. Notice that the latter has the form</span></p>
<table id="S13.Ex32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex32.m1" class="ltx_Math" alttext="\Phi^{{\mathbb{\Delta}}^{\mathbb{FF}}}={\rm Id}+{\rm higher\ order\ in\ }T" display="block" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup></msup><mo>=</mo><mrow><mi>Id</mi><mo>+</mo><mrow><mi>higher</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>order</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>in</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>T</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\Phi^{{\mathbb{\Delta}}^{\mathbb{FF}}}={\rm Id}+{\rm higher\ order\ in\ }T</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.SS3.SSS5.p1.2" class="ltx_p"><span id="S13.SS3.SSS5.p1.2.1" class="ltx_text">hence is an invertible chain map. Therefore, by a similar argument switching the roles of <math id="S13.SS3.SSS5.p1.m11" class="ltx_Math" alttext="\Phi_{01}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Φ</mi><mn>01</mn></msub><annotation encoding="application/x-tex">\Phi_{01}</annotation></semantics></math> and <math id="S13.SS3.SSS5.p1.m12" class="ltx_Math" alttext="\Phi_{10}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Φ</mi><mn>10</mn></msub><annotation encoding="application/x-tex">\Phi_{10}</annotation></semantics></math>, the continuation maps <math id="S13.SS3.SSS5.p1.m13" class="ltx_Math" alttext="\Phi_{01}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Φ</mi><mn>01</mn></msub><annotation encoding="application/x-tex">\Phi_{01}</annotation></semantics></math> and <math id="S13.SS3.SSS5.p1.m14" class="ltx_Math" alttext="\Phi_{10}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Φ</mi><mn>10</mn></msub><annotation encoding="application/x-tex">\Phi_{10}</annotation></semantics></math> are homotopy inverses to each other.
∎</span></p>
</div>
</div>
<div id="S13.SS3.SSS5.p2" class="ltx_para ltx_noindent">
<p id="S13.SS3.SSS5.p2.1" class="ltx_p">Lastly, we prove</p>
</div>
<div id="S13.Thmthm8" class="ltx_theorem ltx_theorem_cor">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S13.Thmthm8.2" class="ltx_text ltx_font_bold">Corollary 13.8</span></span><span id="S13.Thmthm8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S13.Thmthm8.p1" class="ltx_para">
<p id="S13.Thmthm8.p1.1" class="ltx_p"><span id="S13.Thmthm8.p1.1.1" class="ltx_text ltx_font_italic">The chain map from <math id="S13.Thmthm8.p1.m1" class="ltx_Math" alttext="CF_{*}(H,J,\Xi)\to CF_{*}(H,J,\Xi)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>J</mi><mo>,</mo><mi mathvariant="normal">Ξ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>J</mi><mo>,</mo><mi mathvariant="normal">Ξ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">CF_{*}(H,J,\Xi)\to CF_{*}(H,J,\Xi)</annotation></semantics></math> induced from an AMS lift of the diagonal bimodule <math id="S13.Thmthm8.p1.m2" class="ltx_Math" alttext="\mathbb{\Delta}^{\mathbb{FF}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{\Delta}^{\mathbb{FF}}</annotation></semantics></math> is chain homotopic to the identity.</span></p>
</div>
</div>
<div id="S13.SS3.SSS5.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S13.SS3.SSS5.p3" class="ltx_para ltx_noindent">
<p id="S13.SS3.SSS5.p3.1" class="ltx_p"><span id="S13.SS3.SSS5.p3.1.1" class="ltx_text">The same argument of the proof of Lemma <a href="#S13.Thmthm1" title="Lemma 13.1. ‣ 13.1. Proof of Theorem ‣ 13. Proof of the Main Theorems ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13.1</span></a> also applies here, resulting in a chain map associated to an AMS lift of the bimodule <math id="S13.SS3.SSS5.p3.m1" class="ltx_Math" alttext="\mathbb{\Delta}^{\mathbb{FF}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{\Delta}^{\mathbb{FF}}</annotation></semantics></math> of the form</span></p>
<table id="S13.Ex33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex33.m1" class="ltx_Math" alttext="\Phi={\rm Id}+A." display="block" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Φ</mi><mo>=</mo><mrow><mi>Id</mi><mo>+</mo><mi>A</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Phi={\rm Id}+A.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.SS3.SSS5.p3.2" class="ltx_p"><span id="S13.SS3.SSS5.p3.2.1" class="ltx_text">Notice that <math id="S13.SS3.SSS5.p3.m2" class="ltx_Math" alttext="{\rm Id}" display="inline" intent=":literal"><semantics><mi>Id</mi><annotation encoding="application/x-tex">{\rm Id}</annotation></semantics></math> is also a chain map in this case. Now since <math id="S13.SS3.SSS5.p3.m3" class="ltx_Math" alttext="\mathbb{\Delta}^{\mathbb{FF}}\circ\mathbb{\Delta}^{\mathbb{FF}}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbb{\Delta}^{\mathbb{FF}}\circ\mathbb{\Delta}^{\mathbb{FF}}</annotation></semantics></math> is homotopic to <math id="S13.SS3.SSS5.p3.m4" class="ltx_Math" alttext="\mathbb{\Delta}^{\mathbb{FF}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{\Delta}^{\mathbb{FF}}</annotation></semantics></math>, Proposition <a href="#S13.Thmthm6" title="Proposition 13.6. ‣ 13.3.4. Composition of continuation maps ‣ 13.3. Proof of Theorem ‣ 13. Proof of the Main Theorems ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13.6</span></a> implies that</span></p>
<table id="S13.Ex34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex34.m1" class="ltx_Math" alttext="({\rm Id}+A)^{2}-({\rm Id}+A)=A({\rm Id}+A)=d\rho+\rho d" display="block" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>Id</mi><mo>+</mo><mi>A</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Id</mi><mo>+</mo><mi>A</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Id</mi><mo>+</mo><mi>A</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi></mrow><mo>+</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">({\rm Id}+A)^{2}-({\rm Id}+A)=A({\rm Id}+A)=d\rho+\rho d</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.SS3.SSS5.p3.3" class="ltx_p"><span id="S13.SS3.SSS5.p3.3.1" class="ltx_text">for some linear map <math id="S13.SS3.SSS5.p3.m5" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>. As <math id="S13.SS3.SSS5.p3.m6" class="ltx_Math" alttext="{\rm Id}+A" display="inline" intent=":literal"><semantics><mrow><mi>Id</mi><mo>+</mo><mi>A</mi></mrow><annotation encoding="application/x-tex">{\rm Id}+A</annotation></semantics></math> is an invertible chain map, one has</span></p>
<table id="S13.Ex35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex35.m1" class="ltx_Math" alttext="A=(d\rho+\rho d)({\rm Id}+A)^{-1}=d(\rho({\rm Id}+A)^{-1})+(\rho({\rm Id}+A)^{-1})d" display="block" intent=":literal"><semantics><mrow><mi>A</mi><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi></mrow><mo>+</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>Id</mi><mo>+</mo><mi>A</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>=</mo><mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>Id</mi><mo>+</mo><mi>A</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>Id</mi><mo>+</mo><mi>A</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">A=(d\rho+\rho d)({\rm Id}+A)^{-1}=d(\rho({\rm Id}+A)^{-1})+(\rho({\rm Id}+A)^{-1})d</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.SS3.SSS5.p3.4" class="ltx_p"><span id="S13.SS3.SSS5.p3.4.1" class="ltx_text">meaning that <math id="S13.SS3.SSS5.p3.m7" class="ltx_Math" alttext="{\rm Id}+A" display="inline" intent=":literal"><semantics><mrow><mi>Id</mi><mo>+</mo><mi>A</mi></mrow><annotation encoding="application/x-tex">{\rm Id}+A</annotation></semantics></math> is chain homotopic to <math id="S13.SS3.SSS5.p3.m8" class="ltx_Math" alttext="{\rm Id}" display="inline" intent=":literal"><semantics><mi>Id</mi><annotation encoding="application/x-tex">{\rm Id}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="S13.SS4" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">13.4. </span>Proof of Theorem <a href="#Thmthma3" title="Theorem C (Pair-of-pants product). ‣ 1.1.2. Pair-of-pants product ‣ 1.1. Main results on Floer complexes ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C</span></a></h4>

<section id="S13.SS4.SSS1" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">13.4.1. </span>Definition of the pair-of-pants products</h5>

<div id="S13.SS4.SSS1.p1" class="ltx_para ltx_noindent">
<p id="S13.SS4.SSS1.p1.1" class="ltx_p">The setting of Theorem <a href="#Thmthma3" title="Theorem C (Pair-of-pants product). ‣ 1.1.2. Pair-of-pants product ‣ 1.1. Main results on Floer complexes ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C</span></a> falls into Situation <a href="#Thmsituationm1" title="Situation Module(i). ‣ 10.2. Multimodules from smooth domains ‣ 10. Geometric Multimodules ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Module(i)</span></a>. Let <math id="S13.SS4.SSS1.p1.m1" class="ltx_Math" alttext="\Sigma^{\mathbb{X}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Σ</mi><mi>𝕏</mi></msup><annotation encoding="application/x-tex">\Sigma^{\mathbb{X}}</annotation></semantics></math> be a smooth pair-of-pants with two negative ends and one positive end equipped with a Floer datum which are asymptotic to <math id="S13.SS4.SSS1.p1.m2" class="ltx_Math" alttext="H_{1}dt" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">H_{1}dt</annotation></semantics></math> and <math id="S13.SS4.SSS1.p1.m3" class="ltx_Math" alttext="H_{2}dt" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">H_{2}dt</annotation></semantics></math> on the negative ends and to <math id="S13.SS4.SSS1.p1.m4" class="ltx_Math" alttext="H^{\prime}dt" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">H^{\prime}dt</annotation></semantics></math> on the positive end. To simplify the argument, use a fixed almost complex structure <math id="S13.SS4.SSS1.p1.m5" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math>; more general cases can be treated with the help of continuation maps. Hence we omit the reference to almost complex structures. Let <math id="S13.SS4.SSS1.p1.m6" class="ltx_Math" alttext="{\mathbb{F}}_{1},{\mathbb{F}}_{2},{\mathbb{F}}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔽</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝔽</mi><mn>2</mn></msub><mo>,</mo><msup><mi>𝔽</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">{\mathbb{F}}_{1},{\mathbb{F}}_{2},{\mathbb{F}}^{\prime}</annotation></semantics></math> be the Floer flow categories associated to <math id="S13.SS4.SSS1.p1.m7" class="ltx_Math" alttext="H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">H_{1}</annotation></semantics></math>, <math id="S13.SS4.SSS1.p1.m8" class="ltx_Math" alttext="H_{2}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>2</mn></msub><annotation encoding="application/x-tex">H_{2}</annotation></semantics></math>, and <math id="S13.SS4.SSS1.p1.m9" class="ltx_Math" alttext="H^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>H</mi><mo>′</mo></msup><annotation encoding="application/x-tex">H^{\prime}</annotation></semantics></math> respectively.</p>
</div>
<div id="S13.SS4.SSS1.p2" class="ltx_para ltx_noindent">
<p id="S13.SS4.SSS1.p2.1" class="ltx_p">We fix an outercollaring width and will not mention it anymore in this subsection. Let <math id="S13.SS4.SSS1.p2.m1" class="ltx_Math" alttext="{\mathbb{X}}" display="inline" intent=":literal"><semantics><mi>𝕏</mi><annotation encoding="application/x-tex">{\mathbb{X}}</annotation></semantics></math> be the multimodule associated to <math id="S13.SS4.SSS1.p2.m2" class="ltx_Math" alttext="\Sigma^{\mathbb{X}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Σ</mi><mi>𝕏</mi></msup><annotation encoding="application/x-tex">\Sigma^{\mathbb{X}}</annotation></semantics></math>. Then by Proposition <a href="#S15.Thmthm4" title="Proposition 15.4. ‣ 15.1. Integral modification of topological energy ‣ 15. Relatively Smooth AMS lifts ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15.4</span></a>, one can choose a triple of integral actions <math id="S13.SS4.SSS1.p2.m3" class="ltx_Math" alttext="{\mathcal{A}}_{{\mathbb{F}}_{1}}^{\Omega},{\mathcal{A}}_{{\mathbb{F}}_{2}}^{\Omega}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mi>𝔽</mi><mn>1</mn></msub><mi mathvariant="normal">Ω</mi></msubsup><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msub><mi>𝔽</mi><mn>2</mn></msub><mi mathvariant="normal">Ω</mi></msubsup></mrow><annotation encoding="application/x-tex">{\mathcal{A}}_{{\mathbb{F}}_{1}}^{\Omega},{\mathcal{A}}_{{\mathbb{F}}_{2}}^{\Omega}</annotation></semantics></math>, <math id="S13.SS4.SSS1.p2.m4" class="ltx_Math" alttext="{\mathcal{A}}_{{\mathbb{F}}^{\prime}}^{\Omega}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msup><mi>𝔽</mi><mo>′</mo></msup><mi mathvariant="normal">Ω</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{A}}_{{\mathbb{F}}^{\prime}}^{\Omega}</annotation></semantics></math>. Then one obtains Floer chain complexes</p>
<table id="S13.Ex36" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex36.m1" class="ltx_Math" alttext="CF_{*}(H_{1},\Xi_{1}),CF_{*}(H_{2},\Xi_{2}),CF_{*}(H^{\prime},\Xi^{\prime})" display="block" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>1</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>2</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mo>′</mo></msup><mo>,</mo><msup><mi mathvariant="normal">Ξ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">CF_{*}(H_{1},\Xi_{1}),CF_{*}(H_{2},\Xi_{2}),CF_{*}(H^{\prime},\Xi^{\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.SS4.SSS1.p2.2" class="ltx_p">which depend on the AMS lifts <math id="S13.SS4.SSS1.p2.m5" class="ltx_Math" alttext="\tilde{\mathbb{F}}_{1},\tilde{\mathbb{F}}_{2},\tilde{\mathbb{F}}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mn>1</mn></msub><mo>,</mo><msub><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mn>2</mn></msub><mo>,</mo><msup><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">\tilde{\mathbb{F}}_{1},\tilde{\mathbb{F}}_{2},\tilde{\mathbb{F}}^{\prime}</annotation></semantics></math> subject to the integral actions and their FOP perturbations <math id="S13.SS4.SSS1.p2.m6" class="ltx_Math" alttext="\mathring{\mathbb{F}}_{1},\mathring{\mathbb{F}}_{2},\mathring{\mathbb{F}}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><mn>1</mn></msub><mo>,</mo><msub><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><mn>2</mn></msub><mo>,</mo><msup><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">\mathring{\mathbb{F}}_{1},\mathring{\mathbb{F}}_{2},\mathring{\mathbb{F}}^{\prime}</annotation></semantics></math>. Upon choosing a pair of lateral lines in <math id="S13.SS4.SSS1.p2.m7" class="ltx_Math" alttext="\Sigma^{\mathbb{X}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Σ</mi><mi>𝕏</mi></msup><annotation encoding="application/x-tex">\Sigma^{\mathbb{X}}</annotation></semantics></math>, the basic construction provides a chain map</p>
<table id="S13.Ex37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex37.m1" class="ltx_Math" alttext="\Phi^{\mathbb{X}}(\Theta):CF_{*}(H_{1},\Xi_{1})\otimes CF_{*}(H_{2},\Xi_{2})\to CF_{*}(H^{\prime},\Xi^{\prime})" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">Φ</mi><mi>𝕏</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mrow><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>1</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mn>1</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>2</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mo>′</mo></msup><mo>,</mo><msup><mi mathvariant="normal">Ξ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Phi^{\mathbb{X}}(\Theta):CF_{*}(H_{1},\Xi_{1})\otimes CF_{*}(H_{2},\Xi_{2})\to CF_{*}(H^{\prime},\Xi^{\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.SS4.SSS1.p2.3" class="ltx_p">which depends on an AMS lift <math id="S13.SS4.SSS1.p2.m8" class="ltx_Math" alttext="\tilde{\mathbb{X}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝕏</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{X}}</annotation></semantics></math> and an FOP perturbation <math id="S13.SS4.SSS1.p2.m9" class="ltx_Math" alttext="\mathring{\mathbb{X}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝕏</mi><mo>̊</mo></mover><annotation encoding="application/x-tex">\mathring{\mathbb{X}}</annotation></semantics></math>.</p>
</div>
</section>
<section id="S13.SS4.SSS2" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">13.4.2. </span>Well-defined homotopy class</h5>

<div id="S13.SS4.SSS2.p1" class="ltx_para ltx_noindent">
<p id="S13.SS4.SSS2.p1.1" class="ltx_p">Now we prove Part (1) of Theorem <a href="#Thmthma3" title="Theorem C (Pair-of-pants product). ‣ 1.1.2. Pair-of-pants product ‣ 1.1. Main results on Floer complexes ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C</span></a>. Similar to the case of continuation maps, by Lemma <a href="#S13.Thmthm2" title="Lemma 13.2. ‣ 13.2.1. Chain maps associated to smooth Floer domains ‣ 13.2. General construction of chain maps and homotopics ‣ 13. Proof of the Main Theorems ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13.2</span></a>, the homotopy class of <math id="S13.SS4.SSS2.p1.m1" class="ltx_Math" alttext="\Phi^{{\mathbb{X}}}(\Theta)" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><mi>𝕏</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Phi^{{\mathbb{X}}}(\Theta)</annotation></semantics></math> does not depend on choices made for constructing the AMS lift <math id="S13.SS4.SSS2.p1.m2" class="ltx_Math" alttext="\tilde{\mathbb{X}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝕏</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{X}}</annotation></semantics></math> and FOP perturbation <math id="S13.SS4.SSS2.p1.m3" class="ltx_Math" alttext="\mathring{\mathbb{X}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝕏</mi><mo>̊</mo></mover><annotation encoding="application/x-tex">\mathring{\mathbb{X}}</annotation></semantics></math>, so <span id="S13.SS4.SSS2.p1.1.1" class="ltx_text ltx_font_italic">a priori</span> only depends on the integral actions and the choices of lateral lines. These dependence is removed (up to homotopy) by Lemma <a href="#S13.Thmthm3" title="Lemma 13.3. ‣ 13.2.1. Chain maps associated to smooth Floer domains ‣ 13.2. General construction of chain maps and homotopics ‣ 13. Proof of the Main Theorems ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13.3</span></a>. Hence the homotopy class of <math id="S13.SS4.SSS2.p1.m4" class="ltx_Math" alttext="\Phi^{{\mathbb{X}}}(\Theta)" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><mi>𝕏</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Phi^{{\mathbb{X}}}(\Theta)</annotation></semantics></math> <span id="S13.SS4.SSS2.p1.1.2" class="ltx_text ltx_font_italic">a priori</span> only depends on the Floer data defining <math id="S13.SS4.SSS2.p1.m5" class="ltx_Math" alttext="{\mathbb{X}}" display="inline" intent=":literal"><semantics><mi>𝕏</mi><annotation encoding="application/x-tex">{\mathbb{X}}</annotation></semantics></math>. Lastly, if <math id="S13.SS4.SSS2.p1.m6" class="ltx_Math" alttext="{\mathbb{X}}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝕏</mi><mn>0</mn></msub><annotation encoding="application/x-tex">{\mathbb{X}}_{0}</annotation></semantics></math> and <math id="S13.SS4.SSS2.p1.m7" class="ltx_Math" alttext="{\mathbb{X}}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝕏</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\mathbb{X}}_{1}</annotation></semantics></math> are multimodules defined by two different Floer data on the pair-of-pants (including different cylindrical ends), then one can build a homotopy <math id="S13.SS4.SSS2.p1.m8" class="ltx_Math" alttext="{\mathbb{H}}" display="inline" intent=":literal"><semantics><mi>ℍ</mi><annotation encoding="application/x-tex">{\mathbb{H}}</annotation></semantics></math> from <math id="S13.SS4.SSS2.p1.m9" class="ltx_Math" alttext="{\mathbb{X}}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝕏</mi><mn>0</mn></msub><annotation encoding="application/x-tex">{\mathbb{X}}_{0}</annotation></semantics></math> to <math id="S13.SS4.SSS2.p1.m10" class="ltx_Math" alttext="{\mathbb{X}}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝕏</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\mathbb{X}}_{1}</annotation></semantics></math> by varying the Floer data. Then Lemma <a href="#S13.Thmthm4" title="Lemma 13.4. ‣ 13.2.2. Homotopy ‣ 13.2. General construction of chain maps and homotopics ‣ 13. Proof of the Main Theorems ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13.4</span></a> implies that the corresponding chain maps <math id="S13.SS4.SSS2.p1.m11" class="ltx_Math" alttext="\Phi^{{\mathbb{X}}_{0}}(\Theta_{0})" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><msub><mi>𝕏</mi><mn>0</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Phi^{{\mathbb{X}}_{0}}(\Theta_{0})</annotation></semantics></math> and <math id="S13.SS4.SSS2.p1.m12" class="ltx_Math" alttext="\Phi^{{\mathbb{X}}_{1}}(\Theta_{1})" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><msub><mi>𝕏</mi><mn>1</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Phi^{{\mathbb{X}}_{1}}(\Theta_{1})</annotation></semantics></math> are also homotopic.</p>
</div>
</section>
<section id="S13.SS4.SSS3" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">13.4.3. </span>Compatibility with the continuation maps</h5>

<div id="S13.SS4.SSS3.p1" class="ltx_para ltx_noindent">
<p id="S13.SS4.SSS3.p1.1" class="ltx_p">We only treat the case with composing continuation maps at the positive end, and the other cases follow from the same reasoning. Let <math id="S13.SS4.SSS3.p1.m1" class="ltx_Math" alttext="{\mathbb{F}}^{\prime\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝔽</mi><mo>′′</mo></msup><annotation encoding="application/x-tex">{\mathbb{F}}^{\prime\prime}</annotation></semantics></math> be a fourth Floer flow category associated to <math id="S13.SS4.SSS3.p1.m2" class="ltx_Math" alttext="(H^{\prime\prime},J^{\prime\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mo>′′</mo></msup><mo>,</mo><msup><mi>J</mi><mo>′′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(H^{\prime\prime},J^{\prime\prime})</annotation></semantics></math>. We assume that the almost complex structure is fixed and drop it from the notation; the general case when <math id="S13.SS4.SSS3.p1.m3" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math> is domain-dependent can be treated using continuation maps. Let <math id="S13.SS4.SSS3.p1.m4" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{F}^{\prime}\mathbb{F}^{\prime\prime}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><msup><mi>𝔽</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔽</mi><mo>′′</mo></msup></mrow></msup><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{F}^{\prime}\mathbb{F}^{\prime\prime}}</annotation></semantics></math> be a bimodule over <math id="S13.SS4.SSS3.p1.m5" class="ltx_Math" alttext="({\mathbb{F}}^{\prime};{\mathbb{F}}^{\prime\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo>;</mo><msup><mi>𝔽</mi><mo>′′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}^{\prime};{\mathbb{F}}^{\prime\prime})</annotation></semantics></math> provided by continuation map Floer data on the cylinder. Consider the concatenation <math id="S13.SS4.SSS3.p1.m6" class="ltx_Math" alttext="{\mathbb{X}}\circ\mathbb{B}^{\mathbb{F}^{\prime}\mathbb{F}^{\prime\prime}}" display="inline" intent=":literal"><semantics><mrow><mi>𝕏</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>𝔹</mi><mrow><msup><mi>𝔽</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔽</mi><mo>′′</mo></msup></mrow></msup></mrow><annotation encoding="application/x-tex">{\mathbb{X}}\circ\mathbb{B}^{\mathbb{F}^{\prime}\mathbb{F}^{\prime\prime}}</annotation></semantics></math>. Then by gluing the Floer domains, one obtains a homotopy <math id="S13.SS4.SSS3.p1.m7" class="ltx_Math" alttext="{\mathbb{H}}" display="inline" intent=":literal"><semantics><mi>ℍ</mi><annotation encoding="application/x-tex">{\mathbb{H}}</annotation></semantics></math> from <math id="S13.SS4.SSS3.p1.m8" class="ltx_Math" alttext="{\mathbb{X}}\circ\mathbb{B}^{\mathbb{F}^{\prime}\mathbb{F}^{\prime\prime}}" display="inline" intent=":literal"><semantics><mrow><mi>𝕏</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>𝔹</mi><mrow><msup><mi>𝔽</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔽</mi><mo>′′</mo></msup></mrow></msup></mrow><annotation encoding="application/x-tex">{\mathbb{X}}\circ\mathbb{B}^{\mathbb{F}^{\prime}\mathbb{F}^{\prime\prime}}</annotation></semantics></math> to a multimodule <math id="S13.SS4.SSS3.p1.m9" class="ltx_Math" alttext="{\mathbb{Y}}" display="inline" intent=":literal"><semantics><mi>𝕐</mi><annotation encoding="application/x-tex">{\mathbb{Y}}</annotation></semantics></math> over <math id="S13.SS4.SSS3.p1.m10" class="ltx_Math" alttext="({\mathbb{F}}_{1},{\mathbb{F}}_{2};{\mathbb{F}}^{\prime\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝔽</mi><mn>2</mn></msub><mo>,</mo><msup><mi>𝔽</mi><mo>′′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{1},{\mathbb{F}}_{2};{\mathbb{F}}^{\prime\prime})</annotation></semantics></math> defined on the pair-of-pants with another Floer datum.</p>
</div>
<div id="S13.SS4.SSS3.p2" class="ltx_para ltx_noindent">
<p id="S13.SS4.SSS3.p2.1" class="ltx_p">Then by Proposition <a href="#S15.Thmthm4" title="Proposition 15.4. ‣ 15.1. Integral modification of topological energy ‣ 15. Relatively Smooth AMS lifts ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15.4</span></a>, one can choose integral actions on involved Floer flow categories which are compatible with respect to <math id="S13.SS4.SSS3.p2.m1" class="ltx_Math" alttext="\mathbb{X}" display="inline" intent=":literal"><semantics><mi>𝕏</mi><annotation encoding="application/x-tex">\mathbb{X}</annotation></semantics></math>, <math id="S13.SS4.SSS3.p2.m2" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{F}^{\prime}\mathbb{F}^{\prime\prime}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><msup><mi>𝔽</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔽</mi><mo>′′</mo></msup></mrow></msup><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{F}^{\prime}\mathbb{F}^{\prime\prime}}</annotation></semantics></math>, <math id="S13.SS4.SSS3.p2.m3" class="ltx_Math" alttext="{\mathbb{Y}}" display="inline" intent=":literal"><semantics><mi>𝕐</mi><annotation encoding="application/x-tex">{\mathbb{Y}}</annotation></semantics></math>, and <math id="S13.SS4.SSS3.p2.m4" class="ltx_Math" alttext="{\mathbb{H}}" display="inline" intent=":literal"><semantics><mi>ℍ</mi><annotation encoding="application/x-tex">{\mathbb{H}}</annotation></semantics></math>. Then we are in the situation of Lemma <a href="#S13.Thmthm5" title="Lemma 13.5. ‣ 13.2.3. Concatenation and gluing ‣ 13.2. General construction of chain maps and homotopics ‣ 13. Proof of the Main Theorems ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13.5</span></a>, which provides specific chain complexes</p>
<table id="S13.Ex38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex38.m1" class="ltx_Math" alttext="CF_{*}(H_{1},\Xi_{1}),CF_{*}(H_{2},\Xi_{2}),CF_{*}(H^{\prime},\Xi^{\prime}),CF_{*}(H^{\prime\prime},\Xi^{\prime\prime})" display="block" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>1</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>2</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mo>′</mo></msup><mo>,</mo><msup><mi mathvariant="normal">Ξ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mo>′′</mo></msup><mo>,</mo><msup><mi mathvariant="normal">Ξ</mi><mo>′′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">CF_{*}(H_{1},\Xi_{1}),CF_{*}(H_{2},\Xi_{2}),CF_{*}(H^{\prime},\Xi^{\prime}),CF_{*}(H^{\prime\prime},\Xi^{\prime\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.SS4.SSS3.p2.2" class="ltx_p">chain maps</p>
<table id="S13.Ex39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex39.m1" class="ltx_Math" alttext="\begin{split}\Phi^{\mathbb{X}}:CF_{*}(H_{1},\Xi_{1})\otimes CF_{*}(H_{2},\Xi_{2})\to&amp;\ CF_{*}(H^{\prime},\Xi^{\prime}),\\
\Phi^{\mathbb{F}^{\prime}\mathbb{F}^{\prime\prime}}:CF_{*}(H^{\prime},\Xi^{\prime})\to&amp;\ CF_{*}(H^{\prime\prime},\Xi^{\prime\prime}),\\
\Phi^{\mathbb{Y}}:CF_{*}(H_{1},\Xi_{1})\otimes CF_{*}(H_{2},\Xi_{2})\to&amp;\ CF_{*}(H^{\prime\prime},\Xi^{\prime\prime}).\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><msup><mi mathvariant="normal">Φ</mi><mi>𝕏</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>1</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mn>1</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>2</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mphantom></mphantom></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mo>′</mo></msup><mo>,</mo><msup><mi mathvariant="normal">Ξ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><msup><mi mathvariant="normal">Φ</mi><mrow><msup><mi>𝔽</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔽</mi><mo>′′</mo></msup></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mo>′</mo></msup><mo>,</mo><msup><mi mathvariant="normal">Ξ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mphantom></mphantom></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mo>′′</mo></msup><mo>,</mo><msup><mi mathvariant="normal">Ξ</mi><mo>′′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><msup><mi mathvariant="normal">Φ</mi><mi>𝕐</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>1</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mn>1</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>2</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mphantom></mphantom></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mo>′′</mo></msup><mo>,</mo><msup><mi mathvariant="normal">Ξ</mi><mo>′′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\Phi^{\mathbb{X}}:CF_{*}(H_{1},\Xi_{1})\otimes CF_{*}(H_{2},\Xi_{2})\to&amp;\ CF_{*}(H^{\prime},\Xi^{\prime}),\\
\Phi^{\mathbb{F}^{\prime}\mathbb{F}^{\prime\prime}}:CF_{*}(H^{\prime},\Xi^{\prime})\to&amp;\ CF_{*}(H^{\prime\prime},\Xi^{\prime\prime}),\\
\Phi^{\mathbb{Y}}:CF_{*}(H_{1},\Xi_{1})\otimes CF_{*}(H_{2},\Xi_{2})\to&amp;\ CF_{*}(H^{\prime\prime},\Xi^{\prime\prime}).\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.SS4.SSS3.p2.3" class="ltx_p">The Lemma <a href="#S13.Thmthm5" title="Lemma 13.5. ‣ 13.2.3. Concatenation and gluing ‣ 13.2. General construction of chain maps and homotopics ‣ 13. Proof of the Main Theorems ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13.5</span></a> shows that <math id="S13.SS4.SSS3.p2.m5" class="ltx_Math" alttext="\Phi^{\mathbb{Y}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mi>𝕐</mi></msup><annotation encoding="application/x-tex">\Phi^{\mathbb{Y}}</annotation></semantics></math> is chain homotopic to the composition <math id="S13.SS4.SSS3.p2.m6" class="ltx_Math" alttext="\Phi^{\mathbb{F}^{\prime}\mathbb{F}^{\prime\prime}}\circ\Phi^{\mathbb{X}}" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><mrow><msup><mi>𝔽</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔽</mi><mo>′′</mo></msup></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi mathvariant="normal">Φ</mi><mi>𝕏</mi></msup></mrow><annotation encoding="application/x-tex">\Phi^{\mathbb{F}^{\prime}\mathbb{F}^{\prime\prime}}\circ\Phi^{\mathbb{X}}</annotation></semantics></math>. This is Theorem <a href="#Thmthma3" title="Theorem C (Pair-of-pants product). ‣ 1.1.2. Pair-of-pants product ‣ 1.1. Main results on Floer complexes ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C</span></a> (2).</p>
</div>
</section>
<section id="S13.SS4.SSS4" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">13.4.4. </span>Associativity</h5>

<div id="S13.SS4.SSS4.p1" class="ltx_para ltx_noindent">
<p id="S13.SS4.SSS4.p1.1" class="ltx_p">Associativity follows from Lemma <a href="#S13.Thmthm4" title="Lemma 13.4. ‣ 13.2.2. Homotopy ‣ 13.2. General construction of chain maps and homotopics ‣ 13. Proof of the Main Theorems ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13.4</span></a> and <a href="#S13.Thmthm5" title="Lemma 13.5. ‣ 13.2.3. Concatenation and gluing ‣ 13.2. General construction of chain maps and homotopics ‣ 13. Proof of the Main Theorems ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13.5</span></a>. In the notations of chain complexes, we drop the dependence on <math id="S13.SS4.SSS4.p1.m1" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math>.</p>
</div>
<div id="S13.SS4.SSS4.p2" class="ltx_para ltx_noindent">
<p id="S13.SS4.SSS4.p2.1" class="ltx_p">Choose Hamiltonians <math id="S13.SS4.SSS4.p2.m1" class="ltx_Math" alttext="H_{1},H_{2},H_{3},H^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mn>1</mn></msub><mo>,</mo><msub><mi>H</mi><mn>2</mn></msub><mo>,</mo><msub><mi>H</mi><mn>3</mn></msub><mo>,</mo><msup><mi>H</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">H_{1},H_{2},H_{3},H^{\prime}</annotation></semantics></math>, <math id="S13.SS4.SSS4.p2.m2" class="ltx_Math" alttext="H_{12}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>12</mn></msub><annotation encoding="application/x-tex">H_{12}</annotation></semantics></math>, <math id="S13.SS4.SSS4.p2.m3" class="ltx_Math" alttext="H_{23}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>23</mn></msub><annotation encoding="application/x-tex">H_{23}</annotation></semantics></math> independently. One can build a homotopy of two concatenated multimodules as shown in Figure <a href="#S13.F7" title="Figure 7 ‣ 13.4.4. Associativity ‣ 13.4. Proof of Theorem ‣ 13. Proof of the Main Theorems ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>. One can choose integral actions on all involved Floer flow categories which are compatible with respect to this homotopy. Then apply Lemma <a href="#S13.Thmthm5" title="Lemma 13.5. ‣ 13.2.3. Concatenation and gluing ‣ 13.2. General construction of chain maps and homotopics ‣ 13. Proof of the Main Theorems ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13.5</span></a> twice, one obtains the following diagram in which each triangle commutes up to homotopy.</p>
<table id="S13.Ex40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S13.Ex40.m1.pic1" class="ltx_picture ltx_markedasmath" height="66.43" overflow="visible" style="vertical-align:-55.360330888075964px" version="1.1" viewBox="139.92 55.36 507.77 66.43" width="507.77"><g transform="matrix(1 0 0 -1 139.91986532436954 66.42993099877197) translate(0,3.46) translate(139.92,0)"><g transform="translate(-139.92,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:19.62em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="271.54"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S13.Ex40.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{CF_{*}(H_{1},\Xi_{1})\otimes CF_{*}(H_{2},\Xi_{2})\otimes CF_{*}(H_{3},\Xi_{3})\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>1</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mn>1</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>2</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mn>2</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>3</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{CF_{*}(H_{1},\Xi_{1})\otimes CF_{*}(H_{2},\Xi_{2})\otimes CF_{*}(H_{3},\Xi_{3})\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 67.59590770720908 -11.069600110696001 L 67.62624793120632 -11.201686708696554" fill="none" stroke="#000000"></path><g transform="translate(229.05,0) translate(0,-37.53)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.38 3.85" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -7.28 -1.61" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 67.59590770720908 -11.069600110696001 L 229.04457946329737 -37.5317016280636" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 229.04457946329737 -37.35394634216739 L 229.04457946329737 -37.5317016280636" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -11.069600110696001 L 0.27673578005007266 -11.069600110696001" fill="none" stroke="#000000"></path><g transform="translate(0,-33.22)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.22113066668396 L 0.27673578005007266 -11.069600110696001" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.22113066668396 L 0.27673578005007266 -33.22113066668396" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 139.9198864379562 -0.27673578005007266 L 139.9198864379562 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(173.13,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 139.9198864379562 -0.27673578005007266 L 173.12866565645754 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 173.12866565645754 -0.27673578005007266 L 173.12866565645754 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(173.13,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:13.47em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="186.42"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S13.Ex40.m1.pic1.m2" class="ltx_Math" alttext="\textstyle{CF_{*}(H_{1},\Xi_{1})\otimes CF_{*}(H_{23},\Xi_{23})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>1</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mn>1</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>23</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mn>23</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{CF_{*}(H_{1},\Xi_{1})\otimes CF_{*}(H_{23},\Xi_{23})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 270.21252632273075 -11.069600110696001 L 270.7659978828309 -11.069600110696001" fill="none" stroke="#000000"></path><g transform="translate(270.49,0) translate(0,-33.2)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 270.21252632273075 -33.196469997492045 L 270.7659978828309 -11.069600110696001" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 270.21252632273075 -33.196469997492045 L 270.7659978828309 -33.196469997492045" fill="none" stroke="#000000"></path><g transform="translate(-97.36,0) translate(0,-44.29) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:13.47em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="186.42"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S13.Ex40.m1.pic1.m3" class="ltx_Math" alttext="\textstyle{CF_{*}(H_{12},\Xi_{12})\otimes CF_{*}(H_{3},\Xi_{3})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>12</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mn>12</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>3</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{CF_{*}(H_{12},\Xi_{12})\otimes CF_{*}(H_{3},\Xi_{3})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 97.36059644632326 -44.56746655743004 L 97.36059644632326 -44.01399499732989" fill="none" stroke="#000000"></path><g transform="translate(229.05,0) translate(0,-44.29)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 97.36059644632326 -44.56746655743004 L 229.04457946329737 -44.01399499732989" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 229.04457946329737 -44.56746655743004 L 229.04457946329737 -44.01399499732989" fill="none" stroke="#000000"></path><g transform="translate(229.05,0) translate(0,-44.29) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:5.39em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.86" overflow="visible" transform="matrix(1 0 0 -1 0 10.4)" width="74.59"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S13.Ex40.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{CF_{*}(H^{\prime},\Xi^{\prime})}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>H</mi><mo>′</mo></msup><mo>,</mo><msup><mi mathvariant="normal">Ξ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{CF_{*}(H^{\prime},\Xi^{\prime})}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.SS4.SSS4.p2.2" class="ltx_p">Here the diagonal arrow is provided by a multimodule with three source flow categories. As the homotopy types of continuation maps are well-defined, the associativity is proved. This is Theorem <a href="#Thmthma3" title="Theorem C (Pair-of-pants product). ‣ 1.1.2. Pair-of-pants product ‣ 1.1. Main results on Floer complexes ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C</span></a> (3).</p>
</div>
<figure id="S13.F7" class="ltx_figure"><object type="image/svg+xml" data="2606.15847v1/associativity.svg" id="S13.F7.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:522/504;" width="522" height="504"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 7. </span>The homotopy between two concatenations.</figcaption>
</figure>
</section>
<section id="S13.SS4.SSS5" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">13.4.5. </span>Identity element</h5>

<div id="S13.SS4.SSS5.p1" class="ltx_para ltx_noindent">
<p id="S13.SS4.SSS5.p1.1" class="ltx_p">There is a natural multiplicative identity of the pair-of-pants product coming from the cigar bimodule (see Subsection <a href="#S10.SS3.SSS6" title="10.3.6. Cigar module ‣ 10.3. PSS type bimodules ‣ 10. Geometric Multimodules ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10.3.6</span></a>). Let <math id="S13.SS4.SSS5.p1.m1" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> be the Floer flow category associated to a nondegenerate Hamiltonian <math id="S13.SS4.SSS5.p1.m2" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> on the almost Kähler manifold <math id="S13.SS4.SSS5.p1.m3" class="ltx_Math" alttext="(X,\omega,J)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>ω</mi><mo>,</mo><mi>J</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(X,\omega,J)</annotation></semantics></math>. On the other hand, let <math id="S13.SS4.SSS5.p1.m4" class="ltx_Math" alttext="{\mathbb{O}}" display="inline" intent=":literal"><semantics><mi>𝕆</mi><annotation encoding="application/x-tex">{\mathbb{O}}</annotation></semantics></math> be the trivial flow category consisting of only one object. Then the cigar bimodule is a bimodule <math id="S13.SS4.SSS5.p1.m5" class="ltx_Math" alttext="{\mathbb{B}}^{\mathbb{OF}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><mi>𝕆</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">{\mathbb{B}}^{\mathbb{OF}}</annotation></semantics></math> associated to a Floer data on <math id="S13.SS4.SSS5.p1.m6" class="ltx_Math" alttext="{\mathbb{C}}" display="inline" intent=":literal"><semantics><mi>ℂ</mi><annotation encoding="application/x-tex">{\mathbb{C}}</annotation></semantics></math> which is asymptotic to <math id="S13.SS4.SSS5.p1.m7" class="ltx_Math" alttext="Hdt" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">Hdt</annotation></semantics></math> near <math id="S13.SS4.SSS5.p1.m8" class="ltx_Math" alttext="\infty" display="inline" intent=":literal"><semantics><mi mathvariant="normal">∞</mi><annotation encoding="application/x-tex">\infty</annotation></semantics></math>. Then this is a special case of Situation <a href="#Thmsituationm1" title="Situation Module(i). ‣ 10.2. Multimodules from smooth domains ‣ 10. Geometric Multimodules ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Module(i)</span></a>.</p>
</div>
<div id="S13.SS4.SSS5.p2" class="ltx_para ltx_noindent">
<p id="S13.SS4.SSS5.p2.1" class="ltx_p">By Proposition <a href="#S15.Thmthm4" title="Proposition 15.4. ‣ 15.1. Integral modification of topological energy ‣ 15. Relatively Smooth AMS lifts ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15.4</span></a>, one can choose an integral action <math id="S13.SS4.SSS5.p2.m1" class="ltx_Math" alttext="{\mathcal{A}}_{\mathbb{F}}^{\Omega}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>𝔽</mi><mi mathvariant="normal">Ω</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{A}}_{\mathbb{F}}^{\Omega}</annotation></semantics></math> on <math id="S13.SS4.SSS5.p2.m2" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> which is compatible with respect to <math id="S13.SS4.SSS5.p2.m3" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{OF}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><mi>𝕆</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{OF}}</annotation></semantics></math>. Choose an outercollaring width. Let</p>
<table id="S13.Ex41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex41.m1" class="ltx_Math" alttext="CF_{*}(H,J,\Xi)" display="block" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>J</mi><mo>,</mo><mi mathvariant="normal">Ξ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF_{*}(H,J,\Xi)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.SS4.SSS5.p2.2" class="ltx_p">be the associated Floer chain complex depending an AMS lift <math id="S13.SS4.SSS5.p2.m4" class="ltx_Math" alttext="\tilde{\mathbb{F}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{F}}</annotation></semantics></math> subject to the outercollaring width, the integral action, and an FOP perturbation <math id="S13.SS4.SSS5.p2.m5" class="ltx_Math" alttext="\mathring{\mathbb{F}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><annotation encoding="application/x-tex">\mathring{\mathbb{F}}</annotation></semantics></math>. The basic construction for multimodules then provides a chain map</p>
<table id="S13.Ex42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex42.m1" class="ltx_Math" alttext="\Phi^{\mathbb{OF}}(\Theta):{\mathbb{Z}}\cong C_{*}({\mathbb{O}})\to CF_{*}(H,J,\Xi)" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">Φ</mi><mrow><mi>𝕆</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mi>ℤ</mi><mo>≅</mo><mrow><msub><mi>C</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝕆</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>J</mi><mo>,</mo><mi mathvariant="normal">Ξ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Phi^{\mathbb{OF}}(\Theta):{\mathbb{Z}}\cong C_{*}({\mathbb{O}})\to CF_{*}(H,J,\Xi)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.SS4.SSS5.p2.3" class="ltx_p">which depends on an AMS lift <math id="S13.SS4.SSS5.p2.m6" class="ltx_Math" alttext="\tilde{\mathbb{B}}^{\mathbb{OF}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝔹</mi><mo>~</mo></mover><mrow><mi>𝕆</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\tilde{\mathbb{B}}^{\mathbb{OF}}</annotation></semantics></math> and an FOP perturbation <math id="S13.SS4.SSS5.p2.m7" class="ltx_Math" alttext="\mathring{\mathbb{B}}^{\mathbb{OF}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝔹</mi><mo>̊</mo></mover><mrow><mi>𝕆</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\mathring{\mathbb{B}}^{\mathbb{OF}}</annotation></semantics></math>.</p>
</div>
<div id="S13.SS4.SSS5.p3" class="ltx_para ltx_noindent">
<p id="S13.SS4.SSS5.p3.1" class="ltx_p">Following the same argument as before, one can prove that the homotopy class of the chain map <math id="S13.SS4.SSS5.p3.m1" class="ltx_Math" alttext="\Phi^{\mathbb{OF}}(\Theta)" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><mrow><mi>𝕆</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Phi^{\mathbb{OF}}(\Theta)</annotation></semantics></math> is well-defined, independent of all choices as well as the Floer data responsible for the bimodule <math id="S13.SS4.SSS5.p3.m2" class="ltx_Math" alttext="{\mathbb{B}}^{\mathbb{OF}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><mi>𝕆</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">{\mathbb{B}}^{\mathbb{OF}}</annotation></semantics></math>. Moreover, <math id="S13.SS4.SSS5.p3.m3" class="ltx_Math" alttext="\Phi^{\mathbb{OF}}(\Theta)" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><mrow><mi>𝕆</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Phi^{\mathbb{OF}}(\Theta)</annotation></semantics></math> is compatible with continuation maps up to homotopy. As the differential of <math id="S13.SS4.SSS5.p3.m4" class="ltx_Math" alttext="C_{*}(\mathbb{O})" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝕆</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{*}(\mathbb{O})</annotation></semantics></math> is trivial, the image of <math id="S13.SS4.SSS5.p3.m5" class="ltx_Math" alttext="1\in{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">1\in{\mathbb{Z}}</annotation></semantics></math> is closed and its homology class is well-defined. Therefore, one obtains a well-defined element</p>
<table id="S13.Ex43" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex43.m1" class="ltx_Math" alttext="{\bf 1}\in HF_{*}(X,\omega;\Lambda_{\mathbb{Z}}^{\Pi})." display="block" intent=":literal"><semantics><mrow><mrow><mn>𝟏</mn><mo>∈</mo><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>ω</mi><mo>,</mo><msubsup><mi mathvariant="normal">Λ</mi><mi>ℤ</mi><mi mathvariant="normal">Π</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\bf 1}\in HF_{*}(X,\omega;\Lambda_{\mathbb{Z}}^{\Pi}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S13.SS4.SSS5.p4" class="ltx_para ltx_noindent">
<p id="S13.SS4.SSS5.p4.1" class="ltx_p">We prove that <math id="S13.SS4.SSS5.p4.m1" class="ltx_Math" alttext="{\bf 1}" display="inline" intent=":literal"><semantics><mn>𝟏</mn><annotation encoding="application/x-tex">{\bf 1}</annotation></semantics></math> is the multiplicative identity. This follows from a particular concatenation of multimodules and Lemma <a href="#S13.Thmthm5" title="Lemma 13.5. ‣ 13.2.3. Concatenation and gluing ‣ 13.2. General construction of chain maps and homotopics ‣ 13. Proof of the Main Theorems ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13.5</span></a>. Consider the concatenation of the bimodule <math id="S13.SS4.SSS5.p4.m2" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{OF}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><mi>𝕆</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{OF}}</annotation></semantics></math> with a multimodule <math id="S13.SS4.SSS5.p4.m3" class="ltx_Math" alttext="{\mathbb{X}}" display="inline" intent=":literal"><semantics><mi>𝕏</mi><annotation encoding="application/x-tex">{\mathbb{X}}</annotation></semantics></math> over <math id="S13.SS4.SSS5.p4.m4" class="ltx_Math" alttext="({\mathbb{F}},{\mathbb{F}}^{\prime};{\mathbb{F}}^{\prime\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝔽</mi><mo>,</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo>,</mo><msup><mi>𝔽</mi><mo>′′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}},{\mathbb{F}}^{\prime};{\mathbb{F}}^{\prime\prime})</annotation></semantics></math> for pair-of-pants product. One can see that by gluing the Floer data, the concatenation is homotopic to a bimodule for continuation map <math id="S13.SS4.SSS5.p4.m5" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{F}^{\prime}\mathbb{F}^{\prime\prime}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><msup><mi>𝔽</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔽</mi><mo>′′</mo></msup></mrow></msup><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{F}^{\prime}\mathbb{F}^{\prime\prime}}</annotation></semantics></math>, hence a special case of Situation <a href="#Thmsituationg1" title="Situation Glue(i). ‣ 11.2. Homotopies from gluing ‣ 11. Homotopies of Multimodules ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Glue(i)</span></a>. Therefore, by following similar argument as previous situations where gluing is concerned, one can prove that <math id="S13.SS4.SSS5.p4.m6" class="ltx_Math" alttext="{\bf 1}" display="inline" intent=":literal"><semantics><mn>𝟏</mn><annotation encoding="application/x-tex">{\bf 1}</annotation></semantics></math> is a multiplicative identity. We omit the details. This is Theorem <a href="#Thmthma3" title="Theorem C (Pair-of-pants product). ‣ 1.1.2. Pair-of-pants product ‣ 1.1. Main results on Floer complexes ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C</span></a> (4) and we conclude the proof.</p>
</div>
</section>
</section>
<section id="S13.SS5" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">13.5. </span>Proof of Theorem <a href="#Thmthma4" title="Theorem D (Poincaré duality). ‣ 1.1.3. Poincaré duality ‣ 1.1. Main results on Floer complexes ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D</span></a></h4>

<div id="S13.SS5.p1" class="ltx_para ltx_noindent">
<p id="S13.SS5.p1.1" class="ltx_p">We establish the Floer-theoretic Poincaré duality. Consider the punctured Riemann sphere <math id="S13.SS5.p1.m1" class="ltx_Math" alttext="\Sigma^{\rm PD}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Σ</mi><mi>PD</mi></msup><annotation encoding="application/x-tex">\Sigma^{\rm PD}</annotation></semantics></math> which has two negative ends and no positive end. A Floer datum whose restrictions to the two negative ends are <math id="S13.SS5.p1.m2" class="ltx_Math" alttext="(H_{i}dt,J_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msub><mi>H</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>,</mo><msub><mi>J</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(H_{i}dt,J_{i})</annotation></semantics></math>, <math id="S13.SS5.p1.m3" class="ltx_Math" alttext="i=1,2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">i=1,2</annotation></semantics></math>, leads to the multimodule <math id="S13.SS5.p1.m4" class="ltx_Math" alttext="{\mathbb{X}}^{PD}" display="inline" intent=":literal"><semantics><msup><mi>𝕏</mi><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow></msup><annotation encoding="application/x-tex">{\mathbb{X}}^{PD}</annotation></semantics></math> over <math id="S13.SS5.p1.m5" class="ltx_Math" alttext="({\mathbb{F}}_{1},{\mathbb{F}}_{2};\tilde{\mathbb{O}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝔽</mi><mn>2</mn></msub><mo>,</mo><mover accent="true"><mi>𝕆</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{1},{\mathbb{F}}_{2};\tilde{\mathbb{O}})</annotation></semantics></math> where <math id="S13.SS5.p1.m6" class="ltx_Math" alttext="\tilde{\mathbb{O}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝕆</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{O}}</annotation></semantics></math> is the <math id="S13.SS5.p1.m7" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>-covering of the trivial flow category <math id="S13.SS5.p1.m8" class="ltx_Math" alttext="{\mathbb{O}}" display="inline" intent=":literal"><semantics><mi>𝕆</mi><annotation encoding="application/x-tex">{\mathbb{O}}</annotation></semantics></math>. In particular, <math id="S13.SS5.p1.m9" class="ltx_Math" alttext="{\rm Ob}\tilde{\mathbb{O}}\cong\Pi" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>𝕆</mi><mo>~</mo></mover></mrow><mo>≅</mo><mi mathvariant="normal">Π</mi></mrow><annotation encoding="application/x-tex">{\rm Ob}\tilde{\mathbb{O}}\cong\Pi</annotation></semantics></math>.</p>
</div>
<div id="S13.SS5.p2" class="ltx_para ltx_noindent">
<p id="S13.SS5.p2.1" class="ltx_p">Now we define hte Poincaré pairing on the chain level. By Proposition <a href="#S15.Thmthm4" title="Proposition 15.4. ‣ 15.1. Integral modification of topological energy ‣ 15. Relatively Smooth AMS lifts ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15.4</span></a>, one can choose integral actions on <math id="S13.SS5.p2.m1" class="ltx_Math" alttext="{\mathbb{F}}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝔽</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\mathbb{F}}_{1}</annotation></semantics></math>, <math id="S13.SS5.p2.m2" class="ltx_Math" alttext="{\mathbb{F}}_{2}" display="inline" intent=":literal"><semantics><msub><mi>𝔽</mi><mn>2</mn></msub><annotation encoding="application/x-tex">{\mathbb{F}}_{2}</annotation></semantics></math> compatible with respect to <math id="S13.SS5.p2.m3" class="ltx_Math" alttext="{\mathbb{X}}^{\rm PD}" display="inline" intent=":literal"><semantics><msup><mi>𝕏</mi><mi>PD</mi></msup><annotation encoding="application/x-tex">{\mathbb{X}}^{\rm PD}</annotation></semantics></math>. Fix an outercollaring width. By Theorem <a href="#Thmthma1" title="Theorem A (Floer chain complex). ‣ 1.1.1. Floer complexes and Floer homology ‣ 1.1. Main results on Floer complexes ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A</span></a>, one obtains chain complexes</p>
<table id="S13.Ex44" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex44.m1" class="ltx_Math" alttext="CF_{*}(H_{1},J_{1},\Xi_{1}),\ CF_{*}(H_{2},J_{2},\Xi_{2})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>1</mn></msub><mo>,</mo><msub><mi>J</mi><mn>1</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>2</mn></msub><mo>,</mo><msub><mi>J</mi><mn>2</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">CF_{*}(H_{1},J_{1},\Xi_{1}),\ CF_{*}(H_{2},J_{2},\Xi_{2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.SS5.p2.2" class="ltx_p">Then the general construction of chain maps provided in Subsection <a href="#S13.SS2" title="13.2. General construction of chain maps and homotopics ‣ 13. Proof of the Main Theorems ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13.2</span></a> provides</p>
<table id="S13.Ex45" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex45.m1" class="ltx_Math" alttext="\Phi^{\rm PD}:CF_{*}(H_{1},J_{1},\Xi_{1})\otimes CF_{*}(H_{2},J_{2},\Xi_{2})\to C_{*}(\tilde{\mathbb{O}})\cong\Lambda^{\Pi}." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">Φ</mi><mi>PD</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>1</mn></msub><mo>,</mo><msub><mi>J</mi><mn>1</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mn>1</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>2</mn></msub><mo>,</mo><msub><mi>J</mi><mn>2</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi>C</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝕆</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><msup><mi mathvariant="normal">Λ</mi><mi mathvariant="normal">Π</mi></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Phi^{\rm PD}:CF_{*}(H_{1},J_{1},\Xi_{1})\otimes CF_{*}(H_{2},J_{2},\Xi_{2})\to C_{*}(\tilde{\mathbb{O}})\cong\Lambda^{\Pi}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S13.SS5.p3" class="ltx_para ltx_noindent">
<p id="S13.SS5.p3.1" class="ltx_p">In the same way as proving independence of choices, one can see that <math id="S13.SS5.p3.m1" class="ltx_Math" alttext="\Phi^{\rm PD}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mi>PD</mi></msup><annotation encoding="application/x-tex">\Phi^{\rm PD}</annotation></semantics></math> has a well-defined homotopy type which does not depend on choices made for the AMS construction and FOP perturbations. It is also compatible with continuation maps, and compatible with the comparison between different choices of integral actions (here we do not need lateral lines). Hence the Poincaré pairing is well-defined.</p>
</div>
<div id="S13.SS5.p4" class="ltx_para ltx_noindent">
<p id="S13.SS5.p4.1" class="ltx_p">We need to prove the compatibility between the Poincaré pairing and the pair-of-pants product. In fact this is similar to the proof of the associativity of the pair-of-pants product, using the concatenation of a multimodule <math id="S13.SS5.p4.m1" class="ltx_Math" alttext="{\mathbb{X}}" display="inline" intent=":literal"><semantics><mi>𝕏</mi><annotation encoding="application/x-tex">{\mathbb{X}}</annotation></semantics></math> (for the pair-of-pants products) and <math id="S13.SS5.p4.m2" class="ltx_Math" alttext="{\mathbb{X}}^{\rm PD}" display="inline" intent=":literal"><semantics><msup><mi>𝕏</mi><mi>PD</mi></msup><annotation encoding="application/x-tex">{\mathbb{X}}^{\rm PD}</annotation></semantics></math> and a gluing construction, utilizing Lemma <a href="#S13.Thmthm4" title="Lemma 13.4. ‣ 13.2.2. Homotopy ‣ 13.2. General construction of chain maps and homotopics ‣ 13. Proof of the Main Theorems ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13.4</span></a> and Lemma <a href="#S13.Thmthm5" title="Lemma 13.5. ‣ 13.2.3. Concatenation and gluing ‣ 13.2. General construction of chain maps and homotopics ‣ 13. Proof of the Main Theorems ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13.5</span></a>. We omit the details.</p>
</div>
<div id="S13.SS5.p5" class="ltx_para ltx_noindent">
<p id="S13.SS5.p5.1" class="ltx_p">Lastly, we prove the nondegeneracy of the Poincaré pairing with field coefficients. We only need to prove it on the homology level. We make use of the PSS map <math id="S13.SS5.p5.m1" class="ltx_Math" alttext="\Phi^{\mathbb{MF}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\Phi^{\mathbb{MF}}</annotation></semantics></math> regarded as a map on homology. One can see that the composition</p>
<table id="S13.Ex46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex46.m1" class="ltx_Math" alttext="\Phi^{\rm PD}\circ(\Phi^{\mathbb{MF}}\otimes\Phi^{\mathbb{MF}})" display="block" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><mi>PD</mi></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi mathvariant="normal">Φ</mi><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mi mathvariant="normal">Φ</mi><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Phi^{\rm PD}\circ(\Phi^{\mathbb{MF}}\otimes\Phi^{\mathbb{MF}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.SS5.p5.2" class="ltx_p">is a bilinear pairing on <math id="S13.SS5.p5.m2" class="ltx_Math" alttext="H_{*}(M;\Lambda_{\bf K}^{\Pi})" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><msubsup><mi mathvariant="normal">Λ</mi><mi>𝐊</mi><mi mathvariant="normal">Π</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{*}(M;\Lambda_{\bf K}^{\Pi})</annotation></semantics></math>. The pairing has a leading order term which can be identified with the classical Poincaré pairing on the integral homology of <math id="S13.SS5.p5.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. Hence the induced pairing is still nondegenerate on the Morse homology (tensoring with <math id="S13.SS5.p5.m4" class="ltx_Math" alttext="\Lambda_{\bf K}^{\Pi}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><mi>𝐊</mi><mi mathvariant="normal">Π</mi></msubsup><annotation encoding="application/x-tex">\Lambda_{\bf K}^{\Pi}</annotation></semantics></math>). As the PSS map is an isomorphism on homology (Theorem <a href="#Thmthma6" title="Theorem F. ‣ 1.1.4. PSS map and isomorphism ‣ 1.1. Main results on Floer complexes ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F</span></a>), it implies that the Poincaré pairing on the Floer homology is also nondegenerate. This finishes the proof of Theorem <a href="#Thmthma4" title="Theorem D (Poincaré duality). ‣ 1.1.3. Poincaré duality ‣ 1.1. Main results on Floer complexes ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D</span></a>.</p>
</div>
</section>
<section id="S13.SS6" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">13.6. </span>Proof of Theorem <a href="#Thmthma5" title="Theorem E (PSS and SSP maps). ‣ 1.1.4. PSS map and isomorphism ‣ 1.1. Main results on Floer complexes ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E</span></a></h4>

<div id="S13.SS6.p1" class="ltx_para ltx_noindent">
<p id="S13.SS6.p1.1" class="ltx_p">The definition of the PSS and the SSP maps are simply special cases of general chain maps induced from bimodules. Fix a Floer flow category <math id="S13.SS6.p1.m1" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> on <math id="S13.SS6.p1.m2" class="ltx_Math" alttext="(X,\omega)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>ω</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(X,\omega)</annotation></semantics></math> associated to a pair <math id="S13.SS6.p1.m3" class="ltx_Math" alttext="(H,J)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>J</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(H,J)</annotation></semantics></math>. To simplify the argument we assume <math id="S13.SS6.p1.m4" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math> is time-independent; the general case can be treated with continuation maps. The same data provide the diagonal bimodule <math id="S13.SS6.p1.m5" class="ltx_Math" alttext="\mathbb{\Delta}^{\mathbb{FF}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{\Delta}^{\mathbb{FF}}</annotation></semantics></math>. Choose a Morse–Smale pair <math id="S13.SS6.p1.m6" class="ltx_Math" alttext="(f,g)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(f,g)</annotation></semantics></math> on <math id="S13.SS6.p1.m7" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>. Then one has the Morse flow category <math id="S13.SS6.p1.m8" class="ltx_Math" alttext="{\mathbb{M}}" display="inline" intent=":literal"><semantics><mi>𝕄</mi><annotation encoding="application/x-tex">{\mathbb{M}}</annotation></semantics></math> associated to <math id="S13.SS6.p1.m9" class="ltx_Math" alttext="(f,g)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(f,g)</annotation></semantics></math>. Choosing an interpolation between <math id="S13.SS6.p1.m10" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> and <math id="S13.SS6.p1.m11" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>, one obtains a Floer-to-Morse bimodule <math id="S13.SS6.p1.m12" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{FM}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{FM}}</annotation></semantics></math>; a backward interpolation provides a Morse-to-Floer bimodule <math id="S13.SS6.p1.m13" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{MF}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{MF}}</annotation></semantics></math>.</p>
</div>
<div id="S13.SS6.p2" class="ltx_para ltx_noindent">
<p id="S13.SS6.p2.1" class="ltx_p">Fix a common outercollaring width. Choose an integral action <math id="S13.SS6.p2.m1" class="ltx_Math" alttext="{\mathcal{A}}_{\mathbb{F}}^{\Omega}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>𝔽</mi><mi mathvariant="normal">Ω</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{A}}_{\mathbb{F}}^{\Omega}</annotation></semantics></math> on <math id="S13.SS6.p2.m2" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> which are compatible with all bimodules and homotopies involved in the discussion. Then Theorem <a href="#Thmthma1" title="Theorem A (Floer chain complex). ‣ 1.1.1. Floer complexes and Floer homology ‣ 1.1. Main results on Floer complexes ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A</span></a> provides a Floer complex <math id="S13.SS6.p2.m3" class="ltx_Math" alttext="CF_{*}(H,J,\Xi)" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>J</mi><mo>,</mo><mi mathvariant="normal">Ξ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF_{*}(H,J,\Xi)</annotation></semantics></math> depending on choices, which involve an AMS lift <math id="S13.SS6.p2.m4" class="ltx_Math" alttext="\tilde{\mathbb{F}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{F}}</annotation></semantics></math> subject to the outercollaring width and the integral action, and an FOP perturbation <math id="S13.SS6.p2.m5" class="ltx_Math" alttext="\mathring{\mathbb{F}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><annotation encoding="application/x-tex">\mathring{\mathbb{F}}</annotation></semantics></math>. Then by Theorem <a href="#Thmthma19" title="Theorem S. ‣ 12.3. Bimodules and homotopies associated to PSS type maps ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">S</span></a>, one can find AMS lifts <math id="S13.SS6.p2.m6" class="ltx_Math" alttext="\tilde{\mathbb{B}}^{\mathbb{MF}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝔹</mi><mo>~</mo></mover><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\tilde{\mathbb{B}}^{\mathbb{MF}}</annotation></semantics></math> and <math id="S13.SS6.p2.m7" class="ltx_Math" alttext="\tilde{\mathbb{B}}^{\mathbb{FM}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝔹</mi><mo>~</mo></mover><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msup><annotation encoding="application/x-tex">\tilde{\mathbb{B}}^{\mathbb{FM}}</annotation></semantics></math> (which are enriched in <math id="S13.SS6.p2.m8" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf dOrb}}^{\rm NC}_{\rm rig}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><msup><mrow></mrow><mi>NC</mi></msup><msub><mrow></mrow><mi>rig</mi></msub></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf dOrb}}^{\rm NC}_{\rm rig}</annotation></semantics></math>) of <math id="S13.SS6.p2.m9" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{MF}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{MF}}</annotation></semantics></math> and <math id="S13.SS6.p2.m10" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{FM}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{FM}}</annotation></semantics></math>. Notice that <math id="S13.SS6.p2.m11" class="ltx_math_unparsed" alttext="{}_{\lfloor}{\mathbb{M}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝕄</mi></mrow><annotation encoding="application/x-tex">{}_{\lfloor}{\mathbb{M}}</annotation></semantics></math> can be viewed as enriched in <math id="S13.SS6.p2.m12" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm FOP}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>FOP</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm FOP}</annotation></semantics></math>. Then the FOP perturbation <math id="S13.SS6.p2.m13" class="ltx_Math" alttext="\mathring{\mathbb{F}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><annotation encoding="application/x-tex">\mathring{\mathbb{F}}</annotation></semantics></math> can be extended, by Theorem <a href="#Thmthma14" title="Theorem N. ‣ 8.2. FOP perturbations on flow categories, multimodules, and homotopies ‣ 8. FOP Perturbations ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">N</span></a>, to an FOP perturbation <math id="S13.SS6.p2.m14" class="ltx_Math" alttext="\mathring{\mathbb{B}}^{\mathbb{MF}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝔹</mi><mo>̊</mo></mover><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\mathring{\mathbb{B}}^{\mathbb{MF}}</annotation></semantics></math> and an FOP perturbation <math id="S13.SS6.p2.m15" class="ltx_Math" alttext="\mathring{\mathbb{B}}^{\mathbb{FM}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝔹</mi><mo>̊</mo></mover><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msup><annotation encoding="application/x-tex">\mathring{\mathbb{B}}^{\mathbb{FM}}</annotation></semantics></math>. Then one obtains chain maps</p>
<table id="S13.EGx43" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S13.Ex47"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S13.Ex47.m1" class="ltx_Math" alttext="\displaystyle\ \Phi^{\mathbb{MF}}:CM_{*}(f,g)\to CF_{*}(H,J,\Xi),\ " display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">Φ</mi><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>J</mi><mo>,</mo><mi mathvariant="normal">Ξ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ \Phi^{\mathbb{MF}}:CM_{*}(f,g)\to CF_{*}(H,J,\Xi),\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S13.Ex47.m2" class="ltx_Math" alttext="\displaystyle\ \Phi^{\mathbb{FM}}:CF_{*}(H,J,\Xi)\to CM_{*}(f,g)." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">Φ</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>J</mi><mo>,</mo><mi mathvariant="normal">Ξ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ \Phi^{\mathbb{FM}}:CF_{*}(H,J,\Xi)\to CM_{*}(f,g).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.SS6.p2.2" class="ltx_p">We call them the <span id="S13.SS6.p2.2.1" class="ltx_text ltx_font_bold">chain-level PSS map</span> and the <span id="S13.SS6.p2.2.2" class="ltx_text ltx_font_bold">chain-level SSP map</span>.</p>
</div>
<div id="S13.SS6.p3" class="ltx_para ltx_noindent">
<p id="S13.SS6.p3.1" class="ltx_p">Using similar argument as the case of continuation maps, based on part of Theorem <a href="#Thmthma19" title="Theorem S. ‣ 12.3. Bimodules and homotopies associated to PSS type maps ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">S</span></a> and Theorem <a href="#S12.Thmthm6" title="Theorem 12.6. ‣ 12.3. Bimodules and homotopies associated to PSS type maps ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12.6</span></a>, one can show that the homotopy classes of the PSS and SSP maps are independent of the choices made for constructing the AMS lifts or the FOP lifts. Moreover, using homotopies realized by gluing Floer cylinders, one can show that the PSS and SSP maps are compatible with continuation maps. Namely, the composition of a chain-level PSS map resp. a chain-level SSP map with a chain-level continuation map (in the right way) is homotopic to a chain-level PSS resp. a chain-level SSP map. This finishes the proof of Theorem <a href="#Thmthma5" title="Theorem E (PSS and SSP maps). ‣ 1.1.4. PSS map and isomorphism ‣ 1.1. Main results on Floer complexes ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E</span></a>.</p>
</div>
</section>
<section id="S13.SS7" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">13.7. </span>Proof of Theorem <a href="#Thmthma6" title="Theorem F. ‣ 1.1.4. PSS map and isomorphism ‣ 1.1. Main results on Floer complexes ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F</span></a></h4>

<div id="S13.SS7.p1" class="ltx_para ltx_noindent">
<p id="S13.SS7.p1.1" class="ltx_p">To prove Theorem <a href="#Thmthma6" title="Theorem F. ‣ 1.1.4. PSS map and isomorphism ‣ 1.1. Main results on Floer complexes ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F</span></a>, what remains to show is that the PSS and SSP maps are chain homotopy equivalences. We remind the reader again that the PSS and SSP maps are not known to be homotopy inverses to each other. To make the comparison, we need to go through the pearly flow category <math id="S13.SS7.p1.m1" class="ltx_Math" alttext="\mathbb{P}" display="inline" intent=":literal"><semantics><mi>ℙ</mi><annotation encoding="application/x-tex">\mathbb{P}</annotation></semantics></math>.</p>
</div>
<div id="S13.SS7.p2" class="ltx_para ltx_noindent">
<p id="S13.SS7.p2.1" class="ltx_p">Keep the data fixed in the proof of Theorem <a href="#Thmthma5" title="Theorem E (PSS and SSP maps). ‣ 1.1.4. PSS map and isomorphism ‣ 1.1. Main results on Floer complexes ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E</span></a>. Then the Morse–Smale pair <math id="S13.SS7.p2.m1" class="ltx_Math" alttext="(f,g)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(f,g)</annotation></semantics></math> and the almost complex structure <math id="S13.SS7.p2.m2" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math> also determines the pearly flow category <math id="S13.SS7.p2.m3" class="ltx_Math" alttext="\mathbb{P}" display="inline" intent=":literal"><semantics><mi>ℙ</mi><annotation encoding="application/x-tex">\mathbb{P}</annotation></semantics></math> (see Subsection <a href="#S9.SS3" title="9.3. The pearly flow category ‣ 9. Geometric Flow Categories ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9.3</span></a>). Meanwhile, one has the diagonal bimodules</p>
<table id="S13.Ex48" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex48.m1" class="ltx_Math" alttext="\mathbb{\Delta}^{\mathbb{FF}},\mathbb{\Delta}^{\mathbb{MM}},\ \mathbb{\Delta}^{\mathbb{PP}}" display="block" intent=":literal"><semantics><mrow><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><mo>,</mo><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msup><mo rspace="0.667em">,</mo><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbb{\Delta}^{\mathbb{FF}},\mathbb{\Delta}^{\mathbb{MM}},\ \mathbb{\Delta}^{\mathbb{PP}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.SS7.p2.2" class="ltx_p">and the Morse-to-pearly bimodule <math id="S13.SS7.p2.m4" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{MP}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{MP}}</annotation></semantics></math>, pearly-to-Morse bimodule <math id="S13.SS7.p2.m5" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{PM}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{PM}}</annotation></semantics></math>. Using the same Floer data on the infinite cylinder defining the bimodules <math id="S13.SS7.p2.m6" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{MF}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{MF}}</annotation></semantics></math>, <math id="S13.SS7.p2.m7" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{FM}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{FM}}</annotation></semantics></math> also provides the Floer-to-pearly bimodule <math id="S13.SS7.p2.m8" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{FP}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{FP}}</annotation></semantics></math> and the pearly-to-Floer bimodule <math id="S13.SS7.p2.m9" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{PF}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{PF}}</annotation></semantics></math>. Moreover, one can build homotopies realizing the commutativity-up-to-homotopy of each triangle of the diagram (<a href="#S11.E1" title="In 11.3. Homotopies associated to PSS type moduli spaces ‣ 11. Homotopies of Multimodules ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11.1</span></a>).</p>
</div>
<div id="S13.SS7.p3" class="ltx_para ltx_noindent">
<p id="S13.SS7.p3.1" class="ltx_p">Fix an outercollaring width. Choose an integral action on <math id="S13.SS7.p3.m1" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> which is compatible with respect to all involved bimodules and homotopies. Then upon making choices, one obtains the Floer chain complex <math id="S13.SS7.p3.m2" class="ltx_Math" alttext="CF_{*}(H,J,\Xi)" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>J</mi><mo>,</mo><mi mathvariant="normal">Ξ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF_{*}(H,J,\Xi)</annotation></semantics></math> by Theorem <a href="#Thmthma1" title="Theorem A (Floer chain complex). ‣ 1.1.1. Floer complexes and Floer homology ‣ 1.1. Main results on Floer complexes ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A</span></a> and the PSS and SSP maps as in the proof of Theorem <a href="#Thmthma5" title="Theorem E (PSS and SSP maps). ‣ 1.1.4. PSS map and isomorphism ‣ 1.1. Main results on Floer complexes ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E</span></a>.</p>
</div>
<div id="S13.SS7.p4" class="ltx_para ltx_noindent">
<p id="S13.SS7.p4.1" class="ltx_p">Moreover, by Theorem <a href="#S12.Thmthm7" title="Theorem 12.7. ‣ 12.3.1. PSS maps and pearly flow category ‣ 12.3. Bimodules and homotopies associated to PSS type maps ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12.7</span></a>, upon making choices, one can construct an AMS lift of the outercollaring of <math id="S13.SS7.p4.m1" class="ltx_Math" alttext="{\mathbb{P}}" display="inline" intent=":literal"><semantics><mi>ℙ</mi><annotation encoding="application/x-tex">{\mathbb{P}}</annotation></semantics></math> to <math id="S13.SS7.p4.m2" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>NC</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}</annotation></semantics></math>, denoted by <math id="S13.SS7.p4.m3" class="ltx_Math" alttext="\tilde{\mathbb{P}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ℙ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{P}}</annotation></semantics></math>. By choosing an FOP perturbation <math id="S13.SS7.p4.m4" class="ltx_Math" alttext="\mathring{\mathbb{P}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ℙ</mi><mo>̊</mo></mover><annotation encoding="application/x-tex">\mathring{\mathbb{P}}</annotation></semantics></math> (granted by Theorem <a href="#Thmthma14" title="Theorem N. ‣ 8.2. FOP perturbations on flow categories, multimodules, and homotopies ‣ 8. FOP Perturbations ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">N</span></a>), one obtains a chain complex</p>
<table id="S13.Ex49" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex49.m1" class="ltx_Math" alttext="CP_{*}(f,g,J,\Theta)" display="block" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo>,</mo><mi>J</mi><mo>,</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CP_{*}(f,g,J,\Theta)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.SS7.p4.2" class="ltx_p">where <math id="S13.SS7.p4.m5" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math> represents all the choices, including the outercollaring width, the integral symplectic form contained in <math id="S13.SS7.p4.m6" class="ltx_Math" alttext="{\mathcal{A}}_{\mathbb{F}}^{\Omega}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>𝔽</mi><mi mathvariant="normal">Ω</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{A}}_{\mathbb{F}}^{\Omega}</annotation></semantics></math>, the choices made for constructing <math id="S13.SS7.p4.m7" class="ltx_Math" alttext="\tilde{\mathbb{P}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ℙ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{P}}</annotation></semantics></math>, and the FOP perturbation. Then Theorem <a href="#S12.Thmthm7" title="Theorem 12.7. ‣ 12.3.1. PSS maps and pearly flow category ‣ 12.3. Bimodules and homotopies associated to PSS type maps ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12.7</span></a> also provides a lift <math id="S13.SS7.p4.m8" class="ltx_Math" alttext="\tilde{\mathbb{\Delta}}^{\mathbb{PP}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mo>~</mo></mover><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><annotation encoding="application/x-tex">\tilde{\mathbb{\Delta}}^{\mathbb{PP}}</annotation></semantics></math> of the outercollaring of <math id="S13.SS7.p4.m9" class="ltx_Math" alttext="\mathbb{\Delta}^{\mathbb{PP}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{\Delta}^{\mathbb{PP}}</annotation></semantics></math> as a bimodule over <math id="S13.SS7.p4.m10" class="ltx_Math" alttext="(\tilde{\mathbb{P}};\tilde{\mathbb{P}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>ℙ</mi><mo>~</mo></mover><mo>;</mo><mover accent="true"><mi>ℙ</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\tilde{\mathbb{P}};\tilde{\mathbb{P}})</annotation></semantics></math>. Then Theorem <a href="#Thmthma14" title="Theorem N. ‣ 8.2. FOP perturbations on flow categories, multimodules, and homotopies ‣ 8. FOP Perturbations ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">N</span></a> allows us to extend the FOP perturbations <math id="S13.SS7.p4.m11" class="ltx_Math" alttext="\mathring{\mathbb{P}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ℙ</mi><mo>̊</mo></mover><annotation encoding="application/x-tex">\mathring{\mathbb{P}}</annotation></semantics></math> to an FOP perturbation <math id="S13.SS7.p4.m12" class="ltx_Math" alttext="\mathring{\mathbb{\Delta}}^{\mathbb{PP}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mo>̊</mo></mover><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><annotation encoding="application/x-tex">\mathring{\mathbb{\Delta}}^{\mathbb{PP}}</annotation></semantics></math>. Then one obtains a chain map</p>
<table id="S13.Ex50" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex50.m1" class="ltx_Math" alttext="\Phi^{\mathbb{PP}}:CP_{*}(f,g,J,\Theta)\to CP_{*}(f,g,J,\Theta)." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">Φ</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo>,</mo><mi>J</mi><mo>,</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo>,</mo><mi>J</mi><mo>,</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Phi^{\mathbb{PP}}:CP_{*}(f,g,J,\Theta)\to CP_{*}(f,g,J,\Theta).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S13.SS7.p5" class="ltx_para ltx_noindent">
<p id="S13.SS7.p5.1" class="ltx_p">Based on the above constructions and choices, Theorem <a href="#Thmthma20" title="Theorem T. ‣ 12.3.2. The triangle of Morse, Floer and pearly flow categories ‣ 12.3. Bimodules and homotopies associated to PSS type maps ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">T</span></a> guarantees the existence of chain maps</p>
<table id="S13.EGx44" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S13.Ex51"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S13.Ex51.m1" class="ltx_Math" alttext="\displaystyle\ \Phi^{\mathbb{FP}}:CF_{*}(H,J,\Xi)\to CP_{*}(f,g,J,\Theta),\ " display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">Φ</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>J</mi><mo>,</mo><mi mathvariant="normal">Ξ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo>,</mo><mi>J</mi><mo>,</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ \Phi^{\mathbb{FP}}:CF_{*}(H,J,\Xi)\to CP_{*}(f,g,J,\Theta),\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S13.Ex51.m2" class="ltx_Math" alttext="\displaystyle\ \Phi^{\mathbb{PF}}:CP_{*}(f,g,J,\Theta)\to CF_{*}(H,J,\Xi)." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">Φ</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo>,</mo><mi>J</mi><mo>,</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>J</mi><mo>,</mo><mi mathvariant="normal">Ξ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ \Phi^{\mathbb{PF}}:CP_{*}(f,g,J,\Theta)\to CF_{*}(H,J,\Xi).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.SS7.p5.2" class="ltx_p">and</p>
<table id="S13.EGx45" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S13.Ex52"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S13.Ex52.m1" class="ltx_Math" alttext="\displaystyle\ \Phi^{\mathbb{PM}}:CP_{*}(f,g,J,\Theta)\to CM_{*}(f,g)\otimes\Lambda^{\Pi},\ " display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">Φ</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo>,</mo><mi>J</mi><mo>,</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msup><mi mathvariant="normal">Λ</mi><mi mathvariant="normal">Π</mi></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ \Phi^{\mathbb{PM}}:CP_{*}(f,g,J,\Theta)\to CM_{*}(f,g)\otimes\Lambda^{\Pi},\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S13.Ex52.m2" class="ltx_Math" alttext="\displaystyle\ \Phi^{\mathbb{MP}}:CM_{*}(f,g)\otimes\Lambda^{\Pi}\to CP_{*}(f,g,J,\Theta)." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">Φ</mi><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msup><mi mathvariant="normal">Λ</mi><mi mathvariant="normal">Π</mi></msup></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo>,</mo><mi>J</mi><mo>,</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ \Phi^{\mathbb{MP}}:CM_{*}(f,g)\otimes\Lambda^{\Pi}\to CP_{*}(f,g,J,\Theta).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S13.Thmthm9" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S13.Thmthm9.2" class="ltx_text ltx_font_bold">Lemma 13.9</span></span><span id="S13.Thmthm9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S13.Thmthm9.p1" class="ltx_para">
<p id="S13.Thmthm9.p1.1" class="ltx_p"><math id="S13.Thmthm9.p1.m1" class="ltx_Math" alttext="\Phi^{\mathbb{FM}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msup><annotation encoding="application/x-tex">\Phi^{\mathbb{FM}}</annotation></semantics></math><span id="S13.Thmthm9.p1.1.1" class="ltx_text ltx_font_italic"> is chain homotopic to <math id="S13.Thmthm9.p1.m2" class="ltx_Math" alttext="\Phi^{\mathbb{PM}}\circ\Phi^{\mathbb{FP}}" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi mathvariant="normal">Φ</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\Phi^{\mathbb{PM}}\circ\Phi^{\mathbb{FP}}</annotation></semantics></math> and <math id="S13.Thmthm9.p1.m3" class="ltx_Math" alttext="\Phi^{\mathbb{MF}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\Phi^{\mathbb{MF}}</annotation></semantics></math> is chain homotopic to <math id="S13.Thmthm9.p1.m4" class="ltx_Math" alttext="\Phi^{\mathbb{PF}}\circ\Phi^{\mathbb{MP}}" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi mathvariant="normal">Φ</mi><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\Phi^{\mathbb{PF}}\circ\Phi^{\mathbb{MP}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S13.SS7.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S13.SS7.p6" class="ltx_para">
<p id="S13.SS7.p6.1" class="ltx_p"><span id="S13.SS7.p6.1.1" class="ltx_text">One has fixed a specific homotopy <math id="S13.SS7.p6.m1" class="ltx_Math" alttext="\mathbb{H}" display="inline" intent=":literal"><semantics><mi>ℍ</mi><annotation encoding="application/x-tex">\mathbb{H}</annotation></semantics></math> from the concatenation <math id="S13.SS7.p6.m2" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{FP}}\circ\mathbb{B}^{\mathbb{PM}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝔹</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>𝔹</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{FP}}\circ\mathbb{B}^{\mathbb{PM}}</annotation></semantics></math> to <math id="S13.SS7.p6.m3" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{FM}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{FM}}</annotation></semantics></math>. By Theorem <a href="#S12.Thmthm4" title="Theorem 12.4. ‣ 12.2. Multimodules and homotopies ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12.4</span></a>, there exists a concatenation <math id="S13.SS7.p6.m4" class="ltx_Math" alttext="\tilde{\mathbb{B}}^{\mathbb{FP}}\circ\tilde{\mathbb{B}}^{\mathbb{PM}}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>𝔹</mi><mo>~</mo></mover><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mover accent="true"><mi>𝔹</mi><mo>~</mo></mover><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\tilde{\mathbb{B}}^{\mathbb{FP}}\circ\tilde{\mathbb{B}}^{\mathbb{PM}}</annotation></semantics></math> enriched in <math id="S13.SS7.p6.m5" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>NC</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}</annotation></semantics></math>. Then by Theorem <a href="#S19.Thmthm5" title="Theorem 19.5. ‣ 19.2.2. Gluing ‣ 19.2. Relatively smooth AMS lifts for concatenations and gluing ‣ 19. Concatenation and Gluing—Proof of Theorem ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19.5</span></a>, there exists a lift <math id="S13.SS7.p6.m6" class="ltx_Math" alttext="\tilde{\mathbb{H}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ℍ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{H}}</annotation></semantics></math> of the outercollaring of <math id="S13.SS7.p6.m7" class="ltx_Math" alttext="{\mathbb{H}}" display="inline" intent=":literal"><semantics><mi>ℍ</mi><annotation encoding="application/x-tex">{\mathbb{H}}</annotation></semantics></math> to <math id="S13.SS7.p6.m8" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>NC</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}</annotation></semantics></math> as a homotopy from <math id="S13.SS7.p6.m9" class="ltx_Math" alttext="\tilde{\mathbb{B}}^{\mathbb{FP}}\circ\tilde{\mathbb{B}}^{\mathbb{PM}}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>𝔹</mi><mo>~</mo></mover><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mover accent="true"><mi>𝔹</mi><mo>~</mo></mover><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\tilde{\mathbb{B}}^{\mathbb{FP}}\circ\tilde{\mathbb{B}}^{\mathbb{PM}}</annotation></semantics></math> to <math id="S13.SS7.p6.m10" class="ltx_Math" alttext="\tilde{\mathbb{B}}^{\mathbb{FM}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝔹</mi><mo>~</mo></mover><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msup><annotation encoding="application/x-tex">\tilde{\mathbb{B}}^{\mathbb{FM}}</annotation></semantics></math>. Moreover, Proposition <a href="#S8.Thmthm6" title="Proposition 8.6. ‣ 8.3. FOP perturbation and multimodule concatenations ‣ 8. FOP Perturbations ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8.6</span></a> allows us to have a concatenation <math id="S13.SS7.p6.m11" class="ltx_Math" alttext="\mathring{\mathbb{B}}^{\mathbb{FP}}\circ\mathring{\mathbb{B}}^{\mathbb{PM}}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>𝔹</mi><mo>̊</mo></mover><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mover accent="true"><mi>𝔹</mi><mo>̊</mo></mover><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathring{\mathbb{B}}^{\mathbb{FP}}\circ\mathring{\mathbb{B}}^{\mathbb{PM}}</annotation></semantics></math>. Then Theorem <a href="#Thmthma14" title="Theorem N. ‣ 8.2. FOP perturbations on flow categories, multimodules, and homotopies ‣ 8. FOP Perturbations ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">N</span></a> allows us to extend this concatenation and the FOP perturbation <math id="S13.SS7.p6.m12" class="ltx_Math" alttext="\mathring{\mathbb{B}}^{\mathbb{FM}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝔹</mi><mo>̊</mo></mover><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msup><annotation encoding="application/x-tex">\mathring{\mathbb{B}}^{\mathbb{FM}}</annotation></semantics></math> to an FOP perturbation <math id="S13.SS7.p6.m13" class="ltx_Math" alttext="\mathring{\mathbb{H}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ℍ</mi><mo>̊</mo></mover><annotation encoding="application/x-tex">\mathring{\mathbb{H}}</annotation></semantics></math> on <math id="S13.SS7.p6.m14" class="ltx_Math" alttext="\tilde{\mathbb{H}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ℍ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{H}}</annotation></semantics></math>. Then one obtains a chain homotopy between <math id="S13.SS7.p6.m15" class="ltx_Math" alttext="\Phi^{\mathbb{FM}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msup><annotation encoding="application/x-tex">\Phi^{\mathbb{FM}}</annotation></semantics></math> to <math id="S13.SS7.p6.m16" class="ltx_Math" alttext="\Phi^{\mathbb{PM}}\circ\Phi^{\mathbb{FP}}" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi mathvariant="normal">Φ</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\Phi^{\mathbb{PM}}\circ\Phi^{\mathbb{FP}}</annotation></semantics></math>. The other chain homotopy can be established in the same way.
∎</span></p>
</div>
</div>
<div id="S13.Thmthm10" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S13.Thmthm10.2" class="ltx_text ltx_font_bold">Lemma 13.10</span></span><span id="S13.Thmthm10.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S13.Thmthm10.p1" class="ltx_para">
<p id="S13.Thmthm10.p1.1" class="ltx_p"><math id="S13.Thmthm10.p1.m1" class="ltx_Math" alttext="\Phi^{\mathbb{FP}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><annotation encoding="application/x-tex">\Phi^{\mathbb{FP}}</annotation></semantics></math><span id="S13.Thmthm10.p1.1.1" class="ltx_text ltx_font_italic"> and <math id="S13.Thmthm10.p1.m2" class="ltx_Math" alttext="\Phi^{\mathbb{PF}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\Phi^{\mathbb{PF}}</annotation></semantics></math> are invertible after passing to homology.</span></p>
</div>
</div>
<div id="S13.SS7.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S13.SS7.p7" class="ltx_para">
<p id="S13.SS7.p7.1" class="ltx_p"><span id="S13.SS7.p7.1.1" class="ltx_text">Similar to the above lemma, by Theorem <a href="#Thmthma20" title="Theorem T. ‣ 12.3.2. The triangle of Morse, Floer and pearly flow categories ‣ 12.3. Bimodules and homotopies associated to PSS type maps ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">T</span></a>, using FOP perturbations, one obtains a chain homotopy between <math id="S13.SS7.p7.m1" class="ltx_Math" alttext="\Phi^{\mathbb{PF}}\circ\Phi^{\mathbb{FP}}" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi mathvariant="normal">Φ</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\Phi^{\mathbb{PF}}\circ\Phi^{\mathbb{FP}}</annotation></semantics></math> and the chain-level continuation map associated to the diagonal bimodule <math id="S13.SS7.p7.m2" class="ltx_Math" alttext="\mathbb{\Delta}^{\mathbb{FF}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{\Delta}^{\mathbb{FF}}</annotation></semantics></math>, which is invertible after passing to homology. Via the reversed gluing along the Floer flow category, one obtains a chain homotopy between <math id="S13.SS7.p7.m3" class="ltx_Math" alttext="\Phi^{\mathbb{FP}}\circ\Phi^{\mathbb{PF}}" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Φ</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi mathvariant="normal">Φ</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\Phi^{\mathbb{FP}}\circ\Phi^{\mathbb{PF}}</annotation></semantics></math> and the chain map <math id="S13.SS7.p7.m4" class="ltx_Math" alttext="\Phi^{\mathbb{PP}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><annotation encoding="application/x-tex">\Phi^{\mathbb{PP}}</annotation></semantics></math> associated to the diagonal bimodule <math id="S13.SS7.p7.m5" class="ltx_Math" alttext="\mathbb{\Delta}^{\mathbb{PP}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{\Delta}^{\mathbb{PP}}</annotation></semantics></math>, which is also invertible. Hence <math id="S13.SS7.p7.m6" class="ltx_Math" alttext="\Phi^{\mathbb{PF}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\Phi^{\mathbb{PF}}</annotation></semantics></math> and <math id="S13.SS7.p7.m7" class="ltx_Math" alttext="\Phi^{\mathbb{FP}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><annotation encoding="application/x-tex">\Phi^{\mathbb{FP}}</annotation></semantics></math> are both invertible after passing to homology.
∎</span></p>
</div>
</div>
<div id="S13.Thmthm11" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S13.Thmthm11.2" class="ltx_text ltx_font_bold">Lemma 13.11</span></span><span id="S13.Thmthm11.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S13.Thmthm11.p1" class="ltx_para">
<p id="S13.Thmthm11.p1.1" class="ltx_p"><math id="S13.Thmthm11.p1.m1" class="ltx_Math" alttext="\Phi^{\mathbb{PM}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msup><annotation encoding="application/x-tex">\Phi^{\mathbb{PM}}</annotation></semantics></math><span id="S13.Thmthm11.p1.1.1" class="ltx_text ltx_font_italic"> and <math id="S13.Thmthm11.p1.m2" class="ltx_Math" alttext="\Phi^{\mathbb{MP}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><annotation encoding="application/x-tex">\Phi^{\mathbb{MP}}</annotation></semantics></math> are invertible chain maps.</span></p>
</div>
</div>
<div id="S13.SS7.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S13.SS7.p8" class="ltx_para">
<p id="S13.SS7.p8.1" class="ltx_p"><span id="S13.SS7.p8.1.1" class="ltx_text">Notice that the objects of <math id="S13.SS7.p8.m1" class="ltx_Math" alttext="\mathbb{P}" display="inline" intent=":literal"><semantics><mi>ℙ</mi><annotation encoding="application/x-tex">\mathbb{P}</annotation></semantics></math> and <math id="S13.SS7.p8.m2" class="ltx_Math" alttext="\mathbb{M}" display="inline" intent=":literal"><semantics><mi>𝕄</mi><annotation encoding="application/x-tex">\mathbb{M}</annotation></semantics></math> are identical. Moreover, both <math id="S13.SS7.p8.m3" class="ltx_Math" alttext="\Phi^{\mathbb{PM}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msup><annotation encoding="application/x-tex">\Phi^{\mathbb{PM}}</annotation></semantics></math> and <math id="S13.SS7.p8.m4" class="ltx_Math" alttext="\Phi^{\mathbb{MP}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><annotation encoding="application/x-tex">\Phi^{\mathbb{MP}}</annotation></semantics></math> have leading order term being the identity map. Hence both these two chain maps are invertible.
∎</span></p>
</div>
</div>
<div id="S13.SS7.p9" class="ltx_para ltx_noindent">
<p id="S13.SS7.p9.1" class="ltx_p">Now by the previous three lemmas, <math id="S13.SS7.p9.m1" class="ltx_Math" alttext="\Phi^{\mathbb{FM}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msup><annotation encoding="application/x-tex">\Phi^{\mathbb{FM}}</annotation></semantics></math> and <math id="S13.SS7.p9.m2" class="ltx_Math" alttext="\Phi^{\mathbb{MF}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\Phi^{\mathbb{MF}}</annotation></semantics></math> are chain homotopic to invertible chain maps. Hence they are chain homotopy equivalences. This finishes the proof of Theorem <a href="#Thmthma6" title="Theorem F. ‣ 1.1.4. PSS map and isomorphism ‣ 1.1. Main results on Floer complexes ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F</span></a>.</p>
</div>
</section>
<section id="S13.SS8" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">13.8. </span>Proof of Theorem <a href="#Thmthma7" title="Theorem G. ‣ 1.1.5. Comparison with known construction ‣ 1.1. Main results on Floer complexes ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">G</span></a></h4>

<div id="S13.SS8.p1" class="ltx_para ltx_noindent">
<p id="S13.SS8.p1.1" class="ltx_p">By Hofer–Salamon <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib31" title="" class="ltx_ref">35</a>]</cite> and Ono <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib71" title="" class="ltx_ref">50</a>]</cite> (see also <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib65" title="" class="ltx_ref">23</a>]</cite> and <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib67" title="" class="ltx_ref">46</a>]</cite>), one can choose a time-independent <math id="S13.SS8.p1.m1" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math> and suitable nondegenerate <math id="S13.SS8.p1.m2" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> satisfying</p>
<ol id="S13.I1" class="ltx_enumerate">
<li id="S13.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S13.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="S13.I1.i1.p1.1" class="ltx_p">All simple nonconstant <math id="S13.I1.i1.p1.m1" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math>-holomorphic sphere <math id="S13.I1.i1.p1.m2" class="ltx_Math" alttext="u:S^{2}\to X" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>S</mi><mn>2</mn></msup><mo stretchy="false">→</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">u:S^{2}\to X</annotation></semantics></math> is transverse.</p>
</div></li>
<li id="S13.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S13.I1.i2.p1" class="ltx_para ltx_noindent">
<p id="S13.I1.i2.p1.1" class="ltx_p">When <math id="S13.I1.i2.p1.m1" class="ltx_Math" alttext="{\rm deg}(p)-{\rm deg}(q)\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\rm deg}(p)-{\rm deg}(q)\leq 1</annotation></semantics></math>, <math id="S13.I1.i2.p1.m2" class="ltx_Math" alttext="M_{pq}^{{\mathbb{F}}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><annotation encoding="application/x-tex">M_{pq}^{{\mathbb{F}}}</annotation></semantics></math> is transverse and consists of stable Floer trajectories without sphere bubbles.</p>
</div></li>
<li id="S13.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S13.I1.i3.p1" class="ltx_para">
<p id="S13.I1.i3.p1.1" class="ltx_p">When <math id="S13.I1.i3.p1.m1" class="ltx_Math" alttext="{\rm deg}(p)-{\rm deg}(q)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\rm deg}(p)-{\rm deg}(q)=0</annotation></semantics></math>, <math id="S13.I1.i3.p1.m2" class="ltx_Math" alttext="M_{pq}^{{\mathbb{F}}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><annotation encoding="application/x-tex">M_{pq}^{{\mathbb{F}}}</annotation></semantics></math> consists of maps defined over smooth cylinders.</p>
</div></li>
</ol>
</div>
<div id="S13.SS8.p2" class="ltx_para ltx_noindent">
<p id="S13.SS8.p2.1" class="ltx_p">To proceed, one needs to carefully make choices when constructing the AMS lift <math id="S13.SS8.p2.m1" class="ltx_Math" alttext="\tilde{\mathbb{F}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{F}}</annotation></semantics></math>, especially the smooth structure. Choose an outercollaring width and an integral action on <math id="S13.SS8.p2.m2" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math>. Let <math id="S13.SS8.p2.m3" class="ltx_Math" alttext="\hat{\mathbb{F}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝔽</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\mathbb{F}}</annotation></semantics></math> be a relatively NC AMS lift of <math id="S13.SS8.p2.m4" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> to <math id="S13.SS8.p2.m5" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf S^{\rm rel}Kur}}_{\rm rig}^{\rm NC}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mrow><msup><mi>𝐒</mi><mi>rel</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐊𝐮𝐫</mi></mrow><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>NC</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf S^{\rm rel}Kur}}_{\rm rig}^{\rm NC}</annotation></semantics></math>. Let <math id="S13.SS8.p2.m6" class="ltx_Math" alttext="K_{pq}=(G_{pq},V_{pq}/B_{pq},E_{pq},S_{pq})" display="inline" intent=":literal"><semantics><mrow><msub><mi>K</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><mrow><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>/</mo><msub><mi>B</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo>,</mo><msub><mi>E</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi>S</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K_{pq}=(G_{pq},V_{pq}/B_{pq},E_{pq},S_{pq})</annotation></semantics></math> be the corresponding relative Kuranishi space.</p>
</div>
<div id="S13.SS8.p3" class="ltx_para ltx_noindent">
<p id="S13.SS8.p3.1" class="ltx_p">Notice that for pair <math id="S13.SS8.p3.m1" class="ltx_Math" alttext="p&lt;q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p&lt;q</annotation></semantics></math>, there is an open subset</p>
<table id="S13.Ex53" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex53.m1" class="ltx_Math" alttext="\mathring{M}_{pq}^{\mathbb{F}}\subseteq M_{pq}^{\mathbb{F}}" display="block" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>M</mi><mo>̊</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><mo>⊆</mo><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup></mrow><annotation encoding="application/x-tex">\mathring{M}_{pq}^{\mathbb{F}}\subseteq M_{pq}^{\mathbb{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.SS8.p3.2" class="ltx_p">corresponding to smooth Floer trajectories. By the above assumption on <math id="S13.SS8.p3.m2" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> and <math id="S13.SS8.p3.m3" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math>, we see that when <math id="S13.SS8.p3.m4" class="ltx_Math" alttext="{\rm deg}(p)-{\rm deg}(q)\leq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\rm deg}(p)-{\rm deg}(q)\leq 0</annotation></semantics></math>, <math id="S13.SS8.p3.m5" class="ltx_Math" alttext="M_{pq}^{\mathbb{F}}=\mathring{M}_{pq}^{\mathbb{F}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><mo>=</mo><msubsup><mover accent="true"><mi>M</mi><mo>̊</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup></mrow><annotation encoding="application/x-tex">M_{pq}^{\mathbb{F}}=\mathring{M}_{pq}^{\mathbb{F}}</annotation></semantics></math>. There is also the corresponding open subset</p>
<table id="S13.Ex54" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex54.m1" class="ltx_Math" alttext="\mathring{V}_{pq}/\mathring{B}_{pq}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>V</mi><mo>̊</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>/</mo><msub><mover accent="true"><mi>B</mi><mo>̊</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathring{V}_{pq}/\mathring{B}_{pq}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.SS8.p3.3" class="ltx_p">We know that <math id="S13.SS8.p3.m6" class="ltx_Math" alttext="\mathring{V}_{pq}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>V</mi><mo>̊</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\mathring{V}_{pq}</annotation></semantics></math> has a canonical smooth structure such that the map <math id="S13.SS8.p3.m7" class="ltx_Math" alttext="\mathring{V}_{pq}\to\mathring{B}_{pq}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>V</mi><mo>̊</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">→</mo><msub><mover accent="true"><mi>B</mi><mo>̊</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathring{V}_{pq}\to\mathring{B}_{pq}</annotation></semantics></math> is a smooth submersion. Moreover, <math id="S13.SS8.p3.m8" class="ltx_Math" alttext="\mathring{S}_{pq}:=S_{pq}|_{\mathring{V}_{pq}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>S</mi><mo>̊</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>:=</mo><msub><mrow><msub><mi>S</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">|</mo></mrow><msub><mover accent="true"><mi>V</mi><mo>̊</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msub></mrow><annotation encoding="application/x-tex">\mathring{S}_{pq}:=S_{pq}|_{\mathring{V}_{pq}}</annotation></semantics></math> is smooth.</p>
</div>
<div id="S13.SS8.p4" class="ltx_para ltx_noindent">
<p id="S13.SS8.p4.1" class="ltx_p">Recall that the stable smoothing of <math id="S13.SS8.p4.m1" class="ltx_Math" alttext="\hat{\mathbb{F}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝔽</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\mathbb{F}}</annotation></semantics></math> should be given by a <math id="S13.SS8.p4.m2" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math>-smoothing on stabilizations <math id="S13.SS8.p4.m3" class="ltx_Math" alttext="\hat{V}_{pq}:=V_{pq}\times W_{pq}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>:=</mo><mrow><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>W</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\hat{V}_{pq}:=V_{pq}\times W_{pq}</annotation></semantics></math> where <math id="S13.SS8.p4.m4" class="ltx_Math" alttext="W_{pq}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">W_{pq}</annotation></semantics></math> is a linear representation of <math id="S13.SS8.p4.m5" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math>. The open set <math id="S13.SS8.p4.m6" class="ltx_Math" alttext="\mathring{V}_{pq}\times W_{pq}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>V</mi><mo>̊</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>W</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathring{V}_{pq}\times W_{pq}</annotation></semantics></math> has a canonical smooth structure.</p>
</div>
<div id="S13.Thmthm12" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S13.Thmthm12.2" class="ltx_text ltx_font_bold">Lemma 13.12</span></span><span id="S13.Thmthm12.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S13.Thmthm12.p1" class="ltx_para">
<p id="S13.Thmthm12.p1.1" class="ltx_p"><span id="S13.Thmthm12.p1.1.1" class="ltx_text ltx_font_italic">There exists a stable smoothing <math id="S13.Thmthm12.p1.m1" class="ltx_Math" alttext="\hat{\vphantom{\rule{1.0pt}{5.71527pt}}\smash{\hat{\mathbb{F}}}}" display="inline" intent=":literal"><semantics><mover accent="true"><mover accent="true"><mi>𝔽</mi><mo>^</mo></mover><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\vphantom{\rule{1.0pt}{5.71527pt}}\smash{\hat{\mathbb{F}}}}</annotation></semantics></math> of <math id="S13.Thmthm12.p1.m2" class="ltx_Math" alttext="\hat{\mathbb{F}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝔽</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\mathbb{F}}</annotation></semantics></math> satisfying the following conditions. If <math id="S13.Thmthm12.p1.m3" class="ltx_Math" alttext="p&lt;q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p&lt;q</annotation></semantics></math> and <math id="S13.Thmthm12.p1.m4" class="ltx_Math" alttext="{\rm deg}(p)\leq{\rm deg}(q)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\rm deg}(p)\leq{\rm deg}(q)</annotation></semantics></math>, then <math id="S13.Thmthm12.p1.m5" class="ltx_Math" alttext="\hat{V}_{pq}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\hat{V}_{pq}</annotation></semantics></math> is equivariantly diffeomorphic to <math id="S13.Thmthm12.p1.m6" class="ltx_Math" alttext="\mathring{V}_{pq}\times W_{pq}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>V</mi><mo>̊</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>W</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathring{V}_{pq}\times W_{pq}</annotation></semantics></math> near <math id="S13.Thmthm12.p1.m7" class="ltx_Math" alttext="S_{pq}^{-1}(0)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>S</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">S_{pq}^{-1}(0)</annotation></semantics></math>. In particular, the stabilization <math id="S13.Thmthm12.p1.m8" class="ltx_Math" alttext="\hat{S}_{pq}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>S</mi><mo>^</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\hat{S}_{pq}</annotation></semantics></math> is smooth near its zero locus and transverse in the classical sense.</span></p>
</div>
</div>
<div id="S13.SS8.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S13.SS8.p5" class="ltx_para">
<p id="S13.SS8.p5.1" class="ltx_p"><span id="S13.SS8.p5.1.1" class="ltx_text">This is because the smoothing can be done locally and extend (cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib57" title="" class="ltx_ref">14</a>, Theorem B.3]</cite>).
∎</span></p>
</div>
</div>
<div id="S13.SS8.p6" class="ltx_para ltx_noindent">
<p id="S13.SS8.p6.1" class="ltx_p">Now consider the AMS lift <math id="S13.SS8.p6.m1" class="ltx_Math" alttext="\tilde{\mathbb{F}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{F}}</annotation></semantics></math> of the outercollaring of <math id="S13.SS8.p6.m2" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math>. In order to define the Floer chain complex using FOP transverse perturbations, one needs to construct the perturbations inductively.</p>
</div>
<div id="S13.Thmthm13" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S13.Thmthm13.2" class="ltx_text ltx_font_bold">Lemma 13.13</span></span><span id="S13.Thmthm13.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S13.Thmthm13.p1" class="ltx_para">
<p id="S13.Thmthm13.p1.1" class="ltx_p"><span id="S13.Thmthm13.p1.1.1" class="ltx_text ltx_font_italic">There exists an FOP perturbation <math id="S13.Thmthm13.p1.m1" class="ltx_Math" alttext="\mathring{\mathbb{F}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><annotation encoding="application/x-tex">\mathring{\mathbb{F}}</annotation></semantics></math> of <math id="S13.Thmthm13.p1.m2" class="ltx_Math" alttext="\tilde{\mathbb{F}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝔽</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{F}}</annotation></semantics></math> satisfying the following conditions. Let <math id="S13.Thmthm13.p1.m3" class="ltx_Math" alttext="{\mathcal{S}}_{pq}^{\prime}:{\mathcal{U}}_{pq}\to{\mathcal{E}}_{pq}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{S}}_{pq}^{\prime}:{\mathcal{U}}_{pq}\to{\mathcal{E}}_{pq}</annotation></semantics></math> be the FOP transverse perturbation. If <math id="S13.Thmthm13.p1.m4" class="ltx_Math" alttext="p&lt;q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p&lt;q</annotation></semantics></math> and <math id="S13.Thmthm13.p1.m5" class="ltx_Math" alttext="{\rm deg}(p)-{\rm deg}(q)\leq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\rm deg}(p)-{\rm deg}(q)\leq 0</annotation></semantics></math>, then <math id="S13.Thmthm13.p1.m6" class="ltx_Math" alttext="({\mathcal{S}}_{pq}^{\prime})^{-1}(0)=({\mathcal{S}}_{pq})^{-1}(0)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">({\mathcal{S}}_{pq}^{\prime})^{-1}(0)=({\mathcal{S}}_{pq})^{-1}(0)</annotation></semantics></math> and <math id="S13.Thmthm13.p1.m7" class="ltx_Math" alttext="{\mathcal{S}}_{pq}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{S}}_{pq}^{\prime}</annotation></semantics></math> agrees with <math id="S13.Thmthm13.p1.m8" class="ltx_Math" alttext="{\mathcal{S}}_{pq}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{S}}_{pq}</annotation></semantics></math> near the zero locus.</span></p>
</div>
</div>
<div id="S13.SS8.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S13.SS8.p7" class="ltx_para ltx_noindent">
<p id="S13.SS8.p7.1" class="ltx_p"><span id="S13.SS8.p7.1.1" class="ltx_text">For the proof, except for the conditions listed in the statement, we further ask that for any <math id="S13.SS8.p7.m1" class="ltx_Math" alttext="p&lt;q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p&lt;q</annotation></semantics></math> such that <math id="S13.SS8.p7.m2" class="ltx_Math" alttext="{\rm deg}(p)&lt;{\rm deg}(q)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\rm deg}(p)&lt;{\rm deg}(q)</annotation></semantics></math>, the FOP transverse perturbation satisfies <math id="S13.SS8.p7.m3" class="ltx_Math" alttext="\|{\mathcal{S}}^{\prime}_{pq}-{\mathcal{S}}_{pq}\|_{C^{0}}&lt;\frac{1}{2}\|{\mathcal{S}}_{pq}\|_{C^{0}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup><mo>−</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><msup><mi>C</mi><mn>0</mn></msup></msub><mo>&lt;</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><msup><mi>C</mi><mn>0</mn></msup></msub></mrow></mrow><annotation encoding="application/x-tex">\|{\mathcal{S}}^{\prime}_{pq}-{\mathcal{S}}_{pq}\|_{C^{0}}&lt;\frac{1}{2}\|{\mathcal{S}}_{pq}\|_{C^{0}}</annotation></semantics></math>. We consider the inductive procedure provided in the proof of Theorem <a href="#Thmthma14" title="Theorem N. ‣ 8.2. FOP perturbations on flow categories, multimodules, and homotopies ‣ 8. FOP Perturbations ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">N</span></a>. Consider a pair <math id="S13.SS8.p7.m4" class="ltx_Math" alttext="p&lt;q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p&lt;q</annotation></semantics></math>. Let <math id="S13.SS8.p7.m5" class="ltx_Math" alttext="{\mathcal{D}}_{pq}=({\mathcal{U}}_{pq},{\mathcal{E}}_{pq},{\mathcal{S}}_{pq})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{D}}_{pq}=({\mathcal{U}}_{pq},{\mathcal{E}}_{pq},{\mathcal{S}}_{pq})</annotation></semantics></math> be the normally complex derived orbifold obtained from the AMS construction.</span></p>
</div>
<div id="S13.SS8.p8" class="ltx_para ltx_noindent">
<p id="S13.SS8.p8.1" class="ltx_p"><span id="S13.SS8.p8.1.1" class="ltx_text">For the base case of the induction argument, we assume that <math id="S13.SS8.p8.m1" class="ltx_Math" alttext="(p,q)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(p,q)</annotation></semantics></math> is minimal, i.e., <math id="S13.SS8.p8.m2" class="ltx_Math" alttext="M_{pq}^{\mathbb{F}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup><annotation encoding="application/x-tex">M_{pq}^{\mathbb{F}}</annotation></semantics></math> does not contain broken trajectories. Then we can choose an FOP transverse perturbation <math id="S13.SS8.p8.m3" class="ltx_Math" alttext="{\mathcal{S}}_{pq}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{S}}_{pq}^{\prime}</annotation></semantics></math> independent of other pairs. In this case, if <math id="S13.SS8.p8.m4" class="ltx_Math" alttext="{\rm deg}(p)-{\rm deg}(q)&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\rm deg}(p)-{\rm deg}(q)&lt;0</annotation></semantics></math>, note that <math id="S13.SS8.p8.m5" class="ltx_Math" alttext="{\mathcal{S}}_{pq}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{S}}_{pq}</annotation></semantics></math> is nowhere vanishing. Using the <math id="S13.SS8.p8.m6" class="ltx_Math" alttext="C^{0}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mn>0</mn></msup><annotation encoding="application/x-tex">C^{0}</annotation></semantics></math>-density of FOP sections (cf. Theorem <a href="#S8.Thmthm2" title="Theorem 8.2. ‣ 8.1. FOP perturbations ‣ 8. FOP Perturbations ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8.2</span></a>), via a partition-of-unity argument, we can choose a smooth FOP transverse perturbation <math id="S13.SS8.p8.m7" class="ltx_Math" alttext="{\mathcal{S}}^{\prime}_{pq}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{S}}^{\prime}_{pq}</annotation></semantics></math> such that <math id="S13.SS8.p8.m8" class="ltx_Math" alttext="\|{\mathcal{S}}^{\prime}_{pq}-{\mathcal{S}}_{pq}\|_{C^{0}}&lt;\frac{1}{2}\|{\mathcal{S}}_{pq}\|_{C^{0}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup><mo>−</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><msup><mi>C</mi><mn>0</mn></msup></msub><mo>&lt;</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><msup><mi>C</mi><mn>0</mn></msup></msub></mrow></mrow><annotation encoding="application/x-tex">\|{\mathcal{S}}^{\prime}_{pq}-{\mathcal{S}}_{pq}\|_{C^{0}}&lt;\frac{1}{2}\|{\mathcal{S}}_{pq}\|_{C^{0}}</annotation></semantics></math>. Then, in particular, <math id="S13.SS8.p8.m9" class="ltx_Math" alttext="{\mathcal{S}}_{pq}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{S}}_{pq}</annotation></semantics></math> is nowhere vanishing. If <math id="S13.SS8.p8.m10" class="ltx_Math" alttext="{\rm deg}(p)={\rm deg}(q)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\rm deg}(p)={\rm deg}(q)</annotation></semantics></math>, then <math id="S13.SS8.p8.m11" class="ltx_Math" alttext="{\mathcal{S}}_{pq}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{S}}_{pq}</annotation></semantics></math> vanishes at finitely many points which correspond to smooth solutions to the Floer equation. In this case, our stable smoothing for such Kuranishi spaces carry the original smooth structure (see Lemma <a href="#S13.Thmthm12" title="Lemma 13.12. ‣ 13.8. Proof of Theorem ‣ 13. Proof of the Main Theorems ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13.12</span></a>), the original section <math id="S13.SS8.p8.m12" class="ltx_Math" alttext="{\mathcal{S}}_{pq}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{S}}_{pq}</annotation></semantics></math> is smooth near the zero locus and transverse in the classical sense. Moreover, <math id="S13.SS8.p8.m13" class="ltx_Math" alttext="{\mathcal{U}}_{pq}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{U}}_{pq}</annotation></semantics></math> is a manifold near its zero locus. Hence <span id="S13.SS8.p8.1.1.1" class="ltx_text ltx_font_bold">(Classical Transversality)</span> condition of Theorem <a href="#S8.Thmthm2" title="Theorem 8.2. ‣ 8.1. FOP perturbations ‣ 8. FOP Perturbations ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8.2</span></a>, <math id="S13.SS8.p8.m14" class="ltx_Math" alttext="{\mathcal{S}}_{pq}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{S}}_{pq}</annotation></semantics></math> is also FOP transverse near the zero loucs. Hence one can choose <math id="S13.SS8.p8.m15" class="ltx_Math" alttext="{\mathcal{S}}_{pq}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{S}}_{pq}^{\prime}</annotation></semantics></math> to agree with <math id="S13.SS8.p8.m16" class="ltx_Math" alttext="{\mathcal{S}}_{pq}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{S}}_{pq}</annotation></semantics></math> near its zero locus without creating more zeroes. If <math id="S13.SS8.p8.m17" class="ltx_Math" alttext="{\rm deg}(p)-{\rm deg}(q)\geq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\rm deg}(p)-{\rm deg}(q)\geq 1</annotation></semantics></math>, we choose an arbitrary FOP transverse perturbation <math id="S13.SS8.p8.m18" class="ltx_Math" alttext="{\mathcal{S}}_{pq}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{S}}_{pq}^{\prime}</annotation></semantics></math>.</span></p>
</div>
<div id="S13.SS8.p9" class="ltx_para ltx_noindent">
<p id="S13.SS8.p9.1" class="ltx_p"><span id="S13.SS8.p9.1.1" class="ltx_text">Inductively, suppose we have chosen FOP transverse perturbations <math id="S13.SS8.p9.m1" class="ltx_Math" alttext="{\mathcal{S}}_{rs}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{S}}_{rs}^{\prime}</annotation></semantics></math> satisfying our requirement for all pairs <math id="S13.SS8.p9.m2" class="ltx_Math" alttext="r,s" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>,</mo><mi>s</mi></mrow><annotation encoding="application/x-tex">r,s</annotation></semantics></math> such that <math id="S13.SS8.p9.m3" class="ltx_Math" alttext="{\mathcal{A}}_{H}(r)-{\mathcal{A}}_{H}(s)&lt;{\mathcal{A}}_{H}(p)-{\mathcal{A}}_{H}(q)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&lt;</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{A}}_{H}(r)-{\mathcal{A}}_{H}(s)&lt;{\mathcal{A}}_{H}(p)-{\mathcal{A}}_{H}(q)</annotation></semantics></math>. To continue the induction, we analyze the induced perturbation near the boundary strata of <math id="S13.SS8.p9.m4" class="ltx_Math" alttext="{\mathcal{U}}_{pq}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{U}}_{pq}</annotation></semantics></math>. We first consider the case when <math id="S13.SS8.p9.m5" class="ltx_Math" alttext="{\rm deg}(p)-{\rm deg}(q)&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\rm deg}(p)-{\rm deg}(q)&lt;0</annotation></semantics></math>. For any triple <math id="S13.SS8.p9.m6" class="ltx_Math" alttext="p&lt;r&lt;q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mi>r</mi><mo>&lt;</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p&lt;r&lt;q</annotation></semantics></math>, one of the factors of <math id="S13.SS8.p9.m7" class="ltx_Math" alttext="M_{pr}^{\mathbb{F}}\times M_{rq}^{\mathbb{F}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mi>𝔽</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>M</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>𝔽</mi></msubsup></mrow><annotation encoding="application/x-tex">M_{pr}^{\mathbb{F}}\times M_{rq}^{\mathbb{F}}</annotation></semantics></math> has negative virtual dimension. Without loss of generality, we can assume that <math id="S13.SS8.p9.m8" class="ltx_Math" alttext="{\rm deg}(p)-{\rm deg}(r)&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\rm deg}(p)-{\rm deg}(r)&lt;0</annotation></semantics></math>. By the inductive hypothesis, we know that <math id="S13.SS8.p9.m9" class="ltx_Math" alttext="\|{\mathcal{S}}_{pr}-{\mathcal{S}}_{pr}^{\prime}\|_{C^{0}}&lt;\frac{1}{2}\|{\mathcal{S}}_{pr}\|_{C^{0}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo>−</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>′</mo></msubsup></mrow><mo stretchy="false">‖</mo></mrow><msup><mi>C</mi><mn>0</mn></msup></msub><mo>&lt;</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><msup><mi>C</mi><mn>0</mn></msup></msub></mrow></mrow><annotation encoding="application/x-tex">\|{\mathcal{S}}_{pr}-{\mathcal{S}}_{pr}^{\prime}\|_{C^{0}}&lt;\frac{1}{2}\|{\mathcal{S}}_{pr}\|_{C^{0}}</annotation></semantics></math>. By the compatibility requirement, the putative perturbation <math id="S13.SS8.p9.m10" class="ltx_Math" alttext="{\mathcal{S}}_{pq}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{S}}_{pq}^{\prime}</annotation></semantics></math> is obtained from <math id="S13.SS8.p9.m11" class="ltx_Math" alttext="{\mathcal{S}}_{pr}^{\prime}\times{\mathcal{S}}_{rq}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>′</mo></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">{\mathcal{S}}_{pr}^{\prime}\times{\mathcal{S}}_{rq}^{\prime}</annotation></semantics></math> via a stabilization, which implies that the condition <math id="S13.SS8.p9.m12" class="ltx_Math" alttext="\|{\mathcal{S}}^{\prime}_{pq}-{\mathcal{S}}_{pq}\|_{C^{0}}&lt;\frac{1}{2}\|{\mathcal{S}}_{pq}\|_{C^{0}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup><mo>−</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><msup><mi>C</mi><mn>0</mn></msup></msub><mo>&lt;</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><msup><mi>C</mi><mn>0</mn></msup></msub></mrow></mrow><annotation encoding="application/x-tex">\|{\mathcal{S}}^{\prime}_{pq}-{\mathcal{S}}_{pq}\|_{C^{0}}&lt;\frac{1}{2}\|{\mathcal{S}}_{pq}\|_{C^{0}}</annotation></semantics></math> is already met near the boundary stratum <math id="S13.SS8.p9.m13" class="ltx_Math" alttext="\partial^{prq}{\mathcal{U}}_{pq}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msup><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\partial^{prq}{\mathcal{U}}_{pq}</annotation></semantics></math>. Because this induced section is nowhere vanishing, it is FOP transverse. Then we can apply the <span id="S13.SS8.p9.1.1.1" class="ltx_text ltx_markedasmath ltx_font_bold">(Extension Property)</span> of Theorem <a href="#S8.Thmthm2" title="Theorem 8.2. ‣ 8.1. FOP perturbations ‣ 8. FOP Perturbations ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8.2</span></a> together with the <math id="S13.SS8.p9.m15" class="ltx_Math" alttext="C^{0}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mn>0</mn></msup><annotation encoding="application/x-tex">C^{0}</annotation></semantics></math>-density of FOP transverse perturbations to construct <math id="S13.SS8.p9.m16" class="ltx_Math" alttext="{\mathcal{S}}^{\prime}_{pq}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{S}}^{\prime}_{pq}</annotation></semantics></math> which argees with the induced section near <math id="S13.SS8.p9.m17" class="ltx_Math" alttext="\partial^{prq}{\mathcal{U}}_{pq}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msup><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\partial^{prq}{\mathcal{U}}_{pq}</annotation></semantics></math> with <math id="S13.SS8.p9.m18" class="ltx_Math" alttext="\|{\mathcal{S}}^{\prime}_{pq}-{\mathcal{S}}_{pq}\|_{C^{0}}&lt;\frac{1}{2}\|{\mathcal{S}}_{pq}\|_{C^{0}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup><mo>−</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><msup><mi>C</mi><mn>0</mn></msup></msub><mo>&lt;</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">‖</mo></mrow><msup><mi>C</mi><mn>0</mn></msup></msub></mrow></mrow><annotation encoding="application/x-tex">\|{\mathcal{S}}^{\prime}_{pq}-{\mathcal{S}}_{pq}\|_{C^{0}}&lt;\frac{1}{2}\|{\mathcal{S}}_{pq}\|_{C^{0}}</annotation></semantics></math>. In particular, we see that <math id="S13.SS8.p9.m19" class="ltx_Math" alttext="{\mathcal{S}}^{\prime}_{pq}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{S}}^{\prime}_{pq}</annotation></semantics></math> is nowhere vanishing.</span></p>
</div>
<div id="S13.SS8.p10" class="ltx_para ltx_noindent">
<p id="S13.SS8.p10.1" class="ltx_p"><span id="S13.SS8.p10.1.1" class="ltx_text">As for the case <math id="S13.SS8.p10.m1" class="ltx_Math" alttext="{\rm deg}(p)={\rm deg}(q)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\rm deg}(p)={\rm deg}(q)</annotation></semantics></math>, if we have <math id="S13.SS8.p10.m2" class="ltx_Math" alttext="p&lt;r&lt;q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mi>r</mi><mo>&lt;</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p&lt;r&lt;q</annotation></semantics></math>, we can similarly analyze the induced section near <math id="S13.SS8.p10.m3" class="ltx_Math" alttext="\partial^{prq}{\mathcal{U}}_{pq}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msup><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\partial^{prq}{\mathcal{U}}_{pq}</annotation></semantics></math> to see that it is nowhere vanishing near <math id="S13.SS8.p10.m4" class="ltx_Math" alttext="\partial^{prq}{\mathcal{U}}_{pq}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msup><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\partial^{prq}{\mathcal{U}}_{pq}</annotation></semantics></math>. As for the interior part of <math id="S13.SS8.p10.m5" class="ltx_Math" alttext="{\mathcal{U}}_{pq}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{U}}_{pq}</annotation></semantics></math>, similar to the above discussion, we know that the original section <math id="S13.SS8.p10.m6" class="ltx_Math" alttext="{\mathcal{S}}_{pq}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{S}}_{pq}</annotation></semantics></math> vanishes at finitely many points, near which the Kuranishi spaces carry the original smooth structure with respect to which <math id="S13.SS8.p10.m7" class="ltx_Math" alttext="{\mathcal{S}}_{pq}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{S}}_{pq}</annotation></semantics></math> is smooth, thereby being an FOP transverse section. So we can choose the perturbation <math id="S13.SS8.p10.m8" class="ltx_Math" alttext="{\mathcal{S}}^{\prime}_{pq}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{S}}^{\prime}_{pq}</annotation></semantics></math> to agree with <math id="S13.SS8.p10.m9" class="ltx_Math" alttext="{\mathcal{S}}_{pq}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{S}}_{pq}</annotation></semantics></math> near <math id="S13.SS8.p10.m10" class="ltx_Math" alttext="{\mathcal{S}}^{-1}_{pq}(0)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{S}}^{-1}_{pq}(0)</annotation></semantics></math> and to satisfy the inductive compatibility near the boundary strata such that <math id="S13.SS8.p10.m11" class="ltx_Math" alttext="({\mathcal{S}})^{-1}_{pq}(0)=({\mathcal{S}}^{\prime})^{-1}_{pq}(0)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">({\mathcal{S}})^{-1}_{pq}(0)=({\mathcal{S}}^{\prime})^{-1}_{pq}(0)</annotation></semantics></math>.</span></p>
</div>
<div id="S13.SS8.p11" class="ltx_para">
<p id="S13.SS8.p11.1" class="ltx_p"><span id="S13.SS8.p11.1.1" class="ltx_text">Finally, if <math id="S13.SS8.p11.m1" class="ltx_Math" alttext="{\rm deg}(p)-{\rm deg}(q)\geq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\rm deg}(p)-{\rm deg}(q)\geq 1</annotation></semantics></math>, we choose <math id="S13.SS8.p11.m2" class="ltx_Math" alttext="{\mathcal{S}}^{\prime}_{pq}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{S}}^{\prime}_{pq}</annotation></semantics></math> such that it satisfies the compatibility condition near the boundary strata as in the proof of Theorem <a href="#Thmthma14" title="Theorem N. ‣ 8.2. FOP perturbations on flow categories, multimodules, and homotopies ‣ 8. FOP Perturbations ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">N</span></a>. This finishes the inductive step and we conclude the proof.
∎</span></p>
</div>
</div>
<div id="S13.SS8.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Theorem <a href="#Thmthma7" title="Theorem G. ‣ 1.1.5. Comparison with known construction ‣ 1.1. Main results on Floer complexes ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">G</span></a>.</h6>
<div id="S13.SS8.p12" class="ltx_para">
<p id="S13.SS8.p12.1" class="ltx_p"><span id="S13.SS8.p12.1.1" class="ltx_text">By Lemma <a href="#S13.Thmthm13" title="Lemma 13.13. ‣ 13.8. Proof of Theorem ‣ 13. Proof of the Main Theorems ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13.13</span></a>, there exists an FOP transverse perturbation <math id="S13.SS8.p12.m1" class="ltx_Math" alttext="\mathring{\mathbb{F}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝔽</mi><mo>̊</mo></mover><annotation encoding="application/x-tex">\mathring{\mathbb{F}}</annotation></semantics></math> such that the associated counts (with respect to the natural orientations) of zeros coincides with the counts of zero-dimensional moduli spaces using the classical method. Then the chain complexes defined using the FOP perturbation agrees with the classical one.
∎</span></p>
</div>
</div>
</section>
<section id="S13.SS9" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">13.9. </span>Proof of Theorem <a href="#Thmthma12" title="Theorem L (Spectral invariants). ‣ 1.3.1. Action filtration and spectral invariants ‣ 1.3. Main results on quantitative Floer theory ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">L</span></a></h4>

<div id="S13.SS9.p1" class="ltx_para ltx_noindent">
<p id="S13.SS9.p1.1" class="ltx_p">We verify each item of Theorem <a href="#Thmthma12" title="Theorem L (Spectral invariants). ‣ 1.3.1. Action filtration and spectral invariants ‣ 1.3. Main results on quantitative Floer theory ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">L</span></a>. In fact the verification is similar to the case of Hamiltonian Floer spectral invariants defined via the Floer chain complex over <math id="S13.SS9.p1.m1" class="ltx_Math" alttext="{\mathbb{Q}}" display="inline" intent=":literal"><semantics><mi>ℚ</mi><annotation encoding="application/x-tex">{\mathbb{Q}}</annotation></semantics></math> (see for example <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib27" title="" class="ltx_ref">26</a>]</cite>). The argument here is a rather straightforward adaptation to the current setting.</p>
</div>
<div id="S13.SS9.p2" class="ltx_para ltx_noindent">
<ol id="S13.I2" class="ltx_enumerate">
<li id="S13.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S13.I2.i1.p1" class="ltx_para ltx_noindent">
<p id="S13.I2.i1.p1.1" class="ltx_p">The <span id="S13.I2.i1.p1.1.1" class="ltx_text ltx_font_bold">(Spectrality)</span> follows from Usher’s abstract result (Theorem <a href="#S7.Thmthm39" title="Theorem 7.39 (cf. []). ‣ 7.5.2. Filtration and spectral invariants ‣ 7.5. Quantitative theories ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.39</span></a>). Notice that the argument requires that <math id="S13.I2.i1.p1.m1" class="ltx_Math" alttext="CF_{*}(H,J,\Xi)" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>J</mi><mo>,</mo><mi mathvariant="normal">Ξ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF_{*}(H,J,\Xi)</annotation></semantics></math> is a Floer–Novikov complex, which is proved in Proposition <a href="#S7.Thmthm38" title="Proposition 7.38. ‣ 7.5.1. Nonarchimedean linear algebra ‣ 7.5. Quantitative theories ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.38</span></a>.</p>
</div></li>
<li id="S13.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S13.I2.i2.p1" class="ltx_para ltx_noindent">
<p id="S13.I2.i2.p1.1" class="ltx_p">The <span id="S13.I2.i2.p1.1.1" class="ltx_text ltx_font_bold">(Shifting property)</span> follows from the fact that the multiplication by <math id="S13.I2.i2.p1.m1" class="ltx_Math" alttext="a\in\Lambda_{R}^{\Pi}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><msubsup><mi mathvariant="normal">Λ</mi><mi>R</mi><mi mathvariant="normal">Π</mi></msubsup></mrow><annotation encoding="application/x-tex">a\in\Lambda_{R}^{\Pi}</annotation></semantics></math> is an isomorphism of chain complexes from <math id="S13.I2.i2.p1.m2" class="ltx_Math" alttext="CF_{*}(H,J,\Xi)^{\leq\tau}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>J</mi><mo>,</mo><mi mathvariant="normal">Ξ</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo>≤</mo><mi>τ</mi></mrow></msup></mrow><annotation encoding="application/x-tex">CF_{*}(H,J,\Xi)^{\leq\tau}</annotation></semantics></math> to <math id="S13.I2.i2.p1.m3" class="ltx_Math" alttext="CF_{*}(H,J,\Xi)^{\leq\tau-\mathfrak{v}(a)}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>J</mi><mo>,</mo><mi mathvariant="normal">Ξ</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>τ</mi><mo>−</mo><mrow><mi>𝔳</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">CF_{*}(H,J,\Xi)^{\leq\tau-\mathfrak{v}(a)}</annotation></semantics></math>.</p>
</div></li>
<li id="S13.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S13.I2.i3.p1" class="ltx_para ltx_noindent">
<p id="S13.I2.i3.p1.1" class="ltx_p">The <span id="S13.I2.i3.p1.1.1" class="ltx_text ltx_font_bold">(Lipschitz Continuity)</span> is a straightforward consequence of Theorem <a href="#Thmthma11" title="Theorem K (Filtered Floer complex and continuation map). ‣ 1.3.1. Action filtration and spectral invariants ‣ 1.3. Main results on quantitative Floer theory ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">K</span></a> (2), where we recall that the Hofer distance between Hamiltonians <math id="S13.I2.i3.p1.m1" class="ltx_Math" alttext="H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">H_{1}</annotation></semantics></math> and <math id="S13.I2.i3.p1.m2" class="ltx_Math" alttext="H_{2}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>2</mn></msub><annotation encoding="application/x-tex">H_{2}</annotation></semantics></math> is</p>
<table id="S13.Ex55" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex55.m1" class="ltx_Math" alttext="\int_{0}^{1}\max_{x\in M}(H_{1}(x,t)-H_{2}(x,t))dt-\int_{0}^{1}\min_{x\in M}(H_{1}(x,t)-H_{2}(x,t))dt," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mo>∫</mo><mn>0</mn><mn>1</mn></msubsup><mrow><mrow><munder><mi>max</mi><mrow><mi>x</mi><mo>∈</mo><mi>M</mi></mrow></munder><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>H</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>H</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow><mo rspace="0.055em">−</mo><mrow><msubsup><mo>∫</mo><mn>0</mn><mn>1</mn></msubsup><mrow><mrow><munder><mi>min</mi><mrow><mi>x</mi><mo>∈</mo><mi>M</mi></mrow></munder><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>H</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>H</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\int_{0}^{1}\max_{x\in M}(H_{1}(x,t)-H_{2}(x,t))dt-\int_{0}^{1}\min_{x\in M}(H_{1}(x,t)-H_{2}(x,t))dt,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.I2.i3.p1.2" class="ltx_p">which is an upper bound for the threshold (cf. Definition <a href="#S7.Thmthm41" title="Definition 7.41. ‣ 7.5.4. Continuity ‣ 7.5. Quantitative theories ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.41</span></a>) of the continuation maps.</p>
</div></li>
<li id="S13.I2.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S13.I2.i4.p1" class="ltx_para ltx_noindent">
<p id="S13.I2.i4.p1.1" class="ltx_p">The <span id="S13.I2.i4.p1.1.1" class="ltx_text ltx_font_bold">(Isotopy invariance)</span> following from the continuation map construction. Let <math id="S13.I2.i4.p1.m1" class="ltx_Math" alttext="H_{1},H_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mn>1</mn></msub><mo>,</mo><msub><mi>H</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">H_{1},H_{2}</annotation></semantics></math> induce the same Hamiltonian isotopy <math id="S13.I2.i4.p1.m2" class="ltx_Math" alttext="\tilde{\phi}\in{\rm H}\widetilde{\rm am}(X,\omega)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover><mo>∈</mo><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>am</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>ω</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{\phi}\in{\rm H}\widetilde{\rm am}(X,\omega)</annotation></semantics></math> and <math id="S13.I2.i4.p1.m3" class="ltx_Math" alttext="J_{1}" display="inline" intent=":literal"><semantics><msub><mi>J</mi><mn>1</mn></msub><annotation encoding="application/x-tex">J_{1}</annotation></semantics></math>, <math id="S13.I2.i4.p1.m4" class="ltx_Math" alttext="J_{2}" display="inline" intent=":literal"><semantics><msub><mi>J</mi><mn>2</mn></msub><annotation encoding="application/x-tex">J_{2}</annotation></semantics></math> be two <math id="S13.I2.i4.p1.m5" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math>-compatible almost complex structure. Then there exists a Floer data on the infinite cylinder connecting <math id="S13.I2.i4.p1.m6" class="ltx_Math" alttext="H_{1}dt" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">H_{1}dt</annotation></semantics></math> and <math id="S13.I2.i4.p1.m7" class="ltx_Math" alttext="H_{2}dt" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">H_{2}dt</annotation></semantics></math> and a family of compatible almost complex structures connecting <math id="S13.I2.i4.p1.m8" class="ltx_Math" alttext="J_{1}" display="inline" intent=":literal"><semantics><msub><mi>J</mi><mn>1</mn></msub><annotation encoding="application/x-tex">J_{1}</annotation></semantics></math> and <math id="S13.I2.i4.p1.m9" class="ltx_Math" alttext="J_{2}" display="inline" intent=":literal"><semantics><msub><mi>J</mi><mn>2</mn></msub><annotation encoding="application/x-tex">J_{2}</annotation></semantics></math>. Let <math id="S13.I2.i4.p1.m10" class="ltx_Math" alttext="\mathbb{F}_{1},\mathbb{F}_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔽</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝔽</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\mathbb{F}_{1},\mathbb{F}_{2}</annotation></semantics></math> be the associated Floer flow categories. Then the Floer data described here defines a bimodule <math id="S13.I2.i4.p1.m11" class="ltx_Math" alttext="{\mathbb{B}}_{12}" display="inline" intent=":literal"><semantics><msub><mi>𝔹</mi><mn>12</mn></msub><annotation encoding="application/x-tex">{\mathbb{B}}_{12}</annotation></semantics></math> from <math id="S13.I2.i4.p1.m12" class="ltx_Math" alttext="{\mathbb{F}}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝔽</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\mathbb{F}}_{1}</annotation></semantics></math> to <math id="S13.I2.i4.p1.m13" class="ltx_Math" alttext="{\mathbb{F}}_{2}" display="inline" intent=":literal"><semantics><msub><mi>𝔽</mi><mn>2</mn></msub><annotation encoding="application/x-tex">{\mathbb{F}}_{2}</annotation></semantics></math>. Theorem <a href="#Thmthma16" title="Theorem P. ‣ 12.2. Multimodules and homotopies ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">P</span></a> together with the FOP perturbation provides a chain map</p>
<table id="S13.Ex56" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex56.m1" class="ltx_Math" alttext="\Phi^{\mathbb{B}_{01}}:CF_{*}(H_{1},J_{1},\Xi_{1})\to CF_{*}(H_{2},J_{2},\Xi_{2})." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">Φ</mi><msub><mi>𝔹</mi><mn>01</mn></msub></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>1</mn></msub><mo>,</mo><msub><mi>J</mi><mn>1</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>2</mn></msub><mo>,</mo><msub><mi>J</mi><mn>2</mn></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Phi^{\mathbb{B}_{01}}:CF_{*}(H_{1},J_{1},\Xi_{1})\to CF_{*}(H_{2},J_{2},\Xi_{2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.I2.i4.p1.2" class="ltx_p">The Hamiltonian connection can be chosen to be flat precisely because the Hamiltonian isotopies induced from <math id="S13.I2.i4.p1.m14" class="ltx_Math" alttext="H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">H_{1}</annotation></semantics></math> and <math id="S13.I2.i4.p1.m15" class="ltx_Math" alttext="H_{2}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>2</mn></msub><annotation encoding="application/x-tex">H_{2}</annotation></semantics></math> are isotopic. Hence the threshold of the chain map <math id="S13.I2.i4.p1.m16" class="ltx_Math" alttext="\Phi^{\mathbb{B}_{01}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Φ</mi><msub><mi>𝔹</mi><mn>01</mn></msub></msup><annotation encoding="application/x-tex">\Phi^{\mathbb{B}_{01}}</annotation></semantics></math> (Definition <a href="#S7.Thmthm41" title="Definition 7.41. ‣ 7.5.4. Continuity ‣ 7.5. Quantitative theories ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.41</span></a>) is zero. The same is true for a continuation map in the reversed direction. Hence we obtain the equality between the spectral numbers.</p>
</div></li>
<li id="S13.I2.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(5)</span> 
<div id="S13.I2.i5.p1" class="ltx_para ltx_noindent">
<p id="S13.I2.i5.p1.1" class="ltx_p">For the <span id="S13.I2.i5.p1.1.1" class="ltx_text ltx_font_bold">(Symplectic invariance)</span> property, fix a symplectomorphism <math id="S13.I2.i5.p1.m1" class="ltx_Math" alttext="\rho:X\to X" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>X</mi><mo stretchy="false">→</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">\rho:X\to X</annotation></semantics></math>. Let <math id="S13.I2.i5.p1.m2" class="ltx_Math" alttext="J_{\rho}" display="inline" intent=":literal"><semantics><msub><mi>J</mi><mi>ρ</mi></msub><annotation encoding="application/x-tex">J_{\rho}</annotation></semantics></math> and <math id="S13.I2.i5.p1.m3" class="ltx_Math" alttext="H_{\rho}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mi>ρ</mi></msub><annotation encoding="application/x-tex">H_{\rho}</annotation></semantics></math> be the pullback almost complex structure and Hamiltonian. Let <math id="S13.I2.i5.p1.m4" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> resp. <math id="S13.I2.i5.p1.m5" class="ltx_Math" alttext="{\mathbb{F}}_{\rho}" display="inline" intent=":literal"><semantics><msub><mi>𝔽</mi><mi>ρ</mi></msub><annotation encoding="application/x-tex">{\mathbb{F}}_{\rho}</annotation></semantics></math> be the Floer flow category associated to <math id="S13.I2.i5.p1.m6" class="ltx_Math" alttext="(H,J)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi>J</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(H,J)</annotation></semantics></math> resp. <math id="S13.I2.i5.p1.m7" class="ltx_Math" alttext="(H_{\rho},J_{\rho})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mi>ρ</mi></msub><mo>,</mo><msub><mi>J</mi><mi>ρ</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(H_{\rho},J_{\rho})</annotation></semantics></math>. Then <math id="S13.I2.i5.p1.m8" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> induces an isomorphism of Floer flow categories <math id="S13.I2.i5.p1.m9" class="ltx_Math" alttext="\mathbb{F}\to\mathbb{F}_{\rho}" display="inline" intent=":literal"><semantics><mrow><mi>𝔽</mi><mo stretchy="false">→</mo><msub><mi>𝔽</mi><mi>ρ</mi></msub></mrow><annotation encoding="application/x-tex">\mathbb{F}\to\mathbb{F}_{\rho}</annotation></semantics></math>. The the AMS+FOP construction for <math id="S13.I2.i5.p1.m10" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> can be pulled back to <math id="S13.I2.i5.p1.m11" class="ltx_Math" alttext="\mathbb{F}_{\rho}" display="inline" intent=":literal"><semantics><msub><mi>𝔽</mi><mi>ρ</mi></msub><annotation encoding="application/x-tex">\mathbb{F}_{\rho}</annotation></semantics></math>, providing an isomorphic chain complex <math id="S13.I2.i5.p1.m12" class="ltx_Math" alttext="CF_{*}(H_{\rho},J_{\rho},\Xi_{\rho})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mi>ρ</mi></msub><mo>,</mo><msub><mi>J</mi><mi>ρ</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Ξ</mi><mi>ρ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">CF_{*}(H_{\rho},J_{\rho},\Xi_{\rho})</annotation></semantics></math>. This isomorphism also preserves the symplectic action and the filtration on the chain complexes.</p>
</div></li>
<li id="S13.I2.i6" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(6)</span> 
<div id="S13.I2.i6.p1" class="ltx_para ltx_noindent">
<p id="S13.I2.i6.p1.1" class="ltx_p">The <span id="S13.I2.i6.p1.1.1" class="ltx_text ltx_font_bold">(Triangle inequality)</span> follows from the chain-level pair-of-pants product construction provided by Theorem <a href="#Thmthma3" title="Theorem C (Pair-of-pants product). ‣ 1.1.2. Pair-of-pants product ‣ 1.1. Main results on Floer complexes ‣ 1. Introduction ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C</span></a>. Let <math id="S13.I2.i6.p1.m1" class="ltx_Math" alttext="H_{1},H_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mn>1</mn></msub><mo>,</mo><msub><mi>H</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">H_{1},H_{2}</annotation></semantics></math> be nondegenerate Hamiltonians generating <math id="S13.I2.i6.p1.m2" class="ltx_Math" alttext="\tilde{\phi}_{1},\tilde{\phi}_{2}\in{\rm H}\widetilde{\rm am}(X,\omega)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover><mn>1</mn></msub><mo>,</mo><mrow><msub><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover><mn>2</mn></msub><mo>∈</mo><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>am</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>ω</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{\phi}_{1},\tilde{\phi}_{2}\in{\rm H}\widetilde{\rm am}(X,\omega)</annotation></semantics></math> such that <math id="S13.I2.i6.p1.m3" class="ltx_Math" alttext="\tilde{\phi}_{1}\circ\tilde{\phi}_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\tilde{\phi}_{1}\circ\tilde{\phi}_{2}</annotation></semantics></math> is also nondegenerate. Then there is a composition <math id="S13.I2.i6.p1.m4" class="ltx_Math" alttext="H_{1}\natural H_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">H_{1}\natural H_{2}</annotation></semantics></math> generating the composition <math id="S13.I2.i6.p1.m5" class="ltx_Math" alttext="\tilde{\phi}_{1}\circ\tilde{\phi}_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\tilde{\phi}_{1}\circ\tilde{\phi}_{2}</annotation></semantics></math>. Moreover, on the pair-of-pants <math id="S13.I2.i6.p1.m6" class="ltx_Math" alttext="\Sigma^{\rm pants}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Σ</mi><mi>pants</mi></msup><annotation encoding="application/x-tex">\Sigma^{\rm pants}</annotation></semantics></math>, there exists a flat Hamiltonian connection <math id="S13.I2.i6.p1.m7" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> which converges to <math id="S13.I2.i6.p1.m8" class="ltx_Math" alttext="H_{1}dt" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">H_{1}dt</annotation></semantics></math>, <math id="S13.I2.i6.p1.m9" class="ltx_Math" alttext="H_{2}dt" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">H_{2}dt</annotation></semantics></math> on the two negative ends and converges to <math id="S13.I2.i6.p1.m10" class="ltx_Math" alttext="H_{3}dt:=H_{1}\natural H_{2}dt" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>H</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>:=</mo><mrow><msub><mi>H</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">♮</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><annotation encoding="application/x-tex">H_{3}dt:=H_{1}\natural H_{2}dt</annotation></semantics></math> on the positive ends. Let <math id="S13.I2.i6.p1.m11" class="ltx_Math" alttext="{\mathbb{X}}" display="inline" intent=":literal"><semantics><mi>𝕏</mi><annotation encoding="application/x-tex">{\mathbb{X}}</annotation></semantics></math> be the corresponding multimodule, which is an equivariant Novikov multimodule. Let <math id="S13.I2.i6.p1.m12" class="ltx_Math" alttext="{\mathbb{F}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝔽</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\mathbb{F}}_{i}</annotation></semantics></math>, <math id="S13.I2.i6.p1.m13" class="ltx_Math" alttext="i=1,2,3" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">i=1,2,3</annotation></semantics></math> be the Floer flow categories associated to <math id="S13.I2.i6.p1.m14" class="ltx_Math" alttext="H_{i}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mi>i</mi></msub><annotation encoding="application/x-tex">H_{i}</annotation></semantics></math>. Then it is well-known that the curvature of <math id="S13.I2.i6.p1.m15" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> gives the threshold of the Novikov multimodule (Definition <a href="#S7.Thmthm41" title="Definition 7.41. ‣ 7.5.4. Continuity ‣ 7.5. Quantitative theories ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.41</span></a>), and the curvature can be taken to be zero. Therefore, by Proposition <a href="#S7.Thmthm42" title="Proposition 7.42. ‣ 7.5.4. Continuity ‣ 7.5. Quantitative theories ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.42</span></a>, one has</p>
<table id="S13.Ex57" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex57.m1" class="ltx_Math" alttext="c_{{\mathbb{F}}_{3}}({\mathfrak{x}}_{1}\star{\mathfrak{x}}_{2})\leq c_{{\mathbb{F}}_{1}}({\mathfrak{x}}_{1})+c_{\mathbb{F}_{2}}({\mathfrak{x}}_{2})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>c</mi><msub><mi>𝔽</mi><mn>3</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝔵</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">⋆</mo><msub><mi>𝔵</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><msub><mi>c</mi><msub><mi>𝔽</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔵</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>c</mi><msub><mi>𝔽</mi><mn>2</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔵</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">c_{{\mathbb{F}}_{3}}({\mathfrak{x}}_{1}\star{\mathfrak{x}}_{2})\leq c_{{\mathbb{F}}_{1}}({\mathfrak{x}}_{1})+c_{\mathbb{F}_{2}}({\mathfrak{x}}_{2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S13.I2.i7" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(7)</span> 
<div id="S13.I2.i7.p1" class="ltx_para ltx_noindent">
<p id="S13.I2.i7.p1.1" class="ltx_p">The <span id="S13.I2.i7.p1.1.1" class="ltx_text ltx_font_bold">(Poincaré duality)</span> property follows from the chain-level construction of the Poincaré duality and the spectral invariant continuatity result (Proposition <a href="#S7.Thmthm42" title="Proposition 7.42. ‣ 7.5.4. Continuity ‣ 7.5. Quantitative theories ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.42</span></a>). The argument also follows that of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib41" title="" class="ltx_ref">51</a>, Lemma 5.1]</cite>.</p>
</div>
<div id="S13.I2.i7.p2" class="ltx_para ltx_noindent">
<p id="S13.I2.i7.p2.1" class="ltx_p">Fix an almost complex structure <math id="S13.I2.i7.p2.m1" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math> and omit it from the argument from now on. Let <math id="S13.I2.i7.p2.m2" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> be a nondegenerate Hamiltonian on <math id="S13.I2.i7.p2.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> and <math id="S13.I2.i7.p2.m4" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> be the associated Floer flow category. Let <math id="S13.I2.i7.p2.m5" class="ltx_Math" alttext="\overline{H}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{H}</annotation></semantics></math> be the reversal of <math id="S13.I2.i7.p2.m6" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>, which has an induced Floer flow category <math id="S13.I2.i7.p2.m7" class="ltx_Math" alttext="\overline{\mathbb{F}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝔽</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{\mathbb{F}}</annotation></semantics></math>. Then on the domain <math id="S13.I2.i7.p2.m8" class="ltx_Math" alttext="\Sigma^{\mathbb{PD}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Σ</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔻</mi></mrow></msup><annotation encoding="application/x-tex">\Sigma^{\mathbb{PD}}</annotation></semantics></math> which has two negative ends and no positive end, there exists a flat Hamiltonian connection <math id="S13.I2.i7.p2.m9" class="ltx_Math" alttext="\sigma^{\mathbb{PD}}" display="inline" intent=":literal"><semantics><msup><mi>σ</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔻</mi></mrow></msup><annotation encoding="application/x-tex">\sigma^{\mathbb{PD}}</annotation></semantics></math> which is <math id="S13.I2.i7.p2.m10" class="ltx_Math" alttext="Hdt" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">Hdt</annotation></semantics></math> on one end and <math id="S13.I2.i7.p2.m11" class="ltx_Math" alttext="\overline{H}dt" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">\overline{H}dt</annotation></semantics></math> on the other. Consider this specific Poincaré duality multimodule <math id="S13.I2.i7.p2.m12" class="ltx_Math" alttext="{\mathbb{X}}^{\mathbb{PD}}" display="inline" intent=":literal"><semantics><msup><mi>𝕏</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔻</mi></mrow></msup><annotation encoding="application/x-tex">{\mathbb{X}}^{\mathbb{PD}}</annotation></semantics></math> (over <math id="S13.I2.i7.p2.m13" class="ltx_Math" alttext="({\mathbb{F}},\overline{{\mathbb{F}}};{\mathbb{O}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝔽</mi><mo>,</mo><mover accent="true"><mi>𝔽</mi><mo stretchy="true">¯</mo></mover><mo>,</mo><mi>𝕆</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}},\overline{{\mathbb{F}}};{\mathbb{O}})</annotation></semantics></math>). Notice that the involved moduli spaces are identical to moduli spaces for the diagonal bimodule <math id="S13.I2.i7.p2.m14" class="ltx_Math" alttext="\mathbb{\Delta}^{\mathbb{F}{\mathbb{F}}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{\Delta}^{\mathbb{F}{\mathbb{F}}}</annotation></semantics></math>.</p>
</div>
<div id="S13.I2.i7.p3" class="ltx_para ltx_noindent">
<p id="S13.I2.i7.p3.1" class="ltx_p">Notice that <math id="S13.I2.i7.p3.m1" class="ltx_Math" alttext="{\mathbb{O}}" display="inline" intent=":literal"><semantics><mi>𝕆</mi><annotation encoding="application/x-tex">{\mathbb{O}}</annotation></semantics></math> contains a special object, or rather a subcategory <math id="S13.I2.i7.p3.m2" class="ltx_Math" alttext="\underline{\smash{\mathbb{O}}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝕆</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\mathbb{O}}}</annotation></semantics></math> corresponding to the trivial element of <math id="S13.I2.i7.p3.m3" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>. Let <math id="S13.I2.i7.p3.m4" class="ltx_Math" alttext="{\mathbb{X}}_{0}^{\rm PD}" display="inline" intent=":literal"><semantics><msubsup><mi>𝕏</mi><mn>0</mn><mi>PD</mi></msubsup><annotation encoding="application/x-tex">{\mathbb{X}}_{0}^{\rm PD}</annotation></semantics></math> be the restriction to <math id="S13.I2.i7.p3.m5" class="ltx_Math" alttext="\underline{\smash{\mathbb{O}}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝕆</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\mathbb{O}}}</annotation></semantics></math>, which is a multimodule over <math id="S13.I2.i7.p3.m6" class="ltx_Math" alttext="({\mathbb{F}},\overline{\mathbb{F}};\underline{\smash{\mathbb{O}}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝔽</mi><mo>,</mo><mover accent="true"><mi>𝔽</mi><mo stretchy="true">¯</mo></mover><mo>,</mo><munder accentunder="true"><mi>𝕆</mi><mo stretchy="true">¯</mo></munder><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}},\overline{\mathbb{F}};\underline{\smash{\mathbb{O}}})</annotation></semantics></math>. Let</p>
<table id="S13.Ex58" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex58.m1" class="ltx_Math" alttext="\Phi_{0}^{\rm PD}:CF(H)\otimes CF(\overline{H})\to{\bf K}" display="block" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Φ</mi><mn>0</mn><mi>PD</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi>𝐊</mi></mrow></mrow><annotation encoding="application/x-tex">\Phi_{0}^{\rm PD}:CF(H)\otimes CF(\overline{H})\to{\bf K}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.I2.i7.p3.2" class="ltx_p">be the chain-level pairing. Notice that <math id="S13.I2.i7.p3.m7" class="ltx_Math" alttext="\Phi_{0}^{\rm PD}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Φ</mi><mn>0</mn><mi>PD</mi></msubsup><annotation encoding="application/x-tex">\Phi_{0}^{\rm PD}</annotation></semantics></math> only comes from trivial Floer cylinders, hence is obviously a nondegenerate pairing (in both variables).</p>
</div>
<div id="S13.I2.i7.p4" class="ltx_para ltx_noindent">
<p id="S13.I2.i7.p4.1" class="ltx_p">Now we start to prove Poincaré duality property of spectral invariants. Fix <math id="S13.I2.i7.p4.m1" class="ltx_Math" alttext="x\in HF(X)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x\in HF(X)</annotation></semantics></math>.</p>
<ol id="S13.I2.i7.I1" class="ltx_enumerate">
<li id="S13.I2.i7.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(a)</span> 
<div id="S13.I2.i7.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="S13.I2.i7.I1.i1.p1.1" class="ltx_p">We first prove that</p>
<table id="S13.Ex59" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex59.m1" class="ltx_math_unparsed" alttext="c_{H}(x)\geq-\inf\Big\{c_{\overline{H}}(y)\ |\ \Phi_{0}^{\rm PD}(x,y)\neq 0\Big\}" display="block" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>H</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo rspace="0em">≥</mo><mo lspace="0em">−</mo><mo lspace="0em" movablelimits="false" rspace="0em">inf</mo><mrow><mo stretchy="false">{</mo><msub><mi>c</mi><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover></msub><mrow><mo stretchy="false">(</mo><mi>y</mi><mo rspace="0.500em" stretchy="false">)</mo></mrow><mo fence="false" rspace="0.667em" stretchy="false">|</mo><msubsup><mi mathvariant="normal">Φ</mi><mn>0</mn><mi>PD</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>≠</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">c_{H}(x)\geq-\inf\Big\{c_{\overline{H}}(y)\ |\ \Phi_{0}^{\rm PD}(x,y)\neq 0\Big\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.I2.i7.I1.i1.p1.2" class="ltx_p">Indeed, the multimodule <math id="S13.I2.i7.I1.i1.p1.m1" class="ltx_Math" alttext="{\mathbb{X}}_{0}^{\mathbb{PD}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝕏</mi><mn>0</mn><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔻</mi></mrow></msubsup><annotation encoding="application/x-tex">{\mathbb{X}}_{0}^{\mathbb{PD}}</annotation></semantics></math> has a threshold <math id="S13.I2.i7.I1.i1.p1.m2" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> (see Definition <a href="#S7.Thmthm41" title="Definition 7.41. ‣ 7.5.4. Continuity ‣ 7.5. Quantitative theories ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.41</span></a>). So for any <math id="S13.I2.i7.I1.i1.p1.m3" class="ltx_Math" alttext="y\in HF(X)" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>∈</mo><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">y\in HF(X)</annotation></semantics></math>, if <math id="S13.I2.i7.I1.i1.p1.m4" class="ltx_Math" alttext="\Phi_{0}^{\rm PD}(x,y)\neq 0" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi mathvariant="normal">Φ</mi><mn>0</mn><mi>PD</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Phi_{0}^{\rm PD}(x,y)\neq 0</annotation></semantics></math>, then there exist cycles <math id="S13.I2.i7.I1.i1.p1.m5" class="ltx_Math" alttext="{\mathfrak{x}}" display="inline" intent=":literal"><semantics><mi>𝔵</mi><annotation encoding="application/x-tex">{\mathfrak{x}}</annotation></semantics></math> and <math id="S13.I2.i7.I1.i1.p1.m6" class="ltx_Math" alttext="{\mathfrak{y}}" display="inline" intent=":literal"><semantics><mi>𝔶</mi><annotation encoding="application/x-tex">{\mathfrak{y}}</annotation></semantics></math> representing them such that the chain-level pairing between <math id="S13.I2.i7.I1.i1.p1.m7" class="ltx_Math" alttext="{\mathfrak{x}}" display="inline" intent=":literal"><semantics><mi>𝔵</mi><annotation encoding="application/x-tex">{\mathfrak{x}}</annotation></semantics></math> and <math id="S13.I2.i7.I1.i1.p1.m8" class="ltx_Math" alttext="{\mathfrak{y}}" display="inline" intent=":literal"><semantics><mi>𝔶</mi><annotation encoding="application/x-tex">{\mathfrak{y}}</annotation></semantics></math> is nonzero. Then by Proposition <a href="#S7.Thmthm42" title="Proposition 7.42. ‣ 7.5.4. Continuity ‣ 7.5. Quantitative theories ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.42</span></a>, one has</p>
<table id="S13.Ex60" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex60.m1" class="ltx_Math" alttext="{\mathcal{A}}_{H}({\mathfrak{x}})+{\mathcal{A}}_{\overline{H}}({\mathfrak{y}})\geq 0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝔵</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝔶</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{A}}_{H}({\mathfrak{x}})+{\mathcal{A}}_{\overline{H}}({\mathfrak{y}})\geq 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.I2.i7.I1.i1.p1.3" class="ltx_p">As <math id="S13.I2.i7.I1.i1.p1.m9" class="ltx_Math" alttext="{\mathcal{A}}_{H}({\mathfrak{x}})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝔵</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{A}}_{H}({\mathfrak{x}})</annotation></semantics></math> and <math id="S13.I2.i7.I1.i1.p1.m10" class="ltx_Math" alttext="{\mathcal{A}}_{\overline{H}}({\mathfrak{y}})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝔶</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{A}}_{\overline{H}}({\mathfrak{y}})</annotation></semantics></math> can approximate <math id="S13.I2.i7.I1.i1.p1.m11" class="ltx_Math" alttext="c_{H}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">c_{H}(x)</annotation></semantics></math> and <math id="S13.I2.i7.I1.i1.p1.m12" class="ltx_Math" alttext="c_{\overline{H}}(y)" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">c_{\overline{H}}(y)</annotation></semantics></math> respectively, one has</p>
<table id="S13.Ex61" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex61.m1" class="ltx_Math" alttext="\Phi_{0}^{\rm PD}(x,y)\neq 0\Longrightarrow c_{H}(x)+c_{\overline{H}}(y)\geq 0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi mathvariant="normal">Φ</mi><mn>0</mn><mi>PD</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mn>0</mn><mo stretchy="false">⟹</mo><mrow><mrow><msub><mi>c</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>c</mi><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Phi_{0}^{\rm PD}(x,y)\neq 0\Longrightarrow c_{H}(x)+c_{\overline{H}}(y)\geq 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.I2.i7.I1.i1.p1.4" class="ltx_p">Then one has</p>
<table id="S13.Ex62" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex62.m1" class="ltx_Math" alttext="c_{H}(x)\geq\sup\Big\{-c_{\overline{H}}(y)\ |\ \Phi_{0}^{\rm PD}(x,y)=0\Big\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>c</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">≥</mo><mrow><mo lspace="0.1389em" movablelimits="false" rspace="0em">sup</mo><mrow><mo stretchy="false">{</mo><mrow><mo>−</mo><mrow><msub><mi>c</mi><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo rspace="0.222em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.500em">|</mo><mrow><mrow><msubsup><mi mathvariant="normal">Φ</mi><mn>0</mn><mi>PD</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">c_{H}(x)\geq\sup\Big\{-c_{\overline{H}}(y)\ |\ \Phi_{0}^{\rm PD}(x,y)=0\Big\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S13.I2.i7.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(b)</span> 
<div id="S13.I2.i7.I1.i2.p1" class="ltx_para ltx_noindent">
<p id="S13.I2.i7.I1.i2.p1.1" class="ltx_p">We prove that for all <math id="S13.I2.i7.I1.i2.p1.m1" class="ltx_Math" alttext="\epsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon&gt;0</annotation></semantics></math>,</p>
<table id="S13.Ex63" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex63.m1" class="ltx_Math" alttext="c_{H}(x)&lt;\epsilon-\inf\Big\{c_{\overline{H}}(y)\ |\ \Phi_{0}^{\rm PD}(x,y)\neq 0\Big\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>c</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mi>ϵ</mi><mo>−</mo><mrow><mo lspace="0em" movablelimits="false" rspace="0em">inf</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>c</mi><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo rspace="0.222em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.500em">|</mo><mrow><mrow><msubsup><mi mathvariant="normal">Φ</mi><mn>0</mn><mi>PD</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">c_{H}(x)&lt;\epsilon-\inf\Big\{c_{\overline{H}}(y)\ |\ \Phi_{0}^{\rm PD}(x,y)\neq 0\Big\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.I2.i7.I1.i2.p1.2" class="ltx_p">Choose <math id="S13.I2.i7.I1.i2.p1.m2" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math> such that <math id="S13.I2.i7.I1.i2.p1.m3" class="ltx_Math" alttext="\alpha:=\epsilon-c_{H}(x)\notin{\rm Spec}(\overline{H})" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>:=</mo><mrow><mi>ϵ</mi><mo>−</mo><mrow><msub><mi>c</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>∉</mo><mrow><mi>Spec</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\alpha:=\epsilon-c_{H}(x)\notin{\rm Spec}(\overline{H})</annotation></semantics></math>. By energy consideration, the restriction of the chain-level pairing <math id="S13.I2.i7.I1.i2.p1.m4" class="ltx_Math" alttext="\Phi_{0}^{\rm PD}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Φ</mi><mn>0</mn><mi>PD</mi></msubsup><annotation encoding="application/x-tex">\Phi_{0}^{\rm PD}</annotation></semantics></math> to</p>
<table id="S13.Ex64" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex64.m1" class="ltx_Math" alttext="CF(H)^{&lt;\beta}\otimes CF(\overline{H})^{&lt;\gamma}\to{\bf K}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo>&lt;</mo><mi>β</mi></mrow></msup></mrow><mo rspace="0.222em">⊗</mo><mi>C</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo>&lt;</mo><mi>γ</mi></mrow></msup></mrow><mo stretchy="false">→</mo><mi>𝐊</mi></mrow><annotation encoding="application/x-tex">CF(H)^{&lt;\beta}\otimes CF(\overline{H})^{&lt;\gamma}\to{\bf K}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.I2.i7.I1.i2.p1.3" class="ltx_p">vanishes when <math id="S13.I2.i7.I1.i2.p1.m5" class="ltx_Math" alttext="\beta+\gamma&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>β</mi><mo>+</mo><mi>γ</mi></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\beta+\gamma&lt;0</annotation></semantics></math>. Hence one obtains a well-defined nondegenerate pairing</p>
<table id="S13.Ex65" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex65.m1" class="ltx_Math" alttext="\Phi_{0,\alpha}^{\rm PD}:HF(H)^{&gt;-\alpha}\otimes HF(\overline{H})^{&lt;\alpha}\to{\bf K}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi mathvariant="normal">Φ</mi><mrow><mn>0</mn><mo>,</mo><mi>α</mi></mrow><mi>PD</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo>&gt;</mo><mrow><mo>−</mo><mi>α</mi></mrow></mrow></msup></mrow><mo rspace="0.222em">⊗</mo><mi>H</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo>&lt;</mo><mi>α</mi></mrow></msup></mrow><mo stretchy="false">→</mo><mi>𝐊</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Phi_{0,\alpha}^{\rm PD}:HF(H)^{&gt;-\alpha}\otimes HF(\overline{H})^{&lt;\alpha}\to{\bf K}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.I2.i7.I1.i2.p1.4" class="ltx_p">As <math id="S13.I2.i7.I1.i2.p1.m6" class="ltx_Math" alttext="-\alpha=c_{H}(x)-\epsilon&lt;c_{H}(x)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mi>α</mi></mrow><mo>=</mo><mrow><mrow><msub><mi>c</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>ϵ</mi></mrow><mo>&lt;</mo><mrow><msub><mi>c</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">-\alpha=c_{H}(x)-\epsilon&lt;c_{H}(x)</annotation></semantics></math>,</p>
<table id="S13.Ex66" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex66.m1" class="ltx_Math" alttext="x\notin{\rm Im}\Big(HF(H)^{&lt;-\alpha}\to HF(X)\Big)." display="block" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>∉</mo><mrow><mi>Im</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo>&lt;</mo><mrow><mo>−</mo><mi>α</mi></mrow></mrow></msup></mrow><mo stretchy="false">→</mo><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">x\notin{\rm Im}\Big(HF(H)^{&lt;-\alpha}\to HF(X)\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.I2.i7.I1.i2.p1.5" class="ltx_p">Therefore, the image of <math id="S13.I2.i7.I1.i2.p1.m7" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> under</p>
<table id="S13.Ex67" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex67.m1" class="ltx_Math" alttext="HF(X)\to HF(H)^{&gt;-\alpha}" display="block" intent=":literal"><semantics><mrow><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo>&gt;</mo><mrow><mo>−</mo><mi>α</mi></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">HF(X)\to HF(H)^{&gt;-\alpha}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S13.I2.i7.I1.i2.p1.6" class="ltx_p">denoted by <math id="S13.I2.i7.I1.i2.p1.m8" class="ltx_Math" alttext="x_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>α</mi></msub><annotation encoding="application/x-tex">x_{\alpha}</annotation></semantics></math>, is nonzero. By the nondegeneracy of the pairing <math id="S13.I2.i7.I1.i2.p1.m9" class="ltx_Math" alttext="\Phi_{0,\alpha}^{\rm PD}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Φ</mi><mrow><mn>0</mn><mo>,</mo><mi>α</mi></mrow><mi>PD</mi></msubsup><annotation encoding="application/x-tex">\Phi_{0,\alpha}^{\rm PD}</annotation></semantics></math>, there exists <math id="S13.I2.i7.I1.i2.p1.m10" class="ltx_Math" alttext="y_{\alpha}\in HF(\overline{H})^{&lt;\alpha}" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mi>α</mi></msub><mo>∈</mo><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo>&lt;</mo><mi>α</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">y_{\alpha}\in HF(\overline{H})^{&lt;\alpha}</annotation></semantics></math> such that <math id="S13.I2.i7.I1.i2.p1.m11" class="ltx_Math" alttext="\Phi_{0,\alpha}^{\rm PD}(x_{\alpha},y_{\alpha})\neq 0" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi mathvariant="normal">Φ</mi><mrow><mn>0</mn><mo>,</mo><mi>α</mi></mrow><mi>PD</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>α</mi></msub><mo>,</mo><msub><mi>y</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Phi_{0,\alpha}^{\rm PD}(x_{\alpha},y_{\alpha})\neq 0</annotation></semantics></math>. Choose a cycle <math id="S13.I2.i7.I1.i2.p1.m12" class="ltx_Math" alttext="{\mathfrak{x}}\in CF(H)^{\leq c_{H}(x)}" display="inline" intent=":literal"><semantics><mrow><mi>𝔵</mi><mo>∈</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>c</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">{\mathfrak{x}}\in CF(H)^{\leq c_{H}(x)}</annotation></semantics></math> representing <math id="S13.I2.i7.I1.i2.p1.m13" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> and a cycle <math id="S13.I2.i7.I1.i2.p1.m14" class="ltx_Math" alttext="{\mathfrak{y}}\in CF(\overline{H})^{&lt;\alpha}" display="inline" intent=":literal"><semantics><mrow><mi>𝔶</mi><mo>∈</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo>&lt;</mo><mi>α</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">{\mathfrak{y}}\in CF(\overline{H})^{&lt;\alpha}</annotation></semantics></math> representing <math id="S13.I2.i7.I1.i2.p1.m15" class="ltx_Math" alttext="y_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>α</mi></msub><annotation encoding="application/x-tex">y_{\alpha}</annotation></semantics></math>. Then the chain level pairing <math id="S13.I2.i7.I1.i2.p1.m16" class="ltx_Math" alttext="\Phi_{0}^{\rm PD}({\mathfrak{x}},{\mathfrak{y}})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Φ</mi><mn>0</mn><mi>PD</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝔵</mi><mo>,</mo><mi>𝔶</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Phi_{0}^{\rm PD}({\mathfrak{x}},{\mathfrak{y}})</annotation></semantics></math> is nonzero. As <math id="S13.I2.i7.I1.i2.p1.m17" class="ltx_Math" alttext="{\mathfrak{x}}" display="inline" intent=":literal"><semantics><mi>𝔵</mi><annotation encoding="application/x-tex">{\mathfrak{x}}</annotation></semantics></math> is closed, <math id="S13.I2.i7.I1.i2.p1.m18" class="ltx_Math" alttext="{\mathfrak{y}}" display="inline" intent=":literal"><semantics><mi>𝔶</mi><annotation encoding="application/x-tex">{\mathfrak{y}}</annotation></semantics></math> is not a boundary. Hence the map <math id="S13.I2.i7.I1.i2.p1.m19" class="ltx_Math" alttext="HF(\overline{H})^{&lt;\alpha}\to HF(X)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo>&lt;</mo><mi>α</mi></mrow></msup></mrow><mo stretchy="false">→</mo><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">HF(\overline{H})^{&lt;\alpha}\to HF(X)</annotation></semantics></math> does not annihilate <math id="S13.I2.i7.I1.i2.p1.m20" class="ltx_Math" alttext="y_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>α</mi></msub><annotation encoding="application/x-tex">y_{\alpha}</annotation></semantics></math>. Denote the image by <math id="S13.I2.i7.I1.i2.p1.m21" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math>. Then <math id="S13.I2.i7.I1.i2.p1.m22" class="ltx_Math" alttext="\Phi_{0}^{\rm PD}(x,y)\neq 0" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi mathvariant="normal">Φ</mi><mn>0</mn><mi>PD</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Phi_{0}^{\rm PD}(x,y)\neq 0</annotation></semantics></math>. Then one has</p>
<table id="S13.Ex68" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S13.Ex68.m1" class="ltx_Math" alttext="c_{\overline{H}}(y)\leq\alpha=\epsilon-c_{H}(x)\Longrightarrow c_{H}(x)\leq\epsilon-c_{\overline{H}}(y)\leq\epsilon-\inf\Big\{c_{\overline{H}}(y)\ |\ \Phi_{0}^{\rm PD}(x,y)\neq 0\Big\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>c</mi><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>α</mi><mo>=</mo><mrow><mi>ϵ</mi><mo>−</mo><mrow><msub><mi>c</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟹</mo><mrow><msub><mi>c</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>ϵ</mi><mo>−</mo><mrow><msub><mi>c</mi><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mi>ϵ</mi><mo>−</mo><mrow><mo lspace="0em" movablelimits="false" rspace="0em">inf</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>c</mi><mover accent="true"><mi>H</mi><mo stretchy="true">¯</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo rspace="0.222em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.500em">|</mo><mrow><mrow><msubsup><mi mathvariant="normal">Φ</mi><mn>0</mn><mi>PD</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">c_{\overline{H}}(y)\leq\alpha=\epsilon-c_{H}(x)\Longrightarrow c_{H}(x)\leq\epsilon-c_{\overline{H}}(y)\leq\epsilon-\inf\Big\{c_{\overline{H}}(y)\ |\ \Phi_{0}^{\rm PD}(x,y)\neq 0\Big\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
</div>
<div id="S13.I2.i7.p5" class="ltx_para ltx_noindent">
<p id="S13.I2.i7.p5.1" class="ltx_p">Combining (a) and (b), we conclude that Poincaré duality holds.</p>
</div></li>
</ol>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
</section>
</section>
<section id="Pt3" class="ltx_part">
<h2 class="ltx_title ltx_title_part"><span class="ltx_tag ltx_tag_part">Part III </span>THE AMS CONSTRUCTION</h2>

<section id="Sx3" class="ltx_section">
<h3 class="ltx_title ltx_title_section">Outline of Part 3</h3>

<div id="Sx3.p1" class="ltx_para ltx_noindent">
<p id="Sx3.p1.1" class="ltx_p">We go through the AMS construction of lifts of various geometric flow categories, multimodules, and homotopies to the category of (collared rigidified) smooth normally complex Kuranishi spaces.</p>
</div>
</section>
<section id="S14" class="ltx_section">
<h3 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">14. </span>The Flow Categories, Multimodules, and Homotopies of Domains</h3>

<div id="S14.p1" class="ltx_para ltx_noindent">
<p id="S14.p1.1" class="ltx_p">The Abouzaid–McLean–Smith (AMS) construction of global charts for genus zero Gromov–Witten theory <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib61" title="" class="ltx_ref">3</a>]</cite> uses certain auxiliary moduli spaces of rational curves in projective spaces. To extend such construction to the case of Floer moduli spaces, we consider an analogy, which is an auxiliary flow category. The final goal of this section is to describe a flow category enriched in an intermediate category. The discussion in this section and subsequent ones has certain overlap with <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib57" title="" class="ltx_ref">14</a>, Section 5]</cite>, but we include these expositions to make the paper self-contained and various technical aspects more streamlined.</p>
</div>
<section id="S14.SS1" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">14.1. </span>Monotone flow categories, multimodules, and homotopies</h4>

<section id="S14.SS1.SSS1" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">14.1.1. </span>Monotone flow category</h5>

<div id="S14.SS1.SSS1.p1" class="ltx_para ltx_noindent">
<p id="S14.SS1.SSS1.p1.1" class="ltx_p">We introduce the technical notion of monotone flow categories to simplify the discussions.</p>
</div>
<div id="S14.SS1.SSS1.p2" class="ltx_para ltx_noindent">
<p id="S14.SS1.SSS1.p2.1" class="ltx_p">We introduce the following normal poset used frequently in this paper. For each <math id="S14.SS1.SSS1.p2.m1" class="ltx_Math" alttext="d\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d\geq 0</annotation></semantics></math>, define</p>
<table id="S14.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex1.m1" class="ltx_Math" alttext="A_{d}=\left\{\begin{array}[]{cc}\Big\{(d_{0},\ldots,d_{l})\ |\ d_{i}&gt;0,\ d_{0}+\cdots+d_{l}=d\Big\},&amp;\ d\neq 0,\\
\{(0)\},&amp;\ d=0.\end{array}\right." display="block" intent=":literal"><semantics><mrow><msub><mi>A</mi><mi>d</mi></msub><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd><mrow><mo stretchy="false">{</mo><mo stretchy="false">(</mo><mi>d</mi><msub><mrow></mrow><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>d</mi><msub><mrow></mrow><mi>l</mi></msub><mo rspace="0.500em" stretchy="false">)</mo><mo fence="false" rspace="0.667em" stretchy="false">|</mo><mi>d</mi><msub><mrow></mrow><mi>i</mi></msub><mo>&gt;</mo><mn>0</mn><mo rspace="0.667em">,</mo><mi>d</mi><msub><mrow></mrow><mn>0</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><mi>d</mi><msub><mrow></mrow><mi>l</mi></msub><mo>=</mo><mi>d</mi><mo stretchy="false">}</mo><mo>,</mo></mrow></mtd><mtd><mrow><mrow><mi>d</mi><mo>≠</mo><mn>0</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mo>,</mo></mrow></mtd><mtd><mrow><mrow><mi>d</mi><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">A_{d}=\left\{\begin{array}[]{cc}\Big\{(d_{0},\ldots,d_{l})\ |\ d_{i}&gt;0,\ d_{0}+\cdots+d_{l}=d\Big\},&amp;\ d\neq 0,\\
\{(0)\},&amp;\ d=0.\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.SS1.SSS1.p2.2" class="ltx_p">The depth function is the number <math id="S14.SS1.SSS1.p2.m2" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>. There are also homogeneous inclusions of degree <math id="S14.SS1.SSS1.p2.m3" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math></p>
<table id="S14.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.E1.m1" class="ltx_Math" alttext="A_{d}\times A_{d^{\prime}}\to A_{d+d^{\prime}}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>A</mi><mi>d</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>A</mi><msup><mi>d</mi><mo>′</mo></msup></msub></mrow><mo stretchy="false">→</mo><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><msup><mi>d</mi><mo>′</mo></msup></mrow></msub></mrow><annotation encoding="application/x-tex">A_{d}\times A_{d^{\prime}}\to A_{d+d^{\prime}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(14.1)</span></td></tr></tbody>
</table>
<p id="S14.SS1.SSS1.p2.3" class="ltx_p">defined by the natural concatenation.</p>
</div>
<div id="S14.Thmthm1" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S14.Thmthm1.2" class="ltx_text ltx_font_bold">Definition 14.1</span></span><span id="S14.Thmthm1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S14.Thmthm1.p1" class="ltx_para ltx_noindent">
<p id="S14.Thmthm1.p1.1" class="ltx_p">Let <math id="S14.Thmthm1.p1.m1" class="ltx_Math" alttext="\underline{\smash{\bf C}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐂</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf C}}</annotation></semantics></math> be a regular stratification category. A <span id="S14.Thmthm1.p1.1.1" class="ltx_text ltx_font_bold">monotone flow category</span> enriched in <math id="S14.Thmthm1.p1.m2" class="ltx_Math" alttext="\underline{\smash{\bf C}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐂</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf C}}</annotation></semantics></math>, denoted by <math id="S14.Thmthm1.p1.m3" class="ltx_Math" alttext="{\mathbb{f}}" display="inline" intent=":literal"><semantics><mi>𝕗</mi><annotation encoding="application/x-tex">{\mathbb{f}}</annotation></semantics></math>, consists of for each <math id="S14.Thmthm1.p1.m4" class="ltx_Math" alttext="d\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d\geq 0</annotation></semantics></math> an object <math id="S14.Thmthm1.p1.m5" class="ltx_Math" alttext="M_{d}^{\mathbb{f}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mi>d</mi><mi>𝕗</mi></msubsup><annotation encoding="application/x-tex">M_{d}^{\mathbb{f}}</annotation></semantics></math> in <math id="S14.Thmthm1.p1.m6" class="ltx_Math" alttext="\underline{\smash{\bf C}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐂</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf C}}</annotation></semantics></math> together with morphisms</p>
<table id="S14.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex2.m1" class="ltx_Math" alttext="\iota_{dd^{\prime}}^{\mathbb{f}}:M_{d}^{\mathbb{f}}\times M_{d^{\prime}}^{\mathbb{f}}\to M_{d+d^{\prime}}^{\mathbb{f}}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>ι</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mo>′</mo></msup></mrow><mi>𝕗</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mi>M</mi><mi>d</mi><mi>𝕗</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>M</mi><msup><mi>d</mi><mo>′</mo></msup><mi>𝕗</mi></msubsup></mrow><mo stretchy="false">→</mo><msubsup><mi>M</mi><mrow><mi>d</mi><mo>+</mo><msup><mi>d</mi><mo>′</mo></msup></mrow><mi>𝕗</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\iota_{dd^{\prime}}^{\mathbb{f}}:M_{d}^{\mathbb{f}}\times M_{d^{\prime}}^{\mathbb{f}}\to M_{d+d^{\prime}}^{\mathbb{f}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.Thmthm1.p1.2" class="ltx_p">satisfying the following conditions.</p>
</div>
<div id="S14.Thmthm1.p2" class="ltx_para">
<ol id="S14.I1" class="ltx_enumerate">
<li id="S14.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S14.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="S14.I1.i1.p1.1" class="ltx_p">For <math id="S14.I1.i1.p1.m1" class="ltx_Math" alttext="d=0" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d=0</annotation></semantics></math>, <math id="S14.I1.i1.p1.m2" class="ltx_Math" alttext="M_{d}^{\mathbb{f}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mi>d</mi><mi>𝕗</mi></msubsup><annotation encoding="application/x-tex">M_{d}^{\mathbb{f}}</annotation></semantics></math> is a singleton in <math id="S14.I1.i1.p1.m3" class="ltx_Math" alttext="\underline{\smash{\bf C}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐂</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf C}}</annotation></semantics></math>.</p>
</div></li>
<li id="S14.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S14.I1.i2.p1" class="ltx_para ltx_noindent">
<p id="S14.I1.i2.p1.1" class="ltx_p">The associativity: for <math id="S14.I1.i2.p1.m1" class="ltx_Math" alttext="d,d^{\prime},d^{\prime\prime}\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>,</mo><msup><mi>d</mi><mo>′</mo></msup><mo>,</mo><mrow><msup><mi>d</mi><mo>′′</mo></msup><mo>≥</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">d,d^{\prime},d^{\prime\prime}\geq 0</annotation></semantics></math>, the following diagram commutes.</p>
<table id="S14.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S14.Ex3.m1.pic1" class="ltx_picture ltx_markedasmath" height="70.10" overflow="visible" style="vertical-align:-57.665026664601925px" version="1.1" viewBox="55.33 57.67 233.57 70.10" width="233.57"><g transform="matrix(1 0 0 -1 55.33288322544797 70.10451850347438) translate(0,3.46) translate(55.33,0)"><g transform="translate(-55.33,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:7.4em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.24em;font-size:10pt;" height="15" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="102.36"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S14.Ex3.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{M_{d}^{\mathbb{f}}\times M_{d^{\prime}}^{\mathbb{f}}\times M_{d^{\prime\prime}}^{\mathbb{f}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>M</mi><mi>d</mi><mi>𝕗</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>M</mi><msup><mi>d</mi><mo>′</mo></msup><mi>𝕗</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>M</mi><msup><mi>d</mi><mo>′′</mo></msup><mi>𝕗</mi></msubsup></mrow><annotation encoding="application/x-tex">\textstyle{M_{d}^{\mathbb{f}}\times M_{d^{\prime}}^{\mathbb{f}}\times M_{d^{\prime\prime}}^{\mathbb{f}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 55.33290433903461 -0.27673578005007266 L 55.33290433903461 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(88.54,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 55.33290433903461 -0.27673578005007266 L 88.54168355753598 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 88.54168355753598 -0.27673578005007266 L 88.54168355753598 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -10.863637073052875 L 0.27673578005007266 -10.863637073052875" fill="none" stroke="#000000"></path><g transform="translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.208800332088 L 0.27673578005007266 -10.863637073052875" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.208800332088 L 0.27673578005007266 -33.208800332088" fill="none" stroke="#000000"></path><g transform="translate(88.54,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:5.88em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.32em;font-size:10pt;" height="16.15" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="81.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S14.Ex3.m1.pic1.m2" class="ltx_Math" alttext="\textstyle{M_{d+d^{\prime}}^{\mathbb{f}}\times M_{d^{\prime\prime}}^{\mathbb{f}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>M</mi><mrow><mi>d</mi><mo>+</mo><msup><mi>d</mi><mo>′</mo></msup></mrow><mi>𝕗</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>M</mi><msup><mi>d</mi><mo>′′</mo></msup><mi>𝕗</mi></msubsup></mrow><annotation encoding="application/x-tex">\textstyle{M_{d+d^{\prime}}^{\mathbb{f}}\times M_{d^{\prime\prime}}^{\mathbb{f}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 133.11442851162525 -12.016734493641467 L 133.6679000717254 -12.016734493641467" fill="none" stroke="#000000"></path><g transform="translate(133.39,0) translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 133.11442851162525 -33.208800332088 L 133.6679000717254 -12.016734493641467" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 133.11442851162525 -33.208800332088 L 133.6679000717254 -33.208800332088" fill="none" stroke="#000000"></path><g transform="translate(-44.85,0) translate(0,-45.65) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:5.88em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.32em;font-size:10pt;" height="16.15" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="81.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S14.Ex3.m1.pic1.m3" class="ltx_Math" alttext="\textstyle{M_{d}^{\mathbb{f}}\times M_{d^{\prime}+d^{\prime\prime}}^{\mathbb{f}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>M</mi><mi>d</mi><mi>𝕗</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>M</mi><mrow><msup><mi>d</mi><mo>′</mo></msup><mo>+</mo><msup><mi>d</mi><mo>′′</mo></msup></mrow><mi>𝕗</mi></msubsup></mrow><annotation encoding="application/x-tex">\textstyle{M_{d}^{\mathbb{f}}\times M_{d^{\prime}+d^{\prime\prime}}^{\mathbb{f}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 44.849501847725975 -45.925027951010534 L 44.849501847725975 -45.371556390910385" fill="none" stroke="#000000"></path><g transform="translate(99.03,0) translate(0,-45.65)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 44.849501847725975 -45.925027951010534 L 99.02508604884461 -45.371556390910385" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 99.02508604884461 -45.925027951010534 L 99.02508604884461 -45.371556390910385" fill="none" stroke="#000000"></path><g transform="translate(99.03,0) translate(0,-45.65) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:4.37em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.32em;font-size:10pt;" height="16.15" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="60.43"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S14.Ex3.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{M_{d+d^{\prime}+d^{\prime\prime}}^{\mathbb{f}}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mrow><mi>d</mi><mo>+</mo><msup><mi>d</mi><mo>′</mo></msup><mo>+</mo><msup><mi>d</mi><mo>′′</mo></msup></mrow><mi>𝕗</mi></msubsup><annotation encoding="application/x-tex">\textstyle{M_{d+d^{\prime}+d^{\prime\prime}}^{\mathbb{f}}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
</div>
</div>
<div id="S14.Thmthm2" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S14.Thmthm2.2" class="ltx_text ltx_font_italic">Remark 14.2</span></span><span id="S14.Thmthm2.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S14.Thmthm2.p1" class="ltx_para ltx_noindent">
<p id="S14.Thmthm2.p1.1" class="ltx_p">Notice that given a monotone flow category <math id="S14.Thmthm2.p1.m1" class="ltx_Math" alttext="\mathbb{f}" display="inline" intent=":literal"><semantics><mi>𝕗</mi><annotation encoding="application/x-tex">\mathbb{f}</annotation></semantics></math>, one obtains an ordinary flow category, denoted by <math id="S14.Thmthm2.p1.m2" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math>, whose object set is <math id="S14.Thmthm2.p1.m3" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>. The partial order is the opposite of the natural one on <math id="S14.Thmthm2.p1.m4" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>. The space of morphisms from <math id="S14.Thmthm2.p1.m5" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> to <math id="S14.Thmthm2.p1.m6" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math> (with <math id="S14.Thmthm2.p1.m7" class="ltx_Math" alttext="a\geq b" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>≥</mo><mi>b</mi></mrow><annotation encoding="application/x-tex">a\geq b</annotation></semantics></math>) is</p>
<table id="S14.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex4.m1" class="ltx_Math" alttext="M_{ab}^{\mathbb{F}}=M_{a-b}^{\mathbb{f}}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>M</mi><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow><mi>𝔽</mi></msubsup><mo>=</mo><msubsup><mi>M</mi><mrow><mi>a</mi><mo>−</mo><mi>b</mi></mrow><mi>𝕗</mi></msubsup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">M_{ab}^{\mathbb{F}}=M_{a-b}^{\mathbb{f}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.Thmthm2.p1.2" class="ltx_p">Moreover, the flow category <math id="S14.Thmthm2.p1.m8" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> has a free action by <math id="S14.Thmthm2.p1.m9" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>.</p>
</div>
</div>
<div id="S14.Thmthm3" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S14.Thmthm3.2" class="ltx_text ltx_font_italic">Remark 14.3</span></span><span id="S14.Thmthm3.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S14.Thmthm3.p1" class="ltx_para ltx_noindent">
<p id="S14.Thmthm3.p1.1" class="ltx_p">One can generalize the notion of monotone flow categories by replacing <math id="S14.Thmthm3.p1.m1" class="ltx_Math" alttext="{\mathbb{Z}}_{\geq 0}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">{\mathbb{Z}}_{\geq 0}</annotation></semantics></math> with certain other abelian monoids. One option is <math id="S14.Thmthm3.p1.m2" class="ltx_Math" alttext="{\mathbb{Z}}_{\geq 0}^{k}" display="inline" intent=":literal"><semantics><msubsup><mi>ℤ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow><mi>k</mi></msubsup><annotation encoding="application/x-tex">{\mathbb{Z}}_{\geq 0}^{k}</annotation></semantics></math>, where the <math id="S14.Thmthm3.p1.m3" class="ltx_Math" alttext="k=2" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">k=2</annotation></semantics></math> case will be used to prove Proposition <a href="#S12.Thmthm2" title="Proposition 12.2. ‣ 12.1. Main statements for Floer flow categories ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12.2</span></a>. The corresponding flow category has object set being <math id="S14.Thmthm3.p1.m4" class="ltx_Math" alttext="{\mathbb{Z}}^{2}" display="inline" intent=":literal"><semantics><msup><mi>ℤ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">{\mathbb{Z}}^{2}</annotation></semantics></math>. The other is the effective cone</p>
<table id="S14.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex5.m1" class="ltx_Math" alttext="\Pi^{\rm eff}=\{a\in\Pi\ |\ \omega(a)&gt;0\}\cup\{0\}" display="block" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Π</mi><mi>eff</mi></msup><mo>=</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mi>a</mi><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow><mo lspace="0.500em" rspace="0.500em">|</mo><mrow><mrow><mi>ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow><mo>∪</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Pi^{\rm eff}=\{a\in\Pi\ |\ \omega(a)&gt;0\}\cup\{0\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.Thmthm3.p1.2" class="ltx_p">of a symplectic manifold. The corresponding flow category has object set being <math id="S14.Thmthm3.p1.m5" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>.</p>
</div>
</div>
</section>
<section id="S14.SS1.SSS2" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">14.1.2. </span>Monotone flow multimodules and homotopies</h5>

<div id="S14.SS1.SSS2.p1" class="ltx_para ltx_noindent">
<p id="S14.SS1.SSS2.p1.1" class="ltx_p">Now we discuss the case of multimodules.</p>
</div>
<div id="S14.Thmthm4" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S14.Thmthm4.2" class="ltx_text ltx_font_bold">Definition 14.4</span></span><span id="S14.Thmthm4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S14.Thmthm4.p1" class="ltx_para ltx_noindent">
<p id="S14.Thmthm4.p1.1" class="ltx_p">Let <math id="S14.Thmthm4.p1.m1" class="ltx_Math" alttext="\mathbb{f}_{1},\ldots,\mathbb{f}_{m}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝕗</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝕗</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">\mathbb{f}_{1},\ldots,\mathbb{f}_{m}</annotation></semantics></math> resp. <math id="S14.Thmthm4.p1.m2" class="ltx_Math" alttext="{\mathbb{f}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝕗</mi><mo>′</mo></msup><annotation encoding="application/x-tex">{\mathbb{f}}^{\prime}</annotation></semantics></math> be monotone flow categories enriched in a regular stratification category <math id="S14.Thmthm4.p1.m3" class="ltx_Math" alttext="\underline{\smash{\bf C}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐂</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf C}}</annotation></semantics></math>. A <span id="S14.Thmthm4.p1.1.1" class="ltx_text ltx_font_bold">monotone flow multimodule</span> over <math id="S14.Thmthm4.p1.m4" class="ltx_Math" alttext="(\mathbb{f}_{1},\ldots,\mathbb{f}_{m};\mathbb{f}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝕗</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝕗</mi><mi>m</mi></msub><mo>,</mo><msup><mi>𝕗</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbb{f}_{1},\ldots,\mathbb{f}_{m};\mathbb{f}^{\prime})</annotation></semantics></math>, denoted by <math id="S14.Thmthm4.p1.m5" class="ltx_Math" alttext="{\mathbb{x}}" display="inline" intent=":literal"><semantics><mi>𝕩</mi><annotation encoding="application/x-tex">{\mathbb{x}}</annotation></semantics></math>, consists of a collection of objects <math id="S14.Thmthm4.p1.m6" class="ltx_Math" alttext="M_{d}^{\mathbb{x}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mi>d</mi><mi>𝕩</mi></msubsup><annotation encoding="application/x-tex">M_{d}^{\mathbb{x}}</annotation></semantics></math> of <math id="S14.Thmthm4.p1.m7" class="ltx_Math" alttext="\underline{\smash{\bf C}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐂</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf C}}</annotation></semantics></math> indexed by <math id="S14.Thmthm4.p1.m8" class="ltx_Math" alttext="d\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d\geq 0</annotation></semantics></math> (the underlying poset may not be <math id="S14.Thmthm4.p1.m9" class="ltx_Math" alttext="A_{d}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>d</mi></msub><annotation encoding="application/x-tex">A_{d}</annotation></semantics></math>), and for <math id="S14.Thmthm4.p1.m10" class="ltx_Math" alttext="d_{j},d,d^{\prime}\in{\mathbb{Z}}_{\geq 0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>j</mi></msub><mo>,</mo><mi>d</mi><mo>,</mo><mrow><msup><mi>d</mi><mo>′</mo></msup><mo>∈</mo><msub><mi>ℤ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">d_{j},d,d^{\prime}\in{\mathbb{Z}}_{\geq 0}</annotation></semantics></math> morphisms in <math id="S14.Thmthm4.p1.m11" class="ltx_Math" alttext="\underline{\smash{\bf C}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐂</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf C}}</annotation></semantics></math></p>
<table id="S14.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S14.Ex6.m1" class="ltx_Math" alttext="\iota_{d_{j};d}^{\mathbb{x}}:M_{d_{j}}^{{\mathbb{f}}_{j}}\times M_{d}^{\mathbb{x}}\to M_{d_{j}+d}^{\mathbb{x}}\ \ \ \ {\rm resp.}\ \ \ \ \iota_{d;d^{\prime}}^{\mathbb{x}}:M_{d}^{{\mathbb{x}}}\times M_{d^{\prime}}^{{\mathbb{f}}^{\prime}}\to M_{d+d^{\prime}}^{\mathbb{x}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mi>ι</mi><mrow><msub><mi>d</mi><mi>j</mi></msub><mo>;</mo><mi>d</mi></mrow><mi>𝕩</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mi>M</mi><msub><mi>d</mi><mi>j</mi></msub><msub><mi>𝕗</mi><mi>j</mi></msub></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>M</mi><mi>d</mi><mi>𝕩</mi></msubsup></mrow><mo stretchy="false">→</mo><msubsup><mi>M</mi><mrow><msub><mi>d</mi><mi>j</mi></msub><mo>+</mo><mi>d</mi></mrow><mi>𝕩</mi></msubsup></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mi>resp</mi></mrow><mo lspace="0em">.</mo><mspace style="width:2.167em;" width="2.167em"></mspace><mrow><msubsup><mi>ι</mi><mrow><mi>d</mi><mo>;</mo><msup><mi>d</mi><mo>′</mo></msup></mrow><mi>𝕩</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mi>M</mi><mi>d</mi><mi>𝕩</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>M</mi><msup><mi>d</mi><mo>′</mo></msup><msup><mi>𝕗</mi><mo>′</mo></msup></msubsup></mrow><mo stretchy="false">→</mo><msubsup><mi>M</mi><mrow><mi>d</mi><mo>+</mo><msup><mi>d</mi><mo>′</mo></msup></mrow><mi>𝕩</mi></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\iota_{d_{j};d}^{\mathbb{x}}:M_{d_{j}}^{{\mathbb{f}}_{j}}\times M_{d}^{\mathbb{x}}\to M_{d_{j}+d}^{\mathbb{x}}\ \ \ \ {\rm resp.}\ \ \ \ \iota_{d;d^{\prime}}^{\mathbb{x}}:M_{d}^{{\mathbb{x}}}\times M_{d^{\prime}}^{{\mathbb{f}}^{\prime}}\to M_{d+d^{\prime}}^{\mathbb{x}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S14.Thmthm4.p1.2" class="ltx_p">They need to satisfy the following conditions.</p>
</div>
<div id="S14.Thmthm4.p2" class="ltx_para">
<ol id="S14.I2" class="ltx_enumerate">
<li id="S14.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S14.I2.i1.p1" class="ltx_para ltx_noindent">
<p id="S14.I2.i1.p1.1" class="ltx_p">When <math id="S14.I2.i1.p1.m1" class="ltx_Math" alttext="d_{j}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>j</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d_{j}=0</annotation></semantics></math> resp. <math id="S14.I2.i1.p1.m2" class="ltx_Math" alttext="d^{\prime}=0" display="inline" intent=":literal"><semantics><mrow><msup><mi>d</mi><mo>′</mo></msup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d^{\prime}=0</annotation></semantics></math>, the morphism <math id="S14.I2.i1.p1.m3" class="ltx_Math" alttext="\iota_{d_{j};d}^{\mathbb{x}}" display="inline" intent=":literal"><semantics><msubsup><mi>ι</mi><mrow><msub><mi>d</mi><mi>j</mi></msub><mo>;</mo><mi>d</mi></mrow><mi>𝕩</mi></msubsup><annotation encoding="application/x-tex">\iota_{d_{j};d}^{\mathbb{x}}</annotation></semantics></math> resp. <math id="S14.I2.i1.p1.m4" class="ltx_Math" alttext="\iota_{d;d^{\prime}}^{\mathbb{x}}" display="inline" intent=":literal"><semantics><msubsup><mi>ι</mi><mrow><mi>d</mi><mo>;</mo><msup><mi>d</mi><mo>′</mo></msup></mrow><mi>𝕩</mi></msubsup><annotation encoding="application/x-tex">\iota_{d;d^{\prime}}^{\mathbb{x}}</annotation></semantics></math> are the canonical isomorphism.</p>
</div></li>
<li id="S14.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S14.I2.i2.p1" class="ltx_para ltx_noindent">
<p id="S14.I2.i2.p1.1" class="ltx_p">When <math id="S14.I2.i2.p1.m1" class="ltx_Math" alttext="d_{j}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>j</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d_{j}&gt;0</annotation></semantics></math> resp. <math id="S14.I2.i2.p1.m2" class="ltx_Math" alttext="d^{\prime}&gt;0" display="inline" intent=":literal"><semantics><mrow><msup><mi>d</mi><mo>′</mo></msup><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d^{\prime}&gt;0</annotation></semantics></math>, the morphism <math id="S14.I2.i2.p1.m3" class="ltx_Math" alttext="\iota_{d_{j};d}^{\mathbb{x}}" display="inline" intent=":literal"><semantics><msubsup><mi>ι</mi><mrow><msub><mi>d</mi><mi>j</mi></msub><mo>;</mo><mi>d</mi></mrow><mi>𝕩</mi></msubsup><annotation encoding="application/x-tex">\iota_{d_{j};d}^{\mathbb{x}}</annotation></semantics></math> resp. <math id="S14.I2.i2.p1.m4" class="ltx_Math" alttext="\iota_{d;d^{\prime}}^{\mathbb{x}}" display="inline" intent=":literal"><semantics><msubsup><mi>ι</mi><mrow><mi>d</mi><mo>;</mo><msup><mi>d</mi><mo>′</mo></msup></mrow><mi>𝕩</mi></msubsup><annotation encoding="application/x-tex">\iota_{d;d^{\prime}}^{\mathbb{x}}</annotation></semantics></math> has underlying poset map being homogeneous of degree <math id="S14.I2.i2.p1.m5" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>.</p>
</div></li>
<li id="S14.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S14.I2.i3.p1" class="ltx_para ltx_noindent">
<p id="S14.I2.i3.p1.1" class="ltx_p">For each <math id="S14.I2.i3.p1.m1" class="ltx_Math" alttext="d_{j},d,d^{\prime}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>j</mi></msub><mo>,</mo><mi>d</mi><mo>,</mo><mrow><msup><mi>d</mi><mo>′</mo></msup><mo>≥</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">d_{j},d,d^{\prime}\geq 0</annotation></semantics></math>, the following diagram commutes.</p>
<table id="S14.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S14.Ex7.m1.pic1" class="ltx_picture ltx_markedasmath" height="82.21" overflow="visible" style="vertical-align:-68.4772521541939px" version="1.1" viewBox="54.55 68.48 275.10 82.21" width="275.10"><g transform="matrix(1 0 0 -1 54.547394461794745 82.20980337947108) translate(0,3.46) translate(54.55,0)"><g transform="translate(-54.55,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:7.28em;--ltx-fo-height:0.94em;--ltx-fo-depth:0.35em;font-size:10pt;" height="17.85" overflow="visible" transform="matrix(1 0 0 -1 0 13.04)" width="100.79"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S14.Ex7.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{M_{d_{j}}^{{\mathbb{f}}_{j}}\times M_{d}^{\mathbb{x}}\times M_{d^{\prime}}^{{\mathbb{f}}^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>M</mi><msub><mi>d</mi><mi>j</mi></msub><msub><mi>𝕗</mi><mi>j</mi></msub></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>M</mi><mi>d</mi><mi>𝕩</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>M</mi><msup><mi>d</mi><mo>′</mo></msup><msup><mi>𝕗</mi><mo>′</mo></msup></msubsup></mrow><annotation encoding="application/x-tex">\textstyle{M_{d_{j}}^{{\mathbb{f}}_{j}}\times M_{d}^{\mathbb{x}}\times M_{d^{\prime}}^{{\mathbb{f}}^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 54.547394461794745 -0.27673578005007266 L 54.547394461794745 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(129.27,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="no