 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 358.3704282159675 -33.20877921850137 L 358.9238997760676 -12.746990114652519" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 358.3704282159675 -33.20877921850137 L 358.9238997760676 -33.20877921850137" fill="none" stroke="#000000"></path><g transform="translate(-62.02,0) translate(0,-46.94) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:8.36em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.41em;font-size:10pt;" height="17.32" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="115.74"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S7.Ex95.m1.pic1.m9" class="ltx_Math" alttext="\textstyle{M_{ap;aq}^{{\mathbb{F}}}\times M_{aq;\rho(a)p^{\prime}}^{\mathbb{B}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>M</mi><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>;</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow><mi>𝔽</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>M</mi><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>;</mo><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></mrow><mi>𝔹</mi></msubsup></mrow><annotation encoding="application/x-tex">\textstyle{M_{ap;aq}^{{\mathbb{F}}}\times M_{aq;\rho(a)p^{\prime}}^{\mathbb{B}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 62.01947165901308 -47.218066223828615 L 62.01947165901308 -46.664594663728465" fill="none" stroke="#000000"></path><g transform="translate(136.74,0) translate(0,-46.94)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 62.01947165901308 -47.218066223828615 L 136.73925129262446 -46.664594663728465" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 136.73925129262446 -47.218066223828615 L 136.73925129262446 -46.664594663728465" fill="none" stroke="#000000"></path><g transform="translate(136.74,0) translate(0,-46.94) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:4.36em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.41em;font-size:10pt;" height="17.32" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="60.3"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S7.Ex95.m1.pic1.m11" class="ltx_Math" alttext="\textstyle{M_{ap;\rho(a)p^{\prime}}^{\mathbb{B}}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>;</mo><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></mrow><mi>𝔹</mi></msubsup><annotation encoding="application/x-tex">\textstyle{M_{ap;\rho(a)p^{\prime}}^{\mathbb{B}}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(280.07,0) translate(0,-46.94) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:10.76em;--ltx-fo-height:0.94em;--ltx-fo-depth:0.41em;font-size:10pt;" height="18.72" overflow="visible" transform="matrix(1 0 0 -1 0 13.04)" width="148.87"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S7.Ex95.m1.pic1.m13" class="ltx_Math" alttext="\textstyle{M_{ap;\rho(a)q^{\prime}}^{{\mathbb{B}}}\times M_{\rho(a)q^{\prime}\rho(a)p^{\prime}}^{{\mathbb{F}}^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>M</mi><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>;</mo><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>′</mo></msup></mrow></mrow><mi>𝔹</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>M</mi><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><msup><mi>𝔽</mi><mo>′</mo></msup></msubsup></mrow><annotation encoding="application/x-tex">\textstyle{M_{ap;\rho(a)q^{\prime}}^{{\mathbb{B}}}\times M_{\rho(a)q^{\prime}\rho(a)p^{\prime}}^{{\mathbb{F}}^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 280.0621200567858 -47.218066223828615 L 280.0621200567858 -46.664594663728465" fill="none" stroke="#000000"></path><g transform="translate(205.34,0) translate(0,-46.94)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 6.92 -2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 6.92 2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 205.34231930958774 -47.218066223828615 L 280.0621200567858 -46.664594663728465" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 205.34231930958774 -47.218066223828615 L 205.34231930958774 -46.664594663728465" fill="none" stroke="#000000"></path></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S7.I11.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S7.I11.i3.p1" class="ltx_para ltx_noindent">
<p id="S7.I11.i3.p1.1" class="ltx_p">For every constant <math id="S7.I11.i3.p1.m1" class="ltx_Math" alttext="C&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C&gt;0</annotation></semantics></math>, the set</p>
<table id="S7.Ex96" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex96.m1" class="ltx_math_unparsed" alttext="\left\{(p,p^{\prime})\in{\rm Ob}{\mathbb{F}}\times{\rm Ob}{\mathbb{F}}^{\prime}\ \left|\ \begin{array}[]{c}M_{p;p^{\prime}}^{\mathbb{B}}\neq\emptyset,\\
{\mathcal{A}}_{1}(p)+\cdots+{\mathcal{A}}_{k}(p)-{\mathcal{A}}_{1}^{\prime}(p^{\prime})-\cdots-{\mathcal{A}}_{k^{\prime}}^{\prime}(p^{\prime})&lt;C\end{array}\right.\right\}" display="block" intent=":literal"><semantics><mrow><mo>{</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><msup><mi>p</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>Ob</mi><mi>𝔽</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>Ob</mi><msup><mi>𝔽</mi><mo>′</mo></msup><mo fence="false" rspace="0.667em">|</mo><mtable displaystyle="true" rowspacing="2.0pt"><mtr><mtd><mrow><mrow><msubsup><mi>M</mi><mrow><mi>p</mi><mo>;</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mi>𝔹</mi></msubsup><mo>≠</mo><mi mathvariant="normal">∅</mi></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mn>1</mn><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>p</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>−</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msup><mi>k</mi><mo>′</mo></msup><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>p</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&lt;</mo><mi>C</mi></mrow></mtd></mtr></mtable><mo>}</mo></mrow><annotation encoding="application/x-tex">\left\{(p,p^{\prime})\in{\rm Ob}{\mathbb{F}}\times{\rm Ob}{\mathbb{F}}^{\prime}\ \left|\ \begin{array}[]{c}M_{p;p^{\prime}}^{\mathbb{B}}\neq\emptyset,\\
{\mathcal{A}}_{1}(p)+\cdots+{\mathcal{A}}_{k}(p)-{\mathcal{A}}_{1}^{\prime}(p^{\prime})-\cdots-{\mathcal{A}}_{k^{\prime}}^{\prime}(p^{\prime})&lt;C\end{array}\right.\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.I11.i3.p1.2" class="ltx_p">consists of finitely many <math id="S7.I11.i3.p1.m2" class="ltx_Math" alttext="\mathbb{\Pi}\rtimes G" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mo lspace="0.222em" rspace="0.222em">⋊</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">\mathbb{\Pi}\rtimes G</annotation></semantics></math>-orbits.</p>
</div></li>
</ol>
</div>
</div>
<div id="S7.SS3.SSS4.p1" class="ltx_para ltx_noindent">
<p id="S7.SS3.SSS4.p1.1" class="ltx_p">The case of multimodules can be obtained from the case of weak bimodules.</p>
</div>
<div id="S7.Thmthm27" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm27.2" class="ltx_text ltx_font_bold">Definition 7.27</span></span><span id="S7.Thmthm27.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm27.p1" class="ltx_para ltx_noindent">
<p id="S7.Thmthm27.p1.1" class="ltx_p">Let <math id="S7.Thmthm27.p1.m1" class="ltx_Math" alttext="\mathbb{\Pi}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathbb{\Pi}_{i}</annotation></semantics></math>, <math id="S7.Thmthm27.p1.m2" class="ltx_Math" alttext="\mathbb{\Pi}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathbb{\Pi}^{\prime}</annotation></semantics></math> be Novikov groups. Let <math id="S7.Thmthm27.p1.m3" class="ltx_Math" alttext="{\mathbb{F}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝔽</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\mathbb{F}}_{i}</annotation></semantics></math> resp. <math id="S7.Thmthm27.p1.m4" class="ltx_Math" alttext="{\mathbb{F}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝔽</mi><mo>′</mo></msup><annotation encoding="application/x-tex">{\mathbb{F}}^{\prime}</annotation></semantics></math> be a <math id="S7.Thmthm27.p1.m5" class="ltx_Math" alttext="\mathbb{\Pi}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathbb{\Pi}_{i}</annotation></semantics></math>-equivariant resp. <math id="S7.Thmthm27.p1.m6" class="ltx_Math" alttext="\mathbb{\Pi}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathbb{\Pi}^{\prime}</annotation></semantics></math>-equivariant flow categories enriched in <math id="S7.Thmthm27.p1.m7" class="ltx_Math" alttext="\underline{\smash{\bf C}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐂</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf C}}</annotation></semantics></math>. Let</p>
<table id="S7.Ex97" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex97.m1" class="ltx_math_unparsed" alttext="\rho:\mathbb{\Pi}_{1}\times\cdots\times\mathbb{\Pi}_{m}\to\mathbb{\Pi}^{\prime}" display="block" intent=":literal"><semantics><mrow><mi>ρ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><msub><mrow></mrow><mi>m</mi></msub><mo stretchy="false">→</mo><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><msup><mrow></mrow><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">\rho:\mathbb{\Pi}_{1}\times\cdots\times\mathbb{\Pi}_{m}\to\mathbb{\Pi}^{\prime}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.Thmthm27.p1.2" class="ltx_p">be a morphism of Novikov groups. A <math id="S7.Thmthm27.p1.m8" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math><span id="S7.Thmthm27.p1.2.1" class="ltx_text ltx_font_bold">-equivariant multimodule</span> over <math id="S7.Thmthm27.p1.m9" class="ltx_Math" alttext="({\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m};{\mathbb{F}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo>,</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{1},\ldots,{\mathbb{F}}_{m};{\mathbb{F}}^{\prime})</annotation></semantics></math> is a multimodule <math id="S7.Thmthm27.p1.m10" class="ltx_Math" alttext="{\mathbb{X}}" display="inline" intent=":literal"><semantics><mi>𝕏</mi><annotation encoding="application/x-tex">{\mathbb{X}}</annotation></semantics></math>, which can also be viewed as a weak bimodule over <math id="S7.Thmthm27.p1.m11" class="ltx_math_unparsed" alttext="({\mathbb{F}}_{1}\times\cdots\times{\mathbb{F}}_{m};{\mathbb{F}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mn>1</mn></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><msub><mi>𝔽</mi><mi>m</mi></msub><mo>;</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}}_{1}\times\cdots\times{\mathbb{F}}_{m};{\mathbb{F}}^{\prime})</annotation></semantics></math>, together with <math id="S7.Thmthm27.p1.m12" class="ltx_Math" alttext="\underline{\smash{\bf C}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐂</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf C}}</annotation></semantics></math>-isomorphisms</p>
<table id="S7.Ex98" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex98.m1" class="ltx_math_unparsed" alttext="T_{a}^{\mathbb{X}}:M_{p_{1}\cdots p_{m};p^{\prime}}^{{\mathbb{X}}}\to M_{a_{1}p_{1}\cdots a_{m}p_{m};\rho(a_{1},\ldots,a_{m})p^{\prime}}^{\mathbb{X}}" display="block" intent=":literal"><semantics><mrow><mi>T</mi><msub><mrow></mrow><mi>a</mi></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mi>M</mi><msub><mrow></mrow><mrow><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup><mo stretchy="false">→</mo><mi>M</mi><msub><mrow></mrow><mrow><mi>a</mi><msub><mrow></mrow><mn>1</mn></msub><mi>p</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>a</mi><msub><mrow></mrow><mi>m</mi></msub><mi>p</mi><msub><mrow></mrow><mi>m</mi></msub><mo>;</mo><mi>ρ</mi><mo stretchy="false">(</mo><mi>a</mi><msub><mrow></mrow><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>a</mi><msub><mrow></mrow><mi>m</mi></msub><mo stretchy="false">)</mo><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>𝕏</mi></msup></mrow><annotation encoding="application/x-tex">T_{a}^{\mathbb{X}}:M_{p_{1}\cdots p_{m};p^{\prime}}^{{\mathbb{X}}}\to M_{a_{1}p_{1}\cdots a_{m}p_{m};\rho(a_{1},\ldots,a_{m})p^{\prime}}^{\mathbb{X}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.Thmthm27.p1.3" class="ltx_p">for all <math id="S7.Thmthm27.p1.m13" class="ltx_math_unparsed" alttext="a=(a_{1},\ldots,a_{m})\in\mathbb{\Pi}_{1}\times\cdots\times\mathbb{\Pi}_{m}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mn>1</mn></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><msub><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">a=(a_{1},\ldots,a_{m})\in\mathbb{\Pi}_{1}\times\cdots\times\mathbb{\Pi}_{m}</annotation></semantics></math> satisfying the conditions for an equivariant weak Novikov bimodules given in Definition <a href="#S7.Thmthm26" title="Definition 7.26. ‣ 7.3.4. Symmetries on multimodules and homotopies ‣ 7.3. Symmetries on flow categories, multimodules, and homotopies ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.26</span></a>.</p>
</div>
</div>
<div id="S7.Thmthm28" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm28.2" class="ltx_text ltx_font_italic">Remark 7.28</span></span><span id="S7.Thmthm28.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S7.Thmthm28.p1" class="ltx_para">
<p id="S7.Thmthm28.p1.1" class="ltx_p">The last condition of Definition <a href="#S7.Thmthm26" title="Definition 7.26. ‣ 7.3.4. Symmetries on multimodules and homotopies ‣ 7.3. Symmetries on flow categories, multimodules, and homotopies ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.26</span></a> implies that <math id="S7.Thmthm28.p1.m1" class="ltx_Math" alttext="{\mathbb{B}}" display="inline" intent=":literal"><semantics><mi>𝔹</mi><annotation encoding="application/x-tex">{\mathbb{B}}</annotation></semantics></math> is locally finite (see Definition <a href="#S7.Thmthm5" title="Definition 7.5. ‣ 7.1.2. Convergence ‣ 7.1. Unobstructedness, local finiteness, grading, and orientations ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.5</span></a>).</p>
</div>
</div>
<div id="S7.Thmthm29" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm29.2" class="ltx_text ltx_font_bold">Definition 7.29</span></span><span id="S7.Thmthm29.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm29.p1" class="ltx_para ltx_noindent">
<p id="S7.Thmthm29.p1.1" class="ltx_p">Let <math id="S7.Thmthm29.p1.m1" class="ltx_Math" alttext="{\mathbb{F}},{\mathbb{F}}^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>𝔽</mi><mo>,</mo><msup><mi>𝔽</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">{\mathbb{F}},{\mathbb{F}}^{\prime}</annotation></semantics></math>, and <math id="S7.Thmthm29.p1.m2" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> be as in Definition <a href="#S7.Thmthm26" title="Definition 7.26. ‣ 7.3.4. Symmetries on multimodules and homotopies ‣ 7.3. Symmetries on flow categories, multimodules, and homotopies ‣ 7. Algebraic Structures ‣ Part I FORMAL NOTIONS ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.26</span></a>. Let <math id="S7.Thmthm29.p1.m3" class="ltx_Math" alttext="{\mathbb{B}}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝔹</mi><mn>0</mn></msub><annotation encoding="application/x-tex">{\mathbb{B}}_{0}</annotation></semantics></math> and <math id="S7.Thmthm29.p1.m4" class="ltx_Math" alttext="{\mathbb{B}}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝔹</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\mathbb{B}}_{1}</annotation></semantics></math> be two <math id="S7.Thmthm29.p1.m5" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-equivariant bimodules over <math id="S7.Thmthm29.p1.m6" class="ltx_Math" alttext="({\mathbb{F}};{\mathbb{F}}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝔽</mi><mo>;</mo><msup><mi>𝔽</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathbb{F}};{\mathbb{F}}^{\prime})</annotation></semantics></math>.</p>
</div>
<div id="S7.Thmthm29.p2" class="ltx_para">
<ol id="S7.I12" class="ltx_enumerate">
<li id="S7.I12.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S7.I12.i1.p1" class="ltx_para ltx_noindent">
<p id="S7.I12.i1.p1.1" class="ltx_p">A <math id="S7.I12.i1.p1.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>-equivariant homotopy from <math id="S7.I12.i1.p1.m2" class="ltx_Math" alttext="{\mathbb{B}}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝔹</mi><mn>0</mn></msub><annotation encoding="application/x-tex">{\mathbb{B}}_{0}</annotation></semantics></math> to <math id="S7.I12.i1.p1.m3" class="ltx_Math" alttext="{\mathbb{B}}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝔹</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\mathbb{B}}_{1}</annotation></semantics></math> is a homotopy <math id="S7.I12.i1.p1.m4" class="ltx_Math" alttext="{\mathbb{H}}" display="inline" intent=":literal"><semantics><mi>ℍ</mi><annotation encoding="application/x-tex">{\mathbb{H}}</annotation></semantics></math> from <math id="S7.I12.i1.p1.m5" class="ltx_Math" alttext="{\mathbb{B}}_{0}" display="inline" intent=":literal"><semantics><msub><mi>𝔹</mi><mn>0</mn></msub><annotation encoding="application/x-tex">{\mathbb{B}}_{0}</annotation></semantics></math> to <math id="S7.I12.i1.p1.m6" class="ltx_Math" alttext="{\mathbb{B}}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝔹</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\mathbb{B}}_{1}</annotation></semantics></math> together with <math id="S7.I12.i1.p1.m7" class="ltx_Math" alttext="\underline{\smash{\bf C}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐂</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf C}}</annotation></semantics></math>-isomorphisms</p>
<table id="S7.Ex99" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex99.m1" class="ltx_Math" alttext="T_{a}^{\mathbb{H}}:M_{p;p^{\prime}}^{\mathbb{H}}\to M_{ap;\rho(a)p^{\prime}}^{\mathbb{H}}\ \forall a\in\mathbb{\Pi}\rtimes G" display="block" intent=":literal"><semantics><mrow><msubsup><mi>T</mi><mi>a</mi><mi>ℍ</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>M</mi><mrow><mi>p</mi><mo>;</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mi>ℍ</mi></msubsup><mo stretchy="false">→</mo><mrow><msubsup><mi>M</mi><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>;</mo><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></mrow><mi>ℍ</mi></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mo rspace="0.167em">∀</mo><mi>a</mi></mrow></mrow><mo>∈</mo><mrow><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Π</mi><mo lspace="0.222em" rspace="0.222em">⋊</mo><mi>G</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">T_{a}^{\mathbb{H}}:M_{p;p^{\prime}}^{\mathbb{H}}\to M_{ap;\rho(a)p^{\prime}}^{\mathbb{H}}\ \forall a\in\mathbb{\Pi}\rtimes G</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.I12.i1.p1.2" class="ltx_p">satisfying 1) <math id="S7.I12.i1.p1.m8" class="ltx_Math" alttext="T_{0}^{\mathbb{H}}" display="inline" intent=":literal"><semantics><msubsup><mi>T</mi><mn>0</mn><mi>ℍ</mi></msubsup><annotation encoding="application/x-tex">T_{0}^{\mathbb{H}}</annotation></semantics></math> is the identity, 2)</p>
<table id="S7.Ex100" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex100.m1" class="ltx_Math" alttext="T_{a+b}^{\mathbb{H}}=T_{a}^{\mathbb{H}}\circ T_{b}^{\mathbb{H}}," display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>T</mi><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mi>ℍ</mi></msubsup><mo>=</mo><mrow><msubsup><mi>T</mi><mi>a</mi><mi>ℍ</mi></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi>T</mi><mi>b</mi><mi>ℍ</mi></msubsup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">T_{a+b}^{\mathbb{H}}=T_{a}^{\mathbb{H}}\circ T_{b}^{\mathbb{H}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.I12.i1.p1.3" class="ltx_p">and 3) the following diagrams commute.</p>
<table id="S7.Ex101" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S7.Ex101.m1.pic1" class="ltx_picture ltx_markedasmath" height="71.16" overflow="visible" style="vertical-align:-58.82580943072636px" version="1.1" viewBox="66.82 58.83 276.95 71.16" width="276.95"><g transform="matrix(1 0 0 -1 66.81584513532154 71.15770643209709) translate(0,3.46) translate(66.82,0)"><g transform="translate(-40.42,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:5.24em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.37em;font-size:10pt;" height="16.78" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="72.54"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S7.Ex101.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{{\mathbb{M}}_{p;p^{\prime}}^{{\mathbb{B}}_{0}}\sqcup{\mathbb{M}}_{p;p^{\prime}}^{{\mathbb{B}}_{1}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝕄</mi><mrow><mi>p</mi><mo>;</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><msub><mi>𝔹</mi><mn>0</mn></msub></msubsup><mo>⊔</mo><msubsup><mi>𝕄</mi><mrow><mi>p</mi><mo>;</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><msub><mi>𝔹</mi><mn>1</mn></msub></msubsup></mrow><annotation encoding="application/x-tex">\textstyle{{\mathbb{M}}_{p;p^{\prime}}^{{\mathbb{B}}_{0}}\sqcup{\mathbb{M}}_{p;p^{\prime}}^{{\mathbb{B}}_{1}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 40.42272170549675 -0.27673578005007266 L 40.42272170549675 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(155.86,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#0