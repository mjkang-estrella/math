th style="--ltx-stroke-color:#000000;" d="M 41.25461813257792 -0.27673578005007266 L 151.20421172474963 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 151.20421172474963 -0.27673578005007266 L 151.20421172474963 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -12.746990114652519 L 0.27673578005007266 -12.746990114652519" fill="none" stroke="#000000"></path><g transform="translate(-47.16,0) translate(0,-23.68) translate(4.15,0) translate(0,-3.75)"><foreignObject style="--ltx-fo-width:2.81em;--ltx-fo-height:0.64em;--ltx-fo-depth:0.1em;font-size:10pt;" height="10.26" overflow="visible" transform="matrix(1 0 0 -1 0 8.88)" width="38.85"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S7.Ex102.m1.pic1.m2" class="ltx_Math" alttext="\scriptstyle{T_{a}^{\mathbb{F}}\times T_{a}^{\mathbb{H}}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathsize="0.700em">T</mi><mi mathsize="0.710em">a</mi><mi mathsize="0.710em">𝔽</mi></msubsup><mo lspace="0.222em" mathsize="0.700em" rspace="0.222em">×</mo><msubsup><mi mathsize="0.700em">T</mi><mi mathsize="0.710em">a</mi><mi mathsize="0.710em">ℍ</mi></msubsup></mrow><annotation encoding="application/x-tex">\scriptstyle{T_{a}^{\mathbb{F}}\times T_{a}^{\mathbb{H}}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(0,-34.61)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -34.60943344240781 L 0.27673578005007266 -12.746990114652519" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -34.60943344240781 L 0.27673578005007266 -34.60943344240781" fill="none" stroke="#000000"></path><g transform="translate(151.21,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:2.45em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.37em;font-size:10pt;" height="16.78" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="33.91"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S7.Ex102.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{M_{p;p^{\prime}}^{\mathbb{H}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mrow><mi>p</mi><mo>;</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mi>ℍ</mi></msubsup><annotation encoding="application/x-tex">\textstyle{M_{p;p^{\prime}}^{\mathbb{H}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 172.0324482382688 -12.746990114652519 L 172.58591979836896 -12.746990114652519" fill="none" stroke="#000000"></path><g transform="translate(172.31,0) translate(0,-23.47) translate(4.15,0) translate(0,-3.75)"><foreignObject style="--ltx-fo-width:1.12em;--ltx-fo-height:0.64em;--ltx-fo-depth:0.1em;font-size:10pt;" height="10.26" overflow="visible" transform="matrix(1 0 0 -1 0 8.88)" width="15.5"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S7.Ex102.m1.pic1.m5" class="ltx_Math" alttext="\scriptstyle{T_{a}^{\mathbb{H}}}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.700em">T</mi><mi mathsize="0.710em">a</mi><mi mathsize="0.710em">ℍ</mi></msubsup><annotation encoding="application/x-tex">\scriptstyle{T_{a}^{\mathbb{H}}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(172.31,0) translate(0,-34.61)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"