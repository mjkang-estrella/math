path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.208800332088 L 0.27673578005007266 -33.208800332088" fill="none" stroke="#000000"></path><g transform="translate(46.78,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.8em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="11.11"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S21.Ex2.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{Y\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">\textstyle{Y\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 56.20510660300565 -7.610350076103501 L 56.7585781631058 -7.610350076103501" fill="none" stroke="#000000"></path><g transform="translate(56.48,0) translate(0,-21.68) translate(4.15,0) translate(0,-2.67)"><foreignObject style="--ltx-fo-width:1.33em;--ltx-fo-height:0.49em;--ltx-fo-depth:0.1em;font-size:10pt;" height="8.12" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="18.43"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S21.Ex2.m1.pic1.m5" class="ltx_Math" alttext="\scriptstyle{{\rm Id}_{Y}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">Id</mi><mi mathsize="0.710em">Y</mi></msub><annotation encoding="application/x-tex">\scriptstyle{{\rm Id}_{Y}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(56.48,0) translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 56.20510660300565 -33.208800332088 L 56.7585781631058 -7.610350076103501" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 56.20510660300565 -33.208800332088 L 56.7585781631058 -33.208800332088" fill="none" stroke="#000000"></path><g transform="translate(-13.57,0) translate(0,-43.36) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.36em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="18.83"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S21.Ex2.m1.pic1.m6" class="ltx_Math" alttext="\textstyle{N_{2}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\textstyle{N_{2}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 13.567949703855767 -43.63264139549389 L 13.567949703855767 -43.07916983539375" fill="none" stroke="#000000"></path><g transform="translate(13.01,0) translate(0,-52.24) translate(4.15,0) translate(0,-2)"><foreignObject style="--ltx-fo-width:1.6em;--ltx-fo-height:0.49em;--ltx-fo-depth:0.2em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="22.16"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S21.Ex2.m1.pic1.m7" class="ltx_Math" alttext="\scriptstyle{f_{2,\pm}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">f</mi><mrow><mn mathsize="0.710em">2</mn><mo mathsize="0.710em" rspace="0em">,</mo><mo lspace="0em" mathsize="0.710em">±</mo></mrow></msub><annotation encoding="application/x-tex">\scriptstyle{f_{2,\pm}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(46.78,0) translate(0,-43.36)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 13.567949703855767 -43.63264139549389 L 46.77672892235713 -43.07916983539375" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 46.77672892235713 -43.63264139549389 L 46.77672892235713 -43.07916983539375" fill="none" stroke="#000000"></path><g transform="translate(46.78,0) translate(0,-43.36) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.8em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="11.11"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S21.Ex2.m1.pic1.m8" class="ltx_Math" alttext="\textstyle{Y}" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">\textstyle{Y}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.I1.i1.p1.2" class="ltx_p">The (non-symmetric) product of <math id="S21.I1.i1.p1.m9" class="ltx_Math" alttext="(N_{1},f_{1,\pm})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>N</mi><mn>1</mn></msub><mo>,</mo><msub><mi>f</mi><mrow><mn>1</mn><mo rspace="0em">,</mo><mo lspace="0em">±</mo></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(N_{1},f_{1,\pm})</annotation></semantics></math> and <math id="S21.I1.i1.p1.m10" class="ltx_Math" alttext="(N_{2},f_{2,\pm})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>N</mi><mn>2</mn></msub><mo>,</mo><msub><mi>f</mi><mrow><mn>2</mn><mo rspace="0em">,</mo><mo lspace="0em">±</mo></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(N_{2},f_{2,\pm})</annotation></semantics></math> is the fiber product</p>
<table id="S21.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex3.m1" class="ltx_Math" alttext="\left(N_{1}\underset{Y}{\times}N_{2},\ \pi_{1}^{*}f_{1,-},\ \pi_{2}^{*}f_{2,+}\right):=\left(N_{1}\ {}_{f_{1,+}}\underset{Y}{\times}{}_{f_{2,-}}N_{2},\ \pi_{1}^{*}f_{1,-},\ \pi_{2}^{*}f_{2,+}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>(</mo><mrow><msub><mi>N</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0em">​</mo><munder accentunder="true"><mo>×</mo><mo mathsize="0.700em">𝑌</mo></munder><mo lspace="0.222em" rspace="0em">​</mo><msub><mi>N</mi><mn>2</mn></msub></mrow><mo>,</mo><mrow><msubsup><mi>π</mi><mn>1</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mrow><mn>1</mn><mo rspace="0em">,</mo><mo lspace="0em">−</mo></mrow></msub></mrow><mo>,</mo><mrow><msubsup><mi>π</mi><mn>2</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mrow><mn>2</mn><mo rspace="0em">,</mo><mo lspace="0em">+</mo></mrow></msub></mrow><mo>)</mo></mrow><mo>:=</mo><mrow><mo>(</mo><mrow><msub><mi>N</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0em">​</mo><mmultiscripts><munder accentunder="true"><mo>×</mo><mo mathsize="0.700em">𝑌</mo></munder><mprescripts></mprescripts><msub><mi>f</mi><mrow><mn>1</mn><mo rspace="0em">,</mo><mo lspace="0em">+</mo></mrow></msub><mrow></mrow></mmultiscripts><mo lspace="0.222em" rspace="0em">​</mo><mmultiscripts><mi>N</mi><mprescripts></mprescripts><mn>2</mn><mrow></mrow><msub><mi>f</mi><mrow><mn>2</mn><mo rspace="0em">,</mo><mo lspace="0em">−</mo></mrow></msub><mrow></mrow></mmultiscripts></mrow><mo>,</mo><mrow><msubsup><mi>π</mi><mn>1</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mrow><mn>1</mn><mo rspace="0em">,</mo><mo lspace="0em">−</mo></mrow></msub></mrow><mo>,</mo><mrow><msubsup><mi>π</mi><mn>2</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mrow><mn>2</mn><mo rspace="0em">,</mo><mo lspace="0em">+</mo></mrow></msub></mrow><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left(N_{1}\underset{Y}{\times}N_{2},\ \pi_{1}^{*}f_{1,-},\ \pi_{2}^{*}f_{2,+}\right):=\left(N_{1}\ {}_{f_{1,+}}\underset{Y}{\times}{}_{f_{2,-}}N_{2},\ \pi_{1}^{*}f_{1,-},\ \pi_{2}^{*}f_{2,+}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.I1.i1.p1.3" class="ltx_p">The monoidal unit is <math id="S21.I1.i1.p1.m11" class="ltx_Math" alttext="(Y,{\rm Id}_{Y},{\rm Id}_{Y})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo>,</mo><msub><mi>Id</mi><mi>Y</mi></msub><mo>,</mo><msub><mi>Id</mi><mi>Y</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(Y,{\rm Id}_{Y},{\rm Id}_{Y})</annotation></semantics></math>.</p>
</div></li>
<li id="S21.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S21.I1.i2.p1" class="ltx_para ltx_noindent">
<p id="S21.I1.i2.p1.1" class="ltx_p">Let <math id="S21.I1.i2.p1.m1" class="ltx_Math" alttext="\underline{\smash{\bf Kur}}(Y)" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>𝐊𝐮𝐫</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐘</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\underline{\smash{\bf Kur}}(Y)</annotation></semantics></math> be the regular stratification category whose objects are <math id="S21.I1.i2.p1.m2" class="ltx_Math" alttext="(K,f_{-},f_{+})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>K</mi><mo>,</mo><msub><mi>f</mi><mo>−</mo></msub><mo>,</mo><msub><mi>f</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(K,f_{-},f_{+})</annotation></semantics></math> where <math id="S21.I1.i2.p1.m3" class="ltx_Math" alttext="K=(G,V,E,S)" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo>,</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K=(G,V,E,S)</annotation></semantics></math> is a Kuranishi space and <math id="S21.I1.i2.p1.m4" class="ltx_Math" alttext="f_{\pm}:V\to Y" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mo>±</mo></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>V</mi><mo stretchy="false">→</mo><mi>Y</mi></mrow></mrow><annotation encoding="application/x-tex">f_{\pm}:V\to Y</annotation></semantics></math> is a pair of <math id="S21.I1.i2.p1.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant topological submersions. Let <math id="S21.I1.i2.p1.m6" class="ltx_Math" alttext="\underline{\smash{\bf SKur}}(Y)" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>𝐒𝐊𝐮𝐫</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐘</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\underline{\smash{\bf SKur}}(Y)</annotation></semantics></math> be the corresponding category of smooth Kuranishi spaces together with smooth submersions to <math id="S21.I1.i2.p1.m7" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>. Let <math id="S21.I1.i2.p1.m8" class="ltx_Math" alttext="\underline{\smash{\bf SKur}}^{\rm NC}(Y)" display="inline" intent=":literal"><semantics><mrow><msup><munder accentunder="true"><mi>𝐒𝐊𝐮𝐫</mi><mo stretchy="true">¯</mo></munder><mi>NC</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐘</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\underline{\smash{\bf SKur}}^{\rm NC}(Y)</annotation></semantics></math> be the subcategory whose objects are smooth normally complex Kuranishi spaces with <math id="S21.I1.i2.p1.m9" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant submersions. Let <math id="S21.I1.i2.p1.m10" class="ltx_Math" alttext="\underline{\smash{\bf S^{\rm rel}Kur}}(Y)" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mrow><msup><mi>𝐒</mi><mi>rel</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐊𝐮𝐫</mi></mrow><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐘</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\underline{\smash{\bf S^{\rm rel}Kur}}(Y)</annotation></semantics></math> be the category of relatively smooth Kuranishi spaces <math id="S21.I1.i2.p1.m11" class="ltx_Math" alttext="K/B=(G,V/B,E,S)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>K</mi><mo>/</mo><mi>B</mi></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mrow><mi>V</mi><mo>/</mo><mi>B</mi></mrow><mo>,</mo><mi>E</mi><mo>,</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K/B=(G,V/B,E,S)</annotation></semantics></math> together with <math id="S21.I1.i2.p1.m12" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant maps <math id="S21.I1.i2.p1.m13" class="ltx_Math" alttext="f_{\pm}:V\to Y" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mo>±</mo></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>V</mi><mo stretchy="false">→</mo><mi>Y</mi></mrow></mrow><annotation encoding="application/x-tex">f_{\pm}:V\to Y</annotation></semantics></math> such that they are fiberwise submersions. Let <math id="S21.I1.i2.p1.m14" class="ltx_Math" alttext="\underline{\smash{\bf S^{\rm rel}Kur}}^{\rm NC}(Y)" display="inline" intent=":literal"><semantics><mrow><msup><munder accentunder="true"><mrow><msup><mi>𝐒</mi><mi>rel</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐊𝐮𝐫</mi></mrow><mo stretchy="true">¯</mo></munder><mi>NC</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐘</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\underline{\smash{\bf S^{\rm rel}Kur}}^{\rm NC}(Y)</annotation></semantics></math> be the subcategory where the relative Kuranishi spaces are equipped with relative NC structures.</p>
</div></li>
<li id="S21.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S21.I1.i3.p1" class="ltx_para ltx_noindent">
<p id="S21.I1.i3.p1.1" class="ltx_p">Let <math id="S21.I1.i3.p1.m1" class="ltx_Math" alttext="\underline{\smash{\bf dOrb}}(Y)" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐘</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\underline{\smash{\bf dOrb}}(Y)</annotation></semantics></math> be the category whose objects are pairs <math id="S21.I1.i3.p1.m2" class="ltx_Math" alttext="({\mathcal{D}},f_{-},f_{+})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>,</mo><msub><mi>f</mi><mo>−</mo></msub><mo>,</mo><msub><mi>f</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathcal{D}},f_{-},f_{+})</annotation></semantics></math> where <math id="S21.I1.i3.p1.m3" class="ltx_Math" alttext="{\mathcal{D}}=({\mathcal{U}},{\mathcal{E}},{\mathcal{S}})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{D}}=({\mathcal{U}},{\mathcal{E}},{\mathcal{S}})</annotation></semantics></math> is a derived orbifold and <math id="S21.I1.i3.p1.m4" class="ltx_Math" alttext="f_{\pm}:{\mathcal{U}}\to Y" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mo>±</mo></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo stretchy="false">→</mo><mi>Y</mi></mrow></mrow><annotation encoding="application/x-tex">f_{\pm}:{\mathcal{U}}\to Y</annotation></semantics></math> are smooth submersions. Let <math id="S21.I1.i3.p1.m5" class="ltx_Math" alttext="\underline{\smash{\bf dOrb}}^{\rm NC}(Y)" display="inline" intent=":literal"><semantics><mrow><msup><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><mi>NC</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐘</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\underline{\smash{\bf dOrb}}^{\rm NC}(Y)</annotation></semantics></math> be the category whose objects are <math id="S21.I1.i3.p1.m6" class="ltx_Math" alttext="({\mathcal{D}},f_{-},f_{+})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>,</mo><msub><mi>f</mi><mo>−</mo></msub><mo>,</mo><msub><mi>f</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathcal{D}},f_{-},f_{+})</annotation></semantics></math> where <math id="S21.I1.i3.p1.m7" class="ltx_Math" alttext="{\mathcal{D}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">{\mathcal{D}}</annotation></semantics></math> is an NC derived orbifold and <math id="S21.I1.i3.p1.m8" class="ltx_Math" alttext="f_{\pm}:{\mathcal{U}}\to Y" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mo>±</mo></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo stretchy="false">→</mo><mi>Y</mi></mrow></mrow><annotation encoding="application/x-tex">f_{\pm}:{\mathcal{U}}\to Y</annotation></semantics></math> are smooth submersions.</p>
</div></li>
</ol>
</div>
</div>
<div id="S21.Thmthm2" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S21.Thmthm2.2" class="ltx_text ltx_font_italic">Remark 21.2</span></span><span id="S21.Thmthm2.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S21.Thmthm2.p1" class="ltx_para">
<p id="S21.Thmthm2.p1.1" class="ltx_p">Unlike the presumed stable complex versions, the monoidal structure given by fiber products in the NC versions (<math id="S21.Thmthm2.p1.m1" class="ltx_Math" alttext="\underline{\smash{\bf SKur}}^{\rm NC}(Y)" display="inline" intent=":literal"><semantics><mrow><msup><munder accentunder="true"><mi>𝐒𝐊𝐮𝐫</mi><mo stretchy="true">¯</mo></munder><mi>NC</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐘</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\underline{\smash{\bf SKur}}^{\rm NC}(Y)</annotation></semantics></math>, <math id="S21.Thmthm2.p1.m2" class="ltx_Math" alttext="\underline{\smash{\bf S^{\rm rel}Kur}}^{\rm NC}(Y)" display="inline" intent=":literal"><semantics><mrow><msup><munder accentunder="true"><mrow><msup><mi>𝐒</mi><mi>rel</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐊𝐮𝐫</mi></mrow><mo stretchy="true">¯</mo></munder><mi>NC</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐘</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\underline{\smash{\bf S^{\rm rel}Kur}}^{\rm NC}(Y)</annotation></semantics></math>, <math id="S21.Thmthm2.p1.m3" class="ltx_Math" alttext="\underline{\smash{\bf dOrb}}^{\rm NC}(Y)" display="inline" intent=":literal"><semantics><mrow><msup><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><mi>NC</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐘</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\underline{\smash{\bf dOrb}}^{\rm NC}(Y)</annotation></semantics></math>) does not require the almost complex structure on <math id="S21.Thmthm2.p1.m4" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> because <math id="S21.Thmthm2.p1.m5" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> is assumed to be a manifold.</p>
</div>
</div>
<div id="S21.SS1.SSS1.p1" class="ltx_para ltx_noindent">
<p id="S21.SS1.SSS1.p1.1" class="ltx_p">Notice that one can also talk about collared and rigidified versions of <math id="S21.SS1.SSS1.p1.m1" class="ltx_Math" alttext="\underline{\smash{\bf Kur}}(Y),\underline{\smash{\bf SKur}}(Y)" display="inline" intent=":literal"><semantics><mrow><mrow><munder accentunder="true"><mi>𝐊𝐮𝐫</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐘</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><munder accentunder="true"><mi>𝐒𝐊𝐮𝐫</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐘</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\underline{\smash{\bf Kur}}(Y),\underline{\smash{\bf SKur}}(Y)</annotation></semantics></math>, and <math id="S21.SS1.SSS1.p1.m2" class="ltx_Math" alttext="\underline{\smash{\bf dOrb}}(Y)" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐘</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\underline{\smash{\bf dOrb}}(Y)</annotation></semantics></math>.</p>
</div>
<div id="S21.SS1.SSS1.p2" class="ltx_para ltx_noindent">
<p id="S21.SS1.SSS1.p2.1" class="ltx_p">One needs to generalize the discussion of stable smoothings of topological Kuranishi spaces to the category <math id="S21.SS1.SSS1.p2.m1" class="ltx_Math" alttext="\underline{\smash{\bf Kur}}(Y)" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>𝐊𝐮𝐫</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐘</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\underline{\smash{\bf Kur}}(Y)</annotation></semantics></math>.</p>
</div>
<div id="S21.Thmthm3" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S21.Thmthm3.2" class="ltx_text ltx_font_bold">Definition 21.3</span></span><span id="S21.Thmthm3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S21.Thmthm3.p1" class="ltx_para">
<p id="S21.Thmthm3.p1.1" class="ltx_p">A <span id="S21.Thmthm3.p1.1.1" class="ltx_text ltx_font_bold">stable smoothing</span> of an object <math id="S21.Thmthm3.p1.m1" class="ltx_Math" alttext="(K,f_{\pm})\in\underline{\smash{\bf Kur}}(Y)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>K</mi><mo>,</mo><msub><mi>f</mi><mo>±</mo></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><munder accentunder="true"><mi>𝐊𝐮𝐫</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐘</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(K,f_{\pm})\in\underline{\smash{\bf Kur}}(Y)</annotation></semantics></math> where <math id="S21.Thmthm3.p1.m2" class="ltx_Math" alttext="K=(G,V,E,S)" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo>,</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K=(G,V,E,S)</annotation></semantics></math> consists of a unitary representation <math id="S21.Thmthm3.p1.m3" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> of <math id="S21.Thmthm3.p1.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>, a <math id="S21.Thmthm3.p1.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-smoothing on <math id="S21.Thmthm3.p1.m6" class="ltx_Math" alttext="V\times W" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>W</mi></mrow><annotation encoding="application/x-tex">V\times W</annotation></semantics></math>, a <math id="S21.Thmthm3.p1.m7" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant extension <math id="S21.Thmthm3.p1.m8" class="ltx_Math" alttext="\tilde{f}_{\pm}:V\times W\to Y" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>±</mo></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>W</mi></mrow><mo stretchy="false">→</mo><mi>Y</mi></mrow></mrow><annotation encoding="application/x-tex">\tilde{f}_{\pm}:V\times W\to Y</annotation></semantics></math> of <math id="S21.Thmthm3.p1.m9" class="ltx_Math" alttext="f_{\pm}:V\cong V\times\{0\}\to Y" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mo>±</mo></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>V</mi><mo>≅</mo><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">→</mo><mi>Y</mi></mrow></mrow><annotation encoding="application/x-tex">f_{\pm}:V\cong V\times\{0\}\to Y</annotation></semantics></math> such that <math id="S21.Thmthm3.p1.m10" class="ltx_Math" alttext="\tilde{f}_{\pm}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>±</mo></msub><annotation encoding="application/x-tex">\tilde{f}_{\pm}</annotation></semantics></math> are smooth submersions.</p>
</div>
</div>
<div id="S21.Thmthm4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S21.Thmthm4.2" class="ltx_text ltx_font_bold">Lemma 21.4</span></span><span id="S21.Thmthm4.3" class="ltx_text ltx_font_bold"> </span>(Stable smoothing with maps)<span id="S21.Thmthm4.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S21.Thmthm4.p1" class="ltx_para">
<p id="S21.Thmthm4.p1.1" class="ltx_p"><span id="S21.Thmthm4.p1.1.1" class="ltx_text ltx_font_italic">(cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib61" title="" class="ltx_ref">3</a>, Lemma 4.5]</cite>) 
Let <math id="S21.Thmthm4.p1.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> be a smooth <math id="S21.Thmthm4.p1.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-manifold and <math id="S21.Thmthm4.p1.m3" class="ltx_Math" alttext="f_{0}:V\to Y" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>0</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>V</mi><mo stretchy="false">→</mo><mi>Y</mi></mrow></mrow><annotation encoding="application/x-tex">f_{0}:V\to Y</annotation></semantics></math> be a continuous <math id="S21.Thmthm4.p1.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant map. Then there exists a unitary representation <math id="S21.Thmthm4.p1.m5" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> of <math id="S21.Thmthm4.p1.m6" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>, a <math id="S21.Thmthm4.p1.m7" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-smoothing on <math id="S21.Thmthm4.p1.m8" class="ltx_Math" alttext="V\times W" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>W</mi></mrow><annotation encoding="application/x-tex">V\times W</annotation></semantics></math> which is in the same stable isotopy class of the given smooth structure on <math id="S21.Thmthm4.p1.m9" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math>, and a smooth submersion <math id="S21.Thmthm4.p1.m10" class="ltx_Math" alttext="\tilde{f}:V\times W\to Y" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>W</mi></mrow><mo stretchy="false">→</mo><mi>Y</mi></mrow></mrow><annotation encoding="application/x-tex">\tilde{f}:V\times W\to Y</annotation></semantics></math> whose restriction to <math id="S21.Thmthm4.p1.m11" class="ltx_Math" alttext="V\times\{0\}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">V\times\{0\}</annotation></semantics></math> coincides with <math id="S21.Thmthm4.p1.m12" class="ltx_Math" alttext="f_{0}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>0</mn></msub><annotation encoding="application/x-tex">f_{0}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S21.SS1.SSS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S21.SS1.SSS1.p3" class="ltx_para ltx_noindent">
<p id="S21.SS1.SSS1.p3.1" class="ltx_p"><span id="S21.SS1.SSS1.p3.1.1" class="ltx_text">The proof is essentially that of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib61" title="" class="ltx_ref">3</a>, Lemma 4.5]</cite>, which we reproduce using our language. Choose a Riemannian metric on <math id="S21.SS1.SSS1.p3.m1" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>. Then one can choose a smooth <math id="S21.SS1.SSS1.p3.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant approximation <math id="S21.SS1.SSS1.p3.m3" class="ltx_Math" alttext="f:V\to Y" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>V</mi><mo stretchy="false">→</mo><mi>Y</mi></mrow></mrow><annotation encoding="application/x-tex">f:V\to Y</annotation></semantics></math> and a smooth <math id="S21.SS1.SSS1.p3.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant function <math id="S21.SS1.SSS1.p3.m5" class="ltx_Math" alttext="\epsilon:V\to{\mathbb{R}}_{+}" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>V</mi><mo stretchy="false">→</mo><msub><mi>ℝ</mi><mo>+</mo></msub></mrow></mrow><annotation encoding="application/x-tex">\epsilon:V\to{\mathbb{R}}_{+}</annotation></semantics></math> such that for all <math id="S21.SS1.SSS1.p3.m6" class="ltx_Math" alttext="v\in V" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">v\in V</annotation></semantics></math>, there is a unique shortest geodesic of length shorter than <math id="S21.SS1.SSS1.p3.m7" class="ltx_Math" alttext="\epsilon(v)" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\epsilon(v)</annotation></semantics></math> connecting <math id="S21.SS1.SSS1.p3.m8" class="ltx_Math" alttext="f_{0}(v)" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f_{0}(v)</annotation></semantics></math> and <math id="S21.SS1.SSS1.p3.m9" class="ltx_Math" alttext="f(v)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(v)</annotation></semantics></math>, and such that the exponential map <math id="S21.SS1.SSS1.p3.m10" class="ltx_Math" alttext="\exp_{f(v)}\xi" display="inline" intent=":literal"><semantics><mrow><msub><mi>exp</mi><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0.167em">⁡</mo><mi>ξ</mi></mrow><annotation encoding="application/x-tex">\exp_{f(v)}\xi</annotation></semantics></math> is well-defined for <math id="S21.SS1.SSS1.p3.m11" class="ltx_Math" alttext="\xi" display="inline" intent=":literal"><semantics><mi>ξ</mi><annotation encoding="application/x-tex">\xi</annotation></semantics></math> in the <math id="S21.SS1.SSS1.p3.m12" class="ltx_Math" alttext="\epsilon(v)" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\epsilon(v)</annotation></semantics></math>-ball of <math id="S21.SS1.SSS1.p3.m13" class="ltx_Math" alttext="T_{f(v)}Y" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>Y</mi></mrow><annotation encoding="application/x-tex">T_{f(v)}Y</annotation></semantics></math>. Then there is a smooth equivariant bundle map <math id="S21.SS1.SSS1.p3.m14" class="ltx_Math" alttext="\rho:f^{*}TY\to f^{*}TY" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>Y</mi></mrow><mo stretchy="false">→</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>Y</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho:f^{*}TY\to f^{*}TY</annotation></semantics></math> compressing <math id="S21.SS1.SSS1.p3.m15" class="ltx_Math" alttext="f^{*}TY" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>Y</mi></mrow><annotation encoding="application/x-tex">f^{*}TY</annotation></semantics></math> diffeomorphically into the <math id="S21.SS1.SSS1.p3.m16" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>-disk bundle. Therefore the map</span></p>
<table id="S21.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex4.m1" class="ltx_Math" alttext="\tilde{f}:f^{*}TY\to Y,\ \tilde{f}(v,\xi)=\exp_{f(v)}(\rho(\xi))." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>Y</mi></mrow><mo stretchy="false">→</mo><mi>Y</mi></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>ξ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>exp</mi><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ξ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tilde{f}:f^{*}TY\to Y,\ \tilde{f}(v,\xi)=\exp_{f(v)}(\rho(\xi)).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.SS1.SSS1.p3.2" class="ltx_p"><span id="S21.SS1.SSS1.p3.2.1" class="ltx_text">is a smooth submersion. Choose another smooth (real) <math id="S21.SS1.SSS1.p3.m17" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-vector bundle <math id="S21.SS1.SSS1.p3.m18" class="ltx_Math" alttext="E\to V" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo stretchy="false">→</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">E\to V</annotation></semantics></math> such that</span></p>
<table id="S21.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex5.m1" class="ltx_Math" alttext="E\oplus f^{*}TY\cong V\times W" display="block" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo>⊕</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>Y</mi></mrow></mrow><mo>≅</mo><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>W</mi></mrow></mrow><annotation encoding="application/x-tex">E\oplus f^{*}TY\cong V\times W</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.SS1.SSS1.p3.3" class="ltx_p"><span id="S21.SS1.SSS1.p3.3.1" class="ltx_text">for some unitary representation <math id="S21.SS1.SSS1.p3.m19" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> of <math id="S21.SS1.SSS1.p3.m20" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>. <math id="S21.SS1.SSS1.p3.m21" class="ltx_Math" alttext="\tilde{f}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>f</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{f}</annotation></semantics></math> clearly extends to a smooth <math id="S21.SS1.SSS1.p3.m22" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant map from <math id="S21.SS1.SSS1.p3.m23" class="ltx_Math" alttext="V\times W" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>W</mi></mrow><annotation encoding="application/x-tex">V\times W</annotation></semantics></math> to <math id="S21.SS1.SSS1.p3.m24" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>, which is still a smooth submersion.</span></p>
</div>
<div id="S21.SS1.SSS1.p4" class="ltx_para ltx_noindent">
<p id="S21.SS1.SSS1.p4.1" class="ltx_p"><span id="S21.SS1.SSS1.p4.1.1" class="ltx_text">We would like to define a self-homeomorphism of <math id="S21.SS1.SSS1.p4.m1" class="ltx_Math" alttext="V\times W" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>W</mi></mrow><annotation encoding="application/x-tex">V\times W</annotation></semantics></math> to pullback the smooth structure on <math id="S21.SS1.SSS1.p4.m2" class="ltx_Math" alttext="V\times W" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>W</mi></mrow><annotation encoding="application/x-tex">V\times W</annotation></semantics></math>. Indeed, we can write</span></p>
<table id="S21.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex6.m1" class="ltx_Math" alttext="f_{0}(v)=\exp_{f(v)}\xi_{0}(v),\ \xi_{0}(v)\in T_{f(v)}Y." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>f</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>exp</mi><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0.167em">⁡</mo><msub><mi>ξ</mi><mn>0</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mrow><msub><mi>ξ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><msub><mi>T</mi><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>Y</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f_{0}(v)=\exp_{f(v)}\xi_{0}(v),\ \xi_{0}(v)\in T_{f(v)}Y.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.SS1.SSS1.p4.2" class="ltx_p"><span id="S21.SS1.SSS1.p4.2.1" class="ltx_text">Define a nonlinear bundle map</span></p>
<table id="S21.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex7.m1" class="ltx_Math" alttext="F:f^{*}TY\to f^{*}TY,\ (v,\xi)\mapsto(v,\xi+\xi_{0}(v))." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>Y</mi></mrow><mo stretchy="false">→</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>Y</mi></mrow></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>ξ</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">↦</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mrow><mi>ξ</mi><mo>+</mo><mrow><msub><mi>ξ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">F:f^{*}TY\to f^{*}TY,\ (v,\xi)\mapsto(v,\xi+\xi_{0}(v)).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.SS1.SSS1.p4.3" class="ltx_p"><span id="S21.SS1.SSS1.p4.3.1" class="ltx_text">Extend it to a smooth map <math id="S21.SS1.SSS1.p4.m3" class="ltx_Math" alttext="V\times W\to V\times W" display="inline" intent=":literal"><semantics><mrow><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>W</mi></mrow><mo stretchy="false">→</mo><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>W</mi></mrow></mrow><annotation encoding="application/x-tex">V\times W\to V\times W</annotation></semantics></math> which is the identity on the summand <math id="S21.SS1.SSS1.p4.m4" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>. Then we can see the following diagram commutes.</span></p>
<table id="S21.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S21.Ex8.m1.pic1" class="ltx_picture ltx_markedasmath" height="75.19" overflow="visible" style="vertical-align:-58.27681395099324px" version="1.1" viewBox="37.36 58.28 147.60 75.19" width="147.60"><g transform="matrix(1 0 0 -1 37.36329966104755 75.18867016564403) translate(0,3.46) translate(37.36,0)"><g transform="translate(-9.72,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.81em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="11.15"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S21.Ex8.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{V\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">\textstyle{V\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 9.724347938124827 -0.27673578005007266 L 9.724347938124827 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(32.19,0) translate(0,8.46) translate(4.15,0) translate(0,-2.42)"><foreignObject style="--ltx-fo-width:0.86em;--ltx-fo-height:0.49em;--ltx-fo-depth:0.14em;font-size:10pt;" height="8.61" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="11.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S21.Ex8.m1.pic1.m2" class="ltx_Math" alttext="\scriptstyle{f_{0}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">f</mi><mn mathsize="0.710em">0</mn></msub><annotation encoding="application/x-tex">\scriptstyle{f_{0}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(74.86,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 9.724347938124827 -0.27673578005007266 L 74.85420983972863 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 74.85420983972863 -0.27673578005007266 L 74.85420983972863 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -7.610350076103501 L 0.27673578005007266 -7.610350076103501" fill="none" stroke="#000000"></path><g transform="translate(-37.36,0) translate(0,-21.68) translate(4.15,0) translate(0,-2.42)"><foreignObject style="--ltx-fo-width:2.1em;--ltx-fo-height:0.53em;--ltx-fo-depth:0.18em;font-size:10pt;" height="9.69" overflow="visible" transform="matrix(1 0 0 -1 0 7.26)" width="29.06"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S21.Ex8.m1.pic1.m3" class="ltx_Math" alttext="\scriptstyle{v\mapsto(v,0)}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.700em">v</mi><mo mathsize="0.700em" stretchy="false">↦</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">v</mi><mo>,</mo><mn mathsize="0.700em">0</mn><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\scriptstyle{v\mapsto(v,0)}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.208800332088 L 0.27673578005007266 -7.610350076103501" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.208800332088 L 0.27673578005007266 -33.208800332088" fill="none" stroke="#000000"></path><g transform="translate(74.86,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.8em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="11.11"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S21.Ex8.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{Y}" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">\textstyle{Y}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(-25.68,0) translate(0,-43.36) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:3.11em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.08em;font-size:10pt;" height="10.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="43.05"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S21.Ex8.m1.pic1.m5" class="ltx_Math" alttext="\textstyle{V\times W\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>W</mi></mrow><annotation encoding="application/x-tex">\textstyle{V\times W\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 25.675282597756244 -43.63264139549389 L 25.675282597756244 -43.07916983539375" fill="none" stroke="#000000"></path><g transform="translate(33.88,0) translate(0,-50.82) translate(4.15,0) translate(0,-3.31)"><foreignObject style="--ltx-fo-width:0.61em;--ltx-fo-height:0.48em;--ltx-fo-depth:0em;font-size:10pt;" height="6.62" overflow="visible" transform="matrix(1 0 0 -1 0 6.62)" width="8.51"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S21.Ex8.m1.pic1.m6" class="ltx_Math" alttext="\scriptstyle{F}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">F</mi><annotation encoding="application/x-tex">\scriptstyle{F}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(58.88,0) translate(0,-43.36)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 25.675282597756244 -43.63264139549389 L 58.88406181625761 -43.07916983539375" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 58.88406181625761 -43.63264139549389 L 58.88406181625761 -43.07916983539375" fill="none" stroke="#000000"></path><g transform="translate(58.88,0) translate(0,-43.36) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:3.11em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.08em;font-size:10pt;" height="10.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="43.05"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S21.Ex8.m1.pic1.m7" class="ltx_Math" alttext="\textstyle{V\times W\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>W</mi></mrow><annotation encoding="application/x-tex">\textstyle{V\times W\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 84.28258752037715 -33.208800332088 L 84.83605908047728 -33.208800332088" fill="none" stroke="#000000"></path><g transform="translate(84.56,0) translate(0,-21.68) translate(4.15,0) translate(0,-5)"><foreignObject style="--ltx-fo-width:0.56em;--ltx-fo-height:0.72em;--ltx-fo-depth:0em;font-size:10pt;" height="9.99" overflow="visible" transform="matrix(1 0 0 -1 0 9.99)" width="7.69"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S21.Ex8.m1.pic1.m8" class="ltx_Math" alttext="\scriptstyle{\tilde{f}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi mathsize="0.700em">f</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\scriptstyle{\tilde{f}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(84.56,0) translate(0,-7.61)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -2.77 -6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 2.77 -6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 84.28258752037715 -33.208800332088 L 84.83605908047728 -7.610350076103501" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 84.28258752037715 -7.610350076103501 L 84.83605908047728 -7.610350076103501" fill="none" stroke="#000000"></path></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.SS1.SSS1.p4.4" class="ltx_p"><span id="S21.SS1.SSS1.p4.4.1" class="ltx_text">Therefore, <math id="S21.SS1.SSS1.p4.m5" class="ltx_Math" alttext="f_{0}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>0</mn></msub><annotation encoding="application/x-tex">f_{0}</annotation></semantics></math> is extended to a smooth submersion from <math id="S21.SS1.SSS1.p4.m6" class="ltx_Math" alttext="V\times W" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>W</mi></mrow><annotation encoding="application/x-tex">V\times W</annotation></semantics></math> to <math id="S21.SS1.SSS1.p4.m7" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>. Lastly, the smoothing on <math id="S21.SS1.SSS1.p4.m8" class="ltx_Math" alttext="V\times W" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>W</mi></mrow><annotation encoding="application/x-tex">V\times W</annotation></semantics></math> is in the same stable isotopy class because the choices made in the proof, especially the smooth approximation <math id="S21.SS1.SSS1.p4.m9" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> of <math id="S21.SS1.SSS1.p4.m10" class="ltx_Math" alttext="f_{0}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>0</mn></msub><annotation encoding="application/x-tex">f_{0}</annotation></semantics></math>, can all be made isotopic.
∎</span></p>
</div>
</div>
</section>
<section id="S21.SS1.SSS2" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">21.1.2. </span>The monotone flow category of holomorphic cylinders</h5>

<div id="S21.SS1.SSS2.p1" class="ltx_para ltx_noindent">
<p id="S21.SS1.SSS2.p1.1" class="ltx_p">Let <math id="S21.SS1.SSS2.p1.m1" class="ltx_Math" alttext="(X,\omega,J)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>ω</mi><mo>,</mo><mi>J</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(X,\omega,J)</annotation></semantics></math> be an almost Kähler manifold. Denote</p>
<table id="S21.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex9.m1" class="ltx_Math" alttext="\Pi^{\rm eff}:=\Big\{a\in\Pi\ |\ \omega(a)&gt;0\Big\}\cup\{0\}" display="block" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Π</mi><mi>eff</mi></msup><mo>:=</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mi>a</mi><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow><mo lspace="0.500em" rspace="0.500em">|</mo><mrow><mrow><mi>ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow><mo>∪</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Pi^{\rm eff}:=\Big\{a\in\Pi\ |\ \omega(a)&gt;0\Big\}\cup\{0\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.SS1.SSS2.p1.2" class="ltx_p">which is an abelian monoid whose Grothendieck construction is <math id="S21.SS1.SSS2.p1.m2" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>.</p>
</div>
<div id="S21.SS1.SSS2.p2" class="ltx_para ltx_noindent">
<p id="S21.SS1.SSS2.p2.1" class="ltx_p">We would like to generalize the notion of monotone flow categories. Recall that a monotone flow category enriched in <math id="S21.SS1.SSS2.p2.m1" class="ltx_Math" alttext="\underline{\smash{\bf C}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐂</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf C}}</annotation></semantics></math> contains objects <math id="S21.SS1.SSS2.p2.m2" class="ltx_Math" alttext="M_{d}^{\mathbb{f}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mi>d</mi><mi>𝕗</mi></msubsup><annotation encoding="application/x-tex">M_{d}^{\mathbb{f}}</annotation></semantics></math> indexed by <math id="S21.SS1.SSS2.p2.m3" class="ltx_Math" alttext="d\in{\mathbb{Z}}_{\geq 0}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>∈</mo><msub><mi>ℤ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">d\in{\mathbb{Z}}_{\geq 0}</annotation></semantics></math>. In the current case, one can define a generalization consisting of objects <math id="S21.SS1.SSS2.p2.m4" class="ltx_Math" alttext="M_{a}^{\mathbb{f}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mi>a</mi><mi>𝕗</mi></msubsup><annotation encoding="application/x-tex">M_{a}^{\mathbb{f}}</annotation></semantics></math> indexed by <math id="S21.SS1.SSS2.p2.m5" class="ltx_Math" alttext="a\in\Pi^{\rm eff}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><msup><mi mathvariant="normal">Π</mi><mi>eff</mi></msup></mrow><annotation encoding="application/x-tex">a\in\Pi^{\rm eff}</annotation></semantics></math>, together with structural maps from the fiber product of <math id="S21.SS1.SSS2.p2.m6" class="ltx_Math" alttext="M_{a}^{\mathbb{f}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mi>a</mi><mi>𝕗</mi></msubsup><annotation encoding="application/x-tex">M_{a}^{\mathbb{f}}</annotation></semantics></math> and <math id="S21.SS1.SSS2.p2.m7" class="ltx_Math" alttext="M_{b}^{\mathbb{f}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mi>b</mi><mi>𝕗</mi></msubsup><annotation encoding="application/x-tex">M_{b}^{\mathbb{f}}</annotation></semantics></math> over a space to <math id="S21.SS1.SSS2.p2.m8" class="ltx_Math" alttext="M_{a+b}^{\mathbb{f}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mi>𝕗</mi></msubsup><annotation encoding="application/x-tex">M_{a+b}^{\mathbb{f}}</annotation></semantics></math> satisfying a version of associativity condition. We describe such a monotone flow category <math id="S21.SS1.SSS2.p2.m9" class="ltx_Math" alttext="\mathbb{cyl}(X)" display="inline" intent=":literal"><semantics><mrow><mi>𝕔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{cyl}(X)</annotation></semantics></math> enriched in <math id="S21.SS1.SSS2.p2.m10" class="ltx_Math" alttext="\underline{\smash{\bf C}}=\underline{\smash{\bf Top}}(X)" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>𝐂</mi><mo stretchy="true">¯</mo></munder><mo>=</mo><mrow><munder accentunder="true"><mi>𝐓𝐨𝐩</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\underline{\smash{\bf C}}=\underline{\smash{\bf Top}}(X)</annotation></semantics></math> by defining</p>
<table id="S21.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex10.m1" class="ltx_math_unparsed" alttext="M_{a}^{\mathbb{cyl}}(X):=\left(\bigsqcup_{\omega(A)=a}\overline{\mathcal{M}}{}_{0,2}^{\mathbb{R}}(X,J,A),\ {\rm ev}_{-},\ {\rm ev}_{+}\right)\in{\rm Ob}\underline{\smash{\bf Top}}(X)," display="block" intent=":literal"><semantics><mrow><msubsup><mi>M</mi><mi>a</mi><mrow><mi>𝕔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo>:=</mo><mrow><mo>(</mo><munder><mo lspace="0em" movablelimits="false">⨆</mo><mrow><mrow><mi>ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>a</mi></mrow></munder><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>J</mi><mo>,</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mi>ℝ</mi><mprescripts></mprescripts><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mrow></mrow></mmultiscripts><mo rspace="0.667em">,</mo><msub><mi>ev</mi><mo>−</mo></msub><mo rspace="0.667em">,</mo><msub><mi>ev</mi><mo>+</mo></msub><mo>)</mo></mrow><mo>∈</mo><mi>Ob</mi><munder accentunder="true"><mi>𝐓𝐨𝐩</mi><mo stretchy="true">¯</mo></munder><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">M_{a}^{\mathbb{cyl}}(X):=\left(\bigsqcup_{\omega(A)=a}\overline{\mathcal{M}}{}_{0,2}^{\mathbb{R}}(X,J,A),\ {\rm ev}_{-},\ {\rm ev}_{+}\right)\in{\rm Ob}\underline{\smash{\bf Top}}(X),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.SS1.SSS2.p2.2" class="ltx_p">where <math id="S21.SS1.SSS2.p2.m11" class="ltx_Math" alttext="{\rm ev}_{\pm}" display="inline" intent=":literal"><semantics><msub><mi>ev</mi><mo>±</mo></msub><annotation encoding="application/x-tex">{\rm ev}_{\pm}</annotation></semantics></math> are the evaluation maps at the marked points. Then for <math id="S21.SS1.SSS2.p2.m12" class="ltx_Math" alttext="a,b\in\Pi^{\rm eff}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow><mo>∈</mo><msup><mi mathvariant="normal">Π</mi><mi>eff</mi></msup></mrow><annotation encoding="application/x-tex">a,b\in\Pi^{\rm eff}</annotation></semantics></math>, there is a natural map</p>
<table id="S21.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex11.m1" class="ltx_Math" alttext="M_{a}^{\mathbb{cyl}}(X)\underset{X}{\times}M_{b}^{\mathbb{cyl}}(X)\to M_{a+b}^{\mathbb{cyl}}(X)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>M</mi><mi>a</mi><mrow><mi>𝕔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.222em" rspace="0em">​</mo><munder accentunder="true"><mo>×</mo><mo mathsize="0.700em">𝑋</mo></munder><mo lspace="0.222em" rspace="0em">​</mo><msubsup><mi>M</mi><mi>b</mi><mrow><mi>𝕔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msubsup><mi>M</mi><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mrow><mi>𝕔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">M_{a}^{\mathbb{cyl}}(X)\underset{X}{\times}M_{b}^{\mathbb{cyl}}(X)\to M_{a+b}^{\mathbb{cyl}}(X).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.SS1.SSS2.p2.3" class="ltx_p">These structures define the monotone flow category <math id="S21.SS1.SSS2.p2.m13" class="ltx_Math" alttext="\mathbb{cyl}(X)" display="inline" intent=":literal"><semantics><mrow><mi>𝕔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{cyl}(X)</annotation></semantics></math>. By taking the Grothendieck construction, it induces an ordinary flow category</p>
<table id="S21.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex12.m1" class="ltx_Math" alttext="\mathbb{Cyl}(X)" display="block" intent=":literal"><semantics><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{Cyl}(X)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.SS1.SSS2.p2.4" class="ltx_p">called the <span id="S21.SS1.SSS2.p2.4.1" class="ltx_text ltx_font_bold">cylinder flow category</span> enriched in <math id="S21.SS1.SSS2.p2.m14" class="ltx_Math" alttext="\underline{\smash{\bf Top}}(X)" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>𝐓𝐨𝐩</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\underline{\smash{\bf Top}}(X)</annotation></semantics></math> whose object set is <math id="S21.SS1.SSS2.p2.m15" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>.</p>
</div>
<div id="S21.SS1.SSS2.p3" class="ltx_para ltx_noindent">
<p id="S21.SS1.SSS2.p3.1" class="ltx_p">To carry out the AMS construction, we first choose an integral symplectic form <math id="S21.SS1.SSS2.p3.m1" class="ltx_Math" alttext="\Omega\in\Omega^{2}(X)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>∈</mo><mrow><msup><mi mathvariant="normal">Ω</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Omega\in\Omega^{2}(X)</annotation></semantics></math> satisfying 1) <math id="S21.SS1.SSS2.p3.m2" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math> is tamed by <math id="S21.SS1.SSS2.p3.m3" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math> and 2) <math id="S21.SS1.SSS2.p3.m4" class="ltx_Math" alttext="{\rm Ker}\Omega={\rm ker}\omega\subseteq\pi_{2}(X)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Ker</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Ω</mi></mrow><mo>=</mo><mrow><mi>ker</mi><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow><mo>⊆</mo><mrow><msub><mi>π</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\rm Ker}\Omega={\rm ker}\omega\subseteq\pi_{2}(X)</annotation></semantics></math>. Then for each <math id="S21.SS1.SSS2.p3.m5" class="ltx_Math" alttext="a\in\Pi^{\rm eff}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><msup><mi mathvariant="normal">Π</mi><mi>eff</mi></msup></mrow><annotation encoding="application/x-tex">a\in\Pi^{\rm eff}</annotation></semantics></math>, there is an associated integer <math id="S21.SS1.SSS2.p3.m6" class="ltx_Math" alttext="d=d_{a}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><msub><mi>d</mi><mi>a</mi></msub></mrow><annotation encoding="application/x-tex">d=d_{a}</annotation></semantics></math>. As <math id="S21.SS1.SSS2.p3.m7" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math> is tamed by <math id="S21.SS1.SSS2.p3.m8" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math>, <math id="S21.SS1.SSS2.p3.m9" class="ltx_Math" alttext="d_{a}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>a</mi></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d_{a}\geq 0</annotation></semantics></math>.</p>
</div>
<div id="S21.Thmthm5" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S21.Thmthm5.2" class="ltx_text ltx_font_bold">Proposition 21.5</span></span><span id="S21.Thmthm5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S21.Thmthm5.p1" class="ltx_para">
<p id="S21.Thmthm5.p1.1" class="ltx_p"><span id="S21.Thmthm5.p1.1.1" class="ltx_text ltx_font_italic">There exists a lift <math id="S21.Thmthm5.p1.m1" class="ltx_Math" alttext="\widehat{\mathbb{cyl}}(X)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mrow><mi>𝕔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi></mrow><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mathbb{cyl}}(X)</annotation></semantics></math> of the outercollaring <math id="S21.Thmthm5.p1.m2" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{cyl}(X)" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><mi>𝕔</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mi>𝕪</mi><mi>𝕝</mi><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{cyl}(X)</annotation></semantics></math> to <math id="S21.Thmthm5.p1.m3" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf SKur}}^{\rm NC}_{\rm rig}(X)" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><munder accentunder="true"><mi>𝐒𝐊𝐮𝐫</mi><mo stretchy="true">¯</mo></munder><mi>rig</mi><mi>NC</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf SKur}}^{\rm NC}_{\rm rig}(X)</annotation></semantics></math> as a monotone flow category supported over <math id="S21.Thmthm5.p1.m4" class="ltx_Math" alttext="\Pi^{\rm eff}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Π</mi><mi>eff</mi></msup><annotation encoding="application/x-tex">\Pi^{\rm eff}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S21.SS1.SSS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S21.SS1.SSS2.p4" class="ltx_para ltx_noindent">
<p id="S21.SS1.SSS2.p4.1" class="ltx_p"><span id="S21.SS1.SSS2.p4.1.1" class="ltx_text">We first describe a monotone flow category of curves <math id="S21.SS1.SSS2.p4.m1" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}^{\Omega}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mi mathvariant="normal">Ω</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}^{\Omega}</annotation></semantics></math> enriched in <math id="S21.SS1.SSS2.p4.m2" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>ℂ</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}</annotation></semantics></math>, which is the restriction of <math id="S21.SS1.SSS2.p4.m3" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}</annotation></semantics></math> (specified in Section <a href="#S14" title="14. The Flow Categories, Multimodules, and Homotopies of Domains ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>) to open sets induced from <math id="S21.SS1.SSS2.p4.m4" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math>. For each <math id="S21.SS1.SSS2.p4.m5" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>, let</span></p>
<table id="S21.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex13.m1" class="ltx_Math" alttext="A_{d}^{\Omega}\subseteq A_{d}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>A</mi><mi>d</mi><mi mathvariant="normal">Ω</mi></msubsup><mo>⊆</mo><msub><mi>A</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">A_{d}^{\Omega}\subseteq A_{d}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.SS1.SSS2.p4.2" class="ltx_p"><span id="S21.SS1.SSS2.p4.2.1" class="ltx_text">to be the Alexandrov open subset of partitions <math id="S21.SS1.SSS2.p4.m6" class="ltx_Math" alttext="d=d_{0}+\cdots+d_{l}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>d</mi><mi>l</mi></msub></mrow></mrow><annotation encoding="application/x-tex">d=d_{0}+\cdots+d_{l}</annotation></semantics></math> such that for each <math id="S21.SS1.SSS2.p4.m7" class="ltx_Math" alttext="d_{l}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi>l</mi></msub><annotation encoding="application/x-tex">d_{l}</annotation></semantics></math>, there exists <math id="S21.SS1.SSS2.p4.m8" class="ltx_Math" alttext="a_{l}\in\Pi^{\rm eff}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>l</mi></msub><mo>∈</mo><msup><mi mathvariant="normal">Π</mi><mi>eff</mi></msup></mrow><annotation encoding="application/x-tex">a_{l}\in\Pi^{\rm eff}</annotation></semantics></math> with <math id="S21.SS1.SSS2.p4.m9" class="ltx_Math" alttext="d_{l}=\Omega(a_{l})" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>l</mi></msub><mo>=</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">d_{l}=\Omega(a_{l})</annotation></semantics></math>. Recall that the monotone flow category <math id="S21.SS1.SSS2.p4.m10" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}</annotation></semantics></math> gives objects</span></p>
<table id="S21.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex14.m1" class="ltx_Math" alttext="{\mathcal{C}}_{d}=({\mathcal{G}}_{d},B_{d},C_{d})\in{\rm Ob}\underline{\smash{\bf Curve}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>d</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>d</mi></msub><mo>,</mo><msub><mi>B</mi><mi>d</mi></msub><mo>,</mo><msub><mi>C</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi>Ob</mi><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{C}}_{d}=({\mathcal{G}}_{d},B_{d},C_{d})\in{\rm Ob}\underline{\smash{\bf Curve}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.SS1.SSS2.p4.3" class="ltx_p"><span id="S21.SS1.SSS2.p4.3.1" class="ltx_text">For <math id="S21.SS1.SSS2.p4.m11" class="ltx_Math" alttext="a\in\Pi^{\rm eff}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><msup><mi mathvariant="normal">Π</mi><mi>eff</mi></msup></mrow><annotation encoding="application/x-tex">a\in\Pi^{\rm eff}</annotation></semantics></math>, let <math id="S21.SS1.SSS2.p4.m12" class="ltx_Math" alttext="B_{a}^{\Omega}\subseteq B_{\Omega(a)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>B</mi><mi>a</mi><mi mathvariant="normal">Ω</mi></msubsup><mo>⊆</mo><msub><mi>B</mi><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">B_{a}^{\Omega}\subseteq B_{\Omega(a)}</annotation></semantics></math> be the union of strata prescribed by <math id="S21.SS1.SSS2.p4.m13" class="ltx_Math" alttext="A_{d}^{\Omega}" display="inline" intent=":literal"><semantics><msubsup><mi>A</mi><mi>d</mi><mi mathvariant="normal">Ω</mi></msubsup><annotation encoding="application/x-tex">A_{d}^{\Omega}</annotation></semantics></math>, which is open and <math id="S21.SS1.SSS2.p4.m14" class="ltx_Math" alttext="{\mathcal{G}}_{d}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>d</mi></msub><annotation encoding="application/x-tex">{\mathcal{G}}_{d}</annotation></semantics></math>-invariant. Define</span></p>
<table id="S21.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex15.m1" class="ltx_math_unparsed" alttext="{\mathcal{C}}_{a}^{\Omega}\in{\rm Ob}{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}" display="block" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><msub><mrow></mrow><mi>a</mi></msub><msup><mrow></mrow><mi mathvariant="normal">Ω</mi></msup><mo>∈</mo><mi>Ob</mi><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>ℂ</mi></msup></mrow><annotation encoding="application/x-tex">{\mathcal{C}}_{a}^{\Omega}\in{\rm Ob}{}_{\lfloor}\underline{\smash{\bf Curve}}_{\rm rig}^{\mathbb{C}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.SS1.SSS2.p4.4" class="ltx_p"><span id="S21.SS1.SSS2.p4.4.1" class="ltx_text">to be the restriction of <math id="S21.SS1.SSS2.p4.m15" class="ltx_Math" alttext="{\mathcal{C}}_{\Omega(a)}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></msub><annotation encoding="application/x-tex">{\mathcal{C}}_{\Omega(a)}</annotation></semantics></math> to <math id="S21.SS1.SSS2.p4.m16" class="ltx_Math" alttext="B_{a}^{\Omega}" display="inline" intent=":literal"><semantics><msubsup><mi>B</mi><mi>a</mi><mi mathvariant="normal">Ω</mi></msubsup><annotation encoding="application/x-tex">B_{a}^{\Omega}</annotation></semantics></math>. Then one obtains a monotone flow category <math id="S21.SS1.SSS2.p4.m17" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{Dom}^{\Omega,\mathbb{cyl}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>𝔻</mi><mi>𝕠</mi><mi>𝕞</mi><msup><mrow></mrow><mrow><mi mathvariant="normal">Ω</mi><mo>,</mo><mrow><mi>𝕔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{Dom}^{\Omega,\mathbb{cyl}}</annotation></semantics></math>.</span></p>
</div>
<div id="S21.SS1.SSS2.p5" class="ltx_para ltx_noindent">
<p id="S21.SS1.SSS2.p5.1" class="ltx_p"><span id="S21.SS1.SSS2.p5.1.1" class="ltx_text">Then one has a corresponding monotone flow category of framed maps consisting of objects</span></p>
<table id="S21.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex16.m1" class="ltx_math_unparsed" alttext="{\rm Map}_{a}^{\rm fr}(X)\to{}_{\lfloor}B_{a}^{\Omega}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>Map</mi><mi>a</mi><mi>fr</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><mmultiscripts><mi>B</mi><mi>a</mi><mi mathvariant="normal">Ω</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">{\rm Map}_{a}^{\rm fr}(X)\to{}_{\lfloor}B_{a}^{\Omega}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.SS1.SSS2.p5.2" class="ltx_p"><span id="S21.SS1.SSS2.p5.2.1" class="ltx_text">whose fiber of <math id="S21.SS1.SSS2.p5.m1" class="ltx_math_unparsed" alttext="\phi\in{}_{\lfloor}B_{a}^{\Omega}" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>∈</mo><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>B</mi><msub><mrow></mrow><mi>a</mi></msub><msup><mrow></mrow><mi mathvariant="normal">Ω</mi></msup></mrow><annotation encoding="application/x-tex">\phi\in{}_{\lfloor}B_{a}^{\Omega}</annotation></semantics></math> is the space of pairs <math id="S21.SS1.SSS2.p5.m2" class="ltx_Math" alttext="(u,F)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>F</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u,F)</annotation></semantics></math> where <math id="S21.SS1.SSS2.p5.m3" class="ltx_Math" alttext="u:\mathring{C}_{\phi}\to X" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mover accent="true"><mi>C</mi><mo>̊</mo></mover><mi>ϕ</mi></msub><mo stretchy="false">→</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">u:\mathring{C}_{\phi}\to X</annotation></semantics></math> is a smooth map on each irreducible component which extends continuously to <math id="S21.SS1.SSS2.p5.m4" class="ltx_Math" alttext="C_{\phi}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>ϕ</mi></msub><annotation encoding="application/x-tex">C_{\phi}</annotation></semantics></math> and which converges exponentially at cylindrical nodes and markings and where <math id="S21.SS1.SSS2.p5.m5" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> is a frame of the holomorphic line bundle <math id="S21.SS1.SSS2.p5.m6" class="ltx_Math" alttext="L_{u,\Omega}\to C_{\phi}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mrow><mi>u</mi><mo>,</mo><mi mathvariant="normal">Ω</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi>C</mi><mi>ϕ</mi></msub></mrow><annotation encoding="application/x-tex">L_{u,\Omega}\to C_{\phi}</annotation></semantics></math>.</span></p>
</div>
<div id="S21.SS1.SSS2.p6" class="ltx_para ltx_noindent">
<p id="S21.SS1.SSS2.p6.1" class="ltx_p"><span id="S21.SS1.SSS2.p6.1.1" class="ltx_text">One can also choose a collection of transverse thickening data</span></p>
<table id="S21.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex17.m1" class="ltx_math_unparsed" alttext="\nu_{a}:W_{a}\to\Gamma_{c}({}_{\lfloor}\mathring{C}_{a}^{\Omega}\times X,\Lambda_{{}_{\lfloor}\mathring{C}_{a}^{\Omega}/{}_{\lfloor}B_{a}^{\Omega}}^{0,1}\otimes TX)" display="block" intent=":literal"><semantics><mrow><msub><mi>ν</mi><mi>a</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi>W</mi><mi>a</mi></msub><mo stretchy="false">→</mo><msub><mi mathvariant="normal">Γ</mi><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><mmultiscripts><mover accent="true"><mi>C</mi><mo>̊</mo></mover><mi>a</mi><mi mathvariant="normal">Ω</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mo lspace="0.222em" rspace="0.222em">×</mo><mi>X</mi><mo>,</mo><msubsup><mi mathvariant="normal">Λ</mi><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mover accent="true"><mi>C</mi><mo>̊</mo></mover><msub><mrow></mrow><mi>a</mi></msub><msup><mrow></mrow><mi mathvariant="normal">Ω</mi></msup><mo>/</mo><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi>B</mi><msub><mrow></mrow><mi>a</mi></msub><msup><mrow></mrow><mi mathvariant="normal">Ω</mi></msup></mrow><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>T</mi><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nu_{a}:W_{a}\to\Gamma_{c}({}_{\lfloor}\mathring{C}_{a}^{\Omega}\times X,\Lambda_{{}_{\lfloor}\mathring{C}_{a}^{\Omega}/{}_{\lfloor}B_{a}^{\Omega}}^{0,1}\otimes TX)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.SS1.SSS2.p6.2" class="ltx_p"><span id="S21.SS1.SSS2.p6.2.1" class="ltx_text">which are collared and respect the structural maps. Here <math id="S21.SS1.SSS2.p6.m1" class="ltx_Math" alttext="W_{a}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mi>a</mi></msub><annotation encoding="application/x-tex">W_{a}</annotation></semantics></math> is a collection of unitary representations of <math id="S21.SS1.SSS2.p6.m2" class="ltx_Math" alttext="G_{\Omega(a)}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></msub><annotation encoding="application/x-tex">G_{\Omega(a)}</annotation></semantics></math>. On the other hand, one can choose a group reduction scheme, given by a collection of continuous maps</span></p>
<table id="S21.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex18.m1" class="ltx_Math" alttext="\lambda_{a}:{\rm Map}_{a}^{\rm fr}(X)\to Q_{a}\cong{\mathcal{G}}_{\Omega(a)}/G_{\Omega(a)}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>λ</mi><mi>a</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mi>Map</mi><mi>a</mi><mi>fr</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><msub><mi>Q</mi><mi>a</mi></msub><mo>≅</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>/</mo><msub><mi>G</mi><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lambda_{a}:{\rm Map}_{a}^{\rm fr}(X)\to Q_{a}\cong{\mathcal{G}}_{\Omega(a)}/G_{\Omega(a)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.SS1.SSS2.p6.3" class="ltx_p"><span id="S21.SS1.SSS2.p6.3.1" class="ltx_text">Then one obtains a corresponding thickening</span></p>
<table id="S21.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex19.m1" class="ltx_math_unparsed" alttext="K_{a}=(G_{a},V_{a},E_{a},S_{a})\in{\rm Ob}{}_{\lfloor}\underline{\smash{\bf Kur}}" display="block" intent=":literal"><semantics><mrow><msub><mi>K</mi><mi>a</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>a</mi></msub><mo>,</mo><msub><mi>V</mi><mi>a</mi></msub><mo>,</mo><msub><mi>E</mi><mi>a</mi></msub><mo>,</mo><msub><mi>S</mi><mi>a</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>Ob</mi><mmultiscripts><munder accentunder="true"><mi>𝐊𝐮𝐫</mi><mo stretchy="true">¯</mo></munder><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">K_{a}=(G_{a},V_{a},E_{a},S_{a})\in{\rm Ob}{}_{\lfloor}\underline{\smash{\bf Kur}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.SS1.SSS2.p6.4" class="ltx_p"><span id="S21.SS1.SSS2.p6.4.1" class="ltx_text">where</span></p>
<table id="S21.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex20.m1" class="ltx_math_unparsed" alttext="V_{a}=\Big\{(\phi,u,F,e)\ |\ (\phi,u,F)\in{\rm Map}_{a}^{\rm fr}(X),\ e\in W_{a},\ \phi=\phi_{F}\in{}_{\lfloor}B_{a}^{\Omega},\ \overline{\partial}_{J}u+\nu_{a}(e)=0\Big\}," display="block" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi>a</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>F</mi><mo>,</mo><mi>e</mi><mo rspace="0.500em" stretchy="false">)</mo></mrow><mo fence="false" rspace="0.667em" stretchy="false">|</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>F</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msubsup><mi>Map</mi><mi>a</mi><mi>fr</mi></msubsup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.667em">,</mo><mi>e</mi><mo>∈</mo><msub><mi>W</mi><mi>a</mi></msub><mo rspace="0.667em">,</mo><mi>ϕ</mi><mo>=</mo><msub><mi>ϕ</mi><mi>F</mi></msub><mo>∈</mo><mmultiscripts><mi>B</mi><mi>a</mi><mi mathvariant="normal">Ω</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mo rspace="0.500em">,</mo><msub><mover accent="true"><mo>∂</mo><mo stretchy="true">¯</mo></mover><mi>J</mi></msub><mi>u</mi><mo>+</mo><msub><mi>ν</mi><mi>a</mi></msub><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mn>0</mn><mo stretchy="false">}</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">V_{a}=\Big\{(\phi,u,F,e)\ |\ (\phi,u,F)\in{\rm Map}_{a}^{\rm fr}(X),\ e\in W_{a},\ \phi=\phi_{F}\in{}_{\lfloor}B_{a}^{\Omega},\ \overline{\partial}_{J}u+\nu_{a}(e)=0\Big\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.SS1.SSS2.p6.5" class="ltx_p"><span id="S21.SS1.SSS2.p6.5.1" class="ltx_text">with the natural <math id="S21.SS1.SSS2.p6.m3" class="ltx_Math" alttext="G_{a}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>a</mi></msub><annotation encoding="application/x-tex">G_{a}</annotation></semantics></math>-action, <math id="S21.SS1.SSS2.p6.m4" class="ltx_Math" alttext="E_{a}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>a</mi></msub><annotation encoding="application/x-tex">E_{a}</annotation></semantics></math> is the trivial bundle with fiber <math id="S21.SS1.SSS2.p6.m5" class="ltx_Math" alttext="W_{a}\oplus Q_{a}" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>a</mi></msub><mo>⊕</mo><msub><mi>Q</mi><mi>a</mi></msub></mrow><annotation encoding="application/x-tex">W_{a}\oplus Q_{a}</annotation></semantics></math>, and <math id="S21.SS1.SSS2.p6.m6" class="ltx_Math" alttext="S_{a}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>a</mi></msub><annotation encoding="application/x-tex">S_{a}</annotation></semantics></math> is the section given by</span></p>
<table id="S21.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex21.m1" class="ltx_Math" alttext="S_{a}(\phi,u,F,e)=(e,\lambda_{a}(\phi,u,F))." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>S</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>F</mi><mo>,</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo>,</mo><mrow><msub><mi>λ</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">S_{a}(\phi,u,F,e)=(e,\lambda_{a}(\phi,u,F)).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.SS1.SSS2.p6.6" class="ltx_p"><span id="S21.SS1.SSS2.p6.6.1" class="ltx_text">Similar to Theorem <a href="#S15.Thmthm15" title="Theorem 15.15. ‣ 15.3.2. The thickenings ‣ 15.3. The topological Kuranishi lifts ‣ 15. Relatively Smooth AMS lifts ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15.15</span></a>, the natural map</span></p>
<table id="S21.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex22.m1" class="ltx_math_unparsed" alttext="S_{a}^{-1}(0)/G_{a}\to{}_{\lfloor}M_{a}^{\mathbb{cyl}}(X)" display="block" intent=":literal"><semantics><mrow><msubsup><mi>S</mi><mi>a</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>/</mo><msub><mi>G</mi><mi>a</mi></msub><mo stretchy="false">→</mo><mmultiscripts><mi>M</mi><mi>a</mi><mrow><mi>𝕔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi></mrow><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">S_{a}^{-1}(0)/G_{a}\to{}_{\lfloor}M_{a}^{\mathbb{cyl}}(X)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.SS1.SSS2.p6.7" class="ltx_p"><span id="S21.SS1.SSS2.p6.7.1" class="ltx_text">is an isomorphism of orbispaces. By an abuse of notation, let <math id="S21.SS1.SSS2.p6.m7" class="ltx_Math" alttext="V_{a}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>a</mi></msub><annotation encoding="application/x-tex">V_{a}</annotation></semantics></math> denote the regular locus for the operator <math id="S21.SS1.SSS2.p6.m8" class="ltx_Math" alttext="\overline{\partial}_{J}u+\nu_{a}(e)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mo>∂</mo><mo stretchy="true">¯</mo></mover><mi>J</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo>+</mo><mrow><msub><mi>ν</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\overline{\partial}_{J}u+\nu_{a}(e)=0</annotation></semantics></math>, i.e., the subspace such that the linearization of this equation is surjective. Then, it contains the zero locus by the transversality assumption. Then one obtains a lift of the monotone flow category <math id="S21.SS1.SSS2.p6.m9" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{cyl}(X)" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><mi>𝕔</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mi>𝕪</mi><mi>𝕝</mi><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{cyl}(X)</annotation></semantics></math> to the category <math id="S21.SS1.SSS2.p6.m10" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf Kur}}_{\rm rig}(X)" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><munder accentunder="true"><mi>𝐊𝐮𝐫</mi><mo stretchy="true">¯</mo></munder><mi>rig</mi><mrow></mrow><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf Kur}}_{\rm rig}(X)</annotation></semantics></math>. In the same way as argued in Subsection <a href="#S15.SS4" title="15.4. Relatively smooth AMS lifts ‣ 15. Relatively Smooth AMS lifts ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15.4</span></a>, the lift is in fact enriched in <math id="S21.SS1.SSS2.p6.m11" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf S^{\rm rel}Kur}}_{\rm rig}(X)" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><munder accentunder="true"><mrow><msup><mi>𝐒</mi><mi>rel</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐊𝐮𝐫</mi></mrow><mo stretchy="true">¯</mo></munder><mi>rig</mi><mrow></mrow><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf S^{\rm rel}Kur}}_{\rm rig}(X)</annotation></semantics></math>. We denote this lift by</span></p>
<table id="S21.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex23.m1" class="ltx_Math" alttext="\widehat{\mathbb{cyl}}(X)." display="block" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mrow><mi>𝕔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi></mrow><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widehat{\mathbb{cyl}}(X).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S21.SS1.SSS2.p7" class="ltx_para ltx_noindent">
<p id="S21.SS1.SSS2.p7.1" class="ltx_p"><span id="S21.SS1.SSS2.p7.1.1" class="ltx_text">The construct of normal complex structure is slightly easier than the case of Floer flow categories. Indeed, because we do not have Hamiltonian perturbations, the (vertical) linearized operators are the Cauchy–Riemann operators</span></p>
<table id="S21.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex24.m1" class="ltx_Math" alttext="D_{u,e}=\left[D_{u}\overline{\partial}_{J}+D_{u}\nu_{a}(u,e)+\nu_{a}(u)\right]:\Omega^{0}(C_{\phi},u^{*}TX)\oplus W_{a}\to\Omega^{0,1}(C_{\phi},u^{*}TX)" display="block" intent=":literal"><semantics><mrow><msub><mi>D</mi><mrow><mi>u</mi><mo>,</mo><mi>e</mi></mrow></msub><mo>=</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>D</mi><mi>u</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mo>∂</mo><mo stretchy="true">¯</mo></mover><mi>J</mi></msub></mrow><mo>+</mo><mrow><msub><mi>D</mi><mi>u</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ν</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>ν</mi><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.278em">]</mo></mrow><mo rspace="0.278em">:</mo><mrow><mrow><mrow><msup><mi mathvariant="normal">Ω</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mi>ϕ</mi></msub><mo>,</mo><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>X</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><msub><mi>W</mi><mi>a</mi></msub></mrow><mo stretchy="false">→</mo><mrow><msup><mi mathvariant="normal">Ω</mi><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mi>ϕ</mi></msub><mo>,</mo><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>X</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">D_{u,e}=\left[D_{u}\overline{\partial}_{J}+D_{u}\nu_{a}(u,e)+\nu_{a}(u)\right]:\Omega^{0}(C_{\phi},u^{*}TX)\oplus W_{a}\to\Omega^{0,1}(C_{\phi},u^{*}TX)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.SS1.SSS2.p7.2" class="ltx_p"><span id="S21.SS1.SSS2.p7.2.1" class="ltx_text">where <math id="S21.SS1.SSS2.p7.m1" class="ltx_Math" alttext="W_{a}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mi>a</mi></msub><annotation encoding="application/x-tex">W_{a}</annotation></semantics></math> is a complex representation. Recall that the canonical linearization is calculated by the Levi–Civita connection on <math id="S21.SS1.SSS2.p7.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> induced from the symplectic form and the almost complex structure, which is not necessarily complex-linear. However, one can choose a 1-parameter family of linear operators connecting <math id="S21.SS1.SSS2.p7.m3" class="ltx_Math" alttext="D_{u,e}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mi>u</mi><mo>,</mo><mi>e</mi></mrow></msub><annotation encoding="application/x-tex">D_{u,e}</annotation></semantics></math> to a complex linear one, without using the complicated interpolation argument as in the Floer case. This means for each individual moduli space, one has a canonical homotopy class of isomorphisms between the vertical tangent bundle and a complex vector bundle. One can choose concrete isomorphisms inductively. This provides a lift to <math id="S21.SS1.SSS2.p7.m4" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf S^{\rm rel}Kur}}_{\rm rig}^{\rm NC}(X)" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><munder accentunder="true"><mrow><msup><mi>𝐒</mi><mi>rel</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐊𝐮𝐫</mi></mrow><mo stretchy="true">¯</mo></munder><mi>rig</mi><mi>NC</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf S^{\rm rel}Kur}}_{\rm rig}^{\rm NC}(X)</annotation></semantics></math>.</span></p>
</div>
<div id="S21.SS1.SSS2.p8" class="ltx_para">
<p id="S21.SS1.SSS2.p8.1" class="ltx_p"><span id="S21.SS1.SSS2.p8.1.1" class="ltx_text">The smoothing procedure is slightly different from the previous case as we also need to make the evaluation maps smooth. However, by Lemma <a href="#S21.Thmthm4" title="Lemma 21.4 (Stable smoothing with maps). ‣ 21.1.1. Fibered topological spaces, Kuranishi spaces, and derived orbifolds ‣ 21.1. Pearly flow category ‣ 21. AMS Construction for Other Flow categories, Multimodules, and Homotopies ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21.4</span></a>, one can perform stable smoothing on <math id="S21.SS1.SSS2.p8.m1" class="ltx_Math" alttext="(K_{a},{\rm ev}_{\pm})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>K</mi><mi>a</mi></msub><mo>,</mo><msub><mi>ev</mi><mo>±</mo></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(K_{a},{\rm ev}_{\pm})</annotation></semantics></math> so that not only the Kuranishi spaces become smooth, but also the evaluation maps become smooth submersions. Then following the same inductive procedure, after stabilization, one obtains a lift to the category <math id="S21.SS1.SSS2.p8.m2" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf SKur}}_{\rm rig}(X)" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><munder accentunder="true"><mi>𝐒𝐊𝐮𝐫</mi><mo stretchy="true">¯</mo></munder><mi>rig</mi><mrow></mrow><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf SKur}}_{\rm rig}(X)</annotation></semantics></math>. Together with the stable complex structures on the domain flow categories, this is a lift to <math id="S21.SS1.SSS2.p8.m3" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf SKur}}_{\rm rig}^{\rm NC}(X)" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><munder accentunder="true"><mi>𝐒𝐊𝐮𝐫</mi><mo stretchy="true">¯</mo></munder><mi>rig</mi><mi>NC</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf SKur}}_{\rm rig}^{\rm NC}(X)</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S21.SS1.SSS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Theorem <a href="#S12.Thmthm7" title="Theorem 12.7. ‣ 12.3.1. PSS maps and pearly flow category ‣ 12.3. Bimodules and homotopies associated to PSS type maps ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12.7</span></a>.</h6>
<div id="S21.SS1.SSS2.p9" class="ltx_para ltx_noindent">
<p id="S21.SS1.SSS2.p9.1" class="ltx_p"><span id="S21.SS1.SSS2.p9.1.1" class="ltx_text">We first describe the lift of the pearly flow category <math id="S21.SS1.SSS2.p9.m1" class="ltx_Math" alttext="{\mathbb{P}}" display="inline" intent=":literal"><semantics><mi>ℙ</mi><annotation encoding="application/x-tex">{\mathbb{P}}</annotation></semantics></math>. Choose a lift <math id="S21.SS1.SSS2.p9.m2" class="ltx_Math" alttext="\widehat{\mathbb{cyl}}(X)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mrow><mi>𝕔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi></mrow><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mathbb{cyl}}(X)</annotation></semantics></math> provided by Proposition <a href="#S21.Thmthm5" title="Proposition 21.5. ‣ 21.1.2. The monotone flow category of holomorphic cylinders ‣ 21.1. Pearly flow category ‣ 21. AMS Construction for Other Flow categories, Multimodules, and Homotopies ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21.5</span></a>. By taking quotient, one obtains a monotone flow category enriched in <math id="S21.SS1.SSS2.p9.m3" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf dOrb}}^{\rm NC}_{\rm rig}(X)" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><mi>rig</mi><mi>NC</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf dOrb}}^{\rm NC}_{\rm rig}(X)</annotation></semantics></math>, which induces an ordinary flow category, denoted by <math id="S21.SS1.SSS2.p9.m4" class="ltx_Math" alttext="\widetilde{\mathbb{Cyl}}(X)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi></mrow><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\mathbb{Cyl}}(X)</annotation></semantics></math>, whose objects are elements of <math id="S21.SS1.SSS2.p9.m5" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>.</span></p>
</div>
<div id="S21.SS1.SSS2.p10" class="ltx_para ltx_noindent">
<p id="S21.SS1.SSS2.p10.1" class="ltx_p"><span id="S21.SS1.SSS2.p10.1.1" class="ltx_text">Then one can obtain a lift of the corresponding outercollaring of <math id="S21.SS1.SSS2.p10.m1" class="ltx_Math" alttext="{\mathbb{P}}" display="inline" intent=":literal"><semantics><mi>ℙ</mi><annotation encoding="application/x-tex">{\mathbb{P}}</annotation></semantics></math> by “inserting flow lines.” We do this inductively. In the lowest energy case, one only needs to add flow rays at the negative and positive ends to obtain Kuranishi charts of moduli spaces labelled by a pair of critical points. In higher energy case, there are configurations where in the interior there are gradient segments of positive length. An inductive scheme can be designed in a rather elementary way to produce inductively all charts for involved moduli spaces. Hence one obtains a lift of the outercollaring of <math id="S21.SS1.SSS2.p10.m2" class="ltx_Math" alttext="{\mathbb{P}}" display="inline" intent=":literal"><semantics><mi>ℙ</mi><annotation encoding="application/x-tex">{\mathbb{P}}</annotation></semantics></math> to <math id="S21.SS1.SSS2.p10.m3" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>NC</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}</annotation></semantics></math> (inserting flow lines does not affect the NC structure).</span></p>
</div>
<div id="S21.SS1.SSS2.p11" class="ltx_para ltx_noindent">
<p id="S21.SS1.SSS2.p11.1" class="ltx_p"><span id="S21.SS1.SSS2.p11.1.1" class="ltx_text">Next, we discuss the regularization of the bimodule <math id="S21.SS1.SSS2.p11.m1" class="ltx_Math" alttext="\mathbb{\Delta}^{\mathbb{PP}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{\Delta}^{\mathbb{PP}}</annotation></semantics></math>. In fact, one can take different Morse–Smale pairs and different almost complex structures to define <math id="S21.SS1.SSS2.p11.m2" class="ltx_Math" alttext="\mathbb{P}" display="inline" intent=":literal"><semantics><mi>ℙ</mi><annotation encoding="application/x-tex">\mathbb{P}</annotation></semantics></math> and consider the bimodule as an interpolation between them. However, we choose the same one to simplify the notations.</span></p>
</div>
<div id="S21.SS1.SSS2.p12" class="ltx_para ltx_noindent">
<p id="S21.SS1.SSS2.p12.1" class="ltx_p"><span id="S21.SS1.SSS2.p12.1.1" class="ltx_text">The construction is very similar to the regularization of the Pearly flow category. First, there is a monotone bimodule <math id="S21.SS1.SSS2.p12.m1" class="ltx_Math" alttext="\mathbb{\Delta}^{\mathbb{cyl}(X)}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mrow><mi>𝕔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></msup><annotation encoding="application/x-tex">\mathbb{\Delta}^{\mathbb{cyl}(X)}</annotation></semantics></math> given by holomorphic cylinders which have a parametrized principal component. This is a monotone bimodule over <math id="S21.SS1.SSS2.p12.m2" class="ltx_Math" alttext="(\mathbb{cyl}(X);\mathbb{cyl}(X))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>𝕔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>;</mo><mrow><mi>𝕔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbb{cyl}(X);\mathbb{cyl}(X))</annotation></semantics></math>.</span></p>
</div>
<div id="S21.SS1.SSS2.p13" class="ltx_para">
<p id="S21.SS1.SSS2.p13.1" class="ltx_p"><span id="S21.SS1.SSS2.p13.1.1" class="ltx_text">Then after outercollaring, following the same procedure as the proof of Proposition <a href="#S21.Thmthm5" title="Proposition 21.5. ‣ 21.1.2. The monotone flow category of holomorphic cylinders ‣ 21.1. Pearly flow category ‣ 21. AMS Construction for Other Flow categories, Multimodules, and Homotopies ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21.5</span></a>, one obtains an AMS lift to <math id="S21.SS1.SSS2.p13.m1" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf SKur}}_{\rm rig}^{\rm NC}(X)" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><munder accentunder="true"><mi>𝐒𝐊𝐮𝐫</mi><mo stretchy="true">¯</mo></munder><mi>rig</mi><mi>NC</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf SKur}}_{\rm rig}^{\rm NC}(X)</annotation></semantics></math>, denoted by <math id="S21.SS1.SSS2.p13.m2" class="ltx_Math" alttext="\widehat{\mathbb{\Delta}}^{\mathbb{cyl}(X)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mo>^</mo></mover><mrow><mi>𝕔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></msup><annotation encoding="application/x-tex">\widehat{\mathbb{\Delta}}^{\mathbb{cyl}(X)}</annotation></semantics></math>. After taking quotient, one obtains a bimodule <math id="S21.SS1.SSS2.p13.m3" class="ltx_Math" alttext="\widetilde{\mathbb{\Delta}}^{\mathbb{cyl}^{\mathbb{P}}(X)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mo>~</mo></mover><mrow><mi>𝕔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝕝</mi><mi>ℙ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></msup><annotation encoding="application/x-tex">\widetilde{\mathbb{\Delta}}^{\mathbb{cyl}^{\mathbb{P}}(X)}</annotation></semantics></math> over <math id="S21.SS1.SSS2.p13.m4" class="ltx_Math" alttext="(\widetilde{\mathbb{cyl}}(X);\widetilde{\mathbb{cyl}}(X))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mrow><mi>𝕔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi></mrow><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>;</mo><mrow><mover accent="true"><mrow><mi>𝕔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi></mrow><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\widetilde{\mathbb{cyl}}(X);\widetilde{\mathbb{cyl}}(X))</annotation></semantics></math> enriched in <math id="S21.SS1.SSS2.p13.m5" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf dOrb}}^{\rm NC}_{\rm rig}(X)" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><mi>rig</mi><mi>NC</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf dOrb}}^{\rm NC}_{\rm rig}(X)</annotation></semantics></math>. Then using the fact that evaluation maps are smooth submersions, by inserting Morse flow lines, one obtains a lift of <math id="S21.SS1.SSS2.p13.m6" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{\Delta}^{\mathbb{PP}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><msup><mrow></mrow><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{\Delta}^{\mathbb{PP}}</annotation></semantics></math> as a bimodule over <math id="S21.SS1.SSS2.p13.m7" class="ltx_Math" alttext="(\tilde{\mathbb{P}};\tilde{\mathbb{P}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>ℙ</mi><mo>~</mo></mover><mo>;</mo><mover accent="true"><mi>ℙ</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\tilde{\mathbb{P}};\tilde{\mathbb{P}})</annotation></semantics></math>. This proves the second item of Theorem <a href="#S12.Thmthm7" title="Theorem 12.7. ‣ 12.3.1. PSS maps and pearly flow category ‣ 12.3. Bimodules and homotopies associated to PSS type maps ‣ 12. Main Theorems on AMS Lifts ‣ Part II GEOMETRIC FLOW CATEGORIES, BIMODULES, AND HOMOTOPIES ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12.7</span></a>.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="S21.SS2" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">21.2. </span>Deformed Morse-to-Morse bimodule</h4>

<div id="S21.SS2.p1" class="ltx_para ltx_noindent">
<p id="S21.SS2.p1.1" class="ltx_p">The regularization of the Morse-to-Morse bimodule was discussed in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib57" title="" class="ltx_ref">14</a>]</cite> using the original perturbation from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib61" title="" class="ltx_ref">3</a>]</cite>.</p>
</div>
<div id="S21.Thmthm6" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S21.Thmthm6.2" class="ltx_text ltx_font_bold">Proposition 21.6</span></span><span id="S21.Thmthm6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S21.Thmthm6.p1" class="ltx_para">
<p id="S21.Thmthm6.p1.1" class="ltx_p"><span id="S21.Thmthm6.p1.1.1" class="ltx_text ltx_font_italic">Upon choosing an integral symplectic form <math id="S21.Thmthm6.p1.m1" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math>, there exists a lift of <math id="S21.Thmthm6.p1.m2" class="ltx_Math" alttext="\Delta^{\mathbb{MM}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Δ</mi><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msup><annotation encoding="application/x-tex">\Delta^{\mathbb{MM}}</annotation></semantics></math> of the deformed Morse-to-Morse bimodule to <math id="S21.Thmthm6.p1.m3" class="ltx_Math" alttext="\underline{\smash{\bf dOrb}}^{\rm NC}_{\rm rig}" display="inline" intent=":literal"><semantics><msubsup><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><mi>rig</mi><mi>NC</mi></msubsup><annotation encoding="application/x-tex">\underline{\smash{\bf dOrb}}^{\rm NC}_{\rm rig}</annotation></semantics></math> as a bimodule over <math id="S21.Thmthm6.p1.m4" class="ltx_Math" alttext="(\mathbb{M};\mathbb{M})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>𝕄</mi><mo>;</mo><mi>𝕄</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbb{M};\mathbb{M})</annotation></semantics></math> (without outercollaring).</span></p>
</div>
</div>
<div id="S21.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S21.SS2.p2" class="ltx_para ltx_noindent">
<p id="S21.SS2.p2.1" class="ltx_p"><span id="S21.SS2.p2.1.1" class="ltx_text">For each <math id="S21.SS2.p2.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>, consider the moduli space <math id="S21.SS2.p2.m2" class="ltx_Math" alttext="\overline{\mathcal{M}}_{0,2}(\mathbb{CP}^{d},d)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{0,2}(\mathbb{CP}^{d},d)</annotation></semantics></math> of 2-pointed stable holomorphic spheres in <math id="S21.SS2.p2.m3" class="ltx_Math" alttext="\mathbb{CP}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathbb{CP}^{d}</annotation></semantics></math>. Choose the negative convention; the other choice works as well. Let <math id="S21.SS2.p2.m4" class="ltx_Math" alttext="B_{d}=B_{d}^{-}" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>d</mi></msub><mo>=</mo><msubsup><mi>B</mi><mi>d</mi><mo>−</mo></msubsup></mrow><annotation encoding="application/x-tex">B_{d}=B_{d}^{-}</annotation></semantics></math> be the subset of curves whose images are not contained in any hyperplane and whose value at the negative end is <math id="S21.SS2.p2.m5" class="ltx_Math" alttext="[1,0,\ldots,0]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[1,0,\ldots,0]</annotation></semantics></math>. Then consider the curve <math id="S21.SS2.p2.m6" class="ltx_Math" alttext="{\mathcal{C}}_{d}=({\mathcal{G}}_{d},B_{d},C_{d})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>d</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>d</mi></msub><mo>,</mo><msub><mi>B</mi><mi>d</mi></msub><mo>,</mo><msub><mi>C</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{C}}_{d}=({\mathcal{G}}_{d},B_{d},C_{d})</annotation></semantics></math>. Notice that this is a family of curves without boundary or corners.</span></p>
</div>
<div id="S21.SS2.p3" class="ltx_para ltx_noindent">
<p id="S21.SS2.p3.1" class="ltx_p"><span id="S21.SS2.p3.1.1" class="ltx_text">Now choose an integral symplectic form <math id="S21.SS2.p3.m1" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math>. For each <math id="S21.SS2.p3.m2" class="ltx_Math" alttext="a\in\Pi^{\rm eff}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><msup><mi mathvariant="normal">Π</mi><mi>eff</mi></msup></mrow><annotation encoding="application/x-tex">a\in\Pi^{\rm eff}</annotation></semantics></math>, denote <math id="S21.SS2.p3.m3" class="ltx_Math" alttext="d=d_{a}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><msub><mi>d</mi><mi>a</mi></msub></mrow><annotation encoding="application/x-tex">d=d_{a}</annotation></semantics></math>. Consider the space of framed maps</span></p>
<table id="S21.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex25.m1" class="ltx_math_unparsed" alttext="{\rm Map}_{d}^{\rm fr}=\Big\{(\phi,u,F)\ |\ \phi\in B_{d},u:C_{\phi}\to X,\ F=(f_{0},\ldots,f_{d})\ {\rm is\ a\ basis\ of\ }H^{0}(L_{u,\Omega})\Big\}." display="block" intent=":literal"><semantics><mrow><msubsup><mi>Map</mi><mi>d</mi><mi>fr</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>F</mi><mo rspace="0.500em" stretchy="false">)</mo></mrow><mo fence="false" rspace="0.667em" stretchy="false">|</mo><mi>ϕ</mi><mo>∈</mo><msub><mi>B</mi><mi>d</mi></msub><mo>,</mo><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi>C</mi><mi>ϕ</mi></msub><mo stretchy="false">→</mo><mi>X</mi><mo rspace="0.667em">,</mo><mi>F</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><mi>d</mi></msub><mo rspace="0.500em" stretchy="false">)</mo></mrow><mi>is</mi><mi>a</mi><mi>basis</mi><mi>of</mi><msup><mi>H</mi><mn>0</mn></msup><mrow><mo stretchy="false">(</mo><msub><mi>L</mi><mrow><mi>u</mi><mo>,</mo><mi mathvariant="normal">Ω</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\rm Map}_{d}^{\rm fr}=\Big\{(\phi,u,F)\ |\ \phi\in B_{d},u:C_{\phi}\to X,\ F=(f_{0},\ldots,f_{d})\ {\rm is\ a\ basis\ of\ }H^{0}(L_{u,\Omega})\Big\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.SS2.p3.2" class="ltx_p"><span id="S21.SS2.p3.2.1" class="ltx_text">Choose a group reduction scheme <math id="S21.SS2.p3.m4" class="ltx_Math" alttext="\lambda_{d}:{\rm Map}_{d}^{\rm fr}\to Q_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>d</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>Map</mi><mi>d</mi><mi>fr</mi></msubsup><mo stretchy="false">→</mo><msub><mi>Q</mi><mi>d</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\lambda_{d}:{\rm Map}_{d}^{\rm fr}\to Q_{d}</annotation></semantics></math> and a transverse perturbation</span></p>
<table id="S21.Ex26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex26.m1" class="ltx_Math" alttext="\iota:W\to\Gamma_{c}(\mathring{C}_{d}\times X,\Lambda^{0,1}_{\mathring{C}_{d}/B_{d}}\otimes TX)." display="block" intent=":literal"><semantics><mrow><mrow><mi>ι</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>W</mi><mo stretchy="false">→</mo><mrow><msub><mi mathvariant="normal">Γ</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>C</mi><mo>̊</mo></mover><mi>d</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>X</mi></mrow><mo>,</mo><mrow><mrow><msubsup><mi mathvariant="normal">Λ</mi><mrow><msub><mover accent="true"><mi>C</mi><mo>̊</mo></mover><mi>d</mi></msub><mo>/</mo><msub><mi>B</mi><mi>d</mi></msub></mrow><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>T</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>X</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\iota:W\to\Gamma_{c}(\mathring{C}_{d}\times X,\Lambda^{0,1}_{\mathring{C}_{d}/B_{d}}\otimes TX).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.SS2.p3.3" class="ltx_p"><span id="S21.SS2.p3.3.1" class="ltx_text">This induces a topological Kuranishi space</span></p>
<table id="S21.Ex27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex27.m1" class="ltx_Math" alttext="K_{d}=(G_{d},V_{d},E_{d},S_{d})" display="block" intent=":literal"><semantics><mrow><msub><mi>K</mi><mi>d</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>d</mi></msub><mo>,</mo><msub><mi>V</mi><mi>d</mi></msub><mo>,</mo><msub><mi>E</mi><mi>d</mi></msub><mo>,</mo><msub><mi>S</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K_{d}=(G_{d},V_{d},E_{d},S_{d})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.SS2.p3.4" class="ltx_p"><span id="S21.SS2.p3.4.1" class="ltx_text">with ambient space</span></p>
<table id="S21.Ex28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex28.m1" class="ltx_math_unparsed" alttext="V_{d}=\Big\{(\phi,u,F,e)\ |\ (\phi,u,F)\in{\rm Map}_{d},\ e\in W_{a},\ \phi=\phi_{F}\in B_{d},\ \overline{\partial}_{J}u+\iota(e)=0\Big\}," display="block" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi>d</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>F</mi><mo>,</mo><mi>e</mi><mo rspace="0.500em" stretchy="false">)</mo></mrow><mo fence="false" rspace="0.667em" stretchy="false">|</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>F</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi>Map</mi><mi>d</mi></msub><mo rspace="0.667em">,</mo><mi>e</mi><mo>∈</mo><msub><mi>W</mi><mi>a</mi></msub><mo rspace="0.667em">,</mo><mi>ϕ</mi><mo>=</mo><msub><mi>ϕ</mi><mi>F</mi></msub><mo>∈</mo><msub><mi>B</mi><mi>d</mi></msub><mo rspace="0.500em">,</mo><msub><mover accent="true"><mo>∂</mo><mo stretchy="true">¯</mo></mover><mi>J</mi></msub><mi>u</mi><mo>+</mo><mi>ι</mi><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mn>0</mn><mo stretchy="false">}</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">V_{d}=\Big\{(\phi,u,F,e)\ |\ (\phi,u,F)\in{\rm Map}_{d},\ e\in W_{a},\ \phi=\phi_{F}\in B_{d},\ \overline{\partial}_{J}u+\iota(e)=0\Big\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.SS2.p3.5" class="ltx_p"><span id="S21.SS2.p3.5.1" class="ltx_text">obstruction bundle <math id="S21.SS2.p3.m5" class="ltx_Math" alttext="E_{d}=W\oplus Q_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mi>d</mi></msub><mo>=</mo><mrow><mi>W</mi><mo>⊕</mo><msub><mi>Q</mi><mi>d</mi></msub></mrow></mrow><annotation encoding="application/x-tex">E_{d}=W\oplus Q_{d}</annotation></semantics></math>, and Kuranishi section</span></p>
<table id="S21.Ex29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex29.m1" class="ltx_Math" alttext="S_{d}(\phi,u,F,e)=(e,\lambda_{d}(\phi,u,F))." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>S</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>F</mi><mo>,</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo>,</mo><mrow><msub><mi>λ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">S_{d}(\phi,u,F,e)=(e,\lambda_{d}(\phi,u,F)).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.SS2.p3.6" class="ltx_p"><span id="S21.SS2.p3.6.1" class="ltx_text">It also comes with a ref-<math id="S21.SS2.p3.m6" class="ltx_Math" alttext="C^{\infty,1}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mrow><mi mathvariant="normal">∞</mi><mo>,</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">C^{\infty,1}</annotation></semantics></math>-structure on <math id="S21.SS2.p3.m7" class="ltx_Math" alttext="V_{d}/B_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi>d</mi></msub><mo>/</mo><msub><mi>B</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">V_{d}/B_{d}</annotation></semantics></math> as well as continuous evaluation maps <math id="S21.SS2.p3.m8" class="ltx_Math" alttext="{\rm ev}_{\pm}:V_{d}\to X" display="inline" intent=":literal"><semantics><mrow><msub><mi>ev</mi><mo>±</mo></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>V</mi><mi>d</mi></msub><mo stretchy="false">→</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">{\rm ev}_{\pm}:V_{d}\to X</annotation></semantics></math>. Then using Lemma <a href="#S21.Thmthm4" title="Lemma 21.4 (Stable smoothing with maps). ‣ 21.1.1. Fibered topological spaces, Kuranishi spaces, and derived orbifolds ‣ 21.1. Pearly flow category ‣ 21. AMS Construction for Other Flow categories, Multimodules, and Homotopies ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21.4</span></a>, one can find a stable smoothing of <math id="S21.SS2.p3.m9" class="ltx_Math" alttext="V_{d}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>d</mi></msub><annotation encoding="application/x-tex">V_{d}</annotation></semantics></math> making the evaluation maps submersive.</span></p>
</div>
<div id="S21.SS2.p4" class="ltx_para">
<p id="S21.SS2.p4.1" class="ltx_p"><span id="S21.SS2.p4.1.1" class="ltx_text">Last, using the submersiveness of the evaluation maps, one obtains a lift of the bimodule <math id="S21.SS2.p4.m1" class="ltx_Math" alttext="\mathbb{\Delta}^{\mathbb{MM}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{\Delta}^{\mathbb{MM}}</annotation></semantics></math> by taking fiber products with stable/unstable manifolds of the Morse flow.
∎</span></p>
</div>
</div>
<div id="S21.Thmthm7" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S21.Thmthm7.2" class="ltx_text ltx_font_italic">Remark 21.7</span></span><span id="S21.Thmthm7.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S21.Thmthm7.p1" class="ltx_para">
<p id="S21.Thmthm7.p1.1" class="ltx_p">In <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib57" title="" class="ltx_ref">14</a>]</cite> one considered the Morse-to-Floer and Floer-to-Morse bimodules and their concatenation along the Floer flow category. However, their concatenation along the Morse flow category is difficult to regularize (the codimension two gluing is hard to fit into the framework of flow bimodules). In this paper, we do not consider these two bimodules and their concatenations. The Morse-to-Morse bimodule will arise from the concatenations of the Morse-to-Pearly and the Pearly-to-Morse bimodules, whose regularization will be addressed later.</p>
</div>
</div>
</section>
<section id="S21.SS3" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">21.3. </span>Pearly-to-Morse and Morse-to-Pearly bimodules</h4>

<div id="S21.SS3.p1" class="ltx_para ltx_noindent">
<p id="S21.SS3.p1.1" class="ltx_p">In this subsection we regularize the two bimodules shown in the title. To simplify the notations, we will only use a single integral symplectic form <math id="S21.SS3.p1.m1" class="ltx_Math" alttext="\Omega\in\Omega^{2}(X)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>∈</mo><mrow><msup><mi mathvariant="normal">Ω</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Omega\in\Omega^{2}(X)</annotation></semantics></math> which is a multiple of a rational approximation of <math id="S21.SS3.p1.m2" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math> which also tames <math id="S21.SS3.p1.m3" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math>. The case with different choices of <math id="S21.SS3.p1.m4" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math> can be discussed in a similar way as the case of pair-of-pants multimodules.</p>
</div>
<section id="S21.SS3.SSS1" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">21.3.1. </span>The domains</h5>

<div id="S21.SS3.SSS1.p1" class="ltx_para ltx_noindent">
<p id="S21.SS3.SSS1.p1.1" class="ltx_p">The model for the Morse flow category can be viewed as a monotone flow category over the trivial monoid <math id="S21.SS3.SSS1.p1.m1" class="ltx_Math" alttext="\{0\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{0\}</annotation></semantics></math>. Let such a trivial monotone flow category be <math id="S21.SS3.SSS1.p1.m2" class="ltx_Math" alttext="\mathbb{o}" display="inline" intent=":literal"><semantics><mi>𝕠</mi><annotation encoding="application/x-tex">\mathbb{o}</annotation></semantics></math>, which has only one object <math id="S21.SS3.SSS1.p1.m3" class="ltx_Math" alttext="M_{0}^{\mathbb{o}}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mn>0</mn><mi>𝕠</mi></msubsup><annotation encoding="application/x-tex">M_{0}^{\mathbb{o}}</annotation></semantics></math> chosen to be a singleton in the category <math id="S21.SS3.SSS1.p1.m4" class="ltx_Math" alttext="\underline{\smash{\bf Curve}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>𝐂𝐮𝐫𝐯𝐞</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\bf Curve}}</annotation></semantics></math>. We would like to define a monotone flow bimodule over <math id="S21.SS3.SSS1.p1.m5" class="ltx_Math" alttext="{\mathbb{Z}}_{\geq 0}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">{\mathbb{Z}}_{\geq 0}</annotation></semantics></math>. For each <math id="S21.SS3.SSS1.p1.m6" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>, we consider the family of curves</p>
<table id="S21.Ex30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex30.m1" class="ltx_Math" alttext="{\mathcal{C}}_{d}^{\mathbb{PM}}=({\mathcal{G}}_{d},B_{d}^{\mathbb{PM}},C_{d}^{\mathbb{PM}})" display="block" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>d</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msubsup><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>d</mi></msub><mo>,</mo><msubsup><mi>B</mi><mi>d</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msubsup><mo>,</mo><msubsup><mi>C</mi><mi>d</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{C}}_{d}^{\mathbb{PM}}=({\mathcal{G}}_{d},B_{d}^{\mathbb{PM}},C_{d}^{\mathbb{PM}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.SS3.SSS1.p1.2" class="ltx_p">where the space of curves <math id="S21.SS3.SSS1.p1.m7" class="ltx_Math" alttext="B_{d}^{\mathbb{PM}}" display="inline" intent=":literal"><semantics><msubsup><mi>B</mi><mi>d</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msubsup><annotation encoding="application/x-tex">B_{d}^{\mathbb{PM}}</annotation></semantics></math> in <math id="S21.SS3.SSS1.p1.m8" class="ltx_Math" alttext="\mathbb{CP}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathbb{CP}^{d}</annotation></semantics></math> is different from previous cases. Indeed, consider the moduli space of parametrized holomorphic cylinders</p>
<table id="S21.Ex31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex31.m1" class="ltx_Math" alttext="u:{\mathbb{R}}\times S^{1}\to\mathbb{CP}^{d}" display="block" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>ℝ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>S</mi><mn>1</mn></msup></mrow><mo stretchy="false">→</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">u:{\mathbb{R}}\times S^{1}\to\mathbb{CP}^{d}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.SS3.SSS1.p1.3" class="ltx_p">of degree <math id="S21.SS3.SSS1.p1.m9" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>. When compactifying this space, the bubbling near the negative and positive ends is treated differently. Near the negative ends, the broken pieces are considered modulo only the real translation; near the positive end, the broken pieces are considered modulo <math id="S21.SS3.SSS1.p1.m10" class="ltx_Math" alttext="{\mathbb{C}}^{*}" display="inline" intent=":literal"><semantics><msup><mi>ℂ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">{\mathbb{C}}^{*}</annotation></semantics></math>, i.e., translations and rotations. The domain of a point in the compactification still has two distinguished points: <math id="S21.SS3.SSS1.p1.m11" class="ltx_Math" alttext="z_{-}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mo>−</mo></msub><annotation encoding="application/x-tex">z_{-}</annotation></semantics></math> and <math id="S21.SS3.SSS1.p1.m12" class="ltx_Math" alttext="z_{+}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mo>+</mo></msub><annotation encoding="application/x-tex">z_{+}</annotation></semantics></math>. Then let <math id="S21.SS3.SSS1.p1.m13" class="ltx_Math" alttext="B_{d}^{\mathbb{PM}}" display="inline" intent=":literal"><semantics><msubsup><mi>B</mi><mi>d</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msubsup><annotation encoding="application/x-tex">B_{d}^{\mathbb{PM}}</annotation></semantics></math> be the subspace in the compactification satisfying 1) the image is not contained in any hyperplane and 2) the map satisfies the positive:</p>
<table id="S21.Ex32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex32.m1" class="ltx_Math" alttext="u(z_{+})=[0,0,\ldots,0,1]\in{\mathbb{P}}^{d}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mo>∈</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">u(z_{+})=[0,0,\ldots,0,1]\in{\mathbb{P}}^{d}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S21.SS3.SSS1.p2" class="ltx_para ltx_noindent">
<p id="S21.SS3.SSS1.p2.1" class="ltx_p">The structural map of this bimodule only contains the negative part as we view it as a bimodule with one side the trivial flow category: namely, given <math id="S21.SS3.SSS1.p2.m1" class="ltx_Math" alttext="d,d^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>,</mo><msup><mi>d</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">d,d^{\prime}</annotation></semantics></math>, there is a morphism</p>
<table id="S21.Ex33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex33.m1" class="ltx_Math" alttext="{\mathcal{C}}_{d}\times{\mathcal{C}}_{d^{\prime}}^{\mathbb{PM}}\to{\mathcal{C}}_{d+d^{\prime}}^{\mathbb{PM}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>d</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><msup><mi>d</mi><mo>′</mo></msup><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msubsup></mrow><mo stretchy="false">→</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mi>d</mi><mo>+</mo><msup><mi>d</mi><mo>′</mo></msup></mrow><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msubsup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{C}}_{d}\times{\mathcal{C}}_{d^{\prime}}^{\mathbb{PM}}\to{\mathcal{C}}_{d+d^{\prime}}^{\mathbb{PM}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.SS3.SSS1.p2.2" class="ltx_p">The construction is similar to before and hence skipped. One can check that the collection of equivariant families of curves <math id="S21.SS3.SSS1.p2.m2" class="ltx_Math" alttext="\mathcal{C}_{d}^{\mathbb{PM}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>d</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msubsup><annotation encoding="application/x-tex">\mathcal{C}_{d}^{\mathbb{PM}}</annotation></semantics></math> defines a monotone bimodule.</p>
</div>
</section>
<section id="S21.SS3.SSS2" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">21.3.2. </span>Cylinders in <math id="S21.SS3.SSS2.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math></h5>

<div id="S21.SS3.SSS2.p1" class="ltx_para ltx_noindent">
<p id="S21.SS3.SSS2.p1.1" class="ltx_p">We would like to construct monotone bimodules enriched in <math id="S21.SS3.SSS2.p1.m1" class="ltx_Math" alttext="\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}(X)" display="inline" intent=":literal"><semantics><mrow><msubsup><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><mi>rig</mi><mi>NC</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}(X)</annotation></semantics></math>. For the Morse side, there is still the trivial monotone flow category with a single object whose only morphism space is the singleton, i.e., the triple</p>
<table id="S21.Ex34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex34.m1" class="ltx_Math" alttext="(X,{\rm Id},{\rm Id})" display="block" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>Id</mi><mo>,</mo><mi>Id</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(X,{\rm Id},{\rm Id})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.SS3.SSS2.p1.2" class="ltx_p">where <math id="S21.SS3.SSS2.p1.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is regarded as a normally complex derived orbifold. On the other hand, one has constructed the lift <math id="S21.SS3.SSS2.p1.m3" class="ltx_Math" alttext="\widetilde{\mathbb{cyl}}(X)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mrow><mi>𝕔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi></mrow><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\mathbb{cyl}}(X)</annotation></semantics></math> of <math id="S21.SS3.SSS2.p1.m4" class="ltx_Math" alttext="\mathbb{cyl}(X)" display="inline" intent=":literal"><semantics><mrow><mi>𝕔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{cyl}(X)</annotation></semantics></math> to <math id="S21.SS3.SSS2.p1.m5" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf dOrb}}^{\rm NC}_{\rm rig}(X)" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><mi>rig</mi><mi>NC</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf dOrb}}^{\rm NC}_{\rm rig}(X)</annotation></semantics></math>. By considering parametrized cylinders in <math id="S21.SS3.SSS2.p1.m6" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>, one can easily formulate a monotone bimodule</p>
<table id="S21.Ex35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex35.m1" class="ltx_Math" alttext="\mathbb{cyl}^{\mathbb{PM}}(X)" display="block" intent=":literal"><semantics><mrow><mi>𝕔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝕝</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{cyl}^{\mathbb{PM}}(X)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S21.SS3.SSS2.p1.3" class="ltx_p">over <math id="S21.SS3.SSS2.p1.m7" class="ltx_Math" alttext="(\mathbb{cyl}(X);\mathbb{o})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>𝕔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>;</mo><mi>𝕠</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbb{cyl}(X);\mathbb{o})</annotation></semantics></math> consisting of moduli spaces of parametrized cylinders in <math id="S21.SS3.SSS2.p1.m8" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> with two marked points where the compactification at negative and positive marked points is taken differently.</p>
</div>
<div id="S21.Thmthm8" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S21.Thmthm8.2" class="ltx_text ltx_font_bold">Proposition 21.8</span></span><span id="S21.Thmthm8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S21.Thmthm8.p1" class="ltx_para">
<p id="S21.Thmthm8.p1.1" class="ltx_p"><span id="S21.Thmthm8.p1.1.1" class="ltx_text ltx_font_italic">Given an AMS lift <math id="S21.Thmthm8.p1.m1" class="ltx_Math" alttext="\widetilde{\mathbb{cyl}}(X)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mrow><mi>𝕔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi></mrow><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\mathbb{cyl}}(X)</annotation></semantics></math> of the outercollaring <math id="S21.Thmthm8.p1.m2" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{cyl}(X)" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><mi>𝕔</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mi>𝕪</mi><mi>𝕝</mi><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{cyl}(X)</annotation></semantics></math>, there exists a lift of the outercollaring <math id="S21.Thmthm8.p1.m3" class="ltx_math_unparsed" alttext="{}_{\lfloor}\mathbb{cyl}{}^{\mathbb{PM}}(X)" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><mi>𝕔</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mi>𝕪</mi><mi>𝕝</mi><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mprescripts></mprescripts><mrow></mrow><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\mathbb{cyl}{}^{\mathbb{PM}}(X)</annotation></semantics></math> to <math id="S21.Thmthm8.p1.m4" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf dOrb}}^{\rm NC}_{\rm rig}(X)" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><mi>rig</mi><mi>NC</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf dOrb}}^{\rm NC}_{\rm rig}(X)</annotation></semantics></math>, denoted by <math id="S21.Thmthm8.p1.m5" class="ltx_math_unparsed" alttext="\widetilde{\mathbb{cyl}}{}^{\mathbb{PM}}(X)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mrow><mi>𝕔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi></mrow><mo>~</mo></mover><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mprescripts></mprescripts><mrow></mrow><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">\widetilde{\mathbb{cyl}}{}^{\mathbb{PM}}(X)</annotation></semantics></math>, as a monotone bimodule over <math id="S21.Thmthm8.p1.m6" class="ltx_Math" alttext="(\widetilde{\mathbb{cyl}}(X);\mathbb{o})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mrow><mi>𝕔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi></mrow><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>;</mo><mi>𝕠</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\widetilde{\mathbb{cyl}}(X);\mathbb{o})</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S21.SS3.SSS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Sketch of Proof.</h6>
<div id="S21.SS3.SSS2.p2" class="ltx_para">
<p id="S21.SS3.SSS2.p2.1" class="ltx_p"><span id="S21.SS3.SSS2.p2.1.1" class="ltx_text">It is completely parallel to the proof of Proposition <a href="#S21.Thmthm5" title="Proposition 21.5. ‣ 21.1.2. The monotone flow category of holomorphic cylinders ‣ 21.1. Pearly flow category ‣ 21. AMS Construction for Other Flow categories, Multimodules, and Homotopies ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21.5</span></a>.
∎</span></p>
</div>
</div>
<div id="S21.Thmthm9" class="ltx_theorem ltx_theorem_cor">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S21.Thmthm9.2" class="ltx_text ltx_font_bold">Corollary 21.9</span></span><span id="S21.Thmthm9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S21.Thmthm9.p1" class="ltx_para">
<p id="S21.Thmthm9.p1.1" class="ltx_p"><span id="S21.Thmthm9.p1.1.1" class="ltx_text ltx_font_italic">Given an AMS lift <math id="S21.Thmthm9.p1.m1" class="ltx_Math" alttext="\tilde{\mathbb{P}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ℙ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{P}}</annotation></semantics></math> of the pearly flow category <math id="S21.Thmthm9.p1.m2" class="ltx_Math" alttext="{\mathbb{P}}" display="inline" intent=":literal"><semantics><mi>ℙ</mi><annotation encoding="application/x-tex">{\mathbb{P}}</annotation></semantics></math> subject to a fixed outercollaring width and an integral symplectic form, there exists a lift <math id="S21.Thmthm9.p1.m3" class="ltx_Math" alttext="\tilde{\mathbb{B}}^{\mathbb{PM}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝔹</mi><mo>~</mo></mover><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msup><annotation encoding="application/x-tex">\tilde{\mathbb{B}}^{\mathbb{PM}}</annotation></semantics></math> resp. <math id="S21.Thmthm9.p1.m4" class="ltx_Math" alttext="\tilde{\mathbb{B}}^{\mathbb{MP}}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>𝔹</mi><mo>~</mo></mover><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><annotation encoding="application/x-tex">\tilde{\mathbb{B}}^{\mathbb{MP}}</annotation></semantics></math> of the corresponding collaring of <math id="S21.Thmthm9.p1.m5" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{PM}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{PM}}</annotation></semantics></math> resp. <math id="S21.Thmthm9.p1.m6" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{MP}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{MP}}</annotation></semantics></math> to <math id="S21.Thmthm9.p1.m7" class="ltx_math_unparsed" alttext="{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mo stretchy="false">⌊</mo></msub><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>rig</mi></msub><msup><mrow></mrow><mi>NC</mi></msup></mrow><annotation encoding="application/x-tex">{}_{\lfloor}\underline{\smash{\bf dOrb}}_{\rm rig}^{\rm NC}</annotation></semantics></math> as a bimodule over <math id="S21.Thmthm9.p1.m8" class="ltx_math_unparsed" alttext="(\tilde{\mathbb{P}};{}_{\lfloor}\mathbb{M})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>ℙ</mi><mo>~</mo></mover><mo>;</mo><mmultiscripts><mi>𝕄</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\tilde{\mathbb{P}};{}_{\lfloor}\mathbb{M})</annotation></semantics></math> resp. over <math id="S21.Thmthm9.p1.m9" class="ltx_math_unparsed" alttext="({}_{\lfloor}{\mathbb{M}};\tilde{\mathbb{P}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mmultiscripts><mi>𝕄</mi><mprescripts></mprescripts><mo stretchy="false">⌊</mo><mrow></mrow></mmultiscripts><mo>;</mo><mover accent="true"><mi>ℙ</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({}_{\lfloor}{\mathbb{M}};\tilde{\mathbb{P}})</annotation></semantics></math>. Moreover, any two such lifts are homotopic.</span></p>
</div>
</div>
<div id="S21.SS3.SSS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S21.SS3.SSS2.p3" class="ltx_para">
<p id="S21.SS3.SSS2.p3.1" class="ltx_p"><span id="S21.SS3.SSS2.p3.1.1" class="ltx_text">We work over the domain bimodule <math id="S21.SS3.SSS2.p3.m1" class="ltx_math_unparsed" alttext="\widetilde{\mathbb{cyl}}{}^{\mathbb{PM}}(X)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mrow><mi>𝕔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi></mrow><mo>~</mo></mover><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mprescripts></mprescripts><mrow></mrow><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">\widetilde{\mathbb{cyl}}{}^{\mathbb{PM}}(X)</annotation></semantics></math> (and in parallel <math id="S21.SS3.SSS2.p3.m2" class="ltx_Math" alttext="\widetilde{\mathbb{cyl}}{\mathbb{MP}}(X)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mrow><mi>𝕔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi></mrow><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\mathbb{cyl}}{\mathbb{MP}}(X)</annotation></semantics></math>). Extend thickening data used in the construction of <math id="S21.SS3.SSS2.p3.m3" class="ltx_Math" alttext="\tilde{\mathbb{P}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ℙ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mathbb{P}}</annotation></semantics></math> to thickening data over <math id="S21.SS3.SSS2.p3.m4" class="ltx_Math" alttext="\widetilde{\mathbb{cyl}}{\mathbb{PM}}(X)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mrow><mi>𝕔</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕪</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕝</mi></mrow><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\mathbb{cyl}}{\mathbb{PM}}(X)</annotation></semantics></math>. The construction of NC structures and stable smoothing can all be reproduced in the same way as before. This provides the AMS lifts of outercollarings of <math id="S21.SS3.SSS2.p3.m5" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{PM}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝕄</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{PM}}</annotation></semantics></math> and <math id="S21.SS3.SSS2.p3.m6" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{MP}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><mi>𝕄</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{MP}}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="S21.SS4" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">21.4. </span>Pearly-to-Floer and Floer-to-Pearly bimodules</h4>

<div id="S21.SS4.p1" class="ltx_para ltx_noindent">
<p id="S21.SS4.p1.1" class="ltx_p">The AMS constructions for the bimodules <math id="S21.SS4.p1.m1" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{FP}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><mi>𝔽</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{FP}}</annotation></semantics></math> and <math id="S21.SS4.p1.m2" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{PF}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{PF}}</annotation></semantics></math> are slight variants of that for <math id="S21.SS4.p1.m3" class="ltx_Math" alttext="\mathbb{\Delta}^{\mathbb{PP}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_mathvariant_double-struck" mathvariant="double-struck">Δ</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{\Delta}^{\mathbb{PP}}</annotation></semantics></math>. We describe in detail the construction for <math id="S21.SS4.p1.m4" class="ltx_Math" alttext="\mathbb{B}^{\mathbb{PF}}" display="inline" intent=":literal"><semantics><msup><mi>𝔹</mi><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝔽</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{B}^{\mathbb{PF}}</annotation></semantics></math>.</p>
</div>
<section id="S21.SS4.SSS1" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">21.4.1. </span>A new category of fibered spaces</h5>

<div id="S21.SS4.SSS1.p1" class="ltx_para ltx_noindent">
<p id="S21.SS4.SSS1.p1.1" class="ltx_p">In order to deal with the mixture of fiber products (in the Pearly part) and direct products (in the Floer part), we introduce the space <math id="S21.SS4.SSS1.p1.m1" class="ltx_Math" alttext="X^{+}=X\sqcup\{{\rm pt}\}" display="inline" intent=":literal"><semantics><mrow><msup><mi>X</mi><mo>+</mo></msup><mo>=</mo><mrow><mi>X</mi><mo>⊔</mo><mrow><mo stretchy="false">{</mo><mi>pt</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X^{+}=X\sqcup\{{\rm pt}\}</annotation></semantics></math> which is a smooth manifold of mixed dimensions. Then similar to Definition <a href="#S21.Thmthm1" title="Definition 21.1. ‣ 21.1.1. Fibered topological spaces, Kuranishi spaces, and derived orbifolds ‣ 21.1. Pearly flow category ‣ 21. AMS Construction for Other Flow categories, Multimodules, and Homotopies ‣ Part III THE AMS CONSTRUCTION ‣ Integral Hamiltonian Floer Theory: Foundations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21.1</span></a>, one can consider the category <math id="S21.SS4.SSS1.p1.m2" class="ltx_Math" alttext="\underline{\smash{\bf Top}}(X^{+})" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>𝐓𝐨𝐩</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\underline{\smash{\bf Top}}(X^{+})</annotation></semantics></math> whose objects are spaces with continuous maps to <math id="S21.SS4.SSS1.p1.m3" class="ltx_Math" alttext="X^{+}" display="inline" intent=":literal"><semantics><msup><mi>X</mi><mo>+</mo></msup><annotation encoding="application/x-tex">X^{+}</annotation></semantics></math>, as well as the categories <math id="S21.SS4.SSS1.p1.m4" class="ltx_Math" alttext="\underline{\smash{\bf Kur}}(X^{+})" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>𝐊𝐮𝐫</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\underline{\smash{\bf Kur}}(X^{+})</annotation></semantics></math> and <math id="S21.SS4.SSS1.p1.m5" class="ltx_Math" alttext="\underline{\smash{\bf dOrb}}(X^{+})" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>𝐝𝐎𝐫𝐛</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\underline{\smash{\bf dOrb}}(X^{+})</annotation></semantics></math>. Then there are natural functors</p>
<table id="S21.Ex36" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S21.Ex36.m1" class="ltx_Math" alttext="\vbox{\lx@xy@svg{\hbox{\raise 0.0pt\hbox{\kern 13.7361pt\hbox{\ignorespaces\ignorespaces\ignorespaces\hbox{\vtop{\halign{\entry@#!@&amp;&amp;\entry@@#!@\cr&amp;&amp;\cr&amp;&amp;\crcr}}}\ignorespaces{\hbox{\kern-13.7361pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\underline{\smash{\bf Top}}(X)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces{}\ignorespaces\ignorespaces{\hbox{\lx@xy@drawline@}}\ignorespaces{\hbox{\kern 40.41243pt\raise-23.76886pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}\ignorespaces\ignorespaces{\hbox{\lx@xy@drawline@}}\ignorespaces{\hbox{\lx@xy@drawline@}}{\hbox{\kern 51.79166pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{}$}}}}}}}{\hbox{\kern 95.84721pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\underline{\smash{\bf Top}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces{}\ignorespaces\ignorespaces{\hbox{\lx@xy@drawline@}}\ignorespaces{\hbox{\kern 67.014pt\raise-23.76886pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}\ignorespaces\ignorespaces{\hbox{\lx@xy@drawline@}}\ignorespaces{\hbox{\lx@xy@drawline@}}{\hbox{\kern-3.0pt\raise-32.23112pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{}$}}}}}}}{\hbox{\kern 37.7361pt\raise-32.23112pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\underline{\smash{\bf Top}}(X^{+})}$}}}}}}}{\hbox{\kern 98.34721pt\raise-32.23112pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{}$}}}}}}}\ignorespaces}}}}}." display="block" intent=":literal"><semantics><mrow><mtext> <svg style="vertical-al