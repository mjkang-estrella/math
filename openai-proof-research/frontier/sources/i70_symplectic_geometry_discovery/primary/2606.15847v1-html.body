pic1.m6" class="ltx_Math" alttext="\scriptstyle{\Phi^{\rm PD}}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.700em" mathvariant="normal">Φ</mi><mi mathsize="0.710em">PD</mi></msup><annotation encoding="application/x-tex">\scriptstyle{\Phi^{\rm PD}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(262.34,0) translate(0,-32.58)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 262.0576357336745 -32.57765188675064 L 262.61110729377464 -11.14645356605438" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 262.0576357336745 -32.57765188675064 L 262.61110729377464 -32.57765188675064" fill="none" stroke="#000000"></path><g transform="translate(-75.11,0) translate(0,-44.83) translate(4.15,0) translate(0,-3.54)"><foreignObject style="--ltx-fo-width:10.26em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="141.91"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.Ex14.m1.pic1.m7" class="ltx_Math" alttext="\textstyle{HF_{*}(X,\omega)\widehat{\underset{\Lambda^{\Pi}}{\otimes}}HF_{*}(X,\omega)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>ω</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.222em" rspace="0em">​</mo><munderover accent="true" accentunder="true"><mo>⊗</mo><msup><mi mathsize="0.700em" mathvariant="normal">Λ</mi><mi mathsize="0.710em" mathvariant="normal">Π</mi></msup><mo>^</mo></munderover><mo lspace="0.222em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>ω</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{HF_{*}(X,\omega)\widehat{\underset{\Lambda^{\Pi}}{\otimes}}HF_{*}(X,\omega)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 75.10731951633198 -45.109431212813064 L 75.10731951633198 -44.555959652712914" fill="none" stroke="#000000"></path><g transform="translate(147,0) translate(0,-53.42) translate(4.15,0) translate(0,-4.44)"><foreignObject style="--ltx-fo-width:1.57em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.88" overflow="visible" transform="matrix(1 0 0 -1 0 8.88)" width="21.76"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.Ex14.m1.pic1.m8" class="ltx_Math" alttext="\scriptstyle{\Phi^{\rm PD}}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.700em" mathvariant="normal">Φ</mi><mi mathsize="0.710em">PD</mi></msup><annotation encoding="application/x-tex">\scriptstyle{\Phi^{\rm PD}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(248.95,0) translate(0,-44.83)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 75.10731951633198 -45.109431212813064 L 248.94896987993158 -44.555959652712914" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 248.94896987993158 -45.109431212813064 L 248.94896987993158 -44.555959652712914" fill="none" stroke="#000000"></path><g transform="translate(248.95,0) translate(0,-44.83) translate(4.15,0) translate(0,-3.54)"><foreignObject style="--ltx-fo-width:1.33em;--ltx-fo-height:0.84em;--ltx-fo-depth:0em;font-size:10pt;" height="11.64" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="18.47"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.Ex14.m1.pic1.m10" class="ltx_Math" alttext="\textstyle{\Lambda^{\Pi}}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Λ</mi><mi mathvariant="normal">Π</mi></msup><annotation encoding="application/x-tex">\textstyle{\Lambda^{\Pi}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
