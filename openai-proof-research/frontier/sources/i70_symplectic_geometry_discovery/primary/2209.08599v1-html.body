29239946014 -12.491705738625553 L 74.11639555470155 -12.491705738625553" fill="none" stroke="#000000"></path> <g transform="translate(73.84,0) translate(0,-34.36)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M 73.5629239946014 -34.354993609846325 L 74.11639555470155 -12.491705738625553" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 73.5629239946014 -34.354993609846325 L 74.11639555470155 -34.354993609846325" fill="none" stroke="#000000"></path> <g transform="translate(-22.35,0) translate(0,-44.43) translate(4.15,0) translate(0,-3.54)"> <foreignObject style="--ltx-fo-width:2.63em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.29em;font-size:10pt;" height="15.71" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="36.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>Floer</mi></msubsup></span></span></foreignObject> </g> <path style="--ltx-stroke-color:#000000;" d="M 22.350673905147364 -44.70198121789384 L 22.350673905147364 -44.14850965779369" fill="none" stroke="#000000"></path> <g transform="translate(30.25,0) translate(0,-51.94) translate(4.15,0) translate(0,-3.36)"> <foreignObject style="--ltx-fo-width:0.36em;--ltx-fo-height:0.49em;--ltx-fo-depth:0em;font-size:10pt;" height="6.73" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="5.03"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mi mathsize="0.700em">δ</mi></span></span></foreignObject> </g> <g transform="translate(55.97,0) translate(0,-44.43)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M 22.350673905147364 -44.70198121789384 L 55.96544628109001 -44.14850965779369" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 55.96544628109001 -44.70198121789384 L 55.96544628109001 -44.14850965779369" fill="none" stroke="#000000"></path> <g transform="translate(55.97,0) translate(0,-44.43) translate(4.15,0) translate(0,-3.54)"> <foreignObject style="--ltx-fo-width:1.98em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.35em;font-size:10pt;" height="14.26" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="27.45"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><msub><mi>𝔸</mi><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msub></span></span></foreignObject> </g> </g> </svg> </mtext><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\vbox{\lx@xy@svg{\hbox{\raise 0.0pt\hbox{\kern 16.15283pt\hbox{\ignorespaces\ignorespaces\ignorespaces\hbox{\vtop{\halign{\entry@#!@&amp;&amp;\entry@@#!@\cr&amp;\cr&amp;\crcr}}}\ignorespaces{\hbox{\kern-11.29712pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.55554pt\hbox{$\textstyle{V_{pq}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 17.50755pt\raise 5.49306pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-0.52084pt\hbox{$\scriptstyle{\pi_{pq}}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 40.15283pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 0.0pt\raise-23.17165pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 40.15283pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.55554pt\hbox{$\textstyle{B_{d_{pq}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 53.36392pt\raise-24.82835pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern-16.15283pt\raise-32.10612pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.55554pt\hbox{$\textstyle{{\mathbb{A}}_{pq}^{\rm Floer}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 21.8646pt\raise-37.53667pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-2.43056pt\hbox{$\scriptstyle{\delta}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 40.44623pt\raise-32.10612pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 40.44623pt\raise-32.10612pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.55554pt\hbox{$\textstyle{{\mathbb{A}}_{d_{pq}}}$}}}}}}}\ignorespaces}}}}}.</annotation></semantics></math></td>
