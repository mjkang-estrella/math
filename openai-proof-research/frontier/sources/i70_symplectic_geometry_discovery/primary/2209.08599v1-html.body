" fill="none" stroke="#000000"></path><g transform="translate(106.32,0) translate(0,-43.36) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.6em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.29em;font-size:10pt;" height="13.41" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="22.19"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E6.m1.pic1.m9" class="ltx_Math" alttext="\textstyle{{\mathcal{U}}_{pq}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\textstyle{{\mathcal{U}}_{pq}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(138.17,0) translate(0,-21.68) translate(4.15,0) translate(0,-1.94)"><foreignObject style="--ltx-fo-width:1.21em;--ltx-fo-height:0.48em;--ltx-fo-depth:0.2em;font-size:10pt;" height="9.35" overflow="visible" transform="matrix(1 0 0 -1 0 6.62)" width="16.73"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E6.m1.pic1.m10" class="ltx_Math" alttext="\scriptstyle{{\mathcal{S}}_{pq}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.700em">𝒮</mi><mrow><mi mathsize="0.710em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">q</mi></mrow></msub><annotation encoding="application/x-tex">\scriptstyle{{\mathcal{S}}_{pq}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(134.56,0) translate(0,-11.57)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 1.7 -7.26" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 6.23 -4.08" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 121.56614116469706 -43.355905615443824 C 143.70534138608906 -28.903908925513697 143.70534138608906 -14.451954462756849 121.56614116469706 0" fill="none" stroke="#000000"></path></g></svg></span>
