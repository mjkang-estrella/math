{\mathcal{P}}^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>′</mo></msup></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>𝔸</mi><mrow><msup><mi>q</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msubsup></mrow><annotation encoding="application/x-tex">\textstyle{{\mathbb{A}}_{pq^{\prime}}\times{\mathbb{A}}_{q^{\prime}p^{\prime}}^{{\mathcal{P}}^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 209.63412029244716 -59.68832055843106 L 209.61513917806056 -59.70157989083904" fill="none" stroke="#000000"></path><g transform="translate(137.74,0) translate(0,-85.82)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 7.45 -0.24" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 5.56 4.96" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 209.63412029244716 -59.68832055843106 L 137.74039423018715 -85.81923435581197" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 137.7486074153889 -85.79803631482851 L 137.74039423018715 -85.81923435581197" fill="none" stroke="#000000"></path><g transform="translate(103.22,0) translate(0,-92.09) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.89em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.37em;font-size:10pt;" height="14.59" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="26.22"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex29.m1.pic1.m8" class="ltx_Math" alttext="\textstyle{{\mathbb{A}}_{pp^{\prime}}}" display="inline" intent=":literal"><semantics><msub><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">\textstyle{{\mathbb{A}}_{pp^{\prime}}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
