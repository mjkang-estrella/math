rn 3.0pt\raise-2.5pt\hbox{$\textstyle{S_{2}^{-1}(0)/G_{2}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 78.45969pt\raise-15.99333pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-1.75pt\hbox{$\scriptstyle{\psi_{2}}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 78.45969pt\raise-24.65335pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern-7.53471pt\raise-31.98666pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{X\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 29.66556pt\raise-37.91998pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-1.92778pt\hbox{$\scriptstyle{{\rm id}_{X}}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 70.92497pt\raise-31.98666pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 70.92497pt\raise-31.98666pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{X}$}}}}}}}\ignorespaces}}}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S5.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S5.I2.i3.p1" class="ltx_para">
<p id="S5.I2.i3.p1.1" class="ltx_p">A (weak) K-chart embedding is called a (weak) open embedding if <math id="S5.I2.i3.p1.m1" class="ltx_Math" alttext="\iota_{21}" display="inline" intent=":literal"><semantics><msub><mi>ι</mi><mn>21</mn></msub><annotation encoding="application/x-tex">\iota_{21}</annotation></semantics></math> is a homeomorphism onto an open subset and <math id="S5.I2.i3.p1.m2" class="ltx_Math" alttext="\widehat{\iota}_{21}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ι</mi><mo>^</mo></mover><mn>21</mn></msub><annotation encoding="application/x-tex">\widehat{\iota}_{21}</annotation></semantics></math> is a bundle isomorphism.</p>
</div></li>
</ol>
</div>
</div>
<div id="S5.SS1.SSS3.p2" class="ltx_para">
<p id="S5.SS1.SSS3.p2.1" class="ltx_p">Notice that (weak) K-chart embeddings can be composed in an obvious way.</p>
</div>
</section>
<section id="S5.SS1.SSS4" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">5.1.4. </span>Notations</h4>

<div id="S5.Thmthm7" class="ltx_theorem ltx_theorem_notation">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm7.2" class="ltx_text ltx_font_italic">Notation 5.7</span></span><span id="S5.Thmthm7.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S5.Thmthm7.p1" class="ltx_para">
<ol id="S5.I3" class="ltx_enumerate">
<li id="S5.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S5.I3.i1.p1" class="ltx_para">
<p id="S5.I3.i1.p1.1" class="ltx_p">For each positive integer <math id="S5.I3.i1.p1.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>, let <math id="S5.I3.i1.p1.m2" class="ltx_Math" alttext="{\mathbb{A}}_{d}" display="inline" intent=":literal"><semantics><msub><mi>𝔸</mi><mi>d</mi></msub><annotation encoding="application/x-tex">{\mathbb{A}}_{d}</annotation></semantics></math> be the poset of all ordered partitions of <math id="S5.I3.i1.p1.m3" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>, i.e.,</p>
<table id="S5.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex16.m1" class="ltx_math_unparsed" alttext="{\mathbb{A}}_{d}:=\big\{(d_{0},\ldots,d_{l})\ |\ d_{0}+\cdots+d_{l}=d,\ d_{i}\in{\mathbb{Z}}_{&gt;0}\big\}." display="block" intent=":literal"><semantics><mrow><msub><mi>𝔸</mi><mi>d</mi></msub><mo>:=</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>d</mi><mi>l</mi></msub><mo rspace="0.500em" stretchy="false">)</mo></mrow><mo fence="false" rspace="0.667em" stretchy="false">|</mo><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>d</mi><mi>l</mi></msub><mo>=</mo><mi>d</mi><mo rspace="0.667em">,</mo><msub><mi>d</mi><mi>i</mi></msub><mo>∈</mo><msub><mi>ℤ</mi><mrow><mphantom></mphantom><mo>&gt;</mo><mn>0</mn></mrow></msub><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathbb{A}}_{d}:=\big\{(d_{0},\ldots,d_{l})\ |\ d_{0}+\cdots+d_{l}=d,\ d_{i}\in{\mathbb{Z}}_{&gt;0}\big\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I3.i1.p1.2" class="ltx_p">The partial order is induced from refinements of partitions. It is a homogeneous poset with a unique maximal element <math id="S5.I3.i1.p1.m4" class="ltx_Math" alttext="(d)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(d)</annotation></semantics></math> and depth function <math id="S5.I3.i1.p1.m5" class="ltx_Math" alttext="{\rm depth}(d_{0},\ldots,d_{l})=l" display="inline" intent=":literal"><semantics><mrow><mrow><mi>depth</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>d</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>l</mi></mrow><annotation encoding="application/x-tex">{\rm depth}(d_{0},\ldots,d_{l})=l</annotation></semantics></math>. Moreover, there are natural inclusions</p>
<table id="S5.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex17.m1" class="ltx_math_unparsed" alttext="{\mathbb{A}}_{d_{0}}\times\cdots\times{\mathbb{A}}_{d_{l}}\to\partial^{(d_{0},\ldots,d_{l})}{\mathbb{A}}_{d_{0}+\cdots+d_{l}}" display="block" intent=":literal"><semantics><mrow><mi>𝔸</mi><msub><mrow></mrow><msub><mi>d</mi><mn>0</mn></msub></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi>𝔸</mi><msub><mrow></mrow><msub><mi>d</mi><mi>l</mi></msub></msub><mo rspace="0.111em" stretchy="false">→</mo><mo>∂</mo><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>d</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></msup><mi>𝔸</mi><msub><mrow></mrow><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>d</mi><mi>l</mi></msub></mrow></msub></mrow><annotation encoding="application/x-tex">{\mathbb{A}}_{d_{0}}\times\cdots\times{\mathbb{A}}_{d_{l}}\to\partial^{(d_{0},\ldots,d_{l})}{\mathbb{A}}_{d_{0}+\cdots+d_{l}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I3.i1.p1.3" class="ltx_p">which satisfy the obvious associativity relation.</p>
</div></li>
<li id="S5.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S5.I3.i2.p1" class="ltx_para">
<p id="S5.I3.i2.p1.1" class="ltx_p">For each pair <math id="S5.I3.i2.p1.m1" class="ltx_Math" alttext="p,q\in{\mathcal{P}}^{\rm Floer}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Floer</mi></msup></mrow><annotation encoding="application/x-tex">p,q\in{\mathcal{P}}^{\rm Floer}</annotation></semantics></math>, define</p>
<table id="S5.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E1.m1" class="ltx_Math" alttext="d_{pq}:={\mathcal{A}}^{\rm Floer}(q)-{\mathcal{A}}^{\rm Floer}(p)." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>:=</mo><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>Floer</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>Floer</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">d_{pq}:={\mathcal{A}}^{\rm Floer}(q)-{\mathcal{A}}^{\rm Floer}(p).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.1)</span></td></tr></tbody>
</table>
<p id="S5.I3.i2.p1.2" class="ltx_p">By the integrality assumption of the symplectic action (see Hypothesis <a href="#S4.Thmthm1" title="Hypothesis 4.1. ‣ 4. Proof of the integral Arnold conjecture ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>), <math id="S5.I3.i2.p1.m2" class="ltx_Math" alttext="d_{pq}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">d_{pq}</annotation></semantics></math> is an integer. In practice we only consider the situation when <math id="S5.I3.i2.p1.m3" class="ltx_Math" alttext="d_{pq}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d_{pq}\geq 0</annotation></semantics></math>. Moreover, there is a natural poset map</p>
<table id="S5.E2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E2.m1" class="ltx_Math" alttext="\begin{array}[]{rcl}\delta:{\mathbb{A}}_{pq}^{\rm Floer}&amp;\to&{\mathbb{A}}_{d_{pq}}\\
\alpha=pr_{1}\cdots r_{l}q&amp;\mapsto&amp;\delta(\alpha)=(d_{pr_{1}},\ldots,d_{r_{l}q})\end{array}" display="block" intent=":literal"><semantics><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mi>δ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>Floer</mi></msubsup></mrow></mtd><mtd><mo stretchy="false">→</mo></mtd><mtd class="ltx_align_left" columnalign="left"><msub><mi>𝔸</mi><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msub></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mi>α</mi><mo>=</mo><mi>p</mi><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>l</mi></msub><mi>q</mi></mrow></mtd><mtd><mo stretchy="false">↦</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>d</mi><mrow><msub><mi>r</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{array}[]{rcl}\delta:{\mathbb{A}}_{pq}^{\rm Floer}&amp;\to&amp;{\mathbb{A}}_{d_{pq}}\\
\alpha=pr_{1}\cdots r_{l}q&amp;\mapsto&amp;\delta(\alpha)=(d_{pr_{1}},\ldots,d_{r_{l}q})\end{array}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.2)</span></td></tr></tbody>
</table>
<p id="S5.I3.i2.p1.3" class="ltx_p">such that the following diagram commutes.</p>
<table id="S5.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S5.Ex18.m1.pic1" class="ltx_picture ltx_markedasmath" height="70.77" overflow="visible" style="vertical-align:-58.332194888741874px" version="1.1" viewBox="45.93 58.33 213.24 70.77" width="213.24"><g transform="matrix(1 0 0 -1 45.93131979982834 70.77168672761434) translate(0,3.46) translate(45.93,0)"><g transform="translate(-45.93,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:6.04em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.29em;font-size:10pt;" height="15.71" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="83.56"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex18.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{{\mathbb{A}}_{pr}^{\rm Floer}\times{\mathbb{A}}_{rq}^{\rm Floer}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mi>Floer</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>𝔸</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>Floer</mi></msubsup></mrow><annotation encoding="application/x-tex">\textstyle{{\mathbb{A}}_{pr}^{\rm Floer}\times{\mathbb{A}}_{rq}^{\rm Floer}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 45.93131979982834 -0.27673578005007266 L 45.93131979982834 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(88.57,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 45.93131979982834 -0.27673578005007266 L 88.5736706412909 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 88.5736706412909 -0.27673578005007266 L 88.5736706412909 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -11.569253138458645 L 0.27673578005007266 -11.569253138458645" fill="none" stroke="#000000"></path><g transform="translate(0,-35.77)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -35.77023732211888 L 0.27673578005007266 -11.569253138458645" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -35.77023732211888 L 0.27673578005007266 -35.77023732211888" fill="none" stroke="#000000"></path><g transform="translate(88.57,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:4.41em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.29em;font-size:10pt;" height="15.71" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex18.m1.pic1.m2" class="ltx_Math" alttext="\textstyle{\partial^{prq}{\mathbb{A}}_{pq}^{\rm Floer}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msup><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>Floer</mi></msubsup></mrow><annotation encoding="application/x-tex">\textstyle{\partial^{prq}{\mathbb{A}}_{pq}^{\rm Floer}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 122.94591405141959 -11.569253138458645 L 123.49938561151974 -11.569253138458645" fill="none" stroke="#000000"></path><g transform="translate(123.22,0) translate(0,-32.94)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 122.94591405141959 -32.93972878398713 L 123.49938561151974 -11.569253138458645" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 122.94591405141959 -32.93972878398713 L 123.49938561151974 -32.93972878398713" fill="none" stroke="#000000"></path><g transform="translate(-36.9,0) translate(0,-45.92) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:4.73em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.35em;font-size:10pt;" height="14.26" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="65.5"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex18.m1.pic1.m3" class="ltx_Math" alttext="\textstyle{{\mathbb{A}}_{d_{pr}}\times{\mathbb{A}}_{d_{rq}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔸</mi><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝔸</mi><msub><mi>d</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msub></mrow><annotation encoding="application/x-tex">\textstyle{{\mathbb{A}}_{d_{pr}}\times{\mathbb{A}}_{d_{rq}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 36.90076431859261 -46.19407838552477 L 36.90076431859261 -45.640606825424626" fill="none" stroke="#000000"></path><g transform="translate(79.14,0) translate(0,-45.92)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 36.90076431859261 -46.19407838552477 L 79.14012013191633 -45.640606825424626" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 79.14012013191633 -46.19407838552477 L 79.14012013191633 -45.640606825424626" fill="none" stroke="#000000"></path><g transform="translate(79.14,0) translate(0,-45.92) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:5.77em;--ltx-fo-height:0.89em;--ltx-fo-depth:0.35em;font-size:10pt;" height="17.09" overflow="visible" transform="matrix(1 0 0 -1 0 12.29)" width="79.86"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex18.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{\partial^{(d_{pr},d_{rq})}{\mathbb{A}}_{d_{pq}}}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo>,</mo><msub><mi>d</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow></msup><msub><mi>𝔸</mi><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msub></mrow><annotation encoding="application/x-tex">\textstyle{\partial^{(d_{pr},d_{rq})}{\mathbb{A}}_{d_{pq}}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S5.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S5.I3.i3.p1" class="ltx_para">
<p id="S5.I3.i3.p1.1" class="ltx_p">The <span id="S5.I3.i3.p1.1.1" class="ltx_text ltx_font_bold">system of extra symmetries</span> is the collection of compact Lie groups</p>
<table id="S5.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex19.m1" class="ltx_Math" alttext="G_{d}:=\{g\in PU(d+1)\ |\ g([1,0,\ldots,0])=[1,0,\ldots,0]\in\mathbb{CP}^{d}\}\cong U(d)." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>G</mi><mi>d</mi></msub><mo>:=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>g</mi><mo>∈</mo><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.222em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.500em">|</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn></mrow><mo stretchy="false">]</mo></mrow><mo>∈</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow></mrow><mo stretchy="false">}</mo></mrow><mo>≅</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">G_{d}:=\{g\in PU(d+1)\ |\ g([1,0,\ldots,0])=[1,0,\ldots,0]\in\mathbb{CP}^{d}\}\cong U(d).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I3.i3.p1.2" class="ltx_p">for all <math id="S5.I3.i3.p1.m1" class="ltx_Math" alttext="d\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d\geq 1</annotation></semantics></math>. Here <math id="S5.I3.i3.p1.m2" class="ltx_Math" alttext="PU(d+1)" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">PU(d+1)</annotation></semantics></math> acts on <math id="S5.I3.i3.p1.m3" class="ltx_Math" alttext="\mathbb{CP}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathbb{CP}^{d}</annotation></semantics></math> in the standard way. The identification with <math id="S5.I3.i3.p1.m4" class="ltx_Math" alttext="U(d)" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">U(d)</annotation></semantics></math> is given by</p>
<table id="S5.E3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E3.m1" class="ltx_Math" alttext="U(d)\ni g^{\prime}\mapsto\left[\begin{array}[]{cc}1&amp;0\\
0&amp;g^{\prime}\end{array}\right]\in PU(d+1)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∋</mo><msup><mi>g</mi><mo>′</mo></msup><mo stretchy="false">↦</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><msup><mi>g</mi><mo>′</mo></msup></mtd></mtr></mtable><mo>]</mo></mrow><mo>∈</mo><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">U(d)\ni g^{\prime}\mapsto\left[\begin{array}[]{cc}1&amp;0\\
0&amp;g^{\prime}\end{array}\right]\in PU(d+1).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.3)</span></td></tr></tbody>
</table>
<p id="S5.I3.i3.p1.3" class="ltx_p">Denote</p>
<table id="S5.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex20.m1" class="ltx_Math" alttext="G_{pq}:=G_{d_{pq}}\ \forall p,q\in{\mathcal{P}}^{\rm Floer},{\mathcal{A}}^{\rm Floer}(p)&lt;{\mathcal{A}}^{\rm Floer}(q)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>:=</mo><mrow><msub><mi>G</mi><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mo rspace="0.167em">∀</mo><mi>p</mi></mrow></mrow></mrow><mo>,</mo><mrow><mi>q</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Floer</mi></msup></mrow><mo>,</mo><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>Floer</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>Floer</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">G_{pq}:=G_{d_{pq}}\ \forall p,q\in{\mathcal{P}}^{\rm Floer},{\mathcal{A}}^{\rm Floer}(p)&lt;{\mathcal{A}}^{\rm Floer}(q).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S5.I3.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S5.I3.i4.p1" class="ltx_para">
<p id="S5.I3.i4.p1.1" class="ltx_p">For each <math id="S5.I3.i4.p1.m1" class="ltx_Math" alttext="\delta=(d_{0},\ldots,d_{l})\in{\mathbb{A}}_{d}" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>d</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi>𝔸</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\delta=(d_{0},\ldots,d_{l})\in{\mathbb{A}}_{d}</annotation></semantics></math>, there is a group embedding</p>
<table id="S5.E4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E4.m1" class="ltx_math_unparsed" alttext="G_{\delta}:=G_{d_{0}}\times\cdots\times G_{d_{l}}\hookrightarrow G_{d}" display="block" intent=":literal"><semantics><mrow><mi>G</mi><msub><mrow></mrow><mi>δ</mi></msub><mo>:=</mo><mi>G</mi><msub><mrow></mrow><msub><mi>d</mi><mn>0</mn></msub></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi>G</mi><msub><mrow></mrow><msub><mi>d</mi><mi>l</mi></msub></msub><mo stretchy="false">↪</mo><mi>G</mi><msub><mrow></mrow><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">G_{\delta}:=G_{d_{0}}\times\cdots\times G_{d_{l}}\hookrightarrow G_{d}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.4)</span></td></tr></tbody>
</table>
<p id="S5.I3.i4.p1.2" class="ltx_p">defined by</p>
<table id="S5.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex21.m1" class="ltx_Math" alttext="\left(\left[\begin{array}[]{cc}1&amp;0\\
0&amp;g_{0}^{\prime}\end{array}\right],\dots,\left[\begin{array}[]{cc}1&amp;0\\
0&amp;g_{l}^{\prime}\end{array}\right]\right)\mapsto\left[\begin{array}[]{cccc}1&amp;0&amp;\cdots&amp;0\\
0&amp;g_{0}^{\prime}&amp;\cdots&amp;0\\
0&amp;\cdots&amp;\ddots&amp;0\\
0&amp;0&amp;\cdots&amp;g_{l}^{\prime}\end{array}\right]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>(</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mi>g</mi><mn>0</mn><mo>′</mo></msubsup></mtd></mtr></mtable><mo>]</mo></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mi>g</mi><mi>l</mi><mo>′</mo></msubsup></mtd></mtr></mtable><mo>]</mo></mrow><mo>)</mo></mrow><mo stretchy="false">↦</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd><mtd><mo>⋯</mo></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mi>g</mi><mn>0</mn><mo>′</mo></msubsup></mtd><mtd><mo>⋯</mo></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mo>⋯</mo></mtd><mtd><mi mathvariant="normal">⋱</mi></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mo>⋯</mo></mtd><mtd><msubsup><mi>g</mi><mi>l</mi><mo>′</mo></msubsup></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left(\left[\begin{array}[]{cc}1&amp;0\\
0&amp;g_{0}^{\prime}\end{array}\right],\dots,\left[\begin{array}[]{cc}1&amp;0\\
0&amp;g_{l}^{\prime}\end{array}\right]\right)\mapsto\left[\begin{array}[]{cccc}1&amp;0&amp;\cdots&amp;0\\
0&amp;g_{0}^{\prime}&amp;\cdots&amp;0\\
0&amp;\cdots&amp;\ddots&amp;0\\
0&amp;0&amp;\cdots&amp;g_{l}^{\prime}\end{array}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S5.I3.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(5)</span> 
<div id="S5.I3.i5.p1" class="ltx_para">
<p id="S5.I3.i5.p1.1" class="ltx_p">For each <math id="S5.I3.i5.p1.m1" class="ltx_math_unparsed" alttext="\alpha=pr_{1}\cdots r_{l}\in{\mathbb{A}}_{pq}^{\rm Floer}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mi>p</mi><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>l</mi></msub><mo>∈</mo><mi>𝔸</mi><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><msup><mrow></mrow><mi>Floer</mi></msup></mrow><annotation encoding="application/x-tex">\alpha=pr_{1}\cdots r_{l}\in{\mathbb{A}}_{pq}^{\rm Floer}</annotation></semantics></math>, we also denote</p>
<table id="S5.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex22.m1" class="ltx_math_unparsed" alttext="G_{\alpha}:=G_{pr_{1}\cdots r_{l}q}:=G_{pr_{1}}\times\cdots\times G_{r_{l}q}=G_{\delta(\alpha)}" display="block" intent=":literal"><semantics><mrow><mi>G</mi><msub><mrow></mrow><mi>α</mi></msub><mo>:=</mo><mi>G</mi><msub><mrow></mrow><mrow><mi>p</mi><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>l</mi></msub><mi>q</mi></mrow></msub><mo>:=</mo><mi>G</mi><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi>G</mi><msub><mrow></mrow><mrow><msub><mi>r</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>=</mo><mi>G</mi><msub><mrow></mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">G_{\alpha}:=G_{pr_{1}\cdots r_{l}q}:=G_{pr_{1}}\times\cdots\times G_{r_{l}q}=G_{\delta(\alpha)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I3.i5.p1.2" class="ltx_p">and identify it with the embedding image in <math id="S5.I3.i5.p1.m2" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math>. Then whenever <math id="S5.I3.i5.p1.m3" class="ltx_Math" alttext="\alpha\leq\beta" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">\alpha\leq\beta</annotation></semantics></math> there is a group embedding <math id="S5.I3.i5.p1.m4" class="ltx_Math" alttext="G_{\alpha}\hookrightarrow G_{\beta}" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mi>α</mi></msub><mo stretchy="false">↪</mo><msub><mi>G</mi><mi>β</mi></msub></mrow><annotation encoding="application/x-tex">G_{\alpha}\hookrightarrow G_{\beta}</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
</div>
</section>
<section id="S5.SS1.SSS5" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">5.1.5. </span>The main statement</h4>

<div id="S5.SS1.SSS5.p1" class="ltx_para">
<p id="S5.SS1.SSS5.p1.1" class="ltx_p">To simplify the notations, through out this section, we use <math id="S5.SS1.SSS5.p1.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}_{pq}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{pq}</annotation></semantics></math> to denote the moduli space <math id="S5.SS1.SSS5.p1.m2" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{pq}^{\rm Floer}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><msup><mrow></mrow><mi>Floer</mi></msup></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{pq}^{\rm Floer}</annotation></semantics></math>.</p>
</div>
<div id="S5.SS1.SSS5.p2" class="ltx_para">
<p id="S5.SS1.SSS5.p2.1" class="ltx_p">The following definition is the counterpart of Definition <a href="#S3.Thmthm22" title="Definition 3.22. ‣ 3.4.3. Stratified smooth orbifolds with corners and derived orbifold charts ‣ 3.4. Derived orbifold charts with stratifications ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.22</span></a>, <a href="#S3.Thmthm24" title="Definition 3.24. ‣ 3.4.4. Derived orbifold lifts of flow categories and bimodules ‣ 3.4. Derived orbifold charts with stratifications ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.24</span></a> for K-charts.</p>
</div>
<div id="S5.Thmthm8" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm8.2" class="ltx_text ltx_font_bold">Definition 5.8</span></span><span id="S5.Thmthm8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm8.p1" class="ltx_para">
<p id="S5.Thmthm8.p1.1" class="ltx_p">A <span id="S5.Thmthm8.p1.1.1" class="ltx_text ltx_font_bold">weak K-chart presentation (with the system of groups <math id="S5.Thmthm8.p1.m1" class="ltx_Math" alttext="\{G_{\alpha}\}_{\alpha\in{\mathbb{A}}^{\rm Floer}_{pq}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mi>G</mi><mi>α</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>α</mi><mo>∈</mo><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>Floer</mi></msubsup></mrow></msub><annotation encoding="application/x-tex">\{G_{\alpha}\}_{\alpha\in{\mathbb{A}}^{\rm Floer}_{pq}}</annotation></semantics></math>)</span> of the <math id="S5.Thmthm8.p1.m2" class="ltx_Math" alttext="{\mathbb{A}}^{\rm Floer}_{pq}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>Floer</mi></msubsup><annotation encoding="application/x-tex">{\mathbb{A}}^{\rm Floer}_{pq}</annotation></semantics></math>-space <math id="S5.Thmthm8.p1.m3" class="ltx_Math" alttext="\overline{\mathcal{M}}_{pq}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{pq}</annotation></semantics></math> consists of the following objects.</p>
<ol id="S5.I4" class="ltx_enumerate">
<li id="S5.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S5.I4.i1.p1" class="ltx_para">
<p id="S5.I4.i1.p1.1" class="ltx_p">A collection of K-charts</p>
<table id="S5.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex23.m1" class="ltx_Math" alttext="\Big(K_{\alpha}=(G_{\alpha},V_{\alpha},E_{\alpha},S_{\alpha},\psi_{\alpha})\Big)_{\alpha\in{\mathbb{A}}^{\rm Floer}_{pq}}" display="block" intent=":literal"><semantics><msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msub><mi>K</mi><mi>α</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>α</mi></msub><mo>,</mo><msub><mi>V</mi><mi>α</mi></msub><mo>,</mo><msub><mi>E</mi><mi>α</mi></msub><mo>,</mo><msub><mi>S</mi><mi>α</mi></msub><mo>,</mo><msub><mi>ψ</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mi>α</mi><mo>∈</mo><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>Floer</mi></msubsup></mrow></msub><annotation encoding="application/x-tex">\Big(K_{\alpha}=(G_{\alpha},V_{\alpha},E_{\alpha},S_{\alpha},\psi_{\alpha})\Big)_{\alpha\in{\mathbb{A}}^{\rm Floer}_{pq}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I4.i1.p1.2" class="ltx_p">of <math id="S5.I4.i1.p1.m1" class="ltx_Math" alttext="(\partial^{\alpha}\overline{\mathcal{M}}_{pq})_{\alpha\in{\mathbb{A}}^{\rm Floer}_{pq}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">∂</mo><mi>α</mi></msup><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>α</mi><mo>∈</mo><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>Floer</mi></msubsup></mrow></msub><annotation encoding="application/x-tex">(\partial^{\alpha}\overline{\mathcal{M}}_{pq})_{\alpha\in{\mathbb{A}}^{\rm Floer}_{pq}}</annotation></semantics></math>.</p>
</div></li>
<li id="S5.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S5.I4.i2.p1" class="ltx_para">
<p id="S5.I4.i2.p1.1" class="ltx_p">A collection of weak K-chart embeddings</p>
<table id="S5.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex24.m1" class="ltx_Math" alttext="\big\{{\bm{\iota}}_{\beta\alpha}:K_{\alpha}\rightharpoonup\partial^{\alpha}K_{\beta}\big\}_{\alpha\leq\beta}" display="block" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mi>𝜾</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>K</mi><mi>α</mi></msub><mo rspace="0.111em" stretchy="false">⇀</mo><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi>K</mi><mi>β</mi></msub></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow></msub><annotation encoding="application/x-tex">\big\{{\bm{\iota}}_{\beta\alpha}:K_{\alpha}\rightharpoonup\partial^{\alpha}K_{\beta}\big\}_{\alpha\leq\beta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
<p id="S5.Thmthm8.p1.2" class="ltx_p">They satisfy the following condition.</p>
<ol id="S5.I5" class="ltx_enumerate">
<li id="S5.I5.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S5.I5.i1.p1" class="ltx_para">
<p id="S5.I5.i1.p1.1" class="ltx_p">The weak K-chart embeddings satisfy the cocycle condition. Namely, for any triple of strata <math id="S5.I5.i1.p1.m1" class="ltx_Math" alttext="\alpha\leq\beta\leq\gamma" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>≤</mo><mi>β</mi><mo>≤</mo><mi>γ</mi></mrow><annotation encoding="application/x-tex">\alpha\leq\beta\leq\gamma</annotation></semantics></math>, one has</p>
<table id="S5.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex25.m1" class="ltx_Math" alttext="{\bm{\iota}}_{\gamma\beta}\circ{\bm{\iota}}_{\beta\alpha}={\bm{\iota}}_{\gamma\alpha}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝜾</mi><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>𝜾</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub></mrow><mo>=</mo><msub><mi>𝜾</mi><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\bm{\iota}}_{\gamma\beta}\circ{\bm{\iota}}_{\beta\alpha}={\bm{\iota}}_{\gamma\alpha}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S5.I5.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S5.I5.i2.p1" class="ltx_para">
<p id="S5.I5.i2.p1.1" class="ltx_p">For each pair of strata <math id="S5.I5.i2.p1.m1" class="ltx_Math" alttext="\alpha\leq\beta" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">\alpha\leq\beta</annotation></semantics></math>, there are a <math id="S5.I5.i2.p1.m2" class="ltx_Math" alttext="G_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>α</mi></msub><annotation encoding="application/x-tex">G_{\alpha}</annotation></semantics></math>-equivariant vector bundle <math id="S5.I5.i2.p1.m3" class="ltx_Math" alttext="F_{\beta\alpha}\to V_{\alpha}" display="inline" intent=":literal"><semantics><mrow><msub><mi>F</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi>V</mi><mi>α</mi></msub></mrow><annotation encoding="application/x-tex">F_{\beta\alpha}\to V_{\alpha}</annotation></semantics></math> and a germ of weak open K-chart embedding</p>
<table id="S5.Ex26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex26.m1" class="ltx_Math" alttext="{\bm{\theta}}_{\beta\alpha}:{\rm Stab}_{F_{\beta\alpha}}(K_{\alpha})\rightharpoonup\partial^{\alpha}K_{\beta}" display="block" intent=":literal"><semantics><mrow><msub><mi>𝜽</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>Stab</mi><msub><mi>F</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>K</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em" stretchy="false">⇀</mo><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi>K</mi><mi>β</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{\theta}}_{\beta\alpha}:{\rm Stab}_{F_{\beta\alpha}}(K_{\alpha})\rightharpoonup\partial^{\alpha}K_{\beta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I5.i2.p1.2" class="ltx_p">whose restriction to the zero section coincides with <math id="S5.I5.i2.p1.m4" class="ltx_Math" alttext="{\bm{\iota}}_{\beta\alpha}" display="inline" intent=":literal"><semantics><msub><mi>𝜾</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><annotation encoding="application/x-tex">{\bm{\iota}}_{\beta\alpha}</annotation></semantics></math>. We call <math id="S5.I5.i2.p1.m5" class="ltx_Math" alttext="{\bm{\theta}}_{\beta\alpha}" display="inline" intent=":literal"><semantics><msub><mi>𝜽</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><annotation encoding="application/x-tex">{\bm{\theta}}_{\beta\alpha}</annotation></semantics></math> a <span id="S5.I5.i2.p1.2.1" class="ltx_text ltx_font_bold">stabilization map</span>.</p>
</div></li>
</ol>
<p id="S5.Thmthm8.p1.3" class="ltx_p">The weak K-chart presentation is called a <span id="S5.Thmthm8.p1.3.1" class="ltx_text ltx_font_bold">K-chart presentation</span> if all weak K-chart embeddings are K-chart embeddings.</p>
</div>
</div>
<div id="S5.Thmthm9" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm9.2" class="ltx_text ltx_font_bold">Definition 5.9</span></span><span id="S5.Thmthm9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm9.p1" class="ltx_para">
<p id="S5.Thmthm9.p1.1" class="ltx_p">A <span id="S5.Thmthm9.p1.1.1" class="ltx_text ltx_font_bold">weak K-chart lift</span> of the Hamiltonian Floer flow category <math id="S5.Thmthm9.p1.m1" class="ltx_Math" alttext="T^{\rm Floer}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi>Floer</mi></msup><annotation encoding="application/x-tex">T^{\rm Floer}</annotation></semantics></math> consists of the following objects.</p>
<ol id="S5.I6" class="ltx_enumerate">
<li id="S5.I6.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S5.I6.i1.p1" class="ltx_para">
<p id="S5.I6.i1.p1.1" class="ltx_p">A collection of topological K-charts</p>
<table id="S5.Ex27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex27.m1" class="ltx_math_unparsed" alttext="\big\{K_{pq}=(G_{pq},V_{pq},E_{pq},S_{pq},\psi_{pq})\big\}_{p&lt;q}" display="block" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mi>K</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi>E</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi>S</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi>ψ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>p</mi><mo>&lt;</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\big\{K_{pq}=(G_{pq},V_{pq},E_{pq},S_{pq},\psi_{pq})\big\}_{p&lt;q}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I6.i1.p1.2" class="ltx_p">of <math id="S5.I6.i1.p1.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}_{pq}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{pq}</annotation></semantics></math>.</p>
</div></li>
<li id="S5.I6.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S5.I6.i2.p1" class="ltx_para">
<p id="S5.I6.i2.p1.1" class="ltx_p">A collection of weak K-chart embeddings</p>
<table id="S5.E5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E5.m1" class="ltx_Math" alttext="\big\{{\bm{\iota}}_{prq}:K_{pr}\times K_{rq}\rightharpoonup\partial^{prq}K_{pq}\big\}_{p&lt;r&lt;q}." display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">{</mo><msub><mi>𝜾</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>K</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>K</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo rspace="0.111em" stretchy="false">⇀</mo><mrow><msup><mo>∂</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msup><msub><mi>K</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>p</mi><mo>&lt;</mo><mi>r</mi><mo>&lt;</mo><mi>q</mi></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\big\{{\bm{\iota}}_{prq}:K_{pr}\times K_{rq}\rightharpoonup\partial^{prq}K_{pq}\big\}_{p&lt;r&lt;q}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.5)</span></td></tr></tbody>
</table>
</div></li>
</ol>
<p id="S5.Thmthm9.p1.2" class="ltx_p">These objects need to satisfy the following conditions.</p>
<ol id="S5.I7" class="ltx_enumerate">
<li id="S5.I7.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S5.I7.i1.p1" class="ltx_para">
<p id="S5.I7.i1.p1.1" class="ltx_p">When <math id="S5.I7.i1.p1.m1" class="ltx_Math" alttext="p=q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p=q</annotation></semantics></math>, <math id="S5.I7.i1.p1.m2" class="ltx_Math" alttext="V_{pp}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msub><annotation encoding="application/x-tex">V_{pp}</annotation></semantics></math> is a singleton and <math id="S5.I7.i1.p1.m3" class="ltx_Math" alttext="E_{pp}=\{0\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">E_{pp}=\{0\}</annotation></semantics></math>.</p>
</div></li>
<li id="S5.I7.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S5.I7.i2.p1" class="ltx_para">
<p id="S5.I7.i2.p1.1" class="ltx_p">The weak chart embeddings satisfy the associativity. More precisely, the following diagram commutes,</p>
<table id="S5.Ex28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S5.Ex28.m1.pic1" class="ltx_picture ltx_markedasmath" height="108.66" overflow="visible" style="vertical-align:-98.51168807618133px" version="1.1" viewBox="47.49 98.51 365.22 108.66" width="365.22"><g transform="matrix(1 0 0 -1 47.48713777192948 108.65879335953714) translate(0,3.46) translate(47.49,0)"><g transform="translate(80.7,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:7.26em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.29em;font-size:10pt;" height="13.41" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="100.41"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex28.m1.pic1.m2" class="ltx_Math" alttext="\textstyle{K_{pr}\times K_{rs}\times K_{sq}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msub><mi>K</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>K</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>K</mi><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\textstyle{K_{pr}\times K_{rs}\times K_{sq}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 99.08059366811307 -11.569253138458645 L 99.07565308884003 -11.599276658656342" fill="none" stroke="#000000"></path><g transform="translate(32.03,0) translate(0,-33.13)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 7.43 -0.52" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 5.74 4.75" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 99.08059366811307 -11.569253138458645 L 32.02926870102999 -33.131904649556354" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 32.034230393889665 -33.10061431416044 L 32.02926870102999 -33.131904649556354" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 171.03816721636312 -11.569253138458645 L 171.0711677522766 -11.67708022541338" fill="none" stroke="#000000"></path><g transform="translate(238.14,0) translate(0,-33.13)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -5.74 4.75" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -7.43 -0.52" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 171.03816721636312 -11.569253138458645 L 238.13858127237702 -33.131904649556354" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 238.10560185005016 -33.019348119194945 L 238.13858127237702 -33.131904649556354" fill="none" stroke="#000000"></path><g transform="translate(-47.49,0) translate(0,-43.43) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:6.26em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.29em;font-size:10pt;" height="13.57" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="86.67"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex28.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{\partial^{prs}K_{ps}\times K_{sq}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mo>∂</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msup><msub><mi>K</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>K</mi><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\textstyle{\partial^{prs}K_{ps}\times K_{sq}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 35.89404739415776 -55.00203332284748 L 35.957409267655144 -55.08353176726598" fill="none" stroke="#000000"></path><g transform="translate(103.72,0) translate(0,-76.87)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -5.74 4.76" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -7.43 -0.51" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 35.89404739415776 -55.00203332284748 L 103.71479368546336 -76.87359772002992" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 103.71479368546336 -76.7551927261701 L 103.71479368546336 -76.87359772002992" fill="none" stroke="#000000"></path><g transform="translate(222.62,0) translate(0,-43.43) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:6.27em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.29em;font-size:10pt;" height="13.57" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="86.81"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex28.m1.pic1.m6" class="ltx_Math" alttext="\textstyle{K_{pr}\times\partial^{rsq}K_{rq}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msub><mi>K</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0.222em" rspace="0.055em">×</mo><mrow><msup><mo>∂</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msup><msub><mi>K</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\textstyle{K_{pr}\times\partial^{rsq}K_{rq}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 234.2499864535228 -55.00203332284748 L 234.2436312639451 -55.00203332284748" fill="none" stroke="#000000"></path><g transform="translate(166.39,0) translate(0,-76.84)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 7.43 -0.51" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 5.74 4.76" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 234.2499864535228 -55.00203332284748 L 166.39267143016207 -76.84298301940639" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 166.42358172099853 -76.84298301940639 L 166.39267143016207 -76.84298301940639" fill="none" stroke="#000000"></path><g transform="translate(103.72,0) translate(0,-86.94) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:3.93em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.29em;font-size:10pt;" height="13.57" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="54.38"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex28.m1.pic1.m8" class="ltx_Math" alttext="\textstyle{\partial^{prsq}K_{pq}}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msup><msub><mi>K</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\textstyle{\partial^{prsq}K_{pq}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I7.i2.p1.2" class="ltx_p">where the arrows are defined by (<a href="#S5.E5" title="In item 2 ‣ Definition 5.9. ‣ 5.1.5. The main statement ‣ 5.1. Basic notions and the main theorem about global charts ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.5</span></a>).</p>
</div></li>
<li id="S5.I7.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S5.I7.i3.p1" class="ltx_para">
<p id="S5.I7.i3.p1.1" class="ltx_p">For each stratum <math id="S5.I7.i3.p1.m1" class="ltx_math_unparsed" alttext="\alpha=pr_{1}\cdots r_{l}q\in{\mathbb{A}}^{\rm Floer}_{pq}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mi>p</mi><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>l</mi></msub><mi>q</mi><mo>∈</mo><mi>𝔸</mi><msup><mrow></mrow><mi>Floer</mi></msup><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\alpha=pr_{1}\cdots r_{l}q\in{\mathbb{A}}^{\rm Floer}_{pq}</annotation></semantics></math>, consider the product topological K-chart</p>
<table id="S5.Ex29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex29.m1" class="ltx_math_unparsed" alttext="K_{\alpha}=(G_{\alpha},V_{\alpha},E_{\alpha},S_{\alpha},\psi_{\alpha})=K_{pr_{1}}\times\cdots K_{r_{l}q}." display="block" intent=":literal"><semantics><mrow><msub><mi>K</mi><mi>α</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>α</mi></msub><mo>,</mo><msub><mi>V</mi><mi>α</mi></msub><mo>,</mo><msub><mi>E</mi><mi>α</mi></msub><mo>,</mo><msub><mi>S</mi><mi>α</mi></msub><mo>,</mo><msub><mi>ψ</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>K</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0em">⋯</mo><msub><mi>K</mi><mrow><msub><mi>r</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">K_{\alpha}=(G_{\alpha},V_{\alpha},E_{\alpha},S_{\alpha},\psi_{\alpha})=K_{pr_{1}}\times\cdots K_{r_{l}q}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I7.i3.p1.2" class="ltx_p">The above property implies that for each pair of strata <math id="S5.I7.i3.p1.m2" class="ltx_Math" alttext="\alpha\leq\beta" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">\alpha\leq\beta</annotation></semantics></math> of <math id="S5.I7.i3.p1.m3" class="ltx_Math" alttext="pq" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">pq</annotation></semantics></math>, there is a well-defined weak K-chart embedding</p>
<table id="S5.Ex30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex30.m1" class="ltx_Math" alttext="{\bm{\iota}}_{\beta\alpha}:K_{\alpha}\rightharpoonup\partial^{\alpha}K_{\beta}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝜾</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>K</mi><mi>α</mi></msub><mo rspace="0.111em" stretchy="false">⇀</mo><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi>K</mi><mi>β</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\bm{\iota}}_{\beta\alpha}:K_{\alpha}\rightharpoonup\partial^{\alpha}K_{\beta}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I7.i3.p1.3" class="ltx_p">Then the collection <math id="S5.I7.i3.p1.m4" class="ltx_Math" alttext="((K_{\alpha})_{\alpha\in{\mathbb{A}}_{pq}},({\bm{\iota}}_{\beta\alpha})_{\alpha\leq\beta})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>K</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>α</mi><mo>∈</mo><msub><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></msub><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝜾</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">((K_{\alpha})_{\alpha\in{\mathbb{A}}_{pq}},({\bm{\iota}}_{\beta\alpha})_{\alpha\leq\beta})</annotation></semantics></math> form a weak K-chart presentation of <math id="S5.I7.i3.p1.m5" class="ltx_Math" alttext="\overline{\mathcal{M}}_{pq}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{pq}</annotation></semantics></math>.</p>
</div></li>
</ol>
<p id="S5.Thmthm9.p1.3" class="ltx_p">The weak K-chart lift is called a <span id="S5.Thmthm9.p1.3.1" class="ltx_text ltx_font_bold">K-chart lift</span> if all the weak chart embeddings are chart embeddings.</p>
</div>
</div>
<div id="S5.Thmthm10" class="ltx_theorem ltx_theorem_notation">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm10.2" class="ltx_text ltx_font_italic">Notation 5.10</span></span><span id="S5.Thmthm10.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S5.Thmthm10.p1" class="ltx_para">
<p id="S5.Thmthm10.p1.1" class="ltx_p">We introduce the following notation and convention which are frequently used in this paper. The <math id="S5.Thmthm10.p1.m1" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math>-equivariantization of the product chart <math id="S5.Thmthm10.p1.m2" class="ltx_Math" alttext="K_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>α</mi></msub><annotation encoding="application/x-tex">K_{\alpha}</annotation></semantics></math> is denoted by</p>
<table id="S5.Ex31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex31.m1" class="ltx_Math" alttext="K_{\alpha}^{\sim}:=G_{pq}\times_{G_{\alpha}}(K_{\alpha})=(G_{pq},V_{\alpha}^{\sim},E_{\alpha}^{\sim},S_{\alpha}^{\sim})." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>K</mi><mi>α</mi><mo>∼</mo></msubsup><mo>:=</mo><mrow><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>G</mi><mi>α</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>K</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msubsup><mi>V</mi><mi>α</mi><mo>∼</mo></msubsup><mo>,</mo><msubsup><mi>E</mi><mi>α</mi><mo>∼</mo></msubsup><mo>,</mo><msubsup><mi>S</mi><mi>α</mi><mo>∼</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">K_{\alpha}^{\sim}:=G_{pq}\times_{G_{\alpha}}(K_{\alpha})=(G_{pq},V_{\alpha}^{\sim},E_{\alpha}^{\sim},S_{\alpha}^{\sim}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmthm10.p1.2" class="ltx_p">Then usually the version of notations <math id="S5.Thmthm10.p1.m3" class="ltx_Math" alttext="K_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>α</mi></msub><annotation encoding="application/x-tex">K_{\alpha}</annotation></semantics></math> (or <math id="S5.Thmthm10.p1.m4" class="ltx_math_unparsed" alttext="K_{pr_{1}\cdots r_{l}q}" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><msub><mrow></mrow><mrow><mi>p</mi><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>l</mi></msub><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">K_{pr_{1}\cdots r_{l}q}</annotation></semantics></math>) indicates the objects are constructed from taking products and the version of notations <math id="S5.Thmthm10.p1.m5" class="ltx_Math" alttext="K_{\alpha}^{\sim}" display="inline" intent=":literal"><semantics><msubsup><mi>K</mi><mi>α</mi><mo>∼</mo></msubsup><annotation encoding="application/x-tex">K_{\alpha}^{\sim}</annotation></semantics></math> (or <math id="S5.Thmthm10.p1.m6" class="ltx_math_unparsed" alttext="K_{pr_{1}\cdots r_{l}q}^{\sim}" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><msub><mrow></mrow><mrow><mi>p</mi><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>l</mi></msub><mi>q</mi></mrow></msub><msup><mrow></mrow><mo>∼</mo></msup></mrow><annotation encoding="application/x-tex">K_{pr_{1}\cdots r_{l}q}^{\sim}</annotation></semantics></math>) indicates the objects are constructed from taking products and an equivariantization (by a certain group which is clear from the context).</p>
</div>
</div>
<div id="S5.SS1.SSS5.p3" class="ltx_para">
<p id="S5.SS1.SSS5.p3.1" class="ltx_p">Now we are ready to state the first main theorem of this section.</p>
</div>
<div id="S5.Thmthm11" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm11.2" class="ltx_text ltx_font_bold">Theorem 5.11</span></span><span id="S5.Thmthm11.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm11.p1" class="ltx_para">
<p id="S5.Thmthm11.p1.1" class="ltx_p"><span id="S5.Thmthm11.p1.1.1" class="ltx_text ltx_font_italic">The Hamiltonian Floer flow category <math id="S5.Thmthm11.p1.m1" class="ltx_Math" alttext="T^{\rm Floer}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi>Floer</mi></msup><annotation encoding="application/x-tex">T^{\rm Floer}</annotation></semantics></math> admits a weak K-chart lift.</span></p>
</div>
</div>
<div id="S5.SS1.SSS5.p4" class="ltx_para">
<p id="S5.SS1.SSS5.p4.1" class="ltx_p">We also refer to the weak K-chart lift as the “global chart.” This theorem certainly does not contain all the properties we will need in the final construction. Eventually, we need to upgrade the weak lift to a lift and equip it with a smooth structure.</p>
</div>
</section>
</section>
<section id="S5.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.2. </span>Global chart construction I</h3>

<div id="S5.SS2.p1" class="ltx_para">
<p id="S5.SS2.p1.1" class="ltx_p">Following <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>, Section 6]</cite> (also in the same spirit as <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx39" title="" class="ltx_ref">Sie99</a>, Section 3]</cite>), the goal of this subsection is to introduce a system of auxiliary moduli spaces <math id="S5.SS2.p1.m1" class="ltx_Math" alttext="(B_{d})_{d\geq 1}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>B</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>d</mi><mo>≥</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">(B_{d})_{d\geq 1}</annotation></semantics></math> parametrizing stable holomorphic cylinders in <math id="S5.SS2.p1.m2" class="ltx_Math" alttext="\mathbb{CP}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathbb{CP}^{d}</annotation></semantics></math>, which serve as Deligne–Mumford type moduli spaces for stable Floer trajectories. Moreover, we will consider the gluing of different (stable) holomorphic cylinders from different complex projective spaces. Such consideration will play an important role in the study of global charts of the boundary strata of moduli spaces of (stable) Floer trajectories.</p>
</div>
<section id="S5.SS2.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">5.2.1. </span>Moduli spaces of stable cylinders</h4>

<div id="S5.SS2.SSS1.p1" class="ltx_para">
<p id="S5.SS2.SSS1.p1.1" class="ltx_p">Following <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>]</cite> and <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx1" title="" class="ltx_ref">AB21</a>]</cite>, we introduce some auxiliary moduli spaces. Consider a genus zero prestable curve <math id="S5.SS2.SSS1.p1.m1" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> with two marked points <math id="S5.SS2.SSS1.p1.m2" class="ltx_Math" alttext="z_{-}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mo>−</mo></msub><annotation encoding="application/x-tex">z_{-}</annotation></semantics></math>, <math id="S5.SS2.SSS1.p1.m3" class="ltx_Math" alttext="z_{+}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mo>+</mo></msub><annotation encoding="application/x-tex">z_{+}</annotation></semantics></math>. The two marked points induce a decomposition</p>
<table id="S5.Ex32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex32.m1" class="ltx_Math" alttext="\Sigma=\Sigma_{\rm cyl}\cup\Sigma_{\rm sph}" display="block" intent=":literal"><semantics><mrow><mi mathvariant="normal">Σ</mi><mo>=</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>cyl</mi></msub><mo>∪</mo><msub><mi mathvariant="normal">Σ</mi><mi>sph</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\Sigma=\Sigma_{\rm cyl}\cup\Sigma_{\rm sph}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS1.p1.2" class="ltx_p">of <math id="S5.SS2.SSS1.p1.m4" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> into the cylindrical components and spherical components, where the cylindrical components are determined by the vertices on the line connecting <math id="S5.SS2.SSS1.p1.m5" class="ltx_Math" alttext="z_{-}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mo>−</mo></msub><annotation encoding="application/x-tex">z_{-}</annotation></semantics></math> and <math id="S5.SS2.SSS1.p1.m6" class="ltx_Math" alttext="z_{+}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mo>+</mo></msub><annotation encoding="application/x-tex">z_{+}</annotation></semantics></math> in the dual graph. Each cylindrical component <math id="S5.SS2.SSS1.p1.m7" class="ltx_Math" alttext="\Sigma_{i}\subset\Sigma" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mi>i</mi></msub><mo>⊂</mo><mi mathvariant="normal">Σ</mi></mrow><annotation encoding="application/x-tex">\Sigma_{i}\subset\Sigma</annotation></semantics></math> has two special points corresponding to the negative and positive infinities <math id="S5.SS2.SSS1.p1.m8" class="ltx_Math" alttext="z_{i,\pm}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">±</mo></mrow></msub><annotation encoding="application/x-tex">z_{i,\pm}</annotation></semantics></math>. There is a <math id="S5.SS2.SSS1.p1.m9" class="ltx_Math" alttext="{\mathbb{C}}^{*}" display="inline" intent=":literal"><semantics><msup><mi>ℂ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">{\mathbb{C}}^{*}</annotation></semantics></math>-action on <math id="S5.SS2.SSS1.p1.m10" class="ltx_Math" alttext="\Sigma_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>α</mi></msub><annotation encoding="application/x-tex">\Sigma_{\alpha}</annotation></semantics></math>, given by biholomorphisms fixing <math id="S5.SS2.SSS1.p1.m11" class="ltx_Math" alttext="z_{i,\pm}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">±</mo></mrow></msub><annotation encoding="application/x-tex">z_{i,\pm}</annotation></semantics></math>.</p>
</div>
<div id="S5.SS2.SSS1.p2" class="ltx_para">
<p id="S5.SS2.SSS1.p2.1" class="ltx_p">To fix the rotational gauge on the cylinder, we introduce the following concept. Identifying <math id="S5.SS2.SSS1.p2.m1" class="ltx_Math" alttext="{\mathbb{C}}^{*}" display="inline" intent=":literal"><semantics><msup><mi>ℂ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">{\mathbb{C}}^{*}</annotation></semantics></math> with <math id="S5.SS2.SSS1.p2.m2" class="ltx_Math" alttext="S^{1}\times{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>S</mi><mn>1</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">S^{1}\times{\mathbb{R}}</annotation></semantics></math>, a <span id="S5.SS2.SSS1.p2.1.1" class="ltx_text ltx_font_bold">lateral line</span> on a cylindrical component <math id="S5.SS2.SSS1.p2.m3" class="ltx_Math" alttext="\Sigma_{i}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\Sigma_{i}</annotation></semantics></math> is an <math id="S5.SS2.SSS1.p2.m4" class="ltx_Math" alttext="{\mathbb{R}}" display="inline" intent=":literal"><semantics><mi>ℝ</mi><annotation encoding="application/x-tex">{\mathbb{R}}</annotation></semantics></math>-orbit <math id="S5.SS2.SSS1.p2.m5" class="ltx_Math" alttext="{\rm L}_{i}\subset\Sigma_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>⊂</mo><msub><mi mathvariant="normal">Σ</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">{\rm L}_{i}\subset\Sigma_{i}</annotation></semantics></math>. There are other equivalent notions such as asymptotic markers which can also fix the rotational gauge.</p>
</div>
<div id="S5.Thmthm12" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm12.2" class="ltx_text ltx_font_bold">Definition 5.12</span></span><span id="S5.Thmthm12.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm12.p1" class="ltx_para">
<ol id="S5.I8" class="ltx_enumerate">
<li id="S5.I8.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S5.I8.i1.p1" class="ltx_para">
<p id="S5.I8.i1.p1.1" class="ltx_p">A <span id="S5.I8.i1.p1.1.1" class="ltx_text ltx_font_bold">prestable cylinder</span> is a pair <math id="S5.I8.i1.p1.m1" class="ltx_Math" alttext="(\Sigma,{\bf L})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>𝐋</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Sigma,{\bf L})</annotation></semantics></math> where <math id="S5.I8.i1.p1.m2" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> is a genus zero pretable curve with two marked points <math id="S5.I8.i1.p1.m3" class="ltx_Math" alttext="z_{-},z_{+}" display="inline" intent=":literal"><semantics><mrow><msub><mi>z</mi><mo>−</mo></msub><mo>,</mo><msub><mi>z</mi><mo>+</mo></msub></mrow><annotation encoding="application/x-tex">z_{-},z_{+}</annotation></semantics></math> and <math id="S5.I8.i1.p1.m4" class="ltx_Math" alttext="{\bf L}=({\rm L}_{i})" display="inline" intent=":literal"><semantics><mrow><mi>𝐋</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>L</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bf L}=({\rm L}_{i})</annotation></semantics></math> where each <math id="S5.I8.i1.p1.m5" class="ltx_Math" alttext="{\rm L}_{i}\subset\Sigma_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>⊂</mo><msub><mi mathvariant="normal">Σ</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">{\rm L}_{i}\subset\Sigma_{i}</annotation></semantics></math> is a lateral line on the cylindrical component <math id="S5.I8.i1.p1.m6" class="ltx_Math" alttext="\Sigma_{i}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\Sigma_{i}</annotation></semantics></math>. The cylindrical irreducible components are also referred to as the <span id="S5.I8.i1.p1.1.2" class="ltx_text ltx_font_bold">horizontal levels</span> of <math id="S5.I8.i1.p1.m7" class="ltx_Math" alttext="(\Sigma,{\bf L})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>𝐋</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Sigma,{\bf L})</annotation></semantics></math>.</p>
</div></li>
<li id="S5.I8.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S5.I8.i2.p1" class="ltx_para">
<p id="S5.I8.i2.p1.1" class="ltx_p">A <span id="S5.I8.i2.p1.1.1" class="ltx_text ltx_font_bold">marked stable cylinder</span> is a triple <math id="S5.I8.i2.p1.m1" class="ltx_Math" alttext="(\Sigma,{\bf z},{\bf L})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>𝐳</mi><mo>,</mo><mi>𝐋</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Sigma,{\bf z},{\bf L})</annotation></semantics></math> where <math id="S5.I8.i2.p1.m2" class="ltx_Math" alttext="(\Sigma,{\bf L})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>𝐋</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Sigma,{\bf L})</annotation></semantics></math> is a prestable cylinder and <math id="S5.I8.i2.p1.m3" class="ltx_Math" alttext="{\bf z}" display="inline" intent=":literal"><semantics><mi>𝐳</mi><annotation encoding="application/x-tex">{\bf z}</annotation></semantics></math> is a list of extra marked points which are different from <math id="S5.I8.i2.p1.m4" class="ltx_Math" alttext="z_{\pm}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mo>±</mo></msub><annotation encoding="application/x-tex">z_{\pm}</annotation></semantics></math> and the nodal points <math id="S5.I8.i2.p1.m5" class="ltx_Math" alttext="z_{i,\pm}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">±</mo></mrow></msub><annotation encoding="application/x-tex">z_{i,\pm}</annotation></semantics></math>, such that each irreducible component is stable (i.e., with at least three special points).</p>
</div></li>
</ol>
</div>
</div>
<div id="S5.SS2.SSS1.p3" class="ltx_para">
<p id="S5.SS2.SSS1.p3.1" class="ltx_p">The notion of isomorphisms of marked stable cylinders can be defined in the obvious way. Let <math id="S5.SS2.SSS1.p3.m1" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{0,2,d^{\prime}}^{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mn>0</mn><mo>,</mo><mn>2</mn><mo>,</mo><msup><mi>d</mi><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>ℝ</mi></msup></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{0,2,d^{\prime}}^{\mathbb{R}}</annotation></semantics></math> be the moduli space of marked stable cylinders with <math id="S5.SS2.SSS1.p3.m2" class="ltx_Math" alttext="d^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>d</mi><mo>′</mo></msup><annotation encoding="application/x-tex">d^{\prime}</annotation></semantics></math> marked points. It is a compactification of the moduli space <math id="S5.SS2.SSS1.p3.m3" class="ltx_Math" alttext="{\mathcal{M}}_{0,2,d^{\prime}}^{\mathbb{R}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn><mo>,</mo><msup><mi>d</mi><mo>′</mo></msup></mrow><mi>ℝ</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{M}}_{0,2,d^{\prime}}^{\mathbb{R}}</annotation></semantics></math>, the moduli space of marked stable cylinders with <math id="S5.SS2.SSS1.p3.m4" class="ltx_Math" alttext="d^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>d</mi><mo>′</mo></msup><annotation encoding="application/x-tex">d^{\prime}</annotation></semantics></math> marked points with only one cylindrical component and zero spherical components. Forgetting the lateral line defines a smooth <math id="S5.SS2.SSS1.p3.m5" class="ltx_Math" alttext="S^{1}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mn>1</mn></msup><annotation encoding="application/x-tex">S^{1}</annotation></semantics></math>-fibration <math id="S5.SS2.SSS1.p3.m6" class="ltx_Math" alttext="{\mathcal{M}}_{0,2,d^{\prime}}^{\mathbb{R}}\to{\mathcal{M}}_{2+d^{\prime}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn><mo>,</mo><msup><mi>d</mi><mo>′</mo></msup></mrow><mi>ℝ</mi></msubsup><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mn>2</mn><mo>+</mo><msup><mi>d</mi><mo>′</mo></msup></mrow></msub></mrow><annotation encoding="application/x-tex">{\mathcal{M}}_{0,2,d^{\prime}}^{\mathbb{R}}\to{\mathcal{M}}_{2+d^{\prime}}</annotation></semantics></math> to the moduli space of genus <math id="S5.SS2.SSS1.p3.m7" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> curves with <math id="S5.SS2.SSS1.p3.m8" class="ltx_Math" alttext="2+d^{\prime}" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo>+</mo><msup><mi>d</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">2+d^{\prime}</annotation></semantics></math> marked points with smooth domains. Following <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx23" title="" class="ltx_ref">KSV95</a>, Section 3.2]</cite>, <math id="S5.SS2.SSS1.p3.m9" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{0,2,d^{\prime}}^{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mn>0</mn><mo>,</mo><mn>2</mn><mo>,</mo><msup><mi>d</mi><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>ℝ</mi></msup></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{0,2,d^{\prime}}^{\mathbb{R}}</annotation></semantics></math> could be obtained from the Deligne–Mumford space <math id="S5.SS2.SSS1.p3.m10" class="ltx_Math" alttext="\overline{{\mathcal{M}}}_{0,2+d^{\prime}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mrow><mn>2</mn><mo>+</mo><msup><mi>d</mi><mo>′</mo></msup></mrow></mrow></msub><annotation encoding="application/x-tex">\overline{{\mathcal{M}}}_{0,2+d^{\prime}}</annotation></semantics></math> by performing real blowups along the irreducible components of the normal crossings divisor defined by stable curves with at least two cylindrical components. <math id="S5.SS2.SSS1.p3.m11" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{0,2,d^{\prime}}^{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mn>0</mn><mo>,</mo><mn>2</mn><mo>,</mo><msup><mi>d</mi><mo>′</mo></msup></mrow></msub><msup><mrow></mrow><mi>ℝ</mi></msup></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{0,2,d^{\prime}}^{\mathbb{R}}</annotation></semantics></math> is a smooth manifold with corners: for a more detailed discussion, the reader could refer to <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx26" title="" class="ltx_ref">LT98b</a>, Section 2.1]</cite> or <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx1" title="" class="ltx_ref">AB21</a>, Section 9.7]</cite>. To simplify the notation, we usually abbreviate <math id="S5.SS2.SSS1.p3.m12" class="ltx_Math" alttext="(\Sigma,{\bf L})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>𝐋</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Sigma,{\bf L})</annotation></semantics></math> as <math id="S5.SS2.SSS1.p3.m13" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> when there is no ambiguity caused by the context.</p>
</div>
</section>
<section id="S5.SS2.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">5.2.2. </span>Stable maps to projective spaces</h4>

<div id="S5.SS2.SSS2.p1" class="ltx_para">
<p id="S5.SS2.SSS2.p1.1" class="ltx_p">We consider the moduli space of genus zero stable holomorphic maps into <math id="S5.SS2.SSS2.p1.m1" class="ltx_Math" alttext="\mathbb{CP}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathbb{CP}^{d}</annotation></semantics></math> with two marked points. Denote by</p>
<table id="S5.Ex33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex33.m1" class="ltx_Math" alttext="{\mathcal{F}}:={\mathcal{F}}_{0,2}(d)\subset\overline{\mathcal{M}}_{0,2}(\mathbb{CP}^{d},d)" display="block" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>:=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}:={\mathcal{F}}_{0,2}(d)\subset\overline{\mathcal{M}}_{0,2}(\mathbb{CP}^{d},d)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS2.p1.2" class="ltx_p">the subset of maps whose image is not entirely contained in any hyperplane. Any two smooth curves in <math id="S5.SS2.SSS2.p1.m2" class="ltx_Math" alttext="{\mathcal{F}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">{\mathcal{F}}</annotation></semantics></math> can be mapped to another by an element of the symmetry group <math id="S5.SS2.SSS2.p1.m3" class="ltx_Math" alttext="PGL(d+1)" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">PGL(d+1)</annotation></semantics></math> of <math id="S5.SS2.SSS2.p1.m4" class="ltx_Math" alttext="\mathbb{CP}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathbb{CP}^{d}</annotation></semantics></math>. Let <math id="S5.SS2.SSS2.p1.m5" class="ltx_Math" alttext="{\mathcal{C}}={\mathcal{C}}_{0,2}(d)\to{\mathcal{F}}_{0,2}(d)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{C}}={\mathcal{C}}_{0,2}(d)\to{\mathcal{F}}_{0,2}(d)</annotation></semantics></math> be the universal curve which has an induced <math id="S5.SS2.SSS2.p1.m6" class="ltx_Math" alttext="PGL(d+1)" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">PGL(d+1)</annotation></semantics></math>-action.</p>
</div>
<div id="S5.Thmthm13" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm13.2" class="ltx_text ltx_font_bold">Lemma 5.13</span></span><span id="S5.Thmthm13.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm13.p1" class="ltx_para">
<p id="S5.Thmthm13.p1.1" class="ltx_p"><span id="S5.Thmthm13.p1.1.1" class="ltx_text ltx_font_italic">Both <math id="S5.Thmthm13.p1.m1" class="ltx_Math" alttext="{\mathcal{F}}_{0,2}(d)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{0,2}(d)</annotation></semantics></math> and <math id="S5.Thmthm13.p1.m2" class="ltx_Math" alttext="{\mathcal{C}}_{0,2}(d)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{C}}_{0,2}(d)</annotation></semantics></math> are smooth quasi-projective varieties. Moreover, the evaluation maps at two marked points</span></p>
<table id="S5.Ex34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex34.m1" class="ltx_Math" alttext="{\rm ev}_{+},{\rm ev}_{-}:{\mathcal{F}}_{0,2}(d)\to\mathbb{CP}^{d}" display="block" intent=":literal"><semantics><mrow><msub><mi>ev</mi><mo>+</mo></msub><mo>,</mo><mrow><msub><mi>ev</mi><mo>−</mo></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\rm ev}_{+},{\rm ev}_{-}:{\mathcal{F}}_{0,2}(d)\to\mathbb{CP}^{d}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmthm13.p1.2" class="ltx_p"><span id="S5.Thmthm13.p1.2.1" class="ltx_text ltx_font_italic">are smooth submersions.</span></p>
</div>
</div>
<div id="S5.SS2.SSS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.SS2.SSS2.p2" class="ltx_para">
<p id="S5.SS2.SSS2.p2.1" class="ltx_p"><span id="S5.SS2.SSS2.p2.1.1" class="ltx_text">The first statement follows from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>, Lemma 6.4]</cite>. For the submersive property, note that the natural action of <math id="S5.SS2.SSS2.p2.m1" class="ltx_Math" alttext="PGL(d+1)" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">PGL(d+1)</annotation></semantics></math> on <math id="S5.SS2.SSS2.p2.m2" class="ltx_Math" alttext="\overline{\mathcal{M}}_{0,2}(\mathbb{CP}^{d},d)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{0,2}(\mathbb{CP}^{d},d)</annotation></semantics></math> preserves the subspace <math id="S5.SS2.SSS2.p2.m3" class="ltx_Math" alttext="{\mathcal{F}}_{0,2}(d)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{0,2}(d)</annotation></semantics></math>. Because the linearization of <math id="S5.SS2.SSS2.p2.m4" class="ltx_Math" alttext="PGL(d+1)" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">PGL(d+1)</annotation></semantics></math>-action on <math id="S5.SS2.SSS2.p2.m5" class="ltx_Math" alttext="\mathbb{CP}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathbb{CP}^{d}</annotation></semantics></math> at any point defines a surjection from its Lie algebra to the tangent space of <math id="S5.SS2.SSS2.p2.m6" class="ltx_Math" alttext="\mathbb{CP}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathbb{CP}^{d}</annotation></semantics></math> at this point, the linearization of <math id="S5.SS2.SSS2.p2.m7" class="ltx_Math" alttext="{\rm ev}_{\pm}" display="inline" intent=":literal"><semantics><msub><mi>ev</mi><mo>±</mo></msub><annotation encoding="application/x-tex">{\rm ev}_{\pm}</annotation></semantics></math> is surjective as well.
∎</span></p>
</div>
</div>
</section>
<section id="S5.SS2.SSS3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">5.2.3. </span>Stable cylinders in projective spaces</h4>

<div id="S5.SS2.SSS3.p1" class="ltx_para">
<p id="S5.SS2.SSS3.p1.1" class="ltx_p">For the purpose of studying Floer theory, one needs to consider the “real” version of the above moduli spaces.</p>
</div>
<div id="S5.SS2.SSS3.p2" class="ltx_para">
<p id="S5.SS2.SSS3.p2.1" class="ltx_p">The moduli spaces of stable cylinders in <math id="S5.SS2.SSS3.p2.m1" class="ltx_Math" alttext="\mathbb{CP}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathbb{CP}^{d}</annotation></semantics></math> is the set of equivalence classes of objects</p>
<table id="S5.Ex35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex35.m1" class="ltx_Math" alttext="(\Sigma,{\bf L},u)" display="block" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>𝐋</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Sigma,{\bf L},u)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS3.p2.2" class="ltx_p">such that <math id="S5.SS2.SSS3.p2.m2" class="ltx_Math" alttext="(\Sigma,{\bf L})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>𝐋</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Sigma,{\bf L})</annotation></semantics></math> is a prestable cylinder and <math id="S5.SS2.SSS3.p2.m3" class="ltx_Math" alttext="u:\Sigma\to\mathbb{CP}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">u:\Sigma\to\mathbb{CP}^{d}</annotation></semantics></math> is a stable map, i.e., every constant component has at least three special points. The equivalence relation is defined as follows: <math id="S5.SS2.SSS3.p2.m4" class="ltx_Math" alttext="(\Sigma,{\bf L},u)\sim(\Sigma^{\prime},{\bf L}^{\prime},u^{\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>𝐋</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo>∼</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Σ</mi><mo>′</mo></msup><mo>,</mo><msup><mi>𝐋</mi><mo>′</mo></msup><mo>,</mo><msup><mi>u</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(\Sigma,{\bf L},u)\sim(\Sigma^{\prime},{\bf L}^{\prime},u^{\prime})</annotation></semantics></math> if there is an isomorphism <math id="S5.SS2.SSS3.p2.m5" class="ltx_Math" alttext="\varphi:(\Sigma,{\bf L})\cong(\Sigma^{\prime},{\bf L}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>φ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>𝐋</mi><mo stretchy="false">)</mo></mrow><mo>≅</mo><mrow><mo stretchy="false">(</mo><msup><mi mathvariant="normal">Σ</mi><mo>′</mo></msup><mo>,</mo><msup><mi>𝐋</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\varphi:(\Sigma,{\bf L})\cong(\Sigma^{\prime},{\bf L}^{\prime})</annotation></semantics></math> such that <math id="S5.SS2.SSS3.p2.m6" class="ltx_Math" alttext="u=u^{\prime}\circ\varphi" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>=</mo><mrow><msup><mi>u</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>φ</mi></mrow></mrow><annotation encoding="application/x-tex">u=u^{\prime}\circ\varphi</annotation></semantics></math>.</p>
</div>
<div id="S5.Thmthm14" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm14.2" class="ltx_text ltx_font_bold">Definition 5.14</span></span><span id="S5.Thmthm14.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm14.p1" class="ltx_para">
<p id="S5.Thmthm14.p1.1" class="ltx_p">Let <math id="S5.Thmthm14.p1.m1" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{0,2}^{\mathbb{R}}(\mathbb{P}^{d},k)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mrow><mo stretchy="false">(</mo><msup><mi>ℙ</mi><mi>d</mi></msup><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mi>ℝ</mi><mprescripts></mprescripts><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{0,2}^{\mathbb{R}}(\mathbb{P}^{d},k)</annotation></semantics></math> denote the moduli space of stable cylinders in <math id="S5.Thmthm14.p1.m2" class="ltx_Math" alttext="\mathbb{CP}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathbb{CP}^{d}</annotation></semantics></math> with degree <math id="S5.Thmthm14.p1.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> times the generator of <math id="S5.Thmthm14.p1.m4" class="ltx_Math" alttext="H_{2}(\mathbb{CP}^{d};{\mathbb{Z}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><mo>,</mo><mi>ℤ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{2}(\mathbb{CP}^{d};{\mathbb{Z}})</annotation></semantics></math>. Define</p>
<table id="S5.Ex36" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex36.m1" class="ltx_math_unparsed" alttext="{\mathcal{F}}{}_{0,2}^{\mathbb{R}}(d)=\{[\Sigma,{\bf L},u]\in\overline{\mathcal{M}}{}_{0,2}^{\mathbb{R}}(\mathbb{CP}^{d},d)\ |\ [\Sigma,u]\in{\mathcal{F}}_{0,2}(d)\}." display="block" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mi>ℝ</mi><mprescripts></mprescripts><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mrow></mrow></mmultiscripts><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">[</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>𝐋</mi><mo>,</mo><mi>u</mi><mo stretchy="false">]</mo></mrow><mo>∈</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>ℂ</mi><msup><mi>ℙ</mi><mi>d</mi></msup><mo>,</mo><mi>d</mi><mo rspace="0.500em" stretchy="false">)</mo></mrow><mrow></mrow><mi>ℝ</mi><mprescripts></mprescripts><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mrow></mrow></mmultiscripts><mo fence="false" rspace="0.667em" stretchy="false">|</mo><mrow><mo stretchy="false">[</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>u</mi><mo stretchy="false">]</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{F}}{}_{0,2}^{\mathbb{R}}(d)=\{[\Sigma,{\bf L},u]\in\overline{\mathcal{M}}{}_{0,2}^{\mathbb{R}}(\mathbb{CP}^{d},d)\ |\ [\Sigma,u]\in{\mathcal{F}}_{0,2}(d)\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S5.SS2.SSS3.p3" class="ltx_para">
<p id="S5.SS2.SSS3.p3.1" class="ltx_p">Note that the evaluation maps <math id="S5.SS2.SSS3.p3.m1" class="ltx_Math" alttext="{\rm ev}_{\pm}" display="inline" intent=":literal"><semantics><msub><mi>ev</mi><mo>±</mo></msub><annotation encoding="application/x-tex">{\rm ev}_{\pm}</annotation></semantics></math> at the two marked points on <math id="S5.SS2.SSS3.p3.m2" class="ltx_Math" alttext="{\mathcal{F}}_{0,2}(d)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{0,2}(d)</annotation></semantics></math> naturally lift to evaluation maps on <math id="S5.SS2.SSS3.p3.m3" class="ltx_math_unparsed" alttext="{\mathcal{F}}{}_{0,2}^{\mathbb{R}}(d)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mi>ℝ</mi><mprescripts></mprescripts><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">{\mathcal{F}}{}_{0,2}^{\mathbb{R}}(d)</annotation></semantics></math>.</p>
</div>
<div id="S5.Thmthm15" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm15.2" class="ltx_text ltx_font_bold">Lemma 5.15</span></span><span id="S5.Thmthm15.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm15.p1" class="ltx_para">
<p id="S5.Thmthm15.p1.1" class="ltx_p"><span id="S5.Thmthm15.p1.1.1" class="ltx_text ltx_font_italic">There exists a natural structure of smooth <math id="S5.Thmthm15.p1.m1" class="ltx_Math" alttext="{\mathbb{A}}_{d}" display="inline" intent=":literal"><semantics><msub><mi>𝔸</mi><mi>d</mi></msub><annotation encoding="application/x-tex">{\mathbb{A}}_{d}</annotation></semantics></math>-manifold on <math id="S5.Thmthm15.p1.m2" class="ltx_math_unparsed" alttext="{\mathcal{F}}{}_{0,2}^{\mathbb{R}}(d)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mi>ℝ</mi><mprescripts></mprescripts><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">{\mathcal{F}}{}_{0,2}^{\mathbb{R}}(d)</annotation></semantics></math> satisfying the following conditions.</span></p>
<ol id="S5.I9" class="ltx_enumerate">
<li id="S5.I9.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S5.I9.i1.p1" class="ltx_para">
<p id="S5.I9.i1.p1.1" class="ltx_p"><span id="S5.I9.i1.p1.1.1" class="ltx_text ltx_font_italic">The forgetful map </span><math id="S5.I9.i1.p1.m1" class="ltx_math_unparsed" alttext="{\mathcal{F}}{}_{0,2}^{\mathbb{R}}(d)\to{\mathcal{F}}_{0,2}(d)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mi>ℝ</mi><mprescripts></mprescripts><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mrow></mrow></mmultiscripts><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}{}_{0,2}^{\mathbb{R}}(d)\to{\mathcal{F}}_{0,2}(d)</annotation></semantics></math><span id="S5.I9.i1.p1.1.2" class="ltx_text ltx_font_italic"> is smooth.</span></p>
</div></li>
<li id="S5.I9.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S5.I9.i2.p1" class="ltx_para">
<p id="S5.I9.i2.p1.1" class="ltx_p"><span id="S5.I9.i2.p1.1.1" class="ltx_text ltx_font_italic">The evaluation maps </span><math id="S5.I9.i2.p1.m1" class="ltx_Math" alttext="{\rm ev}_{\pm}:[\Sigma,{\bf L},u]\mapsto u(z_{\pm})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ev</mi><mo>±</mo></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>𝐋</mi><mo>,</mo><mi>u</mi></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">↦</mo><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mo>±</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\rm ev}_{\pm}:[\Sigma,{\bf L},u]\mapsto u(z_{\pm})</annotation></semantics></math><span id="S5.I9.i2.p1.1.2" class="ltx_text ltx_font_italic"> are smooth and they are stratified submersive (see Definition </span><a href="#S3.Thmthm19" title="Definition 3.19. ‣ 3.4.2. Stratified smooth manifolds with corners ‣ 3.4. Derived orbifold charts with stratifications ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">3.19</span></a><span id="S5.I9.i2.p1.1.3" class="ltx_text ltx_font_italic">).</span></p>
</div></li>
<li id="S5.I9.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S5.I9.i3.p1" class="ltx_para">
<p id="S5.I9.i3.p1.1" class="ltx_p"><span id="S5.I9.i3.p1.1.1" class="ltx_text ltx_font_italic">For any element </span><math id="S5.I9.i3.p1.m1" class="ltx_math_unparsed" alttext="a\in{\mathcal{F}}{}_{0,2}^{\mathbb{R}}(d)" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mi>ℝ</mi><mprescripts></mprescripts><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">a\in{\mathcal{F}}{}_{0,2}^{\mathbb{R}}(d)</annotation></semantics></math><span id="S5.I9.i3.p1.1.2" class="ltx_text ltx_font_italic"> represented by </span><math id="S5.I9.i3.p1.m2" class="ltx_Math" alttext="(u,\Sigma,{\bf L})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>𝐋</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u,\Sigma,{\bf L})</annotation></semantics></math><span id="S5.I9.i3.p1.1.3" class="ltx_text ltx_font_italic">, choose a generic collection of </span><math id="S5.I9.i3.p1.m3" class="ltx_Math" alttext="d^{\prime}=d(d+2)" display="inline" intent=":literal"><semantics><mrow><msup><mi>d</mi><mo>′</mo></msup><mo>=</mo><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">d^{\prime}=d(d+2)</annotation></semantics></math><span id="S5.I9.i3.p1.1.4" class="ltx_text ltx_font_italic"> hyperplanes and </span><math id="S5.I9.i3.p1.m4" class="ltx_Math" alttext="w_{1},\ldots,w_{d^{\prime}}\in\Sigma" display="inline" intent=":literal"><semantics><mrow><msub><mi>w</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>w</mi><msup><mi>d</mi><mo>′</mo></msup></msub><mo>∈</mo><mi mathvariant="normal">Σ</mi></mrow></mrow><annotation encoding="application/x-tex">w_{1},\ldots,w_{d^{\prime}}\in\Sigma</annotation></semantics></math><span id="S5.I9.i3.p1.1.5" class="ltx_text ltx_font_italic"> such that </span><math id="S5.I9.i3.p1.m5" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math><span id="S5.I9.i3.p1.1.6" class="ltx_text ltx_font_italic"> intersects with </span><math id="S5.I9.i3.p1.m6" class="ltx_Math" alttext="H_{i}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mi>i</mi></msub><annotation encoding="application/x-tex">H_{i}</annotation></semantics></math><span id="S5.I9.i3.p1.1.7" class="ltx_text ltx_font_italic"> transversely at </span><math id="S5.I9.i3.p1.m7" class="ltx_Math" alttext="w_{i}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mi>i</mi></msub><annotation encoding="application/x-tex">w_{i}</annotation></semantics></math><span id="S5.I9.i3.p1.1.8" class="ltx_text ltx_font_italic">. Then the locally defined map given by taking a stable cylinder to the marked stable cylinder where the marked points are specified by the intersections with these hyperplanes is a diffeomorphism to an open subset of </span><math id="S5.I9.i3.p1.m8" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{0,2+d^{\prime}}^{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mn>0</mn><mo>,</mo><mrow><mn>2</mn><mo>+</mo><msup><mi>d</mi><mo>′</mo></msup></mrow></mrow></msub><msup><mrow></mrow><mi>ℝ</mi></msup></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{0,2+d^{\prime}}^{\mathbb{R}}</annotation></semantics></math><span id="S5.I9.i3.p1.1.9" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S5.SS2.SSS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.SS2.SSS3.p4" class="ltx_para">
<p id="S5.SS2.SSS3.p4.1" class="ltx_p"><span id="S5.SS2.SSS3.p4.1.1" class="ltx_text">Consider the subspace of <math id="S5.SS2.SSS3.p4.m1" class="ltx_Math" alttext="{\mathcal{F}}_{0,2}(d)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{0,2}(d)</annotation></semantics></math> which consists of stable holomorphic maps with exactly two cylindrical components of degrees <math id="S5.SS2.SSS3.p4.m2" class="ltx_Math" alttext="d_{1}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mn>1</mn></msub><annotation encoding="application/x-tex">d_{1}</annotation></semantics></math> and <math id="S5.SS2.SSS3.p4.m3" class="ltx_Math" alttext="d_{2}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mn>2</mn></msub><annotation encoding="application/x-tex">d_{2}</annotation></semantics></math>. Denote by the closure of this space in <math id="S5.SS2.SSS3.p4.m4" class="ltx_Math" alttext="{\mathcal{F}}_{0,2}(d)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{0,2}(d)</annotation></semantics></math> by <math id="S5.SS2.SSS3.p4.m5" class="ltx_Math" alttext="{\mathcal{F}}_{0,2}(d_{1},d_{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{0,2}(d_{1},d_{2})</annotation></semantics></math>. Then <math id="S5.SS2.SSS3.p4.m6" class="ltx_Math" alttext="{\mathcal{F}}_{0,2}(d_{1},d_{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{0,2}(d_{1},d_{2})</annotation></semantics></math> is a smooth divisor in the quasi-projective variety <math id="S5.SS2.SSS3.p4.m7" class="ltx_Math" alttext="{\mathcal{F}}_{0,2}(d)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{0,2}(d)</annotation></semantics></math>. We can consider the real blowup of <math id="S5.SS2.SSS3.p4.m8" class="ltx_Math" alttext="{\mathcal{F}}_{0,2}(d)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{0,2}(d)</annotation></semantics></math> along <math id="S5.SS2.SSS3.p4.m9" class="ltx_Math" alttext="{\mathcal{F}}_{0,2}(d_{1},d_{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{0,2}(d_{1},d_{2})</annotation></semantics></math> ranging over all <math id="S5.SS2.SSS3.p4.m10" class="ltx_Math" alttext="d_{1}+d_{2}=d" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><msub><mi>d</mi><mn>2</mn></msub></mrow><mo>=</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">d_{1}+d_{2}=d</annotation></semantics></math> and denote it by <math id="S5.SS2.SSS3.p4.m11" class="ltx_Math" alttext="{\mathbb{R}}{\mathcal{F}}_{0,2}(d)" display="inline" intent=":literal"><semantics><mrow><mi>ℝ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{R}}{\mathcal{F}}_{0,2}(d)</annotation></semantics></math>.</span></p>
</div>
<div id="S5.SS2.SSS3.p5" class="ltx_para">
<p id="S5.SS2.SSS3.p5.1" class="ltx_p"><span id="S5.SS2.SSS3.p5.1.1" class="ltx_text">We claim that <math id="S5.SS2.SSS3.p5.m1" class="ltx_Math" alttext="{\mathcal{F}}_{0,2}^{\mathbb{R}}(d)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mi>ℝ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{0,2}^{\mathbb{R}}(d)</annotation></semantics></math> is an <math id="S5.SS2.SSS3.p5.m2" class="ltx_Math" alttext="S^{1}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mn>1</mn></msup><annotation encoding="application/x-tex">S^{1}</annotation></semantics></math>-bundle over <math id="S5.SS2.SSS3.p5.m3" class="ltx_Math" alttext="{\mathbb{R}}{\mathcal{F}}_{0,2}(d)" display="inline" intent=":literal"><semantics><mrow><mi>ℝ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{R}}{\mathcal{F}}_{0,2}(d)</annotation></semantics></math>. Indeed, given any stable cylinder <math id="S5.SS2.SSS3.p5.m4" class="ltx_math_unparsed" alttext="(\Sigma,{\bf L},u)\in{\mathcal{F}}{}_{0,2}^{\mathbb{R}}(d)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>𝐋</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mi>ℝ</mi><mprescripts></mprescripts><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">(\Sigma,{\bf L},u)\in{\mathcal{F}}{}_{0,2}^{\mathbb{R}}(d)</annotation></semantics></math> with <math id="S5.SS2.SSS3.p5.m5" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> horizontal levels, denote by <math id="S5.SS2.SSS3.p5.m6" class="ltx_Math" alttext="\theta_{i}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\theta_{i}</annotation></semantics></math> to be the <math id="S5.SS2.SSS3.p5.m7" class="ltx_Math" alttext="S^{1}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mn>1</mn></msup><annotation encoding="application/x-tex">S^{1}</annotation></semantics></math>-parameter of the lateral line on the <math id="S5.SS2.SSS3.p5.m8" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th cylindrical component of <math id="S5.SS2.SSS3.p5.m9" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math>, with the convention that the first component contains <math id="S5.SS2.SSS3.p5.m10" class="ltx_Math" alttext="z_{-}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mo>−</mo></msub><annotation encoding="application/x-tex">z_{-}</annotation></semantics></math> while the <math id="S5.SS2.SSS3.p5.m11" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-th component contains <math id="S5.SS2.SSS3.p5.m12" class="ltx_Math" alttext="z_{+}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mo>+</mo></msub><annotation encoding="application/x-tex">z_{+}</annotation></semantics></math>. Then the datum</span></p>
<table id="S5.Ex37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex37.m1" class="ltx_Math" alttext="(\Sigma,u,[\theta_{2}-\theta_{1}],\dots,[\theta_{k}-\theta_{k-1}])" display="block" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>u</mi><mo>,</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>θ</mi><mn>2</mn></msub><mo>−</mo><msub><mi>θ</mi><mn>1</mn></msub></mrow><mo stretchy="false">]</mo></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>θ</mi><mi>k</mi></msub><mo>−</mo><msub><mi>θ</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Sigma,u,[\theta_{2}-\theta_{1}],\dots,[\theta_{k}-\theta_{k-1}])</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS3.p5.2" class="ltx_p"><span id="S5.SS2.SSS3.p5.2.1" class="ltx_text">defines a point in <math id="S5.SS2.SSS3.p5.m13" class="ltx_Math" alttext="{\mathbb{R}}{\mathcal{F}}_{0,2}(d)" display="inline" intent=":literal"><semantics><mrow><mi>ℝ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{R}}{\mathcal{F}}_{0,2}(d)</annotation></semantics></math> because <math id="S5.SS2.SSS3.p5.m14" class="ltx_Math" alttext="\theta_{i}-\theta_{i-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mi>i</mi></msub><mo>−</mo><msub><mi>θ</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\theta_{i}-\theta_{i-1}</annotation></semantics></math> can be identified with the <math id="S5.SS2.SSS3.p5.m15" class="ltx_Math" alttext="S^{1}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mn>1</mn></msup><annotation encoding="application/x-tex">S^{1}</annotation></semantics></math>-parameter in the exceptional divisor associated to some <math id="S5.SS2.SSS3.p5.m16" class="ltx_Math" alttext="{\mathcal{F}}_{0,2}(d_{1},d_{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{0,2}(d_{1},d_{2})</annotation></semantics></math>. Conversely, given <math id="S5.SS2.SSS3.p5.m17" class="ltx_Math" alttext="\theta\in S^{1}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><msup><mi>S</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">\theta\in S^{1}</annotation></semantics></math> and an element in <math id="S5.SS2.SSS3.p5.m18" class="ltx_Math" alttext="{\mathbb{R}}{\mathcal{F}}_{0,2}(d)" display="inline" intent=":literal"><semantics><mrow><mi>ℝ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{R}}{\mathcal{F}}_{0,2}(d)</annotation></semantics></math>, we can define an element <math id="S5.SS2.SSS3.p5.m19" class="ltx_Math" alttext="(\Sigma,{\bf L},u)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>𝐋</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Sigma,{\bf L},u)</annotation></semantics></math> in <math id="S5.SS2.SSS3.p5.m20" class="ltx_Math" alttext="{\mathcal{F}}_{0,2}^{\mathbb{R}}(d)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mi>ℝ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{0,2}^{\mathbb{R}}(d)</annotation></semantics></math> by requiring <math id="S5.SS2.SSS3.p5.m21" class="ltx_Math" alttext="(\Sigma,u)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Sigma,u)</annotation></semantics></math> to be the image of the blow-down map <math id="S5.SS2.SSS3.p5.m22" class="ltx_Math" alttext="{\mathbb{R}}{\mathcal{F}}_{0,2}(d)\to{\mathcal{F}}_{0,2}(d)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℝ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{R}}{\mathcal{F}}_{0,2}(d)\to{\mathcal{F}}_{0,2}(d)</annotation></semantics></math> and the lateral line <math id="S5.SS2.SSS3.p5.m23" class="ltx_Math" alttext="{\bf L}" display="inline" intent=":literal"><semantics><mi>𝐋</mi><annotation encoding="application/x-tex">{\bf L}</annotation></semantics></math> is defined by the converse process of the previous construction. Note that these constructions are well-defined after choosing local coordinates near each stratum of <math id="S5.SS2.SSS3.p5.m24" class="ltx_Math" alttext="{\mathcal{F}}_{0,2}(d)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{0,2}(d)</annotation></semantics></math> and they can be patched up together. Using this description, we can view <math id="S5.SS2.SSS3.p5.m25" class="ltx_Math" alttext="{\mathcal{F}}_{0,2}^{\mathbb{R}}(d)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mi>ℝ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{0,2}^{\mathbb{R}}(d)</annotation></semantics></math> as manifold with corners because <math id="S5.SS2.SSS3.p5.m26" class="ltx_Math" alttext="{\mathbb{R}}{\mathcal{F}}_{0,2}(d)" display="inline" intent=":literal"><semantics><mrow><mi>ℝ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{R}}{\mathcal{F}}_{0,2}(d)</annotation></semantics></math> is so. Moreover, <math id="S5.SS2.SSS3.p5.m27" class="ltx_Math" alttext="{\mathcal{F}}_{0,2}^{\mathbb{R}}(d)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mi>ℝ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{0,2}^{\mathbb{R}}(d)</annotation></semantics></math> is actually a manifold with faces, with codimension-<math id="S5.SS2.SSS3.p5.m28" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> faces corresponding to a partition <math id="S5.SS2.SSS3.p5.m29" class="ltx_Math" alttext="d=d_{1}+d_{2}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><msub><mi>d</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">d=d_{1}+d_{2}</annotation></semantics></math>.</span></p>
</div>
<div id="S5.SS2.SSS3.p6" class="ltx_para">
<p id="S5.SS2.SSS3.p6.1" class="ltx_p"><span id="S5.SS2.SSS3.p6.1.1" class="ltx_text">The forgetful map <math id="S5.SS2.SSS3.p6.m1" class="ltx_Math" alttext="{\mathcal{F}}_{0,2}^{\mathbb{R}}(d)\to{\mathcal{F}}_{0,2}(d)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mi>ℝ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{0,2}^{\mathbb{R}}(d)\to{\mathcal{F}}_{0,2}(d)</annotation></semantics></math> is defined by <math id="S5.SS2.SSS3.p6.m2" class="ltx_Math" alttext="(u,\Sigma,{\bf L})\mapsto(u,\Sigma)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>𝐋</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">↦</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi mathvariant="normal">Σ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(u,\Sigma,{\bf L})\mapsto(u,\Sigma)</annotation></semantics></math>, which factors through the projection <math id="S5.SS2.SSS3.p6.m3" class="ltx_Math" alttext="{\mathcal{F}}_{0,2}^{\mathbb{R}}(d)\to{\mathbb{R}}{\mathcal{F}}_{0,2}(d)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mi>ℝ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>ℝ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{0,2}^{\mathbb{R}}(d)\to{\mathbb{R}}{\mathcal{F}}_{0,2}(d)</annotation></semantics></math> and the blow-down map <math id="S5.SS2.SSS3.p6.m4" class="ltx_Math" alttext="{\mathbb{R}}{\mathcal{F}}_{0,2}(d)\to{\mathcal{F}}_{0,2}(d)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℝ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{R}}{\mathcal{F}}_{0,2}(d)\to{\mathcal{F}}_{0,2}(d)</annotation></semantics></math>, therefore it is smooth. The evaluation map <math id="S5.SS2.SSS3.p6.m5" class="ltx_Math" alttext="\text{ev}_{+}" display="inline" intent=":literal"><semantics><msub><mtext>ev</mtext><mo>+</mo></msub><annotation encoding="application/x-tex">\text{ev}_{+}</annotation></semantics></math> (resp. <math id="S5.SS2.SSS3.p6.m6" class="ltx_Math" alttext="\text{ev}_{-}" display="inline" intent=":literal"><semantics><msub><mtext>ev</mtext><mo>−</mo></msub><annotation encoding="application/x-tex">\text{ev}_{-}</annotation></semantics></math>) is the composition of the forgetful map <math id="S5.SS2.SSS3.p6.m7" class="ltx_Math" alttext="{\mathcal{F}}_{0,2}^{\mathbb{R}}(d)\to{\mathcal{F}}_{0,2}(d)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mi>ℝ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{0,2}^{\mathbb{R}}(d)\to{\mathcal{F}}_{0,2}(d)</annotation></semantics></math> and the ordinary evaluation map <math id="S5.SS2.SSS3.p6.m8" class="ltx_Math" alttext="\text{ev}_{+}:{\mathcal{F}}_{0,2}(d)\rightarrow{\mathbb{C}P}^{d}" display="inline" intent=":literal"><semantics><mrow><msub><mtext>ev</mtext><mo>+</mo></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mi>d</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{ev}_{+}:{\mathcal{F}}_{0,2}(d)\rightarrow{\mathbb{C}P}^{d}</annotation></semantics></math> (resp. <math id="S5.SS2.SSS3.p6.m9" class="ltx_Math" alttext="\text{ev}_{-}:{\mathcal{F}}_{0,2}(d)\rightarrow{\mathbb{C}P}^{d}" display="inline" intent=":literal"><semantics><mrow><msub><mtext>ev</mtext><mo>−</mo></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mi>d</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{ev}_{-}:{\mathcal{F}}_{0,2}(d)\rightarrow{\mathbb{C}P}^{d}</annotation></semantics></math>), so <math id="S5.SS2.SSS3.p6.m10" class="ltx_Math" alttext="\text{ev}_{\pm}" display="inline" intent=":literal"><semantics><msub><mtext>ev</mtext><mo>±</mo></msub><annotation encoding="application/x-tex">\text{ev}_{\pm}</annotation></semantics></math> are smooth as well. Accordingly, <math id="S5.SS2.SSS3.p6.m11" class="ltx_Math" alttext="\text{ev}_{\pm}" display="inline" intent=":literal"><semantics><msub><mtext>ev</mtext><mo>±</mo></msub><annotation encoding="application/x-tex">\text{ev}_{\pm}</annotation></semantics></math> are stratified submersive following the same proof of Lemma <a href="#S5.Thmthm13" title="Lemma 5.13. ‣ 5.2.2. Stable maps to projective spaces ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.13</span></a> because the action of <math id="S5.SS2.SSS3.p6.m12" class="ltx_Math" alttext="PGL(d+1)" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">PGL(d+1)</annotation></semantics></math> preserves the strata of the simple normal crossings divisor defined by <math id="S5.SS2.SSS3.p6.m13" class="ltx_Math" alttext="F_{0,2}(d_{1}+d_{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>F</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><msub><mi>d</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F_{0,2}(d_{1}+d_{2})</annotation></semantics></math>.</span></p>
</div>
<div id="S5.SS2.SSS3.p7" class="ltx_para">
<p id="S5.SS2.SSS3.p7.1" class="ltx_p"><span id="S5.SS2.SSS3.p7.1.1" class="ltx_text">For the last statement, it follows from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>, Proposition 6.5]</cite> and the descriptions of <math id="S5.SS2.SSS3.p7.m1" class="ltx_Math" alttext="{\mathcal{F}}_{0,2}^{\mathbb{R}}(d)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mi>ℝ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{0,2}^{\mathbb{R}}(d)</annotation></semantics></math> and <math id="S5.SS2.SSS3.p7.m2" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{0,2+d^{\prime}}^{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mn>0</mn><mo>,</mo><mrow><mn>2</mn><mo>+</mo><msup><mi>d</mi><mo>′</mo></msup></mrow></mrow></msub><msup><mrow></mrow><mi>ℝ</mi></msup></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{0,2+d^{\prime}}^{\mathbb{R}}</annotation></semantics></math> as <math id="S5.SS2.SSS3.p7.m3" class="ltx_Math" alttext="S^{1}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mn>1</mn></msup><annotation encoding="application/x-tex">S^{1}</annotation></semantics></math>-bundles over real blowups.
∎</span></p>
</div>
</div>
</section>
<section id="S5.SS2.SSS4" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">5.2.4. </span>A system of auxiliary moduli spaces</h4>

<div id="S5.SS2.SSS4.p1" class="ltx_para">
<p id="S5.SS2.SSS4.p1.1" class="ltx_p">Stable cylinders in projective spaces serve as models of domains of Floer trajectories. Because of the existence of broken Floer trajectories, we need to construct a system of moduli spaces of stable cylinders to capture the information from these boundary strata.</p>
</div>
<div id="S5.Thmthm16" class="ltx_theorem ltx_theorem_notation">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm16.2" class="ltx_text ltx_font_italic">Notation 5.16</span></span><span id="S5.Thmthm16.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S5.Thmthm16.p1" class="ltx_para">
<ol id="S5.I10" class="ltx_enumerate">
<li id="S5.I10.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S5.I10.i1.p1" class="ltx_para">
<p id="S5.I10.i1.p1.1" class="ltx_p">Whenever <math id="S5.I10.i1.p1.m1" class="ltx_Math" alttext="{\mathcal{A}}^{\rm Floer}(p)\leq{\mathcal{A}}^{\rm Floer}(r)&lt;{\mathcal{A}}^{\rm Floer}(s)\leq{\mathcal{A}}^{\rm Floer}(q)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>Floer</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>Floer</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>Floer</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>Floer</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{A}}^{\rm Floer}(p)\leq{\mathcal{A}}^{\rm Floer}(r)&lt;{\mathcal{A}}^{\rm Floer}(s)\leq{\mathcal{A}}^{\rm Floer}(q)</annotation></semantics></math>, embed <math id="S5.I10.i1.p1.m2" class="ltx_Math" alttext="\mathbb{CP}^{d_{rs}}" display="inline" intent=":literal"><semantics><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><msub><mi>d</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub></msup></mrow><annotation encoding="application/x-tex">\mathbb{CP}^{d_{rs}}</annotation></semantics></math> into <math id="S5.I10.i1.p1.m3" class="ltx_Math" alttext="\mathbb{CP}^{d_{pq}}" display="inline" intent=":literal"><semantics><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msup></mrow><annotation encoding="application/x-tex">\mathbb{CP}^{d_{pq}}</annotation></semantics></math> using the map</p>
<table id="S5.Ex38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex38.m1" class="ltx_Math" alttext="[z_{0},\ldots,z_{d_{rs}}]\mapsto\big[\ \underbrace{0,\ldots,0}_{d_{pr}},z_{0},\ldots,z_{d_{rs}},\underbrace{0,\ldots,0}_{d_{sq}}\ \big]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">[</mo><mrow><msub><mi>z</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>z</mi><msub><mi>d</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub></msub></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">↦</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><munder><munder accentunder="true"><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn></mrow><mo stretchy="true">⏟</mo></munder><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></munder><mo>,</mo><msub><mi>z</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>z</mi><msub><mi>d</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub></msub><mo>,</mo><munder><munder accentunder="true"><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn></mrow><mo stretchy="true">⏟</mo></munder><msub><mi>d</mi><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></munder></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">[z_{0},\ldots,z_{d_{rs}}]\mapsto\big[\ \underbrace{0,\ldots,0}_{d_{pr}},z_{0},\ldots,z_{d_{rs}},\underbrace{0,\ldots,0}_{d_{sq}}\ \big].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S5.I10.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S5.I10.i2.p1" class="ltx_para">
<p id="S5.I10.i2.p1.1" class="ltx_p">The <span id="S5.I10.i2.p1.1.1" class="ltx_text ltx_font_bold">system of auxiliary moduli spaces</span> is the collection of moduli spaces</p>
<table id="S5.Ex39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex39.m1" class="ltx_math_unparsed" alttext="B_{d}:=\big\{x=[\Sigma,{\bf L},u]\in{\mathcal{F}}{}_{0,2}^{\mathbb{R}}(d)\ |\ {\rm ev}_{-}(x)=[1,0,\ldots,0]\in\mathbb{CP}^{d}\big\}." display="block" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>d</mi></msub><mo>:=</mo><mrow><mo stretchy="false">{</mo><mi>x</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>𝐋</mi><mo>,</mo><mi>u</mi><mo stretchy="false">]</mo></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>d</mi><mo rspace="0.500em" stretchy="false">)</mo></mrow><mrow></mrow><mi>ℝ</mi><mprescripts></mprescripts><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mrow></mrow></mmultiscripts><mo fence="false" rspace="0.667em" stretchy="false">|</mo><msub><mi>ev</mi><mo>−</mo></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn><mo stretchy="false">]</mo></mrow><mo>∈</mo><mi>ℂ</mi><msup><mi>ℙ</mi><mi>d</mi></msup><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">B_{d}:=\big\{x=[\Sigma,{\bf L},u]\in{\mathcal{F}}{}_{0,2}^{\mathbb{R}}(d)\ |\ {\rm ev}_{-}(x)=[1,0,\ldots,0]\in\mathbb{CP}^{d}\big\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I10.i2.p1.2" class="ltx_p">For a partition of <math id="S5.I10.i2.p1.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> given by <math id="S5.I10.i2.p1.m2" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> from which <math id="S5.I10.i2.p1.m3" class="ltx_Math" alttext="d=d_{0}+\cdots+d_{l}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>d</mi><mi>l</mi></msub></mrow></mrow><annotation encoding="application/x-tex">d=d_{0}+\cdots+d_{l}</annotation></semantics></math>, we define</p>
<table id="S5.Ex40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex40.m1" class="ltx_math_unparsed" alttext="B_{\delta}:=B_{d_{0}}\times\cdots\times B_{d_{l}}." display="block" intent=":literal"><semantics><mrow><mi>B</mi><msub><mrow></mrow><mi>δ</mi></msub><mo>:=</mo><mi>B</mi><msub><mrow></mrow><msub><mi>d</mi><mn>0</mn></msub></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi>B</mi><msub><mrow></mrow><msub><mi>d</mi><mi>l</mi></msub></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">B_{\delta}:=B_{d_{0}}\times\cdots\times B_{d_{l}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I10.i2.p1.3" class="ltx_p">Using this notation, define</p>
<table id="S5.Ex41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex41.m1" class="ltx_Math" alttext="B_{\alpha}:=B_{\delta(\alpha)},\ {\rm where}\ \alpha\in{\mathbb{A}}_{pq}^{\rm Floer}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>B</mi><mi>α</mi></msub><mo>:=</mo><msub><mi>B</mi><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mi>where</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>α</mi></mrow><mo>∈</mo><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>Floer</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">B_{\alpha}:=B_{\delta(\alpha)},\ {\rm where}\ \alpha\in{\mathbb{A}}_{pq}^{\rm Floer}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I10.i2.p1.4" class="ltx_p">where <math id="S5.I10.i2.p1.m4" class="ltx_Math" alttext="\alpha\mapsto\delta(\alpha)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo stretchy="false">↦</mo><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\alpha\mapsto\delta(\alpha)</annotation></semantics></math> is the poset map (<a href="#S5.E2" title="In item 2 ‣ Notation 5.7. ‣ 5.1.4. Notations ‣ 5.1. Basic notions and the main theorem about global charts ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.2</span></a>).</p>
</div></li>
</ol>
</div>
</div>
<div id="S5.Thmthm17" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm17.2" class="ltx_text ltx_font_bold">Lemma 5.17</span></span><span id="S5.Thmthm17.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm17.p1" class="ltx_para">
<p id="S5.Thmthm17.p1.1" class="ltx_p"><math id="S5.Thmthm17.p1.m1" class="ltx_Math" alttext="B_{d}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>d</mi></msub><annotation encoding="application/x-tex">B_{d}</annotation></semantics></math><span id="S5.Thmthm17.p1.1.1" class="ltx_text ltx_font_italic"> is a smooth <math id="S5.Thmthm17.p1.m2" class="ltx_Math" alttext="{\mathbb{A}}_{d}" display="inline" intent=":literal"><semantics><msub><mi>𝔸</mi><mi>d</mi></msub><annotation encoding="application/x-tex">{\mathbb{A}}_{d}</annotation></semantics></math>-manifold with a smooth <math id="S5.Thmthm17.p1.m3" class="ltx_Math" alttext="G_{d}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>d</mi></msub><annotation encoding="application/x-tex">G_{d}</annotation></semantics></math>-action.</span></p>
</div>
</div>
<div id="S5.SS2.SSS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.SS2.SSS4.p2" class="ltx_para">
<p id="S5.SS2.SSS4.p2.1" class="ltx_p"><span id="S5.SS2.SSS4.p2.1.1" class="ltx_text">This is a consequence of the blowup description of <math id="S5.SS2.SSS4.p2.m1" class="ltx_math_unparsed" alttext="{\mathcal{F}}{}_{0,2}^{\mathbb{R}}(d)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mi>ℝ</mi><mprescripts></mprescripts><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">{\mathcal{F}}{}_{0,2}^{\mathbb{R}}(d)</annotation></semantics></math> as from Lemma <a href="#S5.Thmthm15" title="Lemma 5.15. ‣ 5.2.3. Stable cylinders in projective spaces ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.15</span></a>, the fact that <math id="S5.SS2.SSS4.p2.m2" class="ltx_Math" alttext="{\rm ev}_{-}:{\mathcal{F}}^{\mathbb{R}}_{0,2}(d)\rightarrow\mathbb{CP}^{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ev</mi><mo>−</mo></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mi>ℝ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">{\rm ev}_{-}:{\mathcal{F}}^{\mathbb{R}}_{0,2}(d)\rightarrow\mathbb{CP}^{d}</annotation></semantics></math> is a stratified submersive, and Lemma <a href="#S3.Thmthm20" title="Lemma 3.20. ‣ 3.4.2. Stratified smooth manifolds with corners ‣ 3.4. Derived orbifold charts with stratifications ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.20</span></a>. ∎</span></p>
</div>
</div>
<div id="S5.SS2.SSS4.p3" class="ltx_para">
<p id="S5.SS2.SSS4.p3.1" class="ltx_p">For a partition <math id="S5.SS2.SSS4.p3.m1" class="ltx_Math" alttext="\delta\in{\mathbb{A}}_{d}" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><msub><mi>𝔸</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\delta\in{\mathbb{A}}_{d}</annotation></semantics></math>, denote by <math id="S5.SS2.SSS4.p3.m2" class="ltx_Math" alttext="\partial^{\delta}\mathring{B}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mi>δ</mi></msup><mover accent="true"><mi>B</mi><mo>̊</mo></mover></mrow><annotation encoding="application/x-tex">\partial^{\delta}\mathring{B}</annotation></semantics></math> the locally closed smooth <math id="S5.SS2.SSS4.p3.m3" class="ltx_Math" alttext="G_{d}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>d</mi></msub><annotation encoding="application/x-tex">G_{d}</annotation></semantics></math>-submanifold of <math id="S5.SS2.SSS4.p3.m4" class="ltx_Math" alttext="B_{d}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>d</mi></msub><annotation encoding="application/x-tex">B_{d}</annotation></semantics></math> given by</p>
<table id="S5.Ex42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex42.m1" class="ltx_Math" alttext="\partial^{\delta}\mathring{B}:=\partial^{\delta}B\setminus\bigcup_{\delta^{\prime}&lt;\delta}\partial^{\delta^{\prime}}B." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mo>∂</mo><mi>δ</mi></msup><mover accent="true"><mi>B</mi><mo>̊</mo></mover></mrow><mo rspace="0.111em">:=</mo><mrow><mrow><msup><mo>∂</mo><mi>δ</mi></msup><mi>B</mi></mrow><mo rspace="0.055em">∖</mo><mrow><munder><mo movablelimits="false" rspace="0em">⋃</mo><mrow><msup><mi>δ</mi><mo>′</mo></msup><mo>&lt;</mo><mi>δ</mi></mrow></munder><mrow><msup><mo>∂</mo><msup><mi>δ</mi><mo>′</mo></msup></msup><mi>B</mi></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\partial^{\delta}\mathring{B}:=\partial^{\delta}B\setminus\bigcup_{\delta^{\prime}&lt;\delta}\partial^{\delta^{\prime}}B.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S5.Thmthm18" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm18.2" class="ltx_text ltx_font_bold">Definition 5.18</span></span><span id="S5.Thmthm18.3" class="ltx_text ltx_font_bold"> </span>(Normalized evaluation)<span id="S5.Thmthm18.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm18.p1" class="ltx_para">
<p id="S5.Thmthm18.p1.1" class="ltx_p">Given <math id="S5.Thmthm18.p1.m1" class="ltx_Math" alttext="x\in B_{d}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msub><mi>B</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">x\in B_{d}</annotation></semantics></math>, its <span id="S5.Thmthm18.p1.1.1" class="ltx_text ltx_font_bold">normalized evaluation</span> at <math id="S5.Thmthm18.p1.m2" class="ltx_Math" alttext="z_{+}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mo>+</mo></msub><annotation encoding="application/x-tex">z_{+}</annotation></semantics></math> is a unit vector <math id="S5.Thmthm18.p1.m3" class="ltx_Math" alttext="(a_{0},\ldots,a_{d})\in{\mathbb{C}}^{d}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>ℂ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">(a_{0},\ldots,a_{d})\in{\mathbb{C}}^{d}</annotation></semantics></math> specified as follows. Suppose <math id="S5.Thmthm18.p1.m4" class="ltx_Math" alttext="\delta=(d_{0},\ldots,d_{l})" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>d</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta=(d_{0},\ldots,d_{l})</annotation></semantics></math> and <math id="S5.Thmthm18.p1.m5" class="ltx_Math" alttext="x\in\partial^{\delta}\mathring{B}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo rspace="0.111em">∈</mo><mrow><msup><mo>∂</mo><mi>δ</mi></msup><mover accent="true"><mi>B</mi><mo>̊</mo></mover></mrow></mrow><annotation encoding="application/x-tex">x\in\partial^{\delta}\mathring{B}</annotation></semantics></math>. Assume that <math id="S5.Thmthm18.p1.m6" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> is represented by a stable cylinder <math id="S5.Thmthm18.p1.m7" class="ltx_Math" alttext="(\Sigma,{\bf L},u)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>𝐋</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Sigma,{\bf L},u)</annotation></semantics></math>. Let <math id="S5.Thmthm18.p1.m8" class="ltx_Math" alttext="\Theta_{i}^{0}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Θ</mi><mi>i</mi><mn>0</mn></msubsup><annotation encoding="application/x-tex">\Theta_{i}^{0}</annotation></semantics></math> be <math id="S5.Thmthm18.p1.m9" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th cylindrical component of the domain <math id="S5.Thmthm18.p1.m10" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> and let <math id="S5.Thmthm18.p1.m11" class="ltx_Math" alttext="u_{i}^{0}" display="inline" intent=":literal"><semantics><msubsup><mi>u</mi><mi>i</mi><mn>0</mn></msubsup><annotation encoding="application/x-tex">u_{i}^{0}</annotation></semantics></math> be the restriction of <math id="S5.Thmthm18.p1.m12" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> to this cylindrical component. Using the lateral lines, one can identify <math id="S5.Thmthm18.p1.m13" class="ltx_Math" alttext="\Theta_{i}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Θ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\Theta_{i}</annotation></semantics></math> with <math id="S5.Thmthm18.p1.m14" class="ltx_Math" alttext="{\mathbb{C}}^{*}" display="inline" intent=":literal"><semantics><msup><mi>ℂ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">{\mathbb{C}}^{*}</annotation></semantics></math> with the lateral line identified with the positive real axis, and with <math id="S5.Thmthm18.p1.m15" class="ltx_Math" alttext="z_{i,-}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">−</mo></mrow></msub><annotation encoding="application/x-tex">z_{i,-}</annotation></semantics></math> resp. <math id="S5.Thmthm18.p1.m16" class="ltx_Math" alttext="z_{i,+}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">+</mo></mrow></msub><annotation encoding="application/x-tex">z_{i,+}</annotation></semantics></math> identified with <math id="S5.Thmthm18.p1.m17" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> resp. <math id="S5.Thmthm18.p1.m18" class="ltx_Math" alttext="\infty" display="inline" intent=":literal"><semantics><mi mathvariant="normal">∞</mi><annotation encoding="application/x-tex">\infty</annotation></semantics></math>. Moreover, <math id="S5.Thmthm18.p1.m19" class="ltx_Math" alttext="u_{i}^{0}" display="inline" intent=":literal"><semantics><msubsup><mi>u</mi><mi>i</mi><mn>0</mn></msubsup><annotation encoding="application/x-tex">u_{i}^{0}</annotation></semantics></math> can be written as</p>
<table id="S5.Ex43" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex43.m1" class="ltx_Math" alttext="u_{i}^{0}(z)=[f_{i,0}(z),\ldots,f_{i,d}(z)]" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>u</mi><mi>i</mi><mn>0</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>f</mi><mrow><mi>i</mi><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>f</mi><mrow><mi>i</mi><mo>,</mo><mi>d</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">u_{i}^{0}(z)=[f_{i,0}(z),\ldots,f_{i,d}(z)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmthm18.p1.2" class="ltx_p">where <math id="S5.Thmthm18.p1.m20" class="ltx_Math" alttext="f_{i,0},\ldots,f_{i,d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mrow><mi>i</mi><mo>,</mo><mn>0</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><mrow><mi>i</mi><mo>,</mo><mi>d</mi></mrow></msub></mrow><annotation encoding="application/x-tex">f_{i,0},\ldots,f_{i,d}</annotation></semantics></math> are complex polynomials of degrees at most <math id="S5.Thmthm18.p1.m21" class="ltx_Math" alttext="d_{i}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi>i</mi></msub><annotation encoding="application/x-tex">d_{i}</annotation></semantics></math>. Let <math id="S5.Thmthm18.p1.m22" class="ltx_Math" alttext="d_{i}^{0}\leq d_{i}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>d</mi><mi>i</mi><mn>0</mn></msubsup><mo>≤</mo><msub><mi>d</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">d_{i}^{0}\leq d_{i}</annotation></semantics></math> be the maximal degree of these polynomials. We call a list of complex polynomials <math id="S5.Thmthm18.p1.m23" class="ltx_Math" alttext="(f_{i,0},\ldots,f_{i,d})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>i</mi><mo>,</mo><mn>0</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><mrow><mi>i</mi><mo>,</mo><mi>d</mi></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(f_{i,0},\ldots,f_{i,d})</annotation></semantics></math> a polynomial representative of <math id="S5.Thmthm18.p1.m24" class="ltx_Math" alttext="u_{i}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mi>i</mi></msub><annotation encoding="application/x-tex">u_{i}</annotation></semantics></math>. For each <math id="S5.Thmthm18.p1.m25" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, the polynomial representative is only unique up to rescaling by a common factor in <math id="S5.Thmthm18.p1.m26" class="ltx_Math" alttext="{\mathbb{C}}^{*}" display="inline" intent=":literal"><semantics><msup><mi>ℂ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">{\mathbb{C}}^{*}</annotation></semantics></math> and a common reparametrization <math id="S5.Thmthm18.p1.m27" class="ltx_Math" alttext="z\mapsto\lambda_{i}z" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo stretchy="false">↦</mo><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow></mrow><annotation encoding="application/x-tex">z\mapsto\lambda_{i}z</annotation></semantics></math> by a positive real number <math id="S5.Thmthm18.p1.m28" class="ltx_Math" alttext="\lambda_{i}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\lambda_{i}</annotation></semantics></math>. However, there exists a unique set of polynomial representatives for all <math id="S5.Thmthm18.p1.m29" class="ltx_Math" alttext="u_{i}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mi>i</mi></msub><annotation encoding="application/x-tex">u_{i}</annotation></semantics></math> such that</p>
<ol id="S5.I11" class="ltx_enumerate">
<li id="S5.I11.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S5.I11.i1.p1" class="ltx_para">
<p id="S5.I11.i1.p1.1" class="ltx_p"><math id="S5.I11.i1.p1.m1" class="ltx_Math" alttext="(f_{0,0}(0),\ldots,f_{0,d}(0))=(1,0,\ldots,0)\in{\mathbb{C}}^{d+1}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><mrow><mn>0</mn><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>f</mi><mrow><mn>0</mn><mo>,</mo><mi>d</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>ℂ</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">(f_{0,0}(0),\ldots,f_{0,d}(0))=(1,0,\ldots,0)\in{\mathbb{C}}^{d+1}</annotation></semantics></math>.</p>
</div></li>
<li id="S5.I11.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S5.I11.i2.p1" class="ltx_para">
<p id="S5.I11.i2.p1.1" class="ltx_p">For each <math id="S5.I11.i2.p1.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, the “evaluation” of <math id="S5.I11.i2.p1.m2" class="ltx_Math" alttext="(f_{i,0},\ldots,f_{i,d})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>i</mi><mo>,</mo><mn>0</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><mrow><mi>i</mi><mo>,</mo><mi>d</mi></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(f_{i,0},\ldots,f_{i,d})</annotation></semantics></math> at the marked point <math id="S5.I11.i2.p1.m3" class="ltx_Math" alttext="z_{i,+}=\infty" display="inline" intent=":literal"><semantics><mrow><msub><mi>z</mi><mrow><mi>i</mi><mo rspace="0em">,</mo><mo lspace="0em">+</mo></mrow></msub><mo>=</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">z_{i,+}=\infty</annotation></semantics></math></p>
<table id="S5.Ex44" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex44.m1" class="ltx_Math" alttext="(a_{i,0},\ldots,a_{i,d}):=\lim_{z\to\infty}\frac{1}{z^{d_{i}^{0}}}(f_{i,0}(z),\ldots,f_{i,d}(z))" display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mrow><mi>i</mi><mo>,</mo><mn>0</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><mrow><mi>i</mi><mo>,</mo><mi>d</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo rspace="0.1389em">:=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>z</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><mfrac><mn>1</mn><msup><mi>z</mi><msubsup><mi>d</mi><mi>i</mi><mn>0</mn></msubsup></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><mrow><mi>i</mi><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>f</mi><mrow><mi>i</mi><mo>,</mo><mi>d</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">(a_{i,0},\ldots,a_{i,d}):=\lim_{z\to\infty}\frac{1}{z^{d_{i}^{0}}}(f_{i,0}(z),\ldots,f_{i,d}(z))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I11.i2.p1.2" class="ltx_p">is a unit vector of <math id="S5.I11.i2.p1.m4" class="ltx_Math" alttext="{\mathbb{C}}^{d+1}" display="inline" intent=":literal"><semantics><msup><mi>ℂ</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">{\mathbb{C}}^{d+1}</annotation></semantics></math>.</p>
</div></li>
<li id="S5.I11.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S5.I11.i3.p1" class="ltx_para">
<p id="S5.I11.i3.p1.1" class="ltx_p">For each <math id="S5.I11.i3.p1.m1" class="ltx_Math" alttext="i\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">i\geq 2</annotation></semantics></math>, <math id="S5.I11.i3.p1.m2" class="ltx_Math" alttext="(f_{i,0}(0),\ldots,f_{i,d}(0))=(a_{i-1,0},\ldots,a_{i-1,d})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><mrow><mi>i</mi><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>f</mi><mrow><mi>i</mi><mo>,</mo><mi>d</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>0</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>d</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(f_{i,0}(0),\ldots,f_{i,d}(0))=(a_{i-1,0},\ldots,a_{i-1,d})</annotation></semantics></math>.</p>
</div></li>
</ol>
<p id="S5.Thmthm18.p1.3" class="ltx_p">Then the unit vector <math id="S5.Thmthm18.p1.m30" class="ltx_Math" alttext="(a_{0},\ldots,a_{d}):=(a_{l,0},\ldots,a_{l,d})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow><mo>:=</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mrow><mi>l</mi><mo>,</mo><mn>0</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><mrow><mi>l</mi><mo>,</mo><mi>d</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(a_{0},\ldots,a_{d}):=(a_{l,0},\ldots,a_{l,d})</annotation></semantics></math> is called the normalized evaluation of <math id="S5.Thmthm18.p1.m31" class="ltx_Math" alttext="x\in B_{d}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msub><mi>B</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">x\in B_{d}</annotation></semantics></math> at <math id="S5.Thmthm18.p1.m32" class="ltx_Math" alttext="z_{+}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mo>+</mo></msub><annotation encoding="application/x-tex">z_{+}</annotation></semantics></math>. In particular,</p>
<table id="S5.Ex45" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex45.m1" class="ltx_Math" alttext="{\rm ev}_{+}(x)=[a_{0},\ldots,a_{d}]\in\mathbb{CP}^{d}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ev</mi><mo>+</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>a</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><mi>d</mi></msub></mrow><mo stretchy="false">]</mo></mrow><mo>∈</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\rm ev}_{+}(x)=[a_{0},\ldots,a_{d}]\in\mathbb{CP}^{d}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S5.SS2.SSS4.p4" class="ltx_para">
<p id="S5.SS2.SSS4.p4.1" class="ltx_p">We denote the normalized evaluation map defined as above by</p>
<table id="S5.Ex46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex46.m1" class="ltx_Math" alttext="\widetilde{\rm ev}_{+}:B_{d}\to{\mathbb{C}}^{d+1}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>ev</mi><mo>~</mo></mover><mo>+</mo></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>B</mi><mi>d</mi></msub><mo stretchy="false">→</mo><msup><mi>ℂ</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widetilde{\rm ev}_{+}:B_{d}\to{\mathbb{C}}^{d+1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS4.p4.2" class="ltx_p">It is easy to see that <math id="S5.SS2.SSS4.p4.m1" class="ltx_Math" alttext="\widetilde{\rm ev}_{+}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ev</mi><mo>~</mo></mover><mo>+</mo></msub><annotation encoding="application/x-tex">\widetilde{\rm ev}_{+}</annotation></semantics></math> is smooth from its construction.</p>
</div>
</section>
<section id="S5.SS2.SSS5" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">5.2.5. </span>Boundary strata of the auxiliary moduli spaces</h4>

<div id="S5.SS2.SSS5.p1" class="ltx_para">
<p id="S5.SS2.SSS5.p1.1" class="ltx_p">We introduce the following definitions in order to compare the boundary strata of the auxiliary moduli spaces and the products of moduli spaces with lower degrees. This should be thought of as a toy model for the comparison between the restriction of the geometrically-constructed K-charts along the boundary strata and the product of the K-charts from the factorization description of the boundary strata.</p>
</div>
<div id="S5.Thmthm19" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm19.2" class="ltx_text ltx_font_bold">Definition 5.19</span></span><span id="S5.Thmthm19.3" class="ltx_text ltx_font_bold"> </span>(Fans and Flags)<span id="S5.Thmthm19.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm19.p1" class="ltx_para">
<p id="S5.Thmthm19.p1.1" class="ltx_p">Fix <math id="S5.Thmthm19.p1.m1" class="ltx_Math" alttext="d\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d\geq 1</annotation></semantics></math> and <math id="S5.Thmthm19.p1.m2" class="ltx_Math" alttext="\delta=(d_{0},\ldots,d_{l})\in{\mathbb{A}}_{d}" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>d</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi>𝔸</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\delta=(d_{0},\ldots,d_{l})\in{\mathbb{A}}_{d}</annotation></semantics></math>.</p>
<ol id="S5.I12" class="ltx_enumerate">
<li id="S5.I12.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S5.I12.i1.p1" class="ltx_para">
<p id="S5.I12.i1.p1.1" class="ltx_p">A <span id="S5.I12.i1.p1.1.1" class="ltx_text ltx_font_bold">fan</span> of type <math id="S5.I12.i1.p1.m1" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> is a list of linear subspaces of <math id="S5.I12.i1.p1.m2" class="ltx_Math" alttext="{\mathbb{C}}^{d+1}" display="inline" intent=":literal"><semantics><msup><mi>ℂ</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">{\mathbb{C}}^{d+1}</annotation></semantics></math></p>
<table id="S5.Ex47" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex47.m1" class="ltx_Math" alttext="(W_{d_{0}},\ldots,W_{d_{l}})" display="block" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>W</mi><msub><mi>d</mi><mi>l</mi></msub></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(W_{d_{0}},\ldots,W_{d_{l}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I12.i1.p1.2" class="ltx_p">satisfying</p>
<ol id="S5.I12.i1.I1" class="ltx_enumerate">
<li id="S5.I12.i1.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(a)</span> 
<div id="S5.I12.i1.I1.i1.p1" class="ltx_para">
<p id="S5.I12.i1.I1.i1.p1.1" class="ltx_p"><math id="S5.I12.i1.I1.i1.p1.m1" class="ltx_Math" alttext="{\rm dim}_{\mathbb{C}}W_{d_{i}}=d_{i}+1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>dim</mi><mi>ℂ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><msub><mi>d</mi><mi>i</mi></msub></msub></mrow><mo>=</mo><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">{\rm dim}_{\mathbb{C}}W_{d_{i}}=d_{i}+1</annotation></semantics></math>.</p>
</div></li>
<li id="S5.I12.i1.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(b)</span> 
<div id="S5.I12.i1.I1.i2.p1" class="ltx_para">
<p id="S5.I12.i1.I1.i2.p1.1" class="ltx_p"><math id="S5.I12.i1.I1.i2.p1.m1" class="ltx_Math" alttext="W_{d_{0}}+\cdots+W_{d_{l}}={\mathbb{C}}^{d+1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>W</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>W</mi><msub><mi>d</mi><mi>l</mi></msub></msub></mrow><mo>=</mo><msup><mi>ℂ</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">W_{d_{0}}+\cdots+W_{d_{l}}={\mathbb{C}}^{d+1}</annotation></semantics></math>.</p>
</div></li>
<li id="S5.I12.i1.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(c)</span> 
<div id="S5.I12.i1.I1.i3.p1" class="ltx_para">
<p id="S5.I12.i1.I1.i3.p1.1" class="ltx_p"><math id="S5.I12.i1.I1.i3.p1.m1" class="ltx_Math" alttext="{\rm dim}_{\mathbb{C}}(W_{d_{i-1}}\cap W_{d_{i}})=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>dim</mi><mi>ℂ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>W</mi><msub><mi>d</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo>∩</mo><msub><mi>W</mi><msub><mi>d</mi><mi>i</mi></msub></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\rm dim}_{\mathbb{C}}(W_{d_{i-1}}\cap W_{d_{i}})=1</annotation></semantics></math>.</p>
</div></li>
</ol>
<p id="S5.I12.i1.p1.3" class="ltx_p">Let <math id="S5.I12.i1.p1.m3" class="ltx_Math" alttext="{\rm Fan}_{\delta}" display="inline" intent=":literal"><semantics><msub><mi>Fan</mi><mi>δ</mi></msub><annotation encoding="application/x-tex">{\rm Fan}_{\delta}</annotation></semantics></math> be the set of all fans of type <math id="S5.I12.i1.p1.m4" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>. Then there is a canonical map</p>
<table id="S5.Ex48" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex48.m1" class="ltx_Math" alttext="\partial^{\delta}B_{d}\to{\rm Fan}_{\delta}" display="block" intent=":literal"><semantics><mrow><mrow><msup><mo>∂</mo><mi>δ</mi></msup><msub><mi>B</mi><mi>d</mi></msub></mrow><mo stretchy="false">→</mo><msub><mi>Fan</mi><mi>δ</mi></msub></mrow><annotation encoding="application/x-tex">\partial^{\delta}B_{d}\to{\rm Fan}_{\delta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I12.i1.p1.4" class="ltx_p">which sends any equivalence class of stable cylinders to the fan for which <math id="S5.I12.i1.p1.m5" class="ltx_Math" alttext="W_{d_{i}}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><msub><mi>d</mi><mi>i</mi></msub></msub><annotation encoding="application/x-tex">W_{d_{i}}</annotation></semantics></math> is the subspace such that the image of the <math id="S5.I12.i1.p1.m6" class="ltx_Math" alttext="(i+1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i+1)</annotation></semantics></math>-th level is contained in the projectivization of <math id="S5.I12.i1.p1.m7" class="ltx_Math" alttext="W_{d_{i}}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><msub><mi>d</mi><mi>i</mi></msub></msub><annotation encoding="application/x-tex">W_{d_{i}}</annotation></semantics></math>. Note that such a map is well-defined because the stable cylinder at the <math id="S5.I12.i1.p1.m8" class="ltx_Math" alttext="(i+1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i+1)</annotation></semantics></math>-th level has degree <math id="S5.I12.i1.p1.m9" class="ltx_Math" alttext="d_{i}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi>i</mi></msub><annotation encoding="application/x-tex">d_{i}</annotation></semantics></math>.</p>
</div></li>
<li id="S5.I12.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S5.I12.i2.p1" class="ltx_para">
<p id="S5.I12.i2.p1.1" class="ltx_p">A <span id="S5.I12.i2.p1.1.1" class="ltx_text ltx_font_bold">flag</span> of type <math id="S5.I12.i2.p1.m1" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> is a list of subspaces of <math id="S5.I12.i2.p1.m2" class="ltx_Math" alttext="{\mathbb{C}}^{d+1}" display="inline" intent=":literal"><semantics><msup><mi>ℂ</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">{\mathbb{C}}^{d+1}</annotation></semantics></math></p>
<table id="S5.Ex49" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex49.m1" class="ltx_Math" alttext="V_{0}\subset\cdots\subset V_{l}={\mathbb{C}}^{d+1}" display="block" intent=":literal"><semantics><mrow><msub><mi>V</mi><mn>0</mn></msub><mo rspace="0.1389em">⊂</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">⊂</mo><msub><mi>V</mi><mi>l</mi></msub><mo>=</mo><msup><mi>ℂ</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">V_{0}\subset\cdots\subset V_{l}={\mathbb{C}}^{d+1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I12.i2.p1.2" class="ltx_p">satisfying</p>
<table id="S5.Ex50" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex50.m1" class="ltx_Math" alttext="{\rm dim}_{\mathbb{C}}V_{i}=d_{0}+\cdots+d_{i}+1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>dim</mi><mi>ℂ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mi>i</mi></msub></mrow><mo>=</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>d</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\rm dim}_{\mathbb{C}}V_{i}=d_{0}+\cdots+d_{i}+1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I12.i2.p1.3" class="ltx_p">Let <math id="S5.I12.i2.p1.m3" class="ltx_Math" alttext="{\rm Flag}_{\delta}" display="inline" intent=":literal"><semantics><msub><mi>Flag</mi><mi>δ</mi></msub><annotation encoding="application/x-tex">{\rm Flag}_{\delta}</annotation></semantics></math> be the set of all flags of type <math id="S5.I12.i2.p1.m4" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>. Then there is a standard flag of each type <math id="S5.I12.i2.p1.m5" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> where</p>
<table id="S5.Ex51" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex51.m1" class="ltx_math_unparsed" alttext="V_{i}={\mathbb{C}}^{d_{0}+\cdots+d_{i}+1}\times\{0\}^{d_{i+1}+\cdots+d_{l}},i=0,\ldots,l." display="block" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi>i</mi></msub><mo>=</mo><msup><mi>ℂ</mi><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>d</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow><mrow><msub><mi>d</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>d</mi><mi>l</mi></msub></mrow></msup><mo>,</mo><mi>i</mi><mo>=</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>l</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">V_{i}={\mathbb{C}}^{d_{0}+\cdots+d_{i}+1}\times\{0\}^{d_{i+1}+\cdots+d_{l}},i=0,\ldots,l.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S5.I12.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S5.I12.i3.p1" class="ltx_para">
<p id="S5.I12.i3.p1.1" class="ltx_p">There is a canonical map</p>
<table id="S5.Ex52" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex52.m1" class="ltx_Math" alttext="{\rm Fan}_{\delta}\to{\rm Flag}_{\delta}" display="block" intent=":literal"><semantics><mrow><msub><mi>Fan</mi><mi>δ</mi></msub><mo stretchy="false">→</mo><msub><mi>Flag</mi><mi>δ</mi></msub></mrow><annotation encoding="application/x-tex">{\rm Fan}_{\delta}\to{\rm Flag}_{\delta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I12.i3.p1.2" class="ltx_p">which maps <math id="S5.I12.i3.p1.m1" class="ltx_Math" alttext="(W_{d_{0}},\ldots,W_{d_{l}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>W</mi><msub><mi>d</mi><mi>l</mi></msub></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(W_{d_{0}},\ldots,W_{d_{l}})</annotation></semantics></math> to the flag where</p>
<table id="S5.Ex53" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex53.m1" class="ltx_Math" alttext="V_{i}=W_{d_{0}}+\cdots+W_{d_{i}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>V</mi><mi>i</mi></msub><mo>=</mo><mrow><msub><mi>W</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>W</mi><msub><mi>d</mi><mi>i</mi></msub></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">V_{i}=W_{d_{0}}+\cdots+W_{d_{i}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S5.I12.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S5.I12.i4.p1" class="ltx_para">
<p id="S5.I12.i4.p1.1" class="ltx_p">A fan of type <math id="S5.I12.i4.p1.m1" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> is said to be <span id="S5.I12.i4.p1.1.1" class="ltx_text ltx_font_bold">in the normal position</span> if the following is true. For each <math id="S5.I12.i4.p1.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, let</p>
<table id="S5.EGx10" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.Ex54"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex54.m1" class="ltx_Math" alttext="\displaystyle\ W_{i}^{-}:=W_{d_{0}}+\cdots+W_{d_{i}},\ " display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>W</mi><mi>i</mi><mo>−</mo></msubsup><mo>:=</mo><mrow><msub><mi>W</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>W</mi><msub><mi>d</mi><mi>i</mi></msub></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ W_{i}^{-}:=W_{d_{0}}+\cdots+W_{d_{i}},\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex54.m2" class="ltx_Math" alttext="\displaystyle\ W_{i}^{+}:=W_{d_{i+1}}+\cdots+W_{d_{l}}." display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>W</mi><mi>i</mi><mo>+</mo></msubsup><mo>:=</mo><mrow><msub><mi>W</mi><msub><mi>d</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>W</mi><msub><mi>d</mi><mi>l</mi></msub></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ W_{i}^{+}:=W_{d_{i+1}}+\cdots+W_{d_{l}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I12.i4.p1.2" class="ltx_p">The condition for being a fan implies that <math id="S5.I12.i4.p1.m3" class="ltx_Math" alttext="W_{i}^{-}\cap W_{i}^{+}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>W</mi><mi>i</mi><mo>−</mo></msubsup><mo>∩</mo><msubsup><mi>W</mi><mi>i</mi><mo>+</mo></msubsup></mrow><annotation encoding="application/x-tex">W_{i}^{-}\cap W_{i}^{+}</annotation></semantics></math> is a line <math id="S5.I12.i4.p1.m4" class="ltx_Math" alttext="L_{i}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>i</mi></msub><annotation encoding="application/x-tex">L_{i}</annotation></semantics></math>. Let <math id="S5.I12.i4.p1.m5" class="ltx_Math" alttext="\mathring{W}_{i}^{\pm}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>W</mi><mo>̊</mo></mover><mi>i</mi><mo>±</mo></msubsup><annotation encoding="application/x-tex">\mathring{W}_{i}^{\pm}</annotation></semantics></math> be the orthogonal complement of <math id="S5.I12.i4.p1.m6" class="ltx_Math" alttext="L_{i}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>i</mi></msub><annotation encoding="application/x-tex">L_{i}</annotation></semantics></math> in <math id="S5.I12.i4.p1.m7" class="ltx_Math" alttext="W_{i}^{\pm}" display="inline" intent=":literal"><semantics><msubsup><mi>W</mi><mi>i</mi><mo>±</mo></msubsup><annotation encoding="application/x-tex">W_{i}^{\pm}</annotation></semantics></math> (with respect to the standard Hermitian inner product of <math id="S5.I12.i4.p1.m8" class="ltx_Math" alttext="{\mathbb{C}}^{d+1}" display="inline" intent=":literal"><semantics><msup><mi>ℂ</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">{\mathbb{C}}^{d+1}</annotation></semantics></math>). Then <math id="S5.I12.i4.p1.m9" class="ltx_Math" alttext="\mathring{W}_{i}^{-}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>W</mi><mo>̊</mo></mover><mi>i</mi><mo>−</mo></msubsup><annotation encoding="application/x-tex">\mathring{W}_{i}^{-}</annotation></semantics></math> and <math id="S5.I12.i4.p1.m10" class="ltx_Math" alttext="\mathring{W}_{i}^{+}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>W</mi><mo>̊</mo></mover><mi>i</mi><mo>+</mo></msubsup><annotation encoding="application/x-tex">\mathring{W}_{i}^{+}</annotation></semantics></math> are orthogonal for all <math id="S5.I12.i4.p1.m11" class="ltx_Math" alttext="i=0,\ldots,l-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">i=0,\ldots,l-1</annotation></semantics></math>.</p>
</div></li>
<li id="S5.I12.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(5)</span> 
<div id="S5.I12.i5.p1" class="ltx_para">
<p id="S5.I12.i5.p1.1" class="ltx_p">A point <math id="S5.I12.i5.p1.m1" class="ltx_Math" alttext="x\in B_{d}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msub><mi>B</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">x\in B_{d}</annotation></semantics></math> is said to be in the <math id="S5.I12.i5.p1.m2" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>-normal position if <math id="S5.I12.i5.p1.m3" class="ltx_Math" alttext="x\in\partial^{\delta}B_{d}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo rspace="0.111em">∈</mo><mrow><msup><mo>∂</mo><mi>δ</mi></msup><msub><mi>B</mi><mi>d</mi></msub></mrow></mrow><annotation encoding="application/x-tex">x\in\partial^{\delta}B_{d}</annotation></semantics></math> and its associated fan of type <math id="S5.I12.i5.p1.m4" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> is in the normal position. Let <math id="S5.I12.i5.p1.m5" class="ltx_Math" alttext="(\partial^{\delta}B_{d})^{\rm normal}\subset\partial^{\delta}B_{d}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">∂</mo><mi>δ</mi></msup><msub><mi>B</mi><mi>d</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mi>normal</mi></msup><mo rspace="0.111em">⊂</mo><mrow><msup><mo>∂</mo><mi>δ</mi></msup><msub><mi>B</mi><mi>d</mi></msub></mrow></mrow><annotation encoding="application/x-tex">(\partial^{\delta}B_{d})^{\rm normal}\subset\partial^{\delta}B_{d}</annotation></semantics></math> be the subset of stable cylinders which are in <math id="S5.I12.i5.p1.m6" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>-normal position.</p>
</div></li>
</ol>
</div>
</div>
<div id="S5.SS2.SSS5.p2" class="ltx_para">
<p id="S5.SS2.SSS5.p2.1" class="ltx_p">We first describe the case of a codimension-one stratum of the auxiliary moduli space as a warm-up. Fix <math id="S5.SS2.SSS5.p2.m1" class="ltx_Math" alttext="d\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">d\geq 2</annotation></semantics></math> and a partition <math id="S5.SS2.SSS5.p2.m2" class="ltx_Math" alttext="(d_{0},d_{1})\in{\mathbb{A}}_{d}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi>𝔸</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">(d_{0},d_{1})\in{\mathbb{A}}_{d}</annotation></semantics></math>. There is a corresponding stratum <math id="S5.SS2.SSS5.p2.m3" class="ltx_Math" alttext="\partial^{(d_{0},d_{1})}B_{d}\subset B_{d}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mo>∂</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msup><msub><mi>B</mi><mi>d</mi></msub></mrow><mo>⊂</mo><msub><mi>B</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\partial^{(d_{0},d_{1})}B_{d}\subset B_{d}</annotation></semantics></math> from Notation <a href="#S5.Thmthm16" title="Notation 5.16. ‣ 5.2.4. A system of auxiliary moduli spaces ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.16</span></a>. We would like to define a map</p>
<table id="S5.E6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E6.m1" class="ltx_Math" alttext="\zeta_{(d_{0},d_{1})}:B_{d_{0}}\times B_{d_{1}}\hookrightarrow\partial^{(d_{0},d_{1})}B_{d}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ζ</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>B</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>B</mi><msub><mi>d</mi><mn>1</mn></msub></msub></mrow><mo rspace="0.111em" stretchy="false">↪</mo><mrow><msup><mo>∂</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msup><msub><mi>B</mi><mi>d</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\zeta_{(d_{0},d_{1})}:B_{d_{0}}\times B_{d_{1}}\hookrightarrow\partial^{(d_{0},d_{1})}B_{d}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.6)</span></td></tr></tbody>
</table>
<p id="S5.SS2.SSS5.p2.2" class="ltx_p">Given two arbitrary points <math id="S5.SS2.SSS5.p2.m4" class="ltx_Math" alttext="x_{0}\in B_{d_{0}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>∈</mo><msub><mi>B</mi><msub><mi>d</mi><mn>0</mn></msub></msub></mrow><annotation encoding="application/x-tex">x_{0}\in B_{d_{0}}</annotation></semantics></math>, <math id="S5.SS2.SSS5.p2.m5" class="ltx_Math" alttext="x_{1}\in B_{d_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>∈</mo><msub><mi>B</mi><msub><mi>d</mi><mn>1</mn></msub></msub></mrow><annotation encoding="application/x-tex">x_{1}\in B_{d_{1}}</annotation></semantics></math>, <math id="S5.SS2.SSS5.p2.m6" class="ltx_Math" alttext="\zeta_{(d_{0},d_{1})}(x_{0},x_{1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ζ</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\zeta_{(d_{0},d_{1})}(x_{0},x_{1})</annotation></semantics></math> can be defined as follows. Let <math id="S5.SS2.SSS5.p2.m7" class="ltx_Math" alttext="u_{0}:\Sigma_{0}\to\mathbb{CP}^{d_{0}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mn>0</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mn>0</mn></msub><mo stretchy="false">→</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><msub><mi>d</mi><mn>0</mn></msub></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">u_{0}:\Sigma_{0}\to\mathbb{CP}^{d_{0}}</annotation></semantics></math>, <math id="S5.SS2.SSS5.p2.m8" class="ltx_Math" alttext="u_{1}:\Sigma_{1}\to\mathbb{CP}^{d_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mn>1</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mn>1</mn></msub><mo stretchy="false">→</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><msub><mi>d</mi><mn>1</mn></msub></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">u_{1}:\Sigma_{1}\to\mathbb{CP}^{d_{1}}</annotation></semantics></math> be representatives. Let <math id="S5.SS2.SSS5.p2.m9" class="ltx_Math" alttext="(a_{0},\ldots,a_{d_{0}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a_{0},\ldots,a_{d_{0}})</annotation></semantics></math> be the normalized evaluation of <math id="S5.SS2.SSS5.p2.m10" class="ltx_Math" alttext="x_{0}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>0</mn></msub><annotation encoding="application/x-tex">x_{0}</annotation></semantics></math> (see Definition <a href="#S5.Thmthm18" title="Definition 5.18 (Normalized evaluation). ‣ 5.2.4. A system of auxiliary moduli spaces ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.18</span></a>). One can represent <math id="S5.SS2.SSS5.p2.m11" class="ltx_Math" alttext="u_{0}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mn>0</mn></msub><annotation encoding="application/x-tex">u_{0}</annotation></semantics></math> resp. <math id="S5.SS2.SSS5.p2.m12" class="ltx_Math" alttext="u_{1}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mn>1</mn></msub><annotation encoding="application/x-tex">u_{1}</annotation></semantics></math> as a list of holomorphic sections</p>
<table id="S5.Ex55" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex55.m1" class="ltx_Math" alttext="(f_{0},\ldots,f_{d_{0}})\ {\rm resp}.\ (g_{0},\ldots,g_{d_{1}})" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.500em" rspace="0em">​</mo><mi>resp</mi></mrow><mo lspace="0em" rspace="0.667em">.</mo><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>g</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(f_{0},\ldots,f_{d_{0}})\ {\rm resp}.\ (g_{0},\ldots,g_{d_{1}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS5.p2.3" class="ltx_p">of the line bundle <math id="S5.SS2.SSS5.p2.m13" class="ltx_Math" alttext="L_{0}=u_{0}^{*}{\mathcal{O}}(1)\to\Sigma_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mn>0</mn></msub><mo>=</mo><mrow><msubsup><mi>u</mi><mn>0</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><msub><mi mathvariant="normal">Σ</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">L_{0}=u_{0}^{*}{\mathcal{O}}(1)\to\Sigma_{0}</annotation></semantics></math> resp. <math id="S5.SS2.SSS5.p2.m14" class="ltx_Math" alttext="L_{1}=u_{1}^{*}{\mathcal{O}}(1)\to\Sigma_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mn>1</mn></msub><mo>=</mo><mrow><msubsup><mi>u</mi><mn>1</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><msub><mi mathvariant="normal">Σ</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">L_{1}=u_{1}^{*}{\mathcal{O}}(1)\to\Sigma_{1}</annotation></semantics></math>. Then define <math id="S5.SS2.SSS5.p2.m15" class="ltx_Math" alttext="\zeta_{(d_{0},d_{1})}(x_{0},x_{1})\in\partial^{(d_{0},d_{1})}B_{d}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ζ</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">∈</mo><mrow><msup><mo>∂</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msup><msub><mi>B</mi><mi>d</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\zeta_{(d_{0},d_{1})}(x_{0},x_{1})\in\partial^{(d_{0},d_{1})}B_{d}</annotation></semantics></math> to be the point represented by the map</p>
<table id="S5.EGx11" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.E7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.E7.m1" class="ltx_Math" alttext="\displaystyle u_{(d_{0},d_{1})}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">\displaystyle u_{(d_{0},d_{1})}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E7.m2" class="ltx_Math" alttext="\displaystyle:\Sigma_{0}\vee\Sigma_{1}\to\mathbb{CP}^{d}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi mathvariant="normal">Σ</mi><mn>0</mn></msub><mo>∨</mo><msub><mi mathvariant="normal">Σ</mi><mn>1</mn></msub></mrow><mo stretchy="false">→</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle:\Sigma_{0}\vee\Sigma_{1}\to\mathbb{CP}^{d},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.7)</span></td></tr></tbody>
<tbody id="S5.EGx11.1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.EGx11.m1" class="ltx_Math" alttext="\displaystyle z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">\displaystyle z</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.EGx11.m2" class="ltx_Math" alttext="\displaystyle\mapsto\left\{\begin{array}[]{cc}{\rm[}f_{0}(z),\ldots,f_{d_{0}}(z),0,\ldots,0{\rm]},&amp;\ z\in\Sigma_{0},\\
{\rm[}a_{0}g_{0}(z),\ldots,a_{d_{0}}g_{0}(z),g_{1}(z),\ldots,g_{d_{1}}(z){\rm]},&amp;\ z\in\Sigma_{1}.\end{array}\right." display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo stretchy="false">↦</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="2.0pt"><mtr><mtd><mrow><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>f</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>f</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn></mrow><mo stretchy="false">]</mo></mrow><mo>,</mo></mrow></mtd><mtd><mrow><mrow><mi>z</mi><mo>∈</mo><msub><mi mathvariant="normal">Σ</mi><mn>0</mn></msub></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>a</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>a</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>g</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>g</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mo>,</mo></mrow></mtd><mtd><mrow><mrow><mi>z</mi><mo>∈</mo><msub><mi mathvariant="normal">Σ</mi><mn>1</mn></msub></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mapsto\left\{\begin{array}[]{cc}{\rm[}f_{0}(z),\ldots,f_{d_{0}}(z),0,\ldots,0{\rm]},&amp;\ z\in\Sigma_{0},\\
{\rm[}a_{0}g_{0}(z),\ldots,a_{d_{0}}g_{0}(z),g_{1}(z),\ldots,g_{d_{1}}(z){\rm]},&amp;\ z\in\Sigma_{1}.\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S5.Thmthm20" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm20.2" class="ltx_text ltx_font_bold">Lemma 5.20</span></span><span id="S5.Thmthm20.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm20.p1" class="ltx_para">
<p id="S5.Thmthm20.p1.1" class="ltx_p"><span id="S5.Thmthm20.p1.1.1" class="ltx_text ltx_font_italic">The map <math id="S5.Thmthm20.p1.m1" class="ltx_Math" alttext="\zeta_{(d_{0},d_{1})}" display="inline" intent=":literal"><semantics><msub><mi>ζ</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">\zeta_{(d_{0},d_{1})}</annotation></semantics></math> is equivariant with respect to the group embedding <math id="S5.Thmthm20.p1.m2" class="ltx_Math" alttext="G_{d_{0}}\times G_{d_{1}}\hookrightarrow G_{d}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>G</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>G</mi><msub><mi>d</mi><mn>1</mn></msub></msub></mrow><mo stretchy="false">↪</mo><msub><mi>G</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">G_{d_{0}}\times G_{d_{1}}\hookrightarrow G_{d}</annotation></semantics></math> from Notation <a href="#S5.Thmthm7" title="Notation 5.7. ‣ 5.1.4. Notations ‣ 5.1. Basic notions and the main theorem about global charts ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.7</span></a>.</span></p>
</div>
</div>
<div id="S5.SS2.SSS5.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.SS2.SSS5.p3" class="ltx_para">
<p id="S5.SS2.SSS5.p3.1" class="ltx_p"><span id="S5.SS2.SSS5.p3.1.1" class="ltx_text">Straightforward from the definitions.
∎</span></p>
</div>
</div>
<div id="S5.SS2.SSS5.p4" class="ltx_para">
<p id="S5.SS2.SSS5.p4.1" class="ltx_p">Hence <math id="S5.SS2.SSS5.p4.m1" class="ltx_Math" alttext="\zeta_{(d_{0},d_{1})}" display="inline" intent=":literal"><semantics><msub><mi>ζ</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">\zeta_{(d_{0},d_{1})}</annotation></semantics></math> can be extended to a <math id="S5.SS2.SSS5.p4.m2" class="ltx_Math" alttext="G_{d}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>d</mi></msub><annotation encoding="application/x-tex">G_{d}</annotation></semantics></math>-equivariant map</p>
<table id="S5.E10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E10.m1" class="ltx_Math" alttext="\zeta_{(d_{0},d_{1})}^{\sim}:G_{d}\times_{G_{(d_{0},d_{1})}}(B_{d_{0}}\times B_{d_{1}})\to\partial^{(d_{0},d_{1})}B_{d}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>ζ</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>∼</mo></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>G</mi><mi>d</mi></msub><msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>G</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msub></msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>B</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>B</mi><msub><mi>d</mi><mn>1</mn></msub></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em" stretchy="false">→</mo><mrow><msup><mo>∂</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msup><msub><mi>B</mi><mi>d</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\zeta_{(d_{0},d_{1})}^{\sim}:G_{d}\times_{G_{(d_{0},d_{1})}}(B_{d_{0}}\times B_{d_{1}})\to\partial^{(d_{0},d_{1})}B_{d}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.10)</span></td></tr></tbody>
</table>
</div>
<div id="S5.SS2.SSS5.p5" class="ltx_para">
<p id="S5.SS2.SSS5.p5.1" class="ltx_p">However, the above map is not surjective as configurations in the image are those stable cylinders whose two levels are in certain “normal” positions.</p>
</div>
<div id="S5.Thmthm21" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm21.2" class="ltx_text ltx_font_bold">Lemma 5.21</span></span><span id="S5.Thmthm21.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm21.p1" class="ltx_para">
<p id="S5.Thmthm21.p1.1" class="ltx_p"><math id="S5.Thmthm21.p1.m1" class="ltx_Math" alttext="\zeta_{(d_{0},d_{1})}^{\sim}" display="inline" intent=":literal"><semantics><msubsup><mi>ζ</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>∼</mo></msubsup><annotation encoding="application/x-tex">\zeta_{(d_{0},d_{1})}^{\sim}</annotation></semantics></math><span id="S5.Thmthm21.p1.1.1" class="ltx_text ltx_font_italic"> is bijective onto <math id="S5.Thmthm21.p1.m2" class="ltx_Math" alttext="(\partial^{(d_{0},d_{1})}B_{d})^{\rm normal}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">∂</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msup><msub><mi>B</mi><mi>d</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mi>normal</mi></msup><annotation encoding="application/x-tex">(\partial^{(d_{0},d_{1})}B_{d})^{\rm normal}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S5.SS2.SSS5.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.SS2.SSS5.p6" class="ltx_para">
<p id="S5.SS2.SSS5.p6.1" class="ltx_p"><span id="S5.SS2.SSS5.p6.1.1" class="ltx_text">From the definition we know that the image of <math id="S5.SS2.SSS5.p6.m1" class="ltx_Math" alttext="\zeta_{(d_{0},d_{1})}^{\sim}" display="inline" intent=":literal"><semantics><msubsup><mi>ζ</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>∼</mo></msubsup><annotation encoding="application/x-tex">\zeta_{(d_{0},d_{1})}^{\sim}</annotation></semantics></math> is contained in <math id="S5.SS2.SSS5.p6.m2" class="ltx_Math" alttext="(\partial^{(d_{0},d_{1})}B_{d})^{\rm normal}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">∂</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msup><msub><mi>B</mi><mi>d</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mi>normal</mi></msup><annotation encoding="application/x-tex">(\partial^{(d_{0},d_{1})}B_{d})^{\rm normal}</annotation></semantics></math>. We first prove the surjectivity. For any <math id="S5.SS2.SSS5.p6.m3" class="ltx_Math" alttext="x\in(\partial^{(d_{0},d_{1})}B_{d})^{\rm normal}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">∂</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msup><msub><mi>B</mi><mi>d</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mi>normal</mi></msup></mrow><annotation encoding="application/x-tex">x\in(\partial^{(d_{0},d_{1})}B_{d})^{\rm normal}</annotation></semantics></math> with associated fan <math id="S5.SS2.SSS5.p6.m4" class="ltx_Math" alttext="(W_{d_{0}},W_{d_{1}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo>,</mo><msub><mi>W</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(W_{d_{0}},W_{d_{1}})</annotation></semantics></math>, denote <math id="S5.SS2.SSS5.p6.m5" class="ltx_Math" alttext="L_{x}:=W_{d_{0}}\cap W_{d_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>x</mi></msub><mo>:=</mo><mrow><msub><mi>W</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo>∩</mo><msub><mi>W</mi><msub><mi>d</mi><mn>1</mn></msub></msub></mrow></mrow><annotation encoding="application/x-tex">L_{x}:=W_{d_{0}}\cap W_{d_{1}}</annotation></semantics></math>. Let the domain of <math id="S5.SS2.SSS5.p6.m6" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> be <math id="S5.SS2.SSS5.p6.m7" class="ltx_Math" alttext="\Sigma=\Sigma_{0}\cup\Sigma_{1}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Σ</mi><mo>=</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mn>0</mn></msub><mo>∪</mo><msub><mi mathvariant="normal">Σ</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\Sigma=\Sigma_{0}\cup\Sigma_{1}</annotation></semantics></math>. By using a unitary transformation on <math id="S5.SS2.SSS5.p6.m8" class="ltx_Math" alttext="\mathbb{CP}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathbb{CP}^{d}</annotation></semantics></math> which fixes the point <math id="S5.SS2.SSS5.p6.m9" class="ltx_Math" alttext="[1,0,\ldots,0]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[1,0,\ldots,0]</annotation></semantics></math>, we may assume that <math id="S5.SS2.SSS5.p6.m10" class="ltx_Math" alttext="W_{d_{0}}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><msub><mi>d</mi><mn>0</mn></msub></msub><annotation encoding="application/x-tex">W_{d_{0}}</annotation></semantics></math> is spanned by the first <math id="S5.SS2.SSS5.p6.m11" class="ltx_Math" alttext="d_{0}+1" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d_{0}+1</annotation></semantics></math> coordinates. Then the first level of <math id="S5.SS2.SSS5.p6.m12" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> can be viewed as a stable cylinder in <math id="S5.SS2.SSS5.p6.m13" class="ltx_Math" alttext="\mathbb{CP}^{d_{0}}" display="inline" intent=":literal"><semantics><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><msub><mi>d</mi><mn>0</mn></msub></msup></mrow><annotation encoding="application/x-tex">\mathbb{CP}^{d_{0}}</annotation></semantics></math>. Let the normalized evaluation be <math id="S5.SS2.SSS5.p6.m14" class="ltx_Math" alttext="(a_{0},\ldots,a_{d_{0}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a_{0},\ldots,a_{d_{0}})</annotation></semantics></math>. Then the nodal point of <math id="S5.SS2.SSS5.p6.m15" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> is mapped to <math id="S5.SS2.SSS5.p6.m16" class="ltx_Math" alttext="[a_{0},\ldots,a_{d_{0}},0,\ldots,0]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><msub><mi>a</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo>,</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[a_{0},\ldots,a_{d_{0}},0,\ldots,0]</annotation></semantics></math>. Then by the definition of being in the normal position, <math id="S5.SS2.SSS5.p6.m17" class="ltx_Math" alttext="\mathring{W}_{0}^{+}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>W</mi><mo>̊</mo></mover><mn>0</mn><mo>+</mo></msubsup><annotation encoding="application/x-tex">\mathring{W}_{0}^{+}</annotation></semantics></math> is the subspace spanned by the last <math id="S5.SS2.SSS5.p6.m18" class="ltx_Math" alttext="d_{1}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mn>1</mn></msub><annotation encoding="application/x-tex">d_{1}</annotation></semantics></math> coordinates and <math id="S5.SS2.SSS5.p6.m19" class="ltx_Math" alttext="W_{d_{1}}=\mathring{W}_{0}^{+}+L_{x}" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo>=</mo><mrow><msubsup><mover accent="true"><mi>W</mi><mo>̊</mo></mover><mn>0</mn><mo>+</mo></msubsup><mo>+</mo><msub><mi>L</mi><mi>x</mi></msub></mrow></mrow><annotation encoding="application/x-tex">W_{d_{1}}=\mathring{W}_{0}^{+}+L_{x}</annotation></semantics></math>. Then the second level of <math id="S5.SS2.SSS5.p6.m20" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> is represented by the map</span></p>
<table id="S5.Ex56" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex56.m1" class="ltx_Math" alttext="u_{rq}(z)=[a_{0}f_{0}(z),\ldots,a_{d_{0}}f_{0}(z),f_{1}(z),\ldots,f_{d_{1}}(z)]" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>u</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>a</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>a</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>f</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">u_{rq}(z)=[a_{0}f_{0}(z),\ldots,a_{d_{0}}f_{0}(z),f_{1}(z),\ldots,f_{d_{1}}(z)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS5.p6.2" class="ltx_p"><span id="S5.SS2.SSS5.p6.2.1" class="ltx_text">where <math id="S5.SS2.SSS5.p6.m21" class="ltx_Math" alttext="(f_{0},\ldots,f_{d_{1}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(f_{0},\ldots,f_{d_{1}})</annotation></semantics></math> is a list of holomorphic sections of a degree <math id="S5.SS2.SSS5.p6.m22" class="ltx_Math" alttext="d_{1}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mn>1</mn></msub><annotation encoding="application/x-tex">d_{1}</annotation></semantics></math> line bundle over <math id="S5.SS2.SSS5.p6.m23" class="ltx_Math" alttext="\Sigma_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\Sigma_{1}</annotation></semantics></math>. As <math id="S5.SS2.SSS5.p6.m24" class="ltx_Math" alttext="(a_{0},\ldots,a_{d_{0}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a_{0},\ldots,a_{d_{0}})</annotation></semantics></math> is the normalized evaluation of the first level of <math id="S5.SS2.SSS5.p6.m25" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>, one can see that <math id="S5.SS2.SSS5.p6.m26" class="ltx_Math" alttext="x=\zeta_{(d_{0},d_{1})}(x_{0},x_{1})" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><mrow><msub><mi>ζ</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x=\zeta_{(d_{0},d_{1})}(x_{0},x_{1})</annotation></semantics></math> where <math id="S5.SS2.SSS5.p6.m27" class="ltx_Math" alttext="x_{0}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>0</mn></msub><annotation encoding="application/x-tex">x_{0}</annotation></semantics></math> is the first level of <math id="S5.SS2.SSS5.p6.m28" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> and <math id="S5.SS2.SSS5.p6.m29" class="ltx_Math" alttext="x_{1}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>1</mn></msub><annotation encoding="application/x-tex">x_{1}</annotation></semantics></math> is represented by the map <math id="S5.SS2.SSS5.p6.m30" class="ltx_Math" alttext="z\mapsto[f_{0}(z),\ldots,f_{d_{1}}(z)]" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo stretchy="false">↦</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>f</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>f</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">z\mapsto[f_{0}(z),\ldots,f_{d_{1}}(z)]</annotation></semantics></math>. Therefore <math id="S5.SS2.SSS5.p6.m31" class="ltx_Math" alttext="\zeta_{(d_{0},d_{1})}^{\sim}" display="inline" intent=":literal"><semantics><msubsup><mi>ζ</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>∼</mo></msubsup><annotation encoding="application/x-tex">\zeta_{(d_{0},d_{1})}^{\sim}</annotation></semantics></math> is surjective.</span></p>
</div>
<div id="S5.SS2.SSS5.p7" class="ltx_para">
<p id="S5.SS2.SSS5.p7.1" class="ltx_p"><span id="S5.SS2.SSS5.p7.1.1" class="ltx_text">To prove that <math id="S5.SS2.SSS5.p7.m1" class="ltx_Math" alttext="\zeta_{(d_{0},d_{1})}^{\sim}" display="inline" intent=":literal"><semantics><msubsup><mi>ζ</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>∼</mo></msubsup><annotation encoding="application/x-tex">\zeta_{(d_{0},d_{1})}^{\sim}</annotation></semantics></math> is injective, suppose</span></p>
<table id="S5.Ex57" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex57.m1" class="ltx_Math" alttext="x=\zeta_{(d_{0},d_{1})}^{\sim}([g,x_{0},x_{1}])=\zeta_{(d_{0},d_{1})}^{\sim}([g^{\prime},x_{0}^{\prime},x_{1}^{\prime}])." display="block" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>=</mo><mrow><msubsup><mi>ζ</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>∼</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mrow><mi>g</mi><mo>,</mo><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><msub><mi>x</mi><mn>1</mn></msub></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>ζ</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>∼</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>g</mi><mo>′</mo></msup><mo>,</mo><msubsup><mi>x</mi><mn>0</mn><mo>′</mo></msubsup><mo>,</mo><msubsup><mi>x</mi><mn>1</mn><mo>′</mo></msubsup></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">x=\zeta_{(d_{0},d_{1})}^{\sim}([g,x_{0},x_{1}])=\zeta_{(d_{0},d_{1})}^{\sim}([g^{\prime},x_{0}^{\prime},x_{1}^{\prime}]).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS5.p7.2" class="ltx_p"><span id="S5.SS2.SSS5.p7.2.1" class="ltx_text">We may assume <math id="S5.SS2.SSS5.p7.m2" class="ltx_Math" alttext="g^{\prime}=1" display="inline" intent=":literal"><semantics><mrow><msup><mi>g</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">g^{\prime}=1</annotation></semantics></math>. Then the flag associated to <math id="S5.SS2.SSS5.p7.m3" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> is the standard one and <math id="S5.SS2.SSS5.p7.m4" class="ltx_Math" alttext="g\in G_{d}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>∈</mo><msub><mi>G</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">g\in G_{d}</annotation></semantics></math> preserves this flag. Hence <math id="S5.SS2.SSS5.p7.m5" class="ltx_Math" alttext="g\in G_{d_{0}}\times G_{d_{1}}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>∈</mo><mrow><msub><mi>G</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>G</mi><msub><mi>d</mi><mn>1</mn></msub></msub></mrow></mrow><annotation encoding="application/x-tex">g\in G_{d_{0}}\times G_{d_{1}}</annotation></semantics></math>. Hence we may also assume <math id="S5.SS2.SSS5.p7.m6" class="ltx_Math" alttext="g=1" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">g=1</annotation></semantics></math>. Then <math id="S5.SS2.SSS5.p7.m7" class="ltx_Math" alttext="\zeta_{(d_{0},d_{1})}(x_{0},x_{1})=\zeta_{(d_{0},d_{1})}(x_{0}^{\prime},x_{1}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ζ</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>ζ</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mn>0</mn><mo>′</mo></msubsup><mo>,</mo><msubsup><mi>x</mi><mn>1</mn><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\zeta_{(d_{0},d_{1})}(x_{0},x_{1})=\zeta_{(d_{0},d_{1})}(x_{0}^{\prime},x_{1}^{\prime})</annotation></semantics></math>, which implies <math id="S5.SS2.SSS5.p7.m8" class="ltx_Math" alttext="x_{0}=x_{0}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>=</mo><msubsup><mi>x</mi><mn>0</mn><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">x_{0}=x_{0}^{\prime}</annotation></semantics></math> and <math id="S5.SS2.SSS5.p7.m9" class="ltx_Math" alttext="x_{1}=x_{1}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>=</mo><msubsup><mi>x</mi><mn>1</mn><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">x_{1}=x_{1}^{\prime}</annotation></semantics></math>. Hence <math id="S5.SS2.SSS5.p7.m10" class="ltx_Math" alttext="\zeta_{(d_{0},d_{1})}^{\sim}" display="inline" intent=":literal"><semantics><msubsup><mi>ζ</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>∼</mo></msubsup><annotation encoding="application/x-tex">\zeta_{(d_{0},d_{1})}^{\sim}</annotation></semantics></math> is injective.
∎</span></p>
</div>
</div>
<div id="S5.SS2.SSS5.p8" class="ltx_para">
<p id="S5.SS2.SSS5.p8.1" class="ltx_p">It is important to prove the associativity of the product construction.</p>
</div>
<div id="S5.Thmthm22" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm22.2" class="ltx_text ltx_font_bold">Proposition 5.22</span></span><span id="S5.Thmthm22.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm22.p1" class="ltx_para">
<p id="S5.Thmthm22.p1.1" class="ltx_p"><span id="S5.Thmthm22.p1.1.1" class="ltx_text ltx_font_italic">For a partition <math id="S5.Thmthm22.p1.m1" class="ltx_Math" alttext="(d_{0},d_{1},d_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(d_{0},d_{1},d_{2})</annotation></semantics></math> of <math id="S5.Thmthm22.p1.m2" class="ltx_Math" alttext="d\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d\geq 1</annotation></semantics></math>, <math id="S5.Thmthm22.p1.m3" class="ltx_Math" alttext="x_{0}\in B_{d_{0}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>∈</mo><msub><mi>B</mi><msub><mi>d</mi><mn>0</mn></msub></msub></mrow><annotation encoding="application/x-tex">x_{0}\in B_{d_{0}}</annotation></semantics></math>, <math id="S5.Thmthm22.p1.m4" class="ltx_Math" alttext="x_{1}\in B_{d_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>∈</mo><msub><mi>B</mi><msub><mi>d</mi><mn>1</mn></msub></msub></mrow><annotation encoding="application/x-tex">x_{1}\in B_{d_{1}}</annotation></semantics></math>, and <math id="S5.Thmthm22.p1.m5" class="ltx_Math" alttext="x_{2}\in B_{d_{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>∈</mo><msub><mi>B</mi><msub><mi>d</mi><mn>2</mn></msub></msub></mrow><annotation encoding="application/x-tex">x_{2}\in B_{d_{2}}</annotation></semantics></math>, there holds</span></p>
<table id="S5.Ex58" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex58.m1" class="ltx_Math" alttext="\zeta_{(d_{0},d_{1}+d_{2})}(x_{0},\zeta_{(d_{1},d_{2})}(x_{1},x_{2}))=\zeta_{(d_{0}+d_{1},d_{2})}(\zeta_{(d_{0},d_{1})}(x_{0},x_{1}),x_{2})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ζ</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><msub><mi>d</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><mrow><msub><mi>ζ</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>ζ</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><msub><mi>d</mi><mn>1</mn></msub></mrow><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ζ</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\zeta_{(d_{0},d_{1}+d_{2})}(x_{0},\zeta_{(d_{1},d_{2})}(x_{1},x_{2}))=\zeta_{(d_{0}+d_{1},d_{2})}(\zeta_{(d_{0},d_{1})}(x_{0},x_{1}),x_{2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S5.SS2.SSS5.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.SS2.SSS5.p9" class="ltx_para">
<p id="S5.SS2.SSS5.p9.1" class="ltx_p"><span id="S5.SS2.SSS5.p9.1.1" class="ltx_text">Choose representatives <math id="S5.SS2.SSS5.p9.m1" class="ltx_Math" alttext="u_{0},u_{1},u_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mn>0</mn></msub><mo>,</mo><msub><mi>u</mi><mn>1</mn></msub><mo>,</mo><msub><mi>u</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">u_{0},u_{1},u_{2}</annotation></semantics></math> of <math id="S5.SS2.SSS5.p9.m2" class="ltx_Math" alttext="x_{0},x_{1},x_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">x_{0},x_{1},x_{2}</annotation></semantics></math> respectively. Let</span></p>
<table id="S5.EGx12" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.Ex59"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex59.m1" class="ltx_Math" alttext="\displaystyle\ (a_{0},\ldots,a_{d_{0}}),\ " display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ (a_{0},\ldots,a_{d_{0}}),\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex59.m2" class="ltx_Math" alttext="\displaystyle\ (b_{0},\ldots,b_{d_{1}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>b</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>b</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ (b_{0},\ldots,b_{d_{1}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS5.p9.2" class="ltx_p"><span id="S5.SS2.SSS5.p9.2.1" class="ltx_text">be the normalized evaluations of <math id="S5.SS2.SSS5.p9.m3" class="ltx_Math" alttext="u_{0}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mn>0</mn></msub><annotation encoding="application/x-tex">u_{0}</annotation></semantics></math> and <math id="S5.SS2.SSS5.p9.m4" class="ltx_Math" alttext="u_{1}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mn>1</mn></msub><annotation encoding="application/x-tex">u_{1}</annotation></semantics></math> at <math id="S5.SS2.SSS5.p9.m5" class="ltx_Math" alttext="z_{+}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mo>+</mo></msub><annotation encoding="application/x-tex">z_{+}</annotation></semantics></math>. Then by definition, <math id="S5.SS2.SSS5.p9.m6" class="ltx_Math" alttext="x_{(d_{1},d_{2})}:=\zeta_{(d_{1},d_{2})}(x_{1},x_{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo>:=</mo><mrow><msub><mi>ζ</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x_{(d_{1},d_{2})}:=\zeta_{(d_{1},d_{2})}(x_{1},x_{2})</annotation></semantics></math> is represented by the map with domain <math id="S5.SS2.SSS5.p9.m7" class="ltx_Math" alttext="\Sigma_{1}\vee\Sigma_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mn>1</mn></msub><mo>∨</mo><msub><mi mathvariant="normal">Σ</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\Sigma_{1}\vee\Sigma_{2}</annotation></semantics></math></span></p>
<table id="S5.Ex60" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex60.m1" class="ltx_Math" alttext="u_{(d_{1},d_{2})}(z)=\left\{\begin{array}[]{cc}{\rm[}u_{1,0}(z),\ldots,u_{1,d_{1}}(z),0,\ldots,0{\rm]},\ z\in\Sigma_{1},\\
{\rm[}b_{0}u_{2,0}(z),\ldots,b_{d_{1}}u_{2,0}(z),u_{2,1}(z),\ldots,u_{2,d_{2}}(z){\rm]},\ z\in\Sigma_{2}.\end{array}\right." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>u</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd><mrow><mrow><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>u</mi><mrow><mn>1</mn><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>u</mi><mrow><mn>1</mn><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn></mrow><mo stretchy="false">]</mo></mrow><mo rspace="0.667em">,</mo><mrow><mi>z</mi><mo>∈</mo><msub><mi mathvariant="normal">Σ</mi><mn>1</mn></msub></mrow></mrow><mo>,</mo></mrow></mtd><mtd></mtd></mtr><mtr><mtd><mrow><mrow><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>b</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mrow><mn>2</mn><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>b</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mrow><mn>2</mn><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>u</mi><mrow><mn>2</mn><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>u</mi><mrow><mn>2</mn><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mo rspace="0.667em">,</mo><mrow><mi>z</mi><mo>∈</mo><msub><mi mathvariant="normal">Σ</mi><mn>2</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd><mtd></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">u_{(d_{1},d_{2})}(z)=\left\{\begin{array}[]{cc}{\rm[}u_{1,0}(z),\ldots,u_{1,d_{1}}(z),0,\ldots,0{\rm]},\ z\in\Sigma_{1},\\
{\rm[}b_{0}u_{2,0}(z),\ldots,b_{d_{1}}u_{2,0}(z),u_{2,1}(z),\ldots,u_{2,d_{2}}(z){\rm]},\ z\in\Sigma_{2}.\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS5.p9.3" class="ltx_p"><span id="S5.SS2.SSS5.p9.3.1" class="ltx_text">Then <math id="S5.SS2.SSS5.p9.m8" class="ltx_Math" alttext="\zeta_{(d_{0},d_{1}+d_{2})}(x_{0},x_{(d_{1},d_{2})})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ζ</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><msub><mi>d</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><msub><mi>x</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\zeta_{(d_{0},d_{1}+d_{2})}(x_{0},x_{(d_{1},d_{2})})</annotation></semantics></math> is represented by the map with domain <math id="S5.SS2.SSS5.p9.m9" class="ltx_Math" alttext="\Sigma_{0}\vee\Sigma_{1}\vee\Sigma_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mn>0</mn></msub><mo>∨</mo><msub><mi mathvariant="normal">Σ</mi><mn>1</mn></msub><mo>∨</mo><msub><mi mathvariant="normal">Σ</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\Sigma_{0}\vee\Sigma_{1}\vee\Sigma_{2}</annotation></semantics></math></span></p>
<table id="S5.SS2.SSS5.p9.4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.SS2.SSS5.p9.m10" class="ltx_Math" alttext="u_{012}(z)\\
=\left\{\begin{array}[]{cc}{\rm[}u_{0,0}(z),\ldots,u_{0,d_{0}}(z),0,\ldots,0{\rm]},&amp;z\in\Sigma_{0},\\
{\rm[}a_{0}u_{1,0}(z),\ldots,a_{d_{0}}u_{1,0}(z),u_{1,1}(z),\ldots,u_{1,d_{1}}(z),0,\ldots,0{\rm]},&amp;\ z\in\Sigma_{1},\\
{\rm[}b_{0}a_{0}u_{2,0}(z),\ldots,b_{0}a_{d_{0}}u_{2,0}(z),b_{1}u_{2,0}(z),\ldots,b_{d_{1}}u_{2,0}(z),u_{2,1}(z),\ldots,u_{2,d_{2}}(z){\rm]},&amp;\ z\in\Sigma_{2}.\end{array}\right." display="block" intent=":literal"><semantics><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi>u</mi><mn>012</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd><mrow><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>u</mi><mrow><mn>0</mn><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>u</mi><mrow><mn>0</mn><mo>,</mo><msub><mi>d</mi><mn>0</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn></mrow><mo stretchy="false">]</mo></mrow><mo>,</mo></mrow></mtd><mtd><mrow><mrow><mi>z</mi><mo>∈</mo><msub><mi mathvariant="normal">Σ</mi><mn>0</mn></msub></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>a</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mrow><mn>1</mn><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>a</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mrow><mn>1</mn><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>u</mi><mrow><mn>1</mn><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>u</mi><mrow><mn>1</mn><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn></mrow><mo stretchy="false">]</mo></mrow><mo>,</mo></mrow></mtd><mtd><mrow><mrow><mi>z</mi><mo>∈</mo><msub><mi mathvariant="normal">Σ</mi><mn>1</mn></msub></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>b</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mrow><mn>2</mn><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>b</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mrow><mn>2</mn><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>b</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mrow><mn>2</mn><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>b</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mrow><mn>2</mn><mo>,</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>u</mi><mrow><mn>2</mn><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>u</mi><mrow><mn>2</mn><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mo>,</mo></mrow></mtd><mtd><mrow><mrow><mi>z</mi><mo>∈</mo><msub><mi mathvariant="normal">Σ</mi><mn>2</mn></msub></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">u_{012}(z)\\
=\left\{\begin{array}[]{cc}{\rm[}u_{0,0}(z),\ldots,u_{0,d_{0}}(z),0,\ldots,0{\rm]},&amp;z\in\Sigma_{0},\\
{\rm[}a_{0}u_{1,0}(z),\ldots,a_{d_{0}}u_{1,0}(z),u_{1,1}(z),\ldots,u_{1,d_{1}}(z),0,\ldots,0{\rm]},&amp;\ z\in\Sigma_{1},\\
{\rm[}b_{0}a_{0}u_{2,0}(z),\ldots,b_{0}a_{d_{0}}u_{2,0}(z),b_{1}u_{2,0}(z),\ldots,b_{d_{1}}u_{2,0}(z),u_{2,1}(z),\ldots,u_{2,d_{2}}(z){\rm]},&amp;\ z\in\Sigma_{2}.\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS5.p9.5" class="ltx_p"><span id="S5.SS2.SSS5.p9.5.1" class="ltx_text">On the other hand, <math id="S5.SS2.SSS5.p9.m11" class="ltx_Math" alttext="x_{(d_{0},d_{1})}:=\zeta_{(d_{0},d_{1})}(x_{0},x_{1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo>:=</mo><mrow><msub><mi>ζ</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x_{(d_{0},d_{1})}:=\zeta_{(d_{0},d_{1})}(x_{0},x_{1})</annotation></semantics></math> is represented by the map <math id="S5.SS2.SSS5.p9.m12" class="ltx_Math" alttext="u_{(d_{0},d_{1})}:\Sigma_{0}\vee\Sigma_{1}\to\mathbb{CP}^{d_{0}+d_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi mathvariant="normal">Σ</mi><mn>0</mn></msub><mo>∨</mo><msub><mi mathvariant="normal">Σ</mi><mn>1</mn></msub></mrow><mo stretchy="false">→</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><msub><mi>d</mi><mn>1</mn></msub></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">u_{(d_{0},d_{1})}:\Sigma_{0}\vee\Sigma_{1}\to\mathbb{CP}^{d_{0}+d_{1}}</annotation></semantics></math> whose representation is the same as <math id="S5.SS2.SSS5.p9.m13" class="ltx_Math" alttext="u_{012}|_{\Sigma_{0}\vee\Sigma_{1}}" display="inline" intent=":literal"><semantics><msub><mrow><msub><mi>u</mi><mn>012</mn></msub><mo stretchy="false">|</mo></mrow><mrow><msub><mi mathvariant="normal">Σ</mi><mn>0</mn></msub><mo>∨</mo><msub><mi mathvariant="normal">Σ</mi><mn>1</mn></msub></mrow></msub><annotation encoding="application/x-tex">u_{012}|_{\Sigma_{0}\vee\Sigma_{1}}</annotation></semantics></math> above after removing the last <math id="S5.SS2.SSS5.p9.m14" class="ltx_Math" alttext="d_{2}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mn>2</mn></msub><annotation encoding="application/x-tex">d_{2}</annotation></semantics></math> zeroes. Its evaluation at <math id="S5.SS2.SSS5.p9.m15" class="ltx_Math" alttext="z_{+}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mo>+</mo></msub><annotation encoding="application/x-tex">z_{+}</annotation></semantics></math> is represented by the vector</span></p>
<table id="S5.Ex61" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex61.m1" class="ltx_Math" alttext="(b_{0}a_{0},\ldots,b_{0}a_{d_{0}},b_{1},\ldots,b_{d_{1}})\in\mathbb{C}^{d_{0}+d_{1}+1}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>b</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mn>0</mn></msub></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>b</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><msub><mi>d</mi><mn>0</mn></msub></msub></mrow><mo>,</mo><msub><mi>b</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>b</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>ℂ</mi><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(b_{0}a_{0},\ldots,b_{0}a_{d_{0}},b_{1},\ldots,b_{d_{1}})\in\mathbb{C}^{d_{0}+d_{1}+1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS5.p9.6" class="ltx_p"><span id="S5.SS2.SSS5.p9.6.1" class="ltx_text">which is a unit vector and is the normalized evaluation of <math id="S5.SS2.SSS5.p9.m16" class="ltx_Math" alttext="x_{(d_{0},d_{1})}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">x_{(d_{0},d_{1})}</annotation></semantics></math>. Hence we can see from the definition of <math id="S5.SS2.SSS5.p9.m17" class="ltx_Math" alttext="\zeta_{(d_{0}+d_{1},d_{2})}" display="inline" intent=":literal"><semantics><msub><mi>ζ</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><msub><mi>d</mi><mn>1</mn></msub></mrow><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">\zeta_{(d_{0}+d_{1},d_{2})}</annotation></semantics></math> that the point <math id="S5.SS2.SSS5.p9.m18" class="ltx_Math" alttext="\zeta_{(d_{0}+d_{1},d_{2})}(x_{(d_{0},d_{1})},x_{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ζ</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><msub><mi>d</mi><mn>1</mn></msub></mrow><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\zeta_{(d_{0}+d_{1},d_{2})}(x_{(d_{0},d_{1})},x_{2})</annotation></semantics></math> is also represented by the map <math id="S5.SS2.SSS5.p9.m19" class="ltx_Math" alttext="u^{012}" display="inline" intent=":literal"><semantics><msup><mi>u</mi><mn>012</mn></msup><annotation encoding="application/x-tex">u^{012}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S5.SS2.SSS5.p10" class="ltx_para">
<p id="S5.SS2.SSS5.p10.1" class="ltx_p">Now given a partition <math id="S5.SS2.SSS5.p10.m1" class="ltx_Math" alttext="d=d_{1}+d_{2}+d_{3}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><msub><mi>d</mi><mn>2</mn></msub><mo>+</mo><msub><mi>d</mi><mn>3</mn></msub></mrow></mrow><annotation encoding="application/x-tex">d=d_{1}+d_{2}+d_{3}</annotation></semantics></math>, use (<a href="#S5.E4" title="In item 4 ‣ Notation 5.7. ‣ 5.1.4. Notations ‣ 5.1. Basic notions and the main theorem about global charts ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.4</span></a>), we can define a map</p>
<table id="S5.Ex62" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex62.m1" class="ltx_Math" alttext="\zeta_{(d_{0},d_{1},d_{2})}^{\sim}:G_{d}\times_{G_{d_{0}}\times G_{d_{1}}\times G_{d_{2}}}(B_{d_{0}}\times B_{d_{1}}\times B_{d_{2}})\to\partial^{(d_{0},d_{1},d_{2})}B_{d}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>ζ</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∼</mo></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>G</mi><mi>d</mi></msub><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><msub><mi>G</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>G</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>G</mi><msub><mi>d</mi><mn>2</mn></msub></msub></mrow></msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>B</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>B</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>B</mi><msub><mi>d</mi><mn>2</mn></msub></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em" stretchy="false">→</mo><mrow><msup><mo>∂</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msup><msub><mi>B</mi><mi>d</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\zeta_{(d_{0},d_{1},d_{2})}^{\sim}:G_{d}\times_{G_{d_{0}}\times G_{d_{1}}\times G_{d_{2}}}(B_{d_{0}}\times B_{d_{1}}\times B_{d_{2}})\to\partial^{(d_{0},d_{1},d_{2})}B_{d}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS5.p10.2" class="ltx_p">as follows. For any <math id="S5.SS2.SSS5.p10.m2" class="ltx_Math" alttext="[g,x_{0},x_{1},x_{2}]\in G_{d}\times_{G_{d_{0}}\times G_{d_{1}}\times G_{d_{2}}}(B_{d_{0}}\times B_{d_{1}}\times B_{d_{2}})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mrow><mi>g</mi><mo>,</mo><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub></mrow><mo stretchy="false">]</mo></mrow><mo>∈</mo><mrow><msub><mi>G</mi><mi>d</mi></msub><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><msub><mi>G</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>G</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>G</mi><msub><mi>d</mi><mn>2</mn></msub></msub></mrow></msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>B</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>B</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>B</mi><msub><mi>d</mi><mn>2</mn></msub></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">[g,x_{0},x_{1},x_{2}]\in G_{d}\times_{G_{d_{0}}\times G_{d_{1}}\times G_{d_{2}}}(B_{d_{0}}\times B_{d_{1}}\times B_{d_{2}})</annotation></semantics></math>, define</p>
<table id="S5.Ex63" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex63.m1" class="ltx_Math" alttext="\zeta_{(d_{0},d_{1},d_{2})}^{\sim}([g,x_{0},x_{1},x_{2}]):=g(\zeta_{(d_{0},d_{1}+d_{2})}(x_{0},\zeta_{(d_{1},d_{2})}(x_{1},x_{2})))." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>ζ</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∼</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mrow><mi>g</mi><mo>,</mo><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ζ</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><msub><mi>d</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><mrow><msub><mi>ζ</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\zeta_{(d_{0},d_{1},d_{2})}^{\sim}([g,x_{0},x_{1},x_{2}]):=g(\zeta_{(d_{0},d_{1}+d_{2})}(x_{0},\zeta_{(d_{1},d_{2})}(x_{1},x_{2}))).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS5.p10.3" class="ltx_p">It is straightfoward to check that this is a well-defined equivariant map. On the other hand, we can also define a <math id="S5.SS2.SSS5.p10.m3" class="ltx_Math" alttext="G_{d}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>d</mi></msub><annotation encoding="application/x-tex">G_{d}</annotation></semantics></math>-equivariant map</p>
<table id="S5.Ex64" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex64.m1" class="ltx_Math" alttext="[g,x_{0},x_{1},x_{2}]\mapsto g(\zeta_{(d_{0}+d_{1},d_{2})}(\zeta_{(d_{0},d_{1})}(x_{0},x_{1}),x_{2}))." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">[</mo><mrow><mi>g</mi><mo>,</mo><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">↦</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ζ</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><msub><mi>d</mi><mn>1</mn></msub></mrow><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ζ</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">[g,x_{0},x_{1},x_{2}]\mapsto g(\zeta_{(d_{0}+d_{1},d_{2})}(\zeta_{(d_{0},d_{1})}(x_{0},x_{1}),x_{2})).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS5.p10.4" class="ltx_p">The following commutative diagram coming from Proposition <a href="#S5.Thmthm22" title="Proposition 5.22. ‣ 5.2.5. Boundary strata of the auxiliary moduli spaces ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.22</span></a></p>
<table id="S5.Ex65" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S5.Ex65.m1.pic1" class="ltx_picture ltx_markedasmath" height="112.34" overflow="visible" style="vertical-align:-101.27224730178497px" version="1.1" viewBox="80.00 101.27 519.60 112.34" width="519.60"><g transform="matrix(1 0 0 -1 79.99733174937518 112.34184741248097) translate(0,3.46) translate(80,0)"><g transform="translate(113.21,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:9.03em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="124.9"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex65.m1.pic1.m2" class="ltx_Math" alttext="\textstyle{G_{d}(B_{d_{0}}\times B_{d_{1}}\times B_{d_{2}})\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>B</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>B</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>B</mi><msub><mi>d</mi><mn>2</mn></msub></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{G_{d}(B_{d_{0}}\times B_{d_{1}}\times B_{d_{2}})\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 135.8823774925518 -11.069600110696001 L 135.8823774925518 -11.080199131187733" fill="none" stroke="#000000"></path><g transform="translate(52.16,0) translate(0,-32.17)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 7.38 -0.99" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 6.03 4.37" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 135.8823774925518 -11.069600110696001 L 52.1569775235229 -32.17102532171025" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 52.1569775235229 -32.161059708817625 L 52.1569775235229 -32.17102532171025" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 223.714897902127 -11.069600110696001 L 223.7588775030917 -11.210174370524594" fill="none" stroke="#000000"></path><g transform="translate(307.47,0) translate(0,-32.17)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.03 4.37" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -7.38 -0.99" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 223.714897902127 -11.069600110696001 L 307.46394508818923 -32.17102532171025" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 307.41996548722454 -32.03963547206872 L 307.46394508818923 -32.17102532171025" fill="none" stroke="#000000"></path><g transform="translate(-80,0) translate(0,-45.32) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:10.96em;--ltx-fo-height:0.9em;--ltx-fo-depth:0.3em;font-size:10pt;" height="16.6" overflow="visible" transform="matrix(1 0 0 -1 0 12.45)" width="151.69"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex65.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{G_{d}\big(B_{d_{0}}\times\partial^{(d_{1},d_{2})}B_{d_{1}+d_{2}}\big)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>B</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo lspace="0.222em" rspace="0.055em">×</mo><mrow><msup><mo>∂</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msup><msub><mi>B</mi><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><msub><mi>d</mi><mn>2</mn></msub></mrow></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{G_{d}\big(B_{d_{0}}\times\partial^{(d_{1},d_{2})}B_{d_{1}+d_{2}}\big)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 45.69047711706102 -57.077625570776256 L 45.74575248687647 -57.14117746655338" fill="none" stroke="#000000"></path><g transform="translate(138.62,0) translate(0,-81.01)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.01 4.41" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -7.39 -0.95" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 45.69047711706102 -57.077625570776256 L 138.6156790778072 -81.00770132429821" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 138.6156790778072 -80.91765187729176 L 138.6156790778072 -81.00770132429821" fill="none" stroke="#000000"></path><g transform="translate(279.61,0) translate(0,-45.32) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:10.96em;--ltx-fo-height:0.9em;--ltx-fo-depth:0.3em;font-size:10pt;" height="16.6" overflow="visible" transform="matrix(1 0 0 -1 0 12.45)" width="151.69"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex65.m1.pic1.m6" class="ltx_Math" alttext="\textstyle{G_{d}\big(\partial^{(d_{0},d_{1})}B_{d_{0}+d_{1}}\times B_{d_{2}}\big)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msup><mo lspace="0em">∂</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msup><msub><mi>B</mi><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><msub><mi>d</mi><mn>1</mn></msub></mrow></msub></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>B</mi><msub><mi>d</mi><mn>2</mn></msub></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{G_{d}\big(\partial^{(d_{0},d_{1})}B_{d_{0}+d_{1}}\times B_{d_{2}}\big)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 313.9061226428454 -57.077625570776256 L 313.896030348433 -57.077625570776256" fill="none" stroke="#000000"></path><g transform="translate(221,0) translate(0,-80.97)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 7.39 -0.95" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 6.01 4.41" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 313.9061226428454 -57.077625570776256 L 220.99240647322972 -80.96747994175487" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 221.07631186652483 -80.96747994175487 L 220.99240647322972 -80.96747994175487" fill="none" stroke="#000000"></path><g transform="translate(138.62,0) translate(0,-91.59) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:5.35em;--ltx-fo-height:0.89em;--ltx-fo-depth:0.15em;font-size:10pt;" height="14.36" overflow="visible" transform="matrix(1 0 0 -1 0 12.29)" width="74.08"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex65.m1.pic1.m8" class="ltx_Math" alttext="\textstyle{\partial^{(d_{0},d_{1},d_{2})}B_{d}}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msup><msub><mi>B</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\textstyle{\partial^{(d_{0},d_{1},d_{2})}B_{d}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS5.p10.5" class="ltx_p">shows that these two equivariantization maps agree with each other. Therefore, the map <math id="S5.SS2.SSS5.p10.m4" class="ltx_Math" alttext="\zeta_{(d_{0},d_{1},d_{2})}^{\sim}" display="inline" intent=":literal"><semantics><msubsup><mi>ζ</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∼</mo></msubsup><annotation encoding="application/x-tex">\zeta_{(d_{0},d_{1},d_{2})}^{\sim}</annotation></semantics></math> is indeed unambiguously well-defined, independent of the ways of grouping the partitions.</p>
</div>
<div id="S5.SS2.SSS5.p11" class="ltx_para">
<p id="S5.SS2.SSS5.p11.1" class="ltx_p">It is straightforward to carry out the above discussion to the case with more factors. Recall for <math id="S5.SS2.SSS5.p11.m1" class="ltx_Math" alttext="\delta=(d_{0},\ldots,d_{l})\in{\mathbb{A}}_{d}" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>d</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi>𝔸</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\delta=(d_{0},\ldots,d_{l})\in{\mathbb{A}}_{d}</annotation></semantics></math>, we defined</p>
<table id="S5.Ex66" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex66.m1" class="ltx_math_unparsed" alttext="B_{\delta}:=B_{d_{0}}\times\cdots\times B_{d_{l}}" display="block" intent=":literal"><semantics><mrow><mi>B</mi><msub><mrow></mrow><mi>δ</mi></msub><mo>:=</mo><mi>B</mi><msub><mrow></mrow><msub><mi>d</mi><mn>0</mn></msub></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi>B</mi><msub><mrow></mrow><msub><mi>d</mi><mi>l</mi></msub></msub></mrow><annotation encoding="application/x-tex">B_{\delta}:=B_{d_{0}}\times\cdots\times B_{d_{l}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS5.p11.2" class="ltx_p">which has the action of <math id="S5.SS2.SSS5.p11.m2" class="ltx_Math" alttext="G_{\delta}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>δ</mi></msub><annotation encoding="application/x-tex">G_{\delta}</annotation></semantics></math>. Using the group embedding (<a href="#S5.E4" title="In item 4 ‣ Notation 5.7. ‣ 5.1.4. Notations ‣ 5.1. Basic notions and the main theorem about global charts ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.4</span></a>), define</p>
<table id="S5.Ex67" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex67.m1" class="ltx_Math" alttext="B_{\delta}^{\sim}:=G_{d}\times_{G_{\delta}}B_{\delta}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>B</mi><mi>δ</mi><mo>∼</mo></msubsup><mo>:=</mo><mrow><msub><mi>G</mi><mi>d</mi></msub><msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>G</mi><mi>δ</mi></msub></msub><msub><mi>B</mi><mi>δ</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">B_{\delta}^{\sim}:=G_{d}\times_{G_{\delta}}B_{\delta}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS5.p11.3" class="ltx_p">Then there is a <math id="S5.SS2.SSS5.p11.m3" class="ltx_Math" alttext="G_{d}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>d</mi></msub><annotation encoding="application/x-tex">G_{d}</annotation></semantics></math>-equivariant map</p>
<table id="S5.E11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E11.m1" class="ltx_Math" alttext="\zeta_{\delta}^{\sim}:B_{\delta}^{\sim}\hookrightarrow\partial^{\delta}B_{d}," display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>ζ</mi><mi>δ</mi><mo>∼</mo></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>B</mi><mi>δ</mi><mo>∼</mo></msubsup><mo rspace="0.111em" stretchy="false">↪</mo><mrow><msup><mo>∂</mo><mi>δ</mi></msup><msub><mi>B</mi><mi>d</mi></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\zeta_{\delta}^{\sim}:B_{\delta}^{\sim}\hookrightarrow\partial^{\delta}B_{d},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.11)</span></td></tr></tbody>
</table>
<p id="S5.SS2.SSS5.p11.4" class="ltx_p">which, for instance, can be constructed by writing <math id="S5.SS2.SSS5.p11.m4" class="ltx_Math" alttext="B_{\delta}^{\sim}" display="inline" intent=":literal"><semantics><msubsup><mi>B</mi><mi>δ</mi><mo>∼</mo></msubsup><annotation encoding="application/x-tex">B_{\delta}^{\sim}</annotation></semantics></math> as</p>
<table id="S5.Ex68" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex68.m1" class="ltx_math_unparsed" alttext="G_{d}(B_{d_{0}}\times\cdots\times_{G_{d_{l-2}}\times G_{d_{l-1}+d_{l}}}(G_{d_{l-1}+d_{l}}\times_{G_{d_{l-1}}\times G_{d_{l}}}(B_{d_{l-1}}\times B_{d_{l}})))." display="block" intent=":literal"><semantics><mrow><msub><mi>G</mi><mi>d</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>B</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><msub><mo rspace="0.222em">×</mo><mrow><msub><mi>G</mi><msub><mi>d</mi><mrow><mi>l</mi><mo>−</mo><mn>2</mn></mrow></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>G</mi><mrow><msub><mi>d</mi><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>+</mo><msub><mi>d</mi><mi>l</mi></msub></mrow></msub></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mrow><msub><mi>d</mi><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>+</mo><msub><mi>d</mi><mi>l</mi></msub></mrow></msub><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><msub><mi>G</mi><msub><mi>d</mi><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>G</mi><msub><mi>d</mi><mi>l</mi></msub></msub></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>B</mi><msub><mi>d</mi><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>B</mi><msub><mi>d</mi><mi>l</mi></msub></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">G_{d}(B_{d_{0}}\times\cdots\times_{G_{d_{l-2}}\times G_{d_{l-1}+d_{l}}}(G_{d_{l-1}+d_{l}}\times_{G_{d_{l-1}}\times G_{d_{l}}}(B_{d_{l-1}}\times B_{d_{l}}))).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS5.p11.5" class="ltx_p">Proposition <a href="#S5.Thmthm22" title="Proposition 5.22. ‣ 5.2.5. Boundary strata of the auxiliary moduli spaces ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.22</span></a> indicates that such an inductive construction of the map <math id="S5.SS2.SSS5.p11.m5" class="ltx_Math" alttext="\zeta_{\delta}^{\sim}" display="inline" intent=":literal"><semantics><msubsup><mi>ζ</mi><mi>δ</mi><mo>∼</mo></msubsup><annotation encoding="application/x-tex">\zeta_{\delta}^{\sim}</annotation></semantics></math> is independent of the order of the factorization. This embedding is smooth. The following statement follows from the arguments in the proof of Lemma <a href="#S5.Thmthm21" title="Lemma 5.21. ‣ 5.2.5. Boundary strata of the auxiliary moduli spaces ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.21</span></a> and we record it here.</p>
</div>
<div id="S5.Thmthm23" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm23.2" class="ltx_text ltx_font_bold">Lemma 5.23</span></span><span id="S5.Thmthm23.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm23.p1" class="ltx_para">
<p id="S5.Thmthm23.p1.1" class="ltx_p"><math id="S5.Thmthm23.p1.m1" class="ltx_Math" alttext="\zeta_{\delta}^{\sim}" display="inline" intent=":literal"><semantics><msubsup><mi>ζ</mi><mi>δ</mi><mo>∼</mo></msubsup><annotation encoding="application/x-tex">\zeta_{\delta}^{\sim}</annotation></semantics></math><span id="S5.Thmthm23.p1.1.1" class="ltx_text ltx_font_italic"> is bijective onto <math id="S5.Thmthm23.p1.m2" class="ltx_Math" alttext="(\partial^{\delta}B_{d})^{\rm normal}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">∂</mo><mi>δ</mi></msup><msub><mi>B</mi><mi>d</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mi>normal</mi></msup><annotation encoding="application/x-tex">(\partial^{\delta}B_{d})^{\rm normal}</annotation></semantics></math>. ∎</span></p>
</div>
</div>
<div id="S5.SS2.SSS5.p12" class="ltx_para">
<p id="S5.SS2.SSS5.p12.1" class="ltx_p">Lastly we need to analyze the difference between <math id="S5.SS2.SSS5.p12.m1" class="ltx_Math" alttext="B_{\delta}^{\sim}" display="inline" intent=":literal"><semantics><msubsup><mi>B</mi><mi>δ</mi><mo>∼</mo></msubsup><annotation encoding="application/x-tex">B_{\delta}^{\sim}</annotation></semantics></math> and <math id="S5.SS2.SSS5.p12.m2" class="ltx_Math" alttext="\partial^{\delta}B_{d}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mi>δ</mi></msup><msub><mi>B</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\partial^{\delta}B_{d}</annotation></semantics></math>. We will show that in fact, <math id="S5.SS2.SSS5.p12.m3" class="ltx_Math" alttext="\partial^{\delta}B_{d}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mi>δ</mi></msup><msub><mi>B</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\partial^{\delta}B_{d}</annotation></semantics></math> can be viewed as the total space of a <math id="S5.SS2.SSS5.p12.m4" class="ltx_Math" alttext="G_{\delta}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>δ</mi></msub><annotation encoding="application/x-tex">G_{\delta}</annotation></semantics></math>-equivariant vector bundle over <math id="S5.SS2.SSS5.p12.m5" class="ltx_Math" alttext="B_{\delta}^{\sim}" display="inline" intent=":literal"><semantics><msubsup><mi>B</mi><mi>δ</mi><mo>∼</mo></msubsup><annotation encoding="application/x-tex">B_{\delta}^{\sim}</annotation></semantics></math>.</p>
</div>
<div id="S5.SS2.SSS5.p13" class="ltx_para">
<p id="S5.SS2.SSS5.p13.1" class="ltx_p">We introduce certain notations which will also be used in the thickening construction. For all <math id="S5.SS2.SSS5.p13.m1" class="ltx_Math" alttext="d\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d\geq 0</annotation></semantics></math>, denote</p>
<table id="S5.E12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E12.m1" class="ltx_math_unparsed" alttext="{\bm{Q}}_{d}=\tilde{\bm{Q}}_{d}/{\mathbb{R}}_{+}\ {\rm where}\ \tilde{\bm{Q}}_{d}:=\Big\{\tilde{h}\in\mathbb{C}^{(d+1)\times(d+1)}\ |\ \tilde{h}^{\dagger}=\tilde{h},\ \tilde{h}_{00}\neq 0\Big\}." display="block" intent=":literal"><semantics><mrow><msub><mi>𝑸</mi><mi>d</mi></msub><mo>=</mo><msub><mover accent="true"><mi>𝑸</mi><mo>~</mo></mover><mi>d</mi></msub><mo>/</mo><msub><mi>ℝ</mi><mo>+</mo></msub><mi>where</mi><msub><mover accent="true"><mi>𝑸</mi><mo>~</mo></mover><mi>d</mi></msub><mo>:=</mo><mrow><mo stretchy="false">{</mo><mover accent="true"><mi>h</mi><mo>~</mo></mover><mo>∈</mo><msup><mi>ℂ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo fence="false" rspace="0.667em" stretchy="false">|</mo><msup><mover accent="true"><mi>h</mi><mo>~</mo></mover><mo>†</mo></msup><mo>=</mo><mover accent="true"><mi>h</mi><mo>~</mo></mover><mo rspace="0.667em">,</mo><msub><mover accent="true"><mi>h</mi><mo>~</mo></mover><mn>00</mn></msub><mo>≠</mo><mn>0</mn><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\bm{Q}}_{d}=\tilde{\bm{Q}}_{d}/{\mathbb{R}}_{+}\ {\rm where}\ \tilde{\bm{Q}}_{d}:=\Big\{\tilde{h}\in\mathbb{C}^{(d+1)\times(d+1)}\ |\ \tilde{h}^{\dagger}=\tilde{h},\ \tilde{h}_{00}\neq 0\Big\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.12)</span></td></tr></tbody>
</table>
<p id="S5.SS2.SSS5.p13.2" class="ltx_p">Here our convention is that the indices of the Hermitian matrix <math id="S5.SS2.SSS5.p13.m2" class="ltx_Math" alttext="\tilde{h}\in\tilde{\bm{Q}}_{d}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>h</mi><mo>~</mo></mover><mo>∈</mo><msub><mover accent="true"><mi>𝑸</mi><mo>~</mo></mover><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\tilde{h}\in\tilde{\bm{Q}}_{d}</annotation></semantics></math> range from <math id="S5.SS2.SSS5.p13.m3" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> to <math id="S5.SS2.SSS5.p13.m4" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>; the multiplicative group <math id="S5.SS2.SSS5.p13.m5" class="ltx_Math" alttext="{\mathbb{R}}_{+}" display="inline" intent=":literal"><semantics><msub><mi>ℝ</mi><mo>+</mo></msub><annotation encoding="application/x-tex">{\mathbb{R}}_{+}</annotation></semantics></math> acts on <math id="S5.SS2.SSS5.p13.m6" class="ltx_Math" alttext="\tilde{\bm{Q}}_{d}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>𝑸</mi><mo>~</mo></mover><mi>d</mi></msub><annotation encoding="application/x-tex">\tilde{\bm{Q}}_{d}</annotation></semantics></math> by scalar multiplication on each entry. The <math id="S5.SS2.SSS5.p13.m7" class="ltx_Math" alttext="{\mathbb{R}}_{+}" display="inline" intent=":literal"><semantics><msub><mi>ℝ</mi><mo>+</mo></msub><annotation encoding="application/x-tex">{\mathbb{R}}_{+}</annotation></semantics></math>-orbit of <math id="S5.SS2.SSS5.p13.m8" class="ltx_Math" alttext="\tilde{h}\in\tilde{\bm{Q}}_{d}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>h</mi><mo>~</mo></mover><mo>∈</mo><msub><mover accent="true"><mi>𝑸</mi><mo>~</mo></mover><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\tilde{h}\in\tilde{\bm{Q}}_{d}</annotation></semantics></math> is denoted by <math id="S5.SS2.SSS5.p13.m9" class="ltx_Math" alttext="[\tilde{h}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>h</mi><mo>~</mo></mover><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[\tilde{h}]</annotation></semantics></math>. We identify <math id="S5.SS2.SSS5.p13.m10" class="ltx_Math" alttext="{\bm{Q}}_{d}" display="inline" intent=":literal"><semantics><msub><mi>𝑸</mi><mi>d</mi></msub><annotation encoding="application/x-tex">{\bm{Q}}_{d}</annotation></semantics></math> with</p>
<table id="S5.E13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E13.m1" class="ltx_math_unparsed" alttext="{\bm{Q}}_{d}^{*}:=\Big\{h\in\mathbb{C}^{(d+1)\times(d+1)}\ |\ h^{\dagger}=h,\ h_{00}=0\Big\}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>𝑸</mi><mi>d</mi><mo>∗</mo></msubsup><mo>:=</mo><mrow><mo stretchy="false">{</mo><mi>h</mi><mo>∈</mo><msup><mi>ℂ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo fence="false" rspace="0.667em" stretchy="false">|</mo><msup><mi>h</mi><mo>†</mo></msup><mo>=</mo><mi>h</mi><mo rspace="0.667em">,</mo><msub><mi>h</mi><mn>00</mn></msub><mo>=</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{Q}}_{d}^{*}:=\Big\{h\in\mathbb{C}^{(d+1)\times(d+1)}\ |\ h^{\dagger}=h,\ h_{00}=0\Big\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.13)</span></td></tr></tbody>
</table>
<p id="S5.SS2.SSS5.p13.3" class="ltx_p">in the way that a Hermitian matrix <math id="S5.SS2.SSS5.p13.m11" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> with <math id="S5.SS2.SSS5.p13.m12" class="ltx_Math" alttext="h_{00}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mn>00</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">h_{00}=0</annotation></semantics></math> is identified with the <math id="S5.SS2.SSS5.p13.m13" class="ltx_Math" alttext="{\mathbb{R}}_{+}" display="inline" intent=":literal"><semantics><msub><mi>ℝ</mi><mo>+</mo></msub><annotation encoding="application/x-tex">{\mathbb{R}}_{+}</annotation></semantics></math>-orbit of <math id="S5.SS2.SSS5.p13.m14" class="ltx_Math" alttext="\tilde{h}=I_{d+1}+h" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>h</mi><mo>~</mo></mover><mo>=</mo><mrow><msub><mi>I</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>+</mo><mi>h</mi></mrow></mrow><annotation encoding="application/x-tex">\tilde{h}=I_{d+1}+h</annotation></semantics></math>. Then <math id="S5.SS2.SSS5.p13.m15" class="ltx_Math" alttext="{\bm{Q}}_{d}" display="inline" intent=":literal"><semantics><msub><mi>𝑸</mi><mi>d</mi></msub><annotation encoding="application/x-tex">{\bm{Q}}_{d}</annotation></semantics></math> is a real vector space with dimension equal to <math id="S5.SS2.SSS5.p13.m16" class="ltx_Math" alttext="d^{2}+2d" display="inline" intent=":literal"><semantics><mrow><msup><mi>d</mi><mn>2</mn></msup><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><annotation encoding="application/x-tex">d^{2}+2d</annotation></semantics></math>. Moreover, by identifying <math id="S5.SS2.SSS5.p13.m17" class="ltx_Math" alttext="G_{d}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>d</mi></msub><annotation encoding="application/x-tex">G_{d}</annotation></semantics></math> with <math id="S5.SS2.SSS5.p13.m18" class="ltx_Math" alttext="U(d)\subset U(d+1)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">U(d)\subset U(d+1)</annotation></semantics></math> using the correspondence (<a href="#S5.E3" title="In item 3 ‣ Notation 5.7. ‣ 5.1.4. Notations ‣ 5.1. Basic notions and the main theorem about global charts ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.3</span></a>), the usual conjugation action of <math id="S5.SS2.SSS5.p13.m19" class="ltx_Math" alttext="U(d+1)" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">U(d+1)</annotation></semantics></math> on <math id="S5.SS2.SSS5.p13.m20" class="ltx_Math" alttext="(d+1)\times(d+1)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(d+1)\times(d+1)</annotation></semantics></math> Hermitian matrices restricts to a linear action of <math id="S5.SS2.SSS5.p13.m21" class="ltx_Math" alttext="G_{d}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>d</mi></msub><annotation encoding="application/x-tex">G_{d}</annotation></semantics></math> on <math id="S5.SS2.SSS5.p13.m22" class="ltx_Math" alttext="{\bm{Q}}_{d}" display="inline" intent=":literal"><semantics><msub><mi>𝑸</mi><mi>d</mi></msub><annotation encoding="application/x-tex">{\bm{Q}}_{d}</annotation></semantics></math>.</p>
</div>
<div id="S5.SS2.SSS5.p14" class="ltx_para">
<p id="S5.SS2.SSS5.p14.1" class="ltx_p">To go further, for each partition <math id="S5.SS2.SSS5.p14.m1" class="ltx_Math" alttext="\delta=(d_{0},\ldots,d_{l})\in{\mathbb{A}}_{d}" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>d</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi>𝔸</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\delta=(d_{0},\ldots,d_{l})\in{\mathbb{A}}_{d}</annotation></semantics></math>, define</p>
<table id="S5.Ex69" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex69.m1" class="ltx_math_unparsed" alttext="{\bm{Q}}_{\delta}:=\Big\{[\tilde{h}]\in{\bm{Q}}_{d}\ |\ \tilde{h}_{ij}\neq 0\Longrightarrow\exists\ a\geq-1\ {\rm s.t.}\ d_{0}+\cdots+d_{a}\leq i,j\leq d_{0}+\cdots+d_{a+1}\Big\}" display="block" intent=":literal"><semantics><mrow><msub><mi>𝑸</mi><mi>δ</mi></msub><mo>:=</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>h</mi><mo>~</mo></mover><mo stretchy="false">]</mo></mrow><mo>∈</mo><msub><mi>𝑸</mi><mi>d</mi></msub><mo fence="false" rspace="0.667em" stretchy="false">|</mo><msub><mover accent="true"><mi>h</mi><mo>~</mo></mover><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>≠</mo><mn>0</mn><mo stretchy="false">⟹</mo><mo rspace="0.667em">∃</mo><mi>a</mi><mo rspace="0em">≥</mo><mo lspace="0em">−</mo><mn>1</mn><mi>s</mi><mo lspace="0em" rspace="0.167em">.</mo><mi>t</mi><mo lspace="0em" rspace="0.667em">.</mo><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>d</mi><mi>a</mi></msub><mo>≤</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>≤</mo><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>d</mi><mrow><mi>a</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{Q}}_{\delta}:=\Big\{[\tilde{h}]\in{\bm{Q}}_{d}\ |\ \tilde{h}_{ij}\neq 0\Longrightarrow\exists\ a\geq-1\ {\rm s.t.}\ d_{0}+\cdots+d_{a}\leq i,j\leq d_{0}+\cdots+d_{a+1}\Big\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS5.p14.2" class="ltx_p">where for <math id="S5.SS2.SSS5.p14.m2" class="ltx_Math" alttext="a=-1" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>=</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">a=-1</annotation></semantics></math>, the constraints on the entries are given by <math id="S5.SS2.SSS5.p14.m3" class="ltx_Math" alttext="0\leq i,j\leq d_{0}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>0</mn><mo>≤</mo><mi>i</mi></mrow><mo>,</mo><mrow><mi>j</mi><mo>≤</mo><msub><mi>d</mi><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">0\leq i,j\leq d_{0}</annotation></semantics></math>,
and its complement</p>
<table id="S5.Ex70" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex70.m1" class="ltx_Math" alttext="\begin{split}\check{\bm{Q}}_{\delta}:=&amp;\ \Big\{[\tilde{h}]\in{\bm{Q}}_{d}\ |\ \tilde{h}_{ij}=0\ \forall a=0,\ldots,l,\ d_{0}+\cdots+d_{a}\leq i,j\leq d_{0}+\cdots+d_{a+1}\Big\}\\
\cong&amp;\ \Big\{h\in{\bm{Q}}_{d}^{*}\ |\ h_{ij}=0\ \forall a=0,\ldots,l,\ d_{0}+\cdots+d_{a}\leq i,j\leq d_{0}+\cdots+d_{a+1}\Big\}.\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><msub><mover accent="true"><mi>𝑸</mi><mo>ˇ</mo></mover><mi>δ</mi></msub><mo>:=</mo><mphantom></mphantom></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo stretchy="false">{</mo><mo stretchy="false">[</mo><mover accent="true"><mi>h</mi><mo>~</mo></mover><mo stretchy="false">]</mo><mo>∈</mo><mi>𝑸</mi><msub><mrow></mrow><mi>d</mi></msub><mo fence="false" lspace="0.500em" rspace="0.667em" stretchy="false">|</mo><mover accent="true"><mi>h</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mn>0</mn><mo lspace="1.167em" rspace="0.167em">∀</mo><mi>a</mi><mo>=</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>l</mi><mo rspace="1.167em">,</mo><mi>d</mi><msub><mrow></mrow><mn>0</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><mi>d</mi><msub><mrow></mrow><mi>a</mi></msub><mo>≤</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>≤</mo><mi>d</mi><msub><mrow></mrow><mn>0</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><mi>d</mi><msub><mrow></mrow><mrow><mi>a</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">}</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>≅</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo stretchy="false">{</mo><mi>h</mi><mo>∈</mo><mi>𝑸</mi><msub><mrow></mrow><mi>d</mi></msub><msup><mrow></mrow><mo>∗</mo></msup><mo fence="false" lspace="0.500em" rspace="1.167em" stretchy="false">|</mo><mi>h</mi><msub><mrow></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mn>0</mn><mo lspace="1.167em" rspace="0.167em">∀</mo><mi>a</mi><mo>=</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>l</mi><mo rspace="1.167em">,</mo><mi>d</mi><msub><mrow></mrow><mn>0</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><mi>d</mi><msub><mrow></mrow><mi>a</mi></msub><mo>≤</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>≤</mo><mi>d</mi><msub><mrow></mrow><mn>0</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><mi>d</mi><msub><mrow></mrow><mrow><mi>a</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">}</mo><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\check{\bm{Q}}_{\delta}:=&amp;\ \Big\{[\tilde{h}]\in{\bm{Q}}_{d}\ |\ \tilde{h}_{ij}=0\ \forall a=0,\ldots,l,\ d_{0}+\cdots+d_{a}\leq i,j\leq d_{0}+\cdots+d_{a+1}\Big\}\\
\cong&amp;\ \Big\{h\in{\bm{Q}}_{d}^{*}\ |\ h_{ij}=0\ \forall a=0,\ldots,l,\ d_{0}+\cdots+d_{a}\leq i,j\leq d_{0}+\cdots+d_{a+1}\Big\}.\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS5.p14.3" class="ltx_p">This vector space is invariant under the adjoint action of <math id="S5.SS2.SSS5.p14.m4" class="ltx_Math" alttext="G_{\delta}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>δ</mi></msub><annotation encoding="application/x-tex">G_{\delta}</annotation></semantics></math>. Hence we have a <math id="S5.SS2.SSS5.p14.m5" class="ltx_Math" alttext="G_{\delta}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>δ</mi></msub><annotation encoding="application/x-tex">G_{\delta}</annotation></semantics></math>-equivariant splitting</p>
<table id="S5.Ex71" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex71.m1" class="ltx_Math" alttext="{\bm{Q}}_{d}={\bm{Q}}_{\delta}\oplus{\bm{Q}}_{d,\delta}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝑸</mi><mi>d</mi></msub><mo>=</mo><mrow><msub><mi>𝑸</mi><mi>δ</mi></msub><mo>⊕</mo><msub><mi>𝑸</mi><mrow><mi>d</mi><mo>,</mo><mi>δ</mi></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\bm{Q}}_{d}={\bm{Q}}_{\delta}\oplus{\bm{Q}}_{d,\delta}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS5.p14.4" class="ltx_p">Moreover, <math id="S5.SS2.SSS5.p14.m6" class="ltx_Math" alttext="{\bm{Q}}_{d}" display="inline" intent=":literal"><semantics><msub><mi>𝑸</mi><mi>d</mi></msub><annotation encoding="application/x-tex">{\bm{Q}}_{d}</annotation></semantics></math> is stratified by partitions. When <math id="S5.SS2.SSS5.p14.m7" class="ltx_Math" alttext="\delta\leq\eta" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>≤</mo><mi>η</mi></mrow><annotation encoding="application/x-tex">\delta\leq\eta</annotation></semantics></math>, one has the obvious inclusion</p>
<table id="S5.Ex72" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex72.m1" class="ltx_Math" alttext="{\bm{Q}}_{\delta}\subset{\bm{Q}}_{\eta}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝑸</mi><mi>δ</mi></msub><mo>⊂</mo><msub><mi>𝑸</mi><mi>η</mi></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\bm{Q}}_{\delta}\subset{\bm{Q}}_{\eta}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS5.p14.5" class="ltx_p">Define</p>
<table id="S5.Ex73" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex73.m1" class="ltx_Math" alttext="{\bm{Q}}_{\eta\delta}:={\bm{Q}}_{\eta}\cap{\bm{Q}}_{d,\delta}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝑸</mi><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow></msub><mo>:=</mo><mrow><msub><mi>𝑸</mi><mi>η</mi></msub><mo>∩</mo><msub><mi>𝑸</mi><mrow><mi>d</mi><mo>,</mo><mi>δ</mi></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\bm{Q}}_{\eta\delta}:={\bm{Q}}_{\eta}\cap{\bm{Q}}_{d,\delta}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS5.p14.6" class="ltx_p">Using the <math id="S5.SS2.SSS5.p14.m8" class="ltx_Math" alttext="G_{\delta}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>δ</mi></msub><annotation encoding="application/x-tex">G_{\delta}</annotation></semantics></math>-action on the space <math id="S5.SS2.SSS5.p14.m9" class="ltx_Math" alttext="{\bm{Q}}_{d,\delta}" display="inline" intent=":literal"><semantics><msub><mi>𝑸</mi><mrow><mi>d</mi><mo>,</mo><mi>δ</mi></mrow></msub><annotation encoding="application/x-tex">{\bm{Q}}_{d,\delta}</annotation></semantics></math>, we define a <math id="S5.SS2.SSS5.p14.m10" class="ltx_Math" alttext="G_{\delta}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>δ</mi></msub><annotation encoding="application/x-tex">G_{\delta}</annotation></semantics></math>-equivariant vector bundle</p>
<table id="S5.Ex74" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex74.m1" class="ltx_Math" alttext="Q_{d,\delta}:=B_{\delta}\times{\bm{Q}}_{d,\delta}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>Q</mi><mrow><mi>d</mi><mo>,</mo><mi>δ</mi></mrow></msub><mo>:=</mo><mrow><msub><mi>B</mi><mi>δ</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝑸</mi><mrow><mi>d</mi><mo>,</mo><mi>δ</mi></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Q_{d,\delta}:=B_{\delta}\times{\bm{Q}}_{d,\delta}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS5.p14.7" class="ltx_p">The <math id="S5.SS2.SSS5.p14.m11" class="ltx_Math" alttext="G_{d}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>d</mi></msub><annotation encoding="application/x-tex">G_{d}</annotation></semantics></math>-equivariantization of this vector bundle is denoted by</p>
<table id="S5.E14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E14.m1" class="ltx_Math" alttext="Q_{d,\delta}^{\sim}:=G_{d}\times_{G_{\delta}}Q_{d,\delta}\to B_{\delta}^{\sim}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>Q</mi><mrow><mi>d</mi><mo>,</mo><mi>δ</mi></mrow><mo>∼</mo></msubsup><mo>:=</mo><mrow><msub><mi>G</mi><mi>d</mi></msub><msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>G</mi><mi>δ</mi></msub></msub><msub><mi>Q</mi><mrow><mi>d</mi><mo>,</mo><mi>δ</mi></mrow></msub></mrow><mo stretchy="false">→</mo><msubsup><mi>B</mi><mi>δ</mi><mo>∼</mo></msubsup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Q_{d,\delta}^{\sim}:=G_{d}\times_{G_{\delta}}Q_{d,\delta}\to B_{\delta}^{\sim}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.14)</span></td></tr></tbody>
</table>
</div>
<div id="S5.Thmthm24" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm24.2" class="ltx_text ltx_font_bold">Proposition 5.24</span></span><span id="S5.Thmthm24.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm24.p1" class="ltx_para">
<p id="S5.Thmthm24.p1.1" class="ltx_p"><span id="S5.Thmthm24.p1.1.1" class="ltx_text ltx_font_italic">There is a <math id="S5.Thmthm24.p1.m1" class="ltx_Math" alttext="G_{d}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>d</mi></msub><annotation encoding="application/x-tex">G_{d}</annotation></semantics></math>-equivariant diffeomorphism</span></p>
<table id="S5.Ex75" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex75.m1" class="ltx_Math" alttext="\rho_{\delta}^{\sim}:Q_{d,\delta}^{\sim}\cong\partial^{\delta}B_{d}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>ρ</mi><mi>δ</mi><mo>∼</mo></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>Q</mi><mrow><mi>d</mi><mo>,</mo><mi>δ</mi></mrow><mo>∼</mo></msubsup><mo rspace="0.111em">≅</mo><mrow><msup><mo>∂</mo><mi>δ</mi></msup><msub><mi>B</mi><mi>d</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho_{\delta}^{\sim}:Q_{d,\delta}^{\sim}\cong\partial^{\delta}B_{d}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmthm24.p1.2" class="ltx_p"><span id="S5.Thmthm24.p1.2.1" class="ltx_text ltx_font_italic">which extends the embedding <math id="S5.Thmthm24.p1.m2" class="ltx_Math" alttext="\zeta_{\delta}^{\sim}:B_{\delta}^{\sim}\hookrightarrow\partial^{\delta}B_{d}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ζ</mi><mi>δ</mi><mo>∼</mo></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>B</mi><mi>δ</mi><mo>∼</mo></msubsup><mo rspace="0.111em" stretchy="false">↪</mo><mrow><msup><mo>∂</mo><mi>δ</mi></msup><msub><mi>B</mi><mi>d</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\zeta_{\delta}^{\sim}:B_{\delta}^{\sim}\hookrightarrow\partial^{\delta}B_{d}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S5.SS2.SSS5.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.SS2.SSS5.p15" class="ltx_para">
<p id="S5.SS2.SSS5.p15.1" class="ltx_p"><span id="S5.SS2.SSS5.p15.1.1" class="ltx_text">We first define a map <math id="S5.SS2.SSS5.p15.m1" class="ltx_Math" alttext="\rho_{\delta}:Q_{d,\delta}\to\partial^{\delta}B_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mi>δ</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>Q</mi><mrow><mi>d</mi><mo>,</mo><mi>δ</mi></mrow></msub><mo rspace="0.111em" stretchy="false">→</mo><mrow><msup><mo>∂</mo><mi>δ</mi></msup><msub><mi>B</mi><mi>d</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho_{\delta}:Q_{d,\delta}\to\partial^{\delta}B_{d}</annotation></semantics></math> which extends <math id="S5.SS2.SSS5.p15.m2" class="ltx_Math" alttext="\zeta_{\delta}:B_{\delta}\to\partial^{\delta}B_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ζ</mi><mi>δ</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>B</mi><mi>δ</mi></msub><mo rspace="0.111em" stretchy="false">→</mo><mrow><msup><mo>∂</mo><mi>δ</mi></msup><msub><mi>B</mi><mi>d</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\zeta_{\delta}:B_{\delta}\to\partial^{\delta}B_{d}</annotation></semantics></math> as follows. Given a Hermitian matrix <math id="S5.SS2.SSS5.p15.m3" class="ltx_Math" alttext="h\in\check{\bm{Q}}_{\delta}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>∈</mo><msub><mover accent="true"><mi>𝑸</mi><mo>ˇ</mo></mover><mi>δ</mi></msub></mrow><annotation encoding="application/x-tex">h\in\check{\bm{Q}}_{\delta}</annotation></semantics></math>, we identify it with a complex matrix <math id="S5.SS2.SSS5.p15.m4" class="ltx_Math" alttext="\rho_{h}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mi>h</mi></msub><annotation encoding="application/x-tex">\rho_{h}</annotation></semantics></math> obtained by changing all entries in <math id="S5.SS2.SSS5.p15.m5" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> that are below the diagonal to zero. Then define</span></p>
<table id="S5.Ex76" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex76.m1" class="ltx_Math" alttext="\rho_{\delta}(h,x_{0},\ldots,x_{l}):=(I_{d+1}+\rho_{h})(\zeta_{\delta}(x_{0},\ldots,x_{d}))." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ρ</mi><mi>δ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo>,</mo><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>I</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>+</mo><msub><mi>ρ</mi><mi>h</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ζ</mi><mi>δ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\rho_{\delta}(h,x_{0},\ldots,x_{l}):=(I_{d+1}+\rho_{h})(\zeta_{\delta}(x_{0},\ldots,x_{d})).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS5.p15.2" class="ltx_p"><span id="S5.SS2.SSS5.p15.2.1" class="ltx_text">Note that <math id="S5.SS2.SSS5.p15.m6" class="ltx_Math" alttext="I_{d+1}+\rho_{h}" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>+</mo><msub><mi>ρ</mi><mi>h</mi></msub></mrow><annotation encoding="application/x-tex">I_{d+1}+\rho_{h}</annotation></semantics></math> is a nonsingular matrix because <math id="S5.SS2.SSS5.p15.m7" class="ltx_Math" alttext="\rho_{h}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mi>h</mi></msub><annotation encoding="application/x-tex">\rho_{h}</annotation></semantics></math> is nilpotent. It is straightforward to check that this map is equivariant with respect to the group embedding <math id="S5.SS2.SSS5.p15.m8" class="ltx_Math" alttext="G_{\delta}\to G_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mi>δ</mi></msub><mo stretchy="false">→</mo><msub><mi>G</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">G_{\delta}\to G_{d}</annotation></semantics></math>. Hence it extends to a <math id="S5.SS2.SSS5.p15.m9" class="ltx_Math" alttext="G_{d}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>d</mi></msub><annotation encoding="application/x-tex">G_{d}</annotation></semantics></math>-equivariant map</span></p>
<table id="S5.Ex77" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex77.m1" class="ltx_Math" alttext="\rho_{\delta}^{\sim}:Q_{d,\delta}^{\sim}\to\partial^{\delta}B_{d}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>ρ</mi><mi>δ</mi><mo>∼</mo></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>Q</mi><mrow><mi>d</mi><mo>,</mo><mi>δ</mi></mrow><mo>∼</mo></msubsup><mo rspace="0.111em" stretchy="false">→</mo><mrow><msup><mo>∂</mo><mi>δ</mi></msup><msub><mi>B</mi><mi>d</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\rho_{\delta}^{\sim}:Q_{d,\delta}^{\sim}\to\partial^{\delta}B_{d}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS5.p15.3" class="ltx_p"><span id="S5.SS2.SSS5.p15.3.1" class="ltx_text">We need to show that this map is a diffeomorphism.</span></p>
</div>
<div id="S5.SS2.SSS5.p16" class="ltx_para">
<ol id="S5.I13" class="ltx_enumerate">
<li id="S5.I13.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S5.I13.i1.p1" class="ltx_para">
<p id="S5.I13.i1.p1.1" class="ltx_p">(Injectivity) Suppose</p>
<table id="S5.Ex78" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex78.m1" class="ltx_Math" alttext="x=\rho_{\delta}^{\sim}([g,h,x_{0},\ldots,x_{l}])=\rho_{\delta}^{\sim}([g^{\prime},h^{\prime},x_{0}^{\prime},\ldots,x_{l}^{\prime}])." display="block" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>=</mo><mrow><msubsup><mi>ρ</mi><mi>δ</mi><mo>∼</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mrow><mi>g</mi><mo>,</mo><mi>h</mi><mo>,</mo><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mi>l</mi></msub></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>ρ</mi><mi>δ</mi><mo>∼</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>g</mi><mo>′</mo></msup><mo>,</mo><msup><mi>h</mi><mo>′</mo></msup><mo>,</mo><msubsup><mi>x</mi><mn>0</mn><mo>′</mo></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>x</mi><mi>l</mi><mo>′</mo></msubsup></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">x=\rho_{\delta}^{\sim}([g,h,x_{0},\ldots,x_{l}])=\rho_{\delta}^{\sim}([g^{\prime},h^{\prime},x_{0}^{\prime},\ldots,x_{l}^{\prime}]).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I13.i1.p1.2" class="ltx_p">Then by the definition of <math id="S5.I13.i1.p1.m1" class="ltx_Math" alttext="\rho_{\delta}^{\sim}" display="inline" intent=":literal"><semantics><msubsup><mi>ρ</mi><mi>δ</mi><mo>∼</mo></msubsup><annotation encoding="application/x-tex">\rho_{\delta}^{\sim}</annotation></semantics></math>, we may assume that <math id="S5.I13.i1.p1.m2" class="ltx_Math" alttext="g^{\prime}=1\in G_{d}" display="inline" intent=":literal"><semantics><mrow><msup><mi>g</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn><mo>∈</mo><msub><mi>G</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">g^{\prime}=1\in G_{d}</annotation></semantics></math>. Then, notice that the flag induced by <math id="S5.I13.i1.p1.m3" class="ltx_Math" alttext="\rho_{\delta}(h^{\prime},x_{0}^{\prime},\ldots,x_{l}^{\prime})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mi>δ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>h</mi><mo>′</mo></msup><mo>,</mo><msubsup><mi>x</mi><mn>0</mn><mo>′</mo></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>x</mi><mi>l</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho_{\delta}(h^{\prime},x_{0}^{\prime},\ldots,x_{l}^{\prime})</annotation></semantics></math> is the standard one and <math id="S5.I13.i1.p1.m4" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> preserves the flag. Then <math id="S5.I13.i1.p1.m5" class="ltx_Math" alttext="g\in G_{\delta}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>∈</mo><msub><mi>G</mi><mi>δ</mi></msub></mrow><annotation encoding="application/x-tex">g\in G_{\delta}</annotation></semantics></math>. Hence we may also assume <math id="S5.I13.i1.p1.m6" class="ltx_Math" alttext="g=1\in G_{pq}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>=</mo><mn>1</mn><mo>∈</mo><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">g=1\in G_{pq}</annotation></semantics></math>. By considering the fans associated to stable maps, one can also conclude that <math id="S5.I13.i1.p1.m7" class="ltx_Math" alttext="h=h^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>=</mo><msup><mi>h</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">h=h^{\prime}</annotation></semantics></math>. As <math id="S5.I13.i1.p1.m8" class="ltx_Math" alttext="I_{d+1}+\rho_{h}" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>+</mo><msub><mi>ρ</mi><mi>h</mi></msub></mrow><annotation encoding="application/x-tex">I_{d+1}+\rho_{h}</annotation></semantics></math> is invertible, one obtains that <math id="S5.I13.i1.p1.m9" class="ltx_Math" alttext="x_{i}=x_{i}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>i</mi></msub><mo>=</mo><msubsup><mi>x</mi><mi>i</mi><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">x_{i}=x_{i}^{\prime}</annotation></semantics></math> for all <math id="S5.I13.i1.p1.m10" class="ltx_Math" alttext="i=0,\ldots,l" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>l</mi></mrow><annotation encoding="application/x-tex">i=0,\ldots,l</annotation></semantics></math>. Hence <math id="S5.I13.i1.p1.m11" class="ltx_Math" alttext="\rho_{\delta}^{\sim}" display="inline" intent=":literal"><semantics><msubsup><mi>ρ</mi><mi>δ</mi><mo>∼</mo></msubsup><annotation encoding="application/x-tex">\rho_{\delta}^{\sim}</annotation></semantics></math> is injective.</p>
</div></li>
<li id="S5.I13.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S5.I13.i2.p1" class="ltx_para">
<p id="S5.I13.i2.p1.1" class="ltx_p">(Surjectivity) Let <math id="S5.I13.i2.p1.m1" class="ltx_Math" alttext="x\in\partial^{\delta}B_{d}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo rspace="0.111em">∈</mo><mrow><msup><mo>∂</mo><mi>δ</mi></msup><msub><mi>B</mi><mi>d</mi></msub></mrow></mrow><annotation encoding="application/x-tex">x\in\partial^{\delta}B_{d}</annotation></semantics></math> be represented by a map</p>
<table id="S5.Ex79" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex79.m1" class="ltx_Math" alttext="u=(u_{0},\ldots,u_{l}):\Sigma_{0}\vee\cdots\vee\Sigma_{l}\to\mathbb{CP}^{d}." display="block" intent=":literal"><semantics><mrow><mrow><mi>u</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>u</mi><mi>l</mi></msub><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mrow><mrow><msub><mi mathvariant="normal">Σ</mi><mn>0</mn></msub><mo>∨</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>∨</mo><msub><mi mathvariant="normal">Σ</mi><mi>l</mi></msub></mrow><mo stretchy="false">→</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">u=(u_{0},\ldots,u_{l}):\Sigma_{0}\vee\cdots\vee\Sigma_{l}\to\mathbb{CP}^{d}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I13.i2.p1.2" class="ltx_p">Let <math id="S5.I13.i2.p1.m2" class="ltx_Math" alttext="(V_{0},\ldots,V_{l})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>V</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(V_{0},\ldots,V_{l})</annotation></semantics></math> be the induced flag. Then there exists a unitary matrix <math id="S5.I13.i2.p1.m3" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> which transforms this flag to the standard one. Hence we may assume the flag associated to <math id="S5.I13.i2.p1.m4" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> is standard. Let <math id="S5.I13.i2.p1.m5" class="ltx_Math" alttext="(W_{d_{0}},\ldots,W_{d_{l}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>W</mi><msub><mi>d</mi><mi>l</mi></msub></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(W_{d_{0}},\ldots,W_{d_{l}})</annotation></semantics></math> be the fan associated to <math id="S5.I13.i2.p1.m6" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>. We construct an element <math id="S5.I13.i2.p1.m7" class="ltx_Math" alttext="h\in{\bm{Q}}_{d,\delta}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>∈</mo><msub><mi>𝑸</mi><mrow><mi>d</mi><mo>,</mo><mi>δ</mi></mrow></msub></mrow><annotation encoding="application/x-tex">h\in{\bm{Q}}_{d,\delta}</annotation></semantics></math> such that</p>
<table id="S5.Ex80" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex80.m1" class="ltx_Math" alttext="(I_{d_{pq}+1}+\rho_{h})(W_{d_{0}},\ldots,W_{d_{l}})" display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>I</mi><mrow><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>+</mo><mn>1</mn></mrow></msub><mo>+</mo><msub><mi>ρ</mi><mi>h</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>W</mi><msub><mi>d</mi><mi>l</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(I_{d_{pq}+1}+\rho_{h})(W_{d_{0}},\ldots,W_{d_{l}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I13.i2.p1.3" class="ltx_p">is in the normal position. <math id="S5.I13.i2.p1.m8" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> can be constructed inductively. First, let <math id="S5.I13.i2.p1.m9" class="ltx_Math" alttext="y_{0}\in\mathbb{C}^{d_{0}+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mn>0</mn></msub><mo>∈</mo><msup><mi>ℂ</mi><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">y_{0}\in\mathbb{C}^{d_{0}+1}</annotation></semantics></math> be the noramlized evaluation of <math id="S5.I13.i2.p1.m10" class="ltx_Math" alttext="u_{0}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mn>0</mn></msub><annotation encoding="application/x-tex">u_{0}</annotation></semantics></math> at <math id="S5.I13.i2.p1.m11" class="ltx_Math" alttext="z_{+}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mo>+</mo></msub><annotation encoding="application/x-tex">z_{+}</annotation></semantics></math>. Regard <math id="S5.I13.i2.p1.m12" class="ltx_Math" alttext="y_{0}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mn>0</mn></msub><annotation encoding="application/x-tex">y_{0}</annotation></semantics></math> as a vector in <math id="S5.I13.i2.p1.m13" class="ltx_Math" alttext="\mathbb{C}^{d_{0}+d_{1}+1}" display="inline" intent=":literal"><semantics><msup><mi>ℂ</mi><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">\mathbb{C}^{d_{0}+d_{1}+1}</annotation></semantics></math>. Then there exist vectors <math id="S5.I13.i2.p1.m14" class="ltx_Math" alttext="w_{1},\ldots,w_{d_{1}}\in\mathbb{C}^{d_{0}+d_{1}+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>w</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>w</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo>∈</mo><msup><mi>ℂ</mi><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">w_{1},\ldots,w_{d_{1}}\in\mathbb{C}^{d_{0}+d_{1}+1}</annotation></semantics></math> such that</p>
<table id="S5.Ex81" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex81.m1" class="ltx_Math" alttext="W_{d_{1}}={\rm span}(y_{0},w_{1},\ldots,w_{d_{1}})." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>W</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo>=</mo><mrow><mi>span</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>0</mn></msub><mo>,</mo><msub><mi>w</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>w</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">W_{d_{1}}={\rm span}(y_{0},w_{1},\ldots,w_{d_{1}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I13.i2.p1.4" class="ltx_p">Then as <math id="S5.I13.i2.p1.m15" class="ltx_Math" alttext="W_{d_{0}}={\mathbb{C}}^{d_{0}+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo>=</mo><msup><mi>ℂ</mi><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">W_{d_{0}}={\mathbb{C}}^{d_{0}+1}</annotation></semantics></math> and <math id="S5.I13.i2.p1.m16" class="ltx_Math" alttext="W_{d_{0}}+W_{d_{1}}={\mathbb{C}}^{d_{0}+d_{1}+1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>W</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo>+</mo><msub><mi>W</mi><msub><mi>d</mi><mn>1</mn></msub></msub></mrow><mo>=</mo><msup><mi>ℂ</mi><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">W_{d_{0}}+W_{d_{1}}={\mathbb{C}}^{d_{0}+d_{1}+1}</annotation></semantics></math>, there exists a complex matrix <math id="S5.I13.i2.p1.m17" class="ltx_Math" alttext="A_{d_{1}}^{d_{0}}" display="inline" intent=":literal"><semantics><msubsup><mi>A</mi><msub><mi>d</mi><mn>1</mn></msub><msub><mi>d</mi><mn>0</mn></msub></msubsup><annotation encoding="application/x-tex">A_{d_{1}}^{d_{0}}</annotation></semantics></math> whose nonzero entries are contained in the upper-right <math id="S5.I13.i2.p1.m18" class="ltx_Math" alttext="d_{0}\times d_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mn>0</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>d</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">d_{0}\times d_{1}</annotation></semantics></math>-block such that</p>
<table id="S5.Ex82" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex82.m1" class="ltx_Math" alttext="(I_{d_{pr_{2}}+1}-A_{d_{1}}^{d_{0}})(w_{1},\ldots,w_{d_{1}})=(e_{d_{0}+1},\ldots,e_{d_{0}+d_{1}})" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>I</mi><mrow><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>2</mn></msub></mrow></msub><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msubsup><mi>A</mi><msub><mi>d</mi><mn>1</mn></msub><msub><mi>d</mi><mn>0</mn></msub></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>w</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>e</mi><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><msub><mi>d</mi><mn>1</mn></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(I_{d_{pr_{2}}+1}-A_{d_{1}}^{d_{0}})(w_{1},\ldots,w_{d_{1}})=(e_{d_{0}+1},\ldots,e_{d_{0}+d_{1}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I13.i2.p1.5" class="ltx_p">(where <math id="S5.I13.i2.p1.m19" class="ltx_Math" alttext="e_{0},\ldots,e_{d_{0}+d_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>e</mi><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><msub><mi>d</mi><mn>1</mn></msub></mrow></msub></mrow><annotation encoding="application/x-tex">e_{0},\ldots,e_{d_{0}+d_{1}}</annotation></semantics></math> form the standard basis of <math id="S5.I13.i2.p1.m20" class="ltx_Math" alttext="{\mathbb{C}}^{d_{0}+d_{1}+1}" display="inline" intent=":literal"><semantics><msup><mi>ℂ</mi><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">{\mathbb{C}}^{d_{0}+d_{1}+1}</annotation></semantics></math>). Inductively, one can construct a matrix</p>
<table id="S5.Ex83" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex83.m1" class="ltx_Math" alttext="A:=\left[\begin{array}[]{ccccc}0&amp;A_{d_{1}}^{d_{0}}&amp;A_{d_{2}}^{d_{0}}&amp;\cdots&amp;A_{d_{l}}^{d_{0}}\\
0&amp;0&amp;A_{d_{2}}^{d_{1}}&amp;\cdots&amp;A_{d_{l}}^{d_{1}}\\
\vdots&amp;\vdots&amp;\vdots&amp;\ddots&amp;\vdots\\
0&amp;0&amp;0&amp;0&amp;0\end{array}\right]" display="block" intent=":literal"><semantics><mrow><mi>A</mi><mo>:=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mi>A</mi><msub><mi>d</mi><mn>1</mn></msub><msub><mi>d</mi><mn>0</mn></msub></msubsup></mtd><mtd><msubsup><mi>A</mi><msub><mi>d</mi><mn>2</mn></msub><msub><mi>d</mi><mn>0</mn></msub></msubsup></mtd><mtd><mo>⋯</mo></mtd><mtd><msubsup><mi>A</mi><msub><mi>d</mi><mi>l</mi></msub><msub><mi>d</mi><mn>0</mn></msub></msubsup></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><msubsup><mi>A</mi><msub><mi>d</mi><mn>2</mn></msub><msub><mi>d</mi><mn>1</mn></msub></msubsup></mtd><mtd><mo>⋯</mo></mtd><mtd><msubsup><mi>A</mi><msub><mi>d</mi><mi>l</mi></msub><msub><mi>d</mi><mn>1</mn></msub></msubsup></mtd></mtr><mtr><mtd><mi mathvariant="normal">⋮</mi></mtd><mtd><mi mathvariant="normal">⋮</mi></mtd><mtd><mi mathvariant="normal">⋮</mi></mtd><mtd><mi mathvariant="normal">⋱</mi></mtd><mtd><mi mathvariant="normal">⋮</mi></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr></mtable><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">A:=\left[\begin{array}[]{ccccc}0&amp;A_{d_{1}}^{d_{0}}&amp;A_{d_{2}}^{d_{0}}&amp;\cdots&amp;A_{d_{l}}^{d_{0}}\\
0&amp;0&amp;A_{d_{2}}^{d_{1}}&amp;\cdots&amp;A_{d_{l}}^{d_{1}}\\
\vdots&amp;\vdots&amp;\vdots&amp;\ddots&amp;\vdots\\
0&amp;0&amp;0&amp;0&amp;0\end{array}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I13.i2.p1.6" class="ltx_p">such that <math id="S5.I13.i2.p1.m21" class="ltx_Math" alttext="(I_{d+1}-A)(W_{d_{0}},\ldots,W_{d_{l}})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>I</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><mi>A</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>W</mi><msub><mi>d</mi><mi>l</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(I_{d+1}-A)(W_{d_{0}},\ldots,W_{d_{l}})</annotation></semantics></math> is a fan in the normal position. Apply <math id="S5.I13.i2.p1.m22" class="ltx_Math" alttext="I_{d+1}-A" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><mi>A</mi></mrow><annotation encoding="application/x-tex">I_{d+1}-A</annotation></semantics></math> to the stable map <math id="S5.I13.i2.p1.m23" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math>, one obtains a stable map <math id="S5.I13.i2.p1.m24" class="ltx_Math" alttext="u^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>u</mi><mo>′</mo></msup><annotation encoding="application/x-tex">u^{\prime}</annotation></semantics></math> which is in the normal position in <math id="S5.I13.i2.p1.m25" class="ltx_Math" alttext="\partial^{\delta}B_{d}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mi>δ</mi></msup><msub><mi>B</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\partial^{\delta}B_{d}</annotation></semantics></math>. The nilpotence of <math id="S5.I13.i2.p1.m26" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> and its block form imply that <math id="S5.I13.i2.p1.m27" class="ltx_Math" alttext="-A=\rho_{h}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mi>A</mi></mrow><mo>=</mo><msub><mi>ρ</mi><mi>h</mi></msub></mrow><annotation encoding="application/x-tex">-A=\rho_{h}</annotation></semantics></math> for some <math id="S5.I13.i2.p1.m28" class="ltx_Math" alttext="h\in{\bm{Q}}_{d,\delta}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>∈</mo><msub><mi>𝑸</mi><mrow><mi>d</mi><mo>,</mo><mi>δ</mi></mrow></msub></mrow><annotation encoding="application/x-tex">h\in{\bm{Q}}_{d,\delta}</annotation></semantics></math>. As stable maps in normal positions are all in the image of <math id="S5.I13.i2.p1.m29" class="ltx_Math" alttext="\zeta_{\delta}^{\sim}" display="inline" intent=":literal"><semantics><msubsup><mi>ζ</mi><mi>δ</mi><mo>∼</mo></msubsup><annotation encoding="application/x-tex">\zeta_{\delta}^{\sim}</annotation></semantics></math>, the above argument implies that <math id="S5.I13.i2.p1.m30" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> is surjective.</p>
</div></li>
</ol>
<p id="S5.SS2.SSS5.p16.1" class="ltx_p"><span id="S5.SS2.SSS5.p16.1.1" class="ltx_text">The smoothness of <math id="S5.SS2.SSS5.p16.m1" class="ltx_Math" alttext="\rho_{\delta}^{\sim}" display="inline" intent=":literal"><semantics><msubsup><mi>ρ</mi><mi>δ</mi><mo>∼</mo></msubsup><annotation encoding="application/x-tex">\rho_{\delta}^{\sim}</annotation></semantics></math> and its inverse follows from the definition and the smoothness of <math id="S5.SS2.SSS5.p16.m2" class="ltx_Math" alttext="\zeta_{\delta}^{\sim}" display="inline" intent=":literal"><semantics><msubsup><mi>ζ</mi><mi>δ</mi><mo>∼</mo></msubsup><annotation encoding="application/x-tex">\zeta_{\delta}^{\sim}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="S5.SS2.SSS6" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">5.2.6. </span>Product of the bundle of quadratic forms</h4>

<div id="S5.SS2.SSS6.p1" class="ltx_para">
<p id="S5.SS2.SSS6.p1.1" class="ltx_p">The bundles of quadratic forms play an crucial role in the construction of global charts, as they will be part of the obstruction bundle. We describe the multiplicative structures of these bundles. Define for each <math id="S5.SS2.SSS6.p1.m1" class="ltx_Math" alttext="d\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d\geq 1</annotation></semantics></math> the <math id="S5.SS2.SSS6.p1.m2" class="ltx_Math" alttext="G_{d}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>d</mi></msub><annotation encoding="application/x-tex">G_{d}</annotation></semantics></math>-equivariant bundle</p>
<table id="S5.Ex84" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex84.m1" class="ltx_Math" alttext="Q_{d}:=B_{d}\times{\bm{Q}}_{d}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>Q</mi><mi>d</mi></msub><mo>:=</mo><mrow><msub><mi>B</mi><mi>d</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝑸</mi><mi>d</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Q_{d}:=B_{d}\times{\bm{Q}}_{d}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS6.p1.2" class="ltx_p">We would like to define a collection of equivariant bundle embeddings</p>
<table id="S5.Ex85" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S5.Ex85.m1.pic1" class="ltx_picture ltx_markedasmath" height="72.46" overflow="visible" style="vertical-align:-62.312549355120126px" version="1.1" viewBox="34.11 62.31 193.94 72.46" width="193.94"><g transform="matrix(1 0 0 -1 34.111659523855856 72.45965463847594) translate(0,3.46) translate(34.11,0)"><g transform="translate(-33.86,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:4.29em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.25em;font-size:10pt;" height="12.91" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="59.42"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex85.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{Q_{d_{0}}\boxplus Q_{d_{1}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo>⊞</mo><msub><mi>Q</mi><msub><mi>d</mi><mn>1</mn></msub></msub></mrow><annotation encoding="application/x-tex">\textstyle{Q_{d_{0}}\boxplus Q_{d_{1}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 33.86085122819591 -0.27673578005007266 L 33.86085122819591 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(108.96,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 33.86085122819591 -0.27673578005007266 L 108.95685386209051 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 108.95685386209051 -0.27673578005007266 L 108.95685386209051 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -11.069600110696001 L 0.27673578005007266 -11.069600110696001" fill="none" stroke="#000000"></path><g transform="translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.208800332088 L 0.27673578005007266 -11.069600110696001" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.208800332088 L 0.27673578005007266 -33.208800332088" fill="none" stroke="#000000"></path><g transform="translate(108.96,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:3.07em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.25em;font-size:10pt;" height="12.91" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="42.45"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex85.m1.pic1.m3" class="ltx_Math" alttext="\textstyle{Q_{d_{0}+d_{1}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><msub><mi>d</mi><mn>1</mn></msub></mrow></msub><annotation encoding="application/x-tex">\textstyle{Q_{d_{0}+d_{1}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 134.05432093435425 -11.069600110696001 L 134.6077924944544 -11.069600110696001" fill="none" stroke="#000000"></path><g transform="translate(134.33,0) translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 134.05432093435425 -33.208800332088 L 134.6077924944544 -11.069600110696001" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 134.05432093435425 -33.208800332088 L 134.6077924944544 -33.208800332088" fill="none" stroke="#000000"></path><g transform="translate(-34.11,0) translate(0,-43.36) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:4.33em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.25em;font-size:10pt;" height="12.91" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="59.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex85.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{B_{d_{0}}\times B_{d_{1}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>B</mi><msub><mi>d</mi><mn>1</mn></msub></msub></mrow><annotation encoding="application/x-tex">\textstyle{B_{d_{0}}\times B_{d_{1}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 34.111659523855856 -43.63264139549389 L 34.111659523855856 -43.07916983539375" fill="none" stroke="#000000"></path><g transform="translate(44.49,0) translate(0,-52.83) translate(4.15,0) translate(0,-1.4)"><foreignObject style="--ltx-fo-width:2.68em;--ltx-fo-height:0.49em;--ltx-fo-depth:0.28em;font-size:10pt;" height="10.65" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="37.05"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex85.m1.pic1.m5" class="ltx_Math" alttext="\scriptstyle{\zeta_{(d_{0},d_{1})}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">ζ</mi><mrow><mo maxsize="0.710em" minsize="0.710em">(</mo><msub><mi mathsize="0.710em">d</mi><mn>0</mn></msub><mo mathsize="0.710em">,</mo><msub><mi mathsize="0.710em">d</mi><mn>1</mn></msub><mo maxsize="0.710em" minsize="0.710em">)</mo></mrow></msub><annotation encoding="application/x-tex">\scriptstyle{\zeta_{(d_{0},d_{1})}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(108.83,0) translate(0,-43.36)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 34.111659523855856 -43.63264139549389 L 108.83146027105386 -43.07916983539375" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 108.83146027105386 -43.63264139549389 L 108.83146027105386 -43.07916983539375" fill="none" stroke="#000000"></path><g transform="translate(108.83,0) translate(0,-43.36) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:3.09em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.25em;font-size:10pt;" height="12.91" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="42.7"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex85.m1.pic1.m7" class="ltx_Math" alttext="\textstyle{B_{d_{0}+d_{1}}}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><msub><mi>d</mi><mn>1</mn></msub></mrow></msub><annotation encoding="application/x-tex">\textstyle{B_{d_{0}+d_{1}}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS6.p1.3" class="ltx_p">which are associative. Let us look at the partition <math id="S5.SS2.SSS6.p1.m3" class="ltx_Math" alttext="d=d_{0}+d_{1}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><msub><mi>d</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">d=d_{0}+d_{1}</annotation></semantics></math> and let</p>
<table id="S5.Ex86" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex86.m1" class="ltx_Math" alttext="Q_{d_{0}\to d},Q_{d_{1}\to d}\to B_{(d_{0},d_{1})}\cong B_{d_{0}}\times B_{d_{1}}" display="block" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mrow><msub><mi>d</mi><mn>0</mn></msub><mo stretchy="false">→</mo><mi>d</mi></mrow></msub><mo>,</mo><mrow><msub><mi>Q</mi><mrow><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">→</mo><mi>d</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi>B</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo>≅</mo><mrow><msub><mi>B</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>B</mi><msub><mi>d</mi><mn>1</mn></msub></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">Q_{d_{0}\to d},Q_{d_{1}\to d}\to B_{(d_{0},d_{1})}\cong B_{d_{0}}\times B_{d_{1}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS6.p1.4" class="ltx_p">be the bundles <math id="S5.SS2.SSS6.p1.m4" class="ltx_Math" alttext="B_{(d_{0},d_{1})}\times{\bm{Q}}_{d_{0}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝑸</mi><msub><mi>d</mi><mn>0</mn></msub></msub></mrow><annotation encoding="application/x-tex">B_{(d_{0},d_{1})}\times{\bm{Q}}_{d_{0}}</annotation></semantics></math> and <math id="S5.SS2.SSS6.p1.m5" class="ltx_Math" alttext="B_{(d_{0},d_{1})}\times{\bm{Q}}_{d_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝑸</mi><msub><mi>d</mi><mn>1</mn></msub></msub></mrow><annotation encoding="application/x-tex">B_{(d_{0},d_{1})}\times{\bm{Q}}_{d_{1}}</annotation></semantics></math>. Define embeddings</p>
<table id="S5.EGx13" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.Ex87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex87.m1" class="ltx_Math" alttext="\displaystyle\ \widehat{\zeta}_{d_{0}\to d}^{Q}:Q_{d_{0}\to d}\to Q_{d},\ " display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>ζ</mi><mo>^</mo></mover><mrow><msub><mi>d</mi><mn>0</mn></msub><mo stretchy="false">→</mo><mi>d</mi></mrow><mi>Q</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>Q</mi><mrow><msub><mi>d</mi><mn>0</mn></msub><mo stretchy="false">→</mo><mi>d</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi>Q</mi><mi>d</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ \widehat{\zeta}_{d_{0}\to d}^{Q}:Q_{d_{0}\to d}\to Q_{d},\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex87.m2" class="ltx_Math" alttext="\displaystyle\ \widehat{\zeta}_{d_{1}\to d}^{Q}:Q_{d_{1}\to d}\to Q_{d}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>ζ</mi><mo>^</mo></mover><mrow><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">→</mo><mi>d</mi></mrow><mi>Q</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>Q</mi><mrow><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">→</mo><mi>d</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi>Q</mi><mi>d</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ \widehat{\zeta}_{d_{1}\to d}^{Q}:Q_{d_{1}\to d}\to Q_{d}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS6.p1.5" class="ltx_p">as follows.</p>
<ol id="S5.I14" class="ltx_enumerate">
<li id="S5.I14.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S5.I14.i1.p1" class="ltx_para">
<p id="S5.I14.i1.p1.1" class="ltx_p">For <math id="S5.I14.i1.p1.m1" class="ltx_Math" alttext="\widehat{\zeta}_{d_{0}\to d}^{Q}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>ζ</mi><mo>^</mo></mover><mrow><msub><mi>d</mi><mn>0</mn></msub><mo stretchy="false">→</mo><mi>d</mi></mrow><mi>Q</mi></msubsup><annotation encoding="application/x-tex">\widehat{\zeta}_{d_{0}\to d}^{Q}</annotation></semantics></math>: for each element <math id="S5.I14.i1.p1.m2" class="ltx_Math" alttext="h_{d_{0}}\in{\bm{Q}}_{d_{0}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo>∈</mo><msub><mi>𝑸</mi><msub><mi>d</mi><mn>0</mn></msub></msub></mrow><annotation encoding="application/x-tex">h_{d_{0}}\in{\bm{Q}}_{d_{0}}</annotation></semantics></math> (which is regarded as a Hermitian matrix whose <math id="S5.I14.i1.p1.m3" class="ltx_Math" alttext="(0,0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,0)</annotation></semantics></math>-entry vanishes), define</p>
<table id="S5.Ex88" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex88.m1" class="ltx_Math" alttext="\Big(\widehat{\zeta}_{d_{0}\to d}^{Q}(x_{d_{0}},x_{d_{1}};h_{d_{0}})\Big)_{ij}=\left\{\begin{array}[]{cc}(h_{d_{0}})_{ij},&amp;\ 0\leq i,j\leq d_{0},\\
0,&amp;\ {\rm otherwise,}\end{array}\right." display="block" intent=":literal"><semantics><mrow><msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msubsup><mover accent="true"><mi>ζ</mi><mo>^</mo></mover><mrow><msub><mi>d</mi><mn>0</mn></msub><mo stretchy="false">→</mo><mi>d</mi></mrow><mi>Q</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo>,</mo><msub><mi>x</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo>,</mo><msub><mi>h</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>h</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>,</mo></mrow></mtd><mtd><mrow><mn> 0</mn><mo>≤</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>≤</mo><mi>d</mi><msub><mrow></mrow><mn>0</mn></msub><mo>,</mo></mrow></mtd></mtr><mtr><mtd><mrow><mn>0</mn><mo>,</mo></mrow></mtd><mtd><mrow><mi>otherwise</mi><mo>,</mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">\Big(\widehat{\zeta}_{d_{0}\to d}^{Q}(x_{d_{0}},x_{d_{1}};h_{d_{0}})\Big)_{ij}=\left\{\begin{array}[]{cc}(h_{d_{0}})_{ij},&amp;\ 0\leq i,j\leq d_{0},\\
0,&amp;\ {\rm otherwise,}\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I14.i1.p1.2" class="ltx_p">which gives a Hermtian matrix in <math id="S5.I14.i1.p1.m4" class="ltx_Math" alttext="{\bm{Q}}_{d}" display="inline" intent=":literal"><semantics><msub><mi>𝑸</mi><mi>d</mi></msub><annotation encoding="application/x-tex">{\bm{Q}}_{d}</annotation></semantics></math> (regarded as a matrix whose <math id="S5.I14.i1.p1.m5" class="ltx_Math" alttext="(0,0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,0)</annotation></semantics></math>-entry vanishes).</p>
</div></li>
<li id="S5.I14.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S5.I14.i2.p1" class="ltx_para">
<p id="S5.I14.i2.p1.1" class="ltx_p">For <math id="S5.I14.i2.p1.m1" class="ltx_Math" alttext="\widehat{\theta}_{d_{1}\to d}^{Q}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mrow><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">→</mo><mi>d</mi></mrow><mi>Q</mi></msubsup><annotation encoding="application/x-tex">\widehat{\theta}_{d_{1}\to d}^{Q}</annotation></semantics></math>: for <math id="S5.I14.i2.p1.m2" class="ltx_Math" alttext="x=(x_{d_{0}},x_{d_{1}})" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo>,</mo><msub><mi>x</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">x=(x_{d_{0}},x_{d_{1}})</annotation></semantics></math>, let the normalized evaluation of <math id="S5.I14.i2.p1.m3" class="ltx_Math" alttext="x_{d_{0}}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><msub><mi>d</mi><mn>0</mn></msub></msub><annotation encoding="application/x-tex">x_{d_{0}}</annotation></semantics></math> at <math id="S5.I14.i2.p1.m4" class="ltx_Math" alttext="z_{+}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mo>+</mo></msub><annotation encoding="application/x-tex">z_{+}</annotation></semantics></math> to be <math id="S5.I14.i2.p1.m5" class="ltx_Math" alttext="(a_{0},\ldots,a_{d_{0}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a_{0},\ldots,a_{d_{0}})</annotation></semantics></math>. Then there exists an element <math id="S5.I14.i2.p1.m6" class="ltx_Math" alttext="g_{x}\in U(d_{0}+1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>x</mi></msub><mo>∈</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">g_{x}\in U(d_{0}+1)</annotation></semantics></math> such that</p>
<table id="S5.E15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E15.m1" class="ltx_Math" alttext="g_{x}(0,\ldots,1)=(a_{0},\ldots,a_{d_{0}})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>g</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">g_{x}(0,\ldots,1)=(a_{0},\ldots,a_{d_{0}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.15)</span></td></tr></tbody>
</table>
<p id="S5.I14.i2.p1.2" class="ltx_p">Embed <math id="S5.I14.i2.p1.m7" class="ltx_Math" alttext="g_{x}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mi>x</mi></msub><annotation encoding="application/x-tex">g_{x}</annotation></semantics></math> into <math id="S5.I14.i2.p1.m8" class="ltx_Math" alttext="PU(d_{0}+1)" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">PU(d_{0}+1)</annotation></semantics></math> with image</p>
<table id="S5.Ex89" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex89.m1" class="ltx_Math" alttext="\left[\begin{array}[]{cc}(g_{x})_{(d_{0}+1)\times(d_{0}+1)}&amp;0\\
0&amp;I_{d_{1}}\end{array}\right]" display="block" intent=":literal"><semantics><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd><msub><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>x</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><msub><mi>I</mi><msub><mi>d</mi><mn>1</mn></msub></msub></mtd></mtr></mtable><mo>]</mo></mrow><annotation encoding="application/x-tex">\left[\begin{array}[]{cc}(g_{x})_{(d_{0}+1)\times(d_{0}+1)}&amp;0\\
0&amp;I_{d_{1}}\end{array}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I14.i2.p1.3" class="ltx_p">and denote it by <math id="S5.I14.i2.p1.m9" class="ltx_Math" alttext="g_{x}^{+}" display="inline" intent=":literal"><semantics><msubsup><mi>g</mi><mi>x</mi><mo>+</mo></msubsup><annotation encoding="application/x-tex">g_{x}^{+}</annotation></semantics></math>. Then for <math id="S5.I14.i2.p1.m10" class="ltx_Math" alttext="h_{d_{1}}\in{\bm{Q}}_{d_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo>∈</mo><msub><mi>𝑸</mi><msub><mi>d</mi><mn>1</mn></msub></msub></mrow><annotation encoding="application/x-tex">h_{d_{1}}\in{\bm{Q}}_{d_{1}}</annotation></semantics></math>, define the Hermitian matrix with vanishing <math id="S5.I14.i2.p1.m11" class="ltx_Math" alttext="(0,0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,0)</annotation></semantics></math>-entry</p>
<table id="S5.Ex90" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex90.m1" class="ltx_Math" alttext="h_{d_{1}}^{+}\in{\bm{Q}}_{d},\ (h_{d_{1}}^{+})_{ij}=\left\{\begin{array}[]{cc}(h_{d_{1}})_{i-d_{0}\ j-d_{0}},&amp;\ d_{0}\leq i,j\leq d,\\
0,&amp;\ {\rm otherwise}\end{array}\right." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>h</mi><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo></msubsup><mo>∈</mo><msub><mi>𝑸</mi><mi>d</mi></msub></mrow><mo rspace="0.667em">,</mo><mrow><msub><mrow><mo stretchy="false">(</mo><msubsup><mi>h</mi><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>h</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>−</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>−</mo><msub><mi>d</mi><mn>0</mn></msub></mrow></msub><mo>,</mo></mrow></mtd><mtd><mrow><mi>d</mi><msub><mrow></mrow><mn>0</mn></msub><mo>≤</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>≤</mo><mi>d</mi><mo>,</mo></mrow></mtd></mtr><mtr><mtd><mrow><mn>0</mn><mo>,</mo></mrow></mtd><mtd><mi>otherwise</mi></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow></mrow><annotation encoding="application/x-tex">h_{d_{1}}^{+}\in{\bm{Q}}_{d},\ (h_{d_{1}}^{+})_{ij}=\left\{\begin{array}[]{cc}(h_{d_{1}})_{i-d_{0}\ j-d_{0}},&amp;\ d_{0}\leq i,j\leq d,\\
0,&amp;\ {\rm otherwise}\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I14.i2.p1.4" class="ltx_p">and define</p>
<table id="S5.Ex91" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex91.m1" class="ltx_Math" alttext="\widehat{\zeta}_{d_{1}\to d}^{Q}(x_{d_{0}},x_{d_{1}};h_{d_{1}})=g_{x}^{+}h_{d_{1}}^{+}(g_{x}^{+})^{-1}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mover accent="true"><mi>ζ</mi><mo>^</mo></mover><mrow><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">→</mo><mi>d</mi></mrow><mi>Q</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo>,</mo><msub><mi>x</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo>,</mo><msub><mi>h</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>g</mi><mi>x</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>h</mi><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>g</mi><mi>x</mi><mo>+</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widehat{\zeta}_{d_{1}\to d}^{Q}(x_{d_{0}},x_{d_{1}};h_{d_{1}})=g_{x}^{+}h_{d_{1}}^{+}(g_{x}^{+})^{-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I14.i2.p1.5" class="ltx_p">We can easily check that this is independent of the choice of <math id="S5.I14.i2.p1.m12" class="ltx_Math" alttext="g_{x}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mi>x</mi></msub><annotation encoding="application/x-tex">g_{x}</annotation></semantics></math> satisfying (<a href="#S5.E15" title="In item 2 ‣ 5.2.6. Product of the bundle of quadratic forms ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.15</span></a>).</p>
</div></li>
</ol>
<p id="S5.SS2.SSS6.p1.6" class="ltx_p">Then <math id="S5.SS2.SSS6.p1.m6" class="ltx_Math" alttext="\widehat{\zeta}_{d_{0}\to d}^{Q}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>ζ</mi><mo>^</mo></mover><mrow><msub><mi>d</mi><mn>0</mn></msub><mo stretchy="false">→</mo><mi>d</mi></mrow><mi>Q</mi></msubsup><annotation encoding="application/x-tex">\widehat{\zeta}_{d_{0}\to d}^{Q}</annotation></semantics></math> and <math id="S5.SS2.SSS6.p1.m7" class="ltx_Math" alttext="\widehat{\zeta}_{d_{1}\to d}^{Q}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>ζ</mi><mo>^</mo></mover><mrow><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">→</mo><mi>d</mi></mrow><mi>Q</mi></msubsup><annotation encoding="application/x-tex">\widehat{\zeta}_{d_{1}\to d}^{Q}</annotation></semantics></math> canonically correspond to bundle maps, which are denoted by the same symbols respectively. Then define a map</p>
<table id="S5.Ex92" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex92.m1" class="ltx_Math" alttext="\widehat{\zeta}_{(d_{0},d_{1})}^{Q}:Q_{d_{0}\to d}\oplus Q_{d_{1}\to d}\to B_{(d_{0},d_{1})}\times{\bm{Q}}_{d}" display="block" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>ζ</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mi>Q</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>Q</mi><mrow><msub><mi>d</mi><mn>0</mn></msub><mo stretchy="false">→</mo><mi>d</mi></mrow></msub><mo>⊕</mo><msub><mi>Q</mi><mrow><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">→</mo><mi>d</mi></mrow></msub></mrow><mo stretchy="false">→</mo><mrow><msub><mi>B</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝑸</mi><mi>d</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\widehat{\zeta}_{(d_{0},d_{1})}^{Q}:Q_{d_{0}\to d}\oplus Q_{d_{1}\to d}\to B_{(d_{0},d_{1})}\times{\bm{Q}}_{d}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS6.p1.7" class="ltx_p">to be</p>
<table id="S5.Ex93" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex93.m1" class="ltx_Math" alttext="\widehat{\zeta}_{(d_{0},d_{1})}^{Q}=\widehat{\zeta}_{d_{0}\to d}^{Q}+\widehat{\zeta}_{d_{1}\to d}^{Q}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>ζ</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mi>Q</mi></msubsup><mo>=</mo><mrow><msubsup><mover accent="true"><mi>ζ</mi><mo>^</mo></mover><mrow><msub><mi>d</mi><mn>0</mn></msub><mo stretchy="false">→</mo><mi>d</mi></mrow><mi>Q</mi></msubsup><mo>+</mo><msubsup><mover accent="true"><mi>ζ</mi><mo>^</mo></mover><mrow><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">→</mo><mi>d</mi></mrow><mi>Q</mi></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widehat{\zeta}_{(d_{0},d_{1})}^{Q}=\widehat{\zeta}_{d_{0}\to d}^{Q}+\widehat{\zeta}_{d_{1}\to d}^{Q}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S5.Thmthm25" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm25.2" class="ltx_text ltx_font_bold">Lemma 5.25</span></span><span id="S5.Thmthm25.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm25.p1" class="ltx_para">
<p id="S5.Thmthm25.p1.1" class="ltx_p"><span id="S5.Thmthm25.p1.1.1" class="ltx_text ltx_font_italic">The bundle map <math id="S5.Thmthm25.p1.m1" class="ltx_Math" alttext="\widehat{\zeta}_{(d_{0},d_{1})}^{Q}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>ζ</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mi>Q</mi></msubsup><annotation encoding="application/x-tex">\widehat{\zeta}_{(d_{0},d_{1})}^{Q}</annotation></semantics></math> is a <math id="S5.Thmthm25.p1.m2" class="ltx_Math" alttext="G_{d_{0}}\times G_{d_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>G</mi><msub><mi>d</mi><mn>1</mn></msub></msub></mrow><annotation encoding="application/x-tex">G_{d_{0}}\times G_{d_{1}}</annotation></semantics></math>-equivariant linear bundle embedding with image being the bundle <math id="S5.Thmthm25.p1.m3" class="ltx_Math" alttext="B_{(d_{0},d_{1})}\times{\bm{Q}}_{(d_{0},d_{1})}" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝐐</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msub></mrow><annotation encoding="application/x-tex">B_{(d_{0},d_{1})}\times{\bm{Q}}_{(d_{0},d_{1})}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S5.SS2.SSS6.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.SS2.SSS6.p2" class="ltx_para">
<p id="S5.SS2.SSS6.p2.1" class="ltx_p"><span id="S5.SS2.SSS6.p2.1.1" class="ltx_text">The linearity follows from the definition of <math id="S5.SS2.SSS6.p2.m1" class="ltx_Math" alttext="{\bm{Q}}_{d}" display="inline" intent=":literal"><semantics><msub><mi>𝑸</mi><mi>d</mi></msub><annotation encoding="application/x-tex">{\bm{Q}}_{d}</annotation></semantics></math> and the definition of the maps. The <math id="S5.SS2.SSS6.p2.m2" class="ltx_Math" alttext="G_{d_{0}}\times G_{d_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>G</mi><msub><mi>d</mi><mn>1</mn></msub></msub></mrow><annotation encoding="application/x-tex">G_{d_{0}}\times G_{d_{1}}</annotation></semantics></math>-equivariance of <math id="S5.SS2.SSS6.p2.m3" class="ltx_Math" alttext="\widehat{\zeta}_{d_{0}\to d}^{Q}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>ζ</mi><mo>^</mo></mover><mrow><msub><mi>d</mi><mn>0</mn></msub><mo stretchy="false">→</mo><mi>d</mi></mrow><mi>Q</mi></msubsup><annotation encoding="application/x-tex">\widehat{\zeta}_{d_{0}\to d}^{Q}</annotation></semantics></math> is obvious from the definition; the <math id="S5.SS2.SSS6.p2.m4" class="ltx_Math" alttext="G_{d_{1}}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><msub><mi>d</mi><mn>1</mn></msub></msub><annotation encoding="application/x-tex">G_{d_{1}}</annotation></semantics></math>-equivariance of <math id="S5.SS2.SSS6.p2.m5" class="ltx_Math" alttext="\widehat{\zeta}_{d_{1}\to d}^{Q}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>ζ</mi><mo>^</mo></mover><mrow><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">→</mo><mi>d</mi></mrow><mi>Q</mi></msubsup><annotation encoding="application/x-tex">\widehat{\zeta}_{d_{1}\to d}^{Q}</annotation></semantics></math> is also straightforward. However, the <math id="S5.SS2.SSS6.p2.m6" class="ltx_Math" alttext="G_{d_{0}}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><msub><mi>d</mi><mn>0</mn></msub></msub><annotation encoding="application/x-tex">G_{d_{0}}</annotation></semantics></math>-equivariance of <math id="S5.SS2.SSS6.p2.m7" class="ltx_Math" alttext="\widehat{\zeta}_{d_{1}\to d}^{Q}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>ζ</mi><mo>^</mo></mover><mrow><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">→</mo><mi>d</mi></mrow><mi>Q</mi></msubsup><annotation encoding="application/x-tex">\widehat{\zeta}_{d_{1}\to d}^{Q}</annotation></semantics></math> requires a verification. Indeed, fix <math id="S5.SS2.SSS6.p2.m8" class="ltx_Math" alttext="x=(x_{d_{0}},x_{d_{1}})" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo>,</mo><msub><mi>x</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">x=(x_{d_{0}},x_{d_{1}})</annotation></semantics></math>; suppose the normalized evaluation of <math id="S5.SS2.SSS6.p2.m9" class="ltx_Math" alttext="x_{d_{0}}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><msub><mi>d</mi><mn>0</mn></msub></msub><annotation encoding="application/x-tex">x_{d_{0}}</annotation></semantics></math> is <math id="S5.SS2.SSS6.p2.m10" class="ltx_Math" alttext="z=(a_{0},\ldots,a_{d_{0}})" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">z=(a_{0},\ldots,a_{d_{0}})</annotation></semantics></math>. Then choose <math id="S5.SS2.SSS6.p2.m11" class="ltx_Math" alttext="g\in G_{d_{0}}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>∈</mo><msub><mi>G</mi><msub><mi>d</mi><mn>0</mn></msub></msub></mrow><annotation encoding="application/x-tex">g\in G_{d_{0}}</annotation></semantics></math>. Then <math id="S5.SS2.SSS6.p2.m12" class="ltx_Math" alttext="gx=(gx_{d_{0}},x_{d_{1}})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><msub><mi>d</mi><mn>0</mn></msub></msub></mrow><mo>,</mo><msub><mi>x</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">gx=(gx_{d_{0}},x_{d_{1}})</annotation></semantics></math> and the normalized evaluation of <math id="S5.SS2.SSS6.p2.m13" class="ltx_Math" alttext="gx_{d_{0}}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><msub><mi>d</mi><mn>0</mn></msub></msub></mrow><annotation encoding="application/x-tex">gx_{d_{0}}</annotation></semantics></math> is <math id="S5.SS2.SSS6.p2.m14" class="ltx_Math" alttext="gz" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow><annotation encoding="application/x-tex">gz</annotation></semantics></math>. So if <math id="S5.SS2.SSS6.p2.m15" class="ltx_Math" alttext="[z]=[a_{0},\ldots,a_{d_{0}}]=g_{x}[0,\ldots,1]" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mi>z</mi><mo stretchy="false">]</mo></mrow><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>a</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><msub><mi>d</mi><mn>0</mn></msub></msub></mrow><mo stretchy="false">]</mo></mrow><mo>=</mo><mrow><msub><mi>g</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">[z]=[a_{0},\ldots,a_{d_{0}}]=g_{x}[0,\ldots,1]</annotation></semantics></math>, then <math id="S5.SS2.SSS6.p2.m16" class="ltx_Math" alttext="[gz]=gg_{x}[0,\ldots,1]" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow><mo stretchy="false">]</mo></mrow><mo>=</mo><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">[gz]=gg_{x}[0,\ldots,1]</annotation></semantics></math>. Then one can check the <math id="S5.SS2.SSS6.p2.m17" class="ltx_Math" alttext="G_{d_{0}}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><msub><mi>d</mi><mn>0</mn></msub></msub><annotation encoding="application/x-tex">G_{d_{0}}</annotation></semantics></math>-equivariance. The injectivity and the fact that the image is exactly <math id="S5.SS2.SSS6.p2.m18" class="ltx_Math" alttext="B_{(d_{0},d_{1})}\times{\bm{Q}}_{(d_{0},d_{1})}" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msub></mrow><annotation encoding="application/x-tex">B_{(d_{0},d_{1})}\times{\bm{Q}}_{(d_{0},d_{1})}</annotation></semantics></math> is also straightforward to verify following the proof of Lemma <a href="#S5.Thmthm21" title="Lemma 5.21. ‣ 5.2.5. Boundary strata of the auxiliary moduli spaces ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.21</span></a>.
∎</span></p>
</div>
</div>
<div id="S5.SS2.SSS6.p3" class="ltx_para">
<p id="S5.SS2.SSS6.p3.1" class="ltx_p">The following proposition is the counterpart of Proposition <a href="#S5.Thmthm22" title="Proposition 5.22. ‣ 5.2.5. Boundary strata of the auxiliary moduli spaces ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.22</span></a> for quadratic bundles, which can be proved based on keeping track of the action of <math id="S5.SS2.SSS6.p3.m1" class="ltx_Math" alttext="g_{x}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mi>x</mi></msub><annotation encoding="application/x-tex">g_{x}</annotation></semantics></math> from (<a href="#S5.E15" title="In item 2 ‣ 5.2.6. Product of the bundle of quadratic forms ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.15</span></a>).</p>
</div>
<div id="S5.Thmthm26" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm26.2" class="ltx_text ltx_font_bold">Proposition 5.26</span></span><span id="S5.Thmthm26.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm26.p1" class="ltx_para">
<p id="S5.Thmthm26.p1.1" class="ltx_p"><span id="S5.Thmthm26.p1.1.1" class="ltx_text ltx_font_italic">The bundle embeddings defined above are associative. Namely, for <math id="S5.Thmthm26.p1.m1" class="ltx_Math" alttext="d_{0},d_{1},d_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">d_{0},d_{1},d_{2}</annotation></semantics></math> such that <math id="S5.Thmthm26.p1.m2" class="ltx_Math" alttext="d=d_{0}+d_{1}+d_{2}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><msub><mi>d</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">d=d_{0}+d_{1}+d_{2}</annotation></semantics></math>, recall</span></p>
<table id="S5.Ex94" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex94.m1" class="ltx_Math" alttext="B_{(d_{0},d_{1},d_{2})}=B_{d_{0}}\times B_{d_{1}}\times B_{d_{2}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>B</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo>=</mo><mrow><msub><mi>B</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>B</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>B</mi><msub><mi>d</mi><mn>2</mn></msub></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">B_{(d_{0},d_{1},d_{2})}=B_{d_{0}}\times B_{d_{1}}\times B_{d_{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmthm26.p1.2" class="ltx_p"><span id="S5.Thmthm26.p1.2.1" class="ltx_text ltx_font_italic">Then given <math id="S5.Thmthm26.p1.m3" class="ltx_Math" alttext="x\in B_{(d_{0},d_{1},d_{2})}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msub><mi>B</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub></mrow><annotation encoding="application/x-tex">x\in B_{(d_{0},d_{1},d_{2})}</annotation></semantics></math> and</span></p>
<table id="S5.Ex95" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex95.m1" class="ltx_Math" alttext="(h_{d_{0}},h_{d_{1}},h_{d_{2}})\in{\bm{Q}}_{d_{0}}\times{\bm{Q}}_{d_{1}}\times{\bm{Q}}_{d_{2}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><msub><mi>h</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo>,</mo><msub><mi>h</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo>,</mo><msub><mi>h</mi><msub><mi>d</mi><mn>2</mn></msub></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><msub><mi>𝑸</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝑸</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝑸</mi><msub><mi>d</mi><mn>2</mn></msub></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">(h_{d_{0}},h_{d_{1}},h_{d_{2}})\in{\bm{Q}}_{d_{0}}\times{\bm{Q}}_{d_{1}}\times{\bm{Q}}_{d_{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmthm26.p1.3" class="ltx_p"><span id="S5.Thmthm26.p1.3.1" class="ltx_text ltx_font_italic">one has</span></p>
<table id="S5.Ex96" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex96.m1" class="ltx_Math" alttext="\widehat{\zeta}_{(d_{0},d_{1}+d_{2})}^{Q}(x,h_{d_{0}},\widehat{\zeta}_{(d_{1},d_{2})}^{Q}(x,h_{d_{1}},h_{d_{2}}))=\widehat{\zeta}_{(d_{0}+d_{1},d_{2})}^{Q}(x,\widehat{\zeta}_{(d_{0},d_{1})}^{Q}(x,h_{d_{0}},h_{d_{1}}),h_{d_{2}}).\qed" display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mover accent="true"><mi>ζ</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><msub><mi>d</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mi>Q</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>h</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo>,</mo><mrow><msubsup><mover accent="true"><mi>ζ</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mi>Q</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>h</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo>,</mo><msub><mi>h</mi><msub><mi>d</mi><mn>2</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mover accent="true"><mi>ζ</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>+</mo><msub><mi>d</mi><mn>1</mn></msub></mrow><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mi>Q</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mrow><msubsup><mover accent="true"><mi>ζ</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mi>Q</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>h</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo>,</mo><msub><mi>h</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>h</mi><msub><mi>d</mi><mn>2</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em" rspace="0.0835em">.</mo><mo class="ltx_mathvariant_italic" lspace="0.0835em" mathvariant="italic" separator="true">∎</mo></mrow><annotation encoding="application/x-tex">\widehat{\zeta}_{(d_{0},d_{1}+d_{2})}^{Q}(x,h_{d_{0}},\widehat{\zeta}_{(d_{1},d_{2})}^{Q}(x,h_{d_{1}},h_{d_{2}}))=\widehat{\zeta}_{(d_{0}+d_{1},d_{2})}^{Q}(x,\widehat{\zeta}_{(d_{0},d_{1})}^{Q}(x,h_{d_{0}},h_{d_{1}}),h_{d_{2}}).\qed</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S5.SS2.SSS6.p4" class="ltx_para">
<p id="S5.SS2.SSS6.p4.1" class="ltx_p">As a consequence, there is a well-defined <math id="S5.SS2.SSS6.p4.m1" class="ltx_Math" alttext="G_{d_{0}}\times G_{d_{1}}\times G_{d_{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>G</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>G</mi><msub><mi>d</mi><mn>2</mn></msub></msub></mrow><annotation encoding="application/x-tex">G_{d_{0}}\times G_{d_{1}}\times G_{d_{2}}</annotation></semantics></math>-equivariant linear bundle embedding</p>
<table id="S5.Ex97" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex97.m1" class="ltx_Math" alttext="\widehat{\zeta}_{(d_{0},d_{1},d_{2})}^{Q}:B_{(d_{0},d_{1},d_{2})}\times{\bm{Q}}_{d_{0}}\times{\bm{Q}}_{d_{1}}\times{\bm{Q}}_{d_{2}}\to B_{(d_{0},d_{1},d_{2})}\times{\bm{Q}}_{d}," display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>ζ</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mi>Q</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>B</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝑸</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝑸</mi><msub><mi>d</mi><mn>1</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝑸</mi><msub><mi>d</mi><mn>2</mn></msub></msub></mrow><mo stretchy="false">→</mo><mrow><msub><mi>B</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝑸</mi><mi>d</mi></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\widehat{\zeta}_{(d_{0},d_{1},d_{2})}^{Q}:B_{(d_{0},d_{1},d_{2})}\times{\bm{Q}}_{d_{0}}\times{\bm{Q}}_{d_{1}}\times{\bm{Q}}_{d_{2}}\to B_{(d_{0},d_{1},d_{2})}\times{\bm{Q}}_{d},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS6.p4.2" class="ltx_p">whose image is <math id="S5.SS2.SSS6.p4.m2" class="ltx_Math" alttext="B_{(d_{0},d_{1},d_{2})}\times{\bm{Q}}_{(d_{0},d_{1},d_{2})}" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝑸</mi><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub></mrow><annotation encoding="application/x-tex">B_{(d_{0},d_{1},d_{2})}\times{\bm{Q}}_{(d_{0},d_{1},d_{2})}</annotation></semantics></math>. The associativity further implies that for any <math id="S5.SS2.SSS6.p4.m3" class="ltx_Math" alttext="\delta=(d_{0},\dots,d_{l})\in{\mathbb{A}}_{d}" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>d</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi>𝔸</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\delta=(d_{0},\dots,d_{l})\in{\mathbb{A}}_{d}</annotation></semantics></math>, there exists a <math id="S5.SS2.SSS6.p4.m4" class="ltx_Math" alttext="G_{\delta}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>δ</mi></msub><annotation encoding="application/x-tex">G_{\delta}</annotation></semantics></math>-equivariant linear bundle embedding</p>
<table id="S5.E16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E16.m1" class="ltx_math_unparsed" alttext="\widehat{\zeta}_{\delta}^{Q}:Q_{\delta}:=B_{\delta}\times{\bm{Q}}_{d_{0}}\times\cdots\times{\bm{Q}}_{d_{l}}\xrightarrow{\sim}B_{\delta}\times{\bm{Q}}_{\delta}\subset B_{\delta}\times{\bm{Q}}_{d}." display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi>ζ</mi><mo>^</mo></mover><msub><mrow></mrow><mi>δ</mi></msub><msup><mrow></mrow><mi>Q</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mi>Q</mi><msub><mrow></mrow><mi>δ</mi></msub><mo>:=</mo><mi>B</mi><msub><mrow></mrow><mi>δ</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑸</mi><msub><mrow></mrow><msub><mi>d</mi><mn>0</mn></msub></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi>𝑸</mi><msub><mrow></mrow><msub><mi>d</mi><mi>l</mi></msub></msub><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><mi>B</mi><msub><mrow></mrow><mi>δ</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑸</mi><msub><mrow></mrow><mi>δ</mi></msub><mo>⊂</mo><mi>B</mi><msub><mrow></mrow><mi>δ</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑸</mi><msub><mrow></mrow><mi>d</mi></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widehat{\zeta}_{\delta}^{Q}:Q_{\delta}:=B_{\delta}\times{\bm{Q}}_{d_{0}}\times\cdots\times{\bm{Q}}_{d_{l}}\xrightarrow{\sim}B_{\delta}\times{\bm{Q}}_{\delta}\subset B_{\delta}\times{\bm{Q}}_{d}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.16)</span></td></tr></tbody>
</table>
<p id="S5.SS2.SSS6.p4.3" class="ltx_p">Take the <math id="S5.SS2.SSS6.p4.m5" class="ltx_Math" alttext="G_{d}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>d</mi></msub><annotation encoding="application/x-tex">G_{d}</annotation></semantics></math>-equivariantization using the group embedding <math id="S5.SS2.SSS6.p4.m6" class="ltx_Math" alttext="G_{\delta}\hookrightarrow G_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mi>δ</mi></msub><mo stretchy="false">↪</mo><msub><mi>G</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">G_{\delta}\hookrightarrow G_{d}</annotation></semantics></math>, we obtain a <math id="S5.SS2.SSS6.p4.m7" class="ltx_Math" alttext="G_{d}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>d</mi></msub><annotation encoding="application/x-tex">G_{d}</annotation></semantics></math>-equivariant vector bundle</p>
<table id="S5.Ex98" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex98.m1" class="ltx_Math" alttext="Q_{\delta}^{\sim}=G_{d}\times_{G_{\delta}}Q_{\delta}\to B_{\delta}^{\sim}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>Q</mi><mi>δ</mi><mo>∼</mo></msubsup><mo>=</mo><mrow><msub><mi>G</mi><mi>d</mi></msub><msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>G</mi><mi>δ</mi></msub></msub><msub><mi>Q</mi><mi>δ</mi></msub></mrow><mo stretchy="false">→</mo><msubsup><mi>B</mi><mi>δ</mi><mo>∼</mo></msubsup></mrow><annotation encoding="application/x-tex">Q_{\delta}^{\sim}=G_{d}\times_{G_{\delta}}Q_{\delta}\to B_{\delta}^{\sim}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS6.p4.4" class="ltx_p">which is <math id="S5.SS2.SSS6.p4.m8" class="ltx_Math" alttext="G_{d}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>d</mi></msub><annotation encoding="application/x-tex">G_{d}</annotation></semantics></math>-equivariantly embedded in <math id="S5.SS2.SSS6.p4.m9" class="ltx_Math" alttext="B_{\delta}^{\sim}\times{\bm{Q}}_{d}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>B</mi><mi>δ</mi><mo>∼</mo></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝑸</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">B_{\delta}^{\sim}\times{\bm{Q}}_{d}</annotation></semantics></math>.
Combined with the gluing map (<a href="#S5.E11" title="In 5.2.5. Boundary strata of the auxiliary moduli spaces ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.11</span></a>), we obtain a <math id="S5.SS2.SSS6.p4.m10" class="ltx_Math" alttext="G_{d}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>d</mi></msub><annotation encoding="application/x-tex">G_{d}</annotation></semantics></math>-equivariant bundle embedding</p>
<table id="S5.Ex99" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex99.m1" class="ltx_Math" alttext="(\widehat{\zeta}_{\delta}^{Q})^{\sim}:Q_{\delta}^{\sim}\to Q_{d}|_{\partial^{\delta}B_{d}}" display="block" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>ζ</mi><mo>^</mo></mover><mi>δ</mi><mi>Q</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>∼</mo></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>Q</mi><mi>δ</mi><mo>∼</mo></msubsup><mo stretchy="false">→</mo><msub><mrow><msub><mi>Q</mi><mi>d</mi></msub><mo stretchy="false">|</mo></mrow><mrow><msup><mo>∂</mo><mi>δ</mi></msup><msub><mi>B</mi><mi>d</mi></msub></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">(\widehat{\zeta}_{\delta}^{Q})^{\sim}:Q_{\delta}^{\sim}\to Q_{d}|_{\partial^{\delta}B_{d}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS6.p4.5" class="ltx_p">covering the embedding <math id="S5.SS2.SSS6.p4.m11" class="ltx_Math" alttext="\zeta_{\delta}^{\sim}:B_{\delta}^{\sim}\hookrightarrow\partial^{\delta}B_{d}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ζ</mi><mi>δ</mi><mo>∼</mo></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>B</mi><mi>δ</mi><mo>∼</mo></msubsup><mo rspace="0.111em" stretchy="false">↪</mo><mrow><msup><mo>∂</mo><mi>δ</mi></msup><msub><mi>B</mi><mi>d</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\zeta_{\delta}^{\sim}:B_{\delta}^{\sim}\hookrightarrow\partial^{\delta}B_{d}</annotation></semantics></math>. Using the bundle <math id="S5.SS2.SSS6.p4.m12" class="ltx_Math" alttext="\check{Q}_{\delta}^{\sim}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>Q</mi><mo>ˇ</mo></mover><mi>δ</mi><mo>∼</mo></msubsup><annotation encoding="application/x-tex">\check{Q}_{\delta}^{\sim}</annotation></semantics></math> from (<a href="#S5.E14" title="In 5.2.5. Boundary strata of the auxiliary moduli spaces ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.14</span></a>), we can stabilize <math id="S5.SS2.SSS6.p4.m13" class="ltx_Math" alttext="\zeta_{\delta}^{\sim}" display="inline" intent=":literal"><semantics><msubsup><mi>ζ</mi><mi>δ</mi><mo>∼</mo></msubsup><annotation encoding="application/x-tex">\zeta_{\delta}^{\sim}</annotation></semantics></math> by <math id="S5.SS2.SSS6.p4.m14" class="ltx_Math" alttext="\check{Q}_{\delta}^{\sim}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>Q</mi><mo>ˇ</mo></mover><mi>δ</mi><mo>∼</mo></msubsup><annotation encoding="application/x-tex">\check{Q}_{\delta}^{\sim}</annotation></semantics></math> to get a diffeomorphism onto its image.</p>
</div>
</section>
<section id="S5.SS2.SSS7" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">5.2.7. </span>Normal complex structure</h4>

<div id="S5.SS2.SSS7.p1" class="ltx_para">
<p id="S5.SS2.SSS7.p1.1" class="ltx_p">Here we prove the following result.</p>
</div>
<div id="S5.Thmthm27" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm27.2" class="ltx_text ltx_font_bold">Proposition 5.27</span></span><span id="S5.Thmthm27.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm27.p1" class="ltx_para">
<p id="S5.Thmthm27.p1.1" class="ltx_p"><span id="S5.Thmthm27.p1.1.1" class="ltx_text ltx_font_italic">For each <math id="S5.Thmthm27.p1.m1" class="ltx_Math" alttext="d\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d\geq 1</annotation></semantics></math>, <math id="S5.Thmthm27.p1.m2" class="ltx_Math" alttext="(B_{d}\times{\bm{Q}}_{d})/G_{d}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>B</mi><mi>d</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝐐</mi><mi>d</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><msub><mi>G</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">(B_{d}\times{\bm{Q}}_{d})/G_{d}</annotation></semantics></math> is a normally complex orbifold with corners.</span></p>
</div>
</div>
<div id="S5.SS2.SSS7.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.SS2.SSS7.p2" class="ltx_para">
<p id="S5.SS2.SSS7.p2.1" class="ltx_p"><span id="S5.SS2.SSS7.p2.1.1" class="ltx_text">We first re-examine the relation between <math id="S5.SS2.SSS7.p2.m1" class="ltx_Math" alttext="B_{d}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>d</mi></msub><annotation encoding="application/x-tex">B_{d}</annotation></semantics></math> and <math id="S5.SS2.SSS7.p2.m2" class="ltx_Math" alttext="{\bm{Q}}_{d}" display="inline" intent=":literal"><semantics><msub><mi>𝑸</mi><mi>d</mi></msub><annotation encoding="application/x-tex">{\bm{Q}}_{d}</annotation></semantics></math>. Define</span></p>
<table id="S5.Ex100" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex100.m1" class="ltx_math_unparsed" alttext="{\bm{Q}}_{d}^{\prime}:=\left\{\left.A=\left[\begin{array}[]{cc}0&amp;*\\
0&amp;a\end{array}\right]\ \right|\ a^{\dagger}=a\right\}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>𝑸</mi><mi>d</mi><mo>′</mo></msubsup><mo>:=</mo><mrow><mo>{</mo><mi>A</mi><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd><mn>0</mn></mtd><mtd><mo>∗</mo></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mi>a</mi></mtd></mtr></mtable><mo rspace="0.500em">]</mo></mrow><mo fence="false" rspace="0.667em">|</mo><msup><mi>a</mi><mo>†</mo></msup><mo>=</mo><mi>a</mi><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{Q}}_{d}^{\prime}:=\left\{\left.A=\left[\begin{array}[]{cc}0&amp;*\\
0&amp;a\end{array}\right]\ \right|\ a^{\dagger}=a\right\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS7.p2.2" class="ltx_p"><span id="S5.SS2.SSS7.p2.2.1" class="ltx_text">Then one can check that <math id="S5.SS2.SSS7.p2.m3" class="ltx_Math" alttext="{\bm{Q}}_{d}^{\prime}\cong{\bm{Q}}_{d}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝑸</mi><mi>d</mi><mo>′</mo></msubsup><mo>≅</mo><msub><mi>𝑸</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">{\bm{Q}}_{d}^{\prime}\cong{\bm{Q}}_{d}</annotation></semantics></math> as <math id="S5.SS2.SSS7.p2.m4" class="ltx_Math" alttext="G_{d}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>d</mi></msub><annotation encoding="application/x-tex">G_{d}</annotation></semantics></math>-spaces where on both the <math id="S5.SS2.SSS7.p2.m5" class="ltx_Math" alttext="G_{d}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>d</mi></msub><annotation encoding="application/x-tex">G_{d}</annotation></semantics></math> action is given by the conjugation. Then we define an “action” of <math id="S5.SS2.SSS7.p2.m6" class="ltx_Math" alttext="{\bm{Q}}_{d}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑸</mi><mi>d</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\bm{Q}}_{d}^{\prime}</annotation></semantics></math> on <math id="S5.SS2.SSS7.p2.m7" class="ltx_Math" alttext="B_{d}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>d</mi></msub><annotation encoding="application/x-tex">B_{d}</annotation></semantics></math> by</span></p>
<table id="S5.Ex101" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex101.m1" class="ltx_Math" alttext="A\cdot x\mapsto(I_{d+1}+A)(x)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>A</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>x</mi></mrow><mo stretchy="false">↦</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>I</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>+</mo><mi>A</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">A\cdot x\mapsto(I_{d+1}+A)(x).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS7.p2.3" class="ltx_p"><span id="S5.SS2.SSS7.p2.3.1" class="ltx_text">It is easy to see that the <math id="S5.SS2.SSS7.p2.m8" class="ltx_Math" alttext="{\bm{Q}}_{d}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑸</mi><mi>d</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\bm{Q}}_{d}^{\prime}</annotation></semantics></math>-orbit through <math id="S5.SS2.SSS7.p2.m9" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> is a local slice of the <math id="S5.SS2.SSS7.p2.m10" class="ltx_Math" alttext="G_{d}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>d</mi></msub><annotation encoding="application/x-tex">G_{d}</annotation></semantics></math>-action. Suppose <math id="S5.SS2.SSS7.p2.m11" class="ltx_Math" alttext="\Gamma\subset G_{d}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Γ</mi><mo>⊂</mo><msub><mi>G</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\Gamma\subset G_{d}</annotation></semantics></math> is a finite subgroup and <math id="S5.SS2.SSS7.p2.m12" class="ltx_Math" alttext="x\in(B_{d})^{\Gamma}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>B</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow><mi mathvariant="normal">Γ</mi></msup></mrow><annotation encoding="application/x-tex">x\in(B_{d})^{\Gamma}</annotation></semantics></math>. Let <math id="S5.SS2.SSS7.p2.m13" class="ltx_Math" alttext="{\bm{Q}}_{d}^{\Gamma}\subset{\bm{Q}}_{d}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝑸</mi><mi>d</mi><mi mathvariant="normal">Γ</mi></msubsup><mo>⊂</mo><msub><mi>𝑸</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">{\bm{Q}}_{d}^{\Gamma}\subset{\bm{Q}}_{d}</annotation></semantics></math> be the <math id="S5.SS2.SSS7.p2.m14" class="ltx_Math" alttext="\Gamma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Γ</mi><annotation encoding="application/x-tex">\Gamma</annotation></semantics></math>-invariant subspace. Then we see that the <math id="S5.SS2.SSS7.p2.m15" class="ltx_Math" alttext="{\bm{Q}}_{d}^{\Gamma}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑸</mi><mi>d</mi><mi mathvariant="normal">Γ</mi></msubsup><annotation encoding="application/x-tex">{\bm{Q}}_{d}^{\Gamma}</annotation></semantics></math>-orbit through <math id="S5.SS2.SSS7.p2.m16" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> is contained in the <math id="S5.SS2.SSS7.p2.m17" class="ltx_Math" alttext="\Gamma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Γ</mi><annotation encoding="application/x-tex">\Gamma</annotation></semantics></math>-fixed locus. We can check that locally it coincides with the fixed locus. Hence the normal direction to to the <math id="S5.SS2.SSS7.p2.m18" class="ltx_Math" alttext="\Gamma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Γ</mi><annotation encoding="application/x-tex">\Gamma</annotation></semantics></math>-fixed locus of <math id="S5.SS2.SSS7.p2.m19" class="ltx_Math" alttext="B_{d}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>d</mi></msub><annotation encoding="application/x-tex">B_{d}</annotation></semantics></math> and the orthogonal complement of <math id="S5.SS2.SSS7.p2.m20" class="ltx_Math" alttext="{\bm{Q}}_{d}^{\Gamma}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑸</mi><mi>d</mi><mi mathvariant="normal">Γ</mi></msubsup><annotation encoding="application/x-tex">{\bm{Q}}_{d}^{\Gamma}</annotation></semantics></math> are isomorphic representations of <math id="S5.SS2.SSS7.p2.m21" class="ltx_Math" alttext="\Gamma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Γ</mi><annotation encoding="application/x-tex">\Gamma</annotation></semantics></math>. Hence one can define a natural normal complex structure on <math id="S5.SS2.SSS7.p2.m22" class="ltx_Math" alttext="(B_{d}\times{\bm{Q}}_{d})/G_{d}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>B</mi><mi>d</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝑸</mi><mi>d</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><msub><mi>G</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">(B_{d}\times{\bm{Q}}_{d})/G_{d}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="S5.SS2.SSS8" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">5.2.8. </span>Abelian gauge theory on punctured spheres</h4>

<div id="S5.SS2.SSS8.p1" class="ltx_para">
<p id="S5.SS2.SSS8.p1.1" class="ltx_p">We include certain simple facts about abelian gauge theory over the infinite cylinder.Let <math id="S5.SS2.SSS8.p1.m1" class="ltx_Math" alttext="\Theta={\mathbb{R}}\times S^{1}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Θ</mi><mo>=</mo><mrow><mi>ℝ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>S</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\Theta={\mathbb{R}}\times S^{1}</annotation></semantics></math> be the infinite cylinder, equipped with the standard flat Riemannian metric. Let <math id="S5.SS2.SSS8.p1.m2" class="ltx_Math" alttext="(s,t)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(s,t)</annotation></semantics></math> be the standard coordinates where <math id="S5.SS2.SSS8.p1.m3" class="ltx_Math" alttext="s\in{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">s\in{\mathbb{R}}</annotation></semantics></math> and <math id="S5.SS2.SSS8.p1.m4" class="ltx_Math" alttext="t\in S^{1}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><msup><mi>S</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">t\in S^{1}</annotation></semantics></math>. Consider an everywhere non-negative 2-form</p>
<table id="S5.Ex102" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex102.m1" class="ltx_Math" alttext="\Omega=\sigma(s,t)ds\wedge dt,\sigma(s,t)\geq 0" display="block" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Ω</mi><mo>=</mo><mrow><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>∧</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></mrow><mo>,</mo><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">\Omega=\sigma(s,t)ds\wedge dt,\sigma(s,t)\geq 0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS8.p1.2" class="ltx_p">which decays exponentially on the ends: there exist a positive real number <math id="S5.SS2.SSS8.p1.m5" class="ltx_Math" alttext="\delta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta&gt;0</annotation></semantics></math> and a sequence of positive real numbers <math id="S5.SS2.SSS8.p1.m6" class="ltx_Math" alttext="C_{0},C_{1},\ldots" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>0</mn></msub><mo>,</mo><msub><mi>C</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">C_{0},C_{1},\ldots</annotation></semantics></math> such that</p>
<table id="S5.E17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E17.m1" class="ltx_math_unparsed" alttext="|\nabla^{l}\sigma(s,t)|\leq C_{l}e^{-\delta|s|},\ l=0,1,\ldots." display="block" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mo rspace="0.167em">∇</mo><mi>l</mi></msup><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">≤</mo><msub><mi>C</mi><mi>l</mi></msub><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi>s</mi><mo stretchy="false">|</mo></mrow></mrow></mrow></msup><mo rspace="0.667em">,</mo><mi>l</mi><mo>=</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|\nabla^{l}\sigma(s,t)|\leq C_{l}e^{-\delta|s|},\ l=0,1,\ldots.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.17)</span></td></tr></tbody>
</table>
<p id="S5.SS2.SSS8.p1.3" class="ltx_p">We assume that</p>
<table id="S5.Ex103" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex103.m1" class="ltx_Math" alttext="\int_{\Theta}\Omega=d\in{\mathbb{Z}}_{\geq 0}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∫</mo><mi mathvariant="normal">Θ</mi></msub><mi mathvariant="normal">Ω</mi></mrow><mo>=</mo><mi>d</mi><mo>∈</mo><msub><mi>ℤ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\int_{\Theta}\Omega=d\in{\mathbb{Z}}_{\geq 0}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S5.Thmthm28" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm28.2" class="ltx_text ltx_font_bold">Lemma 5.28</span></span><span id="S5.Thmthm28.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm28.p1" class="ltx_para">
<p id="S5.Thmthm28.p1.1" class="ltx_p"><span id="S5.Thmthm28.p1.1.1" class="ltx_text ltx_font_italic">There exists a unitary connection <math id="S5.Thmthm28.p1.m1" class="ltx_Math" alttext="A=A_{\Omega}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>=</mo><msub><mi>A</mi><mi mathvariant="normal">Ω</mi></msub></mrow><annotation encoding="application/x-tex">A=A_{\Omega}</annotation></semantics></math> on the trivial line bundle <math id="S5.Thmthm28.p1.m2" class="ltx_Math" alttext="L=\Theta\times{\mathbb{C}}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>ℂ</mi></mrow></mrow><annotation encoding="application/x-tex">L=\Theta\times{\mathbb{C}}</annotation></semantics></math>, unique up to gauge transformation, which satisfies the following conditions:</span></p>
<ol id="S5.I15" class="ltx_enumerate">
<li id="S5.I15.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S5.I15.i1.p1" class="ltx_para">
<p id="S5.I15.i1.p1.1" class="ltx_p"><span id="S5.I15.i1.p1.1.1" class="ltx_text ltx_font_italic">The curvature form of </span><math id="S5.I15.i1.p1.m1" class="ltx_Math" alttext="A_{\Omega}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi mathvariant="normal">Ω</mi></msub><annotation encoding="application/x-tex">A_{\Omega}</annotation></semantics></math><span id="S5.I15.i1.p1.1.2" class="ltx_text ltx_font_italic"> is equal to </span><math id="S5.I15.i1.p1.m2" class="ltx_Math" alttext="-2\pi{\bm{i}}\Omega" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒊</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Ω</mi></mrow></mrow><annotation encoding="application/x-tex">-2\pi{\bm{i}}\Omega</annotation></semantics></math><span id="S5.I15.i1.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S5.I15.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S5.I15.i2.p1" class="ltx_para">
<p id="S5.I15.i2.p1.1" class="ltx_p"><span id="S5.I15.i2.p1.1.1" class="ltx_text ltx_font_italic">The holonomy of </span><math id="S5.I15.i2.p1.m1" class="ltx_Math" alttext="A_{\Omega}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi mathvariant="normal">Ω</mi></msub><annotation encoding="application/x-tex">A_{\Omega}</annotation></semantics></math><span id="S5.I15.i2.p1.1.2" class="ltx_text ltx_font_italic"> along any circle </span><math id="S5.I15.i2.p1.m2" class="ltx_Math" alttext="\{s\}\times S^{1}\subset\Theta" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">{</mo><mi>s</mi><mo rspace="0.055em" stretchy="false">}</mo></mrow><mo rspace="0.222em">×</mo><msup><mi>S</mi><mn>1</mn></msup></mrow><mo>⊂</mo><mi mathvariant="normal">Θ</mi></mrow><annotation encoding="application/x-tex">\{s\}\times S^{1}\subset\Theta</annotation></semantics></math><span id="S5.I15.i2.p1.1.3" class="ltx_text ltx_font_italic">, which is a well-defined element in </span><math id="S5.I15.i2.p1.m3" class="ltx_Math" alttext="U(1)" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">U(1)</annotation></semantics></math><span id="S5.I15.i2.p1.1.4" class="ltx_text ltx_font_italic">, converges to the identity as </span><math id="S5.I15.i2.p1.m4" class="ltx_Math" alttext="s\to\pm\infty" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo stretchy="false">→</mo><mrow><mo>±</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">s\to\pm\infty</annotation></semantics></math><span id="S5.I15.i2.p1.1.5" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S5.SS2.SSS8.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.SS2.SSS8.p2" class="ltx_para">
<p id="S5.SS2.SSS8.p2.1" class="ltx_p"><span id="S5.SS2.SSS8.p2.1.1" class="ltx_text">Choose two integers <math id="S5.SS2.SSS8.p2.m1" class="ltx_Math" alttext="m_{-}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mo>−</mo></msub><annotation encoding="application/x-tex">m_{-}</annotation></semantics></math> and <math id="S5.SS2.SSS8.p2.m2" class="ltx_Math" alttext="m_{+}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mo>+</mo></msub><annotation encoding="application/x-tex">m_{+}</annotation></semantics></math> such that <math id="S5.SS2.SSS8.p2.m3" class="ltx_Math" alttext="d=m_{-}-m_{+}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mrow><msub><mi>m</mi><mo>−</mo></msub><mo>−</mo><msub><mi>m</mi><mo>+</mo></msub></mrow></mrow><annotation encoding="application/x-tex">d=m_{-}-m_{+}</annotation></semantics></math>. Choose a reference smooth connection <math id="S5.SS2.SSS8.p2.m4" class="ltx_Math" alttext="A_{0}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mn>0</mn></msub><annotation encoding="application/x-tex">A_{0}</annotation></semantics></math> which is equal to <math id="S5.SS2.SSS8.p2.m5" class="ltx_Math" alttext="d-{\bm{i}}m_{\pm}dt" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>−</mo><mrow><mi>𝒊</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mo>±</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><annotation encoding="application/x-tex">d-{\bm{i}}m_{\pm}dt</annotation></semantics></math> near <math id="S5.SS2.SSS8.p2.m6" class="ltx_Math" alttext="\pm\infty" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\pm\infty</annotation></semantics></math>. Consider an arbitrary connection of the form</span></p>
<table id="S5.Ex104" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex104.m1" class="ltx_Math" alttext="A=A_{0}+\phi ds+\psi dt." display="block" intent=":literal"><semantics><mrow><mrow><mi>A</mi><mo>=</mo><mrow><msub><mi>A</mi><mn>0</mn></msub><mo>+</mo><mrow><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>+</mo><mrow><mi>ψ</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">A=A_{0}+\phi ds+\psi dt.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS8.p2.2" class="ltx_p"><span id="S5.SS2.SSS8.p2.2.1" class="ltx_text">Then the curvature condition <math id="S5.SS2.SSS8.p2.m7" class="ltx_Math" alttext="F_{A}=-2\pi{\bm{i}}\Omega" display="inline" intent=":literal"><semantics><mrow><msub><mi>F</mi><mi>A</mi></msub><mo>=</mo><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒊</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Ω</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">F_{A}=-2\pi{\bm{i}}\Omega</annotation></semantics></math> and a gauge fixing condition induced by the trivial product connection give the equations</span></p>
<table id="S5.E18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E18.m1" class="ltx_Math" alttext="\left\{\begin{array}[]{rl}\displaystyle\frac{\partial\psi}{\partial s}-\frac{\partial\phi}{\partial t}&amp;=*(-2\pi{\bm{i}}\Omega-F_{A_{0}}),\\[5.69046pt]
\displaystyle\frac{\partial\phi}{\partial s}+\frac{\partial\psi}{\partial t}&amp;=0.\end{array}\right." display="block" intent=":literal"><semantics><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mfrac><mrow><mo>∂</mo><mi>ψ</mi></mrow><mrow><mo>∂</mo><mi>s</mi></mrow></mfrac><mo>−</mo><mfrac><mrow><mo>∂</mo><mi>ϕ</mi></mrow><mrow><mo>∂</mo><mi>t</mi></mrow></mfrac></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo rspace="0em">=</mo><mo lspace="0em" rspace="0.222em">∗</mo><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mn>2</mn><mi>π</mi><mi>𝒊</mi><mi mathvariant="normal">Ω</mi><mo>−</mo><mi>F</mi><msub><mrow></mrow><msub><mi>A</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mfrac><mrow><mo>∂</mo><mi>ϕ</mi></mrow><mrow><mo>∂</mo><mi>s</mi></mrow></mfrac><mo>+</mo><mfrac><mrow><mo>∂</mo><mi>ψ</mi></mrow><mrow><mo>∂</mo><mi>t</mi></mrow></mfrac></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\left\{\begin{array}[]{rl}\displaystyle\frac{\partial\psi}{\partial s}-\frac{\partial\phi}{\partial t}&amp;=*(-2\pi{\bm{i}}\Omega-F_{A_{0}}),\\[5.69046pt]
\displaystyle\frac{\partial\phi}{\partial s}+\frac{\partial\psi}{\partial t}&amp;=0.\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.18)</span></td></tr></tbody>
</table>
<p id="S5.SS2.SSS8.p2.3" class="ltx_p"><span id="S5.SS2.SSS8.p2.3.1" class="ltx_text">The left-hand-side is indeed the standard Cauchy–Riemann operator on <math id="S5.SS2.SSS8.p2.m8" class="ltx_Math" alttext="f=\phi+{\bm{i}}\psi" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><mrow><mi>ϕ</mi><mo>+</mo><mrow><mi>𝒊</mi><mo lspace="0em" rspace="0em">​</mo><mi>ψ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">f=\phi+{\bm{i}}\psi</annotation></semantics></math>. Introduce a small <math id="S5.SS2.SSS8.p2.m9" class="ltx_Math" alttext="\epsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon&gt;0</annotation></semantics></math>. Then the operator</span></p>
<table id="S5.Ex105" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex105.m1" class="ltx_Math" alttext="\frac{\partial}{\partial\overline{z}}:W^{1,p,\epsilon}(\Theta)\otimes{\mathbb{C}}\to L^{p,\epsilon}(\Theta)\otimes{\mathbb{C}}" display="block" intent=":literal"><semantics><mrow><mfrac><mo>∂</mo><mrow><mo>∂</mo><mover accent="true"><mi>z</mi><mo stretchy="true">¯</mo></mover></mrow></mfrac><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><msup><mi>W</mi><mrow><mn>1</mn><mo>,</mo><mi>p</mi><mo>,</mo><mi>ϵ</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>ℂ</mi></mrow><mo stretchy="false">→</mo><mrow><mrow><msup><mi>L</mi><mrow><mi>p</mi><mo>,</mo><mi>ϵ</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mi>ℂ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{\partial}{\partial\overline{z}}:W^{1,p,\epsilon}(\Theta)\otimes{\mathbb{C}}\to L^{p,\epsilon}(\Theta)\otimes{\mathbb{C}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS8.p2.4" class="ltx_p"><span id="S5.SS2.SSS8.p2.4.1" class="ltx_text">is a Fredholm operator with index <math id="S5.SS2.SSS8.p2.m10" class="ltx_Math" alttext="-1" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">-1</annotation></semantics></math> with trivial kernel and 1-dimensional cokernel spanned by a function with nonzero total integral. By the exponential decay property of <math id="S5.SS2.SSS8.p2.m11" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math> (see (<a href="#S5.E17" title="In 5.2.8. Abelian gauge theory on punctured spheres ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.17</span></a>)), when <math id="S5.SS2.SSS8.p2.m12" class="ltx_Math" alttext="\epsilon&lt;\delta" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&lt;</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">\epsilon&lt;\delta</annotation></semantics></math>, the right hand side of (<a href="#S5.E18" title="In Proof. ‣ 5.2.8. Abelian gauge theory on punctured spheres ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.18</span></a>) belongs to <math id="S5.SS2.SSS8.p2.m13" class="ltx_Math" alttext="L^{p,\epsilon}" display="inline" intent=":literal"><semantics><msup><mi>L</mi><mrow><mi>p</mi><mo>,</mo><mi>ϵ</mi></mrow></msup><annotation encoding="application/x-tex">L^{p,\epsilon}</annotation></semantics></math>. The choice of the reference connection <math id="S5.SS2.SSS8.p2.m14" class="ltx_Math" alttext="A_{0}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mn>0</mn></msub><annotation encoding="application/x-tex">A_{0}</annotation></semantics></math> implies that the right hand side of (<a href="#S5.E18" title="In Proof. ‣ 5.2.8. Abelian gauge theory on punctured spheres ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.18</span></a>) is in the image of the Cauchy–Riemann operator. Therefore there exists a unique solution <math id="S5.SS2.SSS8.p2.m15" class="ltx_Math" alttext="f=\phi+{\bm{i}}\psi" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><mrow><mi>ϕ</mi><mo>+</mo><mrow><mi>𝒊</mi><mo lspace="0em" rspace="0em">​</mo><mi>ψ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">f=\phi+{\bm{i}}\psi</annotation></semantics></math> of class <math id="S5.SS2.SSS8.p2.m16" class="ltx_Math" alttext="W^{1,p,\epsilon}" display="inline" intent=":literal"><semantics><msup><mi>W</mi><mrow><mn>1</mn><mo>,</mo><mi>p</mi><mo>,</mo><mi>ϵ</mi></mrow></msup><annotation encoding="application/x-tex">W^{1,p,\epsilon}</annotation></semantics></math> to (<a href="#S5.E18" title="In Proof. ‣ 5.2.8. Abelian gauge theory on punctured spheres ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.18</span></a>). Hence the existence is proved.</span></p>
</div>
<div id="S5.SS2.SSS8.p3" class="ltx_para">
<p id="S5.SS2.SSS8.p3.1" class="ltx_p"><span id="S5.SS2.SSS8.p3.1.1" class="ltx_text">For uniqueness, one can see that any other solution <math id="S5.SS2.SSS8.p3.m1" class="ltx_Math" alttext="A^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>A</mi><mo>′</mo></msup><annotation encoding="application/x-tex">A^{\prime}</annotation></semantics></math> differs from <math id="S5.SS2.SSS8.p3.m2" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> by a closed 1-form. Up to gauge transformation, we can assume that the 1-form is <math id="S5.SS2.SSS8.p3.m3" class="ltx_Math" alttext="adt" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">adt</annotation></semantics></math> for a constant <math id="S5.SS2.SSS8.p3.m4" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math>. Then the holonomy condition forces that <math id="S5.SS2.SSS8.p3.m5" class="ltx_Math" alttext="a\in{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">a\in{\mathbb{Z}}</annotation></semantics></math>, which is given by the effect of a gauge transformation.
∎</span></p>
</div>
</div>
<div id="S5.SS2.SSS8.p4" class="ltx_para">
<p id="S5.SS2.SSS8.p4.1" class="ltx_p">Now we would like to realize <math id="S5.SS2.SSS8.p4.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> as certain singular connection on a degree <math id="S5.SS2.SSS8.p4.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> holomorphic line bundle over <math id="S5.SS2.SSS8.p4.m3" class="ltx_Math" alttext="\mathbb{CP}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">\mathbb{CP}^{1}</annotation></semantics></math>. To this end, let <math id="S5.SS2.SSS8.p4.m4" class="ltx_Math" alttext="L_{d}\to\mathbb{CP}^{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>d</mi></msub><mo stretchy="false">→</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">L_{d}\to\mathbb{CP}^{1}</annotation></semantics></math> be a degree <math id="S5.SS2.SSS8.p4.m5" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> holomorphic line bundle equipped with a Hermitian metric and let <math id="S5.SS2.SSS8.p4.m6" class="ltx_Math" alttext="A_{d}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>d</mi></msub><annotation encoding="application/x-tex">A_{d}</annotation></semantics></math> be the Chern connection. Choosing <math id="S5.SS2.SSS8.p4.m7" class="ltx_Math" alttext="A_{0}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mn>0</mn></msub><annotation encoding="application/x-tex">A_{0}</annotation></semantics></math> to be the same reference connection as in the proof of Lemma <a href="#S5.Thmthm28" title="Lemma 5.28. ‣ 5.2.8. Abelian gauge theory on punctured spheres ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.28</span></a>, then over <math id="S5.SS2.SSS8.p4.m8" class="ltx_Math" alttext="\Theta=\mathbb{CP}^{1}\setminus\{\pm\infty\}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Θ</mi><mo>=</mo><mrow><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow><mo>∖</mo><mrow><mo stretchy="false">{</mo><mrow><mo>±</mo><mi mathvariant="normal">∞</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Theta=\mathbb{CP}^{1}\setminus\{\pm\infty\}</annotation></semantics></math> there exists a trivialization of <math id="S5.SS2.SSS8.p4.m9" class="ltx_Math" alttext="L_{d}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>d</mi></msub><annotation encoding="application/x-tex">L_{d}</annotation></semantics></math> such that</p>
<table id="S5.Ex106" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex106.m1" class="ltx_Math" alttext="A_{d}=A_{0}+\phi_{d}ds+\psi_{d}dt" display="block" intent=":literal"><semantics><mrow><msub><mi>A</mi><mi>d</mi></msub><mo>=</mo><mrow><msub><mi>A</mi><mn>0</mn></msub><mo>+</mo><mrow><msub><mi>ϕ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>+</mo><mrow><msub><mi>ψ</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">A_{d}=A_{0}+\phi_{d}ds+\psi_{d}dt</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS8.p4.2" class="ltx_p">such that <math id="S5.SS2.SSS8.p4.m10" class="ltx_Math" alttext="\phi_{d}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mi>d</mi></msub><annotation encoding="application/x-tex">\phi_{d}</annotation></semantics></math>, <math id="S5.SS2.SSS8.p4.m11" class="ltx_Math" alttext="\psi_{d}" display="inline" intent=":literal"><semantics><msub><mi>ψ</mi><mi>d</mi></msub><annotation encoding="application/x-tex">\psi_{d}</annotation></semantics></math>, and all of their derivatives converge exponentially to <math id="S5.SS2.SSS8.p4.m12" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> as <math id="S5.SS2.SSS8.p4.m13" class="ltx_Math" alttext="s\to\pm\infty" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo stretchy="false">→</mo><mrow><mo>±</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">s\to\pm\infty</annotation></semantics></math>. Moreover, the difference of curvature <math id="S5.SS2.SSS8.p4.m14" class="ltx_Math" alttext="\Omega_{A_{d}}-\Omega_{A}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Ω</mi><msub><mi>A</mi><mi>d</mi></msub></msub><mo>−</mo><msub><mi mathvariant="normal">Ω</mi><mi>A</mi></msub></mrow><annotation encoding="application/x-tex">\Omega_{A_{d}}-\Omega_{A}</annotation></semantics></math>, measured in cylindrical metric, decays exponentially like <math id="S5.SS2.SSS8.p4.m15" class="ltx_Math" alttext="e^{-\delta|s|}" display="inline" intent=":literal"><semantics><msup><mi>e</mi><mrow><mo>−</mo><mrow><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi>s</mi><mo stretchy="false">|</mo></mrow></mrow></mrow></msup><annotation encoding="application/x-tex">e^{-\delta|s|}</annotation></semantics></math> with all derivatives. Then consider a general complex gauge transformation <math id="S5.SS2.SSS8.p4.m16" class="ltx_Math" alttext="g=e^{h}=e^{h^{\prime}+{\bm{i}}h^{\prime\prime}}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>=</mo><msup><mi>e</mi><mi>h</mi></msup><mo>=</mo><msup><mi>e</mi><mrow><msup><mi>h</mi><mo>′</mo></msup><mo>+</mo><mrow><mi>𝒊</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>h</mi><mo>′′</mo></msup></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">g=e^{h}=e^{h^{\prime}+{\bm{i}}h^{\prime\prime}}</annotation></semantics></math> where <math id="S5.SS2.SSS8.p4.m17" class="ltx_Math" alttext="h^{\prime},h^{\prime\prime}:\Theta\to{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>h</mi><mo>′</mo></msup><mo>,</mo><mrow><msup><mi>h</mi><mo>′′</mo></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Θ</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">h^{\prime},h^{\prime\prime}:\Theta\to{\mathbb{R}}</annotation></semantics></math> are functions. Consider the equation <math id="S5.SS2.SSS8.p4.m18" class="ltx_Math" alttext="(e^{h})^{*}A_{d}=A" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><msup><mi>e</mi><mi>h</mi></msup><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>d</mi></msub></mrow><mo>=</mo><mi>A</mi></mrow><annotation encoding="application/x-tex">(e^{h})^{*}A_{d}=A</annotation></semantics></math> which is equivalent to</p>
<table id="S5.Ex107" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex107.m1" class="ltx_Math" alttext="{\bm{i}}dh^{\prime\prime}+{\bm{i}}*dh^{\prime}=A_{d}-A" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝒊</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>h</mi><mo>′′</mo></msup></mrow><mo>+</mo><mrow><mrow><mi>𝒊</mi><mo lspace="0.222em" rspace="0.222em">∗</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>h</mi><mo>′</mo></msup></mrow></mrow><mo>=</mo><mrow><msub><mi>A</mi><mi>d</mi></msub><mo>−</mo><mi>A</mi></mrow></mrow><annotation encoding="application/x-tex">{\bm{i}}dh^{\prime\prime}+{\bm{i}}*dh^{\prime}=A_{d}-A</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.SSS8.p4.3" class="ltx_p">which is equivalent to</p>
<table id="S5.E19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E19.m1" class="ltx_Math" alttext="\left\{\begin{array}[]{cc}\displaystyle{\bm{i}}\left(\frac{\partial h^{\prime\prime}}{\partial s}-\frac{\partial h^{\prime}}{\partial t}\right)&amp;=\phi_{d}-\phi,\\
\displaystyle{\bm{i}}\left(\frac{\partial h^{\prime}}{\partial s}+\frac{\partial h^{\prime\prime}}{\partial t}\right)&amp;=\psi_{d}-\psi.\end{array}\right." display="block" intent=":literal"><semantics><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd><mrow><mi>𝒊</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mrow><mo>∂</mo><msup><mi>h</mi><mo>′′</mo></msup></mrow><mrow><mo>∂</mo><mi>s</mi></mrow></mfrac><mo>−</mo><mfrac><mrow><mo>∂</mo><msup><mi>h</mi><mo>′</mo></msup></mrow><mrow><mo>∂</mo><mi>t</mi></mrow></mfrac></mrow><mo>)</mo></mrow></mrow></mtd><mtd><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>ϕ</mi><mi>d</mi></msub><mo>−</mo><mi>ϕ</mi></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd><mrow><mi>𝒊</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mrow><mo>∂</mo><msup><mi>h</mi><mo>′</mo></msup></mrow><mrow><mo>∂</mo><mi>s</mi></mrow></mfrac><mo>+</mo><mfrac><mrow><mo>∂</mo><msup><mi>h</mi><mo>′′</mo></msup></mrow><mrow><mo>∂</mo><mi>t</mi></mrow></mfrac></mrow><mo>)</mo></mrow></mrow></mtd><mtd><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>ψ</mi><mi>d</mi></msub><mo>−</mo><mi>ψ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\left\{\begin{array}[]{cc}\displaystyle{\bm{i}}\left(\frac{\partial h^{\prime\prime}}{\partial s}-\frac{\partial h^{\prime}}{\partial t}\right)&amp;=\phi_{d}-\phi,\\
\displaystyle{\bm{i}}\left(\frac{\partial h^{\prime}}{\partial s}+\frac{\partial h^{\prime\prime}}{\partial t}\right)&amp;=\psi_{d}-\psi.\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.19)</span></td></tr></tbody>
</table>
<p id="S5.SS2.SSS8.p4.4" class="ltx_p">This is again the standard Cauchy–Riemann operator on cylinder. If we regard the left-hand-side as a Fredholm operator from <math id="S5.SS2.SSS8.p4.m19" class="ltx_Math" alttext="W^{1,p,\epsilon}" display="inline" intent=":literal"><semantics><msup><mi>W</mi><mrow><mn>1</mn><mo>,</mo><mi>p</mi><mo>,</mo><mi>ϵ</mi></mrow></msup><annotation encoding="application/x-tex">W^{1,p,\epsilon}</annotation></semantics></math> to <math id="S5.SS2.SSS8.p4.m20" class="ltx_Math" alttext="L^{p,\epsilon}" display="inline" intent=":literal"><semantics><msup><mi>L</mi><mrow><mi>p</mi><mo>,</mo><mi>ϵ</mi></mrow></msup><annotation encoding="application/x-tex">L^{p,\epsilon}</annotation></semantics></math>, then it has (complex) index <math id="S5.SS2.SSS8.p4.m21" class="ltx_Math" alttext="-1" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">-1</annotation></semantics></math> with the cokernel generated by a function whose total integral is nonzero. Now we allow <math id="S5.SS2.SSS8.p4.m22" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> to have nonzero limits at <math id="S5.SS2.SSS8.p4.m23" class="ltx_Math" alttext="\pm\infty" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\pm\infty</annotation></semantics></math> so that <math id="S5.SS2.SSS8.p4.m24" class="ltx_Math" alttext="h-h(\pm\infty)" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>−</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>±</mo><mi mathvariant="normal">∞</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">h-h(\pm\infty)</annotation></semantics></math> is of class <math id="S5.SS2.SSS8.p4.m25" class="ltx_Math" alttext="W^{1,p,\epsilon}" display="inline" intent=":literal"><semantics><msup><mi>W</mi><mrow><mn>1</mn><mo>,</mo><mi>p</mi><mo>,</mo><mi>ϵ</mi></mrow></msup><annotation encoding="application/x-tex">W^{1,p,\epsilon}</annotation></semantics></math> near the infinities. Then the Fredholm index becomes <math id="S5.SS2.SSS8.p4.m26" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> with kernel being the subspace of constant functions. Therefore, there exists a solution to (<a href="#S5.E19" title="In 5.2.8. Abelian gauge theory on punctured spheres ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.19</span></a>) unique up to adding a constant. We may then view <math id="S5.SS2.SSS8.p4.m27" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> as the Chern connection on <math id="S5.SS2.SSS8.p4.m28" class="ltx_Math" alttext="L_{d}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>d</mi></msub><annotation encoding="application/x-tex">L_{d}</annotation></semantics></math> with respect to the Hermitian metric rescaled by <math id="S5.SS2.SSS8.p4.m29" class="ltx_Math" alttext="e^{2h^{\prime}}" display="inline" intent=":literal"><semantics><msup><mi>e</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>h</mi><mo>′</mo></msup></mrow></msup><annotation encoding="application/x-tex">e^{2h^{\prime}}</annotation></semantics></math>, which may be a singular metric on <math id="S5.SS2.SSS8.p4.m30" class="ltx_Math" alttext="\mathbb{CP}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">\mathbb{CP}^{1}</annotation></semantics></math> but is smooth over the cylinder and continuous over the poles. We summarize these elementary discussions as the following lemma.</p>
</div>
<div id="S5.Thmthm29" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm29.2" class="ltx_text ltx_font_bold">Lemma 5.29</span></span><span id="S5.Thmthm29.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm29.p1" class="ltx_para">
<p id="S5.Thmthm29.p1.1" class="ltx_p"><span id="S5.Thmthm29.p1.1.1" class="ltx_text ltx_font_italic">Given a 2-form <math id="S5.Thmthm29.p1.m1" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math> as in Lemma <a href="#S5.Thmthm28" title="Lemma 5.28. ‣ 5.2.8. Abelian gauge theory on punctured spheres ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.28</span></a>, there exists a continuous Hermitian metric on <math id="S5.Thmthm29.p1.m2" class="ltx_Math" alttext="L_{d}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>d</mi></msub><annotation encoding="application/x-tex">L_{d}</annotation></semantics></math> whose Chern connection has curvature form equal to <math id="S5.Thmthm29.p1.m3" class="ltx_Math" alttext="-2\pi{\bm{i}}\Omega" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐢</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Ω</mi></mrow></mrow><annotation encoding="application/x-tex">-2\pi{\bm{i}}\Omega</annotation></semantics></math>. Moreover two such Hermitian metrics differ by a constant.</span></p>
</div>
</div>
<div id="S5.SS2.SSS8.p5" class="ltx_para">
<p id="S5.SS2.SSS8.p5.1" class="ltx_p">We generalize the above lemma to the case of prestable cylinders. On a nodal curve, a smooth/holomorphic function or map means a continuous function or map whose pullback to the normalization is smooth/holomorphic. A smooth/holomorphic <math id="S5.SS2.SSS8.p5.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-form (with <math id="S5.SS2.SSS8.p5.m2" class="ltx_Math" alttext="k\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k\geq 1</annotation></semantics></math>) means a collection of smooth/holomorphic <math id="S5.SS2.SSS8.p5.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-forms on its normalization. Then given a genus zero nodal curve <math id="S5.SS2.SSS8.p5.m4" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> with irreducible components <math id="S5.SS2.SSS8.p5.m5" class="ltx_Math" alttext="\Sigma_{1},\ldots,\Sigma_{s}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi mathvariant="normal">Σ</mi><mi>s</mi></msub></mrow><annotation encoding="application/x-tex">\Sigma_{1},\ldots,\Sigma_{s}</annotation></semantics></math> and integers <math id="S5.SS2.SSS8.p5.m6" class="ltx_Math" alttext="d_{1},\ldots,d_{s}" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>d</mi><mi>s</mi></msub></mrow><annotation encoding="application/x-tex">d_{1},\ldots,d_{s}</annotation></semantics></math>, there exists a unique up to isomorphism smooth/holomorphic line bundle over <math id="S5.SS2.SSS8.p5.m7" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> whose restriction to <math id="S5.SS2.SSS8.p5.m8" class="ltx_Math" alttext="\Sigma_{i}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\Sigma_{i}</annotation></semantics></math> has degree <math id="S5.SS2.SSS8.p5.m9" class="ltx_Math" alttext="d_{i}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi>i</mi></msub><annotation encoding="application/x-tex">d_{i}</annotation></semantics></math>. Moreover, the automorphism group of such a holomorphic line bundle is isomorphic to <math id="S5.SS2.SSS8.p5.m10" class="ltx_Math" alttext="{\mathbb{C}}^{*}" display="inline" intent=":literal"><semantics><msup><mi>ℂ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">{\mathbb{C}}^{*}</annotation></semantics></math>. Then Lemma <a href="#S5.Thmthm29" title="Lemma 5.29. ‣ 5.2.8. Abelian gauge theory on punctured spheres ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.29</span></a> has the following corollary.</p>
</div>
<div id="S5.Thmthm30" class="ltx_theorem ltx_theorem_cor">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm30.2" class="ltx_text ltx_font_bold">Corollary 5.30</span></span><span id="S5.Thmthm30.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm30.p1" class="ltx_para">
<p id="S5.Thmthm30.p1.1" class="ltx_p"><span id="S5.Thmthm30.p1.1.1" class="ltx_text ltx_font_italic">(cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>, Lemma 6.8]</cite>)
Let <math id="S5.Thmthm30.p1.m1" class="ltx_Math" alttext="(\Sigma,{\bf L})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>𝐋</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Sigma,{\bf L})</annotation></semantics></math> be a prestable cylinder and <math id="S5.Thmthm30.p1.m2" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math> be a smooth 2-form on <math id="S5.Thmthm30.p1.m3" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math>. Suppose</span></p>
<ol id="S5.I16" class="ltx_enumerate">
<li id="S5.I16.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S5.I16.i1.p1" class="ltx_para">
<p id="S5.I16.i1.p1.1" class="ltx_p"><span id="S5.I16.i1.p1.1.1" class="ltx_text ltx_font_italic">the integration of </span><math id="S5.I16.i1.p1.m1" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math><span id="S5.I16.i1.p1.1.2" class="ltx_text ltx_font_italic"> over each irreducible component is integral, and</span></p>
</div></li>
<li id="S5.I16.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S5.I16.i2.p1" class="ltx_para">
<p id="S5.I16.i2.p1.1" class="ltx_p"><span id="S5.I16.i2.p1.1.1" class="ltx_text ltx_font_italic">over cylindrical components, </span><math id="S5.I16.i2.p1.m1" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math><span id="S5.I16.i2.p1.1.2" class="ltx_text ltx_font_italic"> satisfies (</span><a href="#S5.E17" title="In 5.2.8. Abelian gauge theory on punctured spheres ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">5.17</span></a><span id="S5.I16.i2.p1.1.3" class="ltx_text ltx_font_italic">) for some common </span><math id="S5.I16.i2.p1.m2" class="ltx_Math" alttext="\delta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta&gt;0</annotation></semantics></math><span id="S5.I16.i2.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
<p id="S5.Thmthm30.p1.2" class="ltx_p"><span id="S5.Thmthm30.p1.2.1" class="ltx_text ltx_font_italic">Then there exists a holomorphic Hermitian line bundle on <math id="S5.Thmthm30.p1.m4" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> whose curvature form is <math id="S5.Thmthm30.p1.m5" class="ltx_Math" alttext="-2\pi{\bm{i}}\Omega" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐢</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Ω</mi></mrow></mrow><annotation encoding="application/x-tex">-2\pi{\bm{i}}\Omega</annotation></semantics></math>. Moreover, this line bundle is unique up to isomorphism.</span></p>
</div>
</div>
<div id="S5.SS2.SSS8.p6" class="ltx_para">
<p id="S5.SS2.SSS8.p6.1" class="ltx_p">Under Hypothesis <a href="#S4.Thmthm1" title="Hypothesis 4.1. ‣ 4. Proof of the integral Arnold conjecture ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>, suppose <math id="S5.SS2.SSS8.p6.m1" class="ltx_Math" alttext="u:\Sigma\to X" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">u:\Sigma\to X</annotation></semantics></math> is a smooth map whose restriction to each cylindrical component converges to a periodic orbit of <math id="S5.SS2.SSS8.p6.m2" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> at <math id="S5.SS2.SSS8.p6.m3" class="ltx_Math" alttext="\pm\infty" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\pm\infty</annotation></semantics></math> in an exponential rate. Then consider the 2-form <math id="S5.SS2.SSS8.p6.m4" class="ltx_Math" alttext="\Omega_{u,H}\in\Omega^{2}(\Sigma)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Ω</mi><mrow><mi>u</mi><mo>,</mo><mi>H</mi></mrow></msub><mo>∈</mo><mrow><msup><mi mathvariant="normal">Ω</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Omega_{u,H}\in\Omega^{2}(\Sigma)</annotation></semantics></math> defined as follows:</p>
</div>
<div id="S5.SS2.SSS8.p7" class="ltx_para">
<table id="S5.E20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E20.m1" class="ltx_Math" alttext="\Omega_{u,H}:=\left\{\begin{array}[]{lr}\displaystyle u^{*}\omega&amp;\text{ on spherical components}\\
\displaystyle u^{*}\omega-d(H_{t}(u)dt)&amp;\text{ on cylindrical components.}\end{array}\right." display="block" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Ω</mi><mrow><mi>u</mi><mo>,</mo><mi>H</mi></mrow></msub><mo>:=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow></mtd><mtd class="ltx_align_right" columnalign="right"><mtext> on spherical components</mtext></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow><mo>−</mo><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>H</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_right" columnalign="right"><mtext> on cylindrical components.</mtext></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">\Omega_{u,H}:=\left\{\begin{array}[]{lr}\displaystyle u^{*}\omega&amp;\text{ on spherical components}\\
\displaystyle u^{*}\omega-d(H_{t}(u)dt)&amp;\text{ on cylindrical components.}\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.20)</span></td></tr></tbody>
</table>
<p id="S5.SS2.SSS8.p7.1" class="ltx_p">Then by Corollary <a href="#S5.Thmthm30" title="Corollary 5.30. ‣ 5.2.8. Abelian gauge theory on punctured spheres ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.30</span></a> there is a unique Hermitian line bundle <math id="S5.SS2.SSS8.p7.m1" class="ltx_Math" alttext="L_{u}\to\Sigma" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>u</mi></msub><mo stretchy="false">→</mo><mi mathvariant="normal">Σ</mi></mrow><annotation encoding="application/x-tex">L_{u}\to\Sigma</annotation></semantics></math> if the integration of the <math id="S5.SS2.SSS8.p7.m2" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-form <math id="S5.SS2.SSS8.p7.m3" class="ltx_Math" alttext="\Omega_{u,H}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ω</mi><mrow><mi>u</mi><mo>,</mo><mi>H</mi></mrow></msub><annotation encoding="application/x-tex">\Omega_{u,H}</annotation></semantics></math> is integral over each cylindrical component. In particular, each stable Floer trajectory induces a line bundle over its domain, thanks to Hypothesis <a href="#S4.Thmthm1" title="Hypothesis 4.1. ‣ 4. Proof of the integral Arnold conjecture ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>. The desired integrality property of <math id="S5.SS2.SSS8.p7.m4" class="ltx_Math" alttext="\Omega_{u,H}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ω</mi><mrow><mi>u</mi><mo>,</mo><mi>H</mi></mrow></msub><annotation encoding="application/x-tex">\Omega_{u,H}</annotation></semantics></math> for stable Floer trajectories follows from the Stokes’ formula and the integrality of symplectic actions. Moreover, the Hermitian line bundle <math id="S5.SS2.SSS8.p7.m5" class="ltx_Math" alttext="L_{u}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>u</mi></msub><annotation encoding="application/x-tex">L_{u}</annotation></semantics></math> has strictly positive curvature <math id="S5.SS2.SSS8.p7.m6" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-forms over the nontrivial components of <math id="S5.SS2.SSS8.p7.m7" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math>.</p>
</div>
</section>
</section>
<section id="S5.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.3. </span>Global chart construction II</h3>

<div id="S5.SS3.p1" class="ltx_para">
<p id="S5.SS3.p1.1" class="ltx_p">In this subsection, we provide a construction of a global Kuranishi chart for a single moduli space of Floer trajectories. The purpose is to showcase how to use the auxiliary moduli space <math id="S5.SS3.p1.m1" class="ltx_Math" alttext="B_{pq}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">B_{pq}</annotation></semantics></math> as a model for the Deligne–Mumford space in the Hamiltonian Floer theory which allows one to present the moduli space <math id="S5.SS3.p1.m2" class="ltx_Math" alttext="\overline{\mathcal{M}}_{pq}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{pq}</annotation></semantics></math> as a global quotient, and to present how to adapt the geometric regularization method from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>]</cite> to this setting.</p>
</div>
<section id="S5.SS3.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">5.3.1. </span>Description of the K-chart.</h4>

<div id="S5.SS3.SSS1.p1" class="ltx_para">
<p id="S5.SS3.SSS1.p1.1" class="ltx_p">We first define the notion of framed curves in the case of Floer trajectories.</p>
</div>
<div id="S5.Thmthm31" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm31.2" class="ltx_text ltx_font_bold">Definition 5.31</span></span><span id="S5.Thmthm31.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm31.p1" class="ltx_para">
<p id="S5.Thmthm31.p1.1" class="ltx_p">(cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>, Definition 6.10]</cite>)
Given a moduli space <math id="S5.Thmthm31.p1.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}_{pq}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{pq}</annotation></semantics></math> of Floer trajectories and a stratum <math id="S5.Thmthm31.p1.m2" class="ltx_math_unparsed" alttext="\alpha=pr_{1}\cdots r_{l}q" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mi>p</mi><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>l</mi></msub><mi>q</mi></mrow><annotation encoding="application/x-tex">\alpha=pr_{1}\cdots r_{l}q</annotation></semantics></math>, denoting <math id="S5.Thmthm31.p1.m3" class="ltx_Math" alttext="d=d_{pq}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">d=d_{pq}</annotation></semantics></math>, a <span id="S5.Thmthm31.p1.1.1" class="ltx_text ltx_font_bold">framed cylinder</span> (of type <math id="S5.Thmthm31.p1.m4" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>) is a tuple <math id="S5.Thmthm31.p1.m5" class="ltx_Math" alttext="(u,\Sigma,F)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>F</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u,\Sigma,F)</annotation></semantics></math> where</p>
<ol id="S5.I17" class="ltx_enumerate">
<li id="S5.I17.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S5.I17.i1.p1" class="ltx_para">
<p id="S5.I17.i1.p1.1" class="ltx_p"><math id="S5.I17.i1.p1.m1" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> is a prestable cylinder with <math id="S5.I17.i1.p1.m2" class="ltx_Math" alttext="l+1" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">l+1</annotation></semantics></math> horizontal levels (see Definition <a href="#S5.Thmthm12" title="Definition 5.12. ‣ 5.2.1. Moduli spaces of stable cylinders ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.12</span></a>).</p>
</div></li>
<li id="S5.I17.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S5.I17.i2.p1" class="ltx_para">
<p id="S5.I17.i2.p1.1" class="ltx_p"><math id="S5.I17.i2.p1.m1" class="ltx_Math" alttext="u:\Sigma\to M" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">u:\Sigma\to M</annotation></semantics></math> is a smooth map whose restriction to each cylindrical component converges to periodic orbits prescribed by the capped orbits <math id="S5.I17.i2.p1.m2" class="ltx_Math" alttext="p,r_{1},\dots,r_{l},q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>,</mo><msub><mi>r</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>r</mi><mi>l</mi></msub><mo>,</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p,r_{1},\dots,r_{l},q</annotation></semantics></math> at <math id="S5.I17.i2.p1.m3" class="ltx_Math" alttext="\pm\infty" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\pm\infty</annotation></semantics></math> in an exponential rate, and the topological energy of each horizontal level is prescribed by (<a href="#S4.E3" title="In 4.1.1. The moduli spaces of Floer trajectories ‣ 4.1. Hamiltonian Floer flow categories ‣ 4. Proof of the integral Arnold conjecture ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a>). Moreover, the <math id="S5.I17.i2.p1.m4" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-form <math id="S5.I17.i2.p1.m5" class="ltx_Math" alttext="\Omega_{u,H}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ω</mi><mrow><mi>u</mi><mo>,</mo><mi>H</mi></mrow></msub><annotation encoding="application/x-tex">\Omega_{u,H}</annotation></semantics></math> defined in Equation (<a href="#S5.E20" title="In 5.2.8. Abelian gauge theory on punctured spheres ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.20</span></a>) is non-negative and is strictly positive on each unstable component of <math id="S5.I17.i2.p1.m6" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math>.</p>
</div></li>
<li id="S5.I17.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S5.I17.i3.p1" class="ltx_para">
<p id="S5.I17.i3.p1.1" class="ltx_p"><math id="S5.I17.i3.p1.m1" class="ltx_Math" alttext="F=(f_{0},f_{1},\ldots,f_{d})" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mn>0</mn></msub><mo>,</mo><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F=(f_{0},f_{1},\ldots,f_{d})</annotation></semantics></math> is basis of global sections of the line bundle <math id="S5.I17.i3.p1.m2" class="ltx_Math" alttext="L_{u}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>u</mi></msub><annotation encoding="application/x-tex">L_{u}</annotation></semantics></math> constructed using the <math id="S5.I17.i3.p1.m3" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-form (<a href="#S5.E20" title="In 5.2.8. Abelian gauge theory on punctured spheres ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.20</span></a>). Moreover, the induced holomorphic map</p>
<table id="S5.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E21.m1" class="ltx_Math" alttext="\iota_{F}:\Sigma\to\mathbb{CP}^{d},\ w\mapsto[f_{0}(w),\ldots,f_{d}(w)]" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ι</mi><mi>F</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mi>w</mi><mo stretchy="false">↦</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>f</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>f</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\iota_{F}:\Sigma\to\mathbb{CP}^{d},\ w\mapsto[f_{0}(w),\ldots,f_{d}(w)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.21)</span></td></tr></tbody>
</table>
<p id="S5.I17.i3.p1.2" class="ltx_p">is a stable map, which represents a point <math id="S5.I17.i3.p1.m4" class="ltx_Math" alttext="[\iota_{F}]\in{\mathcal{F}}_{0,2}(d)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><msub><mi>ι</mi><mi>F</mi></msub><mo stretchy="false">]</mo></mrow><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">[\iota_{F}]\in{\mathcal{F}}_{0,2}(d)</annotation></semantics></math>. Denote by</p>
<table id="S5.Ex108" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex108.m1" class="ltx_Math" alttext="\tilde{\iota}_{F}:\Sigma\to{\mathcal{C}}={\mathcal{C}}_{0,2}(d)" display="block" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ι</mi><mo>~</mo></mover><mi>F</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{\iota}_{F}:\Sigma\to{\mathcal{C}}={\mathcal{C}}_{0,2}(d)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I17.i3.p1.3" class="ltx_p">to be the identification between <math id="S5.I17.i3.p1.m5" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> and the fiber of the universal curve <math id="S5.I17.i3.p1.m6" class="ltx_Math" alttext="{\mathcal{C}}_{0,2}(d)\to{\mathcal{F}}_{0,2}(d)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{C}}_{0,2}(d)\to{\mathcal{F}}_{0,2}(d)</annotation></semantics></math> over <math id="S5.I17.i3.p1.m7" class="ltx_Math" alttext="[\iota_{F}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mi>ι</mi><mi>F</mi></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[\iota_{F}]</annotation></semantics></math>.<span id="footnote12" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">12</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">12</sup>
                        <span class="ltx_tag ltx_tag_note">12</span>
                        
                        
                        
                      <math id="footnote12.m1" class="ltx_Math" alttext="\tilde{\iota}_{F}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ι</mi><mo>~</mo></mover><mi>F</mi></msub><annotation encoding="application/x-tex">\tilde{\iota}_{F}</annotation></semantics></math> is called a “domain map” in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>]</cite>.</span></span></span></p>
</div></li>
</ol>
</div>
</div>
<div id="S5.SS3.SSS1.p2" class="ltx_para">
<p id="S5.SS3.SSS1.p2.1" class="ltx_p">Note that Condition (2) above guarantees the existence of the Hermitian line bundle <math id="S5.SS3.SSS1.p2.m1" class="ltx_Math" alttext="L_{u}\to\Sigma" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>u</mi></msub><mo stretchy="false">→</mo><mi mathvariant="normal">Σ</mi></mrow><annotation encoding="application/x-tex">L_{u}\to\Sigma</annotation></semantics></math> by Corollary <a href="#S5.Thmthm30" title="Corollary 5.30. ‣ 5.2.8. Abelian gauge theory on punctured spheres ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.30</span></a> whose restriction to each unstable component has strictly positive degree. We can define the notion of isomorphisms of framed curves in an obvious way.</p>
</div>
<div id="S5.Thmthm32" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm32.2" class="ltx_text ltx_font_bold">Definition 5.32</span></span><span id="S5.Thmthm32.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm32.p1" class="ltx_para">
<p id="S5.Thmthm32.p1.1" class="ltx_p">An isomorphism from a framed cylinder <math id="S5.Thmthm32.p1.m1" class="ltx_Math" alttext="(u,\Sigma,F)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>F</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u,\Sigma,F)</annotation></semantics></math> to another framed cylinder <math id="S5.Thmthm32.p1.m2" class="ltx_Math" alttext="(u^{\prime},\Sigma^{\prime},F^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>u</mi><mo>′</mo></msup><mo>,</mo><msup><mi mathvariant="normal">Σ</mi><mo>′</mo></msup><mo>,</mo><msup><mi>F</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u^{\prime},\Sigma^{\prime},F^{\prime})</annotation></semantics></math> consists of an isomorphism <math id="S5.Thmthm32.p1.m3" class="ltx_Math" alttext="\varphi:\Sigma\to\Sigma^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>φ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><msup><mi mathvariant="normal">Σ</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\varphi:\Sigma\to\Sigma^{\prime}</annotation></semantics></math> of prestable cylinders such that <math id="S5.Thmthm32.p1.m4" class="ltx_Math" alttext="u^{\prime}\circ\varphi=u" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>u</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>φ</mi></mrow><mo>=</mo><mi>u</mi></mrow><annotation encoding="application/x-tex">u^{\prime}\circ\varphi=u</annotation></semantics></math> and an isomorphism of holomorphic line bundles <math id="S5.Thmthm32.p1.m5" class="ltx_Math" alttext="\widehat{\varphi}:L_{u}\to L_{u^{\prime}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>φ</mi><mo>^</mo></mover><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>L</mi><mi>u</mi></msub><mo stretchy="false">→</mo><msub><mi>L</mi><msup><mi>u</mi><mo>′</mo></msup></msub></mrow></mrow><annotation encoding="application/x-tex">\widehat{\varphi}:L_{u}\to L_{u^{\prime}}</annotation></semantics></math> which covers <math id="S5.Thmthm32.p1.m6" class="ltx_Math" alttext="\varphi" display="inline" intent=":literal"><semantics><mi>φ</mi><annotation encoding="application/x-tex">\varphi</annotation></semantics></math> and which is an <span id="S5.Thmthm32.p1.1.1" class="ltx_text ltx_font_italic">isometry up to a constant factor</span>, such that <math id="S5.Thmthm32.p1.m7" class="ltx_Math" alttext="f_{i}^{\prime}\circ\varphi=\widehat{\varphi}\circ f_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>f</mi><mi>i</mi><mo>′</mo></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>φ</mi></mrow><mo>=</mo><mrow><mover accent="true"><mi>φ</mi><mo>^</mo></mover><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>f</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">f_{i}^{\prime}\circ\varphi=\widehat{\varphi}\circ f_{i}</annotation></semantics></math> for all <math id="S5.Thmthm32.p1.m8" class="ltx_Math" alttext="i=0,\ldots,d" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">i=0,\ldots,d</annotation></semantics></math>. Two framed cylinders are isomorphic if there exists an isomorphism between them. Notice that scaling the frame <math id="S5.Thmthm32.p1.m9" class="ltx_Math" alttext="F=(f_{0},\ldots,f_{d})" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F=(f_{0},\ldots,f_{d})</annotation></semantics></math> by a nonzero complex number produces an isomorphic framed curve.</p>
</div>
</div>
<div id="S5.SS3.SSS1.p3" class="ltx_para">
<p id="S5.SS3.SSS1.p3.1" class="ltx_p">Given a framed cylinder <math id="S5.SS3.SSS1.p3.m1" class="ltx_Math" alttext="(u,\Sigma,F)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>F</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u,\Sigma,F)</annotation></semantics></math> and an element <math id="S5.SS3.SSS1.p3.m2" class="ltx_Math" alttext="g\in PGL(d+1)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>∈</mo><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">g\in PGL(d+1)</annotation></semantics></math>, we can construct another framed cylinder in the following way. Observe that the sections <math id="S5.SS3.SSS1.p3.m3" class="ltx_Math" alttext="f_{0},\dots,f_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">f_{0},\dots,f_{d}</annotation></semantics></math> define an embedding <math id="S5.SS3.SSS1.p3.m4" class="ltx_Math" alttext="\Sigma\to{\mathbb{C}P}^{d}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mi>d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\Sigma\to{\mathbb{C}P}^{d}</annotation></semantics></math>, under which the line bundle <math id="S5.SS3.SSS1.p3.m5" class="ltx_Math" alttext="L_{u}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>u</mi></msub><annotation encoding="application/x-tex">L_{u}</annotation></semantics></math> is the pullback of <math id="S5.SS3.SSS1.p3.m6" class="ltx_Math" alttext="{\mathcal{O}}(1)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{O}}(1)</annotation></semantics></math> and the basis <math id="S5.SS3.SSS1.p3.m7" class="ltx_Math" alttext="(f_{0},\dots,f_{d})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(f_{0},\dots,f_{d})</annotation></semantics></math> is obtained by pulling back the standard hyperplane sections of <math id="S5.SS3.SSS1.p3.m8" class="ltx_Math" alttext="{\mathcal{O}}(1)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{O}}(1)</annotation></semantics></math>. As an element of the automorphism group of <math id="S5.SS3.SSS1.p3.m9" class="ltx_Math" alttext="{\mathcal{C}P}^{d}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">{\mathcal{C}P}^{d}</annotation></semantics></math>, the action of <math id="S5.SS3.SSS1.p3.m10" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> can be lifted to an automorphism of the line bundle <math id="S5.SS3.SSS1.p3.m11" class="ltx_Math" alttext="{\mathcal{O}}(1)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{O}}(1)</annotation></semantics></math>. Therefore, <math id="S5.SS3.SSS1.p3.m12" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> takes the standard hyperplane sections of <math id="S5.SS3.SSS1.p3.m13" class="ltx_Math" alttext="{\mathcal{O}}(1)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{O}}(1)</annotation></semantics></math> to another basis of <math id="S5.SS3.SSS1.p3.m14" class="ltx_Math" alttext="{\mathcal{O}}(1)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{O}}(1)</annotation></semantics></math>. Composing such an action with the embedding induced by <math id="S5.SS3.SSS1.p3.m15" class="ltx_Math" alttext="(f_{0},\dots,f_{d})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(f_{0},\dots,f_{d})</annotation></semantics></math> defines another framed cylinder and we denote it by</p>
<table id="S5.E22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E22.m1" class="ltx_Math" alttext="(u,\Sigma,g_{*}F)." display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mrow><msub><mi>g</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(u,\Sigma,g_{*}F).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.22)</span></td></tr></tbody>
</table>
</div>
<div id="S5.SS3.SSS1.p4" class="ltx_para">
<p id="S5.SS3.SSS1.p4.1" class="ltx_p">We construct a geometric thickening of a moduli space of Floer trajectories using framed cylinders. We choose the following data.</p>
</div>
<div id="S5.SS3.SSS1.p5" class="ltx_para">
<ol id="S5.I18" class="ltx_enumerate">
<li id="S5.I18.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S5.I18.i1.p1" class="ltx_para">
<p id="S5.I18.i1.p1.1" class="ltx_p">A Hermitian connection <math id="S5.I18.i1.p1.m1" class="ltx_Math" alttext="\nabla^{TM}" display="inline" intent=":literal"><semantics><msup><mo>∇</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msup><annotation encoding="application/x-tex">\nabla^{TM}</annotation></semantics></math> on <math id="S5.I18.i1.p1.m2" class="ltx_Math" alttext="TM" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">TM</annotation></semantics></math> with respect to the Hermitian metric induced from <math id="S5.I18.i1.p1.m3" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math> and <math id="S5.I18.i1.p1.m4" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math> satisfying the following condition: <math id="S5.I18.i1.p1.m5" class="ltx_Math" alttext="\nabla^{TM}" display="inline" intent=":literal"><semantics><msup><mo>∇</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msup><annotation encoding="application/x-tex">\nabla^{TM}</annotation></semantics></math> is flat near all 1-periodic orbits (which are all embedded and disjoint by assumption) of <math id="S5.I18.i1.p1.m6" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> and its holonomy along each such orbit is nondegenerate, i.e., does not have <math id="S5.I18.i1.p1.m7" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> as an eigenvalue.</p>
</div></li>
<li id="S5.I18.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S5.I18.i2.p1" class="ltx_para">
<p id="S5.I18.i2.p1.1" class="ltx_p">For each moduli space <math id="S5.I18.i2.p1.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}_{pq}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{pq}</annotation></semantics></math>, a positive integer <math id="S5.I18.i2.p1.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>.<span id="footnote13" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">13</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">13</sup>
                      <span class="ltx_tag ltx_tag_note">13</span>
                      
                      
                      
                    Later we will need <math id="footnote13.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> to be sufficiently large to achieve transversality. We will also need to choose a list of integers instead of a single one to obtain a Kuranishi flow category.</span></span></span></p>
</div></li>
</ol>
</div>
<div id="S5.SS3.SSS1.p6" class="ltx_para">
<p id="S5.SS3.SSS1.p6.1" class="ltx_p">The following definition introduces the thickening induced by one single line bundle. The discussion here is of expository nature, and the actual thickening we need involves multiple line bundles, as presented in detail in Section <a href="#S5.SS3.SSS3" title="5.3.3. Multi-layered thickening ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.3.3</span></a>.</p>
</div>
<div id="S5.Thmthm33" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm33.2" class="ltx_text ltx_font_bold">Definition 5.33</span></span><span id="S5.Thmthm33.3" class="ltx_text ltx_font_bold"> </span>(Thickened moduli)<span id="S5.Thmthm33.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm33.p1" class="ltx_para">
<p id="S5.Thmthm33.p1.1" class="ltx_p">Fix a nonempty moduli space <math id="S5.Thmthm33.p1.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}_{pq}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{pq}</annotation></semantics></math>. Abbreviate <math id="S5.Thmthm33.p1.m2" class="ltx_Math" alttext="d=d_{pq}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">d=d_{pq}</annotation></semantics></math>. We define the following objects.</p>
<ol id="S5.I19" class="ltx_enumerate">
<li id="S5.I19.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S5.I19.i1.p1" class="ltx_para">
<p id="S5.I19.i1.p1.1" class="ltx_p">The <em id="S5.I19.i1.p1.1.1" class="ltx_emph ltx_font_italic">symmetry group</em> <math id="S5.I19.i1.p1.m1" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math> is <math id="S5.I19.i1.p1.m2" class="ltx_Math" alttext="G_{d_{pq}}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msub><annotation encoding="application/x-tex">G_{d_{pq}}</annotation></semantics></math>.</p>
</div></li>
<li id="S5.I19.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S5.I19.i2.p1" class="ltx_para">
<p id="S5.I19.i2.p1.1" class="ltx_p">The <em id="S5.I19.i2.p1.1.1" class="ltx_emph ltx_font_italic">thickened moduli space</em> <math id="S5.I19.i2.p1.m1" class="ltx_Math" alttext="V_{pq}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">V_{pq}</annotation></semantics></math> parametrizes isomorphism classes of quadruples of the form</p>
<table id="S5.Ex109" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex109.m1" class="ltx_Math" alttext="(u,\Sigma,F,\eta)" display="block" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>F</mi><mo>,</mo><mi>η</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u,\Sigma,F,\eta)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I19.i2.p1.2" class="ltx_p">where</p>
<ol id="S5.I19.i2.I1" class="ltx_enumerate">
<li id="S5.I19.i2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(a)</span> 
<div id="S5.I19.i2.I1.i1.p1" class="ltx_para">
<p id="S5.I19.i2.I1.i1.p1.1" class="ltx_p"><math id="S5.I19.i2.I1.i1.p1.m1" class="ltx_Math" alttext="(u,\Sigma,F)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>F</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u,\Sigma,F)</annotation></semantics></math> is a framed cylinder. Suppose it is of type <math id="S5.I19.i2.I1.i1.p1.m2" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> for some stratum <math id="S5.I19.i2.I1.i1.p1.m3" class="ltx_math_unparsed" alttext="\alpha=pr_{1}\cdots r_{l}q" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mi>p</mi><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>l</mi></msub><mi>q</mi></mrow><annotation encoding="application/x-tex">\alpha=pr_{1}\cdots r_{l}q</annotation></semantics></math>.</p>
</div></li>
<li id="S5.I19.i2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(b)</span> 
<div id="S5.I19.i2.I1.i2.p1" class="ltx_para">
<p id="S5.I19.i2.I1.i2.p1.1" class="ltx_p">The framing <math id="S5.I19.i2.I1.i2.p1.m1" class="ltx_Math" alttext="F=(f_{0},\dots,f_{d})" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F=(f_{0},\dots,f_{d})</annotation></semantics></math> satisfies</p>
<table id="S5.Ex110" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex110.m1" class="ltx_math_unparsed" alttext="[f_{0}(z_{-}):\cdots:f_{d}(z_{-})]=[1:0:\cdots:0]." display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><msub><mi>f</mi><mn>0</mn></msub><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mo>−</mo></msub><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo>:</mo><mo lspace="0.111em">⋯</mo><mo rspace="0.278em">:</mo><msub><mi>f</mi><mi>d</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>=</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>0</mn><mo lspace="0.278em">:</mo><mo lspace="0.111em">⋯</mo><mo rspace="0.278em">:</mo><mn>0</mn><mo stretchy="false">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">[f_{0}(z_{-}):\cdots:f_{d}(z_{-})]=[1:0:\cdots:0].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S5.I19.i2.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(c)</span> 
<div id="S5.I19.i2.I1.i3.p1" class="ltx_para">
<p id="S5.I19.i2.I1.i3.p1.1" class="ltx_p"><math id="S5.I19.i2.I1.i3.p1.m1" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math> is an element of the vector space</p>
<table id="S5.E23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E23.m1" class="ltx_Math" alttext="H^{0}(\overline{\rm Hom}(\iota_{F}^{*}T\mathbb{CP}^{d},u^{*}TM)\otimes\iota_{F}^{*}{\mathcal{O}}(k))\otimes_{\mathbb{C}}\overline{H^{0}(\iota_{F}^{*}{\mathcal{O}}(k))_{0}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mover accent="true"><mi>Hom</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>ι</mi><mi>F</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><mo>,</mo><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>TM</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi>ι</mi><mi>F</mi><mo>∗</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><msub><mo rspace="0.222em">⊗</mo><mi>ℂ</mi></msub><mover accent="true"><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>ι</mi><mi>F</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>0</mn></msub></mrow><mo stretchy="true">¯</mo></mover></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H^{0}(\overline{\rm Hom}(\iota_{F}^{*}T\mathbb{CP}^{d},u^{*}TM)\otimes\iota_{F}^{*}{\mathcal{O}}(k))\otimes_{\mathbb{C}}\overline{H^{0}(\iota_{F}^{*}{\mathcal{O}}(k))_{0}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.23)</span></td></tr></tbody>
</table>
<p id="S5.I19.i2.I1.i3.p1.2" class="ltx_p">Here the first <math id="S5.I19.i2.I1.i3.p1.m2" class="ltx_Math" alttext="H^{0}" display="inline" intent=":literal"><semantics><msup><mi>H</mi><mn>0</mn></msup><annotation encoding="application/x-tex">H^{0}</annotation></semantics></math> is the kernel of the Cauchy–Riemann operator induced from the Hermitian connection <math id="S5.I19.i2.I1.i3.p1.m3" class="ltx_Math" alttext="\nabla^{TM}" display="inline" intent=":literal"><semantics><msup><mo>∇</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msup><annotation encoding="application/x-tex">\nabla^{TM}</annotation></semantics></math> on <math id="S5.I19.i2.I1.i3.p1.m4" class="ltx_Math" alttext="TM" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">TM</annotation></semantics></math> and the standard complex structure of <math id="S5.I19.i2.I1.i3.p1.m5" class="ltx_Math" alttext="\mathbb{CP}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathbb{CP}^{d}</annotation></semantics></math>; on the other hand, <math id="S5.I19.i2.I1.i3.p1.m6" class="ltx_Math" alttext="H^{0}(\iota_{F}^{*}{\mathcal{O}}(k))_{0}" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>ι</mi><mi>F</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">H^{0}(\iota_{F}^{*}{\mathcal{O}}(k))_{0}</annotation></semantics></math> is the space of holomorphic sections of <math id="S5.I19.i2.I1.i3.p1.m7" class="ltx_Math" alttext="\iota_{F}^{*}{\mathcal{O}}(k)\to\Sigma" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>ι</mi><mi>F</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi mathvariant="normal">Σ</mi></mrow><annotation encoding="application/x-tex">\iota_{F}^{*}{\mathcal{O}}(k)\to\Sigma</annotation></semantics></math> which vanish at the two marked points <math id="S5.I19.i2.I1.i3.p1.m8" class="ltx_Math" alttext="z_{-}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mo>−</mo></msub><annotation encoding="application/x-tex">z_{-}</annotation></semantics></math> and <math id="S5.I19.i2.I1.i3.p1.m9" class="ltx_Math" alttext="z_{+}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mo>+</mo></msub><annotation encoding="application/x-tex">z_{+}</annotation></semantics></math>.</p>
</div></li>
</ol>
<p id="S5.I19.i2.p1.3" class="ltx_p">The quadruple <math id="S5.I19.i2.p1.m2" class="ltx_Math" alttext="(u,\Sigma,F,\eta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>F</mi><mo>,</mo><mi>η</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u,\Sigma,F,\eta)</annotation></semantics></math> needs to satisfy the following perturbation of the Floer’s equation (cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>, Equation (6.7)]</cite>): on each component of <math id="S5.I19.i2.p1.m3" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> one has</p>
<table id="S5.E24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E24.m1" class="ltx_Math" alttext="\overline{\partial}_{J,H}u+\langle\eta\rangle\circ d\iota_{F}=0," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mover accent="true"><mo>∂</mo><mo stretchy="true">¯</mo></mover><mrow><mi>J</mi><mo>,</mo><mi>H</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo>+</mo><mrow><mrow><mrow><mo stretchy="false">⟨</mo><mi>η</mi><mo rspace="0.055em" stretchy="false">⟩</mo></mrow><mo rspace="0.222em">∘</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ι</mi><mi>F</mi></msub></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\overline{\partial}_{J,H}u+\langle\eta\rangle\circ d\iota_{F}=0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.24)</span></td></tr></tbody>
</table>
<p id="S5.I19.i2.p1.4" class="ltx_p">where <math id="S5.I19.i2.p1.m4" class="ltx_Math" alttext="\overline{\partial}_{J,H}u=(du-X_{H}(u))_{J}^{0,1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mo>∂</mo><mo stretchy="true">¯</mo></mover><mrow><mi>J</mi><mo>,</mo><mi>H</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo>=</mo><msubsup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo>−</mo><mrow><msub><mi>X</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>J</mi><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msubsup></mrow><annotation encoding="application/x-tex">\overline{\partial}_{J,H}u=(du-X_{H}(u))_{J}^{0,1}</annotation></semantics></math> in which <math id="S5.I19.i2.p1.m5" class="ltx_Math" alttext="X_{H}(u)\in\Omega^{1}(\Sigma,u^{*}TM)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>X</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><msup><mi mathvariant="normal">Ω</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X_{H}(u)\in\Omega^{1}(\Sigma,u^{*}TM)</annotation></semantics></math> is defined by</p>
<table id="S5.Ex111" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex111.m1" class="ltx_Math" alttext="X_{H}(u):=\left\{\begin{array}[]{lr}\displaystyle 0&amp;\text{ on spherical components}\\
\displaystyle dt\otimes X_{H_{t}}&amp;\text{ on cylindrical components,}\end{array}\right." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>X</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mn>0</mn></mtd><mtd class="ltx_align_right" columnalign="right"><mtext> on spherical components</mtext></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>X</mi><msub><mi>H</mi><mi>t</mi></msub></msub></mrow></mtd><mtd class="ltx_align_right" columnalign="right"><mtext> on cylindrical components,</mtext></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">X_{H}(u):=\left\{\begin{array}[]{lr}\displaystyle 0&amp;\text{ on spherical components}\\
\displaystyle dt\otimes X_{H_{t}}&amp;\text{ on cylindrical components,}\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I19.i2.p1.5" class="ltx_p">and the map <math id="S5.I19.i2.p1.m6" class="ltx_Math" alttext="\eta\mapsto\langle\eta\rangle" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo stretchy="false">↦</mo><mrow><mo stretchy="false">⟨</mo><mi>η</mi><mo stretchy="false">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">\eta\mapsto\langle\eta\rangle</annotation></semantics></math> is induced from the Hermitian pairing on <math id="S5.I19.i2.p1.m7" class="ltx_Math" alttext="{\mathcal{O}}(k)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{O}}(k)</annotation></semantics></math>.</p>
</div></li>
<li id="S5.I19.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S5.I19.i3.p1" class="ltx_para">
<p id="S5.I19.i3.p1.1" class="ltx_p">The <span id="S5.I19.i3.p1.1.1" class="ltx_text ltx_font_italic">obstruction bundle</span> <math id="S5.I19.i3.p1.m1" class="ltx_Math" alttext="E_{pq}\to V_{pq}" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">E_{pq}\to V_{pq}</annotation></semantics></math> is the direct sum</p>
<table id="S5.Ex112" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex112.m1" class="ltx_Math" alttext="E_{pq}=O_{pq}\oplus Q_{pq}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>E</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>=</mo><mrow><msub><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>⊕</mo><msub><mi>Q</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">E_{pq}=O_{pq}\oplus Q_{pq}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I19.i3.p1.2" class="ltx_p">Here</p>
<table id="S5.Ex113" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex113.m1" class="ltx_Math" alttext="Q_{pq}:=V_{pq}\times{\bm{Q}}_{d_{pq}}" display="block" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>:=</mo><mrow><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝑸</mi><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msub></mrow></mrow><annotation encoding="application/x-tex">Q_{pq}:=V_{pq}\times{\bm{Q}}_{d_{pq}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I19.i3.p1.3" class="ltx_p">and <math id="S5.I19.i3.p1.m2" class="ltx_Math" alttext="{\bm{Q}}_{d}" display="inline" intent=":literal"><semantics><msub><mi>𝑸</mi><mi>d</mi></msub><annotation encoding="application/x-tex">{\bm{Q}}_{d}</annotation></semantics></math> for all <math id="S5.I19.i3.p1.m3" class="ltx_Math" alttext="d\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d\geq 1</annotation></semantics></math> was defined in (<a href="#S5.E12" title="In 5.2.5. Boundary strata of the auxiliary moduli spaces ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.12</span></a>); the fiber of <math id="S5.I19.i3.p1.m4" class="ltx_Math" alttext="O_{pq}" display="inline" intent=":literal"><semantics><msub><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">O_{pq}</annotation></semantics></math> at a point <math id="S5.I19.i3.p1.m5" class="ltx_Math" alttext="x\in V_{pq}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">x\in V_{pq}</annotation></semantics></math> represented by <math id="S5.I19.i3.p1.m6" class="ltx_Math" alttext="(u,\Sigma,F,\eta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>F</mi><mo>,</mo><mi>η</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u,\Sigma,F,\eta)</annotation></semantics></math> is</p>
<table id="S5.Ex114" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex114.m1" class="ltx_Math" alttext="H^{0}(\overline{\rm Hom}(\iota_{F}^{*}T\mathbb{CP}^{d},u^{*}TM)\otimes\iota_{F}^{*}{\mathcal{O}}(k))\otimes_{\mathbb{C}}\overline{H^{0}(\iota_{F}^{*}{\mathcal{O}}(k))_{0}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mover accent="true"><mi>Hom</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>ι</mi><mi>F</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><mo>,</mo><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>TM</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi>ι</mi><mi>F</mi><mo>∗</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><msub><mo rspace="0.222em">⊗</mo><mi>ℂ</mi></msub><mover accent="true"><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>ι</mi><mi>F</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>0</mn></msub></mrow><mo stretchy="true">¯</mo></mover></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H^{0}(\overline{\rm Hom}(\iota_{F}^{*}T\mathbb{CP}^{d},u^{*}TM)\otimes\iota_{F}^{*}{\mathcal{O}}(k))\otimes_{\mathbb{C}}\overline{H^{0}(\iota_{F}^{*}{\mathcal{O}}(k))_{0}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S5.I19.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S5.I19.i4.p1" class="ltx_para">
<p id="S5.I19.i4.p1.1" class="ltx_p">The group <math id="S5.I19.i4.p1.m1" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math> acts on <math id="S5.I19.i4.p1.m2" class="ltx_Math" alttext="E_{pq}\to V_{pq}" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">E_{pq}\to V_{pq}</annotation></semantics></math> (on the left) as follows. Given a quadruple <math id="S5.I19.i4.p1.m3" class="ltx_Math" alttext="(u,\Sigma,F,\eta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>F</mi><mo>,</mo><mi>η</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u,\Sigma,F,\eta)</annotation></semantics></math> where <math id="S5.I19.i4.p1.m4" class="ltx_Math" alttext="F=(f_{0},f_{1},\ldots,f_{d})" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mn>0</mn></msub><mo>,</mo><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F=(f_{0},f_{1},\ldots,f_{d})</annotation></semantics></math> and <math id="S5.I19.i4.p1.m5" class="ltx_Math" alttext="g\in G_{pq}\subset PGL(d+1)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>∈</mo><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>⊂</mo><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">g\in G_{pq}\subset PGL(d+1)</annotation></semantics></math>, define the the framed curve</p>
<table id="S5.Ex115" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex115.m1" class="ltx_Math" alttext="(u,\Sigma,F^{\prime}):=(u,\Sigma,g_{*}F)" display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><msup><mi>F</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>:=</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mrow><msub><mi>g</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(u,\Sigma,F^{\prime}):=(u,\Sigma,g_{*}F)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I19.i4.p1.2" class="ltx_p">as from Equation (<a href="#S5.E22" title="In 5.3.1. Description of the K-chart. ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.22</span></a>). Moreover, <math id="S5.I19.i4.p1.m6" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> induces linear isomorphisms</p>
<table id="S5.Ex116" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex116.m1" class="ltx_Math" alttext="g:H^{0}(\overline{\rm Hom}(\iota_{F}^{*}T\mathbb{CP}^{d},u^{*}TM)\otimes\iota_{F}^{*}{\mathcal{O}}(k))\to H^{0}(\overline{\rm Hom}(\iota_{F^{\prime}}^{*}T\mathbb{CP}^{d},u^{*}TX)\otimes\iota_{F^{\prime}}^{*}{\mathcal{O}}(k))" display="block" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mover accent="true"><mi>Hom</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>ι</mi><mi>F</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><mo>,</mo><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>TM</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi>ι</mi><mi>F</mi><mo>∗</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mover accent="true"><mi>Hom</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>ι</mi><msup><mi>F</mi><mo>′</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><mo>,</mo><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>TX</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi>ι</mi><msup><mi>F</mi><mo>′</mo></msup><mo>∗</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">g:H^{0}(\overline{\rm Hom}(\iota_{F}^{*}T\mathbb{CP}^{d},u^{*}TM)\otimes\iota_{F}^{*}{\mathcal{O}}(k))\to H^{0}(\overline{\rm Hom}(\iota_{F^{\prime}}^{*}T\mathbb{CP}^{d},u^{*}TX)\otimes\iota_{F^{\prime}}^{*}{\mathcal{O}}(k))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I19.i4.p1.3" class="ltx_p">and</p>
<table id="S5.Ex117" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex117.m1" class="ltx_Math" alttext="g:H^{0}(\iota_{F}^{*}{\mathcal{O}}(k))_{0}\to H^{0}(\iota_{F^{\prime}}^{*}{\mathcal{O}}(k))_{0}." display="block" intent=":literal"><semantics><mrow><mrow><mi>g</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>ι</mi><mi>F</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>0</mn></msub></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>ι</mi><msup><mi>F</mi><mo>′</mo></msup><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>0</mn></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">g:H^{0}(\iota_{F}^{*}{\mathcal{O}}(k))_{0}\to H^{0}(\iota_{F^{\prime}}^{*}{\mathcal{O}}(k))_{0}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I19.i4.p1.4" class="ltx_p">The action on the <math id="S5.I19.i4.p1.m7" class="ltx_Math" alttext="Q_{pq}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">Q_{pq}</annotation></semantics></math>-component of the obstruction bundle is defined as</p>
<table id="S5.Ex118" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex118.m1" class="ltx_Math" alttext="g\cdot Q\mapsto gQg^{-1},\ g\in G_{pq},\ Q\in{\bm{Q}}_{d}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>g</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>Q</mi></mrow><mo stretchy="false">↦</mo><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>g</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mi>g</mi><mo>∈</mo><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo rspace="0.667em">,</mo><mrow><mi>Q</mi><mo>∈</mo><msub><mi>𝑸</mi><mi>d</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">g\cdot Q\mapsto gQg^{-1},\ g\in G_{pq},\ Q\in{\bm{Q}}_{d}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S5.I19.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(5)</span> 
<div id="S5.I19.i5.p1" class="ltx_para">
<p id="S5.I19.i5.p1.1" class="ltx_p">The <em id="S5.I19.i5.p1.1.1" class="ltx_emph ltx_font_italic">Kuranishi map</em> is</p>
<table id="S5.Ex119" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex119.m1" class="ltx_Math" alttext="\begin{split}S_{pq}:V_{pq}&amp;\ \to E_{pq}\\
[u,\Sigma,F,\eta]&amp;\ \mapsto(\eta,Q(u,\Sigma,F))\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><msub><mi>S</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo lspace="0.778em" stretchy="false">→</mo><msub><mi>E</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mo stretchy="false">[</mo><mrow><mi>u</mi><mo>,</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>F</mi><mo>,</mo><mi>η</mi></mrow><mo stretchy="false">]</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo lspace="0.778em" stretchy="false">↦</mo><mrow><mo stretchy="false">(</mo><mi>η</mi><mo>,</mo><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}S_{pq}:V_{pq}&amp;\ \to E_{pq}\\
[u,\Sigma,F,\eta]&amp;\ \mapsto(\eta,Q(u,\Sigma,F))\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I19.i5.p1.2" class="ltx_p">where <math id="S5.I19.i5.p1.m1" class="ltx_Math" alttext="Q(u,\Sigma,F)" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Q(u,\Sigma,F)</annotation></semantics></math> the image of <math id="S5.I19.i5.p1.m2" class="ltx_Math" alttext="(d+1)\times(d+1)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(d+1)\times(d+1)</annotation></semantics></math> Hermitian matrix whose <math id="S5.I19.i5.p1.m3" class="ltx_Math" alttext="(i,j)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i,j)</annotation></semantics></math>-entry is</p>
<table id="S5.Ex120" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex120.m1" class="ltx_Math" alttext="\left[\int_{\Sigma}\langle f_{i},f_{j}\rangle\Omega_{u,H}\right]\in{\bm{Q}}_{d}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>[</mo><mrow><msub><mo lspace="0em" rspace="0em">∫</mo><mi mathvariant="normal">Σ</mi></msub><mrow><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>f</mi><mi>i</mi></msub><mo>,</mo><msub><mi>f</mi><mi>j</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Ω</mi><mrow><mi>u</mi><mo>,</mo><mi>H</mi></mrow></msub></mrow></mrow><mo>]</mo></mrow><mo>∈</mo><msub><mi>𝑸</mi><mi>d</mi></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left[\int_{\Sigma}\langle f_{i},f_{j}\rangle\Omega_{u,H}\right]\in{\bm{Q}}_{d}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I19.i5.p1.3" class="ltx_p">It is easy to see that <math id="S5.I19.i5.p1.m4" class="ltx_Math" alttext="Q(u,\Sigma,F)" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Q(u,\Sigma,F)</annotation></semantics></math> only depends on the isomorphism class of the framed curve.</p>
</div></li>
<li id="S5.I19.i6" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(6)</span> 
<div id="S5.I19.i6.p1" class="ltx_para">
<p id="S5.I19.i6.p1.1" class="ltx_p">If <math id="S5.I19.i6.p1.m1" class="ltx_Math" alttext="[u,\Sigma,F,\eta]\in S_{pq}^{-1}(0)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mrow><mi>u</mi><mo>,</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>F</mi><mo>,</mo><mi>η</mi></mrow><mo stretchy="false">]</mo></mrow><mo>∈</mo><mrow><msubsup><mi>S</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">[u,\Sigma,F,\eta]\in S_{pq}^{-1}(0)</annotation></semantics></math>, one can see that <math id="S5.I19.i6.p1.m2" class="ltx_Math" alttext="u:\Sigma\to M" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">u:\Sigma\to M</annotation></semantics></math> represents an element of <math id="S5.I19.i6.p1.m3" class="ltx_Math" alttext="\overline{\mathcal{M}}_{pq}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{pq}</annotation></semantics></math>. Define the <em id="S5.I19.i6.p1.1.1" class="ltx_emph ltx_font_italic">footprint map</em></p>
<table id="S5.Ex121" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex121.m1" class="ltx_Math" alttext="\tilde{\psi}_{pq}:S_{pq}^{-1}(0)\to\overline{\mathcal{M}}_{pq},\ [u,\Sigma,F,\eta]\mapsto[u]" display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mi>S</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mi>u</mi><mo>,</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>F</mi><mo>,</mo><mi>η</mi></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">↦</mo><mrow><mo stretchy="false">[</mo><mi>u</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{\psi}_{pq}:S_{pq}^{-1}(0)\to\overline{\mathcal{M}}_{pq},\ [u,\Sigma,F,\eta]\mapsto[u]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I19.i6.p1.2" class="ltx_p">which induces a continuous map</p>
<table id="S5.Ex122" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex122.m1" class="ltx_math_unparsed" alttext="\psi_{pq}:S_{pq}^{-1}(0)/G_{pq}\to\overline{\mathcal{M}}{}_{pq}." display="block" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><msubsup><mi>S</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>/</mo><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">→</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mo lspace="0em">.</mo><mprescripts></mprescripts><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">\psi_{pq}:S_{pq}^{-1}(0)/G_{pq}\to\overline{\mathcal{M}}{}_{pq}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
</div>
</div>
<div id="S5.Thmthm34" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm34.2" class="ltx_text ltx_font_italic">Remark 5.34</span></span><span id="S5.Thmthm34.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S5.Thmthm34.p1" class="ltx_para">
<p id="S5.Thmthm34.p1.1" class="ltx_p">Our definition closely follows <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>]</cite>. However one difference is that in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>]</cite>, they used the obstruction space</p>
<table id="S5.Ex123" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex123.m1" class="ltx_Math" alttext="H^{0}(\overline{\rm Hom}(\tilde{\iota}_{F}^{*}T{\mathcal{C}},u^{*}TM)\otimes\tilde{\iota}_{F}^{*}{\mathcal{L}}^{k})\otimes\overline{H^{0}(\tilde{\iota}_{F}^{*}{\mathcal{L}}^{k})}" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mover accent="true"><mi>Hom</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>ι</mi><mo>~</mo></mover><mi>F</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><mo>,</mo><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>TM</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mover accent="true"><mi>ι</mi><mo>~</mo></mover><mi>F</mi><mo>∗</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>k</mi></msup></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mover accent="true"><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>ι</mi><mo>~</mo></mover><mi>F</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>k</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="true">¯</mo></mover></mrow><annotation encoding="application/x-tex">H^{0}(\overline{\rm Hom}(\tilde{\iota}_{F}^{*}T{\mathcal{C}},u^{*}TM)\otimes\tilde{\iota}_{F}^{*}{\mathcal{L}}^{k})\otimes\overline{H^{0}(\tilde{\iota}_{F}^{*}{\mathcal{L}}^{k})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmthm34.p1.2" class="ltx_p">where <math id="S5.Thmthm34.p1.m1" class="ltx_Math" alttext="T{\mathcal{C}}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><annotation encoding="application/x-tex">T{\mathcal{C}}</annotation></semantics></math> is the tangent bundle of the universal curve <math id="S5.Thmthm34.p1.m2" class="ltx_Math" alttext="{\mathcal{C}}_{0,2}(d)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{C}}_{0,2}(d)</annotation></semantics></math> and <math id="S5.Thmthm34.p1.m3" class="ltx_Math" alttext="{\mathcal{L}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">{\mathcal{L}}</annotation></semantics></math> denotes a relatively ample line bundle over the universal family <math id="S5.Thmthm34.p1.m4" class="ltx_Math" alttext="{\mathcal{C}}_{0,2}(d)\to{\mathcal{F}}_{0,2}(d)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{C}}_{0,2}(d)\to{\mathcal{F}}_{0,2}(d)</annotation></semantics></math>, and <math id="S5.Thmthm34.p1.m5" class="ltx_Math" alttext="\tilde{\iota}_{F}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ι</mi><mo>~</mo></mover><mi>F</mi></msub><annotation encoding="application/x-tex">\tilde{\iota}_{F}</annotation></semantics></math> is the domain map,
while we replace this space by ours (<a href="#S5.E23" title="In item 2c ‣ item 2 ‣ Definition 5.33 (Thickened moduli). ‣ 5.3.1. Description of the K-chart. ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.23</span></a>).</p>
</div>
</div>
<div id="S5.Thmthm35" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm35.2" class="ltx_text ltx_font_bold">Lemma 5.35</span></span><span id="S5.Thmthm35.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm35.p1" class="ltx_para">
<p id="S5.Thmthm35.p1.1" class="ltx_p"><math id="S5.Thmthm35.p1.m1" class="ltx_Math" alttext="\psi_{pq}" display="inline" intent=":literal"><semantics><msub><mi>ψ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\psi_{pq}</annotation></semantics></math><span id="S5.Thmthm35.p1.1.1" class="ltx_text ltx_font_italic"> is a homeomorphism.</span></p>
</div>
</div>
<div id="S5.SS3.SSS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.SS3.SSS1.p7" class="ltx_para">
<p id="S5.SS3.SSS1.p7.1" class="ltx_p"><span id="S5.SS3.SSS1.p7.1.1" class="ltx_text">See <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>, Lemma 6.14]</cite>.
∎</span></p>
</div>
</div>
<div id="S5.Thmthm36" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm36.2" class="ltx_text ltx_font_bold">Lemma 5.36</span></span><span id="S5.Thmthm36.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm36.p1" class="ltx_para">
<p id="S5.Thmthm36.p1.1" class="ltx_p"><span id="S5.Thmthm36.p1.1.1" class="ltx_text ltx_font_italic">For each <math id="S5.Thmthm36.p1.m1" class="ltx_Math" alttext="x\in S_{pq}^{-1}(0)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><msubsup><mi>S</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x\in S_{pq}^{-1}(0)</annotation></semantics></math>, the stabilizer <math id="S5.Thmthm36.p1.m2" class="ltx_Math" alttext="G_{x}\subset G_{pq}" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mi>x</mi></msub><mo>⊂</mo><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">G_{x}\subset G_{pq}</annotation></semantics></math> is isomorphic to the stabilizer of <math id="S5.Thmthm36.p1.m3" class="ltx_Math" alttext="\psi_{pq}(x)\in\overline{\mathcal{M}}_{pq}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ψ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\psi_{pq}(x)\in\overline{\mathcal{M}}_{pq}</annotation></semantics></math>. Moreover, in a <math id="S5.Thmthm36.p1.m4" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math>-invariant open neighborhood of <math id="S5.Thmthm36.p1.m5" class="ltx_Math" alttext="S_{pq}^{-1}(0)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>S</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">S_{pq}^{-1}(0)</annotation></semantics></math> every point has finite isotropy group.</span></p>
</div>
</div>
<div id="S5.SS3.SSS1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.SS3.SSS1.p8" class="ltx_para">
<p id="S5.SS3.SSS1.p8.1" class="ltx_p"><span id="S5.SS3.SSS1.p8.1.1" class="ltx_text">See the proof of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>, Lemma 6.4]</cite>.
∎</span></p>
</div>
</div>
<div id="S5.SS3.SSS1.p9" class="ltx_para">
<p id="S5.SS3.SSS1.p9.1" class="ltx_p">Therefore, we see that Definition <a href="#S5.Thmthm33" title="Definition 5.33 (Thickened moduli). ‣ 5.3.1. Description of the K-chart. ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.33</span></a> presents <math id="S5.SS3.SSS1.p9.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}_{pq}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{pq}</annotation></semantics></math> as a global quotient preserving the stabilizers. Now we can discuss about the regularity properties.</p>
</div>
</section>
<section id="S5.SS3.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">5.3.2. </span>Transversality of the perturbed Floer equation</h4>

<div id="S5.SS3.SSS2.p1" class="ltx_para">
<p id="S5.SS3.SSS2.p1.1" class="ltx_p">We review Gromov’s graph trick used in the specific setting of global Kuranishi charts in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>]</cite>. Let <math id="S5.SS3.SSS2.p1.m1" class="ltx_Math" alttext="(N,J_{N})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>N</mi><mo>,</mo><msub><mi>J</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(N,J_{N})</annotation></semantics></math> be an almost complex manifold and <math id="S5.SS3.SSS2.p1.m2" class="ltx_Math" alttext="E\to N" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo stretchy="false">→</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">E\to N</annotation></semantics></math> be a Hermitian vector bundle with a Hermitian connection <math id="S5.SS3.SSS2.p1.m3" class="ltx_Math" alttext="\nabla^{E}" display="inline" intent=":literal"><semantics><msup><mo>∇</mo><mi>E</mi></msup><annotation encoding="application/x-tex">\nabla^{E}</annotation></semantics></math>. Then using the decomposition <math id="S5.SS3.SSS2.p1.m4" class="ltx_Math" alttext="TE=T^{h}E\oplus T^{v}E" display="inline" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow><mo>=</mo><mrow><mrow><msup><mi>T</mi><mi>h</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow><mo>⊕</mo><mrow><msup><mi>T</mi><mi>v</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">TE=T^{h}E\oplus T^{v}E</annotation></semantics></math> of the tangent bundle of the total space of <math id="S5.SS3.SSS2.p1.m5" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> into horizontal and vertical tangent bundles induced from <math id="S5.SS3.SSS2.p1.m6" class="ltx_Math" alttext="\nabla" display="inline" intent=":literal"><semantics><mo>∇</mo><annotation encoding="application/x-tex">\nabla</annotation></semantics></math>, there is an induced “product type” almost complex structure <math id="S5.SS3.SSS2.p1.m7" class="ltx_Math" alttext="J^{E}" display="inline" intent=":literal"><semantics><msup><mi>J</mi><mi>E</mi></msup><annotation encoding="application/x-tex">J^{E}</annotation></semantics></math> on <math id="S5.SS3.SSS2.p1.m8" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> by combining <math id="S5.SS3.SSS2.p1.m9" class="ltx_Math" alttext="J_{N}" display="inline" intent=":literal"><semantics><msub><mi>J</mi><mi>N</mi></msub><annotation encoding="application/x-tex">J_{N}</annotation></semantics></math> with the fiberwise complex structure on <math id="S5.SS3.SSS2.p1.m10" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>. Now consider a <math id="S5.SS3.SSS2.p1.m11" class="ltx_Math" alttext="{\mathbb{R}}" display="inline" intent=":literal"><semantics><mi>ℝ</mi><annotation encoding="application/x-tex">{\mathbb{R}}</annotation></semantics></math>-linear bundle map</p>
<table id="S5.Ex124" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex124.m1" class="ltx_Math" alttext="\Psi:E\oplus TN\to TN" display="block" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ψ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>E</mi><mo>⊕</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\Psi:E\oplus TN\to TN</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.SSS2.p1.2" class="ltx_p">satisfying</p>
<table id="S5.E25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E25.m1" class="ltx_Math" alttext="J_{N}(\Psi(e,h))=-\Psi(e,J_{N}(h))" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>J</mi><mi>N</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo>,</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>−</mo><mrow><mi mathvariant="normal">Ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo>,</mo><mrow><msub><mi>J</mi><mi>N</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">J_{N}(\Psi(e,h))=-\Psi(e,J_{N}(h))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.25)</span></td></tr></tbody>
</table>
<p id="S5.SS3.SSS2.p1.3" class="ltx_p">and</p>
<table id="S5.E26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E26.m1" class="ltx_Math" alttext="\Psi(e,\Psi(e,h))=0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi mathvariant="normal">Ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo>,</mo><mrow><mi mathvariant="normal">Ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo>,</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Psi(e,\Psi(e,h))=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.26)</span></td></tr></tbody>
</table>
<p id="S5.SS3.SSS2.p1.4" class="ltx_p">We define</p>
<table id="S5.Ex125" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex125.m1" class="ltx_Math" alttext="\Phi:T^{v}E\oplus T^{h}E\to T^{v}E\oplus T^{h}E" display="block" intent=":literal"><semantics><mrow><mi mathvariant="normal">Φ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><msup><mi>T</mi><mi>v</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow><mo>⊕</mo><mrow><msup><mi>T</mi><mi>h</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow></mrow><mo stretchy="false">→</mo><mrow><mrow><msup><mi>T</mi><mi>v</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow><mo>⊕</mo><mrow><msup><mi>T</mi><mi>h</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Phi:T^{v}E\oplus T^{h}E\to T^{v}E\oplus T^{h}E</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.SSS2.p1.5" class="ltx_p">whose restriction at each <math id="S5.SS3.SSS2.p1.m12" class="ltx_Math" alttext="e\in E" display="inline" intent=":literal"><semantics><mrow><mi>e</mi><mo>∈</mo><mi>E</mi></mrow><annotation encoding="application/x-tex">e\in E</annotation></semantics></math> is</p>
<table id="S5.Ex126" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex126.m1" class="ltx_Math" alttext="\Phi(v,h)=(v,h+\Psi(e,h))." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mrow><mi>h</mi><mo>+</mo><mrow><mi mathvariant="normal">Ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo>,</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Phi(v,h)=(v,h+\Psi(e,h)).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.SSS2.p1.6" class="ltx_p">It is easy to check that</p>
<table id="S5.Ex127" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex127.m1" class="ltx_Math" alttext="\Phi^{-1}(v,h)=(v,h-\Psi(e,h))." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi mathvariant="normal">Φ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mrow><mi>h</mi><mo>−</mo><mrow><mi mathvariant="normal">Ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo>,</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Phi^{-1}(v,h)=(v,h-\Psi(e,h)).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.SSS2.p1.7" class="ltx_p">Define an almost complex structure on <math id="S5.SS3.SSS2.p1.m13" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> by</p>
<table id="S5.Ex128" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex128.m1" class="ltx_Math" alttext="J_{\Psi}^{E}=\Phi\circ J^{E}\circ\Phi^{-1}:TE\to TE." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>J</mi><mi mathvariant="normal">Ψ</mi><mi>E</mi></msubsup><mo>=</mo><mrow><mi mathvariant="normal">Φ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>J</mi><mi>E</mi></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi mathvariant="normal">Φ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow><mo stretchy="false">→</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">J_{\Psi}^{E}=\Phi\circ J^{E}\circ\Phi^{-1}:TE\to TE.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.SSS2.p1.8" class="ltx_p">More explicitly,</p>
<table id="S5.Ex129" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex129.m1" class="ltx_Math" alttext="J_{\Psi}^{E}(v,h)=(J^{E}v,J_{N}h+2\Psi(e,J_{N}h))." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>J</mi><mi mathvariant="normal">Ψ</mi><mi>E</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>h</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>J</mi><mi>E</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>,</mo><mrow><mrow><msub><mi>J</mi><mi>N</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Ψ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo>,</mo><mrow><msub><mi>J</mi><mi>N</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">J_{\Psi}^{E}(v,h)=(J^{E}v,J_{N}h+2\Psi(e,J_{N}h)).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S5.SS3.SSS2.p2" class="ltx_para">
<p id="S5.SS3.SSS2.p2.1" class="ltx_p">Now we consider the Cauchy–Riemann equation with respect to the sheared almost complex structure on the total space, with an additional Hamiltonian perturbation. Let <math id="S5.SS3.SSS2.p2.m1" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> be a Riemann surface with complex structure <math id="S5.SS3.SSS2.p2.m2" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>. Let <math id="S5.SS3.SSS2.p2.m3" class="ltx_Math" alttext="X\in\Omega^{0,1}(\Sigma,{\rm Vect}(N))" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>∈</mo><mrow><msup><mi mathvariant="normal">Ω</mi><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mrow><mi>Vect</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X\in\Omega^{0,1}(\Sigma,{\rm Vect}(N))</annotation></semantics></math> be a perturbation. The Hermitian connection on <math id="S5.SS3.SSS2.p2.m4" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> induces a horizontal lift of <math id="S5.SS3.SSS2.p2.m5" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> on the total space, denoted by <math id="S5.SS3.SSS2.p2.m6" class="ltx_Math" alttext="X^{E}" display="inline" intent=":literal"><semantics><msup><mi>X</mi><mi>E</mi></msup><annotation encoding="application/x-tex">X^{E}</annotation></semantics></math>. Then consider the Cauchy–Riemann equation for <math id="S5.SS3.SSS2.p2.m7" class="ltx_Math" alttext="\tilde{u}:\Sigma\to E" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mi>E</mi></mrow></mrow><annotation encoding="application/x-tex">\tilde{u}:\Sigma\to E</annotation></semantics></math></p>
<table id="S5.Ex130" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex130.m1" class="ltx_Math" alttext="\overline{\partial}_{J^{E}_{\Psi}}\tilde{u}+X^{E}(\tilde{u})=0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mover accent="true"><mo>∂</mo><mo stretchy="true">¯</mo></mover><msubsup><mi>J</mi><mi mathvariant="normal">Ψ</mi><mi>E</mi></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>u</mi><mo>~</mo></mover></mrow><mo>+</mo><mrow><msup><mi>X</mi><mi>E</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\overline{\partial}_{J^{E}_{\Psi}}\tilde{u}+X^{E}(\tilde{u})=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.SSS2.p2.2" class="ltx_p">If we write <math id="S5.SS3.SSS2.p2.m8" class="ltx_Math" alttext="\tilde{u}=(u,s)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{u}=(u,s)</annotation></semantics></math> where <math id="S5.SS3.SSS2.p2.m9" class="ltx_Math" alttext="u:\Sigma\to N" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mi>N</mi></mrow></mrow><annotation encoding="application/x-tex">u:\Sigma\to N</annotation></semantics></math> and <math id="S5.SS3.SSS2.p2.m10" class="ltx_Math" alttext="s\in\Gamma(u^{*}E)" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s\in\Gamma(u^{*}E)</annotation></semantics></math>, then with respect to the horizontal-vertical decomposition of <math id="S5.SS3.SSS2.p2.m11" class="ltx_Math" alttext="TE" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow><annotation encoding="application/x-tex">TE</annotation></semantics></math>, one has</p>
<table id="S5.Ex131" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex131.m1" class="ltx_Math" alttext="d\tilde{u}=du\oplus\nabla^{E}s" display="block" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>u</mi><mo>~</mo></mover></mrow><mo>=</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo>⊕</mo><mrow><msup><mo rspace="0.167em">∇</mo><mi>E</mi></msup><mi>s</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">d\tilde{u}=du\oplus\nabla^{E}s</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.SSS2.p2.3" class="ltx_p">and</p>
<table id="S5.Ex132" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex132.m1" class="ltx_Math" alttext="\begin{split}(d\tilde{u})^{0,1}_{J^{E}_{\Psi}}=&amp;\ \frac{1}{2}\left(du+J^{E}_{\Psi}\circ du\circ j\right)\oplus(\nabla^{E}s)^{0,1}\\
=&amp;\ \left(\overline{\partial}_{J_{N}}u+X(u)+\Psi(s,J_{N}\circ du\circ j)\right)\oplus(\nabla^{E}s)^{0,1}.\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><msubsup><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>u</mi><mo>~</mo></mover></mrow><mo stretchy="false">)</mo></mrow><msubsup><mi>J</mi><mi mathvariant="normal">Ψ</mi><mi>E</mi></msubsup><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msubsup><mo>=</mo><mphantom></mphantom></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo>+</mo><mrow><mrow><mrow><msubsup><mi>J</mi><mi mathvariant="normal">Ψ</mi><mi>E</mi></msubsup><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>j</mi></mrow></mrow><mo>)</mo></mrow></mrow><mo>⊕</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mo rspace="0.167em">∇</mo><mi>E</mi></msup><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mo>(</mo><mrow><mrow><msub><mover accent="true"><mo lspace="0em">∂</mo><mo stretchy="true">¯</mo></mover><msub><mi>J</mi><mi>N</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo>+</mo><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi mathvariant="normal">Ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mrow><mrow><mrow><msub><mi>J</mi><mi>N</mi></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo>⊕</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mo rspace="0.167em">∇</mo><mi>E</mi></msup><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msup></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}(d\tilde{u})^{0,1}_{J^{E}_{\Psi}}=&amp;\ \frac{1}{2}\left(du+J^{E}_{\Psi}\circ du\circ j\right)\oplus(\nabla^{E}s)^{0,1}\\
=&amp;\ \left(\overline{\partial}_{J_{N}}u+X(u)+\Psi(s,J_{N}\circ du\circ j)\right)\oplus(\nabla^{E}s)^{0,1}.\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S5.Thmthm37" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm37.2" class="ltx_text ltx_font_bold">Lemma 5.37</span></span><span id="S5.Thmthm37.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm37.p1" class="ltx_para">
<p id="S5.Thmthm37.p1.1" class="ltx_p"><cite class="ltx_cite ltx_citemacro_cite"><span id="S5.Thmthm37.p1.1.1" class="ltx_text ltx_font_italic">[</span><a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a><span id="S5.Thmthm37.p1.1.2" class="ltx_text ltx_font_italic">, Lemma 6.18]</span></cite><span id="S5.Thmthm37.p1.1.3" class="ltx_text ltx_font_italic"> Let <math id="S5.Thmthm37.p1.m1" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> be a Riemann surface with complex structure <math id="S5.Thmthm37.p1.m2" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> and <math id="S5.Thmthm37.p1.m3" class="ltx_Math" alttext="\tilde{u}=(u,s):\Sigma\to E" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>s</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mi>E</mi></mrow></mrow><annotation encoding="application/x-tex">\tilde{u}=(u,s):\Sigma\to E</annotation></semantics></math> be a smooth map. Then <math id="S5.Thmthm37.p1.m4" class="ltx_Math" alttext="\tilde{u}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>u</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{u}</annotation></semantics></math> corresonds to a smooth map <math id="S5.Thmthm37.p1.m5" class="ltx_Math" alttext="u:=\pi_{E}\circ\tilde{u}:\Sigma\to N" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>:=</mo><mrow><msub><mi>π</mi><mi>E</mi></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mover accent="true"><mi>u</mi><mo>~</mo></mover></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mi>N</mi></mrow></mrow><annotation encoding="application/x-tex">u:=\pi_{E}\circ\tilde{u}:\Sigma\to N</annotation></semantics></math> together with a section <math id="S5.Thmthm37.p1.m6" class="ltx_Math" alttext="s\in\Gamma(u^{*}E)" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s\in\Gamma(u^{*}E)</annotation></semantics></math>. Under this correspondence, <math id="S5.Thmthm37.p1.m7" class="ltx_Math" alttext="\tilde{u}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>u</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{u}</annotation></semantics></math> is <math id="S5.Thmthm37.p1.m8" class="ltx_Math" alttext="\tilde{J}_{\Psi}^{E}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>J</mi><mo>~</mo></mover><mi mathvariant="normal">Ψ</mi><mi>E</mi></msubsup><annotation encoding="application/x-tex">\tilde{J}_{\Psi}^{E}</annotation></semantics></math>-holomorphic if and only if <math id="S5.Thmthm37.p1.m9" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> is a holomorphic (with respect to the <math id="S5.Thmthm37.p1.m10" class="ltx_Math" alttext="(0,1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,1)</annotation></semantics></math>-part of <math id="S5.Thmthm37.p1.m11" class="ltx_Math" alttext="\nabla" display="inline" intent=":literal"><semantics><mo>∇</mo><annotation encoding="application/x-tex">\nabla</annotation></semantics></math>) and <math id="S5.Thmthm37.p1.m12" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> satisfies</span></p>
<table id="S5.Ex133" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex133.m1" class="ltx_Math" alttext="\overline{\partial}_{J_{N}}u+X(u)+\Psi(s,J_{N}\circ du\circ j)=0.\qed" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mover accent="true"><mo>∂</mo><mo stretchy="true">¯</mo></mover><msub><mi>J</mi><mi>N</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo>+</mo><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi mathvariant="normal">Ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mrow><mrow><mrow><msub><mi>J</mi><mi>N</mi></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em" rspace="0.0835em">.</mo><mo class="ltx_mathvariant_italic" lspace="0.0835em" mathvariant="italic" separator="true">∎</mo></mrow><annotation encoding="application/x-tex">\overline{\partial}_{J_{N}}u+X(u)+\Psi(s,J_{N}\circ du\circ j)=0.\qed</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S5.SS3.SSS2.p3" class="ltx_para ltx_noindent">
<p id="S5.SS3.SSS2.p3.1" class="ltx_p"><span id="S5.SS3.SSS2.p3.1.1" class="ltx_text ltx_font_italic">The geometric thickening revisited.</span>
Recall that one has the smooth quasiprojective variety <math id="S5.SS3.SSS2.p3.m1" class="ltx_Math" alttext="{\mathcal{C}}={\mathcal{C}}_{0,2}(d)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{C}}={\mathcal{C}}_{0,2}(d)</annotation></semantics></math>, which is the universal curve of a submanifold <math id="S5.SS3.SSS2.p3.m2" class="ltx_Math" alttext="{\mathcal{F}}={\mathcal{F}}_{0,2}(d)\subset\overline{\mathcal{M}}_{0,2}(\mathbb{CP}^{d},d)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}={\mathcal{F}}_{0,2}(d)\subset\overline{\mathcal{M}}_{0,2}(\mathbb{CP}^{d},d)</annotation></semantics></math> (after imposing the constraint at <math id="S5.SS3.SSS2.p3.m3" class="ltx_Math" alttext="z_{-}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mo>−</mo></msub><annotation encoding="application/x-tex">z_{-}</annotation></semantics></math> by the point <math id="S5.SS3.SSS2.p3.m4" class="ltx_Math" alttext="[1,0,\ldots,0]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[1,0,\ldots,0]</annotation></semantics></math>0. Denote by</p>
<table id="S5.Ex134" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex134.m1" class="ltx_Math" alttext="{\rm univ}:{\mathcal{C}}\to{\mathcal{F}}" display="block" intent=":literal"><semantics><mrow><mi>univ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo stretchy="false">→</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow></mrow><annotation encoding="application/x-tex">{\rm univ}:{\mathcal{C}}\to{\mathcal{F}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.SSS2.p3.2" class="ltx_p">the canonical holomorphic projection map. Also denote by</p>
<table id="S5.Ex135" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex135.m1" class="ltx_Math" alttext="{\rm ev}:{\mathcal{C}}\to\mathbb{CP}^{d}" display="block" intent=":literal"><semantics><mrow><mi>ev</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo stretchy="false">→</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">{\rm ev}:{\mathcal{C}}\to\mathbb{CP}^{d}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.SSS2.p3.3" class="ltx_p">the evaluation map. Consider the almost complex manifold</p>
<table id="S5.Ex136" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex136.m1" class="ltx_Math" alttext="N=M\times{\mathcal{C}}" display="block" intent=":literal"><semantics><mrow><mi>N</mi><mo>=</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow></mrow><annotation encoding="application/x-tex">N=M\times{\mathcal{C}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.SSS2.p3.4" class="ltx_p">equipped with the product almost complex structure <math id="S5.SS3.SSS2.p3.m5" class="ltx_Math" alttext="J_{N}=J_{M}\times J_{\mathcal{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>J</mi><mi>N</mi></msub><mo>=</mo><mrow><msub><mi>J</mi><mi>M</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>J</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub></mrow></mrow><annotation encoding="application/x-tex">J_{N}=J_{M}\times J_{\mathcal{C}}</annotation></semantics></math>. Using the projection <math id="S5.SS3.SSS2.p3.m6" class="ltx_Math" alttext="p_{M}:M\times{\mathcal{C}}\to M" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>M</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><mo stretchy="false">→</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">p_{M}:M\times{\mathcal{C}}\to M</annotation></semantics></math>, <math id="S5.SS3.SSS2.p3.m7" class="ltx_Math" alttext="p_{\mathcal{C}}:X\times{\mathcal{C}}\to{\mathcal{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>X</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><mo stretchy="false">→</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow></mrow><annotation encoding="application/x-tex">p_{\mathcal{C}}:X\times{\mathcal{C}}\to{\mathcal{C}}</annotation></semantics></math> and the evaluation map <math id="S5.SS3.SSS2.p3.m8" class="ltx_Math" alttext="{\rm ev}:{\mathcal{C}}\to\mathbb{CP}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>ev</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo stretchy="false">→</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">{\rm ev}:{\mathcal{C}}\to\mathbb{CP}^{d}</annotation></semantics></math>, define the vector bundles<span id="footnote16" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">16</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">16</sup>
                <span class="ltx_tag ltx_tag_note">16</span>
                
                
                
              Again, <math id="footnote16.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> is chosen to be sufficiently large so that they are vector bundles</span></span></span></p>
<table id="S5.Ex137" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex137.m1" class="ltx_Math" alttext="\begin{split}E^{0}(k):=&amp;\ \overline{\rm Hom}(({\rm ev}\circ p_{\mathcal{C}})^{*}T\mathbb{CP}^{d},p_{M}^{*}TM)\otimes({\rm ev}\circ p_{\mathcal{C}})^{*}{\mathcal{O}}(k),\\
E^{1}(k):=&amp;\ p_{\mathcal{C}}^{*}{\rm univ}^{*}({\rm univ}_{*}({\rm ev}^{*}{\mathcal{O}}(k)))_{0}.\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><msup><mi>E</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mphantom></mphantom></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mrow><mover accent="true"><mi>Hom</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ev</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>p</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><mo>,</mo><mrow><msubsup><mi>p</mi><mi>M</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>TM</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ev</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>p</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><msup><mi>E</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mphantom></mphantom></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msubsup><mi>p</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>univ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>univ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ev</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>0</mn></msub></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}E^{0}(k):=&amp;\ \overline{\rm Hom}(({\rm ev}\circ p_{\mathcal{C}})^{*}T\mathbb{CP}^{d},p_{M}^{*}TM)\otimes({\rm ev}\circ p_{\mathcal{C}})^{*}{\mathcal{O}}(k),\\
E^{1}(k):=&amp;\ p_{\mathcal{C}}^{*}{\rm univ}^{*}({\rm univ}_{*}({\rm ev}^{*}{\mathcal{O}}(k)))_{0}.\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.SSS2.p3.5" class="ltx_p">Here <math id="S5.SS3.SSS2.p3.m9" class="ltx_Math" alttext="({\rm univ}_{*}({\rm ev}^{*}{\mathcal{O}}(k)))_{0}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>univ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ev</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>0</mn></msub><annotation encoding="application/x-tex">({\rm univ}_{*}({\rm ev}^{*}{\mathcal{O}}(k)))_{0}</annotation></semantics></math> is the bundle whose fibers are fiberwise global sections of <math id="S5.SS3.SSS2.p3.m10" class="ltx_Math" alttext="{\rm ev}^{*}{\mathcal{O}}(k)" display="inline" intent=":literal"><semantics><mrow><msup><mi>ev</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\rm ev}^{*}{\mathcal{O}}(k)</annotation></semantics></math> which vanish at the two marked points. Define</p>
<table id="S5.E27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E27.m1" class="ltx_Math" alttext="E(k):=E^{0}(k)\otimes_{\mathbb{C}}\overline{E^{1}(k)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><msup><mi>E</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><msub><mo rspace="0.222em">⊗</mo><mi>ℂ</mi></msub><mover accent="true"><mrow><msup><mi>E</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="true">¯</mo></mover></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">E(k):=E^{0}(k)\otimes_{\mathbb{C}}\overline{E^{1}(k)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.27)</span></td></tr></tbody>
</table>
<p id="S5.SS3.SSS2.p3.6" class="ltx_p">Before talking about the shearing map we also need to specify a Hermitian metric and Hermitian connection on <math id="S5.SS3.SSS2.p3.m11" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>. From the definition we see that all factors of <math id="S5.SS3.SSS2.p3.m12" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> has a natural Hermitian metric and connection except the bundle <math id="S5.SS3.SSS2.p3.m13" class="ltx_Math" alttext="({\rm univ}_{*}({\rm ev}^{*}{\mathcal{O}}(k)))_{0}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>univ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ev</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>0</mn></msub><annotation encoding="application/x-tex">({\rm univ}_{*}({\rm ev}^{*}{\mathcal{O}}(k)))_{0}</annotation></semantics></math> which only has a complex structure but no canonical Hermitian structure. We choose an arbitrary one which then induces a Hermitian metric and a Hermitian connection on <math id="S5.SS3.SSS2.p3.m14" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>. This choice does not affect the structures we are going to construct. It is only an auxiliary object to be used to show regularity. The regularity is independent of the choices.</p>
</div>
<div id="S5.SS3.SSS2.p4" class="ltx_para">
<p id="S5.SS3.SSS2.p4.1" class="ltx_p">The shearing map <math id="S5.SS3.SSS2.p4.m1" class="ltx_Math" alttext="\Psi:E\oplus TN\to TN\cong p_{M}^{*}TM\oplus p_{\mathcal{C}}^{*}T{\mathcal{C}}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ψ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>E</mi><mo>⊕</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>≅</mo><mrow><mrow><msubsup><mi>p</mi><mi>M</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>⊕</mo><mrow><msubsup><mi>p</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Psi:E\oplus TN\to TN\cong p_{M}^{*}TM\oplus p_{\mathcal{C}}^{*}T{\mathcal{C}}</annotation></semantics></math> is defined to be</p>
<table id="S5.E28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E28.m1" class="ltx_Math" alttext="\Psi(\eta,v_{1},v_{2})=\langle\eta\rangle(v_{2})\oplus 0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi mathvariant="normal">Ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>η</mi><mo>,</mo><msub><mi>v</mi><mn>1</mn></msub><mo>,</mo><msub><mi>v</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">⟨</mo><mi>η</mi><mo stretchy="false">⟩</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Psi(\eta,v_{1},v_{2})=\langle\eta\rangle(v_{2})\oplus 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.28)</span></td></tr></tbody>
</table>
<p id="S5.SS3.SSS2.p4.2" class="ltx_p">Here the map <math id="S5.SS3.SSS2.p4.m2" class="ltx_Math" alttext="\langle\eta\rangle" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⟨</mo><mi>η</mi><mo stretchy="false">⟩</mo></mrow><annotation encoding="application/x-tex">\langle\eta\rangle</annotation></semantics></math> is defined at each point <math id="S5.SS3.SSS2.p4.m3" class="ltx_Math" alttext="y\in{\mathcal{C}}" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><annotation encoding="application/x-tex">y\in{\mathcal{C}}</annotation></semantics></math> (whose evaluation is <math id="S5.SS3.SSS2.p4.m4" class="ltx_Math" alttext="z\in\mathbb{CP}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>∈</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">z\in\mathbb{CP}^{d}</annotation></semantics></math>) with a fiber <math id="S5.SS3.SSS2.p4.m5" class="ltx_Math" alttext="{\mathcal{C}}_{y}\subset{\mathcal{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>y</mi></msub><mo>⊂</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><annotation encoding="application/x-tex">{\mathcal{C}}_{y}\subset{\mathcal{C}}</annotation></semantics></math> the pairing between <math id="S5.SS3.SSS2.p4.m6" class="ltx_Math" alttext="e\in{\mathcal{O}}(k)|_{z}" display="inline" intent=":literal"><semantics><mrow><mi>e</mi><mo>∈</mo><msub><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mi>z</mi></msub></mrow><annotation encoding="application/x-tex">e\in{\mathcal{O}}(k)|_{z}</annotation></semantics></math> and the value of <math id="S5.SS3.SSS2.p4.m7" class="ltx_Math" alttext="\zeta\in\overline{H^{0}({\mathcal{C}}_{y},{\rm ev}^{*}{\mathcal{O}}(k)|_{{\mathcal{C}}_{y}})_{0}}" display="inline" intent=":literal"><semantics><mrow><mi>ζ</mi><mo>∈</mo><mover accent="true"><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>y</mi></msub><mo>,</mo><msub><mrow><mrow><msup><mi>ev</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>y</mi></msub></msub><mo stretchy="false">)</mo></mrow><mn>0</mn></msub></mrow><mo stretchy="true">¯</mo></mover></mrow><annotation encoding="application/x-tex">\zeta\in\overline{H^{0}({\mathcal{C}}_{y},{\rm ev}^{*}{\mathcal{O}}(k)|_{{\mathcal{C}}_{y}})_{0}}</annotation></semantics></math> using the Hermitian metric on <math id="S5.SS3.SSS2.p4.m8" class="ltx_Math" alttext="{\mathcal{O}}(k)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{O}}(k)</annotation></semantics></math>, where we identify <math id="S5.SS3.SSS2.p4.m9" class="ltx_Math" alttext="H^{0}({\mathcal{C}}_{y},{\rm ev}^{*}{\mathcal{O}}(k)|_{{\mathcal{C}}_{y}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>y</mi></msub><mo>,</mo><msub><mrow><mrow><msup><mi>ev</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>y</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{0}({\mathcal{C}}_{y},{\rm ev}^{*}{\mathcal{O}}(k)|_{{\mathcal{C}}_{y}})</annotation></semantics></math> with the space of global holomorphic sections on the curve <math id="S5.SS3.SSS2.p4.m10" class="ltx_Math" alttext="{\mathcal{C}}_{y}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>y</mi></msub><annotation encoding="application/x-tex">{\mathcal{C}}_{y}</annotation></semantics></math>.</p>
</div>
<div id="S5.SS3.SSS2.p5" class="ltx_para ltx_noindent">
<p id="S5.SS3.SSS2.p5.1" class="ltx_p"><span id="S5.SS3.SSS2.p5.1.1" class="ltx_text ltx_font_italic">Lift the Hamiltonian.</span>
We need to lift the Hamiltonian vector field to the total space of <math id="S5.SS3.SSS2.p5.m1" class="ltx_Math" alttext="E=E(k)" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>=</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">E=E(k)</annotation></semantics></math>. Let <math id="S5.SS3.SSS2.p5.m2" class="ltx_Math" alttext="X_{H_{t}}\in\Gamma(TM)" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><msub><mi>H</mi><mi>t</mi></msub></msub><mo>∈</mo><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X_{H_{t}}\in\Gamma(TM)</annotation></semantics></math> be the time <math id="S5.SS3.SSS2.p5.m3" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> Hamiltonian vector field on <math id="S5.SS3.SSS2.p5.m4" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>. Then it pulls back to a vector field on <math id="S5.SS3.SSS2.p5.m5" class="ltx_Math" alttext="M\times{\mathcal{C}}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><annotation encoding="application/x-tex">M\times{\mathcal{C}}</annotation></semantics></math> which is zero in the <math id="S5.SS3.SSS2.p5.m6" class="ltx_Math" alttext="T{\mathcal{C}}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><annotation encoding="application/x-tex">T{\mathcal{C}}</annotation></semantics></math>-direction. On the other hand, the Hermitian connection on <math id="S5.SS3.SSS2.p5.m7" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> induces a horizontal-vertical decomposition of <math id="S5.SS3.SSS2.p5.m8" class="ltx_Math" alttext="TE" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow><annotation encoding="application/x-tex">TE</annotation></semantics></math>. By identifying the horizontal distribution with the pullback of the tangent bundle of the base, one can lift the vector field <math id="S5.SS3.SSS2.p5.m9" class="ltx_Math" alttext="X_{H_{t}}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><msub><mi>H</mi><mi>t</mi></msub></msub><annotation encoding="application/x-tex">X_{H_{t}}</annotation></semantics></math> to the total space <math id="S5.SS3.SSS2.p5.m10" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>, which is denoted by <math id="S5.SS3.SSS2.p5.m11" class="ltx_Math" alttext="\tilde{X}_{H_{t}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>X</mi><mo>~</mo></mover><msub><mi>H</mi><mi>t</mi></msub></msub><annotation encoding="application/x-tex">\tilde{X}_{H_{t}}</annotation></semantics></math>. Notice that by the definition of <math id="S5.SS3.SSS2.p5.m12" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> and the choice of the Hermitian connection <math id="S5.SS3.SSS2.p5.m13" class="ltx_Math" alttext="\nabla^{TM}" display="inline" intent=":literal"><semantics><msup><mo>∇</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msup><annotation encoding="application/x-tex">\nabla^{TM}</annotation></semantics></math>, all 1-periodic orbits in the total space of <math id="S5.SS3.SSS2.p5.m14" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> are contained in the zero section and are exactly the same as the 1-periodic orbits of the original Hamiltonian on <math id="S5.SS3.SSS2.p5.m15" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> multiplied by the additional factor <math id="S5.SS3.SSS2.p5.m16" class="ltx_Math" alttext="{\mathcal{C}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">{\mathcal{C}}</annotation></semantics></math>.</p>
</div>
<div id="S5.SS3.SSS2.p6" class="ltx_para ltx_noindent">
<p id="S5.SS3.SSS2.p6.1" class="ltx_p"><span id="S5.SS3.SSS2.p6.1.1" class="ltx_text ltx_font_italic">An alternative description of the thickened moduli space.</span></p>
</div>
<div id="S5.Thmthm38" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm38.2" class="ltx_text ltx_font_bold">Definition 5.38</span></span><span id="S5.Thmthm38.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm38.p1" class="ltx_para">
<p id="S5.Thmthm38.p1.1" class="ltx_p">Let <math id="S5.Thmthm38.p1.m1" class="ltx_Math" alttext="(\Sigma,{\bf L})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>𝐋</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Sigma,{\bf L})</annotation></semantics></math> be a prestable cylinder. A smooth map <math id="S5.Thmthm38.p1.m2" class="ltx_Math" alttext="\tilde{u}:\Sigma\to E" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mi>E</mi></mrow></mrow><annotation encoding="application/x-tex">\tilde{u}:\Sigma\to E</annotation></semantics></math> is called a <math id="S5.Thmthm38.p1.m3" class="ltx_Math" alttext="(\tilde{J}_{\Psi},H)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>J</mi><mo>~</mo></mover><mi mathvariant="normal">Ψ</mi></msub><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\tilde{J}_{\Psi},H)</annotation></semantics></math>-holomorphic map if it is <math id="S5.Thmthm38.p1.m4" class="ltx_Math" alttext="\tilde{J}_{\Psi}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>J</mi><mo>~</mo></mover><mi mathvariant="normal">Ψ</mi></msub><annotation encoding="application/x-tex">\tilde{J}_{\Psi}</annotation></semantics></math>-holomorphic on all sphere components and on each cylindrical components it satisfies the equation</p>
<table id="S5.E29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E29.m1" class="ltx_Math" alttext="\frac{\partial\tilde{u}}{\partial s}+\tilde{J}_{\Psi}\left(\frac{\partial\tilde{u}}{\partial t}-\tilde{X}_{H_{t}}(\tilde{u})\right)=0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mrow><mo>∂</mo><mover accent="true"><mi>u</mi><mo>~</mo></mover></mrow><mrow><mo>∂</mo><mi>s</mi></mrow></mfrac><mo>+</mo><mrow><msub><mover accent="true"><mi>J</mi><mo>~</mo></mover><mi mathvariant="normal">Ψ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><mrow><mo>∂</mo><mover accent="true"><mi>u</mi><mo>~</mo></mover></mrow><mrow><mo>∂</mo><mi>t</mi></mrow></mfrac><mo>−</mo><mrow><msub><mover accent="true"><mi>X</mi><mo>~</mo></mover><msub><mi>H</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\partial\tilde{u}}{\partial s}+\tilde{J}_{\Psi}\left(\frac{\partial\tilde{u}}{\partial t}-\tilde{X}_{H_{t}}(\tilde{u})\right)=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.29)</span></td></tr></tbody>
</table>
<p id="S5.Thmthm38.p1.2" class="ltx_p">(This is the same as (<a href="#S5.E24" title="In item 2 ‣ Definition 5.33 (Thickened moduli). ‣ 5.3.1. Description of the K-chart. ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.24</span></a>).)</p>
</div>
</div>
<div id="S5.SS3.SSS2.p7" class="ltx_para">
<p id="S5.SS3.SSS2.p7.1" class="ltx_p">Now we give another description of the thickened moduli space.</p>
</div>
<div id="S5.Thmthm39" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm39.2" class="ltx_text ltx_font_bold">Definition 5.39</span></span><span id="S5.Thmthm39.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm39.p1" class="ltx_para">
<p id="S5.Thmthm39.p1.1" class="ltx_p">Let <math id="S5.Thmthm39.p1.m1" class="ltx_Math" alttext="{\mathcal{M}}_{\tilde{J}_{\Psi},H}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><msub><mover accent="true"><mi>J</mi><mo>~</mo></mover><mi mathvariant="normal">Ψ</mi></msub><mo>,</mo><mi>H</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{M}}_{\tilde{J}_{\Psi},H}</annotation></semantics></math> be the moduli space of <math id="S5.Thmthm39.p1.m2" class="ltx_Math" alttext="(\tilde{J}_{\Psi},H)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>J</mi><mo>~</mo></mover><mi mathvariant="normal">Ψ</mi></msub><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\tilde{J}_{\Psi},H)</annotation></semantics></math>-holomorphic maps <math id="S5.Thmthm39.p1.m3" class="ltx_Math" alttext="\tilde{u}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>u</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{u}</annotation></semantics></math> from a prestable cylinder <math id="S5.Thmthm39.p1.m4" class="ltx_Math" alttext="(\Sigma,{\bf L})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>𝐋</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Sigma,{\bf L})</annotation></semantics></math> to the total space of <math id="S5.Thmthm39.p1.m5" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> satisfying the following conditions. Write the projection of <math id="S5.Thmthm39.p1.m6" class="ltx_Math" alttext="\tilde{u}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>u</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{u}</annotation></semantics></math> to the base of <math id="S5.Thmthm39.p1.m7" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>, which is <math id="S5.Thmthm39.p1.m8" class="ltx_Math" alttext="N=M\times{\mathcal{C}}" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>=</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow></mrow><annotation encoding="application/x-tex">N=M\times{\mathcal{C}}</annotation></semantics></math>, by <math id="S5.Thmthm39.p1.m9" class="ltx_Math" alttext="(u,\mu)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u,\mu)</annotation></semantics></math>.</p>
<ol id="S5.I20" class="ltx_enumerate">
<li id="S5.I20.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S5.I20.i1.p1" class="ltx_para">
<p id="S5.I20.i1.p1.1" class="ltx_p"><math id="S5.I20.i1.p1.m1" class="ltx_Math" alttext="\mu:\Sigma\to{\mathcal{C}}" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow></mrow><annotation encoding="application/x-tex">\mu:\Sigma\to{\mathcal{C}}</annotation></semantics></math> is a domain map, i.e., it is an isomorphism onto a fiber of <math id="S5.I20.i1.p1.m2" class="ltx_Math" alttext="{\mathcal{C}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">{\mathcal{C}}</annotation></semantics></math> which sends the marked points to the marked points.</p>
</div></li>
<li id="S5.I20.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S5.I20.i2.p1" class="ltx_para">
<p id="S5.I20.i2.p1.1" class="ltx_p"><math id="S5.I20.i2.p1.m1" class="ltx_Math" alttext="\tilde{u}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>u</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{u}</annotation></semantics></math> converges to periodic orbits of <math id="S5.I20.i2.p1.m2" class="ltx_Math" alttext="\tilde{X}_{H_{t}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>X</mi><mo>~</mo></mover><msub><mi>H</mi><mi>t</mi></msub></msub><annotation encoding="application/x-tex">\tilde{X}_{H_{t}}</annotation></semantics></math> at cylindrical nodes. Moreover, its projection onto <math id="S5.I20.i2.p1.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> has the same homotopy type as elements in <math id="S5.I20.i2.p1.m4" class="ltx_Math" alttext="\overline{\mathcal{M}}_{pq}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{pq}</annotation></semantics></math>.</p>
</div></li>
<li id="S5.I20.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S5.I20.i3.p1" class="ltx_para">
<p id="S5.I20.i3.p1.1" class="ltx_p">For each component <math id="S5.I20.i3.p1.m1" class="ltx_Math" alttext="\Sigma_{\alpha}\subset\Sigma" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mi>α</mi></msub><mo>⊂</mo><mi mathvariant="normal">Σ</mi></mrow><annotation encoding="application/x-tex">\Sigma_{\alpha}\subset\Sigma</annotation></semantics></math>, the degree of the restriction of the underlying map <math id="S5.I20.i3.p1.m2" class="ltx_Math" alttext="\underline{\smash{\mu}}:\Sigma\to\mathbb{CP}^{d}" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>μ</mi><mo stretchy="true">¯</mo></munder><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\underline{\smash{\mu}}:\Sigma\to\mathbb{CP}^{d}</annotation></semantics></math> is equal to the degree determined by the restriction <math id="S5.I20.i3.p1.m3" class="ltx_Math" alttext="u:\Sigma_{\alpha}\to M" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mi>α</mi></msub><mo stretchy="false">→</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">u:\Sigma_{\alpha}\to M</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
</div>
<div id="S5.SS3.SSS2.p8" class="ltx_para">
<p id="S5.SS3.SSS2.p8.1" class="ltx_p">Notice that there is also a <math id="S5.SS3.SSS2.p8.m1" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math>-action on <math id="S5.SS3.SSS2.p8.m2" class="ltx_Math" alttext="{\mathcal{M}}_{\tilde{J}_{\Psi},H}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><msub><mover accent="true"><mi>J</mi><mo>~</mo></mover><mi mathvariant="normal">Ψ</mi></msub><mo>,</mo><mi>H</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{M}}_{\tilde{J}_{\Psi},H}</annotation></semantics></math>.</p>
</div>
<div id="S5.SS3.SSS2.p9" class="ltx_para">
<p id="S5.SS3.SSS2.p9.1" class="ltx_p">Now we compare the thickened moduli space <math id="S5.SS3.SSS2.p9.m1" class="ltx_Math" alttext="V_{pq}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">V_{pq}</annotation></semantics></math> with <math id="S5.SS3.SSS2.p9.m2" class="ltx_Math" alttext="{\mathcal{M}}_{\tilde{J}_{\Psi},H}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><msub><mover accent="true"><mi>J</mi><mo>~</mo></mover><mi mathvariant="normal">Ψ</mi></msub><mo>,</mo><mi>H</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{M}}_{\tilde{J}_{\Psi},H}</annotation></semantics></math>. Indeed, given any point of <math id="S5.SS3.SSS2.p9.m3" class="ltx_Math" alttext="V_{pq}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">V_{pq}</annotation></semantics></math> represented by <math id="S5.SS3.SSS2.p9.m4" class="ltx_Math" alttext="(\Sigma,u,F,\eta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>F</mi><mo>,</mo><mi>η</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Sigma,u,F,\eta)</annotation></semantics></math>, we can identify it with a stable <math id="S5.SS3.SSS2.p9.m5" class="ltx_Math" alttext="(\tilde{J}_{\Psi},H)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>J</mi><mo>~</mo></mover><mi mathvariant="normal">Ψ</mi></msub><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\tilde{J}_{\Psi},H)</annotation></semantics></math>-holomorphic map <math id="S5.SS3.SSS2.p9.m6" class="ltx_Math" alttext="\tilde{u}=(u,\mu,\eta)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>μ</mi><mo>,</mo><mi>η</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{u}=(u,\mu,\eta)</annotation></semantics></math> where we just replace the frame <math id="S5.SS3.SSS2.p9.m7" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> by the induced map <math id="S5.SS3.SSS2.p9.m8" class="ltx_Math" alttext="\underline{\smash{\mu}}=\iota_{F}" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>μ</mi><mo stretchy="true">¯</mo></munder><mo>=</mo><msub><mi>ι</mi><mi>F</mi></msub></mrow><annotation encoding="application/x-tex">\underline{\smash{\mu}}=\iota_{F}</annotation></semantics></math>. This map is clearly well-defined and <math id="S5.SS3.SSS2.p9.m9" class="ltx_Math" alttext="G_{d}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>d</mi></msub><annotation encoding="application/x-tex">G_{d}</annotation></semantics></math>-equivariant.</p>
</div>
<div id="S5.Thmthm40" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm40.2" class="ltx_text ltx_font_bold">Lemma 5.40</span></span><span id="S5.Thmthm40.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm40.p1" class="ltx_para">
<p id="S5.Thmthm40.p1.1" class="ltx_p"><span id="S5.Thmthm40.p1.1.1" class="ltx_text ltx_font_italic">(cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>, Lemma 6.25]</cite> The natural map</span></p>
<table id="S5.Ex138" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex138.m1" class="ltx_Math" alttext="V_{pq}\to{\mathcal{M}}_{\tilde{J}_{\Psi},H}" display="block" intent=":literal"><semantics><mrow><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><msub><mover accent="true"><mi>J</mi><mo>~</mo></mover><mi mathvariant="normal">Ψ</mi></msub><mo>,</mo><mi>H</mi></mrow></msub></mrow><annotation encoding="application/x-tex">V_{pq}\to{\mathcal{M}}_{\tilde{J}_{\Psi},H}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmthm40.p1.2" class="ltx_p"><span id="S5.Thmthm40.p1.2.1" class="ltx_text ltx_font_italic">is an equivariant open embedding (of topological spaces).</span></p>
</div>
</div>
<div id="S5.SS3.SSS2.p10" class="ltx_para">
<p id="S5.SS3.SSS2.p10.1" class="ltx_p">∎</p>
</div>
<div id="S5.SS3.SSS2.p11" class="ltx_para">
<p id="S5.SS3.SSS2.p11.1" class="ltx_p">Therefore one can identify the obstruction bundle and the Kuranishi map as defined over the space <math id="S5.SS3.SSS2.p11.m1" class="ltx_Math" alttext="{\mathcal{M}}_{\tilde{J}_{\Psi},H}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><msub><mover accent="true"><mi>J</mi><mo>~</mo></mover><mi mathvariant="normal">Ψ</mi></msub><mo>,</mo><mi>H</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{M}}_{\tilde{J}_{\Psi},H}</annotation></semantics></math> after restricting to a <math id="S5.SS3.SSS2.p11.m2" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math>-invariant open subset.</p>
</div>
<div id="S5.SS3.SSS2.p12" class="ltx_para ltx_noindent">
<p id="S5.SS3.SSS2.p12.1" class="ltx_p"><span id="S5.SS3.SSS2.p12.1.1" class="ltx_text ltx_font_italic">Regularity.</span>
Remember that the thickened moduli space depends on a choice of an integer <math id="S5.SS3.SSS2.p12.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>. To emphasize the role of these integers, we temporarily denote</p>
<table id="S5.Ex139" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex139.m1" class="ltx_Math" alttext="{\mathcal{M}}_{\tilde{J}_{\Psi},H}={\mathcal{M}}_{\tilde{J}_{\Psi},H}(k)." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><msub><mover accent="true"><mi>J</mi><mo>~</mo></mover><mi mathvariant="normal">Ψ</mi></msub><mo>,</mo><mi>H</mi></mrow></msub><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><msub><mover accent="true"><mi>J</mi><mo>~</mo></mover><mi mathvariant="normal">Ψ</mi></msub><mo>,</mo><mi>H</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{M}}_{\tilde{J}_{\Psi},H}={\mathcal{M}}_{\tilde{J}_{\Psi},H}(k).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S5.Thmthm41" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm41.2" class="ltx_text ltx_font_bold">Theorem 5.41</span></span><span id="S5.Thmthm41.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm41.p1" class="ltx_para">
<p id="S5.Thmthm41.p1.1" class="ltx_p"><span id="S5.Thmthm41.p1.1.1" class="ltx_text ltx_font_italic">(cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>, Corollary 6.27]</cite>)
For a fixed <math id="S5.Thmthm41.p1.m1" class="ltx_Math" alttext="pq" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">pq</annotation></semantics></math>, there exists a positive integer <math id="S5.Thmthm41.p1.m2" class="ltx_Math" alttext="k_{pq}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>k</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">k_{pq}&gt;0</annotation></semantics></math> such that if <math id="S5.Thmthm41.p1.m3" class="ltx_Math" alttext="k\geq k_{pq}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><msub><mi>k</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">k\geq k_{pq}</annotation></semantics></math>, then each element of <math id="S5.Thmthm41.p1.m4" class="ltx_Math" alttext="S_{pq}^{-1}(0)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>S</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">S_{pq}^{-1}(0)</annotation></semantics></math> is a regular element of <math id="S5.Thmthm41.p1.m5" class="ltx_Math" alttext="{\mathcal{M}}_{\tilde{J}_{\Psi},H}(k)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><msub><mover accent="true"><mi>J</mi><mo>~</mo></mover><mi mathvariant="normal">Ψ</mi></msub><mo>,</mo><mi>H</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{M}}_{\tilde{J}_{\Psi},H}(k)</annotation></semantics></math>, i.e., the linearization of (<a href="#S5.E29" title="In Definition 5.38. ‣ 5.3.2. Transversality of the perturbed Floer equation ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.29</span></a>) is surjective.</span></p>
</div>
</div>
<div id="S5.SS3.SSS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.SS3.SSS2.p13" class="ltx_para">
<p id="S5.SS3.SSS2.p13.1" class="ltx_p"><span id="S5.SS3.SSS2.p13.1.1" class="ltx_text">Choose <math id="S5.SS3.SSS2.p13.m1" class="ltx_Math" alttext="x\in S_{pq}^{-1}(0)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><msubsup><mi>S</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x\in S_{pq}^{-1}(0)</annotation></semantics></math>. Notice that this element can be viewed as a representative of <math id="S5.SS3.SSS2.p13.m2" class="ltx_Math" alttext="{\mathcal{M}}_{\tilde{J}_{\Psi},H}(k)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><msub><mover accent="true"><mi>J</mi><mo>~</mo></mover><mi mathvariant="normal">Ψ</mi></msub><mo>,</mo><mi>H</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{M}}_{\tilde{J}_{\Psi},H}(k)</annotation></semantics></math> for all <math id="S5.SS3.SSS2.p13.m3" class="ltx_Math" alttext="k\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k\geq 1</annotation></semantics></math>. We will prove that for sufficiently large <math id="S5.SS3.SSS2.p13.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, <math id="S5.SS3.SSS2.p13.m5" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> is regular in <math id="S5.SS3.SSS2.p13.m6" class="ltx_Math" alttext="{\mathcal{M}}_{\tilde{J}_{\Psi},H}(k)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><msub><mover accent="true"><mi>J</mi><mo>~</mo></mover><mi mathvariant="normal">Ψ</mi></msub><mo>,</mo><mi>H</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{M}}_{\tilde{J}_{\Psi},H}(k)</annotation></semantics></math>. By compactness of the moduli space <math id="S5.SS3.SSS2.p13.m7" class="ltx_Math" alttext="\overline{\mathcal{M}}_{pq}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{pq}</annotation></semantics></math>, one can find a common large <math id="S5.SS3.SSS2.p13.m8" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> which regularizes all elements of <math id="S5.SS3.SSS2.p13.m9" class="ltx_Math" alttext="S_{pq}^{-1}(0)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>S</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">S_{pq}^{-1}(0)</annotation></semantics></math>.</span></p>
</div>
<div id="S5.SS3.SSS2.p14" class="ltx_para">
<p id="S5.SS3.SSS2.p14.1" class="ltx_p"><span id="S5.SS3.SSS2.p14.1.1" class="ltx_text">Suppose <math id="S5.SS3.SSS2.p14.m1" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> is represented by the framed cylinder <math id="S5.SS3.SSS2.p14.m2" class="ltx_Math" alttext="(\Sigma,u,F,0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>F</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Sigma,u,F,0)</annotation></semantics></math> where <math id="S5.SS3.SSS2.p14.m3" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> is a unitary frame of the line bundle <math id="S5.SS3.SSS2.p14.m4" class="ltx_Math" alttext="L_{u}\to\Sigma" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>u</mi></msub><mo stretchy="false">→</mo><mi mathvariant="normal">Σ</mi></mrow><annotation encoding="application/x-tex">L_{u}\to\Sigma</annotation></semantics></math> which is induced from the 2-form <math id="S5.SS3.SSS2.p14.m5" class="ltx_Math" alttext="\Omega_{u,H}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ω</mi><mrow><mi>u</mi><mo>,</mo><mi>H</mi></mrow></msub><annotation encoding="application/x-tex">\Omega_{u,H}</annotation></semantics></math> whose curvature form is equal to <math id="S5.SS3.SSS2.p14.m6" class="ltx_Math" alttext="-2\pi{\bm{i}}\Omega_{u,H}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒊</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Ω</mi><mrow><mi>u</mi><mo>,</mo><mi>H</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">-2\pi{\bm{i}}\Omega_{u,H}</annotation></semantics></math>. The existence of <math id="S5.SS3.SSS2.p14.m7" class="ltx_Math" alttext="L_{u}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>u</mi></msub><annotation encoding="application/x-tex">L_{u}</annotation></semantics></math> is guaranteed by Corollary <a href="#S5.Thmthm30" title="Corollary 5.30. ‣ 5.2.8. Abelian gauge theory on punctured spheres ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.30</span></a>. Abbreviate <math id="S5.SS3.SSS2.p14.m8" class="ltx_Math" alttext="d=d_{pq}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">d=d_{pq}</annotation></semantics></math>. Denote the frame <math id="S5.SS3.SSS2.p14.m9" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> by</span></p>
<table id="S5.Ex140" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex140.m1" class="ltx_Math" alttext="F:=(f_{0},\ldots,f_{d})." display="block" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>:=</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">F:=(f_{0},\ldots,f_{d}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.SSS2.p14.2" class="ltx_p"><span id="S5.SS3.SSS2.p14.2.1" class="ltx_text">Then the map</span></p>
<table id="S5.Ex141" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex141.m1" class="ltx_Math" alttext="\Sigma\to\mathbb{CP}^{d},\ z\mapsto[f_{0}(z),\ldots,f_{d}(z)]" display="block" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mi>z</mi><mo stretchy="false">↦</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>f</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>f</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Sigma\to\mathbb{CP}^{d},\ z\mapsto[f_{0}(z),\ldots,f_{d}(z)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.SSS2.p14.3" class="ltx_p"><span id="S5.SS3.SSS2.p14.3.1" class="ltx_text">represents an element in <math id="S5.SS3.SSS2.p14.m10" class="ltx_Math" alttext="{\mathcal{F}}_{0,2}(d)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{0,2}(d)</annotation></semantics></math>. Therefore, the unitary frame <math id="S5.SS3.SSS2.p14.m11" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> induces a domain map <math id="S5.SS3.SSS2.p14.m12" class="ltx_Math" alttext="\mu:\Sigma\to{\mathcal{C}}" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow></mrow><annotation encoding="application/x-tex">\mu:\Sigma\to{\mathcal{C}}</annotation></semantics></math>. Notice that this construction is independent of <math id="S5.SS3.SSS2.p14.m13" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>. Now for any <math id="S5.SS3.SSS2.p14.m14" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, denote <math id="S5.SS3.SSS2.p14.m15" class="ltx_Math" alttext="(u,\mu):\Sigma\to M\times{\mathcal{C}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>μ</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">(u,\mu):\Sigma\to M\times{\mathcal{C}}</annotation></semantics></math> which together with the inclusion map of the zero section of <math id="S5.SS3.SSS2.p14.m16" class="ltx_Math" alttext="u^{*}E(k)" display="inline" intent=":literal"><semantics><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">u^{*}E(k)</annotation></semantics></math> gives an element in <math id="S5.SS3.SSS2.p14.m17" class="ltx_Math" alttext="{\mathcal{M}}_{\tilde{J}_{\Psi},H}(k)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><msub><mover accent="true"><mi>J</mi><mo>~</mo></mover><mi mathvariant="normal">Ψ</mi></msub><mo>,</mo><mi>H</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{M}}_{\tilde{J}_{\Psi},H}(k)</annotation></semantics></math>.</span></p>
</div>
<div id="S5.SS3.SSS2.p15" class="ltx_para">
<p id="S5.SS3.SSS2.p15.1" class="ltx_p"><span id="S5.SS3.SSS2.p15.1.1" class="ltx_text">We would like to show that the linearization of Equation (<a href="#S5.E29" title="In Definition 5.38. ‣ 5.3.2. Transversality of the perturbed Floer equation ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.29</span></a>) at <math id="S5.SS3.SSS2.p15.m1" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> is surjective when <math id="S5.SS3.SSS2.p15.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> is sufficiently large. We only show its surjectivity over each component, while skipping the argument showing the surjectivity after imposing the matching conditions at nodes (which is the same as the case of pseudoholomorphic curves).</span></p>
</div>
<div id="S5.SS3.SSS2.p16" class="ltx_para">
<p id="S5.SS3.SSS2.p16.1" class="ltx_p"><span id="S5.SS3.SSS2.p16.1.1" class="ltx_text">Over each component <math id="S5.SS3.SSS2.p16.m1" class="ltx_Math" alttext="\Sigma_{\alpha}\subset\Sigma" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mi>α</mi></msub><mo>⊂</mo><mi mathvariant="normal">Σ</mi></mrow><annotation encoding="application/x-tex">\Sigma_{\alpha}\subset\Sigma</annotation></semantics></math>, the deformation space of the map <math id="S5.SS3.SSS2.p16.m2" class="ltx_Math" alttext="(u,\mu,0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>μ</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u,\mu,0)</annotation></semantics></math> splits as</span></p>
<table id="S5.Ex142" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex142.m1" class="ltx_Math" alttext="W^{1,p}(\Sigma_{\alpha},\mu^{*}T{\mathcal{C}})\oplus W^{1,p}(\Sigma_{\alpha},u^{*}TM)\oplus W^{1,p}(\Sigma_{\alpha},(u,\mu)^{*}E(k))" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>W</mi><mrow><mn>1</mn><mo>,</mo><mi>p</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>α</mi></msub><mo>,</mo><mrow><msup><mi>μ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mrow><msup><mi>W</mi><mrow><mn>1</mn><mo>,</mo><mi>p</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>α</mi></msub><mo>,</mo><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mrow><msup><mi>W</mi><mrow><mn>1</mn><mo>,</mo><mi>p</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>α</mi></msub><mo>,</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">W^{1,p}(\Sigma_{\alpha},\mu^{*}T{\mathcal{C}})\oplus W^{1,p}(\Sigma_{\alpha},u^{*}TM)\oplus W^{1,p}(\Sigma_{\alpha},(u,\mu)^{*}E(k))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.SSS2.p16.2" class="ltx_p"><span id="S5.SS3.SSS2.p16.2.1" class="ltx_text">and the linearization is of the block form</span></p>
<table id="S5.E30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E30.m1" class="ltx_Math" alttext="\left[\begin{array}[]{ccc}D_{\mu}&amp;0&amp;0\\
0&amp;D_{u}&amp;P\\
0&amp;0&amp;D_{E}\end{array}\right]" display="block" intent=":literal"><semantics><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd><msub><mi>D</mi><mi>μ</mi></msub></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><msub><mi>D</mi><mi>u</mi></msub></mtd><mtd><mi>P</mi></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><msub><mi>D</mi><mi>E</mi></msub></mtd></mtr></mtable><mo>]</mo></mrow><annotation encoding="application/x-tex">\left[\begin{array}[]{ccc}D_{\mu}&amp;0&amp;0\\
0&amp;D_{u}&amp;P\\
0&amp;0&amp;D_{E}\end{array}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.30)</span></td></tr></tbody>
</table>
<p id="S5.SS3.SSS2.p16.3" class="ltx_p"><span id="S5.SS3.SSS2.p16.3.1" class="ltx_text">where the diagonal terms are the standard linearization of the Cauchy–Riemann equation (with or without Hamiltonian perturbation term, depending on whether the component is spherical or cylindrical), and the off-diagonal term <math id="S5.SS3.SSS2.p16.m3" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> is the perturbation of the <math id="S5.SS3.SSS2.p16.m4" class="ltx_Math" alttext="TM" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">TM</annotation></semantics></math>-direction (i.e. the inhomogeneous term of (<a href="#S5.E24" title="In item 2 ‣ Definition 5.33 (Thickened moduli). ‣ 5.3.1. Description of the K-chart. ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.24</span></a>)). Notice that the operator <math id="S5.SS3.SSS2.p16.m5" class="ltx_Math" alttext="D_{\mu}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi>μ</mi></msub><annotation encoding="application/x-tex">D_{\mu}</annotation></semantics></math> is always surjective, reflecting the fact that domain maps to <math id="S5.SS3.SSS2.p16.m6" class="ltx_Math" alttext="{\mathcal{C}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">{\mathcal{C}}</annotation></semantics></math> are always unobstructed. This is a classical fact due to the “convexity” of the bundle <math id="S5.SS3.SSS2.p16.m7" class="ltx_Math" alttext="\mu^{*}T{\mathcal{C}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>μ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><annotation encoding="application/x-tex">\mu^{*}T{\mathcal{C}}</annotation></semantics></math>. Hence one only needs to consider the lower-right <math id="S5.SS3.SSS2.p16.m8" class="ltx_Math" alttext="2\times 2" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">2\times 2</annotation></semantics></math>-block.</span></p>
</div>
<div id="S5.SS3.SSS2.p17" class="ltx_para">
<p id="S5.SS3.SSS2.p17.1" class="ltx_p"><span id="S5.SS3.SSS2.p17.1.1" class="ltx_text">We first consider a spherical component <math id="S5.SS3.SSS2.p17.m1" class="ltx_Math" alttext="\Sigma_{\beta}\subset\Sigma" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><mo>⊂</mo><mi mathvariant="normal">Σ</mi></mrow><annotation encoding="application/x-tex">\Sigma_{\beta}\subset\Sigma</annotation></semantics></math> where the Hamiltonian perturbation term is zero. If <math id="S5.SS3.SSS2.p17.m2" class="ltx_Math" alttext="\Sigma_{\beta}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><annotation encoding="application/x-tex">\Sigma_{\beta}</annotation></semantics></math> has positive degree, then the line bundle <math id="S5.SS3.SSS2.p17.m3" class="ltx_Math" alttext="\underline{\smash{\mu}}^{*}{\mathcal{O}}(k)" display="inline" intent=":literal"><semantics><mrow><msup><munder accentunder="true"><mi>μ</mi><mo stretchy="true">¯</mo></munder><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\underline{\smash{\mu}}^{*}{\mathcal{O}}(k)</annotation></semantics></math> is a positive line bundle on this component. When <math id="S5.SS3.SSS2.p17.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> is sufficiently large, one can argue in the same way as the case of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>]</cite> to show that the linearized operator is surjective, even after restricting to the subspace where the values at nodes vanish. On the other hand, if <math id="S5.SS3.SSS2.p17.m5" class="ltx_Math" alttext="\Sigma_{\beta}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub><annotation encoding="application/x-tex">\Sigma_{\beta}</annotation></semantics></math> is a ghost component. Then <math id="S5.SS3.SSS2.p17.m6" class="ltx_Math" alttext="(u,\mu)^{*}E(k)|_{\Sigma_{\beta}}" display="inline" intent=":literal"><semantics><msub><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><msub><mi mathvariant="normal">Σ</mi><mi>β</mi></msub></msub><annotation encoding="application/x-tex">(u,\mu)^{*}E(k)|_{\Sigma_{\beta}}</annotation></semantics></math> is a trivial vector bundle equipped with the trivial Cauchy–Riemann operator. This is the same as the linearized operator in the <math id="S5.SS3.SSS2.p17.m7" class="ltx_Math" alttext="TM" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">TM</annotation></semantics></math>-direction. Hence the linear operator is surjective with kernels being constant sections.</span></p>
</div>
<div id="S5.SS3.SSS2.p18" class="ltx_para">
<p id="S5.SS3.SSS2.p18.1" class="ltx_p"><span id="S5.SS3.SSS2.p18.1.1" class="ltx_text">Second, we consider a cylindrical component <math id="S5.SS3.SSS2.p18.m1" class="ltx_Math" alttext="\Sigma_{\alpha}\subset\Sigma" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mi>α</mi></msub><mo>⊂</mo><mi mathvariant="normal">Σ</mi></mrow><annotation encoding="application/x-tex">\Sigma_{\alpha}\subset\Sigma</annotation></semantics></math>. We identify <math id="S5.SS3.SSS2.p18.m2" class="ltx_Math" alttext="\Sigma_{\alpha}\cong(-\infty,+\infty)\times S^{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Σ</mi><mi>α</mi></msub><mo>≅</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><mo>,</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><msup><mi>S</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\Sigma_{\alpha}\cong(-\infty,+\infty)\times S^{1}</annotation></semantics></math> with cylindrical coordinates <math id="S5.SS3.SSS2.p18.m3" class="ltx_Math" alttext="(s,t)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(s,t)</annotation></semantics></math>. Using the peak-section argument as in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>]</cite>, one can show that the <math id="S5.SS3.SSS2.p18.m4" class="ltx_Math" alttext="TM" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">TM</annotation></semantics></math>-direction is surjective. Hence we only need to show that the operator</span></p>
<table id="S5.Ex143" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex143.m1" class="ltx_Math" alttext="D_{E}:W^{1,p}((u,\mu)^{*}E(k))\to L^{p}(\Lambda^{0,1}\otimes(u,\mu)^{*}E(k))" display="block" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>E</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>W</mi><mrow><mn>1</mn><mo>,</mo><mi>p</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>L</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi mathvariant="normal">Λ</mi><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">D_{E}:W^{1,p}((u,\mu)^{*}E(k))\to L^{p}(\Lambda^{0,1}\otimes(u,\mu)^{*}E(k))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.SSS2.p18.2" class="ltx_p"><span id="S5.SS3.SSS2.p18.2.1" class="ltx_text">is surjective. When <math id="S5.SS3.SSS2.p18.m5" class="ltx_Math" alttext="\Sigma_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>α</mi></msub><annotation encoding="application/x-tex">\Sigma_{\alpha}</annotation></semantics></math> is a ghost component (i.e. a trivial cylinder), this surjectivity is obvious (its kernel is zero). When <math id="S5.SS3.SSS2.p18.m6" class="ltx_Math" alttext="\Sigma_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>α</mi></msub><annotation encoding="application/x-tex">\Sigma_{\alpha}</annotation></semantics></math> is not a ghost component, we need to use the positivity of <math id="S5.SS3.SSS2.p18.m7" class="ltx_Math" alttext="{\mathcal{O}}(k)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{O}}(k)</annotation></semantics></math>. One can show that the curvature of <math id="S5.SS3.SSS2.p18.m8" class="ltx_Math" alttext="(u,\mu)^{*}E(k)" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(u,\mu)^{*}E(k)</annotation></semantics></math> is everywhere positive when <math id="S5.SS3.SSS2.p18.m9" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> is sufficiently large. Indeed, for <math id="S5.SS3.SSS2.p18.m10" class="ltx_Math" alttext="S&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">S&gt;0</annotation></semantics></math> sufficiently large, <math id="S5.SS3.SSS2.p18.m11" class="ltx_math_unparsed" alttext="u((-\infty,-S]\cup[S,+\infty))" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi mathvariant="normal">∞</mi><mo rspace="0em">,</mo><mo lspace="0em">−</mo><mi>S</mi><mo stretchy="false">]</mo></mrow><mo>∪</mo><mrow><mo stretchy="false">[</mo><mi>S</mi><mo rspace="0em">,</mo><mo lspace="0em">+</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">u((-\infty,-S]\cup[S,+\infty))</annotation></semantics></math> is contained in a neighborhood of the union of periodic orbits where <math id="S5.SS3.SSS2.p18.m12" class="ltx_Math" alttext="\nabla^{TM}" display="inline" intent=":literal"><semantics><msup><mo>∇</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msup><annotation encoding="application/x-tex">\nabla^{TM}</annotation></semantics></math> is flat. Hence over the region where <math id="S5.SS3.SSS2.p18.m13" class="ltx_Math" alttext="|s|\geq S" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>s</mi><mo stretchy="false">|</mo></mrow><mo>≥</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">|s|\geq S</annotation></semantics></math>, the curvature of <math id="S5.SS3.SSS2.p18.m14" class="ltx_Math" alttext="(u,\mu)^{*}E(k)" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(u,\mu)^{*}E(k)</annotation></semantics></math> is pulled back from the universal curve <math id="S5.SS3.SSS2.p18.m15" class="ltx_Math" alttext="{\mathcal{C}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">{\mathcal{C}}</annotation></semantics></math>. Hence when <math id="S5.SS3.SSS2.p18.m16" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> is sufficiently large, the curvature is everywhere positive. Then by Lemma <a href="#S5.Thmthm42" title="Lemma 5.42. ‣ 5.3.2. Transversality of the perturbed Floer equation ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.42</span></a> below, <math id="S5.SS3.SSS2.p18.m17" class="ltx_Math" alttext="D_{E}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi>E</mi></msub><annotation encoding="application/x-tex">D_{E}</annotation></semantics></math> is surjective on this component.
∎</span></p>
</div>
</div>
<div id="S5.Thmthm42" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm42.2" class="ltx_text ltx_font_bold">Lemma 5.42</span></span><span id="S5.Thmthm42.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm42.p1" class="ltx_para">
<p id="S5.Thmthm42.p1.1" class="ltx_p"><span id="S5.Thmthm42.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S5.Thmthm42.p1.m1" class="ltx_Math" alttext="E\to\Theta" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo stretchy="false">→</mo><mi mathvariant="normal">Θ</mi></mrow><annotation encoding="application/x-tex">E\to\Theta</annotation></semantics></math> be a Hermitian vector bundle and <math id="S5.Thmthm42.p1.m2" class="ltx_Math" alttext="\nabla" display="inline" intent=":literal"><semantics><mo>∇</mo><annotation encoding="application/x-tex">\nabla</annotation></semantics></math> be a Hermitian connection on <math id="S5.Thmthm42.p1.m3" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> whose curvature form is everywhere positive definite and whose limiting holonomy has no eigenvalue <math id="S5.Thmthm42.p1.m4" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>. Then the Cauchy–Riemann operator</span></p>
<table id="S5.Ex144" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex144.m1" class="ltx_Math" alttext="\nabla^{0,1}:W^{1,p}(\Theta,E)\to L^{p}(\Theta,\Lambda^{0,1}\otimes E)" display="block" intent=":literal"><semantics><mrow><msup><mo>∇</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>W</mi><mrow><mn>1</mn><mo>,</mo><mi>p</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo>,</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>L</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo>,</mo><mrow><msup><mi mathvariant="normal">Λ</mi><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>E</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\nabla^{0,1}:W^{1,p}(\Theta,E)\to L^{p}(\Theta,\Lambda^{0,1}\otimes E)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmthm42.p1.2" class="ltx_p"><span id="S5.Thmthm42.p1.2.1" class="ltx_text ltx_font_italic">is surjective.</span></p>
</div>
</div>
<div id="S5.SS3.SSS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.SS3.SSS2.p19" class="ltx_para">
<p id="S5.SS3.SSS2.p19.1" class="ltx_p"><span id="S5.SS3.SSS2.p19.1.1" class="ltx_text">We prove by using the maximal principle. Suppose this is not the case. Then there exists <math id="S5.SS3.SSS2.p19.m1" class="ltx_Math" alttext="\xi" display="inline" intent=":literal"><semantics><mi>ξ</mi><annotation encoding="application/x-tex">\xi</annotation></semantics></math> in the kernel of the formal adjoint of <math id="S5.SS3.SSS2.p19.m2" class="ltx_Math" alttext="\nabla^{0,1}" display="inline" intent=":literal"><semantics><msup><mo>∇</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">\nabla^{0,1}</annotation></semantics></math>. Using the local coordinate <math id="S5.SS3.SSS2.p19.m3" class="ltx_Math" alttext="(s,t)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(s,t)</annotation></semantics></math> on <math id="S5.SS3.SSS2.p19.m4" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math> we write</span></p>
<table id="S5.Ex145" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex145.m1" class="ltx_Math" alttext="\nabla=d+\phi ds+\psi dt." display="block" intent=":literal"><semantics><mrow><mrow><mo>∇</mo><mo>=</mo><mrow><mi>d</mi><mo>+</mo><mrow><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>+</mo><mrow><mi>ψ</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\nabla=d+\phi ds+\psi dt.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.SSS2.p19.2" class="ltx_p"><span id="S5.SS3.SSS2.p19.2.1" class="ltx_text">Let the curvature form of <math id="S5.SS3.SSS2.p19.m5" class="ltx_Math" alttext="\nabla" display="inline" intent=":literal"><semantics><mo>∇</mo><annotation encoding="application/x-tex">\nabla</annotation></semantics></math> be <math id="S5.SS3.SSS2.p19.m6" class="ltx_Math" alttext="Qdsdt" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">Qdsdt</annotation></semantics></math>. Then one can identify <math id="S5.SS3.SSS2.p19.m7" class="ltx_Math" alttext="\nabla^{0,1}" display="inline" intent=":literal"><semantics><msup><mo>∇</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">\nabla^{0,1}</annotation></semantics></math> with the operator</span></p>
<table id="S5.Ex146" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex146.m1" class="ltx_Math" alttext="D^{0,1}=\left(\frac{\partial}{\partial s}+\phi\right)+{\bm{i}}\left(\frac{\partial}{\partial t}+\psi\right)." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>D</mi><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msup><mo>=</mo><mrow><mrow><mo>(</mo><mrow><mfrac><mo>∂</mo><mrow><mo>∂</mo><mi>s</mi></mrow></mfrac><mo>+</mo><mi>ϕ</mi></mrow><mo>)</mo></mrow><mo>+</mo><mrow><mi>𝒊</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mo>∂</mo><mrow><mo>∂</mo><mi>t</mi></mrow></mfrac><mo>+</mo><mi>ψ</mi></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">D^{0,1}=\left(\frac{\partial}{\partial s}+\phi\right)+{\bm{i}}\left(\frac{\partial}{\partial t}+\psi\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.SSS2.p19.3" class="ltx_p"><span id="S5.SS3.SSS2.p19.3.1" class="ltx_text">Then its formal adjoint is <math id="S5.SS3.SSS2.p19.m8" class="ltx_Math" alttext="-D^{1,0}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><msup><mi>D</mi><mrow><mn>1</mn><mo>,</mo><mn>0</mn></mrow></msup></mrow><annotation encoding="application/x-tex">-D^{1,0}</annotation></semantics></math>. As <math id="S5.SS3.SSS2.p19.m9" class="ltx_Math" alttext="\xi\in L^{q}" display="inline" intent=":literal"><semantics><mrow><mi>ξ</mi><mo>∈</mo><msup><mi>L</mi><mi>q</mi></msup></mrow><annotation encoding="application/x-tex">\xi\in L^{q}</annotation></semantics></math>, the function <math id="S5.SS3.SSS2.p19.m10" class="ltx_Math" alttext="|\xi|^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">|</mo><mi>ξ</mi><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">|\xi|^{2}</annotation></semantics></math> has a maximal point <math id="S5.SS3.SSS2.p19.m11" class="ltx_Math" alttext="z_{0}\in\Theta" display="inline" intent=":literal"><semantics><mrow><msub><mi>z</mi><mn>0</mn></msub><mo>∈</mo><mi mathvariant="normal">Θ</mi></mrow><annotation encoding="application/x-tex">z_{0}\in\Theta</annotation></semantics></math>. Then</span></p>
<table id="S5.Ex147" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex147.m1" class="ltx_Math" alttext="0\geq\Delta|\xi|^{2}=\frac{\partial}{\partial\overline{z}}\frac{\partial}{\partial z}|\xi|^{2}=|D^{0,1}\xi|^{2}+\langle\xi,D^{1,0}D^{0,1}\xi\rangle=|D^{0,1}\xi|^{2}+\langle\xi,Q\xi\rangle." display="block" intent=":literal"><semantics><mrow><mrow><mn>0</mn><mo>≥</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><mi>ξ</mi><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow><mo>=</mo><mrow><mfrac><mo>∂</mo><mrow><mo>∂</mo><mover accent="true"><mi>z</mi><mo stretchy="true">¯</mo></mover></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><mo>∂</mo><mrow><mo>∂</mo><mi>z</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><mi>ξ</mi><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">|</mo><mrow><msup><mi>D</mi><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo>+</mo><mrow><mo stretchy="false">⟨</mo><mrow><mi>ξ</mi><mo>,</mo><mrow><msup><mi>D</mi><mrow><mn>1</mn><mo>,</mo><mn>0</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">|</mo><mrow><msup><mi>D</mi><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo>+</mo><mrow><mo stretchy="false">⟨</mo><mrow><mi>ξ</mi><mo>,</mo><mrow><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">0\geq\Delta|\xi|^{2}=\frac{\partial}{\partial\overline{z}}\frac{\partial}{\partial z}|\xi|^{2}=|D^{0,1}\xi|^{2}+\langle\xi,D^{1,0}D^{0,1}\xi\rangle=|D^{0,1}\xi|^{2}+\langle\xi,Q\xi\rangle.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.SSS2.p19.4" class="ltx_p"><span id="S5.SS3.SSS2.p19.4.1" class="ltx_text">As <math id="S5.SS3.SSS2.p19.m12" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> is everywhere positive, this is a contradiction.
∎</span></p>
</div>
</div>
<div id="S5.Thmthm43" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm43.2" class="ltx_text ltx_font_bold">Lemma 5.43</span></span><span id="S5.Thmthm43.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm43.p1" class="ltx_para">
<p id="S5.Thmthm43.p1.1" class="ltx_p"><span id="S5.Thmthm43.p1.1.1" class="ltx_text ltx_font_italic">When <math id="S5.Thmthm43.p1.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> is sufficiently large, the curvature of the connection on <math id="S5.Thmthm43.p1.m2" class="ltx_Math" alttext="\overline{\rm Hom}(\iota_{F}^{*}T\mathbb{CP}^{d},u^{*}TM)\otimes\iota_{F}^{*}{\mathcal{O}}(k)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mi>Hom</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>ι</mi><mi mathvariant="normal">F</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">T</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi mathvariant="normal">d</mi></msup></mrow><mo>,</mo><mrow><msup><mi mathvariant="normal">u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>TM</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi>ι</mi><mi mathvariant="normal">F</mi><mo>∗</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\overline{\rm Hom}(\iota_{F}^{*}T\mathbb{CP}^{d},u^{*}TM)\otimes\iota_{F}^{*}{\mathcal{O}}(k)</annotation></semantics></math> is everywhere positive.</span></p>
</div>
</div>
<div id="S5.SS3.SSS2.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.SS3.SSS2.p20" class="ltx_para">
<p id="S5.SS3.SSS2.p20.1" class="ltx_p"><span id="S5.SS3.SSS2.p20.1.1" class="ltx_text">The curvature is the pullback of the curvatures on the corresponding bundles on the target <math id="S5.SS3.SSS2.p20.m1" class="ltx_Math" alttext="X\times\mathbb{CP}^{d}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>X</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>ℂ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">X\times\mathbb{CP}^{d}</annotation></semantics></math>. Notice that near <math id="S5.SS3.SSS2.p20.m2" class="ltx_Math" alttext="\pm\infty" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\pm\infty</annotation></semantics></math>, <math id="S5.SS3.SSS2.p20.m3" class="ltx_Math" alttext="u_{M}^{*}TM" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>u</mi><mi>M</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">u_{M}^{*}TM</annotation></semantics></math> is flat. Therefore, the positivity of the curvature of <math id="S5.SS3.SSS2.p20.m4" class="ltx_Math" alttext="{\mathcal{O}}(k)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{O}}(k)</annotation></semantics></math> implies that the positivity of the curvature of the induced connection on <math id="S5.SS3.SSS2.p20.m5" class="ltx_Math" alttext="\overline{\rm Hom}(\iota_{F}^{*}T\mathbb{CP}^{d},u^{*}TM)\otimes\iota_{F}^{*}{\mathcal{O}}(k)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mi>Hom</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>ι</mi><mi>F</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><mo>,</mo><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>TM</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi>ι</mi><mi>F</mi><mo>∗</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\overline{\rm Hom}(\iota_{F}^{*}T\mathbb{CP}^{d},u^{*}TM)\otimes\iota_{F}^{*}{\mathcal{O}}(k)</annotation></semantics></math> is everywhere positive for <math id="S5.SS3.SSS2.p20.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> sufficiently large, because such a claim is true for the corresponding vector bundles on the target <math id="S5.SS3.SSS2.p20.m7" class="ltx_Math" alttext="X\times\mathbb{CP}^{d}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>X</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>ℂ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">X\times\mathbb{CP}^{d}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="S5.SS3.SSS3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">5.3.3. </span>Multi-layered thickening</h4>

<div id="S5.SS3.SSS3.p1" class="ltx_para">
<p id="S5.SS3.SSS3.p1.1" class="ltx_p">In Floer theory we need to deal with many moduli spaces simultaneously, and it is important to make sure that various structures on different moduli spaces fit together in a coherent way. The expected relations between different moduli spaces then require us to consider a more complicated thickening procedure which is referred to as the <span id="S5.SS3.SSS3.p1.1.1" class="ltx_text ltx_font_bold">multi-layered thickening</span>. Namely, instead of just considering the perturbation induced from one single relatively ample bundle <math id="S5.SS3.SSS3.p1.m1" class="ltx_Math" alttext="\text{ev}^{*}{\mathcal{O}}(k)\to{\mathcal{C}}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mtext>ev</mtext><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><annotation encoding="application/x-tex">\text{ev}^{*}{\mathcal{O}}(k)\to{\mathcal{C}}</annotation></semantics></math>, we need to look at direct sum of such line bundles. This slight generalization of Abouzaid–McLean–Smith’s perturbation scheme will be used in the construction of the K-chart lift.</p>
</div>
<div id="S5.SS3.SSS3.p2" class="ltx_para">
<p id="S5.SS3.SSS3.p2.1" class="ltx_p">Fix a positive integer <math id="S5.SS3.SSS3.p2.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> and abbreviate <math id="S5.SS3.SSS3.p2.m2" class="ltx_Math" alttext="{\mathcal{C}}={\mathcal{C}}_{0,2}(d)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{C}}={\mathcal{C}}_{0,2}(d)</annotation></semantics></math>. Suppose we have a sequence of positive integers <math id="S5.SS3.SSS3.p2.m3" class="ltx_Math" alttext="k_{1}&lt;k_{2}&lt;\cdots&lt;k_{s}" display="inline" intent=":literal"><semantics><mrow><msub><mi>k</mi><mn>1</mn></msub><mo>&lt;</mo><msub><mi>k</mi><mn>2</mn></msub><mo rspace="0.1389em">&lt;</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">&lt;</mo><msub><mi>k</mi><mi>s</mi></msub></mrow><annotation encoding="application/x-tex">k_{1}&lt;k_{2}&lt;\cdots&lt;k_{s}</annotation></semantics></math>. We are going to define complex vector bundles inductively</p>
<table id="S5.Ex148" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex148.m1" class="ltx_Math" alttext="E_{1}^{\prime},E_{1},\ldots,E_{s}^{\prime},E_{s}\to M\times{\mathcal{C}}=M\times{\mathcal{C}}_{0,2}(d_{pq})." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>E</mi><mn>1</mn><mo>′</mo></msubsup><mo>,</mo><msub><mi>E</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>E</mi><mi>s</mi><mo>′</mo></msubsup><mo>,</mo><mrow><msub><mi>E</mi><mi>s</mi></msub><mo stretchy="false">→</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><mo>=</mo><mrow><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">E_{1}^{\prime},E_{1},\ldots,E_{s}^{\prime},E_{s}\to M\times{\mathcal{C}}=M\times{\mathcal{C}}_{0,2}(d_{pq}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.SSS3.p2.2" class="ltx_p">First, define</p>
<table id="S5.Ex149" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex149.m1" class="ltx_Math" alttext="E_{1}^{\prime}:=\overline{\rm Hom}(({\rm ev}\circ p_{\mathcal{C}})^{*}T\mathbb{CP}^{d},p_{M}^{*}TM)\otimes({\rm ev}\circ p_{\mathcal{C}})^{*}{\mathcal{O}}(k_{1})." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>E</mi><mn>1</mn><mo>′</mo></msubsup><mo>:=</mo><mrow><mrow><mrow><mover accent="true"><mi>Hom</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ev</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>p</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><mo>,</mo><mrow><msubsup><mi>p</mi><mi>M</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>TM</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ev</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>p</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">E_{1}^{\prime}:=\overline{\rm Hom}(({\rm ev}\circ p_{\mathcal{C}})^{*}T\mathbb{CP}^{d},p_{M}^{*}TM)\otimes({\rm ev}\circ p_{\mathcal{C}})^{*}{\mathcal{O}}(k_{1}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.SSS3.p2.3" class="ltx_p">and</p>
<table id="S5.Ex150" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex150.m1" class="ltx_Math" alttext="E_{1}:=E_{1}^{\prime}\otimes_{\mathbb{C}}\overline{{\rm univ}^{*}({\rm univ}_{*}{\rm ev}^{*}{\mathcal{O}}(k_{1}))_{0}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>E</mi><mn>1</mn></msub><mo>:=</mo><mrow><msubsup><mi>E</mi><mn>1</mn><mo>′</mo></msubsup><msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>ℂ</mi></msub><mover accent="true"><mrow><msup><mi>univ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>univ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>ev</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>0</mn></msub></mrow><mo stretchy="true">¯</mo></mover></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">E_{1}:=E_{1}^{\prime}\otimes_{\mathbb{C}}\overline{{\rm univ}^{*}({\rm univ}_{*}{\rm ev}^{*}{\mathcal{O}}(k_{1}))_{0}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.SSS3.p2.4" class="ltx_p">Inductively, suppose we have defined <math id="S5.SS3.SSS3.p2.m4" class="ltx_Math" alttext="E_{1}^{\prime},E_{1},\ldots,E_{i-1}^{\prime},E_{i-1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>E</mi><mn>1</mn><mo>′</mo></msubsup><mo>,</mo><msub><mi>E</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>E</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo>′</mo></msubsup><mo>,</mo><msub><mi>E</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">E_{1}^{\prime},E_{1},\ldots,E_{i-1}^{\prime},E_{i-1}</annotation></semantics></math>. Then define</p>
<table id="S5.Ex151" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex151.m1" class="ltx_Math" alttext="E_{i}^{\prime}:=\overline{\rm Hom}\Big(({\rm ev}\circ p_{\mathcal{C}})^{*}T\mathbb{CP}^{d},p_{M}^{*}TM\oplus\bigoplus_{j=1}^{i-1}E_{i}\Big)\otimes({\rm ev}\circ p_{\mathcal{C}})^{*}{\mathcal{O}}(k_{i})" display="block" intent=":literal"><semantics><mrow><msubsup><mi>E</mi><mi>i</mi><mo>′</mo></msubsup><mo>:=</mo><mrow><mrow><mrow><mover accent="true"><mi>Hom</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ev</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>p</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><mo>,</mo><mrow><mrow><msubsup><mi>p</mi><mi>M</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>TM</mi></mrow><mo rspace="0.055em">⊕</mo><mrow><munderover><mo movablelimits="false">⨁</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></munderover><msub><mi>E</mi><mi>i</mi></msub></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ev</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>p</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">E_{i}^{\prime}:=\overline{\rm Hom}\Big(({\rm ev}\circ p_{\mathcal{C}})^{*}T\mathbb{CP}^{d},p_{M}^{*}TM\oplus\bigoplus_{j=1}^{i-1}E_{i}\Big)\otimes({\rm ev}\circ p_{\mathcal{C}})^{*}{\mathcal{O}}(k_{i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.SSS3.p2.5" class="ltx_p">and</p>
<table id="S5.E31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E31.m1" class="ltx_Math" alttext="E_{i}:=E_{i}^{\prime}\otimes_{\mathbb{C}}\overline{{\rm univ}^{*}({\rm univ}_{*}{\rm ev}^{*}{\mathcal{O}}(k_{i}))_{0}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>E</mi><mi>i</mi></msub><mo>:=</mo><mrow><msubsup><mi>E</mi><mi>i</mi><mo>′</mo></msubsup><msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>ℂ</mi></msub><mover accent="true"><mrow><msup><mi>univ</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>univ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>ev</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>0</mn></msub></mrow><mo stretchy="true">¯</mo></mover></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">E_{i}:=E_{i}^{\prime}\otimes_{\mathbb{C}}\overline{{\rm univ}^{*}({\rm univ}_{*}{\rm ev}^{*}{\mathcal{O}}(k_{i}))_{0}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.31)</span></td></tr></tbody>
</table>
<p id="S5.SS3.SSS3.p2.6" class="ltx_p">Notice that once <math id="S5.SS3.SSS3.p2.m5" class="ltx_Math" alttext="TM" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">TM</annotation></semantics></math> is equipped with a Hermitian connection (and hence a Cauchy–Riemann operator). Together with the holomorphic structure of the involved bundles over <math id="S5.SS3.SSS3.p2.m6" class="ltx_Math" alttext="{\mathcal{C}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">{\mathcal{C}}</annotation></semantics></math>, the connection on <math id="S5.SS3.SSS3.p2.m7" class="ltx_Math" alttext="TM" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">TM</annotation></semantics></math> induces a Cauchy–Riemann operator on <math id="S5.SS3.SSS3.p2.m8" class="ltx_Math" alttext="E_{i}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>i</mi></msub><annotation encoding="application/x-tex">E_{i}</annotation></semantics></math>.</p>
</div>
<div id="S5.Thmthm44" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm44.2" class="ltx_text ltx_font_italic">Remark 5.44</span></span><span id="S5.Thmthm44.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S5.Thmthm44.p1" class="ltx_para">
<p id="S5.Thmthm44.p1.1" class="ltx_p">We explain the above construction for the simplest nontrivial example <math id="S5.Thmthm44.p1.m1" class="ltx_Math" alttext="E_{2}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mn>2</mn></msub><annotation encoding="application/x-tex">E_{2}</annotation></semantics></math>. The total space of <math id="S5.Thmthm44.p1.m2" class="ltx_Math" alttext="E_{1}\to M\times{\mathcal{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mn>1</mn></msub><mo stretchy="false">→</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow></mrow><annotation encoding="application/x-tex">E_{1}\to M\times{\mathcal{C}}</annotation></semantics></math> is an almost complex manifold which has a projection <math id="S5.Thmthm44.p1.m3" class="ltx_Math" alttext="p_{\mathcal{C}}:E_{1}\to{\mathcal{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>E</mi><mn>1</mn></msub><mo stretchy="false">→</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow></mrow><annotation encoding="application/x-tex">p_{\mathcal{C}}:E_{1}\to{\mathcal{C}}</annotation></semantics></math>. The goal is to construct certain perturbations of a (perturbed) <math id="S5.Thmthm44.p1.m4" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math>-holomorphic map
<math id="S5.Thmthm44.p1.m5" class="ltx_Math" alttext="u:\Sigma\to E_{1}" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><msub><mi>E</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">u:\Sigma\to E_{1}</annotation></semantics></math>
such that <math id="S5.Thmthm44.p1.m6" class="ltx_Math" alttext="p_{\mathcal{C}}\circ u:\Sigma\to{\mathcal{C}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>p</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>u</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow></mrow><annotation encoding="application/x-tex">p_{\mathcal{C}}\circ u:\Sigma\to{\mathcal{C}}</annotation></semantics></math> is a domain map, which in particular is holomorphic. Note that</p>
<table id="S5.Ex152" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex152.m1" class="ltx_Math" alttext="(du)^{0,1}_{J}\in\overline{\rm Hom}(T\Sigma,u^{*}TE_{1})=\overline{\rm Hom}(T\Sigma,u^{*}TM\oplus u^{*}T{\mathcal{C}}\oplus u^{*}E_{1})," display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow><mi>J</mi><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msubsup><mo>∈</mo><mrow><mover accent="true"><mi>Hom</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Σ</mi></mrow><mo>,</mo><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>TE</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mover accent="true"><mi>Hom</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Σ</mi></mrow><mo>,</mo><mrow><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>TM</mi></mrow><mo>⊕</mo><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><mo>⊕</mo><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mn>1</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">(du)^{0,1}_{J}\in\overline{\rm Hom}(T\Sigma,u^{*}TE_{1})=\overline{\rm Hom}(T\Sigma,u^{*}TM\oplus u^{*}T{\mathcal{C}}\oplus u^{*}E_{1}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmthm44.p1.2" class="ltx_p">where the equality is induced from a Hermitian connection on <math id="S5.Thmthm44.p1.m7" class="ltx_Math" alttext="E_{1}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mn>1</mn></msub><annotation encoding="application/x-tex">E_{1}</annotation></semantics></math>. Therefore, to keep the map <math id="S5.Thmthm44.p1.m8" class="ltx_Math" alttext="p_{\mathcal{C}}\circ u" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi class="ltx_font_mathcaligraphic">𝒞</mi></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>u</mi></mrow><annotation encoding="application/x-tex">p_{\mathcal{C}}\circ u</annotation></semantics></math> being a domain map, the perturbation should take value in <math id="S5.Thmthm44.p1.m9" class="ltx_Math" alttext="\overline{\rm Hom}(T\Sigma,u^{*}TM\oplus u^{*}E_{1})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>Hom</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Σ</mi></mrow><mo>,</mo><mrow><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>TM</mi></mrow><mo>⊕</mo><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mn>1</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\overline{\rm Hom}(T\Sigma,u^{*}TM\oplus u^{*}E_{1})</annotation></semantics></math>. The vector bundle <math id="S5.Thmthm44.p1.m10" class="ltx_Math" alttext="E_{2}\to M\times{\mathcal{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mn>2</mn></msub><mo stretchy="false">→</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow></mrow><annotation encoding="application/x-tex">E_{2}\to M\times{\mathcal{C}}</annotation></semantics></math> is constructed just as the construction of <math id="S5.Thmthm44.p1.m11" class="ltx_Math" alttext="E_{1}\to M\times{\mathcal{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mn>1</mn></msub><mo stretchy="false">→</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow></mrow><annotation encoding="application/x-tex">E_{1}\to M\times{\mathcal{C}}</annotation></semantics></math> in order to host an equation of the form (<a href="#S5.E24" title="In item 2 ‣ Definition 5.33 (Thickened moduli). ‣ 5.3.1. Description of the K-chart. ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.24</span></a>), with the assistance of the relatively ample line bundle <math id="S5.Thmthm44.p1.m12" class="ltx_Math" alttext="{\rm ev}^{*}{\mathcal{O}}(k_{2})\to{\mathcal{C}}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>ev</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><annotation encoding="application/x-tex">{\rm ev}^{*}{\mathcal{O}}(k_{2})\to{\mathcal{C}}</annotation></semantics></math>.</p>
</div>
</div>
<div id="S5.Thmthm45" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm45.2" class="ltx_text ltx_font_bold">Definition 5.45</span></span><span id="S5.Thmthm45.3" class="ltx_text ltx_font_bold"> </span>(Multi-layered thickening)<span id="S5.Thmthm45.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm45.p1" class="ltx_para">
<p id="S5.Thmthm45.p1.1" class="ltx_p">For any pair <math id="S5.Thmthm45.p1.m1" class="ltx_Math" alttext="p,q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p,q</annotation></semantics></math> of capped periodic orbits, denote <math id="S5.Thmthm45.p1.m2" class="ltx_Math" alttext="d=d_{pq}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">d=d_{pq}</annotation></semantics></math>. Let <math id="S5.Thmthm45.p1.m3" class="ltx_Math" alttext="V_{pq}^{d}=V_{pq}(k_{1},\ldots,k_{d})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>d</mi></msubsup><mo>=</mo><mrow><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>k</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">V_{pq}^{d}=V_{pq}(k_{1},\ldots,k_{d})</annotation></semantics></math> be the moduli space of tuples</p>
<table id="S5.Ex153" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex153.m1" class="ltx_Math" alttext="(\Sigma,u,F,\eta_{1},\ldots,\eta_{d})" display="block" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>F</mi><mo>,</mo><msub><mi>η</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>η</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Sigma,u,F,\eta_{1},\ldots,\eta_{d})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmthm45.p1.2" class="ltx_p">where <math id="S5.Thmthm45.p1.m4" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> is a prestable cylinder, <math id="S5.Thmthm45.p1.m5" class="ltx_Math" alttext="u:\Sigma\to M" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">u:\Sigma\to M</annotation></semantics></math> is a smooth map with topological energy <math id="S5.Thmthm45.p1.m6" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> converging to <math id="S5.Thmthm45.p1.m7" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> and <math id="S5.Thmthm45.p1.m8" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> at the two marked points, <math id="S5.Thmthm45.p1.m9" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> is a frame of the line bundle <math id="S5.Thmthm45.p1.m10" class="ltx_Math" alttext="L_{u,\Omega,H}\to\Sigma" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mrow><mi>u</mi><mo>,</mo><mi mathvariant="normal">Ω</mi><mo>,</mo><mi>H</mi></mrow></msub><mo stretchy="false">→</mo><mi mathvariant="normal">Σ</mi></mrow><annotation encoding="application/x-tex">L_{u,\Omega,H}\to\Sigma</annotation></semantics></math> inducing a holomorphic map <math id="S5.Thmthm45.p1.m11" class="ltx_Math" alttext="\iota_{F}:\Sigma\to\mathbb{CP}^{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ι</mi><mi>F</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\iota_{F}:\Sigma\to\mathbb{CP}^{d}</annotation></semantics></math> such that the framing <math id="S5.Thmthm45.p1.m12" class="ltx_Math" alttext="F=(f_{0},\dots,f_{d})" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F=(f_{0},\dots,f_{d})</annotation></semantics></math> satisfies <math id="S5.Thmthm45.p1.m13" class="ltx_math_unparsed" alttext="[f_{0}(z_{-}):\cdots:f_{d}(z_{-})]=[1:0:\cdots:0]" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><msub><mi>f</mi><mn>0</mn></msub><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mo>−</mo></msub><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo>:</mo><mo lspace="0.111em">⋯</mo><mo rspace="0.278em">:</mo><msub><mi>f</mi><mi>d</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>=</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>0</mn><mo lspace="0.278em">:</mo><mo lspace="0.111em">⋯</mo><mo rspace="0.278em">:</mo><mn>0</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">[f_{0}(z_{-}):\cdots:f_{d}(z_{-})]=[1:0:\cdots:0]</annotation></semantics></math>, and the corresponding domain map <math id="S5.Thmthm45.p1.m14" class="ltx_Math" alttext="\tilde{\iota}_{F}:\Sigma\to{\mathcal{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ι</mi><mo>~</mo></mover><mi>F</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow></mrow><annotation encoding="application/x-tex">\tilde{\iota}_{F}:\Sigma\to{\mathcal{C}}</annotation></semantics></math>, and (denoting by <math id="S5.Thmthm45.p1.m15" class="ltx_Math" alttext="\tilde{u}=(u,\tilde{\iota}_{F}):\Sigma\to M\times{\mathcal{C}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><msub><mover accent="true"><mi>ι</mi><mo>~</mo></mover><mi>F</mi></msub><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{u}=(u,\tilde{\iota}_{F}):\Sigma\to M\times{\mathcal{C}}</annotation></semantics></math>)</p>
<table id="S5.Ex154" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex154.m1" class="ltx_Math" alttext="\eta_{i}\in\tilde{u}^{*}E_{i}=\Gamma\left(\overline{\rm Hom}\big(\iota_{F}^{*}T\mathbb{CP}^{d},u^{*}TM\oplus\bigoplus_{j=1}^{i-1}\tilde{u}^{*}E_{j}\big)\otimes\iota_{F}^{*}{\mathcal{O}}(k_{i})\right)\otimes\overline{H^{0}(\iota_{F}^{*}{\mathcal{O}}(k_{i}))_{0}}" display="block" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>i</mi></msub><mo>∈</mo><mrow><msup><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mi>i</mi></msub></mrow><mo>=</mo><mrow><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mrow><mover accent="true"><mi>Hom</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mi>ι</mi><mi>F</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><mo>,</mo><mrow><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>TM</mi></mrow><mo rspace="0.055em">⊕</mo><mrow><munderover><mo movablelimits="false">⨁</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><msup><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mi>j</mi></msub></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi>ι</mi><mi>F</mi><mo>∗</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mover accent="true"><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>ι</mi><mi>F</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>0</mn></msub></mrow><mo stretchy="true">¯</mo></mover></mrow></mrow><annotation encoding="application/x-tex">\eta_{i}\in\tilde{u}^{*}E_{i}=\Gamma\left(\overline{\rm Hom}\big(\iota_{F}^{*}T\mathbb{CP}^{d},u^{*}TM\oplus\bigoplus_{j=1}^{i-1}\tilde{u}^{*}E_{j}\big)\otimes\iota_{F}^{*}{\mathcal{O}}(k_{i})\right)\otimes\overline{H^{0}(\iota_{F}^{*}{\mathcal{O}}(k_{i}))_{0}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmthm45.p1.3" class="ltx_p">satisfying the following equations</p>
<table id="S5.E32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E32.m1" class="ltx_math_unparsed" alttext="\left\{\begin{aligned} \overline{\partial}_{J,H}u+\pi_{u^{*}TM}\left(\sum_{i=1}^{d}\langle\eta_{i}\rangle\circ d\iota_{F}\right)&amp;\ =0,\\
\overline{\partial}\eta_{i}+\pi_{E_{i}}\left(\sum_{j=i+1}^{d}\langle\eta_{j}\rangle\circ d\iota_{F}\right)&amp;\ =0,\ i=1,\ldots,d.\end{aligned}\right." display="block" intent=":literal"><semantics><mrow><mo>{</mo><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><msub><mover accent="true"><mo>∂</mo><mo stretchy="true">¯</mo></mover><mrow><mi>J</mi><mo>,</mo><mi>H</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo>+</mo><mrow><msub><mi>π</mi><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><munderover><mo lspace="0em" movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><mrow><mo stretchy="false">⟨</mo><msub><mi>η</mi><mi>i</mi></msub><mo rspace="0.055em" stretchy="false">⟩</mo></mrow></mrow><mo rspace="0.222em">∘</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ι</mi><mi>F</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo lspace="0.778em">=</mo><mn>0</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mover accent="true"><mo>∂</mo><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>i</mi></msub></mrow><mo>+</mo><mrow><msub><mi>π</mi><msub><mi>E</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><munderover><mo lspace="0em" movablelimits="false" rspace="0em">∑</mo><mrow><mi>j</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>d</mi></munderover><mrow><mo stretchy="false">⟨</mo><msub><mi>η</mi><mi>j</mi></msub><mo rspace="0.055em" stretchy="false">⟩</mo></mrow></mrow><mo rspace="0.222em">∘</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ι</mi><mi>F</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>=</mo><mn>0</mn><mo rspace="0.667em">,</mo><mi>i</mi><mo>=</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>d</mi><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow><annotation encoding="application/x-tex">\left\{\begin{aligned} \overline{\partial}_{J,H}u+\pi_{u^{*}TM}\left(\sum_{i=1}^{d}\langle\eta_{i}\rangle\circ d\iota_{F}\right)&amp;\ =0,\\
\overline{\partial}\eta_{i}+\pi_{E_{i}}\left(\sum_{j=i+1}^{d}\langle\eta_{j}\rangle\circ d\iota_{F}\right)&amp;\ =0,\ i=1,\ldots,d.\end{aligned}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.32)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="S5.Thmthm46" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm46.2" class="ltx_text ltx_font_italic">Remark 5.46</span></span><span id="S5.Thmthm46.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S5.Thmthm46.p1" class="ltx_para">
<p id="S5.Thmthm46.p1.1" class="ltx_p">Continuing Remark <a href="#S5.Thmthm44" title="Remark 5.44. ‣ 5.3.3. Multi-layered thickening ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.44</span></a>, we explain the origin of the above equations for <math id="S5.Thmthm46.p1.m1" class="ltx_Math" alttext="d=2" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">d=2</annotation></semantics></math>. Note that the pair <math id="S5.Thmthm46.p1.m2" class="ltx_Math" alttext="(\tilde{u},\eta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo>,</mo><mi>η</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\tilde{u},\eta)</annotation></semantics></math> defines a smooth map <math id="S5.Thmthm46.p1.m3" class="ltx_Math" alttext="\tilde{u}_{1}:\Sigma\to E_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>u</mi><mo>~</mo></mover><mn>1</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><msub><mi>E</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\tilde{u}_{1}:\Sigma\to E_{1}</annotation></semantics></math>. The purpose is to write down a perturbation of certain <math id="S5.Thmthm46.p1.m4" class="ltx_Math" alttext="\overline{\partial}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>∂</mo><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{\partial}</annotation></semantics></math>-equation for <math id="S5.Thmthm46.p1.m5" class="ltx_Math" alttext="\tilde{u}_{1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>u</mi><mo>~</mo></mover><mn>1</mn></msub><annotation encoding="application/x-tex">\tilde{u}_{1}</annotation></semantics></math> using a section of <math id="S5.Thmthm46.p1.m6" class="ltx_Math" alttext="\eta_{2}\in\tilde{u}^{*}E_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mn>2</mn></msub><mo>∈</mo><mrow><msup><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\eta_{2}\in\tilde{u}^{*}E_{2}</annotation></semantics></math>, which could be schematically written as</p>
<table id="S5.Ex155" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex155.m1" class="ltx_Math" alttext="\overline{\partial}_{\tilde{J}_{\Psi},H}u_{1}+\langle\eta_{2}\rangle\circ d\iota_{F}=0," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mover accent="true"><mo>∂</mo><mo stretchy="true">¯</mo></mover><mrow><msub><mover accent="true"><mi>J</mi><mo>~</mo></mover><mi mathvariant="normal">Ψ</mi></msub><mo>,</mo><mi>H</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><mrow><mrow><mo stretchy="false">⟨</mo><msub><mi>η</mi><mn>2</mn></msub><mo rspace="0.055em" stretchy="false">⟩</mo></mrow><mo rspace="0.222em">∘</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ι</mi><mi>F</mi></msub></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\overline{\partial}_{\tilde{J}_{\Psi},H}u_{1}+\langle\eta_{2}\rangle\circ d\iota_{F}=0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmthm46.p1.2" class="ltx_p">where <math id="S5.Thmthm46.p1.m7" class="ltx_Math" alttext="\tilde{J}_{\Psi}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>J</mi><mo>~</mo></mover><mi mathvariant="normal">Ψ</mi></msub><annotation encoding="application/x-tex">\tilde{J}_{\Psi}</annotation></semantics></math> is the sheared almost complex structure constructed using (<a href="#S5.E28" title="In 5.3.2. Transversality of the perturbed Floer equation ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.28</span></a>) and <math id="S5.Thmthm46.p1.m8" class="ltx_Math" alttext="u_{1}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mn>1</mn></msub><annotation encoding="application/x-tex">u_{1}</annotation></semantics></math> is obtained from <math id="S5.Thmthm46.p1.m9" class="ltx_Math" alttext="\tilde{u}_{1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>u</mi><mo>~</mo></mover><mn>1</mn></msub><annotation encoding="application/x-tex">\tilde{u}_{1}</annotation></semantics></math> by forgetting the domain map. Then Equation (<a href="#S5.E32" title="In Definition 5.45 (Multi-layered thickening). ‣ 5.3.3. Multi-layered thickening ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.32</span></a>) is obtained by projecting the above equation using <math id="S5.Thmthm46.p1.m10" class="ltx_Math" alttext="\pi_{u^{*}TM}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msub><annotation encoding="application/x-tex">\pi_{u^{*}TM}</annotation></semantics></math> and <math id="S5.Thmthm46.p1.m11" class="ltx_Math" alttext="\pi_{E_{1}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><msub><mi>E</mi><mn>1</mn></msub></msub><annotation encoding="application/x-tex">\pi_{E_{1}}</annotation></semantics></math>. For general <math id="S5.Thmthm46.p1.m12" class="ltx_Math" alttext="d\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">d\geq 2</annotation></semantics></math>, one just need to carry out this construction iteratively.</p>
</div>
</div>
<div id="S5.SS3.SSS3.p3" class="ltx_para">
<p id="S5.SS3.SSS3.p3.1" class="ltx_p">Similar to the case with a single thickening bundle, we have a regularity result for the above defined multi-layered thickened moduli space. The details are given in Subsection <a href="#S5.SS3.SSS4" title="5.3.4. Regularity for the multi-layered thickening ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.3.4</span></a>. We remark that the Fredholm model for this thickened moduli space depends on certain choices which may not be canonical. However, being regular or not is a condition independent of these choices. As in Definition <a href="#S5.Thmthm33" title="Definition 5.33 (Thickened moduli). ‣ 5.3.1. Description of the K-chart. ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.33</span></a>, <math id="S5.SS3.SSS3.p3.m1" class="ltx_Math" alttext="V_{pq}^{d}" display="inline" intent=":literal"><semantics><msubsup><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>d</mi></msubsup><annotation encoding="application/x-tex">V_{pq}^{d}</annotation></semantics></math> is part of the data of a K-chart.</p>
</div>
<div id="S5.SS3.SSS3.p4" class="ltx_para ltx_noindent">
<p id="S5.SS3.SSS3.p4.1" class="ltx_p"><span id="S5.SS3.SSS3.p4.1.1" class="ltx_text ltx_font_italic">Obstruction bundle</span> The first part of the obstruction bundle has its fiber over a point represented by <math id="S5.SS3.SSS3.p4.m1" class="ltx_Math" alttext="(\Sigma,u,F,\eta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>F</mi><mo>,</mo><mi>η</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Sigma,u,F,\eta)</annotation></semantics></math> the vector space</p>
<table id="S5.E33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E33.m1" class="ltx_math_unparsed" alttext="\left\{\zeta=\left(\begin{array}[]{c}\zeta_{1}\\
\vdots\\
\zeta_{d}\end{array}\right)\left|\begin{array}[]{c}\zeta_{i}\in\Gamma\left(\overline{\rm Hom}(\iota_{F}^{*}T\mathbb{CP}^{d},u^{*}TM\oplus\displaystyle\bigoplus_{j=1}^{i-1}\tilde{u}^{*}E_{j}\right)\otimes\iota_{F}^{*}{\mathcal{O}}(k_{i})\otimes\overline{H^{0}(\iota_{F}^{*}{\mathcal{O}}(k_{i}))_{0}},\\
\overline{\partial}\zeta_{i}+\pi_{E_{i}}\left(\displaystyle\sum_{j=i+1}^{d}\langle\zeta_{j}\rangle\circ d\iota_{F}\right)=0\end{array}\right.\right\}." display="block" intent=":literal"><semantics><mrow><mrow><mo>{</mo><mi>ζ</mi><mo>=</mo><mrow><mo>(</mo><mtable displaystyle="true" rowspacing="2.0pt"><mtr><mtd><msub><mi>ζ</mi><mn>1</mn></msub></mtd></mtr><mtr><mtd><mi mathvariant="normal">⋮</mi></mtd></mtr><mtr><mtd><msub><mi>ζ</mi><mi>d</mi></msub></mtd></mtr></mtable><mo>)</mo></mrow><mo fence="false" rspace="0.167em">|</mo><mtable displaystyle="true" rowspacing="2.0pt"><mtr><mtd><mrow><mi>ζ</mi><msub><mrow></mrow><mi>i</mi></msub><mo>∈</mo><mi mathvariant="normal">Γ</mi><mo>(</mo><mover accent="true"><mi>Hom</mi><mo stretchy="true">¯</mo></mover><mo stretchy="false">(</mo><mi>ι</mi><msub><mrow></mrow><mi>F</mi></msub><msup><mrow></mrow><mo>∗</mo></msup><mi>T</mi><mi>ℂ</mi><mi>ℙ</mi><msup><mrow></mrow><mi>d</mi></msup><mo>,</mo><mi>u</mi><msup><mrow></mrow><mo>∗</mo></msup><mi>TM</mi><mo rspace="0.055em">⊕</mo><mo movablelimits="false">⨁</mo><msub><mrow></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msup><mover accent="true"><mi>u</mi><mo>~</mo></mover><msup><mrow></mrow><mo>∗</mo></msup><mi>E</mi><msub><mrow></mrow><mi>j</mi></msub><mo rspace="0.055em">)</mo><mo rspace="0.222em">⊗</mo><mi>ι</mi><msub><mrow></mrow><mi>F</mi></msub><msup><mrow></mrow><mo>∗</mo></msup><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo stretchy="false">(</mo><mi>k</mi><msub><mrow></mrow><mi>i</mi></msub><mo rspace="0.055em" stretchy="false">)</mo><mo rspace="0.222em">⊗</mo><mover accent="true"><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>ι</mi><mi>F</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>0</mn></msub></mrow><mo stretchy="true">¯</mo></mover><mo>,</mo></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mrow><mover accent="true"><mo>∂</mo><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><mi>i</mi></msub></mrow><mo>+</mo><mrow><msub><mi>π</mi><msub><mi>E</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><munderover><mo lspace="0em" movablelimits="false" rspace="0em">∑</mo><mrow><mi>j</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>d</mi></munderover><mrow><mo stretchy="false">⟨</mo><msub><mi>ζ</mi><mi>j</mi></msub><mo rspace="0.055em" stretchy="false">⟩</mo></mrow></mrow><mo rspace="0.222em">∘</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ι</mi><mi>F</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow></mtd></mtr></mtable><mo>}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left\{\zeta=\left(\begin{array}[]{c}\zeta_{1}\\
\vdots\\
\zeta_{d}\end{array}\right)\left|\begin{array}[]{c}\zeta_{i}\in\Gamma\left(\overline{\rm Hom}(\iota_{F}^{*}T\mathbb{CP}^{d},u^{*}TM\oplus\displaystyle\bigoplus_{j=1}^{i-1}\tilde{u}^{*}E_{j}\right)\otimes\iota_{F}^{*}{\mathcal{O}}(k_{i})\otimes\overline{H^{0}(\iota_{F}^{*}{\mathcal{O}}(k_{i}))_{0}},\\
\overline{\partial}\zeta_{i}+\pi_{E_{i}}\left(\displaystyle\sum_{j=i+1}^{d}\langle\zeta_{j}\rangle\circ d\iota_{F}\right)=0\end{array}\right.\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.33)</span></td></tr></tbody>
</table>
<p id="S5.SS3.SSS3.p4.2" class="ltx_p">It is standard that it is finite-dimensional. We denote this bundle by</p>
<table id="S5.Ex156" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex156.m1" class="ltx_Math" alttext="O_{pq}=O_{pq}^{(d)}\to V_{pq}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>=</mo><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">→</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">O_{pq}=O_{pq}^{(d)}\to V_{pq}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S5.SS3.SSS3.p5" class="ltx_para">
<p id="S5.SS3.SSS3.p5.1" class="ltx_p">On the other hand, as before, the second factor of the obstruction bundle is the trivial bundle <math id="S5.SS3.SSS3.p5.m1" class="ltx_Math" alttext="Q_{pq}:=Q_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>:=</mo><msub><mi>Q</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">Q_{pq}:=Q_{d}</annotation></semantics></math> whose fiber <math id="S5.SS3.SSS3.p5.m2" class="ltx_Math" alttext="{\bm{Q}}_{d}" display="inline" intent=":literal"><semantics><msub><mi>𝑸</mi><mi>d</mi></msub><annotation encoding="application/x-tex">{\bm{Q}}_{d}</annotation></semantics></math> is defined by (<a href="#S5.E12" title="In 5.2.5. Boundary strata of the auxiliary moduli spaces ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.12</span></a>). Let <math id="S5.SS3.SSS3.p5.m3" class="ltx_Math" alttext="Q_{pq}\to V_{pq}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">Q_{pq}\to V_{pq}</annotation></semantics></math> be the trivial bundle. Note that from its definition, <math id="S5.SS3.SSS3.p5.m4" class="ltx_Math" alttext="Q_{pq}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">Q_{pq}</annotation></semantics></math> is only a fiber bundle with a canonical smooth section, where the section corresponds to the element in <math id="S5.SS3.SSS3.p5.m5" class="ltx_Math" alttext="Q_{d}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mi>d</mi></msub><annotation encoding="application/x-tex">Q_{d}</annotation></semantics></math> represented by the identity matrix. However, using the vector space <math id="S5.SS3.SSS3.p5.m6" class="ltx_Math" alttext="{\bm{Q}}^{*}_{d}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑸</mi><mi>d</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">{\bm{Q}}^{*}_{d}</annotation></semantics></math> defined by (<a href="#S5.E13" title="In 5.2.5. Boundary strata of the auxiliary moduli spaces ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.13</span></a>), the bundle <math id="S5.SS3.SSS3.p5.m7" class="ltx_Math" alttext="Q_{pq}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">Q_{pq}</annotation></semantics></math> can be endowed with a vector bundle structure. We switch between these two viewpoints in different contexts. We define</p>
<table id="S5.Ex157" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex157.m1" class="ltx_Math" alttext="E_{pq}=O_{pq}\oplus Q_{pq}\to V_{pq}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>E</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>=</mo><mrow><msub><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>⊕</mo><msub><mi>Q</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo stretchy="false">→</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">E_{pq}=O_{pq}\oplus Q_{pq}\to V_{pq}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.SSS3.p5.2" class="ltx_p">Moreover, similar to the single-layered case, there is a <math id="S5.SS3.SSS3.p5.m8" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math>-action on <math id="S5.SS3.SSS3.p5.m9" class="ltx_Math" alttext="V_{pq}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">V_{pq}</annotation></semantics></math> as well as on the bundles <math id="S5.SS3.SSS3.p5.m10" class="ltx_Math" alttext="O_{pq}" display="inline" intent=":literal"><semantics><msub><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">O_{pq}</annotation></semantics></math> and <math id="S5.SS3.SSS3.p5.m11" class="ltx_Math" alttext="Q_{pq}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">Q_{pq}</annotation></semantics></math> making <math id="S5.SS3.SSS3.p5.m12" class="ltx_Math" alttext="E_{pq}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">E_{pq}</annotation></semantics></math> an equivariant vector bundle.</p>
</div>
<div id="S5.SS3.SSS3.p6" class="ltx_para ltx_noindent">
<p id="S5.SS3.SSS3.p6.1" class="ltx_p"><span id="S5.SS3.SSS3.p6.1.1" class="ltx_text ltx_font_italic">Properties of obstruction bundle.</span> There are many structural facts about the obstruction bundles which will play important roles in the construction of the K-chart lift of the Hamiltonian Floer flow category. We summarize them here. First, recall that the thickening depends on the choice of the sequence <math id="S5.SS3.SSS3.p6.m1" class="ltx_Math" alttext="k_{1}&lt;\cdots&lt;k_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>k</mi><mn>1</mn></msub><mo rspace="0.1389em">&lt;</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">&lt;</mo><msub><mi>k</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">k_{1}&lt;\cdots&lt;k_{d}</annotation></semantics></math>. We (will) fix an increasing sequence <math id="S5.SS3.SSS3.p6.m2" class="ltx_Math" alttext="\{k_{i}\}_{i=1}^{\infty}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>k</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></msubsup><annotation encoding="application/x-tex">\{k_{i}\}_{i=1}^{\infty}</annotation></semantics></math> such that for all <math id="S5.SS3.SSS3.p6.m3" class="ltx_Math" alttext="pq" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">pq</annotation></semantics></math>, the thickening <math id="S5.SS3.SSS3.p6.m4" class="ltx_Math" alttext="V_{pq}(k_{1},\ldots,k_{d_{pq}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>k</mi><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V_{pq}(k_{1},\ldots,k_{d_{pq}})</annotation></semantics></math> is regular (see Proposition <a href="#S5.Thmthm49" title="Proposition 5.49. ‣ 5.4.1. Inductive construction of the thickened moduli spaces ‣ 5.4. Global chart construction III ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.49</span></a>). However, we can have higher obstruction spaces. Given <math id="S5.SS3.SSS3.p6.m5" class="ltx_Math" alttext="d^{\prime}&gt;d\geq d_{pq}" display="inline" intent=":literal"><semantics><mrow><msup><mi>d</mi><mo>′</mo></msup><mo>&gt;</mo><mi>d</mi><mo>≥</mo><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">d^{\prime}&gt;d\geq d_{pq}</annotation></semantics></math>, one can construct thickenings <math id="S5.SS3.SSS3.p6.m6" class="ltx_Math" alttext="V_{pq}(k_{1},\dots,k_{d})" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>k</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V_{pq}(k_{1},\dots,k_{d})</annotation></semantics></math> and <math id="S5.SS3.SSS3.p6.m7" class="ltx_Math" alttext="V_{pq}(k_{1},\dots,k_{d^{\prime}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>k</mi><msup><mi>d</mi><mo>′</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V_{pq}(k_{1},\dots,k_{d^{\prime}})</annotation></semantics></math>, over which live the two vector bundles</p>
<table id="S5.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.Ex158"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex158.m1" class="ltx_Math" alttext="\displaystyle\ O_{pq}^{(d)}\to V_{pq}(k_{1},\dots,k_{d}),\ " display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">→</mo><mrow><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>k</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ O_{pq}^{(d)}\to V_{pq}(k_{1},\dots,k_{d}),\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex158.m2" class="ltx_Math" alttext="\displaystyle\ O_{pq}^{(d^{\prime})}\to V_{pq}(k_{1},\dots,k_{d^{\prime}})." display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><msup><mi>d</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">→</mo><mrow><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>k</mi><msup><mi>d</mi><mo>′</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ O_{pq}^{(d^{\prime})}\to V_{pq}(k_{1},\dots,k_{d^{\prime}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.SSS3.p6.2" class="ltx_p">As we use sections with higher <math id="S5.SS3.SSS3.p6.m8" class="ltx_Math" alttext="k_{i}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>i</mi></msub><annotation encoding="application/x-tex">k_{i}</annotation></semantics></math> labels to perturb sections with lower <math id="S5.SS3.SSS3.p6.m9" class="ltx_Math" alttext="k_{i}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>i</mi></msub><annotation encoding="application/x-tex">k_{i}</annotation></semantics></math> labels, there is a natural inclusion</p>
<table id="S5.E34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E34.m1" class="ltx_Math" alttext="O_{pq}^{(d)}\hookrightarrow O_{pq}^{(d^{\prime})}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">↪</mo><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><msup><mi>d</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">O_{pq}^{(d)}\hookrightarrow O_{pq}^{(d^{\prime})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.34)</span></td></tr></tbody>
</table>
<p id="S5.SS3.SSS3.p6.3" class="ltx_p">covering the natural inclusion <math id="S5.SS3.SSS3.p6.m10" class="ltx_Math" alttext="V_{pq}(k_{1},\dots,k_{d})\hookrightarrow V_{pq}(k_{1},\dots,k_{d^{\prime}})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>k</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">↪</mo><mrow><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>k</mi><msup><mi>d</mi><mo>′</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">V_{pq}(k_{1},\dots,k_{d})\hookrightarrow V_{pq}(k_{1},\dots,k_{d^{\prime}})</annotation></semantics></math>
such that when <math id="S5.SS3.SSS3.p6.m11" class="ltx_Math" alttext="d&lt;d^{\prime}&lt;d^{\prime\prime}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>&lt;</mo><msup><mi>d</mi><mo>′</mo></msup><mo>&lt;</mo><msup><mi>d</mi><mo>′′</mo></msup></mrow><annotation encoding="application/x-tex">d&lt;d^{\prime}&lt;d^{\prime\prime}</annotation></semantics></math>, the following diagram commutes</p>
<table id="S5.Ex159" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex159.m1" class="ltx_Math" alttext="\vbox{\lx@xy@svg{\hbox{\raise 0.0pt\hbox{\kern 12.40923pt\hbox{\ignorespaces\ignorespaces\ignorespaces\hbox{\vtop{\halign{\entry@#!@&amp;&amp;\entry@@#!@\cr&amp;&amp;\crcr}}}\ignorespaces{\hbox{\kern-12.40923pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{O_{pq}^{(d)}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 36.40923pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{}{}{{}{}{}{}{}{}{}{}{}{}{}{}{}{}{}{}{}{}}{}\ignorespaces\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{{}{}{{}}{{}{}{}}{}}}}\ignorespaces{}\ignorespaces{}{}{}{{}{}{}{}{}{}{}{}{}{}{}{}{}{}}{\hbox{\kern 87.93935pt\raise-5.93481pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}\ignorespaces\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{{}{}{}{{}}{{}{}{}\lx@xy@spline@}{}}}}\ignorespaces{}\ignorespaces\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{{}{}{{}}{{}{}{}}{}}}}\ignorespaces{}{\hbox{\kern 36.40923pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{O_{pq}^{(d^{\prime})}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 87.93254pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 87.93254pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{O_{pq}^{(d^{\prime\prime})}}$}}}}}}}\ignorespaces}}}}}." display="block" intent=":literal"><semantics><mrow><mtext> <svg style="vertical-align:-11.569253138458645px" height="25.30" overflow="visible" version="1.1" viewBox="17.17 11.57 179.98 25.30" width="179.98"> <g transform="matrix(1 0 0 -1 17.17064544605948 25.30180436373582) translate(17.17,0)"> <g transform="translate(-17.17,0) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:1.88em;--ltx-fo-height:0.89em;--ltx-fo-depth:0.29em;font-size:10pt;" height="16.24" overflow="visible" transform="matrix(1 0 0 -1 0 12.29)" width="26.04"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup></span></span></foreignObject> </g> <path style="--ltx-stroke-color:#000000;" d="M 17.17064544605948 -0.27673578005007266 L 17.17064544605948 0.27673578005007266" fill="none" stroke="#000000"></path> <g transform="translate(50.38,0)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M 17.17064544605948 -0.27673578005007266 L 50.379445778147485 0.27673578005007266" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 50.379445778147485 -0.27673578005007266 L 50.379445778147485 0.27673578005007266" fill="none" stroke="#000000"></path> <g transform="translate(121.68,0) translate(0,-8.21)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -7.44 0.45" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -5.69 -4.81" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M 0 0 C 47.413240218700274 -22.139179107805365 94.82648043740055 -22.139179107805365 142.23972065610081 0" fill="none" stroke="#000000"></path> <g transform="translate(50.38,0) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:2.15em;--ltx-fo-height:0.94em;--ltx-fo-depth:0.29em;font-size:10pt;" height="17" overflow="visible" transform="matrix(1 0 0 -1 0 13.04)" width="29.78"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><msup><mi>d</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msubsup></span></span></foreignObject> </g> <path style="--ltx-stroke-color:#000000;" d="M 88.46347883263283 -0.27673578005007266 L 88.46347883263283 0.27673578005007266" fill="none" stroke="#000000"></path> <g transform="translate(121.67,0)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M 88.46347883263283 -0.27673578005007266 L 121.67225805113421 0.27673578005007266" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 121.67225805113421 -0.27673578005007266 L 121.67225805113421 0.27673578005007266" fill="none" stroke="#000000"></path> <g transform="translate(121.67,0) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:2.37em;--ltx-fo-height:0.94em;--ltx-fo-depth:0.29em;font-size:10pt;" height="17" overflow="visible" transform="matrix(1 0 0 -1 0 13.04)" width="32.83"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><msup><mi>d</mi><mo>′′</mo></msup><mo stretchy="false">)</mo></mrow></msubsup></span></span></foreignObject> </g> </g> </svg> </mtext><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\vbox{\lx@xy@svg{\hbox{\raise 0.0pt\hbox{\kern 12.40923pt\hbox{\ignorespaces\ignorespaces\ignorespaces\hbox{\vtop{\halign{\entry@#!@&amp;&amp;\entry@@#!@\cr&amp;&amp;\crcr}}}\ignorespaces{\hbox{\kern-12.40923pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{O_{pq}^{(d)}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 36.40923pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{}{}{{}{}{}{}{}{}{}{}{}{}{}{}{}{}{}{}{}{}}{}\ignorespaces\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{{}{}{{}}{{}{}{}}{}}}}\ignorespaces{}\ignorespaces{}{}{}{{}{}{}{}{}{}{}{}{}{}{}{}{}{}}{\hbox{\kern 87.93935pt\raise-5.93481pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}\ignorespaces\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{{}{}{}{{}}{{}{}{}\lx@xy@spline@}{}}}}\ignorespaces{}\ignorespaces\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{{}{}{{}}{{}{}{}}{}}}}\ignorespaces{}{\hbox{\kern 36.40923pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{O_{pq}^{(d^{\prime})}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 87.93254pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 87.93254pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{O_{pq}^{(d^{\prime\prime})}}$}}}}}}}\ignorespaces}}}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.SSS3.p6.4" class="ltx_p">Then we can define the direct limit of the obstruction bundles as</p>
<table id="S5.E35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E35.m1" class="ltx_Math" alttext="O_{pq}^{\infty}:=\lim_{d\to\infty}O_{pq}^{(d)}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi mathvariant="normal">∞</mi></msubsup><mo rspace="0.1389em">:=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>d</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">O_{pq}^{\infty}:=\lim_{d\to\infty}O_{pq}^{(d)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.35)</span></td></tr></tbody>
</table>
</div>
<div id="S5.SS3.SSS3.p7" class="ltx_para">
<p id="S5.SS3.SSS3.p7.1" class="ltx_p">The obstruction bundle also splits over each boundary stratum. Let <math id="S5.SS3.SSS3.p7.m1" class="ltx_math_unparsed" alttext="\alpha=pr_{1}\cdots r_{l}q\in{\mathbb{A}}_{pq}^{\rm Floer}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mi>p</mi><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>l</mi></msub><mi>q</mi><mo>∈</mo><mi>𝔸</mi><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><msup><mrow></mrow><mi>Floer</mi></msup></mrow><annotation encoding="application/x-tex">\alpha=pr_{1}\cdots r_{l}q\in{\mathbb{A}}_{pq}^{\rm Floer}</annotation></semantics></math> and let <math id="S5.SS3.SSS3.p7.m2" class="ltx_Math" alttext="\partial^{\alpha}V_{pq}\subset V_{pq}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo>⊂</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\partial^{\alpha}V_{pq}\subset V_{pq}</annotation></semantics></math> be the subspace of the thickened moduli space which consists of elements such that the underlying map <math id="S5.SS3.SSS3.p7.m3" class="ltx_Math" alttext="(u,\Sigma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi mathvariant="normal">Σ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u,\Sigma)</annotation></semantics></math> is of type <math id="S5.SS3.SSS3.p7.m4" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> (see Definition <a href="#S5.Thmthm31" title="Definition 5.31. ‣ 5.3.1. Description of the K-chart. ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.31</span></a>). Then one has a direct sum decomposition</p>
<table id="S5.E36" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E36.m1" class="ltx_Math" alttext="O_{pq}^{(d)}|_{\partial^{\alpha}V_{pq}}\cong O_{pq;pr_{1}}^{(d)}\oplus\cdots\oplus O_{pq;r_{l}q}^{(d)}" display="block" intent=":literal"><semantics><mrow><msub><mrow><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">|</mo></mrow><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></msub><mo>≅</mo><mrow><msubsup><mi>O</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>;</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>⊕</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>⊕</mo><msubsup><mi>O</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>;</mo><mrow><msub><mi>r</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">O_{pq}^{(d)}|_{\partial^{\alpha}V_{pq}}\cong O_{pq;pr_{1}}^{(d)}\oplus\cdots\oplus O_{pq;r_{l}q}^{(d)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.36)</span></td></tr></tbody>
</table>
<p id="S5.SS3.SSS3.p7.2" class="ltx_p">where the fiber of <math id="S5.SS3.SSS3.p7.m5" class="ltx_Math" alttext="O_{pq;r_{i}r_{i+1}}^{(d)}" display="inline" intent=":literal"><semantics><msubsup><mi>O</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>;</mo><mrow><msub><mi>r</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">O_{pq;r_{i}r_{i+1}}^{(d)}</annotation></semantics></math> over the point <math id="S5.SS3.SSS3.p7.m6" class="ltx_Math" alttext="[\Sigma,u,F,\eta]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>F</mi><mo>,</mo><mi>η</mi></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[\Sigma,u,F,\eta]</annotation></semantics></math> is</p>
<table id="S5.Ex160" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex160.m1" class="ltx_Math" alttext="\left\{\zeta=(\zeta_{1},\ldots,\zeta_{d})^{T}\ |\ {\rm supp}\zeta\subset\Sigma_{r_{i}r_{i+1}}\subset\Sigma\right\}," display="block" intent=":literal"><semantics><mrow><mrow><mo>{</mo><mrow><mi>ζ</mi><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>ζ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>ζ</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow><mi>T</mi></msup></mrow><mo lspace="0em" rspace="0.500em">|</mo><mrow><mrow><mi>supp</mi><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi></mrow><mo>⊂</mo><msub><mi mathvariant="normal">Σ</mi><mrow><msub><mi>r</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></msub><mo>⊂</mo><mi mathvariant="normal">Σ</mi></mrow><mo>}</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\left\{\zeta=(\zeta_{1},\ldots,\zeta_{d})^{T}\ |\ {\rm supp}\zeta\subset\Sigma_{r_{i}r_{i+1}}\subset\Sigma\right\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.SSS3.p7.3" class="ltx_p">where we use the convention that <math id="S5.SS3.SSS3.p7.m7" class="ltx_Math" alttext="r_{0}=p" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mn>0</mn></msub><mo>=</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">r_{0}=p</annotation></semantics></math> and <math id="S5.SS3.SSS3.p7.m8" class="ltx_Math" alttext="r_{l+1}=q" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">r_{l+1}=q</annotation></semantics></math>.
(<a href="#S5.E36" title="In 5.3.3. Multi-layered thickening ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.36</span></a>) is a direct sum because elements of <math id="S5.SS3.SSS3.p7.m9" class="ltx_Math" alttext="O_{pq}^{(d)}" display="inline" intent=":literal"><semantics><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">O_{pq}^{(d)}</annotation></semantics></math> necessarily vanish at nodes connecting cylindrical components.</p>
</div>
<div id="S5.SS3.SSS3.p8" class="ltx_para ltx_noindent">
<p id="S5.SS3.SSS3.p8.1" class="ltx_p"><span id="S5.SS3.SSS3.p8.1.1" class="ltx_text ltx_font_italic">Kuranishi section.</span> Define</p>
<table id="S5.Ex161" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex161.m1" class="ltx_Math" alttext="\begin{split}S^{d}_{pq}:V_{pq}&amp;\ \to E_{pq}\\
[\Sigma,u,F,\eta]&amp;\ \mapsto(\eta,H_{F})\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><msubsup><mi>S</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>d</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo lspace="0.778em" stretchy="false">→</mo><msub><mi>E</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>F</mi><mo>,</mo><mi>η</mi></mrow><mo stretchy="false">]</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo lspace="0.778em" stretchy="false">↦</mo><mrow><mo stretchy="false">(</mo><mi>η</mi><mo>,</mo><msub><mi>H</mi><mi>F</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}S^{d}_{pq}:V_{pq}&amp;\ \to E_{pq}\\
[\Sigma,u,F,\eta]&amp;\ \mapsto(\eta,H_{F})\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.SSS3.p8.2" class="ltx_p">where <math id="S5.SS3.SSS3.p8.m1" class="ltx_Math" alttext="H_{F}\in Q_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>F</mi></msub><mo>∈</mo><msub><mi>Q</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">H_{F}\in Q_{d}</annotation></semantics></math> is represented by the Hermitian matrix whose entries are</p>
<table id="S5.Ex162" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex162.m1" class="ltx_Math" alttext="\int_{\Sigma}\langle f_{i},f_{j}\rangle_{L_{u,\Omega,H}}\Omega_{u}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mo>∫</mo><mi mathvariant="normal">Σ</mi></msub><mrow><msub><mrow><mo lspace="0em" stretchy="false">⟨</mo><mrow><msub><mi>f</mi><mi>i</mi></msub><mo>,</mo><msub><mi>f</mi><mi>j</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><msub><mi>L</mi><mrow><mi>u</mi><mo>,</mo><mi mathvariant="normal">Ω</mi><mo>,</mo><mi>H</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Ω</mi><mi>u</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\int_{\Sigma}\langle f_{i},f_{j}\rangle_{L_{u,\Omega,H}}\Omega_{u},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.SSS3.p8.3" class="ltx_p">where <math id="S5.SS3.SSS3.p8.m2" class="ltx_Math" alttext="f_{0},\dots,f_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">f_{0},\dots,f_{d}</annotation></semantics></math> is a basis representing the frame <math id="S5.SS3.SSS3.p8.m3" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>.
It is also the same as the single-layered case that <math id="S5.SS3.SSS3.p8.m4" class="ltx_Math" alttext="S^{d}_{pq}" display="inline" intent=":literal"><semantics><msubsup><mi>S</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>d</mi></msubsup><annotation encoding="application/x-tex">S^{d}_{pq}</annotation></semantics></math> is <math id="S5.SS3.SSS3.p8.m5" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math>-equivariant,</p>
</div>
<div id="S5.SS3.SSS3.p9" class="ltx_para">
<p id="S5.SS3.SSS3.p9.1" class="ltx_p">Therefore, one obtains a quadruple</p>
<table id="S5.E37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E37.m1" class="ltx_Math" alttext="K_{pq}=(G_{pq},V_{pq},E_{pq},S_{pq}):=(G_{pq},V^{d}_{pq},E^{d}_{pq},S^{d}_{pq})" display="block" intent=":literal"><semantics><mrow><msub><mi>K</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi>E</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi>S</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>:=</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msubsup><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>d</mi></msubsup><mo>,</mo><msubsup><mi>E</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>d</mi></msubsup><mo>,</mo><msubsup><mi>S</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>d</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K_{pq}=(G_{pq},V_{pq},E_{pq},S_{pq}):=(G_{pq},V^{d}_{pq},E^{d}_{pq},S^{d}_{pq})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.37)</span></td></tr></tbody>
</table>
<p id="S5.SS3.SSS3.p9.2" class="ltx_p">which is a candidate for a global Kuranishi chart on <math id="S5.SS3.SSS3.p9.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}_{pq}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{pq}</annotation></semantics></math>. Still, there is a canonical map</p>
<table id="S5.Ex163" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex163.m1" class="ltx_Math" alttext="S_{pq}^{-1}(0)/G_{pq}\to\overline{\mathcal{M}}_{pq}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>S</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo stretchy="false">→</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">S_{pq}^{-1}(0)/G_{pq}\to\overline{\mathcal{M}}_{pq}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.SSS3.p9.3" class="ltx_p">which defines a homeomorphism onto its image.</p>
</div>
</section>
<section id="S5.SS3.SSS4" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">5.3.4. </span>Regularity for the multi-layered thickening</h4>

<div id="S5.SS3.SSS4.p1" class="ltx_para">
<p id="S5.SS3.SSS4.p1.1" class="ltx_p">Now we prove the regularity of the multi-layered thickening. First we transform the description of the thickened moduli space to a moduli space where one can use Gromov’s graph trick. Recall that one has the bundles <math id="S5.SS3.SSS4.p1.m1" class="ltx_Math" alttext="E_{1},\ldots,E_{d}\to M\times{\mathcal{C}}_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>E</mi><mi>d</mi></msub><mo stretchy="false">→</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>d</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">E_{1},\ldots,E_{d}\to M\times{\mathcal{C}}_{d}</annotation></semantics></math>. Then one can define the tower of bundles</p>
<table id="S5.Ex164" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex164.m1" class="ltx_Math" alttext="{\mathcal{E}}_{d}\to{\mathcal{E}}_{d-1}\to\cdots\to{\mathcal{E}}_{1}\to M\times{\mathcal{C}}_{d}" display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>d</mi></msub><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo rspace="0.1389em" stretchy="false">→</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em" stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mn>1</mn></msub><mo stretchy="false">→</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>d</mi></msub></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{E}}_{d}\to{\mathcal{E}}_{d-1}\to\cdots\to{\mathcal{E}}_{1}\to M\times{\mathcal{C}}_{d}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.SSS4.p1.2" class="ltx_p">where each <math id="S5.SS3.SSS4.p1.m2" class="ltx_Math" alttext="{\mathcal{E}}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{i}</annotation></semantics></math> is the total space of the pullback of <math id="S5.SS3.SSS4.p1.m3" class="ltx_Math" alttext="E_{i}\to M\times{\mathcal{C}}_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mi>i</mi></msub><mo stretchy="false">→</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>d</mi></msub></mrow></mrow><annotation encoding="application/x-tex">E_{i}\to M\times{\mathcal{C}}_{d}</annotation></semantics></math> onto the previous <math id="S5.SS3.SSS4.p1.m4" class="ltx_Math" alttext="{\mathcal{E}}_{i}\to M\times{\mathcal{C}}_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>i</mi></msub><mo stretchy="false">→</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>d</mi></msub></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{E}}_{i}\to M\times{\mathcal{C}}_{d}</annotation></semantics></math>. Then <math id="S5.SS3.SSS4.p1.m5" class="ltx_Math" alttext="{\mathcal{E}}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{i}</annotation></semantics></math> is still a complex vector bundle over <math id="S5.SS3.SSS4.p1.m6" class="ltx_Math" alttext="M\times{\mathcal{C}}_{d}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">M\times{\mathcal{C}}_{d}</annotation></semantics></math>. To proceed we would like to equip each <math id="S5.SS3.SSS4.p1.m7" class="ltx_Math" alttext="{\mathcal{E}}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{i}</annotation></semantics></math> with a Hermitian metric and a Hermitian connection. From the construction one can see that all the ingredients in constructing these bundles have a natural Hermitian structure except for the bundle <math id="S5.SS3.SSS4.p1.m8" class="ltx_Math" alttext="({\rm univ}_{*}{\rm ev}^{*}{\mathcal{O}}(k_{i}))_{0}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>univ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>ev</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>0</mn></msub><annotation encoding="application/x-tex">({\rm univ}_{*}{\rm ev}^{*}{\mathcal{O}}(k_{i}))_{0}</annotation></semantics></math>, which is the bundle of fiberwise global sections of the holomorphic line bundle <math id="S5.SS3.SSS4.p1.m9" class="ltx_Math" alttext="{\rm ev}^{*}{\mathcal{O}}(k_{i})" display="inline" intent=":literal"><semantics><mrow><msup><mi>ev</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\rm ev}^{*}{\mathcal{O}}(k_{i})</annotation></semantics></math> that vanish at the markings <math id="S5.SS3.SSS4.p1.m10" class="ltx_Math" alttext="z_{-}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mo>−</mo></msub><annotation encoding="application/x-tex">z_{-}</annotation></semantics></math> and <math id="S5.SS3.SSS4.p1.m11" class="ltx_Math" alttext="z_{+}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mo>+</mo></msub><annotation encoding="application/x-tex">z_{+}</annotation></semantics></math>. We choose an arbitrary smooth Hermitian metric on <math id="S5.SS3.SSS4.p1.m12" class="ltx_Math" alttext="{\rm univ}_{*}{\rm ev}^{*}{\mathcal{O}}(k_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>univ</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>ev</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\rm univ}_{*}{\rm ev}^{*}{\mathcal{O}}(k_{i})</annotation></semantics></math>. Then each <math id="S5.SS3.SSS4.p1.m13" class="ltx_Math" alttext="{\mathcal{E}}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{i}</annotation></semantics></math> has an induced Hermitian metric. Moreover, together with the Chern connection on all involved holomorphic vector bundles and the chosen Hermitian metric on <math id="S5.SS3.SSS4.p1.m14" class="ltx_Math" alttext="TM" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">TM</annotation></semantics></math>, <math id="S5.SS3.SSS4.p1.m15" class="ltx_Math" alttext="{\mathcal{E}}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{i}</annotation></semantics></math> is equipped with a Hermitian connection.</p>
</div>
<div id="S5.SS3.SSS4.p2" class="ltx_para">
<p id="S5.SS3.SSS4.p2.1" class="ltx_p">Now we inductively define a sheared almost complex structure on the total space of <math id="S5.SS3.SSS4.p2.m1" class="ltx_Math" alttext="{\mathcal{E}}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{i}</annotation></semantics></math> similar to the constructions in Section <a href="#S5.SS3.SSS2" title="5.3.2. Transversality of the perturbed Floer equation ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.3.2</span></a>. The details are almost identical and omitted. We denote the resulting almost complex structure on <math id="S5.SS3.SSS4.p2.m2" class="ltx_Math" alttext="{\mathcal{E}}_{d}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>d</mi></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{d}</annotation></semantics></math> by <math id="S5.SS3.SSS4.p2.m3" class="ltx_Math" alttext="J_{\Psi}" display="inline" intent=":literal"><semantics><msub><mi>J</mi><mi mathvariant="normal">Ψ</mi></msub><annotation encoding="application/x-tex">J_{\Psi}</annotation></semantics></math>.</p>
</div>
<div id="S5.Thmthm47" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm47.2" class="ltx_text ltx_font_bold">Theorem 5.47</span></span><span id="S5.Thmthm47.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm47.p1" class="ltx_para">
<p id="S5.Thmthm47.p1.1" class="ltx_p"><span id="S5.Thmthm47.p1.1.1" class="ltx_text ltx_font_italic">For a given list <math id="S5.Thmthm47.p1.m1" class="ltx_Math" alttext="k_{1}&lt;\cdots&lt;k_{d-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>k</mi><mn>1</mn></msub><mo rspace="0.1389em">&lt;</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">&lt;</mo><msub><mi>k</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">k_{1}&lt;\cdots&lt;k_{d-1}</annotation></semantics></math> of positive integers. There exists <math id="S5.Thmthm47.p1.m2" class="ltx_Math" alttext="k^{*}&gt;0" display="inline" intent=":literal"><semantics><mrow><msup><mi>k</mi><mo>∗</mo></msup><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">k^{*}&gt;0</annotation></semantics></math> such that for all <math id="S5.Thmthm47.p1.m3" class="ltx_Math" alttext="k_{d}\geq k^{*}" display="inline" intent=":literal"><semantics><mrow><msub><mi>k</mi><mi>d</mi></msub><mo>≥</mo><msup><mi>k</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">k_{d}\geq k^{*}</annotation></semantics></math>, for all pairs <math id="S5.Thmthm47.p1.m4" class="ltx_Math" alttext="pq" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">pq</annotation></semantics></math> with <math id="S5.Thmthm47.p1.m5" class="ltx_Math" alttext="d_{pq}\leq d" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>≤</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">d_{pq}\leq d</annotation></semantics></math>, all elements of <math id="S5.Thmthm47.p1.m6" class="ltx_Math" alttext="S_{pq}^{-1}(0)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>S</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">S_{pq}^{-1}(0)</annotation></semantics></math> are regular elements of <math id="S5.Thmthm47.p1.m7" class="ltx_Math" alttext="{\mathcal{M}}_{J_{\tilde{\Psi}},H}(k_{1},\ldots,k_{d})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><msub><mi>J</mi><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover></msub><mo>,</mo><mi>H</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>k</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{M}}_{J_{\tilde{\Psi}},H}(k_{1},\ldots,k_{d})</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S5.SS3.SSS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.SS3.SSS4.p3" class="ltx_para">
<p id="S5.SS3.SSS4.p3.1" class="ltx_p"><span id="S5.SS3.SSS4.p3.1.1" class="ltx_text">The proof is essentially the same as the single-layered case. Indeed, we can replace the almost complex manifold <math id="S5.SS3.SSS4.p3.m1" class="ltx_Math" alttext="(M,J)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>J</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(M,J)</annotation></semantics></math> by the pair <math id="S5.SS3.SSS4.p3.m2" class="ltx_Math" alttext="({\mathcal{E}}_{d-1},J_{d-1})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>J</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathcal{E}}_{d-1},J_{d-1})</annotation></semantics></math> where <math id="S5.SS3.SSS4.p3.m3" class="ltx_Math" alttext="J_{d-1}" display="inline" intent=":literal"><semantics><msub><mi>J</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">J_{d-1}</annotation></semantics></math> is the sheared almost complex structure on the total space <math id="S5.SS3.SSS4.p3.m4" class="ltx_Math" alttext="{\mathcal{E}}_{d-1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{d-1}</annotation></semantics></math> lifted via the chosen connections. Then we can proceed by writing the linearized Cauchy–Riemann operator in the block form as in (<a href="#S5.E30" title="In Proof. ‣ 5.3.2. Transversality of the perturbed Floer equation ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.30</span></a>). As long as <math id="S5.SS3.SSS4.p3.m5" class="ltx_Math" alttext="k_{d}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>d</mi></msub><annotation encoding="application/x-tex">k_{d}</annotation></semantics></math> is sufficiently positive, we can make the linearization of the first equation in (<a href="#S5.E32" title="In Definition 5.45 (Multi-layered thickening). ‣ 5.3.3. Multi-layered thickening ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.32</span></a>) surjective by the peak section argument from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>, Proposition 6.26]</cite>. For the surjectivity of the linearization of the second part in (<a href="#S5.E32" title="In Definition 5.45 (Multi-layered thickening). ‣ 5.3.3. Multi-layered thickening ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.32</span></a>), apply Lemma <a href="#S5.Thmthm42" title="Lemma 5.42. ‣ 5.3.2. Transversality of the perturbed Floer equation ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.42</span></a> and Lemma <a href="#S5.Thmthm43" title="Lemma 5.43. ‣ 5.3.2. Transversality of the perturbed Floer equation ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.43</span></a>.
∎</span></p>
</div>
</div>
<div id="S5.Thmthm48" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm48.2" class="ltx_text ltx_font_bold">Lemma 5.48</span></span><span id="S5.Thmthm48.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm48.p1" class="ltx_para">
<p id="S5.Thmthm48.p1.1" class="ltx_p"><span id="S5.Thmthm48.p1.1.1" class="ltx_text ltx_font_italic">Each fiber of the natural forgetful map</span></p>
<table id="S5.E38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E38.m1" class="ltx_Math" alttext="\pi_{pq}:V_{pq}\to B_{pq}" display="block" intent=":literal"><semantics><mrow><msub><mi>π</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi>B</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\pi_{pq}:V_{pq}\to B_{pq}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.38)</span></td></tr></tbody>
</table>
<p id="S5.Thmthm48.p1.2" class="ltx_p"><span id="S5.Thmthm48.p1.2.1" class="ltx_text ltx_font_italic">which takes a representative <math id="S5.Thmthm48.p1.m1" class="ltx_Math" alttext="(\Sigma,u,F,\eta_{1},\ldots,\eta_{d})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>F</mi><mo>,</mo><msub><mi>η</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>η</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Sigma,u,F,\eta_{1},\ldots,\eta_{d})</annotation></semantics></math> to the equivalence class of the holomorphic map</span></p>
<table id="S5.Ex165" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex165.m1" class="ltx_Math" alttext="\iota_{F}:\Sigma\to{\mathbb{C}P}^{d}" display="block" intent=":literal"><semantics><mrow><msub><mi>ι</mi><mi>F</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mi>d</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\iota_{F}:\Sigma\to{\mathbb{C}P}^{d}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmthm48.p1.3" class="ltx_p"><span id="S5.Thmthm48.p1.3.1" class="ltx_text ltx_font_italic">has a canonical structure of smooth manifold and the restriction of the obstruction bundle <math id="S5.Thmthm48.p1.m2" class="ltx_Math" alttext="O_{pq}^{(d)}" display="inline" intent=":literal"><semantics><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">O_{pq}^{(d)}</annotation></semantics></math> to each fiber is canonically a smooth vector bundle. Moreover, each <math id="S5.Thmthm48.p1.m3" class="ltx_Math" alttext="g\in G_{pq}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>∈</mo><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">g\in G_{pq}</annotation></semantics></math> induces diffeomorphisms between fibers and smooth isomorphisms between the fiberwise restrictions of the obstruction bundle.</span></p>
</div>
</div>
<div id="S5.SS3.SSS4.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.SS3.SSS4.p4" class="ltx_para">
<p id="S5.SS3.SSS4.p4.1" class="ltx_p"><span id="S5.SS3.SSS4.p4.1.1" class="ltx_text">As the domain curve of elements in each fiber of <math id="S5.SS3.SSS4.p4.m1" class="ltx_Math" alttext="\pi_{pq}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\pi_{pq}</annotation></semantics></math> is fixed, a fiber of <math id="S5.SS3.SSS4.p4.m2" class="ltx_Math" alttext="\pi_{pq}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\pi_{pq}</annotation></semantics></math> is the zero locus of a smooth Fredholm section of a Banach vector bundle. The regularity along the vertical direction implies that the fibers are smooth because the complex structure on the domain is unchanged. For the same reason the restriction of <math id="S5.SS3.SSS4.p4.m3" class="ltx_Math" alttext="O_{pq}^{(d)}" display="inline" intent=":literal"><semantics><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">O_{pq}^{(d)}</annotation></semantics></math> to each fiber is smooth. Lastly, if <math id="S5.SS3.SSS4.p4.m4" class="ltx_Math" alttext="g\in G_{pq}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>∈</mo><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">g\in G_{pq}</annotation></semantics></math>, the <math id="S5.SS3.SSS4.p4.m5" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> induces a smooth identification between two Banach vector bundles which intertwines with the Fredholm sections.
∎</span></p>
</div>
</div>
<div id="S5.SS3.SSS4.p5" class="ltx_para">
<p id="S5.SS3.SSS4.p5.1" class="ltx_p">In fact, the forgetful map <math id="S5.SS3.SSS4.p5.m1" class="ltx_Math" alttext="\pi_{pq}:V_{pq}\to B_{pq}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi>B</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\pi_{pq}:V_{pq}\to B_{pq}</annotation></semantics></math> is a <math id="S5.SS3.SSS4.p5.m2" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math>-equivariant map between stratified spaces, where the underlying map between posets is the same as (<a href="#S5.E2" title="In item 2 ‣ Notation 5.7. ‣ 5.1.4. Notations ‣ 5.1. Basic notions and the main theorem about global charts ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.2</span></a>). Lemma <a href="#S5.Thmthm48" title="Lemma 5.48. ‣ 5.3.4. Regularity for the multi-layered thickening ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.48</span></a> says that this map further has a fiberwise smooth structure. However, Lemma <a href="#S5.Thmthm48" title="Lemma 5.48. ‣ 5.3.4. Regularity for the multi-layered thickening ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.48</span></a> <em id="S5.SS3.SSS4.p5.1.1" class="ltx_emph ltx_font_italic">does not</em> assert that the locally closed stratum <math id="S5.SS3.SSS4.p5.m3" class="ltx_Math" alttext="\partial^{\alpha}\mathring{V}_{pq}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mover accent="true"><mi>V</mi><mo>̊</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\partial^{\alpha}\mathring{V}_{pq}</annotation></semantics></math> has a smooth structure. Indeed, the <math id="S5.SS3.SSS4.p5.m4" class="ltx_Math" alttext="{\mathbb{A}}_{d}" display="inline" intent=":literal"><semantics><msub><mi>𝔸</mi><mi>d</mi></msub><annotation encoding="application/x-tex">{\mathbb{A}}_{d}</annotation></semantics></math>-stratification on <math id="S5.SS3.SSS4.p5.m5" class="ltx_Math" alttext="B_{d}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>d</mi></msub><annotation encoding="application/x-tex">B_{d}</annotation></semantics></math> ignores the appearance of sphere bubbles. More refined structures of <math id="S5.SS3.SSS4.p5.m6" class="ltx_Math" alttext="\pi_{pq}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\pi_{pq}</annotation></semantics></math> will be explored in Section <a href="#S6" title="6. Smoothing ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>.</p>
</div>
</section>
</section>
<section id="S5.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.4. </span>Global chart construction III</h3>

<section id="S5.SS4.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">5.4.1. </span>Inductive construction of the thickened moduli spaces</h4>

<div id="S5.Thmthm49" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm49.2" class="ltx_text ltx_font_bold">Proposition 5.49</span></span><span id="S5.Thmthm49.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm49.p1" class="ltx_para">
<p id="S5.Thmthm49.p1.1" class="ltx_p"><span id="S5.Thmthm49.p1.1.1" class="ltx_text ltx_font_italic">There exists an increasing sequence of positive integers</span></p>
<table id="S5.Ex166" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex166.m1" class="ltx_Math" alttext="k_{1}&lt;k_{2}&lt;\cdots&lt;k_{d}&lt;\cdots" display="block" intent=":literal"><semantics><mrow><msub><mi>k</mi><mn>1</mn></msub><mo>&lt;</mo><msub><mi>k</mi><mn>2</mn></msub><mo rspace="0.1389em">&lt;</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">&lt;</mo><msub><mi>k</mi><mi>d</mi></msub><mo rspace="0.1389em">&lt;</mo><mo lspace="0.1389em">⋯</mo></mrow><annotation encoding="application/x-tex">k_{1}&lt;k_{2}&lt;\cdots&lt;k_{d}&lt;\cdots</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmthm49.p1.2" class="ltx_p"><span id="S5.Thmthm49.p1.2.1" class="ltx_text ltx_font_italic">which satisfies the following condition: for each <math id="S5.Thmthm49.p1.m1" class="ltx_Math" alttext="d\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d\geq 1</annotation></semantics></math>, each <math id="S5.Thmthm49.p1.m2" class="ltx_Math" alttext="pq" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">pq</annotation></semantics></math> with <math id="S5.Thmthm49.p1.m3" class="ltx_Math" alttext="d_{pq}\leq d" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>≤</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">d_{pq}\leq d</annotation></semantics></math>, the thickened moduli space <math id="S5.Thmthm49.p1.m4" class="ltx_Math" alttext="V_{pq}(k_{1},\ldots,k_{d})" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>k</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V_{pq}(k_{1},\ldots,k_{d})</annotation></semantics></math> is regular near the zero locus of the Kuranishi map.</span></p>
</div>
</div>
<div id="S5.SS4.SSS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.SS4.SSS1.p1" class="ltx_para">
<p id="S5.SS4.SSS1.p1.1" class="ltx_p"><span id="S5.SS4.SSS1.p1.1.1" class="ltx_text">This statement can be proved by induction on <math id="S5.SS4.SSS1.p1.m1" class="ltx_Math" alttext="d_{pq}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">d_{pq}</annotation></semantics></math>, combining the proof for the case of a single multi-layered thickening in Theorem <a href="#S5.Thmthm47" title="Theorem 5.47. ‣ 5.3.4. Regularity for the multi-layered thickening ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.47</span></a>.
∎</span></p>
</div>
</div>
<div id="S5.Thmthm50" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm50.2" class="ltx_text ltx_font_italic">Remark 5.50</span></span><span id="S5.Thmthm50.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S5.Thmthm50.p1" class="ltx_para">
<p id="S5.Thmthm50.p1.1" class="ltx_p">One can choose the sequence <math id="S5.Thmthm50.p1.m1" class="ltx_Math" alttext="k_{1},k_{2},\ldots" display="inline" intent=":literal"><semantics><mrow><msub><mi>k</mi><mn>1</mn></msub><mo>,</mo><msub><mi>k</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">k_{1},k_{2},\ldots</annotation></semantics></math> such that the corresponding thickening of <math id="S5.Thmthm50.p1.m2" class="ltx_Math" alttext="{\rm PSS}" display="inline" intent=":literal"><semantics><mi>PSS</mi><annotation encoding="application/x-tex">{\rm PSS}</annotation></semantics></math>, <math id="S5.Thmthm50.p1.m3" class="ltx_Math" alttext="{\rm SSP}" display="inline" intent=":literal"><semantics><mi>SSP</mi><annotation encoding="application/x-tex">{\rm SSP}</annotation></semantics></math>, <math id="S5.Thmthm50.p1.m4" class="ltx_Math" alttext="{\rm pearl}" display="inline" intent=":literal"><semantics><mi>pearl</mi><annotation encoding="application/x-tex">{\rm pearl}</annotation></semantics></math>, and the homotopy moduli spaces are all regular (see Section <a href="#S7" title="7. Constructions for PSS, SSP, and the homotopy ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>).</p>
</div>
</div>
<div id="S5.SS4.SSS1.p2" class="ltx_para">
<p id="S5.SS4.SSS1.p2.1" class="ltx_p">From now on we fix the sequence <math id="S5.SS4.SSS1.p2.m1" class="ltx_Math" alttext="k_{1}&lt;k_{2}&lt;\cdots" display="inline" intent=":literal"><semantics><mrow><msub><mi>k</mi><mn>1</mn></msub><mo>&lt;</mo><msub><mi>k</mi><mn>2</mn></msub><mo rspace="0.1389em">&lt;</mo><mo lspace="0.1389em">⋯</mo></mrow><annotation encoding="application/x-tex">k_{1}&lt;k_{2}&lt;\cdots</annotation></semantics></math> which satisfies the conditions of Proposition <a href="#S5.Thmthm49" title="Proposition 5.49. ‣ 5.4.1. Inductive construction of the thickened moduli spaces ‣ 5.4. Global chart construction III ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.49</span></a>. By shrinking to an open neighborhood of <math id="S5.SS4.SSS1.p2.m2" class="ltx_Math" alttext="S_{pq}^{-1}(0)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>S</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">S_{pq}^{-1}(0)</annotation></semantics></math> inside <math id="S5.SS4.SSS1.p2.m3" class="ltx_Math" alttext="V_{pq}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">V_{pq}</annotation></semantics></math>, one obtains a global Kuranishi chart. Just as Lemma <a href="#S5.Thmthm48" title="Lemma 5.48. ‣ 5.3.4. Regularity for the multi-layered thickening ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.48</span></a>, there are also the natural forgetful maps</p>
<table id="S5.Ex167" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex167.m1" class="ltx_Math" alttext="\pi_{pq}:V_{pq}\to B_{pq}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi>B</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\pi_{pq}:V_{pq}\to B_{pq}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS4.SSS1.p2.2" class="ltx_p">These maps should be thought of as the natural forgetful map which takes a <math id="S5.SS4.SSS1.p2.m4" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math>-holomorphic curve to its moduli parameter in the Deligne–Mumford space.</p>
</div>
</section>
<section id="S5.SS4.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">5.4.2. </span>Product construction: the case of two factors</h4>

<div id="S5.SS4.SSS2.p1" class="ltx_para">
<p id="S5.SS4.SSS2.p1.1" class="ltx_p">To obtain a K-chart lifting, one needs to define embeddings of products of charts into corresponding boundary strata of a bigger chart. We call the definition of such embeddings the product construction. This construction needs to be compatible with the product construction of the auxiliary moduli spaces <math id="S5.SS4.SSS2.p1.m1" class="ltx_Math" alttext="B_{d}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>d</mi></msub><annotation encoding="application/x-tex">B_{d}</annotation></semantics></math>.</p>
</div>
<div id="S5.SS4.SSS2.p2" class="ltx_para">
<p id="S5.SS4.SSS2.p2.1" class="ltx_p">We first consider the case of two factors. Consider a nonempty codimension one stratum <math id="S5.SS4.SSS2.p2.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}_{prq}\subset\overline{\mathcal{M}}_{pq}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>⊂</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{prq}\subset\overline{\mathcal{M}}_{pq}</annotation></semantics></math>. We would like to define an equivariant map</p>
<table id="S5.Ex168" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex168.m1" class="ltx_Math" alttext="\vartheta_{prq}:V_{pr}\times V_{rq}\to\partial^{prq}V_{pq}" display="block" intent=":literal"><semantics><mrow><msub><mi>ϑ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>V</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo rspace="0.111em" stretchy="false">→</mo><mrow><msup><mo>∂</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msup><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\vartheta_{prq}:V_{pr}\times V_{rq}\to\partial^{prq}V_{pq}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS4.SSS2.p2.2" class="ltx_p">which lifts the map <math id="S5.SS4.SSS2.p2.m2" class="ltx_Math" alttext="\zeta_{prq}" display="inline" intent=":literal"><semantics><msub><mi>ζ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\zeta_{prq}</annotation></semantics></math> (see (<a href="#S5.E6" title="In 5.2.5. Boundary strata of the auxiliary moduli spaces ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.6</span></a>) and (<a href="#S5.E10" title="In 5.2.5. Boundary strata of the auxiliary moduli spaces ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.10</span></a>)). Suppose a point <math id="S5.SS4.SSS2.p2.m3" class="ltx_Math" alttext="\tilde{x}_{pr}\in V_{pr}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo>∈</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\tilde{x}_{pr}\in V_{pr}</annotation></semantics></math> is represented by a quadruple <math id="S5.SS4.SSS2.p2.m4" class="ltx_Math" alttext="(\Sigma_{pr},u_{pr},F_{pr},\eta_{pr})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo>,</mo><msub><mi>u</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo>,</mo><msub><mi>F</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo>,</mo><msub><mi>η</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Sigma_{pr},u_{pr},F_{pr},\eta_{pr})</annotation></semantics></math> and a point <math id="S5.SS4.SSS2.p2.m5" class="ltx_Math" alttext="\tilde{x}_{rq}\in V_{rq}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>x</mi><mo>~</mo></mover><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>∈</mo><msub><mi>V</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\tilde{x}_{rq}\in V_{rq}</annotation></semantics></math> is represented by a quadruple <math id="S5.SS4.SSS2.p2.m6" class="ltx_Math" alttext="(\Sigma_{rq},u_{rq},F_{rq},\eta_{rq})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi>u</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi>F</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi>η</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Sigma_{rq},u_{rq},F_{rq},\eta_{rq})</annotation></semantics></math>. Let <math id="S5.SS4.SSS2.p2.m7" class="ltx_Math" alttext="x_{pr}\in B_{pr}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo>∈</mo><msub><mi>B</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></mrow><annotation encoding="application/x-tex">x_{pr}\in B_{pr}</annotation></semantics></math>, <math id="S5.SS4.SSS2.p2.m8" class="ltx_Math" alttext="x_{rq}\in B_{rq}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>∈</mo><msub><mi>B</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">x_{rq}\in B_{rq}</annotation></semantics></math> be the underlying stable maps into projective spaces. Then using the map <math id="S5.SS4.SSS2.p2.m9" class="ltx_Math" alttext="\zeta_{prq}:B_{pr}\times B_{rq}\to\partial^{prq}B_{pq}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ζ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>B</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>B</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo rspace="0.111em" stretchy="false">→</mo><mrow><msup><mo>∂</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msup><msub><mi>B</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\zeta_{prq}:B_{pr}\times B_{rq}\to\partial^{prq}B_{pq}</annotation></semantics></math> one can define a point</p>
<table id="S5.Ex169" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex169.m1" class="ltx_Math" alttext="x_{prq}:=\zeta_{prq}(x_{pr},x_{rq})" display="block" intent=":literal"><semantics><mrow><msub><mi>x</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>:=</mo><mrow><msub><mi>ζ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo>,</mo><msub><mi>x</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x_{prq}:=\zeta_{prq}(x_{pr},x_{rq})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS4.SSS2.p2.3" class="ltx_p">which can be represented by a stable cylinder <math id="S5.SS4.SSS2.p2.m10" class="ltx_Math" alttext="\underline{\smash{\mu}}_{prq}:\Sigma_{prq}\to\mathbb{CP}^{d_{pq}}" display="inline" intent=":literal"><semantics><mrow><msub><munder accentunder="true"><mi>μ</mi><mo stretchy="true">¯</mo></munder><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">→</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\underline{\smash{\mu}}_{prq}:\Sigma_{prq}\to\mathbb{CP}^{d_{pq}}</annotation></semantics></math>. Moreover, there is a natural framing</p>
<table id="S5.Ex170" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex170.m1" class="ltx_Math" alttext="F_{prq}=(f_{0},\ldots,f_{d_{pq}})" display="block" intent=":literal"><semantics><mrow><msub><mi>F</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F_{prq}=(f_{0},\ldots,f_{d_{pq}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS4.SSS2.p2.4" class="ltx_p">which lifts <math id="S5.SS4.SSS2.p2.m11" class="ltx_Math" alttext="u_{prq}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">u_{prq}</annotation></semantics></math> defined as follows. Let <math id="S5.SS4.SSS2.p2.m12" class="ltx_Math" alttext="L_{prq}\to\Sigma_{prq}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi mathvariant="normal">Σ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">L_{prq}\to\Sigma_{prq}</annotation></semantics></math> be the pullback of <math id="S5.SS4.SSS2.p2.m13" class="ltx_Math" alttext="{\mathcal{O}}(1)\to\mathbb{CP}^{d_{pq}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msup></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{O}}(1)\to\mathbb{CP}^{d_{pq}}</annotation></semantics></math> by <math id="S5.SS4.SSS2.p2.m14" class="ltx_Math" alttext="u_{prq}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">u_{prq}</annotation></semantics></math> which carries the pullback of the Fubini–Study metric. Then the map <math id="S5.SS4.SSS2.p2.m15" class="ltx_Math" alttext="u_{prq}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">u_{prq}</annotation></semantics></math> can be represented by a basis</p>
<table id="S5.Ex171" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex171.m1" class="ltx_Math" alttext="f_{0},\ldots,f_{d_{pq}}" display="block" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msub></mrow><annotation encoding="application/x-tex">f_{0},\ldots,f_{d_{pq}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS4.SSS2.p2.5" class="ltx_p">of <math id="S5.SS4.SSS2.p2.m16" class="ltx_Math" alttext="H^{0}(L_{prq})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>L</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{0}(L_{prq})</annotation></semantics></math> which is well-defined up to a <math id="S5.SS4.SSS2.p2.m17" class="ltx_Math" alttext="{\mathbb{C}}^{*}" display="inline" intent=":literal"><semantics><msup><mi>ℂ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">{\mathbb{C}}^{*}</annotation></semantics></math>-factor. Moreover, the <math id="S5.SS4.SSS2.p2.m18" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>-factors of <math id="S5.SS4.SSS2.p2.m19" class="ltx_Math" alttext="u_{pr}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">u_{pr}</annotation></semantics></math> and <math id="S5.SS4.SSS2.p2.m20" class="ltx_Math" alttext="u_{rq}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">u_{rq}</annotation></semantics></math> naturally define a map</p>
<table id="S5.Ex172" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex172.m1" class="ltx_Math" alttext="u_{prq}:\Sigma_{prq}\to M" display="block" intent=":literal"><semantics><mrow><msub><mi>u</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">→</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">u_{prq}:\Sigma_{prq}\to M</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS4.SSS2.p2.6" class="ltx_p">which converges to the correct periodic orbits at <math id="S5.SS4.SSS2.p2.m21" class="ltx_Math" alttext="z_{\pm}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mo>±</mo></msub><annotation encoding="application/x-tex">z_{\pm}</annotation></semantics></math>. Lastly, one needs to define the combined vector <math id="S5.SS4.SSS2.p2.m22" class="ltx_Math" alttext="\eta_{prq}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\eta_{prq}</annotation></semantics></math>.</p>
</div>
<div id="S5.SS4.SSS2.p3" class="ltx_para">
<p id="S5.SS4.SSS2.p3.1" class="ltx_p">We first describe the single-layered case. The map <math id="S5.SS4.SSS2.p3.m1" class="ltx_Math" alttext="u_{prq}:\Sigma_{prq}\to\mathbb{CP}^{d_{pq}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi mathvariant="normal">Σ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">→</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">u_{prq}:\Sigma_{prq}\to\mathbb{CP}^{d_{pq}}</annotation></semantics></math> induces linear embeddings</p>
<table id="S5.EGx15" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.E39"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E39.m2" class="ltx_Math" alttext="\displaystyle\ \mathbb{CP}^{d_{pr}}\cong Y_{pr}\subset\mathbb{CP}^{d_{pq}},\ " display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></msup></mrow><mo>≅</mo><msub><mi>Y</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo>⊂</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ \mathbb{CP}^{d_{pr}}\cong Y_{pr}\subset\mathbb{CP}^{d_{pq}},\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.E39.m3" class="ltx_Math" alttext="\displaystyle\ \mathbb{CP}^{d_{rq}}\cong Y_{rq}\subset\mathbb{CP}^{d_{pq}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><msub><mi>d</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msup></mrow><mo>≅</mo><msub><mi>Y</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>⊂</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ \mathbb{CP}^{d_{rq}}\cong Y_{rq}\subset\mathbb{CP}^{d_{pq}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5.39)</span></td></tr></tbody>
</table>
<p id="S5.SS4.SSS2.p3.2" class="ltx_p">Indeed, using the notations similar to (<a href="#S5.EGx11" title="5.2.5. Boundary strata of the auxiliary moduli spaces ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.2.5</span></a>), the first embedding is</p>
<table id="S5.Ex173" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex173.m1" class="ltx_Math" alttext="[z_{0},\ldots,z_{d_{pr}}]\mapsto[z_{0},\ldots,z_{d_{pr}},\underbrace{0,\ldots,0}_{d_{rq}}]" display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mrow><msub><mi>z</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>z</mi><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></msub></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">↦</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>z</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>z</mi><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></msub><mo>,</mo><munder><munder accentunder="true"><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn></mrow><mo stretchy="true">⏟</mo></munder><msub><mi>d</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></munder></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">[z_{0},\ldots,z_{d_{pr}}]\mapsto[z_{0},\ldots,z_{d_{pr}},\underbrace{0,\ldots,0}_{d_{rq}}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS4.SSS2.p3.3" class="ltx_p">and the second embedding is</p>
<table id="S5.Ex174" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex174.m1" class="ltx_Math" alttext="[z_{0},\ldots,z_{d_{rq}}]\mapsto[a_{0}z_{0},\ldots,a_{d_{pr}}z_{0},z_{1},\ldots,z_{d_{rq}}]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">[</mo><mrow><msub><mi>z</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>z</mi><msub><mi>d</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msub></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">↦</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>a</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>z</mi><mn>0</mn></msub></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>a</mi><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>z</mi><mn>0</mn></msub></mrow><mo>,</mo><msub><mi>z</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>z</mi><msub><mi>d</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">[z_{0},\ldots,z_{d_{rq}}]\mapsto[a_{0}z_{0},\ldots,a_{d_{pr}}z_{0},z_{1},\ldots,z_{d_{rq}}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS4.SSS2.p3.4" class="ltx_p">Here <math id="S5.SS4.SSS2.p3.m2" class="ltx_Math" alttext="(a_{0},\ldots,a_{d_{pr}})\in\mathbb{C}^{d_{pr}+1}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>ℂ</mi><mrow><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo>+</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">(a_{0},\ldots,a_{d_{pr}})\in\mathbb{C}^{d_{pr}+1}</annotation></semantics></math> is the normalized evaluation of the first component at <math id="S5.SS4.SSS2.p3.m3" class="ltx_Math" alttext="z_{+}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mo>+</mo></msub><annotation encoding="application/x-tex">z_{+}</annotation></semantics></math>. Over these embeddings there are the natural bundle maps</p>
<table id="S5.EGx16" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.EGx16.1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
