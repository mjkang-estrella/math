 d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M 75.80693932313287 -33.59315206322644 L 76.36041088323302 -12.812294438120503" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 75.80693932313287 -33.59315206322644 L 76.36041088323302 -33.59315206322644" fill="none" stroke="#000000"></path> <g transform="translate(-13.67,0) translate(0,-43.89) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:1.38em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="19.03"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><msub><mi>V</mi><mi>α</mi></msub></span></span></foreignObject> </g> <path style="--ltx-stroke-color:#000000;" d="M 13.667035765942819 -44.170763378109 L 13.667035765942819 -43.61729181800886" fill="none" stroke="#000000"></path> <g transform="translate(55.26,0) translate(0,-43.89)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M 13.667035765942819 -44.170763378109 L 55.26054807762989 -43.61729181800886" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 55.26054807762989 -44.170763378109 L 55.26054807762989 -43.61729181800886" fill="none" stroke="#000000"></path> <g transform="translate(55.26,0) translate(0,-43.89) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:2.41em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.29em;font-size:10pt;" height="13.57" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="33.34"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi>V</mi><mi>β</mi></msub></mrow></span></span></foreignObject> </g> </g> </svg> </mtext><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lx@xy@svg{\hbox{\raise 2.5pt\hbox{\kern 9.87715pt\hbox{\ignorespaces\ignorespaces\ignorespaces\hbox{\vtop{\halign{\entry@#!@&amp;&amp;\entry@@#!@\cr&amp;\cr&amp;\crcr}}}\ignorespaces{\hbox{\kern-9.68445pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{R_{\alpha}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 17.57878pt\raise 6.4472pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-1.4139pt\hbox{$\scriptstyle{\phi_{\beta\alpha}}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 33.87715pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 0.0pt\raise-24.3889pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 33.87715pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{R_{\beta}|_{\partial^{\alpha}V_{\beta}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 54.98567pt\raise-24.27777pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern-9.87715pt\raise-31.72221pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{V_{\alpha}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 39.9368pt\raise-31.72221pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 39.9368pt\raise-31.72221pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\partial^{\alpha}V_{\beta}}$}}}}}}}\ignorespaces}}}}\ignorespaces.</annotation></semantics></math></td>
