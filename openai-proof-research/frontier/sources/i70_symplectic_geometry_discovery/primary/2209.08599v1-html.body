.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-0.4903pt\hbox{$\scriptstyle{{\bm{\iota}}_{\gamma\beta}}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 69.96165pt\raise-24.55556pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern-30.89998pt\raise-32.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{{\rm Stab}_{{\mathcal{F}}_{\gamma\alpha}}(C_{\alpha})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 33.73306pt\raise-38.41666pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-1.44444pt\hbox{$\scriptstyle{{\bm{\theta}}_{\gamma\alpha}}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 55.17625pt\raise-32.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 55.17625pt\raise-32.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\partial^{\alpha}C_{\gamma}}$}}}}}}}\ignorespaces}}}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I19.ix2.p1.2" class="ltx_p">It follows that</p>
<table id="S3.E12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E12.m1" class="ltx_Math" alttext="\pi_{\gamma\alpha}\circ(\iota_{\gamma\beta}|_{\partial^{\alpha}U_{\beta}})=\pi_{\beta\alpha}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>π</mi><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mrow><mo stretchy="false">(</mo><msub><mrow><msub><mi>ι</mi><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi>U</mi><mi>β</mi></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>π</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\pi_{\gamma\alpha}\circ(\iota_{\gamma\beta}|_{\partial^{\alpha}U_{\beta}})=\pi_{\beta\alpha}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.12)</span></td></tr></tbody>
</table>
</div></li>
<li id="S3.I19.ix3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(C)</span> 
<div id="S3.I19.ix3.p1" class="ltx_para">
<p id="S3.I19.ix3.p1.1" class="ltx_p">The bundle isomorphism (<a href="#S3.E10" title="In item 2 ‣ Definition 3.28. ‣ 3.5.2. Scaffolding ‣ 3.5. Additional structures ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.10</span></a>) preserves stratum. More precisely, for any triple of strata <math id="S3.I19.ix3.p1.m1" class="ltx_Math" alttext="\alpha\leq\beta\leq\gamma" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>≤</mo><mi>β</mi><mo>≤</mo><mi>γ</mi></mrow><annotation encoding="application/x-tex">\alpha\leq\beta\leq\gamma</annotation></semantics></math>, consider the following diagram</p>
<table id="S3.Ex87" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex87.m1" class="ltx_Math" alttext="\vbox{\lx@xy@svg{\hbox{\raise 0.0pt\hbox{\kern 46.79306pt\hbox{\ignorespaces\ignorespaces\ignorespaces\hbox{\vtop{\halign{\entry@#!@&amp;&amp;\entry@@#!@\cr&amp;&amp;&amp;\cr&amp;&amp;&amp;\cr&amp;&amp;&amp;\crcr}}}\ignorespaces{\hbox{\kern-39.05074pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\pi_{\gamma\alpha}^{*}\left({\mathcal{E}}_{\gamma}|_{{\mathcal{U}}_{\alpha}}\right)|_{\partial^{\alpha}{\mathcal{U}}_{\beta}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 66.89081pt\raise 7.57915pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-0.67085pt\hbox{$\scriptstyle{\vartheta_{\gamma\alpha}|_{\partial^{\alpha}{\mathcal{U}}_{\beta}}}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 154.21568pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\hbox{\kern 1.0pt\raise 0.0pt\hbox{\lx@xy@droprule}}\hbox{\kern-1.0pt\raise 0.0pt\hbox{\lx@xy@droprule}}}}\ignorespaces{}{\hbox{\hbox{\kern 1.0pt\raise 0.0pt\hbox{\lx@xy@droprule}}\hbox{\kern-1.0pt\raise 0.0pt\hbox{\lx@xy@droprule}}}}{\hbox{\hbox{\kern 1.0pt\raise 0.0pt\hbox{\lx@xy@droprule}}\hbox{\kern-1.0pt\raise 0.0pt\hbox{\lx@xy@droprule}}}}{\hbox{\kern 70.79306pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{}$}}}}}}}{\hbox{\kern 100.79306pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{}$}}}}}}}{\hbox{\kern 154.21568pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{{\mathcal{E}}_{\gamma}|_{\partial^{\alpha}{\mathcal{U}}_{\beta}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\hbox{\kern 1.0pt\raise 0.0pt\hbox{\lx@xy@droprule}}\hbox{\kern-1.0pt\raise 0.0pt\hbox{\lx@xy@droprule}}}}\ignorespaces{}{\hbox{\hbox{\kern 1.0pt\raise 0.0pt\hbox{\lx@xy@droprule}}\hbox{\kern-1.0pt\raise 0.0pt\hbox{\lx@xy@droprule}}}}{\hbox{\hbox{\kern 1.0pt\raise 0.0pt\hbox{\lx@xy@droprule}}\hbox{\kern-1.0pt\raise 0.0pt\hbox{\lx@xy@droprule}}}}{\hbox{\kern-27.73225pt\raise-32.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\pi_{\beta\alpha}^{*}\left({\mathcal{E}}_{\gamma}|_{{\mathcal{U}}_{\alpha}}\right)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\hbox{\kern 1.0pt\raise 0.0pt\hbox{\lx@xy@droprule}}\hbox{\kern-1.0pt\raise 0.0pt\hbox{\lx@xy@droprule}}}}\ignorespaces{}{\hbox{\hbox{\kern 1.0pt\raise 0.0pt\hbox{\lx@xy@droprule}}\hbox{\kern-1.0pt\raise 0.0pt\hbox{\lx@xy@droprule}}}}{\hbox{\hbox{\kern 1.0pt\raise 0.0pt\hbox{\lx@xy@droprule}}\hbox{\kern-1.0pt\raise 0.0pt\hbox{\lx@xy@droprule}}}}{\hbox{\kern 70.79306pt\raise-32.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{}$}}}}}}}{\hbox{\kern 100.79306pt\raise-32.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{}$}}}}}}}{\hbox{\kern 171.45415pt\raise-32.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{}$}}}}}}}{\hbox{\kern-46.79306pt\raise-64.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\pi_{\beta\alpha}^{*}\left({\mathcal{E}}_{\beta}|_{{\mathcal{U}}_{\alpha}}\oplus{\mathcal{F}}_{\gamma\beta}|_{{\mathcal{U}}_{\alpha}}\right)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\h