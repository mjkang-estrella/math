r:#000000;" d="M 86.05910581359399 -33.208800332088 L 86.61257737369414 -33.208800332088" fill="none" stroke="#000000"></path> <g transform="translate(-21.84,0) translate(0,-45.65) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:2.56em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.29em;font-size:10pt;" height="15.71" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="35.37"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><msubsup><mi>𝔸</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>pearl</mi></msubsup></span></span></foreignObject> </g> <path style="--ltx-stroke-color:#000000;" d="M 21.836600297711705 -45.925027951010534 L 21.836600297711705 -45.371556390910385" fill="none" stroke="#000000"></path> <g transform="translate(55.71,0) translate(0,-45.65)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M 21.836600297711705 -45.925027951010534 L 55.714194600110694 -45.371556390910385" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 55.714194600110694 -45.925027951010534 L 55.714194600110694 -45.371556390910385" fill="none" stroke="#000000"></path> <g transform="translate(55.71,0) translate(0,-45.65) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:3.83em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.29em;font-size:10pt;" height="15.71" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="52.94"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mrow><msup><mo>∂</mo><mo>+</mo></msup><msubsup><mi>𝔸</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>hmtp</mi></msubsup></mrow></span></span></foreignObject> </g> </g> </svg> </mtext><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\vbox{\lx@xy@svg{\hbox{\raise 0.0pt\hbox{\kern 16.26465pt\hbox{\ignorespaces\ignorespaces\ignorespaces\hbox{\vtop{\halign{\entry@#!@&amp;&amp;\entry@@#!@\cr&amp;\cr&amp;\crcr}}}\ignorespaces{\hbox{\kern-16.26465pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\overline{\mathcal{M}}{}_{xy}^{\rm Morse}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 41.51465pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 0.0pt\raise-24.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 41.51465pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\partial^{+}\overline{\mathcal{M}}{}_{xy}^{\rm hmtp}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 62.39491pt\raise-24.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern-15.7813pt\raise-32.99002pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{{\mathbb{A}}_{xy}^{\rm pearl}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 40.26465pt\raise-32.99002pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 40.26465pt\raise-32.99002pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\partial^{+}{\mathbb{A}}_{xy}^{\rm hmtp}}$}}}}}}}\ignorespaces}}}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.12)</span></td></tr></tbody>
</table>
</div></li>
<li id="S4.I5.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I5.i2.p1" class="ltx_para">
<p id="S4.I5.i2.p1.1" class="ltx_p">When the parameter <math id="S4.I5.i2.p1.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> hits <math id="S4.I5.i2.p1.m2" class="ltx_Math" alttext="-1" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">-1</annotation></semantics></math>, for each <math id="S4.I5.i2.p1.m3" class="ltx_Math" alttext="p\in{\mathcal{P}}^{\rm Floer}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Floer</mi></msup></mrow><annotation encoding="application/x-tex">p\in{\mathcal{P}}^{\rm Floer}</annotation></semantics></math>, there is a stratified embedding</p>
<table id="S4.E13" class="ltx_equation ltx_eqn_table">

