2em">×</mo><msup><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow><mrow><msub><mi>𝔽</mi><mi>α</mi></msub><mo>∖</mo><msub><mi>𝔽</mi><mi>β</mi></msub></mrow></msup></mrow></span></span></foreignObject> </g> <path style="--ltx-stroke-color:#000000;" d="M 59.72754960240245 -48.35340711805556 L 59.72754960240245 -47.79993555795541" fill="none" stroke="#000000"></path> <g transform="translate(115.51,0) translate(0,-38.07) translate(4.15,0) translate(0,-3.13)"> <foreignObject style="--ltx-fo-width:2.09em;--ltx-fo-height:0.65em;--ltx-fo-depth:0.2em;font-size:10pt;" height="11.71" overflow="visible" transform="matrix(1 0 0 -1 0 8.98)" width="28.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><msubsup><mi mathsize="0.700em">𝜽</mi><mrow><mi mathsize="0.710em">γ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">α</mi></mrow><mi mathsize="0.710em">collar</mi></msubsup></span></span></foreignObject> </g> <g transform="translate(208.52,0) translate(0,-48.08)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M 59.72754960240245 -48.35340711805556 L 208.5180561028197 -47.79993555795541" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 208.5180561028197 -48.35340711805556 L 208.5180561028197 -47.79993555795541" fill="none" stroke="#000000"></path> <g transform="translate(208.52,0) translate(0,-48.08) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:2.29em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.29em;font-size:10pt;" height="15.71" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="31.7"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mrow><msup><mo>∂</mo><mi>β</mi></msup><msub><mi>C</mi><mi>γ</mi></msub></mrow></span></span></foreignObject> </g> </g> </svg> </mtext><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lx@xy@svg{\hbox{\raise 2.5pt\hbox{\kern 80.88812pt\hbox{\ignorespaces\ignorespaces\ignorespaces\hbox{\vtop{\halign{\entry@#!@&amp;&amp;\entry@@#!@\cr&amp;&amp;\cr&amp;&amp;\crcr}}}\ignorespaces{\hbox{\kern-80.88812pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\Big({\rm Stab}_{{\mathcal{F}}_{\gamma\beta}|_{\partial^{\alpha}{\mathcal{U}}_{\beta}}}(\partial^{\alpha}C_{\beta})\Big)\times[0,\epsilon)^{{\mathbb{F}}_{\alpha}\setminus{\mathbb{F}}_{\beta}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 134.88812pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 0.0pt\raise-25.83275pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 104.88812pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{}$}}}}}}}{\hbox{\kern 134.88812pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{{\rm Stab}_{{\mathcal{F}}_{\gamma\beta}}(C_{\beta})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 165.14922pt\raise-25.75499pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern-43.16508pt\raise-34.74501pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\partial^{\alpha}C_{\gamma}\times[0,\epsilon)^{{\mathbb{F}}_{\alpha}\setminus{\mathbb{F}}_{\beta}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 83.47733pt\raise-27.51389pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-2.25891pt\hbox{$\scriptstyle{{\bm{\theta}}_{\gamma\alpha}^{\rm collar}}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 150.696pt\raise-34.74501pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 104.88812pt\raise-34.74501pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{}$}}}}}}}{\hbox{\kern 150.696pt\raise-34.74501pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\partial^{\beta}C_{\gamma}}$}}}}}}}\ignorespaces}}}}\ignorespaces.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I22.i2.p1.2" class="ltx_p">Here the horizontal arrows are induced from the collar structure and the vertical arrows are restrictions of the open chart embeddings associated to the stabilization and scaffolding.</p>
</div></li>
</ol>
</div>
</div>
<div id="S3.SS5.SSS4.p2" class="ltx_para">
<p id="S3.SS5.SSS4.p2.1" class="ltx_p">Finally we spell out the meaning of compatible straightenings.</p>
</div>
<div id="S3.Thmthm35" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm35.2" class="ltx_text ltx_font_bold">Definition 3.35</span></span><span id="S3.Thmthm35.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm35.p1" class="ltx_para">
<p id="S3.Thmthm35.p1.1" class="ltx_p">Consider a system of D-chart presentations equipped with a collar structure and a scaffolding which are compatible. Then a straightening (see Definition <a href="#S3.Thmthm31" title="Definition 3.31 (Straightenings). ‣ 3.5.3. Straightening ‣ 3.5. Additional structures ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.31</span></a>) is compatible with the collar structure and the scaffolding if the following conditions are satisfied.</p>
<ol id="S3.I23" class="ltx_enumerate">
<li id="S3.I23.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S3.I23.i1.p1" class="ltx_para">
<p id="S3.I23.i1.p1.1" class="ltx_p">For each pair <math id="S3.I23.i1.p1.m1" class="ltx_Math" alttext="\alpha&lt;\beta" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>&lt;</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">\alpha&lt;\beta</annotation></semantics></math>, near <math id="S3.I23.i1.p1.m2" class="ltx_Math" alttext="\partial^{\alpha}{\mathcal{U}}_{\beta}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>β</mi></msub></mrow><annotation encoding="application/x-tex">\partial^{\alpha}{\mathcal{U}}_{\beta}</annotation></semantics></math>, using the corner coordinates induced from the map <math id="S3.I23.i1.p1.m3" class="ltx_Math" alttext="\theta_{\beta\alpha}^{\rm collar}" display="inline" intent=":literal"><semantics><msubsup><mi>θ</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mi>collar</mi></msubsup><annotation encoding="application/x-tex">\theta_{\beta\alpha}^{\rm collar}</annotation></semantics></math>, near <math id="S3.I23.i1.p1.m4" class="ltx_Math" alttext="\partial^{\alpha}{\mathcal{U}}_{\beta}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>β</mi></msub></mrow><annotation encoding="application/x-tex">\partial^{\alpha}{\mathcal{U}}_{\beta}</annotation></semantics></math>, one has</p>
<table id="S3.E14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E14.m1" class="ltx_Math" alttext="g_{\beta}=g_{\beta}|_{\partial^{\alpha}{\mathcal{U}}_{\beta}}+\sum_{i\in{\mathbb{F}}_{\alpha}\setminus{\mathbb{F}}_{\beta}}dt_{i}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>g</mi><mi>β</mi></msub><mo>=</mo><mrow><msub><mrow><msub><mi>g</mi><mi>β</mi></msub><mo stretchy="false">|</mo></mrow><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>β</mi></msub></mrow></msub><mo rspace="0.055em">+</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><msub><mi>𝔽</mi><mi>α</mi></msub><mo>∖</mo><msub><mi>𝔽</mi><mi>β</mi></msub></mrow></mrow></munder><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>t</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">g_{\beta}=g_{\beta}|_{\partial^{\alpha}{\mathcal{U}}_{\beta}}+\sum_{i\in{\mathbb{F}}_{\alpha}\setminus{\mathbb{F}}_{\beta}}dt_{i}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.14)</span></td></tr></tbody>
</table>
<p id="S3.I23.i1.p1.2" class="ltx_p">Moreover, with respect to the bundle isomorphism <math id="S3.I23.i1.p1.m5" class="ltx_Math" alttext="\widehat{\theta}_{\beta\alpha}^{\rm collar}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mi>collar</mi></msubsup><annotation encoding="application/x-tex">\widehat{\theta}_{\beta\alpha}^{\rm collar}</annotation></semantics></math>, near <math id="S3.I23.i1.p1.m6" class="ltx_Math" alttext="\partial^{\alpha}{\mathcal{U}}_{\beta}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>β</mi></msub></mrow><annotation encoding="application/x-tex">\partial^{\alpha}{\mathcal{U}}_{\beta}</annotation></semantics></math> one has</p>
<table id="S3.Ex96" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex96.m1" class="ltx_Math" alttext="\nabla^{{\mathcal{E}}_{\beta}}=\left(\widehat{\pi}_{\beta\alpha}^{\rm collar}\right)^{*}\nabla^{{\mathcal{E}}_{\beta}}|_{\partial^{\alpha}{\mathcal{U}}_{\beta}}." display="block" intent=":literal"><semantics><mrow><mrow><msup><mo>∇</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>β</mi></msub></msup><mo>=</mo><msub><mrow><mrow><msup><mrow><mo>(</mo><msubsup><mover accent="true"><mi>π</mi><mo>^</mo></mover><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mi>collar</mi></msubsup><mo>)</mo></mrow><mo>∗</mo></msup><mo lspace="0.167em" rspace="0em">​</mo><msup><mo>∇</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>β</mi></msub></msup></mrow><mo stretchy="false">|</mo></mrow><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>β</mi></msub></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\nabla^{{\mathcal{E}}_{\beta}}=\left(\widehat{\pi}_{\beta\alpha}^{\rm collar}\right)^{*}\nabla^{{\mathcal{E}}_{\beta}}|_{\partial^{\alpha}{\mathcal{U}}_{\beta}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S3.I23.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S3.I23.i2.p1" class="ltx_para">
<p id="S3.I23.i2.p1.1" class="ltx_p">For each pair <math id="S3.I23.i2.p1.m1" class="ltx_Math" alttext="\alpha\leq\beta" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">\alpha\leq\beta</annotation></semantics></math>, the domain embedding</p>
<table id="S3.Ex97" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex97.m1" class="ltx_Math" alttext="\iota_{\beta\alpha}:{\mathcal{U}}_{\alpha}\hookrightarrow\partial^{\alpha}{\mathcal{U}}_{\beta}" display="block" intent=":literal"><semantics><mrow><msub><mi>ι</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>α</mi></msub><mo rspace="0.111em" stretchy="false">↪</mo><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>β</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\iota_{\beta\alpha}:{\mathcal{U}}_{\alpha}\hookrightarrow\partial^{\alpha}{\mathcal{U}}_{\beta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I23.i2.p1.2" class="ltx_p">is isometric and totally geodesic. The normal bundle of this embedding has an induced metric and metric connection. Via the stabilization map <math id="S3.I23.i2.p1.m2" class="ltx_Math" alttext="{\bm{\theta}}_{\beta\alpha}" display="inline" intent=":literal"><semantics><msub><mi>𝜽</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><annotation encoding="application/x-tex">{\bm{\theta}}_{\beta\alpha}</annotation></semantics></math> which embeds <math id="S3.I23.i2.p1.m3" class="ltx_Math" alttext="{\mathcal{F}}_{\beta\alpha}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{F}}_{\beta\alpha}</annotation></semantics></math> into <math id="S3.I23.i2.p1.m4" class="ltx_Math" alttext="{\mathcal{E}}_{\beta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>β</mi></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{\beta}</annotation></semantics></math>, the bundle <math id="S3.I23.i2.p1.m5" class="ltx_Math" alttext="{\mathcal{F}}_{\beta\alpha}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{F}}_{\beta\alpha}</annotation></semantics></math> then carries a metric and metric connection.</p>
</div></li>
<li id="S3.I23.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S3.I23.i3.p1" class="ltx_para">
<p id="S3.I23.i3.p1.1" class="ltx_p">The bundle embedding <math id="S3.I23.i3.p1.m1" class="ltx_Math" alttext="{\mathcal{F}}_{\beta\alpha}\hookrightarrow{\mathcal{E}}_{\beta}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo stretchy="false">↪</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>β</mi></msub></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{\beta\alpha}\hookrightarrow{\mathcal{E}}_{\beta}</annotation></semantics></math> preserves the connection.</p>
</div></li>
<li id="S3.I23.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S3.I23.i4.p1" class="ltx_para">
<p id="S3.I23.i4.p1.1" class="ltx_p">The stabilization map on the domain is isometric.</p>
</div></li>
<li id="S3.I23.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(5)</span> 
<div id="S3.I23.i5.p1" class="ltx_para">
<p id="S3.I23.i5.p1.1" class="ltx_p">Via the stabilization map (on the bundle), the connection on <math id="S3.I23.i5.p1.m1" class="ltx_Math" alttext="{\mathcal{E}}_{\beta}|_{\partial^{\alpha}{\mathcal{U}}_{\beta}}" display="inline" intent=":literal"><semantics><msub><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>β</mi></msub><mo stretchy="false">|</mo></mrow><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>β</mi></msub></mrow></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{\beta}|_{\partial^{\alpha}{\mathcal{U}}_{\beta}}</annotation></semantics></math> near the embedding image is the pullback connection, i.e., the direct sum of the pullback connections on <math id="S3.I23.i5.p1.m2" class="ltx_Math" alttext="{\mathcal{F}}_{\beta\alpha}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{F}}_{\beta\alpha}</annotation></semantics></math> and <math id="S3.I23.i5.p1.m3" class="ltx_Math" alttext="{\mathcal{E}}_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>α</mi></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{\alpha}</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
</div>
</section>
</section>
<section id="S3.SS6" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.6. </span>Normal complex structure and orientations on flow categories</h3>

<div id="S3.SS6.p1" class="ltx_para">
<p id="S3.SS6.p1.1" class="ltx_p">In order to carry out the FOP perturbations and define counts over <math id="S3.SS6.p1.m1" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>, we need to introduce normal complex structures on the derived orbifold lifts and certain orientation structures.</p>
</div>
<div id="S3.Thmthm36" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm36.2" class="ltx_text ltx_font_bold">Definition 3.36</span></span><span id="S3.Thmthm36.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm36.p1" class="ltx_para">
<p id="S3.Thmthm36.p1.1" class="ltx_p">Let <math id="S3.Thmthm36.p1.m1" class="ltx_Math" alttext="T^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">T^{\mathcal{P}}</annotation></semantics></math> be a flow category over <math id="S3.Thmthm36.p1.m2" class="ltx_Math" alttext="{\mathcal{P}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">{\mathcal{P}}</annotation></semantics></math> equipped with a derived orbifold lift <math id="S3.Thmthm36.p1.m3" class="ltx_Math" alttext="{\mathfrak{D}}^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\mathcal{P}}</annotation></semantics></math>, with the collection of derived orbifold presentations</p>
<table id="S3.Ex98" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex98.m1" class="ltx_math_unparsed" alttext="\big\{C_{pq}=({\mathcal{U}}_{pq},{\mathcal{E}}_{pq},{\mathcal{S}}_{pq},\psi_{pq})\big\}_{p\leq q}." display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">{</mo><msub><mi>C</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi>ψ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>p</mi><mo>≤</mo><mi>q</mi></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\big\{C_{pq}=({\mathcal{U}}_{pq},{\mathcal{E}}_{pq},{\mathcal{S}}_{pq},\psi_{pq})\big\}_{p\leq q}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm36.p1.2" class="ltx_p">Moreover, assume that <math id="S3.Thmthm36.p1.m4" class="ltx_Math" alttext="{\mathfrak{D}}^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\mathcal{P}}</annotation></semantics></math> has a scaffolding</p>
<table id="S3.Ex99" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex99.m1" class="ltx_Math" alttext="{\mathfrak{F}}^{\mathcal{P}}=\Big(\big({\mathcal{F}}_{\beta\alpha},{\bm{\theta}}_{\beta\alpha}\big)_{\alpha\leq\beta}\Big)_{p&lt;q}." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>𝔉</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><mo>=</mo><msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo>,</mo><msub><mi>𝜽</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow></msub><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mi>p</mi><mo>&lt;</mo><mi>q</mi></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathfrak{F}}^{\mathcal{P}}=\Big(\big({\mathcal{F}}_{\beta\alpha},{\bm{\theta}}_{\beta\alpha}\big)_{\alpha\leq\beta}\Big)_{p&lt;q}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm36.p1.3" class="ltx_p">Then a <span id="S3.Thmthm36.p1.3.1" class="ltx_text ltx_font_bold">normal complex structure</span> (or normally complex lift) on the pair <math id="S3.Thmthm36.p1.m5" class="ltx_Math" alttext="{\mathfrak{D}}^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\mathcal{P}}</annotation></semantics></math> and <math id="S3.Thmthm36.p1.m6" class="ltx_Math" alttext="{\mathfrak{F}}^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>𝔉</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">{\mathfrak{F}}^{\mathcal{P}}</annotation></semantics></math> consists of the following data.</p>
<ol id="S3.I24" class="ltx_enumerate">
<li id="S3.I24.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S3.I24.i1.p1" class="ltx_para">
<p id="S3.I24.i1.p1.1" class="ltx_p">A normal complex structure on each of the derived orbifold chart <math id="S3.I24.i1.p1.m1" class="ltx_Math" alttext="({\mathcal{U}}_{pq},{\mathcal{E}}_{pq},{\mathcal{S}}_{pq})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathcal{U}}_{pq},{\mathcal{E}}_{pq},{\mathcal{S}}_{pq})</annotation></semantics></math>.</p>
</div></li>
<li id="S3.I24.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S3.I24.i2.p1" class="ltx_para">
<p id="S3.I24.i2.p1.1" class="ltx_p">A complex structure on each of the orbifold vector bundles <math id="S3.I24.i2.p1.m1" class="ltx_Math" alttext="{\mathcal{F}}_{\beta\alpha}\to{\mathcal{U}}_{\alpha}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>α</mi></msub></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{\beta\alpha}\to{\mathcal{U}}_{\alpha}</annotation></semantics></math>.</p>
</div></li>
<li id="S3.I24.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S3.I24.i3.p1" class="ltx_para">
<p id="S3.I24.i3.p1.1" class="ltx_p">For any pair <math id="S3.I24.i3.p1.m1" class="ltx_Math" alttext="p,q\in{\mathcal{P}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow><annotation encoding="application/x-tex">p,q\in{\mathcal{P}}</annotation></semantics></math> with <math id="S3.I24.i3.p1.m2" class="ltx_Math" alttext="T^{\mathcal{P}}_{pq}\neq\emptyset" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>T</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><mo>≠</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">T^{\mathcal{P}}_{pq}\neq\emptyset</annotation></semantics></math> and any pair of strata <math id="S3.I24.i3.p1.m3" class="ltx_Math" alttext="\alpha\leq\beta" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">\alpha\leq\beta</annotation></semantics></math> in <math id="S3.I24.i3.p1.m4" class="ltx_Math" alttext="{\mathbb{A}}^{\mathcal{P}}_{pq}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><annotation encoding="application/x-tex">{\mathbb{A}}^{\mathcal{P}}_{pq}</annotation></semantics></math>, the underlying map of the germ equivalence (<a href="#S3.E8" title="In item 2 ‣ Definition 3.28. ‣ 3.5.2. Scaffolding ‣ 3.5. Additional structures ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.8</span></a>)</p>
<table id="S3.Ex100" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex100.m1" class="ltx_Math" alttext="\theta_{\beta\alpha}:{\rm Stab}_{{\mathcal{F}}_{\beta\alpha}}({\mathcal{U}}_{\alpha})\simeq\partial^{\alpha}{\mathcal{U}}_{\beta}" display="block" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>Stab</mi><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">≃</mo><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>β</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta_{\beta\alpha}:{\rm Stab}_{{\mathcal{F}}_{\beta\alpha}}({\mathcal{U}}_{\alpha})\simeq\partial^{\alpha}{\mathcal{U}}_{\beta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I24.i3.p1.2" class="ltx_p">respects the normal complex structures.</p>
</div></li>
<li id="S3.I24.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S3.I24.i4.p1" class="ltx_para">
<p id="S3.I24.i4.p1.1" class="ltx_p">Under the same assumptions as the previous item, the map</p>
<table id="S3.Ex101" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex101.m1" class="ltx_Math" alttext="\widehat{\theta}_{\beta\alpha}:\pi^{*}_{\beta\alpha}{\mathcal{E}}_{\alpha}\oplus\pi^{*}_{\beta\alpha}{\mathcal{F}}_{\beta\alpha}\to{\mathcal{E}}_{\beta}|_{\partial^{\alpha}U_{\beta}}" display="block" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><msubsup><mi>π</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>α</mi></msub></mrow><mo>⊕</mo><mrow><msubsup><mi>π</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub></mrow></mrow><mo stretchy="false">→</mo><msub><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>β</mi></msub><mo stretchy="false">|</mo></mrow><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi>U</mi><mi>β</mi></msub></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\widehat{\theta}_{\beta\alpha}:\pi^{*}_{\beta\alpha}{\mathcal{E}}_{\alpha}\oplus\pi^{*}_{\beta\alpha}{\mathcal{F}}_{\beta\alpha}\to{\mathcal{E}}_{\beta}|_{\partial^{\alpha}U_{\beta}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I24.i4.p1.2" class="ltx_p">intertwines with the normal complex structures.</p>
</div></li>
<li id="S3.I24.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(5)</span> 
<div id="S3.I24.i5.p1" class="ltx_para">
<p id="S3.I24.i5.p1.1" class="ltx_p">The splitting of orbifold vector bundles (<a href="#S3.E9" title="In item 2 ‣ Definition 3.28. ‣ 3.5.2. Scaffolding ‣ 3.5. Additional structures ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.9</span></a>) over <math id="S3.I24.i5.p1.m1" class="ltx_Math" alttext="{\mathcal{U}}_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>α</mi></msub><annotation encoding="application/x-tex">{\mathcal{U}}_{\alpha}</annotation></semantics></math>, the bundle isomorphism (<a href="#S3.E10" title="In item 2 ‣ Definition 3.28. ‣ 3.5.2. Scaffolding ‣ 3.5. Additional structures ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.10</span></a>), and the splitting (<a href="#S3.E11" title="In item (A) ‣ Definition 3.28. ‣ 3.5.2. Scaffolding ‣ 3.5. Additional structures ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.11</span></a>) respect the normal complex structures.</p>
</div></li>
<li id="S3.I24.i6" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(6)</span> 
<div id="S3.I24.i6.p1" class="ltx_para">
<p id="S3.I24.i6.p1.1" class="ltx_p">These (normal) complex structures admit a strict <math id="S3.I24.i6.p1.m1" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>-action in the obvious sense.</p>
</div></li>
</ol>
</div>
</div>
<div id="S3.Thmthm37" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm37.2" class="ltx_text ltx_font_bold">Definition 3.37</span></span><span id="S3.Thmthm37.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm37.p1" class="ltx_para">
<p id="S3.Thmthm37.p1.1" class="ltx_p">Let <math id="S3.Thmthm37.p1.m1" class="ltx_Math" alttext="T^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">T^{\mathcal{P}}</annotation></semantics></math>, <math id="S3.Thmthm37.p1.m2" class="ltx_Math" alttext="{\mathfrak{D}}^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\mathcal{P}}</annotation></semantics></math>, and <math id="S3.Thmthm37.p1.m3" class="ltx_Math" alttext="{\mathfrak{F}}^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>𝔉</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">{\mathfrak{F}}^{\mathcal{P}}</annotation></semantics></math> be as in Definition <a href="#S3.Thmthm36" title="Definition 3.36. ‣ 3.6. Normal complex structure and orientations on flow categories ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.36</span></a>. Suppose we are given a normal complex structure on the pair <math id="S3.Thmthm37.p1.m4" class="ltx_Math" alttext="{\mathfrak{D}}^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\mathcal{P}}</annotation></semantics></math> and <math id="S3.Thmthm37.p1.m5" class="ltx_Math" alttext="{\mathfrak{F}}^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>𝔉</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">{\mathfrak{F}}^{\mathcal{P}}</annotation></semantics></math>. Then a collar structure compatibile with <math id="S3.Thmthm37.p1.m6" class="ltx_Math" alttext="{\mathfrak{F}}^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>𝔉</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">{\mathfrak{F}}^{\mathcal{P}}</annotation></semantics></math> (see Definition <a href="#S3.Thmthm34" title="Definition 3.34. ‣ 3.5.4. Compatibility ‣ 3.5. Additional structures ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.34</span></a>) is said to be compatible with the normal complex structure if the collar maps intertwine with the normal complex structures.</p>
</div>
</div>
<div id="S3.Thmthm38" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm38.2" class="ltx_text ltx_font_italic">Remark 3.38</span></span><span id="S3.Thmthm38.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S3.Thmthm38.p1" class="ltx_para">
<p id="S3.Thmthm38.p1.1" class="ltx_p">Note that the complex structure on <math id="S3.Thmthm38.p1.m1" class="ltx_Math" alttext="{\mathcal{F}}_{\beta\alpha}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{F}}_{\beta\alpha}</annotation></semantics></math> and the normal complex structure on <math id="S3.Thmthm38.p1.m2" class="ltx_Math" alttext="{\mathcal{U}}_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>α</mi></msub><annotation encoding="application/x-tex">{\mathcal{U}}_{\alpha}</annotation></semantics></math> induce a normal complex structure on <math id="S3.Thmthm38.p1.m3" class="ltx_Math" alttext="{\rm Stab}_{{\mathcal{F}}_{\beta\alpha}}({\mathcal{U}}_{\alpha})" display="inline" intent=":literal"><semantics><mrow><msub><mi>Stab</mi><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\rm Stab}_{{\mathcal{F}}_{\beta\alpha}}({\mathcal{U}}_{\alpha})</annotation></semantics></math>. Moreover, due to the behavior of orbifold charts near the boundary and corners, <math id="S3.Thmthm38.p1.m4" class="ltx_Math" alttext="\partial^{\alpha}{\mathcal{U}}_{\beta}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>β</mi></msub></mrow><annotation encoding="application/x-tex">\partial^{\alpha}{\mathcal{U}}_{\beta}</annotation></semantics></math> indeed has a normal complex structure.</p>
</div>
</div>
<div id="S3.Thmthm39" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm39.2" class="ltx_text ltx_font_italic">Remark 3.39</span></span><span id="S3.Thmthm39.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S3.Thmthm39.p1" class="ltx_para">
<p id="S3.Thmthm39.p1.1" class="ltx_p">We could define the notion of normal complex structure in a more intrinsic way which does not rely on the choice of scaffoldings.</p>
</div>
</div>
<div id="S3.Thmthm40" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm40.2" class="ltx_text ltx_font_italic">Remark 3.40</span></span><span id="S3.Thmthm40.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S3.Thmthm40.p1" class="ltx_para">
<p id="S3.Thmthm40.p1.1" class="ltx_p">In our applications, the notion of normal complex structure is mostly useful for considering the space <math id="S3.Thmthm40.p1.m1" class="ltx_Math" alttext="{\mathcal{U}}_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>α</mi></msub><annotation encoding="application/x-tex">{\mathcal{U}}_{\alpha}</annotation></semantics></math>, as the orbifold vector bundles <math id="S3.Thmthm40.p1.m2" class="ltx_Math" alttext="{\mathcal{E}}_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>α</mi></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{\alpha}</annotation></semantics></math> and <math id="S3.Thmthm40.p1.m3" class="ltx_Math" alttext="{\mathcal{F}}_{\beta\alpha}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{F}}_{\beta\alpha}</annotation></semantics></math> would have fiberwise complex structures in practice.</p>
</div>
</div>
<div id="S3.SS6.p2" class="ltx_para">
<p id="S3.SS6.p2.1" class="ltx_p">The normal complex structure is concerned with the tangential structure on the normal directions to strata specified by the isomorphism classes of the isotropy groups on an orbifold. In particular, an unorientable manifold has a (trivial) normal complex structure when being viewed as an orbifold. To define algebraic counts, we need to define orientation structures on the flow categories and flow bimodules, which is an extra structure beyond the normal complex structure.</p>
</div>
<div id="S3.Thmthm41" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm41.2" class="ltx_text ltx_font_bold">Definition 3.41</span></span><span id="S3.Thmthm41.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm41.p1" class="ltx_para">
<p id="S3.Thmthm41.p1.1" class="ltx_p">Let <math id="S3.Thmthm41.p1.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> be a vector space over <math id="S3.Thmthm41.p1.m2" class="ltx_Math" alttext="{\mathbb{R}}" display="inline" intent=":literal"><semantics><mi>ℝ</mi><annotation encoding="application/x-tex">{\mathbb{R}}</annotation></semantics></math>. The <span id="S3.Thmthm41.p1.1.1" class="ltx_text ltx_font_bold">orientation line</span> <math id="S3.Thmthm41.p1.m3" class="ltx_Math" alttext="\mathfrak{o}_{V}" display="inline" intent=":literal"><semantics><msub><mi>𝔬</mi><mi>V</mi></msub><annotation encoding="application/x-tex">\mathfrak{o}_{V}</annotation></semantics></math> of <math id="S3.Thmthm41.p1.m4" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> is defined to be the free <math id="S3.Thmthm41.p1.m5" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>-module of rank <math id="S3.Thmthm41.p1.m6" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> given by <math id="S3.Thmthm41.p1.m7" class="ltx_Math" alttext="H_{\dim V}(V,V\setminus\{0\};{\mathbb{Z}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mrow><mo rspace="0.167em">dim</mo><mi>V</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mrow><mi>V</mi><mo>∖</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow><mo>,</mo><mi>ℤ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{\dim V}(V,V\setminus\{0\};{\mathbb{Z}})</annotation></semantics></math> with <math id="S3.Thmthm41.p1.m8" class="ltx_Math" alttext="{\mathbb{Z}}/2" display="inline" intent=":literal"><semantics><mrow><mi>ℤ</mi><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">{\mathbb{Z}}/2</annotation></semantics></math>-grading the mod <math id="S3.Thmthm41.p1.m9" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> reduction of <math id="S3.Thmthm41.p1.m10" class="ltx_Math" alttext="\dim V" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">dim</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">\dim V</annotation></semantics></math>. More generally, if <math id="S3.Thmthm41.p1.m11" class="ltx_Math" alttext="(V^{+},V^{-})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mo>+</mo></msup><mo>,</mo><msup><mi>V</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(V^{+},V^{-})</annotation></semantics></math> is a virtual vector space, its orientation line <math id="S3.Thmthm41.p1.m12" class="ltx_Math" alttext="\mathfrak{o}_{(V^{+},V^{-})}" display="inline" intent=":literal"><semantics><msub><mi>𝔬</mi><mrow><mo stretchy="false">(</mo><msup><mi>V</mi><mo>+</mo></msup><mo>,</mo><msup><mi>V</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">\mathfrak{o}_{(V^{+},V^{-})}</annotation></semantics></math> is defined to be the tensor product of orientation lines <math id="S3.Thmthm41.p1.m13" class="ltx_Math" alttext="\mathfrak{o}_{V^{+}}\otimes\mathfrak{o}_{V^{-}}^{\vee}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔬</mi><msup><mi>V</mi><mo>+</mo></msup></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi>𝔬</mi><msup><mi>V</mi><mo>−</mo></msup><mo>∨</mo></msubsup></mrow><annotation encoding="application/x-tex">\mathfrak{o}_{V^{+}}\otimes\mathfrak{o}_{V^{-}}^{\vee}</annotation></semantics></math>.</p>
</div>
</div>
<div id="S3.Thmthm42" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm42.2" class="ltx_text ltx_font_bold">Definition 3.42</span></span><span id="S3.Thmthm42.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm42.p1" class="ltx_para">
<p id="S3.Thmthm42.p1.1" class="ltx_p">An <math id="S3.Thmthm42.p1.m1" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-stratified derived orbifold chart <math id="S3.Thmthm42.p1.m2" class="ltx_Math" alttext="C=({\mathcal{U}},{\mathcal{E}},{\mathcal{S}})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C=({\mathcal{U}},{\mathcal{E}},{\mathcal{S}})</annotation></semantics></math> is called <span id="S3.Thmthm42.p1.1.1" class="ltx_text ltx_font_bold">orientable</span> if both <math id="S3.Thmthm42.p1.m3" class="ltx_Math" alttext="{\mathcal{U}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒰</mi><annotation encoding="application/x-tex">{\mathcal{U}}</annotation></semantics></math> and <math id="S3.Thmthm42.p1.m4" class="ltx_Math" alttext="{\mathcal{E}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">{\mathcal{E}}</annotation></semantics></math> are orientable. Given a connected component of an orientable derived orbifold chart, the <span id="S3.Thmthm42.p1.1.2" class="ltx_text ltx_font_bold">orientation line</span> <math id="S3.Thmthm42.p1.m5" class="ltx_Math" alttext="\mathfrak{o}_{C}" display="inline" intent=":literal"><semantics><msub><mi>𝔬</mi><mi>C</mi></msub><annotation encoding="application/x-tex">\mathfrak{o}_{C}</annotation></semantics></math> of <math id="S3.Thmthm42.p1.m6" class="ltx_Math" alttext="({\mathcal{U}},{\mathcal{E}},{\mathcal{S}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathcal{U}},{\mathcal{E}},{\mathcal{S}})</annotation></semantics></math> is defined to be the orientation line of the virtual vector space</p>
<table id="S3.Ex102" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex102.m1" class="ltx_Math" alttext="(T_{x}{\mathcal{U}},{\mathcal{E}}_{x})" display="block" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>x</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(T_{x}{\mathcal{U}},{\mathcal{E}}_{x})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm42.p1.2" class="ltx_p">for arbitrary <math id="S3.Thmthm42.p1.m7" class="ltx_Math" alttext="x\in{\mathcal{U}}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow><annotation encoding="application/x-tex">x\in{\mathcal{U}}</annotation></semantics></math> lying in the top stratum of <math id="S3.Thmthm42.p1.m8" class="ltx_Math" alttext="{\mathcal{U}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒰</mi><annotation encoding="application/x-tex">{\mathcal{U}}</annotation></semantics></math>.</p>
</div>
</div>
<div id="S3.SS6.p3" class="ltx_para">
<p id="S3.SS6.p3.1" class="ltx_p">If <math id="S3.SS6.p3.m1" class="ltx_Math" alttext="C=({\mathcal{U}},{\mathcal{E}},{\mathcal{S}})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C=({\mathcal{U}},{\mathcal{E}},{\mathcal{S}})</annotation></semantics></math> is an orientable <math id="S3.SS6.p3.m2" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-stratified derived orbifold chart, given an index <math id="S3.SS6.p3.m3" class="ltx_Math" alttext="\alpha\in{\mathbb{A}}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mi>𝔸</mi></mrow><annotation encoding="application/x-tex">\alpha\in{\mathbb{A}}</annotation></semantics></math>, the <math id="S3.SS6.p3.m4" class="ltx_Math" alttext="\partial^{\alpha}{\mathbb{A}}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mi>α</mi></msup><mi>𝔸</mi></mrow><annotation encoding="application/x-tex">\partial^{\alpha}{\mathbb{A}}</annotation></semantics></math>-stratified derived orbifold chart <math id="S3.SS6.p3.m5" class="ltx_Math" alttext="\partial^{\alpha}C=(\partial^{\alpha}{\mathcal{U}},{\mathcal{E}}|_{\partial^{\alpha}{\mathcal{U}}},{\mathcal{S}}|_{\partial^{\alpha}{\mathcal{U}}})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mo>∂</mo><mi>α</mi></msup><mi>C</mi></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">∂</mo><mi>α</mi></msup><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow><mo>,</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">|</mo></mrow><mrow><msup><mo>∂</mo><mi>α</mi></msup><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow></msub><mo>,</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">|</mo></mrow><mrow><msup><mo>∂</mo><mi>α</mi></msup><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\partial^{\alpha}C=(\partial^{\alpha}{\mathcal{U}},{\mathcal{E}}|_{\partial^{\alpha}{\mathcal{U}}},{\mathcal{S}}|_{\partial^{\alpha}{\mathcal{U}}})</annotation></semantics></math> is also orientable. Moreover, it is easy to see that there is a natural isomorphism</p>
<table id="S3.Ex103" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex103.m1" class="ltx_Math" alttext="\mathfrak{o}_{\partial^{\alpha}C}\xrightarrow{\sim}\mathfrak{o}_{C}\otimes(\mathfrak{o}_{\mathbb{R}}^{\vee})^{\otimes{\rm depth}(\alpha)}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔬</mi><mrow><msup><mo>∂</mo><mi>α</mi></msup><mi>C</mi></mrow></msub><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><mrow><msub><mi>𝔬</mi><mi>C</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>𝔬</mi><mi>ℝ</mi><mo>∨</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mi>depth</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathfrak{o}_{\partial^{\alpha}C}\xrightarrow{\sim}\mathfrak{o}_{C}\otimes(\mathfrak{o}_{\mathbb{R}}^{\vee})^{\otimes{\rm depth}(\alpha)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.Thmthm43" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm43.2" class="ltx_text ltx_font_bold">Definition 3.43</span></span><span id="S3.Thmthm43.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm43.p1" class="ltx_para">
<p id="S3.Thmthm43.p1.1" class="ltx_p">Suppose <math id="S3.Thmthm43.p1.m1" class="ltx_Math" alttext="T^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">T^{\mathcal{P}}</annotation></semantics></math>, <math id="S3.Thmthm43.p1.m2" class="ltx_Math" alttext="{\mathfrak{D}}^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\mathcal{P}}</annotation></semantics></math> and <math id="S3.Thmthm43.p1.m3" class="ltx_Math" alttext="{\mathfrak{F}}^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>𝔉</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">{\mathfrak{F}}^{\mathcal{P}}</annotation></semantics></math> are the same in Definition <a href="#S3.Thmthm36" title="Definition 3.36. ‣ 3.6. Normal complex structure and orientations on flow categories ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.36</span></a> An <span id="S3.Thmthm43.p1.1.1" class="ltx_text ltx_font_bold">orientation</span> of such a normally complex derived orbifold lift is given by:</p>
<ol id="S3.I25" class="ltx_enumerate">
<li id="S3.I25.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S3.I25.i1.p1" class="ltx_para">
<p id="S3.I25.i1.p1.1" class="ltx_p">A virtual vector space <math id="S3.I25.i1.p1.m1" class="ltx_Math" alttext="(V_{p}^{+},V_{p}^{-})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msubsup><mi>V</mi><mi>p</mi><mo>+</mo></msubsup><mo>,</mo><msubsup><mi>V</mi><mi>p</mi><mo>−</mo></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(V_{p}^{+},V_{p}^{-})</annotation></semantics></math> for each <math id="S3.I25.i1.p1.m2" class="ltx_Math" alttext="p\in{\mathcal{P}}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow><annotation encoding="application/x-tex">p\in{\mathcal{P}}</annotation></semantics></math>. Define <math id="S3.I25.i1.p1.m3" class="ltx_Math" alttext="\mathfrak{o}_{p}:=\mathfrak{o}_{(V_{p}^{+},V_{p}^{-})}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔬</mi><mi>p</mi></msub><mo>:=</mo><msub><mi>𝔬</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>V</mi><mi>p</mi><mo>+</mo></msubsup><mo>,</mo><msubsup><mi>V</mi><mi>p</mi><mo>−</mo></msubsup><mo stretchy="false">)</mo></mrow></msub></mrow><annotation encoding="application/x-tex">\mathfrak{o}_{p}:=\mathfrak{o}_{(V_{p}^{+},V_{p}^{-})}</annotation></semantics></math>.</p>
</div></li>
<li id="S3.I25.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S3.I25.i2.p1" class="ltx_para">
<p id="S3.I25.i2.p1.1" class="ltx_p">An isomorphism of orientation lines</p>
<table id="S3.E15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E15.m1" class="ltx_math_unparsed" alttext="\mathfrak{o}_{C_{pq}}\xrightarrow{\sim}\mathfrak{o}_{p}^{\vee}\otimes\mathfrak{o}_{q}^{.}" display="block" intent=":literal"><semantics><mrow><mi>𝔬</mi><msub><mrow></mrow><msub><mi>C</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msub><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><mi>𝔬</mi><msub><mrow></mrow><mi>p</mi></msub><msup><mrow></mrow><mo>∨</mo></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>𝔬</mi><msub><mrow></mrow><mi>q</mi></msub><msup><mrow></mrow><mo>.</mo></msup></mrow><annotation encoding="application/x-tex">\mathfrak{o}_{C_{pq}}\xrightarrow{\sim}\mathfrak{o}_{p}^{\vee}\otimes\mathfrak{o}_{q}^{.}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.15)</span></td></tr></tbody>
</table>
</div></li>
<li id="S3.I25.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S3.I25.i3.p1" class="ltx_para">
<p id="S3.I25.i3.p1.1" class="ltx_p">For <math id="S3.I25.i3.p1.m1" class="ltx_Math" alttext="p&lt;r&lt;q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mi>r</mi><mo>&lt;</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p&lt;r&lt;q</annotation></semantics></math>, an isomorphism of orientation lines</p>
<table id="S3.E16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E16.m1" class="ltx_Math" alttext="\mathfrak{o}_{C_{pr}}\otimes\mathfrak{o}_{C_{rq}}\otimes(\mathfrak{o}_{\mathcal{F}_{prq,pq}}\otimes\mathfrak{o}_{\mathcal{F}_{prq,pq}}^{\vee})\xrightarrow{\sim}\mathfrak{o}_{\partial^{prq}C_{pq}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔬</mi><msub><mi>C</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>𝔬</mi><msub><mi>C</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝔬</mi><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow></msub></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi>𝔬</mi><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow></msub><mo>∨</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><msub><mi>𝔬</mi><mrow><msup><mo>∂</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msup><msub><mi>C</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathfrak{o}_{C_{pr}}\otimes\mathfrak{o}_{C_{rq}}\otimes(\mathfrak{o}_{\mathcal{F}_{prq,pq}}\otimes\mathfrak{o}_{\mathcal{F}_{prq,pq}}^{\vee})\xrightarrow{\sim}\mathfrak{o}_{\partial^{prq}C_{pq}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.16)</span></td></tr></tbody>
</table>
</div></li>
<li id="S3.I25.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S3.I25.i4.p1" class="ltx_para">
<p id="S3.I25.i4.p1.1" class="ltx_p">The above isomorphisms are preserved by the <math id="S3.I25.i4.p1.m1" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>-action.</p>
</div></li>
</ol>
</div>
</div>
<div id="S3.SS6.p4" class="ltx_para">
<p id="S3.SS6.p4.1" class="ltx_p">Note that if the above derived orbifold lift is given an orientation, then for any <math id="S3.SS6.p4.m1" class="ltx_Math" alttext="\alpha\leq\beta" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">\alpha\leq\beta</annotation></semantics></math> in <math id="S3.SS6.p4.m2" class="ltx_Math" alttext="{\mathbb{A}}^{\rm Floer}_{pq}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>Floer</mi></msubsup><annotation encoding="application/x-tex">{\mathbb{A}}^{\rm Floer}_{pq}</annotation></semantics></math>, there is an isomorphism</p>
<table id="S3.Ex104" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex104.m1" class="ltx_Math" alttext="\mathfrak{o}_{C_{\alpha}}\xrightarrow{\sim}\mathfrak{o}_{\partial^{\alpha}C_{\beta}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔬</mi><msub><mi>C</mi><mi>α</mi></msub></msub><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><msub><mi>𝔬</mi><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi>C</mi><mi>β</mi></msub></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathfrak{o}_{C_{\alpha}}\xrightarrow{\sim}\mathfrak{o}_{\partial^{\alpha}C_{\beta}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.Thmthm44" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm44.2" class="ltx_text ltx_font_bold">Definition 3.44</span></span><span id="S3.Thmthm44.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm44.p1" class="ltx_para">
<p id="S3.Thmthm44.p1.1" class="ltx_p">Given a flow category <math id="S3.Thmthm44.p1.m1" class="ltx_Math" alttext="T^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">T^{\mathcal{P}}</annotation></semantics></math> endowed with a derived orbifold lift <math id="S3.Thmthm44.p1.m2" class="ltx_Math" alttext="{\mathfrak{D}}^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\mathcal{P}}</annotation></semantics></math>, a scaffolding <math id="S3.Thmthm44.p1.m3" class="ltx_Math" alttext="{\mathfrak{F}}^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>𝔉</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">{\mathfrak{F}}^{\mathcal{P}}</annotation></semantics></math>, and a compatible collar structure, if they are further endowed with a normal complex structure and orientation, we call such a datum an <span id="S3.Thmthm44.p1.1.1" class="ltx_text ltx_font_bold">oriented and normally complex derived orbifold lift</span> and abbreviate it as <math id="S3.Thmthm44.p1.m4" class="ltx_Math" alttext="{\mathfrak{D}}^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\mathcal{P}}</annotation></semantics></math>.</p>
</div>
</div>
<div id="S3.SS6.p5" class="ltx_para">
<p id="S3.SS6.p5.1" class="ltx_p">If we have a flow bimodule <math id="S3.SS6.p5.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> between <math id="S3.SS6.p5.m2" class="ltx_Math" alttext="T^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">T^{\mathcal{P}}</annotation></semantics></math> and <math id="S3.SS6.p5.m3" class="ltx_Math" alttext="T^{\mathcal{P}^{\prime}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msup><annotation encoding="application/x-tex">T^{\mathcal{P}^{\prime}}</annotation></semantics></math> such that these three objects admit a compatible derived orbifold lift, as well as a compatible scaffolding structure, one can spell out the meaning of a normal complex structure and an orientation on <math id="S3.SS6.p5.m4" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> similarly to Definition <a href="#S3.Thmthm36" title="Definition 3.36. ‣ 3.6. Normal complex structure and orientations on flow categories ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.36</span></a>.</p>
</div>
<div id="S3.Thmthm45" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm45.2" class="ltx_text ltx_font_bold">Definition 3.45</span></span><span id="S3.Thmthm45.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm45.p1" class="ltx_para">
<p id="S3.Thmthm45.p1.1" class="ltx_p">Let <math id="S3.Thmthm45.p1.m1" class="ltx_Math" alttext="T^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">T^{\mathcal{P}}</annotation></semantics></math> (resp. <math id="S3.Thmthm45.p1.m2" class="ltx_Math" alttext="T^{\mathcal{P}^{\prime}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msup><annotation encoding="application/x-tex">T^{\mathcal{P}^{\prime}}</annotation></semantics></math>) be flow categories endowed with a derived orbifold lift <math id="S3.Thmthm45.p1.m3" class="ltx_Math" alttext="{\mathfrak{D}}^{\mathcal{P}}=\{C^{\mathcal{P}}_{pq}\}_{p\leq q}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝔇</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><mo>=</mo><msub><mrow><mo stretchy="false">{</mo><msubsup><mi>C</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>p</mi><mo>≤</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">{\mathfrak{D}}^{\mathcal{P}}=\{C^{\mathcal{P}}_{pq}\}_{p\leq q}</annotation></semantics></math> (resp. <math id="S3.Thmthm45.p1.m4" class="ltx_Math" alttext="{\mathfrak{D}}^{\mathcal{P}^{\prime}}=\{C^{\mathcal{P}^{\prime}}_{p^{\prime}q^{\prime}}\}_{p^{\prime}\leq q^{\prime}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝔇</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msup><mo>=</mo><msub><mrow><mo stretchy="false">{</mo><msubsup><mi>C</mi><mrow><msup><mi>p</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>′</mo></msup></mrow><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msubsup><mo stretchy="false">}</mo></mrow><mrow><msup><mi>p</mi><mo>′</mo></msup><mo>≤</mo><msup><mi>q</mi><mo>′</mo></msup></mrow></msub></mrow><annotation encoding="application/x-tex">{\mathfrak{D}}^{\mathcal{P}^{\prime}}=\{C^{\mathcal{P}^{\prime}}_{p^{\prime}q^{\prime}}\}_{p^{\prime}\leq q^{\prime}}</annotation></semantics></math>) and a scaffolding</p>
<table id="S3.Ex105" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex105.m1" class="ltx_Math" alttext="{\mathfrak{F}}^{\mathcal{P}}=\Big(\big({\mathcal{F}}_{\beta\alpha}^{\mathcal{P}},{\bm{\theta}}_{\beta\alpha}\big)_{\alpha\leq\beta}\Big)_{p&lt;q}\text{ resp. }{\mathfrak{F}}^{\mathcal{P}^{\prime}}=\Big(\big({\mathcal{F}}_{\beta^{\prime}\alpha^{\prime}}^{\mathcal{P}^{\prime}},{\bm{\theta}}_{\beta^{\prime}\alpha^{\prime}}\big)_{\alpha^{\prime}\leq\beta^{\prime}}\Big)_{p^{\prime}&lt;q^{\prime}}." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>𝔉</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><mo>=</mo><mrow><msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><mo>,</mo><msub><mi>𝜽</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow></msub><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mi>p</mi><mo>&lt;</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mtext> resp. </mtext><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝔉</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msup></mrow><mo>=</mo><msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><msup><mi>β</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>α</mi><mo>′</mo></msup></mrow><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msubsup><mo>,</mo><msub><mi>𝜽</mi><mrow><msup><mi>β</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>α</mi><mo>′</mo></msup></mrow></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><msup><mi>α</mi><mo>′</mo></msup><mo>≤</mo><msup><mi>β</mi><mo>′</mo></msup></mrow></msub><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><msup><mi>p</mi><mo>′</mo></msup><mo>&lt;</mo><msup><mi>q</mi><mo>′</mo></msup></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathfrak{F}}^{\mathcal{P}}=\Big(\big({\mathcal{F}}_{\beta\alpha}^{\mathcal{P}},{\bm{\theta}}_{\beta\alpha}\big)_{\alpha\leq\beta}\Big)_{p&lt;q}\text{ resp. }{\mathfrak{F}}^{\mathcal{P}^{\prime}}=\Big(\big({\mathcal{F}}_{\beta^{\prime}\alpha^{\prime}}^{\mathcal{P}^{\prime}},{\bm{\theta}}_{\beta^{\prime}\alpha^{\prime}}\big)_{\alpha^{\prime}\leq\beta^{\prime}}\Big)_{p^{\prime}&lt;q^{\prime}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm45.p1.2" class="ltx_p">Moreover, both the pair <math id="S3.Thmthm45.p1.m5" class="ltx_Math" alttext="({\mathfrak{D}}^{\mathcal{P}},{\mathfrak{F}}^{\mathcal{P}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>𝔇</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><mo>,</mo><msup><mi>𝔉</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathfrak{D}}^{\mathcal{P}},{\mathfrak{F}}^{\mathcal{P}})</annotation></semantics></math> and the pair <math id="S3.Thmthm45.p1.m6" class="ltx_Math" alttext="({\mathfrak{D}}^{\mathcal{P}^{\prime}},{\mathfrak{F}}^{\mathcal{P}^{\prime}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>𝔇</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msup><mo>,</mo><msup><mi>𝔉</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathfrak{D}}^{\mathcal{P}^{\prime}},{\mathfrak{F}}^{\mathcal{P}^{\prime}})</annotation></semantics></math> have a normal complex structure in the sense of Definition <a href="#S3.Thmthm36" title="Definition 3.36. ‣ 3.6. Normal complex structure and orientations on flow categories ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.36</span></a>. Suppose <math id="S3.Thmthm45.p1.m7" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> is a flow bimodule from <math id="S3.Thmthm45.p1.m8" class="ltx_Math" alttext="T^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">T^{\mathcal{P}}</annotation></semantics></math> to <math id="S3.Thmthm45.p1.m9" class="ltx_Math" alttext="T^{\mathcal{P}^{\prime}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msup><annotation encoding="application/x-tex">T^{\mathcal{P}^{\prime}}</annotation></semantics></math> with a derived orbifold lift extending <math id="S3.Thmthm45.p1.m10" class="ltx_Math" alttext="{\mathfrak{D}}^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\mathcal{P}}</annotation></semantics></math> and <math id="S3.Thmthm45.p1.m11" class="ltx_Math" alttext="{\mathfrak{D}}^{\mathcal{P}^{\prime}}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\mathcal{P}^{\prime}}</annotation></semantics></math> (Definition <a href="#S3.Thmthm25" title="Definition 3.25. ‣ 3.4.4. Derived orbifold lifts of flow categories and bimodules ‣ 3.4. Derived orbifold charts with stratifications ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.25</span></a>)</p>
<table id="S3.Ex106" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex106.m1" class="ltx_math_unparsed" alttext="{\mathfrak{D}}^{M}=\Big(\big\{C^{M}_{pp^{\prime}}=({\mathcal{U}}^{M}_{pp^{\prime}},{\mathcal{E}}^{M}_{pp^{\prime}},{\mathcal{S}}^{M}_{pp^{\prime}},\psi^{M}_{pp^{\prime}})\big\}_{p\in{\mathcal{P}},p^{\prime}\in{\mathcal{P}}^{\prime}},{\bm{\iota}}^{M}_{pp^{\prime}}\Big)" display="block" intent=":literal"><semantics><mrow><msup><mi>𝔇</mi><mi>M</mi></msup><mo>=</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msub><mrow><mo stretchy="false">{</mo><msubsup><mi>C</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mi>M</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mi>M</mi></msubsup><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mi>M</mi></msubsup><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mi>M</mi></msubsup><mo>,</mo><msubsup><mi>ψ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mi>M</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mrow><mi>p</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow><mo>,</mo><mrow><msup><mi>p</mi><mo>′</mo></msup><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></mrow></mrow></msub><mo>,</mo><msubsup><mi>𝜾</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mi>M</mi></msubsup><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathfrak{D}}^{M}=\Big(\big\{C^{M}_{pp^{\prime}}=({\mathcal{U}}^{M}_{pp^{\prime}},{\mathcal{E}}^{M}_{pp^{\prime}},{\mathcal{S}}^{M}_{pp^{\prime}},\psi^{M}_{pp^{\prime}})\big\}_{p\in{\mathcal{P}},p^{\prime}\in{\mathcal{P}}^{\prime}},{\bm{\iota}}^{M}_{pp^{\prime}}\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm45.p1.3" class="ltx_p">and a scaffolding</p>
<table id="S3.Ex107" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex107.m1" class="ltx_Math" alttext="{\mathfrak{F}}^{M}=\big(\big\{{\mathcal{F}}_{\tilde{\beta}\tilde{\alpha}}^{M},{\bm{\theta}}_{\tilde{\beta}\tilde{\alpha}}^{M}\big\}_{\tilde{\alpha}\leq\tilde{\beta}}\big)_{\tilde{\alpha},\tilde{\beta}\in{\mathbb{A}}_{pp^{\prime}}^{M}}" display="block" intent=":literal"><semantics><mrow><msup><mi>𝔉</mi><mi>M</mi></msup><mo>=</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mrow><mo stretchy="false">{</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mover accent="true"><mi>β</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>α</mi><mo>~</mo></mover></mrow><mi>M</mi></msubsup><mo>,</mo><msubsup><mi>𝜽</mi><mrow><mover accent="true"><mi>β</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>α</mi><mo>~</mo></mover></mrow><mi>M</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mover accent="true"><mi>α</mi><mo>~</mo></mover><mo>≤</mo><mover accent="true"><mi>β</mi><mo>~</mo></mover></mrow></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mover accent="true"><mi>α</mi><mo>~</mo></mover><mo>,</mo><mrow><mover accent="true"><mi>β</mi><mo>~</mo></mover><mo>∈</mo><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mi>M</mi></msubsup></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">{\mathfrak{F}}^{M}=\big(\big\{{\mathcal{F}}_{\tilde{\beta}\tilde{\alpha}}^{M},{\bm{\theta}}_{\tilde{\beta}\tilde{\alpha}}^{M}\big\}_{\tilde{\alpha}\leq\tilde{\beta}}\big)_{\tilde{\alpha},\tilde{\beta}\in{\mathbb{A}}_{pp^{\prime}}^{M}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm45.p1.4" class="ltx_p">compatible with <math id="S3.Thmthm45.p1.m12" class="ltx_Math" alttext="{\mathfrak{F}}^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>𝔉</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">{\mathfrak{F}}^{\mathcal{P}}</annotation></semantics></math> and <math id="S3.Thmthm45.p1.m13" class="ltx_Math" alttext="{\mathfrak{F}}^{\mathcal{P}^{\prime}}" display="inline" intent=":literal"><semantics><msup><mi>𝔉</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msup><annotation encoding="application/x-tex">{\mathfrak{F}}^{\mathcal{P}^{\prime}}</annotation></semantics></math> (Definition <a href="#S3.Thmthm30" title="Definition 3.30. ‣ 3.5.2. Scaffolding ‣ 3.5. Additional structures ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.30</span></a>). Then a <span id="S3.Thmthm45.p1.4.1" class="ltx_text ltx_font_bold">normal complex structure</span> (or normally complex lift) on this datum extending or compatible with the given ones on <math id="S3.Thmthm45.p1.m14" class="ltx_Math" alttext="({\mathfrak{D}}^{\mathcal{P}},{\mathfrak{F}}^{\mathcal{P}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>𝔇</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><mo>,</mo><msup><mi>𝔉</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathfrak{D}}^{\mathcal{P}},{\mathfrak{F}}^{\mathcal{P}})</annotation></semantics></math> and <math id="S3.Thmthm45.p1.m15" class="ltx_Math" alttext="({\mathfrak{D}}^{\mathcal{P}^{\prime}},{\mathfrak{F}}^{\mathcal{P}^{\prime}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>𝔇</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msup><mo>,</mo><msup><mi>𝔉</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathfrak{D}}^{\mathcal{P}^{\prime}},{\mathfrak{F}}^{\mathcal{P}^{\prime}})</annotation></semantics></math> consists of the following data.</p>
<ol id="S3.I26" class="ltx_enumerate">
<li id="S3.I26.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S3.I26.i1.p1" class="ltx_para">
<p id="S3.I26.i1.p1.1" class="ltx_p">A normal complex structure on each of the derived orbifold chart <math id="S3.I26.i1.p1.m1" class="ltx_Math" alttext="({\mathcal{U}}^{M}_{pp^{\prime}},{\mathcal{E}}^{M}_{pp^{\prime}},{\mathcal{S}}^{M}_{pp^{\prime}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mi>M</mi></msubsup><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mi>M</mi></msubsup><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mi>M</mi></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathcal{U}}^{M}_{pp^{\prime}},{\mathcal{E}}^{M}_{pp^{\prime}},{\mathcal{S}}^{M}_{pp^{\prime}})</annotation></semantics></math>.</p>
</div></li>
<li id="S3.I26.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S3.I26.i2.p1" class="ltx_para">
<p id="S3.I26.i2.p1.1" class="ltx_p">A complex structure on the each of the orbifold vector bundles <math id="S3.I26.i2.p1.m1" class="ltx_Math" alttext="{\mathcal{F}}_{\tilde{\beta}\tilde{\alpha}}^{M}\to{\mathcal{U}}^{M}_{\alpha}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mover accent="true"><mi>β</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>α</mi><mo>~</mo></mover></mrow><mi>M</mi></msubsup><mo stretchy="false">→</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>α</mi><mi>M</mi></msubsup></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{\tilde{\beta}\tilde{\alpha}}^{M}\to{\mathcal{U}}^{M}_{\alpha}</annotation></semantics></math>.</p>
</div></li>
<li id="S3.I26.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S3.I26.i3.p1" class="ltx_para">
<p id="S3.I26.i3.p1.1" class="ltx_p">The germ equivalence <math id="S3.I26.i3.p1.m1" class="ltx_Math" alttext="\theta^{M}_{\tilde{\alpha},\tilde{\beta}}" display="inline" intent=":literal"><semantics><msubsup><mi>θ</mi><mrow><mover accent="true"><mi>α</mi><mo>~</mo></mover><mo>,</mo><mover accent="true"><mi>β</mi><mo>~</mo></mover></mrow><mi>M</mi></msubsup><annotation encoding="application/x-tex">\theta^{M}_{\tilde{\alpha},\tilde{\beta}}</annotation></semantics></math> and the bundle map covering it <math id="S3.I26.i3.p1.m2" class="ltx_Math" alttext="\widehat{\theta}^{M}_{\tilde{\alpha},\tilde{\beta}}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mrow><mover accent="true"><mi>α</mi><mo>~</mo></mover><mo>,</mo><mover accent="true"><mi>β</mi><mo>~</mo></mover></mrow><mi>M</mi></msubsup><annotation encoding="application/x-tex">\widehat{\theta}^{M}_{\tilde{\alpha},\tilde{\beta}}</annotation></semantics></math> all intertwine with the normal complex structures.</p>
</div></li>
<li id="S3.I26.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S3.I26.i4.p1" class="ltx_para">
<p id="S3.I26.i4.p1.1" class="ltx_p">Splittings or isomorphism of the form (<a href="#S3.E9" title="In item 2 ‣ Definition 3.28. ‣ 3.5.2. Scaffolding ‣ 3.5. Additional structures ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.9</span></a>), (<a href="#S3.E10" title="In item 2 ‣ Definition 3.28. ‣ 3.5.2. Scaffolding ‣ 3.5. Additional structures ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.10</span></a>), and (<a href="#S3.E11" title="In item (A) ‣ Definition 3.28. ‣ 3.5.2. Scaffolding ‣ 3.5. Additional structures ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.11</span></a>) all respect the (normal) complex structures.</p>
</div></li>
<li id="S3.I26.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(5)</span> 
<div id="S3.I26.i5.p1" class="ltx_para">
<p id="S3.I26.i5.p1.1" class="ltx_p">The respective (normal) complex structures are identified under the <math id="S3.I26.i5.p1.m1" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>-action.</p>
</div></li>
</ol>
</div>
</div>
<div id="S3.Thmthm46" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm46.2" class="ltx_text ltx_font_bold">Definition 3.46</span></span><span id="S3.Thmthm46.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm46.p1" class="ltx_para">
<p id="S3.Thmthm46.p1.1" class="ltx_p">Under the same setting as in Definition <a href="#S3.Thmthm45" title="Definition 3.45. ‣ 3.6. Normal complex structure and orientations on flow categories ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.45</span></a>, suppose we are given a compatible normal complex structure on the pair <math id="S3.Thmthm46.p1.m1" class="ltx_Math" alttext="{\mathfrak{D}}^{M}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>M</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{M}</annotation></semantics></math> and <math id="S3.Thmthm46.p1.m2" class="ltx_Math" alttext="{\mathfrak{F}}^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>𝔉</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">{\mathfrak{F}}^{\mathcal{P}}</annotation></semantics></math>. Then a collar structure compatibile with <math id="S3.Thmthm46.p1.m3" class="ltx_Math" alttext="{\mathfrak{F}}^{M}" display="inline" intent=":literal"><semantics><msup><mi>𝔉</mi><mi>M</mi></msup><annotation encoding="application/x-tex">{\mathfrak{F}}^{M}</annotation></semantics></math> (see Definition <a href="#S3.Thmthm34" title="Definition 3.34. ‣ 3.5.4. Compatibility ‣ 3.5. Additional structures ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.34</span></a>) is said to be compatible with the normal complex structure if the collar maps intertwine with the normal complex structures.</p>
</div>
</div>
<div id="S3.Thmthm47" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm47.2" class="ltx_text ltx_font_bold">Definition 3.47</span></span><span id="S3.Thmthm47.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm47.p1" class="ltx_para">
<p id="S3.Thmthm47.p1.1" class="ltx_p">Suppose <math id="S3.Thmthm47.p1.m1" class="ltx_Math" alttext="(T^{\mathcal{P}},{\mathfrak{D}}^{\mathcal{P}},{\mathfrak{F}}^{\mathcal{P}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><mo>,</mo><msup><mi>𝔇</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><mo>,</mo><msup><mi>𝔉</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(T^{\mathcal{P}},{\mathfrak{D}}^{\mathcal{P}},{\mathfrak{F}}^{\mathcal{P}})</annotation></semantics></math>, <math id="S3.Thmthm47.p1.m2" class="ltx_Math" alttext="(T^{\mathcal{P}^{\prime}},{\mathfrak{D}}^{\mathcal{P}^{\prime}},{\mathfrak{F}}^{\mathcal{P}^{\prime}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msup><mo>,</mo><msup><mi>𝔇</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msup><mo>,</mo><msup><mi>𝔉</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(T^{\mathcal{P}^{\prime}},{\mathfrak{D}}^{\mathcal{P}^{\prime}},{\mathfrak{F}}^{\mathcal{P}^{\prime}})</annotation></semantics></math>, and <math id="S3.Thmthm47.p1.m3" class="ltx_Math" alttext="(M,{\mathfrak{D}}^{M},{\mathfrak{F}}^{M})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><msup><mi>𝔇</mi><mi>M</mi></msup><mo>,</mo><msup><mi>𝔉</mi><mi>M</mi></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(M,{\mathfrak{D}}^{M},{\mathfrak{F}}^{M})</annotation></semantics></math> be the same as in Definition <a href="#S3.Thmthm45" title="Definition 3.45. ‣ 3.6. Normal complex structure and orientations on flow categories ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.45</span></a>. Moreover, assume that <math id="S3.Thmthm47.p1.m4" class="ltx_Math" alttext="({\mathfrak{D}}^{\mathcal{P}},{\mathfrak{F}}^{\mathcal{P}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>𝔇</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><mo>,</mo><msup><mi>𝔉</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathfrak{D}}^{\mathcal{P}},{\mathfrak{F}}^{\mathcal{P}})</annotation></semantics></math> and <math id="S3.Thmthm47.p1.m5" class="ltx_Math" alttext="({\mathfrak{D}}^{\mathcal{P}^{\prime}},{\mathfrak{F}}^{\mathcal{P}^{\prime}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>𝔇</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msup><mo>,</mo><msup><mi>𝔉</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathfrak{D}}^{\mathcal{P}^{\prime}},{\mathfrak{F}}^{\mathcal{P}^{\prime}})</annotation></semantics></math> are equipped with an orientation in the sense of Definition <a href="#S3.Thmthm43" title="Definition 3.43. ‣ 3.6. Normal complex structure and orientations on flow categories ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.43</span></a>. Then an <span id="S3.Thmthm47.p1.1.1" class="ltx_text ltx_font_bold">orientation</span> on the given normally complex lift of <math id="S3.Thmthm47.p1.m6" class="ltx_Math" alttext="{\mathfrak{D}}^{M}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>M</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{M}</annotation></semantics></math> and <math id="S3.Thmthm47.p1.m7" class="ltx_Math" alttext="{\mathfrak{F}}^{M}" display="inline" intent=":literal"><semantics><msup><mi>𝔉</mi><mi>M</mi></msup><annotation encoding="application/x-tex">{\mathfrak{F}}^{M}</annotation></semantics></math> is given by</p>
<ol id="S3.I27" class="ltx_enumerate">
<li id="S3.I27.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S3.I27.i1.p1" class="ltx_para">
<p id="S3.I27.i1.p1.1" class="ltx_p">An isomorphism of orientation lines</p>
<table id="S3.E17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E17.m1" class="ltx_Math" alttext="\mathfrak{o}_{C_{pp^{\prime}}^{M}}\xrightarrow{\sim}\mathfrak{o}_{p}^{\vee}\otimes\mathfrak{o}_{p^{\prime}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔬</mi><msubsup><mi>C</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mi>M</mi></msubsup></msub><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><mrow><msubsup><mi>𝔬</mi><mi>p</mi><mo>∨</mo></msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>𝔬</mi><msup><mi>p</mi><mo>′</mo></msup></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathfrak{o}_{C_{pp^{\prime}}^{M}}\xrightarrow{\sim}\mathfrak{o}_{p}^{\vee}\otimes\mathfrak{o}_{p^{\prime}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.17)</span></td></tr></tbody>
</table>
</div></li>
<li id="S3.I27.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S3.I27.i2.p1" class="ltx_para">
<p id="S3.I27.i2.p1.1" class="ltx_p">For <math id="S3.I27.i2.p1.m1" class="ltx_Math" alttext="p&lt;q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p&lt;q</annotation></semantics></math> and <math id="S3.I27.i2.p1.m2" class="ltx_Math" alttext="p^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>p</mi><mo>′</mo></msup><annotation encoding="application/x-tex">p^{\prime}</annotation></semantics></math>, an isomorphism of orientation lines</p>
<table id="S3.E18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E18.m1" class="ltx_Math" alttext="\mathfrak{o}_{C^{\mathcal{P}}_{pq}}\otimes\mathfrak{o}_{C^{M}_{qp^{\prime}}}\otimes(\mathfrak{o}_{\mathcal{F}^{M}_{pqp^{\prime},pq}}\otimes\mathfrak{o}_{\mathcal{F}^{M}_{pqp^{\prime},pq}}^{\vee})\xrightarrow{\sim}\mathfrak{o}_{\partial^{pqp^{\prime}}C_{pp^{\prime}}^{M}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔬</mi><msubsup><mi>C</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>𝔬</mi><msubsup><mi>C</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mi>M</mi></msubsup></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝔬</mi><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mo>,</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow><mi>M</mi></msubsup></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi>𝔬</mi><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mo>,</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow><mi>M</mi></msubsup><mo>∨</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><msub><mi>𝔬</mi><mrow><msup><mo>∂</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msup><msubsup><mi>C</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mi>M</mi></msubsup></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathfrak{o}_{C^{\mathcal{P}}_{pq}}\otimes\mathfrak{o}_{C^{M}_{qp^{\prime}}}\otimes(\mathfrak{o}_{\mathcal{F}^{M}_{pqp^{\prime},pq}}\otimes\mathfrak{o}_{\mathcal{F}^{M}_{pqp^{\prime},pq}}^{\vee})\xrightarrow{\sim}\mathfrak{o}_{\partial^{pqp^{\prime}}C_{pp^{\prime}}^{M}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.18)</span></td></tr></tbody>
</table>
</div></li>
<li id="S3.I27.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S3.I27.i3.p1" class="ltx_para">
<p id="S3.I27.i3.p1.1" class="ltx_p">For <math id="S3.I27.i3.p1.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> and <math id="S3.I27.i3.p1.m2" class="ltx_Math" alttext="q^{\prime}&lt;p^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mo>′</mo></msup><mo>&lt;</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">q^{\prime}&lt;p^{\prime}</annotation></semantics></math>, an isomorphism of orientation lines</p>
<table id="S3.E19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E19.m1" class="ltx_Math" alttext="\mathfrak{o}_{C^{M}_{pq^{\prime}}}\otimes\mathfrak{o}_{C^{\mathcal{P}^{\prime}}_{q^{\prime}p^{\prime}}}\otimes(\mathfrak{o}_{\mathcal{F}^{M}_{pq^{\prime}p^{\prime},pq}}\otimes\mathfrak{o}_{\mathcal{F}^{M}_{pq^{\prime}p^{\prime},pq}}^{\vee})\xrightarrow{\sim}\mathfrak{o}_{\partial^{pq^{\prime}p^{\prime}}C_{pp^{\prime}}^{M}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔬</mi><msubsup><mi>C</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>′</mo></msup></mrow><mi>M</mi></msubsup></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>𝔬</mi><msubsup><mi>C</mi><mrow><msup><mi>q</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msubsup></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝔬</mi><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mo>,</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow><mi>M</mi></msubsup></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi>𝔬</mi><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mo>,</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow><mi>M</mi></msubsup><mo>∨</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><msub><mi>𝔬</mi><mrow><msup><mo>∂</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msup><msubsup><mi>C</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mi>M</mi></msubsup></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathfrak{o}_{C^{M}_{pq^{\prime}}}\otimes\mathfrak{o}_{C^{\mathcal{P}^{\prime}}_{q^{\prime}p^{\prime}}}\otimes(\mathfrak{o}_{\mathcal{F}^{M}_{pq^{\prime}p^{\prime},pq}}\otimes\mathfrak{o}_{\mathcal{F}^{M}_{pq^{\prime}p^{\prime},pq}}^{\vee})\xrightarrow{\sim}\mathfrak{o}_{\partial^{pq^{\prime}p^{\prime}}C_{pp^{\prime}}^{M}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.19)</span></td></tr></tbody>
</table>
</div></li>
<li id="S3.I27.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S3.I27.i4.p1" class="ltx_para">
<p id="S3.I27.i4.p1.1" class="ltx_p">The above isomorphisms are preserved by the <math id="S3.I27.i4.p1.m1" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>-action.</p>
</div></li>
</ol>
</div>
</div>
<div id="S3.SS6.p6" class="ltx_para">
<p id="S3.SS6.p6.1" class="ltx_p">For a flow bimodule <math id="S3.SS6.p6.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> from <math id="S3.SS6.p6.m2" class="ltx_Math" alttext="T^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">T^{\mathcal{P}}</annotation></semantics></math> to <math id="S3.SS6.p6.m3" class="ltx_Math" alttext="T^{\mathcal{P}^{\prime}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msup><annotation encoding="application/x-tex">T^{\mathcal{P}^{\prime}}</annotation></semantics></math> as in Definition <a href="#S3.Thmthm45" title="Definition 3.45. ‣ 3.6. Normal complex structure and orientations on flow categories ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.45</span></a> (with <math id="S3.SS6.p6.m4" class="ltx_Math" alttext="{\mathfrak{D}}^{M}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>M</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{M}</annotation></semantics></math>, <math id="S3.SS6.p6.m5" class="ltx_Math" alttext="{\mathfrak{F}}^{M}" display="inline" intent=":literal"><semantics><msup><mi>𝔉</mi><mi>M</mi></msup><annotation encoding="application/x-tex">{\mathfrak{F}}^{M}</annotation></semantics></math> and a compatible collar structure), if it is further endowed with a orientation structure, we say it has an <span id="S3.SS6.p6.1.1" class="ltx_text ltx_font_bold">oriented and normally complex derived orbifold lift</span> and abbreviate as <math id="S3.SS6.p6.m6" class="ltx_Math" alttext="{\mathfrak{D}}^{M}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>M</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{M}</annotation></semantics></math>.</p>
</div>
</section>
<section id="S3.SS7" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.7. </span>Constructing FOP perturbations</h3>

<div id="S3.SS7.p1" class="ltx_para">
<p id="S3.SS7.p1.1" class="ltx_p">We extend the notion of FOP perturbations from the case of a single derived orbifold chart to the case of a derived orbifold lift of a flow category. The case of a flow bimodule is similar.</p>
</div>
<div id="S3.Thmthm48" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm48.2" class="ltx_text ltx_font_bold">Definition 3.48</span></span><span id="S3.Thmthm48.3" class="ltx_text ltx_font_bold"> </span>(Perturbations on a derived orbifold lift)<span id="S3.Thmthm48.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm48.p1" class="ltx_para">
<p id="S3.Thmthm48.p1.1" class="ltx_p">Given a derived orbifold lift <math id="S3.Thmthm48.p1.m1" class="ltx_Math" alttext="{\mathfrak{D}}^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\mathcal{P}}</annotation></semantics></math> of a flow category <math id="S3.Thmthm48.p1.m2" class="ltx_Math" alttext="T^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">T^{\mathcal{P}}</annotation></semantics></math> (see Definition <a href="#S3.Thmthm24" title="Definition 3.24. ‣ 3.4.4. Derived orbifold lifts of flow categories and bimodules ‣ 3.4. Derived orbifold charts with stratifications ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.24</span></a>).</p>
<ol id="S3.I28" class="ltx_enumerate">
<li id="S3.I28.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S3.I28.i1.p1" class="ltx_para">
<p id="S3.I28.i1.p1.1" class="ltx_p">A <span id="S3.I28.i1.p1.1.1" class="ltx_text ltx_font_bold">perturbation</span> on <math id="S3.I28.i1.p1.m1" class="ltx_Math" alttext="{\mathfrak{D}}^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\mathcal{P}}</annotation></semantics></math> consists of a system of smooth perturbations</p>
<table id="S3.Ex108" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex108.m1" class="ltx_math_unparsed" alttext="{\mathfrak{S}}^{\prime}=\Big({\mathcal{S}}_{pq}^{\prime}:{\mathcal{U}}_{pq}\to{\mathcal{E}}_{pq}\Big)_{p&lt;q}" display="block" intent=":literal"><semantics><mrow><msup><mi>𝔖</mi><mo>′</mo></msup><mo>=</mo><msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mi>p</mi><mo>&lt;</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">{\mathfrak{S}}^{\prime}=\Big({\mathcal{S}}_{pq}^{\prime}:{\mathcal{U}}_{pq}\to{\mathcal{E}}_{pq}\Big)_{p&lt;q}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I28.i1.p1.2" class="ltx_p">of the compact derived orbifold chart <math id="S3.I28.i1.p1.m2" class="ltx_Math" alttext="({\mathcal{U}}_{pq},{\mathcal{E}}_{pq},{\mathcal{S}}_{pq})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathcal{U}}_{pq},{\mathcal{E}}_{pq},{\mathcal{S}}_{pq})</annotation></semantics></math> (see Definition <a href="#S2.Thmthm1" title="Definition 2.1. ‣ 2.1.1. Derived orbifold charts ‣ 2.1. Orbifolds and the canonical Whitney stratification on 𝒵_𝑑 ‣ 2. Recap of the FOP natural transformation and multiplicativity ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.1</span></a>) such that the diagram (<a href="#S3.E6" title="In item 2 ‣ Definition 3.24. ‣ 3.4.4. Derived orbifold lifts of flow categories and bimodules ‣ 3.4. Derived orbifold charts with stratifications ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.6</span></a>) still commutes if we replace all <math id="S3.I28.i1.p1.m3" class="ltx_Math" alttext="{\mathcal{S}}_{pq}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{S}}_{pq}</annotation></semantics></math> by <math id="S3.I28.i1.p1.m4" class="ltx_Math" alttext="{\mathcal{S}}_{pq}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{S}}_{pq}^{\prime}</annotation></semantics></math>.</p>
</div></li>
<li id="S3.I28.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S3.I28.i2.p1" class="ltx_para">
<p id="S3.I28.i2.p1.1" class="ltx_p">Suppose the derived orbifold lift is equipped with a scaffolding (see Definition <a href="#S3.Thmthm28" title="Definition 3.28. ‣ 3.5.2. Scaffolding ‣ 3.5. Additional structures ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.28</span></a>). Then we say that a perturbation <math id="S3.I28.i2.p1.m1" class="ltx_Math" alttext="{\mathfrak{S}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝔖</mi><mo>′</mo></msup><annotation encoding="application/x-tex">{\mathfrak{S}}^{\prime}</annotation></semantics></math> <span id="S3.I28.i2.p1.1.1" class="ltx_text ltx_font_bold">respects the scaffolding</span> if the following is true. For each pair of strata <math id="S3.I28.i2.p1.m2" class="ltx_Math" alttext="\alpha\leq\beta" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">\alpha\leq\beta</annotation></semantics></math> of <math id="S3.I28.i2.p1.m3" class="ltx_Math" alttext="{\mathbb{A}}^{\mathcal{P}}_{pq}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><annotation encoding="application/x-tex">{\mathbb{A}}^{\mathcal{P}}_{pq}</annotation></semantics></math>, the datum <math id="S3.I28.i2.p1.m4" class="ltx_Math" alttext="{\mathfrak{S}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝔖</mi><mo>′</mo></msup><annotation encoding="application/x-tex">{\mathfrak{S}}^{\prime}</annotation></semantics></math> induces a perturbation <math id="S3.I28.i2.p1.m5" class="ltx_Math" alttext="{\mathcal{S}}_{\alpha}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>α</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{S}}_{\alpha}^{\prime}</annotation></semantics></math> of <math id="S3.I28.i2.p1.m6" class="ltx_Math" alttext="C_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>α</mi></msub><annotation encoding="application/x-tex">C_{\alpha}</annotation></semantics></math> and a perturbation <math id="S3.I28.i2.p1.m7" class="ltx_Math" alttext="{\mathcal{S}}_{\beta}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>β</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{S}}_{\beta}^{\prime}</annotation></semantics></math> of <math id="S3.I28.i2.p1.m8" class="ltx_Math" alttext="C_{\beta}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>β</mi></msub><annotation encoding="application/x-tex">C_{\beta}</annotation></semantics></math> by taking the product. Then we require</p>
<table id="S3.Ex109" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex109.m1" class="ltx_Math" alttext="{\mathcal{S}}_{\beta}^{\prime}|_{\partial^{\alpha}{\mathcal{U}}_{\beta}}={\rm Stab}_{{\mathcal{F}}_{\beta\alpha}}({\mathcal{S}}_{\alpha}^{\prime})." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>β</mi><mo>′</mo></msubsup><mo stretchy="false">|</mo></mrow><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>β</mi></msub></mrow></msub><mo>=</mo><mrow><msub><mi>Stab</mi><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>α</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{S}}_{\beta}^{\prime}|_{\partial^{\alpha}{\mathcal{U}}_{\beta}}={\rm Stab}_{{\mathcal{F}}_{\beta\alpha}}({\mathcal{S}}_{\alpha}^{\prime}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S3.I28.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S3.I28.i3.p1" class="ltx_para">
<p id="S3.I28.i3.p1.1" class="ltx_p">Suppose the derived orbifold lift is equipped with a collar structure. Then we say that a perturbation <math id="S3.I28.i3.p1.m1" class="ltx_Math" alttext="{\mathfrak{S}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝔖</mi><mo>′</mo></msup><annotation encoding="application/x-tex">{\mathfrak{S}}^{\prime}</annotation></semantics></math> <span id="S3.I28.i3.p1.1.1" class="ltx_text ltx_font_bold">respects the collar structure</span> if for each <math id="S3.I28.i3.p1.m2" class="ltx_Math" alttext="pq" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">pq</annotation></semantics></math> and each stratum <math id="S3.I28.i3.p1.m3" class="ltx_Math" alttext="\alpha\in{\mathbb{A}}_{pq}^{\mathcal{P}}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup></mrow><annotation encoding="application/x-tex">\alpha\in{\mathbb{A}}_{pq}^{\mathcal{P}}</annotation></semantics></math>, the following diagram commutes.</p>
<table id="S3.Ex110" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S3.Ex110.m1.pic1" class="ltx_picture ltx_markedasmath" height="85.62" overflow="visible" style="vertical-align:-65.60588882591973px" version="1.1" viewBox="111.81 65.61 301.03 85.62" width="301.03"><g transform="matrix(1 0 0 -1 111.81041843682976 85.61728289962987) translate(0,3.46) translate(111.81,0)"><g transform="translate(-64.39,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:8.71em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.37em;font-size:10pt;" height="16.87" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="120.48"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex110.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{(\pi_{pq,\alpha}^{\rm collar})^{*}({\mathcal{E}}_{pq}|_{\partial^{\alpha}{\mathcal{U}}_{pq}})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>π</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>α</mi></mrow><mi>collar</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{(\pi_{pq,\alpha}^{\rm collar})^{*}({\mathcal{E}}_{pq}|_{\partial^{\alpha}{\mathcal{U}}_{pq}})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 64.38923950955402 -0.27673578005007266 L 64.38923950955402 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(82.43,0) translate(0,10.01) translate(4.15,0) translate(0,-3.13)"><foreignObject style="--ltx-fo-width:2.19em;--ltx-fo-height:0.65em;--ltx-fo-depth:0.2em;font-size:10pt;" height="11.71" overflow="visible" transform="matrix(1 0 0 -1 0 8.98)" width="30.34"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex110.m1.pic1.m2" class="ltx_Math" alttext="\scriptstyle{\vartheta_{pq,\alpha}^{\rm collar}}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.700em">ϑ</mi><mrow><mrow><mi mathsize="0.710em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">q</mi></mrow><mo mathsize="0.710em">,</mo><mi mathsize="0.710em">α</mi></mrow><mi mathsize="0.710em">collar</mi></msubsup><annotation encoding="application/x-tex">\scriptstyle{\vartheta_{pq,\alpha}^{\rm collar}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(139.11,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 64.38923950955402 -0.27673578005007266 L 139.1090191431654 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 139.1090191431654 -0.27673578005007266 L 139.1090191431654 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(139.11,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:3.02em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.37em;font-size:10pt;" height="14.57" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="41.81"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content