;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 10.425783513376487 -0.27673578005007266 L 43.63458384546449 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 43.63458384546449 -0.27673578005007266 L 43.63458384546449 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(43.64,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.13em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="15.62"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.EGx19.m2.pic1.m3" class="ltx_Math" alttext="\textstyle{{\mathscr{E}}_{2}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">ℰ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\textstyle{{\mathscr{E}}_{2}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 67.56111251643144 -0.27673578005007266 L 67.56111251643144 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(73.69,0) translate(0,7.18) translate(4.15,0) translate(0,-1.14)"><foreignObject style="--ltx-fo-width:0.8em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.14em;font-size:10pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="11.1"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.EGx19.m2.pic1.m4" class="ltx_Math" alttext="\scriptstyle{p_{2}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">p</mi><mn mathsize="0.710em">2</mn></msub><annotation encoding="application/x-tex">\scriptstyle{p_{2}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(100.77,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 67.56111251643144 -0.27673578005007266 L 100.7698917349328 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 100.7698917349328 -0.27673578005007266 L 100.7698917349328 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(100.77,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.91em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="12.55"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.EGx19.m2.pic1.m5" class="ltx_Math" alttext="\textstyle{X}" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">\textstyle{X}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
