></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 17.06 34.42 L 54.8 10.37"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.84326 -0.5375 0.5375 0.84326 55.03 10.22)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 39.42 27.38)"><foreignObject style="--ltx-fo-width:0.8em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.14em;font-size:10pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="11.1"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex7.m1.pic1.m5" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces p_{1}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">p</mi><mn mathsize="0.710em">1</mn></msub><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces p_{1}}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 0 34.42 L 0 -33.87"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 0 -34.14)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -9.91 -2.42)"><foreignObject style="--ltx-fo-width:0.48em;--ltx-fo-height:0.49em;--ltx-fo-depth:0.14em;font-size:10pt;" height="8.61" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="6.65"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex7.m1.pic1.m6" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\phi}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">ϕ</mi><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\phi}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -55.27 10.07 L -17.52 34.12"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.84329 0.53745 -0.53745 0.84329 -17.29 34.27)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -50.04 26.88)"><foreignObject style="--ltx-fo-width:0.77em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.1em;font-size:10pt;" height="5.55" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="10.62"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex7.m1.pic1.m7" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces s_{1}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">s</mi><mn mathsize="0.710em">1</mn></msub><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces s_{1}}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -58.6 -10.07 L -19.08 -34.13"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.85408 -0.52014 0.52014 0.85408 -18.85 -34.28)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -52.48 -29.67)"><foreignObject style="--ltx-fo-width:0.77em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.1em;font-size:10pt;" height="5.55" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="10.62"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex7.m1.pic1.m8" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces s_{2}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">s</mi><mn mathsize="0.710em">2</mn></msub><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces s_{2}}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 18.61 -34.42 L 58.13 -10.36"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.85411 0.5201 -0.5201 0.85411 58.36 -10.21)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 41.86 -29.67)"><foreignObject style="--ltx-fo-width:0.8em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.14em;font-size:10pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="11.1"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex7.m1.pic1.m9" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces p_{2}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">p</mi><mn mathsize="0.710em">2</mn></msub><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces p_{2}}</annotation></semantics></math></span></span></foreignObject></g></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.I1.i3.p1.2" class="ltx_p">is said to be an <span id="S6.I1.i3.p1.2.1" class="ltx_text ltx_font_bold">isomorphism</span> if <math id="S6.I1.i3.p1.m1" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> maps <math id="S6.I1.i3.p1.m2" class="ltx_Math" alttext="{\mathscr{U}}_{1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">𝒰</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\mathscr{U}}_{1}</annotation></semantics></math> homeomorphically onto an open subset <math id="S6.I1.i3.p1.m3" class="ltx_Math" alttext="{\mathscr{U}}_{2}\subset{\mathscr{E}}_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒰</mi><mn>2</mn></msub><mo>⊂</mo><msub><mi class="ltx_font_mathscript">ℰ</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">{\mathscr{U}}_{2}\subset{\mathscr{E}}_{2}</annotation></semantics></math> containing <math id="S6.I1.i3.p1.m4" class="ltx_Math" alttext="s_{2}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{2}(X)</annotation></semantics></math>.</p>
</div></li>
<li id="S6.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S6.I1.i4.p1" class="ltx_para">
<p id="S6.I1.i4.p1.1" class="ltx_p">An <span id="S6.I1.i4.p1.1.1" class="ltx_text ltx_font_bold">isotopy</span> between two isomorphisms <math id="S6.I1.i4.p1.m1" class="ltx_Math" alttext="\phi_{0},\phi_{1}:{\mathscr{E}}\to{\mathscr{E}}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mn>0</mn></msub><mo>,</mo><mrow><msub><mi>ϕ</mi><mn>1</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathscript">ℰ</mi><mo stretchy="false">→</mo><msup><mi class="ltx_font_mathscript">ℰ</mi><mo>′</mo></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi_{0},\phi_{1}:{\mathscr{E}}\to{\mathscr{E}}^{\prime}</annotation></semantics></math> of microbundles over <math id="S6.I1.i4.p1.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is a family of microbundle isomorphisms <math id="S6.I1.i4.p1.m3" class="ltx_Math" alttext="\tilde{\phi}_{t}:{\mathscr{E}}\to{\mathscr{E}}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover><mi>t</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathscript">ℰ</mi><mo stretchy="false">→</mo><msup><mi class="ltx_font_mathscript">ℰ</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\tilde{\phi}_{t}:{\mathscr{E}}\to{\mathscr{E}}^{\prime}</annotation></semantics></math>, <math id="S6.I1.i4.p1.m4" class="ltx_Math" alttext="t\in[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[0,1]</annotation></semantics></math> which defines a continuous map from <math id="S6.I1.i4.p1.m5" class="ltx_Math" alttext="{\mathscr{E}}\times[0,1]\to{\mathscr{E}}^{\prime}" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathscript">ℰ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">→</mo><msup><mi class="ltx_font_mathscript">ℰ</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">{\mathscr{E}}\times[0,1]\to{\mathscr{E}}^{\prime}</annotation></semantics></math>, such that <math id="S6.I1.i4.p1.m6" class="ltx_Math" alttext="\tilde{\phi}_{0}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover><mn>0</mn></msub><annotation encoding="application/x-tex">\tilde{\phi}_{0}</annotation></semantics></math> is equivalent to <math id="S6.I1.i4.p1.m7" class="ltx_Math" alttext="\phi_{0}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\phi_{0}</annotation></semantics></math> and <math id="S6.I1.i4.p1.m8" class="ltx_Math" alttext="\tilde{\phi}_{1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ϕ</mi><mo>~</mo></mover><mn>1</mn></msub><annotation encoding="application/x-tex">\tilde{\phi}_{1}</annotation></semantics></math> is equivalent to <math id="S6.I1.i4.p1.m9" class="ltx_Math" alttext="\phi_{1}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\phi_{1}</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
</div>
<div id="S6.Thmthm2" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm2.2" class="ltx_text ltx_font_italic">Example 6.2</span></span><span id="S6.Thmthm2.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S6.Thmthm2.p1" class="ltx_para">
<ol id="S6.I2" class="ltx_enumerate">
<li id="S6.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S6.I2.i1.p1" class="ltx_para">
<p id="S6.I2.i1.p1.1" class="ltx_p">If <math id="S6.I2.i1.p1.m1" class="ltx_Math" alttext="p:E\to X" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>E</mi><mo stretchy="false">→</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">p:E\to X</annotation></semantics></math> is an ordinary real vector bundle, then together with the zero section <math id="S6.I2.i1.p1.m2" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> defines a microbundle over <math id="S6.I2.i1.p1.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. We denote this microbundle by <math id="S6.I2.i1.p1.m4" class="ltx_Math" alttext="E_{\mu}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>μ</mi></msub><annotation encoding="application/x-tex">E_{\mu}</annotation></semantics></math>.</p>
</div></li>
<li id="S6.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S6.I2.i2.p1" class="ltx_para">
<p id="S6.I2.i2.p1.1" class="ltx_p">Let <math id="S6.I2.i2.p1.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> be a topological manifold. The <span id="S6.I2.i2.p1.1.1" class="ltx_text ltx_font_bold">tangent microbundle</span> is the diagram</p>
<table id="S6.EGx20" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.EGx20.1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><span class="ltx_inline-block"><svg id="S6.EGx20.m1.pic1" class="ltx_picture ltx_markedasmath" height="23.68" overflow="visible" style="vertical-align:-8.763426383105456px" version="1.1" viewBox="10.43 8.76 158.43 23.68" width="158.43"><g transform="matrix(1 0 0 -1 10.425783513376487 23.68433471865487) translate(0,3.46) translate(10.43,0)"><g transform="translate(-10.43,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.91em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="12.55"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.EGx20.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{X\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">\textstyle{X\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 10.425783513376487 -0.27673578005007266 L 10.425783513376487 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(18.33,0) translate(0,7.46) translate(4.15,0) translate(0,-3.31)"><foreignObject style="--ltx-fo-width:0.66em;--ltx-fo-height:0.48em;--ltx-fo-depth:0em;font-size:10pt;" height="6.62" overflow="visible" transform="matrix(1 0 0 -1 0 6.62)" width="9.09"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.EGx20.m1.pic1.m2" class="ltx_Math" alttext="\scriptstyle{\Delta}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em" mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\scriptstyle{\Delta}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(43.64,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 10.425783513376487 -0.27673578005007266 L 43.63458384546449 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 43.63458384546449 -0.27673578005007266 L 43.63458384546449 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(43.64,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:3.04em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.08em;font-size:10pt;" height="10.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="42.01"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.EGx20.m1.pic1.m3" class="ltx_Math" alttext="\textstyle{X\times X\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">\textstyle{X\times X\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 93.94728957625269 -0.27673578005007266 L 93.94728957625269 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(100.85,0) translate(0,7.18) translate(4.15,0) translate(0,-1.14)"><foreignObject style="--ltx-fo-width:0.8em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.14em;font-size:10pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="11.1"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.EGx20.m1.pic1.m4" class="ltx_Math" alttext="\scriptstyle{p_{1}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">p</mi><mn mathsize="0.710em">1</mn></msub><annotation encoding="application/x-tex">\scriptstyle{p_{1}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(127.16,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 93.94728957625269 -0.27673578005007266 L 127.15608990834069 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 127.15608990834069 -0.27673578005007266 L 127.15608990834069 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(127.16,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.91em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="12.55"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.EGx20.m1.pic1.m5" class="ltx_Math" alttext="\textstyle{X}" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">\textstyle{X}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.I2.i2.p1.2" class="ltx_p">where <math id="S6.I2.i2.p1.m2" class="ltx_Math" alttext="p_{1}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mn>1</mn></msub><annotation encoding="application/x-tex">p_{1}</annotation></semantics></math> is the projection onto the first factor. We denote the tangent microbundle of <math id="S6.I2.i2.p1.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> by <math id="S6.I2.i2.p1.m4" class="ltx_Math" alttext="T_{\mu}X" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">T_{\mu}X</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
</div>
<div id="S6.SS1.SSS1.p2" class="ltx_para">
<p id="S6.SS1.SSS1.p2.1" class="ltx_p">If a topological manifold admits a smooth structure, then its tangent microbundle is isomorphic to the associated tangent bundle. In general, a microbundle <math id="S6.SS1.SSS1.p2.m1" class="ltx_Math" alttext="{\mathscr{E}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">ℰ</mi><annotation encoding="application/x-tex">{\mathscr{E}}</annotation></semantics></math> over a space <math id="S6.SS1.SSS1.p2.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> may or may not come from a vector bundle. We recall the following definition.</p>
</div>
<div id="S6.Thmthm3" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm3.2" class="ltx_text ltx_font_bold">Definition 6.3</span></span><span id="S6.Thmthm3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmthm3.p1" class="ltx_para">
<p id="S6.Thmthm3.p1.1" class="ltx_p">Let <math id="S6.Thmthm3.p1.m1" class="ltx_Math" alttext="{\mathscr{E}}\to X" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathscript">ℰ</mi><mo stretchy="false">→</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">{\mathscr{E}}\to X</annotation></semantics></math> be a microbundle. A <span id="S6.Thmthm3.p1.1.1" class="ltx_text ltx_font_bold">vector bundle lift</span> (or <span id="S6.Thmthm3.p1.1.2" class="ltx_text ltx_font_bold">vector bundle reduction</span>) of <math id="S6.Thmthm3.p1.m2" class="ltx_Math" alttext="{\mathscr{E}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">ℰ</mi><annotation encoding="application/x-tex">{\mathscr{E}}</annotation></semantics></math> is a vector bundle <math id="S6.Thmthm3.p1.m3" class="ltx_Math" alttext="E\to X" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo stretchy="false">→</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">E\to X</annotation></semantics></math> together with a microbundle isomorphism <math id="S6.Thmthm3.p1.m4" class="ltx_Math" alttext="E_{\mu}\to{\mathscr{E}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mi>μ</mi></msub><mo stretchy="false">→</mo><mi class="ltx_font_mathscript">ℰ</mi></mrow><annotation encoding="application/x-tex">E_{\mu}\to{\mathscr{E}}</annotation></semantics></math>.</p>
</div>
</div>
<div id="S6.SS1.SSS1.p3" class="ltx_para">
<p id="S6.SS1.SSS1.p3.1" class="ltx_p">Microbundles have many properties similar to vector bundles. One can construct microbundles by taking certain operations.</p>
</div>
<div id="S6.Thmthm4" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm4.2" class="ltx_text ltx_font_bold">Definition 6.4</span></span><span id="S6.Thmthm4.3" class="ltx_text ltx_font_bold"> </span>(Direct sums of microbundles)<span id="S6.Thmthm4.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmthm4.p1" class="ltx_para">
<p id="S6.Thmthm4.p1.1" class="ltx_p">Let <span class="ltx_inline-block"><svg id="S6.Thmthm4.p1.m1.pic1" class="ltx_picture ltx_markedasmath" height="24.04" overflow="visible" style="vertical-align:-9.685900096859001px" version="1.1" viewBox="10.43 9.69 130.45 24.04" width="130.45"><g transform="matrix(1 0 0 -1 10.425783513376487 24.04176662683124) translate(0,3.46) translate(10.43,0)"><g transform="translate(-10.43,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.91em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="12.55"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Thmthm4.p1.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{X\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">\textstyle{X\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 10.425783513376487 -0.27673578005007266 L 10.425783513376487 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(18.44,0) translate(0,6.93) translate(4.15,0) translate(0,-1.39)"><foreignObject style="--ltx-fo-width:0.69em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.1em;font-size:10pt;" height="5.55" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="9.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Thmthm4.p1.m1.pic1.m2" class="ltx_Math" alttext="\scriptstyle{s_{i}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">s</mi><mi mathsize="0.710em">i</mi></msub><annotation encoding="application/x-tex">\scriptstyle{s_{i}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(43.64,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 10.425783513376487 -0.27673578005007266 L 43.63458384546449 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 43.63458384546449 -0.27673578005007266 L 43.63458384546449 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(43.64,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.01em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="14.02"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Thmthm4.p1.m1.pic1.m3" class="ltx_Math" alttext="\textstyle{{\mathscr{E}}_{i}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">ℰ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\textstyle{{\mathscr{E}}_{i}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 65.96038594555357 -0.27673578005007266 L 65.96038594555357 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(73,0) translate(0,7.18) translate(4.15,0) translate(0,-1.14)"><foreignObject style="--ltx-fo-width:0.73em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.14em;font-size:10pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="10.09"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Thmthm4.p1.m1.pic1.m4" class="ltx_Math" alttext="\scriptstyle{p_{i}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">p</mi><mi mathsize="0.710em">i</mi></msub><annotation encoding="application/x-tex">\scriptstyle{p_{i}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(99.17,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 65.96038594555357 -0.27673578005007266 L 99.16918627764157 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 99.16918627764157 -0.27673578005007266 L 99.16918627764157 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(99.17,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.91em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="12.55"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Thmthm4.p1.m1.pic1.m5" class="ltx_Math" alttext="\textstyle{X}" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">\textstyle{X}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span>, <math id="S6.Thmthm4.p1.m2" class="ltx_Math" alttext="i=1,2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">i=1,2</annotation></semantics></math> be two microbundles and let <math id="S6.Thmthm4.p1.m3" class="ltx_Math" alttext="\Delta:X\to X\times X" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>X</mi><mo stretchy="false">→</mo><mrow><mi>X</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>X</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta:X\to X\times X</annotation></semantics></math> be the diagonal inclusion map. Let</p>
<table id="S6.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex8.m1" class="ltx_Math" alttext="{\mathscr{E}}_{12}:=(p_{1}\times p_{2})^{-1}(\Delta(X))\subset{\mathscr{E}}_{1}\times{\mathscr{E}}_{2}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathscript">ℰ</mi><mn>12</mn></msub><mo>:=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>p</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>p</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><msub><mi class="ltx_font_mathscript">ℰ</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi class="ltx_font_mathscript">ℰ</mi><mn>2</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathscr{E}}_{12}:=(p_{1}\times p_{2})^{-1}(\Delta(X))\subset{\mathscr{E}}_{1}\times{\mathscr{E}}_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.Thmthm4.p1.2" class="ltx_p">Then the <span id="S6.Thmthm4.p1.2.1" class="ltx_text ltx_font_bold">direct sum</span> of <math id="S6.Thmthm4.p1.m4" class="ltx_Math" alttext="{\mathscr{E}}_{1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">ℰ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\mathscr{E}}_{1}</annotation></semantics></math> and <math id="S6.Thmthm4.p1.m5" class="ltx_Math" alttext="{\mathscr{E}}_{2}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">ℰ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">{\mathscr{E}}_{2}</annotation></semantics></math> is the microbundle</p>
<table id="S6.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex9.m1" class="ltx_Math" alttext="\lx@xy@svg{\hbox{\raise 2.5pt\hbox{\kern 7.53471pt\hbox{\ignorespaces\ignorespaces\ignorespaces\hbox{\vtop{\halign{\entry@#!@&amp;&amp;\entry@@#!@\cr&amp;&amp;&amp;&amp;\crcr}}}\ignorespaces{\hbox{\kern-7.53471pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{X\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 12.27419pt\raise 6.5pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-1.75pt\hbox{$\scriptstyle{(s_{1}\times s_{2})\circ\Delta}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 61.53471pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 31.53471pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{}$}}}}}}}{\hbox{\kern 61.53471pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{{\mathscr{E}}_{12}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 95.66237pt\raise 5.84723pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-1.48613pt\hbox{$\scriptstyle{p_{1}\times p_{2}}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 136.81255pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 106.81255pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{}$}}}}}}}{\hbox{\kern 136.81255pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\Delta(X)\cong X}$}}}}}}}\ignorespaces}}}}\ignorespaces." display="block" intent=":literal"><semantics><mrow><mtext> <svg style="vertical-align:-11.069600110696001px" height="29.06" overflow="visible" version="1.1" viewBox="10.43 11.07 273.49 29.06" width="273.49"> <g transform="matrix(1 0 0 -1 10.425783513376487 29.057700290577003) translate(0,3.46) translate(10.43,0)"> <g transform="translate(-10.43,0) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:0.91em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="12.55"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mi>X</mi></span></span></foreignObject> </g> <path style="--ltx-stroke-color:#000000;" d="M 10.425783513376487 -0.27673578005007266 L 10.425783513376487 0.27673578005007266" fill="none" stroke="#000000"></path> <g transform="translate(16.98,0) translate(0,8.99) translate(4.15,0) translate(0,-2.42)"> <foreignObject style="--ltx-fo-width:3.85em;--ltx-fo-height:0.53em;--ltx-fo-depth:0.18em;font-size:10pt;" height="9.69" overflow="visible" transform="matrix(1 0 0 -1 0 7.26)" width="53.3"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mrow><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mrow><msub><mi mathsize="0.700em">s</mi><mn mathsize="0.710em">1</mn></msub><mo lspace="0.222em" mathsize="0.700em" rspace="0.222em">×</mo><msub><mi mathsize="0.700em">s</mi><mn mathsize="0.710em">2</mn></msub></mrow><mo maxsize="0.700em" minsize="0.700em" rspace="0.055em">)</mo></mrow><mo mathsize="0.700em" rspace="0.222em">∘</mo><mi mathsize="0.700em" mathvariant="normal">Δ</mi></mrow></span></span></foreignObject> </g> <g transform="translate(85.15,0)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M 10.425783513376487 -0.27673578005007266 L 85.1455842605745 0.27673578005007266" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 85.1455842605745 -0.27673578005007266 L 85.1455842605745 0.27673578005007266" fill="none" stroke="#000000"></path> <g transform="translate(85.15,0) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:1.53em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="21.14"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><msub><mi class="ltx_font_mathscript">ℰ</mi><mn>12</mn></msub></span></span></foreignObject> </g> <path style="--ltx-stroke-color:#000000;" d="M 114.58772073663648 -0.27673578005007266 L 114.58772073663648 0.27673578005007266" fill="none" stroke="#000000"></path> <g transform="translate(132.37,0) translate(0,8.09) translate(4.15,0) translate(0,-2.06)"> <foreignObject style="--ltx-fo-width:2.23em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.14em;font-size:10pt;" height="7.88" overflow="visible" transform="matrix(1 0 0 -1 0 6)" width="30.86"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mrow><msub><mi mathsize="0.700em">p</mi><mn mathsize="0.710em">1</mn></msub><mo lspace="0.222em" mathsize="0.700em" rspace="0.222em">×</mo><msub><mi mathsize="0.700em">p</mi><mn mathsize="0.710em">2</mn></msub></mrow></span></span></foreignObject> </g> <g transform="translate(189.31,0)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M 114.58772073663648 -0.27673578005007266 L 189.3075214838345 0.27673578005007266" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 189.3075214838345 -0.27673578005007266 L 189.3075214838345 0.27673578005007266" fill="none" stroke="#000000"></path> <g transform="translate(189.31,0) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:4.73em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="65.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mrow><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mi>X</mi></mrow></span></span></foreignObject> </g> </g> </svg> </mtext><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lx@xy@svg{\hbox{\raise 2.5pt\hbox{\kern 7.53471pt\hbox{\ignorespaces\ignorespaces\ignorespaces\hbox{\vtop{\halign{\entry@#!@&amp;&amp;\entry@@#!@\cr&amp;&amp;&amp;&amp;\crcr}}}\ignorespaces{\hbox{\kern-7.53471pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{X\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 12.27419pt\raise 6.5pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-1.75pt\hbox{$\scriptstyle{(s_{1}\times s_{2})\circ\Delta}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 61.53471pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 31.53471pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{}$}}}}}}}{\hbox{\kern 61.53471pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{{\mathscr{E}}_{12}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 95.66237pt\raise 5.84723pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-1.48613pt\hbox{$\scriptstyle{p_{1}\times p_{2}}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 136.81255pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 106.81255pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{}$}}}}}}}{\hbox{\kern 136.81255pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\Delta(X)\cong X}$}}}}}}}\ignorespaces}}}}\ignorespaces.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S6.SS1.SSS1.p4" class="ltx_para">
<p id="S6.SS1.SSS1.p4.1" class="ltx_p">On the other hand, the notions of pullbacks and restrictions of microbundles can be defined in the same way as for the case of vector bundles. The correspondence <math id="S6.SS1.SSS1.p4.m1" class="ltx_Math" alttext="E\mapsto E_{\mu}" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo stretchy="false">↦</mo><msub><mi>E</mi><mi>μ</mi></msub></mrow><annotation encoding="application/x-tex">E\mapsto E_{\mu}</annotation></semantics></math> commutes with these operations.</p>
</div>
<div id="S6.SS1.SSS1.p5" class="ltx_para">
<p id="S6.SS1.SSS1.p5.1" class="ltx_p">For the purpose of discussing the uniqueness of stable (equivariant) smoothings later, we need to compare different vector bundle lifts.</p>
</div>
<div id="S6.Thmthm5" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm5.2" class="ltx_text ltx_font_bold">Definition 6.5</span></span><span id="S6.Thmthm5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmthm5.p1" class="ltx_para">
<p id="S6.Thmthm5.p1.1" class="ltx_p">(<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx24" title="" class="ltx_ref">Las79</a>]</cite>)
Let <math id="S6.Thmthm5.p1.m1" class="ltx_Math" alttext="\phi_{i}:(E_{i})_{\mu}\to{\mathscr{E}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mi>μ</mi></msub><mo stretchy="false">→</mo><mi class="ltx_font_mathscript">ℰ</mi></mrow></mrow><annotation encoding="application/x-tex">\phi_{i}:(E_{i})_{\mu}\to{\mathscr{E}}</annotation></semantics></math>, <math id="S6.Thmthm5.p1.m2" class="ltx_Math" alttext="i=0,1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i=0,1</annotation></semantics></math> be two vector bundle lifts of a microbundle <math id="S6.Thmthm5.p1.m3" class="ltx_Math" alttext="{\mathscr{E}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">ℰ</mi><annotation encoding="application/x-tex">{\mathscr{E}}</annotation></semantics></math> over <math id="S6.Thmthm5.p1.m4" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. We say that <math id="S6.Thmthm5.p1.m5" class="ltx_Math" alttext="\phi_{0}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\phi_{0}</annotation></semantics></math> and <math id="S6.Thmthm5.p1.m6" class="ltx_Math" alttext="\phi_{1}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\phi_{1}</annotation></semantics></math> are</p>
<ol id="S6.I3" class="ltx_enumerate">
<li id="S6.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S6.I3.i1.p1" class="ltx_para">
<p id="S6.I3.i1.p1.1" class="ltx_p"><span id="S6.I3.i1.p1.1.1" class="ltx_text ltx_font_bold">equivalent</span> if there exists a vector bundle isomorphism <math id="S6.I3.i1.p1.m1" class="ltx_Math" alttext="\psi:E_{0}\to E_{1}" display="inline" intent=":literal"><semantics><mrow><mi>ψ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>E</mi><mn>0</mn></msub><mo stretchy="false">→</mo><msub><mi>E</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\psi:E_{0}\to E_{1}</annotation></semantics></math> (which induces a microbundle isomorphism <math id="S6.I3.i1.p1.m2" class="ltx_Math" alttext="\psi:(E_{0})_{\mu}\to(E_{1})_{\mu}" display="inline" intent=":literal"><semantics><mrow><mi>ψ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mi>μ</mi></msub><mo stretchy="false">→</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mi>μ</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\psi:(E_{0})_{\mu}\to(E_{1})_{\mu}</annotation></semantics></math> such that <math id="S6.I3.i1.p1.m3" class="ltx_Math" alttext="\phi_{0}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\phi_{0}</annotation></semantics></math> is equivalent to <math id="S6.I3.i1.p1.m4" class="ltx_Math" alttext="\phi_{1}\circ\psi" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>ψ</mi></mrow><annotation encoding="application/x-tex">\phi_{1}\circ\psi</annotation></semantics></math>,</p>
</div></li>
<li id="S6.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S6.I3.i2.p1" class="ltx_para">
<p id="S6.I3.i2.p1.1" class="ltx_p"><span id="S6.I3.i2.p1.1.1" class="ltx_text ltx_font_bold">isotopic</span> if there exist a vector bundle <math id="S6.I3.i2.p1.m1" class="ltx_Math" alttext="E\to X\times[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo stretchy="false">→</mo><mrow><mi>X</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">E\to X\times[0,1]</annotation></semantics></math> and a continuous family of vector bundle lifts <math id="S6.I3.i2.p1.m2" class="ltx_Math" alttext="\phi_{t}:(E|_{X\times\{t\}})_{\mu}\to{\mathscr{E}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mi>t</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mrow><mi>E</mi><mo stretchy="false">|</mo></mrow><mrow><mi>X</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">{</mo><mi>t</mi><mo stretchy="false">}</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><mi>μ</mi></msub><mo stretchy="false">→</mo><mi class="ltx_font_mathscript">ℰ</mi></mrow></mrow><annotation encoding="application/x-tex">\phi_{t}:(E|_{X\times\{t\}})_{\mu}\to{\mathscr{E}}</annotation></semantics></math> which restricts to <math id="S6.I3.i2.p1.m3" class="ltx_Math" alttext="\phi_{0}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\phi_{0}</annotation></semantics></math> and <math id="S6.I3.i2.p1.m4" class="ltx_Math" alttext="\phi_{1}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\phi_{1}</annotation></semantics></math> when <math id="S6.I3.i2.p1.m5" class="ltx_Math" alttext="t=0,1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=0,1</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
</div>
<div id="S6.Thmthm6" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm6.2" class="ltx_text ltx_font_italic">Example 6.6</span></span><span id="S6.Thmthm6.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S6.Thmthm6.p1" class="ltx_para">
<p id="S6.Thmthm6.p1.1" class="ltx_p">Suppose <math id="S6.Thmthm6.p1.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> is a smooth manifold. Then there is a canonical isotopy class of vector bundle reductions of <math id="S6.Thmthm6.p1.m2" class="ltx_Math" alttext="T_{\mu}M" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">T_{\mu}M</annotation></semantics></math>. Choose a Riemannian metric <math id="S6.Thmthm6.p1.m3" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> on <math id="S6.Thmthm6.p1.m4" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> and let <math id="S6.Thmthm6.p1.m5" class="ltx_Math" alttext="\exp" display="inline" intent=":literal"><semantics><mi>exp</mi><annotation encoding="application/x-tex">\exp</annotation></semantics></math> be the associated exponential map. Then there is an open neighborhood <math id="S6.Thmthm6.p1.m6" class="ltx_Math" alttext="U(TM)" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">U(TM)</annotation></semantics></math> of the zero section of <math id="S6.Thmthm6.p1.m7" class="ltx_Math" alttext="TM" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">TM</annotation></semantics></math> such that the exponential map is defined over <math id="S6.Thmthm6.p1.m8" class="ltx_Math" alttext="U(TM)" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">U(TM)</annotation></semantics></math>. Then define</p>
<table id="S6.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex10.m1" class="ltx_Math" alttext="\varphi_{g}:U(TM)\to M\times M,\ (x,\xi)\mapsto(x,\exp_{x}\xi)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>φ</mi><mi>g</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi></mrow></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>ξ</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">↦</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mrow><msub><mi>exp</mi><mi>x</mi></msub><mo lspace="0.167em">⁡</mo><mi>ξ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\varphi_{g}:U(TM)\to M\times M,\ (x,\xi)\mapsto(x,\exp_{x}\xi)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.Thmthm6.p1.2" class="ltx_p">which is a vector bundle reduction of <math id="S6.Thmthm6.p1.m9" class="ltx_Math" alttext="T_{\mu}M" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">T_{\mu}M</annotation></semantics></math>. Moreover, the vector bundle reduction defined by any two Riemannian metrics are isotopic as microbundle isomorphisms.</p>
</div>
</div>
<div id="S6.SS1.SSS1.p6" class="ltx_para">
<p id="S6.SS1.SSS1.p6.1" class="ltx_p">Now we discuss the equivariant situation.</p>
</div>
<div id="S6.Thmthm7" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm7.2" class="ltx_text ltx_font_bold">Definition 6.7</span></span><span id="S6.Thmthm7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmthm7.p1" class="ltx_para">
<p id="S6.Thmthm7.p1.1" class="ltx_p">Let <math id="S6.Thmthm7.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> be a topological group and <math id="S6.Thmthm7.p1.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> be a <math id="S6.Thmthm7.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-space. A <math id="S6.Thmthm7.p1.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math><span id="S6.Thmthm7.p1.1.1" class="ltx_text ltx_font_bold">-microbundle</span> is a microbundle <span class="ltx_inline-block"><svg id="S6.Thmthm7.p1.m5.pic1" class="ltx_picture ltx_markedasmath" height="21.97" overflow="visible" style="vertical-align:-7.610350076103501px" version="1.1" viewBox="10.43 7.61 125.84 21.97" width="125.84"><g transform="matrix(1 0 0 -1 10.425783513376487 21.96621660607574) translate(0,3.46) translate(10.43,0)"><g transform="translate(-10.43,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.91em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="12.55"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Thmthm7.p1.m5.pic1.m1" class="ltx_Math" alttext="\textstyle{X\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">\textstyle{X\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 10.425783513376487 -0.27673578005007266 L 10.425783513376487 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(19.48,0) translate(0,6.24) translate(4.15,0) translate(0,-2.09)"><foreignObject style="--ltx-fo-width:0.38em;--ltx-fo-height:0.3em;--ltx-fo-depth:0em;font-size:10pt;" height="4.17" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="5.22"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Thmthm7.p1.m5.pic1.m2" class="ltx_Math" alttext="\scriptstyle{s}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">s</mi><annotation encoding="application/x-tex">\scriptstyle{s}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(43.64,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 10.425783513376487 -0.27673578005007266 L 43.63458384546449 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 43.63458384546449 -0.27673578005007266 L 43.63458384546449 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(43.64,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.68em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="9.42"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Thmthm7.p1.m5.pic1.m3" class="ltx_Math" alttext="\textstyle{{\mathscr{E}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">ℰ</mi><annotation encoding="application/x-tex">\textstyle{{\mathscr{E}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 61.35365470441789 -0.27673578005007266 L 61.35365470441789 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(71.74,0) translate(0,7.18) translate(4.15,0) translate(0,-1.14)"><foreignObject style="--ltx-fo-width:0.41em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.14em;font-size:10pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="5.7"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Thmthm7.p1.m5.pic1.m4" class="ltx_Math" alttext="\scriptstyle{p}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">p</mi><annotation encoding="application/x-tex">\scriptstyle{p}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(94.56,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 61.35365470441789 -0.27673578005007266 L 94.5624550365059 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 94.5624550365059 -0.27673578005007266 L 94.5624550365059 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(94.56,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.91em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="12.55"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Thmthm7.p1.m5.pic1.m5" class="ltx_Math" alttext="\textstyle{X}" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">\textstyle{X}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span> where <math id="S6.Thmthm7.p1.m6" class="ltx_Math" alttext="{\mathscr{E}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">ℰ</mi><annotation encoding="application/x-tex">{\mathscr{E}}</annotation></semantics></math> is a <math id="S6.Thmthm7.p1.m7" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-space such that <math id="S6.Thmthm7.p1.m8" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> and <math id="S6.Thmthm7.p1.m9" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> are both equivariant.</p>
</div>
</div>
<div id="S6.SS1.SSS1.p7" class="ltx_para">
<p id="S6.SS1.SSS1.p7.1" class="ltx_p">All previous notions for non-equivariant microbundles can be easily extended to the equivariant situation. We just emphasize that if <math id="S6.SS1.SSS1.p7.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is a <math id="S6.SS1.SSS1.p7.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-topological manifold, then its tangent microbundle <math id="S6.SS1.SSS1.p7.m3" class="ltx_Math" alttext="T_{\mu}X" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">T_{\mu}X</annotation></semantics></math> is a <math id="S6.SS1.SSS1.p7.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-microbundle; if <math id="S6.SS1.SSS1.p7.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> is a compact Lie group and <math id="S6.SS1.SSS1.p7.m6" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is a smooth <math id="S6.SS1.SSS1.p7.m7" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-manifold, then its tangent microbundle <math id="S6.SS1.SSS1.p7.m8" class="ltx_Math" alttext="T_{\mu}X" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">T_{\mu}X</annotation></semantics></math> admits a <math id="S6.SS1.SSS1.p7.m9" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant vector bundle lift (by its smooth tangent bundle); a concrete lift can be given via the exponential map associated to a <math id="S6.SS1.SSS1.p7.m10" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant Riemannian metric; moreover, the equivariant isotopy class of such a lift is unique.</p>
</div>
</section>
<section id="S6.SS1.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">6.1.2. </span>Stable equivariant smoothings</h4>

<div id="S6.SS1.SSS2.p1" class="ltx_para">
<p id="S6.SS1.SSS2.p1.1" class="ltx_p">Let <math id="S6.SS1.SSS2.p1.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> be a topological manifold (without boundary). A <span id="S6.SS1.SSS2.p1.1.1" class="ltx_text ltx_font_bold">smoothing</span> of <math id="S6.SS1.SSS2.p1.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> is by definition a pair <math id="S6.SS1.SSS2.p1.m3" class="ltx_Math" alttext="(N,\phi)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>N</mi><mo>,</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(N,\phi)</annotation></semantics></math> where <math id="S6.SS1.SSS2.p1.m4" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> is a smooth manifold and <math id="S6.SS1.SSS2.p1.m5" class="ltx_Math" alttext="\phi:N\to M" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>N</mi><mo stretchy="false">→</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">\phi:N\to M</annotation></semantics></math> is a homeomorphism. A smoothing is also equivalent to a smooth structure <math id="S6.SS1.SSS2.p1.m6" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> on <math id="S6.SS1.SSS2.p1.m7" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, i.e., a maximal atlas of <math id="S6.SS1.SSS2.p1.m8" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math> compatible charts. Two smooth structures <math id="S6.SS1.SSS2.p1.m9" class="ltx_Math" alttext="\alpha_{0}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\alpha_{0}</annotation></semantics></math>, <math id="S6.SS1.SSS2.p1.m10" class="ltx_Math" alttext="\alpha_{1}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\alpha_{1}</annotation></semantics></math> on <math id="S6.SS1.SSS2.p1.m11" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> are called <span id="S6.SS1.SSS2.p1.1.2" class="ltx_text ltx_font_bold">isotopic</span> if there is an isotopy (through homeomorphisms) between <math id="S6.SS1.SSS2.p1.m12" class="ltx_Math" alttext="{\rm Id}_{M}" display="inline" intent=":literal"><semantics><msub><mi>Id</mi><mi>M</mi></msub><annotation encoding="application/x-tex">{\rm Id}_{M}</annotation></semantics></math> and a diffeomorphism <math id="S6.SS1.SSS2.p1.m13" class="ltx_Math" alttext="\phi:M_{\alpha_{0}}\to M_{\alpha_{1}}" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>M</mi><msub><mi>α</mi><mn>0</mn></msub></msub><mo stretchy="false">→</mo><msub><mi>M</mi><msub><mi>α</mi><mn>1</mn></msub></msub></mrow></mrow><annotation encoding="application/x-tex">\phi:M_{\alpha_{0}}\to M_{\alpha_{1}}</annotation></semantics></math>, where <math id="S6.SS1.SSS2.p1.m14" class="ltx_Math" alttext="M_{\alpha_{i}}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><msub><mi>α</mi><mi>i</mi></msub></msub><annotation encoding="application/x-tex">M_{\alpha_{i}}</annotation></semantics></math> is the smooth manifold given by equipping <math id="S6.SS1.SSS2.p1.m15" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> the smooth structure <math id="S6.SS1.SSS2.p1.m16" class="ltx_Math" alttext="\alpha_{i}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\alpha_{i}</annotation></semantics></math>.</p>
</div>
<div id="S6.SS1.SSS2.p2" class="ltx_para">
<p id="S6.SS1.SSS2.p2.1" class="ltx_p">If <math id="S6.SS1.SSS2.p2.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> is a compact Lie group acting on <math id="S6.SS1.SSS2.p2.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, then a <math id="S6.SS1.SSS2.p2.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math><span id="S6.SS1.SSS2.p2.1.1" class="ltx_text ltx_font_bold">-smoothing</span> is a smooth structure <math id="S6.SS1.SSS2.p2.m4" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> on <math id="S6.SS1.SSS2.p2.m5" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> such that the <math id="S6.SS1.SSS2.p2.m6" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-action is smooth. Two <math id="S6.SS1.SSS2.p2.m7" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-smoothings <math id="S6.SS1.SSS2.p2.m8" class="ltx_Math" alttext="\alpha_{0}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\alpha_{0}</annotation></semantics></math> and <math id="S6.SS1.SSS2.p2.m9" class="ltx_Math" alttext="\alpha_{1}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\alpha_{1}</annotation></semantics></math> are <math id="S6.SS1.SSS2.p2.m10" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-isotopic if there is an isotopy through <math id="S6.SS1.SSS2.p2.m11" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant homeomorphisms between <math id="S6.SS1.SSS2.p2.m12" class="ltx_Math" alttext="{\rm Id}_{M}" display="inline" intent=":literal"><semantics><msub><mi>Id</mi><mi>M</mi></msub><annotation encoding="application/x-tex">{\rm Id}_{M}</annotation></semantics></math> and a diffeomorphism from <math id="S6.SS1.SSS2.p2.m13" class="ltx_Math" alttext="M_{\alpha_{0}}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><msub><mi>α</mi><mn>0</mn></msub></msub><annotation encoding="application/x-tex">M_{\alpha_{0}}</annotation></semantics></math> to <math id="S6.SS1.SSS2.p2.m14" class="ltx_Math" alttext="M_{\alpha_{1}}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><msub><mi>α</mi><mn>1</mn></msub></msub><annotation encoding="application/x-tex">M_{\alpha_{1}}</annotation></semantics></math>.</p>
</div>
<div id="S6.SS1.SSS2.p3" class="ltx_para">
<p id="S6.SS1.SSS2.p3.1" class="ltx_p">For the non-equivariant case, one can see that a necessary condition for a topological manifold being smoothable is that its tangent microbundle admits a vector bundle lift. In fact, this is almost also a sufficient condition. Once the tangent microbundle of a topological manifold <math id="S6.SS1.SSS2.p3.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> admits a vector bundle lift, then <math id="S6.SS1.SSS2.p3.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> is <span id="S6.SS1.SSS2.p3.1.1" class="ltx_text ltx_font_bold">stably smoothable</span>, i.e., there is a smoothing <math id="S6.SS1.SSS2.p3.m3" class="ltx_Math" alttext="(M\times{\mathbb{R}}^{k})_{\alpha}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℝ</mi><mi>k</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mi>α</mi></msub><annotation encoding="application/x-tex">(M\times{\mathbb{R}}^{k})_{\alpha}</annotation></semantics></math> on <math id="S6.SS1.SSS2.p3.m4" class="ltx_Math" alttext="M\times{\mathbb{R}}^{k}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℝ</mi><mi>k</mi></msup></mrow><annotation encoding="application/x-tex">M\times{\mathbb{R}}^{k}</annotation></semantics></math> for some <math id="S6.SS1.SSS2.p3.m5" class="ltx_Math" alttext="k\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">k\geq 0</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx28" title="" class="ltx_ref">Mil64</a>, Section 5]</cite>. Two stable smoothings <math id="S6.SS1.SSS2.p3.m6" class="ltx_Math" alttext="(M\times{\mathbb{R}}^{k_{i}})_{\alpha_{i}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℝ</mi><msub><mi>k</mi><mi>i</mi></msub></msup></mrow><mo stretchy="false">)</mo></mrow><msub><mi>α</mi><mi>i</mi></msub></msub><annotation encoding="application/x-tex">(M\times{\mathbb{R}}^{k_{i}})_{\alpha_{i}}</annotation></semantics></math>, <math id="S6.SS1.SSS2.p3.m7" class="ltx_Math" alttext="i=0,1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i=0,1</annotation></semantics></math>, are <span id="S6.SS1.SSS2.p3.1.2" class="ltx_text ltx_font_bold">stably isotopic</span> if there exist <math id="S6.SS1.SSS2.p3.m8" class="ltx_Math" alttext="k_{0}^{\prime},k_{1}^{\prime}\geq 0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>k</mi><mn>0</mn><mo>′</mo></msubsup><mo>,</mo><mrow><msubsup><mi>k</mi><mn>1</mn><mo>′</mo></msubsup><mo>≥</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">k_{0}^{\prime},k_{1}^{\prime}\geq 0</annotation></semantics></math> with <math id="S6.SS1.SSS2.p3.m9" class="ltx_Math" alttext="k_{0}+k_{0}^{\prime}=k=k_{1}+k_{1}^{\prime}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>k</mi><mn>0</mn></msub><mo>+</mo><msubsup><mi>k</mi><mn>0</mn><mo>′</mo></msubsup></mrow><mo>=</mo><mi>k</mi><mo>=</mo><mrow><msub><mi>k</mi><mn>1</mn></msub><mo>+</mo><msubsup><mi>k</mi><mn>1</mn><mo>′</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">k_{0}+k_{0}^{\prime}=k=k_{1}+k_{1}^{\prime}</annotation></semantics></math> and an isotopy between <math id="S6.SS1.SSS2.p3.m10" class="ltx_Math" alttext="(M\times{\mathbb{R}}^{k_{0}})_{\alpha_{0}}\times{\mathbb{R}}^{k_{0}^{\prime}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℝ</mi><msub><mi>k</mi><mn>0</mn></msub></msup></mrow><mo stretchy="false">)</mo></mrow><msub><mi>α</mi><mn>0</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℝ</mi><msubsup><mi>k</mi><mn>0</mn><mo>′</mo></msubsup></msup></mrow><annotation encoding="application/x-tex">(M\times{\mathbb{R}}^{k_{0}})_{\alpha_{0}}\times{\mathbb{R}}^{k_{0}^{\prime}}</annotation></semantics></math> and <math id="S6.SS1.SSS2.p3.m11" class="ltx_Math" alttext="(M\times{\mathbb{R}}^{k_{1}})_{\alpha_{1}}\times{\mathbb{R}}^{k_{1}^{\prime}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℝ</mi><msub><mi>k</mi><mn>1</mn></msub></msup></mrow><mo stretchy="false">)</mo></mrow><msub><mi>α</mi><mn>1</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℝ</mi><msubsup><mi>k</mi><mn>1</mn><mo>′</mo></msubsup></msup></mrow><annotation encoding="application/x-tex">(M\times{\mathbb{R}}^{k_{1}})_{\alpha_{1}}\times{\mathbb{R}}^{k_{1}^{\prime}}</annotation></semantics></math> as smoothings on <math id="S6.SS1.SSS2.p3.m12" class="ltx_Math" alttext="M\times{\mathbb{R}}^{k}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℝ</mi><mi>k</mi></msup></mrow><annotation encoding="application/x-tex">M\times{\mathbb{R}}^{k}</annotation></semantics></math>, where the Euclidean spaces are endowed with the standard smooth structure. The work of Lashof <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx24" title="" class="ltx_ref">Las79</a>]</cite> basically shows that this correspondence extends to the <math id="S6.SS1.SSS2.p3.m13" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant case. Let us introduce the notion of stable <math id="S6.SS1.SSS2.p3.m14" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-smoothings.</p>
</div>
<div id="S6.Thmthm8" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm8.2" class="ltx_text ltx_font_bold">Definition 6.8</span></span><span id="S6.Thmthm8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmthm8.p1" class="ltx_para">
<p id="S6.Thmthm8.p1.1" class="ltx_p"><cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx24" title="" class="ltx_ref">Las79</a>]</cite>
Let <math id="S6.Thmthm8.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> be a compact Lie group and <math id="S6.Thmthm8.p1.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> be a topological <math id="S6.Thmthm8.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-manifold.</p>
</div>
<div id="S6.Thmthm8.p2" class="ltx_para">
<ol id="S6.I4" class="ltx_enumerate">
<li id="S6.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S6.I4.i1.p1" class="ltx_para">
<p id="S6.I4.i1.p1.1" class="ltx_p">A <span id="S6.I4.i1.p1.1.1" class="ltx_text ltx_font_bold">stable <math id="S6.I4.i1.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-smoothing</span> of <math id="S6.I4.i1.p1.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> is a <math id="S6.I4.i1.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-smoothing on the product <math id="S6.I4.i1.p1.m4" class="ltx_Math" alttext="M\times{\bm{R}}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑹</mi></mrow><annotation encoding="application/x-tex">M\times{\bm{R}}</annotation></semantics></math> where <math id="S6.I4.i1.p1.m5" class="ltx_Math" alttext="{\bm{R}}" display="inline" intent=":literal"><semantics><mi>𝑹</mi><annotation encoding="application/x-tex">{\bm{R}}</annotation></semantics></math> is a finite-dimensional orthogonal representation of <math id="S6.I4.i1.p1.m6" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>.</p>
</div></li>
<li id="S6.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S6.I4.i2.p1" class="ltx_para">
<p id="S6.I4.i2.p1.1" class="ltx_p">Two stable <math id="S6.I4.i2.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-smoothings, <math id="S6.I4.i2.p1.m2" class="ltx_Math" alttext="(M\times{\bm{R}}_{i})_{\alpha_{i}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝑹</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><msub><mi>α</mi><mi>i</mi></msub></msub><annotation encoding="application/x-tex">(M\times{\bm{R}}_{i})_{\alpha_{i}}</annotation></semantics></math>, <math id="S6.I4.i2.p1.m3" class="ltx_Math" alttext="i=0,1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i=0,1</annotation></semantics></math>, of <math id="S6.I4.i2.p1.m4" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, are <span id="S6.I4.i2.p1.1.1" class="ltx_text ltx_font_bold">stably <math id="S6.I4.i2.p1.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-isotopic</span>, if there exist orthogonal representations <math id="S6.I4.i2.p1.m6" class="ltx_Math" alttext="{\bm{R}}_{0}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑹</mi><mn>0</mn><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\bm{R}}_{0}^{\prime}</annotation></semantics></math>, <math id="S6.I4.i2.p1.m7" class="ltx_Math" alttext="{\bm{R}}_{1}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑹</mi><mn>1</mn><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\bm{R}}_{1}^{\prime}</annotation></semantics></math> of <math id="S6.I4.i2.p1.m8" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> such that <math id="S6.I4.i2.p1.m9" class="ltx_Math" alttext="{\bm{R}}_{0}\oplus{\bm{R}}_{0}^{\prime}\cong{\bm{R}}\cong{\bm{R}}_{1}\oplus{\bm{R}}_{1}^{\prime}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝑹</mi><mn>0</mn></msub><mo>⊕</mo><msubsup><mi>𝑹</mi><mn>0</mn><mo>′</mo></msubsup></mrow><mo>≅</mo><mi>𝑹</mi><mo>≅</mo><mrow><msub><mi>𝑹</mi><mn>1</mn></msub><mo>⊕</mo><msubsup><mi>𝑹</mi><mn>1</mn><mo>′</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">{\bm{R}}_{0}\oplus{\bm{R}}_{0}^{\prime}\cong{\bm{R}}\cong{\bm{R}}_{1}\oplus{\bm{R}}_{1}^{\prime}</annotation></semantics></math> as <math id="S6.I4.i2.p1.m10" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-representations and <math id="S6.I4.i2.p1.m11" class="ltx_Math" alttext="(M\times{\bm{R}}_{0})_{\alpha_{0}}\times{\bm{R}}_{0}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝑹</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow><msub><mi>α</mi><mn>0</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>𝑹</mi><mn>0</mn><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">(M\times{\bm{R}}_{0})_{\alpha_{0}}\times{\bm{R}}_{0}^{\prime}</annotation></semantics></math> is isotopic to <math id="S6.I4.i2.p1.m12" class="ltx_Math" alttext="(M\times{\bm{R}}_{1})_{\alpha_{1}}\times{\bm{R}}_{1}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝑹</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><msub><mi>α</mi><mn>1</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>𝑹</mi><mn>1</mn><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">(M\times{\bm{R}}_{1})_{\alpha_{1}}\times{\bm{R}}_{1}^{\prime}</annotation></semantics></math> as <math id="S6.I4.i2.p1.m13" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-smoothings on <math id="S6.I4.i2.p1.m14" class="ltx_Math" alttext="M\times{\bm{R}}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑹</mi></mrow><annotation encoding="application/x-tex">M\times{\bm{R}}</annotation></semantics></math>.</p>
</div></li>
<li id="S6.I4.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S6.I4.i3.p1" class="ltx_para">
<p id="S6.I4.i3.p1.1" class="ltx_p">A <span id="S6.I4.i3.p1.1.1" class="ltx_text ltx_font_bold">stable <math id="S6.I4.i3.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-vector bundle lift</span> of <math id="S6.I4.i3.p1.m2" class="ltx_Math" alttext="T_{\mu}M" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">T_{\mu}M</annotation></semantics></math> is a <math id="S6.I4.i3.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-vector bundle lift of <math id="S6.I4.i3.p1.m4" class="ltx_Math" alttext="T_{\mu}M\oplus R" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>⊕</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">T_{\mu}M\oplus R</annotation></semantics></math>, where <math id="S6.I4.i3.p1.m5" class="ltx_Math" alttext="R\to M" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">R\to M</annotation></semantics></math> is the trivial bundle <math id="S6.I4.i3.p1.m6" class="ltx_Math" alttext="M\times{\bm{R}}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑹</mi></mrow><annotation encoding="application/x-tex">M\times{\bm{R}}</annotation></semantics></math> with <math id="S6.I4.i3.p1.m7" class="ltx_Math" alttext="{\bm{R}}" display="inline" intent=":literal"><semantics><mi>𝑹</mi><annotation encoding="application/x-tex">{\bm{R}}</annotation></semantics></math> being an orthogonal representation of <math id="S6.I4.i3.p1.m8" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>.</p>
</div></li>
<li id="S6.I4.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S6.I4.i4.p1" class="ltx_para">
<p id="S6.I4.i4.p1.1" class="ltx_p">Two stable <math id="S6.I4.i4.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-vector bundle lifts, <math id="S6.I4.i4.p1.m2" class="ltx_Math" alttext="\phi_{i}:(E_{i})_{\mu}\cong T_{\mu}M\oplus R_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mi>μ</mi></msub><mo>≅</mo><mrow><mrow><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>⊕</mo><msub><mi>R</mi><mi>i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi_{i}:(E_{i})_{\mu}\cong T_{\mu}M\oplus R_{i}</annotation></semantics></math>, <math id="S6.I4.i4.p1.m3" class="ltx_Math" alttext="i=0,1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i=0,1</annotation></semantics></math>, are <span id="S6.I4.i4.p1.1.1" class="ltx_text ltx_font_bold">stably <math id="S6.I4.i4.p1.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-isotopic</span>, if there are orthogonal <math id="S6.I4.i4.p1.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-representations <math id="S6.I4.i4.p1.m6" class="ltx_Math" alttext="{\bm{R}}_{0}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑹</mi><mn>0</mn><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\bm{R}}_{0}^{\prime}</annotation></semantics></math>, <math id="S6.I4.i4.p1.m7" class="ltx_Math" alttext="{\bm{R}}_{1}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑹</mi><mn>1</mn><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\bm{R}}_{1}^{\prime}</annotation></semantics></math>, with <math id="S6.I4.i4.p1.m8" class="ltx_Math" alttext="{\bm{R}}_{0}\oplus{\bm{R}}_{0}^{\prime}\cong{\bm{R}}\cong{\bm{R}}_{1}\oplus{\bm{R}}_{1}^{\prime}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝑹</mi><mn>0</mn></msub><mo>⊕</mo><msubsup><mi>𝑹</mi><mn>0</mn><mo>′</mo></msubsup></mrow><mo>≅</mo><mi>𝑹</mi><mo>≅</mo><mrow><msub><mi>𝑹</mi><mn>1</mn></msub><mo>⊕</mo><msubsup><mi>𝑹</mi><mn>1</mn><mo>′</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">{\bm{R}}_{0}\oplus{\bm{R}}_{0}^{\prime}\cong{\bm{R}}\cong{\bm{R}}_{1}\oplus{\bm{R}}_{1}^{\prime}</annotation></semantics></math> such that the induced <math id="S6.I4.i4.p1.m9" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-vector bundle lifts</p>
<table id="S6.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex11.m1" class="ltx_math_unparsed" alttext="\phi_{i}\oplus{\rm Id}_{R_{i}^{\prime}}:(E_{i}\oplus R_{i}^{\prime})_{\mu}\cong T_{\mu}M\oplus R_{i}\oplus R_{i}^{\prime}\cong T_{\mu}M\oplus R,\ i=0,1" display="block" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mi>i</mi></msub><mo>⊕</mo><msub><mi>Id</mi><msubsup><mi>R</mi><mi>i</mi><mo>′</mo></msubsup></msub><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mi>i</mi></msub><mo>⊕</mo><msubsup><mi>R</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mi>μ</mi></msub><mo>≅</mo><msub><mi>T</mi><mi>μ</mi></msub><mi>M</mi><mo>⊕</mo><msub><mi>R</mi><mi>i</mi></msub><mo>⊕</mo><msubsup><mi>R</mi><mi>i</mi><mo>′</mo></msubsup><mo>≅</mo><msub><mi>T</mi><mi>μ</mi></msub><mi>M</mi><mo>⊕</mo><mi>R</mi><mo rspace="0.667em">,</mo><mi>i</mi><mo>=</mo><mn>0</mn><mo>,</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\phi_{i}\oplus{\rm Id}_{R_{i}^{\prime}}:(E_{i}\oplus R_{i}^{\prime})_{\mu}\cong T_{\mu}M\oplus R_{i}\oplus R_{i}^{\prime}\cong T_{\mu}M\oplus R,\ i=0,1</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.I4.i4.p1.2" class="ltx_p">are <math id="S6.I4.i4.p1.m10" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-isotopic.</p>
</div></li>
</ol>
</div>
</div>
<div id="S6.SS1.SSS2.p4" class="ltx_para">
<p id="S6.SS1.SSS2.p4.1" class="ltx_p">Any stable <math id="S6.SS1.SSS2.p4.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-smoothing <math id="S6.SS1.SSS2.p4.m2" class="ltx_Math" alttext="(M\times{\bm{R}})_{\alpha}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑹</mi></mrow><mo stretchy="false">)</mo></mrow><mi>α</mi></msub><annotation encoding="application/x-tex">(M\times{\bm{R}})_{\alpha}</annotation></semantics></math> of <math id="S6.SS1.SSS2.p4.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> induces a stable <math id="S6.SS1.SSS2.p4.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-vector bundle lift</p>
<table id="S6.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex12.m1" class="ltx_Math" alttext="T(M\times{\bm{R}})_{\alpha}\to T_{\mu}M\oplus R." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑹</mi></mrow><mo stretchy="false">)</mo></mrow><mi>α</mi></msub></mrow><mo stretchy="false">→</mo><mrow><mrow><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>⊕</mo><mi>R</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">T(M\times{\bm{R}})_{\alpha}\to T_{\mu}M\oplus R.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS1.SSS2.p4.2" class="ltx_p">However it is not obvious that the stable <math id="S6.SS1.SSS2.p4.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-isotopy class of the lift only depends on the stable <math id="S6.SS1.SSS2.p4.m6" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-isotopy class of the smoothing. By using an intermediate notion of stable sliced concordance among stable <math id="S6.SS1.SSS2.p4.m7" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-smoothings, Lashof <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx24" title="" class="ltx_ref">Las79</a>]</cite> showed that there is indeed such a correspondence sending stable <math id="S6.SS1.SSS2.p4.m8" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-isotopy classes of stable <math id="S6.SS1.SSS2.p4.m9" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-smoothings to stable <math id="S6.SS1.SSS2.p4.m10" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-isotopy classes of stable <math id="S6.SS1.SSS2.p4.m11" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-vector bundle reductions of <math id="S6.SS1.SSS2.p4.m12" class="ltx_Math" alttext="T_{\mu}M" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">T_{\mu}M</annotation></semantics></math>. In fact, this correspondence is bijective.</p>
</div>
<div id="S6.Thmthm9" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm9.2" class="ltx_text ltx_font_bold">Theorem 6.9</span></span><span id="S6.Thmthm9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmthm9.p1" class="ltx_para">
<p id="S6.Thmthm9.p1.1" class="ltx_p"><cite class="ltx_cite ltx_citemacro_cite"><span id="S6.Thmthm9.p1.1.1" class="ltx_text ltx_font_italic">[</span><a href="#bib.bibx24" title="" class="ltx_ref">Las79</a><span id="S6.Thmthm9.p1.1.2" class="ltx_text ltx_font_italic">]</span></cite><span id="S6.Thmthm9.p1.1.3" class="ltx_text ltx_font_italic"> Let <math id="S6.Thmthm9.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> be a compact Lie group and <math id="S6.Thmthm9.p1.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> be a topological <math id="S6.Thmthm9.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-manifold which only has finitely many orbit types. Suppose <math id="S6.Thmthm9.p1.m4" class="ltx_Math" alttext="E\to M" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">E\to M</annotation></semantics></math> is a <math id="S6.Thmthm9.p1.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant vector bundle and <math id="S6.Thmthm9.p1.m6" class="ltx_Math" alttext="\varphi:E_{\mu}\to T_{\mu}M" display="inline" intent=":literal"><semantics><mrow><mi>φ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>E</mi><mi>μ</mi></msub><mo stretchy="false">→</mo><mrow><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\varphi:E_{\mu}\to T_{\mu}M</annotation></semantics></math> is a <math id="S6.Thmthm9.p1.m7" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant vector bundle reduction of <math id="S6.Thmthm9.p1.m8" class="ltx_Math" alttext="T_{\mu}M" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">T_{\mu}M</annotation></semantics></math>, then there exists an orthogonal <math id="S6.Thmthm9.p1.m9" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-representation <math id="S6.Thmthm9.p1.m10" class="ltx_Math" alttext="{\bm{R}}" display="inline" intent=":literal"><semantics><mi>𝐑</mi><annotation encoding="application/x-tex">{\bm{R}}</annotation></semantics></math> and a <math id="S6.Thmthm9.p1.m11" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-smoothing <math id="S6.Thmthm9.p1.m12" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> on <math id="S6.Thmthm9.p1.m13" class="ltx_Math" alttext="M\times{\bm{R}}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝐑</mi></mrow><annotation encoding="application/x-tex">M\times{\bm{R}}</annotation></semantics></math> satisfying</span></p>
<ol id="S6.I5" class="ltx_enumerate">
<li id="S6.I5.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S6.I5.i1.p1" class="ltx_para">
<p id="S6.I5.i1.p1.1" class="ltx_p"><span id="S6.I5.i1.p1.1.1" class="ltx_text ltx_font_italic">There is a </span><math id="S6.I5.i1.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math><span id="S6.I5.i1.p1.1.2" class="ltx_text ltx_font_italic">-equivariant vector bundle isomorphism </span><math id="S6.I5.i1.p1.m2" class="ltx_Math" alttext="\rho:p_{M}^{*}E\oplus R\cong T(M\times{\bm{R}})_{\alpha}" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><msubsup><mi>p</mi><mi>M</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow><mo>⊕</mo><mi>R</mi></mrow><mo>≅</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑹</mi></mrow><mo stretchy="false">)</mo></mrow><mi>α</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho:p_{M}^{*}E\oplus R\cong T(M\times{\bm{R}})_{\alpha}</annotation></semantics></math><span id="S6.I5.i1.p1.1.3" class="ltx_text ltx_font_italic"> where </span><math id="S6.I5.i1.p1.m3" class="ltx_Math" alttext="p_{M}:M\times{\bm{R}}\to M" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>M</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑹</mi></mrow><mo stretchy="false">→</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">p_{M}:M\times{\bm{R}}\to M</annotation></semantics></math><span id="S6.I5.i1.p1.1.4" class="ltx_text ltx_font_italic"> is the natural projection.</span></p>
</div></li>
<li id="S6.I5.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S6.I5.i2.p1" class="ltx_para">
<p id="S6.I5.i2.p1.1" class="ltx_p"><span id="S6.I5.i2.p1.1.1" class="ltx_text ltx_font_italic">Denote by </span><math id="S6.I5.i2.p1.m1" class="ltx_Math" alttext="\rho_{\mu}" display="inline" intent=":literal"><semantics><msub><mi>ρ</mi><mi>μ</mi></msub><annotation encoding="application/x-tex">\rho_{\mu}</annotation></semantics></math><span id="S6.I5.i2.p1.1.2" class="ltx_text ltx_font_italic"> the induced map between microbundles from </span><math id="S6.I5.i2.p1.m2" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math><span id="S6.I5.i2.p1.1.3" class="ltx_text ltx_font_italic">. Then the vector bundle reduction </span><math id="S6.I5.i2.p1.m3" class="ltx_Math" alttext="\exp_{M\times R}\circ\rho_{\mu}:p_{M}^{*}E_{\mu}\oplus R\to T_{\mu}(M\times{\bm{R}})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>exp</mi><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>R</mi></mrow></msub><mo lspace="0em" rspace="0.222em">∘</mo><msub><mi>ρ</mi><mi>μ</mi></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><msubsup><mi>p</mi><mi>M</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mi>μ</mi></msub></mrow><mo>⊕</mo><mi>R</mi></mrow><mo stretchy="false">→</mo><mrow><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑹</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\exp_{M\times R}\circ\rho_{\mu}:p_{M}^{*}E_{\mu}\oplus R\to T_{\mu}(M\times{\bm{R}})</annotation></semantics></math><span id="S6.I5.i2.p1.1.4" class="ltx_text ltx_font_italic"> is isotopic to the stabilization </span><math id="S6.I5.i2.p1.m4" class="ltx_Math" alttext="p_{M}^{*}\varphi\oplus{\rm Id}_{R}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>p</mi><mi>M</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>φ</mi></mrow><mo>⊕</mo><msub><mi>Id</mi><mi>R</mi></msub></mrow><annotation encoding="application/x-tex">p_{M}^{*}\varphi\oplus{\rm Id}_{R}</annotation></semantics></math><span id="S6.I5.i2.p1.1.5" class="ltx_text ltx_font_italic">.</span><span id="footnote17" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">17</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">17</sup>
                        <span class="ltx_tag ltx_tag_note">17</span>
                        
                        
                        
                      This claim is not explicitly stated in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx24" title="" class="ltx_ref">Las79</a>]</cite> but can be observed from Lashof’s construction.</span></span></span></p>
</div></li>
</ol>
<p id="S6.Thmthm9.p1.2" class="ltx_p"><span id="S6.Thmthm9.p1.2.1" class="ltx_text ltx_font_italic">Moreover, the correspondence <math id="S6.Thmthm9.p1.m14" class="ltx_Math" alttext="\varphi\mapsto\alpha" display="inline" intent=":literal"><semantics><mrow><mi>φ</mi><mo stretchy="false">↦</mo><mi>α</mi></mrow><annotation encoding="application/x-tex">\varphi\mapsto\alpha</annotation></semantics></math> induces a bijection between stable isotopy classes of stable <math id="S6.Thmthm9.p1.m15" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-smoothings of <math id="S6.Thmthm9.p1.m16" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> and stable isotopy classes of stable <math id="S6.Thmthm9.p1.m17" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-vector bundle reductions of <math id="S6.Thmthm9.p1.m18" class="ltx_Math" alttext="T_{\mu}M" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">T_{\mu}M</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S6.SS1.SSS2.p5" class="ltx_para">
<p id="S6.SS1.SSS2.p5.1" class="ltx_p">Our construction relies on the following relative version of Lashof’s theorem.</p>
</div>
<div id="S6.Thmthm10" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm10.2" class="ltx_text ltx_font_bold">Theorem 6.10</span></span><span id="S6.Thmthm10.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmthm10.p1" class="ltx_para">
<p id="S6.Thmthm10.p1.1" class="ltx_p"><span id="S6.Thmthm10.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S6.Thmthm10.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>, <math id="S6.Thmthm10.p1.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, <math id="S6.Thmthm10.p1.m3" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>, and <math id="S6.Thmthm10.p1.m4" class="ltx_Math" alttext="\varphi" display="inline" intent=":literal"><semantics><mi>φ</mi><annotation encoding="application/x-tex">\varphi</annotation></semantics></math> be as in Theorem <a href="#S6.Thmthm9" title="Theorem 6.9. ‣ 6.1.2. Stable equivariant smoothings ‣ 6.1. Preliminaries ‣ 6. Smoothing ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.9</span></a>. Let <math id="S6.Thmthm10.p1.m5" class="ltx_Math" alttext="C\subset M" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⊂</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">C\subset M</annotation></semantics></math> be a <math id="S6.Thmthm10.p1.m6" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant closed set and <math id="S6.Thmthm10.p1.m7" class="ltx_Math" alttext="U\subset M" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⊂</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">U\subset M</annotation></semantics></math> be a <math id="S6.Thmthm10.p1.m8" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant open neighborhood of <math id="S6.Thmthm10.p1.m9" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>. Suppose</span></p>
<ol id="S6.I6" class="ltx_enumerate">
<li id="S6.I6.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S6.I6.i1.p1" class="ltx_para">
<p id="S6.I6.i1.p1.1" class="ltx_p"><math id="S6.I6.i1.p1.m1" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math><span id="S6.I6.i1.p1.1.1" class="ltx_text ltx_font_italic"> is equipped with a </span><math id="S6.I6.i1.p1.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math><span id="S6.I6.i1.p1.1.2" class="ltx_text ltx_font_italic">-smoothing </span><math id="S6.I6.i1.p1.m3" class="ltx_Math" alttext="\alpha_{0}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\alpha_{0}</annotation></semantics></math><span id="S6.I6.i1.p1.1.3" class="ltx_text ltx_font_italic"> and </span><math id="S6.I6.i1.p1.m4" class="ltx_Math" alttext="E|_{U}" display="inline" intent=":literal"><semantics><msub><mrow><mi>E</mi><mo stretchy="false">|</mo></mrow><mi>U</mi></msub><annotation encoding="application/x-tex">E|_{U}</annotation></semantics></math><span id="S6.I6.i1.p1.1.4" class="ltx_text ltx_font_italic"> is equipped with a smooth </span><math id="S6.I6.i1.p1.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math><span id="S6.I6.i1.p1.1.5" class="ltx_text ltx_font_italic">-equivariant vector bundle structure.</span></p>
</div></li>
<li id="S6.I6.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S6.I6.i2.p1" class="ltx_para">
<p id="S6.I6.i2.p1.1" class="ltx_p"><math id="S6.I6.i2.p1.m1" class="ltx_Math" alttext="\varphi|_{U}:(E|_{U})_{\mu}\to T_{\mu}U" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mi>φ</mi><mo stretchy="false">|</mo></mrow><mi>U</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mrow><mi>E</mi><mo stretchy="false">|</mo></mrow><mi>U</mi></msub><mo stretchy="false">)</mo></mrow><mi>μ</mi></msub><mo stretchy="false">→</mo><mrow><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>U</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\varphi|_{U}:(E|_{U})_{\mu}\to T_{\mu}U</annotation></semantics></math><span id="S6.I6.i2.p1.1.1" class="ltx_text ltx_font_italic"> is a smooth microbundle reduction and is isotopic to the microbundle reduction </span><math id="S6.I6.i2.p1.m2" class="ltx_Math" alttext="TU_{\alpha_{0}}\to T_{\mu}U" display="inline" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>U</mi><msub><mi>α</mi><mn>0</mn></msub></msub></mrow><mo stretchy="false">→</mo><mrow><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>U</mi></mrow></mrow><annotation encoding="application/x-tex">TU_{\alpha_{0}}\to T_{\mu}U</annotation></semantics></math><span id="S6.I6.i2.p1.1.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
<p id="S6.Thmthm10.p1.2" class="ltx_p"><span id="S6.Thmthm10.p1.2.1" class="ltx_text ltx_font_italic">Then there exists an orthogonal <math id="S6.Thmthm10.p1.m10" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-representation <math id="S6.Thmthm10.p1.m11" class="ltx_Math" alttext="{\bm{R}}" display="inline" intent=":literal"><semantics><mi>𝐑</mi><annotation encoding="application/x-tex">{\bm{R}}</annotation></semantics></math> and a <math id="S6.Thmthm10.p1.m12" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-smoothing <math id="S6.Thmthm10.p1.m13" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> on <math id="S6.Thmthm10.p1.m14" class="ltx_Math" alttext="M\times{\bm{R}}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝐑</mi></mrow><annotation encoding="application/x-tex">M\times{\bm{R}}</annotation></semantics></math> such that over a <math id="S6.Thmthm10.p1.m15" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant open neighborhood <math id="S6.Thmthm10.p1.m16" class="ltx_Math" alttext="U^{\prime}\subset U" display="inline" intent=":literal"><semantics><mrow><msup><mi>U</mi><mo>′</mo></msup><mo>⊂</mo><mi>U</mi></mrow><annotation encoding="application/x-tex">U^{\prime}\subset U</annotation></semantics></math> of <math id="S6.Thmthm10.p1.m17" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>, <math id="S6.Thmthm10.p1.m18" class="ltx_Math" alttext="(U^{\prime}\times{\bm{R}})_{\alpha}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mi>U</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝐑</mi></mrow><mo stretchy="false">)</mo></mrow><mi>α</mi></msub><annotation encoding="application/x-tex">(U^{\prime}\times{\bm{R}})_{\alpha}</annotation></semantics></math> is diffeomorphic to the product <math id="S6.Thmthm10.p1.m19" class="ltx_Math" alttext="(U^{\prime})_{\alpha_{0}}\times{\bm{R}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><msup><mi>U</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><msub><mi>α</mi><mn>0</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝐑</mi></mrow><annotation encoding="application/x-tex">(U^{\prime})_{\alpha_{0}}\times{\bm{R}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S6.SS1.SSS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S6.SS1.SSS2.p6" class="ltx_para">
<p id="S6.SS1.SSS2.p6.1" class="ltx_p"><span id="S6.SS1.SSS2.p6.1.1" class="ltx_text">See Appendix <a href="#A2" title="Appendix B Relative stable equivariant smoothing ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B</span></a>.
∎</span></p>
</div>
</div>
</section>
<section id="S6.SS1.SSS3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">6.1.3. </span>Topological submersions</h4>

<div id="S6.SS1.SSS3.p1" class="ltx_para">
<p id="S6.SS1.SSS3.p1.1" class="ltx_p">Now we start to prepare for smoothing the K-chart lift of the Hamiltonian Floer flow category following a generalization of the strategy used in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>]</cite>. First, we discuss topological submersions which are relevant for constructing lifts of tangent microbundles.</p>
</div>
<div id="S6.Thmthm11" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm11.2" class="ltx_text ltx_font_bold">Definition 6.11</span></span><span id="S6.Thmthm11.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmthm11.p1" class="ltx_para">
<p id="S6.Thmthm11.p1.1" class="ltx_p">Let <math id="S6.Thmthm11.p1.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> be an <math id="S6.Thmthm11.p1.m2" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-space and <math id="S6.Thmthm11.p1.m3" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> be a smooth <math id="S6.Thmthm11.p1.m4" class="ltx_Math" alttext="{\mathbb{A}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝔸</mi><mo>′</mo></msup><annotation encoding="application/x-tex">{\mathbb{A}}^{\prime}</annotation></semantics></math>-manifold. Let <math id="S6.Thmthm11.p1.m5" class="ltx_Math" alttext="\pi:M\to B" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mi>B</mi></mrow></mrow><annotation encoding="application/x-tex">\pi:M\to B</annotation></semantics></math> be a continuous map covering a map between the posets <math id="S6.Thmthm11.p1.m6" class="ltx_Math" alttext="{\mathbb{A}}\to{\mathbb{A}}^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>𝔸</mi><mo stretchy="false">→</mo><msup><mi>𝔸</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">{\mathbb{A}}\to{\mathbb{A}}^{\prime}</annotation></semantics></math>.</p>
<ol id="S6.I7" class="ltx_enumerate">
<li id="S6.I7.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S6.I7.i1.p1" class="ltx_para">
<p id="S6.I7.i1.p1.1" class="ltx_p">Let <math id="S6.I7.i1.p1.m1" class="ltx_Math" alttext="p\in M" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">p\in M</annotation></semantics></math> and <math id="S6.I7.i1.p1.m2" class="ltx_Math" alttext="b=\pi(p)\in B" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">b=\pi(p)\in B</annotation></semantics></math>. A <span id="S6.I7.i1.p1.1.1" class="ltx_text ltx_font_bold">product neighborhood</span> of <math id="S6.I7.i1.p1.m3" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> is a pair <math id="S6.I7.i1.p1.m4" class="ltx_Math" alttext="(W,\iota)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>W</mi><mo>,</mo><mi>ι</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(W,\iota)</annotation></semantics></math> where <math id="S6.I7.i1.p1.m5" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> is an open neighborhood of <math id="S6.I7.i1.p1.m6" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> (denoting <math id="S6.I7.i1.p1.m7" class="ltx_Math" alttext="W|_{b}=\pi^{-1}(b)\cap W" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mi>W</mi><mo stretchy="false">|</mo></mrow><mi>b</mi></msub><mo>=</mo><mrow><mrow><msup><mi>π</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∩</mo><mi>W</mi></mrow></mrow><annotation encoding="application/x-tex">W|_{b}=\pi^{-1}(b)\cap W</annotation></semantics></math>) and <math id="S6.I7.i1.p1.m8" class="ltx_Math" alttext="\iota:W\to W|_{b}\times\pi(W)" display="inline" intent=":literal"><semantics><mrow><mi>ι</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>W</mi><mo stretchy="false">→</mo><mrow><msub><mrow><mi>W</mi><mo rspace="0.055em" stretchy="false">|</mo></mrow><mi>b</mi></msub><mo rspace="0.222em">×</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\iota:W\to W|_{b}\times\pi(W)</annotation></semantics></math> is an homeomorphism satisfying</p>
<ul id="S6.I7.i1.I1" class="ltx_itemize">
<li id="S6.I7.i1.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S6.I7.i1.I1.i1.p1" class="ltx_para">
<p id="S6.I7.i1.I1.i1.p1.1" class="ltx_p"><math id="S6.I7.i1.I1.i1.p1.m1" class="ltx_Math" alttext="\pi(W)" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi(W)</annotation></semantics></math> is an open neighborhood of <math id="S6.I7.i1.I1.i1.p1.m2" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math>;</p>
</div></li>
<li id="S6.I7.i1.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S6.I7.i1.I1.i2.p1" class="ltx_para">
<p id="S6.I7.i1.I1.i2.p1.1" class="ltx_p"><math id="S6.I7.i1.I1.i2.p1.m1" class="ltx_Math" alttext="\pi\circ\iota^{-1}:W|_{b}\times\pi(W)\to\pi(W)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>π</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>ι</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mrow><mi>W</mi><mo rspace="0.055em" stretchy="false">|</mo></mrow><mi>b</mi></msub><mo rspace="0.222em">×</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi\circ\iota^{-1}:W|_{b}\times\pi(W)\to\pi(W)</annotation></semantics></math> is the projection to <math id="S6.I7.i1.I1.i2.p1.m2" class="ltx_Math" alttext="\pi(W)" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi(W)</annotation></semantics></math>;</p>
</div></li>
<li id="S6.I7.i1.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S6.I7.i1.I1.i3.p1" class="ltx_para">
<p id="S6.I7.i1.I1.i3.p1.1" class="ltx_p"><math id="S6.I7.i1.I1.i3.p1.m1" class="ltx_Math" alttext="\iota|_{W|_{b}}:W|_{b}\to W|_{b}\times\{b\}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mi>ι</mi><mo stretchy="false">|</mo></mrow><msub><mrow><mi>W</mi><mo stretchy="false">|</mo></mrow><mi>b</mi></msub></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mrow><mi>W</mi><mo stretchy="false">|</mo></mrow><mi>b</mi></msub><mo stretchy="false">→</mo><mrow><msub><mrow><mi>W</mi><mo rspace="0.055em" stretchy="false">|</mo></mrow><mi>b</mi></msub><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">{</mo><mi>b</mi><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\iota|_{W|_{b}}:W|_{b}\to W|_{b}\times\{b\}</annotation></semantics></math> is the identity map.</p>
</div></li>
</ul>
</div></li>
<li id="S6.I7.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S6.I7.i2.p1" class="ltx_para">
<p id="S6.I7.i2.p1.1" class="ltx_p">The map <math id="S6.I7.i2.p1.m1" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> is called a <span id="S6.I7.i2.p1.1.1" class="ltx_text ltx_font_bold">topological submersion</span> if every point <math id="S6.I7.i2.p1.m2" class="ltx_Math" alttext="p\in M" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">p\in M</annotation></semantics></math> admits a product neighborhood and each fiber is a topological manifold (of a fixed dimension) without boundary. In this case, the <span id="S6.I7.i2.p1.1.2" class="ltx_text ltx_font_bold">vertical tangent microbundle</span> <math id="S6.I7.i2.p1.m3" class="ltx_Math" alttext="T_{\mu}^{\rm vt}M" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>T</mi><mi>μ</mi><mi>vt</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">T_{\mu}^{\rm vt}M</annotation></semantics></math> is the microbundle</p>
<table id="S6.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S6.Ex13.m1.pic1" class="ltx_picture ltx_markedasmath" height="24.61" overflow="visible" style="vertical-align:-9.685900096859001px" version="1.1" viewBox="11.62 9.69 174.41 24.61" width="174.41"><g transform="matrix(1 0 0 -1 11.617307661644269 24.606808432408414) translate(0,3.46) translate(11.62,0)"><g transform="translate(-11.62,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.08em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="14.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex13.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{M\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">\textstyle{M\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 11.617307661644269 -0.27673578005007266 L 11.617307661644269 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(19.53,0) translate(0,7.46) translate(4.15,0) translate(0,-3.31)"><foreignObject style="--ltx-fo-width:0.66em;--ltx-fo-height:0.48em;--ltx-fo-depth:0em;font-size:10pt;" height="6.62" overflow="visible" transform="matrix(1 0 0 -1 0 6.62)" width="9.09"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex13.m1.pic1.m2" class="ltx_Math" alttext="\scriptstyle{\Delta}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em" mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\scriptstyle{\Delta}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(44.83,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 11.617307661644269 -0.27673578005007266 L 44.82610799373227 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 44.82610799373227 -0.27673578005007266 L 44.82610799373227 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(44.83,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:3.85em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="53.23"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex13.m1.pic1.m3" class="ltx_Math" alttext="\textstyle{M\times_{B}M\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>B</mi></msub><mi>M</mi></mrow><annotation encoding="application/x-tex">\textstyle{M\times_{B}M\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 106.3540975830112 -0.27673578005007266 L 106.3540975830112 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(113.26,0) translate(0,7.18) translate(4.15,0) translate(0,-1.14)"><foreignObject style="--ltx-fo-width:0.8em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.14em;font-size:10pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="11.1"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex13.m1.pic1.m4" class="ltx_Math" alttext="\scriptstyle{p_{1}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">p</mi><mn mathsize="0.710em">1</mn></msub><annotation encoding="application/x-tex">\scriptstyle{p_{1}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(139.56,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 106.3540975830112 -0.27673578005007266 L 139.5628979150992 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 139.5628979150992 -0.27673578005007266 L 139.5628979150992 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(139.56,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.08em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="14.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.Ex13.m1.pic1.m5" class="ltx_Math" alttext="\textstyle{M}" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">\textstyle{M}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.I7.i2.p1.2" class="ltx_p">where <math id="S6.I7.i2.p1.m4" class="ltx_Math" alttext="p_{1}:M\times_{B}M\to M" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>1</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>M</mi><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>B</mi></msub><mi>M</mi></mrow><mo stretchy="false">→</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">p_{1}:M\times_{B}M\to M</annotation></semantics></math> is the projection to the first factor, viewing the fiber product <math id="S6.I7.i2.p1.m5" class="ltx_Math" alttext="M\times_{B}M" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>B</mi></msub><mi>M</mi></mrow><annotation encoding="application/x-tex">M\times_{B}M</annotation></semantics></math> as a subset of <math id="S6.I7.i2.p1.m6" class="ltx_Math" alttext="M\times M" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">M\times M</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
</div>
<div id="S6.Thmthm12" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm12.2" class="ltx_text ltx_font_italic">Remark 6.12</span></span><span id="S6.Thmthm12.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S6.Thmthm12.p1" class="ltx_para">
<p id="S6.Thmthm12.p1.1" class="ltx_p">Our primary examples of topological submersions come from the forgetful map <math id="S6.Thmthm12.p1.m1" class="ltx_Math" alttext="\pi_{pq}:V_{pq}\to B_{pq}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi>B</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\pi_{pq}:V_{pq}\to B_{pq}</annotation></semantics></math> in (<a href="#S5.E38" title="In Lemma 5.48. ‣ 5.3.4. Regularity for the multi-layered thickening ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.38</span></a>). It is important to notice that the fibers are indeed topological manifolds without boundary, because the complex structure on the domain of the element <math id="S6.Thmthm12.p1.m2" class="ltx_Math" alttext="(\Sigma,u,F,\eta_{1},\dots,\eta_{d})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>F</mi><mo>,</mo><msub><mi>η</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>η</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Sigma,u,F,\eta_{1},\dots,\eta_{d})</annotation></semantics></math> has been fixed.</p>
</div>
</div>
<div id="S6.SS1.SSS3.p2" class="ltx_para">
<p id="S6.SS1.SSS3.p2.1" class="ltx_p">Now we include group actions. Let <math id="S6.SS1.SSS3.p2.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> be a compact Lie group. Recall that a <math id="S6.SS1.SSS3.p2.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-action on an <math id="S6.SS1.SSS3.p2.m3" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-space is a continuous <math id="S6.SS1.SSS3.p2.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-action which preserve each stratum. We assume that <math id="S6.SS1.SSS3.p2.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> acts continuously on <math id="S6.SS1.SSS3.p2.m6" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> and smoothly on <math id="S6.SS1.SSS3.p2.m7" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>, and that <math id="S6.SS1.SSS3.p2.m8" class="ltx_Math" alttext="\pi:M\to B" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mi>B</mi></mrow></mrow><annotation encoding="application/x-tex">\pi:M\to B</annotation></semantics></math> is <math id="S6.SS1.SSS3.p2.m9" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant. Then for each <math id="S6.SS1.SSS3.p2.m10" class="ltx_Math" alttext="g\in G" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>∈</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">g\in G</annotation></semantics></math>, <math id="S6.SS1.SSS3.p2.m11" class="ltx_Math" alttext="p\in M" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">p\in M</annotation></semantics></math>, and a product neighborhood <math id="S6.SS1.SSS3.p2.m12" class="ltx_Math" alttext="(W,\iota)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>W</mi><mo>,</mo><mi>ι</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(W,\iota)</annotation></semantics></math> of <math id="S6.SS1.SSS3.p2.m13" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>, <math id="S6.SS1.SSS3.p2.m14" class="ltx_Math" alttext="(g(W),g_{*}\iota)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>g</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ι</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(g(W),g_{*}\iota)</annotation></semantics></math> is a product neighborhood of <math id="S6.SS1.SSS3.p2.m15" class="ltx_Math" alttext="g(p)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g(p)</annotation></semantics></math>, where</p>
<table id="S6.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex14.m1" class="ltx_Math" alttext="g_{*}\iota(w)=g(\iota(g^{-1}(w)))." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>g</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ι</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ι</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>g</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">g_{*}\iota(w)=g(\iota(g^{-1}(w))).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS1.SSS3.p2.2" class="ltx_p">Here <math id="S6.SS1.SSS3.p2.m16" class="ltx_Math" alttext="g:W|_{b}\times\pi(W)\to W|_{g(b)}\times\pi(g(W))" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mrow><mi>W</mi><mo rspace="0.055em" stretchy="false">|</mo></mrow><mi>b</mi></msub><mo rspace="0.222em">×</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mrow><mi>W</mi><mo rspace="0.055em" stretchy="false">|</mo></mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo rspace="0.222em">×</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">g:W|_{b}\times\pi(W)\to W|_{g(b)}\times\pi(g(W))</annotation></semantics></math> is the diagonal action.</p>
</div>
<div id="S6.Thmthm13" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm13.2" class="ltx_text ltx_font_bold">Definition 6.13</span></span><span id="S6.Thmthm13.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmthm13.p1" class="ltx_para">
<p id="S6.Thmthm13.p1.1" class="ltx_p"><cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>, Definition 4.19]</cite>
For each <math id="S6.Thmthm13.p1.m1" class="ltx_Math" alttext="p\in M" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">p\in M</annotation></semantics></math>, denote by <math id="S6.Thmthm13.p1.m2" class="ltx_Math" alttext="G_{p}\subset G" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mi>p</mi></msub><mo>⊂</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">G_{p}\subset G</annotation></semantics></math> the stabilizer of <math id="S6.Thmthm13.p1.m3" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>. A <math id="S6.Thmthm13.p1.m4" class="ltx_Math" alttext="G_{p}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>p</mi></msub><annotation encoding="application/x-tex">G_{p}</annotation></semantics></math>-invariant product neighborhood of <math id="S6.Thmthm13.p1.m5" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> is a product neighborhood <math id="S6.Thmthm13.p1.m6" class="ltx_Math" alttext="(W,\iota)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>W</mi><mo>,</mo><mi>ι</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(W,\iota)</annotation></semantics></math> of <math id="S6.Thmthm13.p1.m7" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> which is <math id="S6.Thmthm13.p1.m8" class="ltx_Math" alttext="G_{p}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>p</mi></msub><annotation encoding="application/x-tex">G_{p}</annotation></semantics></math>-invariant, i.e., <math id="S6.Thmthm13.p1.m9" class="ltx_Math" alttext="(g(W),g_{*}\iota)=(W,\iota)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>g</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>ι</mi></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo>,</mo><mi>ι</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(g(W),g_{*}\iota)=(W,\iota)</annotation></semantics></math> for any <math id="S6.Thmthm13.p1.m10" class="ltx_Math" alttext="g\in G_{p}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>∈</mo><msub><mi>G</mi><mi>p</mi></msub></mrow><annotation encoding="application/x-tex">g\in G_{p}</annotation></semantics></math>.</p>
</div>
<div id="S6.Thmthm13.p2" class="ltx_para">
<p id="S6.Thmthm13.p2.1" class="ltx_p">We say that the <math id="S6.Thmthm13.p2.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant map <math id="S6.Thmthm13.p2.m2" class="ltx_Math" alttext="\pi:M\to B" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mi>B</mi></mrow></mrow><annotation encoding="application/x-tex">\pi:M\to B</annotation></semantics></math> is a <math id="S6.Thmthm13.p2.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math><span id="S6.Thmthm13.p2.1.1" class="ltx_text ltx_font_bold">-equivariant topological submersion</span> if every point <math id="S6.Thmthm13.p2.m4" class="ltx_Math" alttext="p\in M" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">p\in M</annotation></semantics></math> admits a <math id="S6.Thmthm13.p2.m5" class="ltx_Math" alttext="G_{p}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>p</mi></msub><annotation encoding="application/x-tex">G_{p}</annotation></semantics></math>-invariant product neighborhood. We say that the <math id="S6.Thmthm13.p2.m6" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-action is <span id="S6.Thmthm13.p2.1.2" class="ltx_text ltx_font_bold">fiberwise locally linear</span> if for each <math id="S6.Thmthm13.p2.m7" class="ltx_Math" alttext="b\in B" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>∈</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">b\in B</annotation></semantics></math>, the action of <math id="S6.Thmthm13.p2.m8" class="ltx_Math" alttext="G_{b}\subset G" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mi>b</mi></msub><mo>⊂</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">G_{b}\subset G</annotation></semantics></math> on <math id="S6.Thmthm13.p2.m9" class="ltx_Math" alttext="M_{b}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>b</mi></msub><annotation encoding="application/x-tex">M_{b}</annotation></semantics></math> is locally linear.</p>
</div>
</div>
<div id="S6.Thmthm14" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm14.2" class="ltx_text ltx_font_italic">Remark 6.14</span></span><span id="S6.Thmthm14.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S6.Thmthm14.p1" class="ltx_para">
<p id="S6.Thmthm14.p1.1" class="ltx_p">Any <math id="S6.Thmthm14.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant vector bundle <math id="S6.Thmthm14.p1.m2" class="ltx_Math" alttext="p:E\to B" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>E</mi><mo stretchy="false">→</mo><mi>B</mi></mrow></mrow><annotation encoding="application/x-tex">p:E\to B</annotation></semantics></math> is a fiberwise locally linear equivariant topological submersion.</p>
</div>
</div>
<div id="S6.SS1.SSS3.p3" class="ltx_para">
<p id="S6.SS1.SSS3.p3.1" class="ltx_p">Now we recall how to construct smoothings of the total space of a topological submersion with a fiberwise smooth structure.</p>
</div>
<div id="S6.Thmthm15" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm15.2" class="ltx_text ltx_font_bold">Definition 6.15</span></span><span id="S6.Thmthm15.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmthm15.p1" class="ltx_para">
<p id="S6.Thmthm15.p1.1" class="ltx_p"><cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>, Definition 4.27]</cite>
Let <math id="S6.Thmthm15.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> be a compact Lie group. Let <math id="S6.Thmthm15.p1.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> be a topological manifold with a <math id="S6.Thmthm15.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-action. Let <math id="S6.Thmthm15.p1.m4" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> be a smooth <math id="S6.Thmthm15.p1.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-manifold and <math id="S6.Thmthm15.p1.m6" class="ltx_Math" alttext="\pi:M\to B" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mi>B</mi></mrow></mrow><annotation encoding="application/x-tex">\pi:M\to B</annotation></semantics></math> be a <math id="S6.Thmthm15.p1.m7" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant topological submersion.</p>
</div>
<div id="S6.Thmthm15.p2" class="ltx_para">
<ol id="S6.I8" class="ltx_enumerate">
<li id="S6.I8.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S6.I8.i1.p1" class="ltx_para">
<p id="S6.I8.i1.p1.1" class="ltx_p">A <span id="S6.I8.i1.p1.1.1" class="ltx_text ltx_font_bold">fiberwise smooth structure</span> on <math id="S6.I8.i1.p1.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> (with respect to the map <math id="S6.I8.i1.p1.m2" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math>) is a choice of smooth structures (by definition a maximal <math id="S6.I8.i1.p1.m3" class="ltx_Math" alttext="C^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">C^{\infty}</annotation></semantics></math>-compatible atlas) on all fibers of <math id="S6.I8.i1.p1.m4" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math>.</p>
</div></li>
<li id="S6.I8.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S6.I8.i2.p1" class="ltx_para">
<p id="S6.I8.i2.p1.1" class="ltx_p">Given a fiberwise smooth structure on <math id="S6.I8.i2.p1.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, two product neighborhoods <math id="S6.I8.i2.p1.m2" class="ltx_Math" alttext="\iota_{i}:W_{i}\to W_{i}|_{b_{i}}\times\pi(W_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ι</mi><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>W</mi><mi>i</mi></msub><mo stretchy="false">→</mo><mrow><msub><mrow><msub><mi>W</mi><mi>i</mi></msub><mo rspace="0.055em" stretchy="false">|</mo></mrow><msub><mi>b</mi><mi>i</mi></msub></msub><mo rspace="0.222em">×</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\iota_{i}:W_{i}\to W_{i}|_{b_{i}}\times\pi(W_{i})</annotation></semantics></math>, <math id="S6.I8.i2.p1.m3" class="ltx_Math" alttext="i=1,2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">i=1,2</annotation></semantics></math> are <math id="S6.I8.i2.p1.m4" class="ltx_Math" alttext="C_{\rm loc}^{1}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi>loc</mi><mn>1</mn></msubsup><annotation encoding="application/x-tex">C_{\rm loc}^{1}</annotation></semantics></math><span id="S6.I8.i2.p1.1.1" class="ltx_text ltx_font_bold">-compatible</span> if for each <math id="S6.I8.i2.p1.m5" class="ltx_Math" alttext="p\in W_{1}\cap W_{2}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mrow><msub><mi>W</mi><mn>1</mn></msub><mo>∩</mo><msub><mi>W</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">p\in W_{1}\cap W_{2}</annotation></semantics></math> there exists a product neighborhood <math id="S6.I8.i2.p1.m6" class="ltx_Math" alttext="\iota:W\to W|_{b}\times\pi(W)" display="inline" intent=":literal"><semantics><mrow><mi>ι</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>W</mi><mo stretchy="false">→</mo><mrow><msub><mrow><mi>W</mi><mo rspace="0.055em" stretchy="false">|</mo></mrow><mi>b</mi></msub><mo rspace="0.222em">×</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\iota:W\to W|_{b}\times\pi(W)</annotation></semantics></math>, <math id="S6.I8.i2.p1.m7" class="ltx_Math" alttext="b=\pi(p)" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">b=\pi(p)</annotation></semantics></math> satisfying the following conditions. For each <math id="S6.I8.i2.p1.m8" class="ltx_Math" alttext="v\in\pi(W)" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">v\in\pi(W)</annotation></semantics></math>, the definition of product neighborhoods (see Definition <a href="#S6.Thmthm11" title="Definition 6.11. ‣ 6.1.3. Topological submersions ‣ 6.1. Preliminaries ‣ 6. Smoothing ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.11</span></a>) implies that the map</p>
<table id="S6.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex15.m1" class="ltx_Math" alttext="\iota_{v}:W|_{v}\to\{v\}\times W|_{b}" display="block" intent=":literal"><semantics><mrow><msub><mi>ι</mi><mi>v</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mrow><mi>W</mi><mo stretchy="false">|</mo></mrow><mi>v</mi></msub><mo stretchy="false">→</mo><mrow><mrow><mo stretchy="false">{</mo><mi>v</mi><mo rspace="0.055em" stretchy="false">}</mo></mrow><mo rspace="0.222em">×</mo><msub><mrow><mi>W</mi><mo stretchy="false">|</mo></mrow><mi>b</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\iota_{v}:W|_{v}\to\{v\}\times W|_{b}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.I8.i2.p1.2" class="ltx_p">is a homeomorphism. Consider the family of maps</p>
<table id="S6.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex16.m1" class="ltx_Math" alttext="\eta_{v}:W|_{b}\to W_{i}|_{b_{i}},\ w\mapsto\Pi_{i}\big(\iota_{i}(\iota_{v}^{-1}(w))\big)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>η</mi><mi>v</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mrow><mi>W</mi><mo stretchy="false">|</mo></mrow><mi>b</mi></msub><mo stretchy="false">→</mo><msub><mrow><msub><mi>W</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><msub><mi>b</mi><mi>i</mi></msub></msub></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mi>w</mi><mo stretchy="false">↦</mo><mrow><msub><mi mathvariant="normal">Π</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>ι</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>ι</mi><mi>v</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta_{v}:W|_{b}\to W_{i}|_{b_{i}},\ w\mapsto\Pi_{i}\big(\iota_{i}(\iota_{v}^{-1}(w))\big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.I8.i2.p1.3" class="ltx_p">where <math id="S6.I8.i2.p1.m9" class="ltx_Math" alttext="\Pi_{i}:W_{i}|_{b_{i}}\times\pi(W_{i})\to W_{i}|_{b_{i}}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Π</mi><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mrow><msub><mi>W</mi><mi>i</mi></msub><mo rspace="0.055em" stretchy="false">|</mo></mrow><msub><mi>b</mi><mi>i</mi></msub></msub><mo rspace="0.222em">×</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">→</mo><msub><mrow><msub><mi>W</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><msub><mi>b</mi><mi>i</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">\Pi_{i}:W_{i}|_{b_{i}}\times\pi(W_{i})\to W_{i}|_{b_{i}}</annotation></semantics></math> is the projection. Then for each <math id="S6.I8.i2.p1.m10" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> and <math id="S6.I8.i2.p1.m11" class="ltx_Math" alttext="i=1,2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">i=1,2</annotation></semantics></math>, <math id="S6.I8.i2.p1.m12" class="ltx_Math" alttext="\eta_{v}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mi>v</mi></msub><annotation encoding="application/x-tex">\eta_{v}</annotation></semantics></math> is a smooth map from <math id="S6.I8.i2.p1.m13" class="ltx_Math" alttext="W|_{b}" display="inline" intent=":literal"><semantics><msub><mrow><mi>W</mi><mo stretchy="false">|</mo></mrow><mi>b</mi></msub><annotation encoding="application/x-tex">W|_{b}</annotation></semantics></math> to <math id="S6.I8.i2.p1.m14" class="ltx_Math" alttext="W_{i}|_{b_{i}}" display="inline" intent=":literal"><semantics><msub><mrow><msub><mi>W</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><msub><mi>b</mi><mi>i</mi></msub></msub><annotation encoding="application/x-tex">W_{i}|_{b_{i}}</annotation></semantics></math> and varies with <math id="S6.I8.i2.p1.m15" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> continuously with respect to the <math id="S6.I8.i2.p1.m16" class="ltx_Math" alttext="C_{\rm loc}^{1}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi>loc</mi><mn>1</mn></msubsup><annotation encoding="application/x-tex">C_{\rm loc}^{1}</annotation></semantics></math>-topology.</p>
</div></li>
<li id="S6.I8.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S6.I8.i3.p1" class="ltx_para">
<p id="S6.I8.i3.p1.1" class="ltx_p">A <span id="S6.I8.i3.p1.1.1" class="ltx_text ltx_font_bold">fiberwise smooth <math id="S6.I8.i3.p1.m1" class="ltx_Math" alttext="C_{\rm loc}^{1}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi>loc</mi><mn>1</mn></msubsup><annotation encoding="application/x-tex">C_{\rm loc}^{1}</annotation></semantics></math> <math id="S6.I8.i3.p1.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle</span> is a <math id="S6.I8.i3.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant topological submersion <math id="S6.I8.i3.p1.m4" class="ltx_Math" alttext="\pi:M\to B" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mi>B</mi></mrow></mrow><annotation encoding="application/x-tex">\pi:M\to B</annotation></semantics></math> together with a collection <math id="S6.I8.i3.p1.m5" class="ltx_Math" alttext="(\iota_{i})_{i\in I}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>ι</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mi>I</mi></mrow></msub><annotation encoding="application/x-tex">(\iota_{i})_{i\in I}</annotation></semantics></math> of <math id="S6.I8.i3.p1.m6" class="ltx_Math" alttext="C_{\rm loc}^{1}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi>loc</mi><mn>1</mn></msubsup><annotation encoding="application/x-tex">C_{\rm loc}^{1}</annotation></semantics></math>-compatible <math id="S6.I8.i3.p1.m7" class="ltx_Math" alttext="G_{p}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>p</mi></msub><annotation encoding="application/x-tex">G_{p}</annotation></semantics></math>-invariant product neighborhoods around a collection of points <math id="S6.I8.i3.p1.m8" class="ltx_Math" alttext="(p_{i})_{i\in I}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>∈</mo><mi>I</mi></mrow></msub><annotation encoding="application/x-tex">(p_{i})_{i\in I}</annotation></semantics></math> whose domains cover <math id="S6.I8.i3.p1.m9" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
</div>
<div id="S6.Thmthm16" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm16.2" class="ltx_text ltx_font_italic">Remark 6.16</span></span><span id="S6.Thmthm16.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S6.Thmthm16.p1" class="ltx_para">
<p id="S6.Thmthm16.p1.1" class="ltx_p">Despite our previous discussions work under the setting that <math id="S6.Thmthm16.p1.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> is an <math id="S6.Thmthm16.p1.m2" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-manifold, the above notions is defined for <math id="S6.Thmthm16.p1.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> being a manifold without boundary. In practice, when we perform smoothing inductively, we apply Theorem <a href="#S6.Thmthm10" title="Theorem 6.10. ‣ 6.1.2. Stable equivariant smoothings ‣ 6.1. Preliminaries ‣ 6. Smoothing ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.10</span></a> to the top stratum of a topological <math id="S6.Thmthm16.p1.m4" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-manifold <math id="S6.Thmthm16.p1.m5" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>. Therefore, it suffices to set up certain parts of the theory for manifolds without boundary or corners.</p>
</div>
</div>
</section>
<section id="S6.SS1.SSS4" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">6.1.4. </span>Fiberwise submersions</h4>

<div id="S6.SS1.SSS4.p1" class="ltx_para">
<p id="S6.SS1.SSS4.p1.1" class="ltx_p">A fiberwise smooth <math id="S6.SS1.SSS4.p1.m1" class="ltx_Math" alttext="C_{\rm loc}^{1}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi>loc</mi><mn>1</mn></msubsup><annotation encoding="application/x-tex">C_{\rm loc}^{1}</annotation></semantics></math>-bundle <math id="S6.SS1.SSS4.p1.m2" class="ltx_Math" alttext="\pi:M\to B" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mi>B</mi></mrow></mrow><annotation encoding="application/x-tex">\pi:M\to B</annotation></semantics></math> has a well-defined <span id="S6.SS1.SSS4.p1.1.1" class="ltx_text ltx_font_bold">vertical tangent bundle</span>, denoted by <math id="S6.SS1.SSS4.p1.m3" class="ltx_Math" alttext="T^{\rm vt}M" display="inline" intent=":literal"><semantics><mrow><msup><mi>T</mi><mi>vt</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">T^{\rm vt}M</annotation></semantics></math>, by patching up the tangent bundles of the fibers, and an isotopy class of <math id="S6.SS1.SSS4.p1.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-vector bundle lift</p>
<table id="S6.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex17.m1" class="ltx_Math" alttext="T^{\rm vt}M\to T_{\mu}^{\rm vt}M" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>T</mi><mi>vt</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">→</mo><mrow><msubsup><mi>T</mi><mi>μ</mi><mi>vt</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">T^{\rm vt}M\to T_{\mu}^{\rm vt}M</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS1.SSS4.p1.2" class="ltx_p">by using a <math id="S6.SS1.SSS4.p1.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant fiberwise Riemannian metric (see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>, Lemma 4.29]</cite>).</p>
</div>
<div id="S6.SS1.SSS4.p2" class="ltx_para">
<p id="S6.SS1.SSS4.p2.1" class="ltx_p">Now suppose <math id="S6.SS1.SSS4.p2.m1" class="ltx_Math" alttext="\pi:M\to B" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mi>B</mi></mrow></mrow><annotation encoding="application/x-tex">\pi:M\to B</annotation></semantics></math> is a fiberwise smooth <math id="S6.SS1.SSS4.p2.m2" class="ltx_Math" alttext="C_{\rm loc}^{1}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi>loc</mi><mn>1</mn></msubsup><annotation encoding="application/x-tex">C_{\rm loc}^{1}</annotation></semantics></math> <math id="S6.SS1.SSS4.p2.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle. There is a well-defined <math id="S6.SS1.SSS4.p2.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-microbundle</p>
<table id="S6.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex18.m1" class="ltx_Math" alttext="\pi^{*}T_{\mu}B\oplus T^{\rm vt}_{\mu}M," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>π</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo>⊕</mo><mrow><msubsup><mi>T</mi><mi>μ</mi><mi>vt</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\pi^{*}T_{\mu}B\oplus T^{\rm vt}_{\mu}M,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS1.SSS4.p2.2" class="ltx_p">a well-defined <math id="S6.SS1.SSS4.p2.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-vector bundle</p>
<table id="S6.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex19.m1" class="ltx_Math" alttext="\pi^{*}TB\oplus T^{\rm vt}M," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>π</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo>⊕</mo><mrow><msup><mi>T</mi><mi>vt</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\pi^{*}TB\oplus T^{\rm vt}M,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS1.SSS4.p2.3" class="ltx_p">and a well-defined <math id="S6.SS1.SSS4.p2.m6" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-isotopy class of vector bundle lifts</p>
<table id="S6.E3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E3.m1" class="ltx_Math" alttext="(\pi^{*}TB\oplus T^{\rm vt}M)_{\mu}\to\pi^{*}T_{\mu}B\oplus T^{\rm vt}_{\mu}M" display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>π</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo>⊕</mo><mrow><msup><mi>T</mi><mi>vt</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>μ</mi></msub><mo stretchy="false">→</mo><mrow><mrow><msup><mi>π</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo>⊕</mo><mrow><msubsup><mi>T</mi><mi>μ</mi><mi>vt</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">(\pi^{*}TB\oplus T^{\rm vt}M)_{\mu}\to\pi^{*}T_{\mu}B\oplus T^{\rm vt}_{\mu}M</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(6.3)</span></td></tr></tbody>
</table>
<p id="S6.SS1.SSS4.p2.4" class="ltx_p">constructed using the exponential map after further choosing a Riemannian metric on <math id="S6.SS1.SSS4.p2.m7" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>. Note that both the space of fiberwise Riemannian metrics on <math id="S6.SS1.SSS4.p2.m8" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> varying continuously over <math id="S6.SS1.SSS4.p2.m9" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>, and the space of Riemannian metrics are contractible. Therefore, all these choices induce the same isotopy class of the vector bundle reduction for the direct sum <math id="S6.SS1.SSS4.p2.m10" class="ltx_Math" alttext="\pi^{*}T_{\mu}B\oplus T^{\rm vt}_{\mu}M" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>π</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo>⊕</mo><mrow><msubsup><mi>T</mi><mi>μ</mi><mi>vt</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">\pi^{*}T_{\mu}B\oplus T^{\rm vt}_{\mu}M</annotation></semantics></math>.
To qualify the condition for stable <math id="S6.SS1.SSS4.p2.m11" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-smoothing (see Theorem <a href="#S6.Thmthm9" title="Theorem 6.9. ‣ 6.1.2. Stable equivariant smoothings ‣ 6.1. Preliminaries ‣ 6. Smoothing ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.9</span></a>), one only needs to identify the right hand side with the tangent microbundle of the total space <math id="S6.SS1.SSS4.p2.m12" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>. However this identification is not canonical even up to isotopy of microbundle isomorphisms. This is what we need to construct during the smoothing process.</p>
</div>
<div id="S6.Thmthm17" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm17.2" class="ltx_text ltx_font_italic">Remark 6.17</span></span><span id="S6.Thmthm17.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S6.Thmthm17.p1" class="ltx_para">
<p id="S6.Thmthm17.p1.1" class="ltx_p">Different data for constructing the splitting (<a href="#S6.E3" title="In 6.1.4. Fiberwise submersions ‣ 6.1. Preliminaries ‣ 6. Smoothing ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.3</span></a>) from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>, Lemma 4.24, Proposition 4.26]</cite> can in fact be interpolated with each other, so the splittings (<a href="#S6.E3" title="In 6.1.4. Fiberwise submersions ‣ 6.1. Preliminaries ‣ 6. Smoothing ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.3</span></a>) arising from this way should be isotopic to each other. Keeping track of these choices are important for showing that the “invariants” constructed in this paper are indeed independent of all the auxiliary choices, but we do not need such invariance results for our applications.</p>
</div>
</div>
<div id="S6.Thmthm18" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm18.2" class="ltx_text ltx_font_bold">Definition 6.18</span></span><span id="S6.Thmthm18.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmthm18.p1" class="ltx_para">
<p id="S6.Thmthm18.p1.1" class="ltx_p"><cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>, Definition 4.22]</cite>
Suppose <math id="S6.Thmthm18.p1.m1" class="ltx_Math" alttext="\pi:M\to B" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mi>B</mi></mrow></mrow><annotation encoding="application/x-tex">\pi:M\to B</annotation></semantics></math> is a <math id="S6.Thmthm18.p1.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant topological submersion. Let <math id="S6.Thmthm18.p1.m3" class="ltx_Math" alttext="W\subset M" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>⊂</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">W\subset M</annotation></semantics></math> be a <math id="S6.Thmthm18.p1.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant open subset. A <math id="S6.Thmthm18.p1.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math><span id="S6.Thmthm18.p1.1.1" class="ltx_text ltx_font_bold">-equivariant fiberwise submersion along <math id="S6.Thmthm18.p1.m6" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math></span> is a continuous map <math id="S6.Thmthm18.p1.m7" class="ltx_Math" alttext="\phi:\widetilde{W}\to M" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mover accent="true"><mi>W</mi><mo>~</mo></mover><mo stretchy="false">→</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">\phi:\widetilde{W}\to M</annotation></semantics></math> where <math id="S6.Thmthm18.p1.m8" class="ltx_Math" alttext="\widetilde{W}\subset W\times W" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>W</mi><mo>~</mo></mover><mo>⊂</mo><mrow><mi>W</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>W</mi></mrow></mrow><annotation encoding="application/x-tex">\widetilde{W}\subset W\times W</annotation></semantics></math> is an open neighborhood of the diagonal satisfying the following properties.</p>
<ol id="S6.I9" class="ltx_enumerate">
<li id="S6.I9.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S6.I9.i1.p1" class="ltx_para">
<p id="S6.I9.i1.p1.1" class="ltx_p"><math id="S6.I9.i1.p1.m1" class="ltx_Math" alttext="\phi_{q,b}:=\phi|_{\widetilde{W}\cap(\{q\}\times M_{b})}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mrow><mi>q</mi><mo>,</mo><mi>b</mi></mrow></msub><mo>:=</mo><msub><mrow><mi>ϕ</mi><mo stretchy="false">|</mo></mrow><mrow><mover accent="true"><mi>W</mi><mo>~</mo></mover><mo>∩</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">{</mo><mi>q</mi><mo rspace="0.055em" stretchy="false">}</mo></mrow><mo rspace="0.222em">×</mo><msub><mi>M</mi><mi>b</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\phi_{q,b}:=\phi|_{\widetilde{W}\cap(\{q\}\times M_{b})}</annotation></semantics></math> is a homeomorphism onto an open subset of <math id="S6.I9.i1.p1.m2" class="ltx_Math" alttext="M_{\pi(q)}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></msub><annotation encoding="application/x-tex">M_{\pi(q)}</annotation></semantics></math> for all <math id="S6.I9.i1.p1.m3" class="ltx_Math" alttext="b\in\pi(W)" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>∈</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">b\in\pi(W)</annotation></semantics></math> and <math id="S6.I9.i1.p1.m4" class="ltx_Math" alttext="q\in W" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>∈</mo><mi>W</mi></mrow><annotation encoding="application/x-tex">q\in W</annotation></semantics></math>.</p>
</div></li>
<li id="S6.I9.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S6.I9.i2.p1" class="ltx_para">
<p id="S6.I9.i2.p1.1" class="ltx_p"><math id="S6.I9.i2.p1.m1" class="ltx_Math" alttext="\phi_{q,\pi(q)}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mrow><mi>q</mi><mo>,</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><annotation encoding="application/x-tex">\phi_{q,\pi(q)}</annotation></semantics></math> sends each point <math id="S6.I9.i2.p1.m2" class="ltx_Math" alttext="(q,q^{\prime})\in\widetilde{W}\cap(\{q\}\times M_{\pi(q)})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>q</mi><mo>,</mo><msup><mi>q</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mover accent="true"><mi>W</mi><mo>~</mo></mover><mo>∩</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">{</mo><mi>q</mi><mo rspace="0.055em" stretchy="false">}</mo></mrow><mo rspace="0.222em">×</mo><msub><mi>M</mi><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(q,q^{\prime})\in\widetilde{W}\cap(\{q\}\times M_{\pi(q)})</annotation></semantics></math> to <math id="S6.I9.i2.p1.m3" class="ltx_Math" alttext="q^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>q</mi><mo>′</mo></msup><annotation encoding="application/x-tex">q^{\prime}</annotation></semantics></math>.</p>
</div></li>
<li id="S6.I9.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S6.I9.i3.p1" class="ltx_para">
<p id="S6.I9.i3.p1.1" class="ltx_p"><math id="S6.I9.i3.p1.m1" class="ltx_Math" alttext="\widetilde{W}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>W</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{W}</annotation></semantics></math> is a <math id="S6.I9.i3.p1.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant set with respect to the diagonal <math id="S6.I9.i3.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-action on <math id="S6.I9.i3.p1.m4" class="ltx_Math" alttext="W\times W" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>W</mi></mrow><annotation encoding="application/x-tex">W\times W</annotation></semantics></math> and <math id="S6.I9.i3.p1.m5" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> is a <math id="S6.I9.i3.p1.m6" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant map.</p>
</div></li>
</ol>
</div>
</div>
<div id="S6.Thmthm19" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm19.2" class="ltx_text ltx_font_italic">Remark 6.19</span></span><span id="S6.Thmthm19.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S6.Thmthm19.p1" class="ltx_para">
<p id="S6.Thmthm19.p1.1" class="ltx_p">Suppose <math id="S6.Thmthm19.p1.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> is smooth and <math id="S6.Thmthm19.p1.m2" class="ltx_Math" alttext="\pi:M\to B" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mi>B</mi></mrow></mrow><annotation encoding="application/x-tex">\pi:M\to B</annotation></semantics></math> is a smooth submersion. Then one can construct a fiberwise submersion using a <math id="S6.Thmthm19.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant Riemannian metric and the exponential map in the horizontal direction.</p>
</div>
</div>
<div id="S6.Thmthm20" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm20.2" class="ltx_text ltx_font_italic">Remark 6.20</span></span><span id="S6.Thmthm20.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S6.Thmthm20.p1" class="ltx_para">
<p id="S6.Thmthm20.p1.1" class="ltx_p">A <math id="S6.Thmthm20.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant fiberwise submersion along <math id="S6.Thmthm20.p1.m2" class="ltx_Math" alttext="W=M" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>=</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">W=M</annotation></semantics></math> provides a <math id="S6.Thmthm20.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-microbundle morphism</p>
<table id="S6.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex20.m1" class="ltx_Math" alttext="\tau:T_{\mu}M\to T_{\mu}^{\rm vt}M" display="block" intent=":literal"><semantics><mrow><mi>τ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">→</mo><mrow><msubsup><mi>T</mi><mi>μ</mi><mi>vt</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau:T_{\mu}M\to T_{\mu}^{\rm vt}M</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.Thmthm20.p1.2" class="ltx_p">which is defined as</p>
<table id="S6.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex21.m1" class="ltx_Math" alttext="M\times M\supseteq\widetilde{M}\ni(p,p^{\prime})\mapsto(p,\phi(p,p^{\prime}))" display="block" intent=":literal"><semantics><mrow><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi></mrow><mo>⊇</mo><mover accent="true"><mi>M</mi><mo>~</mo></mover><mo>∋</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><msup><mi>p</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">↦</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><msup><mi>p</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M\times M\supseteq\widetilde{M}\ni(p,p^{\prime})\mapsto(p,\phi(p,p^{\prime}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.Thmthm20.p1.3" class="ltx_p">which is the identity morphism on the sub-microbundle <math id="S6.Thmthm20.p1.m4" class="ltx_Math" alttext="T_{\mu}^{\rm vt}M\subset T_{\mu}M" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>T</mi><mi>μ</mi><mi>vt</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>⊂</mo><mrow><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">T_{\mu}^{\rm vt}M\subset T_{\mu}M</annotation></semantics></math>. On the other hand, there is a canonical <math id="S6.Thmthm20.p1.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-microbundle morphism</p>
<table id="S6.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex22.m1" class="ltx_Math" alttext="P:T_{\mu}M\to\pi^{*}T_{\mu}B,\ (p,p^{\prime})\mapsto(p,(\pi(p),\pi(p^{\prime})))." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>P</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">→</mo><mrow><msup><mi>π</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><msup><mi>p</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">↦</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>p</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P:T_{\mu}M\to\pi^{*}T_{\mu}B,\ (p,p^{\prime})\mapsto(p,(\pi(p),\pi(p^{\prime}))).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.Thmthm20.p1.4" class="ltx_p">Hence the <math id="S6.Thmthm20.p1.m6" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant fiberwise submersion induces an isomorphism of microbundles</p>
<table id="S6.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex23.m1" class="ltx_Math" alttext="P\oplus\tau:T_{\mu}M\to\pi^{*}T_{\mu}B\oplus T^{\rm vt}_{\mu}M." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>P</mi><mo>⊕</mo><mi>τ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">→</mo><mrow><mrow><msup><mi>π</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo>⊕</mo><mrow><msubsup><mi>T</mi><mi>μ</mi><mi>vt</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P\oplus\tau:T_{\mu}M\to\pi^{*}T_{\mu}B\oplus T^{\rm vt}_{\mu}M.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.Thmthm20.p1.5" class="ltx_p">If <math id="S6.Thmthm20.p1.m7" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> is a fiberwise smooth <math id="S6.Thmthm20.p1.m8" class="ltx_Math" alttext="C_{\rm loc}^{1}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi>loc</mi><mn>1</mn></msubsup><annotation encoding="application/x-tex">C_{\rm loc}^{1}</annotation></semantics></math> <math id="S6.Thmthm20.p1.m9" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle, then a <math id="S6.Thmthm20.p1.m10" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant fiberwise submersion along <math id="S6.Thmthm20.p1.m11" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> induces a well-defined <math id="S6.Thmthm20.p1.m12" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-isotopy class of vector bundle lift</p>
<table id="S6.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex24.m1" class="ltx_Math" alttext="(\pi^{*}TB\oplus T^{\rm vt}M)_{\mu}\cong T_{\mu}M." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>π</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo>⊕</mo><mrow><msup><mi>T</mi><mi>vt</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>μ</mi></msub><mo>≅</mo><mrow><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(\pi^{*}TB\oplus T^{\rm vt}M)_{\mu}\cong T_{\mu}M.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S6.Thmthm21" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm21.2" class="ltx_text ltx_font_bold">Lemma 6.21</span></span><span id="S6.Thmthm21.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmthm21.p1" class="ltx_para">
<p id="S6.Thmthm21.p1.1" class="ltx_p"><span id="S6.Thmthm21.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S6.Thmthm21.p1.m1" class="ltx_Math" alttext="C\subset M" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⊂</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">C\subset M</annotation></semantics></math> be a <math id="S6.Thmthm21.p1.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant closed set and <math id="S6.Thmthm21.p1.m3" class="ltx_Math" alttext="U\subset M" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⊂</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">U\subset M</annotation></semantics></math> be a <math id="S6.Thmthm21.p1.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant open neighborhood of <math id="S6.Thmthm21.p1.m5" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>. Let <math id="S6.Thmthm21.p1.m6" class="ltx_Math" alttext="D\subset M" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⊂</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">D\subset M</annotation></semantics></math> be another <math id="S6.Thmthm21.p1.m7" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant closed set. Suppose <math id="S6.Thmthm21.p1.m8" class="ltx_Math" alttext="\phi:\widetilde{U}\to M" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mover accent="true"><mi>U</mi><mo>~</mo></mover><mo stretchy="false">→</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">\phi:\widetilde{U}\to M</annotation></semantics></math> is a <math id="S6.Thmthm21.p1.m9" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant fiberwise submersion along <math id="S6.Thmthm21.p1.m10" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>. Then there exists a <math id="S6.Thmthm21.p1.m11" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant open neighborhood <math id="S6.Thmthm21.p1.m12" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> of <math id="S6.Thmthm21.p1.m13" class="ltx_Math" alttext="C\cup D" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>∪</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">C\cup D</annotation></semantics></math> and a <math id="S6.Thmthm21.p1.m14" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant fiberwise submersion <math id="S6.Thmthm21.p1.m15" class="ltx_Math" alttext="\psi:\widetilde{W}\to M" display="inline" intent=":literal"><semantics><mrow><mi>ψ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mover accent="true"><mi>W</mi><mo>~</mo></mover><mo stretchy="false">→</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">\psi:\widetilde{W}\to M</annotation></semantics></math> along <math id="S6.Thmthm21.p1.m16" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> which coincides with <math id="S6.Thmthm21.p1.m17" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> in a small neighborhood of the diagonal of <math id="S6.Thmthm21.p1.m18" class="ltx_Math" alttext="C\times C" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>C</mi></mrow><annotation encoding="application/x-tex">C\times C</annotation></semantics></math> in <math id="S6.Thmthm21.p1.m19" class="ltx_Math" alttext="U\times U" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>U</mi></mrow><annotation encoding="application/x-tex">U\times U</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S6.SS1.SSS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S6.SS1.SSS4.p3" class="ltx_para">
<p id="S6.SS1.SSS4.p3.1" class="ltx_p"><span id="S6.SS1.SSS4.p3.1.1" class="ltx_text">This is a restatement of the extension lemma <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>, Lemma 4.24]</cite> and a relative version of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>, Proposition 4.25]</cite>.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="S6.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">6.2. </span>Pre-smoothing operations and stable complex structures</h3>

<div id="S6.SS2.p1" class="ltx_para">
<p id="S6.SS2.p1.1" class="ltx_p">This subsection can be viewed as a continuation of Section <a href="#S5" title="5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>, in which we explore the more refined information of the K-charts <math id="S6.SS2.p1.m1" class="ltx_Math" alttext="K_{pq}=(V_{pq},E_{pq},G_{pq},S_{pq})" display="inline" intent=":literal"><semantics><mrow><msub><mi>K</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi>E</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi>S</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K_{pq}=(V_{pq},E_{pq},G_{pq},S_{pq})</annotation></semantics></math>. These properties will be used in the construction of smoothing. Furthermore, we also present materials relevant for building the normal complex structure.</p>
</div>
<section id="S6.SS2.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">6.2.1. </span>Topological submersions</h4>

<div id="S6.SS2.SSS1.p1" class="ltx_para">
<p id="S6.SS2.SSS1.p1.1" class="ltx_p">We have the following analogue of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>, Corollary 6.28, 6.29]</cite>.</p>
</div>
<div id="S6.Thmthm22" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm22.2" class="ltx_text ltx_font_bold">Proposition 6.22</span></span><span id="S6.Thmthm22.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmthm22.p1" class="ltx_para">
<p id="S6.Thmthm22.p1.1" class="ltx_p"><span id="S6.Thmthm22.p1.1.1" class="ltx_text ltx_font_italic">The natural forgetful map</span></p>
<table id="S6.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex25.m1" class="ltx_Math" alttext="\pi_{pq}:V_{pq}\to B_{d_{pq}}" display="block" intent=":literal"><semantics><mrow><msub><mi>π</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi>B</mi><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msub></mrow></mrow><annotation encoding="application/x-tex">\pi_{pq}:V_{pq}\to B_{d_{pq}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.Thmthm22.p1.2" class="ltx_p"><span id="S6.Thmthm22.p1.2.1" class="ltx_text ltx_font_italic">is a <math id="S6.Thmthm22.p1.m1" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math>-equivariant topological submersion and has the structure of a <math id="S6.Thmthm22.p1.m2" class="ltx_Math" alttext="C_{\rm loc}^{1}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi>loc</mi><mn>1</mn></msubsup><annotation encoding="application/x-tex">C_{\rm loc}^{1}</annotation></semantics></math> fiberwise smooth <math id="S6.Thmthm22.p1.m3" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math>-bundle.</span></p>
</div>
</div>
<div id="S6.SS2.SSS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S6.SS2.SSS1.p2" class="ltx_para">
<p id="S6.SS2.SSS1.p2.1" class="ltx_p"><span id="S6.SS2.SSS1.p2.1.1" class="ltx_text">This statement essentially a reformulation of the standard gluing construction in Floer theory which is presented for instance, in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx33" title="" class="ltx_ref">Par16</a>, Appendix C]</cite>. The slight difference is, here we are in a Morse–Bott situation because the asymptotic operator of elements in the moduli space <math id="S6.SS2.SSS1.p2.m1" class="ltx_Math" alttext="{\mathcal{M}}_{J_{\tilde{\Psi}},H}(k_{1},\ldots,k_{d})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><msub><mi>J</mi><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>~</mo></mover></msub><mo>,</mo><mi>H</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>k</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{M}}_{J_{\tilde{\Psi}},H}(k_{1},\ldots,k_{d})</annotation></semantics></math> has nontrivial kernel along the <math id="S6.SS2.SSS1.p2.m2" class="ltx_Math" alttext="{\mathcal{C}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">{\mathcal{C}}</annotation></semantics></math> and <math id="S6.SS2.SSS1.p2.m3" class="ltx_Math" alttext="{\mathcal{E}}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{i}</annotation></semantics></math> direction. However, this does not introduce any problem to the argument.</span></p>
</div>
<div id="S6.SS2.SSS1.p3" class="ltx_para">
<p id="S6.SS2.SSS1.p3.1" class="ltx_p"><span id="S6.SS2.SSS1.p3.1.1" class="ltx_text">As a first step, let us show that <math id="S6.SS2.SSS1.p3.m1" class="ltx_Math" alttext="\pi_{pq}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\pi_{pq}</annotation></semantics></math> is a <math id="S6.SS2.SSS1.p3.m2" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math>-equivariant topological submersion. Consider a point <math id="S6.SS2.SSS1.p3.m3" class="ltx_Math" alttext="x\in V_{pq}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">x\in V_{pq}</annotation></semantics></math> represented by <math id="S6.SS2.SSS1.p3.m4" class="ltx_Math" alttext="(u,\Sigma,F,0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>F</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u,\Sigma,F,0)</annotation></semantics></math>. Using the sheared almost complex structure and Gromov’s graph trick, we can view <math id="S6.SS2.SSS1.p3.m5" class="ltx_Math" alttext="(u,\Sigma,F,\eta_{1},\dots,\eta_{d})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>F</mi><mo>,</mo><msub><mi>η</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>η</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u,\Sigma,F,\eta_{1},\dots,\eta_{d})</annotation></semantics></math> as a pseudo-holomorphic stable cylinder contained in the <math id="S6.SS2.SSS1.p3.m6" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>-section of <math id="S6.SS2.SSS1.p3.m7" class="ltx_Math" alttext="{\mathcal{E}}_{d}\to M\times{\mathcal{C}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>d</mi></msub><mo stretchy="false">→</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{E}}_{d}\to M\times{\mathcal{C}}</annotation></semantics></math>. Recall that the framing <math id="S6.SS2.SSS1.p3.m8" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> defines a holomorphic map <math id="S6.SS2.SSS1.p3.m9" class="ltx_Math" alttext="\iota_{F}:\Sigma\to\mathbb{CP}^{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ι</mi><mi>F</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\iota_{F}:\Sigma\to\mathbb{CP}^{d}</annotation></semantics></math> of degree <math id="S6.SS2.SSS1.p3.m10" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>. Let us choose <math id="S6.SS2.SSS1.p3.m11" class="ltx_Math" alttext="d^{\prime}=(d+2)d" display="inline" intent=":literal"><semantics><mrow><msup><mi>d</mi><mo>′</mo></msup><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><annotation encoding="application/x-tex">d^{\prime}=(d+2)d</annotation></semantics></math> generic hyperplanes <math id="S6.SS2.SSS1.p3.m12" class="ltx_Math" alttext="H_{1},\ldots,H_{d^{\prime}}\subset\mathbb{CP}^{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>H</mi><msup><mi>d</mi><mo>′</mo></msup></msub><mo>⊂</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">H_{1},\ldots,H_{d^{\prime}}\subset\mathbb{CP}^{d}</annotation></semantics></math> which intersect the image of <math id="S6.SS2.SSS1.p3.m13" class="ltx_Math" alttext="\underline{\smash{\mu}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>μ</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{\mu}}</annotation></semantics></math> transversely at points different from nodes and markings, and choose</span></p>
<table id="S6.Ex26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex26.m1" class="ltx_math_unparsed" alttext="z_{i}\in v(\Sigma)\cap H_{i},\ i=1,\ldots,d^{\prime}." display="block" intent=":literal"><semantics><mrow><msub><mi>z</mi><mi>i</mi></msub><mo>∈</mo><mi>v</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo stretchy="false">)</mo></mrow><mo>∩</mo><msub><mi>H</mi><mi>i</mi></msub><mo rspace="0.667em">,</mo><mi>i</mi><mo>=</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>d</mi><mo>′</mo></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">z_{i}\in v(\Sigma)\cap H_{i},\ i=1,\ldots,d^{\prime}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.SSS1.p3.2" class="ltx_p"><span id="S6.SS2.SSS1.p3.2.1" class="ltx_text">Then the map <math id="S6.SS2.SSS1.p3.m14" class="ltx_Math" alttext="[v]\mapsto(z_{1},\ldots,z_{d^{\prime}})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mi>v</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">↦</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>z</mi><msup><mi>d</mi><mo>′</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">[v]\mapsto(z_{1},\ldots,z_{d^{\prime}})</annotation></semantics></math> is a local diffeomorphism from <math id="S6.SS2.SSS1.p3.m15" class="ltx_math_unparsed" alttext="{\mathcal{F}}{}_{0,2}^{\mathbb{R}}(d)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mi>ℝ</mi><mprescripts></mprescripts><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">{\mathcal{F}}{}_{0,2}^{\mathbb{R}}(d)</annotation></semantics></math> to an open subset <math id="S6.SS2.SSS1.p3.m16" class="ltx_math_unparsed" alttext="j:U\subset\overline{\mathcal{M}}{}_{0,2+d^{\prime}}^{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>U</mi><mo>⊂</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mn>0</mn><mo>,</mo><mrow><mn>2</mn><mo>+</mo><msup><mi>d</mi><mo>′</mo></msup></mrow></mrow></msub><msup><mrow></mrow><mi>ℝ</mi></msup></mrow><annotation encoding="application/x-tex">j:U\subset\overline{\mathcal{M}}{}_{0,2+d^{\prime}}^{\mathbb{R}}</annotation></semantics></math>. These intersection points play the role as local stabilizing divisors. Namely, we choose the preimage of the divisors <math id="S6.SS2.SSS1.p3.m17" class="ltx_Math" alttext="H_{1},\dots,H_{d^{\prime}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>H</mi><msup><mi>d</mi><mo>′</mo></msup></msub></mrow><annotation encoding="application/x-tex">H_{1},\dots,H_{d^{\prime}}</annotation></semantics></math> under the projection map <math id="S6.SS2.SSS1.p3.m18" class="ltx_Math" alttext="{\mathcal{E}}_{d}\to M\times{\mathcal{C}}\to{\mathcal{C}}\to{\mathbb{C}P}^{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>d</mi></msub><mo stretchy="false">→</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><mo stretchy="false">→</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo stretchy="false">→</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mi>d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{E}}_{d}\to M\times{\mathcal{C}}\to{\mathcal{C}}\to{\mathbb{C}P}^{d}</annotation></semantics></math> to be the local stabilizing divisors. By keeping track of the positions of the marked points obtained from intersecting the framing map with these divisors, we obtain map</span></p>
<table id="S6.Ex27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex27.m1" class="ltx_math_unparsed" alttext="\mu_{H}:V_{pq}\to\overline{\mathcal{M}}{}_{0,2+d^{\prime}}^{\mathbb{R}}" display="block" intent=":literal"><semantics><mrow><mi>μ</mi><msub><mrow></mrow><mi>H</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">→</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mn>0</mn><mo>,</mo><mrow><mn>2</mn><mo>+</mo><msup><mi>d</mi><mo>′</mo></msup></mrow></mrow></msub><msup><mrow></mrow><mi>ℝ</mi></msup></mrow><annotation encoding="application/x-tex">\mu_{H}:V_{pq}\to\overline{\mathcal{M}}{}_{0,2+d^{\prime}}^{\mathbb{R}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.SSS1.p3.3" class="ltx_p"><span id="S6.SS2.SSS1.p3.3.1" class="ltx_text">defined over a neighborhood of <math id="S6.SS2.SSS1.p3.m19" class="ltx_Math" alttext="x\in V_{pq}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">x\in V_{pq}</annotation></semantics></math>.</span></p>
</div>
<div id="S6.SS2.SSS1.p4" class="ltx_para">
<p id="S6.SS2.SSS1.p4.1" class="ltx_p"><span id="S6.SS2.SSS1.p4.1.1" class="ltx_text">Let <math id="S6.SS2.SSS1.p4.m1" class="ltx_Math" alttext="K_{\rm map}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>map</mi></msub><annotation encoding="application/x-tex">K_{\rm map}</annotation></semantics></math> be the kernel of the linearized Cauchy–Riemann operator at <math id="S6.SS2.SSS1.p4.m2" class="ltx_Math" alttext="(u,\iota_{F},0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><msub><mi>ι</mi><mi>F</mi></msub><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u,\iota_{F},0)</annotation></semantics></math> (without deforming the underlying map to <math id="S6.SS2.SSS1.p4.m3" class="ltx_Math" alttext="\mathbb{CP}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathbb{CP}^{d}</annotation></semantics></math>). The gluing map</span></p>
<table id="S6.Ex28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex28.m1" class="ltx_Math" alttext="g:U\times K\to V_{pq}" display="block" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>U</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>K</mi></mrow><mo stretchy="false">→</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">g:U\times K\to V_{pq}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.SSS1.p4.2" class="ltx_p"><span id="S6.SS2.SSS1.p4.2.1" class="ltx_text">defined by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx33" title="" class="ltx_ref">Par16</a>, Equation (C.10.3)]</cite> fit into the following diagram:</span></p>
