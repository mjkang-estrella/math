218066223828615 L 81.0292582962545 -46.664594663728465" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 81.0292582962545 -47.218066223828615 L 81.0292582962545 -46.664594663728465" fill="none" stroke="#000000"></path> <g transform="translate(81.03,0) translate(0,-46.94) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:4.8em;--ltx-fo-height:0.94em;--ltx-fo-depth:0.29em;font-size:10pt;" height="17" overflow="visible" transform="matrix(1 0 0 -1 0 13.04)" width="66.38"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mrow><msup><mo>∂</mo><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msup><msubsup><mi>𝔸</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>hmtp</mi></msubsup></mrow></span></span></foreignObject> </g> </g> </svg> </mtext><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\vbox{\lx@xy@svg{\hbox{\raise 0.0pt\hbox{\kern 34.55984pt\hbox{\ignorespaces\ignorespaces\ignorespaces\hbox{\vtop{\halign{\entry@#!@&amp;&amp;\entry@@#!@\cr&amp;\cr&amp;\crcr}}}\ignorespaces{\hbox{\kern-32.05984pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\overline{\mathcal{M}}{}_{xy^{\prime}}^{\rm hmtp}\times\overline{\mathcal{M}}{}_{y^{\prime}y}^{\rm Morse}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 59.80984pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 0.0pt\raise-24.93448pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 59.80984pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\partial^{xy^{\prime}y}\overline{\mathcal{M}}{}_{xy}^{\rm hmtp}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 85.54721pt\raise-23.99998pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern-34.55984pt\raise-33.9245pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{{\mathbb{A}}_{xy^{\prime}}^{\rm hmtp}\times{\mathbb{A}}_{y^{\prime}y}^{\rm Morse}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 58.55984pt\raise-33.9245pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 58.55984pt\raise-33.9245pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\partial^{xy^{\prime}y}{\mathbb{A}}_{xy}^{\rm hmtp}}$}}}}}}}\ignorespaces}}}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.15)</span></td></tr></tbody>
</table>
</div></li>
</ol>
<p id="S4.SS6.SSS1.p2.2" class="ltx_p">The above maps satisfy a list of obvious associativity properties, which we do not describe explicitly here.</p>
</div>
</section>
<section id="S4.SS6.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">4.6.2. </span>Outer collaring</h4>

<div id="S4.SS6.SSS2.p1" class="ltx_para">
<p id="S4.SS6.SSS2.p1.1" class="ltx_p">We can also apply the general outer-collaring construction on the homotopy moduli spaces so that it naturally extends the outer-collaring of the Floer, Morse, PSS, and SPP moduli spaces. The same type of structure maps as listed in (<a href="#S4.E12" title="In item 1 ‣ 4.6.1. Stratifications on homotopy moduli spaces ‣ 4.6. The homotopy ‣ 4. Proof of the integral Arnold conjecture ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.12</span></a>)—(<a href="#S4.E15" title="In item 4 ‣ 4.6.1. Stratifications on homotopy moduli spaces ‣ 4.6. The homotopy ‣ 4. Proof of the integral Arnold conjecture ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.15</span></a>) are still present and satisfy the same associativity properties.</p>
</div>
</section>
<section id="S4.SS6.SSS3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">4.6.3. </span>Derived orbifold lift</h4>

<div id="S4.Thmthm12" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm12.2" class="ltx_text ltx_font_bold">Definition 4.12</span></span><span id="S4.Thmthm12.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm12.p1" class="ltx_para">
<p id="S4.Thmthm12.p1.1" class="ltx_p">Assume the following objects are given.</p>
<ol id="S4.I6" class="ltx_enumerate">
<li id="S4.I6.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I6.i1.p1" class="ltx_para">
<p id="S4.I6.i1.p1.1" class="ltx_p">A derived orbifold lift <math id="S4.I6.i1.p1.m1" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm Floer}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>Floer</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm Floer}</annotation></semantics></math> of the outer-collared Hamiltonian Floer flow category <math id="S4.I6.i1.p1.m2" class="ltx_Math" alttext="(T^{\rm Floer})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mi>Floer</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(T^{\rm Floer})^{+}</annotation></semantics></math>. (Remember there is also the trivial derived orbifold lift <math id="S4.I6.i1.p1.m3" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm Morse}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>Morse</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm Morse}</annotation></semantics></math> of the outer-collared Morse flow category <math id="S4.I6.i1.p1.m4" class="ltx_Math" alttext="(T^{\rm Morse})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mi>Morse</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(T^{\rm Morse})^{+}</annotation></semantics></math>).</p>
</div></li>
<li id="S4.I6.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I6.i2.p1" class="ltx_para">
<p id="S4.I6.i2.p1.1" class="ltx_p">A derived orbifold lift <math id="S4.I6.i2.p1.m1" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm PSS}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>PSS</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm PSS}</annotation></semantics></math> resp. <math id="S4.I6.i2.p1.m2" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm SSP}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>SSP</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm SSP}</annotation></semantics></math> of the outer-collared PSS resp. SSP bimodule which extends <math id="S4.I6.i2.p1.m3" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm Floer}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>Floer</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm Floer}</annotation></semantics></math> and <math id="S4.I6.i2.p1.m4" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm Morse}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>Morse</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm Morse}</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I6.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S4.I6.i3.p1" class="ltx_para">
<p id="S4.I6.i3.p1.1" class="ltx_p">A derived orbifold lift <math id="S4.I6.i3.p1.m1" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm pearl}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>pearl</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm pearl}</annotation></semantics></math> of the outer-collared pearly bimodule <math id="S4.I6.i3.p1.m2" class="ltx_Math" alttext="(M^{\rm pearl})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msup><mi>M</mi><mi>pearl</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(M^{\rm pearl})^{+}</annotation></semantics></math>.</p>
</div></li>
</ol>
<p id="S4.Thmthm12.p1.2" class="ltx_p">Then a <span id="S4.Thmthm12.p1.2.1" class="ltx_text ltx_font_bold">derived orbifold lift</span> of the system of the outer-collared homotopy moduli spaces <math id="S4.Thmthm12.p1.m1" class="ltx_math_unparsed" alttext="(\overline{\mathcal{M}}{}_{xy}^{\rm hmtp})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mo stretchy="false">)</mo><mrow></mrow><mi>hmtp</mi><mprescripts></mprescripts><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mrow></mrow></mmultiscripts></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(\overline{\mathcal{M}}{}_{xy}^{\rm hmtp})^{+}</annotation></semantics></math> consists of the following objects.</p>
<ol id="S4.I7" class="ltx_enumerate">
<li id="S4.I7.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I7.i1.p1" class="ltx_para">
<p id="S4.I7.i1.p1.1" class="ltx_p">For each <math id="S4.I7.i1.p1.m1" class="ltx_Math" alttext="x,y" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow><annotation encoding="application/x-tex">x,y</annotation></semantics></math>, an <math id="S4.I7.i1.p1.m2" class="ltx_Math" alttext="{\mathbb{A}}_{xy}^{\rm hmtp}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔸</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>hmtp</mi></msubsup><annotation encoding="application/x-tex">{\mathbb{A}}_{xy}^{\rm hmtp}</annotation></semantics></math>-stratified derived orbifold chart <math id="S4.I7.i1.p1.m3" class="ltx_Math" alttext="C_{xy}^{\rm hmtp}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>hmtp</mi></msubsup><annotation encoding="application/x-tex">C_{xy}^{\rm hmtp}</annotation></semantics></math> of <math id="S4.I7.i1.p1.m4" class="ltx_math_unparsed" alttext="(\overline{\mathcal{M}}{}_{xy}^{\rm hmtp})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mo stretchy="false">)</mo><mrow></mrow><mi>hmtp</mi><mprescripts></mprescripts><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mrow></mrow></mmultiscripts></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(\overline{\mathcal{M}}{}_{xy}^{\rm hmtp})^{+}</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I7.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I7.i2.p1" class="ltx_para">
<p id="S4.I7.i2.p1.1" class="ltx_p">Stratified chart embeddings</p>
<table id="S4.E16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
