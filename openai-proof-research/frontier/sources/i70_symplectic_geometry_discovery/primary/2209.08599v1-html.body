383105456" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -34.30119619109546 L 0.27673578005007266 -34.30119619109546" fill="none" stroke="#000000"></path> <g transform="translate(66.07,0) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:1.66em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.29em;font-size:10pt;" height="13.41" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="22.96"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></span></span></foreignObject> </g> <path style="--ltx-stroke-color:#000000;" d="M 81.4247368875506 -11.569253138458645 L 81.97820844765074 -11.569253138458645" fill="none" stroke="#000000"></path> <g transform="translate(81.7,0) translate(0,-22.22) translate(4.15,0) translate(0,-1.14)"> <foreignObject style="--ltx-fo-width:1.13em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.14em;font-size:10pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="15.62"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><msub><mi mathsize="0.700em">μ</mi><mi mathsize="0.710em">H</mi></msub></span></span></foreignObject> </g> <g transform="translate(81.7,0) translate(0,-32.12)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M 81.4247368875506 -32.11640447308055 L 81.97820844765074 -11.569253138458645" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 81.4247368875506 -32.11640447308055 L 81.97820844765074 -32.11640447308055" fill="none" stroke="#000000"></path> <g transform="translate(-9.63,0) translate(0,-44.45) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:0.79em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="10.96"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mi>U</mi></span></span></foreignObject> </g> <path style="--ltx-stroke-color:#000000;" d="M 9.629189003152241 -44.72503725450135 L 9.629189003152241 -44.1715656944012" fill="none" stroke="#000000"></path> <g transform="translate(34.13,0) translate(0,-52.75) translate(4.15,0) translate(0,-2.26)"> <foreignObject style="--ltx-fo-width:0.37em;--ltx-fo-height:0.46em;--ltx-fo-depth:0.14em;font-size:10pt;" height="8.29" overflow="visible" transform="matrix(1 0 0 -1 0 6.41)" width="5.14"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mi mathsize="0.700em">j</mi></span></span></foreignObject> </g> <g transform="translate(57.67,0) translate(0,-44.45)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M 9.629189003152241 -44.72503725450135 L 57.66464662004246 -44.1715656944012" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 57.66464662004246 -44.72503725450135 L 57.66464662004246 -44.1715656944012" fill="none" stroke="#000000"></path> <g transform="translate(57.67,0) translate(0,-44.45) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:2.87em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.37em;font-size:10pt;" height="16.78" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="39.77"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mn>0</mn><mo>,</mo><mrow><mn>2</mn><mo>+</mo><msup><mi>d</mi><mo>′</mo></msup></mrow></mrow></msub><msup><mrow></mrow><mi>ℝ</mi></msup></mrow></span></span></foreignObject> </g> </g> </svg> </mtext><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\vbox{\lx@xy@svg{\hbox{\raise 0.0pt\hbox{\kern 19.3063pt\hbox{\ignorespaces\ignorespaces\ignorespaces\hbox{\vtop{\halign{\entry@#!@&amp;&amp;\entry@@#!@\cr&amp;\cr&amp;\crcr}}}\ignorespaces{\hbox{\kern-17.67424pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{U\times K\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 24.44661pt\raise 5.1875pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-0.8264pt\hbox{$\scriptstyle{g}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 47.74854pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern-19.3063pt\raise-16.06139pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-0.8264pt\hbox{$\scriptstyle{{\rm pr}_{U}}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 0.0pt\raise-24.78947pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 47.74854pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{V_{pq}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 59.04565pt\raise-16.06139pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-0.8264pt\hbox{$\scriptstyle{\mu_{H}}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 59.04565pt\raise-23.21053pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern-6.95901pt\raise-32.12279pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{U\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 24.66605pt\raise-38.1193pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-1.63542pt\hbox{$\scriptstyle{j}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 41.67424pt\raise-32.12279pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 41.67424pt\raise-32.12279pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\overline{\mathcal{M}}{}_{0,2+d^{\prime}}^{\mathbb{R}}}$}}}}}}}\ignorespaces}}}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.SSS1.p4.3" class="ltx_p"><span id="S6.SS2.SSS1.p4.3.1" class="ltx_text">According to <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx33" title="" class="ltx_ref">Par16</a>, Section C.12]</cite>, <math id="S6.SS2.SSS1.p4.m4" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> is a homeomorphism onto its image. The commutativity of the above diagram follows from the definition <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx33" title="" class="ltx_ref">Par16</a>, Equation (C.10.4)]</cite>. Furthermore, the restriction of the gluing map <math id="S6.SS2.SSS1.p4.m5" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> to a fiber <math id="S6.SS2.SSS1.p4.m6" class="ltx_Math" alttext="\{a\}\times K" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><mi>a</mi><mo rspace="0.055em" stretchy="false">}</mo></mrow><mo rspace="0.222em">×</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">\{a\}\times K</annotation></semantics></math> is smooth, see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx33" title="" class="ltx_ref">Par16</a>, Section C.9]</cite> (this has already been explored in Section <a href="#S5" title="5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>). Note that the topological submersion property holds over a <math id="S6.SS2.SSS1.p4.m7" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math>-invariant open neighborhood of <math id="S6.SS2.SSS1.p4.m8" class="ltx_Math" alttext="S_{pq}^{-1}(0)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>S</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">S_{pq}^{-1}(0)</annotation></semantics></math> in <math id="S6.SS2.SSS1.p4.m9" class="ltx_Math" alttext="V_{pq}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">V_{pq}</annotation></semantics></math> by the transversality assumption. Up to restricting to such an open subset, we see that <math id="S6.SS2.SSS1.p4.m10" class="ltx_Math" alttext="\pi_{pq}:V_{pq}\to B_{pq}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi>B</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\pi_{pq}:V_{pq}\to B_{pq}</annotation></semantics></math> is indeed a <math id="S6.SS2.SSS1.p4.m11" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math>-equivariant topological submersion.</span></p>
</div>
<div id="S6.SS2.SSS1.p5" class="ltx_para">
<p id="S6.SS2.SSS1.p5.1" class="ltx_p"><span id="S6.SS2.SSS1.p5.1.1" class="ltx_text">It remains to see that <math id="S6.SS2.SSS1.p5.m1" class="ltx_Math" alttext="\pi_{pq}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\pi_{pq}</annotation></semantics></math> actually has a <math id="S6.SS2.SSS1.p5.m2" class="ltx_Math" alttext="C^{1}_{\rm loc}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi>loc</mi><mn>1</mn></msubsup><annotation encoding="application/x-tex">C^{1}_{\rm loc}</annotation></semantics></math> <math id="S6.SS2.SSS1.p5.m3" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math>-bundle structure. Note that the gluing construction of <math id="S6.SS2.SSS1.p5.m4" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math>-holomorphic curves is based on applying a Newton–Picard iteration scheme to a pre-glued curve. By <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx33" title="" class="ltx_ref">Par16</a>, Proposition B.11.1, C.11.1]</cite>, the <math id="S6.SS2.SSS1.p5.m5" class="ltx_Math" alttext="L^{2}" display="inline" intent=":literal"><semantics><msup><mi>L</mi><mn>2</mn></msup><annotation encoding="application/x-tex">L^{2}</annotation></semantics></math>-norm of the honest solution near the ends of the neck region controls all <math id="S6.SS2.SSS1.p5.m6" class="ltx_Math" alttext="C^{k}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi>k</mi></msup><annotation encoding="application/x-tex">C^{k}</annotation></semantics></math>-norms through the region. With this in mind, the rest of the argument follows from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>, Corollary 6.29]</cite>.
∎</span></p>
</div>
</div>
<div id="S6.SS2.SSS1.p6" class="ltx_para">
<p id="S6.SS2.SSS1.p6.1" class="ltx_p">As a consequence, we see that the tangent microbundle of the interior of <math id="S6.SS2.SSS1.p6.m1" class="ltx_Math" alttext="V_{pq}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">V_{pq}</annotation></semantics></math> admits a vector bundle lift by (<a href="#S6.E3" title="In 6.1.4. Fiberwise submersions ‣ 6.1. Preliminaries ‣ 6. Smoothing ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.3</span></a>) and Lemma <a href="#S6.Thmthm21" title="Lemma 6.21. ‣ 6.1.4. Fiberwise submersions ‣ 6.1. Preliminaries ‣ 6. Smoothing ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.21</span></a>. This suffices for us to construct a <math id="S6.SS2.SSS1.p6.m2" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math>-equivariant smoothing on the interior of <math id="S6.SS2.SSS1.p6.m3" class="ltx_Math" alttext="V_{pq}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">V_{pq}</annotation></semantics></math>, but it falls short of providing a smoothing of <math id="S6.SS2.SSS1.p6.m4" class="ltx_Math" alttext="V_{pq}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">V_{pq}</annotation></semantics></math> as a manifold with corners. This problem will be solved on the outer-collaring <math id="S6.SS2.SSS1.p6.m5" class="ltx_Math" alttext="V_{pq}^{+}" display="inline" intent=":literal"><semantics><msubsup><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>+</mo></msubsup><annotation encoding="application/x-tex">V_{pq}^{+}</annotation></semantics></math> by performing an inductive argument.</p>
</div>
</section>
<section id="S6.SS2.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">6.2.2. </span>Vertical stable complex structures</h4>

<div id="S6.SS2.SSS2.p1" class="ltx_para">
<p id="S6.SS2.SSS2.p1.1" class="ltx_p">Following <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx1" title="" class="ltx_ref">AB21</a>, Section 11]</cite>, we describe how to construct a stabilization of the vertical tangent bundle <math id="S6.SS2.SSS2.p1.m1" class="ltx_Math" alttext="T^{\rm vt}V_{pq}" display="inline" intent=":literal"><semantics><mrow><msup><mi>T</mi><mi>vt</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">T^{\rm vt}V_{pq}</annotation></semantics></math> of the <math id="S6.SS2.SSS2.p1.m2" class="ltx_Math" alttext="C^{1}_{\rm loc}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi>loc</mi><mn>1</mn></msubsup><annotation encoding="application/x-tex">C^{1}_{\rm loc}</annotation></semantics></math> <math id="S6.SS2.SSS2.p1.m3" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math>-bundle <math id="S6.SS2.SSS2.p1.m4" class="ltx_Math" alttext="\pi_{pq}:V_{pq}\to B_{pq}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi>B</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\pi_{pq}:V_{pq}\to B_{pq}</annotation></semantics></math> such that the resulting vector bundle admits a complex structure. We also explain how to use these stable complex structures to construct normal complex structures on derived orbifold charts.</p>
</div>
<div id="S6.SS2.SSS2.p2" class="ltx_para">
<p id="S6.SS2.SSS2.p2.1" class="ltx_p">For any <math id="S6.SS2.SSS2.p2.m1" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>-periodic orbit <math id="S6.SS2.SSS2.p2.m2" class="ltx_Math" alttext="\underline{\smash{p}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{p}}</annotation></semantics></math> of <math id="S6.SS2.SSS2.p2.m3" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>, fix a unitary trivialization of the complex vector bundle <math id="S6.SS2.SSS2.p2.m4" class="ltx_Math" alttext="\underline{\smash{p}}^{*}TM\to S^{1}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">→</mo><msup><mi>S</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">\underline{\smash{p}}^{*}TM\to S^{1}</annotation></semantics></math>. Moreover, we choose a complex linear connection <math id="S6.SS2.SSS2.p2.m5" class="ltx_Math" alttext="\nabla" display="inline" intent=":literal"><semantics><mo>∇</mo><annotation encoding="application/x-tex">\nabla</annotation></semantics></math> defined on the pullback of <math id="S6.SS2.SSS2.p2.m6" class="ltx_Math" alttext="TM" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">TM</annotation></semantics></math> under the projection map <math id="S6.SS2.SSS2.p2.m7" class="ltx_Math" alttext="S^{1}\times M\to M" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>S</mi><mn>1</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi></mrow><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">S^{1}\times M\to M</annotation></semantics></math>, such that its restriction to the graph of any <math id="S6.SS2.SSS2.p2.m8" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>-periodic orbit is induced by the chosen trivializations. For a <math id="S6.SS2.SSS2.p2.m9" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>-periodic orbit <math id="S6.SS2.SSS2.p2.m10" class="ltx_Math" alttext="\underline{\smash{p}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{p}}</annotation></semantics></math>, using the projection <math id="S6.SS2.SSS2.p2.m11" class="ltx_Math" alttext="{\rm pr}_{S^{1}}:{\mathbb{R}}\times S^{1}\to S^{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>pr</mi><msup><mi>S</mi><mn>1</mn></msup></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>ℝ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>S</mi><mn>1</mn></msup></mrow><mo stretchy="false">→</mo><msup><mi>S</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">{\rm pr}_{S^{1}}:{\mathbb{R}}\times S^{1}\to S^{1}</annotation></semantics></math>, we consider the complex vector bundle</p>
<table id="S6.Ex30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex30.m1" class="ltx_Math" alttext="(\underline{\smash{p}}\circ{\rm pr}_{S^{1}})^{*}TM\to{\mathbb{R}}\times S^{1}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>pr</mi><msup><mi>S</mi><mn>1</mn></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">→</mo><mrow><mi>ℝ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>S</mi><mn>1</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(\underline{\smash{p}}\circ{\rm pr}_{S^{1}})^{*}TM\to{\mathbb{R}}\times S^{1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.SSS2.p2.2" class="ltx_p">Denote by <math id="S6.SS2.SSS2.p2.m12" class="ltx_Math" alttext="B_{H,\underline{\smash{p}}}(t):S^{1}\to\text{End}(\underline{\smash{p}}^{*}TM)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>B</mi><mrow><mi>H</mi><mo>,</mo><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><msup><mi>S</mi><mn>1</mn></msup><mo stretchy="false">→</mo><mrow><mtext>End</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">B_{H,\underline{\smash{p}}}(t):S^{1}\to\text{End}(\underline{\smash{p}}^{*}TM)</annotation></semantics></math> the section obtained by differentiating the flow of <math id="S6.SS2.SSS2.p2.m13" class="ltx_Math" alttext="X_{H_{t}}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><msub><mi>H</mi><mi>t</mi></msub></msub><annotation encoding="application/x-tex">X_{H_{t}}</annotation></semantics></math>, i.e.,</p>
<table id="S6.Ex31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex31.m1" class="ltx_Math" alttext="B_{H,\underline{\smash{p}}}(t)(W)=\nabla_{W}X_{H_{t}},\ \forall W\in T_{\underline{\smash{p}}(t)}M." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>B</mi><mrow><mi>H</mi><mo>,</mo><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>W</mi></msub><msub><mi>X</mi><msub><mi>H</mi><mi>t</mi></msub></msub></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>W</mi></mrow><mo>∈</mo><mrow><msub><mi>T</mi><mrow><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">B_{H,\underline{\smash{p}}}(t)(W)=\nabla_{W}X_{H_{t}},\ \forall W\in T_{\underline{\smash{p}}(t)}M.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.SSS2.p2.3" class="ltx_p">Using a smooth cut-off function, we can consider the Cauchy–Riemann operator</p>
<table id="S6.Ex32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex32.m1" class="ltx_Math" alttext="\nabla^{0,1}_{\underline{\smash{p}}}:\Omega^{0}((\underline{\smash{p}}\circ{\rm pr}_{S^{1}})^{*}TM)\to\Omega^{0,1}((\underline{\smash{p}}\circ{\rm pr}_{S^{1}})^{*}TM)" display="block" intent=":literal"><semantics><mrow><msubsup><mo>∇</mo><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi mathvariant="normal">Ω</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>pr</mi><msup><mi>S</mi><mn>1</mn></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi mathvariant="normal">Ω</mi><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>pr</mi><msup><mi>S</mi><mn>1</mn></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\nabla^{0,1}_{\underline{\smash{p}}}:\Omega^{0}((\underline{\smash{p}}\circ{\rm pr}_{S^{1}})^{*}TM)\to\Omega^{0,1}((\underline{\smash{p}}\circ{\rm pr}_{S^{1}})^{*}TM)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.SSS2.p2.4" class="ltx_p">such that</p>
<table id="S6.Ex33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex33.m1" class="ltx_Math" alttext="\nabla^{0,1}_{\underline{\smash{p}}}=\left\{\begin{array}[]{rr}(\nabla-B_{H,\underline{\smash{p}}}\otimes dt)_{J}^{0,1}\text{ near }-\infty\\
\nabla^{0,1}\text{ near }+\infty.\end{array}\right." display="block" intent=":literal"><semantics><mrow><msubsup><mo>∇</mo><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msubsup><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><msubsup><mrow><mo stretchy="false">(</mo><mrow><mo>∇</mo><mo lspace="0em">−</mo><mrow><mrow><msub><mi>B</mi><mrow><mi>H</mi><mo>,</mo><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder></mrow></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>J</mi><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mtext> near </mtext></mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mtd><mtd></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mrow><msup><mo>∇</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msup><mtext> near </mtext></mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow><mo lspace="0em">.</mo></mrow></mtd><mtd></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">\nabla^{0,1}_{\underline{\smash{p}}}=\left\{\begin{array}[]{rr}(\nabla-B_{H,\underline{\smash{p}}}\otimes dt)_{J}^{0,1}\text{ near }-\infty\\
\nabla^{0,1}\text{ near }+\infty.\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.SSS2.p2.5" class="ltx_p">It is a standard fact that <math id="S6.SS2.SSS2.p2.m14" class="ltx_Math" alttext="\nabla^{0,1}_{\underline{\smash{p}}}" display="inline" intent=":literal"><semantics><msubsup><mo>∇</mo><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msubsup><annotation encoding="application/x-tex">\nabla^{0,1}_{\underline{\smash{p}}}</annotation></semantics></math> defines an elliptic operator. Therefore, we can find a finite dimensional <span id="S6.SS2.SSS2.p2.5.1" class="ltx_text ltx_font_bold">complex</span> vector space <math id="S6.SS2.SSS2.p2.m15" class="ltx_Math" alttext="V_{\underline{\smash{p}}}^{-}" display="inline" intent=":literal"><semantics><msubsup><mi>V</mi><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo>−</mo></msubsup><annotation encoding="application/x-tex">V_{\underline{\smash{p}}}^{-}</annotation></semantics></math> and a linear map <math id="S6.SS2.SSS2.p2.m16" class="ltx_Math" alttext="\lambda_{\underline{\smash{p}}}:V_{\underline{\smash{p}}}^{-}\to\Omega^{0,1}((\underline{\smash{p}}\circ{\rm pr}_{S^{1}})^{*}TM)" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>V</mi><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo>−</mo></msubsup><mo stretchy="false">→</mo><mrow><msup><mi mathvariant="normal">Ω</mi><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>pr</mi><msup><mi>S</mi><mn>1</mn></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{\underline{\smash{p}}}:V_{\underline{\smash{p}}}^{-}\to\Omega^{0,1}((\underline{\smash{p}}\circ{\rm pr}_{S^{1}})^{*}TM)</annotation></semantics></math> such that the map</p>
<table id="S6.Ex34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex34.m1" class="ltx_Math" alttext="\nabla^{0,1}_{\underline{\smash{p}}}\oplus\lambda_{\underline{\smash{p}}}:\Omega^{0}((\underline{\smash{p}}\circ{\rm pr}_{S^{1}})^{*}TM)\oplus V_{\underline{\smash{p}}}^{-}\to\Omega^{0,1}((\underline{\smash{p}}\circ{\rm pr}_{S^{1}})^{*}TM)" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∇</mo><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msubsup><mo lspace="0em">⊕</mo><msub><mi>λ</mi><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><msup><mi mathvariant="normal">Ω</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>pr</mi><msup><mi>S</mi><mn>1</mn></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><msubsup><mi>V</mi><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo>−</mo></msubsup></mrow><mo stretchy="false">→</mo><mrow><msup><mi mathvariant="normal">Ω</mi><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>pr</mi><msup><mi>S</mi><mn>1</mn></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\nabla^{0,1}_{\underline{\smash{p}}}\oplus\lambda_{\underline{\smash{p}}}:\Omega^{0}((\underline{\smash{p}}\circ{\rm pr}_{S^{1}})^{*}TM)\oplus V_{\underline{\smash{p}}}^{-}\to\Omega^{0,1}((\underline{\smash{p}}\circ{\rm pr}_{S^{1}})^{*}TM)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.SSS2.p2.6" class="ltx_p">is surjective. This map is called the asymptotic operator of <math id="S6.SS2.SSS2.p2.m17" class="ltx_Math" alttext="\underline{\smash{p}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{p}}</annotation></semantics></math>. We fix a choice of <math id="S6.SS2.SSS2.p2.m18" class="ltx_Math" alttext="V_{\underline{\smash{p}}}^{-}" display="inline" intent=":literal"><semantics><msubsup><mi>V</mi><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo>−</mo></msubsup><annotation encoding="application/x-tex">V_{\underline{\smash{p}}}^{-}</annotation></semantics></math> and <math id="S6.SS2.SSS2.p2.m19" class="ltx_Math" alttext="\lambda_{\underline{\smash{p}}}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder></msub><annotation encoding="application/x-tex">\lambda_{\underline{\smash{p}}}</annotation></semantics></math>, and denote the kernel of the above map by <math id="S6.SS2.SSS2.p2.m20" class="ltx_Math" alttext="V_{\underline{\smash{p}}}^{+}" display="inline" intent=":literal"><semantics><msubsup><mi>V</mi><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo>+</mo></msubsup><annotation encoding="application/x-tex">V_{\underline{\smash{p}}}^{+}</annotation></semantics></math>. The virtual vector space <math id="S6.SS2.SSS2.p2.m21" class="ltx_Math" alttext="(V_{\underline{\smash{p}}}^{+},V_{\underline{\smash{p}}}^{-})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msubsup><mi>V</mi><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo>+</mo></msubsup><mo>,</mo><msubsup><mi>V</mi><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo>−</mo></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(V_{\underline{\smash{p}}}^{+},V_{\underline{\smash{p}}}^{-})</annotation></semantics></math> will be used to construct a stable complex structure on <math id="S6.SS2.SSS2.p2.m22" class="ltx_Math" alttext="T^{\rm vt}V_{pq}" display="inline" intent=":literal"><semantics><mrow><msup><mi>T</mi><mi>vt</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">T^{\rm vt}V_{pq}</annotation></semantics></math>.</p>
</div>
<div id="S6.Thmthm23" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm23.2" class="ltx_text ltx_font_bold">Lemma 6.23</span></span><span id="S6.Thmthm23.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmthm23.p1" class="ltx_para">
<p id="S6.Thmthm23.p1.1" class="ltx_p"><span id="S6.Thmthm23.p1.1.1" class="ltx_text ltx_font_italic">For any <math id="S6.Thmthm23.p1.m1" class="ltx_Math" alttext="p,q\in T^{\rm Floer}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow><mo>∈</mo><msup><mi>T</mi><mi>Floer</mi></msup></mrow><annotation encoding="application/x-tex">p,q\in T^{\rm Floer}</annotation></semantics></math> such that <math id="S6.Thmthm23.p1.m2" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}^{\rm Floer}_{pq}\neq\emptyset" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msup><mrow></mrow><mi>Floer</mi></msup><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>≠</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}^{\rm Floer}_{pq}\neq\emptyset</annotation></semantics></math>, there exists a complex vector bundle <math id="S6.Thmthm23.p1.m3" class="ltx_Math" alttext="I^{\rm vt}_{pq}\to V_{pq}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>I</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>vt</mi></msubsup><mo stretchy="false">→</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">I^{\rm vt}_{pq}\to V_{pq}</annotation></semantics></math> such that there exists an homotopy between the vector bundles</span></p>
<table id="S6.E4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E4.m1" class="ltx_Math" alttext="V_{\underline{\smash{q}}}^{+}\oplus T^{\rm vt}V_{pq}\oplus V_{\underline{\smash{p}}}^{-}\cong V_{\underline{\smash{q}}}^{-}\oplus I^{\rm vt}_{pq}\oplus V_{\underline{\smash{p}}}^{+}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>V</mi><munder accentunder="true"><mi>q</mi><mo stretchy="true">¯</mo></munder><mo>+</mo></msubsup><mo>⊕</mo><mrow><msup><mi>T</mi><mi>vt</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo>⊕</mo><msubsup><mi>V</mi><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo>−</mo></msubsup></mrow><mo>≅</mo><mrow><msubsup><mi>V</mi><munder accentunder="true"><mi>q</mi><mo stretchy="true">¯</mo></munder><mo>−</mo></msubsup><mo>⊕</mo><msubsup><mi>I</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>vt</mi></msubsup><mo>⊕</mo><msubsup><mi>V</mi><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo>+</mo></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">V_{\underline{\smash{q}}}^{+}\oplus T^{\rm vt}V_{pq}\oplus V_{\underline{\smash{p}}}^{-}\cong V_{\underline{\smash{q}}}^{-}\oplus I^{\rm vt}_{pq}\oplus V_{\underline{\smash{p}}}^{+}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(6.4)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="S6.SS2.SSS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S6.SS2.SSS2.p3" class="ltx_para">
<p id="S6.SS2.SSS2.p3.1" class="ltx_p"><span id="S6.SS2.SSS2.p3.1.1" class="ltx_text">We explain the construction in the case of a single-layered thickening. The vertical tangent bundle of <math id="S6.SS2.SSS2.p3.m1" class="ltx_Math" alttext="V_{pq}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">V_{pq}</annotation></semantics></math> can be identified with the kernel of the linearized operator associated with (<a href="#S5.E24" title="In item 2 ‣ Definition 5.33 (Thickened moduli). ‣ 5.3.1. Description of the K-chart. ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.24</span></a>) with the framing <math id="S6.SS2.SSS2.p3.m2" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> being kept fixed. To be more precise, using the model as in the proof of Theorem <a href="#S5.Thmthm41" title="Theorem 5.41. ‣ 5.3.2. Transversality of the perturbed Floer equation ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.41</span></a>, given an element in <math id="S6.SS2.SSS2.p3.m3" class="ltx_Math" alttext="V_{pq}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">V_{pq}</annotation></semantics></math> with representative <math id="S6.SS2.SSS2.p3.m4" class="ltx_Math" alttext="(\Sigma,u,\mu,\eta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>μ</mi><mo>,</mo><mi>η</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Sigma,u,\mu,\eta)</annotation></semantics></math>, the deformation operator over each component <math id="S6.SS2.SSS2.p3.m5" class="ltx_Math" alttext="\Sigma_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>α</mi></msub><annotation encoding="application/x-tex">\Sigma_{\alpha}</annotation></semantics></math> is of the form</span></p>
<table id="S6.Ex35" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S6.Ex35X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.Ex35X.m2" class="ltx_Math" alttext="\displaystyle W^{1,p}(\Sigma_{\alpha},u^{*}TM)\oplus W^{1,p}(\Sigma_{\alpha},(u,\mu)^{*}E(k))\to L^{p}(\Lambda^{0,1}(\Sigma_{\alpha},u^{*}TM))\oplus L^{p}(\Lambda^{0,1}(\Sigma_{\alpha},u^{*}TM))" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>W</mi><mrow><mn>1</mn><mo>,</mo><mi>p</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>α</mi></msub><mo>,</mo><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mrow><msup><mi>W</mi><mrow><mn>1</mn><mo>,</mo><mi>p</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>α</mi></msub><mo>,</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">→</mo><mrow><mrow><msup><mi>L</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi mathvariant="normal">Λ</mi><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>α</mi></msub><mo>,</mo><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mrow><msup><mi>L</mi><mi>p</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi mathvariant="normal">Λ</mi><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><mi>α</mi></msub><mo>,</mo><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle W^{1,p}(\Sigma_{\alpha},u^{*}TM)\oplus W^{1,p}(\Sigma_{\alpha},(u,\mu)^{*}E(k))\to L^{p}(\Lambda^{0,1}(\Sigma_{\alpha},u^{*}TM))\oplus L^{p}(\Lambda^{0,1}(\Sigma_{\alpha},u^{*}TM))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.Ex35Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.Ex35Xa.m2" class="ltx_Math" alttext="\displaystyle(\xi,\eta^{\prime})\mapsto(D_{u}\xi+P(\eta^{\prime}),D_{E}\eta^{\prime})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mi>ξ</mi><mo>,</mo><msup><mi>η</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">↦</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>D</mi><mi>u</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>ξ</mi></mrow><mo>+</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>η</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><msub><mi>D</mi><mi>E</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle(\xi,\eta^{\prime})\mapsto(D_{u}\xi+P(\eta^{\prime}),D_{E}\eta^{\prime}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.SSS2.p3.2" class="ltx_p"><span id="S6.SS2.SSS2.p3.2.1" class="ltx_text">By taking the direct sum of these linear operators ranging over all the components of <math id="S6.SS2.SSS2.p3.m6" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math>, and impose the usual matching condition in the case of nodal curves, we indeed identify <math id="S6.SS2.SSS2.p3.m7" class="ltx_Math" alttext="T^{\rm vt}V_{pq}" display="inline" intent=":literal"><semantics><mrow><msup><mi>T</mi><mi>vt</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">T^{\rm vt}V_{pq}</annotation></semantics></math> over <math id="S6.SS2.SSS2.p3.m8" class="ltx_Math" alttext="(\Sigma,u,\mu,\eta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>μ</mi><mo>,</mo><mi>η</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Sigma,u,\mu,\eta)</annotation></semantics></math> with the kernel of a Fredholm operator which is schematically written as</span></p>
<table id="S6.Ex36" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex36.m1" class="ltx_Math" alttext="D^{\rm vt}_{u,\mu,\eta}:{\mathcal{E}}_{u,\mu,\eta}\to{\mathcal{F}}_{u,\mu,\eta}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>D</mi><mrow><mi>u</mi><mo>,</mo><mi>μ</mi><mo>,</mo><mi>η</mi></mrow><mi>vt</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>u</mi><mo>,</mo><mi>μ</mi><mo>,</mo><mi>η</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>u</mi><mo>,</mo><mi>μ</mi><mo>,</mo><mi>η</mi></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">D^{\rm vt}_{u,\mu,\eta}:{\mathcal{E}}_{u,\mu,\eta}\to{\mathcal{F}}_{u,\mu,\eta}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.SSS2.p3.3" class="ltx_p"><span id="S6.SS2.SSS2.p3.3.1" class="ltx_text">Now we consider the concatenation of the three operators <math id="S6.SS2.SSS2.p3.m9" class="ltx_Math" alttext="D^{\rm vt}_{u,\mu,\eta}\oplus\nabla^{0,1}_{\underline{\smash{q}}}\oplus\lambda_{\underline{\smash{q}}}\oplus 0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>D</mi><mrow><mi>u</mi><mo>,</mo><mi>μ</mi><mo>,</mo><mi>η</mi></mrow><mi>vt</mi></msubsup><mo>⊕</mo><msubsup><mo>∇</mo><munder accentunder="true"><mi>q</mi><mo stretchy="true">¯</mo></munder><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msubsup><mo lspace="0em">⊕</mo><msub><mi>λ</mi><munder accentunder="true"><mi>q</mi><mo stretchy="true">¯</mo></munder></msub><mo>⊕</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">D^{\rm vt}_{u,\mu,\eta}\oplus\nabla^{0,1}_{\underline{\smash{q}}}\oplus\lambda_{\underline{\smash{q}}}\oplus 0</annotation></semantics></math></span></p>
<table id="S6.Ex37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex37.m1" class="ltx_Math" alttext="{\mathcal{E}}_{u,\mu,\eta}\oplus(\Omega^{0}((\underline{\smash{q}}\circ{\rm pr}_{S^{1}})^{*}TM)\oplus V_{\underline{\smash{q}}}^{-})\oplus V_{\underline{\smash{p}}}^{-}\to{\mathcal{F}}_{u,\mu,\eta}\oplus\Omega^{0,1}((\underline{\smash{q}}\circ{\rm pr}_{S^{1}})^{*}TM)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>u</mi><mo>,</mo><mi>μ</mi><mo>,</mo><mi>η</mi></mrow></msub><mo>⊕</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi mathvariant="normal">Ω</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><munder accentunder="true"><mi>q</mi><mo stretchy="true">¯</mo></munder><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>pr</mi><msup><mi>S</mi><mn>1</mn></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><msubsup><mi>V</mi><munder accentunder="true"><mi>q</mi><mo stretchy="true">¯</mo></munder><mo>−</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo>⊕</mo><msubsup><mi>V</mi><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo>−</mo></msubsup></mrow><mo stretchy="false">→</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>u</mi><mo>,</mo><mi>μ</mi><mo>,</mo><mi>η</mi></mrow></msub><mo>⊕</mo><mrow><msup><mi mathvariant="normal">Ω</mi><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><munder accentunder="true"><mi>q</mi><mo stretchy="true">¯</mo></munder><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>pr</mi><msup><mi>S</mi><mn>1</mn></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{E}}_{u,\mu,\eta}\oplus(\Omega^{0}((\underline{\smash{q}}\circ{\rm pr}_{S^{1}})^{*}TM)\oplus V_{\underline{\smash{q}}}^{-})\oplus V_{\underline{\smash{p}}}^{-}\to{\mathcal{F}}_{u,\mu,\eta}\oplus\Omega^{0,1}((\underline{\smash{q}}\circ{\rm pr}_{S^{1}})^{*}TM).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.SSS2.p3.4" class="ltx_p"><span id="S6.SS2.SSS2.p3.4.1" class="ltx_text">This operator is Fredholm and surjective, with kernel identified with</span></p>
<table id="S6.Ex38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex38.m1" class="ltx_Math" alttext="T^{\rm vt}V_{pq}\oplus V^{+}_{\underline{\smash{q}}}\oplus V_{\underline{\smash{p}}}^{-}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>T</mi><mi>vt</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo>⊕</mo><msubsup><mi>V</mi><munder accentunder="true"><mi>q</mi><mo stretchy="true">¯</mo></munder><mo>+</mo></msubsup><mo>⊕</mo><msubsup><mi>V</mi><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo>−</mo></msubsup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">T^{\rm vt}V_{pq}\oplus V^{+}_{\underline{\smash{q}}}\oplus V_{\underline{\smash{p}}}^{-}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.SSS2.p3.5" class="ltx_p"><span id="S6.SS2.SSS2.p3.5.1" class="ltx_text">We will construct a homotopy of this operator following the proof of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx1" title="" class="ltx_ref">AB21</a>, Proposition 11.30]</cite>. To this end, introduce an auxialiary moduli space <math id="S6.SS2.SSS2.p3.m10" class="ltx_Math" alttext="\tilde{V}_{pq}\to V_{pq}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\tilde{V}_{pq}\to V_{pq}</annotation></semantics></math>. It is described by adding an additional marked point on the compactified lateral line <math id="S6.SS2.SSS2.p3.m11" class="ltx_Math" alttext="{\mathbb{R}}\cup\{\pm\infty\}\cong[0,1]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℝ</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mrow><mo>±</mo><mi mathvariant="normal">∞</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>≅</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{R}}\cup\{\pm\infty\}\cong[0,1]</annotation></semantics></math> of the cylindrical components and the map <math id="S6.SS2.SSS2.p3.m12" class="ltx_Math" alttext="\tilde{V}_{pq}\to V_{pq}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\tilde{V}_{pq}\to V_{pq}</annotation></semantics></math> is the associated forgetful map. The fiber of the universal family over <math id="S6.SS2.SSS2.p3.m13" class="ltx_Math" alttext="\tilde{V}_{pq}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\tilde{V}_{pq}</annotation></semantics></math> is the same as the fiber of <math id="S6.SS2.SSS2.p3.m14" class="ltx_Math" alttext="V_{pq}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">V_{pq}</annotation></semantics></math> when the newly-added marked point <math id="S6.SS2.SSS2.p3.m15" class="ltx_Math" alttext="\neq\pm\infty" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≠</mo><mrow><mo>±</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">\neq\pm\infty</annotation></semantics></math>; when it is given by <math id="S6.SS2.SSS2.p3.m16" class="ltx_Math" alttext="\pm\infty" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\pm\infty</annotation></semantics></math>, we insert a cylinder between the consecutive two cylindrical components which is mapped to the common asymptotic orbit. In particular, <math id="S6.SS2.SSS2.p3.m17" class="ltx_Math" alttext="\tilde{V}_{pq}\to V_{pq}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\tilde{V}_{pq}\to V_{pq}</annotation></semantics></math> is a fiber bundle with fiber <math id="S6.SS2.SSS2.p3.m18" class="ltx_Math" alttext="\cong[0,1]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≅</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\cong[0,1]</annotation></semantics></math>. For an element <math id="S6.SS2.SSS2.p3.m19" class="ltx_Math" alttext="(\Sigma,u,\mu,\eta)\in V_{pq}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>μ</mi><mo>,</mo><mi>η</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">(\Sigma,u,\mu,\eta)\in V_{pq}</annotation></semantics></math>, the domain of the universal family over <math id="S6.SS2.SSS2.p3.m20" class="ltx_Math" alttext="(\Sigma,u,\mu,\eta)\times\{1\}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>μ</mi><mo>,</mo><mi>η</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">(\Sigma,u,\mu,\eta)\times\{1\}</annotation></semantics></math> coincides with the domain of <math id="S6.SS2.SSS2.p3.m21" class="ltx_Math" alttext="D^{\rm vt}_{u,\mu,\eta}\oplus\nabla^{0,1}_{\underline{\smash{q}}}\oplus\lambda_{\underline{\smash{q}}}\oplus 0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>D</mi><mrow><mi>u</mi><mo>,</mo><mi>μ</mi><mo>,</mo><mi>η</mi></mrow><mi>vt</mi></msubsup><mo>⊕</mo><msubsup><mo>∇</mo><munder accentunder="true"><mi>q</mi><mo stretchy="true">¯</mo></munder><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msubsup><mo lspace="0em">⊕</mo><msub><mi>λ</mi><munder accentunder="true"><mi>q</mi><mo stretchy="true">¯</mo></munder></msub><mo>⊕</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">D^{\rm vt}_{u,\mu,\eta}\oplus\nabla^{0,1}_{\underline{\smash{q}}}\oplus\lambda_{\underline{\smash{q}}}\oplus 0</annotation></semantics></math>.</span></p>
</div>
<div id="S6.SS2.SSS2.p4" class="ltx_para">
<p id="S6.SS2.SSS2.p4.1" class="ltx_p"><span id="S6.SS2.SSS2.p4.1.1" class="ltx_text">Write</span></p>
<table id="S6.Ex39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex39.m1" class="ltx_Math" alttext="D^{\rm vt}_{u,\mu,\eta}=D^{{\rm vt},{\mathbb{C}}}_{u,\mu,\eta}+Y^{\rm vt}_{u,\mu,\eta}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>D</mi><mrow><mi>u</mi><mo>,</mo><mi>μ</mi><mo>,</mo><mi>η</mi></mrow><mi>vt</mi></msubsup><mo>=</mo><mrow><msubsup><mi>D</mi><mrow><mi>u</mi><mo>,</mo><mi>μ</mi><mo>,</mo><mi>η</mi></mrow><mrow><mi>vt</mi><mo>,</mo><mi>ℂ</mi></mrow></msubsup><mo>+</mo><msubsup><mi>Y</mi><mrow><mi>u</mi><mo>,</mo><mi>μ</mi><mo>,</mo><mi>η</mi></mrow><mi>vt</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">D^{\rm vt}_{u,\mu,\eta}=D^{{\rm vt},{\mathbb{C}}}_{u,\mu,\eta}+Y^{\rm vt}_{u,\mu,\eta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.SSS2.p4.2" class="ltx_p"><span id="S6.SS2.SSS2.p4.2.1" class="ltx_text">where <math id="S6.SS2.SSS2.p4.m1" class="ltx_Math" alttext="D^{{\rm vt},{\mathbb{C}}}_{u,\mu,\eta}" display="inline" intent=":literal"><semantics><msubsup><mi>D</mi><mrow><mi>u</mi><mo>,</mo><mi>μ</mi><mo>,</mo><mi>η</mi></mrow><mrow><mi>vt</mi><mo>,</mo><mi>ℂ</mi></mrow></msubsup><annotation encoding="application/x-tex">D^{{\rm vt},{\mathbb{C}}}_{u,\mu,\eta}</annotation></semantics></math> is a complex linear Cauchy–Riemann operator and <math id="S6.SS2.SSS2.p4.m2" class="ltx_Math" alttext="Y^{\rm vt}_{u,\mu,\eta}" display="inline" intent=":literal"><semantics><msubsup><mi>Y</mi><mrow><mi>u</mi><mo>,</mo><mi>μ</mi><mo>,</mo><mi>η</mi></mrow><mi>vt</mi></msubsup><annotation encoding="application/x-tex">Y^{\rm vt}_{u,\mu,\eta}</annotation></semantics></math> is a <math id="S6.SS2.SSS2.p4.m3" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>-th order differential operator which is complex anti-linear. Then we can consider another operator <math id="S6.SS2.SSS2.p4.m4" class="ltx_Math" alttext="D^{{\rm vt},{\mathbb{C}}}_{u,\mu,\eta}\oplus\nabla^{0,1}_{\underline{\smash{p}}}\oplus\lambda_{\underline{\smash{p}}}\oplus 0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>D</mi><mrow><mi>u</mi><mo>,</mo><mi>μ</mi><mo>,</mo><mi>η</mi></mrow><mrow><mi>vt</mi><mo>,</mo><mi>ℂ</mi></mrow></msubsup><mo>⊕</mo><msubsup><mo>∇</mo><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msubsup><mo lspace="0em">⊕</mo><msub><mi>λ</mi><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder></msub><mo>⊕</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">D^{{\rm vt},{\mathbb{C}}}_{u,\mu,\eta}\oplus\nabla^{0,1}_{\underline{\smash{p}}}\oplus\lambda_{\underline{\smash{p}}}\oplus 0</annotation></semantics></math></span></p>
<table id="S6.Ex40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex40.m1" class="ltx_Math" alttext="{\mathcal{E}}_{u,\mu,\eta}\oplus(\Omega^{0}((\underline{\smash{p}}\circ{\rm pr}_{S^{1}})^{*}TM)\oplus V_{\underline{\smash{p}}}^{-})\oplus V_{\underline{\smash{q}}}^{-}\to{\mathcal{F}}_{u,\mu,\eta}\oplus\Omega^{0,1}((\underline{\smash{p}}\circ{\rm pr}_{S^{1}})^{*}TM)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>u</mi><mo>,</mo><mi>μ</mi><mo>,</mo><mi>η</mi></mrow></msub><mo>⊕</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi mathvariant="normal">Ω</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>pr</mi><msup><mi>S</mi><mn>1</mn></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><msubsup><mi>V</mi><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo>−</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo>⊕</mo><msubsup><mi>V</mi><munder accentunder="true"><mi>q</mi><mo stretchy="true">¯</mo></munder><mo>−</mo></msubsup></mrow><mo stretchy="false">→</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>u</mi><mo>,</mo><mi>μ</mi><mo>,</mo><mi>η</mi></mrow></msub><mo>⊕</mo><mrow><msup><mi mathvariant="normal">Ω</mi><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>pr</mi><msup><mi>S</mi><mn>1</mn></msup></msub></mrow><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{E}}_{u,\mu,\eta}\oplus(\Omega^{0}((\underline{\smash{p}}\circ{\rm pr}_{S^{1}})^{*}TM)\oplus V_{\underline{\smash{p}}}^{-})\oplus V_{\underline{\smash{q}}}^{-}\to{\mathcal{F}}_{u,\mu,\eta}\oplus\Omega^{0,1}((\underline{\smash{p}}\circ{\rm pr}_{S^{1}})^{*}TM).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.SSS2.p4.3" class="ltx_p"><span id="S6.SS2.SSS2.p4.3.1" class="ltx_text">If this Fredholm operator is surjective, then there exists a finite dimensional complex vector space <math id="S6.SS2.SSS2.p4.m5" class="ltx_Math" alttext="(I^{\rm vt}_{pq})_{u,\mu,\eta}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi>I</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>vt</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>u</mi><mo>,</mo><mi>μ</mi><mo>,</mo><mi>η</mi></mrow></msub><annotation encoding="application/x-tex">(I^{\rm vt}_{pq})_{u,\mu,\eta}</annotation></semantics></math> such that the kernel of this operator is</span></p>
<table id="S6.Ex41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex41.m1" class="ltx_Math" alttext="(I^{\rm vt}_{pq})_{u,\mu,\eta}\oplus V_{\underline{\smash{p}}}^{+}\oplus V_{\underline{\smash{q}}}^{-}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">(</mo><msubsup><mi>I</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>vt</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>u</mi><mo>,</mo><mi>μ</mi><mo>,</mo><mi>η</mi></mrow></msub><mo>⊕</mo><msubsup><mi>V</mi><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo>+</mo></msubsup><mo>⊕</mo><msubsup><mi>V</mi><munder accentunder="true"><mi>q</mi><mo stretchy="true">¯</mo></munder><mo>−</mo></msubsup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(I^{\rm vt}_{pq})_{u,\mu,\eta}\oplus V_{\underline{\smash{p}}}^{+}\oplus V_{\underline{\smash{q}}}^{-}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.SSS2.p4.4" class="ltx_p"><span id="S6.SS2.SSS2.p4.4.1" class="ltx_text">Note that using the position of the additional marked point on the lateral line <math id="S6.SS2.SSS2.p4.m6" class="ltx_Math" alttext="\tilde{V}_{pq}\to V_{pq}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\tilde{V}_{pq}\to V_{pq}</annotation></semantics></math> and a cut-off function defined on the domains of the universal family over <math id="S6.SS2.SSS2.p4.m7" class="ltx_Math" alttext="\tilde{V}_{pq}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\tilde{V}_{pq}</annotation></semantics></math> whose differential has support on the horizontal component where the marked point lives on, we can construct a homotopy between two Fredholm operators</span></p>
<table id="S6.Ex42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex42.m1" class="ltx_Math" alttext="D^{\rm vt}_{u,\mu,\eta}\oplus\nabla^{0,1}_{\underline{\smash{q}}}\oplus\lambda_{\underline{\smash{q}}}\oplus 0\text{ and }D^{{\rm vt},{\mathbb{C}}}_{u,\mu,\eta}\oplus\nabla^{0,1}_{\underline{\smash{p}}}\oplus\lambda_{\underline{\smash{p}}}\oplus 0" display="block" intent=":literal"><semantics><mrow><msubsup><mi>D</mi><mrow><mi>u</mi><mo>,</mo><mi>μ</mi><mo>,</mo><mi>η</mi></mrow><mi>vt</mi></msubsup><mo>⊕</mo><msubsup><mo>∇</mo><munder accentunder="true"><mi>q</mi><mo stretchy="true">¯</mo></munder><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msubsup><mo lspace="0em">⊕</mo><msub><mi>λ</mi><munder accentunder="true"><mi>q</mi><mo stretchy="true">¯</mo></munder></msub><mo>⊕</mo><mrow><mn>0</mn><mo lspace="0em" rspace="0em">​</mo><mtext> and </mtext><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>D</mi><mrow><mi>u</mi><mo>,</mo><mi>μ</mi><mo>,</mo><mi>η</mi></mrow><mrow><mi>vt</mi><mo>,</mo><mi>ℂ</mi></mrow></msubsup></mrow><mo>⊕</mo><msubsup><mo>∇</mo><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow></msubsup><mo lspace="0em">⊕</mo><msub><mi>λ</mi><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder></msub><mo>⊕</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">D^{\rm vt}_{u,\mu,\eta}\oplus\nabla^{0,1}_{\underline{\smash{q}}}\oplus\lambda_{\underline{\smash{q}}}\oplus 0\text{ and }D^{{\rm vt},{\mathbb{C}}}_{u,\mu,\eta}\oplus\nabla^{0,1}_{\underline{\smash{p}}}\oplus\lambda_{\underline{\smash{p}}}\oplus 0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.SSS2.p4.5" class="ltx_p"><span id="S6.SS2.SSS2.p4.5.1" class="ltx_text">which varies smoothly as we vary <math id="S6.SS2.SSS2.p4.m8" class="ltx_Math" alttext="(\Sigma,u,\mu,\eta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>μ</mi><mo>,</mo><mi>η</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Sigma,u,\mu,\eta)</annotation></semantics></math> along the fiber of <math id="S6.SS2.SSS2.p4.m9" class="ltx_Math" alttext="V_{pq}\to B_{pq}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi>B</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">V_{pq}\to B_{pq}</annotation></semantics></math>.</span></p>
</div>
<div id="S6.SS2.SSS2.p5" class="ltx_para">
<p id="S6.SS2.SSS2.p5.1" class="ltx_p"><span id="S6.SS2.SSS2.p5.1.1" class="ltx_text">Moreover, <math id="S6.SS2.SSS2.p5.m1" class="ltx_Math" alttext="D^{{\rm vt},{\mathbb{C}}}_{u,\mu,\eta}" display="inline" intent=":literal"><semantics><msubsup><mi>D</mi><mrow><mi>u</mi><mo>,</mo><mi>μ</mi><mo>,</mo><mi>η</mi></mrow><mrow><mi>vt</mi><mo>,</mo><mi>ℂ</mi></mrow></msubsup><annotation encoding="application/x-tex">D^{{\rm vt},{\mathbb{C}}}_{u,\mu,\eta}</annotation></semantics></math> can be made surjective if the <math id="S6.SS2.SSS2.p5.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> as from <math id="S6.SS2.SSS2.p5.m3" class="ltx_Math" alttext="E(k)" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">E(k)</annotation></semantics></math> is chosen to be large enough. This fact can be derived from exactly the same proof of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>, Proposition 6.26]</cite>. Therefore the statement is proved by defining <math id="S6.SS2.SSS2.p5.m4" class="ltx_Math" alttext="I^{\rm vt}_{pq}" display="inline" intent=":literal"><semantics><msubsup><mi>I</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>vt</mi></msubsup><annotation encoding="application/x-tex">I^{\rm vt}_{pq}</annotation></semantics></math> to be the vector bundle over <math id="S6.SS2.SSS2.p5.m5" class="ltx_Math" alttext="V_{pq}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">V_{pq}</annotation></semantics></math> by assembling <math id="S6.SS2.SSS2.p5.m6" class="ltx_Math" alttext="(I^{\rm vt}_{pq})_{u,\mu,\eta}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi>I</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>vt</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>u</mi><mo>,</mo><mi>μ</mi><mo>,</mo><mi>η</mi></mrow></msub><annotation encoding="application/x-tex">(I^{\rm vt}_{pq})_{u,\mu,\eta}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S6.Thmthm24" class="ltx_theorem ltx_theorem_cor">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm24.2" class="ltx_text ltx_font_bold">Corollary 6.24</span></span><span id="S6.Thmthm24.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmthm24.p1" class="ltx_para">
<p id="S6.Thmthm24.p1.1" class="ltx_p"><span id="S6.Thmthm24.p1.1.1" class="ltx_text ltx_font_italic">If the almost free action of <math id="S6.Thmthm24.p1.m1" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math> on <math id="S6.Thmthm24.p1.m2" class="ltx_Math" alttext="V_{pq}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">V_{pq}</annotation></semantics></math> is smooth, then the induced orbifold vector bundle <math id="S6.Thmthm24.p1.m3" class="ltx_Math" alttext="T^{\rm vt}V_{pq}" display="inline" intent=":literal"><semantics><mrow><msup><mi>T</mi><mi>vt</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">T^{\rm vt}V_{pq}</annotation></semantics></math> on the quotient orbifold <math id="S6.Thmthm24.p1.m4" class="ltx_Math" alttext="V_{pq}/G_{pq}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>/</mo><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">V_{pq}/G_{pq}</annotation></semantics></math> has a normal complex structure.</span></p>
</div>
</div>
<div id="S6.SS2.SSS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S6.SS2.SSS2.p6" class="ltx_para">
<p id="S6.SS2.SSS2.p6.1" class="ltx_p"><span id="S6.SS2.SSS2.p6.1.1" class="ltx_text">This follows from Lemma <a href="#S6.Thmthm23" title="Lemma 6.23. ‣ 6.2.2. Vertical stable complex structures ‣ 6.2. Pre-smoothing operations and stable complex structures ‣ 6. Smoothing ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.23</span></a> and the follwing fact. For <math id="S6.SS2.SSS2.p6.m1" class="ltx_Math" alttext="p\in{\mathcal{P}}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow><annotation encoding="application/x-tex">p\in{\mathcal{P}}</annotation></semantics></math> (also for <math id="S6.SS2.SSS2.p6.m2" class="ltx_Math" alttext="q\in{\mathcal{P}}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow><annotation encoding="application/x-tex">q\in{\mathcal{P}}</annotation></semantics></math>), the trivial vector bundles <math id="S6.SS2.SSS2.p6.m3" class="ltx_Math" alttext="V_{\underline{\smash{p}}}^{+}\times V_{pq}\to V_{pq}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>V</mi><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo>+</mo></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo stretchy="false">→</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">V_{\underline{\smash{p}}}^{+}\times V_{pq}\to V_{pq}</annotation></semantics></math> and <math id="S6.SS2.SSS2.p6.m4" class="ltx_Math" alttext="V_{\underline{\smash{p}}}^{-}\times V_{pq}\to V_{pq}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>V</mi><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo>−</mo></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo stretchy="false">→</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">V_{\underline{\smash{p}}}^{-}\times V_{pq}\to V_{pq}</annotation></semantics></math> can be viewed as <math id="S6.SS2.SSS2.p6.m5" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math>-equivariant vectors for which <math id="S6.SS2.SSS2.p6.m6" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math> acts trivially on the factor <math id="S6.SS2.SSS2.p6.m7" class="ltx_Math" alttext="V_{\underline{\smash{p}}}^{\pm}" display="inline" intent=":literal"><semantics><msubsup><mi>V</mi><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo>±</mo></msubsup><annotation encoding="application/x-tex">V_{\underline{\smash{p}}}^{\pm}</annotation></semantics></math>. In particular, we can use <math id="S6.SS2.SSS2.p6.m8" class="ltx_Math" alttext="V_{\underline{\smash{p}}}^{\pm}" display="inline" intent=":literal"><semantics><msubsup><mi>V</mi><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo>±</mo></msubsup><annotation encoding="application/x-tex">V_{\underline{\smash{p}}}^{\pm}</annotation></semantics></math> to stabilize the space <math id="S6.SS2.SSS2.p6.m9" class="ltx_Math" alttext="V_{pq}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">V_{pq}</annotation></semantics></math>. Because the induced <math id="S6.SS2.SSS2.p6.m10" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math>-action on <math id="S6.SS2.SSS2.p6.m11" class="ltx_Math" alttext="V_{\underline{\smash{p}}}^{\pm}\times V_{pq}\to V_{pq}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>V</mi><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo>±</mo></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo stretchy="false">→</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">V_{\underline{\smash{p}}}^{\pm}\times V_{pq}\to V_{pq}</annotation></semantics></math> is trivial on the first factor, they do not affect the <em id="S6.SS2.SSS2.p6.1.1.1" class="ltx_emph ltx_font_italic">normal</em> directions to the union of <math id="S6.SS2.SSS2.p6.m12" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math>-orbits with the same isotropy group of both the tangent bundle of <math id="S6.SS2.SSS2.p6.m13" class="ltx_Math" alttext="V_{pq}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">V_{pq}</annotation></semantics></math>. Therefore the statement follows from taking the nontrivial part of the representations of (<a href="#S6.E4" title="In Lemma 6.23. ‣ 6.2.2. Vertical stable complex structures ‣ 6.2. Pre-smoothing operations and stable complex structures ‣ 6. Smoothing ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.4</span></a>) after taking the <math id="S6.SS2.SSS2.p6.m14" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math>-quotient.
∎</span></p>
</div>
</div>
</section>
<section id="S6.SS2.SSS3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">6.2.3. </span>Stabilizing the K-chart lift</h4>

<div id="S6.SS2.SSS3.p1" class="ltx_para">
<p id="S6.SS2.SSS3.p1.1" class="ltx_p">In the equivariant smoothing theorem of Lashof <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx24" title="" class="ltx_ref">Las79</a>]</cite> a smooth structure can only be obtained after stabilizing the manifold. Given a <math id="S6.SS2.SSS3.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-manifold <math id="S6.SS2.SSS3.p1.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, a stabilization of <math id="S6.SS2.SSS3.p1.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> is <math id="S6.SS2.SSS3.p1.m4" class="ltx_Math" alttext="M\times{\bm{R}}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑹</mi></mrow><annotation encoding="application/x-tex">M\times{\bm{R}}</annotation></semantics></math> where <math id="S6.SS2.SSS3.p1.m5" class="ltx_Math" alttext="{\bm{R}}" display="inline" intent=":literal"><semantics><mi>𝑹</mi><annotation encoding="application/x-tex">{\bm{R}}</annotation></semantics></math> is an orthogonal <math id="S6.SS2.SSS3.p1.m6" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-space.<span id="footnote18" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">18</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">18</sup>
                <span class="ltx_tag ltx_tag_note">18</span>
                
                
                
              We could try to extend the theory to the case of nontrivial bundles but that is not completely necessary.</span></span></span> This operation fits into the stabilization of Kuranishi charts. As we are dealing with infinitely many Kuranishi charts associated to a K-chart lift of the Floer category <math id="S6.SS2.SSS3.p1.m7" class="ltx_Math" alttext="T^{\rm Floer}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi>Floer</mi></msup><annotation encoding="application/x-tex">T^{\rm Floer}</annotation></semantics></math> (or its outer-collaring), once we stabilize certain charts (and their products) and equipped them with smooth structures, a “larger” chart needs to be stabilized by a larger representation in order to include the stabilization of products corresponding to its strata. Thus we need to introduce the following concept which describes how a system of stabilizations should fit together.</p>
</div>
<div id="S6.Thmthm25" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmthm25.2" class="ltx_text ltx_font_bold">Definition 6.25</span></span><span id="S6.Thmthm25.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmthm25.p1" class="ltx_para">
<p id="S6.Thmthm25.p1.1" class="ltx_p">Let <math id="S6.Thmthm25.p1.m1" class="ltx_Math" alttext="T^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">T^{\mathcal{P}}</annotation></semantics></math> be a flow category over <math id="S6.Thmthm25.p1.m2" class="ltx_Math" alttext="{\mathcal{P}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">{\mathcal{P}}</annotation></semantics></math> and suppose the collection <math id="S6.Thmthm25.p1.m3" class="ltx_math_unparsed" alttext="\{K_{pq}=(G_{pq},V_{pq},E_{pq},S_{pq})\}_{p&lt;q}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mi>K</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi>E</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi>S</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>p</mi><mo>&lt;</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\{K_{pq}=(G_{pq},V_{pq},E_{pq},S_{pq})\}_{p&lt;q}</annotation></semantics></math> of Kuranishi charts with the collection <math id="S6.Thmthm25.p1.m4" class="ltx_Math" alttext="\{{\bm{\iota}}_{prq}\}_{p&lt;r&lt;q}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mi>𝜾</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">}</mo></mrow><mrow><mi>p</mi><mo>&lt;</mo><mi>r</mi><mo>&lt;</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\{{\bm{\iota}}_{prq}\}_{p&lt;r&lt;q}</annotation></semantics></math> of K-chart embeddings define a K-chart lift of <math id="S6.Thmthm25.p1.m5" class="ltx_Math" alttext="T^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">T^{\mathcal{P}}</annotation></semantics></math> (see Definition <a href="#S5.Thmthm9" title="Definition 5.9. ‣ 5.1.5. The main statement ‣ 5.1. Basic notions and the main theorem about global charts ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.9</span></a>). A <span id="S6.Thmthm25.p1.1.1" class="ltx_text ltx_font_bold">stabilization</span> of consists of the following objects.</p>
</div>
<div id="S6.Thmthm25.p2" class="ltx_para">
<ol id="S6.I10" class="ltx_enumerate">
<li id="S6.I10.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S6.I10.i1.p1" class="ltx_para">
<p id="S6.I10.i1.p1.1" class="ltx_p">For each <math id="S6.I10.i1.p1.m1" class="ltx_Math" alttext="T_{pq}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">T_{pq}</annotation></semantics></math> a finite-dimensional orthogonal <math id="S6.I10.i1.p1.m2" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math>-representation <math id="S6.I10.i1.p1.m3" class="ltx_Math" alttext="{\bm{R}}_{pq}" display="inline" intent=":literal"><semantics><msub><mi>𝑹</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">{\bm{R}}_{pq}</annotation></semantics></math>. Denote by <math id="S6.I10.i1.p1.m4" class="ltx_Math" alttext="R_{pq}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">R_{pq}</annotation></semantics></math> the trivial <math id="S6.I10.i1.p1.m5" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math>-equivariant vector bundle <math id="S6.I10.i1.p1.m6" class="ltx_Math" alttext="V_{pq}\times{\bm{R}}_{pq}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝑹</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">V_{pq}\times{\bm{R}}_{pq}</annotation></semantics></math>. Then for each stratum <math id="S6.I10.i1.p1.m7" class="ltx_math_unparsed" alttext="\alpha=pr_{1}\cdots r_{l}q" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mi>p</mi><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>l</mi></msub><mi>q</mi></mrow><annotation encoding="application/x-tex">\alpha=pr_{1}\cdots r_{l}q</annotation></semantics></math>, define the <math id="S6.I10.i1.p1.m8" class="ltx_Math" alttext="G_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>α</mi></msub><annotation encoding="application/x-tex">G_{\alpha}</annotation></semantics></math>-equivariant vector bundle <math id="S6.I10.i1.p1.m9" class="ltx_Math" alttext="R_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>α</mi></msub><annotation encoding="application/x-tex">R_{\alpha}</annotation></semantics></math> over <math id="S6.I10.i1.p1.m10" class="ltx_math_unparsed" alttext="V_{\alpha}=V_{pr_{1}}\times\cdots V_{r_{l}q}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><msub><mrow></mrow><mi>α</mi></msub><mo>=</mo><mi>V</mi><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0em">⋯</mo><mi>V</mi><msub><mrow></mrow><mrow><msub><mi>r</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">V_{\alpha}=V_{pr_{1}}\times\cdots V_{r_{l}q}</annotation></semantics></math> to be</p>
<table id="S6.E5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E5.m1" class="ltx_Math" alttext="R_{pr_{1}}\boxplus\cdots\boxplus R_{r_{l}q}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>R</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></msub><mo>⊞</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>⊞</mo><msub><mi>R</mi><mrow><msub><mi>r</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">R_{pr_{1}}\boxplus\cdots\boxplus R_{r_{l}q}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(6.5)</span></td></tr></tbody>
</table>
</div></li>
<li id="S6.I10.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S6.I10.i2.p1" class="ltx_para">
<p id="S6.I10.i2.p1.1" class="ltx_p">For any pair of strata <math id="S6.I10.i2.p1.m1" class="ltx_Math" alttext="\alpha\leq\beta" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">\alpha\leq\beta</annotation></semantics></math>, an equivariant bundle embedding</p>
<table id="S6.Ex43" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex43.m1" class="ltx_Math" alttext="\lx@xy@svg{\hbox{\raise 2.5pt\hbox{\kern 9.87715pt\hbox{\ignorespaces\ignorespaces\ignorespaces\hbox{\vtop{\halign{\entry@#!@&amp;&amp;\entry@@#!@\cr&amp;\cr&amp;\crcr}}}\ignorespaces{\hbox{\kern-9.68445pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{R_{\alpha}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 17.57878pt\raise 6.4472pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-1.4139pt\hbox{$\scriptstyle{\phi_{\beta\alpha}}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 33.87715pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 0.0pt\raise-24.3889pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 33.87715pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{R_{\beta}|_{\partial^{\alpha}V_{\beta}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 54.98567pt\raise-24.27777pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern-9.87715pt\raise-31.72221pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{V_{\alpha}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 39.9368pt\raise-31.72221pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 39.9368pt\raise-31.72221pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\partial^{\alpha}V_{\beta}}$}}}}}}}\ignorespaces}}}}\ignorespaces." display="block" intent=":literal"><semantics><mrow><mtext> <svg style="vertical-align:-55.463280736517575px" height="73.31" overflow="visible" version="1.1" viewBox="13.67 55.46 118.96 73.31" width="118.96"> <g transform="matrix(1 0 0 -1 13.667014652356182 73.30527489687111) translate(0,3.46) translate(13.67,0)"> <g transform="translate(-13.4,0) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:1.34em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="18.5"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><msub><mi>R</mi><mi>α</mi></msub></span></span></foreignObject> </g> <path style="--ltx-stroke-color:#000000;" d="M 13.400392280305192 -0.27673578005007266 L 13.400392280305192 0.27673578005007266" fill="none" stroke="#000000"></path> <g transform="translate(24.32,0) translate(0,8.92) translate(4.15,0) translate(0,-1.96)"> <foreignObject style="--ltx-fo-width:1.38em;--ltx-fo-height:0.49em;--ltx-fo-depth:0.2em;font-size:10pt;" height="9.54" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="19.13"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><msub><mi mathsize="0.700em">ϕ</mi><mrow><mi mathsize="0.710em">β</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">α</mi></mrow></msub></span></span></foreignObject> </g> <g transform="translate(46.88,0)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;"