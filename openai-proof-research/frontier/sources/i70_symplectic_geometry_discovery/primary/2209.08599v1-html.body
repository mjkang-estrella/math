ow><mo stretchy="false">(</mo><msup><mo lspace="0em">∂</mo><mi>α</mi></msup><msub><mi>C</mi><mi>β</mi></msub><mo stretchy="false">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.055em">)</mo></mrow><mo rspace="0.222em">×</mo><msup><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow><mrow><msub><mi>𝔽</mi><mi>α</mi></msub><mo>∖</mo><msub><mi>𝔽</mi><mi>β</mi></msub></mrow></msup></mrow></span></span></foreignObject> </g> <path style="--ltx-stroke-color:#000000;" d="M 111.92491741716177 -0.27673578005007266 L 111.92491741716177 0.27673578005007266" fill="none" stroke="#000000"></path> <g transform="translate(186.65,0)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M 111.92491741716177 -0.27673578005007266 L 186.64469705077315 0.27673578005007266" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 186.64469705077315 -0.27673578005007266 L 186.64469705077315 0.27673578005007266" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -15.516607068923395 L 0.27673578005007266 -15.516607068923395" fill="none" stroke="#000000"></path> <g transform="translate(0,-35.75)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -35.744774336634755 L 0.27673578005007266 -15.516607068923395" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -35.744774336634755 L 0.27673578005007266 -35.7447