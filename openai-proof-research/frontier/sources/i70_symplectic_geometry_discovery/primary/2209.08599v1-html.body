{\kern 1.0pt\raise 0.0pt\hbox{\lx@xy@droprule}}\hbox{\kern-1.0pt\raise 0.0pt\hbox{\lx@xy@droprule}}}}{\hbox{\kern 70.79306pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{}$}}}}}}}{\hbox{\kern 100.79306pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{}$}}}}}}}{\hbox{\kern 154.21568pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{{\mathcal{E}}_{\gamma}|_{\partial^{\alpha}{\mathcal{U}}_{\beta}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\hbox{\kern 1.0pt\raise 0.0pt\hbox{\lx@xy@droprule}}\hbox{\kern-1.0pt\raise 0.0pt\hbox{\lx@xy@droprule}}}}\ignorespaces{}{\hbox{\hbox{\kern 1.0pt\raise 0.0pt\hbox{\lx@xy@droprule}}\hbox{\kern-1.0pt\raise 0.0pt\hbox{\lx@xy@droprule}}}}{\hbox{\hbox{\kern 1.0pt\raise 0.0pt\hbox{\lx@xy@droprule}}\hbox{\kern-1.0pt\raise 0.0pt\hbox{\lx@xy@droprule}}}}{\hbox{\kern-27.73225pt\raise-32.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\pi_{\beta\alpha}^{*}\left({\mathcal{E}}_{\gamma}|_{{\mathcal{U}}_{\alpha}}\right)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\hbox{\kern 1.0pt\raise 0.0pt\hbox{\lx@xy@droprule}}\hbox{\kern-1.0pt\raise 0.0pt\hbox{\lx@xy@droprule}}}}\ignorespaces{}{\hbox{\hbox{\kern 1.0pt\raise 0.0pt\hbox{\lx@xy@droprule}}\hbox{\kern-1.0pt\raise 0.0pt\hbox{\lx@xy@droprule}}}}{\hbox{\hbox{\kern 1.0pt\raise 0.0pt\hbox{\lx@xy@droprule}}\hbox{\kern-1.0pt\raise 0.0pt\hbox{\lx@xy@droprule}}}}{\hbox{\kern 70.79306pt\raise-32.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{}$}}}}}}}{\hbox{\kern 100.79306pt\raise-32.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{}$}}}}}}}{\hbox{\kern 171.45415pt\raise-32.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{}$}}}}}}}{\hbox{\kern-46.79306pt\raise-64.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\pi_{\beta\alpha}^{*}\left({\mathcal{E}}_{\beta}|_{{\mathcal{U}}_{\alpha}}\oplus{\mathcal{F}}_{\gamma\beta}|_{{\mathcal{U}}_{\alpha}}\right)\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 65.38606pt\raise-70.4472pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-1.4139pt\hbox{$\scriptstyle{\vartheta_{\beta\alpha}\oplus\vartheta_{\gamma\beta\alpha}}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 130.79306pt\raise-64.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 70.79306pt\raise-64.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{}$}}}}}}}{\hbox{\kern 100.79306pt\raise-64.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{}$}}}}}}}{\hbox{\kern 130.79306pt\raise-64.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{{\mathcal{E}}_{\beta}|_{\partial^{\alpha}{\mathcal{U}}_{\beta}}\oplus{\mathcal{F}}_{\gamma\beta}|_{\partial^{\alpha}{\mathcal{U}}_{\beta}}}$}}}}}}}\ignorespaces}}}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I19.ix3.p1.2" class="ltx_p">We explain the notations here. The first vertical equal arrow on the left is due to (<a href="#S3.E12" title="In item (B) ‣ Definition 3.28. ‣ 3.5.2. Scaffolding ‣ 3.5. Additional structures ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.12</span></a>) and the second one is due to (<a href="#S3.E9" title="In item 2 ‣ Definition 3.28. ‣ 3.5.2. Scaffolding ‣ 3.5. Additional structures ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.9</span></a>). Here the requirement is that, we require</p>
<table id="S3.Ex88" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex88.m1" class="ltx_Math" alttext="\vartheta_{\gamma\alpha}\left(\pi_{\beta\alpha}^{*}({\mathcal{F}}_{\gamma\beta}|_{{\mathcal{U}}_{\alpha}})\right)={\mathcal{F}}_{\gamma\beta}|_{\partial^{\alpha}{\mathcal{U}}_{\beta}}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ϑ</mi><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>π</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></msub><mo stretchy="false">|</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>α</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mo>=</mo><msub><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>β</mi></msub></mrow></msub></mrow><annotation encoding="application/x-tex">\vartheta_{\gamma\alpha}\left(\pi_{\beta\alpha}^{*}({\mathcal{F}}_{\gamma\beta}|_{{\mathcal{U}}_{\alpha}})\right)={\mathcal{F}}_{\gamma\beta}|_{\partial^{\alpha}{\mathcal{U}}_{\beta}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I19.ix3.p1.3" class="ltx_p">and the restriction to <math id="S3.I19.ix3.p1.m2" class="ltx_Math" alttext="\vartheta_{\gamma\alpha}" display="inline" intent=":literal"><semantics><msub><mi>ϑ</mi><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><annotation encoding="application/x-tex">\vartheta_{\gamma\alpha}</annotation></semantics></math> to <math id="S3.I19.ix3.p1.m3" class="ltx_Math" alttext="\pi_{\beta\alpha}^{*}({\mathcal{F}}_{\gamma\beta}|_{{\mathcal{U}}_{\alpha}})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>π</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></msub><mo stretchy="false">|</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>α</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{\beta\alpha}^{*}({\mathcal{F}}_{\gamma\beta}|_{{\mathcal{U}}_{\alpha}})</annotation></semantics></math> is equal to a linear isomorphism <math id="S3.I19.ix3.p1.m4" class="ltx_Math" alttext="\vartheta_{\gamma\beta\alpha}" display="inline" intent=":literal"><semantics><msub><mi>ϑ</mi><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><annotation encoding="application/x-tex">\vartheta_{\gamma\beta\alpha}</annotation></semantics></math> (which is in the above commutative diagram). And we require that the above diagram commutes.</p>
</div></li>
<li id="S3.I19.ix4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(D)</span> 
<div id="S3.I19.ix4.p1" class="ltx_para">
<p id="S3.I19.ix4.p1.1" class="ltx_p">The stabilization maps satisfy the cocycle condition. Namely, for each triple of strata <math id="S3.I19.ix4.p1.m1" class="ltx_Math" alttext="\alpha\leq\beta\leq\gamma" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>≤</mo><mi>β</mi><mo>≤</mo><mi>γ</mi></mrow><annotation encoding="application/x-tex">\alpha\leq\beta\leq\gamma</annotation></semantics></math>, the following diagram commutes.</p>
<table id="S3.E13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
