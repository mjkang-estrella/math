{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 36.87384pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.55554pt\hbox{$\textstyle{X_{2}^{\boxplus r}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 49.74768pt\raise-25.00197pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern-8.99307pt\raise-32.27974pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.55554pt\hbox{$\textstyle{{\mathbb{A}}_{1}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 20.39409pt\raise-36.78668pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-1.50694pt\hbox{$\scriptstyle{\iota}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 40.75461pt\raise-32.27974pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 40.75461pt\raise-32.27974pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.55554pt\hbox{$\textstyle{{\mathbb{A}}_{2}}$}}}}}}}\ignorespaces}}}}\ignorespaces.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S3.SS3.SSS1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS3.SSS1.p5" class="ltx_para">
<p id="S3.SS3.SSS1.p5.1" class="ltx_p"><span id="S3.SS3.SSS1.p5.1.1" class="ltx_text">Using the presentation</span></p>
<table id="S3.Ex45" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex45.m1" class="ltx_math_unparsed" alttext="X_{i}^{\boxplus r}=\left(\bigsqcup_{\alpha_{i}\in{\mathbb{A}}_{i}}\partial^{\alpha}X_{i}\times[-r,0]^{{\mathbb{F}}_{\alpha_{i}}}\right)/\sim\text{ for }i=1,2," display="block" intent=":literal"><semantics><mrow><msubsup><mi>X</mi><mi>i</mi><mrow><mo rspace="0em">⊞</mo><mi>r</mi></mrow></msubsup><mo>=</mo><mrow><mo>(</mo><munder><mo lspace="0em" movablelimits="false" rspace="0em">⨆</mo><mrow><msub><mi>α</mi><mi>i</mi></msub><mo>∈</mo><msub><mi>𝔸</mi><mi>i</mi></msub></mrow></munder><msup><mo>∂</mo><mi>α</mi></msup><msub><mi>X</mi><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mrow><mo stretchy="false">[</mo><mo lspace="0em">−</mo><mi>r</mi><mo>,</mo><mn>0</mn><mo stretchy="false">]</mo></mrow><msub><mi>𝔽</mi><msub><mi>α</mi><mi>i</mi></msub></msub></msup><mo>)</mo></mrow><mo rspace="0em">/</mo><mo lspace="0em">∼</mo><mtext> for </mtext><mi>i</mi><mo>=</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo></mrow><annotation encoding="application/x-tex">X_{i}^{\boxplus r}=\left(\bigsqcup_{\alpha_{i}\in{\mathbb{A}}_{i}}\partial^{\alpha}X_{i}\times[-r,0]^{{\mathbb{F}}_{\alpha_{i}}}\right)/\sim\text{ for }i=1,2,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.SSS1.p5.2" class="ltx_p"><span id="S3.SS3.SSS1.p5.2.1" class="ltx_text">we define the restriction of <math id="S3.SS3.SSS1.p5.m1" class="ltx_Math" alttext="f^{{\boxplus r}}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mrow><mo rspace="0em">⊞</mo><mi>r</mi></mrow></msup><annotation encoding="application/x-tex">f^{{\boxplus r}}</annotation></semantics></math> over <math id="S3.SS3.SSS1.p5.m2" class="ltx_Math" alttext="\partial^{\alpha_{1}}X_{1}\times[-r,0]^{{\mathbb{F}}_{\alpha_{1}}}\to\partial^{\iota(\alpha_{1})}X_{2}\times[-r,0]^{{\mathbb{F}}_{\iota(\alpha_{1})}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mo>∂</mo><msub><mi>α</mi><mn>1</mn></msub></msup><msub><mi>X</mi><mn>1</mn></msub></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>r</mi></mrow><mo>,</mo><mn>0</mn></mrow><mo stretchy="false">]</mo></mrow><msub><mi>𝔽</mi><msub><mi>α</mi><mn>1</mn></msub></msub></msup></mrow><mo rspace="0.111em" stretchy="false">→</mo><mrow><mrow><msup><mo>∂</mo><mrow><mi>ι</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></msup><msub><mi>X</mi><mn>2</mn></msub></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>r</mi></mrow><mo>,</mo><mn>0</mn></mrow><mo stretchy="false">]</mo></mrow><msub><mi>𝔽</mi><mrow><mi>ι</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></msub></msup></mrow></mrow><annotation encoding="application/x-tex">\partial^{\alpha_{1}}X_{1}\times[-r,0]^{{\mathbb{F}}_{\alpha_{1}}}\to\partial^{\iota(\alpha_{1})}X_{2}\times[-r,0]^{{\mathbb{F}}_{\iota(\alpha_{1})}}</annotation></semantics></math> to be <math id="S3.SS3.SSS1.p5.m3" class="ltx_Math" alttext="f\times\text{id}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mtext>id</mtext></mrow><annotation encoding="application/x-tex">f\times\text{id}</annotation></semantics></math>. It is easy to see that equivalent points are mapped to equivalent points, therefore we can define <math id="S3.SS3.SSS1.p5.m4" class="ltx_Math" alttext="f^{{\boxplus r}}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mrow><mo rspace="0em">⊞</mo><mi>r</mi></mrow></msup><annotation encoding="application/x-tex">f^{{\boxplus r}}</annotation></semantics></math> to be the induced map.
∎</span></p>
</div>
</div>
<div id="S3.SS3.SSS1.p6" class="ltx_para">
<p id="S3.SS3.SSS1.p6.1" class="ltx_p">The outer collar construction is compatible with group actions. Let <math id="S3.SS3.SSS1.p6.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> be a topological group acting on <math id="S3.SS3.SSS1.p6.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> via stratum-preserving homeomorphisms. For each <math id="S3.SS3.SSS1.p6.m3" class="ltx_Math" alttext="r&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">r&gt;0</annotation></semantics></math>, define the <math id="S3.SS3.SSS1.p6.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-action on <math id="S3.SS3.SSS1.p6.m5" class="ltx_Math" alttext="X^{\boxplus r}" display="inline" intent=":literal"><semantics><msup><mi>X</mi><mrow><mo rspace="0em">⊞</mo><mi>r</mi></mrow></msup><annotation encoding="application/x-tex">X^{\boxplus r}</annotation></semantics></math> as follows. For each <math id="S3.SS3.SSS1.p6.m6" class="ltx_Math" alttext="g\in G" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>∈</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">g\in G</annotation></semantics></math> and <math id="S3.SS3.SSS1.p6.m7" class="ltx_Math" alttext="(x,(t_{i})_{i\in{\mathbb{F}}_{\alpha}})\in\partial^{\alpha}X\times[-r,0]^{{\mathbb{F}}_{\alpha}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>∈</mo><msub><mi>𝔽</mi><mi>α</mi></msub></mrow></msub><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">∈</mo><mrow><mrow><msup><mo>∂</mo><mi>α</mi></msup><mi>X</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>r</mi></mrow><mo>,</mo><mn>0</mn></mrow><mo stretchy="false">]</mo></mrow><msub><mi>𝔽</mi><mi>α</mi></msub></msup></mrow></mrow><annotation encoding="application/x-tex">(x,(t_{i})_{i\in{\mathbb{F}}_{\alpha}})\in\partial^{\alpha}X\times[-r,0]^{{\mathbb{F}}_{\alpha}}</annotation></semantics></math>, define</p>
<table id="S3.Ex46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex46.m1" class="ltx_Math" alttext="g\cdot(x,(t_{i})_{i\in{\mathbb{F}}_{\alpha}})=(gx,(t_{i})_{i\in{\mathbb{F}}_{\alpha}})\in\partial^{\alpha}X\times[-r,0]^{{\mathbb{F}}_{\alpha}}\subset X^{\boxplus r}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>g</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>∈</mo><msub><mi>𝔽</mi><mi>α</mi></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>∈</mo><msub><mi>𝔽</mi><mi>α</mi></msub></mrow></msub><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">∈</mo><mrow><mrow><msup><mo>∂</mo><mi>α</mi></msup><mi>X</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mi>r</mi></mrow><mo>,</mo><mn>0</mn></mrow><mo stretchy="false">]</mo></mrow><msub><mi>𝔽</mi><mi>α</mi></msub></msup></mrow><mo>⊂</mo><msup><mi>X</mi><mrow><mo rspace="0em">⊞</mo><mi>r</mi></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">g\cdot(x,(t_{i})_{i\in{\mathbb{F}}_{\alpha}})=(gx,(t_{i})_{i\in{\mathbb{F}}_{\alpha}})\in\partial^{\alpha}X\times[-r,0]^{{\mathbb{F}}_{\alpha}}\subset X^{\boxplus r}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.SSS1.p6.2" class="ltx_p">It is easy to check that the action is well-defined, continuous, and preserves strata.</p>
</div>
</section>
<section id="S3.SS3.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">3.3.2. </span>Outer-collaring of flow categories and bimodules</h4>

<div id="S3.SS3.SSS2.p1" class="ltx_para">
<p id="S3.SS3.SSS2.p1.1" class="ltx_p">The outer-collaring construction described above can be naturally carried over to a system of stratified spaces included in a flow category or bimodule. Let <math id="S3.SS3.SSS2.p1.m1" class="ltx_Math" alttext="{\mathcal{P}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">{\mathcal{P}}</annotation></semantics></math> satisfy Setup <a href="#S3.Thmthm5" title="Setup 3.5. ‣ 3.2. Topological flow categories and bimodules ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.5</span></a> and let <math id="S3.SS3.SSS2.p1.m2" class="ltx_Math" alttext="T^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">T^{\mathcal{P}}</annotation></semantics></math> be a topological flow category over <math id="S3.SS3.SSS2.p1.m3" class="ltx_Math" alttext="{\mathcal{P}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">{\mathcal{P}}</annotation></semantics></math> (the <math id="S3.SS3.SSS2.p1.m4" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>-action in this discussion is trivial hence we omit the reference to it). Fix <math id="S3.SS3.SSS2.p1.m5" class="ltx_Math" alttext="r\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">r\geq 0</annotation></semantics></math>. All outer-collaring in this discussion will be of a fixed width <math id="S3.SS3.SSS2.p1.m6" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> and will be labelled by <math id="S3.SS3.SSS2.p1.m7" class="ltx_Math" alttext="+" display="inline" intent=":literal"><semantics><mo>+</mo><annotation encoding="application/x-tex">+</annotation></semantics></math> instead of <math id="S3.SS3.SSS2.p1.m8" class="ltx_Math" alttext="{\boxplus r}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">⊞</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">{\boxplus r}</annotation></semantics></math>. Then we can apply the outer-collaring construction to each individual space <math id="S3.SS3.SSS2.p1.m9" class="ltx_Math" alttext="T_{pq}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">T_{pq}</annotation></semantics></math> for all <math id="S3.SS3.SSS2.p1.m10" class="ltx_Math" alttext="p&lt;q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p&lt;q</annotation></semantics></math>, obtaining <math id="S3.SS3.SSS2.p1.m11" class="ltx_Math" alttext="{\mathbb{A}}_{pq}^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><annotation encoding="application/x-tex">{\mathbb{A}}_{pq}^{\mathcal{P}}</annotation></semantics></math>-spaces <math id="S3.SS3.SSS2.p1.m12" class="ltx_Math" alttext="T_{pq}^{+}" display="inline" intent=":literal"><semantics><msubsup><mi>T</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>+</mo></msubsup><annotation encoding="application/x-tex">T_{pq}^{+}</annotation></semantics></math>. Define “composition maps”</p>
<table id="S3.Ex47" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex47.m1" class="ltx_Math" alttext="T_{pr}^{+}\times T_{rq}^{+}\cong\partial^{prq}T_{pq}^{+}\hookrightarrow T_{pq}^{+}" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>T</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>+</mo></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>T</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>+</mo></msubsup></mrow><mo rspace="0.111em">≅</mo><mrow><msup><mo>∂</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msup><msubsup><mi>T</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>+</mo></msubsup></mrow><mo stretchy="false">↪</mo><msubsup><mi>T</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>+</mo></msubsup></mrow><annotation encoding="application/x-tex">T_{pr}^{+}\times T_{rq}^{+}\cong\partial^{prq}T_{pq}^{+}\hookrightarrow T_{pq}^{+}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.SSS2.p1.2" class="ltx_p">as the composition</p>
<table id="S3.Ex48" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex48.m1" class="ltx_Math" alttext="\lx@xy@svg{\hbox{\raise 2.5pt\hbox{\kern 23.68022pt\hbox{\ignorespaces\ignorespaces\ignorespaces\hbox{\vtop{\halign{\entry@#!@&amp;&amp;\entry@@#!@\cr&amp;&amp;&amp;\crcr}}}\ignorespaces{\hbox{\kern-23.68022pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{T_{pr}^{+}\times T_{rq}^{+}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 47.68022pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 47.68022pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{(T_{pr}\times T_{rq})^{+}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 133.45738pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 133.45738pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{(\partial^{prq}T_{pq})^{+}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 211.4214pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 211.4214pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\partial^{prq}(T_{pq}^{+})}$}}}}}}}\ignorespaces}}}}\ignorespaces." display="block" intent=":literal"><semantics><mrow><mtext> <svg style="vertical-align:-11.569253138458645px" height="23.28" overflow="visible" version="1.1" viewBox="32.77 11.57 390.79 23.28" width="390.79"> <g transform="matrix(1 0 0 -1 32.76632289693813 23.27848935632005) translate(0,3.46) translate(32.77,0)"> <g transform="translate(-32.77,0) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:4.14em;--ltx-fo-height:0.8em;--ltx-fo-depth:0.29em;font-size:10pt;" height="14.98" overflow="visible" transform="matrix(1 0 0 -1 0 11.02)" width="57.23"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mrow><msubsup><mi>T</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>+</mo></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>T</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>+</mo></msubsup></mrow></span></span></foreignObject> </g> <path style="--ltx-stroke-color:#000000;" d="M 32.76634401052477 -0.27673578005007266 L 32.76634401052477 0.27673578005007266" fill="none" stroke="#000000"></path> <g transform="translate(65.98,0)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M 32.76634401052477 -0.27673578005007266 L 65.97512322902614 0.27673578005007266" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 65.97512322902614 -0.27673578005007266 L 65.97512322902614 0.27673578005007266" fill="none" stroke="#000000"></path> <g transform="translate(65.98,0) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:5.58em;--ltx-fo-height:0.8em;--ltx-fo-depth:0.29em;font-size:10pt;" height="14.98" overflow="visible" transform="matrix(1 0 0 -1 0 11.02)" width="77.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>T</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo></msup></span></span></foreignObject> </g> <path style="--ltx-stroke-color:#000000;" d="M 151.45620238126125 -0.27673578005007266 L 151.45620238126125 0.27673578005007266" fill="none" stroke="#000000"></path> <g transform="translate(184.67,0)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M 151.45620238126125 -0.27673578005007266 L 184.6649815997626 0.27673578005007266" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 184.6649815997626 -0.27673578005007266 L 184.6649815997626 0.27673578005007266" fill="none" stroke="#000000"></path> <g transform="translate(184.67,0) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:4.8em;--ltx-fo-height:0.8em;--ltx-fo-depth:0.29em;font-size:10pt;" height="14.98" overflow="visible" transform="matrix(1 0 0 -1 0 11.02)" width="66.37"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">∂</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msup><msub><mi>T</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo></msup></span></span></foreignObject> </g> <path style="--ltx-stroke-color:#000000;" d="M 259.33499650967076 -0.27673578005007266 L 259.33499650967076 0.27673578005007266" fill="none" stroke="#000000"></path> <g transform="translate(292.55,0)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M 259.33499650967076 -0.27673578005007266 L 292.54379684175876 0.27673578005007266" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 292.54379684175876 -0.27673578005007266 L 292.54379684175876 0.27673578005007266" fill="none" stroke="#000000"></path> <g transform="translate(292.55,0) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:4.13em;--ltx-fo-height:0.8em;--ltx-fo-depth:0.29em;font-size:10pt;" height="14.98" overflow="visible" transform="matrix(1 0 0 -1 0 11.02)" width="57.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mrow><msup><mo>∂</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>T</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>+</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></span></span></foreignObject> </g> </g> </svg> </mtext><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lx@xy@svg{\hbox{\raise 2.5pt\hbox{\kern 23.68022pt\hbox{\ignorespaces\ignorespaces\ignorespaces\hbox{\vtop{\halign{\entry@#!@&amp;&amp;\entry@@#!@\cr&amp;&amp;&amp;\crcr}}}\ignorespaces{\hbox{\kern-23.68022pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{T_{pr}^{+}\times T_{rq}^{+}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 47.68022pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 47.68022pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{(T_{pr}\times T_{rq})^{+}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 133.45738pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 133.45738pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{(\partial^{prq}T_{pq})^{+}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 211.4214pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 211.4214pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\partial^{prq}(T_{pq}^{+})}$}}}}}}}\ignorespaces}}}}\ignorespaces.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.SSS2.p1.3" class="ltx_p">Here the first map comes from item (2) of Lemma <a href="#S3.Thmthm12" title="Lemma 3.12. ‣ 3.3.1. Outer-collaring of stratified spaces ‣ 3.3. Outer-collaring ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.12</span></a>, the second map is the canonical outer-collaring of the original composition map <math id="S3.SS3.SSS2.p1.m13" class="ltx_Math" alttext="T_{pr}\times T_{rq}\to\partial^{prq}T_{pq}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>T</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo rspace="0.111em" stretchy="false">→</mo><mrow><msup><mo>∂</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msup><msub><mi>T</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">T_{pr}\times T_{rq}\to\partial^{prq}T_{pq}</annotation></semantics></math>, and the third map comes from item (1) of Lemma <a href="#S3.Thmthm12" title="Lemma 3.12. ‣ 3.3.1. Outer-collaring of stratified spaces ‣ 3.3. Outer-collaring ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.12</span></a>. It is easy to check that the composition maps are still associative. Hence we obtained a new topological flow category over <math id="S3.SS3.SSS2.p1.m14" class="ltx_Math" alttext="{\mathcal{P}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">{\mathcal{P}}</annotation></semantics></math>, which we call the <span id="S3.SS3.SSS2.p1.3.1" class="ltx_text ltx_font_bold">outer-collaring</span> of <math id="S3.SS3.SSS2.p1.m15" class="ltx_Math" alttext="T^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">T^{\mathcal{P}}</annotation></semantics></math>, denoted by</p>
<table id="S3.Ex49" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex49.m1" class="ltx_Math" alttext="(T^{\mathcal{P}})^{+}" display="block" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(T^{\mathcal{P}})^{+}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.SSS2.p1.4" class="ltx_p">whose morphisms spaces are <math id="S3.SS3.SSS2.p1.m16" class="ltx_Math" alttext="T_{pq}^{+}" display="inline" intent=":literal"><semantics><msubsup><mi>T</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>+</mo></msubsup><annotation encoding="application/x-tex">T_{pq}^{+}</annotation></semantics></math>.</p>
</div>
<div id="S3.SS3.SSS2.p2" class="ltx_para">
<p id="S3.SS3.SSS2.p2.1" class="ltx_p">Similar happens when we apply outer-collaring to flow bimodules. Let <math id="S3.SS3.SSS2.p2.m1" class="ltx_Math" alttext="T^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">T^{\mathcal{P}}</annotation></semantics></math> and <math id="S3.SS3.SSS2.p2.m2" class="ltx_Math" alttext="T^{{\mathcal{P}}^{\prime}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msup><annotation encoding="application/x-tex">T^{{\mathcal{P}}^{\prime}}</annotation></semantics></math> be flow categories over <math id="S3.SS3.SSS2.p2.m3" class="ltx_Math" alttext="{\mathcal{P}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">{\mathcal{P}}</annotation></semantics></math> and <math id="S3.SS3.SSS2.p2.m4" class="ltx_Math" alttext="{\mathcal{P}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup><annotation encoding="application/x-tex">{\mathcal{P}}^{\prime}</annotation></semantics></math> respectively and let <math id="S3.SS3.SSS2.p2.m5" class="ltx_Math" alttext="M_{{\mathcal{P}}{\mathcal{P}}^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">M_{{\mathcal{P}}{\mathcal{P}}^{\prime}}</annotation></semantics></math> be a flow bimodule from <math id="S3.SS3.SSS2.p2.m6" class="ltx_Math" alttext="T^{{\mathcal{P}}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">T^{{\mathcal{P}}}</annotation></semantics></math> to <math id="S3.SS3.SSS2.p2.m7" class="ltx_Math" alttext="T^{{\mathcal{P}}^{\prime}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msup><annotation encoding="application/x-tex">T^{{\mathcal{P}}^{\prime}}</annotation></semantics></math>. By doing outer-collaring to each individual space <math id="S3.SS3.SSS2.p2.m8" class="ltx_Math" alttext="M_{pp^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">M_{pp^{\prime}}</annotation></semantics></math> for <math id="S3.SS3.SSS2.p2.m9" class="ltx_Math" alttext="p\in{\mathcal{P}}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow><annotation encoding="application/x-tex">p\in{\mathcal{P}}</annotation></semantics></math> and <math id="S3.SS3.SSS2.p2.m10" class="ltx_Math" alttext="p^{\prime}\in{\mathcal{P}}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>p</mi><mo>′</mo></msup><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">p^{\prime}\in{\mathcal{P}}^{\prime}</annotation></semantics></math>, obtaining new spaces <math id="S3.SS3.SSS2.p2.m11" class="ltx_Math" alttext="M_{pp^{\prime}}^{+}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mo>+</mo></msubsup><annotation encoding="application/x-tex">M_{pp^{\prime}}^{+}</annotation></semantics></math>, one obtains a flow bimodule <math id="S3.SS3.SSS2.p2.m12" class="ltx_Math" alttext="M_{{\mathcal{P}}{\mathcal{P}}^{\prime}}^{+}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></mrow><mo>+</mo></msubsup><annotation encoding="application/x-tex">M_{{\mathcal{P}}{\mathcal{P}}^{\prime}}^{+}</annotation></semantics></math> from <math id="S3.SS3.SSS2.p2.m13" class="ltx_Math" alttext="T^{{\mathcal{P}}+}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>+</mo></mrow></msup><annotation encoding="application/x-tex">T^{{\mathcal{P}}+}</annotation></semantics></math> to <math id="S3.SS3.SSS2.p2.m14" class="ltx_Math" alttext="T^{{\mathcal{P}}^{\prime}+}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup><mo>+</mo></mrow></msup><annotation encoding="application/x-tex">T^{{\mathcal{P}}^{\prime}+}</annotation></semantics></math>. This new flow bimodule is called the <span id="S3.SS3.SSS2.p2.1.1" class="ltx_text ltx_font_bold">outer-collaring</span> of <math id="S3.SS3.SSS2.p2.m15" class="ltx_Math" alttext="M_{{\mathcal{P}}{\mathcal{P}}^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">M_{{\mathcal{P}}{\mathcal{P}}^{\prime}}</annotation></semantics></math>.</p>
</div>
</section>
</section>
<section id="S3.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.4. </span>Derived orbifold charts with stratifications</h3>

<div id="S3.SS4.p1" class="ltx_para">
<p id="S3.SS4.p1.1" class="ltx_p">As mentioned before, the morphism spaces of flow categories and flow bimodules are <em id="S3.SS4.p1.1.1" class="ltx_emph ltx_font_italic">a priori</em> only topological spaces. We would like to define the notion of <span id="S3.SS4.p1.1.2" class="ltx_text ltx_font_bold">derived orbifold lift</span> for (topological) flow categories and flow bimodules.</p>
</div>
<section id="S3.SS4.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">3.4.1. </span>Stratified topological manifolds corners</h4>

<div id="S3.SS4.SSS1.p1" class="ltx_para">
<p id="S3.SS4.SSS1.p1.1" class="ltx_p">Before discussing smooth structures, we introduce a refined structure on stratified spaces in a special setting. It is well-known that “manifolds with corners” are identical to manifolds with boundary in the topological category. One way to define topological <math id="S3.SS4.SSS1.p1.m1" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-manifolds is given by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx2" title="" class="ltx_ref">Abo22</a>, Definition 2.4]</cite>. We specialize <em id="S3.SS4.SSS1.p1.1.1" class="ltx_emph ltx_font_italic">loc. cit.</em> which suffices for our purpose.</p>
</div>
<div id="S3.SS4.SSS1.p2" class="ltx_para">
<p id="S3.SS4.SSS1.p2.1" class="ltx_p">First we introduce some notations. The standard model for a manifold with corners is the space <math id="S3.SS4.SSS1.p2.m1" class="ltx_math_unparsed" alttext="[0,+\infty)^{k}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">[</mo><mn>0</mn><mo rspace="0em">,</mo><mo lspace="0em">+</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><annotation encoding="application/x-tex">[0,+\infty)^{k}</annotation></semantics></math> for <math id="S3.SS4.SSS1.p2.m2" class="ltx_Math" alttext="k\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">k\geq 0</annotation></semantics></math>. It is stratified by subspaces where a subset of coordinates are equal to <math id="S3.SS4.SSS1.p2.m3" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>.</p>
</div>
<div id="S3.Thmthm14" class="ltx_theorem ltx_theorem_notation">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm14.2" class="ltx_text ltx_font_italic">Notation 3.14</span></span><span id="S3.Thmthm14.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S3.Thmthm14.p1" class="ltx_para">
<p id="S3.Thmthm14.p1.1" class="ltx_p">For any finite set <math id="S3.Thmthm14.p1.m1" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math>, let <math id="S3.Thmthm14.p1.m2" class="ltx_Math" alttext="{\mathbb{A}}^{({\mathbb{F}})}" display="inline" intent=":literal"><semantics><msup><mi>𝔸</mi><mrow><mo stretchy="false">(</mo><mi>𝔽</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">{\mathbb{A}}^{({\mathbb{F}})}</annotation></semantics></math> be the set of all subsets of <math id="S3.Thmthm14.p1.m3" class="ltx_Math" alttext="{\mathbb{F}}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">{\mathbb{F}}</annotation></semantics></math> where the partial order is induced by inclusion:</p>
<table id="S3.Ex50" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex50.m1" class="ltx_Math" alttext="\alpha\leq\beta\Longleftrightarrow\beta\subseteq\alpha." display="block" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo>≤</mo><mi>β</mi><mo stretchy="false">⟺</mo><mrow><mi>β</mi><mo>⊆</mo><mi>α</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\alpha\leq\beta\Longleftrightarrow\beta\subseteq\alpha.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm14.p1.2" class="ltx_p"><math id="S3.Thmthm14.p1.m4" class="ltx_Math" alttext="{\mathbb{A}}^{({\mathbb{F}})}" display="inline" intent=":literal"><semantics><msup><mi>𝔸</mi><mrow><mo stretchy="false">(</mo><mi>𝔽</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">{\mathbb{A}}^{({\mathbb{F}})}</annotation></semantics></math> is homogeneous with a unique maximal element <math id="S3.Thmthm14.p1.m5" class="ltx_Math" alttext="\emptyset" display="inline" intent=":literal"><semantics><mi mathvariant="normal">∅</mi><annotation encoding="application/x-tex">\emptyset</annotation></semantics></math> and its depth function being</p>
<table id="S3.Ex51" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex51.m1" class="ltx_Math" alttext="{\rm depth}(\alpha)=\#\alpha." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>depth</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\rm depth}(\alpha)=\#\alpha.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm14.p1.3" class="ltx_p">We abbeviate <math id="S3.Thmthm14.p1.m6" class="ltx_Math" alttext="{\mathbb{A}}^{(k)}:={\mathbb{A}}^{(\{1,\ldots,k\})}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝔸</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo>:=</mo><msup><mi>𝔸</mi><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>k</mi></mrow><mo stretchy="false">}</mo></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">{\mathbb{A}}^{(k)}:={\mathbb{A}}^{(\{1,\ldots,k\})}</annotation></semantics></math>. Then <math id="S3.Thmthm14.p1.m7" class="ltx_math_unparsed" alttext="[0,+\infty)^{k}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">[</mo><mn>0</mn><mo rspace="0em">,</mo><mo lspace="0em">+</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><annotation encoding="application/x-tex">[0,+\infty)^{k}</annotation></semantics></math> is an <math id="S3.Thmthm14.p1.m8" class="ltx_Math" alttext="{\mathbb{A}}^{(k)}" display="inline" intent=":literal"><semantics><msup><mi>𝔸</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">{\mathbb{A}}^{(k)}</annotation></semantics></math>-space.</p>
</div>
</div>
<div id="S3.Thmthm15" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm15.2" class="ltx_text ltx_font_bold">Definition 3.15</span></span><span id="S3.Thmthm15.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm15.p1" class="ltx_para">
<p id="S3.Thmthm15.p1.1" class="ltx_p">Let <math id="S3.Thmthm15.p1.m1" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math> be a (countable) homogeneous poset. An <math id="S3.Thmthm15.p1.m2" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-space is called a (topological) <math id="S3.Thmthm15.p1.m3" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math><span id="S3.Thmthm15.p1.1.1" class="ltx_text ltx_font_bold">-manifold</span> if the following is true.</p>
<ol id="S3.I8" class="ltx_enumerate">
<li id="S3.I8.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S3.I8.i1.p1" class="ltx_para">
<p id="S3.I8.i1.p1.1" class="ltx_p">For any <math id="S3.I8.i1.p1.m1" class="ltx_Math" alttext="\alpha\in{\mathbb{A}}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mi>𝔸</mi></mrow><annotation encoding="application/x-tex">\alpha\in{\mathbb{A}}</annotation></semantics></math>, the space <math id="S3.I8.i1.p1.m2" class="ltx_Math" alttext="\partial^{\alpha}X" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mi>α</mi></msup><mi>X</mi></mrow><annotation encoding="application/x-tex">\partial^{\alpha}X</annotation></semantics></math> is a topological manifold (possibly with boundary) whose interior is <math id="S3.I8.i1.p1.m3" class="ltx_Math" alttext="X_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>α</mi></msub><annotation encoding="application/x-tex">X_{\alpha}</annotation></semantics></math>.</p>
</div></li>
<li id="S3.I8.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S3.I8.i2.p1" class="ltx_para">
<p id="S3.I8.i2.p1.1" class="ltx_p">Each <math id="S3.I8.i2.p1.m1" class="ltx_Math" alttext="x\in X_{\alpha}\subset X" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msub><mi>X</mi><mi>α</mi></msub><mo>⊂</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">x\in X_{\alpha}\subset X</annotation></semantics></math> has a <span id="S3.I8.i2.p1.1.1" class="ltx_text ltx_font_bold">corner chart</span>, i.e., a stratified open embedding</p>
<table id="S3.Ex52" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S3.Ex52.m1.pic1" class="ltx_picture ltx_markedasmath" height="71.61" overflow="visible" style="vertical-align:-57.25599315068493px" version="1.1" viewBox="61.86 57.26 177.77 71.61" width="177.77"><g transform="matrix(1 0 0 -1 61.85550354519078 71.61185968065718) translate(0,3.46) translate(61.86,0)"><g transform="translate(-61.86,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:8.34em;--ltx-fo-height:0.89em;--ltx-fo-depth:0.29em;font-size:10pt;" height="16.24" overflow="visible" transform="matrix(1 0 0 -1 0 12.29)" width="115.41"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex52.m1.pic1.m1" class="ltx_math_unparsed" alttext="\textstyle{U_{x,\alpha}\times[0,1)^{{\rm depth}(\alpha)}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msub><mi>U</mi><mrow><mi>x</mi><mo>,</mo><mi>α</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mrow><mi>depth</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\textstyle{U_{x,\alpha}\times[0,1)^{{\rm depth}(\alpha)}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 61.85552465877741 -0.27673578005007266 L 61.85552465877741 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(70.67,0) translate(0,7.18) translate(4.15,0) translate(0,-1.14)"><foreignObject style="--ltx-fo-width:0.53em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.14em;font-size:10pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="7.28"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex52.m1.pic1.m2" class="ltx_Math" alttext="\scriptstyle{\varphi}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">φ</mi><annotation encoding="application/x-tex">\scriptstyle{\varphi}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(95.07,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 61.85552465877741 -0.27673578005007266 L 95.06430387727877 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 95.06430387727877 -0.27673578005007266 L 95.06430387727877 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -11.569253138458645 L 0.27673578005007266 -11.569253138458645" fill="none" stroke="#000000"></path><g transform="translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.20877921850137 L 0.27673578005007266 -11.569253138458645" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.20877921850137 L 0.27673578005007266 -33.20877921850137" fill="none" stroke="#000000"></path><g transform="translate(95.07,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.91em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="12.55"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex52.m1.pic1.m3" class="ltx_Math" alttext="\textstyle{X\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">\textstyle{X\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 105.2133516106052 -7.610350076103501 L 105.76682317070534 -7.610350076103501" fill="none" stroke="#000000"></path><g transform="translate(105.49,0) translate(0,-36.04)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 105.2133516106052 -36.039287756633115 L 105.76682317070534 -7.610350076103501" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 105.2133516106052 -36.039287756633115 L 105.76682317070534 -36.039287756633115" fill="none" stroke="#000000"></path><g transform="translate(-52.45,0) translate(0,-46.19) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:6.98em;--ltx-fo-height:0.89em;--ltx-fo-depth:0.25em;font-size:10pt;" height="15.75" overflow="visible" transform="matrix(1 0 0 -1 0 12.29)" width="96.59"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex52.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{\{\alpha\}\times{\mathbb{A}}^{({\rm depth}(\alpha))}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><mi>α</mi><mo rspace="0.055em" stretchy="false">}</mo></mrow><mo rspace="0.222em">×</mo><msup><mi>𝔸</mi><mrow><mo stretchy="false">(</mo><mrow><mi>depth</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\textstyle{\{\alpha\}\times{\mathbb{A}}^{({\rm depth}(\alpha))}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 52.44524132187673 -46.463128820039 L 52.44524132187673 -45.90965725993886" fill="none" stroke="#000000"></path><g transform="translate(96.15,0) translate(0,-46.19)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 52.44524132187673 -46.463128820039 L 96.15011229725552 -45.90965725993886" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 96.15011229725552 -46.463128820039 L 96.15011229725552 -45.90965725993886" fill="none" stroke="#000000"></path><g transform="translate(96.15,0) translate(0,-46.19) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.75em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="10.38"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex52.m1.pic1.m5" class="ltx_Math" alttext="\textstyle{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">\textstyle{\mathbb{A}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I8.i2.p1.2" class="ltx_p">where <math id="S3.I8.i2.p1.m2" class="ltx_Math" alttext="U_{x,\alpha}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mrow><mi>x</mi><mo>,</mo><mi>α</mi></mrow></msub><annotation encoding="application/x-tex">U_{x,\alpha}</annotation></semantics></math> is an open subset of <math id="S3.I8.i2.p1.m3" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> in <math id="S3.I8.i2.p1.m4" class="ltx_Math" alttext="X_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>α</mi></msub><annotation encoding="application/x-tex">X_{\alpha}</annotation></semantics></math> (with the trivial stratification indexed by the singleton <math id="S3.I8.i2.p1.m5" class="ltx_Math" alttext="\{\alpha\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mi>α</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\alpha\}</annotation></semantics></math>).</p>
</div></li>
<li id="S3.I8.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S3.I8.i3.p1" class="ltx_para">
<p id="S3.I8.i3.p1.1" class="ltx_p">For each corner chart <math id="S3.I8.i3.p1.m1" class="ltx_math_unparsed" alttext="\varphi:U_{x}\times[0,1)^{{\rm depth}(\alpha)}\to X" display="inline" intent=":literal"><semantics><mrow><mi>φ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi>U</mi><mi>x</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mrow><mi>depth</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">→</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">\varphi:U_{x}\times[0,1)^{{\rm depth}(\alpha)}\to X</annotation></semantics></math> near <math id="S3.I8.i3.p1.m2" class="ltx_Math" alttext="x\in X_{\alpha}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msub><mi>X</mi><mi>α</mi></msub></mrow><annotation encoding="application/x-tex">x\in X_{\alpha}</annotation></semantics></math>, one has</p>
<table id="S3.Ex53" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex53.m1" class="ltx_Math" alttext="\alpha\leq\beta\Longrightarrow{\rm Im}\varphi\cap X_{\beta}\neq\emptyset." display="block" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo>≤</mo><mi>β</mi><mo stretchy="false">⟹</mo><mrow><mrow><mi>Im</mi><mo lspace="0em" rspace="0em">​</mo><mi>φ</mi></mrow><mo>∩</mo><msub><mi>X</mi><mi>β</mi></msub></mrow><mo>≠</mo><mi mathvariant="normal">∅</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\alpha\leq\beta\Longrightarrow{\rm Im}\varphi\cap X_{\beta}\neq\emptyset.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I8.i3.p1.2" class="ltx_p">In other words, corner charts touch all strata above <math id="S3.I8.i3.p1.m3" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
</div>
<div id="S3.Thmthm16" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm16.2" class="ltx_text ltx_font_italic">Remark 3.16</span></span><span id="S3.Thmthm16.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S3.Thmthm16.p1" class="ltx_para">
<p id="S3.Thmthm16.p1.1" class="ltx_p">Conditions of Definition <a href="#S3.Thmthm15" title="Definition 3.15. ‣ 3.4.1. Stratified topological manifolds corners ‣ 3.4. Derived orbifold charts with stratifications ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.15</span></a> impose more restrictions on the homogeneous poset <math id="S3.Thmthm16.p1.m1" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>. For example, for each <math id="S3.Thmthm16.p1.m2" class="ltx_Math" alttext="\alpha\in{\mathbb{A}}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mi>𝔸</mi></mrow><annotation encoding="application/x-tex">\alpha\in{\mathbb{A}}</annotation></semantics></math>, the set <math id="S3.Thmthm16.p1.m3" class="ltx_Math" alttext="\{\beta\in{\mathbb{A}}\ |\ \alpha\leq\beta\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mi>β</mi><mo>∈</mo><mi>𝔸</mi></mrow><mo lspace="0.500em" rspace="0.500em">|</mo><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\beta\in{\mathbb{A}}\ |\ \alpha\leq\beta\}</annotation></semantics></math> is isomorphic to <math id="S3.Thmthm16.p1.m4" class="ltx_Math" alttext="{\mathbb{A}}^{({\rm depth}(\alpha))}" display="inline" intent=":literal"><semantics><msup><mi>𝔸</mi><mrow><mo stretchy="false">(</mo><mrow><mi>depth</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">{\mathbb{A}}^{({\rm depth}(\alpha))}</annotation></semantics></math> and hence contains a unique maximal element. Moreover, each <math id="S3.Thmthm16.p1.m5" class="ltx_Math" alttext="\alpha\in{\mathbb{A}}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mi>𝔸</mi></mrow><annotation encoding="application/x-tex">\alpha\in{\mathbb{A}}</annotation></semantics></math> has a definite set of elements <math id="S3.Thmthm16.p1.m6" class="ltx_Math" alttext="\alpha\leq\beta" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">\alpha\leq\beta</annotation></semantics></math> with <math id="S3.Thmthm16.p1.m7" class="ltx_Math" alttext="{\rm depth}(\beta)=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>depth</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\rm depth}(\beta)=1</annotation></semantics></math> whose cardinality is equal to its depth. The posets <math id="S3.Thmthm16.p1.m8" class="ltx_Math" alttext="{\mathbb{A}}_{pq}^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><annotation encoding="application/x-tex">{\mathbb{A}}_{pq}^{\mathcal{P}}</annotation></semantics></math> and <math id="S3.Thmthm16.p1.m9" class="ltx_Math" alttext="{\mathbb{A}}_{pp^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">{\mathbb{A}}_{pp^{\prime}}</annotation></semantics></math> appeared in the disucssions of flow categories and flow bimodules all satisfy these additional restrictions.</p>
</div>
</div>
<div id="S3.Thmthm17" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm17.2" class="ltx_text ltx_font_bold">Definition 3.17</span></span><span id="S3.Thmthm17.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm17.p1" class="ltx_para">
<p id="S3.Thmthm17.p1.1" class="ltx_p">Let <math id="S3.Thmthm17.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> be a topological group acting on an <math id="S3.Thmthm17.p1.m2" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-manifold <math id="S3.Thmthm17.p1.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> viewing <math id="S3.Thmthm17.p1.m4" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> as an <math id="S3.Thmthm17.p1.m5" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-space. We say that <math id="S3.Thmthm17.p1.m6" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is an <math id="S3.Thmthm17.p1.m7" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-stratified <math id="S3.Thmthm17.p1.m8" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-manifold with corners if each <math id="S3.Thmthm17.p1.m9" class="ltx_Math" alttext="x\in X_{\alpha}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msub><mi>X</mi><mi>α</mi></msub></mrow><annotation encoding="application/x-tex">x\in X_{\alpha}</annotation></semantics></math> has a <math id="S3.Thmthm17.p1.m10" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant corner chart, i.e., a corner chart <math id="S3.Thmthm17.p1.m11" class="ltx_math_unparsed" alttext="U_{x,\alpha}\times[0,1)^{{\rm depth}(\alpha)}\to X" display="inline" intent=":literal"><semantics><mrow><msub><mi>U</mi><mrow><mi>x</mi><mo>,</mo><mi>α</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mrow><mi>depth</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">→</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">U_{x,\alpha}\times[0,1)^{{\rm depth}(\alpha)}\to X</annotation></semantics></math> which is a <math id="S3.Thmthm17.p1.m12" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant map. Here <math id="S3.Thmthm17.p1.m13" class="ltx_Math" alttext="U_{x,\alpha}\subset U_{\alpha}" display="inline" intent=":literal"><semantics><mrow><msub><mi>U</mi><mrow><mi>x</mi><mo>,</mo><mi>α</mi></mrow></msub><mo>⊂</mo><msub><mi>U</mi><mi>α</mi></msub></mrow><annotation encoding="application/x-tex">U_{x,\alpha}\subset U_{\alpha}</annotation></semantics></math> is a <math id="S3.Thmthm17.p1.m14" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant open subset and <math id="S3.Thmthm17.p1.m15" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> acts trivially on the factor <math id="S3.Thmthm17.p1.m16" class="ltx_math_unparsed" alttext="[0,1)^{{\rm depth}(\alpha)}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mrow><mi>depth</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow></msup><annotation encoding="application/x-tex">[0,1)^{{\rm depth}(\alpha)}</annotation></semantics></math>.</p>
</div>
</div>
</section>
<section id="S3.SS4.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">3.4.2. </span>Stratified smooth manifolds with corners</h4>

<div id="S3.SS4.SSS2.p1" class="ltx_para">
<p id="S3.SS4.SSS2.p1.1" class="ltx_p">Next we recall some notions related to smooth manifolds with corners. We use the following notion of smoothness for functions defined on arbitrary subsets of Euclidean spaces. Let <math id="S3.SS4.SSS2.p1.m1" class="ltx_Math" alttext="A\subseteq{\mathbb{R}}^{n}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>⊆</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">A\subseteq{\mathbb{R}}^{n}</annotation></semantics></math> be a subset. A function <math id="S3.SS4.SSS2.p1.m2" class="ltx_Math" alttext="f:A\to{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>A</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f:A\to{\mathbb{R}}</annotation></semantics></math> is called smooth if for each <math id="S3.SS4.SSS2.p1.m3" class="ltx_Math" alttext="a\in A" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mi>A</mi></mrow><annotation encoding="application/x-tex">a\in A</annotation></semantics></math> there is an open neighborhood <math id="S3.SS4.SSS2.p1.m4" class="ltx_Math" alttext="U_{a}\subset{\mathbb{R}}^{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>U</mi><mi>a</mi></msub><mo>⊂</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">U_{a}\subset{\mathbb{R}}^{n}</annotation></semantics></math> such that <math id="S3.SS4.SSS2.p1.m5" class="ltx_Math" alttext="f|_{A\cap U_{a}}" display="inline" intent=":literal"><semantics><msub><mrow><mi>f</mi><mo stretchy="false">|</mo></mrow><mrow><mi>A</mi><mo>∩</mo><msub><mi>U</mi><mi>a</mi></msub></mrow></msub><annotation encoding="application/x-tex">f|_{A\cap U_{a}}</annotation></semantics></math> can be extended to a smooth function <math id="S3.SS4.SSS2.p1.m6" class="ltx_Math" alttext="f_{a}:U_{a}\to{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>a</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>U</mi><mi>a</mi></msub><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f_{a}:U_{a}\to{\mathbb{R}}</annotation></semantics></math>. Then one can define the notion of smooth maps <math id="S3.SS4.SSS2.p1.m7" class="ltx_Math" alttext="f:A\to B" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>A</mi><mo stretchy="false">→</mo><mi>B</mi></mrow></mrow><annotation encoding="application/x-tex">f:A\to B</annotation></semantics></math> for subsets <math id="S3.SS4.SSS2.p1.m8" class="ltx_Math" alttext="A\subseteq{\mathbb{R}}^{n}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>⊆</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">A\subseteq{\mathbb{R}}^{n}</annotation></semantics></math> and <math id="S3.SS4.SSS2.p1.m9" class="ltx_Math" alttext="B\subseteq{\mathbb{R}}^{m}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>⊆</mo><msup><mi>ℝ</mi><mi>m</mi></msup></mrow><annotation encoding="application/x-tex">B\subseteq{\mathbb{R}}^{m}</annotation></semantics></math>. Then compositions of smooth maps are still smooth. A smooth map <math id="S3.SS4.SSS2.p1.m10" class="ltx_Math" alttext="f:A\to B" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>A</mi><mo stretchy="false">→</mo><mi>B</mi></mrow></mrow><annotation encoding="application/x-tex">f:A\to B</annotation></semantics></math> is a diffeomorphism if it admits a smooth inverse.</p>
</div>
<div id="S3.SS4.SSS2.p2" class="ltx_para">
<p id="S3.SS4.SSS2.p2.1" class="ltx_p">The concept of smooth manifolds with corners is defined as follows. Let <math id="S3.SS4.SSS2.p2.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> be a topological space. A chart (of an <math id="S3.SS4.SSS2.p2.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-dimensional smooth manifold with corners) consists of an open subset <math id="S3.SS4.SSS2.p2.m3" class="ltx_Math" alttext="U\subset M" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⊂</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">U\subset M</annotation></semantics></math> and a homeomorphism <math id="S3.SS4.SSS2.p2.m4" class="ltx_math_unparsed" alttext="\varphi:U\to[0,+\infty)^{n}" display="inline" intent=":literal"><semantics><mrow><mi>φ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>U</mi><mo stretchy="false">→</mo><msup><mrow><mo stretchy="false">[</mo><mn>0</mn><mo rspace="0em">,</mo><mo lspace="0em">+</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">\varphi:U\to[0,+\infty)^{n}</annotation></semantics></math> onto an open subset. Two charts <math id="S3.SS4.SSS2.p2.m5" class="ltx_math_unparsed" alttext="\varphi_{i}:U_{i}\to[0,+\infty)^{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>φ</mi><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi>U</mi><mi>i</mi></msub><mo stretchy="false">→</mo><msup><mrow><mo stretchy="false">[</mo><mn>0</mn><mo rspace="0em">,</mo><mo lspace="0em">+</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">\varphi_{i}:U_{i}\to[0,+\infty)^{n}</annotation></semantics></math>, <math id="S3.SS4.SSS2.p2.m6" class="ltx_Math" alttext="i=1,2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">i=1,2</annotation></semantics></math>, are compatible if <math id="S3.SS4.SSS2.p2.m7" class="ltx_Math" alttext="\varphi_{1}\circ\varphi_{2}^{-1}:\varphi_{2}(U_{1}\cap U_{2})\to\varphi_{1}(U_{1}\cap U_{2})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>φ</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi>φ</mi><mn>2</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>φ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>U</mi><mn>1</mn></msub><mo>∩</mo><msub><mi>U</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi>φ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>U</mi><mn>1</mn></msub><mo>∩</mo><msub><mi>U</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\varphi_{1}\circ\varphi_{2}^{-1}:\varphi_{2}(U_{1}\cap U_{2})\to\varphi_{1}(U_{1}\cap U_{2})</annotation></semantics></math> is a diffeomorphism. A structure of smooth <math id="S3.SS4.SSS2.p2.m8" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-dimensional manifold with corners is a maximal compatible atlas on <math id="S3.SS4.SSS2.p2.m9" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>. If <math id="S3.SS4.SSS2.p2.m10" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> is equipped with such a structure, we say that <math id="S3.SS4.SSS2.p2.m11" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> is a smooth <math id="S3.SS4.SSS2.p2.m12" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-dimensional manifold with corners. Over smooth manifolds with corners, one can define the notions of smooth vector bundles, smooth connections, and smooth Riemannian metrics, etc.</p>
</div>
<div id="S3.SS4.SSS2.p3" class="ltx_para">
<p id="S3.SS4.SSS2.p3.1" class="ltx_p">The concept of manifold with faces is one which can exclude certain pathological scenarios. Let <math id="S3.SS4.SSS2.p3.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> be a smooth <math id="S3.SS4.SSS2.p3.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-dimensional manifold with corners. For each point <math id="S3.SS4.SSS2.p3.m3" class="ltx_Math" alttext="x\in M" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">x\in M</annotation></semantics></math> and each chart <math id="S3.SS4.SSS2.p3.m4" class="ltx_math_unparsed" alttext="\varphi:U\to[0,+\infty)^{n}" display="inline" intent=":literal"><semantics><mrow><mi>φ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>U</mi><mo stretchy="false">→</mo><msup><mrow><mo stretchy="false">[</mo><mn>0</mn><mo rspace="0em">,</mo><mo lspace="0em">+</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">\varphi:U\to[0,+\infty)^{n}</annotation></semantics></math> defined over an open neighborhood of <math id="S3.SS4.SSS2.p3.m5" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>, the number <math id="S3.SS4.SSS2.p3.m6" class="ltx_Math" alttext="{\rm depth}(x)" display="inline" intent=":literal"><semantics><mrow><mi>depth</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\rm depth}(x)</annotation></semantics></math> of coordinates of <math id="S3.SS4.SSS2.p3.m7" class="ltx_Math" alttext="\varphi(x)" display="inline" intent=":literal"><semantics><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\varphi(x)</annotation></semantics></math> which are zero is independent of the choice of charts. Given <math id="S3.SS4.SSS2.p3.m8" class="ltx_Math" alttext="k\leq n" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≤</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">k\leq n</annotation></semantics></math>, the subset</p>
<table id="S3.Ex54" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex54.m1" class="ltx_Math" alttext="\partial^{k}M:=\{x\in M\ |\ {\rm depth}(x)=k\}\subset M" display="block" intent=":literal"><semantics><mrow><mrow><msup><mo>∂</mo><mi>k</mi></msup><mi>M</mi></mrow><mo>:=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>x</mi><mo>∈</mo><mi>M</mi></mrow><mo lspace="0.500em" rspace="0.500em">|</mo><mrow><mrow><mi>depth</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>k</mi></mrow><mo stretchy="false">}</mo></mrow><mo>⊂</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\partial^{k}M:=\{x\in M\ |\ {\rm depth}(x)=k\}\subset M</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS4.SSS2.p3.2" class="ltx_p">is naturally an <math id="S3.SS4.SSS2.p3.m9" class="ltx_Math" alttext="n-k" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">n-k</annotation></semantics></math>-dimensional smooth manifold. A <span id="S3.SS4.SSS2.p3.2.1" class="ltx_text ltx_font_bold">connected face</span> of <math id="S3.SS4.SSS2.p3.m10" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> is a connected component of the set <math id="S3.SS4.SSS2.p3.m11" class="ltx_Math" alttext="\{x\in M\ |\ {\rm depth}(x)=1\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mi>x</mi><mo>∈</mo><mi>M</mi></mrow><mo lspace="0.500em" rspace="0.500em">|</mo><mrow><mrow><mi>depth</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{x\in M\ |\ {\rm depth}(x)=1\}</annotation></semantics></math>. <math id="S3.SS4.SSS2.p3.m12" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> is called a <span id="S3.SS4.SSS2.p3.2.2" class="ltx_text ltx_font_bold">smooth manifold with faces</span> if every <math id="S3.SS4.SSS2.p3.m13" class="ltx_Math" alttext="x\in M" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">x\in M</annotation></semantics></math> belongs to the closure of exactly <math id="S3.SS4.SSS2.p3.m14" class="ltx_Math" alttext="{\rm depth}(x)" display="inline" intent=":literal"><semantics><mrow><mi>depth</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\rm depth}(x)</annotation></semantics></math> different connected faces.</p>
</div>
<div id="S3.SS4.SSS2.p4" class="ltx_para">
<p id="S3.SS4.SSS2.p4.1" class="ltx_p">As we are treating various manifolds with faces which have more refined structure of stratifications, we would like to introduce the following concepts.</p>
</div>
<div id="S3.Thmthm18" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm18.2" class="ltx_text ltx_font_bold">Definition 3.18</span></span><span id="S3.Thmthm18.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm18.p1" class="ltx_para">
<p id="S3.Thmthm18.p1.1" class="ltx_p">Let <math id="S3.Thmthm18.p1.m1" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math> be a countable homogeneous poset.</p>
<ol id="S3.I9" class="ltx_enumerate">
<li id="S3.I9.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S3.I9.i1.p1" class="ltx_para">
<p id="S3.I9.i1.p1.1" class="ltx_p">A <span id="S3.I9.i1.p1.1.1" class="ltx_text ltx_font_bold">smooth <math id="S3.I9.i1.p1.m1" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-manifold</span> is a smooth manifold with faces <math id="S3.I9.i1.p1.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> which is also a topological <math id="S3.I9.i1.p1.m3" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-manifold such that for each <math id="S3.I9.i1.p1.m4" class="ltx_Math" alttext="\alpha\in{\mathbb{A}}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mi>𝔸</mi></mrow><annotation encoding="application/x-tex">\alpha\in{\mathbb{A}}</annotation></semantics></math>, <math id="S3.I9.i1.p1.m5" class="ltx_Math" alttext="M_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>α</mi></msub><annotation encoding="application/x-tex">M_{\alpha}</annotation></semantics></math> is an open and closed subset of <math id="S3.I9.i1.p1.m6" class="ltx_Math" alttext="\partial^{{\rm depth}(\alpha)}M" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mrow><mi>depth</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mi>M</mi></mrow><annotation encoding="application/x-tex">\partial^{{\rm depth}(\alpha)}M</annotation></semantics></math>
and such that each <math id="S3.I9.i1.p1.m7" class="ltx_Math" alttext="x\in M" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">x\in M</annotation></semantics></math> has a smooth corner chart.</p>
</div></li>
<li id="S3.I9.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S3.I9.i2.p1" class="ltx_para">
<p id="S3.I9.i2.p1.1" class="ltx_p">Let <math id="S3.I9.i2.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> be a compact Lie group. A smooth <math id="S3.I9.i2.p1.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-action on a smooth <math id="S3.I9.i2.p1.m3" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-manifold <math id="S3.I9.i2.p1.m4" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> is a <math id="S3.I9.i2.p1.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-action on the underlying topological <math id="S3.I9.i2.p1.m6" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-manifold of <math id="S3.I9.i2.p1.m7" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> which acts on <math id="S3.I9.i2.p1.m8" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> by smooth maps.</p>
</div></li>
</ol>
</div>
</div>
<div id="S3.SS4.SSS2.p5" class="ltx_para">
<p id="S3.SS4.SSS2.p5.1" class="ltx_p">Note that any smooth <math id="S3.SS4.SSS2.p5.m1" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-manifold <math id="S3.SS4.SSS2.p5.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> has a natural structure of a topological <math id="S3.SS4.SSS2.p5.m3" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-manifold by forgetting the smooth structure.</p>
</div>
<div id="S3.Thmthm19" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm19.2" class="ltx_text ltx_font_bold">Definition 3.19</span></span><span id="S3.Thmthm19.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm19.p1" class="ltx_para">
<p id="S3.Thmthm19.p1.1" class="ltx_p">A smooth map <math id="S3.Thmthm19.p1.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> from a smooth <math id="S3.Thmthm19.p1.m2" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-manifold <math id="S3.Thmthm19.p1.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> to a smooth manifold without boundary <math id="S3.Thmthm19.p1.m4" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> is called <em id="S3.Thmthm19.p1.1.1" class="ltx_emph ltx_font_italic">stratified submersive</em> if for any (open) stratum <math id="S3.Thmthm19.p1.m5" class="ltx_Math" alttext="M_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>α</mi></msub><annotation encoding="application/x-tex">M_{\alpha}</annotation></semantics></math>, the restriction</p>
<table id="S3.Ex55" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex55.m1" class="ltx_Math" alttext="f|_{M_{\alpha}}:M_{\alpha}\rightarrow N" display="block" intent=":literal"><semantics><mrow><msub><mrow><mi>f</mi><mo stretchy="false">|</mo></mrow><msub><mi>M</mi><mi>α</mi></msub></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>M</mi><mi>α</mi></msub><mo stretchy="false">→</mo><mi>N</mi></mrow></mrow><annotation encoding="application/x-tex">f|_{M_{\alpha}}:M_{\alpha}\rightarrow N</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm19.p1.2" class="ltx_p">is a smooth submersion.</p>
</div>
</div>
<div id="S3.Thmthm20" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm20.2" class="ltx_text ltx_font_bold">Lemma 3.20</span></span><span id="S3.Thmthm20.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm20.p1" class="ltx_para">
<p id="S3.Thmthm20.p1.1" class="ltx_p"><span id="S3.Thmthm20.p1.1.1" class="ltx_text ltx_font_italic">Suppose <math id="S3.Thmthm20.p1.m1" class="ltx_Math" alttext="f:M\to N" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mi>N</mi></mrow></mrow><annotation encoding="application/x-tex">f:M\to N</annotation></semantics></math> is stratified submersive. Then for any <math id="S3.Thmthm20.p1.m2" class="ltx_Math" alttext="y\in N" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>∈</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">y\in N</annotation></semantics></math>, the space <math id="S3.Thmthm20.p1.m3" class="ltx_Math" alttext="f^{-1}(y)" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f^{-1}(y)</annotation></semantics></math> is a smooth <math id="S3.Thmthm20.p1.m4" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-manifold. Moreover, if <math id="S3.Thmthm20.p1.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> is a compact Lie group acting on <math id="S3.Thmthm20.p1.m6" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> and <math id="S3.Thmthm20.p1.m7" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is <math id="S3.Thmthm20.p1.m8" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant, then <math id="S3.Thmthm20.p1.m9" class="ltx_Math" alttext="f^{-1}(y)" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f^{-1}(y)</annotation></semantics></math> has a smooth <math id="S3.Thmthm20.p1.m10" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-action.</span></p>
</div>
</div>
<div id="S3.SS4.SSS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS4.SSS2.p6" class="ltx_para">
<p id="S3.SS4.SSS2.p6.1" class="ltx_p"><span id="S3.SS4.SSS2.p6.1.1" class="ltx_text">By Definition <a href="#S3.Thmthm19" title="Definition 3.19. ‣ 3.4.2. Stratified smooth manifolds with corners ‣ 3.4. Derived orbifold charts with stratifications ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.19</span></a>, the subsets <math id="S3.SS4.SSS2.p6.m1" class="ltx_Math" alttext="f^{-1}(y)\cap M_{\alpha}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>f</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∩</mo><msub><mi>M</mi><mi>α</mi></msub></mrow><annotation encoding="application/x-tex">f^{-1}(y)\cap M_{\alpha}</annotation></semantics></math> are smooth manifolds. Using the collars near each stratum, we see that <math id="S3.SS4.SSS2.p6.m2" class="ltx_Math" alttext="f^{-1}(y)" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f^{-1}(y)</annotation></semantics></math> is a smooth manifold with corners. We now verify that <math id="S3.SS4.SSS2.p6.m3" class="ltx_Math" alttext="f^{-1}(y)" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f^{-1}(y)</annotation></semantics></math> is a manifold with faces, namely, each <math id="S3.SS4.SSS2.p6.m4" class="ltx_Math" alttext="x\in f^{-1}(y)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><msup><mi>f</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x\in f^{-1}(y)</annotation></semantics></math> is contained in exactly <math id="S3.SS4.SSS2.p6.m5" class="ltx_Math" alttext="{\rm depth}(x)" display="inline" intent=":literal"><semantics><mrow><mi>depth</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\rm depth}(x)</annotation></semantics></math> connected faces. Indeed, viewing <math id="S3.SS4.SSS2.p6.m6" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> as a point in <math id="S3.SS4.SSS2.p6.m7" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, by definition, <math id="S3.SS4.SSS2.p6.m8" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> is contained in exactly <math id="S3.SS4.SSS2.p6.m9" class="ltx_Math" alttext="{\rm depth}(x)" display="inline" intent=":literal"><semantics><mrow><mi>depth</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\rm depth}(x)</annotation></semantics></math> connected faces of <math id="S3.SS4.SSS2.p6.m10" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>. The implicit function theorem implies that <math id="S3.SS4.SSS2.p6.m11" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> is contained locally in exactly <math id="S3.SS4.SSS2.p6.m12" class="ltx_Math" alttext="{\rm depth}(x)" display="inline" intent=":literal"><semantics><mrow><mi>depth</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\rm depth}(x)</annotation></semantics></math> faces and these faces are still disconnected globally in <math id="S3.SS4.SSS2.p6.m13" class="ltx_Math" alttext="f^{-1}(y)" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f^{-1}(y)</annotation></semantics></math>. Hence <math id="S3.SS4.SSS2.p6.m14" class="ltx_Math" alttext="f^{-1}(y)" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f^{-1}(y)</annotation></semantics></math> is a smooth manifold with faces.</span></p>
</div>
<div id="S3.SS4.SSS2.p7" class="ltx_para">
<p id="S3.SS4.SSS2.p7.1" class="ltx_p"><span id="S3.SS4.SSS2.p7.1.1" class="ltx_text">Next, we see that the decomposition</span></p>
<table id="S3.Ex56" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex56.m1" class="ltx_Math" alttext="f^{-1}(y)=\bigsqcup_{\alpha\in{\mathbb{A}}}f^{-1}(y)\cap M_{\alpha}" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>f</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><munder><mo movablelimits="false">⨆</mo><mrow><mi>α</mi><mo>∈</mo><mi>𝔸</mi></mrow></munder><mrow><msup><mi>f</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>∩</mo><msub><mi>M</mi><mi>α</mi></msub></mrow></mrow><annotation encoding="application/x-tex">f^{-1}(y)=\bigsqcup_{\alpha\in{\mathbb{A}}}f^{-1}(y)\cap M_{\alpha}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS4.SSS2.p7.2" class="ltx_p"><span id="S3.SS4.SSS2.p7.2.1" class="ltx_text">induces an <math id="S3.SS4.SSS2.p7.m1" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-space structure on <math id="S3.SS4.SSS2.p7.m2" class="ltx_Math" alttext="f^{-1}(y)" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f^{-1}(y)</annotation></semantics></math>. Conditions of Definition <a href="#S3.Thmthm15" title="Definition 3.15. ‣ 3.4.1. Stratified topological manifolds corners ‣ 3.4. Derived orbifold charts with stratifications ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.15</span></a> can then be verified using the implicit function theorem. Transversality implies that <math id="S3.SS4.SSS2.p7.m3" class="ltx_Math" alttext="f^{-1}(y)" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f^{-1}(y)</annotation></semantics></math> has smooth corner charts. Hence <math id="S3.SS4.SSS2.p7.m4" class="ltx_Math" alttext="f^{-1}(y)" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f^{-1}(y)</annotation></semantics></math> is a smooth <math id="S3.SS4.SSS2.p7.m5" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-manifold. The equivariant case follows immediately from the definition.
∎</span></p>
</div>
</div>
</section>
<section id="S3.SS4.SSS3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">3.4.3. </span>Stratified smooth orbifolds with corners and derived orbifold charts</h4>

<div id="S3.SS4.SSS3.p1" class="ltx_para">
<p id="S3.SS4.SSS3.p1.1" class="ltx_p">Smooth orbifolds with corners can be defined as in Section <a href="#S2.SS1" title="2.1. Orbifolds and the canonical Whitney stratification on 𝒵_𝑑 ‣ 2. Recap of the FOP natural transformation and multiplicativity ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.1</span></a>, with the modification that for an <math id="S3.SS4.SSS3.p1.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-dimensional orbifold with corners <math id="S3.SS4.SSS3.p1.m2" class="ltx_Math" alttext="{\mathcal{U}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒰</mi><annotation encoding="application/x-tex">{\mathcal{U}}</annotation></semantics></math>, each local chart <math id="S3.SS4.SSS3.p1.m3" class="ltx_Math" alttext="C=(U,{\mathit{\Gamma}},\psi)" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mi>Γ</mi><mo>,</mo><mi>ψ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C=(U,{\mathit{\Gamma}},\psi)</annotation></semantics></math> has the following property: consider <math id="S3.SS4.SSS3.p1.m4" class="ltx_Math" alttext="{\mathbb{R}}^{n-k}\times{\mathbb{R}}_{\geq 0}^{k}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℝ</mi><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>ℝ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow><mi>k</mi></msubsup></mrow><annotation encoding="application/x-tex">{\mathbb{R}}^{n-k}\times{\mathbb{R}}_{\geq 0}^{k}</annotation></semantics></math> where <math id="S3.SS4.SSS3.p1.m5" class="ltx_Math" alttext="{\mathit{\Gamma}}" display="inline" intent=":literal"><semantics><mi>Γ</mi><annotation encoding="application/x-tex">{\mathit{\Gamma}}</annotation></semantics></math> acts linearly on the first factor and trivially on the second factor. Then <math id="S3.SS4.SSS3.p1.m6" class="ltx_Math" alttext="U\subset{\mathbb{R}}^{n-k}\times{\mathbb{R}}_{\geq 0}^{k}" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⊂</mo><mrow><msup><mi>ℝ</mi><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>ℝ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow><mi>k</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">U\subset{\mathbb{R}}^{n-k}\times{\mathbb{R}}_{\geq 0}^{k}</annotation></semantics></math> is a <math id="S3.SS4.SSS3.p1.m7" class="ltx_Math" alttext="{\mathit{\Gamma}}" display="inline" intent=":literal"><semantics><mi>Γ</mi><annotation encoding="application/x-tex">{\mathit{\Gamma}}</annotation></semantics></math>-invariant open subset and <math id="S3.SS4.SSS3.p1.m8" class="ltx_Math" alttext="\psi:U/{\mathit{\Gamma}}\to{\mathcal{U}}" display="inline" intent=":literal"><semantics><mrow><mi>ψ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>U</mi><mo>/</mo><mi>Γ</mi></mrow><mo stretchy="false">→</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow></mrow><annotation encoding="application/x-tex">\psi:U/{\mathit{\Gamma}}\to{\mathcal{U}}</annotation></semantics></math> is a homeomorphism onto an open subset of <math id="S3.SS4.SSS3.p1.m9" class="ltx_Math" alttext="{\mathcal{U}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒰</mi><annotation encoding="application/x-tex">{\mathcal{U}}</annotation></semantics></math>. Just as the manifold case, one can define the notion of smooth orbifold with faces and the notion of smooth <math id="S3.SS4.SSS3.p1.m10" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-orbifolds for any homogeneous poset <math id="S3.SS4.SSS3.p1.m11" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>. We omit the discussions of bundles, sections, and embeddings in the stratified sense. Note that if <math id="S3.SS4.SSS3.p1.m12" class="ltx_Math" alttext="\alpha\in{\mathbb{A}}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mi>𝔸</mi></mrow><annotation encoding="application/x-tex">\alpha\in{\mathbb{A}}</annotation></semantics></math> and <math id="S3.SS4.SSS3.p1.m13" class="ltx_Math" alttext="{\mathcal{U}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒰</mi><annotation encoding="application/x-tex">{\mathcal{U}}</annotation></semantics></math> is an <math id="S3.SS4.SSS3.p1.m14" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-orbifold, the <math id="S3.SS4.SSS3.p1.m15" class="ltx_Math" alttext="\partial^{\alpha}{\mathbb{A}}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mi>α</mi></msup><mi>𝔸</mi></mrow><annotation encoding="application/x-tex">\partial^{\alpha}{\mathbb{A}}</annotation></semantics></math>-space <math id="S3.SS4.SSS3.p1.m16" class="ltx_Math" alttext="\partial^{\alpha}{\mathcal{U}}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mi>α</mi></msup><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow><annotation encoding="application/x-tex">\partial^{\alpha}{\mathcal{U}}</annotation></semantics></math> is naturally a <math id="S3.SS4.SSS3.p1.m17" class="ltx_Math" alttext="\partial^{\alpha}{\mathbb{A}}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mi>α</mi></msup><mi>𝔸</mi></mrow><annotation encoding="application/x-tex">\partial^{\alpha}{\mathbb{A}}</annotation></semantics></math>-orbifold.</p>
</div>
<div id="S3.SS4.SSS3.p2" class="ltx_para">
<p id="S3.SS4.SSS3.p2.1" class="ltx_p">Now we can generalize the definition of derived orbifold charts (see Definition <a href="#S2.Thmthm1" title="Definition 2.1. ‣ 2.1.1. Derived orbifold charts ‣ 2.1. Orbifolds and the canonical Whitney stratification on 𝒵_𝑑 ‣ 2. Recap of the FOP natural transformation and multiplicativity ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.1</span></a>) to the case when the domains have corners or faces.</p>
</div>
<div id="S3.Thmthm21" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm21.2" class="ltx_text ltx_font_bold">Definition 3.21</span></span><span id="S3.Thmthm21.3" class="ltx_text ltx_font_bold"> </span>(Stratified derived orbifold charts)<span id="S3.Thmthm21.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm21.p1" class="ltx_para">
<ol id="S3.I10" class="ltx_enumerate">
<li id="S3.I10.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S3.I10.i1.p1" class="ltx_para">
<p id="S3.I10.i1.p1.1" class="ltx_p">An <math id="S3.I10.i1.p1.m1" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-stratified derived orbifold chart is a triple <math id="S3.I10.i1.p1.m2" class="ltx_Math" alttext="({\mathcal{U}},{\mathcal{E}},{\mathcal{S}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathcal{U}},{\mathcal{E}},{\mathcal{S}})</annotation></semantics></math>, where <math id="S3.I10.i1.p1.m3" class="ltx_Math" alttext="{\mathcal{U}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒰</mi><annotation encoding="application/x-tex">{\mathcal{U}}</annotation></semantics></math> is a smooth <math id="S3.I10.i1.p1.m4" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-orbifold, <math id="S3.I10.i1.p1.m5" class="ltx_Math" alttext="{\mathcal{E}}\to{\mathcal{U}}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">→</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow><annotation encoding="application/x-tex">{\mathcal{E}}\to{\mathcal{U}}</annotation></semantics></math> is an orbifold vector bundle, and <math id="S3.I10.i1.p1.m6" class="ltx_Math" alttext="{\mathcal{S}}:{\mathcal{U}}\to{\mathcal{E}}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo stretchy="false">→</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{S}}:{\mathcal{U}}\to{\mathcal{E}}</annotation></semantics></math> is a continuous section. We say that <math id="S3.I10.i1.p1.m7" class="ltx_Math" alttext="({\mathcal{U}},{\mathcal{E}},{\mathcal{S}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathcal{U}},{\mathcal{E}},{\mathcal{S}})</annotation></semantics></math> is compact if <math id="S3.I10.i1.p1.m8" class="ltx_Math" alttext="{\mathcal{S}}^{-1}(0)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{S}}^{-1}(0)</annotation></semantics></math> is compact.</p>
</div></li>
<li id="S3.I10.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S3.I10.i2.p1" class="ltx_para">
<p id="S3.I10.i2.p1.1" class="ltx_p">Given <math id="S3.I10.i2.p1.m1" class="ltx_Math" alttext="{\mathbb{A}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝔸</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{\mathbb{A}}_{i}</annotation></semantics></math>-stratified derived orbifold charts <math id="S3.I10.i2.p1.m2" class="ltx_Math" alttext="C_{i}=({\mathcal{U}}_{i},{\mathcal{E}}_{i},{\mathcal{S}}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>i</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>i</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>i</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{i}=({\mathcal{U}}_{i},{\mathcal{E}}_{i},{\mathcal{S}}_{i})</annotation></semantics></math>, <math id="S3.I10.i2.p1.m3" class="ltx_Math" alttext="i=1,2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">i=1,2</annotation></semantics></math>, a chart embedding <math id="S3.I10.i2.p1.m4" class="ltx_Math" alttext="{\bm{\iota}}_{21}:C_{1}\hookrightarrow C_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝜾</mi><mn>21</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>C</mi><mn>1</mn></msub><mo stretchy="false">↪</mo><msub><mi>C</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">{\bm{\iota}}_{21}:C_{1}\hookrightarrow C_{2}</annotation></semantics></math> consists of a smooth stratified embedding</p>
<table id="S3.Ex57" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S3.Ex57.m1.pic1" class="ltx_picture ltx_markedasmath" height="66.90" overflow="visible" style="vertical-align:-53.041805712302825px" version="1.1" viewBox="12.44 53.04 82.98 66.90" width="82.98"><g transform="matrix(1 0 0 -1 12.443714556199842 66.89801921451242) translate(0,3.46) translate(12.44,0)"><g transform="translate(-12.44,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.2em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="16.59"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex57.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{{\mathcal{U}}_{1}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\textstyle{{\mathcal{U}}_{1}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 12.443714556199842 -0.27673578005007266 L 12.443714556199842 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(17.8,0) translate(0,6.93) translate(4.15,0) translate(0,-1.39)"><foreignObject style="--ltx-fo-width:1.03em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.1em;font-size:10pt;" height="5.55" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="14.2"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex57.m1.pic1.m2" class="ltx_Math" alttext="\scriptstyle{\iota_{21}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">ι</mi><mn mathsize="0.710em">21</mn></msub><annotation encoding="application/x-tex">\scriptstyle{\iota_{21}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(45.65,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 12.443714556199842 -0.27673578005007266 L 45.65251488828785 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 45.65251488828785 -0.27673578005007266 L 45.65251488828785 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -9.685900096859001 L 0.27673578005007266 -9.685900096859001" fill="none" stroke="#000000"></path><g transform="translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.208800332088 L 0.27673578005007266 -9.685900096859001" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.208800332088 L 0.27673578005007266 -33.208800332088" fill="none" stroke="#000000"></path><g transform="translate(45.65,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.2em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="16.59"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex57.m1.pic1.m3" class="ltx_Math" alttext="\textstyle{{\mathcal{U}}_{2}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\textstyle{{\mathcal{U}}_{2}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 57.819493664437616 -9.685900096859001 L 58.37296522453776 -9.685900096859001" fill="none" stroke="#000000"></path><g transform="translate(58.1,0) translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 57.819493664437616 -33.208800332088 L 58.37296522453776 -9.685900096859001" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 57.819493664437616 -33.208800332088 L 58.37296522453776 -33.208800332088" fill="none" stroke="#000000"></path><g transform="translate(-12.44,0) translate(0,-43.36) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.2em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="16.59"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex57.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{{\mathbb{A}}_{1}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mi>𝔸</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\textstyle{{\mathbb{A}}_{1}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 12.443714556199842 -43.63264139549389 L 12.443714556199842 -43.07916983539375" fill="none" stroke="#000000"></path><g transform="translate(45.65,0) translate(0,-43.36)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 12.443714556199842 -43.63264139549389 L 45.65251488828785 -43.07916983539375" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 45.65251488828785 -43.63264139549389 L 45.65251488828785 -43.07916983539375" fill="none" stroke="#000000"></path><g transform="translate(45.65,0) translate(0,-43.36) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.2em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="16.59"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex57.m1.pic1.m5" class="ltx_Math" alttext="\textstyle{{\mathbb{A}}_{2}}" display="inline" intent=":literal"><semantics><msub><mi>𝔸</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\textstyle{{\mathbb{A}}_{2}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I10.i2.p1.2" class="ltx_p">and a bundle embedding <math id="S3.I10.i2.p1.m5" class="ltx_Math" alttext="\widehat{\iota}_{21}:{\mathcal{E}}_{1}\to{\mathcal{E}}_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ι</mi><mo>^</mo></mover><mn>21</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mn>1</mn></msub><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\widehat{\iota}_{21}:{\mathcal{E}}_{1}\to{\mathcal{E}}_{2}</annotation></semantics></math> covering <math id="S3.I10.i2.p1.m6" class="ltx_Math" alttext="\iota_{21}" display="inline" intent=":literal"><semantics><msub><mi>ι</mi><mn>21</mn></msub><annotation encoding="application/x-tex">\iota_{21}</annotation></semantics></math> which intertwines with the sections <math id="S3.I10.i2.p1.m7" class="ltx_Math" alttext="{\mathcal{S}}_{1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\mathcal{S}}_{1}</annotation></semantics></math> and <math id="S3.I10.i2.p1.m8" class="ltx_Math" alttext="{\mathcal{S}}_{2}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mn>2</mn></msub><annotation encoding="application/x-tex">{\mathcal{S}}_{2}</annotation></semantics></math>.</p>
</div></li>
<li id="S3.I10.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S3.I10.i3.p1" class="ltx_para">
<p id="S3.I10.i3.p1.1" class="ltx_p">Given an <math id="S3.I10.i3.p1.m1" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-space <math id="S3.I10.i3.p1.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>, a <span id="S3.I10.i3.p1.1.1" class="ltx_text ltx_font_bold">derived orbifold presentation</span> (or called a <span id="S3.I10.i3.p1.1.2" class="ltx_text ltx_font_bold">D-chart presentation</span>) of <math id="S3.I10.i3.p1.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is a quadruple <math id="S3.I10.i3.p1.m4" class="ltx_Math" alttext="({\mathcal{U}},{\mathcal{E}},{\mathcal{S}},\psi)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>,</mo><mi>ψ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathcal{U}},{\mathcal{E}},{\mathcal{S}},\psi)</annotation></semantics></math> consisting of an <math id="S3.I10.i3.p1.m5" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-stratified derived orbifold chart <math id="S3.I10.i3.p1.m6" class="ltx_Math" alttext="({\mathcal{U}},{\mathcal{E}},{\mathcal{S}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathcal{U}},{\mathcal{E}},{\mathcal{S}})</annotation></semantics></math> with a homeomorphism of <math id="S3.I10.i3.p1.m7" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-spaces <math id="S3.I10.i3.p1.m8" class="ltx_Math" alttext="\psi:{\mathcal{S}}^{-1}(0)\to X" display="inline" intent=":literal"><semantics><mrow><mi>ψ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">\psi:{\mathcal{S}}^{-1}(0)\to X</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
</div>
<div id="S3.SS4.SSS3.p3" class="ltx_para">
<p id="S3.SS4.SSS3.p3.1" class="ltx_p">The following set of notations are frequently used. If <math id="S3.SS4.SSS3.p3.m1" class="ltx_Math" alttext="({\mathcal{U}},{\mathcal{E}},{\mathcal{S}},\psi)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>,</mo><mi>ψ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathcal{U}},{\mathcal{E}},{\mathcal{S}},\psi)</annotation></semantics></math> is a derived orbifold presentation of the <math id="S3.SS4.SSS3.p3.m2" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-space <math id="S3.SS4.SSS3.p3.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>, for any stratum <math id="S3.SS4.SSS3.p3.m4" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>, the datum <math id="S3.SS4.SSS3.p3.m5" class="ltx_Math" alttext="(\partial^{\alpha}{\mathcal{U}},{\mathcal{E}}|_{\partial^{\alpha}{\mathcal{U}}},{\mathcal{S}}|_{\partial^{\alpha}{\mathcal{U}}},\psi|_{{\mathcal{S}}^{-1}(0)\cap\partial^{\alpha}{\mathcal{U}}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">∂</mo><mi>α</mi></msup><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow><mo>,</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">|</mo></mrow><mrow><msup><mo>∂</mo><mi>α</mi></msup><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow></msub><mo>,</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">|</mo></mrow><mrow><msup><mo>∂</mo><mi>α</mi></msup><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow></msub><mo>,</mo><msub><mrow><mi>ψ</mi><mo stretchy="false">|</mo></mrow><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">∩</mo><mrow><msup><mo>∂</mo><mi>α</mi></msup><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\partial^{\alpha}{\mathcal{U}},{\mathcal{E}}|_{\partial^{\alpha}{\mathcal{U}}},{\mathcal{S}}|_{\partial^{\alpha}{\mathcal{U}}},\psi|_{{\mathcal{S}}^{-1}(0)\cap\partial^{\alpha}{\mathcal{U}}})</annotation></semantics></math> is a derived orbifold presentation of <math id="S3.SS4.SSS3.p3.m6" class="ltx_Math" alttext="\partial^{\alpha}X" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mi>α</mi></msup><mi>X</mi></mrow><annotation encoding="application/x-tex">\partial^{\alpha}X</annotation></semantics></math>. In practice, we might have a derived orbifold presentation of the boundary stratum <math id="S3.SS4.SSS3.p3.m7" class="ltx_Math" alttext="\partial^{\alpha}X" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mi>α</mi></msup><mi>X</mi></mrow><annotation encoding="application/x-tex">\partial^{\alpha}X</annotation></semantics></math> different from the restriction of a derived orbifold presentation of <math id="S3.SS4.SSS3.p3.m8" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. To carry out our construction of perturbations, we would like to relate the possibly different derived orbifold presentations of the boundary strata. This motivates the following definition, which should be thought of as a special case of the <em id="S3.SS4.SSS3.p3.1.1" class="ltx_emph ltx_font_italic">Kuranishi diagram</em> from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx2" title="" class="ltx_ref">Abo22</a>, Definition 6.6]</cite>. Some notions appear in the following were defined in Definition <a href="#S2.Thmthm3" title="Definition 2.3. ‣ 2.1.1. Derived orbifold charts ‣ 2.1. Orbifolds and the canonical Whitney stratification on 𝒵_𝑑 ‣ 2. Recap of the FOP natural transformation and multiplicativity ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.3</span></a>.</p>
</div>
<div id="S3.Thmthm22" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm22.2" class="ltx_text ltx_font_bold">Definition 3.22</span></span><span id="S3.Thmthm22.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm22.p1" class="ltx_para">
<p id="S3.Thmthm22.p1.1" class="ltx_p">A <span id="S3.Thmthm22.p1.1.1" class="ltx_text ltx_font_bold">system of D-chart presentation</span> of an <math id="S3.Thmthm22.p1.m1" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-space <math id="S3.Thmthm22.p1.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> consists of the following objects.</p>
<ol id="S3.I11" class="ltx_enumerate">
<li id="S3.I11.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S3.I11.i1.p1" class="ltx_para">
<p id="S3.I11.i1.p1.1" class="ltx_p">A collection of derived orbifold presentations</p>
<table id="S3.Ex58" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex58.m1" class="ltx_math_unparsed" alttext="\big\{C_{\alpha}=({\mathcal{U}}_{\alpha},{\mathcal{E}}_{\alpha},{\mathcal{S}}_{\alpha},\psi_{\alpha})\big\}_{\alpha\in{\mathbb{A}}}" display="block" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mi>C</mi><mi>α</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>α</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>α</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>α</mi></msub><mo>,</mo><msub><mi>ψ</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>α</mi><mo>∈</mo><mi>𝔸</mi></mrow></msub><annotation encoding="application/x-tex">\big\{C_{\alpha}=({\mathcal{U}}_{\alpha},{\mathcal{E}}_{\alpha},{\mathcal{S}}_{\alpha},\psi_{\alpha})\big\}_{\alpha\in{\mathbb{A}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I11.i1.p1.2" class="ltx_p">of the collection of boundary strata <math id="S3.I11.i1.p1.m1" class="ltx_Math" alttext="\{\partial^{\alpha}X\}_{\alpha\in{\mathbb{A}}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><mrow><msup><mo lspace="0em">∂</mo><mi>α</mi></msup><mi>X</mi></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>α</mi><mo>∈</mo><mi>𝔸</mi></mrow></msub><annotation encoding="application/x-tex">\{\partial^{\alpha}X\}_{\alpha\in{\mathbb{A}}}</annotation></semantics></math> as stratified spaces.</p>
</div></li>
<li id="S3.I11.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S3.I11.i2.p1" class="ltx_para">
<p id="S3.I11.i2.p1.1" class="ltx_p">A collection of chart embeddings</p>
<table id="S3.Ex59" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex59.m1" class="ltx_Math" alttext="\big\{{\bm{\iota}}_{\beta\alpha}:C_{\alpha}\to\partial^{\alpha}C_{\beta}\big\}_{\alpha\leq\beta}." display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">{</mo><msub><mi>𝜾</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>C</mi><mi>α</mi></msub><mo rspace="0.111em" stretchy="false">→</mo><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi>C</mi><mi>β</mi></msub></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\big\{{\bm{\iota}}_{\beta\alpha}:C_{\alpha}\to\partial^{\alpha}C_{\beta}\big\}_{\alpha\leq\beta}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
<p id="S3.Thmthm22.p1.2" class="ltx_p">These objects need to satisfy the following conditions.</p>
</div>
<div id="S3.Thmthm22.p2" class="ltx_para">
<ol id="S3.I12" class="ltx_enumerate">
<li id="S3.I12.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(A)</span> 
<div id="S3.I12.ix1.p1" class="ltx_para">
<p id="S3.I12.ix1.p1.1" class="ltx_p">The collection of chart embeddings satisfy the cocycle condition. More precisely, for any triple of strata <math id="S3.I12.ix1.p1.m1" class="ltx_Math" alttext="\alpha\leq\beta\leq\gamma" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>≤</mo><mi>β</mi><mo>≤</mo><mi>γ</mi></mrow><annotation encoding="application/x-tex">\alpha\leq\beta\leq\gamma</annotation></semantics></math>, there holds</p>
<table id="S3.Ex60" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex60.m1" class="ltx_Math" alttext="\iota_{\gamma\beta}\circ\iota_{\beta\alpha}=\iota_{\gamma\alpha}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ι</mi><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>ι</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub></mrow><mo>=</mo><msub><mi>ι</mi><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\iota_{\gamma\beta}\circ\iota_{\beta\alpha}=\iota_{\gamma\alpha}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S3.I12.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(B)</span> 
<div id="S3.I12.ix2.p1" class="ltx_para">
<p id="S3.I12.ix2.p1.1" class="ltx_p">Adjacent strata differ by a stabilization. More precisely, for any pair of strata <math id="S3.I12.ix2.p1.m1" class="ltx_Math" alttext="\alpha\leq\beta" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">\alpha\leq\beta</annotation></semantics></math>, there exist an orbifold vector bundle <math id="S3.I12.ix2.p1.m2" class="ltx_Math" alttext="{\mathcal{F}}_{\beta\alpha}\to{\mathcal{U}}_{\alpha}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>α</mi></msub></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{\beta\alpha}\to{\mathcal{U}}_{\alpha}</annotation></semantics></math> and a germ equivalence</p>
<table id="S3.Ex61" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex61.m1" class="ltx_Math" alttext="{\rm Stab}_{{\mathcal{F}}_{\beta\alpha}}(C_{\alpha})\simeq\partial^{\alpha}C_{\beta}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>Stab</mi><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">≃</mo><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi>C</mi><mi>β</mi></msub></mrow></mrow><annotation encoding="application/x-tex">{\rm Stab}_{{\mathcal{F}}_{\beta\alpha}}(C_{\alpha})\simeq\partial^{\alpha}C_{\beta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
</div>
</div>
<div id="S3.SS4.SSS3.p4" class="ltx_para">
<p id="S3.SS4.SSS3.p4.1" class="ltx_p">In certain special cases the chart embeddings between different strata are open. For example in the case of Morse flow category and the pearly bimodule. We introduce the following notion.</p>
</div>
<div id="S3.Thmthm23" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm23.2" class="ltx_text ltx_font_bold">Definition 3.23</span></span><span id="S3.Thmthm23.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm23.p1" class="ltx_para">
<p id="S3.Thmthm23.p1.1" class="ltx_p">A system of derived orbifold presentations of an <math id="S3.Thmthm23.p1.m1" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-space <math id="S3.Thmthm23.p1.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is called <span id="S3.Thmthm23.p1.1.1" class="ltx_text ltx_font_bold">single-layered</span> if all chart embeddings <math id="S3.Thmthm23.p1.m3" class="ltx_Math" alttext="{\bm{\iota}}_{\beta\alpha}:C_{\alpha}\to\partial^{\alpha}C_{\beta}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝜾</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>C</mi><mi>α</mi></msub><mo rspace="0.111em" stretchy="false">→</mo><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi>C</mi><mi>β</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{\iota}}_{\beta\alpha}:C_{\alpha}\to\partial^{\alpha}C_{\beta}</annotation></semantics></math> are open embeddings, or equivalently, one can take <math id="S3.Thmthm23.p1.m4" class="ltx_Math" alttext="{\mathcal{F}}_{\beta\alpha}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{\beta\alpha}=0</annotation></semantics></math> for all <math id="S3.Thmthm23.p1.m5" class="ltx_Math" alttext="\alpha\leq\beta" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">\alpha\leq\beta</annotation></semantics></math>.</p>
</div>
</div>
</section>
<section id="S3.SS4.SSS4" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">3.4.4. </span>Derived orbifold lifts of flow categories and bimodules</h4>

<div id="S3.SS4.SSS4.p1" class="ltx_para">
<p id="S3.SS4.SSS4.p1.1" class="ltx_p">Now we can go back to the setup in Section <a href="#S3.SS2" title="3.2. Topological flow categories and bimodules ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a>. The following definition imposes certain regular structures on morphism spaces of flow categories and flow bimodules.</p>
</div>
<div id="S3.Thmthm24" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm24.2" class="ltx_text ltx_font_bold">Definition 3.24</span></span><span id="S3.Thmthm24.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm24.p1" class="ltx_para">
<p id="S3.Thmthm24.p1.1" class="ltx_p">Let <math id="S3.Thmthm24.p1.m1" class="ltx_Math" alttext="T^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">T^{\mathcal{P}}</annotation></semantics></math> be a flow category over the poset <math id="S3.Thmthm24.p1.m2" class="ltx_Math" alttext="{\mathcal{P}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">{\mathcal{P}}</annotation></semantics></math>. A <span id="S3.Thmthm24.p1.1.1" class="ltx_text ltx_font_bold">derived orbifold lift</span> of <math id="S3.Thmthm24.p1.m3" class="ltx_Math" alttext="T^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">T^{\mathcal{P}}</annotation></semantics></math>, denoted by <math id="S3.Thmthm24.p1.m4" class="ltx_Math" alttext="{\mathfrak{D}}^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\mathcal{P}}</annotation></semantics></math>, consists of the following objects.</p>
<ol id="S3.I13" class="ltx_enumerate">
<li id="S3.I13.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S3.I13.i1.p1" class="ltx_para">
<p id="S3.I13.i1.p1.1" class="ltx_p">A collection</p>
<table id="S3.Ex62" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex62.m1" class="ltx_math_unparsed" alttext="\big\{C_{pq}=({\mathcal{U}}_{pq},{\mathcal{E}}_{pq},{\mathcal{S}}_{pq},\psi_{pq})\big\}_{p\leq q}" display="block" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mi>C</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi>ψ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>p</mi><mo>≤</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\big\{C_{pq}=({\mathcal{U}}_{pq},{\mathcal{E}}_{pq},{\mathcal{S}}_{pq},\psi_{pq})\big\}_{p\leq q}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I13.i1.p1.2" class="ltx_p">of derived orbifold presentations of the <math id="S3.I13.i1.p1.m1" class="ltx_Math" alttext="{\mathbb{A}}^{\mathcal{P}}_{pq}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><annotation encoding="application/x-tex">{\mathbb{A}}^{\mathcal{P}}_{pq}</annotation></semantics></math>-space <math id="S3.I13.i1.p1.m2" class="ltx_Math" alttext="T_{pq}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">T_{pq}</annotation></semantics></math> such that for each connected component <math id="S3.I13.i1.p1.m3" class="ltx_Math" alttext="{\mathcal{U}}_{pq,j}\subset{\mathcal{U}}_{pq}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>j</mi></mrow></msub><mo>⊂</mo><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">{\mathcal{U}}_{pq,j}\subset{\mathcal{U}}_{pq}</annotation></semantics></math>, one has</p>
<table id="S3.E5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E5.m1" class="ltx_Math" alttext="{\rm dim}_{\mathbb{R}}{\mathcal{U}}_{pq,j}-{\rm rank}_{\mathbb{R}}{\mathcal{E}}_{pq}|_{{\mathcal{U}}_{pq,j}}\equiv{\rm ind}^{\mathcal{P}}(p)-{\rm ind}^{\mathcal{P}}(q)-1\ {\rm mod}\ 2N." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>dim</mi><mi>ℝ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>j</mi></mrow></msub></mrow><mo>−</mo><msub><mrow><mrow><msub><mi>rank</mi><mi>ℝ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo stretchy="false">|</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>j</mi></mrow></msub></msub></mrow><mo>≡</mo><mrow><mrow><msup><mi>ind</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>ind</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mn>1</mn><mo lspace="0.500em" rspace="0em">​</mo><mi>mod</mi><mo lspace="0em" rspace="0em">​</mo><mn> 2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\rm dim}_{\mathbb{R}}{\mathcal{U}}_{pq,j}-{\rm rank}_{\mathbb{R}}{\mathcal{E}}_{pq}|_{{\mathcal{U}}_{pq,j}}\equiv{\rm ind}^{\mathcal{P}}(p)-{\rm ind}^{\mathcal{P}}(q)-1\ {\rm mod}\ 2N.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.5)</span></td></tr></tbody>
</table>
</div></li>
<li id="S3.I13.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S3.I13.i2.p1" class="ltx_para">
<p id="S3.I13.i2.p1.1" class="ltx_p">A collection of chart embeddings</p>
<table id="S3.Ex63" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex63.m1" class="ltx_Math" alttext="\big\{{\bm{\iota}}_{prq}:C_{pr}\times C_{rq}\hookrightarrow\partial^{prq}C_{pq}\big\}_{p\leq r\leq q}" display="block" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mi>𝜾</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>C</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>C</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo rspace="0.111em" stretchy="false">↪</mo><mrow><msup><mo>∂</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msup><msub><mi>C</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>p</mi><mo>≤</mo><mi>r</mi><mo>≤</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\big\{{\bm{\iota}}_{prq}:C_{pr}\times C_{rq}\hookrightarrow\partial^{prq}C_{pq}\big\}_{p\leq r\leq q}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I13.i2.p1.2" class="ltx_p">(with the underlying poset identification <math id="S3.I13.i2.p1.m1" class="ltx_Math" alttext="{\mathbb{A}}^{\mathcal{P}}_{pr}\times{\mathbb{A}}^{\mathcal{P}}_{rq}\cong\partial^{prq}{\mathbb{A}}^{\mathcal{P}}_{pq}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>𝔸</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup></mrow><mo rspace="0.111em">≅</mo><mrow><msup><mo>∂</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msup><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{A}}^{\mathcal{P}}_{pr}\times{\mathbb{A}}^{\mathcal{P}}_{rq}\cong\partial^{prq}{\mathbb{A}}^{\mathcal{P}}_{pq}</annotation></semantics></math>). In particular, if <math id="S3.I13.i2.p1.m2" class="ltx_Math" alttext="\iota_{prq}:{\mathcal{U}}_{pr}\times{\mathcal{U}}_{rq}\hookrightarrow{\mathcal{U}}_{pq}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ι</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo stretchy="false">↪</mo><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\iota_{prq}:{\mathcal{U}}_{pr}\times{\mathcal{U}}_{rq}\hookrightarrow{\mathcal{U}}_{pq}</annotation></semantics></math> is the associated domain embedding and <math id="S3.I13.i2.p1.m3" class="ltx_Math" alttext="\widehat{\iota}_{prq}:{\mathcal{E}}_{pr}\boxplus{\mathcal{E}}_{rq}\hookrightarrow{\mathcal{E}}_{pq}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ι</mi><mo>^</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo>⊞</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo stretchy="false">↪</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\widehat{\iota}_{prq}:{\mathcal{E}}_{pr}\boxplus{\mathcal{E}}_{rq}\hookrightarrow{\mathcal{E}}_{pq}</annotation></semantics></math> is the associated bundle embedding, then the following diagram commutes.</p>
<table id="S3.E6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center">
<span id="S3.E6.2" class="ltx_inline-block ltx_markedasmath ltx_align_bottom"><span class="ltx_inline-block"><svg id="S3.E6.m1.pic1" class="ltx_picture" height="80.27" overflow="visible" style="vertical-align:-58.557371290224594px" version="1.1" viewBox="66.86 58.56 230.06 80.27" width="230.06"><g transform="matrix(1 0 0 -1 66.85509529287957 80.27377193921234) translate(66.86,0)"><g transform="translate(-30.64,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:3.83em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.29em;font-size:10pt;" height="13.41" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="52.97"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.E6.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{{\mathcal{E}}_{pr}\boxplus{\mathcal{E}}_{rq}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo>⊞</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\textstyle{{\mathcal{E}}_{pr}\boxplus{\mathcal{E}}_{rq}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 30.637988909590337 -0.27673578005007266 L 30.637988909590337 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(45.04,0) translate(0,10.86) translate(4.15,0) translate(0,-3.29)"><foreignObject style="--ltx-fo-width:1.68em;--ltx-fo-height:0.72em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.41" overflow="visible" transform="matrix(1 0 0 -1 0 9.99)" width="23.19"><span class="ltx_foreignob