l{P}}\times{\mathbb{A}}_{q_{2}p^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mn>2</mn></msub></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝔸</mi><mrow><msub><mi>q</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub></mrow><annotation encoding="application/x-tex">\textstyle{{\mathbb{A}}_{pq_{2}}^{\mathcal{P}}\times{\mathbb{A}}_{q_{2}p^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 38.11648463714629 -58.28768744811125 L 38.142982188375626 -58.41293324404144" fill="none" stroke="#000000"></path><g transform="translate(115.68,0) translate(0,-84.24)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -5.69 4.82" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -7.44 -0.43" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 38.11648463714629 -58.28768744811125 L 115.67595721907647 -84.24084595959596" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 115.67595721907647 -84.06167606339508 L 115.67595721907647 -84.24084595959596" fill="none" stroke="#000000"></path><g transform="translate(226.88,0) translate(0,-45.54) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:5.04em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.37em;font-size:10pt;" height="16.78" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="69.69"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex27.m1.pic1.m6" class="ltx_Math" alttext="\textstyle{{\mathbb{A}}^{\mathcal{P}}_{pq_{1}}\times{\mathbb{A}}_{q_{1}p^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mn>1</mn></msub></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝔸</mi><mrow><msub><mi>q</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub></mrow><annotation encoding="application/x-tex">\textstyle{{\mathbb{A}}^{\mathcal{P}}_{pq_{1}}\times{\mathbb{A}}_{q_{1}p^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 227.74573495415413 -58.28768744811125 L 227.74573495415413 -58.32448842961939" fill="none" stroke="#000000"></path><g transform="translate(150.2,0) translate(0,-84.22)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 7.44 -0.43" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 5.69 4.82" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 227.74573495415413 -58.28768744811125 L 150.1986982747531 -84.22397620387306" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 150.1986982747531 -84.17465486548923 L 150.1986982747531 -84.22397620387306" fill="none" stroke="#000000"></path><g transform="translate(115.68,0) translate(0,-89.99) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.89em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.37em;font-size:10pt;" height="14.59" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="26.22"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex27.m1.pic1.m8" class="ltx_Math" alttext="\textstyle{{\mathbb{A}}_{pp^{\prime}}}" display="inline" intent=":literal"><semantics><msub><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">\textstyle{{\mathbb{A}}_{pp^{\prime}}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm9.p2.3" class="ltx_p">Similarly, if <math id="S3.Thmthm9.p2.m3" class="ltx_Math" alttext="q^{\prime}&lt;p^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mo>′</mo></msup><mo>&lt;</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">q^{\prime}&lt;p^{\prime}</annotation></semantics></math> in <math id="S3.Thmthm9.p2.m4" class="ltx_Math" alttext="{\mathcal{P}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup><annotation encoding="application/x-tex">{\mathcal{P}}^{\prime}</annotation></semantics></math>, one has</p>
<table id="S3.Ex28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex28.m1" class="ltx_Math" alttext="{\mathbb{A}}_{pq^{\prime}}\times{\mathbb{A}}_{q^{\prime}p^{\prime}}^{{\mathcal{P}}^{\prime}}\cong\partial^{pq^{\prime}p^{\prime}}{\mathbb{A}}_{pp^{\prime}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>′</mo></msup></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>𝔸</mi><mrow><msup><mi>q</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msubsup></mrow><mo rspace="0.111em">≅</mo><mrow><msup><mo>∂</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msup><msub><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\mathbb{A}}_{pq^{\prime}}\times{\mathbb{A}}_{q^{\prime}p^{\prime}}^{{\mathcal{P}}^{\prime}}\cong\partial^{pq^{\prime}p^{\prime}}{\mathbb{A}}_{pp^{\prime}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm9.p2.4" class="ltx_p">which satisfies a similar commutative relation as above, and in this case the poset <math id="S3.Thmthm9.p2.m5" class="ltx_Math" alttext="{\mathbb{A}}^{{\mathcal{P}}^{\prime}}" display="inline" intent=":literal"><semantics><msup><mi>𝔸</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msup><annotation encoding="application/x-tex">{\mathbb{A}}^{{\mathcal{P}}^{\prime}}</annotation></semantics></math> acts on the right. Moreover, these two types of isomorphisms are compatible in the following sense. Namely, the following diagram is commutative for which the arrows are induced by the obvious concatenation of words.</p>
<table id="S3.Ex29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S3.Ex29.m1.pic1" class="ltx_picture ltx_markedasmath" height="118.57" overflow="visible" style="vertical-align:-104.83693858804224px" version="1.1" viewBox="33.60 104.84 315.64 118.57" width="315.64"><g transform="matrix(1 0 0 -1 33.596276874048705 118.56948981331942) translate(0,3.46) translate(33.6,0)"><g transform="translate(66.81,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:7.16em;--ltx-fo-height:0.94em;--ltx-fo-depth:0.37em;font-size:10pt;" height="18.18" overflow="visible" transform="matrix(1 0 0 -1 0 13.04)" width="99.05"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex29.m1.pic1.m2" class="ltx_Math" alttext="\textstyle{{\mathbb{A}}_{pq}^{\mathcal{P}}\times{\mathbb{A}}_{qq^{\prime}}\times{\mathbb{A}}_{q^{\prime}p^{\prime}}^{{\mathcal{P}}^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝔸</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>′</mo></msup></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>𝔸</mi><mrow><msup><mi>q</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msubsup></mrow><annotation encoding="application/x-tex">\textstyle{{\mathbb{A}}_{pq}^{\mathcal{P}}\times{\mathbb{A}}_{qq^{\prime}}\times{\mathbb{A}}_{q^{\prime}p^{\prime}}^{{\mathcal{P}}^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 154.20128534786002 -12.746990114652519 L 154.23939537173965 -12.827263971046078" fill="none" stroke="#000000"></path><g transform="translate(208.37,0) translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -5.49 5.03" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -7.45 -0.14" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 154.20128534786002 -12.746990114652519 L 208.3712322213466 -33.20877921850137" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 208.33310108388034 -33.13122901478397 L 208.3712322213466 -33.20877921850137" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 87.76508361385689 -12.746990114652519 L 87.75655372485558 -12.746990114652519" fill="none" stroke="#000000"></path><g transform="translate(31.65,0) translate(0,-34.61)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 7.45 -0.07" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 5.44 5.09" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 87.76508361385689 -12.746990114652519 L 31.648654074726288 -34.60943344240781" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 31.657162850140963 -34.60943344240781 L 31.648654074726288 -34.60943344240781" fill="none" stroke="#000000"></path><g transform="translate(-33.6,0) translate(0,-46.94) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:4.26em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.37em;font-size:10pt;" height="16.78" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="58.89"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex29.m1.pic1.m4" class="ltx_Math" alttext="\textstyle