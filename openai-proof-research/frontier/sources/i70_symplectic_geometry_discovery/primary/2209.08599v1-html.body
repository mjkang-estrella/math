 -2.88 -3.32"></path></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -16.11 -23.51 L 49.05 -23.51"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 49.32 -23.51)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g></g></g></svg></span></td>
