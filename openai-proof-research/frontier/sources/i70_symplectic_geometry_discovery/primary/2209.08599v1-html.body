<li id="S3.I4.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(5)</span> 
<div id="S3.I4.i5.p1" class="ltx_para">
<p id="S3.I4.i5.p1.1" class="ltx_p"><math id="S3.I4.i5.p1.m1" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math> defines a strict action on <math id="S3.I4.i5.p1.m2" class="ltx_Math" alttext="T^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">T^{\mathcal{P}}</annotation></semantics></math>: for any <math id="S3.I4.i5.p1.m3" class="ltx_Math" alttext="a\in\Pi" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow><annotation encoding="application/x-tex">a\in\Pi</annotation></semantics></math> and <math id="S3.I4.i5.p1.m4" class="ltx_Math" alttext="p,q\in{\mathcal{P}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow><annotation encoding="application/x-tex">p,q\in{\mathcal{P}}</annotation></semantics></math>, there is a stratified homeomorphism</p>
<table id="S3.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S3.Ex21.m1.pic1" class="ltx_picture ltx_markedasmath" height="72.93" overflow="visible" style="vertical-align:-56.01755461290992px" version="1.1" viewBox="15.25 56.02 118.44 72.93" width="118.44"><g transform="matrix(1 0 0 -1 15.247472180062612 72.9294108275607) translate(0,3.46) translate(15.25,0)"><g transform="translate(-15.06,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.58em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.29em;font-size:10pt;" height="13.41" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="21.82"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex21.m1.pic1.m1" class="ltx_Math" alttext="\textstyle{T_{pq}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\textstyle{T_{pq}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 15.062496047536582 -0.27673578005007266 L 15.062496047536582 0.27673578005007266" fill="none" stroke="#000000"></path><g transform="translate(27.41,0) translate(0,8.46) translate(4.15,0) translate(0,-2.42)"><foreignObject style="--ltx-fo-width:0.92em;--ltx-fo-height:0.49em;--ltx-fo-depth:0.14em;font-size:10pt;" height="8.61" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="12.7"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex21.m1.pic1.m2" class="ltx_Math" alttext="\scriptstyle{\phi_{a}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.700em">ϕ</mi><mi mathsize="0.710em">a</mi></msub><annotation encoding="application/x-tex">\scriptstyle{\phi_{a}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(48.64,0)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 15.062496047536582 -0.27673578005007266 L 48.641248644676644 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 48.641248644676644 -0.27673578005007266 L 48.641248644676644 0.27673578005007266" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -11.569253138458645 L 0.27673578005007266 -11.569253138458645" fill="none" stroke="#000000"></path><g transform="translate(0,-32.12)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -32.11640447308055 L 0.27673578005007266 -11.569253138458645" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -32.11640447308055 L 0.27673578005007266 -32.11640447308055" fill="none" stroke="#000000"></path><g transform="translate(48.64,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:3.33em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.29em;font-size:10pt;" height="13.41" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="46.07"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex21.m1.pic1.m3" class="ltx_Math" alttext="\textstyle{T_{a\cdot p\ a\cdot q}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mrow><mrow><mrow><mi>a</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><mo lspace="0.410em" rspace="0em">​</mo><mi>a</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\textstyle{T_{a\cdot p\ a\cdot q}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 75.54996586017495 -11.569253138458645 L 76.1034374202751 -11.569253138458645" fill="none" stroke="#000000"></path><g transform="translate(75.83,0) translate(0,-32.12)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 75.54996586017495 -32.11640447308055 L 76.1034374202751 -11.569253138458645" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 75.54996586017495 -32.11640447308055 L 76.1034374202751 -32.11640447308055" fill="none" stroke="#000000"></path><g transform="translate(-15.25,0) translate(0,-44.45) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.6em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.29em;font-size:10pt;" height="15.6" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="22.19"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex21.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{{\mathbb{A}}_{pq}^{\mathcal{P}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><annotation encoding="application/x-tex">\textstyle{{\mathbb{A}}_{pq}^{\mathcal{P}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 15.247472180062612 -44.72503725450135 L 15.247472180062612 -44.1715656944012" fill="none" stroke="#000000"></path><g transform="translate(48.46,0) translate(0,-44.45)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 15.247472180062612 -44.72503725450135 L 48.45627251215062 -44.1715656944012" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 48.45627251215062 -44.72503725450135 L 48.45627251215062 -44.1715656944012" fill="none" stroke="#000000"></path><g transform="translate(48.46,0) translate(0,-44.45) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:3.36em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.29em;font-size:10pt;" height="15.6" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="46.44"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex21.m1.pic1.m5" class="ltx_Math" alttext="\textstyle{{\mathbb{A}}_{a\cdot p\ a\cdot q}^{\mathcal{P}}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔸</mi><mrow><mrow><mrow><mi>a</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><mo lspace="0.410em" rspace="0em">​</mo><mi>a</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>q</mi></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><annotation encoding="application/x-tex">\textstyle{{\mathbb{A}}_{a\cdot p\ a\cdot q}^{\mathcal{P}}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I4.i5.p1.2" class="ltx_p">where the underlying poset map is the natural isomorphism. Moreover, when <math id="S3.I4.i5.p1.m5" class="ltx_Math" alttext="a_{1},a_{2}\in\Pi" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>a</mi><mn>2</mn></msub><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow></mrow><annotation encoding="application/x-tex">a_{1},a_{2}\in\Pi</annotation></semantics></math>, we require that the equation <math id="S3.I4.i5.p1.m6" class="ltx_Math" alttext="\phi_{a_{1}\cdot a_{2}}=\phi_{a_{1}}\circ\phi_{a_{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mrow><msub><mi>a</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>a</mi><mn>2</mn></msub></mrow></msub><mo>=</mo><mrow><msub><mi>ϕ</mi><msub><mi>a</mi><mn>1</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>ϕ</mi><msub><mi>a</mi><mn>2</mn></msub></msub></mrow></mrow><annotation encoding="application/x-tex">\phi_{a_{1}\cdot a_{2}}=\phi_{a_{1}}\circ\phi_{a_{2}}</annotation></semantics></math> holds and <math id="S3.I4.i5.p1.m7" class="ltx_Math" alttext="\phi_{0}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\phi_{0}</annotation></semantics></math> is the identity map for <math id="S3.I4.i5.p1.m8" class="ltx_Math" alttext="a=0\in\Pi" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>=</mo><mn>0</mn><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow><annotation encoding="application/x-tex">a=0\in\Pi</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
</div>
<div id="S3.Thmthm8" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm8.2" class="ltx_text ltx_font_bold">Lemma 3.8</span></span><span id="S3.Thmthm8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm8.p1" class="ltx_para">
<p id="S3.Thmthm8.p1.1" class="ltx_p"><span id="S3.Thmthm8.p1.1.1" class="ltx_text ltx_font_italic">Given <math id="S3.Thmthm8.p1.m1" class="ltx_math_unparsed" alttext="\alpha=pr_{1}\cdots r_{l}q\in\mathbb{A}^{\mathcal{P}}_{pq}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mi>p</mi><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>l</mi></msub><mi>q</mi><mo>∈</mo><mi>𝔸</mi><msup><mrow></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\alpha=pr_{1}\cdots r_{l}q\in\mathbb{A}^{\mathcal{P}}_{pq}</annotation></semantics></math>, the space <math id="S3.Thmthm8.p1.m2" class="ltx_Math" alttext="\partial^{\alpha}T_{pq}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi>T</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\partial^{\alpha}T_{pq}</annotation></semantics></math> is homeomorphic to <math id="S3.Thmthm8.p1.m3" class="ltx_math_unparsed" alttext="T_{pr_{1}}\times\cdots\times T_{r_{l}q}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi>T</mi><msub><mrow></mrow><mrow><msub><mi>r</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">T_{pr_{1}}\times\cdots\times T_{r_{l}q}</annotation></semantics></math> as <math id="S3.Thmthm8.p1.m4" class="ltx_math_unparsed" alttext="\mathbb{A}^{\mathcal{P}}_{pr_{1}}\times\cdots\times\mathbb{A}^{\mathcal{P}}_{r_{l}q}" display="inline" intent=":literal"><semantics><mrow><mi>𝔸</mi><msup><mrow></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi>𝔸</mi><msup><mrow></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><msub><mrow></mrow><mrow><msub><mi>r</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbb{A}^{\mathcal{P}}_{pr_{1}}\times\cdots\times\mathbb{A}^{\mathcal{P}}_{r_{l}q}</annotation></semantics></math>-spaces.</span></p>
</div>
</div>
<div id="S3.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS2.p4" class="ltx_para">
<p id="S3.SS2.p4.1" class="ltx_p"><span id="S3.SS2.p4.1.1" class="ltx_text">We prove the statement by induction on <math id="S3.SS2.p4.m1" class="ltx_Math" alttext="{\rm depth}(\alpha)" display="inline" intent=":literal"><semantics><mrow><mi>depth</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\rm depth}(\alpha)</annotation></semantics></math>. For <math id="S3.SS2.p4.m2" class="ltx_Math" alttext="{\rm depth}(\alpha)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>depth</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\rm depth}(\alpha)=0</annotation></semantics></math>, this is tautology, and for <math id="S3.SS2.p4.m3" class="ltx_Math" alttext="{\rm depth}(\alpha)=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>depth</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{\rm depth}(\alpha)=1</annotation></semantics></math>, the assertion follows from Definition <a href="#S3.Thmthm7" title="Definition 3.7. ‣ 3.2. Topological flow categories and bimodules ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.7</span></a>. Suppose the lemma holds for all <math id="S3.SS2.p4.m4" class="ltx_Math" alttext="{\rm depth}(\alpha)\leq l-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>depth</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">{\rm depth}(\alpha)\leq l-1</annotation></semantics></math>. Now suppose <math id="S3.SS2.p4.m5" class="ltx_math_unparsed" alttext="\alpha=pr_{1}\cdots r_{l}q" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mi>p</mi><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>l</mi></msub><mi>q</mi></mrow><annotation encoding="application/x-tex">\alpha=pr_{1}\cdots r_{l}q</annotation></semantics></math>. Consider the homeomorphism between <math id="S3.SS2.p4.m6" class="ltx_Math" alttext="\mathbb{A}^{\mathcal{P}}_{pr_{1}}\times\mathbb{A}^{\mathcal{P}}_{r_{1}q}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>𝔸</mi><mrow><msub><mi>r</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup></mrow><annotation encoding="application/x-tex">\mathbb{A}^{\mathcal{P}}_{pr_{1}}\times\mathbb{A}^{\mathcal{P}}_{r_{1}q}</annotation></semantics></math> spaces <math id="S3.SS2.p4.m7" class="ltx_Math" alttext="T_{pr_{1}}\times T_{r_{1}q}\to\partial^{pr_{1}q}T_{pq}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>T</mi><mrow><msub><mi>r</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo rspace="0.111em" stretchy="false">→</mo><mrow><msup><mo>∂</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msup><msub><mi>T</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">T_{pr_{1}}\times T_{r_{1}q}\to\partial^{pr_{1}q}T_{pq}</annotation></semantics></math>. Restricting the homeomorphism along the closed stratum <math id="S3.SS2.p4.m8" class="ltx_math_unparsed" alttext="\mathbb{A}^{\mathcal{P}}_{pr_{1}}\times\partial^{r_{1}\cdots r_{l}q}\mathbb{A}^{\mathcal{P}}_{r_{1}q}" display="inline" intent=":literal"><semantics><mrow><mi>𝔸</mi><msup><mrow></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></msub><mo lspace="0.222em" rspace="0.055em">×</mo><mo>∂</mo><msup><mrow></mrow><mrow><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>l</mi></msub><mi>q</mi></mrow></msup><mi>𝔸</mi><msup><mrow></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><msub><mrow></mrow><mrow><msub><mi>r</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbb{A}^{\mathcal{P}}_{pr_{1}}\times\partial^{r_{1}\cdots r_{l}q}\mathbb{A}^{\mathcal{P}}_{r_{1}q}</annotation></semantics></math> and using the induction hypothesis, we obtain a homeomorphism of <math id="S3.SS2.p4.m9" class="ltx_math_unparsed" alttext="\mathbb{A}^{\mathcal{P}}_{pr_{1}}\times\cdots\times\mathbb{A}^{\mathcal{P}}_{r_{l}q}" display="inline" intent=":literal"><semantics><mrow><mi>𝔸</mi><msup><mrow></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi>𝔸</mi><msup><mrow></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><msub><mrow></mrow><mrow><msub><mi>r</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbb{A}^{\mathcal{P}}_{pr_{1}}\times\cdots\times\mathbb{A}^{\mathcal{P}}_{r_{l}q}</annotation></semantics></math>-spaces</span></p>
<table id="S3.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex22.m1" class="ltx_math_unparsed" alttext="T_{pr_{1}}\times\cdots\times T_{r_{l}q}\to\partial^{\alpha}T_{pq}." display="block" intent=":literal"><semantics><mrow><mi>T</mi><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi>T</mi><msub><mrow></mrow><mrow><msub><mi>r</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo rspace="0.111em" stretchy="false">→</mo><mo>∂</mo><msup><mrow></mrow><mi>α</mi></msup><mi>T</mi><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">T_{pr_{1}}\times\cdots\times T_{r_{l}q}\to\partial^{\alpha}T_{pq}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p4.2" class="ltx_p"><span id="S3.SS2.p4.2.1" class="ltx_text">By associativity, if we construct such a homeomorphism by decomposing <math id="S3.SS2.p4.m10" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> as <math id="S3.SS2.p4.m11" class="ltx_math_unparsed" alttext="pr_{1}\cdots r_{k}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">pr_{1}\cdots r_{k}</annotation></semantics></math> and <math id="S3.SS2.p4.m12" class="ltx_math_unparsed" alttext="r_{k}\cdots r_{l}q" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><msub><mrow></mrow><mi>k</mi></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>l</mi></msub><mi>q</mi></mrow><annotation encoding="application/x-tex">r_{k}\cdots r_{l}q</annotation></semantics></math> for some <math id="S3.SS2.p4.m13" class="ltx_Math" alttext="1\leq k\leq l" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>k</mi><mo>≤</mo><mi>l</mi></mrow><annotation encoding="application/x-tex">1\leq k\leq l</annotation></semantics></math>, the resulting homeomorphism between the stratified spaces is the same.
∎</span></p>
</div>
</div>
<div id="S3.SS2.p5" class="ltx_para">
<p id="S3.SS2.p5.1" class="ltx_p">Definition <a href="#S3.Thmthm7" title="Definition 3.7. ‣ 3.2. Topological flow categories and bimodules ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.7</span></a> does not impose any regularity conditions or tangential structures on the morphism spaces. The purpose of such a definition is to single out the stratification structures and we will introduce several enhancements by putting various structures on the morphism spaces in the sequel.</p>
</div>
<section id="S3.SS2.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">3.2.1. </span>Flow bimodules</h4>

<div id="S3.SS2.SSS1.p1" class="ltx_para">
<p id="S3.SS2.SSS1.p1.1" class="ltx_p">We first introduce the posets indexing strata in flow bimodules.</p>
</div>
<div id="S3.Thmthm9" class="ltx_theorem ltx_theorem_notation">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm9.2" class="ltx_text ltx_font_italic">Notation 3.9</span></span><span id="S3.Thmthm9.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S3.Thmthm9.p1" class="ltx_para">
<p id="S3.Thmthm9.p1.1" class="ltx_p">Suppose <math id="S3.Thmthm9.p1.m1" class="ltx_Math" alttext="{\mathcal{P}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">{\mathcal{P}}</annotation></semantics></math> and <math id="S3.Thmthm9.p1.m2" class="ltx_Math" alttext="{\mathcal{P}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup><annotation encoding="application/x-tex">{\mathcal{P}}^{\prime}</annotation></semantics></math> are two posets as in Setup <a href="#S3.Thmthm5" title="Setup 3.5. ‣ 3.2. Topological flow categories and bimodules ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.5</span></a> equipped with own action and index functions</p>
<table id="S3.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex23.m1" class="ltx_Math" alttext="\displaystyle\ ({\mathcal{A}}^{\mathcal{P}},{\rm ind}^{\mathcal{P}}):{\mathcal{P}}\to{\mathbb{R}}\times({\mathbb{Z}}/2N),\ " display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><mo>,</mo><msup><mi>ind</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">→</mo><mrow><mi>ℝ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>ℤ</mi><mo>/</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ ({\mathcal{A}}^{\mathcal{P}},{\rm ind}^{\mathcal{P}}):{\mathcal{P}}\to{\mathbb{R}}\times({\mathbb{Z}}/2N),\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex23.m2" class="ltx_Math" alttext="\displaystyle\ ({\mathcal{A}}^{{\mathcal{P}}^{\prime}},{\rm ind}^{{\mathcal{P}}^{\prime}}):{\mathcal{P}}^{\prime}\to{\mathbb{R}}\times({\mathbb{Z}}/2N)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msup><mo>,</mo><msup><mi>ind</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msup><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup><mo stretchy="false">→</mo><mrow><mi>ℝ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>ℤ</mi><mo>/</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ ({\mathcal{A}}^{{\mathcal{P}}^{\prime}},{\rm ind}^{{\mathcal{P}}^{\prime}}):{\mathcal{P}}^{\prime}\to{\mathbb{R}}\times({\mathbb{Z}}/2N).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm9.p1.2" class="ltx_p">For <math id="S3.Thmthm9.p1.m3" class="ltx_Math" alttext="p\in{\mathcal{P}}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow><annotation encoding="application/x-tex">p\in{\mathcal{P}}</annotation></semantics></math> and <math id="S3.Thmthm9.p1.m4" class="ltx_Math" alttext="p^{\prime}\in{\mathcal{P}}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>p</mi><mo>′</mo></msup><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">p^{\prime}\in{\mathcal{P}}^{\prime}</annotation></semantics></math>, define a poset</p>
<table id="S3.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex24.m1" class="ltx_math_unparsed" alttext="{\mathbb{A}}_{pp^{\prime}}:=\big\{\alpha=pq_{1}\cdots q_{k}q^{\prime}_{k^{\prime}}\cdots q^{\prime}_{1}p^{\prime}\ |\ p&lt;q_{1}&lt;\cdots&lt;q_{k},\ q^{\prime}_{k^{\prime}}&lt;\cdots&lt;q^{\prime}_{1}&lt;p^{\prime}\big\}" display="block" intent=":literal"><semantics><mrow><msub><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub><mo>:=</mo><mrow><mo stretchy="false">{</mo><mi>α</mi><mo>=</mo><mi>p</mi><msub><mi>q</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>q</mi><mi>k</mi></msub><msubsup><mi>q</mi><msup><mi>k</mi><mo>′</mo></msup><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">⋯</mo><msubsup><mi>q</mi><mn>1</mn><mo>′</mo></msubsup><msup><mi>p</mi><mo>′</mo></msup><mo fence="false" rspace="0.667em" stretchy="false">|</mo><mi>p</mi><mo>&lt;</mo><msub><mi>q</mi><mn>1</mn></msub><mo rspace="0.1389em">&lt;</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">&lt;</mo><msub><mi>q</mi><mi>k</mi></msub><mo rspace="0.667em">,</mo><msubsup><mi>q</mi><msup><mi>k</mi><mo>′</mo></msup><mo>′</mo></msubsup><mo rspace="0.1389em">&lt;</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">&lt;</mo><msubsup><mi>q</mi><mn>1</mn><mo>′</mo></msubsup><mo>&lt;</mo><msup><mi>p</mi><mo>′</mo></msup><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{A}}_{pp^{\prime}}:=\big\{\alpha=pq_{1}\cdots q_{k}q^{\prime}_{k^{\prime}}\cdots q^{\prime}_{1}p^{\prime}\ |\ p&lt;q_{1}&lt;\cdots&lt;q_{k},\ q^{\prime}_{k^{\prime}}&lt;\cdots&lt;q^{\prime}_{1}&lt;p^{\prime}\big\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm9.p1.3" class="ltx_p">The partial order is again induced by inclusion:</p>
<table id="S3.Thmthm9.p1.4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Thmthm9.p1.m5" class="ltx_Math" alttext="pq_{1}\cdots q_{k}q^{\prime}_{k^{\prime}}\cdots q^{\prime}_{1}p^{\prime}\leq p\tilde{q}_{1}\cdots\tilde{q}_{\tilde{k}}\tilde{q}^{\prime}_{\tilde{k}^{\prime}}\cdots\tilde{q}^{\prime}_{1}p^{\prime}\\
\Longleftrightarrow\{\tilde{q}_{1},\dots,\tilde{q}_{\tilde{k}}\}\subseteq\{q_{1},\dots,q_{k}\}\ {\rm and}\ \{\tilde{q}^{\prime}_{1}\cdots\tilde{q}^{\prime}_{\tilde{k}^{\prime}}\}\subseteq\{q^{\prime}_{1}\cdots q^{\prime}_{k^{\prime}}\}." display="block" intent=":literal"><semantics><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi>p</mi><mi>q</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>q</mi><msub><mrow></mrow><mi>k</mi></msub><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup><msub><mrow></mrow><msup><mi>k</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup><msub><mrow></mrow><mn>1</mn></msub><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup><mo>≤</mo><mi>p</mi><mover accent="true"><mi>q</mi><mo>~</mo></mover><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mover accent="true"><mi>q</mi><mo>~</mo></mover><msub><mrow></mrow><mover accent="true"><mi>k</mi><mo>~</mo></mover></msub><mover accent="true"><mi>q</mi><mo>~</mo></mover><msup><mrow></mrow><mo>′</mo></msup><msub><mrow></mrow><msup><mover accent="true"><mi>k</mi><mo>~</mo></mover><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">⋯</mo><mover accent="true"><mi>q</mi><mo>~</mo></mover><msup><mrow></mrow><mo>′</mo></msup><msub><mrow></mrow><mn>1</mn></msub><mi>p</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mo stretchy="false">⟺</mo><mo stretchy="false">{</mo><mover accent="true"><mi>q</mi><mo>~</mo></mover><msub><mrow></mrow><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mover accent="true"><mi>q</mi><mo>~</mo></mover><msub><mrow></mrow><mover accent="true"><mi>k</mi><mo>~</mo></mover></msub><mo stretchy="false">}</mo><mo>⊆</mo><mo stretchy="false">{</mo><mi>q</mi><msub><mrow></mrow><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>q</mi><msub><mrow></mrow><mi>k</mi></msub><mo rspace="1.000em" stretchy="false">}</mo><mi>and</mi><mo lspace="1.000em" stretchy="false">{</mo><mover accent="true"><mi>q</mi><mo>~</mo></mover><msup><mrow></mrow><mo>′</mo></msup><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mover accent="true"><mi>q</mi><mo>~</mo></mover><msup><mrow></mrow><mo>′</mo></msup><msub><mrow></mrow><msup><mover accent="true"><mi>k</mi><mo>~</mo></mover><mo>′</mo></msup></msub><mo stretchy="false">}</mo><mo>⊆</mo><mo stretchy="false">{</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>q</mi><msup><mrow></mrow><mo>′</mo></msup><msub><mrow></mrow><msup><mi>k</mi><mo>′</mo></msup></msub><mo stretchy="false">}</mo><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">pq_{1}\cdots q_{k}q^{\prime}_{k^{\prime}}\cdots q^{\prime}_{1}p^{\prime}\leq p\tilde{q}_{1}\cdots\tilde{q}_{\tilde{k}}\tilde{q}^{\prime}_{\tilde{k}^{\prime}}\cdots\tilde{q}^{\prime}_{1}p^{\prime}\\
\Longleftrightarrow\{\tilde{q}_{1},\dots,\tilde{q}_{\tilde{k}}\}\subseteq\{q_{1},\dots,q_{k}\}\ {\rm and}\ \{\tilde{q}^{\prime}_{1}\cdots\tilde{q}^{\prime}_{\tilde{k}^{\prime}}\}\subseteq\{q^{\prime}_{1}\cdots q^{\prime}_{k^{\prime}}\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm9.p1.5" class="ltx_p"><math id="S3.Thmthm9.p1.m6" class="ltx_Math" alttext="{\mathbb{A}}_{pp^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">{\mathbb{A}}_{pp^{\prime}}</annotation></semantics></math> is a homogeneous poset with a unique maximal element <math id="S3.Thmthm9.p1.m7" class="ltx_Math" alttext="pp^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">pp^{\prime}</annotation></semantics></math> and depth function</p>
<table id="S3.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex25.m1" class="ltx_math_unparsed" alttext="{\rm depth}(pq_{1}\cdots q_{k}q_{k^{\prime}}^{\prime}\cdots q_{1}^{\prime}p^{\prime})=k+k^{\prime}." display="block" intent=":literal"><semantics><mrow><mi>depth</mi><mrow><mo stretchy="false">(</mo><mi>p</mi><msub><mi>q</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>q</mi><mi>k</mi></msub><msubsup><mi>q</mi><msup><mi>k</mi><mo>′</mo></msup><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">⋯</mo><msubsup><mi>q</mi><mn>1</mn><mo>′</mo></msubsup><msup><mi>p</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>k</mi><mo>+</mo><msup><mi>k</mi><mo>′</mo></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\rm depth}(pq_{1}\cdots q_{k}q_{k^{\prime}}^{\prime}\cdots q_{1}^{\prime}p^{\prime})=k+k^{\prime}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.Thmthm9.p2" class="ltx_para">
<p id="S3.Thmthm9.p2.1" class="ltx_p">There are similar characterizations of “broken configurations.” If <math id="S3.Thmthm9.p2.m1" class="ltx_Math" alttext="p&lt;q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p&lt;q</annotation></semantics></math> are elements in <math id="S3.Thmthm9.p2.m2" class="ltx_Math" alttext="{\mathcal{P}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">{\mathcal{P}}</annotation></semantics></math>, it is easy to see that there is a natural isomorphism of homogeneous posets</p>
<table id="S3.Ex26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex26.m1" class="ltx_Math" alttext="{\mathbb{A}}_{pq}^{\mathcal{P}}\times{\mathbb{A}}_{qp^{\prime}}\cong\partial^{pqp^{\prime}}{\mathbb{A}}_{pp^{\prime}}" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝔸</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub></mrow><mo rspace="0.111em">≅</mo><mrow><msup><mo>∂</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msup><msub><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{A}}_{pq}^{\mathcal{P}}\times{\mathbb{A}}_{qp^{\prime}}\cong\partial^{pqp^{\prime}}{\mathbb{A}}_{pp^{\prime}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm9.p2.2" class="ltx_p">by concatenation of words. Such an isomorphism makes the following diagram commute:</p>
<table id="S3.Ex27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S3.Ex27.m1.pic1" class="ltx_picture ltx_markedasmath" height="115.07" overflow="visible" style="vertical-align:-102.73598892256253px" version="1.1" viewBox="39.00 102.74 343.87 115.07" width="343.87"><g transform="matrix(1 0 0 -1 38.99662560969282 115.06788592393326) translate(0,3.46) translate(39,0)"><g transform="translate(72.21,0) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:8.18em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.37em;font-size:10pt;" height="16.78" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="113.16"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex27.m1.pic1.m2" class="ltx_Math" alttext="\textstyle{{\mathbb{A}}_{pq_{1}}^{\mathcal{P}}\times{\mathbb{A}}^{\mathcal{P}}_{q_{1}q_{2}}\times{\mathbb{A}}_{q_{2}p^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mn>1</mn></msub></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>𝔸</mi><mrow><msub><mi>q</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mn>2</mn></msub></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝔸</mi><mrow><msub><mi>q</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub></mrow><annotation encoding="application/x-tex">\textstyle{{\mathbb{A}}_{pq_{1}}^{\mathcal{P}}\times{\mathbb{A}}^{\mathcal{P}}_{q_{1}q_{2}}\times{\mathbb{A}}_{q_{2}p^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path