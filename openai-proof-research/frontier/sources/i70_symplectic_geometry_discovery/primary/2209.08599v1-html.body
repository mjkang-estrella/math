nsform="translate(49.99,0) translate(0,10.19) translate(4.15,0) translate(0,-3.96)"> <foreignObject style="--ltx-fo-width:4.59em;--ltx-fo-height:0.72em;--ltx-fo-depth:0.15em;font-size:10pt;" height="12.07" overflow="visible" transform="matrix(1 0 0 -1 0 9.99)" width="63.57"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mrow><msub><mover accent="true"><mi mathsize="0.700em">ϑ</mi><mo>^</mo></mover><mi mathsize="0.710em">α</mi></msub><mo mathsize="0.700em">=</mo><mrow><msubsup><mover accent="true"><mi mathsize="0.700em">ϑ</mi><mo>^</mo></mover><mi mathsize="0.710em">α</mi><mi mathsize="0.710em">O</mi></msubsup><mo mathsize="0.700em">⊕</mo><msubsup><mover accent="true"><mi mathsize="0.700em">ϑ</mi><mo>^</mo></mover><mi mathsize="0.710em">α</mi><mi mathsize="0.710em">Q</mi></msubsup></mrow></mrow></span></span></foreignObject> </g> <g transform="translate(123.29,0)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M 48.5671610691677 -0.27673578005007266 L 123.28694070277908 0.27673578005007266" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 123.28694070277908 -0.27673578005007266 L 123.28694070277908 0.27673578005007266" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -10.300875534832485 L 0.27673578005007266 -10.300875534832485" fill="none" stroke="#000000"></path> <g transform="translate(0,-33.75)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M -0.276735780