<p id="S3.Thmthm10.p1.2" class="ltx_p">These data should be subject to the following conditions.</p>
<ol id="S3.I6" class="ltx_enumerate">
<li id="S3.I6.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S3.I6.i1.p1" class="ltx_para">
<p id="S3.I6.i1.p1.1" class="ltx_p">There is a constant <math id="S3.I6.i1.p1.m1" class="ltx_Math" alttext="C&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C&gt;0</annotation></semantics></math> such that for all <math id="S3.I6.i1.p1.m2" class="ltx_Math" alttext="p\in{\mathcal{P}}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow><annotation encoding="application/x-tex">p\in{\mathcal{P}}</annotation></semantics></math>, <math id="S3.I6.i1.p1.m3" class="ltx_Math" alttext="p^{\prime}\in{\mathcal{P}}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>p</mi><mo>′</mo></msup><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">p^{\prime}\in{\mathcal{P}}^{\prime}</annotation></semantics></math>,</p>
<table id="S3.E4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E4.m1" class="ltx_Math" alttext="M_{pp^{\prime}}\neq\emptyset\Longrightarrow{\mathcal{A}}^{\mathcal{P}}(p)&lt;{\mathcal{A}}^{{\mathcal{P}}^{\prime}}(p^{\prime})+C." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub><mo>≠</mo><mi mathvariant="normal">∅</mi><mo stretchy="false">⟹</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>p</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>C</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">M_{pp^{\prime}}\neq\emptyset\Longrightarrow{\mathcal{A}}^{\mathcal{P}}(p)&lt;{\mathcal{A}}^{{\mathcal{P}}^{\prime}}(p^{\prime})+C.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.4)</span></td></tr></tbody>
</table>
</div></li>
<li id="S3.I6.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S3.I6.i2.p1" class="ltx_para">
<p id="S3.I6.i2.p1.1" class="ltx_p">For <math id="S3.I6.i2.p1.m1" class="ltx_Math" alttext="p&lt;q_{1}&lt;q_{2}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><msub><mi>q</mi><mn>1</mn></msub><mo>&lt;</mo><msub><mi>q</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">p&lt;q_{1}&lt;q_{2}</annotation></semantics></math> in <math id="S3.I6.i2.p1.m2" class="ltx_Math" alttext="{\mathcal{P}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">{\mathcal{P}}</annotation></semantics></math> and <math id="S3.I6.i2.p1.m3" class="ltx_Math" alttext="p^{\prime}\in{\mathcal{P}}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>p</mi><mo>′</mo></msup><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">p^{\prime}\in{\mathcal{P}}^{\prime}</annotation></semantics></math>, the following diagram commutes:</p>
<table id="S3.Ex32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S3.Ex32.m1.pic1" class="ltx_picture ltx_markedasmath" height="78.72" overflow="visible" style="vertical-align:-39.36px" version="1.1" viewBox="0 0 284.79 78.72" width="284.79"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,78.72) matrix(1 0 0 -1 0 0) translate(142.4,0) translate(0,39.36)"><g stroke-width="0.4pt" transform="matrix(1.0 0.0 0.0 1.0 -142.39 -29.16)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 78.72)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 16.7)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 0 0) translate(74.44,0) matrix(1.0 0.0 0.0 1.0 -68.48 0)"><foreignObject style="--ltx-fo-width:8.9em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.37em;font-size:10pt;" height="16.78" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="123.13"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex32.m1.pic1.m1" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces T^{\mathcal{P}}_{pq_{1}}\times T^{\mathcal{P}}_{q_{1}q_{2}}\times M_{q_{2}p^{\prime}}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>T</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mn>1</mn></msub></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>T</mi><mrow><msub><mi>q</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mn>2</mn></msub></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>M</mi><mrow><msub><mi>q</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub></mrow><annotation encoding="application/x-tex">{\l