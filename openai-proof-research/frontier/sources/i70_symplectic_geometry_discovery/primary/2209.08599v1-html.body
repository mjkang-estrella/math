ate(0,-45.54) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:8.03em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.29em;font-size:10pt;" height="15.6" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="111.11"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex81.m1.pic1.m5" class="ltx_math_unparsed" alttext="\textstyle{\partial^{\alpha}{\mathcal{U}}_{\beta}\times[0,\epsilon)^{{\mathbb{F}}_{\alpha}\setminus{\mathbb{F}}_{\beta}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>β</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow><mrow><msub><mi>𝔽</mi><mi>α</mi></msub><mo>∖</mo><msub><mi>𝔽</mi><mi>β</mi></msub></mrow></msup></mrow><annotation encoding="application/x-tex">\textstyle{\partial^{\alpha}{\mathcal{U}}_{\beta}\times[0,\epsilon)^{{\mathbb{F}}_{\alpha}\setminus{\mathbb{F}}_{\beta}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 59.707766171723655 -45.817433113508805 L 59.707766171723655 -45.263961553408656" fill="none" stroke="#000000"></path><g transform="translate(82.35,0) translate(0,-55.59) translate(4.15,0) translate(0,-3.08)"><foreignObject style="--ltx-fo-width:2.09em;--ltx-fo-height:0.65em;--ltx-fo-depth:0.2em;font-size:10pt;" height="11.79" overflow="visible" transform="matrix(1 0 0 -1 0 8.98)" width="28.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex81.m1.pic1.m6" class="ltx_Math" alttext="\scriptstyle{\theta_{\beta\alpha}^{\rm collar}}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.700em">θ</mi><mrow><mi mathsize="0.710em">β</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">α</mi></mrow><mi mathsize="0.710em">collar</mi></msubsup><annotation encoding="application/x-tex">\scriptstyle{\theta_{\beta\alpha}^{\rm collar}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(142.23,0) translate(0,-45.54)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 59.707766171723655 -45.817433113508805 L 142.22373767101666 -45.263961553408656" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 142.22373767101666 -45.817433113508805 L 142.22373767101666 -45.263961553408656" fill="none" stroke="#000000"></path><g transform="translate(142.23,0) translate(0,-45.54) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.25em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.29em;font-size:10pt;" height="13.41" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="17.34"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex81.m1.pic1.m8" class="ltx_Math" alttext="\textstyle{{\mathcal{U}}_{\beta}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>β</mi></msub><annotation encoding="application/x-tex">\textstyle{{\mathcal{U}}_{\beta}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
