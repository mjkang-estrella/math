e-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -2.77 -6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 2.77 -6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.26259775083887 L 0.27673578005007266 -12.727755637226286" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -12.727755637226286 L 0.27673578005007266 -12.727755637226286" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 51.15743921854461 -45.871230532259666 L 51.15743921854461 -45.317758972159524" fill="none" stroke="#000000"></path><g transform="translate(81.42,0) translate(0,-55.6) translate(4.15,0) translate(0,-3.13)"><foreignObject style="--ltx-fo-width:2.09em;--ltx-fo-height:0.65em;--ltx-fo-depth:0.2em;font-size:10pt;" height="11.71" overflow="visible" transform="matrix(1 0 0 -1 0 8.98)" width="28.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex110.m1.pic1.m7" class="ltx_Math" alttext="\scriptstyle{\theta_{pq,\alpha}^{\rm collar}}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.700em">θ</mi><mrow><mrow><mi mathsize="0.710em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">q</mi></mrow><mo mathsize="0.710em">,</mo><mi mathsize="0.710em">α</mi></mrow><mi mathsize="0.710em">collar</mi></msubsup><annotation encoding="application/x-tex">\scriptstyle{\theta_{pq,\alpha}^{\rm collar}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(148.92,0) translate(0,-45.6)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 51.15743921854461 -45.871230532259666 L 148.91894044792963 -45.317758972159524" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 148.91894044792963 -45.871230532259666 L 148.91894044792963 -45.317758972159524" fill="none" stroke="#000000"></path><g transform="translate(148.92,0) translate(0,-45.6) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:1.6em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.29em;font-size:10pt;" height="13.41" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="22.19"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex110.m1.pic1.m9" class="ltx_Math" alttext="\textstyle{{\mathcal{U}}_{pq}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\textstyle{{\mathcal{U}}_{pq}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 163.88967684794218 -35.44738946885378 L 164.44314840804233 -35.44738946885378" fill="none" stroke="#000000"></path><g transform="translate(164.17,0) translate(0,-22.8) translate(4.15,0) translate(0,-2.65)"><foreignObject style="--ltx-fo-width:1.21em;--ltx-fo-height:0.58em;--ltx-fo-depth:0.2em;font-size:10pt;" height="10.75" overflow="visible" transform="matrix(1 0 0 -1 0 8.02)" width="16.73"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex110.m1.pic1.m10" class="ltx_Math" alttext="\scriptstyle{{\mathcal{S}}_{pq}^{\prime}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic" mathsize="0.700em">𝒮</mi><mrow><mi mathsize="0.710em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">q</mi></mrow><mo mathsize="0.710em">′</mo></msubsup><annotation encoding="application/x-tex">\scriptstyle{{\mathcal{S}}_{pq}^{\prime}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(164.17,0) translate(0,-12.73)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -2.77 -6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 2.77 -6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 163.88967684794218 -35.44738946885378 L 164.44314840804233 -12.727755637226286" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 163.88967684794218 -12.727755637226286 L 164.44314840804233 -12.727755637226286" fill="none" stroke="#000000"></path></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S3.I28.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S3.I28.i4.p1" class="ltx_para">
<p id="S3.I28.i4.p1.1" class="ltx_p">Suppose the derived orbifold lift is normally complex and is equipped with a package of compatible structures (scaffolding, collar structure, and straightening). Then a perturbation <math id="S3.I28.i4.p1.m1" class="ltx_Math" alttext="{\mathfrak{S}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝔖</mi><mo>′</mo></msup><annotation encoding="application/x-tex">{\mathfrak{S}}^{\prime}</annotation></semantics></math> is called an <span id="S3.I28.i4.p1.1.1" class="ltx_text ltx_font_bold">FOP perturbation</span> if respects the scaffolding, respects the collar structure, and for each <math id="S3.I28.i4.p1.m2" class="ltx_Math" alttext="pq" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">pq</annotation></semantics></math>, with respect to the straightening, the restriction of <math id="S3.I28.i4.p1.m3" class="ltx_Math" alttext="{\mathcal{S}}_{pq}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{S}}_{pq}^{\prime}</annotation></semantics></math> to the interior of each stratum <math id="S3.I28.i4.p1.m4" class="ltx_Math" alttext="\partial^{\alpha}{\mathcal{U}}_{pq}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\partial^{\alpha}{\mathcal{U}}_{pq}</annotation></semantics></math> is an FOP section of <math id="S3.I28.i4.p1.m5" class="ltx_Math" alttext="{\mathcal{E}}_{pq}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{pq}</annotation></semantics></math>.<span id="footnote8" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">8</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">8</sup>
                      <span class="ltx_tag ltx_tag_note">8</span>
                      
                      
                      
                    Indeed being an FOP perturbation only needs to refer to the straightening and the normal complex structure.</span></span></span></p>
</div></li>
<li id="S3.I28.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(5)</span> 
<div id="S3.I28.i5.p1" class="ltx_para">
<p id="S3.I28.i5.p1.1" class="ltx_p">Under the assumptions of the last item, an FOP perturbation is called <span id="S3.I28.i5.p1.1.1" class="ltx_text ltx_font_bold">strongly transverse</span> if the restriction of each <math id="S3.I28.i5.p1.m1" class="ltx_Math" alttext="{\mathcal{S}}_{pq}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{S}}_{pq}^{\prime}</annotation></semantics></math> to the interior of each stratum of <math id="S3.I28.i5.p1.m2" class="ltx_Math" alttext="{\mathcal{U}}_{pq}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{U}}_{pq}</annotation></semantics></math> is strongly transverse (see Definition <a href="#S2.Thmthm7" title="Definition 2.7. ‣ 2.1.3. FOP sections and strong transversality ‣ 2.1. Orbifolds and the canonical Whitney stratification on 𝒵_𝑑 ‣ 2. Recap of the FOP natural transformation and multiplicativity ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.7</span></a>).</p>
</div></li>
</ol>
</div>
</div>
<div id="S3.Thmthm49" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm49.2" class="ltx_text ltx_font_bold">Theorem 3.49</span></span><span id="S3.Thmthm49.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm49.p1" class="ltx_para">
<p id="S3.Thmthm49.p1.1" class="ltx_p"><span id="S3.Thmthm49.p1.1.1" class="ltx_text ltx_font_italic">Given a flow category <math id="S3.Thmthm49.p1.m1" class="ltx_Math" alttext="T^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">T^{\mathcal{P}}</annotation></semantics></math>, a derived orbifold lift <math id="S3.Thmthm49.p1.m2" class="ltx_Math" alttext="{\mathfrak{D}}^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\mathcal{P}}</annotation></semantics></math> with a normally complex structure, together with a package of compatible extra structures (scaffolding, collaring, and straightening), there exists a strongly transverse FOP perturbation. Moreover, we can make the perturbation <math id="S3.Thmthm49.p1.m3" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>-invariant, i.e.,</span></p>
<table id="S3.Ex111" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex111.m1" class="ltx_Math" alttext="{\mathcal{S}}_{pq}^{\prime}={\mathcal{S}}_{a\cdot p\ a\cdot q}^{\prime}\ \forall a\in\Pi\ p,q\in{\mathcal{P}}" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup><mo>=</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mrow><mrow><mi>a</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><mo lspace="0.410em" rspace="0em">​</mo><mi>a</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>q</mi></mrow><mo>′</mo></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mo rspace="0.167em">∀</mo><mi>a</mi></mrow></mrow><mo>∈</mo><mrow><mi mathvariant="normal">Π</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>p</mi></mrow></mrow><mo>,</mo><mrow><mi>q</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{S}}_{pq}^{\prime}={\mathcal{S}}_{a\cdot p\ a\cdot q}^{\prime}\ \forall a\in\Pi\ p,q\in{\mathcal{P}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm49.p1.2" class="ltx_p"><span id="S3.Thmthm49.p1.2.1" class="ltx_text ltx_font_italic">after identifying <math id="S3.Thmthm49.p1.m4" class="ltx_Math" alttext="C_{pq}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">C_{pq}</annotation></semantics></math> with <math id="S3.Thmthm49.p1.m5" class="ltx_Math" alttext="C_{a\cdot p\ a\cdot q}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mrow><mrow><mrow><mi>a</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><mo lspace="0.410em" rspace="0em">​</mo><mi>a</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">C_{a\cdot p\ a\cdot q}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.SS7.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS7.p2" class="ltx_para">
<p id="S3.SS7.p2.1" class="ltx_p"><span id="S3.SS7.p2.1.1" class="ltx_text">The construction is based on the same induction strategy as defining the Hamiltonian Floer homology (as well as continuation maps etc.) using abstract perturbations as in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx16" title="" class="ltx_ref">FO99</a>]</cite> and <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx26" title="" class="ltx_ref">LT98b</a>]</cite>. The package of additional structures is necessary because the FOP perturbation scheme is more rigid than the traditional smooth or continuous multivalued perturbation scheme. We start with a pair <math id="S3.SS7.p2.m1" class="ltx_Math" alttext="p&lt;q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p&lt;q</annotation></semantics></math> with minimal (nonzero) energy <math id="S3.SS7.p2.m2" class="ltx_Math" alttext="{\mathcal{A}}^{\mathcal{P}}(q)-{\mathcal{A}}^{\mathcal{P}}(p)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{A}}^{\mathcal{P}}(q)-{\mathcal{A}}^{\mathcal{P}}(p)</annotation></semantics></math>. Then by definition, <math id="S3.SS7.p2.m3" class="ltx_Math" alttext="{\mathbb{A}}_{pq}^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><annotation encoding="application/x-tex">{\mathbb{A}}_{pq}^{\mathcal{P}}</annotation></semantics></math> is a poset with a single element and hence the chart <math id="S3.SS7.p2.m4" class="ltx_Math" alttext="C_{pq}=({\mathcal{U}}_{pq},{\mathcal{E}}_{pq},{\mathcal{S}}_{pq})" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{pq}=({\mathcal{U}}_{pq},{\mathcal{E}}_{pq},{\mathcal{S}}_{pq})</annotation></semantics></math> is a derived orbifold chart with no boundary or corners. By the absolute version of Proposition <a href="#S2.Thmthm10" title="Proposition 2.10. ‣ 2.1.3. FOP sections and strong transversality ‣ 2.1. Orbifolds and the canonical Whitney stratification on 𝒵_𝑑 ‣ 2. Recap of the FOP natural transformation and multiplicativity ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.10</span></a>, with respect to the normal complex structure and the straightening, there exists a strongly transverse FOP perturbation <math id="S3.SS7.p2.m5" class="ltx_Math" alttext="{\mathcal{S}}_{pq}^{\prime}:{\mathcal{U}}_{pq}\to{\mathcal{E}}_{pq}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{S}}_{pq}^{\prime}:{\mathcal{U}}_{pq}\to{\mathcal{E}}_{pq}</annotation></semantics></math> which can be arbitrarily close (measured in <math id="S3.SS7.p2.m6" class="ltx_Math" alttext="C^{0}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mn>0</mn></msup><annotation encoding="application/x-tex">C^{0}</annotation></semantics></math>) to <math id="S3.SS7.p2.m7" class="ltx_Math" alttext="{\mathcal{S}}_{pq}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{S}}_{pq}</annotation></semantics></math>. In particular, <math id="S3.SS7.p2.m8" class="ltx_Math" alttext="{\mathcal{S}}_{pq}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{S}}_{pq}^{\prime}</annotation></semantics></math> has a compact zero locus. We can also make such perturbations <math id="S3.SS7.p2.m9" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>-invariant.</span></p>
</div>
<div id="S3.SS7.p3" class="ltx_para">
<p id="S3.SS7.p3.1" class="ltx_p"><span id="S3.SS7.p3.1.1" class="ltx_text">Now for a given pair <math id="S3.SS7.p3.m1" class="ltx_Math" alttext="p&lt;q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p&lt;q</annotation></semantics></math>, we state our induction hypothesis: for pair <math id="S3.SS7.p3.m2" class="ltx_Math" alttext="r&lt;s" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>&lt;</mo><mi>s</mi></mrow><annotation encoding="application/x-tex">r&lt;s</annotation></semantics></math> with <math id="S3.SS7.p3.m3" class="ltx_Math" alttext="p\leq r&lt;s\leq q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>≤</mo><mi>r</mi><mo>&lt;</mo><mi>s</mi><mo>≤</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p\leq r&lt;s\leq q</annotation></semantics></math> and <math id="S3.SS7.p3.m4" class="ltx_Math" alttext="(p,q)\neq(r,s)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mo>≠</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(p,q)\neq(r,s)</annotation></semantics></math>, we have constructed a strongly transverse FOP section with respect to the straightening and normal complex structure</span></p>
<table id="S3.Ex112" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex112.m1" class="ltx_Math" alttext="{\mathcal{S}}_{rs}^{\prime}:{\mathcal{U}}_{rs}\to{\mathcal{E}}_{rs}" display="block" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>′</mo></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{S}}_{rs}^{\prime}:{\mathcal{U}}_{rs}\to{\mathcal{E}}_{rs}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS7.p3.2" class="ltx_p"><span id="S3.SS7.p3.2.1" class="ltx_text">satisfying the compatibility condition for a perturbation (with respect to the collar structure and scaffolding, see Definition <a href="#S3.Thmthm48" title="Definition 3.48 (Perturbations on a derived orbifold lift). ‣ 3.7. Constructing FOP perturbations ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.48</span></a>). We would like to construct a strongly transverse FOP perturbation <math id="S3.SS7.p3.m5" class="ltx_Math" alttext="{\mathcal{S}}_{pq}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{S}}_{pq}^{\prime}</annotation></semantics></math> which extends the existing ones and which still satisfies the compatibility conditions.</span></p>
</div>
<div id="S3.SS7.p4" class="ltx_para">
<p id="S3.SS7.p4.1" class="ltx_p"><span id="S3.SS7.p4.1.1" class="ltx_text">For each proper stratum <math id="S3.SS7.p4.m1" class="ltx_math_unparsed" alttext="\alpha=pr_{1}\cdots r_{l}q" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mi>p</mi><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>l</mi></msub><mi>q</mi></mrow><annotation encoding="application/x-tex">\alpha=pr_{1}\cdots r_{l}q</annotation></semantics></math> of <math id="S3.SS7.p4.m2" class="ltx_Math" alttext="pq" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">pq</annotation></semantics></math>, the product of <math id="S3.SS7.p4.m3" class="ltx_Math" alttext="{\mathcal{S}}_{pr_{1}}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{S}}_{pr_{1}}^{\prime}</annotation></semantics></math>, <math id="S3.SS7.p4.m4" class="ltx_Math" alttext="\ldots" display="inline" intent=":literal"><semantics><mi mathvariant="normal">…</mi><annotation encoding="application/x-tex">\ldots</annotation></semantics></math>, <math id="S3.SS7.p4.m5" class="ltx_Math" alttext="{\mathcal{S}}_{r_{l}q}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><msub><mi>r</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{S}}_{r_{l}q}^{\prime}</annotation></semantics></math> provides a section</span></p>
<table id="S3.Ex113" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex113.m1" class="ltx_math_unparsed" alttext="{\mathcal{S}}_{\alpha}^{\prime}:={\mathcal{S}}_{pr_{1}}^{\prime}\times\cdots\times{\mathcal{S}}_{r_{l}q}^{\prime}:{\mathcal{U}}_{\alpha}\to{\mathcal{E}}_{\alpha}." display="block" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><msub><mrow></mrow><mi>α</mi></msub><msup><mrow></mrow><mo>′</mo></msup><mo>:=</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></msub><msup><mrow></mrow><mo>′</mo></msup><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><msub><mrow></mrow><mrow><msub><mi>r</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><msup><mrow></mrow><mo>′</mo></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mi class="ltx_font_mathcaligraphic">𝒰</mi><msub><mrow></mrow><mi>α</mi></msub><mo stretchy="false">→</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><msub><mrow></mrow><mi>α</mi></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{S}}_{\alpha}^{\prime}:={\mathcal{S}}_{pr_{1}}^{\prime}\times\cdots\times{\mathcal{S}}_{r_{l}q}^{\prime}:{\mathcal{U}}_{\alpha}\to{\mathcal{E}}_{\alpha}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS7.p4.2" class="ltx_p"><span id="S3.SS7.p4.2.1" class="ltx_text">Then via the stabilization map</span></p>
<table id="S3.Ex114" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex114.m1" class="ltx_Math" alttext="{\bm{\theta}}_{pq,\alpha}:{\rm Stab}_{{\mathcal{F}}_{pq,\alpha}}(C_{\alpha})\simeq\partial^{\alpha}C_{pq}" display="block" intent=":literal"><semantics><mrow><msub><mi>𝜽</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>α</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>Stab</mi><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>α</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">≃</mo><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi>C</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{\theta}}_{pq,\alpha}:{\rm Stab}_{{\mathcal{F}}_{pq,\alpha}}(C_{\alpha})\simeq\partial^{\alpha}C_{pq}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS7.p4.3" class="ltx_p"><span id="S3.SS7.p4.3.1" class="ltx_text">one obtains a section</span></p>
<table id="S3.Ex115" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex115.m1" class="ltx_Math" alttext="{\mathcal{S}}_{pq,\alpha}^{\prime}:\partial^{\alpha}{\mathcal{U}}_{pq}\to{\mathcal{E}}_{pq}|_{\partial^{\alpha}{\mathcal{U}}_{pq}}" display="block" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>α</mi></mrow><mo>′</mo></msubsup><mo lspace="0.278em" rspace="0.111em">:</mo><mrow><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo stretchy="false">→</mo><msub><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{S}}_{pq,\alpha}^{\prime}:\partial^{\alpha}{\mathcal{U}}_{pq}\to{\mathcal{E}}_{pq}|_{\partial^{\alpha}{\mathcal{U}}_{pq}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS7.p4.4" class="ltx_p"><span id="S3.SS7.p4.4.1" class="ltx_text">which is the stabilization of <math id="S3.SS7.p4.m6" class="ltx_Math" alttext="{\mathcal{S}}_{\alpha}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>α</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{S}}_{\alpha}^{\prime}</annotation></semantics></math>. We check the following conditions.</span></p>
<ol id="S3.I29" class="ltx_enumerate">
<li id="S3.I29.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S3.I29.i1.p1" class="ltx_para">
<p id="S3.I29.i1.p1.1" class="ltx_p">The collection of <math id="S3.I29.i1.p1.m1" class="ltx_Math" alttext="{\mathcal{S}}_{pq,\alpha}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>α</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{S}}_{pq,\alpha}^{\prime}</annotation></semantics></math> agree on overlaps. Indeed, for each pair of stratum <math id="S3.I29.i1.p1.m2" class="ltx_Math" alttext="\alpha\leq\beta" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">\alpha\leq\beta</annotation></semantics></math>, by the compatibility condition (see item (2) of Definition <a href="#S3.Thmthm48" title="Definition 3.48 (Perturbations on a derived orbifold lift). ‣ 3.7. Constructing FOP perturbations ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.48</span></a>) satisfied by the existing perturbations (which is assumed as induction hypothesis), one has</p>
<table id="S3.Ex116" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex116.m1" class="ltx_Math" alttext="{\mathcal{S}}_{\beta}^{\prime}|_{\partial^{\alpha}{\mathcal{U}}_{\beta}}={\rm Stab}_{{\mathcal{F}}_{\beta\alpha}}({\mathcal{S}}_{\alpha}^{\prime})." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>β</mi><mo>′</mo></msubsup><mo stretchy="false">|</mo></mrow><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>β</mi></msub></mrow></msub><mo>=</mo><mrow><msub><mi>Stab</mi><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>α</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{S}}_{\beta}^{\prime}|_{\partial^{\alpha}{\mathcal{U}}_{\beta}}={\rm Stab}_{{\mathcal{F}}_{\beta\alpha}}({\mathcal{S}}_{\alpha}^{\prime}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I29.i1.p1.2" class="ltx_p">Then by the definition of scaffolding (see Definition <a href="#S3.Thmthm28" title="Definition 3.28. ‣ 3.5.2. Scaffolding ‣ 3.5. Additional structures ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.28</span></a> and (<a href="#S3.E13" title="In item (D) ‣ Definition 3.28. ‣ 3.5.2. Scaffolding ‣ 3.5. Additional structures ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.13</span></a>)), one has</p>
<table id="S3.I29.i1.p1.3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.I29.i1.p1.m3" class="ltx_Math" alttext="{\mathcal{S}}_{pq,\beta}^{\prime}|_{\partial^{\alpha}{\mathcal{U}}_{pq}}={\rm Stab}_{{\mathcal{F}}_{pq,\beta}}({\mathcal{S}}_{\beta}^{\prime}|_{\partial^{\alpha}{\mathcal{U}}_{\beta}})={\rm Stab}_{{\mathcal{F}}_{pq,\beta}}({\rm Stab}_{{\mathcal{F}}_{\beta\alpha}}({\mathcal{S}}_{\alpha}^{\prime}))\\
={\rm Stab}_{{\mathcal{F}}_{pq,\alpha}}({\mathcal{S}}_{\alpha}^{\prime})={\mathcal{S}}_{pq,\alpha}^{\prime}." display="block" intent=":literal"><semantics><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>β</mi></mrow><mo>′</mo></msubsup><mo stretchy="false">|</mo></mrow><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></msub><mo>=</mo><mrow><msub><mi>Stab</mi><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>β</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>β</mi><mo>′</mo></msubsup><mo stretchy="false">|</mo></mrow><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>β</mi></msub></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>Stab</mi><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>β</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>Stab</mi><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>α</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>Stab</mi><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>α</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>α</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>α</mi></mrow><mo>′</mo></msubsup></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">{\mathcal{S}}_{pq,\beta}^{\prime}|_{\partial^{\alpha}{\mathcal{U}}_{pq}}={\rm Stab}_{{\mathcal{F}}_{pq,\beta}}({\mathcal{S}}_{\beta}^{\prime}|_{\partial^{\alpha}{\mathcal{U}}_{\beta}})={\rm Stab}_{{\mathcal{F}}_{pq,\beta}}({\rm Stab}_{{\mathcal{F}}_{\beta\alpha}}({\mathcal{S}}_{\alpha}^{\prime}))\\
={\rm Stab}_{{\mathcal{F}}_{pq,\alpha}}({\mathcal{S}}_{\alpha}^{\prime})={\mathcal{S}}_{pq,\alpha}^{\prime}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S3.I29.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S3.I29.i2.p1" class="ltx_para">
<p id="S3.I29.i2.p1.1" class="ltx_p">The collection of <math id="S3.I29.i2.p1.m1" class="ltx_Math" alttext="{\mathcal{S}}_{pq,\alpha}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>α</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{S}}_{pq,\alpha}^{\prime}</annotation></semantics></math> respect the collar structure. This is a consequence of the induction hypothesis and the fact that the scaffolding respects the collar structure (see Definition <a href="#S3.Thmthm34" title="Definition 3.34. ‣ 3.5.4. Compatibility ‣ 3.5. Additional structures ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.34</span></a>).</p>
</div></li>
<li id="S3.I29.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S3.I29.i3.p1" class="ltx_para">
<p id="S3.I29.i3.p1.1" class="ltx_p">Each <math id="S3.I29.i3.p1.m1" class="ltx_Math" alttext="{\mathcal{S}}_{pq,\alpha}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>α</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{S}}_{pq,\alpha}^{\prime}</annotation></semantics></math> is an FOP perturbation. This is a consequence of the compatibility condition on the additional structures (see Definition <a href="#S3.Thmthm35" title="Definition 3.35. ‣ 3.5.4. Compatibility ‣ 3.5. Additional structures ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.35</span></a>) which guarantees that the stabilization of an FOP section is still an FOP section.</p>
</div></li>
<li id="S3.I29.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S3.I29.i4.p1" class="ltx_para">
<p id="S3.I29.i4.p1.1" class="ltx_p">Each <math id="S3.I29.i4.p1.m1" class="ltx_Math" alttext="{\mathcal{S}}_{pq,\alpha}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>α</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{S}}_{pq,\alpha}^{\prime}</annotation></semantics></math> is strongly transverse within the interior of <math id="S3.I29.i4.p1.m2" class="ltx_Math" alttext="\partial^{\alpha}{\mathcal{U}}_{pq}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\partial^{\alpha}{\mathcal{U}}_{pq}</annotation></semantics></math>. Notice that</p>
<table id="S3.Ex117" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex117.m1" class="ltx_math_unparsed" alttext="{\rm Int}{\mathcal{U}}_{\alpha}={\rm Int}{\mathcal{U}}_{pr_{1}}\times\cdots\times{\rm Int}{\mathcal{U}}_{r_{l}q}." display="block" intent=":literal"><semantics><mrow><mi>Int</mi><mi class="ltx_font_mathcaligraphic">𝒰</mi><msub><mrow></mrow><mi>α</mi></msub><mo>=</mo><mi>Int</mi><mi class="ltx_font_mathcaligraphic">𝒰</mi><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi>Int</mi><mi class="ltx_font_mathcaligraphic">𝒰</mi><msub><mrow></mrow><mrow><msub><mi>r</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\rm Int}{\mathcal{U}}_{\alpha}={\rm Int}{\mathcal{U}}_{pr_{1}}\times\cdots\times{\rm Int}{\mathcal{U}}_{r_{l}q}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I29.i4.p1.2" class="ltx_p">Corollary <a href="#S2.Thmthm14" title="Corollary 2.14. ‣ 2.2.1. Products of transverse FOP sections ‣ 2.2. FOP sections and products ‣ 2. Recap of the FOP natural transformation and multiplicativity ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.14</span></a> implies that the restriction of <math id="S3.I29.i4.p1.m3" class="ltx_Math" alttext="{\mathcal{S}}_{\alpha}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>α</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{S}}_{\alpha}^{\prime}</annotation></semantics></math> to the interior of <math id="S3.I29.i4.p1.m4" class="ltx_Math" alttext="{\mathcal{U}}_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>α</mi></msub><annotation encoding="application/x-tex">{\mathcal{U}}_{\alpha}</annotation></semantics></math> is an FOP section. Moreover, as strong transversality is preserved under stabilization, we know that <math id="S3.I29.i4.p1.m5" class="ltx_Math" alttext="{\mathcal{S}}_{pq,\alpha}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>α</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{S}}_{pq,\alpha}^{\prime}</annotation></semantics></math> is strongly transverse within <math id="S3.I29.i4.p1.m6" class="ltx_Math" alttext="{\rm Int}\partial^{\alpha}{\mathcal{U}}_{pq}={\rm Stab}_{{\mathcal{F}}_{pq,\alpha}}({\rm Int}{\mathcal{U}}_{\alpha})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Int</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mrow><mo>=</mo><mrow><msub><mi>Stab</mi><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>α</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Int</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>α</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\rm Int}\partial^{\alpha}{\mathcal{U}}_{pq}={\rm Stab}_{{\mathcal{F}}_{pq,\alpha}}({\rm Int}{\mathcal{U}}_{\alpha})</annotation></semantics></math>.</p>
</div></li>
</ol>
<p id="S3.SS7.p4.5" class="ltx_p"><span id="S3.SS7.p4.5.1" class="ltx_text">Therefore, we can extend the collection of <math id="S3.SS7.p4.m7" class="ltx_Math" alttext="{\mathcal{S}}_{pq,\alpha}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>α</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{S}}_{pq,\alpha}^{\prime}</annotation></semantics></math> to a neighborhood of <math id="S3.SS7.p4.m8" class="ltx_Math" alttext="\partial{\mathcal{U}}_{pq}" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\partial{\mathcal{U}}_{pq}</annotation></semantics></math> using the collar structure, simply by pulling back the existing perturbations using the projection maps. Hence we have obtained a section <math id="S3.SS7.p4.m9" class="ltx_Math" alttext="{\mathcal{S}}_{pq}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{S}}_{pq}^{\prime}</annotation></semantics></math> of <math id="S3.SS7.p4.m10" class="ltx_Math" alttext="{\mathcal{E}}_{pq}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{pq}</annotation></semantics></math> defined in an open neighborhood of <math id="S3.SS7.p4.m11" class="ltx_Math" alttext="\partial{\mathcal{U}}_{pq}" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\partial{\mathcal{U}}_{pq}</annotation></semantics></math>. The conditions on the collar structure imply that the extension is well-defined. The compatibility between straightenings and the collar structure implies that the extension is still an FOP section. As we can extend strongly transverse FOP sections in the standard “CUDV” fashion (see the relative version of Proposition <a href="#S2.Thmthm10" title="Proposition 2.10. ‣ 2.1.3. FOP sections and strong transversality ‣ 2.1. Orbifolds and the canonical Whitney stratification on 𝒵_𝑑 ‣ 2. Recap of the FOP natural transformation and multiplicativity ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.10</span></a>), one can construct a strongly FOP perturbation <math id="S3.SS7.p4.m12" class="ltx_Math" alttext="{\mathcal{S}}_{pq}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{S}}_{pq}^{\prime}</annotation></semantics></math> which extends the existing ones near the boundary. The compactness assumption on <math id="S3.SS7.p4.m13" class="ltx_Math" alttext="{\mathcal{S}}_{pq}^{-1}(0)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{S}}_{pq}^{-1}(0)</annotation></semantics></math> implies that one can make the perturbed zero locus <math id="S3.SS7.p4.m14" class="ltx_Math" alttext="({\mathcal{S}}_{pq}^{\prime})^{-1}(0)" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">({\mathcal{S}}_{pq}^{\prime})^{-1}(0)</annotation></semantics></math> compact. The inductive construction can then be carried on. Moreover, the <math id="S3.SS7.p4.m15" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>-equivariance of the perturbation can be maintained in the induction process.
∎</span></p>
</div>
</div>
</section>
<section id="S3.SS8" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.8. </span>Chain complexes and maps over the integers</h3>

<div id="S3.SS8.p1" class="ltx_para">
<p id="S3.SS8.p1.1" class="ltx_p">We recall the notion of Novikov coefficient ring.</p>
</div>
<div id="S3.Thmthm50" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm50.2" class="ltx_text ltx_font_bold">Definition 3.50</span></span><span id="S3.Thmthm50.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm50.p1" class="ltx_para">
<ol id="S3.I30" class="ltx_enumerate">
<li id="S3.I30.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S3.I30.i1.p1" class="ltx_para">
<p id="S3.I30.i1.p1.1" class="ltx_p">The integral <span id="S3.I30.i1.p1.1.1" class="ltx_text ltx_font_bold">Novikov ring</span> is the ring of formal Laurent series in a single variable <math id="S3.I30.i1.p1.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> with integer coefficients, i.e.</p>
<table id="S3.Ex118" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex118.m1" class="ltx_math_unparsed" alttext="\Lambda:={\mathbb{Z}}[[T]][T^{-1}]=\Big\{{\mathfrak{x}}=\sum_{i=-m}^{\infty}a_{i}T^{i},\ {\rm where}\ m\in{\mathbb{Z}}\ {\rm and}\ a_{i}\in{\mathbb{Z}}\Big\}." display="block" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo>:=</mo><mi>ℤ</mi><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">]</mo></mrow><mrow><mo stretchy="false">[</mo><msup><mi>T</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">]</mo></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>𝔵</mi><mo rspace="0.111em">=</mo><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mrow><mo>−</mo><mi>m</mi></mrow></mrow><mi mathvariant="normal">∞</mi></munderover><msub><mi>a</mi><mi>i</mi></msub><msup><mi>T</mi><mi>i</mi></msup><mo rspace="0.667em">,</mo><mi>where</mi><mi>m</mi><mo>∈</mo><mi>ℤ</mi><mi>and</mi><msub><mi>a</mi><mi>i</mi></msub><mo>∈</mo><mi>ℤ</mi><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Lambda:={\mathbb{Z}}[[T]][T^{-1}]=\Big\{{\mathfrak{x}}=\sum_{i=-m}^{\infty}a_{i}T^{i},\ {\rm where}\ m\in{\mathbb{Z}}\ {\rm and}\ a_{i}\in{\mathbb{Z}}\Big\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S3.I30.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S3.I30.i2.p1" class="ltx_para">
<p id="S3.I30.i2.p1.1" class="ltx_p">The <span id="S3.I30.i2.p1.1.1" class="ltx_text ltx_font_bold">valuation</span> on <math id="S3.I30.i2.p1.m1" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> is the map</p>
<table id="S3.Ex119" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex119.m1" class="ltx_Math" alttext="{\rm val}:\Lambda\to{\mathbb{Z}},\ {\rm val}(\sum a_{i}T^{i})={\rm min}\left\{i\ |\ a_{i}\neq 0\right\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>val</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Λ</mi><mo stretchy="false">→</mo><mi>ℤ</mi></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mi>val</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" movablelimits="false">∑</mo><mrow><msub><mi>a</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mi>i</mi></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mi>i</mi><mo lspace="0.500em" rspace="0.500em">|</mo><mrow><msub><mi>a</mi><mi>i</mi></msub><mo>≠</mo><mn>0</mn></mrow><mo>}</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\rm val}:\Lambda\to{\mathbb{Z}},\ {\rm val}(\sum a_{i}T^{i})={\rm min}\left\{i\ |\ a_{i}\neq 0\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I30.i2.p1.2" class="ltx_p">Denote</p>
<table id="S3.Ex120" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex120.m1" class="ltx_Math" alttext="\Lambda_{0}:=\{{\mathfrak{x}}\in\Lambda\ |\ {\rm val}({\mathfrak{x}})=0\}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Λ</mi><mn>0</mn></msub><mo>:=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>𝔵</mi><mo>∈</mo><mi mathvariant="normal">Λ</mi></mrow><mo lspace="0.500em" rspace="0.500em">|</mo><mrow><mrow><mi>val</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝔵</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Lambda_{0}:=\{{\mathfrak{x}}\in\Lambda\ |\ {\rm val}({\mathfrak{x}})=0\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I30.i2.p1.3" class="ltx_p">and</p>
<table id="S3.Ex121" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex121.m1" class="ltx_Math" alttext="\Lambda_{+}:=\{{\mathfrak{x}}\in\Lambda\ |\ {\rm val}({\mathfrak{x}})&gt;0\}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Λ</mi><mo>+</mo></msub><mo>:=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>𝔵</mi><mo>∈</mo><mi mathvariant="normal">Λ</mi></mrow><mo lspace="0.500em" rspace="0.500em">|</mo><mrow><mrow><mi>val</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝔵</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Lambda_{+}:=\{{\mathfrak{x}}\in\Lambda\ |\ {\rm val}({\mathfrak{x}})&gt;0\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
</div>
</div>
<section id="S3.SS8.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">3.8.1. </span>The chain complexes</h4>

<div id="S3.SS8.SSS1.p1" class="ltx_para">
<p id="S3.SS8.SSS1.p1.1" class="ltx_p">Now we start to build the chain complexes and chain maps. First, associated to a poset <math id="S3.SS8.SSS1.p1.m1" class="ltx_Math" alttext="{\mathcal{P}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">{\mathcal{P}}</annotation></semantics></math> as in Setup <a href="#S3.Thmthm5" title="Setup 3.5. ‣ 3.2. Topological flow categories and bimodules ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.5</span></a>, one can define a <math id="S3.SS8.SSS1.p1.m2" class="ltx_Math" alttext="{\mathbb{Z}}/2N" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℤ</mi><mo>/</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">{\mathbb{Z}}/2N</annotation></semantics></math>-graded free <math id="S3.SS8.SSS1.p1.m3" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>-module as follows. Define</p>
<table id="S3.Ex122" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex122.m1" class="ltx_math_unparsed" alttext="C_{*}^{\mathcal{P}}:=\left\{\sum_{p\in{\mathcal{P}}}m_{p}p\ |\ m_{p}\in{\mathbb{Z}},\ \forall c&gt;0,\#\{p\ |\ m_{p}\neq 0,{\mathcal{A}}^{\mathcal{P}}(p)&lt;c\}&lt;\infty\right\}." display="block" intent=":literal"><semantics><mrow><msubsup><mi>C</mi><mo>∗</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><mo>:=</mo><mrow><mo>{</mo><munder><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>p</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow></munder><msub><mi>m</mi><mi>p</mi></msub><mi>p</mi><mo fence="false" lspace="0.500em" rspace="0.667em" stretchy="false">|</mo><msub><mi>m</mi><mi>p</mi></msub><mo>∈</mo><mi>ℤ</mi><mo rspace="0.667em">,</mo><mo rspace="0.167em">∀</mo><mi>c</mi><mo>&gt;</mo><mn>0</mn><mo>,</mo><mi>#</mi><mrow><mo stretchy="false">{</mo><mi>p</mi><mo fence="false" lspace="0.500em" rspace="0.667em" stretchy="false">|</mo><msub><mi>m</mi><mi>p</mi></msub><mo>≠</mo><mn>0</mn><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow><mo>&lt;</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi><mo>}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">C_{*}^{\mathcal{P}}:=\left\{\sum_{p\in{\mathcal{P}}}m_{p}p\ |\ m_{p}\in{\mathbb{Z}},\ \forall c&gt;0,\#\{p\ |\ m_{p}\neq 0,{\mathcal{A}}^{\mathcal{P}}(p)&lt;c\}&lt;\infty\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS8.SSS1.p1.2" class="ltx_p">This is a free abelian group graded by the index function <math id="S3.SS8.SSS1.p1.m4" class="ltx_Math" alttext="{\rm ind}^{\mathcal{P}}:{\mathcal{P}}\to{\mathbb{Z}}/2N" display="inline" intent=":literal"><semantics><mrow><msup><mi>ind</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">→</mo><mrow><mrow><mi>ℤ</mi><mo>/</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">{\rm ind}^{\mathcal{P}}:{\mathcal{P}}\to{\mathbb{Z}}/2N</annotation></semantics></math>. Define a <math id="S3.SS8.SSS1.p1.m5" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>-module structure on <math id="S3.SS8.SSS1.p1.m6" class="ltx_Math" alttext="C_{*}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mo>∗</mo></msub><annotation encoding="application/x-tex">C_{*}</annotation></semantics></math> by</p>
<table id="S3.Ex123" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex123.m1" class="ltx_Math" alttext="T^{a}\Big(\sum_{p\in{\mathcal{P}}}m_{p}p\Big):=\sum_{p\in{\mathcal{P}}}m_{p}(a\cdot p)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>T</mi><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>p</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow></munder><mrow><msub><mi>m</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo rspace="0.111em">:=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>p</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow></munder><mrow><msub><mi>m</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">T^{a}\Big(\sum_{p\in{\mathcal{P}}}m_{p}p\Big):=\sum_{p\in{\mathcal{P}}}m_{p}(a\cdot p).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS8.SSS1.p1.3" class="ltx_p">Conditions of Setup <a href="#S3.Thmthm5" title="Setup 3.5. ‣ 3.2. Topological flow categories and bimodules ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.5</span></a> implies that <math id="S3.SS8.SSS1.p1.m7" class="ltx_Math" alttext="C_{*}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mo>∗</mo></msub><annotation encoding="application/x-tex">C_{*}</annotation></semantics></math> is a <math id="S3.SS8.SSS1.p1.m8" class="ltx_Math" alttext="{\mathbb{Z}}/2N" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℤ</mi><mo>/</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">{\mathbb{Z}}/2N</annotation></semantics></math>-graded free <math id="S3.SS8.SSS1.p1.m9" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>-module whose rank is equal to the cardinality of <math id="S3.SS8.SSS1.p1.m10" class="ltx_Math" alttext="{\mathcal{P}}/\Pi" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>/</mo><mi mathvariant="normal">Π</mi></mrow><annotation encoding="application/x-tex">{\mathcal{P}}/\Pi</annotation></semantics></math>.</p>
</div>
<div id="S3.SS8.SSS1.p2" class="ltx_para">
<p id="S3.SS8.SSS1.p2.1" class="ltx_p">Isolated zeroes in the free locus of each oriented derived orbifold chart induce integer counts. More precisely, fix a strongly transverse FOP perturbation</p>
<table id="S3.Ex124" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex124.m1" class="ltx_math_unparsed" alttext="{\mathfrak{S}}^{\prime}:=\Big({\mathcal{S}}_{pq}^{\prime}:{\mathcal{U}}_{pq}\to{\mathcal{E}}_{pq}\Big)_{p&lt;q}." display="block" intent=":literal"><semantics><mrow><msup><mi>𝔖</mi><mo>′</mo></msup><mo>:=</mo><msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mi>p</mi><mo>&lt;</mo><mi>q</mi></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathfrak{S}}^{\prime}:=\Big({\mathcal{S}}_{pq}^{\prime}:{\mathcal{U}}_{pq}\to{\mathcal{E}}_{pq}\Big)_{p&lt;q}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS8.SSS1.p2.2" class="ltx_p">For each pair <math id="S3.SS8.SSS1.p2.m1" class="ltx_Math" alttext="p&lt;q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p&lt;q</annotation></semantics></math>, we can write</p>
<table id="S3.Ex125" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex125.m1" class="ltx_Math" alttext="{\mathcal{U}}_{pq}=\bigsqcup_{i=-\infty}^{+\infty}{\mathcal{U}}_{pq}^{[i]}" display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">⨆</mo><mrow><mi>i</mi><mo>=</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></munderover><msubsup><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">[</mo><mi>i</mi><mo stretchy="false">]</mo></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{U}}_{pq}=\bigsqcup_{i=-\infty}^{+\infty}{\mathcal{U}}_{pq}^{[i]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS8.SSS1.p2.3" class="ltx_p">where <math id="S3.SS8.SSS1.p2.m2" class="ltx_Math" alttext="{\mathcal{U}}_{pq}^{[i]}\subset{\mathcal{U}}_{pq}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">[</mo><mi>i</mi><mo stretchy="false">]</mo></mrow></msubsup><mo>⊂</mo><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">{\mathcal{U}}_{pq}^{[i]}\subset{\mathcal{U}}_{pq}</annotation></semantics></math> is the open and closed subset of points whose local virtual dimension is <math id="S3.SS8.SSS1.p2.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>. It follows from (<a href="#S3.E5" title="In item 1 ‣ Definition 3.24. ‣ 3.4.4. Derived orbifold lifts of flow categories and bimodules ‣ 3.4. Derived orbifold charts with stratifications ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.5</span></a>) that</p>
<table id="S3.Ex126" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex126.m1" class="ltx_Math" alttext="{\mathcal{U}}_{pq}^{[i]}\neq\emptyset\Longrightarrow i\equiv{\rm ind}^{\mathcal{P}}(p)-{\rm ind}^{\mathcal{P}}(q)-1\ {\rm mod}\ 2N." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">[</mo><mi>i</mi><mo stretchy="false">]</mo></mrow></msubsup><mo>≠</mo><mi mathvariant="normal">∅</mi><mo stretchy="false">⟹</mo><mi>i</mi><mo>≡</mo><mrow><mrow><msup><mi>ind</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>ind</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mn>1</mn><mo lspace="0.500em" rspace="0em">​</mo><mi>mod</mi><mo lspace="0em" rspace="0em">​</mo><mn> 2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{U}}_{pq}^{[i]}\neq\emptyset\Longrightarrow i\equiv{\rm ind}^{\mathcal{P}}(p)-{\rm ind}^{\mathcal{P}}(q)-1\ {\rm mod}\ 2N.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS8.SSS1.p2.4" class="ltx_p">Then let <math id="S3.SS8.SSS1.p2.m4" class="ltx_Math" alttext="n_{pq}" display="inline" intent=":literal"><semantics><msub><mi>n</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">n_{pq}</annotation></semantics></math> be the count (with signs) of zeroes of <math id="S3.SS8.SSS1.p2.m5" class="ltx_Math" alttext="{\mathcal{S}}_{pq}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{S}}_{pq}^{\prime}</annotation></semantics></math> in the free locus of the zero-dimensional component <math id="S3.SS8.SSS1.p2.m6" class="ltx_Math" alttext="{\mathcal{U}}_{pq}^{[0]}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">[</mo><mn>0</mn><mo stretchy="false">]</mo></mrow></msubsup><annotation encoding="application/x-tex">{\mathcal{U}}_{pq}^{[0]}</annotation></semantics></math>. The sign of an isolated zero point of <math id="S3.SS8.SSS1.p2.m7" class="ltx_Math" alttext="{\mathcal{S}}_{pq}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{S}}_{pq}^{\prime}</annotation></semantics></math> is uniquely determined by the sign read off from the isomorphism (<a href="#S3.E15" title="In item 2 ‣ Definition 3.43. ‣ 3.6. Normal complex structure and orientations on flow categories ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.15</span></a>). The compactness assumption (see item (3) of Definition <a href="#S3.Thmthm7" title="Definition 3.7. ‣ 3.2. Topological flow categories and bimodules ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.7</span></a>) implies that <math id="S3.SS8.SSS1.p2.m8" class="ltx_Math" alttext="n_{pq}" display="inline" intent=":literal"><semantics><msub><mi>n</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">n_{pq}</annotation></semantics></math> is finite. Moreover, by the finiteness of <math id="S3.SS8.SSS1.p2.m9" class="ltx_Math" alttext="{\mathcal{P}}/\Pi" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>/</mo><mi mathvariant="normal">Π</mi></mrow><annotation encoding="application/x-tex">{\mathcal{P}}/\Pi</annotation></semantics></math> and the compactness condition, these counts define a <math id="S3.SS8.SSS1.p2.m10" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>-linear map</p>
<table id="S3.Ex127" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex127.m1" class="ltx_Math" alttext="d^{\mathcal{P}}:C_{*}^{\mathcal{P}}\to C_{*-1}^{\mathcal{P}}." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>C</mi><mo>∗</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><mo stretchy="false">→</mo><msubsup><mi>C</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∗</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">d^{\mathcal{P}}:C_{*}^{\mathcal{P}}\to C_{*-1}^{\mathcal{P}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS8.SSS1.p2.5" class="ltx_p">The <math id="S3.SS8.SSS1.p2.m11" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>-equivariance of the perturbation implies that</p>
<table id="S3.Ex128" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex128.m1" class="ltx_Math" alttext="n_{pq}=n_{a\cdot p\ a\cdot q},\ \forall a\in{\mathbb{Z}}\ and\ p,q\in{\mathcal{P}}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>n</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>=</mo><msub><mi>n</mi><mrow><mrow><mrow><mi>a</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><mo lspace="0.410em" rspace="0em">​</mo><mi>a</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>q</mi></mrow></msub></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>a</mi></mrow><mo>∈</mo><mrow><mi>ℤ</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>p</mi></mrow></mrow><mo>,</mo><mrow><mi>q</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow></mrow><annotation encoding="application/x-tex">n_{pq}=n_{a\cdot p\ a\cdot q},\ \forall a\in{\mathbb{Z}}\ and\ p,q\in{\mathcal{P}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS8.SSS1.p2.6" class="ltx_p">which further implies that <math id="S3.SS8.SSS1.p2.m12" class="ltx_Math" alttext="d^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">d^{\mathcal{P}}</annotation></semantics></math> is <math id="S3.SS8.SSS1.p2.m13" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>-linear. By looking at 1-dimensional components of all derived orbifold charts, using the coherence of the orientations (<a href="#S3.E16" title="In item 3 ‣ Definition 3.43. ‣ 3.6. Normal complex structure and orientations on flow categories ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.16</span></a>), one can see that <math id="S3.SS8.SSS1.p2.m14" class="ltx_Math" alttext="d^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">d^{\mathcal{P}}</annotation></semantics></math> is a differential map, i.e., <math id="S3.SS8.SSS1.p2.m15" class="ltx_Math" alttext="d^{\mathcal{P}}\circ d^{\mathcal{P}}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d^{\mathcal{P}}\circ d^{\mathcal{P}}=0</annotation></semantics></math>. Therefore, one obtains a chain complex</p>
<table id="S3.Ex129" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex129.m1" class="ltx_Math" alttext="(C_{*}^{\mathcal{P}},d^{\mathcal{P}})" display="block" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mo>∗</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><mo>,</mo><msup><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(C_{*}^{\mathcal{P}},d^{\mathcal{P}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS8.SSS1.p2.7" class="ltx_p">of <math id="S3.SS8.SSS1.p2.m16" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>-modules. One hence obtains the homology</p>
<table id="S3.Ex130" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex130.m1" class="ltx_Math" alttext="H_{*}^{\mathcal{P}}=\bigoplus_{i\in{\mathbb{Z}}/2N}H_{i}^{\mathcal{P}}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>H</mi><mo>∗</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mrow><mi>ℤ</mi><mo>/</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow></munder><msubsup><mi>H</mi><mi>i</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">H_{*}^{\mathcal{P}}=\bigoplus_{i\in{\mathbb{Z}}/2N}H_{i}^{\mathcal{P}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS8.SSS1.p2.8" class="ltx_p">which has a natural <math id="S3.SS8.SSS1.p2.m17" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>-module structure. One can show that the chain homotopy equivalence class of the chain complex does not depend on the choice of the perturbations. We omit the details because such a fact is not needed in our application.</p>
</div>
</section>
<section id="S3.SS8.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">3.8.2. </span>The chain maps</h4>

<div id="S3.SS8.SSS2.p1" class="ltx_para">
<p id="S3.SS8.SSS2.p1.1" class="ltx_p">Now suppose we have two topological flow categories, <math id="S3.SS8.SSS2.p1.m1" class="ltx_Math" alttext="T^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">T^{\mathcal{P}}</annotation></semantics></math> over <math id="S3.SS8.SSS2.p1.m2" class="ltx_Math" alttext="{\mathcal{P}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">{\mathcal{P}}</annotation></semantics></math> and <math id="S3.SS8.SSS2.p1.m3" class="ltx_Math" alttext="T^{{\mathcal{P}}^{\prime}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msup><annotation encoding="application/x-tex">T^{{\mathcal{P}}^{\prime}}</annotation></semantics></math> over <math id="S3.SS8.SSS2.p1.m4" class="ltx_Math" alttext="{\mathcal{P}}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup><annotation encoding="application/x-tex">{\mathcal{P}}^{\prime}</annotation></semantics></math> and a flow bimodule <math id="S3.SS8.SSS2.p1.m5" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> from <math id="S3.SS8.SSS2.p1.m6" class="ltx_Math" alttext="T^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">T^{\mathcal{P}}</annotation></semantics></math> to <math id="S3.SS8.SSS2.p1.m7" class="ltx_Math" alttext="T^{{\mathcal{P}}^{\prime}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msup><annotation encoding="application/x-tex">T^{{\mathcal{P}}^{\prime}}</annotation></semantics></math>.</p>
</div>
<div id="S3.Thmthm51" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm51.2" class="ltx_text ltx_font_bold">Theorem 3.51</span></span><span id="S3.Thmthm51.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm51.p1" class="ltx_para">
<p id="S3.Thmthm51.p1.1" class="ltx_p"><span id="S3.Thmthm51.p1.1.1" class="ltx_text ltx_font_italic">Assume the following conditions.</span></p>
<ol id="S3.I31" class="ltx_enumerate">
<li id="S3.I31.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S3.I31.i1.p1" class="ltx_para">
<p id="S3.I31.i1.p1.1" class="ltx_p"><span id="S3.I31.i1.p1.1.1" class="ltx_text ltx_font_italic">There is an oriented and normally complex derived orbifold lift </span><math id="S3.I31.i1.p1.m1" class="ltx_Math" alttext="{\mathfrak{D}}^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\mathcal{P}}</annotation></semantics></math><span id="S3.I31.i1.p1.1.2" class="ltx_text ltx_font_italic"> resp. </span><math id="S3.I31.i1.p1.m2" class="ltx_Math" alttext="{\mathfrak{D}}^{{\mathcal{P}}^{\prime}}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{{\mathcal{P}}^{\prime}}</annotation></semantics></math><span id="S3.I31.i1.p1.1.3" class="ltx_text ltx_font_italic"> of </span><math id="S3.I31.i1.p1.m3" class="ltx_Math" alttext="T^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">T^{\mathcal{P}}</annotation></semantics></math><span id="S3.I31.i1.p1.1.4" class="ltx_text ltx_font_italic"> resp. </span><math id="S3.I31.i1.p1.m4" class="ltx_Math" alttext="T^{{\mathcal{P}}^{\prime}}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msup><annotation encoding="application/x-tex">T^{{\mathcal{P}}^{\prime}}</annotation></semantics></math><span id="S3.I31.i1.p1.1.5" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S3.I31.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S3.I31.i2.p1" class="ltx_para">
<p id="S3.I31.i2.p1.1" class="ltx_p"><span id="S3.I31.i2.p1.1.1" class="ltx_text ltx_font_italic">There is an oriented and normally complex derived orbifold lift </span><math id="S3.I31.i2.p1.m1" class="ltx_Math" alttext="{\mathfrak{D}}_{{\mathcal{P}}{\mathcal{P}}^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>𝔇</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">{\mathfrak{D}}_{{\mathcal{P}}{\mathcal{P}}^{\prime}}</annotation></semantics></math><span id="S3.I31.i2.p1.1.2" class="ltx_text ltx_font_italic"> of </span><math id="S3.I31.i2.p1.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math><span id="S3.I31.i2.p1.1.3" class="ltx_text ltx_font_italic"> which extends </span><math id="S3.I31.i2.p1.m3" class="ltx_Math" alttext="{\mathfrak{D}}^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\mathcal{P}}</annotation></semantics></math><span id="S3.I31.i2.p1.1.4" class="ltx_text ltx_font_italic"> and </span><math id="S3.I31.i2.p1.m4" class="ltx_Math" alttext="{\mathfrak{D}}^{{\mathcal{P}}^{\prime}}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{{\mathcal{P}}^{\prime}}</annotation></semantics></math><span id="S3.I31.i2.p1.1.5" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S3.I31.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S3.I31.i3.p1" class="ltx_para">
<p id="S3.I31.i3.p1.1" class="ltx_p"><span id="S3.I31.i3.p1.1.1" class="ltx_text ltx_font_italic">On these derived orbifold lifts there exist compatible collar structures, scaffoldings, and straightenings.</span></p>
</div></li>
</ol>
<p id="S3.Thmthm51.p1.2" class="ltx_p"><span id="S3.Thmthm51.p1.2.1" class="ltx_text ltx_font_italic">Suppose we are given a strongly transverse FOP perturbation on <math id="S3.Thmthm51.p1.m1" class="ltx_Math" alttext="{\mathfrak{D}}^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\mathcal{P}}</annotation></semantics></math> and a strongly transverse FOP perturbation on <math id="S3.Thmthm51.p1.m2" class="ltx_Math" alttext="{\mathfrak{D}}^{{\mathcal{P}}^{\prime}}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{{\mathcal{P}}^{\prime}}</annotation></semantics></math>. Then there exists a strongly transverse FOP perturbation on <math id="S3.Thmthm51.p1.m3" class="ltx_Math" alttext="{\mathfrak{D}}_{{\mathcal{P}}{\mathcal{P}}^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>𝔇</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">{\mathfrak{D}}_{{\mathcal{P}}{\mathcal{P}}^{\prime}}</annotation></semantics></math> which extends the existing ones which is <math id="S3.Thmthm51.p1.m4" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>-invariant.</span></p>
</div>
</div>
<div id="S3.SS8.SSS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS8.SSS2.p2" class="ltx_para">
<p id="S3.SS8.SSS2.p2.1" class="ltx_p"><span id="S3.SS8.SSS2.p2.1.1" class="ltx_text">This theorem is essentially a relative version of Theorem <a href="#S3.Thmthm49" title="Theorem 3.49. ‣ 3.7. Constructing FOP perturbations ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.49</span></a> and the proof is the same as we can always extend strongly transverse FOP perturbations from local to global using the standard “CUDV” fashion (see the relative version of Proposition <a href="#S2.Thmthm10" title="Proposition 2.10. ‣ 2.1.3. FOP sections and strong transversality ‣ 2.1. Orbifolds and the canonical Whitney stratification on 𝒵_𝑑 ‣ 2. Recap of the FOP natural transformation and multiplicativity ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.10</span></a>).
∎</span></p>
</div>
</div>
<div id="S3.SS8.SSS2.p3" class="ltx_para">
<p id="S3.SS8.SSS2.p3.1" class="ltx_p">Now under the assumptions of Theorem <a href="#S3.Thmthm51" title="Theorem 3.51. ‣ 3.8.2. The chain maps ‣ 3.8. Chain complexes and maps over the integers ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.51</span></a>, the existing strongly transverse FOP perturbations induce chain complexes</p>
<table id="S3.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex131"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex131.m1" class="ltx_Math" alttext="\displaystyle\ (C_{*}^{\mathcal{P}},d^{\mathcal{P}}),\ " display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mo>∗</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><mo>,</mo><msup><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ (C_{*}^{\mathcal{P}},d^{\mathcal{P}}),\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex131.m2" class="ltx_Math" alttext="\displaystyle\ (C_{*}^{{\mathcal{P}}^{\prime}},d^{{\mathcal{P}}^{\prime}})." display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mo>∗</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msubsup><mo>,</mo><msup><mi>d</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ (C_{*}^{{\mathcal{P}}^{\prime}},d^{{\mathcal{P}}^{\prime}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS8.SSS2.p3.2" class="ltx_p">We would like to define a chain map using the extended FOP perturbations on <math id="S3.SS8.SSS2.p3.m1" class="ltx_Math" alttext="{\mathfrak{D}}_{{\mathcal{P}}{\mathcal{P}}^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>𝔇</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">{\mathfrak{D}}_{{\mathcal{P}}{\mathcal{P}}^{\prime}}</annotation></semantics></math>. Indeed, for <math id="S3.SS8.SSS2.p3.m2" class="ltx_Math" alttext="p\in{\mathcal{P}}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow><annotation encoding="application/x-tex">p\in{\mathcal{P}}</annotation></semantics></math> and <math id="S3.SS8.SSS2.p3.m3" class="ltx_Math" alttext="p^{\prime}\in{\mathcal{P}}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>p</mi><mo>′</mo></msup><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">p^{\prime}\in{\mathcal{P}}^{\prime}</annotation></semantics></math>, consider the perturbation</p>
<table id="S3.Ex132" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex132.m1" class="ltx_Math" alttext="{\mathcal{S}}_{pp^{\prime}}^{\prime}:{\mathcal{U}}_{pp^{\prime}}\to{\mathcal{E}}_{pp^{\prime}}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mo>′</mo></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{S}}_{pp^{\prime}}^{\prime}:{\mathcal{U}}_{pp^{\prime}}\to{\mathcal{E}}_{pp^{\prime}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS8.SSS2.p3.3" class="ltx_p">Let <math id="S3.SS8.SSS2.p3.m4" class="ltx_Math" alttext="n_{pp^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>n</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">n_{pp^{\prime}}</annotation></semantics></math> be the count (with signs read off from the isomorphism between orientation lines (<a href="#S3.E17" title="In item 1 ‣ Definition 3.47. ‣ 3.6. Normal complex structure and orientations on flow categories ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.17</span></a>)) of zeros of <math id="S3.SS8.SSS2.p3.m5" class="ltx_Math" alttext="{\mathcal{S}}_{pp^{\prime}}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">{\mathcal{S}}_{pp^{\prime}}^{\prime}</annotation></semantics></math> in the free locus of all components of <math id="S3.SS8.SSS2.p3.m6" class="ltx_Math" alttext="{\mathcal{U}}_{pp^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">{\mathcal{U}}_{pp^{\prime}}</annotation></semantics></math> with local virtual dimension zero. The compactness condition on <math id="S3.SS8.SSS2.p3.m7" class="ltx_Math" alttext="M_{pp^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">M_{pp^{\prime}}</annotation></semantics></math> (see Definition <a href="#S3.Thmthm10" title="Definition 3.10. ‣ 3.2.1. Flow bimodules ‣ 3.2. Topological flow categories and bimodules ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.10</span></a>) implies that <math id="S3.SS8.SSS2.p3.m8" class="ltx_Math" alttext="n_{pp^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>n</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">n_{pp^{\prime}}</annotation></semantics></math> is finite. Moreover, (<a href="#S3.E7" title="In item 1 ‣ Definition 3.25. ‣ 3.4.4. Derived orbifold lifts of flow categories and bimodules ‣ 3.4. Derived orbifold charts with stratifications ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.7</span></a>) implies that</p>
<table id="S3.Ex133" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex133.m1" class="ltx_Math" alttext="n_{pp^{\prime}}\neq 0\Longrightarrow{\rm ind}^{\mathcal{P}}(p)\equiv{\rm ind}^{{\mathcal{P}}^{\prime}}(p^{\prime})\ {\rm mod}\ 2N." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>n</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub><mo>≠</mo><mn>0</mn><mo stretchy="false">⟹</mo><mrow><msup><mi>ind</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≡</mo><mrow><msup><mi>ind</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>p</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0.500em" rspace="0em">​</mo><mi>mod</mi><mo lspace="0em" rspace="0em">​</mo><mn> 2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">n_{pp^{\prime}}\neq 0\Longrightarrow{\rm ind}^{\mathcal{P}}(p)\equiv{\rm ind}^{{\mathcal{P}}^{\prime}}(p^{\prime})\ {\rm mod}\ 2N.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS8.SSS2.p3.4" class="ltx_p">Then we formally define</p>
<table id="S3.Ex134" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex134.m1" class="ltx_Math" alttext="\Psi^{M}:C_{*}^{\mathcal{P}}\to C_{*}^{{\mathcal{P}^{\prime}}}" display="block" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Ψ</mi><mi>M</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>C</mi><mo>∗</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><mo stretchy="false">→</mo><msubsup><mi>C</mi><mo>∗</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msubsup></mrow></mrow><annotation encoding="application/x-tex">\Psi^{M}:C_{*}^{\mathcal{P}}\to C_{*}^{{\mathcal{P}^{\prime}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS8.SSS2.p3.5" class="ltx_p">by linearly extending</p>
<table id="S3.Ex135" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex135.m1" class="ltx_Math" alttext="\Psi^{M}(p)=\sum_{p^{\prime}\in{\mathcal{P}}^{\prime}}n_{pp^{\prime}}p^{\prime}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi mathvariant="normal">Ψ</mi><mi>M</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>p</mi><mo>′</mo></msup><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></mrow></munder><mrow><msub><mi>n</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Psi^{M}(p)=\sum_{p^{\prime}\in{\mathcal{P}}^{\prime}}n_{pp^{\prime}}p^{\prime}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS8.SSS2.p3.6" class="ltx_p">We claim that the above is a legitimate element of <math id="S3.SS8.SSS2.p3.m9" class="ltx_Math" alttext="C_{*}^{{\mathcal{P}}^{\prime}}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mo>∗</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msubsup><annotation encoding="application/x-tex">C_{*}^{{\mathcal{P}}^{\prime}}</annotation></semantics></math>. Indeed, this is a consequence of the condition (<a href="#S3.E4" title="In item 1 ‣ Definition 3.10. ‣ 3.2.1. Flow bimodules ‣ 3.2. Topological flow categories and bimodules ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.4</span></a>) of Definition <a href="#S3.Thmthm10" title="Definition 3.10. ‣ 3.2.1. Flow bimodules ‣ 3.2. Topological flow categories and bimodules ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.10</span></a> and the finiteness of <math id="S3.SS8.SSS2.p3.m10" class="ltx_Math" alttext="{\mathcal{P}}^{\prime}/\Pi" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup><mo>/</mo><mi mathvariant="normal">Π</mi></mrow><annotation encoding="application/x-tex">{\mathcal{P}}^{\prime}/\Pi</annotation></semantics></math>. Hence <math id="S3.SS8.SSS2.p3.m11" class="ltx_Math" alttext="\Psi^{M}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Ψ</mi><mi>M</mi></msup><annotation encoding="application/x-tex">\Psi^{M}</annotation></semantics></math> is a well-defined morphisms of graded abelian group. Moreover, by the <math id="S3.SS8.SSS2.p3.m12" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>-equivariance of all structures, one has</p>
<table id="S3.Ex136" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex136.m1" class="ltx_Math" alttext="n_{pp^{\prime}}=n_{a\cdot p\ n\cdot p^{\prime}},\ \forall a\in\Pi." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>n</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub><mo>=</mo><msub><mi>n</mi><mrow><mrow><mrow><mi>a</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><mo lspace="0.410em" rspace="0em">​</mo><mi>n</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>a</mi></mrow><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">n_{pp^{\prime}}=n_{a\cdot p\ n\cdot p^{\prime}},\ \forall a\in\Pi.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS8.SSS2.p3.7" class="ltx_p">Hence <math id="S3.SS8.SSS2.p3.m13" class="ltx_Math" alttext="\Psi^{M}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Ψ</mi><mi>M</mi></msup><annotation encoding="application/x-tex">\Psi^{M}</annotation></semantics></math> is <math id="S3.SS8.SSS2.p3.m14" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>-linear. Lastly, by the description of codimension one stratum of all bimodule moduli spaces and the coherence of orientations (<a href="#S3.E18" title="In item 2 ‣ Definition 3.47. ‣ 3.6. Normal complex structure and orientations on flow categories ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.18</span></a>) and (<a href="#S3.E19" title="In item 3 ‣ Definition 3.47. ‣ 3.6. Normal complex structure and orientations on flow categories ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.19</span></a>), similar to the case of <math id="S3.SS8.SSS2.p3.m15" class="ltx_Math" alttext="d^{\mathcal{P}}\circ d^{\mathcal{P}}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d^{\mathcal{P}}\circ d^{\mathcal{P}}=0</annotation></semantics></math>, one has that <math id="S3.SS8.SSS2.p3.m16" class="ltx_Math" alttext="\Psi^{M}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Ψ</mi><mi>M</mi></msup><annotation encoding="application/x-tex">\Psi^{M}</annotation></semantics></math> is a chain map, i.e.,</p>
<table id="S3.Ex137" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex137.m1" class="ltx_Math" alttext="\Psi^{M}\circ d^{\mathcal{P}}=d^{{\mathcal{P}}^{\prime}}\circ\Psi^{M}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi mathvariant="normal">Ψ</mi><mi>M</mi></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup></mrow><mo>=</mo><mrow><msup><mi>d</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi mathvariant="normal">Ψ</mi><mi>M</mi></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Psi^{M}\circ d^{\mathcal{P}}=d^{{\mathcal{P}}^{\prime}}\circ\Psi^{M}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.Thmthm52" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm52.2" class="ltx_text ltx_font_italic">Remark 3.52</span></span><span id="S3.Thmthm52.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S3.Thmthm52.p1" class="ltx_para">
<p id="S3.Thmthm52.p1.1" class="ltx_p">We would like to remark that the definitions of <math id="S3.Thmthm52.p1.m1" class="ltx_Math" alttext="d^{\mathcal{P}}" display="inline" intent=":literal"><semantics><msup><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><annotation encoding="application/x-tex">d^{\mathcal{P}}</annotation></semantics></math> and <math id="S3.Thmthm52.p1.m2" class="ltx_Math" alttext="\Psi^{M}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Ψ</mi><mi>M</mi></msup><annotation encoding="application/x-tex">\Psi^{M}</annotation></semantics></math> from counting points in moduli spaces of virtual dimension <math id="S3.Thmthm52.p1.m3" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>, and the usual proof for <math id="S3.Thmthm52.p1.m4" class="ltx_Math" alttext="(d^{\mathcal{P}})^{2}=0" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><msup><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">(d^{\mathcal{P}})^{2}=0</annotation></semantics></math> and <math id="S3.Thmthm52.p1.m5" class="ltx_Math" alttext="d^{\mathcal{P}^{\prime}}\circ\Psi^{M}=\Psi^{M}\circ d^{\mathcal{P}}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>d</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi mathvariant="normal">Ψ</mi><mi>M</mi></msup></mrow><mo>=</mo><mrow><msup><mi mathvariant="normal">Ψ</mi><mi>M</mi></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>d</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msup></mrow></mrow><annotation encoding="application/x-tex">d^{\mathcal{P}^{\prime}}\circ\Psi^{M}=\Psi^{M}\circ d^{\mathcal{P}}</annotation></semantics></math> from counting the boundary points of moduli spaces of virtual dimension <math id="S3.Thmthm52.p1.m6" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> works in our setting, because the pseudocycle condition on the free locus of <math id="S3.Thmthm52.p1.m7" class="ltx_Math" alttext="({\mathcal{S}}_{pq}^{\prime})^{-1}(0)" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">({\mathcal{S}}_{pq}^{\prime})^{-1}(0)</annotation></semantics></math> guarantees that the topological boundary <math id="S3.Thmthm52.p1.m8" class="ltx_Math" alttext="\partial(({\mathcal{S}}_{pq}^{\prime})^{-1}(0))^{\rm free}" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>free</mi></msup></mrow><annotation encoding="application/x-tex">\partial(({\mathcal{S}}_{pq}^{\prime})^{-1}(0))^{\rm free}</annotation></semantics></math> has codimension at least <math id="S3.Thmthm52.p1.m9" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> so the desired compactness property, therefore the finiteness of algebraic counts holds.</p>
</div>
</div>
</section>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4. </span>Proof of the integral Arnold conjecture</h2>

<div id="S4.p1" class="ltx_para">
<p id="S4.p1.1" class="ltx_p">In this section, we define the topological flow category associated with a non-degenerate Hamiltonian and the topological flow category constructed from a Morse–Smale function. Then we define two bimodules between these two flow categories, which are respectively the space-level lifts of the well-known Piunikhin–Salamon–Schwarz map (the PSS map) and its inverse (the SSP map). We state in Theorem <a href="#S4.Thmthm7" title="Theorem 4.7. ‣ 4.5. Main Theorems ‣ 4. Proof of the integral Arnold conjecture ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.7</span></a> the most important technical result in this paper, namely, the existence of derived orbifold lifts of the aforementioned objects, whose proof is contained in later sections. Finally, we explain how to use the perturbation scheme developed in Section <a href="#S2" title="2. Recap of the FOP natural transformation and multiplicativity ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> and Section <a href="#S3" title="3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> to prove Theorem <a href="#Thmthma1" title="Theorem A. ‣ 1. Introduction ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A</span></a>.</p>
</div>
<div id="S4.p2" class="ltx_para">
<p id="S4.p2.1" class="ltx_p">The following is the standing assumption of our discussions later on.</p>
</div>
<div id="S4.Thmthm1" class="ltx_theorem ltx_theorem_hyp">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm1.2" class="ltx_text ltx_font_italic">Hypothesis 4.1</span></span><span id="S4.Thmthm1.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S4.Thmthm1.p1" class="ltx_para">
<ol id="S4.I1" class="ltx_enumerate">
<li id="S4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I1.i1.p1" class="ltx_para">
<p id="S4.I1.i1.p1.1" class="ltx_p">The symplectic manifold <math id="S4.I1.i1.p1.m1" class="ltx_Math" alttext="(M,\omega)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>ω</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(M,\omega)</annotation></semantics></math> is integral, i.e., the de Rham cohomology class <math id="S4.I1.i1.p1.m2" class="ltx_Math" alttext="[\omega]\in H_{dR}^{2}(M)\cong H^{2}(M;{\mathbb{R}})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mi>ω</mi><mo stretchy="false">]</mo></mrow><mo>∈</mo><mrow><msubsup><mi>H</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msup><mi>H</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>ℝ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">[\omega]\in H_{dR}^{2}(M)\cong H^{2}(M;{\mathbb{R}})</annotation></semantics></math> lies in the image of <math id="S4.I1.i1.p1.m3" class="ltx_Math" alttext="H^{2}(M;{\mathbb{Z}})\to H^{2}(M;{\mathbb{R}})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>ℤ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>ℝ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H^{2}(M;{\mathbb{Z}})\to H^{2}(M;{\mathbb{R}})</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I1.i2.p1" class="ltx_para">
<p id="S4.I1.i2.p1.1" class="ltx_p"><math id="S4.I1.i2.p1.m1" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> is a nondegenerate Hamiltonian on <math id="S4.I1.i2.p1.m2" class="ltx_Math" alttext="(M,\omega)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>ω</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(M,\omega)</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S4.I1.i3.p1" class="ltx_para">
<p id="S4.I1.i3.p1.1" class="ltx_p">All 1-periodic orbits of <math id="S4.I1.i3.p1.m1" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> are embedded and any two of them are disjoint.</p>
</div></li>
<li id="S4.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S4.I1.i4.p1" class="ltx_para">
<p id="S4.I1.i4.p1.1" class="ltx_p">The symplectic actions (<a href="#S4.E1" title="In 4.1.1. The moduli spaces of Floer trajectories ‣ 4.1. Hamiltonian Floer flow categories ‣ 4. Proof of the integral Arnold conjecture ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>) of all capped 1-periodic orbits are integral.</p>
</div></li>
<li id="S4.I1.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(5)</span> 
<div id="S4.I1.i5.p1" class="ltx_para">
<p id="S4.I1.i5.p1.1" class="ltx_p"><math id="S4.I1.i5.p1.m1" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math> is a time-independent <math id="S4.I1.i5.p1.m2" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math>-compatible almost complex structure such that for all Floer trajectories with smooth domains (i.e., no sphere bubbles are attached and the trajectories are not broken) <math id="S4.I1.i5.p1.m3" class="ltx_Math" alttext="u:\Theta\to X" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Θ</mi><mo stretchy="false">→</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">u:\Theta\to X</annotation></semantics></math>, the linearized operator is surjective.</p>
</div></li>
</ol>
</div>
</div>
<div id="S4.p3" class="ltx_para">
<p id="S4.p3.1" class="ltx_p">We explain why it suffices to prove the Arnold conjecture under these assumptions in order to establish it in full generality.</p>
</div>
<div id="S4.p4" class="ltx_para">
<ol id="S4.I2" class="ltx_enumerate">
<li id="S4.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I2.i1.p1" class="ltx_para">
<p id="S4.I2.i1.p1.1" class="ltx_p">As we explained in the introduction of this paper, the case of Arnold conjecture for which <math id="S4.I2.i1.p1.m1" class="ltx_Math" alttext="[\omega]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mi>ω</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[\omega]</annotation></semantics></math> is rational implies the general case, and this is equivalent to the case when <math id="S4.I2.i1.p1.m2" class="ltx_Math" alttext="[\omega]\in H^{2}(M;\mathbb{Z})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mi>ω</mi><mo stretchy="false">]</mo></mrow><mo>∈</mo><mrow><msup><mi>H</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>ℤ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">[\omega]\in H^{2}(M;\mathbb{Z})</annotation></semantics></math> by suitably rescaling <math id="S4.I2.i1.p1.m3" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math> and <math id="S4.I2.i1.p1.m4" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> using a common integer-valued factor.</p>
</div></li>
<li id="S4.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I2.i2.p1" class="ltx_para">
<p id="S4.I2.i2.p1.1" class="ltx_p">Because any <math id="S4.I2.i2.p1.m1" class="ltx_Math" alttext="C^{2}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mn>2</mn></msup><annotation encoding="application/x-tex">C^{2}</annotation></semantics></math>-small perturbation of a nondegenerate Hamiltonian <math id="S4.I2.i2.p1.m2" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> will not change the number of periodic orbits, we can freely perturb <math id="S4.I2.i2.p1.m3" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> to guarantee that all <math id="S4.I2.i2.p1.m4" class="ltx_Math" alttext="2\pi" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi></mrow><annotation encoding="application/x-tex">2\pi</annotation></semantics></math>-periodic orbits are nondegenerate.</p>
</div></li>
<li id="S4.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S4.I2.i3.p1" class="ltx_para">
<p id="S4.I2.i3.p1.1" class="ltx_p">As the 2-dimensional case of the integral Arnold conjecture is known, we can restrict ourselves to the case when <math id="S4.I2.i3.p1.m1" class="ltx_Math" alttext="{\rm dim}M\geq 4" display="inline" intent=":literal"><semantics><mrow><mrow><mi>dim</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>≥</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">{\rm dim}M\geq 4</annotation></semantics></math>. Then one can slightly perturb <math id="S4.I2.i3.p1.m2" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> so that distinct periodic orbits do not intersect and all periodic orbits are embedded.</p>
</div></li>
<li id="S4.I2.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S4.I2.i4.p1" class="ltx_para">
<p id="S4.I2.i4.p1.1" class="ltx_p">Given a nondegenerate Hamiltonian <math id="S4.I2.i4.p1.m1" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> (whose capped 1-periodic orbits are all discrete), by adding a <math id="S4.I2.i4.p1.m2" class="ltx_Math" alttext="C^{2}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mn>2</mn></msup><annotation encoding="application/x-tex">C^{2}</annotation></semantics></math>-small, <math id="S4.I2.i4.p1.m3" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>-independent function <math id="S4.I2.i4.p1.m4" class="ltx_Math" alttext="f:M\to{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f:M\to{\mathbb{R}}</annotation></semantics></math> whose restriction to a neighborhood of the image of each periodic orbit is a constant does not change the set of capped 1-periodic orbits but will shift their symplectic actions by constants. Then we can add a sufficiently small function <math id="S4.I2.i4.p1.m5" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> which makes the symplectic actions of all capped periodic orbits rational. Then the symplectic actions can be made integral by a further rescaling.</p>
</div></li>
<li id="S4.I2.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(5)</span> 
<div id="S4.I2.i5.p1" class="ltx_para">
<p id="S4.I2.i5.p1.1" class="ltx_p">For any given <math id="S4.I2.i5.p1.m1" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math>, one can slightly perturb <math id="S4.I2.i5.p1.m2" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> to achieve transversality for all smooth Floer trajectories. Moreover, the perturbed Hamiltonian can be chosen to agree with <math id="S4.I2.i5.p1.m3" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> up to second order on each 1-periodic orbits of <math id="S4.I2.i5.p1.m4" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> (see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx11" title="" class="ltx_ref">FHS95</a>, Theorem 5.1]</cite>).</p>
</div></li>
</ol>
</div>
<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.1. </span>Hamiltonian Floer flow categories</h3>

<section id="S4.SS1.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">4.1.1. </span>The moduli spaces of Floer trajectories</h4>

<div id="S4.SS1.SSS1.p1" class="ltx_para">
<p id="S4.SS1.SSS1.p1.1" class="ltx_p">We first review the basics about the moduli spaces of stable Floer trajectories. Let <math id="S4.SS1.SSS1.p1.m1" class="ltx_Math" alttext="(M,\omega)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>ω</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(M,\omega)</annotation></semantics></math> be a compact symplectic manifold and <math id="S4.SS1.SSS1.p1.m2" class="ltx_Math" alttext="H=(H_{t})_{t\in S^{1}}" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>∈</mo><msup><mi>S</mi><mn>1</mn></msup></mrow></msub></mrow><annotation encoding="application/x-tex">H=(H_{t})_{t\in S^{1}}</annotation></semantics></math> be a smooth 1-periodic Hamiltonian on <math id="S4.SS1.SSS1.p1.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>. A <span id="S4.SS1.SSS1.p1.1.1" class="ltx_text ltx_font_bold">capped 1-periodic orbit</span> is a pair <math id="S4.SS1.SSS1.p1.m4" class="ltx_Math" alttext="p=([u],\underline{\smash{p}})" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mi>u</mi><mo stretchy="false">]</mo></mrow><mo>,</mo><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p=([u],\underline{\smash{p}})</annotation></semantics></math> where <math id="S4.SS1.SSS1.p1.m5" class="ltx_Math" alttext="\underline{\smash{p}}:S^{1}\to M" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>S</mi><mn>1</mn></msup><mo stretchy="false">→</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">\underline{\smash{p}}:S^{1}\to M</annotation></semantics></math> is a 1-periodic orbit of the Hamiltonian vector field <math id="S4.SS1.SSS1.p1.m6" class="ltx_Math" alttext="X_{H_{t}}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><msub><mi>H</mi><mi>t</mi></msub></msub><annotation encoding="application/x-tex">X_{H_{t}}</annotation></semantics></math> and <math id="S4.SS1.SSS1.p1.m7" class="ltx_Math" alttext="[u]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mi>u</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[u]</annotation></semantics></math> is an equivalence class of maps <math id="S4.SS1.SSS1.p1.m8" class="ltx_Math" alttext="u:{\mathbb{D}}\to M" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>𝔻</mi><mo stretchy="false">→</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">u:{\mathbb{D}}\to M</annotation></semantics></math> such that (we view <math id="S4.SS1.SSS1.p1.m9" class="ltx_Math" alttext="{\mathbb{D}}" display="inline" intent=":literal"><semantics><mi>𝔻</mi><annotation encoding="application/x-tex">{\mathbb{D}}</annotation></semantics></math> as the unit disk in <math id="S4.SS1.SSS1.p1.m10" class="ltx_Math" alttext="{\mathbb{C}}" display="inline" intent=":literal"><semantics><mi>ℂ</mi><annotation encoding="application/x-tex">{\mathbb{C}}</annotation></semantics></math>)</p>
<table id="S4.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex1.m1" class="ltx_Math" alttext="u(e^{2\pi{\bm{i}}t})=\underline{\smash{p}}(t);" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>e</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒊</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>;</mo></mrow><annotation encoding="application/x-tex">u(e^{2\pi{\bm{i}}t})=\underline{\smash{p}}(t);</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.SSS1.p1.2" class="ltx_p">two such maps <math id="S4.SS1.SSS1.p1.m11" class="ltx_Math" alttext="u_{1},u_{2}:{\mathbb{D}}\to M" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>u</mi><mn>2</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>𝔻</mi><mo stretchy="false">→</mo><mi>M</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">u_{1},u_{2}:{\mathbb{D}}\to M</annotation></semantics></math> are equivalent if</p>
<table id="S4.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex2.m1" class="ltx_Math" alttext="\int_{\mathbb{D}}u_{1}^{*}\omega=\int_{{\mathbb{D}}}u_{2}^{*}\omega." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∫</mo><mi>𝔻</mi></msub><mrow><msubsup><mi>u</mi><mn>1</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∫</mo><mi>𝔻</mi></msub><mrow><msubsup><mi>u</mi><mn>2</mn><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\int_{\mathbb{D}}u_{1}^{*}\omega=\int_{{\mathbb{D}}}u_{2}^{*}\omega.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.SSS1.p1.3" class="ltx_p">Define the <span id="S4.SS1.SSS1.p1.3.1" class="ltx_text ltx_font_bold">symplectic action</span> of a capped orbit <math id="S4.SS1.SSS1.p1.m12" class="ltx_Math" alttext="p=([u],\underline{\smash{p}})" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mi>u</mi><mo stretchy="false">]</mo></mrow><mo>,</mo><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p=([u],\underline{\smash{p}})</annotation></semantics></math> to be</p>
<table id="S4.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E1.m1" class="ltx_Math" alttext="{\mathcal{A}}_{H}(p)=\int_{\mathbb{D}}u^{*}\omega+\int_{S^{1}}H_{t}(\underline{\smash{p}}(t))dt." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><msub><mo>∫</mo><mi>𝔻</mi></msub><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow></mrow><mo rspace="0.055em">+</mo><mrow><msub><mo>∫</mo><msup><mi>S</mi><mn>1</mn></msup></msub><mrow><msub><mi>H</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{A}}_{H}(p)=\int_{\mathbb{D}}u^{*}\omega+\int_{S^{1}}H_{t}(\underline{\smash{p}}(t))dt.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.1)</span></td></tr></tbody>
</table>
<p id="S4.SS1.SSS1.p1.4" class="ltx_p">We denote by <math id="S4.SS1.SSS1.p1.m13" class="ltx_Math" alttext="{\rm Per}(H)" display="inline" intent=":literal"><semantics><mrow><mi>Per</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\rm Per}(H)</annotation></semantics></math> the set of contractible 1-periodic orbits of <math id="S4.SS1.SSS1.p1.m14" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>, whose elements are denoted by <math id="S4.SS1.SSS1.p1.m15" class="ltx_Math" alttext="\underline{\smash{p}},\underline{\smash{q}}" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo>,</mo><munder accentunder="true"><mi>q</mi><mo stretchy="true">¯</mo></munder></mrow><annotation encoding="application/x-tex">\underline{\smash{p}},\underline{\smash{q}}</annotation></semantics></math>, etc. Denote by <math id="S4.SS1.SSS1.p1.m16" class="ltx_Math" alttext="\widetilde{{\rm Per}}(H)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>Per</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{{\rm Per}}(H)</annotation></semantics></math> the set of capped 1-periodic orbits of <math id="S4.SS1.SSS1.p1.m17" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>, whose elements are denoted by <math id="S4.SS1.SSS1.p1.m18" class="ltx_Math" alttext="p,q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p,q</annotation></semantics></math>, etc. It follows from the integrality assumption on the symplectic class that <math id="S4.SS1.SSS1.p1.m19" class="ltx_Math" alttext="\widetilde{{\rm Per}}(H)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>Per</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{{\rm Per}}(H)</annotation></semantics></math> is a <math id="S4.SS1.SSS1.p1.m20" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>-covering of <math id="S4.SS1.SSS1.p1.m21" class="ltx_Math" alttext="{\rm Per}(H)" display="inline" intent=":literal"><semantics><mrow><mi>Per</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\rm Per}(H)</annotation></semantics></math>.</p>
</div>
<div id="S4.SS1.SSS1.p2" class="ltx_para">
<p id="S4.SS1.SSS1.p2.1" class="ltx_p">Choose an <math id="S4.SS1.SSS1.p2.m1" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math>-compatible almost complex structure <math id="S4.SS1.SSS1.p2.m2" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math> on <math id="S4.SS1.SSS1.p2.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>. Let <math id="S4.SS1.SSS1.p2.m4" class="ltx_Math" alttext="\Theta={\mathbb{R}}\times S^{1}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Θ</mi><mo>=</mo><mrow><mi>ℝ</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>S</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\Theta={\mathbb{R}}\times S^{1}</annotation></semantics></math> be the infinite cylinder with standard coordinates <math id="S4.SS1.SSS1.p2.m5" class="ltx_Math" alttext="z=s+{\bm{i}}t" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>=</mo><mrow><mi>s</mi><mo>+</mo><mrow><mi>𝒊</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">z=s+{\bm{i}}t</annotation></semantics></math>. The Floer equation is the first-order equation for smooth maps <math id="S4.SS1.SSS1.p2.m6" class="ltx_Math" alttext="u:\Theta\to M" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Θ</mi><mo stretchy="false">→</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">u:\Theta\to M</annotation></semantics></math></p>
<table id="S4.E2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E2.m1" class="ltx_Math" alttext="\frac{\partial u}{\partial s}+J\left(\frac{\partial u}{\partial t}-X_{H_{t}}(u)\right)=0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mrow><mo>∂</mo><mi>u</mi></mrow><mrow><mo>∂</mo><mi>s</mi></mrow></mfrac><mo>+</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mrow><mo>∂</mo><mi>u</mi></mrow><mrow><mo>∂</mo><mi>t</mi></mrow></mfrac><mo>−</mo><mrow><msub><mi>X</mi><msub><mi>H</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\partial u}{\partial s}+J\left(\frac{\partial u}{\partial t}-X_{H_{t}}(u)\right)=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.2)</span></td></tr></tbody>
</table>
<p id="S4.SS1.SSS1.p2.2" class="ltx_p">The associated energy for a map <math id="S4.SS1.SSS1.p2.m7" class="ltx_Math" alttext="u:\Theta\to M" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Θ</mi><mo stretchy="false">→</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">u:\Theta\to M</annotation></semantics></math> is defined to be</p>
<table id="S4.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex3.m1" class="ltx_Math" alttext="E_{H}(u):=\frac{1}{2}\int_{\Theta}\left(\left|\frac{\partial u}{\partial s}\right|^{2}+\left|\frac{\partial u}{\partial t}-X_{H_{t}}(u)\right|^{2}\right)dsdt." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>E</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo rspace="0em">∫</mo><mi mathvariant="normal">Θ</mi></msub><mrow><mrow><mo>(</mo><mrow><msup><mrow><mo>|</mo><mfrac><mrow><mo>∂</mo><mi>u</mi></mrow><mrow><mo>∂</mo><mi>s</mi></mrow></mfrac><mo>|</mo></mrow><mn>2</mn></msup><mo>+</mo><msup><mrow><mo>|</mo><mrow><mfrac><mrow><mo>∂</mo><mi>u</mi></mrow><mrow><mo>∂</mo><mi>t</mi></mrow></mfrac><mo>−</mo><mrow><msub><mi>X</mi><msub><mi>H</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mn>2</mn></msup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">E_{H}(u):=\frac{1}{2}\int_{\Theta}\left(\left|\frac{\partial u}{\partial s}\right|^{2}+\left|\frac{\partial u}{\partial t}-X_{H_{t}}(u)\right|^{2}\right)dsdt.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.SSS1.p2.3" class="ltx_p">Any solution to (<a href="#S4.E2" title="In 4.1.1. The moduli spaces of Floer trajectories ‣ 4.1. Hamiltonian Floer flow categories ‣ 4. Proof of the integral Arnold conjecture ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>) with finite energy necessarily converges as <math id="S4.SS1.SSS1.p2.m8" class="ltx_Math" alttext="s\to\pm\infty" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo stretchy="false">→</mo><mrow><mo>±</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">s\to\pm\infty</annotation></semantics></math> to periodic orbits of <math id="S4.SS1.SSS1.p2.m9" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>. Then one can use a pair of (capped) orbits to label solutions. Let <math id="S4.SS1.SSS1.p2.m10" class="ltx_Math" alttext="{\mathcal{M}}_{\underline{\smash{p}}\underline{\smash{q}}}^{\rm Floer}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>q</mi><mo stretchy="true">¯</mo></munder></mrow><mi>Floer</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{M}}_{\underline{\smash{p}}\underline{\smash{q}}}^{\rm Floer}</annotation></semantics></math> be the set of solutions to (<a href="#S4.E2" title="In 4.1.1. The moduli spaces of Floer trajectories ‣ 4.1. Hamiltonian Floer flow categories ‣ 4. Proof of the integral Arnold conjecture ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>) which converge to <math id="S4.SS1.SSS1.p2.m11" class="ltx_Math" alttext="\underline{\smash{p}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{p}}</annotation></semantics></math> resp. <math id="S4.SS1.SSS1.p2.m12" class="ltx_Math" alttext="\underline{\smash{q}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>q</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{q}}</annotation></semantics></math> as <math id="S4.SS1.SSS1.p2.m13" class="ltx_Math" alttext="s\to-\infty" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo stretchy="false">→</mo><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">s\to-\infty</annotation></semantics></math> resp. <math id="S4.SS1.SSS1.p2.m14" class="ltx_Math" alttext="s\to+\infty" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo stretchy="false">→</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">s\to+\infty</annotation></semantics></math>, modulo the obvious time translation. Denote by</p>
<table id="S4.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex4.m1" class="ltx_Math" alttext="{\mathcal{M}}_{pq}^{\rm Floer}\subset{\mathcal{M}}_{\underline{\smash{p}}\underline{\smash{q}}}^{\rm Floer}" display="block" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>Floer</mi></msubsup><mo>⊂</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><munder accentunder="true"><mi>p</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>q</mi><mo stretchy="true">¯</mo></munder></mrow><mi>Floer</mi></msubsup></mrow><annotation encoding="application/x-tex">{\mathcal{M}}_{pq}^{\rm Floer}\subset{\mathcal{M}}_{\underline{\smash{p}}\underline{\smash{q}}}^{\rm Floer}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.SSS1.p2.4" class="ltx_p">the subset of equivalence classes of solutions <math id="S4.SS1.SSS1.p2.m15" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> such that the concatenation of <math id="S4.SS1.SSS1.p2.m16" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> and <math id="S4.SS1.SSS1.p2.m17" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> is equivalent to <math id="S4.SS1.SSS1.p2.m18" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> as capped 1-periodic orbits. Then for any solution <math id="S4.SS1.SSS1.p2.m19" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> to (<a href="#S4.E2" title="In 4.1.1. The moduli spaces of Floer trajectories ‣ 4.1. Hamiltonian Floer flow categories ‣ 4. Proof of the integral Arnold conjecture ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>) representing an element of <math id="S4.SS1.SSS1.p2.m20" class="ltx_Math" alttext="{\mathcal{M}}_{pq}^{\rm Floer}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>Floer</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{M}}_{pq}^{\rm Floer}</annotation></semantics></math>, it is standard that</p>
<table id="S4.E3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E3.m1" class="ltx_Math" alttext="E_{H}(u)={\mathcal{A}}_{H}(q)-{\mathcal{A}}_{H}(p)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>E</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">E_{H}(u)={\mathcal{A}}_{H}(q)-{\mathcal{A}}_{H}(p).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.3)</span></td></tr></tbody>
</table>
<p id="S4.SS1.SSS1.p2.5" class="ltx_p">As a result the Floer differential <span id="S4.SS1.SSS1.p2.5.1" class="ltx_text ltx_font_italic">increases</span> the symplectic action.</p>
</div>
<div id="S4.SS1.SSS1.p3" class="ltx_para">
<p id="S4.SS1.SSS1.p3.1" class="ltx_p">The moduli spaces in general are not compact with respect to the <math id="S4.SS1.SSS1.p3.m1" class="ltx_Math" alttext="C^{\infty}_{\rm loc}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi>loc</mi><mi mathvariant="normal">∞</mi></msubsup><annotation encoding="application/x-tex">C^{\infty}_{\rm loc}</annotation></semantics></math>-topology. Indeed, the space <math id="S4.SS1.SSS1.p3.m2" class="ltx_Math" alttext="{\mathcal{M}}_{pq}^{\rm Floer}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>Floer</mi></msubsup><annotation encoding="application/x-tex">{\mathcal{M}}_{pq}^{\rm Floer}</annotation></semantics></math> admits a natural compactification called the Gromov–Floer compactification, denoted by <math id="S4.SS1.SSS1.p3.m3" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{pq}^{\rm Floer}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><msup><mrow></mrow><mi>Floer</mi></msup></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{pq}^{\rm Floer}</annotation></semantics></math>, incorporating both bubbling of holomorphic spheres and breaking of Floer trajectories, see e.g. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx16" title="" class="ltx_ref">FO99</a>, Section 18]</cite>. It is standard knowledge that <math id="S4.SS1.SSS1.p3.m4" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{pq}^{\rm Floer}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><msup><mrow></mrow><mi>Floer</mi></msup></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{pq}^{\rm Floer}</annotation></semantics></math> is a compact Hausdorff topological space.<span id="footnote9" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">9</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">9</sup>
                <span class="ltx_tag ltx_tag_note">9</span>
                
                
                
              It is possible that <math id="footnote9.m1" class="ltx_Math" alttext="{\mathcal{M}}_{pq}^{\rm Floer}=\emptyset" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>Floer</mi></msubsup><mo>=</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">{\mathcal{M}}_{pq}^{\rm Floer}=\emptyset</annotation></semantics></math> while <math id="footnote9.m2" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{pq}^{\rm Floer}\neq\emptyset" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><msup><mrow></mrow><mi>Floer</mi></msup><mo>≠</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{pq}^{\rm Floer}\neq\emptyset</annotation></semantics></math>.</span></span></span></p>
</div>
</section>
<section id="S4.SS1.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">4.1.2. </span>The flow category</h4>

<div id="S4.SS1.SSS2.p1" class="ltx_para">
<p id="S4.SS1.SSS2.p1.1" class="ltx_p">We now package the collection of Floer moduli spaces into a flow category. First we see how this system of moduli spaces fits into Setup <a href="#S3.Thmthm5" title="Setup 3.5. ‣ 3.2. Topological flow categories and bimodules ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.5</span></a>. Let <math id="S4.SS1.SSS2.p1.m1" class="ltx_Math" alttext="N\in{\mathbb{Z}}_{\geq 0}" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>∈</mo><msub><mi>ℤ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">N\in{\mathbb{Z}}_{\geq 0}</annotation></semantics></math> be the minimal Chern number of <math id="S4.SS1.SSS2.p1.m2" class="ltx_Math" alttext="(M,\omega)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>ω</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(M,\omega)</annotation></semantics></math>. The integral symplectic form <math id="S4.SS1.SSS2.p1.m3" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math> defines a homomorphism</p>
<table id="S4.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex5.m1" class="ltx_Math" alttext="\omega:\pi_{2}(M)\to{\mathbb{Z}}." display="block" intent=":literal"><semantics><mrow><mrow><mi>ω</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>π</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi>ℤ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\omega:\pi_{2}(M)\to{\mathbb{Z}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.SSS2.p1.2" class="ltx_p">Define</p>
<table id="S4.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex6.m1" class="ltx_Math" alttext="\Pi:=\pi_{2}(M)/{\rm ker}\omega." display="block" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Π</mi><mo>:=</mo><mrow><mrow><mrow><msub><mi>π</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>ker</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Pi:=\pi_{2}(M)/{\rm ker}\omega.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.SSS2.p1.3" class="ltx_p">Then <math id="S4.SS1.SSS2.p1.m4" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math> is an infinite cyclic group and <math id="S4.SS1.SSS2.p1.m5" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math> induces an injection</p>
<table id="S4.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex7.m1" class="ltx_Math" alttext="\omega:\Pi\to{\mathbb{Z}}" display="block" intent=":literal"><semantics><mrow><mi>ω</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Π</mi><mo stretchy="false">→</mo><mi>ℤ</mi></mrow></mrow><annotation encoding="application/x-tex">\omega:\Pi\to{\mathbb{Z}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.SSS2.p1.4" class="ltx_p">Then we define</p>
<table id="S4.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex8.m1" class="ltx_Math" alttext="{\mathcal{P}}^{\rm Floer}:=\widetilde{\rm Per}(H)." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Floer</mi></msup><mo>:=</mo><mrow><mover accent="true"><mi>Per</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{P}}^{\rm Floer}:=\widetilde{\rm Per}(H).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.SSS2.p1.5" class="ltx_p">Define the partial order by the existence of nonempty Floer moduli spaces, i.e.,</p>
<table id="S4.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex9.m1" class="ltx_math_unparsed" alttext="p\leq q\Longrightarrow\overline{\mathcal{M}}{}_{pq}^{\rm Floer}\neq\emptyset." display="block" intent=":literal"><semantics><mrow><mi>p</mi><mo>≤</mo><mi>q</mi><mo stretchy="false">⟹</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><msup><mrow></mrow><mi>Floer</mi></msup><mo>≠</mo><mi mathvariant="normal">∅</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">p\leq q\Longrightarrow\overline{\mathcal{M}}{}_{pq}^{\rm Floer}\neq\emptyset.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.SSS2.p1.6" class="ltx_p">It has a free <math id="S4.SS1.SSS2.p1.m6" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>-action defined by taking the connected sum between a representative of a capped 1-periodic orbit and a representative of an element <math id="S4.SS1.SSS2.p1.m7" class="ltx_Math" alttext="a\in\Pi" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow><annotation encoding="application/x-tex">a\in\Pi</annotation></semantics></math>. Define</p>
<table id="S4.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex10.m1" class="ltx_Math" alttext="\displaystyle\ {\mathcal{A}}^{{\mathcal{P}}^{\rm Floer}}:={\mathcal{A}}_{H},\ " display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Floer</mi></msup></msup><mo>:=</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>H</mi></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ {\mathcal{A}}^{{\mathcal{P}}^{\rm Floer}}:={\mathcal{A}}_{H},\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex10.m2" class="ltx_Math" alttext="\displaystyle\ {\rm ind}^{{\mathcal{P}}^{\rm Floer}}:=\text{ Conley--Zehnder\ index}." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>ind</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Floer</mi></msup></msup><mo>:=</mo><mtext> Conley–Zehnder index</mtext></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ {\rm ind}^{{\mathcal{P}}^{\rm Floer}}:=\text{ Conley--Zehnder\ index}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.SSS2.p1.7" class="ltx_p">Then <math id="S4.SS1.SSS2.p1.m8" class="ltx_Math" alttext="{\mathcal{P}}^{\rm Floer}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Floer</mi></msup><annotation encoding="application/x-tex">{\mathcal{P}}^{\rm Floer}</annotation></semantics></math> satisfies conditions of Setup <a href="#S3.Thmthm5" title="Setup 3.5. ‣ 3.2. Topological flow categories and bimodules ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.5</span></a>.</p>
</div>
<div id="S4.Thmthm2" class="ltx_theorem ltx_theorem_notation">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm2.2" class="ltx_text ltx_font_italic">Notation 4.2</span></span><span id="S4.Thmthm2.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S4.Thmthm2.p1" class="ltx_para">
<p id="S4.Thmthm2.p1.1" class="ltx_p">As a convention, objects labelled by <math id="S4.Thmthm2.p1.m1" class="ltx_Math" alttext="{\mathcal{P}}^{\rm Floer}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Floer</mi></msup><annotation encoding="application/x-tex">{\mathcal{P}}^{\rm Floer}</annotation></semantics></math> are often also labelled by <math id="S4.Thmthm2.p1.m2" class="ltx_Math" alttext="{\rm Floer}" display="inline" intent=":literal"><semantics><mi>Floer</mi><annotation encoding="application/x-tex">{\rm Floer}</annotation></semantics></math>. For example, we abbreviate</p>
<table id="S4.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex11.m1" class="ltx_Math" alttext="\displaystyle\ {\mathcal{A}}^{\rm Floer}:={\mathcal{A}}^{{\mathcal{P}}^{\rm Floer}},\ " display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>Floer</mi></msup><mo>:=</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Floer</mi></msup></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ {\mathcal{A}}^{\rm Floer}:={\mathcal{A}}^{{\mathcal{P}}^{\rm Floer}},\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex11.m2" class="ltx_Math" alttext="\displaystyle\ {\rm ind}^{\rm Floer}:={\rm ind}^{{\mathcal{P}}^{\rm Floer}}." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>ind</mi><mi>Floer</mi></msup><mo>:=</mo><msup><mi>ind</mi><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Floer</mi></msup></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ {\rm ind}^{\rm Floer}:={\rm ind}^{{\mathcal{P}}^{\rm Floer}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.SS1.SSS2.p2" class="ltx_para">
<p id="S4.SS1.SSS2.p2.1" class="ltx_p">One can then describe the stratifications on Floer moduli spaces. As in Notation <a href="#S3.Thmthm6" title="Notation 3.6. ‣ 3.2. Topological flow categories and bimodules ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.6</span></a>, for each pair <math id="S4.SS1.SSS2.p2.m1" class="ltx_Math" alttext="p,q\in{\mathcal{P}}^{\rm Floer}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Floer</mi></msup></mrow><annotation encoding="application/x-tex">p,q\in{\mathcal{P}}^{\rm Floer}</annotation></semantics></math>, one has the homogeneous poset</p>
<table id="S4.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex12.m1" class="ltx_math_unparsed" alttext="{\mathbb{A}}_{pq}^{\rm Floer}:=\big\{\alpha=pr_{1}\cdots r_{l}q\ |\ p&lt;r_{1}&lt;\cdots&lt;r_{l}&lt;q\big\}." display="block" intent=":literal"><semantics><mrow><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>Floer</mi></msubsup><mo>:=</mo><mrow><mo stretchy="false">{</mo><mi>α</mi><mo>=</mo><mi>p</mi><msub><mi>r</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>r</mi><mi>l</mi></msub><mi>q</mi><mo fence="false" lspace="0.500em" rspace="0.667em" stretchy="false">|</mo><mi>p</mi><mo>&lt;</mo><msub><mi>r</mi><mn>1</mn></msub><mo rspace="0.1389em">&lt;</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">&lt;</mo><msub><mi>r</mi><mi>l</mi></msub><mo>&lt;</mo><mi>q</mi><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathbb{A}}_{pq}^{\rm Floer}:=\big\{\alpha=pr_{1}\cdots r_{l}q\ |\ p&lt;r_{1}&lt;\cdots&lt;r_{l}&lt;q\big\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.SSS2.p2.2" class="ltx_p">Then the moduli space <math id="S4.SS1.SSS2.p2.m2" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{pq}^{\rm Floer}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><msup><mrow></mrow><mi>Floer</mi></msup></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{pq}^{\rm Floer}</annotation></semantics></math> an <math id="S4.SS1.SSS2.p2.m3" class="ltx_Math" alttext="{\mathbb{A}}_{pq}^{\rm Floer}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>Floer</mi></msubsup><annotation encoding="application/x-tex">{\mathbb{A}}_{pq}^{\rm Floer}</annotation></semantics></math>-stratified topological space. Indeed, for each <math id="S4.SS1.SSS2.p2.m4" class="ltx_math_unparsed" alttext="\alpha=pr_{1}\cdots r_{l}q" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mi>p</mi><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>l</mi></msub><mi>q</mi></mrow><annotation encoding="application/x-tex">\alpha=pr_{1}\cdots r_{l}q</annotation></semantics></math>, one has</p>
<table id="S4.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex13.m1" class="ltx_math_unparsed" alttext="\partial^{\alpha}\overline{\mathcal{M}}{}_{pq}^{\rm Floer}\cong\overline{\mathcal{M}}{}_{pr_{1}}^{\rm Floer}\times\cdots\times\overline{\mathcal{M}}{}_{r_{l}q}^{\rm Floer}" display="block" intent=":literal"><semantics><mrow><mo>∂</mo><msup><mrow></mrow><mi>α</mi></msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><msup><mrow></mrow><mi>Floer</mi></msup><mo>≅</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></msub><msup><mrow></mrow><mi>Floer</mi></msup><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><msub><mi>r</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><msup><mrow></mrow><mi>Floer</mi></msup></mrow><annotation encoding="application/x-tex">\partial^{\alpha}\overline{\mathcal{M}}{}_{pq}^{\rm Floer}\cong\overline{\mathcal{M}}{}_{pr_{1}}^{\rm Floer}\times\cdots\times\overline{\mathcal{M}}{}_{r_{l}q}^{\rm Floer}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.SSS2.p2.3" class="ltx_p">as the <math id="S4.SS1.SSS2.p2.m5" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>-stratum is the subset of “broken trajectories” of a type described by <math id="S4.SS1.SSS2.p2.m6" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>.</p>
</div>
<div id="S4.Thmthm3" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm3.2" class="ltx_text ltx_font_bold">Definition 4.3</span></span><span id="S4.Thmthm3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm3.p1" class="ltx_para">
<p id="S4.Thmthm3.p1.1" class="ltx_p">The <span id="S4.Thmthm3.p1.1.1" class="ltx_text ltx_font_bold">Hamiltonian Floer flow category</span> (associated to <math id="S4.Thmthm3.p1.m1" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> and <math id="S4.Thmthm3.p1.m2" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math>), denoted by <math id="S4.Thmthm3.p1.m3" class="ltx_Math" alttext="T^{\rm Floer}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi>Floer</mi></msup><annotation encoding="application/x-tex">T^{\rm Floer}</annotation></semantics></math>, is the topological flow category over <math id="S4.Thmthm3.p1.m4" class="ltx_Math" alttext="{\mathcal{P}}^{\rm Floer}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Floer</mi></msup><annotation encoding="application/x-tex">{\mathcal{P}}^{\rm Floer}</annotation></semantics></math> whose morphism space between <math id="S4.Thmthm3.p1.m5" class="ltx_Math" alttext="p,q\in\widetilde{{\rm Per}}(H)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow><mo>∈</mo><mrow><mover accent="true"><mi>Per</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p,q\in\widetilde{{\rm Per}}(H)</annotation></semantics></math> is the moduli space <math id="S4.Thmthm3.p1.m6" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{pq}^{\rm Floer}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><msup><mrow></mrow><mi>Floer</mi></msup></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{pq}^{\rm Floer}</annotation></semantics></math>, and whose composition maps are the natural inclusions</p>
<table id="S4.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex14.m1" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{pr}^{\rm Floer}\times\overline{\mathcal{M}}{}_{rq}^{\rm Floer}\to\overline{\mathcal{M}}{}_{pq}^{\rm Floer},\ \forall p\leq r\leq q." display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><msup><mrow></mrow><mi>Floer</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><msup><mrow></mrow><mi>Floer</mi></msup><mo stretchy="false">→</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><msup><mrow></mrow><mi>Floer</mi></msup><mo rspace="0.667em">,</mo><mo rspace="0.167em">∀</mo><mi>p</mi><mo>≤</mo><mi>r</mi><mo>≤</mo><mi>q</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{pr}^{\rm Floer}\times\overline{\mathcal{M}}{}_{rq}^{\rm Floer}\to\overline{\mathcal{M}}{}_{pq}^{\rm Floer},\ \forall p\leq r\leq q.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
</section>
</section>
<section id="S4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.2. </span>Morse flow category</h3>

<div id="S4.SS2.p1" class="ltx_para">
<p id="S4.SS2.p1.1" class="ltx_p">We describe the definition of the more classical Morse flow category and explain how it fits into the general framework of this paper. We declare that in this paper Morse flows are always the ascending flow, i.e., the flow generated by the gradient vector field. Suppose <math id="S4.SS2.p1.m1" class="ltx_Math" alttext="(f,g)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(f,g)</annotation></semantics></math> is a Morse–Smale pair on <math id="S4.SS2.p1.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, namely, <math id="S4.SS2.p1.m3" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is a Morse function and <math id="S4.SS2.p1.m4" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> is a Riemannian metric such that the unstable manifold of any critical point intersects transversely with any stable manifold. We use <math id="S4.SS2.p1.m5" class="ltx_Math" alttext="\underline{\smash{x}},\underline{\smash{y}}" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo>,</mo><munder accentunder="true"><mi>y</mi><mo stretchy="true">¯</mo></munder></mrow><annotation encoding="application/x-tex">\underline{\smash{x}},\underline{\smash{y}}</annotation></semantics></math> to denote the critical points of <math id="S4.SS2.p1.m6" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>. To ensure the moduli spaces of (unparametrized) gradient flow lines to have smooth structures, we assume that near each <math id="S4.SS2.p1.m7" class="ltx_Math" alttext="\underline{\smash{x}}\in{\rm crit}(f)" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo>∈</mo><mrow><mi>crit</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\underline{\smash{x}}\in{\rm crit}(f)</annotation></semantics></math>, there exists a coordinate chart <math id="S4.SS2.p1.m8" class="ltx_Math" alttext="(x_{1},\dots,x_{2n})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(x_{1},\dots,x_{2n})</annotation></semantics></math> such that <math id="S4.SS2.p1.m9" class="ltx_Math" alttext="f=\pm x_{1}^{2}\pm\cdots\pm x_{2n}^{2}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>=</mo><mrow><mrow><mo>±</mo><msubsup><mi>x</mi><mn>1</mn><mn>2</mn></msubsup></mrow><mo>±</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>±</mo><msubsup><mi>x</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">f=\pm x_{1}^{2}\pm\cdots\pm x_{2n}^{2}</annotation></semantics></math> and <math id="S4.SS2.p1.m10" class="ltx_math_unparsed" alttext="g=dx_{1}\otimes dx_{1}+\cdots dx_{2n}\otimes dx_{2n}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>=</mo><mi>d</mi><mi>x</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>d</mi><mi>x</mi><msub><mrow></mrow><mn>1</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mi>d</mi><mi>x</mi><msub><mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>d</mi><mi>x</mi><msub><mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">g=dx_{1}\otimes dx_{1}+\cdots dx_{2n}\otimes dx_{2n}</annotation></semantics></math>. Then by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx40" title="" class="ltx_ref">Weh12</a>]</cite>, for any pair of cricial points <math id="S4.SS2.p1.m11" class="ltx_Math" alttext="\underline{\smash{x}},\underline{\smash{y}}\in{\rm crit}(f)" display="inline" intent=":literal"><semantics><mrow><mrow><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo>,</mo><munder accentunder="true"><mi>y</mi><mo stretchy="true">¯</mo></munder></mrow><mo>∈</mo><mrow><mi>crit</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\underline{\smash{x}},\underline{\smash{y}}\in{\rm crit}(f)</annotation></semantics></math>, the moduli space</p>
<table id="S4.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex15.m1" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}^{\rm Morse}_{\underline{\smash{x}}\underline{\smash{y}}}" display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msup><mrow></mrow><mi>Morse</mi></msup><msub><mrow></mrow><mrow><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>y</mi><mo stretchy="true">¯</mo></munder></mrow></msub></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}^{\rm Morse}_{\underline{\smash{x}}\underline{\smash{y}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p1.2" class="ltx_p">of unparametrized broken flow lines connecting <math id="S4.SS2.p1.m12" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> and <math id="S4.SS2.p1.m13" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math> is a smooth manifold with faces. It is standard knowledge that upon choosing orientations on the unstable manifolds of all critical points, one can count rigid Morse flow lines (with signs) and define a <math id="S4.SS2.p1.m14" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math>-graded chain complex over <math id="S4.SS2.p1.m15" class="ltx_Math" alttext="{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">{\mathbb{Z}}</annotation></semantics></math> and its homology coincides with <math id="S4.SS2.p1.m16" class="ltx_Math" alttext="H_{*}(M;{\mathbb{Z}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>ℤ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{*}(M;{\mathbb{Z}})</annotation></semantics></math>.</p>
</div>
<div id="S4.SS2.p2" class="ltx_para">
<p id="S4.SS2.p2.1" class="ltx_p">We want to fit the Morse flow category into the abstract framework. Define</p>
<table id="S4.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex16.m1" class="ltx_Math" alttext="{\mathcal{P}}^{\rm Morse}:=\Pi\times{\rm crit}(f)" display="block" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Morse</mi></msup><mo>:=</mo><mrow><mi mathvariant="normal">Π</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mi>crit</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{P}}^{\rm Morse}:=\Pi\times{\rm crit}(f)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p2.2" class="ltx_p">with a partial order defined by</p>
<table id="S4.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex17.m1" class="ltx_math_unparsed" alttext="(a,\underline{\smash{x}})\leq(b,\underline{\smash{y}})\Longleftrightarrow a=b\ {\rm and}\ \overline{\mathcal{M}}{}_{\underline{\smash{x}}\underline{\smash{y}}}^{\rm Morse}\neq\emptyset." display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo stretchy="false">)</mo></mrow><mo>≤</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>,</mo><munder accentunder="true"><mi>y</mi><mo stretchy="true">¯</mo></munder><mo stretchy="false">)</mo></mrow><mo stretchy="false">⟺</mo><mi>a</mi><mo>=</mo><mi>b</mi><mi>and</mi><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mo>≠</mo><mrow></mrow><mi>Morse</mi><mprescripts></mprescripts><mrow><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>y</mi><mo stretchy="true">¯</mo></munder></mrow><mrow></mrow></mmultiscripts><mi mathvariant="normal">∅</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(a,\underline{\smash{x}})\leq(b,\underline{\smash{y}})\Longleftrightarrow a=b\ {\rm and}\ \overline{\mathcal{M}}{}_{\underline{\smash{x}}\underline{\smash{y}}}^{\rm Morse}\neq\emptyset.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p2.3" class="ltx_p"><math id="S4.SS2.p2.m1" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math> naturally acts freely on <math id="S4.SS2.p2.m2" class="ltx_Math" alttext="{\mathcal{P}}^{\rm Morse}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Morse</mi></msup><annotation encoding="application/x-tex">{\mathcal{P}}^{\rm Morse}</annotation></semantics></math>. The action function is defined by</p>
<table id="S4.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex18.m1" class="ltx_Math" alttext="{\mathcal{A}}^{\rm Morse}(a,\underline{\smash{x}})=\omega(a)+\epsilon f(\underline{\smash{x}})" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>Morse</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{A}}^{\rm Morse}(a,\underline{\smash{x}})=\omega(a)+\epsilon f(\underline{\smash{x}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p2.4" class="ltx_p">where <math id="S4.SS2.p2.m3" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math> is a sufficiently small positive number. The index function is defined by</p>
<table id="S4.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex19.m1" class="ltx_Math" alttext="{\rm ind}^{\rm Morse}(a,\underline{\smash{x}})\equiv\frac{1}{2}{\rm dim}M-{\rm Morse\ index\ of\ }\underline{\smash{x}}\ {\rm mod}\ 2N." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>ind</mi><mi>Morse</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo stretchy="false">)</mo></mrow></mrow><mo>≡</mo><mrow><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>dim</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>−</mo><mrow><mi>Morse</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>index</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>of</mi><mo lspace="0.500em" rspace="0em">​</mo><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mi>mod</mi><mo lspace="0em" rspace="0em">​</mo><mn> 2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\rm ind}^{\rm Morse}(a,\underline{\smash{x}})\equiv\frac{1}{2}{\rm dim}M-{\rm Morse\ index\ of\ }\underline{\smash{x}}\ {\rm mod}\ 2N.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p2.5" class="ltx_p">One can easily check that the triple <math id="S4.SS2.p2.m4" class="ltx_Math" alttext="({\mathcal{P}}^{\rm Morse},{\mathcal{A}}^{\rm Morse},{\rm ind}^{\rm Morse})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Morse</mi></msup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>Morse</mi></msup><mo>,</mo><msup><mi>ind</mi><mi>Morse</mi></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathcal{P}}^{\rm Morse},{\mathcal{A}}^{\rm Morse},{\rm ind}^{\rm Morse})</annotation></semantics></math> satisfies conditions of Setup <a href="#S3.Thmthm5" title="Setup 3.5. ‣ 3.2. Topological flow categories and bimodules ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.5</span></a>. Then following Notation <a href="#S3.Thmthm6" title="Notation 3.6. ‣ 3.2. Topological flow categories and bimodules ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.6</span></a> one obtains a collection of homogeneous posets <math id="S4.SS2.p2.m5" class="ltx_Math" alttext="{\mathbb{A}}_{xy}^{\rm Morse}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔸</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>Morse</mi></msubsup><annotation encoding="application/x-tex">{\mathbb{A}}_{xy}^{\rm Morse}</annotation></semantics></math> for all <math id="S4.SS2.p2.m6" class="ltx_Math" alttext="x,y\in{\mathcal{P}}^{\rm Morse}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Morse</mi></msup></mrow><annotation encoding="application/x-tex">x,y\in{\mathcal{P}}^{\rm Morse}</annotation></semantics></math>. Define</p>
<table id="S4.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex20.m1" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{xy}^{\rm Morse}=\left\{\begin{array}[]{cc}\overline{\mathcal{M}}{}_{\underline{\smash{x}}\underline{\smash{y}}}^{\rm Morse},&amp;\ {\rm if}\ x=(a,\underline{\smash{x}})\ {\rm and}\ y=(a,\underline{\smash{y}}),\\
\emptyset,&amp;\ {\rm otherwise}.\end{array}\right." display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mo>=</mo><mrow></mrow><mi>Morse</mi><mprescripts></mprescripts><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mrow></mrow></mmultiscripts><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>y</mi><mo stretchy="true">¯</mo></munder></mrow></msub><msup><mrow></mrow><mi>Morse</mi></msup><mo>,</mo></mrow></mtd><mtd><mrow><mrow><mrow><mi>if</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>x</mi></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo stretchy="false">)</mo></mrow><mo lspace="0.500em" rspace="0em">​</mo><mi>and</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>y</mi></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><munder accentunder="true"><mi>y</mi><mo stretchy="true">¯</mo></munder><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd><mrow><mi mathvariant="normal">∅</mi><mo>,</mo></mrow></mtd><mtd><mrow><mi>otherwise</mi><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{xy}^{\rm Morse}=\left\{\begin{array}[]{cc}\overline{\mathcal{M}}{}_{\underline{\smash{x}}\underline{\smash{y}}}^{\rm Morse},&amp;\ {\rm if}\ x=(a,\underline{\smash{x}})\ {\rm and}\ y=(a,\underline{\smash{y}}),\\
\emptyset,&amp;\ {\rm otherwise}.\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p2.6" class="ltx_p">Then each <math id="S4.SS2.p2.m7" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{xy}^{\rm Morse}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub><msup><mrow></mrow><mi>Morse</mi></msup></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{xy}^{\rm Morse}</annotation></semantics></math> is stratified by the poset <math id="S4.SS2.p2.m8" class="ltx_Math" alttext="{\mathbb{A}}_{xy}^{\rm Morse}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔸</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>Morse</mi></msubsup><annotation encoding="application/x-tex">{\mathbb{A}}_{xy}^{\rm Morse}</annotation></semantics></math>. We can then define the flow category <math id="S4.SS2.p2.m9" class="ltx_Math" alttext="T^{\rm Morse}:=T^{\rm Morse}(f,g)" display="inline" intent=":literal"><semantics><mrow><msup><mi>T</mi><mi>Morse</mi></msup><mo>:=</mo><mrow><msup><mi>T</mi><mi>Morse</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T^{\rm Morse}:=T^{\rm Morse}(f,g)</annotation></semantics></math> associated with <math id="S4.SS2.p2.m10" class="ltx_Math" alttext="(f,g)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(f,g)</annotation></semantics></math> as follows.</p>
</div>
<div id="S4.Thmthm4" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm4.2" class="ltx_text ltx_font_bold">Definition 4.4</span></span><span id="S4.Thmthm4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm4.p1" class="ltx_para">
<p id="S4.Thmthm4.p1.1" class="ltx_p">The <span id="S4.Thmthm4.p1.1.1" class="ltx_text ltx_font_bold">Morse flow category</span> <math id="S4.Thmthm4.p1.m1" class="ltx_Math" alttext="T^{\rm Morse}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi>Morse</mi></msup><annotation encoding="application/x-tex">T^{\rm Morse}</annotation></semantics></math> is the topological flow category over <math id="S4.Thmthm4.p1.m2" class="ltx_Math" alttext="{\mathcal{P}}^{\rm Morse}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Morse</mi></msup><annotation encoding="application/x-tex">{\mathcal{P}}^{\rm Morse}</annotation></semantics></math> whose morphism spaces are <math id="S4.Thmthm4.p1.m3" class="ltx_math_unparsed" alttext="T_{xy}^{\rm Morse}=\overline{\mathcal{M}}{}_{xy}^{\rm Morse}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><msub><mrow></mrow><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub><msup><mrow></mrow><mi>Morse</mi></msup><mo>=</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub><msup><mrow></mrow><mi>Morse</mi></msup></mrow><annotation encoding="application/x-tex">T_{xy}^{\rm Morse}=\overline{\mathcal{M}}{}_{xy}^{\rm Morse}</annotation></semantics></math> and whose composition maps are the natural inclusions</p>
<table id="S4.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex21.m1" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{xz}^{\rm Morse}\times\overline{\mathcal{M}}{}_{zy}^{\rm Morse}\cong\partial^{xzy}\overline{\mathcal{M}}{}_{xy}^{\rm Morse}\hookrightarrow\overline{\mathcal{M}}{}_{xy}^{\rm Morse}." display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow></msub><msup><mrow></mrow><mi>Morse</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub><msup><mrow></mrow><mi>Morse</mi></msup><mo rspace="0.111em">≅</mo><mo>∂</mo><msup><mrow></mrow><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub><msup><mrow></mrow><mi>Morse</mi></msup><mo stretchy="false">↪</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub><msup><mrow></mrow><mi>Morse</mi></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{xz}^{\rm Morse}\times\overline{\mathcal{M}}{}_{zy}^{\rm Morse}\cong\partial^{xzy}\overline{\mathcal{M}}{}_{xy}^{\rm Morse}\hookrightarrow\overline{\mathcal{M}}{}_{xy}^{\rm Morse}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm4.p1.2" class="ltx_p">It is obvious that <math id="S4.Thmthm4.p1.m4" class="ltx_Math" alttext="T^{\rm Morse}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi>Morse</mi></msup><annotation encoding="application/x-tex">T^{\rm Morse}</annotation></semantics></math> is a strict <math id="S4.Thmthm4.p1.m5" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>-equivariant flow category.</p>
</div>
</div>
<div id="S4.SS2.p3" class="ltx_para">
<p id="S4.SS2.p3.1" class="ltx_p">As transversality is already achieved for the Morse flow category and there is no orbifold behavior, one does not need to use derived orbifold lift nor normal complex structures to define the resulting chain complex. However we would like to formally put this case into the general framework of the previous section as it will be necessary when we connect the Morse flow category to objects where transversality fails and orbifold behavior appears.</p>
</div>
<div id="S4.SS2.p4" class="ltx_para">
<p id="S4.SS2.p4.1" class="ltx_p">First, following the abstract outer-collaring recipe, one can construct an outer-collaring of the Morse flow category. Fix the width <math id="S4.SS2.p4.m1" class="ltx_Math" alttext="r=1" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">r=1</annotation></semantics></math>. The outer-collared Morse flow category <math id="S4.SS2.p4.m2" class="ltx_Math" alttext="(T^{{\rm Morse}})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mi>Morse</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(T^{{\rm Morse}})^{+}</annotation></semantics></math> has morphism spaces being <math id="S4.SS2.p4.m3" class="ltx_math_unparsed" alttext="(\overline{\mathcal{M}}{}_{xy}^{{\rm Morse}})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mo stretchy="false">)</mo><mrow></mrow><mi>Morse</mi><mprescripts></mprescripts><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mrow></mrow></mmultiscripts></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(\overline{\mathcal{M}}{}_{xy}^{{\rm Morse}})^{+}</annotation></semantics></math>. A priori this is only a topological flow category. However, one can equip the morphism spaces and composition maps with smooth structure. Indeed, by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx40" title="" class="ltx_ref">Weh12</a>, Theorem 1.4]</cite> which proves the associativity of gluing maps for the special kind of Morse–Smale pair <math id="S4.SS2.p4.m4" class="ltx_Math" alttext="(f,g)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(f,g)</annotation></semantics></math> (see also <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx36" title="" class="ltx_ref">Qin18</a>]</cite>), the original Morse flow category has compatible “interior” collars. Then the outer-collaring construction does not alter the feature and put a smooth structure on each space <math id="S4.SS2.p4.m5" class="ltx_math_unparsed" alttext="(\overline{\mathcal{M}}{}_{xy}^{\rm Morse})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mo stretchy="false">)</mo><mrow></mrow><mi>Morse</mi><mprescripts></mprescripts><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mrow></mrow></mmultiscripts></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(\overline{\mathcal{M}}{}_{xy}^{\rm Morse})^{+}</annotation></semantics></math> such that the composition maps are smooth.</p>
</div>
<div id="S4.SS2.p5" class="ltx_para">
<p id="S4.SS2.p5.1" class="ltx_p">Second, as transversality is already achieved and the moduli spaces are manifolds but not orbifolds, the collection of outer-collared moduli spaces together with the zero obstruction bundle and the zero Kuranishi map form a derived orbifold lift of <math id="S4.SS2.p5.m1" class="ltx_Math" alttext="(T^{\rm Morse})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mi>Morse</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(T^{\rm Morse})^{+}</annotation></semantics></math>, denoted by <math id="S4.SS2.p5.m2" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm Morse}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>Morse</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm Morse}</annotation></semantics></math>. The outer-collaring provides a collar structure on this lift. There is also the trivial scaffolding and the trivial straightening, which are obviously compatible with the collar structure. In the manifold case, there is only the trivial normal complex structure. Lastly, it is a classical knowledge that upon choosing orientations on all unstable manifolds the Morse moduli spaces inherit coherent orientations. Here the orientation line <math id="S4.SS2.p5.m3" class="ltx_Math" alttext="{\mathfrak{o}}_{x}" display="inline" intent=":literal"><semantics><msub><mi>𝔬</mi><mi>x</mi></msub><annotation encoding="application/x-tex">{\mathfrak{o}}_{x}</annotation></semantics></math> associated with a capped critical point <math id="S4.SS2.p5.m4" class="ltx_Math" alttext="x=(a,\underline{\smash{x}})" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">x=(a,\underline{\smash{x}})</annotation></semantics></math> is defined to be the orientation line of the tangent space of the stable submanifold of <math id="S4.SS2.p5.m5" class="ltx_Math" alttext="\nabla_{g}f" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><mi>g</mi></msub><mi>f</mi></mrow><annotation encoding="application/x-tex">\nabla_{g}f</annotation></semantics></math> at <math id="S4.SS2.p5.m6" class="ltx_Math" alttext="\underline{\smash{x}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{x}}</annotation></semantics></math>. We summarize these observations as follows.</p>
</div>
<div id="S4.Thmthm5" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm5.2" class="ltx_text ltx_font_bold">Lemma 4.5</span></span><span id="S4.Thmthm5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm5.p1" class="ltx_para">
<p id="S4.Thmthm5.p1.1" class="ltx_p"><span id="S4.Thmthm5.p1.1.1" class="ltx_text ltx_font_italic">A choice of orientations on all unstable manifolds of <math id="S4.Thmthm5.p1.m1" class="ltx_Math" alttext="\nabla^{g}f" display="inline" intent=":literal"><semantics><mrow><msup><mo>∇</mo><mi>g</mi></msup><mi>f</mi></mrow><annotation encoding="application/x-tex">\nabla^{g}f</annotation></semantics></math> makes <math id="S4.Thmthm5.p1.m2" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm Morse}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>Morse</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm Morse}</annotation></semantics></math> an oriented and normally complex drived orbifold lift of <math id="S4.Thmthm5.p1.m3" class="ltx_Math" alttext="(T^{\rm Morse})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mi>Morse</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(T^{\rm Morse})^{+}</annotation></semantics></math> equipped with a compatible package of additional structures. Moreover, the <math id="S4.Thmthm5.p1.m4" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>-perturbation is a strongly transverse FOP perturbation on <math id="S4.Thmthm5.p1.m5" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm Morse}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>Morse</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm Morse}</annotation></semantics></math> which defines the <math id="S4.Thmthm5.p1.m6" class="ltx_Math" alttext="{\mathbb{Z}}/2N" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℤ</mi><mo>/</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">{\mathbb{Z}}/2N</annotation></semantics></math>-graded chain complex <math id="S4.Thmthm5.p1.m7" class="ltx_Math" alttext="(C_{*}(f;\Lambda),d^{\rm Morse})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msup><mi>d</mi><mi>Morse</mi></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(C_{*}(f;\Lambda),d^{\rm Morse})</annotation></semantics></math> of <math id="S4.Thmthm5.p1.m8" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>-modules, whose homology is isomorphic to the <math id="S4.Thmthm5.p1.m9" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>-module</span></p>
<table id="S4.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex22.m1" class="ltx_math_unparsed" alttext="H^{(2N)}_{n-*}(M;\Lambda)=\bigoplus_{i\in{\mathbb{Z}}/2N}H^{(2N)}_{n-i}(M;{\mathbb{Z}})\otimes_{\mathbb{Z}}\Lambda." display="block" intent=":literal"><semantics><mrow><msubsup><mi>H</mi><mrow><mi>n</mi><mo rspace="0em">−</mo><mo lspace="0em">∗</mo></mrow><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>;</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">=</mo><munder><mo movablelimits="false">⨁</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mrow><mi>ℤ</mi><mo>/</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow></munder><msubsup><mi>H</mi><mrow><mi>n</mi><mo>−</mo><mi>i</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>;</mo><mi>ℤ</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><msub><mo rspace="0.222em">⊗</mo><mi>ℤ</mi></msub><mi mathvariant="normal">Λ</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H^{(2N)}_{n-*}(M;\Lambda)=\bigoplus_{i\in{\mathbb{Z}}/2N}H^{(2N)}_{n-i}(M;{\mathbb{Z}})\otimes_{\mathbb{Z}}\Lambda.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm5.p1.2" class="ltx_p"><span id="S4.Thmthm5.p1.2.1" class="ltx_text ltx_font_italic">Here</span></p>
<table id="S4.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex23.m1" class="ltx_Math" alttext="H_{i}^{(2N)}(M;{\mathbb{Z}}):=\bigoplus_{j\equiv i\ {\rm mod}\ 2N}H_{j}(M;{\mathbb{Z}})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>H</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>ℤ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">:=</mo><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mi>j</mi><mo>≡</mo><mrow><mi>i</mi><mo lspace="0.410em" rspace="0em">​</mo><mi>mod</mi><mo lspace="0em" rspace="0em">​</mo><mn> 2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow></munder><mrow><msub><mi>H</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>ℤ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H_{i}^{(2N)}(M;{\mathbb{Z}}):=\bigoplus_{j\equiv i\ {\rm mod}\ 2N}H_{j}(M;{\mathbb{Z}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
</section>
<section id="S4.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.3. </span>PSS and SSP bimodules</h3>

<section id="S4.SS3.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">4.3.1. </span>Moduli spaces</h4>

<div id="S4.SS3.SSS1.p1" class="ltx_para">
<p id="S4.SS3.SSS1.p1.1" class="ltx_p">Now we describe the moduli spaces which allow us to interpolate between Floer theory and Morse theory. We first set up a convention: PSS moduli spaces are defined by objects with input from Morse critical points and output from 1-periodic (capped) Hamiltonian orbits and SSP moduli spaces parametrizes objects in the reversed direction.</p>
</div>
<div id="S4.SS3.SSS1.p2" class="ltx_para">
<p id="S4.SS3.SSS1.p2.1" class="ltx_p">We only describe PSS moduli spaces in detail. The case of SSP moduli spaces is similar. To define the equation and hence the moduli space, we make the following choices.</p>
<ol id="S4.I3" class="ltx_enumerate">
<li id="S4.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I3.i1.p1" class="ltx_para">
<p id="S4.I3.i1.p1.1" class="ltx_p">An integer <math id="S4.I3.i1.p1.m1" class="ltx_Math" alttext="C^{\rm PSS}\in{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>C</mi><mi>PSS</mi></msup><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">C^{\rm PSS}\in{\mathbb{Z}}</annotation></semantics></math> satisfying</p>
<table id="S4.E4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E4.m1" class="ltx_Math" alttext="\inf_{(t,x)\in S^{1}\times M}H_{t}(x)&gt;C^{\rm PSS}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">inf</mo><mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><msup><mi>S</mi><mn>1</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi></mrow></mrow></munder><mrow><msub><mi>H</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&gt;</mo><msup><mi>C</mi><mi>PSS</mi></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\inf_{(t,x)\in S^{1}\times M}H_{t}(x)&gt;C^{\rm PSS}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.4)</span></td></tr></tbody>
</table>
</div></li>
<li id="S4.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I3.i2.p1" class="ltx_para">
<p id="S4.I3.i2.p1.1" class="ltx_p">A smooth, <span id="S4.I3.i2.p1.1.1" class="ltx_text ltx_font_italic">non-decreasing</span> cut-off function <math id="S4.I3.i2.p1.m1" class="ltx_Math" alttext="\rho:{\mathbb{R}}\to[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ℝ</mi><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho:{\mathbb{R}}\to[0,1]</annotation></semantics></math> such that</p>
<table id="S4.E5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E5.m1" class="ltx_Math" alttext="\rho(s)=\left\{\begin{array}[]{cc}0,&amp;\ s\leq 0,\\
1,&amp;\ s\geq 1.\end{array}\right." display="block" intent=":literal"><semantics><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd><mrow><mn>0</mn><mo>,</mo></mrow></mtd><mtd><mrow><mrow><mi>s</mi><mo>≤</mo><mn>0</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd><mrow><mn>1</mn><mo>,</mo></mrow></mtd><mtd><mrow><mrow><mi>s</mi><mo>≥</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">\rho(s)=\left\{\begin{array}[]{cc}0,&amp;\ s\leq 0,\\
1,&amp;\ s\geq 1.\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.5)</span></td></tr></tbody>
</table>
</div></li>
</ol>
<p id="S4.SS3.SSS1.p2.2" class="ltx_p">Define a <math id="S4.SS3.SSS1.p2.m1" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-parameter family of functions</p>
<table id="S4.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex24.m1" class="ltx_Math" alttext="H_{s,t}^{{\rm PSS}}(x)=(1-\rho(s))C^{\rm PSS}+\rho(s)H_{t}(x)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>H</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi></mrow><mi>PSS</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mi>PSS</mi></msup></mrow><mo>+</mo><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H_{s,t}^{{\rm PSS}}(x)=(1-\rho(s))C^{\rm PSS}+\rho(s)H_{t}(x).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.SSS1.p2.3" class="ltx_p">Then over the cylinder <math id="S4.SS3.SSS1.p2.m2" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math> one has the vector-field-valued <math id="S4.SS3.SSS1.p2.m3" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>-form</p>
<table id="S4.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex25.m1" class="ltx_Math" alttext="X_{H}^{\rm PSS}\otimes dt" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>X</mi><mi>H</mi><mi>PSS</mi></msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">X_{H}^{\rm PSS}\otimes dt</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.SSS1.p2.4" class="ltx_p">which is defined by the Hamiltonian vector field of <math id="S4.SS3.SSS1.p2.m4" class="ltx_Math" alttext="H_{s,t}^{{\rm PSS}}(x)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>H</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi></mrow><mi>PSS</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{s,t}^{{\rm PSS}}(x)</annotation></semantics></math>.
Note that it vanishes for <math id="S4.SS3.SSS1.p2.m5" class="ltx_Math" alttext="s\leq 0" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>≤</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">s\leq 0</annotation></semantics></math>. The PSS equation is</p>
<table id="S4.E6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E6.m1" class="ltx_Math" alttext="\frac{\partial u}{\partial s}+J\left(\frac{\partial u}{\partial t}-X_{H}^{\rm PSS}(u)\right)=0,\ {\rm where}\ u\in C^{\infty}(\Theta,M)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mfrac><mrow><mo>∂</mo><mi>u</mi></mrow><mrow><mo>∂</mo><mi>s</mi></mrow></mfrac><mo>+</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mrow><mo>∂</mo><mi>u</mi></mrow><mrow><mo>∂</mo><mi>t</mi></mrow></mfrac><mo>−</mo><mrow><msubsup><mi>X</mi><mi>H</mi><mi>PSS</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mi>where</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>u</mi></mrow><mo>∈</mo><mrow><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo>,</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\partial u}{\partial s}+J\left(\frac{\partial u}{\partial t}-X_{H}^{\rm PSS}(u)\right)=0,\ {\rm where}\ u\in C^{\infty}(\Theta,M).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.6)</span></td></tr></tbody>
</table>
<p id="S4.SS3.SSS1.p2.5" class="ltx_p">The energy of a solution is defined to be and is computed as</p>
<table id="S4.Ex26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex26.m1" class="ltx_Math" alttext="\begin{split}E^{\rm PSS}(u):=&amp;\ \int_{\Theta}\|\partial_{s}u\|^{2}dsdt\\
=&amp;\ \int_{\Theta}\omega(\partial_{s}u,\partial_{t}u-X_{H}^{\rm PSS}(u))dsdt\\
=&amp;\ \int_{\Theta}u^{*}\omega+\int_{\Theta}dH_{s,t}^{\rm PSS}(\partial_{s}u)dsdt\\
=&amp;\ \int_{\Theta}u^{*}\omega+\int_{\Theta}\frac{\partial}{\partial s}(H_{s,t}^{\rm PSS}(u))dsdt-\int_{\Theta}\frac{\partial H^{\rm PSS}_{s,t}}{\partial s}dsdt.\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><msup><mi>E</mi><mi>PSS</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mphantom></mphantom></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mo>∫</mo><mi mathvariant="normal">Θ</mi></msub><mrow><msup><mrow><mo lspace="0em" stretchy="false">‖</mo><mrow><msub><mo lspace="0em">∂</mo><mi>s</mi></msub><mi>u</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mo>∫</mo><mi mathvariant="normal">Θ</mi></msub><mrow><mrow><mi>ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mo lspace="0em">∂</mo><mi>s</mi></msub><mi>u</mi></mrow><mo rspace="0em">,</mo><mrow><mrow><msub><mo>∂</mo><mi>t</mi></msub><mi>u</mi></mrow><mo>−</mo><mrow><msubsup><mi>X</mi><mi>H</mi><mi>PSS</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mo>∫</mo><mi mathvariant="normal">Θ</mi></msub><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow></mrow><mo rspace="0.055em">+</mo><mrow><msub><mo>∫</mo><mi mathvariant="normal">Θ</mi></msub><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>H</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi></mrow><mi>PSS</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mo lspace="0em">∂</mo><mi>s</mi></msub><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mrow><msub><mo>∫</mo><mi mathvariant="normal">Θ</mi></msub><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow></mrow><mo rspace="0.055em">+</mo><mrow><msub><mo>∫</mo><mi mathvariant="normal">Θ</mi></msub><mrow><mfrac><mo>∂</mo><mrow><mo>∂</mo><mi>s</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>H</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi></mrow><mi>PSS</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>s</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>t</mi></mrow></mrow></mrow></mrow><mo rspace="0.055em">−</mo><mrow><msub><mo>∫</mo><mi mathvariant="normal">Θ</mi></msub><mrow><mfrac><mrow><mo>∂</mo><msubsup><mi>H</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi></mrow><mi>PSS</mi></msubsup></mrow><mrow><mo>∂</mo><mi>s</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>s</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>t</mi></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}E^{\rm PSS}(u):=&amp;\ \int_{\Theta}\|\partial_{s}u\|^{2}dsdt\\
=&amp;\ \int_{\Theta}\omega(\partial_{s}u,\partial_{t}u-X_{H}^{\rm PSS}(u))dsdt\\
=&amp;\ \int_{\Theta}u^{*}\omega+\int_{\Theta}dH_{s,t}^{\rm PSS}(\partial_{s}u)dsdt\\
=&amp;\ \int_{\Theta}u^{*}\omega+\int_{\Theta}\frac{\partial}{\partial s}(H_{s,t}^{\rm PSS}(u))dsdt-\int_{\Theta}\frac{\partial H^{\rm PSS}_{s,t}}{\partial s}dsdt.\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.SSS1.p2.6" class="ltx_p">If the energy is finite, then by Gromov’s removal of singularity theorem, <math id="S4.SS3.SSS1.p2.m6" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> extends to a <math id="S4.SS3.SSS1.p2.m7" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math>-holomorphic map near <math id="S4.SS3.SSS1.p2.m8" class="ltx_Math" alttext="-\infty" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">-\infty</annotation></semantics></math> and hence automatically determines a cap for the periodic orbit at <math id="S4.SS3.SSS1.p2.m9" class="ltx_Math" alttext="+\infty" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">+\infty</annotation></semantics></math>. Hence one can use a capped 1-periodic orbit <math id="S4.SS3.SSS1.p2.m10" class="ltx_Math" alttext="p\in\widetilde{{\rm Per}}(H)" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mrow><mover accent="true"><mi>Per</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p\in\widetilde{{\rm Per}}(H)</annotation></semantics></math> to label the moduli space of PSS solutions. It is similar to the case of Floer trajectories that <math id="S4.SS3.SSS1.p2.m11" class="ltx_math_unparsed" alttext="{\mathcal{M}}{}_{\bullet p}^{\rm PSS}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><msub><mrow></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>p</mi></mrow></msub><msup><mrow></mrow><mi>PSS</mi></msup></mrow><annotation encoding="application/x-tex">{\mathcal{M}}{}_{\bullet p}^{\rm PSS}</annotation></semantics></math> admits a natural compactification consisting of “stable PSS trajectories,” i.e. configurations with both cylindrical and spherical components. Denote the compactification by</p>
<table id="S4.E7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E7.m1" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{\bullet p}^{\rm PSS}." display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>p</mi></mrow></msub><msup><mrow></mrow><mi>PSS</mi></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{\bullet p}^{\rm PSS}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.7)</span></td></tr></tbody>
</table>
</div>
<div id="S4.SS3.SSS1.p3" class="ltx_para">
<p id="S4.SS3.SSS1.p3.1" class="ltx_p">For each map <math id="S4.SS3.SSS1.p3.m1" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> representing an element of <math id="S4.SS3.SSS1.p3.m2" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{\bullet p}^{\rm PSS}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>p</mi></mrow></msub><msup><mrow></mrow><mi>PSS</mi></msup></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{\bullet p}^{\rm PSS}</annotation></semantics></math>, one has the following energy identity</p>
<table id="S4.Ex27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex27.m1" class="ltx_Math" alttext="E^{\rm PSS}(u)={\mathcal{A}}_{H}(p)-C^{\rm PSS}-\int_{\Theta}\rho^{\prime}(s)(H(u)-C^{\rm PSS})dsdt." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>E</mi><mi>PSS</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi>C</mi><mi>PSS</mi></msup><mo rspace="0.055em">−</mo><mrow><msub><mo>∫</mo><mi mathvariant="normal">Θ</mi></msub><mrow><msup><mi>ρ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi>C</mi><mi>PSS</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">E^{\rm PSS}(u)={\mathcal{A}}_{H}(p)-C^{\rm PSS}-\int_{\Theta}\rho^{\prime}(s)(H(u)-C^{\rm PSS})dsdt.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.SSS1.p3.2" class="ltx_p">An important consequence of (<a href="#S4.E4" title="In item 1 ‣ 4.3.1. Moduli spaces ‣ 4.3. PSS and SSP bimodules ‣ 4. Proof of the integral Arnold conjecture ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.4</span></a>) is that</p>
<table id="S4.E8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E8.m1" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{\bullet p}^{\rm PSS}\neq\emptyset\Longrightarrow{\mathcal{A}}_{H}(p)-C^{\rm PSS}&gt;0." display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mo>≠</mo><mrow></mrow><mi>PSS</mi><mprescripts></mprescripts><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>p</mi></mrow><mrow></mrow></mmultiscripts><mi mathvariant="normal">∅</mi><mo stretchy="false">⟹</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>H</mi></msub><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>C</mi><mi>PSS</mi></msup><mo>&gt;</mo><mn>0</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{\bullet p}^{\rm PSS}\neq\emptyset\Longrightarrow{\mathcal{A}}_{H}(p)-C^{\rm PSS}&gt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.8)</span></td></tr></tbody>
</table>
<p id="S4.SS3.SSS1.p3.3" class="ltx_p">We introduce</p>
<table id="S4.Ex28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex28.m1" class="ltx_Math" alttext="d_{\bullet p}:={\mathcal{A}}_{H}(p)-C^{\rm PSS}" display="block" intent=":literal"><semantics><mrow><msub><mi>d</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>p</mi></mrow></msub><mo>:=</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi>C</mi><mi>PSS</mi></msup></mrow></mrow><annotation encoding="application/x-tex">d_{\bullet p}:={\mathcal{A}}_{H}(p)-C^{\rm PSS}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.SSS1.p3.4" class="ltx_p">and call it the <span id="S4.SS3.SSS1.p3.4.1" class="ltx_text ltx_font_bold">topological energy</span> of a solution <math id="S4.SS3.SSS1.p3.m3" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math>.</p>
</div>
<div id="S4.SS3.SSS1.p4" class="ltx_para">
<p id="S4.SS3.SSS1.p4.1" class="ltx_p">Now we bring in the Morse theory of a Morse–Smale pair <math id="S4.SS3.SSS1.p4.m1" class="ltx_Math" alttext="(f,g)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(f,g)</annotation></semantics></math>. Given <math id="S4.SS3.SSS1.p4.m2" class="ltx_Math" alttext="\underline{\smash{x}}\in{\rm crit}(f)" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo>∈</mo><mrow><mi>crit</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\underline{\smash{x}}\in{\rm crit}(f)</annotation></semantics></math>, consider the unstable manifold <math id="S4.SS3.SSS1.p4.m3" class="ltx_Math" alttext="W^{u}(\underline{\smash{x}})\subset M" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>W</mi><mi>u</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">W^{u}(\underline{\smash{x}})\subset M</annotation></semantics></math> of the flow of <math id="S4.SS3.SSS1.p4.m4" class="ltx_Math" alttext="\nabla^{g}f" display="inline" intent=":literal"><semantics><mrow><msup><mo>∇</mo><mi>g</mi></msup><mi>f</mi></mrow><annotation encoding="application/x-tex">\nabla^{g}f</annotation></semantics></math> and its compactification <math id="S4.SS3.SSS1.p4.m5" class="ltx_Math" alttext="\overline{W^{u}(\underline{\smash{x}})}" display="inline" intent=":literal"><semantics><mover accent="true"><mrow><msup><mi>W</mi><mi>u</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{W^{u}(\underline{\smash{x}})}</annotation></semantics></math>. Then define</p>
<table id="S4.Ex29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex29.m1" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{\underline{\smash{x}}p}^{\rm PSS}:={\rm ev}_{\bullet}^{-1}(\overline{W^{u}(\underline{\smash{x}})})," display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mo>:=</mo><mrow></mrow><mi>PSS</mi><mprescripts></mprescripts><mrow><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mrow></mrow></mmultiscripts><msubsup><mi>ev</mi><mo>∙</mo><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mo stretchy="false">(</mo><mover accent="true"><mrow><msup><mi>W</mi><mi>u</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="true">¯</mo></mover><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{\underline{\smash{x}}p}^{\rm PSS}:={\rm ev}_{\bullet}^{-1}(\overline{W^{u}(\underline{\smash{x}})}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.SSS1.p4.2" class="ltx_p">where <math id="S4.SS3.SSS1.p4.m6" class="ltx_math_unparsed" alttext="{\rm ev}_{\bullet}:\overline{\mathcal{M}}{}_{\bullet p}^{\rm PSS}\to M" display="inline" intent=":literal"><semantics><mrow><mi>ev</mi><msub><mrow></mrow><mo>∙</mo></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>p</mi></mrow></msub><msup><mrow></mrow><mi>PSS</mi></msup><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">{\rm ev}_{\bullet}:\overline{\mathcal{M}}{}_{\bullet p}^{\rm PSS}\to M</annotation></semantics></math> is the evaluation map at <math id="S4.SS3.SSS1.p4.m7" class="ltx_Math" alttext="-\infty" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">-\infty</annotation></semantics></math>.
Moreover, if <math id="S4.SS3.SSS1.p4.m8" class="ltx_Math" alttext="x=(a,\underline{\smash{x}})\in{\mathcal{P}}^{\rm Morse}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Morse</mi></msup></mrow><annotation encoding="application/x-tex">x=(a,\underline{\smash{x}})\in{\mathcal{P}}^{\rm Morse}</annotation></semantics></math> and <math id="S4.SS3.SSS1.p4.m9" class="ltx_Math" alttext="p\in{\mathcal{P}}^{\rm Floer}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Floer</mi></msup></mrow><annotation encoding="application/x-tex">p\in{\mathcal{P}}^{\rm Floer}</annotation></semantics></math>, then define</p>
<table id="S4.Ex30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex30.m1" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{xp}^{\rm PSS}:=\overline{\mathcal{M}}{}_{\underline{\smash{x}}\ (-a)\cdot p}^{\rm PSS}." display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msub><msup><mrow></mrow><mi>PSS</mi></msup><mo>:=</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mrow><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo lspace="0.410em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>a</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mi>p</mi></mrow></msub><msup><mrow></mrow><mi>PSS</mi></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{xp}^{\rm PSS}:=\overline{\mathcal{M}}{}_{\underline{\smash{x}}\ (-a)\cdot p}^{\rm PSS}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.SS3.SSS1.p5" class="ltx_para">
<p id="S4.SS3.SSS1.p5.1" class="ltx_p">The stratifications on the PSS moduli spaces fit into the general framework of bimodules described in the previous section. Recall that to <math id="S4.SS3.SSS1.p5.m1" class="ltx_Math" alttext="x\in{\mathcal{P}}={\mathcal{P}}^{\rm Morse}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>=</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Morse</mi></msup></mrow><annotation encoding="application/x-tex">x\in{\mathcal{P}}={\mathcal{P}}^{\rm Morse}</annotation></semantics></math> and <math id="S4.SS3.SSS1.p5.m2" class="ltx_Math" alttext="p\in{\mathcal{P}}^{\prime}={\mathcal{P}}^{\rm Floer}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup><mo>=</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Floer</mi></msup></mrow><annotation encoding="application/x-tex">p\in{\mathcal{P}}^{\prime}={\mathcal{P}}^{\rm Floer}</annotation></semantics></math> one associates a homogeneous poset</p>
<table id="S4.Ex31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex31.m1" class="ltx_math_unparsed" alttext="{\mathbb{A}}_{xp}:={\mathbb{A}}_{xp}^{\rm PSS}:=\{xy_{1}\cdots y_{k}q_{l}\cdots q_{1}p\ |\ x&lt;y_{1}&lt;\cdots&lt;y_{k},q_{l}&lt;\cdots&lt;q_{1}&lt;p\}" display="block" intent=":literal"><semantics><mrow><msub><mi>𝔸</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msub><mo>:=</mo><msubsup><mi>𝔸</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mi>PSS</mi></msubsup><mo>:=</mo><mrow><mo stretchy="false">{</mo><mi>x</mi><msub><mi>y</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>y</mi><mi>k</mi></msub><msub><mi>q</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>q</mi><mn>1</mn></msub><mi>p</mi><mo fence="false" lspace="0.500em" rspace="0.667em" stretchy="false">|</mo><mi>x</mi><mo>&lt;</mo><msub><mi>y</mi><mn>1</mn></msub><mo rspace="0.1389em">&lt;</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">&lt;</mo><msub><mi>y</mi><mi>k</mi></msub><mo>,</mo><msub><mi>q</mi><mi>l</mi></msub><mo rspace="0.1389em">&lt;</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">&lt;</mo><msub><mi>q</mi><mn>1</mn></msub><mo>&lt;</mo><mi>p</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{A}}_{xp}:={\mathbb{A}}_{xp}^{\rm PSS}:=\{xy_{1}\cdots y_{k}q_{l}\cdots q_{1}p\ |\ x&lt;y_{1}&lt;\cdots&lt;y_{k},q_{l}&lt;\cdots&lt;q_{1}&lt;p\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.SSS1.p5.2" class="ltx_p">which has the natural partial order induced from inclusion and the depth function</p>
<table id="S4.Ex32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex32.m1" class="ltx_math_unparsed" alttext="{\rm depth}(xy_{1}\cdots y_{k}q_{l}\cdots q_{1}p)=k+l." display="block" intent=":literal"><semantics><mrow><mi>depth</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><msub><mi>y</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>y</mi><mi>k</mi></msub><msub><mi>q</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>q</mi><mn>1</mn></msub><mi>p</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>k</mi><mo>+</mo><mi>l</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\rm depth}(xy_{1}\cdots y_{k}q_{l}\cdots q_{1}p)=k+l.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.SSS1.p5.3" class="ltx_p">The PSS moduli space <math id="S4.SS3.SSS1.p5.m3" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{xp}^{\rm PSS}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msub><msup><mrow></mrow><mi>PSS</mi></msup></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{xp}^{\rm PSS}</annotation></semantics></math> is stratified by <math id="S4.SS3.SSS1.p5.m4" class="ltx_Math" alttext="{\mathbb{A}}_{xp}^{\rm PSS}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔸</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mi>PSS</mi></msubsup><annotation encoding="application/x-tex">{\mathbb{A}}_{xp}^{\rm PSS}</annotation></semantics></math> with corresponding strata</p>
<table id="S4.Ex33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex33.m1" class="ltx_math_unparsed" alttext="\left(\overline{\mathcal{M}}{}_{xp}^{\rm PSS}\right)_{xy_{1}\cdots y_{k}q_{l}\cdots q_{1}}\cong\overline{\mathcal{M}}{}_{xy_{1}}^{\rm Morse}\times\cdots\times\overline{\mathcal{M}}{}_{y_{k-1}y_{k}}^{\rm Morse}\times\overline{\mathcal{M}}{}_{y_{k}q_{l}}^{\rm PSS}\times\overline{\mathcal{M}}{}_{q_{l}q_{l-1}}^{\rm Floer}\times\cdots\times\overline{\mathcal{M}}{}_{q_{1}p}^{\rm Floer}" display="block" intent=":literal"><semantics><mrow><msub><mrow><mo>(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mo>)</mo><mrow></mrow><mi>PSS</mi><mprescripts></mprescripts><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mrow></mrow></mmultiscripts></mrow><mrow><mi>x</mi><mi>y</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>y</mi><msub><mrow></mrow><mi>k</mi></msub><mi>q</mi><msub><mrow></mrow><mi>l</mi></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>q</mi><msub><mrow></mrow><mn>1</mn></msub></mrow></msub><mo>≅</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mo lspace="0.222em">×</mo><mrow></mrow><mi>Morse</mi><mprescripts></mprescripts><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mn>1</mn></msub></mrow><mrow></mrow></mmultiscripts><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mo lspace="0.222em" rspace="0.222em">×</mo><mrow></mrow><mi>Morse</mi><mprescripts></mprescripts><mrow><msub><mi>y</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>k</mi></msub></mrow><mrow></mrow></mmultiscripts><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mo lspace="0.222em" rspace="0.222em">×</mo><mrow></mrow><mi>PSS</mi><mprescripts></mprescripts><mrow><msub><mi>y</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>l</mi></msub></mrow><mrow></mrow></mmultiscripts><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mo lspace="0.222em">×</mo><mrow></mrow><mi>Floer</mi><mprescripts></mprescripts><mrow><msub><mi>q</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mrow></mrow></mmultiscripts><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mphantom></mphantom><mrow></mrow><mi>Floer</mi><mprescripts></mprescripts><mrow><msub><mi>q</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">\left(\overline{\mathcal{M}}{}_{xp}^{\rm PSS}\right)_{xy_{1}\cdots y_{k}q_{l}\cdots q_{1}}\cong\overline{\mathcal{M}}{}_{xy_{1}}^{\rm Morse}\times\cdots\times\overline{\mathcal{M}}{}_{y_{k-1}y_{k}}^{\rm Morse}\times\overline{\mathcal{M}}{}_{y_{k}q_{l}}^{\rm PSS}\times\overline{\mathcal{M}}{}_{q_{l}q_{l-1}}^{\rm Floer}\times\cdots\times\overline{\mathcal{M}}{}_{q_{1}p}^{\rm Floer}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.SSS1.p5.4" class="ltx_p">i.e., the subset of configurations with breakings described by the word <math id="S4.SS3.SSS1.p5.m5" class="ltx_math_unparsed" alttext="xy_{1}\cdots y_{k}q_{l}\cdots q_{1}p" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mi>y</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>y</mi><msub><mrow></mrow><mi>k</mi></msub><mi>q</mi><msub><mrow></mrow><mi>l</mi></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>q</mi><msub><mrow></mrow><mn>1</mn></msub><mi>p</mi></mrow><annotation encoding="application/x-tex">xy_{1}\cdots y_{k}q_{l}\cdots q_{1}p</annotation></semantics></math>. Gromov compactness shows that there are at most finitely many nonempty stratum.</p>
</div>
<div id="S4.SS3.SSS1.p6" class="ltx_para">
<p id="S4.SS3.SSS1.p6.1" class="ltx_p">To define the SSP moduli spaces, let us choose an integer <math id="S4.SS3.SSS1.p6.m1" class="ltx_Math" alttext="C^{\rm SSP}\in{\mathbb{Z}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>C</mi><mi>SSP</mi></msup><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">C^{\rm SSP}\in{\mathbb{Z}}</annotation></semantics></math> such that</p>
<table id="S4.E9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E9.m1" class="ltx_Math" alttext="\sup_{(t,x)\in S^{1}\times M}H_{t}(x)&lt;C^{\rm SSP}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><msup><mi>S</mi><mn>1</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi></mrow></mrow></munder><mrow><msub><mi>H</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&lt;</mo><msup><mi>C</mi><mi>SSP</mi></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sup_{(t,x)\in S^{1}\times M}H_{t}(x)&lt;C^{\rm SSP}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.9)</span></td></tr></tbody>
</table>
<p id="S4.SS3.SSS1.p6.2" class="ltx_p">Using the same cut-off function as in (<a href="#S4.E5" title="In item 2 ‣ 4.3.1. Moduli spaces ‣ 4.3. PSS and SSP bimodules ‣ 4. Proof of the integral Arnold conjecture ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.5</span></a>), we can write down another <math id="S4.SS3.SSS1.p6.m2" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-parameter family of functions</p>
<table id="S4.E10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E10.m1" class="ltx_Math" alttext="H_{s,t}^{{\rm SSP}}(x)=(1-\rho(s))H_{t}(x)+\rho(s)C^{{\rm SSP}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>H</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi></mrow><mi>SSP</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mi>SSP</mi></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H_{s,t}^{{\rm SSP}}(x)=(1-\rho(s))H_{t}(x)+\rho(s)C^{{\rm SSP}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.10)</span></td></tr></tbody>
</table>
<p id="S4.SS3.SSS1.p6.3" class="ltx_p">Denote the associated vector-field-valued <math id="S4.SS3.SSS1.p6.m3" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>-form on <math id="S4.SS3.SSS1.p6.m4" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math> by <math id="S4.SS3.SSS1.p6.m5" class="ltx_Math" alttext="X_{H}^{{\rm SSP}}\otimes dt" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>X</mi><mi>H</mi><mi>SSP</mi></msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">X_{H}^{{\rm SSP}}\otimes dt</annotation></semantics></math>, then the SSP equation is written as</p>
<table id="S4.Ex34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex34.m1" class="ltx_Math" alttext="\frac{\partial u}{\partial s}+J\left(\frac{\partial u}{\partial t}-X_{H}^{\rm SSP}(u)\right)=0,\ {\rm where}\ u\in C^{\infty}(\Theta,M)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mfrac><mrow><mo>∂</mo><mi>u</mi></mrow><mrow><mo>∂</mo><mi>s</mi></mrow></mfrac><mo>+</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mrow><mo>∂</mo><mi>u</mi></mrow><mrow><mo>∂</mo><mi>t</mi></mrow></mfrac><mo>−</mo><mrow><msubsup><mi>X</mi><mi>H</mi><mi>SSP</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mi>where</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>u</mi></mrow><mo>∈</mo><mrow><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo>,</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\partial u}{\partial s}+J\left(\frac{\partial u}{\partial t}-X_{H}^{\rm SSP}(u)\right)=0,\ {\rm where}\ u\in C^{\infty}(\Theta,M).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.SSS1.p6.4" class="ltx_p">Because <math id="S4.SS3.SSS1.p6.m6" class="ltx_Math" alttext="X_{H}^{{\rm SSP}}dt" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>X</mi><mi>H</mi><mi>SSP</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">X_{H}^{{\rm SSP}}dt</annotation></semantics></math> vanishes for <math id="S4.SS3.SSS1.p6.m7" class="ltx_Math" alttext="s\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">s\geq 0</annotation></semantics></math>, any solution <math id="S4.SS3.SSS1.p6.m8" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> extends to a <math id="S4.SS3.SSS1.p6.m9" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math>-holomorphic map near <math id="S4.SS3.SSS1.p6.m10" class="ltx_Math" alttext="+\infty" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">+\infty</annotation></semantics></math>, which determines a cap for the periodic orbit at <math id="S4.SS3.SSS1.p6.m11" class="ltx_Math" alttext="-\infty" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">-\infty</annotation></semantics></math>. Given <math id="S4.SS3.SSS1.p6.m12" class="ltx_Math" alttext="p\in\widetilde{{\rm Per}}(H)" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mrow><mover accent="true"><mi>Per</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p\in\widetilde{{\rm Per}}(H)</annotation></semantics></math>, we cam similarly consider “stable SSP trajectories” which constitute a compact moduli space</p>
<table id="S4.Ex35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex35.m1" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{p\bullet}^{{\rm SSP}}." display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow></msub><msup><mrow></mrow><mi>SSP</mi></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{p\bullet}^{{\rm SSP}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.SSS1.p6.5" class="ltx_p">For any representative <math id="S4.SS3.SSS1.p6.m13" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> of a point in <math id="S4.SS3.SSS1.p6.m14" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}_{p\bullet}^{{\rm SSP}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow></msub><msup><mrow></mrow><mi>SSP</mi></msup></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{p\bullet}^{{\rm SSP}}</annotation></semantics></math>, its topological energy is defined to be</p>
<table id="S4.Ex36" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex36.m1" class="ltx_math_unparsed" alttext="d_{p\bullet}:=C^{\rm SSP}-\mathcal{A}_{H}(p)." display="block" intent=":literal"><semantics><mrow><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow></msub><mo>:=</mo><msup><mi>C</mi><mi>SSP</mi></msup><mo>−</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>H</mi></msub><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">d_{p\bullet}:=C^{\rm SSP}-\mathcal{A}_{H}(p).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.SSS1.p6.6" class="ltx_p">Due to the choice (<a href="#S4.E9" title="In 4.3.1. Moduli spaces ‣ 4.3. PSS and SSP bimodules ‣ 4. Proof of the integral Arnold conjecture ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.9</span></a>), we see that <math id="S4.SS3.SSS1.p6.m15" class="ltx_math_unparsed" alttext="d_{p\bullet}&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d_{p\bullet}&gt;0</annotation></semantics></math> as long as <math id="S4.SS3.SSS1.p6.m16" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}_{p\bullet}^{{\rm SSP}}\neq\emptyset" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow></msub><msup><mrow></mrow><mi>SSP</mi></msup><mo>≠</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}_{p\bullet}^{{\rm SSP}}\neq\emptyset</annotation></semantics></math>. Now suppose <math id="S4.SS3.SSS1.p6.m17" class="ltx_Math" alttext="\underline{\smash{x}}\in{\rm crit}(f)" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo>∈</mo><mrow><mi>crit</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\underline{\smash{x}}\in{\rm crit}(f)</annotation></semantics></math>, let <math id="S4.SS3.SSS1.p6.m18" class="ltx_Math" alttext="W^{s}(\underline{\smash{x}})\subset M" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>W</mi><mi>s</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">W^{s}(\underline{\smash{x}})\subset M</annotation></semantics></math> be the stable submanifold of <math id="S4.SS3.SSS1.p6.m19" class="ltx_Math" alttext="\nabla^{g}f" display="inline" intent=":literal"><semantics><mrow><msup><mo>∇</mo><mi>g</mi></msup><mi>f</mi></mrow><annotation encoding="application/x-tex">\nabla^{g}f</annotation></semantics></math> and denote by <math id="S4.SS3.SSS1.p6.m20" class="ltx_Math" alttext="\overline{W^{s}(\underline{\smash{x}})}" display="inline" intent=":literal"><semantics><mover accent="true"><mrow><msup><mi>W</mi><mi>s</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{W^{s}(\underline{\smash{x}})}</annotation></semantics></math> its compactification. Introduce the moduli space</p>
<table id="S4.Ex37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex37.m1" class="ltx_Math" alttext="\overline{\mathcal{M}}^{{\rm SSP}}_{p\underline{\smash{x}}}:={\rm ev}_{\bullet}^{-1}(\overline{W^{s}(\underline{\smash{x}})})," display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder></mrow><mi>SSP</mi></msubsup><mo>:=</mo><mrow><msubsup><mi>ev</mi><mo>∙</mo><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mrow><msup><mi>W</mi><mi>s</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="true">¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}^{{\rm SSP}}_{p\underline{\smash{x}}}:={\rm ev}_{\bullet}^{-1}(\overline{W^{s}(\underline{\smash{x}})}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.SSS1.p6.7" class="ltx_p">where <math id="S4.SS3.SSS1.p6.m21" class="ltx_math_unparsed" alttext="{\rm ev}_{\bullet}:\overline{\mathcal{M}}_{p\bullet}^{{\rm SSP}}\to M" display="inline" intent=":literal"><semantics><mrow><mi>ev</mi><msub><mrow></mrow><mo>∙</mo></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow></msub><msup><mrow></mrow><mi>SSP</mi></msup><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">{\rm ev}_{\bullet}:\overline{\mathcal{M}}_{p\bullet}^{{\rm SSP}}\to M</annotation></semantics></math> is the evaluation map at <math id="S4.SS3.SSS1.p6.m22" class="ltx_Math" alttext="+\infty" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">+\infty</annotation></semantics></math>. If <math id="S4.SS3.SSS1.p6.m23" class="ltx_Math" alttext="x=(a,\underline{\smash{x}})\in{\mathcal{P}}^{\rm Morse}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Morse</mi></msup></mrow><annotation encoding="application/x-tex">x=(a,\underline{\smash{x}})\in{\mathcal{P}}^{\rm Morse}</annotation></semantics></math> and <math id="S4.SS3.SSS1.p6.m24" class="ltx_Math" alttext="p\in{\mathcal{P}}^{\rm Floer}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Floer</mi></msup></mrow><annotation encoding="application/x-tex">p\in{\mathcal{P}}^{\rm Floer}</annotation></semantics></math>, then define</p>
<table id="S4.Ex38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex38.m1" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{px}^{\rm SSP}:=\overline{\mathcal{M}}{}_{a\cdot p\ \underline{\smash{x}}}^{\rm SSP}." display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msub><msup><mrow></mrow><mi>SSP</mi></msup><mo>:=</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mrow><mi>a</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>p</mi></mrow><mo lspace="0.410em" rspace="0em">​</mo><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder></mrow></msub><msup><mrow></mrow><mi>SSP</mi></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{px}^{\rm SSP}:=\overline{\mathcal{M}}{}_{a\cdot p\ \underline{\smash{x}}}^{\rm SSP}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.SSS1.p6.8" class="ltx_p">Similar to the PSS case, the homogeneous posets associated with SSP spaces are denoted by</p>
<table id="S4.Ex39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex39.m1" class="ltx_math_unparsed" alttext="{\mathbb{A}}_{px}^{\rm SSP}:=\{pq_{1}\cdots q_{l}y_{k}\cdots y_{1}x|\ p&lt;q_{1}&lt;\cdots&lt;q_{l},y_{k}&lt;\cdots&lt;y_{1}&lt;x\}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mi>SSP</mi></msubsup><mo>:=</mo><mrow><mo stretchy="false">{</mo><mi>p</mi><msub><mi>q</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>q</mi><mi>l</mi></msub><msub><mi>y</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>y</mi><mn>1</mn></msub><mi>x</mi><mo fence="false" rspace="0.667em" stretchy="false">|</mo><mi>p</mi><mo>&lt;</mo><msub><mi>q</mi><mn>1</mn></msub><mo rspace="0.1389em">&lt;</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">&lt;</mo><msub><mi>q</mi><mi>l</mi></msub><mo>,</mo><msub><mi>y</mi><mi>k</mi></msub><mo rspace="0.1389em">&lt;</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">&lt;</mo><msub><mi>y</mi><mn>1</mn></msub><mo>&lt;</mo><mi>x</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{A}}_{px}^{\rm SSP}:=\{pq_{1}\cdots q_{l}y_{k}\cdots y_{1}x|\ p&lt;q_{1}&lt;\cdots&lt;q_{l},y_{k}&lt;\cdots&lt;y_{1}&lt;x\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.SSS1.p6.9" class="ltx_p">for <math id="S4.SS3.SSS1.p6.m25" class="ltx_Math" alttext="p\in{\mathcal{P}}^{\rm Floer}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Floer</mi></msup></mrow><annotation encoding="application/x-tex">p\in{\mathcal{P}}^{\rm Floer}</annotation></semantics></math> and <math id="S4.SS3.SSS1.p6.m26" class="ltx_Math" alttext="x\in{\mathcal{P}}^{\rm Morse}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Morse</mi></msup></mrow><annotation encoding="application/x-tex">x\in{\mathcal{P}}^{\rm Morse}</annotation></semantics></math>, endowed with depth function</p>
<table id="S4.Ex40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex40.m1" class="ltx_math_unparsed" alttext="{\rm depth}(pq_{1}\cdots q_{l}y_{k}\cdots y_{1}x)=k+l." display="block" intent=":literal"><semantics><mrow><mi>depth</mi><mrow><mo stretchy="false">(</mo><mi>p</mi><msub><mi>q</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>q</mi><mi>l</mi></msub><msub><mi>y</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>y</mi><mn>1</mn></msub><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>k</mi><mo>+</mo><mi>l</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\rm depth}(pq_{1}\cdots q_{l}y_{k}\cdots y_{1}x)=k+l.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.SSS1.p6.10" class="ltx_p"><math id="S4.SS3.SSS1.p6.m27" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{px}^{\rm SSP}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msub><msup><mrow></mrow><mi>SSP</mi></msup></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{px}^{\rm SSP}</annotation></semantics></math> is stratified by <math id="S4.SS3.SSS1.p6.m28" class="ltx_Math" alttext="{\mathbb{A}}_{px}^{\rm SSP}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mi>SSP</mi></msubsup><annotation encoding="application/x-tex">{\mathbb{A}}_{px}^{\rm SSP}</annotation></semantics></math> with corresponding strata</p>
<table id="S4.Ex41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex41.m1" class="ltx_math_unparsed" alttext="\left(\overline{\mathcal{M}}{}_{px}^{\rm SSP}\right)_{pq_{1}\cdots q_{l}y_{k}\cdots y_{1}x}\cong\overline{\mathcal{M}}{}_{pq_{1}}^{\rm Floer}\times\cdots\times\overline{\mathcal{M}}{}_{q_{l-1}q_{l}}^{\rm Floer}\times\overline{\mathcal{M}}{}_{q_{l}y_{k}}^{\rm SSP}\times\overline{\mathcal{M}}{}_{y_{k}y_{k-1}}^{\rm Morse}\times\cdots\times\overline{\mathcal{M}}{}_{y_{1}x}^{\rm Morse}." display="block" intent=":literal"><semantics><mrow><msub><mrow><mo>(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mo>)</mo><mrow></mrow><mi>SSP</mi><mprescripts></mprescripts><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mrow></mrow></mmultiscripts></mrow><mrow><mi>p</mi><mi>q</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>q</mi><msub><mrow></mrow><mi>l</mi></msub><mi>y</mi><msub><mrow></mrow><mi>k</mi></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>y</mi><msub><mrow></mrow><mn>1</mn></msub><mi>x</mi></mrow></msub><mo>≅</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mo lspace="0.222em">×</mo><mrow></mrow><mi>Floer</mi><mprescripts></mprescripts><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mn>1</mn></msub></mrow><mrow></mrow></mmultiscripts><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mo lspace="0.222em" rspace="0.222em">×</mo><mrow></mrow><mi>Floer</mi><mprescripts></mprescripts><mrow><msub><mi>q</mi><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>l</mi></msub></mrow><mrow></mrow></mmultiscripts><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mo lspace="0.222em" rspace="0.222em">×</mo><mrow></mrow><mi>SSP</mi><mprescripts></mprescripts><mrow><msub><mi>q</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>k</mi></msub></mrow><mrow></mrow></mmultiscripts><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mo lspace="0.222em">×</mo><mrow></mrow><mi>Morse</mi><mprescripts></mprescripts><mrow><msub><mi>y</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mrow></mrow></mmultiscripts><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mo lspace="0em">.</mo><mrow></mrow><mi>Morse</mi><mprescripts></mprescripts><mrow><msub><mi>y</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">\left(\overline{\mathcal{M}}{}_{px}^{\rm SSP}\right)_{pq_{1}\cdots q_{l}y_{k}\cdots y_{1}x}\cong\overline{\mathcal{M}}{}_{pq_{1}}^{\rm Floer}\times\cdots\times\overline{\mathcal{M}}{}_{q_{l-1}q_{l}}^{\rm Floer}\times\overline{\mathcal{M}}{}_{q_{l}y_{k}}^{\rm SSP}\times\overline{\mathcal{M}}{}_{y_{k}y_{k-1}}^{\rm Morse}\times\cdots\times\overline{\mathcal{M}}{}_{y_{1}x}^{\rm Morse}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="S4.SS3.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">4.3.2. </span>The bimodule structure</h4>

<div id="S4.SS3.SSS2.p1" class="ltx_para">
<p id="S4.SS3.SSS2.p1.1" class="ltx_p">The PSS and SSP moduli spaces can be packaged into two flow bimodules (see Definition <a href="#S3.Thmthm10" title="Definition 3.10. ‣ 3.2.1. Flow bimodules ‣ 3.2. Topological flow categories and bimodules ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.10</span></a>). Recall that one has the Floer flow category <math id="S4.SS3.SSS2.p1.m1" class="ltx_Math" alttext="T^{\rm Floer}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi>Floer</mi></msup><annotation encoding="application/x-tex">T^{\rm Floer}</annotation></semantics></math> and the Morse flow category <math id="S4.SS3.SSS2.p1.m2" class="ltx_Math" alttext="T^{\rm Morse}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi>Morse</mi></msup><annotation encoding="application/x-tex">T^{\rm Morse}</annotation></semantics></math>. Essentially by the way we compactify the PSS resp. SSP moduli spaces we see that one can define a flow bimodule <math id="S4.SS3.SSS2.p1.m3" class="ltx_Math" alttext="M^{\rm PSS}" display="inline" intent=":literal"><semantics><msup><mi>M</mi><mi>PSS</mi></msup><annotation encoding="application/x-tex">M^{\rm PSS}</annotation></semantics></math> from <math id="S4.SS3.SSS2.p1.m4" class="ltx_Math" alttext="T^{\rm Morse}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi>Morse</mi></msup><annotation encoding="application/x-tex">T^{\rm Morse}</annotation></semantics></math> to <math id="S4.SS3.SSS2.p1.m5" class="ltx_Math" alttext="T^{\rm Floer}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi>Floer</mi></msup><annotation encoding="application/x-tex">T^{\rm Floer}</annotation></semantics></math> and a flow bimodule <math id="S4.SS3.SSS2.p1.m6" class="ltx_Math" alttext="M^{\rm SSP}" display="inline" intent=":literal"><semantics><msup><mi>M</mi><mi>SSP</mi></msup><annotation encoding="application/x-tex">M^{\rm SSP}</annotation></semantics></math> from <math id="S4.SS3.SSS2.p1.m7" class="ltx_Math" alttext="T^{\rm Floer}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi>Floer</mi></msup><annotation encoding="application/x-tex">T^{\rm Floer}</annotation></semantics></math> to <math id="S4.SS3.SSS2.p1.m8" class="ltx_Math" alttext="T^{\rm Morse}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi>Morse</mi></msup><annotation encoding="application/x-tex">T^{\rm Morse}</annotation></semantics></math>. We explain the specific terms for the PSS bimodule; the SSP case is completely symmetric.</p>
</div>
<div id="S4.Thmthm6" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm6.2" class="ltx_text ltx_font_bold">Proposition 4.6</span></span><span id="S4.Thmthm6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm6.p1" class="ltx_para">
<p id="S4.Thmthm6.p1.1" class="ltx_p"><span id="S4.Thmthm6.p1.1.1" class="ltx_text ltx_font_italic">For <math id="S4.Thmthm6.p1.m1" class="ltx_Math" alttext="x\in{\mathcal{P}}^{{\rm Morse}}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Morse</mi></msup></mrow><annotation encoding="application/x-tex">x\in{\mathcal{P}}^{{\rm Morse}}</annotation></semantics></math> and <math id="S4.Thmthm6.p1.m2" class="ltx_Math" alttext="p\in{\mathcal{P}}^{\rm Floer}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Floer</mi></msup></mrow><annotation encoding="application/x-tex">p\in{\mathcal{P}}^{\rm Floer}</annotation></semantics></math>, define <math id="S4.Thmthm6.p1.m3" class="ltx_math_unparsed" alttext="M^{{\rm PSS}}_{xp}:=\overline{\mathcal{M}}{}_{xp}^{\rm PSS}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msup><mrow></mrow><mi>PSS</mi></msup><msub><mrow></mrow><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msub><mo>:=</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msub><msup><mrow></mrow><mi>PSS</mi></msup></mrow><annotation encoding="application/x-tex">M^{{\rm PSS}}_{xp}:=\overline{\mathcal{M}}{}_{xp}^{\rm PSS}</annotation></semantics></math>. Then together with the natural inclusion of the boundary strata</span></p>
<table id="S4.Ex42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex42.m1" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}^{{\rm Morse}}_{xy}\times\overline{\mathcal{M}}{}_{yp}^{\rm PSS}\to\overline{\mathcal{M}}{}_{xp}^{\rm PSS}," display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msup><mrow></mrow><mi>Morse</mi></msup><msub><mrow></mrow><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>y</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msub><msup><mrow></mrow><mi>PSS</mi></msup><mo stretchy="false">→</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msub><msup><mrow></mrow><mi>PSS</mi></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}^{{\rm Morse}}_{xy}\times\overline{\mathcal{M}}{}_{yp}^{\rm PSS}\to\overline{\mathcal{M}}{}_{xp}^{\rm PSS},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="S4.Ex43" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex43.m1" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{xq}^{\rm PSS}\times\overline{\mathcal{M}}{}_{qp}^{\rm Floer}\to\overline{\mathcal{M}}{}_{xp}^{\rm PSS}," display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><msup><mrow></mrow><mi>PSS</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msub><msup><mrow></mrow><mi>Floer</mi></msup><mo stretchy="false">→</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msub><msup><mrow></mrow><mi>PSS</mi></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{xq}^{\rm PSS}\times\overline{\mathcal{M}}{}_{qp}^{\rm Floer}\to\overline{\mathcal{M}}{}_{xp}^{\rm PSS},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm6.p1.2" class="ltx_p"><span id="S4.Thmthm6.p1.2.1" class="ltx_text ltx_font_italic">the spaces <math id="S4.Thmthm6.p1.m4" class="ltx_Math" alttext="M^{{\rm PSS}}_{xp}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mi>PSS</mi></msubsup><annotation encoding="application/x-tex">M^{{\rm PSS}}_{xp}</annotation></semantics></math> define a flow bimodule from <math id="S4.Thmthm6.p1.m5" class="ltx_Math" alttext="T^{\rm Morse}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi>Morse</mi></msup><annotation encoding="application/x-tex">T^{\rm Morse}</annotation></semantics></math> to <math id="S4.Thmthm6.p1.m6" class="ltx_Math" alttext="T^{\rm Floer}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi>Floer</mi></msup><annotation encoding="application/x-tex">T^{\rm Floer}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS3.SSS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS3.SSS2.p2" class="ltx_para">
<p id="S4.SS3.SSS2.p2.1" class="ltx_p"><span id="S4.SS3.SSS2.p2.1.1" class="ltx_text">For any <math id="S4.SS3.SSS2.p2.m1" class="ltx_Math" alttext="x\in{\mathcal{P}}^{{\rm Morse}}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Morse</mi></msup></mrow><annotation encoding="application/x-tex">x\in{\mathcal{P}}^{{\rm Morse}}</annotation></semantics></math> and <math id="S4.SS3.SSS2.p2.m2" class="ltx_Math" alttext="p\in{\mathcal{P}}^{\rm Morse}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Morse</mi></msup></mrow><annotation encoding="application/x-tex">p\in{\mathcal{P}}^{\rm Morse}</annotation></semantics></math> the moduli space <math id="S4.SS3.SSS2.p2.m3" class="ltx_Math" alttext="M^{{\rm PSS}}_{xp}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mi>PSS</mi></msubsup><annotation encoding="application/x-tex">M^{{\rm PSS}}_{xp}</annotation></semantics></math> is compact due to Gromov compactness and the bound on the topological energy. For such <math id="S4.SS3.SSS2.p2.m4" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> and <math id="S4.SS3.SSS2.p2.m5" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>, indeed the difference of energies <math id="S4.SS3.SSS2.p2.m6" class="ltx_Math" alttext="{\mathcal{A}}^{\rm Morse}(x)-{\mathcal{A}}^{\rm Floer}(p)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>Morse</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>Floer</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{A}}^{\rm Morse}(x)-{\mathcal{A}}^{\rm Floer}(p)</annotation></semantics></math> is uniformly bounded. The associaticity of inclusions of boundary strata follows from the construction, so is the strict <math id="S4.SS3.SSS2.p2.m7" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>-equivariance property.
∎</span></p>
</div>
</div>
<div id="S4.SS3.SSS2.p3" class="ltx_para">
<p id="S4.SS3.SSS2.p3.1" class="ltx_p">We refer to such a bimodule as the <span id="S4.SS3.SSS2.p3.1.1" class="ltx_text ltx_font_bold">PSS bimodule</span>, and the version for the SSP spaces as <span id="S4.SS3.SSS2.p3.1.2" class="ltx_text ltx_font_bold">SSP bimodule</span>, denoted by <math id="S4.SS3.SSS2.p3.m1" class="ltx_Math" alttext="M^{\rm PSS}" display="inline" intent=":literal"><semantics><msup><mi>M</mi><mi>PSS</mi></msup><annotation encoding="application/x-tex">M^{\rm PSS}</annotation></semantics></math> and <math id="S4.SS3.SSS2.p3.m2" class="ltx_Math" alttext="M^{\rm SSP}" display="inline" intent=":literal"><semantics><msup><mi>M</mi><mi>SSP</mi></msup><annotation encoding="application/x-tex">M^{\rm SSP}</annotation></semantics></math> respectively.</p>
</div>
</section>
</section>
<section id="S4.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.4. </span>The pearly bimodule</h3>

<div id="S4.SS4.p1" class="ltx_para">
<p id="S4.SS4.p1.1" class="ltx_p">We consider the moduli space of (parametrized) <math id="S4.SS4.p1.m1" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math>-holomorphic maps <math id="S4.SS4.p1.m2" class="ltx_Math" alttext="u:\mathbb{CP}^{1}\to M" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow><mo stretchy="false">→</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">u:\mathbb{CP}^{1}\to M</annotation></semantics></math> with two marked points <math id="S4.SS4.p1.m3" class="ltx_Math" alttext="z_{-}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>z</mi><mo>−</mo></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">z_{-}=0</annotation></semantics></math> and <math id="S4.SS4.p1.m4" class="ltx_Math" alttext="z_{+}=\infty" display="inline" intent=":literal"><semantics><mrow><msub><mi>z</mi><mo>+</mo></msub><mo>=</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">z_{+}=\infty</annotation></semantics></math>. Given a homology class <math id="S4.SS4.p1.m5" class="ltx_Math" alttext="A\in H_{2}(M;{\mathbb{Z}})" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>∈</mo><mrow><msub><mi>H</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>ℤ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">A\in H_{2}(M;{\mathbb{Z}})</annotation></semantics></math>, let <math id="S4.SS4.p1.m6" class="ltx_math_unparsed" alttext="{\mathcal{M}}{}_{0,2}^{\rm pearl}(M,J;A)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>J</mi><mo>;</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mi>pearl</mi><mprescripts></mprescripts><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">{\mathcal{M}}{}_{0,2}^{\rm pearl}(M,J;A)</annotation></semantics></math> be the moduli space of (parametrized) <math id="S4.SS4.p1.m7" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math>-holomorphic maps representing the class <math id="S4.SS4.p1.m8" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> whose domains are smooth. It has a Gromov compactification <math id="S4.SS4.p1.m9" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{0,2}^{\rm pearl}(M,J;A)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>J</mi><mo>;</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mi>pearl</mi><mprescripts></mprescripts><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{0,2}^{\rm pearl}(M,J;A)</annotation></semantics></math>. Each element of this compactification is represented by a stable map whose domain has a distinguished component whose parametrization is fixed. Moreover, by intersecting with the unstable manifold of <math id="S4.SS4.p1.m10" class="ltx_Math" alttext="\underline{\smash{x}}\in{\rm crit}f" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo>∈</mo><mrow><mi>crit</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><annotation encoding="application/x-tex">\underline{\smash{x}}\in{\rm crit}f</annotation></semantics></math> at <math id="S4.SS4.p1.m11" class="ltx_Math" alttext="z_{-}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mo>−</mo></msub><annotation encoding="application/x-tex">z_{-}</annotation></semantics></math> and with the stable manifold of <math id="S4.SS4.p1.m12" class="ltx_Math" alttext="\underline{\smash{y}}\in{\rm crit}f" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>y</mi><mo stretchy="true">¯</mo></munder><mo>∈</mo><mrow><mi>crit</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><annotation encoding="application/x-tex">\underline{\smash{y}}\in{\rm crit}f</annotation></semantics></math> at <math id="S4.SS4.p1.m13" class="ltx_Math" alttext="z_{+}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mo>+</mo></msub><annotation encoding="application/x-tex">z_{+}</annotation></semantics></math>, we have a moduli space</p>
<table id="S4.Ex44" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex44.m1" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{\underline{\smash{x}}\underline{\smash{y}}}^{\rm pearl}(M,J;A)" display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>J</mi><mo>;</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mi>pearl</mi><mprescripts></mprescripts><mrow><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>y</mi><mo stretchy="true">¯</mo></munder></mrow><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{\underline{\smash{x}}\underline{\smash{y}}}^{\rm pearl}(M,J;A)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p1.2" class="ltx_p">For <math id="S4.SS4.p1.m14" class="ltx_Math" alttext="a\in\Pi" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow><annotation encoding="application/x-tex">a\in\Pi</annotation></semantics></math>, define</p>
<table id="S4.Ex45" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex45.m1" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{\underline{\smash{x}}\underline{\smash{y}}}^{\rm pearl}(a):=\bigcup_{\omega(A)=\omega(a)}\overline{\mathcal{M}}{}_{\underline{\smash{x}}\underline{\smash{y}}}^{\rm pearl}(M,J;A)." display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mi>pearl</mi><mprescripts></mprescripts><mrow><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>y</mi><mo stretchy="true">¯</mo></munder></mrow><mrow></mrow></mmultiscripts><mo rspace="0.111em">:=</mo><munder><mo movablelimits="false">⋃</mo><mrow><mrow><mi>ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>J</mi><mo>;</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mi>pearl</mi><mprescripts></mprescripts><mrow><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>y</mi><mo stretchy="true">¯</mo></munder></mrow><mrow></mrow></mmultiscripts><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{\underline{\smash{x}}\underline{\smash{y}}}^{\rm pearl}(a):=\bigcup_{\omega(A)=\omega(a)}\overline{\mathcal{M}}{}_{\underline{\smash{x}}\underline{\smash{y}}}^{\rm pearl}(M,J;A).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p1.3" class="ltx_p">Then given <math id="S4.SS4.p1.m15" class="ltx_Math" alttext="x,y\in{\mathcal{P}}^{\rm Morse}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Morse</mi></msup></mrow><annotation encoding="application/x-tex">x,y\in{\mathcal{P}}^{\rm Morse}</annotation></semantics></math> which can be written as <math id="S4.SS4.p1.m16" class="ltx_Math" alttext="(a,\underline{\smash{x}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a,\underline{\smash{x}})</annotation></semantics></math> and <math id="S4.SS4.p1.m17" class="ltx_Math" alttext="(b,\underline{\smash{y}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>,</mo><munder accentunder="true"><mi>y</mi><mo stretchy="true">¯</mo></munder><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(b,\underline{\smash{y}})</annotation></semantics></math> where <math id="S4.SS4.p1.m18" class="ltx_Math" alttext="a,b\in\Pi" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow><annotation encoding="application/x-tex">a,b\in\Pi</annotation></semantics></math> and <math id="S4.SS4.p1.m19" class="ltx_Math" alttext="\underline{\smash{x}},\underline{\smash{y}}\in{\rm crit}f" display="inline" intent=":literal"><semantics><mrow><mrow><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo>,</mo><munder accentunder="true"><mi>y</mi><mo stretchy="true">¯</mo></munder></mrow><mo>∈</mo><mrow><mi>crit</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></mrow><annotation encoding="application/x-tex">\underline{\smash{x}},\underline{\smash{y}}\in{\rm crit}f</annotation></semantics></math>, define</p>
<table id="S4.Ex46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex46.m1" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{xy}^{\rm pearl}:=\overline{\mathcal{M}}{}_{\underline{\smash{x}}\underline{\smash{y}}}^{\rm pearl}(b-a)." display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mo>:=</mo><mrow></mrow><mi>pearl</mi><mprescripts></mprescripts><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mrow></mrow></mmultiscripts><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>−</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mi>pearl</mi><mprescripts></mprescripts><mrow><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>y</mi><mo stretchy="true">¯</mo></munder></mrow><mrow></mrow></mmultiscripts><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{xy}^{\rm pearl}:=\overline{\mathcal{M}}{}_{\underline{\smash{x}}\underline{\smash{y}}}^{\rm pearl}(b-a).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.SS4.p2" class="ltx_para">
<p id="S4.SS4.p2.1" class="ltx_p">The pearly moduli spaces are stratified by configurations which have broken Morse trajectories either on the incoming edge or on the out-going edge. Indeed, for <math id="S4.SS4.p2.m1" class="ltx_Math" alttext="{\mathcal{P}}={\mathcal{P}}^{\prime}={\mathcal{P}}^{\rm Morse}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>=</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup><mo>=</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Morse</mi></msup></mrow><annotation encoding="application/x-tex">{\mathcal{P}}={\mathcal{P}}^{\prime}={\mathcal{P}}^{\rm Morse}</annotation></semantics></math>, as in Notation <a href="#S3.Thmthm6" title="Notation 3.6. ‣ 3.2. Topological flow categories and bimodules ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.6</span></a> there is a system of homogeneous posets indexed by pairs of <math id="S4.SS4.p2.m2" class="ltx_Math" alttext="x,y\in{\mathcal{P}}^{\rm Morse}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Morse</mi></msup></mrow><annotation encoding="application/x-tex">x,y\in{\mathcal{P}}^{\rm Morse}</annotation></semantics></math>. More explicitly, given <math id="S4.SS4.p2.m3" class="ltx_Math" alttext="x,y\in{\mathcal{P}}^{\rm Morse}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Morse</mi></msup></mrow><annotation encoding="application/x-tex">x,y\in{\mathcal{P}}^{\rm Morse}</annotation></semantics></math>, define</p>
<table id="S4.Ex47" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex47.m1" class="ltx_math_unparsed" alttext="{\mathbb{A}}_{xy}^{\rm pearl}:=\left\{xx_{1}\cdots x_{k}y_{l}\cdots y_{1}y\ \left|\ \begin{array}[]{c}x_{i}=(a,\underline{\smash{x}}_{i}),\ y_{j}=(b,\underline{\smash{y}}_{j}),\\
\underline{\smash{x}}&lt;\underline{\smash{x}}_{1}&lt;\cdots&lt;\underline{\smash{x}}_{k},\ \underline{\smash{y}}_{l}&lt;\cdots&lt;\underline{\smash{y}}_{1}&lt;\underline{\smash{y}}\end{array}\right.\right\}." display="block" intent=":literal"><semantics><mrow><msubsup><mi>𝔸</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>pearl</mi></msubsup><mo>:=</mo><mrow><mo>{</mo><mi>x</mi><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>x</mi><mi>k</mi></msub><msub><mi>y</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>y</mi><mn>1</mn></msub><mi>y</mi><mo fence="false" lspace="0.500em" rspace="0.667em">|</mo><mtable displaystyle="true" rowspacing="2.0pt"><mtr><mtd><mrow><mi>x</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo rspace="0.667em">,</mo><mi>y</mi><msub><mrow></mrow><mi>j</mi></msub><mo>=</mo><mo stretchy="false">(</mo><mi>b</mi><mo>,</mo><munder accentunder="true"><mi>y</mi><mo stretchy="true">¯</mo></munder><msub><mrow></mrow><mi>j</mi></msub><mo stretchy="false">)</mo><mo>,</mo></mrow></mtd></mtr><mtr><mtd><mrow><mrow><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo>&lt;</mo><msub><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mn>1</mn></msub><mo rspace="0.1389em">&lt;</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">&lt;</mo><msub><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mi>k</mi></msub></mrow><mo rspace="0.667em">,</mo><mrow><msub><munder accentunder="true"><mi>y</mi><mo stretchy="true">¯</mo></munder><mi>l</mi></msub><mo rspace="0.1389em">&lt;</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">&lt;</mo><msub><munder accentunder="true"><mi>y</mi><mo stretchy="true">¯</mo></munder><mn>1</mn></msub><mo>&lt;</mo><munder accentunder="true"><mi>y</mi><mo stretchy="true">¯</mo></munder></mrow></mrow></mtd></mtr></mtable><mo>}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathbb{A}}_{xy}^{\rm pearl}:=\left\{xx_{1}\cdots x_{k}y_{l}\cdots y_{1}y\ \left|\ \begin{array}[]{c}x_{i}=(a,\underline{\smash{x}}_{i}),\ y_{j}=(b,\underline{\smash{y}}_{j}),\\
\underline{\smash{x}}&lt;\underline{\smash{x}}_{1}&lt;\cdots&lt;\underline{\smash{x}}_{k},\ \underline{\smash{y}}_{l}&lt;\cdots&lt;\underline{\smash{y}}_{1}&lt;\underline{\smash{y}}\end{array}\right.\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p2.2" class="ltx_p">Note that all the <math id="S4.SS4.p2.m4" class="ltx_Math" alttext="x_{i}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>i</mi></msub><annotation encoding="application/x-tex">x_{i}</annotation></semantics></math>’s resp. <math id="S4.SS4.p2.m5" class="ltx_Math" alttext="y_{j}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>j</mi></msub><annotation encoding="application/x-tex">y_{j}</annotation></semantics></math>’s are marked with the same class <math id="S4.SS4.p2.m6" class="ltx_Math" alttext="a\in\Pi" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow><annotation encoding="application/x-tex">a\in\Pi</annotation></semantics></math> resp. <math id="S4.SS4.p2.m7" class="ltx_Math" alttext="b\in\Pi" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow><annotation encoding="application/x-tex">b\in\Pi</annotation></semantics></math>, because otherwise, the morphism space <math id="S4.SS4.p2.m8" class="ltx_Math" alttext="T^{\rm Morse}_{x_{i}x_{i+1}}" display="inline" intent=":literal"><semantics><msubsup><mi>T</mi><mrow><msub><mi>x</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mi>Morse</mi></msubsup><annotation encoding="application/x-tex">T^{\rm Morse}_{x_{i}x_{i+1}}</annotation></semantics></math> or <math id="S4.SS4.p2.m9" class="ltx_Math" alttext="T^{\rm Morse}_{y_{j}y_{j+1}}" display="inline" intent=":literal"><semantics><msubsup><mi>T</mi><mrow><msub><mi>y</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mi>Morse</mi></msubsup><annotation encoding="application/x-tex">T^{\rm Morse}_{y_{j}y_{j+1}}</annotation></semantics></math> is empty by the construction in Section <a href="#S4.SS2" title="4.2. Morse flow category ‣ 4. Proof of the integral Arnold conjecture ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>. Given <math id="S4.SS4.p2.m10" class="ltx_math_unparsed" alttext="\alpha=xx_{1}\cdots x_{k}y_{l}\cdots y_{1}y\in{\mathbb{A}}_{xy}^{\rm pearl}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mi>x</mi><mi>x</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>x</mi><msub><mrow></mrow><mi>k</mi></msub><mi>y</mi><msub><mrow></mrow><mi>l</mi></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>y</mi><msub><mrow></mrow><mn>1</mn></msub><mi>y</mi><mo>∈</mo><mi>𝔸</mi><msub><mrow></mrow><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub><msup><mrow></mrow><mi>pearl</mi></msup></mrow><annotation encoding="application/x-tex">\alpha=xx_{1}\cdots x_{k}y_{l}\cdots y_{1}y\in{\mathbb{A}}_{xy}^{\rm pearl}</annotation></semantics></math>, the corresponding stratum in the pearly moduli space is</p>
<table id="S4.Ex48" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex48.m1" class="ltx_math_unparsed" alttext="\Big(\overline{\mathcal{M}}{}_{xy}^{\rm pearl}\Big)_{\alpha}\cong\overline{\mathcal{M}}{}_{xx_{1}}^{\rm Morse}\times\cdots\times\overline{\mathcal{M}}{}_{x_{k-1}x_{k}}^{\rm Morse}\times\overline{\mathcal{M}}{}_{x_{k}y_{l}}^{\rm pearl}\times\overline{\mathcal{M}}_{y_{l}y_{l-1}}^{\rm Morse}\times\cdots\times\overline{\mathcal{M}}{}_{y_{1}y}^{\rm Morse}." display="block" intent=":literal"><semantics><mrow><msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mo maxsize="1.600em" minsize="1.600em">)</mo><mrow></mrow><mi>pearl</mi><mprescripts></mprescripts><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mrow></mrow></mmultiscripts></mrow><mi>α</mi></msub><mo>≅</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mo lspace="0.222em">×</mo><mrow></mrow><mi>Morse</mi><mprescripts></mprescripts><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub></mrow><mrow></mrow></mmultiscripts><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mo lspace="0.222em" rspace="0.222em">×</mo><mrow></mrow><mi>Morse</mi><mprescripts></mprescripts><mrow><msub><mi>x</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>k</mi></msub></mrow><mrow></mrow></mmultiscripts><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mo lspace="0.222em" rspace="0.222em">×</mo><mrow></mrow><mi>pearl</mi><mprescripts></mprescripts><mrow><msub><mi>x</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>l</mi></msub></mrow><mrow></mrow></mmultiscripts><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><msub><mi>y</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mi>Morse</mi></msubsup><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mo lspace="0em">.</mo><mrow></mrow><mi>Morse</mi><mprescripts></mprescripts><mrow><msub><mi>y</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">\Big(\overline{\mathcal{M}}{}_{xy}^{\rm pearl}\Big)_{\alpha}\cong\overline{\mathcal{M}}{}_{xx_{1}}^{\rm Morse}\times\cdots\times\overline{\mathcal{M}}{}_{x_{k-1}x_{k}}^{\rm Morse}\times\overline{\mathcal{M}}{}_{x_{k}y_{l}}^{\rm pearl}\times\overline{\mathcal{M}}_{y_{l}y_{l-1}}^{\rm Morse}\times\cdots\times\overline{\mathcal{M}}{}_{y_{1}y}^{\rm Morse}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p2.3" class="ltx_p">There are again only finitely many nonempty strata, thanks to Gromov compactness. Using the formulation of flow bimodules, we can see that the collection of pearly moduli spaces and the product structures of various strata provide a flow bimodule from <math id="S4.SS4.p2.m11" class="ltx_Math" alttext="T^{\rm Morse}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi>Morse</mi></msup><annotation encoding="application/x-tex">T^{\rm Morse}</annotation></semantics></math> to <math id="S4.SS4.p2.m12" class="ltx_Math" alttext="T^{\rm Morse}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi>Morse</mi></msup><annotation encoding="application/x-tex">T^{\rm Morse}</annotation></semantics></math>, which we call the <span id="S4.SS4.p2.3.1" class="ltx_text ltx_font_bold">pearly bimodule</span> and denote it by <math id="S4.SS4.p2.m13" class="ltx_Math" alttext="M^{\rm pearl}" display="inline" intent=":literal"><semantics><msup><mi>M</mi><mi>pearl</mi></msup><annotation encoding="application/x-tex">M^{\rm pearl}</annotation></semantics></math>. The strict <math id="S4.SS4.p2.m14" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>-action on <math id="S4.SS4.p2.m15" class="ltx_Math" alttext="M^{\rm pearl}" display="inline" intent=":literal"><semantics><msup><mi>M</mi><mi>pearl</mi></msup><annotation encoding="application/x-tex">M^{\rm pearl}</annotation></semantics></math> follows from the construction. The outer-collaring (of width 1) of <math id="S4.SS4.p2.m16" class="ltx_Math" alttext="M^{\rm pearl}" display="inline" intent=":literal"><semantics><msup><mi>M</mi><mi>pearl</mi></msup><annotation encoding="application/x-tex">M^{\rm pearl}</annotation></semantics></math> provides a bimodule <math id="S4.SS4.p2.m17" class="ltx_Math" alttext="(M^{\rm pearl})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msup><mi>M</mi><mi>pearl</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(M^{\rm pearl})^{+}</annotation></semantics></math> from <math id="S4.SS4.p2.m18" class="ltx_Math" alttext="(T^{\rm Morse})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mi>Morse</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(T^{\rm Morse})^{+}</annotation></semantics></math> to <math id="S4.SS4.p2.m19" class="ltx_Math" alttext="(T^{\rm Morse})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mi>Morse</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(T^{\rm Morse})^{+}</annotation></semantics></math>.</p>
</div>
</section>
<section id="S4.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.5. </span>Main Theorems</h3>

<div id="S4.SS5.p1" class="ltx_para">
<p id="S4.SS5.p1.1" class="ltx_p">Using the notations introduced above, we can state the output of Sections <a href="#S5" title="5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>, <a href="#S6" title="6. Smoothing ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>, and <a href="#S7" title="7. Constructions for PSS, SSP, and the homotopy ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>.</p>
</div>
<div id="S4.Thmthm7" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm7.2" class="ltx_text ltx_font_bold">Theorem 4.7</span></span><span id="S4.Thmthm7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm7.p1" class="ltx_para">
<p id="S4.Thmthm7.p1.1" class="ltx_p"><span id="S4.Thmthm7.p1.1.1" class="ltx_text ltx_font_italic">Denote by <math id="S4.Thmthm7.p1.m1" class="ltx_Math" alttext="(T^{\rm Floer})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mi>Floer</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(T^{\rm Floer})^{+}</annotation></semantics></math> the outer-collaring (see Section <a href="#S3.SS3.SSS2" title="3.3.2. Outer-collaring of flow categories and bimodules ‣ 3.3. Outer-collaring ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3.2</span></a>) of the Hamiltonian Floer flow category <math id="S4.Thmthm7.p1.m2" class="ltx_Math" alttext="T^{\rm Floer}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi>Floer</mi></msup><annotation encoding="application/x-tex">T^{\rm Floer}</annotation></semantics></math>. Then <math id="S4.Thmthm7.p1.m3" class="ltx_Math" alttext="(T^{\rm Floer})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mi>Floer</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(T^{\rm Floer})^{+}</annotation></semantics></math> admits a derived orbifold lift (Definition <a href="#S3.Thmthm24" title="Definition 3.24. ‣ 3.4.4. Derived orbifold lifts of flow categories and bimodules ‣ 3.4. Derived orbifold charts with stratifications ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.24</span></a>)</span></p>
<table id="S4.Ex49" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex49.m1" class="ltx_math_unparsed" alttext="{\mathfrak{D}}^{\rm Floer}=\Big(\big\{C^{\rm Floer}_{pq}=({\mathcal{U}}^{\rm Floer}_{pq},{\mathcal{E}}^{\rm Floer}_{pq},{\mathcal{S}}^{\rm Floer}_{pq},\psi^{\rm Floer}_{pq})\big\}_{p&lt;q},\big\{{\bm{\iota}}_{\beta\alpha}^{\rm Floer}\big\}_{\alpha\leq\beta}\Big)," display="block" intent=":literal"><semantics><mrow><msup><mi>𝔇</mi><mi>Floer</mi></msup><mo>=</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msub><mrow><mo stretchy="false">{</mo><msubsup><mi>C</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>Floer</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>Floer</mi></msubsup><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>Floer</mi></msubsup><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>Floer</mi></msubsup><mo>,</mo><msubsup><mi>ψ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>Floer</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>p</mi><mo>&lt;</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mrow><mo stretchy="false">{</mo><msubsup><mi>𝜾</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mi>Floer</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow></msub><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm Floer}=\Big(\big\{C^{\rm Floer}_{pq}=({\mathcal{U}}^{\rm Floer}_{pq},{\mathcal{E}}^{\rm Floer}_{pq},{\mathcal{S}}^{\rm Floer}_{pq},\psi^{\rm Floer}_{pq})\big\}_{p&lt;q},\big\{{\bm{\iota}}_{\beta\alpha}^{\rm Floer}\big\}_{\alpha\leq\beta}\Big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm7.p1.2" class="ltx_p"><span id="S4.Thmthm7.p1.2.1" class="ltx_text ltx_font_italic">with a collar structure (Definition <a href="#S3.Thmthm26" title="Definition 3.26. ‣ 3.5.1. Collar structure ‣ 3.5. Additional structures ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.26</span></a>)</span></p>
<table id="S4.Ex50" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex50.m1" class="ltx_Math" alttext="\{\widehat{\theta}_{\beta\alpha}^{{\rm collar},{\rm Floer}}\}_{\alpha\leq\beta}," display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mrow><mi>collar</mi><mo>,</mo><mi>Floer</mi></mrow></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">\{\widehat{\theta}_{\beta\alpha}^{{\rm collar},{\rm Floer}}\}_{\alpha\leq\beta},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm7.p1.3" class="ltx_p"><span id="S4.Thmthm7.p1.3.1" class="ltx_text ltx_font_italic">and a scaffolding (Definition <a href="#S3.Thmthm28" title="Definition 3.28. ‣ 3.5.2. Scaffolding ‣ 3.5. Additional structures ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.28</span></a>)</span></p>
<table id="S4.Ex51" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex51.m1" class="ltx_Math" alttext="\big({\mathcal{F}}_{\beta\alpha}^{\rm Floer},{\bm{\theta}}_{\beta\alpha}^{\rm Floer}\big)_{\alpha\leq\beta}" display="block" intent=":literal"><semantics><msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mi>Floer</mi></msubsup><mo>,</mo><msubsup><mi>𝜽</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mi>Floer</mi></msubsup><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow></msub><annotation encoding="application/x-tex">\big({\mathcal{F}}_{\beta\alpha}^{\rm Floer},{\bm{\theta}}_{\beta\alpha}^{\rm Floer}\big)_{\alpha\leq\beta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm7.p1.4" class="ltx_p"><span id="S4.Thmthm7.p1.4.1" class="ltx_text ltx_font_italic">such that they are compatible (Definition <a href="#S3.Thmthm34" title="Definition 3.34. ‣ 3.5.4. Compatibility ‣ 3.5. Additional structures ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.34</span></a>). Moreover, such a lift can be upgraded to an oriented and normally complex derived orbifold lift (Definition <a href="#S3.Thmthm44" title="Definition 3.44. ‣ 3.6. Normal complex structure and orientations on flow categories ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.44</span></a>). Further, one can equip the D-chart lift a straightening which is compatible with the collar and scaffoldings.</span></p>
</div>
</div>
<div id="S4.SS5.p2" class="ltx_para">
<p id="S4.SS5.p2.1" class="ltx_p">The proof is completed in Theorem <a href="#S6.Thmthm31" title="Theorem 6.31. ‣ 6.3. The main theorem about smoothing ‣ 6. Smoothing ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.31</span></a>.</p>
</div>
<div id="S4.SS5.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Theorem <a href="#Thmthma2" title="Theorem B. ‣ 1.1. Proof strategy ‣ 1. Introduction ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B</span></a>.</h6>
<div id="S4.SS5.p3" class="ltx_para">
<p id="S4.SS5.p3.1" class="ltx_p"><span id="S4.SS5.p3.1.1" class="ltx_text">From Theorem <a href="#S4.Thmthm7" title="Theorem 4.7. ‣ 4.5. Main Theorems ‣ 4. Proof of the integral Arnold conjecture ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.7</span></a>
this is a corollary of Theorem <a href="#S3.Thmthm49" title="Theorem 3.49. ‣ 3.7. Constructing FOP perturbations ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.49</span></a> and the discussion in Section <a href="#S3.SS8.SSS1" title="3.8.1. The chain complexes ‣ 3.8. Chain complexes and maps over the integers ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.8.1</span></a>.
∎</span></p>
</div>
</div>
<div id="S4.Thmthm8" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm8.2" class="ltx_text ltx_font_bold">Theorem 4.8</span></span><span id="S4.Thmthm8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm8.p1" class="ltx_para">
<p id="S4.Thmthm8.p1.1" class="ltx_p"><span id="S4.Thmthm8.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmthm8.p1.m1" class="ltx_Math" alttext="(M^{\rm PSS})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msup><mi>M</mi><mi>PSS</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(M^{\rm PSS})^{+}</annotation></semantics></math> be the outer-collaring of the flow bimodule <math id="S4.Thmthm8.p1.m2" class="ltx_Math" alttext="M^{\rm PSS}" display="inline" intent=":literal"><semantics><msup><mi>M</mi><mi>PSS</mi></msup><annotation encoding="application/x-tex">M^{\rm PSS}</annotation></semantics></math> from <math id="S4.Thmthm8.p1.m3" class="ltx_Math" alttext="(T^{\rm Morse})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mi>Morse</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(T^{\rm Morse})^{+}</annotation></semantics></math> to <math id="S4.Thmthm8.p1.m4" class="ltx_Math" alttext="(T^{\rm Floer})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mi>Floer</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(T^{\rm Floer})^{+}</annotation></semantics></math>. Then <math id="S4.Thmthm8.p1.m5" class="ltx_Math" alttext="(M^{\rm PSS})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msup><mi>M</mi><mi>PSS</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(M^{\rm PSS})^{+}</annotation></semantics></math> has an oriented and normally complex derived orbifold lift</span></p>
<table id="S4.Ex52" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex52.m1" class="ltx_math_unparsed" alttext="{\mathfrak{D}}^{\rm PSS}=\Big(\big\{C^{\rm PSS}_{xp}=({\mathcal{U}}^{\rm PSS}_{xp},{\mathcal{E}}^{\rm PSS}_{xp},{\mathcal{S}}^{\rm PSS}_{xp},\psi^{\rm PSS}_{xp})\big\}_{x,p},\big\{{\bm{\iota}}_{\beta\alpha}^{\rm PSS}\big\}_{\alpha\leq\beta}\Big)," display="block" intent=":literal"><semantics><mrow><msup><mi>𝔇</mi><mi>PSS</mi></msup><mo>=</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msub><mrow><mo stretchy="false">{</mo><msubsup><mi>C</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mi>PSS</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mi>PSS</mi></msubsup><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mi>PSS</mi></msubsup><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mi>PSS</mi></msubsup><mo>,</mo><msubsup><mi>ψ</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mi>PSS</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>x</mi><mo>,</mo><mi>p</mi></mrow></msub><mo>,</mo><msub><mrow><mo stretchy="false">{</mo><msubsup><mi>𝜾</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mi>PSS</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow></msub><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm PSS}=\Big(\big\{C^{\rm PSS}_{xp}=({\mathcal{U}}^{\rm PSS}_{xp},{\mathcal{E}}^{\rm PSS}_{xp},{\mathcal{S}}^{\rm PSS}_{xp},\psi^{\rm PSS}_{xp})\big\}_{x,p},\big\{{\bm{\iota}}_{\beta\alpha}^{\rm PSS}\big\}_{\alpha\leq\beta}\Big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm8.p1.2" class="ltx_p"><span id="S4.Thmthm8.p1.2.1" class="ltx_text ltx_font_italic">with a collar structure</span></p>
<table id="S4.Ex53" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex53.m1" class="ltx_Math" alttext="\{\widehat{\theta}_{\beta\alpha}^{{\rm collar},{\rm PSS}}\}_{\alpha\leq\beta}," display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mrow><mi>collar</mi><mo>,</mo><mi>PSS</mi></mrow></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">\{\widehat{\theta}_{\beta\alpha}^{{\rm collar},{\rm PSS}}\}_{\alpha\leq\beta},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm8.p1.3" class="ltx_p"><span id="S4.Thmthm8.p1.3.1" class="ltx_text ltx_font_italic">and a scaffolding (Definition <a href="#S3.Thmthm28" title="Definition 3.28. ‣ 3.5.2. Scaffolding ‣ 3.5. Additional structures ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.28</span></a>)</span></p>
<table id="S4.Ex54" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex54.m1" class="ltx_Math" alttext="\big({\mathcal{F}}_{\beta\alpha}^{\rm PSS},{\bm{\theta}}_{\beta\alpha}^{\rm PSS}\big)_{\alpha\leq\beta}" display="block" intent=":literal"><semantics><msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mi>PSS</mi></msubsup><mo>,</mo><msubsup><mi>𝜽</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mi>PSS</mi></msubsup><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow></msub><annotation encoding="application/x-tex">\big({\mathcal{F}}_{\beta\alpha}^{\rm PSS},{\bm{\theta}}_{\beta\alpha}^{\rm PSS}\big)_{\alpha\leq\beta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm8.p1.4" class="ltx_p"><span id="S4.Thmthm8.p1.4.1" class="ltx_text ltx_font_italic">such that they are compatible, and they extend the given structures on <math id="S4.Thmthm8.p1.m6" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm Floer}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>Floer</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm Floer}</annotation></semantics></math> and <math id="S4.Thmthm8.p1.m7" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm Morse}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>Morse</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm Morse}</annotation></semantics></math>. The same statement holds by reversing the role of <math id="S4.Thmthm8.p1.m8" class="ltx_Math" alttext="(T^{\rm Floer})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mi>Floer</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(T^{\rm Floer})^{+}</annotation></semantics></math> to <math id="S4.Thmthm8.p1.m9" class="ltx_Math" alttext="(T^{\rm Morse})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mi>Morse</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(T^{\rm Morse})^{+}</annotation></semantics></math> and replace <math id="S4.Thmthm8.p1.m10" class="ltx_Math" alttext="{\rm PSS}" display="inline" intent=":literal"><semantics><mi>PSS</mi><annotation encoding="application/x-tex">{\rm PSS}</annotation></semantics></math> by <math id="S4.Thmthm8.p1.m11" class="ltx_Math" alttext="{\rm SSP}" display="inline" intent=":literal"><semantics><mi>SSP</mi><annotation encoding="application/x-tex">{\rm SSP}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS5.p4" class="ltx_para">
<p id="S4.SS5.p4.1" class="ltx_p">The proof is provided in Section <a href="#S7" title="7. Constructions for PSS, SSP, and the homotopy ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>. The following assertion is proved similarly as the arguments in Section <a href="#S6.SS3.SSS1" title="6.3.1. Constructing straightening ‣ 6.3. The main theorem about smoothing ‣ 6. Smoothing ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.3.1</span></a>.</p>
</div>
<div id="S4.Thmthm9" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm9.2" class="ltx_text ltx_font_bold">Lemma 4.9</span></span><span id="S4.Thmthm9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm9.p1" class="ltx_para">
<p id="S4.Thmthm9.p1.1" class="ltx_p"><span id="S4.Thmthm9.p1.1.1" class="ltx_text ltx_font_italic">Both <math id="S4.Thmthm9.p1.m1" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm PSS}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>PSS</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm PSS}</annotation></semantics></math> and <math id="S4.Thmthm9.p1.m2" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm SSP}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>SSP</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm SSP}</annotation></semantics></math> have a straightening extending the straightening on <math id="S4.Thmthm9.p1.m3" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm Floer}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>Floer</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm Floer}</annotation></semantics></math>, and they are compatible with the respective collar structure and scaffolding. ∎</span></p>
</div>
</div>
<div id="S4.SS5.p5" class="ltx_para">
<p id="S4.SS5.p5.1" class="ltx_p">As a consequence, Theorem <a href="#S3.Thmthm51" title="Theorem 3.51. ‣ 3.8.2. The chain maps ‣ 3.8. Chain complexes and maps over the integers ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.51</span></a> and the discussion in Section <a href="#S3.SS8.SSS1" title="3.8.1. The chain complexes ‣ 3.8. Chain complexes and maps over the integers ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.8.1</span></a> define the <math id="S4.SS5.p5.m1" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>-linear chain maps</p>
<table id="S4.Ex55" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex55.m1" class="ltx_Math" alttext="\Psi^{\rm PSS}:CM_{*}(f;\Lambda)\to CF_{*}(H;\Lambda)," display="block" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">Ψ</mi><mi>PSS</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\Psi^{\rm PSS}:CM_{*}(f;\Lambda)\to CF_{*}(H;\Lambda),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="S4.Ex56" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex56.m1" class="ltx_Math" alttext="\Psi^{\rm SSP}:CF_{*}(H;\Lambda)\to CM_{*}(f;\Lambda)." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">Ψ</mi><mi>SSP</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Psi^{\rm SSP}:CF_{*}(H;\Lambda)\to CM_{*}(f;\Lambda).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.Thmthm10" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm10.2" class="ltx_text ltx_font_bold">Theorem 4.10</span></span><span id="S4.Thmthm10.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm10.p1" class="ltx_para">
<p id="S4.Thmthm10.p1.1" class="ltx_p"><span id="S4.Thmthm10.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmthm10.p1.m1" class="ltx_Math" alttext="(M^{\rm pearl})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msup><mi>M</mi><mi>pearl</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(M^{\rm pearl})^{+}</annotation></semantics></math> be the flow bimodule from <math id="S4.Thmthm10.p1.m2" class="ltx_Math" alttext="(T^{\rm Morse})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mi>Morse</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(T^{\rm Morse})^{+}</annotation></semantics></math> to <math id="S4.Thmthm10.p1.m3" class="ltx_Math" alttext="(T^{\rm Morse})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mi>Morse</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(T^{\rm Morse})^{+}</annotation></semantics></math> obtained from the outer-collaring of the pearly bimodule <math id="S4.Thmthm10.p1.m4" class="ltx_Math" alttext="M^{\rm pearl}" display="inline" intent=":literal"><semantics><msup><mi>M</mi><mi>pearl</mi></msup><annotation encoding="application/x-tex">M^{\rm pearl}</annotation></semantics></math>. Then <math id="S4.Thmthm10.p1.m5" class="ltx_Math" alttext="(M^{\rm pearl})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msup><mi>M</mi><mi>pearl</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(M^{\rm pearl})^{+}</annotation></semantics></math> has an oriented and normally complex derived orbifold lift</span></p>
<table id="S4.Ex57" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex57.m1" class="ltx_math_unparsed" alttext="{\mathfrak{D}}^{\rm pearl}=\Big(\big\{C^{\rm pearl}_{xy}=({\mathcal{U}}^{\rm pearl}_{xy},{\mathcal{E}}^{\rm pearl}_{xy},{\mathcal{S}}^{\rm pearl}_{xy},\psi^{\rm pearl}_{xy})\big\}_{x,y},\big\{{\bm{\iota}}_{\beta\alpha}^{\rm pearl}\big\}_{\alpha\leq\beta}\Big)," display="block" intent=":literal"><semantics><mrow><msup><mi>𝔇</mi><mi>pearl</mi></msup><mo>=</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msub><mrow><mo stretchy="false">{</mo><msubsup><mi>C</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>pearl</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>pearl</mi></msubsup><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>pearl</mi></msubsup><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>pearl</mi></msubsup><mo>,</mo><msubsup><mi>ψ</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>pearl</mi></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow></msub><mo>,</mo><msub><mrow><mo stretchy="false">{</mo><msubsup><mi>𝜾</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mi>pearl</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow></msub><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm pearl}=\Big(\big\{C^{\rm pearl}_{xy}=({\mathcal{U}}^{\rm pearl}_{xy},{\mathcal{E}}^{\rm pearl}_{xy},{\mathcal{S}}^{\rm pearl}_{xy},\psi^{\rm pearl}_{xy})\big\}_{x,y},\big\{{\bm{\iota}}_{\beta\alpha}^{\rm pearl}\big\}_{\alpha\leq\beta}\Big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm10.p1.2" class="ltx_p"><span id="S4.Thmthm10.p1.2.1" class="ltx_text ltx_font_italic">with a collar structure</span></p>
<table id="S4.Ex58" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex58.m1" class="ltx_Math" alttext="\{\widehat{\theta}_{\beta\alpha}^{{\rm collar},{\rm pearl}}\}_{\alpha\leq\beta}," display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mrow><mi>collar</mi><mo>,</mo><mi>pearl</mi></mrow></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">\{\widehat{\theta}_{\beta\alpha}^{{\rm collar},{\rm pearl}}\}_{\alpha\leq\beta},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm10.p1.3" class="ltx_p"><span id="S4.Thmthm10.p1.3.1" class="ltx_text ltx_font_italic">such that the induced derived orbifold presentation on each <math id="S4.Thmthm10.p1.m6" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}^{\rm pearl}_{xy}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msup><mrow></mrow><mi>pearl</mi></msup><msub><mrow></mrow><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}^{\rm pearl}_{xy}</annotation></semantics></math> is single-layered (Definition <a href="#S3.Thmthm23" title="Definition 3.23. ‣ 3.4.3. Stratified smooth orbifolds with corners and derived orbifold charts ‣ 3.4. Derived orbifold charts with stratifications ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.23</span></a>), i.e., <math id="S4.Thmthm10.p1.m7" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm pearl}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>pearl</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm pearl}</annotation></semantics></math> has a trivial scaffolding. Moreover, the orientation structure, normally complex structure, and the collar structure extend the existing ones on <math id="S4.Thmthm10.p1.m8" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm Morse}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>Morse</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm Morse}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS5.p6" class="ltx_para">
<p id="S4.SS5.p6.1" class="ltx_p">The proof is provided in Section <a href="#S7" title="7. Constructions for PSS, SSP, and the homotopy ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>. By the argument in Section <a href="#S6.SS3.SSS1" title="6.3.1. Constructing straightening ‣ 6.3. The main theorem about smoothing ‣ 6. Smoothing ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.3.1</span></a> (but simpler because the scaffolding is absent in this case), we can find a straightening of <math id="S4.SS5.p6.m1" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm pearl}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>pearl</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm pearl}</annotation></semantics></math> which is compatible with the collar structure. We fix it once for all.</p>
</div>
<div id="S4.Thmthm11" class="ltx_theorem ltx_theorem_cor">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm11.2" class="ltx_text ltx_font_bold">Corollary 4.11</span></span><span id="S4.Thmthm11.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm11.p1" class="ltx_para">
<p id="S4.Thmthm11.p1.1" class="ltx_p"><span id="S4.Thmthm11.p1.1.1" class="ltx_text ltx_font_italic">The FOP countings associated to the oriented and normally complex derived orbifold lift <math id="S4.Thmthm11.p1.m1" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm pearl}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>pearl</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm pearl}</annotation></semantics></math> and the chosen straightening thereon defines a chain map</span></p>
<table id="S4.Ex59" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex59.m1" class="ltx_Math" alttext="\Psi^{\rm pearl}:CM_{*}(f;\Lambda)\to CM_{*}(f;\Lambda)" display="block" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Ψ</mi><mi>pearl</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Psi^{\rm pearl}:CM_{*}(f;\Lambda)\to CM_{*}(f;\Lambda)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm11.p1.2" class="ltx_p"><span id="S4.Thmthm11.p1.2.1" class="ltx_text ltx_font_italic">which is unitriangular, i.e.,</span></p>
<table id="S4.Ex60" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex60.m1" class="ltx_Math" alttext="\Psi^{\rm pearl}-{\rm Id}\in({\rm End}_{\Lambda}(CM_{*}(f;\Lambda)))_{+}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi mathvariant="normal">Ψ</mi><mi>pearl</mi></msup><mo>−</mo><mi>Id</mi></mrow><mo>∈</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>End</mi><mi mathvariant="normal">Λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Psi^{\rm pearl}-{\rm Id}\in({\rm End}_{\Lambda}(CM_{*}(f;\Lambda)))_{+}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm11.p1.3" class="ltx_p"><span id="S4.Thmthm11.p1.3.1" class="ltx_text ltx_font_italic">In particular, the induced map on homology</span></p>
<table id="S4.Ex61" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex61.m1" class="ltx_Math" alttext="\Psi^{\rm pearl}:H_{*}(M;\Lambda)\to H_{*}(M;\Lambda)" display="block" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Ψ</mi><mi>pearl</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>H</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi>H</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Psi^{\rm pearl}:H_{*}(M;\Lambda)\to H_{*}(M;\Lambda)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm11.p1.4" class="ltx_p"><span id="S4.Thmthm11.p1.4.1" class="ltx_text ltx_font_italic">is invertible.</span></p>
</div>
</div>
<div id="S4.SS5.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS5.p7" class="ltx_para">
<p id="S4.SS5.p7.1" class="ltx_p"><span id="S4.SS5.p7.1.1" class="ltx_text">The construction of <math id="S4.SS5.p7.m1" class="ltx_Math" alttext="\Psi^{\rm pearl}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Ψ</mi><mi>pearl</mi></msup><annotation encoding="application/x-tex">\Psi^{\rm pearl}</annotation></semantics></math> follows from Theorem <a href="#S3.Thmthm51" title="Theorem 3.51. ‣ 3.8.2. The chain maps ‣ 3.8. Chain complexes and maps over the integers ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.51</span></a> and discussions in Section <a href="#S3.SS8" title="3.8. Chain complexes and maps over the integers ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.8</span></a>. To prove that <math id="S4.SS5.p7.m2" class="ltx_Math" alttext="\Psi^{\rm pearl}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Ψ</mi><mi>pearl</mi></msup><annotation encoding="application/x-tex">\Psi^{\rm pearl}</annotation></semantics></math> is unitriangular, observe that for a pair of capped orbits <math id="S4.SS5.p7.m3" class="ltx_Math" alttext="x=(\underline{\smash{x}},a)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">x=(\underline{\smash{x}},a)</annotation></semantics></math> and <math id="S4.SS5.p7.m4" class="ltx_Math" alttext="y=(\underline{\smash{y}},b)" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><munder accentunder="true"><mi>y</mi><mo stretchy="true">¯</mo></munder><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">y=(\underline{\smash{y}},b)</annotation></semantics></math>, the moduli space <math id="S4.SS5.p7.m5" class="ltx_Math" alttext="\overline{\mathcal{M}}^{\rm pearl}_{xy}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>pearl</mi></msubsup><annotation encoding="application/x-tex">\overline{\mathcal{M}}^{\rm pearl}_{xy}</annotation></semantics></math> is nonempty only if <math id="S4.SS5.p7.m6" class="ltx_Math" alttext="\omega(b-a)\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo>−</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\omega(b-a)\geq 0</annotation></semantics></math>. Moreover, when <math id="S4.SS5.p7.m7" class="ltx_Math" alttext="\omega(b-a)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo>−</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\omega(b-a)=0</annotation></semantics></math>, the only nonempty moduli space contributing to the counting in <math id="S4.SS5.p7.m8" class="ltx_Math" alttext="\Psi^{\rm pearl}(x)" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Ψ</mi><mi>pearl</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Psi^{\rm pearl}(x)</annotation></semantics></math> is the moduli space of parametrized gradient flow lines from <math id="S4.SS5.p7.m9" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> to itself, which is a single point. It implies that the incidence coefficient <math id="S4.SS5.p7.m10" class="ltx_Math" alttext="n^{\rm pearl}_{xx}=1" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>n</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mi>pearl</mi></msubsup><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n^{\rm pearl}_{xx}=1</annotation></semantics></math>. As a consequence, the statement is proved.
∎</span></p>
</div>
</div>
</section>
<section id="S4.SS6" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.6. </span>The homotopy</h3>

<div id="S4.SS6.p1" class="ltx_para">
<p id="S4.SS6.p1.1" class="ltx_p">In this subsection, we describe how to interpolate between the chain maps <math id="S4.SS6.p1.m1" class="ltx_Math" alttext="\Psi^{\rm SSP}\circ\Psi^{\rm PSS}" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Ψ</mi><mi>SSP</mi></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi mathvariant="normal">Ψ</mi><mi>PSS</mi></msup></mrow><annotation encoding="application/x-tex">\Psi^{\rm SSP}\circ\Psi^{\rm PSS}</annotation></semantics></math> and <math id="S4.SS6.p1.m2" class="ltx_Math" alttext="\Psi^{\rm pearl}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Ψ</mi><mi>pearl</mi></msup><annotation encoding="application/x-tex">\Psi^{\rm pearl}</annotation></semantics></math> and prove Theorem <a href="#Thmthma3" title="Theorem C. ‣ 1.1. Proof strategy ‣ 1. Introduction ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C</span></a>.</p>
</div>
<div id="S4.SS6.p2" class="ltx_para">
<p id="S4.SS6.p2.1" class="ltx_p">We choose a 3-parameter family of Hamiltonians parametrized by <math id="S4.SS6.p2.m1" class="ltx_Math" alttext="t\in S^{1}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><msup><mi>S</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">t\in S^{1}</annotation></semantics></math>, <math id="S4.SS6.p2.m2" class="ltx_Math" alttext="s\in{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">s\in{\mathbb{R}}</annotation></semantics></math>, and <math id="S4.SS6.p2.m3" class="ltx_math_unparsed" alttext="\tau\in(-1,1]" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\tau\in(-1,1]</annotation></semantics></math> which satisfy the following conditions.</p>
<ol id="S4.I4" class="ltx_enumerate">
<li id="S4.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I4.i1.p1" class="ltx_para">
<p id="S4.I4.i1.p1.1" class="ltx_p">For each <math id="S4.I4.i1.p1.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>, <math id="S4.I4.i1.p1.m2" class="ltx_Math" alttext="H_{\tau,s,t}^{\rm hmtp}" display="inline" intent=":literal"><semantics><msubsup><mi>H</mi><mrow><mi>τ</mi><mo>,</mo><mi>s</mi><mo>,</mo><mi>t</mi></mrow><mi>hmtp</mi></msubsup><annotation encoding="application/x-tex">H_{\tau,s,t}^{\rm hmtp}</annotation></semantics></math> is equal to <math id="S4.I4.i1.p1.m3" class="ltx_Math" alttext="C^{\rm PSS}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi>PSS</mi></msup><annotation encoding="application/x-tex">C^{\rm PSS}</annotation></semantics></math> for <math id="S4.I4.i1.p1.m4" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> near <math id="S4.I4.i1.p1.m5" class="ltx_Math" alttext="-\infty" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">-\infty</annotation></semantics></math> and is equal to <math id="S4.I4.i1.p1.m6" class="ltx_Math" alttext="C^{\rm SSP}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mi>SSP</mi></msup><annotation encoding="application/x-tex">C^{\rm SSP}</annotation></semantics></math> for <math id="S4.I4.i1.p1.m7" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> near <math id="S4.I4.i1.p1.m8" class="ltx_Math" alttext="+\infty" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">+\infty</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I4.i2.p1" class="ltx_para">
<p id="S4.I4.i2.p1.1" class="ltx_p">For all <math id="S4.I4.i2.p1.m1" class="ltx_Math" alttext="\tau,s,t,x" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>,</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>x</mi></mrow><annotation encoding="application/x-tex">\tau,s,t,x</annotation></semantics></math> there holds</p>
<table id="S4.Ex62" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex62.m1" class="ltx_Math" alttext="\frac{\partial H_{\tau,s,t}^{\rm hmtp}}{\partial s}(x)\geq 0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mrow><mo>∂</mo><msubsup><mi>H</mi><mrow><mi>τ</mi><mo>,</mo><mi>s</mi><mo>,</mo><mi>t</mi></mrow><mi>hmtp</mi></msubsup></mrow><mrow><mo>∂</mo><mi>s</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\partial H_{\tau,s,t}^{\rm hmtp}}{\partial s}(x)\geq 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S4.I4.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S4.I4.i3.p1" class="ltx_para">
<p id="S4.I4.i3.p1.1" class="ltx_p">As <math id="S4.I4.i3.p1.m1" class="ltx_Math" alttext="\tau\to-1" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo stretchy="false">→</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\tau\to-1</annotation></semantics></math>, <math id="S4.I4.i3.p1.m2" class="ltx_Math" alttext="H_{\tau,s,t}^{\rm hmtp}" display="inline" intent=":literal"><semantics><msubsup><mi>H</mi><mrow><mi>τ</mi><mo>,</mo><mi>s</mi><mo>,</mo><mi>t</mi></mrow><mi>hmtp</mi></msubsup><annotation encoding="application/x-tex">H_{\tau,s,t}^{\rm hmtp}</annotation></semantics></math> converges to the concatenation of <math id="S4.I4.i3.p1.m3" class="ltx_Math" alttext="H_{s,t}^{\rm PSS}" display="inline" intent=":literal"><semantics><msubsup><mi>H</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi></mrow><mi>PSS</mi></msubsup><annotation encoding="application/x-tex">H_{s,t}^{\rm PSS}</annotation></semantics></math> and <math id="S4.I4.i3.p1.m4" class="ltx_Math" alttext="H_{s,t}^{\rm SSP}" display="inline" intent=":literal"><semantics><msubsup><mi>H</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi></mrow><mi>SSP</mi></msubsup><annotation encoding="application/x-tex">H_{s,t}^{\rm SSP}</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I4.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S4.I4.i4.p1" class="ltx_para">
<p id="S4.I4.i4.p1.1" class="ltx_p">For <math id="S4.I4.i4.p1.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> near <math id="S4.I4.i4.p1.m2" class="ltx_Math" alttext="+1" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">+1</annotation></semantics></math>, <math id="S4.I4.i4.p1.m3" class="ltx_Math" alttext="H_{\tau,s,t}^{\rm hmtp}" display="inline" intent=":literal"><semantics><msubsup><mi>H</mi><mrow><mi>τ</mi><mo>,</mo><mi>s</mi><mo>,</mo><mi>t</mi></mrow><mi>hmtp</mi></msubsup><annotation encoding="application/x-tex">H_{\tau,s,t}^{\rm hmtp}</annotation></semantics></math> does not depend on <math id="S4.I4.i4.p1.m4" class="ltx_Math" alttext="t\in S^{1}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><msup><mi>S</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">t\in S^{1}</annotation></semantics></math> and <math id="S4.I4.i4.p1.m5" class="ltx_Math" alttext="x\in M" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">x\in M</annotation></semantics></math>. In particular, the associated Hamiltonian vector field is zero.</p>
</div></li>
</ol>
</div>
<div id="S4.SS6.p3" class="ltx_para">
<p id="S4.SS6.p3.1" class="ltx_p">Then consider pairs <math id="S4.SS6.p3.m1" class="ltx_Math" alttext="(\tau,u)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\tau,u)</annotation></semantics></math> where <math id="S4.SS6.p3.m2" class="ltx_math_unparsed" alttext="\tau\in(-1,1]" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\tau\in(-1,1]</annotation></semantics></math> and <math id="S4.SS6.p3.m3" class="ltx_Math" alttext="u:\Theta\to M" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Θ</mi><mo stretchy="false">→</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">u:\Theta\to M</annotation></semantics></math> solving the equation</p>
<table id="S4.E11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E11.m1" class="ltx_Math" alttext="\frac{\partial u}{\partial s}+J\left(\frac{\partial u}{\partial t}-X_{H_{\tau,s,t}^{\rm hmtp}}(u)\right)=0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mrow><mo>∂</mo><mi>u</mi></mrow><mrow><mo>∂</mo><mi>s</mi></mrow></mfrac><mo>+</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mrow><mo>∂</mo><mi>u</mi></mrow><mrow><mo>∂</mo><mi>t</mi></mrow></mfrac><mo>−</mo><mrow><msub><mi>X</mi><msubsup><mi>H</mi><mrow><mi>τ</mi><mo>,</mo><mi>s</mi><mo>,</mo><mi>t</mi></mrow><mi>hmtp</mi></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\partial u}{\partial s}+J\left(\frac{\partial u}{\partial t}-X_{H_{\tau,s,t}^{\rm hmtp}}(u)\right)=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.11)</span></td></tr></tbody>
</table>
<p id="S4.SS6.p3.2" class="ltx_p">The energy of a solution is defined by</p>
<table id="S4.Ex63" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex63.m1" class="ltx_Math" alttext="E^{\rm hmtp}(\tau,u):=\left\|\partial_{s}u\right\|_{L^{2}(\Theta)}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>E</mi><mi>hmtp</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><msubsup><mrow><mo>‖</mo><mrow><msub><mo lspace="0em">∂</mo><mi>s</mi></msub><mi>u</mi></mrow><mo>‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">E^{\rm hmtp}(\tau,u):=\left\|\partial_{s}u\right\|_{L^{2}(\Theta)}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS6.p3.3" class="ltx_p">As the Hamiltonian perturbation vanishes near <math id="S4.SS6.p3.m4" class="ltx_Math" alttext="s=\pm\infty" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>=</mo><mrow><mo>±</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">s=\pm\infty</annotation></semantics></math>, any finite energy solution converges at the infinities. Hence one can use an element of <math id="S4.SS6.p3.m5" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math> to label solutions. Given <math id="S4.SS6.p3.m6" class="ltx_Math" alttext="a\in\Pi" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow><annotation encoding="application/x-tex">a\in\Pi</annotation></semantics></math>, let</p>
<table id="S4.Ex64" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex64.m1" class="ltx_math_unparsed" alttext="{\mathcal{M}}{}_{\bullet\bullet}^{\rm hmtp}(a)" display="block" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mi>hmtp</mi><mprescripts></mprescripts><mrow><mo>∙</mo><mo lspace="0em">⁣</mo><mo>∙</mo></mrow><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">{\mathcal{M}}{}_{\bullet\bullet}^{\rm hmtp}(a)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS6.p3.4" class="ltx_p">to be the set of solutions to (<a href="#S4.E11" title="In 4.6. The homotopy ‣ 4. Proof of the integral Arnold conjecture ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.11</span></a>) whose <math id="S4.SS6.p3.m7" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>-class is <math id="S4.SS6.p3.m8" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math>. Moreover, by intersecting with (un)stable manifolds of Morse critical points, we can define</p>
<table id="S4.Ex65" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex65.m1" class="ltx_math_unparsed" alttext="{\mathcal{M}}{}_{\underline{\smash{x}}\underline{\smash{y}}}^{\rm hmtp}(a)" display="block" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mi>hmtp</mi><mprescripts></mprescripts><mrow><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>y</mi><mo stretchy="true">¯</mo></munder></mrow><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">{\mathcal{M}}{}_{\underline{\smash{x}}\underline{\smash{y}}}^{\rm hmtp}(a)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS6.p3.5" class="ltx_p">to be the set of such solutions whose limit at <math id="S4.SS6.p3.m9" class="ltx_Math" alttext="-\infty" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">-\infty</annotation></semantics></math> resp. <math id="S4.SS6.p3.m10" class="ltx_Math" alttext="+\infty" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">+\infty</annotation></semantics></math> lies in the unstable resp. stable manifold of <math id="S4.SS6.p3.m11" class="ltx_Math" alttext="\underline{\smash{x}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{x}}</annotation></semantics></math> resp. <math id="S4.SS6.p3.m12" class="ltx_Math" alttext="\underline{\smash{y}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>y</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{y}}</annotation></semantics></math>. Lastly, given <math id="S4.SS6.p3.m13" class="ltx_Math" alttext="x=(a,\underline{\smash{x}}),y=(b,\underline{\smash{y}})\in{\mathcal{P}}^{\rm Morse}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>y</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>,</mo><munder accentunder="true"><mi>y</mi><mo stretchy="true">¯</mo></munder><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Morse</mi></msup></mrow></mrow><annotation encoding="application/x-tex">x=(a,\underline{\smash{x}}),y=(b,\underline{\smash{y}})\in{\mathcal{P}}^{\rm Morse}</annotation></semantics></math>, define</p>
<table id="S4.Ex66" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex66.m1" class="ltx_math_unparsed" alttext="{\mathcal{M}}{}_{xy}^{\rm hmtp}:={\mathcal{M}}{}_{\underline{\smash{x}}\underline{\smash{y}}}^{\rm hmtp}(b-a)." display="block" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mmultiscripts><mo>:=</mo><mrow></mrow><mi>hmtp</mi><mprescripts></mprescripts><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mrow></mrow></mmultiscripts><mi class="ltx_font_mathcaligraphic">ℳ</mi><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>−</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mi>hmtp</mi><mprescripts></mprescripts><mrow><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>y</mi><mo stretchy="true">¯</mo></munder></mrow><mrow></mrow></mmultiscripts><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{M}}{}_{xy}^{\rm hmtp}:={\mathcal{M}}{}_{\underline{\smash{x}}\underline{\smash{y}}}^{\rm hmtp}(b-a).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.SS6.p4" class="ltx_para">
<p id="S4.SS6.p4.1" class="ltx_p">We compactify this space by adding configurations with sphere bubbles, broken Morse trajectories, and (when <math id="S4.SS6.p4.m1" class="ltx_Math" alttext="\tau\to-1" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo stretchy="false">→</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\tau\to-1</annotation></semantics></math>) breakings at 1-periodic orbits of <math id="S4.SS6.p4.m2" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>. Denote the compactification by</p>
<table id="S4.Ex67" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex67.m1" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{xy}^{\rm hmtp}." display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub><msup><mrow></mrow><mi>hmtp</mi></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{xy}^{\rm hmtp}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS6.p4.2" class="ltx_p">We call such moduli spaces the <span id="S4.SS6.p4.2.1" class="ltx_text ltx_font_bold">homotopy moduli spaces</span>.</p>
</div>
<section id="S4.SS6.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">4.6.1. </span>Stratifications on homotopy moduli spaces</h4>

<div id="S4.SS6.SSS1.p1" class="ltx_para">
<p id="S4.SS6.SSS1.p1.1" class="ltx_p">The system of the homotopy moduli spaces can be put in a more abstract narrative to include <span id="S4.SS6.SSS1.p1.1.1" class="ltx_text ltx_font_italic">bimodule compositions</span> and <span id="S4.SS6.SSS1.p1.1.2" class="ltx_text ltx_font_italic">bimodule homotopies</span>. However, as its role in the proof of the Arnold conjecture is technical rather than conceptual, we refrain from introducing such frameworks. Here we give a more concrete description of the stratifications on these moduli spaces. Fix <math id="S4.SS6.SSS1.p1.m1" class="ltx_Math" alttext="x,y\in{\mathcal{P}}^{\rm Morse}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Morse</mi></msup></mrow><annotation encoding="application/x-tex">x,y\in{\mathcal{P}}^{\rm Morse}</annotation></semantics></math>. We define a poset</p>
<table id="S4.Ex68" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex68.m1" class="ltx_Math" alttext="{\mathbb{A}}_{xy}^{\rm hmtp}:={\mathbb{A}}_{xy}^{{\rm PSS}+{\rm SSP}}\sqcup\mathring{\mathbb{A}}_{xy}^{\rm hmtp}\sqcup{\mathbb{A}}_{xy}^{\rm pearl}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝔸</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>hmtp</mi></msubsup><mo>:=</mo><mrow><msubsup><mi>𝔸</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mrow><mi>PSS</mi><mo>+</mo><mi>SSP</mi></mrow></msubsup><mo>⊔</mo><msubsup><mover accent="true"><mi>𝔸</mi><mo>̊</mo></mover><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>hmtp</mi></msubsup><mo>⊔</mo><msubsup><mi>𝔸</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>pearl</mi></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathbb{A}}_{xy}^{\rm hmtp}:={\mathbb{A}}_{xy}^{{\rm PSS}+{\rm SSP}}\sqcup\mathring{\mathbb{A}}_{xy}^{\rm hmtp}\sqcup{\mathbb{A}}_{xy}^{\rm pearl}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS6.SSS1.p1.2" class="ltx_p">Here as sets</p>
<table id="S4.Ex69" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex69.m1" class="ltx_Math" alttext="\mathring{\mathbb{A}}_{xy}^{\rm hmtp}={\mathbb{A}}_{xy}^{\rm pearl}" display="block" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>𝔸</mi><mo>̊</mo></mover><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>hmtp</mi></msubsup><mo>=</mo><msubsup><mi>𝔸</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>pearl</mi></msubsup></mrow><annotation encoding="application/x-tex">\mathring{\mathbb{A}}_{xy}^{\rm hmtp}={\mathbb{A}}_{xy}^{\rm pearl}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS6.SSS1.p1.3" class="ltx_p">while as sets</p>
<table id="S4.Ex70" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex70.m1" class="ltx_math_unparsed" alttext="{\mathbb{A}}_{xy}^{{\rm PSS}+{\rm SSP}}:=\Big\{xx_{1}\cdots x_{k}p_{1}\cdots p_{s}y_{l}\cdots y_{1}y\ |\ xx_{1}\cdots x_{k}p_{1}\cdots p_{s}\in{\mathbb{A}}_{xp_{s}}^{\rm PSS},\ p_{s}y_{l}\cdots y_{1}y\in{\mathbb{A}}_{p_{s}y}^{\rm SSP}\Big\}." display="block" intent=":literal"><semantics><mrow><msubsup><mi>𝔸</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mrow><mi>PSS</mi><mo>+</mo><mi>SSP</mi></mrow></msubsup><mo>:=</mo><mrow><mo stretchy="false">{</mo><mi>x</mi><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>x</mi><mi>k</mi></msub><msub><mi>p</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>p</mi><mi>s</mi></msub><msub><mi>y</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>y</mi><mn>1</mn></msub><mi>y</mi><mo fence="false" lspace="0.500em" rspace="0.667em" stretchy="false">|</mo><mi>x</mi><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>x</mi><mi>k</mi></msub><msub><mi>p</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>p</mi><mi>s</mi></msub><mo>∈</mo><msubsup><mi>𝔸</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>s</mi></msub></mrow><mi>PSS</mi></msubsup><mo rspace="0.667em">,</mo><msub><mi>p</mi><mi>s</mi></msub><msub><mi>y</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>y</mi><mn>1</mn></msub><mi>y</mi><mo>∈</mo><msubsup><mi>𝔸</mi><mrow><msub><mi>p</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>SSP</mi></msubsup><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathbb{A}}_{xy}^{{\rm PSS}+{\rm SSP}}:=\Big\{xx_{1}\cdots x_{k}p_{1}\cdots p_{s}y_{l}\cdots y_{1}y\ |\ xx_{1}\cdots x_{k}p_{1}\cdots p_{s}\in{\mathbb{A}}_{xp_{s}}^{\rm PSS},\ p_{s}y_{l}\cdots y_{1}y\in{\mathbb{A}}_{p_{s}y}^{\rm SSP}\Big\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS6.SSS1.p1.4" class="ltx_p">Then one can see that the moduli space <math id="S4.SS6.SSS1.p1.m2" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{xy}^{\rm hmtp}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub><msup><mrow></mrow><mi>hmtp</mi></msup></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{xy}^{\rm hmtp}</annotation></semantics></math> has a natural stratification whose strata are indexed by the set <math id="S4.SS6.SSS1.p1.m3" class="ltx_Math" alttext="{\mathbb{A}}_{xy}^{\rm hmtp}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔸</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>hmtp</mi></msubsup><annotation encoding="application/x-tex">{\mathbb{A}}_{xy}^{\rm hmtp}</annotation></semantics></math>. This then naturally induces a partial order on <math id="S4.SS6.SSS1.p1.m4" class="ltx_Math" alttext="{\mathbb{A}}_{xy}^{\rm hmtp}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔸</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>hmtp</mi></msubsup><annotation encoding="application/x-tex">{\mathbb{A}}_{xy}^{\rm hmtp}</annotation></semantics></math> according to the breaking of Morse or Floer trajectories as well as whether the parameter <math id="S4.SS6.SSS1.p1.m5" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> hits <math id="S4.SS6.SSS1.p1.m6" class="ltx_Math" alttext="-1" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">-1</annotation></semantics></math> or <math id="S4.SS6.SSS1.p1.m7" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>. We use <math id="S4.SS6.SSS1.p1.m8" class="ltx_Math" alttext="\kappa,\nu" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo>,</mo><mi>ν</mi></mrow><annotation encoding="application/x-tex">\kappa,\nu</annotation></semantics></math> etc. instead of <math id="S4.SS6.SSS1.p1.m9" class="ltx_Math" alttext="\alpha,\beta" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>,</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">\alpha,\beta</annotation></semantics></math> to denote elements of <math id="S4.SS6.SSS1.p1.m10" class="ltx_Math" alttext="{\mathbb{A}}_{xy}^{\rm hmtp}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔸</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>hmtp</mi></msubsup><annotation encoding="application/x-tex">{\mathbb{A}}_{xy}^{\rm hmtp}</annotation></semantics></math>. Then it is straightforward to check that <math id="S4.SS6.SSS1.p1.m11" class="ltx_Math" alttext="{\mathbb{A}}_{xy}^{\rm hmtp}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔸</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>hmtp</mi></msubsup><annotation encoding="application/x-tex">{\mathbb{A}}_{xy}^{\rm hmtp}</annotation></semantics></math> is a homogeneous poset with a unique maximal element and depth function being</p>
<table id="S4.Ex71" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex71.m1" class="ltx_Math" alttext="{\rm depth}(\kappa)=\left\{\begin{array}[]{ll}{\rm number\ of\ breakings},&amp;\ \kappa\in\mathring{\mathbb{A}}_{xy}^{\rm hmtp},\\
{\rm number\ of\ breakings}+1,&amp;\ \kappa\in{\mathbb{A}}_{xy}^{\rm pearl},\\
{\rm number\ of\ breakings},&amp;\ \kappa\in{\mathbb{A}}_{xy}^{{\rm PSS}+{\rm SSP}}.\end{array}\right." display="block" intent=":literal"><semantics><mrow><mrow><mi>depth</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>κ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>number</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>of</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>breakings</mi></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>κ</mi><mo>∈</mo><msubsup><mover accent="true"><mi>𝔸</mi><mo>̊</mo></mover><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>hmtp</mi></msubsup></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mi>number</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>of</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>breakings</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>κ</mi><mo>∈</mo><msubsup><mi>𝔸</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>pearl</mi></msubsup></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>number</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>of</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>breakings</mi></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>κ</mi><mo>∈</mo><msubsup><mi>𝔸</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mrow><mi>PSS</mi><mo>+</mo><mi>SSP</mi></mrow></msubsup></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">{\rm depth}(\kappa)=\left\{\begin{array}[]{ll}{\rm number\ of\ breakings},&amp;\ \kappa\in\mathring{\mathbb{A}}_{xy}^{\rm hmtp},\\
{\rm number\ of\ breakings}+1,&amp;\ \kappa\in{\mathbb{A}}_{xy}^{\rm pearl},\\
{\rm number\ of\ breakings},&amp;\ \kappa\in{\mathbb{A}}_{xy}^{{\rm PSS}+{\rm SSP}}.\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.SS6.SSS1.p2" class="ltx_para">
<p id="S4.SS6.SSS1.p2.1" class="ltx_p">The types of codimension one (i.e., strata on which the depth function takes value <math id="S4.SS6.SSS1.p2.m1" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>) degenerations of configurations in the homotopy moduli spaces can be described by the following types of stratified embeddings.</p>
<ol id="S4.I5" class="ltx_enumerate">
<li id="S4.I5.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I5.i1.p1" class="ltx_para">
<p id="S4.I5.i1.p1.1" class="ltx_p">When the parameter <math id="S4.I5.i1.p1.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> hits <math id="S4.I5.i1.p1.m2" class="ltx_Math" alttext="+1" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">+1</annotation></semantics></math>, there is a stratified embedding</p>
<table id="S4.E12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E12.m1" class="ltx_Math" alttext="\vbox{\lx@xy@svg{\hbox{\raise 0.0pt\hbox{\kern 16.26465pt\hbox{\ignorespaces\ignorespaces\ignorespaces\hbox{\vtop{\halign{\entry@#!@&amp;&amp;\entry@@#!@\cr&amp;\cr&amp;\crcr}}}\ignorespaces{\hbox{\kern-16.26465pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\overline{\mathcal{M}}{}_{xy}^{\rm Morse}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 41.51465pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 0.0pt\raise-24.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 41.51465pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\partial^{+}\overline{\mathcal{M}}{}_{xy}^{\rm hmtp}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 62.39491pt\raise-24.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern-15.7813pt\raise-32.99002pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{{\mathbb{A}}_{xy}^{\rm pearl}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 40.26465pt\raise-32.99002pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 40.26465pt\raise-32.99002pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\partial^{+}{\mathbb{A}}_{xy}^{\rm hmtp}}$}}}}}}}\ignorespaces}}}}}." display="block" intent=":literal"><semantics><mrow><mtext> <svg style="vertical-align:-57.21754530941911px" height="69.66" overflow="visible" version="1.1" viewBox="22.51 57.22 139.46 69.66" width="139.46"> <g transform="matrix(1 0 0 -1 22.50539426802269 69.65703714829156) translate(22.51,0)"> <g transform="translate(-22.51,0) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:2.65em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.29em;font-size:10pt;" height="15.6" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="36.71"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub><msup><mrow></mrow><mi>Morse</mi></msup></mrow></span></span></foreignObject> </g> <path style="--ltx-stroke-color:#000000;" d="M 22.50539426802269 -0.27673578005007266 L 22.50539426802269 0.27673578005007266" fill="none" stroke="#000000"></path> <g transform="translate(57.44,0)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M 22.50539426802269 -0.27673578005007266 L 57.443819617406945 0.27673578005007266" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 57.443819617406945 -0.27673578005007266 L 57.443819617406945 0.27673578005007266" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -11.569253138458645 L 0.27673578005