q</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.710em">p</mi><mo>′</mo></msup></mrow><mi mathsize="0.710em">M</mi></msubsup><annotation encoding="application/x-tex">\scriptstyle{{\bm{\iota}}^{M}_{pq^{\prime}p^{\prime}}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(105.93,0) translate(0,-81.46)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -5.72 4.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -7.44 -0.49" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 39.162135015339615 -59.68832055843106 L 105.93049569431473 -81.4590042386623" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 105.93049569431473 -81.28597839617277 L 105.93049569431473 -81.4590042386623" fill="none" stroke="#000000"></path><g transform="translate(234.96,0) translate(0,-46.94) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:6.87em;--ltx-fo-height:0.94em;--ltx-fo-depth:0.37em;font-size:10pt;" height="18.18" overflow="visible" transform="matrix(1 0 0 -1 0 13.04)" width="95.04"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex74.m1.pic1.m9" class="ltx_Math" alttext="\textstyle{C^{{\mathcal{P}}}_{pq}\times\partial^{qq^{\prime}p^{\prime}}C^{M}_{qp^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>C</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup><mo lspace="0.222em" rspace="0.055em">×</mo><mrow><msup><mo>∂</mo><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msup><msubsup><mi>C</mi><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mi>M</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\textstyle{C^{{\mathcal{P}}}_{pq}\times\partial^{qq^{\prime}p^{\prime}}C^{M}_{qp^{\prime}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 247.9630287247475 -59.68832055843106 L 247.9630287247475 -59.68832055843106" fill="none" stroke="#000000"></path><g transform="translate(204.76,0) translate(0,-80.94) translate(4.15,0) translate(0,-2.53)"><foreignObject style="--ltx-fo-width:1.7em;--ltx-fo-height:0.64em;--ltx-fo-depth:0.28em;font-size:10pt;" height="12.75" overflow="visible" transform="matrix(1 0 0 -1 0 8.9)" width="23.57"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex74.m1.pic1.m10" class="ltx_Math" alttext="\scriptstyle{{\bm{\iota}}^{M}_{pqp^{\prime}}}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.700em">𝜾</mi><mrow><mi mathsize="0.710em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">q</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.710em">p</mi><mo>′</mo></msup></mrow><mi mathsize="0.710em">M</mi></msubsup><annotation encoding="application/x-tex">\scriptstyle{{\bm{\iota}}^{M}_{pqp^{\prime}}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(182.57,0) translate(0,-81.24)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 7.44 -0.46" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 5.7 4.8" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 247.9630287247475 -59.68832055843106 L 182.56810685650382 -81.2344612447787" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 182.60919389609927 -81.2344612447787 L 182.56810685650382 -81.2344612447787" fill="none" stroke="#000000"></path><g transform="translate(105.93,0) translate(0,-93.88) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:4.94em;--ltx-fo-height:0.94em;--ltx-fo-depth:0.37em;font-size:10pt;" height="18.18" overflow="visible" transform="matrix(1 0 0 -1 0 13.04)" width="68.34"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex74.m1.pic1.m12" class="ltx_Math" alttext="\textstyle{\partial^{pqq^{\prime}p^{\prime}}C^{M}_{pp^{\prime}}.}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mo>∂</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msup><msubsup><mi>C</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mi>M</mi></msubsup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\textstyle{\partial^{pqq^{\prime}p^{\prime}}C^{M}_{pp^{\prime}}.}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
