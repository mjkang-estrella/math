</table>
<p id="S6.I1.i2.p1.2" class="ltx_p">a <span id="S6.I1.i2.p1.2.1" class="ltx_text ltx_font_bold">morphism</span> from <math id="S6.I1.i2.p1.m2" class="ltx_Math" alttext="{\mathscr{E}}_{1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">ℰ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\mathscr{E}}_{1}</annotation></semantics></math> to <math id="S6.I1.i2.p1.m3" class="ltx_Math" alttext="{\mathscr{E}}_{2}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">ℰ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">{\mathscr{E}}_{2}</annotation></semantics></math> is a germ of continuous maps <math id="S6.I1.i2.p1.m4" class="ltx_Math" alttext="\phi:U_{1}\to E_{2}" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>U</mi><mn>1</mn></msub><mo stretchy="false">→</mo><msub><mi>E</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\phi:U_{1}\to E_{2}</annotation></semantics></math> defined over a neighborhood <math id="S6.I1.i2.p1.m5" class="ltx_Math" alttext="{\mathscr{U}}_{1}\subset{\mathscr{E}}_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒰</mi><mn>1</mn></msub><mo>⊂</mo><msub><mi class="ltx_font_mathscript">ℰ</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">{\mathscr{U}}_{1}\subset{\mathscr{E}}_{1}</annotation></semantics></math> of <math id="S6.I1.i2.p1.m6" class="ltx_Math" alttext="s_{1}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{1}(X)</annotation></semantics></math> which commutes with the maps <math id="S6.I1.i2.p1.m7" class="ltx_Math" alttext="s_{1},s_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mn>1</mn></msub><mo>,</mo><msub><mi>s</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">s_{1},s_{2}</annotation></semantics></math> and <math id="S6.I1.i2.p1.m8" class="ltx_Math" alttext="p_{1},p_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>1</mn></msub><mo>,</mo><msub><mi>p</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">p_{1},p_{2}</annotation></semantics></math>. Two morphisms <math id="S6.I1.i2.p1.m9" class="ltx_Math" alttext="\phi_{1},\phi_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>ϕ</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\phi_{1},\phi_{2}</annotation></semantics></math> from <math id="S6.I1.i2.p1.m10" class="ltx_Math" alttext="{\mathscr{E}}_{1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">ℰ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\mathscr{E}}_{1}</annotation></semantics></math> to <math id="S6.I1.i2.p1.m11" class="ltx_Math" alttext="{\mathscr{E}}_{2}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">ℰ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">{\mathscr{E}}_{2}</annotation></semantics></math>, defined over <math id="S6.I1.i2.p1.m12" class="ltx_Math" alttext="{\mathscr{U}}_{1}\subset{\mathscr{E}}_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒰</mi><mn>1</mn></msub><mo>⊂</mo><msub><mi class="ltx_font_mathscript">ℰ</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">{\mathscr{U}}_{1}\subset{\mathscr{E}}_{1}</annotation></semantics></math> and <math id="S6.I1.i2.p1.m13" class="ltx_Math" alttext="{\mathscr{U}}_{2}\subset{\mathscr{E}}_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒰</mi><mn>2</mn></msub><mo>⊂</mo><msub><mi class="ltx_font_mathscript">ℰ</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">{\mathscr{U}}_{2}\subset{\mathscr{E}}_{2}</annotation></semantics></math> respectively, are called <span id="S6.I1.i2.p1.2.2" class="ltx_text ltx_font_bold">equivalent</span> if there exists a neighborhood of <math id="S6.I1.i2.p1.m14" class="ltx_Math" alttext="s_{1}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{1}(X)</annotation></semantics></math> in <math id="S6.I1.i2.p1.m15" class="ltx_Math" alttext="{\mathscr{E}}_{1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">ℰ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\mathscr{E}}_{1}</annotation></semantics></math> contained in <math id="S6.I1.i2.p1.m16" class="ltx_Math" alttext="{\mathscr{U}}_{1}\cap{\mathscr{U}}_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒰</mi><mn>1</mn></msub><mo>∩</mo><msub><mi class="ltx_font_mathscript">𝒰</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">{\mathscr{U}}_{1}\cap{\mathscr{U}}_{2}</annotation></semantics></math> on which <math id="S6.I1.i2.p1.m17" class="ltx_Math" alttext="\phi_{1}=\phi_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mn>1</mn></msub><mo>=</mo><msub><mi>ϕ</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\phi_{1}=\phi_{2}</annotation></semantics></math>.</p>
</div></li>
<li id="S6.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S6.I1.i3.p1" class="ltx_para">
<p id="S6.I1.i3.p1.1" class="ltx_p">Using the notations as above, a morphism between microbundles</p>
