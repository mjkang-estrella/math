" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 125.16543761945223 -0.27673578005007266 L 125.16543761945223 0.27673578005007266" fill="none" stroke="#000000"></path> <g transform="translate(125.17,0) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:0.68em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="9.42"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mi class="ltx_font_mathcaligraphic">ℰ</mi></span></span></foreignObject> </g> <path style="--ltx-stroke-color:#000000;" d="M 133.74823726887885 -7.610350076103501 L 134.301708828979 -7.610350076103501" fill="none" stroke="#000000"></path> <g transform="translate(134.03,0) translate(0,-35.39)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M 133.74823726887885 -35.39359205010291 L 134.301708828979 -7.610350076103501" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 133.74823726887885 -35.39359205010291 L 134.301708828979 -35.39359205010291" fill="none" stroke="#000000"></path> <g transform="translate(-45.25,0) translate(0,-45.54) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:5.94em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.25em;font-size:10pt;" height="15.1" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="82.2"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mrow><msup><mo>∂</mo><mi>α</mi></msup><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow><msub><mi>𝔽</mi><mi>α</mi></msub></msup></mrow></span></span></foreignObject> </g> <path style="--ltx-stroke-color:#000000;" d="M 45.249942131881745 -45.817433113508805 L 45.249942131881745 -45.263961553408656" fill="none" stroke="#000000"></path> <g transform="translate(66.35,0) translate(0,-54.87) translate(4.15,0) translate(0,-3.8)"> <foreignObject style="--ltx-fo-width:2.09em;--ltx-fo-height:0.65em;--ltx-fo-depth:0.1em;font-size:10pt;" height="10.36" overflow="visible" transform="matrix(1 0 0 -1 0 8.98)" width="28.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><msubsup><mi mathsize="0.700em">θ</mi><mi mathsize="0.710em">α</mi><mi mathsize="0.710em">collar</mi></msubsup></span></span></foreignObject> </g> <g transform="translate(124.69,0) translate(0,-45.54)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M 45.249942131881745 -45.817433113508805 L 124.68499795552918 -45.263961553408656" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 124.68499795552918 -45.817433113508805 L 124.68499795552918 -45.263961553408656" fill="none" stroke="#000000"></path> <g transform="translate(124.69,0) translate(0,-45.54) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:0.75em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="10.38"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mi class="ltx_font_mathcaligraphic">𝒰</mi></span></span></foreignObject> </g> </g> </svg> </mtext><mspace style="width:1.167em;" width="1.167em"></mspace><mrow><mrow><mo rspace="0.167em">∀</mo><mi>α</mi></mrow><mo>∈</mo><mi>𝔸</mi></mrow></mrow><annotation encoding="application/x-tex">\vbox{\lx@xy@svg{\hbox{\raise 0.0pt\hbox{\kern 36.10985pt\hbox{\ignorespaces\ignorespaces\ignorespaces\hbox{\vtop{\halign{\entry@#!@&amp;&amp;\entry@@#!@\cr&amp;&amp;\cr&amp;&amp;\crcr}}}\ignorespaces{\hbox{\kern-36.10985pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{{\mathcal{E}}|_{\partial^{\alpha}{\mathcal{U}}}\times[0,\epsilon)^{{\mathbb{F}}_{\alpha}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 0.0pt\raise-24.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 48.95694pt\raise 7.36111pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-2.86111pt\hbox{$\scriptstyle{\widehat{\theta}_{\alpha}^{\rm collar}}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 90.45706pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 60.10985pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{}$}}}}}}}{\hbox{\kern 90.45706pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{{\mathcal{E}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 96.85985pt\raise-25.57895pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern-32.70213pt\raise-32.91226pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\partial^{\alpha}{\mathcal{U}}\times[0,\epsilon)^{{\mathbb{F}}_{\alpha}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 47.95277pt\raise-39.65727pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-2.74501pt\hbox{$\scriptstyle{\theta_{\alpha}^{\rm collar}}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 90.10985pt\raise-32.91226pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 60.10985pt\raise-32.91226pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{}$}}}}}}}{\hbox{\kern 90.10985pt\raise-32.91226pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{{\mathcal{U}}}$}}}}}}}\ignorespaces}}}}}\ \ \forall\alpha\in{\mathbb{A}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I17.i1.p1.2" class="ltx_p">(where <math id="S3.I17.i1.p1.m3" class="ltx_Math" alttext="{\mathbb{F}}_{\alpha}\subset{\mathbb{A}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔽</mi><mi>α</mi></msub><mo>⊂</mo><mi>𝔸</mi></mrow><annotation encoding="application/x-tex">{\mathbb{F}}_{\alpha}\subset{\mathbb{A}}</annotation></semantics></math> is the set of adjacent faces to <math id="S3.I17.i1.p1.m4" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>, see Definition <a href="#S3.Thmthm2" title="Definition 3.2. ‣ 3.1.1. Partially ordered sets ‣ 3.1. Stratified spaces ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a> and Notation <a href="#S3.Thmthm14" title="Notation 3.14. ‣ 3.4.1. Stratified topological manifolds corners ‣ 3.4. Derived orbifold charts with stratifications ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.14</span></a>) covering the poset map</p>
<table id="S3.Ex78" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex78.m1" class="ltx_Math" alttext="\partial^{\alpha}{\mathbb{A}}\times{\mathbb{A}}^{(|{\mathbb{F}}_{\alpha}|)}\to{\mathbb{A}}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mo>∂</mo><mi>α</mi></msup><mi>𝔸</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>𝔸</mi><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">|</mo><msub><mi>𝔽</mi><mi>α</mi></msub><mo stretchy="false">|</mo></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">→</mo><mi>𝔸</mi></mrow><annotation encoding="application/x-tex">\partial^{\alpha}{\mathbb{A}}\times{\mathbb{A}}^{(|{\mathbb{F}}_{\alpha}|)}\to{\mathbb{A}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I17.i1.p1.3" class="ltx_p">satisfying the following conditions.</p>
<ol id="S3.I17.i1.I1" class="ltx_enumerate">
<li id="S3.I17.i1.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(a)</span> 
<div id="S3.I17.i1.I1.i1.p1" class="ltx_para">
<p id="S3.I17.i1.I1.i1.p1.1" class="ltx_p">For a pair of stratum <math id="S3.I17.i1.I1.i1.p1.m1" class="ltx_Math" alttext="\alpha\leq\beta" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">\alpha\leq\beta</annotation></semantics></math>, <math id="S3.I17.i1.I1.i1.p1.m2" class="ltx_Math" alttext="v\in{\mathcal{E}}|_{\partial^{\alpha}{\mathcal{U}}}" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><msub><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">|</mo></mrow><mrow><msup><mo>∂</mo><mi>α</mi></msup><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow></msub></mrow><annotation encoding="application/x-tex">v\in{\mathcal{E}}|_{\partial^{\alpha}{\mathcal{U}}}</annotation></semantics></math>, <math id="S3.I17.i1.I1.i1.p1.m3" class="ltx_math_unparsed" alttext="t_{\beta}\in[0,\epsilon)^{{\mathbb{F}}_{\beta}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>β</mi></msub><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow><msub><mi>𝔽</mi><mi>β</mi></msub></msup></mrow><annotation encoding="application/x-tex">t_{\beta}\in[0,\epsilon)^{{\mathbb{F}}_{\beta}}</annotation></semantics></math> and <math id="S3.I17.i1.I1.i1.p1.m4" class="ltx_math_unparsed" alttext="t_{\beta\alpha}\in[0,\epsilon)^{{\mathbb{F}}_{\alpha}\setminus{\mathbb{F}}_{\beta}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow><mrow><msub><mi>𝔽</mi><mi>α</mi></msub><mo>∖</mo><msub><mi>𝔽</mi><mi>β</mi></msub></mrow></msup></mrow><annotation encoding="application/x-tex">t_{\beta\alpha}\in[0,\epsilon)^{{\mathbb{F}}_{\alpha}\setminus{\mathbb{F}}_{\beta}}</annotation></semantics></math> (so that <math id="S3.I17.i1.I1.i1.p1.m5" class="ltx_Math" alttext="(t_{\beta},t_{\beta\alpha})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>β</mi></msub><mo>,</mo><msub><mi>t</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(t_{\beta},t_{\beta\alpha})</annotation></semantics></math> is identified with an element of <math id="S3.I17.i1.I1.i1.p1.m6" class="ltx_math_unparsed" alttext="[0,\epsilon)^{{\mathbb{F}}_{\alpha}}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow><msub><mi>𝔽</mi><mi>α</mi></msub></msup><annotation encoding="application/x-tex">[0,\epsilon)^{{\mathbb{F}}_{\alpha}}</annotation></semantics></math>), one has</p>
<table id="S3.Ex79" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex79.m1" class="ltx_Math" alttext="\widehat{\theta}_{\alpha}^{\rm collar}(v,t_{\beta},t_{\beta\alpha})=\widehat{\theta}_{\beta}^{\rm collar}(\widehat{\theta}_{\alpha}^{\rm collar}(v,0,t_{\beta\alpha}),t_{\beta})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mi>α</mi><mi>collar</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><msub><mi>t</mi><mi>β</mi></msub><mo>,</mo><msub><mi>t</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mi>β</mi><mi>collar</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mi>α</mi><mi>collar</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mn>0</mn><mo>,</mo><msub><mi>t</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>t</mi><mi>β</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widehat{\theta}_{\alpha}^{\rm collar}(v,t_{\beta},t_{\beta\alpha})=\widehat{\theta}_{\beta}^{\rm collar}(\widehat{\theta}_{\alpha}^{\rm collar}(v,0,t_{\beta\alpha}),t_{\beta}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S3.I17.i1.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(b)</span> 
<div id="S3.I17.i1.I1.i2.p1" class="ltx_para">
<p id="S3.I17.i1.I1.i2.p1.1" class="ltx_p">For each <math id="S3.I17.i1.I1.i2.p1.m1" class="ltx_Math" alttext="\alpha\in{\mathbb{A}}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mi>𝔸</mi></mrow><annotation encoding="application/x-tex">\alpha\in{\mathbb{A}}</annotation></semantics></math>, <math id="S3.I17.i1.I1.i2.p1.m2" class="ltx_Math" alttext="x\in\partial^{\alpha}{\mathcal{U}}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo rspace="0.111em">∈</mo><mrow><msup><mo>∂</mo><mi>α</mi></msup><mi class="ltx_font_mathcaligraphic">𝒰</mi></mrow></mrow><annotation encoding="application/x-tex">x\in\partial^{\alpha}{\mathcal{U}}</annotation></semantics></math> and <math id="S3.I17.i1.I1.i2.p1.m3" class="ltx_math_unparsed" alttext="t_{\alpha}\in[0,\epsilon)^{{\mathbb{F}}_{\alpha}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>α</mi></msub><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow><msub><mi>𝔽</mi><mi>α</mi></msub></msup></mrow><annotation encoding="application/x-tex">t_{\alpha}\in[0,\epsilon)^{{\mathbb{F}}_{\alpha}}</annotation></semantics></math>, one has</p>
<table id="S3.Ex80" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex80.m1" class="ltx_Math" alttext="\widehat{\theta}_{\alpha}^{\rm collar}({\mathcal{S}}(x),t_{\alpha})={\mathcal{S}}(\theta_{\alpha}^{\rm collar}(x,t_{\alpha}))." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mi>α</mi><mi>collar</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>t</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>θ</mi><mi>α</mi><mi>collar</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>t</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widehat{\theta}_{\alpha}^{\rm collar}({\mathcal{S}}(x),t_{\alpha})={\mathcal{S}}(\theta_{\alpha}^{\rm collar}(x,t_{\alpha})).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
</div></li>
<li id="S3.I17.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S3.I17.i2.p1" class="ltx_para">
<p id="S3.I17.i2.p1.1" class="ltx_p">A collar structure on a system of D-chart presentations <math id="S3.I17.i2.p1.m1" class="ltx_Math" alttext="((C_{\alpha})_{\alpha\in{\mathbb{A}}},({\bm{\iota}}_{\beta\alpha})_{\alpha\leq\beta})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>α</mi><mo>∈</mo><mi>𝔸</mi></mrow></msub><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝜾</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">((C_{\alpha})_{\alpha\in{\mathbb{A}}},({\bm{\iota}}_{\beta\alpha})_{\alpha\leq\beta})</annotation></semantics></math> of an <math id="S3.I17.i2.p1.m2" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-stratified space <math id="S3.I17.i2.p1.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> (see Definition <a href="#S3.Thmthm22" title="Definition 3.22. ‣ 3.4.3. Stratified smooth orbifolds with corners and derived orbifold charts ‣ 3.4. Derived orbifold charts with stratifications ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.22</span></a>) consists of collar structures on all derived orbifold charts <math id="S3.I17.i2.p1.m4" class="ltx_Math" alttext="C_{\alpha}=({\mathcal{U}}_{\alpha},{\mathcal{E}}_{\alpha},{\mathcal{S}}_{\alpha})" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>α</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>α</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>α</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{\alpha}=({\mathcal{U}}_{\alpha},{\mathcal{E}}_{\alpha},{\mathcal{S}}_{\alpha})</annotation></semantics></math> for all <math id="S3.I17.i2.p1.m5" class="ltx_Math" alttext="\alpha\in{\mathbb{A}}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mi>𝔸</mi></mrow><annotation encoding="application/x-tex">\alpha\in{\mathbb{A}}</annotation></semantics></math>. Namely, for each <math id="S3.I17.i2.p1.m6" class="ltx_Math" alttext="\beta\in{\mathbb{A}}" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>∈</mo><mi>𝔸</mi></mrow><annotation encoding="application/x-tex">\beta\in{\mathbb{A}}</annotation></semantics></math>, a collection of open chart embedding</p>
<table id="S3.Ex81" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
