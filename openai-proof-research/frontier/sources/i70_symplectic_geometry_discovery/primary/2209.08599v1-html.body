</mi></mrow></msup><mi>K</mi><msub><mrow></mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>K</mi><msup><mrow></mrow><mi>SSP</mi></msup><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow></msub></mrow><annotation encoding="application/x-tex">\textstyle{\partial^{rsp}K_{rp}\times K^{\rm SSP}_{p\bullet}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 36.89449358336144 -57.10995047191738 L 36.93878988812569 -57.22529399571486" fill="none" stroke="#000000"></path><g transform="translate(106.42,0) translate(0,-79.09)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -5.77 4.72" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -7.43 -0.56" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 36.89449358336144 -57.10995047191738 L 106.41790284182795 -79.08714614304431" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 106.41790284182795 -78.92727406502958 L 106.41790284182795 -79.08714614304431" fill="none" stroke="#000000"></path><g transform="translate(236.04,0) translate(0,-45.46) translate(4.15,0) translate(0,-3.54)"><foreignObject style="--ltx-fo-width:6.91em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.15em;font-size:10pt;" height="13.72" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="95.66"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S7.Ex42.m1.pic1.m6" class="ltx_math_unparsed" alttext="\textstyle{K_{rs}\times\partial^{sp\bullet}K^{\rm SSP}_{s\bullet}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><msub><mrow></mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><mo lspace="0.222em" rspace="0.055em">×</mo><mo>∂</mo><msup><mrow></mrow><mrow><mi>s</mi><mi>p</mi><mo lspace="0.222em">∙</mo></mrow></msup><mi>K</mi><msup><mrow></mrow><mi>SSP</mi></msup><msub><mrow></mrow><mrow><mi>s</mi><mo lspace="0.222em">∙</mo></mrow></msub></mrow><annotation encoding="application/x-tex">\textstyle{K_{rs}\times\partial^{sp\bullet}K^{\rm SSP}_{s\bullet}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 257.1117358368034 -55.22659743031773 L 257.10250919944303 -55.271717164960826" fill="none" stroke="#000000"></path><g transform="translate(181.73,0) translate(0,-79.05)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 7.43 -0.56" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 5.77 4.72" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 257.1117358368034 -55.22659743031773 L 181.72673042902267 -79.05038738870944" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 181.72673042902267 -78.99213500317819 L 181.72673042902267 -79.05038738870944" fill="none" stroke="#000000"></path><g transform="translate(106.42,0) translate(0,-90.93) translate(4.15,0) translate(0,-3.54)"><foreignObject style="--ltx-fo-width:4.84em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.29em;font-size:10pt;" height="15.6" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="67.01"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S7.Ex42.m1.pic1.m8" class="ltx_Math" alttext="\textstyle{\partial^{\bullet rsp}K^{\rm SSP}_{\bullet p}.}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mo>∂</mo><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></mrow></msup><msubsup><mi>K</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>p</mi></mrow><mi>SSP</mi></msubsup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\textstyle{\partial^{\bullet rsp}K^{\rm SSP}_{\bullet p}.}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S7.I5.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S7.I5.i2.p1" class="ltx_para">
<p id="S7.I5.i2.p1.1" class="ltx_p"><span id="S7.I5.i2.p1.1.1" class="ltx_text ltx_font_italic">For each stratum </span><math id="S7.I5.i2.p1.m1" class="ltx_math_unparsed" alttext="\alpha=\bullet r_{1}\cdots r_{l}q\in{\mathbb{A}}_{\bullet q}^{\rm PSS}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo rspace="0em">=</mo><mo lspace="0em" rspace="0.222em">∙</mo><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>l</mi></msub><mi>q</mi><mo>∈</mo><mi>𝔸</mi><msub><mrow></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow></msub><msup><mrow></mrow><mi>PSS</mi></msup></mrow><annotation encoding="application/x-tex">\alpha=\bullet r_{1}\cdots r_{l}q\in{\mathbb{A}}_{\bullet q}^{\rm PSS}</annotation></semantics></math><span id="S7.I5.i2.p1.1.2" class="ltx_text ltx_font_italic"> resp. </span><math id="S7.I5.i2.p1.m2" class="ltx_math_unparsed" alttext="\alpha=pr_{1}\cdots r_{l}\bullet\in{\mathbb{A}}_{p\bullet}^{\rm SSP}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mi>p</mi><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>l</mi></msub><mo lspace="0.222em" rspace="0em">∙</mo><mo lspace="0em">∈</mo><mi>𝔸</mi><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow></msub><msup><mrow></mrow><mi>SSP</mi></msup></mrow><annotation encoding="application/x-tex">\alpha=pr_{1}\cdots r_{l}\bullet\in{\mathbb{A}}_{p\bullet}^{\rm SSP}</annotation></semantics></math><span id="S7.I5.i2.p1.1.3" class="ltx_text ltx_font_italic">, define the product chart</span></p>
<table id="S7.Ex43" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex43.m1" class="ltx_math_unparsed" alttext="K_{\alpha}^{\rm PSS}:=K_{\bullet r_{1}}^{\rm PSS}\times\cdots\times K_{r_{l}q}" display="block" intent=":literal"><semantics><mrow><mi>K</mi><msub><mrow></mrow><mi>α</mi></msub><msup><mrow></mrow><mi>PSS</mi></msup><mo>:=</mo><mi>K</mi><msub><mrow></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></msub><msup><mrow></mrow><mi>PSS</mi></msup><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi>K</mi><msub><mrow></mrow><mrow><msub><mi>r</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">K_{\alpha}^{\rm PSS}:=K_{\bullet r_{1}}^{\rm PSS}\times\cdots\times K_{r_{l}q}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="S7.Ex44" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex44.m1" class="ltx_math_unparsed" alttext="{\rm resp.}K^{\rm SSP}_{\alpha}:=K_{pr_{1}}\times\cdots\times K^{\rm SSP}_{r_{l}\bullet}." display="block" intent=":literal"><semantics><mrow><mi>resp</mi><mo lspace="0em" rspace="0.167em">.</mo><mi>K</mi><msup><mrow></mrow><mi>SSP</mi></msup><msub><mrow></mrow><mi>α</mi></msub><mo>:=</mo><mi>K</mi><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi>K</mi><msup><mrow></mrow><mi>SSP</mi></msup><msub><mrow></mrow><mrow><mi>r</mi><msub><mrow></mrow><mi>l</mi></msub><mo lspace="0.222em">∙</mo></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\rm resp.}K^{\rm SSP}_{\alpha}:=K_{pr_{1}}\times\cdots\times K^{\rm SSP}_{r_{l}\bullet}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.I5.i2.p1.2" class="ltx_p"><span id="S7.I5.i2.p1.2.1" class="ltx_text ltx_font_italic">Then for any pair </span><math id="S7.I5.i2.p1.m3" class="ltx_Math" alttext="\alpha\leq\beta" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">\alpha\leq\beta</annotation></semantics></math><span id="S7.I5.i2.p1.2.2" class="ltx_text ltx_font_italic"> in </span><math id="S7.I5.i2.p1.m4" class="ltx_Math" alttext="{\mathbb{A}}_{\bullet q}^{\rm PSS}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔸</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><annotation encoding="application/x-tex">{\mathbb{A}}_{\bullet q}^{\rm PSS}</annotation></semantics></math><span id="S7.I5.i2.p1.2.3" class="ltx_text ltx_font_italic"> resp. </span><math id="S7.I5.i2.p1.m5" class="ltx_math_unparsed" alttext="{\mathbb{A}}_{p\bullet}^{\rm SSP}" display="inline" intent=":literal"><semantics><mrow><mi>𝔸</mi><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow></msub><msup><mrow></mrow><mi>SSP</mi></msup></mrow><annotation encoding="application/x-tex">{\mathbb{A}}_{p\bullet}^{\rm SSP}</annotation></semantics></math><span id="S7.I5.i2.p1.2.4" class="ltx_text ltx_font_italic">, there are induced product weak embeddings</span></p>
<table id="S7.Ex45" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex45.m1" class="ltx_Math" alttext="{\bm{\iota}}^{\rm PSS}_{\beta\alpha}:K^{\rm PSS}_{\alpha}\rightharpoonup\partial^{\alpha}K^{\rm PSS}_{\beta}\text{\ resp. }{\bm{\iota}}^{\rm SSP}_{\beta\alpha}:K^{\rm SSP}_{\alpha}\rightharpoonup\partial^{\alpha}K^{\rm SSP}_{\beta}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝜾</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mi>PSS</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>K</mi><mi>α</mi><mi>PSS</mi></msubsup><mo rspace="0.111em" stretchy="false">⇀</mo><mrow><msup><mo>∂</mo><mi>α</mi></msup><mrow><msubsup><mi>K</mi><mi>β</mi><mi>PSS</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mtext class="ltx_mathvariant_italic"> resp. </mtext><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝜾</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mi>SSP</mi></msubsup></mrow></mrow></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>K</mi><mi>α</mi><mi>SSP</mi></msubsup><mo rspace="0.111em" stretchy="false">⇀</mo><mrow><msup><mo>∂</mo><mi>α</mi></msup><msubsup><mi>K</mi><mi>β</mi><mi>SSP</mi></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\bm{\iota}}^{\rm PSS}_{\beta\alpha}:K^{\rm PSS}_{\alpha}\rightharpoonup\partial^{\alpha}K^{\rm PSS}_{\beta}\text{\ resp. }{\bm{\iota}}^{\rm SSP}_{\beta\alpha}:K^{\rm SSP}_{\alpha}\rightharpoonup\partial^{\alpha}K^{\rm SSP}_{\beta}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.I5.i2.p1.3" class="ltx_p"><span id="S7.I5.i2.p1.3.1" class="ltx_text ltx_font_italic">Then the system</span></p>
<table id="S7.Ex46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex46.m1" class="ltx_math_unparsed" alttext="\{K^{\rm PSS}_{\alpha}\}_{\alpha\in{\mathbb{A}}_{\bullet q}^{\rm PSS}}\text{ resp. }\{K^{\rm SSP}_{\alpha}\}_{\alpha\in{\mathbb{A}}_{p\bullet}^{\rm SSP}}" display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">{</mo><msubsup><mi>K</mi><mi>α</mi><mi>PSS</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>α</mi><mo>∈</mo><msubsup><mi>𝔸</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup></mrow></msub><mtext class="ltx_mathvariant_italic"> resp. </mtext><msub><mrow><mo stretchy="false">{</mo><msubsup><mi>K</mi><mi>α</mi><mi>SSP</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>α</mi><mo>∈</mo><mi>𝔸</mi><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow></msub><msup><mrow></mrow><mi>SSP</mi></msup></mrow></msub></mrow><annotation encoding="application/x-tex">\{K^{\rm PSS}_{\alpha}\}_{\alpha\in{\mathbb{A}}_{\bullet q}^{\rm PSS}}\text{ resp. }\{K^{\rm SSP}_{\alpha}\}_{\alpha\in{\mathbb{A}}_{p\bullet}^{\rm SSP}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.I5.i2.p1.4" class="ltx_p"><span id="S7.I5.i2.p1.4.1" class="ltx_text ltx_font_italic">defines a weak K-chart presentation of the </span><math id="S7.I5.i2.p1.m6" class="ltx_Math" alttext="{\mathbb{A}}_{\bullet q}^{\rm PSS}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔸</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><annotation encoding="application/x-tex">{\mathbb{A}}_{\bullet q}^{\rm PSS}</annotation></semantics></math><span id="S7.I5.i2.p1.4.2" class="ltx_text ltx_font_italic">-space </span><math id="S7.I5.i2.p1.m7" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{\bullet q}^{\rm PSS}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow></msub><msup><mrow></mrow><mi>PSS</mi></msup></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{\bullet q}^{\rm PSS}</annotation></semantics></math><span id="S7.I5.i2.p1.4.3" class="ltx_text ltx_font_italic"> resp. the </span><math id="S7.I5.i2.p1.m8" class="ltx_math_unparsed" alttext="{\mathbb{A}}_{p\bullet}^{\rm SSP}" display="inline" intent=":literal"><semantics><mrow><mi>𝔸</mi><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow></msub><msup><mrow></mrow><mi>SSP</mi></msup></mrow><annotation encoding="application/x-tex">{\mathbb{A}}_{p\bullet}^{\rm SSP}</annotation></semantics></math><span id="S7.I5.i2.p1.4.4" class="ltx_text ltx_font_italic">-space </span><math id="S7.I5.i2.p1.m9" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{p\bullet}^{\rm SSP}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow></msub><msup><mrow></mrow><mi>SSP</mi></msup></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{p\bullet}^{\rm SSP}</annotation></semantics></math><span id="S7.I5.i2.p1.4.5" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S7.I5.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S7.I5.i3.p1" class="ltx_para">
<p id="S7.I5.i3.p1.1" class="ltx_p"><span id="S7.I5.i3.p1.1.1" class="ltx_text ltx_font_italic">After outer-collaring, one can match up the Kuranishi sections so that the weak K-chart presentation is a genuine K-chart presentation.</span></p>
</div></li>
<li id="S7.I5.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S7.I5.i4.p1" class="ltx_para">
<p id="S7.I5.i4.p1.1" class="ltx_p"><span id="S7.I5.i4.p1.1.1" class="ltx_text ltx_font_italic">The natural projection </span><math id="S7.I5.i4.p1.m1" class="ltx_Math" alttext="\pi_{\bullet q}^{\rm PSS}:V_{\bullet q}^{\rm PSS}\to B_{d_{\bullet q}}^{\rm PSS}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>π</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><mo stretchy="false">→</mo><msubsup><mi>B</mi><msub><mi>d</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow></msub><mi>PSS</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\pi_{\bullet q}^{\rm PSS}:V_{\bullet q}^{\rm PSS}\to B_{d_{\bullet q}}^{\rm PSS}</annotation></semantics></math><span id="S7.I5.i4.p1.1.2" class="ltx_text ltx_font_italic"> resp. </span><math id="S7.I5.i4.p1.m2" class="ltx_math_unparsed" alttext="\pi_{p\bullet}^{\rm SSP}:V_{p\bullet}^{\rm SSP}\to B_{d_{p\bullet}}^{\rm SSP}" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow></msub><msup><mrow></mrow><mi>SSP</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mi>V</mi><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow></msub><msup><mrow></mrow><mi>SSP</mi></msup><mo stretchy="false">→</mo><mi>B</mi><msub><mrow></mrow><mrow><mi>d</mi><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow></msub></mrow></msub><msup><mrow></mrow><mi>SSP</mi></msup></mrow><annotation encoding="application/x-tex">\pi_{p\bullet}^{\rm SSP}:V_{p\bullet}^{\rm SSP}\to B_{d_{p\bullet}}^{\rm SSP}</annotation></semantics></math><span id="S7.I5.i4.p1.1.3" class="ltx_text ltx_font_italic"> has a </span><math id="S7.I5.i4.p1.m3" class="ltx_Math" alttext="C_{\rm loc}^{1}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi>loc</mi><mn>1</mn></msubsup><annotation encoding="application/x-tex">C_{\rm loc}^{1}</annotation></semantics></math><span id="S7.I5.i4.p1.1.4" class="ltx_text ltx_font_italic"> equivariant fiberwise smooth bundle structure.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S7.SS1.SSS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Sketch of proof.</h6>
<div id="S7.SS1.SSS3.p2" class="ltx_para">
<p id="S7.SS1.SSS3.p2.1" class="ltx_p"><span id="S7.SS1.SSS3.p2.1.1" class="ltx_text">The embeddings <math id="S7.SS1.SSS3.p2.m1" class="ltx_Math" alttext="{\bm{\iota}}_{\bullet rq}^{\rm PSS}" display="inline" intent=":literal"><semantics><msubsup><mi>𝜾</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow><mi>PSS</mi></msubsup><annotation encoding="application/x-tex">{\bm{\iota}}_{\bullet rq}^{\rm PSS}</annotation></semantics></math> and <math id="S7.SS1.SSS3.p2.m2" class="ltx_math_unparsed" alttext="{\bm{\iota}}_{pr\bullet}^{\rm SSP}" display="inline" intent=":literal"><semantics><mrow><mi>𝜾</mi><msub><mrow></mrow><mrow><mi>p</mi><mi>r</mi><mo lspace="0.222em">∙</mo></mrow></msub><msup><mrow></mrow><mi>SSP</mi></msup></mrow><annotation encoding="application/x-tex">{\bm{\iota}}_{pr\bullet}^{\rm SSP}</annotation></semantics></math> are defined in a similar way as in Section <a href="#S5.SS4" title="5.4. Global chart construction III ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.4</span></a> when we embed a product of K-charts of a list of Floer moduli spaces. It is routine to check that these embeddings satisfy the listed commutative diagrams and give weak K-chart presentations of the corresponding PSS and SSP moduli spaces. Notice that for the same reason, the product Kuranishi section only matches with the boundary restriction of the larger Kuranishi chart in the <math id="S7.SS1.SSS3.p2.m3" class="ltx_Math" alttext="O" display="inline" intent=":literal"><semantics><mi>O</mi><annotation encoding="application/x-tex">O</annotation></semantics></math>-summand. We can use outer-collaring and an interpolation to match their <math id="S7.SS1.SSS3.p2.m4" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>-summand. Lastly, the projection <math id="S7.SS1.SSS3.p2.m5" class="ltx_Math" alttext="\pi_{\bullet q}^{\rm PSS}" display="inline" intent=":literal"><semantics><msubsup><mi>π</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><annotation encoding="application/x-tex">\pi_{\bullet q}^{\rm PSS}</annotation></semantics></math> and <math id="S7.SS1.SSS3.p2.m6" class="ltx_math_unparsed" alttext="\pi_{p\bullet}^{\rm SSP}" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow></msub><msup><mrow></mrow><mi>SSP</mi></msup></mrow><annotation encoding="application/x-tex">\pi_{p\bullet}^{\rm SSP}</annotation></semantics></math> have the structure of <math id="S7.SS1.SSS3.p2.m7" class="ltx_Math" alttext="C_{\rm loc}^{1}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi>loc</mi><mn>1</mn></msubsup><annotation encoding="application/x-tex">C_{\rm loc}^{1}</annotation></semantics></math> equivariant fiberwise smooth bundles for the same reason as in the case of Floer trajectories.
∎</span></p>
</div>
</div>
</section>
<section id="S7.SS1.SSS4" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">7.1.4. </span>Scaffolding</h4>

<div id="S7.SS1.SSS4.p1" class="ltx_para">
<p id="S7.SS1.SSS4.p1.1" class="ltx_p">We could state and prove a proposition similar to Proposition <a href="#S5.Thmthm64" title="Proposition 5.64. ‣ 5.8. Constructing scaffolding ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.64</span></a>. However, instead of doing the tedious thing, we only describe how the existing scaffoldings for the K-chart lift of <math id="S7.SS1.SSS4.p1.m1" class="ltx_Math" alttext="(T^{\rm Floer})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mi>Floer</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(T^{\rm Floer})^{+}</annotation></semantics></math> can be extended. Notice that we will not use any object or structure we chose in Section <a href="#S6" title="6. Smoothing ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>. Essentially (for the PSS case), we would like to choose subbundles</p>
<table id="S7.Ex47" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex47.m1" class="ltx_Math" alttext="F_{\bullet q,\alpha}^{\rm PSS}\subset O_{\bullet q}|_{V_{\alpha}^{\rm PSS}}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>F</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mrow><mi>q</mi><mo>,</mo><mi>α</mi></mrow></mrow><mi>PSS</mi></msubsup><mo>⊂</mo><msub><mrow><msub><mi>O</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow></msub><mo stretchy="false">|</mo></mrow><msubsup><mi>V</mi><mi>α</mi><mi>PSS</mi></msubsup></msub></mrow><annotation encoding="application/x-tex">F_{\bullet q,\alpha}^{\rm PSS}\subset O_{\bullet q}|_{V_{\alpha}^{\rm PSS}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS4.p1.2" class="ltx_p">and define stabilization maps</p>
<table id="S7.Ex48" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex48.m1" class="ltx_Math" alttext="{\rm Stab}_{F_{\bullet q,\alpha}}(V_{\alpha}^{\rm PSS})\to\partial^{\alpha}V_{\bullet q}^{\rm PSS}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>Stab</mi><msub><mi>F</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mrow><mi>q</mi><mo>,</mo><mi>α</mi></mrow></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>V</mi><mi>α</mi><mi>PSS</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em" stretchy="false">→</mo><mrow><msup><mo>∂</mo><mi>α</mi></msup><msubsup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">{\rm Stab}_{F_{\bullet q,\alpha}}(V_{\alpha}^{\rm PSS})\to\partial^{\alpha}V_{\bullet q}^{\rm PSS}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS4.p1.3" class="ltx_p">whose <math id="S7.SS1.SSS4.p1.m2" class="ltx_Math" alttext="G_{\bullet q}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{\bullet q}</annotation></semantics></math>-equivariantization is an open embedding. (We skip the discussion of the companion bundle isomorphisms.) This bundle <math id="S7.SS1.SSS4.p1.m3" class="ltx_Math" alttext="F_{\bullet q,\alpha}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mrow><mi>q</mi><mo>,</mo><mi>α</mi></mrow></mrow></msub><annotation encoding="application/x-tex">F_{\bullet q,\alpha}</annotation></semantics></math> is indeed the orthogonal complement of <math id="S7.SS1.SSS4.p1.m4" class="ltx_Math" alttext="E_{\alpha}^{\rm PSS}" display="inline" intent=":literal"><semantics><msubsup><mi>E</mi><mi>α</mi><mi>PSS</mi></msubsup><annotation encoding="application/x-tex">E_{\alpha}^{\rm PSS}</annotation></semantics></math> inside <math id="S7.SS1.SSS4.p1.m5" class="ltx_Math" alttext="E_{\bullet q}^{\rm PSS}" display="inline" intent=":literal"><semantics><msubsup><mi>E</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><annotation encoding="application/x-tex">E_{\bullet q}^{\rm PSS}</annotation></semantics></math>; a good choice of an inner products can be made inductively as in the proof of Proposition <a href="#S5.Thmthm64" title="Proposition 5.64. ‣ 5.8. Constructing scaffolding ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.64</span></a> which extend the inner products we have already chosen on the obstruction bundles over the thickend Floer moduli spaces. Then the stabilization map is still constructed using the implicit function theorem which depends on choosing a family of local Banach manifold charts, a family of approximate solutions, and a family of right inverses. These objects can all be extended from the existing ones we have chosen for the Floer moduli spaces. Therefore a compatible system of stabilization maps can be constructed. Of course, the collar structure is necessary for the construction.</p>
</div>
</section>
<section id="S7.SS1.SSS5" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">7.1.5. </span>Stable smoothing</h4>

<div id="S7.SS1.SSS5.p1" class="ltx_para">
<p id="S7.SS1.SSS5.p1.1" class="ltx_p">We would like to construct a system of stable equivariant smoothings of <math id="S7.SS1.SSS5.p1.m1" class="ltx_Math" alttext="V_{\bullet q}^{\rm PSS}" display="inline" intent=":literal"><semantics><msubsup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><annotation encoding="application/x-tex">V_{\bullet q}^{\rm PSS}</annotation></semantics></math> resp. <math id="S7.SS1.SSS5.p1.m2" class="ltx_math_unparsed" alttext="V_{p\bullet}^{\rm SSP}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow></msub><msup><mrow></mrow><mi>SSP</mi></msup></mrow><annotation encoding="application/x-tex">V_{p\bullet}^{\rm SSP}</annotation></semantics></math>. Notice that we have chosen stabilizations by <math id="S7.SS1.SSS5.p1.m3" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math>-representations <math id="S7.SS1.SSS5.p1.m4" class="ltx_Math" alttext="{\bm{R}}_{pq}" display="inline" intent=":literal"><semantics><msub><mi>𝑹</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">{\bm{R}}_{pq}</annotation></semantics></math> for all <math id="S7.SS1.SSS5.p1.m5" class="ltx_Math" alttext="p&lt;q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p&lt;q</annotation></semantics></math> in <math id="S7.SS1.SSS5.p1.m6" class="ltx_Math" alttext="{\mathcal{P}}^{\rm Floer}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Floer</mi></msup><annotation encoding="application/x-tex">{\mathcal{P}}^{\rm Floer}</annotation></semantics></math>. The method we used in Subsection <a href="#S6.SS4" title="6.4. Proof of Theorem ‣ 6. Smoothing ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.4</span></a> can be used again here to construct stabilizations <math id="S7.SS1.SSS5.p1.m7" class="ltx_Math" alttext="{\bm{R}}_{\bullet q}^{\rm PSS}" display="inline" intent=":literal"><semantics><msubsup><mi>𝑹</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><annotation encoding="application/x-tex">{\bm{R}}_{\bullet q}^{\rm PSS}</annotation></semantics></math> and to construct smoothings on <math id="S7.SS1.SSS5.p1.m8" class="ltx_Math" alttext="\widehat{V}_{\bullet q}^{\rm PSS}:=V_{\bullet q}^{\rm PSS}\times{\bm{R}}_{\bullet q}^{\rm PSS}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>V</mi><mo>^</mo></mover><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><mo>:=</mo><mrow><msubsup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>𝑹</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\widehat{V}_{\bullet q}^{\rm PSS}:=V_{\bullet q}^{\rm PSS}\times{\bm{R}}_{\bullet q}^{\rm PSS}</annotation></semantics></math> whose boundary is diffeomorphic to products of stabilized thickenings.</p>
</div>
<div id="S7.SS1.SSS5.p2" class="ltx_para">
<p id="S7.SS1.SSS5.p2.1" class="ltx_p">We can also require that the stabilizations satisfy the following property. Namely, there exist smooth submersive evaluation maps</p>
<table id="S7.Ex49" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex49.m1" class="ltx_Math" alttext="{\rm ev}_{\bullet}:\widehat{V}_{\bullet q}^{\rm PSS}\to M" display="block" intent=":literal"><semantics><mrow><msub><mi>ev</mi><mo>∙</mo></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mover accent="true"><mi>V</mi><mo>^</mo></mover><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><mo stretchy="false">→</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">{\rm ev}_{\bullet}:\widehat{V}_{\bullet q}^{\rm PSS}\to M</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS5.p2.2" class="ltx_p">which coincides with the original evaluation map on <math id="S7.SS1.SSS5.p2.m1" class="ltx_Math" alttext="V_{\bullet q}^{\rm PSS}" display="inline" intent=":literal"><semantics><msubsup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><annotation encoding="application/x-tex">V_{\bullet q}^{\rm PSS}</annotation></semantics></math>. Indeed, by observation of Abouzaid–McLean–Smith <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>, Lemma 4.5]</cite>, for a single smooth Kuranishi chart, on a further stabilization there exists a smooth submersive extension of the evaluation map. Then when we inductively construct stable smoothings, we can always achieve this extra condition.</p>
</div>
<div id="S7.SS1.SSS5.p3" class="ltx_para">
<p id="S7.SS1.SSS5.p3.1" class="ltx_p">It follows that by intersecting with the unstable manifolds of the given Morse function <math id="S7.SS1.SSS5.p3.m1" class="ltx_Math" alttext="f:M\to{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f:M\to{\mathbb{R}}</annotation></semantics></math>, one obtains smooth Kuranishi charts</p>
<table id="S7.Ex50" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex50.m1" class="ltx_Math" alttext="\widehat{K}_{xq}^{\rm PSS}=(G_{\bullet q}^{\rm PSS},\widehat{V}_{xq}^{\rm PSS},\widehat{E}_{xq}^{\rm PSS},\widehat{S}_{xq}^{\rm PSS})" display="block" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>K</mi><mo>^</mo></mover><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>G</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>V</mi><mo>^</mo></mover><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>E</mi><mo>^</mo></mover><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>S</mi><mo>^</mo></mover><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{K}_{xq}^{\rm PSS}=(G_{\bullet q}^{\rm PSS},\widehat{V}_{xq}^{\rm PSS},\widehat{E}_{xq}^{\rm PSS},\widehat{S}_{xq}^{\rm PSS})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS5.p3.2" class="ltx_p">where <math id="S7.SS1.SSS5.p3.m2" class="ltx_Math" alttext="\widehat{V}_{xq}^{\rm PSS}\subset\widehat{V}_{\bullet q}^{\rm PSS}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>V</mi><mo>^</mo></mover><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><mo>⊂</mo><msubsup><mover accent="true"><mi>V</mi><mo>^</mo></mover><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup></mrow><annotation encoding="application/x-tex">\widehat{V}_{xq}^{\rm PSS}\subset\widehat{V}_{\bullet q}^{\rm PSS}</annotation></semantics></math> is the intersection with the (outer-collared) compactified unstable manifold <math id="S7.SS1.SSS5.p3.m3" class="ltx_Math" alttext="\overline{W^{u}(\underline{\smash{x}})}\subset M" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mrow><msup><mi>W</mi><mi>u</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="true">¯</mo></mover><mo>⊂</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\overline{W^{u}(\underline{\smash{x}})}\subset M</annotation></semantics></math>. It is straightforward to check that we obtained a smooth K-chart lift of the flow bimodule <math id="S7.SS1.SSS5.p3.m4" class="ltx_Math" alttext="(M^{\rm PSS})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msup><mi>M</mi><mi>PSS</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(M^{\rm PSS})^{+}</annotation></semantics></math>.</p>
</div>
<div id="S7.SS1.SSS5.p4" class="ltx_para">
<p id="S7.SS1.SSS5.p4.1" class="ltx_p">Then after taking quotient, we obtained a D-chart lift of <math id="S7.SS1.SSS5.p4.m1" class="ltx_Math" alttext="(M^{\rm PSS})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msup><mi>M</mi><mi>PSS</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(M^{\rm PSS})^{+}</annotation></semantics></math> equipped with a collar structure and a scaffolding. The straightening that is compatible with the collar structure and the scaffolding can be constructed in a way similar to the case of Floer trajectories.</p>
</div>
</section>
<section id="S7.SS1.SSS6" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">7.1.6. </span>Normal complex structures and orientaions</h4>

<div id="S7.SS1.SSS6.p1" class="ltx_para">
<p id="S7.SS1.SSS6.p1.1" class="ltx_p">The construction of normal complex structure and orientation on <math id="S7.SS1.SSS6.p1.m1" class="ltx_Math" alttext="\widehat{K}_{xq}^{\rm PSS}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>K</mi><mo>^</mo></mover><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><annotation encoding="application/x-tex">\widehat{K}_{xq}^{\rm PSS}</annotation></semantics></math> essentially follows from the proof of Theorem <a href="#S6.Thmthm32" title="Theorem 6.32. ‣ 6.3. The main theorem about smoothing ‣ 6. Smoothing ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.32</span></a>. and the relevant discussions in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx1" title="" class="ltx_ref">AB21</a>, Section 11]</cite>. Two remarks should be pointed out. First, the stabilization from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>, Lemma 4.5]</cite> and the fiber product with unstable submanifolds does not affect the <em id="S7.SS1.SSS6.p1.1.1" class="ltx_emph ltx_font_italic">normal</em> complex structure, because the changes on the tangent bundles are all included in the trivial summand of the corresponding representation of the isotropy group. Second, when constructing orientation structures, the virtual vector bundle associated with an object <math id="S7.SS1.SSS6.p1.m2" class="ltx_Math" alttext="x\in T^{\rm Morse}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msup><mi>T</mi><mi>Morse</mi></msup></mrow><annotation encoding="application/x-tex">x\in T^{\rm Morse}</annotation></semantics></math> is defined by <math id="S7.SS1.SSS6.p1.m3" class="ltx_Math" alttext="(TW^{u}(\underline{\smash{x}}),0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>W</mi><mi>u</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(TW^{u}(\underline{\smash{x}}),0)</annotation></semantics></math>.</p>
</div>
</section>
</section>
<section id="S7.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">7.2. </span>Pearly bimodule</h3>

<div id="S7.SS2.p1" class="ltx_para">
<p id="S7.SS2.p1.1" class="ltx_p">Consider the pearly bimodule defined in Section <a href="#S4" title="4. Proof of the integral Arnold conjecture ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>. Here we describe a K-chart lift of it and show how to use the same argument to construct a stable smoothing. First, for each <math id="S7.SS2.p1.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>, consider an auxiliary moduli space which is similar to <math id="S7.SS2.p1.m2" class="ltx_Math" alttext="B_{d}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>d</mi></msub><annotation encoding="application/x-tex">B_{d}</annotation></semantics></math>, <math id="S7.SS2.p1.m3" class="ltx_Math" alttext="B_{d}^{\rm PSS}" display="inline" intent=":literal"><semantics><msubsup><mi>B</mi><mi>d</mi><mi>PSS</mi></msubsup><annotation encoding="application/x-tex">B_{d}^{\rm PSS}</annotation></semantics></math>, and <math id="S7.SS2.p1.m4" class="ltx_Math" alttext="B_{d}^{\rm SSP}" display="inline" intent=":literal"><semantics><msubsup><mi>B</mi><mi>d</mi><mi>SSP</mi></msubsup><annotation encoding="application/x-tex">B_{d}^{\rm SSP}</annotation></semantics></math> defined before. Indeed, let <math id="S7.SS2.p1.m5" class="ltx_Math" alttext="{\mathcal{F}}_{0,2}^{\rm pearl}(d)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mi>pearl</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{0,2}^{\rm pearl}(d)</annotation></semantics></math> be the moduli space of parametrized 2-marked holomorphic spheres into <math id="S7.SS2.p1.m6" class="ltx_Math" alttext="\mathbb{CP}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathbb{CP}^{d}</annotation></semantics></math> which have degree <math id="S7.SS2.p1.m7" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> and whose images are not entirely contained in a hyperplane. In particular, each point of <math id="S7.SS2.p1.m8" class="ltx_Math" alttext="{\mathcal{F}}_{0,2}^{\rm pearl}(d)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mi>pearl</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{0,2}^{\rm pearl}(d)</annotation></semantics></math> is represented by a stable map with 2 marked points that have a distinguished component whose parametrization is fixed. <math id="S7.SS2.p1.m9" class="ltx_Math" alttext="{\mathcal{F}}_{0,2}^{\rm pearl}(d)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mi>pearl</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{0,2}^{\rm pearl}(d)</annotation></semantics></math> is a smooth manifold (with no boundary or corners). Moreover there are holomorphic submersions</p>
<table id="S7.Ex51" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex51.m1" class="ltx_Math" alttext="{\rm ev}_{\pm}:{\mathcal{F}}_{0,2}^{\rm pearl}(d)\to\mathbb{CP}^{d}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ev</mi><mo>±</mo></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mi>pearl</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\rm ev}_{\pm}:{\mathcal{F}}_{0,2}^{\rm pearl}(d)\to\mathbb{CP}^{d}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.p1.2" class="ltx_p">Let</p>
<table id="S7.Ex52" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex52.m1" class="ltx_Math" alttext="B_{d}^{\rm pearl}\subset{\mathcal{F}}_{0,2}^{\rm pearl}(d)" display="block" intent=":literal"><semantics><mrow><msubsup><mi>B</mi><mi>d</mi><mi>pearl</mi></msubsup><mo>⊂</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mi>pearl</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">B_{d}^{\rm pearl}\subset{\mathcal{F}}_{0,2}^{\rm pearl}(d)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.p1.3" class="ltx_p">be the subset of elements whose evaluation at <math id="S7.SS2.p1.m10" class="ltx_Math" alttext="z_{-}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mo>−</mo></msub><annotation encoding="application/x-tex">z_{-}</annotation></semantics></math> is <math id="S7.SS2.p1.m11" class="ltx_Math" alttext="[1,0,\ldots,0]\in\mathbb{CP}^{d}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn></mrow><mo stretchy="false">]</mo></mrow><mo>∈</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">[1,0,\ldots,0]\in\mathbb{CP}^{d}</annotation></semantics></math>. Then <math id="S7.SS2.p1.m12" class="ltx_Math" alttext="B_{d}^{\rm pearl}" display="inline" intent=":literal"><semantics><msubsup><mi>B</mi><mi>d</mi><mi>pearl</mi></msubsup><annotation encoding="application/x-tex">B_{d}^{\rm pearl}</annotation></semantics></math> is a smooth manifold. There is a <math id="S7.SS2.p1.m13" class="ltx_Math" alttext="G_{d}\cong U(d)" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mi>d</mi></msub><mo>≅</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">G_{d}\cong U(d)</annotation></semantics></math>-action on <math id="S7.SS2.p1.m14" class="ltx_Math" alttext="B_{d}^{\rm pearl}" display="inline" intent=":literal"><semantics><msubsup><mi>B</mi><mi>d</mi><mi>pearl</mi></msubsup><annotation encoding="application/x-tex">B_{d}^{\rm pearl}</annotation></semantics></math>.</p>
</div>
<div id="S7.SS2.p2" class="ltx_para">
<p id="S7.SS2.p2.1" class="ltx_p">Now consider the corresponding space <math id="S7.SS2.p2.m1" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{\bullet\bullet}^{\rm pearl}(d)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mrow></mrow><mi>pearl</mi><mprescripts></mprescripts><mrow><mo>∙</mo><mo lspace="0em">⁣</mo><mo>∙</mo></mrow><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{\bullet\bullet}^{\rm pearl}(d)</annotation></semantics></math> of stable parametrized holomorphic spheres in <math id="S7.SS2.p2.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> whose degree is <math id="S7.SS2.p2.m3" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>. Using multi-layered thickening associated to a sequence of integers <math id="S7.SS2.p2.m4" class="ltx_Math" alttext="k_{1}&lt;k_{2}&lt;\cdots&lt;k_{d}&lt;\cdots" display="inline" intent=":literal"><semantics><mrow><msub><mi>k</mi><mn>1</mn></msub><mo>&lt;</mo><msub><mi>k</mi><mn>2</mn></msub><mo rspace="0.1389em">&lt;</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">&lt;</mo><msub><mi>k</mi><mi>d</mi></msub><mo rspace="0.1389em">&lt;</mo><mo lspace="0.1389em">⋯</mo></mrow><annotation encoding="application/x-tex">k_{1}&lt;k_{2}&lt;\cdots&lt;k_{d}&lt;\cdots</annotation></semantics></math> one can produce a similar thickened moduli space</p>
<table id="S7.Ex53" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex53.m1" class="ltx_Math" alttext="K_{\bullet\bullet}^{\rm pearl}(d)=(G_{d},V_{\bullet\bullet}^{\rm pearl}(d),E_{\bullet\bullet}^{\rm pearl}(d),S_{\bullet\bullet}^{\rm pearl})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>K</mi><mrow><mo>∙</mo><mo lspace="0em">⁣</mo><mo>∙</mo></mrow><mi>pearl</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>d</mi></msub><mo>,</mo><mrow><msubsup><mi>V</mi><mrow><mo>∙</mo><mo lspace="0em">⁣</mo><mo>∙</mo></mrow><mi>pearl</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi>E</mi><mrow><mo>∙</mo><mo lspace="0em">⁣</mo><mo>∙</mo></mrow><mi>pearl</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msubsup><mi>S</mi><mrow><mo>∙</mo><mo lspace="0em">⁣</mo><mo>∙</mo></mrow><mi>pearl</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">K_{\bullet\bullet}^{\rm pearl}(d)=(G_{d},V_{\bullet\bullet}^{\rm pearl}(d),E_{\bullet\bullet}^{\rm pearl}(d),S_{\bullet\bullet}^{\rm pearl}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.p2.2" class="ltx_p">The domain <math id="S7.SS2.p2.m5" class="ltx_Math" alttext="V_{\bullet\bullet}^{\rm pearl}(d)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>V</mi><mrow><mo>∙</mo><mo lspace="0em">⁣</mo><mo>∙</mo></mrow><mi>pearl</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V_{\bullet\bullet}^{\rm pearl}(d)</annotation></semantics></math> admits a <math id="S7.SS2.p2.m6" class="ltx_Math" alttext="G_{d}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>d</mi></msub><annotation encoding="application/x-tex">G_{d}</annotation></semantics></math>-action and an equivariant projection map</p>
<table id="S7.Ex54" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex54.m1" class="ltx_Math" alttext="\pi_{\bullet\bullet}^{\rm pearl}:V_{\bullet\bullet}^{\rm pearl}(d)\to B_{d}^{\rm pearl}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>π</mi><mrow><mo>∙</mo><mo lspace="0em">⁣</mo><mo>∙</mo></mrow><mi>pearl</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mi>V</mi><mrow><mo>∙</mo><mo lspace="0em">⁣</mo><mo>∙</mo></mrow><mi>pearl</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><msubsup><mi>B</mi><mi>d</mi><mi>pearl</mi></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\pi_{\bullet\bullet}^{\rm pearl}:V_{\bullet\bullet}^{\rm pearl}(d)\to B_{d}^{\rm pearl}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.p2.3" class="ltx_p">Moreover, by taking intersections with stable and unstable submanifolds of the Morse function <math id="S7.SS2.p2.m7" class="ltx_Math" alttext="f:M\to{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f:M\to{\mathbb{R}}</annotation></semantics></math>, one obtains stratified charts</p>
<table id="S7.Ex55" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex55.m1" class="ltx_Math" alttext="K_{xy}^{\rm pearl}=(G_{xy},V_{xy}^{\rm pearl},E_{xy}^{\rm pearl},S_{xy}^{\rm pearl})" display="block" intent=":literal"><semantics><mrow><msubsup><mi>K</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>pearl</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub><mo>,</mo><msubsup><mi>V</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>pearl</mi></msubsup><mo>,</mo><msubsup><mi>E</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>pearl</mi></msubsup><mo>,</mo><msubsup><mi>S</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>pearl</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K_{xy}^{\rm pearl}=(G_{xy},V_{xy}^{\rm pearl},E_{xy}^{\rm pearl},S_{xy}^{\rm pearl})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.p2.4" class="ltx_p">This collection of charts obviously defines a K-chart lift of the pearly bimodule <math id="S7.SS2.p2.m8" class="ltx_Math" alttext="M^{\rm pearl}" display="inline" intent=":literal"><semantics><msup><mi>M</mi><mi>pearl</mi></msup><annotation encoding="application/x-tex">M^{\rm pearl}</annotation></semantics></math>.</p>
</div>
<div id="S7.Thmthm7" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm7.2" class="ltx_text ltx_font_bold">Theorem 7.7</span></span><span id="S7.Thmthm7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm7.p1" class="ltx_para">
<p id="S7.Thmthm7.p1.1" class="ltx_p"><span id="S7.Thmthm7.p1.1.1" class="ltx_text ltx_font_italic">There exists a “single-layered” normally complex derived orbifold lift of the outer-collared pearly bimodule <math id="S7.Thmthm7.p1.m1" class="ltx_Math" alttext="(M^{\rm pearl})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msup><mi>M</mi><mi>pearl</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(M^{\rm pearl})^{+}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S7.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Sketch of Proof.</h6>
<div id="S7.SS2.p3" class="ltx_para">
<p id="S7.SS2.p3.1" class="ltx_p"><span id="S7.SS2.p3.1.1" class="ltx_text">We can construct stable smoothings of <math id="S7.SS2.p3.m1" class="ltx_Math" alttext="K_{\bullet\bullet}^{\rm pearl}(d)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>K</mi><mrow><mo>∙</mo><mo lspace="0em">⁣</mo><mo>∙</mo></mrow><mi>pearl</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K_{\bullet\bullet}^{\rm pearl}(d)</annotation></semantics></math> individualy for each <math id="S7.SS2.p3.m2" class="ltx_Math" alttext="d\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d\geq 1</annotation></semantics></math> to obtain smooth Kuranishi charts. To save notations, still denote them by <math id="S7.SS2.p3.m3" class="ltx_Math" alttext="K_{\bullet\bullet}^{\rm pearl}(d)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>K</mi><mrow><mo>∙</mo><mo lspace="0em">⁣</mo><mo>∙</mo></mrow><mi>pearl</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K_{\bullet\bullet}^{\rm pearl}(d)</annotation></semantics></math>. We can do a further stabilization such that the evaluations at <math id="S7.SS2.p3.m4" class="ltx_Math" alttext="z_{\pm}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mo>±</mo></msub><annotation encoding="application/x-tex">z_{\pm}</annotation></semantics></math> are smooth submersions onto <math id="S7.SS2.p3.m5" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>. Hence each <math id="S7.SS2.p3.m6" class="ltx_Math" alttext="K_{xy}^{\rm pearl}" display="inline" intent=":literal"><semantics><msubsup><mi>K</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>pearl</mi></msubsup><annotation encoding="application/x-tex">K_{xy}^{\rm pearl}</annotation></semantics></math> becomes smooth stratified Kuranishi charts. Its outer-collaring is again smooth Kuranishi charts. The scaffoldings are trivial as the Morse theory part is already regular. Then taking quotient by <math id="S7.SS2.p3.m7" class="ltx_Math" alttext="G_{xy}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub><annotation encoding="application/x-tex">G_{xy}</annotation></semantics></math> one obtains a D-chart lift of <math id="S7.SS2.p3.m8" class="ltx_Math" alttext="(M^{\rm pearl})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msup><mi>M</mi><mi>pearl</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(M^{\rm pearl})^{+}</annotation></semantics></math>, denoted by <math id="S7.SS2.p3.m9" class="ltx_Math" alttext="({\mathfrak{D}}^{\rm pearl})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝔇</mi><mi>pearl</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">({\mathfrak{D}}^{\rm pearl})^{+}</annotation></semantics></math>. As the scaffolding is trivial, this is a single-layered lift. Lastly, there is a normal complex structure and an orientation on <math id="S7.SS2.p3.m10" class="ltx_Math" alttext="({\mathfrak{D}}^{\rm pearl})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝔇</mi><mi>pearl</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">({\mathfrak{D}}^{\rm pearl})^{+}</annotation></semantics></math> for the same reason as the case of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>]</cite>.
∎</span></p>
</div>
</div>
</section>
<section id="S7.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">7.3. </span>The homotopy</h3>

<div id="S7.SS3.p1" class="ltx_para">
<p id="S7.SS3.p1.1" class="ltx_p">Lastly, we explain the collection of D-chart lifts of the system of moduli spaces referred to as the “homotopy moduli spaces.” Although this <span id="S7.SS3.p1.1.1" class="ltx_text ltx_font_italic">ad hoc</span> collection lacks a formal package, the constructions are almost identical to previous cases. The global chart construction, including the multi-layered strategy, is the same as the case of Floer trajectories or PSS/SSP cases. Then one obtains a weak K-chart lift of the collection of moduli spaces. By taking outer-collaring and interpolating between the product Kuranishi section and the boundary restriction of Kuranishi sections, one obtains a K-chart lift of the outer-collared system. The construction of scaffolding (see Proposition <a href="#S5.Thmthm64" title="Proposition 5.64. ‣ 5.8. Constructing scaffolding ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.64</span></a>) has completely the same induction procedure. We can also run the smoothing procedure without essential differences.</p>
</div>
</section>
</section>
<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Product of canonical Whitney stratifications</h2>

<section id="A1.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.1. </span>Basics of Whitney stratifications</h3>

<div id="A1.SS1.p1" class="ltx_para">
<p id="A1.SS1.p1.1" class="ltx_p">We review the basic notions of (Whitney) prestratifications and stratification. Following Mather <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx27" title="" class="ltx_ref">Mat73</a>]</cite>, our convention is the same as our previous work <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx6" title="" class="ltx_ref">BX22</a>]</cite>.</p>
</div>
<div id="A1.Thmthm1" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmthm1.2" class="ltx_text ltx_font_bold">Definition A.1</span></span><span id="A1.Thmthm1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmthm1.p1" class="ltx_para">
<p id="A1.Thmthm1.p1.1" class="ltx_p">Let <math id="A1.Thmthm1.p1.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> be a topological space. A <span id="A1.Thmthm1.p1.1.1" class="ltx_text ltx_font_bold">prestratification</span> on <math id="A1.Thmthm1.p1.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is a decomposition</p>
<table id="A1.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex1.m1" class="ltx_Math" alttext="S=\bigsqcup_{\alpha\in{\mathfrak{A}}}S_{\alpha}" display="block" intent=":literal"><semantics><mrow><mi>S</mi><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">⨆</mo><mrow><mi>α</mi><mo>∈</mo><mi>𝔄</mi></mrow></munder><msub><mi>S</mi><mi>α</mi></msub></mrow></mrow><annotation encoding="application/x-tex">S=\bigsqcup_{\alpha\in{\mathfrak{A}}}S_{\alpha}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.Thmthm1.p1.2" class="ltx_p">of <math id="A1.Thmthm1.p1.m3" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> into the disjoint union of locally closed subsets satisfying the following condition</p>
<ol id="A1.I1" class="ltx_enumerate">
<li id="A1.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="A1.I1.i1.p1" class="ltx_para">
<p id="A1.I1.i1.p1.1" class="ltx_p">The decomposition is locally finite.</p>
</div></li>
<li id="A1.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="A1.I1.i2.p1" class="ltx_para">
<p id="A1.I1.i2.p1.1" class="ltx_p">(Axiom of frontier) If <math id="A1.I1.i2.p1.m1" class="ltx_Math" alttext="\alpha,\beta\in{\mathfrak{A}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo>,</mo><mi>β</mi></mrow><mo>∈</mo><mi>𝔄</mi></mrow><annotation encoding="application/x-tex">\alpha,\beta\in{\mathfrak{A}}</annotation></semantics></math>, <math id="A1.I1.i2.p1.m2" class="ltx_Math" alttext="S_{\alpha}\cap\overline{S_{\beta}}\neq\emptyset" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>S</mi><mi>α</mi></msub><mo>∩</mo><mover accent="true"><msub><mi>S</mi><mi>β</mi></msub><mo stretchy="true">¯</mo></mover></mrow><mo>≠</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">S_{\alpha}\cap\overline{S_{\beta}}\neq\emptyset</annotation></semantics></math>, then <math id="A1.I1.i2.p1.m3" class="ltx_Math" alttext="S_{\alpha}\subset\overline{S_{\beta}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>α</mi></msub><mo>⊂</mo><mover accent="true"><msub><mi>S</mi><mi>β</mi></msub><mo stretchy="true">¯</mo></mover></mrow><annotation encoding="application/x-tex">S_{\alpha}\subset\overline{S_{\beta}}</annotation></semantics></math>.</p>
</div></li>
</ol>
<p id="A1.Thmthm1.p1.3" class="ltx_p">Each <math id="A1.Thmthm1.p1.m4" class="ltx_Math" alttext="S_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>α</mi></msub><annotation encoding="application/x-tex">S_{\alpha}</annotation></semantics></math> is called a <span id="A1.Thmthm1.p1.3.1" class="ltx_text ltx_font_bold">stratum</span> of the prestratification. The axiom of frontier induces a partial order among strata: <math id="A1.Thmthm1.p1.m5" class="ltx_Math" alttext="S_{\alpha}\leq S_{\beta}" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>α</mi></msub><mo>≤</mo><msub><mi>S</mi><mi>β</mi></msub></mrow><annotation encoding="application/x-tex">S_{\alpha}\leq S_{\beta}</annotation></semantics></math> if <math id="A1.Thmthm1.p1.m6" class="ltx_Math" alttext="S_{\alpha}\subset\overline{S_{\beta}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>α</mi></msub><mo>⊂</mo><mover accent="true"><msub><mi>S</mi><mi>β</mi></msub><mo stretchy="true">¯</mo></mover></mrow><annotation encoding="application/x-tex">S_{\alpha}\subset\overline{S_{\beta}}</annotation></semantics></math>. We use the symbol <math id="A1.Thmthm1.p1.m7" class="ltx_Math" alttext="{\mathfrak{A}}" display="inline" intent=":literal"><semantics><mi>𝔄</mi><annotation encoding="application/x-tex">{\mathfrak{A}}</annotation></semantics></math> to denote the prestratification as well as the partially ordered set of strata. A space equipped with a prestratification <math id="A1.Thmthm1.p1.m8" class="ltx_Math" alttext="{\mathfrak{A}}" display="inline" intent=":literal"><semantics><mi>𝔄</mi><annotation encoding="application/x-tex">{\mathfrak{A}}</annotation></semantics></math> is called an <math id="A1.Thmthm1.p1.m9" class="ltx_Math" alttext="{\mathfrak{A}}" display="inline" intent=":literal"><semantics><mi>𝔄</mi><annotation encoding="application/x-tex">{\mathfrak{A}}</annotation></semantics></math>-stratified space.</p>
</div>
</div>
<div id="A1.SS1.p2" class="ltx_para">
<p id="A1.SS1.p2.1" class="ltx_p">Now we consider the notion of stratifications. Two subsets <math id="A1.SS1.p2.m1" class="ltx_Math" alttext="A,B\subseteq M" display="inline" intent=":literal"><semantics><mrow><mrow><mi>A</mi><mo>,</mo><mi>B</mi></mrow><mo>⊆</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">A,B\subseteq M</annotation></semantics></math> are called <span id="A1.SS1.p2.1.1" class="ltx_text ltx_font_bold">equivalent</span> at <math id="A1.SS1.p2.m2" class="ltx_Math" alttext="x\in M" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">x\in M</annotation></semantics></math> if there exists an open neighborhood <math id="A1.SS1.p2.m3" class="ltx_Math" alttext="U_{x}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mi>x</mi></msub><annotation encoding="application/x-tex">U_{x}</annotation></semantics></math> of <math id="A1.SS1.p2.m4" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> such that <math id="A1.SS1.p2.m5" class="ltx_Math" alttext="A\cap U_{x}=B\cap U_{x}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>A</mi><mo>∩</mo><msub><mi>U</mi><mi>x</mi></msub></mrow><mo>=</mo><mrow><mi>B</mi><mo>∩</mo><msub><mi>U</mi><mi>x</mi></msub></mrow></mrow><annotation encoding="application/x-tex">A\cap U_{x}=B\cap U_{x}</annotation></semantics></math>. An equivalence class is called a <span id="A1.SS1.p2.1.2" class="ltx_text ltx_font_bold">setgerm</span> at <math id="A1.SS1.p2.m6" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>. Given a prestratification <math id="A1.SS1.p2.m7" class="ltx_Math" alttext="{\mathcal{A}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒜</mi><annotation encoding="application/x-tex">{\mathcal{A}}</annotation></semantics></math> on <math id="A1.SS1.p2.m8" class="ltx_Math" alttext="S\subseteq M" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⊆</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">S\subseteq M</annotation></semantics></math>, it assigns to each <math id="A1.SS1.p2.m9" class="ltx_Math" alttext="x\in S" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">x\in S</annotation></semantics></math> a setgerm represented by the unique stratum that contains <math id="A1.SS1.p2.m10" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>. A <span id="A1.SS1.p2.1.3" class="ltx_text ltx_font_bold">stratification</span> of a subset <math id="A1.SS1.p2.m11" class="ltx_Math" alttext="S\subset M" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⊂</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">S\subset M</annotation></semantics></math> is a rule which assigns to each point <math id="A1.SS1.p2.m12" class="ltx_Math" alttext="x\in S" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">x\in S</annotation></semantics></math> a set-germ <math id="A1.SS1.p2.m13" class="ltx_Math" alttext="S_{x}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>x</mi></msub><annotation encoding="application/x-tex">S_{x}</annotation></semantics></math>, such that for each <math id="A1.SS1.p2.m14" class="ltx_Math" alttext="x\in S" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">x\in S</annotation></semantics></math>, there is an open neighborhood <math id="A1.SS1.p2.m15" class="ltx_Math" alttext="U_{x}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mi>x</mi></msub><annotation encoding="application/x-tex">U_{x}</annotation></semantics></math> of <math id="A1.SS1.p2.m16" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> and a prestratification of <math id="A1.SS1.p2.m17" class="ltx_Math" alttext="U_{x}\cap S" display="inline" intent=":literal"><semantics><mrow><msub><mi>U</mi><mi>x</mi></msub><mo>∩</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">U_{x}\cap S</annotation></semantics></math> such that the setgerm-valued function restricted to <math id="A1.SS1.p2.m18" class="ltx_Math" alttext="U_{x}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mi>x</mi></msub><annotation encoding="application/x-tex">U_{x}</annotation></semantics></math> is induced from this prestratification.</p>
</div>
<div id="A1.Thmthm2" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmthm2.2" class="ltx_text ltx_font_bold">Definition A.2</span></span><span id="A1.Thmthm2.3" class="ltx_text ltx_font_bold"> </span>(Whitney stratification)<span id="A1.Thmthm2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmthm2.p1" class="ltx_para">
<p id="A1.Thmthm2.p1.1" class="ltx_p">Let <math id="A1.Thmthm2.p1.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> be a smooth manifold.</p>
<ol id="A1.I2" class="ltx_enumerate">
<li id="A1.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="A1.I2.i1.p1" class="ltx_para">
<p id="A1.I2.i1.p1.1" class="ltx_p">Given two disjoint smooth submanifolds <math id="A1.I2.i1.p1.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>, <math id="A1.I2.i1.p1.m2" class="ltx_Math" alttext="S^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mo>′</mo></msup><annotation encoding="application/x-tex">S^{\prime}</annotation></semantics></math>, we say that the pair <math id="A1.I2.i1.p1.m3" class="ltx_Math" alttext="(S,S^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><msup><mi>S</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(S,S^{\prime})</annotation></semantics></math> satisfies <span id="A1.I2.i1.p1.1.1" class="ltx_text ltx_font_bold">Whitney’s condition (b)</span> at <math id="A1.I2.i1.p1.m4" class="ltx_Math" alttext="x\in S^{\prime}\cap\overline{S}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><msup><mi>S</mi><mo>′</mo></msup><mo>∩</mo><mover accent="true"><mi>S</mi><mo stretchy="true">¯</mo></mover></mrow></mrow><annotation encoding="application/x-tex">x\in S^{\prime}\cap\overline{S}</annotation></semantics></math> if the following is true: suppose <math id="A1.I2.i1.p1.m5" class="ltx_Math" alttext="x_{i}\in S" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>i</mi></msub><mo>∈</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">x_{i}\in S</annotation></semantics></math>, <math id="A1.I2.i1.p1.m6" class="ltx_Math" alttext="x_{i}^{\prime}\in S^{\prime}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>x</mi><mi>i</mi><mo>′</mo></msubsup><mo>∈</mo><msup><mi>S</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">x_{i}^{\prime}\in S^{\prime}</annotation></semantics></math> are two sequences converging to <math id="A1.I2.i1.p1.m7" class="ltx_Math" alttext="x\in\overline{S}\cap S^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><mover accent="true"><mi>S</mi><mo stretchy="true">¯</mo></mover><mo>∩</mo><msup><mi>S</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">x\in\overline{S}\cap S^{\prime}</annotation></semantics></math>. Suppose the sequence of tangent spaces <math id="A1.I2.i1.p1.m8" class="ltx_Math" alttext="T_{x_{i}}S" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><msub><mi>x</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">T_{x_{i}}S</annotation></semantics></math> converges to a subspace <math id="A1.I2.i1.p1.m9" class="ltx_Math" alttext="H\subset T_{x}M" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>⊂</mo><mrow><msub><mi>T</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">H\subset T_{x}M</annotation></semantics></math> and the sequence of secant lines <math id="A1.I2.i1.p1.m10" class="ltx_Math" alttext="\overline{x_{i}x_{i}^{\prime}}" display="inline" intent=":literal"><semantics><mover accent="true"><mrow><msub><mi>x</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mi>i</mi><mo>′</mo></msubsup></mrow><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{x_{i}x_{i}^{\prime}}</annotation></semantics></math> converges to a line <math id="A1.I2.i1.p1.m11" class="ltx_Math" alttext="L\subset T_{x}M" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mrow><msub><mi>T</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">L\subset T_{x}M</annotation></semantics></math>, then <math id="A1.I2.i1.p1.m12" class="ltx_Math" alttext="L\subset H" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊂</mo><mi>H</mi></mrow><annotation encoding="application/x-tex">L\subset H</annotation></semantics></math>.</p>
</div></li>
<li id="A1.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="A1.I2.i2.p1" class="ltx_para">
<p id="A1.I2.i2.p1.1" class="ltx_p">Let <math id="A1.I2.i2.p1.m1" class="ltx_Math" alttext="S\subset M" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⊂</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">S\subset M</annotation></semantics></math> be a subset. A prestratification on <math id="A1.I2.i2.p1.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is called a <span id="A1.I2.i2.p1.1.1" class="ltx_text ltx_font_bold">Whitney prestratification</span> if each stratum <math id="A1.I2.i2.p1.m3" class="ltx_Math" alttext="S_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>α</mi></msub><annotation encoding="application/x-tex">S_{\alpha}</annotation></semantics></math> is a smooth submanifold and each pair <math id="A1.I2.i2.p1.m4" class="ltx_Math" alttext="(S_{\alpha},S_{\beta})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>α</mi></msub><mo>,</mo><msub><mi>S</mi><mi>β</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(S_{\alpha},S_{\beta})</annotation></semantics></math> of strata with <math id="A1.I2.i2.p1.m5" class="ltx_Math" alttext="S_{\beta}\subsetneq\overline{S_{\alpha}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>β</mi></msub><mo>⊊</mo><mover accent="true"><msub><mi>S</mi><mi>α</mi></msub><mo stretchy="true">¯</mo></mover></mrow><annotation encoding="application/x-tex">S_{\beta}\subsetneq\overline{S_{\alpha}}</annotation></semantics></math> satisfies Whitney’s condition (b) at every point of <math id="A1.I2.i2.p1.m6" class="ltx_Math" alttext="S_{\beta}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>β</mi></msub><annotation encoding="application/x-tex">S_{\beta}</annotation></semantics></math>.</p>
</div></li>
<li id="A1.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="A1.I2.i3.p1" class="ltx_para">
<p id="A1.I2.i3.p1.1" class="ltx_p">A stratification on <math id="A1.I2.i3.p1.m1" class="ltx_Math" alttext="S\subset M" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⊂</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">S\subset M</annotation></semantics></math> is called a <span id="A1.I2.i3.p1.1.1" class="ltx_text ltx_font_bold">Whitney stratification</span> if for each point <math id="A1.I2.i3.p1.m2" class="ltx_Math" alttext="x\in S" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">x\in S</annotation></semantics></math> there exists an open neighborhood <math id="A1.I2.i3.p1.m3" class="ltx_Math" alttext="U_{x}\subset S" display="inline" intent=":literal"><semantics><mrow><msub><mi>U</mi><mi>x</mi></msub><mo>⊂</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">U_{x}\subset S</annotation></semantics></math> of <math id="A1.I2.i3.p1.m4" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> and a Whitney prestratification on <math id="A1.I2.i3.p1.m5" class="ltx_Math" alttext="U_{x}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mi>x</mi></msub><annotation encoding="application/x-tex">U_{x}</annotation></semantics></math> which induces this stratification inside <math id="A1.I2.i3.p1.m6" class="ltx_Math" alttext="U_{x}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mi>x</mi></msub><annotation encoding="application/x-tex">U_{x}</annotation></semantics></math>. We use the symbol <math id="A1.I2.i3.p1.m7" class="ltx_Math" alttext="{\mathcal{S}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">{\mathcal{S}}</annotation></semantics></math> to denote a Whitney stratification on <math id="A1.I2.i3.p1.m8" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>, which is a setgerm-valued function on <math id="A1.I2.i3.p1.m9" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
</div>
<div id="A1.SS1.p3" class="ltx_para">
<p id="A1.SS1.p3.1" class="ltx_p">On the same set there could be many different Whitney stratifications. One can use a partial order among them to compare. Suppose <math id="A1.SS1.p3.m1" class="ltx_Math" alttext="{\mathcal{S}}_{1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\mathcal{S}}_{1}</annotation></semantics></math> and <math id="A1.SS1.p3.m2" class="ltx_Math" alttext="{\mathcal{S}}_{2}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mn>2</mn></msub><annotation encoding="application/x-tex">{\mathcal{S}}_{2}</annotation></semantics></math> are two Whitney stratifications, which assign to each <math id="A1.SS1.p3.m3" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> setgerms <math id="A1.SS1.p3.m4" class="ltx_Math" alttext="S_{1,x}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mrow><mn>1</mn><mo>,</mo><mi>x</mi></mrow></msub><annotation encoding="application/x-tex">S_{1,x}</annotation></semantics></math> and <math id="A1.SS1.p3.m5" class="ltx_Math" alttext="S_{2,x}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mrow><mn>2</mn><mo>,</mo><mi>x</mi></mrow></msub><annotation encoding="application/x-tex">S_{2,x}</annotation></semantics></math> respectively. Then define</p>
<table id="A1.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex2.m1" class="ltx_math_unparsed" alttext="S_{i}^{(k)}=\{x\in S\ |\ {\rm dim}_{\mathbb{R}}S_{i,x}\leq k\},\ i=1,2." display="block" intent=":literal"><semantics><mrow><msubsup><mi>S</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>x</mi><mo>∈</mo><mi>S</mi><mo lspace="0.500em" rspace="0.500em">|</mo><msub><mi>dim</mi><mi>ℝ</mi></msub><msub><mi>S</mi><mrow><mi>i</mi><mo>,</mo><mi>x</mi></mrow></msub><mo>≤</mo><mi>k</mi><mo stretchy="false">}</mo></mrow><mo rspace="0.667em">,</mo><mi>i</mi><mo>=</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">S_{i}^{(k)}=\{x\in S\ |\ {\rm dim}_{\mathbb{R}}S_{i,x}\leq k\},\ i=1,2.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p3.2" class="ltx_p">Then one has descending sequence of closed sets</p>
<table id="A1.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex3.m1" class="ltx_Math" alttext="S_{i}=S_{i}^{(m)}\supseteq S_{i}^{(m-1)}\supseteq\cdots\supseteq S_{i}^{(0)}" display="block" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><msubsup><mi>S</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>⊇</mo><msubsup><mi>S</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.1389em">⊇</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">⊇</mo><msubsup><mi>S</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">S_{i}=S_{i}^{(m)}\supseteq S_{i}^{(m-1)}\supseteq\cdots\supseteq S_{i}^{(0)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p3.3" class="ltx_p">where <math id="A1.SS1.p3.m6" class="ltx_Math" alttext="m={\rm dim}_{\mathbb{R}}M" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>=</mo><mrow><msub><mi>dim</mi><mi>ℝ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">m={\rm dim}_{\mathbb{R}}M</annotation></semantics></math>.</p>
</div>
<div id="A1.Thmthm3" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmthm3.2" class="ltx_text ltx_font_bold">Definition A.3</span></span><span id="A1.Thmthm3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmthm3.p1" class="ltx_para">
<p id="A1.Thmthm3.p1.1" class="ltx_p"><math id="A1.Thmthm3.p1.m1" class="ltx_Math" alttext="{\mathcal{S}}_{1}&lt;{\mathcal{S}}_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mn>1</mn></msub><mo>&lt;</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">{\mathcal{S}}_{1}&lt;{\mathcal{S}}_{2}</annotation></semantics></math> if there exists an integer <math id="A1.Thmthm3.p1.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> such that</p>
<table id="A1.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex4.m1" class="ltx_Math" alttext="S_{1}^{(l)}=S_{2}^{(l)}\ \forall l&gt;k\ {\rm and}\ S_{1}^{(k)}\subsetneq S_{2}^{(k)}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>S</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><msubsup><mi>S</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mo rspace="0.167em">∀</mo><mi>l</mi></mrow></mrow><mo>&gt;</mo><mrow><mi>k</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>and</mi><mo lspace="0.500em" rspace="0em">​</mo><msubsup><mi>S</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>⊊</mo><msubsup><mi>S</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">S_{1}^{(l)}=S_{2}^{(l)}\ \forall l&gt;k\ {\rm and}\ S_{1}^{(k)}\subsetneq S_{2}^{(k)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A1.SS1.p4" class="ltx_para">
<p id="A1.SS1.p4.1" class="ltx_p">If a Whitney stratification is minimal, then it is unique. Moreover, a minimal Whitney stratification on <math id="A1.SS1.p4.m1" class="ltx_Math" alttext="S\subseteq M" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⊆</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">S\subseteq M</annotation></semantics></math> is invariant under diffeomorphisms of <math id="A1.SS1.p4.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> which preserve <math id="A1.SS1.p4.m3" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> set-wise (see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx6" title="" class="ltx_ref">BX22</a>, Lemma A.11]</cite>).</p>
</div>
<div id="A1.Thmthm4" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmthm4.2" class="ltx_text ltx_font_bold">Theorem A.4</span></span><span id="A1.Thmthm4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmthm4.p1" class="ltx_para">
<p id="A1.Thmthm4.p1.1" class="ltx_p"><cite class="ltx_cite ltx_citemacro_cite"><span id="A1.Thmthm4.p1.1.1" class="ltx_text ltx_font_italic">[</span><a href="#bib.bibx41" title="" class="ltx_ref">Whi65</a><span id="A1.Thmthm4.p1.1.2" class="ltx_text ltx_font_italic">]</span></cite><span id="A1.Thmthm4.p1.1.3" class="ltx_text ltx_font_italic">
Given a smooth complex algebraic variety and <math id="A1.Thmthm4.p1.m1" class="ltx_Math" alttext="S\subseteq M" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⊆</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">S\subseteq M</annotation></semantics></math> a constructible set. There exists a minimal Whitney stratification which is induced from a Whitney prestratification whose strata are all smooth complex algebraic submanifolds.</span></p>
</div>
</div>
<div id="A1.SS1.p5" class="ltx_para">
<p id="A1.SS1.p5.1" class="ltx_p">We sketch the constructive proof following Mather <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx27" title="" class="ltx_ref">Mat73</a>]</cite> as this construction will be needed for further discussions. Suppose the (real) dimension of <math id="A1.SS1.p5.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> is <math id="A1.SS1.p5.m2" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math>. Then we construct inductively a sequence of closed algebraic subsets</p>
<table id="A1.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex5.m1" class="ltx_Math" alttext="S=S^{(m)}\supseteq S^{(m-1)}\supset\cdots\supseteq S^{(0)}" display="block" intent=":literal"><semantics><mrow><mi>S</mi><mo>=</mo><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup><mo>⊇</mo><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo rspace="0.1389em">⊃</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">⊇</mo><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">S=S^{(m)}\supseteq S^{(m-1)}\supset\cdots\supseteq S^{(0)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS1.p5.2" class="ltx_p">satisfying the following conditions.</p>
<ol id="A1.I3" class="ltx_enumerate">
<li id="A1.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="A1.I3.i1.p1" class="ltx_para">
<p id="A1.I3.i1.p1.1" class="ltx_p">Each <math id="A1.I3.i1.p1.m1" class="ltx_Math" alttext="S^{(l)}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">S^{(l)}</annotation></semantics></math> is a closed algebraic subset of <math id="A1.I3.i1.p1.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> of real dimension at most <math id="A1.I3.i1.p1.m3" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>.</p>
</div></li>
<li id="A1.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="A1.I3.i2.p1" class="ltx_para">
<p id="A1.I3.i2.p1.1" class="ltx_p">Each <math id="A1.I3.i2.p1.m1" class="ltx_Math" alttext="\mathring{S}^{(l)}:=S^{(l)}\setminus S^{(l-1)}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>S</mi><mo>̊</mo></mover><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>:=</mo><mrow><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>∖</mo><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\mathring{S}^{(l)}:=S^{(l)}\setminus S^{(l-1)}</annotation></semantics></math> is a smooth complex algebraic submanifold of (real) dimension <math id="A1.I3.i2.p1.m2" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>. It can empty, for example, when <math id="A1.I3.i2.p1.m3" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> is odd.</p>
</div></li>
<li id="A1.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="A1.I3.i3.p1" class="ltx_para">
<p id="A1.I3.i3.p1.1" class="ltx_p">For each pair <math id="A1.I3.i3.p1.m1" class="ltx_Math" alttext="l&gt;k" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>&gt;</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">l&gt;k</annotation></semantics></math>, the pair <math id="A1.I3.i3.p1.m2" class="ltx_Math" alttext="(\mathring{S}^{(l)},\mathring{S}^{(k)})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>S</mi><mo>̊</mo></mover><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mover accent="true"><mi>S</mi><mo>̊</mo></mover><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathring{S}^{(l)},\mathring{S}^{(k)})</annotation></semantics></math> satisfies Whitney’s condition (b) at every point of <math id="A1.I3.i3.p1.m3" class="ltx_Math" alttext="\mathring{S}^{(k)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>S</mi><mo>̊</mo></mover><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\mathring{S}^{(k)}</annotation></semantics></math>.</p>
</div></li>
</ol>
<p id="A1.SS1.p5.3" class="ltx_p">Indeed, suppose <math id="A1.SS1.p5.m3" class="ltx_Math" alttext="S^{(m)},\cdots,S^{(k)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">S^{(m)},\cdots,S^{(k)}</annotation></semantics></math> have been constructed. Then we define <math id="A1.SS1.p5.m4" class="ltx_Math" alttext="S^{(k-1)}\subset S^{(k)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>⊂</mo><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">S^{(k-1)}\subset S^{(k)}</annotation></semantics></math> to be the subset of points <math id="A1.SS1.p5.m5" class="ltx_Math" alttext="x\in S^{(k)}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">x\in S^{(k)}</annotation></semantics></math> satisfying one of the following conditions.</p>
<ol id="A1.I4" class="ltx_enumerate">
<li id="A1.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="A1.I4.i1.p1" class="ltx_para">
<p id="A1.I4.i1.p1.1" class="ltx_p"><math id="A1.I4.i1.p1.m1" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> is a singular point of <math id="A1.I4.i1.p1.m2" class="ltx_Math" alttext="S^{(k)}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">S^{(k)}</annotation></semantics></math> or a regular point of <math id="A1.I4.i1.p1.m3" class="ltx_Math" alttext="S^{(k)}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">S^{(k)}</annotation></semantics></math> with local (real) dimension strictly less than <math id="A1.I4.i1.p1.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>.</p>
</div></li>
<li id="A1.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="A1.I4.i2.p1" class="ltx_para">
<p id="A1.I4.i2.p1.1" class="ltx_p"><math id="A1.I4.i2.p1.m1" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> is a regular point of <math id="A1.I4.i2.p1.m2" class="ltx_Math" alttext="S^{(k)}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">S^{(k)}</annotation></semantics></math> with local dimension <math id="A1.I4.i2.p1.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> and there exists <math id="A1.I4.i2.p1.m4" class="ltx_Math" alttext="l&gt;k" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>&gt;</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">l&gt;k</annotation></semantics></math> such that the pair <math id="A1.I4.i2.p1.m5" class="ltx_Math" alttext="(\mathring{S}^{(l)},S^{(k)}_{reg})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>S</mi><mo>̊</mo></mover><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msubsup><mi>S</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathring{S}^{(l)},S^{(k)}_{reg})</annotation></semantics></math> does not satisfy Whitney’s condition (b) at <math id="A1.I4.i2.p1.m6" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>. Here <math id="A1.I4.i2.p1.m7" class="ltx_Math" alttext="S_{reg}^{(k)}\subseteq S^{(k)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>S</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>⊆</mo><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">S_{reg}^{(k)}\subseteq S^{(k)}</annotation></semantics></math> is the Zariski open subset of regular points of local dimension <math id="A1.I4.i2.p1.m8" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>.</p>
</div></li>
</ol>
<p id="A1.SS1.p5.4" class="ltx_p">Basic algebraic geometry implies that the set of points satisfying the first condition above is a closed algebraic set of real dimension strictly less than <math id="A1.SS1.p5.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>. On the other hand, it is a fundamental theorem of Whitney that the set of points satisfying the second condition above is also a closed algebraic set of real dimension strictly less than <math id="A1.SS1.p5.m7" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>. Then this produces a Whitney prestratification whose strata are all connected components of all <math id="A1.SS1.p5.m8" class="ltx_Math" alttext="\mathring{S}^{(k)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>S</mi><mo>̊</mo></mover><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\mathring{S}^{(k)}</annotation></semantics></math>. It is not difficult to prove that this Whitney stratification is the minimal one.</p>
</div>
</section>
<section id="A1.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.2. </span>Product of canonical Whitney stratifications</h3>

<div id="A1.SS2.p1" class="ltx_para">
<p id="A1.SS2.p1.1" class="ltx_p">Now we consider if the product of canonical Whitney stratifications on a product algebraic set is the canonical one. Let <math id="A1.SS2.p1.m1" class="ltx_Math" alttext="M_{1},M_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mn>1</mn></msub><mo>,</mo><msub><mi>M</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">M_{1},M_{2}</annotation></semantics></math> be smooth complex algebraic varieties and <math id="A1.SS2.p1.m2" class="ltx_Math" alttext="S_{1}\subseteq M_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mn>1</mn></msub><mo>⊆</mo><msub><mi>M</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">S_{1}\subseteq M_{1}</annotation></semantics></math>, <math id="A1.SS2.p1.m3" class="ltx_Math" alttext="S_{2}\subseteq M_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mn>2</mn></msub><mo>⊆</mo><msub><mi>M</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">S_{2}\subseteq M_{2}</annotation></semantics></math> be complex algebraic subsets, equipped with the canonical Whitney stratification of with levels <math id="A1.SS2.p1.m4" class="ltx_Math" alttext="S_{i}^{(k)}" display="inline" intent=":literal"><semantics><msubsup><mi>S</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">S_{i}^{(k)}</annotation></semantics></math>. Denote</p>
<table id="A1.EGx27" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex6.m1" class="ltx_Math" alttext="\displaystyle\ M=M_{1}\times M_{2},\ " display="inline" intent=":literal"><semantics><mrow><mrow><mi>M</mi><mo>=</mo><mrow><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>M</mi><mn>2</mn></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ M=M_{1}\times M_{2},\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex6.m2" class="ltx_Math" alttext="\displaystyle\ S=S_{1}\times S_{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>S</mi><mo>=</mo><mrow><msub><mi>S</mi><mn>1</mn></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>S</mi><mn>2</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ S=S_{1}\times S_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p1.2" class="ltx_p">For each <math id="A1.SS2.p1.m5" class="ltx_Math" alttext="k\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">k\geq 0</annotation></semantics></math>, denote</p>
<table id="A1.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex7.m1" class="ltx_Math" alttext="\mathring{S}_{\times}^{(k)}:=\bigcup_{k_{1}+k_{2}=k}\mathring{S}_{1}^{(k_{1})}\times\mathring{S}_{2}^{(k_{2})}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>S</mi><mo>̊</mo></mover><mo>×</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.111em">:=</mo><mrow><mrow><munder><mo movablelimits="false">⋃</mo><mrow><mrow><msub><mi>k</mi><mn>1</mn></msub><mo>+</mo><msub><mi>k</mi><mn>2</mn></msub></mrow><mo>=</mo><mi>k</mi></mrow></munder><msubsup><mover accent="true"><mi>S</mi><mo>̊</mo></mover><mn>1</mn><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mover accent="true"><mi>S</mi><mo>̊</mo></mover><mn>2</mn><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathring{S}_{\times}^{(k)}:=\bigcup_{k_{1}+k_{2}=k}\mathring{S}_{1}^{(k_{1})}\times\mathring{S}_{2}^{(k_{2})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p1.3" class="ltx_p">It is easy to see that the prestratification on <math id="A1.SS2.p1.m6" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> whose strata are all connected components of all <math id="A1.SS2.p1.m7" class="ltx_Math" alttext="\mathring{S}_{\times}^{(k)}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>S</mi><mo>̊</mo></mover><mo>×</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\mathring{S}_{\times}^{(k)}</annotation></semantics></math> is a Whitney prestratification. Denote the associated Whitney stratification by <math id="A1.SS2.p1.m8" class="ltx_Math" alttext="{\mathcal{S}}_{\times}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>×</mo></msub><annotation encoding="application/x-tex">{\mathcal{S}}_{\times}</annotation></semantics></math>. It is easy to see the induced dimension filtration on <math id="A1.SS2.p1.m9" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is given by</p>
<table id="A1.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex8.m1" class="ltx_Math" alttext="S_{\times}^{(k)}=\bigcup_{k_{1}+k_{2}=k}S_{1}^{(k_{1})}\times S_{2}^{(k_{2})}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>S</mi><mo>×</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.111em">=</mo><mrow><mrow><munder><mo movablelimits="false">⋃</mo><mrow><mrow><msub><mi>k</mi><mn>1</mn></msub><mo>+</mo><msub><mi>k</mi><mn>2</mn></msub></mrow><mo>=</mo><mi>k</mi></mrow></munder><msubsup><mi>S</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>S</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">S_{\times}^{(k)}=\bigcup_{k_{1}+k_{2}=k}S_{1}^{(k_{1})}\times S_{2}^{(k_{2})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.Thmthm5" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmthm5.2" class="ltx_text ltx_font_bold">Proposition A.5</span></span><span id="A1.Thmthm5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmthm5.p1" class="ltx_para">
<p id="A1.Thmthm5.p1.1" class="ltx_p"><span id="A1.Thmthm5.p1.1.1" class="ltx_text ltx_font_italic">The Whitney stratification <math id="A1.Thmthm5.p1.m1" class="ltx_Math" alttext="{\mathcal{S}}_{\times}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>×</mo></msub><annotation encoding="application/x-tex">{\mathcal{S}}_{\times}</annotation></semantics></math> on <math id="A1.Thmthm5.p1.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is the minimal (canonical) one.</span></p>
</div>
</div>
<div id="A1.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS2.p2" class="ltx_para">
<p id="A1.SS2.p2.1" class="ltx_p"><span id="A1.SS2.p2.1.1" class="ltx_text">We know that the canonical Whitney stratification, denoted by <math id="A1.SS2.p2.m1" class="ltx_Math" alttext="{\mathcal{S}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">{\mathcal{S}}</annotation></semantics></math>, is the minimal one. Then one has <math id="A1.SS2.p2.m2" class="ltx_Math" alttext="{\mathcal{S}}\leq{\mathcal{S}}_{\times}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>≤</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>×</mo></msub></mrow><annotation encoding="application/x-tex">{\mathcal{S}}\leq{\mathcal{S}}_{\times}</annotation></semantics></math>. Suppose this is not an equality. Then by definition (see Definition <a href="#A1.Thmthm3" title="Definition A.3. ‣ A.1. Basics of Whitney stratifications ‣ Appendix A Product of canonical Whitney stratifications ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.3</span></a>), there exists <math id="A1.SS2.p2.m3" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> such that</span></p>
<table id="A1.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex9.m1" class="ltx_Math" alttext="S^{(k)}=S_{\times}^{(k)}\ \forall k&gt;l,\ S^{(l)}\subsetneq S_{\times}^{(l)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><msubsup><mi>S</mi><mo>×</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mo rspace="0.167em">∀</mo><mi>k</mi></mrow></mrow><mo>&gt;</mo><mi>l</mi></mrow><mo rspace="0.667em">,</mo><mrow><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo>⊊</mo><msubsup><mi>S</mi><mo>×</mo><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">S^{(k)}=S_{\times}^{(k)}\ \forall k&gt;l,\ S^{(l)}\subsetneq S_{\times}^{(l)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p2.2" class="ltx_p"><span id="A1.SS2.p2.2.1" class="ltx_text">Therefore, there exists a point</span></p>
<table id="A1.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex10.m1" class="ltx_Math" alttext="x=(x_{1},x_{2})\in S^{(l+1)}=S_{\times}^{(l+1)}=\bigcup_{l_{1}+l_{2}=l+1}S_{1}^{(l_{1})}\times S_{2}^{(l_{2})}," display="block" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><msubsup><mi>S</mi><mo>×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.111em">=</mo><mrow><mrow><munder><mo movablelimits="false">⋃</mo><mrow><mrow><msub><mi>l</mi><mn>1</mn></msub><mo>+</mo><msub><mi>l</mi><mn>2</mn></msub></mrow><mo>=</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow></munder><msubsup><mi>S</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><msub><mi>l</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>S</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><msub><mi>l</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">x=(x_{1},x_{2})\in S^{(l+1)}=S_{\times}^{(l+1)}=\bigcup_{l_{1}+l_{2}=l+1}S_{1}^{(l_{1})}\times S_{2}^{(l_{2})},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p2.3" class="ltx_p"><math id="A1.SS2.p2.m4" class="ltx_Math" alttext="x\in S_{\times}^{(l)}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msubsup><mi>S</mi><mo>×</mo><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">x\in S_{\times}^{(l)}</annotation></semantics></math><span id="A1.SS2.p2.3.1" class="ltx_text">, <math id="A1.SS2.p2.m5" class="ltx_Math" alttext="x\notin S^{(l)}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∉</mo><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">x\notin S^{(l)}</annotation></semantics></math>. Then by the construction of the canonical Whitney stratification, <math id="A1.SS2.p2.m6" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> is a regular point of <math id="A1.SS2.p2.m7" class="ltx_Math" alttext="S^{(l+1)}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">S^{(l+1)}</annotation></semantics></math> of local dimension <math id="A1.SS2.p2.m8" class="ltx_Math" alttext="l+1" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">l+1</annotation></semantics></math>. Then <math id="A1.SS2.p2.m9" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> is a regular point of the union of <math id="A1.SS2.p2.m10" class="ltx_Math" alttext="S_{1}^{(l_{1})}\times S_{2}^{(l_{2})}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>S</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><msub><mi>l</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>S</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><msub><mi>l</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">S_{1}^{(l_{1})}\times S_{2}^{(l_{2})}</annotation></semantics></math> for all possible <math id="A1.SS2.p2.m11" class="ltx_Math" alttext="l_{1}+l_{2}=l+1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>l</mi><mn>1</mn></msub><mo>+</mo><msub><mi>l</mi><mn>2</mn></msub></mrow><mo>=</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">l_{1}+l_{2}=l+1</annotation></semantics></math>. Then for some <math id="A1.SS2.p2.m12" class="ltx_Math" alttext="l_{1},l_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>l</mi><mn>1</mn></msub><mo>,</mo><msub><mi>l</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">l_{1},l_{2}</annotation></semantics></math> with <math id="A1.SS2.p2.m13" class="ltx_Math" alttext="l_{1}+l_{2}=l+1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>l</mi><mn>1</mn></msub><mo>+</mo><msub><mi>l</mi><mn>2</mn></msub></mrow><mo>=</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">l_{1}+l_{2}=l+1</annotation></semantics></math>, <math id="A1.SS2.p2.m14" class="ltx_Math" alttext="x=(x_{1},x_{2})" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">x=(x_{1},x_{2})</annotation></semantics></math> is a regular point of <math id="A1.SS2.p2.m15" class="ltx_Math" alttext="S_{1}^{(l_{1})}\times S_{2}^{(l_{2})}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>S</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><msub><mi>l</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>S</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><msub><mi>l</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">S_{1}^{(l_{1})}\times S_{2}^{(l_{2})}</annotation></semantics></math> with local dimension <math id="A1.SS2.p2.m16" class="ltx_Math" alttext="l+1" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">l+1</annotation></semantics></math>. This implies that <math id="A1.SS2.p2.m17" class="ltx_Math" alttext="x_{i}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>i</mi></msub><annotation encoding="application/x-tex">x_{i}</annotation></semantics></math> is a regular point of local dimension <math id="A1.SS2.p2.m18" class="ltx_Math" alttext="l_{i}" display="inline" intent=":literal"><semantics><msub><mi>l</mi><mi>i</mi></msub><annotation encoding="application/x-tex">l_{i}</annotation></semantics></math> in each factor.</span></p>
</div>
<div id="A1.SS2.p3" class="ltx_para">
<p id="A1.SS2.p3.1" class="ltx_p"><span id="A1.SS2.p3.1.1" class="ltx_text">However, <math id="A1.SS2.p3.m1" class="ltx_Math" alttext="x\in S_{\times}^{(l)}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msubsup><mi>S</mi><mo>×</mo><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">x\in S_{\times}^{(l)}</annotation></semantics></math> also implies that either <math id="A1.SS2.p3.m2" class="ltx_Math" alttext="x_{1}\in S_{1}^{(l_{1}-1)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>∈</mo><msubsup><mi>S</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mrow><msub><mi>l</mi><mn>1</mn></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">x_{1}\in S_{1}^{(l_{1}-1)}</annotation></semantics></math> or <math id="A1.SS2.p3.m3" class="ltx_Math" alttext="x_{2}\in S_{2}^{(l_{2}-1)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>∈</mo><msubsup><mi>S</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mrow><msub><mi>l</mi><mn>2</mn></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">x_{2}\in S_{2}^{(l_{2}-1)}</annotation></semantics></math>. Without loss of generality, we assume <math id="A1.SS2.p3.m4" class="ltx_Math" alttext="x_{1}\in S_{1}^{(l_{1}-1)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>∈</mo><msubsup><mi>S</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mrow><msub><mi>l</mi><mn>1</mn></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">x_{1}\in S_{1}^{(l_{1}-1)}</annotation></semantics></math>. Then as <math id="A1.SS2.p3.m5" class="ltx_Math" alttext="x_{1}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>1</mn></msub><annotation encoding="application/x-tex">x_{1}</annotation></semantics></math> is a regular point of <math id="A1.SS2.p3.m6" class="ltx_Math" alttext="S_{1}^{(l_{1})}" display="inline" intent=":literal"><semantics><msubsup><mi>S</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><msub><mi>l</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">S_{1}^{(l_{1})}</annotation></semantics></math>, it implies that for some <math id="A1.SS2.p3.m7" class="ltx_Math" alttext="k_{1}&gt;l_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>k</mi><mn>1</mn></msub><mo>&gt;</mo><msub><mi>l</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">k_{1}&gt;l_{1}</annotation></semantics></math>, Whitney’s condition (b) for <math id="A1.SS2.p3.m8" class="ltx_Math" alttext="(\mathring{S}_{1}^{(k_{1})},S_{1,reg}^{(l_{1})})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>S</mi><mo>̊</mo></mover><mn>1</mn><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>S</mi><mrow><mn>1</mn><mo>,</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>l</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathring{S}_{1}^{(k_{1})},S_{1,reg}^{(l_{1})})</annotation></semantics></math> fails at <math id="A1.SS2.p3.m9" class="ltx_Math" alttext="x_{1}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>1</mn></msub><annotation encoding="application/x-tex">x_{1}</annotation></semantics></math>. Then there exists a sequence <math id="A1.SS2.p3.m10" class="ltx_Math" alttext="y_{1,\nu}\in\mathring{S}_{1}^{(k_{1})}" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mrow><mn>1</mn><mo>,</mo><mi>ν</mi></mrow></msub><mo>∈</mo><msubsup><mover accent="true"><mi>S</mi><mo>̊</mo></mover><mn>1</mn><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">y_{1,\nu}\in\mathring{S}_{1}^{(k_{1})}</annotation></semantics></math> and a sequence <math id="A1.SS2.p3.m11" class="ltx_Math" alttext="x_{1,\nu}\in S_{1,reg}^{(l_{1})}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mrow><mn>1</mn><mo>,</mo><mi>ν</mi></mrow></msub><mo>∈</mo><msubsup><mi>S</mi><mrow><mn>1</mn><mo>,</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>l</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">x_{1,\nu}\in S_{1,reg}^{(l_{1})}</annotation></semantics></math>, both of which converging to <math id="A1.SS2.p3.m12" class="ltx_Math" alttext="x_{1}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>1</mn></msub><annotation encoding="application/x-tex">x_{1}</annotation></semantics></math> such that <math id="A1.SS2.p3.m13" class="ltx_Math" alttext="T_{y_{1,\nu}}\mathring{S}_{1}^{(k_{1})}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><msub><mi>y</mi><mrow><mn>1</mn><mo>,</mo><mi>ν</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>S</mi><mo>̊</mo></mover><mn>1</mn><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">T_{y_{1,\nu}}\mathring{S}_{1}^{(k_{1})}</annotation></semantics></math> converges to a subspace <math id="A1.SS2.p3.m14" class="ltx_Math" alttext="H_{1}\subset T_{x_{1}}M_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mn>1</mn></msub><mo>⊂</mo><mrow><msub><mi>T</mi><msub><mi>x</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">H_{1}\subset T_{x_{1}}M_{1}</annotation></semantics></math>, the secant line <math id="A1.SS2.p3.m15" class="ltx_Math" alttext="\overline{x_{1,\nu}y_{1,\nu}}" display="inline" intent=":literal"><semantics><mover accent="true"><mrow><msub><mi>x</mi><mrow><mn>1</mn><mo>,</mo><mi>ν</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mrow><mn>1</mn><mo>,</mo><mi>ν</mi></mrow></msub></mrow><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{x_{1,\nu}y_{1,\nu}}</annotation></semantics></math> converges to a line <math id="A1.SS2.p3.m16" class="ltx_Math" alttext="L_{1}\subset T_{x_{1}}M" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mn>1</mn></msub><mo>⊂</mo><mrow><msub><mi>T</mi><msub><mi>x</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">L_{1}\subset T_{x_{1}}M</annotation></semantics></math>, but <math id="A1.SS2.p3.m17" class="ltx_Math" alttext="L_{1}\nsubseteq H_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mn>1</mn></msub><mo>⊈</mo><msub><mi>H</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">L_{1}\nsubseteq H_{1}</annotation></semantics></math>. Now we separate the discussion in two scenarioes</span></p>
<ol id="A1.I5" class="ltx_enumerate">
<li id="A1.I5.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="A1.I5.i1.p1" class="ltx_para">
<p id="A1.I5.i1.p1.1" class="ltx_p">If <math id="A1.I5.i1.p1.m1" class="ltx_Math" alttext="x_{2}\in\mathring{S}_{2}^{(l_{2})}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>∈</mo><msubsup><mover accent="true"><mi>S</mi><mo>̊</mo></mover><mn>2</mn><mrow><mo stretchy="false">(</mo><msub><mi>l</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">x_{2}\in\mathring{S}_{2}^{(l_{2})}</annotation></semantics></math>, then consider the two sequences <math id="A1.I5.i1.p1.m2" class="ltx_Math" alttext="(x_{1,\nu},x_{2})\in S_{1,reg}^{(l_{1})}\times S_{2,reg}^{(l_{2})}\subset S^{(l+1)}_{reg}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mn>1</mn><mo>,</mo><mi>ν</mi></mrow></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><msubsup><mi>S</mi><mrow><mn>1</mn><mo>,</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>l</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>S</mi><mrow><mn>2</mn><mo>,</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>l</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>⊂</mo><msubsup><mi>S</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">(x_{1,\nu},x_{2})\in S_{1,reg}^{(l_{1})}\times S_{2,reg}^{(l_{2})}\subset S^{(l+1)}_{reg}</annotation></semantics></math>, <math id="A1.I5.i1.p1.m3" class="ltx_Math" alttext="(y_{1,\nu},x_{2})\in\mathring{S}_{1}^{(k_{1})}\times\mathring{S}_{2}^{(l_{2})}\subset\mathring{S}^{(k_{1}+l_{2})}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mrow><mn>1</mn><mo>,</mo><mi>ν</mi></mrow></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><msubsup><mover accent="true"><mi>S</mi><mo>̊</mo></mover><mn>1</mn><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mover accent="true"><mi>S</mi><mo>̊</mo></mover><mn>2</mn><mrow><mo stretchy="false">(</mo><msub><mi>l</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>⊂</mo><msup><mover accent="true"><mi>S</mi><mo>̊</mo></mover><mrow><mo stretchy="false">(</mo><mrow><msub><mi>k</mi><mn>1</mn></msub><mo>+</mo><msub><mi>l</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">(y_{1,\nu},x_{2})\in\mathring{S}_{1}^{(k_{1})}\times\mathring{S}_{2}^{(l_{2})}\subset\mathring{S}^{(k_{1}+l_{2})}</annotation></semantics></math>. Then one can see that Whitney’s condition (b) fails for <math id="A1.I5.i1.p1.m4" class="ltx_Math" alttext="(\mathring{S}^{(k_{1}+l_{2})},S_{reg}^{(l+1)})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>S</mi><mo>̊</mo></mover><mrow><mo stretchy="false">(</mo><mrow><msub><mi>k</mi><mn>1</mn></msub><mo>+</mo><msub><mi>l</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msubsup><mi>S</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathring{S}^{(k_{1}+l_{2})},S_{reg}^{(l+1)})</annotation></semantics></math> at the limit <math id="A1.I5.i1.p1.m5" class="ltx_Math" alttext="x=(x_{1},x_{2})" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">x=(x_{1},x_{2})</annotation></semantics></math>, which is a contradiction that <math id="A1.I5.i1.p1.m6" class="ltx_Math" alttext="x\in\mathring{S}^{(l+1)}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msup><mover accent="true"><mi>S</mi><mo>̊</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">x\in\mathring{S}^{(l+1)}</annotation></semantics></math>.</p>
</div></li>
<li id="A1.I5.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="A1.I5.i2.p1" class="ltx_para">
<p id="A1.I5.i2.p1.1" class="ltx_p">Suppose <math id="A1.I5.i2.p1.m1" class="ltx_Math" alttext="x_{2}\notin\mathring{S}_{2}^{(l_{2})}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>∉</mo><msubsup><mover accent="true"><mi>S</mi><mo>̊</mo></mover><mn>2</mn><mrow><mo stretchy="false">(</mo><msub><mi>l</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">x_{2}\notin\mathring{S}_{2}^{(l_{2})}</annotation></semantics></math>. Then by construction, there exist some <math id="A1.I5.i2.p1.m2" class="ltx_Math" alttext="k_{2}&gt;l_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>k</mi><mn>2</mn></msub><mo>&gt;</mo><msub><mi>l</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">k_{2}&gt;l_{2}</annotation></semantics></math>, a sequence <math id="A1.I5.i2.p1.m3" class="ltx_Math" alttext="y_{2,\nu}\in\mathring{S}_{2}^{(k_{2})}" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mrow><mn>2</mn><mo>,</mo><mi>ν</mi></mrow></msub><mo>∈</mo><msubsup><mover accent="true"><mi>S</mi><mo>̊</mo></mover><mn>2</mn><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">y_{2,\nu}\in\mathring{S}_{2}^{(k_{2})}</annotation></semantics></math> converging to <math id="A1.I5.i2.p1.m4" class="ltx_Math" alttext="x_{2}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>2</mn></msub><annotation encoding="application/x-tex">x_{2}</annotation></semantics></math>, a sequence <math id="A1.I5.i2.p1.m5" class="ltx_Math" alttext="x_{2,\nu}\in S_{2,reg}^{(l_{2})}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mrow><mn>2</mn><mo>,</mo><mi>ν</mi></mrow></msub><mo>∈</mo><msubsup><mi>S</mi><mrow><mn>2</mn><mo>,</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>l</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">x_{2,\nu}\in S_{2,reg}^{(l_{2})}</annotation></semantics></math> converging to <math id="A1.I5.i2.p1.m6" class="ltx_Math" alttext="x_{2}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>2</mn></msub><annotation encoding="application/x-tex">x_{2}</annotation></semantics></math>, such that the sequence of tangent spaces <math id="A1.I5.i2.p1.m7" class="ltx_Math" alttext="T_{y_{2,\nu}}\mathring{S}_{2}^{(k_{2})}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><msub><mi>y</mi><mrow><mn>2</mn><mo>,</mo><mi>ν</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>S</mi><mo>̊</mo></mover><mn>2</mn><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">T_{y_{2,\nu}}\mathring{S}_{2}^{(k_{2})}</annotation></semantics></math> converges to <math id="A1.I5.i2.p1.m8" class="ltx_Math" alttext="H_{2}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>2</mn></msub><annotation encoding="application/x-tex">H_{2}</annotation></semantics></math> and the sequence of secant lines <math id="A1.I5.i2.p1.m9" class="ltx_Math" alttext="\overline{x_{2,\nu}y_{2,\nu}}" display="inline" intent=":literal"><semantics><mover accent="true"><mrow><msub><mi>x</mi><mrow><mn>2</mn><mo>,</mo><mi>ν</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mrow><mn>2</mn><mo>,</mo><mi>ν</mi></mrow></msub></mrow><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{x_{2,\nu}y_{2,\nu}}</annotation></semantics></math> converges to a line <math id="A1.I5.i2.p1.m10" class="ltx_Math" alttext="L_{2}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mn>2</mn></msub><annotation encoding="application/x-tex">L_{2}</annotation></semantics></math> but <math id="A1.I5.i2.p1.m11" class="ltx_Math" alttext="L_{2}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mn>2</mn></msub><annotation encoding="application/x-tex">L_{2}</annotation></semantics></math> is not contained in <math id="A1.I5.i2.p1.m12" class="ltx_Math" alttext="H_{2}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>2</mn></msub><annotation encoding="application/x-tex">H_{2}</annotation></semantics></math>. Then consider the sequence of points <math id="A1.I5.i2.p1.m13" class="ltx_Math" alttext="y_{\nu}=(y_{1,\nu},y_{2,\nu})\in\mathring{S}_{1}^{(k_{1})}\times\mathring{S}_{2}^{(k_{2})}\subset\mathring{S}^{(k_{1}+k_{2})}" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mi>ν</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mrow><mn>1</mn><mo>,</mo><mi>ν</mi></mrow></msub><mo>,</mo><msub><mi>y</mi><mrow><mn>2</mn><mo>,</mo><mi>ν</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><msubsup><mover accent="true"><mi>S</mi><mo>̊</mo></mover><mn>1</mn><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mover accent="true"><mi>S</mi><mo>̊</mo></mover><mn>2</mn><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>⊂</mo><msup><mover accent="true"><mi>S</mi><mo>̊</mo></mover><mrow><mo stretchy="false">(</mo><mrow><msub><mi>k</mi><mn>1</mn></msub><mo>+</mo><msub><mi>k</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">y_{\nu}=(y_{1,\nu},y_{2,\nu})\in\mathring{S}_{1}^{(k_{1})}\times\mathring{S}_{2}^{(k_{2})}\subset\mathring{S}^{(k_{1}+k_{2})}</annotation></semantics></math>, the sequence of points <math id="A1.I5.i2.p1.m14" class="ltx_Math" alttext="x_{\nu}=(x_{1,\nu},x_{2,\nu})\in S_{1,reg}^{(l_{1})}\times S_{2,reg}^{(l_{2})}\subset S_{reg}^{(l+1+l_{2})}=S_{reg}^{(l+1)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>ν</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mn>1</mn><mo>,</mo><mi>ν</mi></mrow></msub><mo>,</mo><msub><mi>x</mi><mrow><mn>2</mn><mo>,</mo><mi>ν</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><msubsup><mi>S</mi><mrow><mn>1</mn><mo>,</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>l</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>S</mi><mrow><mn>2</mn><mo>,</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>l</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>⊂</mo><msubsup><mi>S</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn><mo>+</mo><msub><mi>l</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><msubsup><mi>S</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">x_{\nu}=(x_{1,\nu},x_{2,\nu})\in S_{1,reg}^{(l_{1})}\times S_{2,reg}^{(l_{2})}\subset S_{reg}^{(l+1+l_{2})}=S_{reg}^{(l+1)}</annotation></semantics></math>. This breaks the hypothesis that <math id="A1.I5.i2.p1.m15" class="ltx_Math" alttext="x\in\mathring{S}^{(l+1)}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msup><mover accent="true"><mi>S</mi><mo>̊</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">x\in\mathring{S}^{(l+1)}</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
<div id="A1.SS2.p4" class="ltx_para">
<p id="A1.SS2.p4.1" class="ltx_p"><span id="A1.SS2.p4.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A1.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.3. </span>Relative case</h3>

<div id="A1.SS3.p1" class="ltx_para">
<p id="A1.SS3.p1.1" class="ltx_p">Now we consider the relative case. Let <math id="A1.SS3.p1.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> be equipped with a prestratification <math id="A1.SS3.p1.m2" class="ltx_Math" alttext="{\mathfrak{A}}" display="inline" intent=":literal"><semantics><mi>𝔄</mi><annotation encoding="application/x-tex">{\mathfrak{A}}</annotation></semantics></math></p>
<table id="A1.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex11.m1" class="ltx_Math" alttext="S=\bigsqcup_{\alpha\in{\mathfrak{A}}}S_{\alpha}" display="block" intent=":literal"><semantics><mrow><mi>S</mi><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">⨆</mo><mrow><mi>α</mi><mo>∈</mo><mi>𝔄</mi></mrow></munder><msub><mi>S</mi><mi>α</mi></msub></mrow></mrow><annotation encoding="application/x-tex">S=\bigsqcup_{\alpha\in{\mathfrak{A}}}S_{\alpha}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.p1.2" class="ltx_p">such that each stratum <math id="A1.SS3.p1.m3" class="ltx_Math" alttext="S_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>α</mi></msub><annotation encoding="application/x-tex">S_{\alpha}</annotation></semantics></math> is algebraic. A Whitney stratification <math id="A1.SS3.p1.m4" class="ltx_Math" alttext="{\mathcal{S}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">{\mathcal{S}}</annotation></semantics></math> on <math id="A1.SS3.p1.m5" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is said to respect the given prestratification if for each <math id="A1.SS3.p1.m6" class="ltx_Math" alttext="x\in S" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">x\in S</annotation></semantics></math>, the germ <math id="A1.SS3.p1.m7" class="ltx_Math" alttext="S_{x}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>x</mi></msub><annotation encoding="application/x-tex">S_{x}</annotation></semantics></math> is contained in the stratum <math id="A1.SS3.p1.m8" class="ltx_Math" alttext="S_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>α</mi></msub><annotation encoding="application/x-tex">S_{\alpha}</annotation></semantics></math> which contains <math id="A1.SS3.p1.m9" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>. We call such Whitney stratifications <math id="A1.SS3.p1.m10" class="ltx_Math" alttext="{\mathfrak{A}}" display="inline" intent=":literal"><semantics><mi>𝔄</mi><annotation encoding="application/x-tex">{\mathfrak{A}}</annotation></semantics></math>-Whitney stratifications. We proved in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx6" title="" class="ltx_ref">BX22</a>]</cite> that there exists a unique minimal <math id="A1.SS3.p1.m11" class="ltx_Math" alttext="{\mathfrak{A}}" display="inline" intent=":literal"><semantics><mi>𝔄</mi><annotation encoding="application/x-tex">{\mathfrak{A}}</annotation></semantics></math>-Whitney stratification, which we call the canonical <math id="A1.SS3.p1.m12" class="ltx_Math" alttext="{\mathfrak{A}}" display="inline" intent=":literal"><semantics><mi>𝔄</mi><annotation encoding="application/x-tex">{\mathfrak{A}}</annotation></semantics></math>-Whitney stratification.</p>
</div>
<div id="A1.SS3.p2" class="ltx_para">
<p id="A1.SS3.p2.1" class="ltx_p">For the purpose of this paper, we need to verify that such canonical Whitney stratification is natural with respect to products. Let <math id="A1.SS3.p2.m1" class="ltx_Math" alttext="M,N" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>,</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">M,N</annotation></semantics></math> be two smooth complex algebraic varieties and <math id="A1.SS3.p2.m2" class="ltx_Math" alttext="S\subset M" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⊂</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">S\subset M</annotation></semantics></math>, <math id="A1.SS3.p2.m3" class="ltx_Math" alttext="T\subset N" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>⊂</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">T\subset N</annotation></semantics></math> be constructible subsets. Given algebraic prestratifications</p>
<table id="A1.EGx28" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex12.m1" class="ltx_Math" alttext="\displaystyle\ S=\bigsqcup_{\alpha\in{\mathfrak{A}}}S_{\alpha},\ " display="inline" intent=":literal"><semantics><mrow><mrow><mi>S</mi><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">⨆</mo><mrow><mi>α</mi><mo>∈</mo><mi>𝔄</mi></mrow></munder></mstyle><msub><mi>S</mi><mi>α</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ S=\bigsqcup_{\alpha\in{\mathfrak{A}}}S_{\alpha},\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex12.m2" class="ltx_Math" alttext="\displaystyle\ T=\bigsqcup_{\beta\in{\mathfrak{B}}}T_{\beta}," display="inline" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">⨆</mo><mrow><mi>β</mi><mo>∈</mo><mi>𝔅</mi></mrow></munder></mstyle><msub><mi>T</mi><mi>β</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ T=\bigsqcup_{\beta\in{\mathfrak{B}}}T_{\beta},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.p2.2" class="ltx_p">one has an associated decomposition</p>
<table id="A1.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex13.m1" class="ltx_Math" alttext="R:=S\times T=\bigsqcup_{(\alpha,\beta)\in{\mathfrak{A}}\times{\mathfrak{B}}}T_{(\alpha,\beta)}=\bigsqcup_{(\alpha,\beta)\in{\mathfrak{A}}\times{\mathfrak{B}}}S_{\alpha}\times T_{\beta}." display="block" intent=":literal"><semantics><mrow><mrow><mi>R</mi><mo>:=</mo><mrow><mi>S</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>T</mi></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">⨆</mo><mrow><mrow><mo stretchy="false">(</mo><mi>α</mi><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi>𝔄</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝔅</mi></mrow></mrow></munder><msub><mi>T</mi><mrow><mo stretchy="false">(</mo><mi>α</mi><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></msub></mrow><mo rspace="0.111em">=</mo><mrow><mrow><munder><mo movablelimits="false">⨆</mo><mrow><mrow><mo stretchy="false">(</mo><mi>α</mi><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi>𝔄</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝔅</mi></mrow></mrow></munder><msub><mi>S</mi><mi>α</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>T</mi><mi>β</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">R:=S\times T=\bigsqcup_{(\alpha,\beta)\in{\mathfrak{A}}\times{\mathfrak{B}}}T_{(\alpha,\beta)}=\bigsqcup_{(\alpha,\beta)\in{\mathfrak{A}}\times{\mathfrak{B}}}S_{\alpha}\times T_{\beta}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.p2.3" class="ltx_p">We can check that this is still a prestratification with algebraic strata. Moreover, the induced partial order on the set of strata <math id="A1.SS3.p2.m4" class="ltx_Math" alttext="{\mathfrak{A}}\times{\mathfrak{B}}" display="inline" intent=":literal"><semantics><mrow><mi>𝔄</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝔅</mi></mrow><annotation encoding="application/x-tex">{\mathfrak{A}}\times{\mathfrak{B}}</annotation></semantics></math> is the product one:</p>
<table id="A1.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex14.m1" class="ltx_Math" alttext="(\alpha,\beta)\leq(\alpha^{\prime},\beta^{\prime})\Longleftrightarrow\alpha\leq\alpha^{\prime}\ {\rm and}\ \beta\leq\beta^{\prime}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mi>α</mi><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow><mo>≤</mo><mrow><mo stretchy="false">(</mo><msup><mi>α</mi><mo>′</mo></msup><mo>,</mo><msup><mi>β</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">⟺</mo><mrow><mi>α</mi><mo>≤</mo><mrow><msup><mi>α</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>and</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>β</mi></mrow><mo>≤</mo><msup><mi>β</mi><mo>′</mo></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(\alpha,\beta)\leq(\alpha^{\prime},\beta^{\prime})\Longleftrightarrow\alpha\leq\alpha^{\prime}\ {\rm and}\ \beta\leq\beta^{\prime}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.p2.4" class="ltx_p">Let the prestratification be denoted by <math id="A1.SS3.p2.m5" class="ltx_Math" alttext="{\mathfrak{A}}\times{\mathfrak{B}}" display="inline" intent=":literal"><semantics><mrow><mi>𝔄</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝔅</mi></mrow><annotation encoding="application/x-tex">{\mathfrak{A}}\times{\mathfrak{B}}</annotation></semantics></math>. On <math id="A1.SS3.p2.m6" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> resp. <math id="A1.SS3.p2.m7" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> there are minimal <math id="A1.SS3.p2.m8" class="ltx_Math" alttext="{\mathfrak{A}}" display="inline" intent=":literal"><semantics><mi>𝔄</mi><annotation encoding="application/x-tex">{\mathfrak{A}}</annotation></semantics></math>- resp. <math id="A1.SS3.p2.m9" class="ltx_Math" alttext="{\mathfrak{B}}" display="inline" intent=":literal"><semantics><mi>𝔅</mi><annotation encoding="application/x-tex">{\mathfrak{B}}</annotation></semantics></math>-Whitney stratification, whose product is also a Whitney stratification on <math id="A1.SS3.p2.m10" class="ltx_Math" alttext="R=S\times T" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>=</mo><mrow><mi>S</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>T</mi></mrow></mrow><annotation encoding="application/x-tex">R=S\times T</annotation></semantics></math>.</p>
</div>
<div id="A1.Thmthm6" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A1.Thmthm6.2" class="ltx_text ltx_font_bold">Proposition A.6</span></span><span id="A1.Thmthm6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A1.Thmthm6.p1" class="ltx_para">
<p id="A1.Thmthm6.p1.1" class="ltx_p"><span id="A1.Thmthm6.p1.1.1" class="ltx_text ltx_font_italic">The product Whitney stratification on <math id="A1.Thmthm6.p1.m1" class="ltx_Math" alttext="R=S\times T" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>=</mo><mrow><mi>S</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>T</mi></mrow></mrow><annotation encoding="application/x-tex">R=S\times T</annotation></semantics></math> is the minimal <math id="A1.Thmthm6.p1.m2" class="ltx_Math" alttext="{\mathfrak{A}}\times{\mathfrak{B}}" display="inline" intent=":literal"><semantics><mrow><mi>𝔄</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝔅</mi></mrow><annotation encoding="application/x-tex">{\mathfrak{A}}\times{\mathfrak{B}}</annotation></semantics></math>-Whitney stratification.</span></p>
</div>
</div>
<div id="A1.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS3.p3" class="ltx_para">
<p id="A1.SS3.p3.1" class="ltx_p"><span id="A1.SS3.p3.1.1" class="ltx_text">We prove by induction. Proposition <a href="#A1.Thmthm5" title="Proposition A.5. ‣ A.2. Product of canonical Whitney stratifications ‣ Appendix A Product of canonical Whitney stratifications ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.5</span></a> implies that for each top stratum <math id="A1.SS3.p3.m1" class="ltx_Math" alttext="(\alpha_{0},\beta_{0})\in{\mathfrak{A}}\times{\mathfrak{B}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mn>0</mn></msub><mo>,</mo><msub><mi>β</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi>𝔄</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝔅</mi></mrow></mrow><annotation encoding="application/x-tex">(\alpha_{0},\beta_{0})\in{\mathfrak{A}}\times{\mathfrak{B}}</annotation></semantics></math>, the product Whitney stratification coincides with the minimal Whitney stratification on <math id="A1.SS3.p3.m2" class="ltx_Math" alttext="S_{\alpha_{0}}\times T_{\beta_{0}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><msub><mi>α</mi><mn>0</mn></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>T</mi><msub><mi>β</mi><mn>0</mn></msub></msub></mrow><annotation encoding="application/x-tex">S_{\alpha_{0}}\times T_{\beta_{0}}</annotation></semantics></math>. Now given a stratum <math id="A1.SS3.p3.m3" class="ltx_Math" alttext="(\alpha,\beta)\in{\mathfrak{A}}\times{\mathfrak{B}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>α</mi><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi>𝔄</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝔅</mi></mrow></mrow><annotation encoding="application/x-tex">(\alpha,\beta)\in{\mathfrak{A}}\times{\mathfrak{B}}</annotation></semantics></math>. Suppose for any <math id="A1.SS3.p3.m4" class="ltx_Math" alttext="(\alpha^{\prime},\beta^{\prime})&gt;(\alpha,\beta)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msup><mi>α</mi><mo>′</mo></msup><mo>,</mo><msup><mi>β</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>&gt;</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(\alpha^{\prime},\beta^{\prime})&gt;(\alpha,\beta)</annotation></semantics></math>, we have proved that the product Whitney stratification on <math id="A1.SS3.p3.m5" class="ltx_Math" alttext="S_{\alpha^{\prime}}\times T_{\beta^{\prime}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><msup><mi>α</mi><mo>′</mo></msup></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>T</mi><msup><mi>β</mi><mo>′</mo></msup></msub></mrow><annotation encoding="application/x-tex">S_{\alpha^{\prime}}\times T_{\beta^{\prime}}</annotation></semantics></math> coincides with the restriction of the minimal <math id="A1.SS3.p3.m6" class="ltx_Math" alttext="({\mathfrak{A}}\times{\mathfrak{B}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>𝔄</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝔅</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathfrak{A}}\times{\mathfrak{B}})</annotation></semantics></math>-Whitney stratification. We would like to show that it is still the case for the pair <math id="A1.SS3.p3.m7" class="ltx_Math" alttext="(\alpha,\beta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>α</mi><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\alpha,\beta)</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS3.p4" class="ltx_para">
<p id="A1.SS3.p4.1" class="ltx_p"><span id="A1.SS3.p4.1.1" class="ltx_text">Suppose our claim is false. Then there exists <math id="A1.SS3.p4.m1" class="ltx_Math" alttext="k\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">k\geq 0</annotation></semantics></math> such that</span></p>
<table id="A1.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex15.m1" class="ltx_Math" alttext="(S_{\alpha}\times T_{\beta})^{(l)}=\bigcup_{p+q=l}S_{\alpha}^{(p)}\times T_{\beta}^{(q)},\ \forall l\geq k+1,\ (S_{\alpha}\times T_{\beta})^{(k)}\subsetneq\bigcup_{p+q=k}S_{\alpha}^{(p)}\times T_{\beta}^{(q)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>α</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>T</mi><mi>β</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msup><mo rspace="0.111em">=</mo><mrow><mrow><munder><mo movablelimits="false">⋃</mo><mrow><mrow><mi>p</mi><mo>+</mo><mi>q</mi></mrow><mo>=</mo><mi>l</mi></mrow></munder><msubsup><mi>S</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>T</mi><mi>β</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>l</mi></mrow><mo>≥</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow><mo rspace="0.667em">,</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>α</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>T</mi><mi>β</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo rspace="0.111em">⊊</mo><mrow><mrow><munder><mo movablelimits="false">⋃</mo><mrow><mrow><mi>p</mi><mo>+</mo><mi>q</mi></mrow><mo>=</mo><mi>k</mi></mrow></munder><msubsup><mi>S</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>T</mi><mi>β</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(S_{\alpha}\times T_{\beta})^{(l)}=\bigcup_{p+q=l}S_{\alpha}^{(p)}\times T_{\beta}^{(q)},\ \forall l\geq k+1,\ (S_{\alpha}\times T_{\beta})^{(k)}\subsetneq\bigcup_{p+q=k}S_{\alpha}^{(p)}\times T_{\beta}^{(q)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.p4.2" class="ltx_p"><span id="A1.SS3.p4.2.1" class="ltx_text">Then one can choose a point</span></p>
<table id="A1.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E1.m1" class="ltx_Math" alttext="x\in(S_{\alpha}\times T_{\beta})^{(k+1)}\setminus(S_{\alpha}\times T_{\beta})^{(k)}" display="block" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>α</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>T</mi><mi>β</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>∖</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>α</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>T</mi><mi>β</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">x\in(S_{\alpha}\times T_{\beta})^{(k+1)}\setminus(S_{\alpha}\times T_{\beta})^{(k)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.1)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p4.3" class="ltx_p"><span id="A1.SS3.p4.3.1" class="ltx_text">such that</span></p>
<table id="A1.E2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E2.m1" class="ltx_Math" alttext="x\in\bigcup_{p+q=k}S_{\alpha}^{(p)}\times T_{\beta}^{(q)}." display="block" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo rspace="0.111em">∈</mo><mrow><mrow><munder><mo movablelimits="false">⋃</mo><mrow><mrow><mi>p</mi><mo>+</mo><mi>q</mi></mrow><mo>=</mo><mi>k</mi></mrow></munder><msubsup><mi>S</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>T</mi><mi>β</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">x\in\bigcup_{p+q=k}S_{\alpha}^{(p)}\times T_{\beta}^{(q)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(A.2)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p4.4" class="ltx_p"><span id="A1.SS3.p4.4.1" class="ltx_text">By the construction of the minimal Whitney stratifications on constructible sets (sketched after Theorem <a href="#A1.Thmthm4" title="Theorem A.4. ‣ A.1. Basics of Whitney stratifications ‣ Appendix A Product of canonical Whitney stratifications ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.4</span></a>), one knows that <math id="A1.SS3.p4.m2" class="ltx_Math" alttext="x=(y,z)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">x=(y,z)</annotation></semantics></math> is a regular point of <math id="A1.SS3.p4.m3" class="ltx_Math" alttext="(S_{\alpha}\times T_{\beta})^{(k+1)}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>α</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>T</mi><mi>β</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">(S_{\alpha}\times T_{\beta})^{(k+1)}</annotation></semantics></math> of local dimension <math id="A1.SS3.p4.m4" class="ltx_Math" alttext="k+1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k+1</annotation></semantics></math>. This implies that for some <math id="A1.SS3.p4.m5" class="ltx_Math" alttext="p+q=k+1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>+</mo><mi>q</mi></mrow><mo>=</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">p+q=k+1</annotation></semantics></math>, <math id="A1.SS3.p4.m6" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> is a regular point of <math id="A1.SS3.p4.m7" class="ltx_Math" alttext="S_{\alpha}^{(p)}\times T_{\beta}^{(q)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>S</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>T</mi><mi>β</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">S_{\alpha}^{(p)}\times T_{\beta}^{(q)}</annotation></semantics></math> of local dimension <math id="A1.SS3.p4.m8" class="ltx_Math" alttext="k+1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k+1</annotation></semantics></math>. Then <math id="A1.SS3.p4.m9" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math> resp. <math id="A1.SS3.p4.m10" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math> is a regular point of <math id="A1.SS3.p4.m11" class="ltx_Math" alttext="S_{\alpha}^{(p)}" display="inline" intent=":literal"><semantics><msubsup><mi>S</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">S_{\alpha}^{(p)}</annotation></semantics></math> resp. <math id="A1.SS3.p4.m12" class="ltx_Math" alttext="T_{\beta}^{(q)}" display="inline" intent=":literal"><semantics><msubsup><mi>T</mi><mi>β</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">T_{\beta}^{(q)}</annotation></semantics></math> of dimension <math id="A1.SS3.p4.m13" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> resp. <math id="A1.SS3.p4.m14" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>. Moreover, (<a href="#A1.E2" title="In Proof. ‣ A.3. Relative case ‣ Appendix A Product of canonical Whitney stratifications ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.2</span></a>) implies that either <math id="A1.SS3.p4.m15" class="ltx_Math" alttext="y\in S_{\alpha}^{(p-1)}" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>∈</mo><msubsup><mi>S</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">y\in S_{\alpha}^{(p-1)}</annotation></semantics></math> or <math id="A1.SS3.p4.m16" class="ltx_Math" alttext="z\in T_{\beta}^{(q-1)}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>∈</mo><msubsup><mi>T</mi><mi>β</mi><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">z\in T_{\beta}^{(q-1)}</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS3.p5" class="ltx_para">
<p id="A1.SS3.p5.1" class="ltx_p"><span id="A1.SS3.p5.1.1" class="ltx_text">We claim that <math id="A1.SS3.p5.m1" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math> is not in the boundary of any <math id="A1.SS3.p5.m2" class="ltx_Math" alttext="\mathring{S}_{\alpha^{\prime}}^{(p^{\prime})}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>S</mi><mo>̊</mo></mover><msup><mi>α</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><msup><mi>p</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\mathring{S}_{\alpha^{\prime}}^{(p^{\prime})}</annotation></semantics></math> with <math id="A1.SS3.p5.m3" class="ltx_Math" alttext="\alpha^{\prime}&gt;\alpha" display="inline" intent=":literal"><semantics><mrow><msup><mi>α</mi><mo>′</mo></msup><mo>&gt;</mo><mi>α</mi></mrow><annotation encoding="application/x-tex">\alpha^{\prime}&gt;\alpha</annotation></semantics></math> and <math id="A1.SS3.p5.m4" class="ltx_Math" alttext="p^{\prime}\leq p" display="inline" intent=":literal"><semantics><mrow><msup><mi>p</mi><mo>′</mo></msup><mo>≤</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">p^{\prime}\leq p</annotation></semantics></math>. If it is the case, assume that <math id="A1.SS3.p5.m5" class="ltx_Math" alttext="z\in\mathring{T}_{\beta}^{(q^{\prime})}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>∈</mo><msubsup><mover accent="true"><mi>T</mi><mo>̊</mo></mover><mi>β</mi><mrow><mo stretchy="false">(</mo><msup><mi>q</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">z\in\mathring{T}_{\beta}^{(q^{\prime})}</annotation></semantics></math> for some <math id="A1.SS3.p5.m6" class="ltx_Math" alttext="q^{\prime}\leq q" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mo>′</mo></msup><mo>≤</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">q^{\prime}\leq q</annotation></semantics></math>. Then we see that</span></p>
<table id="A1.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex16.m1" class="ltx_Math" alttext="x=(y,z)\in\partial\mathring{S}_{\alpha^{\prime}}^{(p^{\prime})}\times\mathring{T}_{\beta}^{(q^{\prime})}\subset\partial\left(\mathring{S}_{\alpha^{\prime}}^{(p^{\prime})}\times\mathring{T}_{\beta}^{(q^{\prime})}\right)\subset\partial\mathring{R}_{(\alpha^{\prime},\beta)}^{(p^{\prime}+q^{\prime})}." display="block" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">∈</mo><mrow><mo>∂</mo><mrow><msubsup><mover accent="true"><mi>S</mi><mo>̊</mo></mover><msup><mi>α</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><msup><mi>p</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mover accent="true"><mi>T</mi><mo>̊</mo></mover><mi>β</mi><mrow><mo stretchy="false">(</mo><msup><mi>q</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo rspace="0.111em">⊂</mo><mrow><mo>∂</mo><mrow><mo>(</mo><mrow><msubsup><mover accent="true"><mi>S</mi><mo>̊</mo></mover><msup><mi>α</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><msup><mi>p</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mover accent="true"><mi>T</mi><mo>̊</mo></mover><mi>β</mi><mrow><mo stretchy="false">(</mo><msup><mi>q</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>)</mo></mrow></mrow><mo rspace="0.111em">⊂</mo><mrow><mo>∂</mo><msubsup><mover accent="true"><mi>R</mi><mo>̊</mo></mover><mrow><mo stretchy="false">(</mo><msup><mi>α</mi><mo>′</mo></msup><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>p</mi><mo>′</mo></msup><mo>+</mo><msup><mi>q</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">x=(y,z)\in\partial\mathring{S}_{\alpha^{\prime}}^{(p^{\prime})}\times\mathring{T}_{\beta}^{(q^{\prime})}\subset\partial\left(\mathring{S}_{\alpha^{\prime}}^{(p^{\prime})}\times\mathring{T}_{\beta}^{(q^{\prime})}\right)\subset\partial\mathring{R}_{(\alpha^{\prime},\beta)}^{(p^{\prime}+q^{\prime})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.p5.2" class="ltx_p"><span id="A1.SS3.p5.2.1" class="ltx_text">Notice that <math id="A1.SS3.p5.m7" class="ltx_Math" alttext="p^{\prime}+q^{\prime}\leq k+1" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>p</mi><mo>′</mo></msup><mo>+</mo><msup><mi>q</mi><mo>′</mo></msup></mrow><mo>≤</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">p^{\prime}+q^{\prime}\leq k+1</annotation></semantics></math> and <math id="A1.SS3.p5.m8" class="ltx_Math" alttext="(\alpha^{\prime},\beta)&gt;(\alpha,\beta)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msup><mi>α</mi><mo>′</mo></msup><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow><mo>&gt;</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(\alpha^{\prime},\beta)&gt;(\alpha,\beta)</annotation></semantics></math>. This contradicts the fact that <math id="A1.SS3.p5.m9" class="ltx_Math" alttext="x\notin R_{(\alpha,\beta)}^{(k)}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∉</mo><msubsup><mi>R</mi><mrow><mo stretchy="false">(</mo><mi>α</mi><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">x\notin R_{(\alpha,\beta)}^{(k)}</annotation></semantics></math>. Similarly, <math id="A1.SS3.p5.m10" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math> is not in the boundary of any <math id="A1.SS3.p5.m11" class="ltx_Math" alttext="\mathring{T}_{\beta^{\prime}}^{(q^{\prime})}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>T</mi><mo>̊</mo></mover><msup><mi>β</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><msup><mi>q</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\mathring{T}_{\beta^{\prime}}^{(q^{\prime})}</annotation></semantics></math> with <math id="A1.SS3.p5.m12" class="ltx_Math" alttext="\beta^{\prime}&gt;\beta" display="inline" intent=":literal"><semantics><mrow><msup><mi>β</mi><mo>′</mo></msup><mo>&gt;</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">\beta^{\prime}&gt;\beta</annotation></semantics></math> and <math id="A1.SS3.p5.m13" class="ltx_Math" alttext="q^{\prime}\leq q" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mo>′</mo></msup><mo>≤</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">q^{\prime}\leq q</annotation></semantics></math>.</span></p>
</div>
<div id="A1.SS3.p6" class="ltx_para">
<p id="A1.SS3.p6.1" class="ltx_p"><span id="A1.SS3.p6.1.1" class="ltx_text">Without loss of generality, assume we are in one of the following two scenarios.</span></p>
</div>
<div id="A1.SS3.p7" class="ltx_para">
<ol id="A1.I6" class="ltx_enumerate">
<li id="A1.I6.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="A1.I6.i1.p1" class="ltx_para">
<p id="A1.I6.i1.p1.1" class="ltx_p"><math id="A1.I6.i1.p1.m1" class="ltx_Math" alttext="y\in S_{\alpha}^{(p-1)}" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>∈</mo><msubsup><mi>S</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">y\in S_{\alpha}^{(p-1)}</annotation></semantics></math> and <math id="A1.I6.i1.p1.m2" class="ltx_Math" alttext="z\in\mathring{T}_{\beta}^{(q)}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>∈</mo><msubsup><mover accent="true"><mi>T</mi><mo>̊</mo></mover><mi>β</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">z\in\mathring{T}_{\beta}^{(q)}</annotation></semantics></math>. Then we know that for some <math id="A1.I6.i1.p1.m3" class="ltx_Math" alttext="\alpha^{\prime}\geq\alpha" display="inline" intent=":literal"><semantics><mrow><msup><mi>α</mi><mo>′</mo></msup><mo>≥</mo><mi>α</mi></mrow><annotation encoding="application/x-tex">\alpha^{\prime}\geq\alpha</annotation></semantics></math> and <math id="A1.I6.i1.p1.m4" class="ltx_Math" alttext="p^{\prime}\geq p+1" display="inline" intent=":literal"><semantics><mrow><msup><mi>p</mi><mo>′</mo></msup><mo>≥</mo><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">p^{\prime}\geq p+1</annotation></semantics></math>, Whitey’s condition (b) fails for the pair <math id="A1.I6.i1.p1.m5" class="ltx_Math" alttext="(\mathring{S}_{\alpha^{\prime}}^{(p^{\prime})},S_{\alpha,reg}^{(p)})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>S</mi><mo>̊</mo></mover><msup><mi>α</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><msup><mi>p</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>S</mi><mrow><mi>α</mi><mo>,</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathring{S}_{\alpha^{\prime}}^{(p^{\prime})},S_{\alpha,reg}^{(p)})</annotation></semantics></math> at <math id="A1.I6.i1.p1.m6" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math>. Then this implies that Whitney’s condition (b) fails for the pair</p>
<table id="A1.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex17.m1" class="ltx_Math" alttext="\left(\mathring{R}_{(\alpha^{\prime},\beta)}^{(p^{\prime}+q)},R_{(\alpha,\beta),reg}^{(p+q)}\right)" display="block" intent=":literal"><semantics><mrow><mo>(</mo><msubsup><mover accent="true"><mi>R</mi><mo>̊</mo></mover><mrow><mo stretchy="false">(</mo><msup><mi>α</mi><mo>′</mo></msup><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>p</mi><mo>′</mo></msup><mo>+</mo><mi>q</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>R</mi><mrow><mrow><mo stretchy="false">(</mo><mi>α</mi><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>+</mo><mi>q</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow><annotation encoding="application/x-tex">\left(\mathring{R}_{(\alpha^{\prime},\beta)}^{(p^{\prime}+q)},R_{(\alpha,\beta),reg}^{(p+q)}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.I6.i1.p1.2" class="ltx_p">at <math id="A1.I6.i1.p1.m7" class="ltx_Math" alttext="x=(y,z)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">x=(y,z)</annotation></semantics></math>. This contradicts the assumption that <math id="A1.I6.i1.p1.m8" class="ltx_Math" alttext="x\notin R_{(\alpha,\beta)}^{(k)}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∉</mo><msubsup><mi>R</mi><mrow><mo stretchy="false">(</mo><mi>α</mi><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">x\notin R_{(\alpha,\beta)}^{(k)}</annotation></semantics></math>.</p>
</div></li>
<li id="A1.I6.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="A1.I6.i2.p1" class="ltx_para">
<p id="A1.I6.i2.p1.1" class="ltx_p"><math id="A1.I6.i2.p1.m1" class="ltx_Math" alttext="y\in S_{\alpha}^{(p-1)}" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>∈</mo><msubsup><mi>S</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">y\in S_{\alpha}^{(p-1)}</annotation></semantics></math> and <math id="A1.I6.i2.p1.m2" class="ltx_Math" alttext="z\in T_{\beta}^{(q-1)}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>∈</mo><msubsup><mi>T</mi><mi>β</mi><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">z\in T_{\beta}^{(q-1)}</annotation></semantics></math>. Then we know for some <math id="A1.I6.i2.p1.m3" class="ltx_Math" alttext="\alpha^{\prime}\geq\alpha" display="inline" intent=":literal"><semantics><mrow><msup><mi>α</mi><mo>′</mo></msup><mo>≥</mo><mi>α</mi></mrow><annotation encoding="application/x-tex">\alpha^{\prime}\geq\alpha</annotation></semantics></math>, <math id="A1.I6.i2.p1.m4" class="ltx_Math" alttext="\beta^{\prime}\geq\beta" display="inline" intent=":literal"><semantics><mrow><msup><mi>β</mi><mo>′</mo></msup><mo>≥</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">\beta^{\prime}\geq\beta</annotation></semantics></math>, <math id="A1.I6.i2.p1.m5" class="ltx_Math" alttext="p^{\prime}\geq p+1" display="inline" intent=":literal"><semantics><mrow><msup><mi>p</mi><mo>′</mo></msup><mo>≥</mo><mrow><mi>p</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">p^{\prime}\geq p+1</annotation></semantics></math>, <math id="A1.I6.i2.p1.m6" class="ltx_Math" alttext="q^{\prime}\geq q+1" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mo>′</mo></msup><mo>≥</mo><mrow><mi>q</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">q^{\prime}\geq q+1</annotation></semantics></math>, Whitney’s condition (b) fails for the pair <math id="A1.I6.i2.p1.m7" class="ltx_Math" alttext="(\mathring{S}_{\alpha^{\prime}}^{(p^{\prime})}\times\mathring{T}_{\beta^{\prime}}^{(q^{\prime})},S_{\alpha,reg}^{(p)}\times T_{\beta,reg}^{(q)})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>S</mi><mo>̊</mo></mover><msup><mi>α</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><msup><mi>p</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mover accent="true"><mi>T</mi><mo>̊</mo></mover><msup><mi>β</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><msup><mi>q</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>,</mo><mrow><msubsup><mi>S</mi><mrow><mi>α</mi><mo>,</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>T</mi><mrow><mi>β</mi><mo>,</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathring{S}_{\alpha^{\prime}}^{(p^{\prime})}\times\mathring{T}_{\beta^{\prime}}^{(q^{\prime})},S_{\alpha,reg}^{(p)}\times T_{\beta,reg}^{(q)})</annotation></semantics></math> at <math id="A1.I6.i2.p1.m8" class="ltx_Math" alttext="(y,z)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(y,z)</annotation></semantics></math>. It follows that Whitney’s condition (b) fails for the pair</p>
<table id="A1.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex18.m1" class="ltx_Math" alttext="\left(\mathring{R}_{(\alpha^{\prime},\beta^{\prime})}^{(p^{\prime}+q^{\prime})},R_{(\alpha,\beta),reg}^{(p+q)}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mo>(</mo><msubsup><mover accent="true"><mi>R</mi><mo>̊</mo></mover><mrow><mo stretchy="false">(</mo><msup><mi>α</mi><mo>′</mo></msup><mo>,</mo><msup><mi>β</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>p</mi><mo>′</mo></msup><mo>+</mo><msup><mi>q</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>R</mi><mrow><mrow><mo stretchy="false">(</mo><mi>α</mi><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>+</mo><mi>q</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left(\mathring{R}_{(\alpha^{\prime},\beta^{\prime})}^{(p^{\prime}+q^{\prime})},R_{(\alpha,\beta),reg}^{(p+q)}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.I6.i2.p1.2" class="ltx_p">at <math id="A1.I6.i2.p1.m9" class="ltx_Math" alttext="x=(y,z)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">x=(y,z)</annotation></semantics></math>. This contradicts the assumption that <math id="A1.I6.i2.p1.m10" class="ltx_Math" alttext="x\notin R_{(\alpha,\beta)}^{(k)}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∉</mo><msubsup><mi>R</mi><mrow><mo stretchy="false">(</mo><mi>α</mi><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">x\notin R_{(\alpha,\beta)}^{(k)}</annotation></semantics></math>.</p>
</div></li>
</ol>
<p id="A1.SS3.p7.1" class="ltx_p"><span id="A1.SS3.p7.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
</section>
<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>Relative stable equivariant smoothing</h2>

<div id="A2.p1" class="ltx_para">
<p id="A2.p1.1" class="ltx_p">Our construction in this paper relies on equivariant smoothings of infintely many moduli spaces. It is necessary to have an extension of the stable <math id="A2.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-smoothing results of Lashof <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx24" title="" class="ltx_ref">Las79</a>]</cite> to a relative setting. Namely, if a <math id="A2.p1.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-manifold <math id="A2.p1.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> has a <math id="A2.p1.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-smoothing over an open set, then one can extend the existing smoothing to <math id="A2.p1.m5" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> once the tangent microbundle admits a <math id="A2.p1.m6" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-vector bundle reduction which is compatible with the existing smoothing.</p>
</div>
<div id="A2.p2" class="ltx_para">
<p id="A2.p2.1" class="ltx_p">Lashof’s original construction relies on two technical results. The first one is Mostow’s embedding theorem <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx29" title="" class="ltx_ref">Mos57</a>]</cite> and the second is Jaworowski’s extension theorem <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx22" title="" class="ltx_ref">Jaw76</a>]</cite>. We need to recall these two theorems in order to obtain a generalization of Lashof’s results on stable <math id="A2.p2.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-smoothing to the relative setting.</p>
</div>
<div id="A2.Thmthm1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmthm1.2" class="ltx_text ltx_font_bold">Lemma B.1</span></span><span id="A2.Thmthm1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmthm1.p1" class="ltx_para">
<p id="A2.Thmthm1.p1.1" class="ltx_p"><cite class="ltx_cite ltx_citemacro_cite"><span id="A2.Thmthm1.p1.1.1" class="ltx_text ltx_font_italic">[</span><a href="#bib.bibx29" title="" class="ltx_ref">Mos57</a><span id="A2.Thmthm1.p1.1.2" class="ltx_text ltx_font_italic">, Lemma 5.2]</span></cite><span id="A2.Thmthm1.p1.1.3" class="ltx_text ltx_font_italic"> 
Let <math id="A2.Thmthm1.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> be a compact Lie group of transformations on a metric space <math id="A2.Thmthm1.p1.m2" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>, and let <math id="A2.Thmthm1.p1.m3" class="ltx_Math" alttext="T_{1},T_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>,</mo><msub><mi>T</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">T_{1},T_{2}</annotation></semantics></math> be invariant subsets with <math id="A2.Thmthm1.p1.m4" class="ltx_Math" alttext="E=T_{1}\cup T_{2}" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>=</mo><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>∪</mo><msub><mi>T</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">E=T_{1}\cup T_{2}</annotation></semantics></math> and <math id="A2.Thmthm1.p1.m5" class="ltx_Math" alttext="T_{2}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mn>2</mn></msub><annotation encoding="application/x-tex">T_{2}</annotation></semantics></math> be closed. Assume that there exist <math id="A2.Thmthm1.p1.m6" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant topological embeddings <math id="A2.Thmthm1.p1.m7" class="ltx_Math" alttext="\varphi_{i}:T_{i}\to{\bm{R}}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>φ</mi><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo stretchy="false">→</mo><msub><mi>𝐑</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\varphi_{i}:T_{i}\to{\bm{R}}_{i}</annotation></semantics></math>, <math id="A2.Thmthm1.p1.m8" class="ltx_Math" alttext="i=1,2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">i=1,2</annotation></semantics></math> where <math id="A2.Thmthm1.p1.m9" class="ltx_Math" alttext="{\bm{R}}_{1},{\bm{R}}_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐑</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝐑</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">{\bm{R}}_{1},{\bm{R}}_{2}</annotation></semantics></math> are orthogonal <math id="A2.Thmthm1.p1.m10" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-spaces. Then there exists a <math id="A2.Thmthm1.p1.m11" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant topological embedding <math id="A2.Thmthm1.p1.m12" class="ltx_Math" alttext="\varphi:E\to{\bm{R}}_{1}\oplus{\bm{R}}_{2}" display="inline" intent=":literal"><semantics><mrow><mi>φ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>E</mi><mo stretchy="false">→</mo><mrow><msub><mi>𝐑</mi><mn>1</mn></msub><mo>⊕</mo><msub><mi>𝐑</mi><mn>2</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\varphi:E\to{\bm{R}}_{1}\oplus{\bm{R}}_{2}</annotation></semantics></math> such that</span></p>
<table id="A2.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex1.m1" class="ltx_Math" alttext="\varphi|_{T_{2}}=(0,\varphi_{2})." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mi>φ</mi><mo stretchy="false">|</mo></mrow><msub><mi>T</mi><mn>2</mn></msub></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msub><mi>φ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\varphi|_{T_{2}}=(0,\varphi_{2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A2.Thmthm2" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmthm2.2" class="ltx_text ltx_font_bold">Theorem B.2</span></span><span id="A2.Thmthm2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmthm2.p1" class="ltx_para">
<p id="A2.Thmthm2.p1.1" class="ltx_p"><cite class="ltx_cite ltx_citemacro_cite"><span id="A2.Thmthm2.p1.1.1" class="ltx_text ltx_font_italic">[</span><a href="#bib.bibx22" title="" class="ltx_ref">Jaw76</a><span id="A2.Thmthm2.p1.1.2" class="ltx_text ltx_font_italic">, Theorem 2.2]</span></cite><span id="A2.Thmthm2.p1.1.3" class="ltx_text ltx_font_italic">
Let <math id="A2.Thmthm2.p1.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> be a locally compact <math id="A2.Thmthm2.p1.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-space which can be equivariantly embedded into some finite-dimensional orthogonal <math id="A2.Thmthm2.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-vector space. Suppose <math id="A2.Thmthm2.p1.m4" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> has only finitely many orbit types. Let <math id="A2.Thmthm2.p1.m5" class="ltx_Math" alttext="A\subset X" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>⊂</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">A\subset X</annotation></semantics></math> be a closed <math id="A2.Thmthm2.p1.m6" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-subspace and <math id="A2.Thmthm2.p1.m7" class="ltx_Math" alttext="f:A\to Y" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>A</mi><mo stretchy="false">→</mo><mi>Y</mi></mrow></mrow><annotation encoding="application/x-tex">f:A\to Y</annotation></semantics></math> be a continuous <math id="A2.Thmthm2.p1.m8" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-map to a locally compact separable metrizable <math id="A2.Thmthm2.p1.m9" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-space <math id="A2.Thmthm2.p1.m10" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>. If for each <math id="A2.Thmthm2.p1.m11" class="ltx_Math" alttext="x\in X\setminus A" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><mi>X</mi><mo>∖</mo><mi>A</mi></mrow></mrow><annotation encoding="application/x-tex">x\in X\setminus A</annotation></semantics></math> the fixed point set <math id="A2.Thmthm2.p1.m12" class="ltx_Math" alttext="Y^{G_{x}}" display="inline" intent=":literal"><semantics><msup><mi>Y</mi><msub><mi>G</mi><mi>x</mi></msub></msup><annotation encoding="application/x-tex">Y^{G_{x}}</annotation></semantics></math> is an ANR (absolute neighborhood retract), then <math id="A2.Thmthm2.p1.m13" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> can be extended to a continuous <math id="A2.Thmthm2.p1.m14" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-map from a neighborhood of <math id="A2.Thmthm2.p1.m15" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> in <math id="A2.Thmthm2.p1.m16" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A2.p3" class="ltx_para">
<p id="A2.p3.1" class="ltx_p">Now we want to extend Lashof’s construction to a relative setting.</p>
</div>
<div id="A2.Thmthm3" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmthm3.2" class="ltx_text ltx_font_bold">Theorem B.3</span></span><span id="A2.Thmthm3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmthm3.p1" class="ltx_para">
<p id="A2.Thmthm3.p1.1" class="ltx_p"><span id="A2.Thmthm3.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A2.Thmthm3.p1.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> be a topological <math id="A2.Thmthm3.p1.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-manifold with only finitely many orbit types. Let <math id="A2.Thmthm3.p1.m3" class="ltx_Math" alttext="O\subset M" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⊂</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">O\subset M</annotation></semantics></math> be an open subset such that its closure <math id="A2.Thmthm3.p1.m4" class="ltx_Math" alttext="\overline{O}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>O</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{O}</annotation></semantics></math> is compact. Suppose that</span></p>
<ol id="A2.I1" class="ltx_enumerate">
<li id="A2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="A2.I1.i1.p1" class="ltx_para">
<p id="A2.I1.i1.p1.1" class="ltx_p"><span id="A2.I1.i1.p1.1.1" class="ltx_text ltx_font_italic">the tangent microbundle </span><math id="A2.I1.i1.p1.m1" class="ltx_Math" alttext="T_{\mu}M" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">T_{\mu}M</annotation></semantics></math><span id="A2.I1.i1.p1.1.2" class="ltx_text ltx_font_italic"> of </span><math id="A2.I1.i1.p1.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math><span id="A2.I1.i1.p1.1.3" class="ltx_text ltx_font_italic"> admits a </span><math id="A2.I1.i1.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math><span id="A2.I1.i1.p1.1.4" class="ltx_text ltx_font_italic">-vector bundle reduction </span><math id="A2.I1.i1.p1.m4" class="ltx_Math" alttext="\varphi:E_{\mu}\to T_{\mu}M" display="inline" intent=":literal"><semantics><mrow><mi>φ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>E</mi><mi>μ</mi></msub><mo stretchy="false">→</mo><mrow><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\varphi:E_{\mu}\to T_{\mu}M</annotation></semantics></math><span id="A2.I1.i1.p1.1.5" class="ltx_text ltx_font_italic"> for a vector bundle </span><math id="A2.I1.i1.p1.m5" class="ltx_Math" alttext="E\to M" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">E\to M</annotation></semantics></math><span id="A2.I1.i1.p1.1.6" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="A2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="A2.I1.i2.p1" class="ltx_para">
<p id="A2.I1.i2.p1.1" class="ltx_p"><span id="A2.I1.i2.p1.1.1" class="ltx_text ltx_font_italic">A </span><math id="A2.I1.i2.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math><span id="A2.I1.i2.p1.1.2" class="ltx_text ltx_font_italic">-invariant open neighborhood </span><math id="A2.I1.i2.p1.m2" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math><span id="A2.I1.i2.p1.1.3" class="ltx_text ltx_font_italic"> of </span><math id="A2.I1.i2.p1.m3" class="ltx_Math" alttext="\overline{O}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>O</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{O}</annotation></semantics></math><span id="A2.I1.i2.p1.1.4" class="ltx_text ltx_font_italic"> is equipped with a </span><math id="A2.I1.i2.p1.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math><span id="A2.I1.i2.p1.1.5" class="ltx_text ltx_font_italic">-smoothing and </span><math id="A2.I1.i2.p1.m5" class="ltx_Math" alttext="E|_{U}" display="inline" intent=":literal"><semantics><msub><mrow><mi>E</mi><mo stretchy="false">|</mo></mrow><mi>U</mi></msub><annotation encoding="application/x-tex">E|_{U}</annotation></semantics></math><span id="A2.I1.i2.p1.1.6" class="ltx_text ltx_font_italic"> is equipped with a smooth </span><math id="A2.I1.i2.p1.m6" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math><span id="A2.I1.i2.p1.1.7" class="ltx_text ltx_font_italic">-bundle structure such that the reduction </span><math id="A2.I1.i2.p1.m7" class="ltx_Math" alttext="\varphi" display="inline" intent=":literal"><semantics><mi>φ</mi><annotation encoding="application/x-tex">\varphi</annotation></semantics></math><span id="A2.I1.i2.p1.1.8" class="ltx_text ltx_font_italic"> is smooth over </span><math id="A2.I1.i2.p1.m8" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math><span id="A2.I1.i2.p1.1.9" class="ltx_text ltx_font_italic">. Moreover, </span><math id="A2.I1.i2.p1.m9" class="ltx_Math" alttext="\varphi" display="inline" intent=":literal"><semantics><mi>φ</mi><annotation encoding="application/x-tex">\varphi</annotation></semantics></math><span id="A2.I1.i2.p1.1.10" class="ltx_text ltx_font_italic"> is in the same isotopy class of the canonical </span><math id="A2.I1.i2.p1.m10" class="ltx_Math" alttext="TU\to T_{\mu}U" display="inline" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>U</mi></mrow><mo stretchy="false">→</mo><mrow><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>U</mi></mrow></mrow><annotation encoding="application/x-tex">TU\to T_{\mu}U</annotation></semantics></math><span id="A2.I1.i2.p1.1.11" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
<p id="A2.Thmthm3.p1.2" class="ltx_p"><span id="A2.Thmthm3.p1.2.1" class="ltx_text ltx_font_italic">Then there exists a finite-dimensional orthogonal representation <math id="A2.Thmthm3.p1.m5" class="ltx_Math" alttext="{\bm{R}}" display="inline" intent=":literal"><semantics><mi>𝐑</mi><annotation encoding="application/x-tex">{\bm{R}}</annotation></semantics></math> of <math id="A2.Thmthm3.p1.m6" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> and a <math id="A2.Thmthm3.p1.m7" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-smoothing <math id="A2.Thmthm3.p1.m8" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> on <math id="A2.Thmthm3.p1.m9" class="ltx_Math" alttext="M\times{\bm{R}}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝐑</mi></mrow><annotation encoding="application/x-tex">M\times{\bm{R}}</annotation></semantics></math> satisfying</span></p>
<ol id="A2.I2" class="ltx_enumerate">
<li id="A2.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="A2.I2.i1.p1" class="ltx_para">
<p id="A2.I2.i1.p1.1" class="ltx_p"><span id="A2.I2.i1.p1.1.1" class="ltx_text ltx_font_italic">The induced stable isotopy class of </span><math id="A2.I2.i1.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math><span id="A2.I2.i1.p1.1.2" class="ltx_text ltx_font_italic">-vector bundle reductions of </span><math id="A2.I2.i1.p1.m2" class="ltx_Math" alttext="T_{\mu}(M\times R)" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T_{\mu}(M\times R)</annotation></semantics></math><span id="A2.I2.i1.p1.1.3" class="ltx_text ltx_font_italic"> coincides with the </span><math id="A2.I2.i1.p1.m3" class="ltx_Math" alttext="{\bm{R}}" display="inline" intent=":literal"><semantics><mi>𝑹</mi><annotation encoding="application/x-tex">{\bm{R}}</annotation></semantics></math><span id="A2.I2.i1.p1.1.4" class="ltx_text ltx_font_italic">-stabilization of </span><math id="A2.I2.i1.p1.m4" class="ltx_Math" alttext="\varphi" display="inline" intent=":literal"><semantics><mi>φ</mi><annotation encoding="application/x-tex">\varphi</annotation></semantics></math><span id="A2.I2.i1.p1.1.5" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="A2.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="A2.I2.i2.p1" class="ltx_para">
<p id="A2.I2.i2.p1.1" class="ltx_p"><span id="A2.I2.i2.p1.1.1" class="ltx_text ltx_font_italic">There exists a </span><math id="A2.I2.i2.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math><span id="A2.I2.i2.p1.1.2" class="ltx_text ltx_font_italic">-invariant open neighborhood </span><math id="A2.I2.i2.p1.m2" class="ltx_Math" alttext="U^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>U</mi><mo>′</mo></msup><annotation encoding="application/x-tex">U^{\prime}</annotation></semantics></math><span id="A2.I2.i2.p1.1.3" class="ltx_text ltx_font_italic"> of </span><math id="A2.I2.i2.p1.m3" class="ltx_Math" alttext="\overline{O}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>O</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{O}</annotation></semantics></math><span id="A2.I2.i2.p1.1.4" class="ltx_text ltx_font_italic"> with </span><math id="A2.I2.i2.p1.m4" class="ltx_Math" alttext="\overline{U^{\prime}}\subset U" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><msup><mi>U</mi><mo>′</mo></msup><mo stretchy="true">¯</mo></mover><mo>⊂</mo><mi>U</mi></mrow><annotation encoding="application/x-tex">\overline{U^{\prime}}\subset U</annotation></semantics></math><span id="A2.I2.i2.p1.1.5" class="ltx_text ltx_font_italic">, such that the restriction of the </span><math id="A2.I2.i2.p1.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math><span id="A2.I2.i2.p1.1.6" class="ltx_text ltx_font_italic">-smoothing </span><math id="A2.I2.i2.p1.m6" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math><span id="A2.I2.i2.p1.1.7" class="ltx_text ltx_font_italic"> on </span><math id="A2.I2.i2.p1.m7" class="ltx_Math" alttext="U^{\prime}\times{\bm{R}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>U</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑹</mi></mrow><annotation encoding="application/x-tex">U^{\prime}\times{\bm{R}}</annotation></semantics></math><span id="A2.I2.i2.p1.1.8" class="ltx_text ltx_font_italic"> is diffeomorphic to the given </span><math id="A2.I2.i2.p1.m8" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math><span id="A2.I2.i2.p1.1.9" class="ltx_text ltx_font_italic">-smoothing on </span><math id="A2.I2.i2.p1.m9" class="ltx_Math" alttext="U^{\prime}\times{\bm{R}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>U</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑹</mi></mrow><annotation encoding="application/x-tex">U^{\prime}\times{\bm{R}}</annotation></semantics></math><span id="A2.I2.i2.p1.1.10" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="A2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.p4" class="ltx_para">
<p id="A2.p4.1" class="ltx_p"><span id="A2.p4.1.1" class="ltx_text">We generalize the construction of Lashof <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx24" title="" class="ltx_ref">Las79</a>]</cite> to the current setting. We first consider the case that <math id="A2.p4.m1" class="ltx_Math" alttext="E\to M" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">E\to M</annotation></semantics></math> is trivial. Assume that</span></p>
<table id="A2.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex2.m1" class="ltx_Math" alttext="E=M\times{\bm{W}}" display="block" intent=":literal"><semantics><mrow><mi>E</mi><mo>=</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑾</mi></mrow></mrow><annotation encoding="application/x-tex">E=M\times{\bm{W}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p4.2" class="ltx_p"><span id="A2.p4.2.1" class="ltx_text">where <math id="A2.p4.m2" class="ltx_Math" alttext="{\bm{W}}" display="inline" intent=":literal"><semantics><mi>𝑾</mi><annotation encoding="application/x-tex">{\bm{W}}</annotation></semantics></math> is an orthogonal <math id="A2.p4.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-space. The vector bundle lift is given by a map</span></p>
<table id="A2.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex3.m1" class="ltx_Math" alttext="\exp:M\times{\bm{W}}\to M\times M" display="block" intent=":literal"><semantics><mrow><mi>exp</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑾</mi></mrow><mo stretchy="false">→</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\exp:M\times{\bm{W}}\to M\times M</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p4.3" class="ltx_p"><span id="A2.p4.3.1" class="ltx_text">which is smooth over <math id="A2.p4.m4" class="ltx_Math" alttext="U\times{\bm{W}}" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑾</mi></mrow><annotation encoding="application/x-tex">U\times{\bm{W}}</annotation></semantics></math>. For each <math id="A2.p4.m5" class="ltx_Math" alttext="x\in M" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">x\in M</annotation></semantics></math>, denote the restriction of <math id="A2.p4.m6" class="ltx_Math" alttext="\exp" display="inline" intent=":literal"><semantics><mi>exp</mi><annotation encoding="application/x-tex">\exp</annotation></semantics></math> to <math id="A2.p4.m7" class="ltx_Math" alttext="\{x\}\times{\bm{W}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">}</mo></mrow><mo rspace="0.222em">×</mo><mi>𝑾</mi></mrow><annotation encoding="application/x-tex">\{x\}\times{\bm{W}}</annotation></semantics></math> by</span></p>
<table id="A2.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex4.m1" class="ltx_Math" alttext="\exp_{x}:{\bm{W}}\to\{x\}\times M" display="block" intent=":literal"><semantics><mrow><msub><mi>exp</mi><mi>x</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>𝑾</mi><mo stretchy="false">→</mo><mrow><mrow><mo stretchy="false">{</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">}</mo></mrow><mo rspace="0.222em">×</mo><mi>M</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\exp_{x}:{\bm{W}}\to\{x\}\times M</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p4.4" class="ltx_p"><span id="A2.p4.4.1" class="ltx_text">which is a homeomorphism onto an open neighborhood of <math id="A2.p4.m8" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>.</span></p>
</div>
<div id="A2.p5" class="ltx_para">
<p id="A2.p5.1" class="ltx_p"><span id="A2.p5.1.1" class="ltx_text">Now we prove the following claims.</span></p>
</div>
<div id="A2.p6" class="ltx_para ltx_noindent">
<p id="A2.p6.1" class="ltx_p"><span id="A2.p6.1.1" class="ltx_text ltx_font_italic">Claim A. There exist an orthogonal <math id="A2.p6.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-representation <math id="A2.p6.m2" class="ltx_Math" alttext="{\bm{R}}" display="inline" intent=":literal"><semantics><mi>𝐑</mi><annotation encoding="application/x-tex">{\bm{R}}</annotation></semantics></math> and a <math id="A2.p6.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant topological embedding <math id="A2.p6.m4" class="ltx_Math" alttext="\iota:M\to{\bm{R}}" display="inline" intent=":literal"><semantics><mrow><mi>ι</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mi>𝐑</mi></mrow></mrow><annotation encoding="application/x-tex">\iota:M\to{\bm{R}}</annotation></semantics></math> which is smooth near <math id="A2.p6.m5" class="ltx_Math" alttext="\overline{O}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>O</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{O}</annotation></semantics></math>. </span></p>
</div>
<div id="A2.p7" class="ltx_para ltx_noindent">
<p id="A2.p7.1" class="ltx_p"><span id="A2.p7.1.1" class="ltx_text ltx_font_italic">Proof of Claim A.</span> As <math id="A2.p7.m1" class="ltx_Math" alttext="\overline{O}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>O</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{O}</annotation></semantics></math> is compact, by a theorem of Palais (see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx31" title="" class="ltx_ref">Pal57</a>, Theorem III]</cite>), there is a smooth <math id="A2.p7.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant embedding from an open neighborhood of <math id="A2.p7.m3" class="ltx_Math" alttext="\overline{O}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>O</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{O}</annotation></semantics></math> into an orthogonal <math id="A2.p7.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-space <math id="A2.p7.m5" class="ltx_Math" alttext="{\bm{R}}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝑹</mi><mn>1</mn></msub><annotation encoding="application/x-tex">{\bm{R}}_{1}</annotation></semantics></math>. We may assume that this embedding is defined and smooth over <math id="A2.p7.m6" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>, denoted by <math id="A2.p7.m7" class="ltx_Math" alttext="\iota_{U}:U\to{\bm{R}}_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ι</mi><mi>U</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>U</mi><mo stretchy="false">→</mo><msub><mi>𝑹</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\iota_{U}:U\to{\bm{R}}_{1}</annotation></semantics></math>. Let <math id="A2.p7.m8" class="ltx_Math" alttext="U^{\prime}\subset U" display="inline" intent=":literal"><semantics><mrow><msup><mi>U</mi><mo>′</mo></msup><mo>⊂</mo><mi>U</mi></mrow><annotation encoding="application/x-tex">U^{\prime}\subset U</annotation></semantics></math> be a <math id="A2.p7.m9" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant open neighborhood of <math id="A2.p7.m10" class="ltx_Math" alttext="\overline{O}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>O</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{O}</annotation></semantics></math> such that <math id="A2.p7.m11" class="ltx_Math" alttext="\overline{U^{\prime}}\subset U" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><msup><mi>U</mi><mo>′</mo></msup><mo stretchy="true">¯</mo></mover><mo>⊂</mo><mi>U</mi></mrow><annotation encoding="application/x-tex">\overline{U^{\prime}}\subset U</annotation></semantics></math>. Then <math id="A2.p7.m12" class="ltx_Math" alttext="M^{\prime}:=M\setminus\overline{U^{\prime}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>M</mi><mo>′</mo></msup><mo>:=</mo><mrow><mi>M</mi><mo>∖</mo><mover accent="true"><msup><mi>U</mi><mo>′</mo></msup><mo stretchy="true">¯</mo></mover></mrow></mrow><annotation encoding="application/x-tex">M^{\prime}:=M\setminus\overline{U^{\prime}}</annotation></semantics></math> is a topological <math id="A2.p7.m13" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-manifold with only finitely many orbit types. Hence by Mostow’s embedding theorem (Theorem <a href="#A2.Thmthm1" title="Lemma B.1. ‣ Appendix B Relative stable equivariant smoothing ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1</span></a>), there exists a <math id="A2.p7.m14" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-orthogonal representation <math id="A2.p7.m15" class="ltx_Math" alttext="{\bm{R}}_{2}" display="inline" intent=":literal"><semantics><msub><mi>𝑹</mi><mn>2</mn></msub><annotation encoding="application/x-tex">{\bm{R}}_{2}</annotation></semantics></math> and a <math id="A2.p7.m16" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant topological embedding <math id="A2.p7.m17" class="ltx_Math" alttext="\iota_{M^{\prime}}:M^{\prime}\to{\bm{R}}_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ι</mi><msup><mi>M</mi><mo>′</mo></msup></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>M</mi><mo>′</mo></msup><mo stretchy="false">→</mo><msub><mi>𝑹</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\iota_{M^{\prime}}:M^{\prime}\to{\bm{R}}_{2}</annotation></semantics></math>. Then by Lemma <a href="#A2.Thmthm1" title="Lemma B.1. ‣ Appendix B Relative stable equivariant smoothing ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1</span></a>, writing <math id="A2.p7.m18" class="ltx_Math" alttext="M=\overline{U^{\prime}}\cup M^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>=</mo><mrow><mover accent="true"><msup><mi>U</mi><mo>′</mo></msup><mo stretchy="true">¯</mo></mover><mo>∪</mo><msup><mi>M</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">M=\overline{U^{\prime}}\cup M^{\prime}</annotation></semantics></math>, there exists a <math id="A2.p7.m19" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant topological embedding</p>
<table id="A2.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex5.m1" class="ltx_Math" alttext="\iota:M\to{\bm{R}}_{1}\oplus{\bm{R}}_{2}" display="block" intent=":literal"><semantics><mrow><mi>ι</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mrow><msub><mi>𝑹</mi><mn>1</mn></msub><mo>⊕</mo><msub><mi>𝑹</mi><mn>2</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\iota:M\to{\bm{R}}_{1}\oplus{\bm{R}}_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p7.2" class="ltx_p">such that its restriction to <math id="A2.p7.m20" class="ltx_Math" alttext="\overline{U^{\prime}}" display="inline" intent=":literal"><semantics><mover accent="true"><msup><mi>U</mi><mo>′</mo></msup><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{U^{\prime}}</annotation></semantics></math> coincides with <math id="A2.p7.m21" class="ltx_Math" alttext="(\iota_{U},0)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>ι</mi><mi>U</mi></msub><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\iota_{U},0)</annotation></semantics></math>. In particular, the restriction of <math id="A2.p7.m22" class="ltx_Math" alttext="\iota" display="inline" intent=":literal"><semantics><mi>ι</mi><annotation encoding="application/x-tex">\iota</annotation></semantics></math> to <math id="A2.p7.m23" class="ltx_Math" alttext="U^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>U</mi><mo>′</mo></msup><annotation encoding="application/x-tex">U^{\prime}</annotation></semantics></math> is smooth. Now define <math id="A2.p7.m24" class="ltx_Math" alttext="{\bm{R}}:={\bm{R}}_{1}\oplus{\bm{R}}_{2}" display="inline" intent=":literal"><semantics><mrow><mi>𝑹</mi><mo>:=</mo><mrow><msub><mi>𝑹</mi><mn>1</mn></msub><mo>⊕</mo><msub><mi>𝑹</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">{\bm{R}}:={\bm{R}}_{1}\oplus{\bm{R}}_{2}</annotation></semantics></math>.  <span id="A2.p7.2.1" class="ltx_text ltx_font_italic">End of the proof of Claim A.</span></p>
</div>
<div id="A2.p8" class="ltx_para ltx_noindent">
<p id="A2.p8.1" class="ltx_p"><span id="A2.p8.1.1" class="ltx_text ltx_font_italic">Claim B. There is a <math id="A2.p8.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant open neighborhood <math id="A2.p8.m2" class="ltx_Math" alttext="N_{\iota}\subset{\bm{R}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mi>ι</mi></msub><mo>⊂</mo><mi>𝐑</mi></mrow><annotation encoding="application/x-tex">N_{\iota}\subset{\bm{R}}</annotation></semantics></math> and a continuous <math id="A2.p8.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant retraction <math id="A2.p8.m4" class="ltx_Math" alttext="r:N_{\iota}\to\iota(M)" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>N</mi><mi>ι</mi></msub><mo stretchy="false">→</mo><mrow><mi>ι</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">r:N_{\iota}\to\iota(M)</annotation></semantics></math> which is smooth near <math id="A2.p8.m5" class="ltx_Math" alttext="\iota(\overline{O})" display="inline" intent=":literal"><semantics><mrow><mi>ι</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>O</mi><mo stretchy="true">¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\iota(\overline{O})</annotation></semantics></math>. </span></p>
</div>
<div id="A2.p9" class="ltx_para ltx_noindent">
<p id="A2.p9.1" class="ltx_p"><span id="A2.p9.1.1" class="ltx_text ltx_font_italic">Proof of Claim B.</span> Note that there exist a <math id="A2.p9.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant open neighborhood <math id="A2.p9.m2" class="ltx_Math" alttext="N_{U^{\prime}}\subset{\bm{R}}_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><msup><mi>U</mi><mo>′</mo></msup></msub><mo>⊂</mo><msub><mi>𝑹</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">N_{U^{\prime}}\subset{\bm{R}}_{1}</annotation></semantics></math> of <math id="A2.p9.m3" class="ltx_Math" alttext="\iota_{U}(U^{\prime})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ι</mi><mi>U</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>U</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\iota_{U}(U^{\prime})</annotation></semantics></math> and a smooth <math id="A2.p9.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant retraction</p>
<table id="A2.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex6.m1" class="ltx_Math" alttext="r_{U^{\prime}}:\overline{N_{U^{\prime}}}\to\iota_{U}(U^{\prime})." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>r</mi><msup><mi>U</mi><mo>′</mo></msup></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mover accent="true"><msub><mi>N</mi><msup><mi>U</mi><mo>′</mo></msup></msub><mo stretchy="true">¯</mo></mover><mo stretchy="false">→</mo><mrow><msub><mi>ι</mi><mi>U</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>U</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">r_{U^{\prime}}:\overline{N_{U^{\prime}}}\to\iota_{U}(U^{\prime}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p9.2" class="ltx_p">Then <math id="A2.p9.m5" class="ltx_Math" alttext="r_{U^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><msup><mi>U</mi><mo>′</mo></msup></msub><annotation encoding="application/x-tex">r_{U^{\prime}}</annotation></semantics></math> induces a retraction from <math id="A2.p9.m6" class="ltx_Math" alttext="\overline{N_{U^{\prime}}}\times{\bm{R}}_{2}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><msub><mi>N</mi><msup><mi>U</mi><mo>′</mo></msup></msub><mo stretchy="true">¯</mo></mover><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝑹</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\overline{N_{U^{\prime}}}\times{\bm{R}}_{2}</annotation></semantics></math> to <math id="A2.p9.m7" class="ltx_Math" alttext="\iota(U^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>ι</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>U</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\iota(U^{\prime})</annotation></semantics></math>. Choose a smaller open neighborhood <math id="A2.p9.m8" class="ltx_Math" alttext="U^{\prime\prime}" display="inline" intent=":literal"><semantics><msup><mi>U</mi><mo>′′</mo></msup><annotation encoding="application/x-tex">U^{\prime\prime}</annotation></semantics></math> of <math id="A2.p9.m9" class="ltx_Math" alttext="\overline{O}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>O</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{O}</annotation></semantics></math> with <math id="A2.p9.m10" class="ltx_Math" alttext="\overline{U^{\prime\prime}}\subset U^{\prime}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><msup><mi>U</mi><mo>′′</mo></msup><mo stretchy="true">¯</mo></mover><mo>⊂</mo><msup><mi>U</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">\overline{U^{\prime\prime}}\subset U^{\prime}</annotation></semantics></math>. By applying Jaworowski’s extension theorem (Theorem <a href="#A2.Thmthm2" title="Theorem B.2. ‣ Appendix B Relative stable equivariant smoothing ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a>) to <math id="A2.p9.m11" class="ltx_Math" alttext="X={\bm{R}}_{1}\oplus{\bm{R}}_{2}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>=</mo><mrow><msub><mi>𝑹</mi><mn>1</mn></msub><mo>⊕</mo><msub><mi>𝑹</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">X={\bm{R}}_{1}\oplus{\bm{R}}_{2}</annotation></semantics></math>, <math id="A2.p9.m12" class="ltx_Math" alttext="A=(r_{U^{\prime}}^{-1}(\overline{U^{\prime\prime}})\times{\bm{R}}_{2})\cup\iota(M)" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>r</mi><msup><mi>U</mi><mo>′</mo></msup><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><msup><mi>U</mi><mo>′′</mo></msup><mo stretchy="true">¯</mo></mover><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">×</mo><msub><mi>𝑹</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo>∪</mo><mrow><mi>ι</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">A=(r_{U^{\prime}}^{-1}(\overline{U^{\prime\prime}})\times{\bm{R}}_{2})\cup\iota(M)</annotation></semantics></math>, and <math id="A2.p9.m13" class="ltx_Math" alttext="Y=\iota(M)" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><mo>=</mo><mrow><mi>ι</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Y=\iota(M)</annotation></semantics></math>, one obtains an extension, i.e., a <math id="A2.p9.m14" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant open neighborhood <math id="A2.p9.m15" class="ltx_Math" alttext="N_{\iota}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>ι</mi></msub><annotation encoding="application/x-tex">N_{\iota}</annotation></semantics></math> of <math id="A2.p9.m16" class="ltx_Math" alttext="\iota(M)" display="inline" intent=":literal"><semantics><mrow><mi>ι</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\iota(M)</annotation></semantics></math> and a <math id="A2.p9.m17" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant retraction <math id="A2.p9.m18" class="ltx_Math" alttext="r:N_{\iota}\to\iota(M)" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>N</mi><mi>ι</mi></msub><mo stretchy="false">→</mo><mrow><mi>ι</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">r:N_{\iota}\to\iota(M)</annotation></semantics></math> which coincides with <math id="A2.p9.m19" class="ltx_Math" alttext="r_{U^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><msup><mi>U</mi><mo>′</mo></msup></msub><annotation encoding="application/x-tex">r_{U^{\prime}}</annotation></semantics></math> near <math id="A2.p9.m20" class="ltx_Math" alttext="\iota(\overline{U^{\prime\prime}})" display="inline" intent=":literal"><semantics><mrow><mi>ι</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><msup><mi>U</mi><mo>′′</mo></msup><mo stretchy="true">¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\iota(\overline{U^{\prime\prime}})</annotation></semantics></math>. Indeed, such an extension is a retraction because it extends the identity map <math id="A2.p9.m21" class="ltx_Math" alttext="Y\to Y" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><mo stretchy="false">→</mo><mi>Y</mi></mrow><annotation encoding="application/x-tex">Y\to Y</annotation></semantics></math>. In particular, it is smooth near <math id="A2.p9.m22" class="ltx_Math" alttext="\iota(\overline{O})" display="inline" intent=":literal"><semantics><mrow><mi>ι</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>O</mi><mo stretchy="true">¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\iota(\overline{O})</annotation></semantics></math>.  <span id="A2.p9.2.1" class="ltx_text ltx_font_italic">End of the proof of Claim B.</span></p>
</div>
<div id="A2.p10" class="ltx_para">
<p id="A2.p10.1" class="ltx_p"><span id="A2.p10.1.1" class="ltx_text ltx_font_italic">Claim C. There is a </span><math id="A2.p10.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math><span id="A2.p10.1.2" class="ltx_text ltx_font_italic">-equivariant continuous map</span></p>
<table id="A2.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex7.m1" class="ltx_Math" alttext="\psi:M\times{\bm{R}}\to{\bm{R}}\times{\bm{W}}" display="block" intent=":literal"><semantics><mrow><mi>ψ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑹</mi></mrow><mo stretchy="false">→</mo><mrow><mi>𝑹</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑾</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\psi:M\times{\bm{R}}\to{\bm{R}}\times{\bm{W}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p10.2" class="ltx_p"><span id="A2.p10.2.1" class="ltx_text ltx_font_italic">satisfying</span></p>
<ol id="A2.I3" class="ltx_enumerate">
<li id="A2.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="A2.I3.i1.p1" class="ltx_para">
<p id="A2.I3.i1.p1.1" class="ltx_p"><math id="A2.I3.i1.p1.m1" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math><span id="A2.I3.i1.p1.1.1" class="ltx_text ltx_font_italic"> is a homeomorphism onto an open subset.</span></p>
</div></li>
<li id="A2.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="A2.I3.i2.p1" class="ltx_para">
<p id="A2.I3.i2.p1.1" class="ltx_p"><math id="A2.I3.i2.p1.m1" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math><span id="A2.I3.i2.p1.1.1" class="ltx_text ltx_font_italic"> is a diffeomorphism near </span><math id="A2.I3.i2.p1.m2" class="ltx_Math" alttext="\overline{O}\times\{0\}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>O</mi><mo stretchy="true">¯</mo></mover><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\overline{O}\times\{0\}</annotation></semantics></math><span id="A2.I3.i2.p1.1.2" class="ltx_text ltx_font_italic"> with respect to the given </span><math id="A2.I3.i2.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math><span id="A2.I3.i2.p1.1.3" class="ltx_text ltx_font_italic">-smoothing near </span><math id="A2.I3.i2.p1.m4" class="ltx_Math" alttext="\overline{O}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>O</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{O}</annotation></semantics></math><span id="A2.I3.i2.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
<div id="A2.p11" class="ltx_para ltx_noindent">
<p id="A2.p11.1" class="ltx_p"><span id="A2.p11.1.1" class="ltx_text ltx_font_italic">Proof of Claim C.</span> Consider the <math id="A2.p11.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant map</p>
<table id="A2.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex8.m1" class="ltx_Math" alttext="\theta:M\times{\bm{R}}\to{\bm{R}},\ (x,y)\mapsto x+y." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>θ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑹</mi></mrow><mo stretchy="false">→</mo><mi>𝑹</mi></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">↦</mo><mrow><mi>x</mi><mo>+</mo><mi>y</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\theta:M\times{\bm{R}}\to{\bm{R}},\ (x,y)\mapsto x+y.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p11.2" class="ltx_p">There exists a continuous function <math id="A2.p11.m2" class="ltx_Math" alttext="\delta:M\to(0,+\infty)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\delta:M\to(0,+\infty)</annotation></semantics></math> such that</p>
<table id="A2.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex9.m1" class="ltx_Math" alttext="|y|&lt;\delta(x)\Longrightarrow\theta(x,y)\in N_{\iota}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mi>y</mi><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟹</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msub><mi>N</mi><mi>ι</mi></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|y|&lt;\delta(x)\Longrightarrow\theta(x,y)\in N_{\iota}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p11.3" class="ltx_p">We can choose <math id="A2.p11.m3" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> such that it is smooth over <math id="A2.p11.m4" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>. Let <math id="A2.p11.m5" class="ltx_Math" alttext="y\mapsto y^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo stretchy="false">↦</mo><msup><mi>y</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">y\mapsto y^{\prime}</annotation></semantics></math> be a <math id="A2.p11.m6" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant smooth map which maps <math id="A2.p11.m7" class="ltx_Math" alttext="{\bm{R}}" display="inline" intent=":literal"><semantics><mi>𝑹</mi><annotation encoding="application/x-tex">{\bm{R}}</annotation></semantics></math> diffeomorphically onto the unit ball <math id="A2.p11.m8" class="ltx_Math" alttext="{\bm{R}}(1)" display="inline" intent=":literal"><semantics><mrow><mi>𝑹</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\bm{R}}(1)</annotation></semantics></math>. Then define</p>
<table id="A2.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex10.m1" class="ltx_Math" alttext="\begin{split}\psi:M\times{\bm{R}}\to&amp;\ {\bm{R}}\times{\bm{W}},\\
(x,y)\mapsto&amp;\ \Big(\theta(x,\delta(x)y^{\prime}),\exp_{x}^{-1}(r(\theta(x,\delta(x)y^{\prime})))\Big).\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mi>ψ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑹</mi></mrow><mo stretchy="false">→</mo><mphantom></mphantom></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>𝑹</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑾</mi></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">↦</mo><mphantom></mphantom></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi>exp</mi><mi>x</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\psi:M\times{\bm{R}}\to&amp;\ {\bm{R}}\times{\bm{W}},\\
(x,y)\mapsto&amp;\ \Big(\theta(x,\delta(x)y^{\prime}),\exp_{x}^{-1}(r(\theta(x,\delta(x)y^{\prime})))\Big).\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p11.4" class="ltx_p">This map is of the same form of the one used in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx24" title="" class="ltx_ref">Las79</a>, Theorem 1.3]</cite>. Hence this map is a homeomorphism onto an open subset of <math id="A2.p11.m9" class="ltx_Math" alttext="{\bm{R}}\times{\bm{W}}" display="inline" intent=":literal"><semantics><mrow><mi>𝑹</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑾</mi></mrow><annotation encoding="application/x-tex">{\bm{R}}\times{\bm{W}}</annotation></semantics></math>. Moreover, by the explicit construction one can verify that <math id="A2.p11.m10" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math> is a smooth embedding near <math id="A2.p11.m11" class="ltx_Math" alttext="\overline{O}\times\{0\}\subset\overline{O}\times{\bm{R}}" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>O</mi><mo stretchy="true">¯</mo></mover><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow><mo>⊂</mo><mrow><mover accent="true"><mi>O</mi><mo stretchy="true">¯</mo></mover><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑹</mi></mrow></mrow><annotation encoding="application/x-tex">\overline{O}\times\{0\}\subset\overline{O}\times{\bm{R}}</annotation></semantics></math>.  <span id="A2.p11.4.1" class="ltx_text ltx_font_italic">End of the proof of Claim C.</span></p>
</div>
<div id="A2.p12" class="ltx_para">
<p id="A2.p12.1" class="ltx_p"><span id="A2.p12.1.1" class="ltx_text">Therefore, <math id="A2.p12.m1" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math> pulls back the standard <math id="A2.p12.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-invariant smooth structure on <math id="A2.p12.m3" class="ltx_Math" alttext="{\bm{R}}\times{\bm{W}}" display="inline" intent=":literal"><semantics><mrow><mi>𝑹</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑾</mi></mrow><annotation encoding="application/x-tex">{\bm{R}}\times{\bm{W}}</annotation></semantics></math> to a smooth structure on <math id="A2.p12.m4" class="ltx_Math" alttext="M\times{\bm{R}}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑹</mi></mrow><annotation encoding="application/x-tex">M\times{\bm{R}}</annotation></semantics></math>, giving a stable <math id="A2.p12.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-smoothing on <math id="A2.p12.m6" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>. Moroever, as <math id="A2.p12.m7" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math> is smooth near <math id="A2.p12.m8" class="ltx_Math" alttext="\overline{O}\times\{0\}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>O</mi><mo stretchy="true">¯</mo></mover><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\overline{O}\times\{0\}</annotation></semantics></math>, this stable <math id="A2.p12.m9" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-smoothing is diffeomorphic to the <math id="A2.p12.m10" class="ltx_Math" alttext="{\bm{R}}" display="inline" intent=":literal"><semantics><mi>𝑹</mi><annotation encoding="application/x-tex">{\bm{R}}</annotation></semantics></math>-stabilization of the given one. Lastly, one can check easily that the induced stable <math id="A2.p12.m11" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-vector bundle reduction of <math id="A2.p12.m12" class="ltx_Math" alttext="T_{\mu}(M\times{\bm{R}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑹</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T_{\mu}(M\times{\bm{R}})</annotation></semantics></math> is in the same isotopy class of the given one.</span></p>
</div>
<div id="A2.p13" class="ltx_para">
<p id="A2.p13.1" class="ltx_p"><span id="A2.p13.1.1" class="ltx_text">Now we consider the general case where <math id="A2.p13.m1" class="ltx_Math" alttext="E\to M" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo stretchy="false">→</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">E\to M</annotation></semantics></math> is not necessarily trivial. We know that <math id="A2.p13.m2" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> has a stable inverse, which is a <math id="A2.p13.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant vector bundle <math id="A2.p13.m4" class="ltx_Math" alttext="\pi_{F}:F\to M" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>F</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>F</mi><mo stretchy="false">→</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">\pi_{F}:F\to M</annotation></semantics></math> such that <math id="A2.p13.m5" class="ltx_Math" alttext="E\oplus F\cong M\times{\bm{W}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo>⊕</mo><mi>F</mi></mrow><mo>≅</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑾</mi></mrow></mrow><annotation encoding="application/x-tex">E\oplus F\cong M\times{\bm{W}}</annotation></semantics></math> for some orthogonal <math id="A2.p13.m6" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-space <math id="A2.p13.m7" class="ltx_Math" alttext="{\bm{W}}" display="inline" intent=":literal"><semantics><mi>𝑾</mi><annotation encoding="application/x-tex">{\bm{W}}</annotation></semantics></math>. We may assume that both <math id="A2.p13.m8" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> and <math id="A2.p13.m9" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> are smooth <math id="A2.p13.m10" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant vector bundles near <math id="A2.p13.m11" class="ltx_Math" alttext="\overline{O}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>O</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{O}</annotation></semantics></math> and the isomorphism <math id="A2.p13.m12" class="ltx_Math" alttext="E\oplus F\cong M\times{\bm{W}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>E</mi><mo>⊕</mo><mi>F</mi></mrow><mo>≅</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑾</mi></mrow></mrow><annotation encoding="application/x-tex">E\oplus F\cong M\times{\bm{W}}</annotation></semantics></math> is smooth there. We may assume assume that the <math id="A2.p13.m13" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-vector bundle reduction, which is equivalent to a map</span></p>
<table id="A2.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex11.m1" class="ltx_Math" alttext="\exp:E\to M\times M" display="block" intent=":literal"><semantics><mrow><mi>exp</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>E</mi><mo stretchy="false">→</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\exp:E\to M\times M</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p13.2" class="ltx_p"><span id="A2.p13.2.1" class="ltx_text">is smooth near <math id="A2.p13.m14" class="ltx_Math" alttext="\overline{O}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>O</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{O}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.p14" class="ltx_para">
<p id="A2.p14.1" class="ltx_p"><span id="A2.p14.1.1" class="ltx_text">Consider the total space <math id="A2.p14.m1" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>. It is a topological <math id="A2.p14.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-manifold hence has a <math id="A2.p14.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-tangent microbundle <math id="A2.p14.m4" class="ltx_Math" alttext="T_{\mu}F" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><annotation encoding="application/x-tex">T_{\mu}F</annotation></semantics></math>. By <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx24" title="" class="ltx_ref">Las79</a>, Lemma 1.6]</cite>, the <math id="A2.p14.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-vector bundle reduction</span></p>
<table id="A2.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex12.m1" class="ltx_Math" alttext="\exp:E\to M\times M" display="block" intent=":literal"><semantics><mrow><mi>exp</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>E</mi><mo stretchy="false">→</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\exp:E\to M\times M</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p14.2" class="ltx_p"><span id="A2.p14.2.1" class="ltx_text">of <math id="A2.p14.m6" class="ltx_Math" alttext="T_{\mu}M" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">T_{\mu}M</annotation></semantics></math> induces a <math id="A2.p14.m7" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-vector bundle reduction</span></p>
<table id="A2.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex13.m1" class="ltx_Math" alttext="\widehat{\varphi}:F\times{\bm{W}}\cong\pi_{F}^{*}(E\oplus F)\to F\times F" display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi>φ</mi><mo>^</mo></mover><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>F</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑾</mi></mrow><mo>≅</mo><mrow><msubsup><mi>π</mi><mi>F</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>E</mi><mo>⊕</mo><mi>F</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>F</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>F</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\widehat{\varphi}:F\times{\bm{W}}\cong\pi_{F}^{*}(E\oplus F)\to F\times F</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p14.3" class="ltx_p"><span id="A2.p14.3.1" class="ltx_text">of <math id="A2.p14.m8" class="ltx_Math" alttext="T_{\mu}F" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><annotation encoding="application/x-tex">T_{\mu}F</annotation></semantics></math>. Notice that there is an induced <math id="A2.p14.m9" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-smoothing in a neighborhood of <math id="A2.p14.m10" class="ltx_Math" alttext="\pi_{F}^{-1}(\overline{O})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>π</mi><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>O</mi><mo stretchy="true">¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{F}^{-1}(\overline{O})</annotation></semantics></math> in the total space of <math id="A2.p14.m11" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>. The construction of <math id="A2.p14.m12" class="ltx_Math" alttext="\widehat{\varphi}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>φ</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\widehat{\varphi}</annotation></semantics></math> in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx24" title="" class="ltx_ref">Las79</a>, Lemma 1.6]</cite> can be carried out to guarantee that with respect to the smooth structures on <math id="A2.p14.m13" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> and <math id="A2.p14.m14" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> near <math id="A2.p14.m15" class="ltx_Math" alttext="\overline{O}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>O</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{O}</annotation></semantics></math>, <math id="A2.p14.m16" class="ltx_Math" alttext="\widehat{\varphi}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>φ</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\widehat{\varphi}</annotation></semantics></math> is smooth near <math id="A2.p14.m17" class="ltx_Math" alttext="\pi_{F}^{-1}(\overline{O})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>π</mi><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>O</mi><mo stretchy="true">¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{F}^{-1}(\overline{O})</annotation></semantics></math>. Then by the special case when <math id="A2.p14.m18" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> is trivial, one can construct a <math id="A2.p14.m19" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-smoothing on <math id="A2.p14.m20" class="ltx_Math" alttext="F\times{\bm{W}}" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑾</mi></mrow><annotation encoding="application/x-tex">F\times{\bm{W}}</annotation></semantics></math> for some orthogonal <math id="A2.p14.m21" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-space <math id="A2.p14.m22" class="ltx_Math" alttext="{\bm{R}}" display="inline" intent=":literal"><semantics><mi>𝑹</mi><annotation encoding="application/x-tex">{\bm{R}}</annotation></semantics></math> which coincides with the induced smooth structure near <math id="A2.p14.m23" class="ltx_Math" alttext="\pi_{F}^{-1}(\overline{O})\times{\bm{R}}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>π</mi><mi>F</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>O</mi><mo stretchy="true">¯</mo></mover><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">×</mo><mi>𝑹</mi></mrow><annotation encoding="application/x-tex">\pi_{F}^{-1}(\overline{O})\times{\bm{R}}</annotation></semantics></math>. Then consider</span></p>
<table id="A2.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex14.m1" class="ltx_Math" alttext="M\times{\bm{W}}\times{\bm{R}}=(E\oplus F)\times{\bm{R}}=\pi_{F}^{*}E\times{\bm{R}}" display="block" intent=":literal"><semantics><mrow><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑾</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑹</mi></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>E</mi><mo>⊕</mo><mi>F</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi>𝑹</mi></mrow><mo>=</mo><mrow><mrow><msubsup><mi>π</mi><mi>F</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑹</mi></mrow></mrow><annotation encoding="application/x-tex">M\times{\bm{W}}\times{\bm{R}}=(E\oplus F)\times{\bm{R}}=\pi_{F}^{*}E\times{\bm{R}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p14.4" class="ltx_p"><span id="A2.p14.4.1" class="ltx_text">which is the total space of a <math id="A2.p14.m24" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant vector bundle over <math id="A2.p14.m25" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>. Hence we can choose a smooth bundle structure on this bundle making the total space <math id="A2.p14.m26" class="ltx_Math" alttext="M\times{\bm{W}}\times{\bm{R}}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑾</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑹</mi></mrow><annotation encoding="application/x-tex">M\times{\bm{W}}\times{\bm{R}}</annotation></semantics></math> smooth. As <math id="A2.p14.m27" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> and <math id="A2.p14.m28" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> are already smooth near <math id="A2.p14.m29" class="ltx_Math" alttext="\overline{O}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>O</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{O}</annotation></semantics></math>, we can guarantee that the smooth bundle structure is induced from the original smooth bundle structures on <math id="A2.p14.m30" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> and <math id="A2.p14.m31" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> near <math id="A2.p14.m32" class="ltx_Math" alttext="\overline{O}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>O</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{O}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>A proof sketch of Proposition <a href="#S5.Thmthm64" title="Proposition 5.64. ‣ 5.8. Constructing scaffolding ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.64</span></a></h2>

<section id="A3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.1. </span>Analytical setup</h3>

<div id="A3.SS1.p1" class="ltx_para">
<p id="A3.SS1.p1.1" class="ltx_p">We provide a systematic setup which generalizes the case of a single stabilization map in Subsection <a href="#S5.SS5" title="5.5. Stabilization maps ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.5</span></a>. For each <math id="A3.SS1.p1.m1" class="ltx_Math" alttext="pq" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">pq</annotation></semantics></math> and each integer <math id="A3.SS1.p1.m2" class="ltx_Math" alttext="d\geq d_{pq}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">d\geq d_{pq}</annotation></semantics></math> we describe a topological space <math id="A3.SS1.p1.m3" class="ltx_Math" alttext="{\mathcal{C}}_{pq}^{(d)}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">{\mathcal{C}}_{pq}^{(d)}</annotation></semantics></math> which is morally a stratified Banach fiber bundle over <math id="A3.SS1.p1.m4" class="ltx_Math" alttext="B_{d_{pq}}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msub><annotation encoding="application/x-tex">B_{d_{pq}}</annotation></semantics></math>. Indeed, for each <math id="A3.SS1.p1.m5" class="ltx_Math" alttext="\underline{\smash{x}}\in B_{d_{pq}}" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo>∈</mo><msub><mi>B</mi><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msub></mrow><annotation encoding="application/x-tex">\underline{\smash{x}}\in B_{d_{pq}}</annotation></semantics></math>, its fiber over the universal curve is a prestable cylinder <math id="A3.SS1.p1.m6" class="ltx_Math" alttext="\Sigma_{\underline{\smash{x}}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder></msub><annotation encoding="application/x-tex">\Sigma_{\underline{\smash{x}}}</annotation></semantics></math> over which there is a stable map <math id="A3.SS1.p1.m7" class="ltx_Math" alttext="\underline{\smash{\mu}}_{\underline{\smash{x}}}:\Sigma_{\underline{\smash{x}}}\to\mathbb{CP}^{d_{pq}}" display="inline" intent=":literal"><semantics><mrow><msub><munder accentunder="true"><mi>μ</mi><mo stretchy="true">¯</mo></munder><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi mathvariant="normal">Σ</mi><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder></msub><mo stretchy="false">→</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\underline{\smash{\mu}}_{\underline{\smash{x}}}:\Sigma_{\underline{\smash{x}}}\to\mathbb{CP}^{d_{pq}}</annotation></semantics></math> representing <math id="A3.SS1.p1.m8" class="ltx_Math" alttext="\underline{\smash{x}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{x}}</annotation></semantics></math>. Then there are bundles</p>
<table id="A3.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex1.m1" class="ltx_Math" alttext="E_{\underline{\smash{x}}}^{(d)}\to\Sigma_{\underline{\smash{x}}}\times M" display="block" intent=":literal"><semantics><mrow><msubsup><mi>E</mi><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">→</mo><mrow><msub><mi mathvariant="normal">Σ</mi><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">E_{\underline{\smash{x}}}^{(d)}\to\Sigma_{\underline{\smash{x}}}\times M</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p1.2" class="ltx_p">whose fibers are similar to the one (<a href="#S5.E46" title="In 5.5.2. Analytical setup ‣ 5.5. Stabilization maps ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.46</span></a>) in the single-layered case. Fixing <math id="A3.SS1.p1.m9" class="ltx_Math" alttext="a&gt;2" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>&gt;</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">a&gt;2</annotation></semantics></math>, there is then a space <math id="A3.SS1.p1.m10" class="ltx_Math" alttext="{\mathcal{C}}^{1,a}(\Sigma_{\underline{\smash{x}}},E_{\underline{\smash{x}}}^{(d)})" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mn>1</mn><mo>,</mo><mi>a</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder></msub><mo>,</mo><msubsup><mi>E</mi><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{C}}^{1,a}(\Sigma_{\underline{\smash{x}}},E_{\underline{\smash{x}}}^{(d)})</annotation></semantics></math> of <math id="A3.SS1.p1.m11" class="ltx_Math" alttext="W^{1,a}" display="inline" intent=":literal"><semantics><msup><mi>W</mi><mrow><mn>1</mn><mo>,</mo><mi>a</mi></mrow></msup><annotation encoding="application/x-tex">W^{1,a}</annotation></semantics></math>-sections <math id="A3.SS1.p1.m12" class="ltx_Math" alttext="(u,\eta):\Sigma_{\underline{\smash{x}}}\to E_{\underline{\smash{x}}}^{(d)}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>η</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mrow><msub><mi mathvariant="normal">Σ</mi><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder></msub><mo stretchy="false">→</mo><msubsup><mi>E</mi><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">(u,\eta):\Sigma_{\underline{\smash{x}}}\to E_{\underline{\smash{x}}}^{(d)}</annotation></semantics></math>, where <math id="A3.SS1.p1.m13" class="ltx_Math" alttext="u:\Sigma_{\underline{\smash{x}}}\to M" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi mathvariant="normal">Σ</mi><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder></msub><mo stretchy="false">→</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">u:\Sigma_{\underline{\smash{x}}}\to M</annotation></semantics></math> is a map asymptotic to possible periodic orbits at cylindrical nodes or the two marked points and <math id="A3.SS1.p1.m14" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math> is a section of <math id="A3.SS1.p1.m15" class="ltx_Math" alttext="\Sigma_{\underline{\smash{x}}}^{(d)}|_{{\rm graph}u}" display="inline" intent=":literal"><semantics><msub><mrow><msubsup><mi mathvariant="normal">Σ</mi><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">|</mo></mrow><mrow><mi>graph</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></msub><annotation encoding="application/x-tex">\Sigma_{\underline{\smash{x}}}^{(d)}|_{{\rm graph}u}</annotation></semantics></math> such the total map <math id="A3.SS1.p1.m16" class="ltx_Math" alttext="(u,\eta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>η</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u,\eta)</annotation></semantics></math> is of class <math id="A3.SS1.p1.m17" class="ltx_Math" alttext="W^{1,a}" display="inline" intent=":literal"><semantics><msup><mi>W</mi><mrow><mn>1</mn><mo>,</mo><mi>a</mi></mrow></msup><annotation encoding="application/x-tex">W^{1,a}</annotation></semantics></math>. Define</p>
<table id="A3.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex2.m1" class="ltx_Math" alttext="{\mathcal{C}}_{pq}^{(d)}=\bigsqcup_{\underline{\smash{x}}\in B_{d_{pq}}}{\mathcal{C}}^{1,a}(\Sigma_{\underline{\smash{x}}},E_{\underline{\smash{x}}}^{(d)})." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">⨆</mo><mrow><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo>∈</mo><msub><mi>B</mi><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msub></mrow></munder><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mn>1</mn><mo>,</mo><mi>a</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder></msub><mo>,</mo><msubsup><mi>E</mi><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{C}}_{pq}^{(d)}=\bigsqcup_{\underline{\smash{x}}\in B_{d_{pq}}}{\mathcal{C}}^{1,a}(\Sigma_{\underline{\smash{x}}},E_{\underline{\smash{x}}}^{(d)}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p1.3" class="ltx_p">It is stratified by <math id="A3.SS1.p1.m18" class="ltx_Math" alttext="\alpha\in{\mathbb{A}}_{pq}^{\rm Floer}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>Floer</mi></msubsup></mrow><annotation encoding="application/x-tex">\alpha\in{\mathbb{A}}_{pq}^{\rm Floer}</annotation></semantics></math>. There are natural inclusions</p>
<table id="A3.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex3.m1" class="ltx_Math" alttext="{\mathcal{C}}_{pq}^{(d)}\hookrightarrow{\mathcal{C}}_{pq}^{(d^{\prime})}\ \forall d^{\prime}&gt;d." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">↪</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><msup><mi>d</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mo rspace="0.167em">∀</mo><msup><mi>d</mi><mo>′</mo></msup></mrow></mrow><mo>&gt;</mo><mi>d</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{C}}_{pq}^{(d)}\hookrightarrow{\mathcal{C}}_{pq}^{(d^{\prime})}\ \forall d^{\prime}&gt;d.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p1.4" class="ltx_p">There are also inclusions</p>
<table id="A3.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex4.m1" class="ltx_Math" alttext="\partial^{\alpha}V_{pq}\subset\partial^{\alpha}{\mathcal{C}}_{pq}^{(d_{pq})}\subset\partial^{\alpha}{\mathcal{C}}_{pq}^{(d)}\ \forall d\geq d_{pq}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo rspace="0.111em">⊂</mo><mrow><msup><mo>∂</mo><mi>α</mi></msup><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo rspace="0.111em">⊂</mo><mrow><msup><mo>∂</mo><mi>α</mi></msup><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mo rspace="0.167em">∀</mo><mi>d</mi></mrow></mrow></mrow><mo>≥</mo><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\partial^{\alpha}V_{pq}\subset\partial^{\alpha}{\mathcal{C}}_{pq}^{(d_{pq})}\subset\partial^{\alpha}{\mathcal{C}}_{pq}^{(d)}\ \forall d\geq d_{pq}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS1.p2" class="ltx_para">
<p id="A3.SS1.p2.1" class="ltx_p">Notice that there is a <math id="A3.SS1.p2.m1" class="ltx_Math" alttext="G_{pq}^{\mathbb{C}}" display="inline" intent=":literal"><semantics><msubsup><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>ℂ</mi></msubsup><annotation encoding="application/x-tex">G_{pq}^{\mathbb{C}}</annotation></semantics></math>-action on <math id="A3.SS1.p2.m2" class="ltx_Math" alttext="{\mathcal{C}}_{pq}^{(d)}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">{\mathcal{C}}_{pq}^{(d)}</annotation></semantics></math>.</p>
</div>
<div id="A3.SS1.p3" class="ltx_para">
<p id="A3.SS1.p3.1" class="ltx_p">Over each <math id="A3.SS1.p3.m1" class="ltx_Math" alttext="{\mathcal{C}}^{1,a}(\Sigma_{\underline{\smash{x}}},E_{\underline{\smash{x}}}^{(d)})" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mn>1</mn><mo>,</mo><mi>a</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder></msub><mo>,</mo><msubsup><mi>E</mi><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{C}}^{1,a}(\Sigma_{\underline{\smash{x}}},E_{\underline{\smash{x}}}^{(d)})</annotation></semantics></math> there is also a Banach space bundle denoted by <math id="A3.SS1.p3.m2" class="ltx_Math" alttext="Y_{\underline{\smash{x}}}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder></msub><annotation encoding="application/x-tex">Y_{\underline{\smash{x}}}</annotation></semantics></math> whose fiber at <math id="A3.SS1.p3.m3" class="ltx_Math" alttext="(u,\eta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>η</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u,\eta)</annotation></semantics></math> is the space of <math id="A3.SS1.p3.m4" class="ltx_Math" alttext="L^{a}" display="inline" intent=":literal"><semantics><msup><mi>L</mi><mi>a</mi></msup><annotation encoding="application/x-tex">L^{a}</annotation></semantics></math>-sections of certain bundles along <math id="A3.SS1.p3.m5" class="ltx_Math" alttext="(u,\eta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>η</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u,\eta)</annotation></semantics></math>. We omit its detailed definition. Indeed there is a section <math id="A3.SS1.p3.m6" class="ltx_Math" alttext="{\mathcal{F}}_{\underline{\smash{x}}}^{(d)}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">{\mathcal{F}}_{\underline{\smash{x}}}^{(d)}</annotation></semantics></math> of this Banach space bundle whose zero locus in the <math id="A3.SS1.p3.m7" class="ltx_Math" alttext="d=d_{pq}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">d=d_{pq}</annotation></semantics></math> case is the fiber of <math id="A3.SS1.p3.m8" class="ltx_Math" alttext="V_{pq}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">V_{pq}</annotation></semantics></math> over <math id="A3.SS1.p3.m9" class="ltx_Math" alttext="\underline{\smash{x}}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{\smash{x}}</annotation></semantics></math>.</p>
</div>
<div id="A3.SS1.p4" class="ltx_para">
<p id="A3.SS1.p4.1" class="ltx_p">One can consider the linearization of the (multi-layered) thickened Floer equation at any <math id="A3.SS1.p4.m1" class="ltx_Math" alttext="x\in\partial^{\alpha}V_{pq}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo rspace="0.111em">∈</mo><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">x\in\partial^{\alpha}V_{pq}</annotation></semantics></math>. Indeed, there are sequences of linear operators</p>
<table id="A3.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex5.m1" class="ltx_Math" alttext="D_{x}^{(d)}:T_{x}{\mathcal{C}}^{1,a}(\Sigma_{\underline{\smash{x}}},E_{\underline{\smash{x}}}^{(d)})\to Y_{\underline{\smash{x}}}|_{x}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>D</mi><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>T</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mn>1</mn><mo>,</mo><mi>a</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder></msub><mo>,</mo><msubsup><mi>E</mi><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><msub><mrow><msub><mi>Y</mi><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder></msub><mo stretchy="false">|</mo></mrow><mi>x</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">D_{x}^{(d)}:T_{x}{\mathcal{C}}^{1,a}(\Sigma_{\underline{\smash{x}}},E_{\underline{\smash{x}}}^{(d)})\to Y_{\underline{\smash{x}}}|_{x}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p4.2" class="ltx_p">In fact, by the nature of the thickening equation (perturbations with lower <math id="A3.SS1.p4.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> does not deform the equation for perturbations with higher <math id="A3.SS1.p4.m3" class="ltx_Math" alttext="d^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>d</mi><mo>′</mo></msup><annotation encoding="application/x-tex">d^{\prime}</annotation></semantics></math>), the linear operators are always block upper-triangular, i.e., when <math id="A3.SS1.p4.m4" class="ltx_Math" alttext="d&lt;d^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>&lt;</mo><msup><mi>d</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">d&lt;d^{\prime}</annotation></semantics></math>, one has</p>
<table id="A3.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex6.m1" class="ltx_Math" alttext="D_{x}^{(d^{\prime})}=\left[\begin{array}[]{cc}D_{x}^{(d)}&amp;*\\
0&amp;D_{x}^{[d,d^{\prime}]}\end{array}\right]" display="block" intent=":literal"><semantics><mrow><msubsup><mi>D</mi><mi>x</mi><mrow><mo stretchy="false">(</mo><msup><mi>d</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd><msubsup><mi>D</mi><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup></mtd><mtd><mo>∗</mo></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mi>D</mi><mi>x</mi><mrow><mo stretchy="false">[</mo><mi>d</mi><mo>,</mo><msup><mi>d</mi><mo>′</mo></msup><mo stretchy="false">]</mo></mrow></msubsup></mtd></mtr></mtable><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">D_{x}^{(d^{\prime})}=\left[\begin{array}[]{cc}D_{x}^{(d)}&amp;*\\
0&amp;D_{x}^{[d,d^{\prime}]}\end{array}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p4.3" class="ltx_p">where the last block is a linear Cauchy–Riemann operator on some vector bundle.</p>
</div>
<div id="A3.SS1.p5" class="ltx_para">
<p id="A3.SS1.p5.1" class="ltx_p">Our construction guarantees that all these linearizations are surjective. Hence we can consider their bounded right inverses. By the above block upper-triangular form, we can have right inverses which are also block upper-triangular. We always assume this without further clarification in the rest of this appendix.</p>
</div>
<div id="A3.SS1.p6" class="ltx_para">
<p id="A3.SS1.p6.1" class="ltx_p">The construction of a compatible system of stabilization maps (as well as other structures included in Proposition <a href="#S5.Thmthm64" title="Proposition 5.64. ‣ 5.8. Constructing scaffolding ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.64</span></a>), as we showed in the case of a single stabilization map, depends on the choices of three kinds of structures. They are 1) continuous families of right inverses, 2) families of approximate solution maps, and 3) families of local Banach manifold charts and local Banach vector bundle trivializations. A crucial point of our proof presented in this appendix is that these three kinds of objects can always be obtained from local to global and can always be interpolated between each other.</p>
</div>
<div id="A3.SS1.p7" class="ltx_para">
<p id="A3.SS1.p7.1" class="ltx_p">We first define these notions under the current setting.</p>
</div>
<div id="A3.Thmthm1" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmthm1.2" class="ltx_text ltx_font_bold">Definition C.1</span></span><span id="A3.Thmthm1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmthm1.p1" class="ltx_para">
<p id="A3.Thmthm1.p1.1" class="ltx_p">An <span id="A3.Thmthm1.p1.1.1" class="ltx_text ltx_font_bold">approximate solution map</span> (for level <math id="A3.Thmthm1.p1.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>) is a germ of continuous maps</p>
<table id="A3.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex7.m1" class="ltx_Math" alttext="O_{pq}^{(d)}\to{\mathcal{C}}_{pq}^{(d)}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">→</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">O_{pq}^{(d)}\to{\mathcal{C}}_{pq}^{(d)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.Thmthm1.p1.2" class="ltx_p">which satisfies the following conditions.</p>
<ol id="A3.I1" class="ltx_enumerate">
<li id="A3.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="A3.I1.i1.p1" class="ltx_para">
<p id="A3.I1.i1.p1.1" class="ltx_p">It is level preserving, i.e., if <math id="A3.I1.i1.p1.m1" class="ltx_Math" alttext="d^{\prime}&lt;d" display="inline" intent=":literal"><semantics><mrow><msup><mi>d</mi><mo>′</mo></msup><mo>&lt;</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">d^{\prime}&lt;d</annotation></semantics></math>, then it sends <math id="A3.I1.i1.p1.m2" class="ltx_Math" alttext="O_{pq}^{(d^{\prime})}\subset O_{pq}^{(d)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><msup><mi>d</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msubsup><mo>⊂</mo><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">O_{pq}^{(d^{\prime})}\subset O_{pq}^{(d)}</annotation></semantics></math> into <math id="A3.I1.i1.p1.m3" class="ltx_Math" alttext="{\mathcal{C}}_{pq}^{(d^{\prime})}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><msup><mi>d</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">{\mathcal{C}}_{pq}^{(d^{\prime})}</annotation></semantics></math>.</p>
</div></li>
<li id="A3.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="A3.I1.i2.p1" class="ltx_para">
<p id="A3.I1.i2.p1.1" class="ltx_p">It is fiberwise smooth. It means the following. For each <math id="A3.I1.i2.p1.m1" class="ltx_Math" alttext="\underline{\smash{x}}\in B_{d_{pq}}" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo>∈</mo><msub><mi>B</mi><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msub></mrow><annotation encoding="application/x-tex">\underline{\smash{x}}\in B_{d_{pq}}</annotation></semantics></math>, the fiber <math id="A3.I1.i2.p1.m2" class="ltx_Math" alttext="\pi_{pq}^{-1}(\underline{\smash{x}})\subset V_{pq}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>π</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\pi_{pq}^{-1}(\underline{\smash{x}})\subset V_{pq}</annotation></semantics></math> of the thickened moduli is smooth, the fiberwise restriction of the level-<math id="A3.I1.i2.p1.m3" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> obstruction bundle <math id="A3.I1.i2.p1.m4" class="ltx_Math" alttext="O_{pq}^{(d)}" display="inline" intent=":literal"><semantics><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">O_{pq}^{(d)}</annotation></semantics></math> is smooth, and the Banach manifold <math id="A3.I1.i2.p1.m5" class="ltx_Math" alttext="{\mathcal{C}}^{1,a}(\Sigma_{\underline{\smash{x}}},O_{\underline{\smash{x}}}^{(d)})" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mn>1</mn><mo>,</mo><mi>a</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Σ</mi><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder></msub><mo>,</mo><msubsup><mi>O</mi><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{C}}^{1,a}(\Sigma_{\underline{\smash{x}}},O_{\underline{\smash{x}}}^{(d)})</annotation></semantics></math> is also smooth. Then the fiberwise restriction of the approximate solution map is smooth.</p>
</div></li>
<li id="A3.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="A3.I1.i3.p1" class="ltx_para">
<p id="A3.I1.i3.p1.1" class="ltx_p">Over <math id="A3.I1.i3.p1.m1" class="ltx_Math" alttext="V_{\alpha}\subset V_{pq}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi>α</mi></msub><mo>⊂</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">V_{\alpha}\subset V_{pq}</annotation></semantics></math> for any <math id="A3.I1.i3.p1.m2" class="ltx_Math" alttext="\alpha\in{\mathbb{A}}_{pq}^{\rm Floer}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>Floer</mi></msubsup></mrow><annotation encoding="application/x-tex">\alpha\in{\mathbb{A}}_{pq}^{\rm Floer}</annotation></semantics></math>, the approximate solution map is equal to the product.</p>
</div></li>
</ol>
</div>
</div>
<div id="A3.Thmthm2" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmthm2.2" class="ltx_text ltx_font_italic">Remark C.2</span></span><span id="A3.Thmthm2.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="A3.Thmthm2.p1" class="ltx_para">
<ol id="A3.I2" class="ltx_enumerate">
<li id="A3.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="A3.I2.i1.p1" class="ltx_para">
<p id="A3.I2.i1.p1.1" class="ltx_p">An obvious choice of such approximate solution map is just to add sections of the obstruction bundle linearly in the infinite-dimensional space. This obvious option does not deform the underlying map into <math id="A3.I2.i1.p1.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>. However in certain stages of our construction we must use more general kinds of approximate solution maps which deforms the underlying map.</p>
</div></li>
<li id="A3.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="A3.I2.i2.p1" class="ltx_para">
<p id="A3.I2.i2.p1.1" class="ltx_p">To construct the stabilization map from a product <math id="A3.I2.i2.p1.m1" class="ltx_Math" alttext="V_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>α</mi></msub><annotation encoding="application/x-tex">V_{\alpha}</annotation></semantics></math> to <math id="A3.I2.i2.p1.m2" class="ltx_Math" alttext="\partial^{\alpha}V_{pq}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\partial^{\alpha}V_{pq}</annotation></semantics></math>, we do not need to use the whole approximate solution map for all <math id="A3.I2.i2.p1.m3" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>, but only its restriction to some subbundle of <math id="A3.I2.i2.p1.m4" class="ltx_Math" alttext="O_{pq}^{(d_{pq})}" display="inline" intent=":literal"><semantics><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">O_{pq}^{(d_{pq})}</annotation></semantics></math> restricted to <math id="A3.I2.i2.p1.m5" class="ltx_Math" alttext="V_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>α</mi></msub><annotation encoding="application/x-tex">V_{\alpha}</annotation></semantics></math>. However, using the approximate solution map to <math id="A3.I2.i2.p1.m6" class="ltx_Math" alttext="O_{pq}^{(d)}" display="inline" intent=":literal"><semantics><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">O_{pq}^{(d)}</annotation></semantics></math> for all <math id="A3.I2.i2.p1.m7" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> helps one to extend the map we actually need from a lower to a higher stratum.</p>
</div></li>
<li id="A3.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="A3.I2.i3.p1" class="ltx_para">
<p id="A3.I2.i3.p1.1" class="ltx_p">Remember that the obstruction bundle also contains the quadratic form part <math id="A3.I2.i3.p1.m1" class="ltx_Math" alttext="Q_{pq}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">Q_{pq}</annotation></semantics></math>. When constructing the actual approximate solutions to the thickened equation, we also need to change the approximate solution by variables from <math id="A3.I2.i3.p1.m2" class="ltx_Math" alttext="Q_{pq}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">Q_{pq}</annotation></semantics></math> via the <math id="A3.I2.i3.p1.m3" class="ltx_Math" alttext="G_{pq}^{\mathbb{C}}" display="inline" intent=":literal"><semantics><msubsup><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi>ℂ</mi></msubsup><annotation encoding="application/x-tex">G_{pq}^{\mathbb{C}}</annotation></semantics></math>-actions.</p>
</div></li>
</ol>
</div>
</div>
<div id="A3.SS1.p8" class="ltx_para">
<p id="A3.SS1.p8.1" class="ltx_p">We can also define the notion of continuous family of bounded right inverses, for all levels, generalizing the case of Subsection <a href="#S5.SS5" title="5.5. Stabilization maps ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.5</span></a>.</p>
</div>
<div id="A3.SS1.p9" class="ltx_para">
<p id="A3.SS1.p9.1" class="ltx_p">We can also define the notion of families of local charts/trivializations. The obvious choices are the one coming from parallel transport along shortest geodesics starting at any <math id="A3.SS1.p9.m1" class="ltx_Math" alttext="x\in V_{pq}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">x\in V_{pq}</annotation></semantics></math>. We should regard this kind of choices as “continuous” when the domain changes. However, we may also need to use the chart induced from a map <math id="A3.SS1.p9.m2" class="ltx_Math" alttext="x^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mo>′</mo></msup><annotation encoding="application/x-tex">x^{\prime}</annotation></semantics></math> near <math id="A3.SS1.p9.m3" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>. We can also define a notion of continuity.</p>
</div>
</section>
<section id="A3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.2. </span>The inductive proof of Proposition <a href="#S5.Thmthm64" title="Proposition 5.64. ‣ 5.8. Constructing scaffolding ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.64</span></a></h3>

<div id="A3.SS2.p1" class="ltx_para">
<p id="A3.SS2.p1.1" class="ltx_p">We have the following induction procedure to construct the structures we need.</p>
</div>
<div id="A3.SS2.p2" class="ltx_para ltx_noindent">
<p id="A3.SS2.p2.1" class="ltx_p"><span id="A3.SS2.p2.1.1" class="ltx_text ltx_font_bold">Step 1.</span> We first consider any minimal thickened moduli space <math id="A3.SS2.p2.m1" class="ltx_Math" alttext="V_{pq}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">V_{pq}</annotation></semantics></math> which does not have boundary or corners.</p>
<ol id="A3.I3" class="ltx_enumerate">
<li id="A3.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="A3.I3.i1.p1" class="ltx_para">
<p id="A3.I3.i1.p1.1" class="ltx_p">We can choose <math id="A3.I3.i1.p1.m1" class="ltx_Math" alttext="G_{pq}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">G_{pq}</annotation></semantics></math>-invariant inner products on <math id="A3.I3.i1.p1.m2" class="ltx_Math" alttext="O_{pq}^{(d)}\to V_{pq}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">→</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">O_{pq}^{(d)}\to V_{pq}</annotation></semantics></math> inductively on <math id="A3.I3.i1.p1.m3" class="ltx_Math" alttext="d\geq d_{pq}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">d\geq d_{pq}</annotation></semantics></math> such that the embeddings <math id="A3.I3.i1.p1.m4" class="ltx_Math" alttext="O_{pq}^{(d)}\to O_{pq}^{(d+1)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">→</mo><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">O_{pq}^{(d)}\to O_{pq}^{(d+1)}</annotation></semantics></math> for all <math id="A3.I3.i1.p1.m5" class="ltx_Math" alttext="d\geq d_{pq}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">d\geq d_{pq}</annotation></semantics></math> are isometric.</p>
</div></li>
<li id="A3.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="A3.I3.i2.p1" class="ltx_para">
<p id="A3.I3.i2.p1.1" class="ltx_p">We can also inductively construct continuous families of vertical right inverses of all levels <math id="A3.I3.i2.p1.m1" class="ltx_Math" alttext="d\geq d_{pq}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">d\geq d_{pq}</annotation></semantics></math> inductively.</p>
</div></li>
<li id="A3.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="A3.I3.i3.p1" class="ltx_para">
<p id="A3.I3.i3.p1.1" class="ltx_p">We can also construct a collection of approximate solution map. For each <math id="A3.I3.i3.p1.m1" class="ltx_Math" alttext="d\geq d_{pq}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">d\geq d_{pq}</annotation></semantics></math>, we can choose a germ of maps</p>
<table id="A3.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex8.m1" class="ltx_Math" alttext="O_{pq}^{(d)}\to{\mathcal{C}}_{pq}^{(d)}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">→</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">O_{pq}^{(d)}\to{\mathcal{C}}_{pq}^{(d)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.I3.i3.p1.2" class="ltx_p">defined by</p>
<table id="A3.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex9.m1" class="ltx_Math" alttext="[\Sigma,u,\mu,\eta,\zeta]\mapsto[\Sigma,u,\mu,\eta+\zeta]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>μ</mi><mo>,</mo><mi>η</mi><mo>,</mo><mi>ζ</mi></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">↦</mo><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>μ</mi><mo>,</mo><mrow><mi>η</mi><mo>+</mo><mi>ζ</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">[\Sigma,u,\mu,\eta,\zeta]\mapsto[\Sigma,u,\mu,\eta+\zeta].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.I3.i3.p1.3" class="ltx_p">The summation is defined because <math id="A3.I3.i3.p1.m2" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math> and <math id="A3.I3.i3.p1.m3" class="ltx_Math" alttext="\zeta" display="inline" intent=":literal"><semantics><mi>ζ</mi><annotation encoding="application/x-tex">\zeta</annotation></semantics></math> are contained in the same vector bundle.</p>
</div></li>
</ol>
</div>
<div id="A3.SS2.p3" class="ltx_para ltx_noindent">
<p id="A3.SS2.p3.1" class="ltx_p"><span id="A3.SS2.p3.1.1" class="ltx_text ltx_font_bold">Step 2.</span> Suppose we have constructed the three kinds of structures up to an energy level <math id="A3.SS2.p3.m1" class="ltx_Math" alttext="d_{pq}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">d_{pq}</annotation></semantics></math>. There are certain compatibility conditions we need to require. For example, they must respect the collars. We will describe the required conditions we we need them. Now we start to consider the structures over the thickened moduli space <math id="A3.SS2.p3.m2" class="ltx_Math" alttext="V_{pq}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">V_{pq}</annotation></semantics></math> and the stabilizations maps from each <math id="A3.SS2.p3.m3" class="ltx_Math" alttext="V_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>α</mi></msub><annotation encoding="application/x-tex">V_{\alpha}</annotation></semantics></math> to <math id="A3.SS2.p3.m4" class="ltx_Math" alttext="\partial^{\alpha}V_{pq}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\partial^{\alpha}V_{pq}</annotation></semantics></math>. In this step we describe how to define these structures over a minimal stratum <math id="A3.SS2.p3.m5" class="ltx_math_unparsed" alttext="\alpha=pr_{1}\cdots r_{l}q" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mi>p</mi><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>l</mi></msub><mi>q</mi></mrow><annotation encoding="application/x-tex">\alpha=pr_{1}\cdots r_{l}q</annotation></semantics></math>.</p>
<ol id="A3.I4" class="ltx_enumerate">
<li id="A3.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="A3.I4.i1.p1" class="ltx_para">
<p id="A3.I4.i1.p1.1" class="ltx_p">We first consider the metric on <math id="A3.I4.i1.p1.m1" class="ltx_Math" alttext="O_{pq}^{(d)}" display="inline" intent=":literal"><semantics><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">O_{pq}^{(d)}</annotation></semantics></math> restricted to <math id="A3.I4.i1.p1.m2" class="ltx_Math" alttext="V_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>α</mi></msub><annotation encoding="application/x-tex">V_{\alpha}</annotation></semantics></math>. Start with <math id="A3.I4.i1.p1.m3" class="ltx_Math" alttext="d_{0}=d_{pq}" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>=</mo><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">d_{0}=d_{pq}</annotation></semantics></math>. We view this stratum as contained in <math id="A3.I4.i1.p1.m4" class="ltx_Math" alttext="V_{pr_{1}r_{l}q}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">V_{pr_{1}r_{l}q}</annotation></semantics></math>. Denote <math id="A3.I4.i1.p1.m5" class="ltx_Math" alttext="r_{1}=r" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mn>1</mn></msub><mo>=</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">r_{1}=r</annotation></semantics></math>, <math id="A3.I4.i1.p1.m6" class="ltx_Math" alttext="r_{l}=s" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi>l</mi></msub><mo>=</mo><mi>s</mi></mrow><annotation encoding="application/x-tex">r_{l}=s</annotation></semantics></math>. Then there are the two subbundles</p>
<table id="A3.EGx29" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex10.m1" class="ltx_Math" alttext="\displaystyle\ O_{ps\to pq}^{(d_{0})},\ " display="inline" intent=":literal"><semantics><mrow><msubsup><mi>O</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">→</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ O_{ps\to pq}^{(d_{0})},\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex10.m2" class="ltx_Math" alttext="\displaystyle\ O_{rq\to pq}^{(d_{0})}" display="inline" intent=":literal"><semantics><msubsup><mi>O</mi><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo stretchy="false">→</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\displaystyle\ O_{rq\to pq}^{(d_{0})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.I4.i1.p1.2" class="ltx_p">on which the expected properties and inner products we have already constructed induce unique inner products. We verify that these two inner products on these two subbundles agree on their intersection. By the canonical decomposition (<a href="#S5.E36" title="In 5.3.3. Multi-layered thickening ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.36</span></a>), one has</p>
<table id="A3.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex11.m1" class="ltx_Math" alttext="O_{ps\to pq}^{(d_{0})}\cap O_{rq\to pq}^{(d_{0})}\subset O_{pq;rs}^{(d_{0})}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>O</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">→</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msubsup><mo>∩</mo><msubsup><mi>O</mi><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo stretchy="false">→</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>⊂</mo><msubsup><mi>O</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>;</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">O_{ps\to pq}^{(d_{0})}\cap O_{rq\to pq}^{(d_{0})}\subset O_{pq;rs}^{(d_{0})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.I4.i1.p1.3" class="ltx_p">In fact we can show that</p>
<table id="A3.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex12.m1" class="ltx_Math" alttext="O_{ps\to pq}^{(d_{0})}\cap O_{rq\to pq}^{(d_{0})}=O_{rs\to pq}^{(d_{0})}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>O</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">→</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msubsup><mo>∩</mo><msubsup><mi>O</mi><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo stretchy="false">→</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>=</mo><msubsup><mi>O</mi><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">→</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">O_{ps\to pq}^{(d_{0})}\cap O_{rq\to pq}^{(d_{0})}=O_{rs\to pq}^{(d_{0})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.I4.i1.p1.4" class="ltx_p">Then over this intersection the existing inner products agree. Moreover <math id="A3.I4.i1.p1.m7" class="ltx_Math" alttext="O_{ps\to pq}^{(d_{0})}+O_{rq\to pq}^{(d_{0})}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>O</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">→</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msubsup><mi>O</mi><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo stretchy="false">→</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">O_{ps\to pq}^{(d_{0})}+O_{rq\to pq}^{(d_{0})}</annotation></semantics></math> contains all existing subbundles of <math id="A3.I4.i1.p1.m8" class="ltx_Math" alttext="O_{pq}^{(d_{0})}|_{V_{\alpha}}" display="inline" intent=":literal"><semantics><msub><mrow><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">|</mo></mrow><msub><mi>V</mi><mi>α</mi></msub></msub><annotation encoding="application/x-tex">O_{pq}^{(d_{0})}|_{V_{\alpha}}</annotation></semantics></math>. Hence they induce an inner product on the sum <math id="A3.I4.i1.p1.m9" class="ltx_Math" alttext="O_{ps\to pq}^{(d_{0})}+O_{rq\to pq}^{(d_{0})}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>O</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">→</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msubsup><mi>O</mi><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo stretchy="false">→</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">O_{ps\to pq}^{(d_{0})}+O_{rq\to pq}^{(d_{0})}</annotation></semantics></math> which agrees with all existing induced ones. Then extend it arbitrarily to <math id="A3.I4.i1.p1.m10" class="ltx_Math" alttext="O_{pq}^{(d_{0})}|_{V_{\alpha}}" display="inline" intent=":literal"><semantics><msub><mrow><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">|</mo></mrow><msub><mi>V</mi><mi>α</mi></msub></msub><annotation encoding="application/x-tex">O_{pq}^{(d_{0})}|_{V_{\alpha}}</annotation></semantics></math>.</p>
</div></li>
<li id="A3.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="A3.I4.i2.p1" class="ltx_para">
<p id="A3.I4.i2.p1.1" class="ltx_p">Now we obtained an orthogonal complement</p>
<table id="A3.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex13.m1" class="ltx_Math" alttext="O_{pq,\alpha}\subset O_{pq}|_{V_{\alpha}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>O</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>α</mi></mrow></msub><mo>⊂</mo><msub><mrow><msub><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">|</mo></mrow><msub><mi>V</mi><mi>α</mi></msub></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">O_{pq,\alpha}\subset O_{pq}|_{V_{\alpha}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.I4.i2.p1.2" class="ltx_p">Define</p>
<table id="A3.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex14.m1" class="ltx_Math" alttext="F_{pq,\alpha}:=O_{pq,\alpha}\oplus Q_{pq,\alpha}\to V_{\alpha}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>F</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>α</mi></mrow></msub><mo>:=</mo><mrow><msub><mi>O</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>α</mi></mrow></msub><mo>⊕</mo><msub><mi>Q</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>α</mi></mrow></msub></mrow><mo stretchy="false">→</mo><msub><mi>V</mi><mi>α</mi></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">F_{pq,\alpha}:=O_{pq,\alpha}\oplus Q_{pq,\alpha}\to V_{\alpha}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.I4.i2.p1.3" class="ltx_p">At this moment we can define the stabilization map</p>
<table id="A3.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex15.m1" class="ltx_Math" alttext="\theta_{pq,\alpha}:{\rm Stab}_{F_{pq,\alpha}}(V_{\alpha})\to\partial^{\alpha}V_{pq}" display="block" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>α</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>Stab</mi><msub><mi>F</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>α</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em" stretchy="false">→</mo><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta_{pq,\alpha}:{\rm Stab}_{F_{pq,\alpha}}(V_{\alpha})\to\partial^{\alpha}V_{pq}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.I4.i2.p1.4" class="ltx_p">In fact, the existing approximate solution maps can be extended to one on <math id="A3.I4.i2.p1.m1" class="ltx_Math" alttext="O_{pq}^{(d_{0})}" display="inline" intent=":literal"><semantics><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">O_{pq}^{(d_{0})}</annotation></semantics></math> in the same fashion as we extend the inner product in the above. Then we can restrict the approximate solution map to <math id="A3.I4.i2.p1.m2" class="ltx_Math" alttext="O_{pq,\alpha}" display="inline" intent=":literal"><semantics><msub><mi>O</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>α</mi></mrow></msub><annotation encoding="application/x-tex">O_{pq,\alpha}</annotation></semantics></math>. Then as we did in (<a href="#S5.E47" title="In 5.5.2. Analytical setup ‣ 5.5. Stabilization maps ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.47</span></a>), we can define a map from <math id="A3.I4.i2.p1.m3" class="ltx_Math" alttext="F_{pq,\alpha}=O_{pq,\alpha}\oplus Q_{pq,\alpha}" display="inline" intent=":literal"><semantics><mrow><msub><mi>F</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>α</mi></mrow></msub><mo>=</mo><mrow><msub><mi>O</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>α</mi></mrow></msub><mo>⊕</mo><msub><mi>Q</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>α</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">F_{pq,\alpha}=O_{pq,\alpha}\oplus Q_{pq,\alpha}</annotation></semantics></math> to <math id="A3.I4.i2.p1.m4" class="ltx_Math" alttext="\partial^{\alpha}{\mathcal{C}}_{pq}^{(d_{0})}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mi>α</mi></msup><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">\partial^{\alpha}{\mathcal{C}}_{pq}^{(d_{0})}</annotation></semantics></math>. One can also extend the family of right inverse and the existing charts, in the same fashion as we extended the inner products above. Then it produces the way to correct the approximate solutions to exact solutions canonically. Then the corresponding projection map</p>
<table id="A3.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex16.m1" class="ltx_Math" alttext="\pi_{pq,\alpha}:\partial^{\alpha}V_{pq}\to V_{\alpha}^{\sim}" display="block" intent=":literal"><semantics><mrow><msub><mi>π</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>α</mi></mrow></msub><mo lspace="0.278em" rspace="0.111em">:</mo><mrow><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo stretchy="false">→</mo><msubsup><mi>V</mi><mi>α</mi><mo>∼</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">\pi_{pq,\alpha}:\partial^{\alpha}V_{pq}\to V_{\alpha}^{\sim}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.I4.i2.p1.5" class="ltx_p">is obtained. From the construction, we can see that the projections are compatible with all existing ones when restrict to <math id="A3.I4.i2.p1.m5" class="ltx_Math" alttext="\partial^{\alpha}V_{\beta}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi>V</mi><mi>β</mi></msub></mrow><annotation encoding="application/x-tex">\partial^{\alpha}V_{\beta}</annotation></semantics></math> for an intermediate stratum <math id="A3.I4.i2.p1.m6" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math>. The bundle isomorphism</p>
<table id="A3.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex17.m1" class="ltx_Math" alttext="\widehat{\theta}_{pq,\alpha}:\pi_{pq,\alpha}^{*}\left(O_{pq}^{(d)}|_{V_{\alpha}^{\sim}}\right)\to O_{pq}^{(d)}" display="block" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>α</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mi>π</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>α</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mrow><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">|</mo></mrow><msubsup><mi>V</mi><mi>α</mi><mo>∼</mo></msubsup></msub><mo>)</mo></mrow></mrow><mo stretchy="false">→</mo><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">\widehat{\theta}_{pq,\alpha}:\pi_{pq,\alpha}^{*}\left(O_{pq}^{(d)}|_{V_{\alpha}^{\sim}}\right)\to O_{pq}^{(d)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.I4.i2.p1.6" class="ltx_p">for all <math id="A3.I4.i2.p1.m7" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> can be obtained.</p>
</div></li>
<li id="A3.I4.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="A3.I4.i3.p1" class="ltx_para">
<p id="A3.I4.i3.p1.1" class="ltx_p">Now we inductively construct inner products on <math id="A3.I4.i3.p1.m1" class="ltx_Math" alttext="O_{pq}^{(d)}" display="inline" intent=":literal"><semantics><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">O_{pq}^{(d)}</annotation></semantics></math> over <math id="A3.I4.i3.p1.m2" class="ltx_Math" alttext="V_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>α</mi></msub><annotation encoding="application/x-tex">V_{\alpha}</annotation></semantics></math> for all <math id="A3.I4.i3.p1.m3" class="ltx_Math" alttext="d\geq d_{0}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><msub><mi>d</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">d\geq d_{0}</annotation></semantics></math>. Suppose we have done this for some <math id="A3.I4.i3.p1.m4" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>. Then similar to the above case, one can obtain a unique inner product on the sum</p>
<table id="A3.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex18.m1" class="ltx_Math" alttext="O_{ps\to pq}^{(d)}+O_{rq\to pq}^{(d)}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>O</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">→</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msubsup><mi>O</mi><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo stretchy="false">→</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">O_{ps\to pq}^{(d)}+O_{rq\to pq}^{(d)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.I4.i3.p1.2" class="ltx_p">We can verify that this metric agrees with the one on <math id="A3.I4.i3.p1.m5" class="ltx_Math" alttext="O_{pq}^{(d-1)}" display="inline" intent=":literal"><semantics><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">O_{pq}^{(d-1)}</annotation></semantics></math> on the intersection <math id="A3.I4.i3.p1.m6" class="ltx_Math" alttext="O_{pq}^{(d-1)}\cap(O_{ps\to pq}^{(d)}+O_{rq\to pq}^{(d)})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>∩</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>O</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">→</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msubsup><mi>O</mi><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo stretchy="false">→</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O_{pq}^{(d-1)}\cap(O_{ps\to pq}^{(d)}+O_{rq\to pq}^{(d)})</annotation></semantics></math>. Indeed,</p>
<table id="A3.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex19.m1" class="ltx_Math" alttext="O_{pq}^{(d-1)}\cap(O_{ps\to pq}^{(d)}+O_{rq\to pq}^{(d)})=O_{ps\to pq}^{(d-1)}+O_{rq\to pq}^{(d-1)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>∩</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>O</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">→</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msubsup><mi>O</mi><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo stretchy="false">→</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>O</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">→</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msubsup><mi>O</mi><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo stretchy="false">→</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">O_{pq}^{(d-1)}\cap(O_{ps\to pq}^{(d)}+O_{rq\to pq}^{(d)})=O_{ps\to pq}^{(d-1)}+O_{rq\to pq}^{(d-1)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.I4.i3.p1.3" class="ltx_p">Hence there exists a further extension to <math id="A3.I4.i3.p1.m7" class="ltx_Math" alttext="O_{pq}^{(d)}" display="inline" intent=":literal"><semantics><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">O_{pq}^{(d)}</annotation></semantics></math> over the set <math id="A3.I4.i3.p1.m8" class="ltx_Math" alttext="V_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>α</mi></msub><annotation encoding="application/x-tex">V_{\alpha}</annotation></semantics></math>.</p>
</div>
<div id="A3.I4.i3.p2" class="ltx_para">
<p id="A3.I4.i3.p2.1" class="ltx_p">Then using the bundle isomorphisms we can extend the inner products to <math id="A3.I4.i3.p2.m1" class="ltx_Math" alttext="O_{pq}^{(d)}|_{\partial^{\alpha}V_{pq}}" display="inline" intent=":literal"><semantics><msub><mrow><msubsup><mi>O</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">|</mo></mrow><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></msub><annotation encoding="application/x-tex">O_{pq}^{(d)}|_{\partial^{\alpha}V_{pq}}</annotation></semantics></math>. At last, the approximate solution map, the right inverse map, and the local charts can be extended to <math id="A3.I4.i3.p2.m2" class="ltx_Math" alttext="\partial^{\alpha}V_{pq}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\partial^{\alpha}V_{pq}</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
<div id="A3.SS2.p4" class="ltx_para ltx_noindent">
<p id="A3.SS2.p4.1" class="ltx_p"><span id="A3.SS2.p4.1.1" class="ltx_text ltx_font_bold">Step 3.</span> Using the collar structure one can extend all we have constructed over <math id="A3.SS2.p4.m1" class="ltx_Math" alttext="\partial^{\alpha}V_{pq}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\partial^{\alpha}V_{pq}</annotation></semantics></math> to a small neighborhood. Now we would like to carry out the induction for a higher stratum <math id="A3.SS2.p4.m2" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math>. Indeed, for the higher stratum one has its own construction which can be irrelevant to what we just did. What we need to do here is to connect the structures over the collar region near <math id="A3.SS2.p4.m3" class="ltx_Math" alttext="\partial^{\alpha}V_{\beta}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi>V</mi><mi>β</mi></msub></mrow><annotation encoding="application/x-tex">\partial^{\alpha}V_{\beta}</annotation></semantics></math>.</p>
</div>
<div id="A3.SS2.p5" class="ltx_para">
<p id="A3.SS2.p5.1" class="ltx_p">In fact, the interpolation between bundle metrics can be easily done. The interpolation between right inverses can also be done using convex combinations (notice that convex combinations of block upper-triangular operators are still block upper-triangular). The more nonlinear interpolation is the one for approximate solution and the one for local charts/trivializations. For approximate solutions, we can first interpolate (arbitrarily) between the underlying maps into <math id="A3.SS2.p5.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, then interpolate over the fiber (linear) direction of <math id="A3.SS2.p5.m2" class="ltx_Math" alttext="E_{\underline{\smash{x}}}^{(d)}" display="inline" intent=":literal"><semantics><msubsup><mi>E</mi><munder accentunder="true"><mi>x</mi><mo stretchy="true">¯</mo></munder><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">E_{\underline{\smash{x}}}^{(d)}</annotation></semantics></math>. For local charts/trivializations, as they are induced from parallel transport “centered” at families of maps into <math id="A3.SS2.p5.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, we only needs to interpolate the certer maps. Indeed, the maps we want to interpolate between are close enough to each other. We can do the same construction for all stratum of <math id="A3.SS2.p5.m4" class="ltx_Math" alttext="V_{pq}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">V_{pq}</annotation></semantics></math> inductively.</p>
</div>
<div id="A3.SS2.p6" class="ltx_para">
<p id="A3.SS2.p6.1" class="ltx_p">Lastly, the construction of the stabilizations maps implies that</p>
<table id="A3.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex20.m1" class="ltx_Math" alttext="\pi_{pq,\alpha}=\pi_{\beta\alpha}\circ\pi_{pq,\beta}" display="block" intent=":literal"><semantics><mrow><msub><mi>π</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>α</mi></mrow></msub><mo>=</mo><mrow><msub><mi>π</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>π</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>β</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\pi_{pq,\alpha}=\pi_{\beta\alpha}\circ\pi_{pq,\beta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p6.2" class="ltx_p">The bundle isomorphisms <math id="A3.SS2.p6.m1" class="ltx_Math" alttext="\widehat{\theta}_{pq,\beta}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>β</mi></mrow></msub><annotation encoding="application/x-tex">\widehat{\theta}_{pq,\beta}</annotation></semantics></math> for all stratum can be obtained as well.</p>
</div>
</section>
</section>
