<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E19.m1" class="ltx_Math" alttext="\vbox{\lx@xy@svg{\hbox{\raise 0.0pt\hbox{\kern 36.0334pt\hbox{\ignorespaces\ignorespaces\ignorespaces\hbox{\vtop{\halign{\entry@#!@&amp;&amp;\entry@@#!@\cr&amp;\cr&amp;\crcr}}}\ignorespaces{\hbox{\kern-36.0334pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{C_{xy^{\prime}}^{\rm hmtp}\times C_{y^{\prime}y}^{\rm Morse}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 60.0334pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 0.0pt\raise-24.93448pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 60.0334pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\partial^{xy^{\prime}y}C_{xy}^{\rm hmtp}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 87.202pt\raise-23.99998pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern-34.55984pt\raise-33.9245pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{{\mathbb{A}}_{xy^{\prime}}^{\rm hmtp}\times{\mathbb{A}}_{y^{\prime}y}^{\rm Morse}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 60.21463pt\raise-33.9245pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 60.21463pt\raise-33.9245pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\partial^{xy^{\prime}y}{\mathbb{A}}_{xy}^{\rm hmtp}}$}}}}}}}\ignorespaces}}}}}." display="block" intent=":literal"><semantics><mrow><mtext> <svg style="vertical-align:-59.68832055843106px" height="73.42" overflow="visible" version="1.1" viewBox="49.86 59.69 208.11 73.42" width="208.11"> <g transform="matrix(1 0 0 -1 49.859418139280216 73.42087178370824) translate(49.86,0)"> <g transform="translate(-49.86,0) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:6.61em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.37em;font-size:10pt;" height="16.88" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="91.42"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mrow><msubsup><mi>C</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mo>′</mo></msup></mrow><mi>hmtp</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>C</mi><mrow><msup><mi>y</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>Morse</mi></msubsup></mrow></span></span></foreignObject> </g> <path style="--ltx-stroke-color:#000000;" d="M 49.859418139280216 -0.27673578005007266 L 49.859418139280216 0.27673578005007266" fill="none" stroke="#000000"></path> <g transform="translate(83.07,0)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M 49.859418139280216 -0.27673578005007266 L 83.06821847136823 0.27673578005007266" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 83.06821847136823 -0.27673578005007266 L 83.06821847136823 0.27673578005007266" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -12.746990114652519 L 0.27673578005007266 -12.746990114652519" fill="none" stroke="#000000"></path> <g transform="translate(0,-34.5)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -34.501838604906084 L 0.27673578005007266 -12.746990114652519" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -34.501838604906084 L 0.27673578005007266 -34.501838604906084" fill="none" stroke="#000000"></path> <g transform="translate(83.07,0) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:4.83em;--ltx-fo-height:0.94em;--ltx-fo-depth:0.29em;font-size:10pt;" height="17" overflow="visible" transform="matrix(1 0 0 -1 0 13.04)" width="66.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mrow><msup><mo>∂</mo><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msup><msubsup><mi>C</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>hmtp</mi></msubsup></mrow></span></span></foreignObject> </g> <path style="--ltx-stroke-color:#000000;" d="M 120.38466708366845 -11.569253138458645 L 120.9381386437686 -11.569253138458645" fill="none" stroke="#000000"></path> <g transform="translate(120.66,0) translate(0,-33.21)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M 120.38466708366845 -33.20877921850137 L 120.9381386437686 -11.569253138458645" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 120.38466708366845 -33.20877921850137 L 120.9381386437686 -33.20877921850137" fill="none" stroke="#000000"></path> <g transform="translate(-47.82,0) translate(0,-46.94) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:6.31em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.37em;font-size:10pt;" height="16.88" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="87.34"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mrow><msubsup><mi>𝔸</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mo>′</mo></msup></mrow><mi>hmtp</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>𝔸</mi><mrow><msup><mi>y</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>Morse</mi></msubsup></mrow></span></span></foreignObject> </g> <path style="--ltx-stroke-color:#000000;" d="M 47.82045796416649 -47.218066223828615 L 47.82045796416649 -46.664594663728465" fill="none" stroke="#000000"></path> <g transform="translate(83.32,0) translate(0,-46.94)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M 47.82045796416649 -47.218066223828615 L 83.31898453985488 -46.664594663728465" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 83.31898453985488 -47.218066223828615 L 83.31898453985488 -46.664594663728465" fill="none" stroke="#000000"></path> <g transform="translate(83.32,0) translate(0,-46.94) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:4.8em;--ltx-fo-height:0.94em;--ltx-fo-depth:0.29em;font-size:10pt;" height="17" overflow="visible" transform="matrix(1 0 0 -1 0 13.04)" width="66.38"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mrow><msup><mo>∂</mo><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msup><msubsup><mi>𝔸</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>hmtp</mi></msubsup></mrow></span></span></foreignObject> </g> </g> </svg> </mtext><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\vbox{\lx@xy@svg{\hbox{\raise 0.0pt\hbox{\kern 36.0334pt\hbox{\ignorespaces\ignorespaces\ignorespaces\hbox{\vtop{\halign{\entry@#!@&amp;&amp;\entry@@#!@\cr&amp;\cr&amp;\crcr}}}\ignorespaces{\hbox{\kern-36.0334pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{C_{xy^{\prime}}^{\rm hmtp}\times C_{y^{\prime}y}^{\rm Morse}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 60.0334pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 0.0pt\raise-24.93448pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 60.0334pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\partial^{xy^{\prime}y}C_{xy}^{\rm hmtp}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 87.202pt\raise-23.99998pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern-34.55984pt\raise-33.9245pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{{\mathbb{A}}_{xy^{\prime}}^{\rm hmtp}\times{\mathbb{A}}_{y^{\prime}y}^{\rm Morse}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 60.21463pt\raise-33.9245pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 60.21463pt\raise-33.9245pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\partial^{xy^{\prime}y}{\mathbb{A}}_{xy}^{\rm hmtp}}$}}}}}}}\ignorespaces}}}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.19)</span></td></tr></tbody>
</table>
</div></li>
</ol>
<p id="S4.Thmthm12.p1.3" class="ltx_p">These objects need to satisfy the following conditions.</p>
<ol id="S4.I8" class="ltx_enumerate">
<li id="S4.I8.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I8.i1.p1" class="ltx_para">
<p id="S4.I8.i1.p1.1" class="ltx_p">The obvious associativity relations.</p>
</div></li>
<li id="S4.I8.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I8.i2.p1" class="ltx_para">
<p id="S4.I8.i2.p1.1" class="ltx_p">For each <math id="S4.I8.i2.p1.m1" class="ltx_Math" alttext="\kappa\in{\mathbb{A}}_{xy}^{\rm hmtp}" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo>∈</mo><msubsup><mi>𝔸</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>hmtp</mi></msubsup></mrow><annotation encoding="application/x-tex">\kappa\in{\mathbb{A}}_{xy}^{\rm hmtp}</annotation></semantics></math>, there is a product chart <math id="S4.I8.i2.p1.m2" class="ltx_Math" alttext="C_{\kappa}^{\rm hmtp}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi>κ</mi><mi>hmtp</mi></msubsup><annotation encoding="application/x-tex">C_{\kappa}^{\rm hmtp}</annotation></semantics></math> obtained from taking corresponding product of certain Morse, Floer, PSS, SSP, pearly, and/or homotopy derived orbifold charts. The above associativity relations induce chart embeddings</p>
<table id="S4.Ex72" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex72.m1" class="ltx_Math" alttext="{\bm{\iota}}_{\nu\kappa}^{\rm hmtp}:C_{\kappa}^{\rm hmtp}\to\partial^{\kappa}C_{\nu}^{\rm hmtp}\ \forall\kappa\leq\nu." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝜾</mi><mrow><mi>ν</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mi>hmtp</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>C</mi><mi>κ</mi><mi>hmtp</mi></msubsup><mo rspace="0.111em" stretchy="false">→</mo><mrow><msup><mo>∂</mo><mi>κ</mi></msup><mrow><msubsup><mi>C</mi><mi>ν</mi><mi>hmtp</mi></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mo rspace="0.167em">∀</mo><mi>κ</mi></mrow></mrow></mrow><mo>≤</mo><mi>ν</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\bm{\iota}}_{\nu\kappa}^{\rm hmtp}:C_{\kappa}^{\rm hmtp}\to\partial^{\kappa}C_{\nu}^{\rm hmtp}\ \forall\kappa\leq\nu.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.I8.i2.p1.2" class="ltx_p">Then <math id="S4.I8.i2.p1.m3" class="ltx_Math" alttext="((C_{\kappa}^{\rm hmtp})_{\kappa\in{\mathbb{A}}_{xy}^{\rm hmtp}},({\bm{\iota}}_{\nu\kappa})_{\kappa\leq\nu})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>κ</mi><mi>hmtp</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>κ</mi><mo>∈</mo><msubsup><mi>𝔸</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>hmtp</mi></msubsup></mrow></msub><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝜾</mi><mrow><mi>ν</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>κ</mi><mo>≤</mo><mi>ν</mi></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">((C_{\kappa}^{\rm hmtp})_{\kappa\in{\mathbb{A}}_{xy}^{\rm hmtp}},({\bm{\iota}}_{\nu\kappa})_{\kappa\leq\nu})</annotation></semantics></math> form a derived orbifold presentation of the space <math id="S4.I8.i2.p1.m4" class="ltx_math_unparsed" alttext="(\overline{\mathcal{M}}{}_{xy}^{\rm hmtp})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mo stretchy="false">)</mo><mrow></mrow><mi>hmtp</mi><mprescripts></mprescripts><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mrow></mrow></mmultiscripts></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(\overline{\mathcal{M}}{}_{xy}^{\rm hmtp})^{+}</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I8.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S4.I8.i3.p1" class="ltx_para">
<p id="S4.I8.i3.p1.1" class="ltx_p">When <math id="S4.I8.i3.p1.m1" class="ltx_Math" alttext="\kappa\notin\partial^{-}{\mathbb{A}}_{xy}^{\rm hmtp}" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo rspace="0.111em">∉</mo><mrow><msup><mo>∂</mo><mo>−</mo></msup><msubsup><mi>𝔸</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>hmtp</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\kappa\notin\partial^{-}{\mathbb{A}}_{xy}^{\rm hmtp}</annotation></semantics></math>, the chart embedding <math id="S4.I8.i3.p1.m2" class="ltx_Math" alttext="{\bm{\iota}}_{\nu\kappa}^{\rm hmtp}" display="inline" intent=":literal"><semantics><msubsup><mi>𝜾</mi><mrow><mi>ν</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mi>hmtp</mi></msubsup><annotation encoding="application/x-tex">{\bm{\iota}}_{\nu\kappa}^{\rm hmtp}</annotation></semantics></math> is an open embedding.</p>
</div></li>
<li id="S4.I8.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S4.I8.i4.p1" class="ltx_para">
<p id="S4.I8.i4.p1.1" class="ltx_p">The obvious strict <math id="S4.I8.i4.p1.m1" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>-equivariance condition.</p>
</div></li>
</ol>
</div>
</div>
<div id="S4.SS6.SSS3.p1" class="ltx_para">
<p id="S4.SS6.SSS3.p1.1" class="ltx_p">We also need to discuss the additional structures (collar, scaffolding, and straightening) on the derived orbifold lift of the system of homotopy moduli spaces.</p>
</div>
<div id="S4.Thmthm13" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm13.2" class="ltx_text ltx_font_bold">Definition 4.13</span></span><span id="S4.Thmthm13.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm13.p1" class="ltx_para">
<p id="S4.Thmthm13.p1.1" class="ltx_p">In addition to the assumption of Definition <a href="#S4.Thmthm12" title="Definition 4.12. ‣ 4.6.3. Derived orbifold lift ‣ 4.6. The homotopy ‣ 4. Proof of the integral Arnold conjecture ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.12</span></a>, assume the following objects are given.</p>
<ol id="S4.I9" class="ltx_enumerate">
<li id="S4.I9.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I9.i1.p1" class="ltx_para">
<p id="S4.I9.i1.p1.1" class="ltx_p">A compatible package of additional structures on <math id="S4.I9.i1.p1.m1" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm Floer}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>Floer</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm Floer}</annotation></semantics></math>. Remember that there is also a package of additional structures on <math id="S4.I9.i1.p1.m2" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm Morse}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>Morse</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm Morse}</annotation></semantics></math> which essentially contains only the collar structure.</p>
</div></li>
<li id="S4.I9.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I9.i2.p1" class="ltx_para">
<p id="S4.I9.i2.p1.1" class="ltx_p">A compatible package of additional structures on <math id="S4.I9.i2.p1.m1" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm PSS}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>PSS</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm PSS}</annotation></semantics></math> resp. <math id="S4.I9.i2.p1.m2" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm SSP}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>SSP</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm SSP}</annotation></semantics></math> which extend the ones on <math id="S4.I9.i2.p1.m3" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm Floer}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>Floer</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm Floer}</annotation></semantics></math> and <math id="S4.I9.i2.p1.m4" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm Morse}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>Morse</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm Morse}</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I9.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S4.I9.i3.p1" class="ltx_para">
<p id="S4.I9.i3.p1.1" class="ltx_p">A compatible package of additional structures on <math id="S4.I9.i3.p1.m1" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm pearl}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>pearl</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm pearl}</annotation></semantics></math> which extends the package on <math id="S4.I9.i3.p1.m2" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm Morse}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>Morse</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm Morse}</annotation></semantics></math>.</p>
</div></li>
</ol>
<p id="S4.Thmthm13.p1.2" class="ltx_p">Let <math id="S4.Thmthm13.p1.m1" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm hmtp}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>hmtp</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm hmtp}</annotation></semantics></math> be a derived orbifold lift of the system of homotopy moduli spaces which extends all given derived orbifold lifts.</p>
<ol id="S4.I10" class="ltx_enumerate">
<li id="S4.I10.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I10.i1.p1" class="ltx_para">
<p id="S4.I10.i1.p1.1" class="ltx_p">A <span id="S4.I10.i1.p1.1.1" class="ltx_text ltx_font_bold">collar structure</span> resp. <span id="S4.I10.i1.p1.1.2" class="ltx_text ltx_font_bold">straightening</span> on <math id="S4.I10.i1.p1.m1" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm hmtp}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>hmtp</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm hmtp}</annotation></semantics></math> is a collection of collar structures resp. straightenings on the derived orbifold charts <math id="S4.I10.i1.p1.m2" class="ltx_Math" alttext="C_{xy}^{\rm hmtp}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>hmtp</mi></msubsup><annotation encoding="application/x-tex">C_{xy}^{\rm hmtp}</annotation></semantics></math> satisfying the following condition. Fix <math id="S4.I10.i1.p1.m3" class="ltx_Math" alttext="x,y" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow><annotation encoding="application/x-tex">x,y</annotation></semantics></math>. For each <math id="S4.I10.i1.p1.m4" class="ltx_Math" alttext="\kappa\in{\mathbb{A}}_{xy}^{\rm hmtp}" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo>∈</mo><msubsup><mi>𝔸</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>hmtp</mi></msubsup></mrow><annotation encoding="application/x-tex">\kappa\in{\mathbb{A}}_{xy}^{\rm hmtp}</annotation></semantics></math>, the product of collar structures resp. straightenings on all derived orbifold chart factors defines a collar structure resp. straightening on the product chart <math id="S4.I10.i1.p1.m5" class="ltx_Math" alttext="C_{\kappa}^{\rm hmtp}" display="inline" intent=":literal"><semantics><msubsup><mi>C</mi><mi>κ</mi><mi>hmtp</mi></msubsup><annotation encoding="application/x-tex">C_{\kappa}^{\rm hmtp}</annotation></semantics></math>. Then the collection of collar structures resp. straightenings for all <math id="S4.I10.i1.p1.m6" class="ltx_Math" alttext="\kappa\in{\mathbb{A}}_{xy}^{\rm hmtp}" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo>∈</mo><msubsup><mi>𝔸</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>hmtp</mi></msubsup></mrow><annotation encoding="application/x-tex">\kappa\in{\mathbb{A}}_{xy}^{\rm hmtp}</annotation></semantics></math> is a collar structure resp. straightening of the derived orbifold presentation of <math id="S4.I10.i1.p1.m7" class="ltx_math_unparsed" alttext="(\overline{\mathcal{M}}{}_{xy}^{\rm hmtp})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mo stretchy="false">)</mo><mrow></mrow><mi>hmtp</mi><mprescripts></mprescripts><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mrow></mrow></mmultiscripts></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(\overline{\mathcal{M}}{}_{xy}^{\rm hmtp})^{+}</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I10.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I10.i2.p1" class="ltx_para">
<p id="S4.I10.i2.p1.1" class="ltx_p">A <span id="S4.I10.i2.p1.1.1" class="ltx_text ltx_font_bold">scaffolding</span> on <math id="S4.I10.i2.p1.m1" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm hmtp}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>hmtp</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm hmtp}</annotation></semantics></math> consists of a collection of scaffoldings</p>
<table id="S4.Ex73" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex73.m1" class="ltx_Math" alttext="\Big(\big({\mathcal{F}}_{\nu\kappa},{\bm{\theta}}_{\nu\kappa}\big)_{\kappa\leq\nu}\Big)_{x,y\in{\mathcal{P}}^{\rm Morse}}" display="block" intent=":literal"><semantics><msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>ν</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow></msub><mo>,</mo><msub><mi>𝜽</mi><mrow><mi>ν</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mi>κ</mi><mo>≤</mo><mi>ν</mi></mrow></msub><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Morse</mi></msup></mrow></msub><annotation encoding="application/x-tex">\Big(\big({\mathcal{F}}_{\nu\kappa},{\bm{\theta}}_{\nu\kappa}\big)_{\kappa\leq\nu}\Big)_{x,y\in{\mathcal{P}}^{\rm Morse}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.I10.i2.p1.2" class="ltx_p">on the collection of derived orbifold presentations <math id="S4.I10.i2.p1.m2" class="ltx_Math" alttext="((C_{\kappa}^{\rm hmtp})_{\kappa\in{\mathbb{A}}_{xy}^{\rm hmtp}},({\bm{\iota}}_{\kappa\leq\nu}))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>κ</mi><mi>hmtp</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>κ</mi><mo>∈</mo><msubsup><mi>𝔸</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>hmtp</mi></msubsup></mrow></msub><mo>,</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝜾</mi><mrow><mi>κ</mi><mo>≤</mo><mi>ν</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">((C_{\kappa}^{\rm hmtp})_{\kappa\in{\mathbb{A}}_{xy}^{\rm hmtp}},({\bm{\iota}}_{\kappa\leq\nu}))</annotation></semantics></math> which satisfy the following conditions.</p>
<ol id="S4.I10.i2.I1" class="ltx_enumerate">
<li id="S4.I10.i2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(a)</span> 
<div id="S4.I10.i2.I1.i1.p1" class="ltx_para">
<p id="S4.I10.i2.I1.i1.p1.1" class="ltx_p">If <math id="S4.I10.i2.I1.i1.p1.m1" class="ltx_Math" alttext="\nu\in\partial^{-}{\mathbb{A}}_{xy}^{\rm hmtp}" display="inline" intent=":literal"><semantics><mrow><mi>ν</mi><mo rspace="0.111em">∈</mo><mrow><msup><mo>∂</mo><mo>−</mo></msup><msubsup><mi>𝔸</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>hmtp</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\nu\in\partial^{-}{\mathbb{A}}_{xy}^{\rm hmtp}</annotation></semantics></math> (i.e. a stratum in the <math id="S4.I10.i2.I1.i1.p1.m2" class="ltx_Math" alttext="\tau=-1" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>=</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\tau=-1</annotation></semantics></math> slice of the moduli, i.e., a stratum of configurations with breakings at 1-periodic orbits of <math id="S4.I10.i2.I1.i1.p1.m3" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>), then <math id="S4.I10.i2.I1.i1.p1.m4" class="ltx_Math" alttext="({\mathcal{F}}_{\nu\kappa},{\bm{\theta}}_{\nu\kappa})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>ν</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow></msub><mo>,</mo><msub><mi>𝜽</mi><mrow><mi>ν</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\mathcal{F}}_{\nu\kappa},{\bm{\theta}}_{\nu\kappa})</annotation></semantics></math> is the product from corresponding difference bundles and stabilization maps on <math id="S4.I10.i2.I1.i1.p1.m5" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm Floer}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>Floer</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm Floer}</annotation></semantics></math>, <math id="S4.I10.i2.I1.i1.p1.m6" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm PSS}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>PSS</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm PSS}</annotation></semantics></math>, <math id="S4.I10.i2.I1.i1.p1.m7" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm SSP}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>SSP</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm SSP}</annotation></semantics></math>, and/or the trivial one on <math id="S4.I10.i2.I1.i1.p1.m8" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm Morse}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>Morse</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm Morse}</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I10.i2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(b)</span> 
<div id="S4.I10.i2.I1.i2.p1" class="ltx_para">
<p id="S4.I10.i2.I1.i2.p1.1" class="ltx_p">If <math id="S4.I10.i2.I1.i2.p1.m1" class="ltx_Math" alttext="\kappa\notin\partial^{-}{\mathbb{A}}_{xy}^{\rm hmtp}" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo rspace="0.111em">∉</mo><mrow><msup><mo>∂</mo><mo>−</mo></msup><msubsup><mi>𝔸</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>hmtp</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\kappa\notin\partial^{-}{\mathbb{A}}_{xy}^{\rm hmtp}</annotation></semantics></math>, then <math id="S4.I10.i2.I1.i2.p1.m2" class="ltx_Math" alttext="{\mathcal{F}}_{\nu\kappa}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>ν</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{\nu\kappa}=0</annotation></semantics></math>.</p>
</div></li>
</ol>
</div></li>
</ol>
</div>
</div>
<div id="S4.SS6.SSS3.p2" class="ltx_para">
<p id="S4.SS6.SSS3.p2.1" class="ltx_p">Lastly we discuss orientations and normal complex structures on a system of derived orbifold lifts on homotopy moduli spaces.</p>
</div>
<div id="S4.Thmthm14" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm14.2" class="ltx_text ltx_font_bold">Definition 4.14</span></span><span id="S4.Thmthm14.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm14.p1" class="ltx_para">
<p id="S4.Thmthm14.p1.1" class="ltx_p">Given a derived orbifold lift <math id="S4.Thmthm14.p1.m1" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm hmtp}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>hmtp</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm hmtp}</annotation></semantics></math>, and a collar structure compatible with a scaffolding <math id="S4.Thmthm14.p1.m2" class="ltx_Math" alttext="\Big(\big({\mathcal{F}}_{\nu\kappa},{\bm{\theta}}_{\nu\kappa}\big)_{\kappa\leq\nu}\Big)_{x,y\in{\mathcal{P}}^{\rm Morse}}" display="inline" intent=":literal"><semantics><msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>ν</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow></msub><mo>,</mo><msub><mi>𝜽</mi><mrow><mi>ν</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mi>κ</mi><mo>≤</mo><mi>ν</mi></mrow></msub><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>Morse</mi></msup></mrow></msub><annotation encoding="application/x-tex">\Big(\big({\mathcal{F}}_{\nu\kappa},{\bm{\theta}}_{\nu\kappa}\big)_{\kappa\leq\nu}\Big)_{x,y\in{\mathcal{P}}^{\rm Morse}}</annotation></semantics></math>, assume that <math id="S4.Thmthm14.p1.m3" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm Floer}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>Floer</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm Floer}</annotation></semantics></math>, <math id="S4.Thmthm14.p1.m4" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm PSS}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>PSS</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm PSS}</annotation></semantics></math>, <math id="S4.Thmthm14.p1.m5" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm SSP}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>SSP</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm SSP}</annotation></semantics></math>, <math id="S4.Thmthm14.p1.m6" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm Morse}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>Morse</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm Morse}</annotation></semantics></math> and their scaffoldings and outer-collarings are endowed with a <span id="S4.Thmthm14.p1.1.1" class="ltx_text ltx_font_bold">normal complex structure</span>. Then a normal complex structure on <math id="S4.Thmthm14.p1.m7" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm hmtp}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>hmtp</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm hmtp}</annotation></semantics></math> with the given scaffolding and outer-collaring consists of</p>
<ol id="S4.I11" class="ltx_enumerate">
<li id="S4.I11.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I11.i1.p1" class="ltx_para">
<p id="S4.I11.i1.p1.1" class="ltx_p">A normal complex structure on all the underlying derived orbifold charts of <math id="S4.I11.i1.p1.m1" class="ltx_Math" alttext="(C_{\kappa}^{\rm hmtp})_{\kappa\in{\mathbb{A}}_{xy}^{\rm hmtp}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msubsup><mi>C</mi><mi>κ</mi><mi>hmtp</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>κ</mi><mo>∈</mo><msubsup><mi>𝔸</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>hmtp</mi></msubsup></mrow></msub><annotation encoding="application/x-tex">(C_{\kappa}^{\rm hmtp})_{\kappa\in{\mathbb{A}}_{xy}^{\rm hmtp}}</annotation></semantics></math> such that the embeddings <math id="S4.I11.i1.p1.m2" class="ltx_Math" alttext="({\bm{\iota}}_{\kappa\leq\nu})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝜾</mi><mrow><mi>κ</mi><mo>≤</mo><mi>ν</mi></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">({\bm{\iota}}_{\kappa\leq\nu})</annotation></semantics></math> all intertwine with the normal complex structures.</p>
</div></li>
<li id="S4.I11.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I11.i2.p1" class="ltx_para">
<p id="S4.I11.i2.p1.1" class="ltx_p">A complex structure on the vector bundles <math id="S4.I11.i2.p1.m1" class="ltx_Math" alttext="{\mathcal{F}}_{\nu\kappa}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>ν</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{F}}_{\nu\kappa}</annotation></semantics></math> such that the embeddings underlying <math id="S4.I11.i2.p1.m2" class="ltx_Math" alttext="{\bm{\theta}}_{\nu\kappa}" display="inline" intent=":literal"><semantics><msub><mi>𝜽</mi><mrow><mi>ν</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow></msub><annotation encoding="application/x-tex">{\bm{\theta}}_{\nu\kappa}</annotation></semantics></math> all respects the induced normal complex structures.</p>
</div></li>
<li id="S4.I11.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S4.I11.i3.p1" class="ltx_para">
<p id="S4.I11.i3.p1.1" class="ltx_p">The structural maps from the outer-collaring and the compatibility equations with the scaffolding intertwine with the normal complex structure as in Definition <a href="#S3.Thmthm36" title="Definition 3.36. ‣ 3.6. Normal complex structure and orientations on flow categories ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.36</span></a>.</p>
</div></li>
<li id="S4.I11.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S4.I11.i4.p1" class="ltx_para">
<p id="S4.I11.i4.p1.1" class="ltx_p">The strict <math id="S4.I11.i4.p1.m1" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>-action preserves the normal complex structures.</p>
</div></li>
</ol>
</div>
</div>
<div id="S4.Thmthm15" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm15.2" class="ltx_text ltx_font_bold">Definition 4.15</span></span><span id="S4.Thmthm15.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm15.p1" class="ltx_para">
<p id="S4.Thmthm15.p1.1" class="ltx_p">Let <math id="S4.Thmthm15.p1.m1" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm Floer}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>Floer</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm Floer}</annotation></semantics></math>, <math id="S4.Thmthm15.p1.m2" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm PSS}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>PSS</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm PSS}</annotation></semantics></math>, <math id="S4.Thmthm15.p1.m3" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm SSP}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>SSP</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm SSP}</annotation></semantics></math>, <math id="S4.Thmthm15.p1.m4" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm Morse},{\mathfrak{D}}^{\rm hmtp}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝔇</mi><mi>Morse</mi></msup><mo>,</mo><msup><mi>𝔇</mi><mi>hmtp</mi></msup></mrow><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm Morse},{\mathfrak{D}}^{\rm hmtp}</annotation></semantics></math> be as in Definition <a href="#S4.Thmthm14" title="Definition 4.14. ‣ 4.6.3. Derived orbifold lift ‣ 4.6. The homotopy ‣ 4. Proof of the integral Arnold conjecture ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.14</span></a> with the respective collared structure, scaffolding, and normal complex structure. Moreover, assume that each of <math id="S4.Thmthm15.p1.m5" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm Floer}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>Floer</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm Floer}</annotation></semantics></math>, <math id="S4.Thmthm15.p1.m6" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm PSS}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>PSS</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm PSS}</annotation></semantics></math>, <math id="S4.Thmthm15.p1.m7" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm SSP}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>SSP</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm SSP}</annotation></semantics></math>, <math id="S4.Thmthm15.p1.m8" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm Morse}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>Morse</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm Morse}</annotation></semantics></math> is equipped with an orientation in the sense of Definition <a href="#S3.Thmthm43" title="Definition 3.43. ‣ 3.6. Normal complex structure and orientations on flow categories ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.43</span></a> and Definition <a href="#S3.Thmthm47" title="Definition 3.47. ‣ 3.6. Normal complex structure and orientations on flow categories ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.47</span></a>. Then an <span id="S4.Thmthm15.p1.1.1" class="ltx_text ltx_font_bold">orientation</span> on the given normally complex lift of <math id="S4.Thmthm15.p1.m9" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm hmtp}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>hmtp</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm hmtp}</annotation></semantics></math> consists of</p>
<ol id="S4.I12" class="ltx_enumerate">
<li id="S4.I12.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I12.i1.p1" class="ltx_para">
<p id="S4.I12.i1.p1.1" class="ltx_p">For all <math id="S4.I12.i1.p1.m1" class="ltx_Math" alttext="x,y" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow><annotation encoding="application/x-tex">x,y</annotation></semantics></math>, an isomorphism of orientation lines</p>
<table id="S4.E20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E20.m1" class="ltx_Math" alttext="\mathfrak{o}_{C_{xy}^{\rm hmtp}}\xrightarrow{\sim}\mathfrak{o}_{x}^{\vee}\otimes\mathfrak{o}_{y}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔬</mi><msubsup><mi>C</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>hmtp</mi></msubsup></msub><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><mrow><msubsup><mi>𝔬</mi><mi>x</mi><mo>∨</mo></msubsup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>𝔬</mi><mi>y</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathfrak{o}_{C_{xy}^{\rm hmtp}}\xrightarrow{\sim}\mathfrak{o}_{x}^{\vee}\otimes\mathfrak{o}_{y}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.20)</span></td></tr></tbody>
</table>
</div></li>
<li id="S4.I12.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I12.i2.p1" class="ltx_para">
<p id="S4.I12.i2.p1.2" class="ltx_p">Isomorphisms of orientation lines</p>
<table id="S4.E21" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S4.E21X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E21X.m2" class="ltx_Math" alttext="\displaystyle{\mathfrak{o}}_{C_{xy}^{\rm pearl}}\xrightarrow{\sim}{\mathfrak{o}}_{\partial^{+}C^{\rm hmtp}_{xy}}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔬</mi><msubsup><mi>C</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>pearl</mi></msubsup></msub><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><msub><mi>𝔬</mi><mrow><msup><mo>∂</mo><mo>+</mo></msup><msubsup><mi>C</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>hmtp</mi></msubsup></mrow></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\mathfrak{o}}_{C_{xy}^{\rm pearl}}\xrightarrow{\sim}{\mathfrak{o}}_{\partial^{+}C^{\rm hmtp}_{xy}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(4.21)</span></td></tr>
<tr id="S4.E21Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E21Xa.m2" class="ltx_Math" alttext="\displaystyle{\mathfrak{o}}_{C_{xp}^{\rm PSS}}\otimes{\mathfrak{o}}_{C_{py}^{\rm SSP}}\xrightarrow{\sim}{\mathfrak{o}}_{\partial^{xpy}C_{xy}^{\rm hmtp}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔬</mi><msubsup><mi>C</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mi>PSS</mi></msubsup></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>𝔬</mi><msubsup><mi>C</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>SSP</mi></msubsup></msub></mrow><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><msub><mi>𝔬</mi><mrow><msup><mo>∂</mo><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msup><msubsup><mi>C</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>hmtp</mi></msubsup></mrow></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\mathfrak{o}}_{C_{xp}^{\rm PSS}}\otimes{\mathfrak{o}}_{C_{py}^{\rm SSP}}\xrightarrow{\sim}{\mathfrak{o}}_{\partial^{xpy}C_{xy}^{\rm hmtp}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S4.E21Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E21Xb.m2" class="ltx_Math" alttext="\displaystyle{\mathfrak{o}}_{C_{xx^{\prime}}^{\rm Morse}}\otimes{\mathfrak{o}}_{C_{x^{\prime}y}^{\rm hmtp}}\xrightarrow{\sim}{\mathfrak{o}}_{\partial^{xx^{\prime}y}C_{xy}^{\rm hmtp}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔬</mi><msubsup><mi>C</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mo>′</mo></msup></mrow><mi>Morse</mi></msubsup></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>𝔬</mi><msubsup><mi>C</mi><mrow><msup><mi>x</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>hmtp</mi></msubsup></msub></mrow><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><msub><mi>𝔬</mi><mrow><msup><mo>∂</mo><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msup><msubsup><mi>C</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>hmtp</mi></msubsup></mrow></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\mathfrak{o}}_{C_{xx^{\prime}}^{\rm Morse}}\otimes{\mathfrak{o}}_{C_{x^{\prime}y}^{\rm hmtp}}\xrightarrow{\sim}{\mathfrak{o}}_{\partial^{xx^{\prime}y}C_{xy}^{\rm hmtp}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S4.E21Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E21Xc.m2" class="ltx_Math" alttext="\displaystyle{\mathfrak{o}}_{C_{xy^{\prime}}^{\rm hmtp}}\otimes{\mathfrak{o}}_{y^{\prime}y}^{\rm Morse}\xrightarrow{\sim}{\mathfrak{o}}_{\partial^{xy^{\prime}y}C^{\rm hmtp}_{xy}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔬</mi><msubsup><mi>C</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mo>′</mo></msup></mrow><mi>hmtp</mi></msubsup></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi>𝔬</mi><mrow><msup><mi>y</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>Morse</mi></msubsup></mrow><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><msub><mi>𝔬</mi><mrow><msup><mo>∂</mo><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msup><msubsup><mi>C</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mi>hmtp</mi></msubsup></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\mathfrak{o}}_{C_{xy^{\prime}}^{\rm hmtp}}\otimes{\mathfrak{o}}_{y^{\prime}y}^{\rm Morse}\xrightarrow{\sim}{\mathfrak{o}}_{\partial^{xy^{\prime}y}C^{\rm hmtp}_{xy}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.I12.i2.p1.3" class="ltx_p">Here we omit the cancellation of the orientation lines of the complex scaffolding vector bundles and its dual.</p>
</div></li>
<li id="S4.I12.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S4.I12.i3.p1" class="ltx_para">
<p id="S4.I12.i3.p1.1" class="ltx_p">The above isomorphisms are preserved by the <math id="S4.I12.i3.p1.m1" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>-action.</p>
</div></li>
</ol>
</div>
</div>
<div id="S4.Thmthm16" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm16.2" class="ltx_text ltx_font_bold">Theorem 4.16</span></span><span id="S4.Thmthm16.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm16.p1" class="ltx_para">
<p id="S4.Thmthm16.p1.1" class="ltx_p"><span id="S4.Thmthm16.p1.1.1" class="ltx_text ltx_font_italic">There is a <math id="S4.Thmthm16.p1.m1" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>-linear chain homotopy</span></p>
<table id="S4.Ex74" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex74.m1" class="ltx_Math" alttext="\Psi^{\rm hmtp}:CM_{*}(f;\Lambda)\to CM_{*-1}(f;\Lambda)" display="block" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Ψ</mi><mi>hmtp</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∗</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Psi^{\rm hmtp}:CM_{*}(f;\Lambda)\to CM_{*-1}(f;\Lambda)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm16.p1.2" class="ltx_p"><span id="S4.Thmthm16.p1.2.1" class="ltx_text ltx_font_italic">such that</span></p>
<table id="S4.E22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E22.m1" class="ltx_Math" alttext="\Psi^{\rm pearl}-\Psi^{\rm SSP}\circ\Psi^{\rm PSS}=d^{\rm Morse}\circ\Psi^{\rm hmtp}-\Psi^{\rm hmtp}\circ d^{\rm Morse}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi mathvariant="normal">Ψ</mi><mi>pearl</mi></msup><mo>−</mo><mrow><msup><mi mathvariant="normal">Ψ</mi><mi>SSP</mi></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi mathvariant="normal">Ψ</mi><mi>PSS</mi></msup></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>d</mi><mi>Morse</mi></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi mathvariant="normal">Ψ</mi><mi>hmtp</mi></msup></mrow><mo>−</mo><mrow><msup><mi mathvariant="normal">Ψ</mi><mi>hmtp</mi></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>d</mi><mi>Morse</mi></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Psi^{\rm pearl}-\Psi^{\rm SSP}\circ\Psi^{\rm PSS}=d^{\rm Morse}\circ\Psi^{\rm hmtp}-\Psi^{\rm hmtp}\circ d^{\rm Morse}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.22)</span></td></tr></tbody>
</table>
<p id="S4.Thmthm16.p1.3" class="ltx_p"><span id="S4.Thmthm16.p1.3.1" class="ltx_text ltx_font_italic">In particular, there holds</span></p>
<table id="S4.E23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E23.m1" class="ltx_Math" alttext="\Psi^{\rm SSP}\circ\Psi^{\rm PSS}=\Psi^{\rm pearl}" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">Ψ</mi><mi>SSP</mi></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi mathvariant="normal">Ψ</mi><mi>PSS</mi></msup></mrow><mo>=</mo><msup><mi mathvariant="normal">Ψ</mi><mi>pearl</mi></msup></mrow><annotation encoding="application/x-tex">\Psi^{\rm SSP}\circ\Psi^{\rm PSS}=\Psi^{\rm pearl}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.23)</span></td></tr></tbody>
</table>
<p id="S4.Thmthm16.p1.4" class="ltx_p"><span id="S4.Thmthm16.p1.4.1" class="ltx_text ltx_font_italic">as graded linear maps on <math id="S4.Thmthm16.p1.m2" class="ltx_Math" alttext="H_{*}(M;\Lambda)" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{*}(M;\Lambda)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS6.SSS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS6.SSS3.p3" class="ltx_para">
<p id="S4.SS6.SSS3.p3.1" class="ltx_p"><span id="S4.SS6.SSS3.p3.1.1" class="ltx_text">Using the description presented in Section <a href="#S7" title="7. Constructions for PSS, SSP, and the homotopy ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>, there exists a compatible oriented and normally complex derived orbifold lift <math id="S4.SS6.SSS3.p3.m1" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm hmtp}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>hmtp</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm hmtp}</annotation></semantics></math> of the outer-collared homotopy moduli spaces <math id="S4.SS6.SSS3.p3.m2" class="ltx_math_unparsed" alttext="(\overline{\mathcal{M}}{}_{xy}^{\rm hmtp})^{+}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mo stretchy="false">)</mo><mrow></mrow><mi>hmtp</mi><mprescripts></mprescripts><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mrow></mrow></mmultiscripts></mrow><mo>+</mo></msup><annotation encoding="application/x-tex">(\overline{\mathcal{M}}{}_{xy}^{\rm hmtp})^{+}</annotation></semantics></math>, with collared structure and scaffolding. Then the relative version of the arguments in Section <a href="#S6.SS3.SSS1" title="6.3.1. Constructing straightening ‣ 6.3. The main theorem about smoothing ‣ 6. Smoothing ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.3.1</span></a> can be used to equip <math id="S4.SS6.SSS3.p3.m3" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm hmtp}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>hmtp</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm hmtp}</annotation></semantics></math> with a straightening compatible with the given straightenings on <math id="S4.SS6.SSS3.p3.m4" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm Floer}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>Floer</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm Floer}</annotation></semantics></math>, <math id="S4.SS6.SSS3.p3.m5" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm PSS}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>PSS</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm PSS}</annotation></semantics></math>, <math id="S4.SS6.SSS3.p3.m6" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm SSP}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>SSP</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm SSP}</annotation></semantics></math>, <math id="S4.SS6.SSS3.p3.m7" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm Morse}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>Morse</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm Morse}</annotation></semantics></math>. Therefore, a relative version of Theorem <a href="#S3.Thmthm49" title="Theorem 3.49. ‣ 3.7. Constructing FOP perturbations ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.49</span></a> allows us to find a compatible system of strongly transverse FOP perturbations of the derived orbifold charts in <math id="S4.SS6.SSS3.p3.m8" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm hmtp}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>hmtp</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm hmtp}</annotation></semantics></math> extending the FOP perturbations on <math id="S4.SS6.SSS3.p3.m9" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm Floer}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>Floer</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm Floer}</annotation></semantics></math>, <math id="S4.SS6.SSS3.p3.m10" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm PSS}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>PSS</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm PSS}</annotation></semantics></math>, <math id="S4.SS6.SSS3.p3.m11" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm SSP}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>SSP</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm SSP}</annotation></semantics></math>, <math id="S4.SS6.SSS3.p3.m12" class="ltx_Math" alttext="{\mathfrak{D}}^{\rm Morse}" display="inline" intent=":literal"><semantics><msup><mi>𝔇</mi><mi>Morse</mi></msup><annotation encoding="application/x-tex">{\mathfrak{D}}^{\rm Morse}</annotation></semantics></math>. Using the sign read off from (<a href="#S4.E20" title="In item 1 ‣ Definition 4.15. ‣ 4.6.3. Derived orbifold lift ‣ 4.6. The homotopy ‣ 4. Proof of the integral Arnold conjecture ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.20</span></a>), the map <math id="S4.SS6.SSS3.p3.m13" class="ltx_Math" alttext="\Psi^{\rm hmtp}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">Ψ</mi><mi>hmtp</mi></msup><annotation encoding="application/x-tex">\Psi^{\rm hmtp}</annotation></semantics></math> is defined by the algebraic count of zeroes of the FOP sections over moduli spaces of virtual dimension <math id="S4.SS6.SSS3.p3.m14" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>. The algebraic relation (<a href="#S4.E22" title="In Theorem 4.16. ‣ 4.6.3. Derived orbifold lift ‣ 4.6. The homotopy ‣ 4. Proof of the integral Arnold conjecture ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.22</span></a>) is again read off from the boundary of moduli spaces of virtural dimension <math id="S4.SS6.SSS3.p3.m15" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>, using the coherence of orientations (<a href="#S4.E21" title="In item 2 ‣ Definition 4.15. ‣ 4.6.3. Derived orbifold lift ‣ 4.6. The homotopy ‣ 4. Proof of the integral Arnold conjecture ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.21</span></a>). The <math id="S4.SS6.SSS3.p3.m16" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>-linearity is a result of the strict <math id="S4.SS6.SSS3.p3.m17" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>-action as before.
∎</span></p>
</div>
</div>
<div id="S4.SS6.SSS3.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Theorem <a href="#Thmthma3" title="Theorem C. ‣ 1.1. Proof strategy ‣ 1. Introduction ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C</span></a>.</h6>
<div id="S4.SS6.SSS3.p4" class="ltx_para">
<p id="S4.SS6.SSS3.p4.1" class="ltx_p"><span id="S4.SS6.SSS3.p4.1.1" class="ltx_text">This is a direct consequence of Corollary <a href="#S4.Thmthm11" title="Corollary 4.11. ‣ 4.5. Main Theorems ‣ 4. Proof of the integral Arnold conjecture ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.11</span></a> and Equation (<a href="#S4.E23" title="In Theorem 4.16. ‣ 4.6.3. Derived orbifold lift ‣ 4.6. The homotopy ‣ 4. Proof of the integral Arnold conjecture ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.23</span></a>).
∎</span></p>
</div>
</div>
</section>
</section>
<section id="S4.SS7" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.7. </span>Proof of the integral Arnold conjecture</h3>

<div id="S4.Thmthm17" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm17.2" class="ltx_text ltx_font_bold">Lemma 4.17</span></span><span id="S4.Thmthm17.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm17.p1" class="ltx_para">
<p id="S4.Thmthm17.p1.1" class="ltx_p"><span id="S4.Thmthm17.p1.1.1" class="ltx_text ltx_font_italic">(cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx20" title="" class="ltx_ref">HM06</a>, Appendix]</cite>)
The Novikov ring <math id="S4.Thmthm17.p1.m1" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> is a principal ideal domain (PID).</span></p>
</div>
</div>
<div id="S4.SS7.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS7.p1" class="ltx_para">
<p id="S4.SS7.p1.1" class="ltx_p"><span id="S4.SS7.p1.1.1" class="ltx_text">By definition, we need to show that each ideal is a principal ideal, i.e., generated by a single element. Let <math id="S4.SS7.p1.m1" class="ltx_Math" alttext="I\subseteq\Lambda" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo>⊆</mo><mi mathvariant="normal">Λ</mi></mrow><annotation encoding="application/x-tex">I\subseteq\Lambda</annotation></semantics></math> be an ideal. Denote by <math id="S4.SS7.p1.m2" class="ltx_Math" alttext="a_{0}\in{\mathbb{Z}}_{+}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mn>0</mn></msub><mo>∈</mo><msub><mi>ℤ</mi><mo>+</mo></msub></mrow><annotation encoding="application/x-tex">a_{0}\in{\mathbb{Z}}_{+}</annotation></semantics></math> the greatest common divisor of the leading coefficients of all elements of <math id="S4.SS7.p1.m3" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi>I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math>. Then there exists <math id="S4.SS7.p1.m4" class="ltx_Math" alttext="{\mathfrak{x}}_{0}\in I" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔵</mi><mn>0</mn></msub><mo>∈</mo><mi>I</mi></mrow><annotation encoding="application/x-tex">{\mathfrak{x}}_{0}\in I</annotation></semantics></math> of the form <math id="S4.SS7.p1.m5" class="ltx_Math" alttext="{\mathfrak{x}}_{0}=a_{0}+{\mathfrak{y}}_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔵</mi><mn>0</mn></msub><mo>=</mo><mrow><msub><mi>a</mi><mn>0</mn></msub><mo>+</mo><msub><mi>𝔶</mi><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">{\mathfrak{x}}_{0}=a_{0}+{\mathfrak{y}}_{0}</annotation></semantics></math> with <math id="S4.SS7.p1.m6" class="ltx_Math" alttext="{\mathfrak{y}}_{0}\in\Lambda_{+}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔶</mi><mn>0</mn></msub><mo>∈</mo><msub><mi mathvariant="normal">Λ</mi><mo>+</mo></msub></mrow><annotation encoding="application/x-tex">{\mathfrak{y}}_{0}\in\Lambda_{+}</annotation></semantics></math>. We claim that</span></p>
<table id="S4.Ex75" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex75.m1" class="ltx_Math" alttext="I=({\mathfrak{x}}_{0})." display="block" intent=":literal"><semantics><mrow><mrow><mi>I</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔵</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">I=({\mathfrak{x}}_{0}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS7.p1.2" class="ltx_p"><span id="S4.SS7.p1.2.1" class="ltx_text">Indeed, given any <math id="S4.SS7.p1.m7" class="ltx_Math" alttext="{\mathfrak{x}}\in I" display="inline" intent=":literal"><semantics><mrow><mi>𝔵</mi><mo>∈</mo><mi>I</mi></mrow><annotation encoding="application/x-tex">{\mathfrak{x}}\in I</annotation></semantics></math>, <math id="S4.SS7.p1.m8" class="ltx_Math" alttext="a_{0}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mn>0</mn></msub><annotation encoding="application/x-tex">a_{0}</annotation></semantics></math> divides the leading order term of <math id="S4.SS7.p1.m9" class="ltx_Math" alttext="{\mathfrak{x}}" display="inline" intent=":literal"><semantics><mi>𝔵</mi><annotation encoding="application/x-tex">{\mathfrak{x}}</annotation></semantics></math>. We can inductively find an element <math id="S4.SS7.p1.m10" class="ltx_Math" alttext="{\mathfrak{q}}\in\Lambda" display="inline" intent=":literal"><semantics><mrow><mi>𝔮</mi><mo>∈</mo><mi mathvariant="normal">Λ</mi></mrow><annotation encoding="application/x-tex">{\mathfrak{q}}\in\Lambda</annotation></semantics></math> such that <math id="S4.SS7.p1.m11" class="ltx_Math" alttext="{\mathfrak{x}}={\mathfrak{q}}{\mathfrak{x}}_{0}" display="inline" intent=":literal"><semantics><mrow><mi>𝔵</mi><mo>=</mo><mrow><mi>𝔮</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔵</mi><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">{\mathfrak{x}}={\mathfrak{q}}{\mathfrak{x}}_{0}</annotation></semantics></math>. Hence <math id="S4.SS7.p1.m12" class="ltx_Math" alttext="I=({\mathfrak{x}}_{0})" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔵</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">I=({\mathfrak{x}}_{0})</annotation></semantics></math> and <math id="S4.SS7.p1.m13" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> is a PID.
∎</span></p>
</div>
</div>
<div id="S4.SS7.p2" class="ltx_para">
<p id="S4.SS7.p2.1" class="ltx_p">Recall the standard structure results about finitely-generated modules over principal ideal domains. If <math id="S4.SS7.p2.m1" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> is a principal ideal domain and <math id="S4.SS7.p2.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> is a finitely-generated <math id="S4.SS7.p2.m3" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>-module, then</p>
<table id="S4.Ex76" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex76.m1" class="ltx_Math" alttext="M\cong F\oplus T" display="block" intent=":literal"><semantics><mrow><mi>M</mi><mo>≅</mo><mrow><mi>F</mi><mo>⊕</mo><mi>T</mi></mrow></mrow><annotation encoding="application/x-tex">M\cong F\oplus T</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS7.p2.2" class="ltx_p">where <math id="S4.SS7.p2.m4" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> is a free <math id="S4.SS7.p2.m5" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>-module of finite rank and <math id="S4.SS7.p2.m6" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> is a torsion <math id="S4.SS7.p2.m7" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>-module. Moreover,</p>
<ol id="S4.I13" class="ltx_enumerate">
<li id="S4.I13.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I13.i1.p1" class="ltx_para">
<p id="S4.I13.i1.p1.1" class="ltx_p">There exist primes <math id="S4.I13.i1.p1.m1" class="ltx_Math" alttext="p_{1},\ldots,p_{k}\in R" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>p</mi><mi>k</mi></msub><mo>∈</mo><mi>R</mi></mrow></mrow><annotation encoding="application/x-tex">p_{1},\ldots,p_{k}\in R</annotation></semantics></math> and positive integers <math id="S4.I13.i1.p1.m2" class="ltx_Math" alttext="m_{1},\ldots,m_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>m</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">m_{1},\ldots,m_{k}</annotation></semantics></math> such that</p>
<table id="S4.Ex77" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex77.m1" class="ltx_Math" alttext="T\cong R/(p_{1}^{m_{1}})\oplus\cdots\oplus R/(p_{k}^{m_{k}})." display="block" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo>≅</mo><mrow><mrow><mi>R</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>p</mi><mn>1</mn><msub><mi>m</mi><mn>1</mn></msub></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>⊕</mo><mrow><mi>R</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>p</mi><mi>k</mi><msub><mi>m</mi><mi>k</mi></msub></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">T\cong R/(p_{1}^{m_{1}})\oplus\cdots\oplus R/(p_{k}^{m_{k}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.I13.i1.p1.2" class="ltx_p">The prime powers <math id="S4.I13.i1.p1.m3" class="ltx_Math" alttext="p_{i}^{m_{i}}" display="inline" intent=":literal"><semantics><msubsup><mi>p</mi><mi>i</mi><msub><mi>m</mi><mi>i</mi></msub></msubsup><annotation encoding="application/x-tex">p_{i}^{m_{i}}</annotation></semantics></math> are called the <span id="S4.I13.i1.p1.2.1" class="ltx_text ltx_font_italic">elementary divisors</span>.</p>
</div></li>
<li id="S4.I13.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I13.i2.p1" class="ltx_para">
<p id="S4.I13.i2.p1.1" class="ltx_p">There exist nonzero nonunit elements <math id="S4.I13.i2.p1.m1" class="ltx_Math" alttext="r_{1},\ldots,r_{l}" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>r</mi><mi>l</mi></msub></mrow><annotation encoding="application/x-tex">r_{1},\ldots,r_{l}</annotation></semantics></math> of <math id="S4.I13.i2.p1.m2" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> such that <math id="S4.I13.i2.p1.m3" class="ltx_Math" alttext="r_{1}|r_{2}|\cdots|r_{l}" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mn>1</mn></msub><mo fence="false">|</mo><mrow><msub><mi>r</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mo lspace="0em" rspace="0em">⋯</mo><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>l</mi></msub></mrow></mrow><annotation encoding="application/x-tex">r_{1}|r_{2}|\cdots|r_{l}</annotation></semantics></math> and</p>
<table id="S4.Ex78" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex78.m1" class="ltx_Math" alttext="T\cong R/(r_{1})\oplus\cdots\oplus R/(r_{l})." display="block" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo>≅</mo><mrow><mrow><mi>R</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>⊕</mo><mrow><mi>R</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">T\cong R/(r_{1})\oplus\cdots\oplus R/(r_{l}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.I13.i2.p1.2" class="ltx_p">The elements <math id="S4.I13.i2.p1.m4" class="ltx_Math" alttext="r_{i}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>i</mi></msub><annotation encoding="application/x-tex">r_{i}</annotation></semantics></math> are called the <span id="S4.I13.i2.p1.2.1" class="ltx_text ltx_font_italic">invariant factors</span>.</p>
</div></li>
</ol>
</div>
<div id="S4.Thmthm18" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm18.2" class="ltx_text ltx_font_bold">Lemma 4.18</span></span><span id="S4.Thmthm18.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm18.p1" class="ltx_para">
<p id="S4.Thmthm18.p1.1" class="ltx_p"><span id="S4.Thmthm18.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmthm18.p1.m1" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> be a PID. Let <math id="S4.Thmthm18.p1.m2" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math> be a free <math id="S4.Thmthm18.p1.m3" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>-module of finite rank and <math id="S4.Thmthm18.p1.m4" class="ltx_Math" alttext="S\subseteq Z" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⊆</mo><mi>Z</mi></mrow><annotation encoding="application/x-tex">S\subseteq Z</annotation></semantics></math> be a submodule. Suppose</span></p>
<table id="S4.Ex79" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex79.m1" class="ltx_Math" alttext="Z/S\cong F\oplus R/(a_{1})\oplus\cdots\oplus R/(a_{k})" display="block" intent=":literal"><semantics><mrow><mrow><mi>Z</mi><mo>/</mo><mi>S</mi></mrow><mo>≅</mo><mrow><mi>F</mi><mo>⊕</mo><mrow><mi>R</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>⊕</mo><mrow><mi>R</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">Z/S\cong F\oplus R/(a_{1})\oplus\cdots\oplus R/(a_{k})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm18.p1.2" class="ltx_p"><span id="S4.Thmthm18.p1.2.1" class="ltx_text ltx_font_italic">where <math id="S4.Thmthm18.p1.m5" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> is a free <math id="S4.Thmthm18.p1.m6" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>-module and <math id="S4.Thmthm18.p1.m7" class="ltx_Math" alttext="a_{1}|a_{2}|\cdots|a_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mn>1</mn></msub><mo fence="false">|</mo><mrow><msub><mi>a</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mo lspace="0em" rspace="0em">⋯</mo><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">a_{1}|a_{2}|\cdots|a_{k}</annotation></semantics></math> are invariant factors. Then</span></p>
<table id="S4.Ex80" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex80.m1" class="ltx_Math" alttext="{\rm rank}Z\geq{\rm rank}F+k" display="block" intent=":literal"><semantics><mrow><mrow><mi>rank</mi><mo lspace="0em" rspace="0em">​</mo><mi>Z</mi></mrow><mo>≥</mo><mrow><mrow><mi>rank</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>+</mo><mi>k</mi></mrow></mrow><annotation encoding="application/x-tex">{\rm rank}Z\geq{\rm rank}F+k</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm18.p1.3" class="ltx_p"><span id="S4.Thmthm18.p1.3.1" class="ltx_text ltx_font_italic">and</span></p>
<table id="S4.Ex81" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex81.m1" class="ltx_Math" alttext="{\rm rank}S\geq k." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>rank</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>≥</mo><mi>k</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\rm rank}S\geq k.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.SS7.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS7.p3" class="ltx_para">
<p id="S4.SS7.p3.1" class="ltx_p"><span id="S4.SS7.p3.1.1" class="ltx_text">By tensoring with the quotient field of <math id="S4.SS7.p3.m1" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>, we can kill all torsions. Then it follows that <math id="S4.SS7.p3.m2" class="ltx_Math" alttext="{\rm rank}Z-{\rm rank}S={\rm rank}F" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>rank</mi><mo lspace="0em" rspace="0em">​</mo><mi>Z</mi></mrow><mo>−</mo><mrow><mi>rank</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow></mrow><mo>=</mo><mrow><mi>rank</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></mrow><annotation encoding="application/x-tex">{\rm rank}Z-{\rm rank}S={\rm rank}F</annotation></semantics></math>. Hence it suffices to prove the first lower bound. Choose a prime divisor <math id="S4.SS7.p3.m3" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> of <math id="S4.SS7.p3.m4" class="ltx_Math" alttext="a_{1}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mn>1</mn></msub><annotation encoding="application/x-tex">a_{1}</annotation></semantics></math>. By tensoring with <math id="S4.SS7.p3.m5" class="ltx_Math" alttext="R_{p}:=R/(p)" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>p</mi></msub><mo>:=</mo><mrow><mi>R</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">R_{p}:=R/(p)</annotation></semantics></math>, we can see that</span></p>
<table id="S4.Ex82" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex82.m1" class="ltx_math_unparsed" alttext="Z\otimes_{R}R_{p}/S\otimes_{R}R_{p}\cong R_{p}^{{\rm rank}F+k}." display="block" intent=":literal"><semantics><mrow><mi>Z</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mrow></mrow><mi>R</mi></msub><mi>R</mi><msub><mrow></mrow><mi>p</mi></msub><mo>/</mo><mi>S</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mrow></mrow><mi>R</mi></msub><mi>R</mi><msub><mrow></mrow><mi>p</mi></msub><mo>≅</mo><mi>R</mi><msub><mrow></mrow><mi>p</mi></msub><msup><mrow></mrow><mrow><mrow><mi>rank</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>+</mo><mi>k</mi></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Z\otimes_{R}R_{p}/S\otimes_{R}R_{p}\cong R_{p}^{{\rm rank}F+k}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS7.p3.2" class="ltx_p"><span id="S4.SS7.p3.2.1" class="ltx_text">Therefore,</span></p>
<table id="S4.Ex83" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex83.m1" class="ltx_Math" alttext="{\rm rank}Z={\rm dim}_{R_{p}}Z\otimes_{R}R_{p}\geq{\rm rank}F+k.\qed" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>rank</mi><mo lspace="0em" rspace="0em">​</mo><mi>Z</mi></mrow><mo>=</mo><mrow><mrow><msub><mi>dim</mi><msub><mi>R</mi><mi>p</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>Z</mi></mrow><msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>R</mi></msub><msub><mi>R</mi><mi>p</mi></msub></mrow><mo>≥</mo><mrow><mrow><mi>rank</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>+</mo><mi>k</mi></mrow></mrow><mo lspace="0em" rspace="0.0835em">.</mo><mo class="ltx_mathvariant_italic" lspace="0.0835em" mathvariant="italic" separator="true">∎</mo></mrow><annotation encoding="application/x-tex">{\rm rank}Z={\rm dim}_{R_{p}}Z\otimes_{R}R_{p}\geq{\rm rank}F+k.\qed</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.Thmthm19" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm19.2" class="ltx_text ltx_font_bold">Lemma 4.19</span></span><span id="S4.Thmthm19.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm19.p1" class="ltx_para">
<p id="S4.Thmthm19.p1.1" class="ltx_p"><span id="S4.Thmthm19.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmthm19.p1.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> be a finitely-generated <math id="S4.Thmthm19.p1.m2" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>-module and <math id="S4.Thmthm19.p1.m3" class="ltx_Math" alttext="N\subseteq M" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>⊆</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">N\subseteq M</annotation></semantics></math> be a submodule. Then</span></p>
<ol id="S4.I14" class="ltx_enumerate">
<li id="S4.I14.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I14.i1.p1" class="ltx_para">
<p id="S4.I14.i1.p1.1" class="ltx_p"><math id="S4.I14.i1.p1.m1" class="ltx_Math" alttext="{\rm rank}N\leq{\rm rank}M" display="inline" intent=":literal"><semantics><mrow><mrow><mi>rank</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>≤</mo><mrow><mi>rank</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">{\rm rank}N\leq{\rm rank}M</annotation></semantics></math><span id="S4.I14.i1.p1.1.1" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I14.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I14.i2.p1" class="ltx_para">
<p id="S4.I14.i2.p1.1" class="ltx_p"><span id="S4.I14.i2.p1.1.1" class="ltx_text ltx_font_italic">For each prime </span><math id="S4.I14.i2.p1.m1" class="ltx_Math" alttext="p\in R" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">p\in R</annotation></semantics></math><span id="S4.I14.i2.p1.1.2" class="ltx_text ltx_font_italic">, the number of elementary divisors of </span><math id="S4.I14.i2.p1.m2" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math><span id="S4.I14.i2.p1.1.3" class="ltx_text ltx_font_italic"> which are powers of </span><math id="S4.I14.i2.p1.m3" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math><span id="S4.I14.i2.p1.1.4" class="ltx_text ltx_font_italic"> is less than or equal to the number of elementary divisors of </span><math id="S4.I14.i2.p1.m4" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math><span id="S4.I14.i2.p1.1.5" class="ltx_text ltx_font_italic"> which are powers of </span><math id="S4.I14.i2.p1.m5" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math><span id="S4.I14.i2.p1.1.6" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I14.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S4.I14.i3.p1" class="ltx_para">
<p id="S4.I14.i3.p1.1" class="ltx_p"><span id="S4.I14.i3.p1.1.1" class="ltx_text ltx_font_italic">The number of invariant factors of </span><math id="S4.I14.i3.p1.m1" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math><span id="S4.I14.i3.p1.1.2" class="ltx_text ltx_font_italic"> is not greater than the number of invariant factors of </span><math id="S4.I14.i3.p1.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math><span id="S4.I14.i3.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S4.SS7.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS7.p4" class="ltx_para">
<p id="S4.SS7.p4.1" class="ltx_p"><span id="S4.SS7.p4.1.1" class="ltx_text">By the structure theorem of finitely-generated modules over PID, we can write</span></p>
<table id="S4.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex84"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex84.m1" class="ltx_Math" alttext="\displaystyle\ M\cong F\oplus\bigoplus_{i=1}^{k}R/(p_{i}^{m_{i}}),\ " display="inline" intent=":literal"><semantics><mrow><mrow><mi>M</mi><mo>≅</mo><mrow><mi>F</mi><mo>⊕</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">⨁</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover></mstyle><mi>R</mi></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>p</mi><mi>i</mi><msub><mi>m</mi><mi>i</mi></msub></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ M\cong F\oplus\bigoplus_{i=1}^{k}R/(p_{i}^{m_{i}}),\ </annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex84.m2" class="ltx_Math" alttext="\displaystyle\ N\cong F^{\prime}\oplus\bigoplus_{j=1}^{l}R/(q_{j}^{n_{j}})" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>≅</mo><mrow><msup><mi>F</mi><mo>′</mo></msup><mo>⊕</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">⨁</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>l</mi></munderover></mstyle><mi>R</mi></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>q</mi><mi>j</mi><msub><mi>n</mi><mi>j</mi></msub></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ N\cong F^{\prime}\oplus\bigoplus_{j=1}^{l}R/(q_{j}^{n_{j}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS7.p4.2" class="ltx_p"><span id="S4.SS7.p4.2.1" class="ltx_text">where <math id="S4.SS7.p4.m1" class="ltx_Math" alttext="p_{i}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>i</mi></msub><annotation encoding="application/x-tex">p_{i}</annotation></semantics></math>, <math id="S4.SS7.p4.m2" class="ltx_Math" alttext="q_{j}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mi>j</mi></msub><annotation encoding="application/x-tex">q_{j}</annotation></semantics></math> are primes of <math id="S4.SS7.p4.m3" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> and <math id="S4.SS7.p4.m4" class="ltx_Math" alttext="m_{i},n_{j}\geq 1" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>n</mi><mi>j</mi></msub><mo>≥</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">m_{i},n_{j}\geq 1</annotation></semantics></math>. By tensoring the quotient field of <math id="S4.SS7.p4.m5" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>, we can see that <math id="S4.SS7.p4.m6" class="ltx_Math" alttext="{\rm rank}F^{\prime}\leq{\rm rank}F" display="inline" intent=":literal"><semantics><mrow><mrow><mi>rank</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>F</mi><mo>′</mo></msup></mrow><mo>≤</mo><mrow><mi>rank</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></mrow><annotation encoding="application/x-tex">{\rm rank}F^{\prime}\leq{\rm rank}F</annotation></semantics></math>. On the other hand, let <math id="S4.SS7.p4.m7" class="ltx_Math" alttext="M(p)\subseteq M" display="inline" intent=":literal"><semantics><mrow><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊆</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">M(p)\subseteq M</annotation></semantics></math> be the direct sum of <math id="S4.SS7.p4.m8" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>-torsions. Then the inclusion <math id="S4.SS7.p4.m9" class="ltx_Math" alttext="N\hookrightarrow M" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo stretchy="false">↪</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">N\hookrightarrow M</annotation></semantics></math> induces injections <math id="S4.SS7.p4.m10" class="ltx_Math" alttext="N(p)\hookrightarrow M(p)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">↪</mo><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">N(p)\hookrightarrow M(p)</annotation></semantics></math> for each prime <math id="S4.SS7.p4.m11" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>. Therefore, the collection of <math id="S4.SS7.p4.m12" class="ltx_Math" alttext="q_{j}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mi>j</mi></msub><annotation encoding="application/x-tex">q_{j}</annotation></semantics></math>’s is a subset of the collection of <math id="S4.SS7.p4.m13" class="ltx_Math" alttext="p_{i}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>i</mi></msub><annotation encoding="application/x-tex">p_{i}</annotation></semantics></math>’s. Then for each prime <math id="S4.SS7.p4.m14" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>, denote</span></p>
<table id="S4.Ex85" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex85.m1" class="ltx_Math" alttext="M[p]:=\{x\in M\ |\ px=0\}" display="block" intent=":literal"><semantics><mrow><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>p</mi><mo stretchy="false">]</mo></mrow></mrow><mo>:=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>x</mi><mo>∈</mo><mi>M</mi></mrow><mo lspace="0.500em" rspace="0.500em">|</mo><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>=</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">M[p]:=\{x\in M\ |\ px=0\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS7.p4.3" class="ltx_p"><span id="S4.SS7.p4.3.1" class="ltx_text">which is a submodule. Then the inclusion <math id="S4.SS7.p4.m15" class="ltx_Math" alttext="N\hookrightarrow M" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo stretchy="false">↪</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">N\hookrightarrow M</annotation></semantics></math> induces an injection <math id="S4.SS7.p4.m16" class="ltx_Math" alttext="N[p]\hookrightarrow M[p]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>p</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">↪</mo><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>p</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">N[p]\hookrightarrow M[p]</annotation></semantics></math>. Notice that <math id="S4.SS7.p4.m17" class="ltx_Math" alttext="R/(p)" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R/(p)</annotation></semantics></math> is a field and <math id="S4.SS7.p4.m18" class="ltx_Math" alttext="M[p]" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>p</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">M[p]</annotation></semantics></math> is a <math id="S4.SS7.p4.m19" class="ltx_Math" alttext="R/(p)" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R/(p)</annotation></semantics></math>-vector space. Clearly <math id="S4.SS7.p4.m20" class="ltx_Math" alttext="N[p]" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>p</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">N[p]</annotation></semantics></math> is a subspace. Moreover, recall that</span></p>
<table id="S4.Ex86" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex86.m1" class="ltx_Math" alttext="(R/(p^{m}))[p]\cong R/(p)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>R</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><msup><mi>p</mi><mi>m</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>p</mi><mo stretchy="false">]</mo></mrow></mrow><mo>≅</mo><mrow><mi>R</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(R/(p^{m}))[p]\cong R/(p).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS7.p4.4" class="ltx_p"><span id="S4.SS7.p4.4.1" class="ltx_text">Hence it follows that the number of <math id="S4.SS7.p4.m21" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>-elementary divisors of <math id="S4.SS7.p4.m22" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> is no greater than the number of <math id="S4.SS7.p4.m23" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>-elementary divisors of <math id="S4.SS7.p4.m24" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>. The relation between their numbers of invariant factors follows immediately.
∎</span></p>
</div>
</div>
<div id="S4.SS7.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Theorem <a href="#Thmthma1" title="Theorem A. ‣ 1. Introduction ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A</span></a>.</h6>
<div id="S4.SS7.p5" class="ltx_para">
<p id="S4.SS7.p5.1" class="ltx_p"><span id="S4.SS7.p5.1.1" class="ltx_text">Now consider the two <math id="S4.SS7.p5.m1" class="ltx_Math" alttext="{\mathbb{Z}}/2N" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℤ</mi><mo>/</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">{\mathbb{Z}}/2N</annotation></semantics></math>-graded <math id="S4.SS7.p5.m2" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>-modules, <math id="S4.SS7.p5.m3" class="ltx_Math" alttext="HF_{*}(H;\Lambda)" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">HF_{*}(H;\Lambda)</annotation></semantics></math> and <math id="S4.SS7.p5.m4" class="ltx_Math" alttext="H_{*}(M;\Lambda)" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{*}(M;\Lambda)</annotation></semantics></math>. Because <math id="S4.SS7.p5.m5" class="ltx_Math" alttext="\Psi^{\rm SSP}\circ\Psi^{\rm PSS}=\Psi^{\rm pearl}=Id+O(T)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi mathvariant="normal">Ψ</mi><mi>SSP</mi></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi mathvariant="normal">Ψ</mi><mi>PSS</mi></msup></mrow><mo>=</mo><msup><mi mathvariant="normal">Ψ</mi><mi>pearl</mi></msup><mo>=</mo><mrow><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Psi^{\rm SSP}\circ\Psi^{\rm PSS}=\Psi^{\rm pearl}=Id+O(T)</annotation></semantics></math>, so for each <math id="S4.SS7.p5.m6" class="ltx_Math" alttext="i\in{\mathbb{Z}}/{2N}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mrow><mi>ℤ</mi><mo>/</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow><annotation encoding="application/x-tex">i\in{\mathbb{Z}}/{2N}</annotation></semantics></math>, the PSS map embeds <math id="S4.SS7.p5.m7" class="ltx_Math" alttext="H_{i}(M;\Lambda)" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H_{i}(M;\Lambda)</annotation></semantics></math> as a submodule of <math id="S4.SS7.p5.m8" class="ltx_Math" alttext="HF_{i}(H;\Lambda)" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">HF_{i}(H;\Lambda)</annotation></semantics></math>. Therefore, for the free part, one has the rank inequality</span></p>
<table id="S4.Ex87" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex87.m1" class="ltx_Math" alttext="{\rm rank}HF_{i}(H;\Lambda)\geq{\rm rank}H_{*}(M;\Lambda),\ i\in{\mathbb{Z}}/2N." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>rank</mi><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi>rank</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mrow><mi>ℤ</mi><mo>/</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\rm rank}HF_{i}(H;\Lambda)\geq{\rm rank}H_{*}(M;\Lambda),\ i\in{\mathbb{Z}}/2N.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS7.p5.2" class="ltx_p"><span id="S4.SS7.p5.2.1" class="ltx_text">As of torsion, Lemma <a href="#S4.Thmthm19" title="Lemma 4.19. ‣ 4.7. Proof of the integral Arnold conjecture ‣ 4. Proof of the integral Arnold conjecture ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.19</span></a> implies the inequality between number of invariant factors</span></p>
<table id="S4.Ex88" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex88.m1" class="ltx_Math" alttext="\tau_{i}^{\rm Floer}\geq\tau_{i}^{\rm Morse},\ i\in{\mathbb{Z}}/2N" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>τ</mi><mi>i</mi><mi>Floer</mi></msubsup><mo>≥</mo><msubsup><mi>τ</mi><mi>i</mi><mi>Morse</mi></msubsup></mrow><mo rspace="0.667em">,</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mrow><mi>ℤ</mi><mo>/</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau_{i}^{\rm Floer}\geq\tau_{i}^{\rm Morse},\ i\in{\mathbb{Z}}/2N</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS7.p5.3" class="ltx_p"><span id="S4.SS7.p5.3.1" class="ltx_text">On the other hand, we know that</span></p>
<table id="S4.Ex89" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex89.m1" class="ltx_Math" alttext="HF_{i}(H;\Lambda)=\frac{{\rm ker}d_{i}^{\rm Floer}}{{\rm image}d_{i+1}^{\rm Floer}}" display="block" intent=":literal"><semantics><mrow><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mi>ker</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mi>i</mi><mi>Floer</mi></msubsup></mrow><mrow><mi>image</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mi>Floer</mi></msubsup></mrow></mfrac></mrow><annotation encoding="application/x-tex">HF_{i}(H;\Lambda)=\frac{{\rm ker}d_{i}^{\rm Floer}}{{\rm image}d_{i+1}^{\rm Floer}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS7.p5.4" class="ltx_p"><span id="S4.SS7.p5.4.1" class="ltx_text">where both the numerator and denominator are free <math id="S4.SS7.p5.m9" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>-modules. Hence by Lemma <a href="#S4.Thmthm18" title="Lemma 4.18. ‣ 4.7. Proof of the integral Arnold conjecture ‣ 4. Proof of the integral Arnold conjecture ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.18</span></a>, one has</span></p>
<table id="S4.Ex90" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex90.m1" class="ltx_Math" alttext="{\rm rank}({\rm ker}d_{i}^{\rm Floer})\geq{\rm rank}H_{i}(M;\Lambda)+\tau_{i}^{\rm Morse}" display="block" intent=":literal"><semantics><mrow><mrow><mi>rank</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ker</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mi>i</mi><mi>Floer</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mrow><mi>rank</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msubsup><mi>τ</mi><mi>i</mi><mi>Morse</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">{\rm rank}({\rm ker}d_{i}^{\rm Floer})\geq{\rm rank}H_{i}(M;\Lambda)+\tau_{i}^{\rm Morse}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS7.p5.5" class="ltx_p"><span id="S4.SS7.p5.5.1" class="ltx_text">and</span></p>
<table id="S4.Ex91" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex91.m1" class="ltx_Math" alttext="{\rm rank}({\rm image}d_{i+1}^{\rm Floer})\geq\tau_{i}^{\rm Morse}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>rank</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>image</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mi>Floer</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><msubsup><mi>τ</mi><mi>i</mi><mi>Morse</mi></msubsup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\rm rank}({\rm image}d_{i+1}^{\rm Floer})\geq\tau_{i}^{\rm Morse}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS7.p5.6" class="ltx_p"><span id="S4.SS7.p5.6.1" class="ltx_text">Therefore, let <math id="S4.SS7.p5.m10" class="ltx_Math" alttext="\#{\rm Per}H" display="inline" intent=":literal"><semantics><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>Per</mi><mo lspace="0em" rspace="0em">​</mo><mi>H</mi></mrow><annotation encoding="application/x-tex">\#{\rm Per}H</annotation></semantics></math> be the number of <math id="S4.SS7.p5.m11" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>-periodic orbits of <math id="S4.SS7.p5.m12" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>, we have</span></p>
<table id="S4.SS7.p5.7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.SS7.p5.m13" class="ltx_Math" alttext="\#{\rm Per}H={\rm rank}CF_{*}(H;\Lambda)=\sum_{i\in{\mathbb{Z}}/{2N}}{\rm rank}CF_{i}(H;\Lambda)\\
=\sum_{i\in{\mathbb{Z}}/{2N}}\big({\rm rank}({\rm ker}d_{i}^{\rm Floer})+{\rm rank}({\rm image}d_{i}^{\rm Floer})\big)\\
\geq\sum_{i\in{\mathbb{Z}}/{2N}}{\rm rank}H_{i}(M;\Lambda)+2\sum_{i\in{\mathbb{Z}}/{2N}}\tau_{i}^{\rm Morse}\\
=\text{rank}H_{*}(M;{\mathbb{Q}})+2\sum_{i\in{\mathbb{Z}}/2N}\tau_{i}^{(2N)}(M)." display="block" intent=":literal"><semantics><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>Per</mi><mo lspace="0em" rspace="0em">​</mo><mi>H</mi></mrow><mo>=</mo><mrow><mi>rank</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mrow><mi>ℤ</mi><mo>/</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow></munder><mrow><mi>rank</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo>,</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mphantom></mphantom><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mrow><mi>ℤ</mi><mo>/</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow></munder><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mi>rank</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ker</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mi>i</mi><mi>Floer</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>rank</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>image</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>d</mi><mi>i</mi><mi>Floer</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mphantom></mphantom><mo rspace="0.111em">≥</mo><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mrow><mi>ℤ</mi><mo>/</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow></munder><mrow><mi>rank</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo mathsize="0.700em">,</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mrow><mi>ℤ</mi><mo>/</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow></munder><msubsup><mi>τ</mi><mi>i</mi><mi>Morse</mi></msubsup></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mtext>rank</mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mrow><mi>ℤ</mi><mo>/</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow></munder><mrow><msubsup><mi>τ</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\#{\rm Per}H={\rm rank}CF_{*}(H;\Lambda)=\sum_{i\in{\mathbb{Z}}/{2N}}{\rm rank}CF_{i}(H;\Lambda)\\
=\sum_{i\in{\mathbb{Z}}/{2N}}\big({\rm rank}({\rm ker}d_{i}^{\rm Floer})+{\rm rank}({\rm image}d_{i}^{\rm Floer})\big)\\
\geq\sum_{i\in{\mathbb{Z}}/{2N}}{\rm rank}H_{i}(M;\Lambda)+2\sum_{i\in{\mathbb{Z}}/{2N}}\tau_{i}^{\rm Morse}\\
=\text{rank}H_{*}(M;{\mathbb{Q}})+2\sum_{i\in{\mathbb{Z}}/2N}\tau_{i}^{(2N)}(M).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.SS7.p6" class="ltx_para">
<p id="S4.SS7.p6.1" class="ltx_p"><span id="S4.SS7.p6.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
</section>
<section id="S5" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">5. </span>Global Kuranishi charts on Floer moduli spaces</h2>

<div id="S5.p1" class="ltx_para">
<p id="S5.p1.1" class="ltx_p">In this section we provide the details for the global Kuranishi chart construction of moduli spaces of Floer trajectories. The construction is primarily inspired by the construction by Abouzaid–McLean–Smith <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx3" title="" class="ltx_ref">AMS21</a>]</cite> of the global chart on a single moduli space of genus zero stable maps. The main effort, however, is to generalize their construction to the case of the Hamiltonian Floer flow categories, where global charts must be constructed consistently for infinitely many moduli spaces. Certain care must be taken in order to have the expected properties. This and the next section serve as the construction of a derived orbifold lift of the Hamiltonian Floer flow category: this section deals with the topological construction while Section <a href="#S6" title="6. Smoothing ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> deals with the smoothing.</p>
</div>
<section id="S5.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.1. </span>Basic notions and the main theorem about global charts</h3>

<div id="S5.SS1.p1" class="ltx_para">
<p id="S5.SS1.p1.1" class="ltx_p">To state the main theorem of this section, we introduce an alternative version of charts. Because our construction of FOP perturbations is carried over orbifolds instead of smooth manifolds with an almost-free action of a compact Lie group, we refrain to give a general treatment of “global charts” beyond the concrete geometric setting in this paper.</p>
</div>
<section id="S5.SS1.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">5.1.1. </span>Kuranishi charts</h4>

<div id="S5.SS1.SSS1.p1" class="ltx_para">
<p id="S5.SS1.SSS1.p1.1" class="ltx_p">We slightly generalize the usual notion of Kuranishi charts.</p>
</div>
<div id="S5.Thmthm1" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm1.2" class="ltx_text ltx_font_bold">Definition 5.1</span></span><span id="S5.Thmthm1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm1.p1" class="ltx_para">
<p id="S5.Thmthm1.p1.1" class="ltx_p">Let <math id="S5.Thmthm1.p1.m1" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math> be a countable homogeneous poset and <math id="S5.Thmthm1.p1.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> be an <math id="S5.Thmthm1.p1.m3" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-space.</p>
</div>
<div id="S5.Thmthm1.p2" class="ltx_para">
<ol id="S5.I1" class="ltx_enumerate">
<li id="S5.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S5.I1.i1.p1" class="ltx_para">
<p id="S5.I1.i1.p1.1" class="ltx_p">An <math id="S5.I1.i1.p1.m1" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-stratified <span id="S5.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">(topological) Kuranishi chart</span> (K-chart for short) on <math id="S5.I1.i1.p1.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is a quintuple <math id="S5.I1.i1.p1.m3" class="ltx_Math" alttext="(G,V,E,S,\psi)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo>,</mo><mi>S</mi><mo>,</mo><mi>ψ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(G,V,E,S,\psi)</annotation></semantics></math> where <math id="S5.I1.i1.p1.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> is a compact Lie group, <math id="S5.I1.i1.p1.m5" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> is an <math id="S5.I1.i1.p1.m6" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-manifold with a continuous <math id="S5.I1.i1.p1.m7" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-action, <math id="S5.I1.i1.p1.m8" class="ltx_Math" alttext="E\to V" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo stretchy="false">→</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">E\to V</annotation></semantics></math> is a <math id="S5.I1.i1.p1.m9" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant vector bundle, <math id="S5.I1.i1.p1.m10" class="ltx_Math" alttext="S:V\to E" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>V</mi><mo stretchy="false">→</mo><mi>E</mi></mrow></mrow><annotation encoding="application/x-tex">S:V\to E</annotation></semantics></math> is a <math id="S5.I1.i1.p1.m11" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant section, and <math id="S5.I1.i1.p1.m12" class="ltx_Math" alttext="\psi:S^{-1}(0)/G\to X" display="inline" intent=":literal"><semantics><mrow><mi>ψ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><msup><mi>S</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>G</mi></mrow><mo stretchy="false">→</mo><mi>X</mi></mrow></mrow><annotation encoding="application/x-tex">\psi:S^{-1}(0)/G\to X</annotation></semantics></math> is a homeomorphism. We require the following condition: the stabilizer of each point <math id="S5.I1.i1.p1.m13" class="ltx_Math" alttext="x\in V" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">x\in V</annotation></semantics></math> is finite, i.e., the <math id="S5.I1.i1.p1.m14" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-action on <math id="S5.I1.i1.p1.m15" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> is almost free.</p>
</div></li>
<li id="S5.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S5.I1.i2.p1" class="ltx_para">
<p id="S5.I1.i2.p1.1" class="ltx_p">A K-chart <math id="S5.I1.i2.p1.m1" class="ltx_Math" alttext="(G,V,E,S,\psi)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo>,</mo><mi>S</mi><mo>,</mo><mi>ψ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(G,V,E,S,\psi)</annotation></semantics></math> is said to be <span id="S5.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">smooth</span> if <math id="S5.I1.i2.p1.m2" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> is a smooth <math id="S5.I1.i2.p1.m3" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-manifold, the <math id="S5.I1.i2.p1.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-action is smooth, and <math id="S5.I1.i2.p1.m5" class="ltx_Math" alttext="E\to V" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo stretchy="false">→</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">E\to V</annotation></semantics></math> is a smooth equivariant vector bundle (we do not impose any smoothness condition on <math id="S5.I1.i2.p1.m6" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>).</p>
</div></li>
</ol>
<p id="S5.Thmthm1.p2.1" class="ltx_p">We often omit the map <math id="S5.Thmthm1.p2.m1" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math> in the notation because in the context its meaning will always be clear.</p>
</div>
</div>
<div id="S5.Thmthm2" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm2.2" class="ltx_text ltx_font_italic">Remark 5.2</span></span><span id="S5.Thmthm2.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S5.Thmthm2.p1" class="ltx_para">
<p id="S5.Thmthm2.p1.1" class="ltx_p">Historically, there are different notions of Kuranishi charts which could be defined either via orbifolds or via equivariant objects. In this paper, the orbifold version will be labelled as “derived” and the name “Kuranishi” is reserved for the equivariant version while allowing actions by general compact Lie groups. We also use the prefixes “D-” and “K-” to denote these two versions.</p>
</div>
</div>
<div id="S5.Thmthm3" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm3.2" class="ltx_text ltx_font_bold">Definition 5.3</span></span><span id="S5.Thmthm3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm3.p1" class="ltx_para">
<p id="S5.Thmthm3.p1.1" class="ltx_p">Let <math id="S5.Thmthm3.p1.m1" class="ltx_Math" alttext="K=(G,V,E,S)" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo>,</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K=(G,V,E,S)</annotation></semantics></math> be a K-chart and <math id="S5.Thmthm3.p1.m2" class="ltx_Math" alttext="\pi_{F}:F\to V" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>F</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>F</mi><mo stretchy="false">→</mo><mi>V</mi></mrow></mrow><annotation encoding="application/x-tex">\pi_{F}:F\to V</annotation></semantics></math> be a <math id="S5.Thmthm3.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-equivariant vector bundle. The <span id="S5.Thmthm3.p1.1.1" class="ltx_text ltx_font_bold">stabilization</span> of <math id="S5.Thmthm3.p1.m4" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> by <math id="S5.Thmthm3.p1.m5" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>, denoted by <math id="S5.Thmthm3.p1.m6" class="ltx_Math" alttext="{\rm Stab}_{F}(K)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Stab</mi><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\rm Stab}_{F}(K)</annotation></semantics></math>, is the K-chart</p>
<table id="S5.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex1.m1" class="ltx_Math" alttext="{\rm Stab}_{F}(K)=(G,F,\pi_{F}^{*}E\oplus\pi_{F}^{*}F,\pi_{F}^{*}S\oplus\tau_{F})" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>Stab</mi><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>F</mi><mo>,</mo><mrow><mrow><msubsup><mi>π</mi><mi>F</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow><mo>⊕</mo><mrow><msubsup><mi>π</mi><mi>F</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></mrow><mo>,</mo><mrow><mrow><msubsup><mi>π</mi><mi>F</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>⊕</mo><msub><mi>τ</mi><mi>F</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\rm Stab}_{F}(K)=(G,F,\pi_{F}^{*}E\oplus\pi_{F}^{*}F,\pi_{F}^{*}S\oplus\tau_{F})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmthm3.p1.2" class="ltx_p">where <math id="S5.Thmthm3.p1.m7" class="ltx_Math" alttext="\tau_{F}:F\to\pi_{F}^{*}F" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mi>F</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>F</mi><mo stretchy="false">→</mo><mrow><msubsup><mi>π</mi><mi>F</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau_{F}:F\to\pi_{F}^{*}F</annotation></semantics></math> is the tautological section.</p>
</div>
</div>
</section>
<section id="S5.SS1.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">5.1.2. </span>Change of groups</h4>

<div id="S5.SS1.SSS2.p1" class="ltx_para">
<p id="S5.SS1.SSS2.p1.1" class="ltx_p">For K-charts, the notions of open embedding, germ equivalence, and product are almost identical to the case of derived orbifold charts after imposing the equivariance condition with respect to the Lie group action. There are some care to be taken of when the groups of symmetry change. To this end, we introduce the operation of enlarging the symmetry group.</p>
</div>
<div id="S5.Thmthm4" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm4.2" class="ltx_text ltx_font_bold">Definition 5.4</span></span><span id="S5.Thmthm4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm4.p1" class="ltx_para">
<p id="S5.Thmthm4.p1.1" class="ltx_p">Let <math id="S5.Thmthm4.p1.m1" class="ltx_Math" alttext="K=(G,V,E,S)" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo>,</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K=(G,V,E,S)</annotation></semantics></math> be a K-chart and let <math id="S5.Thmthm4.p1.m2" class="ltx_Math" alttext="G\hookrightarrow G^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo stretchy="false">↪</mo><msup><mi>G</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">G\hookrightarrow G^{\prime}</annotation></semantics></math> be a Lie group embedding. Define the <span id="S5.Thmthm4.p1.1.1" class="ltx_text ltx_font_bold">change of group</span>, or the <math id="S5.Thmthm4.p1.m3" class="ltx_Math" alttext="G^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>G</mi><mo>′</mo></msup><annotation encoding="application/x-tex">G^{\prime}</annotation></semantics></math><span id="S5.Thmthm4.p1.1.2" class="ltx_text ltx_font_bold">-equivariantization</span>, of <math id="S5.Thmthm4.p1.m4" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>, to be</p>
<table id="S5.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex2.m1" class="ltx_Math" alttext="G^{\prime}\times_{G}K:=(G^{\prime},G^{\prime}\times_{G}V,G^{\prime}\times_{G}E,S^{\prime})" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>G</mi><mo>′</mo></msup><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>G</mi></msub><mi>K</mi></mrow><mo>:=</mo><mrow><mo stretchy="false">(</mo><msup><mi>G</mi><mo>′</mo></msup><mo>,</mo><mrow><msup><mi>G</mi><mo>′</mo></msup><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>G</mi></msub><mi>V</mi></mrow><mo>,</mo><mrow><msup><mi>G</mi><mo>′</mo></msup><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>G</mi></msub><mi>E</mi></mrow><mo>,</mo><msup><mi>S</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G^{\prime}\times_{G}K:=(G^{\prime},G^{\prime}\times_{G}V,G^{\prime}\times_{G}E,S^{\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmthm4.p1.2" class="ltx_p">where <math id="S5.Thmthm4.p1.m5" class="ltx_Math" alttext="G^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>G</mi><mo>′</mo></msup><annotation encoding="application/x-tex">G^{\prime}</annotation></semantics></math> acts on the bundle <math id="S5.Thmthm4.p1.m6" class="ltx_Math" alttext="G^{\prime}\times_{G}E\to G^{\prime}\times_{G}V" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>G</mi><mo>′</mo></msup><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>G</mi></msub><mi>E</mi></mrow><mo stretchy="false">→</mo><mrow><msup><mi>G</mi><mo>′</mo></msup><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>G</mi></msub><mi>V</mi></mrow></mrow><annotation encoding="application/x-tex">G^{\prime}\times_{G}E\to G^{\prime}\times_{G}V</annotation></semantics></math> in the obvious way and</p>
<table id="S5.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex3.m1" class="ltx_Math" alttext="S^{\prime}([g^{\prime},x])=[g^{\prime},S(x)]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>S</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>g</mi><mo>′</mo></msup><mo>,</mo><mi>x</mi></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>g</mi><mo>′</mo></msup><mo>,</mo><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">S^{\prime}([g^{\prime},x])=[g^{\prime},S(x)].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmthm4.p1.3" class="ltx_p">In the rest of the paper, we also use the notations</p>
<table id="S5.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex4.m1" class="ltx_Math" alttext="G^{\prime}(K):=G^{\prime}\times_{G}K:=(G^{\prime},G^{\prime}(V),G^{\prime}(E),G^{\prime}(S)):=(G^{\prime},G^{\prime}\times_{G}V,G^{\prime}\times_{G}E,S^{\prime})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>G</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><msup><mi>G</mi><mo>′</mo></msup><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>G</mi></msub><mi>K</mi></mrow><mo>:=</mo><mrow><mo stretchy="false">(</mo><msup><mi>G</mi><mo>′</mo></msup><mo>,</mo><mrow><msup><mi>G</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>G</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>G</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>:=</mo><mrow><mo stretchy="false">(</mo><msup><mi>G</mi><mo>′</mo></msup><mo>,</mo><mrow><msup><mi>G</mi><mo>′</mo></msup><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>G</mi></msub><mi>V</mi></mrow><mo>,</mo><mrow><msup><mi>G</mi><mo>′</mo></msup><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>G</mi></msub><mi>E</mi></mrow><mo>,</mo><msup><mi>S</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">G^{\prime}(K):=G^{\prime}\times_{G}K:=(G^{\prime},G^{\prime}(V),G^{\prime}(E),G^{\prime}(S)):=(G^{\prime},G^{\prime}\times_{G}V,G^{\prime}\times_{G}E,S^{\prime}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S5.Thmthm5" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm5.2" class="ltx_text ltx_font_bold">Lemma 5.5</span></span><span id="S5.Thmthm5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm5.p1" class="ltx_para">
<p id="S5.Thmthm5.p1.1" class="ltx_p"><span id="S5.Thmthm5.p1.1.1" class="ltx_text ltx_font_italic">Suppose <math id="S5.Thmthm5.p1.m1" class="ltx_Math" alttext="G\hookrightarrow G^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo stretchy="false">↪</mo><msup><mi>G</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">G\hookrightarrow G^{\prime}</annotation></semantics></math> is a Lie group embedding and let <math id="S5.Thmthm5.p1.m2" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> be a <math id="S5.Thmthm5.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-space. If <math id="S5.Thmthm5.p1.m4" class="ltx_Math" alttext="{\bm{W}}" display="inline" intent=":literal"><semantics><mi>𝐖</mi><annotation encoding="application/x-tex">{\bm{W}}</annotation></semantics></math> is a <math id="S5.Thmthm5.p1.m5" class="ltx_Math" alttext="G^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>G</mi><mo>′</mo></msup><annotation encoding="application/x-tex">G^{\prime}</annotation></semantics></math>-representation and <math id="S5.Thmthm5.p1.m6" class="ltx_Math" alttext="E\to V" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo stretchy="false">→</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">E\to V</annotation></semantics></math> is the trivial <math id="S5.Thmthm5.p1.m7" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-bundle <math id="S5.Thmthm5.p1.m8" class="ltx_Math" alttext="V\times{\bm{W}}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝐖</mi></mrow><annotation encoding="application/x-tex">V\times{\bm{W}}</annotation></semantics></math> where we view <math id="S5.Thmthm5.p1.m9" class="ltx_Math" alttext="{\bm{W}}" display="inline" intent=":literal"><semantics><mi>𝐖</mi><annotation encoding="application/x-tex">{\bm{W}}</annotation></semantics></math> as a <math id="S5.Thmthm5.p1.m10" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>-representation, then <math id="S5.Thmthm5.p1.m11" class="ltx_Math" alttext="G^{\prime}(E)" display="inline" intent=":literal"><semantics><mrow><msup><mi>G</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G^{\prime}(E)</annotation></semantics></math> is isomorphic to the trivial <math id="S5.Thmthm5.p1.m12" class="ltx_Math" alttext="G^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>G</mi><mo>′</mo></msup><annotation encoding="application/x-tex">G^{\prime}</annotation></semantics></math>-bundle over <math id="S5.Thmthm5.p1.m13" class="ltx_Math" alttext="G^{\prime}(V)=G^{\prime}\times_{G}V" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>G</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>G</mi><mo>′</mo></msup><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>G</mi></msub><mi>V</mi></mrow></mrow><annotation encoding="application/x-tex">G^{\prime}(V)=G^{\prime}\times_{G}V</annotation></semantics></math> with fiber <math id="S5.Thmthm5.p1.m14" class="ltx_Math" alttext="{\bm{W}}" display="inline" intent=":literal"><semantics><mi>𝐖</mi><annotation encoding="application/x-tex">{\bm{W}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S5.SS1.SSS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.SS1.SSS2.p2" class="ltx_para">
<p id="S5.SS1.SSS2.p2.1" class="ltx_p"><span id="S5.SS1.SSS2.p2.1.1" class="ltx_text">Define the map <math id="S5.SS1.SSS2.p2.m1" class="ltx_Math" alttext="\zeta:G^{\prime}(E)=G^{\prime}\times_{G}(V\times{\bm{W}})\to(G^{\prime}\times_{G}V)\times{\bm{W}}" display="inline" intent=":literal"><semantics><mrow><mi>ζ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>G</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>G</mi><mo>′</mo></msup><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>G</mi></msub><mrow><mo stretchy="false">(</mo><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝑾</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>G</mi><mo>′</mo></msup><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>G</mi></msub><mi>V</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi>𝑾</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\zeta:G^{\prime}(E)=G^{\prime}\times_{G}(V\times{\bm{W}})\to(G^{\prime}\times_{G}V)\times{\bm{W}}</annotation></semantics></math> by</span></p>
<table id="S5.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex5.m1" class="ltx_Math" alttext="\zeta([g^{\prime},(v,w)])=([g^{\prime},v],g^{\prime}w)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ζ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>g</mi><mo>′</mo></msup><mo>,</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><msup><mi>g</mi><mo>′</mo></msup><mo>,</mo><mi>v</mi><mo stretchy="false">]</mo></mrow><mo>,</mo><mrow><msup><mi>g</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\zeta([g^{\prime},(v,w)])=([g^{\prime},v],g^{\prime}w).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS1.SSS2.p2.2" class="ltx_p"><span id="S5.SS1.SSS2.p2.2.1" class="ltx_text">Notice that</span></p>
<table id="S5.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex6.m1" class="ltx_Math" alttext="\zeta([g^{\prime}g,(v,w)])=([g^{\prime}g,v],g^{\prime}gw)=([g^{\prime},gv],g^{\prime}(gw))=\zeta([g^{\prime},(gv,gw)])=\zeta([g^{\prime},g(v,w)])." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ζ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msup><mi>g</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>g</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo>,</mo><mi>v</mi><mo stretchy="false">]</mo></mrow><mo>,</mo><mrow><msup><mi>g</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><msup><mi>g</mi><mo>′</mo></msup><mo>,</mo><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo stretchy="false">]</mo></mrow><mo>,</mo><mrow><msup><mi>g</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mi>ζ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><msup><mi>g</mi><mo>′</mo></msup><mo>,</mo><mrow><mo stretchy="false">(</mo><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>,</mo><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>ζ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><msup><mi>g</mi><mo>′</mo></msup><mo>,</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\zeta([g^{\prime}g,(v,w)])=([g^{\prime}g,v],g^{\prime}gw)=([g^{\prime},gv],g^{\prime}(gw))=\zeta([g^{\prime},(gv,gw)])=\zeta([g^{\prime},g(v,w)]).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS1.SSS2.p2.3" class="ltx_p"><span id="S5.SS1.SSS2.p2.3.1" class="ltx_text">Hence <math id="S5.SS1.SSS2.p2.m2" class="ltx_Math" alttext="\zeta" display="inline" intent=":literal"><semantics><mi>ζ</mi><annotation encoding="application/x-tex">\zeta</annotation></semantics></math> is well-defined. It is also straightforward to check that <math id="S5.SS1.SSS2.p2.m3" class="ltx_Math" alttext="\zeta" display="inline" intent=":literal"><semantics><mi>ζ</mi><annotation encoding="application/x-tex">\zeta</annotation></semantics></math> is a map of <math id="S5.SS1.SSS2.p2.m4" class="ltx_Math" alttext="G^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>G</mi><mo>′</mo></msup><annotation encoding="application/x-tex">G^{\prime}</annotation></semantics></math>-equivariant vector bundles over <math id="S5.SS1.SSS2.p2.m5" class="ltx_Math" alttext="G^{\prime}\times_{G}V" display="inline" intent=":literal"><semantics><mrow><msup><mi>G</mi><mo>′</mo></msup><msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>G</mi></msub><mi>V</mi></mrow><annotation encoding="application/x-tex">G^{\prime}\times_{G}V</annotation></semantics></math> and is an isomorphism.
∎</span></p>
</div>
</div>
</section>
<section id="S5.SS1.SSS3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">5.1.3. </span>Chart embeddings</h4>

<div id="S5.SS1.SSS3.p1" class="ltx_para">
<p id="S5.SS1.SSS3.p1.1" class="ltx_p">Because of the presence of compact Lie group, the definition of chart embeddings of K-charts also differs slightly from the notion of chart embeddings of derived orbifold charts.</p>
</div>
<div id="S5.Thmthm6" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm6.2" class="ltx_text ltx_font_bold">Definition 5.6</span></span><span id="S5.Thmthm6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmthm6.p1" class="ltx_para">
<p id="S5.Thmthm6.p1.1" class="ltx_p">Let <math id="S5.Thmthm6.p1.m1" class="ltx_Math" alttext="K_{1}=(G_{1},V_{1},E_{1},S_{1},\psi_{1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>K</mi><mn>1</mn></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mn>1</mn></msub><mo>,</mo><msub><mi>V</mi><mn>1</mn></msub><mo>,</mo><msub><mi>E</mi><mn>1</mn></msub><mo>,</mo><msub><mi>S</mi><mn>1</mn></msub><mo>,</mo><msub><mi>ψ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K_{1}=(G_{1},V_{1},E_{1},S_{1},\psi_{1})</annotation></semantics></math> and <math id="S5.Thmthm6.p1.m2" class="ltx_Math" alttext="K_{2}=(G_{2},V_{2},E_{2},S_{2},\psi_{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>K</mi><mn>2</mn></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mn>2</mn></msub><mo>,</mo><msub><mi>V</mi><mn>2</mn></msub><mo>,</mo><msub><mi>E</mi><mn>2</mn></msub><mo>,</mo><msub><mi>S</mi><mn>2</mn></msub><mo>,</mo><msub><mi>ψ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K_{2}=(G_{2},V_{2},E_{2},S_{2},\psi_{2})</annotation></semantics></math> be two topological K-charts.</p>
<ol id="S5.I2" class="ltx_enumerate">
<li id="S5.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S5.I2.i1.p1" class="ltx_para">
<p id="S5.I2.i1.p1.1" class="ltx_p">A <span id="S5.I2.i1.p1.1.1" class="ltx_text ltx_font_bold">weak K-chart embedding</span> from <math id="S5.I2.i1.p1.m1" class="ltx_Math" alttext="K_{1}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mn>1</mn></msub><annotation encoding="application/x-tex">K_{1}</annotation></semantics></math> to <math id="S5.I2.i1.p1.m2" class="ltx_Math" alttext="K_{2}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mn>2</mn></msub><annotation encoding="application/x-tex">K_{2}</annotation></semantics></math>, denoted by</p>
<table id="S5.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex7.m1" class="ltx_Math" alttext="{\bm{\iota}}_{21}:K_{1}\rightharpoonup K_{2}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝜾</mi><mn>21</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>K</mi><mn>1</mn></msub><mo stretchy="false">⇀</mo><msub><mi>K</mi><mn>2</mn></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\bm{\iota}}_{21}:K_{1}\rightharpoonup K_{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I2.i1.p1.2" class="ltx_p">consists of a group embedding <math id="S5.I2.i1.p1.m3" class="ltx_Math" alttext="G_{1}\hookrightarrow G_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mn>1</mn></msub><mo stretchy="false">↪</mo><msub><mi>G</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">G_{1}\hookrightarrow G_{2}</annotation></semantics></math>,<span id="footnote10" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">10</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">10</sup>
                        <span class="ltx_tag ltx_tag_note">10</span>
                        
                        
                        
                      In the concrete situations of this paper, the group embeddings are always fixed by the geometric data, and the embeddings are induced from inclusions</span></span></span> an equivairant topological embedding <math id="S5.I2.i1.p1.m4" class="ltx_Math" alttext="\iota_{21}:G_{2}(V_{1})\hookrightarrow V_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ι</mi><mn>21</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>G</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>V</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">↪</mo><msub><mi>V</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\iota_{21}:G_{2}(V_{1})\hookrightarrow V_{2}</annotation></semantics></math> which has a <math id="S5.I2.i1.p1.m5" class="ltx_Math" alttext="G_{2}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mn>2</mn></msub><annotation encoding="application/x-tex">G_{2}</annotation></semantics></math>-invariant neighborhood equivariantly homeomorphic to a <math id="S5.I2.i1.p1.m6" class="ltx_Math" alttext="G_{2}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mn>2</mn></msub><annotation encoding="application/x-tex">G_{2}</annotation></semantics></math>-equivariant vector bundle<span id="footnote11" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">11</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">11</sup>
                        <span class="ltx_tag ltx_tag_note">11</span>
                        
                        
                        
                      This seemingly redundant requirement is necessary because in the topological category submanifolds do not necessarily have vector bundle neighborhoods.</span></span></span>, and an equivariant vector bundle embedding <math id="S5.I2.i1.p1.m7" class="ltx_Math" alttext="\widehat{\iota}_{21}:G_{2}(E_{1})\hookrightarrow E_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ι</mi><mo>^</mo></mover><mn>21</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>G</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">↪</mo><msub><mi>E</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\widehat{\iota}_{21}:G_{2}(E_{1})\hookrightarrow E_{2}</annotation></semantics></math> covering <math id="S5.I2.i1.p1.m8" class="ltx_Math" alttext="\iota_{21}" display="inline" intent=":literal"><semantics><msub><mi>ι</mi><mn>21</mn></msub><annotation encoding="application/x-tex">\iota_{21}</annotation></semantics></math>. (Due to a small defect of the global chart construction we will use, a weak K-chart embedding does not necessarily intertwine with the Kuranishi sections. This explains the adjective “weak” in the terminology.)</p>
</div></li>
<li id="S5.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S5.I2.i2.p1" class="ltx_para">
<p id="S5.I2.i2.p1.1" class="ltx_p">A weak K-chart embedding is called a <span id="S5.I2.i2.p1.1.1" class="ltx_text ltx_font_bold">K-chart embedding</span> if the following diagrams commute.</p>
<table id="S5.EGx9" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.EGx9.1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.EGx9.m1" class="ltx_Math" alttext="\displaystyle\ \vbox{\lx@xy@svg{\hbox{\raise 0.0pt\hbox{\kern 31.57475pt\hbox{\ignorespaces\ignorespaces\ignorespaces\hbox{\vtop{\halign{\entry@#!@&amp;&amp;\entry@@#!@\cr&amp;\cr&amp;\crcr}}}\ignorespaces{\hbox{\kern-19.28543pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{G_{2}(E_{1})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 16.87183pt\raise 7.36111pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-2.86111pt\hbox{$\scriptstyle{\widehat{\iota}_{21}}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 43.38268pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 43.38268pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{E_{2}}$}}}}}}}{\hbox{\kern-19.33405pt\raise-32.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{G_{2}(V_{1})\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 18.16986pt\raise-37.00694pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-1.00694pt\hbox{$\scriptstyle{\iota_{21}}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 43.33405pt\raise-32.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern-31.57475pt\raise-16.0pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-1.75pt\hbox{$\scriptstyle{G_{2}(S_{1})}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 0.0pt\raise-8.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 43.33405pt\raise-32.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{V_{2}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 52.60489pt\raise-16.0pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-1.89168pt\hbox{$\scriptstyle{S_{2}}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 52.60489pt\raise-7.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}\ignorespaces}}}}}," display="inline" intent=":literal"><semantics><mrow><mtext> <svg style="vertical-align:-58.1346139449936px" height="78.51" overflow="visible" version="1.1" viewBox="43.69 58.13 137.51 78.51" width="137.51"> <g transform="matrix(1 0 0 -1 43.68998589679976 78.50576242141017) translate(43.69,0)"> <g transform="translate(-26.69,0) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:3.26em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="45.07"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mrow><msub><mi>G</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></span></span></foreignObject> </g> <path style="--ltx-stroke-color:#000000;" d="M 26.685251014533176 -0.27673578005007266 L 26.685251014533176 0.27673578005007266" fill="none" stroke="#000000"></path> <g transform="translate(23.35,0) translate(0,10.19) translate(4.15,0) translate(0,-3.96)"> <foreignObject style="--ltx-fo-width:1.29em;--ltx-fo-height:0.72em;--ltx-fo-depth:0.15em;font-size:10pt;" height="12.07" overflow="visible" transform="matrix(1 0 0 -1 0 9.99)" width="17.8"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><msub><mover accent="true"><mi mathsize="0.700em">ι</mi><mo>^</mo></mover><mn mathsize="0.710em">21</mn></msub></span></span></foreignObject> </g> <g transform="translate(60.03,0)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M 26.685251014533176 -0.27673578005007266 L 60.02860823425825 0.27673578005007266" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 60.02860823425825 -0.27673578005007266 L 60.02860823425825 0.27673578005007266" fill="none" stroke="#000000"></path> <g transform="translate(60.03,0) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:1.24em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="17.22"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><msub><mi>E</mi><mn>2</mn></msub></span></span></foreignObject> </g> <g transform="translate(-26.75,0) translate(0,-44.28) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:3.27em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="45.2"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mrow><msub><mi>G</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo