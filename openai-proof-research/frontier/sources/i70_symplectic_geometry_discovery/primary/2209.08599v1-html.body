 mathsize="0.710em">p</mi><mo>′</mo></msup></mrow><mo mathsize="0.710em">,</mo><mi mathsize="0.710em">α</mi></mrow><mi mathsize="0.710em">collar</mi></msubsup></span></span></foreignObject> </g> <g transform="translate(140.42,0)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M 65.22155820836792 -0.27673578005007266 L 140.4218197330756 0.27673578005007266" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 140.4218197330756 -0.27673578005007266 L 140.4218197330756 0.27673578005007266" fill="none" stroke="#000000"></path> <g transform="translate(140.42,0) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:1.83em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.37em;font-size:10pt;" height="16.78" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="25.26"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mi>M</mi></msubsup></span></span></foreignObject> </g> <path style="--ltx-stroke-color:#000000;" d="M 156.92599370335418 -12.746990114652519 L 157.47946526345433 -12.746990114652519" fill="none" stroke="#000000"></path> <g transform="translate(157.2,0) translate(0,-33.21)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M 156.92599370335418 -33.208800332088 L 157.47946526345433 -12.746990114652519" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 156.92599370335418 -33.208800332088 L 157.47946526345433 -33.208800332088" fill="none" stroke="#000000"></path> <g transform="translate(-53.17,0) translate(0,-45.54) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:7.09em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.37em;font-size:10pt;" height="16.78" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="98.04"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mrow><msup><mo>∂</mo><mi>α</mi></msup><msubsup><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mi>M</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow><msub><mi>𝔽</mi><mi>α</mi></msub></msup></mrow></span></span></foreignObject> </g> <path style="--ltx-stroke-color:#000000;" d="M 53.17133756632031 -45.817433113508805 L 53.17133756632031 -45.263961553408656" fill="none" stroke="#000000"></path> <g transform="translate(77.88,0) translate(0,-56.11) translate(4.15,0) translate(0,-2.56)"> <foreignObject style="--ltx-fo-width:2.1em;--ltx-fo-height:0.65em;--ltx-fo-depth:0.28em;font-size:10pt;" height="12.83" overflow="visible" transform="matrix(1 0 0 -1 0 8.98)" width="29.05"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><msubsup><mi mathsize="0.700em">θ</mi><mrow><mrow><mi mathsize="0.710em">p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.710em">p</mi><mo>′</mo></msup></mrow><mo mathsize="0.710em">,</mo><mi mathsize="0.710em">α</mi></mrow><mi mathsize="0.710em">collar</mi></msubsup></span></span></foreignObject> </g> <g transform="translate(139.94,0) translate(0,-45.54)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M 53.17133756632031 -45.817433113508805 L 139.94135895556593 -45.263961553408656" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 139.94135895556593 -45.817433113508805 L 139.94135895556593 -45.263961553408656" fill="none" stroke="#000000"></path> <g transform="translate(139.94,0) translate(0,-45.54) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:1.89em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.37em;font-size:10pt;" height="16.78" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="26.22"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><msubsup><mi class="ltx_font_mathcaligraphic">𝒰</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mi>M</mi></msubsup></span></span></foreignObject> </g> </g> </svg> </mtext><mspace style="width:1.167em;" width="1.167em"></mspace><mrow><mrow><mo rspace="0.167em">∀</mo><mi>p</mi></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow><mo rspace="0.667em">,</mo><mrow><msup><mi>p</mi><mo>′</mo></msup><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>′</mo></msup></mrow><mo rspace="0.667em">,</mo><mrow><mi>α</mi><mo>∈</mo><msub><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\vbox{\lx@xy@svg{\hbox{\raise 0.0pt\hbox{\kern 47.13562pt\hbox{\ignorespaces\ignorespaces\ignorespaces\hbox{\vtop{\halign{\entry@#!@&amp;&amp;\entry@@#!@\cr&amp;&amp;\cr&amp;&amp;\crcr}}}\ignorespaces{\hbox{\kern-47.13562pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{{\mathcal{E}}^{M}_{pp^{\prime}}|_{\partial^{\alpha}{\mathcal{U}}^{M}_{pp^{\prime}}}\times[0,\epsilon)^{{\mathbb{F}}_{\alpha}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 0.0pt\raise-24.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 59.94022pt\raise 7.84723pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-2.37502pt\hbox{$\scriptstyle{\widehat{\theta}_{pp^{\prime},\alpha}^{\rm collar}}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 101.48285pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 71.13562pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{}$}}}}}}}{\hbox{\kern 101.48285pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{{\mathcal{E}}_{pp^{\prime}}^{M}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 113.61041pt\raise-24.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern-38.42691pt\raise-32.91226pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\partial^{\alpha}{\mathcal{U}}_{pp^{\prime}}^{M}\times[0,\epsilon)^{{\mathbb{F}}_{\alpha}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 56.28552pt\raise-40.54893pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-1.85335pt\hbox{$\scriptstyle{\theta_{pp^{\prime},\alpha}^{\rm collar}}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 101.13562pt\raise-32.91226pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 71.13562pt\raise-32.91226pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{}$}}}}}}}{\hbox{\kern 101.13562pt\raise-32.91226pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{{\mathcal{U}}^{M}_{pp^{\prime}}}$}}}}}}}\ignorespaces}}}}}\ \ \forall p\in{\mathcal{P}},\ p^{\prime}\in{\mathcal{P}^{\prime}},\ \alpha\in{\mathbb{A}}_{pp^{\prime}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I17.i4.p1.2" class="ltx_p">which satisfy similar compatibility conditions as the case of flow categories using the factorizations of boundary strata. We omit the details.</p>
</div></li>
</ol>
</div>
</div>
<div id="S3.Thmthm27" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm27.2" class="ltx_text ltx_font_italic">Remark 3.27</span></span><span id="S3.Thmthm27.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S3.Thmthm27.p1" class="ltx_para">
<p id="S3.Thmthm27.p1.1" class="ltx_p">Although the description of collar structures seems to be very complicated, they are constructed using the outer-collaring method which implies the required conditions almost automatically.</p>
</div>
</div>
</section>
<section id="S3.SS5.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">3.5.2. </span>Scaffolding</h4>

<div id="S3.Thmthm28" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm28.2" class="ltx_text ltx_font_bold">Definition 3.28</span></span><span id="S3.Thmthm28.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm28.p1" class="ltx_para">
<p id="S3.Thmthm28.p1.1" class="ltx_p">A <span id="S3.Thmthm28.p1.1.1" class="ltx_text ltx_font_bold">scaffolding</span> of a system of D-chart presentations <math id="S3.Thmthm28.p1.m1" class="ltx_Math" alttext="((C_{\alpha})_{\alpha\in{\mathbb{A}}},({\bm{\iota}}_{\beta\alpha})_{\alpha\leq\beta})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>α</mi><mo>∈</mo><mi>𝔸</mi></mrow></msub><mo>,</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>𝜾</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">((C_{\alpha})_{\alpha\in{\mathbb{A}}},({\bm{\iota}}_{\beta\alpha})_{\alpha\leq\beta})</annotation></semantics></math> of an <math id="S3.Thmthm28.p1.m2" class="ltx_Math" alttext="{\mathbb{A}}" display="inline" intent=":literal"><semantics><mi>𝔸</mi><annotation encoding="application/x-tex">{\mathbb{A}}</annotation></semantics></math>-space <math id="S3.Thmthm28.p1.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is a collection of data</p>
<table id="S3.Ex84" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex84.m1" class="ltx_Math" alttext="\big({\mathcal{F}}_{\beta\alpha},{\bm{\theta}}_{\beta\alpha}\big)_{\alpha\leq\beta}" display="block" intent=":literal"><semantics><msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo>,</mo><msub><mi>𝜽</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow></msub><annotation encoding="application/x-tex">\big({\mathcal{F}}_{\beta\alpha},{\bm{\theta}}_{\beta\alpha}\big)_{\alpha\leq\beta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm28.p1.2" class="ltx_p">where for each pair <math id="S3.Thmthm28.p1.m4" class="ltx_Math" alttext="\alpha\leq\beta" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">\alpha\leq\beta</annotation></semantics></math></p>
<ol id="S3.I18" class="ltx_enumerate">
<li id="S3.I18.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S3.I18.i1.p1" class="ltx_para">
<p id="S3.I18.i1.p1.1" class="ltx_p">the <span id="S3.I18.i1.p1.1.1" class="ltx_text ltx_font_bold">difference bundle</span> <math id="S3.I18.i1.p1.m1" class="ltx_Math" alttext="{\mathcal{F}}_{\beta\alpha}\to{\mathcal{U}}_{\alpha}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>α</mi></msub></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{\beta\alpha}\to{\mathcal{U}}_{\alpha}</annotation></semantics></math> is an orbifold vector bundle <math id="S3.I18.i1.p1.m2" class="ltx_Math" alttext="{\mathcal{F}}_{\beta\alpha}\to{\mathcal{U}}_{\alpha}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo stretchy="false">→</mo><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>α</mi></msub></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{\beta\alpha}\to{\mathcal{U}}_{\alpha}</annotation></semantics></math>. In notation, when <math id="S3.I18.i1.p1.m3" class="ltx_Math" alttext="{\mathbb{A}}={\mathbb{A}}_{pq}^{\mathcal{P}}" display="inline" intent=":literal"><semantics><mrow><mi>𝔸</mi><mo>=</mo><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup></mrow><annotation encoding="application/x-tex">{\mathbb{A}}={\mathbb{A}}_{pq}^{\mathcal{P}}</annotation></semantics></math> resp. <math id="S3.I18.i1.p1.m4" class="ltx_Math" alttext="{\mathbb{A}}_{pp^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">{\mathbb{A}}_{pp^{\prime}}</annotation></semantics></math> and <math id="S3.I18.i1.p1.m5" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> is the maximal element <math id="S3.I18.i1.p1.m6" class="ltx_Math" alttext="pq" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">pq</annotation></semantics></math> resp. <math id="S3.I18.i1.p1.m7" class="ltx_Math" alttext="pp^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">pp^{\prime}</annotation></semantics></math>, denote <math id="S3.I18.i1.p1.m8" class="ltx_Math" alttext="{\mathcal{F}}_{\beta\alpha}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{F}}_{\beta\alpha}</annotation></semantics></math> by <math id="S3.I18.i1.p1.m9" class="ltx_Math" alttext="{\mathcal{F}}_{pq,\alpha}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>,</mo><mi>α</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{F}}_{pq,\alpha}</annotation></semantics></math> resp. <math id="S3.I18.i1.p1.m10" class="ltx_Math" alttext="{\mathcal{F}}_{pp^{\prime},\alpha}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mo>,</mo><mi>α</mi></mrow></msub><annotation encoding="application/x-tex">{\mathcal{F}}_{pp^{\prime},\alpha}</annotation></semantics></math>.</p>
</div></li>
<li id="S3.I18.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S3.I18.i2.p1" class="ltx_para">
<p id="S3.I18.i2.p1.1" class="ltx_p">the <span id="S3.I18.i2.p1.1.1" class="ltx_text ltx_font_bold">stabilization map</span> <math id="S3.I18.i2.p1.m1" class="ltx_Math" alttext="{\bm{\theta}}_{\beta\alpha}" display="inline" intent=":literal"><semantics><msub><mi>𝜽</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><annotation encoding="application/x-tex">{\bm{\theta}}_{\beta\alpha}</annotation></semantics></math> is a germ equivalence</p>
<table id="S3.E8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E8.m1" class="ltx_Math" alttext="{\bm{\theta}}_{\beta\alpha}=(\theta_{\beta\alpha},\widehat{\theta}_{\beta\alpha}):{\rm Stab}_{{\mathcal{F}}_{\beta\alpha}}(C_{\alpha})\simeq\partial^{\alpha}C_{\beta}" display="block" intent=":literal"><semantics><mrow><msub><mi>𝜽</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo>,</mo><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mrow><mrow><msub><mi>Stab</mi><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">≃</mo><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi>C</mi><mi>β</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{\theta}}_{\beta\alpha}=(\theta_{\beta\alpha},\widehat{\theta}_{\beta\alpha}):{\rm Stab}_{{\mathcal{F}}_{\beta\alpha}}(C_{\alpha})\simeq\partial^{\alpha}C_{\beta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.8)</span></td></tr></tbody>
</table>
<p id="S3.I18.i2.p1.2" class="ltx_p">which extends the chart embedding <math id="S3.I18.i2.p1.m2" class="ltx_Math" alttext="{\bm{\iota}}_{\beta\alpha}:C_{\alpha}\hookrightarrow\partial^{\alpha}C_{\beta}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝜾</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>C</mi><mi>α</mi></msub><mo rspace="0.111em" stretchy="false">↪</mo><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi>C</mi><mi>β</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bm{\iota}}_{\beta\alpha}:C_{\alpha}\hookrightarrow\partial^{\alpha}C_{\beta}</annotation></semantics></math>. This germ equivalence induces a projection map</p>
<table id="S3.Ex85" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex85.m1" class="ltx_Math" alttext="\pi_{\beta\alpha}:\partial^{\alpha}C_{\beta}\to C_{\alpha}" display="block" intent=":literal"><semantics><mrow><msub><mi>π</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo lspace="0.278em" rspace="0.111em">:</mo><mrow><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi>C</mi><mi>β</mi></msub></mrow><mo stretchy="false">→</mo><msub><mi>C</mi><mi>α</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\pi_{\beta\alpha}:\partial^{\alpha}C_{\beta}\to C_{\alpha}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I18.i2.p1.3" class="ltx_p">as well as a bundle splitting</p>
<table id="S3.E9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E9.m1" class="ltx_Math" alttext="{\mathcal{E}}_{\beta}|_{{\mathcal{U}}_{\alpha}}={\mathcal{E}}_{\alpha}\oplus{\mathcal{F}}_{\beta\alpha}" display="block" intent=":literal"><semantics><mrow><msub><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>β</mi></msub><mo stretchy="false">|</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>α</mi></msub></msub><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>α</mi></msub><mo>⊕</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{E}}_{\beta}|_{{\mathcal{U}}_{\alpha}}={\mathcal{E}}_{\alpha}\oplus{\mathcal{F}}_{\beta\alpha}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.9)</span></td></tr></tbody>
</table>
<p id="S3.I18.i2.p1.4" class="ltx_p">where <math id="S3.I18.i2.p1.m3" class="ltx_Math" alttext="{\mathcal{E}}_{\beta}|_{{\mathcal{U}}_{\alpha}}={\bm{\iota}}_{\beta\alpha}^{*}{\mathcal{E}}_{\beta}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>β</mi></msub><mo stretchy="false">|</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>α</mi></msub></msub><mo>=</mo><mrow><msubsup><mi>𝜾</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>β</mi></msub></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{E}}_{\beta}|_{{\mathcal{U}}_{\alpha}}={\bm{\iota}}_{\beta\alpha}^{*}{\mathcal{E}}_{\beta}</annotation></semantics></math> and a bundle isomorphism</p>
<table id="S3.E10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E10.m1" class="ltx_Math" alttext="\vartheta_{\beta\alpha}:\pi_{\beta\alpha}^{*}({\mathcal{E}}_{\beta}|_{{\mathcal{U}}_{\alpha}})\cong{\mathcal{E}}_{\beta}|_{\partial^{\alpha}{\mathcal{U}}_{\beta}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ϑ</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mi>π</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>β</mi></msub><mo stretchy="false">|</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>α</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><msub><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>β</mi></msub><mo stretchy="false">|</mo></mrow><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>β</mi></msub></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\vartheta_{\beta\alpha}:\pi_{\beta\alpha}^{*}({\mathcal{E}}_{\beta}|_{{\mathcal{U}}_{\alpha}})\cong{\mathcal{E}}_{\beta}|_{\partial^{\alpha}{\mathcal{U}}_{\beta}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.10)</span></td></tr></tbody>
</table>
</div></li>
</ol>
<p id="S3.Thmthm28.p1.3" class="ltx_p">These objects need to satisfy the following conditions.</p>
<ol id="S3.I19" class="ltx_enumerate">
<li id="S3.I19.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(A)</span> 
<div id="S3.I19.ix1.p1" class="ltx_para">
<p id="S3.I19.ix1.p1.1" class="ltx_p">For any triple of stratum <math id="S3.I19.ix1.p1.m1" class="ltx_Math" alttext="\alpha\leq\beta\leq\gamma" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>≤</mo><mi>β</mi><mo>≤</mo><mi>γ</mi></mrow><annotation encoding="application/x-tex">\alpha\leq\beta\leq\gamma</annotation></semantics></math>, as subbundles of <math id="S3.I19.ix1.p1.m2" class="ltx_Math" alttext="{\mathcal{E}}_{\gamma}|_{{\mathcal{U}}_{\alpha}}" display="inline" intent=":literal"><semantics><msub><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>γ</mi></msub><mo stretchy="false">|</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>α</mi></msub></msub><annotation encoding="application/x-tex">{\mathcal{E}}_{\gamma}|_{{\mathcal{U}}_{\alpha}}</annotation></semantics></math> there holds</p>
<table id="S3.E11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E11.m1" class="ltx_Math" alttext="{\mathcal{F}}_{\gamma\alpha}={\mathcal{F}}_{\beta\alpha}\oplus{\mathcal{F}}_{\gamma\beta}|_{{\mathcal{U}}_{\alpha}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub><mo>⊕</mo><msub><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow></msub><mo stretchy="false">|</mo></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi>α</mi></msub></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{\gamma\alpha}={\mathcal{F}}_{\beta\alpha}\oplus{\mathcal{F}}_{\gamma\beta}|_{{\mathcal{U}}_{\alpha}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.11)</span></td></tr></tbody>
</table>
</div></li>
<li id="S3.I19.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(B)</span> 
<div id="S3.I19.ix2.p1" class="ltx_para">
<p id="S3.I19.ix2.p1.1" class="ltx_p">The stabilization map preserves stratum. More precisely, the following diagram commutes</p>
<table id="S3.Ex86" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex86.m1" class="ltx_Math" alttext="\vbox{\lx@xy@svg{\hbox{\raise 0.0pt\hbox{\kern 31.00931pt\hbox{\ignorespaces\ignorespaces\ignorespaces\hbox{\vtop{\halign{\entry@#!@&amp;&amp;\entry@@#!@\cr&amp;\cr&amp;\crcr}}}\ignorespaces{\hbox{\kern-31.00931pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{{\rm Stab}_{{\mathcal{F}}_{\beta\alpha}}(C_{\alpha})\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 33.59492pt\raise 6.4472pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-1.4139pt\hbox{$\scriptstyle{{\bm{\theta}}_{\beta\alpha}}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 55.00931pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces{\hbox{\kern 0.0pt\raise-24.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 55.00931pt\raise 0.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\partial^{\alpha}C_{\beta}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 69.96165pt\raise-16.0pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-0.4903pt\hbox{$\scriptstyle{{\bm{\iota}}_{\gamma\beta}}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 69.96165pt\raise-24.55556pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern-30.89998pt\raise-32.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{{\rm Stab}_{{\mathcal{F}}_{\gamma\alpha}}(C_{\alpha})\ignorespaces\ignorespaces\ignorespaces\ignorespaces}$}}}}}}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces{}{\hbox{\lx@xy@droprule}}\ignorespaces\ignorespaces\ignorespaces{\hbox{\kern 33.73306pt\raise-38.41666pt\hbox{{}\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\hbox{\hbox{\kern 0.0pt\raise-1.44444pt\hbox{$\scriptstyle{{\bm{\theta}}_{\gamma\alpha}}$}}}\kern 3.0pt}}}}}}\ignorespaces{\hbox{\kern 55.17625pt\raise-32.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\lx@xy@tip{1}\lx@xy@tip{-1}}}}}}{\hbox{\lx@xy@droprule}}{\hbox{\lx@xy@droprule}}{\hbox{\kern 55.17625pt\raise-32.0pt\hbox{\hbox{\kern 0.0pt\raise 0.0pt\hbox{\hbox{\kern 3.0pt\raise-2.5pt\hbox{$\textstyle{\partial^{\alpha}C_{\gamma}}$}}}}}}}\ignorespaces}}}}}." display="block" intent=":literal"><semantics><mrow><mtext> <svg style="vertical-align:-62.035855802243326px" height="79.88" overflow="visible" version="1.1" viewBox="42.91 62.04 163.44 79.88" width="163.44"> <g transform="matrix(1 0 0 -1 42.907579716795524 79.87784996259685) translate(42.91,0)"> <g transform="translate(-42.91,0) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:5.6em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.35em;font-size:10pt;" height="15.27" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="77.51"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mrow><msub><mi>Stab</mi><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow></mrow></span></span></foreignObject> </g> <path style="--ltx-stroke-color:#000000;" d="M 42.907579716795524 -0.27673578005007266 L 42.907579716795524 0.27673578005007266" fill="none" stroke="#000000"></path> <g transform="translate(46.49,0) translate(0,8.92) translate(4.15,0) translate(0,-1.96)"> <foreignObject style="--ltx-fo-width:1.28em;--ltx-fo-height:0.49em;--ltx-fo-depth:0.2em;font-size:10pt;" height="9.54" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="17.75"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><msub><mi mathsize="0.700em">𝜽</mi><mrow><mi mathsize="0.710em">β</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">α</mi></mrow></msub></span></span></foreignObject> </g> <g transform="translate(76.12,0)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M 42.907579716795524 -0.27673578005007266 L 76.11638004888353 0.27673578005007266" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 76.11638004888353 -0.27673578005007266 L 76.11638004888353 0.27673578005007266" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -12.499391084161392 L 0.27673578005007266 -12.499391084161392" fill="none" stroke="#000000"></path> <g transform="translate(0,-33.21)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.208800332088 L 0.27673578005007266 -12.499391084161392" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M -0.27673578005007266 -33.208800332088 L 0.27673578005007266 -33.208800332088" fill="none" stroke="#000000"></path> <g transform="translate(76.12,0) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:2.39em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.29em;font-size:10pt;" height="13.57" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="33.08"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mrow><msup><mo>∂</mo><mi>α</mi></msup><msub><mi>C</mi><mi>β</mi></msub></mrow></span></span></foreignObject> </g> <path style="--ltx-stroke-color:#000000;" d="M 96.52920674532136 -11.569253138458645 L 97.08267830542151 -11.569253138458645" fill="none" stroke="#000000"></path> <g transform="translate(96.81,0) translate(0,-22.14) translate(4.15,0) translate(0,-0.68)"> <foreignObject style="--ltx-fo-width:1.11em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.2em;font-size:10pt;" height="6.98" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="15.42"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><msub><mi mathsize="0.700em">𝜾</mi><mrow><mi mathsize="0.710em">γ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">β</mi></mrow></msub></span></span></foreignObject> </g> <g transform="translate(96.81,0) translate(0,-33.98)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M 96.52920674532136 -33.97752490795152 L 97.08267830542151 -11.569253138458645" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 96.52920674532136 -33.97752490795152 L 97.08267830542151 -33.97752490795152" fill="none" stroke="#000000"></path> <g transform="translate(-42.76,0) translate(0,-44.28) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:5.58em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.35em;font-size:10pt;" height="15.18" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="77.21"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mrow><msub><mi>Stab</mi><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow></mrow></span></span></foreignObject> </g> <path style="--ltx-stroke-color:#000000;" d="M 42.75630086854201 -44.55513622283408 L 42.75630086854201 -44.00166466273393" fill="none" stroke="#000000"></path> <g transform="translate(46.68,0) translate(0,-53.16) translate(4.15,0) translate(0,-2)"> <foreignObject style="--ltx-fo-width:1.26em;--ltx-fo-height:0.49em;--ltx-fo-depth:0.2em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="17.45"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><msub><mi mathsize="0.700em">𝜽</mi><mrow><mi mathsize="0.710em">γ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">α</mi></mrow></msub></span></span></foreignObject> </g> <g transform="translate(76.35,0) translate(0,-44.28)"> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path> </g> <path style="--ltx-stroke-color:#000000;" d="M 42.75630086854201 -44.55513622283408 L 76.34738380027804 -44.00166466273393" fill="none" stroke="#000000"></path> <path style="--ltx-stroke-color:#000000;" d="M 76.34738380027804 -44.55513622283408 L 76.34738380027804 -44.00166466273393" fill="none" stroke="#000000"></path> <g transform="translate(76.35,0) translate(0,-44.28) translate(4.15,0) translate(0,-3.46)"> <foreignObject style="--ltx-fo-width:2.36em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.29