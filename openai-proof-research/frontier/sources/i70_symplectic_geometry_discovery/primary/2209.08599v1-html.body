0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 95.54468020044192 -35.44738946885378 L 96.09815176054207 -11.569253138458645" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 95.54468020044192 -35.44738946885378 L 96.09815176054207 -35.44738946885378" fill="none" stroke="#000000"></path><g transform="translate(-38.62,0) translate(0,-45.6) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:4.98em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.35em;font-size:10pt;" height="16.44" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="68.94"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S7.Ex13.m1.pic1.m5" class="ltx_math_unparsed" alttext="\textstyle{{\mathbb{A}}_{d_{pq}}\times{\mathbb{A}}^{\rm SSP}_{d_{q\bullet}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><mi>𝔸</mi><msub><mrow></mrow><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>𝔸</mi><msup><mrow></mrow><mi>SSP</mi></msup><msub><mrow></mrow><mrow><mi>d</mi><msub><mrow></mrow><mrow><mi>q</mi><mo lspace="0.222em">∙</mo></mrow></msub></mrow></msub></mrow><annotation encoding="application/x-tex">\textstyle{{\mathbb{A}}_{d_{pq}}\times{\mathbb{A}}^{\rm SSP}_{d_{q\bullet}}\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 38.62019147354322 -45.871230532259666 L 38.62019147354322 -45.317758972159524" fill="none" stroke="#000000"></path><g transform="translate(77.81,0) translate(0,-45.6)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 38.62019147354322 -45.871230532259666 L 77.80424239181195 -45.317758972159524" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 77.80424239181195 -45.871230532259666 L 77.80424239181195 -45.317758972159524" fill="none" stroke="#000000"></path><g transform="translate(77.81,0) translate(0,-45.6) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:2em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.35em;font-size:10pt;" height="14.26" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="27.73"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S7.Ex13.m1.pic1.m6" class="ltx_math_unparsed" alttext="\textstyle{{\mathbb{A}}_{d_{p\bullet}}}" display="inline" intent=":literal"><semantics><mrow><mi>𝔸</mi><msub><mrow></mrow><mrow><mi>d</mi><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow></msub></mrow></msub></mrow><annotation encoding="application/x-tex">\textstyle{{\mathbb{A}}_{d_{p\bullet}}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span>
</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S7.I3.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S7.I3.i4.p1" class="ltx_para">
<p id="S7.I3.i4.p1.1" class="ltx_p">For an index <math id="S7.I3.i4.p1.m1" class="ltx_math_unparsed" alttext="\alpha=\bullet r_{1}\cdots r_{l}p\in{\mathbb{A}}^{\rm PSS}_{\bullet q}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo rspace="0em">=</mo><mo lspace="0em" rspace="0.222em">∙</mo><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>l</mi></msub><mi>p</mi><mo>∈</mo><mi>𝔸</mi><msup><mrow></mrow><mi>PSS</mi></msup><msub><mrow></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\alpha=\bullet r_{1}\cdots r_{l}p\in{\mathbb{A}}^{\rm PSS}_{\bullet q}</annotation></semantics></math>, there is an embedding of Lie groups</p>
<table id="S7.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex14.m1" class="ltx_math_unparsed" alttext="G^{\text{PSS}}_{\alpha}:=G^{\text{PSS}}_{\bullet r_{1}}\times\cdots\times G_{r_{l}q}\hookrightarrow G^{\text{PSS}}_{\bullet q}=G^{\text{PSS}}_{\bullet q}" display="block" intent=":literal"><semantics><mrow><mi>G</mi><msup><mrow></mrow><mtext>PSS</mtext></msup><msub><mrow></mrow><mi>α</mi></msub><mo>:=</mo><mi>G</mi><msup><mrow></mrow><mtext>PSS</mtext></msup><msub><mrow></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi>G</mi><msub><mrow></mrow><mrow><msub><mi>r</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">↪</mo><mi>G</mi><msup><mrow></mrow><mtext>PSS</mtext></msup><msub><mrow></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow></msub><mo>=</mo><mi>G</mi><msup><mrow></mrow><mtext>PSS</mtext></msup><msub><mrow></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">G^{\text{PSS}}_{\alpha}:=G^{\text{PSS}}_{\bullet r_{1}}\times\cdots\times G_{r_{l}q}\hookrightarrow G^{\text{PSS}}_{\bullet q}=G^{\text{PSS}}_{\bullet q}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.I3.i4.p1.2" class="ltx_p">as from Notation <a href="#S5.Thmthm7" title="Notation 5.7. ‣ 5.1.4. Notations ‣ 5.1. Basic notions and the main theorem about global charts ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.7</span></a>, which further induces an embedding <math id="S7.I3.i4.p1.m2" class="ltx_Math" alttext="G^{\text{PSS}}_{\alpha}\hookrightarrow G^{\text{PSS}}_{\beta}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>G</mi><mi>α</mi><mtext>PSS</mtext></msubsup><mo stretchy="false">↪</mo><msubsup><mi>G</mi><mi>β</mi><mtext>PSS</mtext></msubsup></mrow><annotation encoding="application/x-tex">G^{\text{PSS}}_{\alpha}\hookrightarrow G^{\text{PSS}}_{\beta}</annotation></semantics></math> for any pair <math id="S7.I3.i4.p1.m3" class="ltx_Math" alttext="\alpha\leq\beta" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">\alpha\leq\beta</annotation></semantics></math> in <math id="S7.I3.i4.p1.m4" class="ltx_Math" alttext="{\mathbb{A}}_{\bullet p}^{\rm PSS}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔸</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>p</mi></mrow><mi>PSS</mi></msubsup><annotation encoding="application/x-tex">{\mathbb{A}}_{\bullet p}^{\rm PSS}</annotation></semantics></math>. Analogously, there are embeddings of Lie groups <math id="S7.I3.i4.p1.m5" class="ltx_Math" alttext="G^{\text{SSP}}_{\alpha}\hookrightarrow G^{\text{SSP}}_{\beta}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>G</mi><mi>α</mi><mtext>SSP</mtext></msubsup><mo stretchy="false">↪</mo><msubsup><mi>G</mi><mi>β</mi><mtext>SSP</mtext></msubsup></mrow><annotation encoding="application/x-tex">G^{\text{SSP}}_{\alpha}\hookrightarrow G^{\text{SSP}}_{\beta}</annotation></semantics></math> where <math id="S7.I3.i4.p1.m6" class="ltx_Math" alttext="\alpha\leq\beta" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">\alpha\leq\beta</annotation></semantics></math> are in <math id="S7.I3.i4.p1.m7" class="ltx_math_unparsed" alttext="{\mathbb{A}}^{\rm SSP}_{p\bullet}" display="inline" intent=":literal"><semantics><mrow><mi>𝔸</mi><msup><mrow></mrow><mi>SSP</mi></msup><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow></msub></mrow><annotation encoding="application/x-tex">{\mathbb{A}}^{\rm SSP}_{p\bullet}</annotation></semantics></math>.</p>
</div></li>
<li id="S7.I3.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(5)</span> 
<div id="S7.I3.i5.p1" class="ltx_para">
<p id="S7.I3.i5.p1.1" class="ltx_p">The system of auxiliary moduli spaces</p>
<table id="S7.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex15.m1" class="ltx_Math" alttext="B^{\text{PSS}}_{d}:=\big\{x=[\Sigma,\Sigma_{\text{PSS}},{\bf L},u]\in{\mathcal{F}}^{\text{PSS}}_{0,2}(d)\ |\ {\rm ev}_{-}(x)=[1,0,\ldots,0]\in\mathbb{CP}^{d}\big\}," display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>B</mi><mi>d</mi><mtext>PSS</mtext></msubsup><mo>:=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>x</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">Σ</mi><mo>,</mo><msub><mi mathvariant="normal">Σ</mi><mtext>PSS</mtext></msub><mo>,</mo><mi>𝐋</mi><mo>,</mo><mi>u</mi></mrow><mo stretchy="false">]</mo></mrow><mo>∈</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mtext>PSS</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo rspace="0.222em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.500em">|</mo><mrow><mrow><msub><mi>ev</mi><mo>−</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn></mrow><mo stretchy="false">]</mo></mrow><mo>∈</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">B^{\text{PSS}}_{d}:=\big\{x=[\Sigma,\Sigma_{\text{PSS}},{\bf L},u]\in{\mathcal{F}}^{\text{PSS}}_{0,2}(d)\ |\ {\rm ev}_{-}(x)=[1,0,\ldots,0]\in\mathbb{CP}^{d}\big\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="S7.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex16.m1" class="ltx_Math" alttext="B^{\text{SSP}}_{d}:=\big\{x=[\Sigma,\Sigma_{\text{SSP}},{\bf L},u]\in{\mathcal{F}}^{\text{SSP}}_{0,2}(d)\ |\ {\rm ev}_{-}(x)=[1,0,\ldots,0]\in\mathbb{CP}^{d}\big\}," display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>B</mi><mi>d</mi><mtext>SSP</mtext></msubsup><mo>:=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>x</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">Σ</mi><mo>,</mo><msub><mi mathvariant="normal">Σ</mi><mtext>SSP</mtext></msub><mo>,</mo><mi>𝐋</mi><mo>,</mo><mi>u</mi></mrow><mo stretchy="false">]</mo></mrow><mo>∈</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mtext>SSP</mtext></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo rspace="0.222em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.500em">|</mo><mrow><mrow><msub><mi>ev</mi><mo>−</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>0</mn></mrow><mo stretchy="false">]</mo></mrow><mo>∈</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">B^{\text{SSP}}_{d}:=\big\{x=[\Sigma,\Sigma_{\text{SSP}},{\bf L},u]\in{\mathcal{F}}^{\text{SSP}}_{0,2}(d)\ |\ {\rm ev}_{-}(x)=[1,0,\ldots,0]\in\mathbb{CP}^{d}\big\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.I3.i5.p1.2" class="ltx_p">where <math id="S7.I3.i5.p1.m1" class="ltx_Math" alttext="{\rm ev}_{-}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ev</mi><mo>−</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\rm ev}_{-}(x)</annotation></semantics></math> is the image of the evaluation map of <math id="S7.I3.i5.p1.m2" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> at the marked point <math id="S7.I3.i5.p1.m3" class="ltx_Math" alttext="z_{-}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mo>−</mo></msub><annotation encoding="application/x-tex">z_{-}</annotation></semantics></math>.
Each <math id="S7.I3.i5.p1.m4" class="ltx_Math" alttext="B^{\text{PSS}}_{d}" display="inline" intent=":literal"><semantics><msubsup><mi>B</mi><mi>d</mi><mtext>PSS</mtext></msubsup><annotation encoding="application/x-tex">B^{\text{PSS}}_{d}</annotation></semantics></math> resp. <math id="S7.I3.i5.p1.m5" class="ltx_Math" alttext="B^{\text{SSP}}_{d}" display="inline" intent=":literal"><semantics><msubsup><mi>B</mi><mi>d</mi><mtext>SSP</mtext></msubsup><annotation encoding="application/x-tex">B^{\text{SSP}}_{d}</annotation></semantics></math> is a smooth <math id="S7.I3.i5.p1.m6" class="ltx_Math" alttext="{\mathbb{A}}_{d}" display="inline" intent=":literal"><semantics><msub><mi>𝔸</mi><mi>d</mi></msub><annotation encoding="application/x-tex">{\mathbb{A}}_{d}</annotation></semantics></math>-manifold and has a <math id="S7.I3.i5.p1.m7" class="ltx_Math" alttext="G_{d}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>d</mi></msub><annotation encoding="application/x-tex">G_{d}</annotation></semantics></math>-action.</p>
</div></li>
<li id="S7.I3.i6" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(6)</span> 
<div id="S7.I3.i6.p1" class="ltx_para">
<p id="S7.I3.i6.p1.1" class="ltx_p">For <math id="S7.I3.i6.p1.m1" class="ltx_math_unparsed" alttext="\alpha=\bullet r_{1}\cdots r_{l}q\in{\mathbb{A}}^{\rm PSS}_{\bullet q}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo rspace="0em">=</mo><mo lspace="0em" rspace="0.222em">∙</mo><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>l</mi></msub><mi>q</mi><mo>∈</mo><mi>𝔸</mi><msup><mrow></mrow><mi>PSS</mi></msup><msub><mrow></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\alpha=\bullet r_{1}\cdots r_{l}q\in{\mathbb{A}}^{\rm PSS}_{\bullet q}</annotation></semantics></math> (resp. <math id="S7.I3.i6.p1.m2" class="ltx_math_unparsed" alttext="pr_{1}\cdots r_{l}\bullet\in{\mathbb{A}}^{\rm SSP}_{p\bullet}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>l</mi></msub><mo lspace="0.222em" rspace="0em">∙</mo><mo lspace="0em">∈</mo><mi>𝔸</mi><msup><mrow></mrow><mi>SSP</mi></msup><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow></msub></mrow><annotation encoding="application/x-tex">pr_{1}\cdots r_{l}\bullet\in{\mathbb{A}}^{\rm SSP}_{p\bullet}</annotation></semantics></math>), define</p>
<table id="S7.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex17.m1" class="ltx_math_unparsed" alttext="B^{\rm PSS}_{\alpha}:=B^{\rm PSS}_{d_{\bullet r_{1}}}\times\cdots\times B_{d_{r_{l}q}}" display="block" intent=":literal"><semantics><mrow><mi>B</mi><msup><mrow></mrow><mi>PSS</mi></msup><msub><mrow></mrow><mi>α</mi></msub><mo>:=</mo><mi>B</mi><msup><mrow></mrow><mi>PSS</mi></msup><msub><mrow></mrow><msub><mi>d</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></msub></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi>B</mi><msub><mrow></mrow><msub><mi>d</mi><mrow><msub><mi>r</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></msub></mrow><annotation encoding="application/x-tex">B^{\rm PSS}_{\alpha}:=B^{\rm PSS}_{d_{\bullet r_{1}}}\times\cdots\times B_{d_{r_{l}q}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="S7.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex18.m1" class="ltx_math_unparsed" alttext="\text{resp. }B^{\rm SSP}_{\alpha}:=B_{d_{pr_{1}}}\times\cdots\times B^{\rm SSP}_{d_{r_{l}\bullet}}." display="block" intent=":literal"><semantics><mrow><mtext>resp. </mtext><mi>B</mi><msup><mrow></mrow><mi>SSP</mi></msup><msub><mrow></mrow><mi>α</mi></msub><mo>:=</mo><mi>B</mi><msub><mrow></mrow><msub><mi>d</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></msub></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi>B</mi><msup><mrow></mrow><mi>SSP</mi></msup><msub><mrow></mrow><mrow><mi>d</mi><msub><mrow></mrow><mrow><mi>r</mi><msub><mrow></mrow><mi>l</mi></msub><mo lspace="0.222em">∙</mo></mrow></msub></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\text{resp. }B^{\rm SSP}_{\alpha}:=B_{d_{pr_{1}}}\times\cdots\times B^{\rm SSP}_{d_{r_{l}\bullet}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.I3.i6.p1.2" class="ltx_p">Then <math id="S7.I3.i6.p1.m3" class="ltx_Math" alttext="B^{\rm PSS}_{\alpha}" display="inline" intent=":literal"><semantics><msubsup><mi>B</mi><mi>α</mi><mi>PSS</mi></msubsup><annotation encoding="application/x-tex">B^{\rm PSS}_{\alpha}</annotation></semantics></math> (resp. <math id="S7.I3.i6.p1.m4" class="ltx_Math" alttext="B^{\rm SSP}_{\alpha}" display="inline" intent=":literal"><semantics><msubsup><mi>B</mi><mi>α</mi><mi>SSP</mi></msubsup><annotation encoding="application/x-tex">B^{\rm SSP}_{\alpha}</annotation></semantics></math>) has a smooth <math id="S7.I3.i6.p1.m5" class="ltx_Math" alttext="G_{\alpha}^{\rm PSS}" display="inline" intent=":literal"><semantics><msubsup><mi>G</mi><mi>α</mi><mi>PSS</mi></msubsup><annotation encoding="application/x-tex">G_{\alpha}^{\rm PSS}</annotation></semantics></math> (resp. <math id="S7.I3.i6.p1.m6" class="ltx_Math" alttext="G_{\alpha}^{\rm SSP}" display="inline" intent=":literal"><semantics><msubsup><mi>G</mi><mi>α</mi><mi>SSP</mi></msubsup><annotation encoding="application/x-tex">G_{\alpha}^{\rm SSP}</annotation></semantics></math>) action.</p>
</div></li>
<li id="S7.I3.i7" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(7)</span> 
<div id="S7.I3.i7.p1" class="ltx_para">
<p id="S7.I3.i7.p1.1" class="ltx_p">Just as Equation (<a href="#S5.E11" title="In 5.2.5. Boundary strata of the auxiliary moduli spaces ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.11</span></a>), under the group embedding <math id="S7.I3.i7.p1.m1" class="ltx_Math" alttext="G^{\rm PSS}_{\alpha}\hookrightarrow G_{\bullet q}^{\rm PSS}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>G</mi><mi>α</mi><mi>PSS</mi></msubsup><mo stretchy="false">↪</mo><msubsup><mi>G</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup></mrow><annotation encoding="application/x-tex">G^{\rm PSS}_{\alpha}\hookrightarrow G_{\bullet q}^{\rm PSS}</annotation></semantics></math>, there is an equivariant embedding</p>
<table id="S7.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex19.m1" class="ltx_Math" alttext="B^{\rm PSS}_{\alpha}\hookrightarrow B^{\rm PSS}_{\bullet q}," display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>B</mi><mi>α</mi><mi>PSS</mi></msubsup><mo stretchy="false">↪</mo><msubsup><mi>B</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">B^{\rm PSS}_{\alpha}\hookrightarrow B^{\rm PSS}_{\bullet q},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.I3.i7.p1.2" class="ltx_p">which is part of the data of the embeddings of the form</p>
<table id="S7.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex20.m1" class="ltx_Math" alttext="B^{\rm PSS}_{\alpha}\hookrightarrow B^{\rm PSS}_{\beta}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>B</mi><mi>α</mi><mi>PSS</mi></msubsup><mo stretchy="false">↪</mo><msubsup><mi>B</mi><mi>β</mi><mi>PSS</mi></msubsup></mrow><annotation encoding="application/x-tex">B^{\rm PSS}_{\alpha}\hookrightarrow B^{\rm PSS}_{\beta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.I3.i7.p1.3" class="ltx_p">for any <math id="S7.I3.i7.p1.m2" class="ltx_Math" alttext="\alpha\leq\beta" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>≤</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">\alpha\leq\beta</annotation></semantics></math> under the group embedding <math id="S7.I3.i7.p1.m3" class="ltx_Math" alttext="G_{\alpha}^{\rm PSS}\hookrightarrow G_{\beta}^{\rm PSS}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>G</mi><mi>α</mi><mi>PSS</mi></msubsup><mo stretchy="false">↪</mo><msubsup><mi>G</mi><mi>β</mi><mi>PSS</mi></msubsup></mrow><annotation encoding="application/x-tex">G_{\alpha}^{\rm PSS}\hookrightarrow G_{\beta}^{\rm PSS}</annotation></semantics></math>. This fact is also true after replacing PSS by SSP.</p>
</div></li>
</ol>
</div>
</div>
</section>
<section id="S7.SS1.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">7.1.2. </span>Description of global charts</h4>

<div id="S7.SS1.SSS2.p1" class="ltx_para">
<p id="S7.SS1.SSS2.p1.1" class="ltx_p">The following statement allows to construct framings from solutions to the PSS/SSP equations. The proof is the same as the proof of Corollary <a href="#S5.Thmthm30" title="Corollary 5.30. ‣ 5.2.8. Abelian gauge theory on punctured spheres ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.30</span></a> using the integrality assumptions.</p>
</div>
<div id="S7.Thmthm3" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm3.2" class="ltx_text ltx_font_bold">Proposition 7.3</span></span><span id="S7.Thmthm3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm3.p1" class="ltx_para">
<p id="S7.Thmthm3.p1.1" class="ltx_p"><span id="S7.Thmthm3.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S7.Thmthm3.p1.m1" class="ltx_Math" alttext="(\Sigma,\Sigma_{\rm PSS},{\bm{L}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><msub><mi mathvariant="normal">Σ</mi><mi>PSS</mi></msub><mo>,</mo><mi>𝐋</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Sigma,\Sigma_{\rm PSS},{\bm{L}})</annotation></semantics></math> be a prestable PSS thimble, and suppose that</span></p>
<table id="S7.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex21.m1" class="ltx_Math" alttext="u:\Sigma\to M" display="block" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">u:\Sigma\to M</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.Thmthm3.p1.2" class="ltx_p"><span id="S7.Thmthm3.p1.2.1" class="ltx_text ltx_font_italic">is a </span><span id="S7.Thmthm3.p1.2.2" class="ltx_text ltx_font_bold">stable PSS thimble</span><span id="S7.Thmthm3.p1.2.3" class="ltx_text ltx_font_italic">, i.e. the restriction of <math id="S7.Thmthm3.p1.m2" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> to the irreducible component <math id="S7.Thmthm3.p1.m3" class="ltx_Math" alttext="\Sigma_{\rm PSS}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>PSS</mi></msub><annotation encoding="application/x-tex">\Sigma_{\rm PSS}</annotation></semantics></math> solves the PSS equation (<a href="#S4.E6" title="In 4.3.1. Moduli spaces ‣ 4.3. PSS and SSP bimodules ‣ 4. Proof of the integral Arnold conjecture ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.6</span></a>), its restriction to the cylindrical components on the right of <math id="S7.Thmthm3.p1.m4" class="ltx_Math" alttext="\Sigma_{\rm PSS}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>PSS</mi></msub><annotation encoding="application/x-tex">\Sigma_{\rm PSS}</annotation></semantics></math> solves the Floer equation (<a href="#S4.E2" title="In 4.1.1. The moduli spaces of Floer trajectories ‣ 4.1. Hamiltonian Floer flow categories ‣ 4. Proof of the integral Arnold conjecture ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>), while its restriction to other components solves the genuine <math id="S7.Thmthm3.p1.m5" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math>-holomorphic curve equation, and <math id="S7.Thmthm3.p1.m6" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> has finite automorphism group. Consider the <math id="S7.Thmthm3.p1.m7" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-form <math id="S7.Thmthm3.p1.m8" class="ltx_Math" alttext="\Omega_{u,{\rm PSS}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ω</mi><mrow><mi>u</mi><mo>,</mo><mi>PSS</mi></mrow></msub><annotation encoding="application/x-tex">\Omega_{u,{\rm PSS}}</annotation></semantics></math> defined by</span></p>
<table id="S7.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E1.m1" class="ltx_Math" alttext="\Omega_{u,{\rm PSS}}:=\left\{\begin{array}[]{lr}\displaystyle u^{*}\omega-d(H_{s,t}^{\rm PSS}(u)dt)&amp;\text{ on the distinguished component $\Sigma_{\rm PSS}$}\\
\displaystyle u^{*}\omega-d(H_{t}(u)dt)&amp;\text{ on cylindrical components on the right of $\Sigma_{\rm PSS}$}\\
\displaystyle u^{*}\omega&amp;\text{ on other irreducible components.}\end{array}\right." display="block" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Ω</mi><mrow><mi>u</mi><mo>,</mo><mi>PSS</mi></mrow></msub><mo>:=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow><mo>−</mo><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>H</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi></mrow><mi>PSS</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_right" columnalign="right"><mrow><mtext class="ltx_mathvariant_italic"> on the distinguished component </mtext><msub><mi mathvariant="normal">Σ</mi><mi>PSS</mi></msub></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow><mo>−</mo><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>H</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_right" columnalign="right"><mrow><mtext class="ltx_mathvariant_italic"> on cylindrical components on the right of </mtext><msub><mi mathvariant="normal">Σ</mi><mi>PSS</mi></msub></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow></mtd><mtd class="ltx_align_right" columnalign="right"><mtext class="ltx_mathvariant_italic"> on other irreducible components.</mtext></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">\Omega_{u,{\rm PSS}}:=\left\{\begin{array}[]{lr}\displaystyle u^{*}\omega-d(H_{s,t}^{\rm PSS}(u)dt)&amp;\text{ on the distinguished component $\Sigma_{\rm PSS}$}\\
\displaystyle u^{*}\omega-d(H_{t}(u)dt)&amp;\text{ on cylindrical components on the right of $\Sigma_{\rm PSS}$}\\
\displaystyle u^{*}\omega&amp;\text{ on other irreducible components.}\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7.1)</span></td></tr></tbody>
</table>
<p id="S7.Thmthm3.p1.3" class="ltx_p"><span id="S7.Thmthm3.p1.3.1" class="ltx_text ltx_font_italic">Then there exists a holomorphic Hermitian line bundle on <math id="S7.Thmthm3.p1.m9" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> whose curvature form is <math id="S7.Thmthm3.p1.m10" class="ltx_Math" alttext="-2\pi{\bm{i}}\Omega_{u,{\rm PSS}}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐢</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Ω</mi><mrow><mi>u</mi><mo>,</mo><mi>PSS</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">-2\pi{\bm{i}}\Omega_{u,{\rm PSS}}</annotation></semantics></math>. Moreover, this line bundle is unique up to isomorphism.</span></p>
</div>
<div id="S7.Thmthm3.p2" class="ltx_para">
<p id="S7.Thmthm3.p2.1" class="ltx_p"><span id="S7.Thmthm3.p2.1.1" class="ltx_text ltx_font_italic">Similarly, if <math id="S7.Thmthm3.p2.m1" class="ltx_Math" alttext="(\Sigma,\Sigma_{\rm SSP},{\bm{L}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><msub><mi mathvariant="normal">Σ</mi><mi>SSP</mi></msub><mo>,</mo><mi>𝐋</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Sigma,\Sigma_{\rm SSP},{\bm{L}})</annotation></semantics></math> is a prestable SSP thimble and <math id="S7.Thmthm3.p2.m2" class="ltx_Math" alttext="u:\Sigma\to M" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">u:\Sigma\to M</annotation></semantics></math> is a </span><span id="S7.Thmthm3.p2.1.2" class="ltx_text ltx_font_bold">stable SSP thimble</span><span id="S7.Thmthm3.p2.1.3" class="ltx_text ltx_font_italic"> which solves the SSP equation (<a href="#S4.E10" title="In 4.3.1. Moduli spaces ‣ 4.3. PSS and SSP bimodules ‣ 4. Proof of the integral Arnold conjecture ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.10</span></a>) on <math id="S7.Thmthm3.p2.m3" class="ltx_Math" alttext="\Sigma_{{\rm SSP}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>SSP</mi></msub><annotation encoding="application/x-tex">\Sigma_{{\rm SSP}}</annotation></semantics></math>, there exists a Hermitian line bundle over <math id="S7.Thmthm3.p2.m4" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math>, unique up to isomorphism, such that the curvature of its Chern connection is equal to <math id="S7.Thmthm3.p2.m5" class="ltx_Math" alttext="-2\pi{\bm{i}}\Omega_{u,{\rm PSS}}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐢</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Ω</mi><mrow><mi>u</mi><mo>,</mo><mi>PSS</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">-2\pi{\bm{i}}\Omega_{u,{\rm PSS}}</annotation></semantics></math>, where</span></p>
<table id="S7.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex22.m1" class="ltx_Math" alttext="\Omega_{u,{\rm SSP}}:=\left\{\begin{array}[]{lr}\displaystyle u^{*}\omega-d(H_{s,t}^{\rm SSP}(u)dt)&amp;\text{ on the distinguished component $\Sigma_{\rm SSP}$}\\
\displaystyle u^{*}\omega-d(H_{t}(u)dt)&amp;\text{ on cylindrical components on the left of $\Sigma_{\rm SSP}$}\\
\displaystyle u^{*}\omega&amp;\text{ on other irreducible components.}\qed\end{array}\right." display="block" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Ω</mi><mrow><mi>u</mi><mo>,</mo><mi>SSP</mi></mrow></msub><mo>:=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="2.0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow><mo>−</mo><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>H</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi></mrow><mi>SSP</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_right" columnalign="right"><mrow><mtext class="ltx_mathvariant_italic"> on the distinguished component </mtext><msub><mi mathvariant="normal">Σ</mi><mi>SSP</mi></msub></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow><mo>−</mo><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>H</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_right" columnalign="right"><mrow><mtext class="ltx_mathvariant_italic"> on cylindrical components on the left of </mtext><msub><mi mathvariant="normal">Σ</mi><mi>SSP</mi></msub></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow></mtd><mtd class="ltx_align_right" columnalign="right"><mrow><mtext class="ltx_mathvariant_italic"> on other irreducible components.</mtext><mo class="ltx_mathvariant_italic" lspace="0em" mathvariant="italic" separator="true">∎</mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">\Omega_{u,{\rm SSP}}:=\left\{\begin{array}[]{lr}\displaystyle u^{*}\omega-d(H_{s,t}^{\rm SSP}(u)dt)&amp;\text{ on the distinguished component $\Sigma_{\rm SSP}$}\\
\displaystyle u^{*}\omega-d(H_{t}(u)dt)&amp;\text{ on cylindrical components on the left of $\Sigma_{\rm SSP}$}\\
\displaystyle u^{*}\omega&amp;\text{ on other irreducible components.}\qed\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S7.SS1.SSS2.p2" class="ltx_para">
<p id="S7.SS1.SSS2.p2.1" class="ltx_p">Given a stable PSS (resp. SSP) thimble, let us denote the line bundle constructed as above by <math id="S7.SS1.SSS2.p2.m1" class="ltx_Math" alttext="L_{u,{\rm PSS}}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mrow><mi>u</mi><mo>,</mo><mi>PSS</mi></mrow></msub><annotation encoding="application/x-tex">L_{u,{\rm PSS}}</annotation></semantics></math> (resp. <math id="S7.SS1.SSS2.p2.m2" class="ltx_Math" alttext="L_{u,{\rm SSP}}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mrow><mi>u</mi><mo>,</mo><mi>SSP</mi></mrow></msub><annotation encoding="application/x-tex">L_{u,{\rm SSP}}</annotation></semantics></math>). Now we can introduce the concept of framed curves in the context of PSS/SSP map.</p>
</div>
<div id="S7.Thmthm4" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm4.2" class="ltx_text ltx_font_bold">Definition 7.4</span></span><span id="S7.Thmthm4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm4.p1" class="ltx_para">
<p id="S7.Thmthm4.p1.1" class="ltx_p">Given a moduli space <math id="S7.Thmthm4.p1.m1" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}^{\rm PSS}_{\bullet q}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msup><mrow></mrow><mi>PSS</mi></msup><msub><mrow></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}^{\rm PSS}_{\bullet q}</annotation></semantics></math> of stable PSS thimbles and a stratum <math id="S7.Thmthm4.p1.m2" class="ltx_math_unparsed" alttext="\alpha=\bullet r_{1}\cdots r_{l}q" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo rspace="0em">=</mo><mo lspace="0em" rspace="0.222em">∙</mo><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>l</mi></msub><mi>q</mi></mrow><annotation encoding="application/x-tex">\alpha=\bullet r_{1}\cdots r_{l}q</annotation></semantics></math> which corresponds to thimbles breaking at the orbits <math id="S7.Thmthm4.p1.m3" class="ltx_Math" alttext="r_{1},\dots,r_{l}" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>r</mi><mi>l</mi></msub></mrow><annotation encoding="application/x-tex">r_{1},\dots,r_{l}</annotation></semantics></math>, denoting <math id="S7.Thmthm4.p1.m4" class="ltx_Math" alttext="d=d_{\bullet q}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><msub><mi>d</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">d=d_{\bullet q}</annotation></semantics></math>, a <span id="S7.Thmthm4.p1.1.1" class="ltx_text ltx_font_bold">framed PSS thimble</span> (of type <math id="S7.Thmthm4.p1.m5" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>) is a tuple <math id="S7.Thmthm4.p1.m6" class="ltx_Math" alttext="(u,\Sigma,F)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>F</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u,\Sigma,F)</annotation></semantics></math> where</p>
<ol id="S7.I4" class="ltx_enumerate">
<li id="S7.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S7.I4.i1.p1" class="ltx_para">
<p id="S7.I4.i1.p1.1" class="ltx_p"><math id="S7.I4.i1.p1.m1" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> is a prestable PSS thimble with <math id="S7.I4.i1.p1.m2" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> horizontal levels on the right of <math id="S7.I4.i1.p1.m3" class="ltx_Math" alttext="\Sigma_{\rm PSS}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>PSS</mi></msub><annotation encoding="application/x-tex">\Sigma_{\rm PSS}</annotation></semantics></math>. (see Definition <a href="#S7.Thmthm1" title="Definition 7.1. ‣ 7.1.1. Thimbles and auxiliary moduli spaces ‣ 7.1. PSS bimodule and SSP bimodule ‣ 7. Constructions for PSS, SSP, and the homotopy ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.1</span></a>).</p>
</div></li>
<li id="S7.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S7.I4.i2.p1" class="ltx_para">
<p id="S7.I4.i2.p1.1" class="ltx_p"><math id="S7.I4.i2.p1.m1" class="ltx_Math" alttext="u:\Sigma\to M" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">u:\Sigma\to M</annotation></semantics></math> is a smooth map whose restriction to each cylindrical component on the right of <math id="S7.I4.i2.p1.m2" class="ltx_Math" alttext="\Sigma_{\rm PSS}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi>PSS</mi></msub><annotation encoding="application/x-tex">\Sigma_{\rm PSS}</annotation></semantics></math> (included) converges to periodic orbits prescribed by the capped orbits <math id="S7.I4.i2.p1.m3" class="ltx_Math" alttext="p,r_{1},\dots,r_{l},q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>,</mo><msub><mi>r</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>r</mi><mi>l</mi></msub><mo>,</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p,r_{1},\dots,r_{l},q</annotation></semantics></math> at <math id="S7.I4.i2.p1.m4" class="ltx_Math" alttext="\pm\infty" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\pm\infty</annotation></semantics></math> in an exponential rate, and the topological energy of these levels are prescribed accordingly. Moreover, the <math id="S7.I4.i2.p1.m5" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-form <math id="S7.I4.i2.p1.m6" class="ltx_Math" alttext="\Omega_{u,{\rm PSS}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ω</mi><mrow><mi>u</mi><mo>,</mo><mi>PSS</mi></mrow></msub><annotation encoding="application/x-tex">\Omega_{u,{\rm PSS}}</annotation></semantics></math> defined in Equation (<a href="#S7.E1" title="In Proposition 7.3. ‣ 7.1.2. Description of global charts ‣ 7.1. PSS bimodule and SSP bimodule ‣ 7. Constructions for PSS, SSP, and the homotopy ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.1</span></a>) is non-negative and is strictly positive on each unstable component of <math id="S7.I4.i2.p1.m7" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math>.</p>
</div></li>
<li id="S7.I4.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S7.I4.i3.p1" class="ltx_para">
<p id="S7.I4.i3.p1.1" class="ltx_p"><math id="S7.I4.i3.p1.m1" class="ltx_Math" alttext="F=(f_{0},f_{1},\ldots,f_{d})" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mn>0</mn></msub><mo>,</mo><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F=(f_{0},f_{1},\ldots,f_{d})</annotation></semantics></math> is basis of global sections of the line bundle <math id="S7.I4.i3.p1.m2" class="ltx_Math" alttext="L_{u,{\rm PSS}}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mrow><mi>u</mi><mo>,</mo><mi>PSS</mi></mrow></msub><annotation encoding="application/x-tex">L_{u,{\rm PSS}}</annotation></semantics></math> constructed using the <math id="S7.I4.i3.p1.m3" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-form (<a href="#S7.E1" title="In Proposition 7.3. ‣ 7.1.2. Description of global charts ‣ 7.1. PSS bimodule and SSP bimodule ‣ 7. Constructions for PSS, SSP, and the homotopy ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.1</span></a>). Moreover, the induced holomorphic map</p>
<table id="S7.E2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E2.m1" class="ltx_Math" alttext="\iota_{F,{\rm PSS}}:\Sigma\to\mathbb{CP}^{d},\ w\mapsto[f_{0}(w),\ldots,f_{d}(w)]" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ι</mi><mrow><mi>F</mi><mo>,</mo><mi>PSS</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mi>w</mi><mo stretchy="false">↦</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>f</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>f</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\iota_{F,{\rm PSS}}:\Sigma\to\mathbb{CP}^{d},\ w\mapsto[f_{0}(w),\ldots,f_{d}(w)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7.2)</span></td></tr></tbody>
</table>
<p id="S7.I4.i3.p1.2" class="ltx_p">is a stable map, which represents a point <math id="S7.I4.i3.p1.m4" class="ltx_Math" alttext="[\iota_{F,{\rm PSS}}]\in{\mathcal{F}}^{\rm PSS}_{0,2}(d)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><msub><mi>ι</mi><mrow><mi>F</mi><mo>,</mo><mi>PSS</mi></mrow></msub><mo stretchy="false">]</mo></mrow><mo>∈</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mi>PSS</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">[\iota_{F,{\rm PSS}}]\in{\mathcal{F}}^{\rm PSS}_{0,2}(d)</annotation></semantics></math>. Denote by</p>
<table id="S7.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex23.m1" class="ltx_Math" alttext="\tilde{\iota}_{F,{\rm PSS}}:\Sigma\to{\mathcal{C}}^{\rm PSS}={\mathcal{C}}^{\rm PSS}_{0,2}(d)" display="block" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ι</mi><mo>~</mo></mover><mrow><mi>F</mi><mo>,</mo><mi>PSS</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><msup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>PSS</mi></msup><mo>=</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mi>PSS</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{\iota}_{F,{\rm PSS}}:\Sigma\to{\mathcal{C}}^{\rm PSS}={\mathcal{C}}^{\rm PSS}_{0,2}(d)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.I4.i3.p1.3" class="ltx_p">to be the identification between <math id="S7.I4.i3.p1.m5" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> and the fiber of the universal curve <math id="S7.I4.i3.p1.m6" class="ltx_Math" alttext="{\mathcal{C}}^{\rm PSS}_{0,2}(d)\to{\mathcal{F}}^{\rm PSS}_{0,2}(d)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mi>PSS</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><mi>PSS</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{C}}^{\rm PSS}_{0,2}(d)\to{\mathcal{F}}^{\rm PSS}_{0,2}(d)</annotation></semantics></math> over <math id="S7.I4.i3.p1.m7" class="ltx_Math" alttext="[\iota_{F,{\rm PSS}}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mi>ι</mi><mrow><mi>F</mi><mo>,</mo><mi>PSS</mi></mrow></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[\iota_{F,{\rm PSS}}]</annotation></semantics></math>. This will also be called the domain map.</p>
</div></li>
</ol>
</div>
</div>
<div id="S7.SS1.SSS2.p3" class="ltx_para">
<p id="S7.SS1.SSS2.p3.1" class="ltx_p">By replacing PSS with SSP, we obtain the definition of <span id="S7.SS1.SSS2.p3.1.1" class="ltx_text ltx_font_bold">framed PSS thimble</span>. Isomorphisms of framed PSS/SSP thimbles are defined in the same way as Definition <a href="#S5.Thmthm32" title="Definition 5.32. ‣ 5.3.1. Description of the K-chart. ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.32</span></a>. The compact Lie group <math id="S7.SS1.SSS2.p3.m1" class="ltx_Math" alttext="PU(d+1)" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">PU(d+1)</annotation></semantics></math> acts on the space of framed PSS/SSP thimbles by changing the framing. The stabilizer of this <math id="S7.SS1.SSS2.p3.m2" class="ltx_Math" alttext="PU(d+1)" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">PU(d+1)</annotation></semantics></math> action at <math id="S7.SS1.SSS2.p3.m3" class="ltx_Math" alttext="(u,\Sigma,F)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>F</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u,\Sigma,F)</annotation></semantics></math> agrees with the automorphism group of the map <math id="S7.SS1.SSS2.p3.m4" class="ltx_Math" alttext="u:\Sigma\to M" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">u:\Sigma\to M</annotation></semantics></math> if <math id="S7.SS1.SSS2.p3.m5" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> is a stable PSS/SSP thimble.</p>
</div>
<div id="S7.SS1.SSS2.p4" class="ltx_para">
<p id="S7.SS1.SSS2.p4.1" class="ltx_p">Now we can repeat the global thickening construction in the setting of PSS/SSP maps as we did in the case for Floer trajectories. Let <math id="S7.SS1.SSS2.p4.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> be a capped <math id="S7.SS1.SSS2.p4.m2" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>-periodic orbit. Fix <math id="S7.SS1.SSS2.p4.m3" class="ltx_Math" alttext="d=d_{\bullet q}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><msub><mi>d</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">d=d_{\bullet q}</annotation></semantics></math>. Let</p>
<table id="S7.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex24.m1" class="ltx_Math" alttext="k_{1}&lt;\cdots&lt;k_{d}" display="block" intent=":literal"><semantics><mrow><msub><mi>k</mi><mn>1</mn></msub><mo rspace="0.1389em">&lt;</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">&lt;</mo><msub><mi>k</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">k_{1}&lt;\cdots&lt;k_{d}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS2.p4.2" class="ltx_p">be a sequence of positive integers. Define <math id="S7.SS1.SSS2.p4.m4" class="ltx_Math" alttext="V_{\bullet q}^{\rm PSS}:=V_{\bullet q}^{\rm PSS}(k_{1},\ldots,k_{d})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><mo>:=</mo><mrow><msubsup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>k</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">V_{\bullet q}^{\rm PSS}:=V_{\bullet q}^{\rm PSS}(k_{1},\ldots,k_{d})</annotation></semantics></math> be the moduli space of tuples</p>
<table id="S7.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex25.m1" class="ltx_Math" alttext="(\Sigma,u,F,\eta_{1},\ldots,\eta_{d})" display="block" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>F</mi><mo>,</mo><msub><mi>η</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>η</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\Sigma,u,F,\eta_{1},\ldots,\eta_{d})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS2.p4.3" class="ltx_p">where <math id="S7.SS1.SSS2.p4.m5" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> is a prestable PSS thimble, <math id="S7.SS1.SSS2.p4.m6" class="ltx_Math" alttext="u:\Sigma\to M" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">u:\Sigma\to M</annotation></semantics></math> is a smooth map with topological energy <math id="S7.SS1.SSS2.p4.m7" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> converging to <math id="S7.SS1.SSS2.p4.m8" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> at the marked point <math id="S7.SS1.SSS2.p4.m9" class="ltx_Math" alttext="z_{+}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mo>+</mo></msub><annotation encoding="application/x-tex">z_{+}</annotation></semantics></math>, <math id="S7.SS1.SSS2.p4.m10" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> is a frame of the line bundle <math id="S7.SS1.SSS2.p4.m11" class="ltx_Math" alttext="L_{u,{\rm PSS}}\to\Sigma" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mrow><mi>u</mi><mo>,</mo><mi>PSS</mi></mrow></msub><mo stretchy="false">→</mo><mi mathvariant="normal">Σ</mi></mrow><annotation encoding="application/x-tex">L_{u,{\rm PSS}}\to\Sigma</annotation></semantics></math> inducing a holomorphic map <math id="S7.SS1.SSS2.p4.m12" class="ltx_Math" alttext="\iota_{F,{\rm PSS}}:\Sigma\to\mathbb{CP}^{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ι</mi><mrow><mi>F</mi><mo>,</mo><mi>PSS</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\iota_{F,{\rm PSS}}:\Sigma\to\mathbb{CP}^{d}</annotation></semantics></math> such that the framing <math id="S7.SS1.SSS2.p4.m13" class="ltx_Math" alttext="F=(f_{0},\dots,f_{d})" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F=(f_{0},\dots,f_{d})</annotation></semantics></math> satisfies <math id="S7.SS1.SSS2.p4.m14" class="ltx_math_unparsed" alttext="[f_{0}(z_{-}):\cdots:f_{d}(z_{-})]=[1:0:\cdots:0]" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><msub><mi>f</mi><mn>0</mn></msub><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mo>−</mo></msub><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo>:</mo><mo lspace="0.111em">⋯</mo><mo rspace="0.278em">:</mo><msub><mi>f</mi><mi>d</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>=</mo><mrow><mo stretchy="false">[</mo><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mn>0</mn><mo lspace="0.278em">:</mo><mo lspace="0.111em">⋯</mo><mo rspace="0.278em">:</mo><mn>0</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">[f_{0}(z_{-}):\cdots:f_{d}(z_{-})]=[1:0:\cdots:0]</annotation></semantics></math>, and the corresponding domain map <math id="S7.SS1.SSS2.p4.m15" class="ltx_Math" alttext="\tilde{\iota}_{F,{\rm PSS}}:\Sigma\to{\mathcal{C}}^{\rm PSS}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ι</mi><mo>~</mo></mover><mrow><mi>F</mi><mo>,</mo><mi>PSS</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><msup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>PSS</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\tilde{\iota}_{F,{\rm PSS}}:\Sigma\to{\mathcal{C}}^{\rm PSS}</annotation></semantics></math>, and (denoting by <math id="S7.SS1.SSS2.p4.m16" class="ltx_Math" alttext="\tilde{u}=(u,\tilde{\iota}_{F,{\rm PSS}}):\Sigma\to M\times{\mathcal{C}}^{\rm PSS}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><msub><mover accent="true"><mi>ι</mi><mo>~</mo></mover><mrow><mi>F</mi><mo>,</mo><mi>PSS</mi></mrow></msub><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Σ</mi><mo stretchy="false">→</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>PSS</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{u}=(u,\tilde{\iota}_{F,{\rm PSS}}):\Sigma\to M\times{\mathcal{C}}^{\rm PSS}</annotation></semantics></math>)</p>
<table id="S7.Ex26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex26.m1" class="ltx_Math" alttext="\eta_{i}\in\tilde{u}^{*}E_{i}=\Gamma\left(\overline{\rm Hom}\big(\iota_{F,{\rm PSS}}^{*}T\mathbb{CP}^{d},u^{*}TM\oplus\bigoplus_{j=1}^{i-1}\tilde{u}^{*}E_{j}\big)\otimes\iota_{F,{\rm PSS}}^{*}{\mathcal{O}}(k_{i})\right)\otimes\overline{H^{0}(\iota_{F,{\rm PSS}}^{*}{\mathcal{O}}(k_{i}))_{0}}" display="block" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>i</mi></msub><mo>∈</mo><mrow><msup><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mi>i</mi></msub></mrow><mo>=</mo><mrow><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mrow><mover accent="true"><mi>Hom</mi><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mi>ι</mi><mrow><mi>F</mi><mo>,</mo><mi>PSS</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><mo>,</mo><mrow><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>TM</mi></mrow><mo rspace="0.055em">⊕</mo><mrow><munderover><mo movablelimits="false">⨁</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><msup><mover accent="true"><mi>u</mi><mo>~</mo></mover><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mi>j</mi></msub></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msubsup><mi>ι</mi><mrow><mi>F</mi><mo>,</mo><mi>PSS</mi></mrow><mo>∗</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><mover accent="true"><mrow><msup><mi>H</mi><mn>0</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>ι</mi><mrow><mi>F</mi><mo>,</mo><mi>PSS</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>0</mn></msub></mrow><mo stretchy="true">¯</mo></mover></mrow></mrow><annotation encoding="application/x-tex">\eta_{i}\in\tilde{u}^{*}E_{i}=\Gamma\left(\overline{\rm Hom}\big(\iota_{F,{\rm PSS}}^{*}T\mathbb{CP}^{d},u^{*}TM\oplus\bigoplus_{j=1}^{i-1}\tilde{u}^{*}E_{j}\big)\otimes\iota_{F,{\rm PSS}}^{*}{\mathcal{O}}(k_{i})\right)\otimes\overline{H^{0}(\iota_{F,{\rm PSS}}^{*}{\mathcal{O}}(k_{i}))_{0}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS2.p4.4" class="ltx_p">satisfying the following equations</p>
<table id="S7.E3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E3.m1" class="ltx_math_unparsed" alttext="\left\{\begin{aligned} \overline{\partial}_{J,H^{\rm PSS}}u+\pi_{u^{*}TM}\left(\sum_{i=1}^{d}\langle\eta_{i}\rangle\circ d\iota_{F,{\rm PSS}}\right)&amp;\ =0,\\
\overline{\partial}\eta_{i}+\pi_{E_{i}}\left(\sum_{j=i+1}^{d}\langle\eta_{j}\rangle\circ d\iota_{F,{\rm PSS}}\right)&amp;\ =0,\ i=1,\ldots,d,\end{aligned}\right." display="block" intent=":literal"><semantics><mrow><mo>{</mo><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><msub><mover accent="true"><mo>∂</mo><mo stretchy="true">¯</mo></mover><mrow><mi>J</mi><mo>,</mo><msup><mi>H</mi><mi>PSS</mi></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo>+</mo><mrow><msub><mi>π</mi><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><munderover><mo lspace="0em" movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><mrow><mo stretchy="false">⟨</mo><msub><mi>η</mi><mi>i</mi></msub><mo rspace="0.055em" stretchy="false">⟩</mo></mrow></mrow><mo rspace="0.222em">∘</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ι</mi><mrow><mi>F</mi><mo>,</mo><mi>PSS</mi></mrow></msub></mrow><mo>)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo lspace="0.778em">=</mo><mn>0</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mover accent="true"><mo>∂</mo><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>i</mi></msub></mrow><mo>+</mo><mrow><msub><mi>π</mi><msub><mi>E</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><munderover><mo lspace="0em" movablelimits="false" rspace="0em">∑</mo><mrow><mi>j</mi><mo>=</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi>d</mi></munderover><mrow><mo stretchy="false">⟨</mo><msub><mi>η</mi><mi>j</mi></msub><mo rspace="0.055em" stretchy="false">⟩</mo></mrow></mrow><mo rspace="0.222em">∘</mo><mi>d</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ι</mi><mrow><mi>F</mi><mo>,</mo><mi>PSS</mi></mrow></msub></mrow><mo>)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>=</mo><mn>0</mn><mo rspace="0.667em">,</mo><mi>i</mi><mo>=</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>d</mi><mo>,</mo></mrow></mtd></mtr></mtable></mrow><annotation encoding="application/x-tex">\left\{\begin{aligned} \overline{\partial}_{J,H^{\rm PSS}}u+\pi_{u^{*}TM}\left(\sum_{i=1}^{d}\langle\eta_{i}\rangle\circ d\iota_{F,{\rm PSS}}\right)&amp;\ =0,\\
\overline{\partial}\eta_{i}+\pi_{E_{i}}\left(\sum_{j=i+1}^{d}\langle\eta_{j}\rangle\circ d\iota_{F,{\rm PSS}}\right)&amp;\ =0,\ i=1,\ldots,d,\end{aligned}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7.3)</span></td></tr></tbody>
</table>
<p id="S7.SS1.SSS2.p4.5" class="ltx_p">where <math id="S7.SS1.SSS2.p4.m17" class="ltx_Math" alttext="E_{i}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>i</mi></msub><annotation encoding="application/x-tex">E_{i}</annotation></semantics></math> is defined in the same way as (<a href="#S5.E31" title="In 5.3.3. Multi-layered thickening ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.31</span></a>), and the <math id="S7.SS1.SSS2.p4.m18" class="ltx_Math" alttext="\overline{\partial}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>∂</mo><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{\partial}</annotation></semantics></math>-operator <math id="S7.SS1.SSS2.p4.m19" class="ltx_Math" alttext="\overline{\partial}_{J,H^{\rm PSS}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mo>∂</mo><mo stretchy="true">¯</mo></mover><mrow><mi>J</mi><mo>,</mo><msup><mi>H</mi><mi>PSS</mi></msup></mrow></msub><annotation encoding="application/x-tex">\overline{\partial}_{J,H^{\rm PSS}}</annotation></semantics></math> is read off from the PSS equation <a href="#S4.E6" title="In 4.3.1. Moduli spaces ‣ 4.3. PSS and SSP bimodules ‣ 4. Proof of the integral Arnold conjecture ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.6</span></a>.</p>
</div>
<div id="S7.SS1.SSS2.p5" class="ltx_para">
<p id="S7.SS1.SSS2.p5.1" class="ltx_p">By replacing PSS with SSP, we can similarly define the thickened moduli space <math id="S7.SS1.SSS2.p5.m1" class="ltx_math_unparsed" alttext="V_{p\bullet}^{\rm SSP}=V_{p\bullet}^{\rm SSP}(k_{1},\dots,k_{d})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>V</mi><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow><mi>SSP</mi></msubsup><mo>=</mo><msubsup><mi>V</mi><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow><mi>SSP</mi></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>k</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V_{p\bullet}^{\rm SSP}=V_{p\bullet}^{\rm SSP}(k_{1},\dots,k_{d})</annotation></semantics></math> for a capped orbit <math id="S7.SS1.SSS2.p5.m2" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>.</p>
</div>
<div id="S7.SS1.SSS2.p6" class="ltx_para">
<p id="S7.SS1.SSS2.p6.1" class="ltx_p">The space <math id="S7.SS1.SSS2.p6.m1" class="ltx_Math" alttext="V_{\bullet q}^{\rm PSS}" display="inline" intent=":literal"><semantics><msubsup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><annotation encoding="application/x-tex">V_{\bullet q}^{\rm PSS}</annotation></semantics></math> (resp. <math id="S7.SS1.SSS2.p6.m2" class="ltx_math_unparsed" alttext="V_{p\bullet}^{\rm SSP}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow></msub><msup><mrow></mrow><mi>SSP</mi></msup></mrow><annotation encoding="application/x-tex">V_{p\bullet}^{\rm SSP}</annotation></semantics></math>) admits a <math id="S7.SS1.SSS2.p6.m3" class="ltx_Math" alttext="G_{\bullet q}^{\rm PSS}=G_{d_{\bullet q}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>G</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><mo>=</mo><msub><mi>G</mi><msub><mi>d</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow></msub></msub></mrow><annotation encoding="application/x-tex">G_{\bullet q}^{\rm PSS}=G_{d_{\bullet q}}</annotation></semantics></math> (resp. <math id="S7.SS1.SSS2.p6.m4" class="ltx_math_unparsed" alttext="G_{p\bullet}^{\rm SSP}=G_{d_{p\bullet}}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow></msub><msup><mrow></mrow><mi>SSP</mi></msup><mo>=</mo><mi>G</mi><msub><mrow></mrow><mrow><mi>d</mi><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow></msub></mrow></msub></mrow><annotation encoding="application/x-tex">G_{p\bullet}^{\rm SSP}=G_{d_{p\bullet}}</annotation></semantics></math>) action extending the action on the framing. The obstruction bundle over <math id="S7.SS1.SSS2.p6.m5" class="ltx_Math" alttext="E_{\bullet q}^{\rm PSS}\to V_{\bullet q}^{\bullet}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>E</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><mo stretchy="false">→</mo><msubsup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mo>∙</mo></msubsup></mrow><annotation encoding="application/x-tex">E_{\bullet q}^{\rm PSS}\to V_{\bullet q}^{\bullet}</annotation></semantics></math> also has a direct sum decomposition</p>
<table id="S7.Ex27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex27.m1" class="ltx_Math" alttext="E_{\bullet q}^{\rm PSS}=O_{\bullet q}^{\rm PSS}\oplus Q_{\bullet q}^{\rm PSS}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>E</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><mo>=</mo><mrow><msubsup><mi>O</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><mo>⊕</mo><msubsup><mi>Q</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">E_{\bullet q}^{\rm PSS}=O_{\bullet q}^{\rm PSS}\oplus Q_{\bullet q}^{\rm PSS}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS2.p6.2" class="ltx_p">where <math id="S7.SS1.SSS2.p6.m6" class="ltx_Math" alttext="O_{\bullet q}^{\rm PSS}" display="inline" intent=":literal"><semantics><msubsup><mi>O</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><annotation encoding="application/x-tex">O_{\bullet q}^{\rm PSS}</annotation></semantics></math> is specified by (<a href="#S5.E33" title="In 5.3.3. Multi-layered thickening ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.33</span></a>), and <math id="S7.SS1.SSS2.p6.m7" class="ltx_Math" alttext="Q_{\bullet q}^{\rm PSS}" display="inline" intent=":literal"><semantics><msubsup><mi>Q</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><annotation encoding="application/x-tex">Q_{\bullet q}^{\rm PSS}</annotation></semantics></math> is the trivial vector bundle from <math id="S7.SS1.SSS2.p6.m8" class="ltx_Math" alttext="{\bm{Q}}_{d_{\bullet q}}" display="inline" intent=":literal"><semantics><msub><mi>𝑸</mi><msub><mi>d</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow></msub></msub><annotation encoding="application/x-tex">{\bm{Q}}_{d_{\bullet q}}</annotation></semantics></math> as in (<a href="#S5.E12" title="In 5.2.5. Boundary strata of the auxiliary moduli spaces ‣ 5.2. Global chart construction I ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.12</span></a>). This is a <math id="S7.SS1.SSS2.p6.m9" class="ltx_Math" alttext="G^{\rm PSS}_{\bullet q}" display="inline" intent=":literal"><semantics><msubsup><mi>G</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><annotation encoding="application/x-tex">G^{\rm PSS}_{\bullet q}</annotation></semantics></math>-equivariant vector bundle. As for the Kuranishi section, it is defined by</p>
<table id="S7.Ex28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex28.m1" class="ltx_Math" alttext="\begin{split}S_{\bullet q}^{\rm PSS}:V_{\bullet q}^{\rm PSS}&amp;\ \to E_{\bullet q}^{\rm PSS}\\
[\Sigma,u,F,\eta]&amp;\ \mapsto(\eta,H_{F})\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><msubsup><mi>S</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><msubsup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo lspace="0.778em" stretchy="false">→</mo><msubsup><mi>E</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>F</mi><mo>,</mo><mi>η</mi></mrow><mo stretchy="false">]</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo lspace="0.778em" stretchy="false">↦</mo><mrow><mo stretchy="false">(</mo><mi>η</mi><mo>,</mo><msub><mi>H</mi><mi>F</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}S_{\bullet q}^{\rm PSS}:V_{\bullet q}^{\rm PSS}&amp;\ \to E_{\bullet q}^{\rm PSS}\\
[\Sigma,u,F,\eta]&amp;\ \mapsto(\eta,H_{F})\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS2.p6.3" class="ltx_p">where <math id="S7.SS1.SSS2.p6.m10" class="ltx_Math" alttext="H_{F}\in Q_{\bullet q}^{\rm PSS}" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mi>F</mi></msub><mo>∈</mo><msubsup><mi>Q</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup></mrow><annotation encoding="application/x-tex">H_{F}\in Q_{\bullet q}^{\rm PSS}</annotation></semantics></math> is represented by the Hermitian matrix whose entries are</p>
<table id="S7.Ex29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex29.m1" class="ltx_Math" alttext="\int_{\Sigma}\langle f_{i},f_{j}\rangle_{L_{u,{\rm PSS}}}\Omega_{u,{\rm PSS}}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mo>∫</mo><mi mathvariant="normal">Σ</mi></msub><mrow><msub><mrow><mo lspace="0em" stretchy="false">⟨</mo><mrow><msub><mi>f</mi><mi>i</mi></msub><mo>,</mo><msub><mi>f</mi><mi>j</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><msub><mi>L</mi><mrow><mi>u</mi><mo>,</mo><mi>PSS</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Ω</mi><mrow><mi>u</mi><mo>,</mo><mi>PSS</mi></mrow></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\int_{\Sigma}\langle f_{i},f_{j}\rangle_{L_{u,{\rm PSS}}}\Omega_{u,{\rm PSS}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS2.p6.4" class="ltx_p">where <math id="S7.SS1.SSS2.p6.m11" class="ltx_Math" alttext="f_{0},\dots,f_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">f_{0},\dots,f_{d}</annotation></semantics></math> is a basis representing the frame <math id="S7.SS1.SSS2.p6.m12" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>. It is obvious that there exists a homeomorphism</p>
<table id="S7.Ex30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex30.m1" class="ltx_math_unparsed" alttext="\psi_{\bullet q}^{\rm PSS}:(S_{\bullet q}^{\rm PSS})^{-1}(0)/G^{\rm PSS}_{\bullet q}\xrightarrow{\sim}\overline{\mathcal{M}}{}_{\bullet q}^{\rm PSS}." display="block" intent=":literal"><semantics><mrow><msubsup><mi>ψ</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>S</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>/</mo><msubsup><mi>G</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><mover accent="true"><mo>→</mo><mo mathsize="0.700em">∼</mo></mover><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><mmultiscripts><mo lspace="0em">.</mo><mrow></mrow><mi>PSS</mi><mprescripts></mprescripts><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mrow></mrow></mmultiscripts></mrow><annotation encoding="application/x-tex">\psi_{\bullet q}^{\rm PSS}:(S_{\bullet q}^{\rm PSS})^{-1}(0)/G^{\rm PSS}_{\bullet q}\xrightarrow{\sim}\overline{\mathcal{M}}{}_{\bullet q}^{\rm PSS}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS2.p6.5" class="ltx_p">This finishes the description of the K-chart</p>
<table id="S7.Ex31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex31.m1" class="ltx_Math" alttext="K_{\bullet q}^{\rm PSS}:=K_{\bullet q}^{\rm PSS}(k_{1},\ldots,k_{d}):=(G^{\rm PSS}_{\bullet q},V_{\bullet q}^{\rm PSS},E^{\rm PSS}_{\bullet q},S_{\bullet q}^{\rm PSS},\psi_{\bullet q}^{\rm PSS})." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>K</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><mo>:=</mo><mrow><msubsup><mi>K</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>k</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>G</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><mo>,</mo><msubsup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><mo>,</mo><msubsup><mi>E</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><mo>,</mo><msubsup><mi>S</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><mo>,</mo><msubsup><mi>ψ</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">K_{\bullet q}^{\rm PSS}:=K_{\bullet q}^{\rm PSS}(k_{1},\ldots,k_{d}):=(G^{\rm PSS}_{\bullet q},V_{\bullet q}^{\rm PSS},E^{\rm PSS}_{\bullet q},S_{\bullet q}^{\rm PSS},\psi_{\bullet q}^{\rm PSS}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS2.p6.6" class="ltx_p">The same description applies to the SSP moduli space and we obtain the K-chart</p>
<table id="S7.Ex32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex32.m1" class="ltx_math_unparsed" alttext="K_{p\bullet}^{\rm SSP}:=K_{p\bullet}^{\rm SSP}=(G^{\rm SSP}_{p\bullet},V_{p\bullet}^{\rm SSP},E_{p\bullet}^{\rm SSP},S_{p\bullet}^{\rm SSP},\psi_{p\bullet}^{\rm SSP})" display="block" intent=":literal"><semantics><mrow><msubsup><mi>K</mi><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow><mi>SSP</mi></msubsup><mo>:=</mo><msubsup><mi>K</mi><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow><mi>SSP</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>G</mi><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow><mi>SSP</mi></msubsup><mo>,</mo><msubsup><mi>V</mi><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow><mi>SSP</mi></msubsup><mo>,</mo><msubsup><mi>E</mi><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow><mi>SSP</mi></msubsup><mo>,</mo><msubsup><mi>S</mi><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow><mi>SSP</mi></msubsup><mo>,</mo><msubsup><mi>ψ</mi><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow><mi>SSP</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K_{p\bullet}^{\rm SSP}:=K_{p\bullet}^{\rm SSP}=(G^{\rm SSP}_{p\bullet},V_{p\bullet}^{\rm SSP},E_{p\bullet}^{\rm SSP},S_{p\bullet}^{\rm SSP},\psi_{p\bullet}^{\rm SSP})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS2.p6.7" class="ltx_p">for the moduli space <math id="S7.SS1.SSS2.p6.m13" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{p\bullet}^{\rm SSP}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow></msub><msup><mrow></mrow><mi>SSP</mi></msup></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{p\bullet}^{\rm SSP}</annotation></semantics></math>.</p>
</div>
<div id="S7.SS1.SSS2.p7" class="ltx_para">
<p id="S7.SS1.SSS2.p7.1" class="ltx_p">The following statement follows from the proof of Theorem <a href="#S5.Thmthm47" title="Theorem 5.47. ‣ 5.3.4. Regularity for the multi-layered thickening ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.47</span></a>.</p>
</div>
<div id="S7.Thmthm5" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm5.2" class="ltx_text ltx_font_bold">Proposition 7.5</span></span><span id="S7.Thmthm5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm5.p1" class="ltx_para">
<p id="S7.Thmthm5.p1.1" class="ltx_p"><span id="S7.Thmthm5.p1.1.1" class="ltx_text ltx_font_italic">For fixed <math id="S7.Thmthm5.p1.m1" class="ltx_Math" alttext="k_{1},\dots,k_{d-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>k</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>k</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">k_{1},\dots,k_{d-1}</annotation></semantics></math>, as long as <math id="S7.Thmthm5.p1.m2" class="ltx_Math" alttext="k_{d}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>d</mi></msub><annotation encoding="application/x-tex">k_{d}</annotation></semantics></math> is sufficiently large, the thickened moduli spaces <math id="S7.Thmthm5.p1.m3" class="ltx_Math" alttext="V_{\bullet q}^{\rm PSS}=V_{\bullet q}^{\rm PSS}(k_{1},\ldots,k_{d})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><mo>=</mo><mrow><msubsup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>k</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">V_{\bullet q}^{\rm PSS}=V_{\bullet q}^{\rm PSS}(k_{1},\ldots,k_{d})</annotation></semantics></math> and <math id="S7.Thmthm5.p1.m4" class="ltx_math_unparsed" alttext="V_{p\bullet}^{\rm SSP}=V_{p\bullet}^{\rm SSP}(k_{1},\ldots,k_{d})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>V</mi><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow><mi>SSP</mi></msubsup><mo>=</mo><msubsup><mi>V</mi><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow><mi>SSP</mi></msubsup><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>k</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V_{p\bullet}^{\rm SSP}=V_{p\bullet}^{\rm SSP}(k_{1},\ldots,k_{d})</annotation></semantics></math> is regular near the zero locus of the Kuranishi section and <math id="S7.Thmthm5.p1.m5" class="ltx_Math" alttext="E_{\bullet q}^{\rm PSS}\to V_{\bullet q}^{\rm PSS}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>E</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><mo stretchy="false">→</mo><msubsup><mi>V</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup></mrow><annotation encoding="application/x-tex">E_{\bullet q}^{\rm PSS}\to V_{\bullet q}^{\rm PSS}</annotation></semantics></math>, <math id="S7.Thmthm5.p1.m6" class="ltx_math_unparsed" alttext="E_{p\bullet}^{\rm SSP}\to V_{p\bullet}^{\rm SSP}" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow></msub><msup><mrow></mrow><mi>SSP</mi></msup><mo stretchy="false">→</mo><mi>V</mi><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow></msub><msup><mrow></mrow><mi>SSP</mi></msup></mrow><annotation encoding="application/x-tex">E_{p\bullet}^{\rm SSP}\to V_{p\bullet}^{\rm SSP}</annotation></semantics></math> are indeed vector bundles. ∎</span></p>
</div>
</div>
</section>
<section id="S7.SS1.SSS3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">7.1.3. </span>The K-chart lift of the flow bimodule</h4>

<div id="S7.SS1.SSS3.p1" class="ltx_para">
<p id="S7.SS1.SSS3.p1.1" class="ltx_p">We would like the system of K-charts obtained above provide a K-chart lift of the flow bimodule <math id="S7.SS1.SSS3.p1.m1" class="ltx_Math" alttext="M^{\rm PSS}" display="inline" intent=":literal"><semantics><msup><mi>M</mi><mi>PSS</mi></msup><annotation encoding="application/x-tex">M^{\rm PSS}</annotation></semantics></math> resp. <math id="S7.SS1.SSS3.p1.m2" class="ltx_Math" alttext="M^{\rm SSP}" display="inline" intent=":literal"><semantics><msup><mi>M</mi><mi>SSP</mi></msup><annotation encoding="application/x-tex">M^{\rm SSP}</annotation></semantics></math>. Still we describe the PSS case with more details. Recall that the moduli space (<a href="#S4.E7" title="In 4.3.1. Moduli spaces ‣ 4.3. PSS and SSP bimodules ‣ 4. Proof of the integral Arnold conjecture ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.7</span></a>) is a <math id="S7.SS1.SSS3.p1.m3" class="ltx_Math" alttext="{\mathbb{A}}^{\rm PSS}_{\bullet q}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔸</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup><annotation encoding="application/x-tex">{\mathbb{A}}^{\rm PSS}_{\bullet q}</annotation></semantics></math>-space. Given a stratum <math id="S7.SS1.SSS3.p1.m4" class="ltx_math_unparsed" alttext="\alpha=\bullet r_{1}\cdots r_{l}q" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo rspace="0em">=</mo><mo lspace="0em" rspace="0.222em">∙</mo><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>l</mi></msub><mi>q</mi></mrow><annotation encoding="application/x-tex">\alpha=\bullet r_{1}\cdots r_{l}q</annotation></semantics></math>, the moduli space</p>
<table id="S7.Ex33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex33.m1" class="ltx_math_unparsed" alttext="\partial^{\alpha}\overline{\mathcal{M}}{}_{\bullet q}^{\rm PSS}=\overline{\mathcal{M}}{}_{\bullet r_{1}}^{\rm PSS}\times\overline{\mathcal{M}}{}_{r_{1}r_{2}}^{\rm Floer}\times\cdots\times\overline{\mathcal{M}}{}^{{\rm Floer}}_{r_{l}q}" display="block" intent=":literal"><semantics><mrow><mo>∂</mo><msup><mrow></mrow><mi>α</mi></msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow></msub><msup><mrow></mrow><mi>PSS</mi></msup><mo>=</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></msub><msup><mrow></mrow><mi>PSS</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><msub><mi>r</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>2</mn></msub></mrow></msub><msup><mrow></mrow><mi>Floer</mi></msup><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msup><mrow></mrow><mi>Floer</mi></msup><msub><mrow></mrow><mrow><msub><mi>r</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\partial^{\alpha}\overline{\mathcal{M}}{}_{\bullet q}^{\rm PSS}=\overline{\mathcal{M}}{}_{\bullet r_{1}}^{\rm PSS}\times\overline{\mathcal{M}}{}_{r_{1}r_{2}}^{\rm Floer}\times\cdots\times\overline{\mathcal{M}}{}^{{\rm Floer}}_{r_{l}q}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS3.p1.2" class="ltx_p">has a product K-chart</p>
<table id="S7.Ex34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex34.m1" class="ltx_math_unparsed" alttext="K_{\alpha}^{\rm PSS}:=K_{\bullet r_{1}}^{\rm PSS}\times K_{r_{1}r_{2}}\times\cdots\times K_{r_{l}q}" display="block" intent=":literal"><semantics><mrow><mi>K</mi><msub><mrow></mrow><mi>α</mi></msub><msup><mrow></mrow><mi>PSS</mi></msup><mo>:=</mo><mi>K</mi><msub><mrow></mrow><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></msub><msup><mrow></mrow><mi>PSS</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>K</mi><msub><mrow></mrow><mrow><msub><mi>r</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>2</mn></msub></mrow></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi>K</mi><msub><mrow></mrow><mrow><msub><mi>r</mi><mi>l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">K_{\alpha}^{\rm PSS}:=K_{\bullet r_{1}}^{\rm PSS}\times K_{r_{1}r_{2}}\times\cdots\times K_{r_{l}q}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS3.p1.3" class="ltx_p">where <math id="S7.SS1.SSS3.p1.m5" class="ltx_Math" alttext="K_{r_{i}r_{i+1}}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mrow><msub><mi>r</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></msub><annotation encoding="application/x-tex">K_{r_{i}r_{i+1}}</annotation></semantics></math> is the K-chart constructed in (<a href="#S5.E37" title="In 5.3.3. Multi-layered thickening ‣ 5.3. Global chart construction II ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.37</span></a>) for <math id="S7.SS1.SSS3.p1.m6" class="ltx_math_unparsed" alttext="\overline{\mathcal{M}}{}_{r_{i}r_{i+1}}^{\rm Floer}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><msub><mi>r</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></msub><msup><mrow></mrow><mi>Floer</mi></msup></mrow><annotation encoding="application/x-tex">\overline{\mathcal{M}}{}_{r_{i}r_{i+1}}^{\rm Floer}</annotation></semantics></math>. Similarly, for <math id="S7.SS1.SSS3.p1.m7" class="ltx_math_unparsed" alttext="\alpha=pr_{1}\cdots r_{l}\bullet" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mi>p</mi><mi>r</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>r</mi><msub><mrow></mrow><mi>l</mi></msub><mo lspace="0.222em">∙</mo></mrow><annotation encoding="application/x-tex">\alpha=pr_{1}\cdots r_{l}\bullet</annotation></semantics></math>, the moduli space</p>
<table id="S7.Ex35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex35.m1" class="ltx_math_unparsed" alttext="\partial^{\alpha}\overline{\mathcal{M}}{}_{p\bullet}^{\rm SSP}=\overline{\mathcal{M}}{}^{\rm Floer}_{pr_{1}}\times\cdots\times\overline{\mathcal{M}}{}_{r_{l-1}r_{l}}^{\rm Floer}\times\overline{\mathcal{M}}{}^{\rm SSP}_{r_{l}\bullet}" display="block" intent=":literal"><semantics><mrow><mo>∂</mo><msup><mrow></mrow><mi>α</mi></msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow></msub><msup><mrow></mrow><mi>SSP</mi></msup><mo>=</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msup><mrow></mrow><mi>Floer</mi></msup><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><msub><mi>r</mi><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>l</mi></msub></mrow></msub><msup><mrow></mrow><mi>Floer</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="true">¯</mo></mover><msup><mrow></mrow><mi>SSP</mi></msup><msub><mrow></mrow><mrow><mi>r</mi><msub><mrow></mrow><mi>l</mi></msub><mo lspace="0.222em">∙</mo></mrow></msub></mrow><annotation encoding="application/x-tex">\partial^{\alpha}\overline{\mathcal{M}}{}_{p\bullet}^{\rm SSP}=\overline{\mathcal{M}}{}^{\rm Floer}_{pr_{1}}\times\cdots\times\overline{\mathcal{M}}{}_{r_{l-1}r_{l}}^{\rm Floer}\times\overline{\mathcal{M}}{}^{\rm SSP}_{r_{l}\bullet}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS3.p1.4" class="ltx_p">has a product K-chart</p>
<table id="S7.Ex36" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex36.m1" class="ltx_math_unparsed" alttext="K_{\alpha}^{\rm SSP}:=K_{pr_{1}}\times\cdots\times K_{r_{l-1}r_{l}}\times K_{r_{l}\bullet}^{\rm SSP}." display="block" intent=":literal"><semantics><mrow><mi>K</mi><msub><mrow></mrow><mi>α</mi></msub><msup><mrow></mrow><mi>SSP</mi></msup><mo>:=</mo><mi>K</mi><msub><mrow></mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>1</mn></msub></mrow></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><mi>K</mi><msub><mrow></mrow><mrow><msub><mi>r</mi><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>l</mi></msub></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>K</mi><msub><mrow></mrow><mrow><mi>r</mi><msub><mrow></mrow><mi>l</mi></msub><mo lspace="0.222em">∙</mo></mrow></msub><msup><mrow></mrow><mi>SSP</mi></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">K_{\alpha}^{\rm SSP}:=K_{pr_{1}}\times\cdots\times K_{r_{l-1}r_{l}}\times K_{r_{l}\bullet}^{\rm SSP}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS3.p1.5" class="ltx_p">Recall that the flow category <math id="S7.SS1.SSS3.p1.m8" class="ltx_Math" alttext="T^{\rm Floer}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi>Floer</mi></msup><annotation encoding="application/x-tex">T^{\rm Floer}</annotation></semantics></math> is endowed with a weak K-chart lift as from Theorem <a href="#S5.Thmthm11" title="Theorem 5.11. ‣ 5.1.5. The main statement ‣ 5.1. Basic notions and the main theorem about global charts ‣ 5. Global Kuranishi charts on Floer moduli spaces ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.11</span></a> of the form</p>
<table id="S7.Ex37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex37.m1" class="ltx_math_unparsed" alttext="\big\{K_{pq}=(G_{pq},V_{pq},E_{pq},S_{pq},\psi_{pq})\big\}_{p&lt;q}," display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">{</mo><msub><mi>K</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi>V</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi>E</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi>S</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo>,</mo><msub><mi>ψ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>p</mi><mo>&lt;</mo><mi>q</mi></mrow></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">\big\{K_{pq}=(G_{pq},V_{pq},E_{pq},S_{pq},\psi_{pq})\big\}_{p&lt;q},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.SSS3.p1.6" class="ltx_p">together with the collection of weak K-chart embeddings</p>
<table id="S7.Ex38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex38.m1" class="ltx_Math" alttext="\big\{{\bm{\iota}}_{prq}:K_{pr}\times K_{rq}\rightharpoonup\partial^{prq}K_{pq}\big\}_{p&lt;r&lt;q}." display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">{</mo><msub><mi>𝜾</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>K</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>K</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo rspace="0.111em" stretchy="false">⇀</mo><mrow><msup><mo>∂</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msup><msub><mi>K</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>p</mi><mo>&lt;</mo><mi>r</mi><mo>&lt;</mo><mi>q</mi></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\big\{{\bm{\iota}}_{prq}:K_{pr}\times K_{rq}\rightharpoonup\partial^{prq}K_{pq}\big\}_{p&lt;r&lt;q}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S7.Thmthm6" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm6.2" class="ltx_text ltx_font_bold">Theorem 7.6</span></span><span id="S7.Thmthm6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm6.p1" class="ltx_para">
<p id="S7.Thmthm6.p1.1" class="ltx_p"><span id="S7.Thmthm6.p1.1.1" class="ltx_text ltx_font_italic">For a capped <math id="S7.Thmthm6.p1.m1" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>-periodic orbits <math id="S7.Thmthm6.p1.m2" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> resp. <math id="S7.Thmthm6.p1.m3" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>, there exist a collection of weak K-chart embeddings</span></p>
<table id="S7.Ex39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex39.m1" class="ltx_Math" alttext="\big\{{\bm{\iota}}_{\bullet rq}:K_{\bullet r}^{\rm PSS}\times K_{rq}\rightharpoonup\partial^{\bullet rq}K_{\bullet q}^{\rm PSS}\big\}_{r&lt;q}" display="block" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mi>𝜾</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mi>K</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>r</mi></mrow><mi>PSS</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>K</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><mo rspace="0.111em" stretchy="false">⇀</mo><mrow><msup><mo>∂</mo><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow></msup><msubsup><mi>K</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∙</mo><mi>q</mi></mrow><mi>PSS</mi></msubsup></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>r</mi><mo>&lt;</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\big\{{\bm{\iota}}_{\bullet rq}:K_{\bullet r}^{\rm PSS}\times K_{rq}\rightharpoonup\partial^{\bullet rq}K_{\bullet q}^{\rm PSS}\big\}_{r&lt;q}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="S7.Ex40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex40.m1" class="ltx_math_unparsed" alttext="\text{resp. }\big\{{\bm{\iota}}_{pr\bullet}:K_{pr}\times K^{\rm SSP}_{r\bullet}\rightharpoonup\partial^{pr\bullet}K_{p\bullet}^{\rm SSP}\big\}_{p&lt;r}," display="block" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_italic">resp. </mtext><msub><mrow><mo stretchy="false">{</mo><msub><mi>𝜾</mi><mrow><mi>p</mi><mi>r</mi><mo lspace="0.222em">∙</mo></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi>K</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msubsup><mi>K</mi><mrow><mi>r</mi><mo lspace="0.222em">∙</mo></mrow><mi>SSP</mi></msubsup><mo rspace="0.111em" stretchy="false">⇀</mo><msup><mo>∂</mo><mrow><mi>p</mi><mi>r</mi><mo lspace="0.222em">∙</mo></mrow></msup><msubsup><mi>K</mi><mrow><mi>p</mi><mo lspace="0.222em">∙</mo></mrow><mi>SSP</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>p</mi><mo>&lt;</mo><mi>r</mi></mrow></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">\text{resp. }\big\{{\bm{\iota}}_{pr\bullet}:K_{pr}\times K^{\rm SSP}_{r\bullet}\rightharpoonup\partial^{pr\bullet}K_{p\bullet}^{\rm SSP}\big\}_{p&lt;r},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.Thmthm6.p1.2" class="ltx_p"><span id="S7.Thmthm6.p1.2.1" class="ltx_text ltx_font_italic">such that the following statements are true.</span></p>
<ol id="S7.I5" class="ltx_enumerate">
<li id="S7.I5.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S7.I5.i1.p1" class="ltx_para">
<p id="S7.I5.i1.p1.1" class="ltx_p"><span id="S7.I5.i1.p1.1.1" class="ltx_text ltx_font_italic">The following diagrams are commutative under the chart embeddings:</span></p>
<table id="S7.Ex41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
