4637 L 31.59888935102307 -44.24844026334622" fill="none" stroke="#000000"></path><g transform="translate(65.98,0) translate(0,-44.53)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 31.59888935102307 -44.80191182344637 L 65.97512322902614 -44.24844026334622" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 65.97512322902614 -44.80191182344637 L 65.97512322902614 -44.24844026334622" fill="none" stroke="#000000"></path><g transform="translate(65.98,0) translate(0,-44.53) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:3.38em;--ltx-fo-height:0.84em;--ltx-fo-depth:0.29em;font-size:10pt;" height="15.6" overflow="visible" transform="matrix(1 0 0 -1 0 11.64)" width="46.79"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex19.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{\partial^{prq}{\mathbb{A}}_{pq}^{\mathcal{P}}}" display="inline" intent=":literal"><semantics><mrow><msup><mo>∂</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msup><msubsup><mi>𝔸</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msubsup></mrow><annotation encoding="application/x-tex">\textstyle{\partial^{prq}{\mathbb{A}}_{pq}^{\mathcal{P}}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I4.i4.p1.2" class="ltx_p">where the underlying poset isomorphism is the map (<a href="#S3.E3" title="In Notation 3.6. ‣ 3.2. Topological flow categories and bimodules ‣ 3. Abstract constructions of chain complexes and maps over the integers ‣ Arnold Conjecture over Integers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a>). We require that whenever <math id="S3.I4.i4.p1.m3" class="ltx_Math" alttext="p&lt;r&lt;s&lt;q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mi>r</mi><mo>&lt;</mo><mi>s</mi><mo>&lt;</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">p&lt;r&lt;s&lt;q</annotation></semantics></math>, the following associativity diagram holds:</p>
<table id="S3.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S3.Ex20.m1.pic1" class="ltx_picture ltx_markedasmath" height="71.99" overflow="visible" style="vertical-align:-36px" version="1.1" viewBox="0 0 233.73 71.99" width="233.73"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,71.99) matrix(1 0 0 -1 0 0) translate(116.87,0) translate(0,36)"><g stroke-width="0.4pt" transform="matrix(1.0 0.0 0.0 1.0 -116.86 -26.97)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 71.99)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 14.52)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 0 0) translate(58.98,0) matrix(1.0 0.0 0.0 1.0 -53.02 0)"><foreignObject style="--ltx-fo-width:6.66em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.29em;font-size:10pt;" height="13.41" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="92.21"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex20.m1.pic1.m1" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces T_{pr}\times T_{rs}\times T_{sq}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>T</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>T</mi><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces T_{pr}\times T_{rs}\times T_{sq}}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" tran