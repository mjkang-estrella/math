oke="#000000"></path><g transform="translate(40.85,0) translate(0,-12.45) translate(4.15,0) translate(0,-2.53)"><foreignObject style="--ltx-fo-width:2.97em;--ltx-fo-height:0.64em;--ltx-fo-depth:0.28em;font-size:10pt;" height="12.75" overflow="visible" transform="matrix(1 0 0 -1 0 8.9)" width="41.15"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Ex74.m1.pic1.m4" class="ltx_Math" alttext="\scriptstyle{{\bm{\iota}}^{M}_{pqq^{\prime}}\times{\rm id}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathsize="0.700em">𝜾</mi><mrow><mi mathsize="0.710em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">q</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.710em">q</mi><mo>′</mo></msup></mrow><mi mathsize="0.710em">M</mi></msubsup><mo lspace="0.222em" mathsize="0.700em" rspace="0.222em">×</mo><mi mathsize="0.700em">id</mi></mrow><annotation encoding="application/x-tex">\scriptstyle{{\bm{\iota}}^{M}_{pqq^{\prime}}\times{\rm id}}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(42.2,0) translate(0,-33.21)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 7.44 -0.49" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 5.72 4.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 105.0747198007472 -12.746990114652519 L 42.20344160245434 -33.20877921850137" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 42.20344160245434 -33.184815297668464 L 42.20344160245434 -33.20877921850137" fill="none" stroke="#000000"></path><g transform="translate(-53.54,0) translate(0,-46.94) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:7.14em;--ltx-fo-height:0.94em;--ltx-fo-depth:0.37em;font-size:10pt;" height="18.18" overflow="visible" transform="matrix(1 0 0 -1 0 13.04)" width="98.78"><span cla