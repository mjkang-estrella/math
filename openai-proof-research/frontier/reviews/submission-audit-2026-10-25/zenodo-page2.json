ess_grants": "https://zenodo.org/api/records/23647127/access/grants", "access_users": "https://zenodo.org/api/records/23647127/access/users", "access_request": "https://zenodo.org/api/records/23647127/access/request", "access": "https://zenodo.org/api/records/23647127/access", "communities": "https://zenodo.org/api/records/23647127/communities", "communities-suggestions": "https://zenodo.org/api/records/23647127/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23647127/request-deletion", "file_modification": "https://zenodo.org/api/records/23647127/file-modification", "quota_increase": "https://zenodo.org/api/records/23647127/quota-increase", "requests": "https://zenodo.org/api/records/23647127/requests"}, "updated": "2026-10-25T17:36:23.394195+00:00", "recid": "23647127", "revision": 3, "files": [{"id": "ce589383-a188-4e0d-8d8e-ffa4370bb707", "key": "r041-main.pdf", "size": 164552, "checksum": "md5:0f765c8d10a606d292cafe2fc6c88568", "links": {"self": "https://zenodo.org/api/records/23647127/files/r041-main.pdf/content"}}, {"id": "f276a2f5-e376-4ec7-a11c-891434ef6794", "key": "r041-r041-four-polytope-six-facet-projection-v1.zip", "size": 824512, "checksum": "md5:0381c3e6d7003fc8b382b8b39a2314c1", "links": {"self": "https://zenodo.org/api/records/23647127/files/r041-r041-four-polytope-six-facet-projection-v1.zip/content"}}], "swh": null, "owners": [{"id": "1931625"}], "status": "published", "stats": {"downloads": 0, "unique_downloads": 0, "views": 0, "unique_views": 0, "version_downloads": 0, "version_unique_downloads": 0, "version_unique_views": 0, "version_views": 0}, "state": "done", "submitted": true}, {"created": "2026-10-25T17:34:40.619968+00:00", "modified": "2026-10-25T17:34:41.417137+00:00", "id": 23647098, "conceptrecid": "23647097", "doi": "10.5281/zenodo.23647098", "conceptdoi": "10.5281/zenodo.23647097", "doi_url": "https://doi.org/10.5281/zenodo.23647098", "metadata": {"title": "A source-relative factor-two approximation for reverse-complement superstrings", "doi": "10.5281/zenodo.23647098", "publication_date": "2026-10-25", "description": "<p>Assuming the count, periodic-layer and connection lemmas of the pinned ordinary shortest-common-superstring construction of OpenAI, we give a deterministic polynomial-bit-time factor-two algorithm for superstrings with reverse complements. The explicitly encoded alphabet and involution may vary with the input; fixed letters, palindromes, empty requirements, duplicates and containment are included. The extension combines a phase-free 2k+1 count rule for self-reversed periodic texts, adjacent sorted profiles sharing both reflection axes, and an odd core of 2k&minus;1 layers in a 2k-layer budget unit. Established connection and symmetric traversal operations complete the algorithm. This uses stronger structural source lemmas, not merely black-box existence of an ordinary factor-two algorithm.</p>\n<p>&nbsp;</p>\n<p>AI-assisted preprint by Myeongjin Kang, with no affiliation. Internal AI review is not external journal peer review or worldwide-priority certification. Identified OpenAI source inputs at revision fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb are stipulated true. Lean verifies scoped supporting results only, not the full theorem. Original prose: CC BY 4.0; original code and Lean: MIT; third-party rights preserved. See the supporting archive for precise assumptions, coverage, provenance and corrections.</p>", "access_right": "open", "creators": [{"name": "Kang, Myeongjin", "affiliation": null}], "version": "1.0", "resource_type": {"title": "Preprint", "type": "publication", "subtype": "preprint"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23647097"}}]}}, "title": "A source-relative factor-two approximation for reverse-complement superstrings", "links": {"self": "https://zenodo.org/api/records/23647098", "self_html": "https://zenodo.org/records/23647098",