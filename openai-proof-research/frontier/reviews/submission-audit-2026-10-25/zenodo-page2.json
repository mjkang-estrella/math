odo.org/api/records/23647098/access", "communities": "https://zenodo.org/api/records/23647098/communities", "communities-suggestions": "https://zenodo.org/api/records/23647098/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/23647098/request-deletion", "file_modification": "https://zenodo.org/api/records/23647098/file-modification", "quota_increase": "https://zenodo.org/api/records/23647098/quota-increase", "requests": "https://zenodo.org/api/records/23647098/requests"}, "updated": "2026-10-25T17:34:41.417137+00:00", "recid": "23647098", "revision": 4, "files": [{"id": "997816f8-a23c-4526-ab10-b89e8cbe0098", "key": "r035-rcs128-reverse-complement-superstrings-v1.zip", "size": 11362541, "checksum": "md5:de694527f150202abaa76927dd8e3e7d", "links": {"self": "https://zenodo.org/api/records/23647098/files/r035-rcs128-reverse-complement-superstrings-v1.zip/content"}}, {"id": "3529ca42-c7bb-4cc0-9624-4e43dec3556e", "key": "r035-rcs128.pdf", "size": 145648, "checksum": "md5:eebe814ee4b113a29eb15e201c7310d4", "links": {"self": "https://zenodo.org/api/records/23647098/files/r035-rcs128.pdf/content"}}], "swh": null, "owners": [{"id": "1931625"}], "status": "published", "stats": {"downloads": 0, "unique_downloads": 0, "views": 0, "unique_views": 0, "version_downloads": 0, "version_unique_downloads": 0, "version_unique_views": 0, "version_views": 0}, "state": "done", "submitted": true}, {"created": "2026-10-25T17:35:19.280037+00:00", "modified": "2026-10-25T17:35:19.930087+00:00", "id": 23647109, "conceptrecid": "23647108", "doi": "10.5281/zenodo.23647109", "conceptdoi": "10.5281/zenodo.23647108", "doi_url": "https://doi.org/10.5281/zenodo.23647109", "metadata": {"title": "The sharp minimum multiplicity in a staircase tensor square", "doi": "10.5281/zenodo.23647109", "publication_date": "2026-10-25", "description": "<p>For the staircase partition &rho;_m = (m,m&minus;1,&hellip;,1), assuming the specified pinned cyclic-polytabloid source theorems, every irreducible complex representation of S_{m(m+1)/2} other than the trivial and sign representations occurs in the ordinary diagonal tensor square of S^{&rho;_m} with multiplicity at least m&minus;1, for every m &ge; 2. Equality holds for the partition (m(m+1)/2&minus;1,1). The proof evaluates an inherited recursion for a specified cyclic submodule using an asymmetric invariant, predecessor diagrams, explicit rigged configurations and exact finite initial calculations. The estimate is presented as new to this project; literature priority is not claimed.</p>\n<p>&nbsp;</p>\n<p>AI-assisted preprint by Myeongjin Kang, with no affiliation. Internal AI review is not external journal peer review or worldwide-priority certification. Identified OpenAI source inputs at revision fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb are stipulated true. Lean verifies scoped supporting results only, not the full theorem. Original prose: CC BY 4.0; original code and Lean: MIT; third-party rights preserved. See the supporting archive for precise assumptions, coverage, provenance and corrections.</p>", "access_right": "open", "creators": [{"name": "Kang, Myeongjin", "affiliation": null}], "version": "1.0", "resource_type": {"title": "Preprint", "type": "publication", "subtype": "preprint"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23647108"}}]}}, "title": "The sharp minimum multiplicity in a staircase tensor square", "links": {"self": "https://zenodo.org/api/records/23647109", "self_html": "https://zenodo.org/records/23647109", "preview_html": "https://zenodo.org/records/23647109?preview=1", "doi": "https://doi.org/10.5281/zenodo.23647109", "self_doi": "https://doi.org/10.5281/zenodo.23647109", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23647109", "reserve_doi": "https://zenodo.org/api/records/23647109/draft/pids/doi", "parent": "https://zenodo.org/api/records/23647108", "parent_html": "h