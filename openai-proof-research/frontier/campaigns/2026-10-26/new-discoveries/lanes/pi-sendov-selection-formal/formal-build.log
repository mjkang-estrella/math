@CStarSendov.continuous_two_point_selection : ∀ {X : Type u_1} [inst : TopologicalSpace X] [PreconnectedSpace X]
  {Y : Type u_2} [inst_2 : MetricSpace Y] {r : X → Y},
  Continuous r → ∀ {p q : Y}, p ≠ q → (∀ (x : X), r x = p ∨ r x = q) → (∀ (x : X), r x = p) ∨ ∀ (x : X), r x = q
@CStarSendov.selection_rigidity : ∀ {X : Type u_1} [inst : TopologicalSpace X] [PreconnectedSpace X] {b f g : X → ℂ},
  Continuous b →
    Continuous f → Continuous g → (∀ (x : X), f x ≠ g x) → (∀ (x : X), b x = f x ∨ b x = g x) → b = f ∨ b = g
@CStarSendov.selection_rigidity_cmap : ∀ {X : Type u_1} [inst : TopologicalSpace X] [PreconnectedSpace X]
  (b f g : C(X, ℂ)), (∀ (x : X), f x ≠ g x) → (∀ (x : X), b x = f x ∨ b x = g x) → b = f ∨ b = g
@CStarSendov.factor_root_global : ∀ {X : Type u_1} [inst : TopologicalSpace X] [PreconnectedSpace X] {b b1 b2 : X → ℂ},
  Continuous b →
    Continuous b1 →
      Continuous b2 → (∀ (x : X), b1 x ≠ b2 x) → (∀ (x : X), (b x - b1 x) * (b x - b2 x) = 0) → b = b1 ∨ b = b2
@CStarSendov.dist_le_one_iff_normSq_le_one : ∀ {z w : ℂ}, dist z w ≤ 1 ↔ Complex.normSq (z - w) ≤ 1
@CStarSendov.no_proximity_factor_root : ∀ {X : Type u_1} [inst : TopologicalSpace X] [PreconnectedSpace X]
  {a0 b1 b2 : X → ℂ},
  Continuous b1 →
    Continuous b2 →
      (∀ (x : X), b1 x ≠ b2 x) →
        ∀ {x0 x1 : X},
          1 < ‖a0 x1 - b1 x1‖ →
            1 < ‖a0 x0 - b2 x0‖ →
              ∀ {b : X → ℂ}, Continuous b → (∀ (x : X), (b x - b1 x) * (b x - b2 x) = 0) → ¬∀ (x : X), ‖b x - a0 x‖ ≤ 1
@CStarSendov.exists_no_proximity_factor_root : ∀ {X : Type u_1} [inst : TopologicalSpace X] [PreconnectedSpace X]
  {a0 b1 b2 : X → ℂ},
  Continuous b1 →
    Continuous b2 →
      (∀ (x : X), b1 x ≠ b2 x) →
        ∀ {x0 x1 : X},
          1 < ‖a0 x1 - b1 x1‖ →
            1 < ‖a0 x0 - b2 x0‖ →
              ¬∃ b, Continuous b ∧ (∀ (x : X), (b x - b1 x) * (b x - b2 x) = 0) ∧ ∀ (x : X), ‖b x - a0 x‖ ≤ 1
@CStarSendov.no_proximity_factor_root_dist : ∀ {X : Type u_1} [inst : TopologicalSpace X] [PreconnectedSpace X]
  {a0 b1 b2 : X → ℂ},
  Continuous b1 →
    Continuous b2 →
      (∀ (x : X), b1 x ≠ b2 x) →
        ∀ {x0 x1 : X},
          1 < dist (a0 x1) (b1 x1) →
            1 < dist (a0 x0) (b2 x0) →
              ∀ {b : X → ℂ},
                Continuous b → (∀ (x : X), (b x - b1 x) * (b x - b2 x) = 0) → ¬∀ (x : X), dist (b x) (a0 x) ≤ 1
@CStarSendov.deletedProductDeriv : {X : Type u_1} → (X → ℂ) → (Fin 3 → X → ℂ) → X → ℂ
@CStarSendov.deletedProductDeriv_apply : ∀ {X : Type u_1} (B : X → ℂ) (a : Fin 3 → X → ℂ) (x : X),
  CStarSendov.deletedProductDeriv B a x = ∑ j, ∏ k ∈ Finset.univ.erase j, (B x - a k x)
@CStarSendov.exists_convex_weights : ∀ {X : Type u_1} [inst : TopologicalSpace X] {B : X → ℂ} {a : Fin 3 → X → ℂ},
  Continuous B →
    (∀ (j : Fin 3), Continuous (a j)) →
      (∀ (x : X) (j : Fin 3), B x ≠ a j x) →
        (∀ (x : X), CStarSendov.deletedProductDeriv B a x = 0) →
          ∃ ω,
            (∀ (j : Fin 3), Continuous (ω j)) ∧
              (∀ (x : X) (j : Fin 3), 0 < ω j x) ∧ (∀ (x : X), ∑ j, ω j x = 1) ∧ B = ∑ j, ω j • a j
