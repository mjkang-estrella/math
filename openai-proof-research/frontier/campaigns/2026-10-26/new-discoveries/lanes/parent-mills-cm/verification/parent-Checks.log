MillsCounterexample.quotient_derivative_recurrence (n : ℕ) :
  iteratedDeriv (n + 1) MillsCounterexample.quotient 0 =
    ∑ k ∈ Finset.range (n + 2),
        ↑((n + 1).choose k) * iteratedDeriv k MillsCounterexample.mills 0 *
          iteratedDeriv (n + 1 - k) MillsCounterexample.mills 0 +
      ↑(n + 1) *
        ∑ k ∈ Finset.range (n + 1),
          ↑(n.choose k) * iteratedDeriv k MillsCounterexample.mills 0 *
            iteratedDeriv (n - k) MillsCounterexample.quotient 0
