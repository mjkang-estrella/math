composition_card (n : ℕ) : Fintype.card (Composition n) = 2 ^ (n - 1)
Composition.blocks_eq_nil {n : ℕ} (c : Composition n) : c.blocks = [] ↔ n = 0
Equiv.sum_comp.{u_1, u_2, u_3} {ι : Type u_1} {κ : Type u_2} {M : Type u_3} [Fintype ι] [Fintype κ] [AddCommMonoid M]
  (e : ι ≃ κ) (g : κ → M) : ∑ i, g (e i) = ∑ i, g i
Fintype.sum_sigma.{u_7, u_8, u_9} {ι : Type u_9} {α : ι → Type u_7} {M : Type u_8} [Fintype ι] [(i : ι) → Fintype (α i)]
  [AddCommMonoid M] (f : Sigma α → M) : ∑ x, f x = ∑ x, ∑ y, f ⟨x, y⟩
Fin.sum_univ_succ.{u_2} {M : Type u_2} [AddCommMonoid M] {n : ℕ} (f : Fin (n + 1) → M) : ∑ i, f i = f 0 + ∑ i, f i.succ
Composition.ext {n : ℕ} {x y : Composition n} (blocks : x.blocks = y.blocks) : x = y
Sigma.ext.{u, v} {α : Type u} {β : α → Type v} {x y : Sigma β} (fst : x.fst = y.fst) (snd : x.snd ≍ y.snd) : x = y
Nat.factorial_succ (n : ℕ) : (n + 1).factorial = (n + 1) * n.factorial
le_of_tendsto.{u, v} {α : Type u} {β : Type v} [TopologicalSpace α] [Preorder α] [ClosedIicTopology α] {f : β → α}
  {a b : α} {x : Filter β} [hx : x.NeBot] (lim : Filter.Tendsto f x (nhds a)) (h : ∀ᶠ (c : β) in x, f c ≤ b) : a ≤ b
le_of_tendsto_of_tendsto.{u, v} {α : Type u} {β : Type v} [TopologicalSpace α] [Preorder α] [t : OrderClosedTopology α]
  {f g : β → α} {b : Filter β} {a₁ a₂ : α} [hb : b.NeBot] (hf : Filter.Tendsto f b (nhds a₁))
  (hg : Filter.Tendsto g b (nhds a₂)) (h : f ≤ᶠ[b] g) : a₁ ≤ a₂
Filter.Eventually.and.{u} {α : Type u} {p q : α → Prop} {f : Filter α} :
  Filter.Eventually p f → Filter.Eventually q f → ∀ᶠ (x : α) in f, p x ∧ q x
Filter.Tendsto.eventually_lt_const.{u, w} {α : Type u} {γ : Type w} [TopologicalSpace α] [LinearOrder α]
  [ClosedIciTopology α] {l : Filter γ} {f : γ → α} {u v : α} (hv : v < u) (h : Filter.Tendsto f l (nhds v)) :
  ∀ᶠ (a : γ) in l, f a < u
