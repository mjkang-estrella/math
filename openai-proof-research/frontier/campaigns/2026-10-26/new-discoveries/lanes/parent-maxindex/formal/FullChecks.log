  {k l : ℕ} (hkl : k ≤ l) (hl : l ≤ Fintype.card α) : MaxIndex.sortedTopSum f k ≤ MaxIndex.sortedTopSum f l
'MaxIndex.sortedTopSum_mono' depends on axioms: [propext, Classical.choice, Quot.sound]
MaxIndex.source_next_index_counterexample (d : ℕ) (hd : 5 ≤ d) :
  ∃ p,
    (∀ (i : Fin d), 0 ≤ p i) ∧
      ∑ i, p i = 1 ∧
        ↑d <
          MaxIndex.sortedTopSum (MaxIndex.arithmeticEntry p) (2 * d - 4) +
            MaxIndex.sortedTopSum (MaxIndex.geometricEntry p) (2 * d - 4)
'MaxIndex.source_next_index_counterexample' depends on axioms: [propext, Classical.choice, Quot.sound]
MaxIndex.source_index_classification (d : ℕ) (hd : 5 ≤ d) (k : ℕ) (hk : k ≤ d * d) :
  (∀ (p : Fin d → ℝ),
      (∀ (i : Fin d), 0 ≤ p i) →
        ∑ i, p i = 1 →
          MaxIndex.sortedTopSum (MaxIndex.arithmeticEntry p) k + MaxIndex.sortedTopSum (MaxIndex.geometricEntry p) k ≤
            ↑d) ↔
    k ≤ 2 * d - 5
'MaxIndex.source_index_classification' depends on axioms: [propext, Classical.choice, Quot.sound]
