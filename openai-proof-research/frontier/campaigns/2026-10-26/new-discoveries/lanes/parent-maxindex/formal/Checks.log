MaxIndex.low_maximum_bound (m : ℝ) (hm : 0 ≤ m) : (4 * m + 7) / 6 + √(2 * m + 1) < m + 3
'MaxIndex.low_maximum_bound' depends on axioms: [propext, Classical.choice, Quot.sound]
MaxIndex.high_maximum_bound (m p : ℝ) (hm : 0 ≤ m) (hp : 0 ≤ p) (hp1 : p ≤ 1) :
  1 + (m + 1) * p + √(2 * m) * √(1 - p ^ 2) < m + 3
'MaxIndex.high_maximum_bound' depends on axioms: [propext, Classical.choice, Quot.sound]
MaxIndex.sharpness_gap_positive (m : ℝ) (hm : 2 ≤ m) : 0 < (m - 1) ^ 2 / (4 * m ^ 2 + m)
'MaxIndex.sharpness_gap_positive' depends on axioms: [propext, Classical.choice, Quot.sound]
MaxIndex.sharpness_selected_sum (m : ℝ) (hm : 2 ≤ m) :
  ((m + 3 / 2) * (2 * m) ^ 2 + m) / ((2 * m) ^ 2 + m) + ((2 * m) ^ 2 + 2 * m * (2 * m) + 1) / ((2 * m) ^ 2 + m) -
      (m + 3) =
    (m - 1) ^ 2 / (4 * m ^ 2 + m)
'MaxIndex.sharpness_selected_sum' depends on axioms: [propext, Classical.choice, Quot.sound]
