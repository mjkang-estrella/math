     := by
  have hab : (0 : ℝ) < (9 / 4) := by norm_num
  let t : unitInterval := ⟨(q-(0 / 1)) / (9 / 4), by
    constructor
    · exact div_nonneg (by linarith) (le_of_lt hab)
    · apply (div_le_one hab).mpr
      linarith⟩
  have hh := bernsteinSum_lower h0Coefficients (1 / 5)
    h0Coefficients_bound t
  rw [← h0_transform] at hh
  have he : (0 / 1) + (9 / 4) * (t : ℝ) = q := by
    dsimp [t]
    field_simp
    ring
  rw [he] at hh
  norm_num at hh ⊢
  exact hh

