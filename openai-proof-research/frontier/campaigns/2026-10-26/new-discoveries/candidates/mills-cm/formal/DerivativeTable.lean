noncomputable def ratioDerivativePoly (n : ℕ) : Polynomial ℤ :=
  polyOfCoeffs (ratioDerivativeTable[n]?.getD [])

theorem ratioDerivativePoly_zero : ratioDerivativePoly 0 = X ^ 2 := by
  norm_num [ratioDerivativePoly, ratioDerivativeTable, polyOfCoeffs]
  ring

theorem ratioDerivativePoly_step (n : Fin 40) :
    ratioDerivativePoly (n.1 + 1) =
      (∑ k ∈ Finset.range (n.1 + 2), C ((n.1 + 1).choose k : ℤ) *
        millsDerivativePoly k * millsDerivativePoly (n.1 + 1 - k)) +
      C ((n.1 + 1 : ℕ) : ℤ) * (∑ k ∈ Finset.range (n.1 + 1), C (n.1.choose k : ℤ) *
        millsDerivativePoly k * ratioDerivativePoly (n.1 - k)) := by
  fin_cases n
  all_goals norm_num [ratioDerivativePoly, ratioDerivativeTable, polyOfCoeffs,
    millsDerivativePoly, Finset.sum_range_succ, Nat.choose_eq_descFactorial_div_factorial,
    Nat.descFactorial, Nat.factorial]
  all_goals ring

end MillsCounterexample
