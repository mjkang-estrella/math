'OddSubtraction.centered_balance' depends on axioms: [propext, Classical.choice, Quot.sound]
OddSubtraction.prefixSum_add (c : ℕ → ℝ) (n k : ℕ) :
  OddSubtraction.prefixSum c (n + k) = OddSubtraction.prefixSum c n + ∑ j ∈ Finset.range k, c (n + j)
'OddSubtraction.prefixSum_add' depends on axioms: [propext, Classical.choice, Quot.sound]
OddSubtraction.prefixSum_succ_inv (c : ℕ → ℝ) (n : ℕ) :
  OddSubtraction.prefixSum c (n + 1) = OddSubtraction.prefixSum c n + c n
'OddSubtraction.prefixSum_succ_inv' depends on axioms: [propext, Classical.choice, Quot.sound]
OddSubtraction.tail_filter_sum (c : ℕ → ℝ) {D k : ℕ} (hk : k ≤ D) :
  (∑ n ∈ Finset.range D, if k ≤ n then c n else 0) = OddSubtraction.prefixSum c D - OddSubtraction.prefixSum c k
'OddSubtraction.tail_filter_sum' depends on axioms: [propext, Classical.choice, Quot.sound]
OddSubtraction.shifted_filter_sum (c : ℕ → ℝ) {D k : ℕ} (hk : k ≤ D) :
  (∑ n ∈ Finset.range D, if k ≤ n then c (n - k) else 0) = OddSubtraction.prefixSum c (D - k)
'OddSubtraction.shifted_filter_sum' depends on axioms: [propext, Classical.choice, Quot.sound]
