OddSubtraction.initial_window {S : Finset ℕ} {c : ℕ → ℝ} {D : ℕ} (hD : ∀ k ∈ S, k ≤ D)
  (hrec : ∀ (n : ℕ), ↑(OddSubtraction.eligible S n).card * c n = ∑ k ∈ OddSubtraction.eligible S n, c (n - k)) :
