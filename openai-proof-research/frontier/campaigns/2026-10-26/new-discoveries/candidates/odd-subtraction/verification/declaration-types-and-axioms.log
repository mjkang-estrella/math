OddSubtraction.gameWin (S : Finset ℕ) (n : ℕ) : ℝ
'OddSubtraction.gameWin' depends on axioms: [propext, Classical.choice, Quot.sound]
OddSubtraction.gameWin_recurrence (S : Finset ℕ) (hpos : ∀ k ∈ S, 0 < k) (n : ℕ) :
  OddSubtraction.gameWin S n =
    if OddSubtraction.eligible S n = ∅ then 0
    else 1 - (∑ k ∈ OddSubtraction.eligible S n, OddSubtraction.gameWin S (n - k)) / ↑(OddSubtraction.eligible S n).card
'OddSubtraction.gameWin_recurrence' depends on axioms: [propext, Classical.choice, Quot.sound]
OddSubtraction.gameWin_bounds (S : Finset ℕ) (hpos : ∀ k ∈ S, 0 < k) (n : ℕ) :
  0 ≤ OddSubtraction.gameWin S n ∧ OddSubtraction.gameWin S n ≤ 1
'OddSubtraction.gameWin_bounds' depends on axioms: [propext, Classical.choice, Quot.sound]
OddSubtraction.gameWin_model (S : Finset ℕ) (hpos : ∀ k ∈ S, 0 < k) : OddSubtraction.Model S (OddSubtraction.gameWin S)
'OddSubtraction.gameWin_model' depends on axioms: [propext, Classical.choice, Quot.sound]
OddSubtraction.model_unique {S : Finset ℕ} {a b : ℕ → ℝ} (ha : OddSubtraction.Model S a) (hb : OddSubtraction.Model S b)
  (hpos : ∀ k ∈ S, 0 < k) : a = b
'OddSubtraction.model_unique' depends on axioms: [propext, Classical.choice, Quot.sound]
OddSubtraction.gameWin_uniform (S : Finset ℕ) (hpos : ∀ k ∈ S, 0 < k) (n : ℕ)
  (hne : (OddSubtraction.eligible S n).Nonempty) :
  OddSubtraction.gameWin S n =
    1 - (∑ k ∈ OddSubtraction.eligible S n, OddSubtraction.gameWin S (n - k)) / ↑(OddSubtraction.eligible S n).card
'OddSubtraction.gameWin_uniform' depends on axioms: [propext, Classical.choice, Quot.sound]
OddSubtraction.centered_balance {S : Finset ℕ} {a : ℕ → ℝ} (hm : OddSubtraction.Model S a) (hodd : ∀ k ∈ S, k % 2 = 1)
  (n : ℕ) :
  ↑(OddSubtraction.eligible S n).card * OddSubtraction.centered a n =
