  OddSubtraction.prefixSum (OddSubtraction.centered a) (2 * (m + 1) + 1) =
    OddSubtraction.prefixSum (OddSubtraction.centered a) (2 * m + 1) + 2 * (a (2 * m + 1) - a (2 * m + 2))
