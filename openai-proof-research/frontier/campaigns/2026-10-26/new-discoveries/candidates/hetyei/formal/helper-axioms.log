FlatBernoulli.weighted_power_ge_mass.{u_1} {ι : Type u_1} [Fintype ι] (w z : ι → ℝ) (hw : ∀ (i : ι), 0 ≤ w i)
  (hz : ∀ (i : ι), 0 ≤ z i) (hmean : ∑ i, w i ≤ ∑ i, w i * z i) (m : ℕ) : ∑ i, w i ≤ ∑ i, w i * z i ^ m
'FlatBernoulli.weighted_power_ge_mass' depends on axioms: [propext, Classical.choice, Quot.sound]
FlatBernoulli.weighted_power_lower.{u_1} {ι : Type u_1} [Fintype ι] (w z : ι → ℝ) (hw : ∀ (i : ι), 0 ≤ w i)
  (hz : ∀ (i : ι), 0 ≤ z i) (hmass : ∑ i, w i = 1) {c : ℝ} (hc : 0 < c) (hmean : c ≤ ∑ i, w i * z i) (m : ℕ) :
  c ^ m ≤ ∑ i, w i * z i ^ m
'FlatBernoulli.weighted_power_lower' depends on axioms: [propext, Classical.choice, Quot.sound]
FlatBernoulli.even_propagation.{u_1} {ι : Type u_1} [Fintype ι] (w z : ι → ℝ) (hw : ∀ (i : ι), 0 ≤ w i)
  (hz : ∀ (i : ι), 0 ≤ z i) {q T c : ℝ} (hq0 : 1 / 2 ≤ q) (hq1 : q ≤ 1) (hc : 0 < c) (hbase : T - ∑ i, w i ≤ -c)
  (hnext : q ^ 2 * (T - ∑ i, w i * z i) ≤ T - ∑ i, w i) (m : ℕ) :
  q ^ (2 * m) * (T - ∑ i, w i * z i ^ m) ≤ -c * (1 / 4) ^ m
'FlatBernoulli.even_propagation' depends on axioms: [propext, Classical.choice, Quot.sound]
