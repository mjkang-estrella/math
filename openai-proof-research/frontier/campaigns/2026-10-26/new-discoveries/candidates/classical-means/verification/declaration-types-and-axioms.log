  ClassicalMeanRange.quadratic (ClassicalMeanRange.pairLeft c) (ClassicalMeanRange.pairRight c) ^ n +
          ClassicalMeanRange.harmonic (ClassicalMeanRange.pairLeft c) (ClassicalMeanRange.pairRight c) ^ n -
        ClassicalMeanRange.arithmetic (ClassicalMeanRange.pairLeft c) (ClassicalMeanRange.pairRight c) ^ n -
