ClassicalMeanRange.normalized_pair {c : ℝ} (hc : 1 ≤ c) :
  0 < ClassicalMeanRange.pairLeft c ∧
    0 < ClassicalMeanRange.pairRight c ∧
      ClassicalMeanRange.arithmetic (ClassicalMeanRange.pairLeft c) (ClassicalMeanRange.pairRight c) = c ∧
        ClassicalMeanRange.geometric (ClassicalMeanRange.pairLeft c) (ClassicalMeanRange.pairRight c) = 1 ∧
          ClassicalMeanRange.harmonic (ClassicalMeanRange.pairLeft c) (ClassicalMeanRange.pairRight c) = 1 / c ∧
            ClassicalMeanRange.quadratic (ClassicalMeanRange.pairLeft c) (ClassicalMeanRange.pairRight c) =
              √(2 * c ^ 2 - 1)
