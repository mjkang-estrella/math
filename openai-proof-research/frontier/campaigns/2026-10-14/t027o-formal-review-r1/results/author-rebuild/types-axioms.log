@T027O.triangle_coboundary : ∀ {K : Type u_1} [inst : Field K] {ι : Type u_2} (o : ι) (x : ι → ι → K),
  (∀ (i : ι), x i i = 0) →
    (∀ (i j : ι), i ≠ j → x i j + x j i = 0) →
      (∀ (i j k : ι), i ≠ j → j ≠ k → k ≠ i → x i j + x j k + x k i = 0) → ∃ h, ∀ (i j : ι), x i j = h i - h j
'T027O.triangle_coboundary' depends on axioms: [propext, Classical.choice, Quot.sound]
@T027O.cycleDerivative : {K : Type u_1} → [Field K] → {ι : Type u_2} → (ι → ι → K) → (ι → ι → K) → ι → ι → ι → K
'T027O.cycleDerivative' depends on axioms: [propext, Quot.sound]
@T027O.principal_minor_rigidity : ∀ {K : Type u_1} [inst : Field K] {ι : Type u_2} (o : ι) (M E : ι → ι → K),
  (∀ (i j : ι), i ≠ j → M i j ≠ 0) →
    (∀ (i : ι), E i i = 0) →
      (∀ (i j : ι), i ≠ j → E i j * M j i + M i j * E j i = 0) →
        (∀ (i j k : ι), i ≠ j → j ≠ k → k ≠ i → T027O.cycleDerivative M E i j k = 0) →
          (∀ (i j k : ι), i ≠ j → j ≠ k → k ≠ i → M i j * M j k * M k i - M i k * M k j * M j i ≠ 0) →
            ∃ h, ∀ (i j : ι), E i j = (h i - h j) * M i j
'T027O.principal_minor_rigidity' depends on axioms: [propext, Classical.choice, Quot.sound]
T027OControls.symmetricM : Fin 3 → Fin 3 → ℚ
'T027OControls.symmetricM' depends on axioms: [propext, Quot.sound]
T027OControls.cycleE : Fin 3 → Fin 3 → ℚ
'T027OControls.cycleE' depends on axioms: [propext, Quot.sound]
T027OControls.nonzero_off_diagonal : ∀ (i j : Fin 3), i ≠ j → T027OControls.symmetricM i j ≠ 0
'T027OControls.nonzero_off_diagonal' depends on axioms: [propext, Classical.choice, Quot.sound]
T027OControls.stationary_diagonal : ∀ (i : Fin 3), T027OControls.cycleE i i = 0
'T027OControls.stationary_diagonal' depends on axioms: [propext, Classical.choice, Quot.sound]
T027OControls.stationary_pairs : ∀ (i j : Fin 3),
  T027OControls.cycleE i j * T027OControls.symmetricM j i + T027OControls.symmetricM i j * T027OControls.cycleE j i = 0
'T027OControls.stationary_pairs' depends on axioms: [propext, Classical.choice, Quot.sound]
T027OControls.stationary_cycles : ∀ (i j k : Fin 3),
  T027O.cycleDerivative T027OControls.symmetricM T027OControls.cycleE i j k = 0
'T027OControls.stationary_cycles' depends on axioms: [propext, Classical.choice, Quot.sound]
T027OControls.genericity_fails : T027OControls.symmetricM 0 1 * T027OControls.symmetricM 1 2 *
      T027OControls.symmetricM 2 0 -
    T027OControls.symmetricM 0 2 * T027OControls.symmetricM 2 1 * T027OControls.symmetricM 1 0 =
  0
'T027OControls.genericity_fails' depends on axioms: [propext, Classical.choice, Quot.sound]
T027OControls.not_diagonal_commutator : ¬∃ h,
    ∀ (i j : Fin 3), T027OControls.cycleE i j = (h i - h j) * T027OControls.symmetricM i j
'T027OControls.not_diagonal_commutator' depends on axioms: [propext, Classical.choice, Quot.sound]
T027OControls.genericM : Fin 3 → Fin 3 → ℚ
'T027OControls.genericM' depends on axioms: [propext, Quot.sound]
T027OControls.generic_witness : ∀ (i j k : Fin 3),
  i ≠ j →
    j ≠ k →
      k ≠ i →
        T027OControls.genericM i j * T027OControls.genericM j k * T027OControls.genericM k i -
            T027OControls.genericM i k * T027OControls.genericM k j * T027OControls.genericM j i ≠
          0
'T027OControls.generic_witness' depends on axioms: [propext, Classical.choice, Quot.sound]
T027OControls.genericE : Fin 3 → Fin 3 → ℚ
'T027OControls.genericE' depends on axioms: [propext, Quot.sound]
T027OControls.rigidity_positive_control : ∃ h,
  ∀ (i j : Fin 3), T027OControls.genericE i j = (h i - h j) * T027OControls.genericM i j
'T027OControls.rigidity_positive_control' depends on axioms: [propext, Classical.choice, Quot.sound]
