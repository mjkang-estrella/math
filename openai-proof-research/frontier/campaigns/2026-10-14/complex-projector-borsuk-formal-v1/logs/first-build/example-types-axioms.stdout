BorsukControls.origin_margin : 1 / 50 / 25 < max (BorsukLocal.favored 0 0 (1 / 50)) (BorsukLocal.other 0 0 (1 / 50))
'BorsukControls.origin_margin' depends on axioms: [propext, Classical.choice, Quot.sound]
BorsukControls.equality_first_case : 9 / 25 * (1 / 50) ≤ BorsukLocal.favored (1 / 10000) (1 / 100) (1 / 50)
'BorsukControls.equality_first_case' depends on axioms: [propext, Classical.choice, Quot.sound]
BorsukControls.equality_large_boundary : 353 / 500 * (1 / 100) < BorsukLocal.other 0 (1 / 25) (1 / 100)
'BorsukControls.equality_large_boundary' depends on axioms: [propext, Classical.choice, Quot.sound]
BorsukControls.small_scale_case : 1 / 50 / 25 < BorsukLocal.favored 0 (1 / 100) (1 / 50)
'BorsukControls.small_scale_case' depends on axioms: [propext, Classical.choice, Quot.sound]
BorsukControls.three_chart_witnesses : 0 ^ 2 + 0 ^ 2 < BorsukLocal.radius ^ 2 ∧
  (1 / 10000) ^ 2 + (1 / 100) ^ 2 < BorsukLocal.radius ^ 2 ∧ 0 ^ 2 + (1 / 25) ^ 2 < BorsukLocal.radius ^ 2
'BorsukControls.three_chart_witnesses' depends on axioms: [propext, Classical.choice, Quot.sound]
BorsukControls.zero_epsilon_obstruction : max (BorsukLocal.favored 0 0 0) (BorsukLocal.other 0 0 0) = 0
'BorsukControls.zero_epsilon_obstruction' depends on axioms: [propext, Classical.choice, Quot.sound]
BorsukControls.excessive_epsilon_obstruction : max (BorsukLocal.favored 0 0 (1 / 4)) (BorsukLocal.other 0 0 (1 / 4)) < 0
'BorsukControls.excessive_epsilon_obstruction' depends on axioms: [propext, Classical.choice, Quot.sound]
BorsukControls.negative_magnitude_obstruction : max (BorsukLocal.favored (-1) 0 (1 / 50))
    (BorsukLocal.other (-1) 0 (1 / 50)) <
  0
'BorsukControls.negative_magnitude_obstruction' depends on axioms: [propext, Classical.choice, Quot.sound]
BorsukControls.outside_chart_obstruction : max (BorsukLocal.favored 2 2 (1 / 50)) (BorsukLocal.other 2 2 (1 / 50)) < 0
'BorsukControls.outside_chart_obstruction' depends on axioms: [propext, Classical.choice, Quot.sound]
BorsukControls.favored_margin_is_tight : BorsukLocal.favored 0 0 (1 / 50) = 9 / 25 * (1 / 50)
'BorsukControls.favored_margin_is_tight' depends on axioms: [propext, Classical.choice, Quot.sound]
BorsukControls.overly_strong_other_margin_false : BorsukLocal.other 0 (1 / 25) (1 / 100) < 4 / 5 * (1 / 100)
'BorsukControls.overly_strong_other_margin_false' depends on axioms: [propext, Classical.choice, Quot.sound]
BorsukControls.conjugate_is_essential : ((starRingEnd ℂ) (1 + Complex.I) * Complex.I).re = 1 ∧
  ((1 + Complex.I) * Complex.I).re = -1
'BorsukControls.conjugate_is_essential' depends on axioms: [propext, Classical.choice, Quot.sound]
BorsukControls.strict_cap_boundary : 1 / 2 + 1 / 2 ≤ 1 ∧ ¬0 < 0
'BorsukControls.strict_cap_boundary' depends on axioms: [propext, Classical.choice, Quot.sound]
