ANS263.probabilityExponent : ℝ
'ANS263.probabilityExponent' depends on axioms: [propext, Classical.choice, Quot.sound]
ANS263.packetExponent : ℝ
'ANS263.packetExponent' depends on axioms: [propext, Classical.choice, Quot.sound]
ANS263.baselineExponent : ℝ
'ANS263.baselineExponent' depends on axioms: [propext, Classical.choice, Quot.sound]
ANS263.badBandExponent : ℝ
'ANS263.badBandExponent' depends on axioms: [propext, Classical.choice, Quot.sound]
ANS263.initialExponent : ℝ
'ANS263.initialExponent' depends on axioms: [propext, Classical.choice, Quot.sound]
ANS263.exact_exponents : ANS263.badBandExponent = 1977 / 2000 ∧
  ANS263.initialExponent = 9891 / 10000 ∧ 7 * ANS263.badBandExponent / 2 - 3 = 1839 / 4000
'ANS263.exact_exponents' depends on axioms: [propext, Classical.choice, Quot.sound]
ANS263.simultaneous_parameter_margins : 0 < (1 - ANS263.probabilityExponent) / 4 - 5 / 2 * ANS263.packetExponent ∧
  0 < 1 - ANS263.probabilityExponent - 3 * ANS263.packetExponent ∧
    0 < (1 - ANS263.probabilityExponent) / 2 - ANS263.packetExponent / 2 ∧
      0 < 1 / 100 - 4 * ANS263.baselineExponent ∧
        0 < 2 / 100 / 4 - 5 / 2 * ANS263.baselineExponent ∧
          6 / 7 < ANS263.badBandExponent ∧ ANS263.badBandExponent < 1 ∧ 0 < 7 / 3 * ANS263.initialExponent - 1
'ANS263.simultaneous_parameter_margins' depends on axioms: [propext, Classical.choice, Quot.sound]
@ANS263.dyadic_gain_positive : ∀ {α : ℝ}, 6 / 7 < α → 0 < 7 * α / 2 - 3
'ANS263.dyadic_gain_positive' depends on axioms: [propext, Classical.choice, Quot.sound]
@ANS263.dyadic_ratio_bounds : ∀ {g : ℝ}, 0 < g → 0 ≤ (1 / 2) ^ g ∧ (1 / 2) ^ g < 1
'ANS263.dyadic_ratio_bounds' depends on axioms: [propext, Classical.choice, Quot.sound]
@ANS263.finite_geometric_bound : ∀ {q : ℝ}, 0 ≤ q → q < 1 → ∀ (n : ℕ), ∑ j ∈ Finset.range n, q ^ j ≤ 1 / (1 - q)
'ANS263.finite_geometric_bound' depends on axioms: [propext, Classical.choice, Quot.sound]
@ANS263.weighted_finite_budget : ∀ {q E : ℝ},
  0 ≤ q →
    q < 1 →
      0 ≤ E →
        ∀ (n : ℕ) (mass : ℕ → ℝ),
          (∀ j ∈ Finset.range n, mass j ≤ E * q ^ j) → ∑ j ∈ Finset.range n, mass j ≤ E / (1 - q)
'ANS263.weighted_finite_budget' depends on axioms: [propext, Classical.choice, Quot.sound]
@ANS263.dyadic_weighted_budget : ∀ {e β g : ℝ},
  0 ≤ e →
    0 < g →
      ∀ (n : ℕ) (mass : ℕ → ℝ),
        (∀ j ∈ Finset.range n, mass j ≤ e ^ β * ((1 / 2) ^ g) ^ j) →
          ∑ j ∈ Finset.range n, mass j ≤ e ^ β / (1 - (1 / 2) ^ g)
'ANS263.dyadic_weighted_budget' depends on axioms: [propext, Classical.choice, Quot.sound]
@ANS263.sum_of_two_weighted_budgets : ∀ {q t E F : ℝ},
  0 ≤ q →
    q < 1 →
      0 ≤ t →
        t < 1 →
          0 ≤ E →
            0 ≤ F →
              ∀ (n : ℕ) (mass : ℕ → ℝ),
                (∀ j ∈ Finset.range n, mass j ≤ E * q ^ j + F * t ^ j) →
                  ∑ j ∈ Finset.range n, mass j ≤ E / (1 - q) + F / (1 - t)
'ANS263.sum_of_two_weighted_budgets' depends on axioms: [propext, Classical.choice, Quot.sound]
@ANS263.vanishing_budget : ∀ {e : ℕ → ℝ} {β q : ℝ},
  Filter.Tendsto e Filter.atTop (nhds 0) → 0 < β → Filter.Tendsto (fun n => e n ^ β / (1 - q)) Filter.atTop (nhds 0)
'ANS263.vanishing_budget' depends on axioms: [propext, Classical.choice, Quot.sound]
@ANS263.scaled_annular_identity : ∀ {s D x β : ℝ},
  0 < s → 0 ≤ D → 0 ≤ x → s ^ 3 * D ^ β * (s * x) ^ (7 * β - 3) = (D * s ^ 7) ^ β * x ^ (7 * β - 3)
'ANS263.scaled_annular_identity' depends on axioms: [propext, Classical.choice, Quot.sound]
@ANS263.arbitrary_depth_budget_vanishes : ∀ {e : ℕ → ℝ} {β q : ℝ},
  Filter.Tendsto e Filter.atTop (nhds 0) →
    (∀ (n : ℕ), 0 ≤ e n) →
      0 < β →
        0 ≤ q →
          q < 1 →
            ∀ (depth : ℕ → ℕ) (mass : ℕ → ℕ → ℝ),
              (∀ (n j : ℕ), 0 ≤ mass n j) →
                (∀ (n j : ℕ), j ∈ Finset.range (depth n) → mass n j ≤ e n ^ β * q ^ j) →
                  Filter.Tendsto (fun n => ∑ j ∈ Finset.range (depth n), mass n j) Filter.atTop (nhds 0)
'ANS263.arbitrary_depth_budget_vanishes' depends on axioms: [propext, Classical.choice, Quot.sound]
@ANS263.two_rate_arbitrary_depth_vanishes : ∀ {e s : ℕ → ℝ} {β γ q t : ℝ},
  Filter.Tendsto e Filter.atTop (nhds 0) →
    Filter.Tendsto s Filter.atTop (nhds 0) →
      (∀ (n : ℕ), 0 ≤ e n) →
        (∀ (n : ℕ), 0 ≤ s n) →
          0 < β →
            0 < γ →
              0 ≤ q →
                q < 1 →
                  0 ≤ t →
                    t < 1 →
                      ∀ (depth : ℕ → ℕ) (mass : ℕ → ℕ → ℝ),
                        (∀ (n j : ℕ), 0 ≤ mass n j) →
                          (∀ (n j : ℕ), j ∈ Finset.range (depth n) → mass n j ≤ e n ^ β * q ^ j + s n ^ γ * t ^ j) →
                            Filter.Tendsto (fun n => ∑ j ∈ Finset.range (depth n), mass n j) Filter.atTop (nhds 0)
'ANS263.two_rate_arbitrary_depth_vanishes' depends on axioms: [propext, Classical.choice, Quot.sound]
@ANS263.positive_mass_tail_bound : ∀ {r d : ℝ}, 0 < r → 2 * r ≤ d → 1 / 2 ≤ 1 - r / d
'ANS263.positive_mass_tail_bound' depends on axioms: [propext, Classical.choice, Quot.sound]
@ANS263.finite_neutral_tail_bound : ∀ {ι : Type u_1} (I : Finset ι) (weight distance : ι → ℝ) {r : ℝ},
  0 < r →
    (∀ i ∈ I, 0 ≤ weight i) →
      (∀ i ∈ I, 2 * r ≤ distance i) → ∑ i ∈ I, weight i ≤ 2 * ∑ i ∈ I, (1 - r / distance i) * weight i
'ANS263.finite_neutral_tail_bound' depends on axioms: [propext, Classical.choice, Quot.sound]
ANS263.thresholdRadius : (ℝ → ℝ) → ℝ
'ANS263.thresholdRadius' depends on axioms: [propext, Classical.choice, Quot.sound]
@ANS263.threshold_bracket : ∀ {mass : ℝ → ℝ},
  Antitone mass →
    ∀ {a b : ℝ}, 0 ≤ b → 1 < mass a → mass b ≤ 1 → a ≤ ANS263.thresholdRadius mass ∧ ANS263.thresholdRadius mass ≤ b
'ANS263.threshold_bracket' depends on axioms: [propext, Classical.choice, Quot.sound]
ANS263Controls.bad_probability_exponent : ¬0 < 7 * (4 / 5) / 2 - 3
'ANS263Controls.bad_probability_exponent' depends on axioms: [propext, Classical.choice, Quot.sound]
ANS263Controls.negative_budget_fails : ¬∑ _j ∈ Finset.range 0, 0 ≤ -1 / (1 - 1 / 2)
'ANS263Controls.negative_budget_fails' depends on axioms: [propext, Classical.choice, Quot.sound]
ANS263Controls.unit_ratio_unbounded : ∀ (B : ℝ), ∃ n, B < ∑ j ∈ Finset.range n, 1 ^ j
'ANS263Controls.unit_ratio_unbounded' depends on axioms: [propext, Classical.choice, Quot.sound]
ANS263Controls.exterior_threshold_too_small : ¬1 / 2 ≤ 1 - 1 / (3 / 2)
'ANS263Controls.exterior_threshold_too_small' depends on axioms: [propext, Classical.choice, Quot.sound]
ANS263Controls.nonmonotoneMass : ℝ → ℝ
'ANS263Controls.nonmonotoneMass' depends on axioms: [propext, Classical.choice, Quot.sound]
ANS263Controls.nonmonotone_threshold_is_zero : ANS263.thresholdRadius ANS263Controls.nonmonotoneMass = 0
'ANS263Controls.nonmonotone_threshold_is_zero' depends on axioms: [propext, Classical.choice, Quot.sound]
ANS263Controls.dropping_monotonicity_breaks_bracket : 1 < ANS263Controls.nonmonotoneMass 2 ∧
  ANS263Controls.nonmonotoneMass 1 ≤ 1 ∧ ¬2 ≤ ANS263.thresholdRadius ANS263Controls.nonmonotoneMass
'ANS263Controls.dropping_monotonicity_breaks_bracket' depends on axioms: [propext, Classical.choice, Quot.sound]
