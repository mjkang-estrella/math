KnMinusEdgeControls.concrete_tensor_decomposition : ∃ r a b,
  (∀ (k : Fin r), KnMinusEdge.contract ![1, -1, 2] (a k) = 0) ∧
    (∀ (k : Fin r), KnMinusEdge.contract ![1, -1, 2] (b k) = 0) ∧
      ∀ (i : Fin (Nat.succ 2)) (j : Fin 3), ![![-4, -2, 1], ![-2, 0, 1], ![1, 1, 0]] i j = ∑ k, a k i * b k j
'KnMinusEdgeControls.concrete_tensor_decomposition' depends on axioms: [propext, Classical.choice, Quot.sound]
KnMinusEdgeControls.concrete_split_dimension : Module.finrank ℚ ↥(KnMinusEdge.slotEval ![1, -1, 2]).ker = 6
'KnMinusEdgeControls.concrete_split_dimension' depends on axioms: [propext, Classical.choice, Quot.sound]
KnMinusEdgeControls.nonconverse_zero_test : ∑ i, ∑ j, ![![0, 1], ![-1, 0]] i j * ![1, 0] i * ![1, 0] j = 0 ∧
  ¬∀ (j : Fin 2), ∑ i, ![1, -1] i * (![1, 0] i * ![1, 0] j) = 0
'KnMinusEdgeControls.nonconverse_zero_test' depends on axioms: [propext, Classical.choice, Quot.sound]
KnMinusEdgeControls.dropping_injectivity_breaks_bound : (KnMinusEdge.diagonalForm fun x => 1).Nondegenerate ∧
  (∀ (a : Fin 2 → ℚ) (b : Fin 1 → ℚ), ((KnMinusEdge.diagonalForm fun x => 1) (0 a)) b = 0) ∧
    ¬Module.finrank ℚ (Fin 2 → ℚ) + Module.finrank ℚ (Fin 1 → ℚ) ≤ Module.finrank ℚ (Fin 1 → ℚ)
'KnMinusEdgeControls.dropping_injectivity_breaks_bound' depends on axioms: [propext, Classical.choice, Quot.sound]
KnMinusEdgeControls.dropping_nondegeneracy_breaks_bound : Function.Injective ⇑LinearMap.id ∧
  (∀ (a b : ℚ), (0 a) b = 0) ∧ ¬Module.finrank ℚ ℚ + Module.finrank ℚ ℚ ≤ Module.finrank ℚ ℚ
'KnMinusEdgeControls.dropping_nondegeneracy_breaks_bound' depends on axioms: [propext, Classical.choice, Quot.sound]
KnMinusEdgeControls.dropping_rectangle_nondegeneracy_breaks_detector : have t := ![0, 1];
have w := ![1, 1];
have S := ![![0, -1], ![0, 0]];
1 ≠ 0 ∧
  KnMinusEdge.Rectangle 0 0 1 ∧
    (∀ (B : MvPolynomial (Fin 2) ℚ), KnMinusEdge.orderPair t w S 1 ((MvPolynomial.X 1 - MvPolynomial.C 1) * B) = 0) ∧
      ¬KnMinusEdge.RectangularNondegenerate 0 t w S
'KnMinusEdgeControls.dropping_rectangle_nondegeneracy_breaks_detector' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
KnMinusEdgeControls.concrete_localization : ∀ (σ : Fin 5 → ℚ),
  (∀ (U V : Polynomial ℚ),
      U.natDegree ≤ 2 → V.natDegree ≤ 1 → ∑ i, Polynomial.eval (↑↑i) U * ↑↑i * Polynomial.eval (↑↑i) V * σ i = 0) →
    σ 3 = 0
'KnMinusEdgeControls.concrete_localization' depends on axioms: [propext, Classical.choice, Quot.sound]
KnMinusEdgeControls.small_s2 : ∀ (P : MvPolynomial (Fin 4) ℚ),
  KnMinusEdge.Budget (fun x => 0) P → KnMinusEdge.collision ∣ P → P = 0
'KnMinusEdgeControls.small_s2' depends on axioms: [propext, Classical.choice, Quot.sound]
KnMinusEdgeControls.small_s3 : ∀ (P : MvPolynomial (Fin 4) ℚ),
  KnMinusEdge.Budget (fun x => 1) P → KnMinusEdge.collision ∣ P → P = 0
'KnMinusEdgeControls.small_s3' depends on axioms: [propext, Classical.choice, Quot.sound]
