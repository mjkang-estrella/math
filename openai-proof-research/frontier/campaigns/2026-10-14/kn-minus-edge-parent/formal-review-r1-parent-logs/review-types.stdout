IndependentReview.one_slot_is_not_both : have H := ![![0, 0], ![1, 0]];
(∀ (j : Fin 2), ∑ i, ![1, 0] i * H i j = 0) ∧ ¬∀ (i : Fin 2), ∑ j, ![1, 0] j * H i j = 0
'IndependentReview.one_slot_is_not_both' depends on axioms: [propext, Classical.choice, Quot.sound]
IndependentReview.zero_functional_dimension : Module.finrank ℚ ↥(KnMinusEdge.slotEval fun x => 0).ker = 4
'IndependentReview.zero_functional_dimension' depends on axioms: [propext, Classical.choice, Quot.sound]
IndependentReview.nonbasis_witness_tensor : ∃ r a b,
  (∀ (k : Fin r), KnMinusEdge.contract ![2, 3] (a k) = 0) ∧
    (∀ (k : Fin r), KnMinusEdge.contract ![2, 3] (b k) = 0) ∧
      ∀ (i : Fin (Nat.succ 1)) (j : Fin 2), ![![9, -6], ![-6, 4]] i j = ∑ k, a k i * b k j
'IndependentReview.nonbasis_witness_tensor' depends on axioms: [propext, Classical.choice, Quot.sound]
IndependentReview.mixed_without_self_isotropy : (∀ (x y : ℚ),
    ((KnMinusEdge.diagonalForm ![1, 1]) ![x, 0]) ![0, y] = 0) ∧
  ((KnMinusEdge.diagonalForm ![1, 1]) ![1, 0]) ![1, 0] ≠ 0 ∧ ((KnMinusEdge.diagonalForm ![1, 1]) ![0, 1]) ![0, 1] ≠ 0
'IndependentReview.mixed_without_self_isotropy' depends on axioms: [propext, Classical.choice, Quot.sound]
IndependentReview.mixed_with_same_nonzero_image : (KnMinusEdge.diagonalForm ![1, -1]).Nondegenerate ∧
  (∀ (x y : ℚ), ((KnMinusEdge.diagonalForm ![1, -1]) ![x, x]) ![y, y] = 0) ∧ ![1, 1] ≠ 0
'IndependentReview.mixed_with_same_nonzero_image' depends on axioms: [propext, Classical.choice, Quot.sound]
IndependentReview.second_injection_essential : Function.Injective ⇑LinearMap.id ∧
  (∀ (x : ℚ) (y : Fin 2 → ℚ), ((KnMinusEdge.diagonalForm fun x => 1) fun x_1 => x) (0 y) = 0) ∧
    ¬Module.finrank ℚ ℚ + Module.finrank ℚ (Fin 2 → ℚ) ≤ Module.finrank ℚ (Fin 1 → ℚ)
'IndependentReview.second_injection_essential' depends on axioms: [propext, Classical.choice, Quot.sound]
IndependentReview.excluded_endpoint_can_survive : (∀ (U V : Polynomial ℚ),
    ∑ i, Polynomial.eval (↑↑i) U * ↑↑i * Polynomial.eval (↑↑i) V * Pi.single 0 1 i = 0) ∧
  Pi.single 0 1 0 ≠ 0
'IndependentReview.excluded_endpoint_can_survive' depends on axioms: [propext, Classical.choice, Quot.sound]
IndependentReview.localization_nontrivial_instance : Pi.single 0 1 2 = 0
'IndependentReview.localization_nontrivial_instance' depends on axioms: [propext, Classical.choice, Quot.sound]
IndependentReview.constant_square_does_not_detect_twist : have t := ![0, 1];
have w := ![1, 1];
have S := ![![0, -1], ![0, 0]];
(∀ (a : ℚ), (∀ (b : ℚ), KnMinusEdge.orderPair t w S (MvPolynomial.C a) (MvPolynomial.C b) = 0) → a = 0) ∧
  (∀ (B : MvPolynomial (Fin 2) ℚ), KnMinusEdge.orderPair t w S 1 ((MvPolynomial.X 1 - MvPolynomial.C 1) * B) = 0) ∧
    ¬KnMinusEdge.RectangularNondegenerate 0 t w S
'IndependentReview.constant_square_does_not_detect_twist' depends on axioms: [propext, Classical.choice, Quot.sound]
IndependentReview.twist_root_and_detected_constant : (MvPolynomial.eval ![0, 1]) (MvPolynomial.X 1 - MvPolynomial.C 1) =
    0 ∧
  KnMinusEdge.orderPair ![0, 1] ![1, 1] ![![0, -1], ![1, 0]] 1 ((MvPolynomial.X 1 - MvPolynomial.C 1) * 1) ≠ 0
'IndependentReview.twist_root_and_detected_constant' depends on axioms: [propext, Classical.choice, Quot.sound]
IndependentReview.nonzero_specialization_has_root : (KnMinusEdge.missingSpecialization 0 1) KnMinusEdge.collision ≠ 0 ∧
  (MvPolynomial.eval ![0, 2]) ((KnMinusEdge.missingSpecialization 0 1) KnMinusEdge.collision) = 0
'IndependentReview.nonzero_specialization_has_root' depends on axioms: [propext, Classical.choice, Quot.sound]
IndependentReview.finite_field_pointwise_trap : MvPolynomial.X 0 ^ 2 - MvPolynomial.X 0 ≠ 0 ∧
  ∀ (point : Fin 1 → ZMod 2), (MvPolynomial.eval point) (MvPolynomial.X 0 ^ 2 - MvPolynomial.X 0) = 0
'IndependentReview.finite_field_pointwise_trap' depends on axioms: [propext, Classical.choice, Quot.sound]
IndependentReview.too_few_roots : Polynomial.X * (Polynomial.X - 1) ≠ 0 ∧
  Polynomial.eval 0 (Polynomial.X * (Polynomial.X - 1)) = 0 ∧ Polynomial.eval 1 (Polynomial.X * (Polynomial.X - 1)) = 0
'IndependentReview.too_few_roots' depends on axioms: [propext, Classical.choice, Quot.sound]
IndependentReview.zero_degree_convention : Polynomial.natDegree 0 = 0 ∧
  MvPolynomial.degreeOf 0 0 = 0 ∧ KnMinusEdge.Budget (fun x => 0) 0
'IndependentReview.zero_degree_convention' depends on axioms: [propext, Classical.choice, Quot.sound]
IndependentReview.characteristic_two_skew_trap : (∀ (i j : Fin 1), 1 = -1) ∧ ∑ i, ∑ j, 1 ≠ 0
'IndependentReview.characteristic_two_skew_trap' depends on axioms: [propext, Classical.choice, Quot.sound]
IndependentReview.both_local_factors_needed : have P := MvPolynomial.X 0 + MvPolynomial.X 1 - 1;
(KnMinusEdge.missingSpecialization 0 1) P = 0 ∧
  (KnMinusEdge.missingSpecialization 1 0) P = 0 ∧
    (MvPolynomial.eval ![2, 3, 0, 1]) (KnMinusEdge.localTest 0 P 1 1 1) = 0 ∧
      (MvPolynomial.eval ![2, 3, 1, 0]) (KnMinusEdge.localTest 0 P 1 1 1) = 0 ∧
        (2 + 3 - 1) * (3 - 1) * (3 - 0) * (1 - 2) * (1 - 0) ≠ 0 ∧
          (2 + 3 - 1) * (3 - 0) * (3 - 1) * (0 - 2) * (1 - 0) ≠ 0
'IndependentReview.both_local_factors_needed' depends on axioms: [propext, Classical.choice, Quot.sound]
