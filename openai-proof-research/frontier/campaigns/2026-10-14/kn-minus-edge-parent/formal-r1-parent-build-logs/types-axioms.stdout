@KnMinusEdge.mixed_test_missing : ∀ {K : Type u_1} [inst : Field K] (a b : K) (P Q : MvPolynomial (Fin 4) K),
  (KnMinusEdge.missingSpecialization a b) P = 0 →
    (KnMinusEdge.missingSpecialization b a) P = 0 →
      (KnMinusEdge.secondSpecialization a b) Q = 0 →
        (KnMinusEdge.secondSpecialization b a) Q = 0 →
          (KnMinusEdge.missingSpecialization a b) (P * Q * KnMinusEdge.delta) = 0 ∧
            (KnMinusEdge.missingSpecialization b a) (P * Q * KnMinusEdge.delta) = 0 ∧
              (KnMinusEdge.secondSpecialization a b) (P * Q * KnMinusEdge.delta) = 0 ∧
                (KnMinusEdge.secondSpecialization b a) (P * Q * KnMinusEdge.delta) = 0
