                                      ((MvPolynomial.X 1 - MvPolynomial.C (nodes a)) * B)) →
                        (∀ (B : MvPolynomial (Fin 2) K),
                            KnMinusEdge.Rectangle (s - 2 + 1) (s - 2) B →
                              ∀ (U V : Polynomial K),
                                U.natDegree ≤ s →
                                  V.natDegree ≤ s - 1 →
                                    ∑ i,
                                        weights i * Polynomial.eval (nodes i) U * (nodes i - nodes a) *
                                            Polynomial.eval (nodes i) V *
                                          sigma B i =
                                      0) →
                          ∀ (i : ι), i ≠ a → i ≠ b → A i = 0
'KnMinusEdge.localized_twisted_vanishing' depends on axioms: [propext, Classical.choice, Quot.sound]
