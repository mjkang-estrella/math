{
  "scope": "Artifact controls only; fixture anchors are not final anchors. No mathematical gate. All mutation targets are copies.",
  "controls": [
    {
      "control": "unchanged full copied payload",
      "expected_exit": 0,
      "actual_exit": 0,
      "payload_read_only": true,
      "diagnostic": ""
    },
    {
      "control": "changed payload bytes",
      "expected_exit": 1,
      "actual_exit": 1,
      "payload_read_only": true,
      "diagnostic": "ValueError: payload inventory/hash mismatch"
    },
    {
      "control": "unexpected hidden JSON payload",
      "expected_exit": 1,
      "actual_exit": 1,
      "payload_read_only": true,
      "diagnostic": "ValueError: payload inventory/hash mismatch"
    },
    {
      "control": "missing payload file",
      "expected_exit": 1,
      "actual_exit": 1,
      "payload_read_only": true,
      "diagnostic": "ValueError: payload inventory/hash mismatch"
    },
    {
      "control": "changed FINAL.md against detached anchor",
      "expected_exit": 1,
      "actual_exit": 1,
      "payload_read_only": true,
      "diagnostic": "ValueError: detached anchor mismatch: FINAL.md"
    },
    {
      "control": "changed REPORT.md against detached anchor",
      "expected_exit": 1,
      "actual_exit": 1,
      "payload_read_only": true,
      "diagnostic": "ValueError: detached anchor mismatch: REPORT.md"
    },
    {
      "control": "changed MANIFEST.json against detached anchor",
      "expected_exit": 1,
      "actual_exit": 1,
      "payload_read_only": true,
      "diagnostic": "ValueError: detached anchor mismatch: MANIFEST.json"
    },
    {
      "control": "unexpected payload symlink",
      "expected_exit": 1,
      "actual_exit": 1,
      "payload_read_only": true,
      "diagnostic": "ValueError: nonregular file: private/unexpected-link"
    },
    {
      "control": "restored copied payload",
      "expected_exit": 0,
      "actual_exit": 0,
      "payload_read_only": true,
      "diagnostic": ""
    }
  ]
}
