CMControls.duplicate_energy : ⟪CM275.sample (fun x => 1) fun x => 1, CM275.sample (fun x => 1) fun x => 1⟫ₙ_[ℂ] = 4
'CMControls.duplicate_energy' depends on axioms: [propext, Classical.choice, Quot.sound]
CMControls.duplicate_coefficients : ∑ x, star 1 * 1 = 2
'CMControls.duplicate_coefficients' depends on axioms: [propext, Classical.choice, Quot.sound]
CMControls.centered_alias : 0 - 1 = 2 - 1
'CMControls.centered_alias' depends on axioms: [propext, Classical.choice, Quot.sound]
CMControls.centered_alias_not_injective : ¬Function.Injective fun i => ↑↑i - 1
'CMControls.centered_alias_not_injective' depends on axioms: [propext, Classical.choice, Quot.sound]
CMControls.centered_safe : Function.Injective fun i => ↑↑i - 1
'CMControls.centered_safe' depends on axioms: [propext, Classical.choice, Quot.sound]
CMControls.nonunit_phase : star 2 * 2 = 4 ∧ star 2 * 2 ≠ 1
'CMControls.nonunit_phase' depends on axioms: [propext, Classical.choice, Quot.sound]
CMControls.sign_involution_test : (1 - -1) / 2 = 1 ∧ (1 + -1) / 2 = 0
'CMControls.sign_involution_test' depends on axioms: [propext, Classical.choice, Quot.sound]
CMControls.noncharacter_idempotence_fails : 2 * (2 * 1) ≠ 2 * 1
'CMControls.noncharacter_idempotence_fails' depends on axioms: [propext, Classical.choice, Quot.sound]
CMControls.overweight_fails : ¬2 * (1 / 4) ≤ 1 / 4
'CMControls.overweight_fails' depends on axioms: [propext, Classical.choice, Quot.sound]
CMControls.negative_probability_fails : ¬0 * -1 ≤ -1
'CMControls.negative_probability_fails' depends on axioms: [propext, Classical.choice, Quot.sound]
CMControls.actual_yes_boundary : 1 / 2 + 1 / 10 ≤ CM275.acceptance (2 / 100) (1 / 2) 1
'CMControls.actual_yes_boundary' depends on axioms: [propext, Classical.choice, Quot.sound]
CMControls.actual_no_boundary : CM275.acceptance (1 - 2 / 100) (1 / 2) 1 ≤ 1 / 2 - 1 / 10
'CMControls.actual_no_boundary' depends on axioms: [propext, Classical.choice, Quot.sound]
CMControls.wrong_tight_margin_fails : ¬1 / 2 + 1 / 8 ≤ CM275.acceptance (2 / 100) (1 / 2) 1
'CMControls.wrong_tight_margin_fails' depends on axioms: [propext, Classical.choice, Quot.sound]
CMControls.approximation_loss_needed : 59 / 100 < 1 / 2 + 1 / 10 ∧ |59 / 100 - (1 / 2 + 1 / 10)| ≤ 1 / 10 / 10
'CMControls.approximation_loss_needed' depends on axioms: [propext, Classical.choice, Quot.sound]
