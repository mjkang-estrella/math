  (∀ e ∉ F, w' e = w e) →
    ∀ {a b : V} (p : G.Walk a b), (∀ e ∈ p.edges, e ∉ F) → T212M.walkCost w' p = T212M.walkCost w p
'T212M.walk_cost_unchanged' depends on axioms: [propext, Classical.choice, Quot.sound]
@T212M.distance_dominated_by_cost : ∀ {V : Type u_1} {G : SimpleGraph V} (d : V → V → ℝ),
  (∀ (u : V), d u u = 0) →
    (∀ (u v z : V), d u z ≤ d u v + d v z) →
      ∀ (w : Sym2 V → ℝ),
        (∀ (u v : V), G.Adj u v → d u v ≤ w s(u, v)) → ∀ {a b : V} (p : G.Walk a b), d a b ≤ T212M.walkCost w p
'T212M.distance_dominated_by_cost' depends on axioms: [propext, Classical.choice, Quot.sound]
@T212M.detour_barrier : ∀ {V : Type u_1} [DecidableEq V] {G : SimpleGraph V} (d : V → V → ℝ),
  (∀ (u v : V), d u v = d v u) →
    (∀ (u v z : V), d u z ≤ d u v + d v z) →
      ∀ (w w' : Sym2 V → ℝ) (F : Finset (Sym2 V)),
        (∀ e ∉ F, w' e = w e) →
          (∀ {u v : V} (p : G.Walk u v), d u v ≤ T212M.walkCost w p) →
            ∀ {x a b c : V} (C : ℝ),
              d x c ≤ C →
                d x b = d x a + d a b →
                  ∀ (p : G.Walk a b),
                    p.edges.Nodup →
                      c ∈ p.support → d a b + 2 * d x a - 2 * C - T212M.changeBudget F w w' ≤ T212M.walkCost w' p
'T212M.detour_barrier' depends on axioms: [propext, Classical.choice, Quot.sound]
@T212M.late_segment_minimizes : ∀ {V : Type u_1} [DecidableEq V] {G : SimpleGraph V} (d : V → V → ℝ),
  (∀ (u v : V), d u v = d v u) →
    (∀ (u v z : V), d u z ≤ d u v + d v z) →
      ∀ (w w' : Sym2 V → ℝ) (F : Finset (Sym2 V)),
        (∀ e ∉ F, w' e = w e) →
          (∀ {u v : V} (p : G.Walk u v), d u v ≤ T212M.walkCost w p) →
            ∀ {x a b : V} (C : ℝ),
              (∀ e ∈ F, ∃ c ∈ e, d x c ≤ C) →
                d x b = d x a + d a b →
                  C + T212M.changeBudget F w w' / 2 < d x a →
                    ∀ (segment : G.Walk a b),
                      T212M.walkCost w segment = d a b →
                        (∀ e ∈ segment.edges, e ∉ F) →
                          ∀ (p : G.Walk a b), p.edges.Nodup → T212M.walkCost w' segment ≤ T212M.walkCost w' p
'T212M.late_segment_minimizes' depends on axioms: [propext, Classical.choice, Quot.sound]
@T212M.walkCost_nonneg : ∀ {V : Type u_1} {G : SimpleGraph V} (w : Sym2 V → ℝ),
  (∀ (e : Sym2 V), 0 ≤ w e) → ∀ {a b : V} (p : G.Walk a b), 0 ≤ T212M.walkCost w p
'T212M.walkCost_nonneg' depends on axioms: [propext, Classical.choice, Quot.sound]
@T212M.calibrated_segment_avoids : ∀ {V : Type u_1} {G : SimpleGraph V} (d : V → V → ℝ),
  (∀ (u v z : V), d u z ≤ d u v + d v z) →
    ∀ (w : Sym2 V → ℝ),
      (∀ (e : Sym2 V), 0 ≤ w e) →
        (∀ {u v : V} (p : G.Walk u v), d u v ≤ T212M.walkCost w p) →
          ∀ (F : Finset (Sym2 V)) {x a b : V} (C : ℝ),
            (∀ e ∈ F, ∃ c ∈ e, d x c ≤ C) →
              d x b = d x a + d a b →
                C < d x a → ∀ (segment : G.Walk a b), T212M.walkCost w segment = d a b → ∀ e ∈ segment.edges, e ∉ F
'T212M.calibrated_segment_avoids' depends on axioms: [propext, Classical.choice, Quot.sound]
@T212M.ray_tail_stable : ∀ {V : Type u_1} [DecidableEq V] {G : SimpleGraph V} (d : V → V → ℝ),
  (∀ (u v : V), d u v = d v u) →
    (∀ (u v z : V), d u z ≤ d u v + d v z) →
      ∀ (w w' : Sym2 V → ℝ),
        (∀ (e : Sym2 V), 0 ≤ w e) →
          ∀ (F : Finset (Sym2 V)),
            (∀ e ∉ F, w' e = w e) →
              (∀ {u v : V} (p : G.Walk u v), d u v ≤ T212M.walkCost w p) →
                ∀ (x : V) (ray : ℕ → V) (segments : (i j : ℕ) → G.Walk (ray i) (ray j)),
                  (∀ (i j : ℕ), i ≤ j → T212M.walkCost w (segments i j) = d (ray i) (ray j)) →
                    (∀ (i j : ℕ), i ≤ j → d x (ray j) = d x (ray i) + d (ray i) (ray j)) →
                      (∀ (B : ℝ), ∃ N, ∀ (n : ℕ), N ≤ n → B < d x (ray n)) →
                        ∀ (C : ℝ),
                          (∀ e ∈ F, ∃ c ∈ e, d x c ≤ C) →
                            ∃ N,
                              ∀ (i : ℕ),
                                N ≤ i →
                                  ∀ (j : ℕ),
                                    i ≤ j →
                                      ∀ (p : G.Walk (ray i) (ray j)),
                                        p.edges.Nodup → T212M.walkCost w' (segments i j) ≤ T212M.walkCost w' p
'T212M.ray_tail_stable' depends on axioms: [propext, Classical.choice, Quot.sound]
