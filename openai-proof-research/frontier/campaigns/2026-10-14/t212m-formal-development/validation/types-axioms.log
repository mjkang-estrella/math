@T212M.walk_cost_change : ∀ {V : Type u_1} [DecidableEq V] {G : SimpleGraph V} (F : Finset (Sym2 V))
  (w w' : Sym2 V → ℝ),
  (∀ e ∉ F, w' e = w e) →
    ∀ {a b : V} (p : G.Walk a b), p.edges.Nodup → |T212M.walkCost w' p - T212M.walkCost w p| ≤ T212M.changeBudget F w w'
'T212M.walk_cost_change' depends on axioms: [propext, Classical.choice, Quot.sound]
