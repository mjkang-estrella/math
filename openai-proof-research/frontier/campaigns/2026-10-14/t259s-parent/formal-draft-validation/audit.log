@T259S.interval_related : ∀ {Y : Type u_1} (R : Setoid Y) (v : ℕ → Y) {i j : ℕ},
  i ≤ j → (∀ (m : ℕ), i ≤ m → m < j → R (v m) (v (m + 1))) → R (v i) (v j)
'T259S.interval_related' depends on axioms: [propext, Quot.sound]
@T259S.recover_missing_edge : ∀ {Y : Type u_1} (R : Setoid Y) (s t : ℕ → Y) (n k : ℕ),
  k ≤ n → (∀ i < n, R (t i) (s (i + 1))) → (∀ i ≤ n, i ≠ k → R (s i) (t i)) → R (s 0) (t n) → R (s k) (t k)
'T259S.recover_missing_edge' depends on axioms: [propext, Quot.sound]
@T259S.Available : {Y : Type u_1} → {Z : Type u_2} → Setoid Y → (Y → Y) → (Y → Z) → Set Z → Prop
'T259S.Available' does not depend on any axioms
@T259S.propagate_available : ∀ {Y : Type u_1} {Z : Type u_2} (R : Setoid Y) (a : Y → Y) (π : Y → Z) (shift : Z → Z)
  (row : Y → ℕ → Y) (n k : ℕ),
  k ≤ n →
    (∀ (y : Y), ∀ i < n, R (a (row y i)) (row y (i + 1))) →
      (∀ (y : Y), R (row y 0) (a (row y n))) →
        (∀ (y : Y), ∀ i ≤ n, i ≠ k → π (row y i) = π y) →
          (∀ (y : Y), π (row y k) = shift (π y)) →
            (Function.Surjective fun y => row y k) →
              Function.Injective shift → ∀ {D : Set Z}, T259S.Available R a π D → T259S.Available R a π (shift '' D)
'T259S.propagate_available' depends on axioms: [propext, Quot.sound]
@T259S.layers : {Z : Type u_1} → (Z → Z) → Set Z → ℕ → Set Z
'T259S.layers' does not depend on any axioms
@T259S.all_edges_of_coverage : ∀ {Y : Type u_1} {Z : Type u_2} (R : Setoid Y) (a : Y → Y) (π : Y → Z) (shift : Z → Z)
  (E : Set Z),
  T259S.Available R a π E →
    (∀ (D : Set Z), T259S.Available R a π D → T259S.Available R a π (shift '' D)) →
      (∀ (z : Z), ∃ n, z ∈ T259S.layers shift E n) → ∀ (y : Y), R y (a y)
'T259S.all_edges_of_coverage' does not depend on any axioms
T259SControls.two_missing_edges : true = true ∧ false = false ∧ ¬false = true ∧ ¬true = false
'T259SControls.two_missing_edges' does not depend on any axioms
T259SControls.bridge_is_needed : false = false ∧ false = false ∧ ¬true = false ∧ ¬false = true
