CDFControls.recentered_pair : ∃ d, d.card ≤ 1 ∧ ↑d ⊆ {-1, 1} ∧ CDFLocal.Covers {-1, 1} d 2
'CDFControls.recentered_pair' depends on axioms: [propext, Classical.choice, Quot.sound]
CDFControls.recenter_factor_one_false : ¬∃ z ∈ {-1, 1}, ∀ x ∈ {-1, 1}, dist x z ≤ 1
'CDFControls.recenter_factor_one_false' depends on axioms: [propext, Classical.choice, Quot.sound]
CDFControls.strict_packing_pair : {-1, 1}.card ≤ {-1, 1}.card
'CDFControls.strict_packing_pair' depends on axioms: [propext, Classical.choice, Quot.sound]
CDFControls.nonstrict_packing_obstruction : CDFLocal.Covers {-1, 1} {0} 1 ∧ dist (-1) 1 = 2 ∧ {0}.card < {-1, 1}.card
'CDFControls.nonstrict_packing_obstruction' depends on axioms: [propext, Classical.choice, Quot.sound]
CDFControls.three_scales : {0, 1, 2}.card ≤ 3
'CDFControls.three_scales' depends on axioms: [propext, Classical.choice, Quot.sound]
CDFControls.widened_window_obstruction : 1 ≤ 2 ^ (2 + 1) * (1 / 8) ∧ {0, 1, 2}.card > 2
'CDFControls.widened_window_obstruction' depends on axioms: [propext, Classical.choice, Quot.sound]
CDFControls.segment_instance : ∃ c, c.card ≤ 5 ∧ ↑c ⊆ segment ℝ 0 2 ∧ CDFLocal.Covers (segment ℝ 0 2) c (1 / 2)
'CDFControls.segment_instance' depends on axioms: [propext, Classical.choice, Quot.sound]
CDFControls.segment_zero_instance : ∃ c, c.card ≤ 5 ∧ ↑c ⊆ segment ℝ 0 0 ∧ CDFLocal.Covers (segment ℝ 0 0) c 0
'CDFControls.segment_zero_instance' depends on axioms: [propext, Classical.choice, Quot.sound]
CDFControls.cluster_constant_tight : dist (99 / 50) (101 / 100) = 97 / 200 * 2 ∧
  dist (99 / 50) 2 ≤ 2 / 100 ∧ dist (101 / 100) 1 ≤ 1 / 100 ∧ dist (99 / 50) (101 / 100) < 1 / 2 * 2
'CDFControls.cluster_constant_tight' depends on axioms: [propext, Classical.choice, Quot.sound]
CDFControls.fine_radius_obstruction : (1 / 32) ^ 2 ≤ (2 * (1 / 64)) ^ 2 + (2 * (1 / 64)) ^ 2 ∧ ¬1 / 32 < 1 / 64
'CDFControls.fine_radius_obstruction' depends on axioms: [propext, Classical.choice, Quot.sound]
CDFControls.low_count_tight : 65 * 1 ^ 9 + 16 * 1 ^ 4 = 81 * 1 ^ 10 ∧ ¬65 * 1 ^ 9 + 16 * 1 ^ 4 ≤ 80 * 1 ^ 10
'CDFControls.low_count_tight' depends on axioms: [propext, Classical.choice, Quot.sound]
