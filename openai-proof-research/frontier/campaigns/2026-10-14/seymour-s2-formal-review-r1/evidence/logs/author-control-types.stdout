SeymourControls.threshold_equality : ∀ (n : ℤ), n ^ 2 * (n ^ 2 + 1) - (n ^ 2 + 1) * (n ^ 2 + 1 - 1) = 0
'SeymourControls.threshold_equality' depends on axioms: [propext]
SeymourControls.threshold_family : Finset.range 4 ⊆ Finset.range 10 ∧
  (∀ i ∈ Finset.range 10 \ Finset.range 4, (if i < 4 then -3 else 2) ≤ 2) ∧
    (∀ i ∈ Finset.range 4, (if i < 4 then -3 else 2) ≤ 2 - 5) ∧ (∑ i ∈ Finset.range 10, if i < 4 then -3 else 2) = 0
'SeymourControls.threshold_family' depends on axioms: [propext, Classical.choice, Quot.sound]
SeymourControls.missing_anchor_family : Finset.range 4 ⊆ Finset.range 12 ∧
  (∀ i ∈ Finset.range 12 \ Finset.range 4, (if i < 4 then -4 else 2) ≤ 2) ∧
    (∀ i ∈ Finset.range 4, (if i < 4 then -4 else 2) ≤ 2 - 6) ∧ (∑ i ∈ Finset.range 12, if i < 4 then -4 else 2) = 0
'SeymourControls.missing_anchor_family' depends on axioms: [propext, Classical.choice, Quot.sound]
SeymourControls.sharp_negative_family : (∑ i ∈ Finset.range 12, if i < 5 then -4 else 2) = -6
'SeymourControls.sharp_negative_family' depends on axioms: [propext, Classical.choice, Quot.sound]
SeymourControls.weak_boundary_not_strict : -1 = 0 + 0 + 0 - 1 ∧ 0 ≤ 0 ∧ ¬0 ≤ -1
'SeymourControls.weak_boundary_not_strict' depends on axioms: [propext, Classical.choice, Quot.sound]
SeymourControls.disjointness_needed : 3 + 0 < 2 * 3 ∧ 3 + 0 < 2 * 3 ∧ ¬3 + 3 + 2 * 0 < 3 + 3
'SeymourControls.disjointness_needed' depends on axioms: [propext, Classical.choice, Quot.sound]
SeymourControls.strict_gain_needed : 6 + 2 * 2 = 5 + 5 ∧ 1 + 1 ≤ 2 + 0 ∧ 4 + 4 + 0 = 6 + 2
'SeymourControls.strict_gain_needed' depends on axioms: [propext, Classical.choice, Quot.sound]
