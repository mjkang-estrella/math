@T298P.coefficient_isometry : ∀ {Q : Type u_1} {A : Type u_2} {E : Type u_3} [inst : Fintype Q] [inst_1 : Fintype A]
  [inst_2 : DecidableEq A] [inst_3 : NormedAddCommGroup E] [inst_4 : InnerProductSpace ℝ E] (C : Q → A → ℝ)
  (xi : A → E),
  (∀ (a b : A), ∑ q, C q a * C q b = if a = b then 1 else 0) → ∑ q, ‖∑ a, C q a • xi a‖ ^ 2 = ∑ a, ‖xi a‖ ^ 2
'T298P.coefficient_isometry' depends on axioms: [propext, Classical.choice, Quot.sound]
@T298P.leading_score_energy : ∀ {Q : Type u_1} {A : Type u_2} {E : Type u_3} [inst : Fintype Q] [inst_1 : Fintype A]
  [inst_2 : DecidableEq A] [inst_3 : NormedAddCommGroup E] [inst_4 : InnerProductSpace ℝ E] (C : Q → A → ℝ)
  (xi : A → E),
  (∀ (a b : A), ∑ q, C q a * C q b = if a = b then 1 else 0) →
    ∀ (epsilon k : ℝ),
      ∑ q, ‖(1 / (epsilon * k ^ 2)) • ∑ a, C q a • xi a‖ ^ 2 = (∑ a, ‖xi a‖ ^ 2) / (epsilon ^ 2 * k ^ 4)
'T298P.leading_score_energy' depends on axioms: [propext, Classical.choice, Quot.sound]
T298P.gap_transfer : ∀ (c eMicro eStar micro0 micro1 star0 star1 sourceMicro0 sourceMicro1 sourceStar0 sourceStar1 : ℝ),
  0 ≤ c →
    0 ≤ eMicro →
      0 ≤ eStar →
        micro1 ≤ star1 →
          c * (sourceMicro1 - sourceMicro0) - eMicro ≤ micro1 - micro0 →
            star1 - star0 ≤ c * (sourceStar1 - sourceStar0) + eStar →
              c * (sourceStar0 - sourceMicro0 - (sourceStar1 - sourceMicro1)) - (eMicro + eStar) ≤ star0 - micro0
'T298P.gap_transfer' depends on axioms: [propext, Classical.choice, Quot.sound]
T298P.strict_gap : ∀ (c eMicro eStar micro0 micro1 star0 star1 sourceMicro0 sourceMicro1 sourceStar0 sourceStar1 : ℝ),
  0 < c →
    0 ≤ eMicro →
      0 ≤ eStar →
        micro1 ≤ star1 →
          c * (sourceMicro1 - sourceMicro0) - eMicro ≤ micro1 - micro0 →
            star1 - star0 ≤ c * (sourceStar1 - sourceStar0) + eStar →
              0 < sourceStar0 - sourceMicro0 →
                sourceStar1 - sourceMicro1 ≤ (sourceStar0 - sourceMicro0) / 2 →
                  eMicro + eStar < c * (sourceStar0 - sourceMicro0) / 2 → micro0 < star0
'T298P.strict_gap' depends on axioms: [propext, Classical.choice, Quot.sound]
