SeymourSupport.boundary_weak : ∀ (dD dH a q b : ℤ), dD = dH + q + b - a → dD ≤ -1 → a ≤ 1 → 0 ≤ q → 0 ≤ b → dH ≤ 0
'SeymourSupport.boundary_weak' depends on axioms: [propext, Quot.sound]
SeymourSupport.boundary_strict : ∀ (dD dH a q b : ℤ), dD = dH + q + b - a → dD ≤ -1 → a ≤ q → 0 ≤ b → dH ≤ -1
'SeymourSupport.boundary_strict' depends on axioms: [propext, Quot.sound]
SeymourSupport.boundary_indicators : ∀ (dD dH : ℤ) (hits avoids returns : Prop) [inst : Decidable hits]
  [inst_1 : Decidable avoids] [inst_2 : Decidable returns],
  (dD = ((dH + if hits ∧ avoids then 1 else 0) + if ¬hits ∧ returns then 1 else 0) - if hits then 1 else 0) →
    dD ≤ -1 → dH ≤ 0 ∧ (avoids → dH ≤ -1)
'SeymourSupport.boundary_indicators' depends on axioms: [propext, Classical.choice, Quot.sound]
@SeymourSupport.sum_with_specials : ∀ {α : Type u_1} [inst : DecidableEq α] (I S : Finset α) (f : α → ℤ) (n m : ℤ),
  S ⊆ I → (∀ i ∈ I \ S, f i ≤ n) → (∀ i ∈ S, f i ≤ n - m) → ∑ i ∈ I, f i ≤ ↑I.card * n - ↑S.card * m
'SeymourSupport.sum_with_specials' depends on axioms: [propext, Classical.choice, Quot.sound]
@SeymourSupport.aggregate_bound : ∀ {α : Type u_1} [inst : DecidableEq α] (I S : Finset α) (f : α → ℤ) (n m : ℤ),
  S ⊆ I →
    0 ≤ m →
      ↑I.card = n * m →
        m - 1 ≤ ↑S.card → (∀ i ∈ I \ S, f i ≤ n) → (∀ i ∈ S, f i ≤ n - m) → ∑ i ∈ I, f i ≤ n ^ 2 * m - m * (m - 1)
'SeymourSupport.aggregate_bound' depends on axioms: [propext, Classical.choice, Quot.sound]
@SeymourSupport.aggregate_negative : ∀ {α : Type u_1} [inst : DecidableEq α] (I S : Finset α) (f : α → ℤ) (n m : ℤ),
  S ⊆ I →
    m = n ^ 2 + 2 →
      ↑I.card = n * m →
        m - 1 ≤ ↑S.card → (∀ i ∈ I \ S, f i ≤ n) → (∀ i ∈ S, f i ≤ n - m) → ∑ i ∈ I, f i ≤ -m ∧ ∑ i ∈ I, f i < 0
'SeymourSupport.aggregate_negative' depends on axioms: [propext, Classical.choice, Quot.sound]
@SeymourSupport.fiber_cardinality_strict : ∀ {α : Type u_1} {β : Type u_2} [DecidableEq α] (I : Finset α)
  (A B C : α → Finset β),
  ∑ i ∈ I, (↑(A i).card + ↑(C i).card - 2 * ↑(B i).card) < 0 →
    ∑ i ∈ I, ↑(A i).card + ∑ i ∈ I, ↑(C i).card < 2 * ∑ i ∈ I, ↑(B i).card
'SeymourSupport.fiber_cardinality_strict' depends on axioms: [propext, Quot.sound]
@SeymourSupport.fiber_sigma_strict : ∀ {α : Type u_1} {β : Type u_2} [DecidableEq α] (I : Finset α)
  (A B C : α → Finset β),
  ∑ i ∈ I, (↑(A i).card + ↑(C i).card - 2 * ↑(B i).card) < 0 →
    (I.sigma A).card + (I.sigma C).card < 2 * (I.sigma B).card
'SeymourSupport.fiber_sigma_strict' depends on axioms: [propext, Classical.choice, Quot.sound]
@SeymourSupport.complement_gain : ∀ {α : Type u_1} [inst : DecidableEq α] (U P Q JP JQ JJP JJQ : Finset α),
  JP ⊆ U →
    JQ ⊆ U →
      JJP ⊆ U →
        JJQ ⊆ U →
          Disjoint JP JQ →
            P.card + JJP.card < 2 * JP.card →
              Q.card + JJQ.card < 2 * JQ.card →
                P.card + Q.card + 2 * (U \ (JP ∪ JQ)).card < (U \ JJQ).card + (U \ JJP).card
'SeymourSupport.complement_gain' depends on axioms: [propext, Classical.choice, Quot.sound]
@SeymourSupport.pruning_objective_gain : ∀ {α : Type u_1} [inst : DecidableEq α] (R C P' Q' : Finset α) (M d d' : ℕ),
  P' ⊆ R →
    Q' ⊆ C → M + 2 * d < R.card + C.card → (R \ P').card + (C \ Q').card ≤ d + d' → M + d < P'.card + Q'.card + d'
'SeymourSupport.pruning_objective_gain' depends on axioms: [propext, Classical.choice, Quot.sound]
@SeymourSupport.complement_pruning_contradiction : ∀ {α : Type u_1} [inst : DecidableEq α]
  (U P Q JP JQ JJP JJQ P' Q' : Finset α) (d' : ℕ),
  JP ⊆ U →
    JQ ⊆ U →
      JJP ⊆ U →
        JJQ ⊆ U →
          Disjoint JP JQ →
            P.card + JJP.card < 2 * JP.card →
              Q.card + JJQ.card < 2 * JQ.card →
                P' ⊆ U \ JJQ →
                  Q' ⊆ U \ JJP →
                    ((U \ JJQ) \ P').card + ((U \ JJP) \ Q').card ≤ (U \ (JP ∪ JQ)).card + d' →
                      P'.card + Q'.card + d' ≤ P.card + Q.card + (U \ (JP ∪ JQ)).card → False
'SeymourSupport.complement_pruning_contradiction' depends on axioms: [propext, Classical.choice, Quot.sound]
