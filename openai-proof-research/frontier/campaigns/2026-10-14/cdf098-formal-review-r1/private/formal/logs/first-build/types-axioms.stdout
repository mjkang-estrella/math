@CDFLocal.Covers : {α : Type u_1} → [PseudoMetricSpace α] → Set α → Finset α → ℝ → Prop
'CDFLocal.Covers' depends on axioms: [propext, Classical.choice, Quot.sound]
@CDFLocal.CoverBound : {α : Type u_1} → [PseudoMetricSpace α] → Set α → ℝ → ℕ → Prop
'CDFLocal.CoverBound' depends on axioms: [propext, Classical.choice, Quot.sound]
CDFLocal.DoublingBound : (α : Type u_1) → [PseudoMetricSpace α] → ℕ → Prop
'CDFLocal.DoublingBound' depends on axioms: [propext, Classical.choice, Quot.sound]
@CDFLocal.covers_mono : ∀ {α : Type u_1} [inst : PseudoMetricSpace α] {A B : Set α} {c : Finset α} {r t : ℝ},
  CDFLocal.Covers A c r → B ⊆ A → r ≤ t → CDFLocal.Covers B c t
'CDFLocal.covers_mono' depends on axioms: [propext, Classical.choice, Quot.sound]
@CDFLocal.refine_cover : ∀ {α : Type u_1} [inst : PseudoMetricSpace α] {A : Set α} {c : Finset α} {r t : ℝ} {N M : ℕ},
  c.card ≤ N →
    CDFLocal.Covers A c r →
      (∀ (z : α), CDFLocal.CoverBound (Metric.closedBall z r) t M) → CDFLocal.CoverBound A t (N * M)
'CDFLocal.refine_cover' depends on axioms: [propext, Classical.choice, Quot.sound]
@CDFLocal.iterated_cover : ∀ {α : Type u_1} [inst : PseudoMetricSpace α] {D : ℕ},
  CDFLocal.DoublingBound α D →
    ∀ (q : ℕ) (x : α) (r : ℝ), 0 < r → CDFLocal.CoverBound (Metric.closedBall x r) (r / 2 ^ q) (D ^ q)
'CDFLocal.iterated_cover' depends on axioms: [propext, Classical.choice, Quot.sound]
@CDFLocal.recenter_pullback : ∀ {α : Type u_1} {β : Type u_2} [inst : PseudoMetricSpace α]
  [inst_1 : PseudoMetricSpace β] (f : β → α) {A : Set β} {c : Finset α} {r K : ℝ},
  0 ≤ K →
    (∀ (x y : β), dist x y ≤ K * dist (f x) (f y)) →
      CDFLocal.Covers (f '' A) c r → ∃ d, d.card ≤ c.card ∧ ↑d ⊆ A ∧ CDFLocal.Covers A d (2 * K * r)
'CDFLocal.recenter_pullback' depends on axioms: [propext, Classical.choice, Quot.sound]
@CDFLocal.packing_bound : ∀ {α : Type u_1} [inst : PseudoMetricSpace α] (p c : Finset α) {s t : ℝ},
  (∀ x ∈ p, ∀ y ∈ p, x ≠ y → s < dist x y) → CDFLocal.Covers (↑p) c t → 2 * t ≤ s → p.card ≤ c.card
'CDFLocal.packing_bound' depends on axioms: [propext, Classical.choice, Quot.sound]
@CDFLocal.doubling_packing : ∀ {α : Type u_1} [inst : PseudoMetricSpace α] {D : ℕ},
  CDFLocal.DoublingBound α D →
    ∀ (p : Finset α) (x : α) {R s : ℝ},
      0 < R →
        ↑p ⊆ Metric.closedBall x R →
          (∀ u ∈ p, ∀ v ∈ p, u ≠ v → s < dist u v) → ∀ (q : ℕ), 2 * (R / 2 ^ q) ≤ s → p.card ≤ D ^ q
'CDFLocal.doubling_packing' depends on axioms: [propext, Classical.choice, Quot.sound]
@CDFLocal.doubling_transfer : ∀ {α : Type u_1} {β : Type u_2} [inst : PseudoMetricSpace α]
  [inst_1 : PseudoMetricSpace β] {D q : ℕ},
  CDFLocal.DoublingBound α D →
    ∀ (f : β → α) {K : ℝ},
      0 ≤ K →
        (∀ (x y : β), dist (f x) (f y) ≤ dist x y) →
          (∀ (x y : β), dist x y ≤ K * dist (f x) (f y)) → 4 * K ≤ 2 ^ q → CDFLocal.DoublingBound β (D ^ q)
'CDFLocal.doubling_transfer' depends on axioms: [propext, Classical.choice, Quot.sound]
@CDFLocal.subset_doubling : ∀ {α : Type u_1} [inst : PseudoMetricSpace α] {D : ℕ},
  CDFLocal.DoublingBound α D → ∀ (A : Set α), CDFLocal.DoublingBound (↑A) (D ^ 2)
'CDFLocal.subset_doubling' depends on axioms: [propext, Classical.choice, Quot.sound]
@CDFLocal.bilipschitz_doubling : ∀ {α : Type u_1} {β : Type u_2} [inst : PseudoMetricSpace α]
  [inst_1 : PseudoMetricSpace β] {D : ℕ},
  CDFLocal.DoublingBound α D →
    ∀ (f : α → β),
      Function.Surjective f →
        (∀ (x y : α), dist x y ≤ dist (f x) (f y)) →
          (∀ (x y : α), dist (f x) (f y) ≤ 2 * dist x y) → CDFLocal.DoublingBound β (D ^ 4)
'CDFLocal.bilipschitz_doubling' depends on axioms: [propext, Classical.choice, Quot.sound]
CDFLocal.dyadic : ℕ → ℝ
'CDFLocal.dyadic' depends on axioms: [propext, Classical.choice, Quot.sound]
@CDFLocal.dyadic_gap : ∀ {i j q : ℕ}, i + q ≤ j → CDFLocal.dyadic j * 2 ^ q ≤ CDFLocal.dyadic i
'CDFLocal.dyadic_gap' depends on axioms: [propext, Classical.choice, Quot.sound]
CDFLocal.dyadic_window_card : ∀ (t : Finset ℕ) {L U : ℝ} (q : ℕ),
  (∀ k ∈ t, L < CDFLocal.dyadic k ∧ CDFLocal.dyadic k ≤ U) → U ≤ 2 ^ q * L → t.card ≤ q
'CDFLocal.dyadic_window_card' depends on axioms: [propext, Classical.choice, Quot.sound]
CDFLocal.intermediate_scale_count : ∀ (t : Finset ℕ) {r : ℝ},
  0 < r → (∀ k ∈ t, r / 64 < CDFLocal.dyadic k ∧ CDFLocal.dyadic k ≤ 3 * r) → t.card ≤ 8
'CDFLocal.intermediate_scale_count' depends on axioms: [propext, Classical.choice, Quot.sound]
CDFLocal.high_scale_count : ∀ (t : Finset ℕ) {h r : ℝ},
  0 < r → 2 * r < h → (∀ k ∈ t, (h - r) / 2 ≤ CDFLocal.dyadic k ∧ CDFLocal.dyadic k ≤ h + r) → t.card ≤ 4
'CDFLocal.high_scale_count' depends on axioms: [propext, Classical.choice, Quot.sound]
CDFLocal.cluster_scale_count : ∀ (t : Finset ℕ) {r : ℝ},
  0 < r → (∀ k ∈ t, r / 4 < CDFLocal.dyadic k ∧ CDFLocal.dyadic k ≤ 400 * r / 97) → t.card ≤ 5
'CDFLocal.cluster_scale_count' depends on axioms: [propext, Classical.choice, Quot.sound]
CDFLocal.quarterGrid : Finset ℝ
'CDFLocal.quarterGrid' depends on axioms: [propext, Classical.choice, Quot.sound]
@CDFLocal.quarter_grid_bounds : ∀ {t : ℝ}, t ∈ CDFLocal.quarterGrid → 0 ≤ t ∧ t ≤ 1
'CDFLocal.quarter_grid_bounds' depends on axioms: [propext, Classical.choice, Quot.sound]
@CDFLocal.quarter_grid_cover : ∀ {t : ℝ}, 0 ≤ t → t ≤ 1 → ∃ u ∈ CDFLocal.quarterGrid, |t - u| ≤ 1 / 4
'CDFLocal.quarter_grid_cover' depends on axioms: [propext, Classical.choice, Quot.sound]
@CDFLocal.segment_cover : ∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E] (x y : E) {r : ℝ},
  dist x y ≤ 2 * r → ∃ c, c.card ≤ 5 ∧ ↑c ⊆ segment ℝ x y ∧ CDFLocal.Covers (segment ℝ x y) c (r / 2)
'CDFLocal.segment_cover' depends on axioms: [propext, Classical.choice, Quot.sound]
@CDFLocal.parent_edge_projection : ∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E] (x p : E)
  {s θ : ℝ}, 0 ≤ θ → θ ≤ 1 → dist x p ≤ 2 * s → dist ((AffineMap.lineMap x p) θ) x ≤ 2 * s
'CDFLocal.parent_edge_projection' depends on axioms: [propext, Classical.choice, Quot.sound]
@CDFLocal.edge_height_window : ∀ {s θ h r : ℝ},
  0 ≤ s → 0 ≤ θ → θ ≤ 1 → |(1 + θ) * s - h| ≤ r → (h - r) / 2 ≤ s ∧ s ≤ h + r
'CDFLocal.edge_height_window' depends on axioms: [propext, Classical.choice, Quot.sound]
@CDFLocal.endpoint_group_diameter : ∀ {α : Type u_1} [inst : PseudoMetricSpace α] (x y u v c : α) {a b : ℝ},
  dist x u < a → dist y v < a → dist u c ≤ b → dist v c ≤ b → dist x y < 2 * a + 2 * b
'CDFLocal.endpoint_group_diameter' depends on axioms: [propext, Classical.choice, Quot.sound]
@CDFLocal.fine_group_bound : ∀ {r : ℝ}, 0 < r → 2 * (r / 16) + 2 * (r / 128) < r / 2
'CDFLocal.fine_group_bound' depends on axioms: [propext, Classical.choice, Quot.sound]
@CDFLocal.bottom_group_bound : ∀ {d r : ℝ}, 0 ≤ d → 0 < r → d ^ 2 ≤ (r / 4) ^ 2 + (r / 8) ^ 2 → d < r / 2
'CDFLocal.bottom_group_bound' depends on axioms: [propext, Classical.choice, Quot.sound]
@CDFLocal.fine_edge_bound : ∀ {d s r : ℝ},
  0 ≤ d → 0 ≤ s → 0 < r → s ≤ r / 64 → d ^ 2 ≤ (2 * s) ^ 2 + (2 * s) ^ 2 → d < r / 16
'CDFLocal.fine_edge_bound' depends on axioms: [propext, Classical.choice, Quot.sound]
@CDFLocal.cluster_separation : ∀ {α : Type u_1} [inst : PseudoMetricSpace α] (p q u v : α) {a b : ℝ},
  b ≤ a / 2 → a - b ≤ dist u v → dist p u ≤ a / 100 → dist q v ≤ b / 100 → 97 / 200 * a ≤ dist p q
'CDFLocal.cluster_separation' depends on axioms: [propext, Classical.choice, Quot.sound]
@CDFLocal.meeting_cluster_scale : ∀ {α : Type u_1} [inst : PseudoMetricSpace α] (p q x : α) {a r : ℝ},
  97 / 200 * a ≤ dist p q → dist p x ≤ r → dist q x ≤ r → a ≤ 400 * r / 97
'CDFLocal.meeting_cluster_scale' depends on axioms: [propext, Classical.choice, Quot.sound]
@CDFLocal.low_count : ∀ {D : ℕ}, 1 ≤ D → 65 * D ^ 9 + 16 * D ^ 4 ≤ 81 * D ^ 10
'CDFLocal.low_count' depends on axioms: [propext, Classical.choice, Quot.sound]
@CDFLocal.high_count : ∀ {D : ℕ}, 1 ≤ D → 32 * D ^ 5 + 16 * D ^ 4 ≤ 48 * D ^ 10
'CDFLocal.high_count' depends on axioms: [propext, Classical.choice, Quot.sound]
@CDFLocal.graph_count : ∀ {D N : ℕ},
