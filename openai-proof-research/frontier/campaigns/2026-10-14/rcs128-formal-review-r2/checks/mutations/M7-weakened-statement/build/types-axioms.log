RCS128.even_card_of_reflection : ∀ (s : Finset ℕ) (rho : ℕ → ℕ),
  (∀ x ∈ s, rho x ∈ s) → (∀ x ∈ s, rho (rho x) = x) → (∀ x ∈ s, rho x ≠ x) → Even s.card
'RCS128.even_card_of_reflection' depends on axioms: [propext, Classical.choice, Quot.sound]
RCS128.even_phase_card : ∀ (s : Finset ℕ) (rho : ℕ → ℕ) (P : ℕ → Prop) [inst : DecidablePred P],
  (∀ x ∈ s, rho x ∈ s) →
    (∀ x ∈ s, rho (rho x) = x) → (∀ x ∈ s, rho x ≠ x) → (∀ x ∈ s, P x → P (rho x)) → Even (Finset.filter P s).card
'RCS128.even_phase_card' depends on axioms: [propext, Classical.choice, Quot.sound]
RCS128.filter_eq_range_at_boundary : ∀ (n j : ℕ) (P : ℕ → Prop) [inst : DecidablePred P],
  j + 1 < n →
    (∀ (a b : ℕ), b < n → a ≤ b → P b → P a) →
      P j → ¬P (j + 1) → Finset.filter P (Finset.range n) = Finset.range (j + 1)
'RCS128.filter_eq_range_at_boundary' depends on axioms: [propext, Classical.choice, Quot.sound]
RCS128.adjacent_pair_of_even_tail : ∀ (n i : ℕ) (P : ℕ → Prop) [inst : DecidablePred P],
  2 * i + 1 < n →
    (∀ (a b : ℕ), b < n → a ≤ b → P b → P a) →
      Even (Finset.filter P (Finset.range n)).card → (P (2 * i) ↔ P (2 * i + 1))
'RCS128.adjacent_pair_of_even_tail' depends on axioms: [propext, Classical.choice, Quot.sound]
RCS128.adjacent_exit_threshold : ∀ (n i : ℕ) (z : ℕ → ℤ) (b : ℤ),
  2 * i + 1 < n →
    (∀ (a c : ℕ), c < n → a ≤ c → z c ≤ z a) →
      Even {a ∈ Finset.range n | b ≤ z a}.card → (b ≤ z (2 * i) ↔ b ≤ z (2 * i + 1))
'RCS128.adjacent_exit_threshold' depends on axioms: [propext, Classical.choice, Quot.sound]
RCS128.reflection_sorted_pair : ∀ (s : Finset ℕ) (rho : ℕ → ℕ) (P : ℕ → Prop) [inst : DecidablePred P] (n i : ℕ)
  (z : ℕ → ℤ) (b : ℤ),
  (∀ x ∈ s, rho x ∈ s) →
    (∀ x ∈ s, rho (rho x) = x) →
      (∀ x ∈ s, rho x ≠ x) →
        (∀ x ∈ s, P x → P (rho x)) →
          (Finset.filter P s).card = {a ∈ Finset.range n | b ≤ z a}.card →
            2 * i + 1 < n → (∀ (a c : ℕ), c < n → a ≤ c → z c ≤ z a) → (b ≤ z (2 * i) ↔ b ≤ z (2 * i + 1))
'RCS128.reflection_sorted_pair' depends on axioms: [propext, Classical.choice, Quot.sound]
RCS128.even_card_erase_pair : ∀ (s : Finset ℕ) (a b : ℕ),
  a ∈ s → b ∈ s → a ≠ b → Even s.card → Even ((s.erase a).erase b).card
'RCS128.even_card_erase_pair' depends on axioms: [propext, Classical.choice, Quot.sound]
RCS128.even_phase_after_pair_removal : ∀ (s : Finset ℕ) (a b : ℕ) (P : ℕ → Prop) [inst : DecidablePred P],
  a ∈ s →
    b ∈ s → a ≠ b → (P a ↔ P b) → Even (Finset.filter P s).card → Even (Finset.filter P ((s.erase a).erase b)).card
'RCS128.even_phase_after_pair_removal' depends on axioms: [propext, Classical.choice, Quot.sound]
RCS128.lower_pair_visits_axis : ∀ (upperEntry lowerEntry upperExit lowerExit b : ℤ),
  lowerEntry ≤ upperEntry →
    upperEntry ≤ b ∧ b ≤ upperExit → (b ≤ upperExit ↔ b ≤ lowerExit) → lowerEntry ≤ b ∧ b ≤ lowerExit
'RCS128.lower_pair_visits_axis' depends on axioms: [propext]
RCS128.odd_core_from_previous_failure : ∀ (count : ℕ → ℕ) (k : ℕ),
  1 < k → 2 * (k - 1) < count (k - 1) → 2 * k - 1 ≤ count (k - 1)
'RCS128.odd_core_from_previous_failure' depends on axioms: [propext, Quot.sound]
RCS128.first_threshold_core : ∀ (count : ℕ → ℕ) (r : ℕ),
  1 ≤ r → count r ≤ 2 * r → ∃ k, 1 ≤ k ∧ k ≤ r ∧ count k ≤ 2 * k ∧ (k = 1 ∨ 2 * k - 1 ≤ count (k - 1))
'RCS128.first_threshold_core' depends on axioms: [propext, Classical.choice, Quot.sound]
@RCS128.exists_record_outside_alignment : ∀ {α : Type u_1} [DecidableEq α] (records identical : Finset α) (k : ℕ),
  2 * k + 1 ≤ records.card → identical.card ≤ 2 * k → ∃ x ∈ records, x ∉ identical
'RCS128.exists_record_outside_alignment' depends on axioms: [propext, Classical.choice, Quot.sound]
RCS128.odd_core_budget : ∀ (k p : ℕ), 1 ≤ k → 2 * ((k - 1) * p) + 2 * p = 2 * k * p
'RCS128.odd_core_budget' depends on axioms: [propext, Classical.choice, Quot.sound]
RCS128.shifted_copy_fits : ∀ (p k delta j : ℕ), delta < p → j < k → delta + j * p < k * p
'RCS128.shifted_copy_fits' depends on axioms: [propext, Classical.choice, Quot.sound]
RCS128.fixed_deficit_surplus : ∀ (delta k : ℕ), 0 < delta → Even delta → 2 * k + 1 ≤ delta * (k + 1)
'RCS128.fixed_deficit_surplus' depends on axioms: [propext, Classical.choice, Quot.sound]
RCS128.final_length_bound : ∀ (output upCost weight optimum : ℕ),
  2 * output = upCost → upCost ≤ 2 * weight → weight ≤ 2 * optimum → output ≤ 4 * optimum
'RCS128.final_length_bound' depends on axioms: [propext, Quot.sound]
RCS128Controls.even_total_does_not_pair_threshold : Even 2 ∧ 2 ≤ 2 ∧ ¬2 ≤ 1
'RCS128Controls.even_total_does_not_pair_threshold' depends on axioms: [propext, Classical.choice, Quot.sound]
RCS128Controls.unordered_even_set_splits_pair : Even {0, 2}.card ∧ 0 ∈ {0, 2} ∧ 1 ∉ {0, 2}
'RCS128Controls.unordered_even_set_splits_pair' depends on axioms: [propext, Classical.choice, Quot.sound]
RCS128Controls.odd_tail_splits_pair : (Finset.range 1).card = 1 ∧ 0 ∈ Finset.range 1 ∧ 1 ∉ Finset.range 1
'RCS128Controls.odd_tail_splits_pair' depends on axioms: [propext, Classical.choice, Quot.sound]
RCS128Controls.fixed_point_has_odd_card : (∀ x ∈ {0}, id (id x) = x) ∧ ¬Even {0}.card
'RCS128Controls.fixed_point_has_odd_card' depends on axioms: [propext, Classical.choice, Quot.sound]
RCS128Controls.no_outside_at_equal_cap : (Finset.range 2).card = 2 ∧ ¬∃ x ∈ Finset.range 2, x ∉ Finset.range 2
'RCS128Controls.no_outside_at_equal_cap' depends on axioms: [propext, Classical.choice, Quot.sound]
RCS128Controls.positive_odd_deficit_fails : 0 < 1 ∧ ¬2 * 1 + 1 ≤ 1 * (1 + 1)
'RCS128Controls.positive_odd_deficit_fails' does not depend on any axioms
RCS128Controls.unhalved_cost_can_exceed_factor_two : 4 ≤ 2 * 2 ∧ 2 ≤ 2 * 1 ∧ ¬4 ≤ 2 * 1
'RCS128Controls.unhalved_cost_can_exceed_factor_two' does not depend on any axioms
