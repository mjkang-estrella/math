@CM275.sample : {G : Type u_1} →
  {I : Type u_2} → [inst : AddCommGroup G] → [Fintype I] → (I → AddChar G ℂ) → (I → ℂ) → G → ℂ
'CM275.sample' depends on axioms: [propext, Classical.choice, Quot.sound]
@CM275.weighted_sum_left : ∀ {G : Type u_1} {I : Type u_2} [inst : Fintype G] [inst_1 : Fintype I] (w : G → ℝ)
  (f : I → G → ℂ) (g : G → ℂ), ⟪∑ i, f i, g⟫_[ℂ, w] = ∑ i, ⟪f i, g⟫_[ℂ, w]
'CM275.weighted_sum_left' depends on axioms: [propext, Classical.choice, Quot.sound]
@CM275.weighted_sum_right : ∀ {G : Type u_1} {I : Type u_2} [inst : Fintype G] [inst_1 : Fintype I] (w : G → ℝ)
  (f : G → ℂ) (g : I → G → ℂ), ⟪f, ∑ i, g i⟫_[ℂ, w] = ∑ i, ⟪f, g i⟫_[ℂ, w]
'CM275.weighted_sum_right' depends on axioms: [propext, Classical.choice, Quot.sound]
@CM275.character_parseval : ∀ {G : Type u_1} {I : Type u_2} [inst : AddCommGroup G] [inst_1 : Fintype G]
  [inst_2 : Fintype I] (χ : I → AddChar G ℂ),
  Function.Injective χ → ∀ (c d : I → ℂ), ⟪CM275.sample χ c, CM275.sample χ d⟫ₙ_[ℂ] = ∑ i, star (c i) * d i
'CM275.character_parseval' depends on axioms: [propext, Classical.choice, Quot.sound]
@CM275.sample_energy : ∀ {G : Type u_1} {I : Type u_2} [inst : AddCommGroup G] [inst_1 : Fintype G] [inst_2 : Fintype I]
  (χ : I → AddChar G ℂ),
  Function.Injective χ → ∀ (c : I → ℂ), (↑(Fintype.card G))⁻¹ * ∑ x, ‖CM275.sample χ c x‖ ^ 2 = ∑ i, ‖c i‖ ^ 2
'CM275.sample_energy' depends on axioms: [propext, Classical.choice, Quot.sound]
@CM275.phase_parseval : ∀ {G : Type u_1} {I : Type u_2} [inst : AddCommGroup G] [inst_1 : Fintype G]
  [inst_2 : Fintype I] (χ : I → AddChar G ℂ),
  Function.Injective χ →
    ∀ (c d u : I → ℂ),
      (∀ (i : I), star (u i) * u i = 1) →
        ⟪CM275.sample χ fun i => u i * c i, CM275.sample χ fun i => u i * d i⟫ₙ_[ℂ] =
          ⟪CM275.sample χ c, CM275.sample χ d⟫ₙ_[ℂ]
'CM275.phase_parseval' depends on axioms: [propext, Classical.choice, Quot.sound]
@CM275.discrete_translation : ∀ {G : Type u_1} {I : Type u_2} [inst : AddCommGroup G] [inst_1 : Fintype I]
  (χ : I → AddChar G ℂ) (c : I → ℂ) (u x : G), CM275.sample χ c (x + u) = CM275.sample χ (fun i => (χ i) u * c i) x
'CM275.discrete_translation' depends on axioms: [propext, Classical.choice, Quot.sound]
@CM275.mode : {q : ℕ} → [NeZero q] → ZMod q → AddChar (ZMod q) ℂ
'CM275.mode' depends on axioms: [propext, Classical.choice, Quot.sound]
@CM275.mode_injective : ∀ {q : ℕ} [inst : NeZero q], Function.Injective CM275.mode
'CM275.mode_injective' depends on axioms: [propext, Classical.choice, Quot.sound]
@CM275.grid_parseval : ∀ {q : ℕ} [inst : NeZero q] {I : Type u_1} [inst_1 : Fintype I] (k : I → ZMod q),
  Function.Injective k →
    ∀ (c d : I → ℂ),
      ⟪CM275.sample (fun i => CM275.mode (k i)) c, CM275.sample (fun i => CM275.mode (k i)) d⟫ₙ_[ℂ] =
        ∑ i, star (c i) * d i
'CM275.grid_parseval' depends on axioms: [propext, Classical.choice, Quot.sound]
@CM275.initial_modes_injective : ∀ {q K : ℕ}, K ≤ q → Function.Injective fun i => ↑↑i
'CM275.initial_modes_injective' depends on axioms: [propext, Classical.choice, Quot.sound]
@CM275.centered_modes_injective : ∀ {q K : ℕ}, 2 * K + 1 ≤ q → Function.Injective fun i => ↑↑i - ↑K
'CM275.centered_modes_injective' depends on axioms: [propext, Classical.choice, Quot.sound]
@CM275.twist : {G : Type u_1} →
  {V : Type u_2} →
    [inst : Group G] →
      [inst_1 : AddCommGroup V] → [inst_2 : Module ℂ V] → Representation ℂ G V → (G →* ℂˣ) → Representation ℂ G V
'CM275.twist' depends on axioms: [propext, Classical.choice, Quot.sound]
@CM275.characterProjector : {G : Type u_1} →
  {V : Type u_2} →
    [inst : Group G] →
      [inst_1 : AddCommGroup V] → [inst_2 : Module ℂ V] → [Fintype G] → Representation ℂ G V → (G →* ℂˣ) → V →ₗ[ℂ] V
'CM275.characterProjector' depends on axioms: [propext, Classical.choice, Quot.sound]
@CM275.characterProjector_apply : ∀ {G : Type u_1} {V : Type u_2} [inst : Group G] [inst_1 : AddCommGroup V]
  [inst_2 : Module ℂ V] [inst_3 : Fintype G] (ρ : Representation ℂ G V) (χ : G →* ℂˣ) (v : V),
  (CM275.characterProjector ρ χ) v = (↑(Fintype.card G))⁻¹ • ∑ g, (↑(χ g))⁻¹ • (ρ g) v
'CM275.characterProjector_apply' depends on axioms: [propext, Classical.choice, Quot.sound]
@CM275.twist_invariant_iff : ∀ {G : Type u_1} {V : Type u_2} [inst : Group G] [inst_1 : AddCommGroup V]
  [inst_2 : Module ℂ V] (ρ : Representation ℂ G V) (χ : G →* ℂˣ) (v : V),
  v ∈ (CM275.twist ρ χ).invariants ↔ ∀ (g : G), (ρ g) v = ↑(χ g) • v
'CM275.twist_invariant_iff' depends on axioms: [propext, Classical.choice, Quot.sound]
@CM275.characterProjector_eigen : ∀ {G : Type u_1} {V : Type u_2} [inst : Group G] [inst_1 : AddCommGroup V]
  [inst_2 : Module ℂ V] [inst_3 : Fintype G] (ρ : Representation ℂ G V) (χ : G →* ℂˣ) (v : V) (g : G),
  (ρ g) ((CM275.characterProjector ρ χ) v) = ↑(χ g) • (CM275.characterProjector ρ χ) v
'CM275.characterProjector_eigen' depends on axioms: [propext, Classical.choice, Quot.sound]
@CM275.characterProjector_fixes : ∀ {G : Type u_1} {V : Type u_2} [inst : Group G] [inst_1 : AddCommGroup V]
  [inst_2 : Module ℂ V] [inst_3 : Fintype G] (ρ : Representation ℂ G V) (χ : G →* ℂˣ) (v : V),
  (∀ (g : G), (ρ g) v = ↑(χ g) • v) → (CM275.characterProjector ρ χ) v = v
'CM275.characterProjector_fixes' depends on axioms: [propext, Classical.choice, Quot.sound]
@CM275.characterProjector_idempotent : ∀ {G : Type u_1} {V : Type u_2} [inst : Group G] [inst_1 : AddCommGroup V]
  [inst_2 : Module ℂ V] [inst_3 : Fintype G] (ρ : Representation ℂ G V) (χ : G →* ℂˣ) (v : V),
  (CM275.characterProjector ρ χ) ((CM275.characterProjector ρ χ) v) = (CM275.characterProjector ρ χ) v
'CM275.characterProjector_idempotent' depends on axioms: [propext, Classical.choice, Quot.sound]
@CM275.characterProjector_range : ∀ {G : Type u_1} {V : Type u_2} [inst : Group G] [inst_1 : AddCommGroup V]
  [inst_2 : Module ℂ V] [inst_3 : Fintype G] (ρ : Representation ℂ G V) (χ : G →* ℂˣ) (v : V),
  v ∈ (CM275.characterProjector ρ χ).range ↔ ∀ (g : G), (ρ g) v = ↑(χ g) • v
'CM275.characterProjector_range' depends on axioms: [propext, Classical.choice, Quot.sound]
@CM275.characterProjector_commutes : ∀ {G : Type u_1} {V : Type u_2} [inst : Group G] [inst_1 : AddCommGroup V]
  [inst_2 : Module ℂ V] [inst_3 : Fintype G] (ρ : Representation ℂ G V) (χ : G →* ℂˣ) (R : V →ₗ[ℂ] V),
  (∀ (g : G) (v : V), R ((ρ g) v) = (ρ g) (R v)) →
    ∀ (v : V), R ((CM275.characterProjector ρ χ) v) = (CM275.characterProjector ρ χ) (R v)
'CM275.characterProjector_commutes' depends on axioms: [propext, Classical.choice, Quot.sound]
@CM275.complexSign : {A : Type u_1} → [Fintype A] → [DecidableEq A] → Equiv.Perm A →* ℂˣ
'CM275.complexSign' depends on axioms: [propext, Classical.choice, Quot.sound]
@CM275.signProjector_eigen : ∀ {A : Type u_1} {V : Type u_2} [inst : Fintype A] [inst_1 : DecidableEq A]
  [inst_2 : AddCommGroup V] [inst_3 : Module ℂ V] (ρ : Representation ℂ (Equiv.Perm A) V) (v : V) (g : Equiv.Perm A),
  (ρ g) ((CM275.characterProjector ρ CM275.complexSign) v) =
    ↑↑(Equiv.Perm.sign g) • (CM275.characterProjector ρ CM275.complexSign) v
'CM275.signProjector_eigen' depends on axioms: [propext, Classical.choice, Quot.sound]
@CM275.complexSign_inverse : ∀ {A : Type u_1} [inst : Fintype A] [inst_1 : DecidableEq A] (g : Equiv.Perm A),
  (↑(CM275.complexSign g))⁻¹ = ↑↑(Equiv.Perm.sign g)
'CM275.complexSign_inverse' depends on axioms: [propext, Classical.choice, Quot.sound]
@CM275.signProjector_apply : ∀ {A : Type u_1} {V : Type u_2} [inst : Fintype A] [inst_1 : DecidableEq A]
  [inst_2 : AddCommGroup V] [inst_3 : Module ℂ V] (ρ : Representation ℂ (Equiv.Perm A) V) (v : V),
  (CM275.characterProjector ρ CM275.complexSign) v =
    (↑(Fintype.card (Equiv.Perm A)))⁻¹ • ∑ g, ↑↑(Equiv.Perm.sign g) • (ρ g) v
'CM275.signProjector_apply' depends on axioms: [propext, Classical.choice, Quot.sound]
CM275.acceptance : ℝ → ℝ → ℝ → ℝ
'CM275.acceptance' depends on axioms: [propext, Classical.choice, Quot.sound]
CM275.total_error_budget : ∀ (η : ℝ), 0 ≤ η → η + η / 4 + η / 8 + η / 16 ≤ 2 * η
'CM275.total_error_budget' depends on axioms: [propext, Classical.choice, Quot.sound]
CM275.total_energy_transfer : ∀ (E Ebox Ecap Eband Egrid η : ℝ),
  0 ≤ η →
    |Ebox - E| ≤ η → |Ecap - Ebox| ≤ η / 4 → |Eband - Ecap| ≤ η / 8 → |Egrid - Eband| ≤ η / 16 → |Egrid - E| ≤ 2 * η
'CM275.total_energy_transfer' depends on axioms: [propext, Classical.choice, Quot.sound]
CM275.yes_margin : ∀ (a b e η Q : ℝ),
  0 < Q → a < b → η ≤ (b - a) / 100 → e ≤ a + 2 * η → 1 / 2 + (b - a) / (10 * Q) ≤ CM275.acceptance e ((a + b) / 2) Q
'CM275.yes_margin' depends on axioms: [propext, Classical.choice, Quot.sound]
CM275.no_margin : ∀ (a b e η Q : ℝ),
  0 < Q → a < b → η ≤ (b - a) / 100 → b - 2 * η ≤ e → CM275.acceptance e ((a + b) / 2) Q ≤ 1 / 2 - (b - a) / (10 * Q)
'CM275.no_margin' depends on axioms: [propext, Classical.choice, Quot.sound]
CM275.approximation_yes : ∀ (p p' γ : ℝ), 1 / 2 + γ ≤ p → |p' - p| ≤ γ / 10 → 1 / 2 + 9 * γ / 10 ≤ p'
'CM275.approximation_yes' depends on axioms: [propext, Classical.choice, Quot.sound]
CM275.approximation_no : ∀ (p p' γ : ℝ), p ≤ 1 / 2 - γ → |p' - p| ≤ γ / 10 → p' ≤ 1 / 2 - 9 * γ / 10
'CM275.approximation_no' depends on axioms: [propext, Classical.choice, Quot.sound]
CM275.subnormalized_no : ∀ (w p bound : ℝ), 0 ≤ w → w ≤ 1 → 0 ≤ p → p ≤ bound → w * p ≤ bound
'CM275.subnormalized_no' depends on axioms: [propext, Classical.choice, Quot.sound]
CM275.subnormalized_approximation_no : ∀ (w p p' γ : ℝ),
  0 ≤ w → w ≤ 1 → 0 ≤ p → p ≤ 1 / 2 - γ → |p' - w * p| ≤ γ / 10 → p' ≤ 1 / 2 - 9 * γ / 10
'CM275.subnormalized_approximation_no' depends on axioms: [propext, Classical.choice, Quot.sound]
CM275.fair_test_identity : ∀ (kinetic potential threshold Q : ℝ),
  (1 / 2 - (kinetic - threshold) / (2 * Q) + (1 / 2 - potential / (2 * Q))) / 2 =
    CM275.acceptance (kinetic + potential) threshold Q
'CM275.fair_test_identity' depends on axioms: [propext, Classical.choice, Quot.sound]
CM275.probability_bounds : ∀ (energy threshold Q : ℝ),
  0 < Q →
    threshold - 2 * Q ≤ energy →
      energy ≤ threshold + 2 * Q → 0 ≤ CM275.acceptance energy threshold Q ∧ CM275.acceptance energy threshold Q ≤ 1
'CM275.probability_bounds' depends on axioms: [propext, Classical.choice, Quot.sound]
