@T205M.IsIdeal : {α : Type u_1} → [PartialOrder α] → Finset α → Prop
'T205M.IsIdeal' depends on axioms: [propext, Classical.choice, Quot.sound]
@T205M.empty_ideal : ∀ {α : Type u_1} [inst : PartialOrder α], T205M.IsIdeal ∅
'T205M.empty_ideal' depends on axioms: [propext, Classical.choice, Quot.sound]
@T205M.ideal_insert_minimal : ∀ {α : Type u_1} [inst : PartialOrder α] [inst_1 : DecidableEq α] {s t : Finset α},
  T205M.IsIdeal s →
    T205M.IsIdeal t → s ⊆ t → s.card < t.card → ∃ x ∈ t, x ∉ s ∧ T205M.IsIdeal (insert x s) ∧ insert x s ⊆ t
'T205M.ideal_insert_minimal' depends on axioms: [propext, Classical.choice, Quot.sound]
@T205M.ideal_interval_rank : ∀ {α : Type u_1} [inst : PartialOrder α] [DecidableEq α] {s t : Finset α},
  T205M.IsIdeal s →
    T205M.IsIdeal t → s ⊆ t → ∀ {r : ℕ}, s.card ≤ r → r ≤ t.card → ∃ u, T205M.IsIdeal u ∧ s ⊆ u ∧ u ⊆ t ∧ u.card = r
'T205M.ideal_interval_rank' depends on axioms: [propext, Classical.choice, Quot.sound]
@T205M.unique_rank_cross_comparable : ∀ {α : Type u_1} [inst : PartialOrder α] [DecidableEq α] [Fintype α]
  {s : Finset α},
  T205M.IsIdeal s → (∀ (t : Finset α), T205M.IsIdeal t → t.card = s.card → t = s) → ∀ {a b : α}, a ∈ s → b ∉ s → a ≤ b
'T205M.unique_rank_cross_comparable' depends on axioms: [propext, Classical.choice, Quot.sound]
@T205M.exists_second_ideal_of_incomparable : ∀ {α : Type u_1} [inst : PartialOrder α] [DecidableEq α] [Fintype α]
  {s : Finset α}, T205M.IsIdeal s → ∀ {a b : α}, a ∈ s → b ∉ s → ¬a ≤ b → ∃ t, T205M.IsIdeal t ∧ t.card = s.card ∧ t ≠ s
'T205M.exists_second_ideal_of_incomparable' depends on axioms: [propext, Classical.choice, Quot.sound]
@T205M.two_ideals_of_no_cut : ∀ {α : Type u_1} [inst : PartialOrder α] [DecidableEq α] [inst_2 : Fintype α] {r : ℕ},
  r ≤ Fintype.card α →
    (∀ (s : Finset α), T205M.IsIdeal s → s.card = r → ∃ a ∈ s, ∃ b ∉ s, ¬a ≤ b) →
      ∃ s t, T205M.IsIdeal s ∧ T205M.IsIdeal t ∧ s.card = r ∧ t.card = r ∧ s ≠ t
'T205M.two_ideals_of_no_cut' depends on axioms: [propext, Classical.choice, Quot.sound]
T205MControls.chainPrefix : Finset (Fin 4)
'T205MControls.chainPrefix' depends on axioms: [propext, Quot.sound]
T205MControls.chainPrefix_ideal : T205M.IsIdeal T205MControls.chainPrefix
'T205MControls.chainPrefix_ideal' depends on axioms: [propext, Classical.choice, Quot.sound]
T205MControls.chainPrefix_unique : ∀ (t : Finset (Fin 4)),
  T205M.IsIdeal t → t.card = T205MControls.chainPrefix.card → t = T205MControls.chainPrefix
'T205MControls.chainPrefix_unique' depends on axioms: [propext, Classical.choice, Quot.sound]
@T205MControls.chainPrefix_cross : ∀ {a b : Fin 4},
  a ∈ T205MControls.chainPrefix → b ∉ T205MControls.chainPrefix → a ≤ b
'T205MControls.chainPrefix_cross' depends on axioms: [propext, Classical.choice, Quot.sound]
T205MControls.product_has_rank_four : ∃ s, T205M.IsIdeal s ∧ s.card = 4
'T205MControls.product_has_rank_four' depends on axioms: [propext, Classical.choice, Quot.sound]
T205MControls.antichain_singleton_ideal : T205M.IsIdeal {T205MControls.Two.left}
'T205MControls.antichain_singleton_ideal' depends on axioms: [propext, Classical.choice, Quot.sound]
T205MControls.antichain_noncomparable : ¬T205MControls.Two.left ≤ T205MControls.Two.right
'T205MControls.antichain_noncomparable' does not depend on any axioms
T205MControls.antichain_second_ideal : ∃ t,
  T205M.IsIdeal t ∧ t.card = {T205MControls.Two.left}.card ∧ t ≠ {T205MControls.Two.left}
'T205MControls.antichain_second_ideal' depends on axioms: [propext, Classical.choice, Quot.sound]
T205MControls.uniqueness_cannot_be_dropped : ¬∀ (s : Finset T205MControls.Two),
    T205M.IsIdeal s → ∀ a ∈ s, ∀ b ∉ s, a ≤ b
'T205MControls.uniqueness_cannot_be_dropped' depends on axioms: [propext, Classical.choice, Quot.sound]
T205MControls.rank_upper_bound_cannot_be_dropped : ¬∃ s, T205M.IsIdeal s ∧ s.card = 4
'T205MControls.rank_upper_bound_cannot_be_dropped' depends on axioms: [propext, Classical.choice, Quot.sound]
