@tripleSum_column : ∀ {I : Type u_1} [inst : Fintype I] [DecidableEq I] {K : I → I → ℝ} {u : I → ℝ},
  (∀ (j : I), ∑ i, K i j = 1) →
    ∀ (j : I), ∑ i, ∑ k, K i j * K k j * (u i - u k) ^ 2 = 2 * (∑ i, K i j * u i ^ 2 - (∑ i, K i j * u i) ^ 2)
@bistochastic_variance : ∀ {I : Type u_1} [inst : Fintype I] [DecidableEq I] {K : I → I → ℝ} {u : I → ℝ},
  (∀ (i : I), ∑ j, K i j = 1) →
    (∀ (j : I), ∑ i, K i j = 1) →
      ∑ j, ∑ i, ∑ k, K i j * K k j * (u i - u k) ^ 2 = 2 * (∑ i, u i ^ 2 - ∑ j, (∑ i, K i j * u i) ^ 2)
@variance_deficit_nonneg : ∀ {I : Type u_1} [inst : Fintype I] [DecidableEq I] {K : I → I → ℝ} {u : I → ℝ},
  (∀ (i : I), ∑ j, K i j = 1) →
    (∀ (j : I), ∑ i, K i j = 1) → (∀ (i j : I), 0 ≤ K i j) → 0 ≤ ∑ i, u i ^ 2 - ∑ j, (∑ i, K i j * u i) ^ 2
'tripleSum_column' depends on axioms: [propext, Classical.choice, Quot.sound]
'bistochastic_variance' depends on axioms: [propext, Classical.choice, Quot.sound]
'variance_deficit_nonneg' depends on axioms: [propext, Classical.choice, Quot.sound]
