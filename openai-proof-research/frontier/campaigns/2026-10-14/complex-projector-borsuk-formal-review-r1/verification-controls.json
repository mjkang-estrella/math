  "note": "Controls ran against the provisional manifest; final manifest adds this receipt and is checked again.",
  "controls": [
    {
      "case": "wrong-anchor",
      "exit": 1,
      "message": "REJECT: external manifest anchor mismatch\n"
    },
    {
      "case": "extra-file",
      "exit": 1,
      "message": "REJECT: exact file membership mismatch\n"
    },
    {
      "case": "empty-directory",
      "exit": 1,
      "message": "REJECT: exact directory membership mismatch\n"
    }
  ]
}
