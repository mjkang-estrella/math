BorsukLocal.favored : ℝ → ℝ → ℝ → ℝ
'BorsukLocal.favored' depends on axioms: [propext, Classical.choice, Quot.sound]
BorsukLocal.other : ℝ → ℝ → ℝ → ℝ
'BorsukLocal.other' depends on axioms: [propext, Classical.choice, Quot.sound]
BorsukLocal.radius : ℝ
'BorsukLocal.radius' depends on axioms: [propext, Classical.choice, Quot.sound]
@BorsukLocal.favored_case : ∀ {a b ε : ℝ}, 0 < ε → ε ≤ 1 / 50 → b ^ 2 ≤ a → 9 / 25 * ε ≤ BorsukLocal.favored a b ε
'BorsukLocal.favored_case' depends on axioms: [propext, Classical.choice, Quot.sound]
@BorsukLocal.transverse_square : ∀ {a b : ℝ}, 0 ≤ a → 0 ≤ b → b ≤ 1 / 10 → a < b ^ 2 → a ^ 2 < b / 1000
'BorsukLocal.transverse_square' depends on axioms: [propext, Classical.choice, Quot.sound]
@BorsukLocal.other_large_case : ∀ {a b ε : ℝ},
  0 ≤ a → 0 ≤ b → b ≤ 1 / 10 → 0 < ε → ε ≤ 1 / 50 → a < b ^ 2 → 4 * ε ≤ b → 353 / 500 * ε < BorsukLocal.other a b ε
'BorsukLocal.other_large_case' depends on axioms: [propext, Classical.choice, Quot.sound]
@BorsukLocal.favored_small_case : ∀ {a b ε : ℝ},
  0 ≤ a → 0 ≤ b → 0 < ε → ε ≤ 1 / 50 → b < 4 * ε → ε / 25 < BorsukLocal.favored a b ε
'BorsukLocal.favored_small_case' depends on axioms: [propext, Classical.choice, Quot.sound]
@BorsukLocal.two_trio_margin : ∀ {a b ε : ℝ},
  0 ≤ a → 0 ≤ b → b ≤ 1 / 10 → 0 < ε → ε ≤ 1 / 50 → ε / 25 < max (BorsukLocal.favored a b ε) (BorsukLocal.other a b ε)
'BorsukLocal.two_trio_margin' depends on axioms: [propext, Classical.choice, Quot.sound]
BorsukLocal.favored_radical_lower : 2 / 5 < 1 / √6
'BorsukLocal.favored_radical_lower' depends on axioms: [propext, Classical.choice, Quot.sound]
BorsukLocal.other_radical_upper : 2 * √2 + 1 / √6 < 13 / 4
'BorsukLocal.other_radical_upper' depends on axioms: [propext, Classical.choice, Quot.sound]
BorsukLocal.radius_sq : BorsukLocal.radius ^ 2 = 1 / 432
'BorsukLocal.radius_sq' depends on axioms: [propext, Classical.choice, Quot.sound]
BorsukLocal.radius_bounds : 0 < BorsukLocal.radius ∧ BorsukLocal.radius < 1 / 20 ∧ BorsukLocal.radius ^ 3 < 1 / 1000
'BorsukLocal.radius_bounds' depends on axioms: [propext, Classical.choice, Quot.sound]
@BorsukLocal.chart_bounds : ∀ {a b : ℝ},
  0 ≤ a → 0 ≤ b → a ^ 2 + b ^ 2 < BorsukLocal.radius ^ 2 → a < 1 / 20 ∧ b < 1 / 20 ∧ 1 + a ^ 2 + b ^ 2 < 2
'BorsukLocal.chart_bounds' depends on axioms: [propext, Classical.choice, Quot.sound]
@BorsukLocal.two_trio_scaled_positive : ∀ {a b ε E₁ E₂ : ℝ},
  0 ≤ a →
    0 ≤ b →
      a ^ 2 + b ^ 2 < BorsukLocal.radius ^ 2 →
        0 < ε →
          ε ≤ 1 / 50 →
            a - b ^ 2 + ε / √6 - 2 * ε ^ 2 < E₁ → b - a ^ 2 - (2 * √2 + 1 / √6) * ε - 2 * ε ^ 2 ≤ E₂ → 0 < E₁ ∨ 0 < E₂
'BorsukLocal.two_trio_scaled_positive' depends on axioms: [propext, Classical.choice, Quot.sound]
@BorsukLocal.local_score_improves : ∀ {a b ε x y : ℝ},
  0 ≤ a →
    0 ≤ b →
      a ^ 2 + b ^ 2 < BorsukLocal.radius ^ 2 →
        0 < ε →
          ε ≤ 1 / 50 →
            a - b ^ 2 + ε / √6 - 2 * ε ^ 2 < 2 * (1 + a ^ 2 + b ^ 2) * (1 + ε ^ 2) * (x - 1 / 2) →
              b - a ^ 2 - (2 * √2 + 1 / √6) * ε - 2 * ε ^ 2 ≤ 2 * (1 + a ^ 2 + b ^ 2) * (1 + ε ^ 2) * (y - 1 / 2) →
                1 / 2 < x ∨ 1 / 2 < y
'BorsukLocal.local_score_improves' depends on axioms: [propext, Classical.choice, Quot.sound]
@BorsukLocal.bessel_cap_incompatible : ∀ {x y δ : ℝ}, 0 < δ → 1 / 2 + δ ≤ x → 1 / 2 + δ ≤ y → ¬x + y ≤ 1
'BorsukLocal.bessel_cap_incompatible' depends on axioms: [propext, Classical.choice, Quot.sound]
@BorsukLocal.complementary_margin : ∀ {η ε M₀ Mε : ℝ},
  0 < η → ε ≤ η / 3 → 1 / 2 + η ≤ M₀ → M₀ - 2 * ε ≤ Mε → 1 / 2 + η / 3 ≤ Mε ∧ 1 / 2 < Mε
'BorsukLocal.complementary_margin' depends on axioms: [propext, Classical.choice, Quot.sound]
BorsukLocal.score_numerator_expansion : ∀ (q D : ℂ) (ε b : ℝ),
  Complex.normSq (1 + q + ↑(√2 * ε) * D) - (1 + ε ^ 2) * (1 + Complex.normSq q + b ^ 2) =
    2 * q.re - b ^ 2 + 2 * √2 * ε * ((starRingEnd ℂ) (1 + q) * D).re + 2 * ε ^ 2 * Complex.normSq D -
      ε ^ 2 * (1 + Complex.normSq q + b ^ 2)
'BorsukLocal.score_numerator_expansion' depends on axioms: [propext, Classical.choice, Quot.sound]
BorsukLocal.score_scaled_expansion : ∀ (q D : ℂ) (ε b : ℝ),
  2 * (1 + Complex.normSq q + b ^ 2) * (1 + ε ^ 2) *
      (Complex.normSq (1 + q + ↑(√2 * ε) * D) / (2 * (1 + Complex.normSq q + b ^ 2) * (1 + ε ^ 2)) - 1 / 2) =
    2 * q.re - b ^ 2 + 2 * √2 * ε * ((starRingEnd ℂ) (1 + q) * D).re + 2 * ε ^ 2 * Complex.normSq D -
      ε ^ 2 * (1 + Complex.normSq q + b ^ 2)
'BorsukLocal.score_scaled_expansion' depends on axioms: [propext, Classical.choice, Quot.sound]
