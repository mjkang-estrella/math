T224G.birth_identity : ∀ (f : Bool → Bool → ℝ) (w u b : Bool),
  T224G.Sandwich w u b →
    T224G.birthDifference f w u b =
      (f false true - f false false + T224G.mixedCoefficient f / 2) * T224G.drift w u b -
        T224G.mixedCoefficient f * T224G.pivotal w b / 4
