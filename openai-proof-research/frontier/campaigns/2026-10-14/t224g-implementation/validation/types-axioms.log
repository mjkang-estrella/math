T224G.pair_kernel : ∀ (w u b w' u' b' : Bool),
  T224G.Sandwich w u b →
    T224G.Sandwich w' u' b' →
      ((T224G.bit w - T224G.bit u) * (T224G.bit w' - T224G.bit u') +
            (T224G.bit b - T224G.bit u) * (T224G.bit b' - T224G.bit u')) /
          2 =
        T224G.pivotal w b * T224G.pivotal w' b' / 2 * if u = u' then 1 else 0
