Independent.budgetDegree : Bool → ℤ
'Independent.budgetDegree' does not depend on any axioms
Independent.sharp_degree_budget : (∀ (a : Bool), 2 ≤ Independent.budgetDegree a) ∧
  ∑ a, (Independent.budgetDegree a - 1) = ↑(Fintype.card Bool) * (2 - 1) + 1 ∧
    ∀ (a : Bool), Independent.budgetDegree a < 2 * 2
'Independent.sharp_degree_budget' depends on axioms: [propext, Classical.choice, Quot.sound]
Independent.badDegree : Bool → ℤ
'Independent.badDegree' does not depend on any axioms
Independent.minimum_degree_essential : ∑ a, (Independent.badDegree a - 1) ≤ ↑(Fintype.card Bool) * (2 - 1) + 1 ∧
  ¬Independent.badDegree true < 2 * 2
'Independent.minimum_degree_essential' depends on axioms: [propext, Classical.choice, Quot.sound]
Independent.inward : Bool → Bool → Prop
'Independent.inward' does not depend on any axioms
Independent.one_way_saturation_insufficient : AGM063.Preserves Independent.inward {false} ∧
  ¬AGM063.Saturated Independent.inward {false}
'Independent.one_way_saturation_insufficient' depends on axioms: [propext]
Independent.quotient_constancy_essential : AGM063.Saturated (fun x x_1 => True) Set.univ ∧
  (false, true) ∉ AGM063.fiberPairs Set.univ fun x => ↑x
'Independent.quotient_constancy_essential' depends on axioms: [propext, Classical.choice, Quot.sound]
Independent.nonempty_nonspanning : {0}.Nonempty ∧ (∀ v ∈ {0}, LinearMap.id v = 0) ∧ 0 < LinearMap.id 1
'Independent.nonempty_nonspanning' depends on axioms: [propext, Classical.choice, Quot.sound]
Independent.integer_multiplicity_essential : 0 < 2 ∧ 2 ≤ 2 ∧ 1 ≤ 3 / 2 ∧ 3 / 2 * 2 < 2 * 2 ∧ 3 / 2 ≠ 1
'Independent.integer_multiplicity_essential' depends on axioms: [propext, Classical.choice, Quot.sound]
Independent.integer_pseudoindex_essential : 3 ≥ 3 ∧ 2 ≤ 5 / 2 ∧ (3 - 1) * (5 / 2 - 2) ≤ 1 ∧ 5 / 2 ≠ 2
'Independent.integer_pseudoindex_essential' depends on axioms: [propext, Classical.choice, Quot.sound]
Independent.sharp_dimension : 2 * 4 - 1 ≤ 7 ∧ 7 ≤ max (2 * 4 - 1) (2 * 4 - 2) ∧ ¬7 ≤ max (2 * 4 - 2) (2 * 4 - 2)
'Independent.sharp_dimension' depends on axioms: [propext, Classical.choice, Quot.sound]
Independent.properness_and_nonempty_essential : AGM063.Preserves (fun x x_1 => True) Set.univ ∧
  AGM063.Preserves (fun x x_1 => True) ∅ ∧ ∀ (x y : Bool), Relation.ReflTransGen (fun x x_1 => True) x y
'Independent.properness_and_nonempty_essential' does not depend on any axioms
