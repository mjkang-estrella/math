def T088P133.firstBracket : ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ :=
fun α β p q d A B => p * A * β + q * B * α - d * α * β
def T088P133.secondBracket : ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ :=
fun α β p q d A B => A * B - d * (p * α * B + q * β * A)
def T088P133.mixture : ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ :=
fun α β p q d A B => (1 + d) * (p * α / (α + A) + q * β / (β + B))
T088P133Review.strict_interface : ∀ (α β p q d P N : ℝ),
  0 < α →
    0 < β →
      α + β = 2 →
        0 < p →
          p < 1 →
            q = 1 - p →
              0 ≤ d →
                0 < P →
                  0 < N →
                    2 * d * p ^ 2 < P → 2 * d * q ^ 2 ≤ N → (1 + d) * (p * α / (α + P / p) + q * β / (β + N / q)) < 1
'T088P133Review.strict_interface' depends on axioms: [propext, Classical.choice, Quot.sound]
T088P133Review.nonstrict_interface : ∀ (α β p q d P N : ℝ),
  0 < α →
    0 < β →
      α + β = 2 →
        0 < p →
          p < 1 →
            q = 1 - p →
              0 ≤ d →
                0 < P →
                  0 < N →
                    2 * d * p ^ 2 ≤ P → 2 * d * q ^ 2 ≤ N → (1 + d) * (p * α / (α + P / p) + q * β / (β + N / q)) ≤ 1
'T088P133Review.nonstrict_interface' depends on axioms: [propext, Classical.choice, Quot.sound]
T088P133Review.means_interface : ∀ (p q P N : ℝ),
  0 < p → p < 1 → q = 1 - p → 0 < P → 0 < N → 0 < q ∧ 0 < P / p ∧ 0 < N / q ∧ p * (P / p) = P ∧ q * (N / q) = N
'T088P133Review.means_interface' depends on axioms: [propext, Classical.choice, Quot.sound]
T088P133Review.strict_moment_interface : ∀ (d p P : ℝ), 0 < p → (2 * d * p ^ 2 < P ↔ 2 * d * p < P / p)
'T088P133Review.strict_moment_interface' depends on axioms: [propext, Classical.choice, Quot.sound]
T088P133Review.weak_moment_interface : ∀ (d p P : ℝ), 0 < p → (2 * d * p ^ 2 ≤ P ↔ 2 * d * p ≤ P / p)
'T088P133Review.weak_moment_interface' depends on axioms: [propext, Classical.choice, Quot.sound]
T088P133Review.one_sided_interface : ∀ (a d M : ℝ), 0 < a → a < 2 → 0 < M → 2 * d ≤ M → (1 + d) / (1 + M / a) < 1
'T088P133Review.one_sided_interface' depends on axioms: [propext, Classical.choice, Quot.sound]
T088P133Review.p_one_interface : ∀ (α β d P : ℝ),
  0 < α → 0 < β → α + β = 2 → 0 < P → 2 * d ≤ P → (1 + d) / (1 + P / α) < 1
'T088P133Review.p_one_interface' depends on axioms: [propext, Classical.choice, Quot.sound]
T088P133Review.p_zero_interface : ∀ (α β d N : ℝ),
  0 < α → 0 < β → α + β = 2 → 0 < N → 2 * d ≤ N → (1 + d) / (1 + N / β) < 1
'T088P133Review.p_zero_interface' depends on axioms: [propext, Classical.choice, Quot.sound]
T088P133Review.definition_contract : ∀ (α β p q d A B : ℝ),
  T088P133.firstBracket α β p q d A B = p * A * β + q * B * α - d * α * β ∧
    T088P133.secondBracket α β p q d A B = A * B - d * (p * α * B + q * β * A) ∧
      T088P133.mixture α β p q d A B = (1 + d) * (p * α / (α + A) + q * β / (β + B))
'T088P133Review.definition_contract' depends on axioms: [propext, Classical.choice, Quot.sound]
T088P133Review.original_first_bracket : ∀ (α β p q d P N : ℝ),
  α ≠ 0 → β ≠ 0 → p ≠ 0 → q ≠ 0 → T088P133.firstBracket α β p q d (P / p) (N / q) / (α * β) = P / α + N / β - d
'T088P133Review.original_first_bracket' depends on axioms: [propext, Classical.choice, Quot.sound]
T088P133Review.original_second_bracket : ∀ (α β p q d P N : ℝ),
  α ≠ 0 →
    β ≠ 0 →
      p ≠ 0 →
        q ≠ 0 →
          P ≠ 0 →
            N ≠ 0 →
              T088P133.secondBracket α β p q d (P / p) (N / q) / (α * β) =
                P / p * (N / q) / (α * β) * (1 - d * (p ^ 2 * α / P + q ^ 2 * β / N))
'T088P133Review.original_second_bracket' depends on axioms: [propext, Classical.choice, Quot.sound]
T088P133Review.original_normalized_slack : ∀ (α β p q d P N : ℝ),
  α ≠ 0 →
    β ≠ 0 →
      p ≠ 0 →
        q ≠ 0 →
          P ≠ 0 →
            N ≠ 0 →
              q = 1 - p →
                α + P / p ≠ 0 →
                  β + N / q ≠ 0 →
                    (α + P / p) * (β + N / q) * (1 - T088P133.mixture α β p q d (P / p) (N / q)) / (α * β) =
                      P / α + N / β - d + P / p * (N / q) / (α * β) * (1 - d * (p ^ 2 * α / P + q ^ 2 * β / N))
'T088P133Review.original_normalized_slack' depends on axioms: [propext, Classical.choice, Quot.sound]
T088P133Review.scalar_majorization_use : ∀ (α β p q d P N L : ℝ),
  0 < α →
    0 < β →
      α + β = 2 →
        0 < p →
          p < 1 →
            q = 1 - p →
              0 ≤ d →
                0 < P →
                  0 < N →
                    2 * d * p ^ 2 < P →
                      2 * d * q ^ 2 ≤ N → L ≤ p * α / (α + P / p) + q * β / (β + N / q) → (1 + d) * L < 1
'T088P133Review.scalar_majorization_use' depends on axioms: [propext, Classical.choice, Quot.sound]
T088P133Review.endpoint_expression : ∀ (a d M : ℝ), 0 < a → 0 < M → (1 + d) * a / (a + M) = (1 + d) / (1 + M / a)
'T088P133Review.endpoint_expression' depends on axioms: [propext, Classical.choice, Quot.sound]
T088P133Review.endpoint_negative_d : (1 + -2) / (1 + 1 / 1) = -1 / 2 ∧ (1 + -2) / (1 + 1 / 1) < 1
'T088P133Review.endpoint_negative_d' depends on axioms: [propext, Classical.choice, Quot.sound]
