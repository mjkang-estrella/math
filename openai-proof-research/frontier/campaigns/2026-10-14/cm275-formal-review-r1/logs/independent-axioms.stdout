ReviewControls.centered_alias_counterexample : ¬Function.Injective fun i => ↑↑i - 2
'ReviewControls.centered_alias_counterexample' depends on axioms: [propext, Classical.choice, Quot.sound]
ReviewControls.centered_endpoint_valid : Function.Injective fun i => ↑↑i - 2
'ReviewControls.centered_endpoint_valid' depends on axioms: [propext, Classical.choice, Quot.sound]
ReviewControls.duplicate_character_sample (x : ZMod 1) : CM275.sample (fun x => CM275.mode 0) (fun x => 1) x = 2
'ReviewControls.duplicate_character_sample' depends on axioms: [propext, Classical.choice, Quot.sound]
ReviewControls.duplicate_character_energy :
  ⟪CM275.sample (fun x => CM275.mode 0) fun x => 1, CM275.sample (fun x => CM275.mode 0) fun x => 1⟫ₙ_[ℂ] = 4
'ReviewControls.duplicate_character_energy' depends on axioms: [propext, Classical.choice, Quot.sound]
ReviewControls.duplicate_character_invalid_parseval :
  ⟪CM275.sample (fun x => CM275.mode 0) fun x => 1, CM275.sample (fun x => CM275.mode 0) fun x => 1⟫ₙ_[ℂ] ≠
    ∑ x, star 1 * 1
'ReviewControls.duplicate_character_invalid_parseval' depends on axioms: [propext, Classical.choice, Quot.sound]
ReviewControls.singleton_frequency_injective : Function.Injective fun x => CM275.mode 0
'ReviewControls.singleton_frequency_injective' depends on axioms: [propext, Classical.choice, Quot.sound]
ReviewControls.nonunit_phase_energy :
  ⟪CM275.sample (fun x => CM275.mode 0) fun x => 2, CM275.sample (fun x => CM275.mode 0) fun x => 2⟫ₙ_[ℂ] = 4
'ReviewControls.nonunit_phase_energy' depends on axioms: [propext, Classical.choice, Quot.sound]
ReviewControls.nonunit_phase_not_isometry :
  ⟪CM275.sample (fun x => CM275.mode 0) fun x => 2, CM275.sample (fun x => CM275.mode 0) fun x => 2⟫ₙ_[ℂ] ≠
    ⟪CM275.sample (fun x => CM275.mode 0) fun x => 1, CM275.sample (fun x => CM275.mode 0) fun x => 1⟫ₙ_[ℂ]
'ReviewControls.nonunit_phase_not_isometry' depends on axioms: [propext, Classical.choice, Quot.sound]
ReviewControls.trivial_representation_fixed (v : ℂ) :
  (CM275.characterProjector (Representation.trivial ℂ (Equiv.Perm (Fin 2)) ℂ) 1) v = v
'ReviewControls.trivial_representation_fixed' depends on axioms: [propext, Classical.choice, Quot.sound]
ReviewControls.trivial_action_sign_zero :
  (CM275.characterProjector (Representation.trivial ℂ (Equiv.Perm (Fin 2)) ℂ) CM275.complexSign) 1 = 0
'ReviewControls.trivial_action_sign_zero' depends on axioms: [propext, Classical.choice, Quot.sound]
ReviewAlgebra.failure_weight_above_one_counterexample : ¬2 * (1 / 2) ≤ 1 / 2
'ReviewAlgebra.failure_weight_above_one_counterexample' depends on axioms: [propext, Classical.choice, Quot.sound]
ReviewAlgebra.negative_probability_counterexample : ¬0 * -1 ≤ -1
'ReviewAlgebra.negative_probability_counterexample' depends on axioms: [propext, Classical.choice, Quot.sound]
ReviewAlgebra.oblique (v : ℂ × ℂ) : ℂ × ℂ
'ReviewAlgebra.oblique' depends on axioms: [propext, Classical.choice, Quot.sound]
ReviewAlgebra.involution (v : ℂ × ℂ) : ℂ × ℂ
'ReviewAlgebra.involution' depends on axioms: [propext, Classical.choice, Quot.sound]
ReviewAlgebra.euclideanPair (v w : ℂ × ℂ) : ℂ
'ReviewAlgebra.euclideanPair' depends on axioms: [propext, Classical.choice, Quot.sound]
ReviewAlgebra.involution_square (v : ℂ × ℂ) : ReviewAlgebra.involution (ReviewAlgebra.involution v) = v
'ReviewAlgebra.involution_square' depends on axioms: [propext, Classical.choice, Quot.sound]
ReviewAlgebra.oblique_is_average (v : ℂ × ℂ) :
  ReviewAlgebra.oblique v = ((v.1 + (ReviewAlgebra.involution v).1) / 2, (v.2 + (ReviewAlgebra.involution v).2) / 2)
'ReviewAlgebra.oblique_is_average' depends on axioms: [propext, Classical.choice, Quot.sound]
ReviewAlgebra.oblique_idempotent (v : ℂ × ℂ) : ReviewAlgebra.oblique (ReviewAlgebra.oblique v) = ReviewAlgebra.oblique v
'ReviewAlgebra.oblique_idempotent' depends on axioms: [propext, Classical.choice, Quot.sound]
ReviewAlgebra.oblique_not_selfadjoint :
  ReviewAlgebra.euclideanPair (ReviewAlgebra.oblique (0, 1)) (1, 0) ≠
    ReviewAlgebra.euclideanPair (0, 1) (ReviewAlgebra.oblique (1, 0))
'ReviewAlgebra.oblique_not_selfadjoint' depends on axioms: [propext, Classical.choice, Quot.sound]
