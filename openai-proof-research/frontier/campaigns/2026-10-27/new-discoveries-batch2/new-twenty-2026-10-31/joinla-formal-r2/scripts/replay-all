#!/bin/bash
set -eu
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
mkdir -p logs outputs
for module in AntimagicBasics AntimagicIso Antimagic LauShiu Counts Endpoint Audit; do
 if [ "${RESUME:-0}" != 1 ] || [ ! -f "logs/$module.build.ok" ]; then
  scripts/replay build "$module" > "logs/$module.build.log" 2>&1
  touch "logs/$module.build.ok"
 fi
 if [ "${RESUME:-0}" != 1 ] || [ ! -f "logs/$module.check.ok" ]; then
  scripts/replay check "$module" > "logs/$module.check.log" 2>&1
  touch "logs/$module.check.ok"
 fi
done
scripts/run python3 -I scripts/validate.py > logs/validate.log 2>&1
