open Lean Elab Command
set_option maxRecDepth 10000
set_option maxHeartbeats 0
run_cmd do
  let env ← getEnv
  let localMods := #[`GridBasic, `GridSymmetry, `GridFinal, `GridChecks, `GridRegression, `GridPropagation, `GridNeighbours, `GridLattice, `GridDeterminism, `GridTransport, `GridFinal2, `GridFiniteCodes, `GridExceptionalPartitions, `GridExceptionalTwo, `GridExceptionalCounts, `GridExceptionalCountTwo, `GridExceptionalSubgroups, `GridExceptional, `GridFreePaths, `GridFinal3, `GridDegrees, `GridSideRigidity, `GridFreeClassification, `GridOrbitPaths, `GridTransposeGroup, `GridOrbitSmall, `GridFinal4, `GridLadderLayers, `GridLadderOrbit, `GridOrdinaryLayers, `GridBorderWalk, `GridSideColors, `GridFinal5, `GridColorFlags, `GridColorTiming, `GridCornerColors, `GridSideAlignment, `GridInternalFlags, `GridBorderFrames, `GridOrdinaryBorder, `GridFinal6]
  let mut endpointModules : NameSet := ({} : NameSet).insert `GridFinal6
  for _ in [:env.header.moduleNames.size] do
    for i in [:env.header.moduleNames.size] do
      if endpointModules.contains env.header.moduleNames[i]! then
        for imp in env.header.moduleData[i]!.imports do
          endpointModules := endpointModules.insert imp.module
  let mut endpointInventory : NameSet := {}
  for i in [:env.header.moduleNames.size] do
    if endpointModules.contains env.header.moduleNames[i]! then
      for n in env.header.moduleData[i]!.constNames do
        endpointInventory := endpointInventory.insert n
  let mut endpointAudited : NameSet := {}
  let mut inventory : NameSet := {}
  for md in env.header.moduleData do
    for n in md.constNames do
      inventory := inventory.insert n
  let mut audited : NameSet := {}
  let mut rows : Array String := #[]
  let mut localCount : Nat := 0
  for (n, ci) in env.constants do
    if let some idx := env.getModuleIdxFor? n then
      let ci := (env.checked.get.find? n).getD ci
      let modName := env.header.moduleNames[idx.toNat]!
      let isLocal := localMods.contains modName
      let inEndpoint := endpointModules.contains modName
      if inEndpoint then endpointAudited := endpointAudited.insert n
      let axs ← collectAxioms n
      let ib := (Compiler.getImplementedBy? env n).isSome
      let ex := (externAttr.getParam? env n).isSome
      let companion := decide ((n.toString.splitOn "_unsafe_rec").length > 1)
      if isLocal then
        localCount := localCount + 1
        if ci.isUnsafe || ci.isPartial || ci.isAxiom || ib || ex || companion then
          throwError "Forbidden LOCAL metadata {n}"
        for a in axs do
          unless #[`propext, `Classical.choice, `Quot.sound].contains a do
            throwError "Forbidden LOCAL transitive axiom {n}: {a}"
      let mut deps := ci.type.getUsedConstants
      if let some v := ci.value? (allowOpaque := true) then
        deps := deps ++ v.getUsedConstants
      let row := Json.mkObj [
        ("name", toJson n.toString), ("module", toJson modName.toString),
        ("local", toJson isLocal), ("endpoint_import_closure", toJson inEndpoint), ("unsafe", toJson ci.isUnsafe),
        ("partial", toJson ci.isPartial), ("axiom", toJson ci.isAxiom),
        ("unsafe_rec", toJson companion), ("implemented_by", toJson ib),
        ("extern", toJson ex), ("axioms", toJson (axs.map Name.toString)),
        ("deps_allowOpaque", toJson (deps.map Name.toString))]
      rows := rows.push row.compress
      audited := audited.insert n
  for n in inventory do
    unless audited.contains n do throwError "Missing inventory declaration {n}"
  for n in audited do
    unless inventory.contains n do throwError "Audit outside inventory {n}"
  for n in endpointInventory do
    unless endpointAudited.contains n do throwError "Missing endpoint declaration {n}"
  for n in endpointAudited do
    unless endpointInventory.contains n do throwError "Outside endpoint closure {n}"
  logInfo m!"ENDPOINT inventory={endpointInventory.size} audited={endpointAudited.size}; sets equal"
  liftIO <| IO.FS.writeFile "audit.jsonl" (String.intercalate "\n" rows.toList ++ "\n")
  liftIO <| IO.FS.writeFile "import-closure.txt"
    (String.intercalate "\n" (env.header.moduleNames.toList.map Name.toString))
  logInfo m!"AUDIT inventory={inventory.size} audited={audited.size} LOCAL={localCount}; sets equal"
