/-
  MathDB 355956 (Yip's maximal subfield clique conjecture, arXiv:2209.00864 Conj. 1.1 = Yip 2022 Conj. 1.4):
  "Let d>1. Let q ≡ 1 (mod 2d) be a power of a prime p, and let r be the largest integer such that
   d | (q-1)/(p^r-1). Then the subfield F_{p^r} forms a maximal clique in GP(q,d) = Cay(F_q^+, (F_q^*)^d)."
  We prove the literal conjecture FALSE: for q = 5^8, d = 3 one has r = 1, and in every field K with
  5^8 elements the prime subfield F_5 = {z | z^5 = z} is a clique but not a maximal clique.
  Generated by scripts/gen_yip_lean.py; certificates are exact integer identities checked by `ring`.
-/
import Mathlib

open Polynomial

namespace MathDB355956

/-- The connection set `(K^*)^d` of the generalized Paley graph: nonzero `d`-th powers. -/
def dPowers (K : Type*) [Field K] (d : ℕ) : Set K := {w | ∃ y : K, y ≠ 0 ∧ y ^ d = w}

/-- Adjacency in `GP(q,d) = Cay(F_q^+, (F_q^*)^d)`: `g ~ h` iff `g - h ∈ (F_q^*)^d`. -/
def GPAdj (K : Type*) [Field K] (d : ℕ) (g h : K) : Prop := g - h ∈ dPowers K d

/-- A clique: every two distinct vertices are adjacent. -/
def IsGPClique (K : Type*) [Field K] (d : ℕ) (C : Set K) : Prop :=
  ∀ u ∈ C, ∀ v ∈ C, u ≠ v → GPAdj K d u v

/-- A maximal clique: a clique not contained in a strictly larger clique. -/
def IsMaximalGPClique (K : Type*) [Field K] (d : ℕ) (C : Set K) : Prop :=
  IsGPClique K d C ∧ ∀ C' : Set K, IsGPClique K d C' → C ⊆ C' → C' = C

/-- The subfield `F_{p^r}` of `F_q` (`r ∣ m`), i.e. the roots of `X^(p^r) - X`. -/
def subfieldSet (K : Type*) [Field K] (pr : ℕ) : Set K := {z | z ^ pr = z}

/-- The set of admissible `r`: positive integers with `(q-1)/(p^r-1)` an integer divisible by `d`. -/
def admissibleR (p m d : ℕ) : Set ℕ :=
  {r | 0 < r ∧ (p ^ r - 1) ∣ (p ^ m - 1) ∧ d ∣ (p ^ m - 1) / (p ^ r - 1)}

/-- Yip's conjecture, literally (for every finite field `K = F_q`, `q = p^m`). -/
def YipConjecture : Prop :=
  ∀ (d p m : ℕ) (K : Type) [Field K] [Finite K], 1 < d → p.Prime → 0 < m →
    Nat.card K = p ^ m → p ^ m ≡ 1 [MOD 2 * d] →
    ∀ r : ℕ, IsGreatest (admissibleR p m d) r → IsMaximalGPClique K d (subfieldSet K (p ^ r))

theorem admissibleR_greatest : IsGreatest (admissibleR 5 8 3) 1 := by
  refine ⟨⟨by norm_num, by norm_num, by norm_num⟩, ?_⟩
  rintro r ⟨hr0, hdvd, h3⟩
  have hle : 5 ^ r - 1 ≤ 5 ^ 8 - 1 := Nat.le_of_dvd (by norm_num) hdvd
  have hr8 : r ≤ 8 := by
    rcases Nat.lt_or_ge r 9 with h9 | h9
    · omega
    · have : 5 ^ 9 ≤ 5 ^ r := Nat.pow_le_pow_right (by norm_num) h9
      omega
  interval_cases r <;> simp_all (config := {decide := true})

