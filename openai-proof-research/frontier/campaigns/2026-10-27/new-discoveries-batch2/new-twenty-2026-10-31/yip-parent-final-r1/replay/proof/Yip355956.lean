theorem exists_root [Finite K] (hK : Nat.card K = 5 ^ 8) :
    ∃ θ : K, θ ^ 8 + θ ^ 7 + 2 * θ ^ 6 + 2 = 0 := by
  have h5 := five_eq_zero_of_card hK
  have hspl : Splits (X ^ (Nat.card K) - X : K[X]) := Polynomial.splits_X_pow_nat_card_sub_X
  rw [hK] at hspl
  have hne : (X ^ (5 ^ 8) - X : K[X]) ≠ 0 := FiniteField.X_pow_card_sub_X_ne_zero K (by norm_num)
  have hf : Splits (fK K) := hspl.of_dvd hne (fK_dvd h5)
  have hdeg : (fK K).degree ≠ 0 := by
    rw [Polynomial.degree_eq_natDegree (fK_monic).ne_zero, fK_natDegree]; decide
  obtain ⟨θ, hθ⟩ := hf.exists_eval_eq_zero hdeg
  exact ⟨θ, by simpa [fK] using hθ⟩


