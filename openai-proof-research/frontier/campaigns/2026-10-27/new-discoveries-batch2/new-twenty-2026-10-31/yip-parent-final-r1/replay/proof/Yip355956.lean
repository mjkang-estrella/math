    rcases ha with rfl | rfl | rfl | rfl | rfl

    · exact ⟨_, cube_0 θ hθ h5, fun h => one_ne_zero (by rw [← inv_0 θ hθ h5, h, zero_mul])⟩
    · exact ⟨_, cube_1 θ hθ h5, fun h => one_ne_zero (by rw [← inv_1 θ hθ h5, h, zero_mul])⟩
    · exact ⟨_, cube_2 θ hθ h5, fun h => one_ne_zero (by rw [← inv_2 θ hθ h5, h, zero_mul])⟩
    · exact ⟨_, cube_3 θ hθ h5, fun h => one_ne_zero (by rw [← inv_3 θ hθ h5, h, zero_mul])⟩
    · exact ⟨_, cube_4 θ hθ h5, fun h => one_ne_zero (by rw [← inv_4 θ hθ h5, h, zero_mul])⟩
  obtain ⟨y, hy, hne⟩ := key
  have hy0 : y ≠ 0 := by rintro rfl; apply hne; rw [← hy]; ring
  refine ⟨⟨y, hy0, hy⟩, ⟨-y, neg_ne_zero.mpr hy0, by rw [neg_pow, hy]; ring⟩, sub_ne_zero.mp hne⟩

/-- Differences of distinct elements of `{0,1,2,3,4}` are nonzero cubes. -/
theorem small_sub_mem (h5 : (5 : K) = 0) (a b : K)
    (ha : a = 0 ∨ a = 1 ∨ a = 2 ∨ a = 3 ∨ a = 4) (hb : b = 0 ∨ b = 1 ∨ b = 2 ∨ b = 3 ∨ b = 4)
    (hab : a ≠ b) : a - b ∈ dPowers K 3 := by
  obtain ⟨h1, h2, h3, h4⟩ := small_ne_zero h5
  -- every nonzero w with w^5 = w is a cube: w = (w^3)^3
  have hw : ∀ w : K, w ^ 5 = w → w ≠ 0 → w ∈ dPowers K 3 := by
    intro w hw hw0
    refine ⟨w ^ 3, pow_ne_zero _ hw0, ?_⟩
    have hw4 : w ^ 4 = 1 := by
      have : w * (w ^ 4 - 1) = 0 := by linear_combination hw
      rcases mul_eq_zero.mp this with h | h
      · exact absurd h hw0
      · exact sub_eq_zero.mp h
    calc (w ^ 3) ^ 3 = w * (w ^ 4) ^ 2 := by ring
      _ = w := by rw [hw4]; ring
  apply hw
  · rcases ha with rfl | rfl | rfl | rfl | rfl <;> rcases hb with rfl | rfl | rfl | rfl | rfl
    · exact absurd rfl hab
    · linear_combination (0 : K) * h5
    · linear_combination (-6 : K) * h5
    · linear_combination (-48 : K) * h5
    · linear_combination (-204 : K) * h5
    · linear_combination (0 : K) * h5
    · exact absurd rfl hab
    · linear_combination (0 : K) * h5
    · linear_combination (-6 : K) * h5
    · linear_combination (-48 : K) * h5
    · linear_combination (6 : K) * h5
    · linear_combination (0 : K) * h5
    · exact absurd rfl hab
    · linear_combination (0 : K) * h5
    · linear_combination (-6 : K) * h5
    · linear_combination (48 : K) * h5
    · linear_combination (6 : K) * h5
    · linear_combination (0 : K) * h5
    · exact absurd rfl hab
    · linear_combination (0 : K) * h5
    · linear_combination (204 : K) * h5
    · linear_combination (48 : K) * h5
    · linear_combination (6 : K) * h5
    · linear_combination (0 : K) * h5
    · exact absurd rfl hab
  · exact sub_ne_zero.mpr hab


/-- In every field with `5^8` elements, `F_5` is a clique of `GP(5^8,3)` but not a maximal clique. -/
theorem not_maximal_of_card [Finite K] (hK : Nat.card K = 5 ^ 8) :
    IsGPClique K 3 (subfieldSet K 5) ∧ ¬ IsMaximalGPClique K 3 (subfieldSet K 5) := by
  have h5 := five_eq_zero_of_card hK
  obtain ⟨θ, hθ⟩ := exists_root hK
  have hF : ∀ z, z ∈ subfieldSet K 5 ↔ _ := mem_subfieldSet_iff h5
  have hclique : IsGPClique K 3 (subfieldSet K 5) := by
    intro u hu v hv huv
    exact small_sub_mem h5 u v ((hF u).mp hu) ((hF v).mp hv) huv
  refine ⟨hclique, ?_⟩
  rintro ⟨-, hmax⟩
  have hext : IsGPClique K 3 (insert (wit θ) (subfieldSet K 5)) := by
    intro u hu v hv huv
    rcases hu with rfl | hu <;> rcases hv with rfl | hv
    · exact absurd rfl huv
    · exact (wit_sub_mem θ hθ h5 v ((hF v).mp hv)).1
    · exact (wit_sub_mem θ hθ h5 u ((hF u).mp hu)).2.1
    · exact hclique u hu v hv huv
  have heq := hmax _ hext (Set.subset_insert _ _)
  have hmem : wit θ ∈ subfieldSet K 5 := by rw [← heq]; exact Set.mem_insert _ _
  rcases (hF _).mp hmem with h | h | h | h | h
  · exact (wit_sub_mem θ hθ h5 0 (by norm_num)).2.2 h
  · exact (wit_sub_mem θ hθ h5 1 (by norm_num)).2.2 h
  · exact (wit_sub_mem θ hθ h5 2 (by norm_num)).2.2 h
  · exact (wit_sub_mem θ hθ h5 3 (by norm_num)).2.2 h
  · exact (wit_sub_mem θ hθ h5 4 (by norm_num)).2.2 h

end Field

/-- **MathDB 355956 is false**: Yip's maximal subfield clique conjecture fails for `q = 5^8`, `d = 3`. -/
theorem yip_conjecture_false : ¬ YipConjecture := by
  intro H
  have : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  have hcard : Nat.card (GaloisField 5 8) = 5 ^ 8 := GaloisField.card 5 8 (by norm_num)
  have := H 3 5 8 (GaloisField 5 8) (by norm_num) (by norm_num) (by norm_num) hcard
    (by decide) 1 admissibleR_greatest
  simp only [pow_one] at this
  exact (not_maximal_of_card hcard).2 this

/-! ### Same refutation for Mathlib's `SimpleGraph` / `Maximal` reading -/

/-- `GP(q,d)` as a Mathlib simple graph (symmetrized difference relation; equal to the literal one
when `-1` is a `d`-th power, as under `q ≡ 1 mod 2d`). -/
def GPGraph (K : Type*) [Field K] (d : ℕ) : SimpleGraph K := SimpleGraph.fromRel (GPAdj K d)

def YipConjectureSG : Prop :=
  ∀ (d p m : ℕ) (K : Type) [Field K] [Finite K], 1 < d → p.Prime → 0 < m →
    Nat.card K = p ^ m → p ^ m ≡ 1 [MOD 2 * d] →
    ∀ r : ℕ, IsGreatest (admissibleR p m d) r →
      Maximal (fun s : Set K => (GPGraph K d).IsClique s) (subfieldSet K (p ^ r))

theorem not_maximal_SG_of_card {K : Type} [Field K] [Finite K] (hK : Nat.card K = 5 ^ 8) :
    ¬ Maximal (fun s : Set K => (GPGraph K 3).IsClique s) (subfieldSet K 5) := by
  have h5 := five_eq_zero_of_card hK
  obtain ⟨θ, hθ⟩ := exists_root hK
  have hF : ∀ z, z ∈ subfieldSet K 5 ↔ _ := mem_subfieldSet_iff h5
  rintro ⟨-, hmax⟩
  have hext : (GPGraph K 3).IsClique (insert (wit θ) (subfieldSet K 5)) := by
    intro u hu v hv huv
    refine ⟨huv, Or.inl ?_⟩
    rcases hu with rfl | hu <;> rcases hv with rfl | hv
    · exact absurd rfl huv
    · exact (wit_sub_mem θ hθ h5 v ((hF v).mp hv)).1
    · exact (wit_sub_mem θ hθ h5 u ((hF u).mp hu)).2.1
    · exact small_sub_mem h5 u v ((hF u).mp hu) ((hF v).mp hv) huv
  have hmem : wit θ ∈ subfieldSet K 5 := hmax hext (Set.subset_insert _ _) (Set.mem_insert _ _)
  rcases (hF _).mp hmem with h | h | h | h | h
  · exact (wit_sub_mem θ hθ h5 0 (by norm_num)).2.2 h
  · exact (wit_sub_mem θ hθ h5 1 (by norm_num)).2.2 h
  · exact (wit_sub_mem θ hθ h5 2 (by norm_num)).2.2 h
  · exact (wit_sub_mem θ hθ h5 3 (by norm_num)).2.2 h
  · exact (wit_sub_mem θ hθ h5 4 (by norm_num)).2.2 h

theorem yip_conjecture_SG_false : ¬ YipConjectureSG := by
  intro H
  have : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  have hcard : Nat.card (GaloisField 5 8) = 5 ^ 8 := GaloisField.card 5 8 (by norm_num)
  have := H 3 5 8 (GaloisField 5 8) (by norm_num) (by norm_num) (by norm_num) hcard
    (by decide) 1 admissibleR_greatest
  simp only [pow_one] at this
  exact not_maximal_SG_of_card hcard this

end MathDB355956
