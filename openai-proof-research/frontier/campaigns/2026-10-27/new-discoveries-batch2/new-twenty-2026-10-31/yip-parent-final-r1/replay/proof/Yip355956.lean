theorem five_eq_zero_of_card [Finite K] (hK : Nat.card K = 5 ^ 8) : (5 : K) = 0 := by
  have h := card_nsmul_eq_zero' (G := K) (x := (1 : K))
  rw [hK, nsmul_eq_mul, mul_one] at h
  have : (5 : K) ^ 8 = 0 := by exact_mod_cast h
  exact pow_eq_zero_iff (by norm_num) |>.mp this

theorem small_ne_zero (h5 : (5 : K) = 0) : (1 : K) ≠ 0 ∧ (2 : K) ≠ 0 ∧ (3 : K) ≠ 0 ∧ (4 : K) ≠ 0 := by
  refine ⟨one_ne_zero, ?_, ?_, ?_⟩
  · intro h; exact one_ne_zero (by linear_combination (-2 : K) * h + h5)
  · intro h; exact one_ne_zero (by linear_combination (2 : K) * h - h5)
  · intro h; exact one_ne_zero (by linear_combination (-1 : K) * h + h5)

/-- In characteristic 5, `z^5 = z` iff `z ∈ {0,1,2,3,4}`. -/
theorem mem_subfieldSet_iff (h5 : (5 : K) = 0) (z : K) :
    z ∈ subfieldSet K 5 ↔ z = 0 ∨ z = 1 ∨ z = 2 ∨ z = 3 ∨ z = 4 := by
  change z ^ 5 = z ↔ _
  constructor
  · intro hz
    have hprod : z * (z - 1) * (z - 2) * (z - 3) * (z - 4) = 0 := by
      linear_combination hz + (-2 * z ^ 4 + 7 * z ^ 3 - 10 * z ^ 2 + 5 * z) * h5
    rcases mul_eq_zero.mp hprod with h | h
    · rcases mul_eq_zero.mp h with h | h
      · rcases mul_eq_zero.mp h with h | h
        · rcases mul_eq_zero.mp h with h | h
          · exact Or.inl h
          · exact Or.inr (Or.inl (sub_eq_zero.mp h))
        · exact Or.inr (Or.inr (Or.inl (sub_eq_zero.mp h)))
      · exact Or.inr (Or.inr (Or.inr (Or.inl (sub_eq_zero.mp h))))
    · exact Or.inr (Or.inr (Or.inr (Or.inr (sub_eq_zero.mp h))))
  · rintro (rfl | rfl | rfl | rfl | rfl)
    · ring
    · ring
    · linear_combination (6 : K) * h5
    · linear_combination (48 : K) * h5
    · linear_combination (204 : K) * h5


