import Mathlib

namespace BC350973

open Real

/-! ## Statement layer (source definitions) -/

/-- λ_p = 2 cos(π/p). -/
noncomputable def lam (p : ℕ) : ℝ := 2 * Real.cos (Real.pi / p)

/-- A frieze pattern over ℝ (source Def. 1.1; unimodular rule in the standard orientation,
the one consistent with the source's Lemma 2.4 — the printed diamond has an index typo). -/
structure Frieze where
  m : ℤ → ℤ → ℝ
  zero_row : ∀ i, m i i = 0
  one_row : ∀ i, m i (i + 1) = 1
  unimodular : ∀ i j, i + 1 ≤ j → m i j * m (i + 1) (j + 1) - m (i + 1) j * m i (j + 1) = 1

/-- quiddity entry m_{i-1,i+1}. -/
def Frieze.quiddity (F : Frieze) (i : ℤ) : ℝ := F.m (i - 1) (i + 1)

/-- infinite: no row of zeros below the boundary row. -/
def Frieze.Infinite (F : Frieze) : Prop := ∀ k : ℕ, 2 ≤ k → ∃ i : ℤ, F.m i (i + k) ≠ 0

/-- periodic quiddity row. -/
def Frieze.Periodic (F : Frieze) : Prop :=
  ∃ n : ℕ, 0 < n ∧ ∀ i : ℤ, F.quiddity (i + n) = F.quiddity i

/-- Type Λ with the decomposition `A` (each quiddity entry is a sum of λ_p, p ≥ 3). -/
def TypeLambdaWith (F : Frieze) (A : ℤ → Multiset ℕ) : Prop :=
  ∀ i, A i ≠ 0 ∧ (∀ p ∈ A i, 3 ≤ p) ∧ F.quiddity i = ((A i).map lam).sum

/-- The two conditions of the source's Proposition 4.2 ("fails the realizability test").
"more than p-2 consecutive indices" = at least p-1 consecutive indices. -/
def FailsTest (A : ℤ → Multiset ℕ) : Prop :=
  (∃ i, A i ∩ A (i + 1) = 0) ∨
  (∃ p : ℕ, 3 ≤ p ∧ (∃ i : ℤ, ∀ t : ℕ, t < p - 1 → A (i + t) = {p}) ∧ ∃ j, A j ≠ {p})

def HasNegativeEntry (F : Frieze) : Prop := ∃ i j, i ≤ j ∧ F.m i j < 0

/-- Literal first sentence of Conjecture 9.5. -/
def Conjecture95 : Prop :=
  ∀ (F : Frieze) (A : ℤ → Multiset ℕ), F.Infinite → F.Periodic → TypeLambdaWith F A →
    HasNegativeEntry F → FailsTest A

/-! ## The explicit frieze over ℤ√2 -/

/-- quiddity c_j = m_{j-1,j+1}: (1+√2, √2, 2√2, √2) at j ≡ 0,1,2,3 (mod 4). -/
def c (j : ℤ) : ℤ√2 :=
  if j % 4 = 0 then ⟨1, 1⟩ else if j % 4 = 1 then ⟨0, 1⟩ else if j % 4 = 2 then ⟨0, 2⟩ else ⟨0, 1⟩

lemma c_periodic (j : ℤ) : c (j + 4) = c j := by
  unfold c; simp [Int.add_emod_right]

/-- f i k = m_{i,i+k}, generated by m_{i,j+1} = c_j m_{i,j} - m_{i,j-1} (source Lemma 2.4). -/
def f (i : ℤ) : ℕ → ℤ√2
  | 0 => 0
  | 1 => 1
  | (k + 2) => c (i + k + 1) * f i (k + 1) - f i k

/-- unimodular rule in ℤ√2 (CANDIDATE §4(c)). -/
lemma f_unimod (i : ℤ) : ∀ k : ℕ, f i (k + 1) * f (i + 1) (k + 1) - f (i + 1) k * f i (k + 2) = 1
  | 0 => by simp [f]
  | (k + 1) => by
      have h := f_unimod i k
      have e : (i + 1 + (k : ℤ) + 1) = i + ((k + 1 : ℕ) : ℤ) + 1 := by push_cast; ring
      have r1 : f i (k + 3) = c (i + ((k + 1 : ℕ) : ℤ) + 1) * f i (k + 2) - f i (k + 1) := rfl
      have r2 : f (i + 1) (k + 2) = c (i + 1 + (k : ℤ) + 1) * f (i + 1) (k + 1) - f (i + 1) k := rfl
      rw [e] at r2
      rw [show k + 1 + 1 = k + 2 from rfl, show k + 1 + 2 = k + 3 from rfl, r1, r2]
      linear_combination h

/-- Real embedding √2 ↦ √2. -/
noncomputable def emb : ℤ√2 →+* ℝ :=
  Zsqrtd.lift ⟨Real.sqrt 2, by
    rw [Real.mul_self_sqrt (by norm_num : (0:ℝ) ≤ 2)]; norm_num⟩

/-- The real frieze. -/
noncomputable def F0 : Frieze where
  m i j := if i ≤ j then emb (f i (j - i).toNat) else 0
  zero_row i := by simp [f]
  one_row i := by simp [f]
  unimodular i j hij := by
    -- write j = i + (k+1), use f_unimod i k and map through emb
    obtain ⟨k, rfl⟩ : ∃ k : ℕ, j = i + 1 + k := ⟨(j - (i + 1)).toNat, by omega⟩
    have h := congrArg emb (f_unimod i k)
    -- the index bookkeeping below is routine
    sorry

/-! ## Facts about F0 -/

lemma f0_11 : f 0 11 = ⟨31, -22⟩ := by decide

lemma F0_negative : HasNegativeEntry F0 := by
  refine ⟨0, 11, by norm_num, ?_⟩
  show (if (0:ℤ) ≤ 11 then emb (f 0 ((11:ℤ) - 0).toNat) else 0) < 0
  simp only [show ((11:ℤ) - 0).toNat = 11 by rfl, if_pos (by norm_num : (0:ℤ) ≤ 11), f0_11]
  -- emb ⟨31, -22⟩ = 31 - 22 √2 < 0  since √2 > 31/22
  have hs : (31:ℝ) / 22 < Real.sqrt 2 := by
    rw [Real.lt_sqrt (by norm_num)]; norm_num
  simp [emb, Zsqrtd.lift]  -- reduces to 31 + (-22) * √2 < 0
  nlinarith

/-- decomposition A. -/
def A (i : ℤ) : Multiset ℕ :=
  if i % 4 = 0 then {3, 4} else if i % 4 = 1 then {4} else if i % 4 = 2 then {4, 4} else {4}

lemma lam3 : lam 3 = 1 := by
  unfold lam; push_cast; rw [Real.cos_pi_div_three]; norm_num

lemma lam4 : lam 4 = Real.sqrt 2 := by
  unfold lam; push_cast; rw [Real.cos_pi_div_four]; ring

lemma F0_typeLambda : TypeLambdaWith F0 A := by
  intro i
  -- quiddity i = emb (f (i-1) 2) = emb (c i); case on i % 4, use lam3, lam4
  sorry

lemma F0_periodic : F0.Periodic := ⟨4, by norm_num, by
  intro i
  -- emb (c (i+4)) = emb (c i) by c_periodic
  sorry⟩

lemma A_passes : ¬ FailsTest A := by
  rintro (⟨i, hi⟩ | ⟨p, hp, ⟨i, hrun⟩, -⟩)
  · -- every A i ∩ A (i+1) contains 4
    sorry
  · -- two consecutive singletons {p} never occur (t = 0, 1 < p - 1 since p ≥ 3)
    have h0 := hrun 0 (by omega)
    have h1 := hrun 1 (by omega)
    sorry

/-- Infinitude (CANDIDATE §4(a)): m_{0,k} ≠ 0 for all k ≥ 1, via the conjugate embedding
√2 ↦ -√2, the 8-step progression identity f(j+8) = s f(j+4) - f(j) with s = -2+2√2, and the
alternating-growth induction for s' = -2-2√2 < -2. -/
lemma F0_infinite : F0.Infinite := by
  sorry

theorem not_conjecture95 : ¬ Conjecture95 := by
  intro h
  exact A_passes (h F0 A F0_infinite F0_periodic F0_typeLambda F0_negative)

