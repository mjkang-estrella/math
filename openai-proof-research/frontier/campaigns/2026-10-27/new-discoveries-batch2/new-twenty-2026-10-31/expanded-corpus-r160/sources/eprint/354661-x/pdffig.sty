%%
%% Provides the commands
%%
%%   \PdfFig#1#2{%       #2=filename               #1=magnificationPercent 
%%   \PdfFigIL#1#2{%     #2=filename               #1=magnificationPercent 
%%   \PdfFigCap#1#2#3{%  #2=filename  #3=caption   #1=magnificationPercent 
%%
%% Fuer kompatibilitaet mit aelteren Dingen auch noch
%%
%%   \PdfTexFigNC#1{%    #1=filename
%%   \PdfTexFig#1#2{%    #1=filename  #2=caption 
%%   \PdfTexFigIL#1#2{%  #1=filename  #2=caption 
%%%%
\usepackage{graphicx}
\usepackage{color}
%% \DeclareGraphicsRule{*}{pdf}{*}{}
\graphicspath{{figs/}{Figures/}}
%%
%% Evtl vordefinieren ::: \SetFigFont
\gdef\SetFigFont#1#2#3#4#5{}
%%
\newcount\magproz %% magnification prozent 
\newcount\vorne
\newcount\hinten
\newcount\zwischen
\magproz=100

\def\path{figs}

\def\calc_figscale#1{
   \magproz=#1
    \vorne=\magproz
    \divide\vorne by 100
    \hinten=\magproz
    \zwischen=\vorne
    \multiply\zwischen by 100
    \advance\hinten by -\zwischen
    \def\figscale{\the\vorne.\the\hinten}
}

\def\PdfFig#1#2{%
   \calc_figscale{#1}
    \bigskip
    \centerline{\input{\path/#2.pdftex_t}}
    }


\def\PdfFigIL#1#2{% in line
   \calc_figscale{#1}
   \input{\path/#2.pdftex_t}
    }

\def\PdfFigCap#1#2#3{% in einem figure environment mit caption
   \calc_figscale{#1}
    \begin{figure}[htb]
    \centerline{\input{\path/#2.pdftex_t}}
    \caption{#3\label{fig:#2}}
    \end{figure}
    }


\def\PdfTexFigNC#1{\PdfTex{100}{#1}}
\def\PdfTexFig#1#2{\PdfFigCap{100}{#1}{#2}}
\def\PdfTexFigIL#1#2{\PdfFigIL{100}{#1}{#2}}

