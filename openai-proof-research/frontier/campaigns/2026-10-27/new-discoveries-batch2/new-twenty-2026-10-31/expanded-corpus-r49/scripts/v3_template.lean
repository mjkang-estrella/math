/-
  MathDB 355701 (Bishop–Kuss–Peet, arXiv:2208.06912, EJGTA 11(2) 2023, Conjecture 1):
  "Suppose a symmetric v3 configuration contains a maximal set of mutually intersecting lines of
   size i. If the minimum number of monochromatic triangles in line 2-colorings is non-zero, then i > 4."
  Configurations are purely combinatorial (source Sec. 2.2). We exhibit a 9_3 configuration whose
  largest set of pairwise-intersecting lines has 4 lines, yet every line 2-coloring has a
  monochromatic triangle. Both readings of "maximal" (inclusion-maximal; maximum size) are refuted.
  Generated by scripts/gen_v3_lean.py.
-/
import Mathlib

namespace MathDB355701

variable {P : Type} [Fintype P] [DecidableEq P]

/-- A symmetric `v_3` configuration (source Sec. 2.2): lines are 3-subsets, every point lies on
exactly 3 lines, two distinct points lie on at most one common line, #points = #lines, ≥ 3 points. -/
structure IsSymV3Config (lines : Finset (Finset P)) : Prop where
  three_le : 3 ≤ Fintype.card P
  line_card : ∀ l ∈ lines, l.card = 3
  point_deg : ∀ p : P, (lines.filter (fun l => p ∈ l)).card = 3
  at_most_one : ∀ p q : P, p ≠ q → (lines.filter (fun l => p ∈ l ∧ q ∈ l)).card ≤ 1
  symmetric : lines.card = Fintype.card P

/-- A set of mutually (pairwise) intersecting lines. -/
def MutuallyIntersecting (lines S : Finset (Finset P)) : Prop :=
  S ⊆ lines ∧ ∀ l ∈ S, ∀ m ∈ S, l ≠ m → (l ∩ m).Nonempty

/-- A maximal (by inclusion) set of mutually intersecting lines. -/
def MaximalMutuallyIntersecting (lines S : Finset (Finset P)) : Prop :=
  MutuallyIntersecting lines S ∧ ∀ T, MutuallyIntersecting lines T → S ⊆ T → T = S

/-- Source definition of a triangle `p₁p₂p₃` with its lines `l₁ ∋ p₁,p₂`, `l₂ ∋ p₂,p₃`, `l₃ ∋ p₁,p₃`. -/
def IsTriangle (lines : Finset (Finset P)) (p₁ p₂ p₃ : P) (l₁ l₂ l₃ : Finset P) : Prop :=
  l₁ ∈ lines ∧ l₂ ∈ lines ∧ l₃ ∈ lines ∧
  p₁ ∈ l₁ ∧ p₂ ∈ l₁ ∧ p₃ ∉ l₁ ∧ p₂ ∈ l₂ ∧ p₃ ∈ l₂ ∧ p₁ ∉ l₂ ∧ p₁ ∈ l₃ ∧ p₃ ∈ l₃ ∧ p₂ ∉ l₃

/-- "The minimum number of monochromatic triangles over all line 2-colorings is non-zero":
every 2-coloring of the lines has a triangle whose three lines receive the same color. -/
def MinMonoNonzero (lines : Finset (Finset P)) : Prop :=
  ∀ c : Finset P → Bool, ∃ (p₁ p₂ p₃ : P) (l₁ l₂ l₃ : Finset P),
    IsTriangle lines p₁ p₂ p₃ l₁ l₂ l₃ ∧ c l₁ = c l₂ ∧ c l₂ = c l₃

/-- Conjecture, "maximal set" read as inclusion-maximal. -/
def ConjectureInclusion : Prop :=
  ∀ (P : Type) [Fintype P] [DecidableEq P] (lines : Finset (Finset P)), IsSymV3Config lines →
    ∀ S, MaximalMutuallyIntersecting lines S → MinMonoNonzero lines → 4 < S.card

/-- Conjecture, "maximal set of size i" read as the maximum size `i`. -/
def ConjectureMaximum : Prop :=
  ∀ (P : Type) [Fintype P] [DecidableEq P] (lines : Finset (Finset P)), IsSymV3Config lines →
    MinMonoNonzero lines → ∃ S, MutuallyIntersecting lines S ∧ 4 < S.card

/-- Incidence matrix of the counterexample: `M i p` iff point `p` lies on line `i`. -/
def M : Fin 9 → Fin 9 → Bool := fun i p =>
  match i.val with
MATCHLINES

/-- Line `i` as a set of points. -/
def L (i : Fin 9) : Finset (Fin 9) := Finset.univ.filter (fun p => M i p = true)

def lines9 : Finset (Finset (Fin 9)) := Finset.univ.image L

theorem mem_L {i p : Fin 9} : p ∈ L i ↔ M i p = true := by simp [L]

def meets (i j : Fin 9) : Bool := (List.finRange 9).any (fun p => M i p && M j p)

theorem meets_iff {i j : Fin 9} : meets i j = true ↔ (L i ∩ L j).Nonempty := by
  simp only [meets, List.any_eq_true, List.mem_finRange, true_and, Bool.and_eq_true,
    Finset.Nonempty, Finset.mem_inter, mem_L]

set_option maxRecDepth 100000 in
theorem M_ext : ∀ i j : Fin 9, (∀ p, M i p = M j p) → i = j := by decide

theorem L_inj : Function.Injective L := by
  intro i j h
  apply M_ext
  intro p
  have := congrArg (fun s => p ∈ s) h
  simp only [mem_L, eq_iff_iff] at this
  cases hi : M i p <;> cases hj : M j p <;> simp_all

theorem mem_lines9 {l : Finset (Fin 9)} : l ∈ lines9 ↔ ∃ i, L i = l := by simp [lines9]

set_option maxRecDepth 100000 in
theorem card_L : ∀ i, (L i).card = 3 := by decide +kernel

set_option maxRecDepth 100000 in
theorem deg_idx : ∀ p : Fin 9, (Finset.univ.filter (fun i => M i p = true)).card = 3 := by decide +kernel

set_option maxRecDepth 100000 in
theorem pair_idx : ∀ p q : Fin 9, p ≠ q →
    (Finset.univ.filter (fun i => M i p = true ∧ M i q = true)).card ≤ 1 := by decide +kernel

theorem filter_image (P : Finset (Fin 9) → Prop) [DecidablePred P] :
    lines9.filter P = (Finset.univ.filter (fun i => P (L i))).image L := by
  ext l
  simp only [lines9, Finset.mem_filter, Finset.mem_image, Finset.mem_univ, true_and]
  constructor
  · rintro ⟨⟨a, rfl⟩, hP⟩; exact ⟨a, hP, rfl⟩
  · rintro ⟨a, hP, rfl⟩; exact ⟨⟨a, rfl⟩, hP⟩

theorem config9 : IsSymV3Config lines9 where
  three_le := by simp
  line_card := by
    intro l hl; obtain ⟨i, rfl⟩ := mem_lines9.mp hl; exact card_L i
  point_deg := by
    intro p
    rw [filter_image, Finset.card_image_of_injective _ L_inj]
    simpa only [mem_L] using deg_idx p
  at_most_one := by
    intro p q hpq
    rw [filter_image, Finset.card_image_of_injective _ L_inj]
    simpa only [mem_L] using pair_idx p q hpq
  symmetric := by
    rw [lines9, Finset.card_image_of_injective _ L_inj]; simp

set_option maxRecDepth 100000 in
theorem idx_clique_le : ∀ T : Finset (Fin 9), (∀ i ∈ T, ∀ j ∈ T, i ≠ j → meets i j = true) →
    T.card ≤ 4 := by decide +kernel

/-- Every set of mutually intersecting lines has at most 4 lines. -/
theorem mi_card_le (S : Finset (Finset (Fin 9))) (h : MutuallyIntersecting lines9 S) : S.card ≤ 4 := by
  classical
  obtain ⟨hsub, hpair⟩ := h
  set T := Finset.univ.filter (fun i => L i ∈ S)
  have hST : S = T.image L := by
    ext l; constructor
    · intro hl
      obtain ⟨i, rfl⟩ := mem_lines9.mp (hsub hl)
      exact Finset.mem_image.mpr ⟨i, by simp [T, hl], rfl⟩
    · intro hl
      obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hl
      simpa [T] using hi
  rw [hST, Finset.card_image_of_injective _ L_inj]
  apply idx_clique_le
  intro i hi j hj hij
  have hi' : L i ∈ S := by simpa [T] using hi
  have hj' : L j ∈ S := by simpa [T] using hj
  exact meets_iff.mpr (hpair _ hi' _ hj' (fun h => hij (L_inj h)))

def S4 : Finset (Finset (Fin 9)) := ({0, 1, 2, 3} : Finset (Fin 9)).image L

set_option maxRecDepth 100000 in
theorem S4_idx : ∀ i ∈ ({0, 1, 2, 3} : Finset (Fin 9)), ∀ j ∈ ({0, 1, 2, 3} : Finset (Fin 9)),
    i ≠ j → meets i j = true := by decide +kernel

theorem S4_mi : MutuallyIntersecting lines9 S4 := by
  refine ⟨?_, ?_⟩
  · intro l hl
    obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hl
    exact mem_lines9.mpr ⟨i, rfl⟩
  · intro l hl m hm hlm
    obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hl
    obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp hm
    exact meets_iff.mp (S4_idx i hi j hj (fun h => hlm (h ▸ rfl)))

theorem S4_card : S4.card = 4 := by
  rw [S4, Finset.card_image_of_injective _ L_inj]; decide

theorem S4_maximal : MaximalMutuallyIntersecting lines9 S4 := by
  refine ⟨S4_mi, fun T hT hST => ?_⟩
  exact (Finset.eq_of_subset_of_card_le hST (by rw [S4_card]; exact mi_card_le T hT)).symm

/-- The 21 triangles (points `a,b,c`; line indices of `ab`, `bc`, `ac`). -/
def tris : List (Fin 9 × Fin 9 × Fin 9 × Fin 9 × Fin 9 × Fin 9) := [TRILIST]

set_option maxRecDepth 100000 in
theorem tris_idx : ∀ t ∈ tris,
    M t.2.2.2.1 t.1 = true ∧ M t.2.2.2.1 t.2.1 = true ∧ M t.2.2.2.1 t.2.2.1 = false ∧
    M t.2.2.2.2.1 t.2.1 = true ∧ M t.2.2.2.2.1 t.2.2.1 = true ∧ M t.2.2.2.2.1 t.1 = false ∧
    M t.2.2.2.2.2 t.1 = true ∧ M t.2.2.2.2.2 t.2.2.1 = true ∧ M t.2.2.2.2.2 t.2.1 = false := by
  decide +kernel

theorem tris_are_triangles : ∀ t ∈ tris,
    IsTriangle lines9 t.1 t.2.1 t.2.2.1 (L t.2.2.2.1) (L t.2.2.2.2.1) (L t.2.2.2.2.2) := by
  intro t ht
  obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9⟩ := tris_idx t ht
  refine ⟨mem_lines9.mpr ⟨_, rfl⟩, mem_lines9.mpr ⟨_, rfl⟩, mem_lines9.mpr ⟨_, rfl⟩, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
    simp [mem_L, h1, h2, h3, h4, h5, h6, h7, h8, h9]

set_option maxRecDepth 100000 in
theorem coloring_core : ∀ b : Fin 9 → Bool, ∃ t ∈ tris,
    b t.2.2.2.1 = b t.2.2.2.2.1 ∧ b t.2.2.2.2.1 = b t.2.2.2.2.2 := by
  decide +kernel

theorem minMonoNonzero9 : MinMonoNonzero lines9 := by
  intro c
  obtain ⟨t, ht, h1, h2⟩ := coloring_core (fun i => c (L i))
  exact ⟨_, _, _, _, _, _, tris_are_triangles t ht, h1, h2⟩

/-- The counterexample written out (for reading): its nine lines as point sets. -/
theorem lines9_spec : ∀ i : Fin 9, L i = LSPEC := by
  decide +kernel

theorem conjectureInclusion_false : ¬ ConjectureInclusion := by
  intro H
  have := H (Fin 9) lines9 config9 S4 S4_maximal minMonoNonzero9
  rw [S4_card] at this
  exact absurd this (by decide)

theorem conjectureMaximum_false : ¬ ConjectureMaximum := by
  intro H
  obtain ⟨S, hS, hcard⟩ := H (Fin 9) lines9 config9 minMonoNonzero9
  exact absurd (mi_card_le S hS) (by omega)

end MathDB355701
