    "pool-candidates_decisions.jsonl": [
      "{\"repo\":\"kebekus/projectvd\",\"include\":true,\"category\":\"mathlib\",\"confidence\":\"high\",\"rationale\":\"Nevanlinna value-distribution theory: Jensen, first main theorem, Blaschke decomposition (~1.9k LOC, 6 sorries); already feeding mathlib.\"}",
      "{\"repo\":\"chrishughes24/axgroth\",\"include\":true,\"category\":\"mathlib\",\"confidence\":\"medium\",\"rationale\":\"933 LOC formalising Ax-Grothendieck theorem: Jacobians of MvPolynomial, complex polynomial maps. 11 sorries.\"}",
      "{\"repo\":\"raphaelrrcoelho/formal-mathfin\",\"include\":false,\"category\":\"dependency\",\"confidence\":\"high\",\"rationale\":\"2026-06-28 import triage: Apache-2.0 and substantial, but not a self-contained gate-clean Lean Pool target. The active Lake project depends on LeanArchitect and brownian-motion, builds every MathFin submodule including generated/audit modules, and contains many #guard_msgs/#print axioms diagnostics, many public import Mathlib modules, and a linter set_option waiver. Revisit after external dependencies and generated/audit surfaces are separated or vendored gate-cleanly.\"}"
    ],
