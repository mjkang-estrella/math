theorem row_55 : ∀ j : Fin 88,
 (treeGraph (nanostar 4)).Adj (55 : Fin 88) j ↔
 (55 : Fin 88) ≠ j ∧ (next (55 : Fin 88) = j ∨ next j = (55 : Fin 88)) := by
 change ∀ j : Fin 88,
   ((55 : Fin 88) ≠ j ∧ ((55,j.val) ∈ edges (nanostar 4) ∨ (j.val,55) ∈ edges (nanostar 4))) ↔
   (55 : Fin 88) ≠ j ∧ (next (55 : Fin 88) = j ∨ next j = (55 : Fin 88))
 decide
