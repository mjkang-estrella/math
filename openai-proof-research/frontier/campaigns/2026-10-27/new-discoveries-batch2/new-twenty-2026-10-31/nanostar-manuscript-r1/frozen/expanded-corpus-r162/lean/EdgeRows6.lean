import Certificate
namespace R162
set_option maxRecDepth 100000
set_option maxHeartbeats 0
theorem row_66 : ∀ j : Fin 88,
 (treeGraph (nanostar 4)).Adj (66 : Fin 88) j ↔
 (66 : Fin 88) ≠ j ∧ (next (66 : Fin 88) = j ∨ next j = (66 : Fin 88)) := by
 change ∀ j : Fin 88,
   ((66 : Fin 88) ≠ j ∧ ((66,j.val) ∈ edges (nanostar 4) ∨ (j.val,66) ∈ edges (nanostar 4))) ↔
   (66 : Fin 88) ≠ j ∧ (next (66 : Fin 88) = j ∨ next j = (66 : Fin 88))
 decide
