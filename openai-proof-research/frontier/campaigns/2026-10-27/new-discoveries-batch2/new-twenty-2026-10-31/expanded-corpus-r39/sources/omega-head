w i.castSucc\n+  have hR0 : 0 ≤ R d r := by linarith [fs.R_ge]\n+  have hH0 : 0 ≤ H d r := by linarith [fs.H_ge]\n+  have hwH := mul_nonneg (show 0 ≤ (w : ℤ) by positivity) hH0\n+  have hbounds : -(N d r / 2) ≤ topValue d w r i ∧ topValue d w r i ≤ N d r / 2 := by\n+    have a1 := mul_le_mul_of_nonneg_left ha.1 hR0\n+    have a2 := mul_le_mul_of_nonneg_left ha.2 hR0\n+    have b1 := mul_le_mul_of_nonneg_left hb.2.2.2.2.1 hH0\n+    have b2 := mul_le_mul_of_nonneg_left hb.2.2.2.2.2 hH0\n+    have hbaseR := congrArg (fun z : ℤ => R d r * z) fs.base_half\n+    dsimp [topValue]\n+    constructor <;> nlinarith only [a1, a2, b1, b2, hbaseR, fs.old_half,\n+      fs.top_margin, hwH]\n+  obtain ⟨hN, ho⟩ := TwoRunSource.modulus_positive_odd (length d r) (by\n+    have := fs.length_succ; have := Nat.mul_le_mul (show 3 ≤ d + 1 by omega) hr; omega)\n+  apply centered_unique hN ho (centered_bounds hN ho _) hbounds\n+  rw [centered_mod]\n+  have hp2 : (2 : ℤ) ^ ((r - 1) * (d + 1) + i.val) = R d r * 2 ^ i.val := by\n+    rw [pow_add, Nat.mul_comm (r - 1) (d + 1), pow_mul]; rfl\n+  have heq : (2 : ℤ) ^ ((r - 1) * (d + 1) + i.val) * (seed d w r : ℤ) -\n+      topValue d w r i = N d r * ((2 : ℤ) ^ (i.val + 1) * w * H d r + charge d w i) := by\n+    rw [hp2, seed, Nat.cast_mul]\n+    change R d r * 2 ^ i.val * ((w : ℤ) * G d r) - _ = _\n+    have haeq : actualSource d w i = (2 : ℤ) ^ i.val * w - n d * charge d w i := by\n+      simpa only [n] using (digit_data d w hd hw i).2.1\n+    rw [topValue, phase_cast d w hd hw, haeq]\n+    have hg : G d r - 1 = q d * H d r := by linarith [fs.G_eq]\n+    rw [pow_succ]\n+    linear_combination (2 : ℤ) ^ i.val * (w : ℤ) * R d r * hg -\n+      (2 : ℤ) ^ i.val * (w : ℤ) * H d r * fs.top_power -\n+      charge d w i * fs.top_modulus -\n+      H d r * charge d w i * fs.q_eq\n+  have heq' : topValue d w r i =\n+      (2 : ℤ) ^ ((r - 1) * (d + 1) + i.val) * (seed d w r : ℤ) -\n+        modulus (length d r) * ((2 : ℤ) ^ (i.val + 1) * w * H d r + charge d w i) := by\n+    change _ - _ = modulus (length d r) * _ at heq; linarith\n+  rw [heq', Int.sub_mul_emod_self_left]\n+\n+set_option maxHeartbeats 4000000 in\n+-- Polynomial certificates combine native charges and three modulus identities.\n+/-- Exact periodic daughter source, with distinct physical labels in every block. -/\n+theorem daughter_source (d w r j : ℕ) (hd : 2 ≤ d)\n+    (hw : w ≤ 2 ^ (d - 1) - 1) (hr : 2 ≤ r) (i : Fin (d + 1))\n+    (hp : j * (d + 1) + i.val < length d r + 1) :\n+    actualSource (length d r + 1) (2 * seed d w r) ⟨j * (d + 1) + i.val, hp⟩ =\n+      G d r * beta d w i := by\n+  have fs := scale_facts d w r hd hw hr\n+  have hb := phase_data d w hd hw i\n+  have hg0 : 0 ≤ G d r := by linarith [fs.G_ge, fs.q_ge]\n+  have hbounds : -(modulus (length d r + 1) / 2) ≤ G d r * beta d w i ∧\n+      G d r * beta d w i ≤ modulus (length d r + 1) / 2 := by\n+    constructor <;> nlinarith only [mul_le_mul_of_nonneg_left hb.2.2.2.2.1 hg0,\n+      mul_le_mul_of_nonneg_left hb.2.2.2.2.2 hg0, fs.daughter_margin]\n+  obtain ⟨hN, ho⟩ := TwoRunSource.modulus_positive_odd (length d r + 1) (by omega)\n+  apply centered_unique hN ho (centered_bounds hN ho _) hbounds\n+  rw [centered_mod]\n+  have hjg := geom_mul (d + 1) j (by omega)\n+  change (q d - 1) * (geom (d + 1) j : ℤ) = q d ^ j - 1 at hjg\n+  have hp2 : (2 : ℤ) ^ (j * (d + 1) + i.val) = q d ^ j * 2 ^ i.val := by\n+    rw [pow_add, Nat.mul_comm j (d + 1), pow_mul]; rfl\n+  have heq : G d r * beta d w i =\n+      (2 : ℤ) ^ (j * (d + 1) + i.val) * (2 * seed d w r : ℕ) -\n+        modulus (length d r + 1) *\n+          ((2 : ℤ) ^ (i.val + 1) * w * (geom (d + 1) j : ℤ) + e d w i) := by\n+    rw [hp2, Nat.cast_mul, Nat.cast_ofNat, seed, Nat.cast_mul, fs.new_modulus]\n+    change G d r * beta d w i =\n+      q d ^ j * 2 ^ i.val * (2 * ((w : ℤ) * G d r)) - _\n+    have hbraw := hb.2.2.2.1\n+    rw [pow_succ] at hbraw ⊢\n+    linear_combination G d r * hbraw +\n+      2 * (2 : ℤ) ^ i.val * (w : ℤ) * G d r * hjg\n+  rw [heq, Int.sub_mul_emod_self_left]\n+\n+end D5.S3.Combinatorics.Circle.PeriodicDaughterJointShortening"},{"sha":"266dc7ed3065334a6e7ce29b53b44e41280c0257","filename":"D5/S3/Combinatorics/Circle/PeriodicDaughterJointShortening/Construction.lean","status":"added","additions":323,"deletions":0,"changes":323,"blob_url":"https://github.com/the-omega-institute/trureturing/blob/95454f1bac7a754ed76e5e32426fb3beb13a6669/D5%2FS3%2FCombinatorics%2FCircle%2FPeriodicDaughterJointShortening%2FConstruction.lean","raw_url":"https://github.com/the-omega-institute/trureturing/raw/95454f1bac7a754ed76e5e32426fb3beb13a6669/D5%2FS3%2FCombinatorics%2FCircle%2FPeriodicDaughterJointShortening%2FConstruction.lean","contents_url":"https://api.github.com/repos/the-omega-institute/trureturing/contents/D5%2FS3%2FCombinatorics%2FCircle%2FPeriodicDaughterJointShortening%2FConstruction.lean?ref=95454f1bac7a754ed76e5e32426fb3beb13a6669","patch":"@@ -0,0 +1,323 @@\n+/- GID: D5/S3/Combinatorics/Circle/PeriodicDaughterJointShortening/Construction\n+   generality: I\n+   mirror-B: D5/B/S3/Combinatorics/Circle/PeriodicDaughterJointShortening/Construction\n+   mirror-E: none(waiver:no-escape-mirror-specified)\n+   anchors: [mathlib/module/Mathlib.Data.List.FinRange]\n+   utility: none\n+   digest: Generic minus-one physical joint transport with periodic daughter. -/\n+import D5.S3.Combinatorics.Circle.PeriodicDaughterJointShortening.Words\n+\n+/-! MINUS-one transport at K=(d+1)*r-1 with both full actual\n+OriginalOrder predicates. -/\n+set_option autoImplicit false\n+set_option relaxedAutoImplicit false\n+\n+namespace D5.S3.Combinatorics.Circle.PeriodicDaughterJointShortening\n+open SourceWidth PeriodicShorteningArithmetic PeriodicShortening RunFirstEarTransport\n+open scoped BigOperators\n+\n+/- The linear sum and prefix-to-strip helpers are ports of the private\n+PeriodicShortening helpers at 447f4235385fe941888b620340cd4429dfbf0e61.\n+The remaining list identities organize native source prefixes. -/\n+private theorem sum_linear {α : Type*} (l : List α) (f g : α → ℤ) (u v : ℤ) :\n+    (l.map (fun x => u * f x + v * g x)).sum =\n+      u * (l.map f).sum + v * (l.map g).sum := by\n+  induction l with\n+  | nil => simp\n+  | cons x xs ih => simp only [List.map_cons, List.sum_cons, ih]; ring\n+\n+private theorem sum_double {α : Type*} (l : List α) (f g b : α → ℤ) (u : ℤ)\n+    (hf : ∀ x, 2 * f x = u * g x + b x) :\n+    2 * (l.map f).sum = u * (l.map g).sum + (l.map b).sum := by\n+  induction l with\n+  | nil => simp\n+  | cons x xs ih =>\n+      simp only [List.map_cons, List.sum_cons]\n+      linear_combination hf x + ih\n+\n+private theorem prefix_nonneg_le {α : Type*} (l : List α) (f : α → ℤ)\n+    (hf : ∀ x ∈ l, 0 ≤ f x) (h : ℕ) :\n+    0 ≤ ((l.take h).map f).sum ∧ ((l.take h).map f).sum ≤ (l.map f).sum := by\n+  have ht : 0 ≤ ((l.take h).map f).sum := by\n+    apply List.sum_nonneg\n+    intro y hy\n+    obtain ⟨x, hx, rfl⟩ := List.mem_map.mp hy\n+    exact hf x (List.mem_of_mem_take hx)\n+  have hd : 0 ≤ ((l.drop h).map f).sum := by\n+    apply List.sum_nonneg\n+    intro y hy\n+    obtain ⟨x, hx, rfl⟩ := List.mem_map.mp hy\n+    exact hf x (List.mem_of_mem_drop hx)\n+  have he := congrArg (fun xs : List α => (xs.map f).sum) (List.take_append_drop h l)\n+  simp only [List.map_append, List.sum_append] at he\n+  exact ⟨ht, by omega⟩\n+\n+private theorem strip_of_prefix {α : Type*} (f : α → ℤ) (B h : ℤ) (l : List α)\n+    (hl : ∀ t, 0 ≤ h + ((l.take t).map f).sum ∧\n+      h + ((l.take t).map f).sum ≤ B) : InStrip f B h l := by\n+  induction l generalizing h with\n+  | nil => simpa [InStrip] using hl 0\n+  | cons x xs ih =>\n+      refine ⟨by simpa using (hl 0).1, by simpa using (hl 0).2, ih (h + f x) ?_⟩\n+      intro t\n+      simpa [List.take_succ_cons, add_assoc] using hl (t + 1)\n+\n+private theorem sum_of_perm {k : ℕ} (l : List (Fin k))\n+    (hp : l.Perm (List.finRange k)) (f : Fin k → ℤ) :\n+    (l.map f).sum = ∑ i : Fin k, f i := by\n+  rw [(hp.map f).sum_eq]\n+  rw [← List.sum_toFinset _ (List.nodup_finRange _), List.toFinset_finRange]\n+\n+private theorem regular_block (d w r : ℕ) (hd : 2 ≤ d)\n+    (hw : w ≤ 2 ^ (d - 1) - 1) (hr : 2 ≤ r)\n+    (eta : List (Fin (d + 1))) (heta : OriginalOrder (d + 1) (2 * w) eta)\n+    (j : Fin (r - 1)) :\n+    let f := actualSource (length d r) (seed d w r)\n+    InStrip f (N d r / 2) ((w : ℤ) * (geom (d + 1) j.val : ℤ))\n+        (eta.map (regularLabel d r hr j)) ∧\n+      ((eta.map (regularLabel d r hr j)).map f).sum = (w : ℤ) * q d ^ j.val := by\n+  dsimp only\n+  let f := actualSource (length d r) (seed d w r)\n+  have fs := scale_facts d w r hd hw hr\n+  have hv (i : Fin (d + 1)) : f (regularLabel d r hr j i) = regularValue d w r j.val i :=\n+    regular_source d w r j.val hd hw hr j.isLt i (regularLabel d r hr j i).isLt\n+  have hdef := defect_data d w j.val hd hw\n+  have htotal : (eta.map (defect d w j.val)).sum = 2 * w * q d ^ j.val := by\n+    rw [sum_of_perm eta heta.1]; exact hdef.2\n+  have hbeta : (eta.map (beta d w)).sum = 0 := heta.2.1\n+  have hgeo : (geom (d + 1) j.val : ℤ) + q d ^ j.val ≤ H d r := by\n+    have he := geom_succ (d + 1) j.val (by omega)\n+    have hm := geom_mono (d + 1) (by omega) (show j.val + 1 ≤ r - 1 by omega)\n+    change (geom (d + 1) (j.val + 1) : ℤ) ≤ H d r at hm\n+    simpa only [he, q] using hm\n+  have hg0 : 0 ≤ G d r := by linarith [fs.G_ge, fs.q_ge]\n+  constructor\n+  · apply strip_of_prefix f _ _ _\n+    intro h\n+    rw [← List.map_take]\n+    simp only [List.map_map, Function.comp_def]\n+    simp_rw [hv]\n+    have he := sum_double (eta.take h) (regularValue d w r j.val)\n+      (beta d w) (defect d w j.val) (G d r) (regular_double d w r j.val hd hw hr)\n+    have hb := heta.2.2 h\n+    change 0 ≤ ((eta.take h).map (beta d w)).sum ∧\n+      ((eta.take h).map (beta d w)).sum ≤ modulus (d + 1) / 2 at hb\n+    rw [fs.daughter_half] at hb\n+    have hdft := prefix_nonneg_le eta (defect d w j.val) (fun i _ => hdef.1 i) h\n+    