cc (d + 1) s (by omega)\n+        dsimp only at hi hb ⊢\n+        rw [List.finRange_succ_last]\n+        simp only [List.flatMap_append, List.flatMap_map, List.flatMap_cons,\n+          List.flatMap_nil, List.append_nil, Fin.val_castSucc, Fin.val_last]\n+        constructor\n+        · apply inStrip_append hi.1\n+          simpa only [hi.2, zero_add] using hb.1\n+        · simp only [List.map_append, List.sum_append]\n+          rw [hi.2, hb.2, hg]\n+          change (w : ℤ) * (geom (d + 1) s : ℤ) + w * q d ^ s =\n+            w * ((geom (d + 1) s : ℤ) + q d ^ s)\n+          ring\n+  simpa only [lowerWord, H] using hchain (r - 1) (by omega)\n+\n+private theorem top_block (d w r cut : ℕ) (hd : 2 ≤ d)\n+    (hw : w ≤ 2 ^ (d - 1) - 1) (hr : 2 ≤ r) (hcut : cut ≤ d)\n+    (tau : List (Fin d)) (hold : OriginalOrder d w tau)\n+    (hnew : OriginalOrder (d + 1) (2 * w) (earWord d tau cut)) :\n+    let f := actualSource (length d r) (seed d w r)\n+    InStrip f (N d r / 2) ((w : ℤ) * H d r) (tau.map (topLabel d r hr)) ∧\n+      ((tau.map (topLabel d r hr)).map f).sum = -(w : ℤ) * H d r := by\n+  dsimp only\n+  let f := actualSource (length d r) (seed d w r)\n+  have fs := scale_facts d w r hd hw hr\n+  have htau : tau.length = d := by simpa using hold.1.length_eq\n+  have hc : cut ≤ tau.length := by omega\n+  have hv (i : Fin d) : f (topLabel d r hr i) = topValue d w r i :=\n+    top_source d w r hd hw hr i (topLabel d r hr i).isLt\n+  let b := fun i : Fin d => beta d w i.castSucc\n+  have hbtotal : (tau.map b).sum = -(w : ℤ) := by\n+    have he := ear_sum d tau cut (beta d w)\n+    have hz : ((earWord d tau cut).map (beta d w)).sum = 0 := hnew.2.1\n+    rw [hz, phase_fresh d w hd hw] at he\n+    change 0 = (tau.map b).sum + w at he\n+    omega\n+  have hbeta_prefix (h : ℕ) : -(w : ℤ) ≤ ((tau.take h).map b).sum ∧\n+      ((tau.take h).map b).sum ≤ n d := by\n+    by_cases hh : h ≤ cut\n+    · have he := ear_prefix_sum d tau cut hc (beta d w) h\n+      have hb := hnew.2.2 h\n+      change 0 ≤ (((earWord d tau cut).take h).map (beta d w)).sum ∧\n+        (((earWord d tau cut).take h).map (beta d w)).sum ≤ modulus (d + 1) / 2 at hb\n+      simp only [ite_eq_left hh, add_zero] at he\n+      rw [he, fs.daughter_half] at hb\n+      change 0 ≤ ((tau.take h).map b).sum ∧ ((tau.take h).map b).sum ≤ n d at hb\n+      exact ⟨by linarith [fs.w_nonneg], hb.2⟩\n+    · have hh' : ¬ h + 1 ≤ cut := by omega\n+      have he := ear_prefix_sum d tau cut hc (beta d w) (h + 1)\n+      have hb := hnew.2.2 (h + 1)\n+      change 0 ≤ (((earWord d tau cut).take (h + 1)).map (beta d w)).sum ∧\n+        (((earWord d tau cut).take (h + 1)).map (beta d w)).sum ≤\n+          modulus (d + 1) / 2 at hb\n+      simp only [ite_eq_right hh', Nat.add_sub_cancel, phase_fresh d w hd hw] at he\n+      rw [he, fs.daughter_half] at hb\n+      change 0 ≤ ((tau.take h).map b).sum + w ∧\n+        ((tau.take h).map b).sum + w ≤ n d at hb\n+      constructor <;> linarith [fs.w_nonneg]\n+  have hH0 : 0 ≤ H d r := by linarith [fs.H_ge]\n+  have hR0 : 0 ≤ R d r := by linarith [fs.R_ge]\n+  have hprefix (h : ℕ) :\n+      ((tau.take h).map (topValue d w r)).sum =\n+        R d r * ((tau.take h).map (actualSource d w)).sum +\n+          H d r * ((tau.take h).map b).sum := by\n+    exact sum_linear (tau.take h) (actualSource d w) b (R d r) (H d r)\n+  constructor\n+  · apply strip_of_prefix f _ _ _\n+    intro h\n+    rw [← List.map_take]\n+    simp only [List.map_map, Function.comp_def]\n+    simp_rw [hv]\n+    rw [hprefix]\n+    have ha := hold.2.2 h\n+    have hb := hbeta_prefix h\n+    have ha0 := mul_nonneg hR0 ha.1\n+    have ha1 := mul_le_mul_of_nonneg_left ha.2 hR0\n+    have hb0 := mul_le_mul_of_nonneg_left hb.1 hH0\n+    have hb1 := mul_le_mul_of_nonneg_left hb.2 hH0\n+    have hhalfR := congrArg (fun z : ℤ => R d r * z) fs.base_half\n+    constructor <;> nlinarith only [ha0, ha1, hb0, hb1, hhalfR, fs.top_margin, fs.old_half]\n+  · have hmap : f ∘ topLabel d r hr = topValue d w r := by\n+      funext i\n+      exact hv i\n+    rw [List.map_map, hmap]\n+    have he := sum_linear tau (actualSource d w) b (R d r) (H d r)\n+    change (tau.map (topValue d w r)).sum = _ at he\n+    rw [he, hold.2.1, hbtotal]\n+    ring\n+\n+private theorem daughter_order (d w r : ℕ) (hd : 2 ≤ d)\n+    (hw : w ≤ 2 ^ (d - 1) - 1) (hr : 2 ≤ r)\n+    (eta : List (Fin (d + 1))) (heta : OriginalOrder (d + 1) (2 * w) eta) :\n+    OriginalOrder (length d r + 1) (2 * seed d w r) (daughterWord d r hr eta) := by\n+  let f := actualSource (length d r + 1) (2 * seed d w r)\n+  have fs := scale_facts d w r hd hw hr\n+  have hg0 : 0 ≤ G d r := by linarith [fs.G_ge, fs.q_ge]\n+  have hblock (j : Fin r) :\n+      InStrip f (modulus (length d r + 1) / 2) 0 (eta.map (daughterLabel d r hr j)) ∧\n+      ((eta.map (daughterLabel d r hr j)).map f).sum = 0 := by\n+    have hv (i : Fin (d + 1)) : f (daughterLabel d r hr j i) = G d r * beta d w i :=\n+      daughter_source d w r j.val hd hw hr i (daughterLabel d r hr j i).isLt\n+    have hsum (xs : List (Fin (d + 1))) :\n+        ((xs.map (daughterLabel d r hr j)).map f).sum = G d r * (xs.map (beta d w)).sum := by\n+      simp only [List.map_map, Function.comp_def]\n+      simp_rw [hv]\n+      have he := sum_linear xs (beta d w) (fun _ => 0) (G d r) 0\n+      simpa using he\n+    constructor\n+    · apply strip_of_prefix f _ 0 _\n+      intro h\n+      rw [← List.map_take, hsum]\n+      have hb := heta.2.2 h\n+      change 0 ≤ ((eta.take h).map (beta d w)).sum ∧\n+        ((eta.take h).map (beta d w)).sum ≤ modulus (d + 1) / 2 at hb\n+      rw [fs.daughter_half] at hb\n+      constructor\n+      · simpa using mul_nonneg hg0 hb.1\n+      · have hh := mul_le_mul_of_nonneg_left hb.2 hg0\n+        simpa using hh.trans fs.daughter_margin\n+    · have hz : (eta.map (beta d w)).sum = 0 := heta.2.1\n+      rw [hsum, hz, mul_zero]\n+  have hall (js : List (Fin r)) :\n+      InStrip f (modulus (length d r + 1) / 2) 0\n+          (js.flatMap (fun j => eta.map (daughterLabel d r hr j))) ∧\n+      ((js.flatMap (fun j => eta.map (daughterLabel d r hr j))).map f).sum = 0 := by\n+    induction js with\n+    | nil =>\n+        have hp := (TwoRunSource.modulus_positive_odd (length d r + 1) (by omega)).1\n+        simp only [List.flatMap_nil, List.map_nil, List.sum_nil, InStrip]\n+        exact ⟨⟨by omega, by omega⟩, trivial⟩\n+    | cons j js ih =>\n+        simp only [List.flatMap_cons]\n+        constructor\n+        · apply inStrip_append (hblock j).1\n+          simpa only [(hblock j).2, zero_add] using ih.1\n+        · simp only [List.map_append, List.sum_append, (hblock j).2, ih.2, zero_add]\n+  have hh := hall (List.finRange r)\n+  refine ⟨daughter_perm d r hr eta heta.1, hh.2, ?_⟩\n+  intro h\n+  simpa only [daughterWord, zero_add, Set.mem_Icc, f] using inStrip_prefix hh.1 h\n+\n+/-- Ascending full daughter blocks followed by the shortened top OLD block.\n+The common cut inserts exactly the globally fresh label. All natural prefixes\n+and both zero totals are part of the two actual OriginalOrder conclusions. -/\n+public theorem periodic_daughter_joint_shortening\n+    (d w r cut : ℕ) (hd : 2 ≤ d) (hw0 : 1 ≤ w)\n+    (hw : w ≤ 2 ^ (d - 1) - 1) (hr : 2 ≤ r) (hcut : cut ≤ d)\n+    (tau : List (Fin d))\n+    (hold : OriginalOrder d w tau)\n+    (hnew : OriginalOrder (d + 1) (2 * w) (earWord d tau cut)) :\n+    commonCut d r cut ≤ length d r ∧\n+    OriginalOrder (length d r) (seed d w r) (shortenedWord d r hr tau cut) ∧\n+    OriginalOrder (length d r + 1) (2 * seed d w r)\n+      (earWord (length d r) (shortenedWord d r hr tau cut) (commonCut d r cut)) := by\n+  have hc : commonCut d r cut ≤ length d r := by\n+    rw [length_split d r hr]; dsimp [commonCut]; omega\n+  have hlo := lower_blocks d w r hd hw hr (earWord d tau cut) hnew\n+  have htop := top_block d w r cut hd hw hr hcut tau hold hnew\n+  have hstrip : InStrip (actualSource (length d r) (seed d w r)) (N d r / 2) 0\n+      (shortenedWord d r hr tau cut) := by\n+    unfold shortenedWord\n+    apply inStrip_append hlo.1\n+    simpa only [hlo.2, zero_add] using htop.1\n+  have hsum : ((shortenedWord d r hr tau cut).map\n+      (actualSource (length d r) (seed d w r))).sum = 0 := by\n+    simp only [shortenedWord, List.map_append, List.sum_append, hlo.2, htop.2]\n+    ring\n+  refine ⟨hc, ⟨shortened_perm d r cut hr tau hold.1, hsum, ?_⟩, ?_⟩\n+  · intro h\n+    simpa only [N, zero_add, Set.mem_Icc] using inStrip_prefix hstrip h\n+  · rw [literal_ear d r cut hr tau hold.1]\n+    exact daughter_order d w r hd hw hr _ hnew\n+\n+end D5.S3.Combinatorics.Circle.PeriodicDaughterJointShortening"},{"sha":"c05ae7adeaaa381e1b323817dbbfafa58458783a","filename":"D5/S3/Combinatorics/Circle/PeriodicDaughterJointShortening/Words.lean","status":"added","additions":296,"deletions":0,"changes":296,"blob_url":"https://github.com/the-omega-institute/trureturing/blob/95454f1bac7a754ed76e5e32426fb3beb13a6669/D5%2FS3%2FCombinatorics%2FCircle%2FPeriodicDaughterJointShortening%2FWords.lean","raw_url":"https://github.com/the-omega-institute/trureturing/raw/95454f1bac7a754ed76e5e32426fb3beb13a6669/D5%2FS3%2FCombinatorics%2FCircle%2FPeriodicDaughterJointShortening%2FWords.lean","contents_url":"https://api.github.com/repos/the-omega-institute/trureturing/contents/D5%2FS3%2FCombinatorics%2FCircle%2FPeriodicDaughterJointShortening%2FWords.lean?ref=95454f1bac7a754ed76e5e32426fb3beb13a6669","patch":"@@ -0,0 +1,296 @@\n+/- GID: D5/S3/Combinatorics/Circle/PeriodicDaughterJointShortening/Words\n+   generality: I\n+   mirror-B: D5/B/S3/Combinatorics/Circle/PeriodicDaughterJointShortening/Words\n+   mirror-E: none(waiver:no-escape-mirror-specified)\n+   anchors: [mathlib/module/Mathlib.Data.List.FinRange]\n+   utility: none\n+   digest: Literal ascending daughter blocks with one shortened top block. -/\n+import D5.S3.Combinatorics.Circle.PeriodicDaughterJointShortening.Arithmetic\n+\n+/-! Ascending physical block inventories and the literal common-cut ear. -/\n+\n+set_option autoImplicit false\n+set_option relaxedAutoImplicit false\n+\n+namespace D5.S3.Combinatorics.Circle.PeriodicDaughterJointShortening\n+open SourceWidth PeriodicShorteningArithmetic PeriodicShortening RunFirstEarTransport\n+open scoped BigOperators\n+\n+theorem length_split (d r : ℕ) (hr : 2 ≤ r) :\n+    length d r = (r - 1) * (d + 1) + d := by\n+  have he : (d + 1) * r = (r - 1) * (d + 1) + (d + 1) := by\n+    calc\n+      _ = (d + 1) * ((r - 1) + 1) := by rw [Nat.sub_add_cancel (by omega : 1 ≤ r)]\n+      _ = _ := by ring\n+  dsimp [length]; omega\n+\n+/-- Every low local ear is an ordinary OLD label. -/\n+def regularLabel (d r : ℕ) (hr : 2 ≤ r) (j : Fin (r - 1))\n+    (i : Fin (d + 1)) : Fin (length d r) :=\n+  ⟨j.val * (d + 1) + i.val, by\n+    rw [length_split d r hr]\n+    have hh := Nat.mul_le_mul_right (d + 1) (show j.val + 1 ≤ r - 1 by omega)\n+    nlinarith [i.isLt]⟩\n+\n+def topLabel (d r : ℕ) (hr : 2 ≤ r) (i : Fin d) : Fin (length d r) :=\n+  ⟨(r - 1) * (d + 1) + i.val, by rw [length_split d r hr]; omega⟩\n+\n+def daughterLabel (d r : ℕ) (hr : 2 ≤ r) (j : Fin r)\n+    (i : Fin (d + 1)) : Fin (length d r + 1) :=\n+  ⟨j.val * (d + 1) + i.val, by\n+    have he : length d r + 1 = (d + 1) * r := by\n+      have := Nat.mul_pos (show 0 < d + 1 by omega) (show 0 < r by omega)\n+      dsimp [length]; omega\n+    rw [he]\n+    have hh := Nat.mul_le_mul_right (d + 1) (show j.val + 1 ≤ r by omega)\n+    nlinarith [i.isLt]⟩\n+\n+def lowerWord (d r : ℕ) (hr : 2 ≤ r) (eta : List (Fin (d + 1))) :\n+    List (Fin (length d r)) :=\n+  (List.finRange (r - 1)).flatMap (fun j => eta.map (regularLabel d r hr j))\n+\n+def shortenedWord (d r : ℕ) (hr : 2 ≤ r) (tau : List (Fin d)) (cut : ℕ) :\n+    List (Fin (length d r)) :=\n+  lowerWord d r hr (earWord d tau cut) ++ tau.map (topLabel d r hr)\n+\n+def commonCut (d r cut : ℕ) : ℕ := (r - 1) * (d + 1) + cut\n+\n+def daughterWord (d r : ℕ) (hr : 2 ≤ r) (eta : List (Fin (d + 1))) :\n+    List (Fin (length d r + 1)) :=\n+  (List.finRange r).flatMap (fun j => eta.map (daughterLabel d r hr j))\n+\n+/-- Port of the consumed private ear-prefix lemma from RunFirstEarTransport\n+at 447f4235385fe941888b620340cd4429dfbf0e61. It includes saturated takes. -/\n+theorem ear_prefix_sum (d : ℕ) (sigma : List (Fin d)) (cut : ℕ)\n+    (hc : cut ≤ sigma.length) (f : Fin (d + 1) → ℤ) (h : ℕ) :\n+    (((earWord d sigma cut).take h).map f).sum =\n+      ((sigma.take (if h ≤ cut then h else h - 1)).map\n+        (fun i => f i.castSucc)).sum + (if h ≤ cut then 0 else f (Fin.last d)) := by\n+  induction sigma generalizing cut h with\n+  | nil =>\n+      have : cut = 0 := by simpa using hc\n+      subst cut\n+      cases h <;> simp [earWord]\n+  | cons x xs ih =>\n+      cases cut with\n+      | zero =>\n+          cases h with\n+          | zero => simp [earWord]\n+          | succ h => simp [earWord, List.map_map, Function.comp_def, add_comm]\n+      | succ cut =>\n+          have hc' : cut ≤ xs.length := by simpa using hc\n+          cases h with\n+          | zero => simp [earWord]\n+          | succ h =>\n+              have he := ih cut hc' h\n+              simp only [earWord, List.take_succ_cons, List.drop_succ_cons,\n+                List.map_cons, List.cons_append, List.sum_cons] at he ⊢\n+              split_ifs with hh\n+              · have hh' : h ≤ cut := by omega\n+                simpa [hh', List.take_succ_cons, List.sum_cons, add_assoc] using\n+                  congrArg (f x.castSucc + ·) he\n+              · have hh' : ¬ h ≤ cut := by omega\n+                simpa [hh', show h + 1 - 1 = (h - 1) + 1 by omega,\n+                  List.take_succ_cons, List.sum_cons, add_assoc] using\n+                  congrArg (f x.castSucc + ·) he\n+\n+theorem ear_sum (d : ℕ) (tau : List (Fin d)) (cut : ℕ) (f : Fin (d + 1) → ℤ) :\n+    ((earWord d tau cut).map f).sum =\n+      (tau.map (fun i => f i.castSucc)).sum + f (Fin.last d) := by\n+  have he := congrArg (fun xs : List (Fin d) =>\n+    (xs.map (fun i => f i.castSucc)).sum) (List.take_append_drop cut tau)\n+  simp only [List.map_append, List.sum_append] at he\n+  simp only [earWord, List.map_append, List.map_map, Function.comp_def,\n+    List.sum_append, List.map_singleton, List.sum_singleton]\n+  omega\n+\n+theorem lower_length (d r cut : ℕ) (hr : 2 ≤ r) (tau : List (Fin d))\n+    (htau : tau.Perm (List.finRange d)) :\n+    (lowerWord d r hr (earWord d tau cut)).length = (r - 1) * (d + 1) := by\n+  have ht : tau.length = d := by simpa using htau.length_eq\n+  have he : (earWord d tau cut).length = d + 1 := by\n+    simp only [earWord, List.length_append, List.length_map, List.length_singleton]\n+    have hh := congrArg List.length (List.take_append_drop cut tau)\n+    simp only [List.length_append] at hh\n+    omega\n+  unfold lowerWord\n+  have hlen (s : List (Fin (r - 1))) :\n+      (s.flatMap (fun j => (earWord d tau cut).map (regularLabel d r hr j))).length =\n+        s.length * (d + 1) := by\n+    induction s with\n+    | nil => simp\n+    | cons x xs ih =>\n+        simp only [List.flatMap_cons, List.length_append, List.length_map,\n+          List.length_cons, ih, he]\n+        ring\n+  simpa using hlen (List.finRange (r - 1))\n+\n+theorem ear_after (k : ℕ) (xs ys : List (Fin k)) (cut : ℕ) :\n+    earWord k (xs ++ ys) (xs.length + cut) =\n+      xs.map Fin.castSucc ++ earWord k ys cut := by\n+  induction xs with\n+  | nil => simp [earWord]\n+  | cons x xs ih =>\n+      simpa only [List.length_cons, Nat.succ_add, List.cons_append, earWord,\n+        List.take_succ_cons, List.drop_succ_cons, List.map_cons] using\n+          congrArg (fun zs => x.castSucc :: zs) ih\n+\n+theorem literal_ear (d r cut : ℕ) (hr : 2 ≤ r) (tau : List (Fin d))\n+    (htau : tau.Perm (List.finRange d)) :\n+    earWord (length d r) (shortenedWord d r hr tau cut) (commonCut d r cut) =\n+      daughterWord d r hr (earWord d tau cut) := by\n+  have hl := lower_length d r cut hr tau htau\n+  have hlow (j : Fin (r - 1)) (i : Fin (d + 1)) :\n+      (regularLabel d r hr j i).castSucc =\n+        daughterLabel d r hr ⟨j.val, by omega⟩ i := Fin.ext rfl\n+  let jt : Fin r := ⟨r - 1, by omega⟩\n+  have htop (i : Fin d) : (topLabel d r hr i).castSucc =\n+      daughterLabel d r hr jt i.castSucc := Fin.ext rfl\n+  have hfresh : Fin.last (length d r) = daughterLabel d r hr jt (Fin.last d) := by\n+    apply Fin.ext\n+    simpa [daughterLabel, jt] using length_split d r hr\n+  have hte : earWord (length d r) (tau.map (topLabel d r hr)) cut =\n+      (earWord d tau cut).map (daughterLabel d r hr jt) := by\n+    simp only [earWord, ← List.map_take, ← List.map_drop, List.map_append,\n+      List.map_map, List.map_singleton, Function.comp_def]\n+    simp_rw [htop]\n+    rw [hfresh]\n+  have hfr : List.finRange r =\n+      (List.finRange (r - 1)).map (fun j => (⟨j.val, by omega⟩ : Fin r)) ++ [jt] := by\n+    obtain ⟨s, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : r ≠ 0)\n+    have hh : List.finRange (s + 1) =\n+        (List.finRange s).map Fin.castSucc ++ [Fin.last s] :=\n+      List.finRange_succ_last\n+    have hh' : List.finRange (s + 1) =\n+        (List.finRange s).map (fun j =>\n+          (⟨j.val, Nat.lt_succ_of_lt j.isLt⟩ : Fin (s + 1))) ++\n+            [⟨s, Nat.lt_succ_self s⟩] := by\n+      rw [hh]\n+      apply congrArg₂ List.append\n+      · apply List.map_congr_left\n+        intro j _\n+        exact Fin.ext rfl\n+      · apply congrArg List.singleton\n+        exact Fin.ext rfl\n+    simpa only [jt, Nat.succ_sub_one, Nat.add_sub_cancel] using hh'\n+  unfold shortenedWord commonCut\n+  rw [← hl, ear_after, hte]\n+  unfold daughterWord\n+  rw [hfr]\n+  simp only [List.flatMap_append, List.flatMap_map, List.flatMap_cons,\n+    List.flatMap_nil, List.append_nil]\n+  congr 1\n+  simp only [lowerWord, List.map_flatMap, List.map_map, Function.comp_def]\n+  apply congrArg (fun f : Fin (r - 1) → List (Fin (length d r + 1)) =>\n+    (List.finRange (r - 1)).flatMap f)\n+  funext j\n+  apply List.map_congr_left\n+  intro i hi\n+  exact hlow j i\n+\n+/-- The product-inventory proof is the ascending version of the consumed\n+private block_perm argument in PhysicalJointRepetition at settled\n+51518b6ee6ccebd7ee3cb0e03e5c13589a570a9c. No transport theorem is imported. -/\n+theorem daughter_perm (d r : ℕ) (hr : 2 ≤ r) (eta : List (Fin (d + 1)))\n+    (heta : eta.Perm (List.finRange (d + 1))) :\n+    (daughterWord d r hr eta).Perm (List.finRange (length d r + 1)) := by\n+  classical\n+  let θ : Fin r × Fin (d + 1) → Fin (length d r + 1) :=\n+    fun p => daughterLabel d r hr p.1 p.2\n+  have hinj : Function.Injective θ := by\n+    rintro ⟨j, i⟩ ⟨k, h⟩ he\n+    have hv := congrArg Fin.val he\n+    change j.val * (d + 1) + i.val = k.val * (d + 1) + h.val at hv\n+    have hjk : j.val = k.val := by\n+      have hjd : (j.val * (d + 1) + i.val) / (d + 1) = j.val := by\n+        apply Nat.div_eq_of_lt_le\n+        · omega\n+        · nlinarith [i.isLt]\n+      have hkd : (k.val * (d + 1) + h.val) / (d + 1) = k.val := by\n+        apply Nat.div_eq_of_lt_le\n+        · omega\n+        · nlinarith [h.isLt]\n+      have hh := congrArg (fun z => z / (d + 1)) hv\n+      rw [hjd, hkd] at hh\n+      exact hh\n+    rw [hjk] at hv\n+    have hih : i.val = h.val := by omega\n+    exact Prod.ext (Fin.ext hjk) (Fin.ext hih)\n+  let row : Fin r → List (Fin (length d r + 1)) :=\n+    fun j => (List.finRange (d + 1)).map (fun i => θ (j, i))\n+  have hcomplete : ((List.finRange r).flatMap row).Perm\n+      (List.finRange (length d r + 1)) := by\n+    have he : (List.finRange r).flatMap row =\n+        ((List.finRange r).product (List.finRange (d + 1))).map θ := by\n+      simp only [row, List.product, List.map_flatMap, List.map_map, Function.comp_def]\n+    rw [he]\n+    apply (List.perm_ext_iff_of_nodup\n+      (((List.nodup_finRange r).product (List.nodup_finRange (d + 1))).map hinj)\n+      (List.nodup_finRange _)).mpr\n+    intro x\n+    simp only [List.mem_finRange, iff_true]\n+    have hlen : length d r + 1 = (d + 1) * r := by\n+      have := Nat.mul_pos (show 0 < d + 1 by omega) (show 0 < r by omega)\n+      dsimp [length]; omega\n+    let j : Fin r := ⟨x.val / (d + 1), by\n+      apply (Nat.div_lt_iff_lt_mul (by omega : 0 < d + 1)).2\n+      have hx : x.val < (d + 1) * r := by rw [← hlen]; exact x.isLt\n+      simpa only [Nat.mul_comm] using hx⟩\n+    let i : Fin (d + 1) := ⟨x.val % (d + 1), Nat.mod_lt _ (by omega)⟩\n+    have hv : θ (j, i) = x := by\n+      apply Fin.ext\n+      simpa [θ, daughterLabel, j, i, Nat.add_comm, Nat.mul_comm] using\n+        Nat.mod_add_div x.val (d + 1)\n+    exact List.mem_map.mpr ⟨(j, i), by simp, hv⟩\n+  exact (List.Perm.flatMap_left _ (fun j _ => heta.map _)).trans hcomplete\n+\n+theorem ear_perm (d : ℕ) (tau : List (Fin d)) (cut : ℕ)\n+    (htau : tau.Perm (List.finRange d)) :\n+    (earWord d tau cut).Perm (List.finRange (d + 1)) := by\n+  have he : (earWord d tau cut).Perm (tau.map Fin.castSucc ++ [Fin.last d]) := by\n+    unfold earWord\n+    rw [List.map_take, List.map_drop]\n+    have hp := (List.perm_append_comm :\n+      ([Fin.last d] ++ (tau.map Fin.castSucc).drop cut).Perm\n+        ((tau.map Fin.castSucc).drop cut ++ [Fin.last d])).append_left\n+          ((tau.map Fin.castSucc).take cut)\n+    have hj : (tau.map Fin.castSucc).take cut ++\n+        ((tau.map Fin.castSucc).drop cut ++ [Fin.last d]) =\n+        tau.map Fin.castSucc ++ [Fin.last d] := by\n+      rw [← List.append_assoc, List.take_append_drop]\n+    rw [hj] at hp\n+    simpa only [List.append_assoc] using hp\n+  exact he.trans (by simpa [List.finRange_succ_last] using\n+    (htau.map Fin.castSucc).append_right [Fin.last d])\n+\n+/-- Delete just the globally fresh label; all local ear labels survive. -/\n+def removeFresh (k : ℕ) (i : Fin (k + 1)) : Option (Fin k) :=\n+  if hi : i.val < k then some ⟨i.val, hi⟩ else none\n+\n+theorem old_perm_of_ear (k : ℕ) (sigma : List (Fin k)) (cut : ℕ)\n+    (he : (earWord k sigma cut).Perm (List.finRange (k + 1))) :\n+    sigma.Perm (List.finRange k) := by\n+  have hmap (xs : List (Fin k)) :\n+      (xs.map Fin.castSucc).filterMap (removeFresh k) = xs := by\n+    induction xs with\n+    | nil => simp\n+    | cons x xs ih => simp [removeFresh, x.isLt, ih]\n+  have hf : removeFresh k (Fin.last k) = none := by simp [removeFresh]\n+  have hleft : (earWord k sigma cut).filterMap (removeFresh k) = sigma := by\n+    simp only [earWord, List.filterMap_append, List.filterMap_cons, hf,\n+      List.filterMap_nil, hmap, List.append_nil]\n+    exact List.take_append_drop cut sigma\n+  have hright : (List.finRange (k + 1)).filterMap (removeFresh k) = List.finRange k := by\n+    rw [List.finRange_succ_last, List.filterMap_append, hmap]\n+    simp [hf]\n+  have hh := he.filterMap (removeFresh k)\n+  simpa only [hleft, hright] using hh\n+\n+theorem shortened_perm (d r cut : ℕ) (hr : 2 ≤ r) (tau : List (Fin d))\n+    (htau : tau.Perm (List.finRange d)) :\n+    (shortenedWord d r hr tau cut).Perm (List.finRange (length d r)) := by\n+  apply old_perm_of_ear (length d r) _ (commonCut d r cut)\n+  rw [literal_ear d r cut hr tau htau]\n+  exact daughter_perm d r hr _ (ear_perm d tau cut htau)\n+\n+end D5.S3.Combinatorics.Circle.PeriodicDaughterJointShortening"},{"sha":"a88b9d919a08e160043578ea32cfa98ce9a5139b","filename":"Golden/Frozen/state/D5/S3/Combinatorics/Circle/PeriodicDaughterJointShortening/Construction.lean.json","status":"added","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/the-omega-institute/trureturing/blob/95454f1bac7a754ed76e5e32426fb3beb13a6669/Golden%2FFrozen%2Fstate%2FD5%2FS3%2FCombinatorics%2FCircle%2FPeriodicDaughterJointShortening%2FConstruction.lean.json","raw_url":"https://github.com/the-omega-institute/trureturing/raw/95454f1bac7a754ed76e5e32426fb3beb13a6669/Golden%2FFrozen%2Fstate%2FD5%2FS3%2FCombinatorics%2FCircle%2FPeriodicDaughterJointShortening%2FConstruction.lean.json","contents_url":"https://api.github.com/repos/the-om