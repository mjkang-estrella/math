.Create(\n+        \"Integer charge identities for the periodic daughter transport\",\n+        H(\"Arithmetic for the periodic daughter construction\"),\n+        Blocks(\n+            Paragraph(Text(\n+                \"This helper module gives the integer arithmetic used by the existing \"\n+                    + \"PeriodicDaughterJointShortening.Construction proof. The definitions \"\n+                    + \"name the old length, repeated seed, geometric scale factors and native \"\n+                    + \"digit phases; the theorems below are the exact source, centered-value and \"\n+                    + \"cross-modulus identities consumed by regular_block, top_block and \"\n+                    + \"daughter_order.\")),\n+            Node(\"length\", \"The shortened physical length\",\n+                \"length d r is (d+1)*r-1, the old physical modulus length after one globally fresh daughter label is removed.\", DescribeRole.Definition),\n+            Node(\"seed\", \"The repeated seed\",\n+                \"seed d w r is w multiplied by geom (d+1) r; Construction uses it as the old source and twice this value as the daughter source.\", DescribeRole.Definition),\n+            Node(\"q\", \"The daughter row base\",\n+                \"q d is the integer power 2^(d+1).\", DescribeRole.Definition),\n+            Node(\"n\", \"The old modulus parameter\",\n+                \"n d is the integer 2^d-1, the old two-run modulus.\", DescribeRole.Definition),\n+            Node(\"H\", \"The lower geometric scale\",\n+                \"H d r is geom (d+1) (r-1), the scale of the complete lower old blocks.\", DescribeRole.Definition),\n+            Node(\"R\", \"The top geometric scale\",\n+                \"R d r is q d raised to r-1, the scale of the shortened top block.\", DescribeRole.Definition),\n+            Node(\"G\", \"The daughter geometric scale\",\n+                \"G d r is geom (d+1) r, the scale of each complete daughter block.\", DescribeRole.Definition),\n+            Node(\"N\", \"The old actual modulus\",\n+                \"N d r is modulus (length d r), the actual integer modulus used by the old source.\", DescribeRole.Definition),\n+            Node(\"ScaleFacts\", \"The scalar arithmetic package\",\n+                \"ScaleFacts d w r records the exact length, geometric, positivity, half-modulus, modulus, margin and daughter-capacity identities needed for the construction. Its fields include length_succ, q_eq, q_ge, H_ge, R_ge, G_ge, w_nonneg, w_bound, G_eq, modulus_eq, top_power, top_modulus, old_half, base_half, daughter_half, new_modulus, regular_margin, top_margin and daughter_margin.\", DescribeRole.Definition),\n+            Node(\"scale_facts\", \"All scalar identities at the actual modulus\",\n+                \"For 2≤d, w≤2^(d-1)-1 and 2≤r, scale_facts constructs ScaleFacts d w r. Construction uses this package in every regular, top and daughter block estimate.\", DescribeRole.Theorem),\n+            Node(\"alpha\", \"The extended old phase\",\n+                \"alpha d w i is the native actualSource d w digit at i when i<d and is w at the distinct final local-ear phase.\", DescribeRole.Definition),\n+            Node(\"e\", \"The extended native charge\",\n+                \"e d w i is charge d w at old digits and w at the final local-ear phase.\", DescribeRole.Definition),\n+            Node(\"beta\", \"The daughter phase\",\n+                \"beta d w is actualSource (d+1) (2*w), the actual daughter phase function.\", DescribeRole.Definition),\n+            Node(\"phase_data\", \"Phase and charge identities\",\n+                \"For 2≤d, w≤2^(d-1)-1 and every i: e is nonnegative; alpha equals 2^i*w-n*e; beta equals 2*alpha-e; beta also equals 2^(i+1)*w-(q-1)*e; and beta lies between -n and n. Construction uses these bounds for all prefix and centered estimates.\", DescribeRole.Theorem),\n+            Node(\"phase_fresh\", \"The fresh phase value\",\n+                \"Under the old dimension and width bounds, beta d w (Fin.last d)=w.\", DescribeRole.Theorem),\n+            Node(\"phase_cast\", \"The old phase cast\",\n+                \"For every old digit i, beta d w i.castSucc = 2*actualSource d w i-charge d w i.\", DescribeRole.Theorem),\n+            Node(\"phase_charge_sum\", \"The extended charge sum\",\n+                \"Under the old dimension and width bounds, the sum of e over Fin (d+1) is 2*w.\", DescribeRole.Theorem),\n+            Node(\"defect\", \"The nonnegative cross-modulus defect\",\n+                \"defect d w j i is 2^(i+1)*w*geom (d+1) j+e d w i; it carries the integer discrepancy of a regular repeated block without division or parity choices.\", DescribeRole.Definition),\n+            Node(\"regularValue\", \"The regular block value\",\n+                \"regularValue d w r j i is 2^d*H*beta plus alpha plus 2^i*w*geom (d+1) j, with all factors at d,w,r.\", DescribeRole.Definition),\n+            Node(\"topValue\", \"The top block value\",\n+                \"topValue d w r i is R*actualSource d w i+H*beta d w i.castSucc.\", DescribeRole.Definition),\n+            Node(\"defect_data\", \"Defect positivity and total\",\n+                \"For every phase i, defect is nonnegative, and its sum over Fin (d+1) is 2*w*q^j. Construction uses this exact total in regular_block.\", DescribeRole.Theorem),\n+            Node(\"regular_double\", \"The regular doubled-value identity\",\n+                \"For every regular block index j and phase i, 2*regularValue d w r j i = G*beta d w i+defect d w j i. Construction uses it to transfer the daughter prefix bounds to each old block.\", DescribeRole.Theorem),\n+            Node(\"regular_source\", \"The actual regular source value\",\n+                \"For j<r-1 and a valid physical label j*(d+1)+i.val below length d r, actualSource (length d r) (seed d w r) at that label equals regularValue d w r j i. Construction uses this live equality in regular_block.\", DescribeRole.Theorem),\n+            Node(\"top_source\", \"The actual top source value\",\n+                \"For a valid top label (r-1)*(d+1)+i.val below length d r, actualSource at the repeated seed equals topValue d w r i. Construction uses this live equality in top_block.\", DescribeRole.Theorem),\n+            Node(\"daughter_source\", \"The actual periodic daughter source\",\n+                \"For every daughter block j and phase i at a valid label below length d r+1, actualSource (length d r+1) (2*seed d w r) equals G*daughter phase beta d w i. Construction uses this live equality in daughter_order.\", DescribeRole.Theorem)),\n+        []));\n+\n+    private static DocumentBlock Node(string name, string title, string prose, DescribeRole role) =>\n+        Describe.Lean(DescribeId.Create(\"periodic-daughter-arithmetic-\" + CanonicalId(name)),\n+            DeclarationHandle.Create(Prefix + name), H(title), StatementSource.WithoutFormula(),\n+            AssessedProvenance.FromRepo(), Blocks(Paragraph(Text(prose))), role);\n+\n+    private static string CanonicalId(string name) => name switch\n+    {\n+        \"n\" => \"old-modulus-parameter\",\n+        \"N\" => \"actual-modulus\",\n+        \"H\" => \"lower-geometric-scale\",\n+        \"R\" => \"top-geometric-scale\",\n+        \"G\" => \"daughter-geometric-scale\",\n+        _ => name.ToLowerInvariant().Replace('_', '-')\n+    };\n+}"},{"sha":"67ff6942a36dcda2595814bc63fe2400eb909ce2","filename":"Blueprint/D5/S3/Combinatorics/Circle/PeriodicDaughterJointShortening/Construction.md","status":"added","additions":37,"deletions":0,"changes":37,"blob_url":"https://github.com/the-omega-institute/trureturing/blob/95454f1bac7a754ed76e5e32426fb3beb13a6669/Blueprint%2FD5%2FS3%2FCombinatorics%2FCircle%2FPeriodicDaughterJointShortening%2FConstruction.md","raw_url":"https://github.com/the-omega-institute/trureturing/raw/95454f1bac7a754ed76e5e32426fb3beb13a6669/Blueprint%2FD5%2FS3%2FCombinatorics%2FCircle%2FPeriodicDaughterJointShortening%2FConstruction.md","contents_url":"https://api.github.com/repos/the-omega-institute/trureturing/contents/Blueprint%2FD5%2FS3%2FCombinatorics%2FCircle%2FPeriodicDaughterJointShortening%2FConstruction.md?ref=95454f1bac7a754ed76e5e32426fb3beb13a6669","patch":"@@ -0,0 +1,37 @@\n+# Minus-one physical joint transport with a periodic daughter\n+\n+## Abstract\n+\n+Minus-one physical joint transport with a periodic daughter\n+\n+**Theorem 1.1 (Minus-one physical joint transport with a periodic daughter).**\n+\n+Lean statement: `D5/S3/Combinatorics/Circle/PeriodicDaughterJointShortening/Construction.periodic_daughter_joint_shortening`\n+\n+*Proof.* Machine-checked in Lean as `D5/S3/Combinatorics/Circle/PeriodicDaughterJointShortening/Construction.periodic_daughter_joint_shortening` (`✓ std3`). ∎\n+\n+*Source.* Repository-derived.\n+\n+*Commentary.*\n+\n+For every d>=2, 1<=w<=2^(d-1)-1, r>=2 and cut<=d, assume the full actual OriginalOrder of tau at (d,w) and of its literal ear eta at (d+1,2w). Put D=d+1, K=D*r-1, U=w*geom(D,r). The explicit OLD word consists of ascending copies of eta at physical blocks j<r-1 followed by the top copy of tau. Its common cut is (r-1)*D+cut, at most K. The conclusions are both full actual OriginalOrder predicates, at (K,U) and (K+1,2U), with the latter word exactly the literal global ear of the former.\n+\n+Write q=2^D, n=2^d-1, H_j=geom(D,j), H=H_(r-1), R=q^(r-1), G=geom(D,r), N=2^K-1. Then G=H+R=1+qH and (q-1)G=2N+1. The native old digit charge e_i satisfies alpha_i=2^i*w-n*e_i and beta_i=2*alpha_i-e_i. Extend the distinct local ear phase by alpha_d=e_d=beta_d=w. Its total charge is 2w. The nonnegative defect B_j(i)=2^(i+1)*w*H_j+e_i has total 2w*q^j.\n+\n+For a regular OLD label jD+i the integer V_j(i)=2^d*H*beta_i+alpha_i+2^i*w*H_j satisfies 2V_j=G*beta_i+B_j. The exact uncentered difference is N*B_j=N*(H_j*beta_i+q^j*e_i). The inequality 4w<=q-4 and H_j+q^j<=H give G*n+2wH<=N-1. Thus both centered bounds and every regular block prefix hold at the actual OLD modulus; its total is w*q^j and its incoming height is w*H_j. This uses an integer formula throughout, with no parity or integer division assumption.\n+\n+For a top OLD label (r-1)D+i the actual centered value is T_i=R*alpha_i+H*beta_i. Its exact uncentered difference is N*(2^(i+1)*w*H+e_i). Centered uniqueness follows from N=R*n+(q-1)H. A top prefix has incoming height wH, an alpha prefix a in [0,(n-1)/2], and a beta prefix b in [-w,n]. The latter follows from the actual eta prefix at h or h+1 and beta_d=w. Therefore wH+R*a+H*b is nonnegative and its doubled upper bound is R(n-1)+2H(n+w)<=N-1. The top total is -wH; the complete OLD total is zero.\n+\n+At every enlarged physical label jD+i the exact actual source is G*beta_i at modulus 2^(Dr)-1=(q-1)G. Each complete eta block is a scaled zero loop. Every natural prefix lies in [0,G*n], and G*n is at most the enlarged half modulus. The literal ear identity produces r complete ascending eta blocks. Product inventory proves each enlarged physical label occurs once; deleting only the global fresh label proves the OLD permutation. The recursive strip and take lemmas include empty, complete and overlong prefixes and both endpoint cuts.\n+\n+The theory connects cyclic doubling orbits and arithmetic across adjacent moduli: repetition scales the daughter orbit, while nonnegative native charges control the shortened parent. No cyclic gap invariance or cross-modulus equivariance is assumed. Numerical equality never identifies distinct physical labels. This theorem is a new MINUS-one construction, not an application of PLUS-one shortening or forward OLD repetition.\n+\n+## Unbounded four-gap application\n+\n+Let a>=2, b>a and b>=3. Set d=a+b-1, w=2^a+1, r=2. The two base gaps are a and b-1, both at least two; the library two-negative nondecreasing/strict joint-lift theorems supply a common-cut witness according as a<=b-1 or b-1<a. Since b-1>=2, d-1>=a+1 and 2^a+1<=2^(d-1)-1. Then K=2(a+b)-1 and U=(2^a+1)(1+2^(a+b))=1+2^a+2^(a+b)+2^(2a+b), the four gaps (a,b,a,b-1). This is an entire unbounded application, including (s,s+1,s,s); it is explanatory algebra under the generic endpoint, with no additional specialization theorem or registration.\n+\n+Full arbitrary b-maximum J and CircleJ/C3.1 remain open.\n+\n+## References\n+\n+- Truth anchor: `D5/S3/Combinatorics/Circle/PeriodicDaughterJointShortening/Construction.periodic_daughter_joint_shortening`"},{"sha":"75dc2046bfe697ddf882f77887b9b2a7a14a8f92","filename":"Blueprint/D5/S3/Combinatorics/Circle/PeriodicDaughterJointShortening/Construction.scribe.cs","status":"added","additions":26,"deletions":0,"changes":26,"blob_url":"https://github.com/the-omega-institute/trureturing/blob/95454f1bac7a754ed76e5e32426fb3beb13a6669/Blueprint%2FD5%2FS3%2FCombinatorics%2FCircle%2FPeriodicDaughterJointShortening%2FConstruction.scribe.cs","raw_url":"https://github.com/the-omega-institute/trureturing/raw/95454f1bac7a754ed76e5e32426fb3beb13a6669/Blueprint%2FD5%2FS3%2FCombinatorics%2FCircle%2FPeriodicDaughterJointShortening%2FConstruction.scribe.cs","contents_url":"https://api.github.com/repos/the-omega-institute/trureturing/contents/Blueprint%2FD5%2FS3%2FCombinatorics%2FCircle%2FPeriodicDaughterJointShortening%2FConstruction.scribe.cs?ref=95454f1bac7a754ed76e5e32426fb3beb13a6669","patch":"@@ -0,0 +1,26 @@\n+using static StrataLint.Scribe.DefinitionDsl;\n+\n+namespace StrataLint.Scribe.Blueprint.D5.S3.Combinatorics.Circle.PeriodicDaughterJointShortening;\n+\n+internal sealed class PeriodicDaughterJointShorteningDocument : IScribeDocumentDefinition\n+{\n+    public DocumentDefinition Create() => DocumentDefinition.Create(ScribeNode.Create(\n+        \"Minus-one physical joint transport with a periodic daughter\",\n+        H(\"Minus-one physical joint transport with a periodic daughter\"),\n+        Blocks(\n+            Describe.Lean(DescribeId.Create(\"periodic-daughter-joint-shortening\"),\n+                DeclarationHandle.Create(\"D5/S3/Combinatorics