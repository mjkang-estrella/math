import CrownVCoordDiff
import CrownVCoordSpanKernel

/-!
# Crown variety: the coordinate-kernel equality

Combining the sealed forward inclusion `CrownV.coordSpan_le_ker` with the
difference lemma `CrownV.coordKill_sub_mem_span`, the kernel of the coordinate
killing endomorphism `CrownV.coordKill T` is exactly the ideal generated by the
coordinate functions `CrownV.xx v` and `CrownV.yy v` for `v ∈ T`, for every
ring `K` and every finite vertex set `T` (all `n`, including `n = 0` and empty
or full `T`, all characteristics).
-/

namespace CrownV

variable {n : Nat} {K : Type*} [CommRing K]

/-- Reverse inclusion: the kernel of `coordKill T` is contained in the ideal
generated by the coordinate generators. -/
theorem coordKer_le_span (T : Finset (V n)) :
    RingHom.ker (coordKill (n := n) (K := K) T)
      ≤ Ideal.span (coordGens T : Set (PolyRing n K)) := by
  intro p hp
  rw [RingHom.mem_ker] at hp
  have h : (p : PolyRing n K)
      - coordKill (n := n) (K := K) T p
        ∈ Ideal.span (coordGens T : Set (PolyRing n K)) :=
    coordKill_sub_mem_span (n := n) (K := K) T p
  rw [hp, sub_zero] at h
  exact h

/-- The kernel of `coordKill T` equals the coordinate ideal
`Ideal.span (coordGens T)`. -/
theorem coordKill_ker_eq (T : Finset (V n)) :
    RingHom.ker (coordKill (n := n) (K := K) T)
      = Ideal.span (coordGens T : Set (PolyRing n K)) :=
  le_antisymm (coordKer_le_span T) (coordSpan_le_ker T)

end CrownV
