

%%%%%%%%%%%%%%%%
% Macros for blackboard bold for complex numbers etc.
\newcommand{\blackboard}[1]{\ensuremath{\mathbb{#1}}}

\newcommand{\complexes}{\blackboard{C}}
\newcommand{\hyperbolic}{\blackboard{H}}
\newcommand{\unitdisc}{\blackboard{D}}
\newcommand{\integers}{\blackboard{Z}} %
\newcommand{\reals}{\blackboard{R}}
\newcommand{\naturals}{\blackboard{N}}
\newcommand{\rationals}{\blackboard{Q}}

\newcommand{\SL}{\ensuremath{\mathrm{SL}}}
\newcommand{\PSL}{\ensuremath{\mathrm{PSL}}}
\newcommand{\GL}{\ensuremath{\mathrm{GL}}}

%    $a \in PSL(2,Z)$
% -> $a \in \PSL(2,\integers)$



\newcommand{\name}[1]{\noindent \small #1}
\newcommand{\address}[1]{\noindent \small #1}
\newcommand{\email}[1]{\small \noindent \texttt{#1}}


% Miscellaneous macros:

\newcommand{\nl}{\hfil\break\vspace*{-0.5cm}}   
    % use this for theorems etc. which are numbered with no text before to break line

\newcommand{\hf}{\hspace*{\fill}}    % fill the rest of the line with blank space
\newcommand{\vs}{\vspace*{0.2cm}}    % small vertical space

\newcommand{\ie}{i.e.\ }
\newcommand{\eg}{e.g.\ }
\newcommand{\defn}[1]{\textsl{#1}}  % use for defining things

\newcommand{\st}{\colon}  % 'such that' in set definitions

\newcommand{\defeq}{:=}

\newcommand{\vol}[1]{\textbf{#1}}




%%%%%%%%%%%%%%%%%%
% Align addresses with biblio entries:

\newenvironment{finalspacing}[1]%
{%
\settowidth\labelwidth{\@biblabel{#1}}
%\setlength{\leftskip}{\labelwidth}
\addtolength{\leftskip}{\labelwidth}
\addtolength{\leftskip}{\labelsep} 
\addtolength{\leftskip}{-\labelwidth} 
\addtolength{\leftskip}{\labelwidth}
}{}



\newcommand{\firstpage}{}
\newcommand{\lastpage}{}

\newcommand{\classmark}[1]{\noindent \small \textbf{AMS Classification:} #1}
\newcommand{\keywords}[1]{\noindent \small \textbf{Keywords:} #1}

%\newenvironment{thmenum}
%{\begin{enumerate}[\quad{\rm(i)}]}
%{\end{enumerate}}

\renewcommand{\theenumi}{\roman{enumi}}
\renewcommand{\labelenumi}{{\rm(\theenumi)}}

%\newcommand{\figref}[1]{fig.\ \ref{#1}}


\newcommand{\centrefig}[2][1] {         % additional optional argument
    \centering \includegraphics[scale=#1]{#2}
}

\let\centerfig\centrefig


\providecommand{\head}[1] {
  \vs
  \markboth{}{}
  \setcounter{section}{0}
  \renewcommand{\baselinestretch}{0.9}
  %
  \begin{center}
  \begin{Large}
  \textbf{#1}
  \end{Large}
  \end{center}
  %
  \renewcommand{\baselinestretch}{1.15}
  \normalsize
}


\providecommand{\auth}[1] {
  \renewcommand{\baselinestretch}{1}
  \begin{center}
   \large\em#1
  \end{center}
}


\newcommand{\dohead} {
  %\thispagestyle{titlepage}
  \head{\title} \auth{\author}
  %\insertcontents{\title}{\author} 
}