%!PS-Adobe-2.0 EPSF-2.0
%%Title: jammed_config.eps
%%BoundingBox: 50 136 135 221
%%Orientation: Portrait
%%CreationDate: 2-May-2003
%%EndComments
%%
%%   begin common area of Postscript figures 
%   Statistical Mechanics: Algorithms and Computations
%                   Werner Krauth
%            Oxford University Press (2004)
%              smacdict: (30-JUN-2003)
%For  5 cm: x2 - x1 (in bounding box) = 143 (offset 4 cm: 114 256)
%For 10.9 cm: x2 - x1 (in bounding box) = 309 
%
/nscalefont 8 def
/cm { 0.0351 div} def
/sq32 0.866 def % sqrt(3)/2
/Times-Roman findfont nscalefont scalefont setfont
/thicklinewidth 1.5 def
/normallinewidth 1.0 def    % 0.35377 mm or 1/72 inch 
/thinlinewidth 0.5 def
/white 1.0 def     %    0 % gray = white
/lightgray .8 def  %   20 % gray ---use for standard particle (disk, spin etc)
/mediumgray .6 def %   40 % gray ---use for secondary emphasis (not a particle, or a spin)
/darkgray .4 def   %   60 % gray ---use for emphasized particle (disk, spin etc)
/black .0 def      %   100% gray= black
/tinyradius 0.03 cm  def  %  
/smallradius 0.07 cm  def  %  These radii are in unscaled centimeters: 
/meanradius 0.15 cm  def   %  they are to be used to mark standard dot sizes
/bigradius 0.35 cm  def    %  independent of figure scaling.
                           %
/arrow_ishift .0 cm def    %  defines the shift in arrow (beginning shift)
/arrow_fshift .0 cm def    %
/xtic {  % usage x y xtic ----tic in x-direction
       gsave
       thinlinewidth setlinewidth
       moveto 3.15 0 rlineto
       stroke grestore} def
/nxtic {  % usage x y xtic ----negative tic in x-direction
       gsave
       thinlinewidth setlinewidth
       moveto -3.15 0 rlineto
       stroke grestore} def
/ytic {  % usage x y xtic - tic in y-direction
       gsave
       thinlinewidth setlinewidth
       moveto 0 3.15 rlineto
       stroke grestore} def
/nytic {  % usage x y xtic ---negative tic in y-direction
       gsave
       thinlinewidth setlinewidth
       moveto 0 -3.15 rlineto
       stroke grestore} def
/dot {  % usage: x y radius dot (draws a dot (filled circle) of given radius in current grayvalue)
gsave
   0 360 arc
   gsave
      fill
   grestore
   gsave
      black setgray
      stroke
   grestore
grestore
} def
/pdot { % usage x y r pdot % draws a dot with periodic boundary conditions.
        % needs variables Lx and Ly to be declared. Also probably needs a
        % clip operation to be performed.
   /radius exch def
   /x2 exch def
   /x1 exch def
   x1        x2         radius dot
   x1 Lx add x2         radius dot
   x1 Lx sub x2         radius dot
   x1        x2 Ly add  radius dot
   x1 Lx add x2 Ly add  radius dot
   x1 Lx sub x2 Ly add  radius dot
   x1        x2 Ly sub  radius dot
   x1 Lx add x2 Ly sub  radius dot
   x1 Lx sub x2 Ly sub  radius dot
} def
/circle {  % usage: x y radius circle (draws an unfilled circle of given radius)
           % the linewidth is not specified
gsave
   0 360 arc
   black setgray
   stroke
grestore
} def
/frame{    % usage xmin ymin xmax ymax frame (makes a frame, for draw and clip)
           % the linewidth is not specified
   /ymax exch def
   /xmax exch def
   /ymin exch def
   /xmin exch def
   xmin  ymin moveto
   xmax  ymin lineto
   xmax  ymax lineto
   xmin  ymax lineto
   closepath
} def
/frameadvance{ % usage frameadvance  % needs xframe_advance, yframe_advance, Nframe 
   /iframe iframe 1 add def
   iframe Nframe lt {xframe_advance 0  translate}
   {xframe_advance 1 Nframe sub mul yframe_advance -1 mul translate /iframe 0 def} ifelse
} def
/arrow{ % usage xmin ymin xmax ymax arrow (draws a filled arrow from min to max, variable width)
        % width is set by currentlinewidth, graylevel by currentgray
        % two additional shift parametes arrow_ishift and arrow_fshift (default 0) can be
        % modified for having arrows which do not exactly start at rmin and stop at rmax
   /ymax exch def
   /xmax exch def
   /ymin exch def
   /xmin exch def
   gsave
      0 setlinecap 
      xmin ymin translate
      /xmax xmax xmin sub def  
      /ymax ymax ymin sub def  
      /arrowlength xmax dup mul ymax dup mul add sqrt arrow_ishift sub arrow_fshift sub def
      ymax xmax atan rotate
      arrow_ishift 0 translate
      /arrowlateral  currentlinewidth 1.5 mul def
      arrowlateral 1.5 lt {/arrowlateral 1.5 def} if
      /arrowyoffset  currentlinewidth 2 div thinlinewidth 2 div sub def 
      /arrowheadlength arrowlateral 3 mul def  
      arrowheadlength arrowlength .6 mul gt {/arrowheadlength arrowlength .6 mul def} if 
      0 arrowyoffset moveto
      arrowlength arrowheadlength sub arrowyoffset  lineto
      arrowlength arrowheadlength sub arrowlateral lineto
      arrowlength 0 lineto
      arrowlength arrowheadlength sub arrowlateral -1 mul lineto
      arrowlength arrowheadlength sub arrowyoffset -1 mul lineto
      0 arrowyoffset -1 mul lineto
      closepath
      gsave
         fill
      grestore
      gsave
         thinlinewidth setlinewidth
         black setgray 
         stroke
      grestore
   grestore
} def
/graph_paper {
gsave
   20 20 moveto 
   575 20 lineto
   575 822 lineto
   20 822 lineto
   closepath clip
   .3 setgray
   .1 setlinewidth
   gsave
      1 1 250 {
      0.1 cm 0.0 cm translate
      0 0 moveto
      0 842 lineto
      } for
      stroke
   grestore
   gsave
      1 1 450 {
      0.0 cm 0.1 cm translate
      0 0 moveto
      595 0 lineto
      } for
      stroke
   grestore

   .5 setlinewidth
   gsave
      1 1 25 {
      1 cm 0.0 cm translate
      0 0 moveto
      0 842 lineto
      } for
      stroke
   grestore
   gsave
      1 1 35 {
      0.0 cm 1 cm translate
      0 0 moveto
      595 0 lineto
      } for
      stroke
   grestore
grestore
} def
/nran {    % usage: N nran (picks random number between 1 and N)
rand exch mod 1 add } def 
/ran01 {    % usage ran01  (picks random number between 0 and 1)
/xnorm 10000 def
rand xnorm mod cvr xnorm div } def 
/5cmbaseline {0 0 moveto 5 cm 0 lineto stroke} def
/10.9cmbaseline {0 0 moveto 10.9 cm 0 lineto stroke} def
%
% Text positioning commands:
% MRshow right justify (use nxoffset - negative xoffset)
% MLshow left justify  (use pxoffset - positive xoffset)
% MCshow center below  (use myoffset - negative yoffset)
%
/MFshow {{dup dup 0 get findfont exch 1 get scalefont setfont
     [ currentpoint ] exch dup 2 get 0 exch rmoveto dup dup 5 get exch 4 get
     {show} {stringwidth pop 0 rmoveto}ifelse dup 3 get
     {2 get neg 0 exch rmoveto pop} {pop aload pop moveto}ifelse} forall} bind def
/MFwidth {0 exch {dup 3 get{dup dup 0 get findfont exch 1 get scalefont setfont
      5 get stringwidth pop add}
    {pop} ifelse} forall} bind def
/MLshow { currentpoint stroke moveto
  0 exch rmoveto MFshow } bind def
/MRshow { currentpoint stroke moveto
  exch dup MFwidth neg 3 -1 roll rmoveto MFshow } def
/MCshow { currentpoint stroke moveto
  exch dup MFwidth -2 div 3 -1 roll rmoveto MFshow } def
/nxoffset {-4.8 0 rmoveto} def  % negative x offset  (for labels)
/pxoffset { 4.8 0 rmoveto} def  % positive x offset  (for labels)
/nyoffset { 0  -8 rmoveto} def  % negative y offset  (for labels)
/pyoffset { 0   8 rmoveto} def  % positive y offset  (for labels)
/pyticoffset { 0   11.2 rmoveto} def  % positive y offset  (for labels)
/nxticoffset {-8.0 0 rmoveto} def  % negative x offset  (for labels)
/nyticoffset { 0  -11.2 rmoveto} def  % negative y offset  (for labels)
/low -2.4 def % use this value for subscripts
/high 4. def  % use this value for superscripts
/regshift -2.665 def  % use this value for regular
/subshift -1.865 def  % use this value for subscript
/supshift -3.465 def  % use this value for superscript
/subsupshift -2.665 def % use this value for superscript+subscript
%4 cm  1 cm  moveto
%nxoffset
%[
%[(Times-Italic) 8.0 0.0 true true (WERNER)]
%[(Symbol) 6.4 high true true (krauth)]
%[(Symbol) 6.4 low true true (krauth)]
%[(Times-Roman) 8.0 0.0 true true ( fecit)]
%] subsupshift MRshow  % regshift subshift supshift subsupshift
%%%%%
%%%%% end common area of all Smac postscript figures.
%%%%%
%graph_paper
/sc {2.5 mul} def            % all important scale factor 
2  cm 5  cm translate
normallinewidth setlinewidth
0 0 1 sc cm 1 sc cm frame stroke
  lightgray setgray
  0.47722682     sc cm  0.17410991     sc cm  0.17385244 sc cm dot
  0.47440097     sc cm  0.52469051     sc cm  0.17385244 sc cm dot
  0.20061237     sc cm  0.78495965     sc cm  0.17385244 sc cm dot
  0.64845455     sc cm  0.82575756     sc cm  0.17385244 sc cm dot
  0.82388484     sc cm  0.52555263     sc cm  0.17385244 sc cm dot
  0.82513267     sc cm  0.17775621     sc cm  0.17385244 sc cm dot
  0.17476635     sc cm  0.34660441     sc cm  0.17385244 sc cm dot
black setgray
  0.47722682     sc cm  0.17410991     sc cm  tinyradius dot
  0.47440097     sc cm  0.52469051     sc cm  tinyradius dot
  0.20061237     sc cm  0.78495965     sc cm  tinyradius dot
  0.64845455     sc cm  0.82575756     sc cm  tinyradius dot
  0.82388484     sc cm  0.52555263     sc cm  tinyradius dot
  0.82513267     sc cm  0.17775621     sc cm  tinyradius dot
  0.17476635     sc cm  0.34660441     sc cm  tinyradius dot

stroke
  0.47440097     sc cm  0.52469051  sc cm  moveto nyoffset
[ [(Times-Italic) 8.0 0.0 true true (i)] ] regshift MCshow
  0.47722682     sc cm  0.17410991  sc cm  moveto pxoffset
[ [(Times-Italic) 8.0 0.0 true true (j)] ] regshift MCshow
  0.17476635     sc cm  0.34660441  sc cm  moveto nyoffset
[ [(Times-Italic) 8.0 0.0 true true (k)] ] regshift MCshow
  0.64845455     sc cm  0.82575756  sc cm  moveto pyoffset
[ [(Times-Italic) 8.0 0.0 true true (l)] ] regshift MCshow
  0.82388484     sc cm  0.52555263  sc cm  moveto pxoffset
[ [(Times-Italic) 8.0 0.0 true true (m)] ] regshift MLshow
  0.82513267     sc cm  0.17775621  sc cm  moveto pxoffset
[ [(Times-Italic) 8.0 0.0 true true (n)] ] regshift MLshow
  0.20061237     sc cm  0.78495965  sc cm  moveto nxoffset
[ [(Times-Italic) 8.0 0.0 true true (o)] ] regshift MRshow


showpage

