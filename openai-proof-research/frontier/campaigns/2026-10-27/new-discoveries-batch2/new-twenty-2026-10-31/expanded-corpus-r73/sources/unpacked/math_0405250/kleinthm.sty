%------------------------------------------------------------%
% number theorem, lemma, definition etc in one sequence by section

% USE NEW AMS STUFF HERE?? DPS

\theoremstyle{plain}

\newtheorem{theorem}{Theorem}[section]
\newtheorem{proposition}[theorem]{Proposition}
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{corollary}[theorem]{Corollary}
\newtheorem{fact}[theorem]{Fact}
\newtheorem{lemma-notation}[theorem]{Lemma and Notation}
\newtheorem{claim}[theorem]{Claim}


\theoremstyle{definition}

\newtheorem{definition}[theorem]{Definition}
\newtheorem{conjecture}[theorem]{Conjecture}
\newtheorem{formula}[theorem]{Formula}
\newtheorem{convention}[theorem]{Convention}
\newtheorem{condition}[theorem]{Condition}
\newtheorem{question}[theorem]{Question}
\newtheorem{judgment}[theorem]{Judgment}
\newtheorem{notation}[theorem]{Notation}
\newtheorem{assumption}[theorem]{Assumption}
\newtheorem{problem}[theorem]{Problem}
\newtheorem{example}[theorem]{Example}
\newtheorem{examples}[theorem]{Examples}
\newtheorem{note}[theorem]{Note}
\newtheorem{notes}[theorem]{Notes}

%\theoremstyle{remark}      %% I don't like the remark style; leave as definition

\newtheorem{remark}[theorem]{Remark}
\newtheorem{remarks}[theorem]{Remarks}
\newtheorem{observation}[theorem]{Observation}
\newtheorem{notation-remark}[theorem]{Notation and Remark}



% The following are for articles in French.  Note use of definitionf for definitions:

\theoremstyle{plain}
%\newtheorem*{thma}{Th\'eor\`eme A}  % Use this to get special names
%\newtheorem*{thmb}{Th\'eor\`eme B}
%\newtheorem*{thmthree}{Th\'eor\`eme 3}
\newtheorem{theoreme}{Th\'eor\`eme}[section]
\newtheorem{lemme}[theoreme]{Lemme}

\theoremstyle{definition}
\newtheorem{definitionf}[theoreme]{D\'efinition}

\theoremstyle{remark}
\newtheorem{remarque}[theoreme]{Remarque}

\newenvironment{demonstration}{\begin{proof}[D\'emonstration]}{\end{proof}}
