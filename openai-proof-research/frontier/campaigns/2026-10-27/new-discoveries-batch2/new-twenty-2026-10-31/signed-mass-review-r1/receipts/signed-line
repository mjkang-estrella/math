<section id="S7" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">7. </span>Point-charge consequences</h2>

<div id="S7.p1" class="ltx_para">
<p id="S7.p1.1" class="ltx_p">Let <math id="S7.p1.m1" class="ltx_Math" alttext="A_{1},\ldots,A_{n}\in\mathbb{R}^{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>A</mi><mi>n</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mn>3</mn></msup></mrow></mrow><annotation encoding="application/x-tex">A_{1},\ldots,A_{n}\in\mathbb{R}^{3}</annotation></semantics></math>, let <math id="S7.p1.m2" class="ltx_Math" alttext="c_{i}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>i</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c_{i}&gt;0</annotation></semantics></math>, and define the positive
inverse-power potential</p>
<table id="S7.E72" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(72)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E72.m1" class="ltx_Math" alttext="V_{p}(x)=\sum_{i=1}^{n}\frac{c_{i}}{|x-A_{i}|^{p}},\qquad p&gt;0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>V</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mfrac><msub><mi>c</mi><mi>i</mi></msub><msup><mrow><mo stretchy="false">|</mo><mrow><mi>x</mi><mo>−</mo><msub><mi>A</mi><mi>i</mi></msub></mrow><mo stretchy="false">|</mo></mrow><mi>p</mi></msup></mfrac></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>p</mi><mo>&gt;</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">V_{p}(x)=\sum_{i=1}^{n}\frac{c_{i}}{|x-A_{i}|^{p}},\qquad p&gt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p1.2" class="ltx_p">Parameterize a prescribed line <math id="S7.p1.m3" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> at unit speed by</p>
<table id="S7.Ex27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex27.m1" class="ltx_Math" alttext="x(t)=x_{0}+te,\qquad|e|=1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>+</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mo stretchy="false">|</mo><mi>e</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">x(t)=x_{0}+te,\qquad|e|=1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p1.3" class="ltx_p">For each source, set</p>
<table id="S7.E73" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(73)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E73.m1" class="ltx_Math" alttext="a_{i}=\langle A_{i}-x_{0},e\rangle,\qquad b_{i}=\operatorname{dist}(A_{i},\Lambda)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>a</mi><mi>i</mi></msub><mo>=</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>A</mi><mi>i</mi></msub><mo>−</mo><msub><mi>x</mi><mn>0</mn></msub></mrow><mo>,</mo><mi>e</mi></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi>b</mi><mi>i</mi></msub><mo>=</mo><mrow><mi>dist</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mi>i</mi></msub><mo>,</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">a_{i}=\langle A_{i}-x_{0},e\rangle,\qquad b_{i}=\operatorname{dist}(A_{i},\Lambda).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p1.4" class="ltx_p">Then</p>
<table id="S7.E74" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(74)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E74.m1" class="ltx_Math" alttext="|x(t)-A_{i}|^{2}=(t-a_{i})^{2}+b_{i}^{2}," display="block" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>A</mi><mi>i</mi></msub></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>a</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>+</mo><msubsup><mi>b</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">|x(t)-A_{i}|^{2}=(t-a_{i})^{2}+b_{i}^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p1.5" class="ltx_p">and direct differentiation gives</p>
<table id="S7.E75" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(75)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E75.m1" class="ltx_math_unparsed" alttext="\frac{d}{dt}V_{p}(x(t))=-pE_{p}(t),\qquad E_{p}(t)=\sum_{i=1}^{n}c_{i}\frac{t-a_{i}}{\bigl((t-a_{i})^{2}+b_{i}^{2}\bigr)^{\beta}},\qquad\boxed{\beta=1+\frac{p}{2}}." display="block" intent=":literal"><semantics><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac><msub><mi>V</mi><mi>p</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mi>p</mi><msub><mi>E</mi><mi>p</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo rspace="2.167em">,</mo><msub><mi>E</mi><mi>p</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">=</mo><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><msub><mi>c</mi><mi>i</mi></msub><mfrac><mrow><mi>t</mi><mo>−</mo><msub><mi>a</mi><mi>i</mi></msub></mrow><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>a</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>+</mo><msubsup><mi>b</mi><mi>i</mi><mn>2</mn></msubsup></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mi>β</mi></msup></mfrac><mo rspace="2.167em">,</mo><menclose notation="box"><mrow><mi>β</mi><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mfrac><mi>p</mi><mn>2</mn></mfrac></mrow></mrow></menclose><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{d}{dt}V_{p}(x(t))=-pE_{p}(t),\qquad E_{p}(t)=\sum_{i=1}^{n}c_{i}\frac{t-a_{i}}{\bigl((t-a_{i})^{2}+b_{i}^{2}\bigr)^{\beta}},\qquad\boxed{\beta=1+\frac{p}{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p1.6" class="ltx_p">Thus <math id="S7.p1.m4" class="ltx_Math" alttext="x(t)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">x(t)</annotation></semantics></math> is a critical point of <math id="S7.p1.m5" class="ltx_Math" alttext="V_{p}|_{\Lambda}" display="inline" intent=":literal"><semantics><msub><mrow><msub><mi>V</mi><mi>p</mi></msub><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">Λ</mi></msub><annotation encoding="application/x-tex">V_{p}|_{\Lambda}</annotation></semantics></math> in its regular domain if and only if <math id="S7.p1.m6" class="ltx_Math" alttext="E_{p}(t)=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>E</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">E_{p}(t)=0</annotation></semantics></math>.</p>
</div>
<div id="S7.Thmtheorem1" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmtheorem1.2" class="ltx_text ltx_font_bold">Theorem 7.1</span></span><span id="S7.Thmtheorem1.3" class="ltx_text ltx_font_bold"> </span>(Positive inverse-power Maxwell-line theorem)<span id="S7.Thmtheorem1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmtheorem1.p1" class="ltx_para">
<p id="S7.Thmtheorem1.p1.1" class="ltx_p"><span id="S7.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S7.Thmtheorem1.p1.m1" class="ltx_Math" alttext="p&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">p&gt;0</annotation></semantics></math>, let <math id="S7.Thmtheorem1.p1.m2" class="ltx_Math" alttext="A_{1},\ldots,A_{n}\in\mathbb{R}^{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>A</mi><mi>n</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mn>3</mn></msup></mrow></mrow><annotation encoding="application/x-tex">A_{1},\ldots,A_{n}\in\mathbb{R}^{3}</annotation></semantics></math>, let <math id="S7.Thmtheorem1.p1.m3" class="ltx_Math" alttext="c_{i}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>i</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c_{i}&gt;0</annotation></semantics></math>, and let
<math id="S7.Thmtheorem1.p1.m4" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> be a straight line. On</span></p>
