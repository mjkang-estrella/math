<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E43.m2" class="ltx_math_unparsed" alttext="\displaystyle+\frac{1}{|B_{r}(y_{l})|}\int_{B_{r}(y_{l})}|u(x)|dx" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mrow><msub><mi>B</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mstyle displaystyle="true"><msub><mo>∫</mo><mrow><msub><mi>B</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub></mstyle><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>d</mi><mi>x</mi></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{1}{|B_{r}(y_{l})|}\int_{B_{r}(y_{l})}|u(x)|dx</annotation></semantics></math></td>
