ow></mrow><mo>≤</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">t^{2}\|w_{\alpha}\|^{2}_{L^{2}}+2t(u_{\alpha},w_{\alpha})_{L^{2}}=t\int_{B_{r}}w_{\alpha}(tw_{\alpha}+2u)\leq t\int_{B_{r}}\|w_{\alpha}(tw_{\alpha}+2u_{\alpha})\|_{L^{\infty}}\leq Cr^{n+1}.</annotation></semantics></math></td>
