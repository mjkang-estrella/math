<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="Sx2.E23.m2" class="ltx_Math" alttext="\displaystyle\leq\int_{A}|R_{A}(P_{k}u)-R_{B}(P_{k}u)||P_{k}u|dx" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>A</mi></msub></mstyle><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><msub><mi>R</mi><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>P</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>R</mi><mi>B</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>P</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>P</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\int_{A}|R_{A}(P_{k}u)-R_{B}(P_{k}u)||P_{k}u|dx</annotation></semantics></math></td>
