<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S1.E2.m1" class="ltx_Math" alttext="\displaystyle\begin{cases}(-\Delta)^{s}u=\lambda_{k}u\ &amp;\hbox{in}~A,\\
u=0&amp;\hbox{in}~{\mathbb{R}}^{n}\setminus A,\end{cases}" display="inline" intent=":literal"><semantics><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi mathvariant="normal">Δ</mi></mrow><mo stretchy="false">)</mo></mrow><mi>s</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo>=</mo><mrow><msub><mi>λ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>in</mtext><mo lspace="0.330em" rspace="0em">​</mo><mi>A</mi></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi>u</mi><mo>=</mo><mn>0</mn></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext>in</mtext><mo lspace="0.330em" rspace="0em">​</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><mo>∖</mo><mi>A</mi></mrow><mo>,</mo></mrow></mtd></mtr></mtable></mrow><annotation encoding="application/x-tex">\displaystyle\begin{cases}(-\Delta)^{s}u=\lambda_{k}u\ &amp;\hbox{in}~A,\\
u=0&amp;\hbox{in}~{\mathbb{R}}^{n}\setminus A,\end{cases}</annotation></semantics></math></td>
