<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex24.m1" class="ltx_Math" alttext="\displaystyle\leq C\left(\frac{r}{4}\right)^{2s}\left(\int_{{\mathbb{R}}^{n}\setminus B_{c_{1}r}(y)}\frac{|u_{k}(x)|}{|x-y|^{n+2s}}dx+\int_{B_{c_{1}r}(y)\setminus B_{r/4}(y)}\frac{|u_{k}(x)|}{|x-y|^{n+2s}}dx\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi>r</mi><mn>4</mn></mfrac></mstyle><mo>)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mrow><msup><mi>ℝ</mi><mi>n</mi></msup><mo>∖</mo><mrow><msub><mi>B</mi><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><mrow><msub><mi>u</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><msup><mrow><mo stretchy="false">|</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">|</mo></mrow><mrow><mi>n</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mrow><mrow><msub><mi>B</mi><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∖</mo><mrow><msub><mi>B</mi><mrow><mi>r</mi><mo>/</mo><mn>4</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><mrow><msub><mi>u</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><msup><mrow><mo stretchy="false">|</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">|</mo></mrow><mrow><mi>n</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq C\left(\frac{r}{4}\right)^{2s}\left(\int_{{\mathbb{R}}^{n}\setminus B_{c_{1}r}(y)}\frac{|u_{k}(x)|}{|x-y|^{n+2s}}dx+\int_{B_{c_{1}r}(y)\setminus B_{r/4}(y)}\frac{|u_{k}(x)|}{|x-y|^{n+2s}}dx\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p11.12" class="ltx_p"><span id="S6.p11.12.1" class="ltx_text">Here <math id="S6.p11.m5" class="ltx_Math" alttext="c_{1}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mn>1</mn></msub><annotation encoding="application/x-tex">c_{1}</annotation></semantics></math> is some constant to be chosen large. The first term in the tail is dominated by</span></p>
<table id="S6.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex25.m1" class="ltx_Math" alttext="Cc_{1}^{-s}r^{s}." display="block" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>c</mi><mn>1</mn><mrow><mo>−</mo><mi>s</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mi>s</mi></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Cc_{1}^{-s}r^{s}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p11.13" class="ltx_p"><span id="S6.p11.13.1" class="ltx_text">For the second term, using the assumption that <math id="S6.p11.m6" class="ltx_Math" alttext="|u(x)|\leq c_{0}r^{s}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><msub><mi>c</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mi>s</mi></msup></mrow></mrow><annotation encoding="application/x-tex">|u(x)|\leq c_{0}r^{s}</annotation></semantics></math> on <math id="S6.p11.m7" class="ltx_Math" alttext="B_{r}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>r</mi></msub><annotation encoding="application/x-tex">B_{r}</annotation></semantics></math> for <math id="S6.p11.m8" class="ltx_Math" alttext="r&lt;c_{1}r_{0}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>&lt;</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">r&lt;c_{1}r_{0}</annotation></semantics></math>, we have</span></p>
<table id="S6.EGx53" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.E52"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(6.52)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.E52.m1" class="ltx_Math" alttext="\displaystyle C\left(\frac{r}{4}\right)^{2s}\int_{B_{c_{1}r}(y)\setminus B_{r/4}(y)}\frac{|u_{k}(x)|}{|x-y|^{n+2s}}dx" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi>r</mi><mn>4</mn></mfrac></mstyle><mo>)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mrow><mrow><msub><mi>B</mi><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∖</mo><mrow><msub><mi>B</mi><mrow><mi>r</mi><mo>/</mo><mn>4</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><mrow><msub><mi>u</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><msup><mrow><mo stretchy="false">|</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">|</mo></mrow><mrow><mi>n</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle C\left(\frac{r}{4}\right)^{2s}\int_{B_{c_{1}r}(y)\setminus B_{r/4}(y)}\frac{|u_{k}(x)|}{|x-y|^{n+2s}}dx</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.E52.m2" class="ltx_Math" alttext="\displaystyle\leq Cc_{0}r^{s}\left(\frac{r}{4}\right)^{2s}\left(\left(\frac{r}{4}\right)^{-2s}-c_{1}^{-2s}r^{-2s}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mi>s</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi>r</mi><mn>4</mn></mfrac></mstyle><mo>)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi>r</mi><mn>4</mn></mfrac></mstyle><mo>)</mo></mrow><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup><mo>−</mo><mrow><msubsup><mi>c</mi><mn>1</mn><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq Cc_{0}r^{s}\left(\frac{r}{4}\right)^{2s}\left(\left(\frac{r}{4}\right)^{-2s}-c_{1}^{-2s}r^{-2s}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex26.m1" class="ltx_Math" alttext="\displaystyle=Cc_{0}r^{s}(1-c_{1}^{-2s}4^{-2s})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mi>s</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msubsup><mi>c</mi><mn>1</mn><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mn>4</mn><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=Cc_{0}r^{s}(1-c_{1}^{-2s}4^{-2s}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S6.p12" class="ltx_para">
<p id="S6.p12.1" class="ltx_p"><span id="S6.p12.1.1" class="ltx_text">Combining all the above, we have</span></p>
<table id="S6.Ex27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex27.m1" class="ltx_Math" alttext="|u_{k}(y)|\leq C(r^{2s}+c_{0}r^{s}+c_{0}^{-1}c_{1}^{-s}+(1-c_{1}^{-2s}4^{-2s}))c_{0}r^{s}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi>u</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>r</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msup><mo>+</mo><mrow><msub><mi>c</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mi>s</mi></msup></mrow><mo>+</mo><mrow><msubsup><mi>c</mi><mn>0</mn><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>c</mi><mn>1</mn><mrow><mo>−</mo><mi>s</mi></mrow></msubsup></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msubsup><mi>c</mi><mn>1</mn><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mn>4</mn><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mi>s</mi></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|u_{k}(y)|\leq C(r^{2s}+c_{0}r^{s}+c_{0}^{-1}c_{1}^{-s}+(1-c_{1}^{-2s}4^{-2s}))c_{0}r^{s}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p12.2" class="ltx_p"><span id="S6.p12.2.1" class="ltx_text">Now we can choose <math id="S6.p12.m1" class="ltx_Math" alttext="c_{0},r,c_{1}=c_{1}(c_{0})" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>0</mn></msub><mo>,</mo><mi>r</mi><mo>,</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo>=</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">c_{0},r,c_{1}=c_{1}(c_{0})</annotation></semantics></math> to make the above <math id="S6.p12.m2" class="ltx_Math" alttext="\leq 1/4c_{0}r^{s}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mi>s</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\leq 1/4c_{0}r^{s}</annotation></semantics></math>, which establishes the initial claim (<a href="#S6.E2" title="In Proof. ‣ 6. Non-degeneracy ‣ Minimizing Eigenvalues of the Fractional Laplacian" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.2</span></a>), with the contradiction assumption that for a fixed <math id="S6.p12.m3" class="ltx_Math" alttext="r_{0}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mn>0</mn></msub><annotation encoding="application/x-tex">r_{0}</annotation></semantics></math>, assume that for any <math id="S6.p12.m4" class="ltx_Math" alttext="c_{0},c_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>0</mn></msub><mo>,</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">c_{0},c_{1}</annotation></semantics></math>, such that for all <math id="S6.p12.m5" class="ltx_Math" alttext="r&lt;c_{1}r_{0}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>&lt;</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">r&lt;c_{1}r_{0}</annotation></semantics></math>, <math id="S6.p12.m6" class="ltx_Math" alttext="\sup_{B_{r}}u\leq c_{0}r^{s}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>sup</mo><msub><mi>B</mi><mi>r</mi></msub></msub><mi>u</mi></mrow><mo>≤</mo><mrow><msub><mi>c</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mi>s</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\sup_{B_{r}}u\leq c_{0}r^{s}</annotation></semantics></math>, and therefore proves the following claim:</span></p>
</div>
<div id="S6.p13" class="ltx_para">
<p id="S6.p13.1" class="ltx_p"><span id="S6.p13.1.1" class="ltx_text">For a fixed <math id="S6.p13.m1" class="ltx_Math" alttext="r_{0}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mn>0</mn></msub><annotation encoding="application/x-tex">r_{0}</annotation></semantics></math>, there exists <math id="S6.p13.m2" class="ltx_Math" alttext="c_{0},c_{1}=c_{1}(c_{0})" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>0</mn></msub><mo>,</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo>=</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">c_{0},c_{1}=c_{1}(c_{0})</annotation></semantics></math> independent of <math id="S6.p13.m3" class="ltx_Math" alttext="r_{0}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mn>0</mn></msub><annotation encoding="application/x-tex">r_{0}</annotation></semantics></math> such that there exists <math id="S6.p13.m4" class="ltx_Math" alttext="r&lt;c_{1}r_{0}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>&lt;</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">r&lt;c_{1}r_{0}</annotation></semantics></math>, <math id="S6.p13.m5" class="ltx_Math" alttext="\sup_{B_{r}}u\geq c_{0}r^{s}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>sup</mo><msub><mi>B</mi><mi>r</mi></msub></msub><mi>u</mi></mrow><mo>≥</mo><mrow><msub><mi>c</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mi>s</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\sup_{B_{r}}u\geq c_{0}r^{s}</annotation></semantics></math>. This is equivalent to the statement of the theorem by scaling.
<br class="ltx_break">∎</span></p>
</div>
</div>
</section>
<section id="S7" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">7. </span>Blow-up Analysis</h2>

<div id="S7.p1" class="ltx_para">
<p id="S7.p1.1" class="ltx_p">Let <math id="S7.p1.m1" class="ltx_Math" alttext="u_{k}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mi>k</mi></msub><annotation encoding="application/x-tex">u_{k}</annotation></semantics></math> be the corresponding eigenfunction to the simple minimizing eigenvalue <math id="S7.p1.m2" class="ltx_Math" alttext="\lambda_{k}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\lambda_{k}</annotation></semantics></math> and let <math id="S7.p1.m3" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> be its extension. We have Weiss-type monotonicity formula.</p>
</div>
<div id="S7.Thmthm1" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm1.2" class="ltx_text ltx_font_bold">Theorem 7.1</span></span><span id="S7.Thmthm1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm1.p1" class="ltx_para">
<p id="S7.Thmthm1.p1.1" class="ltx_p"><span id="S7.Thmthm1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S7.Thmthm1.p1.m1" class="ltx_Math" alttext="B_{r}=B_{r}(x_{0},0)" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>r</mi></msub><mo>=</mo><mrow><msub><mi>B</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">B_{r}=B_{r}(x_{0},0)</annotation></semantics></math>. Then</span></p>
<table id="S7.EGx54" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S7.E2"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(7.2)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.E2.m1" class="ltx_math_unparsed" alttext="\displaystyle W(r,u;x_{0}):=\frac{1}{r^{n}}\left(\int_{B_{r}}|y|^{a}|\nabla u|^{2}+\int_{B_{r^{\prime}}}\chi_{\{u\neq 0\}}\right)-\frac{s}{r^{n-1}}\int_{\partial B_{r}}|y|^{a}u^{2}," display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo>,</mo><mi>u</mi><mo>;</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo>:=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>r</mi><mi>n</mi></msup></mfrac></mstyle><mrow><mo>(</mo><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>B</mi><mi>r</mi></msub></msub></mstyle><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>y</mi><msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>a</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo rspace="0.167em">∇</mo><mi>u</mi><msup><mo fence="false" stretchy="false">|</mo><mn>2</mn></msup><mo lspace="0em">+</mo><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>B</mi><msup><mi>r</mi><mo>′</mo></msup></msub></msub></mstyle><msub><mi>χ</mi><mrow><mo stretchy="false">{</mo><mi>u</mi><mo>≠</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></msub><mo>)</mo></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>s</mi><msup><mi>r</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup></mfrac></mstyle><mstyle displaystyle="true"><msub><mo>∫</mo><mrow><mo>∂</mo><msub><mi>B</mi><mi>r</mi></msub></mrow></msub></mstyle><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>y</mi><msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>a</mi></msup><msup><mi>u</mi><mn>2</mn></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle W(r,u;x_{0}):=\frac{1}{r^{n}}\left(\int_{B_{r}}|y|^{a}|\nabla u|^{2}+\int_{B_{r^{\prime}}}\chi_{\{u\neq 0\}}\right)-\frac{s}{r^{n-1}}\int_{\partial B_{r}}|y|^{a}u^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.Thmthm1.p1.2" class="ltx_p"><span id="S7.Thmthm1.p1.2.1" class="ltx_text ltx_font_italic">is almost monotone, ie. <math id="S7.Thmthm1.p1.m2" class="ltx_Math" alttext="W^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>W</mi><mo>′</mo></msup><annotation encoding="application/x-tex">W^{\prime}</annotation></semantics></math> is a sum of positive terms and integrable terms.</span></p>
</div>
</div>
<div id="S7.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S7.p2" class="ltx_para">
<p id="S7.p2.1" class="ltx_p"><span id="S7.p2.1.1" class="ltx_text">Without loss of generality, assume that <math id="S7.p2.m1" class="ltx_Math" alttext="x_{0}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>0</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">x_{0}=0</annotation></semantics></math>. Let <math id="S7.p2.m2" class="ltx_Math" alttext="\tau_{\epsilon}=x+\epsilon\eta_{p}x" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mi>ϵ</mi></msub><mo>=</mo><mrow><mi>x</mi><mo>+</mo><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau_{\epsilon}=x+\epsilon\eta_{p}x</annotation></semantics></math>, where</span></p>
<table id="S7.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex1.m1" class="ltx_Math" alttext="\eta_{p}(x)=\max(0,\min(1,\frac{r-|x|}{k}))." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>η</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mfrac><mrow><mi>r</mi><mo>−</mo><mrow><mo stretchy="false">|</mo><mi>x</mi><mo stretchy="false">|</mo></mrow></mrow><mi>k</mi></mfrac><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\eta_{p}(x)=\max(0,\min(1,\frac{r-|x|}{k})).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p2.2" class="ltx_p"><span id="S7.p2.2.1" class="ltx_text">Then <math id="S7.p2.m3" class="ltx_Math" alttext="\eta_{p}(x)=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>η</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta_{p}(x)=0</annotation></semantics></math> outside <math id="S7.p2.m4" class="ltx_Math" alttext="B_{r}(0)" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B_{r}(0)</annotation></semantics></math>, and</span></p>
<table id="S7.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex2.m1" class="ltx_Math" alttext="\eta_{p}(x)\rightarrow\chi_{B_{r}(0)}\text{ as }p\rightarrow 0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>η</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msub><mi>χ</mi><mrow><msub><mi>B</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mtext> as </mtext><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\eta_{p}(x)\rightarrow\chi_{B_{r}(0)}\text{ as }p\rightarrow 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p2.3" class="ltx_p"><span id="S7.p2.3.1" class="ltx_text">Let <math id="S7.p2.m5" class="ltx_Math" alttext="\tau_{\epsilon}=x(1+\epsilon\eta_{p}(x))" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mi>ϵ</mi></msub><mo>=</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau_{\epsilon}=x(1+\epsilon\eta_{p}(x))</annotation></semantics></math>, which leaves <math id="S7.p2.m6" class="ltx_Math" alttext="\mathcal{R}^{n}_{k}\times\{0\}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi><mi>n</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{R}^{n}_{k}\times\{0\}</annotation></semantics></math> invariant. We can calculate</span></p>
<table id="S7.EGx55" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S7.E3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(7.3)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.E3.m1" class="ltx_Math" alttext="\displaystyle\nabla\eta_{p}(x)=\frac{-x}{|x|p}\chi_{B_{r}\setminus B_{r-p}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>η</mi><mi>p</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>−</mo><mi>x</mi></mrow><mrow><mrow><mo stretchy="false">|</mo><mi>x</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>χ</mi><mrow><msub><mi>B</mi><mi>r</mi></msub><mo>∖</mo><msub><mi>B</mi><mrow><mi>r</mi><mo>−</mo><mi>p</mi></mrow></msub></mrow></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\nabla\eta_{p}(x)=\frac{-x}{|x|p}\chi_{B_{r}\setminus B_{r-p}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.E4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(7.4)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.E4.m1" class="ltx_math_unparsed" alttext="\displaystyle D\tau_{\epsilon}=I+\epsilon(\eta_{p}(x)I+x\nabla\eta_{p}(x))+o(\epsilon)," display="inline" intent=":literal"><semantics><mrow><mi>D</mi><msub><mi>τ</mi><mi>ϵ</mi></msub><mo>=</mo><mi>I</mi><mo>+</mo><mi>ϵ</mi><mrow><mo stretchy="false">(</mo><msub><mi>η</mi><mi>p</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mi>I</mi><mo>+</mo><mi>x</mi><mo lspace="0.167em" rspace="0.167em">∇</mo><msub><mi>η</mi><mi>p</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mi>o</mi><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle D\tau_{\epsilon}=I+\epsilon(\eta_{p}(x)I+x\nabla\eta_{p}(x))+o(\epsilon),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.E5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(7.5)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.E5.m1" class="ltx_Math" alttext="\displaystyle\det D\tau_{\epsilon}=1+\epsilon\text{trace}D(\eta_{p}(x)(x))+o(\epsilon)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo movablelimits="false" rspace="0.167em">det</mo><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>τ</mi><mi>ϵ</mi></msub></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mtext>trace</mtext><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>η</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\det D\tau_{\epsilon}=1+\epsilon\text{trace}D(\eta_{p}(x)(x))+o(\epsilon),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.E6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(7.6)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.E6.m1" class="ltx_Math" alttext="\displaystyle\text{trace}D(\eta_{p}(x)x)={\rm div}(\eta_{p}(x)(x))," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mtext>trace</mtext><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>η</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>div</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>η</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\text{trace}D(\eta_{p}(x)x)={\rm div}(\eta_{p}(x)(x)),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.E7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(7.7)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.E7.m1" class="ltx_Math" alttext="\displaystyle D\tau^{-1}_{\epsilon}=I-\epsilon D(\eta_{p}(x)x)+o(\epsilon)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>τ</mi><mi>ϵ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo>=</mo><mrow><mrow><mi>I</mi><mo>−</mo><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>η</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle D\tau^{-1}_{\epsilon}=I-\epsilon D(\eta_{p}(x)x)+o(\epsilon),</annotation></semantics></math></td>
