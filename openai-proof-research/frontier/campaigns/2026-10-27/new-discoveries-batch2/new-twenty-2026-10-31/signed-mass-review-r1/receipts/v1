<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E21.m1" class="ltx_Math" alttext="\int_{{\mathbb{R}}^{n}}\int_{{\mathbb{R}}^{n}}\frac{(v_{j}(x)-v_{j}(y))^{2}}{|x-y|^{n+2s}}\leq\int_{{\mathbb{R}}^{n}}\int_{{\mathbb{R}}^{n}}\frac{(u_{j}(x)-u_{j}(y))^{2}}{|x-y|^{n+2s}}+Cc_{0}r^{s}r^{n}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∫</mo><msup><mi>ℝ</mi><mi>n</mi></msup></msub><mrow><msub><mo lspace="0.167em">∫</mo><msup><mi>ℝ</mi><mi>n</mi></msup></msub><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>v</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>v</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msup><mrow><mo stretchy="false">|</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">|</mo></mrow><mrow><mi>n</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup></mfrac></mrow></mrow><mo rspace="0.111em">≤</mo><mrow><mrow><msub><mo rspace="0em">∫</mo><msup><mi>ℝ</mi><mi>n</mi></msup></msub><mrow><msub><mo>∫</mo><msup><mi>ℝ</mi><mi>n</mi></msup></msub><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>u</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>u</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msup><mrow><mo stretchy="false">|</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">|</mo></mrow><mrow><mi>n</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup></mfrac></mrow></mrow><mo>+</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mi>s</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mi>n</mi></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\int_{{\mathbb{R}}^{n}}\int_{{\mathbb{R}}^{n}}\frac{(v_{j}(x)-v_{j}(y))^{2}}{|x-y|^{n+2s}}\leq\int_{{\mathbb{R}}^{n}}\int_{{\mathbb{R}}^{n}}\frac{(u_{j}(x)-u_{j}(y))^{2}}{|x-y|^{n+2s}}+Cc_{0}r^{s}r^{n}.</annotation></semantics></math></td>
