<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.E37.m1" class="ltx_Math" alttext="\displaystyle=B[v_{i},v_{i}]-\sum_{j}B[c_{ij}\tilde{v}_{j},c_{ij}\tilde{v}_{j}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>v</mi><mi>i</mi></msub><mo>,</mo><msub><mi>v</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>j</mi></munder></mstyle><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>c</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>v</mi><mo>~</mo></mover><mi>j</mi></msub></mrow><mo>,</mo><mrow><msub><mi>c</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>v</mi><mo>~</mo></mover><mi>j</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=B[v_{i},v_{i}]-\sum_{j}B[c_{ij}\tilde{v}_{j},c_{ij}\tilde{v}_{j}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.Ex15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex15.m1" class="ltx_Math" alttext="\displaystyle\leq B[v_{i},v_{i}]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>v</mi><mi>i</mi></msub><mo>,</mo><msub><mi>v</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq B[v_{i},v_{i}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S6.p11" class="ltx_para">
<p id="S6.p11.1" class="ltx_p"><span id="S6.p11.1.1" class="ltx_text">Combining the above with (<a href="#S6.E21" title="In Proof. ‣ 6. Non-degeneracy ‣ Minimizing Eigenvalues of the Fractional Laplacian" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.21</span></a>), we have</span></p>
<table id="S6.E38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(6.38)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E38.m1" class="ltx_Math" alttext="\int_{{\mathbb{R}}^{n}}\int_{{\mathbb{R}}^{n}}\frac{(\tilde{v}_{i}(x)-\tilde{v}_{i}(y))^{2}}{|x-y|^{n+2s}}\leq\int_{{\mathbb{R}}^{n}}\int_{{\mathbb{R}}^{n}}\frac{(u_{i}(x)-u_{i}(y))^{2}}{|x-y|^{n+2s}}+Cc_{0}r^{s}r^{n}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∫</mo><msup><mi>ℝ</mi><mi>n</mi></msup></msub><mrow><msub><mo lspace="0.167em">∫</mo><msup><mi>ℝ</mi><mi>n</mi></msup></msub><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mover accent="true"><mi>v</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>v</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msup><mrow><mo stretchy="false">|</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">|</mo></mrow><mrow><mi>n</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup></mfrac></mrow></mrow><mo rspace="0.111em">≤</mo><mrow><mrow><msub><mo rspace="0em">∫</mo><msup><mi>ℝ</mi><mi>n</mi></msup></msub><mrow><msub><mo>∫</mo><msup><mi>ℝ</mi><mi>n</mi></msup></msub><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>u</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>u</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msup><mrow><mo stretchy="false">|</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">|</mo></mrow><mrow><mi>n</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup></mfrac></mrow></mrow><mo>+</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mi>s</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mi>n</mi></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\int_{{\mathbb{R}}^{n}}\int_{{\mathbb{R}}^{n}}\frac{(\tilde{v}_{i}(x)-\tilde{v}_{i}(y))^{2}}{|x-y|^{n+2s}}\leq\int_{{\mathbb{R}}^{n}}\int_{{\mathbb{R}}^{n}}\frac{(u_{i}(x)-u_{i}(y))^{2}}{|x-y|^{n+2s}}+Cc_{0}r^{s}r^{n}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p11.2" class="ltx_p"><span id="S6.p11.2.1" class="ltx_text">We also note that</span></p>
<table id="S6.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex16.m1" class="ltx_Math" alttext="\tilde{v}_{i}=\sum_{j=i}^{k}a_{ij}v_{j}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>v</mi><mo>~</mo></mover><mi>i</mi></msub><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mi>i</mi></mrow><mi>k</mi></munderover><mrow><msub><mi>a</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>j</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tilde{v}_{i}=\sum_{j=i}^{k}a_{ij}v_{j}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p11.3" class="ltx_p"><span id="S6.p11.3.1" class="ltx_text">Since</span></p>
<table id="S6.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex17.m1" class="ltx_Math" alttext="\int|v_{j}|^{2}=\int|(1-(1-\varphi))u_{j}|^{2}\geq\int|u_{j}|^{2}-\int_{B_{9r/10}}(1-\varphi)u_{j}^{2}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0em">∫</mo><msup><mrow><mo stretchy="false">|</mo><msub><mi>v</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow><mo rspace="0.111em">=</mo><mrow><mo rspace="0em">∫</mo><msup><mrow><mo stretchy="false">|</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>φ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mi>j</mi></msub></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow><mo rspace="0.111em">≥</mo><mrow><mrow><mo rspace="0em">∫</mo><msup><mrow><mo stretchy="false">|</mo><msub><mi>u</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow><mo rspace="0.055em">−</mo><mrow><msub><mo rspace="0em">∫</mo><msub><mi>B</mi><mrow><mrow><mn>9</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>/</mo><mn>10</mn></mrow></msub></msub><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>φ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>j</mi><mn>2</mn></msubsup></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\int|v_{j}|^{2}=\int|(1-(1-\varphi))u_{j}|^{2}\geq\int|u_{j}|^{2}-\int_{B_{9r/10}}(1-\varphi)u_{j}^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p11.4" class="ltx_p"><span id="S6.p11.4.1" class="ltx_text">we have</span></p>
<table id="S6.EGx48" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.Ex18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.Ex18.m1" class="ltx_Math" alttext="\displaystyle\int|\tilde{v}_{i}|^{2}=\sum_{j=i}^{k}a^{2}_{ij}\int|v_{j}|^{2}\geq\sum_{j=i}^{k}a^{2}_{ij}\left(\int|u_{j}|^{2}-\int_{B_{9r/10}}(1-\varphi)u_{j}^{2}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mrow><mo rspace="0em">∫</mo><msup><mrow><mo stretchy="false">|</mo><msub><mover accent="true"><mi>v</mi><mo>~</mo></mover><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mstyle><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mi>i</mi></mrow><mi>k</mi></munderover></mstyle><mrow><msubsup><mi>a</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mrow><mo rspace="0em">∫</mo><msup><mrow><mo stretchy="false">|</mo><msub><mi>v</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mstyle></mrow></mrow><mo>≥</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mi>i</mi></mrow><mi>k</mi></munderover></mstyle><mrow><msubsup><mi>a</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mrow><mo rspace="0em">∫</mo><msup><mrow><mo stretchy="false">|</mo><msub><mi>u</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mstyle><mo>−</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>B</mi><mrow><mrow><mn>9</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>/</mo><mn>10</mn></mrow></msub></msub></mstyle><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>φ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>j</mi><mn>2</mn></msubsup></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\int|\tilde{v}_{i}|^{2}=\sum_{j=i}^{k}a^{2}_{ij}\int|v_{j}|^{2}\geq\sum_{j=i}^{k}a^{2}_{ij}\left(\int|u_{j}|^{2}-\int_{B_{9r/10}}(1-\varphi)u_{j}^{2}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p11.5" class="ltx_p"><span id="S6.p11.5.1" class="ltx_text">and thus</span></p>
<table id="S6.EGx49" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S6.E39"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(6.39)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.E39.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{\int|\tilde{v}_{i}|^{2}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo rspace="0em">∫</mo><msup><mrow><mo stretchy="false">|</mo><msub><mover accent="true"><mi>v</mi><mo>~</mo></mover><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{1}{\int|\tilde{v}_{i}|^{2}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.E39.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{1}{\sum_{j=i}^{k}a^{2}_{ij}\left(\int|u_{j}|^{2}-\int_{B_{9r/10}}(\varphi-1)u_{j}^{2}\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mi>i</mi></mrow><mi>k</mi></msubsup><mrow><msubsup><mi>a</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo lspace="0em" rspace="0em">∫</mo><msup><mrow><mo stretchy="false">|</mo><msub><mi>u</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow><mo rspace="0.055em">−</mo><mrow><msub><mo rspace="0em">∫</mo><msub><mi>B</mi><mrow><mrow><mn>9</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>/</mo><mn>10</mn></mrow></msub></msub><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>φ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>j</mi><mn>2</mn></msubsup></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{1}{\sum_{j=i}^{k}a^{2}_{ij}\left(\int|u_{j}|^{2}-\int_{B_{9r/10}}(\varphi-1)u_{j}^{2}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.E40"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(6.40)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.E40.m1" class="ltx_Math" alttext="\displaystyle=\sum_{j=i}^{k}a^{-2}_{ij}\left(1+\sum_{l=1}^{\infty}(\int_{B_{9r/10}}(\varphi-1)u_{j}^{2})^{l}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mi>i</mi></mrow><mi>k</mi></munderover></mstyle><mrow><msubsup><mi>a</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><msup><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>B</mi><mrow><mrow><mn>9</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>/</mo><mn>10</mn></mrow></msub></msub></mstyle><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>φ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>u</mi><mi>j</mi><mn>2</mn></msubsup></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>l</mi></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{j=i}^{k}a^{-2}_{ij}\left(1+\sum_{l=1}^{\infty}(\int_{B_{9r/10}}(\varphi-1)u_{j}^{2})^{l}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.E41"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(6.41)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.E41.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{j=i}^{k}a^{-2}_{ij}\left(1+\sup_{B_{r}}|u_{j}|^{2}\sum_{l=1}^{\infty}\left(\int_{B_{9r/10}}(\varphi-1)\right)^{l}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mi>i</mi></mrow><mi>k</mi></munderover></mstyle><mrow><msubsup><mi>a</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><msub><mi>B</mi><mi>r</mi></msub></munder><mrow><msup><mrow><mo stretchy="false">|</mo><msub><mi>u</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover></mstyle><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>B</mi><mrow><mrow><mn>9</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>/</mo><mn>10</mn></mrow></msub></msub></mstyle><mrow><mo stretchy="false">(</mo><mrow><mi>φ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mi>l</mi></msup></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{j=i}^{k}a^{-2}_{ij}\left(1+\sup_{B_{r}}|u_{j}|^{2}\sum_{l=1}^{\infty}\left(\int_{B_{9r/10}}(\varphi-1)\right)^{l}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S6.E42"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(6.42)</span></td>
