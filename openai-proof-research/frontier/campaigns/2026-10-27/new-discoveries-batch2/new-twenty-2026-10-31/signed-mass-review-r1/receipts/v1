<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E40.m1" class="ltx_math_unparsed" alttext="\displaystyle=C\left(\frac{r}{4}\right)^{2s}\left(\int_{r/4}^{R}\frac{Mt^{s}}{t^{n+2s}}\int_{\partial B_{t}(x_{0})}1_{\{B_{R}(x_{0})\cap\{u(x)&gt;0\}\}}dS_{x}dt\right)." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>C</mi><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi>r</mi><mn>4</mn></mfrac></mstyle><mo>)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msup><mrow><mo>(</mo><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><mi>r</mi><mo>/</mo><mn>4</mn></mrow><mi>R</mi></msubsup></mstyle><mstyle displaystyle="true"><mfrac><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mi>s</mi></msup></mrow><msup><mi>t</mi><mrow><mi>n</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup></mfrac></mstyle><mstyle displaystyle="true"><msub><mo>∫</mo><mrow><mo>∂</mo><mrow><msub><mi>B</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></msub></mstyle><msub><mn>1</mn><mrow><mo stretchy="false">{</mo><mi>B</mi><msub><mrow></mrow><mi>R</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo>∩</mo><mo stretchy="false">{</mo><mi>u</mi><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>&gt;</mo><mn>0</mn><mo stretchy="false">}</mo><mo stretchy="false">}</mo></mrow></msub><mi>d</mi><msub><mi>S</mi><mi>x</mi></msub><mi>d</mi><mi>t</mi><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=C\left(\frac{r}{4}\right)^{2s}\left(\int_{r/4}^{R}\frac{Mt^{s}}{t^{n+2s}}\int_{\partial B_{t}(x_{0})}1_{\{B_{R}(x_{0})\cap\{u(x)&gt;0\}\}}dS_{x}dt\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p9.8" class="ltx_p"><span id="S3.p9.8.1" class="ltx_text">We integrate by part in <math id="S3.p9.m10" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>. The boundary term is given by</span></p>
<table id="S3.EGx24" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex16.m1" class="ltx_math_unparsed" alttext="\displaystyle\epsilon t^{-n-s}\int_{B_{t}}1_{\{u&gt;0\}}dV_{x}|^{R}_{r/4}\leq C\epsilon t^{-n-s}Mt^{n+s}|^{R}_{r/4}\leq C\epsilon^{2}." display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mi>t</mi><msup><mrow></mrow><mrow><mrow><mo>−</mo><mi>n</mi></mrow><mo>−</mo><mi>s</mi></mrow></msup><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><msub><mi>B</mi><mi>t</mi></msub></msub><mn>1</mn><msub><mrow></mrow><mrow><mo stretchy="false">{</mo><mi>u</mi><mo>&gt;</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></msub><mi>d</mi><mi>V</mi><msub><mrow></mrow><mi>x</mi></msub><mo fence="false" stretchy="false">|</mo><msup><mrow></mrow><mi>R</mi></msup><msub><mrow></mrow><mrow><mi>r</mi><mo>/</mo><mn>4</mn></mrow></msub><mo lspace="0.167em">≤</mo><mi>C</mi><mi>ϵ</mi><mi>t</mi><msup><mrow></mrow><mrow><mrow><mo>−</mo><mi>n</mi></mrow><mo>−</mo><mi>s</mi></mrow></msup><mi>M</mi><mi>t</mi><msup><mrow></mrow><mrow><mi>n</mi><mo>+</mo><mi>s</mi></mrow></msup><mo fence="false" stretchy="false">|</mo><msup><mrow></mrow><mi>R</mi></msup><msub><mrow></mrow><mrow><mi>r</mi><mo>/</mo><mn>4</mn></mrow></msub><mo lspace="0.167em">≤</mo><mi>C</mi><mi>ϵ</mi><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\epsilon t^{-n-s}\int_{B_{t}}1_{\{u&gt;0\}}dV_{x}|^{R}_{r/4}\leq C\epsilon t^{-n-s}Mt^{n+s}|^{R}_{r/4}\leq C\epsilon^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p9.9" class="ltx_p"><span id="S3.p9.9.1" class="ltx_text">The other term is</span></p>
<table id="S3.EGx25" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E41"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(3.41)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E41.m1" class="ltx_math_unparsed" alttext="\displaystyle-\int_{r/4}^{R}\epsilon(-n-s)t^{-n-s-1}\int_{B_{t}(x_{0})}1_{\{B_{R}(x_{0})\cap\{u(x)&gt;0\}\}}dV_{x}dt" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><mi>r</mi><mo>/</mo><mn>4</mn></mrow><mi>R</mi></msubsup></mstyle><mi>ϵ</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>n</mi><mo>−</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><msup><mi>t</mi><mrow><mrow><mo>−</mo><mi>n</mi></mrow><mo>−</mo><mi>s</mi><mo>−</mo><mn>1</mn></mrow></msup><mstyle displaystyle="true"><msub><mo>∫</mo><mrow><msub><mi>B</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></msub></mstyle><msub><mn>1</mn><mrow><mo stretchy="false">{</mo><mi>B</mi><msub><mrow></mrow><mi>R</mi></msub><mo stretchy="false">(</mo><mi>x</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo>∩</mo><mo stretchy="false">{</mo><mi>u</mi><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>&gt;</mo><mn>0</mn><mo stretchy="false">}</mo><mo stretchy="false">}</mo></mrow></msub><mi>d</mi><msub><mi>V</mi><mi>x</mi></msub><mi>d</mi><mi>t</mi></mrow><annotation encoding="application/x-tex">\displaystyle-\int_{r/4}^{R}\epsilon(-n-s)t^{-n-s-1}\int_{B_{t}(x_{0})}1_{\{B_{R}(x_{0})\cap\{u(x)&gt;0\}\}}dV_{x}dt</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E41.m2" class="ltx_Math" alttext="\displaystyle\leq C\int_{r/4}^{R}\epsilon(n+s)t^{-n-s-1}\epsilon t^{n}t^{s}dt" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><mi>r</mi><mo>/</mo><mn>4</mn></mrow><mi>R</mi></msubsup></mstyle><mrow><mrow><mi>ϵ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mrow><mrow><mo>−</mo><mi>n</mi></mrow><mo>−</mo><mi>s</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mi>s</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq C\int_{r/4}^{R}\epsilon(n+s)t^{-n-s-1}\epsilon t^{n}t^{s}dt</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex17.m1" class="ltx_Math" alttext="\displaystyle=C\epsilon^{2}(\log R-\log(r/4))." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>R</mi></mrow><mo>−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>/</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=C\epsilon^{2}(\log R-\log(r/4)).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p9.10" class="ltx_p"><span id="S3.p9.10.1" class="ltx_text">Combining the above gives:</span></p>
<table id="S3.EGx26" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex18.m1" class="ltx_Math" alttext="\displaystyle\eqref{tail}\leq C\left(\frac{r}{4}\right)^{2s}\epsilon^{2}(1+\log R-\log(r/4))." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mtext>(</mtext><mtext><a href="#S3.E38" title="In Proof. ‣ 3. Boundedness of Shape Minimizers ‣ Minimizing Eigenvalues of the Fractional Laplacian" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.38</span></a></mtext><mtext>)</mtext></mrow><mo>≤</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi>r</mi><mn>4</mn></mfrac></mstyle><mo>)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>+</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>R</mi></mrow></mrow><mo>−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>/</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\eqref{tail}\leq C\left(\frac{r}{4}\right)^{2s}\epsilon^{2}(1+\log R-\log(r/4)).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p9.11" class="ltx_p"><span id="S3.p9.11.1" class="ltx_text">Therefore, taking <math id="S3.p9.m11" class="ltx_Math" alttext="\epsilon_{0}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\epsilon_{0}</annotation></semantics></math> and <math id="S3.p9.m12" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> small establishes the claim.
Now we iterate to get:</span></p>
<table id="S3.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex19.m1" class="ltx_Math" alttext="\sup_{B_{\frac{r}{2^{-k}}}(x_{0})}u\leq C2^{1-k-ks}r^{s}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><msub><mi>B</mi><mfrac><mi>r</mi><msup><mn>2</mn><mrow><mo>−</mo><mi>k</mi></mrow></msup></mfrac></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></munder><mi>u</mi></mrow><mo>≤</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mrow><mn>1</mn><mo>−</mo><mi>k</mi><mo>−</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mi>s</mi></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sup_{B_{\frac{r}{2^{-k}}}(x_{0})}u\leq C2^{1-k-ks}r^{s}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p9.12" class="ltx_p"><span id="S3.p9.12.1" class="ltx_text">This gives <math id="S3.p9.m13" class="ltx_Math" alttext="u(x_{0})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">u(x_{0})=0</annotation></semantics></math>, which concludes the proof.
∎</span></p>
</div>
</div>
<div id="S3.Thmthm42" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm42.2" class="ltx_text ltx_font_bold">Theorem 3.42</span></span><span id="S3.Thmthm42.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm42.p1" class="ltx_para">
<p id="S3.Thmthm42.p1.1" class="ltx_p"><span id="S3.Thmthm42.p1.1.1" class="ltx_text ltx_font_italic">Assume <math id="S3.Thmthm42.p1.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> is <math id="S3.Thmthm42.p1.m2" class="ltx_Math" alttext="\lambda_{k}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\lambda_{k}</annotation></semantics></math>-minimizer of (<a href="#S1.E1" title="In 1. Introduction ‣ Minimizing Eigenvalues of the Fractional Laplacian" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.1</span></a>), then <math id="S3.Thmthm42.p1.m3" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> is bounded in <math id="S3.Thmthm42.p1.m4" class="ltx_Math" alttext="\mathcal{R}_{k}^{n}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi><mi>n</mi></msubsup><annotation encoding="application/x-tex">\mathcal{R}_{k}^{n}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.p10" class="ltx_para">
<p id="S3.p10.1" class="ltx_p"><span id="S3.p10.1.1" class="ltx_text">By Theorem <a href="#S3.Thmthm19" title="Theorem 3.19. ‣ 3. Boundedness of Shape Minimizers ‣ Minimizing Eigenvalues of the Fractional Laplacian" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.19</span></a>, <math id="S3.p10.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> is a local shape subsolution for the torsion energy problem. Let <math id="S3.p10.m2" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> minimizes the corresponding torsion energy <math id="S3.p10.m3" class="ltx_Math" alttext="E(A)" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">E(A)</annotation></semantics></math>. Suppose <math id="S3.p10.m4" class="ltx_Math" alttext="A_{i}=A|_{{\mathbb{R}}^{n}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mi>i</mi></msub><mo>=</mo><msub><mrow><mi>A</mi><mo stretchy="false">|</mo></mrow><msup><mi>ℝ</mi><mi>n</mi></msup></msub></mrow><annotation encoding="application/x-tex">A_{i}=A|_{{\mathbb{R}}^{n}}</annotation></semantics></math> is not bounded, then there exists a sequence <math id="S3.p10.m5" class="ltx_Math" alttext="x_{l}\in A_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>l</mi></msub><mo>∈</mo><msub><mi>A</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">x_{l}\in A_{i}</annotation></semantics></math> and <math id="S3.p10.m6" class="ltx_Math" alttext="|x_{l}|\rightarrow\infty" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi>x</mi><mi>l</mi></msub><mo stretchy="false">|</mo></mrow><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">|x_{l}|\rightarrow\infty</annotation></semantics></math>, and the distance between any two of them is <math id="S3.p10.m7" class="ltx_Math" alttext="\geq 2R" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mrow><annotation encoding="application/x-tex">\geq 2R</annotation></semantics></math> for <math id="S3.p10.m8" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> to be chosen. We can also assume that <math id="S3.p10.m9" class="ltx_Math" alttext="u(x_{l})\neq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">u(x_{l})\neq 0</annotation></semantics></math> in the measure theoretic sense. By previous lemma, we know that the exists <math id="S3.p10.m10" class="ltx_Math" alttext="r_{0}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mn>0</mn></msub><annotation encoding="application/x-tex">r_{0}</annotation></semantics></math> such that</span></p>
<table id="S3.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex20.m1" class="ltx_Math" alttext="\sup_{B_{r_{0}}(x_{l})}u\geq C_{0}r_{0}^{s}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><msub><mi>B</mi><msub><mi>r</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow></munder><mi>u</mi></mrow><mo>≥</mo><mrow><msub><mi>C</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mn>0</mn><mi>s</mi></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sup_{B_{r_{0}}(x_{l})}u\geq C_{0}r_{0}^{s}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p10.2" class="ltx_p"><span id="S3.p10.2.1" class="ltx_text">So there exists <math id="S3.p10.m11" class="ltx_Math" alttext="y_{l}\in B_{r_{0}}(x_{l})" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mi>l</mi></msub><mo>∈</mo><mrow><msub><mi>B</mi><msub><mi>r</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">y_{l}\in B_{r_{0}}(x_{l})</annotation></semantics></math> such that <math id="S3.p10.m12" class="ltx_Math" alttext="u(y_{l})\geq C_{0}r_{0}^{s}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><msub><mi>C</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mn>0</mn><mi>s</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">u(y_{l})\geq C_{0}r_{0}^{s}</annotation></semantics></math>. For any <math id="S3.p10.m13" class="ltx_Math" alttext="r&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">r&gt;0</annotation></semantics></math>, let <math id="S3.p10.m14" class="ltx_Math" alttext="\{\psi_{l}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>ψ</mi><mi>l</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\psi_{l}\}</annotation></semantics></math> be a partition of unity in <math id="S3.p10.m15" class="ltx_Math" alttext="{\mathbb{R}}^{n}" display="inline" intent=":literal"><semantics><msup><mi>ℝ</mi><mi>n</mi></msup><annotation encoding="application/x-tex">{\mathbb{R}}^{n}</annotation></semantics></math> with supports in the balls <math id="S3.p10.m16" class="ltx_Math" alttext="B_{r}(y_{l})" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B_{r}(y_{l})</annotation></semantics></math>.
Using
(<a href="#S3.E34" title="In Proof. ‣ 3. Boundedness of Shape Minimizers ‣ Minimizing Eigenvalues of the Fractional Laplacian" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.34</span></a>), we have</span></p>
