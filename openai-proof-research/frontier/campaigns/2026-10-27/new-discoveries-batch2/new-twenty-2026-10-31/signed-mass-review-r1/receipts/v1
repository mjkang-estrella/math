ow></msup></mfrac></mrow></mrow><mo>−</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mi>s</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mi>n</mi></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\int_{{\mathbb{R}}^{n}}\int_{{\mathbb{R}}^{n}}\frac{(v_{j}(x)-v_{j}(y))^{2}}{|x-y|^{n+2s}}\geq\int_{{\mathbb{R}}^{n}}\int_{{\mathbb{R}}^{n}}\frac{(u_{j}(x)-u_{j}(y))^{2}}{|x-y|^{n+2s}}-Cc_{0}r^{s}r^{n}.</annotation></semantics></math></td>
