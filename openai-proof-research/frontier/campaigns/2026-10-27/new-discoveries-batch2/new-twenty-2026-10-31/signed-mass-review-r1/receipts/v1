<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.E21.m1" class="ltx_Math" alttext="\displaystyle\int_{D}|y|^{a}|\nabla u|^{2}\int_{\mathcal{R}_{k}^{n}}|u^{\prime}|^{2}(n-1)\eta_{p}^{\prime}\rightarrow\int_{D}|y|^{a}|\nabla u|^{2}\int_{B_{r}}|u^{\prime}|^{2}(n-1)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>D</mi></msub></mstyle><mrow><msup><mrow><mo stretchy="false">|</mo><mi>y</mi><mo stretchy="false">|</mo></mrow><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><mrow><mo rspace="0.167em">∇</mo><mi>u</mi></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi><mi>n</mi></msubsup></msub></mstyle><mrow><msup><mrow><mo stretchy="false">|</mo><msup><mi>u</mi><mo>′</mo></msup><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>η</mi><mi>p</mi><mo>′</mo></msubsup></mrow></mrow></mrow></mrow><mo stretchy="false">→</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>D</mi></msub></mstyle><msup><mrow><mo stretchy="false">|</mo><mi>y</mi><mo stretchy="false">|</mo></mrow><mi>a</mi></msup></mrow></mrow><mo fence="false">|</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>u</mi></mrow><mo fence="false">|</mo><mrow><mrow><mstyle displaystyle="true"><mmultiscripts><mo>∫</mo><msub><mi>B</mi><mi>r</mi></msub><mrow></mrow><mprescripts></mprescripts><mrow></mrow><mn>2</mn></mmultiscripts></mstyle><mo>⁡</mo><msup><mrow><mo stretchy="false">|</mo><msup><mi>u</mi><mo>′</mo></msup><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{D}|y|^{a}|\nabla u|^{2}\int_{\mathcal{R}_{k}^{n}}|u^{\prime}|^{2}(n-1)\eta_{p}^{\prime}\rightarrow\int_{D}|y|^{a}|\nabla u|^{2}\int_{B_{r}}|u^{\prime}|^{2}(n-1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.E22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(7.22)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.E22.m1" class="ltx_Math" alttext="\displaystyle\quad\leq\int_{D}|y|^{a}|\nabla u|^{2}\int_{B_{r}}r^{2s}(n-1)=Cr^{n+2s}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="1.278em">≤</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi>D</mi></msub></mstyle><mrow><msup><mrow><mo stretchy="false">|</mo><mi>y</mi><mo stretchy="false">|</mo></mrow><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><mrow><mo rspace="0.167em">∇</mo><mi>u</mi></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>B</mi><mi>r</mi></msub></msub></mstyle><mrow><msup><mi>r</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>=</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mrow><mi>n</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\leq\int_{D}|y|^{a}|\nabla u|^{2}\int_{B_{r}}r^{2s}(n-1)=Cr^{n+2s}</annotation></semantics></math></td>
