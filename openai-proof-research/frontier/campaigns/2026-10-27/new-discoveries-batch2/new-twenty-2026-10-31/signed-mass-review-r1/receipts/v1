<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.E22.m2" class="ltx_Math" alttext="\displaystyle\int_{{\mathbb{R}}^{n}}\int_{{\mathbb{R}}^{n}}\frac{(u_{j}(x)-u_{j}(y))^{2}}{|x-y|^{n+2s}}+\frac{((u_{j}-v_{j})(x)+(u_{j}-v_{j})(y))^{2}}{|x-y|^{n+2s}}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msup><mi>ℝ</mi><mi>n</mi></msup></msub></mstyle><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msup><mi>ℝ</mi><mi>n</mi></msup></msub></mstyle><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>u</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>u</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msup><mrow><mo stretchy="false">|</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">|</mo></mrow><mrow><mi>n</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup></mfrac></mstyle></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>u</mi><mi>j</mi></msub><mo>−</mo><msub><mi>v</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>u</mi><mi>j</mi></msub><mo>−</mo><msub><mi>v</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msup><mrow><mo stretchy="false">|</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">|</mo></mrow><mrow><mi>n</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\int_{{\mathbb{R}}^{n}}\int_{{\mathbb{R}}^{n}}\frac{(u_{j}(x)-u_{j}(y))^{2}}{|x-y|^{n+2s}}+\frac{((u_{j}-v_{j})(x)+(u_{j}-v_{j})(y))^{2}}{|x-y|^{n+2s}}</annotation></semantics></math></td>
