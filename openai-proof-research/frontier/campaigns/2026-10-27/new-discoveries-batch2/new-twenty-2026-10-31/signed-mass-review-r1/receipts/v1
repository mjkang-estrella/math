<div id="S8.Thmthm12.p1" class="ltx_para">
<p id="S8.Thmthm12.p1.1" class="ltx_p"><span id="S8.Thmthm12.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S8.Thmthm12.p1.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> be a <math id="S8.Thmthm12.p1.m2" class="ltx_Math" alttext="\lambda_{k}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\lambda_{k}</annotation></semantics></math>-minimizer, then <math id="S8.Thmthm12.p1.m3" class="ltx_Math" alttext="|\partial A|=0" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mo lspace="0em">∂</mo><mi>A</mi></mrow><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">|\partial A|=0</annotation></semantics></math>.</span></p>
