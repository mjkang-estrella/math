</table>
<p id="S2.p5.6" class="ltx_p"><span id="S2.p5.6.1" class="ltx_text">For the <math id="S2.p5.m10" class="ltx_Math" alttext="|x-y|&gt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">|</mo></mrow><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">|x-y|&gt;1</annotation></semantics></math> piece, we use <math id="S2.p5.m11" class="ltx_Math" alttext="|\eta|&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>η</mi><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">|\eta|&lt;1</annotation></semantics></math>,</span></p>
