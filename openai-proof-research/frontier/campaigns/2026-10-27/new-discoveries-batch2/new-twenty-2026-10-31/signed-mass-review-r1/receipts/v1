<tbody id="S7.Ex9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex9.m1" class="ltx_Math" alttext="\displaystyle\int_{B_{r}^{\prime}\setminus B_{r-k}^{\prime}}|u^{\prime}|^{2}\frac{|x^{\prime}|}{k}\leq\frac{1}{k}\int_{B_{r}^{\prime}\setminus B_{r-k}^{\prime}}|x^{\prime}|dx^{\prime}=\frac{C}{k}(r^{n+2}-(r-k)^{n+2})\rightarrow Cr^{n+1}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mrow><msubsup><mi>B</mi><mi>r</mi><mo>′</mo></msubsup><mo>∖</mo><msubsup><mi>B</mi><mrow><mi>r</mi><mo>−</mo><mi>k</mi></mrow><mo>′</mo></msubsup></mrow></msub></mstyle><mrow><msup><mrow><mo stretchy="false">|</mo><msup><mi>u</mi><mo>′</mo></msup><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">|</mo></mrow><mi>k</mi></mfrac></mstyle></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>k</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mrow><msubsup><mi>B</mi><mi>r</mi><mo>′</mo></msubsup><mo>∖</mo><msubsup><mi>B</mi><mrow><mi>r</mi><mo>−</mo><mi>k</mi></mrow><mo>′</mo></msubsup></mrow></msub></mstyle><mrow><mrow><mo stretchy="false">|</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mo>′</mo></msup></mrow></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mi>C</mi><mi>k</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>r</mi><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow></msup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\int_{B_{r}^{\prime}\setminus B_{r-k}^{\prime}}|u^{\prime}|^{2}\frac{|x^{\prime}|}{k}\leq\frac{1}{k}\int_{B_{r}^{\prime}\setminus B_{r-k}^{\prime}}|x^{\prime}|dx^{\prime}=\frac{C}{k}(r^{n+2}-(r-k)^{n+2})\rightarrow Cr^{n+1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p2.13" class="ltx_p"><span id="S7.p2.13.1" class="ltx_text">So, as <math id="S7.p2.m17" class="ltx_Math" alttext="k\rightarrow 0" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">k\rightarrow 0</annotation></semantics></math>, (<a href="#S7.E18" title="In Proof. ‣ 7. Blow-up Analysis ‣ Minimizing Eigenvalues of the Fractional Laplacian" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.18</span></a>) gives:</span></p>
<table id="S7.EGx63" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S7.E23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(7.23)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.E23.m1" class="ltx_Math" alttext="\displaystyle(n-2+a)\int_{B_{r}}|y|^{a}|\nabla u|^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><mo>+</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>B</mi><mi>r</mi></msub></msub></mstyle><mrow><msup><mrow><mo stretchy="false">|</mo><mi>y</mi><mo stretchy="false">|</mo></mrow><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><mrow><mo rspace="0.167em">∇</mo><mi>u</mi></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle(n-2+a)\int_{B_{r}}|y|^{a}|\nabla u|^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.E23.m2" class="ltx_math_unparsed" alttext="\displaystyle-r\int_{\partial B_{r}}|y|^{a}(|\nabla u|^{2}-2u_{\nu}^{2})+(n-1)\int_{B_{r}^{\prime}}\chi_{\{u\neq 0\}}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi>r</mi><mstyle displaystyle="true"><msub><mo>∫</mo><mrow><mo>∂</mo><msub><mi>B</mi><mi>r</mi></msub></mrow></msub></mstyle><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>y</mi><msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>a</mi></msup><mrow><mo stretchy="false">(</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo rspace="0.167em">∇</mo><mi>u</mi><msup><mo fence="false" stretchy="false">|</mo><mn>2</mn></msup><mo lspace="0em">−</mo><mn>2</mn><msubsup><mi>u</mi><mi>ν</mi><mn>2</mn></msubsup><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msubsup><mi>B</mi><mi>r</mi><mo>′</mo></msubsup></msub></mstyle><msub><mi>χ</mi><mrow><mo stretchy="false">{</mo><mi>u</mi><mo>≠</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle-r\int_{\partial B_{r}}|y|^{a}(|\nabla u|^{2}-2u_{\nu}^{2})+(n-1)\int_{B_{r}^{\prime}}\chi_{\{u\neq 0\}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex10.m1" class="ltx_math_unparsed" alttext="\displaystyle-r\int_{\partial B_{r}^{\prime}}\chi_{\{u\neq 0\}}+Cr^{n+2s}+Cr^{n+1}=0." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi>r</mi><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mrow><mo>∂</mo><msubsup><mi>B</mi><mi>r</mi><mo>′</mo></msubsup></mrow></msub><mi>χ</mi><msub><mrow></mrow><mrow><mo stretchy="false">{</mo><mi>u</mi><mo>≠</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></msub><mo>+</mo><mi>C</mi><mi>r</mi><msup><mrow></mrow><mrow><mi>n</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup><mo>+</mo><mi>C</mi><mi>r</mi><msup><mrow></mrow><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>=</mo><mn>0</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-r\int_{\partial B_{r}^{\prime}}\chi_{\{u\neq 0\}}+Cr^{n+2s}+Cr^{n+1}=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p2.14" class="ltx_p"><span id="S7.p2.14.1" class="ltx_text">From proposition <a href="#S5.Thmthm22" title="Proposition 5.22. ‣ 5. Optimal Regularity ‣ Minimizing Eigenvalues of the Fractional Laplacian" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.22</span></a>, we have</span></p>
<table id="S7.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex11.m1" class="ltx_Math" alttext="\int_{B_{r}}|y|^{a}|\nabla u|^{2}=\int_{\partial B_{r}}|y|^{a}uu_{\nu}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∫</mo><msub><mi>B</mi><mi>r</mi></msub></msub><mrow><msup><mrow><mo lspace="0em" stretchy="false">|</mo><mi>y</mi><mo stretchy="false">|</mo></mrow><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><mrow><mo rspace="0.167em">∇</mo><mi>u</mi></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo rspace="0em">∫</mo><mrow><mo>∂</mo><msub><mi>B</mi><mi>r</mi></msub></mrow></msub><mrow><msup><mrow><mo stretchy="false">|</mo><mi>y</mi><mo stretchy="false">|</mo></mrow><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mi>ν</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\int_{B_{r}}|y|^{a}|\nabla u|^{2}=\int_{\partial B_{r}}|y|^{a}uu_{\nu}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p2.15" class="ltx_p"><span id="S7.p2.15.1" class="ltx_text">Using the above, and divide both sides by <math id="S7.p2.m18" class="ltx_Math" alttext="-r^{n+1}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><msup><mi>r</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">-r^{n+1}</annotation></semantics></math> yields for almost every <math id="S7.p2.m19" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>,</span></p>
<table id="S7.EGx64" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S7.E24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(7.24)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.E24.m1" class="ltx_Math" alttext="\displaystyle\left[\frac{1}{r^{n}}\int_{B_{r}}|y|^{a}|\nabla u|^{2}\right]^{\prime}" display="inline" intent=":literal"><semantics><msup><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>r</mi><mi>n</mi></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>B</mi><mi>r</mi></msub></msub></mstyle><mrow><msup><mrow><mo stretchy="false">|</mo><mi>y</mi><mo stretchy="false">|</mo></mrow><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><mrow><mo rspace="0.167em">∇</mo><mi>u</mi></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>]</mo></mrow><mo>′</mo></msup><annotation encoding="application/x-tex">\displaystyle\left[\frac{1}{r^{n}}\int_{B_{r}}|y|^{a}|\nabla u|^{2}\right]^{\prime}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.E24.m2" class="ltx_math_unparsed" alttext="\displaystyle+\left[\frac{1}{r^{n}}\int_{B_{r}^{\prime}}\chi_{\{u\neq 0\}}\right]^{\prime}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msup><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>r</mi><mi>n</mi></msup></mfrac></mstyle><mstyle displaystyle="true"><msub><mo>∫</mo><msubsup><mi>B</mi><mi>r</mi><mo>′</mo></msubsup></msub></mstyle><msub><mi>χ</mi><mrow><mo stretchy="false">{</mo><mi>u</mi><mo>≠</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></msub><mo>]</mo></mrow><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle+\left[\frac{1}{r^{n}}\int_{B_{r}^{\prime}}\chi_{\{u\neq 0\}}\right]^{\prime}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.E25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(7.25)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.E25.m1" class="ltx_math_unparsed" alttext="\displaystyle-\frac{1}{r^{n}}\int_{\partial B_{r}}|y|^{a}\left(\frac{(1-a)uu_{\nu}}{r}-2u^{2}_{\nu}\right)+C(r^{2s-1}+1)=0." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>r</mi><mi>n</mi></msup></mfrac></mstyle><mstyle displaystyle="true"><msub><mo>∫</mo><mrow><mo>∂</mo><msub><mi>B</mi><mi>r</mi></msub></mrow></msub></mstyle><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>y</mi><msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>a</mi></msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mi>ν</mi></msub></mrow><mi>r</mi></mfrac></mstyle><mo>−</mo><mn>2</mn><msubsup><mi>u</mi><mi>ν</mi><mn>2</mn></msubsup><mo>)</mo></mrow><mo>+</mo><mi>C</mi><mrow><mo stretchy="false">(</mo><msup><mi>r</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>=</mo><mn>0</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{1}{r^{n}}\int_{\partial B_{r}}|y|^{a}\left(\frac{(1-a)uu_{\nu}}{r}-2u^{2}_{\nu}\right)+C(r^{2s-1}+1)=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p2.16" class="ltx_p"><span id="S7.p2.16.1" class="ltx_text">For <math id="S7.p2.m20" class="ltx_Math" alttext="\epsilon&lt;r" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&lt;</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">\epsilon&lt;r</annotation></semantics></math>, we may integrate and use Fubini’s theorem to get</span></p>
<table id="S7.EGx65" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S7.E26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
