<p id="S2.p5.5" class="ltx_p"><span id="S2.p5.5.1" class="ltx_text">For the <math id="S2.p5.m8" class="ltx_Math" alttext="|x-y|&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">|x-y|&lt;1</annotation></semantics></math> piece, we use that <math id="S2.p5.m9" class="ltx_Math" alttext="|\eta(x)-\eta(y)|&lt;|x-y|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><mrow><mo stretchy="false">|</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">|\eta(x)-\eta(y)|&lt;|x-y|</annotation></semantics></math>,</span></p>
<table id="S2.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex24.m1" class="ltx_Math" alttext="\int_{B_{r}}\int_{|x-y|&lt;1}\frac{u(x)u(y)(\eta(x)-\eta(y))^{2}}{|x-y|^{n+2s}}\leq\|u\|_{L^{\infty}(\mathcal{R}^{n}_{k})}\sup_{B_{r}}|u|\int_{|x-y|&lt;1}\int_{B_{r}}\frac{|x-y|^{2}}{|x-y|^{n+2s}}\leq Cr^{n}\|u\|_{L^{\infty}(\mathcal{R}^{n}_{k})}\sup_{B_{r}}|u|." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mo>∫</mo><msub><mi>B</mi><mi>r</mi></msub></msub><mrow><msub><mo lspace="0.167em">∫</mo><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><mn>1</mn></mrow></msub><mfrac><mrow><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><msup><mrow><mo stretchy="false">|</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">|</mo></mrow><mrow><mi>n</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup></mfrac></mrow></mrow><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>u</mi><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi><mi>n</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">sup</mo><msub><mi>B</mi><mi>r</mi></msub></munder><mrow><mrow><mo stretchy="false">|</mo><mi>u</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo rspace="0em">∫</mo><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><mn>1</mn></mrow></msub><mrow><msub><mo>∫</mo><msub><mi>B</mi><mi>r</mi></msub></msub><mfrac><msup><mrow><mo stretchy="false">|</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><msup><mrow><mo stretchy="false">|</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">|</mo></mrow><mrow><mi>n</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup></mfrac></mrow></mrow></mrow></mrow></mrow><mo>≤</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mi>n</mi></msup></mrow></mrow><mo fence="false">|</mo><mrow><mi>u</mi><mo fence="false" rspace="0.1389em">|</mo><mrow><mmultiscripts><munder><mo lspace="0.1389em" movablelimits="false">sup</mo><msub><mi>B</mi><mi>r</mi></msub></munder><mprescripts></mprescripts><mrow><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi><mi>n</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mrow></mrow></mmultiscripts><mo lspace="0em">⁡</mo><mrow><mo stretchy="false">|</mo><mi>u</mi><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\int_{B_{r}}\int_{|x-y|&lt;1}\frac{u(x)u(y)(\eta(x)-\eta(y))^{2}}{|x-y|^{n+2s}}\leq\|u\|_{L^{\infty}(\mathcal{R}^{n}_{k})}\sup_{B_{r}}|u|\int_{|x-y|&lt;1}\int_{B_{r}}\frac{|x-y|^{2}}{|x-y|^{n+2s}}\leq Cr^{n}\|u\|_{L^{\infty}(\mathcal{R}^{n}_{k})}\sup_{B_{r}}|u|.</annotation></semantics></math></td>
