space="0.167em">∇</mo><mi>v</mi></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mrow><mrow><msub><mo>∫</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi><mi>n</mi></msubsup></msub><msup><mrow><mo lspace="0em" stretchy="false">|</mo><msup><mi>v</mi><mo>′</mo></msup><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi><mi>n</mi></msubsup><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow></msub><mi>χ</mi><msub><mrow></mrow><mrow><mo stretchy="false">{</mo><mi>v</mi><mo>≠</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mrow></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\int_{\mathcal{R}^{n+1}_{k}}|y|^{a}|\nabla u^{\prime}|^{2}+\int_{\mathcal{R}^{n}_{k}\times\{0\}}\chi_{\{u\neq 0\}}d\mathcal{H}^{n-1}\leq\frac{\int_{\mathcal{R}^{n+1}_{k}}|y|^{a}|\nabla v|^{2}}{\int_{\mathcal{R}^{n}_{k}}|v^{\prime}|^{2}}+\int_{\mathcal{R}^{n}_{k}\times\{0\}}\chi_{\{v\neq 0\}}d\mathcal{H}^{n-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
