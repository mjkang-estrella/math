<div id="S9.Thmthm12" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S9.Thmthm12.2" class="ltx_text ltx_font_bold">Theorem 9.12</span></span><span id="S9.Thmthm12.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S9.Thmthm12.p1" class="ltx_para">
<p id="S9.Thmthm12.p1.1" class="ltx_p"><span id="S9.Thmthm12.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S9.Thmthm12.p1.m1" class="ltx_Math" alttext="u_{k}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mi>k</mi></msub><annotation encoding="application/x-tex">u_{k}</annotation></semantics></math> be the corresponding eigenfunction to a <math id="S9.Thmthm12.p1.m2" class="ltx_Math" alttext="\lambda_{k}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\lambda_{k}</annotation></semantics></math>-minimizer. Let <math id="S9.Thmthm12.p1.m3" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> be the extension of <math id="S9.Thmthm12.p1.m4" class="ltx_Math" alttext="u_{k}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mi>k</mi></msub><annotation encoding="application/x-tex">u_{k}</annotation></semantics></math>. Assume that <math id="S9.Thmthm12.p1.m5" class="ltx_Math" alttext="\|u\|_{C^{0,s}(B_{1})}\leq C" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>u</mi><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>C</mi><mrow><mn>0</mn><mo>,</mo><mi>s</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>B</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></msub><mo>≤</mo><mi>C</mi></mrow><annotation encoding="application/x-tex">\|u\|_{C^{0,s}(B_{1})}\leq C</annotation></semantics></math>, and <math id="S9.Thmthm12.p1.m6" class="ltx_Math" alttext="|u-U|\leq\tau_{0}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>u</mi><mo>−</mo><mi>U</mi></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><msub><mi>τ</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">|u-U|\leq\tau_{0}</annotation></semantics></math> in <math id="S9.Thmthm12.p1.m7" class="ltx_Math" alttext="B_{1}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mn>1</mn></msub><annotation encoding="application/x-tex">B_{1}</annotation></semantics></math> where <math id="S9.Thmthm12.p1.m8" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> (depending only on <math id="S9.Thmthm12.p1.m9" class="ltx_Math" alttext="x_{n},y" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>n</mi></msub><mo>,</mo><mi>y</mi></mrow><annotation encoding="application/x-tex">x_{n},y</annotation></semantics></math>), in polar coordinates <math id="S9.Thmthm12.p1.m10" class="ltx_Math" alttext="x_{n}=\rho\cos(\theta)" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>n</mi></msub><mo>=</mo><mrow><mi>ρ</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">x_{n}=\rho\cos(\theta)</annotation></semantics></math>, <math id="S9.Thmthm12.p1.m11" class="ltx_Math" alttext="y=\rho\sin(\theta)" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>=</mo><mrow><mi>ρ</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>sin</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">y=\rho\sin(\theta)</annotation></semantics></math>,</span></p>
<table id="S9.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S9.Ex6.m1" class="ltx_math_unparsed" alttext="U(x,y)=\rho^{1/2}\cos(\theta/2)^{2s}." display="block" intent=":literal"><semantics><mrow><mi>U</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msup><mi>ρ</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mi>cos</mi><msup><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>/</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">U(x,y)=\rho^{1/2}\cos(\theta/2)^{2s}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S9.Thmthm12.p1.2" class="ltx_p"><span id="S9.Thmthm12.p1.2.1" class="ltx_text ltx_font_italic">If <math id="S9.Thmthm12.p1.m12" class="ltx_Math" alttext="\tau_{0}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\tau_{0}</annotation></semantics></math> and <math id="S9.Thmthm12.p1.m13" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> is small and depend on <math id="S9.Thmthm12.p1.m14" class="ltx_Math" alttext="\alpha,n,s" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>,</mo><mi>n</mi><mo>,</mo><mi>s</mi></mrow><annotation encoding="application/x-tex">\alpha,n,s</annotation></semantics></math>, then <math id="S9.Thmthm12.p1.m15" class="ltx_math_unparsed" alttext="F(u)=\partial\{u_{k}\neq 0\}" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">=</mo><mo>∂</mo><mrow><mo stretchy="false">{</mo><msub><mi>u</mi><mi>k</mi></msub><mo>≠</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">F(u)=\partial\{u_{k}\neq 0\}</annotation></semantics></math> is <math id="S9.Thmthm12.p1.m16" class="ltx_Math" alttext="C^{1,\gamma_{0}}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mrow><mn>1</mn><mo>,</mo><msub><mi>γ</mi><mn>0</mn></msub></mrow></msup><annotation encoding="application/x-tex">C^{1,\gamma_{0}}</annotation></semantics></math> in <math id="S9.Thmthm12.p1.m17" class="ltx_Math" alttext="B_{1/2}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">B_{1/2}</annotation></semantics></math>, where <math id="S9.Thmthm12.p1.m18" class="ltx_Math" alttext="\gamma_{0}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\gamma_{0}</annotation></semantics></math> is some number depending on <math id="S9.Thmthm12.p1.m19" class="ltx_Math" alttext="\alpha,n,s" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>,</mo><mi>n</mi><mo>,</mo><mi>s</mi></mrow><annotation encoding="application/x-tex">\alpha,n,s</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S9.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S9.p5" class="ltx_para">
<p id="S9.p5.1" class="ltx_p"><span id="S9.p5.1.1" class="ltx_text">By Theorem <a href="#S5.Thmthm19" title="Theorem 5.19. ‣ 5. Optimal Regularity ‣ Minimizing Eigenvalues of the Fractional Laplacian" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.19</span></a>, <math id="S9.p5.m1" class="ltx_Math" alttext="u\in C^{0,s}(B_{1})" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>∈</mo><mrow><msup><mi>C</mi><mrow><mn>0</mn><mo>,</mo><mi>s</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>B</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">u\in C^{0,s}(B_{1})</annotation></semantics></math>. By previous Lemma, <math id="S9.p5.m2" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> is an almost minimizer of <math id="S9.p5.m3" class="ltx_Math" alttext="\tilde{J}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>J</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{J}</annotation></semantics></math>, and thus Theorem 7.4<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib3" title="" class="ltx_ref">3</a>]</cite> applies.
∎</span></p>
</div>
</div>
</section>
<section id="S10" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">10. </span>The Global Configuration and a Toy Problem</h2>

<div id="S10.p1" class="ltx_para">
<p id="S10.p1.1" class="ltx_p">In light of Theorem <a href="#S8.Thmthm3" title="Theorem 8.3. ‣ 8. Separation of the Free Boundary and Density Estimates ‣ Minimizing Eigenvalues of the Fractional Laplacian" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8.3</span></a>, the <math id="S10.p1.m1" class="ltx_Math" alttext="\lambda_{k}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\lambda_{k}</annotation></semantics></math>-minimizer <math id="S10.p1.m2" class="ltx_Math" alttext="A\subset\mathcal{R}^{n}_{k}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>⊂</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi><mi>n</mi></msubsup></mrow><annotation encoding="application/x-tex">A\subset\mathcal{R}^{n}_{k}</annotation></semantics></math> is a disjoint union of connected components for <math id="S10.p1.m3" class="ltx_Math" alttext="k&gt;2" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>&gt;</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">k&gt;2</annotation></semantics></math>. We wish to study how translating the disconnected components of <math id="S10.p1.m4" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> affect <math id="S10.p1.m5" class="ltx_Math" alttext="\lambda_{k}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\lambda_{k}</annotation></semantics></math>.</p>
</div>
<div id="S10.p2" class="ltx_para">
<p id="S10.p2.1" class="ltx_p">Let <math id="S10.p2.m1" class="ltx_Math" alttext="u_{k}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mi>k</mi></msub><annotation encoding="application/x-tex">u_{k}</annotation></semantics></math> be the eigenfunction corresponding to the minimizing <math id="S10.p2.m2" class="ltx_Math" alttext="\lambda_{k}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\lambda_{k}</annotation></semantics></math>. Let <math id="S10.p2.m3" class="ltx_Math" alttext="u=u_{k}|_{{\mathbb{R}}^{n}_{i}}" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>=</mo><msub><mrow><msub><mi>u</mi><mi>k</mi></msub><mo stretchy="false">|</mo></mrow><msubsup><mi>ℝ</mi><mi>i</mi><mi>n</mi></msubsup></msub></mrow><annotation encoding="application/x-tex">u=u_{k}|_{{\mathbb{R}}^{n}_{i}}</annotation></semantics></math> for any <math id="S10.p2.m4" class="ltx_Math" alttext="1\leq i\leq k" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">1\leq i\leq k</annotation></semantics></math>, choose <math id="S10.p2.m5" class="ltx_Math" alttext="\|u\|_{L^{2}({\mathbb{R}}^{n})}=1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>u</mi><mo stretchy="false">‖</mo></mrow><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>ℝ</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|u\|_{L^{2}({\mathbb{R}}^{n})}=1</annotation></semantics></math>. Let <math id="S10.p2.m6" class="ltx_math_unparsed" alttext="A=\{u\neq 0\}\subset{\mathbb{R}}^{n}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>u</mi><mo>≠</mo><mn>0</mn><mo stretchy="false">}</mo></mrow><mo>⊂</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">A=\{u\neq 0\}\subset{\mathbb{R}}^{n}</annotation></semantics></math>, then we can write</p>
<table id="S10.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(10.1)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S10.E1.m1" class="ltx_Math" alttext="A=A_{1}\cup A_{2},\text{ with }A_{1}\cap A_{2}=\varnothing." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>A</mi><mo>=</mo><mrow><msub><mi>A</mi><mn>1</mn></msub><mo>∪</mo><msub><mi>A</mi><mn>2</mn></msub></mrow></mrow><mo>,</mo><mrow><mrow><mrow><mtext> with </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mn>1</mn></msub></mrow><mo>∩</mo><msub><mi>A</mi><mn>2</mn></msub></mrow><mo>=</mo><mi mathvariant="normal">∅</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">A=A_{1}\cup A_{2},\text{ with }A_{1}\cap A_{2}=\varnothing.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S10.p2.2" class="ltx_p">Let <math id="S10.p2.m7" class="ltx_Math" alttext="C={\mathbb{R}}^{n}\setminus\{A_{1}\cup A_{2}\}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mrow><msup><mi>ℝ</mi><mi>n</mi></msup><mo>∖</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>A</mi><mn>1</mn></msub><mo>∪</mo><msub><mi>A</mi><mn>2</mn></msub></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C={\mathbb{R}}^{n}\setminus\{A_{1}\cup A_{2}\}</annotation></semantics></math>. We investigate how translating <math id="S10.p2.m8" class="ltx_Math" alttext="A_{1}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mn>1</mn></msub><annotation encoding="application/x-tex">A_{1}</annotation></semantics></math> and <math id="S10.p2.m9" class="ltx_Math" alttext="A_{2}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mn>2</mn></msub><annotation encoding="application/x-tex">A_{2}</annotation></semantics></math> affects <math id="S10.p2.m10" class="ltx_Math" alttext="\lambda_{k}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\lambda_{k}</annotation></semantics></math>. We decompose the region of integration <math id="S10.p2.m11" class="ltx_Math" alttext="{\mathbb{R}}^{n}\times{\mathbb{R}}^{n}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℝ</mi><mi>n</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">{\mathbb{R}}^{n}\times{\mathbb{R}}^{n}</annotation></semantics></math> in the following way.</p>
<table id="S10.EGx75" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S10.E2"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(10.2)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S10.E2.m1" class="ltx_math_unparsed" alttext="\displaystyle\lambda_{k}(A)=\int_{{\mathbb{R}}^{n}}\int_{{\mathbb{R}}^{n}}\frac{(u(x)-u(y))^{2}}{|x-y|^{n+2s}}=\int_{A_{1}}\int_{A_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mstyle displaystyle="true"><msub><mo>∫</mo><msup><mi>ℝ</mi><mi>n</mi></msup></msub></mstyle><mstyle displaystyle="true"><msub><mo>∫</mo><msup><mi>ℝ</mi><mi>n</mi></msup></msub></mstyle><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msup><mrow><mo stretchy="false">|</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">|</mo></mrow><mrow><mi>n</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup></mfrac></mstyle><mo>=</mo><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>A</mi><mn>1</mn></msub></msub></mstyle><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>A</mi><mn>1</mn></msub></msub></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\lambda_{k}(A)=\int_{{\mathbb{R}}^{n}}\int_{{\mathbb{R}}^{n}}\frac{(u(x)-u(y))^{2}}{|x-y|^{n+2s}}=\int_{A_{1}}\int_{A_{1}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S10.E2.m2" class="ltx_math_unparsed" alttext="\displaystyle+\int_{A_{2}}\int_{A_{2}}+\int_{C}\int_{C}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><msub><mi>A</mi><mn>2</mn></msub></msub><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><msub><mi>A</mi><mn>2</mn></msub></msub><mo lspace="0em">+</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mi>C</mi></msub><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mi>C</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle+\int_{A_{2}}\int_{A_{2}}+\int_{C}\int_{C}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S10.E3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(10.3)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S10.E3.m1" class="ltx_math_unparsed" alttext="\displaystyle+2\int_{A_{1}}\int_{A_{2}}+2\int_{A_{1}}\int_{C}+2\int_{A_{2}}\int_{C}." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>2</mn><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><msub><mi>A</mi><mn>1</mn></msub></msub><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><msub><mi>A</mi><mn>2</mn></msub></msub><mo lspace="0em">+</mo><mn>2</mn><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><msub><mi>A</mi><mn>1</mn></msub></msub><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mi>C</mi></msub><mo lspace="0em">+</mo><mn>2</mn><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><msub><mi>A</mi><mn>2</mn></msub></msub><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mi>C</mi></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+2\int_{A_{1}}\int_{A_{2}}+2\int_{A_{1}}\int_{C}+2\int_{A_{2}}\int_{C}.</annotation></semantics></math></td>
