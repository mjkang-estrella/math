<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S9.E10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(9.10)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.E10.m1" class="ltx_Math" alttext="\displaystyle=(1+Cr^{n+2s}){\int_{\mathcal{R}^{n+1}_{k}\setminus B_{r}}|y|^{a}|\nabla u|^{2}}+(1+Cr^{n+2s}){\int_{B_{r}}|y|^{a}|\nabla v|^{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mrow><mi>n</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mo>∖</mo><msub><mi>B</mi><mi>r</mi></msub></mrow></msub></mstyle><mrow><msup><mrow><mo stretchy="false">|</mo><mi>y</mi><mo stretchy="false">|</mo></mrow><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><mrow><mo rspace="0.167em">∇</mo><mi>u</mi></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mrow><mi>n</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>B</mi><mi>r</mi></msub></msub></mstyle><mrow><msup><mrow><mo stretchy="false">|</mo><mi>y</mi><mo stretchy="false">|</mo></mrow><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><mrow><mo rspace="0.167em">∇</mo><mi>v</mi></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=(1+Cr^{n+2s}){\int_{\mathcal{R}^{n+1}_{k}\setminus B_{r}}|y|^{a}|\nabla u|^{2}}+(1+Cr^{n+2s}){\int_{B_{r}}|y|^{a}|\nabla v|^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S9.Ex2"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.Ex2.m1" class="ltx_math_unparsed" alttext="\displaystyle+\int_{B_{r}\cap\{y=0\}}\chi_{\{v\neq 0\}}d\mathcal{H}^{n-1}+\int_{(\mathcal{R}^{n}_{k}\setminus B_{r})\cap\{y=0\}}\chi_{\{u\neq 0\}}d\mathcal{H}^{n-1}." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mrow><mi>B</mi><msub><mrow></mrow><mi>r</mi></msub><mo>∩</mo><mo stretchy="false">{</mo><mi>y</mi><mo>=</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></msub><mi>χ</mi><msub><mrow></mrow><mrow><mo stretchy="false">{</mo><mi>v</mi><mo>≠</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mrow></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>+</mo><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi><msup><mrow></mrow><mi>n</mi></msup><msub><mrow></mrow><mi>k</mi></msub><mo>∖</mo><mi>B</mi><msub><mrow></mrow><mi>r</mi></msub><mo stretchy="false">)</mo><mo>∩</mo><mo stretchy="false">{</mo><mi>y</mi><mo>=</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></msub><mi>χ</mi><msub><mrow></mrow><mrow><mo stretchy="false">{</mo><mi>u</mi><mo>≠</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mrow></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\int_{B_{r}\cap\{y=0\}}\chi_{\{v\neq 0\}}d\mathcal{H}^{n-1}+\int_{(\mathcal{R}^{n}_{k}\setminus B_{r})\cap\{y=0\}}\chi_{\{u\neq 0\}}d\mathcal{H}^{n-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S9.p4.2" class="ltx_p"><span id="S9.p4.2.1" class="ltx_text">Combining the terms of <math id="S9.p4.m1" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> with the left hand side of (<a href="#S9.E5" title="In Proof. ‣ 9. Free Boundary Regularity ‣ Minimizing Eigenvalues of the Fractional Laplacian" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9.5</span></a>), we have</span></p>
<table id="S9.EGx74" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S9.E11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(9.11)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S9.E11.m1" class="ltx_math_unparsed" alttext="\displaystyle\int_{B_{r}}|y|^{a}|\nabla u|^{2}+\int_{B_{r}\cap\{y=0\}}\chi_{\{u\neq 0\}}d\mathcal{H}^{n-1}\leq(1" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>B</mi><mi>r</mi></msub></msub></mstyle><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>y</mi><msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>a</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo rspace="0.167em">∇</mo><mi>u</mi><msup><mo fence="false" stretchy="false">|</mo><mn>2</mn></msup><mo lspace="0em">+</mo><mstyle displaystyle="true"><msub><mo>∫</mo><mrow><mi>B</mi><msub><mrow></mrow><mi>r</mi></msub><mo>∩</mo><mo stretchy="false">{</mo><mi>y</mi><mo>=</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></msub></mstyle><msub><mi>χ</mi><mrow><mo stretchy="false">{</mo><mi>u</mi><mo>≠</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></msub><mi>d</mi><msup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>≤</mo><mrow><mo stretchy="false">(</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{B_{r}}|y|^{a}|\nabla u|^{2}+\int_{B_{r}\cap\{y=0\}}\chi_{\{u\neq 0\}}d\mathcal{H}^{n-1}\leq(1</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.E11.m2" class="ltx_math_unparsed" alttext="\displaystyle+Cr^{n+2s})\int_{B_{r}}|y|^{a}|\nabla v|^{2}+\int_{B_{r}\cap\{y=0\}}\chi_{\{v\neq 0\}}d\mathcal{H}^{n-1}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>C</mi><msup><mi>r</mi><mrow><mi>n</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup><mo stretchy="false">)</mo><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>B</mi><mi>r</mi></msub></msub></mstyle><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>y</mi><msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>a</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo rspace="0.167em">∇</mo><mi>v</mi><msup><mo fence="false" stretchy="false">|</mo><mn>2</mn></msup><mo lspace="0em">+</mo><mstyle displaystyle="true"><msub><mo>∫</mo><mrow><mi>B</mi><msub><mrow></mrow><mi>r</mi></msub><mo>∩</mo><mo stretchy="false">{</mo><mi>y</mi><mo>=</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></msub></mstyle><msub><mi>χ</mi><mrow><mo stretchy="false">{</mo><mi>v</mi><mo>≠</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></msub><mi>d</mi><msup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle+Cr^{n+2s})\int_{B_{r}}|y|^{a}|\nabla v|^{2}+\int_{B_{r}\cap\{y=0\}}\chi_{\{v\neq 0\}}d\mathcal{H}^{n-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S9.Ex3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S9.Ex3.m1" class="ltx_math_unparsed" alttext="\displaystyle+Cr^{n+2s}\int_{\mathcal{R}^{n+1}_{k}\setminus B_{r}}|y|^{a}|\nabla u|^{2}." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>C</mi><mi>r</mi><msup><mrow></mrow><mrow><mi>n</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mo>∖</mo><msub><mi>B</mi><mi>r</mi></msub></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>y</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mrow></mrow><mi>a</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo rspace="0.167em">∇</mo><mi>u</mi><mo fence="false" stretchy="false">|</mo><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0.167em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+Cr^{n+2s}\int_{\mathcal{R}^{n+1}_{k}\setminus B_{r}}|y|^{a}|\nabla u|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S9.p4.3" class="ltx_p"><span id="S9.p4.3.1" class="ltx_text">We note that if the third term can be reabsorbed by the left hand side for some <math id="S9.p4.m2" class="ltx_Math" alttext="\alpha_{0}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mn>0</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\alpha_{0}&gt;0</annotation></semantics></math> in the following way, then the Lemma is proved.</span></p>
<table id="S9.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S9.Ex4.m1" class="ltx_math_unparsed" alttext="r^{n+2s}\int_{\mathcal{R}^{n+1}_{k}\setminus B_{r}}|y|^{a}|\nabla u|^{2}\leq Cr^{\alpha_{0}}\left(\int_{B_{r}}|y|^{a}|\nabla u|^{2}+\int_{B_{r}\cap\{y=0\}}\chi_{\{u\neq 0\}}d\mathcal{H}^{n-1}\right)." display="block" intent=":literal"><semantics><mrow><msup><mi>r</mi><mrow><mi>n</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup><msub><mo rspace="0em">∫</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>k</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mo>∖</mo><msub><mi>B</mi><mi>r</mi></msub></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>y</mi><msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>a</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo rspace="0.167em">∇</mo><mi>u</mi><msup><mo fence="false" stretchy="false">|</mo><mn>2</mn></msup><mo lspace="0.167em">≤</mo><mi>C</mi><msup><mi>r</mi><msub><mi>α</mi><mn>0</mn></msub></msup><mrow><mo>(</mo><msub><mo lspace="0em" rspace="0em">∫</mo><msub><mi>B</mi><mi>r</mi></msub></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>y</mi><msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>a</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo rspace="0.167em">∇</mo><mi>u</mi><msup><mo fence="false" stretchy="false">|</mo><mn>2</mn></msup><mo lspace="0em" rspace="0.055em">+</mo><msub><mo>∫</mo><mrow><mi>B</mi><msub><mrow></mrow><mi>r</mi></msub><mo>∩</mo><mo stretchy="false">{</mo><mi>y</mi><mo>=</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></msub><msub><mi>χ</mi><mrow><mo stretchy="false">{</mo><mi>u</mi><mo>≠</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></msub><mi>d</mi><msup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">r^{n+2s}\int_{\mathcal{R}^{n+1}_{k}\setminus B_{r}}|y|^{a}|\nabla u|^{2}\leq Cr^{\alpha_{0}}\left(\int_{B_{r}}|y|^{a}|\nabla u|^{2}+\int_{B_{r}\cap\{y=0\}}\chi_{\{u\neq 0\}}d\mathcal{H}^{n-1}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S9.p4.4" class="ltx_p"><span id="S9.p4.4.1" class="ltx_text">This follows from the Weiss monotonicity formula (<a href="#S7.E32" title="In Proof. ‣ 7. Blow-up Analysis ‣ Minimizing Eigenvalues of the Fractional Laplacian" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.32</span></a>) that there exists <math id="S9.p4.m3" class="ltx_Math" alttext="C&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C&gt;0</annotation></semantics></math>, such that for all <math id="S9.p4.m4" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> small,</span></p>
<table id="S9.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S9.Ex5.m1" class="ltx_math_unparsed" alttext="\int_{B_{r}}|y|^{a}|\nabla u|^{2}+\int_{B_{r}\cap\{y=0\}}\chi_{\{u\neq 0\}}d\mathcal{H}^{n-1}&gt;Cr^{n}." display="block" intent=":literal"><semantics><mrow><mo rspace="0em">∫</mo><msub><mrow></mrow><msub><mi>B</mi><mi>r</mi></msub></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>y</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mrow></mrow><mi>a</mi></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo rspace="0.167em">∇</mo><mi>u</mi><mo fence="false" stretchy="false">|</mo><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0.055em">+</mo><mo>∫</mo><msub><mrow></mrow><mrow><mi>B</mi><msub><mrow></mrow><mi>r</mi></msub><mo>∩</mo><mo stretchy="false">{</mo><mi>y</mi><mo>=</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></msub><mi>χ</mi><msub><mrow></mrow><mrow><mo stretchy="false">{</mo><mi>u</mi><mo>≠</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></msub><mi>d</mi><mi class="ltx_font_mathcaligraphic">ℋ</mi><msup><mrow></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>&gt;</mo><mi>C</mi><mi>r</mi><msup><mrow></mrow><mi>n</mi></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\int_{B_{r}}|y|^{a}|\nabla u|^{2}+\int_{B_{r}\cap\{y=0\}}\chi_{\{u\neq 0\}}d\mathcal{H}^{n-1}&gt;Cr^{n}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S9.p4.5" class="ltx_p"><span id="S9.p4.5.1" class="ltx_text">This finishes the proof of Lemma.
∎</span></p>
