<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.E20.m1" class="ltx_Math" alttext="\displaystyle\int_{B_{r}}\int_{{\mathbb{R}}^{n}}\frac{u(x)u(y)(\eta(x)-\eta(y))^{2}}{|x-y|^{n+2s}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msub><mi>B</mi><mi>r</mi></msub></msub></mstyle><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msup><mi>ℝ</mi><mi>n</mi></msup></msub></mstyle><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><msup><mrow><mo stretchy="false">|</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">|</mo></mrow><mrow><mi>n</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{B_{r}}\int_{{\mathbb{R}}^{n}}\frac{u(x)u(y)(\eta(x)-\eta(y))^{2}}{|x-y|^{n+2s}}</annotation></semantics></math></td>
