<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S6.Ex9.m1" class="ltx_Math" alttext="\displaystyle\quad+\frac{2(u_{j}(x)-u_{j}(y)((u_{j}-v_{j})(x)-(u_{j}-v_{j})(y))}{|x-y|^{n+2s}}." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>u</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>u</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>u</mi><mi>j</mi></msub><mo>−</mo><msub><mi>v</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>u</mi><mi>j</mi></msub><mo>−</mo><msub><mi>v</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow><msup><mrow><mo stretchy="false">|</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">|</mo></mrow><mrow><mi>n</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\frac{2(u_{j}(x)-u_{j}(y)((u_{j}-v_{j})(x)-(u_{j}-v_{j})(y))}{|x-y|^{n+2s}}.</annotation></semantics></math></td>
