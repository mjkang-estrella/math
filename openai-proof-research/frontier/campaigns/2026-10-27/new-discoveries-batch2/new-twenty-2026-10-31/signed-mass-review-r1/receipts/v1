/mrow><annotation encoding="application/x-tex">C\int_{0}^{r}\left(\frac{|B_{t}(y_{l})|}{t^{n-2s+1}}\right)dt+\frac{1}{|B_{r}(y_{l})|}\int_{B_{r}(y_{l})}|u(x)|dx\leq Cr^{2s}.</annotation></semantics></math></td>
