</table>
<p id="S4.p12.1" class="ltx_p"><span id="S4.p12.1.1" class="ltx_text">where <math id="S4.p12.m1" class="ltx_Math" alttext="\mathscr{V}_{\alpha}\left(v\right)={v}_{\alpha}\sqrt{\Lambda_{\alpha}^{+}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathscript">𝒱</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>v</mi><mo>)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>v</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><msubsup><mi mathvariant="normal">Λ</mi><mi>α</mi><mo>+</mo></msubsup></msqrt></mrow></mrow><annotation encoding="application/x-tex">\mathscr{V}_{\alpha}\left(v\right)={v}_{\alpha}\sqrt{\Lambda_{\alpha}^{+}}</annotation></semantics></math>
is the position vector of the vertex <math id="S4.p12.m2" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> in the Euclidean space induced
by the hubs-repelling Laplacian.
∎</span></p>
</div>
</div>
<div id="S4.Thmtheorem3" class="ltx_theorem ltx_theorem_cor">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem3.2" class="ltx_text ltx_font_bold">Corollary 4.3</span></span><span id="S4.Thmtheorem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem3.p1" class="ltx_para">
<p id="S4.Thmtheorem3.p1.1" class="ltx_p"><span id="S4.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmtheorem3.p1.m1" class="ltx_Math" alttext="\alpha\in\{-1,1\}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha\in\{-1,1\}</annotation></semantics></math> and <math id="S4.Thmtheorem3.p1.m2" class="ltx_Math" alttext="\mathscr{L}_{\alpha}=V_{\alpha}\Lambda_{\alpha}V_{\alpha}^{-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">ℒ</mi><mi>α</mi></msub><mo>=</mo><mrow><msub><mi>V</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Λ</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>V</mi><mi>α</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">\mathscr{L}_{\alpha}=V_{\alpha}\Lambda_{\alpha}V_{\alpha}^{-1}</annotation></semantics></math>,
where
<math id="S4.Thmtheorem3.p1.m3" class="ltx_Math" alttext="V_{\alpha}:=KU_{\alpha}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi>α</mi></msub><mo>:=</mo><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>U</mi><mi>α</mi></msub></mrow></mrow><annotation encoding="application/x-tex">V_{\alpha}:=KU_{\alpha}</annotation></semantics></math> for <math id="S4.Thmtheorem3.p1.m4" class="ltx_Math" alttext="V_{\alpha}:=\left[{\psi}_{\alpha,1},{\psi}_{\alpha,2},\cdots,{\psi}_{\alpha n}\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi>α</mi></msub><mo>:=</mo><mrow><mo>[</mo><mrow><msub><mi>ψ</mi><mrow><mi>α</mi><mo>,</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>ψ</mi><mrow><mi>α</mi><mo>,</mo><mn>2</mn></mrow></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>ψ</mi><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">V_{\alpha}:=\left[{\psi}_{\alpha,1},{\psi}_{\alpha,2},\cdots,{\psi}_{\alpha n}\right]</annotation></semantics></math>
and <math id="S4.Thmtheorem3.p1.m5" class="ltx_Math" alttext="\Lambda_{\alpha}:=\diag\left(\rho_{\alpha,k}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Λ</mi><mi>α</mi></msub><mo>:=</mo><mrow><mi>diag</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>ρ</mi><mrow><mi>α</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Lambda_{\alpha}:=\diag\left(\rho_{\alpha,k}\right)</annotation></semantics></math>.
Then,</span></p>
<table id="S4.E12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_left_padleft"></td>
<td class="ltx_eqn_cell ltx_align_left"><math id="S4.E12.m1" class="ltx_Math" alttext="\Omega_{\alpha}\left(u,w\right)=\sum_{k=2}^{n}\rho_{\alpha,k}^{-1}\left(\psi_{\alpha,k,u}-\psi_{\alpha,k,w}\right)^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi mathvariant="normal">Ω</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>u</mi><mo>,</mo><mi>w</mi><mo>)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>2</mn></mrow><mi>n</mi></munderover><mrow><msubsup><mi>ρ</mi><mrow><mi>α</mi><mo>,</mo><mi>k</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mi>ψ</mi><mrow><mi>α</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>u</mi></mrow></msub><mo>−</mo><msub><mi>ψ</mi><mrow><mi>α</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>w</mi></mrow></msub></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Omega_{\alpha}\left(u,w\right)=\sum_{k=2}^{n}\rho_{\alpha,k}^{-1}\left(\psi_{\alpha,k,u}-\psi_{\alpha,k,w}\right)^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_left_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.12)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.p13" class="ltx_para">
<p id="S4.p13.1" class="ltx_p"><span id="S4.p13.1.1" class="ltx_text">It is easy to see from Lemma <a href="#S4.Thmtheorem2" title="Lemma 4.2. ‣ 4 Hubs-biased Resistance Distance ‣ Hubs-biased resistance distances on graphs and networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a> that</span></p>
</div>
<div id="S4.p14" class="ltx_para">
<table id="S4.E13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_left_padleft"></td>
<td class="ltx_eqn_cell ltx_align_left"><math id="S4.E13.m1" class="ltx_Math" alttext="\begin{split}\Omega_{\alpha}\left(u,w\right)&amp;=\sum_{k=2}^{n}\rho_{\alpha,k}^{-1}\psi_{\alpha,k,u}^{2}+\sum_{k=2}^{n}\rho_{\alpha,k}^{-1}\psi_{\alpha,k,w}^{2}-2\sum_{k=2}^{n}\rho_{\alpha,k}^{-1}\psi_{\alpha,k,u}\psi_{\alpha,k,w}\\
&amp;=\sum_{k=2}^{n}\rho_{\alpha,k}^{-1}\left(\psi_{\alpha,k,u}^{2}+\psi_{\alpha,k,w}^{2}-2\psi_{\alpha,k,u}\psi_{\left\{R,A\right\},k,w}\right)\\
&amp;=\sum_{k=2}^{n}\rho_{\alpha,k}^{-1}\left(\psi_{\alpha,k,u}-\psi_{\alpha,k,w}\right)^{2}.\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><msub><mi mathvariant="normal">Ω</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>u</mi><mo>,</mo><mi>w</mi><mo>)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo rspace="0.111em">=</mo><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>2</mn></mrow><mi>n</mi></munderover><mrow><msubsup><mi>ρ</mi><mrow><mi>α</mi><mo>,</mo><mi>k</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ψ</mi><mrow><mi>α</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>u</mi></mrow><mn>2</mn></msubsup></mrow></mrow><mo rspace="0.055em">+</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>2</mn></mrow><mi>n</mi></munderover><mrow><msubsup><mi>ρ</mi><mrow><mi>α</mi><mo>,</mo><mi>k</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>ψ</mi><mrow><mi>α</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>w</mi></mrow><mn>2</mn></msubsup></mrow></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>2</mn></mrow><mi>n</mi></munderover><mrow><msubsup><mi>ρ</mi><mrow><mi>α</mi><mo>,</mo><mi>k</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>ψ</mi><mrow><mi>α</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>u</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ψ</mi><mrow><mi>α</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>w</mi></mrow></msub></mrow></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>2</mn></mrow><mi>n</mi></munderover><mrow><msubsup><mi>ρ</mi><mrow><mi>α</mi><mo>,</mo><mi>k</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msubsup><mi>ψ</mi><mrow><mi>α</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>u</mi></mrow><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>ψ</mi><mrow><mi>α</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>w</mi></mrow><mn>2</mn></msubsup></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>ψ</mi><mrow><mi>α</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>u</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ψ</mi><mrow><mrow><mo>{</mo><mrow><mi>R</mi><mo>,</mo><mi>A</mi></mrow><mo>}</mo></mrow><mo>,</mo><mi>k</mi><mo>,</mo><mi>w</mi></mrow></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>2</mn></mrow><mi>n</mi></munderover><mrow><msubsup><mi>ρ</mi><mrow><mi>α</mi><mo>,</mo><mi>k</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mi>ψ</mi><mrow><mi>α</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>u</mi></mrow></msub><mo>−</mo><msub><mi>ψ</mi><mrow><mi>α</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>w</mi></mrow></msub></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\Omega_{\alpha}\left(u,w\right)&amp;=\sum_{k=2}^{n}\rho_{\alpha,k}^{-1}\psi_{\alpha,k,u}^{2}+\sum_{k=2}^{n}\rho_{\alpha,k}^{-1}\psi_{\alpha,k,w}^{2}-2\sum_{k=2}^{n}\rho_{\alpha,k}^{-1}\psi_{\alpha,k,u}\psi_{\alpha,k,w}\\
&amp;=\sum_{k=2}^{n}\rho_{\alpha,k}^{-1}\left(\psi_{\alpha,k,u}^{2}+\psi_{\alpha,k,w}^{2}-2\psi_{\alpha,k,u}\psi_{\left\{R,A\right\},k,w}\right)\\
&amp;=\sum_{k=2}^{n}\rho_{\alpha,k}^{-1}\left(\psi_{\alpha,k,u}-\psi_{\alpha,k,w}\right)^{2}.\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_left_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.13)</span></td></tr></tbody>
</table>
<p id="S4.p14.1" class="ltx_p"><span id="S4.p14.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="S4.Thmtheorem4" class="ltx_theorem ltx_theorem_cor">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem4.2" class="ltx_text ltx_font_bold">Corollary 4.4</span></span><span id="S4.Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem4.p1" class="ltx_para">
<p id="S4.Thmtheorem4.p1.1" class="ltx_p"><span id="S4.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmtheorem4.p1.m1" class="ltx_Math" alttext="\alpha=\{-1,1\}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha=\{-1,1\}</annotation></semantics></math> and <math id="S4.Thmtheorem4.p1.m2" class="ltx_Math" alttext="0=\rho_{\alpha,1}&lt;\rho_{\alpha,2}\leq\cdots\leq\rho_{\alpha,n}" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>=</mo><msub><mi>ρ</mi><mrow><mi>α</mi><mo>,</mo><mn>1</mn></mrow></msub><mo>&lt;</mo><msub><mi>ρ</mi><mrow><mi>α</mi><mo>,</mo><mn>2</mn></mrow></msub><mo rspace="0.1389em">≤</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">≤</mo><msub><mi>ρ</mi><mrow><mi>α</mi><mo>,</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">0=\rho_{\alpha,1}&lt;\rho_{\alpha,2}\leq\cdots\leq\rho_{\alpha,n}</annotation></semantics></math>
be the eigenvalues of <math id="S4.Thmtheorem4.p1.m3" class="ltx_Math" alttext="\mathscr{L}_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">ℒ</mi><mi>α</mi></msub><annotation encoding="application/x-tex">\mathscr{L}_{\alpha}</annotation></semantics></math>. Then,</span></p>
</div>
<div id="S4.Thmtheorem4.p2" class="ltx_para">
<table id="S4.E14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_left_padleft"></td>
<td class="ltx_eqn_cell ltx_align_left"><math id="S4.E14.m1" class="ltx_Math" alttext="\dfrac{2}{\rho_{\alpha,n}}\leq\Omega_{\alpha}\left(u,w\right)\leq\dfrac{2}{\rho_{\alpha,2}}." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mn>2</mn><msub><mi>ρ</mi><mrow><mi>α</mi><mo>,</mo><mi>n</mi></mrow></msub></mfrac><mo>≤</mo><mrow><msub><mi mathvariant="normal">Ω</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>u</mi><mo>,</mo><mi>w</mi><mo>)</mo></mrow></mrow><mo>≤</mo><mfrac><mn>2</mn><msub><mi>ρ</mi><mrow><mi>α</mi><mo>,</mo><mn>2</mn></mrow></msub></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\dfrac{2}{\rho_{\alpha,n}}\leq\Omega_{\alpha}\left(u,w\right)\leq\dfrac{2}{\rho_{\alpha,2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_left_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.14)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.p15" class="ltx_para">
<p id="S4.p15.1" class="ltx_p"><span id="S4.p15.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Using Corollary <a href="#S4.Thmtheorem3" title="Corollary 4.3. ‣ 4 Hubs-biased Resistance Distance ‣ Hubs-biased resistance distances on graphs and networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a> and the
fact that <math id="S4.p15.m1" class="ltx_Math" alttext="\rho_{\alpha,2}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">α</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></mrow></msub><annotation encoding="application/x-tex">\rho_{\alpha,2}</annotation></semantics></math> is the smallest eigenvalue of <math id="S4.p15.m2" class="ltx_Math" alttext="\mathscr{L}_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathscript" mathcolor="#000000">ℒ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">α</mi></msub><annotation encoding="application/x-tex">\mathscr{L}_{\alpha}</annotation></semantics></math>
we have the upper bound if all the eigenvalues are equal to <math id="S4.p15.m3" class="ltx_Math" alttext="\rho_{\alpha,2}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">α</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></mrow></msub><annotation encoding="application/x-tex">\rho_{\alpha,2}</annotation></semantics></math>.
The result follows from the fact that <math id="S4.p15.m4" class="ltx_Math" alttext="\sum_{k=1}^{n}\psi_{\alpha,k,u}^{2}=1" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ψ</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">α</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msubsup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><annotation encoding="application/x-tex">\sum_{k=1}^{n}\psi_{\alpha,k,u}^{2}=1</annotation></semantics></math><span id="S4.p15.1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">
and <math id="S4.p15.m5" class="ltx_Math" alttext="\sum_{k=1}^{n}\psi_{\alpha,k,u}\psi_{\alpha,k,w}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ψ</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">α</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ψ</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">α</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi></mrow></msub></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><annotation encoding="application/x-tex">\sum_{k=1}^{n}\psi_{\alpha,k,u}\psi_{\alpha,k,w}=0</annotation></semantics></math> for every
<math id="S4.p15.m6" class="ltx_Math" alttext="u\neq w" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≠</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi></mrow><annotation encoding="application/x-tex">u\neq w</annotation></semantics></math>. </span>The lower bound is obtained similarly
by the fact that <math id="S4.p15.m7" class="ltx_Math" alttext="\rho_{\alpha,n}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">α</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></mrow></msub><annotation encoding="application/x-tex">\rho_{\alpha,n}</annotation></semantics></math> is the largest eigenvalue of <math id="S4.p15.m8" class="ltx_Math" alttext="\mathscr{L}_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathscript" mathcolor="#000000">ℒ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">α</mi></msub><annotation encoding="application/x-tex">\mathscr{L}_{\alpha}</annotation></semantics></math>.<span id="S4.p15.1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">
∎</span></span></p>
</div>
</div>
<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.1 </span>Hubs-biased Kirchhoff index</h3>

<div id="S4.SS1.p1" class="ltx_para">
<p id="S4.SS1.p1.1" class="ltx_p">In full analogy with the definition of the so-called Kirchhoff index
by Klein and Randić <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib34" title="" class="ltx_ref">34</a>]</cite> we define here the hubs-biased
Kirchhoff indices of a graph.</p>
</div>
<div id="S4.Thmtheorem5" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem5.2" class="ltx_text ltx_font_bold">Definition 4.5</span></span><span id="S4.Thmtheorem5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem5.p1" class="ltx_para">
<p id="S4.Thmtheorem5.p1.1" class="ltx_p">Let <math id="S4.Thmtheorem5.p1.m1" class="ltx_Math" alttext="\alpha\in\{-1,1\}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha\in\{-1,1\}</annotation></semantics></math>. The total hubs-biased resistance distance, or <span id="S4.Thmtheorem5.p1.1.1" class="ltx_text ltx_font_italic">hubs-biased Kirchhoff index</span>, of a graph <math id="S4.Thmtheorem5.p1.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> is defined as</p>
</div>
<div id="S4.Thmtheorem5.p2" class="ltx_para">
<table id="S4.E15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_left_padleft"></td>
<td class="ltx_eqn_cell ltx_align_left"><math id="S4.E15.m1" class="ltx_Math" alttext="\mathcal{\mathscr{R}}_{\alpha}\left(G\right)=\sum_{v&lt;w}\Omega_{\alpha}\left(v,w\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathscript">ℛ</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>G</mi><mo>)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>v</mi><mo>&lt;</mo><mi>w</mi></mrow></munder><mrow><msub><mi mathvariant="normal">Ω</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>v</mi><mo>,</mo><mi>w</mi><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{\mathscr{R}}_{\alpha}\left(G\right)=\sum_{v&lt;w}\Omega_{\alpha}\left(v,w\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_left_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.15)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.Thmtheorem6" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem6.2" class="ltx_text ltx_font_bold">Lemma 4.6</span></span><span id="S4.Thmtheorem6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem6.p1" class="ltx_para">
<p id="S4.Thmtheorem6.p1.1" class="ltx_p"><span id="S4.Thmtheorem6.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmtheorem6.p1.m1" class="ltx_Math" alttext="\alpha\in\{-1,1\}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha\in\{-1,1\}</annotation></semantics></math> and <math id="S4.Thmtheorem6.p1.m2" class="ltx_Math" alttext="0=\rho_{\alpha,1}&lt;\rho_{\alpha,2}\leq\cdots\leq\rho_{\alpha,n}" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>=</mo><msub><mi>ρ</mi><mrow><mi>α</mi><mo>,</mo><mn>1</mn></mrow></msub><mo>&lt;</mo><msub><mi>ρ</mi><mrow><mi>α</mi><mo>,</mo><mn>2</mn></mrow></msub><mo rspace="0.1389em">≤</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">≤</mo><msub><mi>ρ</mi><mrow><mi>α</mi><mo>,</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">0=\rho_{\alpha,1}&lt;\rho_{\alpha,2}\leq\cdots\leq\rho_{\alpha,n}</annotation></semantics></math>
be the eigenvalues of <math id="S4.Thmtheorem6.p1.m3" class="ltx_Math" alttext="\mathscr{L}_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">ℒ</mi><mi>α</mi></msub><annotation encoding="application/x-tex">\mathscr{L}_{\alpha}</annotation></semantics></math>. Then,</span></p>
<table id="S4.E16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_left_padleft"></td>
<td class="ltx_eqn_cell ltx_align_left"><math id="S4.E16.m1" class="ltx_Math" alttext="\mathcal{\mathscr{R}}_{\alpha}\left(G\right)=n\sum_{k=2}^{n}\dfrac{1}{\rho_{\alpha,k}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathscript">ℛ</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>G</mi><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>2</mn></mrow><mi>n</mi></munderover><mfrac><mn>1</mn><msub><mi>ρ</mi><mrow><mi>α</mi><mo>,</mo><mi>k</mi></mrow></msub></mfrac></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{\mathscr{R}}_{\alpha}\left(G\right)=n\sum_{k=2}^{n}\dfrac{1}{\rho_{\alpha,k}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_left_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.16)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS1.p2" class="ltx_para">
<p id="S4.SS1.p2.1" class="ltx_p"><span id="S4.SS1.p2.1.1" class="ltx_text">Let us write the sum of the hubs-biased resistance
distances as</span></p>
<table id="S4.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_left_padleft"></td>
<td class="ltx_eqn_cell ltx_align_left"><math id="S4.Ex2.m1" class="ltx_Math" alttext="\begin{split}\dfrac{1}{2}\sum_{v,w\in V}\Omega_{\alpha}\left(u,w\right)&amp;=\dfrac{1}{2}\left({1}^{T}\textnormal{diag$\left(\mathscr{L}_{\alpha\ }^{+}\right){1}^{T}$}{1}+{1}^{T}{1}\left(\diag\left(\mathscr{L}_{\alpha}^{+}\right)\right)^{T}{1}-{1}^{T}\mathscr{L}_{\alpha}^{+}{1}-{1}^{T}\left(\mathscr{L}_{\alpha}^{+}\right)^{T}{1}\right)\\
&amp;=\dfrac{1}{2}\left(2n\textnormal{tr}\left(\mathscr{L}_{\alpha}^{+}\right)\right)\\
&amp;=n\sum_{k=2}^{n}\dfrac{1}{\rho_{\alpha,k}},\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mrow><mi>v</mi><mo>,</mo><mi>w</mi></mrow><mo>∈</mo><mi>V</mi></mrow></munder><mrow><msub><mi mathvariant="normal">Ω</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>u</mi><mo>,</mo><mi>w</mi><mo>)</mo></mrow></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><msup><mn>1</mn><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mtext>diag</mtext><mrow><mrow><mo>(</mo><msubsup><mi class="ltx_font_mathscript">ℒ</mi><mi>α</mi><mo>+</mo></msubsup><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mn>1</mn><mi>T</mi></msup></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow><mo>+</mo><mrow><msup><mn>1</mn><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>diag</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi class="ltx_font_mathscript">ℒ</mi><mi>α</mi><mo>+</mo></msubsup><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></mrow><mo>−</mo><mrow><msup><mn>1</mn><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathscript">ℒ</mi><mi>α</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow><mo>−</mo><mrow><msup><mn>1</mn><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msubsup><mi class="ltx_font_mathscript">ℒ</mi><mi>α</mi><mo>+</mo></msubsup><mo>)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mtext>tr</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi class="ltx_font_mathscript">ℒ</mi><mi>α</mi><mo>+</mo></msubsup><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>2</mn></mrow><mi>n</mi></munderover><mfrac><mn>1</mn><msub><mi>ρ</mi><mrow><mi>α</mi><mo>,</mo><mi>k</mi></mrow></msub></mfrac></mrow></mrow></mrow><mo>,</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\dfrac{1}{2}\sum_{v,w\in V}\Omega_{\alpha}\left(u,w\right)&amp;=\dfrac{1}{2}\left({1}^{T}\textnormal{diag$\left(\mathscr{L}_{\alpha\ }^{+}\right){1}^{T}$}{1}+{1}^{T}{1}\left(\diag\left(\mathscr{L}_{\alpha}^{+}\right)\right)^{T}{1}-{1}^{T}\mathscr{L}_{\alpha}^{+}{1}-{1}^{T}\left(\mathscr{L}_{\alpha}^{+}\right)^{T}{1}\right)\\
&amp;=\dfrac{1}{2}\left(2n\textnormal{tr}\left(\mathscr{L}_{\alpha}^{+}\right)\right)\\
&amp;=n\sum_{k=2}^{n}\dfrac{1}{\rho_{\alpha,k}},\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_left_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p2.2" class="ltx_p"><span id="S4.SS1.p2.2.1" class="ltx_text">where <math id="S4.SS1.p2.m1" class="ltx_Math" alttext="\textnormal{tr}\left(\mathscr{L}_{\alpha}^{+}\right)" display="inline" intent=":literal"><semantics><mrow><mtext>tr</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi class="ltx_font_mathscript">ℒ</mi><mi>α</mi><mo>+</mo></msubsup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\textnormal{tr}\left(\mathscr{L}_{\alpha}^{+}\right)</annotation></semantics></math> is
the trace of <math id="S4.SS1.p2.m2" class="ltx_Math" alttext="\mathscr{L}_{\alpha}^{+}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathscript">ℒ</mi><mi>α</mi><mo>+</mo></msubsup><annotation encoding="application/x-tex">\mathscr{L}_{\alpha}^{+}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S4.Thmtheorem7" class="ltx_theorem ltx_theorem_cor">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem7.2" class="ltx_text ltx_font_bold">Corollary 4.7</span></span><span id="S4.Thmtheorem7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem7.p1" class="ltx_para">
<p id="S4.Thmtheorem7.p1.1" class="ltx_p"><span id="S4.Thmtheorem7.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmtheorem7.p1.m1" class="ltx_Math" alttext="\alpha\in\{-1,1\}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha\in\{-1,1\}</annotation></semantics></math> and <math id="S4.Thmtheorem7.p1.m2" class="ltx_Math" alttext="0=\rho_{\alpha,1}&lt;\rho_{\alpha,2}\leq\cdots\leq\rho_{\alpha,n}" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>=</mo><msub><mi>ρ</mi><mrow><mi>α</mi><mo>,</mo><mn>1</mn></mrow></msub><mo>&lt;</mo><msub><mi>ρ</mi><mrow><mi>α</mi><mo>,</mo><mn>2</mn></mrow></msub><mo rspace="0.1389em">≤</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">≤</mo><msub><mi>ρ</mi><mrow><mi>α</mi><mo>,</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">0=\rho_{\alpha,1}&lt;\rho_{\alpha,2}\leq\cdots\leq\rho_{\alpha,n}</annotation></semantics></math>
be the eigenvalues of <math id="S4.Thmtheorem7.p1.m3" class="ltx_Math" alttext="\mathscr{L}_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">ℒ</mi><mi>α</mi></msub><annotation encoding="application/x-tex">\mathscr{L}_{\alpha}</annotation></semantics></math> for <math id="S4.Thmtheorem7.p1.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> with <math id="S4.Thmtheorem7.p1.m5" class="ltx_Math" alttext="n\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">n\geq 2</annotation></semantics></math>.
Then,</span></p>
<table id="S4.E17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_left_padleft"></td>
<td class="ltx_eqn_cell ltx_align_left"><math id="S4.E17.m1" class="ltx_Math" alttext="\dfrac{n\left(n-1\right)}{\rho_{\alpha,n}}\mathcal{\leq\mathcal{\mathscr{R}}_{\mathnormal{\alpha}}}\left(G\right)\leq\dfrac{n\left(n-1\right)}{\rho_{\alpha,2}}." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><mi>n</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow><msub><mi>ρ</mi><mrow><mi>α</mi><mo>,</mo><mi>n</mi></mrow></msub></mfrac><mo>≤</mo><mrow><msub><mi class="ltx_font_mathscript">ℛ</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>G</mi><mo>)</mo></mrow></mrow><mo>≤</mo><mfrac><mrow><mi>n</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow><msub><mi>ρ</mi><mrow><mi>α</mi><mo>,</mo><mn>2</mn></mrow></msub></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\dfrac{n\left(n-1\right)}{\rho_{\alpha,n}}\mathcal{\leq\mathcal{\mathscr{R}}_{\mathnormal{\alpha}}}\left(G\right)\leq\dfrac{n\left(n-1\right)}{\rho_{\alpha,2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_left_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.17)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.Thmtheorem8" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem8.2" class="ltx_text ltx_font_bold">Lemma 4.8</span></span><span id="S4.Thmtheorem8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem8.p1" class="ltx_para">
<p id="S4.Thmtheorem8.p1.1" class="ltx_p"><span id="S4.Thmtheorem8.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmtheorem8.p1.m1" class="ltx_Math" alttext="\alpha\in\{-1,1\}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha\in\{-1,1\}</annotation></semantics></math>. Then</span></p>
<table id="S4.E18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_left_padleft"></td>
<td class="ltx_eqn_cell ltx_align_left"><math id="S4.E18.m1" class="ltx_Math" alttext="\mathcal{\mathcal{\mathscr{R}}_{\mathnormal{\alpha}}}\left(G\right)\geq n-1," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathscript">ℛ</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>G</mi><mo>)</mo></mrow></mrow><mo>≥</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{\mathcal{\mathscr{R}}_{\mathnormal{\alpha}}}\left(G\right)\geq n-1,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_left_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.18)</span></td></tr></tbody>
</table>
<p id="S4.Thmtheorem8.p1.2" class="ltx_p"><span id="S4.Thmtheorem8.p1.2.1" class="ltx_text ltx_font_italic">with equality if and only if <math id="S4.Thmtheorem8.p1.m2" class="ltx_Math" alttext="G=K_{n}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><msub><mi>K</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">G=K_{n}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS1.p3" class="ltx_para">
<p id="S4.SS1.p3.1" class="ltx_p"><span id="S4.SS1.p3.1.1" class="ltx_text">Let <math id="S4.SS1.p3.m1" class="ltx_Math" alttext="\mathcal{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">\mathcal{S}</annotation></semantics></math> be the set of all column vectors <math id="S4.SS1.p3.m2" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> such that
<math id="S4.SS1.p3.m3" class="ltx_Math" alttext="x\cdot x=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>x</mi></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">x\cdot x=1</annotation></semantics></math>, <math id="S4.SS1.p3.m4" class="ltx_Math" alttext="x\cdot e" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>e</mi></mrow><annotation encoding="application/x-tex">x\cdot e</annotation></semantics></math>= 0. Then, it is known that</span></p>
</div>
<div id="S4.SS1.p4" class="ltx_para">
<table id="S4.E19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_left_padleft"></td>
<td class="ltx_eqn_cell ltx_align_left"><math id="S4.E19.m1" class="ltx_Math" alttext="\rho_{\alpha,2}=\min_{x\in S}x^{T}\mathscr{L}_{\alpha}x." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ρ</mi><mrow><mi>α</mi><mo>,</mo><mn>2</mn></mrow></msub><mo>=</mo><mrow><mrow><munder><mi>min</mi><mrow><mi>x</mi><mo>∈</mo><mi>S</mi></mrow></munder><mo lspace="0.167em">⁡</mo><msup><mi>x</mi><mi>T</mi></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">ℒ</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\rho_{\alpha,2}=\min_{x\in S}x^{T}\mathscr{L}_{\alpha}x.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_left_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.19)</span></td></tr></tbody>
</table>
<p id="S4.SS1.p4.1" class="ltx_p"><span id="S4.SS1.p4.1.1" class="ltx_text">Then, we can show that the matrix <math id="S4.SS1.p4.m1" class="ltx_Math" alttext="\mathscr{\tilde{L}}_{\alpha}\coloneqq\mathscr{L}_{\alpha}-\rho_{\alpha,2}\left(I_{n}-n^{-1}J_{n}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathscript">ℒ</mi><mo>~</mo></mover><mi>α</mi></msub><mo>≔</mo><mrow><msub><mi class="ltx_font_mathscript">ℒ</mi><mi>α</mi></msub><mo>−</mo><mrow><msub><mi>ρ</mi><mrow><mi>α</mi><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>I</mi><mi>n</mi></msub><mo>−</mo><mrow><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>J</mi><mi>n</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathscr{\tilde{L}}_{\alpha}\coloneqq\mathscr{L}_{\alpha}-\rho_{\alpha,2}\left(I_{n}-n^{-1}J_{n}\right)</annotation></semantics></math>
is also positive semidefinite. Since <math id="S4.SS1.p4.m2" class="ltx_Math" alttext="\mathscr{\tilde{L}}_{\alpha}e=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathscript">ℒ</mi><mo>~</mo></mover><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathscr{\tilde{L}}_{\alpha}e=0</annotation></semantics></math>
we have</span></p>
</div>
<div id="S4.SS1.p5" class="ltx_para">
<table id="S4.E20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_left_padleft"></td>
<td class="ltx_eqn_cell ltx_align_left"><math id="S4.E20.m1" class="ltx_Math" alttext="y^{T}\mathscr{\tilde{L}}_{\alpha}y=c_{2}^{2}x^{T}\mathscr{\tilde{L}}_{\alpha}x=c_{2}^{2}\left(x^{T}\mathscr{L}_{\alpha}x-\rho_{\alpha,2}\right)\geq 0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>y</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi class="ltx_font_mathscript">ℒ</mi><mo>~</mo></mover><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo>=</mo><mrow><msubsup><mi>c</mi><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi class="ltx_font_mathscript">ℒ</mi><mo>~</mo></mover><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>=</mo><mrow><msubsup><mi>c</mi><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msup><mi>x</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">ℒ</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>−</mo><msub><mi>ρ</mi><mrow><mi>α</mi><mo>,</mo><mn>2</mn></mrow></msub></mrow><mo>)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">y^{T}\mathscr{\tilde{L}}_{\alpha}y=c_{2}^{2}x^{T}\mathscr{\tilde{L}}_{\alpha}x=c_{2}^{2}\left(x^{T}\mathscr{L}_{\alpha}x-\rho_{\alpha,2}\right)\geq 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_left_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.20)</span></td></tr></tbody>
</table>
<p id="S4.SS1.p5.1" class="ltx_p"><span id="S4.SS1.p5.1.1" class="ltx_text">Thus</span></p>
</div>
<div id="S4.SS1.p6" class="ltx_para">
<table id="S4.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_left_padleft"></td>
<td class="ltx_eqn_cell ltx_align_left"><math id="S4.E21.m1" class="ltx_Math" alttext="\min_{v}\mathscr{L}_{\alpha}\left(v,v\right)-\rho_{\alpha,2}\left(1-n^{-1}\right)\geq 0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><munder><mi>min</mi><mi>v</mi></munder><mo lspace="0.167em">⁡</mo><msub><mi class="ltx_font_mathscript">ℒ</mi><mi>α</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>v</mi><mo>,</mo><mi>v</mi><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>ρ</mi><mrow><mi>α</mi><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>)</mo></mrow></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\min_{v}\mathscr{L}_{\alpha}\left(v,v\right)-\rho_{\alpha,2}\left(1-n^{-1}\right)\geq 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_left_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.21)</span></td></tr></tbody>
</table>
<p id="S4.SS1.p6.1" class="ltx_p"><span id="S4.SS1.p6.1.1" class="ltx_text">We can then write,</span></p>
</div>
<div id="S4.SS1.p7" class="ltx_para">
<table id="S4.E22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_left_padleft"></td>
<td class="ltx_eqn_cell ltx_align_left"><math id="S4.E22.m1" class="ltx_Math" alttext="\rho_{\alpha,2}\leq\dfrac{n}{n-1}\min_{v}\mathscr{L}_{\alpha}\left(v,v\right)." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ρ</mi><mrow><mi>α</mi><mo>,</mo><mn>2</mn></mrow></msub><mo>≤</mo><mrow><mfrac><mi>n</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mfrac><mo lspace="0.167em" rspace="0em">​</mo><munder><mi>min</mi><mi>v</mi></munder><mo lspace="0.167em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">ℒ</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>v</mi><mo>,</mo><mi>v</mi><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\rho_{\alpha,2}\leq\dfrac{n}{n-1}\min_{v}\mathscr{L}_{\alpha}\left(v,v\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_left_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.22)</span></td></tr></tbody>
</table>
</div>
<div id="S4.SS1.p8" class="ltx_para">
<p id="S4.SS1.p8.1" class="ltx_p"><span id="S4.SS1.p8.1.1" class="ltx_text">Now, because <math id="S4.SS1.p8.m1" class="ltx_Math" alttext="\min_{v}\mathscr{L}_{\alpha}\left(v,v\right)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>min</mi><mi>v</mi></msub><mo lspace="0.167em">⁡</mo><msub><mi class="ltx_font_mathscript">ℒ</mi><mi>α</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>v</mi><mo>,</mo><mi>v</mi><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\min_{v}\mathscr{L}_{\alpha}\left(v,v\right)</annotation></semantics></math> cannot
be larger than <math id="S4.SS1.p8.m2" class="ltx_Math" alttext="\varDelta/\delta\leq n-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo>/</mo><mi>δ</mi></mrow><mo>≤</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\varDelta/\delta\leq n-1</annotation></semantics></math> we have that <math id="S4.SS1.p8.m3" class="ltx_Math" alttext="\rho_{\alpha,2}\leq n" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mrow><mi>α</mi><mo>,</mo><mn>2</mn></mrow></msub><mo>≤</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">\rho_{\alpha,2}\leq n</annotation></semantics></math>
and then using the result in Corollary <a href="#S4.Thmtheorem7" title="Corollary 4.7. ‣ 4.1 Hubs-biased Kirchhoff index ‣ 4 Hubs-biased Resistance Distance ‣ Hubs-biased resistance distances on graphs and networks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.7</span></a> we have
<math id="S4.SS1.p8.m4" class="ltx_Math" alttext="\mathcal{\mathcal{\mathscr{R}}_{\mathnormal{\alpha}}}\left(G\right)\geq n-1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathscript">ℛ</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>G</mi><mo>)</mo></mrow></mrow><mo>≥</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\mathcal{\mathcal{\mathscr{R}}_{\mathnormal{\alpha}}}\left(G\right)\geq n-1</annotation></semantics></math>.
The equality is obtained only for the case of the complete graph where
<math id="S4.SS1.p8.m5" class="ltx_Math" alttext="\rho_{\alpha,k\neq 2}=n-1" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mrow><mrow><mi>α</mi><mo>,</mo><mi>k</mi></mrow><mo>≠</mo><mn>2</mn></mrow></msub><mo>=</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\rho_{\alpha,k\neq 2}=n-1</annotation></semantics></math>, which proves the final result.
∎</span></p>
</div>
</div>
<div id="S4.SS1.p9" class="ltx_para">
<p id="S4.SS1.p9.1" class="ltx_p">We now obtain some bounds for the Kirchhoff index for <math id="S4.SS1.p9.m1" class="ltx_Math" alttext="\alpha=1" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\alpha=1</annotation></semantics></math>
and <math id="S4.SS1.p9.m2" class="ltx_Math" alttext="\alpha=-1" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\alpha=-1</annotation></semantics></math>, respectively.
(As usual, in the following <math id="S4.SS1.p9.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> denotes the number of vertices of <math id="S4.SS1.p9.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>, while <math id="S4.SS1.p9.m5" class="ltx_Math" alttext="\delta,\varDelta" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>,</mo><mi mathvariant="normal">Δ</mi></mrow><annotation encoding="application/x-tex">\delta,\varDelta</annotation></semantics></math> are its smallest and largest degree, respectively.)</p>
</div>
<div id="S4.Thmtheorem9" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem9.2" class="ltx_text ltx_font_bold">Lemma 4.9</span></span><span id="S4.Thmtheorem9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem9.p1" class="ltx_para">
<p id="S4.Thmtheorem9.p1.1" class="ltx_p"><span id="S4.Thmtheorem9.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmtheorem9.p1.m1" class="ltx_Math" alttext="\alpha\in\{-1,1\}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha\in\{-1,1\}</annotation></semantics></math>. Then</span></p>
<table id="S4.E23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_left_padleft"></td>
