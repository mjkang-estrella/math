and {<I>x</I><SUB><FONT SIZE=2>{1,2}</FONT></SUB>, ..., <I>x</I><SUB><FONT SIZE=2>{<I>n</I>-1,<I>n</I>}</FONT></SUB>} be a set of (<TABLE CELLSPACING=2 CELLPADDING=0>
