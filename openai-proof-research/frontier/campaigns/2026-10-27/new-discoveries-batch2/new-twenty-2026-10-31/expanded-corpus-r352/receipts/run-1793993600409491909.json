    "parser_code = r'''from html.parser import HTMLParser\nclass Parser(HTMLParser):\n def __init__(self):super().__init__();self.out=[];self.skip=0\n def handle_starttag(self,t,a):\n  d=dict(a)\n  if t==\"math\":self.out.append(\" \"+d.get(\"alttext\",\"\")+\" \");self.skip+=1\n  elif t in [\"script\",\"style\"]:self.skip+=1\n  elif t==\"img\":self.out.append(\" [image: \"+d.get(\"alt\",\"\")+\" src=\"+(d.get(\"src\",\"\")[:200] if not d.get(\"src\",\"\").startswith(\"data:\") else \"embedded\")+\"] \")\n  elif t in [\"p\",\"div\",\"section\",\"h1\",\"h2\",\"h3\",\"li\",\"tr\"]:self.out.append(\"\\n\")\n def handle_endtag(self,t):\n  if t in [\"math\",\"script\",\"style\"]:self.skip=max(0,self.skip-1)\n def handle_data(self,d):\n  if not self.skip:self.out.append(d)\ndef parse(b):\n h=Parser();h.feed(b.decode());return \"\\n\".join(x.strip() for x in \"\".join(h.out).splitlines() if x.strip())\n'''\nput(\"parser.py\",parser_code)\nexec(parser_code)\nfor f in sorted((P/\"sources\").glob(\"*.html\")):\n if \"v\" in f.stem or f.stem in [\"tangled-journal\",\"clique-thesis-page\"]:\n  s=parse(read(f));put(\"texts/\"+f.stem+\".txt\",s)\nfor a,t in [(\"2402.18509v4\",\"Conjecture\"),(\"2503.11676v3\",\"sign\"),(\"2602.04610v2\",\"Conjecture\"),(\"2306.17388v2\",\"transcend\"),(\"2602.21526v1\",\"Conjecture\")]:\n s=read(P/\"texts\"/(a+\".txt\")).decode().split(\"Experimental support\")[0]; print(\"SOURCE\",a)\n for m in list(re.finditer(t,s,re.I))[:3]:print(s[max(0,m.start()-100):m.start()+1000])\ns=read(P/\"texts/tangled-journal.txt\").decode()\nfor t in [\"Corollary 4.8\",\"Lemma 4.6\",\"Published online\"]:\n m=s.find(t);print(t,s[m:m+1600])\n"
