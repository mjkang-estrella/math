def sampleValue (s g : ℕ) : ℤ :=
  match s with
  | 0 => value0 g
  | 1 => value1 g
  | 2 => value2 g
  | 3 => value3 g
  | 4 => value4 g
  | 5 => value5 g
  | 6 => value6 g
  | 7 => value7 g
  | 8 => value8 g
  | 9 => value9 g
  | 10 => value10 g
  | 11 => value11 g
  | 12 => value12 g
  | 13 => value13 g
  | 14 => value14 g
  | 15 => value15 g
  | 16 => value16 g
  | 17 => value17 g
  | 18 => value18 g
  | 19 => value19 g
  | 20 => value20 g
  | _ => 0
def monValue (s : ℕ) (m : List ℕ) : ℤ := m.foldr (fun i a => sampleValue s i * a) 1
