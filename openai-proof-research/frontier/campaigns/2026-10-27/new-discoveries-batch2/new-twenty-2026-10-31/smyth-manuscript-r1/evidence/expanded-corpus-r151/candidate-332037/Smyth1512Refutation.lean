import Mathlib

namespace Smyth1512

open Finset

/-! ## Literal definitions (Smyth §1) -/

/-- `U m n`: compositions of `n` with `m` non-negative parts, i.e. `λ : [m] → ℕ` with `|λ| = n`. -/
def U (m n : ℕ) : Set (Fin m → ℕ) := {f | ∑ i, f i = n}

/-- Non-increasing rearrangement of a composition (its associated partition), as a list. -/
def rearr {m : ℕ} (f : Fin m → ℕ) : List ℕ :=
  (List.ofFn f).insertionSort (fun x y => y ≤ x)

/-- Partial sum of the first `j` entries (entries beyond the length count as `0`). -/
def psum (l : List ℕ) (j : ℕ) : ℕ := (l.take j).sum

/-- Dominance of partitions given as lists: `l₁ ⊵ l₂` iff `|l₁| = |l₂|` and every partial sum
of `l₂` is at most the corresponding partial sum of `l₁` (Smyth: `λ ⊴ μ` iff `|λ| = |μ|` and
`∑_{i≤j} λ(i) ≤ ∑_{i≤j} μ(i)` for all `j`). -/
def DomL (l₁ l₂ : List ℕ) : Prop := l₁.sum = l₂.sum ∧ ∀ j : ℕ, psum l₂ j ≤ psum l₁ j

/-- Smyth's dominance on compositions: `f ⊵ g` iff `f_p ⊵ g_p` for the non-increasing
rearrangements. -/
def Dom {m : ℕ} (f g : Fin m → ℕ) : Prop := DomL (rearr f) (rearr g)

/-- Concatenation `λμ` of `λ ∈ U^A` and `μ ∈ U^B`. -/
def concat {A B : ℕ} (f : Fin A → ℕ) (g : Fin B → ℕ) : Fin (A + B) → ℕ := Fin.append f g

/-- Smyth, Conjecture 1.5 (literal): for all `A ≥ B ≥ 0`, `a ≥ b ≥ 0` there is an injection
`γ : U^A_b × U^B_a ↪ U^A_a × U^B_b` with `λ₁μ₁ ⊵ λ₂μ₂` whenever `(λ₂,μ₂) = γ(λ₁,μ₁)`. -/
def Conjecture15 : Prop :=
  ∀ A a B b : ℕ, B ≤ A → b ≤ a →
    ∃ γ : (U A b × U B a) → (U A a × U B b), Function.Injective γ ∧
      ∀ x : U A b × U B a, Dom (concat x.1.1 x.2.1) (concat (γ x).1.1 (γ x).2.1)

/-! ## Certificate data -/

def gens : List (List ℕ) :=
  [[13,12,8,4,2],[13,13,7,3,3],[12,12,8,6,1],[14,12,6,4,3],
   [13,11,7,7,1],[14,11,6,6,2],[15,11,5,5,3],[16,10,5,4,4]]

/-- Boolean dominance test, exact for lists of length 5 (prefixes of length `0..5`). -/
def domB (g l : List ℕ) : Bool :=
  (g.sum == l.sum) && (List.range 6).all (fun j => decide (psum l j ≤ psum g j))

def inDB (l : List ℕ) : Bool := gens.any (fun g => domB g l)

def sortL (l : List ℕ) : List ℕ := l.insertionSort (fun x y => y ≤ x)

/-- Structural enumeration of compositions of `n` into `m` non-negative parts. -/
def comps : ℕ → ℕ → List (List ℕ)
  | 0, n => if n = 0 then [[]] else []
  | m + 1, n => (List.range (n + 1)).flatMap (fun i => (comps m (n - i)).map (List.cons i))

def XL : List (List ℕ × List ℕ) := (comps 3 19) ×ˢ (comps 2 20)
def YL : List (List ℕ × List ℕ) := (comps 3 20) ×ˢ (comps 2 19)
def SL : List (List ℕ × List ℕ) := XL.filter (fun p => inDB (sortL (p.1 ++ p.2)))
def TL : List (List ℕ × List ℕ) := YL.filter (fun p => inDB (sortL (p.1 ++ p.2)))

/-! ## Kernel computations (the only `decide`s) -/

theorem SL_length : SL.length = 1137 := by decide
theorem TL_length : TL.length = 1134 := by decide
theorem gens_length : ∀ g ∈ gens, g.length = 5 := by decide

/-! ## Enumerator lemmas -/

theorem mem_comps : ∀ (m n : ℕ) (l : List ℕ), l ∈ comps m n ↔ l.length = m ∧ l.sum = n := by
  intro m
  induction m with
  | zero =>
    intro n l
    cases l with
    | nil => simp [comps, eq_comm]
    | cons x xs => simp [comps]
  | succ m ih =>
    intro n l
    cases l with
    | nil => simp [comps]
    | cons x xs =>
      simp only [comps, List.mem_flatMap, List.mem_range, List.mem_map, List.cons.injEq,
        List.length_cons, List.sum_cons, Nat.add_right_cancel_iff]
      constructor
      · rintro ⟨i, hi, ys, hys, rfl, rfl⟩
        rw [ih] at hys
        exact ⟨hys.1, by omega⟩
      · rintro ⟨hlen, hsum⟩
        exact ⟨x, by omega, xs, (ih _ _).2 ⟨hlen, by omega⟩, rfl, rfl⟩

theorem nodup_comps : ∀ (m n : ℕ), (comps m n).Nodup := by
  intro m
  induction m with
  | zero => intro n; by_cases h : n = 0 <;> simp [comps, h]
  | succ m ih =>
    intro n
    simp only [comps]
    rw [List.nodup_flatMap]
    refine ⟨fun i _ => (ih _).map (fun a b h => List.cons_injective h), ?_⟩
    refine List.Pairwise.imp_of_mem ?_ (List.nodup_range (n + 1))
    intro i j _ _ hij
    rw [List.disjoint_left]
    intro l hl hl'
    simp only [List.mem_map] at hl hl'
    obtain ⟨_, _, rfl⟩ := hl
    obtain ⟨_, _, h⟩ := hl'
    exact hij (List.cons.inj h).1.symm

theorem SL_nodup : SL.Nodup :=
  ((nodup_comps 3 19).product (nodup_comps 2 20)).filter _

/-! ## Dominance lemmas -/

theorem DomL.trans {l₁ l₂ l₃ : List ℕ} (h₁ : DomL l₁ l₂) (h₂ : DomL l₂ l₃) : DomL l₁ l₃ :=
  ⟨h₁.1.trans h₂.1, fun j => (h₂.2 j).trans (h₁.2 j)⟩

theorem psum_of_ge {l : List ℕ} {j : ℕ} (h : l.length ≤ j) : psum l j = l.sum := by
  simp [psum, List.take_of_length_le h]

theorem domB_iff {g l : List ℕ} (hg : g.length = 5) (hl : l.length = 5) :
    domB g l = true ↔ DomL g l := by
  unfold domB DomL
  simp only [Bool.and_eq_true, beq_iff_eq, List.all_eq_true, List.mem_range, decide_eq_true_eq]
  constructor
  · rintro ⟨hs, hj⟩
    refine ⟨hs, fun j => ?_⟩
    by_cases hj5 : j < 6
    · exact hj j hj5
    · rw [psum_of_ge (by omega), psum_of_ge (by omega)]; exact hs ▸ le_rfl
  · rintro ⟨hs, hj⟩
    exact ⟨hs, fun j _ => hj j⟩

theorem length_sortL (l : List ℕ) : (sortL l).length = l.length :=
  List.length_insertionSort _ _

theorem inDB_mono {l l' : List ℕ} (hl : l.length = 5) (hl' : l'.length = 5)
    (h : inDB l = true) (hd : DomL l l') : inDB l' = true := by
  unfold inDB at *
  rw [List.any_eq_true] at *
  obtain ⟨g, hg, hgl⟩ := h
  refine ⟨g, hg, ?_⟩
  have h5 := gens_length g hg
  exact (domB_iff h5 hl').2 (((domB_iff h5 hl).1 hgl).trans hd)

theorem rearr_concat {A B : ℕ} (f : Fin A → ℕ) (g : Fin B → ℕ) :
    rearr (concat f g) = sortL (List.ofFn f ++ List.ofFn g) := by
  simp [rearr, sortL, concat, List.ofFn_fin_append]

/-! ## Realisation of enumerated lists as compositions -/

def toFun (k : ℕ) (l : List ℕ) : Fin k → ℕ := fun i => l.getD i 0

theorem ofFn_toFun {k : ℕ} {l : List ℕ} (h : l.length = k) : List.ofFn (toFun k l) = l := by
  subst h
  apply List.ext_getElem (by simp)
  intro i h1 h2
  simp [toFun, List.getD_eq_getElem _ _ h2]

theorem sum_toFun {k : ℕ} {l : List ℕ} (h : l.length = k) : ∑ i, toFun k l i = l.sum := by
  rw [← List.sum_ofFn, ofFn_toFun h]

/-! ## Main theorem -/

theorem not_conjecture15 : ¬ Conjecture15 := by
  intro hC
  obtain ⟨γ, hinj, hdom⟩ := hC 3 20 2 19 (by norm_num) (by norm_num)
  -- list image of an element of U^A_a × U^B_b
  let toL : ∀ {A a B b : ℕ}, (U A a × U B b) → List ℕ × List ℕ :=
    fun y => (List.ofFn y.1.1, List.ofFn y.2.1)
  have toL_inj : ∀ {A a B b : ℕ} (y y' : U A a × U B b), toL y = toL y' → y = y' := by
    intro A a B b y y' h
    simp only [toL, Prod.mk.injEq] at h
    exact Prod.ext (Subtype.ext (List.ofFn_injective h.1)) (Subtype.ext (List.ofFn_injective h.2))
  -- realisation of members of XL
  have real : ∀ p ∈ XL, ∃ x : U 3 19 × U 2 20, toL x = p := by
    intro p hp
    simp only [XL, List.mem_product, mem_comps] at hp
    obtain ⟨⟨h1l, h1s⟩, ⟨h2l, h2s⟩⟩ := hp
    refine ⟨(⟨toFun 3 p.1, by simp [U, sum_toFun h1l, h1s]⟩,
             ⟨toFun 2 p.2, by simp [U, sum_toFun h2l, h2s]⟩), ?_⟩
    simp [toL, ofFn_toFun h1l, ofFn_toFun h2l]
  classical
  -- the comparison map on lists
  let ψ : List ℕ × List ℕ → List ℕ × List ℕ := fun p =>
    if h : p ∈ XL then toL (γ (Classical.choose (real p h))) else ([], [])
  have hψ : ∀ p (h : p ∈ XL), ψ p = toL (γ (Classical.choose (real p h))) := by
    intro p h; simp [ψ, h]
  have maps : ∀ p ∈ SL.toFinset, ψ p ∈ TL.toFinset := by
    intro p hp
    rw [List.mem_toFinset, SL, List.mem_filter] at hp
    obtain ⟨hpX, hpD⟩ := hp
    set x := Classical.choose (real p hpX) with hx
    have hxp : toL x = p := Classical.choose_spec (real p hpX)
    rw [hψ p hpX, ← hx, List.mem_toFinset, TL, List.mem_filter]
    have hlenx : (sortL (p.1 ++ p.2)).length = 5 := by
      simp only [XL, List.mem_product, mem_comps] at hpX
      rw [length_sortL, List.length_append, hpX.1.1, hpX.2.1]
    have hleny : (sortL ((toL (γ x)).1 ++ (toL (γ x)).2)).length = 5 := by
      simp [toL, length_sortL]
    refine ⟨?_, ?_⟩
    · simp only [YL, List.mem_product, mem_comps, toL, List.length_ofFn, List.sum_ofFn]
      exact ⟨⟨rfl, (γ x).1.2⟩, ⟨rfl, (γ x).2.2⟩⟩
    · have hd := hdom x
      unfold Dom at hd
      rw [rearr_concat, rearr_concat] at hd
      have hxp1 : List.ofFn x.1.1 = p.1 := congrArg Prod.fst hxp
      have hxp2 : List.ofFn x.2.1 = p.2 := congrArg Prod.snd hxp
      rw [hxp1, hxp2] at hd
      exact inDB_mono hlenx hleny hpD hd
  have injOn : Set.InjOn ψ (SL.toFinset : Set (List ℕ × List ℕ)) := by
    intro p hp q hq hpq
    simp only [Finset.mem_coe, List.mem_toFinset, SL, List.mem_filter] at hp hq
    rw [hψ p hp.1, hψ q hq.1] at hpq
    have := hinj (toL_inj _ _ hpq)
    rw [← Classical.choose_spec (real p hp.1), ← Classical.choose_spec (real q hq.1), this]
  have hcard := Finset.card_le_card_of_injOn ψ maps injOn
  rw [List.toFinset_card_of_nodup SL_nodup, SL_length] at hcard
  have hT : TL.toFinset.card ≤ 1134 := TL_length ▸ List.toFinset_card_le TL
  omega

end Smyth1512
