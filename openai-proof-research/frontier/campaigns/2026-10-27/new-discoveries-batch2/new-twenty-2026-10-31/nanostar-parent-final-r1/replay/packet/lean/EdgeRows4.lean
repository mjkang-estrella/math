import Certificate
namespace R162
set_option maxRecDepth 100000
set_option maxHeartbeats 0
theorem row_44 : ∀ j : Fin 88,
 (treeGraph (nanostar 4)).Adj (44 : Fin 88) j ↔
 (44 : Fin 88) ≠ j ∧ (next (44 : Fin 88) = j ∨ next j = (44 : Fin 88)) := by
 change ∀ j : Fin 88,
   ((44 : Fin 88) ≠ j ∧ ((44,j.val) ∈ edges (nanostar 4) ∨ (j.val,44) ∈ edges (nanostar 4))) ↔
   (44 : Fin 88) ≠ j ∧ (next (44 : Fin 88) = j ∨ next j = (44 : Fin 88))
 decide
