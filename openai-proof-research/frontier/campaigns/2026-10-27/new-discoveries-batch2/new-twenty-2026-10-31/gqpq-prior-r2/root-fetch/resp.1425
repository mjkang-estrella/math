  <entry>
    <id>http://arxiv.org/abs/1910.08631v1</id>
    <title>Extension of a residually finite group by a residually finite group is weakly sofic</title>
    <updated>2019-10-18T21:10:04Z</updated>
    <link href="https://arxiv.org/abs/1910.08631v1" rel="alternate" type="text/html"/>
    <link href="https://arxiv.org/pdf/1910.08631v1" rel="related" type="application/pdf" title="pdf"/>
    <summary>We show that residually finite by residually finite extensions are weakly sofic.</summary>
