@article{ELIZALDE2003110,
title = "Consecutive patterns in permutations",
journal = "Advances in Applied Mathematics",
volume = "30",
number = "1",
pages = "110 - 125",
year = "2003",
issn = "0196-8858",
doi = "https://doi.org/10.1016/S0196-8858(02)00527-4",
url = "http://www.sciencedirect.com/science/article/pii/S0196885802005274",
author = "Sergi Elizalde and Marc Noy",
abstract = "In this paper we study the distribution of the number of occurrences of a permutation σ as a subword among all permutations in Sn. We solve the problem in several cases depending on the shape of σ by obtaining the corresponding bivariate exponential generating functions as solutions of certain linear differential equations with polynomial coefficients. Our method is based on the representation of permutations as increasing binary trees and on symbolic methods."
}

