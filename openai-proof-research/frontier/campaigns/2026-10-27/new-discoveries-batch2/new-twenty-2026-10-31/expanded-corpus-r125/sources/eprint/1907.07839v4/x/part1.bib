@ARTICLE{SZ2019,
  title = "Ramanujan graphs and exponential sums over function fields",
journal = "Journal of Number Theory",
volume = "217",
pages = "44 - 77",
year = "2020",
issn = "0022-314X",
doi = "https://doi.org/10.1016/j.jnt.2020.05.010",
url = "http://www.sciencedirect.com/science/article/pii/S0022314X20301645",
author = "N.T. Sardari and M. Zargar",
keywords = "Ramanujan graphs, Optimal diameter, Quadratic forms, (Optimal) strong approximation, Function fields, Exponential sums, Stationary phase over function fields, Kloosterman sums, Linnik-Selberg, Morgenstern",
abstract = "We prove that q+1-regular Morgenstern Ramanujan graphs Xq,g (depending on g∈Fq[t]) have diameter at most (43+ε)logq⁡|Xq,g|+Oε(1) (at least for odd q and irreducible g) provided that a twisted Linnik–Selberg conjecture over Fq(t) is true. This would break the 30 year-old upper bound of 2logq⁡|Xq,g|+O(1), a consequence of a well-known upper bound on the diameter of regular Ramanujan graphs proved by Lubotzky, Phillips, and Sarnak using the Ramanujan bound on Fourier coefficients of modular forms. We also unconditionally construct infinite families of Ramanujan graphs that prove that 43 cannot be improved."
}

