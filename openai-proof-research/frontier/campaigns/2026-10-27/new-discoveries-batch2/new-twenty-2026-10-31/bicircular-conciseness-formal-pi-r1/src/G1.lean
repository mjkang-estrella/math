import Mathlib.Logic.Relation
import Mathlib.Data.Finset.Basic
import Mathlib.Data.Finset.Sort

/-!
Finite edge-indexed undirected graphs with loops, and component combinatorics.
Everything is Prop-level or cardinal-level; no computability requirements.
-/
namespace Bicir

open Relation
open Classical

/-- A finite graph: `v` vertices `0..v-1`, `m` edges `0..m-1`, endpoint map.
Loops are `(x,x)`; parallel edges are distinct indices. -/
structure Gr where
  v : ℕ
  m : ℕ
  ep : Fin m → Fin v × Fin v

variable {g : Gr}

/-- Undirected adjacency generated by edge set `F` (loops give reflexive pairs only). -/
def Adj (g : Gr) (F : Finset (Fin g.m)) (x y : Fin g.v) : Prop :=
  ∃ e ∈ F, ((g.ep e).1 = x ∧ (g.ep e).2 = y) ∨ ((g.ep e).1 = y ∧ (g.ep e).2 = x)

theorem Adj_symm (g : Gr) (F : Finset (Fin g.m)) (x y : Fin g.v)
    (h : Adj g F x y) : Adj g F y x := by
  obtain ⟨e, he, hx | hy⟩ := h
  · exact ⟨e, he, Or.inr ⟨hx.1, hx.2⟩⟩
  · exact ⟨e, he, Or.inl ⟨hy.1, hy.2⟩⟩

-- component of x w.r.t. F
noncomputable def cmp (g : Gr) (F : Finset (Fin g.m)) (x : Fin g.v) : Finset (Fin g.v) :=
  Finset.univ.filter fun y => ReflTransGen (Adj g F) x y

/-- Number of edges of `F` with both endpoints in `T`. -/
noncomputable def eIn (g : Gr) (F : Finset (Fin g.m)) (T : Finset (Fin g.v)) : ℕ :=
  (F.filter fun e => (g.ep e).1 ∈ T ∧ (g.ep e).2 ∈ T).card

theorem mem_cmp {g : Gr} {F : Finset (Fin g.m)} {x y : Fin g.v} :
    y ∈ cmp g F x ↔ ReflTransGen (Adj g F) x y := Finset.mem_filter.trans ⟨
    fun h => h.2, fun h => ⟨Finset.mem_univ _, h⟩⟩

theorem edge_conn {g : Gr} {F : Finset (Fin g.m)} {e : Fin g.m} (he : e ∈ F) :
    ReflTransGen (Adj g F) (g.ep e).1 (g.ep e).2 := by
  exact ReflTransGen.single ⟨e, he, Or.inl ⟨rfl, rfl⟩⟩

theorem rtg_symm {g : Gr} {F : Finset (Fin g.m)} {x y : Fin g.v}
    (h : ReflTransGen (Adj g F) x y) : ReflTransGen (Adj g F) y x := by
  induction h with
  | refl => exact ReflTransGen.refl
  | tail hab hstep ih =>
    exact ReflTransGen.trans (ReflTransGen.single (Adj_symm _ _ _ _ hstep)) ih

theorem edge_same_comp {g : Gr} {F : Finset (Fin g.m)} {e : Fin g.m} (he : e ∈ F)
    (x : Fin g.v) (h : (g.ep e).1 ∈ cmp g F x) : (g.ep e).2 ∈ cmp g F x := by
  rw [mem_cmp] at h ⊢
  exact ReflTransGen.trans h (edge_conn he)

theorem cmp_sub_of_rtg {g : Gr} {F : Finset (Fin g.m)} {x y : Fin g.v}
    (h : ReflTransGen (Adj g F) x y) : cmp g F x ⊆ cmp g F y := by
  intro z hz
  rw [mem_cmp] at hz ⊢
  exact ReflTransGen.trans (rtg_symm h) hz

theorem cmp_eq_of_rtg {g : Gr} {F : Finset (Fin g.m)} {x y : Fin g.v}
    (h : ReflTransGen (Adj g F) x y) : cmp g F x = cmp g F y :=
  Finset.ext fun _z => ⟨fun hz => cmp_sub_of_rtg h hz, fun hz => cmp_sub_of_rtg (rtg_symm h) hz⟩

theorem cmp_refl {g : Gr} {F : Finset (Fin g.m)} (x : Fin g.v) : x ∈ cmp g F x := by
  rw [mem_cmp]

end Bicir
