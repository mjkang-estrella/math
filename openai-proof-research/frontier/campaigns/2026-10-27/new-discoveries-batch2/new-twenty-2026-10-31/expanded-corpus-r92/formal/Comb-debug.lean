abbrev Vertex (n m : ℕ) := Fin n × Fin m
-- First coordinate indexes teeth; zero in the second coordinate is the spine.
def adj {n m} (u v : Vertex n m) : Prop :=
  (u.1 = v.1 ∧ Nat.dist u.2.val v.2.val = 1) ∨
  (u.2.val = 0 ∧ v.2.val = 0 ∧ Nat.dist u.1.val v.1.val = 1)
instance {n m} : DecidableRel (@adj n m) := fun _ _ => inferInstanceAs (Decidable (_ ∨ _))
def graph (n m : ℕ) : SimpleGraph (Vertex n m) where
  Adj := adj
  symm := ⟨by
    intro u v h
    rcases h with h | h
    · exact Or.inl ⟨h.1.symm, by simpa [Nat.dist_comm] using h.2⟩
    · exact Or.inr ⟨h.2.1,h.1,by simpa [Nat.dist_comm] using h.2.2⟩⟩
  loopless := ⟨by intro u h; simp [adj] at h⟩
instance {n m} : DecidableRel (graph n m).Adj := inferInstanceAs (DecidableRel adj)
def checkPath {n m} (v : Vertex n m) : List (Vertex n m) → Vertex n m → Bool
 | [], z => decide (v = z)
 | w::ws, z => decide (adj v w) && checkPath w ws z
 theorem path_sound {n m} (v : Vertex n m) (ws : List (Vertex n m)) (z : Vertex n m)
 (h : checkPath v ws z = true) : ∃ p : (graph n m).Walk v z, p.length = ws.length := by
  induction ws generalizing v with
  | nil =>
    have hv : v = z := of_decide_eq_true h
    subst z
    exact ⟨.nil,rfl⟩
  | cons w ws ih =>
    have hh : decide (adj v w) = true ∧ checkPath w ws z = true := by simpa [checkPath] using h
    obtain ⟨p,hp⟩ := ih w hh.2
    exact ⟨.cons (of_decide_eq_true hh.1) p, by simpa using congrArg Nat.succ hp⟩
def Burnable (n m T : ℕ) : Prop :=
 ∃ c : Fin T → Vertex n m, ∀ v, ∃ t : Fin T,
   ∃ p : (graph n m).Walk (c t) v, p.length ≤ T-1-t.val
-- Algorithm 2: choose a longest vertical segment and remove its initial 2r+1 vertices.
def step (r : ℕ) (a : List ℕ) : List ℕ :=
 match a with
 | [] => []
 | _ => let i := a.idxOf (a.foldl max 0)
        a.modify i (fun x => x-(2*r+1))
def finish : ℕ → List ℕ → List ℕ
 | 0,a => a
 | r+1,a => finish r (step r a)
def residual (n m T S : ℕ) : List ℕ :=
 (List.range n).map (fun x => m - (T-Nat.dist x S))
def GreedySuccess (n m T S : ℕ) : Prop :=
  0<T ∧ n≤T ∧ S<n ∧ (finish (T-1) (residual n m T S)).all (· == 0) = true
instance (n m T S) : Decidable (GreedySuccess n m T S) := by unfold GreedySuccess; infer_instance
-- Equality of the two minimum times implies this formulation, without choosing minima.
def SourceClaim : Prop := ∀ n m, 0<n → n≤m → ∀ T,
 Burnable n m T → ∃ S, S<n ∧ ∃ t, t≤T ∧ GreedySuccess n m t S

