def cert (v : Vertex 3 36) := certificates ⟨v.1.val*36+v.2.val, by omega⟩
theorem certificates_valid : ∀ v : Vertex 3 36,
 checkPath (centers (cert v).1) (cert v).2 v = true ∧
 (cert v).2.length ≤ 9-(cert v).1.val := by decide
theorem burnable_ten : Burnable 3 36 10 := by
 refine ⟨centers, fun v => ?_⟩
 obtain ⟨p,hp⟩ := path_sound _ _ _ (certificates_valid v).1
 exact ⟨(cert v).1,p,by simpa [hp] using (certificates_valid v).2⟩
theorem greedy_fails_through_ten : ∀ S : Fin 3, ∀ t : Fin 11,
 ¬ GreedySuccess 3 36 t.val S.val := by decide
theorem source_refutation : ¬ SourceClaim := by
 intro h
 obtain ⟨S,hS,t,ht,hg⟩ := h 3 36 (by decide) (by decide) 10 burnable_ten
 exact greedy_fails_through_ten ⟨S,hS⟩ ⟨t,by omega⟩ hg
-- Graph-semantic bridge: distance from a spine vertex is y + |x-S|.
def potential {n m} (S : Fin n) (v : Vertex n m) := Nat.dist v.1.val S.val + v.2.val
theorem potential_edge {n m} (S : Fin n) {u v : Vertex n m} (h : adj u v) :
 potential S v ≤ potential S u + 1 := by
 rcases h with ⟨hx,hy⟩ | ⟨hy,hz,hx⟩
 · simp only [potential, hx]
   simp only [Nat.dist] at hy ⊢
   omega
 · simp only [potential,hy,hz, Nat.dist] at *
   omega
theorem potential_walk {n m} (S : Fin n) {u v : Vertex n m}
 (p : (graph n m).Walk u v) : potential S v ≤ potential S u + p.length := by
 induction p with
 | nil => simp
 | @cons u v w huv p ih =>
   have he := potential_edge S huv
   simp only [SimpleGraph.Walk.length_cons]
   omega

