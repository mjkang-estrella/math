	<h1 class="page_title">
		Quantifying Noninvertibility in Discrete Dynamical Systems
	</h1>

	
	<div class="row">
		<div class="main_entry">

							<ul class="item authors">
											<li>
							<span class="name">
								Colin Defant
							</span>
              						</li>
