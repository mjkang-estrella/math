import Mathlib

open Set Metric

namespace Conj62

variable {X : Type*}

/-- The vertices lying on some path from `u` to `v` (for a tree: the unique path). -/
def pathVerts (G : SimpleGraph X) (u v : X) : Set X :=
  {w | ∃ p : G.Walk u v, p.IsPath ∧ w ∈ p.support}

/-- `d_l(u,v)` for `u ≠ v`: the maximum label on the path (endpoints included). -/
noncomputable def pathMax (G : SimpleGraph X) (l : X → ℝ) (u v : X) : ℝ :=
  sSup (l '' pathVerts G u v)

/-- `(X, dist)` is generated by the labeled tree `G(l)` (source Section 2). -/
def Generates [MetricSpace X] (G : SimpleGraph X) (l : X → ℝ) : Prop :=
  G.IsTree ∧ (∀ x, 0 ≤ l x) ∧ (∀ u v, G.Adj u v → 0 < max (l u) (l v)) ∧
    ∀ u v, u ≠ v → dist u v = pathMax G l u v

/-- Exactly one vertex has degree greater than 2. -/
def Starlike (G : SimpleGraph X) : Prop :=
  ∃! c : X, (2 : ℕ∞) < (G.neighborSet c).encard

/-- No ray: no injective one-way infinite walk. -/
def Rayless (G : SimpleGraph X) : Prop :=
  ¬ ∃ f : ℕ → X, Function.Injective f ∧ ∀ n, G.Adj (f n) (f (n + 1))

/-- The subspace `X₀` (with the induced metric) is generated by a labeled ray. -/
def RayGenerated [MetricSpace X] (X₀ : Set X) : Prop :=
  ∃ (e : ℕ → X) (lam : ℕ → ℝ), Function.Injective e ∧ range e = X₀ ∧ (∀ n, 0 ≤ lam n) ∧
    (∀ n, 0 < max (lam n) (lam (n + 1))) ∧
    ∀ n m, n ≠ m → dist (e n) (e m) =
      (Finset.Icc (min n m) (max n m)).sup' (by simp) lam

