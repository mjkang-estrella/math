<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex18.m1" class="ltx_Math" alttext="\displaystyle=|\deg_{T}(v_{0})-\deg_{T}(v_{1})|+\dots+|\deg_{T}(v_{i})-\deg_{T}(v_{k-i-1})|+\dots+" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo fence="false" lspace="0em">|</mo><mrow><mrow><mrow><msub><mi>deg</mi><mi>T</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><msub><mi>deg</mi><mi>T</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mrow><mo>+</mo><mi mathvariant="normal">⋯</mi></mrow><mo rspace="0em">+</mo></mrow><mo stretchy="false">|</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>deg</mi><mi>T</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>deg</mi><mi>T</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mrow><mi>k</mi><mo>−</mo><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo fence="false">|</mo><mrow><mrow><mo>+</mo><mi mathvariant="normal">⋯</mi></mrow><mo>+</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=|\deg_{T}(v_{0})-\deg_{T}(v_{1})|+\dots+|\deg_{T}(v_{i})-\deg_{T}(v_{k-i-1})|+\dots+</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
