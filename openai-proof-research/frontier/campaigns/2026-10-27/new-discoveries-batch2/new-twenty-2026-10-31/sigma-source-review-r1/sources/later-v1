<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex17.m1" class="ltx_Math" alttext="\displaystyle=\sum_{i=0}^{k/2}|\deg(v_{i})-\deg(v_{k-i})|-\sum_{i=1}^{(k+1)/2}|\deg(v_{i})-\deg(v_{k-i+2})|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>k</mi><mo>/</mo><mn>2</mn></mrow></munderover></mstyle><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mrow><mi>k</mi><mo>−</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>2</mn></mrow></munderover></mstyle><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>deg</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mrow><mrow><mi>k</mi><mo>−</mo><mi>i</mi></mrow><mo>+</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i=0}^{k/2}|\deg(v_{i})-\deg(v_{k-i})|-\sum_{i=1}^{(k+1)/2}|\deg(v_{i})-\deg(v_{k-i+2})|</annotation></semantics></math></td>
