<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex19.m1" class="ltx_Math" alttext="\displaystyle+|\deg_{T}(v_{k-1})-\deg_{T}(v_{k})|-\big(|\deg_{T^{\prime}}(v_{1})-\deg_{T^{\prime}}(v_{2})|+\dots+" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">+</mo><mo fence="false" lspace="0em">|</mo><mrow><mrow><mrow><msub><mi>deg</mi><mi>T</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>deg</mi><mi>T</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo fence="false">|</mo><mrow><mo>−</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><msub><mi>deg</mi><msup><mi>T</mi><mo>′</mo></msup></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>deg</mi><msup><mi>T</mi><mo>′</mo></msup></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><mi mathvariant="normal">⋯</mi><mo rspace="0em">+</mo></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+|\deg_{T}(v_{k-1})-\deg_{T}(v_{k})|-\big(|\deg_{T^{\prime}}(v_{1})-\deg_{T^{\prime}}(v_{2})|+\dots+</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
