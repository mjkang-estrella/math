<tbody id="S3.Ex16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex16.m1" class="ltx_Math" alttext="\displaystyle\operatorname{irr}(T)-\operatorname{irr}(T^{\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>irr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>irr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\operatorname{irr}(T)-\operatorname{irr}(T^{\prime})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex16.m2" class="ltx_Math" alttext="\displaystyle=\sum_{uv\in E(T)}|\deg_{T}(u)-\deg_{T}(v)|-\sum_{uv\in E(T^{\prime})}|\deg_{T^{\prime}}(u)-\deg_{T^{\prime}}(v)|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>∈</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder></mstyle><mrow><mo stretchy="false">|</mo><mrow><mrow><msub><mi>deg</mi><mi>T</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>deg</mi><mi>T</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>∈</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></munder></mstyle><mrow><mo stretchy="false">|</mo><mrow><mrow><msub><mi>deg</mi><msup><mi>T</mi><mo>′</mo></msup></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>deg</mi><msup><mi>T</mi><mo>′</mo></msup></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{uv\in E(T)}|\deg_{T}(u)-\deg_{T}(v)|-\sum_{uv\in E(T^{\prime})}|\deg_{T^{\prime}}(u)-\deg_{T^{\prime}}(v)|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
