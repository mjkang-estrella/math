/-
Multispin forest model: bounded formal semantic foundation

Literal finite model for the multispin rooted-forest situation behind
MathDB 323739.  Base vertices `U`, base labelled arcs `A` with fixed tail and
head maps, spin labels `Fin p`; digraph vertices are `U × Fin p`.  Ambient
arcs are horizontal lifts `(a, i)` of base arcs and vertical arcs at a base
vertex labelled by a pair of distinct spins whose spin value is the
DESTINATION label.  A forest is a finite set of ambient arcs with at most one
selected outgoing arc per vertex in which every vertex reaches a vertex with
no outgoing selected arc along selected arcs; no selected loop can occur, and
isolated vertices are roots.  Distinct parallel base arcs stay distinct, and
no externally prescribed root set is used.

Proved here, and only here:

* `countIdentity` : `R F + ∑ a, h a F + ∑ u, k u F = |U| * p`, with `R` the
  number of vertices carrying no outgoing selected arc, defined by that
  property (not by subtraction), and `h a`, `k u` the horizontal multiplicity
  of `a` and vertical count at `u`;
* `rootCount_eq_of_sameProjection` : forests whose projections agree on all
  `h a` and `k u` (and nothing else) have equal root counts.

No probability, determinant, independence or full-endpoint statement appears.
-/
import Mathlib.Data.Fintype.Basic
import Mathlib.Data.Finset.Basic
import Mathlib.Data.Finset.Card
import Mathlib.Logic.Relation

open Classical
open scoped Classical

namespace MultispinForest

/-! ## Ambient arcs -/

/-- Label of a vertical arc: a pair of distinct spins.  The spin of the
corresponding vertical arc is the destination, the second projection. -/
def VLabel (p : ℕ) : Type := {q : Fin p × Fin p // q.1 ≠ q.2}

instance instVLabelFintype (p : ℕ) : Fintype (VLabel p) :=
  Subtype.fintype fun q : Fin p × Fin p => q.1 ≠ q.2

/-- Ambient directed arcs over base vertices `U`, base labelled arcs `A` and
`p` spins.  `horiz a i` is the horizontal lift of the base arc `a` at spin
`i`; `vert u q` is the vertical arc at base vertex `u` from spin `q.1.1` to
spin `q.1.2`.  Distinct base arcs give distinct ambient arcs, so parallel
base arcs are never identified. -/
inductive Arc (U : Type*) (A : Type*) (p : ℕ) : Type
  | horiz (a : A) (i : Fin p) : Arc U A p
  | vert (u : U) (q : VLabel p) : Arc U A p

/-- Tail vertex of an ambient arc.  A horizontal lift keeps the spin and uses
the base tail; a vertical arc keeps the base vertex. -/
def arcTail {U : Type*} {A : Type*} {p : ℕ} (t₀ : A → U) :
    Arc U A p → U × Fin p
  | .horiz a i => (t₀ a, i)
  | .vert u q => (u, q.val.1)

/-- Head vertex of an ambient arc.  A horizontal lift keeps the spin and uses
the base head; a vertical arc moves to the destination spin. -/
def arcHead {U : Type*} {A : Type*} {p : ℕ} (h₀ : A → U) :
    Arc U A p → U × Fin p
  | .horiz a i => (h₀ a, i)
  | .vert u q => (u, q.val.2)

/-! ## Forests -/

/-- Selected-arc adjacency: `arcStep t₀ h₀ s v w` holds when some selected
arc has tail `v` and head `w`. -/
def arcStep {U : Type*} {A : Type*} {p : ℕ} (t₀ h₀ : A → U)
    (s : Finset (Arc U A p)) (v w : U × Fin p) : Prop :=
  ∃ e ∈ s, arcTail t₀ e = v ∧ arcHead h₀ e = w

/-- `r` is a root for the selected arcs `s` when no selected arc has tail
`r`.  In particular every isolated vertex is a root. -/
def isRoot {U : Type*} {A : Type*} {p : ℕ} (t₀ : A → U)
    (s : Finset (Arc U A p)) (r : U × Fin p) : Prop :=
  ∀ e ∈ s, arcTail t₀ e ≠ r

/-- A spanning rooted forest: a finite set of ambient arcs with at most one
selected outgoing arc per vertex, such that every vertex `U × Fin p` reaches
some root (a vertex with no outgoing selected arc) along the genuine
finite path relation generated by the selected arcs.  A horizontal loop
(`t₀ a = h₀ a`) may occur in the ambient arc type but cannot be selected in a
forest, since the vertex under it could then reach no root. -/
structure Forest (U : Type*) (A : Type*) (p : ℕ) (t₀ h₀ : A → U) where
  /-/ The selected arcs, out of the full ambient arc supply. -/
  arcs : Finset (Arc U A p)
  /-/ At most one selected outgoing arc per vertex. -/
  unique_out : ∀ e₁ : Arc U A p, e₁ ∈ arcs → ∀ e₂ : Arc U A p, e₂ ∈ arcs →
    arcTail t₀ e₁ = arcTail t₀ e₂ → e₁ = e₂
  /-/ Every vertex terminates at a root along selected arcs. -/
  reaches_root : ∀ v : U × Fin p, ∃ r : U × Fin p, isRoot t₀ arcs r ∧
    Relation.ReflTransGen (arcStep t₀ h₀ arcs) v r

/-! ## Projection data -/

/-- Horizontal multiplicity of the base arc `a`: the number of spins `i` for
which the horizontal lift `horiz a i` is selected. -/
noncomputable def hCount {U : Type*} {A : Type*} {p : ℕ} {t₀ h₀ : A → U}
    (F : Forest U A p t₀ h₀) (a : A) : ℕ :=
  (Finset.univ.filter fun i : Fin p => Arc.horiz a i ∈ F.arcs).card

/-- Vertical count at the base vertex `u`: the number of distinct-spin pairs
`q` with `vert u q` selected.  The spin of such an arc is its destination
`q.val.2`. -/
noncomputable def kCount {U : Type*} {A : Type*} {p : ℕ} {t₀ h₀ : A → U}
    (F : Forest U A p t₀ h₀) (u : U) : ℕ :=
  (Finset.univ.filter fun q : VLabel p => Arc.vert u q ∈ F.arcs).card

/-- Root count: the number of vertices with no outgoing selected arc,
defined by that property. -/
noncomputable def rootCount {U : Type*} [Fintype U] {A : Type*} {p : ℕ}
    {t₀ h₀ : A → U} (F : Forest U A p t₀ h₀) : ℕ :=
  (Finset.univ.filter (isRoot t₀ F.arcs)).card

/-- The projection of a forest is the data of all horizontal multiplicities
and all vertical counts.  Two forests have the same projection when these
agree; root counts are deliberately not part of the projection. -/
structure SameProjection {U : Type*} {A : Type*} {p : ℕ} {t₀ h₀ : A → U}
    (F F' : Forest U A p t₀ h₀) : Prop where
  /-/ All horizontal multiplicities agree. -/
  hEq : ∀ a, hCount F a = hCount F' a
  /-/ All vertical counts agree. -/
  kEq : ∀ u, kCount F u = kCount F' u

/-! ## The count identity -/

/-- The selected arcs split into horizontal lifts and vertical arcs, so the
total number of selected arcs is the sum of all horizontal multiplicities and
all vertical counts. -/
theorem arcs_card_eq {U : Type*} [Fintype U] {A : Type*} [Fintype A] {p : ℕ}
    {t₀ h₀ : A → U} (F : Forest U A p t₀ h₀) :
    F.arcs.card = (∑ a, hCount F a) + (∑ u, kCount F u) := by
  classical
  -- Index sets for the horizontal, respectively vertical, selected arcs.
  set Hσ : Finset (Σ _ : A, Fin p) :=
    Finset.univ.sigma fun a : A =>
      Finset.univ.filter fun i : Fin p => Arc.horiz a i ∈ F.arcs with hHσ
  set Vσ : Finset (Σ _ : U, VLabel p) :=
    Finset.univ.sigma fun u : U =>
      Finset.univ.filter fun q : VLabel p => Arc.vert u q ∈ F.arcs with hVσ
  have hinjH : Function.Injective fun x : Σ _ : A, Fin p => Arc.horiz x.1 x.2 := by
    rintro ⟨a, i⟩ ⟨b, j⟩ h
    have h' : a = b ∧ i = j := by simpa using h
    obtain ⟨-, -⟩ := h'
    rfl
  have hinjV : Function.Injective fun x : Σ _ : U, VLabel p => Arc.vert x.1 x.2 := by
    rintro ⟨u, q⟩ ⟨u', q'⟩ h
    have h' : u = u' ∧ q = q' := by simpa using h
    obtain ⟨-, -⟩ := h'
    rfl
  set Harc : Finset (Arc U A p) :=
    Hσ.image fun x : Σ _ : A, Fin p => Arc.horiz x.1 x.2 with hHarc
  set Varc : Finset (Arc U A p) :=
    Vσ.image fun x : Σ _ : U, VLabel p => Arc.vert x.1 x.2 with hVarc
  have cardH : Harc.card = ∑ a, hCount F a := by
    rw [hHarc, hHσ]
    rw [Finset.card_image_of_injOn hinjH.injOn, Finset.card_sigma]
  have cardV : Varc.card = ∑ u, kCount F u := by
    rw [hVarc, hVσ]
    rw [Finset.card_image_of_injOn hinjV.injOn, Finset.card_sigma]
  -- The two images partition the selected arcs.
  have unioneq : Harc ∪ Varc = F.arcs := by
    ext e
    cases e with
    | horiz a i =>
      simp only [Finset.mem_union, hHarc, hVarc, Finset.mem_image]
      constructor
      · rintro (⟨x, hx, hx'⟩ | ⟨y, hy, hy'⟩)
        · exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, hx' ▸ hx.2 ▸ rfl⟩
        · exact Finset.mem_filter.mpr
            ⟨Finset.mem_univ _, by obtain ⟨-, -⟩ := hy; exact hy' ▸ hx.2 ▸ rfl⟩ |>.elim
      · intro hmem
        exact Or.inl ⟨(a, i), by simp [hHσ], by simp⟩
    | vert u q =>
      sorry
  have disj : Disjoint Harc Varc := by
    refine Finset.disjoint_left.mpr fun e he he' => ?_
    cases e with
    | horiz a i => simp at he he'; omega
    | vert u q => simp at he he'; omega
  calc F.arcs.card = (Harc ∪ Varc).card := by rw [unioneq]
    _ = Harc.card + Varc.card := Finset.card_union_of_disjoint disj
    _ = (∑ a, hCount F a) + (∑ u, kCount F u) := by rw [cardH, cardV]

/-- The counting identity: root count plus all horizontal multiplicities plus
all vertical counts equals `|U| * p`, the number of digraph vertices. -/
theorem countIdentity {U : Type*} [Fintype U] {A : Type*} [Fintype A] {p : ℕ}
    {t₀ h₀ : A → U} (F : Forest U A p t₀ h₀) :
    rootCount F + (∑ a, hCount F a) + (∑ u, kCount F u) = Fintype.card U * p := by
  classical
  -- The vertices with an outgoing selected arc are exactly the tails.
  have hinj : Set.InjOn (arcTail t₀) ↑F.arcs := fun e₁ he₁ e₂ he₂ hh =>
    F.unique_out e₁ (by simpa using he₁) e₂ (by simpa using he₂) hh
  have img_card : (F.arcs.image (arcTail t₀)).card = F.arcs.card :=
    Finset.card_image_of_injOn hinj
  have unionuniv : (Finset.univ.filter (isRoot t₀ F.arcs)) ∪
      (F.arcs.image (arcTail t₀)) = (Finset.univ : Finset (U × Fin p)) := by
    ext v
    by_cases hr : isRoot t₀ F.arcs v
    · refine Finset.mem_union.mpr (Or.inl ?_)
      exact Finset.mem_filter.mpr ⟨Finset.mem_univ v, hr⟩
    · refine Finset.mem_union.mpr (Or.inr ?_)
      have : ¬(∀ e ∈ F.arcs, arcTail t₀ e ≠ v) := by simpa using hr
      obtain ⟨e, he, hv⟩ : ∃ e ∈ F.arcs, arcTail t₀ e = v := by
        by_contra hcon
        push_neg at hcon
        exact hr fun e he => hcon e he
      exact Finset.mem_image.mpr ⟨e, he, hv⟩
  have disj : Disjoint (Finset.univ.filter (isRoot t₀ F.arcs))
      (F.arcs.image (arcTail t₀)) := by
    refine Finset.disjoint_left.mpr fun v hv₁ hv₂ => ?_
    obtain ⟨e, he, hve⟩ := Finset.mem_image.mp hv₂
    exact (Finset.mem_filter.mp hv₁).2 e he hve
  have key : rootCount F + (∑ a, hCount F a) + (∑ u, kCount F u)
      = Fintype.card (U × Fin p) := by
    calc rootCount F + (∑ a, hCount F a) + (∑ u, kCount F u)
        = rootCount F + F.arcs.card := by rw [arcs_card_eq F]
      _ = (Finset.univ.filter (isRoot t₀ F.arcs)).card +
          (F.arcs.image (arcTail t₀)).card := by rw [img_card]
      _ = ((Finset.univ.filter (isRoot t₀ F.arcs)) ∪
          (F.arcs.image (arcTail t₀))).card := Finset.card_union_of_disjoint disj
      _ = (Finset.univ : Finset (U × Fin p)).card := by rw [unionuniv]
      _ = Fintype.card (U × Fin p) := Finset.card_univ _
  have hprod : Fintype.card (U × Fin p) = Fintype.card U * p := by
    rw [Fintype.card_prod, Fintype.card_fin]
  omega

/-- Root counts agree on a common projection: this is the root-conditioning
step, a consequence of the identity alone, with no further structure. -/
theorem rootCount_eq_of_sameProjection {U : Type*} [Fintype U] {A : Type*}
    [Fintype A] {p : ℕ} {t₀ h₀ : A → U} {F F' : Forest U A p t₀ h₀}
    (h : SameProjection F F') : rootCount F = rootCount F' := by
  classical
  have e₁ := countIdentity (F := F)
  have e₂ := countIdentity (F := F')
  have d₁ := arcs_card_eq (F := F)
  have d₂ := arcs_card_eq (F := F')
  have s : (∑ a, hCount F a) + (∑ u, kCount F u)
      = (∑ a, hCount F' a) + (∑ u, kCount F' u) := by
    rw [Finset.sum_congr rfl fun a _ => h.hEq a,
      Finset.sum_congr rfl fun u _ => h.kEq u]
  omega

end MultispinForest
