theorem qindex_kts_endpoint : Statement := by
  intro s t ht hs
  refine ⟨thresholdN s t, ?_⟩
  intro n hn G _ hfree
  have hcard : Fintype.card (Fin n) = n := Fintype.card_fin n
  have hmain := main_general G ht hs (by rw [hcard]; exact hn) hfree
  rw [hcard] at hmain
  exact hmain
