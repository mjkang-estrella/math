import Certificate
namespace R162
set_option maxRecDepth 100000
set_option maxHeartbeats 0
theorem row_77 : ∀ j : Fin 88,
 (treeGraph (nanostar 4)).Adj (77 : Fin 88) j ↔
 (77 : Fin 88) ≠ j ∧ (next (77 : Fin 88) = j ∨ next j = (77 : Fin 88)) := by
 change ∀ j : Fin 88,
   ((77 : Fin 88) ≠ j ∧ ((77,j.val) ∈ edges (nanostar 4) ∨ (j.val,77) ∈ edges (nanostar 4))) ↔
   (77 : Fin 88) ≠ j ∧ (next (77 : Fin 88) = j ∨ next j = (77 : Fin 88))
 decide
