</div>
<div id="S4.SS1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS1.p8" class="ltx_para">
<p id="S4.SS1.p8.1" class="ltx_p"><span id="S4.SS1.p8.1.1" class="ltx_text">For (<a href="#S4.E37" title="In Lemma 4.2 (Scalar inequalities). ‣ 4.1. The modified heat equation ‣ 4. Modified heat, Li–Yau, and Harnack estimates ‣ Nonnegative Bakry–Émery Curvature on Bounded-Degree Graphs Implies Volume Doubling and Poincaré Inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">37</span></a>), put <math id="S4.SS1.p8.m1" class="ltx_math_unparsed" alttext="w=z/2\in[-1/2,1/2]" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>=</mo><mi>z</mi><mo>/</mo><mn>2</mn><mo>∈</mo><mrow><mo stretchy="false">[</mo><mo lspace="0em">−</mo><mn>1</mn><mo>/</mo><mn>2</mn><mo>,</mo><mn>1</mn><mo>/</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">w=z/2\in[-1/2,1/2]</annotation></semantics></math> and define</span></p>
<table id="S4.Ex66" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex66.m1" class="ltx_Math" alttext="q(w):=1+w+w^{2}-\mathrm{e}^{w}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><mn>1</mn><mo>+</mo><mi>w</mi><mo>+</mo><msup><mi>w</mi><mn>2</mn></msup></mrow><mo>−</mo><msup><mi>e</mi><mi>w</mi></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">q(w):=1+w+w^{2}-\mathrm{e}^{w}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p8.2" class="ltx_p"><span id="S4.SS1.p8.2.1" class="ltx_text">Since <math id="S4.SS1.p8.m2" class="ltx_Math" alttext="q(0)=q^{\prime}(0)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>q</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">q(0)=q^{\prime}(0)=0</annotation></semantics></math> and <math id="S4.SS1.p8.m3" class="ltx_Math" alttext="q^{\prime\prime}(w)=2-\mathrm{e}^{w}&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>q</mi><mo>′′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo>−</mo><msup><mi>e</mi><mi>w</mi></msup></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">q^{\prime\prime}(w)=2-\mathrm{e}^{w}&gt;0</annotation></semantics></math> on this interval, <math id="S4.SS1.p8.m4" class="ltx_Math" alttext="w=0" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">w=0</annotation></semantics></math> is the unique minimum of <math id="S4.SS1.p8.m5" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS1.p9" class="ltx_para">
<p id="S4.SS1.p9.1" class="ltx_p"><span id="S4.SS1.p9.1.1" class="ltx_text">For (<a href="#S4.E38" title="In Lemma 4.2 (Scalar inequalities). ‣ 4.1. The modified heat equation ‣ 4. Modified heat, Li–Yau, and Harnack estimates ‣ Nonnegative Bakry–Émery Curvature on Bounded-Degree Graphs Implies Volume Doubling and Poincaré Inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">38</span></a>), first let <math id="S4.SS1.p9.m1" class="ltx_Math" alttext="z\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">z\geq 0</annotation></semantics></math>. Taylor’s inequality <math id="S4.SS1.p9.m2" class="ltx_Math" alttext="\mathrm{e}^{2z}\geq 1+2z+2z^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>e</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow></msup><mo>≥</mo><mrow><mn>1</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{e}^{2z}\geq 1+2z+2z^{2}</annotation></semantics></math> gives</span></p>
<table id="S4.Ex67" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex67.m1" class="ltx_Math" alttext="2z\left(1+\frac{z}{2}\right)-(\mathrm{e}^{2z}-1)\leq-z^{2}\leq 0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mfrac><mi>z</mi><mn>2</mn></mfrac></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mo>−</mo><msup><mi>z</mi><mn>2</mn></msup></mrow><mo>≤</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">2z\left(1+\frac{z}{2}\right)-(\mathrm{e}^{2z}-1)\leq-z^{2}\leq 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p9.2" class="ltx_p"><span id="S4.SS1.p9.2.1" class="ltx_text">Now write <math id="S4.SS1.p9.m3" class="ltx_Math" alttext="z=-s" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>=</mo><mrow><mo>−</mo><mi>s</mi></mrow></mrow><annotation encoding="application/x-tex">z=-s</annotation></semantics></math> with <math id="S4.SS1.p9.m4" class="ltx_Math" alttext="s\in[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">s\in[0,1]</annotation></semantics></math>. The desired inequality is equivalent to</span></p>
<table id="S4.E39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(39)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E39.m1" class="ltx_Math" alttext="\varphi(s):=2s-s^{2}-1+\mathrm{e}^{-2s}\geq 0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>−</mo><msup><mi>s</mi><mn>2</mn></msup><mo>−</mo><mn>1</mn></mrow><mo>+</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup></mrow><mo>≥</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\varphi(s):=2s-s^{2}-1+\mathrm{e}^{-2s}\geq 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p9.3" class="ltx_p"><span id="S4.SS1.p9.3.1" class="ltx_text">Here</span></p>
<table id="S4.Ex68" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex68.m1" class="ltx_Math" alttext="\varphi^{\prime}(s)=2g(s),\qquad g(s):=1-s-\mathrm{e}^{-2s}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msup><mi>φ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mn>1</mn><mo>−</mo><mi>s</mi><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\varphi^{\prime}(s)=2g(s),\qquad g(s):=1-s-\mathrm{e}^{-2s}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p9.4" class="ltx_p"><span id="S4.SS1.p9.4.1" class="ltx_text">The function <math id="S4.SS1.p9.m5" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> is strictly concave, satisfies <math id="S4.SS1.p9.m6" class="ltx_Math" alttext="g(0)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">g(0)=0</annotation></semantics></math>, <math id="S4.SS1.p9.m7" class="ltx_Math" alttext="g^{\prime}(0)=1" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>g</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">g^{\prime}(0)=1</annotation></semantics></math>, and <math id="S4.SS1.p9.m8" class="ltx_Math" alttext="g(1)=-\mathrm{e}^{-2}&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>−</mo><msup><mi>e</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">g(1)=-\mathrm{e}^{-2}&lt;0</annotation></semantics></math>. Its nonnegative superlevel set is therefore an interval; since <math id="S4.SS1.p9.m9" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> is positive for small positive <math id="S4.SS1.p9.m10" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> and negative at <math id="S4.SS1.p9.m11" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>, there is a unique sign change in <math id="S4.SS1.p9.m12" class="ltx_Math" alttext="(0,1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,1)</annotation></semantics></math>. Thus <math id="S4.SS1.p9.m13" class="ltx_Math" alttext="\varphi" display="inline" intent=":literal"><semantics><mi>φ</mi><annotation encoding="application/x-tex">\varphi</annotation></semantics></math> first increases and then decreases. Its minimum on <math id="S4.SS1.p9.m14" class="ltx_Math" alttext="[0,1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,1]</annotation></semantics></math> is attained at an endpoint, and <math id="S4.SS1.p9.m15" class="ltx_Math" alttext="\varphi(0)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\varphi(0)=0</annotation></semantics></math>, <math id="S4.SS1.p9.m16" class="ltx_Math" alttext="\varphi(1)=\mathrm{e}^{-2}&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mi>e</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\varphi(1)=\mathrm{e}^{-2}&gt;0</annotation></semantics></math>. This proves (<a href="#S4.E39" title="In Proof. ‣ 4.1. The modified heat equation ‣ 4. Modified heat, Li–Yau, and Harnack estimates ‣ Nonnegative Bakry–Émery Curvature on Bounded-Degree Graphs Implies Volume Doubling and Poincaré Inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">39</span></a>).
∎</span></p>
</div>
</div>
<div id="S4.Thmtheorem3" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem3.2" class="ltx_text ltx_font_bold">Proposition 4.3</span></span><span id="S4.Thmtheorem3.3" class="ltx_text ltx_font_bold"> </span>(Semigroup comparisons)<span id="S4.Thmtheorem3.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem3.p1" class="ltx_para">
<p id="S4.Thmtheorem3.p1.1" class="ltx_p"><span id="S4.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmtheorem3.p1.m1" class="ltx_Math" alttext="u_{t}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mi>t</mi></msub><annotation encoding="application/x-tex">u_{t}</annotation></semantics></math> be the solution in Proposition <a href="#S4.Thmtheorem1" title="Proposition 4.1 (Global nonlinear flow and gradient bound). ‣ 4.1. The modified heat equation ‣ 4. Modified heat, Li–Yau, and Harnack estimates ‣ Nonnegative Bakry–Émery Curvature on Bounded-Degree Graphs Implies Volume Doubling and Poincaré Inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>. With</span></p>
<table id="S4.E40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(40)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E40.m1" class="ltx_Math" alttext="\theta:=\frac{1}{2},\qquad\beta:=2," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>θ</mi><mo>:=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><mo rspace="2.167em">,</mo><mrow><mi>β</mi><mo>:=</mo><mn>2</mn></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\theta:=\frac{1}{2},\qquad\beta:=2,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmtheorem3.p1.2" class="ltx_p"><span id="S4.Thmtheorem3.p1.2.1" class="ltx_text ltx_font_italic">one has, pointwise on <math id="S4.Thmtheorem3.p1.m2" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math>,</span></p>
<table id="S4.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E41"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(41)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E41.m1" class="ltx_Math" alttext="\displaystyle\mathrm{e}^{\theta u_{t}}" display="inline" intent=":literal"><semantics><msup><mi>e</mi><mrow><mi>θ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mi>t</mi></msub></mrow></msup><annotation encoding="application/x-tex">\displaystyle\mathrm{e}^{\theta u_{t}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E41.m2" class="ltx_Math" alttext="\displaystyle\geq P_{t}\mathrm{e}^{\theta u_{0}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≥</mo><mrow><msub><mi>P</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mi>θ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mn>0</mn></msub></mrow></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq P_{t}\mathrm{e}^{\theta u_{0}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.E42"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(42)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E42.m1" class="ltx_Math" alttext="\displaystyle\mathrm{e}^{\beta u_{t}}" display="inline" intent=":literal"><semantics><msup><mi>e</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mi>t</mi></msub></mrow></msup><annotation encoding="application/x-tex">\displaystyle\mathrm{e}^{\beta u_{t}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E42.m2" class="ltx_Math" alttext="\displaystyle\leq P_{t}\mathrm{e}^{\beta u_{0}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>P</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mn>0</mn></msub></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq P_{t}\mathrm{e}^{\beta u_{0}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
