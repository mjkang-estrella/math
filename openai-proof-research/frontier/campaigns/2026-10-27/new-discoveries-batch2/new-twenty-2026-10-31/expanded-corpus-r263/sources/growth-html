<p id="S4.SS2.p7.5" class="ltx_p"><span id="S4.SS2.p7.5.1" class="ltx_text">Integration from <math id="S4.SS2.p7.m2" class="ltx_Math" alttext="s_{1}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mn>1</mn></msub><annotation encoding="application/x-tex">s_{1}</annotation></semantics></math> to <math id="S4.SS2.p7.m3" class="ltx_Math" alttext="s_{2}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mn>2</mn></msub><annotation encoding="application/x-tex">s_{2}</annotation></semantics></math> gives</span></p>
<table id="S4.Ex85" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex85.m1" class="ltx_Math" alttext="\frac{1}{C}-\frac{1}{C+\mathcal{A}(s_{1})}&gt;\frac{\tau}{2}=\frac{1}{C}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mn>1</mn><mi>C</mi></mfrac><mo>−</mo><mfrac><mn>1</mn><mrow><mi>C</mi><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mrow><mo>&gt;</mo><mfrac><mi>τ</mi><mn>2</mn></mfrac><mo>=</mo><mfrac><mn>1</mn><mi>C</mi></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{1}{C}-\frac{1}{C+\mathcal{A}(s_{1})}&gt;\frac{\tau}{2}=\frac{1}{C},</annotation></semantics></math></td>
