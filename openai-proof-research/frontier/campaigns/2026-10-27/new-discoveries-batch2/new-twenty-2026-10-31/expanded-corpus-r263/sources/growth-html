<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex178.m1" class="ltx_Math" alttext="B(o,r)\subset B(x_{i},2r)\subset B(x_{i},2^{q}s)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo>,</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><mrow><msup><mn>2</mn><mi>q</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">B(o,r)\subset B(x_{i},2r)\subset B(x_{i},2^{q}s).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p3.13" class="ltx_p"><span id="S7.p3.13.1" class="ltx_text">Iterated doubling therefore gives</span></p>
<table id="S7.E90" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(90)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E90.m1" class="ltx_Math" alttext="\#B(x_{i},s)\geq K_{D}^{-q}\#B(o,r)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><msubsup><mi>K</mi><mi>D</mi><mrow><mo>−</mo><mi>q</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo>,</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\#B(x_{i},s)\geq K_{D}^{-q}\#B(o,r).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p3.14" class="ltx_p"><span id="S7.p3.14.1" class="ltx_text">The disjoint balls <math id="S7.p3.m18" class="ltx_Math" alttext="B(x_{i},s)" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B(x_{i},s)</annotation></semantics></math> lie in <math id="S7.p3.m19" class="ltx_Math" alttext="B(o,2r)" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B(o,2r)</annotation></semantics></math>. Hence</span></p>
<table id="S7.EGx23" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S7.Ex179"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.Ex179.m1" class="ltx_Math" alttext="\displaystyle nK_{D}^{-q}\#B(o,r)" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>K</mi><mi>D</mi><mrow><mo>−</mo><mi>q</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo>,</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle nK_{D}^{-q}\#B(o,r)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex179.m2" class="ltx_Math" alttext="\displaystyle\leq\#B(o,2r)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\#B(o,2r)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex180"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex180.m1" class="ltx_Math" alttext="\displaystyle\leq K_{D}\#B(o,r)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>K</mi><mi>D</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo>,</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq K_{D}\#B(o,r).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p3.15" class="ltx_p"><span id="S7.p3.15.1" class="ltx_text">Thus</span></p>
<table id="S7.Ex181" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex181.m1" class="ltx_Math" alttext="n\leq K_{D}^{q+1}\leq M_{\mathrm{cov}}." display="block" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo>≤</mo><msubsup><mi>K</mi><mi>D</mi><mrow><mi>q</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mo>≤</mo><msub><mi>M</mi><mi>cov</mi></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">n\leq K_{D}^{q+1}\leq M_{\mathrm{cov}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p3.16" class="ltx_p"><span id="S7.p3.16.1" class="ltx_text">Form a graph on the centres by joining <math id="S7.p3.m20" class="ltx_Math" alttext="x_{i}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>i</mi></msub><annotation encoding="application/x-tex">x_{i}</annotation></semantics></math> and <math id="S7.p3.m21" class="ltx_Math" alttext="x_{j}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>j</mi></msub><annotation encoding="application/x-tex">x_{j}</annotation></semantics></math> whenever</span></p>
<table id="S7.Ex182" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex182.m1" class="ltx_Math" alttext="\operatorname{dist}(x_{i},x_{j})&lt;5s." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>dist</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\operatorname{dist}(x_{i},x_{j})&lt;5s.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p3.17" class="ltx_p"><span id="S7.p3.17.1" class="ltx_text">This centre graph is connected. Indeed, follow a geodesic from <math id="S7.p3.m22" class="ltx_Math" alttext="o" display="inline" intent=":literal"><semantics><mi>o</mi><annotation encoding="application/x-tex">o</annotation></semantics></math> to <math id="S7.p3.m23" class="ltx_Math" alttext="x_{i}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>i</mi></msub><annotation encoding="application/x-tex">x_{i}</annotation></semantics></math>. Assign to each
geodesic vertex a centre whose ball in (<a href="#S7.E89" title="In Proof. ‣ 7. Reduction to dilation two ‣ Nonnegative Bakry–Émery Curvature on Bounded-Degree Graphs Implies Volume Doubling and Poincaré Inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">89</span></a>) contains it, choosing <math id="S7.p3.m24" class="ltx_Math" alttext="x_{1}=o" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>=</mo><mi>o</mi></mrow><annotation encoding="application/x-tex">x_{1}=o</annotation></semantics></math> for the
initial vertex and <math id="S7.p3.m25" class="ltx_Math" alttext="x_{i}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>i</mi></msub><annotation encoding="application/x-tex">x_{i}</annotation></semantics></math> for the final vertex. Centres assigned to two consecutive vertices are
at distance less than</span></p>
<table id="S7.Ex183" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex183.m1" class="ltx_Math" alttext="2s+1+2s=4s+1\leq 5s." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>+</mo><mn>1</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><mo>=</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo>≤</mo><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">2s+1+2s=4s+1\leq 5s.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p3.18" class="ltx_p"><span id="S7.p3.18.1" class="ltx_text">After deleting repetitions, this gives a path from <math id="S7.p3.m26" class="ltx_Math" alttext="x_{1}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>1</mn></msub><annotation encoding="application/x-tex">x_{1}</annotation></semantics></math> to <math id="S7.p3.m27" class="ltx_Math" alttext="x_{i}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>i</mi></msub><annotation encoding="application/x-tex">x_{i}</annotation></semantics></math>. Every centre can therefore
be connected to <math id="S7.p3.m28" class="ltx_Math" alttext="x_{1}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>1</mn></msub><annotation encoding="application/x-tex">x_{1}</annotation></semantics></math> by a simple path with at most <math id="S7.p3.m29" class="ltx_Math" alttext="n-1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n-1</annotation></semantics></math> links.
Set</span></p>
<table id="S7.Ex184" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex184.m1" class="ltx_Math" alttext="B:=B(o,r),\qquad\mathcal{E}:=\mathcal{E}_{B(o,2r)}(f),\qquad U_{i}:=B(x_{i},2s),\qquad m_{i}:=f_{U_{i}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>B</mi><mo>:=</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo>,</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>:=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi>U</mi><mi>i</mi></msub><mo>:=</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi>m</mi><mi>i</mi></msub><mo>:=</mo><msub><mi>f</mi><msub><mi>U</mi><mi>i</mi></msub></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">B:=B(o,r),\qquad\mathcal{E}:=\mathcal{E}_{B(o,2r)}(f),\qquad U_{i}:=B(x_{i},2s),\qquad m_{i}:=f_{U_{i}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p3.19" class="ltx_p"><span id="S7.p3.19.1" class="ltx_text">Choose a disjoint partition</span></p>
<table id="S7.Ex185" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex185.m1" class="ltx_math_unparsed" alttext="B=A_{1}\mathbin{\dot{\cup}}\cdots\mathbin{\dot{\cup}}A_{n}" display="block" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><mi>A</mi><msub><mrow></mrow><mn>1</mn></msub><mover accent="true"><mo>∪</mo><mo>˙</mo></mover><mo lspace="0em" rspace="0em">⋯</mo><mover accent="true"><mo>∪</mo><mo>˙</mo></mover><mi>A</mi><msub><mrow></mrow><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">B=A_{1}\mathbin{\dot{\cup}}\cdots\mathbin{\dot{\cup}}A_{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p3.20" class="ltx_p"><span id="S7.p3.20.1" class="ltx_text">with <math id="S7.p3.m30" class="ltx_Math" alttext="A_{i}\subset U_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mi>i</mi></msub><mo>⊂</mo><msub><mi>U</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">A_{i}\subset U_{i}</annotation></semantics></math>. Such a partition exists by (<a href="#S7.E89" title="In Proof. ‣ 7. Reduction to dilation two ‣ Nonnegative Bakry–Émery Curvature on Bounded-Degree Graphs Implies Volume Doubling and Poincaré Inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">89</span></a>).
By Theorem <a href="#S6.Thmtheorem5" title="Theorem 6.5 (Fixed-dilation Poincaré inequality). ‣ 6.3. A fixed-dilation Poincaré inequality ‣ 6. Heat-kernel localisation for Poincaré inequalities ‣ Nonnegative Bakry–Émery Curvature on Bounded-Degree Graphs Implies Volume Doubling and Poincaré Inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.5</span></a>, (<a href="#S7.E88" title="In Proof. ‣ 7. Reduction to dilation two ‣ Nonnegative Bakry–Émery Curvature on Bounded-Degree Graphs Implies Volume Doubling and Poincaré Inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">88</span></a>), and</span></p>
<table id="S7.Ex186" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex186.m1" class="ltx_Math" alttext="B(x_{i},2\Lambda s)\subset B(o,2r)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">B(x_{i},2\Lambda s)\subset B(o,2r),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p3.21" class="ltx_p"><span id="S7.p3.21.1" class="ltx_text">we have</span></p>
<table id="S7.E91" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(91)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E91.m1" class="ltx_Math" alttext="\sum_{x\in U_{i}}|f(x)-m_{i}|^{2}\leq C_{0}(2s)^{2}\mathcal{E}=4C_{0}s^{2}\mathcal{E}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>x</mi><mo>∈</mo><msub><mi>U</mi><mi>i</mi></msub></mrow></munder><msup><mrow><mo lspace="0em" stretchy="false">|</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>m</mi><mi>i</mi></msub></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow><mo>≤</mo><mrow><msub><mi>C</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><mo>=</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>s</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{x\in U_{i}}|f(x)-m_{i}|^{2}\leq C_{0}(2s)^{2}\mathcal{E}=4C_{0}s^{2}\mathcal{E}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p3.22" class="ltx_p"><span id="S7.p3.22.1" class="ltx_text">The stated inclusion follows from <math id="S7.p3.m31" class="ltx_Math" alttext="x_{i}\in B(o,r)" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>i</mi></msub><mo>∈</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo>,</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x_{i}\in B(o,r)</annotation></semantics></math> and
<math id="S7.p3.m32" class="ltx_Math" alttext="2\Lambda s\leq r/16" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>≤</mo><mrow><mi>r</mi><mo>/</mo><mn>16</mn></mrow></mrow><annotation encoding="application/x-tex">2\Lambda s\leq r/16</annotation></semantics></math>.
Suppose now that <math id="S7.p3.m33" class="ltx_Math" alttext="x_{i}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>i</mi></msub><annotation encoding="application/x-tex">x_{i}</annotation></semantics></math> and <math id="S7.p3.m34" class="ltx_Math" alttext="x_{j}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>j</mi></msub><annotation encoding="application/x-tex">x_{j}</annotation></semantics></math> are linked. Put</span></p>
<table id="S7.Ex187" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex187.m1" class="ltx_Math" alttext="W:=B(x_{i},8s)." display="block" intent=":literal"><semantics><mrow><mrow><mi>W</mi><mo>:=</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">W:=B(x_{i},8s).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p3.23" class="ltx_p"><span id="S7.p3.23.1" class="ltx_text">Then <math id="S7.p3.m35" class="ltx_Math" alttext="U_{i}\cup U_{j}\subset W" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>U</mi><mi>i</mi></msub><mo>∪</mo><msub><mi>U</mi><mi>j</mi></msub></mrow><mo>⊂</mo><mi>W</mi></mrow><annotation encoding="application/x-tex">U_{i}\cup U_{j}\subset W</annotation></semantics></math>. Since <math id="S7.p3.m36" class="ltx_Math" alttext="B(x_{i},s)\subset U_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><msub><mi>U</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">B(x_{i},s)\subset U_{i}</annotation></semantics></math> and
<math id="S7.p3.m37" class="ltx_Math" alttext="B(x_{j},s)\subset U_{j}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><msub><mi>U</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">B(x_{j},s)\subset U_{j}</annotation></semantics></math>, (<a href="#S7.E90" title="In Proof. ‣ 7. Reduction to dilation two ‣ Nonnegative Bakry–Émery Curvature on Bounded-Degree Graphs Implies Volume Doubling and Poincaré Inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">90</span></a>) gives</span></p>
<table id="S7.Ex188" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex188.m1" class="ltx_Math" alttext="\#U_{i},\#U_{j}\geq K_{D}^{-q}\#B." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>U</mi><mi>i</mi></msub></mrow><mo>,</mo><mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>U</mi><mi>j</mi></msub></mrow><mo>≥</mo><mrow><msubsup><mi>K</mi><mi>D</mi><mrow><mo>−</mo><mi>q</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\#U_{i},\#U_{j}\geq K_{D}^{-q}\#B.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p3.24" class="ltx_p"><span id="S7.p3.24.1" class="ltx_text">Writing <math id="S7.p3.m38" class="ltx_Math" alttext="m_{W}=f_{W}" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>W</mi></msub><mo>=</mo><msub><mi>f</mi><mi>W</mi></msub></mrow><annotation encoding="application/x-tex">m_{W}=f_{W}</annotation></semantics></math> and using Cauchy–Schwarz,</span></p>
<table id="S7.EGx24" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S7.Ex189"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.Ex189.m1" class="ltx_Math" alttext="\displaystyle|m_{i}-m_{j}|^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">|</mo><mrow><msub><mi>m</mi><mi>i</mi></msub><mo>−</mo><msub><mi>m</mi><mi>j</mi></msub></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\displaystyle|m_{i}-m_{j}|^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex189.m2" class="ltx_Math" alttext="\displaystyle\leq 2|m_{i}-m_{W}|^{2}+2|m_{j}-m_{W}|^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><mrow><msub><mi>m</mi><mi>i</mi></msub><mo>−</mo><msub><mi>m</mi><mi>W</mi></msub></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><mrow><msub><mi>m</mi><mi>j</mi></msub><mo>−</mo><msub><mi>m</mi><mi>W</mi></msub></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2|m_{i}-m_{W}|^{2}+2|m_{j}-m_{W}|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex190"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex190.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{4K_{D}^{q}}{\#B}\sum_{x\in W}|f(x)-m_{W}|^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>K</mi><mi>D</mi><mi>q</mi></msubsup></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>x</mi><mo>∈</mo><mi>W</mi></mrow></munder></mstyle><msup><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>m</mi><mi>W</mi></msub></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{4K_{D}^{q}}{\#B}\sum_{x\in W}|f(x)-m_{W}|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p3.25" class="ltx_p"><span id="S7.p3.25.1" class="ltx_text">Apply Theorem <a href="#S6.Thmtheorem5" title="Theorem 6.5 (Fixed-dilation Poincaré inequality). ‣ 6.3. A fixed-dilation Poincaré inequality ‣ 6. Heat-kernel localisation for Poincaré inequalities ‣ Nonnegative Bakry–Émery Curvature on Bounded-Degree Graphs Implies Volume Doubling and Poincaré Inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.5</span></a> at radius <math id="S7.p3.m39" class="ltx_Math" alttext="8s" display="inline" intent=":literal"><semantics><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><annotation encoding="application/x-tex">8s</annotation></semantics></math>. Since</span></p>
<table id="S7.Ex191" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex191.m1" class="ltx_Math" alttext="B(x_{i},8\Lambda s)\subset B(o,2r)" display="block" intent=":literal"><semantics><mrow><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">B(x_{i},8\Lambda s)\subset B(o,2r)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p3.26" class="ltx_p"><span id="S7.p3.26.1" class="ltx_text">because <math id="S7.p3.m40" class="ltx_Math" alttext="8\Lambda s\leq r/4" display="inline" intent=":literal"><semantics><mrow><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>≤</mo><mrow><mi>r</mi><mo>/</mo><mn>4</mn></mrow></mrow><annotation encoding="application/x-tex">8\Lambda s\leq r/4</annotation></semantics></math>, we obtain</span></p>
<table id="S7.Ex192" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex192.m1" class="ltx_Math" alttext="\sum_{x\in W}|f(x)-m_{W}|^{2}\leq C_{0}(8s)^{2}\mathcal{E}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>x</mi><mo>∈</mo><mi>W</mi></mrow></munder><msup><mrow><mo lspace="0em" stretchy="false">|</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>m</mi><mi>W</mi></msub></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow><mo>≤</mo><mrow><msub><mi>C</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{x\in W}|f(x)-m_{W}|^{2}\leq C_{0}(8s)^{2}\mathcal{E}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p3.27" class="ltx_p"><span id="S7.p3.27.1" class="ltx_text">Therefore</span></p>
<table id="S7.E92" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(92)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E92.m1" class="ltx_Math" alttext="|m_{i}-m_{j}|^{2}\leq\frac{256C_{0}K_{D}^{q}s^{2}}{\#B}\mathcal{E}" display="block" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">|</mo><mrow><msub><mi>m</mi><mi>i</mi></msub><mo>−</mo><msub><mi>m</mi><mi>j</mi></msub></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo>≤</mo><mrow><mfrac><mrow><mn>256</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>K</mi><mi>D</mi><mi>q</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>s</mi><mn>2</mn></msup></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></mrow><annotation encoding="application/x-tex">|m_{i}-m_{j}|^{2}\leq\frac{256C_{0}K_{D}^{q}s^{2}}{\#B}\mathcal{E}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p3.28" class="ltx_p"><span id="S7.p3.28.1" class="ltx_text">whenever the centres are linked.
Join <math id="S7.p3.m41" class="ltx_Math" alttext="x_{i}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>i</mi></msub><annotation encoding="application/x-tex">x_{i}</annotation></semantics></math> to <math id="S7.p3.m42" class="ltx_Math" alttext="x_{1}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>1</mn></msub><annotation encoding="application/x-tex">x_{1}</annotation></semantics></math> by a simple centre path. It has at most <math id="S7.p3.m43" class="ltx_Math" alttext="n-1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n-1</annotation></semantics></math> links. Cauchy–Schwarz and
(<a href="#S7.E92" title="In Proof. ‣ 7. Reduction to dilation two ‣ Nonnegative Bakry–Émery Curvature on Bounded-Degree Graphs Implies Volume Doubling and Poincaré Inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">92</span></a>) yield</span></p>
<table id="S7.E93" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(93)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E93.m1" class="ltx_Math" alttext="|m_{i}-m_{1}|^{2}\leq\frac{256C_{0}K_{D}^{q}n^{2}s^{2}}{\#B}\mathcal{E}." display="block" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">|</mo><mrow><msub><mi>m</mi><mi>i</mi></msub><mo>−</mo><msub><mi>m</mi><mn>1</mn></msub></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo>≤</mo><mrow><mfrac><mrow><mn>256</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>K</mi><mi>D</mi><mi>q</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>s</mi><mn>2</mn></msup></mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|m_{i}-m_{1}|^{2}\leq\frac{256C_{0}K_{D}^{q}n^{2}s^{2}}{\#B}\mathcal{E}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p3.29" class="ltx_p"><span id="S7.p3.29.1" class="ltx_text">Since <math id="S7.p3.m44" class="ltx_Math" alttext="f_{B}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>B</mi></msub><annotation encoding="application/x-tex">f_{B}</annotation></semantics></math> minimises the squared error over constants,</span></p>
<table id="S7.EGx25" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S7.Ex193"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.Ex193.m1" class="ltx_Math" alttext="\displaystyle\sum_{x\in B}|f(x)-f_{B}|^{2}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>x</mi><mo>∈</mo><mi>B</mi></mrow></munder></mstyle><msup><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>f</mi><mi>B</mi></msub></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{x\in B}|f(x)-f_{B}|^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex193.m2" class="ltx_Math" alttext="\displaystyle\leq\sum_{x\in B}|f(x)-m_{1}|^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>x</mi><mo>∈</mo><mi>B</mi></mrow></munder></mstyle><msup><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>m</mi><mn>1</mn></msub></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{x\in B}|f(x)-m_{1}|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex194"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex194.m1" class="ltx_Math" alttext="\displaystyle\leq 2\sum_{i=1}^{n}\sum_{x\in A_{i}}|f(x)-m_{i}|^{2}+2\sum_{i=1}^{n}\#A_{i}|m_{i}-m_{1}|^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>x</mi><mo>∈</mo><msub><mi>A</mi><mi>i</mi></msub></mrow></munder></mstyle><msup><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>m</mi><mi>i</mi></msub></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><mrow><msub><mi>m</mi><mi>i</mi></msub><mo>−</mo><msub><mi>m</mi><mn>1</mn></msub></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\sum_{i=1}^{n}\sum_{x\in A_{i}}|f(x)-m_{i}|^{2}+2\sum_{i=1}^{n}\#A_{i}|m_{i}-m_{1}|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p3.30" class="ltx_p"><span id="S7.p3.30.1" class="ltx_text">Using (<a href="#S7.E91" title="In Proof. ‣ 7. Reduction to dilation two ‣ Nonnegative Bakry–Émery Curvature on Bounded-Degree Graphs Implies Volume Doubling and Poincaré Inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">91</span></a>), (<a href="#S7.E93" title="In Proof. ‣ 7. Reduction to dilation two ‣ Nonnegative Bakry–Émery Curvature on Bounded-Degree Graphs Implies Volume Doubling and Poincaré Inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">93</span></a>), and
<math id="S7.p3.m45" class="ltx_Math" alttext="\sum_{i}\#A_{i}=\#B" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mi>i</mi></msub><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>i</mi></msub></mrow></mrow><mo>=</mo><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mrow><annotation encoding="application/x-tex">\sum_{i}\#A_{i}=\#B</annotation></semantics></math>,</span></p>
<table id="S7.EGx26" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S7.Ex195"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S7.Ex195.m1" class="ltx_Math" alttext="\displaystyle\sum_{x\in B}|f(x)-f_{B}|^{2}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>x</mi><mo>∈</mo><mi>B</mi></mrow></munder></mstyle><msup><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>f</mi><mi>B</mi></msub></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{x\in B}|f(x)-f_{B}|^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex195.m2" class="ltx_Math" alttext="\displaystyle\leq\bigl(8C_{0}n+512C_{0}K_{D}^{q}n^{2}\bigr)s^{2}\mathcal{E}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mrow><mn>512</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>K</mi><mi>D</mi><mi>q</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mn>2</mn></msup></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>s</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\bigl(8C_{0}n+512C_{0}K_{D}^{q}n^{2}\bigr)s^{2}\mathcal{E}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S7.Ex196"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S7.Ex196.m1" class="ltx_Math" alttext="\displaystyle\leq C_{0}\bigl(8M_{\mathrm{cov}}+512K_{D}^{q_{0}}M_{\mathrm{cov}}^{2}\bigr)r^{2}\mathcal{E}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>C</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>cov</mi></msub></mrow><mo>+</mo><mrow><mn>512</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>K</mi><mi>D</mi><msub><mi>q</mi><mn>0</mn></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>M</mi><mi>cov</mi><mn>2</mn></msubsup></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq C_{0}\bigl(8M_{\mathrm{cov}}+512K_{D}^{q_{0}}M_{\mathrm{cov}}^{2}\bigr)r^{2}\mathcal{E}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p3.31" class="ltx_p"><span id="S7.p3.31.1" class="ltx_text">This proves the theorem for <math id="S7.p3.m46" class="ltx_Math" alttext="r\geq R_{*}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>≥</mo><msub><mi>R</mi><mo>∗</mo></msub></mrow><annotation encoding="application/x-tex">r\geq R_{*}</annotation></semantics></math>.
Now let <math id="S7.p3.m47" class="ltx_Math" alttext="1\leq r&lt;R_{*}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>r</mi><mo>&lt;</mo><msub><mi>R</mi><mo>∗</mo></msub></mrow><annotation encoding="application/x-tex">1\leq r&lt;R_{*}</annotation></semantics></math>. For each <math id="S7.p3.m48" class="ltx_Math" alttext="x\in B(o,r)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo>,</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x\in B(o,r)</annotation></semantics></math>, choose a geodesic <math id="S7.p3.m49" class="ltx_Math" alttext="\gamma_{x}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mi>x</mi></msub><annotation encoding="application/x-tex">\gamma_{x}</annotation></semantics></math> from <math id="S7.p3.m50" class="ltx_Math" alttext="o" display="inline" intent=":literal"><semantics><mi>o</mi><annotation encoding="application/x-tex">o</annotation></semantics></math> to
<math id="S7.p3.m51" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>. Every vertex of <math id="S7.p3.m52" class="ltx_Math" alttext="\gamma_{x}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mi>x</mi></msub><annotation encoding="application/x-tex">\gamma_{x}</annotation></semantics></math> lies in <math id="S7.p3.m53" class="ltx_Math" alttext="B(o,r)" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo>,</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B(o,r)</annotation></semantics></math>, and Cauchy–Schwarz gives</span></p>
<table id="S7.Ex197" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex197.m1" class="ltx_Math" alttext="|f(x)-f(o)|^{2}\leq r\sum_{\{u,v\}\in\gamma_{x}}\bigl(f(u)-f(v)\bigr)^{2}\leq r\mathcal{E}_{B(o,r)}(f)." display="block" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo>≤</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mi>u</mi><mo>,</mo><mi>v</mi></mrow><mo stretchy="false">}</mo></mrow><mo>∈</mo><msub><mi>γ</mi><mi>x</mi></msub></mrow></munder><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>≤</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo>,</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|f(x)-f(o)|^{2}\leq r\sum_{\{u,v\}\in\gamma_{x}}\bigl(f(u)-f(v)\bigr)^{2}\leq r\mathcal{E}_{B(o,r)}(f).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p3.32" class="ltx_p"><span id="S7.p3.32.1" class="ltx_text">Because the mean minimises the squared error,</span></p>
<table id="S7.Ex198" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex198.m1" class="ltx_Math" alttext="\sum_{x\in B(o,r)}|f(x)-f_{B(o,r)}|^{2}\leq r\,\#B(o,r)\,\mathcal{E}_{B(o,r)}(f)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>x</mi><mo>∈</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo>,</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><msup><mrow><mo lspace="0em" stretchy="false">|</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>f</mi><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo>,</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow><mo>≤</mo><mrow><mi>r</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo>,</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo>,</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{x\in B(o,r)}|f(x)-f_{B(o,r)}|^{2}\leq r\,\#B(o,r)\,\mathcal{E}_{B(o,r)}(f).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p3.33" class="ltx_p"><span id="S7.p3.33.1" class="ltx_text">The degree bound gives</span></p>
<table id="S7.Ex199" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex199.m1" class="ltx_Math" alttext="\#B(o,r)\leq V_{*}:=\sum_{k=0}^{R_{*}-1}d_{*}^{k}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo>,</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><msub><mi>V</mi><mo>∗</mo></msub><mo rspace="0.111em">:=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><msub><mi>R</mi><mo>∗</mo></msub><mo>−</mo><mn>1</mn></mrow></munderover><msubsup><mi>d</mi><mo>∗</mo><mi>k</mi></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\#B(o,r)\leq V_{*}:=\sum_{k=0}^{R_{*}-1}d_{*}^{k}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p3.34" class="ltx_p"><span id="S7.p3.34.1" class="ltx_text">Since <math id="S7.p3.m54" class="ltx_Math" alttext="r\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">r\geq 1</annotation></semantics></math> and <math id="S7.p3.m55" class="ltx_Math" alttext="B(o,r)\subset B(o,2r)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo>,</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">B(o,r)\subset B(o,2r)</annotation></semantics></math>,</span></p>
<table id="S7.Ex200" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex200.m1" class="ltx_Math" alttext="\sum_{x\in B(o,r)}|f(x)-f_{B(o,r)}|^{2}\leq V_{*}r^{2}\mathcal{E}_{B(o,2r)}(f)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>x</mi><mo>∈</mo><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo>,</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><msup><mrow><mo lspace="0em" stretchy="false">|</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>f</mi><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo>,</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow><mo>≤</mo><mrow><msub><mi>V</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>o</mi><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{x\in B(o,r)}|f(x)-f_{B(o,r)}|^{2}\leq V_{*}r^{2}\mathcal{E}_{B(o,2r)}(f).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.p3.35" class="ltx_p"><span id="S7.p3.35.1" class="ltx_text">Combining this estimate with the case <math id="S7.p3.m56" class="ltx_Math" alttext="d_{*}\leq 1" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mo>∗</mo></msub><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d_{*}\leq 1</annotation></semantics></math>, one valid choice is</span></p>
<table id="S7.Ex201" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex201.m1" class="ltx_Math" alttext="C_{P}(d_{*}):=\begin{cases}1,&amp;d_{*}\leq 1,\\[2.84526pt]
