<div id="S6.SS2.p4" class="ltx_para">
<p id="S6.SS2.p4.1" class="ltx_p"><span id="S6.SS2.p4.1.1" class="ltx_text">For <math id="S6.SS2.p4.m1" class="ltx_Math" alttext="x,y\in B" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow><mo>∈</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">x,y\in B</annotation></semantics></math>,</span></p>
