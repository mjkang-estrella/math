<td id="S1.T1.2.3.1" class="ltx_td ltx_align_left ltx_align_top" style="padding:0.75pt 4.0pt;">
<span id="S1.T1.2.3.1.1" class="ltx_inline-block ltx_align_top" style="width:69.0pt;">
