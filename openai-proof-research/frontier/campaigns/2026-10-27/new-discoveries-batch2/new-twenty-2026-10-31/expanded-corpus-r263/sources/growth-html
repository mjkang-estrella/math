<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E12.m1" class="ltx_Math" alttext="\displaystyle 4\Gamma_{2}(f,e_{x})(x)" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Γ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><msub><mi>e</mi><mi>x</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 4\Gamma_{2}(f,e_{x})(x)</annotation></semantics></math></td>
