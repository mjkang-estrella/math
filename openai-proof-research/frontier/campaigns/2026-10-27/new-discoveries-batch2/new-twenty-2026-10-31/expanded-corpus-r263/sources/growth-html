<div id="S6.Thmtheorem1.p1" class="ltx_para">
<p id="S6.Thmtheorem1.p1.1" class="ltx_p"><span id="S6.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">For every bounded <math id="S6.Thmtheorem1.p1.m1" class="ltx_Math" alttext="h:V\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>V</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">h:V\to\mathbb{R}</annotation></semantics></math> and every <math id="S6.Thmtheorem1.p1.m2" class="ltx_Math" alttext="t&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t&gt;0</annotation></semantics></math>,</span></p>
