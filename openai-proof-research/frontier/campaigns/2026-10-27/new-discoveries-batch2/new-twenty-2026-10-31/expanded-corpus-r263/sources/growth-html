<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex42.m1" class="ltx_Math" alttext="\sum_{y}r(x,y)=\frac{1}{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">∑</mo><mi>y</mi></munder><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{y}r(x,y)=\frac{1}{2}.</annotation></semantics></math></td>
