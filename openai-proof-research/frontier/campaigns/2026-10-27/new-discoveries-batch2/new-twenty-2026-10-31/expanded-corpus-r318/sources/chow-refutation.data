harray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.89442 -0.4472 0.4472 0.89442 66.41 -64.9)"><path d="M 6.58 0 L 1.56 1.87 L 2.98 0 L 1.56 -1.87 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.7 0.0 0.0 0.7 34.87 -67.96)"><foreignObject style="--ltx-fo-width:1.03em;--ltx-fo-height:0.66em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.51" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="13.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F1.pic1.m17" class="ltx_Math" alttext="\operatorname{Tr}" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">Tr</mi><annotation encoding="application/x-tex">\operatorname{Tr}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.7pt"><path style="fill:none" d="M 180.93 -44.57 L 137.83 -66.12"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-0.89442 -0.4472 0.4472 -0.89442 140.28 -64.9)"><path d="M 6.58 0 L 1.56 1.87 L 2.98 0 L 1.56 -1.87 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.7 0.0 0.0 0.7 162.59 -67.96)"><foreignObject style="--ltx-fo-width:1.03em;--ltx-fo-height:0.66em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.51" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="13.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F1.pic1.m18" class="ltx_Math" alttext="\operatorname{Tr}" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">Tr</mi><annotation encoding="application/x-tex">\operatorname{Tr}</annotation></semantics></math></span></span></foreignObject></g></g></g></svg></span>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">Figure 1. </span>A coalescence of <math id="S3.F1.m3" class="ltx_Math" alttext="\textrm{U}_{3,4}" display="inline" intent=":literal"><semantics><msub><mtext>U</mtext><mrow><mn>3</mn><mo>,</mo><mn>4</mn></mrow></msub><annotation encoding="application/x-tex">\textrm{U}_{3,4}</annotation></semantics></math>. Both <math id="S3.F1.m4" class="ltx_Math" alttext="\textrm{U}_{3,4}" display="inline" intent=":literal"><semantics><msub><mtext>U</mtext><mrow><mn>3</mn><mo>,</mo><mn>4</mn></mrow></msub><annotation encoding="application/x-tex">\textrm{U}_{3,4}</annotation></semantics></math> and its coalescence have the same truncation.</figcaption>
</figure>
</div>
<div id="S3.SS1.p2" class="ltx_para">
<p id="S3.SS1.p2.1" class="ltx_p">The following example shows that hyperplane coalescence need not always exist for an arbitrary collection <math id="S3.SS1.p2.m1" class="ltx_Math" alttext="\mathcal{H}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℋ</mi><annotation encoding="application/x-tex">\mathcal{H}</annotation></semantics></math> of proper spanning subsets of <math id="S3.SS1.p2.m2" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>.</p>
</div>
<div id="S3.Thmthm5" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm5.2" class="ltx_text ltx_font_bold">Example 3.5</span></span></h6>
<div id="S3.Thmthm5.p1" class="ltx_para">
<p id="S3.Thmthm5.p1.1" class="ltx_p">Let <math id="S3.Thmthm5.p1.m1" class="ltx_Math" alttext="\textrm{M}=\textrm{U}_{3,4}" display="inline" intent=":literal"><semantics><mrow><mtext>M</mtext><mo>=</mo><msub><mtext>U</mtext><mrow><mn>3</mn><mo>,</mo><mn>4</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\textrm{M}=\textrm{U}_{3,4}</annotation></semantics></math> on <math id="S3.Thmthm5.p1.m2" class="ltx_Math" alttext="E=[4]" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mn>4</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">E=[4]</annotation></semantics></math>, and consider</p>
<table id="S3.Ex102" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex102.m1" class="ltx_Math" alttext="\mathcal{H}=\bigl\{123,124\bigr\}." display="block" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mn>123,124</mn><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{H}=\bigl\{123,124\bigr\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm5.p1.2" class="ltx_p">Both members of <math id="S3.Thmthm5.p1.m3" class="ltx_Math" alttext="\mathcal{H}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℋ</mi><annotation encoding="application/x-tex">\mathcal{H}</annotation></semantics></math> are proper subsets of full rank <math id="S3.Thmthm5.p1.m4" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>.
However, hyperplane coalescence along <math id="S3.Thmthm5.p1.m5" class="ltx_Math" alttext="\mathcal{H}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℋ</mi><annotation encoding="application/x-tex">\mathcal{H}</annotation></semantics></math> does not exist. Indeed, any such matroid <math id="S3.Thmthm5.p1.m6" class="ltx_Math" alttext="\textrm{M}^{\prime}" display="inline" intent=":literal"><semantics><msup><mtext>M</mtext><mo>′</mo></msup><annotation encoding="application/x-tex">\textrm{M}^{\prime}</annotation></semantics></math> would be simple,
since its flats of rank <math id="S3.Thmthm5.p1.m7" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> are the same as those of <span id="S3.Thmthm5.p1.2.1" class="ltx_text ltx_markedasmath">M</span>. The two blocks
would then be distinct flats of rank <math id="S3.Thmthm5.p1.m9" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> containing the
independent pair <math id="S3.Thmthm5.p1.m10" class="ltx_Math" alttext="\{1,2\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{1,2\}</annotation></semantics></math>. Both would therefore equal
<math id="S3.Thmthm5.p1.m11" class="ltx_Math" alttext="\operatorname{cl}_{\textrm{M}^{\prime}}(\{1,2\})" display="inline" intent=":literal"><semantics><mrow><msub><mi>cl</mi><msup><mtext>M</mtext><mo>′</mo></msup></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow><mo stretchy="false">}</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{cl}_{\textrm{M}^{\prime}}(\{1,2\})</annotation></semantics></math>, a contradiction.</p>
</div>
</div>
<div id="S3.Thmthm6" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm6.2" class="ltx_text ltx_font_bold">Example 3.6</span></span></h6>
<div id="S3.Thmthm6.p1" class="ltx_para">
<p id="S3.Thmthm6.p1.1" class="ltx_p">In Crapo’s original work on detruncations, there is an example with all <math id="S3.Thmthm6.p1.m1" class="ltx_Math" alttext="13" display="inline" intent=":literal"><semantics><mn>13</mn><annotation encoding="application/x-tex">13</annotation></semantics></math> detruncations of the following combinatorial geometry of rank <math id="S3.Thmthm6.p1.m2" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>.</p>
<div id="S3.Thmthm6.p1.2" class="ltx_logical-block">
            
<figure id="S3.Thmthm6.p1.fig1" class="ltx_figure ltx_align_center"><span class="ltx_inline-block"><svg id="S3.Thmthm6.p1.pic1" class="ltx_picture" height="104.64" overflow="visible" version="1.1" viewBox="0 0 137.8 104.64" width="137.8"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.6pt" transform="translate(0,104.64) matrix(1 0 0 -1 0 0) translate(68.6,0) translate(0,47.99)"><path style="fill:none" d="M -44.29 0 L 8.86 -25.1 L 45.03 -10.33 L 41.34 16.98 L 8.12 28.05 L -23.62 20.67 Z"></path><g style="--ltx-fill-color:#000000;" fill="#000000"><path style="stroke:none" d="M -40.96 0 C -40.96 1.84 -42.45 3.33 -44.29 3.33 C -46.13 3.33 -47.62 1.84 -47.62 0 C -47.62 -1.84 -46.13 -3.33 -44.29 -3.33 C -42.45 -3.33 -40.96 -1.84 -40.96 0 Z M -44.29 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -63.99 -2.68)"><foreignObject style="--ltx-fo-width:0.53em;--ltx-fo-height:0.42em;--ltx-fo-depth:0em;font-size:9.25pt;" height="5.36" overflow="visible" transform="matrix(1 0 0 -1 0 5.36)" width="6.78"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Thmthm6.p1.pic1.m1" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#000000;" fill="#000000"><path style="stroke:none" d="M -14.39 -12.55 C -14.39 -10.71 -15.88 -9.22 -17.72 -9.22 C -19.55 -9.22 -21.04 -10.71 -21.04 -12.55 C -21.04 -14.39 -19.55 -15.88 -17.72 -15.88 C -15.88 -15.88 -14.39 -14.39 -14.39 -12.55 Z M -17.72 -12.55"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -33.81 -31.81)"><foreignObject style="--ltx-fo-width:0.43em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="5.48"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Thmthm6.p1.pic1.m2" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#000000;" fill="#000000"><path style="stroke:none" d="M 12.19 -25.1 C 12.19 -23.26 10.7 -21.77 8.86 -21.77 C 7.02 -21.77 5.53 -23.26 5.53 -25.1 C 5.53 -26.94 7.02 -28.43 8.86 -28.43 C 10.7 -28.43 12.19 -26.94 12.19 -25.1 Z M 8.86 -25.1"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 6.09 -43.38)"><foreignObject style="--ltx-fo-width:0.43em;--ltx-fo-height:0.42em;--ltx-fo-depth:0em;font-size:9.25pt;" height="5.36" overflow="visible" transform="matrix(1 0 0 -1 0 5.36)" width="5.54"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Thmthm6.p1.pic1.m3" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#000000;" fill="#000000"><path style="stroke:none" d="M 48.36 -10.33 C 48.36 -8.5 46.87 -7.01 45.03 -7.01 C 43.19 -7.01 41.7 -8.5 41.7 -10.33 C 41.7 -12.17 43.19 -13.66 45.03 -13.66 C 46.87 -13.66 48.36 -12.17 48.36 -10.33 Z M 45.03 -10.33"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 57.95 -14.66)"><foreignObject style="--ltx-fo-width:0.52em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="6.63"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Thmthm6.p1.pic1.m4" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#000000;" fill="#000000"><path style="stroke:none" d="M 44.67 16.98 C 44.67 18.82 43.18 20.3 41.34 20.3 C 39.5 20.3 38.01 18.82 38.01 16.98 C 38.01 15.14 39.5 13.65 41.34 13.65 C 43.18 13.65 44.67 15.14 44.67 16.98 Z M 41.34 16.98"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 51.95 27.59)"><foreignObject style="--ltx-fo-width:0.46em;--ltx-fo-height:0.42em;--ltx-fo-depth:0em;font-size:9.25pt;" height="5.36" overflow="visible" transform="matrix(1 0 0 -1 0 5.36)" width="5.95"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Thmthm6.p1.pic1.m5" class="ltx_Math" alttext="e" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">e</mi><annotation encoding="application/x-tex">e</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#000000;" fill="#000000"><path style="stroke:none" d="M 11.45 28.05 C 11.45 29.89 9.96 31.38 8.12 31.38 C 6.28 31.38 4.79 29.89 4.79 28.05 C 4.79 26.21 6.28 24.72 8.12 24.72 C 9.96 24.72 11.45 26.21 11.45 28.05 Z M 8.12 28.05"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 4.34 43.39)"><foreignObject style="--ltx-fo-width:0.59em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="7.57"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Thmthm6.p1.pic1.m6" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#000000;" fill="#000000"><path style="stroke:none" d="M -20.3 20.67 C -20.3 22.51 -21.78 24 -23.62 24 C -25.46 24 -26.95 22.51 -26.95 20.67 C -26.95 18.83 -25.46 17.34 -23.62 17.34 C -21.78 17.34 -20.3 18.83 -20.3 20.67 Z M -23.62 20.67"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -40.78 33.7)"><foreignObject style="--ltx-fo-width:0.51em;--ltx-fo-height:0.42em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="7.78" overflow="visible" transform="matrix(1 0 0 -1 0 5.36)" width="6.55"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.Thmthm6.p1.pic1.m7" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math></span></span></foreignObject></g></g></svg></span>
</figure>
          
</div>
</div>
<div id="S3.Thmthm6.p2" class="ltx_para">
<p id="S3.Thmthm6.p2.1" class="ltx_p">The <em id="S3.Thmthm6.p2.1.1" class="ltx_emph ltx_font_italic">free detruncation</em> <math id="S3.Thmthm6.p2.m1" class="ltx_Math" alttext="\mathrm{N}" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">\mathrm{N}</annotation></semantics></math> of a matroid <span id="S3.Thmthm6.p2.1.2" class="ltx_text ltx_markedasmath">M</span> of rank <math id="S3.Thmthm6.p2.m3" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> is a matroid of rank <math id="S3.Thmthm6.p2.m4" class="ltx_Math" alttext="r+1" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">r+1</annotation></semantics></math> such that for every detruncation <math id="S3.Thmthm6.p2.m5" class="ltx_Math" alttext="\mathrm{N}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>N</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathrm{N}^{\prime}</annotation></semantics></math> of <span id="S3.Thmthm6.p2.1.3" class="ltx_text ltx_markedasmath">M</span>, the independent sets of <math id="S3.Thmthm6.p2.m7" class="ltx_Math" alttext="\mathrm{N}" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">\mathrm{N}</annotation></semantics></math> contain those of <math id="S3.Thmthm6.p2.m8" class="ltx_Math" alttext="\mathrm{N^{\prime}}" display="inline" intent=":literal"><semantics><msup><mi>N</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathrm{N^{\prime}}</annotation></semantics></math>:</p>
<table id="S3.Ex103" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex103.m1" class="ltx_Math" alttext="\mathcal{I}(N^{\prime})\subseteq\mathcal{I}(N)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>N</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>⊆</mo><mrow><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{I}(N^{\prime})\subseteq\mathcal{I}(N).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm6.p2.2" class="ltx_p">Figure <a href="#S3.F2" title="Figure 2 ‣ Example 3.6 ‣ 3.1. Hyperplane coalescence ‣ 3. Matroid operations: hyperplane coalescence, absorption ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> shows all the detruncations of Crapo’s geometry of rank <math id="S3.Thmthm6.p2.m9" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>, with its free detruncation on top. All the detruncations can be viewed as hyperplane coalescences of the free detruncation along a set of blocks <math id="S3.Thmthm6.p2.m10" class="ltx_Math" alttext="\mathcal{H}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℋ</mi><annotation encoding="application/x-tex">\mathcal{H}</annotation></semantics></math>.</p>
</div>
<figure id="S3.F2" class="ltx_figure ltx_align_center"><span class="ltx_inline-block"><svg id="S3.F2.pic1" class="ltx_picture" height="609.15" overflow="visible" version="1.1" viewBox="0 0 521.22 609.15" width="521.22"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.4pt" transform="translate(0,609.15) matrix(1 0 0 -1 0 0) translate(-14.98,0) translate(0,616.13)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.7 0.0 0.0 0.7 192.92 -18.34)"><foreignObject style="--ltx-fo-width:14.5em;--ltx-fo-height:0.71em;--ltx-fo-depth:0.2em;font-size:11.75pt;" height="14.94" overflow="visible" transform="matrix(1 0 0 -1 0 11.62)" width="235.74"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F2.pic1.1" class="ltx_text" style="font-size:120%;">Crapo's rank-four detruncations</span></span></span></foreignObject></g><g style="--ltx-fg-color:#000000;" color="#000000" stroke-width="0.398pt"><path style="fill:none" d="M 255.45 -55.59 L 258.24 -73.54 L 295.73 -84.31 L 295.73 -42.03"></path></g><g style="--ltx-fg-color:#000000;" color="#000000" stroke-width="0.398pt"><path style="fill:none" d="M 255.45 -55.59 L 272.2 -49.95"></path></g><g style="--ltx-fg-color:#000000;" color="#000000" stroke-width="0.398pt"><path style="fill:none" d="M 280.57 -47.13 L 295.73 -42.03"></path></g><g style="--ltx-fg-color:#000000;" color="#000000" stroke-width="0.398pt"><path style="fill:none" d="M 258.24 -73.54 L 295.73 -42.03"></path></g><g style="--ltx-fg-color:#000000;" color="#000000" stroke-width="0.398pt"><path style="fill:none" d="M 276.19 -34.45 L 276.19 -54.39"></path></g><g style="--ltx-fg-color:#000000;" color="#000000" stroke-width="0.398pt"><path style="fill:none" d="M 276.19 -61.57 L 276.19 -65.56 L 276.19 -74.34"></path></g><g style="--ltx-fg-color:#000000;" color="#00000