7"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.7 0.0 0.0 0.7 444.09 -580.34)"><foreignObject style="--ltx-fo-width:0.46em;--ltx-fo-height:0.42em;--ltx-fo-depth:0em;font-size:9.25pt;" height="5.36" overflow="visible" transform="matrix(1 0 0 -1 0 5.36)" width="5.95"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F2.pic1.m101" class="ltx_Math" alttext="e" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">e</mi><annotation encoding="application/x-tex">e</annotation></semantics></math></span></span></foreignObject></g><path style="stroke:none" d="M 423.29 -522.55 C 423.29 -521.31 422.28 -520.29 421.03 -520.29 C 419.78 -520.29 418.77 -521.31 418.77 -522.55 C 418.77 -523.8 419.78 -524.81 421.03 -524.81 C 422.28 -524.81 423.29 -523.8 423.29 -522.55 Z M 421.03 -522.55"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.7 0.0 0.0 0.7 410.68 -522.59)"><foreignObject style="--ltx-fo-width:0.59em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="7.57"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F2.pic1.m102" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math></span></span></foreignObject></g><path style="stroke:none" d="M 490.05 -540.64 C 490.05 -539.39 489.04 -538.38 487.79 -538.38 C 486.54 -538.38 485.53 -539.39 485.53 -540.64 C 485.53 -541.89 486.54 -542.9 487.79 -542.9 C 489.04 -542.9 490.05 -541.89 490.05 -540.64 Z M 487.79 -540.64"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.7 0.0 0.0 0.7 493.49 -541.67)"><foreignObject style="--ltx-fo-width:0.51em;--ltx-fo-height:0.42em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="7.78" overflow="visible" transform="matrix(1 0 0 -1 0 5.36)" width="6.55"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F2.pic1.m103" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.7 0.0 0.0 0.7 426.89 -603.76)"><foreignObject style="--ltx-fo-width:4.98em;--ltx-fo-height:0.81em;--ltx-fo-depth:0.27em;font-size:9.25pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="63.78"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F2.pic1.m104" class="ltx_Math" alttext="\mathcal{H}=\bigl\{abcde\bigr\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℋ</mi><mo mathsize="0.900em">=</mo><mrow><mo stretchy="false">{</mo><mrow><mi mathsize="0.900em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">b</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">e</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{H}=\bigl\{abcde\bigr\}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">Figure 2. </span>The rank-<math id="S3.F2.m2" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math> detruncations of Crapo’s geometry</figcaption>
</figure>
</div>
<div id="S3.SS1.p3" class="ltx_para">
<p id="S3.SS1.p3.1" class="ltx_p">The following lemma gives a sufficient condition on <math id="S3.SS1.p3.m1" class="ltx_Math" alttext="\mathcal{H}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℋ</mi><annotation encoding="application/x-tex">\mathcal{H}</annotation></semantics></math> for a coalescence to exist, and it shows that when such a matroid exists, it is unique.</p>
</div>
<div id="S3.Thmthm7" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm7.2" class="ltx_text ltx_font_bold">Lemma 3.7</span></span></h6>
<div id="S3.Thmthm7.p1" class="ltx_para">
<p id="S3.Thmthm7.p1.1" class="ltx_p"><span id="S3.Thmthm7.p1.1.1" class="ltx_text ltx_font_italic">Let <span id="S3.Thmthm7.p1.1.1.1" class="ltx_text ltx_markedasmath ltx_font_upright">M</span> have rank <math id="S3.Thmthm7.p1.m2" class="ltx_Math" alttext="r\geqslant 2" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>⩾</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">r\geqslant 2</annotation></semantics></math> on <math id="S3.Thmthm7.p1.m3" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>, and let <math id="S3.Thmthm7.p1.m4" class="ltx_Math" alttext="\mathcal{H}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℋ</mi><annotation encoding="application/x-tex">\mathcal{H}</annotation></semantics></math> be a
family of proper spanning subsets satisfying</span></p>
<ol id="S3.I3" class="ltx_enumerate">
<li id="S3.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S3.I3.i1.p1" class="ltx_para">
<p id="S3.I3.i1.p1.1" class="ltx_p"><math id="S3.I3.i1.p1.m1" class="ltx_Math" alttext="\operatorname{rk}_{\textrm{M}}(H\cap H^{\prime})\leqslant r-2" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>rk</mi><mtext>M</mtext></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>H</mi><mo>∩</mo><msup><mi>H</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⩽</mo><mrow><mi>r</mi><mo>−</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">\operatorname{rk}_{\textrm{M}}(H\cap H^{\prime})\leqslant r-2</annotation></semantics></math><span id="S3.I3.i1.p1.1.1" class="ltx_text ltx_font_italic"> for distinct
</span><math id="S3.I3.i1.p1.m2" class="ltx_Math" alttext="H,H^{\prime}\in\mathcal{H}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>H</mi><mo>,</mo><msup><mi>H</mi><mo>′</mo></msup></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow><annotation encoding="application/x-tex">H,H^{\prime}\in\mathcal{H}</annotation></semantics></math><span id="S3.I3.i1.p1.1.2" class="ltx_text ltx_font_italic">;</span></p>
</div></li>
<li id="S3.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S3.I3.i2.p1" class="ltx_para">
<p id="S3.I3.i2.p1.1" class="ltx_p"><math id="S3.I3.i2.p1.m1" class="ltx_Math" alttext="\operatorname{cl}_{\textrm{M}}(I)\subseteq H" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>cl</mi><mtext>M</mtext></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊆</mo><mi>H</mi></mrow><annotation encoding="application/x-tex">\operatorname{cl}_{\textrm{M}}(I)\subseteq H</annotation></semantics></math><span id="S3.I3.i2.p1.1.1" class="ltx_text ltx_font_italic"> whenever </span><math id="S3.I3.i2.p1.m2" class="ltx_Math" alttext="I\subseteq H\in\mathcal{H}" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo>⊆</mo><mi>H</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow><annotation encoding="application/x-tex">I\subseteq H\in\mathcal{H}</annotation></semantics></math><span id="S3.I3.i2.p1.1.2" class="ltx_text ltx_font_italic">
is independent and </span><math id="S3.I3.i2.p1.m3" class="ltx_Math" alttext="|I|=r-1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>I</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">|I|=r-1</annotation></semantics></math><span id="S3.I3.i2.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
<p id="S3.Thmthm7.p1.2" class="ltx_p"><span id="S3.Thmthm7.p1.2.1" class="ltx_text ltx_font_italic">Then <math id="S3.Thmthm7.p1.m5" class="ltx_Math" alttext="\mathcal{H}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℋ</mi><annotation encoding="application/x-tex">\mathcal{H}</annotation></semantics></math> uniquely determines a hyperplane coalescence <math id="S3.Thmthm7.p1.m6" class="ltx_Math" alttext="\textrm{M}^{\prime}" display="inline" intent=":literal"><semantics><msup><mtext>M</mtext><mo>′</mo></msup><annotation encoding="application/x-tex">\textrm{M}^{\prime}</annotation></semantics></math> of <span id="S3.Thmthm7.p1.2.1.1" class="ltx_text ltx_markedasmath ltx_font_upright">M</span>, which has bases</span></p>
<table id="S3.Ex104" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex104.m1" class="ltx_Math" alttext="\mathcal{B}(\textrm{M}^{\prime})=\{B\in\mathcal{B}(\textrm{M})\colon B\notin H\in\mathcal{H}\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mtext>M</mtext><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>B</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mtext>M</mtext><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mi>B</mi><mo>∉</mo><mi>H</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{B}(\textrm{M}^{\prime})=\{B\in\mathcal{B}(\textrm{M})\colon B\notin H\in\mathcal{H}\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm7.p1.3" class="ltx_p"><span id="S3.Thmthm7.p1.3.1" class="ltx_text ltx_font_italic">and rank function</span></p>
<table id="S3.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(21)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E21.m1" class="ltx_Math" alttext="\operatorname{rk}_{\textrm{M}^{\prime}}(S)=\begin{cases}r-1,&amp;\operatorname{rk}_{\textrm{M}}(S)=r\text{ and }S\subseteq H\text{ for some }H\in\mathcal{H},\\
\operatorname{rk}_{\textrm{M}}(S),&amp;\text{otherwise.}\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>rk</mi><msup><mtext>M</mtext><mo>′</mo></msup></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><msub><mi>rk</mi><mtext>M</mtext></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="ltx_mathvariant_italic"> and </mtext><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo>⊆</mo><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="ltx_mathvariant_italic"> for some </mtext><mo lspace="0em" rspace="0em">​</mo><mi>H</mi></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi>rk</mi><mtext>M</mtext></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mtext class="ltx_mathvariant_italic">otherwise.</mtext></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\operatorname{rk}_{\textrm{M}^{\prime}}(S)=\begin{cases}r-1,&amp;\operatorname{rk}_{\textrm{M}}(S)=r\text{ and }S\subseteq H\text{ for some }H\in\mathcal{H},\\
\operatorname{rk}_{\textrm{M}}(S),&amp;\text{otherwise.}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S3.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS1.p4" class="ltx_para">
<p id="S3.SS1.p4.1" class="ltx_p"><span id="S3.SS1.p4.1.1" class="ltx_text">This follows from Crapo’s criterion <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib40" title="" class="ltx_ref">38</a>, Theorem 12]</cite> applied to <math id="S3.SS1.p4.m1" class="ltx_Math" alttext="\mathrm{Tr}(\textrm{M})" display="inline" intent=":literal"><semantics><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mtext>M</mtext><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Tr}(\textrm{M})</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S3.SS1.p5" class="ltx_para">
<p id="S3.SS1.p5.1" class="ltx_p">One advantage of the hyperplane coalescence is that it changes multichain counts in a controlled way, enabling us to apply <a href="#Thmintrothm1" title="Theorem A ‣ 1. Introduction ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">A</span></a>. Since only the hyperplanes change under coalescence, the change in the zeta polynomial is a sum of contributions from the individual blocks. Let <span id="S3.SS1.p5.1.1" class="ltx_text ltx_markedasmath">M</span> be loopless of rank <math id="S3.SS1.p5.m2" class="ltx_Math" alttext="r\geqslant 2" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>⩾</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">r\geqslant 2</annotation></semantics></math>, let <math id="S3.SS1.p5.m3" class="ltx_Math" alttext="\mathcal{H}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℋ</mi><annotation encoding="application/x-tex">\mathcal{H}</annotation></semantics></math> be a collection of blocks satisfying
<a href="#S3.Thmthm7" title="Lemma 3.7 ‣ 3.1. Hyperplane coalescence ‣ 3. Matroid operations: hyperplane coalescence, absorption ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">3.7</span></a>, and let <math id="S3.SS1.p5.m4" class="ltx_Math" alttext="\textrm{M}^{\prime}" display="inline" intent=":literal"><semantics><msup><mtext>M</mtext><mo>′</mo></msup><annotation encoding="application/x-tex">\textrm{M}^{\prime}</annotation></semantics></math> be its coalescence along <math id="S3.SS1.p5.m5" class="ltx_Math" alttext="\mathcal{H}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℋ</mi><annotation encoding="application/x-tex">\mathcal{H}</annotation></semantics></math>.</p>
</div>
<div id="S3.Thmthm8" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm8.2" class="ltx_text ltx_font_bold">Proposition 3.8</span></span></h6>
<div id="S3.Thmthm8.p1" class="ltx_para">
<p id="S3.Thmthm8.p1.1" class="ltx_p"><span id="S3.Thmthm8.p1.1.1" class="ltx_text ltx_font_italic">For every <math id="S3.Thmthm8.p1.m1" class="ltx_Math" alttext="m\geqslant 0" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>⩾</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">m\geqslant 0</annotation></semantics></math>,</span></p>
<table id="S3.E22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(22)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E22.m1" class="ltx_Math" alttext="Z_{\textrm{M}^{\prime}}(m)=Z_{\textrm{M}}(m)-\sum_{H\in\mathcal{H}}\left(Z_{\textrm{M}^{H}}(m)-\sum_{i=0}^{m}Z_{\mathrm{Tr}(\textrm{M}^{H})}(i)\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>Z</mi><msup><mtext>M</mtext><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>Z</mi><mtext>M</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">−</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>H</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow></munder><mrow><mo>(</mo><mrow><mrow><msub><mi>Z</mi><msup><mtext>M</mtext><mi>H</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">−</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>m</mi></munderover><mrow><msub><mi>Z</mi><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mtext>M</mtext><mi>H</mi></msup><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Z_{\textrm{M}^{\prime}}(m)=Z_{\textrm{M}}(m)-\sum_{H\in\mathcal{H}}\left(Z_{\textrm{M}^{H}}(m)-\sum_{i=0}^{m}Z_{\mathrm{Tr}(\textrm{M}^{H})}(i)\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S3.SS1.p6" class="ltx_para">
<p id="S3.SS1.p6.1" class="ltx_p">This will let us compute the multichain counts of our geometric families without
enumerating their lattices. To prove the proposition, we count the affected flags.</p>
</div>
<div id="S3.Thmthm9" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm9.2" class="ltx_text ltx_font_bold">Lemma 3.9</span></span></h6>
<div id="S3.Thmthm9.p1" class="ltx_para">
<p id="S3.Thmthm9.p1.2" class="ltx_p"><span id="S3.Thmthm9.p1.2.1" class="ltx_text ltx_font_italic">For every <math id="S3.Thmthm9.p1.m1" class="ltx_Math" alttext="S\subseteq[r-2]" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⊆</mo><mrow><mo stretchy="false">[</mo><mrow><mi>r</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">S\subseteq[r-2]</annotation></semantics></math>,</span></p>
<table id="S3.E23" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S3.E23X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equationgroup ltx_align_left">(23)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E23X.m2" class="ltx_Math" alttext="\displaystyle\alpha_{\textrm{M}^{\prime}}(S)" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><msup><mtext>M</mtext><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\alpha_{\textrm{M}^{\prime}}(S)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E23X.m3" class="ltx_Math" alttext="\displaystyle=\alpha_{\textrm{M}}(S)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>α</mi><mtext>M</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\alpha_{\textrm{M}}(S),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S3.E23Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E23Xa.m2" class="ltx_Math" alttext="\displaystyle\alpha_{\textrm{M}^{\prime}}(S\cup\{r-1\})" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><msup><mtext>M</mtext><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>S</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\alpha_{\textrm{M}^{\prime}}(S\cup\{r-1\})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E23Xa.m3" class="ltx_Math" alttext="\displaystyle=\alpha_{\textrm{M}}(S\cup\{r-1\})+\sum_{H\in\mathcal{H}}\bigl(\alpha_{\textrm{M}^{H}}(S)-\alpha_{\textrm{M}^{H}}(S\cup\{r-1\})\bigr)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>α</mi><mtext>M</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>S</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>H</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow></munder></mstyle><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi>α</mi><msup><mtext>M</mtext><mi>H</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>α</mi><msup><mtext>M</mtext><mi>H</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>S</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\alpha_{\textrm{M}}(S\cup\{r-1\})+\sum_{H\in\mathcal{H}}\bigl(\alpha_{\textrm{M}^{H}}(S)-\alpha_{\textrm{M}^{H}}(S\cup\{r-1\})\bigr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S3.SS1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS1.p7" class="ltx_para">
<p id="S3.SS1.p7.1" class="ltx_p"><span id="S3.SS1.p7.1.1" class="ltx_text">This follows from the fact that flats of rank less than <math id="S3.SS1.p7.m1" class="ltx_Math" alttext="r-1" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">r-1</annotation></semantics></math> are the same for <span id="S3.SS1.p7.1.1.1" class="ltx_text ltx_markedasmath">M</span> and <math id="S3.SS1.p7.m3" class="ltx_Math" alttext="\textrm{M}^{\prime}" display="inline" intent=":literal"><semantics><msup><mtext>M</mtext><mo>′</mo></msup><annotation encoding="application/x-tex">\textrm{M}^{\prime}</annotation></semantics></math>, together with the closure hypothesis in <a href="#S3.Thmthm7" title="Lemma 3.7 ‣ 3.1. Hyperplane coalescence ‣ 3. Matroid operations: hyperplane coalescence, absorption ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">3.7</span></a>.
∎</span></p>
</div>
</div>
<div id="S3.Thmthm10" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm10.2" class="ltx_text ltx_font_bold">Lemma 3.10</span></span></h6>
<div id="S3.Thmthm10.p1" class="ltx_para">
<p id="S3.Thmthm10.p1.1" class="ltx_p"><span id="S3.Thmthm10.p1.1.1" class="ltx_text ltx_font_italic">For <math id="S3.Thmthm10.p1.m1" class="ltx_Math" alttext="P=f" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>=</mo><mi>f</mi></mrow><annotation encoding="application/x-tex">P=f</annotation></semantics></math> or <math id="S3.Thmthm10.p1.m2" class="ltx_Math" alttext="P=\underline{\textrm{H}}" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>=</mo><munder accentunder="true"><mtext>H</mtext><mo stretchy="true">¯</mo></munder></mrow><annotation encoding="application/x-tex">P=\underline{\textrm{H}}</annotation></semantics></math>,</span></p>
<table id="S3.E24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(24)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E24.m1" class="ltx_Math" alttext="P(\textrm{M}^{\prime};t)=P(\textrm{M};t)-\sum_{H\in\mathcal{H}}\bigl(P(\textrm{M}^{H};t)-(1+t)P(\mathrm{Tr}(\textrm{M}^{H});t)\bigr)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mtext>M</mtext><mo>′</mo></msup><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mtext>M</mtext><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">−</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>H</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow></munder><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mtext>M</mtext><mi>H</mi></msup><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mtext>M</mtext><mi>H</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P(\textrm{M}^{\prime};t)=P(\textrm{M};t)-\sum_{H\in\mathcal{H}}\bigl(P(\textrm{M}^{H};t)-(1+t)P(\mathrm{Tr}(\textrm{M}^{H});t)\bigr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S3.SS1.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS1.p8" class="ltx_para">
<p id="S3.SS1.p8.1" class="ltx_p"><span id="S3.SS1.p8.1.1" class="ltx_text">Summing (<a href="#S3.E23" title="Equation 23 ‣ Lemma 3.9 ‣ 3.1. Hyperplane coalescence ‣ 3. Matroid operations: hyperplane coalescence, absorption ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>) by chain length gives
the assertion for <math id="S3.SS1.p8.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>. For the Chow polynomial, the weights in (<a href="#S2.E6" title="Equation 6 ‣ 2.3. Chow polynomials and augmented Chow polynomials ‣ 2. Polynomial invariants and multichain counts ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>)
satisfy, for <math id="S3.SS1.p8.m2" class="ltx_Math" alttext="S\subseteq[r-2]" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⊆</mo><mrow><mo stretchy="false">[</mo><mrow><mi>r</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">S\subseteq[r-2]</annotation></semantics></math>,</span></p>
<table id="S3.Ex105" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex105.m1" class="ltx_Math" alttext="\underline{\tau}(S\cup\{r\})=t\bigl(\underline{\tau}(S)+\underline{\tau}(S\cup\{r-1\})\bigr),\qquad\underline{\tau}(S\cup\{r-1,r\})=0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munder accentunder="true"><mi>τ</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>S</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>r</mi><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>t</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><munder accentunder="true"><mi>τ</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><munder accentunder="true"><mi>τ</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>S</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><munder accentunder="true"><mi>τ</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>S</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>r</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\underline{\tau}(S\cup\{r\})=t\bigl(\underline{\tau}(S)+\underline{\tau}(S\cup\{r-1\})\bigr),\qquad\underline{\tau}(S\cup\{r-1,r\})=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p8.2" class="ltx_p"><span id="S3.SS1.p8.2.1" class="ltx_text">Thus (<a href="#S2.E6" title="Equation 6 ‣ 2.3. Chow polynomials and augmented Chow polynomials ‣ 2. Polynomial invariants and multichain counts ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>) implies that, for any loopless
matroid <span id="S3.SS1.p8.2.1.1" class="ltx_text ltx_markedasmath">M</span> of rank <math id="S3.SS1.p8.m4" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>,</span></p>
<table id="S3.Ex106" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex106.m1" class="ltx_Math" alttext="\underline{\textrm{H}}(\textrm{M};t)-(1+t)\underline{\textrm{H}}(\mathrm{Tr}(\textrm{M});t)=\sum_{S\subseteq[r-2]}\bigl(\alpha_{\textrm{M}}(S\cup\{r-1\})-\alpha_{\textrm{M}}(S)\bigr)\underline{\tau}(S\cup\{r-1\})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munder accentunder="true"><mtext>H</mtext><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mtext>M</mtext><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mtext>H</mtext><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mtext>M</mtext><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>S</mi><mo>⊆</mo><mrow><mo stretchy="false">[</mo><mrow><mi>r</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></munder><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi>α</mi><mtext>M</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>S</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>α</mi><mtext>M</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><mi>τ</mi><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>S</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\underline{\textrm{H}}(\textrm{M};t)-(1+t)\underline{\textrm{H}}(\mathrm{Tr}(\textrm{M});t)=\sum_{S\subseteq[r-2]}\bigl(\alpha_{\textrm{M}}(S\cup\{r-1\})-\alpha_{\textrm{M}}(S)\bigr)\underline{\tau}(S\cup\{r-1\}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p8.3" class="ltx_p"><span id="S3.SS1.p8.3.1" class="ltx_text">Applying (<a href="#S3.E23" title="Equation 23 ‣ Lemma 3.9 ‣ 3.1. Hyperplane coalescence ‣ 3. Matroid operations: hyperplane coalescence, absorption ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>) with these weights
proves the result.
∎</span></p>
</div>
</div>
<div id="S3.SS1.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of <a href="#S3.Thmthm8" title="Proposition 3.8 ‣ 3.1. Hyperplane coalescence ‣ 3. Matroid operations: hyperplane coalescence, absorption ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">3.8</span></a>.</h6>
<div id="S3.SS1.p9" class="ltx_para">
<p id="S3.SS1.p9.1" class="ltx_p"><span id="S3.SS1.p9.1.1" class="ltx_text">The binomial transform (<a href="#S2.E3" title="Equation 3 ‣ 2.2. Multichain counts ‣ 2. Polynomial invariants and multichain counts ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>) is a linear map which sends <math id="S3.SS1.p9.m1" class="ltx_Math" alttext="t^{j}" display="inline" intent=":literal"><semantics><msup><mi>t</mi><mi>j</mi></msup><annotation encoding="application/x-tex">t^{j}</annotation></semantics></math> to
<math id="S3.SS1.p9.m2" class="ltx_Math" alttext="\binom{t}{j+1}" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>t</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></mfrac><mo>)</mo></mrow><annotation encoding="application/x-tex">\binom{t}{j+1}</annotation></semantics></math>, and the image of <math id="S3.SS1.p9.m3" class="ltx_Math" alttext="(1+t)t^{j}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mi>j</mi></msup></mrow><annotation encoding="application/x-tex">(1+t)t^{j}</annotation></semantics></math> under the binomial transform is a polynomial, whose evaluation at <math id="S3.SS1.p9.m4" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> is</span></p>
<table id="S3.Ex107" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex107.m1" class="ltx_Math" alttext="\binom{m}{j+1}+\binom{m}{j+2}=\binom{m+1}{j+2}=\sum_{a=0}^{m}\binom{a}{j+1}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>m</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></mfrac><mo>)</mo></mrow><mo>+</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>m</mi><mrow><mi>j</mi><mo>+</mo><mn>2</mn></mrow></mfrac><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mrow><mi>j</mi><mo>+</mo><mn>2</mn></mrow></mfrac><mo>)</mo></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>a</mi><mo>=</mo><mn>0</mn></mrow><mi>m</mi></munderover><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>a</mi><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></mfrac><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\binom{m}{j+1}+\binom{m}{j+2}=\binom{m+1}{j+2}=\sum_{a=0}^{m}\binom{a}{j+1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p9.2" class="ltx_p"><span id="S3.SS1.p9.2.1" class="ltx_text">The assertion follows by applying this transform to
(<a href="#S3.E24" title="Equation 24 ‣ Lemma 3.10 ‣ 3.1. Hyperplane coalescence ‣ 3. Matroid operations: hyperplane coalescence, absorption ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>) with <math id="S3.SS1.p9.m5" class="ltx_Math" alttext="P=f" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>=</mo><mi>f</mi></mrow><annotation encoding="application/x-tex">P=f</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="S3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.2. </span>Absorption</h3>

<div id="S3.SS2.p1" class="ltx_para">
<p id="S3.SS2.p1.1" class="ltx_p">In this subsection, we use hyperplane coalescence to construct
extensions of a matroid by adjoining auxiliary points, each lying
in the closure of every hyperplane in a prescribed family.
We call this construction <em id="S3.SS2.p1.1.1" class="ltx_emph ltx_font_italic">absorption</em>. We first adjoin
the auxiliary points as coloops and truncate back to the original
rank. The union of each selected hyperplane with its assigned
point is then a spanning subset. Under the conditions below,
these subsets can be coalesced simultaneously, placing each
auxiliary point in the required closures. We use this construction
for the affine and Gabidulin families.</p>
</div>
<div id="S3.Thmthm11" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm11.2" class="ltx_text ltx_font_bold">Proposition 3.11</span></span></h6>
<div id="S3.Thmthm11.p1" class="ltx_para">
<p id="S3.Thmthm11.p1.1" class="ltx_p"><span id="S3.Thmthm11.p1.1.1" class="ltx_text ltx_font_italic">Let <span id="S3.Thmthm11.p1.1.1.1" class="ltx_text ltx_markedasmath ltx_font_upright">G</span> have rank <math id="S3.Thmthm11.p1.m2" class="ltx_Math" alttext="r\geqslant 2" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>⩾</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">r\geqslant 2</annotation></semantics></math>, and let
<math id="S3.Thmthm11.p1.m3" class="ltx_Math" alttext="\mathcal{F}_{1},\dots,\mathcal{F}_{m}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">\mathcal{F}_{1},\dots,\mathcal{F}_{m}</annotation></semantics></math> be pairwise disjoint families of hyperplanes
such that</span></p>
<table id="S3.Ex108" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex108.m1" class="ltx_Math" alttext="\operatorname{rk}_{\textrm{G}}(F\cap F^{\prime})\leqslant r-3\qquad(F,F^{\prime}\in\mathcal{F}_{i},\ F\neq F^{\prime})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>rk</mi><mtext>G</mtext></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>F</mi><mo>∩</mo><msup><mi>F</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⩽</mo><mrow><mi>r</mi><mo>−</mo><mn>3</mn></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mo stretchy="false">(</mo><mi>F</mi><mo>,</mo><mrow><msup><mi>F</mi><mo>′</mo></msup><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msub></mrow><mo>,</mo><mrow><mi>F</mi><mo>≠</mo><msup><mi>F</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\operatorname{rk}_{\textrm{G}}(F\cap F^{\prime})\leqslant r-3\qquad(F,F^{\prime}\in\mathcal{F}_{i},\ F\neq F^{\prime}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm11.p1.2" class="ltx_p"><span id="S3.Thmthm11.p1.2.1" class="ltx_text ltx_font_italic">For a set of new points <math id="S3.Thmthm11.p1.m4" class="ltx_Math" alttext="X=\{p_{1},\dots,p_{m}\}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>p</mi><mi>m</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">X=\{p_{1},\dots,p_{m}\}</annotation></semantics></math>, put</span></p>
<table id="S3.Ex109" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex109.m1" class="ltx_math_unparsed" alttext="\textrm{M}=\mathrm{Tr}^{r}(\textrm{G}\oplus\textrm{U}_{X,X}),\qquad\mathcal{H}=\{F\cup\{p_{i}\}:F\in\mathcal{F}_{i},\ 1\leqslant i\leqslant m\}." display="block" intent=":literal"><semantics><mrow><mtext>M</mtext><mo>=</mo><msup><mi>Tr</mi><mi>r</mi></msup><mrow><mo stretchy="false">(</mo><mtext>G</mtext><mo>⊕</mo><msub><mtext>U</mtext><mrow><mi>X</mi><mo>,</mo><mi>X</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo rspace="2.167em">,</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>F</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mi>i</mi></msub><mo rspace="0.278em" stretchy="false">}</mo></mrow><mo rspace="0.278em">:</mo><mi>F</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msub><mo>,</mo><mn> 1</mn><mo>⩽</mo><mi>i</mi><mo>⩽</mo><mi>m</mi><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\textrm{M}=\mathrm{Tr}^{r}(\textrm{G}\oplus\textrm{U}_{X,X}),\qquad\mathcal{H}=\{F\cup\{p_{i}\}:F\in\mathcal{F}_{i},\ 1\leqslant i\leqslant m\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm11.p1.3" class="ltx_p"><span id="S3.Thmthm11.p1.3.1" class="ltx_text ltx_font_italic">Then the blocks in <math id="S3.Thmthm11.p1.m5" class="ltx_Math" alttext="\mathcal{H}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℋ</mi><annotation encoding="application/x-tex">\mathcal{H}</annotation></semantics></math> can be coalesced in <span id="S3.Thmthm11.p1.3.1.1" class="ltx_text ltx_markedasmath ltx_font_upright">M</span>.
The resulting matroid <math id="S3.Thmthm11.p1.m7" class="ltx_Math" alttext="\textrm{M}^{\prime}" display="inline" intent=":literal"><semantics><msup><mtext>M</mtext><mo>′</mo></msup><annotation encoding="application/x-tex">\textrm{M}^{\prime}</annotation></semantics></math> restricts to <span id="S3.Thmthm11.p1.3.1.2" class="ltx_text ltx_markedasmath ltx_font_upright">G</span> and,
for <math id="S3.Thmthm11.p1.m9" class="ltx_Math" alttext="A\subseteq E(\textrm{G})" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>⊆</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mtext>G</mtext><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">A\subseteq E(\textrm{G})</annotation></semantics></math> and <math id="S3.Thmthm11.p1.m10" class="ltx_Math" alttext="J\subseteq X" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo>⊆</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">J\subseteq X</annotation></semantics></math>, has rank</span></p>
<table id="S3.E25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(25)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E25.m1" class="ltx_Math" alttext="\operatorname{rk}_{\textrm{M}^{\prime}}(A\cup J)=\begin{cases}r-1,&amp;J=\{p_{i}\}\text{ and }\operatorname{cl}_{\textrm{G}}(A)\in\mathcal{F}_{i},\\
\min\{\operatorname{rk}_{\textrm{G}}(A)+|J|,r\},&amp;\text{otherwise}.\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>rk</mi><msup><mtext>M</mtext><mo>′</mo></msup></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo>∪</mo><mi>J</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>J</mi><mo>=</mo><mrow><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext class="ltx_mathvariant_italic"> and </mtext><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>cl</mi><mtext>G</mtext></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msub></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mrow><msub><mi>rk</mi><mtext>G</mtext></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mo stretchy="false">|</mo><mi>J</mi><mo stretchy="false">|</mo></mrow></mrow><mo>,</mo><mi>r</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext class="ltx_mathvariant_italic">otherwise</mtext><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\operatorname{rk}_{\textrm{M}^{\prime}}(A\cup J)=\begin{cases}r-1,&amp;J=\{p_{i}\}\text{ and }\operatorname{cl}_{\textrm{G}}(A)\in\mathcal{F}_{i},\\
\min\{\operatorname{rk}_{\textrm{G}}(A)+|J|,r\},&amp;\text{otherwise}.\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm11.p1.4" class="ltx_p"><span id="S3.Thmthm11.p1.4.1" class="ltx_text ltx_font_italic">Before coalescence, each block has restriction</span></p>
<table id="S3.Ex110" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex110.m1" class="ltx_Math" alttext="\textrm{M}|(F\cup\{p_{i}\})=(\textrm{G}|F)\oplus\textrm{U}_{1,1}." display="block" intent=":literal"><semantics><mrow><mrow><mtext>M</mtext><mo fence="false">|</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>F</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mtext>G</mtext><mo lspace="0em" rspace="0em">|</mo><mi>F</mi><mo stretchy="false">)</mo></mrow><mo>⊕</mo><msub><mtext>U</mtext><mrow><mn>1</mn><mo>,</mo><mn>1</mn></mrow></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\textrm{M}|(F\cup\{p_{i}\})=(\textrm{G}|F)\oplus\textrm{U}_{1,1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S3.SS2.p2" class="ltx_para">
<p id="S3.SS2.p2.1" class="ltx_p">For each <math id="S3.SS2.p2.m1" class="ltx_Math" alttext="F\in\mathcal{F}_{i}" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">F\in\mathcal{F}_{i}</annotation></semantics></math>, the old hyperplanes <math id="S3.SS2.p2.m2" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> and
<math id="S3.SS2.p2.m3" class="ltx_Math" alttext="A\cup\{p_{i}\}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">A\cup\{p_{i}\}</annotation></semantics></math>, with <math id="S3.SS2.p2.m4" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> a hyperplane of <math id="S3.SS2.p2.m5" class="ltx_Math" alttext="\textrm{G}|F" display="inline" intent=":literal"><semantics><mrow><mtext>G</mtext><mo fence="false">|</mo><mi>F</mi></mrow><annotation encoding="application/x-tex">\textrm{G}|F</annotation></semantics></math>,
all acquire closure <math id="S3.SS2.p2.m6" class="ltx_Math" alttext="F\cup\{p_{i}\}" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">F\cup\{p_{i}\}</annotation></semantics></math>.
The rank formula also shows that the order of adjoining the
auxiliary points does not affect the result.</p>
</div>
<div id="S3.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS2.p3" class="ltx_para">
<p id="S3.SS2.p3.1" class="ltx_p"><span id="S3.SS2.p3.1.1" class="ltx_text">Put <math id="S3.SS2.p3.m1" class="ltx_Math" alttext="\textrm{Q}=\textrm{G}\oplus\textrm{U}_{X,X}" display="inline" intent=":literal"><semantics><mrow><mtext>Q</mtext><mo>=</mo><mrow><mtext>G</mtext><mo>⊕</mo><msub><mtext>U</mtext><mrow><mi>X</mi><mo>,</mo><mi>X</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\textrm{Q}=\textrm{G}\oplus\textrm{U}_{X,X}</annotation></semantics></math>.
Each block <math id="S3.SS2.p3.m2" class="ltx_Math" alttext="H=F\cup\{p_{i}\}" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>=</mo><mrow><mi>F</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H=F\cup\{p_{i}\}</annotation></semantics></math> is a proper rank-<math id="S3.SS2.p3.m3" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> flat of
<span id="S3.SS2.p3.1.1.1" class="ltx_text ltx_markedasmath">Q</span>, hence a proper spanning subset of <span id="S3.SS2.p3.1.1.2" class="ltx_text ltx_markedasmath">M</span>.
For every independent <math id="S3.SS2.p3.m6" class="ltx_Math" alttext="(r-1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(r-1)</annotation></semantics></math>-set <math id="S3.SS2.p3.m7" class="ltx_Math" alttext="I\subseteq H" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo>⊆</mo><mi>H</mi></mrow><annotation encoding="application/x-tex">I\subseteq H</annotation></semantics></math>,</span></p>
<table id="S3.Ex111" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex111.m1" class="ltx_Math" alttext="\operatorname{cl}_{\textrm{M}}(I)=\operatorname{cl}_{\textrm{Q}}(I)\subseteq H." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>cl</mi><mtext>M</mtext></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>cl</mi><mtext>Q</mtext></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊆</mo><mi>H</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\operatorname{cl}_{\textrm{M}}(I)=\operatorname{cl}_{\textrm{Q}}(I)\subseteq H.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p3.2" class="ltx_p"><span id="S3.SS2.p3.2.1" class="ltx_text">Distinct blocks sharing <math id="S3.SS2.p3.m8" class="ltx_Math" alttext="p_{i}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>i</mi></msub><annotation encoding="application/x-tex">p_{i}</annotation></semantics></math> intersect in rank at most
<math id="S3.SS2.p3.m9" class="ltx_Math" alttext="(r-3)+1=r-2" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>−</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mn>1</mn></mrow><mo>=</mo><mrow><mi>r</mi><mo>−</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">(r-3)+1=r-2</annotation></semantics></math>. Blocks with different auxiliary points intersect
in rank at most <math id="S3.SS2.p3.m10" class="ltx_Math" alttext="r-2" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>−</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">r-2</annotation></semantics></math>, since their geometric hyperplanes are
distinct. Thus both conditions of <a href="#S3.Thmthm7" title="Lemma 3.7 ‣ 3.1. Hyperplane coalescence ‣ 3. Matroid operations: hyperplane coalescence, absorption ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">3.7</span></a> hold.</span></p>
</div>
<div id="S3.SS2.p4" class="ltx_para">
<p id="S3.SS2.p4.1" class="ltx_p"><span id="S3.SS2.p4.1.1" class="ltx_text">A set <math id="S3.SS2.p4.m1" class="ltx_Math" alttext="A\cup J" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>∪</mo><mi>J</mi></mrow><annotation encoding="application/x-tex">A\cup J</annotation></semantics></math> is spanning in <span id="S3.SS2.p4.1.1.1" class="ltx_text ltx_markedasmath">M</span> and contained in a block
<math id="S3.SS2.p4.m3" class="ltx_Math" alttext="F\cup\{p_{i}\}" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">F\cup\{p_{i}\}</annotation></semantics></math> exactly when <math id="S3.SS2.p4.m4" class="ltx_Math" alttext="J=\{p_{i}\}" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">J=\{p_{i}\}</annotation></semantics></math> and
<math id="S3.SS2.p4.m5" class="ltx_Math" alttext="\operatorname{cl}_{\textrm{G}}(A)=F" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>cl</mi><mtext>G</mtext></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>F</mi></mrow><annotation encoding="application/x-tex">\operatorname{cl}_{\textrm{G}}(A)=F</annotation></semantics></math>.
Hence (<a href="#S3.E21" title="Equation 21 ‣ Lemma 3.7 ‣ 3.1. Hyperplane coalescence ‣ 3. Matroid operations: hyperplane coalescence, absorption ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>) gives
(<a href="#S3.E25" title="Equation 25 ‣ Proposition 3.11 ‣ 3.2. Absorption ‣ 3. Matroid operations: hyperplane coalescence, absorption ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">25</span></a>); taking <math id="S3.SS2.p4.m6" class="ltx_Math" alttext="J=\varnothing" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo>=</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">J=\varnothing</annotation></semantics></math> shows that
<math id="S3.SS2.p4.m7" class="ltx_Math" alttext="\textrm{M}^{\prime}" display="inline" intent=":literal"><semantics><msup><mtext>M</mtext><mo>′</mo></msup><annotation encoding="application/x-tex">\textrm{M}^{\prime}</annotation></semantics></math> restricts to <span id="S3.SS2.p4.1.1.2" class="ltx_text ltx_markedasmath">G</span>.
The old block restriction follows because truncation to rank <math id="S3.SS2.p4.m9" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>
does not change the restriction to a rank-<math id="S3.SS2.p4.m10" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> subset.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4. </span>Four families from finite geometries</h2>

<div id="S4.p1" class="ltx_para">
<p id="S4.p1.1" class="ltx_p">We construct the affine Klein family, the affine packing family, the Gabidulin family, and the projective
family from finite geometries, and prove Theorem <a href="#Thmintrothm2" title="Theorem B ‣ 1. Introduction ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B</span></a>.</p>
</div>
<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.1. </span>The affine family</h3>

<div id="S4.SS1.p1" class="ltx_para">
<p id="S4.SS1.p1.1" class="ltx_p">Let <math id="S4.SS1.p1.m1" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> be a power of an odd prime. Recall that the affine geometry <math id="S4.SS1.p1.m2" class="ltx_Math" alttext="\textrm{AG}(4,q)" display="inline" intent=":literal"><semantics><mrow><mtext>AG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>4</mn><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textrm{AG}(4,q)</annotation></semantics></math> is the matroid of rank <math id="S4.SS1.p1.m3" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math>, which has flats given by affine subspaces of <math id="S4.SS1.p1.m4" class="ltx_Math" alttext="\mathbb{F}_{q}^{4}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔽</mi><mi>q</mi><mn>4</mn></msubsup><annotation encoding="application/x-tex">\mathbb{F}_{q}^{4}</annotation></semantics></math>, and the projective geometry <math id="S4.SS1.p1.m5" class="ltx_Math" alttext="\textrm{PG}(3,q)" display="inline" intent=":literal"><semantics><mrow><mtext>PG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textrm{PG}(3,q)</annotation></semantics></math> is the matroid of rank <math id="S4.SS1.p1.m6" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math>, which has flats given by projective subspaces of <math id="S4.SS1.p1.m7" class="ltx_Math" alttext="\mathbb{P}(\mathbb{F}_{q}^{4})" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝔽</mi><mi>q</mi><mn>4</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(\mathbb{F}_{q}^{4})</annotation></semantics></math>. We will construct the affine family of matroids <math id="S4.SS1.p1.m8" class="ltx_Math" alttext="\textrm{M}_{q}" display="inline" intent=":literal"><semantics><msub><mtext>M</mtext><mi>q</mi></msub><annotation encoding="application/x-tex">\textrm{M}_{q}</annotation></semantics></math> using classical operations from projective incidence geometry and combinatorial design, in four steps:</p>
<ol id="S4.I1" class="ltx_enumerate">
<li id="S4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I1.i1.p1" class="ltx_para">
<p id="S4.I1.i1.p1.1" class="ltx_p">Start with the truncation <math id="S4.I1.i1.p1.m1" class="ltx_Math" alttext="\mathrm{Tr}(\textrm{AG}(4,q))" display="inline" intent=":literal"><semantics><mrow><mi>Tr</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>AG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>4</mn><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Tr}(\textrm{AG}(4,q))</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I1.i2.p1" class="ltx_para">
<p id="S4.I1.i2.p1.1" class="ltx_p">Use the Klein
correspondence to choose pairwise disjoint spreads of
<math id="S4.I1.i2.p1.m1" class="ltx_Math" alttext="\textrm{PG}(3,q)" display="inline" intent=":literal"><semantics><mrow><mtext>PG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textrm{PG}(3,q)</annotation></semantics></math>. Each spread specifies a family of affine planes
through their directions.</p>
</div></li>
<li id="S4.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S4.I1.i3.p1" class="ltx_para">
<p id="S4.I1.i3.p1.1" class="ltx_p">Construct the matroid inductively: for each chosen
spread, adjoin a new coloop to the current matroid,
truncate once, and absorb the new point into the selected
planes. Define <math id="S4.I1.i3.p1.m1" class="ltx_Math" alttext="\textrm{M}_{q}" display="inline" intent=":literal"><semantics><msub><mtext>M</mtext><mi>q</mi></msub><annotation encoding="application/x-tex">\textrm{M}_{q}</annotation></semantics></math> as the resulting matroid.</p>
</div></li>
<li id="S4.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S4.I1.i4.p1" class="ltx_para">
<p id="S4.I1.i4.p1.1" class="ltx_p">Compute flag vectors of <math id="S4.I1.i4.p1.m1" class="ltx_Math" alttext="\textrm{M}_{q}" display="inline" intent=":literal"><semantics><msub><mtext>M</mtext><mi>q</mi></msub><annotation encoding="application/x-tex">\textrm{M}_{q}</annotation></semantics></math>, and prove that they only depend on <math id="S4.I1.i4.p1.m2" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
<div id="S4.SS1.p2" class="ltx_para">
<p id="S4.SS1.p2.1" class="ltx_p">For any field <math id="S4.SS1.p2.m1" class="ltx_Math" alttext="\mathbb{F}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">\mathbb{F}</annotation></semantics></math> and a vector space <math id="S4.SS1.p2.m2" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> over <math id="S4.SS1.p2.m3" class="ltx_Math" alttext="\mathbb{F}" display="inline" intent=":literal"><semantics><mi>𝔽</mi><annotation encoding="application/x-tex">\mathbb{F}</annotation></semantics></math>, the <em id="S4.SS1.p2.1.1" class="ltx_emph ltx_font_italic">direction</em> of a nonempty affine subspace <math id="S4.SS1.p2.m4" class="ltx_Math" alttext="A\subseteq V" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>⊆</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">A\subseteq V</annotation></semantics></math> is the linear subspace of <math id="S4.SS1.p2.m5" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math></p>
<table id="S4.Ex112" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex112.m1" class="ltx_math_unparsed" alttext="D(A)\coloneqq\{x-y:x,y\in A\}\subseteq V." display="block" intent=":literal"><semantics><mrow><mi>D</mi><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mo>≔</mo><mrow><mo stretchy="false">{</mo><mi>x</mi><mo>−</mo><mi>y</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>∈</mo><mi>A</mi><mo stretchy="false">}</mo></mrow><mo>⊆</mo><mi>V</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">D(A)\coloneqq\{x-y:x,y\in A\}\subseteq V.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p2.2" class="ltx_p">For example, the direction <math id="S4.SS1.p2.m6" class="ltx_Math" alttext="D(L)" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(L)</annotation></semantics></math> is equal to <math id="S4.SS1.p2.m7" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> for any linear subspace <math id="S4.SS1.p2.m8" class="ltx_Math" alttext="L\subseteq V" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⊆</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">L\subseteq V</annotation></semantics></math>; and the direction of any affine translation <math id="S4.SS1.p2.m9" class="ltx_Math" alttext="v+L" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>+</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">v+L</annotation></semantics></math> of a linear space <math id="S4.SS1.p2.m10" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> for <math id="S4.SS1.p2.m11" class="ltx_Math" alttext="v\in V" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">v\in V</annotation></semantics></math> is <math id="S4.SS1.p2.m12" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>. The projectivization of the direction of an affine subspace of dimension <math id="S4.SS1.p2.m13" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> is a projective subspace of dimension <math id="S4.SS1.p2.m14" class="ltx_Math" alttext="k-1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k-1</annotation></semantics></math>. Therefore, for each flat <math id="S4.SS1.p2.m15" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> of rank <math id="S4.SS1.p2.m16" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> in <math id="S4.SS1.p2.m17" class="ltx_Math" alttext="\textrm{AG}(n,q)" display="inline" intent=":literal"><semantics><mrow><mtext>AG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textrm{AG}(n,q)</annotation></semantics></math>, <math id="S4.SS1.p2.m18" class="ltx_Math" alttext="\mathbb{P}(D(F))" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(D(F))</annotation></semantics></math> is a flat of rank <math id="S4.SS1.p2.m19" class="ltx_Math" alttext="k-1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k-1</annotation></semantics></math> in <math id="S4.SS1.p2.m20" class="ltx_Math" alttext="\textrm{PG}(n-1,q)" display="inline" intent=":literal"><semantics><mrow><mtext>PG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textrm{PG}(n-1,q)</annotation></semantics></math>.</p>
</div>
<div id="S4.SS1.p3" class="ltx_para">
<p id="S4.SS1.p3.1" class="ltx_p">A <em id="S4.SS1.p3.1.1" class="ltx_emph ltx_font_italic"><math id="S4.SS1.p3.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-spread</em> of <math id="S4.SS1.p3.m2" class="ltx_Math" alttext="\textrm{PG}(n,q)" display="inline" intent=":literal"><semantics><mrow><mtext>PG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textrm{PG}(n,q)</annotation></semantics></math> is a collection <math id="S4.SS1.p3.m3" class="ltx_Math" alttext="\mathcal{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">\mathcal{S}</annotation></semantics></math>
of projective <math id="S4.SS1.p3.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-dimensional subspaces such that every
projective point belongs to exactly one element of <math id="S4.SS1.p3.m5" class="ltx_Math" alttext="\mathcal{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">\mathcal{S}</annotation></semantics></math>.
A <math id="S4.SS1.p3.m6" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>-spread is called a <em id="S4.SS1.p3.1.2" class="ltx_emph ltx_font_italic">line spread</em>, or simply <em id="S4.SS1.p3.1.3" class="ltx_emph ltx_font_italic">spread</em>.
Two <math id="S4.SS1.p3.m7" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-spreads are <em id="S4.SS1.p3.1.4" class="ltx_emph ltx_font_italic">disjoint</em> if they contain no common points. A <math id="S4.SS1.p3.m8" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-spread of <math id="S4.SS1.p3.m9" class="ltx_Math" alttext="\textrm{PG}(n,q)" display="inline" intent=":literal"><semantics><mrow><mtext>PG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textrm{PG}(n,q)</annotation></semantics></math> exists if and only if
<math id="S4.SS1.p3.m10" class="ltx_Math" alttext="k+1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k+1</annotation></semantics></math> divides <math id="S4.SS1.p3.m11" class="ltx_Math" alttext="n+1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n+1</annotation></semantics></math>, and every such spread has cardinality</p>
<table id="S4.Ex113" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex113.m1" class="ltx_Math" alttext="|\mathcal{S}|=\frac{q^{n+1}-1}{q^{k+1}-1}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mfrac><mrow><msup><mi>q</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>−</mo><mn>1</mn></mrow><mrow><msup><mi>q</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>−</mo><mn>1</mn></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|\mathcal{S}|=\frac{q^{n+1}-1}{q^{k+1}-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p3.2" class="ltx_p">For <math id="S4.SS1.p3.m12" class="ltx_Math" alttext="\textrm{PG}(3,q)" display="inline" intent=":literal"><semantics><mrow><mtext>PG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textrm{PG}(3,q)</annotation></semantics></math>, every spread <math id="S4.SS1.p3.m13" class="ltx_Math" alttext="\mathcal{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">\mathcal{S}</annotation></semantics></math> consists of <math id="S4.SS1.p3.m14" class="ltx_Math" alttext="q^{2}+1" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">q^{2}+1</annotation></semantics></math> projective lines.
For general background on spreads in finite projective spaces,
see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib21" title="" class="ltx_ref">17</a>, <a href="#bib.bib22" title="" class="ltx_ref">32</a>, <a href="#bib.bib23" title="" class="ltx_ref">20</a>]</cite>.</p>
</div>
<div id="S4.SS1.p4" class="ltx_para">
<p id="S4.SS1.p4.1" class="ltx_p">Given a spread <math id="S4.SS1.p4.m1" class="ltx_Math" alttext="\mathcal{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">\mathcal{S}</annotation></semantics></math>, we consider the collection of all affine planes whose projectivized directions are elements in <math id="S4.SS1.p4.m2" class="ltx_Math" alttext="\mathcal{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">\mathcal{S}</annotation></semantics></math></p>
<table id="S4.Ex114" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex114.m1" class="ltx_Math" alttext="\mathcal{A}(\mathcal{S})\coloneqq\{A\subseteq V\colon\mathbb{P}(D(A))\in\mathcal{S}\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><mo stretchy="false">{</mo><mrow><mi>A</mi><mo>⊆</mo><mi>V</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{A}(\mathcal{S})\coloneqq\{A\subseteq V\colon\mathbb{P}(D(A))\in\mathcal{S}\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p4.2" class="ltx_p">Since each direction in <math id="S4.SS1.p4.m3" class="ltx_Math" alttext="\mathcal{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">\mathcal{S}</annotation></semantics></math> admits <math id="S4.SS1.p4.m4" class="ltx_Math" alttext="q^{2}" display="inline" intent=":literal"><semantics><msup><mi>q</mi><mn>2</mn></msup><annotation encoding="application/x-tex">q^{2}</annotation></semantics></math> affine translates,</p>
<table id="S4.Ex115" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex115.m1" class="ltx_Math" alttext="|\mathcal{A}(\mathcal{S})|=q^{2}(q^{2}+1)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><msup><mi>q</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|\mathcal{A}(\mathcal{S})|=q^{2}(q^{2}+1).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p4.3" class="ltx_p">The following lemma describes the intersections among
the elements in <math id="S4.SS1.p4.m5" class="ltx_Math" alttext="\mathcal{A}(\mathcal{S})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{A}(\mathcal{S})</annotation></semantics></math>.</p>
</div>
<div id="S4.Thmthm1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm1.2" class="ltx_text ltx_font_bold">Lemma 4.1</span></span></h6>
<div id="S4.Thmthm1.p1" class="ltx_para">
<p id="S4.Thmthm1.p1.1" class="ltx_p"><span id="S4.Thmthm1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmthm1.p1.m1" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> be a vector space over a field, and let
<math id="S4.Thmthm1.p1.m2" class="ltx_Math" alttext="P=a+D" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>=</mo><mrow><mi>a</mi><mo>+</mo><mi>D</mi></mrow></mrow><annotation encoding="application/x-tex">P=a+D</annotation></semantics></math> and <math id="S4.Thmthm1.p1.m3" class="ltx_Math" alttext="P^{\prime}=b+D^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>P</mi><mo>′</mo></msup><mo>=</mo><mrow><mi>b</mi><mo>+</mo><msup><mi>D</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">P^{\prime}=b+D^{\prime}</annotation></semantics></math> be distinct affine subspaces of <math id="S4.Thmthm1.p1.m4" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math>.</span></p>
<ol id="S4.I2" class="ltx_enumerate">
<li id="S4.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I2.i1.p1" class="ltx_para">
<p id="S4.I2.i1.p1.1" class="ltx_p"><span id="S4.I2.i1.p1.1.1" class="ltx_text ltx_font_italic">If </span><math id="S4.I2.i1.p1.m1" class="ltx_Math" alttext="D=D^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>=</mo><msup><mi>D</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">D=D^{\prime}</annotation></semantics></math><span id="S4.I2.i1.p1.1.2" class="ltx_text ltx_font_italic">, then </span><math id="S4.I2.i1.p1.m2" class="ltx_Math" alttext="P\cap P^{\prime}=\varnothing" display="inline" intent=":literal"><semantics><mrow><mrow><mi>P</mi><mo>∩</mo><msup><mi>P</mi><mo>′</mo></msup></mrow><mo>=</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">P\cap P^{\prime}=\varnothing</annotation></semantics></math><span id="S4.I2.i1.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I2.i2.p1" class="ltx_para">
<p id="S4.I2.i2.p1.1" class="ltx_p"><span id="S4.I2.i2.p1.1.1" class="ltx_text ltx_font_italic">If </span><math id="S4.I2.i2.p1.m1" class="ltx_Math" alttext="D\cap D^{\prime}=\{0\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>D</mi><mo>∩</mo><msup><mi>D</mi><mo>′</mo></msup></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">D\cap D^{\prime}=\{0\}</annotation></semantics></math><span id="S4.I2.i2.p1.1.2" class="ltx_text ltx_font_italic">, then </span><math id="S4.I2.i2.p1.m2" class="ltx_Math" alttext="P\cap P^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>∩</mo><msup><mi>P</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">P\cap P^{\prime}</annotation></semantics></math><span id="S4.I2.i2.p1.1.3" class="ltx_text ltx_font_italic"> contains
at most one point.</span></p>
</div></li>
<li id="S4.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S4.I2.i3.p1" class="ltx_para">
<p id="S4.I2.i3.p1.1" class="ltx_p"><span id="S4.I2.i3.p1.1.1" class="ltx_text ltx_font_italic">If </span><math id="S4.I2.i3.p1.m1" class="ltx_Math" alttext="V=D\oplus D^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>=</mo><mrow><mi>D</mi><mo>⊕</mo><msup><mi>D</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">V=D\oplus D^{\prime}</annotation></semantics></math><span id="S4.I2.i3.p1.1.2" class="ltx_text ltx_font_italic">, then </span><math id="S4.I2.i3.p1.m2" class="ltx_Math" alttext="P\cap P^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>∩</mo><msup><mi>P</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">P\cap P^{\prime}</annotation></semantics></math><span id="S4.I2.i3.p1.1.3" class="ltx_text ltx_font_italic"> contains
exactly one point.</span></p>
</div></li>
</ol>
<p id="S4.Thmthm1.p1.2" class="ltx_p"><span id="S4.Thmthm1.p1.2.1" class="ltx_text ltx_font_italic">In particular, if <math id="S4.Thmthm1.p1.m5" class="ltx_Math" alttext="V=\mathbb{F}_{q}^{2k+1}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>=</mo><msubsup><mi>𝔽</mi><mi>q</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>+</mo><mn>1</mn></mrow></msubsup></mrow><annotation encoding="application/x-tex">V=\mathbb{F}_{q}^{2k+1}</annotation></semantics></math> and
<math id="S4.Thmthm1.p1.m6" class="ltx_Math" alttext="\mathbb{P}(D),\mathbb{P}(D^{\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>D</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(D),\mathbb{P}(D^{\prime})</annotation></semantics></math> belong to a
<math id="S4.Thmthm1.p1.m7" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-spread of <math id="S4.Thmthm1.p1.m8" class="ltx_Math" alttext="\textrm{PG}(2k,q)" display="inline" intent=":literal"><semantics><mrow><mtext>PG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textrm{PG}(2k,q)</annotation></semantics></math>, then the distinct
affine <math id="S4.Thmthm1.p1.m9" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-dimensional subspaces <math id="S4.Thmthm1.p1.m10" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> and <math id="S4.Thmthm1.p1.m11" class="ltx_Math" alttext="P^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>′</mo></msup><annotation encoding="application/x-tex">P^{\prime}</annotation></semantics></math> are
either parallel and disjoint, or have complementary
directions and intersect in exactly one point.</span></p>
</div>
</div>
<div id="S4.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS1.p5" class="ltx_para">
<p id="S4.SS1.p5.1" class="ltx_p"><span id="S4.SS1.p5.1.1" class="ltx_text">Since <math id="S4.SS1.p5.m1" class="ltx_Math" alttext="a,b" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow><annotation encoding="application/x-tex">a,b</annotation></semantics></math> are distinct vectors, (a) follows immediately.
For (b), if <math id="S4.SS1.p5.m2" class="ltx_Math" alttext="x,y\in P\cap P^{\prime}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow><mo>∈</mo><mrow><mi>P</mi><mo>∩</mo><msup><mi>P</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">x,y\in P\cap P^{\prime}</annotation></semantics></math>, then
<math id="S4.SS1.p5.m3" class="ltx_Math" alttext="x-y\in D\cap D^{\prime}=\{0\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo>∈</mo><mrow><mi>D</mi><mo>∩</mo><msup><mi>D</mi><mo>′</mo></msup></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">x-y\in D\cap D^{\prime}=\{0\}</annotation></semantics></math>, and <math id="S4.SS1.p5.m4" class="ltx_Math" alttext="x=y" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><mi>y</mi></mrow><annotation encoding="application/x-tex">x=y</annotation></semantics></math>.
For (c), write <math id="S4.SS1.p5.m5" class="ltx_Math" alttext="b-a=d+d^{\prime}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>b</mi><mo>−</mo><mi>a</mi></mrow><mo>=</mo><mrow><mi>d</mi><mo>+</mo><msup><mi>d</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">b-a=d+d^{\prime}</annotation></semantics></math> with <math id="S4.SS1.p5.m6" class="ltx_Math" alttext="d\in D" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>∈</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">d\in D</annotation></semantics></math> and <math id="S4.SS1.p5.m7" class="ltx_Math" alttext="d^{\prime}\in D^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>d</mi><mo>′</mo></msup><mo>∈</mo><msup><mi>D</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">d^{\prime}\in D^{\prime}</annotation></semantics></math>.
Then <math id="S4.SS1.p5.m8" class="ltx_Math" alttext="a+d=b-d^{\prime}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>+</mo><mi>d</mi></mrow><mo>=</mo><mrow><mi>b</mi><mo>−</mo><msup><mi>d</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">a+d=b-d^{\prime}</annotation></semantics></math> belongs to <math id="S4.SS1.p5.m9" class="ltx_Math" alttext="P\cap P^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>∩</mo><msup><mi>P</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">P\cap P^{\prime}</annotation></semantics></math>, and (b) implies its uniqueness.
∎</span></p>
</div>
</div>
<div id="S4.Thmthm2" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm2.2" class="ltx_text ltx_font_bold">Example 4.2</span></span></h6>
<div id="S4.Thmthm2.p1" class="ltx_para">
<p id="S4.Thmthm2.p1.1" class="ltx_p">Let <math id="S4.Thmthm2.p1.m1" class="ltx_Math" alttext="V=\mathbb{F}_{q}^{4}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>=</mo><msubsup><mi>𝔽</mi><mi>q</mi><mn>4</mn></msubsup></mrow><annotation encoding="application/x-tex">V=\mathbb{F}_{q}^{4}</annotation></semantics></math> and let <math id="S4.Thmthm2.p1.m2" class="ltx_Math" alttext="\mathcal{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">\mathcal{S}</annotation></semantics></math> be a spread of <math id="S4.Thmthm2.p1.m3" class="ltx_Math" alttext="\textrm{PG}(3,q)" display="inline" intent=":literal"><semantics><mrow><mtext>PG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textrm{PG}(3,q)</annotation></semantics></math>. Let two distinct affine subspaces <math id="S4.Thmthm2.p1.m4" class="ltx_Math" alttext="P=a+D,P^{\prime}=b+D^{\prime}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>P</mi><mo>=</mo><mrow><mi>a</mi><mo>+</mo><mi>D</mi></mrow></mrow><mo>,</mo><mrow><msup><mi>P</mi><mo>′</mo></msup><mo>=</mo><mrow><mi>b</mi><mo>+</mo><msup><mi>D</mi><mo>′</mo></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">P=a+D,P^{\prime}=b+D^{\prime}</annotation></semantics></math> of <math id="S4.Thmthm2.p1.m5" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> be given by distinct directions <math id="S4.Thmthm2.p1.m6" class="ltx_Math" alttext="\mathbb{P}(D)\neq\mathbb{P}(D^{\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>D</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(D)\neq\mathbb{P}(D^{\prime})</annotation></semantics></math> in <math id="S4.Thmthm2.p1.m7" class="ltx_Math" alttext="\mathcal{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">\mathcal{S}</annotation></semantics></math>. Since elements in <math id="S4.Thmthm2.p1.m8" class="ltx_Math" alttext="\mathcal{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">\mathcal{S}</annotation></semantics></math> do not share common points, Lemma <a href="#S4.Thmthm1" title="Lemma 4.1 ‣ 4.1. The affine family ‣ 4. Four families from finite geometries ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a> implies that two distinct affine planes <math id="S4.Thmthm2.p1.m9" class="ltx_Math" alttext="P,P^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>,</mo><msup><mi>P</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">P,P^{\prime}</annotation></semantics></math> in <math id="S4.Thmthm2.p1.m10" class="ltx_Math" alttext="\mathcal{A}(\mathcal{S})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{A}(\mathcal{S})</annotation></semantics></math>
are either parallel and disjoint, or meet in exactly
one point. See Figure <a href="#S4.F3" title="Figure 3 ‣ Example 4.2 ‣ 4.1. The affine family ‣ 4. Four families from finite geometries ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>.</p>
</div>
<figure id="S4.F3" class="ltx_figure"><span class="ltx_inline-block"><svg id="S4.F3.pic1" class="ltx_picture" height="110.99" overflow="visible" version="1.1" viewBox="0 0 267.85 110.99" width="267.85"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.65pt" transform="translate(0,110.99) matrix(1 0 0 -1 0 0) translate(43.67,0) translate(0,76.97)"><path style="fill:none" d="M -41.34 -22.05 L -9.65 -5.51 L 41.34 -22.05 L 9.65 -38.58 Z"></path><path style="fill:none" d="M -41.34 15.16 L -9.65 31.69 L 41.34 15.16 L 9.65 -1.38 Z"></path><g style="--ltx-fill-color:#000000;" fill="#000000"><path style="stroke:none" d="M -39.01 -22.05 C -39.01 -20.76 -40.05 -19.72 -41.34 -19.72 C -42.62 -19.72 -43.67 -20.76 -43.67 -22.05 C -43.67 -23.33 -42.62 -24.38 -41.34 -24.38 C -40.05 -24.38 -39.01 -23.33 -39.01 -22.05 Z M -41.34 -22.05"></path></g><g style="--ltx-fill-color:#000000;" fill="#000000"><path style="stroke:none" d="M -7.32 -5.51 C -7.32 -4.23 -8.36 -3.18 -9.65 -3.18 C -10.93 -3.18 -11.97 -4.23 -11.97 -5.51 C -11.97 -6.8 -10.93 -7.84 -9.65 -7.84 C -8.36 -7.84 -7.32 -6.8 -7.32 -5.51 Z M -9.65 -5.51"></path></g><g style="--ltx-fill-color:#000000;" fill="#000000"><path style="stroke:none" d="M 43.67 -22.05 C 43.67 -20.76 42.62 -19.72 41.34 -19.72 C 40.05 -19.72 39.01 -20.76 39.01 -22.05 C 39.01 -23.33 40.05 -24.38 41.34 -24.38 C 42.62 -24.38 43.67 -23.33 43.67 -22.05 Z M 41.34 -22.05"></path></g><g style="--ltx-fill-color:#000000;" fill="#000000"><path style="stroke:none" d="M 11.97 -38.58 C 11.97 -37.3 10.93 -36.25 9.65 -36.25 C 8.36 -36.25 7.32 -37.3 7.32 -38.58 C 7.32 -39.87 8.36 -40.91 9.65 -40.91 C 10.93 -40.91 11.97 -39.87 11.97 -38.58 Z M 9.65 -38.58"></path></g><g style="--ltx-fill-color:#000000;" fill="#000000"><path style="stroke:none" d="M -39.01 15.16 C -39.01 16.44 -40.05 17.49 -41.34 17.49 C -42.62 17.49 -43.67 16.44 -43.67 15.16 C -43.67 13.87 -42.62 12.83 -41.34 12.83 C -40.05 12.83 -39.01 13.87 -39.01 15.16 Z M -41.34 15.16"></path></g><g style="--ltx-fill-color:#000000;" fill="#000000"><path style="stroke:none" d="M -7.32 31.69 C -7.32 32.98 -8.36 34.02 -9.65 34.02 C -10.93 34.02 -11.97 32.98 -11.97 31.69 C -11.97 30.41 -10.93 29.36 -9.65 29.36 C -8.36 29.36 -7.32 30.41 -7.32 31.69 Z M -9.65 31.69"></path></g><g style="--ltx-fill-color:#000000;" fill="#000000"><path style="stroke:none" d="M 43.67 15.16 C 43.67 16.44 42.62 17.49 41.34 17.49 C 40.05 17.49 39.01 16.44 39.01 15.16 C 39.01 13.87 40.05 12.83 41.34 12.83 C 42.62 12.83 43.67 13.87 43.67 15.16 Z M 41.34 15.16"></path></g><g style="--ltx-fill-color:#000000;" fill="#000000"><path style="stroke:none" d="M 11.97 -1.38 C 11.97 -0.09 10.93 0.95 9.65 0.95 C 8.36 0.95 7.32 -0.09 7.32 -1.38 C 7.32 -2.66 8.36 -3.71 9.65 -3.71 C 10.93 -3.71 11.97 -2.66 11.97 -1.38 Z M 9.65 -1.38"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.7 0.0 0.0 0.7 -3.48 -25.03)"><foreignObject style="--ltx-fo-width:0.78em;--ltx-fo-height:0.66em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.51" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="9.95"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F3.pic1.m1" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.7 0.0 0.0 0.7 -4.84 11.61)"><foreignObject style="--ltx-fo-width:1.08em;--ltx-fo-height:0.79em;--ltx-fo-depth:0em;font-size:9.25pt;" height="10.13" overflow="visible" transform="matrix(1 0 0 -1 0 10.13)" width="13.83"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F3.pic1.m2" class="ltx_Math" alttext="P^{\prime}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.900em">P</mi><mo mathsize="0.900em">′</mo></msup><annotation encoding="application/x-tex">P^{\prime}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.7 0.0 0.0 0.7 -20.27 -72.2)"><foreignObject style="--ltx-fo-width:4.52em;--ltx-fo-height:0.79em;--ltx-fo-depth:0.05em;font-size:9.25pt;" height="10.83" overflow="visible" transform="matrix(1 0 0 -1 0 10.13)" width="57.91"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F3.pic1.m3" class="ltx_Math" alttext="P\cap P^{\prime}=\varnothing" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.900em">P</mi><mo mathsize="0.900em">∩</mo><msup><mi mathsize="0.900em">P</mi><mo mathsize="0.900em">′</mo></msup></mrow><mo mathsize="0.900em">=</mo><mi mathsize="0.900em" mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">P\cap P^{\prime}=\varnothing</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 165.35 -38.58 L 117.13 -23.43 L 108.86 19.29 L 157.09 4.13 Z"></path><path style="fill:none" d="M 165.35 -38.58 L 213.58 -23.43 L 221.85 19.29 L 173.62 4.13 Z"></path><g style="--ltx-fill-color:#000000;" fill="#000000"><path style="stroke:none" d="M 167.68 -38.58 C 167.68 -37.3 166.64 -36.25 165.35 -36.25 C 164.07 -36.25 163.02 -37.3 163.02 -38.58 C 163.02 -39.87 164.07 -40.91 165.35 -40.91 C 166.64 -40.91 167.68 -39.87 167.68 -38.58 Z M 165.35 -38.58"></path></g><g style="--ltx-fill-color:#000000;" fill="#000000"><path style="stroke:none" d="M 119.45 -23.43 C 119.45 -22.14 118.41 -21.1 117.13 -21.1 C 115.84 -21.1 114.8 -22.14 114.8 -23.43 C 114.8 -24.71 115.84 -25.75 117.13 -25.75 C 118.41 -25.75 119.45 -24.71 119.45 -23.43 Z M 117.13 -23.43"></path></g><g style="--ltx-fill-color:#000000;" fill="#000000"><path style="stroke:none" d="M 111.19 19.29 C 111.19 20.58 110.14 21.62 108.86 21.62 C 107.57 21.62 106.53 20.58 106.53 19.29 C 106.53 18.01 107.57 16.96 108.86 16.96 C 110.14 16.96 111.19 18.01 111.19 19.29 Z M 108.86 19.29"></path></g><g style="--ltx-fill-color:#000000;" fill="#000000"><path style="stroke:none" d="M 159.41 4.13 C 159.41 5.42 158.37 6.46 157.09 6.46 C 155.8 6.46 154.76 5.42 154.76 4.13 C 154.76 2.85 155.8 1.8 157.09 1.8 C 158.37 1.8 159.41 2.85 159.41 4.13 Z M 157.09 4.13"></path></g><g style="--ltx-fill-color:#000000;" fill="#000000"><path style="stroke:none" d="M 215.91 -23.43 C 215.91 -22.14 214.87 -21.1 213.58 -21.1 C 212.3 -21.1 211.25 -22.14 211.25 -23.43 C 211.25 -24.71 212.3 -25.75 213.58 -25.75 C 214.87 -25.75 215.91 -24.71 215.91 -23.43 Z M 213.58 -23.43"></path></g><g style="--ltx-fill-color:#000000;" fill="#000000"><path style="stroke:none" d="M 224.18 19.29 C 224.18 20.58 223.14 21.62 221.85 21.62 C 220.56 21.62 219.52 20.58 219.52 19.29 C 219.52 18.01 220.56 16.96 221.85 16.96 C 223.14 16.96 224.18 18.01 224.18 19.29 Z M 221.85 19.29"></path></g><g style="--ltx-fill-color:#000000;" fill="#000000"><path style="stroke:none" d="M 175.95 4.13 C 175.95 5.42 174.91 6.46 173.62 6.46 C 172.34 6.46 171.29 5.42 171.29 4.13 C 171.29 2.85 172.34 1.8 173.62 1.8 C 174.91 1.8 175.95 2.85 175.95 4.13 Z M 173.62 4.13"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.7 0.0 0.0 0.7 132.25 -12.62)"><foreignObject style="--ltx-fo-width:0.78em;--ltx-fo-height:0.66em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.51" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="9.95"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F3.pic1.m4" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.7 0.0 0.0 0.7 190.14 -13.19)"><foreignObject style="--ltx-fo-width:1.08em;--ltx-fo-height:0.79em;--ltx-fo-depth:0em;font-size:9.25pt;" height="10.13" overflow="visible" transform="matrix(1 0 0 -1 0 10.13)" width="13.83"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F3.pic1.m5" class="ltx_Math" alttext="P^{\prime}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.900em">P</mi><mo mathsize="0.900em">′</mo></msup><annotation encoding="application/x-tex">P^{\prime}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.7 0.0 0.0 0.7 162.81 -50.72)"><foreignObject style="--ltx-fo-width:0.57em;--ltx-fo-height:0.42em;--ltx-fo-depth:0em;font-size:9.25pt;" height="5.36" overflow="visible" transform="matrix(1 0 0 -1 0 5.36)" width="7.25"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F3.pic1.m6" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.7 0.0 0.0 0.7 141.19 -71.32)"><foreignObject style="--ltx-fo-width:5.39em;--ltx-fo-height:0.81em;--ltx-fo-depth:0.27em;font-size:9.25pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="69.05"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F3.pic1.m7" class="ltx_Math" alttext="P\cap P^{\prime}=\{x\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.900em">P</mi><mo mathsize="0.900em">∩</mo><msup><mi mathsize="0.900em">P</mi><mo mathsize="0.900em">′</mo></msup></mrow><mo mathsize="0.900em">=</mo><mrow><mo stretchy="false">{</mo><mi mathsize="0.900em">x</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">P\cap P^{\prime}=\{x\}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">Figure 3. </span></figcaption>
</figure>
</div>
<div id="S4.SS1.p6" class="ltx_para">
<p id="S4.SS1.p6.1" class="ltx_p">Next, we use classical Plücker embeddings of Grassmannians to construct <math id="S4.SS1.p6.m1" class="ltx_Math" alttext="\frac{q^{2}+1}{2}" display="inline" intent=":literal"><semantics><mfrac><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><mn>2</mn></mfrac><annotation encoding="application/x-tex">\frac{q^{2}+1}{2}</annotation></semantics></math> pairwise disjoint spreads of <math id="S4.SS1.p6.m2" class="ltx_Math" alttext="\textrm{PG}(3,q)" display="inline" intent=":literal"><semantics><mrow><mtext>PG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textrm{PG}(3,q)</annotation></semantics></math>. The Plücker embedding realizes the Grassmannian
<math id="S4.SS1.p6.m3" class="ltx_Math" alttext="\operatorname{Gr}(2,V)" display="inline" intent=":literal"><semantics><mrow><mi>Gr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Gr}(2,V)</annotation></semantics></math> of two-dimensional linear subspaces of an <math id="S4.SS1.p6.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-dimensional vector space <math id="S4.SS1.p6.m5" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> as a subvariety of <math id="S4.SS1.p6.m6" class="ltx_Math" alttext="\mathbb{P}^{\binom{n}{2}-1}\cong\mathbb{P}(\bigwedge^{2}V)" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℙ</mi><mrow><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>n</mi><mn>2</mn></mfrac><mo>)</mo></mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>≅</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mo lspace="0em">⋀</mo><mn>2</mn></msup><mi>V</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}^{\binom{n}{2}-1}\cong\mathbb{P}(\bigwedge^{2}V)</annotation></semantics></math>:</p>
<table id="S4.Ex116" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex116.m1" class="ltx_Math" alttext="\iota\colon\operatorname{Gr}(2,V)\hookrightarrow\mathbb{P}\Big(\bigwedge^{2}V\Big),\qquad\textrm{span}(u,v)\longmapsto[u\wedge v]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ι</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>Gr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">↪</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mover><mo lspace="0em" movablelimits="false">⋀</mo><mn>2</mn></mover><mi>V</mi></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟼</mo><mrow><mo stretchy="false">[</mo><mrow><mi>u</mi><mo>∧</mo><mi>v</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\iota\colon\operatorname{Gr}(2,V)\hookrightarrow\mathbb{P}\Big(\bigwedge^{2}V\Big),\qquad\textrm{span}(u,v)\longmapsto[u\wedge v].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p6.2" class="ltx_p">When <math id="S4.SS1.p6.m7" class="ltx_Math" alttext="n=4" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">n=4</annotation></semantics></math>, the image is defined by a single quadratic
equation, given by the Plücker relations. This special case is classically known as the
<em id="S4.SS1.p6.2.1" class="ltx_emph ltx_font_italic">Klein correspondence</em>, and its image as the
<em id="S4.SS1.p6.2.2" class="ltx_emph ltx_font_italic">Klein quadric</em>, studied by Klein in his 1868 dissertation,
republished in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib35" title="" class="ltx_ref">34</a>]</cite>. Over finite fields, the
Klein correspondence identifies regular spreads with elliptic
sections of the Klein quadric.
For usage of Klein correspondence to construct regular spreads in the existing literature, see
<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib33" title="" class="ltx_ref">31</a>, Section 15.4 and Chapter 17]</cite>. Let <math id="S4.SS1.p6.m8" class="ltx_Math" alttext="V=\mathbb{F}_{q}^{4}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>=</mo><msubsup><mi>𝔽</mi><mi>q</mi><mn>4</mn></msubsup></mrow><annotation encoding="application/x-tex">V=\mathbb{F}_{q}^{4}</annotation></semantics></math> with basis <math id="S4.SS1.p6.m9" class="ltx_Math" alttext="v_{1},\dots,v_{4}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>v</mi><mn>4</mn></msub></mrow><annotation encoding="application/x-tex">v_{1},\dots,v_{4}</annotation></semantics></math>, and denote</p>
<table id="S4.Ex117" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex117.m1" class="ltx_Math" alttext="v_{ij}\coloneqq v_{i}\wedge v_{j}\in\bigwedge^{2}V,\qquad W\coloneqq\bigwedge^{2}V" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>v</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>≔</mo><mrow><msub><mi>v</mi><mi>i</mi></msub><mo>∧</mo><msub><mi>v</mi><mi>j</mi></msub></mrow><mo rspace="0.111em">∈</mo><mrow><mover><mo movablelimits="false">⋀</mo><mn>2</mn></mover><mi>V</mi></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>W</mi><mo rspace="0.111em">≔</mo><mrow><mover><mo movablelimits="false">⋀</mo><mn>2</mn></mover><mi>V</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">v_{ij}\coloneqq v_{i}\wedge v_{j}\in\bigwedge^{2}V,\qquad W\coloneqq\bigwedge^{2}V</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p6.3" class="ltx_p">The Plücker relation defines the quadratic form on <math id="S4.SS1.p6.m10" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> with its bilinear form</p>
<table id="S4.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex118"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex118.m1" class="ltx_Math" alttext="\displaystyle Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">\displaystyle Q</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex118.m2" class="ltx_Math" alttext="\displaystyle\colon W\to\mathbb{F}_{q},\quad x\mapsto x_{12}x_{34}-x_{13}x_{24}+x_{14}x_{23}" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>W</mi><mo stretchy="false">→</mo><msub><mi>𝔽</mi><mi>q</mi></msub></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>x</mi><mo stretchy="false">↦</mo><mrow><mrow><mrow><msub><mi>x</mi><mn>12</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>34</mn></msub></mrow><mo>−</mo><mrow><msub><mi>x</mi><mn>13</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>24</mn></msub></mrow></mrow><mo>+</mo><mrow><msub><mi>x</mi><mn>14</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>23</mn></msub></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\colon W\to\mathbb{F}_{q},\quad x\mapsto x_{12}x_{34}-x_{13}x_{24}+x_{14}x_{23}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex119"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex119.m1" class="ltx_Math" alttext="\displaystyle B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">\displaystyle B</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex119.m2" class="ltx_Math" alttext="\displaystyle\colon W^{2}\to\mathbb{F}_{q},\quad(x,y)\mapsto Q(x+y)-Q(x)-Q(y)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>W</mi><mn>2</mn></msup><mo stretchy="false">→</mo><msub><mi>𝔽</mi><mi>q</mi></msub></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">↦</mo><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>+</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\colon W^{2}\to\mathbb{F}_{q},\quad(x,y)\mapsto Q(x+y)-Q(x)-Q(y).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p6.4" class="ltx_p">The <em id="S4.SS1.p6.4.1" class="ltx_emph ltx_font_italic">Klein quadric</em> is the image of the Plücker embedding, or equivalently, the vanishing locus of the quadratic form <math id="S4.SS1.p6.m11" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math></p>
<table id="S4.Ex120" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex120.m1" class="ltx_Math" alttext="\mathcal{K}\colon\{\,[x]\in\mathbb{P}(W):Q(x)=0\,\}," display="block" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒦</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo rspace="0.170em" stretchy="false">{</mo><mrow><mrow><mo stretchy="false">[</mo><mi>x</mi><mo stretchy="false">]</mo></mrow><mo>∈</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0.170em" stretchy="false">}</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{K}\colon\{\,[x]\in\mathbb{P}(W):Q(x)=0\,\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p6.5" class="ltx_p">and the Plücker embedding gives the set bijection</p>
<table id="S4.Ex121" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex121.m1" class="ltx_Math" alttext="\kappa:\mathcal{L}_{2}(\textrm{PG}(3,q))\longrightarrow\mathcal{K},\qquad\mathbb{P}(\textrm{span}(u,v))\longmapsto[u\wedge v]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>κ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>PG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟶</mo><mi class="ltx_font_mathcaligraphic">𝒦</mi></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟼</mo><mrow><mo stretchy="false">[</mo><mrow><mi>u</mi><mo>∧</mo><mi>v</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\kappa:\mathcal{L}_{2}(\textrm{PG}(3,q))\longrightarrow\mathcal{K},\qquad\mathbb{P}(\textrm{span}(u,v))\longmapsto[u\wedge v].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p6.6" class="ltx_p">In addition, we also have the set bijection by definition,</p>
<table id="S4.Ex122" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex122.m1" class="ltx_Math" alttext="\gamma\colon\mathcal{L}_{2}(\textrm{PG}(3,q))\xrightarrow{\simeq}\operatorname{Gr}(2,V)." display="block" intent=":literal"><semantics><mrow><mrow><mi>γ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>PG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mover accent="true"><mo>→</mo><mo mathsize="0.700em">≃</mo></mover><mrow><mi>Gr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\gamma\colon\mathcal{L}_{2}(\textrm{PG}(3,q))\xrightarrow{\simeq}\operatorname{Gr}(2,V).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p6.7" class="ltx_p">Therefore, there is a commutative diagram of set morphisms</p>
<table id="S4.E26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="0" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(26)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span class="ltx_inline-block"><svg id="S4.E26.m1.pic1" class="ltx_picture ltx_markedasmath" height="98.05" overflow="visible" style="vertical-align:-48.87px" version="1.1" viewBox="0 0 381.48 98.05" width="381.48"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,98.05) matrix(1 0 0 -1 0 0) translate(190.74,0) translate(0,48.87)"><g stroke-width="0.4pt" transform="matrix(1.0 0.0 0.0 1.0 -190.74 -29.97)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 97.74)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 15.44)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 0 0) translate(51.08,0) matrix(1.0 0.0 0.0 1.0 -45.12 0)"><foreignObject style="--ltx-fo-width:5.52em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="76.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.E26.m1.pic1.m1" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\mathcal{L}_{2}(\textrm{PG}(3,q))}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>PG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\mathcal{L}_{2}(\textrm{PG}(3,q))}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 254.67 0) translate(88.32,0) matrix(1.0 0.0 0.0 1.0 -32.55 0)"><foreignObject style="--ltx-fo-width:3.7em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="51.26"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.E26.m1.pic1.m2" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\operatorname{Gr}(2,V)}" display="inline" intent=":literal"><semantics><mrow><mi>Gr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\operatorname{Gr}(2,V)}</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 78.85)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 102.15 0) translate(101.17,0) matrix(1.0 0.0 0.0 1.0 -45.39 0)"><foreignObject style="--ltx-fo-width:5.56em;--ltx-fo-height:0.9em;--ltx-fo-depth:1em;font-size:10pt;" height="26.29" overflow="visible" transform="matrix(1 0 0 -1 0 12.45)" width="76.95"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.E26.m1.pic1.m3" class="ltx_Math" alttext="{\lx@inpgf@ignorespaces\mathbb{P}\bigl(\bigwedge^{2}V\bigr)\cong\mathbb{P}^{5}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msup><mo lspace="0em">⋀</mo><mn>2</mn></msup><mi>V</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>≅</mo><msup><mi>ℙ</mi><mn>5</mn></msup></mrow><annotation encoding="application/x-tex">{\lx@inpgf@ignorespaces\mathbb{P}\bigl(\bigwedge^{2}V\bigr)\cong\mathbb{P}^{5}}</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -88.32 36.89 L 112.9 36.89"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 113.18 36.89)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 9.66 42.03)"><foreignObject style="--ltx-fo-width:0.42em;--ltx-fo-height:0.3em;--ltx-fo-depth:0.14em;font-size:10pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="5.81"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.E26.m1.pic1.m4" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\gamma}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">γ</mi><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\gamma}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M -110.23 24.63 L -22.35 -11.96"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.92316 -0.38441 0.38441 0.92316 -22.1 -12.07)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -75.77 -1.2)"><foreignObject style="--ltx-fo-width:0.47em;--ltx-fo-height:0.3em;--ltx-fo-depth:0em;font-size:10pt;" height="4.17" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="6.48"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.E26.m1.pic1.m5" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\kappa}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">κ</mi><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\kappa}</annotation></semantics></math></span></span></foreignObject></g></g><g stroke-width="0.39998pt"><path style="fill:none" d="M 123.42 23.81 L 44.65 -11.95"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="miter" transform="matrix(0.91058 0.41331 0.41331 -0.91058 123.42 23.81)"><path style="fill:none" d="M 0 2.71 C 0.95 2.71 1.72 2.1 1.72 1.36 C 1.72 0.61 0.95 0 0 0"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(-0.91058 -0.41331 0.41331 -0.91058 44.39 -12.06)"><path style="fill:none" d="M -2.88 3.32 C -2.35 1.33 -1.18 0.39 0 0 C -1.18 -0.39 -2.35 -1.33 -2.88 -3.32"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 87.94 -1.2)"><foreignObject style="--ltx-fo-width:0.3em;--ltx-fo-height:0.3em;--ltx-fo-depth:0em;font-size:10pt;" height="4.17" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="4.1"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.E26.m1.pic1.m6" class="ltx_Math" alttext="\scriptstyle{\lx@inpgf@ignorespaces\iota}" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">ι</mi><annotation encoding="application/x-tex">\scriptstyle{\lx@inpgf@ignorespaces\iota}</annotation></semantics></math></span></span></foreignObject></g></g></g></svg></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p6.8" class="ltx_p">A quadric in <math id="S4.SS1.p6.m12" class="ltx_Math" alttext="\mathbb{P}^{3}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>3</mn></msup><annotation encoding="application/x-tex">\mathbb{P}^{3}</annotation></semantics></math> is <em id="S4.SS1.p6.8.1" class="ltx_emph ltx_font_italic">elliptic</em> if it is smooth, and contains no projective lines.
An <em id="S4.SS1.p6.8.2" class="ltx_emph ltx_font_italic">elliptic section</em> of the Klein quadric <math id="S4.SS1.p6.m13" class="ltx_Math" alttext="\mathcal{K}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒦</mi><annotation encoding="application/x-tex">\mathcal{K}</annotation></semantics></math> is an
intersection with a <math id="S4.SS1.p6.m14" class="ltx_Math" alttext="\mathbb{P}^{3}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>3</mn></msup><annotation encoding="application/x-tex">\mathbb{P}^{3}</annotation></semantics></math> which contains no projective lines.
Under the Klein correspondence, elliptic sections correspond precisely
to regular spreads of <math id="S4.SS1.p6.m15" class="ltx_Math" alttext="\textrm{PG}(3,q)" display="inline" intent=":literal"><semantics><mrow><mtext>PG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textrm{PG}(3,q)</annotation></semantics></math>.
Therefore, our task reduces to constructing <math id="S4.SS1.p6.m16" class="ltx_Math" alttext="\frac{q^{2}+1}{2}" display="inline" intent=":literal"><semantics><mfrac><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><mn>2</mn></mfrac><annotation encoding="application/x-tex">\frac{q^{2}+1}{2}</annotation></semantics></math> pairwise
disjoint elliptic sections of <math id="S4.SS1.p6.m17" class="ltx_Math" alttext="\mathcal{K}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒦</mi><annotation encoding="application/x-tex">\mathcal{K}</annotation></semantics></math>.</p>
</div>
<div id="S4.Thmthm3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm3.2" class="ltx_text ltx_font_bold">Lemma 4.3</span></span></h6>
<div id="S4.Thmthm3.p1" class="ltx_para">
<p id="S4.Thmthm3.p1.1" class="ltx_p"><span id="S4.Thmthm3.p1.1.1" class="ltx_text ltx_font_italic">The Klein correspondence</span></p>
<table id="S4.Ex123" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex123.m1" class="ltx_Math" alttext="\kappa:\mathcal{L}_{2}(\textrm{PG}(3,q))\longrightarrow\mathcal{K}" display="block" intent=":literal"><semantics><mrow><mi>κ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>PG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟶</mo><mi class="ltx_font_mathcaligraphic">𝒦</mi></mrow></mrow><annotation encoding="application/x-tex">\kappa:\mathcal{L}_{2}(\textrm{PG}(3,q))\longrightarrow\mathcal{K}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm3.p1.2" class="ltx_p"><span id="S4.Thmthm3.p1.2.1" class="ltx_text ltx_font_italic">induces a bijection between elliptic sections of <math id="S4.Thmthm3.p1.m1" class="ltx_Math" alttext="\mathcal{K}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒦</mi><annotation encoding="application/x-tex">\mathcal{K}</annotation></semantics></math> and
regular spreads of <math id="S4.Thmthm3.p1.m2" class="ltx_Math" alttext="\textrm{PG}(3,q)" display="inline" intent=":literal"><semantics><mrow><mtext>PG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textrm{PG}(3,q)</annotation></semantics></math>, given by</span></p>
<table id="S4.Ex124" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex124.m1" class="ltx_Math" alttext="\mathcal{E}\longmapsto\mathcal{S}(\mathcal{E}):=\kappa^{-1}(\mathcal{E})\subseteq\mathcal{L}_{2}(\textrm{PG}(3,q))." display="block" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">⟼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><msup><mi>κ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊆</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>PG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{E}\longmapsto\mathcal{S}(\mathcal{E}):=\kappa^{-1}(\mathcal{E})\subseteq\mathcal{L}_{2}(\textrm{PG}(3,q)).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.SS1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS1.p7" class="ltx_para">
<p id="S4.SS1.p7.1" class="ltx_p"><span id="S4.SS1.p7.1.1" class="ltx_text">Let <math id="S4.SS1.p7.m1" class="ltx_Math" alttext="\mathcal{E}=\mathcal{K}\cap\mathbb{P}(U)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒦</mi><mo>∩</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{E}=\mathcal{K}\cap\mathbb{P}(U)</annotation></semantics></math> be an elliptic section.
If two distinct lines in <math id="S4.SS1.p7.m2" class="ltx_Math" alttext="\mathcal{S}(\mathcal{E})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{S}(\mathcal{E})</annotation></semantics></math> intersected, the
projective line joining their Klein images would lie entirely
on <math id="S4.SS1.p7.m3" class="ltx_Math" alttext="\mathcal{K}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒦</mi><annotation encoding="application/x-tex">\mathcal{K}</annotation></semantics></math>. It would also lie in <math id="S4.SS1.p7.m4" class="ltx_Math" alttext="\mathbb{P}(U)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(U)</annotation></semantics></math>, hence in
<math id="S4.SS1.p7.m5" class="ltx_Math" alttext="\mathcal{E}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">\mathcal{E}</annotation></semantics></math>, contradicting ellipticity. Thus the projective lines of
<math id="S4.SS1.p7.m6" class="ltx_Math" alttext="\mathcal{S}(\mathcal{E})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{S}(\mathcal{E})</annotation></semantics></math> are pairwise skew. An elliptic quadric has <math id="S4.SS1.p7.m7" class="ltx_Math" alttext="q^{2}+1" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">q^{2}+1</annotation></semantics></math> points, so <math id="S4.SS1.p7.m8" class="ltx_Math" alttext="\mathcal{S}(\mathcal{E})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{S}(\mathcal{E})</annotation></semantics></math>
consists of <math id="S4.SS1.p7.m9" class="ltx_Math" alttext="q^{2}+1" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">q^{2}+1</annotation></semantics></math> pairwise skew lines. Since each projective line contains <math id="S4.SS1.p7.m10" class="ltx_Math" alttext="q+1" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">q+1</annotation></semantics></math> points, and</span></p>
<table id="S4.Ex125" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex125.m1" class="ltx_Math" alttext="(q^{2}+1)(q+1)=q^{3}+q^{2}+q+1=|\textrm{PG}(3,q)|," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>q</mi><mn>3</mn></msup><mo>+</mo><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mi>q</mi><mo>+</mo><mn>1</mn></mrow><mo>=</mo><mrow><mo stretchy="false">|</mo><mrow><mtext>PG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">(q^{2}+1)(q+1)=q^{3}+q^{2}+q+1=|\textrm{PG}(3,q)|,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p7.2" class="ltx_p"><span id="S4.SS1.p7.2.1" class="ltx_text">these lines partition the point set of <math id="S4.SS1.p7.m11" class="ltx_Math" alttext="\textrm{PG}(3,q)" display="inline" intent=":literal"><semantics><mrow><mtext>PG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textrm{PG}(3,q)</annotation></semantics></math> and form a spread.
The fact that this spread is regular, and that every regular spread
arises from an elliptic section, is the classical
regular-spread correspondence
<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib33" title="" class="ltx_ref">31</a>, Section 15.4 and Chapter 17]</cite>.
Furthermore, since <math id="S4.SS1.p7.m12" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> is a bijection, the regular spread from an elliptic section is unique.
∎</span></p>
</div>
</div>
<div id="S4.SS1.p8" class="ltx_para">
<p id="S4.SS1.p8.1" class="ltx_p">To construct <math id="S4.SS1.p8.m1" class="ltx_Math" alttext="\frac{q^{2}+1}{2}" display="inline" intent=":literal"><semantics><mfrac><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><mn>2</mn></mfrac><annotation encoding="application/x-tex">\frac{q^{2}+1}{2}</annotation></semantics></math> pairwise disjoint elliptic sections of <math id="S4.SS1.p8.m2" class="ltx_Math" alttext="\mathcal{K}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒦</mi><annotation encoding="application/x-tex">\mathcal{K}</annotation></semantics></math>, we use <em id="S4.SS1.p8.1.1" class="ltx_emph ltx_font_italic">polarity</em> given by the nondegenerate bilinear form <math id="S4.SS1.p8.m3" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> on <math id="S4.SS1.p8.m4" class="ltx_Math" alttext="\mathcal{K}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒦</mi><annotation encoding="application/x-tex">\mathcal{K}</annotation></semantics></math>.
A projective line <math id="S4.SS1.p8.m5" class="ltx_Math" alttext="\ell\subseteq\mathbb{P}(W)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>⊆</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\ell\subseteq\mathbb{P}(W)</annotation></semantics></math> is <em id="S4.SS1.p8.1.2" class="ltx_emph ltx_font_italic">external</em>
to <math id="S4.SS1.p8.m6" class="ltx_Math" alttext="\mathcal{K}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒦</mi><annotation encoding="application/x-tex">\mathcal{K}</annotation></semantics></math>, if <math id="S4.SS1.p8.m7" class="ltx_Math" alttext="\ell\cap\mathcal{K}=\varnothing" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>∩</mo><mi class="ltx_font_mathcaligraphic">𝒦</mi></mrow><mo>=</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\ell\cap\mathcal{K}=\varnothing</annotation></semantics></math>. The quadratic form <math id="S4.SS1.p8.m8" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> has associated nondegenerate symmetric
bilinear form</p>
<table id="S4.Ex126" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex126.m1" class="ltx_Math" alttext="B(x,y)=Q(x+y)-Q(x)-Q(y)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>+</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">B(x,y)=Q(x+y)-Q(x)-Q(y).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p8.2" class="ltx_p">For a linear subspace <math id="S4.SS1.p8.m9" class="ltx_Math" alttext="A\subseteq W" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>⊆</mo><mi>W</mi></mrow><annotation encoding="application/x-tex">A\subseteq W</annotation></semantics></math>, we define its orthogonal
complement by</p>
<table id="S4.Ex127" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex127.m1" class="ltx_math_unparsed" alttext="A^{\perp_{B}}\coloneqq\{w\in W:B(w,a)=0\text{ for every }a\in A\}." display="block" intent=":literal"><semantics><mrow><msup><mi>A</mi><mrow><mo>⟂</mo><msub><mrow></mrow><mi>B</mi></msub></mrow></msup><mo>≔</mo><mrow><mo stretchy="false">{</mo><mi>w</mi><mo>∈</mo><mi>W</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>B</mi><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mn>0</mn><mtext> for every </mtext><mi>a</mi><mo>∈</mo><mi>A</mi><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">A^{\perp_{B}}\coloneqq\{w\in W:B(w,a)=0\text{ for every }a\in A\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p8.3" class="ltx_p">The <em id="S4.SS1.p8.3.1" class="ltx_emph ltx_font_italic">polar</em> of the projective subspace <math id="S4.SS1.p8.m10" class="ltx_Math" alttext="\mathbb{P}(A)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(A)</annotation></semantics></math> is the
projectivization of this complement</p>
<table id="S4.Ex128" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex128.m1" class="ltx_math_unparsed" alttext="\mathbb{P}(A)^{\perp}\coloneqq\mathbb{P}(A^{\perp_{B}})." display="block" intent=":literal"><semantics><mrow><mi>ℙ</mi><msup><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mo>⟂</mo></msup><mo>≔</mo><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mrow><mo>⟂</mo><msub><mrow></mrow><mi>B</mi></msub></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{P}(A)^{\perp}\coloneqq\mathbb{P}(A^{\perp_{B}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p8.4" class="ltx_p">Since <math id="S4.SS1.p8.m11" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> has dimension <math id="S4.SS1.p8.m12" class="ltx_Math" alttext="\binom{4}{2}=6" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mfrac linethickness="0pt"><mn>4</mn><mn>2</mn></mfrac><mo>)</mo></mrow><mo>=</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">\binom{4}{2}=6</annotation></semantics></math>, the polar of a projective line is a <math id="S4.SS1.p8.m13" class="ltx_Math" alttext="\mathbb{P}^{3}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>3</mn></msup><annotation encoding="application/x-tex">\mathbb{P}^{3}</annotation></semantics></math>. Moreover, if <math id="S4.SS1.p8.m14" class="ltx_Math" alttext="\langle S,T\rangle" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⟨</mo><mrow><mi>S</mi><mo>,</mo><mi>T</mi></mrow><mo stretchy="false">⟩</mo></mrow><annotation encoding="application/x-tex">\langle S,T\rangle</annotation></semantics></math> denotes
the projective span of two projective subspaces, then</p>
<table id="S4.Ex129" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex129.m1" class="ltx_Math" alttext="(S^{\perp})^{\perp}=S,\qquad\langle S,T\rangle^{\perp}=S^{\perp}\cap T^{\perp}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><msup><mi>S</mi><mo>⟂</mo></msup><mo stretchy="false">)</mo></mrow><mo>⟂</mo></msup><mo>=</mo><mi>S</mi></mrow><mo rspace="2.167em">,</mo><mrow><msup><mrow><mo stretchy="false">⟨</mo><mrow><mi>S</mi><mo>,</mo><mi>T</mi></mrow><mo stretchy="false">⟩</mo></mrow><mo>⟂</mo></msup><mo>=</mo><mrow><msup><mi>S</mi><mo>⟂</mo></msup><mo>∩</mo><msup><mi>T</mi><mo>⟂</mo></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(S^{\perp})^{\perp}=S,\qquad\langle S,T\rangle^{\perp}=S^{\perp}\cap T^{\perp}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p8.5" class="ltx_p">For the Klein quadric <math id="S4.SS1.p8.m15" class="ltx_Math" alttext="\mathcal{K}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒦</mi><annotation encoding="application/x-tex">\mathcal{K}</annotation></semantics></math>, the polar of an external line meets <math id="S4.SS1.p8.m16" class="ltx_Math" alttext="\mathcal{K}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒦</mi><annotation encoding="application/x-tex">\mathcal{K}</annotation></semantics></math>
in an elliptic section. Thus every external line <math id="S4.SS1.p8.m17" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> determines
an elliptic quadric <math id="S4.SS1.p8.m18" class="ltx_Math" alttext="\mathcal{K}\cap\ell^{\perp}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒦</mi><mo>∩</mo><msup><mi mathvariant="normal">ℓ</mi><mo>⟂</mo></msup></mrow><annotation encoding="application/x-tex">\mathcal{K}\cap\ell^{\perp}</annotation></semantics></math> and hence a regular spread of <math id="S4.SS1.p8.m19" class="ltx_Math" alttext="\textrm{PG}(3,q)" display="inline" intent=":literal"><semantics><mrow><mtext>PG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textrm{PG}(3,q)</annotation></semantics></math>.
We will construct several external lines so that their polar projective spaces meet only outside <math id="S4.SS1.p8.m20" class="ltx_Math" alttext="\mathcal{K}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒦</mi><annotation encoding="application/x-tex">\mathcal{K}</annotation></semantics></math>.</p>
</div>
<div id="S4.Thmthm4" class="ltx_theorem ltx_theorem_construction">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm4.2" class="ltx_text ltx_font_bold">Construction 4.4</span></span></h6>
<div id="S4.Thmthm4.p1" class="ltx_para">
<p id="S4.Thmthm4.p1.1" class="ltx_p">Let <math id="S4.Thmthm4.p1.m1" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> be an odd prime power. Choose an external line</p>
<table id="S4.Ex130" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex130.m1" class="ltx_Math" alttext="\ell_{0}=\mathbb{P}(A_{0})\subseteq\mathbb{P}(W)\qquad\text{ with }\dim A_{0}=2," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>0</mn></msub><mo>=</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>⊆</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mrow><mtext> with </mtext><mo lspace="0.167em" rspace="0em">​</mo><mrow><mo rspace="0.167em">dim</mo><msub><mi>A</mi><mn>0</mn></msub></mrow></mrow><mo>=</mo><mn>2</mn></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\ell_{0}=\mathbb{P}(A_{0})\subseteq\mathbb{P}(W)\qquad\text{ with }\dim A_{0}=2,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm4.p1.2" class="ltx_p">and define the orthogonal complement and its associated elliptic section of <math id="S4.Thmthm4.p1.m2" class="ltx_Math" alttext="\mathcal{K}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒦</mi><annotation encoding="application/x-tex">\mathcal{K}</annotation></semantics></math>,</p>
<table id="S4.Ex131" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex131.m1" class="ltx_math_unparsed" alttext="U=A_{0}^{\perp_{B}},\qquad\mathcal{E}_{0}=\mathcal{K}\cap\mathbb{P}(U)." display="block" intent=":literal"><semantics><mrow><mi>U</mi><mo>=</mo><msubsup><mi>A</mi><mn>0</mn><mrow><mo>⟂</mo><msub><mrow></mrow><mi>B</mi></msub></mrow></msubsup><mo rspace="2.167em">,</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mn>0</mn></msub><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒦</mi><mo>∩</mo><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">U=A_{0}^{\perp_{B}},\qquad\mathcal{E}_{0}=\mathcal{K}\cap\mathbb{P}(U).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm4.p1.3" class="ltx_p">Then <math id="S4.Thmthm4.p1.m3" class="ltx_Math" alttext="\dim U=4" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">dim</mo><mi>U</mi></mrow><mo>=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">\dim U=4</annotation></semantics></math>, <math id="S4.Thmthm4.p1.m4" class="ltx_Math" alttext="\mathbb{P}(U)=\ell_{0}^{\perp}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msubsup><mi mathvariant="normal">ℓ</mi><mn>0</mn><mo>⟂</mo></msubsup></mrow><annotation encoding="application/x-tex">\mathbb{P}(U)=\ell_{0}^{\perp}</annotation></semantics></math>,
and <math id="S4.Thmthm4.p1.m5" class="ltx_Math" alttext="\mathcal{E}_{0}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\mathcal{E}_{0}</annotation></semantics></math> is an elliptic quadric. By <a href="#S4.Thmthm6" title="Lemma 4.6 ‣ 4.1. The affine family ‣ 4. Four families from finite geometries ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">4.6</span></a>, there exists a fixed-point-free projective involution <math id="S4.Thmthm4.p1.m6" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> of <math id="S4.Thmthm4.p1.m7" class="ltx_Math" alttext="\mathbb{P}(U)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(U)</annotation></semantics></math> satisfying</p>
<table id="S4.Ex132" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex132.m1" class="ltx_Math" alttext="\tau^{2}=\operatorname{id},\qquad\tau(x)\neq x\quad\text{for every }x\in\mathbb{P}(U),\qquad\tau(\mathcal{E}_{0})=\mathcal{E}_{0}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>τ</mi><mn>2</mn></msup><mo>=</mo><mi>id</mi></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mi>x</mi></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mtext>for every </mtext><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>∈</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mn>0</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tau^{2}=\operatorname{id},\qquad\tau(x)\neq x\quad\text{for every }x\in\mathbb{P}(U),\qquad\tau(\mathcal{E}_{0})=\mathcal{E}_{0}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm4.p1.4" class="ltx_p">Let <math id="S4.Thmthm4.p1.m8" class="ltx_Math" alttext="\{\ell_{1},\ldots,\ell_{m}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi mathvariant="normal">ℓ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi mathvariant="normal">ℓ</mi><mi>m</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\ell_{1},\ldots,\ell_{m}\}</annotation></semantics></math> denote the distinct lines spanned by <math id="S4.Thmthm4.p1.m9" class="ltx_Math" alttext="\{x,\tau(x)\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mi>x</mi><mo>,</mo><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{x,\tau(x)\}</annotation></semantics></math> for <math id="S4.Thmthm4.p1.m10" class="ltx_Math" alttext="x\in\mathbb{P}(U)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x\in\mathbb{P}(U)</annotation></semantics></math> which are disjoint from <math id="S4.Thmthm4.p1.m11" class="ltx_Math" alttext="\mathcal{E}_{0}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\mathcal{E}_{0}</annotation></semantics></math>. These lines are external to <math id="S4.Thmthm4.p1.m12" class="ltx_Math" alttext="\mathcal{K}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒦</mi><annotation encoding="application/x-tex">\mathcal{K}</annotation></semantics></math>,
since they lie in <math id="S4.Thmthm4.p1.m13" class="ltx_Math" alttext="\mathbb{P}(U)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(U)</annotation></semantics></math> and are disjoint from
<math id="S4.Thmthm4.p1.m14" class="ltx_Math" alttext="\mathcal{E}_{0}=\mathcal{K}\cap\mathbb{P}(U)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mn>0</mn></msub><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒦</mi><mo>∩</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{E}_{0}=\mathcal{K}\cap\mathbb{P}(U)</annotation></semantics></math>.
We therefore define for each <math id="S4.Thmthm4.p1.m15" class="ltx_Math" alttext="1\leqslant i\leqslant m" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>⩽</mo><mi>i</mi><mo>⩽</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">1\leqslant i\leqslant m</annotation></semantics></math>,</p>
<table id="S4.Ex133" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex133.m1" class="ltx_Math" alttext="\mathcal{E}_{i}\coloneqq\mathcal{K}\cap\ell_{i}^{\perp},\qquad\mathcal{S}_{i}\coloneqq\kappa^{-1}(\mathcal{E}_{i})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>i</mi></msub><mo>≔</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒦</mi><mo>∩</mo><msubsup><mi mathvariant="normal">ℓ</mi><mi>i</mi><mo>⟂</mo></msubsup></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>i</mi></msub><mo>≔</mo><mrow><msup><mi>κ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{E}_{i}\coloneqq\mathcal{K}\cap\ell_{i}^{\perp},\qquad\mathcal{S}_{i}\coloneqq\kappa^{-1}(\mathcal{E}_{i}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.Thmthm5" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm5.2" class="ltx_text ltx_font_bold">Lemma 4.5</span></span></h6>
<div id="S4.Thmthm5.p1" class="ltx_para">
<p id="S4.Thmthm5.p1.1" class="ltx_p"><a href="#S4.Thmthm4" title="Construction 4.4 ‣ 4.1. The affine family ‣ 4. Four families from finite geometries ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">Construction</span> <span class="ltx_text ltx_ref_tag">4.4</span></a><span id="S4.Thmthm5.p1.1.1" class="ltx_text ltx_font_italic"> gives <math id="S4.Thmthm5.p1.m1" class="ltx_Math" alttext="\frac{q^{2}+1}{2}" display="inline" intent=":literal"><semantics><mfrac><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><mn>2</mn></mfrac><annotation encoding="application/x-tex">\frac{q^{2}+1}{2}</annotation></semantics></math> pairwise disjoint elliptic
sections of <math id="S4.Thmthm5.p1.m2" class="ltx_Math" alttext="\mathcal{K}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒦</mi><annotation encoding="application/x-tex">\mathcal{K}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS1.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS1.p9" class="ltx_para">
<p id="S4.SS1.p9.1" class="ltx_p"><span id="S4.SS1.p9.1.1" class="ltx_text">Each line <math id="S4.SS1.p9.m1" class="ltx_Math" alttext="\textrm{span}(x,\tau(x))" display="inline" intent=":literal"><semantics><mrow><mtext>span</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mrow><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textrm{span}(x,\tau(x))</annotation></semantics></math> is preserved by
<math id="S4.SS1.p9.m2" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>. Two distinct such lines cannot meet, since their unique
intersection point would be fixed by <math id="S4.SS1.p9.m3" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>.
Every point lies on its joining line, so these lines form a
spread of <math id="S4.SS1.p9.m4" class="ltx_Math" alttext="\mathbb{P}(U)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(U)</annotation></semantics></math>, consisting of <math id="S4.SS1.p9.m5" class="ltx_Math" alttext="q^{2}+1" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">q^{2}+1</annotation></semantics></math> lines. Each of these lines meets <math id="S4.SS1.p9.m6" class="ltx_Math" alttext="\mathcal{E}_{0}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\mathcal{E}_{0}</annotation></semantics></math> in either zero or two points. Indeed, a line containing <math id="S4.SS1.p9.m7" class="ltx_Math" alttext="x\in\mathcal{E}_{0}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">x\in\mathcal{E}_{0}</annotation></semantics></math> also contains the distinct
point <math id="S4.SS1.p9.m8" class="ltx_Math" alttext="\tau(x)\in\mathcal{E}_{0}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\tau(x)\in\mathcal{E}_{0}</annotation></semantics></math>; it cannot contain more than two points
of the quadric without lying entirely on it.
Since <math id="S4.SS1.p9.m9" class="ltx_Math" alttext="\mathcal{E}_{0}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\mathcal{E}_{0}</annotation></semantics></math> has <math id="S4.SS1.p9.m10" class="ltx_Math" alttext="q^{2}+1" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">q^{2}+1</annotation></semantics></math> points, exactly half the spread lines
meet it, and the other half avoid it. Therefore <math id="S4.SS1.p9.m11" class="ltx_Math" alttext="m=\frac{q^{2}+1}{2}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>=</mo><mfrac><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">m=\frac{q^{2}+1}{2}</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS1.p10" class="ltx_para">
<p id="S4.SS1.p10.1" class="ltx_p"><span id="S4.SS1.p10.1.1" class="ltx_text">For <math id="S4.SS1.p10.m1" class="ltx_Math" alttext="i\neq j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≠</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i\neq j</annotation></semantics></math>, the lines <math id="S4.SS1.p10.m2" class="ltx_Math" alttext="\ell_{i},\ell_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">ℓ</mi><mi>i</mi></msub><mo>,</mo><msub><mi mathvariant="normal">ℓ</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">\ell_{i},\ell_{j}</annotation></semantics></math> are skew and hence span
<math id="S4.SS1.p10.m3" class="ltx_Math" alttext="\mathbb{P}(U)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(U)</annotation></semantics></math>. Therefore,</span></p>
<table id="S4.Ex134" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex134.m1" class="ltx_Math" alttext="\ell_{i}^{\perp}\cap\ell_{j}^{\perp}=\langle\ell_{i},\ell_{j}\rangle^{\perp}=\mathbb{P}(U)^{\perp}=\ell_{0}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi mathvariant="normal">ℓ</mi><mi>i</mi><mo>⟂</mo></msubsup><mo>∩</mo><msubsup><mi mathvariant="normal">ℓ</mi><mi>j</mi><mo>⟂</mo></msubsup></mrow><mo>=</mo><msup><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi mathvariant="normal">ℓ</mi><mi>i</mi></msub><mo>,</mo><msub><mi mathvariant="normal">ℓ</mi><mi>j</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><mo>⟂</mo></msup><mo>=</mo><mrow><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow><mo>⟂</mo></msup></mrow><mo>=</mo><msub><mi mathvariant="normal">ℓ</mi><mn>0</mn></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\ell_{i}^{\perp}\cap\ell_{j}^{\perp}=\langle\ell_{i},\ell_{j}\rangle^{\perp}=\mathbb{P}(U)^{\perp}=\ell_{0}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p10.2" class="ltx_p"><span id="S4.SS1.p10.2.1" class="ltx_text">Their polar spaces meet precisely along the external line <math id="S4.SS1.p10.m4" class="ltx_Math" alttext="\ell_{0}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\ell_{0}</annotation></semantics></math>. Hence</span></p>
<table id="S4.Ex135" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex135.m1" class="ltx_Math" alttext="\mathcal{E}_{i}\cap\mathcal{E}_{j}=\mathcal{K}\cap\ell_{0}=\varnothing." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>i</mi></msub><mo>∩</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>j</mi></msub></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒦</mi><mo>∩</mo><msub><mi mathvariant="normal">ℓ</mi><mn>0</mn></msub></mrow><mo>=</mo><mi mathvariant="normal">∅</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{E}_{i}\cap\mathcal{E}_{j}=\mathcal{K}\cap\ell_{0}=\varnothing.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p10.3" class="ltx_p"><span id="S4.SS1.p10.3.1" class="ltx_text">The corresponding regular spreads <math id="S4.SS1.p10.m5" class="ltx_Math" alttext="\mathcal{S}_{i},\mathcal{S}_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>i</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">\mathcal{S}_{i},\mathcal{S}_{j}</annotation></semantics></math> therefore
share no common elements.
∎</span></p>
</div>
</div>
<div id="S4.Thmthm6" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm6.2" class="ltx_text ltx_font_bold">Lemma 4.6</span></span></h6>
<div id="S4.Thmthm6.p1" class="ltx_para">
<p id="S4.Thmthm6.p1.1" class="ltx_p"><span id="S4.Thmthm6.p1.1.1" class="ltx_text ltx_font_italic">For an odd prime power <math id="S4.Thmthm6.p1.m1" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>, the projective <math id="S4.Thmthm6.p1.m2" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>-space <math id="S4.Thmthm6.p1.m3" class="ltx_Math" alttext="\mathbb{P}(U)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(U)</annotation></semantics></math> in
<a href="#S4.Thmthm4" title="Construction 4.4 ‣ 4.1. The affine family ‣ 4. Four families from finite geometries ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Construction</span> <span class="ltx_text ltx_ref_tag">4.4</span></a> admits a fixed-point-free projective involution
preserving <math id="S4.Thmthm6.p1.m4" class="ltx_Math" alttext="\mathcal{E}_{0}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\mathcal{E}_{0}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS1.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS1.p11" class="ltx_para">
<p id="S4.SS1.p11.1" class="ltx_p"><span id="S4.SS1.p11.1.1" class="ltx_text">In diagonal coordinates, we write <math id="S4.SS1.p11.m1" class="ltx_Math" alttext="Q=Q_{1}\oplus Q_{2}" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo>=</mo><mrow><msub><mi>Q</mi><mn>1</mn></msub><mo>⊕</mo><msub><mi>Q</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">Q=Q_{1}\oplus Q_{2}</annotation></semantics></math>, where</span></p>
<table id="S4.Ex136" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex136.m1" class="ltx_Math" alttext="Q_{i}(s,t)=a_{i}s^{2}+b_{i}t^{2},\qquad a_{i},b_{i}\neq 0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>Q</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>a</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>s</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><msub><mi>b</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mn>2</mn></msup></mrow></mrow></mrow><mo rspace="2.167em">,</mo><msub><mi>a</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>b</mi><mi>i</mi></msub><mo>≠</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Q_{i}(s,t)=a_{i}s^{2}+b_{i}t^{2},\qquad a_{i},b_{i}\neq 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p11.2" class="ltx_p"><span id="S4.SS1.p11.2.1" class="ltx_text">Fix a nonsquare <math id="S4.SS1.p11.m2" class="ltx_Math" alttext="d\in\mathbb{F}_{q}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>∈</mo><msub><mi>𝔽</mi><mi>q</mi></msub></mrow><annotation encoding="application/x-tex">d\in\mathbb{F}_{q}</annotation></semantics></math>. For each <math id="S4.SS1.p11.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, the sets of values
<math id="S4.SS1.p11.m4" class="ltx_Math" alttext="u^{2}" display="inline" intent=":literal"><semantics><msup><mi>u</mi><mn>2</mn></msup><annotation encoding="application/x-tex">u^{2}</annotation></semantics></math> and <math id="S4.SS1.p11.m5" class="ltx_Math" alttext="d-(a_{i}/b_{i})v^{2}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>a</mi><mi>i</mi></msub><mo>/</mo><msub><mi>b</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">d-(a_{i}/b_{i})v^{2}</annotation></semantics></math> each have <math id="S4.SS1.p11.m6" class="ltx_Math" alttext="(q+1)/2" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">(q+1)/2</annotation></semantics></math> elements,
so they intersect. Thus we can choose <math id="S4.SS1.p11.m7" class="ltx_Math" alttext="u_{i},v_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mi>i</mi></msub><mo>,</mo><msub><mi>v</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">u_{i},v_{i}</annotation></semantics></math> satisfying</span></p>
<table id="S4.Ex137" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex137.m1" class="ltx_Math" alttext="u_{i}^{2}+\frac{a_{i}}{b_{i}}v_{i}^{2}=d." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup><mo>+</mo><mrow><mfrac><msub><mi>a</mi><mi>i</mi></msub><msub><mi>b</mi><mi>i</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>v</mi><mi>i</mi><mn>2</mn></msubsup></mrow></mrow><mo>=</mo><mi>d</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">u_{i}^{2}+\frac{a_{i}}{b_{i}}v_{i}^{2}=d.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p11.3" class="ltx_p"><span id="S4.SS1.p11.3.1" class="ltx_text">The matrices</span></p>
<table id="S4.Ex138" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex138.m1" class="ltx_Math" alttext="J_{i}=\begin{pmatrix}u_{i}&amp;v_{i}\\
(a_{i}/b_{i})v_{i}&amp;-u_{i}\end{pmatrix}" display="block" intent=":literal"><semantics><mrow><msub><mi>J</mi><mi>i</mi></msub><mo>=</mo><mrow><mo>(</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mi>u</mi><mi>i</mi></msub></mtd><mtd><msub><mi>v</mi><mi>i</mi></msub></mtd></mtr><mtr><mtd><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>a</mi><mi>i</mi></msub><mo>/</mo><msub><mi>b</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>i</mi></msub></mrow></mtd><mtd><mrow><mo>−</mo><msub><mi>u</mi><mi>i</mi></msub></mrow></mtd></mtr></mtable><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">J_{i}=\begin{pmatrix}u_{i}&amp;v_{i}\\
(a_{i}/b_{i})v_{i}&amp;-u_{i}\end{pmatrix}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p11.4" class="ltx_p"><span id="S4.SS1.p11.4.1" class="ltx_text">satisfy <math id="S4.SS1.p11.m8" class="ltx_Math" alttext="J_{i}^{2}=dI" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>J</mi><mi>i</mi><mn>2</mn></msubsup><mo>=</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><annotation encoding="application/x-tex">J_{i}^{2}=dI</annotation></semantics></math> and <math id="S4.SS1.p11.m9" class="ltx_Math" alttext="Q_{i}(J_{i}x)=dQ_{i}(x)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>Q</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>J</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>Q</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Q_{i}(J_{i}x)=dQ_{i}(x)</annotation></semantics></math>.
Therefore, <math id="S4.SS1.p11.m10" class="ltx_Math" alttext="J=J_{1}\oplus J_{2}" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo>=</mo><mrow><msub><mi>J</mi><mn>1</mn></msub><mo>⊕</mo><msub><mi>J</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">J=J_{1}\oplus J_{2}</annotation></semantics></math> satisfies</span></p>
<table id="S4.Ex139" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex139.m1" class="ltx_Math" alttext="J^{2}=dI,\qquad Q(Jx)=dQ(x)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>J</mi><mn>2</mn></msup><mo>=</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">J^{2}=dI,\qquad Q(Jx)=dQ(x).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p11.5" class="ltx_p"><span id="S4.SS1.p11.5.1" class="ltx_text">Its projectivization <math id="S4.SS1.p11.m11" class="ltx_Math" alttext="\tau([x])=[Jx]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">[</mo><mi>x</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\tau([x])=[Jx]</annotation></semantics></math> is an
involution preserving <math id="S4.SS1.p11.m12" class="ltx_Math" alttext="\mathcal{E}_{0}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\mathcal{E}_{0}</annotation></semantics></math>. A fixed point would give
<math id="S4.SS1.p11.m13" class="ltx_Math" alttext="Jx=\lambda x" display="inline" intent=":literal"><semantics><mrow><mrow><mi>J</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>=</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><annotation encoding="application/x-tex">Jx=\lambda x</annotation></semantics></math> for some <math id="S4.SS1.p11.m14" class="ltx_Math" alttext="x\neq 0" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">x\neq 0</annotation></semantics></math> and <math id="S4.SS1.p11.m15" class="ltx_Math" alttext="\lambda\in\mathbb{F}_{q}" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>∈</mo><msub><mi>𝔽</mi><mi>q</mi></msub></mrow><annotation encoding="application/x-tex">\lambda\in\mathbb{F}_{q}</annotation></semantics></math> with <math id="S4.SS1.p11.m16" class="ltx_Math" alttext="\lambda^{2}=d" display="inline" intent=":literal"><semantics><mrow><msup><mi>λ</mi><mn>2</mn></msup><mo>=</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">\lambda^{2}=d</annotation></semantics></math>, a contradiction.
∎</span></p>
</div>
</div>
<div id="S4.SS1.p12" class="ltx_para">
<p id="S4.SS1.p12.1" class="ltx_p">We now associate a matroid with any collection of pairwise
disjoint spreads. At each step, we adjoin one coloop,
truncate once, and perform the prescribed absorption.</p>
</div>
<div id="S4.Thmthm7" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm7.2" class="ltx_text ltx_font_bold">Definition 4.7</span></span></h6>
<div id="S4.Thmthm7.p1" class="ltx_para">
<p id="S4.Thmthm7.p1.1" class="ltx_p">Let <math id="S4.Thmthm7.p1.m1" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> be a prime power, let <math id="S4.Thmthm7.p1.m2" class="ltx_Math" alttext="V=\mathbb{F}_{q}^{4}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>=</mo><msubsup><mi>𝔽</mi><mi>q</mi><mn>4</mn></msubsup></mrow><annotation encoding="application/x-tex">V=\mathbb{F}_{q}^{4}</annotation></semantics></math>, and let
<math id="S4.Thmthm7.p1.m3" class="ltx_Math" alttext="\mathcal{S}_{1},\dots,\mathcal{S}_{m}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">\mathcal{S}_{1},\dots,\mathcal{S}_{m}</annotation></semantics></math> be pairwise disjoint spreads of
<math id="S4.Thmthm7.p1.m4" class="ltx_Math" alttext="\textrm{PG}(3,q)" display="inline" intent=":literal"><semantics><mrow><mtext>PG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textrm{PG}(3,q)</annotation></semantics></math>.
Choose distinct new elements <math id="S4.Thmthm7.p1.m5" class="ltx_Math" alttext="p_{1},\dots,p_{m}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>p</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">p_{1},\dots,p_{m}</annotation></semantics></math> outside <math id="S4.Thmthm7.p1.m6" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math>.
Define matroids <math id="S4.Thmthm7.p1.m7" class="ltx_Math" alttext="\textrm{M}_{0},\dots,\textrm{M}_{m}" display="inline" intent=":literal"><semantics><mrow><msub><mtext>M</mtext><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mtext>M</mtext><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">\textrm{M}_{0},\dots,\textrm{M}_{m}</annotation></semantics></math> inductively as follows. Set</p>
<table id="S4.Ex140" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex140.m1" class="ltx_Math" alttext="\textrm{M}_{0}\coloneqq\mathrm{Tr}^{1}(\textrm{AG}(4,q))." display="block" intent=":literal"><semantics><mrow><mrow><msub><mtext>M</mtext><mn>0</mn></msub><mo>≔</mo><mrow><msup><mi>Tr</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>AG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>4</mn><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\textrm{M}_{0}\coloneqq\mathrm{Tr}^{1}(\textrm{AG}(4,q)).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm7.p1.2" class="ltx_p">For <math id="S4.Thmthm7.p1.m8" class="ltx_Math" alttext="1\leqslant i\leqslant m" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>⩽</mo><mi>i</mi><mo>⩽</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">1\leqslant i\leqslant m</annotation></semantics></math>, let</p>
<table id="S4.Ex141" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex141.m1" class="ltx_Math" alttext="\widetilde{\textrm{M}}_{i}\coloneqq\mathrm{Tr}^{1}\bigl(\textrm{M}_{i-1}\oplus\textrm{U}_{\{p_{i}\},\{p_{i}\}}\bigr),\qquad\mathcal{H}_{i}\coloneqq\{P\cup\{p_{i}\}:P\in\mathcal{A}(\mathcal{S}_{i})\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mtext>M</mtext><mo>~</mo></mover><mi>i</mi></msub><mo>≔</mo><mrow><msup><mi>Tr</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mtext>M</mtext><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>⊕</mo><msub><mtext>U</mtext><mrow><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mo>,</mo><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>i</mi></msub><mo>≔</mo><mrow><mo stretchy="false">{</mo><mrow><mi>P</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mi>i</mi></msub><mo rspace="0.278em" stretchy="false">}</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mi>P</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widetilde{\textrm{M}}_{i}\coloneqq\mathrm{Tr}^{1}\bigl(\textrm{M}_{i-1}\oplus\textrm{U}_{\{p_{i}\},\{p_{i}\}}\bigr),\qquad\mathcal{H}_{i}\coloneqq\{P\cup\{p_{i}\}:P\in\mathcal{A}(\mathcal{S}_{i})\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm7.p1.3" class="ltx_p">Let <math id="S4.Thmthm7.p1.m9" class="ltx_Math" alttext="\textrm{M}_{i}" display="inline" intent=":literal"><semantics><msub><mtext>M</mtext><mi>i</mi></msub><annotation encoding="application/x-tex">\textrm{M}_{i}</annotation></semantics></math> be the hyperplane coalescence of
<math id="S4.Thmthm7.p1.m10" class="ltx_Math" alttext="\widetilde{\textrm{M}}_{i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mtext>M</mtext><mo>~</mo></mover><mi>i</mi></msub><annotation encoding="application/x-tex">\widetilde{\textrm{M}}_{i}</annotation></semantics></math> along <math id="S4.Thmthm7.p1.m11" class="ltx_Math" alttext="\mathcal{H}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{H}_{i}</annotation></semantics></math>, and let</p>
<table id="S4.Ex142" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex142.m1" class="ltx_Math" alttext="\textrm{M}(\mathcal{S}_{1},\dots,\mathcal{S}_{m})=\textrm{M}_{m}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mtext>M</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mtext>M</mtext><mi>m</mi></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\textrm{M}(\mathcal{S}_{1},\dots,\mathcal{S}_{m})=\textrm{M}_{m}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.Thmthm8" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm8.2" class="ltx_text ltx_font_bold">Definition 4.8</span></span><span id="S4.Thmthm8.3" class="ltx_text ltx_font_bold"> </span>(The affine Klein family)</h6>
<div id="S4.Thmthm8.p1" class="ltx_para">
<p id="S4.Thmthm8.p1.1" class="ltx_p">For odd <math id="S4.Thmthm8.p1.m1" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>, let <math id="S4.Thmthm8.p1.m2" class="ltx_Math" alttext="\{\mathcal{S}_{1},\ldots,\mathcal{S}_{(q^{2}+1)/2}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>2</mn></mrow></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\mathcal{S}_{1},\ldots,\mathcal{S}_{(q^{2}+1)/2}\}</annotation></semantics></math> be the collection of spreads given by
<a href="#S4.Thmthm4" title="Construction 4.4 ‣ 4.1. The affine family ‣ 4. Four families from finite geometries ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Construction</span> <span class="ltx_text ltx_ref_tag">4.4</span></a>. The <em id="S4.Thmthm8.p1.1.1" class="ltx_emph ltx_font_italic">affine Klein family</em> is defined by</p>
<table id="S4.Ex143" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex143.m1" class="ltx_Math" alttext="\textrm{M}_{q}\coloneqq\textrm{M}(\mathcal{S}_{1},\dots,\mathcal{S}_{(q^{2}+1)/2})." display="block" intent=":literal"><semantics><mrow><mrow><msub><mtext>M</mtext><mi>q</mi></msub><mo>≔</mo><mrow><mtext>M</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\textrm{M}_{q}\coloneqq\textrm{M}(\mathcal{S}_{1},\dots,\mathcal{S}_{(q^{2}+1)/2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.Thmthm9" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm9.2" class="ltx_text ltx_font_bold">Proposition 4.9</span></span></h6>
<div id="S4.Thmthm9.p1" class="ltx_para">
<p id="S4.Thmthm9.p1.1" class="ltx_p"><span id="S4.Thmthm9.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmthm9.p1.m1" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> be a prime power, let <math id="S4.Thmthm9.p1.m2" class="ltx_Math" alttext="V=\mathbb{F}_{q}^{4}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>=</mo><msubsup><mi>𝔽</mi><mi>q</mi><mn>4</mn></msubsup></mrow><annotation encoding="application/x-tex">V=\mathbb{F}_{q}^{4}</annotation></semantics></math>, and let
<math id="S4.Thmthm9.p1.m3" class="ltx_Math" alttext="\mathcal{S}_{1},\dots,\mathcal{S}_{m}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">\mathcal{S}_{1},\dots,\mathcal{S}_{m}</annotation></semantics></math> be pairwise disjoint spreads of
<math id="S4.Thmthm9.p1.m4" class="ltx_Math" alttext="\textrm{PG}(3,q)" display="inline" intent=":literal"><semantics><mrow><mtext>PG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textrm{PG}(3,q)</annotation></semantics></math>. Let</span></p>
<table id="S4.Ex144" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex144.m1" class="ltx_Math" alttext="X=\{p_{1},\dots,p_{m}\},\qquad E=V\sqcup X,\qquad\mathcal{A}_{i}=\mathcal{A}(\mathcal{S}_{i})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>X</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>p</mi><mi>m</mi></msub><mo stretchy="false">}</mo></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>E</mi><mo>=</mo><mrow><mi>V</mi><mo>⊔</mo><mi>X</mi></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>i</mi></msub><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">X=\{p_{1},\dots,p_{m}\},\qquad E=V\sqcup X,\qquad\mathcal{A}_{i}=\mathcal{A}(\mathcal{S}_{i}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm9.p1.2" class="ltx_p"><span id="S4.Thmthm9.p1.2.1" class="ltx_text ltx_font_italic">Then <math id="S4.Thmthm9.p1.m5" class="ltx_Math" alttext="\textrm{M}(\mathcal{S}_{1},\dots,\mathcal{S}_{m})" display="inline" intent=":literal"><semantics><mrow><mtext>M</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textrm{M}(\mathcal{S}_{1},\dots,\mathcal{S}_{m})</annotation></semantics></math> is a simple matroid of rank <math id="S4.Thmthm9.p1.m6" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math> on
<math id="S4.Thmthm9.p1.m7" class="ltx_Math" alttext="q^{4}+m" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mn>4</mn></msup><mo>+</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">q^{4}+m</annotation></semantics></math> elements, with proper nonempty flats given by</span></p>
<ol id="S4.I3" class="ltx_enumerate">
<li id="S4.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I3.i1.p1" class="ltx_para">
<p id="S4.I3.i1.p1.1" class="ltx_p"><span id="S4.I3.i1.p1.1.1" class="ltx_text ltx_font_italic">rank </span><math id="S4.I3.i1.p1.m1" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math><span id="S4.I3.i1.p1.1.2" class="ltx_text ltx_font_italic">: the singletons of </span><math id="S4.I3.i1.p1.m2" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math><span id="S4.I3.i1.p1.1.3" class="ltx_text ltx_font_italic">;</span></p>
</div></li>
<li id="S4.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I3.i2.p1" class="ltx_para">
<p id="S4.I3.i2.p1.1" class="ltx_p"><span id="S4.I3.i2.p1.1.1" class="ltx_text ltx_font_italic">rank </span><math id="S4.I3.i2.p1.m1" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math><span id="S4.I3.i2.p1.1.2" class="ltx_text ltx_font_italic">: the affine lines and the two-element
subsets of </span><math id="S4.I3.i2.p1.m2" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math><span id="S4.I3.i2.p1.1.3" class="ltx_text ltx_font_italic"> meeting </span><math id="S4.I3.i2.p1.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math><span id="S4.I3.i2.p1.1.4" class="ltx_text ltx_font_italic">;</span></p>
</div></li>
<li id="S4.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S4.I3.i3.p1" class="ltx_para">
<p id="S4.I3.i3.p1.1" class="ltx_p"><span id="S4.I3.i3.p1.1.1" class="ltx_text ltx_font_italic">rank </span><math id="S4.I3.i3.p1.m1" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math><span id="S4.I3.i3.p1.1.2" class="ltx_text ltx_font_italic">: the affine planes outside
</span><math id="S4.I3.i3.p1.m2" class="ltx_Math" alttext="\bigcup_{i}\mathcal{A}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mo>⋃</mo><mi>i</mi></msub><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\bigcup_{i}\mathcal{A}_{i}</annotation></semantics></math><span id="S4.I3.i3.p1.1.3" class="ltx_text ltx_font_italic">, the sets </span><math id="S4.I3.i3.p1.m3" class="ltx_Math" alttext="P\cup\{p_{i}\}" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">P\cup\{p_{i}\}</annotation></semantics></math><span id="S4.I3.i3.p1.1.4" class="ltx_text ltx_font_italic"> with
</span><math id="S4.I3.i3.p1.m4" class="ltx_Math" alttext="P\in\mathcal{A}_{i}" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">P\in\mathcal{A}_{i}</annotation></semantics></math><span id="S4.I3.i3.p1.1.5" class="ltx_text ltx_font_italic">, and the three-element subsets of </span><math id="S4.I3.i3.p1.m5" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math><span id="S4.I3.i3.p1.1.6" class="ltx_text ltx_font_italic">
containing at least two elements of </span><math id="S4.I3.i3.p1.m6" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math><span id="S4.I3.i3.p1.1.7" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
<p id="S4.Thmthm9.p1.3" class="ltx_p"><span id="S4.Thmthm9.p1.3.1" class="ltx_text ltx_font_italic">In particular, <math id="S4.Thmthm9.p1.m8" class="ltx_Math" alttext="\textrm{M}_{q}" display="inline" intent=":literal"><semantics><msub><mtext>M</mtext><mi>q</mi></msub><annotation encoding="application/x-tex">\textrm{M}_{q}</annotation></semantics></math> is a simple matroid of rank <math id="S4.Thmthm9.p1.m9" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math> on <math id="S4.Thmthm9.p1.m10" class="ltx_Math" alttext="q^{4}+\frac{q^{2}+1}{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mn>4</mn></msup><mo>+</mo><mfrac><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">q^{4}+\frac{q^{2}+1}{2}</annotation></semantics></math> elements.</span></p>
</div>
</div>
<div id="S4.SS1.6" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS1.p13" class="ltx_para">
<p id="S4.SS1.p13.1" class="ltx_p"><span id="S4.SS1.p13.1.1" class="ltx_text">We induct on the number of absorptions, starting from
<math id="S4.SS1.p13.m1" class="ltx_Math" alttext="\textrm{M}_{0}=\mathrm{Tr}^{1}(\textrm{AG}(4,q))" display="inline" intent=":literal"><semantics><mrow><msub><mtext>M</mtext><mn>0</mn></msub><mo>=</mo><mrow><msup><mi>Tr</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>AG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>4</mn><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\textrm{M}_{0}=\mathrm{Tr}^{1}(\textrm{AG}(4,q))</annotation></semantics></math>. Since the spreads are pairwise disjoint, the planes in
<math id="S4.SS1.p13.m2" class="ltx_Math" alttext="\mathcal{A}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{A}_{i}</annotation></semantics></math> remain hyperplanes of <math id="S4.SS1.p13.m3" class="ltx_Math" alttext="\textrm{M}_{i-1}" display="inline" intent=":literal"><semantics><msub><mtext>M</mtext><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\textrm{M}_{i-1}</annotation></semantics></math>.
Since members of <math id="S4.SS1.p13.m4" class="ltx_Math" alttext="\mathcal{A}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{A}_{i}</annotation></semantics></math> intersect in rank at most <math id="S4.SS1.p13.m5" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>, <a href="#S3.Thmthm11" title="Proposition 3.11 ‣ 3.2. Absorption ‣ 3. Matroid operations: hyperplane coalescence, absorption ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">3.11</span></a> implies that the resulting matroid is <math id="S4.SS1.p13.m6" class="ltx_Math" alttext="\textrm{M}_{i}" display="inline" intent=":literal"><semantics><msub><mtext>M</mtext><mi>i</mi></msub><annotation encoding="application/x-tex">\textrm{M}_{i}</annotation></semantics></math>. Adjoining <math id="S4.SS1.p13.m7" class="ltx_Math" alttext="p_{i}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>i</mi></msub><annotation encoding="application/x-tex">p_{i}</annotation></semantics></math> as a coloop and truncating once retains
the old hyperplanes and creates the hyperplanes
<math id="S4.SS1.p13.m8" class="ltx_Math" alttext="L\cup\{p_{i}\}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">L\cup\{p_{i}\}</annotation></semantics></math> for <math id="S4.SS1.p13.m9" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> a flat of rank <math id="S4.SS1.p13.m10" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> of <math id="S4.SS1.p13.m11" class="ltx_Math" alttext="\textrm{M}_{i-1}" display="inline" intent=":literal"><semantics><msub><mtext>M</mtext><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\textrm{M}_{i-1}</annotation></semantics></math>.
Since every affine line lies in exactly one plane of <math id="S4.SS1.p13.m12" class="ltx_Math" alttext="\mathcal{A}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{A}_{i}</annotation></semantics></math>, coalescence replaces each selected plane <math id="S4.SS1.p13.m13" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> by
<math id="S4.SS1.p13.m14" class="ltx_Math" alttext="P\cup\{p_{i}\}" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">P\cup\{p_{i}\}</annotation></semantics></math> and removes precisely the hyperplanes
<math id="S4.SS1.p13.m15" class="ltx_Math" alttext="L\cup\{p_{i}\}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">L\cup\{p_{i}\}</annotation></semantics></math> with <math id="S4.SS1.p13.m16" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> an affine line. The other new hyperplanes are exactly the listed triples
containing <math id="S4.SS1.p13.m17" class="ltx_Math" alttext="p_{i}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>i</mi></msub><annotation encoding="application/x-tex">p_{i}</annotation></semantics></math>. The new flats of ranks <math id="S4.SS1.p13.m18" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> and <math id="S4.SS1.p13.m19" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> in the intermediate
matroid are <math id="S4.SS1.p13.m20" class="ltx_Math" alttext="\{p_{i}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{p_{i}\}</annotation></semantics></math> and <math id="S4.SS1.p13.m21" class="ltx_Math" alttext="\{z,p_{i}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mi>z</mi><mo>,</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{z,p_{i}\}</annotation></semantics></math> for
<math id="S4.SS1.p13.m22" class="ltx_Math" alttext="z\in E(\textrm{M}_{i-1})" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>∈</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mtext>M</mtext><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z\in E(\textrm{M}_{i-1})</annotation></semantics></math>. Since hyperplane coalescence preserves all flats of these ranks, this establishes the inductive step.
∎</span></p>
</div>
</div>
<div id="S4.SS1.p14" class="ltx_para">
<p id="S4.SS1.p14.1" class="ltx_p">For an odd prime power <math id="S4.SS1.p14.m1" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>, a <em id="S4.SS1.p14.1.1" class="ltx_emph ltx_font_italic">packing</em>, introduced by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib25" title="" class="ltx_ref">18</a>, <a href="#bib.bib26" title="" class="ltx_ref">19</a>]</cite>, is a partition of all lines of <math id="S4.SS1.p14.m2" class="ltx_Math" alttext="\textrm{PG}(3,q)" display="inline" intent=":literal"><semantics><mrow><mtext>PG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textrm{PG}(3,q)</annotation></semantics></math> into <math id="S4.SS1.p14.m3" class="ltx_Math" alttext="q^{2}+q+1" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mi>q</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">q^{2}+q+1</annotation></semantics></math> spreads.</p>
</div>
<div id="S4.Thmthm10" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm10.2" class="ltx_text ltx_font_bold">Definition 4.10</span></span><span id="S4.Thmthm10.3" class="ltx_text ltx_font_bold"> </span>(The affine packing family)</h6>
<div id="S4.Thmthm10.p1" class="ltx_para">
<p id="S4.Thmthm10.p1.1" class="ltx_p">For an odd prime power <math id="S4.Thmthm10.p1.m1" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>, let <math id="S4.Thmthm10.p1.m2" class="ltx_Math" alttext="\{\mathcal{S}_{1},\ldots,\mathcal{S}_{q^{2}+q+1}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mi>q</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\mathcal{S}_{1},\ldots,\mathcal{S}_{q^{2}+q+1}\}</annotation></semantics></math> be a packing. The <em id="S4.Thmthm10.p1.1.1" class="ltx_emph ltx_font_italic">affine packing family</em> is defined by</p>
<table id="S4.Ex145" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex145.m1" class="ltx_Math" alttext="\textrm{M}^{\mathrm{pk}}_{q}\coloneqq\textrm{M}(\mathcal{S}_{1},\dots,\mathcal{S}_{q^{2}+q+1})." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mtext>M</mtext><mi>q</mi><mi>pk</mi></msubsup><mo>≔</mo><mrow><mtext>M</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mi>q</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\textrm{M}^{\mathrm{pk}}_{q}\coloneqq\textrm{M}(\mathcal{S}_{1},\dots,\mathcal{S}_{q^{2}+q+1}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm10.p1.2" class="ltx_p">The matroid <math id="S4.Thmthm10.p1.m3" class="ltx_Math" alttext="\textrm{M}^{\mathrm{pk}}_{q}" display="inline" intent=":literal"><semantics><msubsup><mtext>M</mtext><mi>q</mi><mi>pk</mi></msubsup><annotation encoding="application/x-tex">\textrm{M}^{\mathrm{pk}}_{q}</annotation></semantics></math> is a simple matroid of rank <math id="S4.Thmthm10.p1.m4" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math> on <math id="S4.Thmthm10.p1.m5" class="ltx_Math" alttext="q^{4}+q^{2}+q+1" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mn>4</mn></msup><mo>+</mo><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mi>q</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">q^{4}+q^{2}+q+1</annotation></semantics></math> elements.</p>
</div>
</div>
<section id="S4.SS1.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">4.1.1. </span>The flag <math id="S4.SS1.SSS1.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>-vector of an affine family</h4>

<div id="S4.SS1.SSS1.p1" class="ltx_para">
<p id="S4.SS1.SSS1.p1.1" class="ltx_p">We compute the chain and <math id="S4.SS1.SSS1.p1.m1" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math>-polynomials by first counting flats
and then incidences between them. Fix pairwise disjoint spreads
<math id="S4.SS1.SSS1.p1.m2" class="ltx_Math" alttext="\mathcal{S}_{1},\dots,\mathcal{S}_{m}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">\mathcal{S}_{1},\dots,\mathcal{S}_{m}</annotation></semantics></math> of <math id="S4.SS1.SSS1.p1.m3" class="ltx_Math" alttext="\textrm{PG}(3,q)" display="inline" intent=":literal"><semantics><mrow><mtext>PG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textrm{PG}(3,q)</annotation></semantics></math>, and write <math id="S4.SS1.SSS1.p1.m4" class="ltx_Math" alttext="\textrm{M}=\textrm{M}(\mathcal{S}_{1},\dots,\mathcal{S}_{m})" display="inline" intent=":literal"><semantics><mrow><mtext>M</mtext><mo>=</mo><mrow><mtext>M</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\textrm{M}=\textrm{M}(\mathcal{S}_{1},\dots,\mathcal{S}_{m})</annotation></semantics></math>. Let <math id="S4.SS1.SSS1.p1.m5" class="ltx_Math" alttext="N_{1},N_{2},N_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mn>1</mn></msub><mo>,</mo><msub><mi>N</mi><mn>2</mn></msub><mo>,</mo><msub><mi>N</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">N_{1},N_{2},N_{3}</annotation></semantics></math> denote the numbers of points, affine lines,
and affine planes in <math id="S4.SS1.SSS1.p1.m6" class="ltx_Math" alttext="V=\mathbb{F}_{q}^{4}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>=</mo><msubsup><mi>𝔽</mi><mi>q</mi><mn>4</mn></msubsup></mrow><annotation encoding="application/x-tex">V=\mathbb{F}_{q}^{4}</annotation></semantics></math>, respectively. Then</p>
<table id="S4.Ex146" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S4.Ex146X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex146X.m2" class="ltx_Math" alttext="\displaystyle N_{1}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\displaystyle N_{1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex146X.m3" class="ltx_Math" alttext="\displaystyle=q^{4}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><msup><mi>q</mi><mn>4</mn></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=q^{4},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex146Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex146Xa.m2" class="ltx_Math" alttext="\displaystyle N_{2}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle N_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex146Xa.m3" class="ltx_Math" alttext="\displaystyle=q^{3}(q^{3}+q^{2}+q+1)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>q</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>q</mi><mn>3</mn></msup><mo>+</mo><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mi>q</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=q^{3}(q^{3}+q^{2}+q+1),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex146Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex146Xb.m2" class="ltx_Math" alttext="\displaystyle N_{3}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mn>3</mn></msub><annotation encoding="application/x-tex">\displaystyle N_{3}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex146Xb.m3" class="ltx_Math" alttext="\displaystyle=q^{2}(q^{2}+1)(q^{2}+q+1)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>q</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mi>q</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=q^{2}(q^{2}+1)(q^{2}+q+1).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.SSS1.p1.2" class="ltx_p">Indeed, there are <math id="S4.SS1.SSS1.p1.m7" class="ltx_Math" alttext="q^{3}+q^{2}+q+1" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mn>3</mn></msup><mo>+</mo><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mi>q</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">q^{3}+q^{2}+q+1</annotation></semantics></math> line directions and
<math id="S4.SS1.SSS1.p1.m8" class="ltx_Math" alttext="(q^{2}+1)(q^{2}+q+1)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mi>q</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(q^{2}+1)(q^{2}+q+1)</annotation></semantics></math> plane directions, with <math id="S4.SS1.SSS1.p1.m9" class="ltx_Math" alttext="q^{3}" display="inline" intent=":literal"><semantics><msup><mi>q</mi><mn>3</mn></msup><annotation encoding="application/x-tex">q^{3}</annotation></semantics></math> and <math id="S4.SS1.SSS1.p1.m10" class="ltx_Math" alttext="q^{2}" display="inline" intent=":literal"><semantics><msup><mi>q</mi><mn>2</mn></msup><annotation encoding="application/x-tex">q^{2}</annotation></semantics></math>
affine translates per direction, respectively.
Each spread contains <math id="S4.SS1.SSS1.p1.m11" class="ltx_Math" alttext="q^{2}+1" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">q^{2}+1</annotation></semantics></math> plane directions, so</p>
<table id="S4.Ex147" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex147.m1" class="ltx_Math" alttext="|\mathcal{A}(\mathcal{S}_{i})|=q^{2}(q^{2}+1)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><msup><mi>q</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|\mathcal{A}(\mathcal{S}_{i})|=q^{2}(q^{2}+1).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.SSS1.p1.3" class="ltx_p">Since the spreads are pairwise disjoint, their selected affine
planes are distinct.</p>
</div>
<div id="S4.SS1.SSS1.p2" class="ltx_para">
<p id="S4.SS1.SSS1.p2.1" class="ltx_p">Let <math id="S4.SS1.SSS1.p2.m1" class="ltx_Math" alttext="W_{i}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mi>i</mi></msub><annotation encoding="application/x-tex">W_{i}</annotation></semantics></math> denote the number of flats of rank <math id="S4.SS1.SSS1.p2.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, or <em id="S4.SS1.SSS1.p2.1.1" class="ltx_emph ltx_font_italic">the <math id="S4.SS1.SSS1.p2.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>th Whitney number</em> of <span id="S4.SS1.SSS1.p2.1.2" class="ltx_text ltx_markedasmath">M</span>.
The description of flats of <span id="S4.SS1.SSS1.p2.1.3" class="ltx_text ltx_markedasmath">M</span> in <a href="#S4.Thmthm9" title="Proposition 4.9 ‣ 4.1. The affine family ‣ 4. Four families from finite geometries ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">4.9</span></a> implies the following formula for <math id="S4.SS1.SSS1.p2.m6" class="ltx_Math" alttext="W_{i}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mi>i</mi></msub><annotation encoding="application/x-tex">W_{i}</annotation></semantics></math>:</p>
<table id="S4.Ex148" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S4.Ex148X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex148X.m2" class="ltx_Math" alttext="\displaystyle W_{1}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\displaystyle W_{1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex148X.m3" class="ltx_Math" alttext="\displaystyle=N_{1}+m," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>N</mi><mn>1</mn></msub><mo>+</mo><mi>m</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=N_{1}+m,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex148Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex148Xa.m2" class="ltx_Math" alttext="\displaystyle W_{2}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle W_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex148Xa.m3" class="ltx_Math" alttext="\displaystyle=N_{2}+N_{1}m+\binom{m}{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>N</mi><mn>2</mn></msub><mo>+</mo><mrow><msub><mi>N</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mi>m</mi><mn>2</mn></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=N_{2}+N_{1}m+\binom{m}{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex148Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex148Xb.m2" class="ltx_Math" alttext="\displaystyle W_{3}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mn>3</mn></msub><annotation encoding="application/x-tex">\displaystyle W_{3}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex148Xb.m3" class="ltx_Math" alttext="\displaystyle=N_{3}+N_{1}\binom{m}{2}+\binom{m}{3}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>N</mi><mn>3</mn></msub><mo>+</mo><mrow><msub><mi>N</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mi>m</mi><mn>2</mn></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mi>m</mi><mn>3</mn></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=N_{3}+N_{1}\binom{m}{2}+\binom{m}{3}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.Thmthm11" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm11.2" class="ltx_text ltx_font_bold">Corollary 4.11</span></span></h6>
<div id="S4.Thmthm11.p1" class="ltx_para">
<p id="S4.Thmthm11.p1.1" class="ltx_p"><span id="S4.Thmthm11.p1.1.1" class="ltx_text ltx_font_italic">The flag <math id="S4.Thmthm11.p1.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>-vector of <span id="S4.Thmthm11.p1.1.1.1" class="ltx_text ltx_markedasmath ltx_font_upright">M</span> is</span></p>
<table id="S4.Ex149" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S4.Ex149X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex149X.m2" class="ltx_Math" alttext="\displaystyle\alpha(i)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\alpha(i)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex149X.m3" class="ltx_Math" alttext="\displaystyle=W_{i}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><msub><mi>W</mi><mi>i</mi></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=W_{i},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex149Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex149Xa.m2" class="ltx_Math" alttext="\displaystyle\alpha(12)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>12</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\alpha(12)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex149Xa.m3" class="ltx_Math" alttext="\displaystyle=qN_{2}+2N_{1}m+2\binom{m}{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mn>2</mn></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mi>m</mi><mn>2</mn></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=qN_{2}+2N_{1}m+2\binom{m}{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex149Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex149Xb.m2" class="ltx_Math" alttext="\displaystyle\alpha(13)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>13</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\alpha(13)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex149Xb.m3" class="ltx_Math" alttext="\displaystyle=q^{2}N_{3}+mq^{2}(q^{2}+1)+3N_{1}\binom{m}{2}+3\binom{m}{3}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msup><mi>q</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mn>3</mn></msub></mrow><mo>+</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mi>m</mi><mn>2</mn></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mi>m</mi><mn>3</mn></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=q^{2}N_{3}+mq^{2}(q^{2}+1)+3N_{1}\binom{m}{2}+3\binom{m}{3},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex149Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex149Xc.m2" class="ltx_Math" alttext="\displaystyle\alpha(23)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>23</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\alpha(23)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex149Xc.m3" class="ltx_Math" alttext="\displaystyle=(q^{2}+q)N_{3}+mq^{4}(q^{2}+1)+3N_{1}\binom{m}{2}+3\binom{m}{3}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mi>q</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mn>3</mn></msub></mrow><mo>+</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mi>m</mi><mn>2</mn></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mi>m</mi><mn>3</mn></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=(q^{2}+q)N_{3}+mq^{4}(q^{2}+1)+3N_{1}\binom{m}{2}+3\binom{m}{3},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex149Xd"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex149Xd.m2" class="ltx_Math" alttext="\displaystyle\alpha(123)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>123</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\alpha(123)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex149Xd.m3" class="ltx_Math" alttext="\displaystyle=q(q^{2}+q)N_{3}+2mq^{4}(q^{2}+1)+6N_{1}\binom{m}{2}+6\binom{m}{3}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mi>q</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mn>3</mn></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mi>m</mi><mn>2</mn></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mi>m</mi><mn>3</mn></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=q(q^{2}+q)N_{3}+2mq^{4}(q^{2}+1)+6N_{1}\binom{m}{2}+6\binom{m}{3}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm11.p1.2" class="ltx_p"><span id="S4.Thmthm11.p1.2.1" class="ltx_text ltx_font_italic">In particular, the flag <math id="S4.Thmthm11.p1.m3" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>-vector of <span id="S4.Thmthm11.p1.2.1.1" class="ltx_text ltx_markedasmath ltx_font_upright">M</span> depends only on <math id="S4.Thmthm11.p1.m5" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> and <math id="S4.Thmthm11.p1.m6" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math>;
the choices <math id="S4.Thmthm11.p1.m7" class="ltx_Math" alttext="m=(q^{2}+1)/2" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">m=(q^{2}+1)/2</annotation></semantics></math> and <math id="S4.Thmthm11.p1.m8" class="ltx_Math" alttext="m=q^{2}+q+1" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>=</mo><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mi>q</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">m=q^{2}+q+1</annotation></semantics></math> give the flag
<math id="S4.Thmthm11.p1.m9" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>-vectors of <math id="S4.Thmthm11.p1.m10" class="ltx_Math" alttext="\textrm{M}_{q}" display="inline" intent=":literal"><semantics><msub><mtext>M</mtext><mi>q</mi></msub><annotation encoding="application/x-tex">\textrm{M}_{q}</annotation></semantics></math> for odd prime powers <math id="S4.Thmthm11.p1.m11" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> and <math id="S4.Thmthm11.p1.m12" class="ltx_Math" alttext="\textrm{M}^{\mathrm{pk}}_{q}" display="inline" intent=":literal"><semantics><msubsup><mtext>M</mtext><mi>q</mi><mi>pk</mi></msubsup><annotation encoding="application/x-tex">\textrm{M}^{\mathrm{pk}}_{q}</annotation></semantics></math>
for all prime powers <math id="S4.Thmthm11.p1.m13" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>, respectively.</span></p>
</div>
</div>
<div id="S4.SS1.SSS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS1.SSS1.p3" class="ltx_para">
<p id="S4.SS1.SSS1.p3.1" class="ltx_p"><span id="S4.SS1.SSS1.p3.1.1" class="ltx_text">It is immediate that <math id="S4.SS1.SSS1.p3.m1" class="ltx_Math" alttext="\alpha(\varnothing)=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">∅</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\alpha(\varnothing)=1</annotation></semantics></math>, and <math id="S4.SS1.SSS1.p3.m2" class="ltx_Math" alttext="\alpha(i)=W_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>W</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\alpha(i)=W_{i}</annotation></semantics></math>.
There are <math id="S4.SS1.SSS1.p3.m3" class="ltx_Math" alttext="N_{2}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mn>2</mn></msub><annotation encoding="application/x-tex">N_{2}</annotation></semantics></math> affine lines, each containing <math id="S4.SS1.SSS1.p3.m4" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> points,
and <math id="S4.SS1.SSS1.p3.m5" class="ltx_Math" alttext="N_{1}m+\binom{m}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>N</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>m</mi><mn>2</mn></mfrac><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">N_{1}m+\binom{m}{2}</annotation></semantics></math> two-point lines containing an auxiliary
point. Counting points on these lines gives</span></p>
<table id="S4.Ex150" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex150.m1" class="ltx_Math" alttext="\alpha(12)=qN_{2}+2\left(N_{1}m+\binom{m}{2}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>12</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mn>2</mn></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>N</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>m</mi><mn>2</mn></mfrac><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\alpha(12)=qN_{2}+2\left(N_{1}m+\binom{m}{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.SS1.SSS1.p4" class="ltx_para">
<p id="S4.SS1.SSS1.p4.1" class="ltx_p"><span id="S4.SS1.SSS1.p4.1.1" class="ltx_text">For the other entries, we group chains by their largest flat:</span></p>
<ol id="S4.I4" class="ltx_enumerate">
<li id="S4.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I4.i1.p1" class="ltx_para">
<p id="S4.I4.i1.p1.1" class="ltx_p">There are <math id="S4.I4.i1.p1.m1" class="ltx_Math" alttext="N_{3}-mq^{2}(q^{2}+1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mn>3</mn></msub><mo>−</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">N_{3}-mq^{2}(q^{2}+1)</annotation></semantics></math> unchanged affine planes, each containing <math id="S4.I4.i1.p1.m2" class="ltx_Math" alttext="q^{2}" display="inline" intent=":literal"><semantics><msup><mi>q</mi><mn>2</mn></msup><annotation encoding="application/x-tex">q^{2}</annotation></semantics></math> points and <math id="S4.I4.i1.p1.m3" class="ltx_Math" alttext="q^{2}+q" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">q^{2}+q</annotation></semantics></math> lines, and contributing <math id="S4.I4.i1.p1.m4" class="ltx_Math" alttext="q^{2}" display="inline" intent=":literal"><semantics><msup><mi>q</mi><mn>2</mn></msup><annotation encoding="application/x-tex">q^{2}</annotation></semantics></math>, <math id="S4.I4.i1.p1.m5" class="ltx_Math" alttext="q^{2}+q" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">q^{2}+q</annotation></semantics></math>, and <math id="S4.I4.i1.p1.m6" class="ltx_Math" alttext="q(q^{2}+q)" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mi>q</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q(q^{2}+q)</annotation></semantics></math> to
<math id="S4.I4.i1.p1.m7" class="ltx_Math" alttext="\alpha(13)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>13</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha(13)</annotation></semantics></math>, <math id="S4.I4.i1.p1.m8" class="ltx_Math" alttext="\alpha(23)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>23</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha(23)</annotation></semantics></math>, and <math id="S4.I4.i1.p1.m9" class="ltx_Math" alttext="\alpha(123)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>123</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha(123)</annotation></semantics></math>, respectively.</p>
</div></li>
<li id="S4.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I4.i2.p1" class="ltx_para">
<p id="S4.I4.i2.p1.1" class="ltx_p">There are <math id="S4.I4.i2.p1.m1" class="ltx_Math" alttext="mq^{2}(q^{2}+1)" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">mq^{2}(q^{2}+1)</annotation></semantics></math> enlarged planes <math id="S4.I4.i2.p1.m2" class="ltx_Math" alttext="P\cup\{p_{i}\}" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">P\cup\{p_{i}\}</annotation></semantics></math>, each containing <math id="S4.I4.i2.p1.m3" class="ltx_Math" alttext="q^{2}+1" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">q^{2}+1</annotation></semantics></math> points and <math id="S4.I4.i2.p1.m4" class="ltx_Math" alttext="2q^{2}+q" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mn>2</mn></msup></mrow><mo>+</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">2q^{2}+q</annotation></semantics></math> lines: the <math id="S4.I4.i2.p1.m5" class="ltx_Math" alttext="q^{2}+q" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">q^{2}+q</annotation></semantics></math> affine lines of <math id="S4.I4.i2.p1.m6" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>, each of size <math id="S4.I4.i2.p1.m7" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>, and the <math id="S4.I4.i2.p1.m8" class="ltx_Math" alttext="q^{2}" display="inline" intent=":literal"><semantics><msup><mi>q</mi><mn>2</mn></msup><annotation encoding="application/x-tex">q^{2}</annotation></semantics></math> two-point lines <math id="S4.I4.i2.p1.m9" class="ltx_Math" alttext="\{x,p_{i}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mi>x</mi><mo>,</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{x,p_{i}\}</annotation></semantics></math> with <math id="S4.I4.i2.p1.m10" class="ltx_Math" alttext="x\in P" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi>P</mi></mrow><annotation encoding="application/x-tex">x\in P</annotation></semantics></math>, and contributing <math id="S4.I4.i2.p1.m11" class="ltx_Math" alttext="q^{2}+1" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">q^{2}+1</annotation></semantics></math>, <math id="S4.I4.i2.p1.m12" class="ltx_Math" alttext="2q^{2}+q" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mn>2</mn></msup></mrow><mo>+</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">2q^{2}+q</annotation></semantics></math>, and
<math id="S4.I4.i2.p1.m13" class="ltx_Math" alttext="q(q^{2}+q)+2q^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mi>q</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">q(q^{2}+q)+2q^{2}</annotation></semantics></math> to <math id="S4.I4.i2.p1.m14" class="ltx_Math" alttext="\alpha(13)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>13</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha(13)</annotation></semantics></math>, <math id="S4.I4.i2.p1.m15" class="ltx_Math" alttext="\alpha(23)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>23</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha(23)</annotation></semantics></math>, and
<math id="S4.I4.i2.p1.m16" class="ltx_Math" alttext="\alpha(123)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>123</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha(123)</annotation></semantics></math>, respectively.</p>
</div></li>
<li id="S4.I4.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S4.I4.i3.p1" class="ltx_para">
<p id="S4.I4.i3.p1.1" class="ltx_p">There are <math id="S4.I4.i3.p1.m1" class="ltx_Math" alttext="N_{1}\binom{m}{2}+\binom{m}{3}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>N</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>m</mi><mn>2</mn></mfrac><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>m</mi><mn>3</mn></mfrac><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">N_{1}\binom{m}{2}+\binom{m}{3}</annotation></semantics></math> three-element hyperplanes, each containing three points and three lines, all of size <math id="S4.I4.i3.p1.m2" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>, and contributing <math id="S4.I4.i3.p1.m3" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>, <math id="S4.I4.i3.p1.m4" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>, and <math id="S4.I4.i3.p1.m5" class="ltx_Math" alttext="6" display="inline" intent=":literal"><semantics><mn>6</mn><annotation encoding="application/x-tex">6</annotation></semantics></math> to <math id="S4.I4.i3.p1.m6" class="ltx_Math" alttext="\alpha(13)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>13</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha(13)</annotation></semantics></math>, <math id="S4.I4.i3.p1.m7" class="ltx_Math" alttext="\alpha(23)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>23</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha(23)</annotation></semantics></math>, and <math id="S4.I4.i3.p1.m8" class="ltx_Math" alttext="\alpha(123)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>123</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha(123)</annotation></semantics></math>, respectively.</p>
</div></li>
</ol>
<p id="S4.SS1.SSS1.p4.2" class="ltx_p"><span id="S4.SS1.SSS1.p4.2.1" class="ltx_text">Summing these contributions over all hyperplanes gives
the stated formulas.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="S4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.2. </span>The Gabidulin family</h3>

<div id="S4.SS2.p1" class="ltx_para">
<p id="S4.SS2.p1.1" class="ltx_p">We first describe absorption in a truncated projective geometry.
A Gabidulin code will then provide the families of subspaces
needed for this construction.</p>
</div>
<div id="S4.SS2.p2" class="ltx_para">
<p id="S4.SS2.p2.1" class="ltx_p">Fix a prime power <math id="S4.SS2.p2.m1" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> and integers <math id="S4.SS2.p2.m2" class="ltx_Math" alttext="n\geqslant k\geqslant 3" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>⩾</mo><mi>k</mi><mo>⩾</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">n\geqslant k\geqslant 3</annotation></semantics></math>,
and let <math id="S4.SS2.p2.m3" class="ltx_Math" alttext="V=\mathbb{F}_{q}^{n}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>=</mo><msubsup><mi>𝔽</mi><mi>q</mi><mi>n</mi></msubsup></mrow><annotation encoding="application/x-tex">V=\mathbb{F}_{q}^{n}</annotation></semantics></math>.
For a linear subspace <math id="S4.SS2.p2.m4" class="ltx_Math" alttext="X\subseteq V" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>⊆</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">X\subseteq V</annotation></semantics></math>, write <math id="S4.SS2.p2.m5" class="ltx_Math" alttext="\mathbb{P}(X)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(X)</annotation></semantics></math>
for its set of one-dimensional subspaces, with
<math id="S4.SS2.p2.m6" class="ltx_Math" alttext="\mathbb{P}(0)=\varnothing" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\mathbb{P}(0)=\varnothing</annotation></semantics></math>.
The matroid</p>
<table id="S4.Ex151" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex151.m1" class="ltx_Math" alttext="\textrm{M}_{0}=\mathrm{Tr}^{n-k}\bigl(\textrm{PG}(n-1,q)\bigr)" display="block" intent=":literal"><semantics><mrow><msub><mtext>M</mtext><mn>0</mn></msub><mo>=</mo><mrow><msup><mi>Tr</mi><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mtext>PG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\textrm{M}_{0}=\mathrm{Tr}^{n-k}\bigl(\textrm{PG}(n-1,q)\bigr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p2.2" class="ltx_p">has rank <math id="S4.SS2.p2.m7" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> and ground set <math id="S4.SS2.p2.m8" class="ltx_Math" alttext="\mathbb{P}(V)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(V)</annotation></semantics></math>.
Here <math id="S4.SS2.p2.m9" class="ltx_Math" alttext="\mathrm{Tr}^{0}" display="inline" intent=":literal"><semantics><msup><mi>Tr</mi><mn>0</mn></msup><annotation encoding="application/x-tex">\mathrm{Tr}^{0}</annotation></semantics></math> is the identity.
Its proper flats are the sets <math id="S4.SS2.p2.m10" class="ltx_Math" alttext="\mathbb{P}(X)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(X)</annotation></semantics></math> with
<math id="S4.SS2.p2.m11" class="ltx_Math" alttext="\dim X\leqslant k-1" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">dim</mo><mi>X</mi></mrow><mo>⩽</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\dim X\leqslant k-1</annotation></semantics></math>, of matroid rank <math id="S4.SS2.p2.m12" class="ltx_Math" alttext="\dim X" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">dim</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">\dim X</annotation></semantics></math>.</p>
</div>
<div id="S4.SS2.p3" class="ltx_para">
<p id="S4.SS2.p3.1" class="ltx_p">Let <math id="S4.SS2.p3.m1" class="ltx_Math" alttext="\mathcal{S}_{1},\dots,\mathcal{S}_{m}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">\mathcal{S}_{1},\dots,\mathcal{S}_{m}</annotation></semantics></math> be pairwise disjoint families
of <math id="S4.SS2.p3.m2" class="ltx_Math" alttext="(k-1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(k-1)</annotation></semantics></math>-dimensional linear subspaces of <math id="S4.SS2.p3.m3" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math>, satisfying</p>
<table id="S4.E27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(27)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E27.m1" class="ltx_Math" alttext="\dim(X\cap X^{\prime})\leqslant k-3\qquad\text{for distinct }X,X^{\prime}\in\mathcal{S}_{i}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo rspace="0em">dim</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>∩</mo><msup><mi>X</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⩽</mo><mrow><mi>k</mi><mo>−</mo><mn>3</mn></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mtext>for distinct </mtext><mo lspace="0em" rspace="0em">​</mo><mi>X</mi></mrow><mo>,</mo><mrow><msup><mi>X</mi><mo>′</mo></msup><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>i</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\dim(X\cap X^{\prime})\leqslant k-3\qquad\text{for distinct }X,X^{\prime}\in\mathcal{S}_{i}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p3.2" class="ltx_p">The corresponding hyperplanes <math id="S4.SS2.p3.m4" class="ltx_Math" alttext="\mathbb{P}(X)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(X)</annotation></semantics></math> are called
<em id="S4.SS2.p3.2.1" class="ltx_emph ltx_font_italic">geometric blocks</em>. We next adjoin one point for each family and absorb it
into every geometric block of that family.</p>
</div>
<div id="S4.Thmthm12" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm12.2" class="ltx_text ltx_font_bold">Definition 4.12</span></span></h6>
<div id="S4.Thmthm12.p1" class="ltx_para">
<p id="S4.Thmthm12.p1.1" class="ltx_p">Let <math id="S4.Thmthm12.p1.m1" class="ltx_Math" alttext="X_{0}=\{p_{1},\dots,p_{m}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mn>0</mn></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>p</mi><mi>m</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">X_{0}=\{p_{1},\dots,p_{m}\}</annotation></semantics></math> be a set of distinct auxiliary
points disjoint from <math id="S4.Thmthm12.p1.m2" class="ltx_Math" alttext="\mathbb{P}(V)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(V)</annotation></semantics></math>.
Starting from <math id="S4.Thmthm12.p1.m3" class="ltx_Math" alttext="\textrm{M}_{0}" display="inline" intent=":literal"><semantics><msub><mtext>M</mtext><mn>0</mn></msub><annotation encoding="application/x-tex">\textrm{M}_{0}</annotation></semantics></math>, define <math id="S4.Thmthm12.p1.m4" class="ltx_Math" alttext="\textrm{M}_{i}" display="inline" intent=":literal"><semantics><msub><mtext>M</mtext><mi>i</mi></msub><annotation encoding="application/x-tex">\textrm{M}_{i}</annotation></semantics></math> for <math id="S4.Thmthm12.p1.m5" class="ltx_Math" alttext="1\leqslant i\leqslant m" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>⩽</mo><mi>i</mi><mo>⩽</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">1\leqslant i\leqslant m</annotation></semantics></math>
as follows.
First adjoin <math id="S4.Thmthm12.p1.m6" class="ltx_Math" alttext="p_{i}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>i</mi></msub><annotation encoding="application/x-tex">p_{i}</annotation></semantics></math> as a coloop and truncate once:</p>
<table id="S4.Ex152" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex152.m1" class="ltx_Math" alttext="\widetilde{\textrm{M}}_{i}=\mathrm{Tr}^{1}\bigl(\textrm{M}_{i-1}\oplus\textrm{U}_{\{p_{i}\},\{p_{i}\}}\bigr)." display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mtext>M</mtext><mo>~</mo></mover><mi>i</mi></msub><mo>=</mo><mrow><msup><mi>Tr</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mtext>M</mtext><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>⊕</mo><msub><mtext>U</mtext><mrow><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mo>,</mo><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widetilde{\textrm{M}}_{i}=\mathrm{Tr}^{1}\bigl(\textrm{M}_{i-1}\oplus\textrm{U}_{\{p_{i}\},\{p_{i}\}}\bigr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm12.p1.2" class="ltx_p">Then obtain <math id="S4.Thmthm12.p1.m7" class="ltx_Math" alttext="\textrm{M}_{i}" display="inline" intent=":literal"><semantics><msub><mtext>M</mtext><mi>i</mi></msub><annotation encoding="application/x-tex">\textrm{M}_{i}</annotation></semantics></math> from <math id="S4.Thmthm12.p1.m8" class="ltx_Math" alttext="\widetilde{\textrm{M}}_{i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mtext>M</mtext><mo>~</mo></mover><mi>i</mi></msub><annotation encoding="application/x-tex">\widetilde{\textrm{M}}_{i}</annotation></semantics></math> by coalescing
the blocks</p>
<table id="S4.Ex153" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex153.m1" class="ltx_Math" alttext="\mathcal{H}_{i}=\{\mathbb{P}(X)\cup\{p_{i}\}:X\in\mathcal{S}_{i}\}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>i</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∪</mo><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mi>i</mi></msub><mo rspace="0.278em" stretchy="false">}</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mi>X</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>i</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{H}_{i}=\{\mathbb{P}(X)\cup\{p_{i}\}:X\in\mathcal{S}_{i}\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm12.p1.3" class="ltx_p">The resulting matroid is <math id="S4.Thmthm12.p1.m9" class="ltx_Math" alttext="\textrm{M}_{m}" display="inline" intent=":literal"><semantics><msub><mtext>M</mtext><mi>m</mi></msub><annotation encoding="application/x-tex">\textrm{M}_{m}</annotation></semantics></math>.</p>
</div>
</div>
<div id="S4.Thmthm13" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm13.2" class="ltx_text ltx_font_bold">Proposition 4.13</span></span></h6>
<div id="S4.Thmthm13.p1" class="ltx_para">
<p id="S4.Thmthm13.p1.1" class="ltx_p"><span id="S4.Thmthm13.p1.1.1" class="ltx_text ltx_font_italic">The construction in <a href="#S4.Thmthm12" title="Definition 4.12 ‣ 4.2. The Gabidulin family ‣ 4. Four families from finite geometries ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Definition</span> <span class="ltx_text ltx_ref_tag">4.12</span></a>
is well-defined.
The proper flats of <math id="S4.Thmthm13.p1.m1" class="ltx_Math" alttext="\textrm{M}_{m}" display="inline" intent=":literal"><semantics><msub><mtext>M</mtext><mi>m</mi></msub><annotation encoding="application/x-tex">\textrm{M}_{m}</annotation></semantics></math> are the following, where
<math id="S4.Thmthm13.p1.m2" class="ltx_Math" alttext="X\subseteq V" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>⊆</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">X\subseteq V</annotation></semantics></math> is a linear subspace and <math id="S4.Thmthm13.p1.m3" class="ltx_Math" alttext="T\subseteq X_{0}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>⊆</mo><msub><mi>X</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">T\subseteq X_{0}</annotation></semantics></math>:</span></p>
<ul id="S4.I5" class="ltx_itemize">
<li id="S4.I5.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(L)</span> 
<div id="S4.I5.ix1.p1" class="ltx_para">
<p id="S4.I5.ix1.p1.1" class="ltx_p"><span id="S4.I5.ix1.p1.1.1" class="ltx_text ltx_font_italic">The flats </span><math id="S4.I5.ix1.p1.m1" class="ltx_Math" alttext="\mathbb{P}(X)\cup T" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∪</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">\mathbb{P}(X)\cup T</annotation></semantics></math><span id="S4.I5.ix1.p1.1.2" class="ltx_text ltx_font_italic"> with
</span><math id="S4.I5.ix1.p1.m2" class="ltx_Math" alttext="\dim X+|T|\leqslant k-2" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0.167em">dim</mo><mi>X</mi></mrow><mo>+</mo><mrow><mo stretchy="false">|</mo><mi>T</mi><mo stretchy="false">|</mo></mrow></mrow><mo>⩽</mo><mrow><mi>k</mi><mo>−</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">\dim X+|T|\leqslant k-2</annotation></semantics></math><span id="S4.I5.ix1.p1.1.3" class="ltx_text ltx_font_italic">, of rank </span><math id="S4.I5.ix1.p1.m3" class="ltx_Math" alttext="\dim X+|T|" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">dim</mo><mi>X</mi></mrow><mo>+</mo><mrow><mo stretchy="false">|</mo><mi>T</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">\dim X+|T|</annotation></semantics></math><span id="S4.I5.ix1.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I5.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(N)</span> 
<div id="S4.I5.ix2.p1" class="ltx_para">
<p id="S4.I5.ix2.p1.1" class="ltx_p"><span id="S4.I5.ix2.p1.1.1" class="ltx_text ltx_font_italic">The unselected geometric hyperplanes
</span><math id="S4.I5.ix2.p1.m1" class="ltx_Math" alttext="\mathbb{P}(X)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(X)</annotation></semantics></math><span id="S4.I5.ix2.p1.1.2" class="ltx_text ltx_font_italic"> with </span><math id="S4.I5.ix2.p1.m2" class="ltx_Math" alttext="\dim X=k-1" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">dim</mo><mi>X</mi></mrow><mo>=</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\dim X=k-1</annotation></semantics></math><span id="S4.I5.ix2.p1.1.3" class="ltx_text ltx_font_italic"> and
</span><math id="S4.I5.ix2.p1.m3" class="ltx_Math" alttext="X\notin\mathcal{S}_{1}\cup\cdots\cup\mathcal{S}_{m}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>∉</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mn>1</mn></msub><mo>∪</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>∪</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>m</mi></msub></mrow></mrow><annotation encoding="application/x-tex">X\notin\mathcal{S}_{1}\cup\cdots\cup\mathcal{S}_{m}</annotation></semantics></math><span id="S4.I5.ix2.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I5.ix3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(B)</span> 
<div id="S4.I5.ix3.p1" class="ltx_para">
<p id="S4.I5.ix3.p1.1" class="ltx_p"><span id="S4.I5.ix3.p1.1.1" class="ltx_text ltx_font_italic">The coalesced hyperplanes
</span><math id="S4.I5.ix3.p1.m1" class="ltx_Math" alttext="\mathbb{P}(X)\cup\{p_{i}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∪</mo><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(X)\cup\{p_{i}\}</annotation></semantics></math><span id="S4.I5.ix3.p1.1.2" class="ltx_text ltx_font_italic"> with </span><math id="S4.I5.ix3.p1.m2" class="ltx_Math" alttext="X\in\mathcal{S}_{i}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">X\in\mathcal{S}_{i}</annotation></semantics></math><span id="S4.I5.ix3.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I5.ix4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(U)</span> 
<div id="S4.I5.ix4.p1" class="ltx_para">
<p id="S4.I5.ix4.p1.1" class="ltx_p"><span id="S4.I5.ix4.p1.1.1" class="ltx_text ltx_font_italic">The unabsorbed hyperplanes
</span><math id="S4.I5.ix4.p1.m1" class="ltx_Math" alttext="\mathbb{P}(X)\cup\{p_{i}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∪</mo><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(X)\cup\{p_{i}\}</annotation></semantics></math><span id="S4.I5.ix4.p1.1.2" class="ltx_text ltx_font_italic"> with </span><math id="S4.I5.ix4.p1.m2" class="ltx_Math" alttext="\dim X=k-2" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">dim</mo><mi>X</mi></mrow><mo>=</mo><mrow><mi>k</mi><mo>−</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">\dim X=k-2</annotation></semantics></math><span id="S4.I5.ix4.p1.1.3" class="ltx_text ltx_font_italic"> and
</span><math id="S4.I5.ix4.p1.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math><span id="S4.I5.ix4.p1.1.4" class="ltx_text ltx_font_italic"> contained in no member of </span><math id="S4.I5.ix4.p1.m4" class="ltx_Math" alttext="\mathcal{S}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{S}_{i}</annotation></semantics></math><span id="S4.I5.ix4.p1.1.5" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I5.ix5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(H)</span> 
<div id="S4.I5.ix5.p1" class="ltx_para">
<p id="S4.I5.ix5.p1.1" class="ltx_p"><span id="S4.I5.ix5.p1.1.1" class="ltx_text ltx_font_italic">The hyperplanes </span><math id="S4.I5.ix5.p1.m1" class="ltx_Math" alttext="\mathbb{P}(X)\cup T" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∪</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">\mathbb{P}(X)\cup T</annotation></semantics></math><span id="S4.I5.ix5.p1.1.2" class="ltx_text ltx_font_italic"> with
</span><math id="S4.I5.ix5.p1.m2" class="ltx_Math" alttext="|T|\geqslant 2" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>T</mi><mo stretchy="false">|</mo></mrow><mo>⩾</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">|T|\geqslant 2</annotation></semantics></math><span id="S4.I5.ix5.p1.1.3" class="ltx_text ltx_font_italic"> and </span><math id="S4.I5.ix5.p1.m3" class="ltx_Math" alttext="\dim X+|T|=k-1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0.167em">dim</mo><mi>X</mi></mrow><mo>+</mo><mrow><mo stretchy="false">|</mo><mi>T</mi><mo stretchy="false">|</mo></mrow></mrow><mo>=</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\dim X+|T|=k-1</annotation></semantics></math><span id="S4.I5.ix5.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ul>
</div>
</div>
<div id="S4.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS2.p4" class="ltx_para">
<p id="S4.SS2.p4.1" class="ltx_p"><span id="S4.SS2.p4.1.1" class="ltx_text">We induct on the number of absorption steps.
The assertion holds for <math id="S4.SS2.p4.m1" class="ltx_Math" alttext="\textrm{M}_{0}" display="inline" intent=":literal"><semantics><msub><mtext>M</mtext><mn>0</mn></msub><annotation encoding="application/x-tex">\textrm{M}_{0}</annotation></semantics></math>.
Suppose it holds for <math id="S4.SS2.p4.m2" class="ltx_Math" alttext="\textrm{M}_{i-1}" display="inline" intent=":literal"><semantics><msub><mtext>M</mtext><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\textrm{M}_{i-1}</annotation></semantics></math>.
Since the families are pairwise disjoint, every
<math id="S4.SS2.p4.m3" class="ltx_Math" alttext="\mathbb{P}(X)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(X)</annotation></semantics></math> with <math id="S4.SS2.p4.m4" class="ltx_Math" alttext="X\in\mathcal{S}_{i}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">X\in\mathcal{S}_{i}</annotation></semantics></math> remains a hyperplane
of <math id="S4.SS2.p4.m5" class="ltx_Math" alttext="\textrm{M}_{i-1}" display="inline" intent=":literal"><semantics><msub><mtext>M</mtext><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\textrm{M}_{i-1}</annotation></semantics></math>.
The intersection bound (<a href="#S4.E27" title="Equation 27 ‣ 4.2. The Gabidulin family ‣ 4. Four families from finite geometries ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27</span></a>)
therefore allows absorption by
<a href="#S3.Thmthm11" title="Proposition 3.11 ‣ 3.2. Absorption ‣ 3. Matroid operations: hyperplane coalescence, absorption ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">3.11</span></a>.</span></p>
</div>
<div id="S4.SS2.p5" class="ltx_para">
<p id="S4.SS2.p5.1" class="ltx_p"><span id="S4.SS2.p5.1.1" class="ltx_text">The hyperplanes of <math id="S4.SS2.p5.m1" class="ltx_Math" alttext="\widetilde{\textrm{M}}_{i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mtext>M</mtext><mo>~</mo></mover><mi>i</mi></msub><annotation encoding="application/x-tex">\widetilde{\textrm{M}}_{i}</annotation></semantics></math> are the same
hyperplanes as those of <math id="S4.SS2.p5.m2" class="ltx_Math" alttext="\textrm{M}_{i-1}" display="inline" intent=":literal"><semantics><msub><mtext>M</mtext><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\textrm{M}_{i-1}</annotation></semantics></math> and the sets <math id="S4.SS2.p5.m3" class="ltx_Math" alttext="F\cup\{p_{i}\}" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">F\cup\{p_{i}\}</annotation></semantics></math>,
where <math id="S4.SS2.p5.m4" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> is a rank-<math id="S4.SS2.p5.m5" class="ltx_Math" alttext="(k-2)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(k-2)</annotation></semantics></math> flat of <math id="S4.SS2.p5.m6" class="ltx_Math" alttext="\textrm{M}_{i-1}" display="inline" intent=":literal"><semantics><msub><mtext>M</mtext><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\textrm{M}_{i-1}</annotation></semantics></math>.
Hyperplane coalescence replaces each selected <math id="S4.SS2.p5.m7" class="ltx_Math" alttext="\mathbb{P}(X)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(X)</annotation></semantics></math>
by <math id="S4.SS2.p5.m8" class="ltx_Math" alttext="\mathbb{P}(X)\cup\{p_{i}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∪</mo><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(X)\cup\{p_{i}\}</annotation></semantics></math>. Among the new hyperplanes, it removes precisely those
<math id="S4.SS2.p5.m9" class="ltx_Math" alttext="\mathbb{P}(Y)\cup\{p_{i}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∪</mo><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(Y)\cup\{p_{i}\}</annotation></semantics></math> for which <math id="S4.SS2.p5.m10" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math> is contained in a member of <math id="S4.SS2.p5.m11" class="ltx_Math" alttext="\mathcal{S}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{S}_{i}</annotation></semantics></math>.
Hyperplanes containing an earlier auxiliary point remain,
since they cannot lie in a selected block.</span></p>
</div>
<div id="S4.SS2.p6" class="ltx_para">
<p id="S4.SS2.p6.1" class="ltx_p"><span id="S4.SS2.p6.1.1" class="ltx_text">Adjoining <math id="S4.SS2.p6.m1" class="ltx_Math" alttext="p_{i}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>i</mi></msub><annotation encoding="application/x-tex">p_{i}</annotation></semantics></math> and truncating results in the lower flats
listed in (L), and these are unchanged by coalescence.
The remaining and coalesced hyperplanes give (N), (B), (U), and (H), completing the induction.
∎</span></p>
</div>
</div>
<div id="S4.SS2.p7" class="ltx_para">
<p id="S4.SS2.p7.1" class="ltx_p">We now compute the flag <math id="S4.SS2.p7.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>-vector when <math id="S4.SS2.p7.m2" class="ltx_Math" alttext="k=4" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">k=4</annotation></semantics></math>.
Let <math id="S4.SS2.p7.m3" class="ltx_Math" alttext="N_{1},N_{2},N_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mn>1</mn></msub><mo>,</mo><msub><mi>N</mi><mn>2</mn></msub><mo>,</mo><msub><mi>N</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">N_{1},N_{2},N_{3}</annotation></semantics></math> denote the numbers of points, lines,
and planes in <math id="S4.SS2.p7.m4" class="ltx_Math" alttext="\textrm{PG}(n-1,q)" display="inline" intent=":literal"><semantics><mrow><mtext>PG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textrm{PG}(n-1,q)</annotation></semantics></math>:</p>
<table id="S4.Ex154" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex154.m1" class="ltx_Math" alttext="N_{1}=\genfrac{[}{]}{0.0pt}{1}{n}{1}_{q},\qquad N_{2}=\genfrac{[}{]}{0.0pt}{1}{n}{2}_{q},\qquad N_{3}=\genfrac{[}{]}{0.0pt}{1}{n}{3}_{q}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>N</mi><mn>1</mn></msub><mo>=</mo><msub><mrow><mo>[</mo><mstyle displaystyle="false"><mfrac linethickness="0.0pt"><mi>n</mi><mn>1</mn></mfrac></mstyle><mo>]</mo></mrow><mi>q</mi></msub></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi>N</mi><mn>2</mn></msub><mo>=</mo><msub><mrow><mo>[</mo><mstyle displaystyle="false"><mfrac linethickness="0.0pt"><mi>n</mi><mn>2</mn></mfrac></mstyle><mo>]</mo></mrow><mi>q</mi></msub></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi>N</mi><mn>3</mn></msub><mo>=</mo><msub><mrow><mo>[</mo><mstyle displaystyle="false"><mfrac linethickness="0.0pt"><mi>n</mi><mn>3</mn></mfrac></mstyle><mo>]</mo></mrow><mi>q</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">N_{1}=\genfrac{[}{]}{0.0pt}{1}{n}{1}_{q},\qquad N_{2}=\genfrac{[}{]}{0.0pt}{1}{n}{2}_{q},\qquad N_{3}=\genfrac{[}{]}{0.0pt}{1}{n}{3}_{q},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p7.2" class="ltx_p">with <math id="S4.SS2.p7.m5" class="ltx_Math" alttext="\genfrac{[}{]}{0.0pt}{1}{n}{i}_{q}" display="inline" intent=":literal"><semantics><msub><mrow><mo>[</mo><mfrac linethickness="0.0pt"><mi>n</mi><mi>i</mi></mfrac><mo>]</mo></mrow><mi>q</mi></msub><annotation encoding="application/x-tex">\genfrac{[}{]}{0.0pt}{1}{n}{i}_{q}</annotation></semantics></math> denoting the number of <math id="S4.SS2.p7.m6" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-dimensional subspaces
of <math id="S4.SS2.p7.m7" class="ltx_Math" alttext="\mathbb{F}_{q}^{n}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔽</mi><mi>q</mi><mi>n</mi></msubsup><annotation encoding="application/x-tex">\mathbb{F}_{q}^{n}</annotation></semantics></math>.
Each projective line contains <math id="S4.SS2.p7.m8" class="ltx_Math" alttext="q+1" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">q+1</annotation></semantics></math> points, and each
projective plane contains <math id="S4.SS2.p7.m9" class="ltx_Math" alttext="[3]_{q}=q^{2}+q+1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">[</mo><mn>3</mn><mo stretchy="false">]</mo></mrow><mi>q</mi></msub><mo>=</mo><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mi>q</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">[3]_{q}=q^{2}+q+1</annotation></semantics></math> points
and the same number of lines. The pairwise disjoint families <math id="S4.SS2.p7.m10" class="ltx_Math" alttext="\mathcal{S}_{1},\dots,\mathcal{S}_{m}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">\mathcal{S}_{1},\dots,\mathcal{S}_{m}</annotation></semantics></math>
select a total of</p>
<table id="S4.Ex155" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex155.m1" class="ltx_Math" alttext="b=\sum_{i=1}^{m}|\mathcal{S}_{i}|" display="block" intent=":literal"><semantics><mrow><mi>b</mi><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">b=\sum_{i=1}^{m}|\mathcal{S}_{i}|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p7.3" class="ltx_p">geometric planes. Hyperplane coalescence replaces each selected plane <math id="S4.SS2.p7.m11" class="ltx_Math" alttext="\mathbb{P}(X)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(X)</annotation></semantics></math>,
with <math id="S4.SS2.p7.m12" class="ltx_Math" alttext="X\in\mathcal{S}_{i}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">X\in\mathcal{S}_{i}</annotation></semantics></math>, by <math id="S4.SS2.p7.m13" class="ltx_Math" alttext="\mathbb{P}(X)\cup\{p_{i}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∪</mo><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(X)\cup\{p_{i}\}</annotation></semantics></math>.
Thus there are <math id="S4.SS2.p7.m14" class="ltx_Math" alttext="N_{3}-b" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mn>3</mn></msub><mo>−</mo><mi>b</mi></mrow><annotation encoding="application/x-tex">N_{3}-b</annotation></semantics></math> unchanged geometric planes
and <math id="S4.SS2.p7.m15" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math> coalesced planes. For each auxiliary point <math id="S4.SS2.p7.m16" class="ltx_Math" alttext="p_{i}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>i</mi></msub><annotation encoding="application/x-tex">p_{i}</annotation></semantics></math>, the other possible
hyperplanes containing no further auxiliary point are <math id="S4.SS2.p7.m17" class="ltx_Math" alttext="\ell\cup\{p_{i}\}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><msub><mi>p</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\ell\cup\{p_{i}\}</annotation></semantics></math>, where <math id="S4.SS2.p7.m18" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> is a projective line.
Such a hyperplane is absorbed precisely when <math id="S4.SS2.p7.m19" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>
lies in a plane selected by <math id="S4.SS2.p7.m20" class="ltx_Math" alttext="\mathcal{S}_{i}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathcal{S}_{i}</annotation></semantics></math>.
Each selected plane contains <math id="S4.SS2.p7.m21" class="ltx_Math" alttext="[3]_{q}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">[</mo><mn>3</mn><mo stretchy="false">]</mo></mrow><mi>q</mi></msub><annotation encoding="application/x-tex">[3]_{q}</annotation></semantics></math> lines, and
(<a href="#S4.E27" title="Equation 27 ‣ 4.2. The Gabidulin family ‣ 4. Four families from finite geometries ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27</span></a>) ensures that no line lies
in two planes selected by the same family.
Therefore, the number of unabsorbed hyperplanes of this form is</p>
<table id="S4.Ex156" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex156.m1" class="ltx_Math" alttext="N_{\mathrm{U}}=mN_{2}-b[3]_{q}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>N</mi><mi>U</mi></msub><mo>=</mo><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mn>2</mn></msub></mrow><mo>−</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">[</mo><mn>3</mn><mo stretchy="false">]</mo></mrow><mi>q</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">N_{\mathrm{U}}=mN_{2}-b[3]_{q}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p7.4" class="ltx_p">The remaining hyperplanes contain at least two auxiliary
points. By <a href="#S4.Thmthm13" title="Proposition 4.13 ‣ 4.2. The Gabidulin family ‣ 4. Four families from finite geometries ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">4.13</span></a>, they are the triples
consisting of one geometric point and two auxiliary points,
or three auxiliary points.
As a result, the number of such hyperplanes is</p>
<table id="S4.Ex157" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex157.m1" class="ltx_Math" alttext="N_{1}\binom{m}{2}+\binom{m}{3}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>N</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>m</mi><mn>2</mn></mfrac><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>m</mi><mn>3</mn></mfrac><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">N_{1}\binom{m}{2}+\binom{m}{3}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.SS2.p8" class="ltx_para">
<p id="S4.SS2.p8.1" class="ltx_p">Let <math id="S4.SS2.p8.m1" class="ltx_Math" alttext="W_{j}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mi>j</mi></msub><annotation encoding="application/x-tex">W_{j}</annotation></semantics></math> denote the number of rank-<math id="S4.SS2.p8.m2" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> flats of <math id="S4.SS2.p8.m3" class="ltx_Math" alttext="\textrm{M}_{m}" display="inline" intent=":literal"><semantics><msub><mtext>M</mtext><mi>m</mi></msub><annotation encoding="application/x-tex">\textrm{M}_{m}</annotation></semantics></math>.
The description of the flats above and the counts give</p>
<table id="S4.Ex158" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S4.Ex158X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex158X.m2" class="ltx_Math" alttext="\displaystyle W_{1}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\displaystyle W_{1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex158X.m3" class="ltx_Math" alttext="\displaystyle=N_{1}+m," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>N</mi><mn>1</mn></msub><mo>+</mo><mi>m</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=N_{1}+m,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex158Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex158Xa.m2" class="ltx_Math" alttext="\displaystyle W_{2}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle W_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex158Xa.m3" class="ltx_Math" alttext="\displaystyle=N_{2}+N_{1}m+\binom{m}{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>N</mi><mn>2</mn></msub><mo>+</mo><mrow><msub><mi>N</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mi>m</mi><mn>2</mn></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=N_{2}+N_{1}m+\binom{m}{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex158Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex158Xb.m2" class="ltx_Math" alttext="\displaystyle W_{3}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mn>3</mn></msub><annotation encoding="application/x-tex">\displaystyle W_{3}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex158Xb.m3" class="ltx_Math" alttext="\displaystyle=N_{3}+N_{\mathrm{U}}+N_{1}\binom{m}{2}+\binom{m}{3}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>N</mi><mn>3</mn></msub><mo>+</mo><msub><mi>N</mi><mi>U</mi></msub><mo>+</mo><mrow><msub><mi>N</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mi>m</mi><mn>2</mn></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mi>m</mi><mn>3</mn></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=N_{3}+N_{\mathrm{U}}+N_{1}\binom{m}{2}+\binom{m}{3}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.Thmthm14" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm14.2" class="ltx_text ltx_font_bold">Corollary 4.14</span></span></h6>
<div id="S4.Thmthm14.p1" class="ltx_para">
<p id="S4.Thmthm14.p1.1" class="ltx_p"><span id="S4.Thmthm14.p1.1.1" class="ltx_text ltx_font_italic">The flag <math id="S4.Thmthm14.p1.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>-vector of <math id="S4.Thmthm14.p1.m2" class="ltx_Math" alttext="\textrm{M}_{m}" display="inline" intent=":literal"><semantics><msub><mtext>M</mtext><mi>m</mi></msub><annotation encoding="application/x-tex">\textrm{M}_{m}</annotation></semantics></math> is</span></p>
<table id="S4.Ex159" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S4.Ex159X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex159X.m2" class="ltx_Math" alttext="\displaystyle\alpha(i)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\alpha(i)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex159X.m3" class="ltx_Math" alttext="\displaystyle=W_{i}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><msub><mi>W</mi><mi>i</mi></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=W_{i},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex159Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex159Xa.m2" class="ltx_Math" alttext="\displaystyle\alpha(12)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>12</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\alpha(12)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex159Xa.m3" class="ltx_Math" alttext="\displaystyle=(q+1)N_{2}+2N_{1}m+2\binom{m}{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mn>2</mn></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mi>m</mi><mn>2</mn></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=(q+1)N_{2}+2N_{1}m+2\binom{m}{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex159Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex159Xb.m2" class="ltx_Math" alttext="\displaystyle\alpha(13)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>13</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\alpha(13)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex159Xb.m3" class="ltx_Math" alttext="\displaystyle=[3]_{q}N_{3}+b+(q+2)N_{\mathrm{U}}+3N_{1}\binom{m}{2}+3\binom{m}{3}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mrow><mo stretchy="false">[</mo><mn>3</mn><mo stretchy="false">]</mo></mrow><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mn>3</mn></msub></mrow><mo>+</mo><mi>b</mi><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mi>U</mi></msub></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mi>m</mi><mn>2</mn></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mi>m</mi><mn>3</mn></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=[3]_{q}N_{3}+b+(q+2)N_{\mathrm{U}}+3N_{1}\binom{m}{2}+3\binom{m}{3},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex159Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex159Xc.m2" class="ltx_Math" alttext="\displaystyle\alpha(23)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>23</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\alpha(23)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex159Xc.m3" class="ltx_Math" alttext="\displaystyle=[3]_{q}N_{3}+[3]_{q}b+(q+2)N_{\mathrm{U}}+3N_{1}\binom{m}{2}+3\binom{m}{3}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mrow><mo stretchy="false">[</mo><mn>3</mn><mo stretchy="false">]</mo></mrow><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mn>3</mn></msub></mrow><mo>+</mo><mrow><msub><mrow><mo stretchy="false">[</mo><mn>3</mn><mo stretchy="false">]</mo></mrow><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mi>U</mi></msub></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mi>m</mi><mn>2</mn></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mi>m</mi><mn>3</mn></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=[3]_{q}N_{3}+[3]_{q}b+(q+2)N_{\mathrm{U}}+3N_{1}\binom{m}{2}+3\binom{m}{3},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex159Xd"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex159Xd.m2" class="ltx_Math" alttext="\displaystyle\alpha(123)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>123</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\alpha(123)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex159Xd.m3" class="ltx_Math" alttext="\displaystyle=(q+1)[3]_{q}N_{3}+2[3]_{q}b+3(q+1)N_{\mathrm{U}}+6N_{1}\binom{m}{2}+6\binom{m}{3}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">[</mo><mn>3</mn><mo stretchy="false">]</mo></mrow><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mn>3</mn></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">[</mo><mn>3</mn><mo stretchy="false">]</mo></mrow><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mi>U</mi></msub></mrow><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mi>m</mi><mn>2</mn></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mi>m</mi><mn>3</mn></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=(q+1)[3]_{q}N_{3}+2[3]_{q}b+3(q+1)N_{\mathrm{U}}+6N_{1}\binom{m}{2}+6\binom{m}{3}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.SS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS2.p9" class="ltx_para">
<p id="S4.SS2.p9.1" class="ltx_p"><span id="S4.SS2.p9.1.1" class="ltx_text">There are <math id="S4.SS2.p9.m1" class="ltx_Math" alttext="N_{2}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mn>2</mn></msub><annotation encoding="application/x-tex">N_{2}</annotation></semantics></math> geometric lines, each containing <math id="S4.SS2.p9.m2" class="ltx_Math" alttext="q+1" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">q+1</annotation></semantics></math>
points, and <math id="S4.SS2.p9.m3" class="ltx_Math" alttext="N_{1}m+\binom{m}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>N</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>m</mi><mn>2</mn></mfrac><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">N_{1}m+\binom{m}{2}</annotation></semantics></math> two-point lines involving
auxiliary points.
Counting points on these lines gives</span></p>
<table id="S4.Ex160" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex160.m1" class="ltx_Math" alttext="\alpha(12)=(q+1)N_{2}+2\left(N_{1}m+\binom{m}{2}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>12</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mn>2</mn></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>N</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>m</mi><mn>2</mn></mfrac><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\alpha(12)=(q+1)N_{2}+2\left(N_{1}m+\binom{m}{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.SS2.p10" class="ltx_para">
<p id="S4.SS2.p10.1" class="ltx_p"><span id="S4.SS2.p10.1.1" class="ltx_text">For the other entries, group chains by their largest flat.</span></p>
<ol id="S4.I6" class="ltx_enumerate">
<li id="S4.I6.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I6.i1.p1" class="ltx_para">
<p id="S4.I6.i1.p1.1" class="ltx_p">There are <math id="S4.I6.i1.p1.m1" class="ltx_Math" alttext="N_{3}-b" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mn>3</mn></msub><mo>−</mo><mi>b</mi></mrow><annotation encoding="application/x-tex">N_{3}-b</annotation></semantics></math> unselected geometric planes.
Each contains <math id="S4.I6.i1.p1.m2" class="ltx_Math" alttext="[3]_{q}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">[</mo><mn>3</mn><mo stretchy="false">]</mo></mrow><mi>q</mi></msub><annotation encoding="application/x-tex">[3]_{q}</annotation></semantics></math> points and <math id="S4.I6.i1.p1.m3" class="ltx_Math" alttext="[3]_{q}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">[</mo><mn>3</mn><mo stretchy="false">]</mo></mrow><mi>q</mi></msub><annotation encoding="application/x-tex">[3]_{q}</annotation></semantics></math> lines,
all of size <math id="S4.I6.i1.p1.m4" class="ltx_Math" alttext="q+1" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">q+1</annotation></semantics></math>.
It therefore contributes <math id="S4.I6.i1.p1.m5" class="ltx_Math" alttext="[3]_{q}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">[</mo><mn>3</mn><mo stretchy="false">]</mo></mrow><mi>q</mi></msub><annotation encoding="application/x-tex">[3]_{q}</annotation></semantics></math>, <math id="S4.I6.i1.p1.m6" class="ltx_Math" alttext="[3]_{q}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">[</mo><mn>3</mn><mo stretchy="false">]</mo></mrow><mi>q</mi></msub><annotation encoding="application/x-tex">[3]_{q}</annotation></semantics></math>, and
<math id="S4.I6.i1.p1.m7" class="ltx_Math" alttext="(q+1)[3]_{q}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">[</mo><mn>3</mn><mo stretchy="false">]</mo></mrow><mi>q</mi></msub></mrow><annotation encoding="application/x-tex">(q+1)[3]_{q}</annotation></semantics></math> to <math id="S4.I6.i1.p1.m8" class="ltx_Math" alttext="\alpha(13)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>13</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha(13)</annotation></semantics></math>, <math id="S4.I6.i1.p1.m9" class="ltx_Math" alttext="\alpha(23)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>23</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha(23)</annotation></semantics></math>, and
<math id="S4.I6.i1.p1.m10" class="ltx_Math" alttext="\alpha(123)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>123</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha(123)</annotation></semantics></math>, respectively.</p>
</div></li>
<li id="S4.I6.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I6.i2.p1" class="ltx_para">
<p id="S4.I6.i2.p1.1" class="ltx_p">There are <math id="S4.I6.i2.p1.m1" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math> coalesced planes.
Each contains <math id="S4.I6.i2.p1.m2" class="ltx_Math" alttext="[3]_{q}+1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">[</mo><mn>3</mn><mo stretchy="false">]</mo></mrow><mi>q</mi></msub><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">[3]_{q}+1</annotation></semantics></math> points and <math id="S4.I6.i2.p1.m3" class="ltx_Math" alttext="2[3]_{q}" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">[</mo><mn>3</mn><mo stretchy="false">]</mo></mrow><mi>q</mi></msub></mrow><annotation encoding="application/x-tex">2[3]_{q}</annotation></semantics></math> lines:
the <math id="S4.I6.i2.p1.m4" class="ltx_Math" alttext="[3]_{q}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">[</mo><mn>3</mn><mo stretchy="false">]</mo></mrow><mi>q</mi></msub><annotation encoding="application/x-tex">[3]_{q}</annotation></semantics></math> geometric lines, each of size <math id="S4.I6.i2.p1.m5" class="ltx_Math" alttext="q+1" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">q+1</annotation></semantics></math>,
and the <math id="S4.I6.i2.p1.m6" class="ltx_Math" alttext="[3]_{q}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">[</mo><mn>3</mn><mo stretchy="false">]</mo></mrow><mi>q</mi></msub><annotation encoding="application/x-tex">[3]_{q}</annotation></semantics></math> two-point lines joining a geometric
point to the auxiliary point.
It therefore contributes <math id="S4.I6.i2.p1.m7" class="ltx_Math" alttext="[3]_{q}+1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">[</mo><mn>3</mn><mo stretchy="false">]</mo></mrow><mi>q</mi></msub><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">[3]_{q}+1</annotation></semantics></math>, <math id="S4.I6.i2.p1.m8" class="ltx_Math" alttext="2[3]_{q}" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">[</mo><mn>3</mn><mo stretchy="false">]</mo></mrow><mi>q</mi></msub></mrow><annotation encoding="application/x-tex">2[3]_{q}</annotation></semantics></math>, and
<math id="S4.I6.i2.p1.m9" class="ltx_Math" alttext="(q+3)[3]_{q}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>+</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">[</mo><mn>3</mn><mo stretchy="false">]</mo></mrow><mi>q</mi></msub></mrow><annotation encoding="application/x-tex">(q+3)[3]_{q}</annotation></semantics></math> to <math id="S4.I6.i2.p1.m10" class="ltx_Math" alttext="\alpha(13)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>13</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha(13)</annotation></semantics></math>, <math id="S4.I6.i2.p1.m11" class="ltx_Math" alttext="\alpha(23)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>23</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha(23)</annotation></semantics></math>, and
<math id="S4.I6.i2.p1.m12" class="ltx_Math" alttext="\alpha(123)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>123</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha(123)</annotation></semantics></math>, respectively.</p>
</div></li>
<li id="S4.I6.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S4.I6.i3.p1" class="ltx_para">
<p id="S4.I6.i3.p1.1" class="ltx_p">There are <math id="S4.I6.i3.p1.m1" class="ltx_Math" alttext="N_{\mathrm{U}}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>U</mi></msub><annotation encoding="application/x-tex">N_{\mathrm{U}}</annotation></semantics></math> unabsorbed hyperplanes with one auxiliary
point.
Each contains <math id="S4.I6.i3.p1.m2" class="ltx_Math" alttext="q+2" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>+</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">q+2</annotation></semantics></math> points and <math id="S4.I6.i3.p1.m3" class="ltx_Math" alttext="q+2" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>+</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">q+2</annotation></semantics></math> lines:
one geometric line of size <math id="S4.I6.i3.p1.m4" class="ltx_Math" alttext="q+1" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">q+1</annotation></semantics></math>, and <math id="S4.I6.i3.p1.m5" class="ltx_Math" alttext="q+1" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">q+1</annotation></semantics></math> two-point
lines through the auxiliary point.
It therefore contributes <math id="S4.I6.i3.p1.m6" class="ltx_Math" alttext="q+2" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>+</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">q+2</annotation></semantics></math>, <math id="S4.I6.i3.p1.m7" class="ltx_Math" alttext="q+2" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>+</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">q+2</annotation></semantics></math>, and <math id="S4.I6.i3.p1.m8" class="ltx_Math" alttext="3(q+1)" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">3(q+1)</annotation></semantics></math>
to <math id="S4.I6.i3.p1.m9" class="ltx_Math" alttext="\alpha(13)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>13</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha(13)</annotation></semantics></math>, <math id="S4.I6.i3.p1.m10" class="ltx_Math" alttext="\alpha(23)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>23</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha(23)</annotation></semantics></math>, and <math id="S4.I6.i3.p1.m11" class="ltx_Math" alttext="\alpha(123)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>123</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha(123)</annotation></semantics></math>,
respectively.</p>
</div></li>
<li id="S4.I6.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S4.I6.i4.p1" class="ltx_para">
<p id="S4.I6.i4.p1.1" class="ltx_p">There are <math id="S4.I6.i4.p1.m1" class="ltx_Math" alttext="N_{1}\binom{m}{2}+\binom{m}{3}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>N</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>m</mi><mn>2</mn></mfrac><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>m</mi><mn>3</mn></mfrac><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">N_{1}\binom{m}{2}+\binom{m}{3}</annotation></semantics></math> three-element hyperplanes.
Each contains three points and three lines, all of size <math id="S4.I6.i4.p1.m2" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>.
It therefore contributes <math id="S4.I6.i4.p1.m3" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>, <math id="S4.I6.i4.p1.m4" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>, and <math id="S4.I6.i4.p1.m5" class="ltx_Math" alttext="6" display="inline" intent=":literal"><semantics><mn>6</mn><annotation encoding="application/x-tex">6</annotation></semantics></math> to
<math id="S4.I6.i4.p1.m6" class="ltx_Math" alttext="\alpha(13)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>13</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha(13)</annotation></semantics></math>, <math id="S4.I6.i4.p1.m7" class="ltx_Math" alttext="\alpha(23)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>23</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha(23)</annotation></semantics></math>, and <math id="S4.I6.i4.p1.m8" class="ltx_Math" alttext="\alpha(123)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>123</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha(123)</annotation></semantics></math>,
respectively.</p>
</div></li>
</ol>
<p id="S4.SS2.p10.2" class="ltx_p"><span id="S4.SS2.p10.2.1" class="ltx_text">Summing these contributions over all hyperplanes gives
the stated formulas.
∎</span></p>
</div>
</div>
</section>
<section id="S4.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.3. </span>The projective family</h3>

<div id="S4.SS3.p1" class="ltx_para">
<p id="S4.SS3.p1.1" class="ltx_p">Let <math id="S4.SS3.p1.m1" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> be a prime power and <math id="S4.SS3.p1.m2" class="ltx_Math" alttext="4\leqslant N\leqslant q^{3}" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo>⩽</mo><mi>N</mi><mo>⩽</mo><msup><mi>q</mi><mn>3</mn></msup></mrow><annotation encoding="application/x-tex">4\leqslant N\leqslant q^{3}</annotation></semantics></math>.
We construct a rank-<math id="S4.SS3.p1.m3" class="ltx_Math" alttext="7" display="inline" intent=":literal"><semantics><mn>7</mn><annotation encoding="application/x-tex">7</annotation></semantics></math> matroid <math id="S4.SS3.p1.m4" class="ltx_Math" alttext="\mathcal{C}(q,N)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo>,</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{C}(q,N)</annotation></semantics></math> by hyperplane
coalescence, then compute its flag numbers and zeta values. Let <math id="S4.SS3.p1.m5" class="ltx_Math" alttext="\mathrm{P}_{d}(q)=\textrm{PG}(d-1,q)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mtext>PG</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{P}_{d}(q)=\textrm{PG}(d-1,q)</annotation></semantics></math>, with <math id="S4.SS3.p1.m6" class="ltx_Math" alttext="\mathrm{P}_{0}(q)" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{P}_{0}(q)</annotation></semantics></math>
empty. Let</p>
<table id="S4.Ex161" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex161.m1" class="ltx_Math" alttext="U=\mathbb{F}_{q}^{3},\qquad K=\mathbb{F}_{q^{3}},\qquad V=U\oplus K." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>U</mi><mo>=</mo><msubsup><mi>𝔽</mi><mi>q</mi><mn>3</mn></msubsup></mrow><mo rspace="2.167em">,</mo><mrow><mi>K</mi><mo>=</mo><msub><mi>𝔽</mi><msup><mi>q</mi><mn>3</mn></msup></msub></mrow><mo rspace="2.167em">,</mo><mrow><mi>V</mi><mo>=</mo><mrow><mi>U</mi><mo>⊕</mo><mi>K</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">U=\mathbb{F}_{q}^{3},\qquad K=\mathbb{F}_{q^{3}},\qquad V=U\oplus K.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.p1.2" class="ltx_p">Let <math id="S4.SS3.p1.m7" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> be a disjoint copy of <math id="S4.SS3.p1.m8" class="ltx_Math" alttext="\mathbb{Z}/N\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℤ</mi><mo>/</mo><mi>N</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">\mathbb{Z}/N\mathbb{Z}</annotation></semantics></math>, and put</p>
<table id="S4.Ex162" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex162.m1" class="ltx_Math" alttext="\mathrm{Q}=\mathrm{P}_{6}(q)\oplus\textrm{U}_{X,X},\qquad\textrm{M}=\mathrm{Tr}^{N-1}(\mathrm{Q})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Q</mi><mo>=</mo><mrow><mrow><msub><mi>P</mi><mn>6</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><msub><mtext>U</mtext><mrow><mi>X</mi><mo>,</mo><mi>X</mi></mrow></msub></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mtext>M</mtext><mo>=</mo><mrow><msup><mi>Tr</mi><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Q}=\mathrm{P}_{6}(q)\oplus\textrm{U}_{X,X},\qquad\textrm{M}=\mathrm{Tr}^{N-1}(\mathrm{Q}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.p1.3" class="ltx_p">Thus <span id="S4.SS3.p1.3.1" class="ltx_text ltx_markedasmath">M</span> has rank <math id="S4.SS3.p1.m10" class="ltx_Math" alttext="7" display="inline" intent=":literal"><semantics><mn>7</mn><annotation encoding="application/x-tex">7</annotation></semantics></math>. Its proper flats are
<math id="S4.SS3.p1.m11" class="ltx_Math" alttext="\mathbb{P}(W)\sqcup D" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊔</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">\mathbb{P}(W)\sqcup D</annotation></semantics></math>, where <math id="S4.SS3.p1.m12" class="ltx_Math" alttext="W\subseteq V" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>⊆</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">W\subseteq V</annotation></semantics></math> is a linear
subspace, <math id="S4.SS3.p1.m13" class="ltx_Math" alttext="D\subseteq X" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⊆</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">D\subseteq X</annotation></semantics></math>, and <math id="S4.SS3.p1.m14" class="ltx_Math" alttext="\dim W+|D|\leqslant 6" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0.167em">dim</mo><mi>W</mi></mrow><mo>+</mo><mrow><mo stretchy="false">|</mo><mi>D</mi><mo stretchy="false">|</mo></mrow></mrow><mo>⩽</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">\dim W+|D|\leqslant 6</annotation></semantics></math>.</p>
</div>
<div id="S4.SS3.p2" class="ltx_para">
<p id="S4.SS3.p2.1" class="ltx_p">Choose an <math id="S4.SS3.p2.m1" class="ltx_Math" alttext="\mathbb{F}_{q}" display="inline" intent=":literal"><semantics><msub><mi>𝔽</mi><mi>q</mi></msub><annotation encoding="application/x-tex">\mathbb{F}_{q}</annotation></semantics></math>-basis <math id="S4.SS3.p2.m2" class="ltx_Math" alttext="\alpha_{1},\alpha_{2},\alpha_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mn>1</mn></msub><mo>,</mo><msub><mi>α</mi><mn>2</mn></msub><mo>,</mo><msub><mi>α</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">\alpha_{1},\alpha_{2},\alpha_{3}</annotation></semantics></math> of <math id="S4.SS3.p2.m3" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>.
For the standard basis <math id="S4.SS3.p2.m4" class="ltx_Math" alttext="e_{1},e_{2},e_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>,</mo><msub><mi>e</mi><mn>2</mn></msub><mo>,</mo><msub><mi>e</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">e_{1},e_{2},e_{3}</annotation></semantics></math> of <math id="S4.SS3.p2.m5" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>, define</p>
<table id="S4.Ex163" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex163.m1" class="ltx_Math" alttext="\phi:\operatorname{Hom}_{\mathbb{F}_{q}}(U,K)\longrightarrow K,\qquad A\longmapsto\sum_{i=1}^{3}\alpha_{i}A(e_{i})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ϕ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>Hom</mi><msub><mi>𝔽</mi><mi>q</mi></msub></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>U</mi><mo>,</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟶</mo><mi>K</mi></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>A</mi><mo rspace="0.111em" stretchy="false">⟼</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mn>3</mn></munderover><mrow><msub><mi>α</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\phi:\operatorname{Hom}_{\mathbb{F}_{q}}(U,K)\longrightarrow K,\qquad A\longmapsto\sum_{i=1}^{3}\alpha_{i}A(e_{i}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.p2.2" class="ltx_p">Each map <math id="S4.SS3.p2.m6" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> determines a three-dimensional graph</p>
<table id="S4.Ex164" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex164.m1" class="ltx_Math" alttext="G_{A}=\{(u,A(u)):u\in U\}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>G</mi><mi>A</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mrow><mi>u</mi><mo>∈</mo><mi>U</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">G_{A}=\{(u,A(u)):u\in U\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.p2.3" class="ltx_p">The map <math id="S4.SS3.p2.m7" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> is surjective, so each fiber has <math id="S4.SS3.p2.m8" class="ltx_Math" alttext="q^{6}" display="inline" intent=":literal"><semantics><msup><mi>q</mi><mn>6</mn></msup><annotation encoding="application/x-tex">q^{6}</annotation></semantics></math> elements.
Moreover, its kernel contains no rank-one map: if
<math id="S4.SS3.p2.m9" class="ltx_Math" alttext="A(e_{i})=c_{i}v" display="inline" intent=":literal"><semantics><mrow><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>e</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>c</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><annotation encoding="application/x-tex">A(e_{i})=c_{i}v</annotation></semantics></math>, with <math id="S4.SS3.p2.m10" class="ltx_Math" alttext="v\neq 0" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">v\neq 0</annotation></semantics></math> and <math id="S4.SS3.p2.m11" class="ltx_Math" alttext="c_{i}\in\mathbb{F}_{q}" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>i</mi></msub><mo>∈</mo><msub><mi>𝔽</mi><mi>q</mi></msub></mrow><annotation encoding="application/x-tex">c_{i}\in\mathbb{F}_{q}</annotation></semantics></math>, then</p>
<table id="S4.Ex165" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex165.m1" class="ltx_Math" alttext="\phi(A)=0\quad\Longrightarrow\quad\sum_{i}c_{i}\alpha_{i}=0\quad\Longrightarrow\quad A=0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mspace style="width:1em;" width="1em"></mspace><mo stretchy="false">⟹</mo><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><munder><mo movablelimits="false">∑</mo><mi>i</mi></munder><mrow><msub><mi>c</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>i</mi></msub></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mspace style="width:1em;" width="1em"></mspace><mo stretchy="false">⟹</mo><mspace style="width:1em;" width="1em"></mspace><mrow><mi>A</mi><mo>=</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\phi(A)=0\quad\Longrightarrow\quad\sum_{i}c_{i}\alpha_{i}=0\quad\Longrightarrow\quad A=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.p2.4" class="ltx_p">Consequently, distinct maps in the same fiber satisfy</p>
<table id="S4.Ex166" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex166.m1" class="ltx_Math" alttext="\dim(G_{A}\cap G_{A^{\prime}})=3-\operatorname{rk}(A-A^{\prime})\leqslant 1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0em">dim</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>G</mi><mi>A</mi></msub><mo>∩</mo><msub><mi>G</mi><msup><mi>A</mi><mo>′</mo></msup></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>3</mn><mo>−</mo><mrow><mi>rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo>−</mo><msup><mi>A</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⩽</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\dim(G_{A}\cap G_{A^{\prime}})=3-\operatorname{rk}(A-A^{\prime})\leqslant 1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.Thmthm15" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm15.2" class="ltx_text ltx_font_bold">Definition 4.15</span></span></h6>
<div id="S4.Thmthm15.p1" class="ltx_para">
<p id="S4.Thmthm15.p1.1" class="ltx_p">Fix an injection <math id="S4.Thmthm15.p1.m1" class="ltx_Math" alttext="\iota:X\to K" display="inline" intent=":literal"><semantics><mrow><mi>ι</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>X</mi><mo stretchy="false">→</mo><mi>K</mi></mrow></mrow><annotation encoding="application/x-tex">\iota:X\to K</annotation></semantics></math>. For each four-element
subset <math id="S4.Thmthm15.p1.m2" class="ltx_Math" alttext="B\subseteq X" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>⊆</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">B\subseteq X</annotation></semantics></math>, let <math id="S4.Thmthm15.p1.m3" class="ltx_Math" alttext="\sigma(B)=\sum_{b\in B}b" display="inline" intent=":literal"><semantics><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mi>b</mi><mo>∈</mo><mi>B</mi></mrow></msub><mi>b</mi></mrow></mrow><annotation encoding="application/x-tex">\sigma(B)=\sum_{b\in B}b</annotation></semantics></math>,
computed in <math id="S4.Thmthm15.p1.m4" class="ltx_Math" alttext="\mathbb{Z}/N\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℤ</mi><mo>/</mo><mi>N</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">\mathbb{Z}/N\mathbb{Z}</annotation></semantics></math>. Define</p>
<table id="S4.Ex167" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex167.m1" class="ltx_math_unparsed" alttext="\mathcal{H}=\left\{\mathbb{P}(G_{A})\sqcup B:|B|=4,\ \phi(A)=\iota(\sigma(B))\right\}." display="block" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>=</mo><mrow><mo>{</mo><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>A</mi></msub><mo stretchy="false">)</mo></mrow><mo>⊔</mo><mi>B</mi><mo lspace="0.278em" rspace="0em">:</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>B</mi><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">=</mo><mn>4</mn><mo rspace="0.667em">,</mo><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>ι</mi><mrow><mo stretchy="false">(</mo><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{H}=\left\{\mathbb{P}(G_{A})\sqcup B:|B|=4,\ \phi(A)=\iota(\sigma(B))\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm15.p1.2" class="ltx_p">With these choices fixed, the <em id="S4.Thmthm15.p1.2.1" class="ltx_emph ltx_font_italic">projective family</em>
<math id="S4.Thmthm15.p1.m5" class="ltx_Math" alttext="\mathcal{C}(q,N)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo>,</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{C}(q,N)</annotation></semantics></math> is obtained by coalescing <math id="S4.Thmthm15.p1.m6" class="ltx_Math" alttext="\mathcal{H}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℋ</mi><annotation encoding="application/x-tex">\mathcal{H}</annotation></semantics></math> in <span id="S4.Thmthm15.p1.2.2" class="ltx_text ltx_markedasmath">M</span>.
There are</p>
<table id="S4.Ex168" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex168.m1" class="ltx_Math" alttext="c:=|\mathcal{H}|=q^{6}\binom{N}{4}" display="block" intent=":literal"><semantics><mrow><mi>c</mi><mo>:=</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><msup><mi>q</mi><mn>6</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>N</mi><mn>4</mn></mfrac><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c:=|\mathcal{H}|=q^{6}\binom{N}{4}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm15.p1.3" class="ltx_p">selected blocks.</p>
</div>
</div>
<div id="S4.SS3.p3" class="ltx_para">
<p id="S4.SS3.p3.1" class="ltx_p">To verify that coalescence is possible, each block is a
proper rank-<math id="S4.SS3.p3.m1" class="ltx_Math" alttext="7" display="inline" intent=":literal"><semantics><mn>7</mn><annotation encoding="application/x-tex">7</annotation></semantics></math> flat of <math id="S4.SS3.p3.m2" class="ltx_Math" alttext="\mathrm{Q}" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">\mathrm{Q}</annotation></semantics></math>, hence a spanning
subset of <span id="S4.SS3.p3.1.1" class="ltx_text ltx_markedasmath">M</span>. Distinct blocks meet in rank at most <math id="S4.SS3.p3.m4" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math>:
equal graphs force equal subset sums, so their distinct
auxiliary sets share at most two elements; equal auxiliary
sets give graph intersections of dimension at most one;
otherwise the two contributions are at most two and three.
For an independent six-element subset <math id="S4.SS3.p3.m5" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi>I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math> of a block <math id="S4.SS3.p3.m6" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>,</p>
<table id="S4.Ex169" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex169.m1" class="ltx_Math" alttext="\operatorname{cl}_{\textrm{M}}(I)=\operatorname{cl}_{\mathrm{Q}}(I)\subseteq H." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>cl</mi><mtext>M</mtext></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>cl</mi><mi>Q</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊆</mo><mi>H</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\operatorname{cl}_{\textrm{M}}(I)=\operatorname{cl}_{\mathrm{Q}}(I)\subseteq H.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.p3.2" class="ltx_p">These are precisely the two conditions of
<a href="#S3.Thmthm7" title="Lemma 3.7 ‣ 3.1. Hyperplane coalescence ‣ 3. Matroid operations: hyperplane coalescence, absorption ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">3.7</span></a>.</p>
</div>
<div id="S4.SS3.p4" class="ltx_para">
<p id="S4.SS3.p4.1" class="ltx_p">The resulting matroid is simple of rank <math id="S4.SS3.p4.m1" class="ltx_Math" alttext="7" display="inline" intent=":literal"><semantics><mn>7</mn><annotation encoding="application/x-tex">7</annotation></semantics></math>.
If <math id="S4.SS3.p4.m2" class="ltx_Math" alttext="N\geqslant 13" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>⩾</mo><mn>13</mn></mrow><annotation encoding="application/x-tex">N\geqslant 13</annotation></semantics></math>, it is <math id="S4.SS3.p4.m3" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>-connected: every bipartition
has a part containing seven auxiliary points, which form
a retained basis. That part spans, so the connectivity
value is the rank of the other part, at least two whenever
both parts have at least two elements.</p>
</div>
<div id="S4.SS3.p5" class="ltx_para">
<p id="S4.SS3.p5.1" class="ltx_p">We now count flags. Every selected block has the same
old restriction</p>
<table id="S4.Ex170" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex170.m1" class="ltx_Math" alttext="\mathrm{L}=\mathrm{P}_{3}(q)\oplus\textrm{U}_{4,4}." display="block" intent=":literal"><semantics><mrow><mrow><mi>L</mi><mo>=</mo><mrow><mrow><msub><mi>P</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><msub><mtext>U</mtext><mrow><mn>4</mn><mo>,</mo><mn>4</mn></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{L}=\mathrm{P}_{3}(q)\oplus\textrm{U}_{4,4}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.p5.2" class="ltx_p">Inside it, the old hyperplanes comprise
<math id="S4.SS3.p5.m1" class="ltx_Math" alttext="[3]_{q}=q^{2}+q+1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">[</mo><mn>3</mn><mo stretchy="false">]</mo></mrow><mi>q</mi></msub><mo>=</mo><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mi>q</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">[3]_{q}=q^{2}+q+1</annotation></semantics></math> copies of
<math id="S4.SS3.p5.m2" class="ltx_Math" alttext="\mathrm{P}_{2}(q)\oplus\textrm{U}_{4,4}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><msub><mtext>U</mtext><mrow><mn>4</mn><mo>,</mo><mn>4</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\mathrm{P}_{2}(q)\oplus\textrm{U}_{4,4}</annotation></semantics></math> and four copies of
<math id="S4.SS3.p5.m3" class="ltx_Math" alttext="\mathrm{P}_{3}(q)\oplus\textrm{U}_{3,3}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><msub><mtext>U</mtext><mrow><mn>3</mn><mo>,</mo><mn>3</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\mathrm{P}_{3}(q)\oplus\textrm{U}_{3,3}</annotation></semantics></math>.
Coalescence replaces these <math id="S4.SS3.p5.m4" class="ltx_Math" alttext="[3]_{q}+4" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">[</mo><mn>3</mn><mo stretchy="false">]</mo></mrow><mi>q</mi></msub><mo>+</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">[3]_{q}+4</annotation></semantics></math> hyperplanes by one
and preserves all flats of rank at most <math id="S4.SS3.p5.m5" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math>.
Thus the Whitney numbers are</p>
<table id="S4.Ex171" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex171.m1" class="ltx_Math" alttext="W_{s}=\sum_{a+b=s}\genfrac{[}{]}{0.0pt}{1}{6}{a}_{q}\binom{N}{b}-\begin{cases}0,&amp;1\leqslant s\leqslant 5,\\
c([3]_{q}+3),&amp;s=6.\end{cases}" display="block" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>s</mi></msub><mo rspace="0.111em">=</mo><mrow><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo>=</mo><mi>s</mi></mrow></munder><mrow><msub><mrow><mo>[</mo><mstyle displaystyle="false"><mfrac linethickness="0.0pt"><mn>6</mn><mi>a</mi></mfrac></mstyle><mo>]</mo></mrow><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>N</mi><mi>b</mi></mfrac><mo>)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn>0</mn><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>1</mn><mo>⩽</mo><mi>s</mi><mo>⩽</mo><mn>5</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mrow><mo stretchy="false">[</mo><mn>3</mn><mo stretchy="false">]</mo></mrow><mi>q</mi></msub><mo>+</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>s</mi><mo>=</mo><mn>6</mn></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow></mrow><annotation encoding="application/x-tex">W_{s}=\sum_{a+b=s}\genfrac{[}{]}{0.0pt}{1}{6}{a}_{q}\binom{N}{b}-\begin{cases}0,&amp;1\leqslant s\leqslant 5,\\
c([3]_{q}+3),&amp;s=6.\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.p5.3" class="ltx_p">Here <math id="S4.SS3.p5.m6" class="ltx_Math" alttext="\genfrac{[}{]}{0.0pt}{1}{d}{a}_{q}" display="inline" intent=":literal"><semantics><msub><mrow><mo>[</mo><mfrac linethickness="0.0pt"><mi>d</mi><mi>a</mi></mfrac><mo>]</mo></mrow><mi>q</mi></msub><annotation encoding="application/x-tex">\genfrac{[}{]}{0.0pt}{1}{d}{a}_{q}</annotation></semantics></math> counts <math id="S4.SS3.p5.m7" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math>-dimensional subspaces of
<math id="S4.SS3.p5.m8" class="ltx_Math" alttext="\mathbb{F}_{q}^{d}" display="inline" intent=":literal"><semantics><msubsup><mi>𝔽</mi><mi>q</mi><mi>d</mi></msubsup><annotation encoding="application/x-tex">\mathbb{F}_{q}^{d}</annotation></semantics></math>, and the sum ranges over
<math id="S4.SS3.p5.m9" class="ltx_Math" alttext="0\leqslant a\leqslant 6" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>⩽</mo><mi>a</mi><mo>⩽</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">0\leqslant a\leqslant 6</annotation></semantics></math> and <math id="S4.SS3.p5.m10" class="ltx_Math" alttext="0\leqslant b\leqslant N" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>⩽</mo><mi>b</mi><mo>⩽</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">0\leqslant b\leqslant N</annotation></semantics></math>. For a rank set <math id="S4.SS3.p5.m11" class="ltx_Math" alttext="S\subseteq\{1,\ldots,d+n-1\}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⊆</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mrow><mi>d</mi><mo>+</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">S\subseteq\{1,\ldots,d+n-1\}</annotation></semantics></math>, let
<math id="S4.SS3.p5.m12" class="ltx_Math" alttext="\alpha_{d,n}(S)" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mrow><mi>d</mi><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha_{d,n}(S)</annotation></semantics></math> count flags of proper flats in
<math id="S4.SS3.p5.m13" class="ltx_Math" alttext="\mathrm{P}_{d}(q)\oplus\textrm{U}_{n,n}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><msub><mtext>U</mtext><mrow><mi>n</mi><mo>,</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathrm{P}_{d}(q)\oplus\textrm{U}_{n,n}</annotation></semantics></math>, with
<math id="S4.SS3.p5.m14" class="ltx_Math" alttext="\alpha_{d,n}(\varnothing)=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>α</mi><mrow><mi>d</mi><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">∅</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\alpha_{d,n}(\varnothing)=1</annotation></semantics></math>.
Counting by the largest flat gives the recurrence</p>
<table id="S4.Ex172" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex172.m1" class="ltx_Math" alttext="\alpha_{d,n}(S)=\sum_{\begin{subarray}{c}0\leqslant a\leqslant d,\;0\leqslant b\leqslant n\\
a+b=s\end{subarray}}\genfrac{[}{]}{0.0pt}{1}{d}{a}_{q}\binom{n}{b}\,\alpha_{a,b}(S\setminus\{s\}),\qquad s=\max S." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>α</mi><mrow><mi>d</mi><mo>,</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mrow><mn>0</mn><mo>⩽</mo><mi>a</mi><mo>⩽</mo><mi>d</mi></mrow><mo>,</mo><mrow><mn> 0</mn><mo>⩽</mo><mi>b</mi><mo>⩽</mo><mi>n</mi></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo>=</mo><mi>s</mi></mrow></mtd></mtr></mtable></munder><mrow><msub><mrow><mo>[</mo><mstyle displaystyle="false"><mfrac linethickness="0.0pt"><mi>d</mi><mi>a</mi></mfrac></mstyle><mo>]</mo></mrow><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>n</mi><mi>b</mi></mfrac><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>S</mi><mo>∖</mo><mrow><mo stretchy="false">{</mo><mi>s</mi><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>s</mi><mo>=</mo><mrow><mi>max</mi><mo lspace="0.167em">⁡</mo><mi>S</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\alpha_{d,n}(S)=\sum_{\begin{subarray}{c}0\leqslant a\leqslant d,\;0\leqslant b\leqslant n\\
a+b=s\end{subarray}}\genfrac{[}{]}{0.0pt}{1}{d}{a}_{q}\binom{n}{b}\,\alpha_{a,b}(S\setminus\{s\}),\qquad s=\max S.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.Thmthm16" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm16.2" class="ltx_text ltx_font_bold">Proposition 4.16</span></span></h6>
<div id="S4.Thmthm16.p1" class="ltx_para">
<p id="S4.Thmthm16.p1.1" class="ltx_p"><span id="S4.Thmthm16.p1.1.1" class="ltx_text ltx_font_italic">For <math id="S4.Thmthm16.p1.m1" class="ltx_Math" alttext="T\subseteq\{1,\ldots,5\}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>⊆</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>5</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">T\subseteq\{1,\ldots,5\}</annotation></semantics></math>, the flag numbers of
<math id="S4.Thmthm16.p1.m2" class="ltx_Math" alttext="\mathcal{C}(q,N)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo>,</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{C}(q,N)</annotation></semantics></math> satisfy</span></p>
<table id="S4.Ex173" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S4.Ex173X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex173X.m2" class="ltx_Math" alttext="\displaystyle\alpha_{\mathcal{C}(q,N)}(T)" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo>,</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\alpha_{\mathcal{C}(q,N)}(T)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex173X.m3" class="ltx_Math" alttext="\displaystyle=\alpha_{6,N}(T)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>α</mi><mrow><mn>6</mn><mo>,</mo><mi>N</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\alpha_{6,N}(T),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex173Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex173Xa.m2" class="ltx_Math" alttext="\displaystyle\alpha_{\mathcal{C}(q,N)}(T\cup\{6\})" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo>,</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mn>6</mn><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\alpha_{\mathcal{C}(q,N)}(T\cup\{6\})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex173Xa.m3" class="ltx_Math" alttext="\displaystyle=\alpha_{6,N}(T\cup\{6\})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>α</mi><mrow><mn>6</mn><mo>,</mo><mi>N</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mn>6</mn><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\alpha_{6,N}(T\cup\{6\})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex173Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex173Xb.m2" class="ltx_Math" alttext="\displaystyle+c\bigl(\alpha_{3,4}(T)-\alpha_{3,4}(T\cup\{6\})\bigr)." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mi>c</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi>α</mi><mrow><mn>3</mn><mo>,</mo><mn>4</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>α</mi><mrow><mn>3</mn><mo>,</mo><mn>4</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mn>6</mn><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+c\bigl(\alpha_{3,4}(T)-\alpha_{3,4}(T\cup\{6\})\bigr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS3.p6" class="ltx_para">
<p id="S4.SS3.p6.1" class="ltx_p"><span id="S4.SS3.p6.1.1" class="ltx_text">Within each selected block, coalescence removes
<math id="S4.SS3.p6.m1" class="ltx_Math" alttext="\alpha_{3,4}(T\cup\{6\})" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mrow><mn>3</mn><mo>,</mo><mn>4</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mn>6</mn><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha_{3,4}(T\cup\{6\})</annotation></semantics></math> flags ending at old hyperplanes
and introduces <math id="S4.SS3.p6.m2" class="ltx_Math" alttext="\alpha_{3,4}(T)" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mrow><mn>3</mn><mo>,</mo><mn>4</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha_{3,4}(T)</annotation></semantics></math> flags ending at the new
hyperplane. Distinct blocks contain no common old
hyperplane, and these corrections are additive, so we obtain the desired count.
∎</span></p>
</div>
</div>
</section>
<section id="S4.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.4. </span>Multichain counts are not log-concave</h3>

<div id="S4.SS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of <a href="#Thmintrothm2" title="Theorem B ‣ 1. Introduction ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">B</span></a>.</h6>
<div id="S4.SS4.p1" class="ltx_para">
<p id="S4.SS4.p1.2" class="ltx_p"><span id="S4.SS4.p1.2.1" class="ltx_text">For each family <math id="S4.SS4.p1.m1" class="ltx_Math" alttext="\textrm{M}=\textrm{M}(q)" display="inline" intent=":literal"><semantics><mrow><mtext>M</mtext><mo>=</mo><mrow><mtext>M</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\textrm{M}=\textrm{M}(q)</annotation></semantics></math> of rank <math id="S4.SS4.p1.m2" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>, define for <math id="S4.SS4.p1.m3" class="ltx_Math" alttext="j=1,2,3" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">j=1,2,3</annotation></semantics></math>,</span></p>
<table id="S4.Ex174" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex174.m1" class="ltx_Math" alttext="c_{j}=\sum_{\begin{subarray}{c}S\subseteq[r-1]\\
|S|=j\end{subarray}}\alpha_{\textrm{M}}(S),\qquad D(q)=Z_{\textrm{M}}(3)^{2}-Z_{\textrm{M}}(2)Z_{\textrm{M}}(4)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>c</mi><mi>j</mi></msub><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>S</mi><mo>⊆</mo><mrow><mo stretchy="false">[</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mi>j</mi></mrow></mtd></mtr></mtable></munder><mrow><msub><mi>α</mi><mtext>M</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>Z</mi><mtext>M</mtext></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>−</mo><mrow><msub><mi>Z</mi><mtext>M</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>Z</mi><mtext>M</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">c_{j}=\sum_{\begin{subarray}{c}S\subseteq[r-1]\\
|S|=j\end{subarray}}\alpha_{\textrm{M}}(S),\qquad D(q)=Z_{\textrm{M}}(3)^{2}-Z_{\textrm{M}}(2)Z_{\textrm{M}}(4).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p1.3" class="ltx_p"><span id="S4.SS4.p1.3.1" class="ltx_text">By (<a href="#S2.E3" title="Equation 3 ‣ 2.2. Multichain counts ‣ 2. Polynomial invariants and multichain counts ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>), these counts yield multichain counts</span></p>
<table id="S4.E28" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S4.E28X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equationgroup ltx_align_left">(28)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E28X.m2" class="ltx_Math" alttext="\displaystyle Z_{\textrm{M}}(2)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mtext>M</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle Z_{\textrm{M}}(2)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E28X.m3" class="ltx_Math" alttext="\displaystyle=2+c_{1}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>2</mn><mo>+</mo><msub><mi>c</mi><mn>1</mn></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=2+c_{1},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S4.E28Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E28Xa.m2" class="ltx_Math" alttext="\displaystyle Z_{\textrm{M}}(3)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mtext>M</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle Z_{\textrm{M}}(3)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E28Xa.m3" class="ltx_Math" alttext="\displaystyle=3+3c_{1}+c_{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>3</mn><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><mo>+</mo><msub><mi>c</mi><mn>2</mn></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=3+3c_{1}+c_{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S4.E28Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E28Xb.m2" class="ltx_Math" alttext="\displaystyle Z_{\textrm{M}}(4)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mtext>M</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle Z_{\textrm{M}}(4)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E28Xb.m3" class="ltx_Math" alttext="\displaystyle=4+6c_{1}+4c_{2}+c_{3}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>4</mn><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>2</mn></msub></mrow><mo>+</mo><msub><mi>c</mi><mn>3</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=4+6c_{1}+4c_{2}+c_{3}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p1.4" class="ltx_p"><span id="S4.SS4.p1.4.1" class="ltx_text">Then the defect <math id="S4.SS4.p1.m4" class="ltx_Math" alttext="D(q)" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(q)</annotation></semantics></math> can be viewed as a polynomial in <math id="S4.SS4.p1.m5" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>.
We first determine its sign for <math id="S4.SS4.p1.m6" class="ltx_Math" alttext="x\in\mathbb{R}_{&gt;0}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>&gt;</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">x\in\mathbb{R}_{&gt;0}</annotation></semantics></math>.
In each family, the leading coefficient of <math id="S4.SS4.p1.m7" class="ltx_Math" alttext="D(q)" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(q)</annotation></semantics></math> is negative and all its other
nonzero coefficients are positive. This implies that there is exactly one positive zero <math id="S4.SS4.p1.m8" class="ltx_Math" alttext="\xi" display="inline" intent=":literal"><semantics><mi>ξ</mi><annotation encoding="application/x-tex">\xi</annotation></semantics></math>, so <math id="S4.SS4.p1.m9" class="ltx_Math" alttext="D(\xi)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ξ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">D(\xi)=0</annotation></semantics></math> and</span></p>
<table id="S4.Ex175" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex175.m1" class="ltx_Math" alttext="D(x)&gt;0\quad(0&lt;x&lt;\xi),\qquad D(x)&lt;0\quad(x&gt;\xi)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mn>0</mn><mo>&lt;</mo><mi>x</mi><mo>&lt;</mo><mi>ξ</mi></mrow><mo stretchy="false">)</mo></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mn>0</mn></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>&gt;</mo><mi>ξ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">D(x)&gt;0\quad(0&lt;x&lt;\xi),\qquad D(x)&lt;0\quad(x&gt;\xi).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p1.5" class="ltx_p"><span id="S4.SS4.p1.5.1" class="ltx_text">The matroids are defined only at the allowed prime powers <math id="S4.SS4.p1.m10" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>.
Thus the threshold is the first allowed prime power greater than
<math id="S4.SS4.p1.m11" class="ltx_Math" alttext="\xi" display="inline" intent=":literal"><semantics><mi>ξ</mi><annotation encoding="application/x-tex">\xi</annotation></semantics></math>. We locate this zero between consecutive allowed prime powers
by exact evaluation, as follows.</span></p>
<ol id="S4.I7" class="ltx_enumerate">
<li id="S4.I7.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I7.i1.p1" class="ltx_para">
<p id="S4.I7.i1.p1.1" class="ltx_p">For <math id="S4.I7.i1.p1.m1" class="ltx_Math" alttext="\textrm{M}_{q}" display="inline" intent=":literal"><semantics><msub><mtext>M</mtext><mi>q</mi></msub><annotation encoding="application/x-tex">\textrm{M}_{q}</annotation></semantics></math>, use <a href="#S4.Thmthm11" title="Corollary 4.11 ‣ 4.1.1. The flag 𝑓-vector of an affine family ‣ 4.1. The affine family ‣ 4. Four families from finite geometries ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Corollary</span> <span class="ltx_text ltx_ref_tag">4.11</span></a> with <math id="S4.I7.i1.p1.m2" class="ltx_Math" alttext="m=(q^{2}+1)/2" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">m=(q^{2}+1)/2</annotation></semantics></math>.
The consecutive odd prime powers <math id="S4.I7.i1.p1.m3" class="ltx_Math" alttext="89" display="inline" intent=":literal"><semantics><mn>89</mn><annotation encoding="application/x-tex">89</annotation></semantics></math> and <math id="S4.I7.i1.p1.m4" class="ltx_Math" alttext="97" display="inline" intent=":literal"><semantics><mn>97</mn><annotation encoding="application/x-tex">97</annotation></semantics></math> satisfy</p>
<table id="S4.Ex176" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex176.m1" class="ltx_Math" alttext="D(89)&gt;0&gt;D(97),\qquad 89&lt;\xi&lt;97." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>89</mn><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn><mo>&gt;</mo><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>97</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mn>89</mn><mo>&lt;</mo><mi>ξ</mi><mo>&lt;</mo><mn>97</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">D(89)&gt;0&gt;D(97),\qquad 89&lt;\xi&lt;97.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.I7.i1.p1.2" class="ltx_p">Hence, for odd prime powers <math id="S4.I7.i1.p1.m5" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>, <math id="S4.I7.i1.p1.m6" class="ltx_Math" alttext="D(q)&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">D(q)&lt;0</annotation></semantics></math> if and only if
<math id="S4.I7.i1.p1.m7" class="ltx_Math" alttext="q\geqslant 97" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>⩾</mo><mn>97</mn></mrow><annotation encoding="application/x-tex">q\geqslant 97</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I7.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I7.i2.p1" class="ltx_para">
<p id="S4.I7.i2.p1.1" class="ltx_p">For <math id="S4.I7.i2.p1.m1" class="ltx_Math" alttext="\textrm{M}^{\mathrm{pk}}_{q}" display="inline" intent=":literal"><semantics><msubsup><mtext>M</mtext><mi>q</mi><mi>pk</mi></msubsup><annotation encoding="application/x-tex">\textrm{M}^{\mathrm{pk}}_{q}</annotation></semantics></math>, use <a href="#S4.Thmthm11" title="Corollary 4.11 ‣ 4.1.1. The flag 𝑓-vector of an affine family ‣ 4.1. The affine family ‣ 4. Four families from finite geometries ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Corollary</span> <span class="ltx_text ltx_ref_tag">4.11</span></a> with <math id="S4.I7.i2.p1.m2" class="ltx_Math" alttext="m=q^{2}+q+1" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>=</mo><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mi>q</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">m=q^{2}+q+1</annotation></semantics></math>.
The consecutive prime powers <math id="S4.I7.i2.p1.m3" class="ltx_Math" alttext="79" display="inline" intent=":literal"><semantics><mn>79</mn><annotation encoding="application/x-tex">79</annotation></semantics></math> and <math id="S4.I7.i2.p1.m4" class="ltx_Math" alttext="81=3^{4}" display="inline" intent=":literal"><semantics><mrow><mn>81</mn><mo>=</mo><msup><mn>3</mn><mn>4</mn></msup></mrow><annotation encoding="application/x-tex">81=3^{4}</annotation></semantics></math> satisfy</p>
<table id="S4.Ex177" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex177.m1" class="ltx_Math" alttext="D(79)&gt;0&gt;D(81),\qquad 79&lt;\xi&lt;81." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>79</mn><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn><mo>&gt;</mo><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>81</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mn>79</mn><mo>&lt;</mo><mi>ξ</mi><mo>&lt;</mo><mn>81</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">D(79)&gt;0&gt;D(81),\qquad 79&lt;\xi&lt;81.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.I7.i2.p1.2" class="ltx_p">Hence, for prime powers <math id="S4.I7.i2.p1.m5" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>, <math id="S4.I7.i2.p1.m6" class="ltx_Math" alttext="D(q)&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">D(q)&lt;0</annotation></semantics></math> if and only if
<math id="S4.I7.i2.p1.m7" class="ltx_Math" alttext="q\geqslant 81" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>⩾</mo><mn>81</mn></mrow><annotation encoding="application/x-tex">q\geqslant 81</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I7.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S4.I7.i3.p1" class="ltx_para">
<p id="S4.I7.i3.p1.1" class="ltx_p">For <math id="S4.I7.i3.p1.m1" class="ltx_Math" alttext="\textrm{G}_{4,q}" display="inline" intent=":literal"><semantics><msub><mtext>G</mtext><mrow><mn>4</mn><mo>,</mo><mi>q</mi></mrow></msub><annotation encoding="application/x-tex">\textrm{G}_{4,q}</annotation></semantics></math>, use the counts following <a href="#S4.Thmthm13" title="Proposition 4.13 ‣ 4.2. The Gabidulin family ‣ 4. Four families from finite geometries ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">4.13</span></a>
with <math id="S4.I7.i3.p1.m2" class="ltx_Math" alttext="n=6" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">n=6</annotation></semantics></math>, <math id="S4.I7.i3.p1.m3" class="ltx_Math" alttext="m=q^{3}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>=</mo><msup><mi>q</mi><mn>3</mn></msup></mrow><annotation encoding="application/x-tex">m=q^{3}</annotation></semantics></math>, and <math id="S4.I7.i3.p1.m4" class="ltx_Math" alttext="b=q^{9}" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><msup><mi>q</mi><mn>9</mn></msup></mrow><annotation encoding="application/x-tex">b=q^{9}</annotation></semantics></math>. Again, the consecutive prime
powers <math id="S4.I7.i3.p1.m5" class="ltx_Math" alttext="79" display="inline" intent=":literal"><semantics><mn>79</mn><annotation encoding="application/x-tex">79</annotation></semantics></math> and <math id="S4.I7.i3.p1.m6" class="ltx_Math" alttext="81" display="inline" intent=":literal"><semantics><mn>81</mn><annotation encoding="application/x-tex">81</annotation></semantics></math> satisfy</p>
<table id="S4.Ex178" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex178.m1" class="ltx_Math" alttext="D(79)&gt;0&gt;D(81),\qquad 79&lt;\xi&lt;81." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>79</mn><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn><mo>&gt;</mo><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>81</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mn>79</mn><mo>&lt;</mo><mi>ξ</mi><mo>&lt;</mo><mn>81</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">D(79)&gt;0&gt;D(81),\qquad 79&lt;\xi&lt;81.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.I7.i3.p1.2" class="ltx_p">Hence, for prime powers <math id="S4.I7.i3.p1.m7" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>, <math id="S4.I7.i3.p1.m8" class="ltx_Math" alttext="D(q)&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">D(q)&lt;0</annotation></semantics></math> if and only if
<math id="S4.I7.i3.p1.m9" class="ltx_Math" alttext="q\geqslant 81" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>⩾</mo><mn>81</mn></mrow><annotation encoding="application/x-tex">q\geqslant 81</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I7.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S4.I7.i4.p1" class="ltx_para">
<p id="S4.I7.i4.p1.1" class="ltx_p">For <math id="S4.I7.i4.p1.m1" class="ltx_Math" alttext="\textrm{C}(q,q^{3})" display="inline" intent=":literal"><semantics><mrow><mtext>C</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo>,</mo><msup><mi>q</mi><mn>3</mn></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textrm{C}(q,q^{3})</annotation></semantics></math>, count chains by their largest proper flat.
The ambient truncation has <math id="S4.I7.i4.p1.m2" class="ltx_Math" alttext="\genfrac{[}{]}{0.0pt}{1}{6}{a}_{q}\binom{q^{3}}{b}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>[</mo><mfrac linethickness="0.0pt"><mn>6</mn><mi>a</mi></mfrac><mo>]</mo></mrow><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><msup><mi>q</mi><mn>3</mn></msup><mi>b</mi></mfrac><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\genfrac{[}{]}{0.0pt}{1}{6}{a}_{q}\binom{q^{3}}{b}</annotation></semantics></math> flats of type
<math id="S4.I7.i4.p1.m3" class="ltx_Math" alttext="(a,b)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a,b)</annotation></semantics></math>, with <math id="S4.I7.i4.p1.m4" class="ltx_Math" alttext="1\leqslant a+b\leqslant 6" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>⩽</mo><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo>⩽</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">1\leqslant a+b\leqslant 6</annotation></semantics></math>, each restricting to
<math id="S4.I7.i4.p1.m5" class="ltx_Math" alttext="\textrm{P}_{a}(q)\oplus\textrm{U}_{b,b}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mtext>P</mtext><mi>a</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊕</mo><msub><mtext>U</mtext><mrow><mi>b</mi><mo>,</mo><mi>b</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\textrm{P}_{a}(q)\oplus\textrm{U}_{b,b}</annotation></semantics></math>. Repeat this count inside each restriction,
then apply <a href="#S3.Thmthm9" title="Lemma 3.9 ‣ 3.1. Hyperplane coalescence ‣ 3. Matroid operations: hyperplane coalescence, absorption ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">3.9</span></a> to the
<math id="S4.I7.i4.p1.m6" class="ltx_Math" alttext="q^{6}\binom{q^{3}}{4}" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mn>6</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><msup><mi>q</mi><mn>3</mn></msup><mn>4</mn></mfrac><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">q^{6}\binom{q^{3}}{4}</annotation></semantics></math> blocks. The consecutive prime powers <math id="S4.I7.i4.p1.m7" class="ltx_Math" alttext="139" display="inline" intent=":literal"><semantics><mn>139</mn><annotation encoding="application/x-tex">139</annotation></semantics></math> and
<math id="S4.I7.i4.p1.m8" class="ltx_Math" alttext="149" display="inline" intent=":literal"><semantics><mn>149</mn><annotation encoding="application/x-tex">149</annotation></semantics></math> satisfy</p>
<table id="S4.Ex179" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex179.m1" class="ltx_Math" alttext="D(139)&gt;0&gt;D(149),\qquad 139&lt;\xi&lt;149." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>139</mn><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn><mo>&gt;</mo><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>149</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mn>139</mn><mo>&lt;</mo><mi>ξ</mi><mo>&lt;</mo><mn>149</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">D(139)&gt;0&gt;D(149),\qquad 139&lt;\xi&lt;149.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.I7.i4.p1.2" class="ltx_p">Hence, for prime powers <math id="S4.I7.i4.p1.m9" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>, <math id="S4.I7.i4.p1.m10" class="ltx_Math" alttext="D(q)&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">D(q)&lt;0</annotation></semantics></math> if and only if
<math id="S4.I7.i4.p1.m11" class="ltx_Math" alttext="q\geqslant 149" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>⩾</mo><mn>149</mn></mrow><annotation encoding="application/x-tex">q\geqslant 149</annotation></semantics></math>.</p>
</div></li>
</ol>
<p id="S4.SS4.p1.6" class="ltx_p"><span id="S4.SS4.p1.6.1" class="ltx_text">Since <math id="S4.SS4.p1.m12" class="ltx_Math" alttext="D(q)=Z_{\textrm{M}}(3)^{2}-Z_{\textrm{M}}(2)Z_{\textrm{M}}(4)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>Z</mi><mtext>M</mtext></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>−</mo><mrow><msub><mi>Z</mi><mtext>M</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>Z</mi><mtext>M</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">D(q)=Z_{\textrm{M}}(3)^{2}-Z_{\textrm{M}}(2)Z_{\textrm{M}}(4)</annotation></semantics></math>, these are precisely
the four equivalences in the theorem. Its final assertion follows
from <a href="#Thmintrothm1" title="Theorem A ‣ 1. Introduction ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">A</span></a>.
∎</span></p>
</div>
</div>
</section>
<section id="S4.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.5. </span>Three-connected rank-<math id="S4.SS5.m1" class="ltx_Math" alttext="7" display="inline" intent=":literal"><semantics><mn>7</mn><annotation encoding="application/x-tex">7</annotation></semantics></math> counterexamples</h3>

<div id="S4.SS5.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of <a href="#Thmintrothm3" title="Theorem C ‣ 1. Introduction ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">C</span></a>.</h6>
<div id="S4.SS5.p1" class="ltx_para">
<p id="S4.SS5.p1.1" class="ltx_p"><span id="S4.SS5.p1.1.1" class="ltx_text">Let <math id="S4.SS5.p1.m1" class="ltx_Math" alttext="\textrm{X}=\textrm{M}_{q}" display="inline" intent=":literal"><semantics><mrow><mtext>X</mtext><mo>=</mo><msub><mtext>M</mtext><mi>q</mi></msub></mrow><annotation encoding="application/x-tex">\textrm{X}=\textrm{M}_{q}</annotation></semantics></math> for an odd prime power <math id="S4.SS5.p1.m2" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>, or
<math id="S4.SS5.p1.m3" class="ltx_Math" alttext="\textrm{X}=\textrm{G}_{4,q}" display="inline" intent=":literal"><semantics><mrow><mtext>X</mtext><mo>=</mo><msub><mtext>G</mtext><mrow><mn>4</mn><mo>,</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\textrm{X}=\textrm{G}_{4,q}</annotation></semantics></math> for any prime power <math id="S4.SS5.p1.m4" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>, and put</span></p>
<table id="S4.Ex180" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex180.m1" class="ltx_Math" alttext="\textrm{Y}=\mathrm{Tr}^{2}(\textrm{X}\oplus\textrm{X}\oplus\textrm{U}_{1,1})." display="block" intent=":literal"><semantics><mrow><mrow><mtext>Y</mtext><mo>=</mo><mrow><msup><mi>Tr</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>X</mtext><mo>⊕</mo><mtext>X</mtext><mo>⊕</mo><msub><mtext>U</mtext><mrow><mn>1</mn><mo>,</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\textrm{Y}=\mathrm{Tr}^{2}(\textrm{X}\oplus\textrm{X}\oplus\textrm{U}_{1,1}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS5.p1.2" class="ltx_p"><span id="S4.SS5.p1.2.1" class="ltx_text">The direct sum is simple of rank <math id="S4.SS5.p1.m5" class="ltx_Math" alttext="9" display="inline" intent=":literal"><semantics><mn>9</mn><annotation encoding="application/x-tex">9</annotation></semantics></math> and hence its truncation is connected and simple, and its rank-<math id="S4.SS5.p1.m6" class="ltx_Math" alttext="7" display="inline" intent=":literal"><semantics><mn>7</mn><annotation encoding="application/x-tex">7</annotation></semantics></math> truncation is simple by <a href="#S3.Thmthm2" title="Lemma 3.2 ‣ 3. Matroid operations: hyperplane coalescence, absorption ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">3.2</span></a>.</span></p>
</div>
<div id="S4.SS5.p2" class="ltx_para">
<p id="S4.SS5.p2.1" class="ltx_p"><span id="S4.SS5.p2.1.1" class="ltx_text">We count flags in
<math id="S4.SS5.p2.m1" class="ltx_Math" alttext="\mathcal{L}(\textrm{X})^{2}\times\mathcal{L}(\textrm{U}_{1,1})" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mtext>X</mtext><mo rspace="0.055em" stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo rspace="0.222em">×</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mtext>U</mtext><mrow><mn>1</mn><mo>,</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}(\textrm{X})^{2}\times\mathcal{L}(\textrm{U}_{1,1})</annotation></semantics></math>
by their coordinate ranks, retaining total rank sets in <math id="S4.SS5.p2.m2" class="ltx_Math" alttext="[6]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>6</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[6]</annotation></semantics></math>.
For each choice of weakly increasing coordinate ranks, the
chains in the factors are chosen independently.
Substitution in <a href="#S2.E18" title="In 2.6. Log-concavity and real-rootedness ‣ 2. Polynomial invariants and multichain counts ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eqs.</span> <span class="ltx_text ltx_ref_tag">18</span></a> and <a href="#S2.E19" title="Equation 19 ‣ 2.6. Log-concavity and real-rootedness ‣ 2. Polynomial invariants and multichain counts ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a> gives the
Chow coefficients <math id="S4.SS5.p2.m3" class="ltx_Math" alttext="\underline{\textrm{H}}_{i}(q)" display="inline" intent=":literal"><semantics><mrow><msub><munder accentunder="true"><mtext>H</mtext><mo stretchy="true">¯</mo></munder><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\underline{\textrm{H}}_{i}(q)</annotation></semantics></math> and the cubic <math id="S4.SS5.p2.m4" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>-polynomial
<math id="S4.SS5.p2.m5" class="ltx_Math" alttext="\Gamma_{q}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Γ</mi><mi>q</mi></msub><annotation encoding="application/x-tex">\Gamma_{q}</annotation></semantics></math>. Let</span></p>
<table id="S4.Ex181" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex181.m1" class="ltx_Math" alttext="R(q)=\mathrm{disc}(\Gamma_{q}),\qquad\Delta(q)=\underline{\textrm{H}}_{2}(q)^{2}-\underline{\textrm{H}}_{1}(q)\underline{\textrm{H}}_{3}(q)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>disc</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Γ</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><munder accentunder="true"><mtext>H</mtext><mo stretchy="true">¯</mo></munder><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>−</mo><mrow><msub><munder accentunder="true"><mtext>H</mtext><mo stretchy="true">¯</mo></munder><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><munder accentunder="true"><mtext>H</mtext><mo stretchy="true">¯</mo></munder><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">R(q)=\mathrm{disc}(\Gamma_{q}),\qquad\Delta(q)=\underline{\textrm{H}}_{2}(q)^{2}-\underline{\textrm{H}}_{1}(q)\underline{\textrm{H}}_{3}(q).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS5.p2.2" class="ltx_p"><span id="S4.SS5.p2.2.1" class="ltx_text">The Taylor coefficients of <math id="S4.SS5.p2.m6" class="ltx_Math" alttext="\gamma_{3}(q)" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\gamma_{3}(q)</annotation></semantics></math> at <math id="S4.SS5.p2.m7" class="ltx_Math" alttext="q_{\min}=3" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>min</mi></msub><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">q_{\min}=3</annotation></semantics></math> for
the affine family, and at <math id="S4.SS5.p2.m8" class="ltx_Math" alttext="q_{\min}=2" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>min</mi></msub><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">q_{\min}=2</annotation></semantics></math> for the Gabidulin family,
are nonnegative, with positive constant term. Hence <math id="S4.SS5.p2.m9" class="ltx_Math" alttext="\gamma_{3}(q)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>γ</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\gamma_{3}(q)&gt;0</annotation></semantics></math>
for <math id="S4.SS5.p2.m10" class="ltx_Math" alttext="q\geqslant q_{\min}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>⩾</mo><msub><mi>q</mi><mi>min</mi></msub></mrow><annotation encoding="application/x-tex">q\geqslant q_{\min}</annotation></semantics></math>, and <a href="#S2.Thmthm15" title="Lemma 2.15 ‣ 2.6. Log-concavity and real-rootedness ‣ 2. Polynomial invariants and multichain counts ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">2.15</span></a> implies that</span></p>
<table id="S4.Ex182" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S4.Ex182X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex182X.m2" class="ltx_Math" alttext="\displaystyle\underline{\textrm{H}}(\textrm{Y};t)\text{ is not real-rooted}" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mtext>H</mtext><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mtext>Y</mtext><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext> is not real-rooted</mtext></mrow><annotation encoding="application/x-tex">\displaystyle\underline{\textrm{H}}(\textrm{Y};t)\text{ is not real-rooted}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex182X.m3" class="ltx_Math" alttext="\displaystyle\Longleftrightarrow\quad R(q)&lt;0," display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⟺</mo><mi>R</mi><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo><mo>&lt;</mo><mn>0</mn><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Longleftrightarrow\quad R(q)&lt;0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex182Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex182Xa.m2" class="ltx_Math" alttext="\displaystyle\underline{\textrm{H}}(\textrm{Y};t)\text{ is not log-concave}" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mtext>H</mtext><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mtext>Y</mtext><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext> is not log-concave</mtext></mrow><annotation encoding="application/x-tex">\displaystyle\underline{\textrm{H}}(\textrm{Y};t)\text{ is not log-concave}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex182Xa.m3" class="ltx_Math" alttext="\displaystyle\Longleftrightarrow\quad\Delta(q)&lt;0." display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⟺</mo><mi mathvariant="normal">Δ</mi><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo><mo>&lt;</mo><mn>0</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Longleftrightarrow\quad\Delta(q)&lt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.SS5.p3" class="ltx_para">
<p id="S4.SS5.p3.1" class="ltx_p"><span id="S4.SS5.p3.1.1" class="ltx_text">We first determine the signs of <math id="S4.SS5.p3.m1" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> and <math id="S4.SS5.p3.m2" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>
for real arguments <math id="S4.SS5.p3.m3" class="ltx_Math" alttext="x\geqslant q_{\min}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>⩾</mo><msub><mi>q</mi><mi>min</mi></msub></mrow><annotation encoding="application/x-tex">x\geqslant q_{\min}</annotation></semantics></math>. For either <math id="S4.SS5.p3.m4" class="ltx_Math" alttext="D=R" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>=</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">D=R</annotation></semantics></math> or <math id="S4.SS5.p3.m5" class="ltx_Math" alttext="D=\Delta" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>=</mo><mi mathvariant="normal">Δ</mi></mrow><annotation encoding="application/x-tex">D=\Delta</annotation></semantics></math>, the polynomial <math id="S4.SS5.p3.m6" class="ltx_Math" alttext="D(q_{\min}+x)" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>q</mi><mi>min</mi></msub><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(q_{\min}+x)</annotation></semantics></math> has one sign variation,
a positive constant term, and a negative leading coefficient.
Descartes’ rule therefore implies that <math id="S4.SS5.p3.m7" class="ltx_Math" alttext="D(q)" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(q)</annotation></semantics></math> has exactly one zero
<math id="S4.SS5.p3.m8" class="ltx_Math" alttext="\xi_{D}&gt;q_{\min}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ξ</mi><mi>D</mi></msub><mo>&gt;</mo><msub><mi>q</mi><mi>min</mi></msub></mrow><annotation encoding="application/x-tex">\xi_{D}&gt;q_{\min}</annotation></semantics></math>, with</span></p>
<table id="S4.Ex183" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex183.m1" class="ltx_math_unparsed" alttext="D(\xi_{D})=0,\qquad D(x)&gt;0\quad(q_{\min}\leqslant x&lt;\xi_{D}),\qquad D(x)&lt;0\quad(x&gt;\xi_{D})." display="block" intent=":literal"><semantics><mrow><mi>D</mi><mrow><mo stretchy="false">(</mo><msub><mi>ξ</mi><mi>D</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mn>0</mn><mo rspace="2.167em">,</mo><mi>D</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>&gt;</mo><mn>0</mn><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>min</mi></msub><mo>⩽</mo><mi>x</mi><mo>&lt;</mo><msub><mi>ξ</mi><mi>D</mi></msub><mo stretchy="false">)</mo></mrow><mo rspace="2.167em">,</mo><mi>D</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>&lt;</mo><mn>0</mn><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>&gt;</mo><msub><mi>ξ</mi><mi>D</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">D(\xi_{D})=0,\qquad D(x)&gt;0\quad(q_{\min}\leqslant x&lt;\xi_{D}),\qquad D(x)&lt;0\quad(x&gt;\xi_{D}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS5.p3.2" class="ltx_p"><span id="S4.SS5.p3.2.1" class="ltx_text">Thus <math id="S4.SS5.p3.m9" class="ltx_Math" alttext="\xi_{R}" display="inline" intent=":literal"><semantics><msub><mi>ξ</mi><mi>R</mi></msub><annotation encoding="application/x-tex">\xi_{R}</annotation></semantics></math> and <math id="S4.SS5.p3.m10" class="ltx_Math" alttext="\xi_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi>ξ</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">\xi_{\Delta}</annotation></semantics></math> indicate where the discriminant and
the log-concavity defect, respectively, change sign as <math id="S4.SS5.p3.m11" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> varies.
We locate these zeros between consecutive
allowed prime powers by computer computations.</span></p>
</div>
<div id="S4.SS5.p4" class="ltx_para">
<ol id="S4.I8" class="ltx_enumerate">
<li id="S4.I8.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I8.i1.p1" class="ltx_para">
<p id="S4.I8.i1.p1.1" class="ltx_p">For <math id="S4.I8.i1.p1.m1" class="ltx_Math" alttext="\textrm{X}=\textrm{M}_{q}" display="inline" intent=":literal"><semantics><mrow><mtext>X</mtext><mo>=</mo><msub><mtext>M</mtext><mi>q</mi></msub></mrow><annotation encoding="application/x-tex">\textrm{X}=\textrm{M}_{q}</annotation></semantics></math>, use <a href="#S4.Thmthm11" title="Corollary 4.11 ‣ 4.1.1. The flag 𝑓-vector of an affine family ‣ 4.1. The affine family ‣ 4. Four families from finite geometries ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Corollary</span> <span class="ltx_text ltx_ref_tag">4.11</span></a>
with <math id="S4.I8.i1.p1.m2" class="ltx_Math" alttext="m=(q^{2}+1)/2" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>q</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">m=(q^{2}+1)/2</annotation></semantics></math>. The consecutive odd prime powers <math id="S4.I8.i1.p1.m3" class="ltx_Math" alttext="43,47" display="inline" intent=":literal"><semantics><mrow><mn>43</mn><mo>,</mo><mn>47</mn></mrow><annotation encoding="application/x-tex">43,47</annotation></semantics></math>
and <math id="S4.I8.i1.p1.m4" class="ltx_Math" alttext="89,97" display="inline" intent=":literal"><semantics><mrow><mn>89</mn><mo>,</mo><mn>97</mn></mrow><annotation encoding="application/x-tex">89,97</annotation></semantics></math> satisfy</p>
<table id="S4.Ex184" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S4.Ex184X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex184X.m2" class="ltx_Math" alttext="\displaystyle R(43)" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>43</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle R(43)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex184X.m3" class="ltx_Math" alttext="\displaystyle&gt;0&gt;R(47)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>&gt;</mo><mn>0</mn><mo>&gt;</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>47</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle&gt;0&gt;R(47),</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex184X.m5" class="ltx_Math" alttext="\displaystyle 43" display="inline" intent=":literal"><semantics><mn>43</mn><annotation encoding="application/x-tex">\displaystyle 43</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex184X.m6" class="ltx_Math" alttext="\displaystyle&lt;\xi_{R}&lt;47," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>&lt;</mo><msub><mi>ξ</mi><mi>R</mi></msub><mo>&lt;</mo><mn>47</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle&lt;\xi_{R}&lt;47,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex184Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex184Xa.m2" class="ltx_Math" alttext="\displaystyle\Delta(89)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>89</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Delta(89)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex184Xa.m3" class="ltx_Math" alttext="\displaystyle&gt;0&gt;\Delta(97)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>&gt;</mo><mn>0</mn><mo>&gt;</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>97</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle&gt;0&gt;\Delta(97),</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex184Xa.m5" class="ltx_Math" alttext="\displaystyle 89" display="inline" intent=":literal"><semantics><mn>89</mn><annotation encoding="application/x-tex">\displaystyle 89</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex184Xa.m6" class="ltx_Math" alttext="\displaystyle&lt;\xi_{\Delta}&lt;97." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>&lt;</mo><msub><mi>ξ</mi><mi mathvariant="normal">Δ</mi></msub><mo>&lt;</mo><mn>97</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle&lt;\xi_{\Delta}&lt;97.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.I8.i1.p1.2" class="ltx_p">Hence, for odd prime powers <math id="S4.I8.i1.p1.m5" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>, <math id="S4.I8.i1.p1.m6" class="ltx_Math" alttext="R(q)&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">R(q)&lt;0</annotation></semantics></math> if and only if
<math id="S4.I8.i1.p1.m7" class="ltx_Math" alttext="q\geqslant 47" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>⩾</mo><mn>47</mn></mrow><annotation encoding="application/x-tex">q\geqslant 47</annotation></semantics></math>, and <math id="S4.I8.i1.p1.m8" class="ltx_Math" alttext="\Delta(q)&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta(q)&lt;0</annotation></semantics></math> if and only if <math id="S4.I8.i1.p1.m9" class="ltx_Math" alttext="q\geqslant 97" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>⩾</mo><mn>97</mn></mrow><annotation encoding="application/x-tex">q\geqslant 97</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I8.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I8.i2.p1" class="ltx_para">
<p id="S4.I8.i2.p1.1" class="ltx_p">For <math id="S4.I8.i2.p1.m1" class="ltx_Math" alttext="\textrm{X}=\textrm{G}_{4,q}" display="inline" intent=":literal"><semantics><mrow><mtext>X</mtext><mo>=</mo><msub><mtext>G</mtext><mrow><mn>4</mn><mo>,</mo><mi>q</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\textrm{X}=\textrm{G}_{4,q}</annotation></semantics></math>, use the counts following
<a href="#S4.Thmthm13" title="Proposition 4.13 ‣ 4.2. The Gabidulin family ‣ 4. Four families from finite geometries ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">4.13</span></a> with <math id="S4.I8.i2.p1.m2" class="ltx_Math" alttext="n=6" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">n=6</annotation></semantics></math>, <math id="S4.I8.i2.p1.m3" class="ltx_Math" alttext="m=q^{3}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>=</mo><msup><mi>q</mi><mn>3</mn></msup></mrow><annotation encoding="application/x-tex">m=q^{3}</annotation></semantics></math>, and <math id="S4.I8.i2.p1.m4" class="ltx_Math" alttext="b=q^{9}" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><msup><mi>q</mi><mn>9</mn></msup></mrow><annotation encoding="application/x-tex">b=q^{9}</annotation></semantics></math>.
The consecutive prime powers <math id="S4.I8.i2.p1.m5" class="ltx_Math" alttext="32=2^{5},37" display="inline" intent=":literal"><semantics><mrow><mrow><mn>32</mn><mo>=</mo><msup><mn>2</mn><mn>5</mn></msup></mrow><mo>,</mo><mn>37</mn></mrow><annotation encoding="application/x-tex">32=2^{5},37</annotation></semantics></math> and <math id="S4.I8.i2.p1.m6" class="ltx_Math" alttext="79,81=3^{4}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>79</mn><mo>,</mo><mn>81</mn></mrow><mo>=</mo><msup><mn>3</mn><mn>4</mn></msup></mrow><annotation encoding="application/x-tex">79,81=3^{4}</annotation></semantics></math> satisfy</p>
<table id="S4.Ex185" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S4.Ex185X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex185X.m2" class="ltx_Math" alttext="\displaystyle R(32)" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>32</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle R(32)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex185X.m3" class="ltx_Math" alttext="\displaystyle&gt;0&gt;R(37)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>&gt;</mo><mn>0</mn><mo>&gt;</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>37</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle&gt;0&gt;R(37),</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex185X.m5" class="ltx_Math" alttext="\displaystyle 32" display="inline" intent=":literal"><semantics><mn>32</mn><annotation encoding="application/x-tex">\displaystyle 32</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex185X.m6" class="ltx_Math" alttext="\displaystyle&lt;\xi_{R}&lt;37," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>&lt;</mo><msub><mi>ξ</mi><mi>R</mi></msub><mo>&lt;</mo><mn>37</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle&lt;\xi_{R}&lt;37,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex185Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex185Xa.m2" class="ltx_Math" alttext="\displaystyle\Delta(79)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>79</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Delta(79)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex185Xa.m3" class="ltx_Math" alttext="\displaystyle&gt;0&gt;\Delta(81)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>&gt;</mo><mn>0</mn><mo>&gt;</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>81</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle&gt;0&gt;\Delta(81),</annotation></semantics></math></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex185Xa.m5" class="ltx_Math" alttext="\displaystyle 79" display="inline" intent=":literal"><semantics><mn>79</mn><annotation encoding="application/x-tex">\displaystyle 79</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex185Xa.m6" class="ltx_Math" alttext="\displaystyle&lt;\xi_{\Delta}&lt;81." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>&lt;</mo><msub><mi>ξ</mi><mi mathvariant="normal">Δ</mi></msub><mo>&lt;</mo><mn>81</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle&lt;\xi_{\Delta}&lt;81.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.I8.i2.p1.2" class="ltx_p">Hence, for prime powers <math id="S4.I8.i2.p1.m7" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>, <math id="S4.I8.i2.p1.m8" class="ltx_Math" alttext="R(q)&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">R(q)&lt;0</annotation></semantics></math> if and only if
<math id="S4.I8.i2.p1.m9" class="ltx_Math" alttext="q\geqslant 37" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>⩾</mo><mn>37</mn></mrow><annotation encoding="application/x-tex">q\geqslant 37</annotation></semantics></math>, and <math id="S4.I8.i2.p1.m10" class="ltx_Math" alttext="\Delta(q)&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta(q)&lt;0</annotation></semantics></math> if and only if <math id="S4.I8.i2.p1.m11" class="ltx_Math" alttext="q\geqslant 81" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>⩾</mo><mn>81</mn></mrow><annotation encoding="application/x-tex">q\geqslant 81</annotation></semantics></math>.</p>
</div></li>
</ol>
<p id="S4.SS5.p4.1" class="ltx_p"><span id="S4.SS5.p4.1.1" class="ltx_text">By the two criteria above, these are the desired
real-rootedness and log-concavity thresholds.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="S5" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">5. </span><math id="S5.m1" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math>-polynomials of graph associahedra are not log-concave</h2>

<div id="S5.p1" class="ltx_para">
<p id="S5.p1.1" class="ltx_p">In this section we construct a family of rooted graphs whose multichain counts fail log-concavity. These graphs consist of a long path, connected to a long periodic ladder via some sparse bridges. See Figure <a href="#S5.F5" title="Figure 5 ‣ 5.1. The graphs ‣ 5. ℎ-polynomials of graph associahedra are not log-concave ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> for a schematic picture of these graphs. The path and the ladder offer two competing ways to go across the graph, which ultimately leads to a failure of log-concavity of the rooted multichain counts.</p>
</div>
<div id="S5.p2" class="ltx_para">
<p id="S5.p2.1" class="ltx_p">We first define the graphs and explain how their chain counts are computed
exactly. We then give the counting heuristic which motivated the design.
The exact counterexample in Section <a href="#S5.SS4" title="5.4. A counterexample ‣ 5. ℎ-polynomials of graph associahedra are not log-concave ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.4</span></a> is independent of
this heuristic.</p>
</div>
<div id="S5.p3" class="ltx_para">
<p id="S5.p3.1" class="ltx_p">The failure of log-concavity is transferred to the <math id="S5.p3.m1" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math>-polynomial via Theorem <a href="#S2.Thmthm14" title="Theorem 2.14 (graph zeta amplification) ‣ 2.5.4. An explicit amplification certificate ‣ 2.5. Face enumerations of graph associahedra ‣ 2. Polynomial invariants and multichain counts ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.14</span></a>.</p>
</div>
<section id="S5.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.1. </span>The graphs</h3>

<div id="S5.Thmthm1" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmthm1.2" class="ltx_text ltx_font_bold">Definition 5.1</span></span><span id="S5.Thmthm1.3" class="ltx_text ltx_font_bold"> </span>(Path and ladder)</h6>
<div id="S5.Thmthm1.p1" class="ltx_para">
<p id="S5.Thmthm1.p1.1" class="ltx_p">Fix a word <math id="S5.Thmthm1.p1.m1" class="ltx_math_unparsed" alttext="w=w_{0}\cdots w_{L-1}" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>=</mo><mi>w</mi><msub><mrow></mrow><mn>0</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>w</mi><msub><mrow></mrow><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">w=w_{0}\cdots w_{L-1}</annotation></semantics></math> in the letters
<math id="S5.Thmthm1.p1.m2" class="ltx_Math" alttext="\mathrm{I},\mathrm{O},\mathrm{N}" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo>,</mo><mi>O</mi><mo>,</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">\mathrm{I},\mathrm{O},\mathrm{N}</annotation></semantics></math>, a bridge pattern
<math id="S5.Thmthm1.p1.m3" class="ltx_Math" alttext="\beta=(\beta_{0},\ldots,\beta_{L-1})\in\{-1,0,1,2,3\}^{L}" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>β</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>β</mi><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>3</mn></mrow><mo stretchy="false">}</mo></mrow><mi>L</mi></msup></mrow><annotation encoding="application/x-tex">\beta=(\beta_{0},\ldots,\beta_{L-1})\in\{-1,0,1,2,3\}^{L}</annotation></semantics></math>, and an integer
<math id="S5.Thmthm1.p1.m4" class="ltx_Math" alttext="R\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">R\geq 1</annotation></semantics></math>. The graph contains <math id="S5.Thmthm1.p1.m5" class="ltx_Math" alttext="LR" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">LR</annotation></semantics></math> layers, indexed by <math id="S5.Thmthm1.p1.m6" class="ltx_Math" alttext="0\leqslant i&lt;LR" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>⩽</mo><mi>i</mi><mo>&lt;</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mrow><annotation encoding="application/x-tex">0\leqslant i&lt;LR</annotation></semantics></math>, with
<math id="S5.Thmthm1.p1.m7" class="ltx_Math" alttext="b_{i}=\beta_{i\bmod L}" display="inline" intent=":literal"><semantics><mrow><msub><mi>b</mi><mi>i</mi></msub><mo>=</mo><msub><mi>β</mi><mrow><mi>i</mi><mo>mod</mo><mi>L</mi></mrow></msub></mrow><annotation encoding="application/x-tex">b_{i}=\beta_{i\bmod L}</annotation></semantics></math>.</p>
<ol id="S5.I1" class="ltx_enumerate">
<li id="S5.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S5.I1.i1.p1" class="ltx_para">
<p id="S5.I1.i1.p1.1" class="ltx_p">Each layer contains vertices <math id="S5.I1.i1.p1.m1" class="ltx_Math" alttext="a_{i},c_{i},c_{i}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>i</mi></msub><mo>,</mo><msub><mi>c</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>c</mi><mi>i</mi><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">a_{i},c_{i},c_{i}^{\prime}</annotation></semantics></math> and the edge <math id="S5.I1.i1.p1.m2" class="ltx_Math" alttext="c_{i}c_{i}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>c</mi><mi>i</mi><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">c_{i}c_{i}^{\prime}</annotation></semantics></math>.
If <math id="S5.I1.i1.p1.m3" class="ltx_Math" alttext="b_{i}=-1" display="inline" intent=":literal"><semantics><mrow><msub><mi>b</mi><mi>i</mi></msub><mo>=</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">b_{i}=-1</annotation></semantics></math>, there are no further edges within this layer.
If <math id="S5.I1.i1.p1.m4" class="ltx_Math" alttext="b_{i}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>b</mi><mi>i</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">b_{i}=0</annotation></semantics></math>, add <math id="S5.I1.i1.p1.m5" class="ltx_Math" alttext="a_{i}c_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">a_{i}c_{i}</annotation></semantics></math> and <math id="S5.I1.i1.p1.m6" class="ltx_Math" alttext="a_{i}c_{i}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>c</mi><mi>i</mi><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">a_{i}c_{i}^{\prime}</annotation></semantics></math>.
If <math id="S5.I1.i1.p1.m7" class="ltx_Math" alttext="b_{i}\geq 1" display="inline" intent=":literal"><semantics><mrow><msub><mi>b</mi><mi>i</mi></msub><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">b_{i}\geq 1</annotation></semantics></math>, add <math id="S5.I1.i1.p1.m8" class="ltx_Math" alttext="b_{i}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mi>i</mi></msub><annotation encoding="application/x-tex">b_{i}</annotation></semantics></math> new vertices to the layer, denoted <math id="S5.I1.i1.p1.m9" class="ltx_Math" alttext="s_{i,1},\ldots,s_{i,b_{i}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><msub><mi>b</mi><mi>i</mi></msub></mrow></msub></mrow><annotation encoding="application/x-tex">s_{i,1},\ldots,s_{i,b_{i}}</annotation></semantics></math>, together with the path
<math id="S5.I1.i1.p1.m10" class="ltx_math_unparsed" alttext="a_{i}s_{i,1}\cdots s_{i,b_{i}}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><msub><mrow></mrow><mi>i</mi></msub><mi>s</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>s</mi><msub><mrow></mrow><mrow><mi>i</mi><mo>,</mo><msub><mi>b</mi><mi>i</mi></msub></mrow></msub></mrow><annotation encoding="application/x-tex">a_{i}s_{i,1}\cdots s_{i,b_{i}}</annotation></semantics></math>, and join <math id="S5.I1.i1.p1.m11" class="ltx_Math" alttext="s_{i,b_{i}}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><msub><mi>b</mi><mi>i</mi></msub></mrow></msub><annotation encoding="application/x-tex">s_{i,b_{i}}</annotation></semantics></math> to both <math id="S5.I1.i1.p1.m12" class="ltx_Math" alttext="c_{i}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mi>i</mi></msub><annotation encoding="application/x-tex">c_{i}</annotation></semantics></math> and
<math id="S5.I1.i1.p1.m13" class="ltx_Math" alttext="c_{i}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>c</mi><mi>i</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">c_{i}^{\prime}</annotation></semantics></math>. We call this a bridge with <math id="S5.I1.i1.p1.m14" class="ltx_Math" alttext="b_{i}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mi>i</mi></msub><annotation encoding="application/x-tex">b_{i}</annotation></semantics></math> additional vertices.</p>
</div></li>
<li id="S5.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S5.I1.i2.p1" class="ltx_para">
<p id="S5.I1.i2.p1.1" class="ltx_p">Consecutive layers <math id="S5.I1.i2.p1.m1" class="ltx_Math" alttext="i-1,i" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>i</mi></mrow><annotation encoding="application/x-tex">i-1,i</annotation></semantics></math> are joined by <math id="S5.I1.i2.p1.m2" class="ltx_Math" alttext="a_{i-1}a_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">a_{i-1}a_{i}</annotation></semantics></math> and by
ladder edges prescribed by <math id="S5.I1.i2.p1.m3" class="ltx_Math" alttext="w_{(i-1)\bmod L}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>mod</mo><mi>L</mi></mrow></msub><annotation encoding="application/x-tex">w_{(i-1)\bmod L}</annotation></semantics></math>:</p>
<table id="S5.Ex186" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex186.m1" class="ltx_Math" alttext="\begin{array}[]{c|l}\mathrm{I}&amp;c_{i-1}c_{i},\ c_{i-1}^{\prime}c_{i}\\
\mathrm{O}&amp;c_{i-1}^{\prime}c_{i},\ c_{i-1}^{\prime}c_{i}^{\prime}\\
\mathrm{N}&amp;\text{all four edges between }\{c_{i-1},c_{i-1}^{\prime}\}\text{ and }\{c_{i},c_{i}^{\prime}\}.\end{array}" display="block" intent=":literal"><semantics><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_border_r"><mi>I</mi></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi>c</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi>i</mi></msub></mrow><mo rspace="0.667em">,</mo><mrow><msubsup><mi>c</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi>i</mi></msub></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_border_r"><mi>O</mi></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msubsup><mi>c</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi>i</mi></msub></mrow><mo rspace="0.667em">,</mo><mrow><msubsup><mi>c</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>c</mi><mi>i</mi><mo>′</mo></msubsup></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_border_r"><mi>N</mi></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>all four edges between </mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><msub><mi>c</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msubsup><mi>c</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo>′</mo></msubsup><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext> and </mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><msub><mi>c</mi><mi>i</mi></msub><mo>,</mo><msubsup><mi>c</mi><mi>i</mi><mo>′</mo></msubsup><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{array}[]{c|l}\mathrm{I}&amp;c_{i-1}c_{i},\ c_{i-1}^{\prime}c_{i}\\
\mathrm{O}&amp;c_{i-1}^{\prime}c_{i},\ c_{i-1}^{\prime}c_{i}^{\prime}\\
\mathrm{N}&amp;\text{all four edges between }\{c_{i-1},c_{i-1}^{\prime}\}\text{ and }\{c_{i},c_{i}^{\prime}\}.\end{array}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.I1.i2.p1.2" class="ltx_p">See Figure <a href="#S5.F4" title="Figure 4 ‣ 5.1. The graphs ‣ 5. ℎ-polynomials of graph associahedra are not log-concave ‣ Chow and chain polynomials of matroids are not log-concave" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>.</p>
</div></li>
<li id="S5.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S5.I1.i3.p1" class="ltx_para">
<p id="S5.I1.i3.p1.1" class="ltx_p">A root <math id="S5.I1.i3.p1.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> is joined to <math id="S5.I1.i3.p1.m2" class="ltx_Math" alttext="a_{0},c_{0},c_{0}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mn>0</mn></msub><mo>,</mo><msub><mi>c</mi><mn>0</mn></msub><mo>,</mo><msubsup><mi>c</mi><mn>0</mn><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">a_{0},c_{0},c_{0}^{\prime}</annotation></semantics></math>. Optionally, choose <math id="S5.I1.i3.p1.m3" class="ltx_Math" alttext="\ell\geq 0" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\ell\geq 0</annotation></semantics></math>, join a new vertex <math id="S5.I1.i3.p1.m4" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> to
<math id="S5.I1.i3.p1.m5" class="ltx_Math" alttext="a_{LR-1},c_{LR-1},c_{LR-1}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>c</mi><mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msubsup><mi>c</mi><mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">a_{LR-1},c_{LR-1},c_{LR-1}^{\prime}</annotation></semantics></math>, and attach a path
<math id="S5.I1.i3.p1.m6" class="ltx_math_unparsed" alttext="ru_{1}\cdots u_{\ell}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mi>u</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>u</mi><msub><mrow></mrow><mi mathvariant="normal">ℓ</mi></msub></mrow><annotation encoding="application/x-tex">ru_{1}\cdots u_{\ell}</annotation></semantics></math>. The resulting rooted graph is denoted
<math id="S5.I1.i3.p1.m7" class="ltx_Math" alttext="X(w,\beta;R,\ell)" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mi>β</mi><mo>,</mo><mi>R</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">X(w,\beta;R,\ell)</annotation></semantics></math>. Without this optional attachment, <math id="S5.I1.i3.p1.m8" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> is absent.
The resulting rooted graph is denoted <math id="S5.I1.i3.p1.m9" class="ltx_Math" alttext="X(w,\beta;R,\ell)" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mi>β</mi><mo>,</mo><mi>R</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">X(w,\beta;R,\ell)</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
</div>
<div id="S5.SS1.p1" class="ltx_para">
<p id="S5.SS1.p1.1" class="ltx_p">A period contains</p>
<table id="S5.Ex187" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex187.m1" class="ltx_Math" alttext="n_{\mathrm{per}}=3L+\sum_{r=0}^{L-1}\max(\beta_{r},0)" display="block" intent=":literal"><semantics><mrow><msub><mi>n</mi><mi>per</mi></msub><mo>=</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo rspace="0.055em">+</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>β</mi><mi>r</mi></msub><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">n_{\mathrm{per}}=3L+\sum_{r=0}^{L-1}\max(\beta_{r},0)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS1.p1.2" class="ltx_p">vertices. Thus the graph has <math id="S5.SS1.p1.m1" class="ltx_Math" alttext="Rn_{\mathrm{per}}+1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mi>per</mi></msub></mrow><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">Rn_{\mathrm{per}}+1</annotation></semantics></math> vertices without the
attachment, and <math id="S5.SS1.p1.m2" class="ltx_Math" alttext="Rn_{\mathrm{per}}+2+\ell" display="inline" intent=":literal"><semantics><mrow><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mi>per</mi></msub></mrow><mo>+</mo><mn>2</mn><mo>+</mo><mi mathvariant="normal">ℓ</mi></mrow><annotation encoding="application/x-tex">Rn_{\mathrm{per}}+2+\ell</annotation></semantics></math> with it. All these graphs are
connected, since each of the two tracks is connected to <math id="S5.SS1.p1.m3" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>.</p>
</div>
