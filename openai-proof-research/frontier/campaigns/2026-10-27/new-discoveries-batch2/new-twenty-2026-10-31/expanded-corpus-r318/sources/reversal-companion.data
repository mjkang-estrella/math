ize:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="5.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.F6.pic2.m15" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 113.2 -86.11 L 97.54 -109.59"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="round" transform="matrix(-0.5547 -0.83205 0.83205 -0.5547 97.54 -109.59)"><path d="M 1.11 0 C -0.28 0.28 -1.66 0.83 -3.32 1.8 C -1.66 0.55 -1.66 -0.55 -3.32 -1.8 C -1.66 -0.83 -0.28 -0.28 1.11 0 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000" stroke-width="0.8pt"><path d="M 100.17 -157.48 C 100.17 -152.9 96.45 -149.18 91.86 -149.18 C 87.28 -149.18 83.56 -152.9 83.56 -157.48 C 83.56 -162.07 87.28 -165.78 91.86 -165.78 C 96.45 -165.78 100.17 -162.07 100.17 -157.48 Z M 91.86 -157.48"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 88.4 -161.41)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.57em;--ltx-fo-depth:0em;font-size:10pt;" height="7.86" overflow="visible" transform="matrix(1 0 0 -1 0 7.86)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.F6.pic2.m16" class="ltx_Math" alttext="\bar{c}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>c</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{c}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 91.86 -126.97 L 91.86 -147.24"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="round" transform="matrix(0.0 -1.0 1.0 0.0 91.86 -147.24)"><path d="M 1.11 0 C -0.28 0.28 -1.66 0.83 -3.32 1.8 C -1.66 0.55 -1.66 -0.55 -3.32 -1.8 C -1.66 -0.83 -0.28 -0.28 1.11 0 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000" stroke-width="0.8pt"><path d="M 152.66 -118.11 C 152.66 -113.53 148.94 -109.81 144.36 -109.81 C 139.77 -109.81 136.05 -113.53 136.05 -118.11 C 136.05 -122.7 139.77 -126.41 144.36 -126.41 C 148.94 -126.41 152.66 -122.7 152.66 -118.11 Z M 144.36 -118.11"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 141.36 -121.09)"><foreignObject style="--ltx-fo-width:0.43em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="5.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.F6.pic2.m17" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 123.02 -86.11 L 138.68 -109.59"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="round" transform="matrix(0.5547 -0.83205 0.83205 0.5547 138.68 -109.59)"><path d="M 1.11 0 C -0.28 0.28 -1.66 0.83 -3.32 1.8 C -1.66 0.55 -1.66 -0.55 -3.32 -1.8 C -1.66 -0.83 -0.28 -0.28 1.11 0 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000" stroke-width="0.8pt"><path d="M 132.97 -157.48 C 132.97 -152.9 129.26 -149.18 124.67 -149.18 C 120.09 -149.18 116.37 -152.9 116.37 -157.48 C 116.37 -162.07 120.09 -165.78 124.67 -165.78 C 129.26 -165.78 132.97 -162.07 132.97 -157.48 Z M 124.67 -157.48"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 121.68 -160.46)"><foreignObject style="--ltx-fo-width:0.43em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="5.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.F6.pic2.m18" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 140.4 -126.03 L 129.25 -148.32"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="round" transform="matrix(-0.44722 -0.89442 0.89442 -0.44722 129.25 -148.32)"><path d="M 1.11 0 C -0.28 0.28 -1.66 0.83 -3.32 1.8 C -1.66 0.55 -1.66 -0.55 -3.32 -1.8 C -1.66 -0.83 -0.28 -0.28 1.11 0 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#000000" stroke-width="0.8pt"><path d="M 172.34 -157.48 C 172.34 -152.9 168.63 -149.18 164.04 -149.18 C 159.46 -149.18 155.74 -152.9 155.74 -157.48 C 155.74 -162.07 159.46 -165.78 164.04 -165.78 C 168.63 -165.78 172.34 -162.07 172.34 -157.48 Z M 164.04 -157.48"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 161.05 -160.46)"><foreignObject style="--ltx-fo-width:0.43em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="5.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.F6.pic2.m19" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 148.32 -126.03 L 159.46 -148.32"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="round" transform="matrix(0.44722 -0.89442 0.89442 0.44722 159.46 -148.32)"><path d="M 1.11 0 C -0.28 0.28 -1.66 0.83 -3.32 1.8 C -1.66 0.55 -1.66 -0.55 -3.32 -1.8 C -1.66 -0.83 -0.28 -0.28 1.11 0 Z"></path></g></g></g></svg></span></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 6: </span>Two particular subtrees <math id="S2.F6.m4" class="ltx_Math" alttext="L_{4}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mn>4</mn></msub><annotation encoding="application/x-tex">L_{4}</annotation></semantics></math> and <math id="S2.F6.m5" class="ltx_Math" alttext="R_{4}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mn>4</mn></msub><annotation encoding="application/x-tex">R_{4}</annotation></semantics></math> occurring in the numeration tree of base <math id="S2.F6.m6" class="ltx_Math" alttext="3/2" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">3/2</annotation></semantics></math>.</figcaption>
</figure>
<div id="S2.SS2.SSS0.Px4.p9" class="ltx_para">
<p id="S2.SS2.SSS0.Px4.p9.1" class="ltx_p"><span id="S2.SS2.SSS0.Px4.p9.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
</section>
</section>
<section id="S3" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">3 </span>Frequencies of letters in <math id="S3.m1" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math></h2>

<div id="S3.p1" class="ltx_para">
<p id="S3.p1.1" class="ltx_p">Rather than studying global frequencies directly, we analyze filtered frequencies along residue classes modulo powers of <math id="S3.p1.m1" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>.
This refinement captures the intrinsic dyadic structure of <math id="S3.p1.m2" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> and naturally leads to a formulation on the <math id="S3.p1.m3" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-adic integers <math id="S3.p1.m4" class="ltx_Math" alttext="\mathbb{Z}_{2}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\mathbb{Z}_{2}</annotation></semantics></math>.
In this compact group setting, desubstitution translates into recurrence relations on Fourier coefficients, allowing us to exploit harmonic analysis to obtain a rigidity result.</p>
</div>
<div id="S3.p2" class="ltx_para">
<p id="S3.p2.1" class="ltx_p">We filter the counting of occurrences of a symbol <math id="S3.p2.m1" class="ltx_Math" alttext="c\in\{{\tt 0},{\tt 1}\}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>𝟶</mn><mo>,</mo><mn>𝟷</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">c\in\{{\tt 0},{\tt 1}\}</annotation></semantics></math> in <math id="S3.p2.m2" class="ltx_Math" alttext="\mathbf{t}_{3/2}=(t_{n})_{n\geq 0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbf{t}_{3/2}=(t_{n})_{n\geq 0}</annotation></semantics></math> with respect to some index modulo a power of <math id="S3.p2.m3" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>. For integers <math id="S3.p2.m4" class="ltx_Math" alttext="n,N\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo>,</mo><mi>N</mi></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n,N\geq 0</annotation></semantics></math>, <math id="S3.p2.m5" class="ltx_Math" alttext="c\in\{{\tt 0},{\tt 1}\}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>𝟶</mn><mo>,</mo><mn>𝟷</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">c\in\{{\tt 0},{\tt 1}\}</annotation></semantics></math>, and <math id="S3.p2.m6" class="ltx_Math" alttext="k\in\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">k\in\mathbb{Z}</annotation></semantics></math>, we let</p>
<table id="S3.Ex60" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex60.m1" class="ltx_math_unparsed" alttext="C_{n}(c,k,N):=\#\bigl\{0\leq i&lt;N:t_{i}=c,\,i\equiv k\bmod 2^{n}\bigr\}," display="block" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>N</mi><mo stretchy="false">)</mo></mrow><mo>:=</mo><mi>#</mi><mrow><mo stretchy="false">{</mo><mn>0</mn><mo>≤</mo><mi>i</mi><mo>&lt;</mo><mi>N</mi><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi>t</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo rspace="0.337em">,</mo><mi>i</mi><mo>≡</mo><mi>k</mi><mo>mod</mo><msup><mn>2</mn><mi>n</mi></msup><mo stretchy="false">}</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">C_{n}(c,k,N):=\#\bigl\{0\leq i&lt;N:t_{i}=c,\,i\equiv k\bmod 2^{n}\bigr\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p2.2" class="ltx_p">so <math id="S3.p2.m7" class="ltx_Math" alttext="C_{n}(c,k,N)" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{n}(c,k,N)</annotation></semantics></math> gives the number of <math id="S3.p2.m8" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math>’s in the prefix <math id="S3.p2.m9" class="ltx_math_unparsed" alttext="\mathbf{t}_{3/2}[0,N)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{t}_{3/2}[0,N)</annotation></semantics></math> that are in positions congruent to <math id="S3.p2.m10" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> modulo <math id="S3.p2.m11" class="ltx_Math" alttext="2^{n}" display="inline" intent=":literal"><semantics><msup><mn>2</mn><mi>n</mi></msup><annotation encoding="application/x-tex">2^{n}</annotation></semantics></math>.
As an example, looking back at the length-<math id="S3.p2.m12" class="ltx_Math" alttext="30" display="inline" intent=":literal"><semantics><mn>30</mn><annotation encoding="application/x-tex">30</annotation></semantics></math> prefix of <math id="S3.p2.m13" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> in <a href="#S1.E1" title="In 1 Introduction ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">1</span></a>, the <math id="S3.p2.m14" class="ltx_Math" alttext="11" display="inline" intent=":literal"><semantics><mn>11</mn><annotation encoding="application/x-tex">11</annotation></semantics></math> positions of <math id="S3.p2.m15" class="ltx_Math" alttext="{\tt 0}" display="inline" intent=":literal"><semantics><mn>𝟶</mn><annotation encoding="application/x-tex">{\tt 0}</annotation></semantics></math>’s in this prefix are <math id="S3.p2.m16" class="ltx_Math" alttext="0,1,5,11,14,20,21,22,23,26,29" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>5</mn><mo>,</mo><mn>11</mn><mo>,</mo><mn>14</mn><mo>,</mo><mn>20</mn><mo>,</mo><mn>21</mn><mo>,</mo><mn>22</mn><mo>,</mo><mn>23</mn><mo>,</mo><mn>26</mn><mo>,</mo><mn>29</mn></mrow><annotation encoding="application/x-tex">0,1,5,11,14,20,21,22,23,26,29</annotation></semantics></math>, so we obtain <math id="S3.p2.m17" class="ltx_Math" alttext="(C_{1}({\tt 0},k,30))_{0\leq k&lt;2^{1}}=(5,6)" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>C</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟶</mn><mo>,</mo><mi>k</mi><mo>,</mo><mn>30</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>0</mn><mo>≤</mo><mi>k</mi><mo>&lt;</mo><msup><mn>2</mn><mn>1</mn></msup></mrow></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>5</mn><mo>,</mo><mn>6</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(C_{1}({\tt 0},k,30))_{0\leq k&lt;2^{1}}=(5,6)</annotation></semantics></math> and <math id="S3.p2.m18" class="ltx_Math" alttext="(C_{2}({\tt 0},k,30)_{0\leq k&lt;2^{2}}=(2,4,3,2)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>C</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mn>𝟶</mn><mo>,</mo><mi>k</mi><mo>,</mo><mn>30</mn><mo stretchy="false">)</mo></mrow><mrow><mn>0</mn><mo>≤</mo><mi>k</mi><mo>&lt;</mo><msup><mn>2</mn><mn>2</mn></msup></mrow></msub></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow><annotation encoding="application/x-tex">(C_{2}({\tt 0},k,30)_{0\leq k&lt;2^{2}}=(2,4,3,2)</annotation></semantics></math>.
To avoid making notation heavier by requiring the use of integer parts, we will allow the third argument of <math id="S3.p2.m19" class="ltx_Math" alttext="C_{n}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>n</mi></msub><annotation encoding="application/x-tex">C_{n}</annotation></semantics></math> to take real values. This will not affect the convergences under consideration, as, for <math id="S3.p2.m20" class="ltx_Math" alttext="\alpha\in\mathbb{R}_{\geq 0}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\alpha\in\mathbb{R}_{\geq 0}</annotation></semantics></math>, both differences <math id="S3.p2.m21" class="ltx_Math" alttext="C_{n}(c,k,\lceil\alpha\rceil)-C_{n}(c,k,\alpha)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>k</mi><mo>,</mo><mrow><mo stretchy="false">⌈</mo><mi>α</mi><mo stretchy="false">⌉</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>C</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C_{n}(c,k,\lceil\alpha\rceil)-C_{n}(c,k,\alpha)</annotation></semantics></math> and <math id="S3.p2.m22" class="ltx_Math" alttext="C_{n}(c,k,\alpha)-C_{n}(c,k,\lfloor\alpha\rfloor)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>C</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>k</mi><mo>,</mo><mrow><mo stretchy="false">⌊</mo><mi>α</mi><mo stretchy="false">⌋</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C_{n}(c,k,\alpha)-C_{n}(c,k,\lfloor\alpha\rfloor)</annotation></semantics></math> belong to <math id="S3.p2.m23" class="ltx_Math" alttext="\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{0,1\}</annotation></semantics></math>.</p>
</div>
<div id="Thmtheorem18" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem18.2" class="ltx_text ltx_font_bold">Theorem 18</span></span><span id="Thmtheorem18.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem18.p1" class="ltx_para">
<p id="Thmtheorem18.p1.1" class="ltx_p"><span id="Thmtheorem18.p1.1.1" class="ltx_text ltx_font_italic">For all <math id="Thmtheorem18.p1.m1" class="ltx_Math" alttext="n\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n\geq 0</annotation></semantics></math>, <math id="Thmtheorem18.p1.m2" class="ltx_Math" alttext="c\in\{{\tt 0},{\tt 1}\}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>𝟶</mn><mo>,</mo><mn>𝟷</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">c\in\{{\tt 0},{\tt 1}\}</annotation></semantics></math>, and <math id="Thmtheorem18.p1.m3" class="ltx_Math" alttext="k\in\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">k\in\mathbb{Z}</annotation></semantics></math>, we have</span></p>
<table id="S3.Ex61" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex61.m1" class="ltx_Math" alttext="\lim_{N\to\infty}\frac{C_{n}(c,k,N)}{N}=\frac{1}{2^{n+1}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>N</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mfrac><mrow><msub><mi>C</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><mi>N</mi></mfrac></mrow><mo>=</mo><mfrac><mn>1</mn><msup><mn>2</mn><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msup></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lim_{N\to\infty}\frac{C_{n}(c,k,N)}{N}=\frac{1}{2^{n+1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem18.p1.2" class="ltx_p"><span id="Thmtheorem18.p1.2.1" class="ltx_text ltx_font_italic">In particular, the frequency of <math id="Thmtheorem18.p1.m4" class="ltx_Math" alttext="{\tt 0}" display="inline" intent=":literal"><semantics><mn>𝟶</mn><annotation encoding="application/x-tex">{\tt 0}</annotation></semantics></math> (resp., <math id="Thmtheorem18.p1.m5" class="ltx_Math" alttext="{\tt 1}" display="inline" intent=":literal"><semantics><mn>𝟷</mn><annotation encoding="application/x-tex">{\tt 1}</annotation></semantics></math>) in <math id="Thmtheorem18.p1.m6" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> exists and is equal to <math id="Thmtheorem18.p1.m7" class="ltx_Math" alttext="1/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">1/2</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.p3" class="ltx_para">
<p id="S3.p3.1" class="ltx_p">It will be convenient to introduce some scaling factor <math id="S3.p3.m1" class="ltx_Math" alttext="2/3" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo>/</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">2/3</annotation></semantics></math> coming from a desubstitution process: applying <math id="S3.p3.m2" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> given in (<a href="#S1.E5" title="Equation 5 ‣ Definition 3 (Our sequence of interest). ‣ 1.3 The base 3/2 and the corresponding Thue–Morse word ‣ 1 Introduction ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>) to a prefix of <math id="S3.p3.m3" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> of length <math id="S3.p3.m4" class="ltx_Math" alttext="2n" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">2n</annotation></semantics></math> yields a word of length <math id="S3.p3.m5" class="ltx_Math" alttext="3n" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">3n</annotation></semantics></math> and conversely, a prefix of length <math id="S3.p3.m6" class="ltx_Math" alttext="\ell=3n" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><annotation encoding="application/x-tex">\ell=3n</annotation></semantics></math> comes from a prefix of length <math id="S3.p3.m7" class="ltx_Math" alttext="2\ell/3=2n" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>/</mo><mn>3</mn></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><annotation encoding="application/x-tex">2\ell/3=2n</annotation></semantics></math>. So a <span id="S3.p3.1.1" class="ltx_text ltx_font_italic">desubstitution</span> of <math id="S3.p3.m8" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> is a decomposition of <math id="S3.p3.m9" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> into consecutive length-<math id="S3.p3.m10" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math> factors, each equal to the image under <math id="S3.p3.m11" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> of a length-<math id="S3.p3.m12" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> factor. See <a href="#S3.F7" title="In Proof. ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Fig.</span> <span class="ltx_text ltx_ref_tag">7</span></a> below for an illustration.
Note that, as <math id="S3.p3.m13" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> tends to infinity, <math id="S3.p3.m14" class="ltx_Math" alttext="C_{n}(c,k,N)/N" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">C_{n}(c,k,N)/N</annotation></semantics></math> converges if and only if</p>
<table id="S3.Ex62" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex62.m1" class="ltx_Math" alttext="\frac{C_{n}\left(c,k,\left(2/3\right)^{n}N\right)}{\left(2/3\right)^{n}N}" display="block" intent=":literal"><semantics><mfrac><mrow><msub><mi>C</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>c</mi><mo>,</mo><mi>k</mi><mo>,</mo><mrow><msup><mrow><mo>(</mo><mrow><mn>2</mn><mo>/</mo><mn>3</mn></mrow><mo>)</mo></mrow><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>)</mo></mrow></mrow><mrow><msup><mrow><mo>(</mo><mrow><mn>2</mn><mo>/</mo><mn>3</mn></mrow><mo>)</mo></mrow><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mfrac><annotation encoding="application/x-tex">\frac{C_{n}\left(c,k,\left(2/3\right)^{n}N\right)}{\left(2/3\right)^{n}N}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p3.2" class="ltx_p">converges. In that case, the two sequences converge to the same limit.</p>
</div>
<div id="S3.p4" class="ltx_para">
<p id="S3.p4.1" class="ltx_p"><span id="S3.p4.1.1" class="ltx_text ltx_font_italic">Sketch of the proof of <a href="#Thmtheorem18" title="Theorem 18. ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">18</span></a>.</span> The proof is structured as follows. We argue by contradiction and assume that for some <math id="S3.p4.m1" class="ltx_Math" alttext="n\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n\geq 0</annotation></semantics></math>, <math id="S3.p4.m2" class="ltx_Math" alttext="c\in\{{\tt 0},{\tt 1}\}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>𝟶</mn><mo>,</mo><mn>𝟷</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">c\in\{{\tt 0},{\tt 1}\}</annotation></semantics></math>, <math id="S3.p4.m3" class="ltx_Math" alttext="k\in\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">k\in\mathbb{Z}</annotation></semantics></math> and <math id="S3.p4.m4" class="ltx_Math" alttext="\varepsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\varepsilon&gt;0</annotation></semantics></math>, there exists an infinite set <math id="S3.p4.m5" class="ltx_Math" alttext="\Lambda\subseteq\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo>⊆</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">\Lambda\subseteq\mathbb{N}</annotation></semantics></math> such that, for every <math id="S3.p4.m6" class="ltx_Math" alttext="N\in\Lambda" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>∈</mo><mi mathvariant="normal">Λ</mi></mrow><annotation encoding="application/x-tex">N\in\Lambda</annotation></semantics></math>,</p>
<table id="S3.Ex63" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex63.m1" class="ltx_Math" alttext="\left|\frac{C_{n}(c,k,\left(2/3\right)^{n}N)}{\left(2/3\right)^{n}N}-\frac{1}{2^{n+1}}\right|&gt;\varepsilon." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><mfrac><mrow><msub><mi>C</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>k</mi><mo>,</mo><mrow><msup><mrow><mo>(</mo><mrow><mn>2</mn><mo>/</mo><mn>3</mn></mrow><mo>)</mo></mrow><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msup><mrow><mo>(</mo><mrow><mn>2</mn><mo>/</mo><mn>3</mn></mrow><mo>)</mo></mrow><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mfrac><mo>−</mo><mfrac><mn>1</mn><msup><mn>2</mn><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msup></mfrac></mrow><mo>|</mo></mrow><mo>&gt;</mo><mi>ε</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|\frac{C_{n}(c,k,\left(2/3\right)^{n}N)}{\left(2/3\right)^{n}N}-\frac{1}{2^{n+1}}\right|&gt;\varepsilon.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p4.2" class="ltx_p">The we have the following two arguments to obtain a contradiction.</p>
<ol id="S3.I1" class="ltx_enumerate">
<li id="S3.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="S3.I1.i1.p1" class="ltx_para">
<p id="S3.I1.i1.p1.1" class="ltx_p"><a href="#Thmtheorem19" title="Lemma 19. ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">19</span></a> enables us to extract an increasing sequence <math id="S3.I1.i1.p1.m1" class="ltx_Math" alttext="(N_{t})_{t\geq 0}\in\Lambda^{\mathbb{N}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><msub><mi>N</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow></msub><mo>∈</mo><msup><mi mathvariant="normal">Λ</mi><mi>ℕ</mi></msup></mrow><annotation encoding="application/x-tex">(N_{t})_{t\geq 0}\in\Lambda^{\mathbb{N}}</annotation></semantics></math> for which the following limits exist, for all <math id="S3.I1.i1.p1.m2" class="ltx_Math" alttext="n,c,k" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>,</mo><mi>c</mi><mo>,</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">n,c,k</annotation></semantics></math>,</p>
<table id="S3.Ex64" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex64.m1" class="ltx_Math" alttext="\lim_{t\to\infty}\frac{C_{n}(c,k,\left(2/3\right)^{n}N_{t})}{\left(2/3\right)^{n}N_{t}}=\mu_{n}(c,k)" display="block" intent=":literal"><semantics><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mfrac><mrow><msub><mi>C</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>k</mi><mo>,</mo><mrow><msup><mrow><mo>(</mo><mrow><mn>2</mn><mo>/</mo><mn>3</mn></mrow><mo>)</mo></mrow><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msup><mrow><mo>(</mo><mrow><mn>2</mn><mo>/</mo><mn>3</mn></mrow><mo>)</mo></mrow><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mi>t</mi></msub></mrow></mfrac></mrow><mo>=</mo><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lim_{t\to\infty}\frac{C_{n}(c,k,\left(2/3\right)^{n}N_{t})}{\left(2/3\right)^{n}N_{t}}=\mu_{n}(c,k)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I1.i1.p1.2" class="ltx_p">and we obtain recurrence relations linking the <math id="S3.I1.i1.p1.m3" class="ltx_Math" alttext="\mu_{n}(c,k)" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu_{n}(c,k)</annotation></semantics></math>’s together.</p>
</div></li>
<li id="S3.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="S3.I1.i2.p1" class="ltx_para">
<p id="S3.I1.i2.p1.1" class="ltx_p"><a href="#Thmtheorem20" title="Proposition 20. ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">20</span></a> shows that such recurrence relations imply that the limit <math id="S3.I1.i2.p1.m1" class="ltx_Math" alttext="\mu_{n}(c,k)" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu_{n}(c,k)</annotation></semantics></math> equals <math id="S3.I1.i2.p1.m2" class="ltx_Math" alttext="2^{-n-1}" display="inline" intent=":literal"><semantics><msup><mn>2</mn><mrow><mrow><mo>−</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">2^{-n-1}</annotation></semantics></math>, producing the sought contradiction.</p>
</div></li>
</ol>
<p id="S3.p4.3" class="ltx_p">The proof of <a href="#Thmtheorem19" title="Lemma 19. ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">19</span></a> comes directly after its statement; that of <a href="#Thmtheorem20" title="Proposition 20. ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">20</span></a> is delayed until <a href="#S3.SS2" title="3.2 Proof of ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">3.2</span></a> as more development is required before in <a href="#S3.SS1" title="3.1 Some abstract harmonic analysis ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">3.1</span></a>.</p>
</div>
<div id="S3.p5" class="ltx_para">
<p id="S3.p5.1" class="ltx_p">We now focus on <a href="#Thmtheorem19" title="Lemma 19. ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">19</span></a>.
As we will see, the recurrence relations (<a href="#S3.E10" title="Equation 10 ‣ Item 3. ‣ Lemma 19. ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>) depend on the word <math id="S3.p5.m1" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math>. They essentially come from the desubstitution process.</p>
</div>
<div id="Thmtheorem19" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem19.2" class="ltx_text ltx_font_bold">Lemma 19</span></span><span id="Thmtheorem19.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem19.p1" class="ltx_para">
<p id="Thmtheorem19.p1.1" class="ltx_p"><span id="Thmtheorem19.p1.1.1" class="ltx_text ltx_font_italic">For any infinite set <math id="Thmtheorem19.p1.m1" class="ltx_Math" alttext="\Lambda\subseteq\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo>⊆</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">\Lambda\subseteq\mathbb{N}</annotation></semantics></math>, there exists an increasing sequence <math id="Thmtheorem19.p1.m2" class="ltx_Math" alttext="(N_{t})_{t\geq 0}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>N</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">(N_{t})_{t\geq 0}</annotation></semantics></math> in <math id="Thmtheorem19.p1.m3" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> such that, for all <math id="Thmtheorem19.p1.m4" class="ltx_Math" alttext="n\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n\geq 0</annotation></semantics></math>, <math id="Thmtheorem19.p1.m5" class="ltx_Math" alttext="c\in\{{\tt 0},{\tt 1}\}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>𝟶</mn><mo>,</mo><mn>𝟷</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">c\in\{{\tt 0},{\tt 1}\}</annotation></semantics></math> and <math id="Thmtheorem19.p1.m6" class="ltx_Math" alttext="k\in\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">k\in\mathbb{Z}</annotation></semantics></math>, the following four properties are satisfied.</span></p>
<ol id="S3.I2" class="ltx_enumerate">
<li id="S3.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="S3.I2.i1.p1" class="ltx_para">
<p id="S3.I2.i1.p1.1" class="ltx_p"><span id="S3.I2.i1.p1.1.1" class="ltx_text ltx_font_italic">The limit</span></p>
<table id="S3.Ex65" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex65.m1" class="ltx_Math" alttext="\mu_{n}(c,k)=\lim_{t\to\infty}\frac{C_{n}\left(c,k,\left(2/3\right)^{n}N_{t}\right)}{\left(2/3\right)^{n}N_{t}}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>t</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mfrac><mrow><msub><mi>C</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>c</mi><mo>,</mo><mi>k</mi><mo>,</mo><mrow><msup><mrow><mo>(</mo><mrow><mn>2</mn><mo>/</mo><mn>3</mn></mrow><mo>)</mo></mrow><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mi>t</mi></msub></mrow><mo>)</mo></mrow></mrow><mrow><msup><mrow><mo>(</mo><mrow><mn>2</mn><mo>/</mo><mn>3</mn></mrow><mo>)</mo></mrow><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mi>t</mi></msub></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">\mu_{n}(c,k)=\lim_{t\to\infty}\frac{C_{n}\left(c,k,\left(2/3\right)^{n}N_{t}\right)}{\left(2/3\right)^{n}N_{t}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I2.i1.p1.2" class="ltx_p"><span id="S3.I2.i1.p1.2.1" class="ltx_text ltx_font_italic">exists.</span></p>
</div></li>
<li id="S3.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="S3.I2.i2.p1" class="ltx_para">
<p id="S3.I2.i2.p1.1" class="ltx_p"><span id="S3.I2.i2.p1.1.1" class="ltx_text ltx_font_italic">We have </span><math id="S3.I2.i2.p1.m1" class="ltx_Math" alttext="\mu_{n}(c,k+2^{n})=\mu_{n}(c,k)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mrow><mi>k</mi><mo>+</mo><msup><mn>2</mn><mi>n</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu_{n}(c,k+2^{n})=\mu_{n}(c,k)</annotation></semantics></math><span id="S3.I2.i2.p1.1.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S3.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="S3.I2.i3.p1" class="ltx_para">
<p id="S3.I2.i3.p1.1" class="ltx_p"><span id="S3.I2.i3.p1.1.1" class="ltx_text ltx_font_italic">Let </span><math id="S3.I2.i3.p1.m1" class="ltx_Math" alttext="q_{n}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mi>n</mi></msub><annotation encoding="application/x-tex">q_{n}</annotation></semantics></math><span id="S3.I2.i3.p1.1.2" class="ltx_text ltx_font_italic"> be the inverse of </span><math id="S3.I2.i3.p1.m2" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math><span id="S3.I2.i3.p1.1.3" class="ltx_text ltx_font_italic"> modulo </span><math id="S3.I2.i3.p1.m3" class="ltx_Math" alttext="2^{n+1}" display="inline" intent=":literal"><semantics><msup><mn>2</mn><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">2^{n+1}</annotation></semantics></math><span id="S3.I2.i3.p1.1.4" class="ltx_text ltx_font_italic">, i.e., </span><math id="S3.I2.i3.p1.m4" class="ltx_Math" alttext="3q_{n}=1\pmod{2^{n+1}}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>n</mi></msub></mrow><mo>=</mo><mrow><mn>1</mn><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0.167em">mod</mo><msup><mn>2</mn><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">3q_{n}=1\pmod{2^{n+1}}</annotation></semantics></math><span id="S3.I2.i3.p1.1.5" class="ltx_text ltx_font_italic">.
Then,</span></p>
<table id="S3.E10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(10)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E10.m1" class="ltx_Math" alttext="\tfrac{3}{2}\mu_{n}(c,k)=\mu_{n+1}(c,2q_{n}k)+\mu_{n+1}(\bar{c},2q_{n}k-q_{n})+\mu_{n+1}(c,2q_{n}k-2q_{n})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="false"><mfrac><mn>3</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>μ</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>μ</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>c</mi><mo>¯</mo></mover><mo>,</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>−</mo><msub><mi>q</mi><mi>n</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>μ</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>n</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tfrac{3}{2}\mu_{n}(c,k)=\mu_{n+1}(c,2q_{n}k)+\mu_{n+1}(\bar{c},2q_{n}k-q_{n})+\mu_{n+1}(c,2q_{n}k-2q_{n}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S3.I2.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">4.</span> 
<div id="S3.I2.i4.p1" class="ltx_para">
<p id="S3.I2.i4.p1.1" class="ltx_p"><span id="S3.I2.i4.p1.1.1" class="ltx_text ltx_font_italic">We have </span><math id="S3.I2.i4.p1.m1" class="ltx_Math" alttext="\mu_{n}({\tt 0},k)+\mu_{n}({\tt 1},k)=2^{-n}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟶</mn><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟷</mn><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><msup><mn>2</mn><mrow><mo>−</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mu_{n}({\tt 0},k)+\mu_{n}({\tt 1},k)=2^{-n}</annotation></semantics></math><span id="S3.I2.i4.p1.1.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.p6" class="ltx_para">
<p id="S3.p6.1" class="ltx_p"><span id="S3.p6.1.1" class="ltx_text">The first item follows from a classical compactness argument. Observe that the set of triplets</span></p>
<table id="S3.Ex66" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex66.m1" class="ltx_math_unparsed" alttext="T=\{(n,c,k)\mid n\in\mathbb{N},c\in\{{\tt 0},{\tt 1}\},k\in\{0,\ldots,2^{n}-1\}\}" display="block" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>c</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>n</mi><mo>∈</mo><mi>ℕ</mi><mo>,</mo><mi>c</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>𝟶</mn><mo>,</mo><mn>𝟷</mn><mo stretchy="false">}</mo></mrow><mo>,</mo><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mn>2</mn><mi>n</mi></msup><mo>−</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">T=\{(n,c,k)\mid n\in\mathbb{N},c\in\{{\tt 0},{\tt 1}\},k\in\{0,\ldots,2^{n}-1\}\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p6.2" class="ltx_p"><span id="S3.p6.2.1" class="ltx_text">is countable, so we may enumerate the triplets in <math id="S3.p6.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>, i.e.,</span></p>
<table id="S3.Ex67" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex67.m1" class="ltx_Math" alttext="T=\{(n_{0},c_{0},k_{0}),(n_{1},c_{1},k_{1}),(n_{2},c_{2},k_{2}),\ldots\}." display="block" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo stretchy="false">(</mo><msub><mi>n</mi><mn>0</mn></msub><mo>,</mo><msub><mi>c</mi><mn>0</mn></msub><mo>,</mo><msub><mi>k</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><msub><mi>n</mi><mn>1</mn></msub><mo>,</mo><msub><mi>c</mi><mn>1</mn></msub><mo>,</mo><msub><mi>k</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><msub><mi>n</mi><mn>2</mn></msub><mo>,</mo><msub><mi>c</mi><mn>2</mn></msub><mo>,</mo><msub><mi>k</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mi mathvariant="normal">…</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">T=\{(n_{0},c_{0},k_{0}),(n_{1},c_{1},k_{1}),(n_{2},c_{2},k_{2}),\ldots\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p6.3" class="ltx_p"><span id="S3.p6.3.1" class="ltx_text">For all integers <math id="S3.p6.m2" class="ltx_Math" alttext="j\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">j\geq 0</annotation></semantics></math> and <math id="S3.p6.m3" class="ltx_Math" alttext="N\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">N\geq 1</annotation></semantics></math>, the proportion</span></p>
<table id="S3.Ex68" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex68.m1" class="ltx_Math" alttext="a_{j}(N):=\frac{C_{n_{j}}\left(c_{j},k_{j},\left(2/3\right)^{n_{j}}N\right)}{\left(2/3\right)^{n_{j}}N}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>a</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mfrac><mrow><msub><mi>C</mi><msub><mi>n</mi><mi>j</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>c</mi><mi>j</mi></msub><mo>,</mo><msub><mi>k</mi><mi>j</mi></msub><mo>,</mo><mrow><msup><mrow><mo>(</mo><mrow><mn>2</mn><mo>/</mo><mn>3</mn></mrow><mo>)</mo></mrow><msub><mi>n</mi><mi>j</mi></msub></msup><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>)</mo></mrow></mrow><mrow><msup><mrow><mo>(</mo><mrow><mn>2</mn><mo>/</mo><mn>3</mn></mrow><mo>)</mo></mrow><msub><mi>n</mi><mi>j</mi></msub></msup><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mfrac></mrow><annotation encoding="application/x-tex">a_{j}(N):=\frac{C_{n_{j}}\left(c_{j},k_{j},\left(2/3\right)^{n_{j}}N\right)}{\left(2/3\right)^{n_{j}}N}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p6.4" class="ltx_p"><span id="S3.p6.4.1" class="ltx_text">belongs to <math id="S3.p6.m4" class="ltx_Math" alttext="[0,1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,1]</annotation></semantics></math>, so it is bounded.
Now let us inductively define a sequence <math id="S3.p6.m5" class="ltx_Math" alttext="(A_{j})_{j\geq 0}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>≥</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">(A_{j})_{j\geq 0}</annotation></semantics></math> of infinite subsets of <math id="S3.p6.m6" class="ltx_Math" alttext="\mathbb{N}" display="inline" intent=":literal"><semantics><mi>ℕ</mi><annotation encoding="application/x-tex">\mathbb{N}</annotation></semantics></math> with <math id="S3.p6.m7" class="ltx_Math" alttext="A_{0}=\Lambda" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mn>0</mn></msub><mo>=</mo><mi mathvariant="normal">Λ</mi></mrow><annotation encoding="application/x-tex">A_{0}=\Lambda</annotation></semantics></math> and, if <math id="S3.p6.m8" class="ltx_Math" alttext="A_{j-1}\subset\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>⊂</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">A_{j-1}\subset\mathbb{N}</annotation></semantics></math> is an infinite subset of <math id="S3.p6.m9" class="ltx_Math" alttext="\mathbb{N}" display="inline" intent=":literal"><semantics><mi>ℕ</mi><annotation encoding="application/x-tex">\mathbb{N}</annotation></semantics></math> that is already built, then <math id="S3.p6.m10" class="ltx_Math" alttext="A_{j}\subset A_{j-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mi>j</mi></msub><mo>⊂</mo><msub><mi>A</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">A_{j}\subset A_{j-1}</annotation></semantics></math> is an infinite set chosen such that the sequence <math id="S3.p6.m11" class="ltx_Math" alttext="(a_{j}(N))_{N\geq 0}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>a</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>≥</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">(a_{j}(N))_{N\geq 0}</annotation></semantics></math> converges along <math id="S3.p6.m12" class="ltx_Math" alttext="A_{j}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>j</mi></msub><annotation encoding="application/x-tex">A_{j}</annotation></semantics></math>.
It exists by the theorem of Bolzano–Weierstrass: any bounded sequence in <math id="S3.p6.m13" class="ltx_Math" alttext="[0,1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,1]</annotation></semantics></math> admits a converging subsequence.
We obtain a sequence of nested infinite subsets</span></p>
<table id="S3.EGx10" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(11)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E11.m1" class="ltx_Math" alttext="\displaystyle\Lambda=A_{0}\supset A_{1}\supset A_{2}\supset\cdots" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo>=</mo><msub><mi>A</mi><mn>0</mn></msub><mo>⊃</mo><msub><mi>A</mi><mn>1</mn></msub><mo>⊃</mo><msub><mi>A</mi><mn>2</mn></msub><mo rspace="0.1389em">⊃</mo><mo lspace="0.1389em">⋯</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Lambda=A_{0}\supset A_{1}\supset A_{2}\supset\cdots</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p6.5" class="ltx_p"><span id="S3.p6.5.1" class="ltx_text">such that, for each <math id="S3.p6.m14" class="ltx_Math" alttext="j\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">j\geq 0</annotation></semantics></math>, the first <math id="S3.p6.m15" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> sequences <math id="S3.p6.m16" class="ltx_Math" alttext="(a_{1}(N))_{N\geq 0}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>a</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>≥</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">(a_{1}(N))_{N\geq 0}</annotation></semantics></math>, …, <math id="S3.p6.m17" class="ltx_Math" alttext="(a_{j}(N))_{N\geq 0}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>a</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>≥</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">(a_{j}(N))_{N\geq 0}</annotation></semantics></math> all converge along <math id="S3.p6.m18" class="ltx_Math" alttext="A_{j}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>j</mi></msub><annotation encoding="application/x-tex">A_{j}</annotation></semantics></math>.
Now we use a diagonal argument: for each integer <math id="S3.p6.m19" class="ltx_Math" alttext="t\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">t\in\mathbb{N}</annotation></semantics></math>, define <math id="S3.p6.m20" class="ltx_Math" alttext="N_{t}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>t</mi></msub><annotation encoding="application/x-tex">N_{t}</annotation></semantics></math> to be the <math id="S3.p6.m21" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>-th element of <math id="S3.p6.m22" class="ltx_Math" alttext="A_{t}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>t</mi></msub><annotation encoding="application/x-tex">A_{t}</annotation></semantics></math> (in increasing order).
Now fix any integer <math id="S3.p6.m23" class="ltx_Math" alttext="j\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">j\geq 0</annotation></semantics></math>.
Since <math id="S3.p6.m24" class="ltx_Math" alttext="A_{t}\subset A_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mi>t</mi></msub><mo>⊂</mo><msub><mi>A</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">A_{t}\subset A_{j}</annotation></semantics></math> for all <math id="S3.p6.m25" class="ltx_Math" alttext="t\geq j" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">t\geq j</annotation></semantics></math> by <a href="#S3.E11" title="In Proof. ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">11</span></a>, each integer <math id="S3.p6.m26" class="ltx_Math" alttext="N_{t}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>t</mi></msub><annotation encoding="application/x-tex">N_{t}</annotation></semantics></math> belongs to <math id="S3.p6.m27" class="ltx_Math" alttext="A_{j}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>j</mi></msub><annotation encoding="application/x-tex">A_{j}</annotation></semantics></math> for each <math id="S3.p6.m28" class="ltx_Math" alttext="t\geq j" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">t\geq j</annotation></semantics></math>.
Therefore, by the property satisfied by the set <math id="S3.p6.m29" class="ltx_Math" alttext="A_{j}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>j</mi></msub><annotation encoding="application/x-tex">A_{j}</annotation></semantics></math>, the sequence <math id="S3.p6.m30" class="ltx_Math" alttext="(a_{j}(N_{t}))_{t\geq 0}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi>a</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>N</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">(a_{j}(N_{t}))_{t\geq 0}</annotation></semantics></math> converges (when <math id="S3.p6.m31" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> tends to infinity), since it is eventually equal to a subsequence of the converging sequence along <math id="S3.p6.m32" class="ltx_Math" alttext="A_{j}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>j</mi></msub><annotation encoding="application/x-tex">A_{j}</annotation></semantics></math>.
Since <math id="S3.p6.m33" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> is arbitrarily fixed, any triplet <math id="S3.p6.m34" class="ltx_Math" alttext="(n,c,k)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>c</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n,c,k)</annotation></semantics></math> in <math id="S3.p6.m35" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> corresponds to a converging sequence along <math id="S3.p6.m36" class="ltx_Math" alttext="(N_{t})_{t\geq 0}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>N</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">(N_{t})_{t\geq 0}</annotation></semantics></math>.
The limit <math id="S3.p6.m37" class="ltx_Math" alttext="\mu_{n}(c,k)" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu_{n}(c,k)</annotation></semantics></math> thus exists.</span></p>
</div>
<div id="S3.p7" class="ltx_para">
<p id="S3.p7.1" class="ltx_p"><span id="S3.p7.1.1" class="ltx_text">The second item follows from the fact that <math id="S3.p7.m1" class="ltx_Math" alttext="C_{n}(c,k+2^{n},N)=C_{n}(c,k,N)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mrow><mi>k</mi><mo>+</mo><msup><mn>2</mn><mi>n</mi></msup></mrow><mo>,</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>C</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C_{n}(c,k+2^{n},N)=C_{n}(c,k,N)</annotation></semantics></math> by its very definition.</span></p>
</div>
<div id="S3.p8" class="ltx_para">
<p id="S3.p8.1" class="ltx_p"><span id="S3.p8.1.1" class="ltx_text">The third item essentially comes from desubstituting <math id="S3.p8.m1" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> as shown in <a href="#S3.F7" title="In Proof. ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Fig.</span> <span class="ltx_text ltx_ref_tag">7</span></a>.</span></p>
</div>
<figure id="S3.F7" class="ltx_figure"><span class="ltx_inline-block"><svg id="S3.F7.pic1" class="ltx_picture ltx_centering" height="140.05" overflow="visible" version="1.1" viewBox="0 0 458.9 140.05" width="458.9"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,140.05) matrix(1 0 0 -1 0 0) translate(35.71,0) translate(0,89.71)"><path style="fill:none" d="M -35.43 0 M -35.43 0 L -35.43 19.69 L 314.96 19.69 L 314.96 0 Z M 314.96 19.69"></path><path style="fill:none" d="M -11.81 0 M -11.81 0 L -11.81 19.69 L 11.81 19.69 L 11.81 0 Z M 11.81 19.69"></path><path style="fill:none" d="M -11.81 0 M -11.81 0 L -11.81 19.69 L 35.43 19.69 L 35.43 0 Z M 35.43 19.69"></path><path style="fill:none" d="M 35.43 0 M 35.43 0 L 35.43 19.69 L 157.48 19.69 L 157.48 0 Z M 157.48 19.69"></path><path style="fill:none" d="M -35.43 -39.37 M -35.43 -39.37 L -35.43 -59.06 L 393.7 -59.06 L 393.7 -39.37 Z M 393.7 -59.06"></path><path style="fill:none" d="M -35.43 -39.37 M -35.43 -39.37 L -35.43 -59.06 L -3.94 -59.06 L -3.94 -39.37 Z M -3.94 -59.06"></path><path style="fill:none" d="M -35.43 -39.37 M -35.43 -39.37 L -35.43 -59.06 L 27.56 -59.06 L 27.56 -39.37 Z M 27.56 -59.06"></path><path style="fill:none" d="M -35.43 -39.37 M -35.43 -39.37 L -35.43 -59.06 L 59.06 -59.06 L 59.06 -39.37 Z M 59.06 -59.06"></path><path style="fill:none" d="M 59.06 -39.37 M 59.06 -39.37 L 59.06 -59.06 L 259.84 -59.06 L 259.84 -39.37 Z M 259.84 -59.06"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -29.06 5.61)"><foreignObject style="--ltx-fo-width:4.2em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:10pt;" height="8.46" overflow="visible" transform="matrix(1 0 0 -1 0 8.46)" width="58.12"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F7.pic1.m1" class="ltx_Math" alttext="\tt 00\ 11\ 10" display="inline" intent=":literal"><semantics><mn class="ltx_mathvariant_monospace" mathvariant="monospace">00 11 10</mn><annotation encoding="application/x-tex">\tt 00\ 11\ 10</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 81.43 6.38)"><foreignObject style="--ltx-fo-width:0.75em;--ltx-fo-height:0.7em;--ltx-fo-depth:0.2em;font-size:10pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.69)" width="10.38"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F7.pic1.m2" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo>⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 329.46 6.38)"><foreignObject style="--ltx-fo-width:0.75em;--ltx-fo-height:0.7em;--ltx-fo-depth:0.2em;font-size:10pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.69)" width="10.38"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F7.pic1.m3" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo>⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -28.14 -53.44)"><foreignObject style="--ltx-fo-width:5.78em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:10pt;" height="8.46" overflow="visible" transform="matrix(1 0 0 -1 0 8.46)" width="79.91"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F7.pic1.m4" class="ltx_Math" alttext="\tt 001\ 110\ 111" display="inline" intent=":literal"><semantics><mn class="ltx_mathvariant_monospace" mathvariant="monospace">001 110 111</mn><annotation encoding="application/x-tex">\tt 001\ 110\ 111</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 105.05 -52.67)"><foreignObject style="--ltx-fo-width:0.75em;--ltx-fo-height:0.7em;--ltx-fo-depth:0.2em;font-size:10pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.69)" width="10.38"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F7.pic1.m5" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo>⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 408.2 -52.67)"><foreignObject style="--ltx-fo-width:0.75em;--ltx-fo-height:0.7em;--ltx-fo-depth:0.2em;font-size:10pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.69)" width="10.38"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F7.pic1.m6" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo>⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M -23.62 0 L -20.18 -34.41"></path><g transform="matrix(0.0995 -0.99504 0.99504 0.0995 -20.18 -34.41)"><path style="stroke:none" d="M 4.98 0 C 3.51 0.28 1.11 1.11 -0.55 2.08 L -0.55 -2.08 C 1.11 -1.11 3.51 -0.28 4.98 0"></path></g><path style="fill:none" d="M 0 0 L 10.38 -34.6"></path><g transform="matrix(0.28735 -0.95782 0.95782 0.28735 10.38 -34.6)"><path style="stroke:none" d="M 4.98 0 C 3.51 0.28 1.11 1.11 -0.55 2.08 L -0.55 -2.08 C 1.11 -1.11 3.51 -0.28 4.98 0"></path></g><path style="fill:none" d="M 23.62 0 L 41.08 -34.91"></path><g transform="matrix(0.4472 -0.89442 0.89442 0.4472 41.08 -34.91)"><path style="stroke:none" d="M 4.98 0 C 3.51 0.28 1.11 1.11 -0.55 2.08 L -0.55 -2.08 C 1.11 -1.11 3.51 -0.28 4.98 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -30.84 -22.66)"><foreignObject style="--ltx-fo-width:0.44em;--ltx-fo-height:0.43em;--ltx-fo-depth:0em;font-size:10pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="6.05"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F7.pic1.m7" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M -35.43 -62.99 M -35.43 -62.99 C -34.19 -65.48 -31.28 -67.14 -27.13 -67.14 L 103.9 -67.14 C 108.05 -67.14 110.96 -68.8 112.2 -71.29 C 113.45 -68.8 116.36 -67.14 120.51 -67.14 L 251.54 -67.14 C 255.69 -67.14 258.6 -65.48 259.84 -62.99"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 102.67 -85.1)"><foreignObject style="--ltx-fo-width:1.38em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="19.07"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F7.pic1.m8" class="ltx_Math" alttext="3m" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">3m</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M -35.43 23.62 M -35.43 23.62 C -34.19 26.11 -31.28 27.77 -27.13 27.77 L 52.72 27.77 C 56.87 27.77 59.78 29.43 61.02 31.92 C 62.27 29.43 65.17 27.77 69.33 27.77 L 149.18 27.77 C 153.33 27.77 156.24 26.11 157.48 23.62"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 51.49 36.81)"><foreignObject style="--ltx-fo-width:1.38em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="19.07"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F7.pic1.m9" class="ltx_Math" alttext="2m" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">2m</annotation></semantics></math></span></span></foreignObject></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 7: </span>Desubtituting <math id="S3.F7.m2" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math>.</figcaption>
</figure>
<div id="S3.p9" class="ltx_para">
<p id="S3.p9.1" class="ltx_p"><span id="S3.p9.1.1" class="ltx_text">Consider an arbitrary index congruent to <math id="S3.p9.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> modulo <math id="S3.p9.m2" class="ltx_Math" alttext="2^{n}" display="inline" intent=":literal"><semantics><msup><mn>2</mn><mi>n</mi></msup><annotation encoding="application/x-tex">2^{n}</annotation></semantics></math> and of the form</span></p>
<table id="S3.Ex69" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex69.m1" class="ltx_Math" alttext="3m+r,\quad\text{ with }m\geq 0\text{ and }r\in\{0,1,2\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mi>r</mi></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mtext> with </mtext><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>≥</mo><mrow><mn>0</mn><mo lspace="0em" rspace="0em">​</mo><mtext> and </mtext><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo stretchy="false">}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">3m+r,\quad\text{ with }m\geq 0\text{ and }r\in\{0,1,2\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p9.2" class="ltx_p"><span id="S3.p9.2.1" class="ltx_text">In particular, <math id="S3.p9.m3" class="ltx_Math" alttext="k\equiv 3m+r\pmod{2^{n}}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≡</mo><mrow><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mi>r</mi></mrow><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0.167em">mod</mo><msup><mn>2</mn><mi>n</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">k\equiv 3m+r\pmod{2^{n}}</annotation></semantics></math>. Since, <math id="S3.p9.m4" class="ltx_Math" alttext="3q_{n}\equiv 1\pmod{2^{n}}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>n</mi></msub></mrow><mo>≡</mo><mrow><mn>1</mn><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0.167em">mod</mo><msup><mn>2</mn><mi>n</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">3q_{n}\equiv 1\pmod{2^{n}}</annotation></semantics></math>, we get <math id="S3.p9.m5" class="ltx_Math" alttext="q_{n}k\equiv m+q_{n}r\pmod{2^{n}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>≡</mo><mrow><mrow><mi>m</mi><mo>+</mo><mrow><msub><mi>q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0.167em">mod</mo><msup><mn>2</mn><mi>n</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q_{n}k\equiv m+q_{n}r\pmod{2^{n}}</annotation></semantics></math> and finally,</span></p>
<table id="S3.E12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(12)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E12.m1" class="ltx_Math" alttext="2m\equiv 2q_{n}k-2q_{n}r\pmod{2^{n+1}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>≡</mo><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" movablelimits="false" rspace="0.167em">mod</mo><msup><mn>2</mn><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">2m\equiv 2q_{n}k-2q_{n}r\pmod{2^{n+1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p9.3" class="ltx_p"><span id="S3.p9.3.1" class="ltx_text">Since <math id="S3.p9.m6" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> is a fixed point of <math id="S3.p9.m7" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> defined in <a href="#S1.E5" title="In Definition 3 (Our sequence of interest). ‣ 1.3 The base 3/2 and the corresponding Thue–Morse word ‣ 1 Introduction ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">5</span></a>, we know that</span></p>
<table id="S3.Ex70" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex70.m1" class="ltx_Math" alttext="t_{3m}=t_{3m+1}=t_{2m}\quad\text{and}\quad t_{3m+2}=\overline{t_{2m+1}}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>t</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><mo>=</mo><msub><mi>t</mi><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><msub><mi>t</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mi>t</mi><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mn>2</mn></mrow></msub><mo>=</mo><mover accent="true"><msub><mi>t</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="true">¯</mo></mover></mrow></mrow><annotation encoding="application/x-tex">t_{3m}=t_{3m+1}=t_{2m}\quad\text{and}\quad t_{3m+2}=\overline{t_{2m+1}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p9.4" class="ltx_p"><span id="S3.p9.4.1" class="ltx_text">for all <math id="S3.p9.m8" class="ltx_Math" alttext="m\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">m\geq 0</annotation></semantics></math>. These relations allow us to express <math id="S3.p9.m9" class="ltx_Math" alttext="C_{n}(c,k,N)" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{n}(c,k,N)</annotation></semantics></math>. First, observe that if <math id="S3.p9.m10" class="ltx_Math" alttext="r=0" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">r=0</annotation></semantics></math> (resp., <math id="S3.p9.m11" class="ltx_Math" alttext="r=1" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">r=1</annotation></semantics></math>) in (<a href="#S3.E12" title="Equation 12 ‣ Proof. ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>), then <math id="S3.p9.m12" class="ltx_Math" alttext="2m\equiv 2q_{n}k\pmod{2^{n+1}}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>≡</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0.167em">mod</mo><msup><mn>2</mn><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">2m\equiv 2q_{n}k\pmod{2^{n+1}}</annotation></semantics></math> (resp., <math id="S3.p9.m13" class="ltx_Math" alttext="2m\equiv 2q_{n}k-2q_{n}\pmod{2^{n+1}}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>≡</mo><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>n</mi></msub></mrow></mrow><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0.167em">mod</mo><msup><mn>2</mn><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">2m\equiv 2q_{n}k-2q_{n}\pmod{2^{n+1}}</annotation></semantics></math>). Second, if <math id="S3.p9.m14" class="ltx_Math" alttext="r=2" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">r=2</annotation></semantics></math>, in (<a href="#S3.E12" title="Equation 12 ‣ Proof. ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>), then <math id="S3.p9.m15" class="ltx_Math" alttext="2m\equiv 2q_{n}k-q_{n}-3q_{n}+1\pmod{2^{n+1}}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>≡</mo><mrow><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>−</mo><msub><mi>q</mi><mi>n</mi></msub><mo>−</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>n</mi></msub></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0.167em">mod</mo><msup><mn>2</mn><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">2m\equiv 2q_{n}k-q_{n}-3q_{n}+1\pmod{2^{n+1}}</annotation></semantics></math>, and since <math id="S3.p9.m16" class="ltx_Math" alttext="3q_{n}\equiv 1\pmod{2^{n+1}}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>n</mi></msub></mrow><mo>≡</mo><mrow><mn>1</mn><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0.167em">mod</mo><msup><mn>2</mn><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">3q_{n}\equiv 1\pmod{2^{n+1}}</annotation></semantics></math>, we get <math id="S3.p9.m17" class="ltx_Math" alttext="2m\equiv 2q_{n}k-q_{n}\pmod{2^{n+1}}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>≡</mo><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>−</mo><msub><mi>q</mi><mi>n</mi></msub></mrow><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0.167em">mod</mo><msup><mn>2</mn><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">2m\equiv 2q_{n}k-q_{n}\pmod{2^{n+1}}</annotation></semantics></math>.
Hence <math id="S3.p9.m18" class="ltx_Math" alttext="C_{n}(c,k,N)" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{n}(c,k,N)</annotation></semantics></math> is equal to</span></p>
<table id="S3.Ex71" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex71.m1" class="ltx_Math" alttext="C_{n+1}(c,2q_{n}k,\lfloor 2N/3\rfloor)+C_{n+1}(c,2q_{n}k-2q_{n},\lfloor 2N/3\rfloor)+C_{n+1}(\bar{c},2q_{n}k-q_{n},\lfloor 2N/3\rfloor)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>C</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>,</mo><mrow><mo stretchy="false">⌊</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>/</mo><mn>3</mn></mrow><mo stretchy="false">⌋</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>C</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>n</mi></msub></mrow></mrow><mo>,</mo><mrow><mo stretchy="false">⌊</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>/</mo><mn>3</mn></mrow><mo stretchy="false">⌋</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>C</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>c</mi><mo>¯</mo></mover><mo>,</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>−</mo><msub><mi>q</mi><mi>n</mi></msub></mrow><mo>,</mo><mrow><mo stretchy="false">⌊</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>/</mo><mn>3</mn></mrow><mo stretchy="false">⌋</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">C_{n+1}(c,2q_{n}k,\lfloor 2N/3\rfloor)+C_{n+1}(c,2q_{n}k-2q_{n},\lfloor 2N/3\rfloor)+C_{n+1}(\bar{c},2q_{n}k-q_{n},\lfloor 2N/3\rfloor).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p9.5" class="ltx_p"><span id="S3.p9.5.1" class="ltx_text">We divide both side by <math id="S3.p9.m19" class="ltx_Math" alttext="2N/3" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>/</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">2N/3</annotation></semantics></math> and we may also get rid of the
integer parts in the argument of the counting function. The
attentive reader will note that equality is exact up to one
unit since, if <math id="S3.p9.m20" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> is not an integer, then <math id="S3.p9.m21" class="ltx_Math" alttext="C_{n+1}(c,k,\alpha)-C_{n+1}(c,k,\lfloor\alpha\rfloor)\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>C</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>C</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>k</mi><mo>,</mo><mrow><mo stretchy="false">⌊</mo><mi>α</mi><mo stretchy="false">⌋</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">C_{n+1}(c,k,\alpha)-C_{n+1}(c,k,\lfloor\alpha\rfloor)\in\{0,1\}</annotation></semantics></math>. This bounded difference is not important when passing to the limit. Hence
<math id="S3.p9.m22" class="ltx_Math" alttext="\frac{3}{2N}C_{n}(c,k,N)" display="inline" intent=":literal"><semantics><mrow><mfrac><mn>3</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>k</mi><mo>,</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\frac{3}{2N}C_{n}(c,k,N)</annotation></semantics></math> is equal to</span></p>
<table id="S3.Ex72" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex72.m1" class="ltx_Math" alttext="\frac{1}{2N/3}\biggl(C_{n+1}(c,2q_{n}k,2N/3)+C_{n+1}(c,2q_{n}k-2q_{n},2N/3)+C_{n+1}(\bar{c},2q_{n}k-q_{n},2N/3)\biggr)." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>/</mo><mn>3</mn></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><msub><mi>C</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>,</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>/</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>C</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>n</mi></msub></mrow></mrow><mo>,</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>/</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>C</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>c</mi><mo>¯</mo></mover><mo>,</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>−</mo><msub><mi>q</mi><mi>n</mi></msub></mrow><mo>,</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>/</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{1}{2N/3}\biggl(C_{n+1}(c,2q_{n}k,2N/3)+C_{n+1}(c,2q_{n}k-2q_{n},2N/3)+C_{n+1}(\bar{c},2q_{n}k-q_{n},2N/3)\biggr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p9.6" class="ltx_p"><span id="S3.p9.6.1" class="ltx_text">Now consider this equality along the sequence <math id="S3.p9.m23" class="ltx_Math" alttext="((2/3)^{n}N_{t})_{t\geq 0}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo>/</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">((2/3)^{n}N_{t})_{t\geq 0}</annotation></semantics></math> to get the expected relation.</span></p>
</div>
<div id="S3.p10" class="ltx_para">
<p id="S3.p10.1" class="ltx_p"><span id="S3.p10.1.1" class="ltx_text">The last item simply translates that along the positions of <math id="S3.p10.m1" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> congruent to <math id="S3.p10.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> modulo <math id="S3.p10.m3" class="ltx_Math" alttext="2^{n}" display="inline" intent=":literal"><semantics><msup><mn>2</mn><mi>n</mi></msup><annotation encoding="application/x-tex">2^{n}</annotation></semantics></math>, we either see a <math id="S3.p10.m4" class="ltx_Math" alttext="{\tt 0}" display="inline" intent=":literal"><semantics><mn>𝟶</mn><annotation encoding="application/x-tex">{\tt 0}</annotation></semantics></math> or a <math id="S3.p10.m5" class="ltx_Math" alttext="{\tt 1}" display="inline" intent=":literal"><semantics><mn>𝟷</mn><annotation encoding="application/x-tex">{\tt 1}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S3.p11" class="ltx_para">
<p id="S3.p11.1" class="ltx_p">To prove the following result, we make use of methods from harmonic analysis that we present in <a href="#S3.SS1" title="3.1 Some abstract harmonic analysis ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">3.1</span></a>.</p>
</div>
<div id="Thmtheorem20" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem20.2" class="ltx_text ltx_font_bold">Proposition 20</span></span><span id="Thmtheorem20.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem20.p1" class="ltx_para">
<p id="Thmtheorem20.p1.1" class="ltx_p"><span id="Thmtheorem20.p1.1.1" class="ltx_text ltx_font_italic">Assume that a collection of nonnegative real numbers</span></p>
<table id="S3.Ex73" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex73.m1" class="ltx_math_unparsed" alttext="\bigl\{\mu_{n}(a,k)\mid n\geq 0,\,a\in\{{\tt 0},{\tt 1}\},\,k\in\mathbb{Z}\bigr\}" display="block" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>μ</mi><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>n</mi><mo>≥</mo><mn>0</mn><mo rspace="0.337em">,</mo><mi>a</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>𝟶</mn><mo>,</mo><mn>𝟷</mn><mo stretchy="false">}</mo></mrow><mo rspace="0.337em">,</mo><mi>k</mi><mo>∈</mo><mi>ℤ</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\bigl\{\mu_{n}(a,k)\mid n\geq 0,\,a\in\{{\tt 0},{\tt 1}\},\,k\in\mathbb{Z}\bigr\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem20.p1.2" class="ltx_p"><span id="Thmtheorem20.p1.2.1" class="ltx_text ltx_font_italic">satisfies, for all <math id="Thmtheorem20.p1.m1" class="ltx_Math" alttext="n\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n\geq 0</annotation></semantics></math>, the following three properties:</span></p>
<ol id="S3.I3" class="ltx_enumerate">
<li id="S3.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><math id="S3.I3.i1.m1" class="ltx_Math" alttext="(P_{1})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(P_{1})</annotation></semantics></math></span> 
<div id="S3.I3.i1.p1" class="ltx_para">
<p id="S3.I3.i1.p1.1" class="ltx_p"><span id="S3.I3.i1.p1.1.1" class="ltx_text ltx_font_italic">For </span><math id="S3.I3.i1.p1.m1" class="ltx_Math" alttext="a\in\{{\tt 0},{\tt 1}\}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>𝟶</mn><mo>,</mo><mn>𝟷</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">a\in\{{\tt 0},{\tt 1}\}</annotation></semantics></math><span id="S3.I3.i1.p1.1.2" class="ltx_text ltx_font_italic">, the map </span><math id="S3.I3.i1.p1.m2" class="ltx_Math" alttext="k\mapsto\mu_{n}(a,k)" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo stretchy="false">↦</mo><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">k\mapsto\mu_{n}(a,k)</annotation></semantics></math><span id="S3.I3.i1.p1.1.3" class="ltx_text ltx_font_italic"> is </span><math id="S3.I3.i1.p1.m3" class="ltx_Math" alttext="2^{n}" display="inline" intent=":literal"><semantics><msup><mn>2</mn><mi>n</mi></msup><annotation encoding="application/x-tex">2^{n}</annotation></semantics></math><span id="S3.I3.i1.p1.1.4" class="ltx_text ltx_font_italic">-periodic, i.e.,
</span><math id="S3.I3.i1.p1.m4" class="ltx_Math" alttext="\mu_{n}(\cdot,k)=\mu_{n}(\cdot,k^{\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msup><mi>k</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu_{n}(\cdot,k)=\mu_{n}(\cdot,k^{\prime})</annotation></semantics></math><span id="S3.I3.i1.p1.1.5" class="ltx_text ltx_font_italic"> whenever </span><math id="S3.I3.i1.p1.m5" class="ltx_Math" alttext="k\equiv k^{\prime}\pmod{2^{n}}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≡</mo><mrow><msup><mi>k</mi><mo>′</mo></msup><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0.167em">mod</mo><msup><mn>2</mn><mi>n</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">k\equiv k^{\prime}\pmod{2^{n}}</annotation></semantics></math><span id="S3.I3.i1.p1.1.6" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S3.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><math id="S3.I3.i2.m1" class="ltx_Math" alttext="(P_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(P_{2})</annotation></semantics></math></span> 
<div id="S3.I3.i2.p1" class="ltx_para">
<p id="S3.I3.i2.p1.1" class="ltx_p"><span id="S3.I3.i2.p1.1.1" class="ltx_text ltx_font_italic">Let </span><math id="S3.I3.i2.p1.m1" class="ltx_Math" alttext="q_{n}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mi>n</mi></msub><annotation encoding="application/x-tex">q_{n}</annotation></semantics></math><span id="S3.I3.i2.p1.1.2" class="ltx_text ltx_font_italic"> denote the inverse of </span><math id="S3.I3.i2.p1.m2" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math><span id="S3.I3.i2.p1.1.3" class="ltx_text ltx_font_italic"> modulo </span><math id="S3.I3.i2.p1.m3" class="ltx_Math" alttext="2^{n+1}" display="inline" intent=":literal"><semantics><msup><mn>2</mn><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">2^{n+1}</annotation></semantics></math><span id="S3.I3.i2.p1.1.4" class="ltx_text ltx_font_italic">. For all </span><math id="S3.I3.i2.p1.m4" class="ltx_Math" alttext="k\in\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">k\in\mathbb{Z}</annotation></semantics></math><span id="S3.I3.i2.p1.1.5" class="ltx_text ltx_font_italic"> and </span><math id="S3.I3.i2.p1.m5" class="ltx_Math" alttext="a\in\{{\tt 0},{\tt 1}\}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>𝟶</mn><mo>,</mo><mn>𝟷</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">a\in\{{\tt 0},{\tt 1}\}</annotation></semantics></math><span id="S3.I3.i2.p1.1.6" class="ltx_text ltx_font_italic">,</span></p>
<table id="S3.Ex74" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex74.m1" class="ltx_Math" alttext="\tfrac{3}{2}\,\mu_{n}(a,k)=\mu_{n+1}(a,\,2q_{n}k)+\mu_{n+1}(\bar{a},\,2q_{n}k-q_{n})+\mu_{n+1}(a,\,2q_{n}k-2q_{n})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="false"><mfrac><mn>3</mn><mn>2</mn></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>μ</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mrow><mn> 2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>μ</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>a</mi><mo>¯</mo></mover><mo>,</mo><mrow><mrow><mn> 2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>−</mo><msub><mi>q</mi><mi>n</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>μ</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mrow><mrow><mn> 2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>n</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tfrac{3}{2}\,\mu_{n}(a,k)=\mu_{n+1}(a,\,2q_{n}k)+\mu_{n+1}(\bar{a},\,2q_{n}k-q_{n})+\mu_{n+1}(a,\,2q_{n}k-2q_{n}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S3.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><math id="S3.I3.i3.m1" class="ltx_Math" alttext="(P_{3})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(P_{3})</annotation></semantics></math></span> 
<div id="S3.I3.i3.p1" class="ltx_para">
<p id="S3.I3.i3.p1.1" class="ltx_p"><span id="S3.I3.i3.p1.1.1" class="ltx_text ltx_font_italic">For all </span><math id="S3.I3.i3.p1.m1" class="ltx_Math" alttext="k\in\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">k\in\mathbb{Z}</annotation></semantics></math><span id="S3.I3.i3.p1.1.2" class="ltx_text ltx_font_italic">, we have </span><math id="S3.I3.i3.p1.m2" class="ltx_Math" alttext="\mu_{n}({\tt 0},k)+\mu_{n}({\tt 1},k)=2^{-n}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟶</mn><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟷</mn><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><msup><mn>2</mn><mrow><mo>−</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mu_{n}({\tt 0},k)+\mu_{n}({\tt 1},k)=2^{-n}</annotation></semantics></math><span id="S3.I3.i3.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
<p id="Thmtheorem20.p1.3" class="ltx_p"><span id="Thmtheorem20.p1.3.1" class="ltx_text ltx_font_italic">Then, for all <math id="Thmtheorem20.p1.m2" class="ltx_Math" alttext="n\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n\geq 0</annotation></semantics></math>, <math id="Thmtheorem20.p1.m3" class="ltx_Math" alttext="a\in\{{\tt 0},{\tt 1}\}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>𝟶</mn><mo>,</mo><mn>𝟷</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">a\in\{{\tt 0},{\tt 1}\}</annotation></semantics></math>, and <math id="Thmtheorem20.p1.m4" class="ltx_Math" alttext="k\in\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">k\in\mathbb{Z}</annotation></semantics></math>, we have <math id="Thmtheorem20.p1.m5" class="ltx_Math" alttext="\mu_{n}(a,k)=2^{-n-1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mn>2</mn><mrow><mrow><mo>−</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\mu_{n}(a,k)=2^{-n-1}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="Thmtheorem21" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem21.2" class="ltx_text ltx_font_italic">Remark 21</span></span><span id="Thmtheorem21.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="Thmtheorem21.p1" class="ltx_para">
<p id="Thmtheorem21.p1.1" class="ltx_p">We observe that condition <math id="Thmtheorem21.p1.m1" class="ltx_Math" alttext="(P_{1})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(P_{1})</annotation></semantics></math> ensures that the value of
<math id="Thmtheorem21.p1.m2" class="ltx_Math" alttext="\mu_{n+1}(a,2q_{n}k)" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu_{n+1}(a,2q_{n}k)</annotation></semantics></math> is independent of the representative of <math id="Thmtheorem21.p1.m3" class="ltx_Math" alttext="q_{n}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mi>n</mi></msub><annotation encoding="application/x-tex">q_{n}</annotation></semantics></math>
modulo <math id="Thmtheorem21.p1.m4" class="ltx_Math" alttext="2^{n+1}" display="inline" intent=":literal"><semantics><msup><mn>2</mn><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">2^{n+1}</annotation></semantics></math> that one considers.</p>
</div>
</div>
<section id="S3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.1 </span>Some abstract harmonic analysis</h3>

<div id="S3.SS1.p1" class="ltx_para">
<p id="S3.SS1.p1.1" class="ltx_p">Before proceeding to the proof of <a href="#Thmtheorem20" title="Proposition 20. ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">20</span></a>, in order to be self-contained and to address an audience who may be more inclined towards a combinatorial reasoning, we briefly recap some key elements of abstract harmonic analysis. A standard reference is <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">23</a>]</cite>.</p>
</div>
<section id="S3.SS1.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Lift to <math id="S3.SS1.SSS0.Px1.m1" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-adic integers.</h4>

<div id="S3.SS1.SSS0.Px1.p1" class="ltx_para">
<p id="S3.SS1.SSS0.Px1.p1.1" class="ltx_p">The key ingredient is to encode the congruences modulo <math id="S3.SS1.SSS0.Px1.p1.m1" class="ltx_Math" alttext="2^{n}" display="inline" intent=":literal"><semantics><msup><mn>2</mn><mi>n</mi></msup><annotation encoding="application/x-tex">2^{n}</annotation></semantics></math>, for all <math id="S3.SS1.SSS0.Px1.p1.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>, in a simultaneous way. Let <math id="S3.SS1.SSS0.Px1.p1.m3" class="ltx_Math" alttext="X=\mathbb{Z}_{2}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>=</mo><msub><mi>ℤ</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">X=\mathbb{Z}_{2}</annotation></semantics></math> be the <em id="S3.SS1.SSS0.Px1.p1.1.1" class="ltx_emph ltx_font_italic">ring of <math id="S3.SS1.SSS0.Px1.p1.m4" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-adic integers</em>. It is classically defined as the inverse limit of the ring homomorphisms
<math id="S3.SS1.SSS0.Px1.p1.m5" class="ltx_Math" alttext="\mathbb{Z}/2^{n+1}\mathbb{Z}\to\mathbb{Z}/2^{n}\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℤ</mi><mo>/</mo><msup><mn>2</mn><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ℤ</mi></mrow><mo stretchy="false">→</mo><mrow><mrow><mi>ℤ</mi><mo>/</mo><msup><mn>2</mn><mi>n</mi></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ℤ</mi></mrow></mrow><annotation encoding="application/x-tex">\mathbb{Z}/2^{n+1}\mathbb{Z}\to\mathbb{Z}/2^{n}\mathbb{Z}</annotation></semantics></math> given by
reduction modulo powers of <math id="S3.SS1.SSS0.Px1.p1.m6" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>.
Formally,</p>
<table id="S3.Ex75" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex75.m1" class="ltx_math_unparsed" alttext="X=\biggl\{(x_{n})_{n\geq 0}\in\prod_{n\geq 0}\mathbb{Z}/2^{n}\mathbb{Z}\mid x_{n+1}\equiv x_{n}\pmod{2^{n}}\text{ for all $n\geq 0$}\biggr\}." display="block" intent=":literal"><semantics><mrow><mi>X</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></msub><mo rspace="0.111em">∈</mo><munder><mo movablelimits="false">∏</mo><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></munder><mi>ℤ</mi><mo>/</mo><msup><mn>2</mn><mi>n</mi></msup><mi>ℤ</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>≡</mo><msub><mi>x</mi><mi>n</mi></msub><mrow><mo lspace="0.560em" stretchy="false">(</mo><mrow><mo lspace="0em" movablelimits="false" rspace="0.167em">mod</mo><msup><mn>2</mn><mi>n</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mrow><mtext> for all </mtext><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">X=\biggl\{(x_{n})_{n\geq 0}\in\prod_{n\geq 0}\mathbb{Z}/2^{n}\mathbb{Z}\mid x_{n+1}\equiv x_{n}\pmod{2^{n}}\text{ for all $n\geq 0$}\biggr\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.SSS0.Px1.p1.2" class="ltx_p">As an example, the sequence starting with <math id="S3.SS1.SSS0.Px1.p1.m7" class="ltx_math_unparsed" alttext="113777(39)\cdots" display="inline" intent=":literal"><semantics><mrow><mn>113777</mn><mrow><mo stretchy="false">(</mo><mn>39</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em">⋯</mo></mrow><annotation encoding="application/x-tex">113777(39)\cdots</annotation></semantics></math> belongs to <math id="S3.SS1.SSS0.Px1.p1.m8" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>.
Ring operations are defined coordinate-wise:
for <math id="S3.SS1.SSS0.Px1.p1.m9" class="ltx_Math" alttext="\mathbf{x}=(x_{n})_{n\geq 0}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbf{x}=(x_{n})_{n\geq 0}</annotation></semantics></math> and <math id="S3.SS1.SSS0.Px1.p1.m10" class="ltx_Math" alttext="\mathbf{y}=(y_{n})_{n\geq 0}" display="inline" intent=":literal"><semantics><mrow><mi>𝐲</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbf{y}=(y_{n})_{n\geq 0}</annotation></semantics></math> in <math id="S3.SS1.SSS0.Px1.p1.m11" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>, we define <math id="S3.SS1.SSS0.Px1.p1.m12" class="ltx_Math" alttext="\mathbf{x}+\mathbf{y}" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>+</mo><mi>𝐲</mi></mrow><annotation encoding="application/x-tex">\mathbf{x}+\mathbf{y}</annotation></semantics></math> and <math id="S3.SS1.SSS0.Px1.p1.m13" class="ltx_Math" alttext="\mathbf{x}\mathbf{y}" display="inline" intent=":literal"><semantics><mi>𝐱𝐲</mi><annotation encoding="application/x-tex">\mathbf{x}\mathbf{y}</annotation></semantics></math> respectively by</p>
<table id="S3.Ex76" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex76.m1" class="ltx_Math" alttext="\mathbf{x}+\mathbf{y}=(x_{n}+y_{n}\bmod 2^{n})_{n\geq 0}\quad\text{and}\quad\mathbf{x}\mathbf{y}=(x_{n}y_{n}\bmod 2^{n})_{n\geq 0}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>𝐱</mi><mo>+</mo><mi>𝐲</mi></mrow><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>x</mi><mi>n</mi></msub><mo>+</mo><msub><mi>y</mi><mi>n</mi></msub></mrow><mo>mod</mo><msup><mn>2</mn><mi>n</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></msub></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mi>𝐱𝐲</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>x</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mi>n</mi></msub></mrow><mo>mod</mo><msup><mn>2</mn><mi>n</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbf{x}+\mathbf{y}=(x_{n}+y_{n}\bmod 2^{n})_{n\geq 0}\quad\text{and}\quad\mathbf{x}\mathbf{y}=(x_{n}y_{n}\bmod 2^{n})_{n\geq 0}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.SSS0.Px1.p1.3" class="ltx_p">With the profinite topology, <math id="S3.SS1.SSS0.Px1.p1.m14" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is a compact totally disconnected
topological ring. For any <math id="S3.SS1.SSS0.Px1.p1.m15" class="ltx_Math" alttext="n\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n\geq 0</annotation></semantics></math>, we let <math id="S3.SS1.SSS0.Px1.p1.m16" class="ltx_Math" alttext="\pi_{n}:X\to\mathbb{Z}/2^{n}\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>n</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>X</mi><mo stretchy="false">→</mo><mrow><mrow><mi>ℤ</mi><mo>/</mo><msup><mn>2</mn><mi>n</mi></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ℤ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi_{n}:X\to\mathbb{Z}/2^{n}\mathbb{Z}</annotation></semantics></math> denote the <em id="S3.SS1.SSS0.Px1.p1.3.1" class="ltx_emph ltx_font_italic">canonical
projection</em> onto the <math id="S3.SS1.SSS0.Px1.p1.m17" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-th coordinate, i.e., for <math id="S3.SS1.SSS0.Px1.p1.m18" class="ltx_Math" alttext="\mathbf{x}=(x_{n})_{n\geq 0}\in X" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></msub><mo>∈</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">\mathbf{x}=(x_{n})_{n\geq 0}\in X</annotation></semantics></math>, we define <math id="S3.SS1.SSS0.Px1.p1.m19" class="ltx_Math" alttext="\pi_{n}(\mathbf{x})=x_{n}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>x</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\pi_{n}(\mathbf{x})=x_{n}</annotation></semantics></math>.</p>
</div>
</section>
<section id="S3.SS1.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">The dual group.</h4>

<div id="S3.SS1.SSS0.Px2.p1" class="ltx_para">
<p id="S3.SS1.SSS0.Px2.p1.1" class="ltx_p">The so-called <span id="S3.SS1.SSS0.Px2.p1.1.1" class="ltx_text ltx_font_italic">Pontryagin dual</span> <math id="S3.SS1.SSS0.Px2.p1.m1" class="ltx_Math" alttext="\widehat{X}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>X</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\widehat{X}</annotation></semantics></math> of <math id="S3.SS1.SSS0.Px2.p1.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is the group of <em id="S3.SS1.SSS0.Px2.p1.1.2" class="ltx_emph ltx_font_italic">characters</em>, i.e., continuous homomorphisms from the group <math id="S3.SS1.SSS0.Px2.p1.m3" class="ltx_Math" alttext="(X,+)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>X</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">+</mo><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(X,+)</annotation></semantics></math> into the circle group <math id="S3.SS1.SSS0.Px2.p1.m4" class="ltx_Math" alttext="\{z\in\mathbb{C}:|z|=1\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mi>z</mi><mo>∈</mo><mi>ℂ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">|</mo><mi>z</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{z\in\mathbb{C}:|z|=1\}</annotation></semantics></math> endowed with the complex multiplication. It is canonically isomorphic to</p>
<table id="S3.Ex77" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex77.m1" class="ltx_math_unparsed" alttext="\mathbb{Q}[1/2]/\mathbb{Z}=\bigl\{\tfrac{a}{2^{n}}+\mathbb{Z}:a\in\mathbb{Z},\,n\geq 0\bigr\}." display="block" intent=":literal"><semantics><mrow><mi>ℚ</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>/</mo><mn>2</mn><mo stretchy="false">]</mo></mrow><mo>/</mo><mi>ℤ</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mstyle displaystyle="false"><mfrac><mi>a</mi><msup><mn>2</mn><mi>n</mi></msup></mfrac></mstyle><mo>+</mo><mi>ℤ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>a</mi><mo>∈</mo><mi>ℤ</mi><mo rspace="0.337em">,</mo><mi>n</mi><mo>≥</mo><mn>0</mn><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{Q}[1/2]/\mathbb{Z}=\bigl\{\tfrac{a}{2^{n}}+\mathbb{Z}:a\in\mathbb{Z},\,n\geq 0\bigr\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.SSS0.Px2.p1.2" class="ltx_p">For a reference, see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">23</a>, p. 113]</cite> where it is shown that, for a prime <math id="S3.SS1.SSS0.Px2.p1.m5" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>, <math id="S3.SS1.SSS0.Px2.p1.m6" class="ltx_Math" alttext="\widehat{\mathbb{Z}}_{p}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ℤ</mi><mo>^</mo></mover><mi>p</mi></msub><annotation encoding="application/x-tex">\widehat{\mathbb{Z}}_{p}</annotation></semantics></math> is isomorphic to <math id="S3.SS1.SSS0.Px2.p1.m7" class="ltx_Math" alttext="\mathbb{Q}_{p}/\mathbb{Z}_{p}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ℚ</mi><mi>p</mi></msub><mo>/</mo><msub><mi>ℤ</mi><mi>p</mi></msub></mrow><annotation encoding="application/x-tex">\mathbb{Q}_{p}/\mathbb{Z}_{p}</annotation></semantics></math>. Note that <math id="S3.SS1.SSS0.Px2.p1.m8" class="ltx_Math" alttext="\mathbb{Q}[1/2]/\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℚ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>/</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">\mathbb{Q}[1/2]/\mathbb{Z}</annotation></semantics></math> is indeed isomorphic to <math id="S3.SS1.SSS0.Px2.p1.m9" class="ltx_Math" alttext="\mathbb{Q}_{2}/\mathbb{Z}_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ℚ</mi><mn>2</mn></msub><mo>/</mo><msub><mi>ℤ</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\mathbb{Q}_{2}/\mathbb{Z}_{2}</annotation></semantics></math> with the isomorphism mapping a representative <math id="S3.SS1.SSS0.Px2.p1.m10" class="ltx_Math" alttext="\tfrac{a}{2^{n}}+\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mfrac><mi>a</mi><msup><mn>2</mn><mi>n</mi></msup></mfrac><mo>+</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">\tfrac{a}{2^{n}}+\mathbb{Z}</annotation></semantics></math> to <math id="S3.SS1.SSS0.Px2.p1.m11" class="ltx_Math" alttext="\tfrac{a}{2^{n}}+\mathbb{Z}_{2}" display="inline" intent=":literal"><semantics><mrow><mfrac><mi>a</mi><msup><mn>2</mn><mi>n</mi></msup></mfrac><mo>+</mo><msub><mi>ℤ</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\tfrac{a}{2^{n}}+\mathbb{Z}_{2}</annotation></semantics></math>.</p>
</div>
<div id="S3.SS1.SSS0.Px2.p2" class="ltx_para">
<p id="S3.SS1.SSS0.Px2.p2.1" class="ltx_p">Characters are thus <span id="S3.SS1.SSS0.Px2.p2.1.1" class="ltx_text ltx_font_italic">indexed</span> by dyadic rationals modulo <math id="S3.SS1.SSS0.Px2.p2.m1" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>.
To explicitly describe these characters, we first define, for all <math id="S3.SS1.SSS0.Px2.p2.m2" class="ltx_Math" alttext="\mathbf{x}\in X" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">\mathbf{x}\in X</annotation></semantics></math>, a map <math id="S3.SS1.SSS0.Px2.p2.m3" class="ltx_Math" alttext="P_{\mathbf{x}}\colon\widehat{X}\to\widehat{X}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>𝐱</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mover accent="true"><mi>X</mi><mo>^</mo></mover><mo stretchy="false">→</mo><mover accent="true"><mi>X</mi><mo>^</mo></mover></mrow></mrow><annotation encoding="application/x-tex">P_{\mathbf{x}}\colon\widehat{X}\to\widehat{X}</annotation></semantics></math> by</p>
<table id="S3.Ex78" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex78.m1" class="ltx_Math" alttext="P_{\mathbf{x}}\bigl(\tfrac{a}{2^{n}}+\mathbb{Z}\bigr)=\tfrac{\pi_{n}(x)a}{2^{n}}+\mathbb{Z}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>P</mi><mi>𝐱</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mstyle displaystyle="false"><mfrac><mi>a</mi><msup><mn>2</mn><mi>n</mi></msup></mfrac></mstyle><mo>+</mo><mi>ℤ</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="false"><mfrac><mrow><msub><mi>π</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><msup><mn>2</mn><mi>n</mi></msup></mfrac></mstyle><mo>+</mo><mi>ℤ</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">P_{\mathbf{x}}\bigl(\tfrac{a}{2^{n}}+\mathbb{Z}\bigr)=\tfrac{\pi_{n}(x)a}{2^{n}}+\mathbb{Z},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.SSS0.Px2.p2.2" class="ltx_p">where <math id="S3.SS1.SSS0.Px2.p2.m4" class="ltx_Math" alttext="a\in\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">a\in\mathbb{Z}</annotation></semantics></math> and <math id="S3.SS1.SSS0.Px2.p2.m5" class="ltx_Math" alttext="n\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n\geq 0</annotation></semantics></math>.</p>
</div>
<div id="Thmtheorem22" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem22.2" class="ltx_text ltx_font_bold">Lemma 22</span></span><span id="Thmtheorem22.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem22.p1" class="ltx_para">
<p id="Thmtheorem22.p1.1" class="ltx_p"><span id="Thmtheorem22.p1.1.1" class="ltx_text ltx_font_italic">The previous application satisfies the following properties.</span></p>
<ol id="S3.I4" class="ltx_enumerate">
<li id="S3.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="S3.I4.i1.p1" class="ltx_para">
<p id="S3.I4.i1.p1.1" class="ltx_p"><span id="S3.I4.i1.p1.1.1" class="ltx_text ltx_font_italic">For </span><math id="S3.I4.i1.p1.m1" class="ltx_Math" alttext="\mathbf{x}\in X" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">\mathbf{x}\in X</annotation></semantics></math><span id="S3.I4.i1.p1.1.2" class="ltx_text ltx_font_italic">, the application </span><math id="S3.I4.i1.p1.m2" class="ltx_Math" alttext="P_{\mathbf{x}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>𝐱</mi></msub><annotation encoding="application/x-tex">P_{\mathbf{x}}</annotation></semantics></math><span id="S3.I4.i1.p1.1.3" class="ltx_text ltx_font_italic"> is well-defined.</span></p>
</div></li>
<li id="S3.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="S3.I4.i2.p1" class="ltx_para">
<p id="S3.I4.i2.p1.1" class="ltx_p"><span id="S3.I4.i2.p1.1.1" class="ltx_text ltx_font_italic">For </span><math id="S3.I4.i2.p1.m1" class="ltx_Math" alttext="\mathbf{x}\in X" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">\mathbf{x}\in X</annotation></semantics></math><span id="S3.I4.i2.p1.1.2" class="ltx_text ltx_font_italic">, the application </span><math id="S3.I4.i2.p1.m2" class="ltx_Math" alttext="P_{\mathbf{x}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>𝐱</mi></msub><annotation encoding="application/x-tex">P_{\mathbf{x}}</annotation></semantics></math><span id="S3.I4.i2.p1.1.3" class="ltx_text ltx_font_italic"> is an additive group morphism, i.e., </span><math id="S3.I4.i2.p1.m3" class="ltx_Math" alttext="P_{\mathbf{x}}(r+s)=P_{\mathbf{x}}(r)+P_{\mathbf{x}}(s)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mi>𝐱</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>+</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>P</mi><mi>𝐱</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>P</mi><mi>𝐱</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">P_{\mathbf{x}}(r+s)=P_{\mathbf{x}}(r)+P_{\mathbf{x}}(s)</annotation></semantics></math><span id="S3.I4.i2.p1.1.4" class="ltx_text ltx_font_italic"> for all </span><math id="S3.I4.i2.p1.m4" class="ltx_Math" alttext="r,s\in\widehat{X}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>r</mi><mo>,</mo><mi>s</mi></mrow><mo>∈</mo><mover accent="true"><mi>X</mi><mo>^</mo></mover></mrow><annotation encoding="application/x-tex">r,s\in\widehat{X}</annotation></semantics></math><span id="S3.I4.i2.p1.1.5" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S3.I4.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="S3.I4.i3.p1" class="ltx_para">
<p id="S3.I4.i3.p1.1" class="ltx_p"><span id="S3.I4.i3.p1.1.1" class="ltx_text ltx_font_italic">For </span><math id="S3.I4.i3.p1.m1" class="ltx_Math" alttext="\mathbf{x},\mathbf{y}\in X" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow><mo>∈</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">\mathbf{x},\mathbf{y}\in X</annotation></semantics></math><span id="S3.I4.i3.p1.1.2" class="ltx_text ltx_font_italic">, we have </span><math id="S3.I4.i3.p1.m2" class="ltx_Math" alttext="P_{\mathbf{x}\mathbf{y}}(r)=P_{\mathbf{x}}(P_{\mathbf{x}}(r))" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mi>𝐱𝐲</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>P</mi><mi>𝐱</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>P</mi><mi>𝐱</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">P_{\mathbf{x}\mathbf{y}}(r)=P_{\mathbf{x}}(P_{\mathbf{x}}(r))</annotation></semantics></math><span id="S3.I4.i3.p1.1.3" class="ltx_text ltx_font_italic"> for all </span><math id="S3.I4.i3.p1.m3" class="ltx_Math" alttext="r\in\widehat{X}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>∈</mo><mover accent="true"><mi>X</mi><mo>^</mo></mover></mrow><annotation encoding="application/x-tex">r\in\widehat{X}</annotation></semantics></math><span id="S3.I4.i3.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S3.SS1.SSS0.Px2.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS1.SSS0.Px2.p3" class="ltx_para">
<p id="S3.SS1.SSS0.Px2.p3.1" class="ltx_p"><span id="S3.SS1.SSS0.Px2.p3.1.1" class="ltx_text">Let us prove that the first item. Consider two representatives</span></p>
<table id="S3.Ex79" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex79.m1" class="ltx_Math" alttext="\frac{a}{2^{n}}+\mathbb{Z}=\frac{b}{2^{m}}+\mathbb{Z}" display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mi>a</mi><msup><mn>2</mn><mi>n</mi></msup></mfrac><mo>+</mo><mi>ℤ</mi></mrow><mo>=</mo><mrow><mfrac><mi>b</mi><msup><mn>2</mn><mi>m</mi></msup></mfrac><mo>+</mo><mi>ℤ</mi></mrow></mrow><annotation encoding="application/x-tex">\frac{a}{2^{n}}+\mathbb{Z}=\frac{b}{2^{m}}+\mathbb{Z}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.SSS0.Px2.p3.2" class="ltx_p"><span id="S3.SS1.SSS0.Px2.p3.2.1" class="ltx_text">in <math id="S3.SS1.SSS0.Px2.p3.m1" class="ltx_Math" alttext="\widehat{X}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>X</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\widehat{X}</annotation></semantics></math> with <math id="S3.SS1.SSS0.Px2.p3.m2" class="ltx_Math" alttext="a,b\in\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">a,b\in\mathbb{Z}</annotation></semantics></math> and <math id="S3.SS1.SSS0.Px2.p3.m3" class="ltx_Math" alttext="m,n\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>m</mi><mo>,</mo><mi>n</mi></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">m,n\geq 0</annotation></semantics></math>.
Let <math id="S3.SS1.SSS0.Px2.p3.m4" class="ltx_Math" alttext="N=\max(n,m)" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">N=\max(n,m)</annotation></semantics></math>. Then</span></p>
<table id="S3.Ex80" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex80.m1" class="ltx_Math" alttext="\frac{a2^{N-n}}{2^{N}}+\mathbb{Z}=\frac{b2^{N-m}}{2^{N}}+\mathbb{Z}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mrow><mi>N</mi><mo>−</mo><mi>n</mi></mrow></msup></mrow><msup><mn>2</mn><mi>N</mi></msup></mfrac><mo>+</mo><mi>ℤ</mi></mrow><mo>=</mo><mrow><mfrac><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mrow><mi>N</mi><mo>−</mo><mi>m</mi></mrow></msup></mrow><msup><mn>2</mn><mi>N</mi></msup></mfrac><mo>+</mo><mi>ℤ</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{a2^{N-n}}{2^{N}}+\mathbb{Z}=\frac{b2^{N-m}}{2^{N}}+\mathbb{Z},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.SSS0.Px2.p3.3" class="ltx_p"><span id="S3.SS1.SSS0.Px2.p3.3.1" class="ltx_text">which implies</span></p>
<table id="S3.E13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(13)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E13.m1" class="ltx_Math" alttext="a2^{N-n}\equiv b2^{N-m}\pmod{2^{N}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mrow><mi>N</mi><mo>−</mo><mi>n</mi></mrow></msup></mrow><mo>≡</mo><mrow><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mrow><mi>N</mi><mo>−</mo><mi>m</mi></mrow></msup></mrow><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" movablelimits="false" rspace="0.167em">mod</mo><msup><mn>2</mn><mi>N</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">a2^{N-n}\equiv b2^{N-m}\pmod{2^{N}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.SSS0.Px2.p3.4" class="ltx_p"><span id="S3.SS1.SSS0.Px2.p3.4.1" class="ltx_text">Now, for any <math id="S3.SS1.SSS0.Px2.p3.m5" class="ltx_Math" alttext="\mathbf{x}\in X" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">\mathbf{x}\in X</annotation></semantics></math>, compare the two values of <math id="S3.SS1.SSS0.Px2.p3.m6" class="ltx_Math" alttext="P_{\mathbf{x}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>𝐱</mi></msub><annotation encoding="application/x-tex">P_{\mathbf{x}}</annotation></semantics></math> of these elements after rewriting them with denominator <math id="S3.SS1.SSS0.Px2.p3.m7" class="ltx_Math" alttext="2^{N}" display="inline" intent=":literal"><semantics><msup><mn>2</mn><mi>N</mi></msup><annotation encoding="application/x-tex">2^{N}</annotation></semantics></math>, i.e.</span></p>
<table id="S3.EGx11" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex81"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex81.m1" class="ltx_Math" alttext="\displaystyle P_{\mathbf{x}}\bigl(\tfrac{a}{2^{n}}+\mathbb{Z}\bigr)" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>𝐱</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mfrac><mi>a</mi><msup><mn>2</mn><mi>n</mi></msup></mfrac><mo>+</mo><mi>ℤ</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle P_{\mathbf{x}}\bigl(\tfrac{a}{2^{n}}+\mathbb{Z}\bigr)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex81.m2" class="ltx_Math" alttext="\displaystyle=\frac{\pi_{n}(\mathbf{x})a}{2^{n}}+\mathbb{Z}=\frac{\pi_{n}(\mathbf{x})a\,2^{N-n}}{2^{N}}+\mathbb{Z}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><msup><mn>2</mn><mi>n</mi></msup></mfrac></mstyle><mo>+</mo><mi>ℤ</mi></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msup><mn> 2</mn><mrow><mi>N</mi><mo>−</mo><mi>n</mi></mrow></msup></mrow><msup><mn>2</mn><mi>N</mi></msup></mfrac></mstyle><mo>+</mo><mi>ℤ</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\pi_{n}(\mathbf{x})a}{2^{n}}+\mathbb{Z}=\frac{\pi_{n}(\mathbf{x})a\,2^{N-n}}{2^{N}}+\mathbb{Z},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex82"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex82.m1" class="ltx_Math" alttext="\displaystyle P_{\mathbf{x}}\bigl(\tfrac{b}{2^{m}}+\mathbb{Z}\bigr)" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>𝐱</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mfrac><mi>b</mi><msup><mn>2</mn><mi>m</mi></msup></mfrac><mo>+</mo><mi>ℤ</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle P_{\mathbf{x}}\bigl(\tfrac{b}{2^{m}}+\mathbb{Z}\bigr)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex82.m2" class="ltx_Math" alttext="\displaystyle=\frac{\pi_{m}(\mathbf{x})b}{2^{m}}+\mathbb{Z}=\frac{\pi_{m}(\mathbf{x})b\,2^{N-m}}{2^{N}}+\mathbb{Z}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow><msup><mn>2</mn><mi>m</mi></msup></mfrac></mstyle><mo>+</mo><mi>ℤ</mi></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><msup><mn> 2</mn><mrow><mi>N</mi><mo>−</mo><mi>m</mi></mrow></msup></mrow><msup><mn>2</mn><mi>N</mi></msup></mfrac></mstyle><mo>+</mo><mi>ℤ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\pi_{m}(\mathbf{x})b}{2^{m}}+\mathbb{Z}=\frac{\pi_{m}(\mathbf{x})b\,2^{N-m}}{2^{N}}+\mathbb{Z}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.SSS0.Px2.p3.5" class="ltx_p"><span id="S3.SS1.SSS0.Px2.p3.5.1" class="ltx_text">So it suffices to prove <math id="S3.SS1.SSS0.Px2.p3.m8" class="ltx_Math" alttext="\pi_{n}(\mathbf{x})a\,2^{N-n}\equiv\pi_{m}(\mathbf{x})b\,2^{N-m}\pmod{2^{N}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msup><mn> 2</mn><mrow><mi>N</mi><mo>−</mo><mi>n</mi></mrow></msup></mrow><mo>≡</mo><mrow><mrow><msub><mi>π</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><msup><mn> 2</mn><mrow><mi>N</mi><mo>−</mo><mi>m</mi></mrow></msup></mrow><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0.167em">mod</mo><msup><mn>2</mn><mi>N</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi_{n}(\mathbf{x})a\,2^{N-n}\equiv\pi_{m}(\mathbf{x})b\,2^{N-m}\pmod{2^{N}}</annotation></semantics></math>.
Since <math id="S3.SS1.SSS0.Px2.p3.m9" class="ltx_Math" alttext="\mathbf{x}\in X" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">\mathbf{x}\in X</annotation></semantics></math>, by definition of the inverse limit, the coordinates of <math id="S3.SS1.SSS0.Px2.p3.m10" class="ltx_Math" alttext="\mathbf{x}\in X" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">\mathbf{x}\in X</annotation></semantics></math> respectively satisfy <math id="S3.SS1.SSS0.Px2.p3.m11" class="ltx_Math" alttext="\pi_{n}(\mathbf{x})\equiv\pi_{N}(\mathbf{x})\pmod{2^{n}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≡</mo><mrow><mrow><msub><mi>π</mi><mi>N</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0.167em">mod</mo><msup><mn>2</mn><mi>n</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi_{n}(\mathbf{x})\equiv\pi_{N}(\mathbf{x})\pmod{2^{n}}</annotation></semantics></math> and <math id="S3.SS1.SSS0.Px2.p3.m12" class="ltx_Math" alttext="\pi_{m}(\mathbf{x})\equiv\pi_{N}(\mathbf{x})\pmod{2^{m}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≡</mo><mrow><mrow><msub><mi>π</mi><mi>N</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0.167em">mod</mo><msup><mn>2</mn><mi>m</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi_{m}(\mathbf{x})\equiv\pi_{N}(\mathbf{x})\pmod{2^{m}}</annotation></semantics></math>.
Thus, there exist integers <math id="S3.SS1.SSS0.Px2.p3.m13" class="ltx_Math" alttext="k,\ell" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><annotation encoding="application/x-tex">k,\ell</annotation></semantics></math> such that <math id="S3.SS1.SSS0.Px2.p3.m14" class="ltx_Math" alttext="\pi_{n}(\mathbf{x})=\pi_{N}(\mathbf{x})+2^{n}k" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>π</mi><mi>N</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mn>2</mn><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi_{n}(\mathbf{x})=\pi_{N}(\mathbf{x})+2^{n}k</annotation></semantics></math> and <math id="S3.SS1.SSS0.Px2.p3.m15" class="ltx_Math" alttext="\pi_{m}(\mathbf{x})=\pi_{N}(\mathbf{x})+2^{m}\ell" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>π</mi><mi>N</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mn>2</mn><mi>m</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi_{m}(\mathbf{x})=\pi_{N}(\mathbf{x})+2^{m}\ell</annotation></semantics></math>.
Multiplying by <math id="S3.SS1.SSS0.Px2.p3.m16" class="ltx_Math" alttext="a\,2^{N-n}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msup><mn> 2</mn><mrow><mi>N</mi><mo>−</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">a\,2^{N-n}</annotation></semantics></math> and <math id="S3.SS1.SSS0.Px2.p3.m17" class="ltx_Math" alttext="b\,2^{N-m}" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><msup><mn> 2</mn><mrow><mi>N</mi><mo>−</mo><mi>m</mi></mrow></msup></mrow><annotation encoding="application/x-tex">b\,2^{N-m}</annotation></semantics></math> respectively gives</span></p>
<table id="S3.EGx12" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex83"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex83.m1" class="ltx_Math" alttext="\displaystyle\pi_{n}(\mathbf{x})a\,2^{N-n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msup><mn> 2</mn><mrow><mi>N</mi><mo>−</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle\pi_{n}(\mathbf{x})a\,2^{N-n}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex83.m2" class="ltx_Math" alttext="\displaystyle=\pi_{N}(\mathbf{x})a\,2^{N-n}+a\,2^{N}k\equiv\pi_{N}(\mathbf{x})a\,2^{N-n}\pmod{2^{N}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>π</mi><mi>N</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msup><mn> 2</mn><mrow><mi>N</mi><mo>−</mo><mi>n</mi></mrow></msup></mrow><mo>+</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msup><mn> 2</mn><mi>N</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mrow><mo>≡</mo><mrow><mrow><msub><mi>π</mi><mi>N</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msup><mn> 2</mn><mrow><mi>N</mi><mo>−</mo><mi>n</mi></mrow></msup></mrow><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" movablelimits="false" rspace="0.167em">mod</mo><msup><mn>2</mn><mi>N</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\pi_{N}(\mathbf{x})a\,2^{N-n}+a\,2^{N}k\equiv\pi_{N}(\mathbf{x})a\,2^{N-n}\pmod{2^{N}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex84"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex84.m1" class="ltx_Math" alttext="\displaystyle\pi_{m}(\mathbf{x})b\,2^{N-m}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><msup><mn> 2</mn><mrow><mi>N</mi><mo>−</mo><mi>m</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle\pi_{m}(\mathbf{x})b\,2^{N-m}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex84.m2" class="ltx_Math" alttext="\displaystyle=\pi_{N}(\mathbf{x})b\,2^{N-m}+b\,2^{N}\ell\equiv\pi_{N}(\mathbf{x})b\,2^{N-m}\pmod{2^{N}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>π</mi><mi>N</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><msup><mn> 2</mn><mrow><mi>N</mi><mo>−</mo><mi>m</mi></mrow></msup></mrow><mo>+</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><msup><mn> 2</mn><mi>N</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></mrow><mo>≡</mo><mrow><mrow><msub><mi>π</mi><mi>N</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><msup><mn> 2</mn><mrow><mi>N</mi><mo>−</mo><mi>m</mi></mrow></msup></mrow><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" movablelimits="false" rspace="0.167em">mod</mo><msup><mn>2</mn><mi>N</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\pi_{N}(\mathbf{x})b\,2^{N-m}+b\,2^{N}\ell\equiv\pi_{N}(\mathbf{x})b\,2^{N-m}\pmod{2^{N}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.SSS0.Px2.p3.6" class="ltx_p"><span id="S3.SS1.SSS0.Px2.p3.6.1" class="ltx_text">To conclude, multiply (<a href="#S3.E13" title="Equation 13 ‣ Proof. ‣ The dual group. ‣ 3.1 Some abstract harmonic analysis ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>) by <math id="S3.SS1.SSS0.Px2.p3.m18" class="ltx_Math" alttext="\pi_{N}(\mathbf{x})" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>N</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{N}(\mathbf{x})</annotation></semantics></math> to get</span></p>
<table id="S3.Ex85" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex85.m1" class="ltx_Math" alttext="\pi_{N}(\mathbf{x})a\,2^{N-n}\equiv\pi_{N}(\mathbf{x})b\,2^{N-m}\pmod{2^{N}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>π</mi><mi>N</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msup><mn> 2</mn><mrow><mi>N</mi><mo>−</mo><mi>n</mi></mrow></msup></mrow><mo>≡</mo><mrow><mrow><msub><mi>π</mi><mi>N</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><msup><mn> 2</mn><mrow><mi>N</mi><mo>−</mo><mi>m</mi></mrow></msup></mrow><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" movablelimits="false" rspace="0.167em">mod</mo><msup><mn>2</mn><mi>N</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\pi_{N}(\mathbf{x})a\,2^{N-n}\equiv\pi_{N}(\mathbf{x})b\,2^{N-m}\pmod{2^{N}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.SSS0.Px2.p3.7" class="ltx_p"><span id="S3.SS1.SSS0.Px2.p3.7.1" class="ltx_text">Combining these relations show that <math id="S3.SS1.SSS0.Px2.p3.m19" class="ltx_Math" alttext="\pi_{n}(\mathbf{x})a\,2^{N-n}\equiv\pi_{m}(\mathbf{x})b\,2^{N-m}\pmod{2^{N}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msup><mn> 2</mn><mrow><mi>N</mi><mo>−</mo><mi>n</mi></mrow></msup></mrow><mo>≡</mo><mrow><mrow><msub><mi>π</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><msup><mn> 2</mn><mrow><mi>N</mi><mo>−</mo><mi>m</mi></mrow></msup></mrow><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0.167em">mod</mo><msup><mn>2</mn><mi>N</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi_{n}(\mathbf{x})a\,2^{N-n}\equiv\pi_{m}(\mathbf{x})b\,2^{N-m}\pmod{2^{N}}</annotation></semantics></math>, as desired.</span></p>
</div>
<div id="S3.SS1.SSS0.Px2.p4" class="ltx_para">
<p id="S3.SS1.SSS0.Px2.p4.1" class="ltx_p"><span id="S3.SS1.SSS0.Px2.p4.1.1" class="ltx_text">Let us show the second item.
Let <math id="S3.SS1.SSS0.Px2.p4.m1" class="ltx_Math" alttext="r,s\in\widehat{X}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>r</mi><mo>,</mo><mi>s</mi></mrow><mo>∈</mo><mover accent="true"><mi>X</mi><mo>^</mo></mover></mrow><annotation encoding="application/x-tex">r,s\in\widehat{X}</annotation></semantics></math>. As before, choose a common denominator <math id="S3.SS1.SSS0.Px2.p4.m2" class="ltx_Math" alttext="2^{N}" display="inline" intent=":literal"><semantics><msup><mn>2</mn><mi>N</mi></msup><annotation encoding="application/x-tex">2^{N}</annotation></semantics></math> such that</span></p>
<table id="S3.Ex86" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex86.m1" class="ltx_Math" alttext="r=\frac{a}{2^{N}}+\mathbb{Z}\quad\text{ and }\quad s=\frac{b}{2^{N}}+\mathbb{Z}" display="block" intent=":literal"><semantics><mrow><mrow><mi>r</mi><mo>=</mo><mrow><mfrac><mi>a</mi><msup><mn>2</mn><mi>N</mi></msup></mfrac><mo>+</mo><mi>ℤ</mi></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext> and </mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mi>s</mi><mo>=</mo><mrow><mfrac><mi>b</mi><msup><mn>2</mn><mi>N</mi></msup></mfrac><mo>+</mo><mi>ℤ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">r=\frac{a}{2^{N}}+\mathbb{Z}\quad\text{ and }\quad s=\frac{b}{2^{N}}+\mathbb{Z}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.SSS0.Px2.p4.2" class="ltx_p"><span id="S3.SS1.SSS0.Px2.p4.2.1" class="ltx_text">for <math id="S3.SS1.SSS0.Px2.p4.m3" class="ltx_Math" alttext="a,b\in\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">a,b\in\mathbb{Z}</annotation></semantics></math>.
Then, for <math id="S3.SS1.SSS0.Px2.p4.m4" class="ltx_Math" alttext="\mathbf{x}\in X" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">\mathbf{x}\in X</annotation></semantics></math>, we have</span></p>
<table id="S3.Ex87" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex87.m1" class="ltx_Math" alttext="P_{\mathbf{x}}(r+s)=P_{\mathbf{x}}\!\left(\frac{a+b}{2^{N}}+\mathbb{Z}\right)=\frac{\pi_{N}(\mathbf{x})(a+b)}{2^{N}}+\mathbb{Z}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>P</mi><mi>𝐱</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>+</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>P</mi><mi>𝐱</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><msup><mn>2</mn><mi>N</mi></msup></mfrac><mo>+</mo><mi>ℤ</mi></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mrow><msub><mi>π</mi><mi>N</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><msup><mn>2</mn><mi>N</mi></msup></mfrac><mo>+</mo><mi>ℤ</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">P_{\mathbf{x}}(r+s)=P_{\mathbf{x}}\!\left(\frac{a+b}{2^{N}}+\mathbb{Z}\right)=\frac{\pi_{N}(\mathbf{x})(a+b)}{2^{N}}+\mathbb{Z},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.SSS0.Px2.p4.3" class="ltx_p"><span id="S3.SS1.SSS0.Px2.p4.3.1" class="ltx_text">while</span></p>
<table id="S3.Ex88" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex88.m1" class="ltx_Math" alttext="P_{\mathbf{x}}(r)+P_{\mathbf{x}}(s)=\frac{\pi_{N}(\mathbf{x})a}{2^{N}}+\mathbb{Z}+\frac{\pi_{N}(\mathbf{x})b}{2^{N}}+\mathbb{Z}=\frac{\pi_{N}(\mathbf{x})(a+b)}{2^{N}}+\mathbb{Z}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>P</mi><mi>𝐱</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>P</mi><mi>𝐱</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mfrac><mrow><msub><mi>π</mi><mi>N</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><msup><mn>2</mn><mi>N</mi></msup></mfrac><mo>+</mo><mi>ℤ</mi><mo>+</mo><mfrac><mrow><msub><mi>π</mi><mi>N</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow><msup><mn>2</mn><mi>N</mi></msup></mfrac><mo>+</mo><mi>ℤ</mi></mrow><mo>=</mo><mrow><mfrac><mrow><msub><mi>π</mi><mi>N</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><msup><mn>2</mn><mi>N</mi></msup></mfrac><mo>+</mo><mi>ℤ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P_{\mathbf{x}}(r)+P_{\mathbf{x}}(s)=\frac{\pi_{N}(\mathbf{x})a}{2^{N}}+\mathbb{Z}+\frac{\pi_{N}(\mathbf{x})b}{2^{N}}+\mathbb{Z}=\frac{\pi_{N}(\mathbf{x})(a+b)}{2^{N}}+\mathbb{Z}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.SSS0.Px2.p4.4" class="ltx_p"><span id="S3.SS1.SSS0.Px2.p4.4.1" class="ltx_text">Thus <math id="S3.SS1.SSS0.Px2.p4.m5" class="ltx_Math" alttext="P_{\mathbf{x}}(r+s)=P_{\mathbf{x}}(r)+P_{\mathbf{x}}(s)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mi>𝐱</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>+</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>P</mi><mi>𝐱</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>P</mi><mi>𝐱</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">P_{\mathbf{x}}(r+s)=P_{\mathbf{x}}(r)+P_{\mathbf{x}}(s)</annotation></semantics></math>, and <math id="S3.SS1.SSS0.Px2.p4.m6" class="ltx_Math" alttext="P_{\mathbf{x}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>𝐱</mi></msub><annotation encoding="application/x-tex">P_{\mathbf{x}}</annotation></semantics></math> is a group homomorphism.</span></p>
</div>
<div id="S3.SS1.SSS0.Px2.p5" class="ltx_para">
<p id="S3.SS1.SSS0.Px2.p5.1" class="ltx_p"><span id="S3.SS1.SSS0.Px2.p5.1.1" class="ltx_text">Finally, consider the third item of the statement.
Let <math id="S3.SS1.SSS0.Px2.p5.m1" class="ltx_Math" alttext="r=\frac{a}{2^{n}}+\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mrow><mfrac><mi>a</mi><msup><mn>2</mn><mi>n</mi></msup></mfrac><mo>+</mo><mi>ℤ</mi></mrow></mrow><annotation encoding="application/x-tex">r=\frac{a}{2^{n}}+\mathbb{Z}</annotation></semantics></math> with <math id="S3.SS1.SSS0.Px2.p5.m2" class="ltx_Math" alttext="a\in\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">a\in\mathbb{Z}</annotation></semantics></math> and <math id="S3.SS1.SSS0.Px2.p5.m3" class="ltx_Math" alttext="n\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n\geq 0</annotation></semantics></math>.
Fix <math id="S3.SS1.SSS0.Px2.p5.m4" class="ltx_Math" alttext="\mathbf{x},\mathbf{y}\in X" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow><mo>∈</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">\mathbf{x},\mathbf{y}\in X</annotation></semantics></math>.
Since multiplication in <math id="S3.SS1.SSS0.Px2.p5.m5" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is coordinate-wise,
<math id="S3.SS1.SSS0.Px2.p5.m6" class="ltx_Math" alttext="\pi_{n}(\mathbf{x}\mathbf{y})=\pi_{n}(\mathbf{x})\pi_{n}(\mathbf{y})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱𝐲</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>π</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi_{n}(\mathbf{x}\mathbf{y})=\pi_{n}(\mathbf{x})\pi_{n}(\mathbf{y})</annotation></semantics></math>
in <math id="S3.SS1.SSS0.Px2.p5.m7" class="ltx_Math" alttext="\mathbb{Z}/2^{n}\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℤ</mi><mo>/</mo><msup><mn>2</mn><mi>n</mi></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">\mathbb{Z}/2^{n}\mathbb{Z}</annotation></semantics></math>.
Hence</span></p>
<table id="S3.Ex89" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex89.m1" class="ltx_Math" alttext="P_{\mathbf{x}\mathbf{y}}(r)=\frac{\pi_{n}(\mathbf{x}\mathbf{y})a}{2^{n}}+\mathbb{Z}=\frac{\pi_{n}(\mathbf{x})\pi_{n}(\mathbf{y})a}{2^{n}}+\mathbb{Z}=P_{\mathbf{x}}(P_{\mathbf{y}}(r))." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>P</mi><mi>𝐱𝐲</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mrow><msub><mi>π</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱𝐲</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><msup><mn>2</mn><mi>n</mi></msup></mfrac><mo>+</mo><mi>ℤ</mi></mrow><mo>=</mo><mrow><mfrac><mrow><msub><mi>π</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><msup><mn>2</mn><mi>n</mi></msup></mfrac><mo>+</mo><mi>ℤ</mi></mrow><mo>=</mo><mrow><msub><mi>P</mi><mi>𝐱</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>P</mi><mi>𝐲</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P_{\mathbf{x}\mathbf{y}}(r)=\frac{\pi_{n}(\mathbf{x}\mathbf{y})a}{2^{n}}+\mathbb{Z}=\frac{\pi_{n}(\mathbf{x})\pi_{n}(\mathbf{y})a}{2^{n}}+\mathbb{Z}=P_{\mathbf{x}}(P_{\mathbf{y}}(r)).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.SSS0.Px2.p5.2" class="ltx_p"><span id="S3.SS1.SSS0.Px2.p5.2.1" class="ltx_text">This finishes the proof.
∎</span></p>
</div>
</div>
</section>
<section id="S3.SS1.SSS0.Px3" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Characters.</h4>

<div id="S3.SS1.SSS0.Px3.p1" class="ltx_para">
<p id="S3.SS1.SSS0.Px3.p1.1" class="ltx_p">Recall that characters of <math id="S3.SS1.SSS0.Px3.p1.m1" class="ltx_Math" alttext="\widehat{X}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>X</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\widehat{X}</annotation></semantics></math> are indexed by elements of <math id="S3.SS1.SSS0.Px3.p1.m2" class="ltx_Math" alttext="\mathbb{Q}[1/2]/\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℚ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>/</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">\mathbb{Q}[1/2]/\mathbb{Z}</annotation></semantics></math>. We now describe them. For all <math id="S3.SS1.SSS0.Px3.p1.m3" class="ltx_Math" alttext="r\in\mathbb{Q}[1/2]/\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>∈</mo><mrow><mrow><mi>ℚ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>/</mo><mi>ℤ</mi></mrow></mrow><annotation encoding="application/x-tex">r\in\mathbb{Q}[1/2]/\mathbb{Z}</annotation></semantics></math>, we define the map <math id="S3.SS1.SSS0.Px3.p1.m4" class="ltx_Math" alttext="\chi_{r}\colon X\to\mathbb{C}" display="inline" intent=":literal"><semantics><mrow><msub><mi>χ</mi><mi>r</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>X</mi><mo stretchy="false">→</mo><mi>ℂ</mi></mrow></mrow><annotation encoding="application/x-tex">\chi_{r}\colon X\to\mathbb{C}</annotation></semantics></math> by</p>
<table id="S3.Ex90" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex90.m1" class="ltx_Math" alttext="\chi_{r}:\mathbf{x}\mapsto e(P_{\mathbf{x}}(r))," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>χ</mi><mi>r</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>𝐱</mi><mo stretchy="false">↦</mo><mrow><mi>e</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>P</mi><mi>𝐱</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\chi_{r}:\mathbf{x}\mapsto e(P_{\mathbf{x}}(r)),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.SSS0.Px3.p1.2" class="ltx_p">where <math id="S3.SS1.SSS0.Px3.p1.m5" class="ltx_Math" alttext="e(\alpha)=\exp(2\pi i\,\alpha)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>e</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">e(\alpha)=\exp(2\pi i\,\alpha)</annotation></semantics></math> is the classical complex exponentiation. These maps are indeed group homomorphisms.
For <math id="S3.SS1.SSS0.Px3.p1.m6" class="ltx_Math" alttext="r=\frac{a}{2^{n}}+\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mrow><mfrac><mi>a</mi><msup><mn>2</mn><mi>n</mi></msup></mfrac><mo>+</mo><mi>ℤ</mi></mrow></mrow><annotation encoding="application/x-tex">r=\frac{a}{2^{n}}+\mathbb{Z}</annotation></semantics></math> with <math id="S3.SS1.SSS0.Px3.p1.m7" class="ltx_Math" alttext="a\in\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">a\in\mathbb{Z}</annotation></semantics></math> and <math id="S3.SS1.SSS0.Px3.p1.m8" class="ltx_Math" alttext="n\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n\geq 0</annotation></semantics></math> and all <math id="S3.SS1.SSS0.Px3.p1.m9" class="ltx_Math" alttext="\mathbf{x},\mathbf{y}\in X" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow><mo>∈</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">\mathbf{x},\mathbf{y}\in X</annotation></semantics></math>, we have</p>
<table id="S3.Ex91" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex91.m1" class="ltx_Math" alttext="\chi_{r}(\mathbf{x}+\mathbf{y})=e\left(\frac{\pi_{n}(\mathbf{x}+\mathbf{y})a}{2^{n}}\right)=\chi_{r}(\mathbf{x})\chi_{r}(\mathbf{y})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>χ</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐱</mi><mo>+</mo><mi>𝐲</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>e</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msub><mi>π</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐱</mi><mo>+</mo><mi>𝐲</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><msup><mn>2</mn><mi>n</mi></msup></mfrac><mo>)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>χ</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>χ</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\chi_{r}(\mathbf{x}+\mathbf{y})=e\left(\frac{\pi_{n}(\mathbf{x}+\mathbf{y})a}{2^{n}}\right)=\chi_{r}(\mathbf{x})\chi_{r}(\mathbf{y}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.SSS0.Px3.p1.3" class="ltx_p">since <math id="S3.SS1.SSS0.Px3.p1.m10" class="ltx_Math" alttext="\pi_{n}(\mathbf{x}+\mathbf{y})\equiv\pi_{n}(\mathbf{x})+\pi_{n}(\mathbf{y})\pmod{2^{n}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐱</mi><mo>+</mo><mi>𝐲</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≡</mo><mrow><mrow><mrow><msub><mi>π</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>π</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0.167em">mod</mo><msup><mn>2</mn><mi>n</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi_{n}(\mathbf{x}+\mathbf{y})\equiv\pi_{n}(\mathbf{x})+\pi_{n}(\mathbf{y})\pmod{2^{n}}</annotation></semantics></math>.
They are useful in our setting because we will apply them to some averaging operator <math id="S3.SS1.SSS0.Px3.p1.m11" class="ltx_Math" alttext="\Lop" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\Lop</annotation></semantics></math>.
These are the continuous characters of <math id="S3.SS1.SSS0.Px3.p1.m12" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>.
Further, we check using <a href="#Thmtheorem22" title="Lemma 22. ‣ The dual group. ‣ 3.1 Some abstract harmonic analysis ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">22</span></a> that</p>
<table id="S3.E14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(14)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E14.m1" class="ltx_Math" alttext="\chi_{r}(\mathbf{x}\mathbf{y})=e(P_{\mathbf{x}\mathbf{y}}(r))=e(P_{\mathbf{y}\mathbf{x}}(r))=e(P_{\mathbf{y}}(P_{\mathbf{x}}(r)))=\chi_{P_{\mathbf{x}}(r)}(\mathbf{y})" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>χ</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱𝐲</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>e</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>P</mi><mi>𝐱𝐲</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>e</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>P</mi><mi>𝐲𝐱</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>e</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>P</mi><mi>𝐲</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>P</mi><mi>𝐱</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>χ</mi><mrow><msub><mi>P</mi><mi>𝐱</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\chi_{r}(\mathbf{x}\mathbf{y})=e(P_{\mathbf{x}\mathbf{y}}(r))=e(P_{\mathbf{y}\mathbf{x}}(r))=e(P_{\mathbf{y}}(P_{\mathbf{x}}(r)))=\chi_{P_{\mathbf{x}}(r)}(\mathbf{y})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.SSS0.Px3.p1.4" class="ltx_p">for all <math id="S3.SS1.SSS0.Px3.p1.m13" class="ltx_Math" alttext="r\in\mathbb{Q}[1/2]/\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>∈</mo><mrow><mrow><mi>ℚ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>/</mo><mi>ℤ</mi></mrow></mrow><annotation encoding="application/x-tex">r\in\mathbb{Q}[1/2]/\mathbb{Z}</annotation></semantics></math> and all <math id="S3.SS1.SSS0.Px3.p1.m14" class="ltx_Math" alttext="\mathbf{x},\mathbf{y}\in X" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi></mrow><mo>∈</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">\mathbf{x},\mathbf{y}\in X</annotation></semantics></math>.</p>
</div>
</section>
<section id="S3.SS1.SSS0.Px4" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Pontryagin duality.</h4>

<div id="S3.SS1.SSS0.Px4.p1" class="ltx_para">
<p id="S3.SS1.SSS0.Px4.p1.1" class="ltx_p">Let <math id="S3.SS1.SSS0.Px4.p1.m1" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math> be the <em id="S3.SS1.SSS0.Px4.p1.1.1" class="ltx_emph ltx_font_italic">normalized Haar measure</em> on <math id="S3.SS1.SSS0.Px4.p1.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>, which is a <em id="S3.SS1.SSS0.Px4.p1.1.2" class="ltx_emph ltx_font_italic">Borel probability measure</em><span id="footnote3" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">3</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">3</sup>
                <span class="ltx_tag ltx_tag_note">3</span>
                
                
                
                
                
                
                
              Note that every locally compact group admits a Haar measure that is unique up to a scalar constant. In addition, every normalized Haar measure is a Borel probability measure, but not every Borel probability measure is Haar.</span></span></span>.
Pontryagin duality (Plancherel theorem for compact abelian groups) <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib43" title="" class="ltx_ref">45</a>]</cite>
states that <math id="S3.SS1.SSS0.Px4.p1.m3" class="ltx_Math" alttext="\{\chi_{r}:r\in\widehat{X}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>χ</mi><mi>r</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>r</mi><mo>∈</mo><mover accent="true"><mi>X</mi><mo>^</mo></mover></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\chi_{r}:r\in\widehat{X}\}</annotation></semantics></math> is an orthonormal basis of the Hilbert space
<math id="S3.SS1.SSS0.Px4.p1.m4" class="ltx_Math" alttext="L^{2}(X,\mu)" display="inline" intent=":literal"><semantics><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L^{2}(X,\mu)</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">23</a>, Cor. 4.27]</cite>. Thus, every <math id="S3.SS1.SSS0.Px4.p1.m5" class="ltx_Math" alttext="\delta\in L^{2}(X,\mu)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\delta\in L^{2}(X,\mu)</annotation></semantics></math> has a unique <em id="S3.SS1.SSS0.Px4.p1.1.3" class="ltx_emph ltx_font_italic">Fourier expansion</em></p>
<table id="S3.E15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(15)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E15.m1" class="ltx_Math" alttext="\delta(\mathbf{x})=\sum_{r\in\widehat{X}}\hat{\delta}(r)\,\chi_{r}(\mathbf{x})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>∈</mo><mover accent="true"><mi>X</mi><mo>^</mo></mover></mrow></munder><mrow><mover accent="true"><mi>δ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>χ</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\delta(\mathbf{x})=\sum_{r\in\widehat{X}}\hat{\delta}(r)\,\chi_{r}(\mathbf{x}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.SSS0.Px4.p1.2" class="ltx_p">where <math id="S3.SS1.SSS0.Px4.p1.m6" class="ltx_Math" alttext="\hat{\delta}(r)\in\mathbb{C}" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>δ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mi>ℂ</mi></mrow><annotation encoding="application/x-tex">\hat{\delta}(r)\in\mathbb{C}</annotation></semantics></math> are the <span id="S3.SS1.SSS0.Px4.p1.2.1" class="ltx_text ltx_font_italic">Fourier coefficients</span> of <math id="S3.SS1.SSS0.Px4.p1.m7" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>.
This expansion satisfies <span id="S3.SS1.SSS0.Px4.p1.2.2" class="ltx_text ltx_font_italic">Parseval’s identity</span> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">23</a>, Prop. 4.25, Thm. 4.26]</cite> that reads</p>
<table id="S3.E16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(16)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E16.m1" class="ltx_Math" alttext="\|\delta\|_{2}^{2}:=\int_{X}|\delta(x)|^{2}\,\mathrm{d}\mu(\mathbf{x})=\sum_{r\in\widehat{X}}|\hat{\delta}(r)|^{2}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mi>δ</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo rspace="0.111em">:=</mo><mrow><msub><mo rspace="0em">∫</mo><mi>X</mi></msub><mrow><msup><mrow><mo stretchy="false">|</mo><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>μ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>r</mi><mo>∈</mo><mover accent="true"><mi>X</mi><mo>^</mo></mover></mrow></munder><msup><mrow><mo stretchy="false">|</mo><mrow><mover accent="true"><mi>δ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\delta\|_{2}^{2}:=\int_{X}|\delta(x)|^{2}\,\mathrm{d}\mu(\mathbf{x})=\sum_{r\in\widehat{X}}|\hat{\delta}(r)|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
</section>
<section id="S3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.2 </span>Proof of <a href="#Thmtheorem20" title="Proposition 20. ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">20</span></a></h3>

<div id="S3.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of <a href="#Thmtheorem20" title="Proposition 20. ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">20</span></a>.</h6>
<div id="S3.SS2.p1" class="ltx_para">
<p id="S3.SS2.p1.1" class="ltx_p"><span id="S3.SS2.p1.1.1" class="ltx_text">We split the proof into several main steps.</span></p>
</div>
<div id="S3.SS2.p2" class="ltx_para">
<p id="S3.SS2.p2.1" class="ltx_p"><span id="S3.SS2.p2.1.1" class="ltx_text ltx_font_bold">Reformulating via a difference function.<span id="S3.SS2.p2.1.1.1" class="ltx_text ltx_font_medium"> Define <math id="S3.SS2.p2.m1" class="ltx_Math" alttext="\delta_{n}:X\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>δ</mi><mi>n</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>X</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">\delta_{n}:X\to\mathbb{R}</annotation></semantics></math> by</span></span></p>
<table id="S3.Ex92" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex92.m1" class="ltx_Math" alttext="\delta_{n}(\mathbf{x}):=2^{n}\bigl(\mu_{n}({\tt 0},\pi_{n}(\mathbf{x}))-\mu_{n}({\tt 1},\pi_{n}(\mathbf{x}))\bigr),\quad\text{for $\mathbf{x}\in X$.}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>δ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><msup><mn>2</mn><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟶</mn><mo>,</mo><mrow><msub><mi>π</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟷</mn><mo>,</mo><mrow><msub><mi>π</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mtext>for </mtext><mrow><mi>𝐱</mi><mo>∈</mo><mi>X</mi></mrow><mtext>.</mtext></mrow></mrow><annotation encoding="application/x-tex">\delta_{n}(\mathbf{x}):=2^{n}\bigl(\mu_{n}({\tt 0},\pi_{n}(\mathbf{x}))-\mu_{n}({\tt 1},\pi_{n}(\mathbf{x}))\bigr),\quad\text{for $\mathbf{x}\in X$.}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p2.2" class="ltx_p"><span id="S3.SS2.p2.2.1" class="ltx_text">Observe that <math id="S3.SS2.p2.m2" class="ltx_Math" alttext="\delta_{n}\equiv 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>δ</mi><mi>n</mi></msub><mo>≡</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta_{n}\equiv 0</annotation></semantics></math> (is identically zero) if and only if <math id="S3.SS2.p2.m3" class="ltx_Math" alttext="\mu_{n}({\tt 0},k)=\mu_{n}({\tt 1},k)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟶</mn><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟷</mn><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu_{n}({\tt 0},k)=\mu_{n}({\tt 1},k)</annotation></semantics></math> for all residue classes <math id="S3.SS2.p2.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> modulo <math id="S3.SS2.p2.m5" class="ltx_Math" alttext="2^{n}" display="inline" intent=":literal"><semantics><msup><mn>2</mn><mi>n</mi></msup><annotation encoding="application/x-tex">2^{n}</annotation></semantics></math>.
Hence, thanks to <math id="S3.SS2.p2.m6" class="ltx_Math" alttext="(P_{3})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(P_{3})</annotation></semantics></math>, <math id="S3.SS2.p2.m7" class="ltx_Math" alttext="\delta_{n}\equiv 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>δ</mi><mi>n</mi></msub><mo>≡</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta_{n}\equiv 0</annotation></semantics></math> if and only if <math id="S3.SS2.p2.m8" class="ltx_Math" alttext="\mu_{n}(a,k)=2^{-n-1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mn>2</mn><mrow><mrow><mo>−</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\mu_{n}(a,k)=2^{-n-1}</annotation></semantics></math> for all <math id="S3.SS2.p2.m9" class="ltx_Math" alttext="n,a,k" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>,</mo><mi>a</mi><mo>,</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">n,a,k</annotation></semantics></math>.
Thus, our goal is to prove that the hypothesis on <math id="S3.SS2.p2.m10" class="ltx_Math" alttext="\mu_{n}" display="inline" intent=":literal"><semantics><msub><mi>μ</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mu_{n}</annotation></semantics></math> forces <math id="S3.SS2.p2.m11" class="ltx_Math" alttext="\delta_{n}\equiv 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>δ</mi><mi>n</mi></msub><mo>≡</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta_{n}\equiv 0</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS2.p3" class="ltx_para">
<p id="S3.SS2.p3.1" class="ltx_p"><span id="S3.SS2.p3.1.1" class="ltx_text ltx_font_bold">Uniform Bound on <math id="S3.SS2.p3.m1" class="ltx_Math" alttext="\delta_{n}" display="inline" intent=":literal"><semantics><msub><mi>δ</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\delta_{n}</annotation></semantics></math>.<span id="S3.SS2.p3.1.1.1" class="ltx_text ltx_font_medium"> By <math id="S3.SS2.p3.m2" class="ltx_Math" alttext="(P_{3})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(P_{3})</annotation></semantics></math>, we have</span></span></p>
<table id="S3.E17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(17)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E17.m1" class="ltx_Math" alttext="|\delta_{n}(\mathbf{x})|\leq 1,\quad\text{ for all }\mathbf{x}\in X." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi>δ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mn>1</mn></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mtext> for all </mtext><mo lspace="0em" rspace="0em">​</mo><mi>𝐱</mi></mrow><mo>∈</mo><mi>X</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|\delta_{n}(\mathbf{x})|\leq 1,\quad\text{ for all }\mathbf{x}\in X.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p3.2" class="ltx_p"><span id="S3.SS2.p3.2.1" class="ltx_text">Indeed, <math id="S3.SS2.p3.m3" class="ltx_Math" alttext="\mu_{n}(a,k)" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu_{n}(a,k)</annotation></semantics></math> is nonnegative and by <math id="S3.SS2.p3.m4" class="ltx_Math" alttext="(P_{3})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(P_{3})</annotation></semantics></math>, <math id="S3.SS2.p3.m5" class="ltx_Math" alttext="\mu_{n}({\tt 0},k)+\mu_{n}({\tt 1},k)=2^{-n}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟶</mn><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟷</mn><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><msup><mn>2</mn><mrow><mo>−</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mu_{n}({\tt 0},k)+\mu_{n}({\tt 1},k)=2^{-n}</annotation></semantics></math>. So each is between <math id="S3.SS2.p3.m6" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> and <math id="S3.SS2.p3.m7" class="ltx_Math" alttext="2^{-n}" display="inline" intent=":literal"><semantics><msup><mn>2</mn><mrow><mo>−</mo><mi>n</mi></mrow></msup><annotation encoding="application/x-tex">2^{-n}</annotation></semantics></math>. Hence, the difference <math id="S3.SS2.p3.m8" class="ltx_Math" alttext="\mu_{n}({\tt 0},\pi_{n}(x))-\mu_{n}({\tt 1},\pi_{n}(x))" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟶</mn><mo>,</mo><mrow><msub><mi>π</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟷</mn><mo>,</mo><mrow><msub><mi>π</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu_{n}({\tt 0},\pi_{n}(x))-\mu_{n}({\tt 1},\pi_{n}(x))</annotation></semantics></math> is in <math id="S3.SS2.p3.m9" class="ltx_Math" alttext="[-2^{-n},2^{-n}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><msup><mn>2</mn><mrow><mo>−</mo><mi>n</mi></mrow></msup></mrow><mo>,</mo><msup><mn>2</mn><mrow><mo>−</mo><mi>n</mi></mrow></msup></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[-2^{-n},2^{-n}]</annotation></semantics></math>. The conclusion follows multiplying by <math id="S3.SS2.p3.m10" class="ltx_Math" alttext="2^{n}" display="inline" intent=":literal"><semantics><msup><mn>2</mn><mi>n</mi></msup><annotation encoding="application/x-tex">2^{n}</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS2.p4" class="ltx_para">
<p id="S3.SS2.p4.1" class="ltx_p"><span id="S3.SS2.p4.1.1" class="ltx_text ltx_font_bold">Translating the recurrence into an operator equation.<span id="S3.SS2.p4.1.1.1" class="ltx_text ltx_font_medium"> We now convert the recurrence <math id="S3.SS2.p4.m1" class="ltx_Math" alttext="(P_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(P_{2})</annotation></semantics></math> into a functional equation for <math id="S3.SS2.p4.m2" class="ltx_Math" alttext="\delta_{n}" display="inline" intent=":literal"><semantics><msub><mi>δ</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\delta_{n}</annotation></semantics></math>, which is relevant thanks to the lift to the <math id="S3.SS2.p4.m3" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-adic integers. Let <math id="S3.SS2.p4.m4" class="ltx_Math" alttext="\mathbf{3}=(3)_{n\geq 0}\in X" display="inline" intent=":literal"><semantics><mrow><mn>𝟑</mn><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></msub><mo>∈</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">\mathbf{3}=(3)_{n\geq 0}\in X</annotation></semantics></math>; because each coordinate is odd, it has a multiplicative inverse
<math id="S3.SS2.p4.m5" class="ltx_Math" alttext="\mathbf{q}=(q_{n})_{n\geq 0}" display="inline" intent=":literal"><semantics><mrow><mi>𝐪</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbf{q}=(q_{n})_{n\geq 0}</annotation></semantics></math> in <math id="S3.SS2.p4.m6" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. The recurrence of <math id="S3.SS2.p4.m7" class="ltx_Math" alttext="(P_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(P_{2})</annotation></semantics></math> becomes</span></span></p>
<table id="S3.Ex93" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex93.m1" class="ltx_Math" alttext="\delta_{n}(\mathbf{x})=\sum_{0\leq j&lt;3}c_{j}\,\delta_{n+1}(2\mathbf{q}\mathbf{x}-j\mathbf{q})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>δ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mn>0</mn><mo>≤</mo><mi>j</mi><mo>&lt;</mo><mn>3</mn></mrow></munder><mrow><msub><mi>c</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪𝐱</mi></mrow><mo>−</mo><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\delta_{n}(\mathbf{x})=\sum_{0\leq j&lt;3}c_{j}\,\delta_{n+1}(2\mathbf{q}\mathbf{x}-j\mathbf{q}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p4.2" class="ltx_p"><span id="S3.SS2.p4.2.1" class="ltx_text">where <math id="S3.SS2.p4.m8" class="ltx_Math" alttext="c_{0}=-c_{1}=c_{2}=1/3" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>0</mn></msub><mo>=</mo><mrow><mo>−</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><mo>=</mo><msub><mi>c</mi><mn>2</mn></msub><mo>=</mo><mrow><mn>1</mn><mo>/</mo><mn>3</mn></mrow></mrow><annotation encoding="application/x-tex">c_{0}=-c_{1}=c_{2}=1/3</annotation></semantics></math>. Indeed, multiply the difference <math id="S3.SS2.p4.m9" class="ltx_Math" alttext="\frac{3}{2}\mu_{n}({\tt 0},k)-\frac{3}{2}\mu_{n}({\tt 1},k)" display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mn>3</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟶</mn><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mfrac><mn>3</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟷</mn><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{3}{2}\mu_{n}({\tt 0},k)-\frac{3}{2}\mu_{n}({\tt 1},k)</annotation></semantics></math> by <math id="S3.SS2.p4.m10" class="ltx_Math" alttext="2^{n+1}" display="inline" intent=":literal"><semantics><msup><mn>2</mn><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">2^{n+1}</annotation></semantics></math> and apply <math id="S3.SS2.p4.m11" class="ltx_Math" alttext="(P_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(P_{2})</annotation></semantics></math>.
Since <math id="S3.SS2.p4.m12" class="ltx_Math" alttext="\delta_{n}" display="inline" intent=":literal"><semantics><msub><mi>δ</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\delta_{n}</annotation></semantics></math> is obtained as a linear combination of <math id="S3.SS2.p4.m13" class="ltx_Math" alttext="\delta_{n+1}" display="inline" intent=":literal"><semantics><msub><mi>δ</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\delta_{n+1}</annotation></semantics></math>, this motivates defining an operator <math id="S3.SS2.p4.m14" class="ltx_Math" alttext="\Lop" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\Lop</annotation></semantics></math> that acts on functions
<math id="S3.SS2.p4.m15" class="ltx_Math" alttext="\delta:X\to\mathbb{C}" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>X</mi><mo stretchy="false">→</mo><mi>ℂ</mi></mrow></mrow><annotation encoding="application/x-tex">\delta:X\to\mathbb{C}</annotation></semantics></math> by</span></p>
<table id="S3.Ex94" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex94.m1" class="ltx_Math" alttext="(\Lop\delta)(\mathbf{x})=\sum_{0\leq j&lt;3}c_{j}\,\delta(2\mathbf{q}\mathbf{x}-j\mathbf{q})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0.167em">⁡</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mn>0</mn><mo>≤</mo><mi>j</mi><mo>&lt;</mo><mn>3</mn></mrow></munder><mrow><msub><mi>c</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪𝐱</mi></mrow><mo>−</mo><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(\Lop\delta)(\mathbf{x})=\sum_{0\leq j&lt;3}c_{j}\,\delta(2\mathbf{q}\mathbf{x}-j\mathbf{q}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p4.3" class="ltx_p"><span id="S3.SS2.p4.3.1" class="ltx_text">Then, <math id="S3.SS2.p4.m16" class="ltx_Math" alttext="\delta_{n}=\Lop\delta_{n+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>δ</mi><mi>n</mi></msub><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0.167em">⁡</mo><msub><mi>δ</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\delta_{n}=\Lop\delta_{n+1}</annotation></semantics></math> and iterating,</span></p>
<table id="S3.Ex95" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex95.m1" class="ltx_Math" alttext="\delta_{n}=\Lop^{k}\delta_{n+k}\quad\text{for all $n,k\geq 0$.}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>δ</mi><mi>n</mi></msub><mo>=</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>k</mi></msup><mo lspace="0.167em">⁡</mo><msub><mi>δ</mi><mrow><mi>n</mi><mo>+</mo><mi>k</mi></mrow></msub></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mtext>for all </mtext><mrow><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow><mo>≥</mo><mn>0</mn></mrow><mtext>.</mtext></mrow></mrow><annotation encoding="application/x-tex">\delta_{n}=\Lop^{k}\delta_{n+k}\quad\text{for all $n,k\geq 0$.}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p4.4" class="ltx_p"><span id="S3.SS2.p4.4.1" class="ltx_text">If we can show that repeated applications of <math id="S3.SS2.p4.m17" class="ltx_Math" alttext="\Lop" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\Lop</annotation></semantics></math> shrink any function in a suitable norm, then the only way <math id="S3.SS2.p4.m18" class="ltx_Math" alttext="\delta_{n}=\Lop^{k}\delta_{n+k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>δ</mi><mi>n</mi></msub><mo>=</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>k</mi></msup><mo lspace="0.167em">⁡</mo><msub><mi>δ</mi><mrow><mi>n</mi><mo>+</mo><mi>k</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\delta_{n}=\Lop^{k}\delta_{n+k}</annotation></semantics></math> can hold, for all <math id="S3.SS2.p4.m19" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, is if <math id="S3.SS2.p4.m20" class="ltx_Math" alttext="\delta_{n}" display="inline" intent=":literal"><semantics><msub><mi>δ</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\delta_{n}</annotation></semantics></math> is zero.</span></p>
</div>
<div id="S3.SS2.p5" class="ltx_para">
<p id="S3.SS2.p5.1" class="ltx_p"><span id="S3.SS2.p5.1.1" class="ltx_text">Let <math id="S3.SS2.p5.m1" class="ltx_Math" alttext="\mathbf{2}=(2)_{n\geq 0}\in X" display="inline" intent=":literal"><semantics><mrow><mn>𝟐</mn><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></msub><mo>∈</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">\mathbf{2}=(2)_{n\geq 0}\in X</annotation></semantics></math>.
Note that <math id="S3.SS2.p5.m2" class="ltx_Math" alttext="P_{\mathbf{2}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mn>𝟐</mn></msub><annotation encoding="application/x-tex">P_{\mathbf{2}}</annotation></semantics></math> is everywhere <math id="S3.SS2.p5.m3" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-to-<math id="S3.SS2.p5.m4" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>, and that both <math id="S3.SS2.p5.m5" class="ltx_Math" alttext="P_{\mathbf{3}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mn>𝟑</mn></msub><annotation encoding="application/x-tex">P_{\mathbf{3}}</annotation></semantics></math> and <math id="S3.SS2.p5.m6" class="ltx_Math" alttext="P_{\mathbf{q}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>𝐪</mi></msub><annotation encoding="application/x-tex">P_{\mathbf{q}}</annotation></semantics></math> are bijective. Indeed, the kernel of <math id="S3.SS2.p5.m7" class="ltx_Math" alttext="P_{\mathbf{2}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mn>𝟐</mn></msub><annotation encoding="application/x-tex">P_{\mathbf{2}}</annotation></semantics></math> is made of <math id="S3.SS2.p5.m8" class="ltx_Math" alttext="0+\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>+</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">0+\mathbb{Z}</annotation></semantics></math> and <math id="S3.SS2.p5.m9" class="ltx_Math" alttext="\frac{1}{2}+\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>+</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">\frac{1}{2}+\mathbb{Z}</annotation></semantics></math>. Note that
<math id="S3.SS2.p5.m10" class="ltx_Math" alttext="P_{\mathbf{3}}(\frac{a}{2^{n}}+\mathbb{Z})=\frac{b}{2^{n}}+\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mn>𝟑</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mfrac><mi>a</mi><msup><mn>2</mn><mi>n</mi></msup></mfrac><mo>+</mo><mi>ℤ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mi>b</mi><msup><mn>2</mn><mi>n</mi></msup></mfrac><mo>+</mo><mi>ℤ</mi></mrow></mrow><annotation encoding="application/x-tex">P_{\mathbf{3}}(\frac{a}{2^{n}}+\mathbb{Z})=\frac{b}{2^{n}}+\mathbb{Z}</annotation></semantics></math> if and only if <math id="S3.SS2.p5.m11" class="ltx_Math" alttext="3a\equiv b\pmod{2^{n}}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow><mo>≡</mo><mrow><mi>b</mi><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0.167em">mod</mo><msup><mn>2</mn><mi>n</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">3a\equiv b\pmod{2^{n}}</annotation></semantics></math>. Since <math id="S3.SS2.p5.m12" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math> is invertible modulo <math id="S3.SS2.p5.m13" class="ltx_Math" alttext="2^{n}" display="inline" intent=":literal"><semantics><msup><mn>2</mn><mi>n</mi></msup><annotation encoding="application/x-tex">2^{n}</annotation></semantics></math>, the latter congruence has a unique solution. Similar argument applies for <math id="S3.SS2.p5.m14" class="ltx_Math" alttext="P_{\mathbf{q}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>𝐪</mi></msub><annotation encoding="application/x-tex">P_{\mathbf{q}}</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS2.p6" class="ltx_para">
<p id="S3.SS2.p6.1" class="ltx_p"><span id="S3.SS2.p6.1.1" class="ltx_text ltx_font_bold">Action on Fourier coefficients.<span id="S3.SS2.p6.1.1.1" class="ltx_text ltx_font_medium"> For <math id="S3.SS2.p6.m1" class="ltx_Math" alttext="r\in\widehat{X}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>∈</mo><mover accent="true"><mi>X</mi><mo>^</mo></mover></mrow><annotation encoding="application/x-tex">r\in\widehat{X}</annotation></semantics></math>,</span></span></p>
<table id="S3.Ex96" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex96.m1" class="ltx_Math" alttext="(\Lop\chi_{r})(\mathbf{x})=\sum_{0\leq j&lt;3}c_{j}\,\chi_{r}(2\mathbf{q}\mathbf{x}-j\mathbf{q})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0.167em">⁡</mo><msub><mi>χ</mi><mi>r</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mn>0</mn><mo>≤</mo><mi>j</mi><mo>&lt;</mo><mn>3</mn></mrow></munder><mrow><msub><mi>c</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>χ</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪𝐱</mi></mrow><mo>−</mo><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(\Lop\chi_{r})(\mathbf{x})=\sum_{0\leq j&lt;3}c_{j}\,\chi_{r}(2\mathbf{q}\mathbf{x}-j\mathbf{q}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p6.2" class="ltx_p"><span id="S3.SS2.p6.2.1" class="ltx_text">Using that <math id="S3.SS2.p6.m2" class="ltx_Math" alttext="\chi_{r}" display="inline" intent=":literal"><semantics><msub><mi>χ</mi><mi>r</mi></msub><annotation encoding="application/x-tex">\chi_{r}</annotation></semantics></math> is a character and (<a href="#S3.E14" title="Equation 14 ‣ Characters. ‣ 3.1 Some abstract harmonic analysis ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>),</span></p>
<table id="S3.Ex97" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex97.m1" class="ltx_Math" alttext="\chi_{r}(2\mathbf{q}\mathbf{x}-j\mathbf{q})=\chi_{r}(2\mathbf{q}\mathbf{x})\chi_{r}(-j\mathbf{q})=\chi_{P_{2\mathbf{q}}(r)}(\mathbf{x})\,\chi_{r}(-j\mathbf{q})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>χ</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪𝐱</mi></mrow><mo>−</mo><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>χ</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪𝐱</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>χ</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>χ</mi><mrow><msub><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>χ</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\chi_{r}(2\mathbf{q}\mathbf{x}-j\mathbf{q})=\chi_{r}(2\mathbf{q}\mathbf{x})\chi_{r}(-j\mathbf{q})=\chi_{P_{2\mathbf{q}}(r)}(\mathbf{x})\,\chi_{r}(-j\mathbf{q}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p6.3" class="ltx_p"><span id="S3.SS2.p6.3.1" class="ltx_text">Since the first factor on the right-hand side is independent of <math id="S3.SS2.p6.m3" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>, we write</span></p>
<table id="S3.Ex98" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex98.m1" class="ltx_Math" alttext="(\Lop\chi_{r})(\mathbf{x})=M(r)\,\chi_{P_{2\mathbf{q}}(r)}(\mathbf{x})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0.167em">⁡</mo><msub><mi>χ</mi><mi>r</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>χ</mi><mrow><msub><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">(\Lop\chi_{r})(\mathbf{x})=M(r)\,\chi_{P_{2\mathbf{q}}(r)}(\mathbf{x}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p6.4" class="ltx_p"><span id="S3.SS2.p6.4.1" class="ltx_text">where</span></p>
<table id="S3.E18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(18)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E18.m1" class="ltx_Math" alttext="M(r):=\sum_{0\leq j&lt;3}c_{j}\,\chi_{r}(-j\mathbf{q})=\frac{1}{3}\bigl(1-e(-P_{\mathbf{q}}(r))+e(-P_{\mathbf{q}}(r))^{2}\bigr)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">:=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mn>0</mn><mo>≤</mo><mi>j</mi><mo>&lt;</mo><mn>3</mn></mrow></munder><mrow><msub><mi>c</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>χ</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mn>3</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>e</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><msub><mi>P</mi><mi>𝐪</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><msub><mi>P</mi><mi>𝐪</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">M(r):=\sum_{0\leq j&lt;3}c_{j}\,\chi_{r}(-j\mathbf{q})=\frac{1}{3}\bigl(1-e(-P_{\mathbf{q}}(r))+e(-P_{\mathbf{q}}(r))^{2}\bigr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p6.5" class="ltx_p"><span id="S3.SS2.p6.5.1" class="ltx_text">For the last term, <math id="S3.SS2.p6.m4" class="ltx_Math" alttext="\chi_{r}(-2\mathbf{q})=(\chi_{r}(-\mathbf{q}))^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>χ</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>χ</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>𝐪</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\chi_{r}(-2\mathbf{q})=(\chi_{r}(-\mathbf{q}))^{2}</annotation></semantics></math> since it is a character.
Roughly speaking, this relation can be interpreted as <math id="S3.SS2.p6.m5" class="ltx_Math" alttext="\Lop" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\Lop</annotation></semantics></math> sending a “pure frequency” <math id="S3.SS2.p6.m6" class="ltx_Math" alttext="\chi_{r}" display="inline" intent=":literal"><semantics><msub><mi>χ</mi><mi>r</mi></msub><annotation encoding="application/x-tex">\chi_{r}</annotation></semantics></math> to another frequency <math id="S3.SS2.p6.m7" class="ltx_Math" alttext="\chi_{P_{2\mathbf{q}}(r)}" display="inline" intent=":literal"><semantics><msub><mi>χ</mi><mrow><msub><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\chi_{P_{2\mathbf{q}}(r)}</annotation></semantics></math> and the amplitude is multiplied by <math id="S3.SS2.p6.m8" class="ltx_Math" alttext="M(r)" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M(r)</annotation></semantics></math>.
Thus, using (<a href="#S3.E15" title="Equation 15 ‣ Pontryagin duality. ‣ 3.1 Some abstract harmonic analysis ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>) — the operator <math id="S3.SS2.p6.m9" class="ltx_Math" alttext="\Lop" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\Lop</annotation></semantics></math> can pass through the infinite Fourier sum because the series converges in
<math id="S3.SS2.p6.m10" class="ltx_Math" alttext="L^{2}(X,\mu)" display="inline" intent=":literal"><semantics><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L^{2}(X,\mu)</annotation></semantics></math> and <math id="S3.SS2.p6.m11" class="ltx_Math" alttext="\Lop" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\Lop</annotation></semantics></math> is a bounded linear operator on <math id="S3.SS2.p6.m12" class="ltx_Math" alttext="L^{2}(X,\mu)" display="inline" intent=":literal"><semantics><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L^{2}(X,\mu)</annotation></semantics></math>; bounded operators commute with limits in norm — we get</span></p>
<table id="S3.Ex99" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex99.m1" class="ltx_Math" alttext="\Lop\delta=\sum_{r\in\widehat{X}}\hat{\delta}(r)\,M(r)\,\chi_{P_{2\mathbf{q}}(r)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0.167em">⁡</mo><mi>δ</mi></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>∈</mo><mover accent="true"><mi>X</mi><mo>^</mo></mover></mrow></munder><mrow><mover accent="true"><mi>δ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>χ</mi><mrow><msub><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Lop\delta=\sum_{r\in\widehat{X}}\hat{\delta}(r)\,M(r)\,\chi_{P_{2\mathbf{q}}(r)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p6.6" class="ltx_p"><span id="S3.SS2.p6.6.1" class="ltx_text">Since <math id="S3.SS2.p6.m13" class="ltx_Math" alttext="P_{2\mathbf{q}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow></msub><annotation encoding="application/x-tex">P_{2\mathbf{q}}</annotation></semantics></math> is everywhere <math id="S3.SS2.p6.m14" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-to-<math id="S3.SS2.p6.m15" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>, each character <math id="S3.SS2.p6.m16" class="ltx_Math" alttext="\chi_{s}" display="inline" intent=":literal"><semantics><msub><mi>χ</mi><mi>s</mi></msub><annotation encoding="application/x-tex">\chi_{s}</annotation></semantics></math> appears twice in the sum.
Let us group terms as</span></p>
<table id="S3.Ex100" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex100.m1" class="ltx_Math" alttext="\Lop\delta=\sum_{s\in\widehat{X}}\Bigl(\sum_{r\in P_{2\mathbf{q}}^{-1}(s)}M(r)\hat{\delta}(r)\Bigr)\,\chi_{s}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0.167em">⁡</mo><mi>δ</mi></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>s</mi><mo>∈</mo><mover accent="true"><mi>X</mi><mo>^</mo></mover></mrow></munder><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>r</mi><mo>∈</mo><mrow><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>δ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>χ</mi><mi>s</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Lop\delta=\sum_{s\in\widehat{X}}\Bigl(\sum_{r\in P_{2\mathbf{q}}^{-1}(s)}M(r)\hat{\delta}(r)\Bigr)\,\chi_{s}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p6.7" class="ltx_p"><span id="S3.SS2.p6.7.1" class="ltx_text">We get, as the Fourier expansion is unique,</span></p>
<table id="S3.E19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(19)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E19.m1" class="ltx_Math" alttext="\widehat{(\Lop\delta)}(s)=\sum_{r\in P_{2\mathbf{q}}^{-1}(s)}M(r)\hat{\delta}(r)" display="block" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mrow><mo stretchy="false">(</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo lspace="0.167em">⁡</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>∈</mo><mrow><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>δ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\widehat{(\Lop\delta)}(s)=\sum_{r\in P_{2\mathbf{q}}^{-1}(s)}M(r)\hat{\delta}(r)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p6.8" class="ltx_p"><span id="S3.SS2.p6.8.1" class="ltx_text">for all <math id="S3.SS2.p6.m17" class="ltx_Math" alttext="s\in\widehat{X}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mover accent="true"><mi>X</mi><mo>^</mo></mover></mrow><annotation encoding="application/x-tex">s\in\widehat{X}</annotation></semantics></math> and <math id="S3.SS2.p6.m18" class="ltx_Math" alttext="\delta\in L^{2}(X,\mu)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\delta\in L^{2}(X,\mu)</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS2.p7" class="ltx_para">
<p id="S3.SS2.p7.1" class="ltx_p"><span id="S3.SS2.p7.1.1" class="ltx_text ltx_font_bold">Iterating the operator in Fourier space.<span id="S3.SS2.p7.1.1.1" class="ltx_text ltx_font_medium"> Let <math id="S3.SS2.p7.m1" class="ltx_Math" alttext="\delta\in L^{2}(X,\mu)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\delta\in L^{2}(X,\mu)</annotation></semantics></math> and <math id="S3.SS2.p7.m2" class="ltx_Math" alttext="k\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k\geq 1</annotation></semantics></math>.
Define</span></span></p>
<table id="S3.Ex101" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex101.m1" class="ltx_Math" alttext="M^{(k)}(r):=\prod_{0\leq\ell&lt;k}M(P_{2\mathbf{q}}^{\ell}(r))\kern 5.0pt\text{for $r\in\widehat{X}$.}" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>M</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">:=</mo><mrow><munder><mo movablelimits="false">∏</mo><mrow><mn>0</mn><mo>≤</mo><mi mathvariant="normal">ℓ</mi><mo>&lt;</mo><mi>k</mi></mrow></munder><mrow><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mi mathvariant="normal">ℓ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.500em" rspace="0em">​</mo><mrow><mtext>for </mtext><mrow><mi>r</mi><mo>∈</mo><mover accent="true"><mi>X</mi><mo>^</mo></mover></mrow><mtext>.</mtext></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">M^{(k)}(r):=\prod_{0\leq\ell&lt;k}M(P_{2\mathbf{q}}^{\ell}(r))\kern 5.0pt\text{for $r\in\widehat{X}$.}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p7.2" class="ltx_p"><span id="S3.SS2.p7.2.1" class="ltx_text">Then, for every <math id="S3.SS2.p7.m3" class="ltx_Math" alttext="s\in\widehat{X}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mover accent="true"><mi>X</mi><mo>^</mo></mover></mrow><annotation encoding="application/x-tex">s\in\widehat{X}</annotation></semantics></math>,</span></p>
<table id="S3.Ex102" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex102.m1" class="ltx_Math" alttext="\widehat{(\Lop^{k}\delta)}(s)=\sum_{r\in P_{2\mathbf{q}}^{-k}(s)}M^{(k)}(r)\,\hat{\delta}(r)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mrow><mo stretchy="false">(</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>k</mi></msup><mo lspace="0.167em">⁡</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>∈</mo><mrow><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mrow><mo>−</mo><mi>k</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><msup><mi>M</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mover accent="true"><mi>δ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widehat{(\Lop^{k}\delta)}(s)=\sum_{r\in P_{2\mathbf{q}}^{-k}(s)}M^{(k)}(r)\,\hat{\delta}(r).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p7.3" class="ltx_p"><span id="S3.SS2.p7.3.1" class="ltx_text">For an increased readability, the proof of this fact presented as <a href="#Thmtheorem23" title="Lemma 23. ‣ 3.2 Proof of ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">23</span></a> is given outside this proof. This result lemma and Parseval’s identity (<a href="#S3.E16" title="Equation 16 ‣ Pontryagin duality. ‣ 3.1 Some abstract harmonic analysis ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>) give</span></p>
<table id="S3.Ex103" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex103.m1" class="ltx_Math" alttext="\|\Lop^{k}\delta\|_{2}^{2}=\sum_{s\in\widehat{X}}\bigg|\sum_{r\in P_{2\mathbf{q}}^{-k}(s)}M^{(k)}(r)\,\hat{\delta}(r)\bigg|^{2}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>k</mi></msup><mo lspace="0.167em">⁡</mo><mi>δ</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>s</mi><mo>∈</mo><mover accent="true"><mi>X</mi><mo>^</mo></mover></mrow></munder><msup><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>r</mi><mo>∈</mo><mrow><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mrow><mo>−</mo><mi>k</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><msup><mi>M</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mover accent="true"><mi>δ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\Lop^{k}\delta\|_{2}^{2}=\sum_{s\in\widehat{X}}\bigg|\sum_{r\in P_{2\mathbf{q}}^{-k}(s)}M^{(k)}(r)\,\hat{\delta}(r)\bigg|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p7.4" class="ltx_p"><span id="S3.SS2.p7.4.1" class="ltx_text">Using Cauchy–Schwarz in the inner sum,</span></p>
<table id="S3.Ex104" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex104.m1" class="ltx_Math" alttext="\|\Lop^{k}\delta\|_{2}^{2}\leq\sum_{s\in\widehat{X}}\Bigl(\sum_{r\in P_{2\mathbf{q}}^{-k}(s)}|M^{(k)}(r)|^{2}\Bigr)\Bigl(\sum_{r\in P_{2\mathbf{q}}^{-k}(s)}|\hat{\delta}(r)|^{2}\Bigr)." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>k</mi></msup><mo lspace="0.167em">⁡</mo><mi>δ</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo rspace="0.111em">≤</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>s</mi><mo>∈</mo><mover accent="true"><mi>X</mi><mo>^</mo></mover></mrow></munder><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">∑</mo><mrow><mi>r</mi><mo>∈</mo><mrow><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mrow><mo>−</mo><mi>k</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><msup><mrow><mo stretchy="false">|</mo><mrow><msup><mi>M</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">∑</mo><mrow><mi>r</mi><mo>∈</mo><mrow><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mrow><mo>−</mo><mi>k</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><msup><mrow><mo stretchy="false">|</mo><mrow><mover accent="true"><mi>δ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\Lop^{k}\delta\|_{2}^{2}\leq\sum_{s\in\widehat{X}}\Bigl(\sum_{r\in P_{2\mathbf{q}}^{-k}(s)}|M^{(k)}(r)|^{2}\Bigr)\Bigl(\sum_{r\in P_{2\mathbf{q}}^{-k}(s)}|\hat{\delta}(r)|^{2}\Bigr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p7.5" class="ltx_p"><span id="S3.SS2.p7.5.1" class="ltx_text">Define</span></p>
<table id="S3.EGx13" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(20)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E20.m1" class="ltx_Math" alttext="\displaystyle\zeta_{k}(s)=\sum_{r\in P_{2\mathbf{q}}^{-k}(s)}|M^{(k)}(r)|^{2}\quad\text{and}\quad\|\zeta_{k}\|_{\infty}=\sup_{s\in\widehat{X}}|\zeta_{k}(s)|." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>ζ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>∈</mo><mrow><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mrow><mo>−</mo><mi>k</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder></mstyle><msup><mrow><mo stretchy="false">|</mo><mrow><msup><mi>M</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>ζ</mi><mi>k</mi></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>s</mi><mo>∈</mo><mover accent="true"><mi>X</mi><mo>^</mo></mover></mrow></munder><mrow><mo stretchy="false">|</mo><mrow><msub><mi>ζ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\zeta_{k}(s)=\sum_{r\in P_{2\mathbf{q}}^{-k}(s)}|M^{(k)}(r)|^{2}\quad\text{and}\quad\|\zeta_{k}\|_{\infty}=\sup_{s\in\widehat{X}}|\zeta_{k}(s)|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p7.6" class="ltx_p"><span id="S3.SS2.p7.6.1" class="ltx_text">Then</span></p>
<table id="S3.Ex105" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex105.m1" class="ltx_Math" alttext="\|\Lop^{k}\delta\|_{2}^{2}\leq\sum_{s\in\widehat{X}}\zeta_{k}(s)\,\sum_{r\in P_{2\mathbf{q}}^{-k}}|\hat{\delta}(r)|^{2}\leq\|\zeta_{k}\|_{\infty}\,\sum_{s\in\widehat{X}}\sum_{r\in P_{2\mathbf{q}}^{-k}(s)}|\hat{\delta}(r)|^{2}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>k</mi></msup><mo lspace="0.167em">⁡</mo><mi>δ</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo rspace="0.111em">≤</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>s</mi><mo>∈</mo><mover accent="true"><mi>X</mi><mo>^</mo></mover></mrow></munder><mrow><msub><mi>ζ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.337em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>r</mi><mo>∈</mo><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mrow><mo>−</mo><mi>k</mi></mrow></msubsup></mrow></munder><msup><mrow><mo stretchy="false">|</mo><mrow><mover accent="true"><mi>δ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>ζ</mi><mi>k</mi></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>s</mi><mo>∈</mo><mover accent="true"><mi>X</mi><mo>^</mo></mover></mrow></munder><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>r</mi><mo>∈</mo><mrow><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mrow><mo>−</mo><mi>k</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><msup><mrow><mo stretchy="false">|</mo><mrow><mover accent="true"><mi>δ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\Lop^{k}\delta\|_{2}^{2}\leq\sum_{s\in\widehat{X}}\zeta_{k}(s)\,\sum_{r\in P_{2\mathbf{q}}^{-k}}|\hat{\delta}(r)|^{2}\leq\|\zeta_{k}\|_{\infty}\,\sum_{s\in\widehat{X}}\sum_{r\in P_{2\mathbf{q}}^{-k}(s)}|\hat{\delta}(r)|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p7.7" class="ltx_p"><span id="S3.SS2.p7.7.1" class="ltx_text">Since <math id="S3.SS2.p7.m4" class="ltx_Math" alttext="\{P_{2\mathbf{q}}^{-k}(s):s\in\widehat{X}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mrow><mo>−</mo><mi>k</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mi>s</mi><mo>∈</mo><mover accent="true"><mi>X</mi><mo>^</mo></mover></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{P_{2\mathbf{q}}^{-k}(s):s\in\widehat{X}\}</annotation></semantics></math> is a partition of <math id="S3.SS2.p7.m5" class="ltx_Math" alttext="\widehat{X}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>X</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\widehat{X}</annotation></semantics></math>, the last double sum corresponds, by Parseval’s identity (<a href="#S3.E16" title="Equation 16 ‣ Pontryagin duality. ‣ 3.1 Some abstract harmonic analysis ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>), to <math id="S3.SS2.p7.m6" class="ltx_Math" alttext="\|\delta\|^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">‖</mo><mi>δ</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\|\delta\|^{2}</annotation></semantics></math>.
Therefore,</span></p>
<table id="S3.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(21)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E21.m1" class="ltx_Math" alttext="\|\Lop^{k}\delta\|_{2}^{2}\leq\|\zeta_{k}\|_{\infty}\,\|\delta\|_{2}^{2}" display="block" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>k</mi></msup><mo lspace="0.167em">⁡</mo><mi>δ</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>ζ</mi><mi>k</mi></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mi>δ</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\|\Lop^{k}\delta\|_{2}^{2}\leq\|\zeta_{k}\|_{\infty}\,\|\delta\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p7.8" class="ltx_p"><span id="S3.SS2.p7.8.1" class="ltx_text">for all <math id="S3.SS2.p7.m7" class="ltx_Math" alttext="\delta\in L^{2}(X,\mu)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\delta\in L^{2}(X,\mu)</annotation></semantics></math> and <math id="S3.SS2.p7.m8" class="ltx_Math" alttext="k\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k\geq 1</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS2.p8" class="ltx_para">
<p id="S3.SS2.p8.1" class="ltx_p"><span id="S3.SS2.p8.1.1" class="ltx_text ltx_font_bold">Conclusion.<span id="S3.SS2.p8.1.1.1" class="ltx_text ltx_font_medium"> It is enough to show that <math id="S3.SS2.p8.m1" class="ltx_Math" alttext="\|\zeta_{2}\|_{\infty}&lt;1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>ζ</mi><mn>2</mn></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|\zeta_{2}\|_{\infty}&lt;1</annotation></semantics></math>. Indeed, the contracting property <math id="S3.SS2.p8.m2" class="ltx_Math" alttext="\|\zeta_{2}\|_{\infty}&lt;1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>ζ</mi><mn>2</mn></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|\zeta_{2}\|_{\infty}&lt;1</annotation></semantics></math> (proved later in <a href="#S3.SS3" title="3.3 Proving that ‖𝜁_2‖_∞&lt;1 ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">3.3</span></a>) implies that <math id="S3.SS2.p8.m3" class="ltx_Math" alttext="\mu_{n}(a,k)=2^{-n-1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mn>2</mn><mrow><mrow><mo>−</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\mu_{n}(a,k)=2^{-n-1}</annotation></semantics></math> is the unique solution to the linear recurrence relation: Since <math id="S3.SS2.p8.m4" class="ltx_Math" alttext="\delta_{n}=\Lop^{2k}\delta_{n+2k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>δ</mi><mi>n</mi></msub><mo>=</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">k</mi></mrow></msup><mo lspace="0.167em">⁡</mo><msub><mi>δ</mi><mrow><mi mathvariant="normal">n</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">k</mi></mrow></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\delta_{n}=\Lop^{2k}\delta_{n+2k}</annotation></semantics></math> for all <math id="S3.SS2.p8.m5" class="ltx_Math" alttext="n,k\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n,k\geq 0</annotation></semantics></math>, we obtain from (<a href="#S3.E21" title="Equation 21 ‣ Proof of . ‣ 3.2 Proof of ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>) applying the <math id="S3.SS2.p8.m6" class="ltx_Math" alttext="\Lop^{2}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\Lop^{2}</annotation></semantics></math>-contraction repeatedly</span></span></p>
<table id="S3.Ex106" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex106.m1" class="ltx_Math" alttext="\|\delta_{n}\|_{2}^{2}=\|\Lop^{2}\delta_{n+2}\|_{2}^{2}\leq\|\zeta_{2}\|_{\infty}\|\delta_{n+2}\|_{2}^{2}\leq\dotsb\leq\|\zeta_{2}\|_{\infty}^{k}\|\delta_{n+2k}\|_{2}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>δ</mi><mi>n</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>=</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mn>2</mn></msup><mo lspace="0.167em">⁡</mo><msub><mi>δ</mi><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>ζ</mi><mn>2</mn></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>δ</mi><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>≤</mo><mi mathvariant="normal">⋯</mi><mo>≤</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>ζ</mi><mn>2</mn></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>δ</mi><mrow><mi>n</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mrow></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\delta_{n}\|_{2}^{2}=\|\Lop^{2}\delta_{n+2}\|_{2}^{2}\leq\|\zeta_{2}\|_{\infty}\|\delta_{n+2}\|_{2}^{2}\leq\dotsb\leq\|\zeta_{2}\|_{\infty}^{k}\|\delta_{n+2k}\|_{2}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p8.2" class="ltx_p"><span id="S3.SS2.p8.2.1" class="ltx_text">As observed in (<a href="#S3.E17" title="Equation 17 ‣ Proof of . ‣ 3.2 Proof of ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>), we have the uniform bound <math id="S3.SS2.p8.m7" class="ltx_Math" alttext="|\delta_{m}(\mathbf{x})|\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi>δ</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">|\delta_{m}(\mathbf{x})|\leq 1</annotation></semantics></math> for all <math id="S3.SS2.p8.m8" class="ltx_Math" alttext="m\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">m\geq 0</annotation></semantics></math> and <math id="S3.SS2.p8.m9" class="ltx_Math" alttext="\mathbf{x}\in X" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo>∈</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">\mathbf{x}\in X</annotation></semantics></math>, so <math id="S3.SS2.p8.m10" class="ltx_Math" alttext="\|\delta_{m}\|_{2}^{2}\leq 1" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>δ</mi><mi>m</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|\delta_{m}\|_{2}^{2}\leq 1</annotation></semantics></math> for all <math id="S3.SS2.p8.m11" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> since <math id="S3.SS2.p8.m12" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math> is a probability measure.
Hence, <math id="S3.SS2.p8.m13" class="ltx_Math" alttext="\|\delta_{n}\|_{2}^{2}\leq\|\zeta_{2}\|_{\infty}^{k}" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>δ</mi><mi>n</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>≤</mo><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>ζ</mi><mn>2</mn></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi><mi>k</mi></msubsup></mrow><annotation encoding="application/x-tex">\|\delta_{n}\|_{2}^{2}\leq\|\zeta_{2}\|_{\infty}^{k}</annotation></semantics></math>.
Taking the limit <math id="S3.SS2.p8.m14" class="ltx_Math" alttext="k\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">k\to\infty</annotation></semantics></math>, we obtain that <math id="S3.SS2.p8.m15" class="ltx_Math" alttext="\delta_{n}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>δ</mi><mi>n</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta_{n}=0</annotation></semantics></math> identically as <math id="S3.SS2.p8.m16" class="ltx_Math" alttext="\|\zeta_{2}\|_{\infty}&lt;1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>ζ</mi><mn>2</mn></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|\zeta_{2}\|_{\infty}&lt;1</annotation></semantics></math>.
Note that in <math id="S3.SS2.p8.m17" class="ltx_Math" alttext="L^{2}(X,\mu)" display="inline" intent=":literal"><semantics><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L^{2}(X,\mu)</annotation></semantics></math> having a norm zero means that the function is <math id="S3.SS2.p8.m18" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> almost everywhere but here <math id="S3.SS2.p8.m19" class="ltx_Math" alttext="\delta_{n}" display="inline" intent=":literal"><semantics><msub><mi>δ</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\delta_{n}</annotation></semantics></math> is locally constant, so it is identically <math id="S3.SS2.p8.m20" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>, which was our goal. This means that <math id="S3.SS2.p8.m21" class="ltx_Math" alttext="\mu_{n}({\tt 0},k)=\mu_{n}({\tt 1},k)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟶</mn><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟷</mn><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu_{n}({\tt 0},k)=\mu_{n}({\tt 1},k)</annotation></semantics></math> for all <math id="S3.SS2.p8.m22" class="ltx_Math" alttext="n\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n\geq 0</annotation></semantics></math> and <math id="S3.SS2.p8.m23" class="ltx_Math" alttext="k\in\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">k\in\mathbb{Z}</annotation></semantics></math>. Using <math id="S3.SS2.p8.m24" class="ltx_Math" alttext="(P_{3})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(P_{3})</annotation></semantics></math>, we conclude</span></p>
<table id="S3.Ex107" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex107.m1" class="ltx_Math" alttext="\mu_{n}({\tt 0},k)=\mu_{n}({\tt 1},k)=2^{-n-1}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟶</mn><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟷</mn><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mn>2</mn><mrow><mrow><mo>−</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mu_{n}({\tt 0},k)=\mu_{n}({\tt 1},k)=2^{-n-1},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p8.3" class="ltx_p"><span id="S3.SS2.p8.3.1" class="ltx_text">as desired.
∎</span></p>
</div>
</div>
<div id="S3.SS2.p9" class="ltx_para">
<p id="S3.SS2.p9.1" class="ltx_p">We now prove the identity in the penultimate step of the previous proof.</p>
</div>
<div id="Thmtheorem23" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem23.2" class="ltx_text ltx_font_bold">Lemma 23</span></span><span id="Thmtheorem23.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem23.p1" class="ltx_para">
<p id="Thmtheorem23.p1.1" class="ltx_p"><span id="Thmtheorem23.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmtheorem23.p1.m1" class="ltx_Math" alttext="\delta\in L^{2}(X,\mu)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\delta\in L^{2}(X,\mu)</annotation></semantics></math> and <math id="Thmtheorem23.p1.m2" class="ltx_Math" alttext="k\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k\geq 1</annotation></semantics></math>. With <math id="Thmtheorem23.p1.m3" class="ltx_Math" alttext="M(r)" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M(r)</annotation></semantics></math> defined in (<a href="#S3.E19" title="Equation 19 ‣ Proof of . ‣ 3.2 Proof of ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>), we let</span></p>
<table id="S3.Ex108" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex108.m1" class="ltx_Math" alttext="M^{(k)}(r):=\prod_{0\leq\ell&lt;k}M(P_{2\mathbf{q}}^{\ell}(r))\kern 5.0pt\text{for $r\in\widehat{X}$.}" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>M</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">:=</mo><mrow><munder><mo movablelimits="false">∏</mo><mrow><mn>0</mn><mo>≤</mo><mi mathvariant="normal">ℓ</mi><mo>&lt;</mo><mi>k</mi></mrow></munder><mrow><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mi mathvariant="normal">ℓ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.500em" rspace="0em">​</mo><mrow><mtext class="ltx_mathvariant_italic">for </mtext><mrow><mi>r</mi><mo>∈</mo><mover accent="true"><mi>X</mi><mo>^</mo></mover></mrow><mtext class="ltx_mathvariant_italic">.</mtext></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">M^{(k)}(r):=\prod_{0\leq\ell&lt;k}M(P_{2\mathbf{q}}^{\ell}(r))\kern 5.0pt\text{for $r\in\widehat{X}$.}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem23.p1.2" class="ltx_p"><span id="Thmtheorem23.p1.2.1" class="ltx_text ltx_font_italic">Then, for every <math id="Thmtheorem23.p1.m4" class="ltx_Math" alttext="s\in\widehat{X}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mover accent="true"><mi>X</mi><mo>^</mo></mover></mrow><annotation encoding="application/x-tex">s\in\widehat{X}</annotation></semantics></math>,</span></p>
<table id="S3.Ex109" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex109.m1" class="ltx_Math" alttext="\widehat{(\Lop^{k}\delta)}(s)=\sum_{r\in P_{2\mathbf{q}}^{-k}(s)}M^{(k)}(r)\,\hat{\delta}(r)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mrow><mo stretchy="false">(</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>k</mi></msup><mo lspace="0.167em">⁡</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>∈</mo><mrow><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mrow><mo>−</mo><mi>k</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><msup><mi>M</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mover accent="true"><mi>δ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widehat{(\Lop^{k}\delta)}(s)=\sum_{r\in P_{2\mathbf{q}}^{-k}(s)}M^{(k)}(r)\,\hat{\delta}(r).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S3.SS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS2.p10" class="ltx_para">
<p id="S3.SS2.p10.1" class="ltx_p"><span id="S3.SS2.p10.1.1" class="ltx_text">Proceed by induction. The case <math id="S3.SS2.p10.m1" class="ltx_Math" alttext="k=1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k=1</annotation></semantics></math> is given by (<a href="#S3.E19" title="Equation 19 ‣ Proof of . ‣ 3.2 Proof of ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>). Assume now that the formula holds for some <math id="S3.SS2.p10.m2" class="ltx_Math" alttext="k\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k\geq 1</annotation></semantics></math>, i.e.,</span></p>
<table id="S3.Ex110" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex110.m1" class="ltx_Math" alttext="\widehat{\Lop^{k}\delta}(t)=\sum_{u\in P_{2\mathbf{q}}^{-k}(t)}M^{(k)}(u)\,\widehat{\delta}(u)\quad\text{for all }t\in\widehat{X}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mover accent="true"><mrow><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>k</mi></msup><mo lspace="0.167em">⁡</mo><mi>δ</mi></mrow><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>∈</mo><mrow><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mrow><mo>−</mo><mi>k</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><msup><mi>M</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mover accent="true"><mi>δ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mtext>for all </mtext><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>∈</mo><mover accent="true"><mi>X</mi><mo>^</mo></mover></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widehat{\Lop^{k}\delta}(t)=\sum_{u\in P_{2\mathbf{q}}^{-k}(t)}M^{(k)}(u)\,\widehat{\delta}(u)\quad\text{for all }t\in\widehat{X}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p10.2" class="ltx_p"><span id="S3.SS2.p10.2.1" class="ltx_text">Applying (<a href="#S3.E19" title="Equation 19 ‣ Proof of . ‣ 3.2 Proof of ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>) to <math id="S3.SS2.p10.m3" class="ltx_Math" alttext="\Lop^{k}\delta" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>k</mi></msup><mo lspace="0.167em">⁡</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">\Lop^{k}\delta</annotation></semantics></math>, we obtain</span></p>
<table id="S3.Ex111" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex111.m1" class="ltx_Math" alttext="\widehat{\Lop^{k+1}\delta}(s)=\widehat{\Lop(\Lop^{k}\delta)}(s)=\sum_{t\in P_{2\mathbf{q}}^{-1}(s)}M(t)\,\widehat{\Lop^{k}\delta}(t)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mrow><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0.167em">⁡</mo><mi>δ</mi></mrow><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mover accent="true"><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>k</mi></msup><mo lspace="0.167em">⁡</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>∈</mo><mrow><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.337em" rspace="0em">​</mo><mover accent="true"><mrow><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>k</mi></msup><mo lspace="0.167em">⁡</mo><mi>δ</mi></mrow><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widehat{\Lop^{k+1}\delta}(s)=\widehat{\Lop(\Lop^{k}\delta)}(s)=\sum_{t\in P_{2\mathbf{q}}^{-1}(s)}M(t)\,\widehat{\Lop^{k}\delta}(t).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p10.3" class="ltx_p"><span id="S3.SS2.p10.3.1" class="ltx_text">Substituting the induction hypothesis yields</span></p>
<table id="S3.Ex112" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex112.m1" class="ltx_Math" alttext="\widehat{\Lop^{k+1}\delta}(s)=\sum_{t\in P_{2\mathbf{q}}^{-1}(s)}M(t)\sum_{u\in P_{2\mathbf{q}}^{-k}(t)}M^{(k)}(u)\,\widehat{\delta}(u)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mrow><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0.167em">⁡</mo><mi>δ</mi></mrow><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>∈</mo><mrow><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>∈</mo><mrow><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mrow><mo>−</mo><mi>k</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><msup><mi>M</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mover accent="true"><mi>δ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widehat{\Lop^{k+1}\delta}(s)=\sum_{t\in P_{2\mathbf{q}}^{-1}(s)}M(t)\sum_{u\in P_{2\mathbf{q}}^{-k}(t)}M^{(k)}(u)\,\widehat{\delta}(u).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p10.4" class="ltx_p"><span id="S3.SS2.p10.4.1" class="ltx_text">We now reindex the sum.
The conditions <math id="S3.SS2.p10.m4" class="ltx_Math" alttext="t\in P_{2\mathbf{q}}^{-1}(s)" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t\in P_{2\mathbf{q}}^{-1}(s)</annotation></semantics></math> and <math id="S3.SS2.p10.m5" class="ltx_Math" alttext="u\in P_{2\mathbf{q}}^{-k}(t)" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>∈</mo><mrow><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mrow><mo>−</mo><mi>k</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">u\in P_{2\mathbf{q}}^{-k}(t)</annotation></semantics></math> are equivalent to</span></p>
<table id="S3.Ex113" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex113.m1" class="ltx_Math" alttext="P_{2\mathbf{q}}^{k+1}(u)=s," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>s</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">P_{2\mathbf{q}}^{k+1}(u)=s,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p10.5" class="ltx_p"><span id="S3.SS2.p10.5.1" class="ltx_text">with <math id="S3.SS2.p10.m6" class="ltx_Math" alttext="t=P_{2\mathbf{q}}^{k}(u)" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mrow><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">t=P_{2\mathbf{q}}^{k}(u)</annotation></semantics></math>. Hence the pairs <math id="S3.SS2.p10.m7" class="ltx_Math" alttext="(t,u)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(t,u)</annotation></semantics></math> are in bijection with
<math id="S3.SS2.p10.m8" class="ltx_Math" alttext="u\in P_{2\mathbf{q}}^{-(k+1)}(s)" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>∈</mo><mrow><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">u\in P_{2\mathbf{q}}^{-(k+1)}(s)</annotation></semantics></math>, and the above expression becomes</span></p>
<table id="S3.Ex114" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex114.m1" class="ltx_Math" alttext="\widehat{\Lop^{k+1}\delta}(s)=\sum_{u\in P_{2\mathbf{q}}^{-(k+1)}(s)}M\!\big(P_{2\mathbf{q}}^{k}(u)\big)\,M^{(k)}(u)\,\widehat{\delta}(u)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mrow><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0.167em">⁡</mo><mi>δ</mi></mrow><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>u</mi><mo>∈</mo><mrow><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><mrow><mpadded style="width:0.909em;" width="0.909em"><mi>M</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>M</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mover accent="true"><mi>δ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widehat{\Lop^{k+1}\delta}(s)=\sum_{u\in P_{2\mathbf{q}}^{-(k+1)}(s)}M\!\big(P_{2\mathbf{q}}^{k}(u)\big)\,M^{(k)}(u)\,\widehat{\delta}(u).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p10.6" class="ltx_p"><span id="S3.SS2.p10.6.1" class="ltx_text">Finally, by definition of <math id="S3.SS2.p10.m9" class="ltx_Math" alttext="M^{(k)}" display="inline" intent=":literal"><semantics><msup><mi>M</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">M^{(k)}</annotation></semantics></math>,
<math id="S3.SS2.p10.m10" class="ltx_Math" alttext="M\!\big(P_{2\mathbf{q}}^{k}(u)\big)\,M^{(k)}(u)=M^{(k+1)}(u)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mpadded style="width:0.909em;" width="0.909em"><mi>M</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>M</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>M</mi><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M\!\big(P_{2\mathbf{q}}^{k}(u)\big)\,M^{(k)}(u)=M^{(k+1)}(u)</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="S3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.3 </span>Proving that <math id="S3.SS3.m1" class="ltx_Math" alttext="\|\zeta_{2}\|_{\infty}&lt;1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>ζ</mi><mn>2</mn></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|\zeta_{2}\|_{\infty}&lt;1</annotation></semantics></math></h3>

<div id="S3.SS3.p1" class="ltx_para">
<p id="S3.SS3.p1.1" class="ltx_p">We consider a multiplication by <math id="S3.SS3.p1.m1" class="ltx_Math" alttext="3^{k}" display="inline" intent=":literal"><semantics><msup><mn>3</mn><mi>k</mi></msup><annotation encoding="application/x-tex">3^{k}</annotation></semantics></math> to cancel the <math id="S3.SS3.p1.m2" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>’s occurring in the iterates of <math id="S3.SS3.p1.m3" class="ltx_Math" alttext="P_{\mathbf{q}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>𝐪</mi></msub><annotation encoding="application/x-tex">P_{\mathbf{q}}</annotation></semantics></math> and <math id="S3.SS3.p1.m4" class="ltx_Math" alttext="P_{2\mathbf{q}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow></msub><annotation encoding="application/x-tex">P_{2\mathbf{q}}</annotation></semantics></math>. For <math id="S3.SS3.p1.m5" class="ltx_Math" alttext="r\in\widehat{X}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>∈</mo><mover accent="true"><mi>X</mi><mo>^</mo></mover></mrow><annotation encoding="application/x-tex">r\in\widehat{X}</annotation></semantics></math>, we thus define</p>
<table id="S3.E22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(22)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E22.m1" class="ltx_Math" alttext="\widetilde{M}^{(k)}(r):=M^{(k)}(3^{k}r)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><msup><mi>M</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mn>3</mn><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widetilde{M}^{(k)}(r):=M^{(k)}(3^{k}r).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="Thmtheorem24" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem24.2" class="ltx_text ltx_font_bold">Lemma 24</span></span><span id="Thmtheorem24.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem24.p1" class="ltx_para">
<p id="Thmtheorem24.p1.1" class="ltx_p"><span id="Thmtheorem24.p1.1.1" class="ltx_text ltx_font_italic">We have</span></p>
<table id="S3.Ex115" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex115.m1" class="ltx_Math" alttext="\widetilde{M}^{(k)}(r)=\frac{1}{3^{k}}\prod_{0\leq\ell&lt;k}\bigl(1-e(-2^{\ell}\,3^{k-\ell-1}r)+e(-2^{\ell+1}\,3^{k-\ell-1}r)\bigr)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><msup><mn>3</mn><mi>k</mi></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">∏</mo><mrow><mn>0</mn><mo>≤</mo><mi mathvariant="normal">ℓ</mi><mo>&lt;</mo><mi>k</mi></mrow></munder><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>e</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><msup><mn>2</mn><mi mathvariant="normal">ℓ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn> 3</mn><mrow><mi>k</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>e</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><msup><mn>2</mn><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn> 3</mn><mrow><mi>k</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widetilde{M}^{(k)}(r)=\frac{1}{3^{k}}\prod_{0\leq\ell&lt;k}\bigl(1-e(-2^{\ell}\,3^{k-\ell-1}r)+e(-2^{\ell+1}\,3^{k-\ell-1}r)\bigr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S3.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS3.p2" class="ltx_para">
<p id="S3.SS3.p2.1" class="ltx_p"><span id="S3.SS3.p2.1.1" class="ltx_text">By definition, we have</span></p>
<table id="S3.Ex116" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex116.m1" class="ltx_Math" alttext="\widetilde{M}^{(k)}(r)=\prod_{0\leq\ell&lt;k}M\!\bigl(P_{2\mathbf{q}}^{\ell}(3^{k}r)\bigr)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∏</mo><mrow><mn>0</mn><mo>≤</mo><mi mathvariant="normal">ℓ</mi><mo>&lt;</mo><mi>k</mi></mrow></munder><mrow><mpadded style="width:0.909em;" width="0.909em"><mi>M</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mi mathvariant="normal">ℓ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mn>3</mn><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widetilde{M}^{(k)}(r)=\prod_{0\leq\ell&lt;k}M\!\bigl(P_{2\mathbf{q}}^{\ell}(3^{k}r)\bigr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.p2.2" class="ltx_p"><span id="S3.SS3.p2.2.1" class="ltx_text">Since <math id="S3.SS3.p2.m1" class="ltx_Math" alttext="2\mathbf{q}=\mathbf{2}\,\mathbf{q}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mo>=</mo><mrow><mn>𝟐</mn><mo lspace="0.170em" rspace="0em">​</mo><mi>𝐪</mi></mrow></mrow><annotation encoding="application/x-tex">2\mathbf{q}=\mathbf{2}\,\mathbf{q}</annotation></semantics></math> in <math id="S3.SS3.p2.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>, we have
<math id="S3.SS3.p2.m3" class="ltx_Math" alttext="P_{2\mathbf{q}}=P_{\mathbf{2}}\circ P_{\mathbf{q}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow></msub><mo>=</mo><mrow><msub><mi>P</mi><mn>𝟐</mn></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>P</mi><mi>𝐪</mi></msub></mrow></mrow><annotation encoding="application/x-tex">P_{2\mathbf{q}}=P_{\mathbf{2}}\circ P_{\mathbf{q}}</annotation></semantics></math>.
Iterating and using commutativity on <math id="S3.SS3.p2.m4" class="ltx_Math" alttext="\widehat{X}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>X</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\widehat{X}</annotation></semantics></math> gives, for every <math id="S3.SS3.p2.m5" class="ltx_Math" alttext="\ell\geq 0" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\ell\geq 0</annotation></semantics></math>,</span></p>
<table id="S3.Ex117" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex117.m1" class="ltx_Math" alttext="P_{2\mathbf{q}}^{\ell}(3^{k}r)=2^{\ell}q^{\ell}3^{k}r." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mi mathvariant="normal">ℓ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mn>3</mn><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mn>2</mn><mi mathvariant="normal">ℓ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mi mathvariant="normal">ℓ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>3</mn><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P_{2\mathbf{q}}^{\ell}(3^{k}r)=2^{\ell}q^{\ell}3^{k}r.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.p2.3" class="ltx_p"><span id="S3.SS3.p2.3.1" class="ltx_text">Since <math id="S3.SS3.p2.m6" class="ltx_Math" alttext="\mathbf{q}" display="inline" intent=":literal"><semantics><mi>𝐪</mi><annotation encoding="application/x-tex">\mathbf{q}</annotation></semantics></math> is the <math id="S3.SS3.p2.m7" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-adic inverse of <math id="S3.SS3.p2.m8" class="ltx_Math" alttext="\mathbf{3}" display="inline" intent=":literal"><semantics><mn>𝟑</mn><annotation encoding="application/x-tex">\mathbf{3}</annotation></semantics></math>, thus</span></p>
<table id="S3.Ex118" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex118.m1" class="ltx_Math" alttext="P_{2\mathbf{q}}^{\ell}(3^{k}r)=2^{\ell}3^{k-\ell}r\quad\text{in }\widehat{X}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mi mathvariant="normal">ℓ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mn>3</mn><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mn>2</mn><mi mathvariant="normal">ℓ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>3</mn><mrow><mi>k</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mtext>in </mtext><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>X</mi><mo>^</mo></mover></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P_{2\mathbf{q}}^{\ell}(3^{k}r)=2^{\ell}3^{k-\ell}r\quad\text{in }\widehat{X}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.SS3.p3" class="ltx_para">
<p id="S3.SS3.p3.1" class="ltx_p"><span id="S3.SS3.p3.1.1" class="ltx_text">Next recall from (<a href="#S3.E18" title="Equation 18 ‣ Proof of . ‣ 3.2 Proof of ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>) that</span></p>
<table id="S3.Ex119" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex119.m1" class="ltx_Math" alttext="M(t)=\frac{1}{3}\Bigl(1-e(-P_{\mathbf{q}}(t))+e(-2P_{\mathbf{q}}(t))\Bigr)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mn>3</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>e</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><msub><mi>P</mi><mi>𝐪</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>e</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>𝐪</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">M(t)=\frac{1}{3}\Bigl(1-e(-P_{\mathbf{q}}(t))+e(-2P_{\mathbf{q}}(t))\Bigr),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.p3.2" class="ltx_p"><span id="S3.SS3.p3.2.1" class="ltx_text">Using again <math id="S3.SS3.p3.m1" class="ltx_Math" alttext="P_{\mathbf{x}\mathbf{y}}=P_{\mathbf{x}}\circ P_{\mathbf{y}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>𝐱𝐲</mi></msub><mo>=</mo><mrow><msub><mi>P</mi><mi>𝐱</mi></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>P</mi><mi>𝐲</mi></msub></mrow></mrow><annotation encoding="application/x-tex">P_{\mathbf{x}\mathbf{y}}=P_{\mathbf{x}}\circ P_{\mathbf{y}}</annotation></semantics></math> and that <math id="S3.SS3.p3.m2" class="ltx_Math" alttext="P_{\mathbf{q}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>𝐪</mi></msub><annotation encoding="application/x-tex">P_{\mathbf{q}}</annotation></semantics></math> acts by multiplication by <math id="S3.SS3.p3.m3" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>,
we have</span></p>
<table id="S3.Ex120" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex120.m1" class="ltx_Math" alttext="P_{\mathbf{q}}\bigl(P_{2\mathbf{q}}^{\ell}(3^{k}r)\bigr)=q\cdot P_{2\mathbf{q}}^{\ell}(3^{k}r)=q\cdot(2^{\ell}3^{k-\ell}r)=2^{\ell}3^{k-\ell-1}r\quad\text{in }\widehat{X}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>P</mi><mi>𝐪</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mi mathvariant="normal">ℓ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mn>3</mn><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mi mathvariant="normal">ℓ</mi></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mn>3</mn><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>q</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mn>2</mn><mi mathvariant="normal">ℓ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>3</mn><mrow><mi>k</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mn>2</mn><mi mathvariant="normal">ℓ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>3</mn><mrow><mi>k</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mtext>in </mtext><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>X</mi><mo>^</mo></mover></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P_{\mathbf{q}}\bigl(P_{2\mathbf{q}}^{\ell}(3^{k}r)\bigr)=q\cdot P_{2\mathbf{q}}^{\ell}(3^{k}r)=q\cdot(2^{\ell}3^{k-\ell}r)=2^{\ell}3^{k-\ell-1}r\quad\text{in }\widehat{X}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.p3.3" class="ltx_p"><span id="S3.SS3.p3.3.1" class="ltx_text">Therefore,</span></p>
<table id="S3.E23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(23)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E23.m1" class="ltx_Math" alttext="M\!\bigl(P_{2\mathbf{q}}^{\ell}(3^{k}r)\bigr)=\frac{1}{3}\Bigl(1-e(-2^{\ell}3^{k-\ell-1}r)+e(-2^{\ell+1}3^{k-\ell-1}r)\Bigr)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mpadded style="width:0.909em;" width="0.909em"><mi>M</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mi mathvariant="normal">ℓ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mn>3</mn><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mn>3</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>e</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><msup><mn>2</mn><mi mathvariant="normal">ℓ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>3</mn><mrow><mi>k</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>e</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><msup><mn>2</mn><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mn>3</mn><mrow><mi>k</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">M\!\bigl(P_{2\mathbf{q}}^{\ell}(3^{k}r)\bigr)=\frac{1}{3}\Bigl(1-e(-2^{\ell}3^{k-\ell-1}r)+e(-2^{\ell+1}3^{k-\ell-1}r)\Bigr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.p3.4" class="ltx_p"><span id="S3.SS3.p3.4.1" class="ltx_text">and factoring out
<math id="S3.SS3.p3.m4" class="ltx_Math" alttext="3^{-k}" display="inline" intent=":literal"><semantics><msup><mn>3</mn><mrow><mo>−</mo><mi>k</mi></mrow></msup><annotation encoding="application/x-tex">3^{-k}</annotation></semantics></math> gives the desired product formula.
∎</span></p>
</div>
</div>
<div id="Thmtheorem25" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem25.2" class="ltx_text ltx_font_bold">Lemma 25</span></span><span id="Thmtheorem25.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem25.p1" class="ltx_para">
<p id="Thmtheorem25.p1.1" class="ltx_p"><span id="Thmtheorem25.p1.1.1" class="ltx_text ltx_font_italic">For any <math id="Thmtheorem25.p1.m1" class="ltx_Math" alttext="s\in\mathbb{Q}[1/2]\cap[0,1)" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mrow><mi>ℚ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>∩</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s\in\mathbb{Q}[1/2]\cap[0,1)</annotation></semantics></math>,</span></p>
<table id="S3.Ex121" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex121.m1" class="ltx_Math" alttext="\zeta_{k}(3^{k}s)=\sum_{0\leq i&lt;2^{k}}|\widetilde{M}^{(k)}(\tfrac{s}{2^{k}}+\tfrac{i}{2^{k}})|^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ζ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mn>3</mn><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mn>0</mn><mo>≤</mo><mi>i</mi><mo>&lt;</mo><msup><mn>2</mn><mi>k</mi></msup></mrow></munder><msup><mrow><mo stretchy="false">|</mo><mrow><msup><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="false"><mfrac><mi>s</mi><msup><mn>2</mn><mi>k</mi></msup></mfrac></mstyle><mo>+</mo><mstyle displaystyle="false"><mfrac><mi>i</mi><msup><mn>2</mn><mi>k</mi></msup></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\zeta_{k}(3^{k}s)=\sum_{0\leq i&lt;2^{k}}|\widetilde{M}^{(k)}(\tfrac{s}{2^{k}}+\tfrac{i}{2^{k}})|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S3.SS3.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS3.p4" class="ltx_para">
<p id="S3.SS3.p4.1" class="ltx_p"><span id="S3.SS3.p4.1.1" class="ltx_text">Let <math id="S3.SS3.p4.m1" class="ltx_Math" alttext="s\in\mathbb{Q}[1/2]\cap[0,1)" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mrow><mi>ℚ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>∩</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s\in\mathbb{Q}[1/2]\cap[0,1)</annotation></semantics></math>. Then</span></p>
<table id="S3.Ex122" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex122.m1" class="ltx_math_unparsed" alttext="r\in P_{2\mathbf{q}}^{-k}(3^{k}s)\quad\Longleftrightarrow\quad 2^{k}r\equiv 3^{2k}s\pmod{1}." display="block" intent=":literal"><semantics><mrow><mi>r</mi><mo>∈</mo><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mrow><mo>−</mo><mi>k</mi></mrow></msubsup><mrow><mo stretchy="false">(</mo><msup><mn>3</mn><mi>k</mi></msup><mi>s</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">⟺</mo><msup><mn>2</mn><mi>k</mi></msup><mi>r</mi><mo>≡</mo><msup><mn>3</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mi>s</mi><mrow><mo lspace="0.560em" stretchy="false">(</mo><mrow><mo lspace="0em" movablelimits="false" rspace="0.167em">mod</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">r\in P_{2\mathbf{q}}^{-k}(3^{k}s)\quad\Longleftrightarrow\quad 2^{k}r\equiv 3^{2k}s\pmod{1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.p4.2" class="ltx_p"><span id="S3.SS3.p4.2.1" class="ltx_text">Thus there exists <math id="S3.SS3.p4.m2" class="ltx_Math" alttext="m\in\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">m\in\mathbb{Z}</annotation></semantics></math> such that</span></p>
<table id="S3.Ex123" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex123.m1" class="ltx_Math" alttext="r=\frac{3^{2k}}{2^{k}}s+\frac{m}{2^{k}}." display="block" intent=":literal"><semantics><mrow><mrow><mi>r</mi><mo>=</mo><mrow><mrow><mfrac><msup><mn>3</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><msup><mn>2</mn><mi>k</mi></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>+</mo><mfrac><mi>m</mi><msup><mn>2</mn><mi>k</mi></msup></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">r=\frac{3^{2k}}{2^{k}}s+\frac{m}{2^{k}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.p4.3" class="ltx_p"><span id="S3.SS3.p4.3.1" class="ltx_text">Reducing modulo <math id="S3.SS3.p4.m3" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>, the distinct solutions are obtained by taking
<math id="S3.SS3.p4.m4" class="ltx_Math" alttext="m=0,1,\dots,2^{k}-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>m</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msup><mn>2</mn><mi>k</mi></msup><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">m=0,1,\dots,2^{k}-1</annotation></semantics></math>, and we obtain</span></p>
<table id="S3.Ex124" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex124.m1" class="ltx_Math" alttext="P_{2\mathbf{q}}^{-k}(3^{k}s)=\left\{\frac{3^{2k}}{2^{k}}s+\frac{j}{2^{k}}+\mathbb{Z}\;:\;0\leq j&lt;2^{k}\right\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mrow><mo>−</mo><mi>k</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mn>3</mn><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mrow><mrow><mfrac><msup><mn>3</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><msup><mn>2</mn><mi>k</mi></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>+</mo><mfrac><mi>j</mi><msup><mn>2</mn><mi>k</mi></msup></mfrac><mo>+</mo><mi>ℤ</mi></mrow><mo lspace="0.558em" rspace="0.278em">:</mo><mrow><mn> 0</mn><mo>≤</mo><mi>j</mi><mo>&lt;</mo><msup><mn>2</mn><mi>k</mi></msup></mrow><mo>}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P_{2\mathbf{q}}^{-k}(3^{k}s)=\left\{\frac{3^{2k}}{2^{k}}s+\frac{j}{2^{k}}+\mathbb{Z}\;:\;0\leq j&lt;2^{k}\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.p4.4" class="ltx_p"><span id="S3.SS3.p4.4.1" class="ltx_text">Since <math id="S3.SS3.p4.m5" class="ltx_Math" alttext="3^{2k}" display="inline" intent=":literal"><semantics><msup><mn>3</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><annotation encoding="application/x-tex">3^{2k}</annotation></semantics></math> is odd, multiplication by <math id="S3.SS3.p4.m6" class="ltx_Math" alttext="3^{2k}" display="inline" intent=":literal"><semantics><msup><mn>3</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><annotation encoding="application/x-tex">3^{2k}</annotation></semantics></math> permutes the elements of
<math id="S3.SS3.p4.m7" class="ltx_Math" alttext="\widehat{X}=\mathbb{Q}[1/2]/\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>X</mi><mo>^</mo></mover><mo>=</mo><mrow><mrow><mi>ℚ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>/</mo><mi>ℤ</mi></mrow></mrow><annotation encoding="application/x-tex">\widehat{X}=\mathbb{Q}[1/2]/\mathbb{Z}</annotation></semantics></math>. Therefore, recalling the definition in <a href="#S3.E20" title="In Proof of . ‣ 3.2 Proof of ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">20</span></a>, we obtain</span></p>
<table id="S3.Ex125" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex125.m1" class="ltx_Math" alttext="\zeta_{k}(3^{k}s)=\sum_{r\in P_{2\mathbf{q}}^{-k}(3^{k}s)}\bigl|\widetilde{M}^{(k)}(r)\bigr|^{2}=\sum_{0\leq j&lt;2^{k}}\left|\widetilde{M}^{(k)}\!\left(\frac{3^{2k}}{2^{k}}s+\frac{j}{2^{k}}\right)\right|^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ζ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mn>3</mn><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>r</mi><mo>∈</mo><mrow><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mrow><mo>−</mo><mi>k</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mn>3</mn><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><msup><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><msup><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow><mn>2</mn></msup></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mn>0</mn><mo>≤</mo><mi>j</mi><mo>&lt;</mo><msup><mn>2</mn><mi>k</mi></msup></mrow></munder><msup><mrow><mo>|</mo><mrow><msup><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mfrac><msup><mn>3</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><msup><mn>2</mn><mi>k</mi></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>+</mo><mfrac><mi>j</mi><msup><mn>2</mn><mi>k</mi></msup></mfrac></mrow><mo>)</mo></mrow></mrow><mo>|</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\zeta_{k}(3^{k}s)=\sum_{r\in P_{2\mathbf{q}}^{-k}(3^{k}s)}\bigl|\widetilde{M}^{(k)}(r)\bigr|^{2}=\sum_{0\leq j&lt;2^{k}}\left|\widetilde{M}^{(k)}\!\left(\frac{3^{2k}}{2^{k}}s+\frac{j}{2^{k}}\right)\right|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.p4.5" class="ltx_p"><span id="S3.SS3.p4.5.1" class="ltx_text">Because we have a function depending
on <math id="S3.SS3.p4.m8" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> only through its value modulo <math id="S3.SS3.p4.m9" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> and invariant under permutation of the
summation index, we may equivalently write</span></p>
<table id="S3.Ex126" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex126.m1" class="ltx_Math" alttext="P_{2\mathbf{q}}^{-k}(3^{k}s)=\left\{\frac{s}{2^{k}}+\frac{j}{2^{k}}+\mathbb{Z}\;:\;0\leq j&lt;2^{k}\right\}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mrow><mo>−</mo><mi>k</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mn>3</mn><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mrow><mfrac><mi>s</mi><msup><mn>2</mn><mi>k</mi></msup></mfrac><mo>+</mo><mfrac><mi>j</mi><msup><mn>2</mn><mi>k</mi></msup></mfrac><mo>+</mo><mi>ℤ</mi></mrow><mo lspace="0.558em" rspace="0.278em">:</mo><mrow><mn> 0</mn><mo>≤</mo><mi>j</mi><mo>&lt;</mo><msup><mn>2</mn><mi>k</mi></msup></mrow><mo>}</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">P_{2\mathbf{q}}^{-k}(3^{k}s)=\left\{\frac{s}{2^{k}}+\frac{j}{2^{k}}+\mathbb{Z}\;:\;0\leq j&lt;2^{k}\right\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.p4.6" class="ltx_p"><span id="S3.SS3.p4.6.1" class="ltx_text">which gives the statement.
∎</span></p>
</div>
</div>
<div id="S3.SS3.p5" class="ltx_para">
<p id="S3.SS3.p5.1" class="ltx_p">Consequently, since <math id="S3.SS3.p5.m1" class="ltx_Math" alttext="\mathbb{Q}[1/2]" display="inline" intent=":literal"><semantics><mrow><mi>ℚ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{Q}[1/2]</annotation></semantics></math> is dense in <math id="S3.SS3.p5.m2" class="ltx_Math" alttext="\mathbb{R}" display="inline" intent=":literal"><semantics><mi>ℝ</mi><annotation encoding="application/x-tex">\mathbb{R}</annotation></semantics></math> and <math id="S3.SS3.p5.m3" class="ltx_Math" alttext="\widetilde{M}^{(k)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\widetilde{M}^{(k)}</annotation></semantics></math> continuous, we obtain</p>
<table id="S3.Ex127" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex127.m1" class="ltx_Math" alttext="\sup_{s\in\widehat{X}}\zeta_{k}(3^{k}s)=\sup_{s\in\mathbb{R}}\sum_{0\leq j&lt;2^{k}}|\widetilde{M}^{(k)}(\tfrac{s}{2^{k}}+\tfrac{j}{2^{k}})|^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">sup</mo><mrow><mi>s</mi><mo>∈</mo><mover accent="true"><mi>X</mi><mo>^</mo></mover></mrow></munder><mrow><msub><mi>ζ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mn>3</mn><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>s</mi><mo>∈</mo><mi>ℝ</mi></mrow></munder><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mn>0</mn><mo>≤</mo><mi>j</mi><mo>&lt;</mo><msup><mn>2</mn><mi>k</mi></msup></mrow></munder><msup><mrow><mo stretchy="false">|</mo><mrow><msup><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="false"><mfrac><mi>s</mi><msup><mn>2</mn><mi>k</mi></msup></mfrac></mstyle><mo>+</mo><mstyle displaystyle="false"><mfrac><mi>j</mi><msup><mn>2</mn><mi>k</mi></msup></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sup_{s\in\widehat{X}}\zeta_{k}(3^{k}s)=\sup_{s\in\mathbb{R}}\sum_{0\leq j&lt;2^{k}}|\widetilde{M}^{(k)}(\tfrac{s}{2^{k}}+\tfrac{j}{2^{k}})|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.p5.2" class="ltx_p">Furthermore, multiplication by powers of <math id="S3.SS3.p5.m4" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math> permutes the elements of <math id="S3.SS3.p5.m5" class="ltx_Math" alttext="\widehat{X}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>X</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\widehat{X}</annotation></semantics></math>, so recalling <a href="#S3.E20" title="In Proof of . ‣ 3.2 Proof of ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">20</span></a> we get</p>
<table id="S3.E24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(24)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E24.m1" class="ltx_Math" alttext="\|\zeta_{k}\|_{\infty}=\sup_{s\in\mathbb{R}}\sum_{0\leq j&lt;2^{k}}|\widetilde{M}^{(k)}(\tfrac{s}{2^{k}}+\tfrac{j}{2^{k}})|^{2}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>ζ</mi><mi>k</mi></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>s</mi><mo>∈</mo><mi>ℝ</mi></mrow></munder><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mn>0</mn><mo>≤</mo><mi>j</mi><mo>&lt;</mo><msup><mn>2</mn><mi>k</mi></msup></mrow></munder><msup><mrow><mo stretchy="false">|</mo><mrow><msup><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mstyle displaystyle="false"><mfrac><mi>s</mi><msup><mn>2</mn><mi>k</mi></msup></mfrac></mstyle><mo>+</mo><mstyle displaystyle="false"><mfrac><mi>j</mi><msup><mn>2</mn><mi>k</mi></msup></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\zeta_{k}\|_{\infty}=\sup_{s\in\mathbb{R}}\sum_{0\leq j&lt;2^{k}}|\widetilde{M}^{(k)}(\tfrac{s}{2^{k}}+\tfrac{j}{2^{k}})|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.p5.3" class="ltx_p">We use this formula to compute <math id="S3.SS3.p5.m6" class="ltx_Math" alttext="\|\zeta_{2}\|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><msub><mi>ζ</mi><mn>2</mn></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\|\zeta_{2}\|_{\infty}</annotation></semantics></math>.</p>
</div>
<div id="S3.SS3.p6" class="ltx_para">
<p id="S3.SS3.p6.1" class="ltx_p">Set <math id="S3.SS3.p6.m1" class="ltx_Math" alttext="k=2" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">k=2</annotation></semantics></math>.
For any <math id="S3.SS3.p6.m2" class="ltx_Math" alttext="r\in\widehat{X}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>∈</mo><mover accent="true"><mi>X</mi><mo>^</mo></mover></mrow><annotation encoding="application/x-tex">r\in\widehat{X}</annotation></semantics></math>, we can compute using (<a href="#S3.E22" title="Equation 22 ‣ 3.3 Proving that ‖𝜁_2‖_∞&lt;1 ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>)</p>
<table id="S3.Ex128" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex128.m1" class="ltx_Math" alttext="\widetilde{M}^{(2)}(r)=\frac{1}{9}\bigl(1-e(-3r)+e(-6r)\bigr)\bigl(1-e(-2r)+e(-4r)\bigr)=\sum_{0\leq\ell\leq 10}g_{\ell}\,e(-\ell r)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mn>9</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>e</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>e</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>e</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>e</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mn>0</mn><mo>≤</mo><mi mathvariant="normal">ℓ</mi><mo>≤</mo><mn>10</mn></mrow></munder><mrow><msub><mi>g</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\widetilde{M}^{(2)}(r)=\frac{1}{9}\bigl(1-e(-3r)+e(-6r)\bigr)\bigl(1-e(-2r)+e(-4r)\bigr)=\sum_{0\leq\ell\leq 10}g_{\ell}\,e(-\ell r),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.p6.2" class="ltx_p">where</p>
<table id="S3.Ex129" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex129.m1" class="ltx_Math" alttext="(g_{0},g_{1},g_{2},g_{3},g_{4},g_{5},g_{6},g_{7},g_{8},g_{9},g_{10})=\tfrac{1}{9}(1,0,-1,-1,1,1,1,-1,-1,0,1)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mn>0</mn></msub><mo>,</mo><msub><mi>g</mi><mn>1</mn></msub><mo>,</mo><msub><mi>g</mi><mn>2</mn></msub><mo>,</mo><msub><mi>g</mi><mn>3</mn></msub><mo>,</mo><msub><mi>g</mi><mn>4</mn></msub><mo>,</mo><msub><mi>g</mi><mn>5</mn></msub><mo>,</mo><msub><mi>g</mi><mn>6</mn></msub><mo>,</mo><msub><mi>g</mi><mn>7</mn></msub><mo>,</mo><msub><mi>g</mi><mn>8</mn></msub><mo>,</mo><msub><mi>g</mi><mn>9</mn></msub><mo>,</mo><msub><mi>g</mi><mn>10</mn></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mstyle displaystyle="false"><mfrac><mn>1</mn><mn>9</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo>,</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(g_{0},g_{1},g_{2},g_{3},g_{4},g_{5},g_{6},g_{7},g_{8},g_{9},g_{10})=\tfrac{1}{9}(1,0,-1,-1,1,1,1,-1,-1,0,1).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.p6.3" class="ltx_p">Using the identity <math id="S3.SS3.p6.m3" class="ltx_Math" alttext="|\xi|^{2}=\xi\,\xi^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">|</mo><mi>ξ</mi><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo>=</mo><mrow><mi>ξ</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>ξ</mi><mo>∗</mo></msup></mrow></mrow><annotation encoding="application/x-tex">|\xi|^{2}=\xi\,\xi^{*}</annotation></semantics></math> for <math id="S3.SS3.p6.m4" class="ltx_Math" alttext="\xi\in\mathbb{C}" display="inline" intent=":literal"><semantics><mrow><mi>ξ</mi><mo>∈</mo><mi>ℂ</mi></mrow><annotation encoding="application/x-tex">\xi\in\mathbb{C}</annotation></semantics></math> (where we let <math id="S3.SS3.p6.m5" class="ltx_Math" alttext="\xi^{*}" display="inline" intent=":literal"><semantics><msup><mi>ξ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\xi^{*}</annotation></semantics></math> denote the complex conjugate of <math id="S3.SS3.p6.m6" class="ltx_Math" alttext="\xi\in\mathbb{C}" display="inline" intent=":literal"><semantics><mrow><mi>ξ</mi><mo>∈</mo><mi>ℂ</mi></mrow><annotation encoding="application/x-tex">\xi\in\mathbb{C}</annotation></semantics></math>), we get</p>
<table id="S3.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex130"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex130.m1" class="ltx_Math" alttext="\displaystyle\sum_{0\leq j&lt;4}\left|\widetilde{M}^{(2)}\!\left(\tfrac{s}{4}+\tfrac{j}{4}\right)\right|^{2}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mn>0</mn><mo>≤</mo><mi>j</mi><mo>&lt;</mo><mn>4</mn></mrow></munder></mstyle><msup><mrow><mo>|</mo><mrow><msup><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><mi>s</mi><mn>4</mn></mfrac><mo>+</mo><mfrac><mi>j</mi><mn>4</mn></mfrac></mrow><mo>)</mo></mrow></mrow><mo>|</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{0\leq j&lt;4}\left|\widetilde{M}^{(2)}\!\left(\tfrac{s}{4}+\tfrac{j}{4}\right)\right|^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex130.m2" class="ltx_Math" alttext="\displaystyle=\sum_{0\leq j&lt;4}\sum_{0\leq\ell,\ell^{\prime}\leq 10}g_{\ell}g_{\ell^{\prime}}\,e\!\left(-(\ell-\ell^{\prime})\!\left(\tfrac{s}{4}+\tfrac{j}{4}\right)\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mn>0</mn><mo>≤</mo><mi>j</mi><mo>&lt;</mo><mn>4</mn></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mn>0</mn><mo>≤</mo><mi mathvariant="normal">ℓ</mi></mrow><mo>,</mo><mrow><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup><mo>≤</mo><mn>10</mn></mrow></mrow></munder></mstyle><mrow><msub><mi>g</mi><mi mathvariant="normal">ℓ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mpadded style="width:0.296em;" width="0.296em"><mi>e</mi></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><msup><mi mathvariant="normal">ℓ</mi><mo>′</mo></msup></mrow><mpadded style="width:0.219em;" width="0.219em"><mo stretchy="false">)</mo></mpadded></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><mi>s</mi><mn>4</mn></mfrac><mo>+</mo><mfrac><mi>j</mi><mn>4</mn></mfrac></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{0\leq j&lt;4}\sum_{0\leq\ell,\ell^{\prime}\leq 10}g_{\ell}g_{\ell^{\prime}}\,e\!\left(-(\ell-\ell^{\prime})\!\left(\tfrac{s}{4}+\tfrac{j}{4}\right)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex131"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex131.m1" class="ltx_Math" alttext="\displaystyle=\frac{4}{81}\Bigl(9+e(s)+e(-s)-2e(2s)-2e(-2s)\Bigr)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>4</mn><mn>81</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mn>9</mn><mo>+</mo><mrow><mi>e</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>e</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{4}{81}\Bigl(9+e(s)+e(-s)-2e(2s)-2e(-2s)\Bigr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.p6.4" class="ltx_p">Since <math id="S3.SS3.p6.m7" class="ltx_Math" alttext="2\cos(t)=e(t)+e(-t)" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mi>e</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>e</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">2\cos(t)=e(t)+e(-t)</annotation></semantics></math>, we may rewrite the last expression as</p>
<table id="S3.Ex132" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex132.m1" class="ltx_Math" alttext="\sum_{0\leq j&lt;4}\left|\widetilde{M}^{(2)}\!\left(\tfrac{s}{4}+\tfrac{j}{4}\right)\right|^{2}=\frac{4}{81}\Bigl(9+2\cos(2\pi s)-4\cos(4\pi s)\Bigr)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mn>0</mn><mo>≤</mo><mi>j</mi><mo>&lt;</mo><mn>4</mn></mrow></munder><msup><mrow><mo lspace="0em">|</mo><mrow><msup><mover accent="true"><mi>M</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="false"><mfrac><mi>s</mi><mn>4</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle="false"><mfrac><mi>j</mi><mn>4</mn></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>|</mo></mrow><mn>2</mn></msup></mrow><mo>=</mo><mrow><mfrac><mn>4</mn><mn>81</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mn>9</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mn>4</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{0\leq j&lt;4}\left|\widetilde{M}^{(2)}\!\left(\tfrac{s}{4}+\tfrac{j}{4}\right)\right|^{2}=\frac{4}{81}\Bigl(9+2\cos(2\pi s)-4\cos(4\pi s)\Bigr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.p6.5" class="ltx_p">Thus, by (<a href="#S3.E24" title="Equation 24 ‣ 3.3 Proving that ‖𝜁_2‖_∞&lt;1 ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>),</p>
<table id="S3.Ex133" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex133.m1" class="ltx_Math" alttext="\|\zeta_{2}\|_{\infty}=\sup_{s\in\mathbb{R}}\frac{4}{81}\Bigl(9+2\cos(2\pi s)-4\cos(4\pi s)\Bigr)\leq\frac{4}{81}\Bigl(9+2+4\Bigr)=\frac{20}{27}&lt;1," display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>ζ</mi><mn>2</mn></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">sup</mo><mrow><mi>s</mi><mo>∈</mo><mi>ℝ</mi></mrow></munder><mrow><mfrac><mn>4</mn><mn>81</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mn>9</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mn>4</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mfrac><mn>4</mn><mn>81</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mn>9</mn><mo>+</mo><mn>2</mn><mo>+</mo><mn>4</mn></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>=</mo><mfrac><mn>20</mn><mn>27</mn></mfrac><mo>&lt;</mo><mn>1</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\|\zeta_{2}\|_{\infty}=\sup_{s\in\mathbb{R}}\frac{4}{81}\Bigl(9+2\cos(2\pi s)-4\cos(4\pi s)\Bigr)\leq\frac{4}{81}\Bigl(9+2+4\Bigr)=\frac{20}{27}&lt;1,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS3.p6.6" class="ltx_p">which proves our claim.</p>
</div>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4 </span>Concluding remarks</h2>

<div id="S4.p1" class="ltx_para">
<p id="S4.p1.1" class="ltx_p">This article opens the way to many challenging questions. First, the Thue–Morse word <math id="S4.p1.m1" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> can be generalized in two ways: we may consider the sum-of-digits modulo an integer <math id="S4.p1.m2" class="ltx_Math" alttext="m\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">m\geq 2</annotation></semantics></math> instead of <math id="S4.p1.m3" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> and/or we may change the numeration system to other rational bases <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib1" title="" class="ltx_ref">24</a>, <a href="#bib.bib2" title="" class="ltx_ref">44</a>]</cite>.</p>
</div>
<div id="S4.p2" class="ltx_para">
<p id="S4.p2.1" class="ltx_p">In the first option, the generalized Thue–Morse word corresponding to the sum-of-digits of <math id="S4.p2.m1" class="ltx_Math" alttext="3/2" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">3/2</annotation></semantics></math>-expansions modulo <math id="S4.p2.m2" class="ltx_Math" alttext="m\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">m\geq 2</annotation></semantics></math> is obtained from the <math id="S4.p2.m3" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-block substitution</p>
<table id="S4.Ex134" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex134.m1" class="ltx_Math" alttext="ab\mapsto a(a+2\bmod{m})(b+1\bmod{m})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow><mo stretchy="false">↦</mo><mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>a</mi><mo>+</mo><mn>2</mn></mrow><mo>mod</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>b</mi><mo>+</mo><mn>1</mn></mrow><mo>mod</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">ab\mapsto a(a+2\bmod{m})(b+1\bmod{m}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p2.2" class="ltx_p">For instance, with <math id="S4.p2.m4" class="ltx_Math" alttext="m=4" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">m=4</annotation></semantics></math>, the prefix of the word is <math id="S4.p2.m5" class="ltx_math_unparsed" alttext="{\tt 023310131130132311130200132130}\cdots" display="inline" intent=":literal"><semantics><mrow><mn>𝟶𝟸𝟹𝟹𝟷𝟶𝟷𝟹𝟷𝟷𝟹𝟶𝟷𝟹𝟸𝟹𝟷𝟷𝟷𝟹𝟶𝟸𝟶𝟶𝟷𝟹𝟸𝟷𝟹𝟶</mn><mo lspace="0em">⋯</mo></mrow><annotation encoding="application/x-tex">{\tt 023310131130132311130200132130}\cdots</annotation></semantics></math>.
In that setting, following the same lines, the recurrence in (<a href="#S3.E10" title="Equation 10 ‣ Item 3. ‣ Lemma 19. ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>) becomes</p>
<table id="S4.Ex135" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex135.m1" class="ltx_Math" alttext="\tfrac{3}{2}\mu_{n}(c,k)=\mu_{n+1}(c,2q_{n}k)+\mu_{n+1}(c+1,2q_{n}k-q_{n})+\mu_{n+1}(c+2,2q_{n}k-2q_{n})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="false"><mfrac><mn>3</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>μ</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>μ</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>−</mo><msub><mi>q</mi><mi>n</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>μ</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>+</mo><mn>2</mn></mrow><mo>,</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>n</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tfrac{3}{2}\mu_{n}(c,k)=\mu_{n+1}(c,2q_{n}k)+\mu_{n+1}(c+1,2q_{n}k-q_{n})+\mu_{n+1}(c+2,2q_{n}k-2q_{n}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p2.3" class="ltx_p">for <math id="S4.p2.m6" class="ltx_Math" alttext="n\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n\geq 0</annotation></semantics></math> and <math id="S4.p2.m7" class="ltx_Math" alttext="c\in\mathbb{Z}/m\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mrow><mrow><mi>ℤ</mi><mo>/</mo><mi>m</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ℤ</mi></mrow></mrow><annotation encoding="application/x-tex">c\in\mathbb{Z}/m\mathbb{Z}</annotation></semantics></math>.
As in <a href="#Thmtheorem20" title="Proposition 20. ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">20</span></a>, we have a collection of nonnegative real numbers</p>
<table id="S4.Ex136" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex136.m1" class="ltx_math_unparsed" alttext="\bigl\{\mu_{n}(c,k)\mid n\geq 0,\,c\in\mathbb{Z}/m\mathbb{Z},\,k\in\mathbb{Z}\bigr\}" display="block" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>μ</mi><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>n</mi><mo>≥</mo><mn>0</mn><mo rspace="0.337em">,</mo><mi>c</mi><mo>∈</mo><mi>ℤ</mi><mo>/</mo><mi>m</mi><mi>ℤ</mi><mo rspace="0.337em">,</mo><mi>k</mi><mo>∈</mo><mi>ℤ</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\bigl\{\mu_{n}(c,k)\mid n\geq 0,\,c\in\mathbb{Z}/m\mathbb{Z},\,k\in\mathbb{Z}\bigr\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p2.4" class="ltx_p">satisfying properties similar to those in <a href="#Thmtheorem20" title="Proposition 20. ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">20</span></a>. The technical problem to overcome is that the difference function <math id="S4.p2.m8" class="ltx_Math" alttext="\delta_{n}:X\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>δ</mi><mi>n</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>X</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">\delta_{n}:X\to\mathbb{R}</annotation></semantics></math> appearing in the proof of <a href="#Thmtheorem20" title="Proposition 20. ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">20</span></a> has to be replaced by a function taking into account the different pairs of letters. We believe that the frequency of each symbol exists and is equal to <math id="S4.p2.m9" class="ltx_Math" alttext="1/m" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">1/m</annotation></semantics></math> (this fact is also supported by computer experiments).</p>
</div>
<div id="S4.p3" class="ltx_para">
<p id="S4.p3.1" class="ltx_p">Another direction of research is as follows.
Let <math id="S4.p3.m1" class="ltx_Math" alttext="\mathbf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\mathbf{x}</annotation></semantics></math> be a fixed point of a <math id="S4.p3.m2" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>-block substitution where the image of each <math id="S4.p3.m3" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>-block has length <math id="S4.p3.m4" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>. Broader questions of interest are the following:</p>
<ol id="S4.I1" class="ltx_enumerate">
<li id="S4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="S4.I1.i1.p1" class="ltx_para">
<p id="S4.I1.i1.p1.1" class="ltx_p">Does the frequency of a symbol <math id="S4.I1.i1.p1.m1" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> in <math id="S4.I1.i1.p1.m2" class="ltx_Math" alttext="\mathbf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\mathbf{x}</annotation></semantics></math> exist?</p>
</div></li>
<li id="S4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="S4.I1.i2.p1" class="ltx_para">
<p id="S4.I1.i2.p1.1" class="ltx_p">If it exists, is it always a rational number?</p>
</div></li>
<li id="S4.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="S4.I1.i3.p1" class="ltx_para">
<p id="S4.I1.i3.p1.1" class="ltx_p">Can we easily determine if such an infinite word <math id="S4.I1.i3.p1.m1" class="ltx_Math" alttext="\mathbf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\mathbf{x}</annotation></semantics></math> is uniformly recurrent? Indeed, in the classical setting, a <math id="S4.I1.i3.p1.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-automatic sequence is uniformly recurrent if and only if its underlying <math id="S4.I1.i3.p1.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-uniform morphism is primitive <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib3" title="" class="ltx_ref">20</a>]</cite>. We do not have such a result for alternating morphisms.</p>
</div></li>
</ol>
</div>
<div id="S4.p4" class="ltx_para">
<p id="S4.p4.1" class="ltx_p">Answering the first two questions would help to address the problem of determining the frequency of factors (and not only symbols). Indeed, it is easy to see that the sliding block code — with window size <math id="S4.p4.m1" class="ltx_Math" alttext="\ell\geq 1" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\ell\geq 1</annotation></semantics></math> — of a fixed point of a <math id="S4.p4.m2" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>-block substitution where the image of each <math id="S4.p4.m3" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>-block has length <math id="S4.p4.m4" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>, is also generated by a substitution with the same property. As an example, consider a window of size <math id="S4.p4.m5" class="ltx_Math" alttext="\ell=2" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\ell=2</annotation></semantics></math>. Hence, blocks of size <math id="S4.p4.m6" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> represent integers in <math id="S4.p4.m7" class="ltx_Math" alttext="\{0,1,2,3\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>3</mn></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{0,1,2,3\}</annotation></semantics></math>. The sliding block code of <math id="S4.p4.m8" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> then starts with</p>
<table id="S4.Ex137" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex137.m1" class="ltx_math_unparsed" alttext="\mathbf{c}=(c_{n})_{n\geq 0}={\tt 013321333321321333320001321320}\cdots," display="block" intent=":literal"><semantics><mrow><mi>𝐜</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></msub><mo>=</mo><mn>𝟶𝟷𝟹𝟹𝟸𝟷𝟹𝟹𝟹𝟹𝟸𝟷𝟹𝟸𝟷𝟹𝟹𝟹𝟹𝟸𝟶𝟶𝟶𝟷𝟹𝟸𝟷𝟹𝟸𝟶</mn><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbf{c}=(c_{n})_{n\geq 0}={\tt 013321333321321333320001321320}\cdots,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p4.2" class="ltx_p">where <math id="S4.p4.m9" class="ltx_Math" alttext="c_{n}=\val_{2}(t_{n}t_{n+1})=2t_{n}+t_{n+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>n</mi></msub><mo>=</mo><mrow><msub><mi>val</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>t</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mi>n</mi></msub></mrow><mo>+</mo><msub><mi>t</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">c_{n}=\val_{2}(t_{n}t_{n+1})=2t_{n}+t_{n+1}</annotation></semantics></math> for all <math id="S4.p4.m10" class="ltx_Math" alttext="n\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n\geq 0</annotation></semantics></math>.
This word is a fixed point of the substitution</p>
<table id="S4.EGx15" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex138"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex138.m1" class="ltx_Math" alttext="\displaystyle{\tt 00}\to{\tt 012},\ {\tt 01}\to{\tt 013},\ {\tt 12}\to{\tt 000},\ {\tt 13}\to{\tt 001}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>𝟶𝟶</mn><mo stretchy="false">→</mo><mn>𝟶𝟷𝟸</mn></mrow><mo>,</mo><mrow><mn class="ltx_mathvariant_monospace" mathvariant="monospace"> 01</mn><mo stretchy="false">→</mo><mn>𝟶𝟷𝟹</mn></mrow><mo>,</mo><mrow><mn class="ltx_mathvariant_monospace" mathvariant="monospace"> 12</mn><mo stretchy="false">→</mo><mn>𝟶𝟶𝟶</mn></mrow><mo>,</mo><mrow><mn class="ltx_mathvariant_monospace" mathvariant="monospace"> 13</mn><mo stretchy="false">→</mo><mn>𝟶𝟶𝟷</mn></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\tt 00}\to{\tt 012},\ {\tt 01}\to{\tt 013},\ {\tt 12}\to{\tt 000},\ {\tt 13}\to{\tt 001},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex139"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex139.m1" class="ltx_Math" alttext="\displaystyle{\tt 20}\to{\tt 332},\ {\tt 21}\to{\tt 333},\ {\tt 32}\to{\tt 320},\ {\tt 33}\to{\tt 321}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>𝟸𝟶</mn><mo stretchy="false">→</mo><mn>𝟹𝟹𝟸</mn></mrow><mo>,</mo><mrow><mn class="ltx_mathvariant_monospace" mathvariant="monospace"> 21</mn><mo stretchy="false">→</mo><mn>𝟹𝟹𝟹</mn></mrow><mo>,</mo><mrow><mn class="ltx_mathvariant_monospace" mathvariant="monospace"> 32</mn><mo stretchy="false">→</mo><mn>𝟹𝟸𝟶</mn></mrow><mo>,</mo><mrow><mn class="ltx_mathvariant_monospace" mathvariant="monospace"> 33</mn><mo stretchy="false">→</mo><mn>𝟹𝟸𝟷</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\tt 20}\to{\tt 332},\ {\tt 21}\to{\tt 333},\ {\tt 32}\to{\tt 320},\ {\tt 33}\to{\tt 321}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p4.3" class="ltx_p">Note that for any three consecutive symbols <math id="S4.p4.m11" class="ltx_Math" alttext="t_{i}t_{i+1}t_{i+2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mrow><mi>i</mi><mo>+</mo><mn>2</mn></mrow></msub></mrow><annotation encoding="application/x-tex">t_{i}t_{i+1}t_{i+2}</annotation></semantics></math>, if <math id="S4.p4.m12" class="ltx_Math" alttext="t_{i+1}={\tt 0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mn>𝟶</mn></mrow><annotation encoding="application/x-tex">t_{i+1}={\tt 0}</annotation></semantics></math> (resp., <math id="S4.p4.m13" class="ltx_Math" alttext="t_{i+1}={\tt 1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mn>𝟷</mn></mrow><annotation encoding="application/x-tex">t_{i+1}={\tt 1}</annotation></semantics></math>), then <math id="S4.p4.m14" class="ltx_Math" alttext="c_{i}=\val_{2}(t_{i}{\tt 0})" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>i</mi></msub><mo>=</mo><mrow><msub><mi>val</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>t</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mn>𝟶</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c_{i}=\val_{2}(t_{i}{\tt 0})</annotation></semantics></math> is even (resp., odd) and <math id="S4.p4.m15" class="ltx_Math" alttext="c_{i+1}=\val_{2}({\tt 0}t_{i+1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><msub><mi>val</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>𝟶</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c_{i+1}=\val_{2}({\tt 0}t_{i+1})</annotation></semantics></math> is in <math id="S4.p4.m16" class="ltx_Math" alttext="\{{\tt 0},{\tt 1}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mn>𝟶</mn><mo>,</mo><mn>𝟷</mn><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{{\tt 0},{\tt 1}\}</annotation></semantics></math> (resp., <math id="S4.p4.m17" class="ltx_Math" alttext="c_{i+1}=\val_{2}({\tt 1}t_{i+1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><msub><mi>val</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>𝟷</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c_{i+1}=\val_{2}({\tt 1}t_{i+1})</annotation></semantics></math> is in <math id="S4.p4.m18" class="ltx_Math" alttext="\{{\tt 2},{\tt 3}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mn>𝟸</mn><mo>,</mo><mn>𝟹</mn><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{{\tt 2},{\tt 3}\}</annotation></semantics></math>). This explains why only eight <math id="S4.p4.m19" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-blocks may appear.</p>
</div>
<div id="S4.p5" class="ltx_para">
<p id="S4.p5.1" class="ltx_p">Experiments show that in this word, the frequencies of <span id="S4.p5.1.1" class="ltx_text ltx_font_typewriter">0</span> and <span id="S4.p5.1.2" class="ltx_text ltx_font_typewriter">3</span> are equal to <math id="S4.p5.m1" class="ltx_Math" alttext="3/10" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo>/</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">3/10</annotation></semantics></math> whereas those of <span id="S4.p5.1.3" class="ltx_text ltx_font_typewriter">1</span> and <span id="S4.p5.1.4" class="ltx_text ltx_font_typewriter">2</span> are equal to <math id="S4.p5.m2" class="ltx_Math" alttext="2/10" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo>/</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">2/10</annotation></semantics></math>. This would mean that the frequencies of <span id="S4.p5.1.5" class="ltx_text ltx_font_typewriter">00</span> and <span id="S4.p5.1.6" class="ltx_text ltx_font_typewriter">11</span> (resp., <span id="S4.p5.1.7" class="ltx_text ltx_font_typewriter">01</span> and <span id="S4.p5.1.8" class="ltx_text ltx_font_typewriter">10</span>) in <math id="S4.p5.m3" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> are equal to <math id="S4.p5.m4" class="ltx_Math" alttext="3/10" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo>/</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">3/10</annotation></semantics></math> (resp., <math id="S4.p5.m5" class="ltx_Math" alttext="2/10" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo>/</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">2/10</annotation></semantics></math>). In particular, this shows that the argument in the proof of <a href="#Thmtheorem20" title="Proposition 20. ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">20</span></a>, that <math id="S4.p5.m6" class="ltx_Math" alttext="\delta_{n}" display="inline" intent=":literal"><semantics><msub><mi>δ</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\delta_{n}</annotation></semantics></math> is identically zero, fails since <math id="S4.p5.m7" class="ltx_Math" alttext="\mu_{n}({\tt 0},\pi_{n}(\mathbf{c}))-\mu_{n}({\tt 1},\pi_{n}(\mathbf{c}))" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟶</mn><mo>,</mo><mrow><msub><mi>π</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐜</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟷</mn><mo>,</mo><mrow><msub><mi>π</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐜</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu_{n}({\tt 0},\pi_{n}(\mathbf{c}))-\mu_{n}({\tt 1},\pi_{n}(\mathbf{c}))</annotation></semantics></math> should not vanish.</p>
</div>
<div id="S4.p6" class="ltx_para">
<p id="S4.p6.1" class="ltx_p">This corresponds to the values described by Dekking for <math id="S4.p6.m1" class="ltx_Math" alttext="\mathbf{t}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝐭</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathbf{t}^{\prime}</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib12" title="" class="ltx_ref">19</a>]</cite>. Assume we want to compute the frequency of <span id="S4.p6.1.1" class="ltx_text ltx_font_typewriter">01</span> in <math id="S4.p6.m2" class="ltx_Math" alttext="\mathbf{t}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝐭</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathbf{t}^{\prime}</annotation></semantics></math>. By <a href="#Thmtheorem4" title="Lemma 4. ‣ 1.4 Dekking’s variation ‣ 1 Introduction ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">4</span></a>, each <span id="S4.p6.1.2" class="ltx_text ltx_font_typewriter">0</span> (resp., <span id="S4.p6.1.3" class="ltx_text ltx_font_typewriter">1</span>) in the prefix of <math id="S4.p6.m3" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> of length <math id="S4.p6.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> produces with <math id="S4.p6.m5" class="ltx_Math" alttext="\varphi" display="inline" intent=":literal"><semantics><mi>φ</mi><annotation encoding="application/x-tex">\varphi</annotation></semantics></math> one occurrence of <span id="S4.p6.1.4" class="ltx_text ltx_font_typewriter">01</span> in the prefix of <math id="S4.p6.m6" class="ltx_Math" alttext="\mathbf{t}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝐭</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathbf{t}^{\prime}</annotation></semantics></math> of length <math id="S4.p6.m7" class="ltx_Math" alttext="3n" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">3n</annotation></semantics></math>. Moreover, each <span id="S4.p6.1.5" class="ltx_text ltx_font_typewriter">01</span> in <math id="S4.p6.m8" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> produces an extra <span id="S4.p6.1.6" class="ltx_text ltx_font_typewriter">01</span> in <math id="S4.p6.m9" class="ltx_Math" alttext="\mathbf{t}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝐭</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathbf{t}^{\prime}</annotation></semantics></math>. Therefore, assuming the existence of frequencies in <math id="S4.p6.m10" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> yields</p>
<table id="S4.Ex140" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex140.m1" class="ltx_Math" alttext="\freq_{\mathbf{t^{\prime}}}({\tt 01})=\frac{1}{3}\left(\freq_{\mathbf{t}_{3/2}}({\tt 0})+\freq_{\mathbf{t}_{3/2}}({\tt 1})+\freq_{\mathbf{t}_{3/2}}({\tt 01})\right)=\frac{1}{3}+\frac{2}{30}=\frac{4}{10}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>freq</mi><msup><mi>𝐭</mi><mo>′</mo></msup></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>𝟶𝟷</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mn>3</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>freq</mi><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>𝟶</mn><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>freq</mi><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>𝟷</mn><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>freq</mi><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>𝟶𝟷</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mn>3</mn></mfrac><mo>+</mo><mfrac><mn>2</mn><mn>30</mn></mfrac></mrow><mo>=</mo><mfrac><mn>4</mn><mn>10</mn></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\freq_{\mathbf{t^{\prime}}}({\tt 01})=\frac{1}{3}\left(\freq_{\mathbf{t}_{3/2}}({\tt 0})+\freq_{\mathbf{t}_{3/2}}({\tt 1})+\freq_{\mathbf{t}_{3/2}}({\tt 01})\right)=\frac{1}{3}+\frac{2}{30}=\frac{4}{10}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.p7" class="ltx_para">
<p id="S4.p7.1" class="ltx_p">The open problems addressed above do not allow us to tackle the conjectures related to the Oldenburger–Kolakoski word <math id="S4.p7.m1" class="ltx_Math" alttext="\mathbf{k}" display="inline" intent=":literal"><semantics><mi>𝐤</mi><annotation encoding="application/x-tex">\mathbf{k}</annotation></semantics></math>. Indeed, in this article, we consider substitutions whose images have constant length. For the word <math id="S4.p7.m2" class="ltx_Math" alttext="\mathbf{k}" display="inline" intent=":literal"><semantics><mi>𝐤</mi><annotation encoding="application/x-tex">\mathbf{k}</annotation></semantics></math>, the substitution <math id="S4.p7.m3" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> is non-uniform (<a href="#S1.SS2" title="1.2 Periodically iterated morphisms ‣ 1 Introduction ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">1.2</span></a>). This has an important consequence: the positions of letters modulo powers of <math id="S4.p7.m4" class="ltx_Math" alttext="2^{n}" display="inline" intent=":literal"><semantics><msup><mn>2</mn><mi>n</mi></msup><annotation encoding="application/x-tex">2^{n}</annotation></semantics></math> do not control the iteration of the substitution. In other words, unlike in the constant-length setting, congruence classes modulo <math id="S4.p7.m5" class="ltx_Math" alttext="2^{n}" display="inline" intent=":literal"><semantics><msup><mn>2</mn><mi>n</mi></msup><annotation encoding="application/x-tex">2^{n}</annotation></semantics></math> are no longer sufficient to describe how letters evolve under iteration. Even if one replaces the naive notion of parity by an appropriate one — namely, the state of the iterated transducer in which a given letter occurs — one still needs an equation of the form <math id="S4.p7.m6" class="ltx_Math" alttext="\mu_{n}({\tt 1},k)+\mu_{n}({\tt 2},k)=2^{-n}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟷</mn><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟸</mn><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><msup><mn>2</mn><mrow><mo>−</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mu_{n}({\tt 1},k)+\mu_{n}({\tt 2},k)=2^{-n}</annotation></semantics></math> in order to apply Fourier analysis. Without such a relation, the <math id="S4.p7.m7" class="ltx_Math" alttext="L^{2}" display="inline" intent=":literal"><semantics><msup><mi>L</mi><mn>2</mn></msup><annotation encoding="application/x-tex">L^{2}</annotation></semantics></math>-norms arising in the Fourier approach become unbounded, preventing any meaningful spectral control. This condition is in fact equivalent to an equidistribution of these generalized “parities”. However, such a property already appears to be close to uniform recurrence of the word itself.</p>
</div>
<div id="S4.p8" class="ltx_para">
<p id="S4.p8.1" class="ltx_p">Nonetheless, we hope that the new techniques developed here could provide new research directions toward solving the conjectures.</p>
</div>
</section>
<section id="Sx1" class="ltx_section">
