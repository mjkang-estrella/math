#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 4.89 -63.51)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.F2.pic1.m10" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 4.89 -24.14)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.F2.pic1.m11" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math></span></span></foreignObject></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 2: </span>The first levels of the tree associated with expansions in base <math id="S1.F2.m2" class="ltx_Math" alttext="3/2" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">3/2</annotation></semantics></math>.</figcaption>
</figure>
<div id="Thmtheorem3" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem3.2" class="ltx_text ltx_font_bold">Definition 3</span></span><span id="Thmtheorem3.3" class="ltx_text ltx_font_bold"> </span>(Our sequence of interest)<span id="Thmtheorem3.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem3.p1" class="ltx_para">
<p id="Thmtheorem3.p1.1" class="ltx_p">The sequence <math id="Thmtheorem3.p1.m1" class="ltx_Math" alttext="\mathbf{t}_{3/2}=(t_{n})_{n\geq 0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbf{t}_{3/2}=(t_{n})_{n\geq 0}</annotation></semantics></math>, whose prefix is given in (<a href="#S1.E1" title="Equation 1 ‣ 1 Introduction ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>), admits several equivalent descriptions. First, as in the Thue–Morse word recalled in <a href="#S1.SS1" title="1.1 Substitutions or iterated morphisms ‣ 1 Introduction ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">1.1</span></a>, its <math id="Thmtheorem3.p1.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-th symbol is the sum-of-digits of <math id="Thmtheorem3.p1.m3" class="ltx_Math" alttext="\langle n\rangle_{3/2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">⟨</mo><mi>n</mi><mo stretchy="false">⟩</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\langle n\rangle_{3/2}</annotation></semantics></math> reduced modulo <math id="Thmtheorem3.p1.m4" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>; again see <a href="#S1.T1" title="In 1.3 The base 3/2 and the corresponding Thue–Morse word ‣ 1 Introduction ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Table</span> <span class="ltx_text ltx_ref_tag">1</span></a>. Hence, it can also be generated using a deterministic finite automaton with output; see <a href="#S1.F3" title="In Definition 3 (Our sequence of interest). ‣ 1.3 The base 3/2 and the corresponding Thue–Morse word ‣ 1 Introduction ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Fig.</span> <span class="ltx_text ltx_ref_tag">3</span></a>.</p>
</div>
<figure id="S1.F3" class="ltx_figure"><span class="ltx_inline-block"><svg id="S1.F3.pic1" class="ltx_picture ltx_centering" height="95.44" overflow="visible" version="1.1" viewBox="0 0 133.72 95.44" width="133.72"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,95.44) matrix(1 0 0 -1 0 0) translate(39.65,0) translate(0,34.34)"><g style="--ltx-stroke-color:#000000;" stroke="#000000"><path style="fill:none" d="M 13.84 0 C 13.84 7.64 7.64 13.84 0 13.84 C -7.64 13.84 -13.84 7.64 -13.84 0 C -13.84 -7.64 -7.64 -13.84 0 -13.84 C 7.64 -13.84 13.84 -7.64 13.84 0 Z M 0 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -3.63 -4.23)"><foreignObject style="--ltx-fo-width:0.53em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:10pt;" height="8.46" overflow="visible" transform="matrix(1 0 0 -1 0 8.46)" width="7.26"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.F3.pic1.m1" class="ltx_Math" alttext="{\tt 0}" display="inline" intent=":literal"><semantics><mn>𝟶</mn><annotation encoding="application/x-tex">{\tt 0}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;" stroke="#000000"><path style="fill:none" d="M 92.58 0 C 92.58 7.64 86.38 13.84 78.74 13.84 C 71.1 13.84 64.9 7.64 64.9 0 C 64.9 -7.64 71.1 -13.84 78.74 -13.84 C 86.38 -13.84 92.58 -7.64 92.58 0 Z M 78.74 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 75.11 -4.23)"><foreignObject style="--ltx-fo-width:0.53em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:10pt;" height="8.46" overflow="visible" transform="matrix(1 0 0 -1 0 8.46)" width="7.26"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.F3.pic1.m2" class="ltx_Math" alttext="{\tt 1}" display="inline" intent=":literal"><semantics><mn>𝟷</mn><annotation encoding="application/x-tex">{\tt 1}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M -39.37 0 L -20.48 0"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 -20.48 0)"><path d="M 5.26 0 C 4.61 0.16 1.77 1.04 0 2.01 L 0 -2.01 C 1.77 -1.04 4.61 -0.16 5.26 0 Z"></path></g><path style="fill:none" d="M -3.65 13.63 C -9.55 35.65 9.55 35.65 5.3 19.78"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-0.25882 -0.96593 0.96593 -0.25882 5.3 19.78)"><path d="M 5.26 0 C 4.61 0.16 1.77 1.04 0 2.01 L 0 -2.01 C 1.77 -1.04 4.61 -0.16 5.26 0 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -9.99 42.64)"><foreignObject style="--ltx-fo-width:1.44em;--ltx-fo-height:0.64em;--ltx-fo-depth:0.19em;font-size:10pt;" height="11.61" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="19.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.F3.pic1.m3" class="ltx_Math" alttext="0,2" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">0,2</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 12.22 7.06 C 30.56 17.64 48.18 17.64 61.01 10.24"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.86603 -0.5 0.5 0.86603 61.01 10.24)"><path d="M 5.26 0 C 4.61 0.16 1.77 1.04 0 2.01 L 0 -2.01 C 1.77 -1.04 4.61 -0.16 5.26 0 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 35.91 20.35)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.F3.pic1.m4" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 75.09 13.63 C 69.19 35.65 88.29 35.65 84.04 19.78"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-0.25882 -0.96593 0.96593 -0.25882 84.04 19.78)"><path d="M 5.26 0 C 4.61 0.16 1.77 1.04 0 2.01 L 0 -2.01 C 1.77 -1.04 4.61 -0.16 5.26 0 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 68.75 42.64)"><foreignObject style="--ltx-fo-width:1.44em;--ltx-fo-height:0.64em;--ltx-fo-depth:0.19em;font-size:10pt;" height="11.61" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="19.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.F3.pic1.m5" class="ltx_Math" alttext="0,2" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">0,2</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 66.52 -7.06 C 48.18 -17.64 30.56 -17.64 17.74 -10.24"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-0.86603 0.5 -0.5 -0.86603 17.74 -10.24)"><path d="M 5.26 0 C 4.61 0.16 1.77 1.04 0 2.01 L 0 -2.01 C 1.77 -1.04 4.61 -0.16 5.26 0 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 35.91 -29.27)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.F3.pic1.m6" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math></span></span></foreignObject></g></g></svg></span>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">Figure 3: </span>A DFAO generating the Thue–Morse sequence <math id="S1.F3.m3" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> in base <math id="S1.F3.m4" class="ltx_Math" alttext="3/2" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">3/2</annotation></semantics></math>.</figcaption>
</figure>
<div id="Thmtheorem3.p2" class="ltx_para">
<p id="Thmtheorem3.p2.1" class="ltx_p">Second, <math id="Thmtheorem3.p2.m1" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> is an alternating fixed point of the morphisms <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib29" title="" class="ltx_ref">39</a>, Sec. 3]</cite></p>
<table id="S1.E4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(4)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.E4.m1" class="ltx_Math" alttext="f_{0}\colon\left\{\begin{array}[]{l}{\tt 0}\mapsto{\tt 00},\\
{\tt 1}\mapsto{\tt 11},\\
\end{array}\right.\text{ and }f_{1}\colon\left\{\begin{array}[]{l}{\tt 0}\mapsto{\tt 1},\\
{\tt 1}\mapsto{\tt 0},\\
\end{array}\right." display="block" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>0</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo>{</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>𝟶</mn><mo stretchy="false">↦</mo><mn>𝟶𝟶</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>𝟷</mn><mo stretchy="false">↦</mo><mn>𝟷𝟷</mn></mrow><mo>,</mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow><mo lspace="0em" rspace="0em">​</mo><mtext> and </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>1</mn></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo>{</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>𝟶</mn><mo stretchy="false">↦</mo><mn>𝟷</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>𝟷</mn><mo stretchy="false">↦</mo><mn>𝟶</mn></mrow><mo>,</mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">f_{0}\colon\left\{\begin{array}[]{l}{\tt 0}\mapsto{\tt 00},\\
{\tt 1}\mapsto{\tt 11},\\
\end{array}\right.\text{ and }f_{1}\colon\left\{\begin{array}[]{l}{\tt 0}\mapsto{\tt 1},\\
{\tt 1}\mapsto{\tt 0},\\
\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem3.p2.2" class="ltx_p">i.e., <math id="Thmtheorem3.p2.m2" class="ltx_math_unparsed" alttext="\mathbf{t}_{3/2}=f_{0}(t_{0})f_{1}(t_{1})f_{0}(t_{2})f_{1}(t_{3})\cdots={\tt 00111011111011011}\cdots" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><mo>=</mo><msub><mi>f</mi><mn>0</mn></msub><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><msub><mi>f</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><msub><mi>f</mi><mn>0</mn></msub><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><msub><mi>f</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">=</mo><mn>𝟶𝟶𝟷𝟷𝟷𝟶𝟷𝟷𝟷𝟷𝟷𝟶𝟷𝟷𝟶𝟷𝟷</mn><mo lspace="0em">⋯</mo></mrow><annotation encoding="application/x-tex">\mathbf{t}_{3/2}=f_{0}(t_{0})f_{1}(t_{1})f_{0}(t_{2})f_{1}(t_{3})\cdots={\tt 00111011111011011}\cdots</annotation></semantics></math>. Third, it is the fixed point of a uniform <math id="Thmtheorem3.p2.m3" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-block substitution (every image of a <math id="Thmtheorem3.p2.m4" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-block has length <math id="Thmtheorem3.p2.m5" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>), namely</p>
<table id="S1.E5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(5)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.E5.m1" class="ltx_Math" alttext="\tau:\left\{\begin{array}[]{l}{\tt 00}\mapsto f_{0}({\tt 0})f_{1}({\tt 0})={\tt 001},\\
{\tt 01}\mapsto f_{0}({\tt 0})f_{1}({\tt 1})={\tt 000},\\
{\tt 10}\mapsto f_{0}({\tt 1})f_{1}({\tt 0})={\tt 111},\\
{\tt 11}\mapsto f_{0}({\tt 1})f_{1}({\tt 1})={\tt 110}.\\
\end{array}\right." display="block" intent=":literal"><semantics><mrow><mi>τ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo>{</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>𝟶𝟶</mn><mo stretchy="false">↦</mo><mrow><msub><mi>f</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟶</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟶</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>𝟶𝟶𝟷</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>𝟶𝟷</mn><mo stretchy="false">↦</mo><mrow><msub><mi>f</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟶</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟷</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>𝟶𝟶𝟶</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>𝟷𝟶</mn><mo stretchy="false">↦</mo><mrow><msub><mi>f</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟷</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟶</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>𝟷𝟷𝟷</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>𝟷𝟷</mn><mo stretchy="false">↦</mo><mrow><msub><mi>f</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟷</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟷</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>𝟷𝟷𝟶</mn></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">\tau:\left\{\begin{array}[]{l}{\tt 00}\mapsto f_{0}({\tt 0})f_{1}({\tt 0})={\tt 001},\\
{\tt 01}\mapsto f_{0}({\tt 0})f_{1}({\tt 1})={\tt 000},\\
{\tt 10}\mapsto f_{0}({\tt 1})f_{1}({\tt 0})={\tt 111},\\
{\tt 11}\mapsto f_{0}({\tt 1})f_{1}({\tt 1})={\tt 110}.\\
\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem3.p2.3" class="ltx_p">Hence, the sequence <math id="Thmtheorem3.p2.m6" class="ltx_Math" alttext="\mathbf{t}_{3/2}=(t_{n})_{n\geq 0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbf{t}_{3/2}=(t_{n})_{n\geq 0}</annotation></semantics></math> satisfies the relations</p>
<table id="S1.E6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(6)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.E6.m1" class="ltx_Math" alttext="t_{3n}=t_{3n+1}=t_{2n}\quad\text{ and }\quad t_{3n+2}=1-t_{2n+1}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>t</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo>=</mo><msub><mi>t</mi><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><msub><mi>t</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow><mspace style="width:1em;" width="1em"></mspace><mtext> and </mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mi>t</mi><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>2</mn></mrow></msub><mo>=</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>t</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">t_{3n}=t_{3n+1}=t_{2n}\quad\text{ and }\quad t_{3n+2}=1-t_{2n+1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem3.p2.4" class="ltx_p">for <math id="Thmtheorem3.p2.m7" class="ltx_Math" alttext="n\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n\geq 0</annotation></semantics></math>. One may notice the similarities with (<a href="#S1.E2" title="Equation 2 ‣ 1.1 Substitutions or iterated morphisms ‣ 1 Introduction ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>).</p>
</div>
</div>
<div id="S1.SS3.p3" class="ltx_para">
<p id="S1.SS3.p3.1" class="ltx_p">In this paper, we let <math id="S1.SS3.p3.m1" class="ltx_Math" alttext="\bar{\cdot}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>⋅</mo><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{\cdot}</annotation></semantics></math> denote the <span id="S1.SS3.p3.1.1" class="ltx_text ltx_font_italic">bit-wise complementation</span> morphism defined by <math id="S1.SS3.p3.m2" class="ltx_Math" alttext="\bar{a}=1-a" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>a</mi><mo>¯</mo></mover><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mi>a</mi></mrow></mrow><annotation encoding="application/x-tex">\bar{a}=1-a</annotation></semantics></math> for <math id="S1.SS3.p3.m3" class="ltx_Math" alttext="a\in\{{\tt 0},{\tt 1}\}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>𝟶</mn><mo>,</mo><mn>𝟷</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">a\in\{{\tt 0},{\tt 1}\}</annotation></semantics></math>.
Note that the set</p>
<table id="S1.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.Ex17.m1" class="ltx_Math" alttext="\{\mathbf{x}=(x_{n})_{n\geq 0}\in\{{\tt 0},{\tt 1}\}^{\mathbb{N}}\mid x_{3n}=x_{3n+1}=x_{2n}\text{ and }x_{3n+2}=1-x_{2n+1}\text{ for all $n\geq 0$}\}" display="block" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mi>𝐱</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></msub><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mn>𝟶</mn><mo>,</mo><mn>𝟷</mn><mo stretchy="false">}</mo></mrow><mi>ℕ</mi></msup></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>x</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo>=</mo><msub><mi>x</mi><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><msub><mi>x</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mtext> and </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>2</mn></mrow></msub></mrow><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>x</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mtext> for all </mtext><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></mrow></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\mathbf{x}=(x_{n})_{n\geq 0}\in\{{\tt 0},{\tt 1}\}^{\mathbb{N}}\mid x_{3n}=x_{3n+1}=x_{2n}\text{ and }x_{3n+2}=1-x_{2n+1}\text{ for all $n\geq 0$}\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.SS3.p3.2" class="ltx_p">contains exactly the two sequences <math id="S1.SS3.p3.m4" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> and <math id="S1.SS3.p3.m5" class="ltx_Math" alttext="\overline{\mathbf{t}_{3/2}}" display="inline" intent=":literal"><semantics><mover accent="true"><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{\mathbf{t}_{3/2}}</annotation></semantics></math> because a sequence in the set is completely determined by its first element.</p>
</div>
</section>
<section id="S1.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">1.4 </span>Dekking’s variation</h3>

<div id="S1.SS4.p1" class="ltx_para">
<p id="S1.SS4.p1.1" class="ltx_p">Dekking <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib12" title="" class="ltx_ref">19</a>]</cite> proposes to use an alternative to the base-<math id="S1.SS4.p1.m1" class="ltx_Math" alttext="3/2" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">3/2</annotation></semantics></math> numeration system where a natural number <math id="S1.SS4.p1.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> is written instead as</p>
<table id="S1.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.Ex18.m1" class="ltx_Math" alttext="n=\sum_{i\geq 0}d_{i}\left(\frac{3}{2}\right)^{i}" display="block" intent=":literal"><semantics><mrow><mi>n</mi><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>≥</mo><mn>0</mn></mrow></munder><mrow><msub><mi>d</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><mn>3</mn><mn>2</mn></mfrac><mo>)</mo></mrow><mi>i</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">n=\sum_{i\geq 0}d_{i}\left(\frac{3}{2}\right)^{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.SS4.p1.2" class="ltx_p">with digits <math id="S1.SS4.p1.m3" class="ltx_Math" alttext="d_{i}\in\{0,1,2\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>2</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">d_{i}\in\{0,1,2\}</annotation></semantics></math>. Note that, unlike the numeration system considered in <a href="#S1.SS3" title="1.3 The base 3/2 and the corresponding Thue–Morse word ‣ 1 Introduction ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">1.3</span></a>, this expansion does not include the normalizing factor <math id="S1.SS4.p1.m4" class="ltx_Math" alttext="1/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">1/2</annotation></semantics></math> as in <a href="#S1.E3" title="In 1.3 The base 3/2 and the corresponding Thue–Morse word ‣ 1 Introduction ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">3</span></a>. In this case, the analogue <math id="S1.SS4.p1.m5" class="ltx_Math" alttext="\mathbf{t}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝐭</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathbf{t}^{\prime}</annotation></semantics></math> (<a href="https://oeis.org/A357448" title="" class="ltx_ref ltx_href ltx_underline">A357448</a>) of the Thue–Morse sequence, starting with</p>
<table id="S1.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.Ex19.m1" class="ltx_math_unparsed" alttext="\mathbf{t}^{\prime}={\tt 0100101011011010101011011}\cdots," display="block" intent=":literal"><semantics><mrow><mi>𝐭</mi><msup><mrow></mrow><mo>′</mo></msup><mo>=</mo><mn>𝟶𝟷𝟶𝟶𝟷𝟶𝟷𝟶𝟷𝟷𝟶𝟷𝟷𝟶𝟷𝟶𝟷𝟶𝟷𝟶𝟷𝟷𝟶𝟷𝟷</mn><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbf{t}^{\prime}={\tt 0100101011011010101011011}\cdots,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.SS4.p1.3" class="ltx_p">is the fixed point of the <math id="S1.SS4.p1.m6" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-block substitution
<math id="S1.SS4.p1.m7" class="ltx_Math" alttext="{\tt 00}\mapsto{\tt 010}" display="inline" intent=":literal"><semantics><mrow><mn>𝟶𝟶</mn><mo stretchy="false">↦</mo><mn>𝟶𝟷𝟶</mn></mrow><annotation encoding="application/x-tex">{\tt 00}\mapsto{\tt 010}</annotation></semantics></math>, <math id="S1.SS4.p1.m8" class="ltx_Math" alttext="{\tt 01}\mapsto{\tt 010}" display="inline" intent=":literal"><semantics><mrow><mn>𝟶𝟷</mn><mo stretchy="false">↦</mo><mn>𝟶𝟷𝟶</mn></mrow><annotation encoding="application/x-tex">{\tt 01}\mapsto{\tt 010}</annotation></semantics></math>, <math id="S1.SS4.p1.m9" class="ltx_Math" alttext="{\tt 10}\mapsto{\tt 101}" display="inline" intent=":literal"><semantics><mrow><mn>𝟷𝟶</mn><mo stretchy="false">↦</mo><mn>𝟷𝟶𝟷</mn></mrow><annotation encoding="application/x-tex">{\tt 10}\mapsto{\tt 101}</annotation></semantics></math>, and <math id="S1.SS4.p1.m10" class="ltx_Math" alttext="{\tt 11}\mapsto{\tt 101}" display="inline" intent=":literal"><semantics><mrow><mn>𝟷𝟷</mn><mo stretchy="false">↦</mo><mn>𝟷𝟶𝟷</mn></mrow><annotation encoding="application/x-tex">{\tt 11}\mapsto{\tt 101}</annotation></semantics></math>. The sequences <math id="S1.SS4.p1.m11" class="ltx_Math" alttext="\mathbf{t}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝐭</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathbf{t}^{\prime}</annotation></semantics></math> and <math id="S1.SS4.p1.m12" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> are closely related, as shown in the following lemma.</p>
</div>
<div id="Thmtheorem4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem4.2" class="ltx_text ltx_font_bold">Lemma 4</span></span><span id="Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem4.p1" class="ltx_para">
<p id="Thmtheorem4.p1.1" class="ltx_p"><span id="Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmtheorem4.p1.m1" class="ltx_Math" alttext="\varphi:{\tt 0}\mapsto{\tt 010}" display="inline" intent=":literal"><semantics><mrow><mi>φ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mn>𝟶</mn><mo stretchy="false">↦</mo><mn>𝟶𝟷𝟶</mn></mrow></mrow><annotation encoding="application/x-tex">\varphi:{\tt 0}\mapsto{\tt 010}</annotation></semantics></math> and <math id="Thmtheorem4.p1.m2" class="ltx_Math" alttext="{\tt 1}\mapsto{\tt 101}" display="inline" intent=":literal"><semantics><mrow><mn>𝟷</mn><mo stretchy="false">↦</mo><mn>𝟷𝟶𝟷</mn></mrow><annotation encoding="application/x-tex">{\tt 1}\mapsto{\tt 101}</annotation></semantics></math>. We have
<math id="Thmtheorem4.p1.m3" class="ltx_Math" alttext="\mathbf{t}^{\prime}=\varphi(\mathbf{t}_{3/2})" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐭</mi><mo>′</mo></msup><mo>=</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{t}^{\prime}=\varphi(\mathbf{t}_{3/2})</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S1.SS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S1.SS4.p2" class="ltx_para">
<p id="S1.SS4.p2.1" class="ltx_p"><span id="S1.SS4.p2.1.1" class="ltx_text">In the <math id="S1.SS4.p2.m1" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-block substitution generating <math id="S1.SS4.p2.m2" class="ltx_Math" alttext="\mathbf{t}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝐭</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathbf{t}^{\prime}</annotation></semantics></math>, the image of a block <math id="S1.SS4.p2.m3" class="ltx_Math" alttext="ab\in\{{\tt 0},{\tt 1}\}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mn>𝟶</mn><mo>,</mo><mn>𝟷</mn></mrow><mo stretchy="false">}</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">ab\in\{{\tt 0},{\tt 1}\}^{2}</annotation></semantics></math> depends only on its first letter <math id="S1.SS4.p2.m4" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math>, i.e., <math id="S1.SS4.p2.m5" class="ltx_Math" alttext="ab\mapsto a(1-a)a" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow><mo stretchy="false">↦</mo><mrow><mrow><mi>a</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></mrow><annotation encoding="application/x-tex">ab\mapsto a(1-a)a</annotation></semantics></math> with <math id="S1.SS4.p2.m6" class="ltx_Math" alttext="a,b\in\{{\tt 0},{\tt 1}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>𝟶</mn><mo>,</mo><mn>𝟷</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">a,b\in\{{\tt 0},{\tt 1}\}</annotation></semantics></math>. So <math id="S1.SS4.p2.m7" class="ltx_Math" alttext="\mathbf{t}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝐭</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathbf{t}^{\prime}</annotation></semantics></math> is also an alternated fixed point of</span></p>
<table id="S1.E7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(7)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.E7.m1" class="ltx_Math" alttext="g_{0}\colon\left\{\begin{array}[]{l}{\tt 0}\mapsto{\tt 010},\\
{\tt 1}\mapsto{\tt 101},\\
\end{array}\right.\text{ and }g_{1}\colon\left\{\begin{array}[]{l}{\tt 0}\mapsto\varepsilon,\\
{\tt 1}\mapsto\varepsilon.\\
\end{array}\right." display="block" intent=":literal"><semantics><mrow><msub><mi>g</mi><mn>0</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo>{</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>𝟶</mn><mo stretchy="false">↦</mo><mn>𝟶𝟷𝟶</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>𝟷</mn><mo stretchy="false">↦</mo><mn>𝟷𝟶𝟷</mn></mrow><mo>,</mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow><mo lspace="0em" rspace="0em">​</mo><mtext> and </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mn>1</mn></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo>{</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>𝟶</mn><mo stretchy="false">↦</mo><mi>ε</mi></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>𝟷</mn><mo stretchy="false">↦</mo><mi>ε</mi></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">g_{0}\colon\left\{\begin{array}[]{l}{\tt 0}\mapsto{\tt 010},\\
{\tt 1}\mapsto{\tt 101},\\
\end{array}\right.\text{ and }g_{1}\colon\left\{\begin{array}[]{l}{\tt 0}\mapsto\varepsilon,\\
{\tt 1}\mapsto\varepsilon.\\
\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.SS4.p2.2" class="ltx_p"><span id="S1.SS4.p2.2.1" class="ltx_text">Observe that <math id="S1.SS4.p2.m8" class="ltx_Math" alttext="\mathbf{t}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝐭</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathbf{t}^{\prime}</annotation></semantics></math> is also a fixed point of the alternate <math id="S1.SS4.p2.m9" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>-block substitution</span></p>
<table id="S1.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.Ex20.m1" class="ltx_Math" alttext="g_{0}^{\prime}\colon\left\{\begin{array}[]{l}{\tt 010}\mapsto g_{0}({\tt 0})g_{1}({\tt 1})g_{0}({\tt 0})={\tt 010}{\tt 010},\\
{\tt 101}\mapsto g_{0}({\tt 1})g_{1}({\tt 0})g_{0}({\tt 1})={\tt 101}{\tt 101},\\
\end{array}\right.\text{ and }g_{1}^{\prime}\colon\left\{\begin{array}[]{l}{\tt 010}\mapsto g_{1}({\tt 0})g_{0}({\tt 1})g_{1}({\tt 0})={\tt 101},\\
{\tt 101}\mapsto g_{1}({\tt 1})g_{0}({\tt 0})g_{1}({\tt 1})={\tt 010}.\\
\end{array}\right." display="block" intent=":literal"><semantics><mrow><msubsup><mi>g</mi><mn>0</mn><mo>′</mo></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo>{</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>𝟶𝟷𝟶</mn><mo stretchy="false">↦</mo><mrow><msub><mi>g</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟶</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟷</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟶</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>𝟶𝟷𝟶𝟶𝟷𝟶</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>𝟷𝟶𝟷</mn><mo stretchy="false">↦</mo><mrow><msub><mi>g</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟷</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟶</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟷</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>𝟷𝟶𝟷𝟷𝟶𝟷</mn></mrow><mo>,</mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow><mo lspace="0em" rspace="0em">​</mo><mtext> and </mtext><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>g</mi><mn>1</mn><mo>′</mo></msubsup></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo>{</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>𝟶𝟷𝟶</mn><mo stretchy="false">↦</mo><mrow><msub><mi>g</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟶</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟷</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟶</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>𝟷𝟶𝟷</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>𝟷𝟶𝟷</mn><mo stretchy="false">↦</mo><mrow><msub><mi>g</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟷</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟶</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>𝟷</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>𝟶𝟷𝟶</mn></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">g_{0}^{\prime}\colon\left\{\begin{array}[]{l}{\tt 010}\mapsto g_{0}({\tt 0})g_{1}({\tt 1})g_{0}({\tt 0})={\tt 010}{\tt 010},\\
{\tt 101}\mapsto g_{0}({\tt 1})g_{1}({\tt 0})g_{0}({\tt 1})={\tt 101}{\tt 101},\\
\end{array}\right.\text{ and }g_{1}^{\prime}\colon\left\{\begin{array}[]{l}{\tt 010}\mapsto g_{1}({\tt 0})g_{0}({\tt 1})g_{1}({\tt 0})={\tt 101},\\
{\tt 101}\mapsto g_{1}({\tt 1})g_{0}({\tt 0})g_{1}({\tt 1})={\tt 010}.\\
\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.SS4.p2.3" class="ltx_p"><span id="S1.SS4.p2.3.1" class="ltx_text">If we identify through <math id="S1.SS4.p2.m10" class="ltx_Math" alttext="\varphi" display="inline" intent=":literal"><semantics><mi>φ</mi><annotation encoding="application/x-tex">\varphi</annotation></semantics></math> blocks <math id="S1.SS4.p2.m11" class="ltx_Math" alttext="{\tt 010}" display="inline" intent=":literal"><semantics><mn>𝟶𝟷𝟶</mn><annotation encoding="application/x-tex">{\tt 010}</annotation></semantics></math> and <math id="S1.SS4.p2.m12" class="ltx_Math" alttext="{\tt 101}" display="inline" intent=":literal"><semantics><mn>𝟷𝟶𝟷</mn><annotation encoding="application/x-tex">{\tt 101}</annotation></semantics></math> with <math id="S1.SS4.p2.m13" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> and <math id="S1.SS4.p2.m14" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math> respectively, we have</span></p>
<table id="S1.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.Ex21.m1" class="ltx_Math" alttext="g_{0}^{\prime}\colon\left\{\begin{array}[]{l}a\mapsto aa,\\
b\mapsto bb,\\
\end{array}\right.\text{ and }g_{1}^{\prime}\colon\left\{\begin{array}[]{l}a\mapsto b,\\
b\mapsto a.\\
\end{array}\right." display="block" intent=":literal"><semantics><mrow><msubsup><mi>g</mi><mn>0</mn><mo>′</mo></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo>{</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>a</mi><mo stretchy="false">↦</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>b</mi><mo stretchy="false">↦</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></mrow><mo>,</mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow><mo lspace="0em" rspace="0em">​</mo><mtext> and </mtext><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>g</mi><mn>1</mn><mo>′</mo></msubsup></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo>{</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>a</mi><mo stretchy="false">↦</mo><mi>b</mi></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>b</mi><mo stretchy="false">↦</mo><mi>a</mi></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">g_{0}^{\prime}\colon\left\{\begin{array}[]{l}a\mapsto aa,\\
b\mapsto bb,\\
\end{array}\right.\text{ and }g_{1}^{\prime}\colon\left\{\begin{array}[]{l}a\mapsto b,\\
b\mapsto a.\\
\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.SS4.p2.4" class="ltx_p"><span id="S1.SS4.p2.4.1" class="ltx_text">We know from (<a href="#S1.E4" title="Equation 4 ‣ Definition 3 (Our sequence of interest). ‣ 1.3 The base 3/2 and the corresponding Thue–Morse word ‣ 1 Introduction ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>) that <math id="S1.SS4.p2.m15" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> is an alternated fixed point of <math id="S1.SS4.p2.m16" class="ltx_Math" alttext="(g_{0}^{\prime},g_{1}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msubsup><mi>g</mi><mn>0</mn><mo>′</mo></msubsup><mo>,</mo><msubsup><mi>g</mi><mn>1</mn><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(g_{0}^{\prime},g_{1}^{\prime})</annotation></semantics></math> over <math id="S1.SS4.p2.m17" class="ltx_Math" alttext="\{a,b\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{a,b\}</annotation></semantics></math>. Hence the conclusion follows: <math id="S1.SS4.p2.m18" class="ltx_Math" alttext="\mathbf{t}^{\prime}=\varphi(\mathbf{t}_{3/2})" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐭</mi><mo>′</mo></msup><mo>=</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{t}^{\prime}=\varphi(\mathbf{t}_{3/2})</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S1.SS4.p3" class="ltx_para">
<p id="S1.SS4.p3.1" class="ltx_p">As for the Oldenburger–Kolakoski sequence <math id="S1.SS4.p3.m1" class="ltx_Math" alttext="\mathbf{k}" display="inline" intent=":literal"><semantics><mi>𝐤</mi><annotation encoding="application/x-tex">\mathbf{k}</annotation></semantics></math>, Dekking raises a series of conjectures about <math id="S1.SS4.p3.m2" class="ltx_Math" alttext="\mathbf{t}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝐭</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathbf{t}^{\prime}</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib12" title="" class="ltx_ref">19</a>]</cite>.</p>
<ol id="S1.I2" class="ltx_enumerate">
<li id="S1.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><math id="S1.I2.i1.m1" class="ltx_Math" alttext="(C_{1})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(C_{1})</annotation></semantics></math></span> 
<div id="S1.I2.i1.p1" class="ltx_para">
<p id="S1.I2.i1.p1.1" class="ltx_p">It is unknown whether <math id="S1.I2.i1.p1.m1" class="ltx_Math" alttext="\mathbf{t}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝐭</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathbf{t}^{\prime}</annotation></semantics></math> is uniformly recurrent.</p>
</div></li>
<li id="S1.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><math id="S1.I2.i2.m1" class="ltx_Math" alttext="(C_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(C_{2})</annotation></semantics></math></span> 
<div id="S1.I2.i2.p1" class="ltx_para">
<p id="S1.I2.i2.p1.1" class="ltx_p">It is open whether the set of factors of <math id="S1.I2.i2.p1.m1" class="ltx_Math" alttext="\mathbf{t}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝐭</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathbf{t}^{\prime}</annotation></semantics></math> is closed under bit-wise complement.</p>
</div></li>
<li id="S1.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><math id="S1.I2.i3.m1" class="ltx_Math" alttext="(C_{3})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(C_{3})</annotation></semantics></math></span> 
<div id="S1.I2.i3.p1" class="ltx_para">
<p id="S1.I2.i3.p1.1" class="ltx_p">It is open whether the set of factors of <math id="S1.I2.i3.p1.m1" class="ltx_Math" alttext="\mathbf{t}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝐭</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathbf{t}^{\prime}</annotation></semantics></math> is closed under reversal.</p>
</div></li>
<li id="S1.I2.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><math id="S1.I2.i4.m1" class="ltx_Math" alttext="(C_{4})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mn>4</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(C_{4})</annotation></semantics></math></span> 
<div id="S1.I2.i4.p1" class="ltx_para">
<p id="S1.I2.i4.p1.1" class="ltx_p">It is conjectured that frequencies of the words <math id="S1.I2.i4.p1.m1" class="ltx_Math" alttext="w\in\{{\tt 0},{\tt 1}\}^{*}" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mn>𝟶</mn><mo>,</mo><mn>𝟷</mn></mrow><mo stretchy="false">}</mo></mrow><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">w\in\{{\tt 0},{\tt 1}\}^{*}</annotation></semantics></math> occurring in <math id="S1.I2.i4.p1.m2" class="ltx_Math" alttext="\mathbf{t}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝐭</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathbf{t}^{\prime}</annotation></semantics></math> exist. It is also conjectured that <math id="S1.I2.i4.p1.m3" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> and its reversal have the same frequency.</p>
</div></li>
</ol>
<p id="S1.SS4.p3.2" class="ltx_p">Similar questions can also be asked for <math id="S1.SS4.p3.m3" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math>.</p>
</div>
</section>
<section id="S1.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">1.5 </span>Organization of the paper and our contributions</h3>

<div id="S1.SS5.p1" class="ltx_para">
<p id="S1.SS5.p1.1" class="ltx_p">The first part of the article is purely combinatorial. In <a href="#S2" title="2 Combinatorial properties of 𝐭_{3/2} and 𝐭^′ ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">2</span></a>, we answer the following conjectures asked by Dekking.</p>
<ul id="S1.I3" class="ltx_itemize">
<li id="S1.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S1.I3.i1.p1" class="ltx_para">
<p id="S1.I3.i1.p1.1" class="ltx_p">We prove with <a href="#Thmtheorem13" title="Corollary 13. ‣ Uniform recurrence. ‣ 2.2 From the sequence Δ(𝐭_{3/2}) back to the original sequence 𝐭_{3/2} ‣ 2 Combinatorial properties of 𝐭_{3/2} and 𝐭^′ ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Corollary</span> <span class="ltx_text ltx_ref_tag">13</span></a> that both sequences <math id="S1.I3.i1.p1.m1" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> and <math id="S1.I3.i1.p1.m2" class="ltx_Math" alttext="\mathbf{t}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝐭</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathbf{t}^{\prime}</annotation></semantics></math> are uniformly recurrent, answering <math id="S1.I3.i1.p1.m3" class="ltx_Math" alttext="(C_{1})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(C_{1})</annotation></semantics></math> positively.</p>
</div></li>
<li id="S1.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S1.I3.i2.p1" class="ltx_para">
<p id="S1.I3.i2.p1.1" class="ltx_p">We prove with <a href="#Thmtheorem15" title="Proposition 15. ‣ Bit-wise complement. ‣ 2.2 From the sequence Δ(𝐭_{3/2}) back to the original sequence 𝐭_{3/2} ‣ 2 Combinatorial properties of 𝐭_{3/2} and 𝐭^′ ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">15</span></a> that the sets of factors of <math id="S1.I3.i2.p1.m1" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> and <math id="S1.I3.i2.p1.m2" class="ltx_Math" alttext="\mathbf{t}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝐭</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathbf{t}^{\prime}</annotation></semantics></math> are closed under bit-wise complement, answering <math id="S1.I3.i2.p1.m3" class="ltx_Math" alttext="(C_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(C_{2})</annotation></semantics></math> positively.</p>
</div></li>
<li id="S1.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S1.I3.i3.p1" class="ltx_para">
<p id="S1.I3.i3.p1.1" class="ltx_p">We prove with <a href="#Thmtheorem17" title="Proposition 17. ‣ Reversal. ‣ 2.2 From the sequence Δ(𝐭_{3/2}) back to the original sequence 𝐭_{3/2} ‣ 2 Combinatorial properties of 𝐭_{3/2} and 𝐭^′ ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">17</span></a> that the sets of factors of <math id="S1.I3.i3.p1.m1" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> and <math id="S1.I3.i3.p1.m2" class="ltx_Math" alttext="\mathbf{t}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝐭</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathbf{t}^{\prime}</annotation></semantics></math> are closed under reversal, answering <math id="S1.I3.i3.p1.m3" class="ltx_Math" alttext="(C_{3})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(C_{3})</annotation></semantics></math> positively.</p>
</div></li>
</ul>
<p id="S1.SS5.p1.2" class="ltx_p">The strategy consists in proving that the first difference sequence of <math id="S1.SS5.p1.m1" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> is a Toeplitz word (this is <a href="#Thmtheorem11" title="Proposition 11. ‣ 2.1 On the sequence of first differences ‣ 2 Combinatorial properties of 𝐭_{3/2} and 𝐭^′ ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">11</span></a>) and thus uniformly recurrent (using <a href="#Thmtheorem8" title="Proposition 8 ([, Sec. 2]). ‣ 2.1 On the sequence of first differences ‣ 2 Combinatorial properties of 𝐭_{3/2} and 𝐭^′ ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">8</span></a>). Passing to the sequence of differences results in a loss of information about the original sequence, which can only be reconstructed up to complementation. It is therefore crucial to prove stability under the bit-wise complement. Results for <math id="S1.SS5.p1.m2" class="ltx_Math" alttext="\mathbf{t}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝐭</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathbf{t}^{\prime}</annotation></semantics></math> are deduced from those on <math id="S1.SS5.p1.m3" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> thanks to <a href="#Thmtheorem4" title="Lemma 4. ‣ 1.4 Dekking’s variation ‣ 1 Introduction ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">4</span></a>.</p>
</div>
<div id="S1.SS5.p2" class="ltx_para">
<p id="S1.SS5.p2.1" class="ltx_p">The second part of the article is analytic. In <a href="#S3" title="3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">3</span></a>, we prove our main result with <a href="#Thmtheorem18" title="Theorem 18. ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">18</span></a>: frequencies of <span id="S1.SS5.p2.1.1" class="ltx_text ltx_font_typewriter">0</span> and <span id="S1.SS5.p2.1.2" class="ltx_text ltx_font_typewriter">1</span> exist in <math id="S1.SS5.p2.m1" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> and equal <math id="S1.SS5.p2.m2" class="ltx_Math" alttext="1/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">1/2</annotation></semantics></math>. In particular, this also answers <math id="S1.SS5.p2.m3" class="ltx_Math" alttext="(C_{4})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mn>4</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(C_{4})</annotation></semantics></math> for symbols. The proof establishes the existence and exact value of “filtered” frequencies (along positions congruent to <math id="S1.SS5.p2.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> modulo <math id="S1.SS5.p2.m5" class="ltx_Math" alttext="2^{n}" display="inline" intent=":literal"><semantics><msup><mn>2</mn><mi>n</mi></msup><annotation encoding="application/x-tex">2^{n}</annotation></semantics></math>) in <math id="S1.SS5.p2.m6" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> by combining desubstitution with harmonic analysis on the <math id="S1.SS5.p2.m7" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-adic integers.
The argument is divided into several steps as follows.</p>
</div>
<div id="S1.SS5.p3" class="ltx_para">
<ul id="S1.I4" class="ltx_itemize">
<li id="S1.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S1.I4.i1.p1" class="ltx_para">
<p id="S1.I4.i1.p1.1" class="ltx_p">First, we argue by contradiction: assuming a deviation from the expected frequency <math id="S1.I4.i1.p1.m1" class="ltx_Math" alttext="2^{-n-1}" display="inline" intent=":literal"><semantics><msup><mn>2</mn><mrow><mrow><mo>−</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">2^{-n-1}</annotation></semantics></math>, <a href="#Thmtheorem19" title="Lemma 19. ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">19</span></a> uses a compactness and diagonal extraction argument (via Bolzano–Weierstrass) to construct limiting densities <math id="S1.I4.i1.p1.m2" class="ltx_Math" alttext="\mu_{n}(c,k)" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu_{n}(c,k)</annotation></semantics></math> along a subsequence and allows us to derive recurrence relations coming from the desubstitution of <math id="S1.I4.i1.p1.m3" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math>.</p>
</div></li>
<li id="S1.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S1.I4.i2.p1" class="ltx_para">
<p id="S1.I4.i2.p1.1" class="ltx_p">Then, <a href="#Thmtheorem20" title="Proposition 20. ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">20</span></a> shows that any family of densities <math id="S1.I4.i2.p1.m1" class="ltx_Math" alttext="\mu_{n}(c,k)" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu_{n}(c,k)</annotation></semantics></math> satisfying periodicity, normalization, and these recurrences must equal <math id="S1.I4.i2.p1.m2" class="ltx_Math" alttext="2^{-n-1}" display="inline" intent=":literal"><semantics><msup><mn>2</mn><mrow><mrow><mo>−</mo><mi>n</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">2^{-n-1}</annotation></semantics></math>. To prove this rigidity, the problem is lifted to the <math id="S1.I4.i2.p1.m3" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-adic integers <math id="S1.I4.i2.p1.m4" class="ltx_Math" alttext="\mathbb{Z}_{2}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\mathbb{Z}_{2}</annotation></semantics></math>, where differences are studied as functions in <math id="S1.I4.i2.p1.m5" class="ltx_Math" alttext="L^{2}(\mathbb{Z}_{2})" display="inline" intent=":literal"><semantics><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ℤ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L^{2}(\mathbb{Z}_{2})</annotation></semantics></math>. Using Pontryagin duality and Fourier expansion over the dyadic rationals, the recurrence is reformulated as a linear operator <math id="S1.I4.i2.p1.m6" class="ltx_Math" alttext="\Lop" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\Lop</annotation></semantics></math> acting on Fourier coefficients. A spectral contraction estimate — namely <math id="S1.I4.i2.p1.m7" class="ltx_Math" alttext="\|\zeta_{2}\|_{\infty}&lt;1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>ζ</mi><mn>2</mn></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|\zeta_{2}\|_{\infty}&lt;1</annotation></semantics></math>, proved in <a href="#S3.SS3" title="3.3 Proving that ‖𝜁_2‖_∞&lt;1 ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">3.3</span></a> — is obtained through explicit computation of the associated multipliers, implying that repeated application of
<math id="S1.I4.i2.p1.m8" class="ltx_Math" alttext="\Lop" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\Lop</annotation></semantics></math> forces the differences to vanish. This yields uniqueness of the solution and the result.</p>
</div></li>
</ul>
</div>
<div id="S1.SS5.p4" class="ltx_para">
<p id="S1.SS5.p4.1" class="ltx_p">To the best of our knowledge, this is the first time that <math id="S1.SS5.p4.m1" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-adic harmonic analysis is used to prove frequency existence for a rational-base Thue–Morse-type sequence.</p>
</div>
<div id="S1.SS5.p5" class="ltx_para">
<p id="S1.SS5.p5.1" class="ltx_p">We finish the paper with <a href="#S4" title="4 Concluding remarks ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">4</span></a> where we expose several paths of future research.</p>
</div>
</section>
</section>
<section id="S2" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">2 </span>Combinatorial properties of <math id="S2.m1" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> and <math id="S2.m2" class="ltx_Math" alttext="\mathbf{t}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝐭</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathbf{t}^{\prime}</annotation></semantics></math></h2>

<div id="S2.p1" class="ltx_para">
<p id="S2.p1.1" class="ltx_p">In this section, we establish combinatorial properties of the sequences <math id="S2.p1.m1" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> and <math id="S2.p1.m2" class="ltx_Math" alttext="\mathbf{t}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝐭</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathbf{t}^{\prime}</annotation></semantics></math>.
In particular, we show that both are uniformly recurrent, and that their sets of factors are closed under bit-wise complement and reversal.
The strategy is to analyze the sequence of first differences of <math id="S2.p1.m3" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math>, which shows a particular structure from which we derive the combinatorial properties of the original sequence.</p>
</div>
<section id="S2.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">2.1 </span>On the sequence of first differences</h3>

<div id="S2.SS1.p1" class="ltx_para">
<p id="S2.SS1.p1.1" class="ltx_p">Let <math id="S2.SS1.p1.m1" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math> be the first difference operator defined by <math id="S2.SS1.p1.m2" class="ltx_Math" alttext="\Delta((x_{n})_{n\geq 0})=(x_{n+1}-x_{n}\bmod{2})_{n\geq 0}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>x</mi><mi>n</mi></msub></mrow><mo>mod</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\Delta((x_{n})_{n\geq 0})=(x_{n+1}-x_{n}\bmod{2})_{n\geq 0}</annotation></semantics></math> (note that the minus sign can be replaced by a plus sign).
The first difference sequence <math id="S2.SS1.p1.m3" class="ltx_Math" alttext="\Delta(\mathbf{t}_{3/2})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta(\mathbf{t}_{3/2})</annotation></semantics></math> of <math id="S2.SS1.p1.m4" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> starts with</p>
<table id="S2.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex22.m1" class="ltx_math_unparsed" alttext="\Delta(\mathbf{t}_{3/2})={\tt 010011000011011000010001011010}\cdots." display="block" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mn>𝟶𝟷𝟶𝟶𝟷𝟷𝟶𝟶𝟶𝟶𝟷𝟷𝟶𝟷𝟷𝟶𝟶𝟶𝟶𝟷𝟶𝟶𝟶𝟷𝟶𝟷𝟷𝟶𝟷𝟶</mn><mo lspace="0em" rspace="0em">⋯</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Delta(\mathbf{t}_{3/2})={\tt 010011000011011000010001011010}\cdots.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS1.p1.2" class="ltx_p">It turns out that <math id="S2.SS1.p1.m5" class="ltx_Math" alttext="\Delta(\mathbf{t}_{3/2})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta(\mathbf{t}_{3/2})</annotation></semantics></math> is simpler to analyze, as we now show that it is a Toeplitz word.</p>
</div>
<div id="Thmtheorem5" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem5.2" class="ltx_text ltx_font_bold">Definition 5</span></span><span id="Thmtheorem5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem5.p1" class="ltx_para">
<p id="Thmtheorem5.p1.1" class="ltx_p">For a finite word <math id="Thmtheorem5.p1.m1" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math>, we let <math id="Thmtheorem5.p1.m2" class="ltx_Math" alttext="u^{\omega}" display="inline" intent=":literal"><semantics><msup><mi>u</mi><mi>ω</mi></msup><annotation encoding="application/x-tex">u^{\omega}</annotation></semantics></math> denote the infinite word obtained by concatenating infinitely many copies of <math id="Thmtheorem5.p1.m3" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math>.
Fix an alphabet <math id="Thmtheorem5.p1.m4" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> and let <math id="Thmtheorem5.p1.m5" class="ltx_Math" alttext="\mathord{?}" display="inline" intent=":literal"><semantics><mi>?</mi><annotation encoding="application/x-tex">\mathord{?}</annotation></semantics></math> be a symbol not belonging to <math id="Thmtheorem5.p1.m6" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>.
For a word <math id="Thmtheorem5.p1.m7" class="ltx_Math" alttext="w\in A(A\cup\{\mathord{?}\})^{*}" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>∈</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>?</mi><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup></mrow></mrow><annotation encoding="application/x-tex">w\in A(A\cup\{\mathord{?}\})^{*}</annotation></semantics></math>, we define a converging sequence <math id="Thmtheorem5.p1.m8" class="ltx_Math" alttext="(\mathcal{T}_{i}(w))_{i\geq 0}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>≥</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">(\mathcal{T}_{i}(w))_{i\geq 0}</annotation></semantics></math> of infinite words in an iterative way. We let <math id="Thmtheorem5.p1.m9" class="ltx_Math" alttext="\mathcal{T}_{0}(w):=\mathord{?}^{\omega}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><msup><mi>?</mi><mi>ω</mi></msup></mrow><annotation encoding="application/x-tex">\mathcal{T}_{0}(w):=\mathord{?}^{\omega}</annotation></semantics></math> and, for each <math id="Thmtheorem5.p1.m10" class="ltx_Math" alttext="i\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">i\geq 0</annotation></semantics></math>, we set <math id="Thmtheorem5.p1.m11" class="ltx_Math" alttext="\mathcal{T}_{i+1}(w):=F_{w}(\mathcal{T}_{i}(w))" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><msub><mi>F</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}_{i+1}(w):=F_{w}(\mathcal{T}_{i}(w))</annotation></semantics></math>, where, for any infinite word <math id="Thmtheorem5.p1.m12" class="ltx_Math" alttext="\mathbf{u}\in(A\cup\{\mathord{?}\})^{\mathbb{N}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐮</mi><mo>∈</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>?</mi><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>ℕ</mi></msup></mrow><annotation encoding="application/x-tex">\mathbf{u}\in(A\cup\{\mathord{?}\})^{\mathbb{N}}</annotation></semantics></math>, we let <math id="Thmtheorem5.p1.m13" class="ltx_Math" alttext="F_{w}(\mathbf{u})" display="inline" intent=":literal"><semantics><mrow><msub><mi>F</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐮</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F_{w}(\mathbf{u})</annotation></semantics></math> denote the word obtained from <math id="Thmtheorem5.p1.m14" class="ltx_Math" alttext="\mathbf{u}" display="inline" intent=":literal"><semantics><mi>𝐮</mi><annotation encoding="application/x-tex">\mathbf{u}</annotation></semantics></math> by replacing all occurrences of <math id="Thmtheorem5.p1.m15" class="ltx_Math" alttext="\mathord{?}" display="inline" intent=":literal"><semantics><mi>?</mi><annotation encoding="application/x-tex">\mathord{?}</annotation></semantics></math> by <math id="Thmtheorem5.p1.m16" class="ltx_Math" alttext="w^{\omega}" display="inline" intent=":literal"><semantics><msup><mi>w</mi><mi>ω</mi></msup><annotation encoding="application/x-tex">w^{\omega}</annotation></semantics></math>.
In particular, <math id="Thmtheorem5.p1.m17" class="ltx_Math" alttext="F_{w}(\mathbf{u})=\mathbf{u}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>F</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐮</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>𝐮</mi></mrow><annotation encoding="application/x-tex">F_{w}(\mathbf{u})=\mathbf{u}</annotation></semantics></math>, if <math id="Thmtheorem5.p1.m18" class="ltx_Math" alttext="\mathbf{u}" display="inline" intent=":literal"><semantics><mi>𝐮</mi><annotation encoding="application/x-tex">\mathbf{u}</annotation></semantics></math> contains no occurrence of <math id="Thmtheorem5.p1.m19" class="ltx_Math" alttext="\mathord{?}" display="inline" intent=":literal"><semantics><mi>?</mi><annotation encoding="application/x-tex">\mathord{?}</annotation></semantics></math>.
The limit</p>
<table id="S2.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex23.m1" class="ltx_Math" alttext="\mathcal{T}(w)=\lim_{i\to\infty}\mathcal{T}_{i}(w)\in A^{\mathbb{N}}" display="block" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">=</mo><mrow><munder><mo lspace="0.1389em" movablelimits="false" rspace="0.167em">lim</mo><mrow><mi>i</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>∈</mo><msup><mi>A</mi><mi>ℕ</mi></msup></mrow><annotation encoding="application/x-tex">\mathcal{T}(w)=\lim_{i\to\infty}\mathcal{T}_{i}(w)\in A^{\mathbb{N}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem5.p1.2" class="ltx_p">is well-defined (because the first letter of <math id="Thmtheorem5.p1.m20" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> is not the symbol <math id="Thmtheorem5.p1.m21" class="ltx_Math" alttext="\mathord{?}" display="inline" intent=":literal"><semantics><mi>?</mi><annotation encoding="application/x-tex">\mathord{?}</annotation></semantics></math>) and is referred to as the <em id="Thmtheorem5.p1.2.1" class="ltx_emph ltx_font_italic">Toeplitz word determined by the pattern <math id="Thmtheorem5.p1.m22" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math></em>.
Let <math id="Thmtheorem5.p1.m23" class="ltx_Math" alttext="p=|w|" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mrow><mo stretchy="false">|</mo><mi>w</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">p=|w|</annotation></semantics></math> and <math id="Thmtheorem5.p1.m24" class="ltx_Math" alttext="q=|w|_{\mathord{?}}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><msub><mrow><mo stretchy="false">|</mo><mi>w</mi><mo stretchy="false">|</mo></mrow><mi>?</mi></msub></mrow><annotation encoding="application/x-tex">q=|w|_{\mathord{?}}</annotation></semantics></math> be the length of <math id="Thmtheorem5.p1.m25" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> and the number of <math id="Thmtheorem5.p1.m26" class="ltx_Math" alttext="\mathord{?}" display="inline" intent=":literal"><semantics><mi>?</mi><annotation encoding="application/x-tex">\mathord{?}</annotation></semantics></math>’s in <math id="Thmtheorem5.p1.m27" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math>, respectively.
We call <math id="Thmtheorem5.p1.m28" class="ltx_Math" alttext="\mathcal{T}(w)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}(w)</annotation></semantics></math> a <em id="Thmtheorem5.p1.2.2" class="ltx_emph ltx_font_italic"><math id="Thmtheorem5.p1.m29" class="ltx_Math" alttext="(p,q)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(p,q)</annotation></semantics></math>-Toeplitz word</em>.</p>
</div>
</div>
<div id="Thmtheorem6" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem6.2" class="ltx_text ltx_font_bold">Example 6</span></span><span id="Thmtheorem6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem6.p1" class="ltx_para">
<p id="Thmtheorem6.p1.1" class="ltx_p">The paper-folding word is the Toeplitz word determined by the pattern <math id="Thmtheorem6.p1.m1" class="ltx_Math" alttext="{\tt 1}\mathord{?}{\tt 0}\mathord{?}" display="inline" intent=":literal"><semantics><mrow><mn>𝟷</mn><mo lspace="0em" rspace="0em">​</mo><mi>?</mi><mo lspace="0em" rspace="0em">​</mo><mn>𝟶</mn><mo lspace="0em" rspace="0em">​</mo><mi>?</mi></mrow><annotation encoding="application/x-tex">{\tt 1}\mathord{?}{\tt 0}\mathord{?}</annotation></semantics></math>; see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib41" title="" class="ltx_ref">4</a>]</cite>.</p>
</div>
</div>
<div id="S2.SS1.p2" class="ltx_para">
<p id="S2.SS1.p2.1" class="ltx_p">We recall some results about Toeplitz words <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib40" title="" class="ltx_ref">14</a>]</cite>.</p>
</div>
<div id="Thmtheorem7" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem7.2" class="ltx_text ltx_font_bold">Theorem 7</span></span><span id="Thmtheorem7.3" class="ltx_text ltx_font_bold"> </span>(<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib40" title="" class="ltx_ref">14</a>]</cite>)<span id="Thmtheorem7.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem7.p1" class="ltx_para">
<p id="Thmtheorem7.p1.1" class="ltx_p"><span id="Thmtheorem7.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmtheorem7.p1.m1" class="ltx_Math" alttext="\mathbf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\mathbf{x}</annotation></semantics></math> be a <math id="Thmtheorem7.p1.m2" class="ltx_Math" alttext="(p,q)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(p,q)</annotation></semantics></math>-Toeplitz word and define <math id="Thmtheorem7.p1.m3" class="ltx_Math" alttext="d=\gcd(p,q)" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mrow><mi>gcd</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">d=\gcd(p,q)</annotation></semantics></math>, <math id="Thmtheorem7.p1.m4" class="ltx_Math" alttext="p^{\prime}=p/d" display="inline" intent=":literal"><semantics><mrow><msup><mi>p</mi><mo>′</mo></msup><mo>=</mo><mrow><mi>p</mi><mo>/</mo><mi>d</mi></mrow></mrow><annotation encoding="application/x-tex">p^{\prime}=p/d</annotation></semantics></math>, and <math id="Thmtheorem7.p1.m5" class="ltx_Math" alttext="q^{\prime}=q/d" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mo>′</mo></msup><mo>=</mo><mrow><mi>q</mi><mo>/</mo><mi>d</mi></mrow></mrow><annotation encoding="application/x-tex">q^{\prime}=q/d</annotation></semantics></math>.
The factor complexity <math id="Thmtheorem7.p1.m6" class="ltx_Math" alttext="\mathsf{p}_{\mathbf{x}}" display="inline" intent=":literal"><semantics><msub><mi>𝗉</mi><mi>𝐱</mi></msub><annotation encoding="application/x-tex">\mathsf{p}_{\mathbf{x}}</annotation></semantics></math> of <math id="Thmtheorem7.p1.m7" class="ltx_Math" alttext="\mathbf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\mathbf{x}</annotation></semantics></math> satisfies <math id="Thmtheorem7.p1.m8" class="ltx_Math" alttext="\mathsf{p}_{\mathbf{x}}(n)=\Theta(n^{r})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝗉</mi><mi>𝐱</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>n</mi><mi>r</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathsf{p}_{\mathbf{x}}(n)=\Theta(n^{r})</annotation></semantics></math> with <math id="Thmtheorem7.p1.m9" class="ltx_Math" alttext="r=\frac{\log p^{\prime}}{\log(p^{\prime}/q^{\prime})}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>p</mi><mo>′</mo></msup><mo>/</mo><msup><mi>q</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">r=\frac{\log p^{\prime}}{\log(p^{\prime}/q^{\prime})}</annotation></semantics></math>, i.e., there exist two positive constants <math id="Thmtheorem7.p1.m10" class="ltx_Math" alttext="C_{1}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mn>1</mn></msub><annotation encoding="application/x-tex">C_{1}</annotation></semantics></math> and <math id="Thmtheorem7.p1.m11" class="ltx_Math" alttext="C_{2}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mn>2</mn></msub><annotation encoding="application/x-tex">C_{2}</annotation></semantics></math> such that <math id="Thmtheorem7.p1.m12" class="ltx_Math" alttext="C_{1}\,n^{r}\leq\mathsf{p}_{\mathbf{x}}(n)\leq C_{2}\,n^{r}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mn>1</mn></msub><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>n</mi><mi>r</mi></msup></mrow><mo>≤</mo><mrow><msub><mi>𝗉</mi><mi>𝐱</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msub><mi>C</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mi>r</mi></msup></mrow></mrow><annotation encoding="application/x-tex">C_{1}\,n^{r}\leq\mathsf{p}_{\mathbf{x}}(n)\leq C_{2}\,n^{r}</annotation></semantics></math> for all <math id="Thmtheorem7.p1.m13" class="ltx_Math" alttext="n\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n\geq 0</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="Thmtheorem8" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem8.2" class="ltx_text ltx_font_bold">Proposition 8</span></span><span id="Thmtheorem8.3" class="ltx_text ltx_font_bold"> </span>(<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib40" title="" class="ltx_ref">14</a>, Sec. 2]</cite>)<span id="Thmtheorem8.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem8.p1" class="ltx_para">
<p id="Thmtheorem8.p1.1" class="ltx_p"><span id="Thmtheorem8.p1.1.1" class="ltx_text ltx_font_italic">Toeplitz words are uniformly recurrent.</span></p>
</div>
</div>
<div id="Thmtheorem9" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem9.2" class="ltx_text ltx_font_bold">Lemma 9</span></span><span id="Thmtheorem9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem9.p1" class="ltx_para">
<p id="Thmtheorem9.p1.1" class="ltx_p"><span id="Thmtheorem9.p1.1.1" class="ltx_text ltx_font_italic">The sequence <math id="Thmtheorem9.p1.m1" class="ltx_Math" alttext="\Delta(\mathbf{t}_{3/2})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta(\mathbf{t}_{3/2})</annotation></semantics></math> is <math id="Thmtheorem9.p1.m2" class="ltx_Math" alttext="3/2" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">3/2</annotation></semantics></math>-automatic.</span></p>
</div>
</div>
<div id="S2.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S2.SS1.p3" class="ltx_para">
<p id="S2.SS1.p3.1" class="ltx_p"><span id="S2.SS1.p3.1.1" class="ltx_text">Write <math id="S2.SS1.p3.m1" class="ltx_Math" alttext="\Delta(\mathbf{t}_{3/2})=\mathbf{y}=(y_{n})_{n\geq 0}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>𝐲</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\Delta(\mathbf{t}_{3/2})=\mathbf{y}=(y_{n})_{n\geq 0}</annotation></semantics></math>.
For <math id="S2.SS1.p3.m2" class="ltx_Math" alttext="n\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n\geq 0</annotation></semantics></math>, we show that, if <math id="S2.SS1.p3.m3" class="ltx_Math" alttext="\langle n\rangle_{3/2}=p0u" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">⟨</mo><mi>n</mi><mo stretchy="false">⟩</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><mo>=</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mn>0</mn><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></mrow><annotation encoding="application/x-tex">\langle n\rangle_{3/2}=p0u</annotation></semantics></math> with <math id="S2.SS1.p3.m4" class="ltx_Math" alttext="u\in\{1,2\}^{*}" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow><mo stretchy="false">}</mo></mrow><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">u\in\{1,2\}^{*}</annotation></semantics></math>, then the value of <math id="S2.SS1.p3.m5" class="ltx_Math" alttext="y_{n}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>n</mi></msub><annotation encoding="application/x-tex">y_{n}</annotation></semantics></math> is given by <math id="S2.SS1.p3.m6" class="ltx_Math" alttext="|u|\pmod{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>u</mi><mo stretchy="false">|</mo></mrow><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0.167em">mod</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">|u|\pmod{2}</annotation></semantics></math> (this also handles the case where <math id="S2.SS1.p3.m7" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> is empty). We distinguish two cases.</span></p>
</div>
<div id="S2.SS1.p4" class="ltx_para">
<p id="S2.SS1.p4.1" class="ltx_p"><span id="S2.SS1.p4.1.1" class="ltx_text ltx_font_bold">Case 1.<span id="S2.SS1.p4.1.1.1" class="ltx_text ltx_font_medium"> In the tree associated with the numeration language (recall <a href="#S1.F2" title="In 1.3 The base 3/2 and the corresponding Thue–Morse word ‣ 1 Introduction ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Fig.</span> <span class="ltx_text ltx_ref_tag">2</span></a>), if at some level of the tree two vertices are adjacent, they represent two consecutive numbers, say <math id="S2.SS1.p4.m1" class="ltx_Math" alttext="\langle n\rangle_{3/2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">⟨</mo><mi>n</mi><mo stretchy="false">⟩</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\langle n\rangle_{3/2}</annotation></semantics></math> and <math id="S2.SS1.p4.m2" class="ltx_Math" alttext="\langle n+1\rangle_{3/2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">⟨</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">⟩</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\langle n+1\rangle_{3/2}</annotation></semantics></math>. As mentioned in the introduction, the rhythm <math id="S2.SS1.p4.m3" class="ltx_Math" alttext="(02,1)^{\mathbb{N}}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mn>02</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mi>ℕ</mi></msup><annotation encoding="application/x-tex">(02,1)^{\mathbb{N}}</annotation></semantics></math> of this tree is periodic: vertices of degree <math id="S2.SS1.p4.m4" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>, whose outgoing edges are labeled <math id="S2.SS1.p4.m5" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> and <math id="S2.SS1.p4.m6" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>, alternate with vertices of degree <math id="S2.SS1.p4.m7" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>, having an outgoing edge labeled <math id="S2.SS1.p4.m8" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>.
The vertices <math id="S2.SS1.p4.m9" class="ltx_Math" alttext="\langle n\rangle_{3/2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">⟨</mo><mi>n</mi><mo stretchy="false">⟩</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\langle n\rangle_{3/2}</annotation></semantics></math> and <math id="S2.SS1.p4.m10" class="ltx_Math" alttext="\langle n+1\rangle_{3/2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">⟨</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">⟩</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\langle n+1\rangle_{3/2}</annotation></semantics></math> have a (last) common ancestor <math id="S2.SS1.p4.m11" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math>, the lowest one in the tree, which has outgoing degree <math id="S2.SS1.p4.m12" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>.
The path from <math id="S2.SS1.p4.m13" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math> to <math id="S2.SS1.p4.m14" class="ltx_Math" alttext="\langle n\rangle_{3/2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">⟨</mo><mi>n</mi><mo stretchy="false">⟩</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\langle n\rangle_{3/2}</annotation></semantics></math> first uses the left branch from <math id="S2.SS1.p4.m15" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math> with label <math id="S2.SS1.p4.m16" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> and then follows the rightmost edge; let <math id="S2.SS1.p4.m17" class="ltx_Math" alttext="0u" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><annotation encoding="application/x-tex">0u</annotation></semantics></math> be its label. In particular, <math id="S2.SS1.p4.m18" class="ltx_Math" alttext="u\in\{1,2\}^{*}" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow><mo stretchy="false">}</mo></mrow><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">u\in\{1,2\}^{*}</annotation></semantics></math>. Similarly, the path from <math id="S2.SS1.p4.m19" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math> to <math id="S2.SS1.p4.m20" class="ltx_Math" alttext="\langle n+1\rangle_{3/2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">⟨</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">⟩</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\langle n+1\rangle_{3/2}</annotation></semantics></math> first uses the right branch from <math id="S2.SS1.p4.m21" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math> with label <math id="S2.SS1.p4.m22" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> and then always follows the leftmost edge; let <math id="S2.SS1.p4.m23" class="ltx_Math" alttext="2v" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><annotation encoding="application/x-tex">2v</annotation></semantics></math> be its label with <math id="S2.SS1.p4.m24" class="ltx_Math" alttext="v\in\{{\tt 0},{\tt 1}\}^{*}" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mn>𝟶</mn><mo>,</mo><mn>𝟷</mn></mrow><mo stretchy="false">}</mo></mrow><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">v\in\{{\tt 0},{\tt 1}\}^{*}</annotation></semantics></math>.
Because of the periodic rhythm, <math id="S2.SS1.p4.m25" class="ltx_Math" alttext="u_{i}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">u_{i}=1</annotation></semantics></math> (resp., <math id="S2.SS1.p4.m26" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>) if and only if <math id="S2.SS1.p4.m27" class="ltx_Math" alttext="v_{i}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi>i</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">v_{i}=0</annotation></semantics></math> (resp., <math id="S2.SS1.p4.m28" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>). Thus, <math id="S2.SS1.p4.m29" class="ltx_Math" alttext="u_{i}+v_{i}=1\pmod{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>u</mi><mi>i</mi></msub><mo>+</mo><msub><mi>v</mi><mi>i</mi></msub></mrow><mo>=</mo><mrow><mn>1</mn><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0.167em">mod</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">u_{i}+v_{i}=1\pmod{2}</annotation></semantics></math>. Finally, if <math id="S2.SS1.p4.m30" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> is the label of the path from the root of the tree to <math id="S2.SS1.p4.m31" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math>, then <math id="S2.SS1.p4.m32" class="ltx_Math" alttext="t_{n}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mi>n</mi></msub><annotation encoding="application/x-tex">t_{n}</annotation></semantics></math> (resp., <math id="S2.SS1.p4.m33" class="ltx_Math" alttext="t_{n+1}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">t_{n+1}</annotation></semantics></math>) is the sum modulo <math id="S2.SS1.p4.m34" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> of the letters of <math id="S2.SS1.p4.m35" class="ltx_Math" alttext="wu" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><annotation encoding="application/x-tex">wu</annotation></semantics></math> (resp., <math id="S2.SS1.p4.m36" class="ltx_Math" alttext="wv" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><annotation encoding="application/x-tex">wv</annotation></semantics></math>), which yields</span></span></p>
<table id="S2.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex24.m1" class="ltx_Math" alttext="t_{n}+t_{n+1}=2\sum_{i=1}^{|w|}w_{i}+\sum_{i=1}^{|u|}(u_{i}+v_{i})\equiv|u|\pmod{2}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>t</mi><mi>n</mi></msub><mo>+</mo><msub><mi>t</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mo stretchy="false">|</mo><mi>w</mi><mo stretchy="false">|</mo></mrow></munderover><msub><mi>w</mi><mi>i</mi></msub></mrow></mrow><mo rspace="0.055em">+</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mo stretchy="false">|</mo><mi>u</mi><mo stretchy="false">|</mo></mrow></munderover><mrow><mo stretchy="false">(</mo><mrow><msub><mi>u</mi><mi>i</mi></msub><mo>+</mo><msub><mi>v</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≡</mo><mrow><mrow><mo stretchy="false">|</mo><mi>u</mi><mo stretchy="false">|</mo></mrow><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" movablelimits="false" rspace="0.167em">mod</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">t_{n}+t_{n+1}=2\sum_{i=1}^{|w|}w_{i}+\sum_{i=1}^{|u|}(u_{i}+v_{i})\equiv|u|\pmod{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS1.p4.2" class="ltx_p"><span id="S2.SS1.p4.2.1" class="ltx_text">which proves our claim on <math id="S2.SS1.p4.m37" class="ltx_Math" alttext="y_{n}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>n</mi></msub><annotation encoding="application/x-tex">y_{n}</annotation></semantics></math>.</span></p>
</div>
<div id="S2.SS1.p5" class="ltx_para">
<p id="S2.SS1.p5.1" class="ltx_p"><span id="S2.SS1.p5.1.1" class="ltx_text ltx_font_bold">Case 2.<span id="S2.SS1.p5.1.1.1" class="ltx_text ltx_font_medium">
There is another situation to take into account: if <math id="S2.SS1.p5.m1" class="ltx_Math" alttext="\langle n\rangle_{3/2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">⟨</mo><mi>n</mi><mo stretchy="false">⟩</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\langle n\rangle_{3/2}</annotation></semantics></math> is the rightmost vertex of a level, then <math id="S2.SS1.p5.m2" class="ltx_Math" alttext="\langle n+1\rangle_{3/2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">⟨</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">⟩</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\langle n+1\rangle_{3/2}</annotation></semantics></math> is the leftmost vertex of the next level. Once again, the periodic rhythm imposes the following condition:
if the rightmost edge at level <math id="S2.SS1.p5.m3" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> is labeled <math id="S2.SS1.p5.m4" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> (resp., <math id="S2.SS1.p5.m5" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>), then the leftmost edge at level <math id="S2.SS1.p5.m6" class="ltx_Math" alttext="j+1" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">j+1</annotation></semantics></math> is labeled <math id="S2.SS1.p5.m7" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> (resp., <math id="S2.SS1.p5.m8" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>), for all <math id="S2.SS1.p5.m9" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>. Thus, if <math id="S2.SS1.p5.m10" class="ltx_math_unparsed" alttext="u=u_{1}\cdots u_{k}" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>=</mo><mi>u</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>u</mi><msub><mrow></mrow><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">u=u_{1}\cdots u_{k}</annotation></semantics></math> is the path from the root to <math id="S2.SS1.p5.m11" class="ltx_Math" alttext="\langle n\rangle_{3/2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">⟨</mo><mi>n</mi><mo stretchy="false">⟩</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\langle n\rangle_{3/2}</annotation></semantics></math>, then <math id="S2.SS1.p5.m12" class="ltx_math_unparsed" alttext="2(u_{1}-1)\cdots(u_{k}-1)" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mn>1</mn></msub><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">⋯</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>k</mi></msub><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">2(u_{1}-1)\cdots(u_{k}-1)</annotation></semantics></math> is the path to <math id="S2.SS1.p5.m13" class="ltx_Math" alttext="\langle n+1\rangle_{3/2}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">⟨</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">⟩</mo></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\langle n+1\rangle_{3/2}</annotation></semantics></math>. In that case,</span></span></p>
<table id="S2.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex25.m1" class="ltx_Math" alttext="t_{n}+t_{n+1}=2+\sum_{i=1}^{|u|}(2u_{i}-1)\equiv|u|\pmod{2}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>t</mi><mi>n</mi></msub><mo>+</mo><msub><mi>t</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>=</mo><mrow><mn>2</mn><mo rspace="0.055em">+</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mo stretchy="false">|</mo><mi>u</mi><mo stretchy="false">|</mo></mrow></munderover><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mi>i</mi></msub></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≡</mo><mrow><mrow><mo stretchy="false">|</mo><mi>u</mi><mo stretchy="false">|</mo></mrow><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" movablelimits="false" rspace="0.167em">mod</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">t_{n}+t_{n+1}=2+\sum_{i=1}^{|u|}(2u_{i}-1)\equiv|u|\pmod{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS1.p5.2" class="ltx_p"><span id="S2.SS1.p5.2.1" class="ltx_text">which again proves our claim on <math id="S2.SS1.p5.m14" class="ltx_Math" alttext="y_{n}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>n</mi></msub><annotation encoding="application/x-tex">y_{n}</annotation></semantics></math>.</span></p>
</div>
<div id="S2.SS1.p6" class="ltx_para">
<p id="S2.SS1.p6.1" class="ltx_p"><span id="S2.SS1.p6.1.1" class="ltx_text">The previous property satisfied by the letters <math id="S2.SS1.p6.m1" class="ltx_Math" alttext="y_{n}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>n</mi></msub><annotation encoding="application/x-tex">y_{n}</annotation></semantics></math> of <math id="S2.SS1.p6.m2" class="ltx_Math" alttext="\mathbf{y}" display="inline" intent=":literal"><semantics><mi>𝐲</mi><annotation encoding="application/x-tex">\mathbf{y}</annotation></semantics></math> can be translated into the deterministic finite automaton with output (DFAO) depicted in <a href="#S2.F4" title="In Proof. ‣ 2.1 On the sequence of first differences ‣ 2 Combinatorial properties of 𝐭_{3/2} and 𝐭^′ ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Fig.</span> <span class="ltx_text ltx_ref_tag">4</span></a>, showing that <math id="S2.SS1.p6.m3" class="ltx_Math" alttext="\mathbf{y}" display="inline" intent=":literal"><semantics><mi>𝐲</mi><annotation encoding="application/x-tex">\mathbf{y}</annotation></semantics></math> is <math id="S2.SS1.p6.m4" class="ltx_Math" alttext="3/2" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">3/2</annotation></semantics></math>-automatic.</span></p>
</div>
<figure id="S2.F4" class="ltx_figure"><span class="ltx_inline-block"><svg id="S2.F4.pic1" class="ltx_picture ltx_centering" height="106.98" overflow="visible" version="1.1" viewBox="0 0 132.5 106.98" width="132.5"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,106.98) matrix(1 0 0 -1 0 0) translate(39.65,0) translate(0,57.49)"><g style="--ltx-stroke-color:#000000;" stroke="#000000"><path style="fill:none" d="M 13.84 0 C 13.84 7.64 7.64 13.84 0 13.84 C -7.64 13.84 -13.84 7.64 -13.84 0 C -13.84 -7.64 -7.64 -13.84 0 -13.84 C 7.64 -13.84 13.84 -7.64 13.84 0 Z M 0 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -3.63 -4.23)"><foreignObject style="--ltx-fo-width:0.53em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:10pt;" height="8.46" overflow="visible" transform="matrix(1 0 0 -1 0 8.46)" width="7.26"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.F4.pic1.m1" class="ltx_Math" alttext="{\tt 0}" display="inline" intent=":literal"><semantics><mn>𝟶</mn><annotation encoding="application/x-tex">{\tt 0}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;" stroke="#000000"><path style="fill:none" d="M 92.58 0 C 92.58 7.64 86.38 13.84 78.74 13.84 C 71.1 13.84 64.9 7.64 64.9 0 C 64.9 -7.64 71.1 -13.84 78.74 -13.84 C 86.38 -13.84 92.58 -7.64 92.58 0 Z M 78.74 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 75.11 -4.23)"><foreignObject style="--ltx-fo-width:0.53em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:10pt;" height="8.46" overflow="visible" transform="matrix(1 0 0 -1 0 8.46)" width="7.26"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.F4.pic1.m2" class="ltx_Math" alttext="{\tt 1}" display="inline" intent=":literal"><semantics><mn>𝟷</mn><annotation encoding="application/x-tex">{\tt 1}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M -39.37 0 L -20.48 0"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 -20.48 0)"><path d="M 5.26 0 C 4.61 0.16 1.77 1.04 0 2.01 L 0 -2.01 C 1.77 -1.04 4.61 -0.16 5.26 0 Z"></path></g><path style="fill:none" d="M -3.65 13.63 C -9.55 35.65 9.55 35.65 5.3 19.78"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-0.25882 -0.96593 0.96593 -0.25882 5.3 19.78)"><path d="M 5.26 0 C 4.61 0.16 1.77 1.04 0 2.01 L 0 -2.01 C 1.77 -1.04 4.61 -0.16 5.26 0 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -3.46 35.5)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.F4.pic1.m3" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 12.22 7.06 C 30.56 17.64 48.18 17.64 61.01 10.24"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.86603 -0.5 0.5 0.86603 61.01 10.24)"><path d="M 5.26 0 C 4.61 0.16 1.77 1.04 0 2.01 L 0 -2.01 C 1.77 -1.04 4.61 -0.16 5.26 0 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 29.38 27.5)"><foreignObject style="--ltx-fo-width:1.44em;--ltx-fo-height:0.64em;--ltx-fo-depth:0.19em;font-size:10pt;" height="11.61" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="19.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.F4.pic1.m4" class="ltx_Math" alttext="1,2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">1,2</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 66.52 -7.06 C 48.18 -17.64 30.56 -17.64 17.74 -10.24"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-0.86603 0.5 -0.5 -0.86603 17.74 -10.24)"><path d="M 5.26 0 C 4.61 0.16 1.77 1.04 0 2.01 L 0 -2.01 C 1.77 -1.04 4.61 -0.16 5.26 0 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 22.84 -39.5)"><foreignObject style="--ltx-fo-width:2.39em;--ltx-fo-height:0.64em;--ltx-fo-depth:0.19em;font-size:10pt;" height="11.61" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="33.06"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.F4.pic1.m5" class="ltx_Math" alttext="0,1,2" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">0,1,2</annotation></semantics></math></span></span></foreignObject></g></g></svg></span>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">Figure 4: </span>A DFAO generating the sequence of first differences <math id="S2.F4.m4" class="ltx_Math" alttext="\Delta(\mathbf{t}_{3/2})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta(\mathbf{t}_{3/2})</annotation></semantics></math> of the Thue–Morse sequence <math id="S2.F4.m5" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> in base <math id="S2.F4.m6" class="ltx_Math" alttext="3/2" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">3/2</annotation></semantics></math>.</figcaption>
</figure>
<div id="S2.SS1.p7" class="ltx_para">
<p id="S2.SS1.p7.1" class="ltx_p"><span id="S2.SS1.p7.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="Thmtheorem10" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem10.2" class="ltx_text ltx_font_italic">Remark 10</span></span><span id="Thmtheorem10.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="Thmtheorem10.p1" class="ltx_para">
<p id="Thmtheorem10.p1.1" class="ltx_p">This situation parallels that of the classical Thue–Morse word <math id="Thmtheorem10.p1.m1" class="ltx_Math" alttext="\mathbf{t}=(t_{n})_{n\geq 0}" display="inline" intent=":literal"><semantics><mrow><mi>𝐭</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbf{t}=(t_{n})_{n\geq 0}</annotation></semantics></math> and the period doubling word <math id="Thmtheorem10.p1.m2" class="ltx_Math" alttext="\mathbf{p}=(p_{n})_{n\geq 0}" display="inline" intent=":literal"><semantics><mrow><mi>𝐩</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbf{p}=(p_{n})_{n\geq 0}</annotation></semantics></math>; except that the role of <math id="Thmtheorem10.p1.m3" class="ltx_Math" alttext="{\tt 0}" display="inline" intent=":literal"><semantics><mn>𝟶</mn><annotation encoding="application/x-tex">{\tt 0}</annotation></semantics></math> and <math id="Thmtheorem10.p1.m4" class="ltx_Math" alttext="{\tt 1}" display="inline" intent=":literal"><semantics><mn>𝟷</mn><annotation encoding="application/x-tex">{\tt 1}</annotation></semantics></math> are exchanged with <math id="Thmtheorem10.p1.m5" class="ltx_Math" alttext="p_{n}=1+t_{n}+t_{n+1}\pmod{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>n</mi></msub><mo>=</mo><mrow><mrow><mn>1</mn><mo>+</mo><msub><mi>t</mi><mi>n</mi></msub><mo>+</mo><msub><mi>t</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0.167em">mod</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p_{n}=1+t_{n}+t_{n+1}\pmod{2}</annotation></semantics></math>. One can proceed with the same proof as above, with the benefit that the tree associated with the base-<math id="Thmtheorem10.p1.m6" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> system being a full binary tree leads to simpler arguments. Hence <math id="Thmtheorem10.p1.m7" class="ltx_Math" alttext="\Delta(\mathbf{t}_{3/2})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta(\mathbf{t}_{3/2})</annotation></semantics></math> can be seen as an analogue of the period doubling word for base <math id="Thmtheorem10.p1.m8" class="ltx_Math" alttext="3/2" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">3/2</annotation></semantics></math>.</p>
</div>
</div>
<div id="S2.SS1.p8" class="ltx_para">
<p id="S2.SS1.p8.1" class="ltx_p">Thanks to <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib29" title="" class="ltx_ref">39</a>, Prop. 16]</cite>, the sequence <math id="S2.SS1.p8.m1" class="ltx_Math" alttext="\Delta(\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta(\mathbf{t}_{3/2}</annotation></semantics></math> is an alternated fixed point of <math id="S2.SS1.p8.m2" class="ltx_Math" alttext="(f_{0},f_{1})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mn>0</mn></msub><mo>,</mo><msub><mi>f</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(f_{0},f_{1})</annotation></semantics></math> with</p>
<table id="S2.E8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(8)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E8.m1" class="ltx_Math" alttext="f_{0}\colon\left\{\begin{array}[]{l}{\tt 0}\mapsto{\tt 01},\\
{\tt 1}\mapsto{\tt 00},\\
\end{array}\right.\quad\text{ and }f_{1}\colon\left\{\begin{array}[]{l}{\tt 0}\mapsto{\tt 1},\\
{\tt 1}\mapsto{\tt 0}.\\
\end{array}\right." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mn>0</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo>{</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>𝟶</mn><mo stretchy="false">↦</mo><mn>𝟶𝟷</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>𝟷</mn><mo stretchy="false">↦</mo><mn>𝟶𝟶</mn></mrow><mo>,</mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mtext> and </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>1</mn></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo>{</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>𝟶</mn><mo stretchy="false">↦</mo><mn>𝟷</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>𝟷</mn><mo stretchy="false">↦</mo><mn>𝟶</mn></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{0}\colon\left\{\begin{array}[]{l}{\tt 0}\mapsto{\tt 01},\\
{\tt 1}\mapsto{\tt 00},\\
\end{array}\right.\quad\text{ and }f_{1}\colon\left\{\begin{array}[]{l}{\tt 0}\mapsto{\tt 1},\\
{\tt 1}\mapsto{\tt 0}.\\
\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS1.p8.2" class="ltx_p">We may notice that <math id="S2.SS1.p8.m3" class="ltx_Math" alttext="f_{0}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>0</mn></msub><annotation encoding="application/x-tex">f_{0}</annotation></semantics></math> is the morphism generating the usual period doubling word.</p>
</div>
<div id="Thmtheorem11" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem11.2" class="ltx_text ltx_font_bold">Proposition 11</span></span><span id="Thmtheorem11.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem11.p1" class="ltx_para">
<p id="Thmtheorem11.p1.1" class="ltx_p"><span id="Thmtheorem11.p1.1.1" class="ltx_text ltx_font_italic">The sequence <math id="Thmtheorem11.p1.m1" class="ltx_Math" alttext="\Delta(\mathbf{t}_{3/2})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta(\mathbf{t}_{3/2})</annotation></semantics></math> is the <math id="Thmtheorem11.p1.m2" class="ltx_Math" alttext="(9,4)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>9</mn><mo>,</mo><mn>4</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(9,4)</annotation></semantics></math>-Toeplitz word <math id="Thmtheorem11.p1.m3" class="ltx_Math" alttext="\mathcal{T}({\tt 01}\mathord{?}{\tt 0}\mathord{?}{\tt 10}\mathord{?}\mathord{?})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>𝟶𝟷</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">?</mi><mo lspace="0em" rspace="0em">​</mo><mn>𝟶</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">?</mi><mo lspace="0em" rspace="0em">​</mo><mn>𝟷𝟶</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">?</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">?</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}({\tt 01}\mathord{?}{\tt 0}\mathord{?}{\tt 10}\mathord{?}\mathord{?})</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S2.SS1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S2.SS1.p9" class="ltx_para">
<p id="S2.SS1.p9.1" class="ltx_p"><span id="S2.SS1.p9.1.1" class="ltx_text">Write <math id="S2.SS1.p9.m1" class="ltx_Math" alttext="\Delta(\mathbf{t}_{3/2})=\mathbf{y}=(y_{n})_{n\geq 0}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>𝐲</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\Delta(\mathbf{t}_{3/2})=\mathbf{y}=(y_{n})_{n\geq 0}</annotation></semantics></math>.
On the one hand, let <math id="S2.SS1.p9.m2" class="ltx_Math" alttext="w={\tt 01}\mathord{?}{\tt 0}\mathord{?}{\tt 10}\mathord{?}\mathord{?}" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>=</mo><mrow><mn>𝟶𝟷</mn><mo lspace="0em" rspace="0em">​</mo><mi>?</mi><mo lspace="0em" rspace="0em">​</mo><mn>𝟶</mn><mo lspace="0em" rspace="0em">​</mo><mi>?</mi><mo lspace="0em" rspace="0em">​</mo><mn>𝟷𝟶</mn><mo lspace="0em" rspace="0em">​</mo><mi>?</mi><mo lspace="0em" rspace="0em">​</mo><mi>?</mi></mrow></mrow><annotation encoding="application/x-tex">w={\tt 01}\mathord{?}{\tt 0}\mathord{?}{\tt 10}\mathord{?}\mathord{?}</annotation></semantics></math> and <math id="S2.SS1.p9.m3" class="ltx_Math" alttext="\mathcal{T}_{0}(w)=\mathord{?}^{\omega}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mi>?</mi><mi>ω</mi></msup></mrow><annotation encoding="application/x-tex">\mathcal{T}_{0}(w)=\mathord{?}^{\omega}</annotation></semantics></math>.
As prescribed, we iteratively apply the replacement of the <math id="S2.SS1.p9.m4" class="ltx_Math" alttext="\mathord{?}" display="inline" intent=":literal"><semantics><mi>?</mi><annotation encoding="application/x-tex">\mathord{?}</annotation></semantics></math>-symbols to get the first two iterations</span></p>
<table id="S2.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex26.m1" class="ltx_Math" alttext="\displaystyle\mathcal{T}_{1}(w)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{T}_{1}(w)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex26.m2" class="ltx_math_unparsed" alttext="\displaystyle={\tt 01}\mathord{?}{\tt 0}\mathord{?}{\tt 10}\mathord{?}\mathord{?}{\tt 01}\mathord{?}{\tt 0}\mathord{?}{\tt 10}\mathord{?}\mathord{?}{\tt 01}\mathord{?}{\tt 0}\mathord{?}{\tt 10}\mathord{?}\mathord{?}{\tt 01}\mathord{?}{\tt 0}\mathord{?}{\tt 10}\mathord{?}\mathord{?}\cdots," display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mn>𝟶𝟷</mn><mi>?</mi><mn>𝟶</mn><mi>?</mi><mn>𝟷𝟶</mn><mi>?</mi><mi>?</mi><mn>𝟶𝟷</mn><mi>?</mi><mn>𝟶</mn><mi>?</mi><mn>𝟷𝟶</mn><mi>?</mi><mi>?</mi><mn>𝟶𝟷</mn><mi>?</mi><mn>𝟶</mn><mi>?</mi><mn>𝟷𝟶</mn><mi>?</mi><mi>?</mi><mn>𝟶𝟷</mn><mi>?</mi><mn>𝟶</mn><mi>?</mi><mn>𝟷𝟶</mn><mi>?</mi><mi>?</mi><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle={\tt 01}\mathord{?}{\tt 0}\mathord{?}{\tt 10}\mathord{?}\mathord{?}{\tt 01}\mathord{?}{\tt 0}\mathord{?}{\tt 10}\mathord{?}\mathord{?}{\tt 01}\mathord{?}{\tt 0}\mathord{?}{\tt 10}\mathord{?}\mathord{?}{\tt 01}\mathord{?}{\tt 0}\mathord{?}{\tt 10}\mathord{?}\mathord{?}\cdots,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex27.m1" class="ltx_Math" alttext="\displaystyle\mathcal{T}_{2}(w)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{T}_{2}(w)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex27.m2" class="ltx_math_unparsed" alttext="\displaystyle={\tt 0100110}\mathord{?}{\tt 001}\mathord{?}{\tt 01100}\mathord{?}{\tt 01}\mathord{?}{\tt 00101}\mathord{?}{\tt 0100}\mathord{?}{\tt 1010}\cdots." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mn>𝟶𝟷𝟶𝟶𝟷𝟷𝟶</mn><mi>?</mi><mn>𝟶𝟶𝟷</mn><mi>?</mi><mn>𝟶𝟷𝟷𝟶𝟶</mn><mi>?</mi><mn>𝟶𝟷</mn><mi>?</mi><mn>𝟶𝟶𝟷𝟶𝟷</mn><mi>?</mi><mn>𝟶𝟷𝟶𝟶</mn><mi>?</mi><mn>𝟷𝟶𝟷𝟶</mn><mo lspace="0em" rspace="0em">⋯</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle={\tt 0100110}\mathord{?}{\tt 001}\mathord{?}{\tt 01100}\mathord{?}{\tt 01}\mathord{?}{\tt 00101}\mathord{?}{\tt 0100}\mathord{?}{\tt 1010}\cdots.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS1.p9.2" class="ltx_p"><span id="S2.SS1.p9.2.1" class="ltx_text">On the other hand, we know that</span></p>
<table id="S2.Ex28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex28.m1" class="ltx_math_unparsed" alttext="\mathbf{y}=(y_{n})_{n\geq 0}=f_{0}(y_{0})f_{1}(y_{1})f_{0}(y_{2})f_{1}(y_{3})f_{0}(y_{4})f_{1}(y_{5})\cdots," display="block" intent=":literal"><semantics><mrow><mi>𝐲</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></msub><mo>=</mo><msub><mi>f</mi><mn>0</mn></msub><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><msub><mi>f</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><msub><mi>f</mi><mn>0</mn></msub><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><msub><mi>f</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow><msub><mi>f</mi><mn>0</mn></msub><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>4</mn></msub><mo stretchy="false">)</mo></mrow><msub><mi>f</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>5</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbf{y}=(y_{n})_{n\geq 0}=f_{0}(y_{0})f_{1}(y_{1})f_{0}(y_{2})f_{1}(y_{3})f_{0}(y_{4})f_{1}(y_{5})\cdots,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS1.p9.3" class="ltx_p"><span id="S2.SS1.p9.3.1" class="ltx_text">so the word <math id="S2.SS1.p9.m5" class="ltx_Math" alttext="\mathbf{y}" display="inline" intent=":literal"><semantics><mi>𝐲</mi><annotation encoding="application/x-tex">\mathbf{y}</annotation></semantics></math> is made of blocks of length <math id="S2.SS1.p9.m6" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math> of the form <math id="S2.SS1.p9.m7" class="ltx_Math" alttext="f_{0}(y_{2n})f_{1}(y_{2n+1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f_{0}(y_{2n})f_{1}(y_{2n+1})</annotation></semantics></math> with <math id="S2.SS1.p9.m8" class="ltx_Math" alttext="n\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n\geq 0</annotation></semantics></math>. From the definition of the two morphisms in (<a href="#S2.E8" title="Equation 8 ‣ 2.1 On the sequence of first differences ‣ 2 Combinatorial properties of 𝐭_{3/2} and 𝐭^′ ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>), a direct inspection yields</span></p>
<table id="S2.Ex29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex29.m1" class="ltx_Math" alttext="y_{3n}={\tt 0},\quad y_{3n+1}=\overline{y_{2n}},\quad y_{3n+2}=\overline{y_{2n+1}}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>y</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo>=</mo><mn>𝟶</mn></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>y</mi><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mover accent="true"><msub><mi>y</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo stretchy="true">¯</mo></mover></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>y</mi><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>2</mn></mrow></msub><mo>=</mo><mover accent="true"><msub><mi>y</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="true">¯</mo></mover></mrow></mrow><annotation encoding="application/x-tex">y_{3n}={\tt 0},\quad y_{3n+1}=\overline{y_{2n}},\quad y_{3n+2}=\overline{y_{2n+1}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS1.p9.4" class="ltx_p"><span id="S2.SS1.p9.4.1" class="ltx_text">for all <math id="S2.SS1.p9.m9" class="ltx_Math" alttext="n\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n\geq 0</annotation></semantics></math> (where we recall that <math id="S2.SS1.p9.m10" class="ltx_Math" alttext="\bar{\cdot}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>⋅</mo><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{\cdot}</annotation></semantics></math> is bit-wise complementation morphism).
Since the given pattern <math id="S2.SS1.p9.m11" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> has length <math id="S2.SS1.p9.m12" class="ltx_Math" alttext="9" display="inline" intent=":literal"><semantics><mn>9</mn><annotation encoding="application/x-tex">9</annotation></semantics></math>, consider blocks of length <math id="S2.SS1.p9.m13" class="ltx_Math" alttext="9" display="inline" intent=":literal"><semantics><mn>9</mn><annotation encoding="application/x-tex">9</annotation></semantics></math> in <math id="S2.SS1.p9.m14" class="ltx_Math" alttext="\mathbf{y}" display="inline" intent=":literal"><semantics><mi>𝐲</mi><annotation encoding="application/x-tex">\mathbf{y}</annotation></semantics></math>. The above relations give, for all <math id="S2.SS1.p9.m15" class="ltx_Math" alttext="m\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">m\geq 0</annotation></semantics></math>,</span></p>
<table id="S2.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex30"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex30.m1" class="ltx_Math" alttext="\displaystyle y_{9m}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mrow><mn>9</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><annotation encoding="application/x-tex">\displaystyle y_{9m}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex30.m2" class="ltx_Math" alttext="\displaystyle=y_{9m+3}=y_{9m+6}={\tt 0}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><msub><mi>y</mi><mrow><mrow><mn>9</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mn>3</mn></mrow></msub><mo>=</mo><msub><mi>y</mi><mrow><mrow><mn>9</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mn>6</mn></mrow></msub><mo>=</mo><mn>𝟶</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=y_{9m+3}=y_{9m+6}={\tt 0},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex31.m1" class="ltx_Math" alttext="\displaystyle y_{9m+1}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mrow><mrow><mn>9</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\displaystyle y_{9m+1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex31.m2" class="ltx_Math" alttext="\displaystyle=y_{3\cdot 3m+1}=\overline{y_{3\cdot 2m}}={\tt 1}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><msub><mi>y</mi><mrow><mrow><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>3</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mover accent="true"><msub><mi>y</mi><mrow><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><mo stretchy="true">¯</mo></mover><mo>=</mo><mn>𝟷</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=y_{3\cdot 3m+1}=\overline{y_{3\cdot 2m}}={\tt 1},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex32.m1" class="ltx_Math" alttext="\displaystyle y_{9m+5}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mrow><mrow><mn>9</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mn>5</mn></mrow></msub><annotation encoding="application/x-tex">\displaystyle y_{9m+5}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex32.m2" class="ltx_Math" alttext="\displaystyle=y_{3\cdot(3m+1)+2}=\overline{y_{2(3m+1)+1}}=\overline{y_{3\cdot(2m+1)}}={\tt 1}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><msub><mi>y</mi><mrow><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>2</mn></mrow></msub><mo>=</mo><mover accent="true"><msub><mi>y</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="true">¯</mo></mover><mo>=</mo><mover accent="true"><msub><mi>y</mi><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="true">¯</mo></mover><mo>=</mo><mn>𝟷</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=y_{3\cdot(3m+1)+2}=\overline{y_{2(3m+1)+1}}=\overline{y_{3\cdot(2m+1)}}={\tt 1},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS1.p9.5" class="ltx_p"><span id="S2.SS1.p9.5.1" class="ltx_text">which correspond to the “non-holes” positions (i.e., the non-<math id="S2.SS1.p9.m16" class="ltx_Math" alttext="\mathord{?}" display="inline" intent=":literal"><semantics><mi>?</mi><annotation encoding="application/x-tex">\mathord{?}</annotation></semantics></math> symbols) in the pattern <math id="S2.SS1.p9.m17" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math>. Now, for all <math id="S2.SS1.p9.m18" class="ltx_Math" alttext="m\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">m\geq 0</annotation></semantics></math>, we also have</span></p>
<table id="S2.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex33.m1" class="ltx_Math" alttext="\displaystyle y_{9m+2}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mrow><mrow><mn>9</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\displaystyle y_{9m+2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex33.m2" class="ltx_Math" alttext="\displaystyle=y_{3\cdot 3m+2}=\overline{y_{3\cdot 2m+1}}=y_{4m}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><msub><mi>y</mi><mrow><mrow><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>3</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mn>2</mn></mrow></msub><mo>=</mo><mover accent="true"><msub><mi>y</mi><mrow><mrow><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="true">¯</mo></mover><mo>=</mo><msub><mi>y</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=y_{3\cdot 3m+2}=\overline{y_{3\cdot 2m+1}}=y_{4m},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex34.m1" class="ltx_Math" alttext="\displaystyle y_{9m+4}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mrow><mrow><mn>9</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mn>4</mn></mrow></msub><annotation encoding="application/x-tex">\displaystyle y_{9m+4}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex34.m2" class="ltx_Math" alttext="\displaystyle=y_{3\cdot(3m+1)+1}=\overline{y_{3\cdot 2m+2}}=y_{4m+1}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><msub><mi>y</mi><mrow><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mover accent="true"><msub><mi>y</mi><mrow><mrow><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mn>2</mn></mrow></msub><mo stretchy="true">¯</mo></mover><mo>=</mo><msub><mi>y</mi><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=y_{3\cdot(3m+1)+1}=\overline{y_{3\cdot 2m+2}}=y_{4m+1},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex35.m1" class="ltx_Math" alttext="\displaystyle y_{9m+7}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mrow><mrow><mn>9</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mn>7</mn></mrow></msub><annotation encoding="application/x-tex">\displaystyle y_{9m+7}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex35.m2" class="ltx_Math" alttext="\displaystyle=y_{3\cdot(3m+2)+1}=\overline{y_{3\cdot(2m+1)+1}}=y_{4m+2}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><msub><mi>y</mi><mrow><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mover accent="true"><msub><mi>y</mi><mrow><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="true">¯</mo></mover><mo>=</mo><msub><mi>y</mi><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mn>2</mn></mrow></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=y_{3\cdot(3m+2)+1}=\overline{y_{3\cdot(2m+1)+1}}=y_{4m+2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex36.m1" class="ltx_Math" alttext="\displaystyle y_{9m+8}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mrow><mrow><mn>9</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mn>8</mn></mrow></msub><annotation encoding="application/x-tex">\displaystyle y_{9m+8}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex36.m2" class="ltx_Math" alttext="\displaystyle=y_{3\cdot(3m+2)+2}=\overline{y_{3\cdot(2m+1)+2}}=y_{4m+3}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><msub><mi>y</mi><mrow><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>2</mn></mrow></msub><mo>=</mo><mover accent="true"><msub><mi>y</mi><mrow><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>2</mn></mrow></msub><mo stretchy="true">¯</mo></mover><mo>=</mo><msub><mi>y</mi><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mn>3</mn></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=y_{3\cdot(3m+2)+2}=\overline{y_{3\cdot(2m+1)+2}}=y_{4m+3}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS1.p9.6" class="ltx_p"><span id="S2.SS1.p9.6.1" class="ltx_text">This exactly corresponds to the Toeplitz construction: the holes in the pattern <math id="S2.SS1.p9.m19" class="ltx_Math" alttext="w={\tt 01}\mathord{?}{\tt 0}\mathord{?}{\tt 10}\mathord{?}\mathord{?}" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>=</mo><mrow><mn>𝟶𝟷</mn><mo lspace="0em" rspace="0em">​</mo><mi>?</mi><mo lspace="0em" rspace="0em">​</mo><mn>𝟶</mn><mo lspace="0em" rspace="0em">​</mo><mi>?</mi><mo lspace="0em" rspace="0em">​</mo><mn>𝟷𝟶</mn><mo lspace="0em" rspace="0em">​</mo><mi>?</mi><mo lspace="0em" rspace="0em">​</mo><mi>?</mi></mrow></mrow><annotation encoding="application/x-tex">w={\tt 01}\mathord{?}{\tt 0}\mathord{?}{\tt 10}\mathord{?}\mathord{?}</annotation></semantics></math> have positions congruent to <math id="S2.SS1.p9.m20" class="ltx_Math" alttext="2,4,7,8\pmod{9}" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>7</mn><mo>,</mo><mrow><mn>8</mn><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0.167em">mod</mo><mn>9</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">2,4,7,8\pmod{9}</annotation></semantics></math> and they are replaced by symbols appearing earlier in the sequence, in consecutive classes modulo <math id="S2.SS1.p9.m21" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math>.
This shows that <math id="S2.SS1.p9.m22" class="ltx_Math" alttext="\mathbf{y}=\mathcal{T}({\tt 01}\mathord{?}{\tt 0}\mathord{?}{\tt 10}\mathord{?}\mathord{?})" display="inline" intent=":literal"><semantics><mrow><mi>𝐲</mi><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>𝟶𝟷</mn><mo lspace="0em" rspace="0em">​</mo><mi>?</mi><mo lspace="0em" rspace="0em">​</mo><mn>𝟶</mn><mo lspace="0em" rspace="0em">​</mo><mi>?</mi><mo lspace="0em" rspace="0em">​</mo><mn>𝟷𝟶</mn><mo lspace="0em" rspace="0em">​</mo><mi>?</mi><mo lspace="0em" rspace="0em">​</mo><mi>?</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{y}=\mathcal{T}({\tt 01}\mathord{?}{\tt 0}\mathord{?}{\tt 10}\mathord{?}\mathord{?})</annotation></semantics></math>, as desired.
∎</span></p>
</div>
</div>
<div id="S2.SS1.p10" class="ltx_para">
<p id="S2.SS1.p10.1" class="ltx_p">Every regular<span id="footnote1" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">1</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">1</sup>
              <span class="ltx_tag ltx_tag_note">1</span>
              
              
              
              
              
              
              
            A Toeplitz word <math id="footnote1.m1" class="ltx_Math" alttext="\mathcal{T}(w)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}(w)</annotation></semantics></math> is <em id="footnote1.2" class="ltx_emph ltx_font_italic">regular</em> if the density of <math id="footnote1.m2" class="ltx_Math" alttext="\mathord{?}" display="inline" intent=":literal"><semantics><mi>?</mi><annotation encoding="application/x-tex">\mathord{?}</annotation></semantics></math>-symbols in <math id="footnote1.m3" class="ltx_Math" alttext="\mathcal{T}_{i}(w)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}_{i}(w)</annotation></semantics></math> tends to <math id="footnote1.m4" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> as <math id="footnote1.m5" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> goes to infinity. It is the case with our <math id="footnote1.m6" class="ltx_Math" alttext="(9,4)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>9</mn><mo>,</mo><mn>4</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(9,4)</annotation></semantics></math>-periodic Toeplitz word <math id="footnote1.m7" class="ltx_Math" alttext="\mathcal{T}({\tt 01}\mathord{?}{\tt 0}\mathord{?}{\tt 10}\mathord{?}\mathord{?})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>𝟶𝟷</mn><mo lspace="0em" rspace="0em">​</mo><mi>?</mi><mo lspace="0em" rspace="0em">​</mo><mn>𝟶</mn><mo lspace="0em" rspace="0em">​</mo><mi>?</mi><mo lspace="0em" rspace="0em">​</mo><mn>𝟷𝟶</mn><mo lspace="0em" rspace="0em">​</mo><mi>?</mi><mo lspace="0em" rspace="0em">​</mo><mi>?</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}({\tt 01}\mathord{?}{\tt 0}\mathord{?}{\tt 10}\mathord{?}\mathord{?})</annotation></semantics></math> where <math id="footnote1.m8" class="ltx_Math" alttext="(4/9)^{i}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mrow><mn>4</mn><mo>/</mo><mn>9</mn></mrow><mo stretchy="false">)</mo></mrow><mi>i</mi></msup><annotation encoding="application/x-tex">(4/9)^{i}</annotation></semantics></math> indeed tends to <math id="footnote1.m9" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> as <math id="footnote1.m10" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> goes to infinity.</span></span></span> Toeplitz system is <em id="S2.SS1.p10.1.1" class="ltx_emph ltx_font_italic">strictly ergodic</em> (i.e., minimal and uniquely ergodic) <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib35" title="" class="ltx_ref">26</a>]</cite>. Hence, the frequency of every factor exists.
The letter frequencies in <math id="S2.SS1.p10.m1" class="ltx_Math" alttext="\Delta(\mathbf{t}_{3/2})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta(\mathbf{t}_{3/2})</annotation></semantics></math> thus exist by <a href="#Thmtheorem11" title="Proposition 11. ‣ 2.1 On the sequence of first differences ‣ 2 Combinatorial properties of 𝐭_{3/2} and 𝐭^′ ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">11</span></a> and can be computed explicitly. For instance, for all <math id="S2.SS1.p10.m2" class="ltx_Math" alttext="i\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">i\geq 0</annotation></semantics></math>, let <math id="S2.SS1.p10.m3" class="ltx_Math" alttext="P_{i}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>i</mi></msub><annotation encoding="application/x-tex">P_{i}</annotation></semantics></math> be the word of length <math id="S2.SS1.p10.m4" class="ltx_Math" alttext="9^{i}" display="inline" intent=":literal"><semantics><msup><mn>9</mn><mi>i</mi></msup><annotation encoding="application/x-tex">9^{i}</annotation></semantics></math> such that <math id="S2.SS1.p10.m5" class="ltx_Math" alttext="\mathcal{T}_{i}(w)=P_{i}^{\omega}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msubsup><mi>P</mi><mi>i</mi><mi>ω</mi></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{T}_{i}(w)=P_{i}^{\omega}</annotation></semantics></math>. From the Toeplitz generating process, we get</p>
<table id="S2.Ex37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex37.m1" class="ltx_Math" alttext="\begin{pmatrix}|P_{i+1}|_{\tt 0}\\
|P_{i+1}|_{\tt 1}\\
|P_{i+1}|_{\mathord{?}}\\
\end{pmatrix}=\begin{pmatrix}9&amp;0&amp;3\\
0&amp;9&amp;2\\
0&amp;0&amp;4\\
\end{pmatrix}\begin{pmatrix}|P_{i}|_{\tt 0}\\
|P_{i}|_{\tt 1}\\
|P_{i}|_{\mathord{?}}\\
\end{pmatrix}" display="block" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mrow><mo stretchy="false">|</mo><msub><mi>P</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">|</mo></mrow><mn>𝟶</mn></msub></mtd></mtr><mtr><mtd><msub><mrow><mo stretchy="false">|</mo><msub><mi>P</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">|</mo></mrow><mn>𝟷</mn></msub></mtd></mtr><mtr><mtd><msub><mrow><mo stretchy="false">|</mo><msub><mi>P</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">|</mo></mrow><mi>?</mi></msub></mtd></mtr></mtable><mo>)</mo></mrow><mo>=</mo><mrow><mrow><mo>(</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mn>9</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>3</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>9</mn></mtd><mtd><mn>2</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>4</mn></mtd></mtr></mtable><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mrow><mo stretchy="false">|</mo><msub><mi>P</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mn>𝟶</mn></msub></mtd></mtr><mtr><mtd><msub><mrow><mo stretchy="false">|</mo><msub><mi>P</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mn>𝟷</mn></msub></mtd></mtr><mtr><mtd><msub><mrow><mo stretchy="false">|</mo><msub><mi>P</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mi>?</mi></msub></mtd></mtr></mtable><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\begin{pmatrix}|P_{i+1}|_{\tt 0}\\
|P_{i+1}|_{\tt 1}\\
|P_{i+1}|_{\mathord{?}}\\
\end{pmatrix}=\begin{pmatrix}9&amp;0&amp;3\\
0&amp;9&amp;2\\
0&amp;0&amp;4\\
\end{pmatrix}\begin{pmatrix}|P_{i}|_{\tt 0}\\
|P_{i}|_{\tt 1}\\
|P_{i}|_{\mathord{?}}\\
\end{pmatrix}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS1.p10.2" class="ltx_p">since <math id="S2.SS1.p10.m6" class="ltx_Math" alttext="\mathord{?}" display="inline" intent=":literal"><semantics><mi>?</mi><annotation encoding="application/x-tex">\mathord{?}</annotation></semantics></math>-symbols are replaced by three <math id="S2.SS1.p10.m7" class="ltx_Math" alttext="{\tt 0}" display="inline" intent=":literal"><semantics><mn>𝟶</mn><annotation encoding="application/x-tex">{\tt 0}</annotation></semantics></math>’s, two <math id="S2.SS1.p10.m8" class="ltx_Math" alttext="{\tt 1}" display="inline" intent=":literal"><semantics><mn>𝟷</mn><annotation encoding="application/x-tex">{\tt 1}</annotation></semantics></math>’s and four <math id="S2.SS1.p10.m9" class="ltx_Math" alttext="\mathord{?}" display="inline" intent=":literal"><semantics><mi>?</mi><annotation encoding="application/x-tex">\mathord{?}</annotation></semantics></math>’s.
Hence, for all <math id="S2.SS1.p10.m10" class="ltx_Math" alttext="n\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n\geq 1</annotation></semantics></math>,</p>
<table id="S2.Ex38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex38.m1" class="ltx_Math" alttext="\frac{1}{9^{n}}\begin{pmatrix}|P_{n}|_{\tt 0}\\
|P_{n}|_{\tt 1}\\
|P_{n}|_{\mathord{?}}\\
\end{pmatrix}=\frac{1}{9^{n}}\begin{pmatrix}9&amp;0&amp;3\\
0&amp;9&amp;2\\
0&amp;0&amp;4\\
\end{pmatrix}^{n}\begin{pmatrix}0\\
0\\
1\end{pmatrix}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mn>1</mn><msup><mn>9</mn><mi>n</mi></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mrow><mo stretchy="false">|</mo><msub><mi>P</mi><mi>n</mi></msub><mo stretchy="false">|</mo></mrow><mn>𝟶</mn></msub></mtd></mtr><mtr><mtd><msub><mrow><mo stretchy="false">|</mo><msub><mi>P</mi><mi>n</mi></msub><mo stretchy="false">|</mo></mrow><mn>𝟷</mn></msub></mtd></mtr><mtr><mtd><msub><mrow><mo stretchy="false">|</mo><msub><mi>P</mi><mi>n</mi></msub><mo stretchy="false">|</mo></mrow><mi>?</mi></msub></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><msup><mn>9</mn><mi>n</mi></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mn>9</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>3</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>9</mn></mtd><mtd><mn>2</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>4</mn></mtd></mtr></mtable><mo>)</mo></mrow><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>1</mn></mtd></mtr></mtable><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{1}{9^{n}}\begin{pmatrix}|P_{n}|_{\tt 0}\\
|P_{n}|_{\tt 1}\\
|P_{n}|_{\mathord{?}}\\
\end{pmatrix}=\frac{1}{9^{n}}\begin{pmatrix}9&amp;0&amp;3\\
0&amp;9&amp;2\\
0&amp;0&amp;4\\
\end{pmatrix}^{n}\begin{pmatrix}0\\
0\\
1\end{pmatrix},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS1.p10.3" class="ltx_p">from which it follows that <math id="S2.SS1.p10.m11" class="ltx_Math" alttext="\freq_{\Delta(\mathbf{t}_{3/2})}({\tt 0})=3/5" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>freq</mi><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>𝟶</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>3</mn><mo>/</mo><mn>5</mn></mrow></mrow><annotation encoding="application/x-tex">\freq_{\Delta(\mathbf{t}_{3/2})}({\tt 0})=3/5</annotation></semantics></math> and <math id="S2.SS1.p10.m12" class="ltx_Math" alttext="\freq_{\Delta(\mathbf{t}_{3/2})}({\tt 1})=2/5" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>freq</mi><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>𝟷</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo>/</mo><mn>5</mn></mrow></mrow><annotation encoding="application/x-tex">\freq_{\Delta(\mathbf{t}_{3/2})}({\tt 1})=2/5</annotation></semantics></math>.</p>
</div>
</section>
<section id="S2.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">2.2 </span>From the sequence <math id="S2.SS2.m1" class="ltx_Math" alttext="\Delta(\mathbf{t}_{3/2})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta(\mathbf{t}_{3/2})</annotation></semantics></math> back to the original sequence <math id="S2.SS2.m2" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math></h3>

<div id="S2.SS2.p1" class="ltx_para">
<p id="S2.SS2.p1.1" class="ltx_p">Every factor <math id="S2.SS2.p1.m1" class="ltx_math_unparsed" alttext="d_{1}\cdots d_{\ell}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>d</mi><msub><mrow></mrow><mi mathvariant="normal">ℓ</mi></msub></mrow><annotation encoding="application/x-tex">d_{1}\cdots d_{\ell}</annotation></semantics></math> in <math id="S2.SS2.p1.m2" class="ltx_Math" alttext="\Delta(\mathbf{t}_{3/2})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta(\mathbf{t}_{3/2})</annotation></semantics></math> corresponds to one of the two complementary factors</p>
<table id="S2.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex39"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex39.m1" class="ltx_math_unparsed" alttext="\displaystyle{\tt 0}({\tt 0}+d_{1}\bmod{2})({\tt 0}+d_{1}+d_{2}\bmod{2})\cdots({\tt 0}+d_{1}+\cdots+d_{\ell}\bmod{2})" display="inline" intent=":literal"><semantics><mrow><mn>𝟶</mn><mrow><mo stretchy="false">(</mo><mn>𝟶</mn><mo>+</mo><msub><mi>d</mi><mn>1</mn></msub><mo>mod</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mn>𝟶</mn><mo>+</mo><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><msub><mi>d</mi><mn>2</mn></msub><mo>mod</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">⋯</mo><mrow><mo stretchy="false">(</mo><mn>𝟶</mn><mo>+</mo><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>d</mi><mi mathvariant="normal">ℓ</mi></msub><mo>mod</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\tt 0}({\tt 0}+d_{1}\bmod{2})({\tt 0}+d_{1}+d_{2}\bmod{2})\cdots({\tt 0}+d_{1}+\cdots+d_{\ell}\bmod{2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex40"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><span id="S2.Ex40.1.1" class="ltx_text ltx_markedasmath">or,</span></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex40.m2" class="ltx_math_unparsed" alttext="\displaystyle{\tt 1}({\tt 1}+d_{1}\bmod{2})({\tt 1}+d_{1}+d_{2}\bmod{2})\cdots({\tt 1}+d_{1}+\cdots+d_{\ell}\bmod{2})" display="inline" intent=":literal"><semantics><mrow><mn>𝟷</mn><mrow><mo stretchy="false">(</mo><mn>𝟷</mn><mo>+</mo><msub><mi>d</mi><mn>1</mn></msub><mo>mod</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mn>𝟷</mn><mo>+</mo><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><msub><mi>d</mi><mn>2</mn></msub><mo>mod</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">⋯</mo><mrow><mo stretchy="false">(</mo><mn>𝟷</mn><mo>+</mo><msub><mi>d</mi><mn>1</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>d</mi><mi mathvariant="normal">ℓ</mi></msub><mo>mod</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\tt 1}({\tt 1}+d_{1}\bmod{2})({\tt 1}+d_{1}+d_{2}\bmod{2})\cdots({\tt 1}+d_{1}+\cdots+d_{\ell}\bmod{2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS2.p1.2" class="ltx_p">in <math id="S2.SS2.p1.m3" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math>.
At least one of the two occurs in <math id="S2.SS2.p1.m4" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math>. Hence we obtain</p>
<table id="S2.Ex41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex41.m1" class="ltx_Math" alttext="\mathsf{p}_{\Delta(\mathbf{t}_{3/2})}(n)\leq\mathsf{p}_{\mathbf{t}_{3/2}}(n+1)\leq 2\mathsf{p}_{\Delta(\mathbf{t}_{3/2})}(n)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝗉</mi><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msub><mi>𝗉</mi><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝗉</mi><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathsf{p}_{\Delta(\mathbf{t}_{3/2})}(n)\leq\mathsf{p}_{\mathbf{t}_{3/2}}(n+1)\leq 2\mathsf{p}_{\Delta(\mathbf{t}_{3/2})}(n)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS2.p1.3" class="ltx_p">for all <math id="S2.SS2.p1.m5" class="ltx_Math" alttext="n\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n\geq 0</annotation></semantics></math>.
However, this is not enough to conclude about frequencies in <math id="S2.SS2.p1.m6" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math>. If <math id="S2.SS2.p1.m7" class="ltx_Math" alttext="{\tt 0}u" display="inline" intent=":literal"><semantics><mrow><mn>𝟶</mn><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><annotation encoding="application/x-tex">{\tt 0}u</annotation></semantics></math> and <math id="S2.SS2.p1.m8" class="ltx_Math" alttext="{\tt 1}\bar{u}" display="inline" intent=":literal"><semantics><mrow><mn>𝟷</mn><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>u</mi><mo>¯</mo></mover></mrow><annotation encoding="application/x-tex">{\tt 1}\bar{u}</annotation></semantics></math> are such that <math id="S2.SS2.p1.m9" class="ltx_Math" alttext="\Delta({\tt 0}u)=\Delta({\tt 1}\bar{u})=v" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>𝟶</mn><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>𝟷</mn><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>u</mi><mo>¯</mo></mover></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>v</mi></mrow><annotation encoding="application/x-tex">\Delta({\tt 0}u)=\Delta({\tt 1}\bar{u})=v</annotation></semantics></math> (recall that the bit-wise complementation morphism <math id="S2.SS2.p1.m10" class="ltx_Math" alttext="\bar{\cdot}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>⋅</mo><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{\cdot}</annotation></semantics></math> was defined at the end of <a href="#S1.SS3" title="1.3 The base 3/2 and the corresponding Thue–Morse word ‣ 1 Introduction ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">1.3</span></a>), then we only have information about the combined frequencies</p>
<table id="S2.Ex42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex42.m1" class="ltx_Math" alttext="\lim_{N\to\infty}\frac{|\mathbf{t}_{3/2}[0,N)|_{{\tt 0}u}+|\mathbf{t}_{3/2}[0,N)|_{{\tt 1}\bar{u}}}{N}=\freq_{\Delta(\mathbf{t}_{3/2})}(v)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>N</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mfrac><mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐭</mi><msub><mrow></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi>N</mi><mo stretchy="false">)</mo><mo fence="false" stretchy="false">|</mo><msub><mrow></mrow><mrow><mn>𝟶</mn><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow></msub><mo lspace="0em" rspace="0em">+</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐭</mi><msub><mrow></mrow><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi>N</mi><mo stretchy="false">)</mo><mo fence="false" stretchy="false">|</mo><msub><mrow></mrow><mrow><mn>𝟷</mn><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>u</mi><mo>¯</mo></mover></mrow></msub></mrow><mi>N</mi></mfrac></mrow><mo>=</mo><mrow><msub><mi>freq</mi><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lim_{N\to\infty}\frac{|\mathbf{t}_{3/2}[0,N)|_{{\tt 0}u}+|\mathbf{t}_{3/2}[0,N)|_{{\tt 1}\bar{u}}}{N}=\freq_{\Delta(\mathbf{t}_{3/2})}(v).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS2.p1.4" class="ltx_p">Nonetheless, the structure of <math id="S2.SS2.p1.m11" class="ltx_Math" alttext="\Delta(\mathbf{t}_{3/2})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta(\mathbf{t}_{3/2})</annotation></semantics></math> allows us to deduce various combinatorial properties of <math id="S2.SS2.p1.m12" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math>, as we show next.</p>
</div>
<section id="S2.SS2.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Uniform recurrence.</h4>

<div id="S2.SS2.SSS0.Px1.p1" class="ltx_para">
<p id="S2.SS2.SSS0.Px1.p1.1" class="ltx_p">First, we prove with <a href="#Thmtheorem13" title="Corollary 13. ‣ Uniform recurrence. ‣ 2.2 From the sequence Δ(𝐭_{3/2}) back to the original sequence 𝐭_{3/2} ‣ 2 Combinatorial properties of 𝐭_{3/2} and 𝐭^′ ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Corollary</span> <span class="ltx_text ltx_ref_tag">13</span></a> that both words <math id="S2.SS2.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> and <math id="S2.SS2.SSS0.Px1.p1.m2" class="ltx_Math" alttext="\mathbf{t}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝐭</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathbf{t}^{\prime}</annotation></semantics></math> are uniformly recurrent as a particular case of <a href="#Thmtheorem8" title="Proposition 8 ([, Sec. 2]). ‣ 2.1 On the sequence of first differences ‣ 2 Combinatorial properties of 𝐭_{3/2} and 𝐭^′ ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">8</span></a> and the next result.</p>
</div>
<div id="Thmtheorem12" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem12.2" class="ltx_text ltx_font_bold">Proposition 12</span></span><span id="Thmtheorem12.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem12.p1" class="ltx_para">
<p id="Thmtheorem12.p1.1" class="ltx_p"><span id="Thmtheorem12.p1.1.1" class="ltx_text ltx_font_italic">The binary word <math id="Thmtheorem12.p1.m1" class="ltx_Math" alttext="\mathbf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\mathbf{x}</annotation></semantics></math> is uniformly recurrent if and only if the first difference sequence <math id="Thmtheorem12.p1.m2" class="ltx_Math" alttext="\Delta(\mathbf{x})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta(\mathbf{x})</annotation></semantics></math> of <math id="Thmtheorem12.p1.m3" class="ltx_Math" alttext="\mathbf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\mathbf{x}</annotation></semantics></math> is uniformly recurrent.</span></p>
</div>
</div>
<div id="S2.SS2.SSS0.Px1.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S2.SS2.SSS0.Px1.p2" class="ltx_para">
<p id="S2.SS2.SSS0.Px1.p2.1" class="ltx_p"><span id="S2.SS2.SSS0.Px1.p2.1.1" class="ltx_text">For the sake of readability, set <math id="S2.SS2.SSS0.Px1.p2.m1" class="ltx_Math" alttext="\mathbf{y}=\Delta(\mathbf{x})" display="inline" intent=":literal"><semantics><mrow><mi>𝐲</mi><mo>=</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{y}=\Delta(\mathbf{x})</annotation></semantics></math>.</span></p>
</div>
<div id="S2.SS2.SSS0.Px1.p3" class="ltx_para">
<p id="S2.SS2.SSS0.Px1.p3.1" class="ltx_p"><span id="S2.SS2.SSS0.Px1.p3.1.1" class="ltx_text">First assume that <math id="S2.SS2.SSS0.Px1.p3.m1" class="ltx_Math" alttext="\mathbf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\mathbf{x}</annotation></semantics></math> is uniformly recurrent.
Take a factor <math id="S2.SS2.SSS0.Px1.p3.m2" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> of <math id="S2.SS2.SSS0.Px1.p3.m3" class="ltx_Math" alttext="\mathbf{y}" display="inline" intent=":literal"><semantics><mi>𝐲</mi><annotation encoding="application/x-tex">\mathbf{y}</annotation></semantics></math>.
Then there exists a factor <math id="S2.SS2.SSS0.Px1.p3.m4" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> of <math id="S2.SS2.SSS0.Px1.p3.m5" class="ltx_Math" alttext="\mathbf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\mathbf{x}</annotation></semantics></math> such that <math id="S2.SS2.SSS0.Px1.p3.m6" class="ltx_Math" alttext="\Delta(u)=v" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>v</mi></mrow><annotation encoding="application/x-tex">\Delta(u)=v</annotation></semantics></math>.
By assumption, <math id="S2.SS2.SSS0.Px1.p3.m7" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> occurs in <math id="S2.SS2.SSS0.Px1.p3.m8" class="ltx_Math" alttext="\mathbf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\mathbf{x}</annotation></semantics></math> with bounded gaps, so does <math id="S2.SS2.SSS0.Px1.p3.m9" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> in <math id="S2.SS2.SSS0.Px1.p3.m10" class="ltx_Math" alttext="\mathbf{y}" display="inline" intent=":literal"><semantics><mi>𝐲</mi><annotation encoding="application/x-tex">\mathbf{y}</annotation></semantics></math>, which is enough.</span></p>
</div>
<div id="S2.SS2.SSS0.Px1.p4" class="ltx_para">
<p id="S2.SS2.SSS0.Px1.p4.1" class="ltx_p"><span id="S2.SS2.SSS0.Px1.p4.1.1" class="ltx_text">Conversely, assume that <math id="S2.SS2.SSS0.Px1.p4.m1" class="ltx_Math" alttext="\mathbf{y}" display="inline" intent=":literal"><semantics><mi>𝐲</mi><annotation encoding="application/x-tex">\mathbf{y}</annotation></semantics></math> is uniformly recurrent.
Take a factor <math id="S2.SS2.SSS0.Px1.p4.m2" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> of <math id="S2.SS2.SSS0.Px1.p4.m3" class="ltx_Math" alttext="\mathbf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\mathbf{x}</annotation></semantics></math>.
We consider two cases depending on whether the complement of <math id="S2.SS2.SSS0.Px1.p4.m4" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> is a factor of <math id="S2.SS2.SSS0.Px1.p4.m5" class="ltx_Math" alttext="\mathbf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\mathbf{x}</annotation></semantics></math> or not.</span></p>
</div>
<div id="S2.SS2.SSS0.Px1.p5" class="ltx_para">
<p id="S2.SS2.SSS0.Px1.p5.1" class="ltx_p"><span id="S2.SS2.SSS0.Px1.p5.1.1" class="ltx_text ltx_font_bold">Case 1.<span id="S2.SS2.SSS0.Px1.p5.1.1.1" class="ltx_text ltx_font_medium"> If <math id="S2.SS2.SSS0.Px1.p5.m1" class="ltx_Math" alttext="\bar{u}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>u</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{u}</annotation></semantics></math> is not a factor of <math id="S2.SS2.SSS0.Px1.p5.m2" class="ltx_Math" alttext="\mathbf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\mathbf{x}</annotation></semantics></math>, then each occurrence of <math id="S2.SS2.SSS0.Px1.p5.m3" class="ltx_Math" alttext="\Delta(u)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta(u)</annotation></semantics></math> in <math id="S2.SS2.SSS0.Px1.p5.m4" class="ltx_Math" alttext="\mathbf{y}" display="inline" intent=":literal"><semantics><mi>𝐲</mi><annotation encoding="application/x-tex">\mathbf{y}</annotation></semantics></math> corresponds to an occurrence of <math id="S2.SS2.SSS0.Px1.p5.m5" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> in <math id="S2.SS2.SSS0.Px1.p5.m6" class="ltx_Math" alttext="\mathbf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\mathbf{x}</annotation></semantics></math>.
Since <math id="S2.SS2.SSS0.Px1.p5.m7" class="ltx_Math" alttext="\Delta(u)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta(u)</annotation></semantics></math> occurs with bounded gaps, we may conclude.</span></span></p>
</div>
<div id="S2.SS2.SSS0.Px1.p6" class="ltx_para">
<p id="S2.SS2.SSS0.Px1.p6.1" class="ltx_p"><span id="S2.SS2.SSS0.Px1.p6.1.1" class="ltx_text ltx_font_bold">Case 2.<span id="S2.SS2.SSS0.Px1.p6.1.1.1" class="ltx_text ltx_font_medium"> Next suppose that <math id="S2.SS2.SSS0.Px1.p6.m1" class="ltx_Math" alttext="\bar{u}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>u</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{u}</annotation></semantics></math> is a factor of <math id="S2.SS2.SSS0.Px1.p6.m2" class="ltx_Math" alttext="\mathbf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\mathbf{x}</annotation></semantics></math> and consider a factor <math id="S2.SS2.SSS0.Px1.p6.m3" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> containing both <math id="S2.SS2.SSS0.Px1.p6.m4" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> and <math id="S2.SS2.SSS0.Px1.p6.m5" class="ltx_Math" alttext="\bar{u}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>u</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{u}</annotation></semantics></math> in <math id="S2.SS2.SSS0.Px1.p6.m6" class="ltx_Math" alttext="\mathbf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\mathbf{x}</annotation></semantics></math>.
Now <math id="S2.SS2.SSS0.Px1.p6.m7" class="ltx_Math" alttext="\Delta(w)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta(w)</annotation></semantics></math> occurs with bounded gaps in <math id="S2.SS2.SSS0.Px1.p6.m8" class="ltx_Math" alttext="\mathbf{y}" display="inline" intent=":literal"><semantics><mi>𝐲</mi><annotation encoding="application/x-tex">\mathbf{y}</annotation></semantics></math>, then <math id="S2.SS2.SSS0.Px1.p6.m9" class="ltx_Math" alttext="\{w,\bar{w}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mi>w</mi><mo>,</mo><mover accent="true"><mi>w</mi><mo>¯</mo></mover><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{w,\bar{w}\}</annotation></semantics></math> occurs with bounded gaps in <math id="S2.SS2.SSS0.Px1.p6.m10" class="ltx_Math" alttext="\mathbf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\mathbf{x}</annotation></semantics></math>.
Since both <math id="S2.SS2.SSS0.Px1.p6.m11" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> and <math id="S2.SS2.SSS0.Px1.p6.m12" class="ltx_Math" alttext="\bar{w}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>w</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{w}</annotation></semantics></math> contain <math id="S2.SS2.SSS0.Px1.p6.m13" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> as a factor (because <math id="S2.SS2.SSS0.Px1.p6.m14" class="ltx_Math" alttext="\bar{\bar{u}}=u" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mo>¯</mo></mover><mo>=</mo><mi>u</mi></mrow><annotation encoding="application/x-tex">\bar{\bar{u}}=u</annotation></semantics></math>), then <math id="S2.SS2.SSS0.Px1.p6.m15" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> occurs with bounded gaps in <math id="S2.SS2.SSS0.Px1.p6.m16" class="ltx_Math" alttext="\mathbf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\mathbf{x}</annotation></semantics></math>.
∎</span></span></p>
</div>
</div>
<div id="Thmtheorem13" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem13.2" class="ltx_text ltx_font_bold">Corollary 13</span></span><span id="Thmtheorem13.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem13.p1" class="ltx_para">
<p id="Thmtheorem13.p1.1" class="ltx_p"><span id="Thmtheorem13.p1.1.1" class="ltx_text ltx_font_italic">The sequences <math id="Thmtheorem13.p1.m1" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> and <math id="Thmtheorem13.p1.m2" class="ltx_Math" alttext="\mathbf{t}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝐭</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathbf{t}^{\prime}</annotation></semantics></math> are uniformly recurrent.</span></p>
</div>
</div>
<div id="S2.SS2.SSS0.Px1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S2.SS2.SSS0.Px1.p7" class="ltx_para">
<p id="S2.SS2.SSS0.Px1.p7.1" class="ltx_p"><span id="S2.SS2.SSS0.Px1.p7.1.1" class="ltx_text">By <a href="#Thmtheorem11" title="Proposition 11. ‣ 2.1 On the sequence of first differences ‣ 2 Combinatorial properties of 𝐭_{3/2} and 𝐭^′ ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">11</span></a>, <math id="S2.SS2.SSS0.Px1.p7.m1" class="ltx_Math" alttext="\Delta(\mathbf{t}_{3/2})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta(\mathbf{t}_{3/2})</annotation></semantics></math> is a Toeplitz word.
Since Toeplitz words are uniformly recurrent (see <a href="#Thmtheorem8" title="Proposition 8 ([, Sec. 2]). ‣ 2.1 On the sequence of first differences ‣ 2 Combinatorial properties of 𝐭_{3/2} and 𝐭^′ ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">8</span></a>), so is <math id="S2.SS2.SSS0.Px1.p7.m2" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> by the previous proposition.
Uniform recurrence of <math id="S2.SS2.SSS0.Px1.p7.m3" class="ltx_Math" alttext="\mathbf{t}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>𝐭</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathbf{t}^{\prime}</annotation></semantics></math> follows from <a href="#Thmtheorem4" title="Lemma 4. ‣ 1.4 Dekking’s variation ‣ 1 Introduction ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">4</span></a>.
∎</span></p>
</div>
</div>
</section>
<section id="S2.SS2.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Occurences at odd and even positions.</h4>

<div id="S2.SS2.SSS0.Px2.p1" class="ltx_para">
<p id="S2.SS2.SSS0.Px2.p1.1" class="ltx_p">The next result tracks the positions of factors in <math id="S2.SS2.SSS0.Px2.p1.m1" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math>.
It is crucial in the proof of our closure results, namely <a href="#Thmtheorem15" title="Proposition 15. ‣ Bit-wise complement. ‣ 2.2 From the sequence Δ(𝐭_{3/2}) back to the original sequence 𝐭_{3/2} ‣ 2 Combinatorial properties of 𝐭_{3/2} and 𝐭^′ ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Propositions</span> <span class="ltx_text ltx_ref_tag">15</span></a> and <a href="#Thmtheorem17" title="Proposition 17. ‣ Reversal. ‣ 2.2 From the sequence Δ(𝐭_{3/2}) back to the original sequence 𝐭_{3/2} ‣ 2 Combinatorial properties of 𝐭_{3/2} and 𝐭^′ ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>.
The main technical step is to show that for every <math id="S2.SS2.SSS0.Px2.p1.m2" class="ltx_Math" alttext="n\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n\geq 0</annotation></semantics></math> and every residue class modulo <math id="S2.SS2.SSS0.Px2.p1.m3" class="ltx_Math" alttext="2^{n}" display="inline" intent=":literal"><semantics><msup><mn>2</mn><mi>n</mi></msup><annotation encoding="application/x-tex">2^{n}</annotation></semantics></math>,
both letters in <math id="S2.SS2.SSS0.Px2.p1.m4" class="ltx_Math" alttext="\{{\tt 0},{\tt 1}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mn>𝟶</mn><mo>,</mo><mn>𝟷</mn><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{{\tt 0},{\tt 1}\}</annotation></semantics></math> occur in <math id="S2.SS2.SSS0.Px2.p1.m5" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> at positions in that class.
We observe that this also follows from <a href="#Thmtheorem18" title="Theorem 18. ‣ 3 Frequencies of letters in 𝐭_{3/2} ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">18</span></a>, which establishes the stronger fact
that the occurrences of each letter in <math id="S2.SS2.SSS0.Px2.p1.m6" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> is equidistributed among the <math id="S2.SS2.SSS0.Px2.p1.m7" class="ltx_Math" alttext="2^{n}" display="inline" intent=":literal"><semantics><msup><mn>2</mn><mi>n</mi></msup><annotation encoding="application/x-tex">2^{n}</annotation></semantics></math> residue classes.</p>
</div>
<div id="Thmtheorem14" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem14.2" class="ltx_text ltx_font_bold">Proposition 14</span></span><span id="Thmtheorem14.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem14.p1" class="ltx_para">
<p id="Thmtheorem14.p1.1" class="ltx_p"><span id="Thmtheorem14.p1.1.1" class="ltx_text ltx_font_italic">If a word occurs in <math id="Thmtheorem14.p1.m1" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math>, then it occurs at both even and odd positions in <math id="Thmtheorem14.p1.m2" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S2.SS2.SSS0.Px2.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S2.SS2.SSS0.Px2.p2" class="ltx_para">
<p id="S2.SS2.SSS0.Px2.p2.1" class="ltx_p"><span id="S2.SS2.SSS0.Px2.p2.1.1" class="ltx_text">Write <math id="S2.SS2.SSS0.Px2.p2.m1" class="ltx_Math" alttext="\mathbf{t}_{3/2}=(t_{n})_{n\geq 0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbf{t}_{3/2}=(t_{n})_{n\geq 0}</annotation></semantics></math> and recall that <math id="S2.SS2.SSS0.Px2.p2.m2" class="ltx_math_unparsed" alttext="\mathbf{t}_{3/2}[0,j)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{t}_{3/2}[0,j)</annotation></semantics></math> is the prefix of <math id="S2.SS2.SSS0.Px2.p2.m3" class="ltx_Math" alttext="\mathbf{t}_{3/2}" display="inline" intent=":literal"><semantics><msub><mi>𝐭</mi><mrow><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\mathbf{t}_{3/2}</annotation></semantics></math> of length <math id="S2.SS2.SSS0.Px2.p2.m4" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>.
In particular, for <math id="S2.SS2.SSS0.Px2.p2.m5" class="ltx_Math" alttext="j=0" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">j=0</annotation></semantics></math>, this is the empty prefix.
From the morphisms <math id="S2.SS2.SSS0.Px2.p2.m6" class="ltx_Math" alttext="f_{0}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>0</mn></msub><annotation encoding="application/x-tex">f_{0}</annotation></semantics></math> and <math id="S2.SS2.SSS0.Px2.p2.m7" class="ltx_Math" alttext="f_{1}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>1</mn></msub><annotation encoding="application/x-tex">f_{1}</annotation></semantics></math> of (<a href="#S1.E4" title="Equation 4 ‣ Definition 3 (Our sequence of interest). ‣ 1.3 The base 3/2 and the corresponding Thue–Morse word ‣ 1 Introduction ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>) and the <math id="S2.SS2.SSS0.Px2.p2.m8" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-block substitution <math id="S2.SS2.SSS0.Px2.p2.m9" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> of (<a href="#S1.E5" title="Equation 5 ‣ Definition 3 (Our sequence of interest). ‣ 1.3 The base 3/2 and the corresponding Thue–Morse word ‣ 1 Introduction ‣ Symbols frequencies in the Thue–Morse word in base 3/2 and related conjectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>), we define the map <math id="S2.SS2.SSS0.Px2.p2.m10" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> by</span></p>
<table id="S2.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S2.Ex43"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex43.m1" class="ltx_Math" alttext="\displaystyle\Phi(a)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Phi(a)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex43.m2" class="ltx_Math" alttext="\displaystyle=f_{0}(a),\quad a\in\{{\tt 0},{\tt 1}\}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>f</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>a</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>𝟶</mn><mo>,</mo><mn>𝟷</mn><mo stretchy="false">}</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=f_{0}(a),\quad a\in\{{\tt 0},{\tt 1}\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex44"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex44.m1" class="ltx_math_unparsed" alttext="\displaystyle\Phi(t_{0}\cdots t_{2j-1})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>t</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Phi(t_{0}\cdots t_{2j-1})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex44.m2" class="ltx_math_unparsed" alttext="\displaystyle=\tau(t_{0}t_{1})\cdots\tau(t_{2j-2}t_{2j-1}),\quad j\geq 1," display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>τ</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><msub><mi>t</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">⋯</mo><mi>τ</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>−</mo><mn>2</mn></mrow></msub><msub><mi>t</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo rspace="1.167em">,</mo><mi>j</mi><mo>≥</mo><mn>1</mn><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\tau(t_{0}t_{1})\cdots\tau(t_{2j-2}t_{2j-1}),\quad j\geq 1,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex45"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.Ex45.m1" class="ltx_math_unparsed" alttext="\displaystyle\Phi(t_{0}\cdots t_{2j})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">⋯</mo><msub><mi>t</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Phi(t_{0}\cdots t_{2j})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex45.m2" class="ltx_math_unparsed" alttext="\displaystyle=\tau(t_{0}t_{1})\cdots\tau(t_{2j-2}t_{2j-1})f_{0}(t_{2j}),\quad j\geq 1." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>τ</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>0</mn></msub><msub><mi>t</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">⋯</mo><mi>τ</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>−</mo><mn>2</mn></mrow></msub><msub><mi>t</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><msub><mi>f</mi><mn>0</mn></msub><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo rspace="1.167em">,</mo><mi>j</mi><mo>≥</mo><mn>1</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\tau(t_{0}t_{1})\cdots\tau(t_{2j-2}t_{2j-1})f_{0}(t_{2j}),\quad j\geq 1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
