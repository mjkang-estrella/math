<div id="recordCitation" data-record-links='{"access": "https://zenodo.org/api/records/23401221/access", "access_grants": "https://zenodo.org/api/records/23401221/access/grants", "access_links": "https://zenodo.org/api/records/23401221/access/links", "access_request": "https://zenodo.org/api/records/23401221/access/request", "access_users": "https://zenodo.org/api/records/23401221/access/users", "communities": "https://zenodo.org/api/records/23401221/communities", "communities-suggestions": "https://zenodo.org/api/records/23401221/communities-suggestions", "doi": "https://doi.org/10.5281/zenodo.23401221", "draft": "https://zenodo.org/api/records/23401221/draft", "file_modification": "https://zenodo.org/api/records/23401221/file-modification", "files": "https://zenodo.org/api/records/23401221/files", "latest": "https://zenodo.org/api/records/23401221/versions/latest", "latest_html": "https://zenodo.org/records/23401221/latest", "media_files": "https://zenodo.org/api/records/23401221/media-files", "parent": "https://zenodo.org/api/records/23401220", "parent_doi": "https://doi.org/10.5281/zenodo.23401220", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23401220", "parent_html": "https://zenodo.org/records/23401220", "preview_html": "https://zenodo.org/records/23401221?preview=1", "quota_increase": "https://zenodo.org/api/records/23401221/quota-increase", "request_deletion": "https://zenodo.org/api/records/23401221/request-deletion", "requests": "https://zenodo.org/api/records/23401221/requests", "reserve_doi": "https://zenodo.org/api/records/23401221/draft/pids/doi", "self": "https://zenodo.org/api/records/23401221", "self_doi": "https://doi.org/10.5281/zenodo.23401221", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23401221", "self_html": "https://zenodo.org/records/23401221", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23401221/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23401221/sequence/default", "thumbnai