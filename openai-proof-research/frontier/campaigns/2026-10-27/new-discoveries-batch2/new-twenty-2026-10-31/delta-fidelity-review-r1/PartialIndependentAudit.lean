open Lean in
run_cmd do
  let env ← getEnv
  let names := (← IO.FS.readFile "import-order.txt").splitOn "\n"
  let mut count := 0
  for (name, info) in env.constants.toList do
    let source := match env.getModuleIdxFor? name with
      | some idx => (env.header.moduleNames[idx.toNat]!).toString
      | none => env.mainModule.toString
    if names.contains source then
      count := count + 1
      if info.isUnsafe || info.isPartial || (Lean.Compiler.getImplementedBy? env name).isSome ||
          (Lean.getExternAttrData? env name).isSome || (name.toString.splitOn "_unsafe_rec").length > 1 then
        throwError "Rejected metadata {name} ({source})"
      match info with
      | .axiomInfo _ => throwError "Added axiom {name}"
      | _ => pure ()
  logInfo m!"Independent metadata audit: {count} declarations clean"
#print axioms Round2.conditional_negation
