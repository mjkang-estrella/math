<mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">g(\sigma(j))\geq g(\sigma(j^{\prime\prime}))+w(\sigma(j^{\prime\prime}),\sigma(j))=\ell(\sigma(j^{\prime\prime}))+\ell(\sigma(j))-\ell(\sigma(j^{\prime\prime}))=\ell(\sigma(j)).</annotation></semantics></math></td>
