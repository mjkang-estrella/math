#!/bin/bash
set -u
export MALLOC_ARENA_MAX=2 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=2
cpus=$(awk '/Cpus_allowed_list/ {print $2}' /proc/self/status)
first=$(echo "$cpus" | cut -d, -f1 | cut -d- -f1)
second=$((first+1))
ulimit -t 120
ulimit -c 0
timeout -k 2 140 taskset -c "$first,$second" "$@" &
pid=$!
while kill -0 "$pid" 2>/dev/null; do
 rss=$(ps -eo pid=,ppid=,rss= | awk -v root="$pid" '{p[$1]=$2;r[$1]=$3} END {sum=0;for(i in p){j=i;for(k=0;k<20&&j>1;k++){if(j==root){sum+=r[i];break}j=p[j]}}print sum}')
 if [ "${rss:-0}" -gt 6291456 ]; then pkill -KILL -P "$pid"; kill -KILL "$pid"; echo RSS_CAP >&2; break; fi
 sleep .1
done
wait "$pid"
