#!/bin/bash
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export TMPDIR="$ROOT/tmp" TEMP="$ROOT/tmp" TMP="$ROOT/tmp" XDG_CACHE_HOME="$ROOT/cache" PYTHONPYCACHEPREFIX="$ROOT/cache" MALLOC_ARENA_MAX=2
export PATH="/home/mj-kang/Documents/Dev/math/dlp-research/.tools/lean-4.34.1-linux/bin:$PATH"
setsid taskset -c 0,1 prlimit --cpu=120 -- timeout --signal=KILL 140 "$@" &
p=$!
(
 while kill -0 "$p" 2>/dev/null; do
  rss=$(ps -eo pgid=,rss= | awk -v p="$p" '$1==p{s+=$2}END{print s+0}')
  if [ "$rss" -gt 6291456 ]; then echo "RSS limit exceeded: $rss" >&2; kill -KILL -- "-$p"; break; fi
  sleep 0.1
 done
) &
w=$!
wait "$p"
r=$?
kill "$w" 2>/dev/null
wait "$w" 2>/dev/null
exit "$r"
