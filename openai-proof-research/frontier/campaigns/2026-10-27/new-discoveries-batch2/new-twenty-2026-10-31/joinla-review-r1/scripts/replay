#!/bin/bash
set -eu
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
P=/home/mj-kang/Documents/Dev/math/openai-proof-research/frontier/campaigns/2026-10-14/formal/.lake/packages
export LEAN_PATH="$ROOT/replay/lean"
for pkg in "$P"/*; do LEAN_PATH="$LEAN_PATH:$pkg/.lake/build/lib/lean"; done
export LEAN_PATH
cd "$ROOT"
case "$1" in
 build) exec "$ROOT/scripts/run" /home/mj-kang/Documents/Dev/math/dlp-research/.tools/lean-4.34.1-linux/bin/lean -M3500 -DwarningAsError=true "$ROOT/replay/lean/$2.lean" -o "$ROOT/replay/lean/$2.olean";;
 check) exec "$ROOT/scripts/run" /home/mj-kang/Documents/Dev/math/dlp-research/.tools/lean-4.34.1-linux/bin/leanchecker "$2";;
esac
