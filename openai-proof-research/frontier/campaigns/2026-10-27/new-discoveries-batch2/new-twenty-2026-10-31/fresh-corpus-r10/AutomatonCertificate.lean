def adj (es : List (Nat × Nat)) (u v : Nat) : Bool := es.any (fun e => (e.1 == u && e.2 == v) || (e.1 == v && e.2 == u))
def states (es : List (Nat × Nat)) : List (List Nat) := [[]] ++ (List.range 19).map (fun v => [v]) ++ es.map (fun e => [min e.1 e.2, max e.1 e.2])
def indexOf (s : List Nat) : List (List Nat) → Nat
  | [] => 0
  | t :: ts => if s == t then 0 else indexOf s ts + 1
def ins (v : Nat) : List Nat → List Nat
  | [] => [v]
  | u :: us => if v ≤ u then v :: u :: us else u :: ins v us
def transitions (es : List (Nat × Nat)) : List (List Nat) := (states es).map fun s => (List.range 19).filterMap fun v => if v ∈ s then none else some (indexOf (ins v (s.filter (fun u => adj es u v))) (states es))
def step (ts : List (List Nat)) (a : List Nat) : List Nat := (List.range ts.length).map fun j => ((ts.zip a).map fun p => p.2 * (p.1.filter (· == j)).length).sum
def count (es : List (Nat × Nat)) (k : Nat) : List Nat := Nat.rec (1 :: List.replicate 37 0) (fun _ a => step (transitions es) a) k
