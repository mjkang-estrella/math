                                        <h2 class="accordion-header" id="productDetailInfoAccordionHeading">
                                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#productDetailInfoAccordionContent" aria-expanded="false" aria-controls="productDetailInfoAccordionContent">
