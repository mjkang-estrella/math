@article{JoswigSchröter,
    title = {Matroids from hypersimplex splits},
    journal = {Journal of Combinatorial Theory, Series A},
    volume = {151},
    pages = {254-284},
    year = {2017},
    issn = {0097-3165},
    author = {Michael Joswig and Benjamin Schröter},
    keywords = {Matroid polytope, Tropical Grassmannian, Dressian},
    abstract = {A class of matroids is introduced which is very large as it strictly contains all paving matroids as special cases. As their key feature these split matroids can be studied via techniques from polyhedral geometry. It turns out that the structural properties of the split matroids can be exploited to obtain new results in tropical geometry, especially on the rays of the tropical Grassmannians.}
}

