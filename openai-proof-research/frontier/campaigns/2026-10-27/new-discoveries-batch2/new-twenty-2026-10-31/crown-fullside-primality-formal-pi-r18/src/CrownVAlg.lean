import Mathlib.Algebra.MvPolynomial.CommRing
import Mathlib.RingTheory.MvPolynomial.Homogeneous
import Mathlib.RingTheory.Ideal.Colon
import CrownVSide

/-!
The crown binomial edge ideal setting.

`PolyRing n K = MvPolynomial (V n × Bool) K`: for each crown vertex `v` two
variables, `(v, true)` is `x_v` and `(v, false)` is `y_v` (source `S = K[x_v, y_v]`).

`J n K` is the actual binomial edge ideal, generated by the minors
`[u,v] = x_u y_v - x_v y_u` over the actual crown edges.

`Pc n K T` is the source prime attached to a vertex set `T`: the ideal generated by
both coordinates of every `v ∈ T` together with every edge minor `[u,w]` whose
endpoints `u, w ∉ T` are path-connected inside `V ∖ T` (one completed component
of `G - T`).

Element colons are `Submodule.colon`.  `ExactColon f P` is the source condition
`(J : f) = P`; `VWitD d P` says some nonzero homogeneous polynomial of ordinary
total degree `d` has exact colon `P`; `VIs P m` is the source local v-number
statement `v_P(J) = m`: attained at `m`, and no `d < m` is attained, over nonzero
homogeneous polynomials (`d ≥ 0` implicit in ℕ).
-/

namespace CrownV

open MvPolynomial

section Ring

variable {n : ℕ} {K : Type*} [CommRing K]

/-- The polynomial ring `K[x_v, y_v : v ∈ V n]`. -/
abbrev PolyRing (n : ℕ) (K : Type*) [CommRing K] := MvPolynomial (V n × Bool) K

/-- The variable `x_v`. -/
noncomputable abbrev xx (v : V n) : PolyRing n K := X (v, true)

/-- The variable `y_v`. -/
noncomputable abbrev yy (v : V n) : PolyRing n K := X (v, false)

/-- The edge minor `[u,v] = x_u y_v - x_v y_u`. -/
noncomputable def minor (u v : V n) : PolyRing n K := xx u * yy v - xx v * yy u

/-- The crown edge predicate. -/
def isEdge (p : V n × V n) : Prop := sideX p.1 ∧ sideY p.2 ∧ vidx p.1 ≠ vidx p.2

open Classical in
/-- The crown edge set: pairs `(u, v)`, `u` on `X`, `v` on `Y`, unequal indices. -/
noncomputable def edgeFinset (n : ℕ) : Finset (V n × V n) :=
  (Finset.product (Finset.univ : Finset (V n)) (Finset.univ : Finset (V n))).filter
    fun p : V n × V n => sideX p.1 ∧ sideY p.2 ∧ vidx p.1 ≠ vidx p.2

open Classical in
theorem mem_edgeFinset {n : ℕ} {p : V n × V n} :
    p ∈ edgeFinset n ↔ sideX p.1 ∧ sideY p.2 ∧ vidx p.1 ≠ vidx p.2 := by
  constructor
  · intro h
    obtain ⟨hprod, hpred⟩ := Finset.mem_filter.1 h
    rcases hpred with ⟨hx, hy, hne⟩
    exact ⟨hx, hy, hne⟩
  · intro h
    obtain ⟨hx, hy, hne⟩ := h
    exact Finset.mem_filter.2 ⟨Finset.mem_product.2 ⟨Finset.mem_univ _, Finset.mem_univ _⟩,
      ⟨hx, hy, hne⟩⟩

/-- The set of edge minors `[u,v]` over crown edges. -/
def edgeMinorSet (n : ℕ) : Set (PolyRing n K) :=
  {g | ∃ u v, sideX u ∧ sideY v ∧ vidx u ≠ vidx v ∧ g = minor u v}

/-- The binomial edge ideal `J = ([u,v] : crown edge u v)`. -/
noncomputable def J (n : ℕ) (K : Type*) [CommRing K] : Ideal (PolyRing n K) :=
  Ideal.span (edgeMinorSet n)

theorem minor_mem_J {n : ℕ} {K : Type*} [CommRing K] {u v : V n}
    (hu : sideX u) (hv : sideY v) (hne : vidx u ≠ vidx v) : minor u v ∈ J n K := by
  have hmem : (minor (n := n) (K := K) u v : PolyRing n K) ∈ edgeMinorSet n :=
    ⟨u, v, hu, hv, hne, rfl⟩
  exact Submodule.mem_span_of_mem hmem

/-- Edge recognition: opposite sides with unequal indices is an edge. -/
theorem minor_mem_J_of_cadj {n : ℕ} {K : Type*} [CommRing K] {u v : V n} (h : cadj u v) :
    minor u v ∈ J n K := by
  rcases h.2 with ⟨h1, h2⟩ | ⟨h1, h2⟩
  · exact minor_mem_J h1 h2 h.1
  · have hne' : vidx v ≠ vidx u := Ne.symm h.1
    have hvu : minor v u ∈ J n K := minor_mem_J h2 h1 hne'
    have heq : (minor u v : PolyRing n K) = -(minor v u) := by
      show xx u * yy v - xx v * yy u = -(xx v * yy u - xx u * yy v)
      ring
    rw [heq]
    exact (Ideal.neg_mem_iff (J n K)).2 hvu

end Ring

section CutPrime

variable {n : ℕ} {K : Type*} [CommRing K]

/-- Coordinate generators: `x_v` and `y_v` for `v ∈ T`. -/
def coordGens (T : Finset (V n)) : Set (PolyRing n K) :=
  {p | ∃ v ∈ T, p = xx v ∨ p = yy v}

/-- Completed-component minors: `[u,w]` with `u, w ∉ T` path-connected in `V ∖ T`. -/
def compMinors (T : Finset (V n)) : Set (PolyRing n K) :=
  {g | ∃ u w, u ∉ T ∧ w ∉ T ∧ SameC (Finset.univ \ T) u w ∧ g = minor u w}

/-- The source prime `P_T` attached to the cut set `T`: coordinates of `T` plus
completed-component minors of `G - T`. -/
noncomputable def Pc (T : Finset (V n)) : Ideal (PolyRing n K) :=
  Ideal.span (coordGens T ∪ compMinors T)

theorem xx_mem_Pc (T : Finset (V n)) {v : V n} (hv : v ∈ T) :
    (xx v : PolyRing n K) ∈ Pc T := by
  refine Submodule.mem_span_of_mem (Set.mem_union_left (compMinors T) ?_)
  exact ⟨v, hv, Or.inl rfl⟩

theorem yy_mem_Pc (T : Finset (V n)) {v : V n} (hv : v ∈ T) :
    (yy v : PolyRing n K) ∈ Pc T := by
  refine Submodule.mem_span_of_mem (Set.mem_union_left (compMinors T) ?_)
  exact ⟨v, hv, Or.inr rfl⟩

theorem minor_mem_Pc {T : Finset (V n)} {u w : V n} (hu : u ∉ T) (hw : w ∉ T)
    (hconn : SameC (Finset.univ \ T) u w) : (minor u w : PolyRing n K) ∈ Pc T := by
  refine Submodule.mem_span_of_mem (Set.mem_union_right (coordGens T) ?_)
  exact ⟨u, w, hu, hw, hconn, rfl⟩

/-- A prime containing all generators of `Pc T` contains `Pc T`. -/
theorem Pc_le {T : Finset (V n)} {P : Ideal (PolyRing n K)}
    (hcoord : ∀ v ∈ T, xx v ∈ P ∧ yy v ∈ P)
    (hmin : ∀ u w, u ∉ T → w ∉ T → SameC (Finset.univ \ T) u w → minor u w ∈ P) :
    Pc T ≤ P := by
  refine Ideal.span_le.2 ?_
  rintro p (⟨v, hv, hp⟩ | ⟨u, w, hu, hw, hconn, hp⟩)
  · rcases hp with h | h
    · exact h ▸ (hcoord v hv).1
    · exact h ▸ (hcoord v hv).2
  · exact hp ▸ hmin u w hu hw hconn

end CutPrime

section Colon

variable {R : Type*} [CommRing R]

/-- Element colon `(I : f) = {g | g * f ∈ I}`, via `Submodule.colon`. -/
noncomputable def elcolon (I : Ideal R) (f : R) : Ideal R := I.colon ({f} : Set R)

theorem mem_elcolon {I : Ideal R} {f g : R} : g ∈ elcolon I f ↔ g * f ∈ I := by
  rw [elcolon, Submodule.mem_colon_singleton, smul_eq_mul]

theorem mem_elcolon_of_mem {I : Ideal R} {f g : R} (h : g * f ∈ I) : g ∈ elcolon I f :=
  mem_elcolon.2 h

end Colon

section Homog

variable {n : ℕ} {K : Type*} [CommRing K]

theorem thomog_X (p : V n × Bool) : IsHomogeneous (X p : PolyRing n K) 1 :=
  isWeightedHomogeneous_X K (1 : V n × Bool → ℕ) p

theorem thomog_mul {d e : ℕ} {f g : PolyRing n K}
    (hf : IsHomogeneous f d) (hg : IsHomogeneous g e) : IsHomogeneous (f * g) (d + e) :=
  IsWeightedHomogeneous.mul hf hg

theorem thomog_sub {d : ℕ} {f g : PolyRing n K}
    (hf : IsHomogeneous f d) (hg : IsHomogeneous g d) : IsHomogeneous (f - g) d :=
  (mem_homogeneousSubmodule d (f - g)).1
    (Submodule.sub_mem (homogeneousSubmodule (V n × Bool) K d)
      ((mem_homogeneousSubmodule d f).2 hf) ((mem_homogeneousSubmodule d g).2 hg))

theorem thomog_add {d : ℕ} {f g : PolyRing n K}
    (hf : IsHomogeneous f d) (hg : IsHomogeneous g d) : IsHomogeneous (f + g) d :=
  (homogeneousSubmodule (V n × Bool) K d).add_mem
    ((mem_homogeneousSubmodule d f).2 hf) ((mem_homogeneousSubmodule d g).2 hg)

theorem thomog_smul {d : ℕ} (c : K) {f : PolyRing n K} (hf : IsHomogeneous f d) :
    IsHomogeneous (c • f) d := by
  have h0 : f ∈ homogeneousSubmodule (V n × Bool) K d := (mem_homogeneousSubmodule d f).2 hf
  have h1 : c • f ∈ homogeneousSubmodule (V n × Bool) K d :=
    (homogeneousSubmodule (V n × Bool) K d).smul_mem c h0
  exact (mem_homogeneousSubmodule d (c • f)).1 h1

theorem thomog_minor (u v : V n) : IsHomogeneous (minor (n := n) (K := K) u v) 2 := by
  refine thomog_sub (d := 2) ?_ ?_
  · exact thomog_mul (thomog_X _) (thomog_X _)
  · exact thomog_mul (thomog_X _) (thomog_X _)

theorem thomog_totalDegree {d : ℕ} {f : PolyRing n K} (hf : IsHomogeneous f d) (h0 : f ≠ 0) :
    f.totalDegree = d := MvPolynomial.IsHomogeneous.totalDegree hf h0

end Homog

section VNumber

variable {n : ℕ} {K : Type*} [CommRing K]

/-- Exact colon: the source `(J : f) = P`. -/
def ExactColon (f : PolyRing n K) (P : Ideal (PolyRing n K)) : Prop :=
  elcolon (J n K) f = P

/-- Degree-`d` v-witness: a nonzero homogeneous polynomial of total degree `d`
whose exact colon is `P`. -/
def VWitD (d : ℕ) (P : Ideal (PolyRing n K)) : Prop :=
  ∃ f : PolyRing n K, f ≠ 0 ∧ IsHomogeneous f d ∧ ExactColon f P

/-- The source local v-number statement: `v_P(J) = m`. -/
def VIs (P : Ideal (PolyRing n K)) (m : ℕ) : Prop :=
  VWitD m P ∧ ∀ d < m, ¬ VWitD d P

end VNumber

end CrownV
