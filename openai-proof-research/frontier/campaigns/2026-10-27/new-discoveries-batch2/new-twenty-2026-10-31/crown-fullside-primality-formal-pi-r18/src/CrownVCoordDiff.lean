import CrownVCoordMap

/-!
# Crown variety: the coordinate difference lemma

For every polynomial `p : CrownV.PolyRing n K` and every finite vertex set
`T : Finset (CrownV.V n)`, the difference `p - CrownV.coordKill T p` lies in the
coordinate ideal `Ideal.span (CrownV.coordGens T)`.  The proof is by structural
induction on the polynomial ring generators: constants are fixed by
`coordKill T`, each variable `X (v, b)` differs from its image by a coordinate
generator (or not at all), and the difference predicate is preserved under
addition and under right multiplication by a variable.  No finiteness, primality
or side condition on `p` or `K` beyond `CommRing K` is used.

This module does NOT claim the kernel equality itself; that is a separate
obligation built on top of this lemma and the sealed forward inclusion.
-/

namespace CrownV

variable {n : Nat} {K : Type*} [CommRing K]

/-- The difference lemma: for arbitrary `p`, `p - coordKill T p` lies in the
ideal `Ideal.span (coordGens T)` generated by `xx v` and `yy v`, `v ∈ T`. -/
theorem coordKill_sub_mem_span (T : Finset (V n)) (p : PolyRing n K) :
    p - coordKill (n := n) (K := K) T p
      ∈ Ideal.span (coordGens T : Set (PolyRing n K)) := by
  have hgen : ∀ w : V n, w ∈ T →
      (MvPolynomial.X (w, true) : PolyRing n K)
        ∈ Ideal.span (coordGens T : Set (PolyRing n K)) ∧
      (MvPolynomial.X (w, false) : PolyRing n K)
        ∈ Ideal.span (coordGens T : Set (PolyRing n K)) := by
    intro w hw
    refine ⟨?_, ?_⟩
    · refine Submodule.subset_span ?_
      exact ⟨w, hw, Or.inl rfl⟩
    · refine Submodule.subset_span ?_
      exact ⟨w, hw, Or.inr rfl⟩
  refine MvPolynomial.induction_on
    (motive := fun q => q - coordKill (n := n) (K := K) T q
      ∈ Ideal.span (coordGens T : Set (PolyRing n K))) p ?_ ?_ ?_
  · intro c
    rw [coordKill_C, sub_self]
    exact Submodule.zero_mem _
  · intro a b ha hb
    have h : (a + b) - coordKill (n := n) (K := K) T (a + b)
        = (a - coordKill (n := n) (K := K) T a)
          + (b - coordKill (n := n) (K := K) T b) := by
      rw [map_add]; ring
    rw [h]
    exact Submodule.add_mem _ ha hb
  · intro q v hq
    rw [map_mul, coordKill_X]
    split_ifs with hT
    · rw [mul_zero, sub_zero]
      rcases v with ⟨w, d⟩
      cases d with
      | true => exact Ideal.mul_mem_left _ _ (hgen w hT).1
      | false => exact Ideal.mul_mem_left _ _ (hgen w hT).2
    · rw [← sub_mul, mul_comm]
      exact Ideal.mul_mem_left _ _ hq

end CrownV
