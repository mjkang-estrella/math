theorem xs_extreme : IsVertex 8 xs := by
  rw [IsVertex, mem_extremePoints]
  refine ⟨xs_mem, fun y hy w hw hxs => ?_⟩
  obtain ⟨a, b, ha, hb, hab, h⟩ := hxs
  have hpt : ∀ i j, a * y i j + b * w i j = xs i j := fun i j => by
    have := congrFun (congrFun h i) j; simpa using this
  obtain ⟨_, hyn, hyc, hyr, hyS⟩ := hy
  obtain ⟨_, hwn, hwc, hwr, hwS⟩ := hw
  have hzero : ∀ (u u' : Fin 8 → Fin 8 → ℝ), (∀ i j, 0 ≤ u i j) → (∀ i j, 0 ≤ u' i j) →
      (∀ i j, a * u i j + b * u' i j = xs i j) → ∀ i j, XN i j = 0 → u i j = 0 := by
    intro u u' hu hu' hp i j h0
    have e := hp i j; simp only [xs, h0, Nat.cast_zero, zero_div] at e
    have := hu i j; have := hu' i j
    have h1 : a * u i j = 0 := by nlinarith [mul_nonneg ha.le (hu i j), mul_nonneg hb.le (hu' i j)]
    rcases mul_eq_zero.1 h1 with h2 | h2
    · exact absurd h2 ha.ne'
    · exact h2
  have hfl : ∀ S, a * flux y S + b * flux w S = flux xs S := by
    intro S; simp only [flux, Finset.mul_sum, ← Finset.sum_add_distrib, hpt]
  have htight : ∀ (u u' : Fin 8 → Fin 8 → ℝ),
      (∀ S : Finset (Fin 8), 2 ≤ S.card → S.card ≤ 8 - 2 → 1 ≤ flux u S) →
      (∀ S : Finset (Fin 8), 2 ≤ S.card → S.card ≤ 8 - 2 → 1 ≤ flux u' S) →
      (∀ S, a * flux u S + b * flux u' S = flux xs S) → ∀ l ∈ tightCutList, flux u l.toFinset = 1 := by
    intro u u' hu hu' hp l hl
    have hc2 : 2 ≤ l.toFinset.card ∧ l.toFinset.card ≤ 6 ∧ fluxN l.toFinset = 4 := by
      revert l; decide +kernel
    have h1 := hu l.toFinset hc2.1 (by simpa using hc2.2.1)
    have h2 := hu' l.toFinset hc2.1 (by simpa using hc2.2.1)
    have h3 := hp l.toFinset
    rw [flux_xs, hc2.2.2] at h3
    nlinarith
  have hyx : y = xs := eq_xs y (hzero y w hyn hwn hpt) hyc hyr (htight y w hyS hwS hfl)
  have hpt' : ∀ i j, b * w i j + a * y i j = xs i j := fun i j => by linarith [hpt i j]
  have hfl' : ∀ S, b * flux w S + a * flux y S = flux xs S := fun S => by linarith [hfl S]
  have hzero' : ∀ i j, XN i j = 0 → w i j = 0 := by
    intro i j h0
    have e := hpt i j; simp only [xs, h0, Nat.cast_zero, zero_div] at e
    have h1 : b * w i j = 0 := by nlinarith [mul_nonneg ha.le (hyn i j), mul_nonneg hb.le (hwn i j)]
    rcases mul_eq_zero.1 h1 with h2 | h2
    · exact absurd h2 hb.ne'
    · exact h2
  have htw : ∀ l ∈ tightCutList, flux w l.toFinset = 1 := by
    intro l hl
    have hc2 : 2 ≤ l.toFinset.card ∧ l.toFinset.card ≤ 6 ∧ fluxN l.toFinset = 4 := by
      revert l; decide +kernel
    have h1 := hyS l.toFinset hc2.1 (by simpa using hc2.2.1)
    have h2 := hwS l.toFinset hc2.1 (by simpa using hc2.2.1)
    have h3 := hfl l.toFinset
    rw [flux_xs, hc2.2.2] at h3
    nlinarith
  exact ⟨hyx, eq_xs w hzero' hwc hwr htw⟩

theorem xs_fractional : xs 0 2 = 1 / 4 := by
  show (XN 0 2 : ℝ) / 4 = 1 / 4; rw [show XN 0 2 = 1 from rfl]; norm_num

