/-! The vertex `x* = XN / 4` of `P_ASEP^8` (generated by scripts/asep_lean_vertex.py). -/

namespace ASEP

open Finset

/-- The counterexample vertex `x*`. -/
noncomputable def xs : Fin 8 → Fin 8 → ℝ := fun i j => (XN i j : ℝ) / 4

/-- `4 · flux(x*, S)`. -/
def fluxN (S : Finset (Fin 8)) : ℕ := ∑ i ∈ S, ∑ j ∈ Sᶜ, XN i j

lemma flux_xs (S : Finset (Fin 8)) : flux xs S = (fluxN S : ℝ) / 4 := by
  simp only [flux, fluxN, xs, Nat.cast_sum]
  rw [Finset.sum_div]; refine Finset.sum_congr rfl (fun i _ => ?_); rw [Finset.sum_div]

theorem XN_diag : ∀ i : Fin 8, XN i i = 0 := by decide +kernel
theorem XN_col : ∀ j : Fin 8, ∑ i, XN i j = 4 := by decide +kernel
theorem XN_row : ∀ i : Fin 8, ∑ j, XN i j = 4 := by decide +kernel

set_option maxRecDepth 100000 in
theorem XN_cut : ∀ S : Finset (Fin 8), 2 ≤ S.card → S.card ≤ 6 → 4 ≤ fluxN S := by decide +kernel

set_option maxRecDepth 100000 in
theorem XN_tight : ∀ S : Finset (Fin 8), 2 ≤ S.card → S.card ≤ 6 → fluxN S = 4 →
    ∃ l ∈ tightCutList, S = l.toFinset := by decide +kernel

theorem xs_mem : xs ∈ polytope 8 := by
  refine ⟨fun i => by simp [xs, XN_diag], fun i j => by unfold xs; positivity, fun j => ?_, fun i => ?_,
    fun S h2 h6 => ?_⟩
  · simp only [xs]; rw [← Finset.sum_div, ← Nat.cast_sum, XN_col]; norm_num
  · simp only [xs]; rw [← Finset.sum_div, ← Nat.cast_sum, XN_row]; norm_num
  · rw [flux_xs]
    have h := XN_cut S h2 (by simpa using h6)
    have : (4 : ℝ) ≤ fluxN S := by exact_mod_cast h
    linarith

theorem xs_entry : ∀ i j, xs i j = 0 ∨ 1 / 4 ≤ xs i j := by
  intro i j; unfold xs
  rcases Nat.eq_zero_or_pos (XN i j) with h | h
  · left; simp [h]
  · right; have : (1 : ℝ) ≤ XN i j := by exact_mod_cast h
    linarith

theorem xs_cut : ∀ S : Finset (Fin 8), 2 ≤ S.card → S.card ≤ 6 → flux xs S = 1 ∨ 5 / 4 ≤ flux xs S := by
  intro S h2 h6; rw [flux_xs]
  have h := XN_cut S h2 h6
  rcases Nat.eq_or_lt_of_le h with h' | h'
  · left; rw [← h']; norm_num
  · right; have : (5 : ℝ) ≤ fluxN S := by exact_mod_cast h'
    linarith

lemma flux_ite_expand (y : Fin 8 → Fin 8 → ℝ) (S : Finset (Fin 8)) :
    flux y S = ∑ i, ∑ j, if (i ∈ S ∧ j ∉ S) then y i j else 0 := by
  unfold flux
  rw [← Finset.sum_filter_add_sum_filter_not Finset.univ (fun i => i ∈ S)]
  have h1 : Finset.univ.filter (fun i => i ∈ S) = S := by ext; simp
  rw [h1]
  have h2 : ∑ i ∈ Finset.univ.filter (fun i => ¬ i ∈ S), ∑ j, (if (i ∈ S ∧ j ∉ S) then y i j else 0) = 0 := by
    apply Finset.sum_eq_zero; intro i hi; simp only [Finset.mem_filter] at hi; simp [hi.2]
  rw [h2, add_zero]
  refine Finset.sum_congr rfl (fun i hi => ?_)
  rw [← Finset.sum_filter]; congr 1; ext j; simp [hi]

