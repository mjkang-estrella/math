<div id="Thmtheorem12.p1" class="ltx_para">
<p id="Thmtheorem12.p1.1" class="ltx_p"><span id="Thmtheorem12.p1.1.1" class="ltx_text ltx_font_italic">For every <math id="Thmtheorem12.p1.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>,</span></p>
