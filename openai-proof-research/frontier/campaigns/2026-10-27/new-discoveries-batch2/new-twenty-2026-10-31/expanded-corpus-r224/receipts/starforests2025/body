.56 185.04 30.04 185.04 33.09 L 185.04 85.02 C 185.04 88.07 187.52 90.55 190.57 90.55 L 242.5 90.55 C 245.55 90.55 248.03 88.07 248.03 85.02 Z M 185.04 27.56"></path></g><g style="--ltx-stroke-color:#800080;--ltx-fill-color:#800080;--ltx-fg-color:#000000;" color="#000000" fill="#800080" stroke="#800080" transform="matrix(1.0 0.0 0.0 1.0 168.99 22.83)"><foreignObject style="--ltx-fo-width:0.79em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="10.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.F1.pic1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#800080;" mathcolor="#800080">G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math></span></span></foreignObject></g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 227.52 8.12)"><foreignObject style="--ltx-fo-width:1.26em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="17.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.F1.pic1.m4" class="ltx_Math" alttext="B_{1}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mn>1</mn></msub><annotation encoding="application/x-tex">B_{1}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 1: </span>An example of <math id="S2.F1.m3" class="ltx_Math" alttext="B_{0}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mn>0</mn></msub><annotation encoding="application/x-tex">B_{0}</annotation></semantics></math> and its corresponding <math id="S2.F1.m4" class="ltx_Math" alttext="B_{1}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mn>1</mn></msub><annotation encoding="application/x-tex">B_{1}</annotation></semantics></math>.</figcaption>
</figure>
<div id="S2.SS1.p7" class="ltx_para">
<p id="S2.SS1.p7.1" class="ltx_p">We add <math id="S2.SS1.p7.m1" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math> times <a href="#S2.E2" title="In 2.1 Lower bounds ‣ 2 Decomposition into 3-star forests ‣ Decomposition of Cliques into 𝑘-Star-Forests" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">2</span></a> and minus <math id="S2.SS1.p7.m2" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math> times <a href="#S2.E1" title="In 2.1 Lower bounds ‣ 2 Decomposition into 3-star forests ‣ Decomposition of Cliques into 𝑘-Star-Forests" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">1</span></a> to the inequality above, resulting in</p>
<table id="S2.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex3.m1" class="ltx_math_unparsed" alttext="5n-9m+2r\leqslant-\sum_{j\geqslant 3}(2j-5)p_{j}\leqslant 0," display="block" intent=":literal"><semantics><mrow><mn>5</mn><mi>n</mi><mo>−</mo><mn>9</mn><mi>m</mi><mo>+</mo><mn>2</mn><mi>r</mi><mo rspace="0em">⩽</mo><mo lspace="0em" rspace="0.055em">−</mo><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>j</mi><mo>⩾</mo><mn>3</mn></mrow></munder><mrow><mo stretchy="false">(</mo><mn>2</mn><mi>j</mi><mo>−</mo><mn>5</mn><mo stretchy="false">)</mo></mrow><msub><mi>p</mi><mi>j</mi></msub><mo>⩽</mo><mn>0</mn><mo>,</mo></mrow><annotation encoding="application/x-tex">5n-9m+2r\leqslant-\sum_{j\geqslant 3}(2j-5)p_{j}\leqslant 0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS1.p7.2" class="ltx_p">contradicts with <math id="S2.SS1.p7.m3" class="ltx_Math" alttext="m&lt;\frac{5n}{9}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>&lt;</mo><mfrac><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mn>9</mn></mfrac></mrow><annotation encoding="application/x-tex">m&lt;\frac{5n}{9}</annotation></semantics></math>.</p>
</div>
</section>
<section id="S2.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">2.2 </span>The construction for <math id="S2.SS2.m1" class="ltx_Math" alttext="n=27" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>27</mn></mrow><annotation encoding="application/x-tex">n=27</annotation></semantics></math></h3>

<div id="S2.SS2.p1" class="ltx_para">
<p id="S2.SS2.p1.1" class="ltx_p">From the inequality above, the equality holds only when <math id="S2.SS2.p1.m1" class="ltx_Math" alttext="r=p_{j}(j\geqslant 3)=0" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mrow><msub><mi>p</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>j</mi><mo>⩾</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">r=p_{j}(j\geqslant 3)=0</annotation></semantics></math>, that means no 2-star-forest are used and each vertex acts as a center in some star-forest at most twice. If <math id="S2.SS2.p1.m2" class="ltx_Math" alttext="F_{3}(n)=5n/9" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>F</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>/</mo><mn>9</mn></mrow></mrow><annotation encoding="application/x-tex">F_{3}(n)=5n/9</annotation></semantics></math>, then <math id="S2.SS2.p1.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> must be a multiple of <math id="S2.SS2.p1.m4" class="ltx_Math" alttext="9" display="inline" intent=":literal"><semantics><mn>9</mn><annotation encoding="application/x-tex">9</annotation></semantics></math>. For <math id="S2.SS2.p1.m5" class="ltx_Math" alttext="n=9,18" display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo>=</mo><mn>9</mn></mrow><mo>,</mo><mn>18</mn></mrow><annotation encoding="application/x-tex">n=9,18</annotation></semantics></math>, it is easy to check <math id="S2.SS2.p1.m6" class="ltx_Math" alttext="(n-3)\cdot\frac{5n}{9}&lt;\binom{n}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>3</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mfrac><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mn>9</mn></mfrac></mrow><mo>&lt;</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>n</mi><mn>2</mn></mfrac><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">(n-3)\cdot\frac{5n}{9}&lt;\binom{n}{2}</annotation></semantics></math>, hence it is impossible to decompose <math id="S2.SS2.p1.m7" class="ltx_Math" alttext="K_{n}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>n</mi></msub><annotation encoding="application/x-tex">K_{n}</annotation></semantics></math> into <math id="S2.SS2.p1.m8" class="ltx_Math" alttext="\frac{5n}{9}" display="inline" intent=":literal"><semantics><mfrac><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mn>9</mn></mfrac><annotation encoding="application/x-tex">\frac{5n}{9}</annotation></semantics></math> 3-star-forests. For <math id="S2.SS2.p1.m9" class="ltx_Math" alttext="n=27" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>27</mn></mrow><annotation encoding="application/x-tex">n=27</annotation></semantics></math>, we discover the following construction (see <a href="#S2.F2" title="In 2.2 The construction for 𝑛=27 ‣ 2 Decomposition into 3-star forests ‣ Decomposition of Cliques into 𝑘-Star-Forests" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">2</span></a> for an illustration).</p>
</div>
<div id="S2.SS2.p2" class="ltx_para">
<p id="S2.SS2.p2.1" class="ltx_p">Let <math id="S2.SS2.p2.m1" class="ltx_math_unparsed" alttext="\mathbb{F}^{3}_{3}=\{(i,j,k):i,j,k\in\mathbb{F}_{3}\}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝔽</mi><mn>3</mn><mn>3</mn></msubsup><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi><mo>∈</mo><msub><mi>𝔽</mi><mn>3</mn></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{F}^{3}_{3}=\{(i,j,k):i,j,k\in\mathbb{F}_{3}\}</annotation></semantics></math> be the vertex set of <math id="S2.SS2.p2.m2" class="ltx_Math" alttext="K_{27}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mn>27</mn></msub><annotation encoding="application/x-tex">K_{27}</annotation></semantics></math> where <math id="S2.SS2.p2.m3" class="ltx_Math" alttext="\mathbb{F}_{3}=\{0,1,2\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔽</mi><mn>3</mn></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>2</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{F}_{3}=\{0,1,2\}</annotation></semantics></math> is the finite field of size 3. Let <math id="S2.SS2.p2.m4" class="ltx_Math" alttext="\{(i,j,0),(i,j,1),(i,j,2)\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{(i,j,0),(i,j,1),(i,j,2)\}</annotation></semantics></math> be the centers of the 3-star-forest <math id="S2.SS2.p2.m5" class="ltx_Math" alttext="S_{ij}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">S_{ij}</annotation></semantics></math> consisting of stars</p>
<table id="S2.EGx1" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

