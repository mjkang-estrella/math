;" color="#000000" height="11.01" overflow="visible" transform="matrix(1 0 0 -1 0 9.13)" width="55.5"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F7.pic4.m10" class="ltx_Math" alttext="0\leq i\leq 1" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#808000;" mathcolor="#808000">0</mn><mo style="--ltx-fg-color:#808000;" mathcolor="#808000">≤</mo><mi style="--ltx-fg-color:#808000;" mathcolor="#808000">i</mi><mo style="--ltx-fg-color:#808000;" mathcolor="#808000">≤</mo><mn style="--ltx-fg-color:#808000;" mathcolor="#808000">1</mn></mrow><annotation encoding="application/x-tex">0\leq i\leq 1</annotation></semantics></math></span></span></foreignObject></g><g></g><g style="--ltx-stroke-color:#00FF00;--ltx-fill-color:#00FF00;--ltx-fg-color:#00FF00;" color="#00FF00" fill="#00FF00" stroke="#00FF00" transform="matrix(0.8 0.0 0.0 0.8 84.1 16.79)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:4.01em;--ltx-fo-height:0.66em;--ltx-fo-depth:0.14em;font-size:10pt;" color="#000000" height="11.01" overflow="visible" transform="matrix(1 0 0 -1 0 9.13)" width="55.5"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F7.pic4.m11" class="ltx_Math" alttext="0\leq i\leq 1" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#00FF00;" mathcolor="#00FF00">0</mn><mo style="--ltx-fg-color:#00FF00;" mathcolor="#00FF00">≤</mo><mi style="--ltx-fg-color:#00FF00;" mathcolor="#00FF00">i</mi><mo style="--ltx-fg-color:#00FF00;" mathcolor="#00FF00">≤</mo><mn style="--ltx-fg-color:#00FF00;" mathcolor="#00FF00">1</mn></mrow><annotation encoding="application/x-tex">0\leq i\leq 1</annotation></semantics></math></span></span></foreignObject></g><g></g></g></g></svg></span></div></div>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">Figure 7: </span>Distribution of ‘long-distance’ edges to star-forests.</figcaption>
</figure>
<div id="S3.SS6.p1" class="ltx_para">
<p id="S3.SS6.p1.1" class="ltx_p">To show that our construction actually cover all the ‘long-distance’ edges, we draw <a href="#S3.F7" title="In 3.6 Conclusion ‣ 3 Decompostion into 4-star forests ‣ Decomposition of Cliques into 𝑘-Star-Forests" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">7</span></a>. It shows which star-forest each type of ‘long-distance’ edges is distributed to. For example, the left-upper corner of <a href="#S3.F7" title="In 3.6 Conclusion ‣ 3 Decompostion into 4-star forests ‣ Decomposition of Cliques into 𝑘-Star-Forests" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">7</span></a> shows that for each pair <math id="S3.SS6.p1.m1" class="ltx_Math" alttext="i,~j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo rspace="0.497em">,</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i,~j</annotation></semantics></math> with <math id="S3.SS6.p1.m2" class="ltx_Math" alttext="1\leq i&lt;j\leq m-1" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>&lt;</mo><mi>j</mi><mo>≤</mo><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">1\leq i&lt;j\leq m-1</annotation></semantics></math>, the edges between <math id="S3.SS6.p1.m3" class="ltx_Math" alttext="A_{i}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>i</mi></msub><annotation encoding="application/x-tex">A_{i}</annotation></semantics></math> and <math id="S3.SS6.p1.m4" class="ltx_Math" alttext="A_{j}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>j</mi></msub><annotation encoding="application/x-tex">A_{j}</annotation></semantics></math> are distributed as follows: 
<br class="ltx_break">edge of the form <math id="S3.SS6.p1.m5" class="ltx_Math" alttext="A_{i}(t)A_{j}(t+1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">A_{i}(t)A_{j}(t+1)</annotation></semantics></math> is covered by <math id="S3.SS6.p1.m6" class="ltx_Math" alttext="S_{X_{j(t+1)}}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><msub><mi>X</mi><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></msub><annotation encoding="application/x-tex">S_{X_{j(t+1)}}</annotation></semantics></math>,
<br class="ltx_break">edge of the form <math id="S3.SS6.p1.m7" class="ltx_Math" alttext="A_{i}(t)A_{j}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">A_{i}(t)A_{j}(t)</annotation></semantics></math> is covered by <math id="S3.SS6.p1.m8" class="ltx_Math" alttext="S_{X_{it}}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><msub><mi>X</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></msub><annotation encoding="application/x-tex">S_{X_{it}}</annotation></semantics></math>,
<br class="ltx_break">edge of the form <math id="S3.SS6.p1.m9" class="ltx_Math" alttext="A_{i}(t)A_{j}(t-1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">A_{i}(t)A_{j}(t-1)</annotation></semantics></math> is covered by <math id="S3.SS6.p1.m10" class="ltx_Math" alttext="S_{X_{j(t-1)}}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><msub><mi>X</mi><mrow><mi>j</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></msub><annotation encoding="application/x-tex">S_{X_{j(t-1)}}</annotation></semantics></math>, and
<br class="ltx_break">edge of the form <math id="S3.SS6.p1.m11" class="ltx_Math" alttext="A_{i}(t)A_{j}(t-2)" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">A_{i}(t)A_{j}(t-2)</annotation></semantics></math> is covered by <math id="S3.SS6.p1.m12" class="ltx_Math" alttext="S_{X_{it}}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><msub><mi>X</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></msub><annotation encoding="application/x-tex">S_{X_{it}}</annotation></semantics></math>.</p>
</div>
<div id="S3.SS6.p2" class="ltx_para">
<p id="S3.SS6.p2.1" class="ltx_p">Note that all k-star-forests in our construction contain <math id="S3.SS6.p2.m1" class="ltx_Math" alttext="(n-k)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n-k)</annotation></semantics></math> edges (for <math id="S3.SS6.p2.m2" class="ltx_Math" alttext="k\in\{2,4\}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>2</mn><mo>,</mo><mn>4</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">k\in\{2,4\}</annotation></semantics></math>), thus they contain</p>
<table id="S3.Ex60" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex60.m1" class="ltx_Math" alttext="(n-4)\times\frac{n}{2}+(n-2)\times 4=\frac{n^{2}}{2}=\frac{n(n-1)}{2}+\frac{n}{2}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>4</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mfrac><mi>n</mi><mn>2</mn></mfrac></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mn>4</mn></mrow></mrow><mo>=</mo><mfrac><msup><mi>n</mi><mn>2</mn></msup><mn>2</mn></mfrac><mo>=</mo><mrow><mfrac><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></mfrac><mo>+</mo><mfrac><mi>n</mi><mn>2</mn></mfrac></mrow></mrow><annotation encoding="application/x-tex">(n-4)\times\frac{n}{2}+(n-2)\times 4=\frac{n^{2}}{2}=\frac{n(n-1)}{2}+\frac{n}{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS6.p2.2" class="ltx_p">edges in total, and in fact there are exactly <math id="S3.SS6.p2.m3" class="ltx_Math" alttext="\frac{n}{2}" display="inline" intent=":literal"><semantics><mfrac><mi>n</mi><mn>2</mn></mfrac><annotation encoding="application/x-tex">\frac{n}{2}</annotation></semantics></math> edges that are covered twice in our construction, which is <math id="S3.SS6.p2.m4" class="ltx_Math" alttext="P_{k}(i)P_{k}(i+2)" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P_{k}(i)P_{k}(i+2)</annotation></semantics></math> for every <math id="S3.SS6.p2.m5" class="ltx_Math" alttext="0\leq k\leq m(P=A)" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mi>k</mi><mo>≤</mo><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>P</mi><mo>=</mo><mi>A</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">0\leq k\leq m(P=A)</annotation></semantics></math> or <math id="S3.SS6.p2.m6" class="ltx_Math" alttext="0\leq k\leq m-1(P=B,C)" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mi>k</mi><mo>≤</mo><mrow><mi>m</mi><mo>−</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>P</mi><mo>=</mo><mi>B</mi></mrow><mo>,</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">0\leq k\leq m-1(P=B,C)</annotation></semantics></math> and <math id="S3.SS6.p2.m7" class="ltx_Math" alttext="0\leq i\leq 1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0\leq i\leq 1</annotation></semantics></math>. This provides another perspective to check our construction.</p>
</div>
