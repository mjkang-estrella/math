<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex21X.m3" class="ltx_Math" alttext="\displaystyle\Longrightarrow\varphi(\alpha_{1})=1," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo stretchy="false">⟹</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Longrightarrow\varphi(\alpha_{1})=1,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex21Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
