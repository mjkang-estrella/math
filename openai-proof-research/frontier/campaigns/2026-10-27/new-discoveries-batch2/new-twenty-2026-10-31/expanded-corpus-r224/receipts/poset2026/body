<td class="ltx_eqn_cell ltx_eqn_center_padright" colspan="3"></td></tr></tbody>
</table>
<p id="S4.SS5.p10.2" class="ltx_p"><span id="S4.SS5.p10.2.1" class="ltx_text">For <math id="S4.SS5.p10.m2" class="ltx_Math" alttext="1\leq i\leq n+1" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">1\leq i\leq n+1</annotation></semantics></math>, if <math id="S4.SS5.p10.m3" class="ltx_Math" alttext="\varphi(\beta_{i})=2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>β</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\varphi(\beta_{i})=2</annotation></semantics></math>, then</span></p>
