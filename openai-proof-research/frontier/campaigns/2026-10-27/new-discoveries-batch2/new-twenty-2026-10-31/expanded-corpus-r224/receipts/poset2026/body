</div>
<div id="S4.SS4.p14" class="ltx_para">
<p id="S4.SS4.p14.1" class="ltx_p"><span id="S4.SS4.p14.1.1" class="ltx_text">Suppose <math id="S4.SS4.p14.m1" class="ltx_Math" alttext="b=0" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">b=0</annotation></semantics></math>. We have</span></p>
<table id="S4.Ex60" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S4.Ex60X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex60X.m2" class="ltx_Math" alttext="\displaystyle\alpha_{n+2}\sim\beta_{n+2},\ell_{2},\pi_{3}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>α</mi><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow></msub><mo>∼</mo><msub><mi>β</mi><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow></msub></mrow><mo>,</mo><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub><mo>,</mo><msub><mi>π</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\alpha_{n+2}\sim\beta_{n+2},\ell_{2},\pi_{3}</annotation></semantics></math></td>
