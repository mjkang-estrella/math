<td id="S4.SS1.p2.2.14.2" class="ltx_td ltx_align_left ltx_border_bb" style="padding-top:0.35pt;padding-bottom:0.35pt;"><math id="S4.SS1.p2.m59" class="ltx_Math" alttext="r_{2}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">r</mi><mn mathsize="0.900em">2</mn></msub><annotation encoding="application/x-tex">r_{2}</annotation></semantics></math></td>
<td id="S4.SS1.p2.2.14.3" class="ltx_td ltx_nopad_r ltx_border_bb" style="padding-top:0.35pt;padding-bottom:0.35pt;"></td></tr>
