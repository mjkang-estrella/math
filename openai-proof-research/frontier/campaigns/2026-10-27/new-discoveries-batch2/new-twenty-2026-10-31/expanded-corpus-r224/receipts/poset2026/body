<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex65.m1" class="ltx_Math" alttext="c\nleq b_{i},\qquad\mathord{\downarrow}^{\!\circ}c=\varnothing,\qquad\mathord{\uparrow}^{\!\circ}b_{i}\subseteq\{d_{1},d_{2}\}\subseteq\uparrow c." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>c</mi><mo>≰</mo><msub><mi>b</mi><mi>i</mi></msub></mrow><mo rspace="2.167em">,</mo><mrow><mrow><msup><mi mathvariant="normal">↓</mi><mo>∘</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>=</mo><mi mathvariant="normal">∅</mi></mrow><mo rspace="2.167em">,</mo><mrow><mrow><msup><mi mathvariant="normal">↑</mi><mo>∘</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>i</mi></msub></mrow><mo>⊆</mo><mrow><mo stretchy="false">{</mo><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><msub><mi>d</mi><mn>2</mn></msub><mo stretchy="false">}</mo></mrow><mo>⊆</mo><mphantom></mphantom><mo stretchy="false">↑</mo><mi>c</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">c\nleq b_{i},\qquad\mathord{\downarrow}^{\!\circ}c=\varnothing,\qquad\mathord{\uparrow}^{\!\circ}b_{i}\subseteq\{d_{1},d_{2}\}\subseteq\uparrow c.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS5.p3.4" class="ltx_p">For <math id="S4.SS5.p3.m4" class="ltx_Math" alttext="r_{1},r_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mn>1</mn></msub><mo>,</mo><msub><mi>r</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">r_{1},r_{2}</annotation></semantics></math>, condition (<a href="#S3.E5" title="In item (i) ‣ Lemma 3.1. ‣ 3 Critical pairs in 𝖵×𝑅 ‣ The Kelly–Trotter product conjecture for posets of dimension three" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>) follows
from</p>
<table id="S4.Ex66" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex66.m1" class="ltx_Math" alttext="\begin{array}[]{llll}r_{1}:&amp;b_{1}\nleq d_{2},&amp;\mathord{\downarrow}^{\!\circ}b_{1}=\{a_{1}\}\subseteq\downarrow d_{2},&amp;\mathord{\uparrow}^{\!\circ}d_{2}=\varnothing,\\
r_{2}:&amp;b_{n+3}\nleq d_{1},&amp;\mathord{\downarrow}^{\!\circ}b_{n+3}=\{a_{n+2}\}\subseteq\downarrow d_{1},&amp;\mathord{\uparrow}^{\!\circ}d_{1}=\varnothing.\end{array}" display="block" intent=":literal"><semantics><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi>r</mi><mn>1</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mphantom></mphantom></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi>b</mi><mn>1</mn></msub><mo>≰</mo><msub><mi>d</mi><mn>2</mn></msub></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><msup><mi mathvariant="normal">↓</mi><mo>∘</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mn>1</mn></msub></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">}</mo></mrow><mo>⊆</mo><mphantom></mphantom><mo stretchy="false">↓</mo><msub><mi>d</mi><mn>2</mn></msub></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><msup><mi mathvariant="normal">↑</mi><mo>∘</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mn>2</mn></msub></mrow><mo>=</mo><mi mathvariant="normal">∅</mi></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi>r</mi><mn>2</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mphantom></mphantom></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi>b</mi><mrow><mi>n</mi><mo>+</mo><mn>3</mn></mrow></msub><mo>≰</mo><msub><mi>d</mi><mn>1</mn></msub></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><msup><mi mathvariant="normal">↓</mi><mo>∘</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mrow><mi>n</mi><mo>+</mo><mn>3</mn></mrow></msub></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>a</mi><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow></msub><mo stretchy="false">}</mo></mrow><mo>⊆</mo><mphantom></mphantom><mo stretchy="false">↓</mo><msub><mi>d</mi><mn>1</mn></msub></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><msup><mi mathvariant="normal">↑</mi><mo>∘</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mn>1</mn></msub></mrow><mo>=</mo><mi mathvariant="normal">∅</mi></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{array}[]{llll}r_{1}:&amp;b_{1}\nleq d_{2},&amp;\mathord{\downarrow}^{\!\circ}b_{1}=\{a_{1}\}\subseteq\downarrow d_{2},&amp;\mathord{\uparrow}^{\!\circ}d_{2}=\varnothing,\\
r_{2}:&amp;b_{n+3}\nleq d_{1},&amp;\mathord{\downarrow}^{\!\circ}b_{n+3}=\{a_{n+2}\}\subseteq\downarrow d_{1},&amp;\mathord{\uparrow}^{\!\circ}d_{1}=\varnothing.\end{array}</annotation></semantics></math></td>
