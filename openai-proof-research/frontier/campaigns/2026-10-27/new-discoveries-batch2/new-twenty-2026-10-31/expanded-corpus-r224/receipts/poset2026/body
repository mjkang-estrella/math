<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex55X.m3" class="ltx_Math" alttext="\displaystyle\Longrightarrow\varphi(\alpha_{1})=0," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo stretchy="false">⟹</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Longrightarrow\varphi(\alpha_{1})=0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex55Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex55Xa.m2" class="ltx_Math" alttext="\displaystyle\beta_{1}\sim\alpha_{1},\pi_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>β</mi><mn>1</mn></msub><mo>∼</mo><msub><mi>α</mi><mn>1</mn></msub></mrow><mo>,</mo><msub><mi>π</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\beta_{1}\sim\alpha_{1},\pi_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex55Xa.m3" class="ltx_Math" alttext="\displaystyle\Longrightarrow\varphi(\beta_{1})=2," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo stretchy="false">⟹</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>β</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>2</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Longrightarrow\varphi(\beta_{1})=2,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex55Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex55Xb.m2" class="ltx_Math" alttext="\displaystyle\beta_{2}\sim\alpha_{1},\pi_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>β</mi><mn>2</mn></msub><mo>∼</mo><msub><mi>α</mi><mn>1</mn></msub></mrow><mo>,</mo><msub><mi>π</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\beta_{2}\sim\alpha_{1},\pi_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex55Xb.m3" class="ltx_Math" alttext="\displaystyle\Longrightarrow\varphi(\beta_{2})=2." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo stretchy="false">⟹</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>β</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>2</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Longrightarrow\varphi(\beta_{2})=2.</annotation></semantics></math></td>
