<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex21Xc.m2" class="ltx_Math" alttext="\displaystyle\ell_{2}\sim r_{1},\pi_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub><mo>∼</mo><msub><mi>r</mi><mn>1</mn></msub></mrow><mo>,</mo><msub><mi>π</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\ell_{2}\sim r_{1},\pi_{1}</annotation></semantics></math></td>
