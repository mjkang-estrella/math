<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex86.m1" class="ltx_Math" alttext="(\mathsf{V}^{d}\times R)^{d}\cong\mathsf{V}\times S." display="block" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝖵</mi><mi>d</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow><mi>d</mi></msup><mo>≅</mo><mrow><mi>𝖵</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>S</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(\mathsf{V}^{d}\times R)^{d}\cong\mathsf{V}\times S.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p2.2" class="ltx_p"><span id="S6.p2.2.1" class="ltx_text">Lemma <a href="#S2.Thmtheorem3" title="Lemma 2.3. ‣ 2 Preliminaries ‣ The Kelly–Trotter product conjecture for posets of dimension three" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.3</span></a> shows that
<math id="S6.p2.m5" class="ltx_Math" alttext="\Gamma(\mathsf{V}^{d}\times R)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝖵</mi><mi>d</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Gamma(\mathsf{V}^{d}\times R)</annotation></semantics></math> is not <math id="S6.p2.m6" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>-colorable.
∎</span></p>
</div>
</div>
<div id="S6.Thmtheorem2" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmtheorem2.2" class="ltx_text ltx_font_bold">Corollary 6.2</span></span><span id="S6.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmtheorem2.p1" class="ltx_para">
<p id="S6.Thmtheorem2.p1.1" class="ltx_p"><span id="S6.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S6.Thmtheorem2.p1.m1" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> be a <math id="S6.Thmtheorem2.p1.m2" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>-irreducible poset that is not a crown. For every
<math id="S6.Thmtheorem2.p1.m3" class="ltx_Math" alttext="k\geq 3" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">k\geq 3</annotation></semantics></math>,</span></p>
<table id="S6.Ex87" class="ltx_equation ltx_eqn_table">

