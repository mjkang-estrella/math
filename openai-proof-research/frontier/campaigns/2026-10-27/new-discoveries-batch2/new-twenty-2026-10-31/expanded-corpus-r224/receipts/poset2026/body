<p id="S4.SS1.p9.2" class="ltx_p"><span id="S4.SS1.p9.2.1" class="ltx_text">The neighbors <math id="S4.SS1.p9.m2" class="ltx_Math" alttext="\ell_{3},\pi_{2},\ell_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>3</mn></msub><mo>,</mo><msub><mi>π</mi><mn>2</mn></msub><mo>,</mo><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\ell_{3},\pi_{2},\ell_{2}</annotation></semantics></math> of <math id="S4.SS1.p9.m3" class="ltx_Math" alttext="\ell_{5}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mn>5</mn></msub><annotation encoding="application/x-tex">\ell_{5}</annotation></semantics></math> have colors
<math id="S4.SS1.p9.m4" class="ltx_Math" alttext="0,1,2" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">0,1,2</annotation></semantics></math>, a contradiction.</span></p>
</div>
<div id="S4.SS1.p10" class="ltx_para">
<p id="S4.SS1.p10.1" class="ltx_p"><span id="S4.SS1.p10.1.1" class="ltx_text">Suppose that <math id="S4.SS1.p10.m1" class="ltx_Math" alttext="t=1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=1</annotation></semantics></math>.</span></p>
