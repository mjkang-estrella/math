</table>
<p id="S4.SS4.p15.2" class="ltx_p"><span id="S4.SS4.p15.2.1" class="ltx_text">The neighbors <math id="S4.SS4.p15.m2" class="ltx_Math" alttext="\ell_{2},\ell_{1},\ell_{4}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub><mo>,</mo><msub><mi mathvariant="normal">ℓ</mi><mn>1</mn></msub><mo>,</mo><msub><mi mathvariant="normal">ℓ</mi><mn>4</mn></msub></mrow><annotation encoding="application/x-tex">\ell_{2},\ell_{1},\ell_{4}</annotation></semantics></math> of <math id="S4.SS4.p15.m3" class="ltx_Math" alttext="r_{1}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mn>1</mn></msub><annotation encoding="application/x-tex">r_{1}</annotation></semantics></math> have colors
