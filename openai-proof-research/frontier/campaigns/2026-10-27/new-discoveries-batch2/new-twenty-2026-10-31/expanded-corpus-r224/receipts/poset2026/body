<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex60Xa.m3" class="ltx_Math" alttext="\displaystyle\Longrightarrow\varphi(\ell_{1})=1." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo stretchy="false">⟹</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">ℓ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Longrightarrow\varphi(\ell_{1})=1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p14.2" class="ltx_p"><span id="S4.SS4.p14.2.1" class="ltx_text">If <math id="S4.SS4.p14.m2" class="ltx_Math" alttext="\varphi(r_{2})=2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\varphi(r_{2})=2</annotation></semantics></math>, the neighbors <math id="S4.SS4.p14.m3" class="ltx_Math" alttext="\beta_{1},\pi_{3},r_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>1</mn></msub><mo>,</mo><msub><mi>π</mi><mn>3</mn></msub><mo>,</mo><msub><mi>r</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\beta_{1},\pi_{3},r_{2}</annotation></semantics></math> of
<math id="S4.SS4.p14.m4" class="ltx_Math" alttext="\ell_{6}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mn>6</mn></msub><annotation encoding="application/x-tex">\ell_{6}</annotation></semantics></math> have colors <math id="S4.SS4.p14.m5" class="ltx_Math" alttext="0,1,2" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">0,1,2</annotation></semantics></math>. Hence
<math id="S4.SS4.p14.m6" class="ltx_Math" alttext="\varphi(r_{2})\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\varphi(r_{2})\in\{0,1\}</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS4.p15" class="ltx_para">
<p id="S4.SS4.p15.1" class="ltx_p"><span id="S4.SS4.p15.1.1" class="ltx_text">If <math id="S4.SS4.p15.m1" class="ltx_Math" alttext="\varphi(r_{2})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\varphi(r_{2})=0</annotation></semantics></math>, then</span></p>
