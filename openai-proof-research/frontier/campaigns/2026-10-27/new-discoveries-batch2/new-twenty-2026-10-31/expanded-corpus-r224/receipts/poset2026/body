<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex85.m1" class="ltx_Math" alttext="\Gamma(\mathsf{V}\times R)\quad\text{and}\quad\Gamma(\mathsf{V}^{d}\times R)" display="block" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝖵</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext class="ltx_mathvariant_italic">and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝖵</mi><mi>d</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Gamma(\mathsf{V}\times R)\quad\text{and}\quad\Gamma(\mathsf{V}^{d}\times R)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.Thmtheorem1.p1.2" class="ltx_p"><span id="S6.Thmtheorem1.p1.2.1" class="ltx_text ltx_font_italic">is not <math id="S6.Thmtheorem1.p1.m3" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>-colorable.</span></p>
