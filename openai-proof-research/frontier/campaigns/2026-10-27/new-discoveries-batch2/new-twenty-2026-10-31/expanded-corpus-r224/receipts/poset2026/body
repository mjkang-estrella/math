</table>
<p id="S4.SS5.p11.2" class="ltx_p"><span id="S4.SS5.p11.2.1" class="ltx_text">The edge <math id="S4.SS5.p11.m2" class="ltx_Math" alttext="\beta_{n+2}\sim\gamma_{n+2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow></msub><mo>∼</mo><msub><mi>γ</mi><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\beta_{n+2}\sim\gamma_{n+2}</annotation></semantics></math> excludes color <math id="S4.SS5.p11.m3" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> from
<math id="S4.SS5.p11.m4" class="ltx_Math" alttext="\beta_{n+2}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\beta_{n+2}</annotation></semantics></math>. If <math id="S4.SS5.p11.m5" class="ltx_Math" alttext="\varphi(\beta_{n+2})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>β</mi><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\varphi(\beta_{n+2})=0</annotation></semantics></math>, the neighbors
<math id="S4.SS5.p11.m6" class="ltx_Math" alttext="\beta_{n+2},\pi_{1},\beta_{n+3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow></msub><mo>,</mo><msub><mi>π</mi><mn>1</mn></msub><mo>,</mo><msub><mi>β</mi><mrow><mi>n</mi><mo>+</mo><mn>3</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\beta_{n+2},\pi_{1},\beta_{n+3}</annotation></semantics></math> of <math id="S4.SS5.p11.m7" class="ltx_Math" alttext="\alpha_{n+2}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\alpha_{n+2}</annotation></semantics></math> have colors
<math id="S4.SS5.p11.m8" class="ltx_Math" alttext="0,1,2" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">0,1,2</annotation></semantics></math>, a contradiction. Thus
<math id="S4.SS5.p11.m9" class="ltx_Math" alttext="\varphi(\beta_{n+2})=2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>β</mi><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\varphi(\beta_{n+2})=2</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS5.p12" class="ltx_para">
<p id="S4.SS5.p12.1" class="ltx_p"><span id="S4.SS5.p12.1.1" class="ltx_text">For <math id="S4.SS5.p12.m1" class="ltx_Math" alttext="1\leq i\leq n+1" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">1\leq i\leq n+1</annotation></semantics></math>, if
<math id="S4.SS5.p12.m2" class="ltx_Math" alttext="\varphi(\beta_{i+1})=2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>β</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\varphi(\beta_{i+1})=2</annotation></semantics></math>, then</span></p>
<table id="S4.Ex77" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S4.Ex77X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex77X.m2" class="ltx_Math" alttext="\displaystyle\gamma_{i}\sim\beta_{i+1},\pi_{3}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>γ</mi><mi>i</mi></msub><mo>∼</mo><msub><mi>β</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>,</mo><msub><mi>π</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\gamma_{i}\sim\beta_{i+1},\pi_{3}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex77X.m3" class="ltx_Math" alttext="\displaystyle\Longrightarrow\varphi(\gamma_{i})=1," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo stretchy="false">⟹</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>γ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Longrightarrow\varphi(\gamma_{i})=1,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex77Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex77Xa.m2" class="ltx_Math" alttext="\displaystyle\alpha_{i}\sim\beta_{i+1},\pi_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>α</mi><mi>i</mi></msub><mo>∼</mo><msub><mi>β</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>,</mo><msub><mi>π</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\alpha_{i}\sim\beta_{i+1},\pi_{1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex77Xa.m3" class="ltx_Math" alttext="\displaystyle\Longrightarrow\varphi(\alpha_{i})=0," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo stretchy="false">⟹</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Longrightarrow\varphi(\alpha_{i})=0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex77Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex77Xb.m2" class="ltx_Math" alttext="\displaystyle\beta_{i}\sim\gamma_{i},\alpha_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>β</mi><mi>i</mi></msub><mo>∼</mo><msub><mi>γ</mi><mi>i</mi></msub></mrow><mo>,</mo><msub><mi>α</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\beta_{i}\sim\gamma_{i},\alpha_{i}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex77Xb.m3" class="ltx_Math" alttext="\displaystyle\Longrightarrow\varphi(\beta_{i})=2." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo stretchy="false">⟹</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>β</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>2</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Longrightarrow\varphi(\beta_{i})=2.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS5.p12.2" class="ltx_p"><span id="S4.SS5.p12.2.1" class="ltx_text">Starting with <math id="S4.SS5.p12.m3" class="ltx_Math" alttext="\beta_{n+2}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\beta_{n+2}</annotation></semantics></math> and taking
<math id="S4.SS5.p12.m4" class="ltx_Math" alttext="i=n+1,n,\ldots,1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mrow><mo>,</mo><mi>n</mi><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i=n+1,n,\ldots,1</annotation></semantics></math>, reverse induction gives</span></p>
<table id="S4.Ex78" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex78.m1" class="ltx_Math" alttext="\varphi(\beta_{n+2})=\cdots=\varphi(\beta_{1})=2." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>β</mi><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">=</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">=</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>β</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>2</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\varphi(\beta_{n+2})=\cdots=\varphi(\beta_{1})=2.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS5.p12.3" class="ltx_p"><span id="S4.SS5.p12.3.1" class="ltx_text">This contradicts the edge <math id="S4.SS5.p12.m5" class="ltx_Math" alttext="r_{1}\sim\beta_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mn>1</mn></msub><mo>∼</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">r_{1}\sim\beta_{1}</annotation></semantics></math>, since
<math id="S4.SS5.p12.m6" class="ltx_Math" alttext="\varphi(r_{1})=2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\varphi(r_{1})=2</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S4.SS5.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Theorem <a href="#S4.Thmtheorem1" title="Theorem 4.1. ‣ 4 The six infinite families ‣ The Kelly–Trotter product conjecture for posets of dimension three" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>.</h6>
<div id="S4.SS5.p13" class="ltx_para">
<p id="S4.SS5.p13.1" class="ltx_p"><span id="S4.SS5.p13.1.1" class="ltx_text">Propositions <a href="#S4.Thmtheorem2" title="Proposition 4.2. ‣ 4.1 The family 𝐸_𝑛 ‣ 4 The six infinite families ‣ The Kelly–Trotter product conjecture for posets of dimension three" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>, <a href="#S4.Thmtheorem3" title="Proposition 4.3. ‣ 4.2 The family 𝐹_𝑛 ‣ 4 The six infinite families ‣ The Kelly–Trotter product conjecture for posets of dimension three" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a>,
<a href="#S4.Thmtheorem4" title="Proposition 4.4. ‣ 4.3 The families 𝐺_𝑛 and 𝐽_𝑛 ‣ 4 The six infinite families ‣ The Kelly–Trotter product conjecture for posets of dimension three" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.4</span></a>, <a href="#S4.Thmtheorem5" title="Proposition 4.5. ‣ 4.4 The family 𝐻_𝑛 ‣ 4 The six infinite families ‣ The Kelly–Trotter product conjecture for posets of dimension three" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.5</span></a>, and
<a href="#S4.Thmtheorem6" title="Proposition 4.6. ‣ 4.5 The family 𝐼_𝑛 ‣ 4 The six infinite families ‣ The Kelly–Trotter product conjecture for posets of dimension three" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.6</span></a> provide a non-<math id="S4.SS5.p13.m1" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>-colorable subgraph
<math id="S4.SS5.p13.m2" class="ltx_Math" alttext="W_{R}\subseteq\Gamma(\mathsf{V}\times R)" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>R</mi></msub><mo>⊆</mo><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝖵</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">W_{R}\subseteq\Gamma(\mathsf{V}\times R)</annotation></semantics></math> for every member <math id="S4.SS5.p13.m3" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> of the six
infinite families and every <math id="S4.SS5.p13.m4" class="ltx_Math" alttext="n\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n\geq 0</annotation></semantics></math>. Therefore
<math id="S4.SS5.p13.m5" class="ltx_Math" alttext="\Gamma(\mathsf{V}\times R)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝖵</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Gamma(\mathsf{V}\times R)</annotation></semantics></math> is not <math id="S4.SS5.p13.m6" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>-colorable.
∎</span></p>
</div>
