</table>
<p id="S4.SS4.p11.2" class="ltx_p"><span id="S4.SS4.p11.2.1" class="ltx_text">If <math id="S4.SS4.p11.m2" class="ltx_Math" alttext="\varphi(r_{2})=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\varphi(r_{2})=1</annotation></semantics></math>, the neighbors <math id="S4.SS4.p11.m3" class="ltx_Math" alttext="\pi_{1},r_{2},\beta_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mn>1</mn></msub><mo>,</mo><msub><mi>r</mi><mn>2</mn></msub><mo>,</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\pi_{1},r_{2},\beta_{1}</annotation></semantics></math> of
<math id="S4.SS4.p11.m4" class="ltx_Math" alttext="\ell_{5}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mn>5</mn></msub><annotation encoding="application/x-tex">\ell_{5}</annotation></semantics></math> have colors <math id="S4.SS4.p11.m5" class="ltx_Math" alttext="0,1,2" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">0,1,2</annotation></semantics></math>. If <math id="S4.SS4.p11.m6" class="ltx_Math" alttext="\varphi(r_{2})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\varphi(r_{2})=0</annotation></semantics></math>, the neighbors
<math id="S4.SS4.p11.m7" class="ltx_Math" alttext="r_{2},\pi_{4},\beta_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mn>2</mn></msub><mo>,</mo><msub><mi>π</mi><mn>4</mn></msub><mo>,</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">r_{2},\pi_{4},\beta_{1}</annotation></semantics></math> of <math id="S4.SS4.p11.m8" class="ltx_Math" alttext="\ell_{6}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mn>6</mn></msub><annotation encoding="application/x-tex">\ell_{6}</annotation></semantics></math> have colors <math id="S4.SS4.p11.m9" class="ltx_Math" alttext="0,1,2" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">0,1,2</annotation></semantics></math>. Thus
<math id="S4.SS4.p11.m10" class="ltx_Math" alttext="\varphi(r_{2})=2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\varphi(r_{2})=2</annotation></semantics></math>. We have</span></p>
<table id="S4.Ex56" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S4.Ex56X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex56X.m2" class="ltx_Math" alttext="\displaystyle\ell_{3}\sim r_{2},\pi_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>3</mn></msub><mo>∼</mo><msub><mi>r</mi><mn>2</mn></msub></mrow><mo>,</mo><msub><mi>π</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\ell_{3}\sim r_{2},\pi_{1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex56X.m3" class="ltx_Math" alttext="\displaystyle\Longrightarrow\varphi(\ell_{3})=1," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo stretchy="false">⟹</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">ℓ</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Longrightarrow\varphi(\ell_{3})=1,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex56Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex56Xa.m2" class="ltx_Math" alttext="\displaystyle\ell_{4}\sim r_{2},\pi_{4}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>4</mn></msub><mo>∼</mo><msub><mi>r</mi><mn>2</mn></msub></mrow><mo>,</mo><msub><mi>π</mi><mn>4</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\ell_{4}\sim r_{2},\pi_{4}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex56Xa.m3" class="ltx_Math" alttext="\displaystyle\Longrightarrow\varphi(\ell_{4})=0," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo stretchy="false">⟹</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">ℓ</mi><mn>4</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Longrightarrow\varphi(\ell_{4})=0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex56Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex56Xb.m2" class="ltx_Math" alttext="\displaystyle r_{1}\sim\ell_{3},\ell_{4}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>r</mi><mn>1</mn></msub><mo>∼</mo><msub><mi mathvariant="normal">ℓ</mi><mn>3</mn></msub></mrow><mo>,</mo><msub><mi mathvariant="normal">ℓ</mi><mn>4</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle r_{1}\sim\ell_{3},\ell_{4}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex56Xb.m3" class="ltx_Math" alttext="\displaystyle\Longrightarrow\varphi(r_{1})=2," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo stretchy="false">⟹</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>2</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Longrightarrow\varphi(r_{1})=2,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex56Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex56Xc.m2" class="ltx_Math" alttext="\displaystyle\ell_{1}\sim r_{1},\pi_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>1</mn></msub><mo>∼</mo><msub><mi>r</mi><mn>1</mn></msub></mrow><mo>,</mo><msub><mi>π</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\ell_{1}\sim r_{1},\pi_{1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex56Xc.m3" class="ltx_Math" alttext="\displaystyle\Longrightarrow\varphi(\ell_{1})=1," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo stretchy="false">⟹</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">ℓ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Longrightarrow\varphi(\ell_{1})=1,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex56Xd"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex56Xd.m2" class="ltx_Math" alttext="\displaystyle\ell_{2}\sim r_{1},\pi_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub><mo>∼</mo><msub><mi>r</mi><mn>1</mn></msub></mrow><mo>,</mo><msub><mi>π</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\ell_{2}\sim r_{1},\pi_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex56Xd.m3" class="ltx_Math" alttext="\displaystyle\Longrightarrow\varphi(\ell_{2})=0." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo stretchy="false">⟹</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Longrightarrow\varphi(\ell_{2})=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p11.3" class="ltx_p"><span id="S4.SS4.p11.3.1" class="ltx_text">The neighbors <math id="S4.SS4.p11.m11" class="ltx_Math" alttext="\ell_{2},\ell_{1},\beta_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub><mo>,</mo><msub><mi mathvariant="normal">ℓ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>β</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\ell_{2},\ell_{1},\beta_{2}</annotation></semantics></math> of <math id="S4.SS4.p11.m12" class="ltx_Math" alttext="\alpha_{2}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\alpha_{2}</annotation></semantics></math> have
colors <math id="S4.SS4.p11.m13" class="ltx_Math" alttext="0,1,2" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">0,1,2</annotation></semantics></math>, a contradiction.</span></p>
</div>
<div id="S4.SS4.p12" class="ltx_para">
<p id="S4.SS4.p12.1" class="ltx_p"><span id="S4.SS4.p12.1.1" class="ltx_text">All three cases are impossible. This proves the claim.
We may take</span></p>
<table id="S4.Ex57" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex57.m1" class="ltx_Math" alttext="\varphi(\pi_{2})=\varphi(\pi_{3})=\varphi(\pi_{4})=1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mn>4</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\varphi(\pi_{2})=\varphi(\pi_{3})=\varphi(\pi_{4})=1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p12.2" class="ltx_p"><span id="S4.SS4.p12.2.1" class="ltx_text">Every <math id="S4.SS4.p12.m1" class="ltx_Math" alttext="\beta_{i}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\beta_{i}</annotation></semantics></math> is adjacent to <math id="S4.SS4.p12.m2" class="ltx_Math" alttext="\pi_{2}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\pi_{2}</annotation></semantics></math>, which has color <math id="S4.SS4.p12.m3" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>.
Hence <math id="S4.SS4.p12.m4" class="ltx_Math" alttext="\varphi(\beta_{i})\in\{0,2\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>β</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo>,</mo><mn>2</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\varphi(\beta_{i})\in\{0,2\}</annotation></semantics></math>. For
<math id="S4.SS4.p12.m5" class="ltx_Math" alttext="1\leq i\leq n+1" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">1\leq i\leq n+1</annotation></semantics></math>, the vertex <math id="S4.SS4.p12.m6" class="ltx_Math" alttext="\alpha_{i}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\alpha_{i}</annotation></semantics></math> is adjacent to
<math id="S4.SS4.p12.m7" class="ltx_Math" alttext="\beta_{i},\beta_{i+1},\pi_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mi>i</mi></msub><mo>,</mo><msub><mi>β</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>π</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">\beta_{i},\beta_{i+1},\pi_{3}</annotation></semantics></math>. If <math id="S4.SS4.p12.m8" class="ltx_Math" alttext="\beta_{i}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\beta_{i}</annotation></semantics></math> and
<math id="S4.SS4.p12.m9" class="ltx_Math" alttext="\beta_{i+1}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\beta_{i+1}</annotation></semantics></math> had different colors, no color would be available for
<math id="S4.SS4.p12.m10" class="ltx_Math" alttext="\alpha_{i}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\alpha_{i}</annotation></semantics></math>. Thus <math id="S4.SS4.p12.m11" class="ltx_Math" alttext="\varphi(\beta_{i})=\varphi(\beta_{i+1})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>β</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>β</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\varphi(\beta_{i})=\varphi(\beta_{i+1})</annotation></semantics></math> for
every <math id="S4.SS4.p12.m12" class="ltx_Math" alttext="1\leq i\leq n+1" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">1\leq i\leq n+1</annotation></semantics></math>, and</span></p>
<table id="S4.Ex58" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex58.m1" class="ltx_Math" alttext="\varphi(\beta_{1})=\cdots=\varphi(\beta_{n+2})=b,\qquad b\in\{0,2\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>β</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">=</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">=</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>β</mi><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>b</mi></mrow><mo rspace="2.167em">,</mo><mrow><mi>b</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo>,</mo><mn>2</mn><mo stretchy="false">}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\varphi(\beta_{1})=\cdots=\varphi(\beta_{n+2})=b,\qquad b\in\{0,2\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.p12.3" class="ltx_p"><span id="S4.SS4.p12.3.1" class="ltx_text">Both <math id="S4.SS4.p12.m13" class="ltx_Math" alttext="\beta_{n+2}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\beta_{n+2}</annotation></semantics></math> and <math id="S4.SS4.p12.m14" class="ltx_Math" alttext="\ell_{2}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\ell_{2}</annotation></semantics></math> are adjacent to <math id="S4.SS4.p12.m15" class="ltx_Math" alttext="\pi_{2}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\pi_{2}</annotation></semantics></math>, so
their colors belong to <math id="S4.SS4.p12.m16" class="ltx_Math" alttext="\{0,2\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mn>0</mn><mo>,</mo><mn>2</mn><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{0,2\}</annotation></semantics></math>. If their colors were different,
no color would be available for <math id="S4.SS4.p12.m17" class="ltx_Math" alttext="\alpha_{n+2}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\alpha_{n+2}</annotation></semantics></math>, which is adjacent to
<math id="S4.SS4.p12.m18" class="ltx_Math" alttext="\beta_{n+2},\ell_{2},\pi_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow></msub><mo>,</mo><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub><mo>,</mo><msub><mi>π</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">\beta_{n+2},\ell_{2},\pi_{3}</annotation></semantics></math>. Hence
<math id="S4.SS4.p12.m19" class="ltx_Math" alttext="\varphi(\ell_{2})=\varphi(\beta_{n+2})=b" display="inline" intent=":literal"><semantics><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>β</mi><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>b</mi></mrow><annotation encoding="application/x-tex">\varphi(\ell_{2})=\varphi(\beta_{n+2})=b</annotation></semantics></math>.</span></p>
</div>
<div id="S4.SS4.p13" class="ltx_para">
<p id="S4.SS4.p13.1" class="ltx_p"><span id="S4.SS4.p13.1.1" class="ltx_text">Suppose first that <math id="S4.SS4.p13.m1" class="ltx_Math" alttext="b=2" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">b=2</annotation></semantics></math>. If <math id="S4.SS4.p13.m2" class="ltx_Math" alttext="\varphi(r_{2})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\varphi(r_{2})=0</annotation></semantics></math>, the neighbors
<math id="S4.SS4.p13.m3" class="ltx_Math" alttext="r_{2},\pi_{3},\beta_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mn>2</mn></msub><mo>,</mo><msub><mi>π</mi><mn>3</mn></msub><mo>,</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">r_{2},\pi_{3},\beta_{1}</annotation></semantics></math> of <math id="S4.SS4.p13.m4" class="ltx_Math" alttext="\ell_{6}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mn>6</mn></msub><annotation encoding="application/x-tex">\ell_{6}</annotation></semantics></math> have colors <math id="S4.SS4.p13.m5" class="ltx_Math" alttext="0,1,2" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">0,1,2</annotation></semantics></math>. If
<math id="S4.SS4.p13.m6" class="ltx_Math" alttext="\varphi(r_{2})=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\varphi(r_{2})=1</annotation></semantics></math>, the neighbors <math id="S4.SS4.p13.m7" class="ltx_Math" alttext="\pi_{1},r_{2},\beta_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mn>1</mn></msub><mo>,</mo><msub><mi>r</mi><mn>2</mn></msub><mo>,</mo><msub><mi>β</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\pi_{1},r_{2},\beta_{1}</annotation></semantics></math> of
<math id="S4.SS4.p13.m8" class="ltx_Math" alttext="\ell_{5}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mn>5</mn></msub><annotation encoding="application/x-tex">\ell_{5}</annotation></semantics></math> have colors <math id="S4.SS4.p13.m9" class="ltx_Math" alttext="0,1,2" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">0,1,2</annotation></semantics></math>. Thus <math id="S4.SS4.p13.m10" class="ltx_Math" alttext="\varphi(r_{2})=2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\varphi(r_{2})=2</annotation></semantics></math>, and</span></p>
<table id="S4.Ex59" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S4.Ex59X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex59X.m2" class="ltx_Math" alttext="\displaystyle\ell_{3}\sim r_{2},\pi_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>3</mn></msub><mo>∼</mo><msub><mi>r</mi><mn>2</mn></msub></mrow><mo>,</mo><msub><mi>π</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\ell_{3}\sim r_{2},\pi_{1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex59X.m3" class="ltx_Math" alttext="\displaystyle\Longrightarrow\varphi(\ell_{3})=1," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo stretchy="false">⟹</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">ℓ</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Longrightarrow\varphi(\ell_{3})=1,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex59Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex59Xa.m2" class="ltx_Math" alttext="\displaystyle\ell_{4}\sim r_{2},\pi_{4}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>4</mn></msub><mo>∼</mo><msub><mi>r</mi><mn>2</mn></msub></mrow><mo>,</mo><msub><mi>π</mi><mn>4</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\ell_{4}\sim r_{2},\pi_{4}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex59Xa.m3" class="ltx_Math" alttext="\displaystyle\Longrightarrow\varphi(\ell_{4})=0." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo stretchy="false">⟹</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">ℓ</mi><mn>4</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Longrightarrow\varphi(\ell_{4})=0.</annotation></semantics></math></td>
