<p id="S4.SS5.p10.3" class="ltx_p"><span id="S4.SS5.p10.3.1" class="ltx_text">Starting with <math id="S4.SS5.p10.m4" class="ltx_Math" alttext="\beta_{1}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\beta_{1}</annotation></semantics></math>, forward induction gives</span></p>
<table id="S4.Ex74" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex74.m1" class="ltx_Math" alttext="\varphi(\beta_{1})=\cdots=\varphi(\beta_{n+2})=2." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>β</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.1389em">=</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">=</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>β</mi><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>2</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\varphi(\beta_{1})=\cdots=\varphi(\beta_{n+2})=2.</annotation></semantics></math></td>
