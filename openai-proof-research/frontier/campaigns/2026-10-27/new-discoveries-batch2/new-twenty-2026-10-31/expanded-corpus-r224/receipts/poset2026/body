<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex73X.m3" class="ltx_Math" alttext="\displaystyle\Longrightarrow\varphi(\alpha_{i})=0," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo stretchy="false">⟹</mo><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Longrightarrow\varphi(\alpha_{i})=0,</annotation></semantics></math></td>
