<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex25.m2" class="ltx_Math" alttext="\displaystyle W^{q+1}(b_{1}+b_{1}^{\prime})\theta^{q+1}" display="inline" intent=":literal"><semantics><mrow><msup><mi>W</mi><mrow><mi>q</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>b</mi><mn>1</mn></msub><mo>+</mo><msubsup><mi>b</mi><mn>1</mn><mo>′</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>θ</mi><mrow><mi>q</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle W^{q+1}(b_{1}+b_{1}^{\prime})\theta^{q+1}</annotation></semantics></math></td>
