<p id="S1.SSx1.p3.2" class="ltx_p">and similarly we can define <math id="S1.SSx1.p3.m11" class="ltx_Math" alttext="Z^{\sigma_{\Lambda},-}_{G,v}(\beta,\gamma,\lambda),Z^{\sigma_{\Lambda},+,-}_{G,v,u}(\beta,\gamma,\lambda),Z^{\sigma_{\Lambda},-,+}_{G,v,u}(\beta,\gamma,\lambda)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>,</mo><mi>v</mi></mrow><mrow><msub><mi>σ</mi><mi mathvariant="normal">Λ</mi></msub><mo rspace="0em">,</mo><mo lspace="0em">−</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo>,</mo><mi>γ</mi><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>,</mo><mi>v</mi><mo>,</mo><mi>u</mi></mrow><mrow><msub><mi>σ</mi><mi mathvariant="normal">Λ</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">+</mo><mo rspace="0em">,</mo><mo lspace="0em">−</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo>,</mo><mi>γ</mi><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>,</mo><mi>v</mi><mo>,</mo><mi>u</mi></mrow><mrow><msub><mi>σ</mi><mi mathvariant="normal">Λ</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">−</mo><mo rspace="0em">,</mo><mo lspace="0em">+</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo>,</mo><mi>γ</mi><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Z^{\sigma_{\Lambda},-}_{G,v}(\beta,\gamma,\lambda),Z^{\sigma_{\Lambda},+,-}_{G,v,u}(\beta,\gamma,\lambda),Z^{\sigma_{\Lambda},-,+}_{G,v,u}(\beta,\gamma,\lambda)</annotation></semantics></math> and <math id="S1.SSx1.p3.m12" class="ltx_Math" alttext="Z^{\sigma_{\Lambda},-,-}_{G,v,u}(\beta,\gamma,\lambda)." display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>,</mo><mi>v</mi><mo>,</mo><mi>u</mi></mrow><mrow><msub><mi>σ</mi><mi mathvariant="normal">Λ</mi></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">−</mo><mo rspace="0em">,</mo><mo lspace="0em">−</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo>,</mo><mi>γ</mi><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Z^{\sigma_{\Lambda},-,-}_{G,v,u}(\beta,\gamma,\lambda).</annotation></semantics></math></p>
