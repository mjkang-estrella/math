​</mo><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>,</mo><mi>u</mi></mrow><mrow><msub><mi>σ</mi><mi mathvariant="normal">Λ</mi></msub><mo rspace="0em">,</mo><mo lspace="0em">+</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{Z_{G,u}^{\sigma_{\Lambda},+}(\lambda)Z_{G,v}^{\sigma_{\Lambda},+}(\lambda)-Z_{G,v,u}^{\sigma_{\Lambda},+,+}(\lambda)Z_{G}^{\sigma_{\Lambda}}(\lambda)}{Z_{G}^{\sigma_{\Lambda}}(\lambda)Z_{G,u}^{\sigma_{\Lambda},+}(\lambda)}</annotation></semantics></math></td>
