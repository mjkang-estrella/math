><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mi>σ</mi><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo rspace="0em">=</mo><mo lspace="0em">+</mo></mrow></mfrac></msub><mi>β</mi><mi>λ</mi><msub><mrow></mrow><mi>w</mi></msub><mo>)</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\lambda_{v}\left(\sum_{\sigma:V\backslash\{v\}\rightarrow\{+,-\}}\beta^{m^{\prime}(\sigma)}\prod\limits_{w\in V\backslash(N(v)\cup\{v\})\atop\sigma(w)=+}\lambda_{w}\prod\limits_{w\in N(v)\atop\sigma(w)=+}\beta\lambda_{w}\right)</annotation></semantics></math></td>
