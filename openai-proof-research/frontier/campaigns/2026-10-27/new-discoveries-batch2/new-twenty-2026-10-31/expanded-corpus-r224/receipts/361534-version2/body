<p id="S5.p10.4" class="ltx_p"><span id="S5.p10.4.1" class="ltx_text">where <math id="S5.p10.m31" class="ltx_Math" alttext="\lambda^{v^{-}}_{w}=\lambda_{w}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>λ</mi><mi>w</mi><msup><mi>v</mi><mo>−</mo></msup></msubsup><mo>=</mo><msub><mi>λ</mi><mi>w</mi></msub></mrow><annotation encoding="application/x-tex">\lambda^{v^{-}}_{w}=\lambda_{w}</annotation></semantics></math> for <math id="S5.p10.m32" class="ltx_Math" alttext="w\in V\backslash(N(v)\cup\{v\})" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>∈</mo><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">\</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>v</mi><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">w\in V\backslash(N(v)\cup\{v\})</annotation></semantics></math> and <math id="S5.p10.m33" class="ltx_Math" alttext="\lambda^{v^{-}}_{w}=\lambda_{w}/\beta" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>λ</mi><mi>w</mi><msup><mi>v</mi><mo>−</mo></msup></msubsup><mo>=</mo><mrow><msub><mi>λ</mi><mi>w</mi></msub><mo>/</mo><mi>β</mi></mrow></mrow><annotation encoding="application/x-tex">\lambda^{v^{-}}_{w}=\lambda_{w}/\beta</annotation></semantics></math> for <math id="S5.p10.m34" class="ltx_Math" alttext="w\in N(v)" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>∈</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">w\in N(v)</annotation></semantics></math>.</span></p>
