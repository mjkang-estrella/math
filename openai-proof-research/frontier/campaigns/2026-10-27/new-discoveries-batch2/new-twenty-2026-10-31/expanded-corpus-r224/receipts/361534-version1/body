<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex39Xa.m2" class="ltx_Math" alttext="\displaystyle=\frac{Z_{G,u}^{\sigma_{\Lambda},+}Z_{G,v}^{\sigma_{\Lambda},+}-Z_{G,v,u}^{\sigma_{\Lambda},+,+}Z_{G}^{\sigma_{\Lambda}}}{Z_{G}^{\sigma_{\Lambda}}Z_{G,u}^{\sigma_{\Lambda},+}}(z\boldsymbol{\lambda})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Z</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi></mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">,</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">+</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Z</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">,</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">+</mo></mrow></msubsup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Z</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</m