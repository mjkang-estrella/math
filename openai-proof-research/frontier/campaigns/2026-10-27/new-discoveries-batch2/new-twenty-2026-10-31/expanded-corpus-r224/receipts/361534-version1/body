<p id="S5.p5.3" class="ltx_p"><span id="S5.p5.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">Clearly, <math id="S5.p5.m34" class="ltx_Math" alttext="|\lambda_{w}^{\sigma_{\Lambda}}|&gt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&gt;</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><annotation encoding="application/x-tex">|\lambda_{w}^{\sigma_{\Lambda}}|&gt;1</annotation></semantics></math> if <math id="S5.p5.m35" class="ltx_Math" alttext="|\lambda_{w}|&gt;\beta^{d}" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&gt;</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi></msup></mrow><annotation encoding="application/x-tex">|\lambda_{w}|&gt;\beta^{d}</annotation></semantics></math> and <math id="S5.p5.m36" class="ltx_Math" alttext="|\lambda_{w}^{\sigma_{\Lambda}}|&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&lt;</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><annotation encoding="application/x-tex">|\lambda_{w}^{\sigma_{\Lambda}}|&lt;1</annotation></semantics></math> if <math id="S5.p5.m37" class="ltx_Math" alttext="|\lambda_{w}|&lt;\beta^{-d}" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&lt;</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">|\lambda_{w}|&lt;\beta^{-d}</annotation></semantics></math>.
If for all <math id="S5.p5.m38" class="ltx_Math" alttext="v\in V" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi></mrow><annotation encoding="application/x-tex">v\in V</annotation></semantics></math>, <math id="S5.p5.m39" class="ltx_Math" alttext="|\lambda_{v}|&gt;\beta^{d}" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&gt;</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi></msup></mrow><annotation encoding="application/x-tex">|\lambda_{v}|&gt;\beta^{d}</annotation></semantics></math> or <math id="S5.p5.m40" class="ltx_Math" alttext="0&lt;|\lambda_{v}|&lt;1/\beta^{d}" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&lt;</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&lt;</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">0&lt;|\lambda_{v}|&lt;1/\beta^{d}</annotation></semantics></math>, then <math id="S5.p5.m41" class="ltx_Math" alttext="Z_{G\backslash\Lambda}(\beta,\boldsymbol{\lambda}^{\sigma_{\Lambda}})\neq 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Z</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">\</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝝀</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≠</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><annotation encoding="application/x-tex">Z_{G\backslash\Lambda}(\beta,\boldsymbol{\lambda}^{\sigma_{\Lambda}})\neq 0</annotation></semantics></math> by Theorem <a href="#Thmtheorem35" title="Theorem 35 (Lee-Yang circle theorem). ‣ 5 SSM for the ferromagnetic Ising model ‣ From Zero-Freeness to Strong Spatial Mixing viaa Christoffel-Darboux Type Identity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">35</span></a>.
Thus, <math id="S5.p5.m42" class="ltx_Math" alttext="Z_{G}^{\sigma_{\Lambda}}(\beta,\boldsymbol{\lambda})\neq 0" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Z</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝝀</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≠</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><annotation encoding="application/x-tex">Z_{G}^{\sigma_{\Lambda}}(\beta,\boldsymbol{\lambda})\neq 0</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S5.p6" class="ltx_para">
<p id="S5.p6.1" class="ltx_p"><span id="S5.p6.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">For the ferromagnetic Ising model with a uniform external field, we can combine Corollary </span><a href="#Thmtheorem36" title="Corollary 36. ‣ 5 SSM for the ferromagnetic Ising model ‣ From Zero-Freeness to Strong Spatial Mixing viaa Christoffel-Darboux Type Identity" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">36</span></a><span id="S5.p6.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> with Theorem </span><a href="#Thmtheorem26" title="Theorem 26. ‣ 3.5 From an arbitrary region to the unit disk ‣ 3 Zero-freeness implies SSM for 𝜆 ‣ From Zero-Freeness to Strong Spatial Mixing viaa Christoffel-Darboux Type Identity" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">26</span></a><span id="S5.p6.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> to get SSM.</span></p>
</div>
<div id="Thmtheorem37" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem" style="--ltx-fg-color:#000000;"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem37.2" class="ltx_text ltx_font_bold">Theorem 37</span></span><span id="Thmtheorem37.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem37.p1" class="ltx_para">
<p id="Thmtheorem37.p1.1" class="ltx_p"><span id="Thmtheorem37.p1.1.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#000000;">Fix <math id="Thmtheorem37.p1.m1" class="ltx_Math" alttext="\beta&gt;1" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&gt;</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><annotation encoding="application/x-tex">\beta&gt;1</annotation></semantics></math> and integer <math id="Thmtheorem37.p1.m2" class="ltx_Math" alttext="d\geq 2" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≥</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></mrow><annotation encoding="application/x-tex">d\geq 2</annotation></semantics></math>.
The ferromagnetic Ising model on graphs of degree at most <math id="Thmtheorem37.p1.m3" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> specified by <math id="Thmtheorem37.p1.m4" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> and a complex external field <math id="Thmtheorem37.p1.m5" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> exhibits SSM if <math id="Thmtheorem37.p1.m6" class="ltx_Math" alttext="|\lambda|&gt;\beta^{d}" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&gt;</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi></msup></mrow><annotation encoding="application/x-tex">|\lambda|&gt;\beta^{d}</annotation></semantics></math> or <math id="Thmtheorem37.p1.m7" class="ltx_Math" alttext="0&lt;|\lambda|&lt;1/\beta^{d}" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&lt;</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&lt;</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">0&lt;|\lambda|&lt;1/\beta^{d}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S5.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof" style="--ltx-fg-color:#000000;">Proof.</h6>
<div id="S5.p7" class="ltx_para">
<p id="S5.p7.1" class="ltx_p"><span id="S5.p7.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">We first consider the case that <math id="S5.p7.m1" class="ltx_Math" alttext="0&lt;|\lambda|&lt;1/\beta^{d}" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&lt;</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&lt;</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">0&lt;|\lambda|&lt;1/\beta^{d}</annotation></semantics></math>.
Take the sets <math id="S5.p7.m2" class="ltx_Math" alttext="U_{1}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><annotation encoding="application/x-tex">U_{1}</annotation></semantics></math>, <math id="S5.p7.m3" class="ltx_Math" alttext="U_{2}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub><annotation encoding="application/x-tex">U_{2}</annotation></semantics></math> and <math id="S5.p7.m4" class="ltx_Math" alttext="U_{3}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msub><annotation encoding="application/x-tex">U_{3}</annotation></semantics></math> in Theorem <a href="#Thmtheorem26" title="Theorem 26. ‣ 3.5 From an arbitrary region to the unit disk ‣ 3 Zero-freeness implies SSM for 𝜆 ‣ From Zero-Freeness to Strong Spatial Mixing viaa Christoffel-Darboux Type Identity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a> to be <math id="S5.p7.m5" class="ltx_Math" alttext="\{\beta\}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\beta\}</annotation></semantics></math>, <math id="S5.p7.m6" class="ltx_Math" alttext="\{\beta\}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\beta\}</annotation></semantics></math> and <math id="S5.p7.m7" class="ltx_Math" alttext="\mathbb{D}_{1/\beta^{d}}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔻</mi><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi></msup></mrow></msub><annotation encoding="application/x-tex">\mathbb{D}_{1/\beta^{d}}</annotation></semantics></math> respectively.
By Corollary <a href="#Thmtheorem36" title="Corollary 36. ‣ 5 SSM for the ferromagnetic Ising model ‣ From Zero-Freeness to Strong Spatial Mixing viaa Christoffel-Darboux Type Identity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">36</span></a>, the partition function of the Ising model on graphs of degree at most <math id="S5.p7.m8" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> is zero-free on <math id="S5.p7.m9" class="ltx_Math" alttext="\mathbf{U}=U_{1}\times U_{2}\times(U_{3}\backslash\{0\})" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐔</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msub><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">\</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{U}=U_{1}\times U_{2}\times(U_{3}\backslash\{0\})</annotation></semantics></math>.
By Theorem <a href="#Thmtheorem26" title="Theorem 26. ‣ 3.5 From an arbitrary region to the unit disk ‣ 3 Zero-freeness implies SSM for 𝜆 ‣ From Zero-Freeness to Strong Spatial Mixing viaa Christoffel-Darboux Type Identity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a>, the corresponding Ising model exhibits SSM.</span></p>
</div>
<div id="S5.p8" class="ltx_para">
<p id="S5.p8.1" class="ltx_p"><span id="S5.p8.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">For the case that <math id="S5.p8.m1" class="ltx_Math" alttext="|\lambda|&gt;\beta^{d}" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&gt;</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi></msup></mrow><annotation encoding="application/x-tex">|\lambda|&gt;\beta^{d}</annotation></semantics></math>, notice that by switching the meanings of <math id="S5.p8.m2" class="ltx_Math" alttext="+" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><annotation encoding="application/x-tex">+</annotation></semantics></math> and <math id="S5.p8.m3" class="ltx_Math" alttext="-" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><annotation encoding="application/x-tex">-</annotation></semantics></math> spins, the Ising model with an external field <math id="S5.p8.m4" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> can be transferred to the Ising model with the external field <math id="S5.p8.m5" class="ltx_Math" alttext="1/\lambda" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi></mrow><annotation encoding="application/x-tex">1/\lambda</annotation></semantics></math> (see Remark <a href="#Thmremark6" title="Remark 6. ‣ 5 SSM for the ferromagnetic Ising model ‣ From Zero-Freeness to Strong Spatial Mixing viaa Christoffel-Darboux Type Identity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> below).
Since <math id="S5.p8.m6" class="ltx_Math" alttext="|\lambda|&gt;\beta^{d}" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&gt;</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi></msup></mrow><annotation encoding="application/x-tex">|\lambda|&gt;\beta^{d}</annotation></semantics></math>, we have <math id="S5.p8.m7" class="ltx_Math" alttext="0&lt;|1/\lambda|&lt;1/\beta^{d}" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&lt;</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&lt;</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">0&lt;|1/\lambda|&lt;1/\beta^{d}</annotation></semantics></math>.
Thus, SSM also holds for the case that <math id="S5.p8.m8" class="ltx_Math" alttext="|\lambda|&gt;\beta^{d}" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&gt;</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi></msup></mrow><annotation encoding="application/x-tex">|\lambda|&gt;\beta^{d}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="Thmremark6" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem" style="--ltx-fg-color:#000000;"><span class="ltx_tag ltx_tag_theorem"><span id="Thmremark6.2" class="ltx_text ltx_font_bold">Remark 6</span></span><span id="Thmremark6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmremark6.p1" class="ltx_para">
<p id="Thmremark6.p1.1" class="ltx_p"><span id="Thmremark6.p1.1.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#000000;">In fact, one can check the following <em id="Thmremark6.p1.1.1.1" class="ltx_emph ltx_font_upright">spin reversal symmetry</em> holds for the 2-spin system with non-uniform external fields.
For any graph <math id="Thmremark6.p1.m1" class="ltx_Math" alttext="G=(V,E)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G=(V,E)</annotation></semantics></math> and
any partial configuration <math id="Thmremark6.p1.m2" class="ltx_Math" alttext="\sigma_{\Lambda}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub><annotation encoding="application/x-tex">\sigma_{\Lambda}</annotation></semantics></math> on <math id="Thmremark6.p1.m3" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>,</span></p>
<table id="S5.Ex38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex38.m1" class="ltx_Math" alttext="Z_{G}^{\sigma_{\Lambda}}(\beta,\gamma,\boldsymbol{\lambda})=Z_{G}^{\overline{\sigma}_{\Lambda}}(\gamma,\beta,\boldsymbol{\lambda}^{-1})\prod_{v\in V}\lambda_{v}" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Z</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝝀</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Z</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="true">¯</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝝀</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∏</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi></mrow></munder><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">Z_{G}^{\sigma_{\Lambda}}(\beta,\gamma,\boldsymbol{\lambda})=Z_{G}^{\overline{\sigma}_{\Lambda}}(\gamma,\beta,\boldsymbol{\lambda}^{-1})\prod_{v\in V}\lambda_{v}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmremark6.p1.2" class="ltx_p"><span id="Thmremark6.p1.2.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#000000;">where <math id="Thmremark6.p1.m4" class="ltx_Math" alttext="\boldsymbol{\lambda}^{-1}=(\lambda_{v}^{-1})_{v\in V}" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝛌</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msub><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\boldsymbol{\lambda}^{-1}=(\lambda_{v}^{-1})_{v\in V}</annotation></semantics></math> and <math id="Thmremark6.p1.m5" class="ltx_Math" alttext="\overline{\sigma}_{\Lambda}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="true">¯</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub><annotation encoding="application/x-tex">\overline{\sigma}_{\Lambda}</annotation></semantics></math> is the partial configuration on <math id="Thmremark6.p1.m6" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> such that <math id="Thmremark6.p1.m7" class="ltx_Math" alttext="\overline{\sigma}_{\Lambda}(w)=\overline{\sigma_{\Lambda}(w)}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="true">¯</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mover accent="true"><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="true">¯</mo></mover></mrow><annotation encoding="application/x-tex">\overline{\sigma}_{\Lambda}(w)=\overline{\sigma_{\Lambda}(w)}</annotation></semantics></math> (i.e., the spin <math id="Thmremark6.p1.m8" class="ltx_Math" alttext="\sigma_{\Lambda}(w)" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\sigma_{\Lambda}(w)</annotation></semantics></math> imposed to <math id="Thmremark6.p1.m9" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> is flipped).</span></p>
</div>
</div>
<div id="S5.p9" class="ltx_para">
<p id="S5.p9.1" class="ltx_p"><span id="S5.p9.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">In order to obtain SSM for the ferromagnetic Ising model with non-uniform external fields,
we need to extend Theorem </span><a href="#Thmtheorem26" title="Theorem 26. ‣ 3.5 From an arbitrary region to the unit disk ‣ 3 Zero-freeness implies SSM for 𝜆 ‣ From Zero-Freeness to Strong Spatial Mixing viaa Christoffel-Darboux Type Identity" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">26</span></a><span id="S5.p9.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> to deal with the multivariate partition function on non-uniform external fields </span><math id="S5.p9.m1" class="ltx_Math" alttext="\boldsymbol{\lambda}=(\lambda_{v})_{v\in V}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝝀</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msub><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\boldsymbol{\lambda}=(\lambda_{v})_{v\in V}</annotation></semantics></math><span id="S5.p9.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">.
We give the following result.</span></p>
</div>
<div id="Thmtheorem38" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem" style="--ltx-fg-color:#000000;"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem38.2" class="ltx_text ltx_font_bold">Lemma 38</span></span><span id="Thmtheorem38.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem38.p1" class="ltx_para">
<p id="Thmtheorem38.p1.1" class="ltx_p"><span id="Thmtheorem38.p1.1.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#000000;">Fix <math id="Thmtheorem38.p1.m1" class="ltx_Math" alttext="\beta,\gamma,\lambda^{\ast}&gt;0" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&gt;</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow></mrow><annotation encoding="application/x-tex">\beta,\gamma,\lambda^{\ast}&gt;0</annotation></semantics></math> and a family of graphs <math id="Thmtheorem38.p1.m2" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math>.
Suppose that for any <math id="Thmtheorem38.p1.m3" class="ltx_Math" alttext="G\in\mathcal{G}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒢</mi></mrow><annotation encoding="application/x-tex">G\in\mathcal{G}</annotation></semantics></math> and any feasible partial configuration <math id="Thmtheorem38.p1.m4" class="ltx_Math" alttext="\sigma_{\Lambda}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub><annotation encoding="application/x-tex">\sigma_{\Lambda}</annotation></semantics></math>, the partition function <math id="Thmtheorem38.p1.m5" class="ltx_Math" alttext="Z^{\sigma_{\Lambda}}_{G,\beta,\gamma}(\boldsymbol{\lambda})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Z</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝛌</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Z^{\sigma_{\Lambda}}_{G,\beta,\gamma}(\boldsymbol{\lambda})</annotation></semantics></math> of the 2-spin system with non-uniform external fields <math id="Thmtheorem38.p1.m6" class="ltx_Math" alttext="\boldsymbol{\lambda}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝛌</mi><annotation encoding="application/x-tex">\boldsymbol{\lambda}</annotation></semantics></math> is zero-free on <math id="Thmtheorem38.p1.m7" class="ltx_Math" alttext="(\mathbb{D}_{\lambda^{\ast}}\backslash\{0\})^{|V(G)|}" display="inline" intent=":literal"><semantics><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔻</mi><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo></msup></msub><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">\</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow></msup><annotation encoding="application/x-tex">(\mathbb{D}_{\lambda^{\ast}}\backslash\{0\})^{|V(G)|}</annotation></semantics></math>.
Then, for any <math id="Thmtheorem38.p1.m8" class="ltx_Math" alttext="\boldsymbol{\lambda}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝛌</mi><annotation encoding="application/x-tex">\boldsymbol{\lambda}</annotation></semantics></math> satisfying <math id="Thmtheorem38.p1.m9" class="ltx_Math" alttext="\lambda_{v}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&gt;</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><annotation encoding="application/x-tex">\lambda_{v}&gt;0</annotation></semantics></math> for all <math id="Thmtheorem38.p1.m10" class="ltx_Math" alttext="v\in V(G)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">v\in V(G)</annotation></semantics></math> and <math id="Thmtheorem38.p1.m11" class="ltx_Math" alttext="\sup_{v\in V(G)}\lambda_{v}&lt;\lambda^{\ast}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></msub><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&lt;</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo></msup></mrow><annotation encoding="application/x-tex">\sup_{v\in V(G)}\lambda_{v}&lt;\lambda^{\ast}</annotation></semantics></math>,
the corresponding 2-spin system
exhibits SSM.</span></p>
</div>
</div>
<div id="S5.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof" style="--ltx-fg-color:#000000;">Proof.</h6>
<div id="S5.p10" class="ltx_para">
<p id="S5.p10.1" class="ltx_p"><span id="S5.p10.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Sine the SAW tree construction and Theorem <a href="#Thmtheorem8" title="Theorem 8. ‣ 2.2 Weitz’s algorithm and self-avoiding walk tree ‣ 2 Preliminaries ‣ From Zero-Freeness to Strong Spatial Mixing viaa Christoffel-Darboux Type Identity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a> still hold for the 2-spin system with non-uniform external fields, we only need to consider the 2-spin system on trees.</span></p>
</div>
<div id="S5.p11" class="ltx_para">
<p id="S5.p11.1" class="ltx_p"><span id="S5.p11.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">For a graph <math id="S5.p11.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>, a feasible partial configuration <math id="S5.p11.m2" class="ltx_Math" alttext="\sigma_{\Lambda}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub><annotation encoding="application/x-tex">\sigma_{\Lambda}</annotation></semantics></math> together with a vertex <math id="S5.p11.m3" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> proper to it, and some fixed values <math id="S5.p11.m4" class="ltx_Math" alttext="\boldsymbol{\lambda}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝝀</mi><annotation encoding="application/x-tex">\boldsymbol{\lambda}</annotation></semantics></math> of external fields satisfying <math id="S5.p11.m5" class="ltx_Math" alttext="\lambda_{v}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&gt;</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><annotation encoding="application/x-tex">\lambda_{v}&gt;0</annotation></semantics></math> for all <math id="S5.p11.m6" class="ltx_Math" alttext="v\in V(G)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">v\in V(G)</annotation></semantics></math> and <math id="S5.p11.m7" class="ltx_Math" alttext="\sup_{v\in V(G)}\lambda_{v}&lt;\lambda^{\ast}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">sup</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></msub><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&lt;</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo></msup></mrow><annotation encoding="application/x-tex">\sup_{v\in V(G)}\lambda_{v}&lt;\lambda^{\ast}</annotation></semantics></math>, we define the function <math id="S5.p11.m8" class="ltx_Math" alttext="p_{G,v}^{\sigma_{\Lambda}}(z)=P_{G,v}^{\sigma_{\Lambda}}(z\boldsymbol{\lambda})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">P</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝝀</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p_{G,v}^{\sigma_{\Lambda}}(z)=P_{G,v}^{\sigma_{\Lambda}}(z\boldsymbol{\lambda})</annotation></semantics></math> for <math id="S5.p11.m9" class="ltx_Math" alttext="z\in\mathbb{D}_{\rho}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔻</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></msub></mrow><annotation encoding="application/x-tex">z\in\mathbb{D}_{\rho}</annotation></semantics></math> where <math id="S5.p11.m10" class="ltx_Math" alttext="\rho=\frac{\lambda^{*}}{\sup\lambda_{v}}&gt;1." display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo></msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">sup</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></msub></mrow></mfrac><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&gt;</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\rho=\frac{\lambda^{*}}{\sup\lambda_{v}}&gt;1.</annotation></semantics></math>
Note that <math id="S5.p11.m11" class="ltx_Math" alttext="p_{G,v}^{\sigma_{\Lambda}}(z)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{G,v}^{\sigma_{\Lambda}}(z)</annotation></semantics></math> is a univariate function on the complex variable <math id="S5.p11.m12" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math>.
Since the partition function
<math id="S5.p11.m13" class="ltx_Math" alttext="Z^{\sigma_{\Lambda}}_{G,\beta,\gamma}(\boldsymbol{\lambda})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Z</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝝀</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Z^{\sigma_{\Lambda}}_{G,\beta,\gamma}(\boldsymbol{\lambda})</annotation></semantics></math> is zero-free on <math id="S5.p11.m14" class="ltx_Math" alttext="(\mathbb{D}_{\lambda^{\ast}}\backslash\{0\})^{|V(G)|}" display="inline" intent=":literal"><semantics><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔻</mi><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo></msup></msub><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">\</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow></msup><annotation encoding="application/x-tex">(\mathbb{D}_{\lambda^{\ast}}\backslash\{0\})^{|V(G)|}</annotation></semantics></math>, the function <math id="S5.p11.m15" class="ltx_Math" alttext="p_{G,v}^{\sigma_{\Lambda}}(z)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{G,v}^{\sigma_{\Lambda}}(z)</annotation></semantics></math> avoids <math id="S5.p11.m16" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> and <math id="S5.p11.m17" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> on <math id="S5.p11.m18" class="ltx_Math" alttext="\mathbb{D}_{\rho}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔻</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></msub><annotation encoding="application/x-tex">\mathbb{D}_{\rho}</annotation></semantics></math>.</span></p>
</div>
<div id="S5.p12" class="ltx_para">
<p id="S5.p12.1" class="ltx_p"><span id="S5.p12.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Fix the values of <math id="S5.p12.m1" class="ltx_Math" alttext="\boldsymbol{\lambda}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝝀</mi><annotation encoding="application/x-tex">\boldsymbol{\lambda}</annotation></semantics></math>.
Still by Montel theorem, for any graph <math id="S5.p12.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>, any feasible partial configuration <math id="S5.p12.m3" class="ltx_Math" alttext="\sigma_{\Lambda}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub><annotation encoding="application/x-tex">\sigma_{\Lambda}</annotation></semantics></math>, and any vertex <math id="S5.p12.m4" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> proper to it, the functions <math id="S5.p12.m5" class="ltx_Math" alttext="p_{G,v}^{\sigma_{\Lambda}}(z)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{G,v}^{\sigma_{\Lambda}}(z)</annotation></semantics></math> form a normal family.
Also, all functions in the family take a value in the interval <math id="S5.p12.m6" class="ltx_Math" alttext="(0,1)" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,1)</annotation></semantics></math> when <math id="S5.p12.m7" class="ltx_Math" alttext="z=1" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><annotation encoding="application/x-tex">z=1</annotation></semantics></math>.
Still similar to the proof Lemma <a href="#Thmtheorem24" title="Lemma 24. ‣ 3.4 Zero-freeness implies a uniform bound on a circle ‣ 3 Zero-freeness implies SSM for 𝜆 ‣ From Zero-Freeness to Strong Spatial Mixing viaa Christoffel-Darboux Type Identity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>, we can show that for any <math id="S5.p12.m8" class="ltx_Math" alttext="0&lt;\rho_{0}&lt;\rho" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&lt;</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&lt;</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></mrow><annotation encoding="application/x-tex">0&lt;\rho_{0}&lt;\rho</annotation></semantics></math>, there exists a uniform bound for the family of functions <math id="S5.p12.m9" class="ltx_Math" alttext="p_{G,v}^{\sigma_{\Lambda}}(z)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{G,v}^{\sigma_{\Lambda}}(z)</annotation></semantics></math> on the circle <math id="S5.p12.m10" class="ltx_Math" alttext="\partial\mathbb{D}_{\rho_{0}}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∂</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔻</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub></msub></mrow><annotation encoding="application/x-tex">\partial\mathbb{D}_{\rho_{0}}</annotation></semantics></math>.</span></p>
</div>
<div id="S5.p13" class="ltx_para">
<p id="S5.p13.1" class="ltx_p"><span id="S5.p13.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">By zero-freeness, the functions <math id="S5.p13.m1" class="ltx_Math" alttext="p_{G,v}^{\sigma_{\Lambda}}(z)=P_{G,v}^{\sigma_{\Lambda}}(z\boldsymbol{\lambda})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">P</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝝀</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p_{G,v}^{\sigma_{\Lambda}}(z)=P_{G,v}^{\sigma_{\Lambda}}(z\boldsymbol{\lambda})</annotation></semantics></math> avoid <math id="S5.p13.m2" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> and <math id="S5.p13.m3" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> on <math id="S5.p13.m4" class="ltx_Math" alttext="\mathbb{D}_{\rho}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔻</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></msub><annotation encoding="application/x-tex">\mathbb{D}_{\rho}</annotation></semantics></math> where <math id="S5.p13.m5" class="ltx_Math" alttext="\rho=\frac{\lambda^{*}}{\sup\lambda_{v}}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo></msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">sup</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></msub></mrow></mfrac></mrow><annotation encoding="application/x-tex">\rho=\frac{\lambda^{*}}{\sup\lambda_{v}}</annotation></semantics></math>, hence form a normal family by Montel theorem. Since <math id="S5.p13.m6" class="ltx_Math" alttext="p_{G,v}^{\sigma_{\Lambda}}(1)\in[0,1]," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">p_{G,v}^{\sigma_{\Lambda}}(1)\in[0,1],</annotation></semantics></math> this family should be locally bounded, hence we obtain uniform bound on circle <math id="S5.p13.m7" class="ltx_Math" alttext="\partial\mathbb{D}_{\rho_{0}}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∂</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔻</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub></msub></mrow><annotation encoding="application/x-tex">\partial\mathbb{D}_{\rho_{0}}</annotation></semantics></math> for all <math id="S5.p13.m8" class="ltx_Math" alttext="0&lt;\rho_{0}&lt;\rho." display="inline" intent=":literal"><semantics><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&lt;</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&lt;</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">0&lt;\rho_{0}&lt;\rho.</annotation></semantics></math></span></p>
</div>
<div id="S5.p14" class="ltx_para">
<p id="S5.p14.1" class="ltx_p"><span id="S5.p14.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Also, by the Christoffel-Darboux type identity (Theorem <a href="#Thmtheorem22" title="Theorem 22. ‣ 3.3 Zero-freeness implies local dependence of coefficients ‣ 3 Zero-freeness implies SSM for 𝜆 ‣ From Zero-Freeness to Strong Spatial Mixing viaa Christoffel-Darboux Type Identity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>) for the 2-spin system with non-uniform external fields in which <math id="S5.p14.m1" class="ltx_Math" alttext="\lambda^{d(u,v)+1}" display="inline" intent=":literal"><semantics><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msup><annotation encoding="application/x-tex">\lambda^{d(u,v)+1}</annotation></semantics></math> is replace by <math id="S5.p14.m2" class="ltx_Math" alttext="\prod_{w\in p_{uv}}\lambda_{w}" display="inline" intent=":literal"><semantics><mrow><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∏</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow></msub></mrow></msub><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi></msub></mrow><annotation encoding="application/x-tex">\prod_{w\in p_{uv}}\lambda_{w}</annotation></semantics></math> where <math id="S5.p14.m3" class="ltx_Math" alttext="p_{uv}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow></msub><annotation encoding="application/x-tex">p_{uv}</annotation></semantics></math> is the unique path connecting <math id="S5.p14.m4" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> and <math id="S5.p14.m5" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math>, we have</span></p>
</div>
