<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex36.m1" class="ltx_Math" alttext="Z_{G}^{\sigma_{\Lambda}}(\beta,\boldsymbol{\lambda})=\beta^{m_{1}+m_{2}}Z_{G\backslash\Lambda}(\beta,\boldsymbol{\lambda}^{\sigma_{\Lambda}})\prod_{w\in\Lambda\atop\sigma_{\Lambda}(w)=+}\lambda_{w}" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Z</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝝀</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">m</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">m</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Z</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">\</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝝀</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∏</mo><mfrac style="--ltx-fg-color:#000000;" linethickness="0pt" mathcolor="#000000"><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">=</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">+</mo></mrow></mfrac></munder><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">Z_{G}^{\sigma_{\Lambda}}(\beta,\boldsymbol{\lambda})=\beta^{m_{1}+m_{2}}Z_{G\backslash\Lambda}(\beta,\boldsymbol{\lambda}^{\sigma_{\Lambda}})\prod_{w\in\Lambda\atop\sigma_{\Lambda}(w)=+}\lambda_{w}</annotation></semantics></math></td>
