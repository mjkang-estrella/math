="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">d</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">z</mi></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">|</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum\limits_{k\geq n+1}\dfrac{|z-z_{0}|^{k}}{2\pi}\int_{\partial\mathbb{D}_{\rho}(z_{0})}\left|\dfrac{P(z)-Q(z)}{(z-z_{0})^{k+1}}\mathrm{d}z\right|</annotation></semantics></math></td>
