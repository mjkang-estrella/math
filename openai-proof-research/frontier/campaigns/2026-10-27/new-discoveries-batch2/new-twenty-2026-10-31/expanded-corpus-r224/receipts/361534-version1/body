<p id="S3.SS3.p12.1" class="ltx_p"><span id="S3.SS3.p12.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Suppose now that <math id="S3.SS3.p12.m1" class="ltx_Math" alttext="k\geq 2" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≥</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></mrow><annotation encoding="application/x-tex">k\geq 2</annotation></semantics></math> and the assertion is true for <math id="S3.SS3.p12.m2" class="ltx_Math" alttext="k-1" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><annotation encoding="application/x-tex">k-1</annotation></semantics></math>, suppose that <math id="S3.SS3.p12.m3" class="ltx_Math" alttext="v_{0},v_{1},\cdots,v_{l}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">⋯</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub></mrow><annotation encoding="application/x-tex">v_{0},v_{1},\cdots,v_{l}</annotation></semantics></math> are neighbors of <math id="S3.SS3.p12.m4" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> with <math id="S3.SS3.p12.m5" class="ltx_Math" alttext="v_{0}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><annotation encoding="application/x-tex">v_{0}</annotation></semantics></math> on <math id="S3.SS3.p12.m6" class="ltx_Math" alttext="p_{uv}." display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow></msub><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">p_{uv}.</annotation></semantics></math> Let <math id="S3.SS3.p12.m7" class="ltx_Math" alttext="T_{0}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><annotation encoding="application/x-tex">T_{0}</annotation></semantics></math> denote the component of <math id="S3.SS3.p12.m8" class="ltx_Math" alttext="T\setminus\{v\}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∖</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">T\setminus\{v\}</annotation></semantics></math> containing <math id="S3.SS3.p12.m9" class="ltx_Math" alttext="v_{0}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><annotation encoding="application/x-tex">v_{0}</annotation></semantics></math> and <math id="S3.SS3.p12.m10" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math>, then</span></p>
