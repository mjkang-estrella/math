</table>
<p id="S3.SS4.p3.2" class="ltx_p"><span id="S3.SS4.p3.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">We denote by <math id="S3.SS4.p3.m2" class="ltx_Math" alttext="\{f_{n}(\beta,\gamma,\lambda)\}_{n\in\mathbb{N}}" display="inline" intent=":literal"><semantics><msub><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℕ</mi></mrow></msub><annotation encoding="application/x-tex">\{f_{n}(\beta,\gamma,\lambda)\}_{n\in\mathbb{N}}</annotation></semantics></math> the sequence of functions <math id="S3.SS4.p3.m3" class="ltx_Math" alttext="\{P_{G_{n},v_{n}}^{\sigma^{(n)}_{\Lambda_{n}}}(\beta,\gamma,\lambda)\}_{n\in\mathbb{N}}" display="inline" intent=":literal"><semantics><msub><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">P</mi><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub></mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msubsup></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℕ</mi></mrow></msub><annotation encoding="application/x-tex">\{P_{G_{n},v_{n}}^{\sigma^{(n)}_{\Lambda_{n}}}(\beta,\gamma,\lambda)\}_{n\in\mathbb{N}}</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS4.p4" class="ltx_para">
<p id="S3.SS4.p4.1" class="ltx_p"><span id="S3.SS4.p4.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Since the partition function of the 2-spin system defined on <math id="S3.SS4.p4.m1" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> is zero-free on <math id="S3.SS4.p4.m2" class="ltx_Math" alttext="\mathbf{U}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐔</mi><annotation encoding="application/x-tex">\mathbf{U}</annotation></semantics></math>, for any <math id="S3.SS4.p4.m3" class="ltx_Math" alttext="G=(V,E)\in\mathcal{G}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒢</mi></mrow><annotation encoding="application/x-tex">G=(V,E)\in\mathcal{G}</annotation></semantics></math>, any feasible partial configuration <math id="S3.SS4.p4.m4" class="ltx_Math" alttext="\sigma_{\Lambda}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub><annotation encoding="application/x-tex">\sigma_{\Lambda}</annotation></semantics></math> on some <math id="S3.SS4.p4.m5" class="ltx_Math" alttext="\Lambda\subseteq V" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⊆</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi></mrow><annotation encoding="application/x-tex">\Lambda\subseteq V</annotation></semantics></math>, and any vertex <math id="S3.SS4.p4.m6" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> proper to <math id="S3.SS4.p4.m7" class="ltx_Math" alttext="\sigma_{\Lambda}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub><annotation encoding="application/x-tex">\sigma_{\Lambda}</annotation></semantics></math>,
the function <math id="S3.SS4.p4.m8" class="ltx_Math" alttext="P^{\sigma_{\Lambda}}_{G,v}(\beta,\gamma,\lambda)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">P</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P^{\sigma_{\Lambda}}_{G,v}(\beta,\gamma,\lambda)</annotation></semantics></math> is holomorphic on <math id="S3.SS4.p4.m9" class="ltx_Math" alttext="\bf U" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐔</mi><annotation encoding="application/x-tex">\bf U</annotation></semantics></math> (which is connected since <math id="S3.SS4.p4.m10" class="ltx_Math" alttext="U_{3}\setminus\{0\}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∖</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">U_{3}\setminus\{0\}</annotation></semantics></math> and <math id="S3.SS4.p4.m11" class="ltx_Math" alttext="U_{1}\times U_{2}\setminus\{(0,0)\}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∖</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">U_{1}\times U_{2}\setminus\{(0,0)\}</annotation></semantics></math> are connected) and avoids the values <math id="S3.SS4.p4.m12" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> and <math id="S3.SS4.p4.m13" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>. Thus all such functions form a normal family by Montel theorem (Theorem <a href="#Thmtheorem12" title="Theorem 12 (Montel). ‣ 2.3 Tools from complex analysis ‣ 2 Preliminaries ‣ From Zero-Freeness to Strong Spatial Mixing viaa Christoffel-Darboux Type Identity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>).</span></p>
</div>
<div id="S3.SS4.p5" class="ltx_para">
<p id="S3.SS4.p5.1" class="ltx_p"><span id="S3.SS4.p5.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Since <math id="S3.SS4.p5.m1" class="ltx_Math" alttext="\beta_{0},\gamma_{0},\lambda_{0}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≥</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow></mrow><annotation encoding="application/x-tex">\beta_{0},\gamma_{0},\lambda_{0}\geq 0</annotation></semantics></math> and they are not all zeros, for any rational function <math id="S3.SS4.p5.m2" class="ltx_Math" alttext="P^{\sigma_{\Lambda}}_{G,v}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">P</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msubsup><annotation encoding="application/x-tex">P^{\sigma_{\Lambda}}_{G,v}</annotation></semantics></math>, its value given the input <math id="S3.SS4.p5.m3" class="ltx_Math" alttext="(\beta_{0},\gamma_{0},\lambda_{0})" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\beta_{0},\gamma_{0},\lambda_{0})</annotation></semantics></math> is a probability which lies in the interval <math id="S3.SS4.p5.m4" class="ltx_Math" alttext="(0,1)" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,1)</annotation></semantics></math>.
Thus, any sequence in this family can not converge locally uniformly to <math id="S3.SS4.p5.m5" class="ltx_Math" alttext="\infty" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">∞</mi><annotation encoding="application/x-tex">\infty</annotation></semantics></math>. Then every sequence has a sub-sequence converging locally uniformly to a holomorphic function.
Thus, the sequence <math id="S3.SS4.p5.m6" class="ltx_Math" alttext="\{f_{n}\}_{n\in\mathbb{N}}" display="inline" intent=":literal"><semantics><msub><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℕ</mi></mrow></msub><annotation encoding="application/x-tex">\{f_{n}\}_{n\in\mathbb{N}}</annotation></semantics></math> has a sub-sequence <math id="S3.SS4.p5.m7" class="ltx_Math" alttext="\{f_{n_{i}}\}_{i\in\mathbb{N}}" display="inline" intent=":literal"><semantics><msub><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℕ</mi></mrow></msub><annotation encoding="application/x-tex">\{f_{n_{i}}\}_{i\in\mathbb{N}}</annotation></semantics></math> converging locally uniformly to some holomorphic function <math id="S3.SS4.p5.m8" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> on <math id="S3.SS4.p5.m9" class="ltx_Math" alttext="\mathbf{U}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐔</mi><annotation encoding="application/x-tex">\mathbf{U}</annotation></semantics></math>.
Since <math id="S3.SS4.p5.m10" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is a compact subset of <math id="S3.SS4.p5.m11" class="ltx_Math" alttext="\mathbf{U}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐔</mi><annotation encoding="application/x-tex">\mathbf{U}</annotation></semantics></math>, the convergence is uniform on <math id="S3.SS4.p5.m12" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>, and also the function <math id="S3.SS4.p5.m13" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is bounded by some <math id="S3.SS4.p5.m14" class="ltx_Math" alttext="C&gt;0" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">C</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&gt;</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><annotation encoding="application/x-tex">C&gt;0</annotation></semantics></math> on <math id="S3.SS4.p5.m15" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>.
Then, there exists some <math id="S3.SS4.p5.m16" class="ltx_Math" alttext="n_{k}\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℕ</mi></mrow><annotation encoding="application/x-tex">n_{k}\in\mathbb{N}</annotation></semantics></math> such that for all <math id="S3.SS4.p5.m17" class="ltx_Math" alttext="n_{i}\geq n_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≥</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi></msub></mrow><annotation encoding="application/x-tex">n_{i}\geq n_{k}</annotation></semantics></math> , we have <math id="S3.SS4.p5.m18" class="ltx_Math" alttext="|f_{n_{i}}(\beta,\gamma,\lambda)|&lt;2C" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&lt;</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">C</mi></mrow></mrow><annotation encoding="application/x-tex">|f_{n_{i}}(\beta,\gamma,\lambda)|&lt;2C</annotation></semantics></math> on <math id="S3.SS4.p5.m19" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>.
Clearly, this contradicts with the fact that for all <math id="S3.SS4.p5.m20" class="ltx_Math" alttext="n\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℕ</mi></mrow><annotation encoding="application/x-tex">n\in\mathbb{N}</annotation></semantics></math>, <math id="S3.SS4.p5.m21" class="ltx_Math" alttext="|f_{n}(\beta_{n},\gamma_{n},\lambda_{n})|\geq n" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≥</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></mrow><annotation encoding="application/x-tex">|f_{n}(\beta_{n},\gamma_{n},\lambda_{n})|\geq n</annotation></semantics></math> where <math id="S3.SS4.p5.m22" class="ltx_Math" alttext="(\beta_{n},\gamma_{n},\lambda_{n})\in S" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi></mrow><annotation encoding="application/x-tex">(\beta_{n},\gamma_{n},\lambda_{n})\in S</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="Thmremark5" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem" style="--ltx-fg-color:#000000;"><span class="ltx_tag ltx_tag_theorem"><span id="Thmremark5.2" class="ltx_text ltx_font_bold">Remark 5</span></span><span id="Thmremark5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmremark5.p1" class="ltx_para">
<p id="Thmremark5.p1.1" class="ltx_p"><span id="Thmremark5.p1.1.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#000000;">In particular, when the set <math id="Thmremark5.p1.m1" class="ltx_Math" alttext="U_{3}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msub><annotation encoding="application/x-tex">U_{3}</annotation></semantics></math> in Lemma <a href="#Thmtheorem24" title="Lemma 24. ‣ 3.4 Zero-freeness implies a uniform bound on a circle ‣ 3 Zero-freeness implies SSM for 𝜆 ‣ From Zero-Freeness to Strong Spatial Mixing viaa Christoffel-Darboux Type Identity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a> is a complex neighborhood of <math id="Thmremark5.p1.m2" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>, we may take the compact set <math id="Thmremark5.p1.m3" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> to be <math id="Thmremark5.p1.m4" class="ltx_Math" alttext="\{\beta_{1}\}\times\{\gamma_{1}\}\times\partial\mathbb{D}_{\rho}" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.055em" stretchy="false">}</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.222em">×</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.055em" stretchy="false">}</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.055em">×</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∂</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔻</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\{\beta_{1}\}\times\{\gamma_{1}\}\times\partial\mathbb{D}_{\rho}</annotation></semantics></math> for some arbitrary <math id="Thmremark5.p1.m5" class="ltx_Math" alttext="\beta_{1}\in U_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub></mrow><annotation encoding="application/x-tex">\beta_{1}\in U_{1}</annotation></semantics></math>, <math id="Thmremark5.p1.m6" class="ltx_Math" alttext="\gamma_{1}\in U_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub></mrow><annotation encoding="application/x-tex">\gamma_{1}\in U_{2}</annotation></semantics></math>, and <math id="Thmremark5.p1.m7" class="ltx_Math" alttext="\partial\mathbb{D}_{\rho}\subseteq U_{3}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∂</mo><mphantom></mphantom><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔻</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⊆</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\partial\mathbb{D}_{\rho}\subseteq U_{3}</annotation></semantics></math>. Then, we get a uniform bound for <math id="Thmremark5.p1.m8" class="ltx_Math" alttext="P^{\sigma_{\Lambda}}_{G,v,\beta_{1},\gamma_{1}}(\lambda)=P^{\sigma_{\Lambda}}_{G,v}(\beta_{1},\gamma_{1},\lambda)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">P</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">P</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">P^{\sigma_{\Lambda}}_{G,v,\beta_{1},\gamma_{1}}(\lambda)=P^{\sigma_{\Lambda}}_{G,v}(\beta_{1},\gamma_{1},\lambda)</annotation></semantics></math> on the circle <math id="Thmremark5.p1.m9" class="ltx_Math" alttext="\partial\mathbb{D}_{\rho}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∂</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔻</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></msub></mrow><annotation encoding="application/x-tex">\partial\mathbb{D}_{\rho}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.SS4.p6" class="ltx_para">
<p id="S3.SS4.p6.1" class="ltx_p"><span id="S3.SS4.p6.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">By Remark </span><a href="#Thmremark5" title="Remark 5. ‣ 3.4 Zero-freeness implies a uniform bound on a circle ‣ 3 Zero-freeness implies SSM for 𝜆 ‣ From Zero-Freeness to Strong Spatial Mixing viaa Christoffel-Darboux Type Identity" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">5</span></a><span id="S3.SS4.p6.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> and Lemma </span><a href="#Thmtheorem16" title="Lemma 16. ‣ 3.2 Local dependence of coefficients and a uniform bound on a circle ‣ 3 Zero-freeness implies SSM for 𝜆 ‣ From Zero-Freeness to Strong Spatial Mixing viaa Christoffel-Darboux Type Identity" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">16</span></a><span id="S3.SS4.p6.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">, we have the following result.</span></p>
</div>
<div id="Thmtheorem25" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem" style="--ltx-fg-color:#000000;"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem25.2" class="ltx_text ltx_font_bold">Lemma 25</span></span><span id="Thmtheorem25.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem25.p1" class="ltx_para">
<p id="Thmtheorem25.p1.1" class="ltx_p"><span id="Thmtheorem25.p1.1.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#000000;">Let <math id="Thmtheorem25.p1.m1" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> be
a family of graphs, <math id="Thmtheorem25.p1.m2" class="ltx_Math" alttext="U_{1}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><annotation encoding="application/x-tex">U_{1}</annotation></semantics></math> and <math id="Thmtheorem25.p1.m3" class="ltx_Math" alttext="U_{2}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub><annotation encoding="application/x-tex">U_{2}</annotation></semantics></math> be quasi-neighborhoods of some <math id="Thmtheorem25.p1.m4" class="ltx_Math" alttext="\beta_{0},\gamma_{0}{\geq 0}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≥</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow></mrow><annotation encoding="application/x-tex">\beta_{0},\gamma_{0}{\geq 0}</annotation></semantics></math> respectively, and
<math id="Thmtheorem25.p1.m5" class="ltx_Math" alttext="U_{3}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msub><annotation encoding="application/x-tex">U_{3}</annotation></semantics></math> be a neighborhood of <math id="Thmtheorem25.p1.m6" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>.
Denote <math id="Thmtheorem25.p1.m7" class="ltx_Math" alttext="(U_{1}\times U_{2}\backslash\{(0,0)\})\times(U_{3}\backslash\{0\})" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub></mrow><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">\</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.055em" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.222em">×</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msub><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">\</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(U_{1}\times U_{2}\backslash\{(0,0)\})\times(U_{3}\backslash\{0\})</annotation></semantics></math> by <math id="Thmtheorem25.p1.m8" class="ltx_Math" alttext="\mathbf{U}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐔</mi><annotation encoding="application/x-tex">\mathbf{U}</annotation></semantics></math>.
Suppose that the partition function of the 2-spin systems defined on <math id="Thmtheorem25.p1.m9" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> is zero-free on <math id="Thmtheorem25.p1.m10" class="ltx_Math" alttext="\mathbf{U}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐔</mi><annotation encoding="application/x-tex">\mathbf{U}</annotation></semantics></math>.
Then, for any <math id="Thmtheorem25.p1.m11" class="ltx_Math" alttext="(\beta,\gamma,\lambda)\in\mathbf{U}" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐔</mi></mrow><annotation encoding="application/x-tex">(\beta,\gamma,\lambda)\in\mathbf{U}</annotation></semantics></math> satisfying <math id="Thmtheorem25.p1.m12" class="ltx_Math" alttext="\lambda\in\mathbb{D}_{\rho}\subseteq U_{3}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔻</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⊆</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msub></mrow><annotation encoding="application/x-tex">\lambda\in\mathbb{D}_{\rho}\subseteq U_{3}</annotation></semantics></math> for some disk <math id="Thmtheorem25.p1.m13" class="ltx_Math" alttext="\mathbb{D}_{\rho}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔻</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></msub><annotation encoding="application/x-tex">\mathbb{D}_{\rho}</annotation></semantics></math> centered at <math id="Thmtheorem25.p1.m14" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>, the corresponding 2-spin system exhibits SSM.</span></p>
</div>
<div id="Thmtheorem25.p2" class="ltx_para">
<p id="Thmtheorem25.p2.1" class="ltx_p"><span id="Thmtheorem25.p2.1.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#000000;">In particular, when <math id="Thmtheorem25.p2.m1" class="ltx_Math" alttext="U_{3}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msub><annotation encoding="application/x-tex">U_{3}</annotation></semantics></math> itself is a disk <math id="Thmtheorem25.p2.m2" class="ltx_Math" alttext="\mathbb{D}_{\rho}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔻</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></msub><annotation encoding="application/x-tex">\mathbb{D}_{\rho}</annotation></semantics></math>, every <math id="Thmtheorem25.p2.m3" class="ltx_Math" alttext="(\beta,\gamma,\lambda)\in\mathbf{U}" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐔</mi></mrow><annotation encoding="application/x-tex">(\beta,\gamma,\lambda)\in\mathbf{U}</annotation></semantics></math> satisfies <math id="Thmtheorem25.p2.m4" class="ltx_Math" alttext="\lambda\in\mathbb{D}_{\rho}=U_{3}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔻</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msub></mrow><annotation encoding="application/x-tex">\lambda\in\mathbb{D}_{\rho}=U_{3}</annotation></semantics></math>.
Thus, for any <math id="Thmtheorem25.p2.m5" class="ltx_Math" alttext="(\beta,\gamma,\lambda)\in\mathbf{U}" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐔</mi></mrow><annotation encoding="application/x-tex">(\beta,\gamma,\lambda)\in\mathbf{U}</annotation></semantics></math>, the 2-spin system exhibits SSM.</span></p>
</div>
</div>
<div id="S3.SS4.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof" style="--ltx-fg-color:#000000;">Proof.</h6>
<div id="S3.SS4.p7" class="ltx_para">
<p id="S3.SS4.p7.1" class="ltx_p"><span id="S3.SS4.p7.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">For any fixed <math id="S3.SS4.p7.m1" class="ltx_Math" alttext="\beta\in U_{1}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub></mrow><annotation encoding="application/x-tex">\beta\in U_{1}</annotation></semantics></math> and <math id="S3.SS4.p7.m2" class="ltx_Math" alttext="\gamma\in U_{2}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub></mrow><annotation encoding="application/x-tex">\gamma\in U_{2}</annotation></semantics></math>, the 2-spin system defined on <math id="S3.SS4.p7.m3" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> with fixed <math id="S3.SS4.p7.m4" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math>, <math id="S3.SS4.p7.m5" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> and a variable <math id="S3.SS4.p7.m6" class="ltx_Math" alttext="\lambda\in U_{3}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msub></mrow><annotation encoding="application/x-tex">\lambda\in U_{3}</annotation></semantics></math> is zero-free on <math id="S3.SS4.p7.m7" class="ltx_Math" alttext="U_{3}\backslash\{0\}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msub><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">\</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">U_{3}\backslash\{0\}</annotation></semantics></math>.
Hence, it satisfies LDC by Lemma <a href="#Thmtheorem23" title="Lemma 23. ‣ 3.3 Zero-freeness implies local dependence of coefficients ‣ 3 Zero-freeness implies SSM for 𝜆 ‣ From Zero-Freeness to Strong Spatial Mixing viaa Christoffel-Darboux Type Identity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>, and for any circle <math id="S3.SS4.p7.m8" class="ltx_Math" alttext="\partial\mathbb{D}_{\rho}\subseteq U_{3}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∂</mo><mphantom></mphantom><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔻</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⊆</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\partial\mathbb{D}_{\rho}\subseteq U_{3}</annotation></semantics></math> it has a uniform bound on <math id="S3.SS4.p7.m9" class="ltx_Math" alttext="\partial\mathbb{D}_{\rho}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∂</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔻</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></msub></mrow><annotation encoding="application/x-tex">\partial\mathbb{D}_{\rho}</annotation></semantics></math> by Remark <a href="#Thmremark5" title="Remark 5. ‣ 3.4 Zero-freeness implies a uniform bound on a circle ‣ 3 Zero-freeness implies SSM for 𝜆 ‣ From Zero-Freeness to Strong Spatial Mixing viaa Christoffel-Darboux Type Identity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>.
Thus, by Lemma <a href="#Thmtheorem17" title="Lemma 17. ‣ 3.2 Local dependence of coefficients and a uniform bound on a circle ‣ 3 Zero-freeness implies SSM for 𝜆 ‣ From Zero-Freeness to Strong Spatial Mixing viaa Christoffel-Darboux Type Identity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>, for any <math id="S3.SS4.p7.m10" class="ltx_Math" alttext="(\beta,\gamma,\lambda)\in\mathbf{U}" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐔</mi></mrow><annotation encoding="application/x-tex">(\beta,\gamma,\lambda)\in\mathbf{U}</annotation></semantics></math> satisfying <math id="S3.SS4.p7.m11" class="ltx_Math" alttext="\lambda\in\mathbb{D}_{\rho}\subseteq U_{3}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔻</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⊆</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msub></mrow><annotation encoding="application/x-tex">\lambda\in\mathbb{D}_{\rho}\subseteq U_{3}</annotation></semantics></math> for some <math id="S3.SS4.p7.m12" class="ltx_Math" alttext="\mathbb{D}_{\rho}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔻</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></msub><annotation encoding="application/x-tex">\mathbb{D}_{\rho}</annotation></semantics></math>, the 2-spin system exhibits SSM.
∎</span></p>
</div>
</div>
</section>
<section id="S3.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection" style="--ltx-fg-color:#000000;"><span class="ltx_tag ltx_tag_subsection">3.5 </span>From an arbitrary region to the unit disk</h3>

<div id="S3.SS5.p1" class="ltx_para">
<p id="S3.SS5.p1.1" class="ltx_p"><span id="S3.SS5.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">By Lemma </span><a href="#Thmtheorem25" title="Lemma 25. ‣ 3.4 Zero-freeness implies a uniform bound on a circle ‣ 3 Zero-freeness implies SSM for 𝜆 ‣ From Zero-Freeness to Strong Spatial Mixing viaa Christoffel-Darboux Type Identity" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">25</span></a><span id="S3.SS5.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">, when the zero-free region of </span><math id="S3.SS5.p1.m1" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math><span id="S3.SS5.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> is a disk, the 2-spin system exhibits SSM for any </span><math id="S3.SS5.p1.m2" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math><span id="S3.SS5.p1.1.4" class="ltx_text" style="--ltx-fg-color:#000000;"> in the disk.
Using Riemann mapping theorem, we are able to map any region </span><math id="S3.SS5.p1.m3" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math><span id="S3.SS5.p1.1.5" class="ltx_text" style="--ltx-fg-color:#000000;"> containing </span><math id="S3.SS5.p1.m4" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math><span id="S3.SS5.p1.1.6" class="ltx_text" style="--ltx-fg-color:#000000;"> to the unit disk </span><math id="S3.SS5.p1.m5" class="ltx_Math" alttext="\mathbb{D}_{1}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔻</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><annotation encoding="application/x-tex">\mathbb{D}_{1}</annotation></semantics></math><span id="S3.SS5.p1.1.7" class="ltx_text" style="--ltx-fg-color:#000000;"> with </span><math id="S3.SS5.p1.m6" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math><span id="S3.SS5.p1.1.8" class="ltx_text" style="--ltx-fg-color:#000000;"> as a fixed point.
Finally, we can drop the restriction of </span><math id="S3.SS5.p1.m7" class="ltx_Math" alttext="\lambda\in\mathbb{D}_{\rho}\subseteq U_{3}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔻</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⊆</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msub></mrow><annotation encoding="application/x-tex">\lambda\in\mathbb{D}_{\rho}\subseteq U_{3}</annotation></semantics></math><span id="S3.SS5.p1.1.9" class="ltx_text" style="--ltx-fg-color:#000000;"> for some disk </span><math id="S3.SS5.p1.m8" class="ltx_Math" alttext="\mathbb{D}_{\rho}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔻</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></msub><annotation encoding="application/x-tex">\mathbb{D}_{\rho}</annotation></semantics></math><span id="S3.SS5.p1.1.10" class="ltx_text" style="--ltx-fg-color:#000000;"> as in the statement of Lemma </span><a href="#Thmtheorem25" title="Lemma 25. ‣ 3.4 Zero-freeness implies a uniform bound on a circle ‣ 3 Zero-freeness implies SSM for 𝜆 ‣ From Zero-Freeness to Strong Spatial Mixing viaa Christoffel-Darboux Type Identity" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">25</span></a><span id="S3.SS5.p1.1.11" class="ltx_text" style="--ltx-fg-color:#000000;">, and get the following result: zero-freeness implies SSM for any complex neighborhood of </span><math id="S3.SS5.p1.m9" class="ltx_Math" alttext="\lambda=0" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><annotation encoding="application/x-tex">\lambda=0</annotation></semantics></math><span id="S3.SS5.p1.1.12" class="ltx_text" style="--ltx-fg-color:#000000;">.</span></p>
</div>
<div id="Thmtheorem26" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem" style="--ltx-fg-color:#000000;"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem26.2" class="ltx_text ltx_font_bold">Theorem 26</span></span><span id="Thmtheorem26.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem26.p1" class="ltx_para">
<p id="Thmtheorem26.p1.1" class="ltx_p"><span id="Thmtheorem26.p1.1.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#000000;">Let <math id="Thmtheorem26.p1.m1" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> be
a family of graphs,
<math id="Thmtheorem26.p1.m2" class="ltx_Math" alttext="U_{1}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><annotation encoding="application/x-tex">U_{1}</annotation></semantics></math> and <math id="Thmtheorem26.p1.m3" class="ltx_Math" alttext="U_{2}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub><annotation encoding="application/x-tex">U_{2}</annotation></semantics></math> be quasi-neighborhoods of some <math id="Thmtheorem26.p1.m4" class="ltx_Math" alttext="\beta_{0},\gamma_{0}{\geq 0}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≥</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow></mrow><annotation encoding="application/x-tex">\beta_{0},\gamma_{0}{\geq 0}</annotation></semantics></math> respectively where <math id="Thmtheorem26.p1.m5" class="ltx_Math" alttext="\beta_{0},\gamma_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub></mrow><annotation encoding="application/x-tex">\beta_{0},\gamma_{0}</annotation></semantics></math> are not both zeros, and
<math id="Thmtheorem26.p1.m6" class="ltx_Math" alttext="U_{3}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msub><annotation encoding="application/x-tex">U_{3}</annotation></semantics></math> be a neighborhood of <math id="Thmtheorem26.p1.m7" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>.
Denote <math id="Thmtheorem26.p1.m8" class="ltx_Math" alttext="(U_{1}\times U_{2}\backslash\{(0,0)\})\times(U_{3}\backslash\{0\})" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub></mrow><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">\</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.055em" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.222em">×</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msub><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">\</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(U_{1}\times U_{2}\backslash\{(0,0)\})\times(U_{3}\backslash\{0\})</annotation></semantics></math> by <math id="Thmtheorem26.p1.m9" class="ltx_Math" alttext="\mathbf{U}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐔</mi><annotation encoding="application/x-tex">\mathbf{U}</annotation></semantics></math>.
Suppose that the partition function of the 2-spin systems defined on <math id="Thmtheorem26.p1.m10" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> is zero-free on <math id="Thmtheorem26.p1.m11" class="ltx_Math" alttext="\mathbf{U}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐔</mi><annotation encoding="application/x-tex">\mathbf{U}</annotation></semantics></math>.
Then, for any <math id="Thmtheorem26.p1.m12" class="ltx_Math" alttext="(\beta,\gamma,\lambda)\in\bf U" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐔</mi></mrow><annotation encoding="application/x-tex">(\beta,\gamma,\lambda)\in\bf U</annotation></semantics></math>, the corresponding 2-spin system exhibits SSM.</span></p>
</div>
</div>
<div id="S3.SS5.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof" style="--ltx-fg-color:#000000;">Proof.</h6>
<div id="S3.SS5.p2" class="ltx_para">
<p id="S3.SS5.p2.1" class="ltx_p"><span id="S3.SS5.p2.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">By Riemann mapping theorem (Theorem <a href="#Thmtheorem13" title="Theorem 13 (Riemann mapping theorem). ‣ 2.3 Tools from complex analysis ‣ 2 Preliminaries ‣ From Zero-Freeness to Strong Spatial Mixing viaa Christoffel-Darboux Type Identity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>), there exists a conformal map <math id="S3.SS5.p2.m1" class="ltx_Math" alttext="f:\mathbb{D}_{1}\to U_{3}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔻</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msub></mrow></mrow><annotation encoding="application/x-tex">f:\mathbb{D}_{1}\to U_{3}</annotation></semantics></math> with <math id="S3.SS5.p2.m2" class="ltx_Math" alttext="f(0)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><annotation encoding="application/x-tex">f(0)=0</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS5.p3" class="ltx_para">
<p id="S3.SS5.p3.1" class="ltx_p"><span id="S3.SS5.p3.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">For a rational function <math id="S3.SS5.p3.m1" class="ltx_Math" alttext="P^{\sigma_{\Lambda}}_{G,v}(\beta,\gamma,\lambda)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">P</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P^{\sigma_{\Lambda}}_{G,v}(\beta,\gamma,\lambda)</annotation></semantics></math> where <math id="S3.SS5.p3.m2" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> is proper to the feasible partial configuration <math id="S3.SS5.p3.m3" class="ltx_Math" alttext="\sigma_{\Lambda}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub><annotation encoding="application/x-tex">\sigma_{\Lambda}</annotation></semantics></math>,
we consider the composition <math id="S3.SS5.p3.m4" class="ltx_Math" alttext="g_{G,v}^{\sigma_{\Lambda}}(\beta,\gamma,\lambda)=P_{G,v}^{\sigma_{\Lambda}}(\beta,\gamma,f(\lambda))" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">g</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">P</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">g_{G,v}^{\sigma_{\Lambda}}(\beta,\gamma,\lambda)=P_{G,v}^{\sigma_{\Lambda}}(\beta,\gamma,f(\lambda))</annotation></semantics></math>.
Clearly, <math id="S3.SS5.p3.m5" class="ltx_Math" alttext="g_{G,v}^{\sigma_{\Lambda}}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">g</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msubsup><annotation encoding="application/x-tex">g_{G,v}^{\sigma_{\Lambda}}</annotation></semantics></math> is holomorphic on <math id="S3.SS5.p3.m6" class="ltx_Math" alttext="{\bf U^{\prime}}=(U_{1}\times U_{2}\backslash\{(0,0)\})\times(\mathbb{D}_{1}\backslash\{0\})" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐔</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub></mrow><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">\</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.055em" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.222em">×</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔻</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">\</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bf U^{\prime}}=(U_{1}\times U_{2}\backslash\{(0,0)\})\times(\mathbb{D}_{1}\backslash\{0\})</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS5.p4" class="ltx_para">
<p id="S3.SS5.p4.1" class="ltx_p"><span id="S3.SS5.p4.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Since the partition function of the 2-spin system is zero-free <math id="S3.SS5.p4.m1" class="ltx_Math" alttext="\mathbf{U}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐔</mi><annotation encoding="application/x-tex">\mathbf{U}</annotation></semantics></math>,
for any <math id="S3.SS5.p4.m2" class="ltx_Math" alttext="G=(V,E)\in\mathcal{G}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒢</mi></mrow><annotation encoding="application/x-tex">G=(V,E)\in\mathcal{G}</annotation></semantics></math>, any feasible partial configuration <math id="S3.SS5.p4.m3" class="ltx_Math" alttext="\sigma_{\Lambda}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub><annotation encoding="application/x-tex">\sigma_{\Lambda}</annotation></semantics></math>, and any vertex <math id="S3.SS5.p4.m4" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> proper to <math id="S3.SS5.p4.m5" class="ltx_Math" alttext="\sigma_{\Lambda}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub><annotation encoding="application/x-tex">\sigma_{\Lambda}</annotation></semantics></math>, the functions <math id="S3.SS5.p4.m6" class="ltx_Math" alttext="g_{G,v}^{\sigma_{\Lambda}}(\beta,\gamma,\lambda)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">g</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g_{G,v}^{\sigma_{\Lambda}}(\beta,\gamma,\lambda)</annotation></semantics></math> avoid the values <math id="S3.SS5.p4.m7" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> and <math id="S3.SS5.p4.m8" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> on <math id="S3.SS5.p4.m9" class="ltx_Math" alttext="\mathbf{U}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐔</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup><annotation encoding="application/x-tex">\mathbf{U}^{\prime}</annotation></semantics></math>. Still by Montel theorem, these functions form a normal family.
Also, all functions in the family take a value in the interval <math id="S3.SS5.p4.m10" class="ltx_Math" alttext="(0,1)" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,1)</annotation></semantics></math> at the point <math id="S3.SS5.p4.m11" class="ltx_Math" alttext="(\beta_{0},\gamma_{0},\lambda_{0})" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\beta_{0},\gamma_{0},\lambda_{0})</annotation></semantics></math> for some <math id="S3.SS5.p4.m12" class="ltx_Math" alttext="\lambda_{0}\in\mathbb{D}_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔻</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub></mrow><annotation encoding="application/x-tex">\lambda_{0}\in\mathbb{D}_{1}</annotation></semantics></math> satisfying <math id="S3.SS5.p4.m13" class="ltx_Math" alttext="f(\lambda_{0})&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&gt;</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><annotation encoding="application/x-tex">f(\lambda_{0})&gt;0</annotation></semantics></math>.
Then,
similar to the proof of Lemma <a href="#Thmtheorem24" title="Lemma 24. ‣ 3.4 Zero-freeness implies a uniform bound on a circle ‣ 3 Zero-freeness implies SSM for 𝜆 ‣ From Zero-Freeness to Strong Spatial Mixing viaa Christoffel-Darboux Type Identity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>,
we deduce that for any <math id="S3.SS5.p4.m14" class="ltx_Math" alttext="\{\beta_{1}\}\times\{\gamma_{1}\}\times\partial\mathbb{D}_{\rho}\subseteq{\bf U^{\prime}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.055em" stretchy="false">}</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.222em">×</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.055em" stretchy="false">}</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.055em">×</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∂</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔻</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></msub></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⊆</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐔</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">′</mo></msup></mrow><annotation encoding="application/x-tex">\{\beta_{1}\}\times\{\gamma_{1}\}\times\partial\mathbb{D}_{\rho}\subseteq{\bf U^{\prime}}</annotation></semantics></math>, we can get a uniform bound for <math id="S3.SS5.p4.m15" class="ltx_Math" alttext="g^{\sigma_{\Lambda}}_{G,v,\beta_{1},\gamma_{1}}(\lambda)=g^{\sigma_{\Lambda}}_{G,v}(\beta_{1},\gamma_{1},\lambda)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">g</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">g</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">g^{\sigma_{\Lambda}}_{G,v,\beta_{1},\gamma_{1}}(\lambda)=g^{\sigma_{\Lambda}}_{G,v}(\beta_{1},\gamma_{1},\lambda)</annotation></semantics></math> on the circle <math id="S3.SS5.p4.m16" class="ltx_Math" alttext="\partial\mathbb{D}_{\rho}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∂</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔻</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></msub></mrow><annotation encoding="application/x-tex">\partial\mathbb{D}_{\rho}</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS5.p5" class="ltx_para">
<p id="S3.SS5.p5.1" class="ltx_p"><span id="S3.SS5.p5.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Since <math id="S3.SS5.p5.m1" class="ltx_Math" alttext="f(0)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><annotation encoding="application/x-tex">f(0)=0</annotation></semantics></math>, we have <math id="S3.SS5.p5.m2" class="ltx_Math" alttext="f(\lambda)=\lambda h(\lambda)" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f(\lambda)=\lambda h(\lambda)</annotation></semantics></math> for some <math id="S3.SS5.p5.m3" class="ltx_Math" alttext="h(\lambda)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">h(\lambda)</annotation></semantics></math> analytic near <math id="S3.SS5.p5.m4" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>.
Also, for any fixed <math id="S3.SS5.p5.m5" class="ltx_Math" alttext="\beta\in U_{1}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub></mrow><annotation encoding="application/x-tex">\beta\in U_{1}</annotation></semantics></math> and <math id="S3.SS5.p5.m6" class="ltx_Math" alttext="\gamma\in U_{2}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub></mrow><annotation encoding="application/x-tex">\gamma\in U_{2}</annotation></semantics></math>,
same as the proof of Lemma <a href="#Thmtheorem23" title="Lemma 23. ‣ 3.3 Zero-freeness implies local dependence of coefficients ‣ 3 Zero-freeness implies SSM for 𝜆 ‣ From Zero-Freeness to Strong Spatial Mixing viaa Christoffel-Darboux Type Identity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>, we have</span></p>
