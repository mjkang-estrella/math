<h2 class="ltx_title ltx_title_section" style="--ltx-fg-color:#000000;"><span class="ltx_tag ltx_tag_section">4 </span>Zero-freeness implies SSM for <math id="S4.m1" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> and <math id="S4.m2" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math></h2>

<div id="Thmtheorem27" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem" style="--ltx-fg-color:#000000;"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem27.2" class="ltx_text ltx_font_bold">Definition 27</span></span><span id="Thmtheorem27.3" class="ltx_text ltx_font_bold"> </span>(LDC for <math id="Thmtheorem27.m1" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> near <math id="Thmtheorem27.m2" class="ltx_Math" alttext="1/\gamma" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi></mrow><annotation encoding="application/x-tex">1/\gamma</annotation></semantics></math>)<span id="Thmtheorem27.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem27.p1" class="ltx_para">
<p id="Thmtheorem27.p1.1" class="ltx_p"><span id="Thmtheorem27.p1.1.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#000000;">Fix complex parameters <math id="Thmtheorem27.p1.m1" class="ltx_Math" alttext="\gamma\neq 0" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≠</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><annotation encoding="application/x-tex">\gamma\neq 0</annotation></semantics></math> and <math id="Thmtheorem27.p1.m2" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>, a neighborhood <math id="Thmtheorem27.p1.m3" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> of <math id="Thmtheorem27.p1.m4" class="ltx_Math" alttext="1/\gamma" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi></mrow><annotation encoding="application/x-tex">1/\gamma</annotation></semantics></math>, and a family of graphs <math id="Thmtheorem27.p1.m5" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math>.
The corresponding 2-spin system (defined on <math id="Thmtheorem27.p1.m6" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> specified with the fixed parameters <math id="Thmtheorem27.p1.m7" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> and <math id="Thmtheorem27.p1.m8" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>, and a variable <math id="Thmtheorem27.p1.m9" class="ltx_Math" alttext="\beta\in U" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi></mrow><annotation encoding="application/x-tex">\beta\in U</annotation></semantics></math>) is said to satisfy LDC for <math id="Thmtheorem27.p1.m10" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> near <math id="Thmtheorem27.p1.m11" class="ltx_Math" alttext="1/\gamma" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi></mrow><annotation encoding="application/x-tex">1/\gamma</annotation></semantics></math> if for
any <math id="Thmtheorem27.p1.m12" class="ltx_Math" alttext="G=(V,E)\in\mathcal{G}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒢</mi></mrow><annotation encoding="application/x-tex">G=(V,E)\in\mathcal{G}</annotation></semantics></math>,
any feasible configurations <math id="Thmtheorem27.p1.m13" class="ltx_Math" alttext="\sigma_{\Lambda_{1}}\in\{0,1\}^{\Lambda_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub></msup></mrow><annotation encoding="application/x-tex">\sigma_{\Lambda_{1}}\in\{0,1\}^{\Lambda_{1}}</annotation></semantics></math> and <math id="Thmtheorem27.p1.m14" class="ltx_Math" alttext="\tau_{\Lambda_{2}}\in\{0,1\}^{\Lambda_{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">τ</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#