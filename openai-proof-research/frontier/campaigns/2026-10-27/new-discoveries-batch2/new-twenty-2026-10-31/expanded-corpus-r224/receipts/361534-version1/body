tchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\sum^{\infty}_{i=0}b_{i}(\beta-1/\gamma)^{i}</annotation></semantics></math> near <math id="Thmtheorem27.p1.m23" class="ltx_Math" alttext="\beta=1/\gamma" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi></mrow></mrow><annotation encoding="application/x-tex">\beta=1/\gamma</annotation></semantics></math> satisfy <math id="Thmtheorem27.p1.m24" class="ltx_Math" alttext="a_{i}=b_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">a</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub></mrow><annotation encoding="application/x-tex">a_{i}=b_{i}</annotation></semantics></math> for <math id="Thmtheorem27.p1.m25" class="ltx_Math" alttext="0\leq i\leq d_{G}(v,\sigma_{\Lambda_{1}}\neq\tau_{\Lambda_{2}})-1" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≤</mo><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≠</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">τ</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></mrow><annotation encoding="application/x-tex">0\leq i\leq d_{G}(v,\sigma_{\Lambda_{1}}\neq\tau_{\Lambda_{2}})-1</annotation></semantics></math>.</span></p>
