<p id="S3.SS3.p16.1" class="ltx_p"><span id="S3.SS3.p16.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Notice that in the Christoffel-Darboux type identity for the 2-spin system, besides the “factor” </span><math id="S3.SS3.p16.m1" class="ltx_Math" alttext="\lambda^{d(u,v)+1}" display="inline" intent=":literal"><semantics><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msup><annotation encoding="application/x-tex">\lambda^{d(u,v)+1}</annotation></semantics></math><span id="S3.SS3.p16.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">, one can also take a “factor” </span><math id="S3.SS3.p16.m2" class="ltx_Math" alttext="(\beta\gamma-1)^{d(u,v)}" display="inline" intent=":literal"><semantics><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></msup><annotation encoding="application/x-tex">(\beta\gamma-1)^{d(u,v)}</annotation></semantics></math><span id="S3.SS3.p16.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> out of </span><math id="S3.SS3.p16.m3" class="ltx_Math" alttext="Z_{T,u,v}^{\sigma_{\Lambda},+,+}Z_{T,u,v}^{\sigma_{\Lambda},-,-}-Z_{T,u,v}^{\sigma_{\Lambda},+,-}Z_{T,u,v}^{\sigma_{\Lambda},-,+}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Z</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">,</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">+</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">,</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">+</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Z</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">,</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">−</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">,</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">−</mo></mrow></msubsup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Z</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">,</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">+</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">,</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">−</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Z</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">,</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">−</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">,</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">+</mo></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">Z_{T,u,v}^{\sigma_{\Lambda},+,+}Z_{T,u,v}^{\sigma_{\Lambda},-,-}-Z_{T,u,v}^{\sigma_{\Lambda},+,-}Z_{T,u,v}^{\sigma_{\Lambda},-,+}</annotation></semantics></math><span id="S3.SS3.p16.1.4" class="ltx_text" style="--ltx-fg-color:#000000;">.
In Section </span><a href="#S4" title="4 Zero-freeness implies SSM for 𝛽 and 𝛾 ‣ From Zero-Freeness to Strong Spatial Mixing viaa Christoffel-Darboux Type Identity" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">4</span></a><span id="S3.SS3.p16.1.5" class="ltx_text" style="--ltx-fg-color:#000000;">, we will use this fact to prove that a zero-free region of </span><math id="S3.SS3.p16.m4" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math><span id="S3.SS3.p16.1.6" class="ltx_text" style="--ltx-fg-color:#000000;"> or </span><math id="S3.SS3.p16.m5" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math><span id="S3.SS3.p16.1.7" class="ltx_text" style="--ltx-fg-color:#000000;"> containing the point </span><math id="S3.SS3.p16.m6" class="ltx_Math" alttext="\beta=1/\gamma" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi></mrow></mrow><annotation encoding="application/x-tex">\beta=1/\gamma</annotation></semantics></math><span id="S3.SS3.p16.1.8" class="ltx_text" style="--ltx-fg-color:#000000;"> or </span><math id="S3.SS3.p16.m7" class="ltx_Math" alttext="\gamma=1/\beta" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi></mrow></mrow><annotation encoding="application/x-tex">\gamma=1/\beta</annotation></semantics></math><span id="S3.SS3.p16.1.9" class="ltx_text" style="--ltx-fg-color:#000000;"> respectively implies SSM.</span></p>
</div>
</section>
<section id="S3.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection" style="--ltx-fg-color:#000000;"><span class="ltx_tag ltx_tag_subsection">3.4 </span>Zero-freeness implies a uniform bound on a circle</h3>

<div id="S3.SS4.p1" class="ltx_para">
<p id="S3.SS4.p1.1" class="ltx_p"><span id="S3.SS4.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Now, we are ready to show that if the partition function </span><math id="S3.SS4.p1.m1" class="ltx_Math" alttext="Z^{\sigma_{\Lambda}}_{G,\beta,\gamma}(\lambda)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Z</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Z^{\sigma_{\Lambda}}_{G,\beta,\gamma}(\lambda)</annotation></semantics></math><span id="S3.SS4.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> of a 2-spin system is zero-free on some </span><math id="S3.SS4.p1.m2" class="ltx_Math" alttext="U\backslash\{0\}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">\</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">U\backslash\{0\}</annotation></semantics></math><span id="S3.SS4.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">,
then for any circle </span><math id="S3.SS4.p1.m3" class="ltx_Math" alttext="\partial\mathbb{D}_{\rho}\subseteq U" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∂</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔻</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⊆</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi></mrow><annotation encoding="application/x-tex">\partial\mathbb{D}_{\rho}\subseteq U</annotation></semantics></math><span id="S3.SS4.p1.1.4" class="ltx_text" style="--ltx-fg-color:#000000;">,
there exists a uniform bound for the rational functions </span><math id="S3.SS4.p1.m4" class="ltx_Math" alttext="P^{\sigma_{\Lambda}}_{G}(\lambda)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">P</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P^{\sigma_{\Lambda}}_{G}(\lambda)</annotation></semantics></math><span id="S3.SS4.p1.1.5" class="ltx_text" style="--ltx-fg-color:#000000;"> on </span><math id="S3.SS4.p1.m5" class="ltx_Math" alttext="\partial\mathbb{D}_{\rho}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∂</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔻</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi></msub></mrow><annotation encoding="application/x-tex">\partial\mathbb{D}_{\rho}</annotation></semantics></math><span id="S3.SS4.p1.1.6" class="ltx_text" style="--ltx-fg-color:#000000;">.
In fact, we can prove that for any compact set </span><math id="S3.SS4.p1.m6" class="ltx_Math" alttext="S\subseteq U\backslash\{0\}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⊆</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">\</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">S\subseteq U\backslash\{0\}</annotation></semantics></math><span id="S3.SS4.p1.1.7" class="ltx_text" style="--ltx-fg-color:#000000;">, a uniform bound exists.
The proof follows from the idea of Lemma 5 in </span><cite class="ltx_cite ltx_citemacro_cite"><span id="S3.SS4.p1.1.8" class="ltx_text" style="--ltx-fg-color:#000000;">[</span><a href="#bib.bibx31" title="" class="ltx_ref">Reg23</a><span id="S3.SS4.p1.1.9" class="ltx_text" style="--ltx-fg-color:#000000;">]</span></cite><span id="footnote2" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">2</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">2</sup>
              <span class="ltx_tag ltx_tag_note">2</span>
              
              
              
            <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx31" title="" class="ltx_ref">Reg23</a>]</cite> actually gives an extra proof to give a uniform bound on a compact set containing <math id="footnote2.m1" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>. In our paper, we do not need to the consider the value of <math id="footnote2.m2" class="ltx_Math" alttext="P^{\sigma_{\Lambda}}_{G}(\lambda)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>P</mi><mi>G</mi><msub><mi>σ</mi><mi mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P^{\sigma_{\Lambda}}_{G}(\lambda)</annotation></semantics></math> near the point <math id="footnote2.m3" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>, which slightly simplifies the proof of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx31" title="" class="ltx_ref">Reg23</a>]</cite></span></span></span><span id="S3.SS4.p1.1.10" class="ltx_text" style="--ltx-fg-color:#000000;">, and uses Montel theorem as a key tool.
Since Montel theorem holds for multivariate functions, we also view </span><math id="S3.SS4.p1.m7" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math><span id="S3.SS4.p1.1.11" class="ltx_text" style="--ltx-fg-color:#000000;"> and </span><math id="S3.SS4.p1.m8" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math><span id="S3.SS4.p1.1.12" class="ltx_text" style="--ltx-fg-color:#000000;"> as complex-valued variables and we have the following uniform bound.</span></p>
</div>
<div id="Thmtheorem24" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem" style="--ltx-fg-color:#000000;"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem24.2" class="ltx_text ltx_font_bold">Lemma 24</span></span><span id="Thmtheorem24.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem24.p1" class="ltx_para">
<p id="Thmtheorem24.p1.1" class="ltx_p"><span id="Thmtheorem24.p1.1.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#000000;">Let <math id="Thmtheorem24.p1.m1" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> be
a family of graphs, and <math id="Thmtheorem24.p1.m2" class="ltx_Math" alttext="U_{1},U_{2},U_{3}\subseteq\mathbb{C}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⊆</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℂ</mi></mrow></mrow><annotation encoding="application/x-tex">U_{1},U_{2},U_{3}\subseteq\mathbb{C}</annotation></semantics></math> be quasi-neighborhoods of some <math id="Thmtheorem24.p1.m3" class="ltx_Math" alttext="\beta_{0},\gamma_{0},\lambda_{0}{\geq 0}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≥</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow></mrow><annotation encoding="application/x-tex">\beta_{0},\gamma_{0},\lambda_{0}{\geq 0}</annotation></semantics></math> that are not all zeros and <math id="Thmtheorem24.p1.m4" class="ltx_Math" alttext="U_{1}\times U_{2}\times U_{3}\neq\{(\beta_{0},\gamma_{0},\lambda_{0})\}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≠</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">U_{1}\times U_{2}\times U_{3}\neq\{(\beta_{0},\gamma_{0},\lambda_{0})\}</annotation></semantics></math> (i.e., among <math id="Thmtheorem24.p1.m5" class="ltx_Math" alttext="U_{1},U_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub></mrow><annotation encoding="application/x-tex">U_{1},U_{2}</annotation></semantics></math>, and <math id="Thmtheorem24.p1.m6" class="ltx_Math" alttext="U_{3}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msub><annotation encoding="application/x-tex">U_{3}</annotation></semantics></math>, at least one is a complex neighborhood).
Denote the set <math id="Thmtheorem24.p1.m7" class="ltx_Math" alttext="(U_{1}\times U_{2}\backslash\{(0,0)\})\times(U_{3}\backslash\{0\})" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub></mrow><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">\</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.055em" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.222em">×</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msub><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">\</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(U_{1}\times U_{2}\backslash\{(0,0)\})\times(U_{3}\backslash\{0\})</annotation></semantics></math> by <math id="Thmtheorem24.p1.m8" class="ltx_Math" alttext="\mathbf{U}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐔</mi><annotation encoding="application/x-tex">\mathbf{U}</annotation></semantics></math>.
Suppose that the partition function of the 2-spin system defined on <math id="Thmtheorem24.p1.m9" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> is zero-free on <math id="Thmtheorem24.p1.m10" class="ltx_Math" alttext="\mathbf{U}" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐔</mi><annotation encoding="application/x-tex">\mathbf{U}</annotation></semantics></math>.
Then for any compact set <math id="Thmtheorem24.p1.m11" class="ltx_Math" alttext="S\subseteq\mathbf{U}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⊆</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐔</mi></mrow><annotation encoding="application/x-tex">S\subseteq\mathbf{U}</annotation></semantics></math>, there exists an <math id="Thmtheorem24.p1.m12" class="ltx_Math" alttext="M&gt;0" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">M</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&gt;</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><annotation encoding="application/x-tex">M&gt;0</annotation></semantics></math> such that for every <math id="Thmtheorem24.p1.m13" class="ltx_Math" alttext="G\in\mathcal{G}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒢</mi></mrow><annotation encoding="application/x-tex">G\in\mathcal{G}</annotation></semantics></math>, any feasible partial configuration <math id="Thmtheorem24.p1.m14" class="ltx_Math" alttext="\sigma_{\Lambda}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub><annotation encoding="application/x-tex">\sigma_{\Lambda}</annotation></semantics></math>, any vertex <math id="Thmtheorem24.p1.m15" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> proper to <math id="Thmtheorem24.p1.m16" class="ltx_Math" alttext="\sigma_{\Lambda}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub><annotation encoding="application/x-tex">\sigma_{\Lambda}</annotation></semantics></math>, we have <math id="Thmtheorem24.p1.m17" class="ltx_Math" alttext="|P^{\sigma_{\Lambda}}_{G,v}(\beta,\gamma,\lambda)|\leq M" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">P</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">M</mi></mrow><annotation encoding="application/x-tex">|P^{\sigma_{\Lambda}}_{G,v}(\beta,\gamma,\lambda)|\leq M</annotation></semantics></math> for all <math id="Thmtheorem24.p1.m18" class="ltx_Math" alttext="(\beta,\gamma,\lambda)\in S" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi></mrow><annotation encoding="application/x-tex">(\beta,\gamma,\lambda)\in S</annotation></semantics></math>.</span></p>
</div>
