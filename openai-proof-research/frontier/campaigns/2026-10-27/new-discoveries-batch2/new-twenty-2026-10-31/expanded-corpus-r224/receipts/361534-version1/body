)</mo></mrow><mo rspace="0.111em">=</mo><munder><mo movablelimits="false">∑</mo><mfrac linethickness="0pt"><mrow><mi>σ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>V</mi><mo stretchy="false">→</mo><mrow><mo stretchy="false">{</mo><mrow><mo lspace="0em" rspace="0em">+</mo><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">−</mo></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mrow><mi>σ</mi><mo fence="false" stretchy="false">|</mo><msub><mrow></mrow><mi mathvariant="normal">Λ</mi></msub><mo lspace="0.167em">=</mo><mi>σ</mi><msub><mrow></mrow><mi mathvariant="normal">Λ</mi></msub><mo>,</mo><mi>σ</mi><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo><mo>=</mo><mi>σ</mi><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo><mo rspace="0em">=</mo><mo lspace="0em">+</mo></mrow></mfrac></munder><mi>w</mi><mrow><mo stretchy="false">(</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">Z^{\sigma_{\Lambda},+}_{G,v}(\beta,\gamma,\lambda)=\sum\limits_{\sigma:V\to\{+,-\}\atop\sigma|_{\Lambda}=\sigma_{\Lambda},\sigma(v)=+}w(\sigma),\text{ and }Z^{\sigma_{\Lambda},+,+}_{G,v,u}(\beta,\gamma,\lambda)=\sum\limits_{\sigma:V\to\{+,-\}\atop\sigma|_{\Lambda}=\sigma_{\Lambda},\sigma(v)=\sigma(u)=+}w(\sigma),</annotation></semantics></math></td>
