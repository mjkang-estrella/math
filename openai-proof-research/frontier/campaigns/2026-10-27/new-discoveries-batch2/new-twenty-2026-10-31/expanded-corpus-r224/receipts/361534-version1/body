hcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Z</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Z</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi></mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">,</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">+</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{Z_{G,u}^{\sigma_{\Lambda},+}(\lambda)Z_{G,v}^{\sigma_{\Lambda},+}(\lambda)-Z_{G,v,u}^{\sigma_{\Lambda},+,+}(\lambda)Z_{G}^{\sigma_{\Lambda}}(\lambda)}{Z_{G}^{\sigma_{\Lambda}}(\lambda)Z_{G,u}^{\sigma_{\Lambda},+}(\lambda)}</