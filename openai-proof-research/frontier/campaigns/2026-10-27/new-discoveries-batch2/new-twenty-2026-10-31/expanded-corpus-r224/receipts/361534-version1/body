 style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P_{G,v}^{\sigma_{\Lambda_{1}}}(\beta)</annotation></semantics></math> and <math id="Thmtheorem27.p1.m19" class="ltx_Math" alttext="P_{G,v}^{\tau_{\Lambda_{2}}}(\beta)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">P</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">τ</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P_{G,v}^{\tau_{\Lambda_{2}}}(\beta)</annotation></semantics></math> are analytic on <math id="Thmtheorem27.p1.m20" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>, and their corresponding Taylor series <math id="Thmtheorem27.p1.m21" class="ltx_Math" alttext="\sum^{\infty}_{i=0}a_{i}(\beta-1/\gamma)^{i}" display="inline" intent=":literal"><semantics><mrow><msubsup><mo style="--ltx-fg-