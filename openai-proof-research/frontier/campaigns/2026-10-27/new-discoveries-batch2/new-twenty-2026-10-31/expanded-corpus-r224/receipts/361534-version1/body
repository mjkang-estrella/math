stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Z</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi></mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Λ</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">,</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">−</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">P_{G,v}^{\sigma_{\Lambda},u^{-}}(\lambda):=\frac{Z_{G,v,u}^{\sigma_{\Lambda},+,-}(\lambda)}{Z_{G,u}^{\sigma_{\Lambda},-}(\lambda)}</annotation></semantics></math> are analytic on <math id="Thmtheorem18.p1.m16" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>, and
their corresponding Taylor series <math id="Thmtheorem18.p1.m17" class="ltx_Math" alttext="\sum^{\infty}_{i=0}a_{i}\lambda^{i}" display="inline" intent=":literal"><semantics><mrow><msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">∞</mi></msubsup><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">a</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\sum^{\infty}_{i=0}a_{i}\lambda^{i}</annotation></semantics></math>,
<math id="Thmtheorem18.p1.m18" class="ltx_Math" alttext="\sum^{\infty}_{i=0}b_{i}\lambda^{i}" display="inline" intent=":literal"><semantics><mrow><msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">∞</mi></msubsup><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\sum^{\infty}_{i=0}b_{i}\lambda^{i}</annotation></semantics></math>, and <math id="Thmtheorem18.p1.m19" class="ltx_Math" alttext="\sum^{\infty}_{i=0}c_{i}\lambda^{i}" display="inline" intent=":literal"><semantics><mrow><msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">∞</mi></msubsup><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\sum^{\infty}_{i=0}c_{i}\lambda^{i}</annotation></semantics></math> near <math id="Thmtheorem18.p1.m20" class="ltx_Math" alttext="\lambda=0" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><annotation encoding="application/x-tex">\lambda=0</annotation></semantics></math> satisfy <math id="Thmtheorem18.p1.m21" class="ltx_Math" alttext="a_{i}=b_{i}=c_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">a</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub></mrow><annotation encoding="application/x-tex">a_{i}=b_{i}=c_{i}</annotation></semantics></math> for <math id="Thmtheorem18.p1.m22" class="ltx_Math" alttext="0\leq i\leq d(v,u)-1" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≤</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></mrow><annotation encoding="application/x-tex">0\leq i\leq d(v,u)-1</annotation></semantics></math>.</span></p>
