<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex50.m1" class="ltx_Math" alttext="\displaystyle&gt;g(\ell_{2},\ell_{3})," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>&gt;</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub><mo>,</mo><msub><mi mathvariant="normal">ℓ</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle&gt;g(\ell_{2},\ell_{3}),</annotation></semantics></math></td>
