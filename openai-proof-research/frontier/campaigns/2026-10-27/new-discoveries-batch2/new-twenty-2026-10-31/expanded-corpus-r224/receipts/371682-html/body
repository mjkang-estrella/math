<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex48.m1" class="ltx_Math" alttext="\displaystyle=g(\ell_{2},\ell_{3})\cdot\left(\frac{7}{8}\right)^{3\ell_{2}+3}\cdot\left(\frac{23}{32}\right)^{3(\ell_{3}-2)-2\ell_{2}}\cdot\left(\frac{115}{256}\right)^{-2\ell_{3}+3}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub><mo>,</mo><msub><mi mathvariant="normal">ℓ</mi><mn>3</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>7</mn><mn>8</mn></mfrac></mstyle><mo rspace="0.055em">)</mo></mrow><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub></mrow><mo>+</mo><mn>3</mn></mrow></msup><mo rspace="0.222em">⋅</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>23</mn><mn>32</mn></mfrac></mstyle><mo rspace="0.055em">)</mo></mrow><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>3</mn></msub><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub></mrow></mrow></msup><mo rspace="0.222em">⋅</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>115</mn><mn>256</mn></mfrac></mstyle><mo>)</mo></mrow><mrow><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">ℓ</mi><mn>3</mn></msub></mrow></mrow><mo>+</mo><mn>3</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=g(\ell_{2},\ell_{3})\cdot\left(\frac{7}{8}\right)^{3\ell_{2}+3}\cdot\left(\frac{23}{32}\right)^{3(\ell_{3}-2)-2\ell_{2}}\cdot\left(\frac{115}{256}\right)^{-2\ell_{3}+3}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex49"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex49.m1" class="ltx_Math" alttext="\displaystyle=g(\ell_{2},\ell_{3})\cdot\left(\underbrace{\left(\frac{7}{8}\right)^{3}\left(\frac{23}{32}\right)^{-2}}_{\approx 1.3}\right)^{\ell_{2}}\cdot\left(\underbrace{\left(\frac{23}{32}\right)^{3}\left(\frac{115}{256}\right)^{-2}}_{\approx 1.84}\right)^{\ell_{3}}\cdot\underbrace{\left(\frac{7}{8}\right)^{3}\left(\frac{23}{32}\right)^{-6}\left(\frac{115}{256}\right)^{3}}_{\approx 0.44}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub><mo>,</mo><msub><mi mathvariant="normal">ℓ</mi><mn>3</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mrow><mo>(</mo><munder><munder accentunder="true"><mrow><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>7</mn><mn>8</mn></mfrac></mstyle><mo>)</mo></mrow><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>23</mn><mn>32</mn></mfrac></mstyle><mo>)</mo></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><mo stretchy="true">⏟</mo></munder><mrow><mphantom></mphantom><mo>≈</mo><mn>1.3</mn></mrow></munder><mo rspace="0.055em">)</mo></mrow><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub></msup><mo rspace="0.222em">⋅</mo><msup><mrow><mo>(</mo><munder><munder accentunder="true"><mrow><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>23</mn><mn>32</mn></mfrac></mstyle><mo>)</mo></mrow><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>115</mn><mn>256</mn></mfrac></mstyle><mo>)</mo></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><mo stretchy="true">⏟</mo></munder><mrow><mphantom></mphantom><mo>≈</mo><mn>1.84</mn></mrow></munder><mo rspace="0.055em">)</mo></mrow><msub><mi mathvariant="normal">ℓ</mi><mn>3</mn></msub></msup><mo rspace="0.222em">⋅</mo><munder><munder accentunder="true"><mrow><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>7</mn><mn>8</mn></mfrac></mstyle><mo>)</mo></mrow><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>23</mn><mn>32</mn></mfrac></mstyle><mo>)</mo></mrow><mrow><mo>−</mo><mn>6</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>115</mn><mn>256</mn></mfrac></mstyle><mo>)</mo></mrow><mn>3</mn></msup></mrow><mo stretchy="true">⏟</mo></munder><mrow><mphantom></mphantom><mo>≈</mo><mn>0.44</mn></mrow></munder></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=g(\ell_{2},\ell_{3})\cdot\left(\underbrace{\left(\frac{7}{8}\right)^{3}\left(\frac{23}{32}\right)^{-2}}_{\approx 1.3}\right)^{\ell_{2}}\cdot\left(\underbrace{\left(\frac{23}{32}\right)^{3}\left(\frac{115}{256}\right)^{-2}}_{\approx 1.84}\right)^{\ell_{3}}\cdot\underbrace{\left(\frac{7}{8}\right)^{3}\left(\frac{23}{32}\right)^{-6}\left(\frac{115}{256}\right)^{3}}_{\approx 0.44}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
