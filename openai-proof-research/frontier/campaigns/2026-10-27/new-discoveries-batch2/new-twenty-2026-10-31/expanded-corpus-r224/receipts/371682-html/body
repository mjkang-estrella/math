<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex60.m1" class="ltx_math_unparsed" alttext="\mathbb{P}\Big(\exists X\subseteq V(T),|X|=\ell+1,\text{ $X$ is partitionable}\Big)&lt;\frac{1}{2}." display="block" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mo rspace="0.167em">∃</mo><mi>X</mi><mo>⊆</mo><mi>V</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>X</mi><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">=</mo><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn><mo>,</mo><mrow><mtext> </mtext><mi>X</mi><mtext> is partitionable</mtext></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo>&lt;</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{P}\Big(\exists X\subseteq V(T),|X|=\ell+1,\text{ $X$ is partitionable}\Big)&lt;\frac{1}{2}.</annotation></semantics></math></td>
