<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex47.m1" class="ltx_Math" alttext="\displaystyle=\left(\frac{7}{8}\right)^{\frac{1}{2}(\ell_{2}+3)(\ell_{2}+2)}\cdot\left(\frac{23}{32}\right)^{(\ell_{2}+3)(\ell_{3}-2)}\cdot\left(\frac{115}{256}\right)^{\frac{1}{2}(\ell_{3}-2)(\ell_{3}-3)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>7</mn><mn>8</mn></mfrac></mstyle><mo rspace="0.055em">)</mo></mrow><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub><mo>+</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo rspace="0.222em">⋅</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>23</mn><mn>32</mn></mfrac></mstyle><mo rspace="0.055em">)</mo></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub><mo>+</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>3</mn></msub><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo rspace="0.222em">⋅</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>115</mn><mn>256</mn></mfrac></mstyle><mo>)</mo></mrow><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>3</mn></msub><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>3</mn></msub><mo>−</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\frac{7}{8}\right)^{\frac{1}{2}(\ell_{2}+3)(\ell_{2}+2)}\cdot\left(\frac{23}{32}\right)^{(\ell_{2}+3)(\ell_{3}-2)}\cdot\left(\frac{115}{256}\right)^{\frac{1}{2}(\ell_{3}-2)(\ell_{3}-3)}</annotation></semantics></math></td>
