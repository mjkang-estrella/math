<p id="S4.I1.i4.p1.1" class="ltx_p"><math id="S4.I1.i4.p1.m1" class="ltx_Math" alttext="(V(P),X_{0},\dots,X_{\ell+1})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>X</mi><mn>0</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>X</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(V(P),X_{0},\dots,X_{\ell+1})</annotation></semantics></math><span id="S4.I1.i4.p1.1.1" class="ltx_text ltx_font_italic"> partitions </span><math id="S4.I1.i4.p1.m2" class="ltx_Math" alttext="V(T)" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V(T)</annotation></semantics></math><span id="S4.I1.i4.p1.1.2" class="ltx_text ltx_font_italic">.</span></p>
