<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex43.m2" class="ltx_Math" alttext="\displaystyle=x^{6}-9x^{5}+36x^{4}-75x^{3}+78x^{2}-31x." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mrow><mrow><msup><mi>x</mi><mn>6</mn></msup><mo>−</mo><mrow><mn>9</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mn>5</mn></msup></mrow></mrow><mo>+</mo><mrow><mn>36</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mn>4</mn></msup></mrow></mrow><mo>−</mo><mrow><mn>75</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mn>3</mn></msup></mrow></mrow><mo>+</mo><mrow><mn>78</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mn>2</mn></msup></mrow></mrow><mo>−</mo><mrow><mn>31</mn><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=x^{6}-9x^{5}+36x^{4}-75x^{3}+78x^{2}-31x.</annotation></semantics></math></td>
