<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex37.m1" class="ltx_Math" alttext="\displaystyle=\alpha\cdot\log(n)+\underbrace{\Big(1-\alpha\cdot\log\left(4/3\right)\Big)}_{=0}-\frac{5\alpha}{(3n-5)\ln(2)}-27\left(1-\frac{4}{3n-5}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mi>α</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><munder><munder accentunder="true"><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>α</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>4</mn><mo>/</mo><mn>3</mn></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo stretchy="true">⏟</mo></munder><mrow><mphantom></mphantom><mo>=</mo><mn>0</mn></mrow></munder></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>5</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>−</mo><mrow><mn>27</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>4</mn><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>5</mn></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\alpha\cdot\log(n)+\underbrace{\Big(1-\alpha\cdot\log\left(4/3\right)\Big)}_{=0}-\frac{5\alpha}{(3n-5)\ln(2)}-27\left(1-\frac{4}{3n-5}\right)</annotation></semantics></math></