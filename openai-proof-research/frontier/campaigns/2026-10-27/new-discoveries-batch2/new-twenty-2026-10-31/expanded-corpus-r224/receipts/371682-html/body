<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex36.m1" class="ltx_Math" alttext="\displaystyle\geqslant 1+\alpha\cdot\log\left(\frac{3}{4}n\right)-\frac{5\alpha}{(3n-5)\ln(2)}-27\left(1-\frac{4}{3n-5}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>⩾</mo><mrow><mrow><mn>1</mn><mo>+</mo><mrow><mi>α</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>3</mn><mn>4</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>5</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>−</mo><mrow><mn>27</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>4</mn><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>−</mo><mn>5</mn></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geqslant 1+\alpha\cdot\log\left(\frac{3}{4}n\right)-\frac{5\alpha}{(3n-5)\ln(2)}-27\left(1-\frac{4}{3n-5}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
