<p id="S4.I1.i2.p1.1" class="ltx_p"><span id="S4.I1.i2.p1.1.1" class="ltx_text ltx_font_italic">for every </span><math id="S4.I1.i2.p1.m1" class="ltx_Math" alttext="i\in[1,\ell]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[1,\ell]</annotation></semantics></math><span id="S4.I1.i2.p1.1.2" class="ltx_text ltx_font_italic">, </span><math id="S4.I1.i2.p1.m2" class="ltx_Math" alttext="X_{i}\subseteq N^{+}(v_{i})\cap N^{-}(v_{i-1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>i</mi></msub><mo>⊆</mo><mrow><mrow><msup><mi>N</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∩</mo><mrow><msup><mi>N</mi><mo>−</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">X_{i}\subseteq N^{+}(v_{i})\cap N^{-}(v_{i-1})</annotation></semantics></math><span id="S4.I1.i2.p1.1.3" class="ltx_text ltx_font_italic">;</span></p>
</div></li>
