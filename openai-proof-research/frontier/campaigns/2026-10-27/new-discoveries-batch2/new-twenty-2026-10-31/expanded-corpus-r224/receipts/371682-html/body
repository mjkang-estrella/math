<div id="S4.I1.i3.p1" class="ltx_para">
<p id="S4.I1.i3.p1.1" class="ltx_p"><span id="S4.I1.i3.p1.1.1" class="ltx_text ltx_font_italic">for every </span><math id="S4.I1.i3.p1.m1" class="ltx_Math" alttext="i\in[1,\ell]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[1,\ell]</annotation></semantics></math><span id="S4.I1.i3.p1.1.2" class="ltx_text ltx_font_italic">, </span><math id="S4.I1.i3.p1.m2" class="ltx_Math" alttext="T[X_{i}]" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">T[X_{i}]</annotation></semantics></math><span id="S4.I1.i3.p1.1.3" class="ltx_text ltx_font_italic"> is acyclic; and</span></p>
</div></li>
