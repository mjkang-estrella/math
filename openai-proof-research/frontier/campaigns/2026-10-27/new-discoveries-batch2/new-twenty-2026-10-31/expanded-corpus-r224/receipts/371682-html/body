<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex42"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex42.m1" class="ltx_Math" alttext="\displaystyle\mathscr{P}(K_{2,3},x)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathscript">𝒫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>K</mi><mrow><mn>2</mn><mo>,</mo><mn>3</mn></mrow></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathscr{P}(K_{2,3},x)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex42.m2" class="ltx_Math" alttext="\displaystyle=x^{5}-6x^{4}+15x^{3}-17x^{2}+7x," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mrow><msup><mi>x</mi><mn>5</mn></msup><mo>−</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mn>4</mn></msup></mrow></mrow><mo>+</mo><mrow><mn>15</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mn>3</mn></msup></mrow></mrow><mo>−</mo><mrow><mn>17</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=x^{5}-6x^{4}+15x^{3}-17x^{2}+7x,</annotation></semantics></math></td>
