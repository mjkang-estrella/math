<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex28.m1" class="ltx_Math" alttext="\displaystyle=\{v_{i-1},\dots,v_{i+5}\}\cup\bigcup_{j=i}^{i+5}X_{j}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo stretchy="false">{</mo><msub><mi>v</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>v</mi><mrow><mi>i</mi><mo>+</mo><mn>5</mn></mrow></msub><mo stretchy="false">}</mo></mrow><mo>∪</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">⋃</mo><mrow><mi>j</mi><mo>=</mo><mi>i</mi></mrow><mrow><mi>i</mi><mo>+</mo><mn>5</mn></mrow></munderover></mstyle><msub><mi>X</mi><mi>j</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\{v_{i-1},\dots,v_{i+5}\}\cup\bigcup_{j=i}^{i+5}X_{j}</annotation></semantics></math></td>
