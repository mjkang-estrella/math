<div id="S3.Thmthm8.p1" class="ltx_para">
<p id="S3.Thmthm8.p1.1" class="ltx_p"><span id="S3.Thmthm8.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S3.Thmthm8.p1.m1" class="ltx_Math" alttext="B_{1}=\mathbf{i},B_{2}=\mathbf{j},B_{3}=\mathbf{k}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>B</mi><mn>1</mn></msub><mo>=</mo><mi>𝐢</mi></mrow><mo>,</mo><mrow><msub><mi>B</mi><mn>2</mn></msub><mo>=</mo><mi>𝐣</mi></mrow><mo>,</mo><mrow><msub><mi>B</mi><mn>3</mn></msub><mo>=</mo><mi>𝐤</mi></mrow></mrow><annotation encoding="application/x-tex">B_{1}=\mathbf{i},B_{2}=\mathbf{j},B_{3}=\mathbf{k}</annotation></semantics></math>, then</span></p>
