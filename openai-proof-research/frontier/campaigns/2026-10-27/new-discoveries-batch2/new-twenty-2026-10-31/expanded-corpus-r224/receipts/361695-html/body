<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S2.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S2.I2.i3.p1" class="ltx_para">
<p id="S2.I2.i3.p1.1" class="ltx_p"><span id="S2.I2.i3.p1.1.1" class="ltx_text ltx_font_italic">If </span><math id="S2.I2.i3.p1.m1" class="ltx_Math" alttext="m\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">m\geq 2</annotation></semantics></math><span id="S2.I2.i3.p1.1.2" class="ltx_text ltx_font_italic"> and </span><math id="S2.I2.i3.p1.m2" class="ltx_Math" alttext="n=3" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">n=3</annotation></semantics></math><span id="S2.I2.i3.p1.1.3" class="ltx_text ltx_font_italic">, then</span></p>
