chy="false">‖</mo></mrow><mo>=</mo><mrow><mo stretchy="false">‖</mo><mi>q</mi><mo stretchy="false">‖</mo></mrow></mrow><annotation encoding="application/x-tex">\|p\|=\|q\|</annotation></semantics></math><span id="S3.I3.i2.p1.2.6" class="ltx_text ltx_font_italic">.</span></p>
