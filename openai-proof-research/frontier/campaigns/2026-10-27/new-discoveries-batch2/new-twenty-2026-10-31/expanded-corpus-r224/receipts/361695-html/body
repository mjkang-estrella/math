<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex12.m1" class="ltx_Math" alttext="(P,R)\cdot(B_{1},\cdots,B_{m})=(\diag(C_{1},0),\diag(C_{2},0),\diag(C_{3},0),0,\cdots,0," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mi>P</mi><mo>,</mo><mi>R</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><msub><mi>B</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>B</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>diag</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mn>1</mn></msub><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>diag</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mn>2</mn></msub><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>diag</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mn>3</mn></msub><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mn>0</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mn>0</mn></mrow><mo fence="true" lspace="0em" rspace="0em">CLOSE</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">(P,R)\cdot(B_{1},\cdots,B_{m})=(\diag(C_{1},0),\diag(C_{2},0),\diag(C_{3},0),0,\cdots,0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.I1.i1.p1.3" class="ltx_p"><span id="S2.I1.i1.p1.3.1" class="ltx_text ltx_font_italic">where for some </span><math id="S2.I1.i1.p1.m3" class="ltx_Math" alttext="\lambda\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda\geq 0</annotation></semantics></math><span id="S2.I1.i1.p1.3.2" class="ltx_text ltx_font_italic">,</span></p>
