<p id="S3.I4.i2.p1.1" class="ltx_p"><math id="S3.I4.i2.p1.m1" class="ltx_Math" alttext="\|A_{2}\|\geq\cdots\geq\|A_{m}\|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><msub><mi>A</mi><mn>2</mn></msub><mo stretchy="false">‖</mo></mrow><mo rspace="0.1389em">≥</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">≥</mo><mrow><mo stretchy="false">‖</mo><msub><mi>A</mi><mi>m</mi></msub><mo stretchy="false">‖</mo></mrow></mrow><annotation encoding="application/x-tex">\|A_{2}\|\geq\cdots\geq\|A_{m}\|</annotation></semantics></math><span id="S3.I4.i2.p1.1.1" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
<p id="S3.Thmthm11.p1.2" class="ltx_p"><span id="S3.Thmthm11.p1.2.1" class="ltx_text ltx_font_italic">Then we have</span></p>
