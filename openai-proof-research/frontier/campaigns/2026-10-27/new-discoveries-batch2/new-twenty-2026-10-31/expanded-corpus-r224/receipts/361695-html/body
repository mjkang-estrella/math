</div></li>
<li id="S2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S2.I1.i2.p1" class="ltx_para">
<p id="S2.I1.i2.p1.1" class="ltx_p"><span id="S2.I1.i2.p1.1.1" class="ltx_text ltx_font_italic">If </span><math id="S2.I1.i2.p1.m1" class="ltx_Math" alttext="n\geq 4" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">n\geq 4</annotation></semantics></math><span id="S2.I1.i2.p1.1.2" class="ltx_text ltx_font_italic">, then</span></p>
<table id="S2.Ex14" class="ltx_equation ltx_eqn_table">

