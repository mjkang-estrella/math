<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex11.m1" class="ltx_Math" alttext="\sum^{m}_{r,s=1}\|\left[B_{r},B_{s}\right]\|^{2}\leq\frac{1}{3}\left(\sum^{m}_{r=1}\|B_{r}\|^{2}\right)^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>r</mi><mo>,</mo><mi>s</mi></mrow><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><msup><mrow><mo lspace="0em" stretchy="false">‖</mo><mrow><mo>[</mo><mrow><msub><mi>B</mi><mi>r</mi></msub><mo>,</mo><msub><mi>B</mi><mi>s</mi></msub></mrow><mo>]</mo></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>≤</mo><mrow><mfrac><mn>1</mn><mn>3</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false" rspace="0em">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><msup><mrow><mo stretchy="false">‖</mo><msub><mi>B</mi><mi>r</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum^{m}_{r,s=1}\|\left[B_{r},B_{s}\right]\|^{2}\leq\frac{1}{3}\left(\sum^{m}_{r=1}\|B_{r}\|^{2}\right)^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.I1.i1.p1.2" class="ltx_p"><span id="S2.I1.i1.p1.2.1" class="ltx_text ltx_font_italic">The equality holds if and only if there exists a </span><math id="S2.I1.i1.p1.m2" class="ltx_Math" alttext="(P,R)\in K(n,m)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>P</mi><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(P,R)\in K(n,m)</annotation></semantics></math><span id="S2.I1.i1.p1.2.2" class="ltx_text ltx_font_italic"> such that</span></p>
<table id="S2.Ex12" class="ltx_equation ltx_eqn_table">

