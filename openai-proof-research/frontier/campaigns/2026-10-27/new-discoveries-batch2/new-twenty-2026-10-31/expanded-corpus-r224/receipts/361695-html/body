</table>
<p id="S3.I5.i2.p1.2" class="ltx_p"><span id="S3.I5.i2.p1.2.1" class="ltx_text ltx_font_italic">and
</span><math id="S3.I5.i2.p1.m3" class="ltx_Math" alttext="A_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>α</mi></msub><annotation encoding="application/x-tex">A_{\alpha}</annotation></semantics></math><span id="S3.I5.i2.p1.2.2" class="ltx_text ltx_font_italic"> is </span><math id="S3.I5.i2.p1.m4" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math><span id="S3.I5.i2.p1.2.3" class="ltx_text ltx_font_italic"> times the matrix whose only nonzero entries are </span><math id="S3.I5.i2.p1.m5" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math><span id="S3.I5.i2.p1.2.4" class="ltx_text ltx_font_italic"> at the </span><math id="S3.I5.i2.p1.m6" class="ltx_Math" alttext="(1,\alpha)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi>α</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1,\alpha)</annotation></semantics></math><span id="S3.I5.i2.p1.2.5" class="ltx_text ltx_font_italic"> and </span><math id="S3.I5.i2.p1.m7" class="ltx_Math" alttext="(\alpha,1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>α</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\alpha,1)</annotation></semantics></math><span id="S3.I5.i2.p1.2.6" class="ltx_text ltx_font_italic"> places, where </span><math id="S3.I5.i2.p1.m8" class="ltx_Math" alttext="\alpha=2,\cdots,n" display="inline" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo>=</mo><mn>2</mn></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">\alpha=2,\cdots,n</annotation></semantics></math><span id="S3.I5.i2.p1.2.7" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S3.SS4.p2" class="ltx_para">
<p id="S3.SS4.p2.1" class="ltx_p">Equivalently, one has the following geometric version of the Lu inequality.</p>
</div>
<div id="S3.Thmthm12" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmthm12.2" class="ltx_text ltx_font_bold">Theorem 3.12</span></span><span id="S3.Thmthm12.3" class="ltx_text ltx_font_bold"> </span>(Normal Ricci curvature inequality <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib56" title="" class="ltx_ref">56</a>]</cite>)<span id="S3.Thmthm12.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmthm12.p1" class="ltx_para">
<p id="S3.Thmthm12.p1.1" class="ltx_p"><span id="S3.Thmthm12.p1.1.1" class="ltx_text ltx_font_italic">For any <math id="S3.Thmthm12.p1.m1" class="ltx_Math" alttext="1\leq r\leq m" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>r</mi><mo>≤</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">1\leq r\leq m</annotation></semantics></math>,</span></p>
<table id="S3.Ex31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex31.m1" class="ltx_Math" alttext="{\rm Ric}^{\bot}\left(\xi_{r},\xi_{r}\right)\leq\left(\max\limits_{s\not=r}\|B_{s}\|^{2}+\sum_{s\not=r}\|B_{s}\|^{2}\right)\|B_{r}\|^{2}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>Ric</mi><mo>⊥</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>ξ</mi><mi>r</mi></msub><mo>,</mo><msub><mi>ξ</mi><mi>r</mi></msub><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mo>(</mo><mrow><mrow><munder><mi>max</mi><mrow><mi>s</mi><mo>≠</mo><mi>r</mi></mrow></munder><mo>⁡</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>B</mi><mi>s</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo rspace="0.055em">+</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>s</mi><mo>≠</mo><mi>r</mi></mrow></munder><msup><mrow><mo stretchy="false">‖</mo><msub><mi>B</mi><mi>s</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>B</mi><mi>r</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{\rm Ric}^{\bot}\left(\xi_{r},\xi_{r}\right)\leq\left(\max\limits_{s\not=r}\|B_{s}\|^{2}+\sum_{s\not=r}\|B_{s}\|^{2}\right)\|B_{r}\|^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmthm12.p1.2" class="ltx_p"><span id="S3.Thmthm12.p1.2.1" class="ltx_text ltx_font_italic">where <math id="S3.Thmthm12.p1.m2" class="ltx_Math" alttext="{\rm Ric}^{\bot}\left(\xi_{r},\xi_{r}\right):=\left(\sum_{s\not=r}\|R^{\bot}_{rs}\|^{2}\right)^{\frac{1}{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>Ric</mi><mo>⊥</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>ξ</mi><mi>r</mi></msub><mo>,</mo><msub><mi>ξ</mi><mi>r</mi></msub><mo>)</mo></mrow></mrow><mo>:=</mo><msup><mrow><mo>(</mo><mrow><msub><mo lspace="0em" rspace="0em">∑</mo><mrow><mi>s</mi><mo>≠</mo><mi>r</mi></mrow></msub><msup><mrow><mo stretchy="false">‖</mo><msubsup><mi>R</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>⊥</mo></msubsup><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>)</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><annotation encoding="application/x-tex">{\rm Ric}^{\bot}\left(\xi_{r},\xi_{r}\right):=\left(\sum_{s\not=r}\|R^{\bot}_{rs}\|^{2}\right)^{\frac{1}{2}}</annotation></semantics></math> is the normal Ricci curvature.</span></p>
</div>
</div>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4. </span>Open questions</h2>

<div id="S4.p1" class="ltx_para">
<p id="S4.p1.1" class="ltx_p">In this section, we would like to mention more about possible future studies on DDVV-type inequalities and related topics.</p>
</div>
<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.1. </span>Questions about DDVV-type inequalities</h3>

<div id="S4.SS1.p1" class="ltx_para">
<p id="S4.SS1.p1.1" class="ltx_p">We begin with questions about the algebraic aspects of DDVV-type inequalities.</p>
</div>
<div id="S4.Thmthm1" class="ltx_theorem ltx_theorem_ques">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm1.2" class="ltx_text ltx_font_bold">Question 4.1</span></span><span id="S4.Thmthm1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm1.p1" class="ltx_para">
<p id="S4.Thmthm1.p1.1" class="ltx_p"><span id="S4.Thmthm1.p1.1.1" class="ltx_text ltx_font_italic">What can we expect for the quotient</span></p>
<table id="S4.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex1.m1" class="ltx_Math" alttext="\frac{\sum_{r,s=1}^{m}\|[B_{r},B_{s}]\|^{2}}{\left(\sum_{r=1}^{m}\|B_{r}\|^{2}\right)^{2}}?" display="block" intent=":literal"><semantics><mrow><mfrac><mrow><msubsup><mo>∑</mo><mrow><mrow><mi>r</mi><mo>,</mo><mi>s</mi></mrow><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><msup><mrow><mo lspace="0em" stretchy="false">‖</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>B</mi><mi>r</mi></msub><mo>,</mo><msub><mi>B</mi><mi>s</mi></msub></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><msup><mrow><mo>(</mo><mrow><msubsup><mo lspace="0em" rspace="0em">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><msup><mrow><mo stretchy="false">‖</mo><msub><mi>B</mi><mi>r</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>)</mo></mrow><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>?</mi></mrow><annotation encoding="application/x-tex">\frac{\sum_{r,s=1}^{m}\|[B_{r},B_{s}]\|^{2}}{\left(\sum_{r=1}^{m}\|B_{r}\|^{2}\right)^{2}}?</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm1.p1.2" class="ltx_p"><span id="S4.Thmthm1.p1.2.1" class="ltx_text ltx_font_italic">What is the expectation of the commutators of random matrices in certain categories like GOE, GUE, and GSE?</span></p>
</div>
</div>
<div id="S4.SS1.p2" class="ltx_para">
<p id="S4.SS1.p2.1" class="ltx_p">It seems that the lists of the optimal constant <math id="S4.SS1.p2.m1" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> would possibly have some links with random matrix theory or quantum physics. However, it is just our naive and wild guess since we know nothing about that.</p>
</div>
<div id="S4.Thmthm2" class="ltx_theorem ltx_theorem_ques">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm2.2" class="ltx_text ltx_font_bold">Question 4.2</span></span><span id="S4.Thmthm2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm2.p1" class="ltx_para">
<p id="S4.Thmthm2.p1.1" class="ltx_p"><span id="S4.Thmthm2.p1.1.1" class="ltx_text ltx_font_italic">Find more DDVV-type inequalities for matrices, Lie algebras or operators lying in certain subspaces of special interest like spaces of austere matrices (see for a special example in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib39" title="" class="ltx_ref">39</a>]</cite>).</span></p>
</div>
</div>
<div id="S4.SS1.p3" class="ltx_para">
<p id="S4.SS1.p3.1" class="ltx_p">László <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib44" title="" class="ltx_ref">44</a>]</cite> proved that: <em id="S4.SS1.p3.1.1" class="ltx_emph ltx_font_italic">the smallest value <math id="S4.SS1.p3.m1" class="ltx_Math" alttext="\gamma_{n}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\gamma_{n}</annotation></semantics></math> so that the nonnegative polynomial</em></p>
<table id="S4.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex2.m1" class="ltx_Math" alttext="F(X,Y):=\left(2+\gamma_{n}\right)\left(\|X\|^{2}\|Y\|^{2}-|\left\langle X,Y\right\rangle|^{2}\right)-\|[X,Y]\|^{2}\quad\quad(X,Y\in\mathbb{R}^{n\times n})" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><mrow><mo>(</mo><mrow><mn>2</mn><mo>+</mo><msub><mi>γ</mi><mi>n</mi></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>X</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>Y</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>−</mo><msup><mrow><mo stretchy="false">|</mo><mrow><mo>⟨</mo><mrow><mi>X</mi><mo>,</mo><mi>Y</mi></mrow><mo>⟩</mo></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow><mo>)</mo></mrow></mrow><mo>−</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mo stretchy="false">[</mo><mrow><mi>X</mi><mo>,</mo><mi>Y</mi></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mrow><mi>Y</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F(X,Y):=\left(2+\gamma_{n}\right)\left(\|X\|^{2}\|Y\|^{2}-|\left\langle X,Y\right\rangle|^{2}\right)-\|[X,Y]\|^{2}\quad\quad(X,Y\in\mathbb{R}^{n\times n})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p3.2" class="ltx_p"><em id="S4.SS1.p3.2.1" class="ltx_emph ltx_font_italic">is a sum of squares (SOS) of polynomials is <math id="S4.SS1.p3.m2" class="ltx_Math" alttext="\gamma_{n}=\frac{n-2}{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mi>n</mi></msub><mo>=</mo><mfrac><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">\gamma_{n}=\frac{n-2}{2}</annotation></semantics></math>.</em>
Based on this result and many similar results (cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib45" title="" class="ltx_ref">45</a>, <a href="#bib.bib59" title="" class="ltx_ref">59</a>]</cite>), Lu-Wenzel <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib59" title="" class="ltx_ref">59</a>]</cite> proposed the following conjecture.</p>
</div>
<div id="S4.Thmthm3" class="ltx_theorem ltx_theorem_conj">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm3.2" class="ltx_text ltx_font_bold">Conjecture 4.3</span></span><span id="S4.Thmthm3.3" class="ltx_text ltx_font_bold"> </span>(Lu-Wenzel <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib59" title="" class="ltx_ref">59</a>]</cite>)<span id="S4.Thmthm3.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm3.p1" class="ltx_para">
<p id="S4.Thmthm3.p1.1" class="ltx_p"><span id="S4.Thmthm3.p1.1.1" class="ltx_text ltx_font_italic">The form</span></p>
<table id="S4.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex3.m1" class="ltx_Math" alttext="2\|X\|^{2}\|Y\|^{2}-2|\left\langle X,Y\right\rangle|^{2}-\|[X,Y]\|^{2}" display="block" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>X</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>Y</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">|</mo><mrow><mo>⟨</mo><mrow><mi>X</mi><mo>,</mo><mi>Y</mi></mrow><mo>⟩</mo></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow><mo>−</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mo stretchy="false">[</mo><mrow><mi>X</mi><mo>,</mo><mi>Y</mi></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">2\|X\|^{2}\|Y\|^{2}-2|\left\langle X,Y\right\rangle|^{2}-\|[X,Y]\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm3.p1.2" class="ltx_p"><span id="S4.Thmthm3.p1.2.1" class="ltx_text ltx_font_italic">generated by two arbitrary real Toeplitz matrices is SOS.</span></p>
</div>
</div>
<div id="S4.SS1.p4" class="ltx_para">
<p id="S4.SS1.p4.1" class="ltx_p">We are also concerned about the analogous question for DDVV-type inequalities:</p>
</div>
<div id="S4.Thmthm4" class="ltx_theorem ltx_theorem_ques">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm4.2" class="ltx_text ltx_font_bold">Question 4.4</span></span><span id="S4.Thmthm4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm4.p1" class="ltx_para">
<p id="S4.Thmthm4.p1.1" class="ltx_p"><span id="S4.Thmthm4.p1.1.1" class="ltx_text ltx_font_italic">Whether the nonnegative polynomial defined by the DDVV-type inequalities (by <math id="S4.Thmthm4.p1.m1" class="ltx_Math" alttext="F(B_{1},\cdots,B_{m}):=c\left(\sum_{r=1}^{m}\|B_{r}\|^{2}\right)^{2}-\sum_{r,s=1}^{m}\|[B_{r},B_{s}]\|^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>B</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>B</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msubsup><mo lspace="0em" rspace="0em">∑</mo><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><msup><mrow><mo stretchy="false">‖</mo><msub><mi>B</mi><mi>r</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo rspace="0.055em">−</mo><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mrow><mi>r</mi><mo>,</mo><mi>s</mi></mrow><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><msup><mrow><mo stretchy="false">‖</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>B</mi><mi>r</mi></msub><mo>,</mo><msub><mi>B</mi><mi>s</mi></msub></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">F(B_{1},\cdots,B_{m}):=c\left(\sum_{r=1}^{m}\|B_{r}\|^{2}\right)^{2}-\sum_{r,s=1}^{m}\|[B_{r},B_{s}]\|^{2}</annotation></semantics></math>)
is a sum of squares of quadratic forms on the matrices in the regarded types? This would provide more examples on the generalized Hilbert’s 17th problem (cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib38" title="" class="ltx_ref">38</a>]</cite>).</span></p>
</div>
</div>
<div id="S4.SS1.p5" class="ltx_para">
<p id="S4.SS1.p5.1" class="ltx_p">The next two questions are related to the geometric aspect of the DDVV inequality.</p>
</div>
<div id="S4.Thmthm5" class="ltx_theorem ltx_theorem_ques">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm5.2" class="ltx_text ltx_font_bold">Question 4.5</span></span><span id="S4.Thmthm5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm5.p1" class="ltx_para">
<p id="S4.Thmthm5.p1.1" class="ltx_p"><span id="S4.Thmthm5.p1.1.1" class="ltx_text ltx_font_italic">What can we expect for a minimal submanifold in <math id="S4.Thmthm5.p1.m1" class="ltx_Math" alttext="\mathbf{S}^{n+1}" display="inline" intent=":literal"><semantics><msup><mi>𝐒</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">\mathbf{S}^{n+1}</annotation></semantics></math> with normal scalar curvature pinched?</span></p>
</div>
</div>
<div id="S4.SS1.p6" class="ltx_para">
<p id="S4.SS1.p6.1" class="ltx_p">In <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib39" title="" class="ltx_ref">39</a>]</cite>, Ge-Tang-Yan obtained new normal scalar curvature inequalities
(which is sharper than the DDVV inequality) on the focal submanifolds of isoparametric hypersurfaces in the unit sphere, and they characterized the subsets which achieve upper or lower bounds.</p>
</div>
<div id="S4.Thmthm6" class="ltx_theorem ltx_theorem_ques">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm6.2" class="ltx_text ltx_font_bold">Question 4.6</span></span><span id="S4.Thmthm6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm6.p1" class="ltx_para">
<p id="S4.Thmthm6.p1.1" class="ltx_p"><span id="S4.Thmthm6.p1.1.1" class="ltx_text ltx_font_italic">Classify all the submanifolds that the DDVV inequality achieves equality at every point.</span></p>
</div>
</div>
<div id="S4.SS1.p7" class="ltx_para">
<p id="S4.SS1.p7.1" class="ltx_p">Submanifolds achieving equality of the DDVV inequality everywhere are called Wintgen ideal submanifolds, which are not classified so far (cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib20" title="" class="ltx_ref">20</a>, <a href="#bib.bib23" title="" class="ltx_ref">23</a>, <a href="#bib.bib53" title="" class="ltx_ref">53</a>, <a href="#bib.bib54" title="" class="ltx_ref">54</a>, <a href="#bib.bib76" title="" class="ltx_ref">76</a>, <a href="#bib.bib80" title="" class="ltx_ref">80</a>, <a href="#bib.bib81" title="" class="ltx_ref">81</a>, <a href="#bib.bib82" title="" class="ltx_ref">82</a>, <a href="#bib.bib83" title="" class="ltx_ref">83</a>]</cite>).
See <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib10" title="" class="ltx_ref">10</a>]</cite> for a detailed survey on the research of Wintgen ideal submanifolds.</p>
</div>
</section>
<section id="S4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.2. </span>Generalized Peng-Terng 2nd-Gap.</h3>

<div id="S4.SS2.p1" class="ltx_para">
<p id="S4.SS2.p1.1" class="ltx_p">By Theorem <a href="#S2.Thmthm5" title="Theorem 2.5 (Lu[]). ‣ 2.1. DDVV inequality in submanifold geometry ‣ 2. The origin and applications in geometry ‣ A survey on the DDVV-type inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.5</span></a>,
the quantity <math id="S4.SS2.p1.m1" class="ltx_Math" alttext="S+\lambda_{2}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>+</mo><msub><mi>λ</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">S+\lambda_{2}</annotation></semantics></math> might be the right object to study pinching theorems. To justify this, we introduce the following Lu’s conjecture:</p>
</div>
<div id="S4.Thmthm7" class="ltx_theorem ltx_theorem_conj">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm7.2" class="ltx_text ltx_font_bold">Conjecture 4.7</span></span><span id="S4.Thmthm7.3" class="ltx_text ltx_font_bold"> </span>(Lu <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib56" title="" class="ltx_ref">56</a>]</cite>)<span id="S4.Thmthm7.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm7.p1" class="ltx_para">
<p id="S4.Thmthm7.p1.1" class="ltx_p"><span id="S4.Thmthm7.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmthm7.p1.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> be an <math id="S4.Thmthm7.p1.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-dimensional closed minimal submanifold in the unit sphere <math id="S4.Thmthm7.p1.m3" class="ltx_Math" alttext="\mathbf{S}^{n+m}" display="inline" intent=":literal"><semantics><msup><mi>𝐒</mi><mrow><mi>n</mi><mo>+</mo><mi>m</mi></mrow></msup><annotation encoding="application/x-tex">\mathbf{S}^{n+m}</annotation></semantics></math>. If <math id="S4.Thmthm7.p1.m4" class="ltx_Math" alttext="S+\lambda_{2}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>+</mo><msub><mi>λ</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">S+\lambda_{2}</annotation></semantics></math> is a constant and if</span></p>
<table id="S4.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex4.m1" class="ltx_Math" alttext="S+\lambda_{2}&gt;n," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>S</mi><mo>+</mo><msub><mi>λ</mi><mn>2</mn></msub></mrow><mo>&gt;</mo><mi>n</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">S+\lambda_{2}&gt;n,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm7.p1.2" class="ltx_p"><span id="S4.Thmthm7.p1.2.1" class="ltx_text ltx_font_italic">then there is a constant <math id="S4.Thmthm7.p1.m5" class="ltx_Math" alttext="\varepsilon(n,m)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ε</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\varepsilon(n,m)&gt;0</annotation></semantics></math> such that</span></p>
<table id="S4.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex5.m1" class="ltx_Math" alttext="S+\lambda_{2}&gt;n+\varepsilon(n,m)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>S</mi><mo>+</mo><msub><mi>λ</mi><mn>2</mn></msub></mrow><mo>&gt;</mo><mrow><mi>n</mi><mo>+</mo><mrow><mi>ε</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">S+\lambda_{2}&gt;n+\varepsilon(n,m).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.SS2.p2" class="ltx_para">
<p id="S4.SS2.p2.1" class="ltx_p">If <math id="S4.SS2.p2.m1" class="ltx_Math" alttext="m=1" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">m=1</annotation></semantics></math>, this conjecture is true (cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib66" title="" class="ltx_ref">66</a>, <a href="#bib.bib29" title="" class="ltx_ref">29</a>, <a href="#bib.bib52" title="" class="ltx_ref">52</a>]</cite>). In fact, this is a special case of Chern’s conjecture (cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib18" title="" class="ltx_ref">18</a>, <a href="#bib.bib19" title="" class="ltx_ref">19</a>]</cite>). For more details, please refer to <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">9</a>, <a href="#bib.bib67" title="" class="ltx_ref">67</a>, <a href="#bib.bib72" title="" class="ltx_ref">72</a>, <a href="#bib.bib69" title="" class="ltx_ref">69</a>]</cite>, etc.</p>
</div>
</section>
<section id="S4.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.3. </span>Lu-Wenzel Conjectures</h3>

<div id="S4.SS3.p1" class="ltx_para">
<p id="S4.SS3.p1.1" class="ltx_p">In order to give a unified generalization of the BW inequality, DDVV inequality and Lu inequality,
Lu and Wenzel (<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib58" title="" class="ltx_ref">58</a>, <a href="#bib.bib59" title="" class="ltx_ref">59</a>]</cite>) proposed several conjectures (also called LW Conjectures) in 2016.
They started with the following Conjectures <a href="#S4.Thmthm8" title="Conjecture 4.8 (Lu-Wenzel []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.8</span></a>, <a href="#S4.Thmthm9" title="Conjecture 4.9 (Fundamental Conjecture of Lu-Wenzel []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.9</span></a>, <a href="#S4.Thmthm11" title="Conjecture 4.11 (Lu-Wenzel []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.11</span></a> and an open Question <a href="#S4.Thmthm12" title="Question 4.12 (Lu-Wenzel []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.12</span></a> in the space <math id="S4.SS3.p1.m1" class="ltx_Math" alttext="M(n,\mathbb{K})" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>𝕂</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M(n,\mathbb{K})</annotation></semantics></math>
of <math id="S4.SS3.p1.m2" class="ltx_Math" alttext="n\times n" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">n\times n</annotation></semantics></math> matrices over the field <math id="S4.SS3.p1.m3" class="ltx_Math" alttext="\mathbb{K}=\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>𝕂</mi><mo>=</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">\mathbb{K}=\mathbb{R}</annotation></semantics></math>.</p>
</div>
<div id="S4.Thmthm8" class="ltx_theorem ltx_theorem_conj">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm8.2" class="ltx_text ltx_font_bold">Conjecture 4.8</span></span><span id="S4.Thmthm8.3" class="ltx_text ltx_font_bold"> </span>(Lu-Wenzel <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib58" title="" class="ltx_ref">58</a>, <a href="#bib.bib59" title="" class="ltx_ref">59</a>]</cite>)<span id="S4.Thmthm8.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm8.p1" class="ltx_para">
<p id="S4.Thmthm8.p1.1" class="ltx_p"><span id="S4.Thmthm8.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmthm8.p1.m1" class="ltx_Math" alttext="B_{1},\cdots,B_{m}\in M(n,\mathbb{K})" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><msub><mi>B</mi><mi>m</mi></msub><mo>∈</mo><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>𝕂</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">B_{1},\cdots,B_{m}\in M(n,\mathbb{K})</annotation></semantics></math> subject to</span></p>
<table id="S4.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex6.m1" class="ltx_Math" alttext="\operatorname{tr}\Big(B_{\alpha}[B_{\gamma},B_{\beta}]\Big)=0" display="block" intent=":literal"><semantics><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msub><mi>B</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>B</mi><mi>γ</mi></msub><mo>,</mo><msub><mi>B</mi><mi>β</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\operatorname{tr}\Big(B_{\alpha}[B_{\gamma},B_{\beta}]\Big)=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm8.p1.2" class="ltx_p"><span id="S4.Thmthm8.p1.2.1" class="ltx_text ltx_font_italic">for any <math id="S4.Thmthm8.p1.m2" class="ltx_Math" alttext="1\leq\alpha,\beta,\gamma\leq m" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>≤</mo><mi>α</mi></mrow><mo>,</mo><mi>β</mi><mo>,</mo><mrow><mi>γ</mi><mo>≤</mo><mi>m</mi></mrow></mrow><annotation encoding="application/x-tex">1\leq\alpha,\beta,\gamma\leq m</annotation></semantics></math>, then</span></p>
<table id="S4.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex7.m1" class="ltx_Math" alttext="\sum^{m}_{\alpha,\beta=1}\|\left[B_{\alpha},B_{\beta}\right]\|^{2}\leq\left(\sum^{m}_{\alpha=1}\|B_{\alpha}\|^{2}\right)^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mrow><mi>α</mi><mo>,</mo><mi>β</mi></mrow><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><msup><mrow><mo lspace="0em" stretchy="false">‖</mo><mrow><mo>[</mo><mrow><msub><mi>B</mi><mi>α</mi></msub><mo>,</mo><msub><mi>B</mi><mi>β</mi></msub></mrow><mo>]</mo></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>≤</mo><msup><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false" rspace="0em">∑</mo><mrow><mi>α</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><msup><mrow><mo stretchy="false">‖</mo><msub><mi>B</mi><mi>α</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum^{m}_{\alpha,\beta=1}\|\left[B_{\alpha},B_{\beta}\right]\|^{2}\leq\left(\sum^{m}_{\alpha=1}\|B_{\alpha}\|^{2}\right)^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.Thmthm9" class="ltx_theorem ltx_theorem_conj">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm9.2" class="ltx_text ltx_font_bold">Conjecture 4.9</span></span><span id="S4.Thmthm9.3" class="ltx_text ltx_font_bold"> </span>(Fundamental Conjecture of Lu-Wenzel <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib58" title="" class="ltx_ref">58</a>, <a href="#bib.bib59" title="" class="ltx_ref">59</a>]</cite>)<span id="S4.Thmthm9.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm9.p1" class="ltx_para">
<p id="S4.Thmthm9.p1.1" class="ltx_p"><span id="S4.Thmthm9.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmthm9.p1.m1" class="ltx_Math" alttext="B,B_{2},\cdots,B_{m}\in M(n,\mathbb{K})" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>,</mo><msub><mi>B</mi><mn>2</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><msub><mi>B</mi><mi>m</mi></msub><mo>∈</mo><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>𝕂</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">B,B_{2},\cdots,B_{m}\in M(n,\mathbb{K})</annotation></semantics></math> be matrices such that</span></p>
<ol id="S4.I1" class="ltx_enumerate">
<li id="S4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="S4.I1.i1.p1" class="ltx_para">
<p id="S4.I1.i1.p1.1" class="ltx_p"><math id="S4.I1.i1.p1.m1" class="ltx_Math" alttext="\operatorname{tr}(B_{\alpha}B^{*}_{\beta})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>B</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mi>β</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\operatorname{tr}(B_{\alpha}B^{*}_{\beta})=0</annotation></semantics></math><span id="S4.I1.i1.p1.1.1" class="ltx_text ltx_font_italic">,
i.e., </span><math id="S4.I1.i1.p1.m2" class="ltx_Math" alttext="B_{\alpha}\bot B_{\beta}" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>α</mi></msub><mo lspace="0.222em" rspace="0.222em">⊥</mo><msub><mi>B</mi><mi>β</mi></msub></mrow><annotation encoding="application/x-tex">B_{\alpha}\bot B_{\beta}</annotation></semantics></math><span id="S4.I1.i1.p1.1.2" class="ltx_text ltx_font_italic"> for any </span><math id="S4.I1.i1.p1.m3" class="ltx_Math" alttext="\alpha\neq\beta" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>≠</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">\alpha\neq\beta</annotation></semantics></math><span id="S4.I1.i1.p1.1.3" class="ltx_text ltx_font_italic">;</span></p>
</div></li>
<li id="S4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="S4.I1.i2.p1" class="ltx_para">
<p id="S4.I1.i2.p1.1" class="ltx_p"><math id="S4.I1.i2.p1.m1" class="ltx_Math" alttext="\operatorname{tr}\Big(B_{\alpha}[B,B_{\beta}]\Big)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msub><mi>B</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>B</mi><mo>,</mo><msub><mi>B</mi><mi>β</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\operatorname{tr}\Big(B_{\alpha}[B,B_{\beta}]\Big)=0</annotation></semantics></math><span id="S4.I1.i2.p1.1.1" class="ltx_text ltx_font_italic"> for any </span><math id="S4.I1.i2.p1.m2" class="ltx_Math" alttext="2\leq\alpha,\beta\leq m" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo>≤</mo><mi>α</mi></mrow><mo>,</mo><mrow><mi>β</mi><mo>≤</mo><mi>m</mi></mrow></mrow><annotation encoding="application/x-tex">2\leq\alpha,\beta\leq m</annotation></semantics></math><span id="S4.I1.i2.p1.1.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
<p id="S4.Thmthm9.p1.2" class="ltx_p"><span id="S4.Thmthm9.p1.2.1" class="ltx_text ltx_font_italic">Then</span></p>
<table id="S4.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex8.m1" class="ltx_Math" alttext="\sum^{m}_{\alpha=2}\|\left[B,B_{\alpha}\right]\|^{2}\leq\left(\max\limits_{2\leq\alpha\leq m}\|B_{\alpha}\|^{2}+\sum^{m}_{\alpha=2}\|B_{\alpha}\|^{2}\right)\|B\|^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>α</mi><mo>=</mo><mn>2</mn></mrow><mi>m</mi></munderover><msup><mrow><mo lspace="0em" stretchy="false">‖</mo><mrow><mo>[</mo><mrow><mi>B</mi><mo>,</mo><msub><mi>B</mi><mi>α</mi></msub></mrow><mo>]</mo></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>≤</mo><mrow><mrow><mo>(</mo><mrow><mrow><munder><mi>max</mi><mrow><mn>2</mn><mo>≤</mo><mi>α</mi><mo>≤</mo><mi>m</mi></mrow></munder><mo>⁡</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>B</mi><mi>α</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo rspace="0.055em">+</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>α</mi><mo>=</mo><mn>2</mn></mrow><mi>m</mi></munderover><msup><mrow><mo stretchy="false">‖</mo><msub><mi>B</mi><mi>α</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>B</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum^{m}_{\alpha=2}\|\left[B,B_{\alpha}\right]\|^{2}\leq\left(\max\limits_{2\leq\alpha\leq m}\|B_{\alpha}\|^{2}+\sum^{m}_{\alpha=2}\|B_{\alpha}\|^{2}\right)\|B\|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.SS3.p2" class="ltx_para">
<p id="S4.SS3.p2.1" class="ltx_p">Note that the Lu inequality is a special case of Conjecture <a href="#S4.Thmthm9" title="Conjecture 4.9 (Fundamental Conjecture of Lu-Wenzel []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.9</span></a>.</p>
</div>
<div id="S4.SS3.p3" class="ltx_para">
<p id="S4.SS3.p3.1" class="ltx_p">Let’s consider the linear operator <math id="S4.SS3.p3.m1" class="ltx_Math" alttext="T_{X}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>X</mi></msub><annotation encoding="application/x-tex">T_{X}</annotation></semantics></math> as in the following conjectures and questions. More specifically, for any <math id="S4.SS3.p3.m2" class="ltx_Math" alttext="n\times n" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">n\times n</annotation></semantics></math> complex matrix <math id="S4.SS3.p3.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> with <math id="S4.SS3.p3.m4" class="ltx_Math" alttext="\|X\|=1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mi>X</mi><mo stretchy="false">‖</mo></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|X\|=1</annotation></semantics></math>, we define</p>
<table id="S4.Ex9" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S4.Ex9X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex9X.m2" class="ltx_Math" alttext="\displaystyle T_{X}:M(n,\mathbb{C})" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>X</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>ℂ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle T_{X}:M(n,\mathbb{C})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex9X.m3" class="ltx_Math" alttext="\displaystyle\longrightarrow M(n,\mathbb{C})," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo stretchy="false">⟶</mo><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>ℂ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\longrightarrow M(n,\mathbb{C}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex9Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex9Xa.m2" class="ltx_Math" alttext="\displaystyle Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">\displaystyle Y</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex9Xa.m3" class="ltx_Math" alttext="\displaystyle\longmapsto[X^{*},[X,Y]]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo stretchy="false">⟼</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>X</mi><mo>∗</mo></msup><mo>,</mo><mrow><mo stretchy="false">[</mo><mrow><mi>X</mi><mo>,</mo><mi>Y</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\longmapsto[X^{*},[X,Y]].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.p3.2" class="ltx_p">It turns out that <math id="S4.SS3.p3.m5" class="ltx_Math" alttext="T_{X}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>X</mi></msub><annotation encoding="application/x-tex">T_{X}</annotation></semantics></math> is exactly an operator on <math id="S4.SS3.p3.m6" class="ltx_Math" alttext="V=M(n,\mathbb{C})" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>=</mo><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>ℂ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">V=M(n,\mathbb{C})</annotation></semantics></math> and <math id="S4.SS3.p3.m7" class="ltx_Math" alttext="\dim_{\mathbb{C}}V=n^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>dim</mo><mi>ℂ</mi></msub><mi>V</mi></mrow><mo>=</mo><msup><mi>n</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\dim_{\mathbb{C}}V=n^{2}</annotation></semantics></math>.</p>
</div>
<div id="S4.Thmthm10" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm10.2" class="ltx_text ltx_font_bold">Proposition 4.10</span></span><span id="S4.Thmthm10.3" class="ltx_text ltx_font_bold"> </span>(<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib34" title="" class="ltx_ref">34</a>]</cite>)<span id="S4.Thmthm10.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm10.p1" class="ltx_para">
<p id="S4.Thmthm10.p1.1" class="ltx_p"><math id="S4.Thmthm10.p1.m1" class="ltx_Math" alttext="T_{X}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>X</mi></msub><annotation encoding="application/x-tex">T_{X}</annotation></semantics></math><span id="S4.Thmthm10.p1.1.1" class="ltx_text ltx_font_italic"> has the following properties:</span></p>
<ol id="S4.I2" class="ltx_enumerate">
<li id="S4.I2.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><math id="S4.I2.ix1.m1" class="ltx_Math" alttext="(a)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a)</annotation></semantics></math></span> 
<div id="S4.I2.ix1.p1" class="ltx_para">
<p id="S4.I2.ix1.p1.1" class="ltx_p"><math id="S4.I2.ix1.p1.m1" class="ltx_Math" alttext="T_{X}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>X</mi></msub><annotation encoding="application/x-tex">T_{X}</annotation></semantics></math><span id="S4.I2.ix1.p1.1.1" class="ltx_text ltx_font_italic"> is a self-dual and positive semi-definite linear map.</span></p>
</div></li>
<li id="S4.I2.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><math id="S4.I2.ix2.m1" class="ltx_Math" alttext="(b)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(b)</annotation></semantics></math></span> 
<div id="S4.I2.ix2.p1" class="ltx_para">
<p id="S4.I2.ix2.p1.1" class="ltx_p"><span id="S4.I2.ix2.p1.1.1" class="ltx_text ltx_font_italic">The set of eigenvalues </span><math id="S4.I2.ix2.p1.m1" class="ltx_math_unparsed" alttext="\lambda(T_{X}):=\{\lambda_{1}(T_{X})\geq\cdots\geq\lambda_{N}(T_{X})\}" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo>:=</mo><mrow><mo stretchy="false">{</mo><msub><mi>λ</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo rspace="0.1389em">≥</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">≥</mo><msub><mi>λ</mi><mi>N</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda(T_{X}):=\{\lambda_{1}(T_{X})\geq\cdots\geq\lambda_{N}(T_{X})\}</annotation></semantics></math><span id="S4.I2.ix2.p1.1.2" class="ltx_text ltx_font_italic"> is invariant under unitary congruences of </span><math id="S4.I2.ix2.p1.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math><span id="S4.I2.ix2.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I2.ix3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><math id="S4.I2.ix3.m1" class="ltx_Math" alttext="(c)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(c)</annotation></semantics></math></span> 
<div id="S4.I2.ix3.p1" class="ltx_para">
<p id="S4.I2.ix3.p1.1" class="ltx_p"><span id="S4.I2.ix3.p1.1.1" class="ltx_text ltx_font_italic">The multiplicity of each positive eigenvalue of </span><math id="S4.I2.ix3.p1.m1" class="ltx_Math" alttext="T_{X}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>X</mi></msub><annotation encoding="application/x-tex">T_{X}</annotation></semantics></math><span id="S4.I2.ix3.p1.1.2" class="ltx_text ltx_font_italic"> is even, i.e., </span><math id="S4.I2.ix3.p1.m2" class="ltx_Math" alttext="\lambda_{2i-1}(T_{X})=\lambda_{2i}(T_{X})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>λ</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>λ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{2i-1}(T_{X})=\lambda_{2i}(T_{X})</annotation></semantics></math><span id="S4.I2.ix3.p1.1.3" class="ltx_text ltx_font_italic"> for any </span><math id="S4.I2.ix3.p1.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math><span id="S4.I2.ix3.p1.1.4" class="ltx_text ltx_font_italic"> with </span><math id="S4.I2.ix3.p1.m4" class="ltx_Math" alttext="\lambda_{2i-1}(T_{X})&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>λ</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{2i-1}(T_{X})&gt;0</annotation></semantics></math><span id="S4.I2.ix3.p1.1.5" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S4.Thmthm11" class="ltx_theorem ltx_theorem_conj">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm11.2" class="ltx_text ltx_font_bold">Conjecture 4.11</span></span><span id="S4.Thmthm11.3" class="ltx_text ltx_font_bold"> </span>(Lu-Wenzel <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib58" title="" class="ltx_ref">58</a>, <a href="#bib.bib59" title="" class="ltx_ref">59</a>]</cite>)<span id="S4.Thmthm11.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm11.p1" class="ltx_para">
<p id="S4.Thmthm11.p1.1" class="ltx_p"><span id="S4.Thmthm11.p1.1.1" class="ltx_text ltx_font_italic">For <math id="S4.Thmthm11.p1.m1" class="ltx_Math" alttext="X\in M(n,\mathbb{K})" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>∈</mo><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>𝕂</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X\in M(n,\mathbb{K})</annotation></semantics></math> with <math id="S4.Thmthm11.p1.m2" class="ltx_Math" alttext="\|X\|=1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mi>X</mi><mo stretchy="false">‖</mo></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|X\|=1</annotation></semantics></math>, then</span></p>
<table id="S4.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex10.m1" class="ltx_Math" alttext="\lambda_{1}(T_{X})+\lambda_{3}(T_{X})\leq 3." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>λ</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mn>3</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lambda_{1}(T_{X})+\lambda_{3}(T_{X})\leq 3.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.Thmthm12" class="ltx_theorem ltx_theorem_ques">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm12.2" class="ltx_text ltx_font_bold">Question 4.12</span></span><span id="S4.Thmthm12.3" class="ltx_text ltx_font_bold"> </span>(Lu-Wenzel <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib58" title="" class="ltx_ref">58</a>, <a href="#bib.bib59" title="" class="ltx_ref">59</a>]</cite>)<span id="S4.Thmthm12.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm12.p1" class="ltx_para">
<p id="S4.Thmthm12.p1.1" class="ltx_p"><span id="S4.Thmthm12.p1.1.1" class="ltx_text ltx_font_italic">What is the upper bound of
<math id="S4.Thmthm12.p1.m1" class="ltx_Math" alttext="\sum\limits_{i=1}^{k}\lambda_{2i-1}(T_{X})?" display="inline" intent=":literal"><semantics><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover><mrow><msub><mi>λ</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">?</mi></mrow></mrow><annotation encoding="application/x-tex">\sum\limits_{i=1}^{k}\lambda_{2i-1}(T_{X})?</annotation></semantics></math></span></p>
</div>
</div>
<div id="S4.Thmthm13" class="ltx_theorem ltx_theorem_rem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm13.2" class="ltx_text ltx_font_bold">Remark 4.13</span></span><span id="S4.Thmthm13.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm13.p1" class="ltx_para">
<p id="S4.Thmthm13.p1.1" class="ltx_p"><span id="S4.Thmthm13.p1.1.1" class="ltx_text ltx_font_italic">In Question <a href="#S4.Thmthm12" title="Question 4.12 (Lu-Wenzel []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.12</span></a>, one has</span></p>
<ol id="S4.I3" class="ltx_enumerate">
<li id="S4.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I3.i1.p1" class="ltx_para">
<p id="S4.I3.i1.p1.1" class="ltx_p"><span id="S4.I3.i1.p1.1.1" class="ltx_text ltx_font_italic">If </span><math id="S4.I3.i1.p1.m1" class="ltx_Math" alttext="k=1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k=1</annotation></semantics></math><span id="S4.I3.i1.p1.1.2" class="ltx_text ltx_font_italic">, the bound is </span><math id="S4.I3.i1.p1.m2" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math><span id="S4.I3.i1.p1.1.3" class="ltx_text ltx_font_italic"> by the BW inequality, i.e., </span><math id="S4.I3.i1.p1.m3" class="ltx_Math" alttext="\lambda_{1}(T_{X})\leq 2" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\lambda_{1}(T_{X})\leq 2</annotation></semantics></math><span id="S4.I3.i1.p1.1.4" class="ltx_text ltx_font_italic">, since</span></p>
<table id="S4.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex11.m1" class="ltx_Math" alttext="\lambda_{1}(T_{X})=\max\limits_{\|Y\|=1}\langle T_{X}Y,Y\rangle=\max\limits_{\|Y\|=1}\|[X,Y]\|^{2}\leq 2." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><munder><mi>max</mi><mrow><mrow><mo stretchy="false">‖</mo><mi>Y</mi><mo stretchy="false">‖</mo></mrow><mo>=</mo><mn>1</mn></mrow></munder><mo>⁡</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>T</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>Y</mi></mrow><mo>,</mo><mi>Y</mi></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo>=</mo><mrow><munder><mi>max</mi><mrow><mrow><mo stretchy="false">‖</mo><mi>Y</mi><mo stretchy="false">‖</mo></mrow><mo>=</mo><mn>1</mn></mrow></munder><mo>⁡</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mo stretchy="false">[</mo><mrow><mi>X</mi><mo>,</mo><mi>Y</mi></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>≤</mo><mn>2</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\lambda_{1}(T_{X})=\max\limits_{\|Y\|=1}\langle T_{X}Y,Y\rangle=\max\limits_{\|Y\|=1}\|[X,Y]\|^{2}\leq 2.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S4.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I3.i2.p1" class="ltx_para">
<p id="S4.I3.i2.p1.1" class="ltx_p"><span id="S4.I3.i2.p1.1.1" class="ltx_text ltx_font_italic">If </span><math id="S4.I3.i2.p1.m1" class="ltx_Math" alttext="k=2" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">k=2</annotation></semantics></math><span id="S4.I3.i2.p1.1.2" class="ltx_text ltx_font_italic">, the bound is supposed to be </span><math id="S4.I3.i2.p1.m2" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math><span id="S4.I3.i2.p1.1.3" class="ltx_text ltx_font_italic"> by Conjecture </span><a href="#S4.Thmthm11" title="Conjecture 4.11 (Lu-Wenzel []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">4.11</span></a><span id="S4.I3.i2.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S4.SS3.p4" class="ltx_para">
<p id="S4.SS3.p4.1" class="ltx_p">How are all these conjectures and the known inequalities connected?
When restricted to real symmetric matrices, Conjecture <a href="#S4.Thmthm8" title="Conjecture 4.8 (Lu-Wenzel []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.8</span></a> reduces to the DDVV inequality. It turns out that not only the BW inequality and the DDVV inequality but also both Conjectures <a href="#S4.Thmthm8" title="Conjecture 4.8 (Lu-Wenzel []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.8</span></a> and <a href="#S4.Thmthm11" title="Conjecture 4.11 (Lu-Wenzel []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.11</span></a> are implied by Conjecture <a href="#S4.Thmthm9" title="Conjecture 4.9 (Fundamental Conjecture of Lu-Wenzel []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.9</span></a> (cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib58" title="" class="ltx_ref">58</a>]</cite>).
Hence, Conjecture <a href="#S4.Thmthm9" title="Conjecture 4.9 (Fundamental Conjecture of Lu-Wenzel []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.9</span></a> (as well as the equivalent Conjectures <a href="#S4.Thmthm14" title="Conjecture 4.14 (Ge-Li-Lu-Zhou []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.14</span></a>–<a href="#S4.Thmthm16" title="Conjecture 4.16 (Ge-Li-Lu-Zhou []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.16</span></a>, see Theorem <a href="#S4.Thmthm17" title="Theorem 4.17 (Ge-Li-Lu-Zhou []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.17</span></a>) takes exactly the role of a unified generalization of the BW inequality and the DDVV inequality for real matrices. We call it the Fundamental Conjecture of Lu and Wenzel, or simply the (real, i.e., <math id="S4.SS3.p4.m1" class="ltx_Math" alttext="\mathbb{K}=\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>𝕂</mi><mo>=</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">\mathbb{K}=\mathbb{R}</annotation></semantics></math>)
LW Conjecture.</p>
</div>
<div id="S4.SS3.p5" class="ltx_para">
<p id="S4.SS3.p5.1" class="ltx_p">Next, we will introduce some equivalent forms of Conjecture <a href="#S4.Thmthm9" title="Conjecture 4.9 (Fundamental Conjecture of Lu-Wenzel []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.9</span></a>.
Since the BW inequality (resp. the DDVV inequality) holds also for complex (resp. complex symmetric) matrices (cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib8" title="" class="ltx_ref">8</a>]</cite>, <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib35" title="" class="ltx_ref">35</a>]</cite>), we can also consider the same conjectures as above in the complex version. Let <math id="S4.SS3.p5.m1" class="ltx_Math" alttext="\mathbb{K}=\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>𝕂</mi><mo>=</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">\mathbb{K}=\mathbb{R}</annotation></semantics></math> or <math id="S4.SS3.p5.m2" class="ltx_Math" alttext="\mathbb{K}=\mathbb{C}" display="inline" intent=":literal"><semantics><mrow><mi>𝕂</mi><mo>=</mo><mi>ℂ</mi></mrow><annotation encoding="application/x-tex">\mathbb{K}=\mathbb{C}</annotation></semantics></math> in the following Conjectures <a href="#S4.Thmthm14" title="Conjecture 4.14 (Ge-Li-Lu-Zhou []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.14</span></a> - <a href="#S4.Thmthm16" title="Conjecture 4.16 (Ge-Li-Lu-Zhou []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.16</span></a>.</p>
</div>
<div id="S4.Thmthm14" class="ltx_theorem ltx_theorem_conj">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm14.2" class="ltx_text ltx_font_bold">Conjecture 4.14</span></span><span id="S4.Thmthm14.3" class="ltx_text ltx_font_bold"> </span>(Ge-Li-Lu-Zhou <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib34" title="" class="ltx_ref">34</a>]</cite>)<span id="S4.Thmthm14.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm14.p1" class="ltx_para">
<p id="S4.Thmthm14.p1.1" class="ltx_p"><span id="S4.Thmthm14.p1.1.1" class="ltx_text ltx_font_italic">For <math id="S4.Thmthm14.p1.m1" class="ltx_Math" alttext="X\in M(n,\mathbb{K})" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>∈</mo><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>𝕂</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X\in M(n,\mathbb{K})</annotation></semantics></math> with <math id="S4.Thmthm14.p1.m2" class="ltx_Math" alttext="\|X\|=1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mi>X</mi><mo stretchy="false">‖</mo></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|X\|=1</annotation></semantics></math>, we have</span></p>
<table id="S4.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex12.m1" class="ltx_math_unparsed" alttext="\sum_{i=1}^{2k}\lambda_{i}(T_{X})\leq 2k+2,\quad k=1,\cdots,\left[\frac{n^{2}}{2}\right]." display="block" intent=":literal"><semantics><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></munderover><msub><mi>λ</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo>≤</mo><mn>2</mn><mi>k</mi><mo>+</mo><mn>2</mn><mo rspace="1.167em">,</mo><mi>k</mi><mo>=</mo><mn>1</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><mo>[</mo><mfrac><msup><mi>n</mi><mn>2</mn></msup><mn>2</mn></mfrac><mo>]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{2k}\lambda_{i}(T_{X})\leq 2k+2,\quad k=1,\cdots,\left[\frac{n^{2}}{2}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.SS3.p6" class="ltx_para">
<p id="S4.SS3.p6.1" class="ltx_p">In fact, the sum <math id="S4.SS3.p6.m1" class="ltx_Math" alttext="\sum_{i=1}^{2k}\lambda_{i}(T_{X})" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msubsup><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{2k}\lambda_{i}(T_{X})</annotation></semantics></math> in Conjecture <a href="#S4.Thmthm14" title="Conjecture 4.14 (Ge-Li-Lu-Zhou []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.14</span></a> cannot exceed <math id="S4.SS3.p6.m2" class="ltx_Math" alttext="2n" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">2n</annotation></semantics></math>. We explain this by introducing the following Conjecture <a href="#S4.Thmthm15" title="Conjecture 4.15 (Ge-Li-Lu-Zhou []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.15</span></a> which looks stronger but in fact is equivalent to Conjecture <a href="#S4.Thmthm14" title="Conjecture 4.14 (Ge-Li-Lu-Zhou []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.14</span></a>.</p>
</div>
<div id="S4.Thmthm15" class="ltx_theorem ltx_theorem_conj">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm15.2" class="ltx_text ltx_font_bold">Conjecture 4.15</span></span><span id="S4.Thmthm15.3" class="ltx_text ltx_font_bold"> </span>(Ge-Li-Lu-Zhou <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib34" title="" class="ltx_ref">34</a>]</cite>)<span id="S4.Thmthm15.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm15.p1" class="ltx_para">
<p id="S4.Thmthm15.p1.1" class="ltx_p"><span id="S4.Thmthm15.p1.1.1" class="ltx_text ltx_font_italic">For <math id="S4.Thmthm15.p1.m1" class="ltx_Math" alttext="X\in M(n,\mathbb{K})" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>∈</mo><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>𝕂</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X\in M(n,\mathbb{K})</annotation></semantics></math> with <math id="S4.Thmthm15.p1.m2" class="ltx_Math" alttext="\|X\|=1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mi>X</mi><mo stretchy="false">‖</mo></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|X\|=1</annotation></semantics></math>,
we have</span></p>
<table id="S4.EGx1" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S4.Ex13.m1" class="ltx_Math" alttext="\displaystyle\begin{split}\sum_{i=1}^{2k}\lambda_{i}(T_{X})\leq\left\{\begin{array}[]{ll}2k+2,&amp;1\leq k\leq n-1;\\
2n,&amp;n\leq k.\\
\end{array}\right.\end{split}" display="inline" intent=":literal"><semantics><mtable><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></munderover></mstyle><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>+</mo><mn>2</mn></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>1</mn><mo>≤</mo><mi>k</mi><mo>≤</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo>;</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>n</mi><mo>≤</mo><mi>k</mi></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}\sum_{i=1}^{2k}\lambda_{i}(T_{X})\leq\left\{\begin{array}[]{ll}2k+2,&amp;1\leq k\leq n-1;\\
2n,&amp;n\leq k.\\
\end{array}\right.\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.SS3.p7" class="ltx_para">
<p id="S4.SS3.p7.1" class="ltx_p">Another equivalent conjecture that also appears to be stronger is the following Conjecture <a href="#S4.Thmthm16" title="Conjecture 4.16 (Ge-Li-Lu-Zhou []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.16</span></a>.
It omits the second assumption of Conjecture <a href="#S4.Thmthm9" title="Conjecture 4.9 (Fundamental Conjecture of Lu-Wenzel []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.9</span></a>, at the price of a factor 2 in the bound.</p>
</div>
<div id="S4.Thmthm16" class="ltx_theorem ltx_theorem_conj">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm16.2" class="ltx_text ltx_font_bold">Conjecture 4.16</span></span><span id="S4.Thmthm16.3" class="ltx_text ltx_font_bold"> </span>(Ge-Li-Lu-Zhou <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib34" title="" class="ltx_ref">34</a>]</cite>)<span id="S4.Thmthm16.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm16.p1" class="ltx_para">
<p id="S4.Thmthm16.p1.1" class="ltx_p"><span id="S4.Thmthm16.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmthm16.p1.m1" class="ltx_Math" alttext="B,B_{2},\cdots,B_{m}\in M(n,\mathbb{K})" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>,</mo><msub><mi>B</mi><mn>2</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><msub><mi>B</mi><mi>m</mi></msub><mo>∈</mo><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>𝕂</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">B,B_{2},\cdots,B_{m}\in M(n,\mathbb{K})</annotation></semantics></math> be matrices
such that <math id="S4.Thmthm16.p1.m2" class="ltx_Math" alttext="\operatorname{tr}(B_{\alpha}B^{*}_{\beta})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>B</mi><mi>α</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mi>β</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\operatorname{tr}(B_{\alpha}B^{*}_{\beta})=0</annotation></semantics></math> for any <math id="S4.Thmthm16.p1.m3" class="ltx_Math" alttext="2\leq\alpha\neq\beta\leq m" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo>≤</mo><mi>α</mi><mo>≠</mo><mi>β</mi><mo>≤</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">2\leq\alpha\neq\beta\leq m</annotation></semantics></math>. Then</span></p>
<table id="S4.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex14.m1" class="ltx_Math" alttext="\sum^{m}_{\alpha=2}\|\left[B,B_{\alpha}\right]\|^{2}\leq\left(2\max_{2\leq\alpha\leq m}\|B_{\alpha}\|^{2}+\sum^{m}_{\alpha=2}\|B_{\alpha}\|^{2}\right)\|B\|^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>α</mi><mo>=</mo><mn>2</mn></mrow><mi>m</mi></munderover><msup><mrow><mo lspace="0em" stretchy="false">‖</mo><mrow><mo>[</mo><mrow><mi>B</mi><mo>,</mo><msub><mi>B</mi><mi>α</mi></msub></mrow><mo>]</mo></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>≤</mo><mrow><mrow><mo>(</mo><mrow><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><munder><mi>max</mi><mrow><mn>2</mn><mo>≤</mo><mi>α</mi><mo>≤</mo><mi>m</mi></mrow></munder><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><msub><mi>B</mi><mi>α</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo rspace="0.055em">+</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>α</mi><mo>=</mo><mn>2</mn></mrow><mi>m</mi></munderover><msup><mrow><mo stretchy="false">‖</mo><msub><mi>B</mi><mi>α</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>B</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum^{m}_{\alpha=2}\|\left[B,B_{\alpha}\right]\|^{2}\leq\left(2\max_{2\leq\alpha\leq m}\|B_{\alpha}\|^{2}+\sum^{m}_{\alpha=2}\|B_{\alpha}\|^{2}\right)\|B\|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.SS3.p8" class="ltx_para">
<p id="S4.SS3.p8.1" class="ltx_p">We summarize the relations of these conjectures in the following theorem.</p>
</div>
<div id="S4.Thmthm17" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm17.2" class="ltx_text ltx_font_bold">Theorem 4.17</span></span><span id="S4.Thmthm17.3" class="ltx_text ltx_font_bold"> </span>(Ge-Li-Lu-Zhou <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib34" title="" class="ltx_ref">34</a>]</cite>)<span id="S4.Thmthm17.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm17.p1" class="ltx_para">
<p id="S4.Thmthm17.p1.1" class="ltx_p"><span id="S4.Thmthm17.p1.1.1" class="ltx_text ltx_font_italic">If <math id="S4.Thmthm17.p1.m1" class="ltx_Math" alttext="\mathbb{K}=\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>𝕂</mi><mo>=</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">\mathbb{K}=\mathbb{R}</annotation></semantics></math> or <math id="S4.Thmthm17.p1.m2" class="ltx_Math" alttext="\mathbb{K}=\mathbb{C}" display="inline" intent=":literal"><semantics><mrow><mi>𝕂</mi><mo>=</mo><mi>ℂ</mi></mrow><annotation encoding="application/x-tex">\mathbb{K}=\mathbb{C}</annotation></semantics></math>, then
the following relations hold in these conjectures.</span></p>
<ol id="S4.I4" class="ltx_enumerate">
<li id="S4.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"> (i) </span> 
<div id="S4.I4.i1.p1" class="ltx_para">
<p id="S4.I4.i1.p1.1" class="ltx_p"><span id="S4.I4.i1.p1.1.1" class="ltx_text ltx_font_italic">Conjectures </span><a href="#S4.Thmthm9" title="Conjecture 4.9 (Fundamental Conjecture of Lu-Wenzel []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">4.9</span></a><span id="S4.I4.i1.p1.1.2" class="ltx_text ltx_font_italic">, </span><a href="#S4.Thmthm14" title="Conjecture 4.14 (Ge-Li-Lu-Zhou []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">4.14</span></a><span id="S4.I4.i1.p1.1.3" class="ltx_text ltx_font_italic">, </span><a href="#S4.Thmthm15" title="Conjecture 4.15 (Ge-Li-Lu-Zhou []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">4.15</span></a><span id="S4.I4.i1.p1.1.4" class="ltx_text ltx_font_italic">, and </span><a href="#S4.Thmthm16" title="Conjecture 4.16 (Ge-Li-Lu-Zhou []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">4.16</span></a><span id="S4.I4.i1.p1.1.5" class="ltx_text ltx_font_italic"> are equivalent to each other.</span></p>
</div></li>
<li id="S4.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"> (ii) </span> 
<div id="S4.I4.i2.p1" class="ltx_para">
<p id="S4.I4.i2.p1.1" class="ltx_p"><span id="S4.I4.i2.p1.1.1" class="ltx_text ltx_font_italic">If one of the conjectures above is true, then Conjectures </span><a href="#S4.Thmthm8" title="Conjecture 4.8 (Lu-Wenzel []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">4.8</span></a><span id="S4.I4.i2.p1.1.2" class="ltx_text ltx_font_italic"> and </span><a href="#S4.Thmthm11" title="Conjecture 4.11 (Lu-Wenzel []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">4.11</span></a><span id="S4.I4.i2.p1.1.3" class="ltx_text ltx_font_italic"> hold.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S4.SS3.p9" class="ltx_para">
<p id="S4.SS3.p9.1" class="ltx_p">Hence, we call Conjecture <a href="#S4.Thmthm9" title="Conjecture 4.9 (Fundamental Conjecture of Lu-Wenzel []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.9</span></a> for complex matrices (i.e., <math id="S4.SS3.p9.m1" class="ltx_Math" alttext="\mathbb{K}=\mathbb{C}" display="inline" intent=":literal"><semantics><mrow><mi>𝕂</mi><mo>=</mo><mi>ℂ</mi></mrow><annotation encoding="application/x-tex">\mathbb{K}=\mathbb{C}</annotation></semantics></math>) the complex LW Conjecture. Obviously, the complex LW conjecture implies the real LW conjecture.
Ge-Li-Lu-Zhou <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib34" title="" class="ltx_ref">34</a>]</cite> proved the complex LW Conjecture in some special cases which we conclude in the following.</p>
</div>
<div id="S4.Thmthm18" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm18.2" class="ltx_text ltx_font_bold">Theorem 4.18</span></span><span id="S4.Thmthm18.3" class="ltx_text ltx_font_bold"> </span>(Ge-Li-Lu-Zhou <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib34" title="" class="ltx_ref">34</a>]</cite>)<span id="S4.Thmthm18.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm18.p1" class="ltx_para">
<p id="S4.Thmthm18.p1.1" class="ltx_p"><span id="S4.Thmthm18.p1.1.1" class="ltx_text ltx_font_italic">The complex LW Conjectures <a href="#S4.Thmthm14" title="Conjecture 4.14 (Ge-Li-Lu-Zhou []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.14</span></a> and <a href="#S4.Thmthm15" title="Conjecture 4.15 (Ge-Li-Lu-Zhou []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.15</span></a>
(and because of Theorem <a href="#S4.Thmthm17" title="Theorem 4.17 (Ge-Li-Lu-Zhou []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.17</span></a> all conjectures of this section)
are true in one of the following cases:</span></p>
<ol id="S4.I5" class="ltx_enumerate">
<li id="S4.I5.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"> (i) </span> 
<div id="S4.I5.i1.p1" class="ltx_para">
<p id="S4.I5.i1.p1.1" class="ltx_p"><math id="S4.I5.i1.p1.m1" class="ltx_Math" alttext="X\in M(n,\mathbb{C})" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>∈</mo><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>ℂ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X\in M(n,\mathbb{C})</annotation></semantics></math><span id="S4.I5.i1.p1.1.1" class="ltx_text ltx_font_italic"> is a normal matrix;</span></p>
</div></li>
<li id="S4.I5.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"> (ii) </span> 
<div id="S4.I5.i2.p1" class="ltx_para">
<p id="S4.I5.i2.p1.1" class="ltx_p"><math id="S4.I5.i2.p1.m1" class="ltx_Math" alttext="\rank X=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>rank</mi><mo lspace="0.167em">⁡</mo><mi>X</mi></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\rank X=1</annotation></semantics></math><span id="S4.I5.i2.p1.1.1" class="ltx_text ltx_font_italic">;</span></p>
</div></li>
<li id="S4.I5.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"> (iii) </span> 
<div id="S4.I5.i3.p1" class="ltx_para">
<p id="S4.I5.i3.p1.1" class="ltx_p"><math id="S4.I5.i3.p1.m1" class="ltx_Math" alttext="n=2" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">n=2</annotation></semantics></math><span id="S4.I5.i3.p1.1.1" class="ltx_text ltx_font_italic"> or </span><math id="S4.I5.i3.p1.m2" class="ltx_Math" alttext="n=3" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">n=3</annotation></semantics></math><span id="S4.I5.i3.p1.1.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S4.SS3.p10" class="ltx_para">
<p id="S4.SS3.p10.1" class="ltx_p">For the Conjectures <a href="#S4.Thmthm14" title="Conjecture 4.14 (Ge-Li-Lu-Zhou []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.14</span></a> and <a href="#S4.Thmthm15" title="Conjecture 4.15 (Ge-Li-Lu-Zhou []). ‣ 4.3. Lu-Wenzel Conjectures ‣ 4. Open questions ‣ A survey on the DDVV-type inequalities" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.15</span></a>
in general Ge-Li-Lu-Zhou <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib34" title="" class="ltx_ref">34</a>]</cite> were able to get some weakened results as follows.</p>
</div>
<div id="S4.Thmthm19" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm19.2" class="ltx_text ltx_font_bold">Theorem 4.19</span></span><span id="S4.Thmthm19.3" class="ltx_text ltx_font_bold"> </span>(Ge-Li-Lu-Zhou <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib34" title="" class="ltx_ref">34</a>]</cite>)<span id="S4.Thmthm19.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm19.p1" class="ltx_para">
<p id="S4.Thmthm19.p1.1" class="ltx_p"><span id="S4.Thmthm19.p1.1.1" class="ltx_text ltx_font_italic">For <math id="S4.Thmthm19.p1.m1" class="ltx_Math" alttext="X\in M(n,\mathbb{C})" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>∈</mo><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>ℂ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X\in M(n,\mathbb{C})</annotation></semantics></math> with <math id="S4.Thmthm19.p1.m2" class="ltx_Math" alttext="\|X\|=1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mi>X</mi><mo stretchy="false">‖</mo></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|X\|=1</annotation></semantics></math>, we have</span></p>
<ol id="S4.I6" class="ltx_enumerate">
<li id="S4.I6.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"> (i) </span> 
<div id="S4.I6.i1.p1" class="ltx_para">
<p id="S4.I6.i1.p1.1" class="ltx_p"><math id="S4.I6.i1.p1.m1" class="ltx_Math" alttext="\lambda_{1}(T_{X})+\lambda_{3}(T_{X})\leq\frac{4+\sqrt{10}}{2}\approx 3.58;" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>λ</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mfrac><mrow><mn>4</mn><mo>+</mo><msqrt><mn>10</mn></msqrt></mrow><mn>2</mn></mfrac><mo>≈</mo><mn>3.58</mn></mrow><mo>;</mo></mrow><annotation encoding="application/x-tex">\lambda_{1}(T_{X})+\lambda_{3}(T_{X})\leq\frac{4+\sqrt{10}}{2}\approx 3.58;</annotation></semantics></math></p>
</div></li>
<li id="S4.I6.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"> (ii) </span> 
<div id="S4.I6.i2.p1" class="ltx_para">
<p id="S4.I6.i2.p1.1" class="ltx_p"><math id="S4.I6.i2.p1.m1" class="ltx_math_unparsed" alttext="\sum_{t=1}^{2k}\lambda_{i}(T_{X})\leq 2k+1+2\sqrt{k},\quad k=1,\cdots,\left[\frac{n^{2}}{2}\right]." display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msubsup><msub><mi>λ</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>X</mi></msub><mo stretchy="false">)</mo></mrow><mo>≤</mo><mn>2</mn><mi>k</mi><mo>+</mo><mn>1</mn><mo>+</mo><mn>2</mn><msqrt><mi>k</mi></msqrt><mo rspace="1.167em">,</mo><mi>k</mi><mo>=</mo><mn>1</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><mo>[</mo><mfrac><msup><mi>n</mi><mn>2</mn></msup><mn>2</mn></mfrac><mo>]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{t=1}^{2k}\lambda_{i}(T_{X})\leq 2k+1+2\sqrt{k},\quad k=1,\cdots,\left[\frac{n^{2}}{2}\right].</annotation></semantics></math></p>
</div></li>
</ol>
</div>
</div>
