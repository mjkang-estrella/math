<br class="ltx_break">sets are <math id="S3.F4.sf2.m5" class="ltx_Math" alttext="\{I,H,G\}" display="inline" intent=":literal"><semantics><mrow><mo maxsize="1.110em" minsize="1.110em">{</mo><mi>I</mi><mo>,</mo><mi>H</mi><mo>,</mo><mi>G</mi><mo maxsize="1.110em" minsize="1.110em">}</mo></mrow><annotation encoding="application/x-tex">\{I,H,G\}</annotation></semantics></math> and <math id="S3.F4.sf2.m6" class="ltx_Math" alttext="\{I,H,G,E,C,A\}" display="inline" intent=":literal"><semantics><mrow><mo maxsize="1.110em" minsize="1.110em">{</mo><mrow><mi>I</mi><mo>,</mo><mi>H</mi><mo>,</mo><mi>G</mi><mo>,</mo><mi>E</mi><mo>,</mo><mi>C</mi><mo>,</mo><mi>A</mi></mrow><mo maxsize="1.110em" minsize="1.110em">}</mo></mrow><annotation encoding="application/x-tex">\{I,H,G,E,C,A\}</annotation></semantics></math>.</span></figcaption>
