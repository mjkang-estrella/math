<p id="S3.Thmtheorem33.p1.3" class="ltx_p"><span id="S3.Thmtheorem33.p1.3.1" class="ltx_text ltx_font_italic">are two disjoint source sets of <math id="S3.Thmtheorem33.p1.m3" class="ltx_Math" alttext="FA(L[C])" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>C</mi><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">FA(L[C])</annotation></semantics></math>.</span></p>
