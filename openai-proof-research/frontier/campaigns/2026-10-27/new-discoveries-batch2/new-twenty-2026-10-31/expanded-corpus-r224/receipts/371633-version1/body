<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E2.m1" class="ltx_Math" alttext="\displaystyle(a,\epsilon)\vee(b,\alpha)\neq(a,\epsilon)\vee(c,\alpha^{\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow><mo>∨</mo><mrow><mo stretchy="false">(</mo><mi>b</mi><mo>,</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mrow><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow><mo>∨</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><msup><mi>α</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle(a,\epsilon)\vee(b,\alpha)\neq(a,\epsilon)\vee(c,\alpha^{\prime})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E2.m2" class="ltx_math_unparsed" alttext="\displaystyle\iff(a\vee c\in I_{L}(C),\,\epsilon=0,\,\alpha=0\,\,\text{and}\,\,\alpha^{\prime}=1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⇔</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>∨</mo><mi>c</mi><mo>∈</mo><msub><mi>I</mi><mi>L</mi></msub><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.337em">,</mo><mi>ϵ</mi><mo>=</mo><mn>0</mn><mo rspace="0.337em">,</mo><mi>α</mi><mo>=</mo><mn>0</mn><mtext>and</mtext><msup><mi>α</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\iff(a\vee c\in I_{L}(C),\,\epsilon=0,\,\alpha=0\,\,\text{and}\,\,\alpha^{\prime}=1)</annotation></semantics></math></td>
