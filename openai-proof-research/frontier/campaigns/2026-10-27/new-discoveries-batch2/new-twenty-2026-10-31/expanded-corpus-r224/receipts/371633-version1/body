)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:0.5em;--ltx-fo-height:0.44em;--ltx-fo-depth:0em;font-size:10pt;" color="#000000" height="6.15" overflow="visible" transform="matrix(1 0 0 -1 0 6.15)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F1.sf2.pic1.m4" class="ltx_Math" alttext="\bullet" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">∙</mo><annotation encoding="application/x-tex">\bullet</annotation></semantics></math></span></span></foreignObject></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S3.F1.sf2.3" class="ltx_text" style="font-size:90%;">(b)</span> </span><span id="S3.F1.sf2.4" class="ltx_text" style="font-size:90%;">The elements of the blue maximal chain <math id="S3.F1.sf2.m3" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> are all comparable to at least one element in <math id="S3.F1.sf2.m4" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>.</span></figcaption>
