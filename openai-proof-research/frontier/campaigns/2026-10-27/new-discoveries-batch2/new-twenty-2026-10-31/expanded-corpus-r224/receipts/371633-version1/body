(x\vee y,1)&amp;\text{otherwise,}\end{array}\right." display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>∨</mo><mi>y</mi></mrow><mo>,</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><msup><mi>ϵ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mrow><mrow><mtext>if</mtext><mo lspace="0.340em" rspace="0em">​</mo><mi>x</mi></mrow><mo>∨</mo><mi>y</mi></mrow><mo>∈</mo><mrow><msub><mi>I</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>∨</mo><mi>y</mi></mrow><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mtd><mtd><mtext>otherwise,</mtext></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left\{\begin{array}[]{cc}(x\vee y,\mathrm{max}(\epsilon,\epsilon^{\prime}))&amp;\text{if}\,\,x\vee y\in I_{L}(C)\\
(x\vee y,1)&amp;\text{otherwise,}\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.EGx1.2"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.EGx1.m3" class="ltx_Math" alttext="\displaystyle(x,\epsilon)\wedge(y,\epsilon^{\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow><mo>∧</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msup><mi>ϵ</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle(x,\epsilon)\wedge(y,\epsilon^{\prime})</annotation></semantics></math></td>
