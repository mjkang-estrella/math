<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E20.m2" class="ltx_Math" alttext="\displaystyle 12kd+12&gt;12K." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mn>12</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>+</mo><mn>12</mn></mrow><mo>&gt;</mo><mrow><mn>12</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle 12kd+12&gt;12K.</annotation></semantics></math></td>
