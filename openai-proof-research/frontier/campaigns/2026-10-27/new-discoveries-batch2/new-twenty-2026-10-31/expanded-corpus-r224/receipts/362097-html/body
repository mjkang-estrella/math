<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex13.m2" class="ltx_Math" alttext="\displaystyle\left(\frac{e^{\delta_{s}}}{(1+\delta_{s})^{1+\delta_{s}}}\right)^{\mu_{s}}=\frac{e^{s_{2}d}}{\left(\frac{s}{s_{1}}\right)^{sd}}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><msub><mi>δ</mi><mi>s</mi></msub></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>s</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>+</mo><msub><mi>δ</mi><mi>s</mi></msub></mrow></msup></mfrac></mstyle><mo>)</mo></mrow><msub><mi>μ</mi><mi>s</mi></msub></msup><mo>=</mo><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><msub><mi>s</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msup><msup><mrow><mo>(</mo><mfrac><mi>s</mi><msub><mi>s</mi><mn>1</mn></msub></mfrac><mo>)</mo></mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msup></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\left(\frac{e^{\delta_{s}}}{(1+\delta_{s})^{1+\delta_{s}}}\right)^{\mu_{s}}=\frac{e^{s_{2}d}}{\left(\frac{s}{s_{1}}\right)^{sd}}</annotation></semantics></math></td>
