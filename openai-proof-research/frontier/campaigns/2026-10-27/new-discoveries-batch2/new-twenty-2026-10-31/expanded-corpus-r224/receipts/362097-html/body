<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex24.m1" class="ltx_Math" alttext="\mathbb{E}\left(Z_{i}~|~A\right)=\mathbb{P}\left(Z_{i}=1~|~A\right)=1-\mathbb{P}\left(Z_{i}=0~|~A\right)\leq\frac{2}{k^{2}d}-\frac{1}{k^{4}d^{2}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>Z</mi><mi>i</mi></msub><mo lspace="0em" rspace="0.330em">|</mo><mi>A</mi><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>Z</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo lspace="0.330em" rspace="0.330em">|</mo><mi>A</mi><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>Z</mi><mi>i</mi></msub><mo>=</mo><mn>0</mn></mrow><mo lspace="0.330em" rspace="0.330em">|</mo><mi>A</mi><mo>)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mfrac><mn>2</mn><mrow><msup><mi>k</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac><mo>−</mo><mfrac><mn>1</mn><mrow><msup><mi>k</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mn>2</mn></msup></mrow></mfrac></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left(Z_{i}~|~A\right)=\mathbb{P}\left(Z_{i}=1~|~A\right)=1-\mathbb{P}\left(Z_{i}=0~|~A\right)\leq\frac{2}{k^{2}d}-\frac{1}{k^{4}d^{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
