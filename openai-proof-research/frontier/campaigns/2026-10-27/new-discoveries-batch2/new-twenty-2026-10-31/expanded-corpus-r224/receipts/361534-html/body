<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex35.m1" class="ltx_Math" alttext="Z^{-}_{G,v}(\beta,\boldsymbol{\lambda})=\beta^{|N(v)|}Z_{G\backslash\{v\}}(\beta,\boldsymbol{\lambda}^{v^{-}})" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>,</mo><mi>v</mi></mrow><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo>,</mo><mi>𝝀</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>β</mi><mrow><mo stretchy="false">|</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>Z</mi><mrow><mi>G</mi><mo lspace="0.222em" rspace="0.222em">\</mo><mrow><mo stretchy="false">{</mo><mi>v</mi><mo stretchy="false">}</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo>,</mo><msup><mi>𝝀</mi><msup><mi>v</mi><mo>−</mo></msup></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Z^{-}_{G,v}(\beta,\boldsymbol{\lambda})=\beta^{|N(v)|}Z_{G\backslash\{v\}}(\beta,\boldsymbol{\lambda}^{v^{-}})</annotation></semantics></math></td>
