<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex37.m1" class="ltx_Math" alttext="|\lambda_{w}^{\sigma_{\Lambda}}|=\beta^{n_{+}(w)-n_{-}(w)}|\lambda_{w}|\in[\beta^{-d}|\lambda_{w}|,\beta^{d}|\lambda_{w}|]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><msubsup><mi>λ</mi><mi>w</mi><msub><mi>σ</mi><mi mathvariant="normal">Λ</mi></msub></msubsup><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><msup><mi>β</mi><mrow><mrow><msub><mi>n</mi><mo>+</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>n</mi><mo>−</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>λ</mi><mi>w</mi></msub><mo stretchy="false">|</mo></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msup><mi>β</mi><mrow><mo>−</mo><mi>d</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>λ</mi><mi>w</mi></msub><mo stretchy="false">|</mo></mrow></mrow><mo>,</mo><mrow><msup><mi>β</mi><mi>d</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>λ</mi><mi>w</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|\lambda_{w}^{\sigma_{\Lambda}}|=\beta^{n_{+}(w)-n_{-}(w)}|\lambda_{w}|\in[\beta^{-d}|\lambda_{w}|,\beta^{d}|\lambda_{w}|].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p11.3" class="ltx_p"><span id="S5.p11.3.1" class="ltx_text">Clearly, <math id="S5.p11.m34" class="ltx_Math" alttext="|\lambda_{w}^{\sigma_{\Lambda}}|&gt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msubsup><mi>λ</mi><mi>w</mi><msub><mi>σ</mi><mi mathvariant="normal">Λ</mi></msub></msubsup><mo stretchy="false">|</mo></mrow><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">|\lambda_{w}^{\sigma_{\Lambda}}|&gt;1</annotation></semantics></math> if <math id="S5.p11.m35" class="ltx_Math" alttext="|\lambda_{w}|&gt;\beta^{d}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi>λ</mi><mi>w</mi></msub><mo stretchy="false">|</mo></mrow><mo>&gt;</mo><msup><mi>β</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">|\lambda_{w}|&gt;\beta^{d}</annotation></semantics></math> and <math id="S5.p11.m36" class="ltx_Math" alttext="|\lambda_{w}^{\sigma_{\Lambda}}|&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msubsup><mi>λ</mi><mi>w</mi><msub><mi>σ</mi><mi mathvariant="normal">Λ</mi></msub></msubsup><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">|\lambda_{w}^{\sigma_{\Lambda}}|&lt;1</annotation></semantics></math> if <math id="S5.p11.m37" class="ltx_Math" alttext="|\lambda_{w}|&lt;\beta^{-d}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi>λ</mi><mi>w</mi></msub><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><msup><mi>β</mi><mrow><mo>−</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">|\lambda_{w}|&lt;\beta^{-d}</annotation></semantics></math>.
If for all <math id="S5.p11.m38" class="ltx_Math" alttext="v\in V" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">v\in V</annotation></semantics></math>, <math id="S5.p11.m39" class="ltx_Math" alttext="|\lambda_{v}|&gt;\beta^{d}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi>λ</mi><mi>v</mi></msub><mo stretchy="false">|</mo></mrow><mo>&gt;</mo><msup><mi>β</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">|\lambda_{v}|&gt;\beta^{d}</annotation></semantics></math> or <math id="S5.p11.m40" class="ltx_Math" alttext="0&lt;|\lambda_{v}|&lt;1/\beta^{d}" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mrow><mo stretchy="false">|</mo><msub><mi>λ</mi><mi>v</mi></msub><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><mrow><mn>1</mn><mo>/</mo><msup><mi>β</mi><mi>d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">0&lt;|\lambda_{v}|&lt;1/\beta^{d}</annotation></semantics></math>, then <math id="S5.p11.m41" class="ltx_Math" alttext="Z_{G\backslash\Lambda}(\beta,\boldsymbol{\lambda}^{\sigma_{\Lambda}})\neq 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>Z</mi><mrow><mi>G</mi><mo lspace="0.222em" rspace="0.222em">\</mo><mi mathvariant="normal">Λ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo>,</mo><msup><mi>𝝀</mi><msub><mi>σ</mi><mi mathvariant="normal">Λ</mi></msub></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">Z_{G\backslash\Lambda}(\beta,\boldsymbol{\lambda}^{\sigma_{\Lambda}})\neq 0</annotation></semantics></math> by Theorem <a href="#Thmtheorem36" title="Theorem 36 (Lee-Yang circle theorem). ‣ 5 The implication for non-uniform external fields ‣ Strong Spatial Mixing for General 2-Spin Systems:A Unified Approach from Zero-Freeness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">36</span></a>.
Thus, <math id="S5.p11.m42" class="ltx_Math" alttext="Z_{G}^{\sigma_{\Lambda}}(\beta,\boldsymbol{\lambda})\neq 0" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>Z</mi><mi>G</mi><msub><mi>σ</mi><mi mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo>,</mo><mi>𝝀</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">Z_{G}^{\sigma_{\Lambda}}(\beta,\boldsymbol{\lambda})\neq 0</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S5.p12" class="ltx_para">
<p id="S5.p12.1" class="ltx_p">Combining Theorem <a href="#Thmtheorem35" title="Theorem 35. ‣ 5 The implication for non-uniform external fields ‣ Strong Spatial Mixing for General 2-Spin Systems:A Unified Approach from Zero-Freeness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">35</span></a> and Corollary <a href="#Thmtheorem37" title="Corollary 37. ‣ 5 The implication for non-uniform external fields ‣ Strong Spatial Mixing for General 2-Spin Systems:A Unified Approach from Zero-Freeness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">37</span></a>, we get a new SSM result for the ferromagnetic Ising model with non-uniform external fields.</p>
</div>
<div id="Thmtheorem38" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem38.2" class="ltx_text ltx_font_bold">Corollary 38</span></span><span id="Thmtheorem38.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem38.p1" class="ltx_para">
<p id="Thmtheorem38.p1.1" class="ltx_p"><span id="Thmtheorem38.p1.1.1" class="ltx_text ltx_font_italic">Fix <math id="Thmtheorem38.p1.m1" class="ltx_Math" alttext="\beta&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\beta&gt;1</annotation></semantics></math> and integer <math id="Thmtheorem38.p1.m2" class="ltx_Math" alttext="d\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">d\geq 2</annotation></semantics></math>.
The ferromagnetic Ising model on graphs <math id="Thmtheorem38.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> of degree at most <math id="Thmtheorem38.p1.m4" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> specified by <math id="Thmtheorem38.p1.m5" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> and non-uniform positive external fields <math id="Thmtheorem38.p1.m6" class="ltx_Math" alttext="\boldsymbol{\lambda}" display="inline" intent=":literal"><semantics><mi>𝛌</mi><annotation encoding="application/x-tex">\boldsymbol{\lambda}</annotation></semantics></math> with the same argument <math id="Thmtheorem38.p1.m7" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> exhibits SSM if <math id="Thmtheorem38.p1.m8" class="ltx_Math" alttext="\inf_{v\in V(G)}|\lambda_{v}|&gt;\beta^{d}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>inf</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mrow><mo lspace="0em" stretchy="false">|</mo><msub><mi>λ</mi><mi>v</mi></msub><mo stretchy="false">|</mo></mrow></mrow><mo>&gt;</mo><msup><mi>β</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\inf_{v\in V(G)}|\lambda_{v}|&gt;\beta^{d}</annotation></semantics></math> or <math id="Thmtheorem38.p1.m9" class="ltx_Math" alttext="\sup_{v\in V(G)}|\lambda_{v}|&lt;1/\beta^{d}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>sup</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mrow><mo lspace="0em" stretchy="false">|</mo><msub><mi>λ</mi><mi>v</mi></msub><mo stretchy="false">|</mo></mrow></mrow><mo>&lt;</mo><mrow><mn>1</mn><mo>/</mo><msup><mi>β</mi><mi>d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\sup_{v\in V(G)}|\lambda_{v}|&lt;1/\beta^{d}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S5.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.p13" class="ltx_para">
<p id="S5.p13.1" class="ltx_p"><span id="S5.p13.1.1" class="ltx_text">We first consider the case <math id="S5.p13.m1" class="ltx_Math" alttext="\sup_{v\in V(G)}\lambda_{v}&lt;1/\beta^{d}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>sup</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><msub><mi>λ</mi><mi>v</mi></msub></mrow><mo>&lt;</mo><mrow><mn>1</mn><mo>/</mo><msup><mi>β</mi><mi>d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\sup_{v\in V(G)}\lambda_{v}&lt;1/\beta^{d}</annotation></semantics></math>.
In this case, zero-freeness is guaranteed by Corollary <a href="#Thmtheorem37" title="Corollary 37. ‣ 5 The implication for non-uniform external fields ‣ Strong Spatial Mixing for General 2-Spin Systems:A Unified Approach from Zero-Freeness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">37</span></a>, and then SSM follows by Theorem <a href="#Thmtheorem35" title="Theorem 35. ‣ 5 The implication for non-uniform external fields ‣ Strong Spatial Mixing for General 2-Spin Systems:A Unified Approach from Zero-Freeness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">35</span></a>.</span></p>
</div>
<div id="S5.p14" class="ltx_para">
<p id="S5.p14.1" class="ltx_p"><span id="S5.p14.1.1" class="ltx_text">For the case that <math id="S5.p14.m1" class="ltx_Math" alttext="\inf_{v\in V(G)}\lambda_{v}&gt;\beta^{d}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>inf</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><msub><mi>λ</mi><mi>v</mi></msub></mrow><mo>&gt;</mo><msup><mi>β</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\inf_{v\in V(G)}\lambda_{v}&gt;\beta^{d}</annotation></semantics></math>, notice that by switching the meanings of <math id="S5.p14.m2" class="ltx_Math" alttext="+" display="inline" intent=":literal"><semantics><mo>+</mo><annotation encoding="application/x-tex">+</annotation></semantics></math> and <math id="S5.p14.m3" class="ltx_Math" alttext="-" display="inline" intent=":literal"><semantics><mo>−</mo><annotation encoding="application/x-tex">-</annotation></semantics></math> spins,
the <em id="S5.p14.1.1.1" class="ltx_emph ltx_font_italic">spin reversal symmetry</em> holds:
For any graph <math id="S5.p14.m4" class="ltx_Math" alttext="G=(V,E)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G=(V,E)</annotation></semantics></math> and
any partial configuration <math id="S5.p14.m5" class="ltx_Math" alttext="\sigma_{\Lambda}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi mathvariant="normal">Λ</mi></msub><annotation encoding="application/x-tex">\sigma_{\Lambda}</annotation></semantics></math>,</span></p>
<table id="S5.Ex38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex38.m1" class="ltx_Math" alttext="Z_{G}^{\sigma_{\Lambda}}(\beta,\gamma,\boldsymbol{\lambda})=Z_{G}^{\overline{\sigma}_{\Lambda}}(\gamma,\beta,\boldsymbol{\lambda}^{-1})\prod_{v\in V}\lambda_{v}" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>Z</mi><mi>G</mi><msub><mi>σ</mi><mi mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo>,</mo><mi>γ</mi><mo>,</mo><mi>𝝀</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>Z</mi><mi>G</mi><msub><mover accent="true"><mi>σ</mi><mo stretchy="true">¯</mo></mover><mi mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo>,</mo><mi>β</mi><mo>,</mo><msup><mi>𝝀</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∏</mo><mrow><mi>v</mi><mo>∈</mo><mi>V</mi></mrow></munder><msub><mi>λ</mi><mi>v</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">Z_{G}^{\sigma_{\Lambda}}(\beta,\gamma,\boldsymbol{\lambda})=Z_{G}^{\overline{\sigma}_{\Lambda}}(\gamma,\beta,\boldsymbol{\lambda}^{-1})\prod_{v\in V}\lambda_{v}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p14.2" class="ltx_p"><span id="S5.p14.2.1" class="ltx_text">where <math id="S5.p14.m6" class="ltx_Math" alttext="\boldsymbol{\lambda}^{-1}=(\lambda_{v}^{-1})_{v\in V}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝝀</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msubsup><mi>λ</mi><mi>v</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>v</mi><mo>∈</mo><mi>V</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\boldsymbol{\lambda}^{-1}=(\lambda_{v}^{-1})_{v\in V}</annotation></semantics></math> and <math id="S5.p14.m7" class="ltx_Math" alttext="\overline{\sigma}_{\Lambda}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>σ</mi><mo stretchy="true">¯</mo></mover><mi mathvariant="normal">Λ</mi></msub><annotation encoding="application/x-tex">\overline{\sigma}_{\Lambda}</annotation></semantics></math> is the partial configuration on <math id="S5.p14.m8" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> such that <math id="S5.p14.m9" class="ltx_Math" alttext="\overline{\sigma}_{\Lambda}(w)=\overline{\sigma_{\Lambda}(w)}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>σ</mi><mo stretchy="true">¯</mo></mover><mi mathvariant="normal">Λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mover accent="true"><mrow><msub><mi>σ</mi><mi mathvariant="normal">Λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="true">¯</mo></mover></mrow><annotation encoding="application/x-tex">\overline{\sigma}_{\Lambda}(w)=\overline{\sigma_{\Lambda}(w)}</annotation></semantics></math> (i.e., the spin <math id="S5.p14.m10" class="ltx_Math" alttext="\sigma_{\Lambda}(w)" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mi mathvariant="normal">Λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\sigma_{\Lambda}(w)</annotation></semantics></math> imposed to <math id="S5.p14.m11" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> is flipped).
Thus, the Ising model with non-uniform external fields <math id="S5.p14.m12" class="ltx_Math" alttext="\boldsymbol{\lambda}" display="inline" intent=":literal"><semantics><mi>𝝀</mi><annotation encoding="application/x-tex">\boldsymbol{\lambda}</annotation></semantics></math> can be transferred to the Ising model with <math id="S5.p14.m13" class="ltx_Math" alttext="\boldsymbol{\lambda}^{-1}" display="inline" intent=":literal"><semantics><msup><mi>𝝀</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">\boldsymbol{\lambda}^{-1}</annotation></semantics></math>.
Since <math id="S5.p14.m14" class="ltx_Math" alttext="\inf_{v\in V(G)}\lambda_{v}&gt;\beta^{d}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>inf</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><msub><mi>λ</mi><mi>v</mi></msub></mrow><mo>&gt;</mo><msup><mi>β</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\inf_{v\in V(G)}\lambda_{v}&gt;\beta^{d}</annotation></semantics></math>, we have <math id="S5.p14.m15" class="ltx_Math" alttext="0&lt;\sup_{v\in V(G)}\lambda^{-1}_{v}&lt;1/\beta^{d}" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo rspace="0.1389em">&lt;</mo><mrow><msub><mo lspace="0.1389em" rspace="0.167em">sup</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><msubsup><mi>λ</mi><mi>v</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow><mo>&lt;</mo><mrow><mn>1</mn><mo>/</mo><msup><mi>β</mi><mi>d</mi></msup></mrow></mrow><annotation encoding="application/x-tex">0&lt;\sup_{v\in V(G)}\lambda^{-1}_{v}&lt;1/\beta^{d}</annotation></semantics></math>.
Thus, SSM also holds for the case that <math id="S5.p14.m16" class="ltx_Math" alttext="\inf_{v\in V(G)}\lambda_{v}&gt;\beta^{d}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>inf</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><msub><mi>λ</mi><mi>v</mi></msub></mrow><mo>&gt;</mo><msup><mi>β</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\inf_{v\in V(G)}\lambda_{v}&gt;\beta^{d}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S5.p15" class="ltx_para">
<p id="S5.p15.1" class="ltx_p">If we restrict the partial configuration <math id="S5.p15.m1" class="ltx_Math" alttext="\sigma_{\Lambda}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi mathvariant="normal">Λ</mi></msub><annotation encoding="application/x-tex">\sigma_{\Lambda}</annotation></semantics></math> to include at most one vertex with the <math id="S5.p15.m2" class="ltx_Math" alttext="+" display="inline" intent=":literal"><semantics><mo>+</mo><annotation encoding="application/x-tex">+</annotation></semantics></math> spin (or at most one vertex with the <math id="S5.p15.m3" class="ltx_Math" alttext="-" display="inline" intent=":literal"><semantics><mo>−</mo><annotation encoding="application/x-tex">-</annotation></semantics></math> spin), then similar to Corollary <a href="#Thmtheorem37" title="Corollary 37. ‣ 5 The implication for non-uniform external fields ‣ Strong Spatial Mixing for General 2-Spin Systems:A Unified Approach from Zero-Freeness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">37</span></a>, we have the following zero-free results as a corollary of Lee-Yang Theorem.</p>
</div>
<div id="Thmtheorem39" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem39.2" class="ltx_text ltx_font_bold">Corollary 39</span></span><span id="Thmtheorem39.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem39.p1" class="ltx_para">
<p id="Thmtheorem39.p1.1" class="ltx_p"><span id="Thmtheorem39.p1.1.1" class="ltx_text ltx_font_italic">Fix <math id="Thmtheorem39.p1.m1" class="ltx_Math" alttext="\beta&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\beta&gt;1</annotation></semantics></math>.
For any graph <math id="Thmtheorem39.p1.m2" class="ltx_Math" alttext="G=(V,E)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G=(V,E)</annotation></semantics></math> and any feasible partial configuration <math id="Thmtheorem39.p1.m3" class="ltx_Math" alttext="\sigma_{\Lambda}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi mathvariant="normal">Λ</mi></msub><annotation encoding="application/x-tex">\sigma_{\Lambda}</annotation></semantics></math> with at most one vertex <math id="Thmtheorem39.p1.m4" class="ltx_Math" alttext="u\in\Lambda" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>∈</mo><mi mathvariant="normal">Λ</mi></mrow><annotation encoding="application/x-tex">u\in\Lambda</annotation></semantics></math> having <math id="Thmtheorem39.p1.m5" class="ltx_math_unparsed" alttext="\sigma(u)=+" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em">+</mo></mrow><annotation encoding="application/x-tex">\sigma(u)=+</annotation></semantics></math>, the partition function <math id="Thmtheorem39.p1.m6" class="ltx_Math" alttext="Z^{\sigma_{\Lambda}}_{G}(\boldsymbol{\lambda})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Z</mi><mi>G</mi><msub><mi>σ</mi><mi mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝛌</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Z^{\sigma_{\Lambda}}_{G}(\boldsymbol{\lambda})</annotation></semantics></math>
is nonzero if for all <math id="Thmtheorem39.p1.m7" class="ltx_Math" alttext="v\in V" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">v\in V</annotation></semantics></math>, <math id="Thmtheorem39.p1.m8" class="ltx_Math" alttext="0&lt;|\lambda_{v}|&lt;1/\beta" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mrow><mo stretchy="false">|</mo><msub><mi>λ</mi><mi>v</mi></msub><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><mrow><mn>1</mn><mo>/</mo><mi>β</mi></mrow></mrow><annotation encoding="application/x-tex">0&lt;|\lambda_{v}|&lt;1/\beta</annotation></semantics></math>.</span></p>
</div>
<div id="Thmtheorem39.p2" class="ltx_para">
<p id="Thmtheorem39.p2.1" class="ltx_p"><span id="Thmtheorem39.p2.1.1" class="ltx_text ltx_font_italic">Symmetrically, for any graph <math id="Thmtheorem39.p2.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> and any feasible partial configuration <math id="Thmtheorem39.p2.m2" class="ltx_Math" alttext="\sigma_{\Lambda}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi mathvariant="normal">Λ</mi></msub><annotation encoding="application/x-tex">\sigma_{\Lambda}</annotation></semantics></math> with at most one vertex <math id="Thmtheorem39.p2.m3" class="ltx_Math" alttext="u\in\Lambda" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>∈</mo><mi mathvariant="normal">Λ</mi></mrow><annotation encoding="application/x-tex">u\in\Lambda</annotation></semantics></math> having <math id="Thmtheorem39.p2.m4" class="ltx_math_unparsed" alttext="\sigma(u)=-" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo></mrow><annotation encoding="application/x-tex">\sigma(u)=-</annotation></semantics></math>, the partition function <math id="Thmtheorem39.p2.m5" class="ltx_Math" alttext="Z^{\sigma_{\Lambda}}_{G}(\boldsymbol{\lambda})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Z</mi><mi>G</mi><msub><mi>σ</mi><mi mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝛌</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Z^{\sigma_{\Lambda}}_{G}(\boldsymbol{\lambda})</annotation></semantics></math>
is nonzero if for all <math id="Thmtheorem39.p2.m6" class="ltx_Math" alttext="v\in V" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">v\in V</annotation></semantics></math>, <math id="Thmtheorem39.p2.m7" class="ltx_Math" alttext="|\lambda_{v}|&gt;\beta" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi>λ</mi><mi>v</mi></msub><mo stretchy="false">|</mo></mrow><mo>&gt;</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">|\lambda_{v}|&gt;\beta</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S5.p16" class="ltx_para">
<p id="S5.p16.1" class="ltx_p">We say a partial configuration <math id="S5.p16.m1" class="ltx_Math" alttext="\sigma_{\Lambda}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi mathvariant="normal">Λ</mi></msub><annotation encoding="application/x-tex">\sigma_{\Lambda}</annotation></semantics></math> is all-plus
if <math id="S5.p16.m2" class="ltx_math_unparsed" alttext="\sigma(v)=+" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em">+</mo></mrow><annotation encoding="application/x-tex">\sigma(v)=+</annotation></semantics></math> for every <math id="S5.p16.m3" class="ltx_Math" alttext="v\in\Lambda" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mi mathvariant="normal">Λ</mi></mrow><annotation encoding="application/x-tex">v\in\Lambda</annotation></semantics></math>, and all-minus if <math id="S5.p16.m4" class="ltx_math_unparsed" alttext="\sigma(v)=-" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo></mrow><annotation encoding="application/x-tex">\sigma(v)=-</annotation></semantics></math> for every <math id="S5.p16.m5" class="ltx_Math" alttext="v\in\Lambda" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mi mathvariant="normal">Λ</mi></mrow><annotation encoding="application/x-tex">v\in\Lambda</annotation></semantics></math>.
We define the following forms of spatial mixing.</p>
</div>
<div id="Thmtheorem40" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem40.2" class="ltx_text ltx_font_bold">Definition 40</span></span><span id="Thmtheorem40.3" class="ltx_text ltx_font_bold"> </span>(Plus or minus spatial mixing (PSM/MSM))<span id="Thmtheorem40.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem40.p1" class="ltx_para">
<p id="Thmtheorem40.p1.1" class="ltx_p"><span id="Thmtheorem40.p1.1.1" class="ltx_text ltx_font_italic">Fix parameters <math id="Thmtheorem40.p1.m1" class="ltx_Math" alttext="\beta,\gamma" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>,</mo><mi>γ</mi></mrow><annotation encoding="application/x-tex">\beta,\gamma</annotation></semantics></math>, non-uniform <math id="Thmtheorem40.p1.m2" class="ltx_Math" alttext="\boldsymbol{\lambda}" display="inline" intent=":literal"><semantics><mi>𝛌</mi><annotation encoding="application/x-tex">\boldsymbol{\lambda}</annotation></semantics></math>, and a family of graphs <math id="Thmtheorem40.p1.m3" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math>.
The corresponding
2-spin system
defined on <math id="Thmtheorem40.p1.m4" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> specified by <math id="Thmtheorem40.p1.m5" class="ltx_Math" alttext="\beta,\gamma" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>,</mo><mi>γ</mi></mrow><annotation encoding="application/x-tex">\beta,\gamma</annotation></semantics></math> and non-uniform <math id="Thmtheorem40.p1.m6" class="ltx_Math" alttext="\boldsymbol{\lambda}" display="inline" intent=":literal"><semantics><mi>𝛌</mi><annotation encoding="application/x-tex">\boldsymbol{\lambda}</annotation></semantics></math> is said to satisfy <em id="Thmtheorem40.p1.1.1.1" class="ltx_emph ltx_font_upright">plus spatial mixing (PSM) (or respectively minus spatial mixing (MSM))</em> with exponential rate <math id="Thmtheorem40.p1.m7" class="ltx_Math" alttext="r&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">r&gt;1</annotation></semantics></math> if there exists a constant <math id="Thmtheorem40.p1.m8" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> such that for any <math id="Thmtheorem40.p1.m9" class="ltx_Math" alttext="G=(V,E)\in\mathcal{G}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow><annotation encoding="application/x-tex">G=(V,E)\in\mathcal{G}</annotation></semantics></math>,
any feasible all-plus (or respectively all-minus) partial configurations <math id="Thmtheorem40.p1.m10" class="ltx_Math" alttext="\sigma_{\Lambda_{1}}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><msub><mi mathvariant="normal">Λ</mi><mn>1</mn></msub></msub><annotation encoding="application/x-tex">\sigma_{\Lambda_{1}}</annotation></semantics></math> and <math id="Thmtheorem40.p1.m11" class="ltx_Math" alttext="\tau_{\Lambda_{2}}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><msub><mi mathvariant="normal">Λ</mi><mn>2</mn></msub></msub><annotation encoding="application/x-tex">\tau_{\Lambda_{2}}</annotation></semantics></math> where <math id="Thmtheorem40.p1.m12" class="ltx_Math" alttext="\Lambda_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Λ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\Lambda_{1}</annotation></semantics></math> may be different with <math id="Thmtheorem40.p1.m13" class="ltx_Math" alttext="\Lambda_{2}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Λ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\Lambda_{2}</annotation></semantics></math>, and any vertex <math id="Thmtheorem40.p1.m14" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> proper to <math id="Thmtheorem40.p1.m15" class="ltx_Math" alttext="\sigma_{\Lambda_{1}}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><msub><mi mathvariant="normal">Λ</mi><mn>1</mn></msub></msub><annotation encoding="application/x-tex">\sigma_{\Lambda_{1}}</annotation></semantics></math> and <math id="Thmtheorem40.p1.m16" class="ltx_Math" alttext="\tau_{\Lambda_{2}}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><msub><mi mathvariant="normal">Λ</mi><mn>2</mn></msub></msub><annotation encoding="application/x-tex">\tau_{\Lambda_{2}}</annotation></semantics></math>, we have</span></p>
<table id="S5.Ex39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex39.m1" class="ltx_Math" alttext="\left|P_{G,v}^{\sigma_{\Lambda_{1}}}-P_{G,v}^{\tau_{\Lambda_{2}}}\right|\leq Cr^{-d_{G}(v,\sigma_{\Lambda_{1}}\neq\tau_{\Lambda_{2}})}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><msubsup><mi>P</mi><mrow><mi>G</mi><mo>,</mo><mi>v</mi></mrow><msub><mi>σ</mi><msub><mi mathvariant="normal">Λ</mi><mn>1</mn></msub></msub></msubsup><mo>−</mo><msubsup><mi>P</mi><mrow><mi>G</mi><mo>,</mo><mi>v</mi></mrow><msub><mi>τ</mi><msub><mi mathvariant="normal">Λ</mi><mn>2</mn></msub></msub></msubsup></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mrow><mo>−</mo><mrow><msub><mi>d</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mrow><msub><mi>σ</mi><msub><mi mathvariant="normal">Λ</mi><mn>1</mn></msub></msub><mo>≠</mo><msub><mi>τ</mi><msub><mi mathvariant="normal">Λ</mi><mn>2</mn></msub></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|P_{G,v}^{\sigma_{\Lambda_{1}}}-P_{G,v}^{\tau_{\Lambda_{2}}}\right|\leq Cr^{-d_{G}(v,\sigma_{\Lambda_{1}}\neq\tau_{\Lambda_{2}})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="Thmtheorem41" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem41.2" class="ltx_text ltx_font_bold">Theorem 41</span></span><span id="Thmtheorem41.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem41.p1" class="ltx_para">
<p id="Thmtheorem41.p1.1" class="ltx_p"><span id="Thmtheorem41.p1.1.1" class="ltx_text ltx_font_italic">Fix <math id="Thmtheorem41.p1.m1" class="ltx_Math" alttext="\beta&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\beta&gt;1</annotation></semantics></math> and integer <math id="Thmtheorem41.p1.m2" class="ltx_Math" alttext="d\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">d\geq 2</annotation></semantics></math>.
The ferromagnetic Ising model on all graphs <math id="Thmtheorem41.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> specified by <math id="Thmtheorem41.p1.m4" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> and non-uniform positive external fields <math id="Thmtheorem41.p1.m5" class="ltx_Math" alttext="\boldsymbol{\lambda}" display="inline" intent=":literal"><semantics><mi>𝛌</mi><annotation encoding="application/x-tex">\boldsymbol{\lambda}</annotation></semantics></math> with the same argument <math id="Thmtheorem41.p1.m6" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> exhibits PSM if <math id="Thmtheorem41.p1.m7" class="ltx_Math" alttext="\inf_{v\in V(G)}|\lambda_{v}|&gt;\beta" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>inf</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mrow><mo lspace="0em" stretchy="false">|</mo><msub><mi>λ</mi><mi>v</mi></msub><mo stretchy="false">|</mo></mrow></mrow><mo>&gt;</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">\inf_{v\in V(G)}|\lambda_{v}|&gt;\beta</annotation></semantics></math>, and it exhibits MSM if <math id="Thmtheorem41.p1.m8" class="ltx_Math" alttext="\sup_{v\in V(G)}|\lambda_{v}|&lt;1/\beta" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>sup</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mrow><mo lspace="0em" stretchy="false">|</mo><msub><mi>λ</mi><mi>v</mi></msub><mo stretchy="false">|</mo></mrow></mrow><mo>&lt;</mo><mrow><mn>1</mn><mo>/</mo><mi>β</mi></mrow></mrow><annotation encoding="application/x-tex">\sup_{v\in V(G)}|\lambda_{v}|&lt;1/\beta</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S5.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.p17" class="ltx_para">
<p id="S5.p17.1" class="ltx_p"><span id="S5.p17.1.1" class="ltx_text">By symmetry, it suffices to prove MSM when <math id="S5.p17.m1" class="ltx_Math" alttext="\sup_{v\in V(G)}|\lambda_{v}|&lt;1/\beta" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>sup</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mrow><mo lspace="0em" stretchy="false">|</mo><msub><mi>λ</mi><mi>v</mi></msub><mo stretchy="false">|</mo></mrow></mrow><mo>&lt;</mo><mrow><mn>1</mn><mo>/</mo><mi>β</mi></mrow></mrow><annotation encoding="application/x-tex">\sup_{v\in V(G)}|\lambda_{v}|&lt;1/\beta</annotation></semantics></math>.
Consider the family of functions <math id="S5.p17.m2" class="ltx_Math" alttext="\{P_{G,v}^{\tau_{\Lambda}}(z\boldsymbol{\lambda})\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><msubsup><mi>P</mi><mrow><mi>G</mi><mo>,</mo><mi>v</mi></mrow><msub><mi>τ</mi><mi mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝝀</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{P_{G,v}^{\tau_{\Lambda}}(z\boldsymbol{\lambda})\}</annotation></semantics></math> defined on <math id="S5.p17.m3" class="ltx_Math" alttext="U=\{z\in\mathbb{C}\mid|z|&lt;\frac{1}{\beta\sup_{v\in V(G)}|\lambda_{v}|}\}" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>z</mi><mo>∈</mo><mi>ℂ</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><mo stretchy="false">|</mo><mi>z</mi><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><mfrac><mn>1</mn><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0em">sup</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mrow><mo stretchy="false">|</mo><msub><mi>λ</mi><mi>v</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mrow></mfrac></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">U=\{z\in\mathbb{C}\mid|z|&lt;\frac{1}{\beta\sup_{v\in V(G)}|\lambda_{v}|}\}</annotation></semantics></math>, where <math id="S5.p17.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> runs over all graphs, <math id="S5.p17.m5" class="ltx_Math" alttext="\tau_{\Lambda}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi mathvariant="normal">Λ</mi></msub><annotation encoding="application/x-tex">\tau_{\Lambda}</annotation></semantics></math> runs over all all-minus partial configurations, and <math id="S5.p17.m6" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> runs over all proper vertices.</span></p>
</div>
<div id="S5.p18" class="ltx_para">
<p id="S5.p18.1" class="ltx_p"><span id="S5.p18.1.1" class="ltx_text">Note that for any <math id="S5.p18.m1" class="ltx_Math" alttext="z\in U" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>∈</mo><mi>U</mi></mrow><annotation encoding="application/x-tex">z\in U</annotation></semantics></math> and any <math id="S5.p18.m2" class="ltx_Math" alttext="\lambda_{v}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>v</mi></msub><annotation encoding="application/x-tex">\lambda_{v}</annotation></semantics></math>, we have <math id="S5.p18.m3" class="ltx_Math" alttext="|z\lambda_{v}|&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>λ</mi><mi>v</mi></msub></mrow><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">|z\lambda_{v}|&lt;1</annotation></semantics></math>. Then, by Corollary <a href="#Thmtheorem39" title="Corollary 39. ‣ 5 The implication for non-uniform external fields ‣ Strong Spatial Mixing for General 2-Spin Systems:A Unified Approach from Zero-Freeness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">39</span></a>, the function <math id="S5.p18.m4" class="ltx_Math" alttext="P_{G,v}^{\tau_{\Lambda}}(z\boldsymbol{\lambda})=\frac{Z_{G,v}^{\tau_{\Lambda},+}(z\boldsymbol{\lambda})}{Z_{G}^{\tau_{\Lambda}}(z\boldsymbol{\lambda})}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>P</mi><mrow><mi>G</mi><mo>,</mo><mi>v</mi></mrow><msub><mi>τ</mi><mi mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝝀</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>,</mo><mi>v</mi></mrow><mrow><msub><mi>τ</mi><mi mathvariant="normal">Λ</mi></msub><mo rspace="0em">,</mo><mo lspace="0em">+</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝝀</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mi>Z</mi><mi>G</mi><msub><mi>τ</mi><mi mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝝀</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">P_{G,v}^{\tau_{\Lambda}}(z\boldsymbol{\lambda})=\frac{Z_{G,v}^{\tau_{\Lambda},+}(z\boldsymbol{\lambda})}{Z_{G}^{\tau_{\Lambda}}(z\boldsymbol{\lambda})}</annotation></semantics></math> is nonzero since the configuration <math id="S5.p18.m5" class="ltx_Math" alttext="\tau_{\Lambda}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi mathvariant="normal">Λ</mi></msub><annotation encoding="application/x-tex">\tau_{\Lambda}</annotation></semantics></math> together with <math id="S5.p18.m6" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> pinned to <math id="S5.p18.m7" class="ltx_Math" alttext="+" display="inline" intent=":literal"><semantics><mo>+</mo><annotation encoding="application/x-tex">+</annotation></semantics></math> has exactly one vertex <math id="S5.p18.m8" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> with the <math id="S5.p18.m9" class="ltx_Math" alttext="+" display="inline" intent=":literal"><semantics><mo>+</mo><annotation encoding="application/x-tex">+</annotation></semantics></math> spin.
Also, <math id="S5.p18.m10" class="ltx_Math" alttext="P_{G,v}^{\tau_{\Lambda}}(z\boldsymbol{\lambda})=1-\frac{Z_{G,v}^{\tau_{\Lambda},-}(z\boldsymbol{\lambda})}{Z_{G}^{\tau_{\Lambda}}(z\boldsymbol{\lambda})}\neq 1" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>P</mi><mrow><mi>G</mi><mo>,</mo><mi>v</mi></mrow><msub><mi>τ</mi><mi mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝝀</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>,</mo><mi>v</mi></mrow><mrow><msub><mi>τ</mi><mi mathvariant="normal">Λ</mi></msub><mo rspace="0em">,</mo><mo lspace="0em">−</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝝀</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mi>Z</mi><mi>G</mi><msub><mi>τ</mi><mi mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝝀</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo>≠</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">P_{G,v}^{\tau_{\Lambda}}(z\boldsymbol{\lambda})=1-\frac{Z_{G,v}^{\tau_{\Lambda},-}(z\boldsymbol{\lambda})}{Z_{G}^{\tau_{\Lambda}}(z\boldsymbol{\lambda})}\neq 1</annotation></semantics></math> since <math id="S5.p18.m11" class="ltx_Math" alttext="Z_{G,v}^{\tau_{\Lambda},-}(z\boldsymbol{\lambda})\neq 0" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>,</mo><mi>v</mi></mrow><mrow><msub><mi>τ</mi><mi mathvariant="normal">Λ</mi></msub><mo rspace="0em">,</mo><mo lspace="0em">−</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝝀</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">Z_{G,v}^{\tau_{\Lambda},-}(z\boldsymbol{\lambda})\neq 0</annotation></semantics></math>.</span></p>
</div>
<div id="S5.p19" class="ltx_para">
<p id="S5.p19.1" class="ltx_p"><span id="S5.p19.1.1" class="ltx_text">Thus, all the functions <math id="S5.p19.m1" class="ltx_Math" alttext="\{P_{G,v}^{\tau_{\Lambda}}(z\boldsymbol{\lambda})\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><msubsup><mi>P</mi><mrow><mi>G</mi><mo>,</mo><mi>v</mi></mrow><msub><mi>τ</mi><mi mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝝀</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{P_{G,v}^{\tau_{\Lambda}}(z\boldsymbol{\lambda})\}</annotation></semantics></math> avoid <math id="S5.p19.m2" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> and <math id="S5.p19.m3" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>. They form a normal family by Montel’s Theorem (Theorem <a href="#Thmtheorem12" title="Theorem 12 (Montel’s Theorem). ‣ 2.3 Tools from complex analysis ‣ 2 Preliminaries ‣ Strong Spatial Mixing for General 2-Spin Systems:A Unified Approach from Zero-Freeness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>).
Hence, there exists a uniform bound <math id="S5.p19.m4" class="ltx_Math" alttext="M&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">M&gt;0</annotation></semantics></math> such that</span></p>
<table id="S5.Ex40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex40.m1" class="ltx_Math" alttext="|P_{G,v}^{\tau_{\Lambda}}(z\boldsymbol{\lambda})|\leq M,\quad\forall|z|\leq\rho:=\frac{1}{2}\left(1+\frac{1}{\beta\sup_{v\in V(G)}|\lambda_{v}|}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><msubsup><mi>P</mi><mrow><mi>G</mi><mo>,</mo><mi>v</mi></mrow><msub><mi>τ</mi><mi mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝝀</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>M</mi></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mo>∀</mo><mrow><mo stretchy="false">|</mo><mi>z</mi><mo stretchy="false">|</mo></mrow></mrow><mo>≤</mo><mi>ρ</mi><mo>:=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mfrac><mn>1</mn><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0em">sup</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mrow><mo stretchy="false">|</mo><msub><mi>λ</mi><mi>v</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mrow></mfrac></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|P_{G,v}^{\tau_{\Lambda}}(z\boldsymbol{\lambda})|\leq M,\quad\forall|z|\leq\rho:=\frac{1}{2}\left(1+\frac{1}{\beta\sup_{v\in V(G)}|\lambda_{v}|}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p19.2" class="ltx_p"><span id="S5.p19.2.1" class="ltx_text">Combining with the LDC property proved above, we can prove MSM for <math id="S5.p19.m5" class="ltx_Math" alttext="P_{G,v}^{\tau_{\Lambda}}(z\boldsymbol{\lambda})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>P</mi><mrow><mi>G</mi><mo>,</mo><mi>v</mi></mrow><msub><mi>τ</mi><mi mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝝀</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P_{G,v}^{\tau_{\Lambda}}(z\boldsymbol{\lambda})</annotation></semantics></math> with <math id="S5.p19.m6" class="ltx_Math" alttext="|z|\leq\rho" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>z</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mi>ρ</mi></mrow><annotation encoding="application/x-tex">|z|\leq\rho</annotation></semantics></math>.
Since <math id="S5.p19.m7" class="ltx_Math" alttext="\sup_{v\in V(G)}|\lambda_{v}|&lt;1/\beta" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>sup</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mrow><mo lspace="0em" stretchy="false">|</mo><msub><mi>λ</mi><mi>v</mi></msub><mo stretchy="false">|</mo></mrow></mrow><mo>&lt;</mo><mrow><mn>1</mn><mo>/</mo><mi>β</mi></mrow></mrow><annotation encoding="application/x-tex">\sup_{v\in V(G)}|\lambda_{v}|&lt;1/\beta</annotation></semantics></math>, one can check that <math id="S5.p19.m8" class="ltx_Math" alttext="\rho&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\rho&gt;1</annotation></semantics></math>.
Thus, we can take <math id="S5.p19.m9" class="ltx_Math" alttext="z=1" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">z=1</annotation></semantics></math>. We are done with the proof.
∎</span></p>
</div>
</div>
</section>
<section id="S6" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">6 </span>Concluding remarks and questions</h2>

<div id="S6.p1" class="ltx_para">
<p id="S6.p1.1" class="ltx_p">We prove that if the partition function of a 2-spin system is zero-free in a complex neighborhood of <math id="S6.p1.m1" class="ltx_Math" alttext="\lambda=0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda=0</annotation></semantics></math> or <math id="S6.p1.m2" class="ltx_Math" alttext="\beta\gamma=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\beta\gamma=1</annotation></semantics></math> containing a positive point, then the corresponding 2-spin system exhibits SSM.
By a Christoffel-Darboux type identity, it seems that the implication from zero-free regions to SSM
only works for complex neighborhoods of <math id="S6.p1.m3" class="ltx_Math" alttext="\lambda=0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda=0</annotation></semantics></math> or <math id="S6.p1.m4" class="ltx_Math" alttext="\beta\gamma=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\beta\gamma=1</annotation></semantics></math>.
A natural question is: <em id="S6.p1.1.1" class="ltx_emph ltx_font_italic">what is the magic of these two special settings of parameters <math id="S6.p1.m5" class="ltx_Math" alttext="\lambda=0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda=0</annotation></semantics></math> and <math id="S6.p1.m6" class="ltx_Math" alttext="\beta\gamma=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\beta\gamma=1</annotation></semantics></math> for which the exact computation of the partition function is polynomial-time solvable?</em>
In fact, so far all currently known zero-free regions (and even all SSM results and all FPTAS results) for 2-spin systems lie in some complex neighborhoods of <math id="S6.p1.m7" class="ltx_Math" alttext="\lambda=0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda=0</annotation></semantics></math> (up to a switch of the spins <math id="S6.p1.m8" class="ltx_Math" alttext="+" display="inline" intent=":literal"><semantics><mo>+</mo><annotation encoding="application/x-tex">+</annotation></semantics></math> and <math id="S6.p1.m9" class="ltx_Math" alttext="-" display="inline" intent=":literal"><semantics><mo>−</mo><annotation encoding="application/x-tex">-</annotation></semantics></math>) or <math id="S6.p1.m10" class="ltx_Math" alttext="\beta\gamma=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\beta\gamma=1</annotation></semantics></math>.
We are curious whether this is always true and we make the following conjectures.</p>
</div>
<div id="Thmconjecture1" class="ltx_theorem ltx_theorem_conjecture">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmconjecture1.2" class="ltx_text ltx_font_bold">Conjecture 1</span></span><span id="Thmconjecture1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmconjecture1.p1" class="ltx_para">
<p id="Thmconjecture1.p1.1" class="ltx_p"><span id="Thmconjecture1.p1.1.1" class="ltx_text ltx_font_italic">Fix <math id="Thmconjecture1.p1.m1" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> and <math id="Thmconjecture1.p1.m2" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> that are not both zero.
Suppose that the partition function <math id="Thmconjecture1.p1.m3" class="ltx_Math" alttext="Z^{\sigma_{\Lambda}}_{G}(\lambda)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Z</mi><mi>G</mi><msub><mi>σ</mi><mi mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Z^{\sigma_{\Lambda}}_{G}(\lambda)</annotation></semantics></math> of the 2-spin system is zero-free on a complex region <math id="Thmconjecture1.p1.m4" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>.
Then, there exists a complex neighborhood <math id="Thmconjecture1.p1.m5" class="ltx_Math" alttext="U^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>U</mi><mo>′</mo></msup><annotation encoding="application/x-tex">U^{\prime}</annotation></semantics></math> of <math id="Thmconjecture1.p1.m6" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> such that <math id="Thmconjecture1.p1.m7" class="ltx_Math" alttext="U\subseteq U^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⊆</mo><msup><mi>U</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">U\subseteq U^{\prime}</annotation></semantics></math> and <math id="Thmconjecture1.p1.m8" class="ltx_Math" alttext="Z^{\sigma_{\Lambda}}_{G}(\lambda)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Z</mi><mi>G</mi><msub><mi>σ</mi><mi mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Z^{\sigma_{\Lambda}}_{G}(\lambda)</annotation></semantics></math> is zero-free on <math id="Thmconjecture1.p1.m9" class="ltx_Math" alttext="U^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>U</mi><mo>′</mo></msup><annotation encoding="application/x-tex">U^{\prime}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="Thmconjecture2" class="ltx_theorem ltx_theorem_conjecture">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmconjecture2.2" class="ltx_text ltx_font_bold">Conjecture 2</span></span><span id="Thmconjecture2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmconjecture2.p1" class="ltx_para">
<p id="Thmconjecture2.p1.1" class="ltx_p"><span id="Thmconjecture2.p1.1.1" class="ltx_text ltx_font_italic">Fix <math id="Thmconjecture2.p1.m1" class="ltx_Math" alttext="\gamma\neq 0" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\gamma\neq 0</annotation></semantics></math> and <math id="Thmconjecture2.p1.m2" class="ltx_Math" alttext="\lambda\neq 0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda\neq 0</annotation></semantics></math>.
Suppose that the partition function <math id="Thmconjecture2.p1.m3" class="ltx_Math" alttext="Z^{\sigma_{\Lambda}}_{G}(\beta)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Z</mi><mi>G</mi><msub><mi>σ</mi><mi mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Z^{\sigma_{\Lambda}}_{G}(\beta)</annotation></semantics></math> of the 2-spin system is zero-free on a complex region <math id="Thmconjecture2.p1.m4" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>.
Then, there exists a complex neighborhood <math id="Thmconjecture2.p1.m5" class="ltx_Math" alttext="U^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>U</mi><mo>′</mo></msup><annotation encoding="application/x-tex">U^{\prime}</annotation></semantics></math> of <math id="Thmconjecture2.p1.m6" class="ltx_Math" alttext="1/\gamma" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mi>γ</mi></mrow><annotation encoding="application/x-tex">1/\gamma</annotation></semantics></math> such that <math id="Thmconjecture2.p1.m7" class="ltx_Math" alttext="U\subseteq U^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⊆</mo><msup><mi>U</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">U\subseteq U^{\prime}</annotation></semantics></math> and <math id="Thmconjecture2.p1.m8" class="ltx_Math" alttext="Z^{\sigma_{\Lambda}}_{G}(\beta)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Z</mi><mi>G</mi><msub><mi>σ</mi><mi mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Z^{\sigma_{\Lambda}}_{G}(\beta)</annotation></semantics></math> is zero-free on <math id="Thmconjecture2.p1.m9" class="ltx_Math" alttext="U^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>U</mi><mo>′</mo></msup><annotation encoding="application/x-tex">U^{\prime}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="Thmconjecture3" class="ltx_theorem ltx_theorem_conjecture">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmconjecture3.2" class="ltx_text ltx_font_bold">Conjecture 3</span></span><span id="Thmconjecture3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmconjecture3.p1" class="ltx_para">
<p id="Thmconjecture3.p1.1" class="ltx_p"><span id="Thmconjecture3.p1.1.1" class="ltx_text ltx_font_italic">Fix <math id="Thmconjecture3.p1.m1" class="ltx_Math" alttext="\lambda\neq 0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda\neq 0</annotation></semantics></math>.
Suppose that the partition function <math id="Thmconjecture3.p1.m2" class="ltx_Math" alttext="Z^{\sigma_{\Lambda}}_{G}(\beta)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Z</mi><mi>G</mi><msub><mi>σ</mi><mi mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Z^{\sigma_{\Lambda}}_{G}(\beta)</annotation></semantics></math> of the Ising model is zero-free on a complex region <math id="Thmconjecture3.p1.m3" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>.
Then, there exists a complex neighborhood <math id="Thmconjecture3.p1.m4" class="ltx_Math" alttext="U^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>U</mi><mo>′</mo></msup><annotation encoding="application/x-tex">U^{\prime}</annotation></semantics></math> of <math id="Thmconjecture3.p1.m5" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> (or <math id="Thmconjecture3.p1.m6" class="ltx_Math" alttext="-1" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">-1</annotation></semantics></math>) such that <math id="Thmconjecture3.p1.m7" class="ltx_Math" alttext="U\subseteq U^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>⊆</mo><msup><mi>U</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">U\subseteq U^{\prime}</annotation></semantics></math> and <math id="Thmconjecture3.p1.m8" class="ltx_Math" alttext="Z^{\sigma_{\Lambda}}_{G}(\beta)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Z</mi><mi>G</mi><msub><mi>σ</mi><mi mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Z^{\sigma_{\Lambda}}_{G}(\beta)</annotation></semantics></math> is zero-free on <math id="Thmconjecture3.p1.m9" class="ltx_Math" alttext="U^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>U</mi><mo>′</mo></msup><annotation encoding="application/x-tex">U^{\prime}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S6.p2" class="ltx_para">
<p id="S6.p2.1" class="ltx_p">For the Ising model, a complex zero-free neighborhood of <math id="S6.p2.m1" class="ltx_Math" alttext="\beta=1" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\beta=1</annotation></semantics></math> is known <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib24" title="" class="ltx_ref">30</a>]</cite>.
Also, one can check that the point <math id="S6.p2.m2" class="ltx_Math" alttext="\beta=-1" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>=</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\beta=-1</annotation></semantics></math> (with a fixed <math id="S6.p2.m3" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>) satisfies the real contraction property introduced in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib38" title="" class="ltx_ref">43</a>]</cite> which implies that there exists a complex neighborhood of <math id="S6.p2.m4" class="ltx_Math" alttext="-1" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">-1</annotation></semantics></math> such that the partition function of the Ising model is zero-free on it.
Thus, for Conjecture <a href="#Thmconjecture3" title="Conjecture 3. ‣ 6 Concluding remarks and questions ‣ Strong Spatial Mixing for General 2-Spin Systems:A Unified Approach from Zero-Freeness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, at least there exists a complex neighborhood of <math id="S6.p2.m5" class="ltx_Math" alttext="\beta=1" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\beta=1</annotation></semantics></math> and a complex neighborhood of <math id="S6.p2.m6" class="ltx_Math" alttext="\beta=-1" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>=</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\beta=-1</annotation></semantics></math> respectively such that the partition function of the Ising model is zero-free on them.</p>
</div>
</section>
<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Christoffel-Darboux identity for <math id="A1.m1" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>-spin systems on trees</h2>

<div id="A1.p1" class="ltx_para">
<p id="A1.p1.1" class="ltx_p">In this section, we extend Christoffel-Darboux type identity to <math id="A1.p1.m1" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>-spin systems.</p>
</div>
<div id="A1.p2" class="ltx_para">
<p id="A1.p2.1" class="ltx_p">Such a system is defined on a simple undirected graph <math id="A1.p2.m1" class="ltx_Math" alttext="G=(V,E)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G=(V,E)</annotation></semantics></math> and in this way the individual entities comprising the system correspond to the
vertices <math id="A1.p2.m2" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> and their pairwise interactions correspond to the edges <math id="A1.p2.m3" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>.</p>
</div>
<div id="A1.p3" class="ltx_para">
<p id="A1.p3.1" class="ltx_p">The system is associated with some parameters consisting of a <math id="A1.p3.m1" class="ltx_Math" alttext="q\times q" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">q\times q</annotation></semantics></math> symmetric matrix of edge activities <math id="A1.p3.m2" class="ltx_Math" alttext="A=(a_{i,j})_{1\leq i,j\leq q}\in\mathcal{M}_{q}(\mathbb{C})" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mrow><mn>1</mn><mo>≤</mo><mi>i</mi></mrow><mo>,</mo><mrow><mi>j</mi><mo>≤</mo><mi>q</mi></mrow></mrow></msub><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ℂ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">A=(a_{i,j})_{1\leq i,j\leq q}\in\mathcal{M}_{q}(\mathbb{C})</annotation></semantics></math> that models the tendency of vertices to agree and disagree with their neighbors, and a uniform vertex activity vector <math id="A1.p3.m3" class="ltx_Math" alttext="\boldsymbol{\lambda}=(\lambda_{1},\cdots,\lambda_{q})\in\mathbb{C}^{q}" display="inline" intent=":literal"><semantics><mrow><mi>𝝀</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>λ</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>ℂ</mi><mi>q</mi></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{\lambda}=(\lambda_{1},\cdots,\lambda_{q})\in\mathbb{C}^{q}</annotation></semantics></math> that models an external field which determines the propensities of a vertex.</p>
</div>
<div id="A1.p4" class="ltx_para">
<p id="A1.p4.1" class="ltx_p">A partial configuration of this system refers to a mapping <math id="A1.p4.m1" class="ltx_Math" alttext="\sigma:\Lambda\to[q]=\{1,2,\cdots,q\}" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Λ</mi><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mi>q</mi><mo stretchy="false">]</mo></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>q</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sigma:\Lambda\to[q]=\{1,2,\cdots,q\}</annotation></semantics></math> for some <math id="A1.p4.m2" class="ltx_Math" alttext="\Lambda\subseteq V" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo>⊆</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">\Lambda\subseteq V</annotation></semantics></math> which may be empty. It assigns one of the <math id="A1.p4.m3" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> spins to each vertex in <math id="A1.p4.m4" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>.
When <math id="A1.p4.m5" class="ltx_Math" alttext="\Lambda=V" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo>=</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">\Lambda=V</annotation></semantics></math>, it is called a configuration and its weight is</p>
<table id="A1.Ex41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex41.m1" class="ltx_Math" alttext="\omega(\sigma)=\prod_{v\in V}\lambda_{\sigma(v)}\prod_{(u,v)\in E}a_{\sigma(u),\sigma(v)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∏</mo><mrow><mi>v</mi><mo>∈</mo><mi>V</mi></mrow></munder><mrow><msub><mi>λ</mi><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∏</mo><mrow><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>E</mi></mrow></munder><msub><mi>a</mi><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\omega(\sigma)=\prod_{v\in V}\lambda_{\sigma(v)}\prod_{(u,v)\in E}a_{\sigma(u),\sigma(v)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p4.2" class="ltx_p">The <em id="A1.p4.2.1" class="ltx_emph ltx_font_italic">partition function</em> of a 2-spin system is defined to be</p>
<table id="A1.Ex42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex42.m1" class="ltx_math_unparsed" alttext="Z_{G}(A,\boldsymbol{\lambda}):=\sum\limits_{\sigma:V\to[q]}w(\sigma)." display="block" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mi>G</mi></msub><mrow><mo stretchy="false">(</mo><mi>A</mi><mo>,</mo><mi>𝝀</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">:=</mo><munder><mo movablelimits="false">∑</mo><mrow><mi>σ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>V</mi><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mi>q</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></munder><mi>w</mi><mrow><mo stretchy="false">(</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Z_{G}(A,\boldsymbol{\lambda}):=\sum\limits_{\sigma:V\to[q]}w(\sigma).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p4.3" class="ltx_p">We also define the partition function conditioning on a pre-described partial configuration <math id="A1.p4.m6" class="ltx_Math" alttext="\sigma_{\Lambda}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi mathvariant="normal">Λ</mi></msub><annotation encoding="application/x-tex">\sigma_{\Lambda}</annotation></semantics></math> by</p>
<table id="A1.Ex43" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex43.m1" class="ltx_math_unparsed" alttext="Z^{\sigma_{\Lambda}}_{G}(A,\boldsymbol{\lambda})\sum_{\tau:V\to[q],\tau|_{\Lambda}=\sigma_{\Lambda}}w(\sigma)" display="block" intent=":literal"><semantics><mrow><msubsup><mi>Z</mi><mi>G</mi><msub><mi>σ</mi><mi mathvariant="normal">Λ</mi></msub></msubsup><mrow><mo stretchy="false">(</mo><mi>A</mi><mo>,</mo><mi>𝝀</mi><mo stretchy="false">)</mo></mrow><munder><mo movablelimits="false">∑</mo><mrow><mrow><mi>τ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>V</mi><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mi>q</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>,</mo><mrow><msub><mrow><mi>τ</mi><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">Λ</mi></msub><mo>=</mo><msub><mi>σ</mi><mi mathvariant="normal">Λ</mi></msub></mrow></mrow></munder><mi>w</mi><mrow><mo stretchy="false">(</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Z^{\sigma_{\Lambda}}_{G}(A,\boldsymbol{\lambda})\sum_{\tau:V\to[q],\tau|_{\Lambda}=\sigma_{\Lambda}}w(\sigma)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p4.4" class="ltx_p">where <math id="A1.p4.m7" class="ltx_Math" alttext="\tau|_{\Lambda}" display="inline" intent=":literal"><semantics><msub><mrow><mi>τ</mi><mo stretchy="false">|</mo></mrow><mi mathvariant="normal">Λ</mi></msub><annotation encoding="application/x-tex">\tau|_{\Lambda}</annotation></semantics></math> denotes the restriction of the configuration <math id="A1.p4.m8" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> on <math id="A1.p4.m9" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math>. For <math id="A1.p4.m10" class="ltx_Math" alttext="u,v\in V(G)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>u</mi><mo>,</mo><mi>v</mi></mrow><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">u,v\in V(G),</annotation></semantics></math> we define</p>
<table id="A1.Ex44" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
