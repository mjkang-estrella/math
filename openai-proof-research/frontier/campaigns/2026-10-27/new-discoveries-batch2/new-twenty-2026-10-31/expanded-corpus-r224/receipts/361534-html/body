o stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>i</mi></mrow><mo>,</mo><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>j</mi></mrow></mrow></munder><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Z^{\sigma_{\Lambda},i}_{G,v}(A,\boldsymbol{\lambda})=\sum\limits_{\sigma|_{\Lambda}=\sigma_{\Lambda},\sigma(v)=i}w(\sigma)\text{ and }Z^{\sigma_{\Lambda},i,j}_{G,v,u}(A,\boldsymbol{\lambda})=\sum\limits_{\sigma|_{\Lambda}=\sigma_{\Lambda},\sigma(v)=i,\sigma(u)=j}w(\sigma).</annotation></semantics></math></td>
