}(\beta)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>P</mi><mrow><mi>G</mi><mo>,</mo><mi>v</mi></mrow><msub><mi>σ</mi><msub><mi mathvariant="normal">Λ</mi><mn>1</mn></msub></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P_{G,v}^{\sigma_{\Lambda_{1}}}(\beta)</annotation></semantics></math> and <math id="Thmtheorem16.p1.m19" class="ltx_Math" alttext="P_{G,v}^{\tau_{\Lambda_{2}}}(\beta)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>P</mi><mrow><mi>G</mi><mo>,</mo><mi>v</mi></mrow><msub><mi>τ</mi><msub><mi mathvariant="normal">Λ</mi><mn>2</mn></msub></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P_{G,v}^{\tau_{\Lambda_{2}}}(\beta)</annotation></semantics></math> are analytic on <math id="Thmtheorem16.p1.m20" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math>, and their corresponding Taylor series <math id="Thmtheorem16.p1.m21" class="ltx_Math" alttext="\sum^{\infty}_{i=0}a_{i}(\beta-1/\gamma)^{i}" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></msubsup><mrow><msub><mi>a</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>β</mi><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>γ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>i</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\sum^{\infty}_{i=0}a_{i}(\beta-1/\gamma)^{i}</annotation></semantics></math> and <math id="Thmtheorem16.p1.m22" class="ltx_Math" alttext="\sum^{\infty}_{i=0}b_{i}(\beta-1/\gamma)^{i}" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi mathvariant="normal">∞</mi></msubsup><mrow><msub><mi>b</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>β</mi><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>γ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>i</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\sum^{\infty}_{i=0}b_{i}(\beta-1/\gamma)^{i}</annotation></semantics></math> near <math id="Thmtheorem16.p1.m23" class="ltx_Math" alttext="\beta=1/\gamma" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>=</mo><mrow><mn>1</mn><mo>/</mo><mi>γ</mi></mrow></mrow><annotation encoding="application/x-tex">\beta=1/\gamma</annotation></semantics></math> satisfy <math id="Thmtheorem16.p1.m24" class="ltx_Math" alttext="a_{i}=b_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>i</mi></msub><mo>=</mo><msub><mi>b</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">a_{i}=b_{i}</annotation></semantics></math> for <math id="Thmtheorem16.p1.m25" class="ltx_Math" alttext="0\leq i\leq d_{G}(v,\sigma_{\Lambda_{1}}\neq\tau_{\Lambda_{2}})-1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mrow><mrow><msub><mi>d</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mrow><msub><mi>σ</mi><msub><mi mathvariant="normal">Λ</mi><mn>1</mn></msub></msub><mo>≠</mo><msub><mi>τ</mi><msub><mi mathvariant="normal">Λ</mi><mn>2</mn></msub></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">0\leq i\leq d_{G}(v,\sigma_{\Lambda_{1}}\neq\tau_{\Lambda_{2}})-1</annotation></semantics></math>.</span></p>
