 lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo>,</mo><mi>γ</mi><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle Z_{T,u,v}^{\sigma_{\Lambda},+,+}(\beta,\gamma,\lambda)Z_{T,u,v}^{\sigma_{\Lambda},-,-}(\beta,\gamma,\lambda)-Z_{T,u,v}^{\sigma_{\Lambda},+,-}(\beta,\gamma,\lambda)Z_{T,u,v}^{\sigma_{\Lambda},-,+}(\beta,\gamma,\lambda)</annotation></semantics></math></td>
