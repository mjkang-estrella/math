<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex11Xa.m3" class="ltx_Math" alttext="\displaystyle(Z^{-,-}_{G,u,v}+Z^{+,+}_{G,u,v}+Z^{-,+}_{G,u,v}+Z^{+,-}_{G,u,v})Z^{-,-}_{G,u,v}-(Z^{-,-}_{G,u,v}+Z^{-,+}_{G,u,v})(Z^{-,-}_{G,u,v}+Z^{+,-}_{G,u,v})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>v</mi></mrow><mrow><mo rspace="0em">−</mo><mo rspace="0em">,</mo><mo lspace="0em">−</mo></mrow></msubsup><mo>+</mo><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>v</mi></mrow><mrow><mo rspace="0em">+</mo><mo rspace="0em">,</mo><mo lspace="0em">+</mo></mrow></msubsup><mo>+</mo><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>v</mi></mrow><mrow><mo rspace="0em">−</mo><mo rspace="0em">,</mo><mo lspace="0em">+</mo></mrow></msubsup><mo>+</mo><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>v</mi></mrow><mrow><mo rspace="0em">+</mo><mo rspace="0em">,</mo><mo lspace="0em">−</mo></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>v</mi></mrow><mrow><mo rspace="0em">−</mo><mo rspace="0em">,</mo><mo lspace="0em">−</mo></mrow></msubsup></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>v</mi></mrow><mrow><mo rspace="0em">−</mo><mo rspace="0em">,</mo><mo lspace="0em">−</mo></mrow></msubsup><mo>+</mo><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>v</mi></mrow><mrow><mo rspace="0em">−</mo><mo rspace="0em">,</mo><mo lspace="0em">+</mo></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>v</mi></mrow><mrow><mo rspace="0em">−</mo><mo rspace="0em">,</mo><mo lspace="0em">−</mo></mrow></msubsup><mo>+</mo><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>v</mi></mrow><mrow><mo rspace="0em">+</mo><mo rspace="0em">,</mo><mo lspace="0em">−</mo></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle(Z^{-,-}_{G,u,v}+Z^{+,+}_{G,u,v}+Z^{-,+}_{G,u,v}+Z^{+,-}_{G,u,v})Z^{-,-}_{G,u,v}-(Z^{-,-}_{G,u,v}+Z^{-,+}_{G,u,v})(Z^{-,-}_{G,u,v}+Z^{+,-}_{G,u,v})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex11Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
