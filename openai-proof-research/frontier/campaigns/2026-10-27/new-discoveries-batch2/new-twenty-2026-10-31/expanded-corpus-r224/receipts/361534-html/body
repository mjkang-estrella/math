<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex36.m1" class="ltx_Math" alttext="Z_{G}^{\sigma_{\Lambda}}(\beta,\boldsymbol{\lambda})=\beta^{m_{1}+m_{2}}Z_{G\backslash\Lambda}(\beta,\boldsymbol{\lambda}^{\sigma_{\Lambda}})\prod_{w\in\Lambda\atop\sigma_{\Lambda}(w)=+}\lambda_{w}" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>Z</mi><mi>G</mi><msub><mi>σ</mi><mi mathvariant="normal">Λ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo>,</mo><mi>𝝀</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>β</mi><mrow><msub><mi>m</mi><mn>1</mn></msub><mo>+</mo><msub><mi>m</mi><mn>2</mn></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>Z</mi><mrow><mi>G</mi><mo lspace="0.222em" rspace="0.222em">\</mo><mi mathvariant="normal">Λ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>β</mi><mo>,</mo><msup><mi>𝝀</mi><msub><mi>σ</mi><mi mathvariant="normal">Λ</mi></msub></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∏</mo><mfrac linethickness="0pt"><mrow><mi>w</mi><mo>∈</mo><mi mathvariant="normal">Λ</mi></mrow><mrow><mi>σ</mi><msub><mrow></mrow><mi mathvariant="normal">Λ</mi></msub><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo><mo rspace="0em">=</mo><mo lspace="0em">+</mo></mrow></mfrac></munder><msub><mi>λ</mi><mi>w</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">Z_{G}^{\sigma_{\Lambda}}(\beta,\boldsymbol{\lambda})=\beta^{m_{1}+m_{2}}Z_{G\backslash\Lambda}(\beta,\boldsymbol{\lambda}^{\sigma_{\Lambda}})\prod_{w\in\Lambda\atop\sigma_{\Lambda}(w)=+}\lambda_{w}</annotation></semantics></math></td>
