<tbody id="S3.Ex11X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex11X.m2" class="ltx_Math" alttext="\displaystyle Z_{G}Z_{G\setminus\{u,v\}}-Z_{G\setminus\{u\}}Z_{G\setminus\{v\}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>Z</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>Z</mi><mrow><mi>G</mi><mo>∖</mo><mrow><mo stretchy="false">{</mo><mrow><mi>u</mi><mo>,</mo><mi>v</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></msub></mrow><mo>−</mo><mrow><msub><mi>Z</mi><mrow><mi>G</mi><mo>∖</mo><mrow><mo stretchy="false">{</mo><mi>u</mi><mo stretchy="false">}</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>Z</mi><mrow><mi>G</mi><mo>∖</mo><mrow><mo stretchy="false">{</mo><mi>v</mi><mo stretchy="false">}</mo></mrow></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle Z_{G}Z_{G\setminus\{u,v\}}-Z_{G\setminus\{u\}}Z_{G\setminus\{v\}}</annotation></semantics></math></td>
