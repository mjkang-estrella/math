<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex11Xb.m3" class="ltx_Math" alttext="\displaystyle Z_{G,u,v}^{+,+}Z_{G,u,v}^{-,-}-Z_{G,u,v}^{+,-}Z_{G,u,v}^{-,+}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>v</mi></mrow><mrow><mo rspace="0em">+</mo><mo rspace="0em">,</mo><mo lspace="0em">+</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>v</mi></mrow><mrow><mo rspace="0em">−</mo><mo rspace="0em">,</mo><mo lspace="0em">−</mo></mrow></msubsup></mrow><mo>−</mo><mrow><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>v</mi></mrow><mrow><mo rspace="0em">+</mo><mo rspace="0em">,</mo><mo lspace="0em">−</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>v</mi></mrow><mrow><mo rspace="0em">−</mo><mo rspace="0em">,</mo><mo lspace="0em">+</mo></mrow></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle Z_{G,u,v}^{+,+}Z_{G,u,v}^{-,-}-Z_{G,u,v}^{+,-}Z_{G,u,v}^{-,+}.</annotation></semantics></math></td>
