>​</mo><msubsup><mi>Z</mi><mrow><msub><mi>T</mi><mi>s</mi></msub><mo>,</mo><msub><mi>v</mi><mi>s</mi></msub></mrow><mrow><msub><mi>σ</mi><mi mathvariant="normal">Λ</mi></msub><mo>,</mo><mi>k</mi></mrow></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>,</mo><mtext class="ltx_mathvariant_italic">if </mtext><mi>P</mi><mo>∩</mo><mi mathvariant="normal">Λ</mi><mo>=</mo><mi mathvariant="normal">∅</mi></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>0</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>,</mo><mtext class="ltx_mathvariant_italic">if </mtext><mi>P</mi><mo>∩</mo><mi mathvariant="normal">Λ</mi><mo>≠</mo><mi mathvariant="normal">∅</mi></mrow></mtd></mtr></mtable></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\det(Z_{T,u,v}^{\sigma_{\Lambda},i,j})_{1\leq i,j\leq q}=\begin{cases}(\det A)^{d(u,v)}\prod\limits_{i=1}^{q}\lambda_{s}^{d(u,v)+1}\prod\limits_{s=1}^{n}\prod\limits_{t=1}^{q}\left(\sum\limits_{k=1}^{q}a_{t,k}Z_{T_{s},v_{s}}^{\sigma_{\Lambda},k}\right)&amp;,\text{if }P\cap\Lambda=\varnothing\\
