<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex31.m1" class="ltx_Math" alttext="\chi^{\prime}_{\mathrm{irr}}(G)\leq 3+\chi^{\prime}_{\mathrm{irr}}(R)\leq 3+15=18\,." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>χ</mi><mi>irr</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mn>3</mn><mo>+</mo><mrow><msubsup><mi>χ</mi><mi>irr</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mn>3</mn><mo>+</mo><mn>15</mn></mrow><mo>=</mo><mn>18</mn></mrow><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">\chi^{\prime}_{\mathrm{irr}}(G)\leq 3+\chi^{\prime}_{\mathrm{irr}}(R)\leq 3+15=18\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
