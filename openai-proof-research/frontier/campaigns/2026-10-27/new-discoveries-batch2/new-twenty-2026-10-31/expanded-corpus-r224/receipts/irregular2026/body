<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex8.m1" class="ltx_Math" alttext="d_{Q}(v)=q(v)\quad(v\in X),\qquad d_{Q}(y)=d^{-}_{\vec{M}}(y)\quad(y\in Y_{1}\cup Y_{2})\,." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>d</mi><mi>Q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mi>v</mi><mo>∈</mo><mi>X</mi></mrow><mo stretchy="false">)</mo></mrow><mo rspace="2.167em">,</mo><mrow><mrow><msub><mi>d</mi><mi>Q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>d</mi><mover accent="true"><mi>M</mi><mo stretchy="false">→</mo></mover><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>∈</mo><mrow><msub><mi>Y</mi><mn>1</mn></msub><mo>∪</mo><msub><mi>Y</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">d_{Q}(v)=q(v)\quad(v\in X),\qquad d_{Q}(y)=d^{-}_{\vec{M}}(y)\quad(y\in Y_{1}\cup Y_{2})\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
