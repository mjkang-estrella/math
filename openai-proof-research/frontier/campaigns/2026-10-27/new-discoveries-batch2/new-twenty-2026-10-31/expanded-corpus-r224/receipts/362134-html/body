<p id="S5.I2.i2.p1.1" class="ltx_p"><span id="S5.I2.i2.p1.1.1" class="ltx_text ltx_font_italic">Let </span><math id="S5.I2.i2.p1.m1" class="ltx_Math" alttext="g:P\xrightarrow{}Q" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>P</mi><mover accent="true"><mo>→</mo><mphantom></mphantom></mover><mi>Q</mi></mrow></mrow><annotation encoding="application/x-tex">g:P\xrightarrow{}Q</annotation></semantics></math><span id="S5.I2.i2.p1.1.2" class="ltx_text ltx_font_italic"> be a graded </span><math id="S5.I2.i2.p1.m2" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math><span id="S5.I2.i2.p1.1.3" class="ltx_text ltx_font_italic">-module homomorphism. Then
