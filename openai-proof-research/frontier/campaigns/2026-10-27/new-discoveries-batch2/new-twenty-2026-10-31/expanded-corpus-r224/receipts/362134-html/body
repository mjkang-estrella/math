<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(2.2)</span></td></tr></tbody>
</table>
<p id="S2.SS2.p8.2" class="ltx_p">sending <math id="S2.SS2.p8.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>
to <math id="S2.SS2.p8.m2" class="ltx_Math" alttext="M_{0}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mn>0</mn></msub><annotation encoding="application/x-tex">M_{0}</annotation></semantics></math> and <math id="S2.SS2.p8.m3" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> to <math id="S2.SS2.p8.m4" class="ltx_math_unparsed" alttext="\phi_{|_{M_{0}}}" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><msub><mrow></mrow><mrow><mo fence="false" stretchy="false">|</mo><msub><mrow></mrow><msub><mi>M</mi><mn>0</mn></msub></msub></mrow></msub></mrow><annotation encoding="application/x-tex">\phi_{|_{M_{0}}}</annotation></semantics></math> with <math id="S2.SS2.p8.m5" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> a graded <math id="S2.SS2.p8.m6" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>-module and <math id="S2.SS2.p8.m7" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> a graded module homomorphism from <math id="S2.SS2.p8.m8" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, and the <em id="S2.SS2.p8.2.1" class="ltx_emph ltx_font_italic">induction functor</em></p>
<table id="S2.E3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.E3.m1" class="ltx_Math" alttext="\begin{split}R\otimes_{R_{0}}-:R_{0}\text{-}\operatorname{{\bf Mod}}&amp;\longrightarrow R\text{-}\operatorname{{\bf Gr}}\\
N&amp;\longmapsto R\otimes_{R_{0}}N\\
\psi&amp;\longmapsto R\otimes\psi.\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mi>R</mi><mo lspace="0.222em" rspace="0em">⊗</mo><msub><mrow></mrow><msub><mi>R</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">−</mo><mo rspace="0.278em">:</mo><mi>R</mi><msub><mrow></mrow><mn>0</mn></msub><mtext>-</mtext><mi>𝐌𝐨𝐝</mi></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo stretchy="false">⟶</mo><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0.167em" rspace="0em">​</mo><mi>𝐆𝐫</mi></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mi>N</mi></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo stretchy="false">⟼</mo><mrow><mi>R</mi><msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>R</mi><mn>0</mn></msub></msub><mi>N</mi></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mi>ψ</mi></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo stretchy="false">⟼</mo><mrow><mi>R</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>ψ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}R\otimes_{R_{0}}-:R_{0}\text{-}\operatorname{{\bf Mod}}&amp;\longrightarrow R\text{-}\operatorname{{\bf Gr}}\\
N&amp;\longmapsto R\otimes_{R_{0}}N\\
\psi&amp;\longmapsto R\otimes\psi.\end{split}</annotation></semantics></math></td>
