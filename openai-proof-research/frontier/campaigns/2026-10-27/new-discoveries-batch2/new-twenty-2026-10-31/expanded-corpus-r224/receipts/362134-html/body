<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex5.m1" class="ltx_Math" alttext="\mathcal{V}^{\operatorname{gr}}(S)\cong\mathcal{V}^{\operatorname{gr}}(R)/\big\langle[P(\gamma)]=[Q(\gamma)],\gamma\in\Gamma\big\rangle," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>gr</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>gr</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mrow><mo stretchy="false">[</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mi>γ</mi><mo>∈</mo><mi mathvariant="normal">Γ</mi></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{V}^{\operatorname{gr}}(S)\cong\mathcal{V}^{\operatorname{gr}}(R)/\big\langle[P(\gamma)]=[Q(\gamma)],\gamma\in\Gamma\big\rangle,</annotation></semantics></math></td>
