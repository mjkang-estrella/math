<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex1.m1" class="ltx_math_unparsed" alttext="S:=R\big\langle h,h^{-1}:\overline{P}\cong\overline{Q}\big\rangle." display="block" intent=":literal"><semantics><mrow><mi>S</mi><mo>:=</mo><mi>R</mi><mrow><mo stretchy="false">⟨</mo><mi>h</mi><mo>,</mo><msup><mi>h</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mover accent="true"><mi>P</mi><mo stretchy="true">¯</mo></mover><mo>≅</mo><mover accent="true"><mi>Q</mi><mo stretchy="true">¯</mo></mover><mo stretchy="false">⟩</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">S:=R\big\langle h,h^{-1}:\overline{P}\cong\overline{Q}\big\rangle.</annotation></semantics></math></td>
