<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex5.m1" class="ltx_Math" alttext="u=(u_{ij})_{i\in I,j\in J}\in\mathbb{M}_{I\times J}(R)[\overline{\alpha}][\overline{\beta}]." display="block" intent=":literal"><semantics><mrow><mrow><mi>u</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mrow><mi>i</mi><mo>∈</mo><mi>I</mi></mrow><mo>,</mo><mrow><mi>j</mi><mo>∈</mo><mi>J</mi></mrow></mrow></msub><mo>∈</mo><mrow><msub><mi>𝕄</mi><mrow><mi>I</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>J</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>α</mi><mo stretchy="true">¯</mo></mover><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>β</mi><mo stretchy="true">¯</mo></mover><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">u=(u_{ij})_{i\in I,j\in J}\in\mathbb{M}_{I\times J}(R)[\overline{\alpha}][\overline{\beta}].</annotation></semantics></math></td>
