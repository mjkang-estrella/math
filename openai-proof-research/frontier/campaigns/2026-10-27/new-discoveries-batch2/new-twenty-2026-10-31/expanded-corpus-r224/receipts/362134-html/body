<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex2.m1" class="ltx_Math" alttext="\mathcal{V}^{\operatorname{gr}}(R)=\{[P]\mid P\in R\text{-}\operatorname{{\bf Gr}}_{\operatorname{proj}}\}" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>gr</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">[</mo><mi>P</mi><mo stretchy="false">]</mo></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>P</mi><mo>∈</mo><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>𝐆𝐫</mi><mi>proj</mi></msub></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{V}^{\operatorname{gr}}(R)=\{[P]\mid P\in R\text{-}\operatorname{{\bf Gr}}_{\operatorname{proj}}\}</annotation></semantics></math></td>
