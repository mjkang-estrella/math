<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex14.m1" class="ltx_Math" alttext="B^{\prime}(e,f):=R\big\langle h,h^{*}\big\rangle\big/\big\langle hh^{*}=e,h^{*}h=f\big\rangle." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>B</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo>,</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">⟨</mo><mrow><mi>h</mi><mo>,</mo><msup><mi>h</mi><mo>∗</mo></msup></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true" symmetric="true">/</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>h</mi><mo>∗</mo></msup></mrow><mo>=</mo><mi>e</mi></mrow><mo>,</mo><mrow><mrow><msup><mi>h</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo>=</mo><mi>f</mi></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">B^{\prime}(e,f):=R\big\langle h,h^{*}\big\rangle\big/\big\langle hh^{*}=e,h^{*}h=f\big\rangle.</annotation></semantics></math></td>
