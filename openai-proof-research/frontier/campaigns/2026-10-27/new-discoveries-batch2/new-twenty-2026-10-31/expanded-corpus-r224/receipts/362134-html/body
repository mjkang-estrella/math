</mrow></mrow><annotation encoding="application/x-tex">h_{g}\in\mathbb{M}_{m\times n}(R)[\overline{\beta}][\overline{\gamma}]</annotation></semantics></math>, where <math id="S5.SS3.p4.m7" class="ltx_Math" alttext="\overline{\beta}=(\beta_{1},\dots,\beta_{n})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>β</mi><mo stretchy="true">¯</mo></mover><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>β</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>β</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\overline{\beta}=(\beta_{1},\dots,\beta_{n})</annotation></semantics></math> and <math id="S5.SS3.p4.m8" class="ltx_Math" alttext="\overline{\gamma}=(\gamma_{1},\dots,\gamma_{m})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>γ</mi><mo stretchy="true">¯</mo></mover><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>γ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>γ</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\overline{\gamma}=(\gamma_{1},\dots,\gamma_{m})</annotation></semantics></math> (see( <a href="#S2.E8" title="In 2.3. Matrix form of graded homomorphisms ‣ 2. Γ-monoids and graded algebras ‣ Bergman algebrasThe graded universal algebra constructions" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.8</span></a>)).
