<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex4.m2" class="ltx_Math" alttext="\displaystyle:=R\big\langle h,h^{*}\big\rangle\big/\big\langle ehf=h,fh^{*}e=h^{*},hh^{*}=e\big\rangle" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">⟨</mo><mrow><mi>h</mi><mo>,</mo><msup><mi>h</mi><mo>∗</mo></msup></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true" symmetric="true">/</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mo>=</mo><mi>h</mi></mrow><mo>,</mo><mrow><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>h</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mo>=</mo><msup><mi>h</mi><mo>∗</mo></msup></mrow><mo>,</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>h</mi><mo>∗</mo></msup></mrow><mo>=</mo><mi>e</mi></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle:=R\big\langle h,h^{*}\big\rangle\big/\big\langle ehf=h,fh^{*}e=h^{*},hh^{*}=e\big\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmthm1.p1.3" class="ltx_p">and</p>
<table id="S4.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E1.m1" class="ltx_Math" alttext="\displaystyle B_{R}(e,f)=B^{4}_{R}(e,f)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>B</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo>,</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>B</mi><mi>R</mi><mn>4</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo>,</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle B_{R}(e,f)=B^{4}_{R}(e,f)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E1.m2" class="ltx_Math" alttext="\displaystyle:=R\big\langle h,h^{*}\big\rangle\big/\big\langle ehf=h,fh^{*}e=h^{*},hh^{*}=e,h^{*}h=f\big\rangle." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">⟨</mo><mrow><mi>h</mi><mo>,</mo><msup><mi>h</mi><mo>∗</mo></msup></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true" symmetric="true">/</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mo>=</mo><mi>h</mi></mrow><mo>,</mo><mrow><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>h</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mo>=</mo><msup><mi>h</mi><mo>∗</mo></msup></mrow><mo>,</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>h</mi><mo>∗</mo></msup></mrow><mo>=</mo><mi>e</mi></mrow><mo>,</mo><mrow><mrow><msup><mi>h</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo>=</mo><mi>f</mi></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=R\big\langle h,h^{*}\big\rangle\big/\big\langle ehf=h,fh^{*}e=h^{*},hh^{*}=e,h^{*}h=f\big\rangle.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.1)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.p2" class="ltx_para">
<p id="S4.p2.1" class="ltx_p">We further define,</p>
<table id="S4.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex5.m1" class="ltx_Math" alttext="B_{R}(e)=R\big\langle h\big\rangle\big/\big\langle ehe=h,h^{2}=h\big\rangle." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>B</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">⟨</mo><mi>h</mi><mo stretchy="false">⟩</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true" symmetric="true">/</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mo>=</mo><mi>h</mi></mrow><mo>,</mo><mrow><msup><mi>h</mi><mn>2</mn></msup><mo>=</mo><mi>h</mi></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">B_{R}(e)=R\big\langle h\big\rangle\big/\big\langle ehe=h,h^{2}=h\big\rangle.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.p3" class="ltx_para">
<p id="S4.p3.1" class="ltx_p">Here <math id="S4.p3.m1" class="ltx_Math" alttext="R\langle h,h^{*}\rangle" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><mi>h</mi><mo>,</mo><msup><mi>h</mi><mo>∗</mo></msup></mrow><mo stretchy="false">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">R\langle h,h^{*}\rangle</annotation></semantics></math> is the free ring generated by symbols <math id="S4.p3.m2" class="ltx_Math" alttext="h_{ij}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">h_{ij}</annotation></semantics></math> and <math id="S4.p3.m3" class="ltx_Math" alttext="h^{*}_{ji}" display="inline" intent=":literal"><semantics><msubsup><mi>h</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>∗</mo></msubsup><annotation encoding="application/x-tex">h^{*}_{ji}</annotation></semantics></math>’s with coefficients from the <math id="S4.p3.m4" class="ltx_Math" alttext="\mathsf{k}" display="inline" intent=":literal"><semantics><mi>𝗄</mi><annotation encoding="application/x-tex">\mathsf{k}</annotation></semantics></math>-algebra <math id="S4.p3.m5" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>. We assume the symbols commute with <math id="S4.p3.m6" class="ltx_Math" alttext="\mathsf{k}" display="inline" intent=":literal"><semantics><mi>𝗄</mi><annotation encoding="application/x-tex">\mathsf{k}</annotation></semantics></math>. In fact <math id="S4.p3.m7" class="ltx_Math" alttext="R\langle h,h^{*}\rangle" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><mi>h</mi><mo>,</mo><msup><mi>h</mi><mo>∗</mo></msup></mrow><mo stretchy="false">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">R\langle h,h^{*}\rangle</annotation></semantics></math> is
the coproduct <math id="S4.p3.m8" class="ltx_math_unparsed" alttext="R*_{\mathsf{k}}\mathsf{k}\langle h_{ij},h^{*}_{ji}\mid 1\leq i\leq m,1\leq j\leq n\rangle" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><msub><mo lspace="0.222em" rspace="0.222em">∗</mo><mi>𝗄</mi></msub><mi>𝗄</mi><mrow><mo stretchy="false">⟨</mo><msub><mi>h</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>,</mo><msubsup><mi>h</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>∗</mo></msubsup><mo lspace="0em" rspace="0.167em">∣</mo><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>m</mi><mo>,</mo><mn>1</mn><mo>≤</mo><mi>j</mi><mo>≤</mo><mi>n</mi><mo stretchy="false">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">R*_{\mathsf{k}}\mathsf{k}\langle h_{ij},h^{*}_{ji}\mid 1\leq i\leq m,1\leq j\leq n\rangle</annotation></semantics></math>. Furthermore, the relations such as <math id="S4.p3.m9" class="ltx_Math" alttext="ehf=h" display="inline" intent=":literal"><semantics><mrow><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mo>=</mo><mi>h</mi></mrow><annotation encoding="application/x-tex">ehf=h</annotation></semantics></math> stand for the collection of relations after multiplying the matrices and comparing the two sides of the equation. Clearly there is a canonical <math id="S4.p3.m10" class="ltx_Math" alttext="\mathsf{k}" display="inline" intent=":literal"><semantics><mi>𝗄</mi><annotation encoding="application/x-tex">\mathsf{k}</annotation></semantics></math>-algebra homomorphim <math id="S4.p3.m11" class="ltx_Math" alttext="R\rightarrow B_{R}^{i}(e,f)" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo stretchy="false">→</mo><mrow><msubsup><mi>B</mi><mi>R</mi><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo>,</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">R\rightarrow B_{R}^{i}(e,f)</annotation></semantics></math>, where the images of <math id="S4.p3.m12" class="ltx_Math" alttext="e" display="inline" intent=":literal"><semantics><mi>e</mi><annotation encoding="application/x-tex">e</annotation></semantics></math> and <math id="S4.p3.m13" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> in <math id="S4.p3.m14" class="ltx_Math" alttext="B_{R}(e,f)" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo>,</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B_{R}(e,f)</annotation></semantics></math> become equivalent.</p>
</div>
<div id="S4.p4" class="ltx_para">
<p id="S4.p4.1" class="ltx_p">In this note, we particularly concentrate on the Bergman algebra <math id="S4.p4.m1" class="ltx_Math" alttext="B_{R}(e,f)" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo>,</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B_{R}(e,f)</annotation></semantics></math> defined in (<a href="#S4.Thmthm1" title="Definition 4.1. ‣ 4. Bergman algebras ‣ Bergman algebrasThe graded universal algebra constructions" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>), as many of combinatorial algebras can be realised as such Bergman algebras.</p>
</div>
<div id="S4.Thmthm2" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmthm2.2" class="ltx_text ltx_font_bold">Example 4.2</span></span><span id="S4.Thmthm2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmthm2.p1" class="ltx_para">
<p id="S4.Thmthm2.p1.1" class="ltx_p">We can recover classical Cohn and Leavitt algebras (<a href="#S3.E3" title="In 3. Leavitt path algebras ‣ Bergman algebrasThe graded universal algebra constructions" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a>) and (<a href="#S3.E2" title="In 3. Leavitt path algebras ‣ Bergman algebrasThe graded universal algebra constructions" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a>), respectively, as follows. For a field <math id="S4.Thmthm2.p1.m1" class="ltx_Math" alttext="\mathsf{k}" display="inline" intent=":literal"><semantics><mi>𝗄</mi><annotation encoding="application/x-tex">\mathsf{k}</annotation></semantics></math>, and idempotent matrices <math id="S4.Thmthm2.p1.m2" class="ltx_Math" alttext="1\in\mathsf{k}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>∈</mo><mi>𝗄</mi></mrow><annotation encoding="application/x-tex">1\in\mathsf{k}</annotation></semantics></math> and <math id="S4.Thmthm2.p1.m3" class="ltx_Math" alttext="I_{n}\in\mathbb{M}_{n}(\mathsf{k})" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><mi>n</mi></msub><mo>∈</mo><mrow><msub><mi>𝕄</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝗄</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">I_{n}\in\mathbb{M}_{n}(\mathsf{k})</annotation></semantics></math>, we have</p>
<table id="S4.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
