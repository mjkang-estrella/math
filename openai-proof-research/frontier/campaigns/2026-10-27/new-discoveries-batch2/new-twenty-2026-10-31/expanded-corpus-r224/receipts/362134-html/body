verflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="42.05"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S9.Ex8.m1.pic1.m4" class="ltx_Math" alttext="\textstyle{\mathcal{V}^{\operatorname{gr}}(A)}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>gr</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{\mathcal{V}^{\operatorname{gr}}(A)}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(58.5,0) translate(0,-44.28) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:4.94em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="68.29"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S9.Ex8.m1.pic1.m6" class="ltx_Math" alttext="\textstyle{\mathcal{V}^{\operatorname{gr}}(L_{\mathsf{k}}(E))\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>gr</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>𝗄</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textstyle{\mathcal{V}^{\operatorname{gr}}(L_{\mathsf{k}}(E))\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 120.96961900144424 -33.208800332088 L 120.96961900144424 -33.208800332088" fill="none" stroke="#000000"></path><g transform="translate(125,0) translate(0,-31.79) translate(4.15,0) translate(0,-1.23)"><foreignObject style="--ltx-fo-width:4.76em;--ltx-fo-height:0.49em;--ltx-fo-depth:0.31em;font-size:10pt;" height="11" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="65.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S9.Ex8.m1.pic1.m7" class="ltx_math_unparsed" alttext="\scriptstyle{\;\phi=A\otimes_{L_{\mathsf{k}}(E)}-}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.700em">ϕ</mi><mo mathsize="0.700em">=</mo><mi mathsize="0.700em">A</mi><mo lspace="0.222em" mathsize="0.700em" rspace="0em">⊗</mo><msub><mrow></mrow><mrow><msub><mi mathsize="0.710em">L</mi><mi>𝗄</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.710em" minsize="0.710em">(</mo><mi mathsize="0.710em">E</mi><mo maxsize="0.710em" minsize="0.710em">)</mo></mrow></mrow></msub><mo lspace="0em" mathsize="0.700em">−</mo></mrow><annotation encoding="application/x-tex">\scriptstyle{\;\phi=A\otimes_{L_{\mathsf{k}}(E)}-}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(169.31,0) translate(0,-11.07)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -7.44 -0.36" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -5.14 -5.4" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 120.96961900144424 -33.208800332088 L 169.30700090724238 -11.069600110696001" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 169.30700090724238 -11.069600110696001 L 169.30700090724238 -11.069600110696001" fill="none" stroke="#000000"></path></g></svg></span></td>
