<mrow><mi>e</mi><mo>∈</mo><mrow><msub><mi>𝕄</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>β</mi><mo stretchy="true">¯</mo></mover><mo stretchy="false">)</mo></mrow><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">e\in\mathbb{M}_{n}(R)(\overline{\beta})_{0}</annotation></semantics></math><span id="S5.I2.i1.p1.1.10" class="ltx_text ltx_font_italic"> and </span><math id="S5.I2.i1.p1.m10" class="ltx_Math" alttext="f\in\mathbb{M}_{m}(R)(\overline{\gamma})_{0}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><mrow><msub><mi>𝕄</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>γ</mi><mo stretchy="true">¯</mo></mover><mo stretchy="false">)</mo></mrow><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">f\in\mathbb{M}_{m}(R)(\overline{\gamma})_{0}</annotation></semantics></math><span id="S5.I2.i1.p1.1.11" class="ltx_text ltx_font_italic">, where </span><math id="S5.I2.i1.p1.m11" class="ltx_Math" alttext="\overline{\beta}=(\beta_{1},\dots,\beta_{n})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>β</mi><mo stretchy="true">¯</mo></mover><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>β</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>β</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\overline{\beta}=(\beta_{1},\dots,\beta_{n})</annotation></semantics></math><span id="S5.I2.i1.p1.1.12" class="ltx_text ltx_font_italic"> and </span><math id="S5.I2.i1.p1.m12" class="ltx_Math" alttext="\overline{\gamma}=(\gamma_{1},\dots,\gamma_{m})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>γ</mi><mo stretchy="true">¯</mo></mover><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>γ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>γ</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\overline{\gamma}=(\gamma_{1},\dots,\gamma_{m})</annotation></semantics></math><span id="S5.I2.i1.p1.1.13" class="ltx_text ltx_font_italic">. Moreover, there is a graded </span><math id="S5.I2.i1.p1.m13" class="ltx_Math" alttext="\mathsf{k}" display="inline" intent=":literal"><semantics><mi>𝗄</mi><annotation encoding="application/x-tex">\mathsf{k}</annotation></semantics></math><span id="S5.I2.i1.p1.1.14" class="ltx_text ltx_font_italic">-algebra homomorphism </span><math id="S5.I2.i1.p1.m14" class="ltx_Math" alttext="R\xrightarrow{}R\langle\overline{P}\xrightarrow{}\overline{Q}\rangle" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mover accent="true"><mo>→</mo><mphantom></mphantom></mover><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><mover accent="true"><mi>P</mi><mo stretchy="true">¯</mo></mover><mover accent="true"><mo>→</mo><mphantom></mphantom></mover><mover accent="true"><mi>Q</mi><mo stretchy="true">¯</mo></mover></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">R\xrightarrow{}R\langle\overline{P}\xrightarrow{}\overline{Q}\rangle</annotation></semantics></math><span id="S5.I2.i1.p1.1.15" class="ltx_text ltx_font_italic"> sending </span><math id="S5.I2.i1.p1.m15" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math><span id="S5.I2.i1.p1.1.16" class="ltx_text ltx_font_italic"> to </span><math id="S5.I2.i1.p1.m16" class="ltx_Math" alttext="\overline{r}" display="inline" intent=":literal"><semantic