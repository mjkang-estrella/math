R_{\gamma+\alpha_{1}-\alpha_{n}}&amp;R_{\gamma+\alpha_{2}-\alpha_{n}}&amp;\cdots&amp;R_{\gamma+\alpha_{n}-\alpha_{n}}\end{pmatrix}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝕄</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>α</mi><mo stretchy="true">¯</mo></mover><mo stretchy="false">)</mo></mrow><mi>γ</mi></msub></mrow><mo>=</mo><mrow><mo>(</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mi>R</mi><mrow><mrow><mi>γ</mi><mo>+</mo><msub><mi>α</mi><mn>1</mn></msub></mrow><mo>−</mo><msub><mi>α</mi><mn>1</mn></msub></mrow></msub></mtd><mtd><msub><mi>R</mi><mrow><mrow><mi>γ</mi><mo>+</mo><msub><mi>α</mi><mn>2</mn></msub></mrow><mo>−</mo><msub><mi>α</mi><mn>1</mn></msub></mrow></msub></mtd><mtd><mo>⋯</mo></mtd><mtd><msub><mi>R</mi><mrow><mrow><mi>γ</mi><mo>+</mo><msub><mi>α</mi><mi>n</mi></msub></mrow><mo>−</mo><msub><mi>α</mi><mn>1</mn></msub></mrow></msub></mtd></mtr><mtr><mtd><msub><mi>R</mi><mrow><mrow><mi>γ</mi><mo>+</mo><msub><mi>α</mi><mn>1</mn></msub></mrow><mo>−</mo><msub><mi>α</mi><mn>2</mn></msub></mrow></msub></mtd><mtd><msub><mi>R</mi><mrow><mrow><mi>γ</mi><mo>+</mo><msub><mi>α</mi><mn>2</mn></msub></mrow><mo>−</mo><msub><mi>α</mi><mn>2</mn></msub></mrow></msub></mtd><mtd><mo>⋯</mo></mtd><mtd><msub><mi>R</mi><mrow><mrow><mi>γ</mi><mo>+</mo><msub><mi>α</mi><mi>n</mi></msub></mrow><mo>−</mo><msub><mi>α</mi><mn>2</mn></msub></mrow></msub></mtd></mtr><mtr><mtd></mtd><mtd></mtd><mtd><mi mathvariant="normal">⋱</mi></mtd><mtd></mtd></mtr><mtr><mtd><msub><mi>R</mi><mrow><mrow><mi>γ</mi><mo>+</mo><msub><mi>α</mi><mn>1</mn></msub></mrow><mo>−</mo><msub><mi>α</mi><mi>n</mi></msub></mrow></msub></mtd><mtd><msub><mi>R</mi><mrow><mrow><mi>γ</mi><mo>+</mo><msub><mi>α</mi><mn>2</mn></msub></mrow><mo>−</mo><msub><mi>α</mi><mi>n</mi></msub></mrow></msub></mtd><mtd><mo>⋯</mo></mtd><mtd><msub><mi>R</mi><mrow><mrow><mi>γ</mi><mo>+</mo><msub><mi>α</mi><mi>n</mi></msub></mrow><mo>−</mo><msub><mi>α</mi><mi>n</mi></msub></mrow></msub></mtd></mtr></mtable><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{M}_{n}(R)(\overline{\alpha})_{\gamma}={\begin{pmatrix}R_{\gamma+\alpha_{1}-\alpha_{1}}&amp;R_{\gamma+\alpha_{2}-\alpha_{1}}&amp;\cdots&amp;R_{\gamma+\alpha_{n}-\alpha_{1}}\\
