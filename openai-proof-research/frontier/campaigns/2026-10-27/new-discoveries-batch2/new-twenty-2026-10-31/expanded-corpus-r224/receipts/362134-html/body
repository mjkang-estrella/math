<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E7.m1" class="ltx_Math" alttext="\begin{split}R\langle f:\overline{M}\longrightarrow\overline{P}\rangle&amp;\cong R\langle h\rangle/\langle u_{0}h=0=h(1-e_{0})\rangle\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mi>R</mi><mo stretchy="false">⟨</mo><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mover accent="true"><mi>M</mi><mo stretchy="true">¯</mo></mover><mo stretchy="false">⟶</mo><mover accent="true"><mi>P</mi><mo stretchy="true">¯</mo></mover><mo stretchy="false">⟩</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>≅</mo><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">⟨</mo><mi>h</mi><mo stretchy="false">⟩</mo></mrow></mrow><mo>/</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>u</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo>=</mo><mn>0</mn><mo>=</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>e</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}R\langle f:\overline{M}\longrightarrow\overline{P}\rangle&amp;\cong R\langle h\rangle/\langle u_{0}h=0=h(1-e_{0})\rangle\end{split}</annotation></semantics></math></td>
