=\sum_{k=1}^{n}s^{\prime}\phi(m^{\prime}_{k})\otimes\alpha_{k}=\sum_{k=1}^{n}s^{\prime}\otimes m^{\prime}_{k}\alpha_{k}=s^{\prime}\otimes\sum_{k=1}^{n}m^{\prime}_{k}\alpha_{k}s^{\prime}\otimes m^{\prime}." display="block" intent=":literal"><semantics><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>s</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>m</mi></mrow><mo>=</mo><mrow><mi>s</mi><mo lspace="0.222em" rspace="0.055em">⊗</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msub><mi>m</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>k</mi></msub></mrow></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mi>s</mi></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>m</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>k</mi></msub></mrow><mo rspace="0.111em">=</mo><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mi>k</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⊗</mo><msub><mi>α</mi><mi>k</mi></msub></mrow><mo>=</mo><mphantom></mphantom></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mphantom></mphantom><mo rspace="0.111em">=</mo><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msup><mi>s</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>ϕ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>m</mi><mi>k</mi><mo>′</mo></msubsup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⊗</mo><msub><mi>α</mi><mi>k</mi></msub></mrow><mo rspace="0.111em">=</mo><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><msup><mi>s</mi><mo>′</mo></msup></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><msubsup><mi>m</mi><mi>k</mi><mo>′</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>k</mi></msub></mrow><mo>=</mo><mrow><msup><mi>s</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.055em">⊗</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msubsup><mi>m</mi><mi>k</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>s</mi><mo>′</mo></msup></mrow></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mi>m</mi><mo>′</mo></msup></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">s\otimes m=s\otimes\sum_{k=1}^{n}m_{k}\alpha_{k}=\sum_{k=1}^{n}s\otimes m_{k}\alpha_{k}=\sum_{k=1}^{n}s\phi(m_{k})\otimes\alpha_{k}=\\
=\sum_{k=1}^{n}s^{\prime}\phi(m^{\prime}_{k})\otimes\alpha_{k}=\sum_{k=1}^{n}s^{\prime}\otimes m^{\prime}_{k}\alpha_{k}=s^{\prime}\otimes\sum_{k=1}^{n}m^{\prime}_{k}\alpha_{k}s^{\prime}\otimes m^{\prime}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.p8.3" class="ltx_p"><span id="S7.SS1.p8.3.1" class="ltx_text">Hence <math id="S7.SS1.p8.m8" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math> is injective. We leave it to the reader to show that <math id="S7.SS1.p8.m9" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math> preserves the action of <math id="S7.SS1.p8.m10" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>.
∎</span></p>
