</table>
<p id="S8.p3.2" class="ltx_p"><span id="S8.p3.2.1" class="ltx_text">for any <math id="S8.p3.m6" class="ltx_Math" alttext="\phi\in A" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>∈</mo><mi>A</mi></mrow><annotation encoding="application/x-tex">\phi\in A</annotation></semantics></math>. Then</span></p>
<table id="S8.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S8.Ex3.m1" class="ltx_math_unparsed" alttext="\mathcal{V}^{\operatorname{gr}}(R^{\prime}_{(A,B)})=\Big\langle I,P_{\phi},Q_{\phi}~(\phi\in A)\mid P_{\phi}+Q_{\phi}=\sum_{k=1}^{n_{\phi}}{}^{\gamma_{\phi,k}}I~(\phi\in A)\Big\rangle," display="block" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>gr</mi></msup><mrow><mo stretchy="false">(</mo><msubsup><mi>R</mi><mrow><mo stretchy="false">(</mo><mi>A</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">⟨</mo><mi>I</mi><mo>,</mo><msub><mi>P</mi><mi>ϕ</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>ϕ</mi></msub><mrow><mo stretchy="false">(</mo><mi>ϕ</mi><mo>∈</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>P</mi><mi>ϕ</mi></msub><mo>+</mo><msub><mi>Q</mi><mi>ϕ</mi></msub><mo rspace="0.111em">=</mo><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>n</mi><mi>ϕ</mi></msub></munderover><mmultiscripts><mi>I</mi><mprescripts></mprescripts><mrow></mrow><msub><mi>γ</mi><mrow><mi>ϕ</mi><mo>,</mo><mi>k</mi></mrow></msub></mmultiscripts><mrow><mo lspace="0.330em" stretchy="false">(</mo><mi>ϕ</mi><mo>∈</mo><mi>A</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">⟩</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{V}^{\operatorname{gr}}(R^{\prime}_{(A,B)})=\Big\langle I,P_{\phi},Q_{\phi}~(\phi\in A)\mid P_{\phi}+Q_{\phi}=\sum_{k=1}^{n_{\phi}}{}^{\gamma_{\phi,k}}I~(\phi\in A)\Big\rangle,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S8.p3.3" class="ltx_p"><span id="S8.p3.3.1" class="ltx_text">by Corollary <a href="#S7.Thmthm9" title="Corollary 7.9. ‣ 7.3. The graded 𝒱-monoid of a graded Bergman algebra II ‣ 7. The graded 𝒱-monoid of a graded Bergman algebra ‣ Bergman algebrasThe graded universal algebra constructions" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.9</span></a>. Let <math id="S8.p3.m7" class="ltx_Math" alttext="R_{(A,B)}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mrow><mo stretchy="false">(</mo><mi>A</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">R_{(A,B)}</annotation></semantics></math> be the <math id="S8.p3.m8" class="ltx_Math" alttext="\Gamma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Γ</mi><annotation encoding="application/x-tex">\Gamma</annotation></semantics></math>-graded <math id="S8.p3.m9" class="ltx_Math" alttext="\mathsf{k}" display="inline" intent=":literal"><semantics><mi>𝗄</mi><annotation encoding="application/x-tex">\mathsf{k}</annotation></semantics></math>-algebra obtained from <math id="S8.p3.m10" class="ltx_Math" alttext="R^{\prime}_{(A,B)}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mrow><mo stretchy="false">(</mo><mi>A</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">R^{\prime}_{(A,B)}</annotation></semantics></math> by adjoining isomorphisms <math id="S8.p3.m11" class="ltx_Math" alttext="\overline{U_{\psi}}\cong\overline{V_{\psi}}~(\psi\in B)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><msub><mi>U</mi><mi>ψ</mi></msub><mo stretchy="true">¯</mo></mover><mo>≅</mo><mrow><mover accent="true"><msub><mi>V</mi><mi>ψ</mi></msub><mo stretchy="true">¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ψ</mi><mo>∈</mo><mi>B</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\overline{U_{\psi}}\cong\overline{V_{\psi}}~(\psi\in B)</annotation></semantics></math>, where <math id="S8.p3.m12" class="ltx_Math" alttext="U_{\psi}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mi>ψ</mi></msub><annotation encoding="application/x-tex">U_{\psi}</annotation></semantics></math> and <math id="S8.p3.m13" class="ltx_Math" alttext="V_{\psi}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>ψ</mi></msub><annotation encoding="application/x-tex">V_{\psi}</annotation></semantics></math> are the graded <math id="S8.p3.m14" class="ltx_Math" alttext="R^{\prime}_{(A,B)}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mrow><mo stretchy="false">(</mo><mi>A</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow><mo>′</mo></msubsup><annotation encoding="application/x-tex">R^{\prime}_{(A,B)}</annotation></semantics></math>-modules corresponding to <math id="S8.p3.m15" class="ltx_Math" alttext="u_{\psi}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mi>ψ</mi></msub><annotation encoding="application/x-tex">u_{\psi}</annotation></semantics></math> and <math id="S8.p3.m16" class="ltx_Math" alttext="v_{\psi}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>ψ</mi></msub><annotation encoding="application/x-tex">v_{\psi}</annotation></semantics></math>, respectively. Then <math id="S8.p3.m17" class="ltx_Math" alttext="\mathcal{V}^{\operatorname{gr}}(R_{(A,B)})\cong M_{(A,B)}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>gr</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>R</mi><mrow><mo stretchy="false">(</mo><mi>A</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><msub><mi>M</mi><mrow><mo stretchy="false">(</mo><mi>A</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></msub></mrow><annotation encoding="application/x-tex">\mathcal{V}^{\operatorname{gr}}(R_{(A,B)})\cong M_{(A,B)}</annotation></semantics></math> by Corollary <a href="#S7.Thmthm6" title="Corollary 7.6. ‣ 7.2. The graded 𝒱-monoid of a graded Bergman algebra I ‣ 7. The graded 𝒱-monoid of a graded Bergman algebra ‣ Bergman algebrasThe graded universal algebra constructions" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.6</span></a>, and this isomorphism maps <math id="S8.p3.m18" class="ltx_Math" alttext="[R_{(A,B)}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mi>R</mi><mrow><mo stretchy="false">(</mo><mi>A</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[R_{(A,B)}]</annotation></semantics></math> to <math id="S8.p3.m19" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>.</span></p>
</div>
<div id="S8.p4" class="ltx_para">
<p id="S8.p4.1" class="ltx_p"><span id="S8.p4.1.1" class="ltx_text">If <math id="S8.p4.m1" class="ltx_Math" alttext="(A,B)\leq(A^{\prime},B^{\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>A</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow><mo>≤</mo><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mo>′</mo></msup><mo>,</mo><msup><mi>B</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(A,B)\leq(A^{\prime},B^{\prime})</annotation></semantics></math>, then clearly there is a canonical graded <math id="S8.p4.m2" class="ltx_Math" alttext="\mathsf{k}" display="inline" intent=":literal"><semantics><mi>𝗄</mi><annotation encoding="application/x-tex">\mathsf{k}</annotation></semantics></math>-algebra homomorphism <math id="S8.p4.m3" class="ltx_Math" alttext="\beta_{(A,B)}^{(A^{\prime},B^{\prime})}:R_{(A,B)}\to R_{(A^{\prime},B^{\prime})}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>β</mi><mrow><mo stretchy="false">(</mo><mi>A</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mo>′</mo></msup><mo>,</mo><msup><mi>B</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>R</mi><mrow><mo stretchy="false">(</mo><mi>A</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">→</mo><msub><mi>R</mi><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mo>′</mo></msup><mo>,</mo><msup><mi>B</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\beta_{(A,B)}^{(A^{\prime},B^{\prime})}:R_{(A,B)}\to R_{(A^{\prime},B^{\prime})}</annotation></semantics></math>. Let <math id="S8.p4.m4" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> be the direct limit of the direct system <math id="S8.p4.m5" class="ltx_math_unparsed" alttext="\big\{R_{(A,B)},\beta_{(A,B)}^{(A^{\prime},B^{\prime})}\mid(A,B)\leq(A^{\prime},B^{\prime})\in Z\big\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>R</mi><mrow><mo stretchy="false">(</mo><mi>A</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></msub><mo>,</mo><msubsup><mi>β</mi><mrow><mo stretchy="false">(</mo><mi>A</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mo>′</mo></msup><mo>,</mo><msup><mi>B</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0.167em">∣</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow><mo>≤</mo><mrow><mo stretchy="false">(</mo><msup><mi>A</mi><mo>′</mo></msup><mo>,</mo><msup><mi>B</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>Z</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\big\{R_{(A,B)},\beta_{(A,B)}^{(A^{\prime},B^{\prime})}\mid(A,B)\leq(A^{\prime},B^{\prime})\in Z\big\}</annotation></semantics></math> in the category of graded <math id="S8.p4.m6" class="ltx_Math" alttext="\mathsf{k}" display="inline" intent=":literal"><semantics><mi>𝗄</mi><annotation encoding="application/x-tex">\mathsf{k}</annotation></semantics></math>-algebras. Since <math id="S8.p4.m7" class="ltx_Math" alttext="\mathcal{V}^{\operatorname{gr}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>gr</mi></msup><annotation encoding="application/x-tex">\mathcal{V}^{\operatorname{gr}}</annotation></semantics></math> commutes with direct limits, we obtain</span></p>
<table id="S8.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S8.Ex4.m1" class="ltx_Math" alttext="\mathcal{V}^{\operatorname{gr}}(R)=\mathcal{V}^{\operatorname{gr}}(\varinjlim R_{(A,B)})=\varinjlim\mathcal{V}^{\operatorname{gr}}(R_{(A,B)})\cong\varinjlim M_{(A,B)}=M." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>gr</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>gr</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><munder accentunder="true"><mi>lim</mi><mo>→</mo></munder><mo lspace="0.167em">⁡</mo><msub><mi>R</mi><mrow><mo stretchy="false">(</mo><mi>A</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><munder accentunder="true"><mi>lim</mi><mo>→</mo></munder><mo lspace="0.167em">⁡</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>gr</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>R</mi><mrow><mo stretchy="false">(</mo><mi>A</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≅</mo><mrow><munder accentunder="true"><mi>lim</mi><mo>→</mo></munder><mo lspace="0.167em">⁡</mo><msub><mi>M</mi><mrow><mo stretchy="false">(</mo><mi>A</mi><mo>,</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></msub></mrow><mo>=</mo><mi>M</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{V}^{\operatorname{gr}}(R)=\mathcal{V}^{\operatorname{gr}}(\varinjlim R_{(A,B)})=\varinjlim\mathcal{V}^{\operatorname{gr}}(R_{(A,B)})\cong\varinjlim M_{(A,B)}=M.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S8.p4.2" class="ltx_p"><span id="S8.p4.2.1" class="ltx_text">Clearly the isomorphism <math id="S8.p4.m8" class="ltx_Math" alttext="\mathcal{V}^{\operatorname{gr}}(R)\cong M" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>gr</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\mathcal{V}^{\operatorname{gr}}(R)\cong M</annotation></semantics></math> maps <math id="S8.p4.m9" class="ltx_Math" alttext="[R]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mi>R</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[R]</annotation></semantics></math> to <math id="S8.p4.m10" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>.</span></p>
</div>
<div id="S8.p5" class="ltx_para">
<p id="S8.p5.1" class="ltx_p"><span id="S8.p5.1.1" class="ltx_text">It remains to show that <math id="S8.p5.m1" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> is hereditary. We closely follow the approach used in Theorem 3.7 in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib4" title="" class="ltx_ref">4</a>]</cite>. Choose an ordinal <math id="S8.p5.m2" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> and a bijection <math id="S8.p5.m3" class="ltx_Math" alttext="\alpha\to\phi_{\alpha}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo stretchy="false">→</mo><msub><mi>ϕ</mi><mi>α</mi></msub></mrow><annotation encoding="application/x-tex">\alpha\to\phi_{\alpha}</annotation></semantics></math> from <math id="S8.p5.m4" class="ltx_Math" alttext="[0,\lambda)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">[0,\lambda)</annotation></semantics></math> to <math id="S8.p5.m5" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math>. We build graded <math id="S8.p5.m6" class="ltx_Math" alttext="\mathsf{k}" display="inline" intent=":literal"><semantics><mi>𝗄</mi><annotation encoding="application/x-tex">\mathsf{k}</annotation></semantics></math>-algebras <math id="S8.p5.m7" class="ltx_Math" alttext="R_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>α</mi></msub><annotation encoding="application/x-tex">R_{\alpha}</annotation></semantics></math> for <math id="S8.p5.m8" class="ltx_Math" alttext="\alpha\in[0,\lambda)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha\in[0,\lambda)</annotation></semantics></math> as follows.</span></p>
<ol id="S8.I3" class="ltx_enumerate">
<li id="S8.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(a)</span> 
<div id="S8.I3.i1.p1" class="ltx_para">
<p id="S8.I3.i1.p1.1" class="ltx_p">Start with <math id="S8.I3.i1.p1.m1" class="ltx_Math" alttext="R_{0}=\mathsf{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mn>0</mn></msub><mo>=</mo><mi>𝗄</mi></mrow><annotation encoding="application/x-tex">R_{0}=\mathsf{k}</annotation></semantics></math>.</p>
</div></li>
<li id="S8.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(b)</span> 
<div id="S8.I3.i2.p1" class="ltx_para">
<p id="S8.I3.i2.p1.1" class="ltx_p">For <math id="S8.I3.i2.p1.m1" class="ltx_Math" alttext="\alpha\in[0,\lambda)" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha\in[0,\lambda)</annotation></semantics></math>, let <math id="S8.I3.i2.p1.m2" class="ltx_Math" alttext="R_{\alpha+1}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mrow><mi>α</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">R_{\alpha+1}</annotation></semantics></math> be obtained from <math id="S8.I3.i2.p1.m3" class="ltx_Math" alttext="R_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>α</mi></msub><annotation encoding="application/x-tex">R_{\alpha}</annotation></semantics></math> by adjoining an idempotent endomorphism</p>
<table id="S8.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S8.Ex5.m1" class="ltx_Math" alttext="e_{\phi_{\alpha}}:\overline{\bigoplus_{1\leq k\leq n_{\phi_{\alpha}}}\mathsf{k}(\lambda_{\phi_{\alpha},k})}\to\overline{\bigoplus_{1\leq k\leq n_{\phi_{\alpha}}}\mathsf{k}(\lambda_{\phi,k})}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>e</mi><msub><mi>ϕ</mi><mi>α</mi></msub></msub><mo lspace="0.278em" rspace="0.111em">:</mo><mrow><mover accent="true"><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mn>1</mn><mo>≤</mo><mi>k</mi><mo>≤</mo><msub><mi>n</mi><msub><mi>ϕ</mi><mi>α</mi></msub></msub></mrow></munder><mrow><mi>𝗄</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mrow><msub><mi>ϕ</mi><mi>α</mi></msub><mo>,</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="true">¯</mo></mover><mo rspace="0.111em" stretchy="false">→</mo><mover accent="true"><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mn>1</mn><mo>≤</mo><mi>k</mi><mo>≤</mo><msub><mi>n</mi><msub><mi>ϕ</mi><mi>α</mi></msub></msub></mrow></munder><mrow><mi>𝗄</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mrow><mi>ϕ</mi><mo>,</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="true">¯</mo></mover></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">e_{\phi_{\alpha}}:\overline{\bigoplus_{1\leq k\leq n_{\phi_{\alpha}}}\mathsf{k}(\lambda_{\phi_{\alpha},k})}\to\overline{\bigoplus_{1\leq k\leq n_{\phi_{\alpha}}}\mathsf{k}(\lambda_{\phi,k})}.</annotation></semantics></math></td>
