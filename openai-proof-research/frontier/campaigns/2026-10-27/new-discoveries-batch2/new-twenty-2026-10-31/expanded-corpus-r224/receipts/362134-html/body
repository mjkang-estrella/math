<td class="ltx_eqn_cell ltx_align_center"><math id="S8.Ex2.m1" class="ltx_Math" alttext="e_{\phi}:\overline{\bigoplus_{1\leq k\leq n_{\phi}}\mathsf{k}(\gamma_{\phi,k})}\longrightarrow\overline{\bigoplus_{1\leq k\leq n_{\phi}}\mathsf{k}(\gamma_{\phi,k})}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>e</mi><mi>ϕ</mi></msub><mo lspace="0.278em" rspace="0.111em">:</mo><mrow><mover accent="true"><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mn>1</mn><mo>≤</mo><mi>k</mi><mo>≤</mo><msub><mi>n</mi><mi>ϕ</mi></msub></mrow></munder><mrow><mi>𝗄</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>γ</mi><mrow><mi>ϕ</mi><mo>,</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="true">¯</mo></mover><mo rspace="0.111em" stretchy="false">⟶</mo><mover accent="true"><mrow><munder><mo movablelimits="false">⨁</mo><mrow><mn>1</mn><mo>≤</mo><mi>k</mi><mo>≤</mo><msub><mi>n</mi><mi>ϕ</mi></msub></mrow></munder><mrow><mi>𝗄</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>γ</mi><mrow><mi>ϕ</mi><mo>,</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="true">¯</mo></mover></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">e_{\phi}:\overline{\bigoplus_{1\leq k\leq n_{\phi}}\mathsf{k}(\gamma_{\phi,k})}\longrightarrow\overline{\bigoplus_{1\leq k\leq n_{\phi}}\mathsf{k}(\gamma_{\phi,k})},</annotation></semantics></math></td>
