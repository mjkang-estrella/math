ma_{k})</annotation></semantics></math><span id="S5.I2.i2.p1.1.7" class="ltx_text ltx_font_italic"> of </span><span id="S5.I2.i2.p1.1.8" class="ltx_text">(<a href="#S5.E8" title="In 5.3. Matrix forms for three types of Bergman algebras ‣ 5. Graded Bergman universal construction ‣ Bergman algebrasThe graded universal algebra constructions" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.8</span></a>)</span><span id="S5.I2.i2.p1.1.9" class="ltx_text ltx_font_italic"> whose </span><math id="S5.I2.i2.p1.m7" class="ltx_Math" alttext="jk" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">jk</annotation></semantics></math><span id="S5.I2.i2.p1.1.10" class="ltx_text ltx_font_italic">-th entry is of degree </span><math id="S5.I2.i2.p1.m8" class="ltx_Math" alttext="\gamma_{k}-\beta_{j}\in\Gamma" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>γ</mi><mi>k</mi></msub><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow><mo>∈</mo><mi mathvariant="normal">Γ</mi></mrow><annotation encoding="application/x-tex">\gamma_{k}-\beta_{j}\in\Gamma</annotation></semantics></math><span id="S5.I2.i2.p1.1.11" class="ltx_text ltx_font_italic"> and </span><math id="S5.I2.i2.p1.m9" class="ltx_Math" alttext="\langle h_{g}\rangle" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⟨</mo><msub><mi>h</mi><mi>g</mi></msub><mo stretchy="false">⟩</mo></mrow><annotation encoding="application/x-tex">\langle h_{g}\rangle</annotation></semantics></math><span id="S5.I2.i2.p1.1.12" class="ltx_text ltx_font_italic"> is the two-sided ideal generated by the entries of </span><math id="S5.I2.i2.p1.m10" class="ltx_Math" alttext="h_{g}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mi>g</mi></msub><annotation encoding="application/x-tex">h_{g}</annotation></semantics></math><span id="S5.I2.i2.p1.1.13" class="ltx_text ltx_font_italic">.</span></p>
