<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex20.m1" class="ltx_Math" alttext="0=f(a)=f\Big(\sum_{w\in W}\lambda_{w}w\Big)=f\Big(\sum_{\gamma\in\Gamma}\sum_{w\in W_{\gamma}}\lambda_{w}w\Big)=\sum_{\gamma\in\Gamma}\sum_{w\in W_{\gamma}}\lambda_{w}\zeta(w)p_{\gamma}." display="block" intent=":literal"><semantics><mrow><mrow><mn>0</mn><mo>=</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>w</mi><mo>∈</mo><mi>W</mi></mrow></munder><mrow><msub><mi>λ</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>=</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">∑</mo><mrow><mi>γ</mi><mo>∈</mo><mi mathvariant="normal">Γ</mi></mrow></munder><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>w</mi><mo>∈</mo><msub><mi>W</mi><mi>γ</mi></msub></mrow></munder><mrow><msub><mi>λ</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>γ</mi><mo>∈</mo><mi mathvariant="normal">Γ</mi></mrow></munder><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>w</mi><mo>∈</mo><msub><mi>W</mi><mi>γ</mi></msub></mrow></munder><mrow><msub><mi>λ</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>ζ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>γ</mi></msub></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">0=f(a)=f\Big(\sum_{w\in W}\lambda_{w}w\Big)=f\Big(\sum_{\gamma\in\Gamma}\sum_{w\in W_{\gamma}}\lambda_{w}w\Big)=\sum_{\gamma\in\Gamma}\sum_{w\in W_{\gamma}}\lambda_{w}\zeta(w)p_{\gamma}.</annotation></semantics></math></td>
