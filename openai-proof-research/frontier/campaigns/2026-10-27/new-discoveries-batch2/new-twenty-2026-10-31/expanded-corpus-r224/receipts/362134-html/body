1-(S\otimes_{R}\xi)\circ(S\otimes_{\lambda}\Delta_{\xi})=S\otimes_{\lambda}(1-(S_{\Sigma}\otimes_{\theta_{1}}\xi)\circ\Delta_{\xi})=0.\end{cases}" display="block" intent=":literal"><semantics><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>S</mi><msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>λ</mi></msub><msub><mi mathvariant="normal">Δ</mi><mi>ξ</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">∘</mo><mrow><mo stretchy="false">(</mo><mrow><mi>S</mi><msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>R</mi></msub><mi>ξ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi>S</mi><msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>λ</mi></msub><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mi>ξ</mi></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi mathvariant="normal">Σ</mi></msub><msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>θ</mi><mn>1</mn></msub></msub><mi>ξ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo>;</mo></mrow></mtd><mtd></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>S</mi><msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>R</mi></msub><mi>ξ</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">∘</mo><mrow><mo stretchy="false">(</mo><mrow><mi>S</mi><msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>λ</mi></msub><msub><mi mathvariant="normal">Δ</mi><mi>ξ</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi>S</mi><msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>λ</mi></msub><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi mathvariant="normal">Σ</mi></msub><msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>θ</mi><mn>1</mn></msub></msub><mi>ξ</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">∘</mo><msub><mi mathvariant="normal">Δ</mi><mi>ξ</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow></mtd><mtd></mtd></mtr></mtable></mrow><annotation encoding="application/x-tex">\begin{cases}1-(S\otimes_{\lambda}\Delta_{\xi})\circ(S\otimes_{R}\xi)=S\otimes_{\lambda}(1-\Delta_{\xi}\circ(S_{\Sigma}\otimes_{\theta_{1}}\xi))=0;\\
1-(S\otimes_{R}\xi)\circ(S\otimes_{\lambda}\Delta_{\xi})=S\otimes_{\lambda}(1-(S_{\Sigma}\otimes_{\theta_{1}}\xi)\circ\Delta_{\xi})=0.\end{cases}</annotation></semantics></math></td>
