<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E10.m1" class="ltx_Math" alttext="\begin{cases}R_{\Sigma}\otimes_{\theta_{2}}(1-\Delta_{\xi}\circ S_{\Sigma}\otimes_{\theta_{1}}\xi)=0;\\
\ R_{\Sigma}\otimes_{\theta_{2}}(1-S_{\Sigma}\otimes_{\theta_{1}}\xi\circ\Delta_{\xi})=0.\end{cases}" display="block" intent=":literal"><semantics><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi>R</mi><msub><mrow></mrow><mi mathvariant="normal">Σ</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mrow></mrow><msub><mi>θ</mi><mn>2</mn></msub></msub><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi mathvariant="normal">Δ</mi><msub><mrow></mrow><mi>ξ</mi></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>S</mi><msub><mrow></mrow><mi mathvariant="normal">Σ</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mrow></mrow><msub><mi>θ</mi><mn>1</mn></msub></msub><mi>ξ</mi><mo stretchy="false">)</mo><mo>=</mo><mn>0</mn><mo>;</mo></mrow></mtd><mtd></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><msub><mi>R</mi><mi mathvariant="normal">Σ</mi></msub><msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>θ</mi><mn>2</mn></msub></msub><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mrow><msub><mi>S</mi><mi mathvariant="normal">Σ</mi></msub><msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>θ</mi><mn>1</mn></msub></msub><mi>ξ</mi></mrow><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi mathvariant="normal">Δ</mi><mi>ξ</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow></mtd><mtd></mtd></mtr></mtable></mrow><annotation encoding="application/x-tex">\begin{cases}R_{\Sigma}\otimes_{\theta_{2}}(1-\Delta_{\xi}\circ S_{\Sigma}\otimes_{\theta_{1}}\xi)=0;\\
