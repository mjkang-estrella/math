</mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}S\#\Gamma=\Big\langle&amp;rp_{\gamma},h_{jm}p_{\gamma},h^{\prime}_{mj}p_{\gamma}\quad(r\in R^{h},\gamma\in\Gamma,j\in J,m\in M)\mid{}\\
