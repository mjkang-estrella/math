<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmthm9.2" class="ltx_text ltx_font_bold">Corollary 7.9</span></span><span id="S7.Thmthm9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmthm9.p1" class="ltx_para">
<p id="S7.Thmthm9.p1.1" class="ltx_p"><span id="S7.Thmthm9.p1.1.1" class="ltx_text ltx_font_italic">There is a <math id="S7.Thmthm9.p1.m1" class="ltx_Math" alttext="\Gamma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Γ</mi><annotation encoding="application/x-tex">\Gamma</annotation></semantics></math>-monoid isomorphism <math id="S7.Thmthm9.p1.m2" class="ltx_math_unparsed" alttext="\mathcal{V}^{\operatorname{gr}}(S)\cong\mathcal{V}^{\operatorname{gr}}(R)\big\langle[P_{1}],[P_{2}]\mid[P]=[P_{1}]+[P_{2}]\big\rangle" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>gr</mi></msup><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow><mo>≅</mo><msup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>gr</mi></msup><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">⟨</mo><mrow><mo stretchy="false">[</mo><msub><mi>P</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow><mo>,</mo><mrow><mo stretchy="false">[</mo><msub><mi>P</mi><mn>2</mn></msub><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mrow><mo stretchy="false">[</mo><mi>P</mi><mo stretchy="false">]</mo></mrow><mo>=</mo><mrow><mo stretchy="false">[</mo><msub><mi>P</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow><mo>+</mo><mrow><mo stretchy="false">[</mo><msub><mi>P</mi><mn>2</mn></msub><mo stretchy="false">]</mo></mrow><mo stretchy="false">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{V}^{\operatorname{gr}}(S)\cong\mathcal{V}^{\operatorname{gr}}(R)\big\langle[P_{1}],[P_{2}]\mid[P]=[P_{1}]+[P_{2}]\big\rangle</annotation></semantics></math> given by tensoring.</span></p>
</div>
