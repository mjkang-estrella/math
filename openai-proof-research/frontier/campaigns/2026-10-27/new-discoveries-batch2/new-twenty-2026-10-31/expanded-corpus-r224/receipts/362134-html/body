<p id="S5.Thmthm10.p1.2" class="ltx_p"><span id="S5.Thmthm10.p1.2.1" class="ltx_text ltx_font_italic">where <math id="S5.Thmthm10.p1.m7" class="ltx_Math" alttext="h^{*}=(h^{*}_{kj})" display="inline" intent=":literal"><semantics><mrow><msup><mi>h</mi><mo>∗</mo></msup><mo>=</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>h</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">h^{*}=(h^{*}_{kj})</annotation></semantics></math> is a <math id="S5.Thmthm10.p1.m8" class="ltx_Math" alttext="m\times n" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">m\times n</annotation></semantics></math>-matrix with <math id="S5.Thmthm10.p1.m9" class="ltx_Math" alttext="h^{*}_{kj}" display="inline" intent=":literal"><semantics><msubsup><mi>h</mi><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>∗</mo></msubsup><annotation encoding="application/x-tex">h^{*}_{kj}</annotation></semantics></math> symbols of degree <math id="S5.Thmthm10.p1.m10" class="ltx_Math" alttext="\beta_{j}-\gamma_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mi>j</mi></msub><mo>−</mo><msub><mi>γ</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">\beta_{j}-\gamma_{k}</annotation></semantics></math>, for <math id="S5.Thmthm10.p1.m11" class="ltx_Math" alttext="j=1,\cdots,n" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">j=1,\cdots,n</annotation></semantics></math> and <math id="S5.Thmthm10.p1.m12" class="ltx_Math" alttext="k=1,\cdots,m" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">k=1,\cdots,m</annotation></semantics></math>.</span></p>
</div>
