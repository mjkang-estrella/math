<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E12.m1" class="ltx_Math" alttext="rp_{\alpha}.\theta(xd)=(rp_{\alpha}).x^{(\gamma)}d^{(\gamma)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>α</mi></msub></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>α</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">rp_{\alpha}.\theta(xd)=(rp_{\alpha}).x^{(\gamma)}d^{(\gamma)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(6.12)</span></td></tr></tbody>
</table>
<p id="S6.SS1.p14.6" class="ltx_p"><span id="S6.SS1.p14.6.1" class="ltx_text">Clearly</span></p>
<table id="S6.E13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E13.m1" class="ltx_math_unparsed" alttext="((rp_{\alpha}).x^{(\gamma)})_{j}=(rp_{\alpha}).(x^{(\gamma)})_{j}=(rp_{\alpha})(x_{j}p_{\gamma-\beta_{j}})=r(x_{j})_{\alpha-\gamma+\beta_{j}}p_{\gamma-\beta_{j}}=y^{(\gamma)}_{j}," display="block" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><msub><mi>p</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">.</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mi>j</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><msub><mi>p</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">.</mo><msub><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mi>j</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><msub><mi>p</mi><mi>α</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><msub><mi>p</mi><mrow><mi>γ</mi><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>r</mi><msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mrow><mi>α</mi><mo>−</mo><mi>γ</mi></mrow><mo>+</mo><msub><mi>β</mi><mi>j</mi></msub></mrow></msub><msub><mi>p</mi><mrow><mi>γ</mi><mo>−</mo><msub><mi>β</mi><mi>j</mi></msub></mrow></msub><mo>=</mo><msubsup><mi>y</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo></mrow><annotation encoding="application/x-tex">((rp_{\alpha}).x^{(\gamma)})_{j}=(rp_{\alpha}).(x^{(\gamma)})_{j}=(rp_{\alpha})(x_{j}p_{\gamma-\beta_{j}})=r(x_{j})_{\alpha-\gamma+\beta_{j}}p_{\gamma-\beta_{j}}=y^{(\gamma)}_{j},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(6.13)</span></td></tr></tbody>
</table>
<p id="S6.SS1.p14.7" class="ltx_p"><span id="S6.SS1.p14.7.1" class="ltx_text">for any <math id="S6.SS1.p14.m11" class="ltx_Math" alttext="j\in J" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mi>J</mi></mrow><annotation encoding="application/x-tex">j\in J</annotation></semantics></math>. Hence</span></p>
<table id="S6.E14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E14.m1" class="ltx_Math" alttext="(rp_{\alpha}).x^{(\gamma)}=y^{(\gamma)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>α</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><msup><mi>y</mi><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(rp_{\alpha}).x^{(\gamma)}=y^{(\gamma)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(6.14)</span></td></tr></tbody>
</table>
<p id="S6.SS1.p14.8" class="ltx_p"><span id="S6.SS1.p14.8.1" class="ltx_text">It follows from (<a href="#S6.E11" title="In Proof. ‣ 6.1. Smash products of graded Bergman algebras I ‣ 6. Smash products of graded Bergman algebras ‣ Bergman algebrasThe graded universal algebra constructions" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.11</span></a>), (<a href="#S6.E12" title="In Proof. ‣ 6.1. Smash products of graded Bergman algebras I ‣ 6. Smash products of graded Bergman algebras ‣ Bergman algebrasThe graded universal algebra constructions" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.12</span></a>) and (<a href="#S6.E13" title="In Proof. ‣ 6.1. Smash products of graded Bergman algebras I ‣ 6. Smash products of graded Bergman algebras ‣ Bergman algebrasThe graded universal algebra constructions" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.13</span></a>) that</span></p>
<table id="S6.E15" class="ltx_equation ltx_eqn_table">

