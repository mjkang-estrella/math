 -82.49093078554164 L 173.4719092344139 -82.59423956495607" fill="none" stroke="#000000" stroke-dasharray="1 2"></path><g transform="translate(173.47,0) translate(0,-87.64) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.67em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="9.28"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex17.m1.pic1.m16" class="ltx_Math" alttext="\textstyle{S}" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">\textstyle{S}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
