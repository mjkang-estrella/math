ke="#000000"></path><g transform="translate(-10.73,0) translate(0,-43.83) translate(4.15,0) translate(0,-3.46)"><foreignObject style="--ltx-fo-width:0.95em;--ltx-fo-height:0.75em;--ltx-fo-depth:0em;font-size:10pt;" height="10.4" overflow="visible" transform="matrix(1 0 0 -1 0 10.4)" width="13.16"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex42.m1.pic1.m9" class="ltx_Math" alttext="\textstyle{S^{\prime}}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\textstyle{S^{\prime}}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
