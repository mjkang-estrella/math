{\rm Im}\,e=\operatorname{Ker}(1-e),&amp;\\
F=\operatorname{Ker}e\oplus{\rm Im}\,e.&amp;\end{cases}" display="inline" intent=":literal"><semantics><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mi>Ker</mi><mo lspace="0.167em">⁡</mo><mi>e</mi></mrow><mo>=</mo><mrow><mi>Im</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>e</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow></mtd><mtd></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mi>Im</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>e</mi></mrow><mo>=</mo><mrow><mi>Ker</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>e</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow></mtd><mtd></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>F</mi><mo>=</mo><mrow><mrow><mi>Ker</mi><mo lspace="0.167em">⁡</mo><mi>e</mi></mrow><mo>⊕</mo><mrow><mi>Im</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>e</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd><mtd></mtd></mtr></mtable></mrow><annotation encoding="application/x-tex">\displaystyle\begin{cases}\operatorname{Ker}e={\rm Im}(1-e),&amp;\\
{\rm Im}\,e=\operatorname{Ker}(1-e),&amp;\\
F=\operatorname{Ker}e\oplus{\rm Im}\,e.&amp;\end{cases}</annotation></semantics></math></td>
