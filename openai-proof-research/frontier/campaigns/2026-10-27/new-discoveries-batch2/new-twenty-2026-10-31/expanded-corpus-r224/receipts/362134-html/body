<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex36.m1" class="ltx_math_unparsed" alttext="S_{\Sigma}=R\big\langle\Delta_{\xi}:\overline{Q}_{\xi}\rightarrow\overline{P}_{\xi}\mid\xi\in\Sigma\big\rangle," display="block" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi mathvariant="normal">Σ</mi></msub><mo>=</mo><mi>R</mi><mrow><mo stretchy="false">⟨</mo><msub><mi mathvariant="normal">Δ</mi><mi>ξ</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mover accent="true"><mi>Q</mi><mo stretchy="true">¯</mo></mover><mi>ξ</mi></msub><mo stretchy="false">→</mo><msub><mover accent="true"><mi>P</mi><mo stretchy="true">¯</mo></mover><mi>ξ</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>ξ</mi><mo>∈</mo><mi mathvariant="normal">Σ</mi><mo stretchy="false">⟩</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">S_{\Sigma}=R\big\langle\Delta_{\xi}:\overline{Q}_{\xi}\rightarrow\overline{P}_{\xi}\mid\xi\in\Sigma\big\rangle,</annotation></semantics></math></td>
