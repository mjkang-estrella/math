="#000000"></path><g transform="translate(53.34,0) translate(0,-64.92) translate(4.15,0) translate(0,-3.12)"><foreignObject style="--ltx-fo-width:1.05em;--ltx-fo-height:0.45em;--ltx-fo-depth:0em;font-size:10pt;" height="6.24" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="14.49"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex2.m1.pic1.m12" class="ltx_Math" alttext="\scriptstyle{1-e}" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.700em">1</mn><mo mathsize="0.700em">−</mo><mi mathsize="0.700em">e</mi></mrow><annotation encoding="application/x-tex">\scriptstyle{1-e}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(53.34,0) translate(0,-76.49)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 2.77 6.92" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -2.77 6.92" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 53.062961526113014 -76.48785249217345 L 53.616433086213156 -50.966255691547325" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 53.062961526113014 -76.48785249217345 L 53.616433086213156 -76.48785249217345" fill="none" stroke="#000000"></path><g transform="translate(99.04,0) translate(0,-43.28) translate(4.15,0) translate(0,-3.54)"><foreignObject style="--ltx-fo-width:0.78em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="10.81"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex2.m1.pic1.m13" class="ltx_Math" alttext="\textstyle{P\ignorespaces\ignorespaces\ignorespaces\ignorespaces}" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">\textstyle{P\ignorespaces\ignorespaces\ignorespaces\ignorespaces}</annotation></semantics></math></span></span></foreignObject></g><path style="--ltx-stroke-color:#000000;" d="M 118.14538119854366 -43.55578794013552 L 118.14538119854366 -43.002316380035374" fill="none" stroke="#000000"></path><g transform="translate(153.42,0) translate(0,-43.28)"><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 0 -6.92 2.77" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 0 0 A 13.84 13.84 45 0 1 -6.92 -2.77" fill="none" stroke="#000000"></path></g><path style="--ltx-stroke-color:#000000;" d="M 118.14538119854366 -43.55578794013552 L 153.41769680700412 -43.002316380035374" fill="none" stroke="#000000"></path><path style="--ltx-stroke-color:#000000;" d="M 153.41769680700412 -43.55578794013552 L 153.41769680700412 -43.002316380035374" fill="none" stroke="#000000"></path><g transform="translate(153.42,0) translate(0,-43.28) translate(4.15,0) translate(0,-3.54)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex2.m1.pic1.m14" class="ltx_Math" alttext="\textstyle{0}" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">\textstyle{0}</annotation></semantics></math></span></span></foreignObject></g><g transform="translate(43.78,0) translate(0,-86.56) translate(4.15,0) translate(0,-3.54)"><foreignObject style="--ltx-fo-width:0.78em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="10.82"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.Ex2.m1.pic1.m16" class="ltx_Math" alttext="\textstyle{F}" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">\textstyle{F}</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></td>
