.0 73.24 119.96)"><foreignObject style="--ltx-fo-width:0.55em;--ltx-fo-height:0.37em;--ltx-fo-depth:0em;font-size:8.19pt;" height="4.17" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="6.27"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.F1.pic1.m3" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.700em">x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math></span></span></foreignObject></g><g></g><g style="--ltx-fill-color:#000000;" fill="#000000"><path d="M 118.11 13.39 M 121.57 13.39 C 121.57 15.3 120.02 16.84 118.11 16.84 C 116.2 16.84 114.65 15.3 114.65 13.39 C 114.65 11.48 116.2 9.93 118.11 9.93 C 120.02 9.93 121.57 11.48 121.57 13.39 Z M 118.11 13.39"></path></g><g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000"><path style="fill:none" d="M 125.98 5.91"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 123 4.76)"><foreignObject style="--ltx-fo-width:0.53em;--ltx-fo-height:0.37em;--ltx-fo-depth:0.17em;font-size:8.19pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="5.96"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.F1.pic1.m4" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.700em">y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math></span></span></foreignObject></g><g></g><g style="--ltx-fill-color:#000000;" fill="#000000"><path d="M 58.27 40.16 M 61.73 40.16 C 61.73 42.07 60.18 43.62 58.27 43.62 C 56.36 43.62 54.81 42.07 54.81 40.16 C 54.81 38.25 56.36 36.7 58.27 36.7 C 60.18 36.7 61.73 38.25 61.73 40.16 Z M 58.27 40.16"></path></g><g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000"><path style="fill:none" d="M 44.88 39.37"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 40.75 37.28)"><foreignObject style="--ltx-fo-width:0.73em;--ltx-fo-height:0.37em;--ltx-fo-depth:0em;font-size:8.19pt;" height="4.17" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="8.27"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.F1.pic1.m5" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.700em">w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math></span></span></foreignObject></g><g></g><g style="--ltx-fill-color:#000000;" fill="#000000"><path d="M 41.73 13.39 M 45.19 13.39 C 45.19 15.3 43.64 16.84 41.73 16.84 C 39.82 16.84 38.27 15.3 38.27 13.39 C 38.27 11.48 39.82 9.93 41.73 9.93 C 43.64 9.93 45.19 11.48 45.19 13.39 Z M 41.73 13.39"></path></g><g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000"><path style="fill:none" d="M 35.43 5.91"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 32.59 3.82)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.37em;--ltx-fo-depth:0em;font-size:8.19pt;" height="4.17" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="5.68"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S1.F1.pic1.m6" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.700em">z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math></span></span></foreignObject></g><g></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 1: </span>A sun graph <math id="S1.F1.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> with <math id="S1.F1.m5" class="ltx_Math" alttext="\gamma(G)=3" display="inline" intent=":literal"><semantics><mrow><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">\gamma(G)=3</annotation></semantics></math> and <math id="S1.F1.m6" class="ltx_Math" alttext="\zeta(G)=8" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ζ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">\zeta(G)=8</annotation></semantics></math></figcaption>
</figure>
<div id="S1.p8" class="ltx_para">
<p id="S1.p8.1" class="ltx_p">Consider the unicyclic graph <math id="S1.p8.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> as shown in Figure <a href="#S1.F1" title="Figure 1 ‣ 1 Introduction ‣ Dominion of Some Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>. It is easy to see that <math id="S1.p8.m2" class="ltx_Math" alttext="\gamma(G)=3" display="inline" intent=":literal"><semantics><mrow><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">\gamma(G)=3</annotation></semantics></math>. We list all the <math id="S1.p8.m3" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>-sets with properties which are among the five commonly studied, as previously mentioned.</p>
</div>
<div id="S1.p9" class="ltx_para">
<ul id="S1.I2" class="ltx_itemize">
<li id="S1.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S1.I2.i1.p1" class="ltx_para">
<p id="S1.I2.i1.p1.1" class="ltx_p"><math id="S1.I2.i1.p1.m1" class="ltx_Math" alttext="\{u,v,w\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo>,</mo><mi>w</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{u,v,w\}</annotation></semantics></math> is a perfect <math id="S1.I2.i1.p1.m2" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>-set, a connected <math id="S1.I2.i1.p1.m3" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>-set, a total <math id="S1.I2.i1.p1.m4" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>-set, and a clique <math id="S1.I2.i1.p1.m5" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>-set.</p>
</div></li>
<li id="S1.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S1.I2.i2.p1" class="ltx_para">
<p id="S1.I2.i2.p1.1" class="ltx_p"><math id="S1.I2.i2.p1.m1" class="ltx_Math" alttext="\{x,y,z\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{x,y,z\}</annotation></semantics></math> is a perfect <math id="S1.I2.i2.p1.m2" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>-set, and an independent <math id="S1.I2.i2.p1.m3" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>-set.</p>
</div></li>
<li id="S1.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S1.I2.i3.p1" class="ltx_para">
<p id="S1.I2.i3.p1.1" class="ltx_p"><math id="S1.I2.i3.p1.m1" class="ltx_Math" alttext="\{u,y,z\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mi>u</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{u,y,z\}</annotation></semantics></math>, <math id="S1.I2.i3.p1.m2" class="ltx_Math" alttext="\{v,x,z\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mi>v</mi><mo>,</mo><mi>x</mi><mo>,</mo><mi>z</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{v,x,z\}</annotation></semantics></math>, and <math id="S1.I2.i3.p1.m3" class="ltx_Math" alttext="\{w,x,y\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mi>w</mi><mo>,</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{w,x,y\}</annotation></semantics></math> are independent <math id="S1.I2.i3.p1.m4" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>-sets but not perfect, connected, clique or total.</p>
</div></li>
<li id="S1.I2.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S1.I2.i4.p1" class="ltx_para">
<p id="S1.I2.i4.p1.1" class="ltx_p"><math id="S1.I2.i4.p1.m1" class="ltx_Math" alttext="\{u,v,z\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo>,</mo><mi>z</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{u,v,z\}</annotation></semantics></math>, <math id="S1.I2.i4.p1.m2" class="ltx_Math" alttext="\{u,w,y\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mi>u</mi><mo>,</mo><mi>w</mi><mo>,</mo><mi>y</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{u,w,y\}</annotation></semantics></math>, and <math id="S1.I2.i4.p1.m3" class="ltx_Math" alttext="\{v,w,x\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mi>v</mi><mo>,</mo><mi>w</mi><mo>,</mo><mi>x</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{v,w,x\}</annotation></semantics></math> are <math id="S1.I2.i4.p1.m4" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>-sets which have none of the <math id="S1.I2.i4.p1.m5" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math> special properties that we previously listed.</p>
</div></li>
</ul>
<p id="S1.p9.1" class="ltx_p">We have <math id="S1.p9.m1" class="ltx_Math" alttext="\displaystyle\zeta(G)=\sum_{i=0}^{3}{3\choose i}=8" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ζ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mn>3</mn></munderover></mstyle><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mn>3</mn><mi>i</mi></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>=</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">\displaystyle\zeta(G)=\sum_{i=0}^{3}{3\choose i}=8</annotation></semantics></math>, the number of <math id="S1.p9.m2" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>-sets of <math id="S1.p9.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>.
We present a generalization of the previous example for such unicyclic graphs which are commonly known as <span id="S1.p9.1.1" class="ltx_text ltx_font_italic">sun graphs</span>.</p>
</div>
<div id="S1.Thmtheorem2" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S1.Thmtheorem2.2" class="ltx_text ltx_font_bold">Proposition 1.2</span></span><span id="S1.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S1.Thmtheorem2.p1" class="ltx_para">
<p id="S1.Thmtheorem2.p1.1" class="ltx_p"><span id="S1.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">If <math id="S1.Thmtheorem2.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> is a sun graph on <math id="S1.Thmtheorem2.p1.m2" class="ltx_Math" alttext="2n\geq 6" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>≥</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">2n\geq 6</annotation></semantics></math> vertices, then <math id="S1.Thmtheorem2.p1.m3" class="ltx_Math" alttext="\displaystyle\zeta(G)=\sum_{i=0}^{n}{n\choose i}=2^{n}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>ζ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mi>n</mi><mi>i</mi></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>=</mo><msup><mn>2</mn><mi>n</mi></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\zeta(G)=\sum_{i=0}^{n}{n\choose i}=2^{n}.</annotation></semantics></math></span></p>
</div>
</div>
<div id="S1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S1.p10" class="ltx_para">
<p id="S1.p10.1" class="ltx_p"><span id="S1.p10.1.1" class="ltx_text">For each vertex on the cycle, and for each dominating set <math id="S1.p10.m1" class="ltx_Math" alttext="S\subseteq V(G)" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⊆</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">S\subseteq V(G)</annotation></semantics></math>, either the vertex or its leaf neighbor must be in <math id="S1.p10.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>. Therefore, we can form all <math id="S1.p10.m3" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>-sets <math id="S1.p10.m4" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> in <math id="S1.p10.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> from choosing subsets of the set of <math id="S1.p10.m6" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> leafs, and the cycle neighbors of unchosen leafs. This gives <math id="S1.p10.m7" class="ltx_Math" alttext="\displaystyle\sum_{i=0}^{n}{n\choose i}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mi>n</mi><mi>i</mi></mfrac></mstyle><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=0}^{n}{n\choose i}</annotation></semantics></math>. Conversely, every <math id="S1.p10.m8" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> assembled by choosing either the vertex on the cycle or the leaf, for each leaf, is a <math id="S1.p10.m9" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>-set for <math id="S1.p10.m10" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>. This gives <math id="S1.p10.m11" class="ltx_Math" alttext="\zeta(G)=2^{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ζ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mn>2</mn><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">\zeta(G)=2^{n}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="S2" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">2 </span>Dominion of Some Graphs</h2>

<div id="S2.p1" class="ltx_para">
<p id="S2.p1.1" class="ltx_p">Suppose <math id="S2.p1.m1" class="ltx_Math" alttext="P_{n}:=v_{1}-v_{2}-\ldots-v_{n-1}-v_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>n</mi></msub><mo>:=</mo><mrow><msub><mi>v</mi><mn>1</mn></msub><mo>−</mo><msub><mi>v</mi><mn>2</mn></msub><mo>−</mo><mi mathvariant="normal">…</mi><mo>−</mo><msub><mi>v</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>v</mi><mi>n</mi></msub></mrow></mrow><annotation encoding="application/x-tex">P_{n}:=v_{1}-v_{2}-\ldots-v_{n-1}-v_{n}</annotation></semantics></math>, denotes a path on <math id="S2.p1.m2" class="ltx_Math" alttext="n\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">n\geq 2</annotation></semantics></math> vertices. We establish each of the following claims:</p>
</div>
<div id="S2.Thmtheorem1" class="ltx_theorem ltx_theorem_claim">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmtheorem1.2" class="ltx_text ltx_font_bold">Claim 2.1</span></span><span id="S2.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmtheorem1.p1" class="ltx_para">
<p id="S2.Thmtheorem1.p1.1" class="ltx_p"><span id="S2.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">There is no <math id="S2.Thmtheorem1.p1.m1" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>-set that includes both vertices <math id="S2.Thmtheorem1.p1.m2" class="ltx_Math" alttext="v_{n-1},v_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>v</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">v_{n-1},v_{n}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S2.p2" class="ltx_para">
<p id="S2.p2.1" class="ltx_p"><span id="S2.p2.1.1" class="ltx_text">Suppose <math id="S2.p2.m1" class="ltx_Math" alttext="n=3k+1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">n=3k+1</annotation></semantics></math>. It is easy to see that <math id="S2.p2.m2" class="ltx_Math" alttext="\gamma(P_{3k+1})=k+1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\gamma(P_{3k+1})=k+1</annotation></semantics></math> and without loss, let’s assume that there is a <math id="S2.p2.m3" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>-set <math id="S2.p2.m4" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>, with <math id="S2.p2.m5" class="ltx_Math" alttext="|S|=k+1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">|S|=k+1</annotation></semantics></math>, that includes both <math id="S2.p2.m6" class="ltx_Math" alttext="v_{3k},v_{3k+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo>,</mo><msub><mi>v</mi><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">v_{3k},v_{3k+1}</annotation></semantics></math>. Since <math id="S2.p2.m7" class="ltx_Math" alttext="v_{3k-1}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">v_{3k-1}</annotation></semantics></math> is covered by <math id="S2.p2.m8" class="ltx_Math" alttext="v_{3k}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">v_{3k}</annotation></semantics></math> (and vice versa), this leaves exactly <math id="S2.p2.m9" class="ltx_Math" alttext="3k-2" display="inline" intent=":literal"><semantics><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>−</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">3k-2</annotation></semantics></math> vertices of <math id="S2.p2.m10" class="ltx_Math" alttext="P_{3k+1}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">P_{3k+1}</annotation></semantics></math> that are to be covered using the remaining <math id="S2.p2.m11" class="ltx_Math" alttext="k-1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k-1</annotation></semantics></math> vertices of <math id="S2.p2.m12" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>. Because each vertex of <math id="S2.p2.m13" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> covers at most <math id="S2.p2.m14" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> other vertices of <math id="S2.p2.m15" class="ltx_Math" alttext="P_{3k+1}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">P_{3k+1}</annotation></semantics></math>, <math id="S2.p2.m16" class="ltx_Math" alttext="k-1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k-1</annotation></semantics></math> vertices can cover at most <math id="S2.p2.m17" class="ltx_Math" alttext="3(k-1)" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">3(k-1)</annotation></semantics></math> vertices of the path, and <math id="S2.p2.m18" class="ltx_Math" alttext="3(k-1)&lt;3k-2" display="inline" intent=":literal"><semantics><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>−</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">3(k-1)&lt;3k-2</annotation></semantics></math>. A similar argument addresses the case when <math id="S2.p2.m19" class="ltx_Math" alttext="n=3k+2" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>+</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">n=3k+2</annotation></semantics></math> and the case when <math id="S2.p2.m20" class="ltx_Math" alttext="n=3k" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mrow><annotation encoding="application/x-tex">n=3k</annotation></semantics></math> follows from a pigeonhole principle argument, since <math id="S2.p2.m21" class="ltx_Math" alttext="\gamma(P_{3k})=k" display="inline" intent=":literal"><semantics><mrow><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">\gamma(P_{3k})=k</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S2.Thmtheorem2" class="ltx_theorem ltx_theorem_claim">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmtheorem2.2" class="ltx_text ltx_font_bold">Claim 2.2</span></span><span id="S2.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmtheorem2.p1" class="ltx_para">
<p id="S2.Thmtheorem2.p1.1" class="ltx_p"><span id="S2.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">There is no <math id="S2.Thmtheorem2.p1.m1" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>-set that excludes both vertices <math id="S2.Thmtheorem2.p1.m2" class="ltx_Math" alttext="v_{n-1},v_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>v</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">v_{n-1},v_{n}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S2.p3" class="ltx_para">
<p id="S2.p3.1" class="ltx_p"><span id="S2.p3.1.1" class="ltx_text">Suppose <math id="S2.p3.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is a <math id="S2.p3.m2" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>-set of <math id="S2.p3.m3" class="ltx_Math" alttext="P_{n}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>n</mi></msub><annotation encoding="application/x-tex">P_{n}</annotation></semantics></math> that excludes both consecutive vertices <math id="S2.p3.m4" class="ltx_Math" alttext="v_{n-1},v_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>v</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">v_{n-1},v_{n}</annotation></semantics></math>. It follows that <math id="S2.p3.m5" class="ltx_Math" alttext="v_{n}\in V(P_{n})" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi>n</mi></msub><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">v_{n}\in V(P_{n})</annotation></semantics></math> is left uncovered. Hence, <math id="S2.p3.m6" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is not a <math id="S2.p3.m7" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>-set of <math id="S2.p3.m8" class="ltx_Math" alttext="P_{n}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>n</mi></msub><annotation encoding="application/x-tex">P_{n}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S2.Thmtheorem3" class="ltx_theorem ltx_theorem_claim">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmtheorem3.2" class="ltx_text ltx_font_bold">Claim 2.3</span></span><span id="S2.Thmtheorem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmtheorem3.p1" class="ltx_para">
<p id="S2.Thmtheorem3.p1.1" class="ltx_p"><span id="S2.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">Every <math id="S2.Thmtheorem3.p1.m1" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>-set includes either <math id="S2.Thmtheorem3.p1.m2" class="ltx_Math" alttext="v_{n-1}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">v_{n-1}</annotation></semantics></math> or <math id="S2.Thmtheorem3.p1.m3" class="ltx_Math" alttext="v_{n}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>n</mi></msub><annotation encoding="application/x-tex">v_{n}</annotation></semantics></math> but not both.</span></p>
</div>
</div>
<div id="S2.Thmtheorem4" class="ltx_theorem ltx_theorem_claim">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmtheorem4.2" class="ltx_text ltx_font_bold">Claim 2.4</span></span><span id="S2.Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmtheorem4.p1" class="ltx_para">
<p id="S2.Thmtheorem4.p1.1" class="ltx_p"><span id="S2.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">When <math id="S2.Thmtheorem4.p1.m1" class="ltx_Math" alttext="n=3k,k\geq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo>=</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mrow><mo>,</mo><mrow><mi>k</mi><mo>≥</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">n=3k,k\geq 1</annotation></semantics></math>, <math id="S2.Thmtheorem4.p1.m2" class="ltx_Math" alttext="\zeta(P_{n})=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ζ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\zeta(P_{n})=1</annotation></semantics></math> and the unique <math id="S2.Thmtheorem4.p1.m3" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>-set in <math id="S2.Thmtheorem4.p1.m4" class="ltx_Math" alttext="P_{n}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>n</mi></msub><annotation encoding="application/x-tex">P_{n}</annotation></semantics></math> contains <math id="S2.Thmtheorem4.p1.m5" class="ltx_Math" alttext="v_{n-1}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">v_{n-1}</annotation></semantics></math>. Moreover, when <math id="S2.Thmtheorem4.p1.m6" class="ltx_Math" alttext="n=3k+2,k\geq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo>=</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>+</mo><mn>2</mn></mrow></mrow><mo>,</mo><mrow><mi>k</mi><mo>≥</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">n=3k+2,k\geq 1</annotation></semantics></math>, there is only one <math id="S2.Thmtheorem4.p1.m7" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>-set in <math id="S2.Thmtheorem4.p1.m8" class="ltx_Math" alttext="P_{n}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>n</mi></msub><annotation encoding="application/x-tex">P_{n}</annotation></semantics></math> containing <math id="S2.Thmtheorem4.p1.m9" class="ltx_Math" alttext="v_{n}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>n</mi></msub><annotation encoding="application/x-tex">v_{n}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S2.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S2.p4" class="ltx_para">
<p id="S2.p4.1" class="ltx_p"><span id="S2.p4.1.1" class="ltx_text">When <math id="S2.p4.m1" class="ltx_Math" alttext="n=3k,k\geq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo>=</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mrow><mo>,</mo><mrow><mi>k</mi><mo>≥</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">n=3k,k\geq 1</annotation></semantics></math>, we have <math id="S2.p4.m2" class="ltx_Math" alttext="\zeta(P_{n})=k" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ζ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">\zeta(P_{n})=k</annotation></semantics></math> and the conclusion follows by the pigeon-hold argument alluded in Claim <a href="#S2.Thmtheorem1" title="Claim 2.1. ‣ 2 Dominion of Some Graphs ‣ Dominion of Some Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.1</span></a>. Each of the sets of <math id="S2.p4.m3" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math> consecutive vertices <math id="S2.p4.m4" class="ltx_Math" alttext="\{v_{3r+1},v_{3r+2},v_{3r+3}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>v</mi><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>v</mi><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>+</mo><mn>2</mn></mrow></msub><mo>,</mo><msub><mi>v</mi><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>+</mo><mn>3</mn></mrow></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{v_{3r+1},v_{3r+2},v_{3r+3}\}</annotation></semantics></math>, <math id="S2.p4.m5" class="ltx_Math" alttext="r=0,\ldots,k-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>r</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">r=0,\ldots,k-1</annotation></semantics></math>, must contain at least one vertex of any <math id="S2.p4.m6" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>-set <math id="S2.p4.m7" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>, and since <math id="S2.p4.m8" class="ltx_Math" alttext="\gamma=k" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">\gamma=k</annotation></semantics></math>, each of those sets must contain exactly one element of <math id="S2.p4.m9" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>. Since <math id="S2.p4.m10" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is dominating, the element of <math id="S2.p4.m11" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> in <math id="S2.p4.m12" class="ltx_Math" alttext="\{v_{1},v_{2},v_{3}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>v</mi><mn>1</mn></msub><mo>,</mo><msub><mi>v</mi><mn>2</mn></msub><mo>,</mo><msub><mi>v</mi><mn>3</mn></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{v_{1},v_{2},v_{3}\}</annotation></semantics></math> must be <math id="S2.p4.m13" class="ltx_Math" alttext="v_{1}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>1</mn></msub><annotation encoding="application/x-tex">v_{1}</annotation></semantics></math> or <math id="S2.p4.m14" class="ltx_Math" alttext="v_{2}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>2</mn></msub><annotation encoding="application/x-tex">v_{2}</annotation></semantics></math>. If <math id="S2.p4.m15" class="ltx_Math" alttext="v_{1}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>1</mn></msub><annotation encoding="application/x-tex">v_{1}</annotation></semantics></math> then the “next” element of <math id="S2.p4.m16" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> must be <math id="S2.p4.m17" class="ltx_Math" alttext="v_{4}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>4</mn></msub><annotation encoding="application/x-tex">v_{4}</annotation></semantics></math>, which forces <math id="S2.p4.m18" class="ltx_Math" alttext="S=\{v_{1},v_{4},\ldots,v_{3k-2}\}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>v</mi><mn>1</mn></msub><mo>,</mo><msub><mi>v</mi><mn>4</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>v</mi><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>−</mo><mn>2</mn></mrow></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">S=\{v_{1},v_{4},\ldots,v_{3k-2}\}</annotation></semantics></math>, leaving <math id="S2.p4.m19" class="ltx_Math" alttext="v_{3k}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">v_{3k}</annotation></semantics></math> uncovered. Therefore, the first element of <math id="S2.p4.m20" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> must be <math id="S2.p4.m21" class="ltx_Math" alttext="v_{2}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>2</mn></msub><annotation encoding="application/x-tex">v_{2}</annotation></semantics></math>, which forces <math id="S2.p4.m22" class="ltx_Math" alttext="S=\{v_{2},v_{5},\ldots,v_{3k-1},v_{3k+2}\}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>v</mi><mn>2</mn></msub><mo>,</mo><msub><mi>v</mi><mn>5</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>v</mi><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>v</mi><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>+</mo><mn>2</mn></mrow></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">S=\{v_{2},v_{5},\ldots,v_{3k-1},v_{3k+2}\}</annotation></semantics></math>.</span></p>
</div>
<div id="S2.p5" class="ltx_para">
<p id="S2.p5.1" class="ltx_p"><span id="S2.p5.1.1" class="ltx_text">Suppose that <math id="S2.p5.m1" class="ltx_Math" alttext="n=3k+2" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>+</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">n=3k+2</annotation></semantics></math>, and let <math id="S2.p5.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> be a <math id="S2.p5.m3" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>-set in <math id="S2.p5.m4" class="ltx_Math" alttext="V(P_{n})" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V(P_{n})</annotation></semantics></math>. Then <math id="S2.p5.m5" class="ltx_Math" alttext="|S|=k+1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">|S|=k+1</annotation></semantics></math>. Suppose that <math id="S2.p5.m6" class="ltx_Math" alttext="v_{n}\in S" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi>n</mi></msub><mo>∈</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">v_{n}\in S</annotation></semantics></math>. Then <math id="S2.p5.m7" class="ltx_Math" alttext="v_{n-1}\notin S" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>∉</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">v_{n-1}\notin S</annotation></semantics></math>, so <math id="S2.p5.m8" class="ltx_Math" alttext="S-\{v_{n}\}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>−</mo><mrow><mo stretchy="false">{</mo><msub><mi>v</mi><mi>n</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">S-\{v_{n}\}</annotation></semantics></math> must be a dominating set in <math id="S2.p5.m9" class="ltx_Math" alttext="P_{n}-\{v_{n},v_{n-1}\}=P_{3k}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mi>n</mi></msub><mo>−</mo><mrow><mo stretchy="false">{</mo><msub><mi>v</mi><mi>n</mi></msub><mo>,</mo><msub><mi>v</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">}</mo></mrow></mrow><mo>=</mo><msub><mi>P</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub></mrow><annotation encoding="application/x-tex">P_{n}-\{v_{n},v_{n-1}\}=P_{3k}</annotation></semantics></math>. Since <math id="S2.p5.m10" class="ltx_Math" alttext="|S-\{v_{n}\}|=k=\gamma(P_{3k})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>S</mi><mo>−</mo><mrow><mo stretchy="false">{</mo><msub><mi>v</mi><mi>n</mi></msub><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>=</mo><mi>k</mi><mo>=</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">|S-\{v_{n}\}|=k=\gamma(P_{3k})</annotation></semantics></math> it follows from the previous argument that <math id="S2.p5.m11" class="ltx_Math" alttext="S=\{v_{2},v_{5},\ldots,v_{3k-1},v_{3k+2}\}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>v</mi><mn>2</mn></msub><mo>,</mo><msub><mi>v</mi><mn>5</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>v</mi><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>v</mi><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>+</mo><mn>2</mn></mrow></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">S=\{v_{2},v_{5},\ldots,v_{3k-1},v_{3k+2}\}</annotation></semantics></math>.</span></p>
</div>
<div id="S2.p6" class="ltx_para">
<p id="S2.p6.1" class="ltx_p"><span id="S2.p6.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="S2.Thmtheorem5" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmtheorem5.2" class="ltx_text ltx_font_bold">Theorem 2.5</span></span><span id="S2.Thmtheorem5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmtheorem5.p1" class="ltx_para">
<p id="S2.Thmtheorem5.p1.1" class="ltx_p"><span id="S2.Thmtheorem5.p1.1.1" class="ltx_text ltx_font_italic">If <math id="S2.Thmtheorem5.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> is a path on <math id="S2.Thmtheorem5.p1.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> vertices, then its dominion is 
<br class="ltx_break"></span></p>
</div>
<div id="S2.Thmtheorem5.p2" class="ltx_para">
<p id="S2.Thmtheorem5.p2.1" class="ltx_p"><math id="S2.Thmtheorem5.p2.m1" class="ltx_Math" alttext="\zeta(G)=\begin{cases}1,&amp;\text{if}\ n\equiv 0\pmod{3}\hskip 36.135pt(i)\\
\frac{(n+2)(n+11)}{18}-1,&amp;\text{if}\ n\equiv 1\pmod{3}\hskip 36.135pt(ii)\\
{\lceil\frac{n}{3}\rceil}+1,&amp;\text{if}\ n\equiv 2\pmod{3}.\hskip 36.135pt(iii)\end{cases}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ζ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn>1</mn><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext class="ltx_mathvariant_italic">if</mtext><mo lspace="0.500em" rspace="0em">​</mo><mi>n</mi></mrow><mo>≡</mo><mrow><mn>0</mn><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0.167em">mod</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mspace style="width:3.61em;" width="3.61em"></mspace><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>11</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>18</mn></mfrac><mo>−</mo><mn>1</mn></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext class="ltx_mathvariant_italic">if</mtext><mo lspace="0.500em" rspace="0em">​</mo><mi>n</mi></mrow><mo>≡</mo><mrow><mn>1</mn><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0.167em">mod</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mspace style="width:3.61em;" width="3.61em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mo stretchy="false">⌈</mo><mfrac><mi>n</mi><mn>3</mn></mfrac><mo stretchy="false">⌉</mo></mrow><mo>+</mo><mn>1</mn></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext class="ltx_mathvariant_italic">if</mtext><mo lspace="0.500em" rspace="0em">​</mo><mi>n</mi></mrow><mo>≡</mo><mrow><mn>2</mn><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0.167em">mod</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo><mspace style="width:3.777em;" width="3.777em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\zeta(G)=\begin{cases}1,&amp;\text{if}\ n\equiv 0\pmod{3}\hskip 36.135pt(i)\\
\frac{(n+2)(n+11)}{18}-1,&amp;\text{if}\ n\equiv 1\pmod{3}\hskip 36.135pt(ii)\\
{\lceil\frac{n}{3}\rceil}+1,&amp;\text{if}\ n\equiv 2\pmod{3}.\hskip 36.135pt(iii)\end{cases}</annotation></semantics></math><span id="S2.Thmtheorem5.p2.1.1" class="ltx_text"></span></p>
</div>
