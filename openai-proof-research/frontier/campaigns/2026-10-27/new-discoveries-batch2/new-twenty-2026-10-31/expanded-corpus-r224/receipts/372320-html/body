<div id="id2" class="ltx_logical-block">
    
<div id="p1" class="ltx_para">
<p id="p1.1" class="ltx_p ltx_align_center"><span id="p1.1.1" class="ltx_text ltx_font_bold">Julian A.D. Allagan<sup id="p1.1.1.1" class="ltx_sup"><span id="p1.1.1.1.1" class="ltx_text ltx_font_italic">1</span></sup>, Benkam Bobga<sup id="p1.1.1.2" class="ltx_sup"><span id="p1.1.1.2.1" class="ltx_text ltx_font_italic">2</span></sup> 
