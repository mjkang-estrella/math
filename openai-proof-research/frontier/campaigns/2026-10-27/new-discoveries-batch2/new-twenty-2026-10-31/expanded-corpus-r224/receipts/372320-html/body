<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex12.m2" class="ltx_Math" alttext="\displaystyle=a_{k}+b_{k}=k+1+\frac{k^{2}+3k}{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>a</mi><mi>k</mi></msub><mo>+</mo><msub><mi>b</mi><mi>k</mi></msub></mrow><mo>=</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>k</mi><mn>2</mn></msup><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mrow><mn>2</mn></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=a_{k}+b_{k}=k+1+\frac{k^{2}+3k}{2}</annotation></semantics></math></td>
