import CrownVCoordMap

/-!
# Crown variety: the coordinate-span kernel inclusion

For any finite `T : Finset (CrownV.V n)` the ideal generated by the coordinate
generators `CrownV.xx v` and `CrownV.yy v` (`v ∈ T`) is contained in the kernel
of the sealed endomorphism `CrownV.coordKill T`.  This is the easy inclusion;
the reverse inclusion and primality are separate obligations and are not
claimed here.
-/

namespace CrownV

variable {n : Nat} {K : Type*} [CommRing K]

/-- Every coordinate generator `xx v` / `yy v` with `v ∈ T` lies in the kernel
of `coordKill T`, hence `Ideal.span (coordGens T)` is contained in that
kernel. -/
theorem coordSpan_le_ker (T : Finset (V n)) :
    Ideal.span (coordGens T : Set (PolyRing n K))
      ≤ RingHom.ker (coordKill (n := n) (K := K) T) := by
  refine Ideal.span_le.2 ?_
  intro p hp
  simp only [coordGens, Set.mem_ofPred_eq] at hp
  obtain ⟨v, hv, rfl | rfl⟩ := hp
  · exact RingHom.mem_ker.2 (coordKill_xx_eq_zero T hv)
  · exact RingHom.mem_ker.2 (coordKill_yy_eq_zero T hv)

end CrownV
