#!/bin/bash
set -eu
export TMPDIR="$PWD/tmp" MALLOC_ARENA_MAX=2
mkdir -p "$TMPDIR"
exec 9>"$TMPDIR/heavy.lock"
flock 9
ulimit -c 0
ulimit -t 120
cpus=$(awk '/Cpus_allowed_list/ {print $2}' /proc/self/status)
first=${cpus%%[-,]*}; second=$((first+1))
timeout -k 2s 140s taskset -c "$first,$second" "$@" &
pid=$!
trap 'kill "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true' EXIT
while kill -0 "$pid" 2>/dev/null; do
  rss=0
  for p in "$pid" $(pgrep -P "$pid" || true); do
    if [ -r /proc/$p/status ]; then
      r=$(awk '/VmRSS:/ {print $2}' /proc/$p/status)
      rss=$((rss+${r:-0}))
    fi
  done
  if [ "$rss" -gt 6291456 ]; then kill -TERM "$pid" 2>/dev/null || true; echo 'RSS limit exceeded' >&2; break; fi
  sleep 0.2
done
set +e
wait "$pid"; rc=$?
trap - EXIT
exit "$rc"
