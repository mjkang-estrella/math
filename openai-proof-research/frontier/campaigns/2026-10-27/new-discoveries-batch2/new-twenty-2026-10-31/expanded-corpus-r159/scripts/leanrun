#!/bin/bash
D="$(cd "$(dirname "$0")/.." && pwd)"
P=/home/mj-kang/Documents/Dev/math/openai-proof-research/frontier/campaigns/2026-10-14/formal/.lake/packages
export LEAN_PATH="$D/lean"
for x in "$P"/*; do export LEAN_PATH="$LEAN_PATH:$x/.lake/build/lib/lean"; done
exec "$D/scripts/run" "$1" /home/mj-kang/Documents/Dev/math/dlp-research/.tools/lean-4.34.1-linux/bin/lean -M3500 -DwarningAsError=true "${@:2}"
