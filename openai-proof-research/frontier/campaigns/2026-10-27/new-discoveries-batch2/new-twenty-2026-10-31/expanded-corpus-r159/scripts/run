#!/bin/bash
set -u
ulimit -c 0
D="$(cd "$(dirname "$0")/.." && pwd)"
export TMPDIR="$D/tmp" XDG_CACHE_HOME="$D/cache" PYTHONDONTWRITEBYTECODE=1 MALLOC_ARENA_MAX=2 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=2
cd "$D"
name="$1"
shift
start=$SECONDS
setsid timeout -k 2s 140s taskset -c 0,1 prlimit --cpu=120 --as=68719476736 -- "$@" > "$D/logs/$name.log" 2>&1 &
pid=$!
peak=0
while kill -0 "$pid" 2>/dev/null; do
 rss=0
 for x in $(ps -eo pid,pgid | awk -v p="$pid" '$2==p {print $1}'); do
  v=$(awk '/VmRSS:/ {print $2}' "/proc/$x/status" 2>/dev/null)
  rss=$((rss + ${v:-0}))
 done
 ((rss>peak)) && peak=$rss
 if ((rss>6291456)); then kill -KILL -- "-$pid" 2>/dev/null; fi
 sleep 0.1
done
wait "$pid"
rc=$?
printf '{"exit":%s,"wall_s":%s,"sampled_group_rss_kib":%s,"cpu_s":120,"wall_cap_s":140,"cpus":"0,1"}\n' "$rc" "$((SECONDS-start))" "$peak" > "$D/logs/$name.receipt.json"
cat "$D/logs/$name.receipt.json"
exit "$rc"
