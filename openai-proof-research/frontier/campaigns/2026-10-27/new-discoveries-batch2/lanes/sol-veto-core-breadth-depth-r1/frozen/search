        The <span class="search-hit mathjax">metric</span>&hellip;
        <a class="is-size-7" style="white-space: nowrap;" onclick="document.getElementById('2206.07098v2-abstract-full').style.display = 'inline'; document.getElementById('2206.07098v2-abstract-short').style.display = 'none';">&#9661; More</a>
