fun r hr =>
  JacobiShifted.source_claim r
    hr : ∀ (r : ℕ),
  1 ≤ r →
    (∀ (m : Fin 2 →₀ ℕ),
        JacobiShifted.TwoLocal (2 ^ JacobiShifted.dyadicExponent r * (JacobiShifted.sourceKappa r).coeff m)) ∧
      ¬JacobiShifted.TwoLocal
          (2 ^ (JacobiShifted.dyadicExponent r - 1) * (JacobiShifted.sourceKappa r).coeff (Finsupp.single 0 r))
fun r hr =>
  have this := JacobiShifted.source_claim r hr;
  this : ∀ (r : ℕ),
  1 ≤ r →
    (∀ (m : Fin 2 →₀ ℕ),
        Odd
          (2 ^ (2 * r + padicValNat 2 (r - 1).factorial) *
              (if r = 0 then 0
                  else MvPolynomial.C (2 ^ (2 * r - 1))⁻¹ * (JacobiShifted.sourceLogCoeff (2 * r - 1)).im).coeff
                m).den) ∧
      ¬Odd
          (2 ^ (2 * r + padicValNat 2 (r - 1).factorial - 1) *
              (if r = 0 then 0
                  else MvPolynomial.C (2 ^ (2 * r - 1))⁻¹ * (JacobiShifted.sourceLogCoeff (2 * r - 1)).im).coeff
                (Finsupp.single 0 r)).den
def JacobiShifted.sourceLogCoeff : ℕ → JacobiShifted.GPoly :=
fun n =>
  ∑ k ∈ Finset.range (n + 1),
    if k = 0 then 0
    else JacobiShifted.scalar ((-1) ^ (k + 1) / ↑k) * JacobiShifted.powerCoeff JacobiShifted.sourceAugmentCoeff k n
def JacobiShifted.sourceAugmentCoeff : ℕ → JacobiShifted.GPoly :=
fun n => if n = 0 then 0 else JacobiShifted.sourceFCoeff n
def JacobiShifted.sourceFCoeff : ℕ → JacobiShifted.GPoly :=
fun n =>
  ∑ s ∈ Finset.range (n + 1), JacobiShifted.scalar (JacobiShifted.inverseFactorCoeff s n) * JacobiShifted.sourceC s
def JacobiShifted.sourceC : ℕ → JacobiShifted.GPoly :=
fun s =>
  ∑ l ∈ Finset.range (s + 1),
    JacobiShifted.scalar (1 / (↑l.factorial * ↑(s - l).factorial)) *
          JacobiShifted.embed (JacobiShifted.hankelNumerator 0 l * JacobiShifted.hankelNumerator 1 (s - l)) *
        JacobiShifted.midpointX ^ l *
      JacobiShifted.midpointY ^ (s - l)
def JacobiShifted.hankelNumerator : Fin 2 → ℕ → JacobiShifted.QPoly :=
fun i l => ∏ j ∈ Finset.range l, (MvPolynomial.X i - MvPolynomial.C (↑j * (↑j + 1)))
def JacobiShifted.inverseFactorCoeff : ℕ → ℕ → ℚ :=
fun x x_1 => Nat.brecOn (motive := fun x => ℕ → ℚ) x JacobiShifted.inverseFactorCoeff._f x_1
def JacobiShifted.powerCoeff : (ℕ → JacobiShifted.GPoly) → ℕ → ℕ → JacobiShifted.GPoly :=
fun f x x_1 => Nat.brecOn (motive := fun x => ℕ → JacobiShifted.GPoly) x (JacobiShifted.powerCoeff._f f) x_1
def JacobiShifted.midpointX : JacobiShifted.GPoly :=
{ re := MvPolynomial.C (1 / 2), im := MvPolynomial.C (1 / 2) }
def JacobiShifted.midpointY : JacobiShifted.GPoly :=
{ re := MvPolynomial.C (1 / 2), im := MvPolynomial.C (-1 / 2) }
