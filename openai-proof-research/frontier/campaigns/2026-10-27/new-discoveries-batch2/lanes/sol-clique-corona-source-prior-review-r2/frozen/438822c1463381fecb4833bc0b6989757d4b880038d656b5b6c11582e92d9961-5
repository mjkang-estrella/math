hub.com/the-omega-institute/trureturing/raw/b62773edfb6a6f7806de09b593b2e3b6834685c7/Reg%2FD5%2FS3%2FVertexAlgebra%2FSourceBPZ%2FNormalScalarTranspose.lean","contents_url":"https://api.github.com/repos/the-omega-institute/trureturing/contents/Reg%2FD5%2FS3%2FVertexAlgebra%2FSourceBPZ%2FNormalScalarTranspose.lean?ref=b62773edfb6a6f7806de09b593b2e3b6834685c7","patch":"@@ -0,0 +1,99 @@\n+import Reg.Support.FactorialFockMetric\n+import Reg.Support.SingleDependentReadout\n+import LeanInformationAuditInterface.Contract.Registration\n+import D5.S3.VertexAlgebra.SourceBPZ.NormalScalarTranspose\n+\n+/-! Exact-telescope dependent-family registration of the original scalar\n+insertion theorem. Equality is the observed complex scalar readout; no finite\n+parameter catalog replaces the arbitrary lattice, form, fields or label type. -/\n+\n+set_option autoImplicit false\n+set_option backward.isDefEq.respectTransparency false\n+noncomputable section\n+universe u\n+open scoped BigOperators VertexOperator\n+namespace Reg.D5.S3.VertexAlgebra.SourceBPZ.NormalScalarTranspose\n+open LeanInformationAudit\n+open _root_.D5.S3.ConceptDynamics.InformationEscape.DependentFamily\n+open _root_.D5.S3.VertexAlgebra\n+open LatticeGeneratingFieldLocality LatticeFiniteNegativeGeneration LatticeSugawaraCurrents\n+open _root_.D5.S3.VertexAlgebra.SourceBPZ\n+open Reg.D5.S3.VertexAlgebra.FactorialFockMetric\n+  (complexSignature complexEqual complexFalse complexEqualDependence)\n+\n+private def zeroLattice : LatticeData where\n+  rank := 1\n+  G := 0\n+  symmetric := by intro i j; rfl\n+  even_diagonal := by intro i; exact ⟨0, rfl⟩\n+\n+def arena : Arena where\n+  signature := complexSignature\n+  Law R := ∀ (D : LatticeData)\n+    (B : LinearMap.BilinForm ℂ (Carrier D)) (i : Fin D.rank)\n+    (hB : ∀ k x y, B (neutralMode D i k x) y = -B x (neutralMode D i (-k) y))\n+    (p : ℕ) (F : VertexOperator ℂ (Carrier D))\n+    {σ : Type u} (S : Finset σ) (G : σ → VertexOperator ℂ (Carrier D))\n+    (weight : σ → ℂ) (K : σ → ℤ) (κ : ℂ)\n+    (htail : ∀ t x y, B ((F[[t]]) x) y =\n+      ∑ a ∈ S, weight a * B x (((G a)[[K a - t]]) y))\n+    (hzero : ∀ a ∈ S, ∀ t x, neutralMode D i 0 (((G a)[[t]]) x) =\n+      ((G a)[[t]]) (neutralMode D i 0 x) + κ • ((G a)[[t]]) x)\n+    (m : ℤ) (u v : Carrier D),\n+    R.readout () ()\n+      (B (((insertion D i p F)[[m]]) u) v)\n+      ((-1 : ℂ)^(p+1) * ∑ a ∈ S, weight a *\n+        ((∑ s ∈ Finset.range (p+1), ((p+1).choose (s+1) : ℂ) *\n+          B u (((insertion D i s (G a))[[K a+p+s+2-m]]) v)) +\n+          κ * B u (((G a)[[K a+p+1-m]]) v)))\n+\n+private theorem source_bridge :\n+    (type_of% (@consumed_normal_product_form.{u})) ↔ arena.{u}.Law complexEqual := Iff.rfl\n+\n+private theorem rejected_law : ¬ arena.{u}.Law complexFalse := by\n+  intro h\n+  exact h zeroLattice 0 ⟨0, by decide⟩ (by intros; simp) 0 0\n+    (∅ : Finset (ULift.{u} Unit)) (fun _ => 0) (fun _ => 0) (fun _ => 0) 0\n+    (by intros; simp) (by simp) 0 0 0\n+\n+def family : Registration arena.{u} (type_of% (@consumed_normal_product_form.{u})) where\n+  actual := complexEqual\n+  bridge := source_bridge\n+  variation := ⟨source_bridge.mp consumed_normal_product_form, complexFalse, rejected_law⟩\n+  sensitivity := Reg.Support.SingleDependentReadout.sensitivity arena.Law\n+    complexEqual complexFalse rejected_law\n+  dependence := complexEqualDependence\n+\n+def audit : Contract.Registration.{_,_,_,0,0,0,_,_,_,_,_,0}\n+    (@consumed_normal_product_form.{u})\n+    (type_of% (realize complexSignature complexEqual.readout complexEqual.anchor)) Type Unit where\n+  unitName := Lean.Name.str `D5.S3.VertexAlgebra.SourceBPZ.NormalScalarTranspose.consumed_normal_product_form \"__information_unit\"\n+  realizationName := `Reg.D5.S3.VertexAlgebra.SourceBPZ.NormalScalarTranspose.family\n+  realizationSource := none\n+  generated := false\n+  arena := .source ⟨arena⟩\n+  objectArena := .source ⟨arena⟩\n+  catalog := Lean.Name.anonymous\n+  localNames := false\n+  realization := .source arena ⟨family⟩\n+  correspondence := { stage := .evidence, objectStage := .evidence }\n+  bundleNonempty := .absent\n+  readout := some (realize complexSignature complexEqual.readout complexEqual.anchor)\n+  variation := .absent\n+  sensitivity := .absent\n+  partialSensitivity := none\n+  escapeFrom := some ℂ\n+  sourceSelection := some {\n+    owner := `D5.S3.VertexAlgebra.SourceBPZ.NormalScalarTranspose\n+    definition := none\n+    coordinates := #[]\n+    readouts := #[{\n+      path := #[\"body\", \"body\", \"body\", \"body\", \"body\", \"body\", \"body\", \"body\", \"body\", \"body\", \"body\", \"body\", \"body\", \"body\", \"body\", \"body\", \"body\", \"fn\", \"fn\"]\n+      stateBinder := 0\n+      functionOperand := true\n+      stateOperand := none\n+      booleanPredicate := false }] }\n+  continuation := .unknown\n+  familyRecord := none\n+  options := #[]\n+end Reg.D5.S3.VertexAlgebra.SourceBPZ.NormalScalarTranspose"},{"sha":"8116d9a377ba208e7b405516911711575ac6fdc1","filename":"docs/develop/spec/golden-ledger-repo-spec.md","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/the-omega-institute/trureturing/blob/b62773edfb6a6f7806de09b593b2e3b6834685c7/docs%2Fdevelop%2Fspec%2Fgolden-ledger-repo-spec.md","raw_url":"https://github.com/the-omega-institute/trureturing/raw/b62773edfb6a6f7806de09b593b2e3b6834685c7/docs%2Fdevelop%2Fspec%2Fgolden-ledger-repo-spec.md","contents_url":"https://api.github.com/repos/the-omega-institute/trureturing/contents/docs%2Fdevelop%2Fspec%2Fgolden-ledger-repo-spec.md?ref=b62773edfb6a6f7806de09b593b2e3b6834685c7","patch":"@@ -403,7 +403,7 @@ For normal finalization the host first joins this task's writers/children, then\n \n **Blocked Git operation native-lock clearance.** Only an ordinary checkpoint blocked by its index or current branch/HEAD ref lock, or an owned initialization recovery blocked while loading its native index, may clear that exact lock, under exclusive tree, index and all relevant ref scopes with registered identity verified. Complete inspection of the exact path through macOS/Linux `lsof`, or Linux `/proc/*/fd`, must report no holder. Unavailable, denied or incomplete inspection retains with `native_lock_unverifiable:<path>`; a holder retains with `native_lock_held:<path>`. Immediately before unlink, device/inode, size and modification time must match the inspected file; replacement retains with `native_lock_changed:<path>`. Canonical checkpoint and removal receipts include every observed lock path, size, age and outcome, including clearances before a later failure and during removal-record reconvergence. Age and size are observations, never certificates; no minimum age applies. Unlink only the certified file, then retry the blocked checkpoint or initialization index load once. Packed-refs and unrelated locks are never cleared. Non-cooperative Git that closes its lock descriptor before committing is outside this guarantee. Ordinary checkpoints and compatible reuse retain shared tree entry. Initialization and native-lock recovery require exclusive entry, as do return, claim and idle validation under their rules above.\n \n-**Common worktree removal rule.** Named, automatic, mirror, runlocal and aggregate registered-tree removal use `worktree_preservation.py`. Selected unlocked worktrees are eligible. Intentional Git worktree locks (manual, empty or unrecognized reasons outside worktree-init:) require at least 24 hours since lock-file modification; future or unavailable timestamps refuse removal. Initialization markers instead follow the exclusive-scope liveness rule above. Keep repository/backlink/registration identity, main checkout and nested registration protection. Preflight the entire named batch before any checkpoint mutation and recheck each target before removal. An eligible tree checkpoints ordinary outstanding changes using its real index. For detached HEAD, it creates a new local `lane/governance/recovery-<unique-token>` branch at the resulting HEAD before removal; native branch creation never replaces an existing ref. The detached HEAD/index scope covers the compound operation; the new ref scope runs from branch creation through removal. A clean detached tree retains its existing HEAD without an empty commit. Removal retains the current or newly created recovery branch and reachable common Git objects. Immediately before native deletion, removal records the checkpoint commit and recovery branch in the tree's Git metadata. A later removal of a tree carrying that record resumes native deletion without a new checkpoint when HEAD and the recovery branch still resolve to the recorded commit and the working tree differs only by deleted tracked files; if the snapshot moved, it first pins the recorded commit under a new non-replacing recovery ref, checkpoints current ordinary work into a new snapshot, verifies both recovery roots, and atomically replaces the record while carrying predecessor commit/ref pairs. Every resume acquires the recorded predecessor ref scopes, validates their commit/ref pairs and carries all predecessor roots through removal and the invocation's orphan sweep, including after successful record replacement followed by interrupted native deletion. Interruption leaves the record and recovery objects intact; deleting the record is never a recovery action. Other later tree changes retain the tree with the concrete reason. Unmerged/unfinished operations, failed commits, failed branch creation (including name collisions), or ordinary changes remaining after checkpoint retain the affected tree with the concrete reason. A failed branch creation leaves any completed detached checkpoint at the registered tree for retry. Failure reports distinguish a confirmed recovery branch from an attempted candidate whose creation may have failed. Earlier completed removals are not rolled back or misreported. The recovery branch and predecessor recovery roots are excluded from the entire invocation's orphan sweep, including when clean or local-only. No empty commit is created for a clean tree. Ignored/cache files and intermediate staged versions are not recovery obligations. Ordinary removals without a blocking native transaction lock perform no holder inspection. Process, open file, cwd, mapping, activity or cache use do not otherwise govern deletion; initialization liveness and blocked-checkpoint native-lock recovery use the scoped checks above. Git index/ref operation coordination only protects checkpoint/removal against competing Git operations. Native force removes ignored material, and double force handles an elapsed Git lock without first unlocking it. Ordinary removal requires no automatic push or remote confirmation; timely publication is separate, while merged-task return and idle eligibility follow their specific remote-dev rules. Native `git worktree add PATH BRANCH` recovers the committed snapshot while its branch and objects remain intact; permanent local-ref retention is not promised.\n+**Common worktree removal rule.** Named, automatic, mirror, runlocal and aggregate registered-tree removal use `worktree_preservation.py`. Selected unlocked worktrees are eligible. Intentional Git worktree locks (manual, empty or unrecognized reasons outside worktree-init:) require at least 24 hours since lock-file modification; future or unavailable timestamps refuse removal. Initialization markers instead follow the exclusive-scope liveness rule above. Keep repository/backlink/registration identity, main checkout and nested registration protection. Refuse indexed gitlinks, nested `.git` boundaries and nested bare repositories with `nested_git_boundary:<path>` before any checkpoint or content deletion, including inside ignored directories; recheck before payload deletion. Preflight the entire named batch before any checkpoint mutation and recheck each target before removal. An eligible tree checkpoints ordinary outstanding changes using its real index. For detached HEAD, it creates a new local `lane/governance/recovery-<unique-token>` branch at the resulting HEAD before removal; native branch creation never replaces an existing ref. The detached HEAD/index scope covers the compound operation; the new ref scope runs from branch creation through removal. A clean detached tree retains its existing HEAD without an empty commit. Removal retains the current or newly created recovery branch and reachable common Git objects. Before content deletion, removal records the checkpoint commit and recovery branch in the tree's Git metadata. It deletes all contents except the root `.git` link while retaining registration and that readable record. A content-deletion failure or interruption leaves the tree registered for retry; native `git worktree remove` runs only after no other contents remain. A native unregistration failure therefore leaves no content payload. A later removal of a tree carrying that record resumes deletion without a new checkpoint when HEAD and the recovery branch still resolve to the recorded commit and the working tree differs only by deleted tracked files or paths ignored by the checkpoint’s tracked `.gitignore` files and the ordinary Git exclude sources. Ignore inspection uses a temporary rules tree without restoring deleted payload or changing the index; later ordinary untracked files still retain the tree. If the snapshot moved, it first pins the recorded commit under a new non-replacing recovery ref, checkpoints current ordinary work into a new snapshot, verifies both recovery roots, and atomically replaces the record while carrying predecessor commit/ref pairs. Every resume acquires the recorded predecessor ref scopes, validates their commit/ref pairs and carries all predecessor roots through removal and the invocation's orphan sweep, including after successful record replacement followed by interrupted content deletion. Content-deletion interruption leaves the record and recovery objects intact; deleting the record is never a recovery action. Other later tree changes retain the tree with the concrete reason. Unmerged/unfinished operations, failed commits, failed branch creation (including name collisions), or ordinary changes remaining after checkpoint retain the affected tree with the concrete reason. A failed branch creation leaves any completed detached checkpoint at the registered tree for retry. Failure reports distinguish a confirmed recovery branch from an attempted candidate whose creation may have failed. Earlier completed removals are not rolled back or misreported. The recovery branch and predecessor recovery roots are excluded from the entire invocation's orphan sweep, including when clean or local-only. No empty commit is created for a clean tree. Ignored/cache files and intermediate staged versions are not recovery obligations. Ordinary removals without a blocking native transaction lock perform no holder inspection. Process, open file, cwd, mapping, activity or cache use do not otherwise govern deletion; initialization liveness and blocked-checkpoint native-lock recovery use the scoped checks above. Git index/ref operation coordination only protects checkpoint/removal against competing Git operations. Content deletion includes ignored material; native double force handles an elapsed Git lock without first unlocking it. Ordinary removal requires no automatic push or remote confirmation; timely publication is separate, while merged-task return and idle eligibility follow their specific remote-dev rules. Native `git worktree add PATH BRANCH` recovers the committed snapshot while its branch and objects remain intact; permanent local-ref retention is not promised.\n \n `make -C tools clean-lanes` previews; `FORCE=1` executes through the same automatic selection. Each invocation pins `refs/remotes/origin/dev^{commit}` as immutable D and reports it in the summary. BASE only supplies the original behind count; merge judgments, including orphan branches, use D. After main/identity/registration, nested-tree, intentional-lock age and initialization-scope protection, an observed H is eligible for the merged shortcut when `git merge-base --is-ancestor H D` exits 0, its working tree has no tracked/untracked changes or unfinished Git operation, and both its HEAD committer age and allocation age are at least 3 hours. Known unmerged trees and known merged trees with outstanding work require both ages to be at least 24 hours and at least 300 commits behind BASE. The last update of observed HEAD H is its committer Unix time (`git show -s --format=%ct H`), independently of lock-file age. Author time, directory timestamps, reads, checkout/reset and later reflog entries never renew it. Allocation evidence belongs to the tree independently of its current attachment. Its anchor is the maximum of the first retained HEAD reflog timestamp, explicit allocation-record timestamps, and corroborated legacy branch-creation timestamps since the last explicit allocation record. For every HEAD `checkout: moving from X to B` record since the latest explicit allocation, classify B under Git's native `git check-ref-format --branch` rules, excluding `HEAD` and revision expressions that Git expands to a different branch name. Only destinations that cannot themselves name a local branch, such as `HEAD~1`, `@{-1}`, `x^0`, `a..b` or `:path`, supply no legacy allocation. Every syntactically valid local-branch name, including full 40/64-hex object IDs, `refs/...`-prefixed names, remote-looking names and tags, uses native local-ref identity and retained local branch logs with no spelling exemption. For each such record, with new OID C at Unix time T, use exactly one class: (a) allocation, when a surviving same-generation branch creation record has all-zero old OID, new OID C and timestamp T; (b) existing-branch checkout, when that generation's creation strictly precedes T; (c) ambiguous otherwise, including absent local ref/log evidence, creation after the checkout, rename/name reuse or copied history, equal timestamps with different commits or any unprovable historical identity. Native `git switch -c B` supplies the creation/checkout pair. Reconstruct historical spelling through retained native branch-renaming records; a copied history does not establish destination identity before the copy. Current spelling or revision resolution does not establish a generation's identity at T. Each class (c) record protects the tree only within the applicable 3-hour or 24-hour allocation grace measured from its own timestamp, then imposes no selection constraint; this supplies only an age bound, never a corroborated allocation anchor for validating other branch evidence. Class (b) supplies no allocation timestamp. Explicit allocation records remain authoritative. Read the retained HEAD history even after detaching or switching elsewhere, and validate each surviving branch log against that branch's current tip rather than against the tree's HEAD. Missing, invalid or contradictory required surviving local evidence retains with `update_unknown`; reset and reads supply no allocation evidence. Without an explicit allocation record, also validate the attached branch log. Missing or invalid required legacy evidence with surviving local identity retains the tree instead of dropping its protection. If the first retained branch record is no longer a creation record and is later than the already established allocation anchor, retain with `update_unknown` and `selection_detail=branch_allocation_unverifiable`; an already dominated first-record timestamp supplies no new allocation anchor, and unprovable checkouts still use class (c). With timestamps ordered across related creation/checkout records and each reflog, prefix expiry cannot shorten the applicable allocation grace: later retained anchors or bounded historical ambiguity preserve it, while damaged surviving evidence retains; no such guarantee is made for nonmonotone clocks. A fresh tree or a newly claimed branch at an old commit must pass the separate allocation grace, including before its first commit. Ancestry exit 1 means unmerged; other exits retain with `merged_state_unknown`. Unresolved D retains with `dev_unknown`; missing, empty, damaged or tip-mismatched allocation reflogs or unreadable commit time retain with `update_unknown` and a concrete `selection_detail` (`reflog_*` for HEAD, `branch_reflog_*` for attached or historical branches, `allocation_record_invalid` for malformed explicit evidence, `head_commit_unreadable` for the commit). Future committer or allocation timestamps retain with `age_unverifiable`. Dirty trees never use the clean shortcut; ordinary new bytes must be checkpointed successfully before removal regardless of the old commit age. Conflicts and unfinished Git operations retain through the preservation preflight. The shortcut reports `merged_to_dev`; the original rules report `selection_reason=original_selectors` alongside their selector outcome. FORCE reobserves H, branch, registration, lock and Git directory, then recomputes the selection result before preservation/removal; any changed observation or selection result retains with `race_changed`. Original-selector removal checkpoints ordinary changes, including changes made after selection. Detached and non-managed branch trees participate in this selection. Explicit named removal bypasses these automatic selectors. Unknown identity or selection readings retain the affected target. Unresolved attachments, locks, refused or partial removals defer extra sweeps. Orphan ref retirement retains its separate ref scope, attachment/observed-tip checks and remote retention policy; branches observed attached or created for recovery during this invocation are excluded, even after successful tree removal. Remote refs are never deleted. Unregistered snapshots and other non-worktree host artifacts retain their independent preservation/activity policy. `clean-runlocal.sh`