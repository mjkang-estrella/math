claration_name_key\":\"ns(ns(ns(ns(ns(nn(ns(ns(ns(ns(ns(ns(n0,8:_private),2:D5),2:S3),13:VertexAlgebra),9:SourceBPZ),21:NormalScalarTranspose),0),2:D5),2:S3),13:VertexAlgebra),9:SourceBPZ),22:reflected_to_insertion)\",\"kind\":\"theorem\"},{\"declaration_name_key\":\"ns(ns(ns(ns(ns(nn(ns(ns(ns(ns(ns(ns(n0,8:_private),2:D5),2:S3),13:VertexAlgebra),9:SourceBPZ),21:NormalScalarTranspose),0),2:D5),2:S3),13:VertexAlgebra),9:SourceBPZ),6:cutoff)\",\"kind\":\"def\"}]}"},{"sha":"b9d35446c12ca8cd05b916781b7219d816ea9c2a","filename":"Library/Entropy/bowen1971entropy.md","status":"added","additions":37,"deletions":0,"changes":37,"blob_url":"https://github.com/the-omega-institute/trureturing/blob/b62773edfb6a6f7806de09b593b2e3b6834685c7/Library%2FEntropy%2Fbowen1971entropy.md","raw_url":"https://github.com/the-omega-institute/trureturing/raw/b62773edfb6a6f7806de09b593b2e3b6834685c7/Library%2FEntropy%2Fbowen1971entropy.md","contents_url":"https://api.github.com/repos/the-omega-institute/trureturing/contents/Library%2FEntropy%2Fbowen1971entropy.md?ref=b62773edfb6a6f7806de09b593b2e3b6834685c7","patch":"@@ -0,0 +1,37 @@\n+---\n+bibkey: bowen1971entropy\n+authors: Rufus Bowen\n+year: 1971\n+title: Entropy for group endomorphisms and homogeneous spaces\n+doi: 10.1090/S0002-9947-1971-0274707-X\n+url: https://doi.org/10.1090/S0002-9947-1971-0274707-X\n+claim: Classical context for entropy comparison under factor maps and finite-to-one extensions.\n+strata_touched:\n+  - D5/S1/Dynamics/FiniteFiberEntropy\n+license: citation-only\n+triage: anchor\n+---\n+\n+# Entropy for group endomorphisms and homogeneous spaces\n+\n+## Verified locator\n+\n+- DOI: https://doi.org/10.1090/S0002-9947-1971-0274707-X (Crossref identifies *Transactions of the American Mathematical Society*, volume 153, pages 401–414, published 1971).\n+- The DOI and bibliographic fields were checked against the Crossref work record. No theorem, equation, or page-specific claim is attributed to Bowen beyond the general factor-entropy context stated below.\n+\n+Bowen's article appeared in Transactions of the American Mathematical Society,\n+volume 153 (1971), pp. 401–414. This reference acknowledges the classical\n+factor-entropy framework; no novelty is claimed for entropy preservation by\n+uniformly finite-to-one compact factors.\n+\n+The repository proves its exact compact-uniform-space statement independently:\n+a continuous surjective semiconjugacy, continuous source dynamics, Hausdorff\n+target, and an explicit uniform natural-number bound on finite fibers imply\n+equality of covering entropy. Its block-cover construction bounds the lift\n+cost over r blocks by M^r and sends the entropy cost log(M)/n to zero.\n+\n+The formal statement includes empty spaces, infinite entropy and a source\n+that need not be Hausdorff. These exact hypotheses and endpoint conventions\n+are supplied by the Lean proof, not asserted to be a literal quotation from\n+Bowen. Bibliographic identity was checked against Crossref; no numbered\n+statement or page-specific quotation from the article is asserted here."},{"sha":"7faaf4662fac39b0a6703608f188e85f4e4a08c9","filename":"Reg/D5/S3/Arith/FactorialRatio/DyadicBinomialCancellation.lean","status":"added","additions":112,"deletions":0,"changes":112,"blob_url":"https://github.com/the-omega-institute/trureturing/blob/b62773edfb6a6f7806de09b593b2e3b6834685c7/Reg%2FD5%2FS3%2FArith%2FFactorialRatio%2FDyadicBinomialCancellation.lean","raw_url":"https://github.com/the-omega-institute/trureturing/raw/b62773edfb6a6f7806de09b593b2e3b6834685c7/Reg%2FD5%2FS3%2FArith%2FFactorialRatio%2FDyadicBinomialCancellation.lean","contents_url":"https://api.github.com/repos/the-omega-institute/trureturing/contents/Reg%2FD5%2FS3%2FArith%2FFactorialRatio%2FDyadicBinomialCancellation.lean?ref=b62773edfb6a6f7806de09b593b2e3b6834685c7","patch":"@@ -0,0 +1,112 @@\n+import LeanInformationAuditInterface.Contract.Registration\n+import D5.S3.Arith.FactorialRatio.DyadicBinomialCancellation\n+import Reg.Support.DependentFamily\n+\n+/-! # Dependent-family audit of the all-index reduced-fraction formula\n+\n+The kernel-checked family proof below is an attempted registration, not a\n+validated escape audit. The tuple readout has no literal source occurrence;\n+lawful source selection and complete source reconstruction remain missing.\n+See https://github.com/the-omega-institute/trureturing/issues/23314.\n+-/\n+\n+namespace Reg.D5.S3.Arith.FactorialRatio.DyadicBinomialCancellation\n+\n+open _root_.D5.S3.Arith.FactorialRatio.DyadicBinomialCancellation\n+open _root_.D5.S3.ConceptDynamics.InformationEscape.DependentFamily\n+open LeanInformationAudit\n+\n+noncomputable section\n+\n+abbrev signature : Signature where\n+  Params := Unit\n+  State _ := ℕ\n+  Role := Unit\n+  finiteRole := inferInstance\n+  nonemptyRole := inferInstance\n+  Output _ _ := ℤ × ℕ × ℤ\n+  Anchor := Empty\n+  finiteAnchor := inferInstance\n+\n+def actual : Realization signature :=\n+  realize signature (fun _ _ n => ((g n).num, (f n / g n).den, (f n / g n).num))\n+    (fun e => nomatch e)\n+\n+abbrev arena : Arena where\n+  signature := signature\n+  Law R := ∀ n : ℕ, 1 ≤ n →\n+    let m := n - n / 2\n+    let B := n.choose (n / 2)\n+    let v := B.factorization 2\n+    let b := B / 2 ^ v\n+    let G := (2 ^ n - B) / 2 ^ v\n+    R.readout () () n = ((G : ℤ), G / Nat.gcd m G,\n+      ((m * b / Nat.gcd m G : ℕ) : ℤ))\n+\n+def rejected : Realization signature :=\n+  realize signature (fun _ _ _ => (0, 0, 0)) (fun e => nomatch e)\n+\n+theorem rejected_law : ¬ arena.Law rejected := by\n+  intro h\n+  have hh := h 1 (by decide)\n+  norm_num [rejected, realize, Nat.choose] at hh\n+  have h0 := congrArg Prod.fst hh\n+  norm_num at h0\n+\n+def registration : Registration arena (type_of% @denominator_formula) where\n+  actual := actual\n+  bridge := by\n+    simp only [actual, realize, Prod.mk.injEq]\n+  variation := ⟨(by\n+    intro n hn\n+    simpa [actual, realize] using denominator_formula n hn), rejected, rejected_law⟩\n+  sensitivity := by\n+    constructor\n+    · intro role\n+      refine ⟨rejected, ?_, rfl, rejected_law⟩\n+      intro other hne\n+      exact (hne (Subsingleton.elim _ _)).elim\n+    · intro e\n+      exact nomatch e\n+  dependence := by\n+    intro role\n+    refine ⟨(), 1, 3, ?_⟩\n+    change ((g 1).num, (f 1 / g 1).den, (f 1 / g 1).num) ≠\n+      ((g 3).num, (f 3 / g 3).den, (f 3 / g 3).num)\n+    have hg1 : (g 1).num = 1 := by norm_num [g]\n+    have hg3 : (g 3).num = 5 := by\n+      have hq : g 3 = (5 : ℚ) / 4 := by norm_num [g, Nat.choose]\n+      rw [hq]\n+      exact Rat.num_div_eq_of_coprime (by norm_num) (by decide)\n+    intro h\n+    have hh := congrArg Prod.fst h\n+    rw [hg1, hg3] at hh\n+    norm_num at hh\n+\n+def audit : Contract.Registration.{_,_,_,0,0,0,0,0,0,0,0,0}\n+    (@denominator_formula) (Realization signature) Type Unit where\n+  unitName := `D5.S3.Arith.FactorialRatio.DyadicBinomialCancellation.denominator_formula.audit\n+  realizationName := `Reg.D5.S3.Arith.FactorialRatio.DyadicBinomialCancellation.registration\n+  realizationSource := none\n+  generated := false\n+  arena := .source ⟨arena⟩\n+  objectArena := .source ⟨arena⟩\n+  catalog := Lean.Name.anonymous\n+  localNames := false\n+  realization := .source arena ⟨registration⟩\n+  correspondence := { stage := .evidence, objectStage := .evidence }\n+  bundleNonempty := .absent\n+  readout := some (realize signature\n+    (fun _ _ n => ((g n).num, (f n / g n).den, (f n / g n).num))\n+    (fun e => nomatch e))\n+  variation := .absent\n+  sensitivity := .absent\n+  partialSensitivity := none\n+  escapeFrom := none\n+  sourceSelection := none\n+  continuation := .unknown\n+  familyRecord := none\n+  options := #[]\n+\n+end\n+end Reg.D5.S3.Arith.FactorialRatio.DyadicBinomialCancellation"},{"sha":"1e2033229dd6c9a3f56bee25c9916fae2c9e8d21","filename":"Reg/D5/S3/Combinatorics/Circle/NativeSeedChains.lean","status":"added","additions":131,"deletions":0,"changes":131,"blob_url":"https://github.com/the-omega-institute/trureturing/blob/b62773edfb6a6f7806de09b593b2e3b6834685c7/Reg%2FD5%2FS3%2FCombinatorics%2FCircle%2FNativeSeedChains.lean","raw_url":"https://github.com/the-omega-institute/trureturing/raw/b62773edfb6a6f7806de09b593b2e3b6834685c7/Reg%2FD5%2FS3%2FCombinatorics%2FCircle%2FNativeSeedChains.lean","contents_url":"https://api.github.com/repos/the-omega-institute/trureturing/contents/Reg%2FD5%2FS3%2FCombinatorics%2FCircle%2FNativeSeedChains.lean?ref=b62773edfb6a6f7806de09b593b2e3b6834685c7","patch":"@@ -0,0 +1,131 @@\n+import LeanInformationAuditInterface.Contract.Registration\n+import D5.S3.Combinatorics.Circle.NativeSeedChains\n+import Reg.Support.DependentFamily\n+\n+/-! # Source-bound native-chain registration -/\n+\n+set_option autoImplicit false\n+set_option relaxedAutoImplicit false\n+open LeanInformationAudit\n+open _root_.D5.S3.ConceptDynamics.InformationEscape.DependentFamily\n+open _root_.D5.S3.Combinatorics.Circle.SourceWidth\n+open _root_.D5.S3.Combinatorics.Circle.ExpandingSourcePath\n+open _root_.D5.S3.Combinatorics.Circle.NativeSeedChains\n+\n+namespace Reg.D5.S3.Combinatorics.Circle.NativeSeedChains\n+noncomputable section\n+abbrev signature : Signature where\n+  Params := ℕ × ℕ\n+  State p := Fin p.1\n+  Role := Unit\n+  finiteRole := inferInstance\n+  nonemptyRole := inferInstance\n+  Output _ _ := ℤ\n+  Anchor := Empty\n+  finiteAnchor := inferInstance\n+\n+def actual : Realization signature :=\n+  realize signature (fun _ p i => actualSource p.1 p.2 i) (fun e => nomatch e)\n+def rejected : Realization signature :=\n+  realize signature (fun _ _ _ => (-1 : ℤ)) (fun e => nomatch e)\n+\n+/-- The complete native law, varying only the dyadic weight operand. -/\n+abbrev arena : Arena where\n+  signature := signature\n+  Law R := ∀ {k t : ℕ} (hk : 3 ≤ k)\n+    (hsmall : ∀ i : Fin k, |actualSource k t i| < quarter k →\n+      0 < actualSource k t i)\n+    (n : Fin k) (hn : actualSource k t n < 0),\n+    let a := phase (by omega) n 1\n+    ∃ r : ℕ,\n+      let root := phase (by omega) a r\n+      let neg := phase (by omega) a (r + 1)\n+      let next := phase (by omega) a (r + 2)\n+      let s := path (by omega) a r\n+      r + 2 ≤ k ∧ (s ++ [root, neg]).Nodup ∧\n+      0 < actualSource k t a ∧ actualSource k t a % 4 = 1 ∧\n+      (∀ j < r, 0 < actualSource k t (phase (by omega) a j) ∧\n+        actualSource k t (phase (by omega) a j) < quarter k) ∧\n+      Dyadic (R.readout () (k, t)) (actualSource k t a) s ∧\n+      actualSource k t root = (2 : ℤ) ^ r * actualSource k t a ∧\n+      quarter k ≤ actualSource k t root ∧ 3 * actualSource k t root ≤ modulus k ∧\n+      actualSource k t neg = 2 * actualSource k t root - modulus k ∧\n+      actualSource k t neg < 0 ∧\n+      actualSource k t next = 4 * actualSource k t root - modulus k ∧\n+      0 < actualSource k t next ∧ actualSource k t next % 4 = 1 ∧\n+      (s.map (actualSource k t)).sum = actualSource k t root - actualSource k t a ∧\n+      0 ≤ -actualSource k t neg - actualSource k t root ∧\n+      (s.map (actualSource k t)).sum -\n+        (-actualSource k t neg - actualSource k t root) =\n+          actualSource k t next - actualSource k t a\n+\n+private theorem rejected_law : ¬ arena.Law rejected := by\n+  intro hall\n+  have hsmall (i : Fin 4) : |actualSource 4 1 i| < quarter 4 →\n+      0 < actualSource 4 1 i := by\n+    fin_cases i <;> norm_num [actualSource, centered, modulus, quarter]\n+  have hn : actualSource 4 1 (3 : Fin 4) < 0 := by\n+    norm_num [actualSource, centered, modulus]\n+  obtain ⟨r, _, _, _, _, _, hd, _, hr, _⟩ := @hall 4 1 (by norm_num) hsmall 3 hn\n+  have hrne : r ≠ 0 := by\n+    intro hz\n+    subst r\n+    norm_num [phase, actualSource, centered, modulus, quarter] at hr\n+  obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hrne\n+  rw [path, List.range_succ_eq_map, List.map_cons] at hd\n+  have hb := hd.1\n+  norm_num [rejected, realize, actualSource, centered, modulus, phase] at hb\n+\n+private theorem dependence : ObservationalDependence signature actual := by\n+  intro i\n+  refine ⟨(3, 1), 0, 1, ?_⟩\n+  norm_num [actual, realize, actualSource, centered, modulus]\n+\n+def family : Registration arena (type_of% (@native_chain_extraction)) where\n+  actual := actual\n+  bridge := Iff.rfl\n+  variation := ⟨@native_chain_extraction, rejected, rejected_law⟩\n+  sensitivity := by\n+    constructor\n+    · intro i\n+      refine ⟨rejected, ?_, rfl, rejected_law⟩\n+      intro j hji\n+      exact (hji (Subsingleton.elim _ _)).elim\n+    · intro e\n+      exact nomatch e\n+  dependence := dependence\n+\n+def audit : Contract.Registration.{_,_,_,0,0,0,_,_,_,_,_,0}\n+    (@native_chain_extraction) (type_of% actual) Nat Unit where\n+  unitName := `D5.S3.Combinatorics.Circle.NativeSeedChains.native_chain_extraction.__information_unit\n+  realizationName := `Reg.D5.S3.Combinatorics.Circle.NativeSeedChains.family\n+  realizationSource := none\n+  generated := false\n+  arena := .source ⟨arena⟩\n+  objectArena := .source ⟨arena⟩\n+  catalog := Lean.Name.anonymous\n+  localNames := false\n+  realization := .source arena ⟨family⟩\n+  correspondence := { stage := .evidence, objectStage := .evidence }\n+  bundleNonempty := .absent\n+  readout := some (realize signature (fun _ p i => actualSource p.1 p.2 i) (fun e => nomatch e))\n+  variation := .absent\n+  sensitivity := .absent\n+  partialSensitivity := none\n+  escapeFrom := none\n+  sourceSelection := some {\n+    owner := `D5.S3.Combinatorics.Circle.NativeSeedChains\n+    definition := none\n+    coordinates := #[0, 1]\n+    readouts := #[{\n+      path := #[\"body\", \"body\", \"body\", \"body\", \"body\", \"body\", \"body\", \"arg\", \"body\", \"body\", \"body\", \"body\", \"body\", \"arg\", \"arg\", \"arg\", \"arg\", \"arg\", \"fn\", \"arg\", \"fn\", \"fn\", \"arg\"]\n+      stateBinder := 0\n+      functionOperand := true\n+      stateOperand := none\n+      booleanPredicate := false }] }\n+  continuation := .unknown\n+  familyRecord := none\n+  options := #[]\n+\n+end\n+end Reg.D5.S3.Combinatorics.Circle.NativeSeedChains"},{"sha":"24631c97e1e0107a7677371a4d180909c0a47024","filename":"Reg/D5/S3/Combinatorics/Circle/SeedQueueInvariant.lean","status":"added","additions":117,"deletions":0,"changes":117,"blob_url":"https://github.com/the-omega-institute/trureturing/blob/b62773edfb6a6f7806de09b593b2e3b6834685c7/Reg%2FD5%2FS3%2FCombinatorics%2FCircle%2FSeedQueueInvariant.lean","raw_url":"https://github.com/the-omega-institute/trureturing/raw/b62773edfb6a6f7806de09b593b2e3b6834685c7/Reg%2FD5%2FS3%2FCombinatorics%2FCircle%2FSeedQueueInvariant.lean","contents_url":"https://api.github.com/repos/the-omega-institute/trureturing/contents/Reg%2FD5%2FS3%2FCombinatorics%2FCircle%2FSeedQueueInvariant.lean?ref=b62773edfb6a6f7806de09b593b2e3b6834685c7","patch":"@@ -0,0 +1,117 @@\n+import LeanInformationAuditInterface.Contract.Registration\n+import D5.S3.Combinatorics.Circle.SeedQueueInvariant\n+import Reg.Support.DependentFamily\n+\n+/-! # Source-bound deferred-prefix registration -/\n+\n+set_option autoImplicit false\n+set_option relaxedAutoImplicit false\n+open LeanInformationAudit\n+open _root_.D5.S3.ConceptDynamics.InformationEscape.DependentFamily\n+open _root_.D5.S3.Combinatorics.Circle.SourceWidth\n+open _root_.D5.S3.Combinatorics.Circle.SeedQueueInvariant\n+\n+namespace Reg.D5.S3.Combinatorics.Circle.SeedQueueInvariant\n+universe u\n+noncomputable section\n+abbrev signature : Signature where\n+  Params := ℤ\n+  State _ := ℤ\n+  Role := Unit\n+  finiteRole := inferInstance\n+  nonemptyRole := inferInstance\n+  Output _ _ := ℤ\n+  Anchor := Empty\n+  finiteAnchor := inferInstance\n+\n+def actual : Realization signature :=\n+  realize signature (fun _ B h => B + h) (fun e => nomatch e)\n+def rejected : Realization signature :=\n+  realize signature (fun _ B h => B + h + 1) (fun e => nomatch e)\n+\n+/-- Only the peak readout in the first-omission inequality varies. -/\n+abbrev arena : Arena where\n+  signature := signature\n+  Law R := ∀ {α : Type u} (f : α → ℤ)\n+    (old small : List α) (mu D a b p B C : ℤ)\n+    (_hold : Ancestors f mu D 0 old) (_hdyadic : Dyadic f a small)\n+    (_hbirth : small ≠ [] → 0 ≤ a - mu - (old.map f).sum ∧\n+      a - mu - (old.map f).sum ≤ D)\n+    (_hbudget : mu ≤ b)\n+    (_htransport : (small.map f).sum - (B - p) = b - a)\n+    (_hcapacity : 2 * (C - B) = b - 1),\n+    let q := (splitBudget f (b - mu) (old ++ small)).1\n+    let e := (splitBudget f (b - mu) (old ++ small)).2\n+    let h := b - mu - (q.map f).sum\n+    old ++ small = q ++ e ∧ Ancestors f mu D 0 q ∧ 0 ≤ h ∧\n+      (a - mu - (old.map f).sum) + (e.map f).sum + p - B = h ∧\n+      (∀ x xs, e = x :: xs → h < f x ∧ R.readout () B h ≤ C + D / 2) ∧\n+      (e = [] → B + h = a - mu - (old.map f).sum + p) ∧\n+      (b = mu → (∀ x ∈ old ++ small, 0 < f x) → q = [] ∧ h = 0)\n+\n+private theorem rejected_law : ¬ arena.{u}.Law rejected := by\n+  intro hall\n+  let x : ULift.{u} Unit := ULift.up ()\n+  have hr := hall (fun _ : ULift.{u} Unit => (1 : ℤ)) [] [x]\n+    1 0 1 1 2 3 3 (by trivial) (by simp [_root_.D5.S3.Combinatorics.Circle.SourceWidth.Dyadic])\n+    (by intro _; norm_num) (by norm_num) (by norm_num) (by norm_num)\n+  have hb := hr.2.2.2.2.1 x [] (by norm_num [splitBudget])\n+  norm_num [rejected, realize, splitBudget] at hb\n+\n+private theorem dependence : ObservationalDependence signature actual := by\n+  intro i\n+  refine ⟨0, 0, 1, ?_⟩\n+  norm_num [actual, realize]\n+\n+def family : Registration arena.{u} (type_of% (@deferred_prefix_invariant.{u})) where\n+  actual := actual\n+  bridge := Iff.rfl\n+  variation := ⟨@deferred_prefix_invariant.{u}, rejected, rejected_law⟩\n+  sensitivity := by\n+    constructor\n+    · intro i\n+      refine ⟨rejected, ?_, rfl, rejected_law⟩\n+      intro j hji\n+      exact (hji (Subsingleton.elim _ _)).elim\n+    · intro e\n+      exact nomatch e\n+  dependence := dependence\n+\n+def audit : Contract.Regist