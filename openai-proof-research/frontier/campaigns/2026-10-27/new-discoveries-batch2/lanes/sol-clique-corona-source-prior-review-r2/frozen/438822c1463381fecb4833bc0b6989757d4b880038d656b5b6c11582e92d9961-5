rm\"),\n+                DeclarationHandle.Create(\"D5/S3/VertexAlgebra/SourceBPZ/NormalScalarTranspose.consumed_normal_product_form\"),\n+                H(\"consumed_normal_product_form\"), StatementSource.WithoutFormula(),\n+                AssessedProvenance.FromRepo(),\n+                Blocks(\n+                    Paragraph(Text(\"Fix arbitrary D, a complex bilinear B on Carrier D, a coordinate i, derivative order p, actual tail field F, an arbitrary label type with finite subset S, actual fields G(a), complex coefficients lambda(a), integer reflection constants K(a), and complex charge kappa. Assume B(h_i(k)x,y)=-B(x,h_i(-k)y) for every integer k and both inputs; B(F[t]x,y)=sum over a in S of lambda(a) B(x,G(a)[K(a)-t]y) for all t,x,y; and h_i(0)G(a)[t]x=G(a)[t]h_i(0)x+kappa G(a)[t]x for a in S. The tail premise concerns F only and assumes no normal-product transpose.\")),\n+                    Paragraph(Text(\"For every integer m and inputs u,v, B(insertion(p,F)[m]u,v) equals (-1)^(p+1) times the sum over a in S of lambda(a) multiplied by: the sum over s=0,...,p of choose(p+1,s+1) B(u,insertion(s,G(a))[K(a)+p+s+2-m]v), plus kappa B(u,G(a)[K(a)+p+1-m]v). Equivalently n=p+1 and r=s+1 range through n>=1 and 1<=r<=n. The final term deletes the oscillator and never invokes a derivative of order -1.\")),\n+                    Paragraph(Text(\"The actual constructor's two vector sums have finite support before scalar evaluation. With A=vectorFrequencyBound(u)+1 and C=vectorFrequencyBound(v)+1 the scalar intervals are k=1-C,...,-1 and k=0,...,A-1. The omitted derivative band -p<=k<0 has zero integer choose(-k-1,p). Finite reflection j=-k and integer Vandermonde give -choose(j-1,p)=(-1)^(p+1) sum over s=0,...,p of choose(p+1,s+1)choose(-j-1,s). Only the j=0 ordering boundary uses the charge covariance and produces the displayed kappa term.\")),\n+                    Paragraph(Text(\"The consumer is the cons step of the original wordField BPZ induction: F is the tail wordField, G(a) are the finite lowered or deleted tail words, K(a) their exact opposite-mode constants, and kappa is bilinear(unitCharge i,alpha). At p=0 a singleton primary tail gives the nonprimary correction B(u,G[K+1-m]v) with coefficient -lambda*kappa. This unit does not construct the original pairing or charged-primary law, prove the word induction or permutation bridge, assemble the finite L1 source flow, or establish full VOA, CFT, fusion, string theory or AdS/CFT.\"))),\n+                DescribeRole.Theorem))));\n+}"},{"sha":"da05994c2553267ce4f0e02d1e2299b010e445ce","filename":"D5/S1/Dynamics/FiniteFiberEntropy.lean","status":"added","additions":270,"deletions":0,"changes":270,"blob_url":"https://github.com/the-omega-institute/trureturing/blob/b62773edfb6a6f7806de09b593b2e3b6834685c7/D5%2FS1%2FDynamics%2FFiniteFiberEntropy.lean","raw_url":"https://github.com/the-omega-institute/trureturing/raw/b62773edfb6a6f7806de09b593b2e3b6834685c7/D5%2FS1%2FDynamics%2FFiniteFiberEntropy.lean","contents_url":"https://api.github.com/repos/the-omega-institute/trureturing/contents/D5%2FS1%2FDynamics%2FFiniteFiberEntropy.lean?ref=b62773edfb6a6f7806de09b593b2e3b6834685c7","patch":"@@ -0,0 +1,270 @@\n+/- GID: D5/S1/Dynamics/FiniteFiberEntropy\n+   generality: G\n+   mirror-B: D5/B/S1/Dynamics/FiniteFiberEntropy\n+   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)\n+   anchors: []\n+   utility: none\n+   digest: Uniformly finite fibers of a compact factor map preserve topological entropy. -/\n+\n+import Mathlib.Data.Set.Card\n+import Mathlib.Dynamics.TopologicalEntropy.CoverEntropy\n+import Mathlib.Topology.UniformSpace.Compact\n+import Mathlib.Topology.UniformSpace.HeineCantor\n+import Mathlib.Topology.Separation.Hausdorff\n+import Mathlib.Dynamics.TopologicalEntropy.Semiconj\n+import Mathlib.Data.Fintype.BigOperators\n+import Mathlib.Tactic\n+import Mathlib.Analysis.SpecificLimits.Basic\n+\n+/-!\n+The classical finite-to-one entropy theorem is formalized without a novelty\n+claim. The missing content, fixed before compilation, is the reverse cover\n+bound: local length-n covers of each fiber extend to base neighborhoods,\n+and one representative per realized block code gives at most M^r lifts of\n+each base cover orbit of length n*r. No pointwise lifting or continuous\n+choice is assumed. Multiples of n suffice by monotonicity of covering\n+numbers. Their extra growth is log(M)/n, tending to zero.\n+\n+The final theorem includes empty spaces and infinite entropy. Finiteness\n+of fibers is explicit, since Nat.card or Set.ncard alone vanishes on an\n+infinite set. The helpers below are consumed by the final theorem.\n+-/\n+\n+noncomputable section\n+open Set Function Filter Dynamics ExpGrowth\n+open scoped Topology Uniformity ENNReal SetRel\n+\n+namespace D5.S1.Dynamics.FiniteFiberEntropy\n+\n+variable {X Y : Type*}\n+\n+private lemma local_block_covers\n+    [UniformSpace X] [CompactSpace X]\n+    [UniformSpace Y] [CompactSpace Y] [T2Space Y]\n+    (π : X → Y) (hπ : Continuous π) (S : X → X) (hS : Continuous S)\n+    (M : ℕ)\n+    (hfib : ∀ y, (π ⁻¹' {y}).Finite ∧ (π ⁻¹' {y}).ncard ≤ M)\n+    (U : SetRel X X) (hU : U ∈ 𝓤 X) [U.IsSymm] (n : ℕ) :\n+    ∃ V ∈ 𝓤 Y, ∀ y, ∃ s : Finset X,\n+      s.card ≤ M ∧ IsDynCoverOf S (π ⁻¹' UniformSpace.ball y V) U n s := by\n+  classical\n+  let A : Y → Set Y := fun q =>\n+    {q' | ∀ x ∈ π ⁻¹' {q'},\n+      ∃ z ∈ π ⁻¹' {q}, (z, x) ∈ dynEntourage S U n}\n+  have hA (q : Y) : A q ∈ 𝓝 q := by\n+    apply hπ.isClosedMap.eventually_nhds_fiber q\n+    intro z hz\n+    filter_upwards [ball_dynEntourage_mem_nhds hS hU n z] with x hx\n+    exact ⟨z, hz, hx⟩\n+  obtain ⟨V, hV, hVA⟩ :=\n+    lebesgue_number_lemma_nhds isCompact_univ\n+      (fun q (_ : q ∈ (Set.univ : Set Y)) => hA q)\n+  refine ⟨V, hV, fun y => ?_⟩\n+  obtain ⟨q, hq⟩ := hVA y (Set.mem_univ y)\n+  let s : Finset X := (hfib q).1.toFinset\n+  refine ⟨s, ?_, ?_⟩\n+  · change (hfib q).1.toFinset.card ≤ M\n+    rw [← Set.ncard_eq_toFinset_card (π ⁻¹' {q}) (hfib q).1]\n+    exact (hfib q).2\n+  · intro x hx\n+    obtain ⟨z, hz, hzx⟩ := hq hx x (by simp)\n+    refine ⟨z, ?_, (dynEntourage S U n).symm hzx⟩\n+    exact (hfib q).1.mem_toFinset.mpr hz\n+\n+\n+\n+/- The missing counting step: choose one actual orbit per realized block code.\n+The centers of a block need not lift the center of the base orbit. The code\n+construction follows Mathlib's Dynamics.IsDynCoverOf.iterate_le_pow. -/\n+private theorem block_cover_lift {X Y : Type*} [Nonempty X]\n+    (S : X → X) (T : Y → Y) (π : X → Y) (hπ : Semiconj π S T)\n+    (U : SetRel X X) [U.IsSymm] (V : SetRel Y Y) [V.IsSymm]\n+    (M n r : ℕ) (hn : 0 < n)\n+    (hloc : ∀ y, ∃ c : Finset X, c.card ≤ M ∧\n+      IsDynCoverOf S (π ⁻¹' UniformSpace.ball y V) U n c)\n+    (b : Finset Y) (hb : IsDynCoverOf T univ V (n * r) b) :\n+    ∃ a : Finset X, IsDynCoverOf S univ (U ○ U) (n * r) a ∧\n+      a.card ≤ b.card * M ^ r := by\n+  classical\n+  choose c hc_card hc using hloc\n+  let Code := (y : b) × ((k : Fin r) → c (T^[n * k.val] y.val))\n+  let cell (w : Code) : Set X :=\n+    {x | ∀ k : Fin r,\n+      (S^[n * k.val] x, (w.2 k).val) ∈ dynEntourage S U n}\n+  let representative (w : Code) : X :=\n+    if h : (cell w).Nonempty then h.choose else Classical.arbitrary X\n+  have hrep (w : Code) (x : X) (hx : x ∈ cell w) : representative w ∈ cell w := by\n+    have h : (cell w).Nonempty := ⟨x, hx⟩\n+    simpa only [representative, dite_eq_left h] using h.choose_spec\n+  let a : Finset X := Finset.univ.image representative\n+  refine ⟨a, ?_, ?_⟩\n+  · intro x _\n+    obtain ⟨y, hy, hxy⟩ := hb (mem_univ (π x))\n+    have hblock (k : Fin r) :\n+        S^[n * k.val] x ∈ π ⁻¹' UniformSpace.ball (T^[n * k.val] y) V := by\n+      change (T^[n * k.val] y, π (S^[n * k.val] x)) ∈ V\n+      rw [(hπ.iterate_right (n * k.val)) x]\n+      exact V.symm ((mem_dynEntourage.mp hxy) (n * k.val) (Nat.mul_lt_mul_of_pos_left k.isLt hn))\n+    have hchoose (k : Fin r) : ∃ z : c (T^[n * k.val] y),\n+        (S^[n * k.val] x, z.val) ∈ dynEntourage S U n := by\n+      obtain ⟨z, hz, hxz⟩ := hc (T^[n * k.val] y) (hblock k)\n+      exact ⟨⟨z, hz⟩, hxz⟩\n+    choose z hz using hchoose\n+    let w : Code := ⟨⟨y, hy⟩, z⟩\n+    have hx : x ∈ cell w := hz\n+    have hycell := hrep w x hx\n+    refine ⟨representative w, Finset.mem_image.mpr ⟨w, Finset.mem_univ _, rfl⟩, ?_⟩\n+    apply mem_dynEntourage.mpr\n+    intro i hi\n+    let k : Fin r := ⟨i / n, Nat.div_lt_of_lt_mul (by simpa [Nat.mul_comm] using hi)⟩\n+    have hix := mem_dynEntourage.mp (hx k) (i % n) (Nat.mod_lt i hn)\n+    have hiy := mem_dynEntourage.mp (hycell k) (i % n) (Nat.mod_lt i hn)\n+    have he : i % n + n * k.val = i := Nat.mod_add_div i n\n+    rw [← iterate_add_apply, he] at hix hiy\n+    exact ⟨_, hix, U.symm hiy⟩\n+  · refine Finset.card_image_le.trans ?_\n+    simp only [Finset.card_univ, Code, Fintype.card_sigma, Fintype.card_pi,\n+      Fintype.card_coe]\n+    calc\n+      _ ≤ ∑ _y : b, M ^ r := Finset.sum_le_sum fun y _ => by\n+        calc\n+          _ ≤ ∏ _k : Fin r, M := Finset.prod_le_prod fun k _ => hc_card _\n+          _ = _ := by simp\n+      _ = b.card * M ^ r := by simp\n+\n+\n+\n+/-- Arbitrarily long blocks with a uniformly bounded branching cost do not\n+increase covering entropy.  No nonemptiness or finiteness-of-entropy\n+assumption is needed; `EReal` handles all endpoint cases. -/\n+private lemma entropy_le_of_block_bound\n+    {X Y : Type*} [UniformSpace X] [UniformSpace Y]\n+    (S : X → X) (T : Y → Y) (U : SetRel X X)\n+    (M : ℕ) (hM : 0 < M)\n+    (hbound : ∀ n : ℕ, 0 < n → ∃ V : SetRel Y Y, V ∈ 𝓤 Y ∧\n+      ∀ r : ℕ, coverMincard S univ U (n * r) ≤\n+        (M : ℕ∞) ^ r * coverMincard T univ V (n * r)) :\n+    coverEntropyEntourage S univ U ≤ coverEntropy T univ := by\n+  have hlog_bot : ENNReal.log (M : ℝ≥0∞) ≠ ⊥ := by\n+    intro h\n+    have hzero : (M : ℝ≥0∞) = 0 := ENNReal.log_eq_bot_iff.mp h\n+    exact hM.ne' (by exact_mod_cast hzero)\n+  have hlog_top : ENNReal.log (M : ℝ≥0∞) ≠ ⊤ := by simp\n+  have hmonoS : Monotone (fun k => (coverMincard S univ U k).toENNReal) :=\n+    fun _ _ h => ENat.toENNReal_mono (coverMincard_monotone_time S univ U h)\n+  have happrox (n : ℕ) (hn : 0 < n) :\n+      coverEntropyEntourage S univ U ≤\n+        ENNReal.log (M : ℝ≥0∞) / n + coverEntropy T univ := by\n+    obtain ⟨V, hV, hb⟩ := hbound n hn\n+    have hmonoT : Monotone (fun k => (coverMincard T univ V k).toENNReal) :=\n+      fun _ _ h => ENat.toENNReal_mono (coverMincard_monotone_time T univ V h)\n+    have hcost : expGrowthSup (fun r : ℕ => (M : ℝ≥0∞) ^ r) =\n+        ENNReal.log (M : ℝ≥0∞) := expGrowthSup_pow\n+    have hproduct :\n+        expGrowthSup (fun r => (coverMincard S univ U (n * r)).toENNReal) ≤\n+        ENNReal.log (M : ℝ≥0∞) +\n+          expGrowthSup (fun r => (coverMincard T univ V (n * r)).toENNReal) := by\n+      calc\n+        _ ≤ expGrowthSup\n+            ((fun r : ℕ => (M : ℝ≥0∞) ^ r) *\n+              (fun r : ℕ => (coverMincard T univ V (n * r)).toENNReal)) := by\n+          apply expGrowthSup_monotone\n+          intro r\n+          simpa only [Pi.mul_apply, ENat.toENNReal_mul, ENat.toENNReal_pow,\n+            ENat.toENNReal_coe] using ENat.toENNReal_mono (hb r)\n+        _ ≤ _ := by\n+          have hp := expGrowthSup_mul_le\n+            (u := fun r : ℕ => (M : ℝ≥0∞) ^ r)\n+            (v := fun r : ℕ => (coverMincard T univ V (n * r)).toENNReal)\n+            (Or.inl (hcost.symm ▸ hlog_bot)) (Or.inl (hcost.symm ▸ hlog_top))\n+          simpa only [hcost] using hp\n+    have hs := hmonoS.expGrowthSup_comp_mul hn.ne'\n+    rw [mul_comm, ← EReal.div_eq_iff (EReal.natCast_ne_bot n)\n+      (EReal.natCast_ne_top n) (Nat.cast_ne_zero.2 hn.ne')] at hs\n+    change expGrowthSup (fun k => (coverMincard S univ U k).toENNReal) ≤ _\n+    rw [← hs]\n+    calc\n+      _ ≤ (ENNReal.log (M : ℝ≥0∞) +\n+          expGrowthSup (fun r => (coverMincard T univ V (n * r)).toENNReal)) / n :=\n+        EReal.monotone_div_right_of_nonneg n.cast_nonneg' hproduct\n+      _ = ENNReal.log (M : ℝ≥0∞) / n +\n+          coverEntropyEntourage T univ V := by\n+        rw [hmonoT.expGrowthSup_comp_mul hn.ne',\n+          EReal.add_div_of_nonneg_right n.cast_nonneg']\n+        congr 1\n+        apply (EReal.div_eq_iff (EReal.natCast_ne_bot n)\n+          (EReal.natCast_ne_top n) (Nat.cast_ne_zero.2 hn.ne')).2\n+        exact mul_comm _ _\n+      _ ≤ _ := add_le_add_right (coverEntropyEntourage_le_coverEntropy T univ hV) _\n+  have hzero : Tendsto (fun n : ℕ => ENNReal.log (M : ℝ≥0∞) / n)\n+      atTop (𝓝 (0 : EReal)) :=\n+    EReal.tendsto_const_div_atTop_nhds_zero_nat hlog_bot hlog_top\n+  have hlim : Tendsto\n+      (fun n : ℕ => ENNReal.log (M : ℝ≥0∞) / n + coverEntropy T univ)\n+      atTop (𝓝 (coverEntropy T univ)) := by\n+    simpa only [Function.comp_def, zero_add] using\n+      (EReal.continuousAt_add (p := (0, coverEntropy T univ))\n+        (Or.inl EReal.zero_ne_top) (Or.inl EReal.zero_ne_bot)).tendsto.comp\n+          (hzero.prodMk_nhds tendsto_const_nhds)\n+  exact ge_of_tendsto hlim (by\n+    filter_upwards [eventually_ge_atTop 1] with n hn\n+    exact happrox n (by omega))\n+\n+/- Final assembly; the local and counting lemmas precede this text. -/\n+\n+/-- A continuous surjective semiconjugacy with a uniform finite bound on\n+its fibers preserves topological entropy. The source dynamics is continuous;\n+no continuity hypothesis on the factor dynamics is needed. -/\n+theorem finite_fiber_entropy\n+    {X Y : Type*} [UniformSpace X] [CompactSpace X]\n+    [UniformSpace Y] [CompactSpace Y] [T2Space Y]\n+    (S : X → X) (T : Y → Y) (π : X → Y)\n+    (hS : Continuous S) (hπ : Continuous π)\n+    (honto : Surjective π) (hsem : Semiconj π S T)\n+    (M : ℕ)\n+    (hfib : ∀ y, (π ⁻¹' {y}).Finite ∧ (π ⁻¹' {y}).ncard ≤ M) :\n+    coverEntropy S univ = coverEntropy T univ := by\n+  classical\n+  rcases isEmpty_or_nonempty X with hX | hX\n+  · letI := hX\n+    letI : IsEmpty Y := ⟨fun y => by\n+      obtain ⟨x, _⟩ := honto y\n+      exact isEmptyElim x⟩\n+    simp only [Set.eq_empty_of_isEmpty, coverEntropy_empty]\n+  letI := hX\n+  have hM : 0 < M := by\n+    let x : X := Classical.arbitrary X\n+    exact ((Set.ncard_pos (hfib (π x)).1).mpr ⟨x, by simp⟩).trans_le (hfib (π x)).2\n+  apply le_antisymm\n+  · unfold coverEntropy\n+    refine iSup₂_le fun U hU => ?_\n+    obtain ⟨W, hW, hWsymm, hWW⟩ := comp_symm_mem_uniformity_sets hU\n+    letI := hWsymm\n+    apply (coverEntropyEntourage_antitone S univ hWW).trans\n+    apply entropy_le_of_block_bound S T (W ○ W) M hM\n+    intro n hn\n+    obtain ⟨V₀, hV₀, hlocal₀⟩ := local_block_covers π hπ S hS M hfib W hW n\n+    obtain ⟨V, hV, hVsymm, hVV₀⟩ := symm_of_uniformity hV₀\n+    letI := hVsymm\n+    have hlocal : ∀ y, ∃ c : Finset X, c.card ≤ M ∧\n+        IsDynCoverOf S (π ⁻¹' UniformSpace.ball y V) W n c := by\n+      intro y\n+      obtain ⟨c, hc, hcover⟩ := hlocal₀ y\n+      exact ⟨c, hc, fun _ hx => hcover (hVV₀ hx)⟩\n+    refine ⟨V, hV, fun r => ?_⟩\n+    have hfinite := coverMincard_finite_of_isCompact_invariant\n+      (T := T) isCompact_univ (mapsTo_univ T univ) hV (n * r)\n+    obtain ⟨b, hb, hbcard⟩ := (coverMincard_finite_iff T univ V (n * r)).mp hfinite\n+    obtain ⟨a, ha, hacard⟩ := block_cover_lift S T π hsem W V M n r hn hlocal b hb\n+    calc\n+      _ ≤ (a.card : ℕ∞) := ha.coverMincard_le_card\n+      _ ≤ (b.card * M ^ r : ℕ) := by exact_mod_cast hacard\n+      _ = (M : ℕ∞) ^ r * coverMincard T univ V (n * r) := by\n+        rw [Nat.cast_mul, Nat.cast_pow, hbcard, mul_comm]\n+  · have hfactor := coverEntropy_image_le_of_uniformContinuous hsem\n+      (CompactSpace.uniformContinuous_of_continuous hπ) (Set.univ : Set X)\n+    simpa only [Set.image_univ, Set.range_eq_univ.mpr honto] using hfactor\n+\n+#print axioms finite_fiber_entropy\n+\n+end D5.S1.Dynamics.FiniteFiberEntropy"},{"sha":"aace26a049c3975015f279702a5659ae0cb43a5e","filename":"D5/S3/Arith/FactorialRatio/DyadicBinomialCancellation.lean","status":"added","additions":151,"deletions":0,"changes":151,"blob_url":"https://github.com/the-omega-institute/trureturing/blob/b62773edfb6a6f7806de09b593b2e3b6834685c7/D5%2FS3%2FArith%2FFactorialRatio%2FDyadicBinomialCancellation.lean","raw_url":"https://github.com/the-omega-institute/trureturing/raw/b62773edfb6a6f7806de09b593b2e3b6834685c7/D5%2FS3%2FArith%2FFactorialRatio%2FDyadicBinomialCancellation.lean","contents_url":"https://api.github.com/repos/the-omega-institute/trureturing/contents/D5%2FS3%2FArith%2FFactorialRatio%2FDyadicBinomialCancellation.lean?ref=b62773edfb6a6f7806de09b593b2e3b6834685c7","patch":"@@ -0,0 +1,151 @@\n+/- GID: D5/S3/Arith/FactorialRatio/DyadicBinomialCancellation\n+   generality: G\n+   mirror-B: D5/B/S3/Arith/FactorialRatio/DyadicBinomialCancellation\n+   mirror-E: none(waiver:pure-arithmetic)\n+   anchors: []\n+   utility: none\n+   digest: Exact reduced polarization-transfer fractions at every positive index. -/\n+\n+import Mathlib.Data.Nat.Choose.Bounds\n+import Mathlib.Data.Nat.Factorization.Basic\n+import Mathlib.Tactic.FieldSimp\n+import Mathlib.Tactic.Ring\n+import Mathlib.Tactic.Positivity\n+\n+/-! # Reduced fractions in the dyadic binomial bounds of OEIS A362534 -/\n+\n+/- This explicitly requested formalization preserves an existing written correction.\n+proof_shape: bind-only (binomial identity, exact prime-power decomposition,\n+  coprimality and Rat normalization from pinned Mathlib, composed by arithmetic).\n+No novel mathematical assertion, escape witness, open-problem admission or freeze\n+is claimed. The private helper is consumed by denominator_formula. The symbolic\n+unbounded theorem has no computational content of the four utility categories.\n+Escape audit unfinished: https://github.com/the-omega-institute/trureturing/issues/23314\n+-/\n+\n+set_option autoImplicit false\n+set_option relaxedAutoImplicit false\n+\n+namespace D5.S3.Arith.FactorialRatio.DyadicBinomialCancellation\n+\n+/- The two rational functions are restated locally so this general arithmetic\n+result remains independent of the S0 certified counterexample layer. -/\n+def f (n : ℕ) : ℚ :=\n+  if n % 2 = 0 then (2 : ℚ) ^ ((1 : ℤ) - n) * n * (n - 1).choose (n / 2)\n+  else (2 : ℚ) ^ ((1 : ℤ) - n) * n * (n - 1).choose ((n - 1) / 2)\n+\n+def g (n : ℕ) : ℚ :=\n+  if n % 2 = 0 then 2 * (1 - (2 : ℚ) ^ (-(n : ℤ)) * n.choose (n / 2))\n+  else 2 * (1 - (2 : ℚ) ^ (-(n : ℤ)) * n.choose ((n - 1) / 2))\n+\n+private theorem bounds_as_fractions (n : ℕ) (hn : 1 ≤ n) :\n+    f n = (2 : ℚ) * ((n - n / 2 : ℕ) : ℚ) * n.choose (n / 2) / 2 ^ n ∧\n+    g n = 2 * (1 - (n.choose (n / 2) : ℚ) / 2 ^ n) := by\n+  have hk : (n - 1) / 2 = n / 2 ∨ n % 2 = 0 := by omega\n+  have hbin : n * (n - 1).choose (n / 2) = n.choose (n / 2) * (n - n / 2) := by\n+    simpa [Nat.sub_add_cancel hn, Nat.mul_comm] using\n+      Nat.choose_mul_succ_eq (n - 1) (n / 2)\n+  have hpow : (2 : ℚ) ^ ((1 : ℤ) - n) = 2 / (2 : ℚ) ^ n := by\n+    rw [zpow_sub₀ (by norm_num), zpow_one, zpow_natCast]\n+  have hneg : (2 : ℚ) ^ (-(n : ℤ)) = 1 / (2 : ℚ) ^ n := by simp\n+  have hf : f n = (2 : ℚ) ^ ((1 : ℤ) - n) * n * (n - 1).choose (n / 2) := by\n+    rcases hk with hk | hk <;> simp [f, hk]\n+  have hg : g n = 2 * (1 - (2 : ℚ) ^ (-(n : ℤ)) * n.choose (n / 2)) := by\n+    rcases hk with hk | hk <;> simp [g, hk]\n+  constructor\n+  · rw [hf, hpow]\n+    have hc : (n : ℚ) * ((n - 1).choose (n / 2) : ℚ) =\n+        (n.choose (n / 2) : ℚ) * ((n - n / 2 : ℕ) : ℚ) := by exact_mod_cast hbin\n+    calc\n+      _ = 2 * ((n : ℚ) * ((n - 1).choose (n / 2) : ℚ)) / 2 ^ n := by ring\n+      _ = _ := by rw [hc]; ring\n+  · rw [hg, hneg]; ring\n+\n+/-- For every positive `n`, the numerator of `g n` is the odd binomial gap `G`,\n+and the only cancellation in the ratio is `gcd (ceil (n/2)) G`.\n+Here `factorization B 2` is exactly the exponent of 2 in the positive binomial\n+coefficient `B`; all divisions defining `b` and `G` are exact natural divisions. -/\n+theorem denominator_formula (n : ℕ) (hn : 1 ≤ n) :\n+    let m := n - n / 2\n+    let B := n.choose (n / 2)\n+    let v := B.factorization 2\n+    let b := B / 2 ^ v\n+    let G := (2 ^ n - B) / 2 ^ v\n+    (g n).num = (G : ℤ) ∧\n+      (f n / g n).den = G / Nat.gcd m G ∧\n+      (f n / g n).num = ((m * b / Nat.gcd m G : ℕ) : ℤ) := by\n+  dsimp only\n+  let m := n - n / 2\n+  let B := n.choose (n / 2)\n+  let v := B.factorization 2\n+  let b := B / 2 ^ v\n+  let r := n - v\n+  let G := 2 ^ r - b\n+  have hB : 0 < B := Nat.choose_pos (Nat.div_le_self n 2)\n+  have hBlt : B < 2 ^ n := Nat.choose_lt_two_pow n (n / 2) (by omega)\n+  have hd : 2 ^ v ∣ B := Nat.ordProj_dvd B 2\n+  have hdb : 2 ^ v * b = B := Nat.mul_div_cancel' hd\n+  have hv : v < n := by\n+    have hp : 2 ^ v ≤ B := Nat.le_of_dvd hB hd\n+    exact (Nat.pow_lt_pow_iff_right (by norm_num : 1 < 2)).mp (lt_of_le_of_lt hp hBlt)\n+  have hr : 0 < r := by dsimp [r]; omega\n+  have hsplit : 2 ^ n = 2 ^ v * 2 ^ r := by rw [← pow_add]; congr 1; dsimp [r]; omega\n+  have hb : 0 < b := Nat.ordCompl_pos 2 hB.ne'\n+  have hblt : b < 2 ^ r := by\n+    have h := hBlt\n+    rw [← hdb, hsplit] at h\n+    exact (Nat.mul_lt_mul_left (by positivity : 0 < 2 ^ v)).mp h\n+  have hG : 0 < G := Nat.sub_pos_of_lt hblt\n+  have hGdef : (2 ^ n - B) / 2 ^ v = G := by\n+    rw [hsplit, ← hdb, ← Nat.mul_sub_left_distrib, Nat.mul_div_right _ (by positivity)]\n+  have hb2 : Nat.Coprime b 2 := (Nat.coprime_ordCompl Nat.prime_two hB.ne').symm\n+  have hbG : Nat.Coprime b G :=\n+    (Nat.coprime_sub_self_right hblt.le).mpr (hb2.pow_right r)\n+  have hdenpow : 2 ^ r = 2 * 2 ^ (r - 1) := by\n+    rw [← pow_succ']; congr 1; omega\n+  have hG2 : Nat.Coprime G 2 := by\n+    apply Nat.coprime_two_right.mpr\n+    apply (Nat.odd_sub' hblt.le).mpr\n+    exact ⟨fun _ => by exact ⟨2 ^ (r - 1), by omega⟩,\n+      fun _ => hb2.odd_of_right⟩\n+  have hGpow : Nat.Coprime G (2 ^ (r - 1)) := hG2.pow_right _\n+  obtain ⟨hf, hg⟩ := bounds_as_fractions n hn\n+  have hdbq : (B : ℚ) = 2 ^ v * b := by exact_mod_cast hdb.symm\n+  have hsplitq : (2 : ℚ) ^ n = 2 ^ v * 2 ^ r := by exact_mod_cast hsplit\n+  have hGq : (G : ℚ) = 2 ^ r - b := by exact_mod_cast Nat.cast_sub hblt.le\n+  have hg' : g n = (G : ℚ) / 2 ^ (r - 1) := by\n+    rw [hg, hdbq, hsplitq, hGq]\n+    have hpq : (2 : ℚ) ^ r = 2 * 2 ^ (r - 1) := by exact_mod_cast hdenpow\n+    rw [hpq]\n+    field_simp\n+    <;> ring\n+  have hratio : f n / g n = ((m * b : ℕ) : ℚ) / G := by\n+    rw [hf, hg, hdbq, hsplitq, hGq]\n+    simp only [Nat.cast_mul]\n+    change (2 * (m : ℚ) * (2 ^ v * b) / (2 ^ v * 2 ^ r)) /\n+      (2 * (1 - (2 ^ v * b) / (2 ^ v * 2 ^ r))) =\n+      (m : ℚ) * b / (2 ^ r - b)\n+    have hne : (2 : ℚ) ^ r - b ≠ 0 := by\n+      rw [← hGq]; exact_mod_cast hG.ne'\n+    field_simp [hne]\n+    <;> ring\n+  change (g n).num = (((2 ^ n - B) / 2 ^ v : ℕ) : ℤ) ∧\n+    (f n / g n).den = ((2 ^ n - B) / 2 ^ v) / Nat.gcd m ((2 ^ n - B) / 2 ^ v) ∧\n+    (f n / g n).num = ((m * b / Nat.gcd m ((2 ^ n - B) / 2 ^ v) : ℕ) : ℤ)\n+  rw [hGdef, hratio]\n+  constructor\n+  · rw [hg']\n+    rw [show (2 : ℚ) ^ (r - 1) = ((2 ^ (r - 1) : ℕ) : ℚ) by norm_cast,\n+      Rat.natCast_div_eq_divInt, Rat.divInt_ofNat, Rat.num_mkRat]\n+    simp [show 2 ^ (r - 1) ≠ 0 by positivity, hGpow.symm.gcd_eq_one]\n+  · have hcancel : Nat.gcd (m * b) G = Nat.gcd m G := hbG.gcd_mul_right_cancel m\n+    constructor\n+    · rw [Rat.natCast_div_eq_divInt, Rat.divInt_ofNat, Rat.den_mkRat]\n+      simp only [Int.natAbs_natCast, if_neg hG.ne', Nat.gcd_comm G (m * b), hcancel]\n+    · rw [Rat.natCast_div_eq_divInt, Rat.divInt_ofNat, Rat.num_mkRat]\n+      simp only [Int.natAbs_natCast, if_neg hG.ne', Nat.gcd_comm G (m * b), hcancel,\n+        Int.natCast_ediv]\n+\n+#print axioms denominator_formula\n+\n+end D5.S3.Arith.FactorialRatio.DyadicBinomialCancellation"},{"sha":"8c1a64deb0c16d5d40f8a7fedd60a1e04c74cdd2","filename":"D5/S3/Combinatorics/Circle/NativeSeedChains.lean","status":"added","additions":310,"deletions":0,"changes":310,"blob_url":"https://github.com/the-omega-institute/trureturing/blob/b62773edfb6a6f7806de09b593b2e3b6834685c7/D5%2FS3%2FCombinatorics%2FCircle%2FNativeSeedChains.lean","raw_url":"https://github.com/the-omega-institute/trureturing/raw/b62773edfb6a6f7806de09b593b2e3b6834685c7/D5%2FS3%2FCombinatorics%2FCircle%2FNativeSeedChains.lean","contents_url":"https://api.github.com/repos/the-omega-institute/trureturing/contents/D5%2FS3%2FCombinatorics%2FCircle%2FNativeSeedChains.lean?ref=b62773edfb6a6f7806de09b593b2e3b6834685c7","patch":"@@ -0,0 +1,310 @@\n+/- GID: D5/S3/Combinatorics/Circle/NativeSeedChains\n+   generality: I\n+   mirror-B: D5/B/S3/Combinatorics/Circle/NativeSeedChains\n+   mirror-E: none(waiver:audit-open-22063)\n+   anchors: [mathlib/module/Mathlib.Data.Nat.ModEq]\n+   utility: none\n+   digest: Native positive-SMALL sources have physical dyadic chains with exact seed transport. -/\n+module\n+public import D5.S3.Combinatorics.Circle.ExpandingSourcePath\n+\n+/-! # Physical dyadic chains in native positive-SMALL sources -/\n+\n+set_option autoImplicit false\n+set_option relaxedAutoImplicit false\n+\n+@[expose] public section\n+namespace D5.S3.Combinatorics.Circle.NativeSeedChains\n+open SourceWidth ExpandingSourcePath\n+\n+private theorem geometry {k t : ℕ} (hk : 3 ≤ k)\n+    (hsmall : ∀ i : Fin k, |actualSource k t i| < quarter k →\n+      0 < actualSource k t i) :\n+    (∀ i, actualSource k t i ≠ 0) ∧\n+    (∀ i, 0 < actualSource k t i → 3 * actualSource k t i ≤ modulus k) ∧\n+    (∀ i, actualSource k t i < 0 →\n+      quarter k ≤ -actualSource k t i ∧\n+      actualSource k t (phase (by omega) i 1) = 2 * actualSource k t i + modulus k ∧\n+      0 < actualSource k t (phase (by omega) i 1)) := by\n+  classical\n+  obtain ⟨hQ, hN, hC, hNpos, hodd⟩ := source_geometry hk\n+  let w := actualSource k t\n+  let σ := fun i : Fin k => phase (by omega : 0 < k) i 1\n+  have hb (i : Fin k) : -(2 * quarter k - 1) ≤ w i ∧ w i ≤ 2 * quarter k - 1 := by\n+    have h := centered_bounds hNpos hodd ((2 : ℤ) ^ i.val * t)\n+    change -half k ≤ w i ∧ w i ≤ half k at h\n+    rwa [hC] at h\n+  have hs (i : Fin k) : w (σ i) = doubleStep (modulus k) (w i) := by\n+    simpa [w, σ] using phase_step hk t i 0\n+  have hnz (i : Fin k) : w i ≠ 0 := by\n+    intro h\n+    have hh := hsmall i (by change |w i| < quarter k; rw [h]; norm_num; omega)\n+    change 0 < w i at hh\n+    omega\n+  have neg (i : Fin k) (hi : w i < 0) :\n+      quarter k ≤ -w i ∧ w (σ i) = 2 * w i + modulus k ∧ 0 < w (σ i) := by\n+    have hl : quarter k ≤ -w i := by\n+      by_contra hh\n+      have hp := hsmall i (by change |w i| < quarter k; rw [abs_of_neg hi]; omega)\n+      change 0 < w i at hp\n+      omega\n+    have ht := hs i\n+    rw [doubleStep, ite_eq_right (by omega : ¬modulus k < 4 * w i),\n+      ite_eq_left (by omega : 4 * w i < -modulus k)] at ht\n+    have hbi := hb i\n+    exact ⟨hl, ht, by omega⟩\n+  have posStep (i : Fin k) (hi : quarter k ≤ w i) :\n+      w (σ i) = 2 * w i - modulus k ∧ w (σ i) < 0 ∧\n+      w (σ (σ i)) = 4 * w i - modulus k ∧ 0 < w (σ (σ i)) := by\n+    have ht := hs i\n+    rw [doubleStep, ite_eq_left (by omega : modulus k < 4 * w i)] at ht\n+    have hbi := hb i\n+    have hneg : w (σ i) < 0 := by omega\n+    obtain ⟨_, ht2, hp2⟩ := neg (σ i) hneg\n+    exact ⟨ht, hneg, by omega, hp2⟩\n+  have existsPos : ∃ i, 0 < w i := by\n+    let i : Fin k := ⟨0, by omega⟩\n+    by_cases hi : 0 < w i\n+    · exact ⟨i, hi⟩\n+    · exact ⟨σ i, (neg i (by have := hnz i; omega)).2.2⟩\n+  let P := Finset.univ.filter (fun i : Fin k => 0 < w i)\n+  have memP (i : Fin k) : i ∈ P ↔ 0 < w i := by simp [P]\n+  obtain ⟨i, hi⟩ := existsPos\n+  obtain ⟨a, ha, hmax⟩ := P.exists_max_image w ⟨i, (memP i).2 hi⟩\n+  have hapos := (memP a).1 ha\n+  have haLarge : quarter k ≤ w a := by\n+    by_contra hh\n+    have ht := hs a\n+    rw [doubleStep, ite_eq_right (by omega : ¬modulus k < 4 * w a),\n+      ite_eq_right (by omega : ¬4 * w a < -modulus k)] at ht\n+    have hm := hmax (σ a) ((memP _).2 (by omega))\n+    omega\n+  obtain ⟨_, _, ht, hp⟩ := posStep a haLarge\n+  have hm := hmax (σ (σ a)) ((memP _).2 hp)\n+  refine ⟨hnz, ?_, neg⟩\n+  intro j hj\n+  have hmj := hmax j ((memP _).2 hj)\n+  change 3 * w j ≤ modulus k\n+  omega\n+\n+private theorem phase_add {k : ℕ} (hk : 0 < k) (a : Fin k) (i j : ℕ) :\n+    phase hk (phase hk a i) j = phase hk a (i + j) := by\n+  apply Fin.ext\n+  simp only [phase]\n+  rw [Nat.mod_add_mod, Nat.add_assoc]\n+\n+private theorem path_nodup {k : ℕ} (hk : 0 < k) (a : Fin k) (m : ℕ)\n+    (hm : m ≤ k) : (path hk a m).Nodup := by\n+  unfold path\n+  refine List.Nodup.map_on ?_ List.nodup_range\n+  intro i hi j hj he\n+  have hi' : i < k := lt_of_lt_of_le (List.mem_range.mp hi) hm\n+  have hj' : j < k := lt_of_lt_of_le (List.mem_range.mp hj) hm\n+  have hh : Nat.ModEq k (a.val + i) (a.val + j) := congrArg Fin.val he\n+  have hc := Nat.ModEq.add_left_cancel' a.val hh\n+  simpa only [Nat.ModEq, Nat.mod_eq_of_lt hi', Nat.mod_eq_of_lt hj'] using hc\n+\n+private theorem first_root {k t : ℕ} (hk : 3 ≤ k)\n+    (a : Fin k) (ha : 0 < actualSource k t a) :\n+    ∃ r : ℕ, quarter k ≤ actualSource k t (phase (by omega) a r) ∧\n+      (∀ j < r, 0 < actualSource k t (phase (by omega) a j) ∧\n+        actualSource k t (phase (by omega) a j) < quarter k) ∧\n+      (∀ j ≤ r, actualSource k t (phase (by omega) a j) =\n+        (2 : ℤ) ^ j * actualSource k t a) := by\n+  obtain ⟨hQ, hN, _, _, _⟩ := source_geometry hk\n+  have aux : ∀ n : ℕ, ∀ a : Fin k,\n+      (quarter k - actualSource k t a).toNat = n → 0 < actualSource k t a →\n+      ∃ r : ℕ, quarter k ≤ actualSource k t (phase (by omega) a r) ∧\n+        (∀ j < r, 0 < actualSource k t (phase (by omega) a j) ∧\n+          actualSource k t (phase (by omega) a j) < quarter k) ∧\n+        (∀ j ≤ r, actualSource k t (phase (by omega) a j) =\n+          (2 : ℤ) ^ j * actualSource k t a) := by\n+    intro n\n+    induction n using Nat.strong_induction_on with\n+    | h n ih =>\n+      intro a hn ha\n+      by_cases hl : quarter k ≤ actualSource k t a\n+      · refine ⟨0, by simpa using hl, by omega, ?_⟩\n+        intro j hj\n+        have hj0 : j = 0 := by omega\n+        subst j\n+        simp\n+      · have hstep : actualSource k t (phase (by omega) a 1) = 2 * actualSource k t a := by\n+          have ht := phase_step hk t a 0\n+          simp only [phase_zero, zero_add] at ht\n+          rw [doubleStep, ite_eq_right (by omega), ite_eq_right (by omega)] at ht\n+          exact ht\n+        let b := phase (by omega : 0 < k) a 1\n+        have hb : 0 < actualSource k t b := by dsimp [b]; omega\n+        have hm : (quarter k - actualSource k t b).toNat < n := by\n+          dsimp [b]\n+          rw [hstep]\n+          omega\n+        obtain ⟨r, hr, hpre, hpow⟩ := ih _ hm b rfl hb\n+        have hshift (j : ℕ) : phase (by omega) b j = phase (by omega) a (j + 1) := by\n+          dsimp [b]\n+          rw [phase_add]\n+          congr 1 <;> omega\n+        refine ⟨r + 1, ?_, ?_, ?_⟩\n+        · simpa [hshift] using hr\n+        · intro j hj\n+          cases j with\n+          | zero => simpa using And.intro ha (lt_of_not_ge hl)\n+          | succ j => simpa [hshift] using hpre j (by omega)\n+        · intro j hj\n+          cases j with\n+          | zero => simp\n+          | succ j =>\n+            have ht := hpow j (by omega)\n+            rw [hshift] at ht\n+            rw [ht, show actualSource k t b = 2 * actualSource k t a from hstep, pow_succ]\n+            ring\n+  exact aux _ a rfl ha\n+\n+/-- Every native negative label starts a finite physical dyadic chain. The SMALL\n+list is the literal forward path; its root and following negative are not\n+selected by their numerical values. -/\n+theorem native_chain_extraction {k t : ℕ} (hk : 3 ≤ k)\n+    (hsmall : ∀ i : Fin k, |actualSource k t i| < quarter k →\n+      0 < actualSource k t i)\n+    (n : Fin k) (hn : actualSource k t n < 0) :\n+    let a := phase (by omega) n 1\n+    ∃ r : ℕ,\n+      let root := phase (by omega) a r\n+      let neg := phase (by omega) a (r + 1)\n+      let next := phase (by omega) a (r + 2)\n+      let s := path (by omega) a r\n+      r + 2 ≤ k ∧ (s ++ [root, neg]).Nodup ∧\n+      0 < actualSource k t a ∧ actualSource k t a % 4 = 1 ∧\n+      (∀ j < r, 0 < actualSource k t (phase (by omega) a j) ∧\n+        actualSource k t (phase (by omega) a j) < quarter k) ∧\n+      Dyadic (actualSource k t) (actualSource k t a) s ∧\n+      actualSource k t root = (2 : ℤ) ^ r * actualSource k t a ∧\n+      quarter k ≤ actualSource k t root ∧ 3 * actualSource k t root ≤ modulus k ∧\n+      actualSource k t neg = 2 * actualSource k t root - modulus k ∧\n+      actualSource k t neg < 0 ∧\n+      actualSource k t next = 4 * actualSource k t root - modulus k ∧\n+      0 < actualSource k t next ∧ actualSource k t next % 4 = 1 ∧\n+      (s.map (actualSource k t)).sum = actualSource k t root - actualSource k t a ∧\n+      0 ≤ -actualSource k t neg - actualSource k t root ∧\n+      (s.map (actualSource k t)).sum -\n+        (-actualSource k t neg - actualSource k t root) =\n+          actualSource k t next - actualSource k t a := by\n+  dsimp only\n+  obtain ⟨hnz, hupper, hneg⟩ := geometry hk hsmall\n+  obtain ⟨hQ, hN, hC, hNpos, hodd⟩ := source_geometry hk\n+  let a := phase (by omega : 0 < k) n 1\n+  have ha := (hneg n hn).2.2\n+  change 0 < actualSource k t a at ha\n+  obtain ⟨r, hr, hpre, hpow⟩ := first_root hk a ha\n+  let root := phase (by omega : 0 < k) a r\n+  let neg := phase (by omega : 0 < k) a (r + 1)\n+  let next := phase (by omega : 0 < k) a (r + 2)\n+  have hback : phase (by omega) a (k - 1) = n := by\n+    dsimp [a]\n+    rw [phase_add]\n+    apply Fin.ext\n+    simp [phase, show 1 + (k - 1) = k by omega, Nat.mod_eq_of_lt n.isLt]\n+  have hlen : r + 2 ≤ k := by\n+    by_contra hh\n+    have ht := hpow (k - 1) (by omega)\n+    rw [hback] at ht\n+    have hp : 0 < (2 : ℤ) ^ (k - 1) := pow_pos (by norm_num) _\n+    nlinarith [mul_pos hp ha]\n+  have hinv : path (by omega) a r ++ [root, neg] = path (by omega) a (r + 2) := by\n+    unfold path\n+    rw [List.range_add, List.map_append]\n+    norm_num [List.range_succ, List.map_map, Function.comp_def, root, neg]\n+  have hnodup : (path (by omega) a r ++ [root, neg]).Nodup := by\n+    rw [hinv]\n+    exact path_nodup (by omega) a (r + 2) hlen\n+  have hroot : quarter k ≤ actualSource k t root := hr\n+  have hrootpos : 0 < actualSource k t root := by omega\n+  have hu := hupper root hrootpos\n+  have hb := centered_bounds hNpos hodd ((2 : ℤ) ^ root.val * t)\n+  change -half k ≤ actualSource k t root ∧ actualSource k t root ≤ half k at hb\n+  rw [hC] at hb\n+  have hrootstep : actualSource k t neg = 2 * actualSource k t root - modulus k := by\n+    have ht := phase_step hk t a r\n+    change actualSource k t neg = doubleStep (modulus k) (actualSource k t root) at ht\n+    rw [doubleStep, ite_eq_left (by omega)] at ht\n+    exact ht\n+  have hnegval : actualSource k t neg < 0 := by omega\n+  have hnextstep : actualSource k t next = 4 * actualSource k t root - modulus k := by\n+    have ht := (hneg neg hnegval).2.1\n+    have he : phase (by omega) neg 1 = next := by\n+      dsimp [neg, next]\n+      rw [phase_add]\n+    rw [he, hrootstep] at ht\n+    omega\n+  have hnextpos : 0 < actualSource k t next := by\n+    have ht := (hneg neg hnegval).2.2\n+    have he : phase (by omega) neg 1 = next := by dsimp [neg, next]; rw [phase_add]\n+    rwa [he] at ht\n+  have hseedmod : actualSource k t a % 4 = 1 := by\n+    let pred : Fin k := ⟨(n.val + k - 1) % k, Nat.mod_lt _ (by omega)⟩\n+    have he : phase (by omega) pred 1 = n := by\n+      apply Fin.ext\n+      dsimp [phase, pred]\n+      rw [Nat.mod_add_mod]\n+      have hh : n.val + k - 1 + 1 = n.val + k := by omega\n+      rw [hh, Nat.add_mod_right, Nat.mod_eq_of_lt n.isLt]\n+    have hpredpos : 0 < actualSource k t pred := by\n+      by_contra hh\n+      have hz := hnz pred\n+      have hp := (hneg pred (by omega)).2.2\n+      rw [he] at hp\n+      omega\n+    have hp : quarter k ≤ actualSource k t pred := by\n+      have hbpred := centered_bounds hNpos hodd ((2 : ℤ) ^ pred.val * t)\n+      change -half k ≤ actualSource k t pred ∧ actualSource k t pred ≤ half k at hbpred\n+      rw [hC] at hbpred\n+      have ht := phase_step hk t pred 0\n+      simp only [phase_zero, zero_add, he] at ht\n+      unfold doubleStep at ht\n+      split_ifs at ht <;> omega\n+    have hpn : actualSource k t n = 2 * actualSource k t pred - modulus k := by\n+      have ht := phase_step hk t pred 0\n+      simp only [phase_zero, zero_add, he] at ht\n+      rw [doubleStep, ite_eq_left (by omega)] at ht\n+      exact ht\n+    have hna := (hneg n hn).2.1\n+    change actualSource k t a = 2 * actualSource k t n + modulus k at hna\n+    omega\n+  have hdyadic : Dyadic (actualSource k t) (actualSource k t a) (path (by omega) a r) := by\n+    have aux : ∀ j m : ℕ, j + m ≤ r →\n+        Dyadic (actualSource k t) ((2 : ℤ) ^ j * actualSource k t a)\n+          ((List.range m).map (fun i => phase (by omega) a (j + i))) := by\n+      intro j m\n+      induction m generalizing j with\n+      | zero => intro _; trivial\n+      | succ m ih =>\n+        intro hj\n+        rw [List.range_succ_eq_map]\n+        simp only [List.map_cons, List.map_map, Function.comp_def, Nat.add_zero]\n+        refine ⟨hpow j (by omega), ?_⟩\n+        have ht := ih (j + 1) (by omega)\n+        convert ht using 1\n+        · rw [pow_succ]; ring\n+        · congr 1\n+          funext i\n+          congr 1\n+          omega\n+    simpa [path] using aux 0 r (by omega)\n+  have hsum := dyadic_sum hdyadic\n+  have hrootpow := hpow r (le_refl _)\n+  change actualSource k t root = (2 : ℤ) ^ r * actualSource k t a at hrootpow\n+  have hmass : ((path (by omega) a r).map (actualSource k t)).sum =\n+      actualSource k t root - actualSource k t a := by\n+    rw [path_length] at hsum\n+    rw [hsum, hrootpow]\n+    ring\n+  have hnextmod : actualSource k t next % 4 = 1 := by omega\n+  have hdebt : 0 ≤ -actualSource k t neg - actualSource k t root := by omega\n+  have htransport : ((path (by omega) a r).map (actualSource k t)).sum -\n+      (-actualSource k t neg - actualSource k t root) =\n+        actualSource k t next - actualSource k t a := by omega\n+  exact ⟨r, hlen, hnodup, ha, hseedmod, hpre, hdyadic, hrootpow, hroot, hu,\n+    hrootstep, hnegval, hnextstep, hnextpos, hnextmod, hmass, hdebt, htransport⟩\n+\n+end D5.S3.Combinatorics.Circle.NativeSeedChains"},{"sha":"e8a48c91e23fcfa3a2b8a100725aafd8306c3260","filename":"D5/S3/Combinatorics/Circle/SeedQueueInvariant.lean","status":"added","additions":169,"deletions":0,"changes":169,"blob_url":"https://github.com/the-omega-institute/trureturing/blob/b62773edfb6a6f7806de09b593b2e3b6834685c7/D5%2FS3%2FCombinatorics%2FCircle%2FSeedQueueInvariant.lean","raw_url":"https://github.com/the-omega-institute/trureturing/raw/b62773edfb6a6f7806de09b593b2e3b6834685c7/D5%2FS3%2FCombinatorics%2FCircle%2FSeedQueueInvariant.lean","contents_url":"https://api.github.com/repos/the-omega-institute/trureturing/contents/D5%2FS3%2FCombinatorics%2FCircle%2FSeedQueueInvariant.lean?ref=b62773edfb6a6f7806de09b593b2e3b6834685c7","patch":"@@ -0,0 +1,169 @@\n+/- GID: D5/S3/Combinatorics/Circle/SeedQueueInvariant\n+   generality: I\n+   mirror-B: D5/B/S3/Combinatorics/Circle/SeedQueueInvariant\n+   mirror-E: none(waiver:audit-open-22063)\n+   anchors: [mathlib/module/Mathlib.Algebra.Order.BigOperators.Group.List]\n+   utility: none\n+   digest: Deferred prefixes preserve ancestor heights and bound the first-omission peak. -/\n+module\n+public import D5.S3.Combinatorics.Circle.SourceWidth\n+\n+/-! # Deferred dyadic queues with physical occurrence identity -/\n+set_option autoImplicit false\n+set_option relaxedAutoImplicit false\n+@[expose] public section\n+namespace D5.S3.Combinatorics.Circle.SeedQueueInvariant\n+open SourceWidth\n+\n+/-- Initial segment before the first budget crossing, paired with its literal\n+suffix. For positive weights this is the longest affordable prefix. -/\n+def splitBudget {α : Type*} (f : α → ℤ) : ℤ → List α → List α × List α\n+  | _, [] => ([], [])\n+  | B, x :: xs => if f x ≤ B then\n+      let z := splitBudget f (B - f x) xs\n+      (x :: z.1, z.2)\n+    else ([], x :: xs)\n+\n+/-- T is preceding mass; each occurrence remembers its birth height. -/\n+def Ancestors {α : Type*} (f : α → ℤ) (mu D : ℤ) : ℤ → List α → Prop\n+  | _, [] => True\n+  | T, x :: xs => 0 ≤ f x - mu - T ∧ f x - mu - T ≤ D ∧\n+      Ancestors f mu D (T + f x) xs\n+\n+private theorem ancestor_prefix {α : Type*} {f : α → ℤ} {mu D T : ℤ}\n+    (q e : List α) (h : Ancestors f mu D T (q ++ e)) : Ancestors f mu D T q := by\n+  induction q generalizing T with\n+  | nil => trivial\n+  | cons x xs ih => exact ⟨h.1, h.2.1, ih h.2.2⟩\n+\n+private theorem ancestor_suffix {α : Type*} {f : α → ℤ} {mu D T : ℤ}\n+    (q e : List α) (h : Ancestors f mu D T (q ++ e)) :\n+    Ancestors f mu D (T + (q.map f).sum) e := by\n+  induction q generalizing T with\n+  | nil => simpa using h\n+  | cons x xs ih => simpa [add_assoc] using ih h.2.2\n+\n+private theorem ancestor_append {α : Type*} {f : α → ℤ} {mu D T : ℤ}\n+    (q e : List α) (hq : Ancestors f mu D T q)\n+    (he : Ancestors f mu D (T + (q.map f).sum) e) : Ancestors f mu D T (q ++ e) := by\n+  induction q generalizing T with\n+  | nil => simpa using he\n+  | cons x xs ih =>\n+    refine ⟨hq.1, hq.2.1, ih hq.2.2 ?_⟩\n+    simpa [add_assoc] using he\n+\n+private theorem dyadic_ancestors {α : Type*} {f : α → ℤ} {mu D T a : ℤ}\n+    {l : List α} (hl : Dyadic f a l) (hlo : 0 ≤ a - mu - T)\n+    (hhi : a - mu - T ≤ D) : Ancestors f mu D T l := by\n+  induction l generalizing a T with\n+  | nil => trivial\n+  | cons x xs ih =>\n+    refine ⟨by simpa [hl.1] using hlo, by simpa [hl.1] using hhi, ?_⟩\n+    exact ih hl.2 (by rw [hl.1]; omega) (by rw [hl.1]; omega)\n+\n+private theorem split_spec {α : Type*} (f : α → ℤ) (B : ℤ) (l : List α)\n+    (hB : 0 ≤ B) :\n+    let q := (splitBudget f B l).1\n+    let e := (splitBudget f B l).2\n+    l = q ++ e ∧ (q.map f).sum ≤ B ∧\n+      ∀ x xs, e = x :: xs → B < (q.map f).sum + f x := by\n+  induction l generalizing B with\n+  | nil => simp [splitBudget, hB]\n+  | cons x xs ih =>\n+    by_cases hx : f x ≤ B\n+    · have hp := ih (B - f x) (by omega)\n+      dsimp only at hp ⊢\n+      simp only [splitBudget, ite_eq_left hx, List.map_cons, List.sum_cons]\n+      refine ⟨?_, by omega, ?_⟩\n+      · simpa using congrArg (List.cons x) hp.1\n+      · intro y ys he\n+        have hh := hp.2.2 y ys he\n+        omega\n+    · simp only [splitBudget, ite_eq_right hx, List.nil_append, List.map_nil, List.sum_nil, true_and]\n+      refine ⟨hB, ?_⟩\n+      intro y ys he\n+      have : x = y := (List.cons.inj he).1\n+      subst y\n+      omega\n+\n+/-- Appending dyadic SMALL labels preserves every retained ancestor height.\n+A first omission bounds the peak by C+floor(D/2). If all labels are retained,\n+the peak is exactly the old height plus the root parameter. -/\n+theorem deferred_prefix_invariant {α : Type*} (f : α → ℤ)\n+    (old small : List α) (mu D a b p B C : ℤ)\n+    (hold : Ancestors f mu D 0 old) (hdyadic : Dyadic f a small)\n+    (hbirth : small ≠ [] → 0 ≤ a - mu - (old.map f).sum ∧\n+      a - mu - (old.map f).sum ≤ D)\n+    (hbudget : mu ≤ b)\n+    (htransport : (small.map f).sum - (B - p) = b - a)\n+    (hcapacity : 2 * (C - B) = b - 1) :\n+    let q := (splitBudget f (b - mu) (old ++ small)).1\n+    let e := (splitBudget f (b - mu) (old ++ small)).2\n+    let h := b - mu - (q.map f).sum\n+    old ++ small = q ++ e ∧ Ancestors f mu D 0 q ∧ 0 ≤ h ∧\n+      (a - mu - (old.map f).sum) + (e.map f).sum + p - B = h ∧\n+      (∀ x xs, e = x :: xs → h < f x ∧ B + h ≤ C + D / 2) ∧\n+      (e = [] → B + h = a - mu - (old.map f).sum + p) ∧\n+      (b = mu → (∀ x ∈ old ++ small, 0 < f x) → q = [] ∧ h = 0) := by\n+  dsimp only\n+  let q := (splitBudget f (b - mu) (old ++ small)).1\n+  let e := (splitBudget f (b - mu) (old ++ small)).2\n+  obtain ⟨hsplit, hmass, hmax⟩ := split_spec f (b - mu) (old ++ small) (by omega)\n+  change old ++ small = q ++ e at hsplit\n+  change (q.map f).sum ≤ b - mu at hmass\n+  have hall : Ancestors f mu D 0 (old ++ small) := by\n+    apply ancestor_append old small hold\n+    cases small with\n+    | nil => trivial\n+    | cons x xs =>\n+      have hh := hbirth (by simp)\n+      exact dyadic_ancestors hdyadic (by simpa using hh.1) (by simpa using hh.2)\n+  have hq := ancestor_prefix q e (hsplit ▸ hall)\n+  have he : Ancestors f mu D (q.map f).sum e := by\n+    have hsuf := ancestor_suffix q e (hsplit ▸ hall)\n+    rw [zero_add] at hsuf\n+    exact hsuf\n+  have hconserve : (old.map f).sum + (small.map f).sum =\n+      (q.map f).sum + (e.map f).sum := by\n+    have ht := congrArg (fun l : List α => (l.map f).sum) hsplit\n+    simpa only [List.map_append, List.sum_append] using ht\n+  change old ++ small = q ++ e ∧ Ancestors f mu D 0 q ∧\n+    0 ≤ b - mu - (q.map f).sum ∧\n+    (a - mu - (old.map f).sum) + (e.map f).sum + p - B =\n+      b - mu - (q.map f).sum ∧\n+    (∀ x xs, e = x :: xs → b - mu - (q.map f).sum < f x ∧\n+      B + (b - mu - (q.map f).sum) ≤ C + D / 2) ∧\n+    (e = [] → B + (b - mu - (q.map f).sum) = a - mu - (old.map f).sum + p) ∧\n+    (b = mu → (∀ x ∈ old ++ small, 0 < f x) →\n+      q = [] ∧ b - mu - (q.map f).sum = 0)\n+  change ∀ x xs, e = x :: xs → b - mu < (q.map f).sum + f x at hmax\n+  refine ⟨hsplit, hq, by omega, by omega, ?_, ?_, ?_⟩\n+  · intro x xs hex\n+    have hd : 0 ≤ f x - mu - (q.map f).sum ∧ f x - mu - (q.map f).sum ≤ D := by\n+      rw [hex] at he\n+      exact ⟨he.1, he.2.1⟩\n+    have hm := hmax x xs hex\n+    change b - mu < (q.map f).sum + f x at hm\n+    constructor <;> omega\n+  · intro hex\n+    rw [hex, List.map_nil, List.sum_nil] at hconserve\n+    omega\n+  · intro hb hpos\n+    have hqpos (x : α) (hx : x ∈ q) : 0 < f x := by\n+      apply hpos x\n+      rw [hsplit]\n+      exact List.mem_append_left _ hx\n+    have hqzero : q = [] := by\n+      cases hqeq : q with\n+      | nil => rfl\n+      | cons x xs =>\n+        have hx := hqpos x (by simp [hqeq])\n+        have htail : 0 ≤ (xs.map f).sum := List.sum_nonneg (by\n+          intro z hz\n+          obtain ⟨y, hy, rfl⟩ := List.mem_map.mp hz\n+          exact le_of_lt (hqpos y (by simp [hqeq, hy])))\n+        rw [hqeq, List.map_cons, List.sum_cons] at hmass\n+        omega\n+    exact ⟨hqzero, by simp [hqzero, hb]⟩\n+\n+end D5.S3.Combinatorics.Circle.SeedQueueInvariant"},{"sha":"093c94e63ac3942c13c8f0379b74f150e11bebae","filename":"D5/S3/VertexAlgebra/SourceBPZ/NormalScalarTranspose.lean","status":"added","additions":401,"deletions":0,"changes":401,"blob_url":"https://github.com/the-omega-institute/trureturing/blob/b62773edfb6a6f7806de09b593b2e3b6834685c7/D5%2FS3%2FVertexAlgebra%2FSourceBPZ%2FNormalScalarTranspose.lean","raw_url":"https://github.com/the-omega-institute/trureturing/raw/b62773edfb6a6f7806de09b593b2e3b6834685c7/D5%2FS3%2FVertexAlgebra%2FSourceBPZ%2FNormalScalarTranspose.lean","contents_url":"https://api.github.com/repos/the-omega-institute/trureturing/contents/D5%2FS3%2FVertexAlgebra%2FSourceBPZ%2FNormalScalarTranspose.lean?ref=b62773edfb6a6f7806de09b593b2e3b6834685c7","patch":"@@ -0,0 +1,401 @@\n+/- GID: D5/S3/VertexAlgebra/SourceBPZ/NormalScalarTranspose\n+   generality: I\n+   mirror-B: D5/B/S3/VertexAlgebra/SourceBPZ/NormalScalarTranspose\n+   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)\n+   anchors: [mathlib/module/Mathlib.RingTheory.Binomial]\n+   utility: none\n+   digest: Finite scalar normal insertion transpose on the original integer lattice carrier. -/\n+\n+import D5.S3.VertexAlgebra.LatticeSugawaraCurrents\n+import Mathlib.RingTheory.Binomial\n+import Mathlib.Algebra.BigOperators.Intervals\n+\n+/-!\n+Classical bilinear normal-order calculation on the original finite-charge\n+polynomial carrier. The current transpose is an explicit smaller supplier;\n+no all-source adjointness, symmetry or nondegeneracy of the form is assumed.\n+The normal product and divided derivative are the actual constructors of\n+FieldNormalProduct, retaining their Carnahan/native adaptation attribution.\n+The finite scalar cutoffs follow the structure of HalfFock.NormalScalarTranspose,\n+with integer reflection k ↦ -k and a separate charge-sensitive zero boundary.\n+The intended consumer is the cons step of the original wordField BPZ induction.\n+-/\n+\n+set_option autoImplicit false\n+set_option backward.isDefEq.respectTransparency false\n+set_option maxRecDepth 4096\n+\n+noncomputable section\n+open scoped BigOperators VertexOperator\n+\n+namespace D5.S3.VertexAlgebra.SourceBPZ\n+open LatticeGeneratingFieldLocality LatticeFiniteNegativeGeneration\n+open LatticeSugawaraCurrents FieldNormalProduct\n+\n+/-- Order p corresponds to insertion h_i(-(p+1)). -/\n+def insertion (D : LatticeData) (i : Fin D.rank) (p : ℕ)\n+    (F : VertexOperator ℂ (Carrier D)) : VertexOperator ℂ (Carrier D) :=\n+  (normalMinusOne (dividedDerivative p (neutralField D i)) F).1\n+\n+private def coefficient (p : ℕ) (k : ℤ) : ℂ :=\n+  ((Ring.choose (-k-1) p : ℤ) : ℂ)\n+\n+private theorem derivative_mode (D : LatticeData) (i : Fin D.rank) (p : ℕ) (m : ℤ) :\n+    ((dividedDerivative p (neutralField D i))[[m]]) =\n+      coefficient p (m-p) • neutralMode D i (m-p) := by\n+  apply LinearMap.ext\n+  intro v\n+  change Ring.choose (-m-1+p) p •\n+    HVertexOperator.coeff (neutralField D i) (-m-1+p) v = _\n+  rw [VertexOperator.coeff_eq_ncoeff, neutralField_ncoeff]\n+  rw [show -(-m-1+p)-1 = m-p by omega]\n+  simp only [coefficient, LinearMap.smul_apply, Int.cast_smul_eq_zsmul]\n+  congr 2; omega\n+\n+private theorem coefficient_zero_band (p : ℕ) (k : ℤ)\n+    (hk : -(p : ℤ) ≤ k) (hn : k < 0) : coefficient p k = 0 := by\n+  have ha : 0 ≤ -k-1 := by omega\n+  obtain ⟨a, he⟩ := Int.eq_ofNat_of_zero_le ha\n+  have hb : a < p := by omega\n+  simp [coefficient, he, Ring.choose_natCast, Nat.choose_eq_zero_of_lt hb]\n+\n+private theorem coefficient_reflection (p : ℕ) (j : ℤ) :\n+    -coefficient p (-j) = (-1 : ℂ)^(p+1) *\n+      ∑ s ∈ Finset.range (p+1), ((p+1).choose (s+1) : ℂ) * coefficient s j := by\n+  have h : Ring.choose (j-1) p = (-1 : ℤ)^p *\n+      ∑ s ∈ Finset.range (p+1), ((p+1).choose (s+1) : ℤ) * Ring.choose (-j-1) s := by\n+    rw [show j-1 = -(-j+1) by ring, Ring.choose_neg]\n+    rw [show (-j+1)+(p : ℤ)-1 = (-j-1)+((p+1 : ℕ) : ℤ) by push_cast; ring]\n+    rw [Ring.add_choose_eq p (Commute.all _ _),\n+      Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk]\n+    simp only [Units.smul_def, zsmul_eq_mul, Int.cast_negOnePow_natCast]\n+    congr 1\n+    apply Finset.sum_congr rfl\n+    intro s hs\n+    have hs' : s ≤ p := Nat.le_of_lt_succ (Finset.mem_range.mp hs)\n+    rw [Ring.choose_natCast, ← Nat.choose_symm (by omega : p-s ≤ p+1),\n+      show p+1-(p-s) = s+1 by omega]\n+    ring\n+  have hc := congrArg (fun z : ℤ => (z : ℂ)) h\n+  push_cast at hc\n+  simp only [coefficient, neg_neg]\n+  rw [hc, pow_succ]\n+  ring\n+\n+private theorem coefficient_at_zero (p : ℕ) :\n+    coefficient p 0 = (-1 : ℂ)^p := by\n+  simp only [coefficient, neg_zero, zero_sub]\n+  rw [show (-1 : ℤ) = -(1 : ℤ) by rfl, Ring.choose_neg]\n+  simp [Units.smul_def, Ring.choose_natCast]\n+\n+private theorem forward_finite (D : LatticeData) (L F : VertexOperator ℂ (Carrier D))\n+    (m : ℤ) (u : Carrier D) :\n+    Function.HasFiniteSupport (fun t : ℕ => (L[[-(t : ℤ)-1]]) ((F[[m+t]]) u)) := by\n+  refine BddAbove.finite (bddAbove_def.mpr ?_)\n+  refine ⟨(-((HahnModule.of ℂ).symm (F u)).order-m).toNat, ?_⟩\n+  intro t ht\n+  contrapose! ht\n+  have hz : (F[[m+t]]) u = 0 := by\n+    apply VertexOperator.ncoeff_eq_zero_of_lt_order\n+    omega\n+  simp [hz]\n+\n+private theorem reverse_finite (D : LatticeData) (L F : VertexOperator ℂ (Carrier D))\n+    (m : ℤ) (u : Carrier D) :\n+    Function.HasFiniteSupport (fun t : ℕ => (F[[m-t-1]]) ((L[[t]]) u)) := by\n+  refine BddAbove.finite (bddAbove_def.mpr ?_)\n+  refine ⟨(-((HahnModule.of ℂ).symm (L u)).order-1).toNat, ?_⟩\n+  intro t ht\n+  contrapose! ht\n+  have hz : (L[[t]]) u = 0 := by\n+    apply VertexOperator.ncoeff_eq_zero_of_lt_order\n+    omega\n+  simp [hz]\n+\n+private def cutoff (D : LatticeData) (u : Carrier D) : ℕ :=\n+  vectorFrequencyBound D u + 1\n+\n+private theorem cutoff_pos (D : LatticeData) (u : Carrier D) : 0 < cutoff D u := by\n+  simp [cutoff]\n+\n+private theorem cutoff_vanish (D : LatticeData) (i : Fin D.rank) (u : Carrier D)\n+    (k : ℤ) (hk : (cutoff D u : ℤ) ≤ k) : neutralMode D i k u = 0 := by\n+  apply neutralMode_vanish\n+  dsimp [cutoff] at hk\n+  omega\n+\n+private theorem scalar_offsets (D : LatticeData) (B : LinearMap.BilinForm ℂ (Carrier D))\n+    (i : Fin D.rank)\n+    (hB : ∀ k x y, B (neutralMode D i k x) y = -B x (neutralMode D i (-k) y))\n+    (p : ℕ) (F : VertexOperator ℂ (Carrier D)) (m : ℤ) (u v : Carrier D) :\n+    B (((insertion D i p F)[[m]]) u) v =\n+      (∑ t ∈ Finset.range (cutoff D v),\n+        coefficient p (-(t : ℤ)-1-p) *\n+          B (neutralMode D i (-(t : ℤ)-1-p) ((F[[m+t]]) u)) v) +\n+      ∑ t ∈ Finset.range (cutoff D u+p),\n+        coefficient p ((t : ℤ)-p) *\n+          B ((F[[m-t-1]]) (neutralMode D i ((t : ℤ)-p) u)) v := by\n+  let L := dividedDerivative p (neutralField D i)\n+  rw [insertion, (normalMinusOne L F).2]\n+  change (B.flip v) (_+_) = _\n+  rw [map_add, map_finsum (B.flip v) (forward_finite D L F m u),\n+    map_finsum (B.flip v) (reverse_finite D L F m u)]\n+  simp only [L, derivative_mode, LinearMap.smul_apply, LinearMap.BilinForm.flip_apply,\n+    map_smul, smul_eq_mul]\n+  congr 1\n+  · apply finsum_eq_sum_of_support_subset\n+    intro t ht\n+    simp only [Finset.mem_coe, Finset.mem_range]\n+    by_contra ho\n+    have hz : neutralMode D i (-(-(t : ℤ)-1-p)) v = 0 := by\n+      apply cutoff_vanish\n+      omega\n+    exact ht (by dsimp only; rw [hB, hz, map_zero, neg_zero, mul_zero])\n+  · apply finsum_eq_sum_of_support_subset\n+    intro t ht\n+    simp only [Finset.mem_coe, Finset.mem_range]\n+    by_contra ho\n+    have hz : neutralMode D i ((t : ℤ)-p) u = 0 := by\n+      apply cutoff_vanish\n+      omega\n+    exact ht (by dsimp only; simp [hz])\n+\n+/- Both scalar intervals are independent of the tail field and the derivative\n+order. The omitted derivative bands vanish by integer binomial coefficients. -/\n+private theorem scalar_interval (D : LatticeData) (B : LinearMap.BilinForm ℂ (Carrier D))\n+    (i : Fin D.rank)\n+    (hB : ∀ k x y, B (neutralMode D i k x) y = -B x (neutralMode D i (-k) y))\n+    (p : ℕ) (F : VertexOperator ℂ (Carrier D)) (m : ℤ) (u v : Carrier D) :\n+    B (((insertion D i p F)[[m]]) u) v =\n+      (∑ k ∈ Finset.Icc (1-(cutoff D v : ℤ)) (-1),\n+        coefficient p k * B (neutralMode D i k ((F[[m-k-p-1]]) u)) v) +\n+      ∑ k ∈ Finset.Icc 0 ((cutoff D u : ℤ)-1),\n+        coefficient p k * B ((F[[m-k-p-1]]) (neutralMode D i k u)) v := by\n+  rw [scalar_offsets D B i hB]\n+  congr 1\n+  · apply Finset.sum_bij_ne_zero (fun (t : ℕ) _ _ => -(t : ℤ)-1-p)\n+    · intro t ht hn\n+      rw [Finset.mem_Icc]\n+      constructor\n+      · by_contra ho\n+        have hz : neutralMode D i (-(-(t : ℤ)-1-p)) v = 0 := by\n+          apply cutoff_vanish\n+          omega\n+        exact hn (by rw [hB, hz, map_zero, neg_zero, mul_zero])\n+      · omega\n+    · intro a ha hna b hb hnb he\n+      omega\n+    · intro k hk hn\n+      have hk' := Finset.mem_Icc.mp hk\n+      have below : k < -(p : ℤ) := by\n+        by_contra ho\n+        exact hn (by rw [coefficient_zero_band p k (by omega) (by omega), zero_mul])\n+      refine ⟨(-k-1-p).toNat, ?_, ?_, ?_⟩\n+      · rw [Finset.mem_range]\n+        have hc := cutoff_pos D v\n+        omega\n+      · have he : (((-k-1-p).toNat : ℕ) : ℤ) = -k-1-p :=\n+          Int.toNat_of_nonneg (by omega)\n+        simpa only [he, show -(-k-1-p)-1-(p : ℤ) = k by omega,\n+          show m+(-k-1-p) = m-k-p-1 by omega] using hn\n+      · have he := Int.toNat_of_nonneg (show 0 ≤ -k-1-p by omega)\n+        omega\n+    · intro t ht hn\n+      simp only [show m-(-(t : ℤ)-1-p)-p-1 = m+t by omega]\n+  · apply Finset.sum_bij_ne_zero (fun (t : ℕ) _ _ => (t : ℤ)-p)\n+    · intro t ht hn\n+      have ht' := Finset.mem_range.mp ht\n+      rw [Finset.mem_Icc]\n+      constructor\n+      · by_contra ho\n+        exact hn (by rw [coefficient_zero_band p ((t : ℤ)-p) (by omega) (by omega),\n+          zero_mul])\n+      · omega\n+    · intro a ha hna b hb hnb he\n+      omega\n+    · intro k hk hn\n+      have hk' := Finset.mem_Icc.mp hk\n+      refine ⟨(k+p).toNat, ?_, ?_, ?_⟩\n+      · rw [Finset.mem_range]\n+        omega\n+      · have he : (((k+p).toNat : ℕ) : ℤ) = k+p := Int.toNat_of_nonneg (by omega)\n+        simpa only [he, show k+(p : ℤ)-p = k by omega,\n+          show m-(k+p)-1 = m-k-p-1 by omega] using hn\n+      · have he := Int.toNat_of_nonneg (show 0 ≤ k+p by omega)\n+        omega\n+    · intro t ht hn\n+      simp only [show m-((t : ℤ)-p)-p-1 = m-t-1 by omega]\n+\n+private theorem flipped_current (D : LatticeData) (B : LinearMap.BilinForm ℂ (Carrier D))\n+    (i : Fin D.rank)\n+    (hB : ∀ k x y, B (neutralMode D i k x) y = -B x (neutralMode D i (-k) y)) :\n+    ∀ k x y, B.flip (neutralMode D i k x) y =\n+      -B.flip x (neutralMode D i (-k) y) := by\n+  intro k x y\n+  have h := hB (-k) y x\n+  simp only [neg_neg] at h\n+  change B y (neutralMode D i k x) = -B (neutralMode D i (-k) y) x\n+  linear_combination h\n+\n+private theorem right_interval (D : LatticeData) (B : LinearMap.BilinForm ℂ (Carrier D))\n+    (i : Fin D.rank)\n+    (hB : ∀ k x y, B (neutralMode D i k x) y = -B x (neutralMode D i (-k) y))\n+    (p : ℕ) (G : VertexOperator ℂ (Carrier D)) (H : ℤ) (u v : Carrier D) :\n+    B u (((insertion D i p G)[[H+p+1]]) v) =\n+      (∑ j ∈ Finset.Icc (1-(cutoff D u : ℤ)) (-1),\n+        coefficient p j * B u (neutralMode D i j ((G[[H-j]]) v))) +\n+      ∑ j ∈ Finset.Icc 0 ((cutoff D v : ℤ)-1),\n+        coefficient p j * B u ((G[[H-j]]) (neutralMode D i j v)) := by\n+  have h := scalar_interval D B.flip i (flipped_current D B i hB) p G (H+p+1) v u\n+  simpa only [LinearMap.BilinForm.flip_apply,\n+    show ∀ j : ℤ, H+p+1-j-p-1 = H-j by intro j; omega] using h\n+\n+private theorem reflect_interval (f : ℤ → ℂ) (a b : ℤ) :\n+    ∑ k ∈ Finset.Icc a b, f k = ∑ j ∈ Finset.Icc (-b) (-a), f (-j) := by\n+  apply Finset.sum_bij (fun k _ => -k)\n+  · intro k hk\n+    simp only [Finset.mem_Icc] at hk ⊢\n+    omega\n+  · intro k hk l hl he\n+    omega\n+  · intro j hj\n+    refine ⟨-j, ?_, by omega⟩\n+    simp only [Finset.mem_Icc] at hj ⊢\n+    omega\n+  · intro k hk\n+    simp\n+\n+private theorem reflection_sum (p : ℕ) (J : Finset ℤ) (f : ℤ → ℂ) :\n+    (∑ j ∈ J, -coefficient p (-j) * f j) =\n+      (-1 : ℂ)^(p+1) * ∑ s ∈ Finset.range (p+1),\n+        ((p+1).choose (s+1) : ℂ) * ∑ j ∈ J, coefficient s j * f j := by\n+  simp only [coefficient_reflection, Finset.sum_mul, Finset.mul_sum]\n+  rw [Finset.sum_comm]\n+  apply Finset.sum_congr rfl\n+  intro s hs\n+  apply Finset.sum_congr rfl\n+  intro j hj\n+  ring\n+\n+private theorem reflected_to_insertion (D : LatticeData)\n+    (B : LinearMap.BilinForm ℂ (Carrier D)) (i : Fin D.rank)\n+    (hB : ∀ k x y, B (neutralMode D i k x) y = -B x (neutralMode D i (-k) y))\n+    (p : ℕ) (G : VertexOperator ℂ (Carrier D)) (κ : ℂ)\n+    (hzero : ∀ t x, neutralMode D i 0 ((G[[t]]) x) =\n+      (G[[t]]) (neutralMode D i 0 x) + κ • (G[[t]]) x)\n+    (H : ℤ) (u v : Carrier D) :\n+    (∑ j ∈ Finset.Icc 1 ((cutoff D v : ℤ)-1),\n+      -coefficient p (-j) * B u ((G[[H-j]]) (neutralMode D i j v))) +\n+    (∑ j ∈ Finset.Icc (1-(cutoff D u : ℤ)) 0,\n+      -coefficient p (-j) * B u (neutralMode D i j ((G[[H-j]]) v))) =\n+    (-1 : ℂ)^(p+1) *\n+      ((∑ s ∈ Finset.range (p+1), ((p+1).choose (s+1) : ℂ) *\n+        B u (((insertion D i s G)[[H+s+1]]) v)) + κ * B u ((G[[H]]) v)) := by\n+  classical\n+  let left := fun j : ℤ => B u (neutralMode D i j ((G[[H-j]]) v))\n+  let right := fun j : ℤ => B u ((G[[H-j]]) (neutralMode D i j v))\n+  have hl : Finset.Icc (1-(cutoff D u : ℤ)) 0 =\n+      insert 0 (Finset.Icc (1-(cutoff D u : ℤ)) (-1)) := by\n+    have h := cutoff_pos D u\n+    ext j\n+    simp only [Finset.mem_Icc, Finset.mem_insert, Finset.mem_Icc]\n+    omega\n+  have hr : Finset.Icc 0 ((cutoff D v : ℤ)-1) =\n+      insert 0 (Finset.Icc 1 ((cutoff D v : ℤ)-1)) := by\n+    have h := cutoff_pos D v\n+    ext j\n+    simp only [Finset.mem_Icc, Finset.mem_insert, Finset.mem_Icc]\n+    omega\n+  have hz : left 0 = right 0 + κ * B u ((G[[H]]) v) := by\n+    dsimp [left, right]\n+    rw [sub_zero, hzero]\n+    simp [map_add, map_smul, smul_eq_mul]\n+  have ordered :\n+      (∑ j ∈ Finset.Icc 1 ((cutoff D v : ℤ)-1), -coefficient p (-j) * right j) +\n+      (∑ j ∈ Finset.Icc (1-(cutoff D u : ℤ)) 0, -coefficient p (-j) * left j) =\n+      ((∑ j ∈ Finset.Icc (1-(cutoff D u : ℤ)) (-1), -coefficient p (-j) * left j) +\n+      (∑ j ∈ Finset.Icc 0 ((cutoff D v : ℤ)-1), -coefficient p (-j) * right j)) +\n+        (-1 : ℂ)^(p+1) * κ * B u ((G[[H]]) v) := by\n+    rw [hl, hr, Finset.sum_insert (by simp), Finset.sum_insert (by simp)]\n+    rw [neg_zero, coefficient_at_zero, hz, pow_succ]\n+    ring\n+  rw [ordered, reflection_sum, reflection_sum, ← mul_add]\n+  have hsum :\n+      (∑ s ∈ Finset.range (p+1), ((p+1).choose (s+1) : ℂ) *\n+        ∑ j ∈ Finset.Icc (1-(cutoff D u : ℤ)) (-1), coefficient s j * left j) +\n+      (∑ s ∈ Finset.range (p+1), ((p+1).choose (s+1) : ℂ) *\n+        ∑ j ∈ Finset.Icc 0 ((cutoff D v : ℤ)-1), coefficient s j * right j) =\n+      ∑ s ∈ Finset.range (p+1), ((p+1).choose (s+1) : ℂ) *\n+        B u (((insertion D i s G)[[H+s+1]]) v) := by\n+    rw [← Finset.sum_add_distrib]\n+    apply Finset.sum_congr rfl\n+    intro s hs\n+    rw [right_interval D B i hB]\n+    dsimp [left, right]\n+    ring\n+  rw [hsum]\n+  ring\n+\n+/-- Finite original scalar insertion law. Here n=p+1, and the summation index\n+s=r-1 runs through 0,...,p. The last summand deletes the inserted oscillator.\n+Only the smaller current law, a finite tail transpose, and its zero-mode charge\n+covariance are premises. In particular the all-source BPZ law is not a premise. -/\n+theorem consumed_normal_product_form (D : LatticeData)\n+    (B : LinearMap.BilinForm ℂ (Carrier D)) (i : Fin D.rank)\n+    (hB : ∀ k x y, B (neutralMode D i k x) y = -B x (neutralMode D i (-k) y))\n+    (p : ℕ) (F : VertexOperator ℂ (Carrier D))\n+    {σ : Type*} (S : Finset σ) (G : σ → VertexOperator ℂ (Carrier D))\n+    (weight : σ → ℂ) (K : σ → ℤ) (κ : ℂ)\n+    (htail : ∀ t x y, B ((F[[t]]) x) y =\n+      ∑ a ∈ S, weight a * B x (((G a)[[K a - t]]) y))\n+    (hzero : ∀ a ∈ S, ∀ t x, neutralMode D i 0 (((G a)[[t]]) x) =\n+      ((G a)[[t]]) (neutralMode D i 0 x) + κ • ((G a)[[t]]) x)\n+    (m : ℤ) (u v : Carrier D) :\n+    B (((insertion D i p F)[[m]]) u) v =\n+      (-1 : ℂ)^(p+1) * ∑ a ∈ S, weight a *\n+        ((∑ s ∈ Finset.range (p+1), ((p+1).choose (s+1) : ℂ) *\n+          B u (((insertion D i s (G a))[[K a+p+s+2-m]]) v)) +\n+          κ * B u (((G a)[[K a+p+1-m]]) v)) := by\n+  classical\n+  have negative (k : ℤ) :\n+      coefficient p k * B (neutralMode D i k ((F[[m-k-p-1]]) u)) v =\n+      ∑ a ∈ S, weight a * (-coefficient p k *\n+        B u (((G a)[[K a+p+1-m+k]]) (neutralMode D i (-k) v))) := by\n+    rw [hB, htail, ← Finset.sum_neg_distrib, Finset.mul_sum]\n+    apply Finset.sum_congr rfl\n+    intro a ha\n+    rw [show K a-(m-k-p-1) = K a+p+1-m+k by omega]\n+    ring\n+  have positive (k : ℤ) :\n+      coefficient p k * B ((F[[m-k-p-1]]) (neutralMode D i k u)) v =\n+      ∑ a ∈ S, weight a * (-coefficient p k *\n+        B u (neutralMode D i (-k) (((G a)[[K a+p+1-m+k]]) v))) := by\n+    rw [htail, Finset.mul_sum]\n+    apply Finset.sum_congr rfl\n+    intro a ha\n+    rw [hB, show K a-(m-k-p-1) = K a+p+1-m+k by omega]\n+    ring\n+  rw [scalar_interval D B i hB]\n+  simp_rw [negative, positive]\n+  rw [Finset.sum_comm (s := Finset.Icc (1-(cutoff D v : ℤ)) (-1)) (t := S),\n+    Finset.sum_comm (s := Finset.Icc 0 ((cutoff D u : ℤ)-1)) (t := S),\n+    ← Finset.sum_add_distrib, Finset.mul_sum]\n+  apply Finset.sum_congr rfl\n+  intro a ha\n+  rw [← Finset.mul_sum, ← Finset.mul_sum, ← mul_add]\n+  rw [reflect_interval (fun k => -coefficient p k *\n+      B u (((G a)[[K a+p+1-m+k]]) (neutralMode D i (-k) v)))\n+      (1-(cutoff D v : ℤ)) (-1),\n+    reflect_interval (fun k => -coefficient p k *\n+      B u (neutralMode D i (-k) (((G a)[[K a+p+1-m+k]]) v)))\n+      0 ((cutoff D u : ℤ)-1)]\n+  simp only [neg_neg, neg_zero,\n+    show -(1-(cutoff D v : ℤ)) = (cutoff D v : ℤ)-1 by omega,\n+    show -((cutoff D u : ℤ)-1) = 1-(cutoff D u : ℤ) by omega,\n+    show ∀ j : ℤ, K a+p+1-m+-j = (K a+p+1-m)-j by intro j; omega]\n+  rw [reflected_to_insertion D B i hB p (G a) κ (hzero a ha)]\n+  have hm : ∀ s : ℕ, K a+p+1-m+s+1 = K a+p+s+2-m := by intro s; omega\n+  simp only [hm]\n+  ring\n+\n+end D5.S3.VertexAlgebra.SourceBPZ"},{"sha":"8526098f6488f474ad0257b9dd941acedb37be33","filename":"Golden/Frozen/state/D5/S1/Dynamics/FiniteFiberEntropy.lean.json","status":"added","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/the-omega-institute/trureturing/blob/b62773edfb6a6f7806de09b593b2e3b6834685c7/Golden%2FFrozen%2Fstate%2FD5%2FS1%2FDynamics%2FFiniteFiberEntropy.lean.json","raw_url":"https://github.com/the-omega-institute/trureturing/raw/b62773edfb6a6f7806de09b593b2e3b6834685c7/Golden%2FFrozen%2Fstate%2FD5%2FS1%2FDynamics%2FFiniteFiberEntropy.lean.json","contents_url":"https://api.github.com/repos/the-omega-institute/trureturing/contents/Golden%2FFrozen%2Fstate%2FD5%2FS1%2FDynamics%2FFiniteFiberEntropy.lean.json?ref=b62773edfb6a6f7806de09b593b2e3b6834685c7","patch":"@@ -0,0 +1 @@\n+{\"statement_id\":\"sha256:9e9d8d66774bb7e674e7ff37b420039fedc722650422573ffb6785478c1