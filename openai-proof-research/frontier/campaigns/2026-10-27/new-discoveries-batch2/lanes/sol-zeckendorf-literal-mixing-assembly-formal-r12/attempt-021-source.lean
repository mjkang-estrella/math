import Observables
import Mathlib.MeasureTheory.MeasurableSpace.Basic
set_option autoImplicit false
namespace LiteralGame
attribute [local instance] Classical.propDecidable

abbrev Outcome (N : ℕ) := {w // w ∈ completeDomain N}
noncomputable def eventProb (N : ℕ) (A : Set (Outcome N)) : ℝ :=
  ∑ w ∈ (completeDomain N).attach, if w ∈ A then (P N w:ℝ) else 0

theorem eventProb_nonneg (N : ℕ) (A : Set (Outcome N)) : 0≤eventProb N A := by
  apply Finset.sum_nonneg
  intro w _
  split_ifs
  · exact_mod_cast P_nonneg N w
  · exact le_rfl

theorem eventProb_univ (N : ℕ) : eventProb N Set.univ = 1 := by
  simp only [eventProb,Set.mem_univ,ite_true,Finset.sum_attach]
  exact_mod_cast P_normalized N

theorem eventProb_mono (N : ℕ) {A B : Set (Outcome N)} (h : A ⊆ B) :
    eventProb N A ≤ eventProb N B := by
  apply Finset.sum_le_sum
  intro w _
  have hp : (0:ℝ) ≤ (P N w:ℝ) := by exact_mod_cast P_nonneg N w
  by_cases ha : w ∈ A <;> by_cases hb : w ∈ B <;> simp_all

theorem eventProb_le_one (N : ℕ) (A : Set (Outcome N)) : eventProb N A ≤ 1 := by
  rw [← eventProb_univ N]
  exact eventProb_mono N (Set.subset_univ A)

theorem eventProb_compl (N : ℕ) (A : Set (Outcome N)) :
    eventProb N Aᶜ = 1-eventProb N A := by
  have he : eventProb N Aᶜ + eventProb N A = eventProb N Set.univ := by
    unfold eventProb
    rw [← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro w _
    by_cases h : w∈A <;> simp [h]
  rw [eventProb_univ] at he
  linarith

theorem eventProb_inter_compl (N : ℕ) (A B : Set (Outcome N)) :
    eventProb N (Aᶜ ∩ B) = eventProb N B-eventProb N (A∩B) := by
  have he : eventProb N (Aᶜ∩B) + eventProb N (A∩B) = eventProb N B := by
    unfold eventProb
    rw [← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro w _
    by_cases ha : w∈A <;> by_cases hb : w∈B <;> simp [ha,hb]
  linarith

theorem covariance_upper (N : ℕ) (A B : Set (Outcome N)) :
    eventProb N (A∩B)-eventProb N A*eventProb N B ≤ 1/4 := by
  have hp := eventProb_nonneg N A
  have hq := eventProb_nonneg N B
  have hrp := eventProb_mono N (Set.inter_subset_left (s:=A) (t:=B))
  have hrq := eventProb_mono N (Set.inter_subset_right (s:=A) (t:=B))
  by_cases h : eventProb N A ≤ eventProb N B
  · nlinarith [sq_nonneg (eventProb N A-1/2),
      mul_nonneg hp (sub_nonneg.mpr h)]
  · nlinarith [sq_nonneg (eventProb N B-1/2),
      mul_nonneg hq (sub_nonneg.mpr (le_of_not_ge h))]

theorem covariance_abs_upper (N : ℕ) (A B : Set (Outcome N)) :
    |eventProb N (A∩B)-eventProb N A*eventProb N B| ≤ 1/4 := by
  apply abs_le.mpr
  refine ⟨?_,covariance_upper N A B⟩
  have h := covariance_upper N Aᶜ B
  rw [eventProb_compl,eventProb_inter_compl] at h
  nlinarith

-- The full sigma-algebra generated by all indicated coordinates, with the
-- discrete sigma-algebra on each coordinate. Index zero is the constant zero.
noncomputable def coordinateSigma (N : ℕ) (I : Set ℕ) : MeasurableSpace (Outcome N) :=
  ⨆ i ∈ I, MeasurableSpace.comap (fun w : Outcome N => X w i) ⊤
noncomputable def prefixSigma (N m : ℕ) := coordinateSigma N (Set.Icc 0 m)
noncomputable def suffixSigma (N r : ℕ) := coordinateSigma N (Set.Icc r (duration N))

-- Published Eq.(7), absolute covariance, over full generated event classes.
-- Empty suffixes are trivial, as for the padded finite row.
noncomputable def literalAlpha (N k : ℕ) : ℝ := sSup
  {x | ∃ m, m ≤ duration N ∧ ∃ A B : Set (Outcome N),
    (prefixSigma N m).MeasurableSet' A ∧
    (suffixSigma N (m+k)).MeasurableSet' B ∧
    x = |eventProb N (A∩B)-eventProb N A*eventProb N B|}

theorem literalAlpha_bounds (N k : ℕ) : 0 ≤ literalAlpha N k ∧ literalAlpha N k ≤ 1/4 := by
  let S : Set ℝ := {x | ∃ m, m ≤ duration N ∧ ∃ A B : Set (Outcome N),
    (prefixSigma N m).MeasurableSet' A ∧
    (suffixSigma N (m+k)).MeasurableSet' B ∧
    x = |eventProb N (A∩B)-eventProb N A*eventProb N B|}
  have h0 : (0:ℝ) ∈ S := by
    refine ⟨0,Nat.zero_le _,∅,∅,MeasurableSet.empty,MeasurableSet.empty,?_⟩
    simp [eventProb]
  have hu : ∀ x ∈ S, x ≤ (1:ℝ)/4 := by
    rintro x ⟨m,_,A,B,_,_,rfl⟩
    exact covariance_abs_upper N A B
  exact ⟨le_csSup ⟨1/4,hu⟩ h0,csSup_le ⟨0,h0⟩ hu⟩

end LiteralGame
