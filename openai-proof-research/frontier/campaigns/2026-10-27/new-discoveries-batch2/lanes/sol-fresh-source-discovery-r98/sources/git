<div id="S5.I4.i2.p1" class="ltx_para">
<p id="S5.I4.i2.p1.1" class="ltx_p">For <math id="S5.I4.i2.p1.m1" class="ltx_Math" alttext="\mathscr{Q}_{n}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒬</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{Q}_{n}(m,t)</annotation></semantics></math>:</p>
