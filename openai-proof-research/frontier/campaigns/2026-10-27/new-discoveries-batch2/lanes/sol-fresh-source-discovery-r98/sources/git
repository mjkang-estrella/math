ce="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow></mrow></mrow><mo>=</mo><mrow><msub><mi>c</mi><mi>k</mi></msub><mo>−</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mrow><msub><mi>k</mi><mn>1</mn></msub><mo>+</mo><msub><mi>k</mi><mn>2</mn></msub></mrow><mo>=</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></munder><mrow><msub><mi>c</mi><msub><mi>k</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><msub><mi>k</mi><mn>2</mn></msub></msub></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}&amp;c_{k}-\frac{1}{2}\lim_{n\to\infty}\sum_{\begin{subarray}{c}j_{1}+j_{2}=j,\\
