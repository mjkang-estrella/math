&amp;\leq\Big(\kern-3.00003pt\Big(\genfrac{}{}{0.0pt}{}{m_0}{n}\Big)\kern-3.00003pt\Big)+2\sum_{a=0}^{n}\Big(\kern-3.00003pt\Big(\genfrac{}{}{0.0pt}{}{m_0}{a}\Big)\kern-3.00003pt\Big)\cdot\Big(\kern-3.00003pt\Big(\genfrac{}{}{0.0pt}{}{m_0}{n-a}\Big)\kern-3.00003pt\Big)=\frac{2n^{2m_{0}-1}}{(2m_{0}-1)!}+O(n^{2m_{0}-2}).\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mpadded style="width:0.089em;" width="0.089em"><mo maxsize="1.600em" minsize="1.600em">(</mo></mpadded><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac linethickness="0.0pt"><msub><mi>m</mi><mn>0</mn></msub><mi>n</mi></mfrac><mpadded style="width:0em;" width="0em"><mo maxsize="1.600em" minsize="1.600em">)</mo></mpadded></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo rspace="0.055em">+</mo><mrow><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>a</mi><mo>=</mo><mn>4</mn></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><mpadded style="width:0.089em;" width="0.089em"><mo maxsize="1.600em" minsize="1.600em">(</mo></mpadded><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac linethickness="0.0pt"><msub><mi>m</mi><mn>0</mn></msub><mi>a</mi></mfrac><mpadded style="width:0em;" width="0em"><mo maxsize="1.600em" minsize="1.600em">)</mo></mpadded></mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mpadded style="width:0.089em;" width="0.089em"><mo maxsize="1.600em" minsize="1.600em">(</mo></mpadded><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac linethickness="0.0pt"><msub><mi>m</mi><mn>0</mn></msub><mrow><mi>n</mi><mo>−</mo><mi>a</mi></mrow></mfrac><mpadded style="width:0em;" width="0em"><mo maxsize="1.600em" minsize="1.600em">)</mo></mpadded></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo rspace="0.055em">+</mo><mrow><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>a</mi><mo>=</mo><mn>3</mn></mrow><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></munderover><mrow><mpadded style="width:0.089em;" width="0.089em"><mo maxsize="1.600em" minsize="1.600em">(</mo></mpadded><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac linethickness="0.0pt"><msub><mi>m</mi><mn>0</mn></msub><mi>a</mi></mfrac><mpadded style="width:0em;" width="0em"><mo maxsize="1.600em" minsize="1.600em">)</mo></mpadded></mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mpadded style="width:0.089em;" width="0.089em"><mo maxsize="1.600em" minsize="1.600em">(</mo></mpadded><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac linethickness="0.0pt"><msub><mi>m</mi><mn>0</mn></msub><mrow><mi>n</mi><mo>−</mo><mi>a</mi></mrow></mfrac><mpadded style="width:0em;" width="0em"><mo maxsize="1.600em" minsize="1.600em">)</mo></mpadded></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mpadded style="width:0.089em;" width="0.089em"><mo maxsize="1.600em" minsize="1.600em">(</mo></mpadded><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac linethickness="0.0pt"><msub><mi>m</mi><mn>0</mn></msub><mi>n</mi></mfrac><mpadded style="width:0em;" width="0em"><mo maxsize="1.600em" minsize="1.600em">)</mo></mpadded></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo>+</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>a</mi><mo>=</mo><mn>0</mn></mrow><mi>n</mi></munderover><mrow><mpadded style="width:0.089em;" width="0.089em"><mo maxsize="1.600em" minsize="1.600em">(</mo></mpadded><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac linethickness="0.0pt"><msub><mi>m</mi><mn>0</mn></msub><mi>a</mi></mfrac><mpadded style="width:0em;" width="0em"><mo maxsize="1.600em" minsize="1.600em">)</mo></mpadded></mrow><mo maxsize="1.600em" minsize="1.600em" rspace="0.055em">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mpadded style="width:0.089em;" width="0.089em"><mo maxsize="1.600em" minsize="1.600em">(</mo></mpadded><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac linethickness="0.0pt"><msub><mi>m</mi><mn>0</mn></msub><mrow><mi>n</mi><mo>−</mo><mi>a</mi></mrow></mfrac><mpadded style="width:0em;" width="0em"><mo maxsize="1.600em" minsize="1.600em">)</mo></mpadded></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>0</mn></msub></mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>0</mn></msub></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow></mfrac><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>n</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>0</mn></msub></mrow><mo>−</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}&amp;\Big(\kern-3.00003pt\Big(\genfrac{}{}{0.0pt}{}{m_0}{n}\Big)\kern-3.00003pt\Big)+\sum_{a=4}^{n-1}\Big(\kern-3.00003pt\Big(\genfrac{}{}{0.0pt}{}{m_0}{a}\Big)\kern-3.00003pt\Big)\cdot\Big(\kern-3.00003pt\Big(\genfrac{}{}{0.0pt}{}{m_0}{n-a}\Big)\kern-3.00003pt\Big)+\sum_{a=3}^{n-2}\Big(\kern-3.00003pt\Big(\genfrac{}{}{0.0pt}{}{m_0}{a}\Big)\kern-3.00003pt\Big)\cdot\Big(\kern-3.00003pt\Big(\genfrac{}{}{0.0pt}{}{m_0}{n-a}\Big)\kern-3.00003pt\Big)\\
&amp;\leq\Big(\kern-3.00003pt\Big(\genfrac{}{}{0.0pt}{}{m_0}{n}\Big)\kern-3.00003pt\Big)+2\sum_{a=0}^{n}\Big(\kern-3.00003pt\Big(\genfrac{}{}{0.0pt}{}{m_0}{a}\Big)\kern-3.00003pt\Big)\cdot\Big(\kern-3.00003pt\Big(\genfrac{}{}{0.0pt}{}{m_0}{n-a}\Big)\kern-3.00003pt\Big)=\frac{2n^{2m_{0}-1}}{(2m_{0}-1)!}+O(n^{2m_{0}-2}).\end{split}</annotation></semantics></math></td>
