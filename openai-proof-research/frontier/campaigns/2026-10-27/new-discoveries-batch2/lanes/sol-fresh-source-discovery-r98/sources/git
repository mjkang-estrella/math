<p id="S5.I4.i2.I1.i1.p1.1" class="ltx_p"><math id="S5.I4.i2.I1.i1.p1.m1" class="ltx_Math" alttext="n=72" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>72</mn></mrow><annotation encoding="application/x-tex">n=72</annotation></semantics></math> and <math id="S5.I4.i2.I1.i1.p1.m2" class="ltx_Math" alttext="k=28,30,40,42" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>=</mo><mn>28</mn></mrow><mo>,</mo><mn>30</mn><mo>,</mo><mn>40</mn><mo>,</mo><mn>42</mn></mrow><annotation encoding="application/x-tex">k=28,30,40,42</annotation></semantics></math>.</p>
