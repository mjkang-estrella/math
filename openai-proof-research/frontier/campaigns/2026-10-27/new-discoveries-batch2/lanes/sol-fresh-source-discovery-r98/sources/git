<p id="S5.I4.i1.I1.i4.p1.1" class="ltx_p"><math id="S5.I4.i1.I1.i4.p1.m1" class="ltx_Math" alttext="n=72" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>72</mn></mrow><annotation encoding="application/x-tex">n=72</annotation></semantics></math> and <math id="S5.I4.i1.I1.i4.p1.m2" class="ltx_Math" alttext="k=27,30,32,33,36,37,39,42" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>=</mo><mn>27</mn></mrow><mo>,</mo><mn>30</mn><mo>,</mo><mn>32</mn><mo>,</mo><mn>33</mn><mo>,</mo><mn>36</mn><mo>,</mo><mn>37</mn><mo>,</mo><mn>39</mn><mo>,</mo><mn>42</mn></mrow><annotation encoding="application/x-tex">k=27,30,32,33,36,37,39,42</annotation></semantics></math>.</p>
