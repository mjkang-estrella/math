/mo></mrow></mfrac><mo>)</mo></mrow><mn>2</mn></msup><mo>≥</mo><mrow><mrow><mo>(</mo><mfrac><msubsup><mi class="ltx_font_mathscript">𝒬</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></msubsup><mrow><mo>(</mo><mfrac linethickness="0pt"><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mfrac><mo>)</mo></mrow></mfrac><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac><msubsup><mi class="ltx_font_mathscript">𝒬</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></msubsup><mrow><mo>(</mo><mfrac linethickness="0pt"><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mfrac><mo>)</mo></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}&amp;\left(\frac{\mathscr{P}_{n,k}^{n-j}}{\binom{n-3}{k}}\right)^{2}\geq\left(\frac{\mathscr{P}_{n,k-1}^{n-j}}{\binom{n-3}{k-1}}\right)\left(\frac{\mathscr{P}_{n,k+1}^{n-j}}{\binom{n-3}{k+1}}\right)~\text{ and}\\
