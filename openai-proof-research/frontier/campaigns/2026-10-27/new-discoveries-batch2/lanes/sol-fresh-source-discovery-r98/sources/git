<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E7.m1" class="ltx_math_unparsed" alttext="\mathscr{S}_{X^{n}}(m,1)=\Big(\kern-3.00003pt\Big(\genfrac{}{}{0.0pt}{}{Nm}{n}\Big)\kern-3.00003pt\Big)=\frac{1}{n!}Nm(Nm+1)\cdots(Nm+n-1)," display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msup><mi>X</mi><mi>n</mi></msup></msub><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac linethickness="0.0pt"><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mi>n</mi></mfrac><mpadded style="width:0.089em;" width="0.089em"><mo maxsize="1.600em" minsize="1.600em">)</mo></mpadded></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo>=</mo><mfrac><mn>1</mn><mrow><mi>n</mi><mo>!</mo></mrow></mfrac><mi>N</mi><mi>m</mi><mrow><mo stretchy="false">(</mo><mi>N</mi><mi>m</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">⋯</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mi>m</mi><mo>+</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathscr{S}_{X^{n}}(m,1)=\Big(\kern-3.00003pt\Big(\genfrac{}{}{0.0pt}{}{Nm}{n}\Big)\kern-3.00003pt\Big)=\frac{1}{n!}Nm(Nm+1)\cdots(Nm+n-1),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.I3.i2.p1.2" class="ltx_p"><span id="S4.I3.i2.p1.2.1" class="ltx_text ltx_font_italic">where </span><math id="S4.I3.i2.p1.m2" class="ltx_Math" alttext="N=\sum_{k=0}^{d}b_{k}" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>d</mi></msubsup><msub><mi>b</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">N=\sum_{k=0}^{d}b_{k}</annotation></semantics></math><span id="S4.I3.i2.p1.2.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S4.I3.i3.p1" class="ltx_para">
<p id="S4.I3.i3.p1.1" class="ltx_p"><span id="S4.I3.i3.p1.1.1" class="ltx_text ltx_font_italic">When evaluated at </span><math id="S4.I3.i3.p1.m1" class="ltx_Math" alttext="m=1" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">m=1</annotation></semantics></math><span id="S4.I3.i3.p1.1.2" class="ltx_text ltx_font_italic">, we have</span></p>
<table id="S4.E8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(4.8)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E8.m1" class="ltx_math_unparsed" alttext="\mathscr{S}_{X^{n}}(1,t)=\sum_{n_{0}+\cdots+n_{d}=n}\left(\kern-3.00003pt\left(\genfrac{}{}{0.0pt}{}{b_0}{n_0}\right)\kern-3.00003pt\right)\cdots\left(\kern-3.00003pt\left(\genfrac{}{}{0.0pt}{}{b_d}{n_d}\right)\kern-3.00003pt\right)t^{1\cdot n_{1}+\cdots+d\cdot n_{d}}." display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msup><mi>X</mi><mi>n</mi></msup></msub><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">=</mo><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mrow><msub><mi>n</mi><mn>0</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>n</mi><mi>d</mi></msub></mrow><mo>=</mo><mi>n</mi></mrow></munder><mrow><mo>(</mo><mrow><mo>(</mo><mfrac linethickness="0.0pt"><msub><mi>b</mi><mn>0</mn></msub><msub><mi>n</mi><mn>0</mn></msub></mfrac><mpadded style="width:0.089em;" width="0.089em"><mo>)</mo></mpadded></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">⋯</mo><mrow><mo>(</mo><mrow><mo>(</mo><mfrac linethickness="0.0pt"><msub><mi>b</mi><mi>d</mi></msub><msub><mi>n</mi><mi>d</mi></msub></mfrac><mpadded style="width:0.089em;" width="0.089em"><mo>)</mo></mpadded></mrow><mo>)</mo></mrow><msup><mi>t</mi><mrow><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>n</mi><mn>1</mn></msub></mrow><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>n</mi><mi>d</mi></msub></mrow></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathscr{S}_{X^{n}}(1,t)=\sum_{n_{0}+\cdots+n_{d}=n}\left(\kern-3.00003pt\left(\genfrac{}{}{0.0pt}{}{b_0}{n_0}\right)\kern-3.00003pt\right)\cdots\left(\kern-3.00003pt\left(\genfrac{}{}{0.0pt}{}{b_d}{n_d}\right)\kern-3.00003pt\right)t^{1\cdot n_{1}+\cdots+d\cdot n_{d}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S4.I3.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S4.I3.i4.p1" class="ltx_para">
<p id="S4.I3.i4.p1.1" class="ltx_p"><span id="S4.I3.i4.p1.1.1" class="ltx_text ltx_font_italic">As an element of </span><math id="S4.I3.i4.p1.m1" class="ltx_Math" alttext="\mathbb{Q}[t][m]" display="inline" intent=":literal"><semantics><mrow><mi>ℚ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{Q}[t][m]</annotation></semantics></math><span id="S4.I3.i4.p1.1.2" class="ltx_text ltx_font_italic">, </span><math id="S4.I3.i4.p1.m2" class="ltx_Math" alttext="\mathscr{S}_{X^{n}}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msup><mi>X</mi><mi>n</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}_{X^{n}}(m,t)</annotation></semantics></math><span id="S4.I3.i4.p1.1.3" class="ltx_text ltx_font_italic"> is written as</span></p>
<table id="S4.E9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(4.9)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E9.m1" class="ltx_Math" alttext="\mathscr{S}_{X^{n}}(m,t)=\sum_{\lambda\vdash n}z_{\lambda}^{-1}p_{X}^{[\lambda]}m^{\ell(\lambda)}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msup><mi>X</mi><mi>n</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>λ</mi><mo>⊢</mo><mi>n</mi></mrow></munder><mrow><msubsup><mi>z</mi><mi>λ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>p</mi><mi>X</mi><mrow><mo stretchy="false">[</mo><mi>λ</mi><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>m</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}_{X^{n}}(m,t)=\sum_{\lambda\vdash n}z_{\lambda}^{-1}p_{X}^{[\lambda]}m^{\ell(\lambda)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.I3.i4.p1.2" class="ltx_p"><span id="S4.I3.i4.p1.2.1" class="ltx_text ltx_font_italic">where </span><math id="S4.I3.i4.p1.m3" class="ltx_Math" alttext="p_{X}^{[\lambda]}=\prod_{i=1}^{\ell(\lambda)}p_{X}(t^{\lambda_{i}})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>p</mi><mi>X</mi><mrow><mo stretchy="false">[</mo><mi>λ</mi><mo stretchy="false">]</mo></mrow></msubsup><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mrow><msub><mi>p</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>t</mi><msub><mi>λ</mi><mi>i</mi></msub></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">p_{X}^{[\lambda]}=\prod_{i=1}^{\ell(\lambda)}p_{X}(t^{\lambda_{i}})</annotation></semantics></math><span id="S4.I3.i4.p1.2.2" class="ltx_text ltx_font_italic"> for a partition </span><math id="S4.I3.i4.p1.m4" class="ltx_Math" alttext="\lambda=(\lambda_{1},\ldots,\lambda_{\ell(\lambda)})" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda=(\lambda_{1},\ldots,\lambda_{\ell(\lambda)})</annotation></semantics></math><span id="S4.I3.i4.p1.2.3" class="ltx_text ltx_font_italic"> of </span><math id="S4.I3.i4.p1.m5" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math><span id="S4.I3.i4.p1.2.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S4.SS1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS1.p6" class="ltx_para">
<p id="S4.SS1.p6.1" class="ltx_p"><span id="S4.SS1.p6.1.1" class="ltx_text">(1), (2) and (3) are immediate from (<a href="#S4.E4" title="In Theorem 4.2. ‣ 4.1. 𝑛-fold products ‣ 4. Characteristic polynomials of varieties and log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.4</span></a>) by reading the coefficient of <math id="S4.SS1.p6.m1" class="ltx_Math" alttext="q^{n}" display="inline" intent=":literal"><semantics><msup><mi>q</mi><mi>n</mi></msup><annotation encoding="application/x-tex">q^{n}</annotation></semantics></math>.
For (4), observe that from (<a href="#S4.E5" title="In Proof. ‣ 4.1. 𝑛-fold products ‣ 4. Characteristic polynomials of varieties and log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.5</span></a>),</span></p>
<table id="S4.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex6.m1" class="ltx_Math" alttext="\sum_{k\geq 0}\mathrm{ch}_{\mathbb{S}_{n}}H^{2k}(X^{n})t^{k}=\mathsf{h}_{n}\circ(p_{X}\mathsf{h}_{1})=\sum_{\lambda\vdash n}z_{\lambda}^{-1}\mathsf{p}_{\lambda}\circ(p_{X}\mathsf{h}_{1})=\sum_{\lambda\vdash n}z_{\lambda}^{-1}p_{X}^{[\lambda]}\mathsf{p}_{\lambda}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>≥</mo><mn>0</mn></mrow></munder><mrow><msub><mi>ch</mi><msub><mi>𝕊</mi><mi>n</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mi>k</mi></msup></mrow></mrow><mo>=</mo><mrow><msub><mi>𝗁</mi><mi>n</mi></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>p</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝗁</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>λ</mi><mo>⊢</mo><mi>n</mi></mrow></munder><mrow><msubsup><mi>z</mi><mi>λ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝗉</mi><mi>λ</mi></msub></mrow></mrow><mo lspace="0.222em" rspace="0.222em">∘</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>p</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝗁</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>λ</mi><mo>⊢</mo><mi>n</mi></mrow></munder><mrow><msubsup><mi>z</mi><mi>λ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>p</mi><mi>X</mi><mrow><mo stretchy="false">[</mo><mi>λ</mi><mo stretchy="false">]</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝗉</mi><mi>λ</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{k\geq 0}\mathrm{ch}_{\mathbb{S}_{n}}H^{2k}(X^{n})t^{k}=\mathsf{h}_{n}\circ(p_{X}\mathsf{h}_{1})=\sum_{\lambda\vdash n}z_{\lambda}^{-1}\mathsf{p}_{\lambda}\circ(p_{X}\mathsf{h}_{1})=\sum_{\lambda\vdash n}z_{\lambda}^{-1}p_{X}^{[\lambda]}\mathsf{p}_{\lambda}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p6.2" class="ltx_p"><span id="S4.SS1.p6.2.1" class="ltx_text">Applying <math id="S4.SS1.p6.m2" class="ltx_Math" alttext="\mathscr{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">𝒮</mi><annotation encoding="application/x-tex">\mathscr{S}</annotation></semantics></math> to this, (<a href="#S4.E9" title="In item 4 ‣ Corollary 4.3. ‣ 4.1. 𝑛-fold products ‣ 4. Characteristic polynomials of varieties and log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.9</span></a>) follows.
∎</span></p>
</div>
</div>
<div id="S4.SS1.p7" class="ltx_para">
<p id="S4.SS1.p7.1" class="ltx_p">By Corollary <a href="#S4.Thmtheorem3" title="Corollary 4.3. ‣ 4.1. 𝑛-fold products ‣ 4. Characteristic polynomials of varieties and log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a>, we obtain the following straightforward log-concavity results.</p>
</div>
<div id="S4.Thmtheorem4" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem4.2" class="ltx_text ltx_font_bold">Corollary 4.4</span></span><span id="S4.Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem4.p1" class="ltx_para">
<ol id="S4.I4" class="ltx_enumerate">
<li id="S4.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I4.i1.p1" class="ltx_para">
<p id="S4.I4.i1.p1.1" class="ltx_p"><math id="S4.I4.i1.p1.m1" class="ltx_Math" alttext="\mathscr{S}_{X^{n}}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msup><mi>X</mi><mi>n</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}_{X^{n}}(m,t)</annotation></semantics></math><span id="S4.I4.i1.p1.1.1" class="ltx_text ltx_font_italic"> is length log-concave at </span><math id="S4.I4.i1.p1.m2" class="ltx_Math" alttext="t=1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=1</annotation></semantics></math><span id="S4.I4.i1.p1.1.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I4.i2.p1" class="ltx_para">
<p id="S4.I4.i2.p1.1" class="ltx_p"><math id="S4.I4.i2.p1.m1" class="ltx_Math" alttext="\mathscr{S}_{X^{n}}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msup><mi>X</mi><mi>n</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}_{X^{n}}(m,t)</annotation></semantics></math><span id="S4.I4.i2.p1.1.1" class="ltx_text ltx_font_italic"> is degree log-concave in length </span><math id="S4.I4.i2.p1.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math><span id="S4.I4.i2.p1.1.2" class="ltx_text ltx_font_italic">, provided that </span><math id="S4.I4.i2.p1.m3" class="ltx_Math" alttext="p_{X}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>X</mi></msub><annotation encoding="application/x-tex">p_{X}</annotation></semantics></math><span id="S4.I4.i2.p1.1.3" class="ltx_text ltx_font_italic"> is log-concave with no internal zeros.</span></p>
</div></li>
<li id="S4.I4.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S4.I4.i3.p1" class="ltx_para">
<p id="S4.I4.i3.p1.1" class="ltx_p"><span id="S4.I4.i3.p1.1.1" class="ltx_text ltx_font_italic">The coefficient of </span><math id="S4.I4.i3.p1.m1" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math><span id="S4.I4.i3.p1.1.2" class="ltx_text ltx_font_italic"> in </span><math id="S4.I4.i3.p1.m2" class="ltx_Math" alttext="\mathscr{S}_{X^{n}}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msup><mi>X</mi><mi>n</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}_{X^{n}}(m,t)</annotation></semantics></math><span id="S4.I4.i3.p1.1.3" class="ltx_text ltx_font_italic"> has internal zeros whenever </span><math id="S4.I4.i3.p1.m3" class="ltx_Math" alttext="n&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n&gt;1</annotation></semantics></math><span id="S4.I4.i3.p1.1.4" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S4.SS1.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS1.p8" class="ltx_para">
<p id="S4.SS1.p8.1" class="ltx_p"><span id="S4.SS1.p8.1.1" class="ltx_text">(1) follows from (<a href="#S4.E7" title="In item 2 ‣ Corollary 4.3. ‣ 4.1. 𝑛-fold products ‣ 4. Characteristic polynomials of varieties and log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.7</span></a>) and Lemma <a href="#S2.Thmtheorem5" title="Lemma 2.5. ‣ 2. Two-dimensional log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.5</span></a>. For (2), by (<a href="#S4.E9" title="In item 4 ‣ Corollary 4.3. ‣ 4.1. 𝑛-fold products ‣ 4. Characteristic polynomials of varieties and log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.9</span></a>), the coefficient of <math id="S4.SS1.p8.m1" class="ltx_Math" alttext="m^{n}" display="inline" intent=":literal"><semantics><msup><mi>m</mi><mi>n</mi></msup><annotation encoding="application/x-tex">m^{n}</annotation></semantics></math> in <math id="S4.SS1.p8.m2" class="ltx_Math" alttext="\mathscr{S}_{X^{n}}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msup><mi>X</mi><mi>n</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}_{X^{n}}(m,t)</annotation></semantics></math> is <math id="S4.SS1.p8.m3" class="ltx_Math" alttext="\frac{1}{n!}(p_{X}(t))^{n}" display="inline" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><mrow><mi>n</mi><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>p</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">\frac{1}{n!}(p_{X}(t))^{n}</annotation></semantics></math>. This is log-concave with no internal zeroes when <math id="S4.SS1.p8.m4" class="ltx_Math" alttext="p_{X}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>X</mi></msub><annotation encoding="application/x-tex">p_{X}</annotation></semantics></math> is.
For (3), by (<a href="#S4.E9" title="In item 4 ‣ Corollary 4.3. ‣ 4.1. 𝑛-fold products ‣ 4. Characteristic polynomials of varieties and log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.9</span></a>), the coefficient of <math id="S4.SS1.p8.m5" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> in <math id="S4.SS1.p8.m6" class="ltx_Math" alttext="\mathscr{S}_{X^{n}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">𝒮</mi><msup><mi>X</mi><mi>n</mi></msup></msub><annotation encoding="application/x-tex">\mathscr{S}_{X^{n}}</annotation></semantics></math> is <math id="S4.SS1.p8.m7" class="ltx_Math" alttext="\frac{1}{n}p_{X}(t^{n})=\frac{1}{n}\sum_{i=0}^{d}b_{i}t^{ni}" display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>t</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>d</mi></msubsup><mrow><msub><mi>b</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{1}{n}p_{X}(t^{n})=\frac{1}{n}\sum_{i=0}^{d}b_{i}t^{ni}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S4.SS1.p9" class="ltx_para">
<p id="S4.SS1.p9.1" class="ltx_p">Note that there are examples of <math id="S4.SS1.p9.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> with non-log-concave Poincaré polynomial. For example, when <math id="S4.SS1.p9.m2" class="ltx_Math" alttext="X=\mathrm{Gr}(2,4)" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>=</mo><mrow><mi>Gr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X=\mathrm{Gr}(2,4)</annotation></semantics></math>, <math id="S4.SS1.p9.m3" class="ltx_Math" alttext="p_{X}(t)=1+t+2t^{2}+t^{3}+t^{4}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>p</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mn>2</mn></msup></mrow><mo>+</mo><msup><mi>t</mi><mn>3</mn></msup><mo>+</mo><msup><mi>t</mi><mn>4</mn></msup></mrow></mrow><annotation encoding="application/x-tex">p_{X}(t)=1+t+2t^{2}+t^{3}+t^{4}</annotation></semantics></math> is not log-concave.</p>
</div>
<div id="S4.Thmtheorem5" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem5.2" class="ltx_text ltx_font_bold">Example 4.5</span></span><span id="S4.Thmtheorem5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem5.p1" class="ltx_para">
<p id="S4.Thmtheorem5.p1.1" class="ltx_p">When <math id="S4.Thmtheorem5.p1.m1" class="ltx_Math" alttext="X=\mathbb{P}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>=</mo><msup><mi>ℙ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">X=\mathbb{P}^{d}</annotation></semantics></math>, (<a href="#S4.E8" title="In item 3 ‣ Corollary 4.3. ‣ 4.1. 𝑛-fold products ‣ 4. Characteristic polynomials of varieties and log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.8</span></a>) reads</p>
<table id="S4.E10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(4.10)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E10.m1" class="ltx_Math" alttext="\begin{split}\mathscr{S}_{X^{n}}(1,t)&amp;=\sum_{\begin{subarray}{c}n_{0}+\cdots+n_{d}=n\end{subarray}}t^{1\cdot n_{1}+\cdots+d\cdot n_{d}}=\sum_{\begin{subarray}{c}\lambda\in\mathrm{Par},\\
\ell(\lambda)\leq n,\lambda_{1}\leq d\end{subarray}}t^{\lvert\lambda\rvert}={n+d\brack n}_{t}\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msup><mi>X</mi><mi>n</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mtable><mtr><mtd><mrow><mrow><msub><mi>n</mi><mn>0</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>n</mi><mi>d</mi></msub></mrow><mo>=</mo><mi>n</mi></mrow></mtd></mtr></mtable></munder><msup><mi>t</mi><mrow><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>n</mi><mn>1</mn></msub></mrow><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>n</mi><mi>d</mi></msub></mrow></mrow></msup></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mrow><mi>λ</mi><mo>∈</mo><mi>Par</mi></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>n</mi></mrow><mo>,</mo><mrow><msub><mi>λ</mi><mn>1</mn></msub><mo>≤</mo><mi>d</mi></mrow></mrow></mtd></mtr></mtable></munder><msup><mi>t</mi><mrow><mo stretchy="false">|</mo><mi>λ</mi><mo stretchy="false">|</mo></mrow></msup></mrow><mo>=</mo><msub><mrow><mo>[</mo><mfrac linethickness="0pt"><mrow><mi>n</mi><mo>+</mo><mi>d</mi></mrow><mi>n</mi></mfrac><mo>]</mo></mrow><mi>t</mi></msub></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\mathscr{S}_{X^{n}}(1,t)&amp;=\sum_{\begin{subarray}{c}n_{0}+\cdots+n_{d}=n\end{subarray}}t^{1\cdot n_{1}+\cdots+d\cdot n_{d}}=\sum_{\begin{subarray}{c}\lambda\in\mathrm{Par},\\
\ell(\lambda)\leq n,\lambda_{1}\leq d\end{subarray}}t^{\lvert\lambda\rvert}={n+d\brack n}_{t}\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmtheorem5.p1.2" class="ltx_p">where <math id="S4.Thmtheorem5.p1.m2" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> runs over all the partitions with length at most <math id="S4.Thmtheorem5.p1.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> and all parts at most <math id="S4.Thmtheorem5.p1.m4" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> and
for <math id="S4.Thmtheorem5.p1.m5" class="ltx_Math" alttext="a\geq b\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>≥</mo><mi>b</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a\geq b\geq 0</annotation></semantics></math>,</p>
<table id="S4.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex7.m1" class="ltx_Math" alttext="{a\brack b}_{t}:=\frac{[a]_{t}!}{[a-b]_{t}![b]_{t}!}~\in\mathbb{Z}[t]" display="block" intent=":literal"><semantics><mrow><msub><mrow><mo>[</mo><mfrac linethickness="0pt"><mi>a</mi><mi>b</mi></mfrac><mo>]</mo></mrow><mi>t</mi></msub><mo>:=</mo><mfrac><mrow><msub><mrow><mo stretchy="false">[</mo><mi>a</mi><mo stretchy="false">]</mo></mrow><mi>t</mi></msub><mo>!</mo></mrow><mrow><mrow><mrow><msub><mrow><mo stretchy="false">[</mo><mrow><mi>a</mi><mo>−</mo><mi>b</mi></mrow><mo stretchy="false">]</mo></mrow><mi>t</mi></msub><mo>!</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">[</mo><mi>b</mi><mo stretchy="false">]</mo></mrow><mi>t</mi></msub></mrow><mo>!</mo></mrow></mfrac><mo lspace="0.608em">∈</mo><mrow><mi>ℤ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{a\brack b}_{t}:=\frac{[a]_{t}!}{[a-b]_{t}![b]_{t}!}~\in\mathbb{Z}[t]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmtheorem5.p1.3" class="ltx_p">with <math id="S4.Thmtheorem5.p1.m6" class="ltx_Math" alttext="[a]_{t}!=\prod_{i=1}^{a}[i]_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">[</mo><mi>a</mi><mo stretchy="false">]</mo></mrow><mi>t</mi></msub><mo>!</mo></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo rspace="0em">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>a</mi></msubsup><msub><mrow><mo stretchy="false">[</mo><mi>i</mi><mo stretchy="false">]</mo></mrow><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">[a]_{t}!=\prod_{i=1}^{a}[i]_{t}</annotation></semantics></math> and <math id="S4.Thmtheorem5.p1.m7" class="ltx_Math" alttext="[a]_{t}=\sum_{i=0}^{a-1}t^{i}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">[</mo><mi>a</mi><mo stretchy="false">]</mo></mrow><mi>t</mi></msub><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>a</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msup><mi>t</mi><mi>i</mi></msup></mrow></mrow><annotation encoding="application/x-tex">[a]_{t}=\sum_{i=0}^{a-1}t^{i}</annotation></semantics></math> for all <math id="S4.Thmtheorem5.p1.m8" class="ltx_Math" alttext="a\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a\geq 0</annotation></semantics></math>.
The second equality in (<a href="#S4.E10" title="In Example 4.5. ‣ 4.1. 𝑛-fold products ‣ 4. Characteristic polynomials of varieties and log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.10</span></a>) holds by identifying the <math id="S4.Thmtheorem5.p1.m9" class="ltx_Math" alttext="(d+1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(d+1)</annotation></semantics></math>-tuple <math id="S4.Thmtheorem5.p1.m10" class="ltx_Math" alttext="(n_{0},\cdots,n_{d})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>n</mi><mn>0</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>n</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n_{0},\cdots,n_{d})</annotation></semantics></math> with the partition <math id="S4.Thmtheorem5.p1.m11" class="ltx_math_unparsed" alttext="\lambda=1^{n_{1}}\cdots d^{n_{d}}" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><mn>1</mn><msup><mrow></mrow><msub><mi>n</mi><mn>1</mn></msub></msup><mo lspace="0em" rspace="0em">⋯</mo><mi>d</mi><msup><mrow></mrow><msub><mi>n</mi><mi>d</mi></msub></msup></mrow><annotation encoding="application/x-tex">\lambda=1^{n_{1}}\cdots d^{n_{d}}</annotation></semantics></math> and the last equality
holds by <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib27" title="" class="ltx_ref">27</a>, Proposition 1.7.3]</cite>.</p>
</div>
<div id="S4.Thmtheorem5.p2" class="ltx_para">
<p id="S4.Thmtheorem5.p2.1" class="ltx_p">Unlike the case of <math id="S4.Thmtheorem5.p2.m1" class="ltx_Math" alttext="X=\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>=</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">X=\mathbb{P}^{1}</annotation></semantics></math>, this is not log-concave in general. For example, when <math id="S4.Thmtheorem5.p2.m2" class="ltx_Math" alttext="n=d=2" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mi>d</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">n=d=2</annotation></semantics></math>, one gets <math id="S4.Thmtheorem5.p2.m3" class="ltx_Math" alttext="\mathscr{S}_{(\mathbb{P}^{2})^{2}}(1,t)={4\brack 2}_{t}=1+t+2t^{2}+t^{3}+t^{4}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msup><mrow><mo stretchy="false">(</mo><msup><mi>ℙ</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mrow><mo>[</mo><mfrac linethickness="0pt"><mn>4</mn><mn>2</mn></mfrac><mo>]</mo></mrow><mi>t</mi></msub><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mn>2</mn></msup></mrow><mo>+</mo><msup><mi>t</mi><mn>3</mn></msup><mo>+</mo><msup><mi>t</mi><mn>4</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}_{(\mathbb{P}^{2})^{2}}(1,t)={4\brack 2}_{t}=1+t+2t^{2}+t^{3}+t^{4}</annotation></semantics></math>. In other words, <math id="S4.Thmtheorem5.p2.m4" class="ltx_Math" alttext="\mathscr{S}_{X^{n}}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msup><mi>X</mi><mi>n</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}_{X^{n}}(m,t)</annotation></semantics></math> is not degree log-concave at <math id="S4.Thmtheorem5.p2.m5" class="ltx_Math" alttext="m=1" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">m=1</annotation></semantics></math> in general.</p>
</div>
</div>
<div id="S4.SS1.p10" class="ltx_para">
<p id="S4.SS1.p10.1" class="ltx_p">Recall that when <math id="S4.SS1.p10.m1" class="ltx_Math" alttext="X=\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>=</mo><msup><mi>ℙ</mi><mn>1</mn></msup></mrow><annotation encoding="application/x-tex">X=\mathbb{P}^{1}</annotation></semantics></math>, we verified in Example <a href="#S4.Thmtheorem1" title="Example 4.1. ‣ 4.1. 𝑛-fold products ‣ 4. Characteristic polynomials of varieties and log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a> that <math id="S4.SS1.p10.m2" class="ltx_Math" alttext="\mathscr{S}_{X^{n}}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msup><mi>X</mi><mi>n</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}_{X^{n}}(m,t)</annotation></semantics></math>
is degree log-concave in length <math id="S4.SS1.p10.m3" class="ltx_Math" alttext="\lceil\mathrm{log}_{2}(n\mathrm{log}_{2}n)\rceil\leq\ell\leq n" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">⌈</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>log</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⌉</mo></mrow><mo>≤</mo><mi mathvariant="normal">ℓ</mi><mo>≤</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">\lceil\mathrm{log}_{2}(n\mathrm{log}_{2}n)\rceil\leq\ell\leq n</annotation></semantics></math> for <math id="S4.SS1.p10.m4" class="ltx_Math" alttext="n\leq 200" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≤</mo><mn>200</mn></mrow><annotation encoding="application/x-tex">n\leq 200</annotation></semantics></math>, while it fails to be degree log-concave in smaller lengths. Our goal is to investigate the degree log-concavity of <math id="S4.SS1.p10.m5" class="ltx_Math" alttext="\mathscr{S}_{X^{n}}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msup><mi>X</mi><mi>n</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}_{X^{n}}(m,t)</annotation></semantics></math> in sufficiently large length. Additionally, we aim to examine the length log-concavity of <math id="S4.SS1.p10.m6" class="ltx_Math" alttext="\mathscr{S}_{X^{n}}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msup><mi>X</mi><mi>n</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}_{X^{n}}(m,t)</annotation></semantics></math> at a given degree.</p>
</div>
<div id="S4.Thmtheorem6" class="ltx_theorem ltx_theorem_question">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem6.2" class="ltx_text ltx_font_bold">Question 4.6</span></span><span id="S4.Thmtheorem6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem6.p1" class="ltx_para">
<p id="S4.Thmtheorem6.p1.1" class="ltx_p">Let <math id="S4.Thmtheorem6.p1.m1" class="ltx_Math" alttext="\mathscr{S}_{X^{n},k}^{\ell}\in\mathbb{Q}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathscript">𝒮</mi><mrow><msup><mi>X</mi><mi>n</mi></msup><mo>,</mo><mi>k</mi></mrow><mi mathvariant="normal">ℓ</mi></msubsup><mo>∈</mo><mi>ℚ</mi></mrow><annotation encoding="application/x-tex">\mathscr{S}_{X^{n},k}^{\ell}\in\mathbb{Q}</annotation></semantics></math> denote the coefficient of <math id="S4.Thmtheorem6.p1.m2" class="ltx_Math" alttext="m^{\ell}t^{k}" display="inline" intent=":literal"><semantics><mrow><msup><mi>m</mi><mi mathvariant="normal">ℓ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mi>k</mi></msup></mrow><annotation encoding="application/x-tex">m^{\ell}t^{k}</annotation></semantics></math> in <math id="S4.Thmtheorem6.p1.m3" class="ltx_Math" alttext="\mathscr{S}_{X^{n}}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msup><mi>X</mi><mi>n</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}_{X^{n}}(m,t)</annotation></semantics></math> for each <math id="S4.Thmtheorem6.p1.m4" class="ltx_Math" alttext="\ell,k" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>,</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">\ell,k</annotation></semantics></math>.</p>
</div>
<div id="S4.Thmtheorem6.p2" class="ltx_para">
<p id="S4.Thmtheorem6.p2.1" class="ltx_p">(1) Is it true that</p>
<table id="S4.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex8.m1" class="ltx_Math" alttext="(\mathscr{S}_{X^{n},k}^{\ell})^{2}\geq\mathscr{S}_{X^{n},k}^{\ell+1}\cdot\mathscr{S}_{X^{n},k}^{\ell-1}\quad\text{ for any $\ell,k$}?" display="block" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathscript">𝒮</mi><mrow><msup><mi>X</mi><mi>n</mi></msup><mo>,</mo><mi>k</mi></mrow><mi mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>≥</mo><mrow><msubsup><mi class="ltx_font_mathscript">𝒮</mi><mrow><msup><mi>X</mi><mi>n</mi></msup><mo>,</mo><mi>k</mi></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi class="ltx_font_mathscript">𝒮</mi><mrow><msup><mi>X</mi><mi>n</mi></msup><mo>,</mo><mi>k</mi></mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mtext> for any </mtext><mrow><mi mathvariant="normal">ℓ</mi><mo>,</mo><mi>k</mi></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>?</mi></mrow></mrow><annotation encoding="application/x-tex">(\mathscr{S}_{X^{n},k}^{\ell})^{2}\geq\mathscr{S}_{X^{n},k}^{\ell+1}\cdot\mathscr{S}_{X^{n},k}^{\ell-1}\quad\text{ for any $\ell,k$}?</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.Thmtheorem6.p3" class="ltx_para">
<p id="S4.Thmtheorem6.p3.1" class="ltx_p">(2) Assume that <math id="S4.Thmtheorem6.p3.m1" class="ltx_Math" alttext="p_{X}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>X</mi></msub><annotation encoding="application/x-tex">p_{X}</annotation></semantics></math> is log-concave with no internal zeros. Is there a lower bound for <math id="S4.Thmtheorem6.p3.m2" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> as a function of <math id="S4.Thmtheorem6.p3.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> such that</p>
<table id="S4.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex9.m1" class="ltx_Math" alttext="(\mathscr{S}_{X^{n},k}^{\ell})^{2}\geq\mathscr{S}_{X^{n},k+1}^{\ell}\cdot\mathscr{S}_{X^{n},k-1}^{\ell}" display="block" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathscript">𝒮</mi><mrow><msup><mi>X</mi><mi>n</mi></msup><mo>,</mo><mi>k</mi></mrow><mi mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>≥</mo><mrow><msubsup><mi class="ltx_font_mathscript">𝒮</mi><mrow><msup><mi>X</mi><mi>n</mi></msup><mo>,</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow><mi mathvariant="normal">ℓ</mi></msubsup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi class="ltx_font_mathscript">𝒮</mi><mrow><msup><mi>X</mi><mi>n</mi></msup><mo>,</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow><mi mathvariant="normal">ℓ</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">(\mathscr{S}_{X^{n},k}^{\ell})^{2}\geq\mathscr{S}_{X^{n},k+1}^{\ell}\cdot\mathscr{S}_{X^{n},k-1}^{\ell}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmtheorem6.p3.2" class="ltx_p">holds for all <math id="S4.Thmtheorem6.p3.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>?</p>
</div>
</div>
<div id="S4.SS1.p11" class="ltx_para">
<p id="S4.SS1.p11.1" class="ltx_p">Here we give a partial asymptotic answer to these questions. Indeed, both inequalities hold when <math id="S4.SS1.p11.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> is sufficiently small and <math id="S4.SS1.p11.m2" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> is sufficiently large with respect to <math id="S4.SS1.p11.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>.</p>
</div>
<div id="S4.Thmtheorem7" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem7.2" class="ltx_text ltx_font_bold">Proposition 4.7</span></span><span id="S4.Thmtheorem7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem7.p1" class="ltx_para">
<p id="S4.Thmtheorem7.p1.1" class="ltx_p"><span id="S4.Thmtheorem7.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmtheorem7.p1.m1" class="ltx_Math" alttext="j,k\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>,</mo><mi>k</mi></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">j,k\geq 0</annotation></semantics></math>. The coefficient of <math id="S4.Thmtheorem7.p1.m2" class="ltx_Math" alttext="m^{n-j}t^{k}" display="inline" intent=":literal"><semantics><mrow><msup><mi>m</mi><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mi>k</mi></msup></mrow><annotation encoding="application/x-tex">m^{n-j}t^{k}</annotation></semantics></math> in <math id="S4.Thmtheorem7.p1.m3" class="ltx_Math" alttext="\mathscr{S}_{X^{n}}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msup><mi>X</mi><mi>n</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}_{X^{n}}(m,t)</annotation></semantics></math> is</span></p>
<table id="S4.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex10.m1" class="ltx_Math" alttext="\mathscr{S}_{X^{n},k}^{n-j}=\frac{b_{0}^{n-k-j}b_{1}^{k}}{2^{j}j!k!}\cdot\frac{n^{2j+k}}{n!}+o\Big(\frac{n^{2j+k}}{n!}\Big)." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathscript">𝒮</mi><mrow><msup><mi>X</mi><mi>n</mi></msup><mo>,</mo><mi>k</mi></mrow><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></msubsup><mo>=</mo><mrow><mrow><mfrac><mrow><msubsup><mi>b</mi><mn>0</mn><mrow><mi>n</mi><mo>−</mo><mi>k</mi><mo>−</mo><mi>j</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>b</mi><mn>1</mn><mi>k</mi></msubsup></mrow><mrow><mrow><mrow><mrow><msup><mn>2</mn><mi>j</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>!</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>!</mo></mrow></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><msup><mi>n</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>+</mo><mi>k</mi></mrow></msup><mrow><mi>n</mi><mo>!</mo></mrow></mfrac></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac><msup><mi>n</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>+</mo><mi>k</mi></mrow></msup><mrow><mi>n</mi><mo>!</mo></mrow></mfrac><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathscr{S}_{X^{n},k}^{n-j}=\frac{b_{0}^{n-k-j}b_{1}^{k}}{2^{j}j!k!}\cdot\frac{n^{2j+k}}{n!}+o\Big(\frac{n^{2j+k}}{n!}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmtheorem7.p1.2" class="ltx_p"><span id="S4.Thmtheorem7.p1.2.1" class="ltx_text ltx_font_italic">In particular, these coefficients satisfy the log-concavities</span></p>
<table id="S4.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex11.m1" class="ltx_Math" alttext="\begin{split}&amp;\left(\mathscr{S}_{X^{n},k}^{n-j}\right)^{2}\geq\mathscr{S}_{X^{n},k-1}^{n-j}\cdot\mathscr{S}_{X^{n},k+1}^{n-j}\left(\mathscr{S}_{X^{n},k}^{n-j}\right)^{2}\geq\mathscr{S}_{X^{n},k}^{n-j-1}\cdot\mathscr{S}_{X^{n},k}^{n-j+1}\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><msup><mrow><mo>(</mo><msubsup><mi class="ltx_font_mathscript">𝒮</mi><mrow><msup><mi>X</mi><mi>n</mi></msup><mo>,</mo><mi>k</mi></mrow><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></msubsup><mo>)</mo></mrow><mn>2</mn></msup><mo>≥</mo><mrow><mrow><msubsup><mi class="ltx_font_mathscript">𝒮</mi><mrow><msup><mi>X</mi><mi>n</mi></msup><mo>,</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi class="ltx_font_mathscript">𝒮</mi><mrow><msup><mi>X</mi><mi>n</mi></msup><mo>,</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><msubsup><mi class="ltx_font_mathscript">𝒮</mi><mrow><msup><mi>X</mi><mi>n</mi></msup><mo>,</mo><mi>k</mi></mrow><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></msubsup><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo>≥</mo><mrow><msubsup><mi class="ltx_font_mathscript">𝒮</mi><mrow><msup><mi>X</mi><mi>n</mi></msup><mo>,</mo><mi>k</mi></mrow><mrow><mi>n</mi><mo>−</mo><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi class="ltx_font_mathscript">𝒮</mi><mrow><msup><mi>X</mi><mi>n</mi></msup><mo>,</mo><mi>k</mi></mrow><mrow><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow><mo>+</mo><mn>1</mn></mrow></msubsup></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}&amp;\left(\mathscr{S}_{X^{n},k}^{n-j}\right)^{2}\geq\mathscr{S}_{X^{n},k-1}^{n-j}\cdot\mathscr{S}_{X^{n},k+1}^{n-j}\left(\mathscr{S}_{X^{n},k}^{n-j}\right)^{2}\geq\mathscr{S}_{X^{n},k}^{n-j-1}\cdot\mathscr{S}_{X^{n},k}^{n-j+1}\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmtheorem7.p1.3" class="ltx_p"><span id="S4.Thmtheorem7.p1.3.1" class="ltx_text ltx_font_italic">for sufficiently large <math id="S4.Thmtheorem7.p1.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS1.5" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS1.p12" class="ltx_para">
<p id="S4.SS1.p12.1" class="ltx_p"><span id="S4.SS1.p12.1.1" class="ltx_text">Recall that <math id="S4.SS1.p12.m1" class="ltx_Math" alttext="\big(\kern-3.00003pt\big(\genfrac{}{}{0.0pt}{}{m}{n}\big)\kern-3.00003pt\big)=\sum_{j=0}^{n-1}\frac{c(n,n-j)}{n!}m^{n-j}" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mfrac linethickness="0.0pt"><mi>m</mi><mi>n</mi></mfrac><mpadded style="width:0.089em;" width="0.089em"><mo maxsize="1.200em" minsize="1.200em">)</mo></mpadded></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mfrac><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>n</mi><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>m</mi><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\big(\kern-3.00003pt\big(\genfrac{}{}{0.0pt}{}{m}{n}\big)\kern-3.00003pt\big)=\sum_{j=0}^{n-1}\frac{c(n,n-j)}{n!}m^{n-j}</annotation></semantics></math>, where <math id="S4.SS1.p12.m2" class="ltx_Math" alttext="c(n,j)" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">c(n,j)</annotation></semantics></math> is the signless Stirling number of the first kind. It follows from (<a href="#S4.E6" title="In item 1 ‣ Corollary 4.3. ‣ 4.1. 𝑛-fold products ‣ 4. Characteristic polynomials of varieties and log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.6</span></a>) that</span></p>
<table id="S4.E11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(4.11)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E11.m1" class="ltx_Math" alttext="\begin{split}\mathscr{S}_{X^{n},k}^{n-j}&amp;=\sum_{\begin{subarray}{c}j_{0}+\cdots+j_{d}=j,\\
n_{0}+\cdots+n_{d}=n,\\
1\cdot n_{1}+\cdots+d\cdot n_{d}=k\end{subarray}}\prod_{i=0}^{d}\frac{c(n_{i},n_{i}-j_{i})}{n_{i}!}\cdot b_{i}^{n_{i}-j_{i}}.\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true"><mtr><mtd class="ltx_align_right" columnalign="right"><msubsup><mi class="ltx_font_mathscript">𝒮</mi><mrow><msup><mi>X</mi><mi>n</mi></msup><mo>,</mo><mi>k</mi></mrow><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></msubsup></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo rspace="0.111em">=</mo><mrow><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mrow><mrow><msub><mi>j</mi><mn>0</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>j</mi><mi>d</mi></msub></mrow><mo>=</mo><mi>j</mi></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mrow><msub><mi>n</mi><mn>0</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>n</mi><mi>d</mi></msub></mrow><mo>=</mo><mi>n</mi></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>n</mi><mn>1</mn></msub></mrow><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>n</mi><mi>d</mi></msub></mrow></mrow><mo>=</mo><mi>k</mi></mrow></mtd></mtr></mtable></munder><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>d</mi></munderover><mfrac><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>n</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>n</mi><mi>i</mi></msub><mo>−</mo><msub><mi>j</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>n</mi><mi>i</mi></msub><mo>!</mo></mrow></mfrac></mrow></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>b</mi><mi>i</mi><mrow><msub><mi>n</mi><mi>i</mi></msub><mo>−</mo><msub><mi>j</mi><mi>i</mi></msub></mrow></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\mathscr{S}_{X^{n},k}^{n-j}&amp;=\sum_{\begin{subarray}{c}j_{0}+\cdots+j_{d}=j,\\
n_{0}+\cdots+n_{d}=n,\\
1\cdot n_{1}+\cdots+d\cdot n_{d}=k\end{subarray}}\prod_{i=0}^{d}\frac{c(n_{i},n_{i}-j_{i})}{n_{i}!}\cdot b_{i}^{n_{i}-j_{i}}.\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p12.2" class="ltx_p"><span id="S4.SS1.p12.2.1" class="ltx_text">Since <math id="S4.SS1.p12.m3" class="ltx_Math" alttext="j_{0},\cdots,j_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>j</mi><mn>0</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>j</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">j_{0},\cdots,j_{d}</annotation></semantics></math> and <math id="S4.SS1.p12.m4" class="ltx_Math" alttext="n_{1},\cdots,n_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>n</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">n_{1},\cdots,n_{d}</annotation></semantics></math> are bounded by <math id="S4.SS1.p12.m5" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> and <math id="S4.SS1.p12.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> respectively, and it is known that <math id="S4.SS1.p12.m7" class="ltx_Math" alttext="c(n,n-j)=\frac{1}{2^{j}j!}n^{2j}+o(n^{2j})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><mrow><mrow><msup><mn>2</mn><mi>j</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msup></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>n</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">c(n,n-j)=\frac{1}{2^{j}j!}n^{2j}+o(n^{2j})</annotation></semantics></math>,
for any given <math id="S4.SS1.p12.m8" class="ltx_Math" alttext="j\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">j\geq 0</annotation></semantics></math>, one can easily check that the summands in (<a href="#S4.E11" title="In Proof. ‣ 4.1. 𝑛-fold products ‣ 4. Characteristic polynomials of varieties and log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.11</span></a>) are dominated by those with <math id="S4.SS1.p12.m9" class="ltx_Math" alttext="n_{0}" display="inline" intent=":literal"><semantics><msub><mi>n</mi><mn>0</mn></msub><annotation encoding="application/x-tex">n_{0}</annotation></semantics></math> minimal and <math id="S4.SS1.p12.m10" class="ltx_Math" alttext="j_{0}" display="inline" intent=":literal"><semantics><msub><mi>j</mi><mn>0</mn></msub><annotation encoding="application/x-tex">j_{0}</annotation></semantics></math> maximal, namely, those with</span></p>
<table id="S4.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex12.m1" class="ltx_Math" alttext="(n_{0},\cdots,n_{d})=(n-k,k,0,\cdots,0)(j_{0},\cdots,j_{d})=(j,0,\cdots,0)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><msub><mi>n</mi><mn>0</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>n</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mi>k</mi><mo>,</mo><mn>0</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>j</mi><mn>0</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>j</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><mn>0</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(n_{0},\cdots,n_{d})=(n-k,k,0,\cdots,0)(j_{0},\cdots,j_{d})=(j,0,\cdots,0).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p12.3" class="ltx_p"><span id="S4.SS1.p12.3.1" class="ltx_text">Indeed, <math id="S4.SS1.p12.m11" class="ltx_Math" alttext="\frac{c(n_{0},n_{0}-j_{0})}{n_{0}!}=\frac{1}{2^{j_{0}}j_{0}!}\cdot\frac{n_{0}^{2j_{0}}}{n_{0}!}+o(\frac{n_{0}^{2j_{0}}}{n_{0}!})" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>n</mi><mn>0</mn></msub><mo>,</mo><mrow><msub><mi>n</mi><mn>0</mn></msub><mo>−</mo><msub><mi>j</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>n</mi><mn>0</mn></msub><mo>!</mo></mrow></mfrac><mo>=</mo><mrow><mrow><mfrac><mn>1</mn><mrow><mrow><msup><mn>2</mn><msub><mi>j</mi><mn>0</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>j</mi><mn>0</mn></msub></mrow><mo>!</mo></mrow></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><msubsup><mi>n</mi><mn>0</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>j</mi><mn>0</mn></msub></mrow></msubsup><mrow><msub><mi>n</mi><mn>0</mn></msub><mo>!</mo></mrow></mfrac></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mfrac><msubsup><mi>n</mi><mn>0</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>j</mi><mn>0</mn></msub></mrow></msubsup><mrow><msub><mi>n</mi><mn>0</mn></msub><mo>!</mo></mrow></mfrac><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{c(n_{0},n_{0}-j_{0})}{n_{0}!}=\frac{1}{2^{j_{0}}j_{0}!}\cdot\frac{n_{0}^{2j_{0}}}{n_{0}!}+o(\frac{n_{0}^{2j_{0}}}{n_{0}!})</annotation></semantics></math> is maximal if <math id="S4.SS1.p12.m12" class="ltx_Math" alttext="2j_{0}-n_{0}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>j</mi><mn>0</mn></msub></mrow><mo>−</mo><msub><mi>n</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">2j_{0}-n_{0}</annotation></semantics></math> is maximal.
In particular, the coefficient (<a href="#S4.E11" title="In Proof. ‣ 4.1. 𝑛-fold products ‣ 4. Characteristic polynomials of varieties and log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.11</span></a>) is equal to</span></p>
<table id="S4.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex13.m1" class="ltx_Math" alttext="\begin{split}\frac{c(n-k,n-k-j)b_{0}^{n-k-j}}{(n-k)!}\cdot\frac{c(k,k)b_{1}^{k}}{k!}&amp;=\frac{b_{0}^{n-k-j}b_{1}^{k}}{2^{j}j!k!}\cdot\frac{(n-k)^{2j}}{(n-k)!}\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mfrac><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow><mo>,</mo><mrow><mi>n</mi><mo>−</mo><mi>k</mi><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>b</mi><mn>0</mn><mrow><mi>n</mi><mo>−</mo><mi>k</mi><mo>−</mo><mi>j</mi></mrow></msubsup></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>b</mi><mn>1</mn><mi>k</mi></msubsup></mrow><mrow><mi>k</mi><mo>!</mo></mrow></mfrac></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><mfrac><mrow><msubsup><mi>b</mi><mn>0</mn><mrow><mi>n</mi><mo>−</mo><mi>k</mi><mo>−</mo><mi>j</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>b</mi><mn>1</mn><mi>k</mi></msubsup></mrow><mrow><mrow><mrow><mrow><msup><mn>2</mn><mi>j</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>!</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>!</mo></mrow></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msup><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow></mfrac></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\frac{c(n-k,n-k-j)b_{0}^{n-k-j}}{(n-k)!}\cdot\frac{c(k,k)b_{1}^{k}}{k!}&amp;=\frac{b_{0}^{n-k-j}b_{1}^{k}}{2^{j}j!k!}\cdot\frac{(n-k)^{2j}}{(n-k)!}\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p12.4" class="ltx_p"><span id="S4.SS1.p12.4.1" class="ltx_text">modulo <math id="S4.SS1.p12.m13" class="ltx_Math" alttext="o(\frac{n^{2j+k}}{n!})" display="inline" intent=":literal"><semantics><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mfrac><msup><mi>n</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>+</mo><mi>k</mi></mrow></msup><mrow><mi>n</mi><mo>!</mo></mrow></mfrac><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">o(\frac{n^{2j+k}}{n!})</annotation></semantics></math>. The first formula in the proposition now follows from
<math id="S4.SS1.p12.m14" class="ltx_Math" alttext="\frac{(n-k)^{2j}}{(n-k)!}=\frac{n^{2j+k}}{n!}+o(\frac{n^{2j+k}}{n!})" display="inline" intent=":literal"><semantics><mrow><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msup><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow></mfrac><mo>=</mo><mrow><mfrac><msup><mi>n</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>+</mo><mi>k</mi></mrow></msup><mrow><mi>n</mi><mo>!</mo></mrow></mfrac><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mfrac><msup><mi>n</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>+</mo><mi>k</mi></mrow></msup><mrow><mi>n</mi><mo>!</mo></mrow></mfrac><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{(n-k)^{2j}}{(n-k)!}=\frac{n^{2j+k}}{n!}+o(\frac{n^{2j+k}}{n!})</annotation></semantics></math>. The inequalities are immediate from the asymptotic formula.
∎</span></p>
</div>
</div>
<div id="S4.Thmtheorem8" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem8.2" class="ltx_text ltx_font_bold">Remark 4.8</span></span><span id="S4.Thmtheorem8.3" class="ltx_text ltx_font_bold"> </span>(Zeta function)<span id="S4.Thmtheorem8.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem8.p1" class="ltx_para">
<p id="S4.Thmtheorem8.p1.1" class="ltx_p">When <math id="S4.Thmtheorem8.p1.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is defined over <math id="S4.Thmtheorem8.p1.m2" class="ltx_Math" alttext="\mathbb{Z}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">\mathbb{Z}</annotation></semantics></math>, and has cohomology of pure Tate type, so that <math id="S4.Thmtheorem8.p1.m3" class="ltx_Math" alttext="\lvert X(\mathbb{F}_{q})\rvert=p_{X}(q)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><msub><mi>p</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lvert X(\mathbb{F}_{q})\rvert=p_{X}(q)</annotation></semantics></math> for any prime power <math id="S4.Thmtheorem8.p1.m4" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> (for example, this holds if <math id="S4.Thmtheorem8.p1.m5" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> admits a cell decomposition), the generating series
(<a href="#S4.E4" title="In Theorem 4.2. ‣ 4.1. 𝑛-fold products ‣ 4. Characteristic polynomials of varieties and log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.4</span></a>) is equal to the <math id="S4.Thmtheorem8.p1.m6" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math>-th power of the Zeta function</p>
<table id="S4.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex14.m1" class="ltx_math_unparsed" alttext="\zeta_{X}(t)=\exp\sum_{n\geq 1}\frac{1}{n}\lvert X(\mathbb{F}_{q^{n}})\rvert t^{n}=\exp\sum_{n\geq 1}\frac{1}{n}\mathsf{p}_{n}\circ(p_{X}(q)t)=\Exp(p_{X}(q)t)" display="block" intent=":literal"><semantics><mrow><msub><mi>ζ</mi><mi>X</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>exp</mi><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>≥</mo><mn>1</mn></mrow></munder><mfrac><mn>1</mn><mi>n</mi></mfrac><mrow><mo stretchy="false">|</mo><mi>X</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><msup><mi>q</mi><mi>n</mi></msup></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">|</mo></mrow><msup><mi>t</mi><mi>n</mi></msup><mo>=</mo><mi>exp</mi><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>≥</mo><mn>1</mn></mrow></munder><mfrac><mn>1</mn><mi>n</mi></mfrac><msub><mi>𝗉</mi><mi>n</mi></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>X</mi></msub><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>Exp</mi><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mi>X</mi></msub><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\zeta_{X}(t)=\exp\sum_{n\geq 1}\frac{1}{n}\lvert X(\mathbb{F}_{q^{n}})\rvert t^{n}=\exp\sum_{n\geq 1}\frac{1}{n}\mathsf{p}_{n}\circ(p_{X}(q)t)=\Exp(p_{X}(q)t)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmtheorem8.p1.2" class="ltx_p">of <math id="S4.Thmtheorem8.p1.m7" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> up to interchanging the roles of <math id="S4.Thmtheorem8.p1.m8" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> and <math id="S4.Thmtheorem8.p1.m9" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>.
Here <math id="S4.Thmtheorem8.p1.m10" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> is regarded as a variable when applying the plethysm.
Moreover, the equality
(<a href="#S4.E4" title="In Theorem 4.2. ‣ 4.1. 𝑛-fold products ‣ 4. Characteristic polynomials of varieties and log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.4</span></a>) corresponds to the identity appearing in the Weil conjecture</p>
<table id="S4.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex15.m1" class="ltx_Math" alttext="\zeta_{X}(t)=\frac{P_{1}(t)\cdots P_{2d-1}(t)}{P_{0}(t)\cdots P_{2d}(t)}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ζ</mi><mi>X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mi>P</mi><msub><mrow></mrow><mn>1</mn></msub><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0em">⋯</mo><mi>P</mi><msub><mrow></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mrow><mi>P</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0em">⋯</mo><mi>P</mi><msub><mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mfrac></mrow><annotation encoding="application/x-tex">\zeta_{X}(t)=\frac{P_{1}(t)\cdots P_{2d-1}(t)}{P_{0}(t)\cdots P_{2d}(t)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmtheorem8.p1.3" class="ltx_p">with polynomials <math id="S4.Thmtheorem8.p1.m11" class="ltx_Math" alttext="P_{2i+1}(t)=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">P_{2i+1}(t)=1</annotation></semantics></math> and <math id="S4.Thmtheorem8.p1.m12" class="ltx_Math" alttext="P_{2i}(t)=(1-q^{i}t)^{b_{i}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msup><mi>q</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><msub><mi>b</mi><mi>i</mi></msub></msup></mrow><annotation encoding="application/x-tex">P_{2i}(t)=(1-q^{i}t)^{b_{i}}</annotation></semantics></math> for all <math id="S4.Thmtheorem8.p1.m13" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>.</p>
</div>
</div>
</section>
<section id="S4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.2. </span>GIT moduli space of <math id="S4.SS2.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> points on <math id="S4.SS2.m2" class="ltx_Math" alttext="\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>1</mn></msup><annotation encoding="application/x-tex">\mathbb{P}^{1}</annotation></semantics></math></h3>

<div id="S4.SS2.p1" class="ltx_para">
<p id="S4.SS2.p1.1" class="ltx_p">Let <math id="S4.SS2.p1.m1" class="ltx_Math" alttext="n=2r+1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">n=2r+1</annotation></semantics></math> be odd with <math id="S4.SS2.p1.m2" class="ltx_Math" alttext="r\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">r\geq 1</annotation></semantics></math>. We let</p>
<table id="S4.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex16.m1" class="ltx_math_unparsed" alttext="Y_{n}=(\mathbb{P}^{1})^{n}/\!\!/\mathrm{SL}_{2}(\mathbb{C})" display="block" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mi>n</mi></msub><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>ℙ</mi><mn>1</mn></msup><mo stretchy="false">)</mo></mrow><mi>n</mi></msup><mpadded style="width:0.160em;" width="0.160em"><mo>/</mo></mpadded><mo>/</mo><msub><mi>SL</mi><mn>2</mn></msub><mrow><mo stretchy="false">(</mo><mi>ℂ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Y_{n}=(\mathbb{P}^{1})^{n}/\!\!/\mathrm{SL}_{2}(\mathbb{C})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p1.2" class="ltx_p">be the GIT quotient (cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib22" title="" class="ltx_ref">22</a>]</cite>) of <math id="S4.SS2.p1.m3" class="ltx_Math" alttext="(\mathbb{P}^{1})^{n}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msup><mi>ℙ</mi><mn>1</mn></msup><mo stretchy="false">)</mo></mrow><mi>n</mi></msup><annotation encoding="application/x-tex">(\mathbb{P}^{1})^{n}</annotation></semantics></math> by the diagonal <math id="S4.SS2.p1.m4" class="ltx_Math" alttext="\mathrm{SL}_{2}(\mathbb{C})" display="inline" intent=":literal"><semantics><mrow><msub><mi>SL</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ℂ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{SL}_{2}(\mathbb{C})</annotation></semantics></math> action with respect to the linearization <math id="S4.SS2.p1.m5" class="ltx_Math" alttext="{\cal O}_{(\mathbb{P}^{1})^{n}}(1,\cdots,1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒪</mi><msup><mrow><mo stretchy="false">(</mo><msup><mi>ℙ</mi><mn>1</mn></msup><mo stretchy="false">)</mo></mrow><mi>n</mi></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\cal O}_{(\mathbb{P}^{1})^{n}}(1,\cdots,1)</annotation></semantics></math>.
It is a smooth projective variety whose cohomology was computed in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib20" title="" class="ltx_ref">20</a>, Example 5.18]</cite>.</p>
</div>
<div id="S4.SS2.p2" class="ltx_para">
<p id="S4.SS2.p2.1" class="ltx_p">The natural action of <math id="S4.SS2.p2.m1" class="ltx_Math" alttext="\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathbb{S}_{n}</annotation></semantics></math> on <math id="S4.SS2.p2.m2" class="ltx_Math" alttext="(\mathbb{P}^{1})^{n}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><msup><mi>ℙ</mi><mn>1</mn></msup><mo stretchy="false">)</mo></mrow><mi>n</mi></msup><annotation encoding="application/x-tex">(\mathbb{P}^{1})^{n}</annotation></semantics></math> permuting the factors commutes with that of <math id="S4.SS2.p2.m3" class="ltx_Math" alttext="\mathrm{SL}_{2}(\mathbb{C})" display="inline" intent=":literal"><semantics><mrow><msub><mi>SL</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ℂ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{SL}_{2}(\mathbb{C})</annotation></semantics></math> and hence we have the induced action of <math id="S4.SS2.p2.m4" class="ltx_Math" alttext="\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathbb{S}_{n}</annotation></semantics></math> on <math id="S4.SS2.p2.m5" class="ltx_Math" alttext="Y_{n}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mi>n</mi></msub><annotation encoding="application/x-tex">Y_{n}</annotation></semantics></math>.
It is straightforward to apply Kirwan’s method to compute the graded <math id="S4.SS2.p2.m6" class="ltx_Math" alttext="\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathbb{S}_{n}</annotation></semantics></math>-module <math id="S4.SS2.p2.m7" class="ltx_Math" alttext="H^{*}(Y_{n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{*}(Y_{n})</annotation></semantics></math> to obtain (cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib6" title="" class="ltx_ref">6</a>, Lemma 4.7]</cite>)</p>
<table id="S4.E12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(4.12)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E12.m1" class="ltx_Math" alttext="\sum_{k=0}^{2r-2}\mathrm{ch}_{\mathbb{S}_{n}}H^{2k}(Y_{n})t^{k}=\sum_{j=0}^{r-1}t^{j}(1+t^{2}+\cdots+t^{2(r-j-1)})\mathsf{h}_{(n-j,j)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>−</mo><mn>2</mn></mrow></munderover><mrow><msub><mi>ch</mi><msub><mi>𝕊</mi><mi>n</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mi>k</mi></msup></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><msup><mi>t</mi><mi>j</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msup><mi>t</mi><mn>2</mn></msup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msup><mi>t</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>−</mo><mi>j</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝗁</mi><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{k=0}^{2r-2}\mathrm{ch}_{\mathbb{S}_{n}}H^{2k}(Y_{n})t^{k}=\sum_{j=0}^{r-1}t^{j}(1+t^{2}+\cdots+t^{2(r-j-1)})\mathsf{h}_{(n-j,j)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p2.2" class="ltx_p">Applying the Stanley map <math id="S4.SS2.p2.m8" class="ltx_Math" alttext="\mathscr{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">𝒮</mi><annotation encoding="application/x-tex">\mathscr{S}</annotation></semantics></math>, we obtain the characteristic polynomial <math id="S4.SS2.p2.m9" class="ltx_Math" alttext="\mathscr{S}_{Y_{n}}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>Y</mi><mi>n</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}_{Y_{n}}(m,t)</annotation></semantics></math> of <math id="S4.SS2.p2.m10" class="ltx_Math" alttext="Y_{n}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mi>n</mi></msub><annotation encoding="application/x-tex">Y_{n}</annotation></semantics></math> as follows.</p>
</div>
<div id="S4.Thmtheorem9" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem9.2" class="ltx_text ltx_font_bold">Proposition 4.9</span></span><span id="S4.Thmtheorem9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem9.p1" class="ltx_para">
<p id="S4.Thmtheorem9.p1.1" class="ltx_p"><span id="S4.Thmtheorem9.p1.1.1" class="ltx_text ltx_font_italic">For <math id="S4.Thmtheorem9.p1.m1" class="ltx_Math" alttext="n=2r+1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">n=2r+1</annotation></semantics></math>,</span></p>
<table id="S4.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex17.m1" class="ltx_Math" alttext="\mathscr{S}_{Y_{n}}(m,t)=\sum_{j=0}^{r-1}t^{j}(1+t^{2}+\cdots+t^{2(r-j-1)})\Big(\kern-3.00003pt\Big(\genfrac{}{}{0.0pt}{}{m}{n-j}\Big)\kern-3.00003pt\Big)\Big(\kern-3.00003pt\Big(\genfrac{}{}{0.0pt}{}{m}{j}\Big)\kern-3.00003pt\Big)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>Y</mi><mi>n</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><msup><mi>t</mi><mi>j</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msup><mi>t</mi><mn>2</mn></msup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msup><mi>t</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>−</mo><mi>j</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac linethickness="0.0pt"><mi>m</mi><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></mfrac><mpadded style="width:0.089em;" width="0.089em"><mo maxsize="1.600em" minsize="1.600em">)</mo></mpadded></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac linethickness="0.0pt"><mi>m</mi><mi>j</mi></mfrac><mpadded style="width:0.089em;" width="0.089em"><mo maxsize="1.600em" minsize="1.600em">)</mo></mpadded></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathscr{S}_{Y_{n}}(m,t)=\sum_{j=0}^{r-1}t^{j}(1+t^{2}+\cdots+t^{2(r-j-1)})\Big(\kern-3.00003pt\Big(\genfrac{}{}{0.0pt}{}{m}{n-j}\Big)\kern-3.00003pt\Big)\Big(\kern-3.00003pt\Big(\genfrac{}{}{0.0pt}{}{m}{j}\Big)\kern-3.00003pt\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmtheorem9.p1.2" class="ltx_p"><span id="S4.Thmtheorem9.p1.2.1" class="ltx_text ltx_font_italic">In particular,</span></p>
<table id="S4.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex18.m1" class="ltx_Math" alttext="\begin{split}&amp;\mathscr{S}_{Y_{n}}(m,1)=\sum_{j=0}^{r-1}(r-j)\Big(\kern-3.00003pt\Big(\genfrac{}{}{0.0pt}{}{m}{n-j}\Big)\kern-3.00003pt\Big)\Big(\kern-3.00003pt\Big(\genfrac{}{}{0.0pt}{}{m}{j}\Big)\kern-3.00003pt\Big),~\text{ and}\\
&amp;\mathscr{S}_{Y_{n}}(1,t)=\sum_{j=0}^{r-1}t^{j}(1+t^{2}+\cdots+t^{2(r-j-1)}).\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>Y</mi><mi>n</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mpadded style="width:0.089em;" width="0.089em"><mo maxsize="1.600em" minsize="1.600em">(</mo></mpadded><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac linethickness="0.0pt"><mi>m</mi><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></mfrac><mpadded style="width:0em;" width="0em"><mo maxsize="1.600em" minsize="1.600em">)</mo></mpadded></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mpadded style="width:0.089em;" width="0.089em"><mo maxsize="1.600em" minsize="1.600em">(</mo></mpadded><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mfrac linethickness="0.0pt"><mi>m</mi><mi>j</mi></mfrac><mpadded style="width:0em;" width="0em"><mo maxsize="1.600em" minsize="1.600em">)</mo></mpadded></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><mo rspace="0.827em">,</mo><mtext class="ltx_mathvariant_italic"> and</mtext></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>Y</mi><mi>n</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><msup><mi>t</mi><mi>j</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msup><mi>t</mi><mn>2</mn></msup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msup><mi>t</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>−</mo><mi>j</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}&amp;\mathscr{S}_{Y_{n}}(m,1)=\sum_{j=0}^{r-1}(r-j)\Big(\kern-3.00003pt\Big(\genfrac{}{}{0.0pt}{}{m}{n-j}\Big)\kern-3.00003pt\Big)\Big(\kern-3.00003pt\Big(\genfrac{}{}{0.0pt}{}{m}{j}\Big)\kern-3.00003pt\Big),~\text{ and}\\
&amp;\mathscr{S}_{Y_{n}}(1,t)=\sum_{j=0}^{r-1}t^{j}(1+t^{2}+\cdots+t^{2(r-j-1)}).\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS2.p3" class="ltx_para">
<p id="S4.SS2.p3.1" class="ltx_p"><span id="S4.SS2.p3.1.1" class="ltx_text">This is immediate from (<a href="#S4.E12" title="In 4.2. GIT moduli space of 𝑛 points on ℙ^1 ‣ 4. Characteristic polynomials of varieties and log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.12</span></a>), since <math id="S4.SS2.p3.m1" class="ltx_Math" alttext="\mathscr{S}_{\mathsf{h}_{(a,b)}}=\big(\kern-3.00003pt\big(\genfrac{}{}{0.0pt}{}{m}{a}\big)\kern-3.00003pt\big)\big(\kern-3.00003pt\big(\genfrac{}{}{0.0pt}{}{m}{b}\big)\kern-3.00003pt\big)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>𝗁</mi><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msub></msub><mo>=</mo><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mfrac linethickness="0.0pt"><mi>m</mi><mi>a</mi></mfrac><mpadded style="width:0.089em;" width="0.089em"><mo maxsize="1.200em" minsize="1.200em">)</mo></mpadded></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mfrac linethickness="0.0pt"><mi>m</mi><mi>b</mi></mfrac><mpadded style="width:0.089em;" width="0.089em"><mo maxsize="1.200em" minsize="1.200em">)</mo></mpadded></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}_{\mathsf{h}_{(a,b)}}=\big(\kern-3.00003pt\big(\genfrac{}{}{0.0pt}{}{m}{a}\big)\kern-3.00003pt\big)\big(\kern-3.00003pt\big(\genfrac{}{}{0.0pt}{}{m}{b}\big)\kern-3.00003pt\big)</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S4.SS2.p4" class="ltx_para">
<p id="S4.SS2.p4.1" class="ltx_p">Numerical calculations lead us to the following conjecture.</p>
</div>
<div id="S4.Thmtheorem10" class="ltx_theorem ltx_theorem_conjecture">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem10.2" class="ltx_text ltx_font_bold">Conjecture 4.10</span></span><span id="S4.Thmtheorem10.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem10.p1" class="ltx_para">
<p id="S4.Thmtheorem10.p1.1" class="ltx_p"><span id="S4.Thmtheorem10.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmtheorem10.p1.m1" class="ltx_Math" alttext="n\geq 3" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">n\geq 3</annotation></semantics></math> be an odd integer.</span></p>
<ol id="S4.I5" class="ltx_enumerate">
<li id="S4.I5.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I5.i1.p1" class="ltx_para">
<p id="S4.I5.i1.p1.1" class="ltx_p"><math id="S4.I5.i1.p1.m1" class="ltx_Math" alttext="\mathscr{S}_{Y_{n}}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>Y</mi><mi>n</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}_{Y_{n}}(m,t)</annotation></semantics></math><span id="S4.I5.i1.p1.1.1" class="ltx_text ltx_font_italic"> is length log-concave in degree </span><math id="S4.I5.i1.p1.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math><span id="S4.I5.i1.p1.1.2" class="ltx_text ltx_font_italic"> for any </span><math id="S4.I5.i1.p1.m3" class="ltx_Math" alttext="0\leq k\leq n" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mi>k</mi><mo>≤</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">0\leq k\leq n</annotation></semantics></math><span id="S4.I5.i1.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I5.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I5.i2.p1" class="ltx_para">
<p id="S4.I5.i2.p1.1" class="ltx_p"><math id="S4.I5.i2.p1.m1" class="ltx_Math" alttext="\mathscr{S}_{Y_{n}}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>Y</mi><mi>n</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}_{Y_{n}}(m,t)</annotation></semantics></math><span id="S4.I5.i2.p1.1.1" class="ltx_text ltx_font_italic"> is length log-concave at </span><math id="S4.I5.i2.p1.m2" class="ltx_Math" alttext="t=1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=1</annotation></semantics></math><span id="S4.I5.i2.p1.1.2" class="ltx_text ltx_font_italic">, i.e. </span><math id="S4.I5.i2.p1.m3" class="ltx_Math" alttext="\mathscr{S}_{Y_{n}}(m,1)\in\mathbb{Q}[m]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>Y</mi><mi>n</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mi>ℚ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}_{Y_{n}}(m,1)\in\mathbb{Q}[m]</annotation></semantics></math><span id="S4.I5.i2.p1.1.3" class="ltx_text ltx_font_italic"> is log-concave.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S4.SS2.p5" class="ltx_para">
<p id="S4.SS2.p5.1" class="ltx_p">We have checked that (1) and (2) hold for <math id="S4.SS2.p5.m1" class="ltx_Math" alttext="n\leq 400" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≤</mo><mn>400</mn></mrow><annotation encoding="application/x-tex">n\leq 400</annotation></semantics></math>.</p>
</div>
<div id="S4.Thmtheorem11" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem11.2" class="ltx_text ltx_font_bold">Example 4.11</span></span><span id="S4.Thmtheorem11.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem11.p1" class="ltx_para">
<p id="S4.Thmtheorem11.p1.1" class="ltx_p">When <math id="S4.Thmtheorem11.p1.m1" class="ltx_Math" alttext="n=5" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">n=5</annotation></semantics></math>, the graded <math id="S4.Thmtheorem11.p1.m2" class="ltx_Math" alttext="\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathbb{S}_{n}</annotation></semantics></math>-representation on <math id="S4.Thmtheorem11.p1.m3" class="ltx_Math" alttext="H^{*}(Y_{5})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mn>5</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{*}(Y_{5})</annotation></semantics></math> is
<math id="S4.Thmtheorem11.p1.m4" class="ltx_Math" alttext="\sum_{k=0}^{2}\mathrm{ch}_{\mathbb{S}_{5}}H^{2k}(Y_{5})t^{k}=\mathsf{h}_{5}(1+t^{2})+\mathsf{h}_{(4,1)}t" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mn>2</mn></msubsup><mrow><msub><mi>ch</mi><msub><mi>𝕊</mi><mn>5</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mn>5</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mi>k</mi></msup></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>𝗁</mi><mn>5</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msup><mi>t</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>𝗁</mi><mrow><mo stretchy="false">(</mo><mn>4</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{k=0}^{2}\mathrm{ch}_{\mathbb{S}_{5}}H^{2k}(Y_{5})t^{k}=\mathsf{h}_{5}(1+t^{2})+\mathsf{h}_{(4,1)}t</annotation></semantics></math>.
Hence by applying <math id="S4.Thmtheorem11.p1.m5" class="ltx_Math" alttext="\mathscr{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">𝒮</mi><annotation encoding="application/x-tex">\mathscr{S}</annotation></semantics></math>, we obtain</p>
<table id="S4.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex19.m1" class="ltx_Math" alttext="\begin{split}\mathscr{S}_{Y_{5}}(m,t)&amp;=\frac{1}{120}(m^{5}+10m^{4}+35m^{3}+50m^{2}+24m)(1+t^{2})\\
&amp;\quad+\frac{1}{24}(m^{5}+6m^{4}+11m^{3}+6m^{2})t.\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>Y</mi><mn>5</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><mfrac><mn>1</mn><mn>120</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>m</mi><mn>5</mn></msup><mo>+</mo><mrow><mn>10</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>m</mi><mn>4</mn></msup></mrow><mo>+</mo><mrow><mn>35</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>m</mi><mn>3</mn></msup></mrow><mo>+</mo><mrow><mn>50</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>m</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>24</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msup><mi>t</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mn>24</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>m</mi><mn>5</mn></msup><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>m</mi><mn>4</mn></msup></mrow><mo>+</mo><mrow><mn>11</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>m</mi><mn>3</mn></msup></mrow><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>m</mi><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\mathscr{S}_{Y_{5}}(m,t)&amp;=\frac{1}{120}(m^{5}+10m^{4}+35m^{3}+50m^{2}+24m)(1+t^{2})\\
&amp;\quad+\frac{1}{24}(m^{5}+6m^{4}+11m^{3}+6m^{2})t.\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmtheorem11.p1.2" class="ltx_p">Evaluating it at <math id="S4.Thmtheorem11.p1.m6" class="ltx_Math" alttext="t=1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=1</annotation></semantics></math>, we get</p>
<table id="S4.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex20.m1" class="ltx_Math" alttext="\begin{split}\mathscr{S}_{Y_{5}}(m,1)&amp;=\frac{1}{120}(7m^{5}+50m^{4}+125m^{3}+130m^{2}+48).\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>Y</mi><mn>5</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mfrac><mn>1</mn><mn>120</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>m</mi><mn>5</mn></msup></mrow><mo>+</mo><mrow><mn>50</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>m</mi><mn>4</mn></msup></mrow><mo>+</mo><mrow><mn>125</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>m</mi><mn>3</mn></msup></mrow><mo>+</mo><mrow><mn>130</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>m</mi><mn>2</mn></msup></mrow><mo>+</mo><mn>48</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\mathscr{S}_{Y_{5}}(m,1)&amp;=\frac{1}{120}(7m^{5}+50m^{4}+125m^{3}+130m^{2}+48).\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmtheorem11.p1.3" class="ltx_p">It is easy to see that Conjecture <a href="#S4.Thmtheorem10" title="Conjecture 4.10. ‣ 4.2. GIT moduli space of 𝑛 points on ℙ^1 ‣ 4. Characteristic polynomials of varieties and log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.10</span></a> holds in this case.</p>
</div>
</div>
<div id="S4.SS2.p6" class="ltx_para">
<p id="S4.SS2.p6.1" class="ltx_p">On the other hand, the degree log-concavities fail for <math id="S4.SS2.p6.m1" class="ltx_Math" alttext="Y_{n}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mi>n</mi></msub><annotation encoding="application/x-tex">Y_{n}</annotation></semantics></math>. More precisely, <math id="S4.SS2.p6.m2" class="ltx_Math" alttext="\mathscr{S}_{Y_{n}}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>Y</mi><mi>n</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}_{Y_{n}}(m,t)</annotation></semantics></math> is degree log-concave neither at <math id="S4.SS2.p6.m3" class="ltx_Math" alttext="m=1" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">m=1</annotation></semantics></math> nor in length 1.</p>
</div>
<div id="S4.Thmtheorem12" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem12.2" class="ltx_text ltx_font_bold">Example 4.12</span></span><span id="S4.Thmtheorem12.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem12.p1" class="ltx_para">
<p id="S4.Thmtheorem12.p1.1" class="ltx_p"><math id="S4.Thmtheorem12.p1.m1" class="ltx_Math" alttext="\mathscr{S}_{Y_{n}}(1,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>Y</mi><mi>n</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}_{Y_{n}}(1,t)</annotation></semantics></math> is not log-concave whenever <math id="S4.Thmtheorem12.p1.m2" class="ltx_Math" alttext="n\geq 7" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>7</mn></mrow><annotation encoding="application/x-tex">n\geq 7</annotation></semantics></math>. Indeed,</p>
<table id="S4.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex21.m1" class="ltx_Math" alttext="\begin{split}\mathscr{S}_{Y_{7}}(1,t)=1+t&amp;+2t^{2}+t^{3}+t^{4},\\
\mathscr{S}_{Y_{9}}(1,t)=1+t+2t^{2}&amp;+2t^{3}+2t^{4}+t^{5}+t^{6},\\
\mathscr{S}_{Y_{11}}(1,t)=1+t+2t^{2}+2t^{3}&amp;+3t^{4}+2t^{5}+2t^{6}+t^{7}+t^{8},\\
&amp;\quad\cdots\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>Y</mi><mn>7</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mn>2</mn></msup></mrow></mrow><mo>+</mo><msup><mi>t</mi><mn>3</mn></msup><mo>+</mo><msup><mi>t</mi><mn>4</mn></msup></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>Y</mi><mn>9</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo mathsize="0.700em">,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mn>2</mn></msup></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mn>3</mn></msup></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mn>4</mn></msup></mrow><mo>+</mo><msup><mi>t</mi><mn>5</mn></msup><mo>+</mo><msup><mi>t</mi><mn>6</mn></msup></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>Y</mi><mn>11</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo mathsize="0.700em">,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mn>3</mn></msup></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mn>4</mn></msup></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mn>5</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mn>6</mn></msup></mrow><mo>+</mo><msup><mi>t</mi><mn>7</mn></msup><mo>+</mo><msup><mi>t</mi><mn>8</mn></msup></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mo>⋯</mo></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\mathscr{S}_{Y_{7}}(1,t)=1+t&amp;+2t^{2}+t^{3}+t^{4},\\
\mathscr{S}_{Y_{9}}(1,t)=1+t+2t^{2}&amp;+2t^{3}+2t^{4}+t^{5}+t^{6},\\
\mathscr{S}_{Y_{11}}(1,t)=1+t+2t^{2}+2t^{3}&amp;+3t^{4}+2t^{5}+2t^{6}+t^{7}+t^{8},\\
&amp;\quad\cdots\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.Thmtheorem12.p2" class="ltx_para">
<p id="S4.Thmtheorem12.p2.1" class="ltx_p">One can also easily check that the coefficient of <math id="S4.Thmtheorem12.p2.m1" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> in <math id="S4.Thmtheorem12.p2.m2" class="ltx_Math" alttext="\mathscr{S}_{Y_{n}}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>Y</mi><mi>n</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}_{Y_{n}}(m,t)</annotation></semantics></math> is</p>
<table id="S4.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex22.m1" class="ltx_Math" alttext="\frac{1}{n}\sum_{j=0}^{r-1}t^{2j}=\frac{1}{n}(1+t^{2}+\cdots+t^{2r-4}+t^{2r-2})" display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></munderover><msup><mi>t</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msup></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><msup><mi>t</mi><mn>2</mn></msup><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msup><mi>t</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>−</mo><mn>4</mn></mrow></msup><mo>+</mo><msup><mi>t</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{1}{n}\sum_{j=0}^{r-1}t^{2j}=\frac{1}{n}(1+t^{2}+\cdots+t^{2r-4}+t^{2r-2})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmtheorem12.p2.2" class="ltx_p">which is not log-concave due to the internal zeros at odd degrees.</p>
</div>
</div>
<div id="S4.SS2.p7" class="ltx_para">
<p id="S4.SS2.p7.1" class="ltx_p">Interestingly, numerical calculation shows that <math id="S4.SS2.p7.m1" class="ltx_Math" alttext="\mathscr{S}_{Y_{n}}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>Y</mi><mi>n</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}_{Y_{n}}(m,t)</annotation></semantics></math> is degree log-concave in length <math id="S4.SS2.p7.m2" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> when <math id="S4.SS2.p7.m3" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> is <em id="S4.SS2.p7.1.1" class="ltx_emph ltx_font_italic">sufficiently close</em> to <math id="S4.SS2.p7.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>. For example, <math id="S4.SS2.p7.m5" class="ltx_Math" alttext="\mathscr{S}_{Y_{n}}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>Y</mi><mi>n</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}_{Y_{n}}(m,t)</annotation></semantics></math> is degree log-concave in length <math id="S4.SS2.p7.m6" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> for any <math id="S4.SS2.p7.m7" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> in the range <math id="S4.SS2.p7.m8" class="ltx_Math" alttext="\sqrt{n}+2\leq\ell\leq n" display="inline" intent=":literal"><semantics><mrow><mrow><msqrt><mi>n</mi></msqrt><mo>+</mo><mn>2</mn></mrow><mo>≤</mo><mi mathvariant="normal">ℓ</mi><mo>≤</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">\sqrt{n}+2\leq\ell\leq n</annotation></semantics></math> for <math id="S4.SS2.p7.m9" class="ltx_Math" alttext="5\leq n\leq 400" display="inline" intent=":literal"><semantics><mrow><mn>5</mn><mo>≤</mo><mi>n</mi><mo>≤</mo><mn>400</mn></mrow><annotation encoding="application/x-tex">5\leq n\leq 400</annotation></semantics></math>, although the bound <math id="S4.SS2.p7.m10" class="ltx_Math" alttext="\sqrt{n}+2" display="inline" intent=":literal"><semantics><mrow><msqrt><mi>n</mi></msqrt><mo>+</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\sqrt{n}+2</annotation></semantics></math> is definitely not sharp. Computing a sharp bound and analyzing its asymptotic behavior as <math id="S4.SS2.p7.m11" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> grows would also be of interest.</p>
</div>
</section>
<section id="S4.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.3. </span>Hessenberg varieties</h3>

<div id="S4.SS3.p1" class="ltx_para">
<p id="S4.SS3.p1.1" class="ltx_p">Regular semisimple Hessenberg varieties are subvarieties in the flag variety, naturally equipped with an <math id="S4.SS3.p1.m1" class="ltx_Math" alttext="\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathbb{S}_{n}</annotation></semantics></math>-action on its cohomology. For further details on the discussion below, we refer the reader to a survey <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib2" title="" class="ltx_ref">2</a>]</cite>.</p>
</div>
<div id="S4.SS3.p2" class="ltx_para">
<p id="S4.SS3.p2.1" class="ltx_p">Denote the variety of flags in <math id="S4.SS3.p2.m1" class="ltx_Math" alttext="\mathbb{C}^{n}" display="inline" intent=":literal"><semantics><msup><mi>ℂ</mi><mi>n</mi></msup><annotation encoding="application/x-tex">\mathbb{C}^{n}</annotation></semantics></math> by <math id="S4.SS3.p2.m2" class="ltx_math_unparsed" alttext="\mathrm{Fl}_{n}=\{F_{\bullet}=(F_{1}\subset\cdots\subset F_{n}=\mathbb{C}^{n})\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Fl</mi><mi>n</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>F</mi><mo>∙</mo></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mn>1</mn></msub><mo rspace="0.1389em">⊂</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">⊂</mo><msub><mi>F</mi><mi>n</mi></msub><mo>=</mo><msup><mi>ℂ</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Fl}_{n}=\{F_{\bullet}=(F_{1}\subset\cdots\subset F_{n}=\mathbb{C}^{n})\}</annotation></semantics></math> where <math id="S4.SS3.p2.m3" class="ltx_Math" alttext="F_{i}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>i</mi></msub><annotation encoding="application/x-tex">F_{i}</annotation></semantics></math> are <math id="S4.SS3.p2.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-dimensional subspaces of <math id="S4.SS3.p2.m5" class="ltx_Math" alttext="\mathbb{C}^{n}" display="inline" intent=":literal"><semantics><msup><mi>ℂ</mi><mi>n</mi></msup><annotation encoding="application/x-tex">\mathbb{C}^{n}</annotation></semantics></math> for each <math id="S4.SS3.p2.m6" class="ltx_Math" alttext="i\in[n]:=\{1,\cdots,n\}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow><mo>:=</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>n</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[n]:=\{1,\cdots,n\}</annotation></semantics></math>.</p>
</div>
<div id="S4.SS3.p3" class="ltx_para">
<p id="S4.SS3.p3.1" class="ltx_p">A <em id="S4.SS3.p3.1.1" class="ltx_emph ltx_font_italic">Hessenberg function</em> is a non-decreasing function <math id="S4.SS3.p3.m1" class="ltx_Math" alttext="h:[n]\to[n]" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">h:[n]\to[n]</annotation></semantics></math> with <math id="S4.SS3.p3.m2" class="ltx_Math" alttext="h(i)\geq i" display="inline" intent=":literal"><semantics><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mi>i</mi></mrow><annotation encoding="application/x-tex">h(i)\geq i</annotation></semantics></math> for all <math id="S4.SS3.p3.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>. Choosing a regular semisimple <math id="S4.SS3.p3.m4" class="ltx_Math" alttext="n\times n" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">n\times n</annotation></semantics></math> matrix <math id="S4.SS3.p3.m5" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> (or equivalently, an <math id="S4.SS3.p3.m6" class="ltx_Math" alttext="n\times n" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">n\times n</annotation></semantics></math> matrix with <math id="S4.SS3.p3.m7" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> distinct eigenvalues), one obtains a subvariety in <math id="S4.SS3.p3.m8" class="ltx_Math" alttext="\mathrm{Fl}_{n}" display="inline" intent=":literal"><semantics><msub><mi>Fl</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathrm{Fl}_{n}</annotation></semantics></math>, called a <em id="S4.SS3.p3.1.2" class="ltx_emph ltx_font_italic">(regular semisimple) Hessenberg variety</em>, defined as</p>
<table id="S4.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex23.m1" class="ltx_Math" alttext="X_{h}=\{F_{\bullet}\in\mathrm{Fl}_{n}:sF_{i}\subset F_{h(i)}~\text{ for all }i\}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>X</mi><mi>h</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>F</mi><mo>∙</mo></msub><mo>∈</mo><msub><mi>Fl</mi><mi>n</mi></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mi>i</mi></msub></mrow><mo>⊂</mo><mrow><msub><mi>F</mi><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mtext> for all </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">X_{h}=\{F_{\bullet}\in\mathrm{Fl}_{n}:sF_{i}\subset F_{h(i)}~\text{ for all }i\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.p3.2" class="ltx_p">Here, we suppress <math id="S4.SS3.p3.m9" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> in the notation, as its diffeomorphism type (hence its cohomology) does not depend on the choice of <math id="S4.SS3.p3.m10" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>.</p>
</div>
<div id="S4.SS3.p4" class="ltx_para">
<p id="S4.SS3.p4.1" class="ltx_p">These varieties were introduced in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib12" title="" class="ltx_ref">12</a>]</cite>, where it is also proved that they are smooth of dimension <math id="S4.SS3.p4.m1" class="ltx_Math" alttext="\sum_{i=1}^{n}(h(i)-i)" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mrow><mo lspace="0em" stretchy="false">(</mo><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{n}(h(i)-i)</annotation></semantics></math> when <math id="S4.SS3.p4.m2" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> is regular semisimple. In this case, <math id="S4.SS3.p4.m3" class="ltx_Math" alttext="X_{h}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>h</mi></msub><annotation encoding="application/x-tex">X_{h}</annotation></semantics></math> admits a natural action of the maximal torus <math id="S4.SS3.p4.m4" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> in <math id="S4.SS3.p4.m5" class="ltx_Math" alttext="\mathrm{GL}_{n}(\mathbb{C})" display="inline" intent=":literal"><semantics><mrow><msub><mi>GL</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ℂ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{GL}_{n}(\mathbb{C})</annotation></semantics></math> centralizing <math id="S4.SS3.p4.m6" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>. Since its <math id="S4.SS3.p4.m7" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>-fixed locus is finite (and isomorphic to <math id="S4.SS3.p4.m8" class="ltx_Math" alttext="\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathbb{S}_{n}</annotation></semantics></math>),
<math id="S4.SS3.p4.m9" class="ltx_Math" alttext="X_{h}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>h</mi></msub><annotation encoding="application/x-tex">X_{h}</annotation></semantics></math> admits a cell decomposition by the Białynicki-Birula theorem and <math id="S4.SS3.p4.m10" class="ltx_Math" alttext="H^{2k+1}(X_{h})=0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>H</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">H^{2k+1}(X_{h})=0</annotation></semantics></math> for all <math id="S4.SS3.p4.m11" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>.
Later in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib30" title="" class="ltx_ref">30</a>]</cite>, Tymoczko defined an <math id="S4.SS3.p4.m12" class="ltx_Math" alttext="\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathbb{S}_{n}</annotation></semantics></math>-action on the <math id="S4.SS3.p4.m13" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>-equivariant cohomology <math id="S4.SS3.p4.m14" class="ltx_Math" alttext="H^{*}_{T}(X_{h})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>H</mi><mi>T</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{*}_{T}(X_{h})</annotation></semantics></math> using the GKM theory <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib14" title="" class="ltx_ref">14</a>]</cite> and <math id="S4.SS3.p4.m15" class="ltx_Math" alttext="X_{h}^{T}\cong\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>X</mi><mi>h</mi><mi>T</mi></msubsup><mo>≅</mo><msub><mi>𝕊</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">X_{h}^{T}\cong\mathbb{S}_{n}</annotation></semantics></math>, and showed that it descends to an <math id="S4.SS3.p4.m16" class="ltx_Math" alttext="\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathbb{S}_{n}</annotation></semantics></math>-action on <math id="S4.SS3.p4.m17" class="ltx_Math" alttext="H^{*}(X_{h})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{*}(X_{h})</annotation></semantics></math> via the canonical projection <math id="S4.SS3.p4.m18" class="ltx_Math" alttext="H^{*}_{T}(X_{h})\to H^{*}(X_{h})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>H</mi><mi>T</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H^{*}_{T}(X_{h})\to H^{*}(X_{h})</annotation></semantics></math>.
We note that this <math id="S4.SS3.p4.m19" class="ltx_Math" alttext="\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathbb{S}_{n}</annotation></semantics></math>-action on <math id="S4.SS3.p4.m20" class="ltx_Math" alttext="H^{*}(X_{h})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{*}(X_{h})</annotation></semantics></math> may not lift to an <math id="S4.SS3.p4.m21" class="ltx_Math" alttext="\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathbb{S}_{n}</annotation></semantics></math>-action on <math id="S4.SS3.p4.m22" class="ltx_Math" alttext="X_{h}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>h</mi></msub><annotation encoding="application/x-tex">X_{h}</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib8" title="" class="ltx_ref">8</a>]</cite>.</p>
</div>
<div id="S4.SS3.p5" class="ltx_para">
<p id="S4.SS3.p5.1" class="ltx_p">We thus obtain</p>
<table id="S4.E13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(4.13)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E13.m1" class="ltx_Math" alttext="\sum_{k\geq 0}\mathrm{ch}_{\mathbb{S}_{n}}(H^{2k}(X_{h}))t^{k}\in\Lambda_{n}[t]" display="block" intent=":literal"><semantics><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>≥</mo><mn>0</mn></mrow></munder><mrow><msub><mi>ch</mi><msub><mi>𝕊</mi><mi>n</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mi>k</mi></msup></mrow></mrow><mo>∈</mo><mrow><msub><mi mathvariant="normal">Λ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{k\geq 0}\mathrm{ch}_{\mathbb{S}_{n}}(H^{2k}(X_{h}))t^{k}\in\Lambda_{n}[t]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.p5.2" class="ltx_p">whose characteristic polynomial is</p>
<table id="S4.E14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(4.14)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E14.m1" class="ltx_Math" alttext="\mathscr{S}_{X_{h}}(m,t)=\sum_{k\geq 0}\mathscr{S}_{H^{2k}(X_{h})}(m)t^{k}\in\mathbb{Q}[m,t]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>X</mi><mi>h</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>≥</mo><mn>0</mn></mrow></munder><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mi>k</mi></msup></mrow></mrow><mo>∈</mo><mrow><mi>ℚ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>m</mi><mo>,</mo><mi>t</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathscr{S}_{X_{h}}(m,t)=\sum_{k\geq 0}\mathscr{S}_{H^{2k}(X_{h})}(m)t^{k}\in\mathbb{Q}[m,t].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.SS3.p6" class="ltx_para">
<p id="S4.SS3.p6.1" class="ltx_p">On the other hand, there is a purely combinatorial way to associate a symmetric function to each Hessenberg function <math id="S4.SS3.p6.m1" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math>.
The chromatic symmetric function introduced by Stanley in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib25" title="" class="ltx_ref">25</a>]</cite> associates a symmetric function</p>
<table id="S4.E15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(4.15)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E15.m1" class="ltx_math_unparsed" alttext="\mathsf{csf}_{\Gamma}=\sum_{\kappa:[n]\to\mathbb{Z}_{&gt;0}\text{ proper}}x_{\kappa(1)}\cdots x_{\kappa(n)}\in\Lambda_{n}" display="block" intent=":literal"><semantics><mrow><mi>𝖼𝗌𝖿</mi><msub><mrow></mrow><mi mathvariant="normal">Γ</mi></msub><mo rspace="0.111em">=</mo><mo movablelimits="false">∑</mo><msub><mrow></mrow><mrow><mi>κ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">→</mo><mrow><msub><mi>ℤ</mi><mrow><mphantom></mphantom><mo>&gt;</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mtext> proper</mtext></mrow></mrow></mrow></msub><mi>x</mi><msub><mrow></mrow><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">⋯</mo><mi>x</mi><msub><mrow></mrow><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>∈</mo><mi mathvariant="normal">Λ</mi><msub><mrow></mrow><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\mathsf{csf}_{\Gamma}=\sum_{\kappa:[n]\to\mathbb{Z}_{&gt;0}\text{ proper}}x_{\kappa(1)}\cdots x_{\kappa(n)}\in\Lambda_{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.p6.2" class="ltx_p">to each graph <math id="S4.SS3.p6.m2" class="ltx_Math" alttext="\Gamma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Γ</mi><annotation encoding="application/x-tex">\Gamma</annotation></semantics></math> with <math id="S4.SS3.p6.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> vertices, where <math id="S4.SS3.p6.m4" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> runs over all the coloring maps from the vertex set <math id="S4.SS3.p6.m5" class="ltx_Math" alttext="[n]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[n]</annotation></semantics></math> to the set of colors indexed by positive integers that are <em id="S4.SS3.p6.2.1" class="ltx_emph ltx_font_italic">proper</em>, that is, <math id="S4.SS3.p6.m6" class="ltx_Math" alttext="\kappa(i)\neq\kappa(j)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mrow><mi>κ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\kappa(i)\neq\kappa(j)</annotation></semantics></math> whenever <math id="S4.SS3.p6.m7" class="ltx_Math" alttext="(i,j)\in E(\Gamma)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Γ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(i,j)\in E(\Gamma)</annotation></semantics></math>. By the substitution (<a href="#S1.E1" title="In 1.1. Chromatic polynomial and characteristic polynomial ‣ 1. Introduction ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.1</span></a>), its characteristic polynomial</p>
<table id="S4.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex24.m1" class="ltx_Math" alttext="\mathscr{S}_{\mathsf{csf}_{\Gamma}}(m)=\mathscr{X}_{\Gamma}(m)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>𝖼𝗌𝖿</mi><mi mathvariant="normal">Γ</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi class="ltx_font_mathscript">𝒳</mi><mi mathvariant="normal">Γ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}_{\mathsf{csf}_{\Gamma}}(m)=\mathscr{X}_{\Gamma}(m)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.p6.3" class="ltx_p">is the usual chromatic polynomial.</p>
</div>
<div id="S4.SS3.p7" class="ltx_para">
<p id="S4.SS3.p7.1" class="ltx_p">In <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib23" title="" class="ltx_ref">23</a>]</cite>, Shareshian and Wachs introduced the notion of the chromatic <em id="S4.SS3.p7.1.1" class="ltx_emph ltx_font_italic">quasi</em>symmetric function <math id="S4.SS3.p7.m1" class="ltx_Math" alttext="\mathsf{cqsf}_{\Gamma}" display="inline" intent=":literal"><semantics><msub><mi>𝖼𝗊𝗌𝖿</mi><mi mathvariant="normal">Γ</mi></msub><annotation encoding="application/x-tex">\mathsf{cqsf}_{\Gamma}</annotation></semantics></math> of a graph <math id="S4.SS3.p7.m2" class="ltx_Math" alttext="\Gamma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Γ</mi><annotation encoding="application/x-tex">\Gamma</annotation></semantics></math>, which is a polynomial in a variable <math id="S4.SS3.p7.m3" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> whose coefficients are quasisymmetric functions, that is, functions invariant under order-preserving change of variable indices. The chromatic quasisymmetric function reduces to the original chromatic symmetric function when evaluated at <math id="S4.SS3.p7.m4" class="ltx_Math" alttext="t=1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=1</annotation></semantics></math>.</p>
</div>
<div id="S4.SS3.p8" class="ltx_para">
<p id="S4.SS3.p8.1" class="ltx_p">For a Hessenberg function <math id="S4.SS3.p8.m1" class="ltx_Math" alttext="h:[n]\to[n]" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">h:[n]\to[n]</annotation></semantics></math>,
let <math id="S4.SS3.p8.m2" class="ltx_Math" alttext="\Gamma_{h}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Γ</mi><mi>h</mi></msub><annotation encoding="application/x-tex">\Gamma_{h}</annotation></semantics></math> be the <em id="S4.SS3.p8.1.1" class="ltx_emph ltx_font_italic">incomparability graph associated to <math id="S4.SS3.p8.m3" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math></em>, i.e. the graph whose vertex set and edge set are</p>
<table id="S4.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex25.m1" class="ltx_Math" alttext="V(\Gamma_{h})=[n]E(\Gamma_{h})=\{(i,j)\in[n]^{2}:i&lt;h(i)\leq j\}" display="block" intent=":literal"><semantics><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Γ</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Γ</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mi>n</mi><mo rspace="0.278em" stretchy="false">]</mo></mrow><mn>2</mn></msup></mrow><mo rspace="0.278em">:</mo><mrow><mi>i</mi><mo>&lt;</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>j</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">V(\Gamma_{h})=[n]E(\Gamma_{h})=\{(i,j)\in[n]^{2}:i&lt;h(i)\leq j\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.p8.2" class="ltx_p">respectively.
Shareshian and Wachs in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib23" title="" class="ltx_ref">23</a>]</cite> showed that the chromatic quasisymmetric function of the graph <math id="S4.SS3.p8.m4" class="ltx_Math" alttext="\Gamma_{h}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Γ</mi><mi>h</mi></msub><annotation encoding="application/x-tex">\Gamma_{h}</annotation></semantics></math>
is in fact a graded symmetric function</p>
<table id="S4.E16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(4.16)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E16.m1" class="ltx_Math" alttext="\mathsf{cqsf}_{\Gamma_{h}}(t)\in\Lambda_{n}[t]" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>𝖼𝗊𝗌𝖿</mi><msub><mi mathvariant="normal">Γ</mi><mi>h</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><msub><mi mathvariant="normal">Λ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathsf{cqsf}_{\Gamma_{h}}(t)\in\Lambda_{n}[t]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.p8.3" class="ltx_p">so that we have the characteristic polynomial</p>
<table id="S4.E17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(4.17)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E17.m1" class="ltx_Math" alttext="\mathscr{S}_{\Gamma_{h}}(m,t):=\mathscr{S}_{\mathsf{cqsf}_{\Gamma_{h}}}(m,t)\in\mathbb{Q}[m,t]" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi mathvariant="normal">Γ</mi><mi>h</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>𝖼𝗊𝗌𝖿</mi><msub><mi mathvariant="normal">Γ</mi><mi>h</mi></msub></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mi>ℚ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>m</mi><mo>,</mo><mi>t</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}_{\Gamma_{h}}(m,t):=\mathscr{S}_{\mathsf{cqsf}_{\Gamma_{h}}}(m,t)\in\mathbb{Q}[m,t]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.p8.4" class="ltx_p">that satisfies</p>
<table id="S4.E18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(4.18)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E18.m1" class="ltx_Math" alttext="\mathscr{S}_{\Gamma_{h}}(m,1)=\mathscr{S}_{\mathsf{csf}_{\Gamma_{h}}}(m)=\mathscr{X}_{\Gamma_{h}}(m)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi mathvariant="normal">Γ</mi><mi>h</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>𝖼𝗌𝖿</mi><msub><mi mathvariant="normal">Γ</mi><mi>h</mi></msub></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi class="ltx_font_mathscript">𝒳</mi><msub><mi mathvariant="normal">Γ</mi><mi>h</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathscr{S}_{\Gamma_{h}}(m,1)=\mathscr{S}_{\mathsf{csf}_{\Gamma_{h}}}(m)=\mathscr{X}_{\Gamma_{h}}(m).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.SS3.p9" class="ltx_para">
<p id="S4.SS3.p9.1" class="ltx_p">A remarkable conjecture by Shareshian-Wachs in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib23" title="" class="ltx_ref">23</a>]</cite>, proved by Brosnan-Chow and independently by Guay-Paquet tells us that (<a href="#S4.E16" title="In 4.3. Hessenberg varieties ‣ 4. Characteristic polynomials of varieties and log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.16</span></a>) is the <math id="S4.SS3.p9.m1" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math>-dual of (<a href="#S4.E13" title="In 4.3. Hessenberg varieties ‣ 4. Characteristic polynomials of varieties and log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.13</span></a>) where <math id="S4.SS3.p9.m2" class="ltx_Math" alttext="\omega:\Lambda\to\Lambda" display="inline" intent=":literal"><semantics><mrow><mi>ω</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi mathvariant="normal">Λ</mi><mo stretchy="false">→</mo><mi mathvariant="normal">Λ</mi></mrow></mrow><annotation encoding="application/x-tex">\omega:\Lambda\to\Lambda</annotation></semantics></math> is the involution sending <math id="S4.SS3.p9.m3" class="ltx_Math" alttext="\mathsf{e}_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>𝖾</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">\mathsf{e}_{\lambda}</annotation></semantics></math> to <math id="S4.SS3.p9.m4" class="ltx_Math" alttext="\mathsf{h}_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>𝗁</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">\mathsf{h}_{\lambda}</annotation></semantics></math>.</p>
</div>
<div id="S4.Thmtheorem13" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem13.2" class="ltx_text ltx_font_bold">Theorem 4.13</span></span><span id="S4.Thmtheorem13.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem13.p1" class="ltx_para">
<p id="S4.Thmtheorem13.p1.1" class="ltx_p"><cite class="ltx_cite ltx_citemacro_cite"><span id="S4.Thmtheorem13.p1.1.1" class="ltx_text ltx_font_italic">[</span><a href="#bib.bib7" title="" class="ltx_ref">7</a>, <a href="#bib.bib15" title="" class="ltx_ref">15</a><span id="S4.Thmtheorem13.p1.1.2" class="ltx_text ltx_font_italic">]</span></cite><span id="S4.Thmtheorem13.p1.1.3" class="ltx_text ltx_font_italic"> For any Hessenberg function <math id="S4.Thmtheorem13.p1.m1" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math>,</span></p>
<table id="S4.Ex26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex26.m1" class="ltx_Math" alttext="\omega\sum_{k\geq 0}\mathrm{ch}_{\mathbb{S}_{n}}(H^{2k}(X_{h}))t^{k}=\mathsf{cqsf}_{\Gamma_{h}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ω</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>≥</mo><mn>0</mn></mrow></munder><mrow><msub><mi>ch</mi><msub><mi>𝕊</mi><mi>n</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mi>k</mi></msup></mrow></mrow></mrow><mo>=</mo><msub><mi>𝖼𝗊𝗌𝖿</mi><msub><mi mathvariant="normal">Γ</mi><mi>h</mi></msub></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\omega\sum_{k\geq 0}\mathrm{ch}_{\mathbb{S}_{n}}(H^{2k}(X_{h}))t^{k}=\mathsf{cqsf}_{\Gamma_{h}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.SS3.p10" class="ltx_para">
<p id="S4.SS3.p10.1" class="ltx_p">See <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib19" title="" class="ltx_ref">19</a>]</cite> for an elementary proof based on the modular law.</p>
</div>
<div id="S4.SS3.p11" class="ltx_para">
<p id="S4.SS3.p11.1" class="ltx_p">By applying the Stanley map <math id="S4.SS3.p11.m1" class="ltx_Math" alttext="\mathscr{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">𝒮</mi><annotation encoding="application/x-tex">\mathscr{S}</annotation></semantics></math>, we get the following.</p>
</div>
<div id="S4.Thmtheorem14" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem14.2" class="ltx_text ltx_font_bold">Corollary 4.14</span></span><span id="S4.Thmtheorem14.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem14.p1" class="ltx_para">
<p id="S4.Thmtheorem14.p1.1" class="ltx_p"><span id="S4.Thmtheorem14.p1.1.1" class="ltx_text ltx_font_italic">Let</span></p>
<table id="S4.Ex27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex27.m1" class="ltx_Math" alttext="\mathscr{S}^{\omega}_{Z}(m,t)=\mathscr{S}\left(\omega\sum_{k\geq 0}\mathrm{ch}_{\mathbb{S}_{n}}(H^{2k}(Z))t^{k}\right)=\sum_{k\geq 0}\mathscr{S}_{H^{2k}(Z)\otimes\mathsf{sgn}_{n}}t^{k}" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathscript">𝒮</mi><mi>Z</mi><mi>ω</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathscript">𝒮</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>ω</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>≥</mo><mn>0</mn></mrow></munder><mrow><msub><mi>ch</mi><msub><mi>𝕊</mi><mi>n</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mi>k</mi></msup></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>≥</mo><mn>0</mn></mrow></munder><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><mrow><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊗</mo><msub><mi>𝗌𝗀𝗇</mi><mi>n</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mi>k</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}^{\omega}_{Z}(m,t)=\mathscr{S}\left(\omega\sum_{k\geq 0}\mathrm{ch}_{\mathbb{S}_{n}}(H^{2k}(Z))t^{k}\right)=\sum_{k\geq 0}\mathscr{S}_{H^{2k}(Z)\otimes\mathsf{sgn}_{n}}t^{k}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmtheorem14.p1.2" class="ltx_p"><span id="S4.Thmtheorem14.p1.2.1" class="ltx_text ltx_font_italic">for any connected smooth projective variety <math id="S4.Thmtheorem14.p1.m1" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math> with an <math id="S4.Thmtheorem14.p1.m2" class="ltx_Math" alttext="\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathbb{S}_{n}</annotation></semantics></math>-action on each even degree cohomology group of <math id="S4.Thmtheorem14.p1.m3" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math>. Then</span></p>
<table id="S4.E19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(4.19)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E19.m1" class="ltx_Math" alttext="\mathscr{S}^{\omega}_{X_{h}}(m,t)=\mathscr{S}_{\Gamma_{h}}(m,t)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>X</mi><mi>h</mi></msub><mi>ω</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi mathvariant="normal">Γ</mi><mi>h</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathscr{S}^{\omega}_{X_{h}}(m,t)=\mathscr{S}_{\Gamma_{h}}(m,t).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.SS3.p12" class="ltx_para">
<p id="S4.SS3.p12.1" class="ltx_p">By (<a href="#S4.E18" title="In 4.3. Hessenberg varieties ‣ 4. Characteristic polynomials of varieties and log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.18</span></a>) and (<a href="#S4.E19" title="In Corollary 4.14. ‣ 4.3. Hessenberg varieties ‣ 4. Characteristic polynomials of varieties and log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.19</span></a>), we have</p>
<table id="S4.E20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(4.20)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E20.m1" class="ltx_Math" alttext="\mathscr{S}^{\omega}_{X_{h}}(m,1)=\mathscr{X}_{\Gamma_{h}}(m)=\prod_{i=1}^{n}\left(m-(h(i)-i)\right)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>X</mi><mi>h</mi></msub><mi>ω</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi class="ltx_font_mathscript">𝒳</mi><msub><mi mathvariant="normal">Γ</mi><mi>h</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mo>(</mo><mrow><mi>m</mi><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathscr{S}^{\omega}_{X_{h}}(m,1)=\mathscr{X}_{\Gamma_{h}}(m)=\prod_{i=1}^{n}\left(m-(h(i)-i)\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.p12.2" class="ltx_p">where the second equality is an easy calculation based on the fact that <math id="S4.SS3.p12.m1" class="ltx_Math" alttext="\Gamma_{h}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Γ</mi><mi>h</mi></msub><annotation encoding="application/x-tex">\Gamma_{h}</annotation></semantics></math> is directed.
In particular, this is log-concave as it should be by a general result of Huh <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib17" title="" class="ltx_ref">17</a>]</cite>.</p>
</div>
<div id="S4.SS3.p13" class="ltx_para">
<p id="S4.SS3.p13.1" class="ltx_p">By Lemma <a href="#S3.Thmtheorem5" title="Lemma 3.5 (𝜔-duality). ‣ 3.2. Characteristic polynomial of a symmetric function ‣ 3. Characteristic polynomials of symmetric functions and representations ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.5</span></a>, we have</p>
<table id="S4.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(4.21)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E21.m1" class="ltx_Math" alttext="\mathscr{S}^{\omega}_{F}(m)=(-1)^{n}\mathscr{S}_{F}(-m)" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathscript">𝒮</mi><mi>F</mi><mi>ω</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒮</mi><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}^{\omega}_{F}(m)=(-1)^{n}\mathscr{S}_{F}(-m)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.p13.2" class="ltx_p">for any <math id="S4.SS3.p13.m1" class="ltx_Math" alttext="F\in\Lambda_{n}" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>∈</mo><msub><mi mathvariant="normal">Λ</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">F\in\Lambda_{n}</annotation></semantics></math> and the following is immediate.</p>
</div>
<div id="S4.Thmtheorem15" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem15.2" class="ltx_text ltx_font_bold">Proposition 4.15</span></span><span id="S4.Thmtheorem15.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem15.p1" class="ltx_para">
<p id="S4.Thmtheorem15.p1.1" class="ltx_p"><span id="S4.Thmtheorem15.p1.1.1" class="ltx_text ltx_font_italic">The characteristic polynomial
of a Hessenberg variety <math id="S4.Thmtheorem15.p1.m1" class="ltx_Math" alttext="X_{h}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>h</mi></msub><annotation encoding="application/x-tex">X_{h}</annotation></semantics></math> satisfies</span></p>
<table id="S4.E22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(4.22)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E22.m1" class="ltx_Math" alttext="\mathscr{S}_{X_{h}}(m,1)=\prod_{i=1}^{n}(m+h(i)-i)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>X</mi><mi>h</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>m</mi><mo>+</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}_{X_{h}}(m,1)=\prod_{i=1}^{n}(m+h(i)-i)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmtheorem15.p1.2" class="ltx_p"><span id="S4.Thmtheorem15.p1.2.1" class="ltx_text ltx_font_italic">and <math id="S4.Thmtheorem15.p1.m2" class="ltx_Math" alttext="\mathscr{S}_{X_{h}}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>X</mi><mi>h</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}_{X_{h}}(m,t)</annotation></semantics></math> is length log-concave at <math id="S4.Thmtheorem15.p1.m3" class="ltx_Math" alttext="t=1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=1</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS3.p14" class="ltx_para">
<p id="S4.SS3.p14.1" class="ltx_p">There are combinatorial formulas for the coefficients of <math id="S4.SS3.p14.m1" class="ltx_Math" alttext="\mathsf{p}_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>𝗉</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">\mathsf{p}_{\lambda}</annotation></semantics></math> in <math id="S4.SS3.p14.m2" class="ltx_Math" alttext="\mathsf{cqsf}_{\Gamma_{h}}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝖼𝗊𝗌𝖿</mi><msub><mi mathvariant="normal">Γ</mi><mi>h</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{cqsf}_{\Gamma_{h}}(t)</annotation></semantics></math> in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib5" title="" class="ltx_ref">5</a>, Theorem 4 and Corollary 7]</cite>. These immediately induce combinatorial formulas for <math id="S4.SS3.p14.m3" class="ltx_Math" alttext="\mathscr{S}_{X_{h}}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>X</mi><mi>h</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}_{X_{h}}(m,t)</annotation></semantics></math> by (<a href="#S4.E19" title="In Corollary 4.14. ‣ 4.3. Hessenberg varieties ‣ 4. Characteristic polynomials of varieties and log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.19</span></a>) and (<a href="#S4.E21" title="In 4.3. Hessenberg varieties ‣ 4. Characteristic polynomials of varieties and log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.21</span></a>).
We do not know yet how to deduce or disprove the other log-concavities from them, except the following two results.
Write <math id="S4.SS3.p14.m4" class="ltx_Math" alttext="[r]_{t}:=\sum_{i=0}^{r-1}t^{i}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">[</mo><mi>r</mi><mo stretchy="false">]</mo></mrow><mi>t</mi></msub><mo rspace="0.111em">:=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow></msubsup><msup><mi>t</mi><mi>i</mi></msup></mrow></mrow><annotation encoding="application/x-tex">[r]_{t}:=\sum_{i=0}^{r-1}t^{i}</annotation></semantics></math> for <math id="S4.SS3.p14.m5" class="ltx_Math" alttext="r\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">r\geq 0</annotation></semantics></math>.</p>
<ol id="S4.I6" class="ltx_enumerate">
<li id="S4.I6.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S4.I6.i1.p1" class="ltx_para">
<p id="S4.I6.i1.p1.1" class="ltx_p">The evaluation of <math id="S4.I6.i1.p1.m1" class="ltx_Math" alttext="\mathscr{S}_{X_{h}}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>X</mi><mi>h</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}_{X_{h}}(m,t)</annotation></semantics></math> at <math id="S4.I6.i1.p1.m2" class="ltx_Math" alttext="m=1" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">m=1</annotation></semantics></math> is</p>
<table id="S4.Ex28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex28.m1" class="ltx_Math" alttext="\mathscr{S}_{X_{h}}(1,t)=\sum_{k\geq 0}\mathrm{dim}(H^{2k}(X_{h})^{\mathbb{S}_{n}})t^{k}=\prod_{i=1}^{n}[h(i)-i+1]_{t}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>X</mi><mi>h</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>≥</mo><mn>0</mn></mrow></munder><mrow><mrow><mi>dim</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow><msub><mi>𝕊</mi><mi>n</mi></msub></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mi>k</mi></msup></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><msub><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>i</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mi>t</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathscr{S}_{X_{h}}(1,t)=\sum_{k\geq 0}\mathrm{dim}(H^{2k}(X_{h})^{\mathbb{S}_{n}})t^{k}=\prod_{i=1}^{n}[h(i)-i+1]_{t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.I6.i1.p1.2" class="ltx_p">In particular, <math id="S4.I6.i1.p1.m3" class="ltx_Math" alttext="\mathscr{S}_{X_{h}}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>X</mi><mi>h</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}_{X_{h}}(m,t)</annotation></semantics></math> is degree log-concave at <math id="S4.I6.i1.p1.m4" class="ltx_Math" alttext="m=1" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">m=1</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I6.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S4.I6.i2.p1" class="ltx_para">
<p id="S4.I6.i2.p1.1" class="ltx_p">The coefficient of <math id="S4.I6.i2.p1.m1" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> in <math id="S4.I6.i2.p1.m2" class="ltx_Math" alttext="\mathscr{S}_{X_{h}}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>X</mi><mi>h</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}_{X_{h}}(m,t)</annotation></semantics></math> is</p>
<table id="S4.Ex29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex29.m1" class="ltx_Math" alttext="\frac{1}{n}[n]_{t}\prod_{i=1}^{n-1}[h(i)-i]_{t}." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></munderover><msub><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>i</mi></mrow><mo stretchy="false">]</mo></mrow><mi>t</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{1}{n}[n]_{t}\prod_{i=1}^{n-1}[h(i)-i]_{t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.I6.i2.p1.2" class="ltx_p">In particular, <math id="S4.I6.i2.p1.m3" class="ltx_Math" alttext="\mathscr{S}_{X_{h}}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>X</mi><mi>h</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}_{X_{h}}(m,t)</annotation></semantics></math> is degree log-concave at length 1.</p>
</div></li>
</ol>
<p id="S4.SS3.p14.2" class="ltx_p">Both formulas follow by combining the results of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib23" title="" class="ltx_ref">23</a>, <a href="#bib.bib1" title="" class="ltx_ref">1</a>, <a href="#bib.bib24" title="" class="ltx_ref">24</a>]</cite>, together with Lemmas <a href="#S3.Thmtheorem10" title="Lemma 3.10. ‣ 3.4. Characteristic polynomial of an 𝕊_𝑛-representation ‣ 3. Characteristic polynomials of symmetric functions and representations ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.10</span></a> and <a href="#S3.Thmtheorem13" title="Lemma 3.13. ‣ 3.5. First examples ‣ 3. Characteristic polynomials of symmetric functions and representations ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.13</span></a>. See also <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib19" title="" class="ltx_ref">19</a>, Proposition 5.10]</cite>.</p>
</div>
<div id="S4.SS3.p15" class="ltx_para">
<p id="S4.SS3.p15.1" class="ltx_p">We end this section with the following natural question which may be regarded as a graded version of Huh’s theorem in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib17" title="" class="ltx_ref">17</a>]</cite>.</p>
</div>
<div id="S4.Thmtheorem16" class="ltx_theorem ltx_theorem_question">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem16.2" class="ltx_text ltx_font_bold">Question 4.16</span></span><span id="S4.Thmtheorem16.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem16.p1" class="ltx_para">
<p id="S4.Thmtheorem16.p1.1" class="ltx_p">Is <math id="S4.Thmtheorem16.p1.m1" class="ltx_Math" alttext="\mathscr{S}_{X_{h}}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>X</mi><mi>h</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}_{X_{h}}(m,t)</annotation></semantics></math> or <math id="S4.Thmtheorem16.p1.m2" class="ltx_Math" alttext="\mathscr{S}^{\omega}_{X_{h}}(m,t)=\mathscr{S}_{\Gamma_{h}}(m,t)=\mathscr{S}_{\mathsf{cqsf}_{\Gamma_{h}}}(m,t)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>X</mi><mi>h</mi></msub><mi>ω</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi mathvariant="normal">Γ</mi><mi>h</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>𝖼𝗊𝗌𝖿</mi><msub><mi mathvariant="normal">Γ</mi><mi>h</mi></msub></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathscr{S}^{\omega}_{X_{h}}(m,t)=\mathscr{S}_{\Gamma_{h}}(m,t)=\mathscr{S}_{\mathsf{cqsf}_{\Gamma_{h}}}(m,t)</annotation></semantics></math> length log-concave in degree <math id="S4.Thmtheorem16.p1.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> for any <math id="S4.Thmtheorem16.p1.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>?</p>
</div>
</div>
</section>
</section>
<section id="S5" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">5. </span>Characteristic polynomial of <math id="S5.m1" class="ltx_Math" alttext="\overline{{\cal M}}_{0,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{{\cal M}}_{0,n}</annotation></semantics></math></h2>

<div id="S5.p1" class="ltx_para">
<p id="S5.p1.1" class="ltx_p">The moduli space <math id="S5.p1.m1" class="ltx_Math" alttext="\overline{{\cal M}}_{0,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{{\cal M}}_{0,n}</annotation></semantics></math> of <math id="S5.p1.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-pointed stable curves of genus <math id="S5.p1.m3" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> is one of the most important varieties in algebraic geometry and has been much studied (cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib10" title="" class="ltx_ref">10</a>, §1]</cite>). It comes with a natural action of the symmetric group <math id="S5.p1.m4" class="ltx_Math" alttext="\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathbb{S}_{n}</annotation></semantics></math> by permuting the marked points and thus its cohomology <math id="S5.p1.m5" class="ltx_Math" alttext="H^{*}(\overline{{\cal M}}_{0,n})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{*}(\overline{{\cal M}}_{0,n})</annotation></semantics></math> is a graded <math id="S5.p1.m6" class="ltx_Math" alttext="\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathbb{S}_{n}</annotation></semantics></math>-module. The rest of this paper is devoted to the study of the characteristic polynomial <math id="S5.p1.m7" class="ltx_Math" alttext="\mathscr{S}_{\overline{{\cal M}}_{0,n}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mover accent="true"><mi>ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mi>n</mi></mrow></msub></msub><annotation encoding="application/x-tex">\mathscr{S}_{\overline{{\cal M}}_{0,n}}</annotation></semantics></math> of <math id="S5.p1.m8" class="ltx_Math" alttext="\overline{{\cal M}}_{0,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{{\cal M}}_{0,n}</annotation></semantics></math> as well as that of <math id="S5.p1.m9" class="ltx_Math" alttext="\overline{{\cal M}}_{0,n+1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><annotation encoding="application/x-tex">\overline{{\cal M}}_{0,n+1}</annotation></semantics></math> on which <math id="S5.p1.m10" class="ltx_Math" alttext="\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathbb{S}_{n}</annotation></semantics></math> is acting by permuting the first <math id="S5.p1.m11" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> marked points with the last one fixed. Based on our pervious results in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib10" title="" class="ltx_ref">10</a>, <a href="#bib.bib11" title="" class="ltx_ref">11</a>]</cite>, we provide recursive formulas for the characteristic polynomials (Theorem <a href="#S5.Thmtheorem11" title="Theorem 5.11. ‣ 5.2. Recursive formulas for characteristic polynomials ‣ 5. Characteristic polynomial of ℳ̄_{0,𝑛} ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.11</span></a>).
In the last subsection §<a href="#S5.SS3" title="5.3. Interpretation as the count of colorings ‣ 5. Characteristic polynomial of ℳ̄_{0,𝑛} ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.3</span></a>, we find an interpretation of the characteristic polynomials of permutation representations that constitute the <math id="S5.p1.m12" class="ltx_Math" alttext="\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathbb{S}_{n}</annotation></semantics></math>-representation <math id="S5.p1.m13" class="ltx_Math" alttext="H^{*}(\overline{{\cal M}}_{0,n+1})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{*}(\overline{{\cal M}}_{0,n+1})</annotation></semantics></math>, in terms of colorings (Corollary <a href="#S5.Thmtheorem21" title="Corollary 5.21. ‣ 5.3. Interpretation as the count of colorings ‣ 5. Characteristic polynomial of ℳ̄_{0,𝑛} ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.21</span></a>).</p>
</div>
<section id="S5.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.1. </span>Recursive formulas for the representations</h3>

<div id="S5.SS1.p1" class="ltx_para">
<p id="S5.SS1.p1.1" class="ltx_p">This section reviews the results in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib10" title="" class="ltx_ref">10</a>, <a href="#bib.bib11" title="" class="ltx_ref">11</a>]</cite>, with a focus on formulas. For an overview together with related geometry, we refer the reader to <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib11" title="" class="ltx_ref">11</a>, §3]</cite>.</p>
</div>
<div id="S5.SS1.p2" class="ltx_para">
<p id="S5.SS1.p2.1" class="ltx_p">The moduli space <math id="S5.SS1.p2.m1" class="ltx_Math" alttext="\overline{{\cal M}}_{0,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{{\cal M}}_{0,n}</annotation></semantics></math> is a compactification of the variety</p>
<table id="S5.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex1.m1" class="ltx_Math" alttext="(\mathbb{P}^{1})^{n}-\Delta/\Aut(\mathbb{P}^{1})" display="block" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><msup><mi>ℙ</mi><mn>1</mn></msup><mo stretchy="false">)</mo></mrow><mi>n</mi></msup><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo>/</mo><mrow><mi>Aut</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ℙ</mi><mn>1</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">(\mathbb{P}^{1})^{n}-\Delta/\Aut(\mathbb{P}^{1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS1.p2.2" class="ltx_p">of <math id="S5.SS1.p2.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> distinct ordered points on <math id="S5.SS1.p2.m3" class="ltx_Math" alttext="\mathbb{P}^{1}" display="inline" intent=":literal"><semantics><msup><mi>ℙ</mi><mn>1</mn></msup><annotation encoding="application/x-tex">\mathbb{P}^{1}</annotation></semantics></math> up to the automorphism group action.
It certainly comes with the natural action of <math id="S5.SS1.p2.m4" class="ltx_Math" alttext="\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathbb{S}_{n}</annotation></semantics></math> permuting the marked points.
When studying the cohomology of <math id="S5.SS1.p2.m5" class="ltx_Math" alttext="\overline{{\cal M}}_{0,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{{\cal M}}_{0,n}</annotation></semantics></math> as a graded <math id="S5.SS1.p2.m6" class="ltx_Math" alttext="\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathbb{S}_{n}</annotation></semantics></math>-module, it helps to study the cohomology of <math id="S5.SS1.p2.m7" class="ltx_Math" alttext="\overline{{\cal M}}_{0,n+1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><annotation encoding="application/x-tex">\overline{{\cal M}}_{0,n+1}</annotation></semantics></math> as well, on which <math id="S5.SS1.p2.m8" class="ltx_Math" alttext="\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathbb{S}_{n}</annotation></semantics></math> is acting by permuting the first <math id="S5.SS1.p2.m9" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> marked points with the last one fixed.</p>
</div>
<div id="S5.SS1.p3" class="ltx_para">
<p id="S5.SS1.p3.1" class="ltx_p">We write the <math id="S5.SS1.p3.m1" class="ltx_Math" alttext="\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathbb{S}_{n}</annotation></semantics></math>-equivariant Poincaré polynomial of <math id="S5.SS1.p3.m2" class="ltx_Math" alttext="\overline{{\cal M}}_{0,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{{\cal M}}_{0,n}</annotation></semantics></math> and <math id="S5.SS1.p3.m3" class="ltx_Math" alttext="\overline{{\cal M}}_{0,n+1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><annotation encoding="application/x-tex">\overline{{\cal M}}_{0,n+1}</annotation></semantics></math> as</p>
<table id="S5.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex2.m1" class="ltx_Math" alttext="\begin{split}&amp;P_{n}=\sum_{k=0}^{n-3}P_{n,k}t^{k}\in\Lambda_{n}[t],\quad\text{where }~P_{n,k}=\mathrm{ch}_{\mathbb{S}_{n}}H^{2k}(\overline{{\cal M}}_{0,n})\in\Lambda_{n};\\
&amp;Q_{n}=\sum_{k=0}^{n-2}Q_{n,k}t^{k}\in\Lambda_{n}[t],\quad\text{where }~Q_{n,k}=\mathrm{ch}_{\mathbb{S}_{n}}H^{2k}(\overline{{\cal M}}_{0,n+1})\in\Lambda_{n}.\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>P</mi><msub><mrow></mrow><mi>n</mi></msub><mo rspace="0.111em">=</mo><mo movablelimits="false">∑</mo><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mrow><mi>n</mi><mo>−</mo><mn>3</mn></mrow></msup><mi>P</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow></msub><mi>t</mi><msup><mrow></mrow><mi>k</mi></msup><mo>∈</mo><mi mathvariant="normal">Λ</mi><msub><mrow></mrow><mi>n</mi></msub><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo><mo rspace="2.167em">,</mo><mtext>where </mtext><mi>P</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>=</mo><mi>ch</mi><msub><mrow></mrow><msub><mi>𝕊</mi><mi>n</mi></msub></msub><mi>H</mi><msup><mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo stretchy="false">(</mo><mover accent="true"><mi>ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mn>0</mn><mo>,</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo><mo>∈</mo><mi mathvariant="normal">Λ</mi><msub><mrow></mrow><mi>n</mi></msub><mo>;</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>Q</mi><msub><mrow></mrow><mi>n</mi></msub><mo rspace="0.111em">=</mo><mo movablelimits="false">∑</mo><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></msup><mi>Q</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow></msub><mi>t</mi><msup><mrow></mrow><mi>k</mi></msup><mo>∈</mo><mi mathvariant="normal">Λ</mi><msub><mrow></mrow><mi>n</mi></msub><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo><mo rspace="2.167em">,</mo><mtext>where </mtext><mi>Q</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>=</mo><mi>ch</mi><msub><mrow></mrow><msub><mi>𝕊</mi><mi>n</mi></msub></msub><mi>H</mi><msup><mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo stretchy="false">(</mo><mover accent="true"><mi>ℳ</mi><mo stretchy="true">¯</mo></mover><msub><mrow></mrow><mrow><mn>0</mn><mo>,</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo><mo>∈</mo><mi mathvariant="normal">Λ</mi><msub><mrow></mrow><mi>n</mi></msub><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}&amp;P_{n}=\sum_{k=0}^{n-3}P_{n,k}t^{k}\in\Lambda_{n}[t],\quad\text{where }~P_{n,k}=\mathrm{ch}_{\mathbb{S}_{n}}H^{2k}(\overline{{\cal M}}_{0,n})\in\Lambda_{n};\\
&amp;Q_{n}=\sum_{k=0}^{n-2}Q_{n,k}t^{k}\in\Lambda_{n}[t],\quad\text{where }~Q_{n,k}=\mathrm{ch}_{\mathbb{S}_{n}}H^{2k}(\overline{{\cal M}}_{0,n+1})\in\Lambda_{n}.\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS1.p3.2" class="ltx_p">Moreover, we consider their generating series as</p>
<table id="S5.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex3.m1" class="ltx_Math" alttext="\begin{split}&amp;P=1+\mathsf{h}_{1}+\mathsf{h}_{2}+\sum_{n\geq 3}P_{n}\quad\in\Lambda\llbracket t\rrbracket=\prod_{n}\Lambda_{n}\llbracket t\rrbracket;\\
&amp;Q=1+\mathsf{h}_{1}+\sum_{n\geq 2}Q_{n}\quad\in\Lambda\llbracket t\rrbracket,\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>P</mi><mo>=</mo><mn>1</mn><mo>+</mo><mi>𝗁</mi><msub><mrow></mrow><mn>1</mn></msub><mo>+</mo><mi>𝗁</mi><msub><mrow></mrow><mn>2</mn></msub><mo rspace="0.055em">+</mo><mo movablelimits="false">∑</mo><msub><mrow></mrow><mrow><mi>n</mi><mo>≥</mo><mn>3</mn></mrow></msub><mi>P</mi><msub><mrow></mrow><mi>n</mi></msub><mo lspace="1.278em">∈</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">⟦</mo><mi>t</mi><mo stretchy="false">⟧</mo><mo rspace="0.111em">=</mo><mo movablelimits="false">∏</mo><msub><mrow></mrow><mi>n</mi></msub><mi mathvariant="normal">Λ</mi><msub><mrow></mrow><mi>n</mi></msub><mo stretchy="false">⟦</mo><mi>t</mi><mo stretchy="false">⟧</mo><mo>;</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>Q</mi><mo>=</mo><mn>1</mn><mo>+</mo><mi>𝗁</mi><msub><mrow></mrow><mn>1</mn></msub><mo rspace="0.055em">+</mo><mo movablelimits="false">∑</mo><msub><mrow></mrow><mrow><mi>n</mi><mo>≥</mo><mn>2</mn></mrow></msub><mi>Q</mi><msub><mrow></mrow><mi>n</mi></msub><mo lspace="1.278em">∈</mo><mi mathvariant="normal">Λ</mi><mo stretchy="false">⟦</mo><mi>t</mi><mo stretchy="false">⟧</mo><mo>,</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}&amp;P=1+\mathsf{h}_{1}+\mathsf{h}_{2}+\sum_{n\geq 3}P_{n}\quad\in\Lambda\llbracket t\rrbracket=\prod_{n}\Lambda_{n}\llbracket t\rrbracket;\\
&amp;Q=1+\mathsf{h}_{1}+\sum_{n\geq 2}Q_{n}\quad\in\Lambda\llbracket t\rrbracket,\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS1.p3.3" class="ltx_p">where we treat <math id="S5.SS1.p3.m4" class="ltx_Math" alttext="\overline{{\cal M}}_{0,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{{\cal M}}_{0,n}</annotation></semantics></math> as a point when <math id="S5.SS1.p3.m5" class="ltx_Math" alttext="0\leq n\leq 2" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mi>n</mi><mo>≤</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">0\leq n\leq 2</annotation></semantics></math>.</p>
</div>
<div id="S5.SS1.p4" class="ltx_para">
<p id="S5.SS1.p4.1" class="ltx_p">In <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib10" title="" class="ltx_ref">10</a>, <a href="#bib.bib11" title="" class="ltx_ref">11</a>]</cite>, we established formulas for <math id="S5.SS1.p4.m1" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> and <math id="S5.SS1.p4.m2" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> which were obtained in two stages:
(1) comparison of <math id="S5.SS1.p4.m3" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> and <math id="S5.SS1.p4.m4" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>, (2) computation of <math id="S5.SS1.p4.m5" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>.</p>
</div>
<div id="S5.SS1.p5" class="ltx_para ltx_noindent">
<p id="S5.SS1.p5.1" class="ltx_p"><span id="S5.SS1.p5.1.1" class="ltx_text ltx_underline">Stage 1</span>.
The relation between <math id="S5.SS1.p5.m1" class="ltx_Math" alttext="P_{n}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>n</mi></msub><annotation encoding="application/x-tex">P_{n}</annotation></semantics></math> and <math id="S5.SS1.p5.m2" class="ltx_Math" alttext="Q_{n}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mi>n</mi></msub><annotation encoding="application/x-tex">Q_{n}</annotation></semantics></math> is obtained in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib10" title="" class="ltx_ref">10</a>, §4]</cite> by the theory of <math id="S5.SS1.p5.m3" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>-stable quasimaps, developed in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">9</a>]</cite>, in a very special case which provides an <math id="S5.SS1.p5.m4" class="ltx_Math" alttext="\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathbb{S}_{n}</annotation></semantics></math>-equivariant factorization of the canonical forgetful morphism <math id="S5.SS1.p5.m5" class="ltx_Math" alttext="\overline{{\cal M}}_{0,n+1}\to\overline{{\cal M}}_{0,n}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">→</mo><msub><mover accent="true"><mi>ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\overline{{\cal M}}_{0,n+1}\to\overline{{\cal M}}_{0,n}</annotation></semantics></math> by blowups.
By the blowup formula and geometric invariant theory, we have the following.</p>
</div>
<div id="S5.Thmtheorem1" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem1.2" class="ltx_text ltx_font_bold">Theorem 5.1</span></span><span id="S5.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem1.p1" class="ltx_para">
<p id="S5.Thmtheorem1.p1.1" class="ltx_p"><cite class="ltx_cite ltx_citemacro_cite"><span id="S5.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">[</span><a href="#bib.bib10" title="" class="ltx_ref">10</a><span id="S5.Thmtheorem1.p1.1.2" class="ltx_text ltx_font_italic">, Theorem 4.8]</span></cite><span id="S5.Thmtheorem1.p1.1.3" class="ltx_text ltx_font_italic"> 
For <math id="S5.Thmtheorem1.p1.m1" class="ltx_Math" alttext="n\geq 3" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">n\geq 3</annotation></semantics></math>,</span></p>
<table id="S5.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex4.m1" class="ltx_Math" alttext="(1+t)P_{n}=Q_{n}-t\left(\sum_{2\leq h&lt;\frac{n}{2}}Q_{h}Q_{n-h}+\mathsf{s}_{(1,1)}\circ Q_{\frac{n}{2}}\right)" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>n</mi></msub></mrow><mo>=</mo><mrow><msub><mi>Q</mi><mi>n</mi></msub><mo>−</mo><mrow><mi>t</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mrow><mn>2</mn><mo>≤</mo><mi>h</mi><mo>&lt;</mo><mfrac><mi>n</mi><mn>2</mn></mfrac></mrow></munder><mrow><msub><mi>Q</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>Q</mi><mrow><mi>n</mi><mo>−</mo><mi>h</mi></mrow></msub></mrow></mrow><mo>+</mo><mrow><msub><mi>𝗌</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>Q</mi><mfrac><mi>n</mi><mn>2</mn></mfrac></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">(1+t)P_{n}=Q_{n}-t\left(\sum_{2\leq h&lt;\frac{n}{2}}Q_{h}Q_{n-h}+\mathsf{s}_{(1,1)}\circ Q_{\frac{n}{2}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmtheorem1.p1.2" class="ltx_p"><span id="S5.Thmtheorem1.p1.2.1" class="ltx_text ltx_font_italic">where we set <math id="S5.Thmtheorem1.p1.m2" class="ltx_Math" alttext="Q_{\frac{n}{2}}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mfrac><mi>n</mi><mn>2</mn></mfrac></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">Q_{\frac{n}{2}}=0</annotation></semantics></math> for <math id="S5.Thmtheorem1.p1.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> odd. Equivalently, the generating series <math id="S5.Thmtheorem1.p1.m4" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> and <math id="S5.Thmtheorem1.p1.m5" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> satisfy (cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib11" title="" class="ltx_ref">11</a>, Corollary 3.3]</cite>)</span></p>
<table id="S5.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex5.m1" class="ltx_Math" alttext="(1+t)P=(1+t+\mathsf{h}_{1}t)Q-t\mathsf{s}_{(1,1)}\circ Q." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>P</mi></mrow><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi><mo>+</mo><mrow><msub><mi>𝗁</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow><mo>−</mo><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝗌</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msub></mrow><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>Q</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(1+t)P=(1+t+\mathsf{h}_{1}t)Q-t\mathsf{s}_{(1,1)}\circ Q.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S5.SS1.p6" class="ltx_para ltx_noindent">
<p id="S5.SS1.p6.1" class="ltx_p"><span id="S5.SS1.p6.1.1" class="ltx_text ltx_underline">Stage 2</span>.
The combinatorial formula for <math id="S5.SS1.p6.m1" class="ltx_Math" alttext="Q_{n}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mi>n</mi></msub><annotation encoding="application/x-tex">Q_{n}</annotation></semantics></math> in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib10" title="" class="ltx_ref">10</a>]</cite> is derived from the well-known <math id="S5.SS1.p6.m2" class="ltx_Math" alttext="\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathbb{S}_{n}</annotation></semantics></math>-equivariant factorization of the Kapranov map</p>
<table id="S5.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex6.m1" class="ltx_Math" alttext="\overline{{\cal M}}_{0,n+1}\longrightarrow\mathbb{P}^{n-2}" display="block" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">⟶</mo><msup><mi>ℙ</mi><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\overline{{\cal M}}_{0,n+1}\longrightarrow\mathbb{P}^{n-2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS1.p6.2" class="ltx_p">by a sequence of blowups. This corresponds to a realization of <math id="S5.SS1.p6.m3" class="ltx_Math" alttext="\overline{{\cal M}}_{0,n+1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><annotation encoding="application/x-tex">\overline{{\cal M}}_{0,n+1}</annotation></semantics></math> as the wonderful compactification of the complement of the braid hyperplane arrangement
<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib18" title="" class="ltx_ref">18</a>]</cite>.
The challenging task of tracking all the blowup centers is accomplished by the combinatorics of weighted rooted trees.</p>
</div>
<div id="S5.Thmtheorem2" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem2.2" class="ltx_text ltx_font_bold">Definition 5.2</span></span><span id="S5.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem2.p1" class="ltx_para">
<p id="S5.Thmtheorem2.p1.1" class="ltx_p"><cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib11" title="" class="ltx_ref">11</a>, Definition 3.5]</cite>
A <em id="S5.Thmtheorem2.p1.1.1" class="ltx_emph ltx_font_italic">labeled rooted tree</em>
is a tree with one distinguished leg called, the <em id="S5.Thmtheorem2.p1.1.2" class="ltx_emph ltx_font_italic">output</em>, and additional <math id="S5.Thmtheorem2.p1.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> legs, called the <em id="S5.Thmtheorem2.p1.1.3" class="ltx_emph ltx_font_italic">inputs</em>, labeled by <math id="S5.Thmtheorem2.p1.m2" class="ltx_Math" alttext="1,\cdots,n" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">1,\cdots,n</annotation></semantics></math>, for some <math id="S5.Thmtheorem2.p1.m3" class="ltx_Math" alttext="n\in\mathbb{Z}_{\geq 0}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>∈</mo><msub><mi>ℤ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">n\in\mathbb{Z}_{\geq 0}</annotation></semantics></math>. The vertex to which the output is attached is called the <em id="S5.Thmtheorem2.p1.1.4" class="ltx_emph ltx_font_italic">root</em>.</p>
</div>
<div id="S5.Thmtheorem2.p2" class="ltx_para">
<p id="S5.Thmtheorem2.p2.1" class="ltx_p">More concretely, a labeled rooted tree is a triple of a tree <math id="S5.Thmtheorem2.p2.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>, the output map <math id="S5.Thmtheorem2.p2.m2" class="ltx_Math" alttext="\mathrm{pt}\to V(T)" display="inline" intent=":literal"><semantics><mrow><mi>pt</mi><mo stretchy="false">→</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{pt}\to V(T)</annotation></semantics></math> and the input map <math id="S5.Thmtheorem2.p2.m3" class="ltx_Math" alttext="\{1,\cdots,n\}\to V(T)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>n</mi></mrow><mo stretchy="false">}</mo></mrow><mo stretchy="false">→</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\{1,\cdots,n\}\to V(T)</annotation></semantics></math>, where <math id="S5.Thmtheorem2.p2.m4" class="ltx_Math" alttext="V(T)" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V(T)</annotation></semantics></math> is the set of vertices of <math id="S5.Thmtheorem2.p2.m5" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>. In particular, permuting the labels of the inputs attached to the same vertex does not distinguish the labeled rooted tree.</p>
</div>
<div id="S5.Thmtheorem2.p3" class="ltx_para">
<p id="S5.Thmtheorem2.p3.1" class="ltx_p">A <em id="S5.Thmtheorem2.p3.1.1" class="ltx_emph ltx_font_italic">rooted tree</em> is a tree obtained from a labeled rooted tree by forgetting the labels on the inputs.</p>
</div>
</div>
<div id="S5.Thmtheorem3" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem3.2" class="ltx_text ltx_font_bold">Definition 5.3</span></span><span id="S5.Thmtheorem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem3.p1" class="ltx_para">
<p id="S5.Thmtheorem3.p1.1" class="ltx_p">Let <math id="S5.Thmtheorem3.p1.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> be a (resp. labeled) rooted tree. A <em id="S5.Thmtheorem3.p1.1.1" class="ltx_emph ltx_font_italic">weight function</em> on <math id="S5.Thmtheorem3.p1.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> is a function <math id="S5.Thmtheorem3.p1.m3" class="ltx_Math" alttext="w:V(T)\to\mathbb{Z}_{\geq 0}" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><msub><mi>ℤ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">w:V(T)\to\mathbb{Z}_{\geq 0}</annotation></semantics></math> on the vertex set <math id="S5.Thmtheorem3.p1.m4" class="ltx_Math" alttext="V(T)" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V(T)</annotation></semantics></math>. We denote the total weight by <math id="S5.Thmtheorem3.p1.m5" class="ltx_Math" alttext="\lvert w\rvert=\sum_{v\in V(T)}w(v)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>w</mi><mo stretchy="false">|</mo></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\lvert w\rvert=\sum_{v\in V(T)}w(v)</annotation></semantics></math>.</p>
</div>
<div id="S5.Thmtheorem3.p2" class="ltx_para">
<p id="S5.Thmtheorem3.p2.1" class="ltx_p">We call the pair <math id="S5.Thmtheorem3.p2.m1" class="ltx_Math" alttext="(T,w)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(T,w)</annotation></semantics></math> a (resp. <em id="S5.Thmtheorem3.p2.1.1" class="ltx_emph ltx_font_italic">labeled</em>) <em id="S5.Thmtheorem3.p2.1.2" class="ltx_emph ltx_font_italic">weighted rooted tree</em>.</p>
</div>
</div>
<div id="S5.Thmtheorem4" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem4.2" class="ltx_text ltx_font_bold">Definition 5.4</span></span><span id="S5.Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem4.p1" class="ltx_para">
<p id="S5.Thmtheorem4.p1.1" class="ltx_p">For <math id="S5.Thmtheorem4.p1.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> and <math id="S5.Thmtheorem4.p1.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> in <math id="S5.Thmtheorem4.p1.m3" class="ltx_Math" alttext="\mathbb{Z}_{\geq 0}" display="inline" intent=":literal"><semantics><msub><mi>ℤ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">\mathbb{Z}_{\geq 0}</annotation></semantics></math>, we define <math id="S5.Thmtheorem4.p1.m4" class="ltx_Math" alttext="\mathscr{T}_{n,k}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">𝒯</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">\mathscr{T}_{n,k}</annotation></semantics></math> (resp. <math id="S5.Thmtheorem4.p1.m5" class="ltx_Math" alttext="\mathscr{T}_{n,k}^{\mathrm{lab}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathscript">𝒯</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow><mi>lab</mi></msubsup><annotation encoding="application/x-tex">\mathscr{T}_{n,k}^{\mathrm{lab}}</annotation></semantics></math>) to be the set of
(resp. labeled) weighted rooted trees <math id="S5.Thmtheorem4.p1.m6" class="ltx_Math" alttext="(T,w)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(T,w)</annotation></semantics></math>
with <math id="S5.Thmtheorem4.p1.m7" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> inputs and
total weight <math id="S5.Thmtheorem4.p1.m8" class="ltx_Math" alttext="\lvert w\rvert=k" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>w</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">\lvert w\rvert=k</annotation></semantics></math>, that satisfy the following <em id="S5.Thmtheorem4.p1.1.1" class="ltx_emph ltx_font_italic">valency conditions</em>:</p>
<ol id="S5.I1" class="ltx_enumerate">
<li id="S5.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S5.I1.i1.p1" class="ltx_para">
<p id="S5.I1.i1.p1.1" class="ltx_p"><math id="S5.I1.i1.p1.m1" class="ltx_Math" alttext="0\leq w(v)\leq\mathrm{val}(v)-3" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mi>val</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mn>3</mn></mrow></mrow><annotation encoding="application/x-tex">0\leq w(v)\leq\mathrm{val}(v)-3</annotation></semantics></math> if <math id="S5.I1.i1.p1.m2" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> is the root;</p>
</div></li>
<li id="S5.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S5.I1.i2.p1" class="ltx_para">
<p id="S5.I1.i2.p1.1" class="ltx_p"><math id="S5.I1.i2.p1.m1" class="ltx_Math" alttext="0&lt;w(v)\leq\mathrm{val}(v)-3" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mi>val</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mn>3</mn></mrow></mrow><annotation encoding="application/x-tex">0&lt;w(v)\leq\mathrm{val}(v)-3</annotation></semantics></math> if <math id="S5.I1.i2.p1.m2" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> is not the root.</p>
</div></li>
</ol>
<p id="S5.Thmtheorem4.p1.2" class="ltx_p">There is a natural <math id="S5.Thmtheorem4.p1.m9" class="ltx_Math" alttext="\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathbb{S}_{n}</annotation></semantics></math>-action on <math id="S5.Thmtheorem4.p1.m10" class="ltx_Math" alttext="\mathscr{T}_{n,k}^{\mathrm{lab}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathscript">𝒯</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow><mi>lab</mi></msubsup><annotation encoding="application/x-tex">\mathscr{T}_{n,k}^{\mathrm{lab}}</annotation></semantics></math> reordering labels and <math id="S5.Thmtheorem4.p1.m11" class="ltx_Math" alttext="\mathscr{T}_{n,k}=\mathscr{T}_{n,k}^{\mathrm{lab}}/\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒯</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>=</mo><mrow><msubsup><mi class="ltx_font_mathscript">𝒯</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow><mi>lab</mi></msubsup><mo>/</mo><msub><mi>𝕊</mi><mi>n</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\mathscr{T}_{n,k}=\mathscr{T}_{n,k}^{\mathrm{lab}}/\mathbb{S}_{n}</annotation></semantics></math>.</p>
</div>
</div>
<div id="S5.Thmtheorem5" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem5.2" class="ltx_text ltx_font_bold">Proposition 5.5</span></span><span id="S5.Thmtheorem5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem5.p1" class="ltx_para">
<p id="S5.Thmtheorem5.p1.1" class="ltx_p"><cite class="ltx_cite ltx_citemacro_cite"><span id="S5.Thmtheorem5.p1.1.1" class="ltx_text ltx_font_italic">[</span><a href="#bib.bib10" title="" class="ltx_ref">10</a><span id="S5.Thmtheorem5.p1.1.2" class="ltx_text ltx_font_italic">, Proposition 5.12]</span></cite><span id="S5.Thmtheorem5.p1.1.3" class="ltx_text ltx_font_italic">
The <math id="S5.Thmtheorem5.p1.m1" class="ltx_Math" alttext="\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathbb{S}_{n}</annotation></semantics></math>-representation <math id="S5.Thmtheorem5.p1.m2" class="ltx_Math" alttext="H^{2k}(\overline{{\cal M}}_{0,n+1})" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi mathvariant="normal">ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H^{2k}(\overline{{\cal M}}_{0,n+1})</annotation></semantics></math> is a permutation representation with an <math id="S5.Thmtheorem5.p1.m3" class="ltx_Math" alttext="\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathbb{S}_{n}</annotation></semantics></math>-basis isomorphic to <math id="S5.Thmtheorem5.p1.m4" class="ltx_Math" alttext="\mathscr{T}_{n,k}^{\mathrm{lab}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathscript">𝒯</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow><mi>lab</mi></msubsup><annotation encoding="application/x-tex">\mathscr{T}_{n,k}^{\mathrm{lab}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S5.SS1.p7" class="ltx_para">
<p id="S5.SS1.p7.1" class="ltx_p">We decompose this permutation representation into transitive permutation representations <math id="S5.SS1.p7.m1" class="ltx_Math" alttext="U_{H}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mi>H</mi></msub><annotation encoding="application/x-tex">U_{H}</annotation></semantics></math> in Example <a href="#S3.Thmtheorem14" title="Example 3.14 (Permutation representations). ‣ 3.5. First examples ‣ 3. Characteristic polynomials of symmetric functions and representations ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.14</span></a> as follows.</p>
</div>
<div id="S5.Thmtheorem6" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem6.2" class="ltx_text ltx_font_bold">Definition 5.6</span></span><span id="S5.Thmtheorem6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem6.p1" class="ltx_para">
<p id="S5.Thmtheorem6.p1.1" class="ltx_p">For <math id="S5.Thmtheorem6.p1.m1" class="ltx_Math" alttext="(T,w)\in\mathscr{T}_{n,k}^{\mathrm{lab}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msubsup><mi class="ltx_font_mathscript">𝒯</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow><mi>lab</mi></msubsup></mrow><annotation encoding="application/x-tex">(T,w)\in\mathscr{T}_{n,k}^{\mathrm{lab}}</annotation></semantics></math>, we denote by <math id="S5.Thmtheorem6.p1.m2" class="ltx_Math" alttext="\mathrm{Stab}(T,w)" display="inline" intent=":literal"><semantics><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Stab}(T,w)</annotation></semantics></math> the stabilizer subgroup of <math id="S5.Thmtheorem6.p1.m3" class="ltx_Math" alttext="(T,w)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(T,w)</annotation></semantics></math> in <math id="S5.Thmtheorem6.p1.m4" class="ltx_Math" alttext="\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathbb{S}_{n}</annotation></semantics></math>, that is the subgroup consisting of permutations of labels that preserves the isomorphism class of <math id="S5.Thmtheorem6.p1.m5" class="ltx_Math" alttext="(T,w)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(T,w)</annotation></semantics></math> as a labeled weighted rooted tree. We define</p>
<table id="S5.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(5.1)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E1.m1" class="ltx_Math" alttext="U_{(T,w)}=U_{\mathrm{Stab}(T,w)}" display="block" intent=":literal"><semantics><mrow><msub><mi>U</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></msub><mo>=</mo><msub><mi>U</mi><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">U_{(T,w)}=U_{\mathrm{Stab}(T,w)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmtheorem6.p1.2" class="ltx_p">using the notation of (<a href="#S3.E18" title="In Example 3.14 (Permutation representations). ‣ 3.5. First examples ‣ 3. Characteristic polynomials of symmetric functions and representations ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.18</span></a>).
For <math id="S5.Thmtheorem6.p1.m6" class="ltx_Math" alttext="(T,w)\in\mathscr{T}_{n,k}=\mathscr{T}_{n,k}^{\mathrm{lab}}/\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathscript">𝒯</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>=</mo><mrow><msubsup><mi class="ltx_font_mathscript">𝒯</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow><mi>lab</mi></msubsup><mo>/</mo><msub><mi>𝕊</mi><mi>n</mi></msub></mrow></mrow><annotation encoding="application/x-tex">(T,w)\in\mathscr{T}_{n,k}=\mathscr{T}_{n,k}^{\mathrm{lab}}/\mathbb{S}_{n}</annotation></semantics></math>, we define <math id="S5.Thmtheorem6.p1.m7" class="ltx_Math" alttext="\mathrm{Stab}(T,w)" display="inline" intent=":literal"><semantics><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Stab}(T,w)</annotation></semantics></math> and <math id="S5.Thmtheorem6.p1.m8" class="ltx_Math" alttext="U_{(T,w)}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">U_{(T,w)}</annotation></semantics></math> similarly by taking any lift in <math id="S5.Thmtheorem6.p1.m9" class="ltx_Math" alttext="\mathscr{T}_{n,k}^{\mathrm{lab}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathscript">𝒯</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow><mi>lab</mi></msubsup><annotation encoding="application/x-tex">\mathscr{T}_{n,k}^{\mathrm{lab}}</annotation></semantics></math>.</p>
</div>
</div>
<div id="S5.SS1.p8" class="ltx_para">
<p id="S5.SS1.p8.1" class="ltx_p">Note that the subgroup <math id="S5.SS1.p8.m1" class="ltx_Math" alttext="\mathrm{Stab}(T,w)\subset\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><msub><mi>𝕊</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\mathrm{Stab}(T,w)\subset\mathbb{S}_{n}</annotation></semantics></math> is well defined up to conjugation and <math id="S5.SS1.p8.m2" class="ltx_Math" alttext="U_{(T,w)}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">U_{(T,w)}</annotation></semantics></math> is well defined as an <math id="S5.SS1.p8.m3" class="ltx_Math" alttext="\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathbb{S}_{n}</annotation></semantics></math>-representation.</p>
</div>
<div id="S5.SS1.p9" class="ltx_para">
<p id="S5.SS1.p9.1" class="ltx_p">For convenience, we will sometimes omit <math id="S5.SS1.p9.m1" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> in our notation, and write <math id="S5.SS1.p9.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>, <math id="S5.SS1.p9.m3" class="ltx_Math" alttext="\mathrm{Stab}(T)" display="inline" intent=":literal"><semantics><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Stab}(T)</annotation></semantics></math> and <math id="S5.SS1.p9.m4" class="ltx_Math" alttext="U_{T}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mi>T</mi></msub><annotation encoding="application/x-tex">U_{T}</annotation></semantics></math> for <math id="S5.SS1.p9.m5" class="ltx_Math" alttext="(T,w)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(T,w)</annotation></semantics></math>, <math id="S5.SS1.p9.m6" class="ltx_Math" alttext="\mathrm{Stab}(T,w)" display="inline" intent=":literal"><semantics><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Stab}(T,w)</annotation></semantics></math> and <math id="S5.SS1.p9.m7" class="ltx_Math" alttext="U_{(T,w)}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">U_{(T,w)}</annotation></semantics></math> respectively.</p>
</div>
<div id="S5.Thmtheorem7" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem7.2" class="ltx_text ltx_font_bold">Example 5.7</span></span><span id="S5.Thmtheorem7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem7.p1" class="ltx_para">
<p id="S5.Thmtheorem7.p1.1" class="ltx_p">Suppose that <math id="S5.Thmtheorem7.p1.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> has only one vertex, namely the root, and all the <math id="S5.Thmtheorem7.p1.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> inputs are attached to the root. Then <math id="S5.Thmtheorem7.p1.m3" class="ltx_Math" alttext="\mathrm{Stab}(T)\cong\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><msub><mi>𝕊</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\mathrm{Stab}(T)\cong\mathbb{S}_{n}</annotation></semantics></math>.</p>
</div>
</div>
<div id="S5.Thmtheorem8" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem8.2" class="ltx_text ltx_font_bold">Example 5.8</span></span><span id="S5.Thmtheorem8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem8.p1" class="ltx_para">
<p id="S5.Thmtheorem8.p1.1" class="ltx_p">Suppose that <math id="S5.Thmtheorem8.p1.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> has only two vertices with <math id="S5.Thmtheorem8.p1.m2" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> inputs attached to the root and the remaining <math id="S5.Thmtheorem8.p1.m3" class="ltx_Math" alttext="n-a" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>−</mo><mi>a</mi></mrow><annotation encoding="application/x-tex">n-a</annotation></semantics></math> inputs attached to the other non-root vertex. Then, <math id="S5.Thmtheorem8.p1.m4" class="ltx_Math" alttext="\mathrm{Stab}(T)\cong\mathbb{S}_{a}\times\mathbb{S}_{n-a}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msub><mi>𝕊</mi><mi>a</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝕊</mi><mrow><mi>n</mi><mo>−</mo><mi>a</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Stab}(T)\cong\mathbb{S}_{a}\times\mathbb{S}_{n-a}</annotation></semantics></math>.</p>
</div>
</div>
<div id="S5.Thmtheorem9" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem9.2" class="ltx_text ltx_font_bold">Example 5.9</span></span><span id="S5.Thmtheorem9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem9.p1" class="ltx_para">
<p id="S5.Thmtheorem9.p1.1" class="ltx_p">Suppose that <math id="S5.Thmtheorem9.p1.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> has three vertices where both non-root vertices are adjacent to the root and have weight one. Suppose further that to each non-root vertex, <math id="S5.Thmtheorem9.p1.m2" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> inputs are attached and the remaining <math id="S5.Thmtheorem9.p1.m3" class="ltx_Math" alttext="n-2a" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></mrow><annotation encoding="application/x-tex">n-2a</annotation></semantics></math> vertices are attached to the root. Then, <math id="S5.Thmtheorem9.p1.m4" class="ltx_Math" alttext="\mathrm{Stab}(T)\cong\mathbb{S}_{n-2a}\times((\mathbb{S}_{a}\times\mathbb{S}_{a})\rtimes\mathbb{S}_{2})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msub><mi>𝕊</mi><mrow><mi>n</mi><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝕊</mi><mi>a</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝕊</mi><mi>a</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋊</mo><msub><mi>𝕊</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Stab}(T)\cong\mathbb{S}_{n-2a}\times((\mathbb{S}_{a}\times\mathbb{S}_{a})\rtimes\mathbb{S}_{2})</annotation></semantics></math>.</p>
</div>
</div>
<div id="S5.SS1.p10" class="ltx_para">
<p id="S5.SS1.p10.1" class="ltx_p">Proposition <a href="#S5.Thmtheorem5" title="Proposition 5.5. ‣ 5.1. Recursive formulas for the representations ‣ 5. Characteristic polynomial of ℳ̄_{0,𝑛} ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.5</span></a> now reads as</p>
<table id="S5.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex7.m1" class="ltx_Math" alttext="Q_{n,k}=\sum_{T\in\mathscr{T}_{n,k}}\mathrm{ch}_{\mathbb{S}_{n}}U_{T}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>Q</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow></msub><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>T</mi><mo>∈</mo><msub><mi class="ltx_font_mathscript">𝒯</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow></msub></mrow></munder><mrow><msub><mi>ch</mi><msub><mi>𝕊</mi><mi>n</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>U</mi><mi>T</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Q_{n,k}=\sum_{T\in\mathscr{T}_{n,k}}\mathrm{ch}_{\mathbb{S}_{n}}U_{T}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS1.p10.2" class="ltx_p">Combining Theorem <a href="#S5.Thmtheorem1" title="Theorem 5.1. ‣ 5.1. Recursive formulas for the representations ‣ 5. Characteristic polynomial of ℳ̄_{0,𝑛} ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a> and Proposition <a href="#S5.Thmtheorem5" title="Proposition 5.5. ‣ 5.1. Recursive formulas for the representations ‣ 5. Characteristic polynomial of ℳ̄_{0,𝑛} ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.5</span></a>, we obtain formulas computing <math id="S5.SS1.p10.m1" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> and <math id="S5.SS1.p10.m2" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> in terms of weighted rooted trees.</p>
</div>
<div id="S5.SS1.p11" class="ltx_para">
<p id="S5.SS1.p11.1" class="ltx_p">For actual computations however, the combinatorial complexity of weighted rooted trees grows quickly as <math id="S5.SS1.p11.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> increases. As a remedy, in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib11" title="" class="ltx_ref">11</a>]</cite>, a natural recursive structure on <math id="S5.SS1.p11.m2" class="ltx_Math" alttext="\mathscr{T}_{n,k}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">𝒯</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">\mathscr{T}_{n,k}</annotation></semantics></math> is observed, which leads to recursive formulas for computing <math id="S5.SS1.p11.m3" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> and <math id="S5.SS1.p11.m4" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>.</p>
</div>
<div id="S5.SS1.p12" class="ltx_para">
<p id="S5.SS1.p12.1" class="ltx_p">Let <math id="S5.SS1.p12.m1" class="ltx_Math" alttext="\mathscr{T}_{n,k}^{+}\subset\mathscr{T}_{n,k}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathscript">𝒯</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow><mo>+</mo></msubsup><mo>⊂</mo><msub><mi class="ltx_font_mathscript">𝒯</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathscr{T}_{n,k}^{+}\subset\mathscr{T}_{n,k}</annotation></semantics></math> be the subset consisting of weighted rooted trees that have positive weights at the root. Let <math id="S5.SS1.p12.m2" class="ltx_Math" alttext="Q_{1}^{+}=h_{1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Q</mi><mn>1</mn><mo>+</mo></msubsup><mo>=</mo><msub><mi>h</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">Q_{1}^{+}=h_{1}</annotation></semantics></math> and for <math id="S5.SS1.p12.m3" class="ltx_Math" alttext="n\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">n\geq 2</annotation></semantics></math>,</p>
<table id="S5.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex8.m1" class="ltx_Math" alttext="Q_{n}^{+}=\sum_{k=0}^{n-2}Q_{n,k}^{+}t^{k},\quad\text{ where }~Q_{n,k}^{+}=\sum_{T\in\mathscr{T}_{n,k}^{+}}\mathrm{ch}_{\mathbb{S}_{n}}U_{T}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>Q</mi><mi>n</mi><mo>+</mo></msubsup><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></munderover><mrow><msubsup><mi>Q</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>t</mi><mi>k</mi></msup></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mtext> where </mtext><mo lspace="0.330em" rspace="0em">​</mo><msubsup><mi>Q</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow><mo>+</mo></msubsup></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>T</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathscript">𝒯</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow><mo>+</mo></msubsup></mrow></munder><mrow><msub><mi>ch</mi><msub><mi>𝕊</mi><mi>n</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>U</mi><mi>T</mi></msub></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Q_{n}^{+}=\sum_{k=0}^{n-2}Q_{n,k}^{+}t^{k},\quad\text{ where }~Q_{n,k}^{+}=\sum_{T\in\mathscr{T}_{n,k}^{+}}\mathrm{ch}_{\mathbb{S}_{n}}U_{T}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS1.p12.2" class="ltx_p">Consider its generating series</p>
<table id="S5.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex9.m1" class="ltx_Math" alttext="Q^{+}=Q_{1}^{+}+\sum_{n\geq 2}Q_{n}^{+}\quad\in\Lambda\llbracket t\rrbracket." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>Q</mi><mo>+</mo></msup><mo>=</mo><mrow><msubsup><mi>Q</mi><mn>1</mn><mo>+</mo></msubsup><mo rspace="0.055em">+</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>≥</mo><mn>2</mn></mrow></munder><msubsup><mi>Q</mi><mi>n</mi><mo>+</mo></msubsup></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mphantom></mphantom><mo>∈</mo><mrow><mi mathvariant="normal">Λ</mi><mo>⁡</mo><mrow><mo stretchy="false">⟦</mo><mi>t</mi><mo stretchy="false">⟧</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Q^{+}=Q_{1}^{+}+\sum_{n\geq 2}Q_{n}^{+}\quad\in\Lambda\llbracket t\rrbracket.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S5.Thmtheorem10" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem10.2" class="ltx_text ltx_font_bold">Theorem 5.10</span></span><span id="S5.Thmtheorem10.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem10.p1" class="ltx_para">
<p id="S5.Thmtheorem10.p1.1" class="ltx_p"><cite class="ltx_cite ltx_citemacro_cite"><span id="S5.Thmtheorem10.p1.1.1" class="ltx_text ltx_font_italic">[</span><a href="#bib.bib11" title="" class="ltx_ref">11</a><span id="S5.Thmtheorem10.p1.1.2" class="ltx_text ltx_font_italic">, Theorem 4.7]</span></cite><span id="S5.Thmtheorem10.p1.1.3" class="ltx_text ltx_font_italic">
<math id="S5.Thmtheorem10.p1.m1" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> is the plethystic exponential of <math id="S5.Thmtheorem10.p1.m2" class="ltx_Math" alttext="Q^{+}" display="inline" intent=":literal"><semantics><msup><mi>Q</mi><mo>+</mo></msup><annotation encoding="application/x-tex">Q^{+}</annotation></semantics></math>:</span></p>
<table id="S5.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex10.m1" class="ltx_Math" alttext="Q=\Exp(Q^{+})=\sum_{r\geq 0}\mathsf{h}_{r}\circ Q^{+}." display="block" intent=":literal"><semantics><mrow><mrow><mi>Q</mi><mo>=</mo><mrow><mi>Exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>Q</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>r</mi><mo>≥</mo><mn>0</mn></mrow></munder><msub><mi>𝗁</mi><mi>r</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>Q</mi><mo>+</mo></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Q=\Exp(Q^{+})=\sum_{r\geq 0}\mathsf{h}_{r}\circ Q^{+}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmtheorem10.p1.2" class="ltx_p"><span id="S5.Thmtheorem10.p1.2.1" class="ltx_text ltx_font_italic">Consequently, <math id="S5.Thmtheorem10.p1.m3" class="ltx_Math" alttext="Q^{+}" display="inline" intent=":literal"><semantics><msup><mi>Q</mi><mo>+</mo></msup><annotation encoding="application/x-tex">Q^{+}</annotation></semantics></math> is determined by the formulas (cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib11" title="" class="ltx_ref">11</a>, Corollary 4.9]</cite>)</span></p>
<table id="S5.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex11.m1" class="ltx_Math" alttext="\begin{split}\mathrm{(Recursive)}\quad&amp;Q^{+}=\mathsf{h}_{1}+\sum_{r\geq 3}\left(\sum_{i=1}^{r-2}t^{i}\right)(\mathsf{h}_{r}\circ Q^{+}),\\
\mathrm{(Exponential)}\quad&amp;\Exp(tQ^{+})=t^{2}\Exp(Q^{+})+(1-t)(1+t+\mathsf{h}_{1}t).\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mo stretchy="false">(</mo><mi>Recursive</mi><mo stretchy="false">)</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msup><mi>Q</mi><mo>+</mo></msup><mo>=</mo><mrow><msub><mi>𝗁</mi><mn>1</mn></msub><mo rspace="0.055em">+</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>r</mi><mo>≥</mo><mn>3</mn></mrow></munder><mrow><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>r</mi><mo>−</mo><mn>2</mn></mrow></munderover><msup><mi>t</mi><mi>i</mi></msup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝗁</mi><mi>r</mi></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>Q</mi><mo>+</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mo stretchy="false">(</mo><mi>Exponential</mi><mo stretchy="false">)</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mi>Exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>Q</mi><mo>+</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>t</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>Q</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi><mo>+</mo><mrow><msub><mi>𝗁</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\mathrm{(Recursive)}\quad&amp;Q^{+}=\mathsf{h}_{1}+\sum_{r\geq 3}\left(\sum_{i=1}^{r-2}t^{i}\right)(\mathsf{h}_{r}\circ Q^{+}),\\
\mathrm{(Exponential)}\quad&amp;\Exp(tQ^{+})=t^{2}\Exp(Q^{+})+(1-t)(1+t+\mathsf{h}_{1}t).\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmtheorem10.p1.3" class="ltx_p"><span id="S5.Thmtheorem10.p1.3.1" class="ltx_text ltx_font_italic">More explicitly, <math id="S5.Thmtheorem10.p1.m4" class="ltx_Math" alttext="Q_{n}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mi>n</mi></msub><annotation encoding="application/x-tex">Q_{n}</annotation></semantics></math> and <math id="S5.Thmtheorem10.p1.m5" class="ltx_Math" alttext="Q_{n}^{+}" display="inline" intent=":literal"><semantics><msubsup><mi>Q</mi><mi>n</mi><mo>+</mo></msubsup><annotation encoding="application/x-tex">Q_{n}^{+}</annotation></semantics></math> are determined by</span></p>
<table id="S5.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex12.m1" class="ltx_Math" alttext="\begin{split}Q_{n}^{+}&amp;=\sum_{\lambda\vdash n}\left(\sum_{i=1}^{\ell(\lambda)-2}t^{i}\right)\prod_{j=1}^{m}\left(\mathsf{h}_{r_{j}}\circ Q_{n_{j}}^{+}\right)Q_{n}=\sum_{\lambda\vdash n}\prod_{j=1}^{m}\left(\mathsf{h}_{r_{j}}\circ Q_{n_{j}}^{+}\right)\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true"><mtr><mtd class="ltx_align_right" columnalign="right"><msubsup><mi>Q</mi><mi>n</mi><mo>+</mo></msubsup></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>λ</mi><mo>⊢</mo><mi>n</mi></mrow></munder><mrow><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mn>2</mn></mrow></munderover><msup><mi>t</mi><mi>i</mi></msup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∏</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><mrow><mrow><mo>(</mo><mrow><msub><mi>𝗁</mi><msub><mi>r</mi><mi>j</mi></msub></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi>Q</mi><msub><mi>n</mi><mi>j</mi></msub><mo>+</mo></msubsup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>Q</mi><mi>n</mi></msub></mrow></mrow></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>λ</mi><mo>⊢</mo><mi>n</mi></mrow></munder><mrow><munderover><mo movablelimits="false" rspace="0em">∏</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><mrow><mo>(</mo><mrow><msub><mi>𝗁</mi><msub><mi>r</mi><mi>j</mi></msub></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi>Q</mi><msub><mi>n</mi><mi>j</mi></msub><mo>+</mo></msubsup></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}Q_{n}^{+}&amp;=\sum_{\lambda\vdash n}\left(\sum_{i=1}^{\ell(\lambda)-2}t^{i}\right)\prod_{j=1}^{m}\left(\mathsf{h}_{r_{j}}\circ Q_{n_{j}}^{+}\right)Q_{n}=\sum_{\lambda\vdash n}\prod_{j=1}^{m}\left(\mathsf{h}_{r_{j}}\circ Q_{n_{j}}^{+}\right)\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmtheorem10.p1.4" class="ltx_p"><span id="S5.Thmtheorem10.p1.4.1" class="ltx_text ltx_font_italic">for <math id="S5.Thmtheorem10.p1.m6" class="ltx_Math" alttext="n\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">n\geq 2</annotation></semantics></math>, where <math id="S5.Thmtheorem10.p1.m7" class="ltx_Math" alttext="n_{j}" display="inline" intent=":literal"><semantics><msub><mi>n</mi><mi>j</mi></msub><annotation encoding="application/x-tex">n_{j}</annotation></semantics></math> denote the parts of <math id="S5.Thmtheorem10.p1.m8" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> with multiplicities <math id="S5.Thmtheorem10.p1.m9" class="ltx_Math" alttext="r_{j}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>j</mi></msub><annotation encoding="application/x-tex">r_{j}</annotation></semantics></math> so that <math id="S5.Thmtheorem10.p1.m10" class="ltx_Math" alttext="\lambda=(n_{1}^{r_{1}},\cdots,n_{m}^{r_{m}})" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>n</mi><mn>1</mn><msub><mi>r</mi><mn>1</mn></msub></msubsup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msubsup><mi>n</mi><mi>m</mi><msub><mi>r</mi><mi>m</mi></msub></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda=(n_{1}^{r_{1}},\cdots,n_{m}^{r_{m}})</annotation></semantics></math> with <math id="S5.Thmtheorem10.p1.m11" class="ltx_Math" alttext="n_{1}&gt;\cdots&gt;n_{m}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mn>1</mn></msub><mo rspace="0.1389em">&gt;</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">&gt;</mo><msub><mi>n</mi><mi>m</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n_{1}&gt;\cdots&gt;n_{m}&gt;0</annotation></semantics></math>
and <math id="S5.Thmtheorem10.p1.m12" class="ltx_Math" alttext="\ell(\lambda)=\sum_{j=1}^{m}r_{j}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><msub><mi>r</mi><mi>j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\ell(\lambda)=\sum_{j=1}^{m}r_{j}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S5.SS1.p13" class="ltx_para">
<p id="S5.SS1.p13.1" class="ltx_p">In the next subsection, we will apply the Stanley map <math id="S5.SS1.p13.m1" class="ltx_Math" alttext="\widehat{\mathscr{S}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathscript">𝒮</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\widehat{\mathscr{S}}</annotation></semantics></math> to the formulas in Theorems <a href="#S5.Thmtheorem1" title="Theorem 5.1. ‣ 5.1. Recursive formulas for the representations ‣ 5. Characteristic polynomial of ℳ̄_{0,𝑛} ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a> and <a href="#S5.Thmtheorem10" title="Theorem 5.10. ‣ 5.1. Recursive formulas for the representations ‣ 5. Characteristic polynomial of ℳ̄_{0,𝑛} ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.10</span></a> to deduce corresponding formulas for the characteristic polynomials of <math id="S5.SS1.p13.m2" class="ltx_Math" alttext="\overline{{\cal M}}_{0,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{{\cal M}}_{0,n}</annotation></semantics></math> and <math id="S5.SS1.p13.m3" class="ltx_Math" alttext="\overline{{\cal M}}_{0,n+1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><annotation encoding="application/x-tex">\overline{{\cal M}}_{0,n+1}</annotation></semantics></math>.
Since every formula appearing above involves only arithmetic operations and plethysm, our formulas for the characteristic polynomials involve only arithmetic operations and composition.</p>
</div>
<div id="S5.SS1.p14" class="ltx_para">
<p id="S5.SS1.p14.1" class="ltx_p">The proof of Theorem <a href="#S5.Thmtheorem10" title="Theorem 5.10. ‣ 5.1. Recursive formulas for the representations ‣ 5. Characteristic polynomial of ℳ̄_{0,𝑛} ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.10</span></a> uses the recursive structure on <math id="S5.SS1.p14.m1" class="ltx_Math" alttext="\mathscr{T}_{n,k}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">𝒯</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">\mathscr{T}_{n,k}</annotation></semantics></math> which will be briefly explained in Lemma <a href="#S5.Thmtheorem16" title="Lemma 5.16. ‣ 5.3. Interpretation as the count of colorings ‣ 5. Characteristic polynomial of ℳ̄_{0,𝑛} ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.16</span></a> in §<a href="#S5.SS3" title="5.3. Interpretation as the count of colorings ‣ 5. Characteristic polynomial of ℳ̄_{0,𝑛} ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.3</span></a> below.</p>
</div>
</section>
<section id="S5.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.2. </span>Recursive formulas for characteristic polynomials</h3>

<div id="S5.SS2.p1" class="ltx_para">
<p id="S5.SS2.p1.1" class="ltx_p">Let us apply the Stanley map to <math id="S5.SS2.p1.m1" class="ltx_Math" alttext="P,P_{n},P_{n,k},Q,Q_{n},Q_{n,k}" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>,</mo><msub><mi>P</mi><mi>n</mi></msub><mo>,</mo><msub><mi>P</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>,</mo><mi>Q</mi><mo>,</mo><msub><mi>Q</mi><mi>n</mi></msub><mo>,</mo><msub><mi>Q</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow></msub></mrow><annotation encoding="application/x-tex">P,P_{n},P_{n,k},Q,Q_{n},Q_{n,k}</annotation></semantics></math> to obtain the characteristic polynomials of <math id="S5.SS2.p1.m2" class="ltx_Math" alttext="\overline{{\cal M}}_{0,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\overline{{\cal M}}_{0,n}</annotation></semantics></math> and <math id="S5.SS2.p1.m3" class="ltx_Math" alttext="\overline{{\cal M}}_{0,n+1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><annotation encoding="application/x-tex">\overline{{\cal M}}_{0,n+1}</annotation></semantics></math> as</p>
<table id="S5.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex13.m1" class="ltx_Math" alttext="\begin{split}(\mathscr{P},\mathscr{P}_{n},\mathscr{P}_{n,k})&amp;:=(\widehat{\mathscr{S}}_{P},\mathscr{S}_{P_{n}},\mathscr{S}_{P_{n,k}});\\
(\mathscr{Q},\mathscr{Q}_{n},\mathscr{Q}_{n,k})&amp;:=(\widehat{\mathscr{S}}_{Q},\mathscr{S}_{Q_{n}},\mathscr{S}_{Q_{n,k}});\\
(\mathscr{Q}^{+},\mathscr{Q}_{n}^{+},\mathscr{Q}_{n,k}^{+})&amp;:=(\widehat{\mathscr{S}}_{Q^{+}},\mathscr{S}_{Q_{n}^{+}},\mathscr{S}_{Q_{n,k}^{+}}).\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathscript">𝒫</mi><mo>,</mo><msub><mi class="ltx_font_mathscript">𝒫</mi><mi>n</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathscript">𝒫</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathscript">𝒮</mi><mo>^</mo></mover><mi>P</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>P</mi><mi>n</mi></msub></msub><mo>,</mo><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>P</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>;</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathscript">𝒬</mi><mo>,</mo><msub><mi class="ltx_font_mathscript">𝒬</mi><mi>n</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathscript">𝒬</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathscript">𝒮</mi><mo>^</mo></mover><mi>Q</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>Q</mi><mi>n</mi></msub></msub><mo>,</mo><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>Q</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>;</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathscript">𝒬</mi><mo>+</mo></msup><mo>,</mo><msubsup><mi class="ltx_font_mathscript">𝒬</mi><mi>n</mi><mo>+</mo></msubsup><mo>,</mo><msubsup><mi class="ltx_font_mathscript">𝒬</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow><mo>+</mo></msubsup><mo stretchy="false">)</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathscript">𝒮</mi><mo>^</mo></mover><msup><mi>Q</mi><mo>+</mo></msup></msub><mo>,</mo><msub><mi class="ltx_font_mathscript">𝒮</mi><msubsup><mi>Q</mi><mi>n</mi><mo>+</mo></msubsup></msub><mo>,</mo><msub><mi class="ltx_font_mathscript">𝒮</mi><msubsup><mi>Q</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow><mo>+</mo></msubsup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}(\mathscr{P},\mathscr{P}_{n},\mathscr{P}_{n,k})&amp;:=(\widehat{\mathscr{S}}_{P},\mathscr{S}_{P_{n}},\mathscr{S}_{P_{n,k}});\\
(\mathscr{Q},\mathscr{Q}_{n},\mathscr{Q}_{n,k})&amp;:=(\widehat{\mathscr{S}}_{Q},\mathscr{S}_{Q_{n}},\mathscr{S}_{Q_{n,k}});\\
(\mathscr{Q}^{+},\mathscr{Q}_{n}^{+},\mathscr{Q}_{n,k}^{+})&amp;:=(\widehat{\mathscr{S}}_{Q^{+}},\mathscr{S}_{Q_{n}^{+}},\mathscr{S}_{Q_{n,k}^{+}}).\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.p1.2" class="ltx_p">In particular, the generating series are written as</p>
<table id="S5.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex14.m1" class="ltx_Math" alttext="\begin{split}&amp;\mathscr{P}(m,q,t):=1+mq+\frac{m(m+1)}{2}q^{2}+\sum_{n\geq 2}\mathscr{P}_{n}(m,t)q^{n};\\
&amp;\mathscr{Q}(m,q,t):=1+mq+\sum_{n\geq 2}\mathscr{Q}_{n}(m,t)q^{n};\\
&amp;\mathscr{Q}^{+}(m,q,t):=mq+\sum_{n\geq 2}\mathscr{Q}^{+}_{n}(m,t)q^{n}.\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mi class="ltx_font_mathscript">𝒫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>q</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>+</mo><mrow><mfrac><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mn>2</mn></msup></mrow><mo rspace="0.055em">+</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>≥</mo><mn>2</mn></mrow></munder><mrow><msub><mi class="ltx_font_mathscript">𝒫</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mi>n</mi></msup></mrow></mrow></mrow></mrow><mo>;</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mi class="ltx_font_mathscript">𝒬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>q</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo rspace="0.055em">+</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>≥</mo><mn>2</mn></mrow></munder><mrow><msub><mi class="ltx_font_mathscript">𝒬</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mi>n</mi></msup></mrow></mrow></mrow></mrow><mo>;</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><msup><mi class="ltx_font_mathscript">𝒬</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>q</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo rspace="0.055em">+</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>≥</mo><mn>2</mn></mrow></munder><mrow><msubsup><mi class="ltx_font_mathscript">𝒬</mi><mi>n</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mi>n</mi></msup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}&amp;\mathscr{P}(m,q,t):=1+mq+\frac{m(m+1)}{2}q^{2}+\sum_{n\geq 2}\mathscr{P}_{n}(m,t)q^{n};\\
&amp;\mathscr{Q}(m,q,t):=1+mq+\sum_{n\geq 2}\mathscr{Q}_{n}(m,t)q^{n};\\
&amp;\mathscr{Q}^{+}(m,q,t):=mq+\sum_{n\geq 2}\mathscr{Q}^{+}_{n}(m,t)q^{n}.\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S5.SS2.p2" class="ltx_para">
<p id="S5.SS2.p2.1" class="ltx_p">The following are direct consequences of Theorems <a href="#S5.Thmtheorem1" title="Theorem 5.1. ‣ 5.1. Recursive formulas for the representations ‣ 5. Characteristic polynomial of ℳ̄_{0,𝑛} ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a> and <a href="#S5.Thmtheorem10" title="Theorem 5.10. ‣ 5.1. Recursive formulas for the representations ‣ 5. Characteristic polynomial of ℳ̄_{0,𝑛} ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.10</span></a>, thanks to the properties of <math id="S5.SS2.p2.m1" class="ltx_Math" alttext="\mathscr{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">𝒮</mi><annotation encoding="application/x-tex">\mathscr{S}</annotation></semantics></math> and <math id="S5.SS2.p2.m2" class="ltx_Math" alttext="\widehat{\mathscr{S}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathscript">𝒮</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\widehat{\mathscr{S}}</annotation></semantics></math> in (<a href="#S3.E8" title="In Proposition 3.2. ‣ 3.2. Characteristic polynomial of a symmetric function ‣ 3. Characteristic polynomials of symmetric functions and representations ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.8</span></a>), (<a href="#S3.E10" title="In 3.2. Characteristic polynomial of a symmetric function ‣ 3. Characteristic polynomials of symmetric functions and representations ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.10</span></a>) and (<a href="#S3.E13" title="In 3.2. Characteristic polynomial of a symmetric function ‣ 3. Characteristic polynomials of symmetric functions and representations ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.13</span></a>).</p>
</div>
<div id="S5.SS2.p3" class="ltx_para">
<p id="S5.SS2.p3.1" class="ltx_p">Let <math id="S5.SS2.p3.m1" class="ltx_Math" alttext="\mathrm{Par}" display="inline" intent=":literal"><semantics><mi>Par</mi><annotation encoding="application/x-tex">\mathrm{Par}</annotation></semantics></math> be the set of all the partitions of nonnegative integers as in Remark <a href="#S3.Thmtheorem8" title="Remark 3.8 (Alternative description of Exp(𝑓)). ‣ 3.3. Plethysm on polynomials ‣ 3. Characteristic polynomials of symmetric functions and representations ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.8</span></a>.
We write <math id="S5.SS2.p3.m2" class="ltx_Math" alttext="\lvert\lambda\rvert=\sum_{i=1}^{\ell}\lambda_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>λ</mi><mo stretchy="false">|</mo></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">ℓ</mi></msubsup><msub><mi>λ</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\lvert\lambda\rvert=\sum_{i=1}^{\ell}\lambda_{i}</annotation></semantics></math> for <math id="S5.SS2.p3.m3" class="ltx_Math" alttext="\lambda=(\lambda_{1},\cdots,\lambda_{\ell})" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>λ</mi><mi mathvariant="normal">ℓ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda=(\lambda_{1},\cdots,\lambda_{\ell})</annotation></semantics></math>.
Then <math id="S5.SS2.p3.m4" class="ltx_Math" alttext="\mathscr{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">𝒫</mi><annotation encoding="application/x-tex">\mathscr{P}</annotation></semantics></math> and <math id="S5.SS2.p3.m5" class="ltx_Math" alttext="\mathscr{Q}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">𝒬</mi><annotation encoding="application/x-tex">\mathscr{Q}</annotation></semantics></math> are determined by the following.</p>
</div>
<div id="S5.Thmtheorem11" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem11.2" class="ltx_text ltx_font_bold">Theorem 5.11</span></span><span id="S5.Thmtheorem11.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem11.p1" class="ltx_para">
<ol id="S5.I2" class="ltx_enumerate">
<li id="S5.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S5.I2.i1.p1" class="ltx_para">
<p id="S5.I2.i1.p1.1" class="ltx_p"><math id="S5.I2.i1.p1.m1" class="ltx_Math" alttext="\mathscr{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">𝒫</mi><annotation encoding="application/x-tex">\mathscr{P}</annotation></semantics></math><span id="S5.I2.i1.p1.1.1" class="ltx_text ltx_font_italic"> and </span><math id="S5.I2.i1.p1.m2" class="ltx_Math" alttext="\mathscr{Q}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">𝒬</mi><annotation encoding="application/x-tex">\mathscr{Q}</annotation></semantics></math><span id="S5.I2.i1.p1.1.2" class="ltx_text ltx_font_italic"> are related by the formula</span></p>
<table id="S5.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex15.m1" class="ltx_Math" alttext="(1+t)\mathscr{P}=(1+t+mqt)\mathscr{Q}-\frac{t}{2}(\mathscr{Q}^{2}-\mathscr{Q}^{[2]})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathscript">𝒫</mi></mrow><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi><mo>+</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathscript">𝒬</mi></mrow><mo>−</mo><mrow><mfrac><mi>t</mi><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi class="ltx_font_mathscript">𝒬</mi><mn>2</mn></msup><mo>−</mo><msup><mi class="ltx_font_mathscript">𝒬</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(1+t)\mathscr{P}=(1+t+mqt)\mathscr{Q}-\frac{t}{2}(\mathscr{Q}^{2}-\mathscr{Q}^{[2]}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S5.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S5.I2.i2.p1" class="ltx_para">
<p id="S5.I2.i2.p1.1" class="ltx_p"><math id="S5.I2.i2.p1.m1" class="ltx_Math" alttext="\mathscr{Q}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathscript">𝒬</mi><annotation encoding="application/x-tex">\mathscr{Q}</annotation></semantics></math><span id="S5.I2.i2.p1.1.1" class="ltx_text ltx_font_italic"> is the plethystic exponential of </span><math id="S5.I2.i2.p1.m2" class="ltx_Math" alttext="\mathscr{Q}^{+}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathscript">𝒬</mi><mo>+</mo></msup><annotation encoding="application/x-tex">\mathscr{Q}^{+}</annotation></semantics></math><span id="S5.I2.i2.p1.1.2" class="ltx_text ltx_font_italic">:</span></p>
<table id="S5.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex16.m1" class="ltx_Math" alttext="\mathscr{Q}=\Exp(\mathscr{Q}^{+})=\sum_{\lambda\in\mathrm{Par}}z_{\lambda}^{-1}(\mathscr{Q}^{+})^{[\lambda]}." display="block" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathscript">𝒬</mi><mo>=</mo><mrow><mi>Exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathscript">𝒬</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>λ</mi><mo>∈</mo><mi>Par</mi></mrow></munder><mrow><msubsup><mi>z</mi><mi>λ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathscript">𝒬</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">[</mo><mi>λ</mi><mo stretchy="false">]</mo></mrow></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathscr{Q}=\Exp(\mathscr{Q}^{+})=\sum_{\lambda\in\mathrm{Par}}z_{\lambda}^{-1}(\mathscr{Q}^{+})^{[\lambda]}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S5.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S5.I2.i3.p1" class="ltx_para">
<p id="S5.I2.i3.p1.1" class="ltx_p"><span id="S5.I2.i3.p1.1.1" class="ltx_text ltx_font_italic">Moreover, </span><math id="S5.I2.i3.p1.m1" class="ltx_Math" alttext="\mathscr{Q}^{+}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathscript">𝒬</mi><mo>+</mo></msup><annotation encoding="application/x-tex">\mathscr{Q}^{+}</annotation></semantics></math><span id="S5.I2.i3.p1.1.2" class="ltx_text ltx_font_italic"> satisfies the following two equivalent formulas.</span></p>
<table id="S5.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex17.m1" class="ltx_Math" alttext="\begin{split}\mathrm{(Recursive)}\quad&amp;\mathscr{Q}^{+}=mq+\sum_{\lambda\in\mathrm{Par},\lvert\lambda\rvert\geq 3}\left(\sum_{i=1}^{\lvert\lambda\rvert-2}t^{i}\right)z_{\lambda}^{-1}(\mathscr{Q}^{+})^{[\lambda]}\\
\mathrm{(Exponential)}\quad&amp;\Exp(t\mathscr{Q}^{+})=t^{2}\Exp(\mathscr{Q}^{+})+(1-t)(1+t+mqt).\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mo stretchy="false">(</mo><mi>Recursive</mi><mo stretchy="false">)</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><msup><mi class="ltx_font_mathscript">𝒬</mi><mo>+</mo></msup><mo>=</mo><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo rspace="0.055em">+</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mrow><mi>λ</mi><mo>∈</mo><mi>Par</mi></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">|</mo><mi>λ</mi><mo stretchy="false">|</mo></mrow><mo>≥</mo><mn>3</mn></mrow></mrow></munder><mrow><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mrow><mo stretchy="false">|</mo><mi>λ</mi><mo stretchy="false">|</mo></mrow><mo>−</mo><mn>2</mn></mrow></munderover><msup><mi>t</mi><mi>i</mi></msup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>z</mi><mi>λ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathscript">𝒬</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">[</mo><mi>λ</mi><mo stretchy="false">]</mo></mrow></msup></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mo stretchy="false">(</mo><mi>Exponential</mi><mo stretchy="false">)</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mi>Exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi class="ltx_font_mathscript">𝒬</mi><mo>+</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>t</mi><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>Exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathscript">𝒬</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi><mo>+</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\mathrm{(Recursive)}\quad&amp;\mathscr{Q}^{+}=mq+\sum_{\lambda\in\mathrm{Par},\lvert\lambda\rvert\geq 3}\left(\sum_{i=1}^{\lvert\lambda\rvert-2}t^{i}\right)z_{\lambda}^{-1}(\mathscr{Q}^{+})^{[\lambda]}\\
\mathrm{(Exponential)}\quad&amp;\Exp(t\mathscr{Q}^{+})=t^{2}\Exp(\mathscr{Q}^{+})+(1-t)(1+t+mqt).\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
</div>
</div>
<div id="S5.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.SS2.p4" class="ltx_para">
<p id="S5.SS2.p4.1" class="ltx_p"><span id="S5.SS2.p4.1.1" class="ltx_text">For (1), it suffices to show that <math id="S5.SS2.p4.m1" class="ltx_Math" alttext="\mathsf{s}_{(1,1)}\circ\mathscr{Q}=\frac{1}{2}(\mathscr{Q}^{2}-\mathscr{Q}^{[2]})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝗌</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi class="ltx_font_mathscript">𝒬</mi></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi class="ltx_font_mathscript">𝒬</mi><mn>2</mn></msup><mo>−</mo><msup><mi class="ltx_font_mathscript">𝒬</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathsf{s}_{(1,1)}\circ\mathscr{Q}=\frac{1}{2}(\mathscr{Q}^{2}-\mathscr{Q}^{[2]})</annotation></semantics></math>. This follows from the identity <math id="S5.SS2.p4.m2" class="ltx_Math" alttext="\mathsf{s}_{(1,1)}=\frac{1}{2}(\mathsf{p}_{1}^{2}-\mathsf{p}_{2})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝗌</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msub><mo>=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝗉</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msub><mi>𝗉</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathsf{s}_{(1,1)}=\frac{1}{2}(\mathsf{p}_{1}^{2}-\mathsf{p}_{2})</annotation></semantics></math>. For (2) and (3), see Remark <a href="#S3.Thmtheorem8" title="Remark 3.8 (Alternative description of Exp(𝑓)). ‣ 3.3. Plethysm on polynomials ‣ 3. Characteristic polynomials of symmetric functions and representations ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.8</span></a>.
∎</span></p>
</div>
</div>
<div id="S5.Thmtheorem12" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem12.2" class="ltx_text ltx_font_bold">Corollary 5.12</span></span><span id="S5.Thmtheorem12.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem12.p1" class="ltx_para">
<p id="S5.Thmtheorem12.p1.1" class="ltx_p"><span id="S5.Thmtheorem12.p1.1.1" class="ltx_text ltx_font_italic">For <math id="S5.Thmtheorem12.p1.m1" class="ltx_Math" alttext="n\geq 3" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">n\geq 3</annotation></semantics></math>, <math id="S5.Thmtheorem12.p1.m2" class="ltx_Math" alttext="\mathscr{P}_{n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">𝒫</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathscr{P}_{n}</annotation></semantics></math> and <math id="S5.Thmtheorem12.p1.m3" class="ltx_Math" alttext="\mathscr{Q}_{n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">𝒬</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathscr{Q}_{n}</annotation></semantics></math> are related by</span></p>
<table id="S5.E2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(5.2)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E2.m1" class="ltx_Math" alttext="(1+t)\mathscr{P}_{n}=\mathscr{Q}_{n}-\frac{1}{2}t\left(\sum_{h=2}^{n-2}\mathscr{Q}_{h}\mathscr{Q}_{n-h}-\mathscr{Q}_{\frac{n}{2}}^{[2]}\right)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒫</mi><mi>n</mi></msub></mrow><mo>=</mo><mrow><msub><mi class="ltx_font_mathscript">𝒬</mi><mi>n</mi></msub><mo>−</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>2</mn></mrow><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></munderover><mrow><msub><mi class="ltx_font_mathscript">𝒬</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒬</mi><mrow><mi>n</mi><mo>−</mo><mi>h</mi></mrow></msub></mrow></mrow><mo>−</mo><msubsup><mi class="ltx_font_mathscript">𝒬</mi><mfrac><mi>n</mi><mn>2</mn></mfrac><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msubsup></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">(1+t)\mathscr{P}_{n}=\mathscr{Q}_{n}-\frac{1}{2}t\left(\sum_{h=2}^{n-2}\mathscr{Q}_{h}\mathscr{Q}_{n-h}-\mathscr{Q}_{\frac{n}{2}}^{[2]}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmtheorem12.p1.2" class="ltx_p"><span id="S5.Thmtheorem12.p1.2.1" class="ltx_text ltx_font_italic">where <math id="S5.Thmtheorem12.p1.m4" class="ltx_Math" alttext="\mathscr{Q}_{\frac{n}{2}}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒬</mi><mfrac><mi>n</mi><mn>2</mn></mfrac></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathscr{Q}_{\frac{n}{2}}=0</annotation></semantics></math> for <math id="S5.Thmtheorem12.p1.m5" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> odd.
Set <math id="S5.Thmtheorem12.p1.m6" class="ltx_Math" alttext="\mathscr{Q}_{1}^{+}=m" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathscript">𝒬</mi><mn>1</mn><mo>+</mo></msubsup><mo>=</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">\mathscr{Q}_{1}^{+}=m</annotation></semantics></math>. For <math id="S5.Thmtheorem12.p1.m7" class="ltx_Math" alttext="n\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">n\geq 2</annotation></semantics></math>, <math id="S5.Thmtheorem12.p1.m8" class="ltx_Math" alttext="\mathscr{Q}_{n}^{+}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathscript">𝒬</mi><mi>n</mi><mo>+</mo></msubsup><annotation encoding="application/x-tex">\mathscr{Q}_{n}^{+}</annotation></semantics></math> and <math id="S5.Thmtheorem12.p1.m9" class="ltx_Math" alttext="\mathscr{Q}_{n}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">𝒬</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathscr{Q}_{n}</annotation></semantics></math> satisfy</span></p>
<table id="S5.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.Ex18.m1" class="ltx_Math" alttext="\begin{split}\mathscr{Q}_{n}^{+}&amp;=\sum_{\lambda\vdash n}\left(\sum_{i=1}^{\ell(\lambda)-2}t^{i}\right)\prod_{j=1}^{m}\left(\mathsf{h}_{r_{j}}\circ\mathscr{Q}_{n_{j}}^{+}\right)\mathscr{Q}_{n}=\sum_{\lambda\vdash n}\prod_{j=1}^{m}\left(\mathsf{h}_{r_{j}}\circ\mathscr{Q}_{n_{j}}^{+}\right)\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true"><mtr><mtd class="ltx_align_right" columnalign="right"><msubsup><mi class="ltx_font_mathscript">𝒬</mi><mi>n</mi><mo>+</mo></msubsup></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>λ</mi><mo>⊢</mo><mi>n</mi></mrow></munder><mrow><mrow><mo>(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mn>2</mn></mrow></munderover><msup><mi>t</mi><mi>i</mi></msup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∏</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><mrow><mrow><mo>(</mo><mrow><msub><mi>𝗁</mi><msub><mi>r</mi><mi>j</mi></msub></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi class="ltx_font_mathscript">𝒬</mi><msub><mi>n</mi><mi>j</mi></msub><mo>+</mo></msubsup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒬</mi><mi>n</mi></msub></mrow></mrow></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>λ</mi><mo>⊢</mo><mi>n</mi></mrow></munder><mrow><munderover><mo movablelimits="false" rspace="0em">∏</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover><mrow><mo>(</mo><mrow><msub><mi>𝗁</mi><msub><mi>r</mi><mi>j</mi></msub></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi class="ltx_font_mathscript">𝒬</mi><msub><mi>n</mi><mi>j</mi></msub><mo>+</mo></msubsup></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\mathscr{Q}_{n}^{+}&amp;=\sum_{\lambda\vdash n}\left(\sum_{i=1}^{\ell(\lambda)-2}t^{i}\right)\prod_{j=1}^{m}\left(\mathsf{h}_{r_{j}}\circ\mathscr{Q}_{n_{j}}^{+}\right)\mathscr{Q}_{n}=\sum_{\lambda\vdash n}\prod_{j=1}^{m}\left(\mathsf{h}_{r_{j}}\circ\mathscr{Q}_{n_{j}}^{+}\right)\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmtheorem12.p1.3" class="ltx_p"><span id="S5.Thmtheorem12.p1.3.1" class="ltx_text ltx_font_italic">where <math id="S5.Thmtheorem12.p1.m10" class="ltx_Math" alttext="n_{j}" display="inline" intent=":literal"><semantics><msub><mi>n</mi><mi>j</mi></msub><annotation encoding="application/x-tex">n_{j}</annotation></semantics></math> denote the parts of <math id="S5.Thmtheorem12.p1.m11" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> with multiplicities <math id="S5.Thmtheorem12.p1.m12" class="ltx_Math" alttext="r_{j}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>j</mi></msub><annotation encoding="application/x-tex">r_{j}</annotation></semantics></math> so that <math id="S5.Thmtheorem12.p1.m13" class="ltx_Math" alttext="\lambda=(n_{1}^{r_{1}},\cdots,n_{m}^{r_{m}})" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>n</mi><mn>1</mn><msub><mi>r</mi><mn>1</mn></msub></msubsup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msubsup><mi>n</mi><mi>m</mi><msub><mi>r</mi><mi>m</mi></msub></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda=(n_{1}^{r_{1}},\cdots,n_{m}^{r_{m}})</annotation></semantics></math> with <math id="S5.Thmtheorem12.p1.m14" class="ltx_Math" alttext="n_{1}&gt;\cdots&gt;n_{m}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mn>1</mn></msub><mo rspace="0.1389em">&gt;</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">&gt;</mo><msub><mi>n</mi><mi>m</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n_{1}&gt;\cdots&gt;n_{m}&gt;0</annotation></semantics></math>
and <math id="S5.Thmtheorem12.p1.m15" class="ltx_Math" alttext="\ell(\lambda)=\sum_{j=1}^{m}r_{j}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><msub><mi>r</mi><mi>j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\ell(\lambda)=\sum_{j=1}^{m}r_{j}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S5.Thmtheorem13" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem13.2" class="ltx_text ltx_font_bold">Remark 5.13</span></span><span id="S5.Thmtheorem13.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem13.p1" class="ltx_para">
<p id="S5.Thmtheorem13.p1.1" class="ltx_p">Note that <math id="S5.Thmtheorem13.p1.m1" class="ltx_Math" alttext="\mathsf{h}_{r}\circ\mathscr{Q}_{n}^{+}=\sum_{\lambda\vdash r}z_{\lambda}^{-1}(\mathscr{Q}_{n}^{+})^{[\lambda]}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝗁</mi><mi>r</mi></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msubsup><mi class="ltx_font_mathscript">𝒬</mi><mi>n</mi><mo>+</mo></msubsup></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mi>λ</mi><mo>⊢</mo><mi>r</mi></mrow></msub><mrow><msubsup><mi>z</mi><mi>λ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathscript">𝒬</mi><mi>n</mi><mo>+</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">[</mo><mi>λ</mi><mo stretchy="false">]</mo></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathsf{h}_{r}\circ\mathscr{Q}_{n}^{+}=\sum_{\lambda\vdash r}z_{\lambda}^{-1}(\mathscr{Q}_{n}^{+})^{[\lambda]}</annotation></semantics></math> for <math id="S5.Thmtheorem13.p1.m2" class="ltx_Math" alttext="r,n\geq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>r</mi><mo>,</mo><mi>n</mi></mrow><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">r,n\geq 1</annotation></semantics></math>, by the same argument as in Remark <a href="#S3.Thmtheorem8" title="Remark 3.8 (Alternative description of Exp(𝑓)). ‣ 3.3. Plethysm on polynomials ‣ 3. Characteristic polynomials of symmetric functions and representations ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.8</span></a>.</p>
</div>
</div>
<div id="S5.SS2.p5" class="ltx_para">
<p id="S5.SS2.p5.1" class="ltx_p">For later use, we record a different but equivalent form of (<a href="#S5.E2" title="In Corollary 5.12. ‣ 5.2. Recursive formulas for characteristic polynomials ‣ 5. Characteristic polynomial of ℳ̄_{0,𝑛} ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.2</span></a>).
For any integer <math id="S5.SS2.p5.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, reading the coefficients of <math id="S5.SS2.p5.m2" class="ltx_Math" alttext="t^{k}" display="inline" intent=":literal"><semantics><msup><mi>t</mi><mi>k</mi></msup><annotation encoding="application/x-tex">t^{k}</annotation></semantics></math> in (<a href="#S5.E2" title="In Corollary 5.12. ‣ 5.2. Recursive formulas for characteristic polynomials ‣ 5. Characteristic polynomial of ℳ̄_{0,𝑛} ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.2</span></a>), we obtain</p>
<table id="S5.E3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(5.3)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E3.m1" class="ltx_Math" alttext="\begin{split}\mathscr{P}_{n,k}+\mathscr{P}_{n,k-1}=\mathscr{Q}_{n,k}&amp;-\frac{1}{2}\sum_{2\leq h\leq n-2}\sum_{j=0}^{k-1}\mathscr{Q}_{h,j}\mathscr{Q}_{n-h,k-j-1}+\frac{1}{2}\mathscr{Q}_{\frac{n}{2},\frac{k-1}{2}}\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><msub><mi class="ltx_font_mathscript">𝒫</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>+</mo><msub><mi class="ltx_font_mathscript">𝒫</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub></mrow><mo>=</mo><msub><mi class="ltx_font_mathscript">𝒬</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow></msub></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo movablelimits="false" rspace="0em">∑</mo><msub><mrow></mrow><mrow><mn>2</mn><mo>≤</mo><mi>h</mi><mo>≤</mo><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></mrow></msub><mo movablelimits="false">∑</mo><msub><mrow></mrow><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow></msub><msup><mrow></mrow><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mi class="ltx_font_mathscript">𝒬</mi><msub><mrow></mrow><mrow><mi>h</mi><mo>,</mo><mi>j</mi></mrow></msub><mi class="ltx_font_mathscript">𝒬</mi><msub><mrow></mrow><mrow><mrow><mi>n</mi><mo>−</mo><mi>h</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo>−</mo><mi>j</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>+</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mi class="ltx_font_mathscript">𝒬</mi><msub><mrow></mrow><mrow><mfrac><mi>n</mi><mn>2</mn></mfrac><mo>,</mo><mfrac><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></mfrac></mrow></msub></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\mathscr{P}_{n,k}+\mathscr{P}_{n,k-1}=\mathscr{Q}_{n,k}&amp;-\frac{1}{2}\sum_{2\leq h\leq n-2}\sum_{j=0}^{k-1}\mathscr{Q}_{h,j}\mathscr{Q}_{n-h,k-j-1}+\frac{1}{2}\mathscr{Q}_{\frac{n}{2},\frac{k-1}{2}}\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.p5.2" class="ltx_p">where we set <math id="S5.SS2.p5.m3" class="ltx_Math" alttext="\mathscr{Q}_{h,j}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒬</mi><mrow><mi>h</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathscr{Q}_{h,j}=0</annotation></semantics></math> whenever <math id="S5.SS2.p5.m4" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> or <math id="S5.SS2.p5.m5" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> is not an integer.</p>
</div>
<div id="S5.SS2.p6" class="ltx_para">
<p id="S5.SS2.p6.1" class="ltx_p">Using the algorithm in this section, we can study the log-concavities of <math id="S5.SS2.p6.m1" class="ltx_Math" alttext="\mathscr{P}_{n}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒫</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{P}_{n}(m,t)</annotation></semantics></math> and <math id="S5.SS2.p6.m2" class="ltx_Math" alttext="\mathscr{Q}_{n}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒬</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{Q}_{n}(m,t)</annotation></semantics></math> (cf. Definition <a href="#S2.Thmtheorem1" title="Definition 2.1. ‣ 2. Two-dimensional log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.1</span></a>).
Refining Definition <a href="#S2.Thmtheorem1" title="Definition 2.1. ‣ 2. Two-dimensional log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.1</span></a>(2), we say that a polynomial <math id="S5.SS2.p6.m3" class="ltx_Math" alttext="A(m,t)" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">A(m,t)</annotation></semantics></math> in (<a href="#S2.E2" title="In 2. Two-dimensional log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.2</span></a>) is length log-concave in degree <math id="S5.SS2.p6.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> <em id="S5.SS2.p6.1.1" class="ltx_emph ltx_font_italic">at length <math id="S5.SS2.p6.m5" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math></em>
if <math id="S5.SS2.p6.m6" class="ltx_Math" alttext="A_{k}(m)=\sum_{j}A_{k}^{j}m^{j}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>A</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mi>j</mi></msub><mrow><msubsup><mi>A</mi><mi>k</mi><mi>j</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>m</mi><mi>j</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">A_{k}(m)=\sum_{j}A_{k}^{j}m^{j}</annotation></semantics></math> is log-concave at <math id="S5.SS2.p6.m7" class="ltx_Math" alttext="j=\ell" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>=</mo><mi mathvariant="normal">ℓ</mi></mrow><annotation encoding="application/x-tex">j=\ell</annotation></semantics></math>, that is, <math id="S5.SS2.p6.m8" class="ltx_Math" alttext="(A^{\ell}_{k})^{2}\geq A^{\ell-1}_{k}A^{\ell+1}_{k}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>A</mi><mi>k</mi><mi mathvariant="normal">ℓ</mi></msubsup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>≥</mo><mrow><msubsup><mi>A</mi><mi>k</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>A</mi><mi>k</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mn>1</mn></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">(A^{\ell}_{k})^{2}\geq A^{\ell-1}_{k}A^{\ell+1}_{k}</annotation></semantics></math>.</p>
</div>
<div id="S5.SS2.p7" class="ltx_para">
<p id="S5.SS2.p7.1" class="ltx_p">Based on numerical computations, we propose the following.</p>
</div>
<div id="S5.Thmtheorem14" class="ltx_theorem ltx_theorem_conjecture">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem14.2" class="ltx_text ltx_font_bold">Conjecture 5.14</span></span><span id="S5.Thmtheorem14.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem14.p1" class="ltx_para">
<p id="S5.Thmtheorem14.p1.1" class="ltx_p"><span id="S5.Thmtheorem14.p1.1.1" class="ltx_text ltx_font_italic">The polynomials <math id="S5.Thmtheorem14.p1.m1" class="ltx_Math" alttext="\mathscr{P}_{n}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒫</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{P}_{n}(m,t)</annotation></semantics></math> and <math id="S5.Thmtheorem14.p1.m2" class="ltx_Math" alttext="\mathscr{Q}_{n}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒬</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{Q}_{n}(m,t)</annotation></semantics></math> are</span></p>
<ol id="S5.I3" class="ltx_enumerate">
<li id="S5.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S5.I3.i1.p1" class="ltx_para">
<p id="S5.I3.i1.p1.1" class="ltx_p"><span id="S5.I3.i1.p1.1.1" class="ltx_text ltx_font_italic">length log-concave at </span><math id="S5.I3.i1.p1.m1" class="ltx_Math" alttext="t=1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=1</annotation></semantics></math><span id="S5.I3.i1.p1.1.2" class="ltx_text ltx_font_italic">,</span></p>
</div></li>
<li id="S5.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S5.I3.i2.p1" class="ltx_para">
<p id="S5.I3.i2.p1.1" class="ltx_p"><span id="S5.I3.i2.p1.1.1" class="ltx_text ltx_font_italic">length log-concave in degree </span><math id="S5.I3.i2.p1.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math><span id="S5.I3.i2.p1.1.2" class="ltx_text ltx_font_italic"> (for any given </span><math id="S5.I3.i2.p1.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math><span id="S5.I3.i2.p1.1.3" class="ltx_text ltx_font_italic">) at length </span><math id="S5.I3.i2.p1.m3" class="ltx_Math" alttext="\ell&gt;2" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>&gt;</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\ell&gt;2</annotation></semantics></math><span id="S5.I3.i2.p1.1.4" class="ltx_text ltx_font_italic">,</span></p>
</div></li>
<li id="S5.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S5.I3.i3.p1" class="ltx_para">
<p id="S5.I3.i3.p1.1" class="ltx_p"><span id="S5.I3.i3.p1.1.1" class="ltx_text ltx_font_italic">degree log-concave at </span><math id="S5.I3.i3.p1.m1" class="ltx_Math" alttext="m=1" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">m=1</annotation></semantics></math><span id="S5.I3.i3.p1.1.2" class="ltx_text ltx_font_italic"> and</span></p>
</div></li>
<li id="S5.I3.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S5.I3.i4.p1" class="ltx_para">
<p id="S5.I3.i4.p1.1" class="ltx_p"><span id="S5.I3.i4.p1.1.1" class="ltx_text ltx_font_italic">degree log-concave in length </span><math id="S5.I3.i4.p1.m1" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math><span id="S5.I3.i4.p1.1.2" class="ltx_text ltx_font_italic"> for </span><math id="S5.I3.i4.p1.m2" class="ltx_Math" alttext="\ell\geq\sqrt{n}+2" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>≥</mo><mrow><msqrt><mi>n</mi></msqrt><mo>+</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">\ell\geq\sqrt{n}+2</annotation></semantics></math><span id="S5.I3.i4.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S5.SS2.p8" class="ltx_para">
<p id="S5.SS2.p8.1" class="ltx_p">We verified this conjecture up to <math id="S5.SS2.p8.m1" class="ltx_Math" alttext="n\leq 72" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≤</mo><mn>72</mn></mrow><annotation encoding="application/x-tex">n\leq 72</annotation></semantics></math>.
In §6, we will prove (3) and (4) for <math id="S5.SS2.p8.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> sufficiently large as well as (2) partially.</p>
</div>
<div id="S5.Thmtheorem15" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem15.2" class="ltx_text ltx_font_bold">Remark 5.15</span></span><span id="S5.Thmtheorem15.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem15.p1" class="ltx_para">
<p id="S5.Thmtheorem15.p1.1" class="ltx_p">(1) Based on explicit computations, we observe that Conjecture <a href="#S5.Thmtheorem14" title="Conjecture 5.14. ‣ 5.2. Recursive formulas for characteristic polynomials ‣ 5. Characteristic polynomial of ℳ̄_{0,𝑛} ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.14</span></a>(2) does <em id="S5.Thmtheorem15.p1.1.1" class="ltx_emph ltx_font_italic">not</em> hold in general for <math id="S5.Thmtheorem15.p1.m1" class="ltx_Math" alttext="\ell=2" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\ell=2</annotation></semantics></math>. The following is the complete list of pairs <math id="S5.Thmtheorem15.p1.m2" class="ltx_Math" alttext="(n,k)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n,k)</annotation></semantics></math> with <math id="S5.Thmtheorem15.p1.m3" class="ltx_Math" alttext="n\leq 72" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≤</mo><mn>72</mn></mrow><annotation encoding="application/x-tex">n\leq 72</annotation></semantics></math> for which the polynomials <math id="S5.Thmtheorem15.p1.m4" class="ltx_Math" alttext="\mathscr{P}_{n}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒫</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{P}_{n}(m,t)</annotation></semantics></math> and <math id="S5.Thmtheorem15.p1.m5" class="ltx_Math" alttext="\mathscr{Q}_{n}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒬</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{Q}_{n}(m,t)</annotation></semantics></math> fail to be length log-concave in degree <math id="S5.Thmtheorem15.p1.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> at length <math id="S5.Thmtheorem15.p1.m7" class="ltx_Math" alttext="\ell=2" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\ell=2</annotation></semantics></math>.</p>
<ul id="S5.I4" class="ltx_itemize">
<li id="S5.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I4.i1.p1" class="ltx_para">
<p id="S5.I4.i1.p1.1" class="ltx_p">For <math id="S5.I4.i1.p1.m1" class="ltx_Math" alttext="\mathscr{P}_{n}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒫</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{P}_{n}(m,t)</annotation></semantics></math>:</p>
