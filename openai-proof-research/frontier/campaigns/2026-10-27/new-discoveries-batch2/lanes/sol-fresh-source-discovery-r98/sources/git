<div id="S6.Thmtheorem6" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmtheorem6.2" class="ltx_text ltx_font_bold">Theorem 6.6</span></span><span id="S6.Thmtheorem6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmtheorem6.p1" class="ltx_para">
<p id="S6.Thmtheorem6.p1.1" class="ltx_p"><span id="S6.Thmtheorem6.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S6.Thmtheorem6.p1.m1" class="ltx_Math" alttext="k,j\in\mathbb{Z}_{\geq 0}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><msub><mi>ℤ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">k,j\in\mathbb{Z}_{\geq 0}</annotation></semantics></math>. Then, as a function of <math id="S6.Thmtheorem6.p1.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>,</span></p>
<table id="S6.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex13.m1" class="ltx_Math" alttext="\mathscr{Q}_{n,k}^{n-j}=c_{k}\cdot\frac{(k+1)^{n-j}c(n,n-j)}{n!}+O\left(\frac{k^{n}n^{2j}}{n!}\right)\ \ \ \text{and}" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathscript">𝒬</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></msubsup><mo>=</mo><mrow><mrow><msub><mi>c</mi><mi>k</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>n</mi><mo>!</mo></mrow></mfrac></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msup><mi>k</mi><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msup></mrow><mrow><mi>n</mi><mo>!</mo></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mspace style="width:1.5em;" width="1.5em"></mspace><mtext class="ltx_mathvariant_italic">and</mtext></mrow><annotation encoding="application/x-tex">\mathscr{Q}_{n,k}^{n-j}=c_{k}\cdot\frac{(k+1)^{n-j}c(n,n-j)}{n!}+O\left(\frac{k^{n}n^{2j}}{n!}\right)\ \ \ \text{and}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="S6.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex14.m1" class="ltx_Math" alttext="\mathscr{P}_{n,k}^{n-j}=d_{k}\cdot\frac{(k+1)^{n-j}c(n,n-j)}{n!}+o\left(\frac{(k+1)^{n}n^{2j}}{n!}\right)." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathscript">𝒫</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></msubsup><mo>=</mo><mrow><mrow><msub><mi>d</mi><mi>k</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>n</mi><mo>!</mo></mrow></mfrac></mrow><mo>+</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msup></mrow><mrow><mi>n</mi><mo>!</mo></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathscr{P}_{n,k}^{n-j}=d_{k}\cdot\frac{(k+1)^{n-j}c(n,n-j)}{n!}+o\left(\frac{(k+1)^{n}n^{2j}}{n!}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S6.SS1.p4" class="ltx_para">
<p id="S6.SS1.p4.1" class="ltx_p">We remark that <math id="S6.SS1.p4.m1" class="ltx_Math" alttext="O(\frac{(k+1)^{n-j}c(n,n-j)}{n!})=O(\frac{(k+1)^{n}n^{2j}}{n!})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mfrac><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>n</mi><mo>!</mo></mrow></mfrac><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mfrac><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msup></mrow><mrow><mi>n</mi><mo>!</mo></mrow></mfrac><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">O(\frac{(k+1)^{n-j}c(n,n-j)}{n!})=O(\frac{(k+1)^{n}n^{2j}}{n!})</annotation></semantics></math>, as <math id="S6.SS1.p4.m2" class="ltx_Math" alttext="c(n,n-j)" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">c(n,n-j)</annotation></semantics></math> and <math id="S6.SS1.p4.m3" class="ltx_Math" alttext="\frac{n^{2j}}{2^{j}j!}" display="inline" intent=":literal"><semantics><mfrac><msup><mi>n</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msup><mrow><mrow><msup><mn>2</mn><mi>j</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>!</mo></mrow></mfrac><annotation encoding="application/x-tex">\frac{n^{2j}}{2^{j}j!}</annotation></semantics></math> are asymptotically equal, that is, their ratio converges to 1 as <math id="S6.SS1.p4.m4" class="ltx_Math" alttext="n\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">n\to\infty</annotation></semantics></math>.</p>
</div>
<div id="S6.SS1.p5" class="ltx_para">
<p id="S6.SS1.p5.1" class="ltx_p">See §<a href="#S7.SS4" title="7.4. Proof of Theorem ‣ 7. Proofs of asymptotic formulas ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.4</span></a> for a proof of Theorem <a href="#S6.Thmtheorem6" title="Theorem 6.6. ‣ 6.1. Asymptotic formulas ‣ 6. Asymptotic behavior and log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.6</span></a>.</p>
</div>
<div id="S6.Thmtheorem7" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmtheorem7.2" class="ltx_text ltx_font_bold">Remark 6.7</span></span><span id="S6.Thmtheorem7.3" class="ltx_text ltx_font_bold"> </span>(Leading coefficients)<span id="S6.Thmtheorem7.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmtheorem7.p1" class="ltx_para">
<p id="S6.Thmtheorem7.p1.1" class="ltx_p">The first formula in Theorem <a href="#S6.Thmtheorem6" title="Theorem 6.6. ‣ 6.1. Asymptotic formulas ‣ 6. Asymptotic behavior and log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.6</span></a> with <math id="S6.Thmtheorem7.p1.m1" class="ltx_Math" alttext="j=0" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">j=0</annotation></semantics></math> and Lemma <a href="#S3.Thmtheorem10" title="Lemma 3.10. ‣ 3.4. Characteristic polynomial of an 𝕊_𝑛-representation ‣ 3. Characteristic polynomials of symmetric functions and representations ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.10</span></a> (1) imply that</p>
<table id="S6.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex15.m1" class="ltx_Math" alttext="\frac{h^{2k}(\overline{{\cal M}}_{0,n+1})}{n!}=\mathscr{Q}_{n,k}^{n}=c_{k}\cdot\frac{(k+1)^{n}}{n!}+O(\frac{k^{n}}{n!})." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><msup><mi>h</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>n</mi><mo>!</mo></mrow></mfrac><mo>=</mo><msubsup><mi class="ltx_font_mathscript">𝒬</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow><mi>n</mi></msubsup><mo>=</mo><mrow><mrow><msub><mi>c</mi><mi>k</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>n</mi></msup><mrow><mi>n</mi><mo>!</mo></mrow></mfrac></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mfrac><msup><mi>k</mi><mi>n</mi></msup><mrow><mi>n</mi><mo>!</mo></mrow></mfrac><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{h^{2k}(\overline{{\cal M}}_{0,n+1})}{n!}=\mathscr{Q}_{n,k}^{n}=c_{k}\cdot\frac{(k+1)^{n}}{n!}+O(\frac{k^{n}}{n!}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.Thmtheorem7.p1.2" class="ltx_p">We thus obtain</p>
<table id="S6.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex16.m1" class="ltx_Math" alttext="\lim_{n\to\infty}\frac{h^{2k}(\overline{{\cal M}}_{0,n+1})}{(k+1)^{n}}=c_{k}" display="block" intent=":literal"><semantics><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mfrac><mrow><msup><mi>h</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>ℳ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>0</mn><mo>,</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>n</mi></msup></mfrac></mrow><mo>=</mo><msub><mi>c</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">\lim_{n\to\infty}\frac{h^{2k}(\overline{{\cal M}}_{0,n+1})}{(k+1)^{n}}=c_{k}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.Thmtheorem7.p1.3" class="ltx_p">which is a result of Aluffi-Chen-Marcolli (cf. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib3" title="" class="ltx_ref">3</a>, Theorem 1.3]</cite> with <math id="S6.Thmtheorem7.p1.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> replaced by <math id="S6.Thmtheorem7.p1.m3" class="ltx_Math" alttext="n+1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n+1</annotation></semantics></math>).</p>
</div>
</div>
<div id="S6.Thmtheorem8" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmtheorem8.2" class="ltx_text ltx_font_bold">Remark 6.8</span></span><span id="S6.Thmtheorem8.3" class="ltx_text ltx_font_bold"> </span>(Linear terms)<span id="S6.Thmtheorem8.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmtheorem8.p1" class="ltx_para">
<p id="S6.Thmtheorem8.p1.1" class="ltx_p">An analogous statement for <math id="S6.Thmtheorem8.p1.m1" class="ltx_Math" alttext="\mathscr{Q}^{j}_{n,k}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathscript">𝒬</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow><mi>j</mi></msubsup><annotation encoding="application/x-tex">\mathscr{Q}^{j}_{n,k}</annotation></semantics></math> is not true. This failure can be observed even for the linear terms.
Note that <math id="S6.Thmtheorem8.p1.m2" class="ltx_Math" alttext="\mathscr{Q}_{n,k}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">𝒬</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">\mathscr{Q}_{n,k}</annotation></semantics></math> is always divisible by <math id="S6.Thmtheorem8.p1.m3" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math>. One can see from (<a href="#S3.E19" title="In Example 3.14 (Permutation representations). ‣ 3.5. First examples ‣ 3. Characteristic polynomials of symmetric functions and representations ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.19</span></a>) that <math id="S6.Thmtheorem8.p1.m4" class="ltx_Math" alttext="\mathscr{Q}_{n,k}^{1}=\frac{1}{n}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathscript">𝒬</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow><mn>1</mn></msubsup><mo>=</mo><mfrac><mn>1</mn><mi>n</mi></mfrac></mrow><annotation encoding="application/x-tex">\mathscr{Q}_{n,k}^{1}=\frac{1}{n}</annotation></semantics></math> whenever <math id="S6.Thmtheorem8.p1.m5" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> is a prime number. Indeed, when <math id="S6.Thmtheorem8.p1.m6" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> is prime, <math id="S6.Thmtheorem8.p1.m7" class="ltx_Math" alttext="\mathrm{Stab}(T)\subset\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><msub><mi>𝕊</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\mathrm{Stab}(T)\subset\mathbb{S}_{n}</annotation></semantics></math> contains an <math id="S6.Thmtheorem8.p1.m8" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-cycle only if <math id="S6.Thmtheorem8.p1.m9" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> has only one vertex and <math id="S6.Thmtheorem8.p1.m10" class="ltx_Math" alttext="\mathrm{Stab}(T)=\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>𝕊</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\mathrm{Stab}(T)=\mathbb{S}_{n}</annotation></semantics></math>. Since the number of <math id="S6.Thmtheorem8.p1.m11" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-cycles in <math id="S6.Thmtheorem8.p1.m12" class="ltx_Math" alttext="\mathrm{Stab}(T)=\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>𝕊</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\mathrm{Stab}(T)=\mathbb{S}_{n}</annotation></semantics></math> is precisely <math id="S6.Thmtheorem8.p1.m13" class="ltx_Math" alttext="(n-1)!" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow><annotation encoding="application/x-tex">(n-1)!</annotation></semantics></math>, the coefficient of <math id="S6.Thmtheorem8.p1.m14" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> is <math id="S6.Thmtheorem8.p1.m15" class="ltx_Math" alttext="\frac{(n-1)!}{n!}=\frac{1}{n}" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow><mrow><mi>n</mi><mo>!</mo></mrow></mfrac><mo>=</mo><mfrac><mn>1</mn><mi>n</mi></mfrac></mrow><annotation encoding="application/x-tex">\frac{(n-1)!}{n!}=\frac{1}{n}</annotation></semantics></math>.</p>
</div>
<div id="S6.Thmtheorem8.p2" class="ltx_para">
<p id="S6.Thmtheorem8.p2.1" class="ltx_p">On the other hand, when <math id="S6.Thmtheorem8.p2.m1" class="ltx_Math" alttext="n=2p\geq 6" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>≥</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">n=2p\geq 6</annotation></semantics></math> for a prime <math id="S6.Thmtheorem8.p2.m2" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>, the weighted rooted tree <math id="S6.Thmtheorem8.p2.m3" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> consisting of two non-root vertices attached to the root, each with <math id="S6.Thmtheorem8.p2.m4" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math> inputs, contributes an additional <math id="S6.Thmtheorem8.p2.m5" class="ltx_Math" alttext="\frac{1}{n}" display="inline" intent=":literal"><semantics><mfrac><mn>1</mn><mi>n</mi></mfrac><annotation encoding="application/x-tex">\frac{1}{n}</annotation></semantics></math>, provided that <math id="S6.Thmtheorem8.p2.m6" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> satisfies the valency conditions (cf. Definition <a href="#S5.Thmtheorem4" title="Definition 5.4. ‣ 5.1. Recursive formulas for the representations ‣ 5. Characteristic polynomial of ℳ̄_{0,𝑛} ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.4</span></a>).</p>
</div>
<div id="S6.Thmtheorem8.p3" class="ltx_para">
<p id="S6.Thmtheorem8.p3.1" class="ltx_p">More generally, by the same argument using (<a href="#S3.E19" title="In Example 3.14 (Permutation representations). ‣ 3.5. First examples ‣ 3. Characteristic polynomials of symmetric functions and representations ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.19</span></a>), one can check that</p>
<table id="S6.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(6.1)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.E1.m1" class="ltx_Math" alttext="\mathscr{Q}_{n,k}^{1}=\frac{1}{n}+\frac{1}{n}\sum_{k_{0}=0}^{k-2}N_{n,k}(k_{0})," display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathscript">𝒬</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow><mn>1</mn></msubsup><mo>=</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo>+</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><msub><mi>k</mi><mn>0</mn></msub><mo>=</mo><mn>0</mn></mrow><mrow><mi>k</mi><mo>−</mo><mn>2</mn></mrow></munderover><mrow><msub><mi>N</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathscr{Q}_{n,k}^{1}=\frac{1}{n}+\frac{1}{n}\sum_{k_{0}=0}^{k-2}N_{n,k}(k_{0}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.Thmtheorem8.p3.2" class="ltx_p">where for <math id="S6.Thmtheorem8.p3.m1" class="ltx_Math" alttext="0\leq k_{0}\leq k-2" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><msub><mi>k</mi><mn>0</mn></msub><mo>≤</mo><mrow><mi>k</mi><mo>−</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">0\leq k_{0}\leq k-2</annotation></semantics></math>, the integers <math id="S6.Thmtheorem8.p3.m2" class="ltx_Math" alttext="N_{n,k}(k_{0})" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">N_{n,k}(k_{0})</annotation></semantics></math> are defined as</p>
<table id="S6.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex17.m1" class="ltx_math_unparsed" alttext="N_{n,k}(k_{0}):=\left\lvert\left\{r\in\mathbb{Z}_{&gt;1}:k_{0}+2\leq r\leq\frac{n-k+k_{0}}{2}~\text{ and }~r\mid gcd(n,k-k_{0})\right\}\right\rvert." display="block" intent=":literal"><semantics><mrow><msub><mi>N</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo>:=</mo><mrow><mo>|</mo><mrow><mo>{</mo><mi>r</mi><mo>∈</mo><msub><mi>ℤ</mi><mrow><mphantom></mphantom><mo>&gt;</mo><mn>1</mn></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><msub><mi>k</mi><mn>0</mn></msub><mo>+</mo><mn>2</mn><mo>≤</mo><mi>r</mi><mo>≤</mo><mfrac><mrow><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow><mo>+</mo><msub><mi>k</mi><mn>0</mn></msub></mrow><mn>2</mn></mfrac><mtext> and </mtext><mi>r</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>g</mi><mi>c</mi><mi>d</mi><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>k</mi><mo>−</mo><msub><mi>k</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo>}</mo></mrow><mo>|</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">N_{n,k}(k_{0}):=\left\lvert\left\{r\in\mathbb{Z}_{&gt;1}:k_{0}+2\leq r\leq\frac{n-k+k_{0}}{2}~\text{ and }~r\mid gcd(n,k-k_{0})\right\}\right\rvert.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.Thmtheorem8.p3.3" class="ltx_p">The number <math id="S6.Thmtheorem8.p3.m3" class="ltx_Math" alttext="N_{n,k}(k_{0})" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">N_{n,k}(k_{0})</annotation></semantics></math> is the contribution from the weighted rooted trees having <math id="S6.Thmtheorem8.p3.m4" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> non-root vertices attached to the root, each with <math id="S6.Thmtheorem8.p3.m5" class="ltx_Math" alttext="\frac{n}{r}" display="inline" intent=":literal"><semantics><mfrac><mi>n</mi><mi>r</mi></mfrac><annotation encoding="application/x-tex">\frac{n}{r}</annotation></semantics></math> inputs, where the root vertex has weight <math id="S6.Thmtheorem8.p3.m6" class="ltx_Math" alttext="k_{0}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mn>0</mn></msub><annotation encoding="application/x-tex">k_{0}</annotation></semantics></math> and non-root vertices have weight <math id="S6.Thmtheorem8.p3.m7" class="ltx_Math" alttext="\frac{k-k_{0}}{r}" display="inline" intent=":literal"><semantics><mfrac><mrow><mi>k</mi><mo>−</mo><msub><mi>k</mi><mn>0</mn></msub></mrow><mi>r</mi></mfrac><annotation encoding="application/x-tex">\frac{k-k_{0}}{r}</annotation></semantics></math>.</p>
</div>
</div>
</section>
<section id="S6.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">6.2. </span>Asymptotic log-concavity</h3>

<div id="S6.SS2.p1" class="ltx_para">
<p id="S6.SS2.p1.1" class="ltx_p">From Theorem <a href="#S6.Thmtheorem1" title="Theorem 6.1. ‣ 6.1. Asymptotic formulas ‣ 6. Asymptotic behavior and log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.1</span></a>, we obtain the asymptotic degree log-concavity at <math id="S6.SS2.p1.m1" class="ltx_Math" alttext="m=m_{0}\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>=</mo><msub><mi>m</mi><mn>0</mn></msub><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">m=m_{0}\geq 1</annotation></semantics></math> of <math id="S6.SS2.p1.m2" class="ltx_Math" alttext="\mathscr{P}_{n}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒫</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{P}_{n}(m,t)</annotation></semantics></math> and <math id="S6.SS2.p1.m3" class="ltx_Math" alttext="\mathscr{Q}_{n}(m,t)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathscript">𝒬</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathscr{Q}_{n}(m,t)</annotation></semantics></math>.</p>
</div>
<div id="S6.Thmtheorem9" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmtheorem9.2" class="ltx_text ltx_font_bold">Corollary 6.9</span></span><span id="S6.Thmtheorem9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmtheorem9.p1" class="ltx_para">
<p id="S6.Thmtheorem9.p1.1" class="ltx_p"><span id="S6.Thmtheorem9.p1.1.1" class="ltx_text ltx_font_italic">Fix <math id="S6.Thmtheorem9.p1.m1" class="ltx_Math" alttext="m_{0},k\geq 1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>m</mi><mn>0</mn></msub><mo>,</mo><mi>k</mi></mrow><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">m_{0},k\geq 1</annotation></semantics></math>. Then we have</span></p>
<table id="S6.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex18.m1" class="ltx_Math" alttext="\begin{split}&amp;\mathscr{P}_{n,k}(m_{0})^{2}\geq\mathscr{P}_{n,k-1}(m_{0})\mathscr{P}_{n,k+1}(m_{0})~\text{ and}\\
&amp;\mathscr{Q}_{n,k}(m_{0})^{2}\geq\mathscr{Q}_{n,k-1}(m_{0})\mathscr{Q}_{n,k+1}(m_{0})\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi class="ltx_font_mathscript">𝒫</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>≥</mo><mrow><msub><mi class="ltx_font_mathscript">𝒫</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒫</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.660em" rspace="0em">​</mo><mtext class="ltx_mathvariant_italic"> and</mtext></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi class="ltx_font_mathscript">𝒬</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>≥</mo><mrow><msub><mi class="ltx_font_mathscript">𝒬</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒬</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}&amp;\mathscr{P}_{n,k}(m_{0})^{2}\geq\mathscr{P}_{n,k-1}(m_{0})\mathscr{P}_{n,k+1}(m_{0})~\text{ and}\\
&amp;\mathscr{Q}_{n,k}(m_{0})^{2}\geq\mathscr{Q}_{n,k-1}(m_{0})\mathscr{Q}_{n,k+1}(m_{0})\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.Thmtheorem9.p1.2" class="ltx_p"><span id="S6.Thmtheorem9.p1.2.1" class="ltx_text ltx_font_italic">for sufficiently large <math id="S6.Thmtheorem9.p1.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>. Moreover, when <math id="S6.Thmtheorem9.p1.m3" class="ltx_Math" alttext="m_{0}&gt;1" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mn>0</mn></msub><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">m_{0}&gt;1</annotation></semantics></math>, the inequalities are strict.</span></p>
</div>
</div>
<div id="S6.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S6.SS2.p2" class="ltx_para">
<p id="S6.SS2.p2.1" class="ltx_p"><span id="S6.SS2.p2.1.1" class="ltx_text">By Theorem <a href="#S6.Thmtheorem1" title="Theorem 6.1. ‣ 6.1. Asymptotic formulas ‣ 6. Asymptotic behavior and log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.1</span></a>, it suffices to show that the sequences</span></p>
<table id="S6.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex19.m1" class="ltx_Math" alttext="\left\{\frac{c_{k}}{((k+1)m_{0}-1)!}\right\}_{k\geq 0}\left\{\frac{d_{k}}{((k+1)m_{0}-1)!}\right\}_{k\geq 0}" display="block" intent=":literal"><semantics><mrow><msub><mrow><mo>{</mo><mfrac><msub><mi>c</mi><mi>k</mi></msub><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>0</mn></msub></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow></mfrac><mo>}</mo></mrow><mrow><mi>k</mi><mo>≥</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>{</mo><mfrac><msub><mi>d</mi><mi>k</mi></msub><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>0</mn></msub></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow></mfrac><mo>}</mo></mrow><mrow><mi>k</mi><mo>≥</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\left\{\frac{c_{k}}{((k+1)m_{0}-1)!}\right\}_{k\geq 0}\left\{\frac{d_{k}}{((k+1)m_{0}-1)!}\right\}_{k\geq 0}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.SS2.p2.2" class="ltx_p"><span id="S6.SS2.p2.2.1" class="ltx_text">are log-concave.
Since the case of <math id="S6.SS2.p2.m1" class="ltx_Math" alttext="m_{0}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mn>0</mn></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">m_{0}=1</annotation></semantics></math> was already proved in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib11" title="" class="ltx_ref">11</a>]</cite>, we may assume <math id="S6.SS2.p2.m2" class="ltx_Math" alttext="m_{0}&gt;1" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mn>0</mn></msub><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">m_{0}&gt;1</annotation></semantics></math>.
Then, one can check that</span></p>
<table id="S6.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex20.m1" class="ltx_Math" alttext="\begin{split}\frac{(km_{0}-1)!((k+2)m_{0}-1)!}{(((k+1)m_{0}-1)!)^{2}}&amp;=\frac{(km_{0}+m_{0})}{km_{0}}\frac{(km_{0}+m_{0}+1)}{km_{0}+1}\cdots\frac{(km_{0}+2m_{0}-1)}{(km_{0}+m_{0}-1)}\\
&amp;=\prod_{i=0}^{m_{0}-1}\left(1+\frac{m_{0}}{km_{0}+i}\right)&gt;1+\frac{1}{k}=\frac{k+1}{k},\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mfrac><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>0</mn></msub></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>0</mn></msub></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>!</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>0</mn></msub></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>=</mo><mfrac><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>0</mn></msub></mrow><mo>+</mo><msub><mi>m</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>0</mn></msub></mrow></mfrac><mfrac><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>0</mn></msub></mrow><mo>+</mo><msub><mi>m</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>0</mn></msub></mr