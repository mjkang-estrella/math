<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex10.m1" class="ltx_Math" alttext="\begin{split}&amp;\sum_{a\geq 3,\;b\geq 2}\Big(\kern-3.00003pt\Big(\genfrac{}{}{0.0pt}{}{m_0}{a}\Big)\kern-3.00003pt\Big)\cdot\Big(\kern-3.00003pt\Big(\genfrac{}{}{0.0pt}{}{m_0}{b}\Big)\kern-3.00003pt\Big)\cdot\Big(\kern-3.00003pt\Big(\genfrac{}{}{0.0pt}{}{m_0}{n-a-b}\Big)\kern-3.00003pt\Big)\\
&amp;+\sum_{\begin{subarray}{c}3\leq a&lt;b\leq n,\\
