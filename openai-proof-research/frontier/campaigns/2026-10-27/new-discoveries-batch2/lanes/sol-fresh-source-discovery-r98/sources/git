<mfrac><mrow><msub><mi>c</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn><mo>−</mo><mi>j</mi></mrow></msub></mrow><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>0</mn></msub></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>0</mn></msub></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>!</mo></mrow></mfrac><mo lspace="0.222em">⋅</mo><mo lspace="0.055em" movablelimits="false" rspace="0em">lim</mo><msub><mrow></mrow><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mo movablelimits="false">∑</mo><msub><mrow></mrow><mrow><mi>h</mi><mo>=</mo><mn>2</mn></mrow></msub><msup><mrow></mrow><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></msup><mfrac><mrow><msup><mi>h</mi><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>0</mn></msub></mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><msup><mi>n</mi><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>0</mn></msub></mrow><mo>−</mo><mn>1</mn></mrow></msup></mfrac><mo>,</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}&amp;\lim_{n\to\infty}\frac{\mathscr{P}_{n,k}(m_{0})+\mathscr{P}_{n,k-1}(m_{0})}{n^{(k+1)m_{0}-1}}=\frac{c_{k}}{((k+1)m_{0}-1)!}\\
&amp;-\frac{1}{2}\sum_{j=0}^{k-1}\frac{c_{j}c_{k-1-j}}{((j+1)m_{0}-1)!((k-j)m_{0}-1)!}\cdot\lim_{n\to\infty}\sum_{h=2}^{n-2}\frac{h^{(j+1)m-1}(n-h)^{(k-j)m_{0}-1}}{n^{(k+1)m_{0}-1}},\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.p4.2" class="ltx_p">due to (<a href="#S7.E2" title="In 7.1. Proof of Theorem ‣ 7. Proofs of asymptotic formulas ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.2</span></a>). Indeed, for integers <math id="S7.SS1.p4.m3" class="ltx_Math" alttext="a,b,c\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mrow><mi>c</mi><mo>≥</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">a,b,c\geq 0</annotation></semantics></math>,</p>
<table id="S7.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex6.m1" class="ltx_Math" alttext="\lim_{n\to\infty}\sum_{h=2}^{n-2}h^{a}(n-h)^{b}\frac{1}{n^{c+1}}=\int_{0}^{1}x^{a}(1-x)^{b}dx=\frac{a!b!}{(a+b+1)!}" display="block" intent=":literal"><semantics><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mrow><munderover><mo lspace="0.167em" movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>2</mn></mrow><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></munderover><mrow><msup><mi>h</mi><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow><mi>b</mi></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><msup><mi>n</mi><mrow><mi>c</mi><mo>+</mo><mn>1</mn></mrow></msup></mfrac></mrow></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∫</mo><mn>0</mn><mn>1</mn></msubsup><mrow><msup><mi>x</mi><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mi>b</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow><mo>=</mo><mfrac><mrow><mrow><mrow><mi>a</mi><mo>!</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow><mo>!</mo></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>+</mo><mi>b</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow></mfrac></mrow><annotation encoding="application/x-tex">\lim_{n\to\infty}\sum_{h=2}^{n-2}h^{a}(n-h)^{b}\frac{1}{n^{c+1}}=\int_{0}^{1}x^{a}(1-x)^{b}dx=\frac{a!b!}{(a+b+1)!}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.p4.3" class="ltx_p">if <math id="S7.SS1.p4.m4" class="ltx_Math" alttext="a+b=c" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo>=</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">a+b=c</annotation></semantics></math>, and hence it vanishes if <math id="S7.SS1.p4.m5" class="ltx_Math" alttext="a+b&lt;c" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo>&lt;</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">a+b&lt;c</annotation></semantics></math>. This also implies that</p>
<table id="S7.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex7.m1" class="ltx_Math" alttext="\begin{split}&amp;\lim_{n\to\infty}\frac{\mathscr{P}_{n,k}(m_{0})+\mathscr{P}_{n,k-1}(m_{0})}{n^{(k+1)m_{0}-1}}=\frac{1}{((k+1)m_{0}-1)!}\Big(c_{k}-\frac{1}{2}\sum_{j=0}^{k-1}c_{j}c_{k-1-j}\Big),\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mfrac><mrow><mrow><msub><mi class="ltx_font_mathscript">𝒫</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi class="ltx_font_mathscript">𝒫</mi><mrow><mi>n</mi><mo>,</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>m</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><msup><mi>n</mi><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>0</mn></msub></mrow><mo>−</mo><mn>1</mn></mrow></msup></mfrac></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>0</mn></msub></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msub><mi>c</mi><mi>k</mi></msub><mo>−</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><msub><mi>c</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn><mo>−</mo><mi>j</mi></mrow></msub></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo>,</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}&amp;\lim_{n\to\infty}\frac{\mathscr{P}_{n,k}(m_{0})+\mathscr{P}_{n,k-1}(m_{0})}{n^{(k+1)m_{0}-1}}=\frac{1}{((k+1)m_{0}-1)!}\Big(c_{k}-\frac{1}{2}\sum_{j=0}^{k-1}c_{j}c_{k-1-j}\Big),\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS1.p4.4" class="ltx_p">which is equal to <math id="S7.SS1.p4.m6" class="ltx_Math" alttext="{d_{k}}/{((k+1)m_{0}-1)!}" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>k</mi></msub><mo>/</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mn>0</mn></msub></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow></mrow><annotation encoding="application/x-tex">{d_{k}}/{((k+1)m_{0}-1)!}</annotation></semantics></math> as checked in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib11" title="" class="ltx_ref">11</a>, Theorem 6.9]</cite>.
Now the second formula in Theorem <a href="#S6.Thmtheorem1" title="Theorem 6.1. ‣ 6.1. Asymptotic formulas ‣ 6. Asymptotic behavior and log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.1</span></a> follows by an induction on <math id="S7.SS1.p4.m7" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>.
 ∎
<br class="ltx_break"></p>
</div>
<div id="S7.SS1.p5" class="ltx_para">
<p id="S7.SS1.p5.1" class="ltx_p">The rest of this section is devoted to a proof of Theorem <a href="#S6.Thmtheorem6" title="Theorem 6.6. ‣ 6.1. Asymptotic formulas ‣ 6. Asymptotic behavior and log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.6</span></a>.
It requires certain facts about <math id="S7.SS1.p5.m1" class="ltx_Math" alttext="\mathrm{Stab}(T)" display="inline" intent=":literal"><semantics><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Stab}(T)</annotation></semantics></math>, as described in the following subsections.</p>
</div>
</section>
<section id="S7.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">7.2. </span>Stratifications of <math id="S7.SS2.m1" class="ltx_Math" alttext="\mathrm{Stab}(T)" display="inline" intent=":literal"><semantics><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Stab}(T)</annotation></semantics></math></h3>

<div id="S7.SS2.p1" class="ltx_para">
<p id="S7.SS2.p1.1" class="ltx_p">For a labeled weighted rooted tree <math id="S7.SS2.p1.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>,
let <math id="S7.SS2.p1.m2" class="ltx_Math" alttext="F(T)" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F(T)</annotation></semantics></math> denote the weighted rooted tree without inputs obtained from <math id="S7.SS2.p1.m3" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> by forgetting the inputs.
Recall that <math id="S7.SS2.p1.m4" class="ltx_Math" alttext="\Aut(F(T))\subset\mathbb{S}_{V(F(T))}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Aut</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><msub><mi>𝕊</mi><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\Aut(F(T))\subset\mathbb{S}_{V(F(T))}</annotation></semantics></math> consists of elements whose actions on <math id="S7.SS2.p1.m5" class="ltx_Math" alttext="V(T)=V(F(T))" display="inline" intent=":literal"><semantics><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">V(T)=V(F(T))</annotation></semantics></math> preserve the isomorphism class of <math id="S7.SS2.p1.m6" class="ltx_Math" alttext="F(T)" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F(T)</annotation></semantics></math> as a weighted rooted tree. Then, the natural group homomorphism <math id="S7.SS2.p1.m7" class="ltx_Math" alttext="\mathrm{Stab}(T)\to\mathbb{S}_{V(T)}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><msub><mi>𝕊</mi><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\mathrm{Stab}(T)\to\mathbb{S}_{V(T)}</annotation></semantics></math> factors through <math id="S7.SS2.p1.m8" class="ltx_Math" alttext="\Aut(F(T))" display="inline" intent=":literal"><semantics><mrow><mi>Aut</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Aut(F(T))</annotation></semantics></math>.</p>
</div>
<div id="S7.SS2.p2" class="ltx_para">
<p id="S7.SS2.p2.1" class="ltx_p">Let <math id="S7.SS2.p2.m1" class="ltx_Math" alttext="\lambda(T)" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda(T)</annotation></semantics></math> denote the partition of the set of the inputs according to the vertices of <math id="S7.SS2.p2.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> they are attached to. This defines a subgroup <math id="S7.SS2.p2.m3" class="ltx_Math" alttext="\mathbb{S}_{\lambda(T)}\subset\mathrm{Stab}(T)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝕊</mi><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>⊂</mo><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{S}_{\lambda(T)}\subset\mathrm{Stab}(T)</annotation></semantics></math>.</p>
</div>
<div id="S7.Thmtheorem1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmtheorem1.2" class="ltx_text ltx_font_bold">Lemma 7.1</span></span><span id="S7.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmtheorem1.p1" class="ltx_para">
<p id="S7.Thmtheorem1.p1.1" class="ltx_p"><span id="S7.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S7.Thmtheorem1.p1.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> be a labeled rooted tree. Let <math id="S7.Thmtheorem1.p1.m2" class="ltx_Math" alttext="\bar{T}=F(T)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo>=</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bar{T}=F(T)</annotation></semantics></math>. Then <math id="S7.Thmtheorem1.p1.m3" class="ltx_Math" alttext="\mathbb{S}_{\lambda(T)}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\mathbb{S}_{\lambda(T)}</annotation></semantics></math> is the kernel of the group homomorphism <math id="S7.Thmtheorem1.p1.m4" class="ltx_Math" alttext="\mathrm{Stab}(T)\to\Aut(\bar{T})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>Aut</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Stab}(T)\to\Aut(\bar{T})</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S7.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S7.SS2.p3" class="ltx_para">
<p id="S7.SS2.p3.1" class="ltx_p"><span id="S7.SS2.p3.1.1" class="ltx_text">This follows from the inductive construction of <math id="S7.SS2.p3.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> and <math id="S7.SS2.p3.m2" class="ltx_Math" alttext="\mathrm{Stab}(T)" display="inline" intent=":literal"><semantics><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Stab}(T)</annotation></semantics></math> in Lemma <a href="#S5.Thmtheorem16" title="Lemma 5.16. ‣ 5.3. Interpretation as the count of colorings ‣ 5. Characteristic polynomial of ℳ̄_{0,𝑛} ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.16</span></a> and (<a href="#S5.E6" title="In Proof. ‣ 5.3. Interpretation as the count of colorings ‣ 5. Characteristic polynomial of ℳ̄_{0,𝑛} ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.6</span></a>), and that of <math id="S7.SS2.p3.m3" class="ltx_Math" alttext="\bar{T}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>T</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{T}</annotation></semantics></math> and <math id="S7.SS2.p3.m4" class="ltx_Math" alttext="\Aut(\bar{T})" display="inline" intent=":literal"><semantics><mrow><mi>Aut</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Aut(\bar{T})</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S7.Thmtheorem2" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmtheorem2.2" class="ltx_text ltx_font_bold">Example 7.2</span></span><span id="S7.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmtheorem2.p1" class="ltx_para">
<p id="S7.Thmtheorem2.p1.1" class="ltx_p">Let <math id="S7.Thmtheorem2.p1.m1" class="ltx_Math" alttext="\bar{T}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>T</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{T}</annotation></semantics></math> be the weighted rooted tree without inputs and with <math id="S7.Thmtheorem2.p1.m2" class="ltx_Math" alttext="V(\bar{T})=\{v_{0},v_{1},v_{2},v_{3}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>v</mi><mn>0</mn></msub><mo>,</mo><msub><mi>v</mi><mn>1</mn></msub><mo>,</mo><msub><mi>v</mi><mn>2</mn></msub><mo>,</mo><msub><mi>v</mi><mn>3</mn></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">V(\bar{T})=\{v_{0},v_{1},v_{2},v_{3}\}</annotation></semantics></math>, where <math id="S7.Thmtheorem2.p1.m3" class="ltx_Math" alttext="v_{0}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>0</mn></msub><annotation encoding="application/x-tex">v_{0}</annotation></semantics></math> is the root with weight 0 and the other vertices are adjacent to <math id="S7.Thmtheorem2.p1.m4" class="ltx_Math" alttext="v_{0}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>0</mn></msub><annotation encoding="application/x-tex">v_{0}</annotation></semantics></math> and have weight 1.</p>
</div>
<div id="S7.Thmtheorem2.p2" class="ltx_para">
<p id="S7.Thmtheorem2.p2.1" class="ltx_p">We attach labeled inputs to vertices of <math id="S7.Thmtheorem2.p2.m1" class="ltx_Math" alttext="\bar{T}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>T</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{T}</annotation></semantics></math> to obtain a labeled weighted rooted tree <math id="S7.Thmtheorem2.p2.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>. Assume that <math id="S7.Thmtheorem2.p2.m3" class="ltx_Math" alttext="I=\{1,\cdots,9\}" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mn>9</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">I=\{1,\cdots,9\}</annotation></semantics></math> is the set of all inputs and <math id="S7.Thmtheorem2.p2.m4" class="ltx_Math" alttext="I_{v_{j}}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><msub><mi>v</mi><mi>j</mi></msub></msub><annotation encoding="application/x-tex">I_{v_{j}}</annotation></semantics></math> is the subset of the inputs attached to <math id="S7.Thmtheorem2.p2.m5" class="ltx_Math" alttext="v_{j}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>j</mi></msub><annotation encoding="application/x-tex">v_{j}</annotation></semantics></math> defined as follows:</p>
<table id="S7.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex8.m1" class="ltx_Math" alttext="I=I_{v_{0}}\sqcup I_{v_{1}}\sqcup I_{v_{2}}\sqcup I_{v_{3}}" display="block" intent=":literal"><semantics><mrow><mi>I</mi><mo>=</mo><mrow><msub><mi>I</mi><msub><mi>v</mi><mn>0</mn></msub></msub><mo>⊔</mo><msub><mi>I</mi><msub><mi>v</mi><mn>1</mn></msub></msub><mo>⊔</mo><msub><mi>I</mi><msub><mi>v</mi><mn>2</mn></msub></msub><mo>⊔</mo><msub><mi>I</mi><msub><mi>v</mi><mn>3</mn></msub></msub></mrow></mrow><annotation encoding="application/x-tex">I=I_{v_{0}}\sqcup I_{v_{1}}\sqcup I_{v_{2}}\sqcup I_{v_{3}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.Thmtheorem2.p2.2" class="ltx_p">with <math id="S7.Thmtheorem2.p2.m6" class="ltx_Math" alttext="I_{v_{0}}=\emptyset" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><msub><mi>v</mi><mn>0</mn></msub></msub><mo>=</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">I_{v_{0}}=\emptyset</annotation></semantics></math>,
<math id="S7.Thmtheorem2.p2.m7" class="ltx_Math" alttext="I_{v_{1}}=\{1,4,7\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><msub><mi>v</mi><mn>1</mn></msub></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>7</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">I_{v_{1}}=\{1,4,7\}</annotation></semantics></math>, <math id="S7.Thmtheorem2.p2.m8" class="ltx_Math" alttext="I_{v_{2}}=\{2,5,8\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><msub><mi>v</mi><mn>2</mn></msub></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mn>2</mn><mo>,</mo><mn>5</mn><mo>,</mo><mn>8</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">I_{v_{2}}=\{2,5,8\}</annotation></semantics></math> and <math id="S7.Thmtheorem2.p2.m9" class="ltx_Math" alttext="I_{v_{3}}=\{3,6,9\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><msub><mi>v</mi><mn>3</mn></msub></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mn>3</mn><mo>,</mo><mn>6</mn><mo>,</mo><mn>9</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">I_{v_{3}}=\{3,6,9\}</annotation></semantics></math>.
In particular,</p>
<table id="S7.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex9.m1" class="ltx_Math" alttext="\mathrm{Stab}(T)=(\mathbb{S}_{I_{v_{1}}}\times\mathbb{S}_{I_{v_{2}}}\times\mathbb{S}_{I_{v_{3}}})\rtimes\mathbb{S}_{3}~\subset~\mathbb{S}_{I}=\mathbb{S}_{9}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝕊</mi><msub><mi>I</mi><msub><mi>v</mi><mn>1</mn></msub></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝕊</mi><msub><mi>I</mi><msub><mi>v</mi><mn>2</mn></msub></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝕊</mi><msub><mi>I</mi><msub><mi>v</mi><mn>3</mn></msub></msub></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋊</mo><msub><mi>𝕊</mi><mn>3</mn></msub></mrow><mo rspace="0.608em">⊂</mo><msub><mi>𝕊</mi><mi>I</mi></msub><mo>=</mo><msub><mi>𝕊</mi><mn>9</mn></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathrm{Stab}(T)=(\mathbb{S}_{I_{v_{1}}}\times\mathbb{S}_{I_{v_{2}}}\times\mathbb{S}_{I_{v_{3}}})\rtimes\mathbb{S}_{3}~\subset~\mathbb{S}_{I}=\mathbb{S}_{9},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.Thmtheorem2.p2.3" class="ltx_p">with a splitting given by</p>
<table id="S7.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex10.m1" class="ltx_Math" alttext="\mathbb{S}_{3}\longrightarrow\mathrm{Stab}(T),\quad\tau~\mapsto~\big(3i+j~\mapsto~3i+\tau(j)\in I\big)_{0\leq i\leq 2,1\leq j\leq 3}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝕊</mi><mn>3</mn></msub><mo stretchy="false">⟶</mo><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>τ</mi><mo lspace="0.608em" rspace="0.608em" stretchy="false">↦</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>+</mo><mi>j</mi></mrow><mo lspace="0.608em" rspace="0.608em" stretchy="false">↦</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>+</mo><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>∈</mo><mi>I</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mrow><mn>0</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mn>2</mn></mrow><mo>,</mo><mrow><mn>1</mn><mo>≤</mo><mi>j</mi><mo>≤</mo><mn>3</mn></mrow></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{S}_{3}\longrightarrow\mathrm{Stab}(T),\quad\tau~\mapsto~\big(3i+j~\mapsto~3i+\tau(j)\in I\big)_{0\leq i\leq 2,1\leq j\leq 3}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.Thmtheorem2.p2.4" class="ltx_p">The splitting identifies <math id="S7.Thmtheorem2.p2.m10" class="ltx_Math" alttext="\Aut(\bar{T})=\mathbb{S}_{3}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Aut</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>𝕊</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">\Aut(\bar{T})=\mathbb{S}_{3}</annotation></semantics></math>, as a natural quotient of <math id="S7.Thmtheorem2.p2.m11" class="ltx_Math" alttext="\mathrm{Stab}(T)" display="inline" intent=":literal"><semantics><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Stab}(T)</annotation></semantics></math>.</p>
</div>
<div id="S7.Thmtheorem2.p3" class="ltx_para">
<p id="S7.Thmtheorem2.p3.1" class="ltx_p">More concretely, an element of <math id="S7.Thmtheorem2.p3.m1" class="ltx_Math" alttext="\mathrm{Stab}(T)" display="inline" intent=":literal"><semantics><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Stab}(T)</annotation></semantics></math> is the permutation <math id="S7.Thmtheorem2.p3.m2" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> in <math id="S7.Thmtheorem2.p3.m3" class="ltx_Math" alttext="\mathbb{S}_{I}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><mi>I</mi></msub><annotation encoding="application/x-tex">\mathbb{S}_{I}</annotation></semantics></math> that preserves the partition <math id="S7.Thmtheorem2.p3.m4" class="ltx_Math" alttext="I_{v_{1}}\sqcup I_{v_{2}}\sqcup I_{v_{3}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><msub><mi>v</mi><mn>1</mn></msub></msub><mo>⊔</mo><msub><mi>I</mi><msub><mi>v</mi><mn>2</mn></msub></msub><mo>⊔</mo><msub><mi>I</mi><msub><mi>v</mi><mn>3</mn></msub></msub></mrow><annotation encoding="application/x-tex">I_{v_{1}}\sqcup I_{v_{2}}\sqcup I_{v_{3}}</annotation></semantics></math>, that is, <math id="S7.Thmtheorem2.p3.m5" class="ltx_Math" alttext="\sigma(I_{v_{j}})=I_{\tau(v_{j})}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>I</mi><msub><mi>v</mi><mi>j</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>I</mi><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\sigma(I_{v_{j}})=I_{\tau(v_{j})}</annotation></semantics></math> for each <math id="S7.Thmtheorem2.p3.m6" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> for some permutation <math id="S7.Thmtheorem2.p3.m7" class="ltx_Math" alttext="\tau\in\mathbb{S}_{\{v_{1},v_{2},v_{3}\}}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><msub><mi>𝕊</mi><mrow><mo stretchy="false">{</mo><msub><mi>v</mi><mn>1</mn></msub><mo>,</mo><msub><mi>v</mi><mn>2</mn></msub><mo>,</mo><msub><mi>v</mi><mn>3</mn></msub><mo stretchy="false">}</mo></mrow></msub></mrow><annotation encoding="application/x-tex">\tau\in\mathbb{S}_{\{v_{1},v_{2},v_{3}\}}</annotation></semantics></math>. In this case, <math id="S7.Thmtheorem2.p3.m8" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> is the image of <math id="S7.Thmtheorem2.p3.m9" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> by the map <math id="S7.Thmtheorem2.p3.m10" class="ltx_Math" alttext="\mathrm{Stab}(T)\to\Aut(\bar{T})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>Aut</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Stab}(T)\to\Aut(\bar{T})</annotation></semantics></math>.</p>
</div>
</div>
<div id="S7.Thmtheorem3" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmtheorem3.2" class="ltx_text ltx_font_bold">Definition 7.3</span></span><span id="S7.Thmtheorem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmtheorem3.p1" class="ltx_para">
<p id="S7.Thmtheorem3.p1.1" class="ltx_p">Let <math id="S7.Thmtheorem3.p1.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> be a labeled weighted rooted tree. Let <math id="S7.Thmtheorem3.p1.m2" class="ltx_Math" alttext="\bar{T}=F(T)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo>=</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bar{T}=F(T)</annotation></semantics></math>. Let <math id="S7.Thmtheorem3.p1.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> be the number of the inputs of <math id="S7.Thmtheorem3.p1.m4" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> so that <math id="S7.Thmtheorem3.p1.m5" class="ltx_Math" alttext="\mathrm{Stab}(T)\subset\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><msub><mi>𝕊</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\mathrm{Stab}(T)\subset\mathbb{S}_{n}</annotation></semantics></math>.</p>
<ol id="S7.I1" class="ltx_enumerate">
<li id="S7.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(1)</span> 
<div id="S7.I1.i1.p1" class="ltx_para">
<p id="S7.I1.i1.p1.1" class="ltx_p">Define the <em id="S7.I1.i1.p1.1.1" class="ltx_emph ltx_font_italic">length</em> of an element <math id="S7.I1.i1.p1.m1" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> in <math id="S7.I1.i1.p1.m2" class="ltx_Math" alttext="\mathrm{Stab}(T)" display="inline" intent=":literal"><semantics><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Stab}(T)</annotation></semantics></math>, denoted by <math id="S7.I1.i1.p1.m3" class="ltx_Math" alttext="\ell(\sigma)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>σ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\ell(\sigma)</annotation></semantics></math>, as the number of disjoint cycles in <math id="S7.I1.i1.p1.m4" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> as an element of <math id="S7.I1.i1.p1.m5" class="ltx_Math" alttext="\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathbb{S}_{n}</annotation></semantics></math>, or equivalently, the number of its orbits in the set of labels. This is also the length of the partition of <math id="S7.I1.i1.p1.m6" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> associated to <math id="S7.I1.i1.p1.m7" class="ltx_Math" alttext="\sigma\in\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>∈</mo><msub><mi>𝕊</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\sigma\in\mathbb{S}_{n}</annotation></semantics></math>.</p>
</div></li>
<li id="S7.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(2)</span> 
<div id="S7.I1.i2.p1" class="ltx_para">
<p id="S7.I1.i2.p1.1" class="ltx_p">Let <math id="S7.I1.i2.p1.m1" class="ltx_Math" alttext="\mathrm{Stab}^{\ell}(T)\subset\mathrm{Stab}(T)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>Stab</mi><mi mathvariant="normal">ℓ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><mi>Stab</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Stab}^{\ell}(T)\subset\mathrm{Stab}(T)</annotation></semantics></math> be the subset of elements of length <math id="S7.I1.i2.p1.m2" class="ltx_Math" alttext="\ell&gt;0" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\ell&gt;0</annotation></semantics></math>.</p>
</div></li>
<li id="S7.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(3)</span> 
<div id="S7.I1.i3.p1" class="ltx_para">
<p id="S7.I1.i3.p1.1" class="ltx_p">Let <math id="S7.I1.i3.p1.m1" class="ltx_Math" alttext="\mathrm{Stab}_{\tau}(T)\subset\mathrm{Stab}(T)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>Stab</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><mrow><mi>Stab</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Stab}_{\tau}(T)\subset\mathrm{Stab}(T)</annotation></semantics></math> be the preimage of <math id="S7.I1.i3.p1.m2" class="ltx_Math" alttext="\tau\in\Aut(\bar{T})" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mrow><mi>Aut</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau\in\Aut(\bar{T})</annotation></semantics></math> under the canonical map <math id="S7.I1.i3.p1.m3" class="ltx_Math" alttext="\mathrm{Stab}(T)\to\Aut(\bar{T})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>Aut</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Stab}(T)\to\Aut(\bar{T})</annotation></semantics></math>.</p>
</div></li>
<li id="S7.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(4)</span> 
<div id="S7.I1.i4.p1" class="ltx_para">
<p id="S7.I1.i4.p1.1" class="ltx_p">Let <math id="S7.I1.i4.p1.m1" class="ltx_Math" alttext="\mathrm{Stab}^{\ell}_{\tau}(T)=\mathrm{Stab}^{\ell}\cap\mathrm{Stab}_{\tau}(T)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>Stab</mi><mi>τ</mi><mi mathvariant="normal">ℓ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>Stab</mi><mi mathvariant="normal">ℓ</mi></msup><mo>∩</mo><mrow><msub><mi>Stab</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Stab}^{\ell}_{\tau}(T)=\mathrm{Stab}^{\ell}\cap\mathrm{Stab}_{\tau}(T)</annotation></semantics></math> for each <math id="S7.I1.i4.p1.m2" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> and <math id="S7.I1.i4.p1.m3" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>.</p>
</div></li>
</ol>
<p id="S7.Thmtheorem3.p1.2" class="ltx_p">In particular, <math id="S7.Thmtheorem3.p1.m6" class="ltx_Math" alttext="\mathrm{Stab}(T)=\bigsqcup_{\ell&gt;0,\tau\in\Aut(\bar{T})}\mathrm{Stab}^{\ell}_{\tau}(T)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>⨆</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo><mrow><mi>τ</mi><mo>∈</mo><mrow><mi>Aut</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></msub><mrow><msubsup><mi>Stab</mi><mi>τ</mi><mi mathvariant="normal">ℓ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Stab}(T)=\bigsqcup_{\ell&gt;0,\tau\in\Aut(\bar{T})}\mathrm{Stab}^{\ell}_{\tau}(T)</annotation></semantics></math>.</p>
</div>
<div id="S7.Thmtheorem3.p2" class="ltx_para">
<p id="S7.Thmtheorem3.p2.1" class="ltx_p">We define similarly for unlabeled <math id="S7.Thmtheorem3.p2.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>, in which case every object above is well defined only (as a subset of <math id="S7.Thmtheorem3.p2.m2" class="ltx_Math" alttext="\mathbb{S}_{n}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\mathbb{S}_{n}</annotation></semantics></math>) up to conjugation.</p>
</div>
</div>
<div id="S7.Thmtheorem4" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmtheorem4.2" class="ltx_text ltx_font_bold">Example 7.4</span></span><span id="S7.Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmtheorem4.p1" class="ltx_para">
<p id="S7.Thmtheorem4.p1.1" class="ltx_p">Let <math id="S7.Thmtheorem4.p1.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>, <math id="S7.Thmtheorem4.p1.m2" class="ltx_Math" alttext="\bar{T}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>T</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{T}</annotation></semantics></math>, <math id="S7.Thmtheorem4.p1.m3" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi>I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math> and <math id="S7.Thmtheorem4.p1.m4" class="ltx_Math" alttext="I_{v_{j}}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><msub><mi>v</mi><mi>j</mi></msub></msub><annotation encoding="application/x-tex">I_{v_{j}}</annotation></semantics></math> be as in Example <a href="#S7.Thmtheorem2" title="Example 7.2. ‣ 7.2. Stratifications of Stab(𝑇) ‣ 7. Proofs of asymptotic formulas ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.2</span></a>.
Then the permutation <math id="S7.Thmtheorem4.p1.m5" class="ltx_Math" alttext="\sigma=(1,5,9,4,2,6,7,8,3)\in\mathbb{S}_{I}=\mathbb{S}_{9}" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>5</mn><mo>,</mo><mn>9</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>6</mn><mo>,</mo><mn>7</mn><mo>,</mo><mn>8</mn><mo>,</mo><mn>3</mn><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi>𝕊</mi><mi>I</mi></msub><mo>=</mo><msub><mi>𝕊</mi><mn>9</mn></msub></mrow><annotation encoding="application/x-tex">\sigma=(1,5,9,4,2,6,7,8,3)\in\mathbb{S}_{I}=\mathbb{S}_{9}</annotation></semantics></math> lies in <math id="S7.Thmtheorem4.p1.m6" class="ltx_Math" alttext="\mathrm{Stab}(T)" display="inline" intent=":literal"><semantics><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Stab}(T)</annotation></semantics></math>.
Moreover, its image under the map <math id="S7.Thmtheorem4.p1.m7" class="ltx_Math" alttext="\mathrm{Stab}(T)\to\Aut(\bar{T})=\mathbb{S}_{3}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>Aut</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>𝕊</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">\mathrm{Stab}(T)\to\Aut(\bar{T})=\mathbb{S}_{3}</annotation></semantics></math> is <math id="S7.Thmtheorem4.p1.m8" class="ltx_Math" alttext="\tau:=(1,2,3)" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>:=</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tau:=(1,2,3)</annotation></semantics></math>, since <math id="S7.Thmtheorem4.p1.m9" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> cyclically permutes the subsets <math id="S7.Thmtheorem4.p1.m10" class="ltx_Math" alttext="I_{v_{1}}\to I_{v_{2}}\to I_{v_{3}}\to I_{v_{1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><msub><mi>v</mi><mn>1</mn></msub></msub><mo stretchy="false">→</mo><msub><mi>I</mi><msub><mi>v</mi><mn>2</mn></msub></msub><mo stretchy="false">→</mo><msub><mi>I</mi><msub><mi>v</mi><mn>3</mn></msub></msub><mo stretchy="false">→</mo><msub><mi>I</mi><msub><mi>v</mi><mn>1</mn></msub></msub></mrow><annotation encoding="application/x-tex">I_{v_{1}}\to I_{v_{2}}\to I_{v_{3}}\to I_{v_{1}}</annotation></semantics></math>. In particular, <math id="S7.Thmtheorem4.p1.m11" class="ltx_Math" alttext="\sigma\in\mathrm{Stab}_{\tau}(T)" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>∈</mo><mrow><msub><mi>Stab</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sigma\in\mathrm{Stab}_{\tau}(T)</annotation></semantics></math>.</p>
</div>
</div>
<div id="S7.Thmtheorem5" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmtheorem5.2" class="ltx_text ltx_font_bold">Example 7.5</span></span><span id="S7.Thmtheorem5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmtheorem5.p1" class="ltx_para">
<p id="S7.Thmtheorem5.p1.1" class="ltx_p">Let <math id="S7.Thmtheorem5.p1.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> be a labeled weighted rooted tree with <math id="S7.Thmtheorem5.p1.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> inputs. Then, applying (<a href="#S3.E19" title="In Example 3.14 (Permutation representations). ‣ 3.5. First examples ‣ 3. Characteristic polynomials of symmetric functions and representations ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.19</span></a>) in Example <a href="#S3.Thmtheorem14" title="Example 3.14 (Permutation representations). ‣ 3.5. First examples ‣ 3. Characteristic polynomials of symmetric functions and representations ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.14</span></a> to <math id="S7.Thmtheorem5.p1.m3" class="ltx_Math" alttext="H=\mathrm{Stab}(T)" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>=</mo><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H=\mathrm{Stab}(T)</annotation></semantics></math>, we obtain</p>
<table id="S7.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex11.m1" class="ltx_Math" alttext="\mathscr{S}_{U_{T}}(m)=\sum_{j=1}^{n}\frac{\lvert\mathrm{Stab}^{j}(T)\rvert}{\lvert\mathrm{Stab}(T)\rvert}m^{j}=\sum_{j=1}^{n}\sum_{\tau\in\Aut(\bar{T})}\frac{\lvert\mathrm{Stab}^{j}_{\tau}(T)\rvert}{\lvert\mathrm{Stab}(T)\rvert}m^{j}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>U</mi><mi>T</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mfrac><mrow><mo stretchy="false">|</mo><mrow><msup><mi>Stab</mi><mi>j</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><mo stretchy="false">|</mo><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>m</mi><mi>j</mi></msup></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>∈</mo><mrow><mi>Aut</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><mfrac><mrow><mo stretchy="false">|</mo><mrow><msubsup><mi>Stab</mi><mi>τ</mi><mi>j</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><mo stretchy="false">|</mo><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>m</mi><mi>j</mi></msup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathscr{S}_{U_{T}}(m)=\sum_{j=1}^{n}\frac{\lvert\mathrm{Stab}^{j}(T)\rvert}{\lvert\mathrm{Stab}(T)\rvert}m^{j}=\sum_{j=1}^{n}\sum_{\tau\in\Aut(\bar{T})}\frac{\lvert\mathrm{Stab}^{j}_{\tau}(T)\rvert}{\lvert\mathrm{Stab}(T)\rvert}m^{j}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.Thmtheorem5.p1.2" class="ltx_p">This is the same for unlabeled <math id="S7.Thmtheorem5.p1.m4" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>.</p>
</div>
</div>
<div id="S7.SS2.p4" class="ltx_para">
<p id="S7.SS2.p4.1" class="ltx_p">The first step in the proof of Theorem <a href="#S6.Thmtheorem6" title="Theorem 6.6. ‣ 6.1. Asymptotic formulas ‣ 6. Asymptotic behavior and log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.6</span></a> is to decompose
the coefficient <math id="S7.SS2.p4.m1" class="ltx_Math" alttext="\mathscr{Q}^{n-j}_{n,k}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathscript">𝒬</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></msubsup><annotation encoding="application/x-tex">\mathscr{Q}^{n-j}_{n,k}</annotation></semantics></math>.
To explain this, we first consider the decomposition of <math id="S7.SS2.p4.m2" class="ltx_Math" alttext="\mathscr{Q}_{n,k}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathscript">𝒬</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">\mathscr{Q}_{n,k}</annotation></semantics></math> with respect to the map <math id="S7.SS2.p4.m3" class="ltx_Math" alttext="F_{n}:\mathscr{T}_{n,k}\to\bar{\mathscr{T}}_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>F</mi><mi>n</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi class="ltx_font_mathscript">𝒯</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow></msub><mo stretchy="false">→</mo><msub><mover accent="true"><mi class="ltx_font_mathscript">𝒯</mi><mo>¯</mo></mover><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">F_{n}:\mathscr{T}_{n,k}\to\bar{\mathscr{T}}_{k}</annotation></semantics></math> as follows:</p>
<table id="S7.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex12.m1" class="ltx_Math" alttext="\mathscr{Q}_{n,k}=\sum_{\bar{T}\in\bar{\mathscr{T}}_{k}}\mathscr{Q}_{n,\bar{T}},\quad\text{ where }~\mathscr{Q}_{n,\bar{T}}:=\sum_{T\in F^{-1}_{n}(\overline{T})}\mathscr{S}_{U_{T}}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathscript">𝒬</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow></msub><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo>∈</mo><msub><mover accent="true"><mi class="ltx_font_mathscript">𝒯</mi><mo>¯</mo></mover><mi>k</mi></msub></mrow></munder><msub><mi class="ltx_font_mathscript">𝒬</mi><mrow><mi>n</mi><mo>,</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover></mrow></msub></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mtext> where </mtext><mo lspace="0.330em" rspace="0em">​</mo><msub><mi class="ltx_font_mathscript">𝒬</mi><mrow><mi>n</mi><mo>,</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover></mrow></msub></mrow><mo rspace="0.111em">:=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>T</mi><mo>∈</mo><mrow><msubsup><mi>F</mi><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo stretchy="true">¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><msub><mi class="ltx_font_mathscript">𝒮</mi><msub><mi>U</mi><mi>T</mi></msub></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathscr{Q}_{n,k}=\sum_{\bar{T}\in\bar{\mathscr{T}}_{k}}\mathscr{Q}_{n,\bar{T}},\quad\text{ where }~\mathscr{Q}_{n,\bar{T}}:=\sum_{T\in F^{-1}_{n}(\overline{T})}\mathscr{S}_{U_{T}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.p4.2" class="ltx_p">for <math id="S7.SS2.p4.m4" class="ltx_Math" alttext="\bar{T}\in\overline{\mathscr{T}}_{k}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo>∈</mo><msub><mover accent="true"><mi class="ltx_font_mathscript">𝒯</mi><mo stretchy="true">¯</mo></mover><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">\bar{T}\in\overline{\mathscr{T}}_{k}</annotation></semantics></math>.
By definition, <math id="S7.SS2.p4.m5" class="ltx_Math" alttext="F_{n}^{-1}(\overline{T})\subset\mathscr{T}_{n,k}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>F</mi><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo stretchy="true">¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><msub><mi class="ltx_font_mathscript">𝒯</mi><mrow><mi>n</mi><mo>,</mo><mi>k</mi></mrow></msub></mrow><annotation encoding="application/x-tex">F_{n}^{-1}(\overline{T})\subset\mathscr{T}_{n,k}</annotation></semantics></math> consists of weighted rooted trees obtained by attaching <math id="S7.SS2.p4.m6" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> inputs to the vertices of <math id="S7.SS2.p4.m7" class="ltx_Math" alttext="\bar{T}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>T</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{T}</annotation></semantics></math>.</p>
</div>
<div id="S7.SS2.p5" class="ltx_para">
<p id="S7.SS2.p5.1" class="ltx_p">This decomposes further by Example <a href="#S7.Thmtheorem5" title="Example 7.5. ‣ 7.2. Stratifications of Stab(𝑇) ‣ 7. Proofs of asymptotic formulas ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.5</span></a>: taking the coefficients of <math id="S7.SS2.p5.m1" class="ltx_Math" alttext="m^{n-j}" display="inline" intent=":literal"><semantics><msup><mi>m</mi><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></msup><annotation encoding="application/x-tex">m^{n-j}</annotation></semantics></math>,</p>
<table id="S7.E3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(7.3)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E3.m1" class="ltx_Math" alttext="\mathscr{Q}_{n,\bar{T}}^{n-j}=\sum_{\tau\in\Aut(\bar{T})}\sum_{T\in F_{n}^{-1}(\bar{T})}\frac{\lvert\mathrm{Stab}^{n-j}_{\tau}(T)\rvert}{\lvert\mathrm{Stab}(T)\rvert}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathscript">𝒬</mi><mrow><mi>n</mi><mo>,</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover></mrow><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></msubsup><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>τ</mi><mo>∈</mo><mrow><mi>Aut</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>T</mi><mo>∈</mo><mrow><msubsup><mi>F</mi><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mfrac><mrow><mo stretchy="false">|</mo><mrow><msubsup><mi>Stab</mi><mi>τ</mi><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><mo stretchy="false">|</mo><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mfrac></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathscr{Q}_{n,\bar{T}}^{n-j}=\sum_{\tau\in\Aut(\bar{T})}\sum_{T\in F_{n}^{-1}(\bar{T})}\frac{\lvert\mathrm{Stab}^{n-j}_{\tau}(T)\rvert}{\lvert\mathrm{Stab}(T)\rvert}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.p5.2" class="ltx_p">As we will see later, the summand in (<a href="#S7.E3" title="In 7.2. Stratifications of Stab(𝑇) ‣ 7. Proofs of asymptotic formulas ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.3</span></a>) for <math id="S7.SS2.p5.m2" class="ltx_Math" alttext="\tau=e" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>=</mo><mi>e</mi></mrow><annotation encoding="application/x-tex">\tau=e</annotation></semantics></math> dominates the others as <math id="S7.SS2.p5.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> grows. So we first obtain an asymptotic formula for the case of <math id="S7.SS2.p5.m4" class="ltx_Math" alttext="\tau=e" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>=</mo><mi>e</mi></mrow><annotation encoding="application/x-tex">\tau=e</annotation></semantics></math>.</p>
</div>
<div id="S7.SS2.p6" class="ltx_para">
<p id="S7.SS2.p6.1" class="ltx_p">When <math id="S7.SS2.p6.m1" class="ltx_Math" alttext="\tau=e" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>=</mo><mi>e</mi></mrow><annotation encoding="application/x-tex">\tau=e</annotation></semantics></math>, the numerator <math id="S7.SS2.p6.m2" class="ltx_Math" alttext="\lvert\mathrm{Stab}_{e}^{n-j}(T)\rvert" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><msubsup><mi>Stab</mi><mi>e</mi><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\lvert\mathrm{Stab}_{e}^{n-j}(T)\rvert</annotation></semantics></math> counts elements in <math id="S7.SS2.p6.m3" class="ltx_Math" alttext="\mathrm{Stab}_{e}(T)\cong\mathbb{S}_{\lambda(T)}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>Stab</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><msub><mi>𝕊</mi><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\mathrm{Stab}_{e}(T)\cong\mathbb{S}_{\lambda(T)}</annotation></semantics></math> with <math id="S7.SS2.p6.m4" class="ltx_Math" alttext="n-j" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">n-j</annotation></semantics></math> disjoint cycles, where the number of inputs attached to each vertex of <math id="S7.SS2.p6.m5" class="ltx_Math" alttext="\bar{T}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>T</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{T}</annotation></semantics></math> can vary. Since <math id="S7.SS2.p6.m6" class="ltx_Math" alttext="\bar{T}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>T</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{T}</annotation></semantics></math> is fixed, so is <math id="S7.SS2.p6.m7" class="ltx_Math" alttext="\ell(\lambda(T))=\lvert V(\bar{T})\rvert" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">|</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">\ell(\lambda(T))=\lvert V(\bar{T})\rvert</annotation></semantics></math>.
Thus, the summand for <math id="S7.SS2.p6.m8" class="ltx_Math" alttext="\tau=e" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>=</mo><mi>e</mi></mrow><annotation encoding="application/x-tex">\tau=e</annotation></semantics></math> is controlled by the <math id="S7.SS2.p6.m9" class="ltx_Math" alttext="\lvert V(\bar{T})\rvert" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\lvert V(\bar{T})\rvert</annotation></semantics></math>-th power of the generating function of the signless Stirling numbers of the first kind defined as follows.</p>
</div>
<div id="S7.SS2.p7" class="ltx_para">
<p id="S7.SS2.p7.1" class="ltx_p">Recall that <math id="S7.SS2.p7.m1" class="ltx_Math" alttext="c(n,j)" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">c(n,j)</annotation></semantics></math> satisfy</p>
<table id="S7.E4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(7.4)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E4.m1" class="ltx_math_unparsed" alttext="m(m+1)\cdots(m+n-1)=\sum_{j=0}^{n}c(n,j)m^{j}c(0,0)=1." display="block" intent=":literal"><semantics><mrow><mi>m</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">⋯</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo>+</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">=</mo><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mi>n</mi></munderover><mi>c</mi><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><msup><mi>m</mi><mi>j</mi></msup><mi>c</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mo>=</mo><mn>1</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">m(m+1)\cdots(m+n-1)=\sum_{j=0}^{n}c(n,j)m^{j}c(0,0)=1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.p7.2" class="ltx_p">The (double) generating function of these numbers is known as follows:</p>
<table id="S7.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex13.m1" class="ltx_Math" alttext="\mathfrak{S}:=\sum_{n\geq 1}\sum_{j=1}^{n}\frac{c(n,j)}{n!}u^{n}v^{j}=(1-u)^{-v}\quad(=\exp(-v\mathrm{log}(1-u)))" display="block" intent=":literal"><semantics><mrow><mi>𝔖</mi><mo rspace="0.111em">:=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>n</mi><mo>≥</mo><mn>1</mn></mrow></munder><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mfrac><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>n</mi><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mi>j</mi></msup></mrow></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mi>v</mi></mrow></msup><mspace style="width:0.389em;" width="0.389em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>log</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathfrak{S}:=\sum_{n\geq 1}\sum_{j=1}^{n}\frac{c(n,j)}{n!}u^{n}v^{j}=(1-u)^{-v}\quad(=\exp(-v\mathrm{log}(1-u)))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.p7.3" class="ltx_p">where <math id="S7.SS2.p7.m2" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> and <math id="S7.SS2.p7.m3" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> are formal variables.</p>
</div>
<div id="S7.SS2.p8" class="ltx_para">
<p id="S7.SS2.p8.1" class="ltx_p">For notational convenience, we write for given <math id="S7.SS2.p8.m1" class="ltx_Math" alttext="j,k\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>,</mo><mi>k</mi></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">j,k\geq 0</annotation></semantics></math>,</p>
<table id="S7.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex14.m1" class="ltx_Math" alttext="A_{j,k}(n)=\mathrm{coeff}_{m^{n-j}}\left(\kern-3.00003pt\left(\genfrac{}{}{0.0pt}{}{m(k+1)}{n}\right)\kern-3.00003pt\right)=\frac{(k+1)^{n-j}c(n,n-j)}{n!}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>A</mi><mrow><mi>j</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>coeff</mi><msup><mi>m</mi><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mo>(</mo><mfrac linethickness="0.0pt"><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>n</mi></mfrac><mpadded style="width:0.089em;" width="0.089em"><mo>)</mo></mpadded></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>n</mi><mo>!</mo></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">A_{j,k}(n)=\mathrm{coeff}_{m^{n-j}}\left(\kern-3.00003pt\left(\genfrac{}{}{0.0pt}{}{m(k+1)}{n}\right)\kern-3.00003pt\right)=\frac{(k+1)^{n-j}c(n,n-j)}{n!}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.p8.2" class="ltx_p">Note that <math id="S7.SS2.p8.m2" class="ltx_Math" alttext="\lim_{n\to\infty}c(n,n-j)/(\frac{n^{2j}}{2^{j}j!})=1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>lim</mo><mrow><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mfrac><msup><mi>n</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msup><mrow><mrow><msup><mn>2</mn><mi>j</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>!</mo></mrow></mfrac><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\lim_{n\to\infty}c(n,n-j)/(\frac{n^{2j}}{2^{j}j!})=1</annotation></semantics></math>. In particular, <math id="S7.SS2.p8.m3" class="ltx_Math" alttext="O(A_{j,k-1})=O(\frac{k^{n}n^{2j}}{n!})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mrow><mi>j</mi><mo>,</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mfrac><mrow><msup><mi>k</mi><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msup></mrow><mrow><mi>n</mi><mo>!</mo></mrow></mfrac><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">O(A_{j,k-1})=O(\frac{k^{n}n^{2j}}{n!})</annotation></semantics></math>.</p>
</div>
<div id="S7.Thmtheorem6" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmtheorem6.2" class="ltx_text ltx_font_bold">Proposition 7.6</span></span><span id="S7.Thmtheorem6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmtheorem6.p1" class="ltx_para">
<p id="S7.Thmtheorem6.p1.1" class="ltx_p"><span id="S7.Thmtheorem6.p1.1.1" class="ltx_text ltx_font_italic">Fix <math id="S7.Thmtheorem6.p1.m1" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> and <math id="S7.Thmtheorem6.p1.m2" class="ltx_Math" alttext="k\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">k\geq 0</annotation></semantics></math>. Then as <math id="S7.Thmtheorem6.p1.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> grows,</span></p>
<table id="S7.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex15.m1" class="ltx_Math" alttext="\sum_{\bar{T}\in\bar{\mathscr{T}}_{k}}\sum_{T\in F_{n}^{-1}(\bar{T})}\frac{\lvert\mathrm{Stab}_{e}^{n-j}(T)\rvert}{\lvert\mathrm{Stab}(T)\rvert}=c_{k}\cdot A_{j,k}(n)+O\left(\frac{k^{n}n^{2j}}{n!}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo>∈</mo><msub><mover accent="true"><mi class="ltx_font_mathscript">𝒯</mi><mo>¯</mo></mover><mi>k</mi></msub></mrow></munder><mrow><munder><mo lspace="0.167em" movablelimits="false">∑</mo><mrow><mi>T</mi><mo>∈</mo><mrow><msubsup><mi>F</mi><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mfrac><mrow><mo stretchy="false">|</mo><mrow><msubsup><mi>Stab</mi><mi>e</mi><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><mo stretchy="false">|</mo><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mfrac></mrow></mrow><mo>=</mo><mrow><mrow><mrow><msub><mi>c</mi><mi>k</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>A</mi><mrow><mi>j</mi><mo>,</mo><mi>k</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msup><mi>k</mi><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msup></mrow><mrow><mi>n</mi><mo>!</mo></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{\bar{T}\in\bar{\mathscr{T}}_{k}}\sum_{T\in F_{n}^{-1}(\bar{T})}\frac{\lvert\mathrm{Stab}_{e}^{n-j}(T)\rvert}{\lvert\mathrm{Stab}(T)\rvert}=c_{k}\cdot A_{j,k}(n)+O\left(\frac{k^{n}n^{2j}}{n!}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S7.SS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S7.SS2.p9" class="ltx_para">
<p id="S7.SS2.p9.1" class="ltx_p"><span id="S7.SS2.p9.1.1" class="ltx_text">The proposition immediately follows from (<a href="#S7.E1" title="In 7.1. Proof of Theorem ‣ 7. Proofs of asymptotic formulas ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.1</span></a>) and the following: for <math id="S7.SS2.p9.m1" class="ltx_Math" alttext="\bar{T}\in\bar{\mathscr{T}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo>∈</mo><mover accent="true"><mi class="ltx_font_mathscript">𝒯</mi><mo>¯</mo></mover></mrow><annotation encoding="application/x-tex">\bar{T}\in\bar{\mathscr{T}}</annotation></semantics></math> with <math id="S7.SS2.p9.m2" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> vertices,</span></p>
<table id="S7.E5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(7.5)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E5.m1" class="ltx_Math" alttext="\sum_{T\in F_{n}^{-1}(\bar{T})}\frac{\lvert\mathrm{Stab}_{e}^{n-j}(T)\rvert}{\lvert\mathrm{Stab}(T)\rvert}=\frac{1}{\lvert\Aut(\bar{T})\rvert}\cdot A_{j,N-1}(n)+O\left(\frac{(N-1)^{n}n^{2j}}{n!}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>T</mi><mo>∈</mo><mrow><msubsup><mi>F</mi><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mfrac><mrow><mo stretchy="false">|</mo><mrow><msubsup><mi>Stab</mi><mi>e</mi><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><mo stretchy="false">|</mo><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mfrac></mrow><mo>=</mo><mrow><mrow><mrow><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mrow><mi>Aut</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>A</mi><mrow><mi>j</mi><mo>,</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msup></mrow><mrow><mi>n</mi><mo>!</mo></mrow></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{T\in F_{n}^{-1}(\bar{T})}\frac{\lvert\mathrm{Stab}_{e}^{n-j}(T)\rvert}{\lvert\mathrm{Stab}(T)\rvert}=\frac{1}{\lvert\Aut(\bar{T})\rvert}\cdot A_{j,N-1}(n)+O\left(\frac{(N-1)^{n}n^{2j}}{n!}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S7.SS2.p10" class="ltx_para">
<p id="S7.SS2.p10.1" class="ltx_p"><span id="S7.SS2.p10.1.1" class="ltx_text">The left hand side of (<a href="#S7.E5" title="In Proof. ‣ 7.2. Stratifications of Stab(𝑇) ‣ 7. Proofs of asymptotic formulas ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.5</span></a>) is the summation over all possible <math id="S7.SS2.p10.m1" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>-tuples of partitions of <math id="S7.SS2.p10.m2" class="ltx_Math" alttext="n_{1},\cdots,n_{N}" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>n</mi><mi>N</mi></msub></mrow><annotation encoding="application/x-tex">n_{1},\cdots,n_{N}</annotation></semantics></math> with <math id="S7.SS2.p10.m3" class="ltx_Math" alttext="\sum n_{j}=n" display="inline" intent=":literal"><semantics><mrow><mrow><mo>∑</mo><msub><mi>n</mi><mi>j</mi></msub></mrow><mo>=</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">\sum n_{j}=n</annotation></semantics></math> subject to the valency conditions, where each summand is multiplied by <math id="S7.SS2.p10.m4" class="ltx_Math" alttext="\lvert\Aut(\bar{T})\rvert" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mi>Aut</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\lvert\Aut(\bar{T})\rvert</annotation></semantics></math>. Since the valency conditions are given in the form <math id="S7.SS2.p10.m5" class="ltx_Math" alttext="n_{j}\geq m_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mi>j</mi></msub><mo>≥</mo><msub><mi>m</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">n_{j}\geq m_{j}</annotation></semantics></math> for some <math id="S7.SS2.p10.m6" class="ltx_Math" alttext="m_{j}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mi>j</mi></msub><annotation encoding="application/x-tex">m_{j}</annotation></semantics></math> depending of the shape of <math id="S7.SS2.p10.m7" class="ltx_Math" alttext="\bar{T}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>T</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{T}</annotation></semantics></math> and the weights on the vertices of <math id="S7.SS2.p10.m8" class="ltx_Math" alttext="\bar{T}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>T</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{T}</annotation></semantics></math>, the left hand side is asymptotically equal to the summations over such <math id="S7.SS2.p10.m9" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>-tuples with any <math id="S7.SS2.p10.m10" class="ltx_Math" alttext="n_{j}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mi>j</mi></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n_{j}\geq 0</annotation></semantics></math>, upon multiplication by <math id="S7.SS2.p10.m11" class="ltx_Math" alttext="\lvert\Aut(\bar{T})\rvert" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mi>Aut</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\lvert\Aut(\bar{T})\rvert</annotation></semantics></math>. Therefore,</span></p>
<table id="S7.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex16.m1" class="ltx_Math" alttext="\sum_{T\in F_{n}^{-1}(\bar{T})}\frac{\lvert\mathrm{Stab}_{e}^{n-j}(T)\rvert}{\lvert\mathrm{Stab}(T)\rvert}=\frac{1}{\lvert\Aut(\bar{T})\rvert}\sum_{\begin{subarray}{c}n_{1}+\cdots+n_{N}=n,\\
j_{1}+\cdots+j_{N}=j,\\
n_{i},j_{i}\geq 0\text{ for all }i\end{subarray}}\prod_{i=1}^{N}\frac{c(n_{i},n_{i}-j_{i})}{n_{i}!}" display="block" intent=":literal"><semantics><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>T</mi><mo>∈</mo><mrow><msubsup><mi>F</mi><mi>n</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mfrac><mrow><mo stretchy="false">|</mo><mrow><msubsup><mi>Stab</mi><mi>e</mi><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><mo stretchy="false">|</mo><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mfrac></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mrow><mi>Aut</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mrow><mrow><msub><mi>n</mi><mn>1</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>n</mi><mi>N</mi></msub></mrow><mo>=</mo><mi>n</mi></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mrow><msub><mi>j</mi><mn>1</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>j</mi><mi>N</mi></msub></mrow><mo>=</mo><mi>j</mi></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd><mrow><msub><mi>n</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>j</mi><mi>i</mi></msub><mo>≥</mo><mrow><mn>0</mn><mo lspace="0em" rspace="0em">​</mo><mtext> for all </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></mrow></mrow></mtd></mtr></mtable></munder><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover><mfrac><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>n</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>n</mi><mi>i</mi></msub><mo>−</mo><msub><mi>j</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>n</mi><mi>i</mi></msub><mo>!</mo></mrow></mfrac></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{T\in F_{n}^{-1}(\bar{T})}\frac{\lvert\mathrm{Stab}_{e}^{n-j}(T)\rvert}{\lvert\mathrm{Stab}(T)\rvert}=\frac{1}{\lvert\Aut(\bar{T})\rvert}\sum_{\begin{subarray}{c}n_{1}+\cdots+n_{N}=n,\\
j_{1}+\cdots+j_{N}=j,\\
n_{i},j_{i}\geq 0\text{ for all }i\end{subarray}}\prod_{i=1}^{N}\frac{c(n_{i},n_{i}-j_{i})}{n_{i}!}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.p10.2" class="ltx_p"><span id="S7.SS2.p10.2.1" class="ltx_text">modulo <math id="S7.SS2.p10.m12" class="ltx_Math" alttext="O(\frac{(N-1)^{n}n^{2j}}{n!})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mfrac><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>n</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msup></mrow><mrow><mi>n</mi><mo>!</mo></mrow></mfrac><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(\frac{(N-1)^{n}n^{2j}}{n!})</annotation></semantics></math>. The summation on the right hand side of (<a href="#S7.E5" title="In Proof. ‣ 7.2. Stratifications of Stab(𝑇) ‣ 7. Proofs of asymptotic formulas ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.5</span></a>) is equal to the coefficient of <math id="S7.SS2.p10.m13" class="ltx_Math" alttext="u^{n}v^{n-j}" display="inline" intent=":literal"><semantics><mrow><msup><mi>u</mi><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></msup></mrow><annotation encoding="application/x-tex">u^{n}v^{n-j}</annotation></semantics></math> in</span></p>
<table id="S7.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex17.m1" class="ltx_Math" alttext="\mathfrak{S}^{N}=(1-u)^{-Nv}=\exp(-Nv\mathrm{log}(1-u))" display="block" intent=":literal"><semantics><mrow><msup><mi>𝔖</mi><mi>N</mi></msup><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow></msup><mo>=</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>log</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathfrak{S}^{N}=(1-u)^{-Nv}=\exp(-Nv\mathrm{log}(1-u))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.p10.3" class="ltx_p"><span id="S7.SS2.p10.3.1" class="ltx_text">when expanded to a power series.
Since</span></p>
<table id="S7.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex18.m1" class="ltx_Math" alttext="\frac{d^{n}}{du^{n}}(1-u)^{-Nv}=\prod_{i=0}^{n-1}(Nv+i)\cdot(1-u)^{-Nv-n}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><msup><mi>d</mi><mi>n</mi></msup><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mi>n</mi></msup></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow></msup></mrow><mo rspace="0.111em">=</mo><mrow><mrow><munderover><mo movablelimits="false" rspace="0em">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>+</mo><mi>i</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mo>−</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><mo>−</mo><mi>n</mi></mrow></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{d^{n}}{du^{n}}(1-u)^{-Nv}=\prod_{i=0}^{n-1}(Nv+i)\cdot(1-u)^{-Nv-n},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.p10.4" class="ltx_p"><span id="S7.SS2.p10.4.1" class="ltx_text">the coefficient of <math id="S7.SS2.p10.m14" class="ltx_Math" alttext="u^{n}" display="inline" intent=":literal"><semantics><msup><mi>u</mi><mi>n</mi></msup><annotation encoding="application/x-tex">u^{n}</annotation></semantics></math> in <math id="S7.SS2.p10.m15" class="ltx_Math" alttext="\mathfrak{S}^{N}" display="inline" intent=":literal"><semantics><msup><mi>𝔖</mi><mi>N</mi></msup><annotation encoding="application/x-tex">\mathfrak{S}^{N}</annotation></semantics></math> is</span></p>
<table id="S7.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex19.m1" class="ltx_Math" alttext="\frac{1}{n!}\frac{d^{n}}{du^{n}}(1-u)^{-Nv}|_{u=0}=\frac{1}{n!}\prod_{i=0}^{n-1}(Nv+i)." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mrow><mfrac><mn>1</mn><mrow><mi>n</mi><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mfrac><msup><mi>d</mi><mi>n</mi></msup><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mi>n</mi></msup></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow></msup></mrow><mo stretchy="false">|</mo></mrow><mrow><mi>u</mi><mo>=</mo><mn>0</mn></mrow></msub><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mi>n</mi><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>+</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{1}{n!}\frac{d^{n}}{du^{n}}(1-u)^{-Nv}|_{u=0}=\frac{1}{n!}\prod_{i=0}^{n-1}(Nv+i).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS2.p10.5" class="ltx_p"><span id="S7.SS2.p10.5.1" class="ltx_text">Hence, by (<a href="#S7.E4" title="In 7.2. Stratifications of Stab(𝑇) ‣ 7. Proofs of asymptotic formulas ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.4</span></a>), the coefficient of <math id="S7.SS2.p10.m16" class="ltx_Math" alttext="u^{n}v^{n-j}" display="inline" intent=":literal"><semantics><mrow><msup><mi>u</mi><mi>n</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></msup></mrow><annotation encoding="application/x-tex">u^{n}v^{n-j}</annotation></semantics></math> in <math id="S7.SS2.p10.m17" class="ltx_Math" alttext="\mathfrak{S}^{N}" display="inline" intent=":literal"><semantics><msup><mi>𝔖</mi><mi>N</mi></msup><annotation encoding="application/x-tex">\mathfrak{S}^{N}</annotation></semantics></math> is equal to <math id="S7.SS2.p10.m18" class="ltx_Math" alttext="c(n,n-j)N^{n-j}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mrow><mi>n</mi><mo>−</mo><mi>j</mi></mrow></msup></mrow><annotation encoding="application/x-tex">c(n,n-j)N^{n-j}</annotation></semantics></math> divided by <math id="S7.SS2.p10.m19" class="ltx_Math" alttext="n!" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>!</mo></mrow><annotation encoding="application/x-tex">n!</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S7.SS2.p11" class="ltx_para">
<p id="S7.SS2.p11.1" class="ltx_p">It remains to show that the summands in (<a href="#S7.E3" title="In 7.2. Stratifications of Stab(𝑇) ‣ 7. Proofs of asymptotic formulas ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.3</span></a>) corresponding to <math id="S7.SS2.p11.m1" class="ltx_Math" alttext="\tau\neq e" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>≠</mo><mi>e</mi></mrow><annotation encoding="application/x-tex">\tau\neq e</annotation></semantics></math> are asymptotically dominated by the summand corresponding to <math id="S7.SS2.p11.m2" class="ltx_Math" alttext="\tau=e" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>=</mo><mi>e</mi></mrow><annotation encoding="application/x-tex">\tau=e</annotation></semantics></math>. To this end, we introduce the notion of quotient trees by <math id="S7.SS2.p11.m3" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> in the following subsection.
We then compare the summands corresponding to <math id="S7.SS2.p11.m4" class="ltx_Math" alttext="\tau\neq e" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>≠</mo><mi>e</mi></mrow><annotation encoding="application/x-tex">\tau\neq e</annotation></semantics></math> with the summations associated to the quotient trees by <math id="S7.SS2.p11.m5" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>. Roughly speaking, the fact that these quotient trees are strictly smaller than the original tree ensures that the associated summations are asymptotically dominated by the one corresponding to <math id="S7.SS2.p11.m6" class="ltx_Math" alttext="\tau=e" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>=</mo><mi>e</mi></mrow><annotation encoding="application/x-tex">\tau=e</annotation></semantics></math>.</p>
</div>
</section>
<section id="S7.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">7.3. </span>Quotient trees</h3>

<div id="S7.SS3.p1" class="ltx_para">
<p id="S7.SS3.p1.1" class="ltx_p">Let <math id="S7.SS3.p1.m1" class="ltx_Math" alttext="\bar{T}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>T</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{T}</annotation></semantics></math> be a weighted rooted tree without inputs, where its vertices are ordered. Let <math id="S7.SS3.p1.m2" class="ltx_Math" alttext="\tau\in\Aut(\bar{T})\subset\mathbb{S}_{V(\bar{T})}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mrow><mi>Aut</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><msub><mi>𝕊</mi><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\tau\in\Aut(\bar{T})\subset\mathbb{S}_{V(\bar{T})}</annotation></semantics></math> be an automorphism of <math id="S7.SS3.p1.m3" class="ltx_Math" alttext="\bar{T}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>T</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{T}</annotation></semantics></math>. Then there is a natural quotient <math id="S7.SS3.p1.m4" class="ltx_Math" alttext="\bar{T}/\tau" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo>/</mo><mi>τ</mi></mrow><annotation encoding="application/x-tex">\bar{T}/\tau</annotation></semantics></math> of <math id="S7.SS3.p1.m5" class="ltx_Math" alttext="\bar{T}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>T</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{T}</annotation></semantics></math>, regarded as an element of <math id="S7.SS3.p1.m6" class="ltx_Math" alttext="\bar{\mathscr{T}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi class="ltx_font_mathscript">𝒯</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{\mathscr{T}}</annotation></semantics></math>,
by the <math id="S7.SS3.p1.m7" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>-actions on <math id="S7.SS3.p1.m8" class="ltx_Math" alttext="V(\bar{T})" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V(\bar{T})</annotation></semantics></math> and <math id="S7.SS3.p1.m9" class="ltx_Math" alttext="E(\bar{T})" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">E(\bar{T})</annotation></semantics></math> so that</p>
<table id="S7.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex20.m1" class="ltx_Math" alttext="V(\bar{T}/\tau)=V(\bar{T})/\tau E(\bar{T}/\tau)=E(\bar{T})/\tau" display="block" intent=":literal"><semantics><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo>/</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>τ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo>/</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>τ</mi></mrow></mrow><annotation encoding="application/x-tex">V(\bar{T}/\tau)=V(\bar{T})/\tau E(\bar{T}/\tau)=E(\bar{T})/\tau</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS3.p1.2" class="ltx_p">respectively.
The weight function <math id="S7.SS3.p1.m10" class="ltx_Math" alttext="w:V(\bar{T})\to\mathbb{Z}_{\geq 0}" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><msub><mi>ℤ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">w:V(\bar{T})\to\mathbb{Z}_{\geq 0}</annotation></semantics></math> of <math id="S7.SS3.p1.m11" class="ltx_Math" alttext="\bar{T}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>T</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{T}</annotation></semantics></math> naturally factors through <math id="S7.SS3.p1.m12" class="ltx_Math" alttext="V(\bar{T}/\tau)\to\mathbb{Z}_{\geq 0}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo>/</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><msub><mi>ℤ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">V(\bar{T}/\tau)\to\mathbb{Z}_{\geq 0}</annotation></semantics></math>. We assign this as the weight function of <math id="S7.SS3.p1.m13" class="ltx_Math" alttext="\bar{T}/\tau" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo>/</mo><mi>τ</mi></mrow><annotation encoding="application/x-tex">\bar{T}/\tau</annotation></semantics></math>.</p>
</div>
<div id="S7.SS3.p2" class="ltx_para">
<p id="S7.SS3.p2.1" class="ltx_p">Now let <math id="S7.SS3.p2.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> be a labeled weighted rooted tree.
Let <math id="S7.SS3.p2.m2" class="ltx_Math" alttext="\bar{T}=F(T)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo>=</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bar{T}=F(T)</annotation></semantics></math>. Suppose that <math id="S7.SS3.p2.m3" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> is in the image of <math id="S7.SS3.p2.m4" class="ltx_Math" alttext="\mathrm{Stab}(T)\to\Aut(\bar{T})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>Aut</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Stab}(T)\to\Aut(\bar{T})</annotation></semantics></math>. Let <math id="S7.SS3.p2.m5" class="ltx_Math" alttext="n_{v}" display="inline" intent=":literal"><semantics><msub><mi>n</mi><mi>v</mi></msub><annotation encoding="application/x-tex">n_{v}</annotation></semantics></math> denote the number of inputs attached to each vertex <math id="S7.SS3.p2.m6" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> of <math id="S7.SS3.p2.m7" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>. Then we have <math id="S7.SS3.p2.m8" class="ltx_Math" alttext="n_{u}=n_{v}" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mi>u</mi></msub><mo>=</mo><msub><mi>n</mi><mi>v</mi></msub></mrow><annotation encoding="application/x-tex">n_{u}=n_{v}</annotation></semantics></math> whenever two vertices <math id="S7.SS3.p2.m9" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> and <math id="S7.SS3.p2.m10" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> are in the same <math id="S7.SS3.p2.m11" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>-orbit. Indeed, any <math id="S7.SS3.p2.m12" class="ltx_Math" alttext="\sigma\in\mathrm{Stab}_{\tau}(T)" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>∈</mo><mrow><msub><mi>Stab</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sigma\in\mathrm{Stab}_{\tau}(T)</annotation></semantics></math> induces an isomorphism between two rooted subtrees <math id="S7.SS3.p2.m13" class="ltx_Math" alttext="T_{u}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>u</mi></msub><annotation encoding="application/x-tex">T_{u}</annotation></semantics></math> and <math id="S7.SS3.p2.m14" class="ltx_Math" alttext="T_{v}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>v</mi></msub><annotation encoding="application/x-tex">T_{v}</annotation></semantics></math> in <math id="S7.SS3.p2.m15" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> that have <math id="S7.SS3.p2.m16" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> and <math id="S7.SS3.p2.m17" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> as their root vertices, respectively.</p>
</div>
<div id="S7.Thmtheorem7" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmtheorem7.2" class="ltx_text ltx_font_bold">Definition 7.7</span></span><span id="S7.Thmtheorem7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmtheorem7.p1" class="ltx_para">
<p id="S7.Thmtheorem7.p1.1" class="ltx_p">We define <math id="S7.Thmtheorem7.p1.m1" class="ltx_Math" alttext="T/\tau" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>/</mo><mi>τ</mi></mrow><annotation encoding="application/x-tex">T/\tau</annotation></semantics></math>
to be the weighted rooted tree obtained from <math id="S7.Thmtheorem7.p1.m2" class="ltx_Math" alttext="\bar{T}/\tau" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo>/</mo><mi>τ</mi></mrow><annotation encoding="application/x-tex">\bar{T}/\tau</annotation></semantics></math> by attaching <math id="S7.Thmtheorem7.p1.m3" class="ltx_Math" alttext="n_{v}" display="inline" intent=":literal"><semantics><msub><mi>n</mi><mi>v</mi></msub><annotation encoding="application/x-tex">n_{v}</annotation></semantics></math> inputs to the image of each <math id="S7.Thmtheorem7.p1.m4" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> in <math id="S7.Thmtheorem7.p1.m5" class="ltx_Math" alttext="V(\bar{T}/\tau)=V(T)/\tau" display="inline" intent=":literal"><semantics><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo>/</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>τ</mi></mrow></mrow><annotation encoding="application/x-tex">V(\bar{T}/\tau)=V(T)/\tau</annotation></semantics></math>.</p>
</div>
</div>
<div id="S7.SS3.p3" class="ltx_para">
<p id="S7.SS3.p3.1" class="ltx_p">Roughly speaking, <math id="S7.SS3.p3.m1" class="ltx_Math" alttext="T/\tau" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>/</mo><mi>τ</mi></mrow><annotation encoding="application/x-tex">T/\tau</annotation></semantics></math> is obtained from <math id="S7.SS3.p3.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> by identifying all the weighted rooted subtrees <math id="S7.SS3.p3.m3" class="ltx_Math" alttext="T_{v}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>v</mi></msub><annotation encoding="application/x-tex">T_{v}</annotation></semantics></math> for <math id="S7.SS3.p3.m4" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> having the same images in <math id="S7.SS3.p3.m5" class="ltx_Math" alttext="V(T)/\tau" display="inline" intent=":literal"><semantics><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>τ</mi></mrow><annotation encoding="application/x-tex">V(T)/\tau</annotation></semantics></math>.</p>
</div>
<div id="S7.SS3.p4" class="ltx_para">
<p id="S7.SS3.p4.1" class="ltx_p">It is natural to expect that <math id="S7.SS3.p4.m1" class="ltx_Math" alttext="\sigma\in\mathrm{Stab}_{\tau}(T)" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>∈</mo><mrow><msub><mi>Stab</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sigma\in\mathrm{Stab}_{\tau}(T)</annotation></semantics></math> induces an element in <math id="S7.SS3.p4.m2" class="ltx_Math" alttext="\mathrm{Stab}_{e}(T/\tau)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Stab</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>/</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Stab}_{e}(T/\tau)</annotation></semantics></math>, since its appropriate power (depending on <math id="S7.SS3.p4.m3" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math>) will stabilize each vertex <math id="S7.SS3.p4.m4" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> and permute the <math id="S7.SS3.p4.m5" class="ltx_Math" alttext="n_{v}" display="inline" intent=":literal"><semantics><msub><mi>n</mi><mi>v</mi></msub><annotation encoding="application/x-tex">n_{v}</annotation></semantics></math> inputs attached to <math id="S7.SS3.p4.m6" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math>.
In what follows, we construct a map</p>
<table id="S7.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex21.m1" class="ltx_Math" alttext="\mathrm{Stab}_{\tau}(T)\longrightarrow\mathrm{Stab}_{e}(T/\tau)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>Stab</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟶</mo><mrow><msub><mi>Stab</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>/</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Stab}_{\tau}(T)\longrightarrow\mathrm{Stab}_{e}(T/\tau)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS3.p4.2" class="ltx_p">and show that it has some useful properties.</p>
</div>
<div id="S7.SS3.p5" class="ltx_para">
<p id="S7.SS3.p5.1" class="ltx_p">Let <math id="S7.SS3.p5.m1" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi>I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math> be the set of labels on the inputs of <math id="S7.SS3.p5.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>, and for each <math id="S7.SS3.p5.m3" class="ltx_Math" alttext="v\in V(T)" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">v\in V(T)</annotation></semantics></math>, let <math id="S7.SS3.p5.m4" class="ltx_Math" alttext="I_{v}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>v</mi></msub><annotation encoding="application/x-tex">I_{v}</annotation></semantics></math> be the set of the labels on the inputs attached to <math id="S7.SS3.p5.m5" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math>. Hence, <math id="S7.SS3.p5.m6" class="ltx_Math" alttext="I:=\bigsqcup_{v\in V(T)}I_{v}" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo rspace="0.111em">:=</mo><mrow><msub><mo>⨆</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><msub><mi>I</mi><mi>v</mi></msub></mrow></mrow><annotation encoding="application/x-tex">I:=\bigsqcup_{v\in V(T)}I_{v}</annotation></semantics></math>,
and <math id="S7.SS3.p5.m7" class="ltx_Math" alttext="\mathrm{Stab}_{\tau}(T)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Stab</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Stab}_{\tau}(T)</annotation></semantics></math> is a subset of the symmetric group <math id="S7.SS3.p5.m8" class="ltx_Math" alttext="\mathbb{S}_{I}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><mi>I</mi></msub><annotation encoding="application/x-tex">\mathbb{S}_{I}</annotation></semantics></math> on <math id="S7.SS3.p5.m9" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi>I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math>.</p>
</div>
<div id="S7.SS3.p6" class="ltx_para">
<p id="S7.SS3.p6.1" class="ltx_p">Let <math id="S7.SS3.p6.m1" class="ltx_Math" alttext="d_{v}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d_{v}&gt;0</annotation></semantics></math> be the minimal positive integer such that <math id="S7.SS3.p6.m2" class="ltx_Math" alttext="\tau^{d_{v}}(v)=v" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>τ</mi><msub><mi>d</mi><mi>v</mi></msub></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>v</mi></mrow><annotation encoding="application/x-tex">\tau^{d_{v}}(v)=v</annotation></semantics></math> for each <math id="S7.SS3.p6.m3" class="ltx_Math" alttext="v\in V(T)" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">v\in V(T)</annotation></semantics></math>. Then there exists a map</p>
<table id="S7.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex22.m1" class="ltx_Math" alttext="\varphi_{v}:\mathrm{Stab}_{\tau}(T)\longrightarrow\mathbb{S}_{I_{v}}\subset\mathrm{Stab}(T_{v})" display="block" intent=":literal"><semantics><mrow><msub><mi>φ</mi><mi>v</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>Stab</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟶</mo><msub><mi>𝕊</mi><msub><mi>I</mi><mi>v</mi></msub></msub><mo>⊂</mo><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\varphi_{v}:\mathrm{Stab}_{\tau}(T)\longrightarrow\mathbb{S}_{I_{v}}\subset\mathrm{Stab}(T_{v})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS3.p6.2" class="ltx_p">that sends <math id="S7.SS3.p6.m4" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> to <math id="S7.SS3.p6.m5" class="ltx_Math" alttext="\sigma^{d_{v}}" display="inline" intent=":literal"><semantics><msup><mi>σ</mi><msub><mi>d</mi><mi>v</mi></msub></msup><annotation encoding="application/x-tex">\sigma^{d_{v}}</annotation></semantics></math> restricted to the set <math id="S7.SS3.p6.m6" class="ltx_Math" alttext="I_{v}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>v</mi></msub><annotation encoding="application/x-tex">I_{v}</annotation></semantics></math> of the inputs attached to <math id="S7.SS3.p6.m7" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math>.
As <math id="S7.SS3.p6.m8" class="ltx_Math" alttext="\mathrm{Stab}_{e}(T/\tau)\cong\mathbb{S}_{\lambda(T/\tau)}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>Stab</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>/</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><msub><mi>𝕊</mi><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>/</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\mathrm{Stab}_{e}(T/\tau)\cong\mathbb{S}_{\lambda(T/\tau)}</annotation></semantics></math>,
the desired map can be obtained as the product of the maps <math id="S7.SS3.p6.m9" class="ltx_Math" alttext="\varphi_{v}" display="inline" intent=":literal"><semantics><msub><mi>φ</mi><mi>v</mi></msub><annotation encoding="application/x-tex">\varphi_{v}</annotation></semantics></math> where <math id="S7.SS3.p6.m10" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> runs over representatives of <math id="S7.SS3.p6.m11" class="ltx_Math" alttext="V(T)/\tau" display="inline" intent=":literal"><semantics><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>τ</mi></mrow><annotation encoding="application/x-tex">V(T)/\tau</annotation></semantics></math>.</p>
</div>
<div id="S7.SS3.p7" class="ltx_para">
<p id="S7.SS3.p7.1" class="ltx_p">Choose representatives <math id="S7.SS3.p7.m1" class="ltx_Math" alttext="v_{1},\cdots,v_{p}\in V(T)" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><msub><mi>v</mi><mi>p</mi></msub><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">v_{1},\cdots,v_{p}\in V(T)</annotation></semantics></math>, one for each <math id="S7.SS3.p7.m2" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>-orbit, so that <math id="S7.SS3.p7.m3" class="ltx_Math" alttext="V(T)/\tau\cong\{v_{1},\cdots,v_{p}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>τ</mi></mrow><mo>≅</mo><mrow><mo stretchy="false">{</mo><msub><mi>v</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>v</mi><mi>p</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">V(T)/\tau\cong\{v_{1},\cdots,v_{p}\}</annotation></semantics></math>.
We consider the product map</p>
<table id="S7.E6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(7.6)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E6.m1" class="ltx_Math" alttext="\prod_{j=1}^{p}\varphi_{v_{j}}:~\mathrm{Stab}_{\tau}(T)\longrightarrow\prod_{j=1}^{p}\mathbb{S}_{I_{v_{j}}}=\mathbb{S}_{\lambda(T/\tau)}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>p</mi></munderover><msub><mi>φ</mi><msub><mi>v</mi><mi>j</mi></msub></msub></mrow><mo lspace="0.278em" rspace="0.608em">:</mo><mrow><mrow><msub><mi>Stab</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em" stretchy="false">⟶</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>p</mi></munderover><msub><mi>𝕊</mi><msub><mi>I</mi><msub><mi>v</mi><mi>j</mi></msub></msub></msub></mrow><mo>=</mo><msub><mi>𝕊</mi><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>/</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\prod_{j=1}^{p}\varphi_{v_{j}}:~\mathrm{Stab}_{\tau}(T)\longrightarrow\prod_{j=1}^{p}\mathbb{S}_{I_{v_{j}}}=\mathbb{S}_{\lambda(T/\tau)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS3.p7.2" class="ltx_p">where <math id="S7.SS3.p7.m4" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi>I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math> decomposes as <math id="S7.SS3.p7.m5" class="ltx_Math" alttext="I=\bigsqcup_{j=1}^{p}I_{j}" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo rspace="0.111em">=</mo><mrow><msubsup><mo>⨆</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>p</mi></msubsup><msub><mi>I</mi><mi>j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">I=\bigsqcup_{j=1}^{p}I_{j}</annotation></semantics></math> with</p>
<table id="S7.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex23.m1" class="ltx_Math" alttext="I_{j}:=I_{v_{j}}\sqcup I_{\tau(v_{j})}\sqcup\cdots\sqcup I_{\tau^{d_{j}-1}(v_{j})}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>I</mi><mi>j</mi></msub><mo>:=</mo><mrow><msub><mi>I</mi><msub><mi>v</mi><mi>j</mi></msub></msub><mo>⊔</mo><msub><mi>I</mi><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><mo>⊔</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>⊔</mo><msub><mi>I</mi><mrow><msup><mi>τ</mi><mrow><msub><mi>d</mi><mi>j</mi></msub><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">I_{j}:=I_{v_{j}}\sqcup I_{\tau(v_{j})}\sqcup\cdots\sqcup I_{\tau^{d_{j}-1}(v_{j})},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS3.p7.3" class="ltx_p">for each <math id="S7.SS3.p7.m6" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>, where <math id="S7.SS3.p7.m7" class="ltx_Math" alttext="d_{j}:=d_{v_{j}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>j</mi></msub><mo>:=</mo><msub><mi>d</mi><msub><mi>v</mi><mi>j</mi></msub></msub></mrow><annotation encoding="application/x-tex">d_{j}:=d_{v_{j}}</annotation></semantics></math>.
This map has the following properties.</p>
</div>
<div id="S7.Thmtheorem8" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmtheorem8.2" class="ltx_text ltx_font_bold">Lemma 7.8</span></span><span id="S7.Thmtheorem8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmtheorem8.p1" class="ltx_para">
<p id="S7.Thmtheorem8.p1.1" class="ltx_p"><span id="S7.Thmtheorem8.p1.1.1" class="ltx_text ltx_font_italic">The map (<a href="#S7.E6" title="In 7.3. Quotient trees ‣ 7. Proofs of asymptotic formulas ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.6</span></a>) is length-preserving. Moreover, it is surjective and its fibers have the same cardinalities. In particular, for every <math id="S7.Thmtheorem8.p1.m1" class="ltx_Math" alttext="\ell&gt;0" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\ell&gt;0</annotation></semantics></math>,</span></p>
<table id="S7.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex24.m1" class="ltx_Math" alttext="\frac{\lvert\mathrm{Stab}^{\ell}_{\tau}(T)\rvert}{\lvert\mathrm{Stab}(T)\rvert}\leq\frac{\lvert\mathrm{Stab}_{e}^{\ell}(T/\tau)\rvert}{\lvert\mathrm{Stab}(T/\tau)\rvert}." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><mo stretchy="false">|</mo><mrow><msubsup><mi>Stab</mi><mi>τ</mi><mi mathvariant="normal">ℓ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><mo stretchy="false">|</mo><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mfrac><mo>≤</mo><mfrac><mrow><mo stretchy="false">|</mo><mrow><msubsup><mi>Stab</mi><mi>e</mi><mi mathvariant="normal">ℓ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>/</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><mo stretchy="false">|</mo><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>/</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\lvert\mathrm{Stab}^{\ell}_{\tau}(T)\rvert}{\lvert\mathrm{Stab}(T)\rvert}\leq\frac{\lvert\mathrm{Stab}_{e}^{\ell}(T/\tau)\rvert}{\lvert\mathrm{Stab}(T/\tau)\rvert}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S7.SS3.p8" class="ltx_para">
<p id="S7.SS3.p8.1" class="ltx_p">The inequality will be useful when we prove Theorem <a href="#S6.Thmtheorem6" title="Theorem 6.6. ‣ 6.1. Asymptotic formulas ‣ 6. Asymptotic behavior and log-concavity ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.6</span></a> in the next subsection, and easily follows from the first two properties, as we will see.</p>
</div>
<div id="S7.SS3.p9" class="ltx_para">
<p id="S7.SS3.p9.1" class="ltx_p">Lemma <a href="#S7.Thmtheorem8" title="Lemma 7.8. ‣ 7.3. Quotient trees ‣ 7. Proofs of asymptotic formulas ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.8</span></a> will easily follow from a better understanding of the image of <math id="S7.SS3.p9.m1" class="ltx_Math" alttext="\mathrm{Stab}_{\tau}(T)\subset\mathbb{S}_{I}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>Stab</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><msub><mi>𝕊</mi><mi>I</mi></msub></mrow><annotation encoding="application/x-tex">\mathrm{Stab}_{\tau}(T)\subset\mathbb{S}_{I}</annotation></semantics></math>.
Note that every <math id="S7.SS3.p9.m2" class="ltx_Math" alttext="\sigma\in\mathrm{Stab}_{\tau}(T)" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>∈</mo><mrow><msub><mi>Stab</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sigma\in\mathrm{Stab}_{\tau}(T)</annotation></semantics></math> acts on <math id="S7.SS3.p9.m3" class="ltx_Math" alttext="I_{j}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>j</mi></msub><annotation encoding="application/x-tex">I_{j}</annotation></semantics></math> compatibly with the <math id="S7.SS3.p9.m4" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>-action on the orbit of <math id="S7.SS3.p9.m5" class="ltx_Math" alttext="v_{j}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>j</mi></msub><annotation encoding="application/x-tex">v_{j}</annotation></semantics></math>.
In particular, <math id="S7.SS3.p9.m6" class="ltx_Math" alttext="\mathrm{Stab}_{\tau}(T)\subset\mathbb{S}_{I}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>Stab</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><msub><mi>𝕊</mi><mi>I</mi></msub></mrow><annotation encoding="application/x-tex">\mathrm{Stab}_{\tau}(T)\subset\mathbb{S}_{I}</annotation></semantics></math> factors through</p>
<table id="S7.E7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(7.7)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E7.m1" class="ltx_math_unparsed" alttext="\prod_{j=1}^{p}\left(\mathbb{S}_{I_{v_{j}}}\times\mathbb{S}_{I_{\tau(v_{j})}}\times\cdots\times\mathbb{S}_{I_{\tau^{d_{j}-1}(v_{j})}}\right)\rtimes\langle\tau\rangle\cong\prod_{j=1}^{p}\left(\mathbb{S}_{n_{j}}^{d_{j}}\rtimes\mathbb{Z}/{d_{j}}\mathbb{Z}\right)" display="block" intent=":literal"><semantics><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>p</mi></munderover><mrow><mo lspace="0em">(</mo><msub><mi>𝕊</mi><msub><mi>I</mi><msub><mi>v</mi><mi>j</mi></msub></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝕊</mi><msub><mi>I</mi><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><msub><mi>𝕊</mi><msub><mi>I</mi><mrow><msup><mi>τ</mi><mrow><msub><mi>d</mi><mi>j</mi></msub><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub></msub><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋊</mo><mrow><mo stretchy="false">⟨</mo><mi>τ</mi><mo stretchy="false">⟩</mo></mrow><mo rspace="0.111em">≅</mo><munderover><mo movablelimits="false" rspace="0em">∏</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>p</mi></munderover><mrow><mo>(</mo><msubsup><mi>𝕊</mi><msub><mi>n</mi><mi>j</mi></msub><msub><mi>d</mi><mi>j</mi></msub></msubsup><mo lspace="0.222em" rspace="0.222em">⋊</mo><mi>ℤ</mi><mo>/</mo><msub><mi>d</mi><mi>j</mi></msub><mi>ℤ</mi><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\prod_{j=1}^{p}\left(\mathbb{S}_{I_{v_{j}}}\times\mathbb{S}_{I_{\tau(v_{j})}}\times\cdots\times\mathbb{S}_{I_{\tau^{d_{j}-1}(v_{j})}}\right)\rtimes\langle\tau\rangle\cong\prod_{j=1}^{p}\left(\mathbb{S}_{n_{j}}^{d_{j}}\rtimes\mathbb{Z}/{d_{j}}\mathbb{Z}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS3.p9.2" class="ltx_p">which is a subgroup of <math id="S7.SS3.p9.m7" class="ltx_Math" alttext="\prod_{j=1}^{p}\mathbb{S}_{I_{j}}\subset\mathbb{S}_{I}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∏</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>p</mi></msubsup><msub><mi>𝕊</mi><msub><mi>I</mi><mi>j</mi></msub></msub></mrow><mo>⊂</mo><msub><mi>𝕊</mi><mi>I</mi></msub></mrow><annotation encoding="application/x-tex">\prod_{j=1}^{p}\mathbb{S}_{I_{j}}\subset\mathbb{S}_{I}</annotation></semantics></math>, and even further, it factors through</p>
<table id="S7.E8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(7.8)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E8.m1" class="ltx_math_unparsed" alttext="\prod_{j=1}^{p}\left(\mathbb{S}_{I_{v_{j}}}\times\mathbb{S}_{I_{\tau(v_{j})}}\times\cdots\times\mathbb{S}_{I_{\tau^{d_{j}-1}(v_{j})}}\right)\rtimes\{\tau\}" display="block" intent=":literal"><semantics><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>p</mi></munderover><mrow><mo lspace="0em">(</mo><msub><mi>𝕊</mi><msub><mi>I</mi><msub><mi>v</mi><mi>j</mi></msub></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝕊</mi><msub><mi>I</mi><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub></msub><mo lspace="0.222em">×</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">×</mo><msub><mi>𝕊</mi><msub><mi>I</mi><mrow><msup><mi>τ</mi><mrow><msub><mi>d</mi><mi>j</mi></msub><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub></msub><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋊</mo><mrow><mo stretchy="false">{</mo><mi>τ</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\prod_{j=1}^{p}\left(\mathbb{S}_{I_{v_{j}}}\times\mathbb{S}_{I_{\tau(v_{j})}}\times\cdots\times\mathbb{S}_{I_{\tau^{d_{j}-1}(v_{j})}}\right)\rtimes\{\tau\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.SS3.p9.3" class="ltx_p">as a subset of (<a href="#S7.E7" title="In 7.3. Quotient trees ‣ 7. Proofs of asymptotic formulas ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.7</span></a>).
Here by abuse of notation, we denote any lift in <math id="S7.SS3.p9.m8" class="ltx_Math" alttext="\mathbb{S}_{I_{j}}" display="inline" intent=":literal"><semantics><msub><mi>𝕊</mi><msub><mi>I</mi><mi>j</mi></msub></msub><annotation encoding="application/x-tex">\mathbb{S}_{I_{j}}</annotation></semantics></math> of <math id="S7.SS3.p9.m9" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> (restricted to the <math id="S7.SS3.p9.m10" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>-orbit of <math id="S7.SS3.p9.m11" class="ltx_Math" alttext="v_{j}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>j</mi></msub><annotation encoding="application/x-tex">v_{j}</annotation></semantics></math>) again by <math id="S7.SS3.p9.m12" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>. Note that we may pick any such lift, since any two lifts differ only by reordering labels in each <math id="S7.SS3.p9.m13" class="ltx_Math" alttext="I_{\tau^{i}(v_{j})}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mrow><msup><mi>τ</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><annotation encoding="application/x-tex">I_{\tau^{i}(v_{j})}</annotation></semantics></math>.
It is now clear that <math id="S7.SS3.p9.m14" class="ltx_Math" alttext="\mathrm{Stab}_{\tau}(T)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Stab</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Stab}_{\tau}(T)</annotation></semantics></math> is equal to (<a href="#S7.E8" title="In 7.3. Quotient trees ‣ 7. Proofs of asymptotic formulas ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.8</span></a>), since
both have the same cardinalities
<math id="S7.SS3.p9.m15" class="ltx_Math" alttext="\lvert\mathrm{Stab}_{\tau}(T)\rvert=\lvert\mathbb{S}_{\lambda(T)}\rvert=\prod_{j=1}^{p}\lvert\mathbb{S}_{n_{j}}^{d_{j}}\rvert" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi>Stab</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mo stretchy="false">|</mo><msub><mi>𝕊</mi><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">|</mo></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo rspace="0em">∏</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>p</mi></msubsup><mrow><mo stretchy="false">|</mo><msubsup><mi>𝕊</mi><msub><mi>n</mi><mi>j</mi></msub><msub><mi>d</mi><mi>j</mi></msub></msubsup><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lvert\mathrm{Stab}_{\tau}(T)\rvert=\lvert\mathbb{S}_{\lambda(T)}\rvert=\prod_{j=1}^{p}\lvert\mathbb{S}_{n_{j}}^{d_{j}}\rvert</annotation></semantics></math>.</p>
</div>
<div id="S7.SS3.p10" class="ltx_para">
<p id="S7.SS3.p10.1" class="ltx_p">The above discussion is illustrated in the following example.</p>
</div>
<div id="S7.Thmtheorem9" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S7.Thmtheorem9.2" class="ltx_text ltx_font_bold">Example 7.9</span></span><span id="S7.Thmtheorem9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S7.Thmtheorem9.p1" class="ltx_para">
<p id="S7.Thmtheorem9.p1.1" class="ltx_p">Let <math id="S7.Thmtheorem9.p1.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>, <math id="S7.Thmtheorem9.p1.m2" class="ltx_Math" alttext="\bar{T}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>T</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{T}</annotation></semantics></math>, <math id="S7.Thmtheorem9.p1.m3" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi>I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math> and <math id="S7.Thmtheorem9.p1.m4" class="ltx_Math" alttext="I_{v_{j}}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><msub><mi>v</mi><mi>j</mi></msub></msub><annotation encoding="application/x-tex">I_{v_{j}}</annotation></semantics></math> with <math id="S7.Thmtheorem9.p1.m5" class="ltx_Math" alttext="0\leq j\leq 3" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mi>j</mi><mo>≤</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">0\leq j\leq 3</annotation></semantics></math> be as in Examples <a href="#S7.Thmtheorem2" title="Example 7.2. ‣ 7.2. Stratifications of Stab(𝑇) ‣ 7. Proofs of asymptotic formulas ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.2</span></a> and <a href="#S7.Thmtheorem4" title="Example 7.4. ‣ 7.2. Stratifications of Stab(𝑇) ‣ 7. Proofs of asymptotic formulas ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.4</span></a>.
The element <math id="S7.Thmtheorem9.p1.m6" class="ltx_Math" alttext="\tau=(1,2,3)\in\Aut(\bar{T})=\mathbb{S}_{3}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>3</mn><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi>Aut</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>T</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>𝕊</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">\tau=(1,2,3)\in\Aut(\bar{T})=\mathbb{S}_{3}</annotation></semantics></math>
acts on <math id="S7.Thmtheorem9.p1.m7" class="ltx_Math" alttext="v_{j}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>j</mi></msub><annotation encoding="application/x-tex">v_{j}</annotation></semantics></math> by <math id="S7.Thmtheorem9.p1.m8" class="ltx_Math" alttext="v_{1}\mapsto v_{2}\mapsto v_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mn>1</mn></msub><mo stretchy="false">↦</mo><msub><mi>v</mi><mn>2</mn></msub><mo stretchy="false">↦</mo><msub><mi>v</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">v_{1}\mapsto v_{2}\mapsto v_{3}</annotation></semantics></math>. The lift
of <math id="S7.Thmtheorem9.p1.m9" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> in <math id="S7.Thmtheorem9.p1.m10" class="ltx_Math" alttext="\mathrm{Stab}(T)\subset\mathbb{S}_{I}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><msub><mi>𝕊</mi><mi>I</mi></msub></mrow><annotation encoding="application/x-tex">\mathrm{Stab}(T)\subset\mathbb{S}_{I}</annotation></semantics></math> via the above splitting is then</p>
<table id="S7.E9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(7.9)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.E9.m1" class="ltx_Math" alttext="\tau=(1,2,3)(4,5,6)(7,8,9)~\in~\mathbb{S}_{I}=\mathbb{S}_{9}," display="block" intent=":literal"><semantics><mrow><mrow><mi>τ</mi><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>3</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>4</mn><mo>,</mo><mn>5</mn><mo>,</mo><mn>6</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>7</mn><mo>,</mo><mn>8</mn><mo>,</mo><mn>9</mn><mo rspace="0.330em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.608em">∈</mo><msub><mi>𝕊</mi><mi>I</mi></msub><mo>=</mo><msub><mi>𝕊</mi><mn>9</mn></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\tau=(1,2,3)(4,5,6)(7,8,9)~\in~\mathbb{S}_{I}=\mathbb{S}_{9},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.Thmtheorem9.p1.2" class="ltx_p">which we denote also by <math id="S7.Thmtheorem9.p1.m11" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> by abuse of notation.
It follows from this that</p>
<table id="S7.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex25.m1" class="ltx_Math" alttext="\mathrm{Stab}_{\tau}(T)=\left(\mathbb{S}_{I_{v_{1}}}\times\mathbb{S}_{I_{v_{2}}}\times\mathbb{S}_{I_{v_{3}}}\right)\cdot\tau~\subset~\mathrm{Stab}(T)~\subset~\mathbb{S}_{I}=\mathbb{S}_{9}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>Stab</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>𝕊</mi><msub><mi>I</mi><msub><mi>v</mi><mn>1</mn></msub></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝕊</mi><msub><mi>I</mi><msub><mi>v</mi><mn>2</mn></msub></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝕊</mi><msub><mi>I</mi><msub><mi>v</mi><mn>3</mn></msub></msub></msub></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>τ</mi></mrow><mo lspace="0.608em" rspace="0.608em">⊂</mo><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo rspace="0.330em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.608em">⊂</mo><msub><mi>𝕊</mi><mi>I</mi></msub><mo>=</mo><msub><mi>𝕊</mi><mn>9</mn></msub></mrow><annotation encoding="application/x-tex">\mathrm{Stab}_{\tau}(T)=\left(\mathbb{S}_{I_{v_{1}}}\times\mathbb{S}_{I_{v_{2}}}\times\mathbb{S}_{I_{v_{3}}}\right)\cdot\tau~\subset~\mathrm{Stab}(T)~\subset~\mathbb{S}_{I}=\mathbb{S}_{9}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.Thmtheorem9.p1.3" class="ltx_p">as described in (<a href="#S7.E8" title="In 7.3. Quotient trees ‣ 7. Proofs of asymptotic formulas ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.8</span></a>), where <math id="S7.Thmtheorem9.p1.m12" class="ltx_Math" alttext="p=1" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p=1</annotation></semantics></math> in this case.</p>
</div>
<div id="S7.Thmtheorem9.p2" class="ltx_para">
<p id="S7.Thmtheorem9.p2.1" class="ltx_p">Moreover, the map (<a href="#S7.E6" title="In 7.3. Quotient trees ‣ 7. Proofs of asymptotic formulas ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.6</span></a>) is described as follows. Let <math id="S7.Thmtheorem9.p2.m1" class="ltx_Math" alttext="\sigma\in\mathrm{Stab}_{\tau}(T)" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>∈</mo><mrow><msub><mi>Stab</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sigma\in\mathrm{Stab}_{\tau}(T)</annotation></semantics></math>. Express <math id="S7.Thmtheorem9.p2.m2" class="ltx_Math" alttext="\sigma:=(\sigma_{1},\sigma_{2},\sigma_{3};\tau)" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>:=</mo><mrow><mo stretchy="false">(</mo><msub><mi>σ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>σ</mi><mn>2</mn></msub><mo>,</mo><msub><mi>σ</mi><mn>3</mn></msub><mo>,</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\sigma:=(\sigma_{1},\sigma_{2},\sigma_{3};\tau)</annotation></semantics></math> as an element in (<a href="#S7.E8" title="In 7.3. Quotient trees ‣ 7. Proofs of asymptotic formulas ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.8</span></a>). Note that <math id="S7.Thmtheorem9.p2.m3" class="ltx_Math" alttext="\sigma_{j}:=\sigma_{v_{j}}\in\mathbb{S}_{I_{v_{j}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mi>j</mi></msub><mo>:=</mo><msub><mi>σ</mi><msub><mi>v</mi><mi>j</mi></msub></msub><mo>∈</mo><msub><mi>𝕊</mi><msub><mi>I</mi><msub><mi>v</mi><mi>j</mi></msub></msub></msub></mrow><annotation encoding="application/x-tex">\sigma_{j}:=\sigma_{v_{j}}\in\mathbb{S}_{I_{v_{j}}}</annotation></semantics></math> is chosen so that <math id="S7.Thmtheorem9.p2.m4" class="ltx_Math" alttext="\sigma(i)=\sigma_{\tau(v_{j})}(\tau(i))" display="inline" intent=":literal"><semantics><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>σ</mi><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sigma(i)=\sigma_{\tau(v_{j})}(\tau(i))</annotation></semantics></math> if <math id="S7.Thmtheorem9.p2.m5" class="ltx_Math" alttext="i\in I_{v_{j}}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><msub><mi>I</mi><msub><mi>v</mi><mi>j</mi></msub></msub></mrow><annotation encoding="application/x-tex">i\in I_{v_{j}}</annotation></semantics></math>.
By taking its third power, we obtain</p>
<table id="S7.Ex26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S7.Ex26.m1" class="ltx_Math" alttext="\begin{split}\sigma^{3}&amp;=\big(\sigma_{1},~\sigma_{2},~\sigma_{3};~\tau\big)\cdot\big(\sigma_{1},~\sigma_{2},~\sigma_{3};~\tau\big)\cdot\big(\sigma_{1},~\sigma_{2},~\sigma_{3};~\tau\big)\\
&amp;=\big(\sigma_{1}\varphi_{\tau}(\sigma_{3}),~\sigma_{2}\varphi_{\tau}(\sigma_{1}),~\sigma_{3}\varphi_{\tau}(\sigma_{2});~\tau^{2}\big)\cdot\big(\sigma_{1},~\sigma_{2},~\sigma_{3};~\tau\big)\\
&amp;=\big(\sigma_{1}\varphi_{\tau}(\sigma_{3})\varphi_{\tau^{2}}(\sigma_{2}),~\sigma_{2}\varphi_{\tau}(\sigma_{1})\varphi_{\tau^{2}}(\sigma_{3}),~\sigma_{3}\varphi_{\tau}(\sigma_{2})\varphi_{\tau^{2}}(\sigma_{1});~e\big)\\
&amp;=\big(\sigma_{1}\tau\sigma_{3}\tau\sigma_{2}\tau,~\sigma_{2}\tau\sigma_{1}\tau\sigma_{3}\tau,~\sigma_{3}\tau\sigma_{2}\tau\sigma_{1}\tau;~e\big)\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><msup><mi>σ</mi><mn>3</mn></msup></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>σ</mi><mn>1</mn></msub><mo mathsize="1.200em" rspace="0.497em">,</mo><msub><mi>σ</mi><mn>2</mn></msub><mo mathsize="1.200em" rspace="0.497em">,</mo><msub><mi>σ</mi><mn>3</mn></msub><mo mathsize="1.200em" rspace="0.497em">,</mo><mi>τ</mi><mo maxsize="1.200em" minsize="1.200em" rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>σ</mi><mn>1</mn></msub><mo mathsize="1.200em" rspace="0.497em">,</mo><msub><mi>σ</mi><mn>2</mn></msub><mo mathsize="1.200em" rspace="0.497em">,</mo><msub><mi>σ</mi><mn>3</mn></msub><mo mathsize="1.200em" rspace="0.497em">,</mo><mi>τ</mi><mo maxsize="1.200em" minsize="1.200em" rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>σ</mi><mn>1</mn></msub><mo mathsize="1.200em" rspace="0.497em">,</mo><msub><mi>σ</mi><mn>2</mn></msub><mo mathsize="1.200em" rspace="0.497em">,</mo><msub><mi>σ</mi><mn>3</mn></msub><mo mathsize="1.200em" rspace="0.497em">,</mo><mi>τ</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>φ</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>σ</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo mathsize="1.200em" rspace="0.497em">,</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>φ</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>σ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo mathsize="1.200em" rspace="0.497em">,</mo><mrow><msub><mi>σ</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>φ</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>σ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo mathsize="1.200em" rspace="0.497em">,</mo><msup><mi>τ</mi><mn>2</mn></msup><mo maxsize="1.200em" minsize="1.200em" rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>σ</mi><mn>1</mn></msub><mo mathsize="1.200em" rspace="0.497em">,</mo><msub><mi>σ</mi><mn>2</mn></msub><mo mathsize="1.200em" rspace="0.497em">,</mo><msub><mi>σ</mi><mn>3</mn></msub><mo mathsize="1.200em" rspace="0.497em">,</mo><mi>τ</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>φ</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>σ</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>φ</mi><msup><mi>τ</mi><mn>2</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>σ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo mathsize="1.200em" rspace="0.497em">,</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>φ</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>σ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>φ</mi><msup><mi>τ</mi><mn>2</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>σ</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo mathsize="1.200em" rspace="0.497em">,</mo><mrow><msub><mi>σ</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>φ</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>σ</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>φ</mi><msup><mi>τ</mi><mn>2</mn></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>σ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo mathsize="1.200em" rspace="0.497em">,</mo><mi>e</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow><mo mathsize="1.200em" rspace="0.497em">,</mo><mrow><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow><mo mathsize="1.200em" rspace="0.497em">,</mo><mrow><msub><mi>σ</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow><mo mathsize="1.200em" rspace="0.497em">,</mo><mi>e</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\sigma^{3}&amp;=\big(\sigma_{1},~\sigma_{2},~\sigma_{3};~\tau\big)\cdot\big(\sigma_{1},~\sigma_{2},~\sigma_{3};~\tau\big)\cdot\big(\sigma_{1},~\sigma_{2},~\sigma_{3};~\tau\big)\\
&amp;=\big(\sigma_{1}\varphi_{\tau}(\sigma_{3}),~\sigma_{2}\varphi_{\tau}(\sigma_{1}),~\sigma_{3}\varphi_{\tau}(\sigma_{2});~\tau^{2}\big)\cdot\big(\sigma_{1},~\sigma_{2},~\sigma_{3};~\tau\big)\\
&amp;=\big(\sigma_{1}\varphi_{\tau}(\sigma_{3})\varphi_{\tau^{2}}(\sigma_{2}),~\sigma_{2}\varphi_{\tau}(\sigma_{1})\varphi_{\tau^{2}}(\sigma_{3}),~\sigma_{3}\varphi_{\tau}(\sigma_{2})\varphi_{\tau^{2}}(\sigma_{1});~e\big)\\
&amp;=\big(\sigma_{1}\tau\sigma_{3}\tau\sigma_{2}\tau,~\sigma_{2}\tau\sigma_{1}\tau\sigma_{3}\tau,~\sigma_{3}\tau\sigma_{2}\tau\sigma_{1}\tau;~e\big)\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S7.Thmtheorem9.p2.2" class="ltx_p">in <math id="S7.Thmtheorem9.p2.m6" class="ltx_Math" alttext="\mathrm{Stab}(T)" display="inline" intent=":literal"><semantics><mrow><mi>Stab</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Stab}(T)</annotation></semantics></math>, where <math id="S7.Thmtheorem9.p2.m7" class="ltx_Math" alttext="\varphi_{\tau}(\sigma_{j}):=\tau\sigma_{j}\tau^{-1}\in\mathbb{S}_{I_{v_{\tau(j)}}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>φ</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>σ</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mi>τ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>τ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>∈</mo><msub><mi>𝕊</mi><msub><mi>I</mi><msub><mi>v</mi><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mrow></msub></msub></msub></mrow><annotation encoding="application/x-tex">\varphi_{\tau}(\sigma_{j}):=\tau\sigma_{j}\tau^{-1}\in\mathbb{S}_{I_{v_{\tau(j)}}}</annotation></semantics></math>. Thus, <math id="S7.Thmtheorem9.p2.m8" class="ltx_Math" alttext="\sigma^{3}\in\mathbb{S}_{I_{v_{1}}}\times\mathbb{S}_{I_{v_{2}}}\times\mathbb{S}_{I_{v_{3}}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>σ</mi><mn>3</mn></msup><mo>∈</mo><mrow><msub><mi>𝕊</mi><msub><mi>I</mi><msub><mi>v</mi><mn>1</mn></msub></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝕊</mi><msub><mi>I</mi><msub><mi>v</mi><mn>2</mn></msub></msub></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>𝕊</mi><msub><mi>I</mi><msub><mi>v</mi><mn>3</mn></msub></msub></msub></mrow></mrow><annotation encoding="application/x-tex">\sigma^{3}\in\mathbb{S}_{I_{v_{1}}}\times\mathbb{S}_{I_{v_{2}}}\times\mathbb{S}_{I_{v_{3}}}</annotation></semantics></math>. The map (<a href="#S7.E6" title="In 7.3. Quotient trees ‣ 7. Proofs of asymptotic formulas ‣ Characteristic polynomial of ℳ̄_{0,𝑛} and log-concavity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.6</span></a>) is obtained by composing this with the first projection map</p>
