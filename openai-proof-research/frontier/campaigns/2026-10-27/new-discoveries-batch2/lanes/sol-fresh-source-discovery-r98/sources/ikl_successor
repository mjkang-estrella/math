<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex24.m2" class="ltx_Math" alttext="\displaystyle=\sum_{\begin{subarray}{c}G\in\mathcal{L}(\mathsf{M}\smallsetminus i)\\
G\subseteq F_{0}\end{subarray}}x^{(\rk_{\mathsf{M}\smallsetminus i}(F_{0})+1)-\rk_{\mathsf{M}\smallsetminus i}(G)}P_{(\mathsf{M}\smallsetminus i)|_{F_{0}}/G}(x^{-2})\cdot\Gamma_{\mathsf{M}\smallsetminus i}^{G}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>G</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝖬</mi><mo>∖</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mi>G</mi><mo>⊆</mo><msub><mi>F</mi><mn>0</mn></msub></mrow></mtd></mtr></mtable></munder></mstyle><mrow><msup><mi>x</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>rk</mi><mrow><mi>𝖬</mi><mo>∖</mo><mi>i</mi></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><msub><mi>rk</mi><mrow><mi>𝖬</mi><mo>∖</mo><mi>i</mi></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><msub><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝖬</mi><mo>∖</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">|</mo></mrow><msub><mi>F</mi><mn>0</mn></msub></msub><mo>/</mo><mi>G</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi mathvariant="normal">Γ</mi><mrow><mi>𝖬</mi><mo>∖</mo><mi>i</mi></mrow><mi>G</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{\begin{subarray}{c}G\in\mathcal{L}(\mathsf{M}\smallsetminus i)\\
