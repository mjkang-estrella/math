e">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">Q_{\mathsf{M}}(x)=Q_{\mathsf{U}_{n-2,n}}(x)-\sum_{r}\uplambda_{r}\sum_{a=2}^{n-r-1}\left(Q_{\mathsf{C}_{a,n+1-a}}(x)-Q_{\mathsf{U}_{a-1,a}}(x)\,Q_{\mathsf{U}_{n-a-1,n-a}}(x)\right),</annotation></semantics></math></td>
