false">|</mo></mrow><mi>F</mi></msub><mo>/</mo><mi>G</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><msubsup><mtext class="undefined">\upzeta</mtext><mi>𝖬</mi><mi>G</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{G\in\mathcal{L}(\mathsf{M})}x^{2\rk(E)-\rk(G)}\left(\sum_{\begin{subarray}{c}F\in\mathcal{L}(\mathsf{M})\\
