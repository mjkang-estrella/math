<tbody id="S1.Ex2"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S1.Ex2.m1" class="ltx_Math" alttext="\displaystyle Z_{\mathsf{M}}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle Z_{\mathsf{M}}(x)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S1.Ex2.m2" class="ltx_Math" alttext="\displaystyle=Z_{\mathsf{M}\smallsetminus\{i\}}(x)+\sum_{F\in{S}_{i}}\uptau\left(\mathsf{M}/{(F\cup\{i\})}\right)\,x^{\frac{k-\rk(F)}{2}}\,Z_{\mathsf{M}|_{F}}(x)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>Z</mi><mrow><mi>𝖬</mi><mo>∖</mo><mrow><mo stretchy="false">{</mo><mi>i</mi><mo stretchy="false">}</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>F</mi><mo>∈</mo><msub><mi>S</mi><mi>i</mi></msub></mrow></munder></mstyle><mrow><mtext class="undefined">\uptau</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>𝖬</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>F</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>i</mi><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>x</mi><mfrac><mrow><mi>k</mi><mo>−</mo><mrow><mi>rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mn>2</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>Z</mi><msub><mrow><mi>𝖬</mi><mo stretchy="false">|</mo></mrow><mi>F</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=Z_{\mathsf{M}\smallsetminus\{i\}}(x)+\sum_{F\in{S}_{i}}\uptau\left(\mathsf{M}/{(F\cup\{i\})}\right)\,x^{\frac{k-\rk(F)}{2}}\,Z_{\mathsf{M}|_{F}}(x).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S1.p6" class="ltx_para ltx_noindent">
<p id="S1.p6.1" class="ltx_p">In the above statement, the notation <math id="S1.p6.m1" class="ltx_Math" alttext="{{S}}_{i}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{{S}}_{i}</annotation></semantics></math> stands for a distinguished set of flats:</p>
<table id="S1.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(1)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.E1.m1" class="ltx_Math" alttext="{{S}}_{i}={{S}}_{i}(\mathsf{M})=\left\{F\in\mathcal{L}(\mathsf{M}):F\subsetneq E\smallsetminus\{i\}\text{ and }F\cup\{i\}\in\mathcal{L}(\mathsf{M})\right\}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mrow><mi>F</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mi>F</mi><mo>⊊</mo><mrow><mrow><mi>E</mi><mo>∖</mo><mrow><mrow><mo stretchy="false">{</mo><mi>i</mi><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext> and </mtext><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></mrow><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>i</mi><mo stretchy="false">}</mo></mrow></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">{{S}}_{i}={{S}}_{i}(\mathsf{M})=\left\{F\in\mathcal{L}(\mathsf{M}):F\subsetneq E\smallsetminus\{i\}\text{ and }F\cup\{i\}\in\mathcal{L}(\mathsf{M})\right\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.p6.2" class="ltx_p">while</p>
<table id="S1.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.Ex3.m1" class="ltx_Math" alttext="\uptau(\mathsf{M}):=\begin{cases}[x^{\frac{\rk(\mathsf{M})-1}{2}}]P_{\mathsf{M}}(x)&amp;\text{if $\rk(\mathsf{M})$ is odd,}\\
0&amp;\text{if $\rk(\mathsf{M})$ is even.}\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><mtext class="undefined">\uptau</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mo stretchy="false">[</mo><msup><mi>x</mi><mfrac><mrow><mrow><mi>rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mn>2</mn></mfrac></msup><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>if </mtext><mrow><mi>rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><mtext> is odd,</mtext></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>0</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>if </mtext><mrow><mi>rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><mtext> is even.</mtext></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\uptau(\mathsf{M}):=\begin{cases}[x^{\frac{\rk(\mathsf{M})-1}{2}}]P_{\mathsf{M}}(x)&amp;\text{if $\rk(\mathsf{M})$ is odd,}\\
0&amp;\text{if $\rk(\mathsf{M})$ is even.}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S1.p7" class="ltx_para ltx_noindent">
<p id="S1.p7.1" class="ltx_p">In addition to the intrinsic interest in computing these polynomials, the community has shown considerable excitement about when they might exhibit log-concavity and real-rootedness properties.</p>
</div>
<div id="S1.Thmtheorem2" class="ltx_theorem ltx_theorem_conjecture">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S1.Thmtheorem2.2" class="ltx_text ltx_font_bold">Conjecture 1.2</span></span></h6>
<div id="S1.Thmtheorem2.p1" class="ltx_para">
<p id="S1.Thmtheorem2.p1.1" class="ltx_p">For every matroid <math id="S1.Thmtheorem2.p1.m1" class="ltx_Math" alttext="\mathsf{M}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">\mathsf{M}</annotation></semantics></math>, the following properties hold:</p>
<ol id="S1.I2" class="ltx_enumerate">
<li id="S1.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(a)</span> 
<div id="S1.I2.i1.p1" class="ltx_para">
<p id="S1.I2.i1.p1.1" class="ltx_p"><cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">13</a>, Conjecture 3.2]</cite> The polynomial <math id="S1.I2.i1.p1.m1" class="ltx_Math" alttext="P_{\mathsf{M}}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P_{\mathsf{M}}(x)</annotation></semantics></math> is real-rooted.</p>
</div></li>
<li id="S1.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(b)</span> 
<div id="S1.I2.i2.p1" class="ltx_para">
<p id="S1.I2.i2.p1.1" class="ltx_p"><cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib6" title="" class="ltx_ref">18</a>, Conjecture 5.1]</cite> The polynomial <math id="S1.I2.i2.p1.m1" class="ltx_Math" alttext="Z_{\mathsf{M}}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Z_{\mathsf{M}}(x)</annotation></semantics></math> is real-rooted.</p>
</div></li>
<li id="S1.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(c)</span> 
<div id="S1.I2.i3.p1" class="ltx_para">
<p id="S1.I2.i3.p1.1" class="ltx_p"><cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib18" title="" class="ltx_ref">12</a>, Conjecture 4.2]</cite> The polynomial <math id="S1.I2.i3.p1.m1" class="ltx_Math" alttext="Q_{\mathsf{M}}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Q_{\mathsf{M}}(x)</annotation></semantics></math> has log-concave coefficients.</p>
</div></li>
<li id="S1.I2.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(d)</span> 
<div id="S1.I2.i4.p1" class="ltx_para">
<p id="S1.I2.i4.p1.1" class="ltx_p"><cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib25" title="" class="ltx_ref">11</a>, Conjecture 1.5]</cite> The polynomial <math id="S1.I2.i4.p1.m1" class="ltx_Math" alttext="Y_{\mathsf{M}}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Y_{\mathsf{M}}(x)</annotation></semantics></math> has log-concave coefficients.</p>
</div></li>
</ol>
</div>
</div>
<div id="S1.p8" class="ltx_para">
<p id="S1.p8.1" class="ltx_p">For (<a href="#S1.I2.i1" title="Item a ‣ Conjecture 1.2 ‣ 1. Introduction ‣ Inverse Kazhdan–Lusztig polynomialsof matroids under deletion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">a</span></a>), (<a href="#S1.I2.i3" title="Item c ‣ Conjecture 1.2 ‣ 1. Introduction ‣ Inverse Kazhdan–Lusztig polynomialsof matroids under deletion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">c</span></a>), and (<a href="#S1.I2.i4" title="Item d ‣ Conjecture 1.2 ‣ 1. Introduction ‣ Inverse Kazhdan–Lusztig polynomialsof matroids under deletion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">d</span></a>), the existing evidence consists mostly of explicit computations for special families of matroids, e.g., wheels and whirls <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib8" title="" class="ltx_ref">15</a>]</cite>, uniform matroids <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib22" title="" class="ltx_ref">25</a>, <a href="#bib.bib24" title="" class="ltx_ref">10</a>]</cite>, thagomizer matroids <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib11" title="" class="ltx_ref">14</a>, <a href="#bib.bib23" title="" class="ltx_ref">24</a>]</cite>, and sparse paving matroids <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib16" title="" class="ltx_ref">9</a>, <a href="#bib.bib1" title="" class="ltx_ref">7</a>, <a href="#bib.bib25" title="" class="ltx_ref">11</a>]</cite>.</p>
</div>
<div id="S1.p9" class="ltx_para">
<p id="S1.p9.1" class="ltx_p">For (<a href="#S1.I2.i2" title="Item b ‣ Conjecture 1.2 ‣ 1. Introduction ‣ Inverse Kazhdan–Lusztig polynomialsof matroids under deletion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">b</span></a>) there is a general partial result, proved by Ferroni, Matherne, Stevens, and Vecchi in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib2" title="" class="ltx_ref">5</a>, Theorem 4.7]</cite>: this asserts that <math id="S1.p9.m1" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math>-polynomials of matroids are <math id="S1.p9.m2" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math>-positive, a result that was conjectured in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib1" title="" class="ltx_ref">7</a>]</cite>. This is weaker than real-rootedness, but stronger than unimodality<span id="footnote1" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">1</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">1</sup>
            <span class="ltx_tag ltx_tag_note">1</span>
            
            
            
            
            
            
            
          The unimodality of <math id="footnote1.m1" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math>-polynomials follows from the hard Lefschetz theorem on the intersection cohomology module, proved by Braden, Huh, Matherne, Proudfoot, and Wang, see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib13" title="" class="ltx_ref">2</a>, Theorem 1.2]</cite>.</span></span></span>. We emphasize that a key role in that proof is played by the deletion formula for <math id="S1.p9.m3" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math>-polynomials appearing in Theorem <a href="#S1.Thmtheorem1" title="Theorem 1.1 ([, Theorem 2.8]) ‣ 1. Introduction ‣ Inverse Kazhdan–Lusztig polynomialsof matroids under deletion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.1</span></a>.</p>
</div>
<div id="S1.p10" class="ltx_para">
<p id="S1.p10.1" class="ltx_p">A refinement of Conjecture <a href="#S1.Thmtheorem2" title="Conjecture 1.2 ‣ 1. Introduction ‣ Inverse Kazhdan–Lusztig polynomialsof matroids under deletion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.2</span></a>(<a href="#S1.I2.i3" title="Item c ‣ Conjecture 1.2 ‣ 1. Introduction ‣ Inverse Kazhdan–Lusztig polynomialsof matroids under deletion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">c</span></a>) was recently proposed by Xie and Zhang <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib21" title="" class="ltx_ref">26</a>]</cite>. In order to state their conjecture we introduce some terminology. If <math id="S1.p10.m1" class="ltx_Math" alttext="Q_{\mathsf{M}}(x)=q_{0}+q_{1}x+\cdots+q_{s}x^{s}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>Q</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>q</mi><mn>0</mn></msub><mo>+</mo><mrow><msub><mi>q</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><mrow><msub><mi>q</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mi>s</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">Q_{\mathsf{M}}(x)=q_{0}+q_{1}x+\cdots+q_{s}x^{s}</annotation></semantics></math> where <math id="S1.p10.m2" class="ltx_Math" alttext="s=\deg Q_{\mathsf{M}}\leq\lfloor\frac{\rk(\mathsf{M})-1}{2}\rfloor" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>=</mo><mrow><mi>deg</mi><mo lspace="0.167em">⁡</mo><msub><mi>Q</mi><mi>𝖬</mi></msub></mrow><mo>≤</mo><mrow><mo stretchy="false">⌊</mo><mfrac><mrow><mrow><mi>rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mn>2</mn></mfrac><mo stretchy="false">⌋</mo></mrow></mrow><annotation encoding="application/x-tex">s=\deg Q_{\mathsf{M}}\leq\lfloor\frac{\rk(\mathsf{M})-1}{2}\rfloor</annotation></semantics></math>, then we define the <em id="S1.p10.1.1" class="ltx_emph ltx_font_italic">normalization</em> of <math id="S1.p10.m3" class="ltx_Math" alttext="Q_{\mathsf{M}}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Q_{\mathsf{M}}(x)</annotation></semantics></math> as the polynomial</p>
<table id="S1.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.Ex4.m1" class="ltx_Math" alttext="\mathcal{B}(Q_{\mathsf{M}})(x)=\binom{s}{0}q_{0}+\binom{s}{1}q_{1}\,x+\cdots+\binom{s}{s}q_{s}\,x^{s}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Q</mi><mi>𝖬</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>s</mi><mn>0</mn></mfrac><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>s</mi><mn>1</mn></mfrac><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><mrow><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>s</mi><mi>s</mi></mfrac><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mi>s</mi></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{B}(Q_{\mathsf{M}})(x)=\binom{s}{0}q_{0}+\binom{s}{1}q_{1}\,x+\cdots+\binom{s}{s}q_{s}\,x^{s}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S1.p10.2" class="ltx_p">That is, the polynomial <math id="S1.p10.m4" class="ltx_Math" alttext="\mathcal{B}(Q_{\mathsf{M}})(x)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Q</mi><mi>𝖬</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{B}(Q_{\mathsf{M}})(x)</annotation></semantics></math> is the Hadamard product of <math id="S1.p10.m5" class="ltx_Math" alttext="Q_{\mathsf{M}}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Q_{\mathsf{M}}(x)</annotation></semantics></math> and <math id="S1.p10.m6" class="ltx_Math" alttext="(1+x)^{s}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mi>s</mi></msup><annotation encoding="application/x-tex">(1+x)^{s}</annotation></semantics></math>.</p>
</div>
<div id="S1.Thmtheorem3" class="ltx_theorem ltx_theorem_conjecture">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S1.Thmtheorem3.2" class="ltx_text ltx_font_bold">Conjecture 1.3</span></span><span id="S1.Thmtheorem3.3" class="ltx_text ltx_font_bold"> </span>(<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib21" title="" class="ltx_ref">26</a>, Conjecture 1.4]</cite>)</h6>
<div id="S1.Thmtheorem3.p1" class="ltx_para">
<p id="S1.Thmtheorem3.p1.1" class="ltx_p">For every matroid <math id="S1.Thmtheorem3.p1.m1" class="ltx_Math" alttext="\mathsf{M}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">\mathsf{M}</annotation></semantics></math>, the polynomial <math id="S1.Thmtheorem3.p1.m2" class="ltx_Math" alttext="\mathcal{B}(Q_{\mathsf{M}})(x)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Q</mi><mi>𝖬</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{B}(Q_{\mathsf{M}})(x)</annotation></semantics></math> is real-rooted.</p>
</div>
</div>
<div id="S1.p11" class="ltx_para">
<p id="S1.p11.1" class="ltx_p">The last conjecture would imply, via the Newton inequalities on real-rooted polynomials, the ultra log-concavity of the coefficients of <math id="S1.p11.m1" class="ltx_Math" alttext="\mathcal{B}(Q_{\mathsf{M}})(x)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Q</mi><mi>𝖬</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{B}(Q_{\mathsf{M}})(x)</annotation></semantics></math>. This, in turn, is equivalent to the log-concavity of the coefficients of <math id="S1.p11.m2" class="ltx_Math" alttext="Q_{\mathsf{M}}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Q_{\mathsf{M}}(x)</annotation></semantics></math> predicted by Conjecture <a href="#S1.Thmtheorem2" title="Conjecture 1.2 ‣ 1. Introduction ‣ Inverse Kazhdan–Lusztig polynomialsof matroids under deletion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.2</span></a>(<a href="#S1.I2.i3" title="Item c ‣ Conjecture 1.2 ‣ 1. Introduction ‣ Inverse Kazhdan–Lusztig polynomialsof matroids under deletion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">c</span></a>). To support their own conjecture, Xie and Zhang proved that it holds for all paving matroids, a class of matroids that is conjecturally predominant <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib3" title="" class="ltx_ref">16</a>, Conjecture 1.6]</cite>.</p>
</div>
<section id="S1.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">1.1. </span>Main results</h3>

<div id="S1.SS1.p1" class="ltx_para">
<p id="S1.SS1.p1.1" class="ltx_p">Motivated by Theorem <a href="#S1.Thmtheorem1" title="Theorem 1.1 ([, Theorem 2.8]) ‣ 1. Introduction ‣ Inverse Kazhdan–Lusztig polynomialsof matroids under deletion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.1</span></a>, we were led to consider a deletion formula for both the inverse Kazhdan–Lusztig polynomials <math id="S1.SS1.p1.m1" class="ltx_Math" alttext="Q_{\mathsf{M}}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Q_{\mathsf{M}}(x)</annotation></semantics></math> and the inverse <math id="S1.SS1.p1.m2" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math>-polynomials <math id="S1.SS1.p1.m3" class="ltx_Math" alttext="Y_{\mathsf{M}}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Y_{\mathsf{M}}(x)</annotation></semantics></math>. Even though each of these polynomials, up to a sign, arise by inverting, respectively, <math id="S1.SS1.p1.m4" class="ltx_Math" alttext="P_{\mathsf{M}}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P_{\mathsf{M}}(x)</annotation></semantics></math> and <math id="S1.SS1.p1.m5" class="ltx_Math" alttext="Z_{\mathsf{M}}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Z_{\mathsf{M}}(x)</annotation></semantics></math> in the incidence algebra of the lattice of flats <math id="S1.SS1.p1.m6" class="ltx_Math" alttext="\mathcal{L}(\mathsf{M})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}(\mathsf{M})</annotation></semantics></math> (see Section <a href="#S2.SS2" title="2.2. A recapitulation on the Kazhdan–Lusztig invariants ‣ 2. Preliminaries ‣ Inverse Kazhdan–Lusztig polynomialsof matroids under deletion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.2</span></a> for more details), it is not at all clear how to deduce the desired deletion formulas from Theorem <a href="#S1.Thmtheorem1" title="Theorem 1.1 ([, Theorem 2.8]) ‣ 1. Introduction ‣ Inverse Kazhdan–Lusztig polynomialsof matroids under deletion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.1</span></a>.</p>
</div>
<div id="S1.SS1.p2" class="ltx_para">
<p id="S1.SS1.p2.1" class="ltx_p">In order to state the deletion formulas for <math id="S1.SS1.p2.m1" class="ltx_Math" alttext="Q_{\mathsf{M}}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Q_{\mathsf{M}}(x)</annotation></semantics></math> and <math id="S1.SS1.p2.m2" class="ltx_Math" alttext="Y_{\mathsf{M}}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Y_{\mathsf{M}}(x)</annotation></semantics></math> we need to introduce a counterpart for the sets <math id="S1.SS1.p2.m3" class="ltx_Math" alttext="{S}_{i}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>i</mi></msub><annotation encoding="application/x-tex">{S}_{i}</annotation></semantics></math> appearing in equation (<a href="#S1.E1" title="Equation 1 ‣ 1. Introduction ‣ Inverse Kazhdan–Lusztig polynomialsof matroids under deletion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>). We define</p>
<table id="S1.E2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(2)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S1.E2.m1" class="ltx_Math" alttext="{T}_{i}={T}_{i}(\mathsf{M}):=\left\{F\in\mathcal{L}(\mathsf{M}):i\in F\text{ and }F\smallsetminus\{i\}\notin\mathcal{L}(\mathsf{M})\right\}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mo>{</mo><mrow><mi>F</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mtext> and </mtext><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>∖</mo><mrow><mo stretchy="false">{</mo><mi>i</mi><mo stretchy="false">}</mo></mrow></mrow><mo>∉</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{T}_{i}={T}_{i}(\mathsf{M}):=\left\{F\in\mathcal{L}(\mathsf{M}):i\in F\text{ and }F\smallsetminus\{i\}\notin\mathcal{L}(\mathsf{M})\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S1.Thmtheorem4" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S1.Thmtheorem4.2" class="ltx_text ltx_font_bold">Theorem 1.4</span></span></h6>
<div id="S1.Thmtheorem4.p1" class="ltx_para">
<p id="S1.Thmtheorem4.p1.1" class="ltx_p"><span id="S1.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S1.Thmtheorem4.p1.m1" class="ltx_Math" alttext="\mathsf{M}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">\mathsf{M}</annotation></semantics></math> be a loopless matroid on <math id="S1.Thmtheorem4.p1.m2" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>, and let <math id="S1.Thmtheorem4.p1.m3" class="ltx_Math" alttext="i\in E" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mi>E</mi></mrow><annotation encoding="application/x-tex">i\in E</annotation></semantics></math> be an element that is not a coloop. Then, the following identities hold:</span></p>
<table id="S1.EGx2" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S1.Ex5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S1.Ex5.m1" class="ltx_Math" alttext="\displaystyle Q_{\mathsf{M}}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle Q_{\mathsf{M}}(x)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S1.Ex5.m2" class="ltx_Math" alttext="\displaystyle=Q_{\mathsf{M}\smallsetminus i}(x)+(1+x)Q_{\mathsf{M}/i}(x)-\sum_{F\in\mathcal{T}_{i}}\uptau(\mathsf{M}|_{F}/i)\,x^{\rk(F)/2}\,Q_{\mathsf{M}/F}(x)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><msub><mi>Q</mi><mrow><mi>𝖬</mi><mo>∖</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>Q</mi><mrow><mi>𝖬</mi><mo>/</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>F</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>i</mi></msub></mrow></munder></mstyle><mrow><mtext class="undefined">\uptau</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mrow><mi>𝖬</mi><mo stretchy="false">|</mo></mrow><mi>F</mi></msub><mo>/</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>x</mi><mrow><mrow><mi>rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>Q</mi><mrow><mi>𝖬</mi><mo>/</mo><mi>F</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=Q_{\mathsf{M}\smallsetminus i}(x)+(1+x)Q_{\mathsf{M}/i}(x)-\sum_{F\in\mathcal{T}_{i}}\uptau(\mathsf{M}|_{F}/i)\,x^{\rk(F)/2}\,Q_{\mathsf{M}/F}(x),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S1.Ex6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S1.Ex6.m1" class="ltx_Math" alttext="\displaystyle Y_{\mathsf{M}}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle Y_{\mathsf{M}}(x)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S1.Ex6.m2" class="ltx_Math" alttext="\displaystyle=Y_{\mathsf{M}\smallsetminus i}(x)+(1+x)Y_{\mathsf{M}/i}(x)-\sum_{F\in\mathcal{T}_{i}}\uptau(\mathsf{M}|_{F}/i)\,x^{\rk(F)/2}\,Y_{\mathsf{M}/F}(x)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><msub><mi>Y</mi><mrow><mi>𝖬</mi><mo>∖</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>Y</mi><mrow><mi>𝖬</mi><mo>/</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>F</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>i</mi></msub></mrow></munder></mstyle><mrow><mtext class="undefined">\uptau</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mrow><mi>𝖬</mi><mo stretchy="false">|</mo></mrow><mi>F</mi></msub><mo>/</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>x</mi><mrow><mrow><mi>rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>Y</mi><mrow><mi>𝖬</mi><mo>/</mo><mi>F</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=Y_{\mathsf{M}\smallsetminus i}(x)+(1+x)Y_{\mathsf{M}/i}(x)-\sum_{F\in\mathcal{T}_{i}}\uptau(\mathsf{M}|_{F}/i)\,x^{\rk(F)/2}\,Y_{\mathsf{M}/F}(x).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S1.SS1.p3" class="ltx_para">
<p id="S1.SS1.p3.1" class="ltx_p">Our formulas lead to new recursive computations of <math id="S1.SS1.p3.m1" class="ltx_Math" alttext="Q_{\mathsf{M}}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Q_{\mathsf{M}}(x)</annotation></semantics></math> and <math id="S1.SS1.p3.m2" class="ltx_Math" alttext="Y_{\mathsf{M}}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Y_{\mathsf{M}}(x)</annotation></semantics></math> for any matroid <math id="S1.SS1.p3.m3" class="ltx_Math" alttext="\mathsf{M}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">\mathsf{M}</annotation></semantics></math>, starting from the base case of Boolean matroids <math id="S1.SS1.p3.m4" class="ltx_Math" alttext="\mathsf{U}_{n,n}" display="inline" intent=":literal"><semantics><msub><mi>𝖴</mi><mrow><mi>n</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\mathsf{U}_{n,n}</annotation></semantics></math>. For these matroids, we have <math id="S1.SS1.p3.m5" class="ltx_Math" alttext="Q_{\mathsf{U}_{n,n}}(x)=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>Q</mi><msub><mi>𝖴</mi><mrow><mi>n</mi><mo>,</mo><mi>n</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">Q_{\mathsf{U}_{n,n}}(x)=1</annotation></semantics></math> and <math id="S1.SS1.p3.m6" class="ltx_Math" alttext="Y_{\mathsf{U}_{n,n}}(x)=(x+1)^{n}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>Y</mi><msub><mi>𝖴</mi><mrow><mi>n</mi><mo>,</mo><mi>n</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">Y_{\mathsf{U}_{n,n}}(x)=(x+1)^{n}</annotation></semantics></math>.
Note that the deletion formulas for <math id="S1.SS1.p3.m7" class="ltx_Math" alttext="Q_{\mathsf{M}}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Q_{\mathsf{M}}(x)</annotation></semantics></math> and <math id="S1.SS1.p3.m8" class="ltx_Math" alttext="Y_{\mathsf{M}}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Y_{\mathsf{M}}(x)</annotation></semantics></math> are exactly the same, a phenomenon that does not occur in Theorem <a href="#S1.Thmtheorem1" title="Theorem 1.1 ([, Theorem 2.8]) ‣ 1. Introduction ‣ Inverse Kazhdan–Lusztig polynomialsof matroids under deletion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.1</span></a>.</p>
</div>
<div id="S1.SS1.p4" class="ltx_para">
<p id="S1.SS1.p4.1" class="ltx_p">While there is a geometric intuition behind Theorem <a href="#S1.Thmtheorem1" title="Theorem 1.1 ([, Theorem 2.8]) ‣ 1. Introduction ‣ Inverse Kazhdan–Lusztig polynomialsof matroids under deletion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.1</span></a> (see the discussion in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib10" title="" class="ltx_ref">3</a>, Section 1.1]</cite>), we lack that intuition in the present framework. In a sense, the proof of Theorem <a href="#S1.Thmtheorem4" title="Theorem 1.4 ‣ 1.1. Main results ‣ 1. Introduction ‣ Inverse Kazhdan–Lusztig polynomialsof matroids under deletion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.4</span></a> is purely algebraic, though combinatorics joins the game when we apply properties of incidence algebras of posets in our computations.</p>
</div>
<div id="S1.SS1.p5" class="ltx_para">
<p id="S1.SS1.p5.1" class="ltx_p">As a notable application of Theorem <a href="#S1.Thmtheorem4" title="Theorem 1.4 ‣ 1.1. Main results ‣ 1. Introduction ‣ Inverse Kazhdan–Lusztig polynomialsof matroids under deletion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.4</span></a>, we are able to show (see Theorem <a href="#S5.Thmtheorem3" title="Theorem 5.3 ‣ 5. A counterexample to Conjecture ‣ Inverse Kazhdan–Lusztig polynomialsof matroids under deletion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.3</span></a> below) the existence of a matroid of rank <math id="S1.SS1.p5.m1" class="ltx_Math" alttext="19" display="inline" intent=":literal"><semantics><mn>19</mn><annotation encoding="application/x-tex">19</annotation></semantics></math> which disproves Conjecture <a href="#S1.Thmtheorem3" title="Conjecture 1.3 ([, Conjecture 1.4]) ‣ 1. Introduction ‣ Inverse Kazhdan–Lusztig polynomialsof matroids under deletion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.3</span></a>.</p>
</div>
<div id="S1.Thmtheorem5" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S1.Thmtheorem5.2" class="ltx_text ltx_font_bold">Theorem 1.5</span></span></h6>
<div id="S1.Thmtheorem5.p1" class="ltx_para">
<p id="S1.Thmtheorem5.p1.1" class="ltx_p"><span id="S1.Thmtheorem5.p1.1.1" class="ltx_text ltx_font_italic">There exists a matroid <math id="S1.Thmtheorem5.p1.m1" class="ltx_Math" alttext="\mathsf{M}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">\mathsf{M}</annotation></semantics></math> of rank <math id="S1.Thmtheorem5.p1.m2" class="ltx_Math" alttext="19" display="inline" intent=":literal"><semantics><mn>19</mn><annotation encoding="application/x-tex">19</annotation></semantics></math> on <math id="S1.Thmtheorem5.p1.m3" class="ltx_Math" alttext="21" display="inline" intent=":literal"><semantics><mn>21</mn><annotation encoding="application/x-tex">21</annotation></semantics></math> elements whose normalized inverse Kazhdan–Lusztig polynomial <math id="S1.Thmtheorem5.p1.m4" class="ltx_Math" alttext="\mathcal{B}(Q_{\mathsf{M}})(x)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Q</mi><mi>𝖬</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{B}(Q_{\mathsf{M}})(x)</annotation></semantics></math> is not real-rooted.</span></p>
</div>
</div>
<div id="S1.SS1.p6" class="ltx_para">
<p id="S1.SS1.p6.1" class="ltx_p">Let us explain how we were led to the construction of the counterexample. Three crucial ingredients were needed:</p>
<ul id="S1.I3" class="ltx_itemize">
<li id="S1.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S1.I3.i1.p1" class="ltx_para">
<p id="S1.I3.i1.p1.1" class="ltx_p">The valuativity of the inverse Kazhdan–Lusztig polynomial.</p>
</div></li>
<li id="S1.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S1.I3.i2.p1" class="ltx_para">
<p id="S1.I3.i2.p1.1" class="ltx_p">A closed formula for the inverse Kazhdan–Lusztig polynomial of the graphic matroid associated to the graph consisting of two cycles glued along an edge.</p>
</div></li>
<li id="S1.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S1.I3.i3.p1" class="ltx_para">
<p id="S1.I3.i3.p1.1" class="ltx_p">A formula for the inverse Kazhdan–Lusztig polynomial of an arbitrary matroid of corank <math id="S1.I3.i3.p1.m1" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>.</p>
</div></li>
</ul>
</div>
<div id="S1.SS1.p7" class="ltx_para">
<p id="S1.SS1.p7.1" class="ltx_p">The first item in the above list is a result proved by Ardila and Sanchez <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib12" title="" class="ltx_ref">1</a>, Theorem 8.8]</cite>. The second item is a consequence of Theorem <a href="#S1.Thmtheorem4" title="Theorem 1.4 ‣ 1.1. Main results ‣ 1. Introduction ‣ Inverse Kazhdan–Lusztig polynomialsof matroids under deletion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.4</span></a> that we derive in the present paper (see Proposition <a href="#S4.Thmtheorem2" title="Proposition 4.2 ‣ 4.2. Glued cycles ‣ 4. Some special cases and examples ‣ Inverse Kazhdan–Lusztig polynomialsof matroids under deletion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>). The third, stated as Theorem <a href="#S5.Thmtheorem2" title="Theorem 5.2 ‣ 5. A counterexample to Conjecture ‣ Inverse Kazhdan–Lusztig polynomialsof matroids under deletion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.2</span></a>, relies on the machinery of Ferroni and Schröter <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib17" title="" class="ltx_ref">8</a>]</cite> on valuative invariants of elementary split matroids.</p>
</div>
<div id="S1.SS1.p8" class="ltx_para">
<p id="S1.SS1.p8.1" class="ltx_p">Besides these two main results, we also provide in Section <a href="#S4" title="4. Some special cases and examples ‣ Inverse Kazhdan–Lusztig polynomialsof matroids under deletion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> and Section <a href="#S5" title="5. A counterexample to Conjecture ‣ Inverse Kazhdan–Lusztig polynomialsof matroids under deletion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> several computational examples. They include formulas for our polynomials in the cases of uniform matroids, glued cycles, projective geometries with an element deleted, and corank <math id="S1.SS1.p8.m1" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math> matroids.</p>
</div>
</section>
</section>
<section id="S2" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">2. </span>Preliminaries</h2>

<div id="S2.p1" class="ltx_para">
<p id="S2.p1.1" class="ltx_p">We will assume familiarity with the essentials of matroid theory. For undefined terminology on matroids and geometric lattices, we refer to <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib14" title="" class="ltx_ref">23</a>, <a href="#bib.bib19" title="" class="ltx_ref">17</a>]</cite>. Unless indicated otherwise, in this paper we will typically assume that our matroid <math id="S2.p1.m1" class="ltx_Math" alttext="\mathsf{M}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">\mathsf{M}</annotation></semantics></math> is loopless, its ground set is <math id="S2.p1.m2" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>, and the rank of a subset <math id="S2.p1.m3" class="ltx_Math" alttext="A\subseteq E" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>⊆</mo><mi>E</mi></mrow><annotation encoding="application/x-tex">A\subseteq E</annotation></semantics></math> is denoted by <math id="S2.p1.m4" class="ltx_Math" alttext="\rk_{\mathsf{M}}(A)" display="inline" intent=":literal"><semantics><mrow><msub><mi>rk</mi><mi>𝖬</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rk_{\mathsf{M}}(A)</annotation></semantics></math>, or simply <math id="S2.p1.m5" class="ltx_Math" alttext="\rk(A)" display="inline" intent=":literal"><semantics><mrow><mi>rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rk(A)</annotation></semantics></math> if <math id="S2.p1.m6" class="ltx_Math" alttext="\mathsf{M}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">\mathsf{M}</annotation></semantics></math> is understood by context.</p>
</div>
<div id="S2.p2" class="ltx_para">
<p id="S2.p2.1" class="ltx_p">We will make consistent use of the following notions. Throughout this paper, we denote by <math id="S2.p2.m1" class="ltx_Math" alttext="\mathcal{L}(\mathsf{M})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}(\mathsf{M})</annotation></semantics></math> the lattice of flats of any matroid. The <em id="S2.p2.1.1" class="ltx_emph ltx_font_italic">characteristic polynomial</em> of a loopless matroid <math id="S2.p2.m2" class="ltx_Math" alttext="\mathsf{M}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">\mathsf{M}</annotation></semantics></math> is the polynomial <math id="S2.p2.m3" class="ltx_Math" alttext="\chi_{\mathsf{M}}(x)\in\mathbb{Z}[x]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>χ</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mi>ℤ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>x</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\chi_{\mathsf{M}}(x)\in\mathbb{Z}[x]</annotation></semantics></math> given by</p>
<table id="S2.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex7.m1" class="ltx_Math" alttext="\chi_{\mathsf{M}}(x):=\sum_{F\in\mathcal{L}(\mathsf{M})}\mu(\varnothing,F)\,x^{\rk(\mathsf{M})-\rk(F)}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>χ</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">:=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>F</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">∅</mi><mo>,</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>x</mi><mrow><mrow><mi>rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\chi_{\mathsf{M}}(x):=\sum_{F\in\mathcal{L}(\mathsf{M})}\mu(\varnothing,F)\,x^{\rk(\mathsf{M})-\rk(F)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.p2.2" class="ltx_p">where the number <math id="S2.p2.m4" class="ltx_Math" alttext="\mu(\varnothing,F)" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">∅</mi><mo>,</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu(\varnothing,F)</annotation></semantics></math> is the value assigned by the Möbius function of <math id="S2.p2.m5" class="ltx_Math" alttext="\mathcal{L}(\mathsf{M})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}(\mathsf{M})</annotation></semantics></math> to the closed interval <math id="S2.p2.m6" class="ltx_Math" alttext="[0,F]\subseteq\mathcal{L}(\mathsf{M})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mi>F</mi></mrow><mo stretchy="false">]</mo></mrow><mo>⊆</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">[0,F]\subseteq\mathcal{L}(\mathsf{M})</annotation></semantics></math> (see <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib15" title="" class="ltx_ref">21</a>, Chapter 3]</cite>). A relevant specialization of the characteristic polynomial is the so-called <em id="S2.p2.2.1" class="ltx_emph ltx_font_italic">Möbius invariant</em> of <math id="S2.p2.m7" class="ltx_Math" alttext="\mathsf{M}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">\mathsf{M}</annotation></semantics></math>, which is in turn defined by</p>
<table id="S2.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex8.m1" class="ltx_Math" alttext="\mu(\mathsf{M}):=\mu(\varnothing,E)=\chi_{\mathsf{M}}(0)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">∅</mi><mo>,</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>χ</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mu(\mathsf{M}):=\mu(\varnothing,E)=\chi_{\mathsf{M}}(0).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<section id="S2.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">2.1. </span>Incidence algebras and kernels</h3>

<div id="S2.SS1.p1" class="ltx_para">
<p id="S2.SS1.p1.1" class="ltx_p">The <em id="S2.SS1.p1.1.1" class="ltx_emph ltx_font_italic">incidence algebra</em> of <math id="S2.SS1.p1.m1" class="ltx_Math" alttext="\mathcal{L}(\mathsf{M})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}(\mathsf{M})</annotation></semantics></math> over a commutative unitary ring <math id="S2.SS1.p1.m2" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>, denoted by <math id="S2.SS1.p1.m3" class="ltx_Math" alttext="\mathcal{I}_{R}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>R</mi></msub><annotation encoding="application/x-tex">\mathcal{I}_{R}</annotation></semantics></math>, is the free <math id="S2.SS1.p1.m4" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>-module spanned by all the closed intervals of <math id="S2.SS1.p1.m5" class="ltx_Math" alttext="\mathcal{L}(\mathsf{M})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}(\mathsf{M})</annotation></semantics></math>. In other words, an element <math id="S2.SS1.p1.m6" class="ltx_Math" alttext="a\in\mathcal{I}_{R}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>R</mi></msub></mrow><annotation encoding="application/x-tex">a\in\mathcal{I}_{R}</annotation></semantics></math> associates to each pair of flats <math id="S2.SS1.p1.m7" class="ltx_Math" alttext="F\subseteq G" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⊆</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">F\subseteq G</annotation></semantics></math> of <math id="S2.SS1.p1.m8" class="ltx_Math" alttext="\mathsf{M}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">\mathsf{M}</annotation></semantics></math> an element <math id="S2.SS1.p1.m9" class="ltx_Math" alttext="a_{FG}\in R" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow></msub><mo>∈</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">a_{FG}\in R</annotation></semantics></math>. The product (also known as convolution) of two elements <math id="S2.SS1.p1.m10" class="ltx_Math" alttext="a,b\in\mathcal{I}_{R}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>R</mi></msub></mrow><annotation encoding="application/x-tex">a,b\in\mathcal{I}_{R}</annotation></semantics></math> is defined via</p>
</div>
<div id="S2.SS1.p2" class="ltx_para">
<table id="S2.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex9.m1" class="ltx_Math" alttext="(ab)_{FG}=\sum_{\begin{subarray}{c}H\in\mathcal{L}(\mathsf{M})\\
F\subseteq H\subseteq G\end{subarray}}a_{FH}\,b_{HG},\qquad\text{ for every $F\subseteq G$ in $\mathcal{L}(\mathsf{M})$}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow></msub><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>H</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mi>F</mi><mo>⊆</mo><mi>H</mi><mo>⊆</mo><mi>G</mi></mrow></mtd></mtr></mtable></munder><mrow><msub><mi>a</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>H</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow></msub></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mtext> for every </mtext><mrow><mi>F</mi><mo>⊆</mo><mi>G</mi></mrow><mtext> in </mtext><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(ab)_{FG}=\sum_{\begin{subarray}{c}H\in\mathcal{L}(\mathsf{M})\\
F\subseteq H\subseteq G\end{subarray}}a_{FH}\,b_{HG},\qquad\text{ for every $F\subseteq G$ in $\mathcal{L}(\mathsf{M})$}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S2.SS1.p3" class="ltx_para">
<p id="S2.SS1.p3.1" class="ltx_p">The algebra <math id="S2.SS1.p3.m1" class="ltx_Math" alttext="\mathcal{I}_{R}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>R</mi></msub><annotation encoding="application/x-tex">\mathcal{I}_{R}</annotation></semantics></math> satisfies the following basic properties:</p>
</div>
<div id="S2.SS1.p4" class="ltx_para">
<ol id="S2.I1" class="ltx_enumerate">
<li id="S2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="S2.I1.i1.p1" class="ltx_para">
<p id="S2.I1.i1.p1.1" class="ltx_p">The product in <math id="S2.I1.i1.p1.m1" class="ltx_Math" alttext="\mathcal{I}_{R}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>R</mi></msub><annotation encoding="application/x-tex">\mathcal{I}_{R}</annotation></semantics></math> is associative.</p>
</div></li>
<li id="S2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="S2.I1.i2.p1" class="ltx_para">
<p id="S2.I1.i2.p1.1" class="ltx_p">There is a multiplicative identity <math id="S2.I1.i2.p1.m1" class="ltx_Math" alttext="\delta\in\mathcal{I}_{R}" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>R</mi></msub></mrow><annotation encoding="application/x-tex">\delta\in\mathcal{I}_{R}</annotation></semantics></math> defined by</p>
<table id="S2.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex10.m1" class="ltx_Math" alttext="\delta_{FG}=\begin{cases}1&amp;\text{ if $F=G$},\\
0&amp;\text{ if $F\neq G$}.\end{cases}" display="block" intent=":literal"><semantics><mrow><msub><mi>δ</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow></msub><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mn>1</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext> if </mtext><mrow><mi>F</mi><mo>=</mo><mi>G</mi></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>0</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext> if </mtext><mrow><mi>F</mi><mo>≠</mo><mi>G</mi></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\delta_{FG}=\begin{cases}1&amp;\text{ if $F=G$},\\
0&amp;\text{ if $F\neq G$}.\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="S2.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(iii)</span> 
<div id="S2.I1.i3.p1" class="ltx_para">
<p id="S2.I1.i3.p1.1" class="ltx_p">An element <math id="S2.I1.i3.p1.m1" class="ltx_Math" alttext="a\in\mathcal{I}_{R}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>R</mi></msub></mrow><annotation encoding="application/x-tex">a\in\mathcal{I}_{R}</annotation></semantics></math> is invertible if and only if <math id="S2.I1.i3.p1.m2" class="ltx_Math" alttext="a_{FF}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow></msub><annotation encoding="application/x-tex">a_{FF}</annotation></semantics></math> is invertible in <math id="S2.I1.i3.p1.m3" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> for every <math id="S2.I1.i3.p1.m4" class="ltx_Math" alttext="F\in\mathcal{L}(\mathsf{M})" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F\in\mathcal{L}(\mathsf{M})</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
<div id="S2.SS1.p5" class="ltx_para">
<p id="S2.SS1.p5.1" class="ltx_p">Let us consider the case in which <math id="S2.SS1.p5.m1" class="ltx_Math" alttext="R=\mathbb{Z}[x,x^{-1}]" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>=</mo><mrow><mi>ℤ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>x</mi><mo>,</mo><msup><mi>x</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">R=\mathbb{Z}[x,x^{-1}]</annotation></semantics></math>, and let us denote <math id="S2.SS1.p5.m2" class="ltx_Math" alttext="\mathcal{I}=\mathcal{I}_{R}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>=</mo><msub><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>R</mi></msub></mrow><annotation encoding="application/x-tex">\mathcal{I}=\mathcal{I}_{R}</annotation></semantics></math>. There is an involution <math id="S2.SS1.p5.m3" class="ltx_Math" alttext="a\mapsto a^{\operatorname{rev}}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo stretchy="false">↦</mo><msup><mi>a</mi><mi>rev</mi></msup></mrow><annotation encoding="application/x-tex">a\mapsto a^{\operatorname{rev}}</annotation></semantics></math> on <math id="S2.SS1.p5.m4" class="ltx_Math" alttext="\mathcal{I}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℐ</mi><annotation encoding="application/x-tex">\mathcal{I}</annotation></semantics></math> defined by</p>
<table id="S2.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex11.m1" class="ltx_Math" alttext="(a^{\operatorname{rev}})_{FG}(x)=x^{\rk_{\mathsf{M}}(G)-\rk_{\mathsf{M}}(F)}\,a_{FG}(x^{-1})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mi>rev</mi></msup><mo stretchy="false">)</mo></mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>x</mi><mrow><mrow><msub><mi>rk</mi><mi>𝖬</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>rk</mi><mi>𝖬</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">(a^{\operatorname{rev}})_{FG}(x)=x^{\rk_{\mathsf{M}}(G)-\rk_{\mathsf{M}}(F)}\,a_{FG}(x^{-1}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS1.p5.2" class="ltx_p">which “reverses” coefficients.</p>
</div>
<div id="S2.SS1.p6" class="ltx_para">
<p id="S2.SS1.p6.1" class="ltx_p">An element <math id="S2.SS1.p6.m1" class="ltx_Math" alttext="\kappa\in\mathcal{I}" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi></mrow><annotation encoding="application/x-tex">\kappa\in\mathcal{I}</annotation></semantics></math> is said to be a <em id="S2.SS1.p6.1.1" class="ltx_emph ltx_font_italic">kernel</em> whenever <math id="S2.SS1.p6.m2" class="ltx_Math" alttext="\kappa^{\operatorname{rev}}=\kappa^{-1}" display="inline" intent=":literal"><semantics><mrow><msup><mi>κ</mi><mi>rev</mi></msup><mo>=</mo><msup><mi>κ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\kappa^{\operatorname{rev}}=\kappa^{-1}</annotation></semantics></math>. It is a well-known fact that the element <math id="S2.SS1.p6.m3" class="ltx_Math" alttext="\chi\in\mathcal{I}" display="inline" intent=":literal"><semantics><mrow><mi>χ</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi></mrow><annotation encoding="application/x-tex">\chi\in\mathcal{I}</annotation></semantics></math> assigning to each closed interval <math id="S2.SS1.p6.m4" class="ltx_Math" alttext="[F,G]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mi>F</mi><mo>,</mo><mi>G</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[F,G]</annotation></semantics></math> the characteristic polynomial of the matroid <math id="S2.SS1.p6.m5" class="ltx_Math" alttext="\mathsf{M}|_{G}/F" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mi>𝖬</mi><mo stretchy="false">|</mo></mrow><mi>G</mi></msub><mo>/</mo><mi>F</mi></mrow><annotation encoding="application/x-tex">\mathsf{M}|_{G}/F</annotation></semantics></math> is a kernel. (See <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib7" title="" class="ltx_ref">20</a>, <a href="#bib.bib4" title="" class="ltx_ref">19</a>, <a href="#bib.bib26" title="" class="ltx_ref">6</a>]</cite> for a thorough discussion of the notion of kernels and for further examples.)</p>
</div>
</section>
<section id="S2.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">2.2. </span>A recapitulation on the Kazhdan–Lusztig invariants</h3>

<div id="S2.SS2.p1" class="ltx_para">
<p id="S2.SS2.p1.1" class="ltx_p">The primary objects of study in the present paper are the four polynomials mentioned in the introduction. For the sake of completeness, we include below two theorems which play the role of definitions for them.</p>
</div>
<div id="S2.Thmtheorem1" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmtheorem1.2" class="ltx_text ltx_font_bold">Theorem 2.1</span></span><span id="S2.Thmtheorem1.3" class="ltx_text ltx_font_bold"> </span>(<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib6" title="" class="ltx_ref">18</a>, <a href="#bib.bib10" title="" class="ltx_ref">3</a>]</cite>)</h6>
<div id="S2.Thmtheorem1.p1" class="ltx_para">
<p id="S2.Thmtheorem1.p1.1" class="ltx_p"><span id="S2.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">There is a unique way to assign to each loopless matroid <math id="S2.Thmtheorem1.p1.m1" class="ltx_Math" alttext="\mathsf{M}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">\mathsf{M}</annotation></semantics></math> polynomials <math id="S2.Thmtheorem1.p1.m2" class="ltx_Math" alttext="P_{\mathsf{M}}(x),Z_{\mathsf{M}}(x)\in\mathbb{Z}[x]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mrow><msub><mi>Z</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mi>ℤ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>x</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">P_{\mathsf{M}}(x),Z_{\mathsf{M}}(x)\in\mathbb{Z}[x]</annotation></semantics></math> such that the following properties hold:</span></p>
<ol id="S2.I2" class="ltx_enumerate">
<li id="S2.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="S2.I2.i1.p1" class="ltx_para">
<p id="S2.I2.i1.p1.1" class="ltx_p"><span id="S2.I2.i1.p1.1.1" class="ltx_text ltx_font_italic">If </span><math id="S2.I2.i1.p1.m1" class="ltx_Math" alttext="\rk(\mathsf{M})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\rk(\mathsf{M})=0</annotation></semantics></math><span id="S2.I2.i1.p1.1.2" class="ltx_text ltx_font_italic">, then </span><math id="S2.I2.i1.p1.m2" class="ltx_Math" alttext="P_{\mathsf{M}}(x)=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">P_{\mathsf{M}}(x)=1</annotation></semantics></math><span id="S2.I2.i1.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S2.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="S2.I2.i2.p1" class="ltx_para">
<p id="S2.I2.i2.p1.1" class="ltx_p"><span id="S2.I2.i2.p1.1.1" class="ltx_text ltx_font_italic">If </span><math id="S2.I2.i2.p1.m1" class="ltx_Math" alttext="\rk(\mathsf{M})&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\rk(\mathsf{M})&gt;0</annotation></semantics></math><span id="S2.I2.i2.p1.1.2" class="ltx_text ltx_font_italic">, then </span><math id="S2.I2.i2.p1.m2" class="ltx_Math" alttext="\deg P_{\mathsf{M}}(x)&lt;\frac{1}{2}\rk(\mathsf{M})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>deg</mi><mo lspace="0.167em">⁡</mo><msub><mi>P</mi><mi>𝖬</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\deg P_{\mathsf{M}}(x)&lt;\frac{1}{2}\rk(\mathsf{M})</annotation></semantics></math><span id="S2.I2.i2.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S2.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(iii)</span> 
<div id="S2.I2.i3.p1" class="ltx_para">
<p id="S2.I2.i3.p1.1" class="ltx_p"><span id="S2.I2.i3.p1.1.1" class="ltx_text ltx_font_italic">For every matroid </span><math id="S2.I2.i3.p1.m1" class="ltx_Math" alttext="\mathsf{M}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">\mathsf{M}</annotation></semantics></math><span id="S2.I2.i3.p1.1.2" class="ltx_text ltx_font_italic">, the polynomial</span></p>
<table id="S2.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex12.m1" class="ltx_Math" alttext="Z_{\mathsf{M}}(x):=\sum_{F\in\mathcal{L}(\mathsf{M})}x^{\rk(F)}\,P_{\mathsf{M}/F}(x)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>Z</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">:=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>F</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><msup><mi>x</mi><mrow><mi>rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mi>𝖬</mi><mo>/</mo><mi>F</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">Z_{\mathsf{M}}(x):=\sum_{F\in\mathcal{L}(\mathsf{M})}x^{\rk(F)}\,P_{\mathsf{M}/F}(x)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.I2.i3.p1.2" class="ltx_p"><span id="S2.I2.i3.p1.2.1" class="ltx_text ltx_font_italic">is palindromic.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S2.SS2.p2" class="ltx_para">
<p id="S2.SS2.p2.1" class="ltx_p">The polynomial <math id="S2.SS2.p2.m1" class="ltx_Math" alttext="P_{\mathsf{M}}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P_{\mathsf{M}}(x)</annotation></semantics></math> is called the <em id="S2.SS2.p2.1.1" class="ltx_emph ltx_font_italic">Kazhdan–Lusztig polynomial</em> of <math id="S2.SS2.p2.m2" class="ltx_Math" alttext="\mathsf{M}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">\mathsf{M}</annotation></semantics></math>, and was first introduced by Elias, Proudfoot, and Wakefield in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib5" title="" class="ltx_ref">4</a>]</cite>. The polynomial <math id="S2.SS2.p2.m3" class="ltx_Math" alttext="Z_{\mathsf{M}}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Z_{\mathsf{M}}(x)</annotation></semantics></math> is called the <em id="S2.SS2.p2.1.2" class="ltx_emph ltx_font_italic"><math id="S2.SS2.p2.m4" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math>-polynomial</em> of <math id="S2.SS2.p2.m5" class="ltx_Math" alttext="\mathsf{M}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">\mathsf{M}</annotation></semantics></math> and was considered first in the work of Proudfoot, Xu, and Young <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib6" title="" class="ltx_ref">18</a>]</cite>.</p>
</div>
<div id="S2.Thmtheorem2" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmtheorem2.2" class="ltx_text ltx_font_bold">Theorem 2.2</span></span><span id="S2.Thmtheorem2.3" class="ltx_text ltx_font_bold"> </span>(<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib13" title="" class="ltx_ref">2</a>, <a href="#bib.bib2" title="" class="ltx_ref">5</a>, <a href="#bib.bib25" title="" class="ltx_ref">11</a>]</cite>)</h6>
<div id="S2.Thmtheorem2.p1" class="ltx_para">
<p id="S2.Thmtheorem2.p1.1" class="ltx_p"><span id="S2.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">There is a unique way to assign to each loopless matroid <math id="S2.Thmtheorem2.p1.m1" class="ltx_Math" alttext="\mathsf{M}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">\mathsf{M}</annotation></semantics></math> polynomials <math id="S2.Thmtheorem2.p1.m2" class="ltx_Math" alttext="Q_{\mathsf{M}}(x),Y_{\mathsf{M}}(x)\in\mathbb{Z}[x]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>Q</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mrow><msub><mi>Y</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mi>ℤ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>x</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">Q_{\mathsf{M}}(x),Y_{\mathsf{M}}(x)\in\mathbb{Z}[x]</annotation></semantics></math> such that the following properties hold:</span></p>
<ol id="S2.I3" class="ltx_enumerate">
<li id="S2.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="S2.I3.i1.p1" class="ltx_para">
<p id="S2.I3.i1.p1.1" class="ltx_p"><span id="S2.I3.i1.p1.1.1" class="ltx_text ltx_font_italic">If </span><math id="S2.I3.i1.p1.m1" class="ltx_Math" alttext="\rk(\mathsf{M})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\rk(\mathsf{M})=0</annotation></semantics></math><span id="S2.I3.i1.p1.1.2" class="ltx_text ltx_font_italic">, then </span><math id="S2.I3.i1.p1.m2" class="ltx_Math" alttext="Q_{\mathsf{M}}(x)=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>Q</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">Q_{\mathsf{M}}(x)=1</annotation></semantics></math><span id="S2.I3.i1.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S2.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="S2.I3.i2.p1" class="ltx_para">
<p id="S2.I3.i2.p1.1" class="ltx_p"><span id="S2.I3.i2.p1.1.1" class="ltx_text ltx_font_italic">If </span><math id="S2.I3.i2.p1.m1" class="ltx_Math" alttext="\rk(\mathsf{M})&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\rk(\mathsf{M})&gt;0</annotation></semantics></math><span id="S2.I3.i2.p1.1.2" class="ltx_text ltx_font_italic">, then </span><math id="S2.I3.i2.p1.m2" class="ltx_Math" alttext="\deg Q_{\mathsf{M}}(x)&lt;\frac{1}{2}\rk(\mathsf{M})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>deg</mi><mo lspace="0.167em">⁡</mo><msub><mi>Q</mi><mi>𝖬</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\deg Q_{\mathsf{M}}(x)&lt;\frac{1}{2}\rk(\mathsf{M})</annotation></semantics></math><span id="S2.I3.i2.p1.1.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S2.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(iii)</span> 
<div id="S2.I3.i3.p1" class="ltx_para">
<p id="S2.I3.i3.p1.1" class="ltx_p"><span id="S2.I3.i3.p1.1.1" class="ltx_text ltx_font_italic">For every matroid </span><math id="S2.I3.i3.p1.m1" class="ltx_Math" alttext="\mathsf{M}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">\mathsf{M}</annotation></semantics></math><span id="S2.I3.i3.p1.1.2" class="ltx_text ltx_font_italic">, the polynomial</span></p>
<table id="S2.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex13.m1" class="ltx_Math" alttext="Y_{\mathsf{M}}(x):=\sum_{F\in\mathcal{L}(\mathsf{M})}(-1)^{\rk(\mathsf{M})-\rk(F)}\mu(\mathsf{M}/F)\,x^{\rk(\mathsf{M})-\rk(F)}\,Q_{\mathsf{M}|_{F}}(x)" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>Y</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">:=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>F</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mi>rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝖬</mi><mo>/</mo><mi>F</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>x</mi><mrow><mrow><mi>rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>Q</mi><msub><mrow><mi>𝖬</mi><mo stretchy="false">|</mo></mrow><mi>F</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">Y_{\mathsf{M}}(x):=\sum_{F\in\mathcal{L}(\mathsf{M})}(-1)^{\rk(\mathsf{M})-\rk(F)}\mu(\mathsf{M}/F)\,x^{\rk(\mathsf{M})-\rk(F)}\,Q_{\mathsf{M}|_{F}}(x)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.I3.i3.p1.2" class="ltx_p"><span id="S2.I3.i3.p1.2.1" class="ltx_text ltx_font_italic">is palindromic.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S2.SS2.p3" class="ltx_para">
<p id="S2.SS2.p3.1" class="ltx_p">The polynomial <math id="S2.SS2.p3.m1" class="ltx_Math" alttext="Q_{\mathsf{M}}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Q_{\mathsf{M}}(x)</annotation></semantics></math> is called the <em id="S2.SS2.p3.1.1" class="ltx_emph ltx_font_italic">inverse Kazhdan–Lusztig polynomial</em> of <math id="S2.SS2.p3.m2" class="ltx_Math" alttext="\mathsf{M}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">\mathsf{M}</annotation></semantics></math>, and was first considered by Gao and Xie in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib18" title="" class="ltx_ref">12</a>]</cite>. The polynomial <math id="S2.SS2.p3.m3" class="ltx_Math" alttext="Y_{\mathsf{M}}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Y_{\mathsf{M}}(x)</annotation></semantics></math> is called the <em id="S2.SS2.p3.1.2" class="ltx_emph ltx_font_italic">inverse <math id="S2.SS2.p3.m4" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math>-polynomial</em> of <math id="S2.SS2.p3.m5" class="ltx_Math" alttext="\mathsf{M}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">\mathsf{M}</annotation></semantics></math>. It was first mentioned in the work of Ferroni, Matherne, Stevens, and Vecchi <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib2" title="" class="ltx_ref">5</a>]</cite>, and it was later addressed in more detail in the recent work by Gao, Ruan, and Xie <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib25" title="" class="ltx_ref">11</a>]</cite>.</p>
</div>
<div id="S2.SS2.p4" class="ltx_para">
<p id="S2.SS2.p4.1" class="ltx_p">The reason these polynomials carry the word “inverse” in their name is because they can be defined from the Kazhdan–Lusztig and <math id="S2.SS2.p4.m1" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math>-polynomials by working in the incidence algebra of <math id="S2.SS2.p4.m2" class="ltx_Math" alttext="\mathcal{L}(\mathsf{M})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}(\mathsf{M})</annotation></semantics></math> over <math id="S2.SS2.p4.m3" class="ltx_Math" alttext="R=\mathbb{Z}[x,x^{-1}]" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>=</mo><mrow><mi>ℤ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>x</mi><mo>,</mo><msup><mi>x</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">R=\mathbb{Z}[x,x^{-1}]</annotation></semantics></math>. Defining <math id="S2.SS2.p4.m4" class="ltx_Math" alttext="P\in\mathcal{I}" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi></mrow><annotation encoding="application/x-tex">P\in\mathcal{I}</annotation></semantics></math> as the element associating to each interval <math id="S2.SS2.p4.m5" class="ltx_Math" alttext="[F,G]\subseteq\mathcal{L}(\mathsf{M})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mrow><mi>F</mi><mo>,</mo><mi>G</mi></mrow><mo stretchy="false">]</mo></mrow><mo>⊆</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">[F,G]\subseteq\mathcal{L}(\mathsf{M})</annotation></semantics></math> the polynomial</p>
<table id="S2.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex14.m1" class="ltx_Math" alttext="P_{FG}(x)=P_{\mathsf{M}|_{G}/F}(x)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>P</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>P</mi><mrow><msub><mrow><mi>𝖬</mi><mo stretchy="false">|</mo></mrow><mi>G</mi></msub><mo>/</mo><mi>F</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">P_{FG}(x)=P_{\mathsf{M}|_{G}/F}(x),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS2.p4.2" class="ltx_p">and defining <math id="S2.SS2.p4.m6" class="ltx_Math" alttext="Q,Z,Y\in\mathcal{I}" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo>,</mo><mi>Z</mi><mo>,</mo><mrow><mi>Y</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi></mrow></mrow><annotation encoding="application/x-tex">Q,Z,Y\in\mathcal{I}</annotation></semantics></math> analogously, the following relationships hold:</p>
<table id="S2.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S2.Ex15.m1" class="ltx_Math" alttext="P^{-1}=\widehat{Q}\qquad\text{ and }\qquad Z^{-1}=\widehat{Y}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>P</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>=</mo><mover accent="true"><mi>Q</mi><mo>^</mo></mover></mrow><mspace style="width:2em;" width="2em"></mspace><mtext> and </mtext><mspace style="width:2em;" width="2em"></mspace><mrow><msup><mi>Z</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>=</mo><mover accent="true"><mi>Y</mi><mo>^</mo></mover></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">P^{-1}=\widehat{Q}\qquad\text{ and }\qquad Z^{-1}=\widehat{Y},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S2.SS2.p4.3" class="ltx_p">where <math id="S2.SS2.p4.m7" class="ltx_Math" alttext="\widehat{Q}_{\mathsf{M}}(x)=(-1)^{\rk(\mathsf{M})}Q_{\mathsf{M}}(x)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>Q</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\widehat{Q}_{\mathsf{M}}(x)=(-1)^{\rk(\mathsf{M})}Q_{\mathsf{M}}(x)</annotation></semantics></math> and <math id="S2.SS2.p4.m8" class="ltx_Math" alttext="\widehat{Y}_{\mathsf{M}}(x)=(-1)^{\rk(\mathsf{M})}\,Y_{\mathsf{M}}(x)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>Y</mi><mo>^</mo></mover><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>Y</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\widehat{Y}_{\mathsf{M}}(x)=(-1)^{\rk(\mathsf{M})}\,Y_{\mathsf{M}}(x)</annotation></semantics></math>. Put more succinctly, the element <math id="S2.SS2.p4.m9" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> (resp <math id="S2.SS2.p4.m10" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>) is, up to a sign, the inverse of <math id="S2.SS2.p4.m11" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> (resp. <math id="S2.SS2.p4.m12" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math>) in the incidence algebra of <math id="S2.SS2.p4.m13" class="ltx_Math" alttext="\mathcal{L}(\mathsf{M})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}(\mathsf{M})</annotation></semantics></math>.</p>
</div>
</section>
</section>
<section id="S3" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">3. </span>Proof of the deletion formulas</h2>

<section id="S3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.1. </span>The Kazhdan–Lusztig basis</h3>

<div id="S3.SS1.p1" class="ltx_para">
<p id="S3.SS1.p1.1" class="ltx_p">Let <math id="S3.SS1.p1.m1" class="ltx_Math" alttext="\mathsf{M}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">\mathsf{M}</annotation></semantics></math> be a matroid and <math id="S3.SS1.p1.m2" class="ltx_Math" alttext="\mathcal{L}(\mathsf{M})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}(\mathsf{M})</annotation></semantics></math> be its lattice of flats. Following <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib10" title="" class="ltx_ref">3</a>]</cite>, we define the free <math id="S3.SS1.p1.m3" class="ltx_Math" alttext="\mathbb{Z}[x,x^{-1}]" display="inline" intent=":literal"><semantics><mrow><mi>ℤ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>x</mi><mo>,</mo><msup><mi>x</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{Z}[x,x^{-1}]</annotation></semantics></math>-module <math id="S3.SS1.p1.m4" class="ltx_Math" alttext="\mathcal{H}(\mathsf{M})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{H}(\mathsf{M})</annotation></semantics></math> generated by the elements <math id="S3.SS1.p1.m5" class="ltx_Math" alttext="\Gamma_{\mathsf{M}}^{F}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Γ</mi><mi>𝖬</mi><mi>F</mi></msubsup><annotation encoding="application/x-tex">\Gamma_{\mathsf{M}}^{F}</annotation></semantics></math>, one for each flat <math id="S3.SS1.p1.m6" class="ltx_Math" alttext="F\in\mathcal{L}(\mathsf{M})" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F\in\mathcal{L}(\mathsf{M})</annotation></semantics></math>.
Elements of <math id="S3.SS1.p1.m7" class="ltx_Math" alttext="\mathcal{H}(\mathsf{M})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{H}(\mathsf{M})</annotation></semantics></math> are formal sums of the form</p>
<table id="S3.E3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(3)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E3.m1" class="ltx_Math" alttext="\upalpha=\sum_{F\in\mathcal{L}(\mathsf{M})}\upalpha_{F}(x)\cdot\Gamma_{\mathsf{M}}^{F},\quad\upalpha_{F}\in\mathbb{Z}[x,x^{-1}]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mtext class="undefined">\upalpha</mtext><mo rspace="0.111em">=</mo><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>F</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><msub><mtext class="undefined">\upalpha</mtext><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi mathvariant="normal">Γ</mi><mi>𝖬</mi><mi>F</mi></msubsup></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mtext class="undefined">\upalpha</mtext><mi>F</mi></msub><mo>∈</mo><mrow><mi>ℤ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>x</mi><mo>,</mo><msup><mi>x</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\upalpha=\sum_{F\in\mathcal{L}(\mathsf{M})}\upalpha_{F}(x)\cdot\Gamma_{\mathsf{M}}^{F},\quad\upalpha_{F}\in\mathbb{Z}[x,x^{-1}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p1.2" class="ltx_p">In general, an element in the module <math id="S3.SS1.p1.m8" class="ltx_Math" alttext="\mathcal{H}(\mathsf{M})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{H}(\mathsf{M})</annotation></semantics></math> will be identified by the presence of a subindex<span id="footnote2" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">2</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">2</sup>
              <span class="ltx_tag ltx_tag_note">2</span>
              
              
              
              
              
              
              
            In <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib10" title="" class="ltx_ref">3</a>]</cite>, the element <math id="footnote2.m1" class="ltx_Math" alttext="\Gamma_{\mathsf{M}}^{F}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Γ</mi><mi>𝖬</mi><mi>F</mi></msubsup><annotation encoding="application/x-tex">\Gamma_{\mathsf{M}}^{F}</annotation></semantics></math> is denoted by <math id="footnote2.m2" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>. Our change of notation, carrying <math id="footnote2.m3" class="ltx_Math" alttext="\mathsf{M}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">\mathsf{M}</annotation></semantics></math> as a subindex, bypasses any potential confusion when the same set <math id="footnote2.m4" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> is a flat of two different matroids.</span></span></span> <math id="S3.SS1.p1.m9" class="ltx_Math" alttext="\mathsf{M}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">\mathsf{M}</annotation></semantics></math>. The basis <math id="S3.SS1.p1.m10" class="ltx_Math" alttext="\left\{\Gamma^{F}_{\mathsf{M}}\right\}_{F\in\mathcal{L}(\mathsf{M})}" display="inline" intent=":literal"><semantics><msub><mrow><mo>{</mo><msubsup><mi mathvariant="normal">Γ</mi><mi>𝖬</mi><mi>F</mi></msubsup><mo>}</mo></mrow><mrow><mi>F</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><annotation encoding="application/x-tex">\left\{\Gamma^{F}_{\mathsf{M}}\right\}_{F\in\mathcal{L}(\mathsf{M})}</annotation></semantics></math> will often be referred to as the standard basis of <math id="S3.SS1.p1.m11" class="ltx_Math" alttext="\mathcal{H}(\mathsf{M})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{H}(\mathsf{M})</annotation></semantics></math>, but several other bases will be used throughout our proofs.</p>
</div>
<div id="S3.SS1.p2" class="ltx_para">
<p id="S3.SS1.p2.1" class="ltx_p">There is an involution in <math id="S3.SS1.p2.m1" class="ltx_Math" alttext="\mathcal{H}(\mathsf{M})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{H}(\mathsf{M})</annotation></semantics></math>, denoted <math id="S3.SS1.p2.m2" class="ltx_Math" alttext="\upalpha\mapsto\overline{\upalpha}" display="inline" intent=":literal"><semantics><mrow><mtext class="undefined">\upalpha</mtext><mo stretchy="false">↦</mo><mover accent="true"><mtext class="undefined">\upalpha</mtext><mo stretchy="true">¯</mo></mover></mrow><annotation encoding="application/x-tex">\upalpha\mapsto\overline{\upalpha}</annotation></semantics></math>, and defined for any element <math id="S3.SS1.p2.m3" class="ltx_Math" alttext="\upalpha" display="inline" intent=":literal"><semantics><mtext class="undefined">\upalpha</mtext><annotation encoding="application/x-tex">\upalpha</annotation></semantics></math> as in equation (<a href="#S3.E3" title="Equation 3 ‣ 3.1. The Kazhdan–Lusztig basis ‣ 3. Proof of the deletion formulas ‣ Inverse Kazhdan–Lusztig polynomialsof matroids under deletion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>) by</p>
<table id="S3.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex16.m1" class="ltx_Math" alttext="\overline{\upalpha}:=\sum_{F\in\mathcal{L}(\mathsf{M})}\upalpha_{F}(x^{-1})\,\overline{\Gamma^{F}_{\mathsf{M}}}," display="block" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mtext class="undefined">\upalpha</mtext><mo stretchy="true">¯</mo></mover><mo rspace="0.111em">:=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>F</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><msub><mtext class="undefined">\upalpha</mtext><mi>F</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mover accent="true"><msubsup><mi mathvariant="normal">Γ</mi><mi>𝖬</mi><mi>F</mi></msubsup><mo stretchy="true">¯</mo></mover></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\overline{\upalpha}:=\sum_{F\in\mathcal{L}(\mathsf{M})}\upalpha_{F}(x^{-1})\,\overline{\Gamma^{F}_{\mathsf{M}}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p2.2" class="ltx_p">where <math id="S3.SS1.p2.m4" class="ltx_Math" alttext="\overline{\Gamma^{F}_{\mathsf{M}}}" display="inline" intent=":literal"><semantics><mover accent="true"><msubsup><mi mathvariant="normal">Γ</mi><mi>𝖬</mi><mi>F</mi></msubsup><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{\Gamma^{F}_{\mathsf{M}}}</annotation></semantics></math> is defined by</p>
<table id="S3.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex17.m1" class="ltx_Math" alttext="\overline{\Gamma^{F}_{\mathsf{M}}}:=\sum_{\begin{subarray}{c}G\in\mathcal{L}(\mathsf{M})\\
G\subseteq F\end{subarray}}x^{2(\rk(G)-\rk(F))}\,\chi_{\mathsf{M}|_{F}/G}(x^{2})\cdot\Gamma^{G}_{\mathsf{M}}." display="block" intent=":literal"><semantics><mrow><mrow><mover accent="true"><msubsup><mi mathvariant="normal">Γ</mi><mi>𝖬</mi><mi>F</mi></msubsup><mo stretchy="true">¯</mo></mover><mo rspace="0.111em">:=</mo><mrow><mrow><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>G</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mi>G</mi><mo>⊆</mo><mi>F</mi></mrow></mtd></mtr></mtable></munder><mrow><msup><mi>x</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>χ</mi><mrow><msub><mrow><mi>𝖬</mi><mo stretchy="false">|</mo></mrow><mi>F</mi></msub><mo>/</mo><mi>G</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mn>2</mn></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi mathvariant="normal">Γ</mi><mi>𝖬</mi><mi>G</mi></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\overline{\Gamma^{F}_{\mathsf{M}}}:=\sum_{\begin{subarray}{c}G\in\mathcal{L}(\mathsf{M})\\
G\subseteq F\end{subarray}}x^{2(\rk(G)-\rk(F))}\,\chi_{\mathsf{M}|_{F}/G}(x^{2})\cdot\Gamma^{G}_{\mathsf{M}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p2.3" class="ltx_p">The assertion <math id="S3.SS1.p2.m5" class="ltx_Math" alttext="\overline{\overline{\Gamma^{F}_{\mathsf{M}}}}=\Gamma^{F}_{\mathsf{M}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mover accent="true"><msubsup><mi mathvariant="normal">Γ</mi><mi>𝖬</mi><mi>F</mi></msubsup><mo stretchy="true">¯</mo></mover><mo stretchy="true">¯</mo></mover><mo>=</mo><msubsup><mi mathvariant="normal">Γ</mi><mi>𝖬</mi><mi>F</mi></msubsup></mrow><annotation encoding="application/x-tex">\overline{\overline{\Gamma^{F}_{\mathsf{M}}}}=\Gamma^{F}_{\mathsf{M}}</annotation></semantics></math> (and therefore that <math id="S3.SS1.p2.m6" class="ltx_Math" alttext="\upalpha" display="inline" intent=":literal"><semantics><mtext class="undefined">\upalpha</mtext><annotation encoding="application/x-tex">\upalpha</annotation></semantics></math> is indeed an involution) is formally equivalent to the fact that the characteristic polynomial is a kernel in the incidence algebra of <math id="S3.SS1.p2.m7" class="ltx_Math" alttext="\mathcal{L}(\mathsf{M})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}(\mathsf{M})</annotation></semantics></math>. Notice that, in each summand of the above display the first two factors correspond to <math id="S3.SS1.p2.m8" class="ltx_Math" alttext="\chi^{\operatorname{rev}}_{FG}(x^{-2})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>χ</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mi>rev</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\chi^{\operatorname{rev}}_{FG}(x^{-2})</annotation></semantics></math>.</p>
</div>
<div id="S3.SS1.p3" class="ltx_para">
<p id="S3.SS1.p3.1" class="ltx_p">There is a special <math id="S3.SS1.p3.m1" class="ltx_Math" alttext="\mathbb{Z}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">\mathbb{Z}</annotation></semantics></math>-submodule <math id="S3.SS1.p3.m2" class="ltx_Math" alttext="\mathcal{H}_{p}(\mathsf{M})\subseteq\mathcal{H}(\mathsf{M})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><mo>⊆</mo><mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{H}_{p}(\mathsf{M})\subseteq\mathcal{H}(\mathsf{M})</annotation></semantics></math> which consists of all the elements fixed by the above involution. The following was proved by Braden and Vysogorets in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib10" title="" class="ltx_ref">3</a>, Proposition 2.13]</cite>.</p>
</div>
<div id="S3.Thmtheorem1" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem1.2" class="ltx_text ltx_font_bold">Proposition 3.1</span></span></h6>
<div id="S3.Thmtheorem1.p1" class="ltx_para">
<p id="S3.Thmtheorem1.p1.1" class="ltx_p"><span id="S3.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">There exists a <math id="S3.Thmtheorem1.p1.m1" class="ltx_Math" alttext="\mathbb{Z}" display="inline" intent=":literal"><semantics><mi>ℤ</mi><annotation encoding="application/x-tex">\mathbb{Z}</annotation></semantics></math>-basis (called the Kazhdan–Lusztig basis) of <math id="S3.Thmtheorem1.p1.m2" class="ltx_Math" alttext="\mathcal{H}_{p}(\mathsf{M})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{H}_{p}(\mathsf{M})</annotation></semantics></math> given by the collection <math id="S3.Thmtheorem1.p1.m3" class="ltx_Math" alttext="\left\{\upzeta_{\mathsf{M}}^{F}:F\in\mathcal{L}(\mathsf{M})\right\}" display="inline" intent=":literal"><semantics><mrow><mo>{</mo><msubsup><mtext class="undefined">\upzeta</mtext><mi>𝖬</mi><mi>F</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>F</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow><annotation encoding="application/x-tex">\left\{\upzeta_{\mathsf{M}}^{F}:F\in\mathcal{L}(\mathsf{M})\right\}</annotation></semantics></math>, where</span></p>
<table id="S3.E4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(4)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E4.m1" class="ltx_Math" alttext="\upzeta_{\mathsf{M}}^{F}:=\sum_{\begin{subarray}{c}G\in\mathcal{L}(\mathsf{M})\\
G\subseteq F\end{subarray}}x^{\rk(F)-\rk(G)}P_{\mathsf{M}|_{F}/G}(x^{-2})\cdot\Gamma^{G}_{\mathsf{M}}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mtext class="undefined">\upzeta</mtext><mi>𝖬</mi><mi>F</mi></msubsup><mo rspace="0.111em">:=</mo><mrow><mrow><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>G</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mi>G</mi><mo>⊆</mo><mi>F</mi></mrow></mtd></mtr></mtable></munder><mrow><msup><mi>x</mi><mrow><mrow><mi>rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><msub><mrow><mi>𝖬</mi><mo stretchy="false">|</mo></mrow><mi>F</mi></msub><mo>/</mo><mi>G</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi mathvariant="normal">Γ</mi><mi>𝖬</mi><mi>G</mi></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\upzeta_{\mathsf{M}}^{F}:=\sum_{\begin{subarray}{c}G\in\mathcal{L}(\mathsf{M})\\
G\subseteq F\end{subarray}}x^{\rk(F)-\rk(G)}P_{\mathsf{M}|_{F}/G}(x^{-2})\cdot\Gamma^{G}_{\mathsf{M}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S3.SS1.p4" class="ltx_para">
<p id="S3.SS1.p4.1" class="ltx_p">It is a straightforward fact that the collection <math id="S3.SS1.p4.m1" class="ltx_Math" alttext="\{\upzeta^{F}_{\mathsf{M}}\}_{F\in\mathcal{L}(\mathsf{M})}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msubsup><mtext class="undefined">\upzeta</mtext><mi>𝖬</mi><mi>F</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>F</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><annotation encoding="application/x-tex">\{\upzeta^{F}_{\mathsf{M}}\}_{F\in\mathcal{L}(\mathsf{M})}</annotation></semantics></math> forms a <math id="S3.SS1.p4.m2" class="ltx_Math" alttext="\mathbb{Z}[x,x^{-1}]" display="inline" intent=":literal"><semantics><mrow><mi>ℤ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>x</mi><mo>,</mo><msup><mi>x</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{Z}[x,x^{-1}]</annotation></semantics></math>-basis of the free module <math id="S3.SS1.p4.m3" class="ltx_Math" alttext="\mathcal{H}(\mathsf{M})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{H}(\mathsf{M})</annotation></semantics></math>. The fact that the elements are in <math id="S3.SS1.p4.m4" class="ltx_Math" alttext="\mathcal{H}_{p}(\mathsf{M})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{H}_{p}(\mathsf{M})</annotation></semantics></math> is equivalent to property (iii) of Theorem <a href="#S2.Thmtheorem1" title="Theorem 2.1 ([]) ‣ 2.2. A recapitulation on the Kazhdan–Lusztig invariants ‣ 2. Preliminaries ‣ Inverse Kazhdan–Lusztig polynomialsof matroids under deletion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.1</span></a>. The next lemma expresses the standard basis <math id="S3.SS1.p4.m5" class="ltx_Math" alttext="\left\{\Gamma^{F}_{\mathsf{M}}\right\}_{F\in\mathcal{L}(\mathsf{M})}" display="inline" intent=":literal"><semantics><msub><mrow><mo>{</mo><msubsup><mi mathvariant="normal">Γ</mi><mi>𝖬</mi><mi>F</mi></msubsup><mo>}</mo></mrow><mrow><mi>F</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><annotation encoding="application/x-tex">\left\{\Gamma^{F}_{\mathsf{M}}\right\}_{F\in\mathcal{L}(\mathsf{M})}</annotation></semantics></math> of <math id="S3.SS1.p4.m6" class="ltx_Math" alttext="\mathcal{H}(\mathsf{M})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{H}(\mathsf{M})</annotation></semantics></math> in terms of the Kazhdan–Lusztig basis. In order to state this change of basis explicitly, we make use of the following notation:</p>
</div>
<div id="S3.SS1.p5" class="ltx_para">
<table id="S3.E5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(5)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E5.m1" class="ltx_Math" alttext="\widehat{Q}_{\mathsf{M}}(x):=(-1)^{\rk(\mathsf{M})}Q_{\mathsf{M}}(x)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>Q</mi><mi>𝖬</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widehat{Q}_{\mathsf{M}}(x):=(-1)^{\rk(\mathsf{M})}Q_{\mathsf{M}}(x).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.Thmtheorem2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem2.2" class="ltx_text ltx_font_bold">Lemma 3.2</span></span></h6>
<div id="S3.Thmtheorem2.p1" class="ltx_para">
<p id="S3.Thmtheorem2.p1.1" class="ltx_p"><span id="S3.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">For every flat <math id="S3.Thmtheorem2.p1.m1" class="ltx_Math" alttext="F\in\mathcal{L}(\mathsf{M})" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F\in\mathcal{L}(\mathsf{M})</annotation></semantics></math>, the following equality holds in <math id="S3.Thmtheorem2.p1.m2" class="ltx_Math" alttext="\mathcal{H}(\mathsf{M})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{H}(\mathsf{M})</annotation></semantics></math>:</span></p>
<table id="S3.E6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(6)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E6.m1" class="ltx_Math" alttext="\Gamma^{F}_{\mathsf{M}}=\sum_{\begin{subarray}{c}G\in\mathcal{L}(\mathsf{M})\\
G\subseteq F\end{subarray}}x^{\rk(F)-\rk(G)}\widehat{Q}_{\mathsf{M}|_{F}/G}(x^{-2})\cdot\upzeta^{G}_{\mathsf{M}}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi mathvariant="normal">Γ</mi><mi>𝖬</mi><mi>F</mi></msubsup><mo rspace="0.111em">=</mo><mrow><mrow><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>G</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mi>G</mi><mo>⊆</mo><mi>F</mi></mrow></mtd></mtr></mtable></munder><mrow><msup><mi>x</mi><mrow><mrow><mi>rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>rk</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mrow><msub><mrow><mi>𝖬</mi><mo stretchy="false">|</mo></mrow><mi>F</mi></msub><mo>/</mo><mi>G</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><msubsup><mtext class="undefined">\upzeta</mtext><mi>𝖬</mi><mi>G</mi></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Gamma^{F}_{\mathsf{M}}=\sum_{\begin{subarray}{c}G\in\mathcal{L}(\mathsf{M})\\
G\subseteq F\end{subarray}}x^{\rk(F)-\rk(G)}\widehat{Q}_{\mathsf{M}|_{F}/G}(x^{-2})\cdot\upzeta^{G}_{\mathsf{M}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S3.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS1.p6" class="ltx_para">
<p id="S3.SS1.p6.1" class="ltx_p"><span id="S3.SS1.p6.1.1" class="ltx_text">Since <math id="S3.SS1.p6.m1" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> and <math id="S3.SS1.p6.m2" class="ltx_Math" alttext="\widehat{Q}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>Q</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\widehat{Q}</annotation></semantics></math> are inverses in <math id="S3.SS1.p6.m3" class="ltx_Math" alttext="\mathcal{I}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℐ</mi><annotation encoding="application/x-tex">\mathcal{I}</annotation></semantics></math>, we have</span></p>
<table id="S3.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex18.m1" class="ltx_Math" alttext="\sum_{\begin{subarray}{c}G,H\in\mathcal{L}(\mathsf{M})\\
H\subseteq G\subseteq F\end{subarray}}{P_{\mathsf{M}|_{F}/G}(x)\cdot\widehat{Q}_{\mathsf{M}|_{G}/H}(x)}=\sum_{\begin{subarray}{c}G,H\in\mathcal{L}(\mathsf{M})\\
H\subseteq G\subseteq F\end{subarray}}{\widehat{Q}_{\mathsf{M}|_{F}/G}(x)\cdot P_{\mathsf{M}|_{G}/H}(x)}=\delta_{FH}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mrow><mi>G</mi><mo>,</mo><mi>H</mi></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mi>H</mi><mo>⊆</mo><mi>G</mi><mo>⊆</mo><mi>F</mi></mrow></mtd></mtr></mtable></munder><mrow><msub><mi>P</mi><mrow><msub><mrow><mi>𝖬</mi><mo stretchy="false">|</mo></mrow><mi>F</mi></msub><mo>/</mo><mi>G</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mrow><msub><mrow><mi>𝖬</mi><mo stretchy="false">|</mo></mrow><mi>G</mi></msub><mo>/</mo><mi>H</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><mrow><munder><mo movablelimits="false">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mrow><mi>G</mi><mo>,</mo><mi>H</mi></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mi>H</mi><mo>⊆</mo><mi>G</mi><mo>⊆</mo><mi>F</mi></mrow></mtd></mtr></mtable></munder><mrow><msub><mover accent="true"><mi>Q</mi><mo>^</mo></mover><mrow><msub><mrow><mi>𝖬</mi><mo stretchy="false">|</mo></mrow><mi>F</mi></msub><mo>/</mo><mi>G</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi>P</mi><mrow><msub><mrow><mi>𝖬</mi><mo stretchy="false">|</mo></mrow><mi>G</mi></msub><mo>/</mo><mi>H</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>δ</mi><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>H</mi></mrow></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\sum_{\begin{subarray}{c}G,H\in\mathcal{L}(\mathsf{M})\\
H\subseteq G\subseteq F\end{subarray}}{P_{\mathsf{M}|_{F}/G}(x)\cdot\widehat{Q}_{\mathsf{M}|_{G}/H}(x)}=\sum_{\begin{subarray}{c}G,H\in\mathcal{L}(\mathsf{M})\\
H\subseteq G\subseteq F\end{subarray}}{\widehat{Q}_{\mathsf{M}|_{F}/G}(x)\cdot P_{\mathsf{M}|_{G}/H}(x)}=\delta_{FH},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p6.2" class="ltx_p"><span id="S3.SS1.p6.2.1" class="ltx_text">which is <math id="S3.SS1.p6.m4" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> when <math id="S3.SS1.p6.m5" class="ltx_Math" alttext="F=H" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>=</mo><mi>H</mi></mrow><annotation encoding="application/x-tex">F=H</annotation></semantics></math> and <math id="S3.SS1.p6.m6" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> otherwise. Using this fact, we note that the change-of-basis matrices defined by equations (<a href="#S3.E4" title="Equation 4 ‣ Proposition 3.1 ‣ 3.1. The Kazhdan–Lusztig basis ‣ 3. Proof of the deletion formulas ‣ Inverse Kazhdan–Lusztig polynomialsof matroids under deletion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>) and
(<a href="#S3.E6" title="Equation 6 ‣ Lemma 3.2 ‣ 3.1. The Kazhdan–Lusztig basis ‣ 3. Proof of the deletion formulas ‣ Inverse Kazhdan–Lusztig polynomialsof matroids under deletion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>) are inverses of each other.
∎</span></p>
</div>
</div>
</section>
<section id="S3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.2. </span>A homomorphism for single element deletions</h3>

<div id="S3.SS2.p1" class="ltx_para">
<p id="S3.SS2.p1.1" class="ltx_p">We start by recalling a few elementary facts observed in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib10" title="" class="ltx_ref">3</a>, Section 2.6]</cite>.
Whenever <math id="S3.SS2.p1.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> is an element of the ground set of <math id="S3.SS2.p1.m2" class="ltx_Math" alttext="\mathsf{M}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">\mathsf{M}</annotation></semantics></math> that is not a coloop, there is a surjective map <math id="S3.SS2.p1.m3" class="ltx_Math" alttext="\mathcal{L}(\mathsf{M})\to\mathcal{L}(\mathsf{M}\smallsetminus i)" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝖬</mi><mo>∖</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}(\mathsf{M})\to\mathcal{L}(\mathsf{M}\smallsetminus i)</annotation></semantics></math> sending a flat <math id="S3.SS2.p1.m4" class="ltx_Math" alttext="F\in\mathcal{L}(\mathsf{M})" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F\in\mathcal{L}(\mathsf{M})</annotation></semantics></math> to <math id="S3.SS2.p1.m5" class="ltx_Math" alttext="F\smallsetminus i\in\mathcal{L}(\mathsf{M}\smallsetminus i)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>∖</mo><mi>i</mi></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝖬</mi><mo>∖</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F\smallsetminus i\in\mathcal{L}(\mathsf{M}\smallsetminus i)</annotation></semantics></math>. This map induces a <math id="S3.SS2.p1.m6" class="ltx_Math" alttext="\mathbb{Z}[x,x^{-1}]" display="inline" intent=":literal"><semantics><mrow><mi>ℤ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>x</mi><mo>,</mo><msup><mi>x</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{Z}[x,x^{-1}]</annotation></semantics></math>-linear map <math id="S3.SS2.p1.m7" class="ltx_Math" alttext="\Delta\colon\mathcal{H}(\mathsf{M})\to\mathcal{H}(\mathsf{M}\smallsetminus i)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝖬</mi><mo>∖</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta\colon\mathcal{H}(\mathsf{M})\to\mathcal{H}(\mathsf{M}\smallsetminus i)</annotation></semantics></math>, which is defined on the basis elements <math id="S3.SS2.p1.m8" class="ltx_Math" alttext="\Gamma^{F}_{\mathsf{M}}\in\mathcal{H}(\mathsf{M})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Γ</mi><mi>𝖬</mi><mi>F</mi></msubsup><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Gamma^{F}_{\mathsf{M}}\in\mathcal{H}(\mathsf{M})</annotation></semantics></math> by</p>
<table id="S3.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex19.m1" class="ltx_Math" alttext="\Delta(\Gamma^{F}_{\mathsf{M}}):=x^{\rk_{\mathsf{M}\smallsetminus i}(F\smallsetminus i)-\rk_{\mathsf{M}}(F)}\cdot\Gamma^{F\smallsetminus i}_{\mathsf{M}\smallsetminus i}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi mathvariant="normal">Γ</mi><mi>𝖬</mi><mi>F</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><msup><mi>x</mi><mrow><mrow><msub><mi>rk</mi><mrow><mi>𝖬</mi><mo>∖</mo><mi>i</mi></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>F</mi><mo>∖</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>rk</mi><mi>𝖬</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi mathvariant="normal">Γ</mi><mrow><mi>𝖬</mi><mo>∖</mo><mi>i</mi></mrow><mrow><mi>F</mi><mo>∖</mo><mi>i</mi></mrow></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Delta(\Gamma^{F}_{\mathsf{M}}):=x^{\rk_{\mathsf{M}\smallsetminus i}(F\smallsetminus i)-\rk_{\mathsf{M}}(F)}\cdot\Gamma^{F\smallsetminus i}_{\mathsf{M}\smallsetminus i}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p1.2" class="ltx_p">Written more explicitly:</p>
</div>
<div id="S3.SS2.p2" class="ltx_para">
<table id="S3.E7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(7)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E7.m1" class="ltx_Math" alttext="\Delta(\Gamma^{F}_{\mathsf{M}})=\begin{cases}\Gamma^{F}_{\mathsf{M}\smallsetminus i}&amp;\text{if }F\not\ni i,\\
\Gamma^{F\smallsetminus i}_{\mathsf{M}\smallsetminus i}&amp;\text{if }F\ni i\text{ and }F\smallsetminus i\notin\mathcal{L}(\mathsf{M}),\\
x^{-1}\cdot\Gamma^{F\smallsetminus i}_{\mathsf{M}\smallsetminus i}&amp;\text{if }F\ni i\text{ and }F\smallsetminus i\in\mathcal{L}(\mathsf{M}).\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi mathvariant="normal">Γ</mi><mi>𝖬</mi><mi>F</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><msubsup><mi mathvariant="normal">Γ</mi><mrow><mi>𝖬</mi><mo>∖</mo><mi>i</mi></mrow><mi>F</mi></msubsup></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>∌</mo><mi>i</mi></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><msubsup><mi mathvariant="normal">Γ</mi><mrow><mi>𝖬</mi><mo>∖</mo><mi>i</mi></mrow><mrow><mi>F</mi><mo>∖</mo><mi>i</mi></mrow></msubsup></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>∋</mo><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mtext> and </mtext><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>∖</mo><mi>i</mi></mrow><mo>∉</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msup><mi>x</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi mathvariant="normal">Γ</mi><mrow><mi>𝖬</mi><mo>∖</mo><mi>i</mi></mrow><mrow><mi>F</mi><mo>∖</mo><mi>i</mi></mrow></msubsup></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>∋</mo><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mtext> and </mtext><mo lspace="0em" rspace="0em">​</mo><mi>F</mi></mrow><mo>∖</mo><mi>i</mi></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\Delta(\Gamma^{F}_{\mathsf{M}})=\begin{cases}\Gamma^{F}_{\mathsf{M}\smallsetminus i}&amp;\text{if }F\not\ni i,\\
\Gamma^{F\smallsetminus i}_{\mathsf{M}\smallsetminus i}&amp;\text{if }F\ni i\text{ and }F\smallsetminus i\notin\mathcal{L}(\mathsf{M}),\\
x^{-1}\cdot\Gamma^{F\smallsetminus i}_{\mathsf{M}\smallsetminus i}&amp;\text{if }F\ni i\text{ and }F\smallsetminus i\in\mathcal{L}(\mathsf{M}).\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.SS2.p3" class="ltx_para">
<p id="S3.SS2.p3.1" class="ltx_p">We now state and prove a crucial lemma, which is central to the proof of Theorem <a href="#S1.Thmtheorem4" title="Theorem 1.4 ‣ 1.1. Main results ‣ 1. Introduction ‣ Inverse Kazhdan–Lusztig polynomialsof matroids under deletion" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1.4</span></a>. It describes the behavior of <math id="S3.SS2.p3.m1" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math> on the Kazhdan–Lusztig basis.</p>
</div>
<div id="S3.Thmtheorem3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem3.2" class="ltx_text ltx_font_bold">Lemma 3.3</span></span></h6>
<div id="S3.Thmtheorem3.p1" class="ltx_para">
<p id="S3.Thmtheorem3.p1.1" class="ltx_p"><span id="S3.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S3.Thmtheorem3.p1.m1" class="ltx_Math" alttext="\mathsf{M}" display="inline" intent=":literal"><semantics><mi>𝖬</mi><annotation encoding="application/x-tex">\mathsf{M}</annotation></semantics></math> be a matroid on <math id="S3.Thmtheorem3.p1.m2" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>, and let <math id="S3.Thmtheorem3.p1.m3" class="ltx_Math" alttext="i\in E" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mi>E</mi></mrow><annotation encoding="application/x-tex">i\in E</annotation></semantics></math> be an element that is not a coloop.</span></p>
<ol id="S3.I1" class="ltx_enumerate">
<li id="S3.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(i)</span> 
<div id="S3.I1.i1.p1" class="ltx_para">
<p id="S3.I1.i1.p1.1" class="ltx_p"><span id="S3.I1.i1.p1.1.1" class="ltx_text ltx_font_italic">If </span><math id="S3.I1.i1.p1.m1" class="ltx_Math" alttext="F\in\mathcal{L}(\mathsf{M})" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F\in\mathcal{L}(\mathsf{M})</annotation></semantics></math><span id="S3.I1.i1.p1.1.2" class="ltx_text ltx_font_italic"> is a flat such that </span><math id="S3.I1.i1.p1.m2" class="ltx_Math" alttext="i\in F" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mi>F</mi></mrow><annotation encoding="application/x-tex">i\in F</annotation></semantics></math><span id="S3.I1.i1.p1.1.3" class="ltx_text ltx_font_italic"> and </span><math id="S3.I1.i1.p1.m3" class="ltx_Math" alttext="F\smallsetminus i\notin\mathcal{L}(\mathsf{M})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>∖</mo><mi>i</mi></mrow><mo>∉</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F\smallsetminus i\notin\mathcal{L}(\mathsf{M})</annotation></semantics></math><span id="S3.I1.i1.p1.1.4" class="ltx_text ltx_font_italic">, then</span></p>
<table id="S3.E8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(8)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E8.m1" class="ltx_Math" alttext="\Delta(\upzeta_{\mathsf{M}}^{F})=\upzeta^{F\smallsetminus i}_{\mathsf{M}\smallsetminus i}+\sum_{G\in{S}_{i}(\mathsf{M}|_{F})}\uptau(\mathsf{M}|_{F}/(G\cup i))\cdot\upzeta^{G}_{\mathsf{M}\smallsetminus i}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mtext class="undefined">\upzeta</mtext><mi>𝖬</mi><mi>F</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mtext class="undefined">\upzeta</mtext><mrow><mi>𝖬</mi><mo>∖</mo><mi>i</mi></mrow><mrow><mi>F</mi><mo>∖</mo><mi>i</mi></mrow></msubsup><mo rspace="0.055em">+</mo><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>G</mi><mo>∈</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mi>𝖬</mi><mo stretchy="false">|</mo></mrow><mi>F</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><mtext class="undefined">\uptau</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mrow><mi>𝖬</mi><mo stretchy="false">|</mo></mrow><mi>F</mi></msub><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>G</mi><mo>∪</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><msubsup><mtext class="undefined">\upzeta</mtext><mrow><mi>𝖬</mi><mo>∖</mo><mi>i</mi></mrow><mi>G</mi></msubsup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\Delta(\upzeta_{\mathsf{M}}^{F})=\upzeta^{F\smallsetminus i}_{\mathsf{M}\smallsetminus i}+\sum_{G\in{S}_{i}(\mathsf{M}|_{F})}\uptau(\mathsf{M}|_{F}/(G\cup i))\cdot\upzeta^{G}_{\mathsf{M}\smallsetminus i},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I1.i1.p1.2" class="ltx_p"><span id="S3.I1.i1.p1.2.1" class="ltx_text ltx_font_italic">where </span><math id="S3.I1.i1.p1.m4" class="ltx_Math" alttext="{S}_{i}(\mathsf{M}|_{F})=\{G\in\mathcal{L}(\mathsf{M}|_{F}):i\notin G\text{ and }G\cup i\in\mathcal{L}(\mathsf{M}|_{F})\}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>S</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mi>𝖬</mi><mo stretchy="false">|</mo></mrow><mi>F</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>G</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mi>𝖬</mi><mo stretchy="false">|</mo></mrow><mi>F</mi></msub><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mi>i</mi><mo>∉</mo><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="ltx_mathvariant_italic"> and </mtext><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mo>∪</mo><mi>i</mi></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mi>𝖬</mi><mo stretchy="false">|</mo></mrow><mi>F</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">{S}_{i}(\mathsf{M}|_{F})=\{G\in\mathcal{L}(\mathsf{M}|_{F}):i\notin G\text{ and }G\cup i\in\mathcal{L}(\mathsf{M}|_{F})\}</annotation></semantics></math><span id="S3.I1.i1.p1.2.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S3.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(ii)</span> 
<div id="S3.I1.i2.p1" class="ltx_para">
<p id="S3.I1.i2.p1.1" class="ltx_p"><span id="S3.I1.i2.p1.1.1" class="ltx_text ltx_font_italic">If </span><math id="S3.I1.i2.p1.m1" class="ltx_Math" alttext="F\in\mathcal{L}(\mathsf{M})" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F\in\mathcal{L}(\mathsf{M})</annotation></semantics></math><span id="S3.I1.i2.p1.1.2" class="ltx_text ltx_font_italic"> is a flat such that </span><math id="S3.I1.i2.p1.m2" class="ltx_Math" alttext="i\in F" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mi>F</mi></mrow><annotation encoding="application/x-tex">i\in F</annotation></semantics></math><span id="S3.I1.i2.p1.1.3" class="ltx_text ltx_font_italic"> and </span><math id="S3.I1.i2.p1.m3" class="ltx_Math" alttext="F\smallsetminus i\in\mathcal{L}(\mathsf{M})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>∖</mo><mi>i</mi></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝖬</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F\smallsetminus i\in\mathcal{L}(\mathsf{M})</annotation></semantics></math><span id="S3.I1.i2.p1.1.4" class="ltx_text ltx_font_italic">, then</span></p>
<table id="S3.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex20.m1" class="ltx_Math" alttext="\Delta(\upzeta^{F}_{\mathsf{M}})=(x+x^{-1})\upzeta_{\mathsf{M}\smallsetminus i}^{F\smallsetminus i}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mtext class="undefined">\upzeta</mtext><mi>𝖬</mi><mi>F</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>+</mo><msup><mi>x</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mtext class="undefined">\upzeta</mtext><mrow><mi>𝖬</mi><mo>∖</mo><mi>i</mi></mrow><mrow><mi>F</mi><mo>∖</mo><mi>i</mi></mrow></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Delta(\upzeta^{F}_{\mathsf{M}})=(x+x^{-1})\upzeta_{\mathsf{M}\smallsetminus i}^{F\smallsetminus i}.</annotation></semantics></math></td>
