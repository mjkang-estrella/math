/msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>Q</mi><msub><mi>𝖴</mi><mrow><mrow><mi>n</mi><mo>−</mo><mi>a</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mrow><mi>n</mi><mo>−</mo><mi>a</mi></mrow></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Q_{\mathsf{\Lambda}_{r,n-2,r+1,n}}(x)-Q_{\mathsf{U}_{n-r-2,n-r-1}}(x)Q_{\mathsf{U}_{r,r+1}}(x)=\sum_{a=2}^{n-r-1}\left(Q_{\mathsf{C}_{a,n+1-a}}(x)-Q_{\mathsf{U}_{a-1,a}}(x)\,Q_{\mathsf{U}_{n-a-1,n-a}}(x)\right).</annotation></semantics></math></td>
