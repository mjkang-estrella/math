</table>
<p id="S3.p20.3" class="ltx_p">The constant term of <math id="S3.p20.m6" class="ltx_Math" alttext="W[\B(Q_{U_{h+1,d}}(t)-Q_{U_{h+1,d-1}}(t)),\B(Q_{U_{h,d}}(t)-Q_{U_{h,d-1}}(t))]" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>Q</mi><msub><mi>U</mi><mrow><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>d</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>Q</mi><msub><mi>U</mi><mrow><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>Q</mi><msub><mi>U</mi><mrow><mi>h</mi><mo>,</mo><mi>d</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>Q</mi><msub><mi>U</mi><mrow><mi>h</mi><mo>,</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">W[\B(Q_{U_{h+1,d}}(t)-Q_{U_{h+1,d-1}}(t)),\B(Q_{U_{h,d}}(t)-Q_{U_{h,d-1}}(t))]</annotation></semantics></math> is</p>
