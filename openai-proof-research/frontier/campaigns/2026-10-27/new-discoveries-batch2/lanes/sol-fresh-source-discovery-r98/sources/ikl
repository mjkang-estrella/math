<tbody id="S3.Ex30"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex30.m1" class="ltx_Math" alttext="\displaystyle\binom{\left\lfloor\frac{d-1}{2}\right\rfloor}{1}\frac{\left(d^{2}+d(h-2)-2h+1\right)(d+h-2)!}{(d-1)!h!}\cdot\binom{d+h-2}{h-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mrow><mo>⌊</mo><mfrac><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mn>2</mn></mfrac><mo>⌋</mo></mrow><mn>1</mn></mfrac></mstyle><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><mo>(</mo><mrow><mrow><mrow><msup><mi>d</mi><mn>2</mn></msup><mo>+</mo><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>h</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>d</mi><mo>+</mo><mi>h</mi></mrow><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>!</mo></mrow><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo>!</mo></mrow></mfrac></mstyle></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mrow><mrow><mi>d</mi><mo>+</mo><mi>h</mi></mrow><mo>−</mo><mn>2</mn></mrow><mrow><mi>h</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\binom{\left\lfloor\frac{d-1}{2}\right\rfloor}{1}\frac{\left(d^{2}+d(h-2)-2h+1\right)(d+h-2)!}{(d-1)!h!}\cdot\binom{d+h-2}{h-1}</annotation></semantics></math></td>
