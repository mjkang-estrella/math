<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex28.m1" class="ltx_Math" alttext="Q_{U_{m,d}}(t)=\binom{d+m-1}{m}+\frac{(d-2)m}{d+m-1}\binom{d+m}{m+1}t+\cdots," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>Q</mi><msub><mi>U</mi><mrow><mi>m</mi><mo>,</mo><mi>d</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo>(</mo><mfrac linethickness="0pt"><mrow><mrow><mi>d</mi><mo>+</mo><mi>m</mi></mrow><mo>−</mo><mn>1</mn></mrow><mi>m</mi></mfrac><mo>)</mo></mrow><mo>+</mo><mrow><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mrow><mrow><mi>d</mi><mo>+</mo><mi>m</mi></mrow><mo>−</mo><mn>1</mn></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mrow><mi>d</mi><mo>+</mo><mi>m</mi></mrow><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></mfrac><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">Q_{U_{m,d}}(t)=\binom{d+m-1}{m}+\frac{(d-2)m}{d+m-1}\binom{d+m}{m+1}t+\cdots,</annotation></semantics></math></td>
