<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex29.m1" class="ltx_Math" alttext="Q_{U_{m,d}}(t)-Q_{U_{m,d-1}}(t)=\binom{d+m-2}{m-1}+\frac{\left(d^{2}+d(m-3)-2m+3\right)(d+m-3)!}{(d-1)!(m-1)!}t+\cdots." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>Q</mi><msub><mi>U</mi><mrow><mi>m</mi><mo>,</mo><mi>d</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>Q</mi><msub><mi>U</mi><mrow><mi>m</mi><mo>,</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mo>(</mo><mfrac linethickness="0pt"><mrow><mrow><mi>d</mi><mo>+</mo><mi>m</mi></mrow><mo>−</mo><mn>2</mn></mrow><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></mfrac><mo>)</mo></mrow><mo>+</mo><mrow><mfrac><mrow><mrow><mrow><mo>(</mo><mrow><mrow><mrow><msup><mi>d</mi><mn>2</mn></msup><mo>+</mo><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>−</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mrow><mo>+</mo><mn>3</mn></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>d</mi><mo>+</mo><mi>m</mi></mrow><mo>−</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>!</mo></mrow><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>!</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Q_{U_{m,d}}(t)-Q_{U_{m,d-1}}(t)=\binom{d+m-2}{m-1}+\frac{\left(d^{2}+d(m-3)-2m+3\right)(d+m-3)!}{(d-1)!(m-1)!}t+\cdots.</annotation></semantics></math></td>
