[{"sha":"12cfb6b5c2184e345a1ed210e2ece185fdaa809d","node_id":"C_kwDOTUuVMNoAKDEyY2ZiNmI1YzIxODRlMzQ1YTFlZDIxMGUyZWNlMTg1ZmRhYTgwOWQ","commit":{"author":{"name":"AlyciaBHZ","email":"50111876+AlyciaBHZ@users.noreply.github.com","date":"2026-10-08T19:21:51Z"},"committer":{"name":"AlyciaBHZ","email":"50111876+AlyciaBHZ@users.noreply.github.com","date":"2026-10-08T22:04:40Z"},"message":"Refute Sun Conjecture 3.8: no primitive circular permutation over F_11 with offset 2\n\nSun (arXiv:1309.1679, Conjecture 3.8) asserts that for every finite field F_q with q > 7 and every a_0 there is a circular\npermutation of the nonzero elements with every a_0 + a_i a_{i+1} primitive. Over F_11 with a_0 = 2 both 2 and 9 can only\nneighbour 3 and 8, which forces a 4-cycle. Preregistration #14536.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>","tree":{"sha":"5e089bb4def7da18ae1ae6556f38302598b6ef8f","url":"https://api.github.com/repos/the-omega-institute/trureturing/git/trees/5e089bb4def7da18ae1ae6556f38302598b6ef8f"},"url":"https://api.github.com/repos/the-omega-institute/trureturing/git/commits/12cfb6b5c2184e345a1ed210e2ece185fdaa809d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/the-omega-institute/trureturing/commits/12cfb6b5c2184e345a1ed210e2ece185fdaa809d","html_url":"https://github.com/the-omega-institute/trureturing/commit/12cfb6b5c2184e345a1ed210e2ece185fdaa809d","comments_url":"https://api.github.com/repos/the-omega-institute/trureturing/commits/12cfb6b5c2184e345a1ed210e2ece185fdaa809d/comments","author":{"login":"AlyciaBHZ","id":50111876,"node_id":"MDQ6VXNlcjUwMTExODc2","avatar_url":"https://avatars.githubusercontent.com/u/50111876?v=4","gravatar_id":"","url":"https://api.github.com/users/AlyciaBHZ","html_url":"https://github.com/AlyciaBHZ","followers_url":"https://api.github.com/users/AlyciaBHZ/followers","following_url":"https://api.github.com/users/