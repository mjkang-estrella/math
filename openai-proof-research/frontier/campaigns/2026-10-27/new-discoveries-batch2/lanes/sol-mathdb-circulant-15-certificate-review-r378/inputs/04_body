    <title>A Nonlinear Orthogonal Non-Negative Matrix Factorization Approach to Subspace Clustering</title>
    <updated>2017-09-29T11:02:16Z</updated>
    <link href="https://arxiv.org/abs/1709.10323v1" rel="alternate" type="text/html"/>
