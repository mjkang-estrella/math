  "S1.E7": "id=\"S1.E7\" class=\"ltx_equation ltx_eqn_table\">\n\n<tbody><tr class=\"ltx_equation ltx_eqn_row ltx_align_baseline\">\n<td class=\"ltx_eqn_cell ltx_eqn_center_padleft\"></td>\n<td class=\"ltx_eqn_cell ltx_align_center\"><math id=\"S1.E7.m1\" class=\"ltx_Math\" alttext=\"m_{1}(a,b)&lt;m_{2}(a,b),\\,\\,\\forall a\\neq b\\ \\Longleftrightarrow\\ f_{m_{1}}(x)&lt;f_{m_{2}}(x),\\,\\,\\forall x&gt;0.\" display=\"block\" intent=\":literal\"><semantics><mrow><mrow><mrow><mrow><msub><mi>m</mi><mn>1</mn></msub><mo lspace=\"0em\" rspace=\"0em\">\u200b</mo><mrow><mo stretchy=\"false\">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy=\"false\">)</mo></mrow></mrow><mo>&lt;</mo><mrow><msub><mi>m</mi><mn>2</mn></msub><mo lspace=\"0em\" rspace=\"0em\">\u200b</mo><mrow><mo stretchy=\"false\">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy=\"false\">)</mo></mrow></mrow></mrow><mo rspace=\"0.507em\">,</mo><mrow><mrow><mo rspace=\"0.167em\">\u2200</mo><mi>a</mi></mrow><mo>\u2260</mo><mi>b</mi><mo lspace=\"0.778em\" rspace=\"0.778em\" stretchy=\"false\">\u27fa</mo><mrow><msub><mi>f</mi><msub><mi>m</mi><mn>1</mn></msub></msub><mo lspace=\"0em\" rspace=\"0em\">\u200b</mo><mrow><mo stretchy=\"false\">(</mo><mi>x</mi><mo stretchy=\"false\">)</mo></mrow><mo lspace=\"0em\" rspace=\"0em\">\u200b</mo><mrow><mo>&lt;</mo><mrow><mrow><msub><mi>f</mi><msub><mi>m</mi><mn>2</mn></msub></msub><mo lspace=\"0em\" rspace=\"0em\">\u200b</mo><mrow><mo stretchy=\"false\">(</mo><mi>x</mi><mo stretchy=\"false\">)</mo></mrow></mrow><mo rspace=\"0.507em\">,</mo><mrow><mo rspace=\"0.167em\">\u2200</mo><mi>x</mi></mrow></mrow><mo>&gt;</mo></mrow><mo lspace=\"0em\" rspace=\"0em\">\u200b</mo><mn>0</mn></mrow></mrow></mrow><mo lspace=\"0em\">.</mo></mrow><annotation encoding=\"application/x-tex\">m_{1}(a,b)&lt;m_{2}(a,b),\\,\\,\\forall a\\neq b\\ \\Longleftrightarrow\\ f_{m_{1}}(x)&lt;f_{m_{2}}(x),\\,\\,\\forall x&gt;0.</annotation></semantics></math></td>\n<td class=\"ltx_eqn_cell ltx_eqn_center_padright\"></td>\n<td rowspan=\"1\" class=\"ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right\"><span class=\"ltx_tag ltx_tag_equation ltx_align_right\">(1.7)</span></td></tr></tbody>\n</table>",
  "S4.Thmthm7": "id=\"S4.Thmthm7\" class=\"ltx_theorem ltx_theorem_conj\">\n<h6 class=\"ltx_title ltx_runin ltx_title_theorem\"><span class=\"ltx_tag ltx_tag_theorem\"><span id=\"S4.Thmthm7.2\" class=\"ltx_text ltx_font_italic\">Conjecture 4.7</span></span><span id=\"S4.Thmthm7.3\" class=\"ltx_text ltx_font_italic\">.</span></h6>\n<div id=\"S4.Thmthm7.p1\" class=\"ltx_para\">\n<p id=\"S4.Thmthm7.p1.1\" class=\"ltx_p\">Let <math id=\"S4.Thmthm7.p1.m1\" class=\"ltx_Math\" alttext=\"p=5-2q\" display=\"inline\" intent=\":literal\"><semantics><mrow><mi>p</mi><mo>=</mo><mrow><mn>5</mn><mo>\u2212</mo><mrow><mn>2</mn><mo lspace=\"0em\" rspace=\"0em\">\u200b</mo><mi>q</mi></mrow></mrow></mrow><annotation encoding=\"application/x-tex\">p=5-2q</annotation></semantics></math> and <math id=\"S4.Thmthm7.p1.m2\" class=\"ltx_Math\" alttext=\"q=\\frac{1}{2}(5\\pm\\sqrt{17})\" display=\"inline\" intent=\":literal\"><semantics><mrow><mi>q</mi><mo>=</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace=\"0em\" rspace=\"0em\">\u200b</mo><mrow><mo stretchy=\"false\">(</mo><mrow><mn>5</mn><mo>\u00b1</mo><msqrt><mn>17</mn></msqrt></mrow><mo stretchy=\"false\">)</mo></mrow></mrow></mrow><annotation encoding=\"application/x-tex\">q=\\frac{1}{2}(5\\pm\\sqrt{17})</annotation></semantics></math>.\nThen <math id=\"S4.Thmthm7.p1.m3\" class=\"ltx_Math\" alttext=\"M_{2}-\\mathcal{R}(B_{p},M_{2},B_{q})&lt;0\" display=\"inline\" intent=\":literal\"><semantics><mrow><mrow><msub><mi>M</mi><mn>2</mn></msub><mo>\u2212</mo><mrow><mi class=\"ltx_font_mathcaligraphic\">\u211b</mi><mo>\u2061</mo><mrow><mo stretchy=\"false\">(</mo><msub><mi>B</mi><mi>p</mi></msub><mo>,</mo><msub><mi>M</mi><mn>2</mn></msub><mo>,</mo><msub><mi>B</mi><mi>q</mi></msub><mo stretchy=\"false\">)</mo></mrow></mrow></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding=\"application/x-tex\">M_{2}-\\mathcal{R}(B_{p},M_{2},B_{q})&lt;0</annotation></semantics></math>.</p>\n</div>\n</div>\n"
}
