                    <div class="col-md-5 col-lg-4">
                        <div class="c-reading-companion">
                            <div class="c-reading-companion__sticky" style="position: sticky !important; top: 5px;">
                                <h3 style="margin-top:15px; margin-bottom:14px"><a href="https://journals.azbuki.bg/mathinfo/issue/2024/2">Година LXVII, 2024/2</a>
