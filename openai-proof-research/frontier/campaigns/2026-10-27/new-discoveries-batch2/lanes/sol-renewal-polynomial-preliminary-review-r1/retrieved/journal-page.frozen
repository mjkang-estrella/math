                                <ul class="c-reading-companion__tabs" role="tablist" style="margin-top:15px">
                                    <li role="presentation"><button data-tab-target="sections" role="tab" id="tab-sections" aria-controls="tabpanel-sections" aria-selected="false" class="c-reading-companion__tab c-reading-companion__tab--active" data-track="click" data-track-action="sections tab" data-track-label="tab" tabindex="-1" onclick="showAccents();">Акценти</button></li>
                                    <li role="presentation"><button data-tab-target="figures" role="tab" id="tab-figures" aria-controls="tabpanel-figures" aria-selected="false" tabindex="-1" class="c-reading-companion__tab" data-track="click" data-track-action="figures tab" data-track-label="tab" onclick="showFigures();">Илюстрации</button></li>
                                    <li role="presentation"><button data-tab-target="references" role="tab" id="tab-references" aria-controls="tabpanel-references" aria-selected="true" class="c-reading-companion__tab" data-track="click" data-track-action="references tab" data-track-label="tab" onclick="showLiterature();">Литература</button></li>
                                </ul>
                            <script>
                                function showLiterature()
                                {
                                    $("#tab-sections").removeClass("c-reading-companion__tab--active");
                                    $("#tab-figures").removeClass("c-reading-companion__tab--active");
                                    $("#tab-references").addClass("c-reading-companion__tab--active");
                                    $(".article-contents").css("display", "none");
                                    $(".article-figures").css("display", "none");
                                    $(".article-literature").css("display", "block");
                                    $(".article-literature > p").css("display", "block");
                                }

                                function showFigures()
                                {
                                    $("#tab-sections").removeClass("c-reading-companion__tab--active");
                                    $("#tab-figures").addClass("c-reading-companion__tab--active");
                                    $("#tab-references").removeClass("c-reading-companion__tab--active");
                                    $(".article-contents").css("display", "none");
                                    $(".article-figures").css("display", "block");
                                    $(".article-literature").css("display", "none");
                                }

                                function showAccents()
                                {
                                    $("#tab-sections").addClass("c-reading-companion__tab--active");
                                    $("#tab-figures").removeClass("c-reading-companion__tab--active");
                                    $("#tab-references").removeClass("c-reading-companion__tab--active");
                                    $(".article-contents").css("display", "block");
                                    $(".article-figures").css("display", "none");
                                    $(".article-literature").css("display", "none");
                                }

                                function extractAltTitle(html)
                                {
                                    spanStart = html.indexOf("<span");
                                    if (spanStart > 0) {
                                        spanEnd = html.indexOf(">", spanStart);
                                        if (spanEnd > 0) spanEnd = spanEnd+1;
                                        else spanEnd = spanStart+5;
                                        html = html.substr(spanEnd);
                                        spanEnd = html.indexOf("</span>");
                                        if (spanEnd > 0) {
                                            res = html.substr(0, spanEnd).replace("  ", " ").trim();
                                            if (res.indexOf("<") == -1);
                                                return res;
                                        }
                                    }

                                    return "";
                                }

                                function extractTitle(html)
                                {
                                    html = html.replaceAll("(ред.).", "");
                                    html = html.replaceAll(" (ed.)", "");
                                    html = html.replaceAll(" (Еd.)", "");
                                    html = html.replaceAll(" (Еds.)", "");
                                    html = html.replaceAll(" (Eds.)", "");
                                    html = html.replaceAll("(Eds.)", "");
                                    html = html.replaceAll("(съст.).", "");
                                    spanStart = html.indexOf("<span");
                                    if (spanStart > 0)
                                        html = html.substr(0, spanStart);

                                    startPos = 0;

                                    sp = html.search(/\d{4}\./);
                                    sp1 = html.indexOf(").");
                                    sp2 = html.indexOf(") .");
                                    sp3 = html.indexOf("):");
                                    sp4 = html.search(/\(\d{4}\)/);
                                    sp5 = html.search(/\(\d{4}[а-я]\)/);

                                    if (sp > -1 && (sp < sp1 || sp1 < 0))
                                        startPos = sp+5;
                                    else if (sp1 > 0)
                                        startPos = sp1+2;
                                    else if (sp2 > 0)
                                        startPos = sp2+3;
                                    else if (sp3 > 0)
                                        startPos = sp3+2;
                                    else if (sp4 > 0)
                                        startPos = sp4+6;
                                    else if (sp5 > 0)
                                        startPos = sp5+7;

                                    endPos = html.indexOf(". ", startPos);
                                    endPos1 = html.indexOf("(", startPos);
                                    endPos2 = html.indexOf("?", startPos);
                                    endPos3 = html.indexOf(".", startPos);
                                    endPos4 = html.indexOf(",", startPos);
                                    if (endPos1 > 0)
                                        if (endPos > 0) endPos = Math.min(endPos, endPos1);
                                        else endPos = endPos1;
                                    if (endPos2 > 0 && endPos < 0)
                                        endPos = endPos2;
                                    if (endPos3 > 0 && endPos < 0)
                                        endPos = endPos3;
                                    if (endPos4 > 0 && endPos < 0)
                                        endPos = endPos4;
                                    if (endPos > 0)
                                        return html.substr(startPos, endPos-startPos).trim();

                                    return html.substr(startPos).trim();
                                }

                                function linkAuthors(text, idx, el)
                                {
                                    brStart = text.indexOf('(');
                                    if (brStart > 0) text = text.substr(0, brStart);
                                    brStart = text.search(/\d{4}/);
                                    if (brStart > 0) text = text.substr(0, brStart);
                                    text = text.replaceAll("&", ",").replaceAll(" ,", ",").replaceAll(", ", ",").replaceAll(" and ", " ").replaceAll(" i ", " ").replaceAll("  ", " ").replaceAll("  ", " ").replaceAll("  ", " ");
                                    authors = text.split(",");
                                    authorsAttr = "";
                                    for (s of authors) {
                                        s = s.trim();
                                        if (s.length > 2 || s.length == 2 && s.search(/[A-Z]/) >= 0) {
                                            if (s.endsWith('.')) continue;
                                            let v = authorsList.get(s);
                                            if (v === undefined)
                                                v = [];
                                            v.push(idx);
                                            authorsList.set(s, v);
                                            authorsAttr = authorsAttr + " " + s;
                                        }
                                    }

                                    $(el).attr("authors", authorsAttr.trim());
                                }

                                function replaceTitle(el, title, idx)
                                {
                                    title = title.replaceAll('  ', ' ').replaceAll('  ', ' ').replaceAll('  ', ' ').replaceAll('  ', ' ').replaceAll('  ', ' ');
                                    html = el.innerHTML;
                                    text = el.innerText;
                                    text = text.replaceAll('  ', ' ').replaceAll('  ', ' ').replaceAll('  ', ' ').replaceAll('  ', ' ').replaceAll('  ', ' ');
                                    titlePos = text.indexOf(title);

                                    if (titlePos >= 0)
                                        linkAuthors(text.substr(0, titlePos), idx, el);

                                    let authors = $(el).attr("authors").trim();
                                    if (authors != "")
                                        authors = "&author=" + authors.replaceAll(" ", "&author=");
                                    html = el.innerHTML;
                                    html = html.replaceAll('  ', ' ').replaceAll('  ', ' ').replaceAll('  ', ' ').replaceAll('  ', ' ').replaceAll('  ', ' ');
                                    console.log(html);
                                    html = html.replace(title, '<a target=_blank href="' + encodeURI("https://scholar.google.com/scholar_lookup?title=" + title + authors) + '">' + title + '</a>');
                                    $(el).html(html);
                                }

                                function fixReferences(el)
                                {
                                    let referencesP = $(el).closest('p');
                                    let start = referencesP;
                                    do {
                                        start = $(start).next();
                                        if (start.length == 0) break;

                                        if (start[0].innerText.trim() == "REFERENCES / ЛИТЕРАТУРА")
                                            break;
                                        if (start[0].innerText.trim() == "REFERENCES")
                                            break;
                                        if (start[0].innerText.trim() == "REFERECES")
                                            break;
                                        if (start[0].innerText.trim() == "ЛИТЕРАТУРА")
                                            break;
                                        if (start[0].innerText.trim() == "ИЗТОЧНИЦИ")
                                            break;
                                        if (start[0].innerText.trim() == "ПРИЛОЖЕНИЯ")
                                            break;
                                        if (start[0].innerText.trim() == "DOCUMENTS")
                                            break;
                                        if (start[0].innerText.trim() == "PRIMARY SOURSES")
                                            break;
                                        if (start[0].innerText.trim() == "Funding")
                                            break;
                                        if (start[0].innerText.trim() == "Acknowledgement and Funding")
                                            break;
                                        if (start[0].innerText.trim() == "Acknowledgements and Funding")
                                            break;
                                        if (start[0].innerText.trim() == "Acknowledgеments & Funding")
                                            break;
                                        if (start[0].innerText.trim().startsWith("Приложение"))
                                            break;

                                        altTitle = extractAltTitle(start[0].innerHTML).replaceAll("  ", " ").replaceAll("  ", " ").replaceAll("  ", " ").replaceAll("  ", " ").replaceAll("  ", " ").trim();

                                        title = start[0].innerText.replaceAll("  ", " ").replaceAll("  ", " ").replaceAll("  ", " ").replaceAll("  ", " ").replaceAll("  ", " ").trim();

                                        altTitlePos = title.indexOf(altTitle.replaceAll("&amp;", "&"));
                                        if (altTitlePos > 0) {
                                            title = title.substr(0, altTitlePos).trim();
                                            if (title.endsWith(","))
                                                title = title.substr(0, title.length-1);
                                        }
                                        title = extractTitle(title);

                                        if (title == "" || altTitle.indexOf(title) >= 0)
                                            title = altTitle;
                                        if (title != "" && title != "REFERENCES" && title != "ЛИТЕРАТУРА" && title != "ИЗТОЧНИЦИ") {
                                            articlesList.push(start[0]);
                                            replaceTitle(start[0], title, articlesList.length-1);
                                            if (altTitle != "" && altTitle != title)
                                                replaceTitle(start[0], altTitle, articlesList.length-1);
                                        }
                                    } while (true);
                                }

                                let notes = [];
                                let authorsList = new Map();
                                let articlesList = [];

                                function scanNotes(el)
                                {
                                    let notesP = $(el).closest('p');
                                    let start = notesP;
                                    do {
                                        start = $(start).next();
                                        if (start.length == 0) break;

                                        text = start[0].innerText.replaceAll("  ", " ").replaceAll("  ", " ").replaceAll("  ", " ").replaceAll("  ", " ").trim();
                                        if (text == "REFERENCES")
                                            break;
                                        if (text == "ИЗТОЧНИЦИ")
                                            break;
                                        if (text == "PRIMARY SOURSES")
                                            break;
                                        if (text == "Funding")
                                            break;
                                        if (text == "Acknowledgements and Funding" || text == "Acknowledgments and funding")
                                            break;
                                        if (text == "ПРИЛОЖЕНИЯ")
                                            break;
                                        if (text == "REFERENCES / ЛИТЕРАТУРА")
                                            break;

                                        if (text !== undefined)
                                            notes.push(text);
                                    } while (true);
                                }

                                function getNote(note)
                                {
                                    note = note.trim();
                                    if (note.endsWith(")"))
                                        note = note.substr(0, note.length-1);
                                    for (const el of notes) {
                                        pos = el.indexOf(note + ".");
                                        if (pos >= 0 && pos < 5) {
                                            return el;
                                        }
                                        pos = el.indexOf(note + " ");
                                        if (pos >= 0 && pos < 5) {
                                            return el;
                                        }
                                    }
                                    return "";
                                }

                                function makeContents()
                                {
                                    let contentNodes = $(".article-wrapper > p > span:first-child[style*=bold], .article-wrapper > p > b");
                                    let html = "";
                                    let n = 0;
                                    contentNodes.each(function() {
                                        let parent = $(this).parent();
                                        if (parent.length > 0 && (parent[0].innerHTML.startsWith('<span') || parent[0].innerHTML.startsWith('<b'))) {
                                            let parent = this.parentNode;
                                            let el = document.createElement('a');
                                            $(el).attr('id', 'section-' + n);
                                            parent.insertBefore(el, this);

                                            $(el).css('margin-top', '-170px');
                                            $(el).css('padding-top', '170px');
                                            $(el).css('visibility', 'hidden');

                                            let heading = this.innerText.trim();
                                            if (heading.endsWith("."))
                                                heading = heading.substr(0, heading.length-1);
                                            html = html + '<p class="zi"><a href="#section-' + n + '">' + heading + '</a></p>';
                                            if (this.innerText == "ЛИТЕРАТУРА" || this.innerText == "REFERENCES"
                                                || this.innerText == "ИЗТОЧНИЦИ"
                                                || this.innerText == "PRIMARY SOURSES"
                                                || this.innerText == "REFERENCES / ЛИТЕРАТУРА") {
                                                fixReferences(this);
                                            }
                                            if (this.innerText == "БЕЛЕЖКИ" || this.innerText == "NOTES"
                                               || this.innerText == "NOTES / БЕЛЕЖКИ")
                                                scanNotes(this);
                                            n++;
                                        }
                                    });
                                    $("div.article-contents").html(html);
                                    for (const art of articlesList)
                                        $("div.article-literature").append($(art).clone());
                                    console.log(authorsList);
                                    console.log(articlesList);
                                }

                                function fixNotesList(list)
                                {
                                    list.each(function() {
                                        if (this.innerText !== undefined) {
                                            console.log(this.innerText);
                                            note = getNote(this.innerText);
                                            if (note !== "") {
                                                $(this).addClass("article-note")
                                                //$(this).attr("title", note);
                                                $(this).css("cursor", "pointer");
                                                $(this).css("color", "#d44744");
                                                $(this).css("font-weight", "bold");
                                                $(this).css("font-size", "1.5rem");
                                                $(this).on("click", function() {
                                                    let el = $("#note-" + parseInt(this.innerText));
                                                    let top = event.pageY+10;
                                                    let left = event.pageX+2;
                                                    if (left > document.body.clientWidth/3)
                                                        left = 0.25*document.body.clientWidth;
                                                    el.css("top", top+'px');
                                                    el.css("left", left+'px');
                                                    el.toggle();

                                                    event.stopPropagation();
                                                });
                                                let noteDiv = document.createElement('div');
                                                $(noteDiv).attr("id", "note-" + parseInt(this.innerText));
                                                $(noteDiv).addClass("article-note-popup");
                                                $(noteDiv).text(note);
                                                $(document.body).append(noteDiv);
                                                console.log("[" + this.innerText + "] " + note);
                                            }
                                        }
                                    });
                                }

                                function fixNotes()
                                {
                                    let notesNodes = $(".article-wrapper > p > span[style*=super]");
                                    fixNotesList(notesNodes);

                                    let notesNodes2 = $("div.article-picture-desc p span[style*=super]");
                                    fixNotesList(notesNodes2);

                                    let notesNodes3 = $(".article-wrapper > p > sup");
                                    fixNotesList(notesNodes3);

                                    let notesNodes4 = $("div.article-author > span > sup");
                                    fixNotesList(notesNodes4);
/*                                    notesNodes.each(function() {
                                        if (this.innerText !== undefined) {
                                            console.log(this.innerText);
                                            note = getNote(this.innerText);
                                            if (note !== "") {
                                                $(this).attr("title", note);
                                                $(this).css("cursor", "pointer");
                                                $(this).css("color", "#d44744");
                                                $(this).css("font-weight", "bold");
                                                $(this).css("font-size", "1.5rem");
                                                console.log("[" + this.innerText + "] " + note);
                                            }
                                        }
                                    });*/
                                }

                                function filterLiterature(el)
                                {
                                    showLiterature();
                                    text = el.innerText.toUpperCase();
                                    $(".article-literature > p").each(function(){
                                        let pos = $(this).attr("authors").toUpperCase().indexOf(text);
                                        if (pos >= 0 && pos < 60)
                                            $(this).css("display", "block");
                                        else
                                            $(this).css("display", "none");
                                    });
                                }

                                function highlightAuthorsNode(node)
                                {
                                    if (node.nodeName != '#text') {
                                        NodeList.prototype.forEach = Array.prototype.forEach;
                                        node.childNodes.forEach(function(el) {
                                            highlightAuthorsNode(el);
                                        });
                                        return;
                                    }

                                    let html = node.textContent;
                                    let first = '<span style="cursor: pointer; font-weight: bold;" onclick="filterLiterature(this);">';
                                    let second = "</span>";

                                    let start = 0;
                                    let changed = false;
                                    do {
                                        let htmlUpper = html.toLowerCase();
                                        let bestPos = html.length;
                                        let bestKey = "";
                                        for (let [key, value] of authorsList.entries()) {
                                            key = key.toLowerCase();

                                            let pos = htmlUpper.indexOf(key, start);
                                            if (pos >= 0 && pos < bestPos
                                                && htmlUpper.substr(pos-1, 1).search(/[a-zа-я]/) < 0
                                                && htmlUpper.substr(pos+key.length, 1).search(/[a-zа-я]/) < 0
                                                ) {
                                                bestPos = pos;
                                                bestKey = key;
                                            }
                                        }

                                        if (bestPos < html.length) {
                                            html = html.substr(0, bestPos) + first
                                                + html.substr(bestPos, bestKey.length)
                                                + second
                                                + html.substr(bestPos + bestKey.length);
                                            start = bestPos + bestKey.length + first.length + second.length;
                                            changed = true;
                                            console.log(bestKey);
                                        } else break;
                                        //html = html.replaceAll(key, '<span style="cursor: pointer; font-weight: bold;" onclick="filterLiterature(this);">' + key + "</span>");
                                    } while (true);
                                    if (changed) {
                                        let pNode = node.parentNode;
                                        let newNode = document.createElement('span');
                                        newNode.innerHTML = html;
                                        pNode.replaceChild(newNode, node);
                                    }
                                }

                                function highlightAuthors()
                                {
                                    let p = $("div.article-wrapper p");
                                    let referencesFound = false;
                                    p.each(function(idx, el) {
                                        if (el.innerText == "REFERENCES") referencesFound = true;
                                        if (el.innerText == "ЛИТЕРАТУРА") referencesFound = true;
                                        if (el.innerText == "REFERENCES / ЛИТЕРАТУРА") referencesFound = true;
                                        if (!referencesFound)
                                            highlightAuthorsNode(el);
                                    });
                                }

                                function makeFigures()
                                {
                                    let images = $("div.article-wrapper div.image-block, div.article-wrapper div[hint*='image-block']");
                                    let lastParent = null;
                                    images.each(function(idx, el) {
                                        if ($(el).hasClass('image-block')) {
                                            newEl = document.createElement('div');
                                            newEl.innerHTML = el.innerHTML;
                                            $("div.article-figures").append(newEl);
                                            lastParent = el;
                                        }
                                        else {
                                            el = el.parentNode;
                                            if (el != lastParent) {
                                                newEl = document.createElement('div');
                                                newEl.innerHTML = el.innerHTML;
                                                $("div.article-figures").append(newEl);
                                            }
                                            lastParent = el;
                                        }
                                    });
                                    if ($("div.article-figures > div").length == 0)
                                        $("#tab-figures").parent().css("display", "none");
                                }

                                function checkScroll()
                                {
                                    let topscr = 350;
                                    if ($(window).scrollTop() >= topscr+20) {
                                        $('.article-title').addClass('scroll');
                                        $('.rubric').addClass('scroll');
                                    }
                                    if ($(window).scrollTop() < topscr) {
                                        $('.article-title').removeClass('scroll');
                                        $('.rubric').removeClass('scroll');
                                    }
                                }

                                function fixLayout()
                                {
                                    $("div.image-block").filter(function(){
                                        return $(this).children("div").length == 1
                                    }).each(function(){
                                        $(this).css("flex-direction", "column");
                                        $(this).find(".article-picture-desc > div > p").parent().each(function(){
                                            $(this).find("p").addClass("center").removeClass("zi").removeClass("ni");
                                            let html = this.outerHTML;
                                            if ($(this).closest("div.article-picture-desc").find(":nth-child(1)").find(":nth-child(1)").is("p"))
                                                $(this).closest("div.image-block").prepend(html);
                                            else
                                                $(this).closest("div.image-block").append(html);
                                            $(this).remove();
                                        });
                                    });
                                }

                                $(fixLayout());

                                $(makeContents);
                                $(makeFigures);
                                $(fixNotes);
                                $(highlightAuthors);

                                $(window).scroll(function () {
                                    checkScroll();
                                });

                            </script>                            <div class="c-reading-companion__panel c-reading-companion__sections" id="tabpanel-sections" aria-labelledby="tab-sections" role="tabpanel" aria-hidden="true">
                                <div class="article-contents c-reading-companion__scroll-pane" style="overflow-y: auto; max-height: 80vh;">
                                </div>
                            </div>
                            <div class="c-reading-companion__panel c-reading-companion__sections" id="tabpanel-figures" aria-labelledby="tab-sections" role="tabpanel" aria-hidden="true">
                                <div class="article-figures c-reading-companion__scroll-pane" style="overflow-y: auto; max-height: 80vh; display: none">
                                </div>
                            </div>
                            <div class="c-reading-companion__panel c-reading-companion__sections" id="tabpanel-literature" aria-labelledby="tab-sections" role="tabpanel" aria-hidden="true">
                                <div class="article-literature c-reading-companion__scroll-pane" style="overflow-y: auto; max-height: 80vh; display: none">
                                </div>
                            </div>
    
                            </div>
                        </div>
                    </div>
                </div>
    </section>
        </div>
    </main>

    
