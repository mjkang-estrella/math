ng="eng" authority="umu" xlink:href="2199"><topic>Mathematical Statistics</topic><genre>Research subject</genre></subject><subject lang="swe" authority="umu" xlink:href="2199"><topic>matematisk statistik</topic><genre>Research subject</genre></subject><abstract lang="eng">&lt;p&gt;A central limit theorem for strong mixing sequences is given that applies to both non-stationary sequences and triangular array settings. The result improves on an earlier central limit theorem for this type of dependence given by Politis, Romano and Wolf in 1997.&lt;/p&gt;</abstract><relatedItem type="host"><titleInfo><title>Statistics and Probability Letters</title></titleInfo><identifier type="issn">0167-7152</identifier><identifier type="eissn">1879-2103</identifier><part><detail type="volume"><number>94</number></detail><extent><start>236</start><end>238</end></extent></part></relatedItem><note type="publicationStatus" lang="eng">Published</note><recordInfo><recordOrigin>maek0021</recordOrigin><recordContentSource>umu</recordContentSource><recordCreationDate>2014-08-24</recordCreationDate><recordChangeDate>2024-07-02</recordChangeDate><recordIdentifier>diva2:740293</recordIdentifier></recordInfo></mods></modsCollection>