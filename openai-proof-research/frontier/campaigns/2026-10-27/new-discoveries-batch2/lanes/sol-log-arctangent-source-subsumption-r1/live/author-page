    function openDabarImport($article_group, $bibirb_id) {
        switch($article_group) {
          case "Uredničke knjige":
            var type = "knjige";
            break;
          case "Autorske knjige":
            var type = "knjige";
            break;
          case "Poglavlja u knjigama":
            var type = "puk";
            break;
          case "Radovi u časopisima":
            var type = "clanci";
            break;
          case "Radovi u zbornicima skupova":
            var type = "ruz";
            break;
          case "Sažeci sa skupova":
            var type = "ins";
            break;
          default:
            var type = "unknown"
        }

        if (type !== "unknown") {
            var url = "https://repozitorij.fer.unizg.hr/pohrana/" + type + "?es=crosbi&es_id=" + $bibirb_id;
            var win = window.open(url, '_blank');
            win.focus();
        } else {
            alert("Type not supported for automatical import to DABAR. Please enter it manually.");
        }
    }
</script>
