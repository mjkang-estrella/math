    <script>
    document.addEventListener("DOMContentLoaded", () => {
        const portfolios = Array.from(document.querySelectorAll(".portlet_portfolio"));
        const ispisEl = document.getElementById("ispis");
        const popisEl = document.getElementById("popis");
        const naslovEl = document.getElementById("naslov");
        const djelatnikNameEl = document.getElementById("djelatnik_name");
        const scrollBtn = document.getElementById("scroll");

        if (!ispisEl || !popisEl || !naslovEl || !djelatnikNameEl || !scrollBtn) return;

        // If edit UI exists, disable chooser block
        const hasPortfolioEdit = document.querySelector(".portfolio-edit") !== null;
        if (hasPortfolioEdit) {
            ispisEl.style.display = "none";
            naslovEl.style.display = "none";
        }

        // If there is 0 or 1 portfolio -> no chooser UI, no hiding.
        if (portfolios.length <= 1) {
            ispisEl.style.display = "none";
            naslovEl.style.display = "none";
            scrollBtn.style.display = "none";
            return;
        }

        // Helpers
        const hideAll = () => portfolios.forEach(p => (p.style.display = "none"));
        const showOne = (index1based, {scrollIntoView = true} = {}) => {
            const idx = Number(index1based) - 1;
            if (!Number.isInteger(idx) || idx < 0 || idx >= portfolios.length) return;

            hideAll();
            const el = portfolios[idx];
            el.style.display = "";

            if (scrollIntoView) {
                el.scrollIntoView({behavior: "smooth", block: "start"});
            }
        };

        const extractBaseName = (fullTitle) => {
            let s = (fullTitle || "").trim();
            s = s.split(",")[0] || s;
            s = s.split(".").pop().trim();
            return s.trim();
        };

        // If edit UI exists, DO NOT do chooser logic (do not hide all + do not build list)
        if (hasPortfolioEdit) {
            // Find the portfolio that contains the edit UI
            const editPortfolio = document.querySelector(".portfolio-edit")?.closest(".portlet_portfolio");

            // Hide all other portfolios, keep only the one with edit UI visible
            portfolios.forEach((p) => {
                if (editPortfolio && p !== editPortfolio) {
                    p.style.display = "none";
                } else {
                    // Keep the edit one visible (or if for some reason not found, keep all visible)
                    p.style.display = "";
                }
            });

            // Hide chooser block
            ispisEl.style.display = "none";
            naslovEl.style.display = "none";

            // Optional: keep scroll-to-top hidden in edit mode
            scrollBtn.style.display = "none";

            return;
        }

        // --- normal chooser logic ---
        popisEl.innerHTML = "";
        ispisEl.classList.add("ispis");

        portfolios.forEach((portfolio, i) => {
            const titleBlock = portfolio.querySelector(".titleBlock");
            const h3 = titleBlock?.querySelector("h3");
            const p = titleBlock?.querySelector("p");

            const fullName = (h3?.textContent || "").replace(/\s+/g, " ").trim();
            const dept = (p?.textContent || "").replace(/\s+/g, " ").trim();

            const index = i + 1;
            portfolio.dataset.personIndex = String(index);

            const li = document.createElement("li");
            const a = document.createElement("a");
            a.href = `#${index}`;
            a.style.display = "block";
            a.textContent = dept ? `${fullName}, ${dept}` : fullName;

            a.addEventListener("click", (e) => {
                e.preventDefault();
                window.location.hash = String(index);
                showOne(index, {scrollIntoView: true});
            });

            li.appendChild(a);
            popisEl.appendChild(li);
        });

        const firstTitle = portfolios[0].querySelector(".titleBlock h3")?.textContent || "";
        const baseName = extractBaseName(firstTitle);
        djelatnikNameEl.textContent = baseName ? `${baseName}:` : "";

        hideAll();
        naslovEl.style.display = "block";
        ispisEl.style.display = "block";

        const hash = (window.location.hash || "").replace("#", "").trim();
        if (hash) {
            const n = Number(hash);
            if (Number.isInteger(n) && n >= 1 && n <= portfolios.length) {
                ispisEl.style.display = "none";
                showOne(n, {scrollIntoView: false});
            }
        }

        const updateScrollBtn = () => {
            scrollBtn.style.display = (window.scrollY > 100) ? "block" : "none";
        };
        updateScrollBtn();
        window.addEventListener("scroll", updateScrollBtn, {passive: true});

        scrollBtn.addEventListener("click", (e) => {
            e.preventDefault();
            window.scrollTo({top: 0, behavior: "smooth"});
        });
    });
    </script>



