<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex22.m1" class="ltx_Math" alttext="\displaystyle\displaystyle\quad\phi(p^{m-1})x^{1+\phi(p^{2m})+\phi(p^{2m-1})+\dots+\phi(p^{m+3})}+\phi(p^{m})x^{1+\phi(p^{2m})+\phi(p^{2m-1})+\dots+\phi(p^{m+2})}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>p</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>p</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>p</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi mathvariant="normal">⋯</mi><mo>+</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>p</mi><mrow><mi>m</mi><mo>+</mo><mn>3</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><mo>+</mo><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>p</mi><mi>m</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mrow><mn>1</mn><mo>+</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>p</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>p</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi mathvariant="normal">⋯</mi><mo>+</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>p</mi><mrow><mi>m</mi><mo>+</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle\quad\phi(p^{m-1})x^{1+\phi(p^{2m})+\phi(p^{2m-1})+\dots+\phi(p^{m+3})}+\phi(p^{m})x^{1+\phi(p^{2m})+\phi(p^{2m-1})+\dots+\phi(p^{m+2})}</annotation></semantics></math></td>
