.900em">(</mo><mrow><mi mathsize="0.900em">q</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle|V_{r}|=(p-1)(q-1)</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g style="--ltx-fill-color:#E0FFE0;" fill="#E0FFE0" stroke-width="0.8pt"><path d="M -131.89 -86.61 C -131.89 -73.02 -160.97 -62.01 -196.85 -62.01 C -232.73 -62.01 -261.81 -73.02 -261.81 -86.61 C -261.81 -100.2 -232.73 -111.22 -196.85 -111.22 C -160.97 -111.22 -131.89 -100.2 -131.89 -86.61 Z M -196.85 -86.61"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 -232.19 -95.52)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 24.04)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.51)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 24.4 0)"><foreignObject style="--ltx-fo-width:1.71em;--ltx-fo-height:0.66em;--ltx-fo-depth:0.24em;font-size:9.25pt;" height="11.59" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="21.89"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F4.pic1.m7" class="ltx_Math" alttext="\displaystyle V_{pq}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">V</mi><mrow><mi mathsize="0.900em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">q</mi></mrow></msub><annotation encoding="application/x-tex">\displaystyle V_{pq}</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 20.93)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:5.52em;--ltx-fo-height:0.73em;--ltx-fo-depth:0.24em;font-size:9.25pt;" height="12.45" overflow="visible" transform="matrix(