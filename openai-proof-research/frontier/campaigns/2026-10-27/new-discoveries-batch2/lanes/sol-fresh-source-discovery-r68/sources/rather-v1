<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex102.m1" class="ltx_Math" alttext="H(y)=-1+y^{a}+y^{bc}+y^{c(b-a)+b}-y^{c(b-a)}+y^{b(c-a)+c}-y^{b(c-a)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>+</mo><msup><mi>y</mi><mi>a</mi></msup><mo>+</mo><msup><mi>y</mi><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msup><mo>+</mo><msup><mi>y</mi><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo>−</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>b</mi></mrow></msup></mrow><mo>−</mo><msup><mi>y</mi><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo>−</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo>+</mo><msup><mi>y</mi><mrow><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>−</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi></mrow></msup></mrow><mo>−</mo><msup><mi>y</mi><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>−</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H(y)=-1+y^{a}+y^{bc}+y^{c(b-a)+b}-y^{c(b-a)}+y^{b(c-a)+c}-y^{b(c-a)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p5.3" class="ltx_p">We first prove that <math id="S4.p5.m17" class="ltx_Math" alttext="\displaystyle H(y)" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle H(y)</annotation></semantics></math> has no zeros in <math id="S4.p5.m18" class="ltx_Math" alttext="\displaystyle|y|\leq\tfrac{1}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>y</mi><mo stretchy="false">|</mo></mrow><mo>≤</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">\displaystyle|y|\leq\tfrac{1}{2}</annotation></semantics></math>. On the circle <math id="S4.p5.m19" class="ltx_Math" alttext="\displaystyle|y|=\tfrac{1}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>y</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">\displaystyle|y|=\tfrac{1}{2}</annotation></semantics></math>, we write
<math id="S4.p5.m20" class="ltx_Math" alttext="\displaystyle H(y)=-1+S(y)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>+</mo><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle H(y)=-1+S(y),</annotation></semantics></math>
where</p>
<table id="S4.Ex103" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex103.m1" class="ltx_Math" alttext="S(y)=y^{a}+y^{bc}+y^{c(b-a)+b}-y^{c(b-a)}+y^{b(c-a)+c}-y^{b(c-a)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mrow><msup><mi>y</mi><mi>a</mi></msup><mo>+</mo><msup><mi>y</mi><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msup><mo>+</mo><msup><mi>y</mi><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo>−</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>b</mi></mrow></msup></mrow><mo>−</mo><msup><mi>y</mi><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo>−</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo>+</mo><msup><mi>y</mi><mrow><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>−</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi></mrow></msup></mrow><mo>−</mo><msup><mi>y</mi><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>−</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">S(y)=y^{a}+y^{bc}+y^{c(b-a)+b}-y^{c(b-a)}+y^{b(c-a)+c}-y^{b(c-a)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p5.4" class="ltx_p">Since <math id="S4.p5.m21" class="ltx_Math" alttext="\displaystyle a\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\displaystyle a\geq 1</annotation></semantics></math>, <math id="S4.p5.m22" class="ltx_Math" alttext="\displaystyle bc\geq 8" display="inline" intent=":literal"><semantics><mrow><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>≥</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">\displaystyle bc\geq 8</annotation></semantics></math>, <math id="S4.p5.m23" class="ltx_Math" alttext="\displaystyle c(b-a)\geq 4" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo>−</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">\displaystyle c(b-a)\geq 4</annotation></semantics></math>, <math id="S4.p5.m24" class="ltx_Math" alttext="\displaystyle c(b-a)+b\geq 6" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo>−</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>b</mi></mrow><mo>≥</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">\displaystyle c(b-a)+b\geq 6</annotation></semantics></math>, <math id="S4.p5.m25" class="ltx_Math" alttext="\displaystyle b(c-a)\geq 6" display="inline" intent=":literal"><semantics><mrow><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>−</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">\displaystyle b(c-a)\geq 6</annotation></semantics></math>, and <math id="S4.p5.m26" class="ltx_Math" alttext="\displaystyle b(c-a)+c\geq 10" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>−</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi></mrow><mo>≥</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">\displaystyle b(c-a)+c\geq 10</annotation></semantics></math>, we have</p>
<table id="S4.Ex104" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex104.m1" class="ltx_Math" alttext="|S(y)|\leq 2^{-a}+2^{-bc}+2^{-(c(b-a)+b)}+2^{-c(b-a)}+2^{-(b(c-a)+c)}+2^{-b(c-a)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><msup><mn>2</mn><mrow><mo>−</mo><mi>a</mi></mrow></msup><mo>+</mo><msup><mn>2</mn><mrow><mo>−</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></mrow></msup><mo>+</mo><msup><mn>2</mn><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo>−</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo>+</mo><msup><mn>2</mn><mrow><mo>−</mo><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo>−</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo>+</mo><msup><mn>2</mn><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>−</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo>+</mo><msup><mn>2</mn><mrow><mo>−</mo><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>−</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|S(y)|\leq 2^{-a}+2^{-bc}+2^{-(c(b-a)+b)}+2^{-c(b-a)}+2^{-(b(c-a)+c)}+2^{-b(c-a)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p5.5" class="ltx_p">Thus,</p>
<table id="S4.Ex105" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex105.m1" class="ltx_Math" alttext="|S(y)|\leq\frac{1}{2}+\frac{1}{256}+\frac{1}{64}+\frac{1}{16}+\frac{1}{1024}+\frac{1}{64}&lt;1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>+</mo><mfrac><mn>1</mn><mn>256</mn></mfrac><mo>+</mo><mfrac><mn>1</mn><mn>64</mn></mfrac><mo>+</mo><mfrac><mn>1</mn><mn>16</mn></mfrac><mo>+</mo><mfrac><mn>1</mn><mn>1024</mn></mfrac><mo>+</mo><mfrac><mn>1</mn><mn>64</mn></mfrac></mrow><mo>&lt;</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|S(y)|\leq\frac{1}{2}+\frac{1}{256}+\frac{1}{64}+\frac{1}{16}+\frac{1}{1024}+\frac{1}{64}&lt;1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p5.6" class="ltx_p">Hence, on <math id="S4.p5.m27" class="ltx_Math" alttext="\displaystyle|y|=\tfrac{1}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>y</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">\displaystyle|y|=\tfrac{1}{2}</annotation></semantics></math>, we have
<math id="S4.p5.m28" class="ltx_Math" alttext="\displaystyle|S(y)|&lt;|-1|=1." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><mrow><mo stretchy="false">|</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle|S(y)|&lt;|-1|=1.</annotation></semantics></math>
By Rouché’s theorem, <math id="S4.p5.m29" class="ltx_Math" alttext="\displaystyle H(y)" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle H(y)</annotation></semantics></math> and the constant polynomial <math id="S4.p5.m30" class="ltx_Math" alttext="\displaystyle-1" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\displaystyle-1</annotation></semantics></math> have the same number of zeros in <math id="S4.p5.m31" class="ltx_Math" alttext="\displaystyle|y|&lt;\tfrac{1}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>y</mi><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">\displaystyle|y|&lt;\tfrac{1}{2}</annotation></semantics></math>. Therefore, <math id="S4.p5.m32" class="ltx_Math" alttext="\displaystyle H(y)" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle H(y)</annotation></semantics></math> has no zeros in <math id="S4.p5.m33" class="ltx_Math" alttext="\displaystyle|y|&lt;\tfrac{1}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>y</mi><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">\displaystyle|y|&lt;\tfrac{1}{2}</annotation></semantics></math>. The strict inequality also shows that <math id="S4.p5.m34" class="ltx_Math" alttext="\displaystyle H(y)\neq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle H(y)\neq 0</annotation></semantics></math> on <math id="S4.p5.m35" class="ltx_Math" alttext="\displaystyle|y|=\tfrac{1}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>y</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">\displaystyle|y|=\tfrac{1}{2}</annotation></semantics></math>. Hence, every zero of <math id="S4.p5.m36" class="ltx_Math" alttext="\displaystyle H(y)" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle H(y)</annotation></semantics></math> satisfies
<math id="S4.p5.m37" class="ltx_Math" alttext="\displaystyle|y|&gt;\tfrac{1}{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mi>y</mi><mo stretchy="false">|</mo></mrow><mo>&gt;</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle|y|&gt;\tfrac{1}{2}.</annotation></semantics></math> Next, we prove that every zero of <math id="S4.p5.m38" class="ltx_Math" alttext="\displaystyle H(y)" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle H(y)</annotation></semantics></math> satisfies <math id="S4.p5.m39" class="ltx_Math" alttext="\displaystyle|y|&lt;2" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>y</mi><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\displaystyle|y|&lt;2</annotation></semantics></math>. Let
<math id="S4.p5.m40" class="ltx_Math" alttext="\displaystyle H(y)=\sum_{j=0}^{d}c_{j}y^{j}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mi>d</mi></munderover></mstyle><mrow><msub><mi>c</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mi>j</mi></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle H(y)=\sum_{j=0}^{d}c_{j}y^{j},</annotation></semantics></math>
where <math id="S4.p5.m41" class="ltx_Math" alttext="\displaystyle d=\deg H" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mrow><mi>deg</mi><mo lspace="0.167em">⁡</mo><mi>H</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle d=\deg H</annotation></semantics></math> and <math id="S4.p5.m42" class="ltx_Math" alttext="\displaystyle c_{d}\neq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>d</mi></msub><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle c_{d}\neq 0</annotation></semantics></math>. We claim that
<math id="S4.p5.m43" class="ltx_Math" alttext="\displaystyle|c_{j}|\leq|c_{d}|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi>c</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mo stretchy="false">|</mo><msub><mi>c</mi><mi>d</mi></msub><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle|c_{j}|\leq|c_{d}|</annotation></semantics></math>, for all <math id="S4.p5.m44" class="ltx_Math" alttext="\displaystyle 0\leq j&lt;d." display="inline" intent=":literal"><semantics><mrow><mrow><mn>0</mn><mo>≤</mo><mi>j</mi><mo>&lt;</mo><mi>d</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle 0\leq j&lt;d.</annotation></semantics></math>
Clearly, the only possible coincidence between two positive exponents in
<math id="S4.p5.m45" class="ltx_Math" alttext="\displaystyle a,bc,c(b-a)+b," display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>,</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>,</mo><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo>−</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>b</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle a,bc,c(b-a)+b,</annotation></semantics></math> and <math id="S4.p5.m46" class="ltx_Math" alttext="\displaystyle b(c-a)+c" display="inline" intent=":literal"><semantics><mrow><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>−</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">\displaystyle b(c-a)+c</annotation></semantics></math>
is
<math id="S4.p5.m47" class="ltx_Math" alttext="\displaystyle bc=b(c-a)+c," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo>=</mo><mrow><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>−</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>c</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle bc=b(c-a)+c,</annotation></semantics></math>
which is equivalent to <math id="S4.p5.m48" class="ltx_Math" alttext="\displaystyle c=ab" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>=</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle c=ab</annotation></semantics></math>. If this occurs, it occurs at the largest exponent and gives the leading coefficient <math id="S4.p5.m49" class="ltx_Math" alttext="\displaystyle c_{d}=2" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>d</mi></msub><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\displaystyle c_{d}=2</annotation></semantics></math>. Otherwise the leading coefficient has modulus <math id="S4.p5.m50" class="ltx_Math" alttext="\displaystyle 1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">\displaystyle 1</annotation></semantics></math>. The two negative exponents <math id="S4.p5.m51" class="ltx_Math" alttext="\displaystyle c(b-a)" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo>−</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle c(b-a)</annotation></semantics></math> and <math id="S4.p5.m52" class="ltx_Math" alttext="\displaystyle b(c-a)" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>−</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle b(c-a)</annotation></semantics></math> are distinct, and any coincidence between a positive and a negative exponent only causes cancellation. Therefore, every non-leading coefficient has modulus at most <math id="S4.p5.m53" class="ltx_Math" alttext="\displaystyle 1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">\displaystyle 1</annotation></semantics></math>, while the leading coefficient has modulus either <math id="S4.p5.m54" class="ltx_Math" alttext="\displaystyle 1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">\displaystyle 1</annotation></semantics></math> or <math id="S4.p5.m55" class="ltx_Math" alttext="\displaystyle 2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">\displaystyle 2</annotation></semantics></math>. Now, let
<math id="S4.p5.m56" class="ltx_Math" alttext="\displaystyle H(y)=c_{d}y^{d}+R(y)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>c</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mi>d</mi></msup></mrow><mo>+</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle H(y)=c_{d}y^{d}+R(y),</annotation></semantics></math>
where
<math id="S4.p5.m57" class="ltx_Math" alttext="\displaystyle R(y)=\sum_{j=0}^{d-1}c_{j}y^{j}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>c</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mi>j</mi></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle R(y)=\sum_{j=0}^{d-1}c_{j}y^{j}.</annotation></semantics></math>
On the circle <math id="S4.p5.m58" class="ltx_Math" alttext="\displaystyle|y|=2" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>y</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\displaystyle|y|=2</annotation></semantics></math>, we have</p>
<table id="S4.Ex106" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex106.m1" class="ltx_Math" alttext="|R(y)|\leq\sum_{j=0}^{d-1}|c_{j}|2^{j}\leq|c_{d}|\sum_{j=0}^{d-1}2^{j}=|c_{d}|(2^{d}-1)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo rspace="0.111em">≤</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><mrow><mo stretchy="false">|</mo><msub><mi>c</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mi>j</mi></msup></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><mo fence="false">|</mo><mrow><msub><mi>c</mi><mi>d</mi></msub><mo fence="false" rspace="0.111em">|</mo><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></munderover><msup><mn>2</mn><mi>j</mi></msup></mrow><mo>=</mo><mphantom></mphantom></mrow><mo fence="false">|</mo><mrow><msub><mi>c</mi><mi>d</mi></msub><mo fence="false">|</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mn>2</mn><mi>d</mi></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">|R(y)|\leq\sum_{j=0}^{d-1}|c_{j}|2^{j}\leq|c_{d}|\sum_{j=0}^{d-1}2^{j}=|c_{d}|(2^{d}-1),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p5.7" class="ltx_p">and hence
<math id="S4.p5.m59" class="ltx_Math" alttext="\displaystyle|R(y)|&lt;|c_{d}|2^{d}=|c_{d}y^{d}|." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>c</mi><mi>d</mi></msub><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mn>2</mn><mi>d</mi></msup></mrow><mo>=</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>c</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mi>d</mi></msup></mrow><mo stretchy="false">|</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle|R(y)|&lt;|c_{d}|2^{d}=|c_{d}y^{d}|.</annotation></semantics></math>
By Rouché’s theorem, <math id="S4.p5.m60" class="ltx_Math" alttext="\displaystyle H(y)" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle H(y)</annotation></semantics></math> and <math id="S4.p5.m61" class="ltx_Math" alttext="\displaystyle c_{d}y^{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\displaystyle c_{d}y^{d}</annotation></semantics></math> have the same number of zeros in <math id="S4.p5.m62" class="ltx_Math" alttext="\displaystyle|y|&lt;2" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>y</mi><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\displaystyle|y|&lt;2</annotation></semantics></math>, counted with multiplicity. Since <math id="S4.p5.m63" class="ltx_Math" alttext="\displaystyle H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">\displaystyle H</annotation></semantics></math> has degree <math id="S4.p5.m64" class="ltx_Math" alttext="\displaystyle d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">\displaystyle d</annotation></semantics></math>, all zeros of <math id="S4.p5.m65" class="ltx_Math" alttext="\displaystyle H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">\displaystyle H</annotation></semantics></math> lie in <math id="S4.p5.m66" class="ltx_Math" alttext="\displaystyle|y|&lt;2" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>y</mi><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\displaystyle|y|&lt;2</annotation></semantics></math>. The strict inequality also excludes zeros on <math id="S4.p5.m67" class="ltx_Math" alttext="\displaystyle|y|=2" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>y</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\displaystyle|y|=2</annotation></semantics></math>.
Combining the two facts, every zero <math id="S4.p5.m68" class="ltx_Math" alttext="\displaystyle y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">\displaystyle y</annotation></semantics></math> of <math id="S4.p5.m69" class="ltx_Math" alttext="\displaystyle H(y)" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle H(y)</annotation></semantics></math> satisfies
<math id="S4.p5.m70" class="ltx_Math" alttext="\displaystyle\tfrac{1}{2}&lt;|y|&lt;2." display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>&lt;</mo><mrow><mo stretchy="false">|</mo><mi>y</mi><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><mn>2</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\tfrac{1}{2}&lt;|y|&lt;2.</annotation></semantics></math>
Thus, with <math id="S4.p5.m71" class="ltx_Math" alttext="\displaystyle y=1+x" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle y=1+x</annotation></semantics></math>, every zero <math id="S4.p5.m72" class="ltx_Math" alttext="\displaystyle x\neq-1" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>≠</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\displaystyle x\neq-1</annotation></semantics></math> of <math id="S4.p5.m73" class="ltx_Math" alttext="\displaystyle I(\varGamma(\mathbb{Z}_{pqr}),x)" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ℤ</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle I(\varGamma(\mathbb{Z}_{pqr}),x)</annotation></semantics></math> satisfies
<math id="S4.p5.m74" class="ltx_Math" alttext="\displaystyle\tfrac{1}{2}&lt;|1+x|&lt;2." display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>&lt;</mo><mrow><mo stretchy="false">|</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><mn>2</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\tfrac{1}{2}&lt;|1+x|&lt;2.</annotation></semantics></math>
 <span class="ltx_rule" style="width:5.7pt;height:5.7pt;--ltx-bg-color:black;display:inline-block;"> </span></p>
