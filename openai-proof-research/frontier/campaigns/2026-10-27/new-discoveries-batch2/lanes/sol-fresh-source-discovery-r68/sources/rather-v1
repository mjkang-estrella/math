em;--ltx-fo-depth:0.24em;font-size:9.25pt;" height="11.59" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="21.63"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F4.pic1.m11" class="ltx_Math" alttext="\displaystyle V_{qr}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">V</mi><mrow><mi mathsize="0.900em">q</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">r</mi></mrow></msub><annotation encoding="application/x-tex">\displaystyle V_{qr}</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 20.93)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:5.52em;--ltx-fo-height:0.73em;--ltx-fo-depth:0.24em;font-size:9.25pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.34)" width="70.72"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F4.pic1.m12" class="ltx_Math" alttext="\displaystyle|V_{qr}|=p-1" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo><msub><mi mathsize="0.900em">V</mi><mrow><mi mathsize="0.900em">q</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">r</mi></mrow></msub><mo maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo></mrow><mo mathsize="0.900em">=</mo><mrow><mi mathsize="0.900em">p</mi><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">1</mn></mrow></mrow><annotation encoding="application/x-tex">\displaystyle|V_{qr}|=p-1</annotation></semantics></math></span></span></foreignObject></g></g></g></g><g style="--ltx-fill-color:#000000;" fill="#000000"><g stroke-width="0.8pt"><path style="fill:none" d="M -125.24 35.44 L 150.22 -68.94"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M 0 69.33 L 0 -53.58"></path></g><g stroke-width="0.8pt"><path style="fill:none"