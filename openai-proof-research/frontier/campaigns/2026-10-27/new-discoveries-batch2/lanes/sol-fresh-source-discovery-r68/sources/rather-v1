"fill:none" d="M 224.86 -39.87 L 90.1 -139.26"></path></g><g style="--ltx-stroke-color:#FF0000;--ltx-fill-color:#FF0000;--ltx-fg-color:#FF0000;" color="#FF0000" fill="#FF0000" stroke="#FF0000"><path style="fill:none" d="M 222.75 -74.53 L 92.21 -33.74"></path></g><g style="--ltx-stroke-color:#FF0000;--ltx-fill-color:#FF0000;--ltx-fg-color:#FF0000;" color="#FF0000" fill="#FF0000" stroke="#FF0000"><path style="fill:none" d="M 223.29 -84.4 L 91.67 -141.98"></path></g><g style="--ltx-stroke-color:#FF0000;--ltx-fill-color:#FF0000;--ltx-fg-color:#FF0000;" color="#FF0000" fill="#FF0000" stroke="#FF0000"><path style="fill:none" d="M 224.18 -118.61 L 90.78 -36.9"></path></g><g style="--ltx-stroke-color:#FF0000;--ltx-fill-color:#FF0000;--ltx-fg-color:#FF0000;" color="#FF0000" fill="#FF0000" stroke="#FF0000"><path style="fill:none" d="M 222.24 -127.91 L 92.72 -145.72"></path></g><g style="--ltx-stroke-color:#FF0000;--ltx-fill-color:#FF0000;--ltx-fg-color:#FF0000;" color="#FF0000" fill="#FF0000" stroke="#FF0000"><path style="fill:none" d="M 225.79 -163.71 L 89.17 -39.04"></path></g><g style="--ltx-stroke-color:#FF0000;--ltx-fill-color:#FF0000;--ltx-fg-color:#FF0000;" color="#FF0000" fill="#FF0000" stroke="#FF0000"><path style="fill:none" d="M 222.29 -170.96 L 92.67 -149.9"></path></g></g><g style="--ltx-stroke-color:#008000;--ltx-fill-color:#008000;--ltx-fg-color:#008000;" color="#008000" fill="#008000" stroke="#008000" stroke-width="0.8pt"><path style="fill:none" d="M 78.74 -43.64 L 78.74 -133.52"></path></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 2: </span>Zero divisor graph of <math id="S3.F2.m2" class="ltx_Math" alttext="\displaystyle\mathbb{Z}_{45}." display="inline" intent=":literal"><semantics><mrow><msub><mi>ℤ</mi><mn>45</mn></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{Z}_{45}.</annotation></semantics></math></figcaption>
</figure>
<div id="S3.p4" class="ltx_para">
<p id="S3.p4.1" class="ltx_p">We compute <math id="S3.p4.m1" class="ltx_Math" alttext="\displaystyle I(G,x)" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle I(G,x)</annotation></semantics></math> by considering the composition of an arbitrary independent set <math id="S3.p4.m2" class="ltx_Math" alttext="\displaystyle S\subseteq V" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⊆</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">\displaystyle S\subseteq V</annotation></semantics></math> with respect to the partition <math id="S3.p4.m3" class="ltx_Math" alttext="\displaystyle V_{15}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mn>15</mn></msub><annotation encoding="application/x-tex">\displaystyle V_{15}</annotation></semantics></math>. With <math id="S3.p4.m4" class="ltx_Math" alttext="\displaystyle V_{15}=\{v_{a},v_{b}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mn>15</mn></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>v</mi><mi>a</mi></msub><mo>,</mo><msub><mi>v</mi><mi>b</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle V_{15}=\{v_{a},v_{b}\}</annotation></semantics></math>, and consider the case <math id="S3.p4.m5" class="ltx_Math" alttext="\displaystyle S\cap V_{15}=\emptyset" display="inline" intent=":literal"><semantics><mrow><mrow><mi>S</mi><mo>∩</mo><msub><mi>V</mi><mn>15</mn></msub></mrow><mo>=</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\displaystyle S\cap V_{15}=\emptyset</annotation></semantics></math>.
An independent set <math id="S3.p4.m6" class="ltx_Math" alttext="\displaystyle S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">\displaystyle S</annotation></semantics></math> is a subset of <math id="S3.p4.m7" class="ltx_Math" alttext="\displaystyle V_{3}\cup V_{5}\cup V_{9}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mn>3</mn></msub><mo>∪</mo><msub><mi>V</mi><mn>5</mn></msub><mo>∪</mo><msub><mi>V</mi><mn>9</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle V_{3}\cup V_{5}\cup V_{9}</annotation></semantics></math>. The subgraph induced by these vertices, <math id="S3.p4.m8" class="ltx_Math" alttext="\displaystyle G[V_{3}\cup V_{5}\cup V_{9}]" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>V</mi><mn>3</mn></msub><mo>∪</mo><msub><mi>V</mi><mn>5</mn></msub><mo>∪</mo><msub><mi>V</mi><mn>9</mn></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle G[V_{3}\cup V_{5}\cup V_{9}]</annotation></semantics></math>, consists of the disjoint union of an empty graph on <math id="S3.p4.m9" class="ltx_Math" alttext="\displaystyle V_{3}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mn>3</mn></msub><annotation encoding="application/x-tex">\displaystyle V_{3}</annotation></semantics></math> (8 vertices) and the complete bipartite graph <math id="S3.p4.m10" class="ltx_Math" alttext="\displaystyle K_{6,4}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mrow><mn>6</mn><mo>,</mo><mn>4</mn></mrow></msub><annotation encoding="application/x-tex">\displaystyle K_{6,4}</annotation></semantics></math> on <math id="S3.p4.m11" class="ltx_Math" alttext="\displaystyle V_{5}\cup V_{9}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mn>5</mn></msub><mo>∪</mo><msub><mi>V</mi><mn>9</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle V_{5}\cup V_{9}</annotation></semantics></math>. The independence polynomial for this case is the product of the polynomials for these two components:</p>
<table id="S3.Ex48" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex48.m1" class="ltx_Math" alttext="I(\overline{K}_{8},x)\cdot I(K_{6,4},x)=(1+x)^{8}\left((1+x)^{6}+(1+x)^{4}-1\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>K</mi><mo stretchy="true">¯</mo></mover><mn>8</mn></msub><mo>,</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>K</mi><mrow><mn>6</mn><mo>,</mo><mn>4</mn></mrow></msub><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mn>8</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mn>6</mn></msup><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mn>4</mn></msup></mrow><mo>−</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">I(\overline{K}_{8},x)\cdot I(K_{6,4},x)=(1+x)^{8}\left((1+x)^{6}+(1+x)^{4}-1\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.p5" class="ltx_para">
<p id="S3.p5.1" class="ltx_p">Next, we consider <math id="S3.p5.m1" class="ltx_Math" alttext="\displaystyle S\cap V_{15}\neq\emptyset" display="inline" intent=":literal"><semantics><mrow><mrow><mi>S</mi><mo>∩</mo><msub><mi>V</mi><mn>15</mn></msub></mrow><mo>≠</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\displaystyle S\cap V_{15}\neq\emptyset</annotation></semantics></math>. As <math id="S3.p5.m2" class="ltx_Math" alttext="\displaystyle v_{a}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>a</mi></msub><annotation encoding="application/x-tex">\displaystyle v_{a}</annotation></semantics></math> and <math id="S3.p5.m3" class="ltx_Math" alttext="\displaystyle v_{b}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>b</mi></msub><annotation encoding="application/x-tex">\displaystyle v_{b}</annotation></semantics></math> are adjacent, an independent set <math id="S3.p5.m4" class="ltx_Math" alttext="\displaystyle S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">\displaystyle S</annotation></semantics></math> can contain at most one of them.
If <math id="S3.p5.m5" class="ltx_Math" alttext="\displaystyle v_{a}\in S" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi>a</mi></msub><mo>∈</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">\displaystyle v_{a}\in S</annotation></semantics></math>, then <math id="S3.p5.m6" class="ltx_Math" alttext="\displaystyle S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">\displaystyle S</annotation></semantics></math> cannot contain any neighbor of <math id="S3.p5.m7" class="ltx_Math" alttext="\displaystyle v_{a}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>a</mi></msub><annotation encoding="application/x-tex">\displaystyle v_{a}</annotation></semantics></math>. The neighborhood of <math id="S3.p5.m8" class="ltx_Math" alttext="\displaystyle v_{a}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>a</mi></msub><annotation encoding="application/x-tex">\displaystyle v_{a}</annotation></semantics></math> is <math id="S3.p5.m9" class="ltx_Math" alttext="\displaystyle V_{3}\cup V_{9}\cup\{v_{b}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mn>3</mn></msub><mo>∪</mo><msub><mi>V</mi><mn>9</mn></msub><mo>∪</mo><mrow><mo stretchy="false">{</mo><msub><mi>v</mi><mi>b</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle V_{3}\cup V_{9}\cup\{v_{b}\}</annotation></semantics></math>. Thus, <math id="S3.p5.m10" class="ltx_Math" alttext="\displaystyle S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">\displaystyle S</annotation></semantics></math> must be of the form <math id="S3.p5.m11" class="ltx_Math" alttext="\displaystyle\{v_{a}\}\cup S^{\prime}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><msub><mi>v</mi><mi>a</mi></msub><mo stretchy="false">}</mo></mrow><mo>∪</mo><msup><mi>S</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">\displaystyle\{v_{a}\}\cup S^{\prime}</annotation></semantics></math>, where <math id="S3.p5.m12" class="ltx_Math" alttext="\displaystyle S^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\displaystyle S^{\prime}</annotation></semantics></math> is an independent set in the remaining vertices, which is <math id="S3.p5.m13" class="ltx_Math" alttext="\displaystyle V_{5}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mn>5</mn></msub><annotation encoding="application/x-tex">\displaystyle V_{5}</annotation></semantics></math>. Since <math id="S3.p5.m14" class="ltx_Math" alttext="\displaystyle V_{5}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mn>5</mn></msub><annotation encoding="application/x-tex">\displaystyle V_{5}</annotation></semantics></math> is an independent set of size <math id="S3.p5.m15" class="ltx_Math" alttext="\displaystyle 6" display="inline" intent=":literal"><semantics><mn>6</mn><annotation encoding="application/x-tex">\displaystyle 6</annotation></semantics></math>, so <math id="S3.p5.m16" class="ltx_Math" alttext="\displaystyle S^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\displaystyle S^{\prime}</annotation></semantics></math> can be any subset of <math id="S3.p5.m17" class="ltx_Math" alttext="\displaystyle V_{5}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mn>5</mn></msub><annotation encoding="application/x-tex">\displaystyle V_{5}</annotation></semantics></math>. The generating function for such sets <math id="S3.p5.m18" class="ltx_Math" alttext="\displaystyle S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">\displaystyle S</annotation></semantics></math> is <math id="S3.p5.m19" class="ltx_Math" alttext="\displaystyle x\cdot\sum_{k=0}^{6}\binom{6}{k}x^{k}=x(1+x)^{6}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mn>6</mn></munderover></mstyle><mrow><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mn>6</mn><mi>k</mi></mfrac></mstyle><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mi>k</mi></msup></mrow></mrow></mrow><mo>=</mo><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mn>6</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle x\cdot\sum_{k=0}^{6}\binom{6}{k}x^{k}=x(1+x)^{6}</annotation></semantics></math>.
Again, if <math id="S3.p5.m20" class="ltx_Math" alttext="\displaystyle v_{b}\in S" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi>b</mi></msub><mo>∈</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">\displaystyle v_{b}\in S</annotation></semantics></math>, with the same idea, the neighborhood of <math id="S3.p5.m21" class="ltx_Math" alttext="\displaystyle v_{b}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>b</mi></msub><annotation encoding="application/x-tex">\displaystyle v_{b}</annotation></semantics></math> is <math id="S3.p5.m22" class="ltx_Math" alttext="\displaystyle V_{3}\cup V_{9}\cup\{v_{a}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mn>3</mn></msub><mo>∪</mo><msub><mi>V</mi><mn>9</mn></msub><mo>∪</mo><mrow><mo stretchy="false">{</mo><msub><mi>v</mi><mi>a</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle V_{3}\cup V_{9}\cup\{v_{a}\}</annotation></semantics></math>, and the contribution such subsets to the independence polynomial of <math id="S3.p5.m23" class="ltx_Math" alttext="\displaystyle G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">\displaystyle G</annotation></semantics></math> is also <math id="S3.p5.m24" class="ltx_Math" alttext="\displaystyle x(1+x)^{6}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mn>6</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle x(1+x)^{6}</annotation></semantics></math>. Summing, all these case, we get the independence polynomial of <math id="S3.p5.m25" class="ltx_Math" alttext="\displaystyle G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">\displaystyle G</annotation></semantics></math> as given below</p>
<table id="S3.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex49"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex49.m1" class="ltx_Math" alttext="\displaystyle\displaystyle I(G,x)=" display="inline" intent=":literal"><semantics><mrow><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle I(G,x)=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex49.m2" class="ltx_Math" alttext="\displaystyle\displaystyle(1+x)^{8}\left((1+x)^{6}+(1+x)^{4}-1\right)+x(1+x)^{6}+x(1+x)^{6}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mn>8</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mn>6</mn></msup><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mn>4</mn></msup></mrow><mo>−</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mn>6</mn></msup></mrow><mo>+</mo><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mn>6</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle(1+x)^{8}\left((1+x)^{6}+(1+x)^{4}-1\right)+x(1+x)^{6}+x(1+x)^{6}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex50.m1" class="ltx_Math" alttext="\displaystyle\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex50.m2" class="ltx_Math" alttext="\displaystyle\displaystyle(1+x)^{8}(1+x)^{6}+(1+x)^{8}(1+x)^{4}-(1+x)^{8}+2x(1+x)^{6}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mn>8</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mn>6</mn></msup></mrow><mo>+</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mn>8</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mn>4</mn></msup></mrow></mrow><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mn>8</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mn>6</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle(1+x)^{8}(1+x)^{6}+(1+x)^{8}(1+x)^{4}-(1+x)^{8}+2x(1+x)^{6}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex51"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex51.m1" class="ltx_Math" alttext="\displaystyle\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex51.m2" class="ltx_Math" alttext="\displaystyle\displaystyle(1+x)^{14}+(1+x)^{12}-(1+x)^{8}+2x(1+x)^{6}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mn>14</mn></msup><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mn>12</mn></msup></mrow><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mn>8</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mn>6</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\displaystyle(1+x)^{14}+(1+x)^{12}-(1+x)^{8}+2x(1+x)^{6}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.p6" class="ltx_para">
<p id="S3.p6.1" class="ltx_p">Next, we show that independence polynomial of <math id="S3.p6.m1" class="ltx_Math" alttext="\displaystyle\varGamma(\mathbb{Z}_{p^{2}q})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ℤ</mi><mrow><msup><mi>p</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\varGamma(\mathbb{Z}_{p^{2}q})</annotation></semantics></math> is log-concave and unimodal.</p>
</div>
<div id="S3.Thmtheorem2" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem2.2" class="ltx_text ltx_font_bold">Theorem 3.2</span></span><span id="S3.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem2.p1" class="ltx_para">
<p id="S3.Thmtheorem2.p1.1" class="ltx_p"><span id="S3.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">For primes <math id="S3.Thmtheorem2.p1.m1" class="ltx_Math" alttext="\displaystyle p&lt;q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">\displaystyle p&lt;q</annotation></semantics></math>, he independence polynomial</span></p>
<table id="S3.Ex52" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex52.m1" class="ltx_Math" alttext="I(\varGamma(\mathbb{Z}_{p^{2}q});x)=(1+x)^{(p-1)(p+q-1)}+(1+x)^{p(q-1)}-(1+x)^{(p-1)(q-1)}+(p-1)x(1+x)^{p(p-1)}" display="block" intent=":literal"><semantics><mrow><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ℤ</mi><mrow><msup><mi>p</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>p</mi><mo>+</mo><mi>q</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">I(\varGamma(\mathbb{Z}_{p^{2}q});x)=(1+x)^{(p-1)(p+q-1)}+(1+x)^{p(q-1)}-(1+x)^{(p-1)(q-1)}+(p-1)x(1+x)^{p(p-1)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.Thmtheorem2.p1.2" class="ltx_p"><span id="S3.Thmtheorem2.p1.2.1" class="ltx_text ltx_font_italic">is log-concave and unimodal.</span></p>
</div>
</div>
<div id="S3.p7" class="ltx_para ltx_noindent">
<p id="S3.p7.1" class="ltx_p"><span id="S3.p7.1.1" class="ltx_text ltx_font_bold">Proof.</span>
For brevity, we let
<math id="S3.p7.m1" class="ltx_Math" alttext="\displaystyle a=(p-1)(q-p-1),b=q-1,c=p(p-1)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>a</mi><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><mi>b</mi><mo>=</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo>,</mo><mrow><mi>c</mi><mo>=</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle a=(p-1)(q-p-1),b=q-1,c=p(p-1),</annotation></semantics></math> and <math id="S3.p7.m2" class="ltx_Math" alttext="\displaystyle d=p-1." display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo>=</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle d=p-1.</annotation></semantics></math>
Since <math id="S3.p7.m3" class="ltx_Math" alttext="\displaystyle p&lt;q" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">\displaystyle p&lt;q</annotation></semantics></math>, we have <math id="S3.p7.m4" class="ltx_Math" alttext="\displaystyle a\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle a\geq 0</annotation></semantics></math>, <math id="S3.p7.m5" class="ltx_Math" alttext="\displaystyle b\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\displaystyle b\geq 2</annotation></semantics></math>, <math id="S3.p7.m6" class="ltx_Math" alttext="\displaystyle c\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\displaystyle c\geq 2</annotation></semantics></math>, and <math id="S3.p7.m7" class="ltx_Math" alttext="\displaystyle d\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\displaystyle d\geq 1</annotation></semantics></math>. It is easy to see that
<math id="S3.p7.m8" class="ltx_Math" alttext="\displaystyle I(\varGamma(\mathbb{Z}_{p^{2}q});x)=(1+x)^{c}H_{p,q}(x)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ℤ</mi><mrow><msup><mi>p</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mi>c</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>H</mi><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle I(\varGamma(\mathbb{Z}_{p^{2}q});x)=(1+x)^{c}H_{p,q}(x),</annotation></semantics></math>
where</p>
<table id="S3.Ex53" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex53.m1" class="ltx_Math" alttext="H_{p,q}(x)=(1+x)^{a}\left((1+x)^{b}+(1+x)^{c}-1\right)+dx." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>H</mi><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mi>b</mi></msup><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mi>c</mi></msup></mrow><mo>−</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">H_{p,q}(x)=(1+x)^{a}\left((1+x)^{b}+(1+x)^{c}-1\right)+dx.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p7.2" class="ltx_p">Clearly,
<math id="S3.p7.m9" class="ltx_Math" alttext="\displaystyle c+a+c=(p-1)(p+q-1),c+a+b=p(q-1)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>c</mi><mo>+</mo><mi>a</mi><mo>+</mo><mi>c</mi></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>p</mi><mo>+</mo><mi>q</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><mrow><mi>c</mi><mo>+</mo><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo>=</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle c+a+c=(p-1)(p+q-1),c+a+b=p(q-1),</annotation></semantics></math>
and
<math id="S3.p7.m10" class="ltx_Math" alttext="\displaystyle c+a=(p-1)(q-1)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>c</mi><mo>+</mo><mi>a</mi></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle c+a=(p-1)(q-1).</annotation></semantics></math>
We shall use the following standard fact: if two polynomials have non-negative log-concave coefficient sequences with no internal zeros, then their product also has a log-concave coefficient sequence. This is the usual convolution property of log-concave sequences <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib33" title="" class="ltx_ref">33</a>]</cite>. Further, we note that
<math id="S3.p7.m11" class="ltx_Math" alttext="\displaystyle(1+x)^{m}+(1+x)^{n}-1" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mi>m</mi></msup><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mi>n</mi></msup></mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\displaystyle(1+x)^{m}+(1+x)^{n}-1</annotation></semantics></math>
has a log-concave coefficient sequence for all positive integers <math id="S3.p7.m12" class="ltx_Math" alttext="\displaystyle m,n" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>,</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">\displaystyle m,n</annotation></semantics></math>. Its coefficients are</p>
<table id="S3.Ex54" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex54.m1" class="ltx_Math" alttext="1,\quad\binom{m}{1}+\binom{n}{1},\quad\binom{m}{2}+\binom{n}{2},\quad\ldots," display="block" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo rspace="1.167em">,</mo><mrow><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>m</mi><mn>1</mn></mfrac><mo>)</mo></mrow><mo>+</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>n</mi><mn>1</mn></mfrac><mo>)</mo></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>m</mi><mn>2</mn></mfrac><mo>)</mo></mrow><mo>+</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>n</mi><mn>2</mn></mfrac><mo>)</mo></mrow></mrow><mo rspace="1.167em">,</mo><mi mathvariant="normal">…</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">1,\quad\binom{m}{1}+\binom{n}{1},\quad\binom{m}{2}+\binom{n}{2},\quad\ldots,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p7.3" class="ltx_p">where <math id="S3.p7.m13" class="ltx_Math" alttext="\displaystyle\binom{r}{k}=0" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mi>r</mi><mi>k</mi></mfrac></mstyle><mo>)</mo></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle\binom{r}{k}=0</annotation></semantics></math> for <math id="S3.p7.m14" class="ltx_Math" alttext="\displaystyle k&gt;r" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>&gt;</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">\displaystyle k&gt;r</annotation></semantics></math>, and the log-concavity follows by the usual binomial-ratio verification.
Let
<math id="S3.p7.m15" class="ltx_Math" alttext="\displaystyle J_{p,q}(x)=(1+x)^{a}\left((1+x)^{b}+(1+x)^{c}-1\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>J</mi><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mi>b</mi></msup><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mi>c</mi></msup></mrow><mo>−</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle J_{p,q}(x)=(1+x)^{a}\left((1+x)^{b}+(1+x)^{c}-1\right).</annotation></semantics></math>
The polynomial <math id="S3.p7.m16" class="ltx_Math" alttext="\displaystyle(1+x)^{a}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mi>a</mi></msup><annotation encoding="application/x-tex">\displaystyle(1+x)^{a}</annotation></semantics></math> is log-concave, and by the preceding observation, the polynomial <math id="S3.p7.m17" class="ltx_Math" alttext="\displaystyle(1+x)^{b}+(1+x)^{c}-1" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mi>b</mi></msup><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mi>c</mi></msup></mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\displaystyle(1+x)^{b}+(1+x)^{c}-1</annotation></semantics></math> is log-concave. Hence, <math id="S3.p7.m18" class="ltx_Math" alttext="\displaystyle J_{p,q}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>J</mi><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle J_{p,q}(x)</annotation></semantics></math> is log-concave. Let
<math id="S3.p7.m19" class="ltx_Math" alttext="\displaystyle J_{p,q}(x)=\sum_{k\geq 0}u_{k}x^{k}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>J</mi><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>≥</mo><mn>0</mn></mrow></munder></mstyle><mrow><msub><mi>u</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mi>k</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle J_{p,q}(x)=\sum_{k\geq 0}u_{k}x^{k}</annotation></semantics></math>
and
<math id="S3.p7.m20" class="ltx_Math" alttext="\displaystyle H_{p,q}(x)=\sum_{k\geq 0}h_{k}x^{k}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>H</mi><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>≥</mo><mn>0</mn></mrow></munder></mstyle><mrow><msub><mi>h</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mi>k</mi></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle H_{p,q}(x)=\sum_{k\geq 0}h_{k}x^{k}.</annotation></semantics></math>
Since <math id="S3.p7.m21" class="ltx_Math" alttext="\displaystyle H_{p,q}(x)=J_{p,q}(x)+dx" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>H</mi><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>J</mi><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle H_{p,q}(x)=J_{p,q}(x)+dx</annotation></semantics></math>, we have
<math id="S3.p7.m22" class="ltx_Math" alttext="\displaystyle h_{0}=u_{0}=1,h_{1}=u_{1}+d," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>h</mi><mn>0</mn></msub><mo>=</mo><msub><mi>u</mi><mn>0</mn></msub><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mrow><msub><mi>h</mi><mn>1</mn></msub><mo>=</mo><mrow><msub><mi>u</mi><mn>1</mn></msub><mo>+</mo><mi>d</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle h_{0}=u_{0}=1,h_{1}=u_{1}+d,</annotation></semantics></math> and <math id="S3.p7.m23" class="ltx_Math" alttext="\displaystyle h_{k}=u_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mi>k</mi></msub><mo>=</mo><msub><mi>u</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle h_{k}=u_{k}</annotation></semantics></math> for <math id="S3.p7.m24" class="ltx_Math" alttext="\displaystyle k\geq 2." display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>≥</mo><mn>2</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle k\geq 2.</annotation></semantics></math>
Therefore, all log-concavity inequalities for <math id="S3.p7.m25" class="ltx_Math" alttext="\displaystyle H_{p,q}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle H_{p,q}(x)</annotation></semantics></math> are inherited from <math id="S3.p7.m26" class="ltx_Math" alttext="\displaystyle J_{p,q}(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>J</mi><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle J_{p,q}(x)</annotation></semantics></math> except possibly the inequalities centered at <math id="S3.p7.m27" class="ltx_Math" alttext="\displaystyle h_{1}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\displaystyle h_{1}</annotation></semantics></math> and <math id="S3.p7.m28" class="ltx_Math" alttext="\displaystyle h_{2}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle h_{2}</annotation></semantics></math>. Thus, it remains to verify
<math id="S3.p7.m29" class="ltx_Math" alttext="\displaystyle h_{1}^{2}\geq h_{0}h_{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>h</mi><mn>1</mn><mn>2</mn></msubsup><mo>≥</mo><mrow><msub><mi>h</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle h_{1}^{2}\geq h_{0}h_{2}</annotation></semantics></math>
and
<math id="S3.p7.m30" class="ltx_Math" alttext="\displaystyle h_{2}^{2}\geq h_{1}h_{3}." display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>h</mi><mn>2</mn><mn>2</mn></msubsup><mo>≥</mo><mrow><msub><mi>h</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mn>3</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle h_{2}^{2}\geq h_{1}h_{3}.</annotation></semantics></math>
Since
<math id="S3.p7.m31" class="ltx_Math" alttext="\displaystyle H_{p,q}(x)=(1+x)^{a}\left((1+x)^{b}+(1+x)^{c}-1\right)+dx," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>H</mi><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mi>a</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mi>b</mi></msup><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mi>c</mi></msup></mrow><mo>−</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle H_{p,q}(x)=(1+x)^{a}\left((1+x)^{b}+(1+x)^{c}-1\right)+dx,</annotation></semantics></math>
we get
<math id="S3.p7.m32" class="ltx_Math" alttext="\displaystyle h_{0}=1," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>h</mi><mn>0</mn></msub><mo>=</mo><mn>1</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle h_{0}=1,</annotation></semantics></math> and <math id="S3.p7.m33" class="ltx_Math" alttext="\displaystyle h_{1}=a+b+c+d=pq-1." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>h</mi><mn>1</mn></msub><mo>=</mo><mrow><mi>a</mi><mo>+</mo><mi>b</mi><mo>+</mo><mi>c</mi><mo>+</mo><mi>d</mi></mrow><mo>=</mo><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>−</mo><mn>1</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle h_{1}=a+b+c+d=pq-1.</annotation></semantics></math> For <math id="S3.p7.m34" class="ltx_Math" alttext="\displaystyle k\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\displaystyle k\geq 2</annotation></semantics></math>, the term <math id="S3.p7.m35" class="ltx_Math" alttext="\displaystyle dx" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><annotation encoding="application/x-tex">\displaystyle dx</annotation></semantics></math> does not contribute, so
<math id="S3.p7.m36" class="ltx_Math" alttext="\displaystyle h_{k}=\binom{a+c}{k}+\binom{a+b}{k}-\binom{a}{k}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>h</mi><mi>k</mi></msub><mo>=</mo><mrow><mrow><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mrow><mi>a</mi><mo>+</mo><mi>c</mi></mrow><mi>k</mi></mfrac></mstyle><mo>)</mo></mrow><mo>+</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mi>k</mi></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac linethickness="0pt"><mi>a</mi><mi>k</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle h_{k}=\binom{a+c}{k}+\binom{a+b}{k}-\binom{a}{k}.</annotation></semantics></math>
In particular,</p>
<table id="S3.Ex55" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex55.m1" class="ltx_Math" alttext="h_{2}=\binom{(p-1)(q-1)}{2}+\binom{p(q-p)}{2}-\binom{(p-1)(q-p-1)}{2}=\frac{p(q-1)(pq-3p+1)}{2}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>h</mi><mn>2</mn></msub><mo>=</mo><mrow><mrow><mrow><mo>(</mo><mfrac linethickness="0pt"><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></mfrac><mo>)</mo></mrow><mo>+</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></mfrac><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></mfrac><mo>)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>−</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">h_{2}=\binom{(p-1)(q-1)}{2}+\binom{p(q-p)}{2}-\binom{(p-1)(q-p-1)}{2}=\frac{p(q-1)(pq-3p+1)}{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p7.4" class="ltx_p">Similarly,</p>
<table id="S3.Ex56" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex56.m1" class="ltx_Math" alttext="h_{3}=\binom{(p-1)(q-1)}{3}+\binom{p(q-p)}{3}-\binom{(p-1)(q-p-1)}{3}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>h</mi><mn>3</mn></msub><mo>=</mo><mrow><mrow><mrow><mo>(</mo><mfrac linethickness="0pt"><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>3</mn></mfrac><mo>)</mo></mrow><mo>+</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>3</mn></mfrac><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>3</mn></mfrac><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">h_{3}=\binom{(p-1)(q-1)}{3}+\binom{p(q-p)}{3}-\binom{(p-1)(q-p-1)}{3},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p7.5" class="ltx_p">and hence</p>
<table id="S3.Ex57" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex57.m1" class="ltx_Math" alttext="h_{3}=\frac{p(q-1)}{6}\left(3p^{3}+p^{2}q^{2}-8p^{2}q+p^{2}+6pq+3p-3q-1\right)." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>h</mi><mn>3</mn></msub><mo>=</mo><mrow><mfrac><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>6</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mn>3</mn></msup></mrow><mo>+</mo><mrow><msup><mi>p</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mn>2</mn></msup></mrow></mrow><mo>−</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow><mo>+</mo><msup><mi>p</mi><mn>2</mn></msup><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></mrow><mo>−</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">h_{3}=\frac{p(q-1)}{6}\left(3p^{3}+p^{2}q^{2}-8p^{2}q+p^{2}+6pq+3p-3q-1\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p7.6" class="ltx_p">We first prove <math id="S3.p7.m37" class="ltx_Math" alttext="\displaystyle h_{1}^{2}\geq h_{0}h_{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>h</mi><mn>1</mn><mn>2</mn></msubsup><mo>≥</mo><mrow><msub><mi>h</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle h_{1}^{2}\geq h_{0}h_{2}</annotation></semantics></math>, and with <math id="S3.p7.m38" class="ltx_Math" alttext="\displaystyle h_{0}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>h</mi><mn>0</mn></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\displaystyle h_{0}=1</annotation></semantics></math>, it is equivalent to <math id="S3.p7.m39" class="ltx_Math" alttext="\displaystyle h_{1}^{2}\geq h_{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>h</mi><mn>1</mn><mn>2</mn></msubsup><mo>≥</mo><msub><mi>h</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle h_{1}^{2}\geq h_{2}</annotation></semantics></math>. Using the expressions above, we have</p>
<table id="S3.Ex58" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex58.m1" class="ltx_Math" alttext="h_{1}^{2}-h_{2}=(pq-1)^{2}-\frac{p(q-1)(pq-3p+1)}{2}=\frac{p^{2}q^{2}+4p^{2}q-3p^{2}-5pq+p+2}{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>h</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msub><mi>h</mi><mn>2</mn></msub></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>−</mo><mfrac><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>−</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></mfrac></mrow><mo>=</mo><mfrac><mrow><mrow><mrow><mrow><msup><mi>p</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow><mo>−</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mn>2</mn></msup></mrow><mo>−</mo><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow><mo>+</mo><mi>p</mi><mo>+</mo><mn>2</mn></mrow><mn>2</mn></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">h_{1}^{2}-h_{2}=(pq-1)^{2}-\frac{p(q-1)(pq-3p+1)}{2}=\frac{p^{2}q^{2}+4p^{2}q-3p^{2}-5pq+p+2}{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p7.7" class="ltx_p">To see that this is positive, let <math id="S3.p7.m40" class="ltx_Math" alttext="\displaystyle q=p+s" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><mrow><mi>p</mi><mo>+</mo><mi>s</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle q=p+s</annotation></semantics></math>, where <math id="S3.p7.m41" class="ltx_Math" alttext="\displaystyle s\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\displaystyle s\geq 1</annotation></semantics></math>, and let <math id="S3.p7.m42" class="ltx_Math" alttext="\displaystyle p=u+2,s=v+1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>=</mo><mrow><mi>u</mi><mo>+</mo><mn>2</mn></mrow></mrow><mo>,</mo><mrow><mi>s</mi><mo>=</mo><mrow><mi>v</mi><mo>+</mo><mn>1</mn></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle p=u+2,s=v+1</annotation></semantics></math>, where <math id="S3.p7.m43" class="ltx_Math" alttext="\displaystyle u,v\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>u</mi><mo>,</mo><mi>v</mi></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle u,v\geq 0</annotation></semantics></math>. Thus,</p>
<table id="S3.Ex59" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex59.m1" class="ltx_Math" alttext="2(h_{1}^{2}-h_{2})=u^{4}+2u^{3}v+14u^{3}+u^{2}v^{2}+18u^{2}v+57u^{2}+4uv^{2}+43uv+88u+4v^{2}+30v+46." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>h</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msub><mi>h</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>u</mi><mn>4</mn></msup><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>+</mo><mrow><mn>14</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mn>3</mn></msup></mrow><mo>+</mo><mrow><msup><mi>u</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>18</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>+</mo><mrow><mn>57</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>43</mn><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>+</mo><mrow><mn>88</mn><mo lspace="0em" rspace="0em">​</mo><mi>u</mi></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>30</mn><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>+</mo><mn>46</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">2(h_{1}^{2}-h_{2})=u^{4}+2u^{3}v+14u^{3}+u^{2}v^{2}+18u^{2}v+57u^{2}+4uv^{2}+43uv+88u+4v^{2}+30v+46.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p7.8" class="ltx_p">Every term on the right-hand side is non-negative, and the constant term is positive. So, we obtain
<math id="S3.p7.m44" class="ltx_Math" alttext="\displaystyle h_{1}^{2}-h_{0}h_{2}=h_{1}^{2}-h_{2}&gt;0." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>h</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><mrow><msub><mi>h</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mn>2</mn></msub></mrow></mrow><mo>=</mo><mrow><msubsup><mi>h</mi><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msub><mi>h</mi><mn>2</mn></msub></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle h_{1}^{2}-h_{0}h_{2}=h_{1}^{2}-h_{2}&gt;0.</annotation></semantics></math> It remains to prove <math id="S3.p7.m45" class="ltx_Math" alttext="\displaystyle h_{2}^{2}\geq h_{1}h_{3}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>h</mi><mn>2</mn><mn>2</mn></msubsup><mo>≥</mo><mrow><msub><mi>h</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mn>3</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle h_{2}^{2}\geq h_{1}h_{3}</annotation></semantics></math>. With values of <math id="S3.p7.m46" class="ltx_Math" alttext="\displaystyle h_{1}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\displaystyle h_{1}</annotation></semantics></math>, <math id="S3.p7.m47" class="ltx_Math" alttext="\displaystyle h_{2}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle h_{2}</annotation></semantics></math>, and <math id="S3.p7.m48" class="ltx_Math" alttext="\displaystyle h_{3}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mn>3</mn></msub><annotation encoding="application/x-tex">\displaystyle h_{3}</annotation></semantics></math>, we obtain</p>
<table id="S3.Ex60" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex60.m1" class="ltx_Math" alttext="h_{2}^{2}-h_{1}h_{3}=\frac{p(q-1)}{12}\Phi(p,q-p)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>h</mi><mn>2</mn><mn>2</mn></msubsup><mo>−</mo><mrow><msub><mi>h</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>h</mi><mn>3</mn></msub></mrow></mrow><mo>=</mo><mrow><mfrac><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>12</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Φ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mrow><mi>q</mi><mo>−</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">h_{2}^{2}-h_{1}h_{3}=\frac{p(q-1)}{12}\Phi(p,q-p),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p7.9" class="ltx_p">where, if <math id="S3.p7.m49" class="ltx_Math" alttext="\displaystyle s=q-p" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>=</mo><mrow><mi>q</mi><mo>−</mo><mi>p</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle s=q-p</annotation></semantics></math>, then</p>
<table id="S3.Ex61" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S3.Ex61X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex61X.m2" class="ltx_Math" alttext="\displaystyle\Phi(p,s)=" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\Phi(p,s)=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex61X.m3" class="ltx_Math" alttext="\displaystyle p^{6}+3p^{5}s-11p^{5}+3p^{4}s^{2}-16p^{4}s+39p^{4}+p^{3}s^{3}-5p^{3}s^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mrow><msup><mi>p</mi><mn>6</mn></msup><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mn>5</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><mo>−</mo><mrow><mn>11</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mn>5</mn></msup></mrow></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>s</mi><mn>2</mn></msup></mrow></mrow><mo>−</mo><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><mo>+</mo><mrow><mn>39</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mn>4</mn></msup></mrow><mo>+</mo><mrow><msup><mi>p</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>s</mi><mn>3</mn></msup></mrow></mrow><mo>−</mo><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>s</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle p^{6}+3p^{5}s-11p^{5}+3p^{4}s^{2}-16p^{4}s+39p^{4}+p^{3}s^{3}-5p^{3}s^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex61Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex61Xa.m2" class="ltx_Math" alttext="\displaystyle+35p^{3}s-61p^{3}-4p^{2}s^{2}-34p^{2}s+37p^{2}+6ps^{2}+17ps-3p-6s-2." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mo>+</mo><mrow><mn>35</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><mo>−</mo><mrow><mn>61</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mn>3</mn></msup></mrow><mo>−</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>s</mi><mn>2</mn></msup></mrow><mo>−</mo><mrow><mn>34</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><mo>+</mo><mrow><mn>37</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>s</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>17</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><mo>−</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo>−</mo><mn>2</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+35p^{3}s-61p^{3}-4p^{2}s^{2}-34p^{2}s+37p^{2}+6ps^{2}+17ps-3p-6s-2.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p7.10" class="ltx_p">Let <math id="S3.p7.m50" class="ltx_Math" alttext="\displaystyle p=u+2" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mrow><mi>u</mi><mo>+</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">\displaystyle p=u+2</annotation></semantics></math> and <math id="S3.p7.m51" class="ltx_Math" alttext="\displaystyle s=v+1" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>=</mo><mrow><mi>v</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\displaystyle s=v+1</annotation></semantics></math>, where <math id="S3.p7.m52" class="ltx_Math" alttext="\displaystyle u,v\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>u</mi><mo>,</mo><mi>v</mi></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle u,v\geq 0</annotation></semantics></math>. Then</p>
<table id="S3.Ex62" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S3.Ex62X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex62X.m2" class="ltx_Math" alttext="\displaystyle\Phi(p,s)=" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\Phi(p,s)=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex62X.m3" class="ltx_Math" alttext="\displaystyle u^{6}+3u^{5}v+4u^{5}+3u^{4}v^{2}+20u^{4}v+6u^{4}+u^{3}v^{3}+22u^{3}v^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>u</mi><mn>6</mn></msup><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mn>5</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mn>5</mn></msup></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>20</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mn>4</mn></msup></mrow><mo>+</mo><mrow><msup><mi>u</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mn>3</mn></msup></mrow><mo>+</mo><mrow><mn>22</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle u^{6}+3u^{5}v+4u^{5}+3u^{4}v^{2}+20u^{4}v+6u^{4}+u^{3}v^{3}+22u^{3}v^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex62Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
