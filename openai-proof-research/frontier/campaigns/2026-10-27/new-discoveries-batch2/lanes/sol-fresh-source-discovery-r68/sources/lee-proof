<p id="S2.Thmtheorem6.p1.2" class="ltx_p"><span id="S2.Thmtheorem6.p1.2.1" class="ltx_text ltx_font_italic">where <math id="S2.Thmtheorem6.p1.m7" class="ltx_Math" alttext="\mathbf{m}_{\tau}" display="inline" intent=":literal"><semantics><msub><mi>𝐦</mi><mi>τ</mi></msub><annotation encoding="application/x-tex">\mathbf{m}_{\tau}</annotation></semantics></math> is the <math id="S2.Thmtheorem6.p1.m8" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>-row of <math id="S2.Thmtheorem6.p1.m9" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>.</span></p>
