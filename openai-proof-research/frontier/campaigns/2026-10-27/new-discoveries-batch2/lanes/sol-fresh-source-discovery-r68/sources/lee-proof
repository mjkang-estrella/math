<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex6.m1" class="ltx_Math" alttext="\displaystyle=(d+1)\sum_{{\bm{\sigma}}\in I^{[d]}}\prod_{uv\in\binom{[d]}{2}}H(\sigma_{u},\sigma_{v})\prod_{v\in[d]}(H(\tau,\sigma_{v})\,x_{\sigma_{v}})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>𝝈</mi><mo>∈</mo><msup><mi>I</mi><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></msup></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∏</mo><mrow><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>∈</mo><mrow><mo>(</mo><mfrac linethickness="0pt"><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow><mn>2</mn></mfrac><mo>)</mo></mrow></mrow></munder></mstyle><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>σ</mi><mi>u</mi></msub><mo>,</mo><msub><mi>σ</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∏</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo>,</mo><msub><mi>σ</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>x</mi><msub><mi>σ</mi><mi>v</mi></msub></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=(d+1)\sum_{{\bm{\sigma}}\in I^{[d]}}\prod_{uv\in\binom{[d]}{2}}H(\sigma_{u},\sigma_{v})\prod_{v\in[d]}(H(\tau,\sigma_{v})\,x_{\sigma_{v}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S2.Ex7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.Ex7.m1" class="ltx_Math" alttext="\displaystyle=(d+1)\,Z_{d}(\mathbf{m}_{\tau}\odot\mathbf{x}).\qed" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>Z</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝐦</mi><mi>τ</mi></msub><mo lspace="0.222em" rspace="0.222em">⊙</mo><mi>𝐱</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em" rspace="0.0835em">.</mo><mo class="ltx_mathvariant_italic" lspace="0.0835em" mathvariant="italic" separator="true">∎</mo></mrow><annotation encoding="application/x-tex">\displaystyle=(d+1)\,Z_{d}(\mathbf{m}_{\tau}\odot\mathbf{x}).\qed</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
