<p id="S4.p9.3" class="ltx_p">By <a href="#S1.Thmtheorem1" title="Theorem 1.1. ‣ 1 Introduction ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">1.1</span></a> together with the fact <math id="S4.p9.m20" class="ltx_Math" alttext="\deg_{G\mathbin{\square}K_{2}}(v,i)=d_{v}+1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>deg</mi><mrow><mi>G</mi><mo lspace="0.222em" rspace="0.222em">□</mo><msub><mi>K</mi><mn>2</mn></msub></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\deg_{G\mathbin{\square}K_{2}}(v,i)=d_{v}+1</annotation></semantics></math> where <math id="S4.p9.m21" class="ltx_Math" alttext="d_{v}\coloneqq\deg_{G}(v)" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>≔</mo><mrow><msub><mi>deg</mi><mi>G</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">d_{v}\coloneqq\deg_{G}(v)</annotation></semantics></math>,</p>
