 lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mi>d</mi></mfrac></msup></mrow><mrow><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow></mfrac><mo>=</mo><mfrac><mrow><msub><mi>B</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>x</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mi>d</mi></mfrac></msup></mrow><mrow><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>x</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{B_{d+1}(x_{d+1}(s))^{\frac{1}{d+1}}}{A_{d+2}(x_{d+1}(s))^{\frac{1}{d+2}}}=\frac{B_{d+1}(\alpha)^{\frac{1}{d+1}}}{A_{d+2}(\alpha)^{\frac{1}{d+2}}}\leq\frac{B_{d}(\lambda)^{\frac{1}{d}}}{A_{d+1}(\lambda)^{\frac{1}{d+1}}}=\frac{B_{d}(x_{d}(s))^{\frac{1}{d}}}{A_{d+1}(x_{d}(s))^{\frac{1}{d+1}}},</annotation></semantics></math></td>
