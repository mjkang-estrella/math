<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex21.m2" class="ltx_Math" alttext="\displaystyle=(1+2(d_{v}+1)\lambda+(d_{v}+1)d_{v}\lambda^{2})^{\frac{1}{d_{v}+1}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow><annotation encoding="application/x-tex">\displaystyle=(1+2(d_{v}+1)\lambda+(d_{v}+1)d_{v}\lambda^{2})^{\frac{1}{d_{v}+1}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex22.m1" class="ltx_Math" alttext="\displaystyle=1+(2\lambda+d_{v}\lambda^{2})-\frac{1}{2}\frac{1}{d_{v}+1}\frac{d_{v}}{d_{v}+1}(2(d_{v}+1)\lambda)^{2}+O(d_{v}^{2}\lambda^{3})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mn>1</mn><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow><mo>+</mo><mrow><msub><mi>d</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mi>d</mi><mi>v</mi></msub><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>d</mi><mi>v</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>3</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=1+(2\lambda+d_{v}\lambda^{2})-\frac{1}{2}\frac{1}{d_{v}+1}\frac{d_{v}}{d_{v}+1}(2(d_{v}+1)\lambda)^{2}+O(d_{v}^{2}\lambda^{3})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex23.m1" class="ltx_Math" alttext="\displaystyle=1+2\lambda-d_{v}\lambda^{2}+O(d_{v}^{2}\lambda^{3})," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mn>1</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow></mrow><mo>−</mo><mrow><msub><mi>d</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>d</mi><mi>v</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>3</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=1+2\lambda-d_{v}\lambda^{2}+O(d_{v}^{2}\lambda^{3}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p9.7" class="ltx_p">so the factors match up to the quadratic terms.
This argument generalises to the following <a href="#S4.Thmtheorem3" title="Theorem 4.3. ‣ 4 More towards ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span></a>, which can be seen as an approximate version of <a href="#S4.Thmtheorem2" title="Conjecture 4.2. ‣ 4 More towards ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Conjecture</span> <span class="ltx_text ltx_ref_tag">4.2</span></a>.</p>
</div>
<div id="S4.Thmtheorem3" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem3.2" class="ltx_text ltx_font_bold">Theorem 4.3</span></span><span id="S4.Thmtheorem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem3.p1" class="ltx_para">
<p id="S4.Thmtheorem3.p1.1" class="ltx_p"><span id="S4.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmtheorem3.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> be a graph, <math id="S4.Thmtheorem3.p1.m2" class="ltx_Math" alttext="q\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">q\geq 1</annotation></semantics></math> be an integer, and <math id="S4.Thmtheorem3.p1.m3" class="ltx_Math" alttext="\bm{\lambda}^{(i)}=(\lambda^{(i)}_{v})_{v\in V(G)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝛌</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msubsup><mi>λ</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\bm{\lambda}^{(i)}=(\lambda^{(i)}_{v})_{v\in V(G)}</annotation></semantics></math>, <math id="S4.Thmtheorem3.p1.m4" class="ltx_Math" alttext="1\leq i\leq q" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">1\leq i\leq q</annotation></semantics></math> be tuples of nonnegative reals. Then</span></p>
<table id="S4.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex24.m1" class="ltx_Math" alttext="Z^{(q)}_{G}(\bm{\lambda}^{(1)},\dots,\bm{\lambda}^{(q)})\geq\prod_{v\in V(G)}\prod_{i=1}^{q}Z_{K_{d_{v}+q}}(\lambda^{(i)}_{v})^{1/(d_{v}+q)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>Z</mi><mi>G</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝀</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>𝝀</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">≥</mo><mrow><munder><mo movablelimits="false" rspace="0em">∏</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>q</mi></munderover><mrow><msub><mi>Z</mi><msub><mi>K</mi><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mi>q</mi></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>λ</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mi>q</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Z^{(q)}_{G}(\bm{\lambda}^{(1)},\dots,\bm{\lambda}^{(q)})\geq\prod_{v\in V(G)}\prod_{i=1}^{q}Z_{K_{d_{v}+q}}(\lambda^{(i)}_{v})^{1/(d_{v}+q)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmtheorem3.p1.2" class="ltx_p"><span id="S4.Thmtheorem3.p1.2.1" class="ltx_text ltx_font_italic">In particular, if <math id="S4.Thmtheorem3.p1.m5" class="ltx_Math" alttext="\max_{v\in V(G),\,1\leq i\leq q}\lambda^{(i)}_{v}=o(1/\Delta(G))" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>max</mi><mrow><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><mn> 1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>q</mi></mrow></mrow></msub><mo lspace="0.167em">⁡</mo><msubsup><mi>λ</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>=</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\max_{v\in V(G),\,1\leq i\leq q}\lambda^{(i)}_{v}=o(1/\Delta(G))</annotation></semantics></math>, as <math id="S4.Thmtheorem3.p1.m6" class="ltx_Math" alttext="\Delta(G)\to\infty" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\Delta(G)\to\infty</annotation></semantics></math>,</span></p>
<table id="S4.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex25.m1" class="ltx_Math" alttext="Z^{(q)}_{G}(\bm{\lambda}^{(1)},\dots,\bm{\lambda}^{(q)})\geq\prod_{v\in V(G)}\biggl(Z^{(q)}_{K_{d_{v}+1}}(\lambda^{(1)}_{v},\dots,\lambda^{(q)}_{v})^{\frac{1}{d_{v}+1}}-o\biggl(\sum_{i=1}^{q}\lambda^{(i)}_{v}\biggr)\biggr)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>Z</mi><mi>G</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝀</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>𝝀</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">≥</mo><mrow><munder><mo movablelimits="false" rspace="0em">∏</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><msubsup><mi>Z</mi><msub><mi>K</mi><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>λ</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>λ</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow><mo>−</mo><mrow><mi>o</mi><mo>⁡</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>q</mi></munderover><msubsup><mi>λ</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Z^{(q)}_{G}(\bm{\lambda}^{(1)},\dots,\bm{\lambda}^{(q)})\geq\prod_{v\in V(G)}\biggl(Z^{(q)}_{K_{d_{v}+1}}(\lambda^{(1)}_{v},\dots,\lambda^{(q)}_{v})^{\frac{1}{d_{v}+1}}-o\biggl(\sum_{i=1}^{q}\lambda^{(i)}_{v}\biggr)\biggr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmtheorem3.p1.3" class="ltx_p"><span id="S4.Thmtheorem3.p1.3.1" class="ltx_text ltx_font_italic">If in addition, for each <math id="S4.Thmtheorem3.p1.m7" class="ltx_Math" alttext="v\in V(G)" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">v\in V(G)</annotation></semantics></math>, <math id="S4.Thmtheorem3.p1.m8" class="ltx_Math" alttext="\lambda^{(1)}_{v}=\dots=\lambda^{(q)}_{v}\eqqcolon\lambda_{v}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>λ</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi mathvariant="normal">⋯</mi><mo>=</mo><msubsup><mi>λ</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>≕</mo><msub><mi>λ</mi><mi>v</mi></msub></mrow><annotation encoding="application/x-tex">\lambda^{(1)}_{v}=\dots=\lambda^{(q)}_{v}\eqqcolon\lambda_{v}</annotation></semantics></math> for all <math id="S4.Thmtheorem3.p1.m9" class="ltx_Math" alttext="1\leq i\leq q" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">1\leq i\leq q</annotation></semantics></math>,</span></p>
<table id="S4.Ex26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex26.m1" class="ltx_Math" alttext="Z^{(q)}_{G}(\bm{\lambda}^{(1)},\dots,\bm{\lambda}^{(q)})\geq\prod_{v\in V(G)}\Bigl(Z^{(q)}_{K_{d_{v}+1}}(\lambda_{v},\dots,\lambda_{v})^{\frac{1}{d_{v}+1}}-O_{q}(d_{v}^{2}\lambda_{v}^{3})\Bigr)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>Z</mi><mi>G</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝀</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>𝝀</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">≥</mo><mrow><munder><mo movablelimits="false" rspace="0em">∏</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msubsup><mi>Z</mi><msub><mi>K</mi><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>v</mi></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>λ</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow><mo>−</mo><mrow><msub><mi>O</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>d</mi><mi>v</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>λ</mi><mi>v</mi><mn>3</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Z^{(q)}_{G}(\bm{\lambda}^{(1)},\dots,\bm{\lambda}^{(q)})\geq\prod_{v\in V(G)}\Bigl(Z^{(q)}_{K_{d_{v}+1}}(\lambda_{v},\dots,\lambda_{v})^{\frac{1}{d_{v}+1}}-O_{q}(d_{v}^{2}\lambda_{v}^{3})\Bigr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.p10" class="ltx_para">
<p id="S4.p10.1" class="ltx_p">In proving <a href="#S4.Thmtheorem3" title="Theorem 4.3. ‣ 4 More towards ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">4.3</span></a>, the most technical part is to extend the aforementioned bijection from <math id="S4.p10.m1" class="ltx_Math" alttext="\mathcal{I}^{(2)}(G)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{I}^{(2)}(G)</annotation></semantics></math> to <math id="S4.p10.m2" class="ltx_Math" alttext="\mathcal{I}(G\mathbin{\square}K_{2})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>G</mi><mo lspace="0.222em" rspace="0.222em">□</mo><msub><mi>K</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{I}(G\mathbin{\square}K_{2})</annotation></semantics></math>. Once we have the bijection, it is straightforward to deduce <a href="#S4.Thmtheorem3" title="Theorem 4.3. ‣ 4 More towards ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">4.3</span></a>, which we omit.</p>
</div>
<div id="S4.Thmtheorem4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem4.2" class="ltx_text ltx_font_bold">Lemma 4.4</span></span><span id="S4.Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem4.p1" class="ltx_para">
<p id="S4.Thmtheorem4.p1.1" class="ltx_p"><span id="S4.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmtheorem4.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> be a graph, <math id="S4.Thmtheorem4.p1.m2" class="ltx_Math" alttext="q\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">q\geq 1</annotation></semantics></math> be an integer, and <math id="S4.Thmtheorem4.p1.m3" class="ltx_Math" alttext="\bm{\lambda}^{(i)}=(\lambda^{(i)}_{v})_{v\in V(G)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝛌</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msubsup><mi>λ</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\bm{\lambda}^{(i)}=(\lambda^{(i)}_{v})_{v\in V(G)}</annotation></semantics></math>, <math id="S4.Thmtheorem4.p1.m4" class="ltx_Math" alttext="1\leq i\leq q" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">1\leq i\leq q</annotation></semantics></math> be tuples of nonnegative reals. Let <math id="S4.Thmtheorem4.p1.m5" class="ltx_Math" alttext="\bm{\lambda}\coloneqq(\lambda^{(i)}_{v})_{(v,i)\in V(G\mathbin{\square}K_{q})}" display="inline" intent=":literal"><semantics><mrow><mi>𝛌</mi><mo>≔</mo><msub><mrow><mo stretchy="false">(</mo><msubsup><mi>λ</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mrow><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>G</mi><mo lspace="0.222em" rspace="0.222em">□</mo><msub><mi>K</mi><mi>q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\bm{\lambda}\coloneqq(\lambda^{(i)}_{v})_{(v,i)\in V(G\mathbin{\square}K_{q})}</annotation></semantics></math>. Then</span></p>
<table id="S4.Ex27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex27.m1" class="ltx_Math" alttext="Z^{(q)}_{G}(\bm{\lambda}^{(1)},\dots,\bm{\lambda}^{(q)})=Z_{G\mathbin{\square}K_{q}}(\bm{\lambda})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>Z</mi><mi>G</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝀</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>𝝀</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>Z</mi><mrow><mi>G</mi><mo lspace="0.222em" rspace="0.222em">□</mo><msub><mi>K</mi><mi>q</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝝀</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Z^{(q)}_{G}(\bm{\lambda}^{(1)},\dots,\bm{\lambda}^{(q)})=Z_{G\mathbin{\square}K_{q}}(\bm{\lambda}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.p11" class="ltx_para">
<p id="S4.p11.1" class="ltx_p">This may be seen as a vertex-weighted version of a particular case of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib8" title="" class="ltx_ref">15</a>, Lemma 3.1]</cite>, which is on <math id="S4.p11.m1" class="ltx_Math" alttext="\hom(G\mathbin{\square}K,H)" display="inline" intent=":literal"><semantics><mrow><mi>hom</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>G</mi><mo lspace="0.222em" rspace="0.222em">□</mo><mi>K</mi></mrow><mo>,</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hom(G\mathbin{\square}K,H)</annotation></semantics></math> for graphs <math id="S4.p11.m2" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>, <math id="S4.p11.m3" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>, and <math id="S4.p11.m4" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>.
It is clear that <a href="#S1.Thmtheorem1" title="Theorem 1.1. ‣ 1 Introduction ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorems</span> <span class="ltx_text ltx_ref_tag">1.1</span></a> and <a href="#S4.Thmtheorem4" title="Lemma 4.4. ‣ 4 More towards ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.4</span></a> imply the first conclusion of <a href="#S4.Thmtheorem3" title="Theorem 4.3. ‣ 4 More towards ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">4.3</span></a>, since each vertex <math id="S4.p11.m5" class="ltx_Math" alttext="(v,i)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(v,i)</annotation></semantics></math> in <math id="S4.p11.m6" class="ltx_Math" alttext="G\mathbin{\square}K_{q}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0.222em" rspace="0.222em">□</mo><msub><mi>K</mi><mi>q</mi></msub></mrow><annotation encoding="application/x-tex">G\mathbin{\square}K_{q}</annotation></semantics></math> has degree <math id="S4.p11.m7" class="ltx_Math" alttext="\deg_{G}(v)+q-1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>deg</mi><mi>G</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>q</mi></mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\deg_{G}(v)+q-1</annotation></semantics></math>.</p>
</div>
<div id="S4.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of <a href="#S4.Thmtheorem4" title="Lemma 4.4. ‣ 4 More towards ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">4.4</span></a>.</h6>
<div id="S4.p12" class="ltx_para">
<p id="S4.p12.1" class="ltx_p"><span id="S4.p12.1.1" class="ltx_text">For each independent set <math id="S4.p12.m1" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi>I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math> of <math id="S4.p12.m2" class="ltx_Math" alttext="G\mathbin{\square}K_{q}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0.222em" rspace="0.222em">□</mo><msub><mi>K</mi><mi>q</mi></msub></mrow><annotation encoding="application/x-tex">G\mathbin{\square}K_{q}</annotation></semantics></math> and <math id="S4.p12.m3" class="ltx_Math" alttext="1\leq i\leq q" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">1\leq i\leq q</annotation></semantics></math>, let</span></p>
<table id="S4.Ex28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex28.m1" class="ltx_Math" alttext="f_{i}(I)\coloneqq\{v\in V(G):(v,i)\in I\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>f</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><mo stretchy="false">{</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>I</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f_{i}(I)\coloneqq\{v\in V(G):(v,i)\in I\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p12.2" class="ltx_p"><span id="S4.p12.2.1" class="ltx_text">We claim that <math id="S4.p12.m4" class="ltx_Math" alttext="I\mapsto(f_{1}(I),\dots,f_{q}(I))" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo stretchy="false">↦</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>f</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">I\mapsto(f_{1}(I),\dots,f_{q}(I))</annotation></semantics></math> is a bijection from <math id="S4.p12.m5" class="ltx_Math" alttext="\mathcal{I}(G\mathbin{\square}K_{q})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>G</mi><mo lspace="0.222em" rspace="0.222em">□</mo><msub><mi>K</mi><mi>q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{I}(G\mathbin{\square}K_{q})</annotation></semantics></math> to <math id="S4.p12.m6" class="ltx_Math" alttext="\mathcal{I}^{(q)}(G)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{I}^{(q)}(G)</annotation></semantics></math>.
First, if <math id="S4.p12.m7" class="ltx_Math" alttext="I\in\mathcal{I}(G\mathbin{\square}K_{q})" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>G</mi><mo lspace="0.222em" rspace="0.222em">□</mo><msub><mi>K</mi><mi>q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">I\in\mathcal{I}(G\mathbin{\square}K_{q})</annotation></semantics></math>, then <math id="S4.p12.m8" class="ltx_Math" alttext="I\cap(V(G)\times\{i\})\in\mathcal{I}(G\mathbin{\square}K_{q})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>I</mi><mo>∩</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">{</mo><mi>i</mi><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>G</mi><mo lspace="0.222em" rspace="0.222em">□</mo><msub><mi>K</mi><mi>q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">I\cap(V(G)\times\{i\})\in\mathcal{I}(G\mathbin{\square}K_{q})</annotation></semantics></math> for each <math id="S4.p12.m9" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, so <math id="S4.p12.m10" class="ltx_Math" alttext="f_{i}(I)=\{v\in V(G):(v,i)\in I\cap(V(G)\times\{i\})\}\in\mathcal{I}(G)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi>I</mi><mo>∩</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">{</mo><mi>i</mi><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{i}(I)=\{v\in V(G):(v,i)\in I\cap(V(G)\times\{i\})\}\in\mathcal{I}(G)</annotation></semantics></math>. Also, if <math id="S4.p12.m11" class="ltx_Math" alttext="f_{i}(I)\cap f_{j}(I)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∩</mo><mrow><msub><mi>f</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{i}(I)\cap f_{j}(I)</annotation></semantics></math> contains a vertex, say <math id="S4.p12.m12" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math>, for some <math id="S4.p12.m13" class="ltx_Math" alttext="i\neq j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≠</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i\neq j</annotation></semantics></math>, then the edge <math id="S4.p12.m14" class="ltx_Math" alttext="(v,i)(v,j)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(v,i)(v,j)</annotation></semantics></math> lies inside <math id="S4.p12.m15" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi>I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math>, a contradiction. Thus, the independent sets <math id="S4.p12.m16" class="ltx_Math" alttext="f_{i}(I)" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f_{i}(I)</annotation></semantics></math>, <math id="S4.p12.m17" class="ltx_Math" alttext="1\leq i\leq q" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">1\leq i\leq q</annotation></semantics></math> are mutually disjoint.</span></p>
</div>
<div id="S4.p13" class="ltx_para">
<p id="S4.p13.1" class="ltx_p"><span id="S4.p13.1.1" class="ltx_text">On the other hand, suppose <math id="S4.p13.m1" class="ltx_Math" alttext="(I_{1},\dots,I_{q})\in\mathcal{I}^{(q)}(G)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>I</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>I</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(I_{1},\dots,I_{q})\in\mathcal{I}^{(q)}(G)</annotation></semantics></math>. Let <math id="S4.p13.m2" class="ltx_math_unparsed" alttext="I\coloneqq\{(v,i):v\in I_{i},1\leq i\leq q\}\subseteq V(G\mathbin{\square}K_{q})" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo>≔</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>i</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mi>v</mi><mo>∈</mo><msub><mi>I</mi><mi>i</mi></msub><mo>,</mo><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>q</mi><mo stretchy="false">}</mo></mrow><mo>⊆</mo><mi>V</mi><mrow><mo stretchy="false">(</mo><mi>G</mi><mo lspace="0.222em" rspace="0.222em">□</mo><msub><mi>K</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">I\coloneqq\{(v,i):v\in I_{i},1\leq i\leq q\}\subseteq V(G\mathbin{\square}K_{q})</annotation></semantics></math>. Then <math id="S4.p13.m3" class="ltx_Math" alttext="f_{i}(I)=I_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>I</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">f_{i}(I)=I_{i}</annotation></semantics></math> for each <math id="S4.p13.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>. Also, <math id="S4.p13.m5" class="ltx_Math" alttext="I\in\mathcal{I}(G\mathbin{\square}K_{q})" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>G</mi><mo lspace="0.222em" rspace="0.222em">□</mo><msub><mi>K</mi><mi>q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">I\in\mathcal{I}(G\mathbin{\square}K_{q})</annotation></semantics></math>; otherwise, <math id="S4.p13.m6" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi>I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math> contains an edge of the form <math id="S4.p13.m7" class="ltx_Math" alttext="(u,i)(v,i)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(u,i)(v,i)</annotation></semantics></math> or <math id="S4.p13.m8" class="ltx_Math" alttext="(u,i)(u,j)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(u,i)(u,j)</annotation></semantics></math> where <math id="S4.p13.m9" class="ltx_Math" alttext="u\neq v" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>≠</mo><mi>v</mi></mrow><annotation encoding="application/x-tex">u\neq v</annotation></semantics></math> and <math id="S4.p13.m10" class="ltx_Math" alttext="i\neq j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≠</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i\neq j</annotation></semantics></math>, where the former induces an edge <math id="S4.p13.m11" class="ltx_Math" alttext="uv" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><annotation encoding="application/x-tex">uv</annotation></semantics></math> lying inside <math id="S4.p13.m12" class="ltx_Math" alttext="I_{i}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>i</mi></msub><annotation encoding="application/x-tex">I_{i}</annotation></semantics></math>, and the latter implies that <math id="S4.p13.m13" class="ltx_Math" alttext="I_{i}\cap I_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><mi>i</mi></msub><mo>∩</mo><msub><mi>I</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">I_{i}\cap I_{j}</annotation></semantics></math> is nonempty.</span></p>
</div>
<div id="S4.p14" class="ltx_para">
<p id="S4.p14.1" class="ltx_p"><span id="S4.p14.1.1" class="ltx_text">Using this bijection,</span></p>
<table id="S4.Ex29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex29.m1" class="ltx_Math" alttext="Z^{(q)}_{G}(\bm{\lambda}^{(1)},\dots,\bm{\lambda}^{(q)})=\sum_{(I_{1},\dots,I_{q})\in\mathcal{I}^{(q)}(G)}\prod_{i=1}^{q}\prod_{v\in I_{i}}\lambda^{(i)}_{v}=\sum_{I\in\mathcal{I}(G\mathbin{\square}K_{q})}\prod_{(v,i)\in I}\lambda^{(i)}_{v}=Z_{G\mathbin{\square}K_{q}}(\bm{\lambda}).\qed" display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>Z</mi><mi>G</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝀</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>𝝀</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mrow><mo stretchy="false">(</mo><msub><mi>I</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>I</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><munderover><mo movablelimits="false" rspace="0em">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>q</mi></munderover><mrow><munder><mo movablelimits="false">∏</mo><mrow><mi>v</mi><mo>∈</mo><msub><mi>I</mi><mi>i</mi></msub></mrow></munder><msubsup><mi>λ</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>I</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>G</mi><mo lspace="0.222em" rspace="0.222em">□</mo><msub><mi>K</mi><mi>q</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><munder><mo movablelimits="false">∏</mo><mrow><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>I</mi></mrow></munder><msubsup><mi>λ</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo>=</mo><mrow><msub><mi>Z</mi><mrow><mi>G</mi><mo lspace="0.222em" rspace="0.222em">□</mo><msub><mi>K</mi><mi>q</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝝀</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em" rspace="0.0835em">.</mo><mo class="ltx_mathvariant_italic" lspace="0.0835em" mathvariant="italic" separator="true">∎</mo></mrow><annotation encoding="application/x-tex">Z^{(q)}_{G}(\bm{\lambda}^{(1)},\dots,\bm{\lambda}^{(q)})=\sum_{(I_{1},\dots,I_{q})\in\mathcal{I}^{(q)}(G)}\prod_{i=1}^{q}\prod_{v\in I_{i}}\lambda^{(i)}_{v}=\sum_{I\in\mathcal{I}(G\mathbin{\square}K_{q})}\prod_{(v,i)\in I}\lambda^{(i)}_{v}=Z_{G\mathbin{\square}K_{q}}(\bm{\lambda}).\qed</annotation></semantics></math></td>
