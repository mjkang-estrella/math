<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex3.m1" class="ltx_Math" alttext="Z^{(2)-}_{G\setminus w}(\bm{\lambda}^{\prime},\bm{\mu}^{\prime})=\prod_{v\in N(w)}Z^{(2)}_{K_{d_{v}}}(\lambda_{v},\mu_{v})^{\frac{1}{d_{v}}}\prod_{v\in V(G)\setminus(\{w\}\cup N(w))}Z^{(2)}_{K_{d_{v}+1}}(\lambda_{v},\mu_{v})^{\frac{1}{d_{v}+1}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>∖</mo><mi>w</mi></mrow><mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mo>−</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝀</mi><mo>′</mo></msup><mo>,</mo><msup><mi>𝝁</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∏</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><msubsup><mi>Z</mi><msub><mi>K</mi><msub><mi>d</mi><mi>v</mi></msub></msub><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>v</mi></msub><mo>,</mo><msub><mi>μ</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><msub><mi>d</mi><mi>v</mi></msub></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∏</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∖</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">{</mo><mi>w</mi><mo stretchy="false">}</mo></mrow><mo>∪</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><msubsup><mi>Z</mi><msub><mi>K</mi><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>v</mi></msub><mo>,</mo><msub><mi>μ</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">Z^{(2)-}_{G\setminus w}(\bm{\lambda}^{\prime},\bm{\mu}^{\prime})=\prod_{v\in N(w)}Z^{(2)}_{K_{d_{v}}}(\lambda_{v},\mu_{v})^{\frac{1}{d_{v}}}\prod_{v\in V(G)\setminus(\{w\}\cup N(w))}Z^{(2)}_{K_{d_{v}+1}}(\lambda_{v},\mu_{v})^{\frac{1}{d_{v}+1}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p3.4" class="ltx_p">so after removing the common factors <math id="S3.p3.m11" class="ltx_Math" alttext="Z^{(2)}_{K_{d_{v}+1}}(\lambda_{v},\mu_{v})^{\frac{1}{d_{v}+1}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Z</mi><msub><mi>K</mi><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>v</mi></msub><mo>,</mo><msub><mi>μ</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow><annotation encoding="application/x-tex">Z^{(2)}_{K_{d_{v}+1}}(\lambda_{v},\mu_{v})^{\frac{1}{d_{v}+1}}</annotation></semantics></math> for <math id="S3.p3.m12" class="ltx_Math" alttext="v\in V(G)\setminus(\{w\}\cup N(w))" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∖</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">{</mo><mi>w</mi><mo stretchy="false">}</mo></mrow><mo>∪</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">v\in V(G)\setminus(\{w\}\cup N(w))</annotation></semantics></math>, (<a href="#S3.E1" title="Equation 3.1 ‣ 3 Semiproper colourings ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>) becomes</p>
<table id="S3.E2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E2.m1" class="ltx_Math" alttext="\prod_{v\in N(w)}A_{d_{v}}(\lambda_{v},\mu_{v})^{\frac{1}{d_{v}}}+\lambda_{w}\prod_{v\in N(w)}B_{d_{v}}(\mu_{v})^{\frac{1}{d_{v}}}+\mu_{w}\prod_{v\in N(w)}B_{d_{v}}(\lambda_{v})^{\frac{1}{d_{v}}}\\
\geq A_{\Delta+1}(\lambda_{w},\mu_{w})^{\frac{1}{\Delta+1}}\prod_{v\in N(w)}A_{d_{v}+1}(\lambda_{v},\mu_{v})^{\frac{1}{d_{v}+1}}," display="block" intent=":literal"><semantics><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><munder><mo movablelimits="false">∏</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><msub><mi>A</mi><msub><mi>d</mi><mi>v</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>v</mi></msub><mo mathsize="0.700em">,</mo><msub><mi>μ</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><msub><mi>d</mi><mi>v</mi></msub></mfrac></msup></mrow></mrow><mo>+</mo><mrow><msub><mi>λ</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∏</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><msub><mi>B</mi><msub><mi>d</mi><mi>v</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>μ</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><msub><mi>d</mi><mi>v</mi></msub></mfrac></msup></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>μ</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∏</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><msub><mi>B</mi><msub><mi>d</mi><mi>v</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><msub><mi>d</mi><mi>v</mi></msub></mfrac></msup></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mphantom></mphantom><mo>≥</mo><mrow><msub><mi>A</mi><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>w</mi></msub><mo>,</mo><msub><mi>μ</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∏</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><msub><mi>A</mi><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>v</mi></msub><mo>,</mo><msub><mi>μ</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow></mrow></mrow></mrow><mo>,</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\prod_{v\in N(w)}A_{d_{v}}(\lambda_{v},\mu_{v})^{\frac{1}{d_{v}}}+\lambda_{w}\prod_{v\in N(w)}B_{d_{v}}(\mu_{v})^{\frac{1}{d_{v}}}+\mu_{w}\prod_{v\in N(w)}B_{d_{v}}(\lambda_{v})^{\frac{1}{d_{v}}}\\
\geq A_{\Delta+1}(\lambda_{w},\mu_{w})^{\frac{1}{\Delta+1}}\prod_{v\in N(w)}A_{d_{v}+1}(\lambda_{v},\mu_{v})^{\frac{1}{d_{v}+1}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.2)</span></td></tr></tbody>
</table>
<p id="S3.p3.5" class="ltx_p">where for <math id="S3.p3.m13" class="ltx_Math" alttext="d\geq 1" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d\geq 1</annotation></semantics></math> and <math id="S3.p3.m14" class="ltx_Math" alttext="\lambda,\mu\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>λ</mi><mo>,</mo><mi>μ</mi></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda,\mu\geq 0</annotation></semantics></math>,</p>
<table id="S3.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex4.m1" class="ltx_Math" alttext="\displaystyle A_{d}(\lambda,\mu)" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle A_{d}(\lambda,\mu)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex4.m2" class="ltx_math_unparsed" alttext="\displaystyle\coloneqq d(d-1)\lambda\mu+d(\lambda+\mu)+1=Z^{(2)}_{K_{d}}(\lambda,\mu)\quad\text{and}" display="inline" intent=":literal"><semantics><mrow><mo>≔</mo><mi>d</mi><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mi>λ</mi><mi>μ</mi><mo>+</mo><mi>d</mi><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>+</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><mn>1</mn><mo>=</mo><msubsup><mi>Z</mi><msub><mi>K</mi><mi>d</mi></msub><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mtext>and</mtext></mrow><annotation encoding="application/x-tex">\displaystyle\coloneqq d(d-1)\lambda\mu+d(\lambda+\mu)+1=Z^{(2)}_{K_{d}}(\lambda,\mu)\quad\text{and}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex5.m1" class="ltx_Math" alttext="\displaystyle B_{d}(\lambda)" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle B_{d}(\lambda)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex5.m2" class="ltx_Math" alttext="\displaystyle\coloneqq d\lambda+1=Z^{(2)}_{K_{d}}(\lambda,0)=Z_{K_{d}}(\lambda)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≔</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo>=</mo><mrow><msubsup><mi>Z</mi><msub><mi>K</mi><mi>d</mi></msub><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>Z</mi><msub><mi>K</mi><mi>d</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\coloneqq d\lambda+1=Z^{(2)}_{K_{d}}(\lambda,0)=Z_{K_{d}}(\lambda).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.p4" class="ltx_para">
<p id="S3.p4.1" class="ltx_p">It is convenient to treat the case <math id="S3.p4.m1" class="ltx_Math" alttext="\Delta=1" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\Delta=1</annotation></semantics></math> separately, and then assume <math id="S3.p4.m2" class="ltx_Math" alttext="\Delta\geq 2" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\Delta\geq 2</annotation></semantics></math>.
Suppose <math id="S3.p4.m3" class="ltx_Math" alttext="\Delta=1" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\Delta=1</annotation></semantics></math> and let <math id="S3.p4.m4" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> be the unique neighbour of <math id="S3.p4.m5" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math>. Since <math id="S3.p4.m6" class="ltx_Math" alttext="d_{v}=\Delta=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>=</mo><mi mathvariant="normal">Δ</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d_{v}=\Delta=1</annotation></semantics></math>, (<a href="#S3.E2" title="Equation 3.2 ‣ 3 Semiproper colourings ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a>) is written as</p>
<table id="S3.E3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E3.m1" class="ltx_Math" alttext="A_{d_{v}}(\lambda_{v},\mu_{v})+\lambda_{w}B_{d_{v}}(\mu_{v})+\mu_{w}B_{d_{v}}(\lambda_{v})\geq A_{2}(\lambda_{w},\mu_{w})^{1/2}A_{2}(\lambda_{v},\mu_{v})^{1/2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>A</mi><msub><mi>d</mi><mi>v</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>v</mi></msub><mo>,</mo><msub><mi>μ</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>λ</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><msub><mi>d</mi><mi>v</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>μ</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>μ</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><msub><mi>d</mi><mi>v</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≥</mo><mrow><msub><mi>A</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>w</mi></msub><mo>,</mo><msub><mi>μ</mi><mi>w</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>v</mi></msub><mo>,</mo><msub><mi>μ</mi><mi>v</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">A_{d_{v}}(\lambda_{v},\mu_{v})+\lambda_{w}B_{d_{v}}(\mu_{v})+\mu_{w}B_{d_{v}}(\lambda_{v})\geq A_{2}(\lambda_{w},\mu_{w})^{1/2}A_{2}(\lambda_{v},\mu_{v})^{1/2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.3)</span></td></tr></tbody>
</table>
<p id="S3.p4.2" class="ltx_p">Let <math id="S3.p4.m7" class="ltx_Math" alttext="x_{1}\coloneqq\lambda_{w}+1" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>≔</mo><mrow><msub><mi>λ</mi><mi>w</mi></msub><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">x_{1}\coloneqq\lambda_{w}+1</annotation></semantics></math>, <math id="S3.p4.m8" class="ltx_Math" alttext="y_{1}\coloneqq\mu_{w}+1" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mn>1</mn></msub><mo>≔</mo><mrow><msub><mi>μ</mi><mi>w</mi></msub><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">y_{1}\coloneqq\mu_{w}+1</annotation></semantics></math>, <math id="S3.p4.m9" class="ltx_Math" alttext="x_{2}\coloneqq\lambda_{v}+1" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>≔</mo><mrow><msub><mi>λ</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">x_{2}\coloneqq\lambda_{v}+1</annotation></semantics></math>, and <math id="S3.p4.m10" class="ltx_Math" alttext="y_{2}\coloneqq\mu_{v}+1" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mn>2</mn></msub><mo>≔</mo><mrow><msub><mi>μ</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">y_{2}\coloneqq\mu_{v}+1</annotation></semantics></math>. Then (<a href="#S3.E3" title="Equation 3.3 ‣ 3 Semiproper colourings ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a>) is equivalent to</p>
<table id="S3.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex6.m1" class="ltx_Math" alttext="x_{1}y_{2}+y_{1}x_{2}-1\geq(2x_{1}y_{1}-1)^{1/2}(2x_{2}y_{2}-1)^{1/2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mn>2</mn></msub></mrow><mo>+</mo><mrow><msub><mi>y</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>2</mn></msub></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mo>≥</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mn>1</mn></msub></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mn>2</mn></msub></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">x_{1}y_{2}+y_{1}x_{2}-1\geq(2x_{1}y_{1}-1)^{1/2}(2x_{2}y_{2}-1)^{1/2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p4.3" class="ltx_p">The AM–GM inequality gives</p>
<table id="S3.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex7.m1" class="ltx_Math" alttext="x_{1}y_{2}+y_{1}x_{2}-1\geq 2(x_{1}y_{2}y_{1}x_{2})^{1/2}-1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mn>2</mn></msub></mrow><mo>+</mo><mrow><msub><mi>y</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>2</mn></msub></mrow></mrow><mo>−</mo><mn>1</mn></mrow><mo>≥</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><mo>−</mo><mn>1</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">x_{1}y_{2}+y_{1}x_{2}-1\geq 2(x_{1}y_{2}y_{1}x_{2})^{1/2}-1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p4.4" class="ltx_p">Substituting <math id="S3.p4.m11" class="ltx_Math" alttext="x=(x_{1}y_{1})^{1/2}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">x=(x_{1}y_{1})^{1/2}</annotation></semantics></math> and <math id="S3.p4.m12" class="ltx_Math" alttext="y=(x_{2}y_{2})^{1/2}" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>x</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">y=(x_{2}y_{2})^{1/2}</annotation></semantics></math> into <math id="S3.p4.m13" class="ltx_Math" alttext="(2xy-1)^{2}-(2x^{2}-1)(2y^{2}-1)=2(x-y)^{2}\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mn>2</mn></msup></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mn>2</mn></msup></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">(2xy-1)^{2}-(2x^{2}-1)(2y^{2}-1)=2(x-y)^{2}\geq 0</annotation></semantics></math> gives</p>
<table id="S3.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex8.m1" class="ltx_Math" alttext="2(x_{1}y_{1}x_{2}y_{2})^{1/2}-1\geq(2x_{1}y_{1}-1)^{1/2}(2x_{2}y_{2}-1)^{1/2}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><mo>−</mo><mn>1</mn></mrow><mo>≥</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mn>1</mn></msub></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mn>2</mn></msub></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">2(x_{1}y_{1}x_{2}y_{2})^{1/2}-1\geq(2x_{1}y_{1}-1)^{1/2}(2x_{2}y_{2}-1)^{1/2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.p4.5" class="ltx_p">and hence (<a href="#S3.E3" title="Equation 3.3 ‣ 3 Semiproper colourings ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a>) holds. Therefore, in what follows, we assume <math id="S3.p4.m14" class="ltx_Math" alttext="\Delta\geq 2" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\Delta\geq 2</annotation></semantics></math>.</p>
</div>
<section id="S3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.1 </span>The dual set <math id="S3.SS1.m1" class="ltx_Math" alttext="\mathcal{S}_{d}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>d</mi></msub><annotation encoding="application/x-tex">\mathcal{S}_{d}</annotation></semantics></math> and log-convexity</h3>

<div id="S3.SS1.p1" class="ltx_para">
<p id="S3.SS1.p1.1" class="ltx_p">For <math id="S3.SS1.p1.m1" class="ltx_Math" alttext="d\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">d\geq 2</annotation></semantics></math>, let</p>
<table id="S3.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex9.m1" class="ltx_math_unparsed" alttext="\mathcal{S}_{d}\coloneqq\{(a_{0},a_{1},a_{2})\in(\mathbb{R}_{&gt;0})^{3}:a_{0}+a_{1}x+a_{2}y\geq A_{d+1}(x,y)^{\frac{1}{d+1}}\ \forall x,y\geq 0\}." display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>d</mi></msub><mo>≔</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>0</mn></msub><mo>,</mo><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>&gt;</mo><mn>0</mn></mrow></msub><mo rspace="0.278em" stretchy="false">)</mo></mrow><mn>3</mn></msup><mo rspace="0.278em">:</mo><msub><mi>a</mi><mn>0</mn></msub><mo>+</mo><msub><mi>a</mi><mn>1</mn></msub><mi>x</mi><mo>+</mo><msub><mi>a</mi><mn>2</mn></msub><mi>y</mi><mo>≥</mo><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo rspace="0.167em" stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup><mo rspace="0.167em">∀</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>≥</mo><mn>0</mn><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{S}_{d}\coloneqq\{(a_{0},a_{1},a_{2})\in(\mathbb{R}_{&gt;0})^{3}:a_{0}+a_{1}x+a_{2}y\geq A_{d+1}(x,y)^{\frac{1}{d+1}}\ \forall x,y\geq 0\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p1.2" class="ltx_p">One good reason to look into this set is that <math id="S3.SS1.p1.m2" class="ltx_Math" alttext="A_{d+1}(x,y)^{\frac{1}{d+1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow><annotation encoding="application/x-tex">A_{d+1}(x,y)^{\frac{1}{d+1}}</annotation></semantics></math> is concave, which means <math id="S3.SS1.p1.m3" class="ltx_Math" alttext="\mathcal{S}_{d}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>d</mi></msub><annotation encoding="application/x-tex">\mathcal{S}_{d}</annotation></semantics></math> may be viewed as a ‘dual’ of it. Concavity of <math id="S3.SS1.p1.m4" class="ltx_Math" alttext="A_{d+1}^{\frac{1}{d+1}}" display="inline" intent=":literal"><semantics><msubsup><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msubsup><annotation encoding="application/x-tex">A_{d+1}^{\frac{1}{d+1}}</annotation></semantics></math> is straightforward to check.</p>
</div>
<div id="S3.Thmtheorem1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem1.2" class="ltx_text ltx_font_bold">Lemma 3.1</span></span><span id="S3.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem1.p1" class="ltx_para">
<p id="S3.Thmtheorem1.p1.1" class="ltx_p"><span id="S3.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">For <math id="S3.Thmtheorem1.p1.m1" class="ltx_Math" alttext="d\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">d\geq 2</annotation></semantics></math>, <math id="S3.Thmtheorem1.p1.m2" class="ltx_Math" alttext="A_{d+1}(x,y)^{\frac{1}{d+1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow><annotation encoding="application/x-tex">A_{d+1}(x,y)^{\frac{1}{d+1}}</annotation></semantics></math> is concave on any convex subset of <math id="S3.Thmtheorem1.p1.m3" class="ltx_Math" alttext="\{(x,y)\in\mathbb{R}^{2}:A_{d+1}(x,y)&gt;0\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mn>2</mn></msup></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{(x,y)\in\mathbb{R}^{2}:A_{d+1}(x,y)&gt;0\}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS1.p2" class="ltx_para">
<p id="S3.SS1.p2.1" class="ltx_p"><span id="S3.SS1.p2.1.1" class="ltx_text">Let <math id="S3.SS1.p2.m1" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math> be a convex subset of <math id="S3.SS1.p2.m2" class="ltx_Math" alttext="\{(x,y)\in\mathbb{R}^{2}:A_{d+1}(x,y)&gt;0\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mn>2</mn></msup></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{(x,y)\in\mathbb{R}^{2}:A_{d+1}(x,y)&gt;0\}</annotation></semantics></math>. A direct calculation gives</span></p>
<table id="S3.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E4.m1" class="ltx_Math" alttext="\displaystyle\partial_{xx}\bigl(A_{d+1}(x,y)^{\frac{1}{d+1}}\bigr)" display="inline" intent=":literal"><semantics><mrow><msub><mo>∂</mo><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\partial_{xx}\bigl(A_{d+1}(x,y)^{\frac{1}{d+1}}\bigr)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E4.m2" class="ltx_Math" alttext="\displaystyle=-d(dy+1)^{2}A_{d+1}(x,y)^{\frac{1}{d+1}-2}\leq 0," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac><mo>−</mo><mn>2</mn></mrow></msup></mrow></mrow><mo>≤</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=-d(dy+1)^{2}A_{d+1}(x,y)^{\frac{1}{d+1}-2}\leq 0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.4)</span></td></tr></tbody>
<tbody id="S3.E5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E5.m1" class="ltx_Math" alttext="\displaystyle\partial_{yy}\bigl(A_{d+1}(x,y)^{\frac{1}{d+1}}\bigr)" display="inline" intent=":literal"><semantics><mrow><msub><mo>∂</mo><mrow><mi>y</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\partial_{yy}\bigl(A_{d+1}(x,y)^{\frac{1}{d+1}}\bigr)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E5.m2" class="ltx_Math" alttext="\displaystyle=-d(dx+1)^{2}A_{d+1}(x,y)^{\frac{1}{d+1}-2}\leq 0," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac><mo>−</mo><mn>2</mn></mrow></msup></mrow></mrow><mo>≤</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=-d(dx+1)^{2}A_{d+1}(x,y)^{\frac{1}{d+1}-2}\leq 0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.5)</span></td></tr></tbody>
<tbody id="S3.Ex10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex10.m1" class="ltx_Math" alttext="\displaystyle\partial_{xy}\bigl(A_{d+1}(x,y)^{\frac{1}{d+1}}\bigr)" display="inline" intent=":literal"><semantics><mrow><msub><mo>∂</mo><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\partial_{xy}\bigl(A_{d+1}(x,y)^{\frac{1}{d+1}}\bigr)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex10.m2" class="ltx_Math" alttext="\displaystyle=d(dxy+x+y)A_{d+1}(x,y)^{\frac{1}{d+1}-2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo>+</mo><mi>x</mi><mo>+</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac><mo>−</mo><mn>2</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=d(dxy+x+y)A_{d+1}(x,y)^{\frac{1}{d+1}-2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p2.2" class="ltx_p"><span id="S3.SS1.p2.2.1" class="ltx_text">Then the Hessian determinant of <math id="S3.SS1.p2.m3" class="ltx_Math" alttext="A_{d+1}(x,y)^{\frac{1}{d+1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow><annotation encoding="application/x-tex">A_{d+1}(x,y)^{\frac{1}{d+1}}</annotation></semantics></math> is</span></p>
<table id="S3.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex11.m1" class="ltx_Math" alttext="d^{2}A_{d+1}(x,y)^{\frac{2}{d+1}-3}\bigl((d-1)(dxy+x+y)+1\bigr)." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mrow><mfrac><mn>2</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac><mo>−</mo><mn>3</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo>+</mo><mi>x</mi><mo>+</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">d^{2}A_{d+1}(x,y)^{\frac{2}{d+1}-3}\bigl((d-1)(dxy+x+y)+1\bigr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p2.3" class="ltx_p"><span id="S3.SS1.p2.3.1" class="ltx_text">Since <math id="S3.SS1.p2.m4" class="ltx_Math" alttext="A_{d+1}(x,y)=(d+1)(dxy+x+y)+1&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo>+</mo><mi>x</mi><mo>+</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">A_{d+1}(x,y)=(d+1)(dxy+x+y)+1&gt;0</annotation></semantics></math> on <math id="S3.SS1.p2.m5" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math>,</span></p>
<table id="S3.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex12.m1" class="ltx_Math" alttext="(d-1)(dxy+x+y)+1&gt;-\frac{d-1}{d+1}+1&gt;0," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo>+</mo><mi>x</mi><mo>+</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo>&gt;</mo><mrow><mrow><mo>−</mo><mfrac><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow><mo>+</mo><mn>1</mn></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">(d-1)(dxy+x+y)+1&gt;-\frac{d-1}{d+1}+1&gt;0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p2.4" class="ltx_p"><span id="S3.SS1.p2.4.1" class="ltx_text">so <math id="S3.SS1.p2.m6" class="ltx_Math" alttext="A_{d+1}(x,y)^{\frac{1}{d+1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow><annotation encoding="application/x-tex">A_{d+1}(x,y)^{\frac{1}{d+1}}</annotation></semantics></math> has a positive Hessian determinant on <math id="S3.SS1.p2.m7" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math>. Together with (<a href="#S3.E4" title="Equation 3.4 ‣ Proof. ‣ 3.1 The dual set 𝒮_𝑑 and log-convexity ‣ 3 Semiproper colourings ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.4</span></a>) and (<a href="#S3.E5" title="Equation 3.5 ‣ Proof. ‣ 3.1 The dual set 𝒮_𝑑 and log-convexity ‣ 3 Semiproper colourings ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.5</span></a>), we conclude that <math id="S3.SS1.p2.m8" class="ltx_Math" alttext="A_{d+1}(x,y)^{\frac{1}{d+1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow><annotation encoding="application/x-tex">A_{d+1}(x,y)^{\frac{1}{d+1}}</annotation></semantics></math> is concave on <math id="S3.SS1.p2.m9" class="ltx_Math" alttext="\Omega" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Ω</mi><annotation encoding="application/x-tex">\Omega</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S3.SS1.p3" class="ltx_para">
<p id="S3.SS1.p3.1" class="ltx_p">Now our goal (<a href="#S3.E2" title="Equation 3.2 ‣ 3 Semiproper colourings ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a>) is equivalent to the following <a href="#S3.Thmtheorem2" title="Lemma 3.2. ‣ 3.1 The dual set 𝒮_𝑑 and log-convexity ‣ 3 Semiproper colourings ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span></a>.</p>
</div>
<div id="S3.Thmtheorem2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem2.2" class="ltx_text ltx_font_bold">Lemma 3.2</span></span><span id="S3.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem2.p1" class="ltx_para">
<p id="S3.Thmtheorem2.p1.1" class="ltx_p"><span id="S3.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S3.Thmtheorem2.p1.m1" class="ltx_Math" alttext="\Delta\geq 2" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\Delta\geq 2</annotation></semantics></math> and <math id="S3.Thmtheorem2.p1.m2" class="ltx_Math" alttext="1\leq d_{i}\leq\Delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><msub><mi>d</mi><mi>i</mi></msub><mo>≤</mo><mi mathvariant="normal">Δ</mi></mrow><annotation encoding="application/x-tex">1\leq d_{i}\leq\Delta</annotation></semantics></math>, <math id="S3.Thmtheorem2.p1.m3" class="ltx_Math" alttext="1\leq i\leq\Delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi mathvariant="normal">Δ</mi></mrow><annotation encoding="application/x-tex">1\leq i\leq\Delta</annotation></semantics></math> be integers. Let <math id="S3.Thmtheorem2.p1.m4" class="ltx_Math" alttext="\lambda_{i},\mu_{i}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>μ</mi><mi>i</mi></msub><mo>≥</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">\lambda_{i},\mu_{i}\geq 0</annotation></semantics></math> for <math id="S3.Thmtheorem2.p1.m5" class="ltx_Math" alttext="1\leq i\leq\Delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi mathvariant="normal">Δ</mi></mrow><annotation encoding="application/x-tex">1\leq i\leq\Delta</annotation></semantics></math>. Then</span></p>
<table id="S3.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex13.m1" class="ltx_Math" alttext="\biggl(\prod_{i=1}^{\Delta}\frac{A_{d_{i}}(\lambda_{i},\mu_{i})^{\frac{1}{d_{i}}}}{A_{d_{i}+1}(\lambda_{i},\mu_{i})^{\frac{1}{d_{i}+1}}},\,\prod_{i=1}^{\Delta}\frac{B_{d_{i}}(\mu_{i})^{\frac{1}{d_{i}}}}{A_{d_{i}+1}(\lambda_{i},\mu_{i})^{\frac{1}{d_{i}+1}}},\,\prod_{i=1}^{\Delta}\frac{B_{d_{i}}(\lambda_{i})^{\frac{1}{d_{i}}}}{A_{d_{i}+1}(\lambda_{i},\mu_{i})^{\frac{1}{d_{i}+1}}}\biggr)\in\mathcal{S}_{\Delta}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><munderover><mo lspace="0em" movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">Δ</mi></munderover><mfrac><mrow><msub><mi>A</mi><msub><mi>d</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>i</mi></msub><mo>,</mo><msub><mi>μ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><msub><mi>d</mi><mi>i</mi></msub></mfrac></msup></mrow><mrow><msub><mi>A</mi><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>i</mi></msub><mo>,</mo><msub><mi>μ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow></mfrac></mrow><mo rspace="0em">,</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">Δ</mi></munderover><mfrac><mrow><msub><mi>B</mi><msub><mi>d</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>μ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><msub><mi>d</mi><mi>i</mi></msub></mfrac></msup></mrow><mrow><msub><mi>A</mi><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>i</mi></msub><mo>,</mo><msub><mi>μ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow></mfrac></mrow><mo rspace="0em">,</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">Δ</mi></munderover><mfrac><mrow><msub><mi>B</mi><msub><mi>d</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><msub><mi>d</mi><mi>i</mi></msub></mfrac></msup></mrow><mrow><msub><mi>A</mi><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>λ</mi><mi>i</mi></msub><mo>,</mo><msub><mi>μ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow></mfrac></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi mathvariant="normal">Δ</mi></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\biggl(\prod_{i=1}^{\Delta}\frac{A_{d_{i}}(\lambda_{i},\mu_{i})^{\frac{1}{d_{i}}}}{A_{d_{i}+1}(\lambda_{i},\mu_{i})^{\frac{1}{d_{i}+1}}},\,\prod_{i=1}^{\Delta}\frac{B_{d_{i}}(\mu_{i})^{\frac{1}{d_{i}}}}{A_{d_{i}+1}(\lambda_{i},\mu_{i})^{\frac{1}{d_{i}+1}}},\,\prod_{i=1}^{\Delta}\frac{B_{d_{i}}(\lambda_{i})^{\frac{1}{d_{i}}}}{A_{d_{i}+1}(\lambda_{i},\mu_{i})^{\frac{1}{d_{i}+1}}}\biggr)\in\mathcal{S}_{\Delta}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S3.SS1.p4" class="ltx_para">
<p id="S3.SS1.p4.1" class="ltx_p">Our plan is to show that <math id="S3.SS1.p4.m1" class="ltx_Math" alttext="\log\mathcal{S}_{\Delta}\coloneqq\{(\log a_{0},\log a_{1},\log a_{2}):(a_{0},a_{1},a_{2})\in\mathcal{S}_{\Delta}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi mathvariant="normal">Δ</mi></msub></mrow><mo>≔</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>a</mi><mn>0</mn></msub></mrow><mo>,</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>a</mi><mn>1</mn></msub></mrow><mo>,</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>a</mi><mn>2</mn></msub></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>0</mn></msub><mo>,</mo><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi mathvariant="normal">Δ</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\log\mathcal{S}_{\Delta}\coloneqq\{(\log a_{0},\log a_{1},\log a_{2}):(a_{0},a_{1},a_{2})\in\mathcal{S}_{\Delta}\}</annotation></semantics></math> is convex or, equivalently, for all <math id="S3.SS1.p4.m2" class="ltx_Math" alttext="(a_{0},a_{1},a_{2}),(b_{0},b_{1},b_{2})\in\mathcal{S}_{\Delta}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>0</mn></msub><mo>,</mo><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">(</mo><msub><mi>b</mi><mn>0</mn></msub><mo>,</mo><msub><mi>b</mi><mn>1</mn></msub><mo>,</mo><msub><mi>b</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi mathvariant="normal">Δ</mi></msub></mrow></mrow><annotation encoding="application/x-tex">(a_{0},a_{1},a_{2}),(b_{0},b_{1},b_{2})\in\mathcal{S}_{\Delta}</annotation></semantics></math>, <math id="S3.SS1.p4.m3" class="ltx_Math" alttext="(\sqrt{a_{0}b_{0}},\sqrt{a_{1}b_{1}},\sqrt{a_{2}b_{2}})\in\mathcal{S}_{\Delta}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msqrt><mrow><msub><mi>a</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mn>0</mn></msub></mrow></msqrt><mo>,</mo><msqrt><mrow><msub><mi>a</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mn>1</mn></msub></mrow></msqrt><mo>,</mo><msqrt><mrow><msub><mi>a</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mn>2</mn></msub></mrow></msqrt><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi mathvariant="normal">Δ</mi></msub></mrow><annotation encoding="application/x-tex">(\sqrt{a_{0}b_{0}},\sqrt{a_{1}b_{1}},\sqrt{a_{2}b_{2}})\in\mathcal{S}_{\Delta}</annotation></semantics></math>; see <a href="#S3.Thmtheorem4" title="Lemma 3.4. ‣ 3.1 The dual set 𝒮_𝑑 and log-convexity ‣ 3 Semiproper colourings ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">3.4</span></a>.
Then <a href="#S3.Thmtheorem2" title="Lemma 3.2. ‣ 3.1 The dual set 𝒮_𝑑 and log-convexity ‣ 3 Semiproper colourings ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">3.2</span></a> is a consequence of the following <a href="#S3.Thmtheorem3" title="Lemma 3.3. ‣ 3.1 The dual set 𝒮_𝑑 and log-convexity ‣ 3 Semiproper colourings ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span></a> with <math id="S3.SS1.p4.m4" class="ltx_Math" alttext="(d,\lambda,\mu)=(d_{i},\lambda_{i},\mu_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>λ</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>d</mi><mi>i</mi></msub><mo>,</mo><msub><mi>λ</mi><mi>i</mi></msub><mo>,</mo><msub><mi>μ</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(d,\lambda,\mu)=(d_{i},\lambda_{i},\mu_{i})</annotation></semantics></math> for all <math id="S3.SS1.p4.m5" class="ltx_Math" alttext="1\leq i\leq\Delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi mathvariant="normal">Δ</mi></mrow><annotation encoding="application/x-tex">1\leq i\leq\Delta</annotation></semantics></math>, together with convexity of <math id="S3.SS1.p4.m6" class="ltx_Math" alttext="\log\mathcal{S}_{\Delta}" display="inline" intent=":literal"><semantics><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi mathvariant="normal">Δ</mi></msub></mrow><annotation encoding="application/x-tex">\log\mathcal{S}_{\Delta}</annotation></semantics></math>, which allows us to take coordinatewise geometric mean.</p>
</div>
<div id="S3.Thmtheorem3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem3.2" class="ltx_text ltx_font_bold">Lemma 3.3</span></span><span id="S3.Thmtheorem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem3.p1" class="ltx_para">
<p id="S3.Thmtheorem3.p1.1" class="ltx_p"><span id="S3.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S3.Thmtheorem3.p1.m1" class="ltx_Math" alttext="\Delta\geq 2" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\Delta\geq 2</annotation></semantics></math> and <math id="S3.Thmtheorem3.p1.m2" class="ltx_Math" alttext="1\leq d\leq\Delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>d</mi><mo>≤</mo><mi mathvariant="normal">Δ</mi></mrow><annotation encoding="application/x-tex">1\leq d\leq\Delta</annotation></semantics></math> be integers. Let <math id="S3.Thmtheorem3.p1.m3" class="ltx_Math" alttext="\lambda,\mu\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>λ</mi><mo>,</mo><mi>μ</mi></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda,\mu\geq 0</annotation></semantics></math>. Then</span></p>
<table id="S3.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex14.m1" class="ltx_Math" alttext="\biggl(\frac{A_{d}(\lambda,\mu)^{\frac{\Delta}{d}}}{A_{d+1}(\lambda,\mu)^{\frac{\Delta}{d+1}}},\,\frac{B_{d}(\mu)^{\frac{\Delta}{d}}}{A_{d+1}(\lambda,\mu)^{\frac{\Delta}{d+1}}},\,\frac{B_{d}(\lambda)^{\frac{\Delta}{d}}}{A_{d+1}(\lambda,\mu)^{\frac{\Delta}{d+1}}}\biggr)\in\mathcal{S}_{\Delta}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mfrac><mrow><msub><mi>A</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mfrac><mi mathvariant="normal">Δ</mi><mi>d</mi></mfrac></msup></mrow><mrow><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mfrac><mi mathvariant="normal">Δ</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow></mfrac><mo>,</mo><mfrac><mrow><msub><mi>B</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mfrac><mi mathvariant="normal">Δ</mi><mi>d</mi></mfrac></msup></mrow><mrow><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mfrac><mi mathvariant="normal">Δ</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow></mfrac><mo>,</mo><mfrac><mrow><msub><mi>B</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mfrac><mi mathvariant="normal">Δ</mi><mi>d</mi></mfrac></msup></mrow><mrow><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mfrac><mi mathvariant="normal">Δ</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow></mfrac><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi mathvariant="normal">Δ</mi></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\biggl(\frac{A_{d}(\lambda,\mu)^{\frac{\Delta}{d}}}{A_{d+1}(\lambda,\mu)^{\frac{\Delta}{d+1}}},\,\frac{B_{d}(\mu)^{\frac{\Delta}{d}}}{A_{d+1}(\lambda,\mu)^{\frac{\Delta}{d+1}}},\,\frac{B_{d}(\lambda)^{\frac{\Delta}{d}}}{A_{d+1}(\lambda,\mu)^{\frac{\Delta}{d+1}}}\biggr)\in\mathcal{S}_{\Delta}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S3.SS1.p5" class="ltx_para">
<p id="S3.SS1.p5.1" class="ltx_p">To illustrate what <a href="#S3.Thmtheorem3" title="Lemma 3.3. ‣ 3.1 The dual set 𝒮_𝑑 and log-convexity ‣ 3 Semiproper colourings ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">3.3</span></a> means, it is worth noting that the case <math id="S3.SS1.p5.m1" class="ltx_Math" alttext="d=\Delta" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mi mathvariant="normal">Δ</mi></mrow><annotation encoding="application/x-tex">d=\Delta</annotation></semantics></math> amounts to calculating the tangent plane of <math id="S3.SS1.p5.m2" class="ltx_Math" alttext="z=A_{d+1}(x,y)^{\frac{1}{d+1}}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>=</mo><mrow><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow></mrow><annotation encoding="application/x-tex">z=A_{d+1}(x,y)^{\frac{1}{d+1}}</annotation></semantics></math> at <math id="S3.SS1.p5.m3" class="ltx_Math" alttext="(x,y)=(\lambda,\mu)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(x,y)=(\lambda,\mu)</annotation></semantics></math>. Indeed,</p>
<table id="S3.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex15.m1" class="ltx_Math" alttext="\partial_{x}\Bigl(A_{d+1}^{\frac{1}{d+1}}\Bigr)=\frac{1}{d+1}A_{d+1}^{-\frac{d}{d+1}}\partial_{x}A_{d+1}=A_{d+1}^{-\frac{d}{d+1}}B_{d}(y)\quad\text{and}\quad\partial_{y}\Bigl(A_{d+1}^{\frac{1}{d+1}}\Bigr)=A_{d+1}^{-\frac{d}{d+1}}B_{d}(x)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mo>∂</mo><mi>x</mi></msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msubsup><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msubsup><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo>−</mo><mfrac><mi>d</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo>∂</mo><mi>x</mi></msub><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow><mo>=</mo><mrow><msubsup><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo>−</mo><mfrac><mi>d</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>and</mtext><mspace style="width:1.000em;" width="1.000em"></mspace><mrow><mrow><msub><mo>∂</mo><mi>y</mi></msub><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msubsup><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msubsup><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo>−</mo><mfrac><mi>d</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\partial_{x}\Bigl(A_{d+1}^{\frac{1}{d+1}}\Bigr)=\frac{1}{d+1}A_{d+1}^{-\frac{d}{d+1}}\partial_{x}A_{d+1}=A_{d+1}^{-\frac{d}{d+1}}B_{d}(y)\quad\text{and}\quad\partial_{y}\Bigl(A_{d+1}^{\frac{1}{d+1}}\Bigr)=A_{d+1}^{-\frac{d}{d+1}}B_{d}(x),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p5.2" class="ltx_p">so the tangent plane at <math id="S3.SS1.p5.m4" class="ltx_Math" alttext="(x,y)=(\lambda,\mu)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(x,y)=(\lambda,\mu)</annotation></semantics></math> is</p>
<table id="S3.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex16.m1" class="ltx_Math" alttext="\displaystyle z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">\displaystyle z</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex16.m2" class="ltx_Math" alttext="\displaystyle=A_{d+1}(\lambda,\mu)^{-\frac{d}{d+1}}\big(B_{d}(\mu)(x-\lambda)+B_{d}(\lambda)(y-\mu)\big)+A_{d+1}(\lambda,\mu)^{\frac{1}{d+1}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mi>d</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi>B</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>B</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=A_{d+1}(\lambda,\mu)^{-\frac{d}{d+1}}\big(B_{d}(\mu)(x-\lambda)+B_{d}(\lambda)(y-\mu)\big)+A_{d+1}(\lambda,\mu)^{\frac{1}{d+1}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex17.m1" class="ltx_Math" alttext="\displaystyle=A_{d+1}(\lambda,\mu)^{-\frac{d}{d+1}}\big(B_{d}(\mu)(x-\lambda)+B_{d}(\lambda)(y-\mu)+A_{d+1}(\lambda,\mu)\big)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mi>d</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi>B</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>−</mo><mi>λ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>B</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=A_{d+1}(\lambda,\mu)^{-\frac{d}{d+1}}\big(B_{d}(\mu)(x-\lambda)+B_{d}(\lambda)(y-\mu)+A_{d+1}(\lambda,\mu)\big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex18.m1" class="ltx_Math" alttext="\displaystyle=A_{d+1}(\lambda,\mu)^{-\frac{d}{d+1}}\big(B_{d}(\mu)x+B_{d}(\lambda)y+A_{d}(\lambda,\mu)\big)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mi>d</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi>B</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><mrow><msub><mi>B</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo>+</mo><mrow><msub><mi>A</mi><mi>d</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=A_{d+1}(\lambda,\mu)^{-\frac{d}{d+1}}\big(B_{d}(\mu)x+B_{d}(\lambda)y+A_{d}(\lambda,\mu)\big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.6)</span></td></tr></tbody>
</table>
<p id="S3.SS1.p5.3" class="ltx_p">As <math id="S3.SS1.p5.m5" class="ltx_Math" alttext="A_{d+1}(x,y)^{\frac{1}{d+1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow><annotation encoding="application/x-tex">A_{d+1}(x,y)^{\frac{1}{d+1}}</annotation></semantics></math> is concave, this plane always lies above <math id="S3.SS1.p5.m6" class="ltx_Math" alttext="z=A_{d+1}(x,y)^{\frac{1}{d+1}}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>=</mo><mrow><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow></mrow><annotation encoding="application/x-tex">z=A_{d+1}(x,y)^{\frac{1}{d+1}}</annotation></semantics></math>, which proves the case <math id="S3.SS1.p5.m7" class="ltx_Math" alttext="d=\Delta" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>=</mo><mi mathvariant="normal">Δ</mi></mrow><annotation encoding="application/x-tex">d=\Delta</annotation></semantics></math>.</p>
</div>
<div id="S3.SS1.p6" class="ltx_para">
<p id="S3.SS1.p6.1" class="ltx_p">Having seen this, <a href="#S3.Thmtheorem3" title="Lemma 3.3. ‣ 3.1 The dual set 𝒮_𝑑 and log-convexity ‣ 3 Semiproper colourings ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">3.3</span></a> essentially states that <math id="S3.SS1.p6.m1" class="ltx_Math" alttext="(a_{0},a_{1},a_{2})\in\mathcal{S}_{d}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>0</mn></msub><mo>,</mo><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">(a_{0},a_{1},a_{2})\in\mathcal{S}_{d}</annotation></semantics></math> implies <math id="S3.SS1.p6.m2" class="ltx_Math" alttext="(a_{0}^{\Delta/d},a_{1}^{\Delta/d},a_{2}^{\Delta/d})\in\mathcal{S}_{\Delta}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mn>0</mn><mrow><mi mathvariant="normal">Δ</mi><mo>/</mo><mi>d</mi></mrow></msubsup><mo>,</mo><msubsup><mi>a</mi><mn>1</mn><mrow><mi mathvariant="normal">Δ</mi><mo>/</mo><mi>d</mi></mrow></msubsup><mo>,</mo><msubsup><mi>a</mi><mn>2</mn><mrow><mi mathvariant="normal">Δ</mi><mo>/</mo><mi>d</mi></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi mathvariant="normal">Δ</mi></msub></mrow><annotation encoding="application/x-tex">(a_{0}^{\Delta/d},a_{1}^{\Delta/d},a_{2}^{\Delta/d})\in\mathcal{S}_{\Delta}</annotation></semantics></math>, which is arguably the most technically challenging part. Before getting into it, let us give a proof that <math id="S3.SS1.p6.m3" class="ltx_Math" alttext="\log\mathcal{S}_{d}" display="inline" intent=":literal"><semantics><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\log\mathcal{S}_{d}</annotation></semantics></math> is indeed convex.</p>
</div>
<div id="S3.Thmtheorem4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem4.2" class="ltx_text ltx_font_bold">Lemma 3.4</span></span><span id="S3.Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem4.p1" class="ltx_para">
<p id="S3.Thmtheorem4.p1.1" class="ltx_p"><span id="S3.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">For <math id="S3.Thmtheorem4.p1.m1" class="ltx_Math" alttext="d\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">d\geq 2</annotation></semantics></math>, <math id="S3.Thmtheorem4.p1.m2" class="ltx_Math" alttext="\log\mathcal{S}_{d}" display="inline" intent=":literal"><semantics><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\log\mathcal{S}_{d}</annotation></semantics></math> is convex.</span></p>
</div>
</div>
<div id="S3.SS1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS1.p7" class="ltx_para">
<p id="S3.SS1.p7.1" class="ltx_p"><span id="S3.SS1.p7.1.1" class="ltx_text">Let <math id="S3.SS1.p7.m1" class="ltx_Math" alttext="h(w,x,y)" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">h(w,x,y)</annotation></semantics></math> be the ‘homogenisation’ of <math id="S3.SS1.p7.m2" class="ltx_Math" alttext="A_{d+1}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">A_{d+1}</annotation></semantics></math>, i.e.,</span></p>
<table id="S3.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex19.m1" class="ltx_Math" alttext="h(w,x,y)\coloneqq(d+1)dw^{d-1}xy+(d+1)w^{d}(x+y)+w^{d+1}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>w</mi><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>w</mi><mi>d</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>+</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msup><mi>w</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">h(w,x,y)\coloneqq(d+1)dw^{d-1}xy+(d+1)w^{d}(x+y)+w^{d+1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p7.2" class="ltx_p"><span id="S3.SS1.p7.2.1" class="ltx_text">For <math id="S3.SS1.p7.m3" class="ltx_Math" alttext="w&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">w&gt;0</annotation></semantics></math>, <math id="S3.SS1.p7.m4" class="ltx_Math" alttext="h(w,x,y)=w^{d+1}A_{d+1}(x/w,y/w)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>w</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>/</mo><mi>w</mi></mrow><mo>,</mo><mrow><mi>y</mi><mo>/</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">h(w,x,y)=w^{d+1}A_{d+1}(x/w,y/w)</annotation></semantics></math>.
Then <math id="S3.SS1.p7.m5" class="ltx_Math" alttext="(a_{0},a_{1},a_{2})\in\mathcal{S}_{d}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>0</mn></msub><mo>,</mo><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">(a_{0},a_{1},a_{2})\in\mathcal{S}_{d}</annotation></semantics></math> if and only if</span></p>
<table id="S3.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex20.m1" class="ltx_Math" alttext="a_{0}w+a_{1}x+a_{2}y\geq h(w,x,y)^{\frac{1}{d+1}}\quad\forall w,x,y\geq 0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><msub><mi>a</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow><mo>+</mo><mrow><msub><mi>a</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><mrow><msub><mi>a</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></mrow><mo>≥</mo><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow></mrow><mspace style="width:1.167em;" width="1.167em"></mspace><mrow><mo rspace="0.167em">∀</mo><mi>w</mi></mrow><mo>,</mo><mi>x</mi><mo>,</mo><mrow><mi>y</mi><mo>≥</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">a_{0}w+a_{1}x+a_{2}y\geq h(w,x,y)^{\frac{1}{d+1}}\quad\forall w,x,y\geq 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p7.3" class="ltx_p"><span id="S3.SS1.p7.3.1" class="ltx_text">Indeed, the ‘if’ part follows from <math id="S3.SS1.p7.m6" class="ltx_Math" alttext="h(1,x,y)=A_{d+1}(x,y)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">h(1,x,y)=A_{d+1}(x,y)</annotation></semantics></math>; to see the ‘only if’ part, note that for <math id="S3.SS1.p7.m7" class="ltx_Math" alttext="w&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">w&gt;0</annotation></semantics></math>,</span></p>
<table id="S3.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex21.m1" class="ltx_Math" alttext="a_{0}w+a_{1}x+a_{2}y=w(a_{0}+a_{1}(x/w)+a_{2}(y/w))\geq wA_{d+1}(x/w,y/w)^{\frac{1}{d+1}}=h(w,x,y)^{\frac{1}{d+1}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>a</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow><mo>+</mo><mrow><msub><mi>a</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><mrow><msub><mi>a</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></mrow><mo>=</mo><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>a</mi><mn>0</mn></msub><mo>+</mo><mrow><msub><mi>a</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>/</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>a</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>/</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>/</mo><mi>w</mi></mrow><mo>,</mo><mrow><mi>y</mi><mo>/</mo><mi>w</mi></mrow><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow><mo>=</mo><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">a_{0}w+a_{1}x+a_{2}y=w(a_{0}+a_{1}(x/w)+a_{2}(y/w))\geq wA_{d+1}(x/w,y/w)^{\frac{1}{d+1}}=h(w,x,y)^{\frac{1}{d+1}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p7.4" class="ltx_p"><span id="S3.SS1.p7.4.1" class="ltx_text">and the case <math id="S3.SS1.p7.m8" class="ltx_Math" alttext="w=0" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">w=0</annotation></semantics></math> is clear since <math id="S3.SS1.p7.m9" class="ltx_Math" alttext="h(0,x,y)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">h(0,x,y)=0</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS1.p8" class="ltx_para">
<p id="S3.SS1.p8.1" class="ltx_p"><span id="S3.SS1.p8.1.1" class="ltx_text">We show that for all <math id="S3.SS1.p8.m1" class="ltx_Math" alttext="(a_{0},a_{1},a_{2}),(b_{0},b_{1},b_{2})\in\mathcal{S}_{d}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>0</mn></msub><mo>,</mo><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mrow><mo stretchy="false">(</mo><msub><mi>b</mi><mn>0</mn></msub><mo>,</mo><msub><mi>b</mi><mn>1</mn></msub><mo>,</mo><msub><mi>b</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>d</mi></msub></mrow></mrow><annotation encoding="application/x-tex">(a_{0},a_{1},a_{2}),(b_{0},b_{1},b_{2})\in\mathcal{S}_{d}</annotation></semantics></math>, <math id="S3.SS1.p8.m2" class="ltx_Math" alttext="(\sqrt{a_{0}b_{0}},\sqrt{a_{1}b_{1}},\sqrt{a_{2}b_{2}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msqrt><mrow><msub><mi>a</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mn>0</mn></msub></mrow></msqrt><mo>,</mo><msqrt><mrow><msub><mi>a</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mn>1</mn></msub></mrow></msqrt><mo>,</mo><msqrt><mrow><msub><mi>a</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mn>2</mn></msub></mrow></msqrt><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\sqrt{a_{0}b_{0}},\sqrt{a_{1}b_{1}},\sqrt{a_{2}b_{2}})</annotation></semantics></math> is in <math id="S3.SS1.p8.m3" class="ltx_Math" alttext="\mathcal{S}_{d}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>d</mi></msub><annotation encoding="application/x-tex">\mathcal{S}_{d}</annotation></semantics></math>, using this description of <math id="S3.SS1.p8.m4" class="ltx_Math" alttext="\mathcal{S}_{d}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>d</mi></msub><annotation encoding="application/x-tex">\mathcal{S}_{d}</annotation></semantics></math> in terms of <math id="S3.SS1.p8.m5" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math>.
Let <math id="S3.SS1.p8.m6" class="ltx_Math" alttext="(w_{1},x_{1},y_{1})\coloneqq(\sqrt{b_{0}/a_{0}}w,\sqrt{b_{1}/a_{1}}x,\sqrt{b_{2}/a_{2}}y)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>y</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>≔</mo><mrow><mo stretchy="false">(</mo><mrow><msqrt><mrow><msub><mi>b</mi><mn>0</mn></msub><mo>/</mo><msub><mi>a</mi><mn>0</mn></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow><mo>,</mo><mrow><msqrt><mrow><msub><mi>b</mi><mn>1</mn></msub><mo>/</mo><msub><mi>a</mi><mn>1</mn></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>,</mo><mrow><msqrt><mrow><msub><mi>b</mi><mn>2</mn></msub><mo>/</mo><msub><mi>a</mi><mn>2</mn></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(w_{1},x_{1},y_{1})\coloneqq(\sqrt{b_{0}/a_{0}}w,\sqrt{b_{1}/a_{1}}x,\sqrt{b_{2}/a_{2}}y)</annotation></semantics></math>. Then</span></p>
<table id="S3.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex22.m1" class="ltx_Math" alttext="\displaystyle\sqrt{a_{0}b_{0}}w+\sqrt{a_{1}b_{1}}x+\sqrt{a_{2}b_{2}}y=a_{0}w_{1}+a_{1}x_{1}+a_{2}y_{1}\geq h(w_{1},x_{1},y_{1})^{\frac{1}{d+1}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msqrt><mrow><msub><mi>a</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mn>0</mn></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow><mo>+</mo><mrow><msqrt><mrow><msub><mi>a</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mn>1</mn></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><mrow><msqrt><mrow><msub><mi>a</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mn>2</mn></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>a</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>w</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><msub><mi>a</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><msub><mi>a</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mn>1</mn></msub></mrow></mrow><mo>≥</mo><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>y</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sqrt{a_{0}b_{0}}w+\sqrt{a_{1}b_{1}}x+\sqrt{a_{2}b_{2}}y=a_{0}w_{1}+a_{1}x_{1}+a_{2}y_{1}\geq h(w_{1},x_{1},y_{1})^{\frac{1}{d+1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p8.2" class="ltx_p"><span id="S3.SS1.p8.2.1" class="ltx_text">By swapping the roles of the <math id="S3.SS1.p8.m7" class="ltx_Math" alttext="a_{i}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>i</mi></msub><annotation encoding="application/x-tex">a_{i}</annotation></semantics></math> and <math id="S3.SS1.p8.m8" class="ltx_Math" alttext="b_{i}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mi>i</mi></msub><annotation encoding="application/x-tex">b_{i}</annotation></semantics></math>, let <math id="S3.SS1.p8.m9" class="ltx_Math" alttext="(w_{2},x_{2},y_{2})\coloneqq(\sqrt{a_{0}/b_{0}}w,\sqrt{a_{1}/b_{1}}x,\sqrt{a_{2}/b_{2}}y)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mn>2</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo>,</mo><msub><mi>y</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>≔</mo><mrow><mo stretchy="false">(</mo><mrow><msqrt><mrow><msub><mi>a</mi><mn>0</mn></msub><mo>/</mo><msub><mi>b</mi><mn>0</mn></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow><mo>,</mo><mrow><msqrt><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>/</mo><msub><mi>b</mi><mn>1</mn></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>,</mo><mrow><msqrt><mrow><msub><mi>a</mi><mn>2</mn></msub><mo>/</mo><msub><mi>b</mi><mn>2</mn></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(w_{2},x_{2},y_{2})\coloneqq(\sqrt{a_{0}/b_{0}}w,\sqrt{a_{1}/b_{1}}x,\sqrt{a_{2}/b_{2}}y)</annotation></semantics></math>. Then</span></p>
<table id="S3.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex23.m1" class="ltx_Math" alttext="\displaystyle\sqrt{a_{0}b_{0}}w+\sqrt{a_{1}b_{1}}x+\sqrt{a_{2}b_{2}}y=b_{0}w_{2}+b_{1}x_{2}+b_{2}y_{2}\geq h(w_{2},x_{2},y_{2})^{\frac{1}{d+1}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msqrt><mrow><msub><mi>a</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mn>0</mn></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow><mo>+</mo><mrow><msqrt><mrow><msub><mi>a</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mn>1</mn></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><mrow><msqrt><mrow><msub><mi>a</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mn>2</mn></msub></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>b</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>w</mi><mn>2</mn></msub></mrow><mo>+</mo><mrow><msub><mi>b</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>2</mn></msub></mrow><mo>+</mo><mrow><msub><mi>b</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mn>2</mn></msub></mrow></mrow><mo>≥</mo><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mn>2</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo>,</mo><msub><mi>y</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><mi>d</mi><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sqrt{a_{0}b_{0}}w+\sqrt{a_{1}b_{1}}x+\sqrt{a_{2}b_{2}}y=b_{0}w_{2}+b_{1}x_{2}+b_{2}y_{2}\geq h(w_{2},x_{2},y_{2})^{\frac{1}{d+1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p8.3" class="ltx_p"><span id="S3.SS1.p8.3.1" class="ltx_text">It then remains to show that</span></p>
<table id="S3.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex24.m1" class="ltx_Math" alttext="h(w_{1},x_{1},y_{1})\,h(w_{2},x_{2},y_{2})\geq h(\sqrt{w_{1}w_{2}},\,\sqrt{x_{1}x_{2}},\,\sqrt{y_{1}y_{2}})^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>y</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mn>2</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo>,</mo><msub><mi>y</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msqrt><mrow><msub><mi>w</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>w</mi><mn>2</mn></msub></mrow></msqrt><mo>,</mo><msqrt><mrow><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>2</mn></msub></mrow></msqrt><mo>,</mo><msqrt><mrow><msub><mi>y</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mn>2</mn></msub></mrow></msqrt><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">h(w_{1},x_{1},y_{1})\,h(w_{2},x_{2},y_{2})\geq h(\sqrt{w_{1}w_{2}},\,\sqrt{x_{1}x_{2}},\,\sqrt{y_{1}y_{2}})^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p8.4" class="ltx_p"><span id="S3.SS1.p8.4.1" class="ltx_text">Let <math id="S3.SS1.p8.m10" class="ltx_Math" alttext="\mathbf{u}_{i}\coloneqq(w_{i},x_{i},y_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐮</mi><mi>i</mi></msub><mo>≔</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>i</mi></msub><mo>,</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{u}_{i}\coloneqq(w_{i},x_{i},y_{i})</annotation></semantics></math> for <math id="S3.SS1.p8.m11" class="ltx_Math" alttext="i=1,2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">i=1,2</annotation></semantics></math> and <math id="S3.SS1.p8.m12" class="ltx_Math" alttext="\mathbf{v}\coloneqq(\sqrt{w_{1}w_{2}},\sqrt{x_{1}x_{2}},\sqrt{y_{1}y_{2}})" display="inline" intent=":literal"><semantics><mrow><mi>𝐯</mi><mo>≔</mo><mrow><mo stretchy="false">(</mo><msqrt><mrow><msub><mi>w</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>w</mi><mn>2</mn></msub></mrow></msqrt><mo>,</mo><msqrt><mrow><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>2</mn></msub></mrow></msqrt><mo>,</mo><msqrt><mrow><msub><mi>y</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mn>2</mn></msub></mrow></msqrt><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{v}\coloneqq(\sqrt{w_{1}w_{2}},\sqrt{x_{1}x_{2}},\sqrt{y_{1}y_{2}})</annotation></semantics></math>.
Write <math id="S3.SS1.p8.m13" class="ltx_Math" alttext="h(w,x,y)=\sum c_{\alpha,\beta,\gamma}w^{\alpha}x^{\beta}y^{\gamma}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo>∑</mo><mrow><msub><mi>c</mi><mrow><mi>α</mi><mo>,</mo><mi>β</mi><mo>,</mo><mi>γ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>w</mi><mi>α</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mi>β</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mi>γ</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">h(w,x,y)=\sum c_{\alpha,\beta,\gamma}w^{\alpha}x^{\beta}y^{\gamma}</annotation></semantics></math>, i.e., the monomial representation. As <math id="S3.SS1.p8.m14" class="ltx_Math" alttext="c_{\alpha,\beta,\gamma}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mrow><mi>α</mi><mo>,</mo><mi>β</mi><mo>,</mo><mi>γ</mi></mrow></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c_{\alpha,\beta,\gamma}&gt;0</annotation></semantics></math> always, the Cauchy–Schwarz inequality gives</span></p>
<table id="S3.EGx9" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex25.m1" class="ltx_Math" alttext="\displaystyle h(\mathbf{v})" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐯</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle h(\mathbf{v})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex25.m2" class="ltx_Math" alttext="\displaystyle=\sum c_{\alpha,\beta,\gamma}(w_{1}w_{2})^{\alpha/2}(x_{1}x_{2})^{\beta/2}(y_{1}y_{2})^{\gamma/2}=\sum\sqrt{c_{\alpha,\beta,\gamma}w_{1}^{\alpha}x_{1}^{\beta}y_{1}^{\gamma}}\sqrt{c_{\alpha,\beta,\gamma}w_{2}^{\alpha}x_{2}^{\beta}y_{2}^{\gamma}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo movablelimits="false">∑</mo><mrow><msub><mi>c</mi><mrow><mi>α</mi><mo>,</mo><mi>β</mi><mo>,</mo><mi>γ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>w</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>w</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>α</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>x</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>β</mi><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>y</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>γ</mi><mo>/</mo><mn>2</mn></mrow></msup></mrow></mrow></mstyle><mo>=</mo><mstyle displaystyle="true"><mrow><mo movablelimits="false">∑</mo><mrow><msqrt><mrow><msub><mi>c</mi><mrow><mi>α</mi><mo>,</mo><mi>β</mi><mo>,</mo><mi>γ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>w</mi><mn>1</mn><mi>α</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mn>1</mn><mi>β</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>y</mi><mn>1</mn><mi>γ</mi></msubsup></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><msub><mi>c</mi><mrow><mi>α</mi><mo>,</mo><mi>β</mi><mo>,</mo><mi>γ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>w</mi><mn>2</mn><mi>α</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mn>2</mn><mi>β</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>y</mi><mn>2</mn><mi>γ</mi></msubsup></mrow></msqrt></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\sum c_{\alpha,\beta,\gamma}(w_{1}w_{2})^{\alpha/2}(x_{1}x_{2})^{\beta/2}(y_{1}y_{2})^{\gamma/2}=\sum\sqrt{c_{\alpha,\beta,\gamma}w_{1}^{\alpha}x_{1}^{\beta}y_{1}^{\gamma}}\sqrt{c_{\alpha,\beta,\gamma}w_{2}^{\alpha}x_{2}^{\beta}y_{2}^{\gamma}}</annotation></semantics></math></td>
