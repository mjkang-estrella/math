<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex45.m2" class="ltx_Math" alttext="\displaystyle\geq w_{0}(B,C)-\frac{w_{1}(B,C)+w_{2}(B,C)}{\Delta}-\Psi_{\Delta}(w_{1}(B,C)w_{2}(B,C))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mrow><mrow><msub><mi>w</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo>,</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mi>w</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo>,</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>w</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo>,</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mi mathvariant="normal">Δ</mi></mfrac></mstyle><mo>−</mo><mrow><msub><mi mathvariant="normal">Ψ</mi><mi mathvariant="normal">Δ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>w</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo>,</mo><mi>C</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>w</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo>,</mo><mi>C</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq w_{0}(B,C)-\frac{w_{1}(B,C)+w_{2}(B,C)}{\Delta}-\Psi_{\Delta}(w_{1}(B,C)w_{2}(B,C))</annotation></semantics></math></td>
