<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex26.m1" class="ltx_Math" alttext="\displaystyle\leq\Bigl(\sum c_{\alpha,\beta,\gamma}w_{1}^{\alpha}x_{1}^{\beta}y_{1}^{\gamma}\Bigr)^{\!1/2}\Bigl(\sum c_{\alpha,\beta,\gamma}w_{2}^{\alpha}x_{2}^{\beta}y_{2}^{\gamma}\Bigr)^{\!1/2}=h(\mathbf{u}_{1})^{1/2}h(\mathbf{u}_{2})^{1/2}.\qed" display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mrow><mo movablelimits="false">∑</mo><mrow><msub><mi>c</mi><mrow><mi>α</mi><mo>,</mo><mi>β</mi><mo>,</mo><mi>γ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>w</mi><mn>1</mn><mi>α</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mn>1</mn><mi>β</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>y</mi><mn>1</mn><mi>γ</mi></msubsup></mrow></mrow></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mrow><mo movablelimits="false">∑</mo><mrow><msub><mi>c</mi><mrow><mi>α</mi><mo>,</mo><mi>β</mi><mo>,</mo><mi>γ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>w</mi><mn>2</mn><mi>α</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>x</mi><mn>2</mn><mi>β</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>y</mi><mn>2</mn><mi>γ</mi></msubsup></mrow></mrow></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><mo>=</mo><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐮</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐮</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow></mrow><mo lspace="0em" rspace="0.0835em">.</mo><mo class="ltx_mathvariant_italic" lspace="0.0835em" mathvariant="italic" separator="true">∎</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\Bigl(\sum c_{\alpha,\beta,\gamma}w_{1}^{\alpha}x_{1}^{\beta}y_{1}^{\gamma}\Bigr)^{\!1/2}\Bigl(\sum c_{\alpha,\beta,\gamma}w_{2}^{\alpha}x_{2}^{\beta}y_{2}^{\gamma}\Bigr)^{\!1/2}=h(\mathbf{u}_{1})^{1/2}h(\mathbf{u}_{2})^{1/2}.\qed</annotation></semantics></math></td>
