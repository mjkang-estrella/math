<p id="S3.SS2.p16.3" class="ltx_p"><span id="S3.SS2.p16.3.1" class="ltx_text">Differentiating both sides of <math id="S3.SS2.p16.m11" class="ltx_Math" alttext="A_{k}(x)=s^{k}B_{k}(x)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>A</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>s</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">A_{k}(x)=s^{k}B_{k}(x)</annotation></semantics></math> by <math id="S3.SS2.p16.m12" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> gives <math id="S3.SS2.p16.m13" class="ltx_Math" alttext="A_{k}^{\prime}(x)\frac{dx}{ds}=ks^{k-1}B_{k}(x)+s^{k}B_{k}^{\prime}(x)\frac{dx}{ds}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>A</mi><mi>k</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mfrac></mrow><mo>=</mo><mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>s</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>s</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>B</mi><mi>k</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mfrac></mrow></mrow></mrow><annotation encoding="application/x-tex">A_{k}^{\prime}(x)\frac{dx}{ds}=ks^{k-1}B_{k}(x)+s^{k}B_{k}^{\prime}(x)\frac{dx}{ds}</annotation></semantics></math>, so</span></p>
