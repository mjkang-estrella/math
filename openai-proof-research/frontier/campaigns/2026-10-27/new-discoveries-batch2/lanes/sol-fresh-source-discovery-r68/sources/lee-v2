<p id="S4.p7.2" class="ltx_p">where <math id="S4.p7.m4" class="ltx_Math" alttext="\mathcal{I}^{(q)}(G)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{I}^{(q)}(G)</annotation></semantics></math> consists of all <math id="S4.p7.m5" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>-tuples <math id="S4.p7.m6" class="ltx_Math" alttext="(I_{1},\dots,I_{q})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>I</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>I</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(I_{1},\dots,I_{q})</annotation></semantics></math> of pairwise disjoint (possibly empty) independent sets of <math id="S4.p7.m7" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>. In particular, <math id="S4.p7.m8" class="ltx_Math" alttext="Z^{(q)}_{G}(1,1,\dots,1)=\hom(G,K_{q+1}^{\circ})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>Z</mi><mi>G</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>hom</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><msubsup><mi>K</mi><mrow><mi>q</mi><mo>+</mo><mn>1</mn></mrow><mo>∘</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Z^{(q)}_{G}(1,1,\dots,1)=\hom(G,K_{q+1}^{\circ})</annotation></semantics></math>.
The multiaffine variant of <math id="S4.p7.m9" class="ltx_Math" alttext="Z^{(q)}_{G}" display="inline" intent=":literal"><semantics><msubsup><mi>Z</mi><mi>G</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">Z^{(q)}_{G}</annotation></semantics></math> is defined as follows: for tuples of reals <math id="S4.p7.m10" class="ltx_Math" alttext="\bm{\lambda}^{(i)}=(\lambda^{(i)}_{v})_{v\in V(G)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝝀</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msubsup><mi>λ</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\bm{\lambda}^{(i)}=(\lambda^{(i)}_{v})_{v\in V(G)}</annotation></semantics></math>, <math id="S4.p7.m11" class="ltx_Math" alttext="1\leq i\leq q" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">1\leq i\leq q</annotation></semantics></math>,</p>
<table id="S4.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex6.m1" class="ltx_Math" alttext="Z^{(q)}_{G}(\bm{\lambda}^{(1)},\dots,\bm{\lambda}^{(q)})\coloneqq\sum_{(I_{1},\dots,I_{q})\in\mathcal{I}^{(q)}(G)}\prod_{i=1}^{q}\prod_{v\in I_{i}}\lambda_{v}^{(i)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>Z</mi><mi>G</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝀</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>𝝀</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">≔</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mrow><mrow><mo stretchy="false">(</mo><msub><mi>I</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>I</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><munderover><mo movablelimits="false" rspace="0em">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>q</mi></munderover><mrow><munder><mo movablelimits="false">∏</mo><mrow><mi>v</mi><mo>∈</mo><msub><mi>I</mi><mi>i</mi></msub></mrow></munder><msubsup><mi>λ</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Z^{(q)}_{G}(\bm{\lambda}^{(1)},\dots,\bm{\lambda}^{(q)})\coloneqq\sum_{(I_{1},\dots,I_{q})\in\mathcal{I}^{(q)}(G)}\prod_{i=1}^{q}\prod_{v\in I_{i}}\lambda_{v}^{(i)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p7.3" class="ltx_p">If <math id="S4.p7.m12" class="ltx_Math" alttext="q=1" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">q=1</annotation></semantics></math>, <math id="S4.p7.m13" class="ltx_Math" alttext="Z^{(1)}_{G}(\bm{\lambda}^{(1)})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Z</mi><mi>G</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝀</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Z^{(1)}_{G}(\bm{\lambda}^{(1)})</annotation></semantics></math> is exactly the multivariate independence polynomial <math id="S4.p7.m14" class="ltx_Math" alttext="Z_{G}(\bm{\lambda}^{(1)})" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mi>G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝀</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Z_{G}(\bm{\lambda}^{(1)})</annotation></semantics></math>.</p>
</div>
<div id="S4.p8" class="ltx_para">
<p id="S4.p8.1" class="ltx_p">We conjecture that the following analogous statement of <a href="#S1.Thmtheorem1" title="Theorem 1.1. ‣ 1 Introduction ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">1.1</span></a> holds for <math id="S4.p8.m1" class="ltx_Math" alttext="Z^{(q)}_{G}" display="inline" intent=":literal"><semantics><msubsup><mi>Z</mi><mi>G</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">Z^{(q)}_{G}</annotation></semantics></math>. This is a vertex-weighted version of <a href="#S1.Thmtheorem3" title="Conjecture 1.3. ‣ 1 Introduction ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Conjecture</span> <span class="ltx_text ltx_ref_tag">1.3</span></a> when <math id="S4.p8.m2" class="ltx_Math" alttext="H=K_{q+1}^{\circ}" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>=</mo><msubsup><mi>K</mi><mrow><mi>q</mi><mo>+</mo><mn>1</mn></mrow><mo>∘</mo></msubsup></mrow><annotation encoding="application/x-tex">H=K_{q+1}^{\circ}</annotation></semantics></math>.</p>
</div>
<div id="S4.Thmtheorem2" class="ltx_theorem ltx_theorem_conjecture">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem2.2" class="ltx_text ltx_font_bold">Conjecture 4.2</span></span><span id="S4.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem2.p1" class="ltx_para">
<p id="S4.Thmtheorem2.p1.1" class="ltx_p"><span id="S4.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmtheorem2.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> be a graph and <math id="S4.Thmtheorem2.p1.m2" class="ltx_Math" alttext="\bm{\lambda}^{(i)}=(\lambda^{(i)}_{v})_{v\in V(G)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝛌</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msubsup><mi>λ</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\bm{\lambda}^{(i)}=(\lambda^{(i)}_{v})_{v\in V(G)}</annotation></semantics></math>, <math id="S4.Thmtheorem2.p1.m3" class="ltx_Math" alttext="1\leq i\leq q" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">1\leq i\leq q</annotation></semantics></math> be tuples of nonnegative reals. Then</span></p>
<table id="S4.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex7.m1" class="ltx_Math" alttext="Z^{(q)}_{G}(\bm{\lambda}^{(1)},\dots,\bm{\lambda}^{(q)})\geq\prod_{v\in V(G)}Z^{(q)}_{K_{d_{v}+1}}(\lambda^{(1)}_{v},\dots,\lambda^{(q)}_{v})^{\frac{1}{d_{v}+1}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>Z</mi><mi>G</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝀</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>𝝀</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">≥</mo><mrow><munder><mo movablelimits="false">∏</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><msubsup><mi>Z</mi><msub><mi>K</mi><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>λ</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>λ</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mrow><msub><mi>d</mi><mi>v</mi></msub><mo>+</mo><mn>1</mn></mrow></mfrac></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Z^{(q)}_{G}(\bm{\lambda}^{(1)},\dots,\bm{\lambda}^{(q)})\geq\prod_{v\in V(G)}Z^{(q)}_{K_{d_{v}+1}}(\lambda^{(1)}_{v},\dots,\lambda^{(q)}_{v})^{\frac{1}{d_{v}+1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.p9" class="ltx_para">
<p id="S4.p9.1" class="ltx_p">We shall prove a weaker bound as an application of <a href="#S1.Thmtheorem1" title="Theorem 1.1. ‣ 1 Introduction ‣ Lower bounds for multivariate independence polynomials and their generalisations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">1.1</span></a>, which matches the bound in the conjecture in an asymptotic sense.
For graphs <math id="S4.p9.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> and <math id="S4.p9.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>, their <em id="S4.p9.1.1" class="ltx_emph ltx_font_italic">Cartesian product</em> (or <em id="S4.p9.1.2" class="ltx_emph ltx_font_italic">box product</em>) <math id="S4.p9.m3" class="ltx_Math" alttext="G\mathbin{\square}K" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0.222em" rspace="0.222em">□</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">G\mathbin{\square}K</annotation></semantics></math> is the graph on <math id="S4.p9.m4" class="ltx_Math" alttext="V(G)\times V(K)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">×</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">V(G)\times V(K)</annotation></semantics></math> in which two vertices <math id="S4.p9.m5" class="ltx_Math" alttext="(u_{1},v_{1})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mn>1</mn></msub><mo>,</mo><msub><mi>v</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u_{1},v_{1})</annotation></semantics></math> and <math id="S4.p9.m6" class="ltx_Math" alttext="(u_{2},v_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mn>2</mn></msub><mo>,</mo><msub><mi>v</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u_{2},v_{2})</annotation></semantics></math> are adjacent if and only if either

<span id="S4.I1" class="ltx_inline-enumerate">
<span id="S4.I1.i1" class="ltx_inline-item"><span class="ltx_tag ltx_tag_inline-item">1.</span> <math id="S4.I1.i1.m1" class="ltx_Math" alttext="u_{1}=u_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mn>1</mn></msub><mo>=</mo><msub><mi>u</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">u_{1}=u_{2}</annotation></semantics></math><span id="S4.I1.i1.2" class="ltx_text">and <math id="S4.I1.i1.m2" class="ltx_Math" alttext="v_{1}v_{2}\in E(K)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>v</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mn>2</mn></msub></mrow><mo>∈</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">v_{1}v_{2}\in E(K)</annotation></semantics></math> or
</span></span>
<span id="S4.I1.i2" class="ltx_inline-item"><span class="ltx_tag ltx_tag_inline-item">2.</span> <math id="S4.I1.i2.m1" class="ltx_Math" alttext="u_{1}u_{2}\in E(G)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>u</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mn>2</mn></msub></mrow><mo>∈</mo><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">u_{1}u_{2}\in E(G)</annotation></semantics></math><span id="S4.I1.i2.2" class="ltx_text">and <math id="S4.I1.i2.m2" class="ltx_Math" alttext="v_{1}=v_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mn>1</mn></msub><mo>=</mo><msub><mi>v</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">v_{1}=v_{2}</annotation></semantics></math>.
</span></span>
</span>
Let <math id="S4.p9.m7" class="ltx_Math" alttext="K_{t}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>t</mi></msub><annotation encoding="application/x-tex">K_{t}</annotation></semantics></math> be a complete graph on <math id="S4.p9.m8" class="ltx_Math" alttext="[t]\coloneqq\{1,\dots,t\}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mo>≔</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>t</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">[t]\coloneqq\{1,\dots,t\}</annotation></semantics></math> so that <math id="S4.p9.m9" class="ltx_Math" alttext="V(G\mathbin{\square}K_{t})=V(G)\times[t]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>G</mi><mo lspace="0.222em" rspace="0.222em">□</mo><msub><mi>K</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">V(G\mathbin{\square}K_{t})=V(G)\times[t]</annotation></semantics></math>.
Then the map</p>
<table id="S4.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex8.m1" class="ltx_Math" alttext="(I_{1},I_{2})\mapsto\{(v,1):v\in I_{1}\}\sqcup\{(v,2):v\in I_{2}\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><msub><mi>I</mi><mn>1</mn></msub><mo>,</mo><msub><mi>I</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">↦</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mn>1</mn><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mrow><mi>v</mi><mo>∈</mo><msub><mi>I</mi><mn>1</mn></msub></mrow><mo stretchy="false">}</mo></mrow><mo>⊔</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mn>2</mn><mo rspace="0.278em" stretchy="false">)</mo></mrow><mo rspace="0.278em">:</mo><mrow><mi>v</mi><mo>∈</mo><msub><mi>I</mi><mn>2</mn></msub></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(I_{1},I_{2})\mapsto\{(v,1):v\in I_{1}\}\sqcup\{(v,2):v\in I_{2}\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.p9.2" class="ltx_p">is a bijection from <math id="S4.p9.m10" class="ltx_Math" alttext="\mathcal{I}^{(2)}(G)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{I}^{(2)}(G)</annotation></semantics></math> to <math id="S4.p9.m11" class="ltx_Math" alttext="\mathcal{I}(G\mathbin{\square}K_{2})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>G</mi><mo lspace="0.222em" rspace="0.222em">□</mo><msub><mi>K</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{I}(G\mathbin{\square}K_{2})</annotation></semantics></math>.
Let us illustrate how <math id="S4.p9.m12" class="ltx_Math" alttext="Z^{(2)}_{G}(\bm{\lambda}^{(1)},\bm{\lambda}^{(2)})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Z</mi><mi>G</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝀</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>𝝀</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Z^{(2)}_{G}(\bm{\lambda}^{(1)},\bm{\lambda}^{(2)})</annotation></semantics></math> corresponds to <math id="S4.p9.m13" class="ltx_Math" alttext="Z_{G\mathbin{\square}K_{2}}" display="inline" intent=":literal"><semantics><msub><mi>Z</mi><mrow><mi>G</mi><mo lspace="0.222em" rspace="0.222em">□</mo><msub><mi>K</mi><mn>2</mn></msub></mrow></msub><annotation encoding="application/x-tex">Z_{G\mathbin{\square}K_{2}}</annotation></semantics></math> with suitable parameters.
For simplicity, let <math id="S4.p9.m14" class="ltx_Math" alttext="\bm{\lambda}^{(i)}=(\lambda^{(i)},\dots,\lambda^{(i)})" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝝀</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><mo stretchy="false">(</mo><msup><mi>λ</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>λ</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{\lambda}^{(i)}=(\lambda^{(i)},\dots,\lambda^{(i)})</annotation></semantics></math>, <math id="S4.p9.m15" class="ltx_Math" alttext="i=1,2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">i=1,2</annotation></semantics></math>, for <math id="S4.p9.m16" class="ltx_Math" alttext="\lambda^{(1)},\lambda^{(2)}\in\mathbb{R}_{\geq 0}" display="inline" intent=":literal"><semantics><mrow><msup><mi>λ</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mrow><msup><mi>λ</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>∈</mo><msub><mi>ℝ</mi><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\lambda^{(1)},\lambda^{(2)}\in\mathbb{R}_{\geq 0}</annotation></semantics></math>.
Then setting <math id="S4.p9.m17" class="ltx_Math" alttext="\bm{\mu}=(\mu_{(v,i)})_{(v,i)\in V(G\mathbin{\square}K_{2})}" display="inline" intent=":literal"><semantics><mrow><mi>𝝁</mi><mo>=</mo><msub><mrow><mo stretchy="false">(</mo><msub><mi>μ</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>G</mi><mo lspace="0.222em" rspace="0.222em">□</mo><msub><mi>K</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\bm{\mu}=(\mu_{(v,i)})_{(v,i)\in V(G\mathbin{\square}K_{2})}</annotation></semantics></math> where <math id="S4.p9.m18" class="ltx_Math" alttext="\mu_{(v,i)}\coloneqq\lambda^{(i)}\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub><mo>≔</mo><msup><mi>λ</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">\mu_{(v,i)}\coloneqq\lambda^{(i)}\in\mathbb{R}</annotation></semantics></math> for <math id="S4.p9.m19" class="ltx_Math" alttext="(v,i)\in V(G\mathbin{\square}K_{2})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>G</mi><mo lspace="0.222em" rspace="0.222em">□</mo><msub><mi>K</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(v,i)\in V(G\mathbin{\square}K_{2})</annotation></semantics></math> gives</p>
