>​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝝀</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><msub><mi>p</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝝀</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\alpha_{G}(t;\bm{\lambda})\coloneqq\frac{t}{\lvert V(G)\rvert}\frac{\partial}{\partial t}\log Z_{G}(t\bm{\lambda})=\frac{t}{\lvert V(G)\rvert}\sum_{v\in V(G)}\lambda_{v}\frac{\partial}{\partial\lambda_{v}}\log Z_{G}(t\bm{\lambda})=\frac{1}{\lvert V(G)\rvert}\sum_{v\in V(G)}p_{v}(t\bm{\lambda}).</annotation></semantics></math></td>
