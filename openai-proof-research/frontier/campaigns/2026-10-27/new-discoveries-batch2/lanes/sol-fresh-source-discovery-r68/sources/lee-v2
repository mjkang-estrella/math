<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E1.m1" class="ltx_Math" alttext="Z^{(2)-}_{G\setminus w}(\bm{\lambda}^{\prime},\bm{\mu}^{\prime})+\lambda_{w}Z^{(2)-}_{G\setminus w}(\bm{\lambda}^{\prime},\bm{\mu}^{\prime})|_{\lambda_{v}=0,\,v\in N(w)}+\mu_{w}Z^{(2)-}_{G\setminus w}(\bm{\lambda}^{\prime},\bm{\mu}^{\prime})|_{\mu_{v}=0,\,v\in N(w)}\geq Z^{(2)-}_{G}(\bm{\lambda},\bm{\mu})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>∖</mo><mi>w</mi></mrow><mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mo>−</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝀</mi><mo>′</mo></msup><mo>,</mo><msup><mi>𝝁</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mrow><mrow><msub><mi>λ</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>∖</mo><mi>w</mi></mrow><mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mo>−</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝀</mi><mo>′</mo></msup><mo>,</mo><msup><mi>𝝁</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><mrow><msub><mi>λ</mi><mi>v</mi></msub><mo>=</mo><mn>0</mn></mrow><mo rspace="0.337em">,</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></msub><mo>+</mo><msub><mrow><mrow><msub><mi>μ</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>Z</mi><mrow><mi>G</mi><mo>∖</mo><mi>w</mi></mrow><mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mo>−</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝝀</mi><mo>′</mo></msup><mo>,</mo><msup><mi>𝝁</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><mrow><msub><mi>μ</mi><mi>v</mi></msub><mo>=</mo><mn>0</mn></mrow><mo rspace="0.337em">,</mo><mrow><mi>v</mi><mo>∈</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></msub></mrow><mo>≥</mo><mrow><msubsup><mi>Z</mi><mi>G</mi><mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mo>−</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝝀</mi><mo>,</mo><mi>𝝁</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Z^{(2)-}_{G\setminus w}(\bm{\lambda}^{\prime},\bm{\mu}^{\prime})+\lambda_{w}Z^{(2)-}_{G\setminus w}(\bm{\lambda}^{\prime},\bm{\mu}^{\prime})|_{\lambda_{v}=0,\,v\in N(w)}+\mu_{w}Z^{(2)-}_{G\setminus w}(\bm{\lambda}^{\prime},\bm{\mu}^{\prime})|_{\mu_{v}=0,\,v\in N(w)}\geq Z^{(2)-}_{G}(\bm{\lambda},\bm{\mu}).</annotation></semantics></math></td>
