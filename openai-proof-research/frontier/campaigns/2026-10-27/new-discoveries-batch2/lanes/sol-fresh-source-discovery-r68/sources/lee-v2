<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex9.m2" class="ltx_Math" alttext="\displaystyle=\sum_{(I_{1},I_{2})\in\mathcal{I}^{(2)}(G)}(\lambda^{(1)})^{\lvert I_{1}\rvert}\,(\lambda^{(2)})^{\lvert I_{2}\rvert}=\sum_{I\in\mathcal{I}(G\mathbin{\square}K_{2})}\prod_{(v,i)\in I}\mu_{(v,i)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mo stretchy="false">(</mo><msub><mi>I</mi><mn>1</mn></msub><mo>,</mo><msub><mi>I</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder></mstyle><mrow><msup><mrow><mo stretchy="false">(</mo><msup><mi>λ</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">|</mo><msub><mi>I</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>λ</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">|</mo><msub><mi>I</mi><mn>2</mn></msub><mo stretchy="false">|</mo></mrow></msup></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>I</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>G</mi><mo lspace="0.222em" rspace="0.222em">□</mo><msub><mi>K</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∏</mo><mrow><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>I</mi></mrow></munder></mstyle><msub><mi>μ</mi><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{(I_{1},I_{2})\in\mathcal{I}^{(2)}(G)}(\lambda^{(1)})^{\lvert I_{1}\rvert}\,(\lambda^{(2)})^{\lvert I_{2}\rvert}=\sum_{I\in\mathcal{I}(G\mathbin{\square}K_{2})}\prod_{(v,i)\in I}\mu_{(v,i)}</annotation></semantics></math></td>
